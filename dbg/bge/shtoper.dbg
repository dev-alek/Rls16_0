     3871         , input substitute( "&1. Ошибка выгрузки &2. &3. &4. &5."
     3872         , vss-description
     3873         , "остатков денежных средств"
     3874         , return-value
     3875         , trim(error-status :get-message(1))
     3876         , trim(error-status :get-message(2))
     3877         )
     3878         ).
     3879     end.
     3880     output stream stmxmlout close.
     3881   end.
     3882   procedure export-shift :
     3883   define input parameter p-obj-type   as character        no-undo.
     3884   define input parameter p-obj-code   as integer          no-undo.
     3885   define input parameter p-shift-date as date             no-undo.
     3886   define input parameter p-shift-num  as integer          no-undo.
     3887     define buffer buf_shift-obj for ub.shift-obj.
     3888     define buffer buf_clients   for ub.clients.
     3889   do
     3890   for buf_shift-obj
     3891     , buf_clients
     3892   on error undo, return error
     3893   :
     3894       find first buf_shift-obj no-lock
     3895            where buf_shift-obj.obj-type   = p-obj-type
     3896              and buf_shift-obj.obj-code   = p-obj-code
     3897              and buf_shift-obj.shift-date = p-shift-date
     3898              and buf_shift-obj.shift-num  = p-shift-num
     3899       .
     3900       find first buf_clients no-lock
     3901            where buf_clients.obj-type = p-obj-type
     3902              and buf_clients.obj-code = p-obj-code
     3903       .
     3904       run wp-xmltagopen( input 2, input "shift", input "" ).
     3905       run wp-xmltagput( input 3, "objType"    , input string( buf_shift-obj.obj-type                  ), input 0 ).
     3906       run wp-xmltagput( input 3, "objCode"    , input string( buf_shift-obj.obj-code                  ), input 0 ).
     3907       run wp-xmltagput( input 3, "objName"    , input string( buf_clients.obj-name                    ), input 0 ).
     3908       run wp-xmltagput( input 3, "shiftNum"   , input string( buf_shift-obj.shift-num                 ), input 0 ).
     3909       run wp-xmltagput( input 3, "shiftName"  , input string( buf_shift-obj.shift-name                ), input 0 ).
     3910       run wp-xmltagput( input 3, "shiftDate"  , input string( buf_shift-obj.shift-date, "99.99.9999"  ), input 0 ).
     3911       run wp-xmltagput( input 3, "shiftTime"  , input string( buf_shift-obj.open-time, "HH:MM:SS"     ), input 0 ).
     3912       run wp-xmltagput( input 3, "shiftEndDate"  , input string( buf_shift-obj.close-date, "99.99.9999"  ), input 0 ).
     3913       run wp-xmltagput( input 3, "shiftEndTime"  , input string( buf_shift-obj.close-time, "HH:MM:SS"     ), input 0 ).
     3914       run wp-xmltagclose( input 2, input "shift" ).
     3915     end.
     3916   end procedure.
     3917   procedure export-shift-staff :
     3918   define input parameter p-obj-type   as character        no-undo.
     3919   define input parameter p-obj-code   as integer          no-undo.
     3920   define input parameter p-shift-date as date             no-undo.
     3921   define input parameter p-shift-num  as integer          no-undo.
     3922     define buffer buf_shift-staff for ub.shift-staff.
     3923   do
     3924   for buf_shift-staff
     3925   on error undo, return error
     3926   :
     3927       for each buf_shift-staff no-lock
     3928          where buf_shift-staff.obj-type   = p-obj-type
     3929            and buf_shift-staff.obj-code   = p-obj-code
     3930            and buf_shift-staff.shift-date = p-shift-date
     3931            and buf_shift-staff.shift-num  = p-shift-num
     3932            and buf_shift-staff.next-shift = no
     3933            and buf_shift-staff.psn-num   >= 0
     3934       by buf_shift-staff.staff-role descending
     3935       on error undo, return error
     3936       :
     3937         run wp-xmltagopen( input 2, input "shiftStaff", input "" ).
     3938         run wp-xmltagput( input 3, "objType"    , input string( buf_shift-staff.obj-type                  ), input 0 ).
     3939         run wp-xmltagput( input 3, "objCode"    , input string( buf_shift-staff.obj-code                  ), input 0 ).
     3940         run wp-xmltagput( input 3, "shiftDate"  , input string( buf_shift-staff.shift-date, "99.99.9999"  ), input 0 ).
     3941         run wp-xmltagput( input 3, "shiftNum"   , input string( buf_shift-staff.shift-num                 ), input 0 ).
     3942         run wp-xmltagput( input 3, "stfPsnCode" , input string( buf_shift-staff.psn-code                  ), input 0 ).
     3943         run wp-xmltagput( input 3, "stfName"    , input string( buf_shift-staff.name                      ), input 0 ).
     3944         run wp-xmltagput( input 3, "stfCashier" , input string( ( buf_shift-staff.cashier <> 0 )          ), input 2 ).
     3945         run wp-xmltagclose( input 2, input "shiftStaff" ).
     3946       end.
     3947     end.
     3948   end procedure.
     3949   procedure export-pay-desk-z-order :
     3950   define input parameter p-obj-type   as character        no-undo.
     3951   define input parameter p-obj-code   as integer          no-undo.
     3952   define input parameter p-shift-date as date             no-undo.
     3953   define input parameter p-shift-num  as integer          no-undo.
     3954     define buffer buf_chk-doc for ub.chk-doc.
     3955   do
     3956   for buf_chk-doc
     3957   on error undo, return error
     3958   :
     3959       empty temp-table temp_payDeskZOrder.
     3960       for each buf_chk-doc no-lock
     3961          where buf_chk-doc.obj-type   = p-obj-type
     3962            and buf_chk-doc.obj-code   = p-obj-code
     3963            and buf_chk-doc.shift-date = p-shift-date
     3964            and buf_chk-doc.shift-num  = p-shift-num
     3965       :
     3966         if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next.
     3967         find first temp_payDeskZOrder
     3968              where temp_payDeskZOrder.pay-desk = buf_chk-doc.pay-desk
     3969                and temp_payDeskZOrder.z-number = buf_chk-doc.z-number
     3970         no-error.
     3971         if not available temp_payDeskZOrder
     3972         then do:
     3973           create temp_payDeskZOrder.
     3974           assign
     3975             temp_payDeskZOrder.pay-desk = buf_chk-doc.pay-desk
     3976             temp_payDeskZOrder.z-number = buf_chk-doc.z-number
     3977           .
     3978         end.
     3979         assign
     3980           temp_payDeskZOrder.sum = temp_payDeskZOrder.sum + buf_chk-doc.netto
     3981         .
     3982       end.
     3983       for each temp_payDeskZOrder
     3984       :
     3985         if temp_payDeskZOrder.sum <> 0 then do:
     3986           run wp-xmltagopen( input 2, input "shiftPayDeskZOrder", input "" ).
     3987           run wp-xmltagput( input 3, "objType"    , input string( p-obj-type                  ), input 0 ).
     3988           run wp-xmltagput( input 3, "objCode"    , input string( p-obj-code                  ), input 0 ).
     3989           run wp-xmltagput( input 3, "shiftDate"  , input string( p-shift-date, "99.99.9999"  ), input 0 ).
     3990           run wp-xmltagput( input 3, "shiftNum"   , input string( p-shift-num                 ), input 0 ).
     3991           run wp-xmltagput( input 3, "pdzPayDesk" , input string( temp_payDeskZOrder.pay-desk ), input 0 ).
     3992           run wp-xmltagput( input 3, "pdzZOrder"  , input string( temp_payDeskZOrder.z-number ), input 0 ).
     3993           run wp-xmltagput( input 3, "pdzSum"     , input string( temp_payDeskZOrder.sum      ), input 0 ).
     3994           run wp-xmltagclose( input 3, input "shiftPayDeskZOrder").
     3995         end.
     3996       end.
     3997     end.
     3998   end procedure.
     3999   procedure export-sum-wth :
     4000   define input parameter p-host-code  as integer          no-undo.
     4001   define input parameter p-obj-type   as character        no-undo.
     4002   define input parameter p-obj-code   as integer          no-undo.
     4003   define input parameter p-shift-date as date             no-undo.
     4004   define input parameter p-shift-num  as integer          no-undo.
     4005     define variable v-is-inkassator as character no-undo.
     4006     define variable v-attr-type     as character no-undo.
     4007     define variable v-sale-type     as character no-undo.
     4008     define variable v-sale-code     as integer   no-undo.
     4009     define buffer buf_clients                for ub.clients.
     4010     define buffer buf_wth-doc                for ub.wth-doc.
     4011     define buffer buf_wth-line               for ub.wth-line.
     4012     define buffer buf_wealth                 for ub.wealth.
     4013     define buffer buf_sysconf                for ub.sysconf.
     4014     define buffer buf_temp_sumWthInkasToBank for temp_sumWthInkasToBank.
     4015     define buffer buf_temp_sumWthInternal    for temp_sumWthInternal.
     4016   do
     4017   for buf_clients
     4018     , buf_wth-doc
     4019     , buf_wth-line
     4020     , buf_wealth
     4021     , buf_temp_sumWthInkasToBank
     4022     , buf_temp_sumWthInternal
     4023   on error undo, return error
     4024   :
     4025       empty temp-table buf_temp_sumWthInkasToBank.
     4026       empty temp-table buf_temp_sumWthInternal.
     4027       find first buf_sysconf no-lock
     4028            where buf_sysconf.host-code = p-host-code
     4029       no-error.
     4030       if available buf_sysconf then do:
     4031         assign
     4032           v-sale-type = buf_sysconf.sale-type
     4033           v-sale-code = buf_sysconf.sale-code
     4034         .
     4035       end.
     4036       else do:
     4037         assign
     4038           v-sale-type = "":U
     4039           v-sale-code = 0
     4040         .
     4041       end.
     4042       see-all-clients:
     4043       for each buf_clients no-lock
     4044       on error undo, return error
     4045       :
     4046         if buf_clients.obj-type  = v-sale-type
     4047         and buf_clients.obj-code = v-sale-code
     4048         then do:
     4049           undo see-all-clients, next see-all-clients.
     4050         end.
     4051         run clntattr-value in this-procedure (
     4052               input buf_clients.obj-type
     4053             , input buf_clients.obj-code
     4054             , input 'is-inkassator':U
     4055             , output v-is-inkassator
     4056             , output v-attr-type
     4057         ).
     4058         if v-is-inkassator = "yes":U
     4059         then do:
     4060           if buf_clients.obj-type = 'орг':U
     4061           then do:
     4062             for each buf_wth-doc no-lock
     4063                where buf_wth-doc.obj-type   = p-obj-type
     4064                  and buf_wth-doc.obj-code   = p-obj-code
     4065                  and buf_wth-doc.shift-date = p-shift-date
     4066                  and buf_wth-doc.shift-num  = p-shift-num
     4067                  and buf_wth-doc.status_    = 'факт':U
     4068                  and buf_wth-doc.doc-type   = 'рас':U
     4069             use-index sht-clos
     4070             on error undo, return error
     4071             :
     4072               if  buf_wth-doc.cli-type   = buf_clients.obj-type
     4073               and buf_wth-doc.cli-code   = buf_clients.obj-code
     4074               then do:
     4075                 for each buf_wth-line no-lock
     4076                    where buf_wth-line.doc-code = buf_wth-doc.doc-code
     4077                 on error undo, return error
     4078                 :
     4079                   if buf_wth-line.status_ = 'факт':U
     4080                   then do:
     4081                     find first buf_temp_sumWthInkasToBank
     4082                          where buf_temp_sumWthInkasToBank.wth-code = buf_wth-line.wth-code
     4083                     no-error.
     4084                     if not available buf_temp_sumWthInkasToBank
     4085                     then do:
     4086                       create buf_temp_sumWthInkasToBank.
     4087                       assign
     4088                         buf_temp_sumWthInkasToBank.wth-code = buf_wth-line.wth-code
     4089                       .
     4090                       find first buf_wealth no-lock
     4091                            where buf_wealth.wth-code = buf_wth-line.wth-code
     4092                       no-error.
     4093                       if available buf_wealth
     4094                       then do:
     4095                         assign
     4096                           buf_temp_sumWthInkasToBank.wth-name = buf_wealth.wth-name
     4097                         .
     4098                       end.
     4099                     end.
     4100                     assign
     4101                       buf_temp_sumWthInkasToBank.fact-sum = buf_temp_sumWthInkasToBank.fact-sum + buf_wth-line.fact-sum
     4102                     .
     4103                   end.
     4104                 end.
     4105               end.
     4106             end.
     4107           end.
     4108         end.
     4109         else do:
     4110           if buf_clients.host-code <> p-host-code
     4111           and ( buf_clients.obj-type <> p-obj-type
     4112              or buf_clients.obj-code <> p-obj-code )
     4113           then do:
     4114             for each buf_wth-doc no-lock
     4115                where buf_wth-doc.obj-type   = p-obj-type
     4116                  and buf_wth-doc.obj-code   = p-obj-code
     4117                  and buf_wth-doc.shift-date = p-shift-date
     4118                  and buf_wth-doc.shift-num  = p-shift-num
     4119                  and buf_wth-doc.status_    = 'факт':U
     4120                  and buf_wth-doc.doc-type   = 'рас':U
     4121             use-index sht-clos
     4122             on error undo, return error
     4123             :
     4124               if  buf_wth-doc.cli-type   = buf_clients.obj-type
     4125               and buf_wth-doc.cli-code   = buf_clients.obj-code
     4126               then do:
     4127                 for each buf_wth-line no-lock
     4128                    where buf_wth-line.doc-code = buf_wth-doc.doc-code
     4129                 on error undo, return error
     4130                 :
     4131                   if buf_wth-line.status_ = 'факт':U
     4132                   then do:
     4133                     find first buf_temp_sumWthInternal
     4134                          where buf_temp_sumWthInternal.wth-code = buf_wth-line.wth-code
     4135                     no-error.
     4136                     if not available buf_temp_sumWthInternal
     4137                     then do:
     4138                       create buf_temp_sumWthInternal.
     4139                       assign
     4140                         buf_temp_sumWthInternal.wth-code = buf_wth-line.wth-code
     4141                       .
     4142                       find first buf_wealth no-lock
     4143                            where buf_wealth.wth-code = buf_wth-line.wth-code
     4144                       no-error.
     4145                       if available buf_wealth
     4146                       then do:
     4147                         assign
     4148                           buf_temp_sumWthInternal.wth-name = buf_wealth.wth-name
     4149                         .
     4150                       end.
     4151                     end.
     4152                     assign
     4153                       buf_temp_sumWthInternal.fact-sum = buf_temp_sumWthInternal.fact-sum + buf_wth-line.fact-sum
     4154                     .
     4155                   end.
     4156                 end.
     4157               end.
     4158             end.
     4159           end.
     4160         end.
     4161       end.
     4162       for each buf_temp_sumWthInkasToBank
     4163       :
     4164         if buf_temp_sumWthInkasToBank.fact-sum <> 0
     4165         then do:
     4166           run wp-xmltagopen( input 2, input "sumWthInkasToBank", input "" ).
     4167           run wp-xmltagput( input 3, "objType"    , input string( p-obj-type                          ), input 0 ).
     4168           run wp-xmltagput( input 3, "objCode"    , input string( p-obj-code                          ), input 0 ).
     4169           run wp-xmltagput( input 3, "shiftDate"  , input string( p-shift-date, "99.99.9999"          ), input 0 ).
     4170           run wp-xmltagput( input 3, "shiftNum"   , input string( p-shift-num                         ), input 0 ).
     4171           run wp-xmltagput( input 3, "itbWthCode" , input string( buf_temp_sumWthInkasToBank.wth-code  ), input 0 ).
     4172           run wp-xmltagput( input 3, "itbWthName" , input string( buf_temp_sumWthInkasToBank.wth-name  ), input 0 ).
     4173           run wp-xmltagput( input 3, "itbWthSum"  , input string( buf_temp_sumWthInkasToBank.fact-sum  ), input 0 ).
     4174           run wp-xmltagclose( input 3, input "sumWthInkasToBank").
     4175         end.
     4176       end.
     4177       for each buf_temp_sumWthInternal
     4178       :
     4179         if buf_temp_sumWthInternal.fact-sum <> 0
     4180         then do:
     4181           run wp-xmltagopen( input 2, input "sumWthInternal", input "" ).
     4182           run wp-xmltagput( input 3, "objType"    , input string( p-obj-type                          ), input 0 ).
     4183           run wp-xmltagput( input 3, "objCode"    , input string( p-obj-code                          ), input 0 ).
     4184           run wp-xmltagput( input 3, "shiftDate"  , input string( p-shift-date, "99.99.9999"          ), input 0 ).
     4185           run wp-xmltagput( input 3, "shiftNum"   , input string( p-shift-num                         ), input 0 ).
     4186           run wp-xmltagput( input 3, "inWthCode"  , input string( buf_temp_sumWthInternal.wth-code       ), input 0 ).
     4187           run wp-xmltagput( input 3, "inWthName"  , input string( buf_temp_sumWthInternal.wth-name       ), input 0 ).
     4188           run wp-xmltagput( input 3, "inWthSum"   , input string( buf_temp_sumWthInternal.fact-sum      ), input 0 ).
     4189           run wp-xmltagclose( input 3, input "sumWthInternal").
     4190         end.
     4191       end.
     4192     end.
     4193   end procedure.
     4194   procedure export-stk-wth-in-place :
     4195   define input parameter p-obj-type   as character        no-undo.
     4196   define input parameter p-obj-code   as integer          no-undo.
     4197   define input parameter p-shift-date as date             no-undo.
     4198   define input parameter p-shift-num  as integer          no-undo.
     4199     define variable v-stock-start  as decimal no-undo.
     4200     define variable v-stock-end    as decimal no-undo.
     4201     define variable v-income       as decimal no-undo.
     4202     define variable v-income-cassa as decimal no-undo.
     4203     define variable v-income-other as decimal no-undo.
     4204     define variable v-incass       as decimal no-undo.
     4205     define variable v-incass-bank  as decimal no-undo.
     4206     define variable v-incass-other as decimal no-undo.
     4207     define variable v-incass-cassa as decimal no-undo.
     4208     define buffer buf_wth-place          for ub.wth-place.
     4209     define buffer buf_wth-pobj           for ub.wth-pobj.
     4210     define buffer buf_wealth             for ub.wealth.
     4211     define buffer buf_temp_stkWthInPlace for temp_stkWthInPlace.
     4212   do
     4213   for buf_wth-place
     4214     , buf_wth-pobj
     4215     , buf_wealth
     4216     , buf_temp_stkWthInPlace
     4217   on error undo, return error
     4218   :
     4219       empty temp-table buf_temp_stkWthInPlace.
     4220       for each buf_wth-place no-lock
     4221          where buf_wth-place.obj-type     = p-obj-type
     4222            and buf_wth-place.obj-code     = p-obj-code
     4223            and buf_wth-place.cash-desk    <> ?
     4224       :
     4225         for each buf_wth-pobj no-lock
     4226            where buf_wth-pobj.obj-type  = p-obj-type
     4227              and buf_wth-pobj.obj-code  = p-obj-code
     4228              and buf_wth-pobj.w-p-code  = buf_wth-place.w-p-code
     4229         on error undo, return error
     4230         :
     4231           run wth-lib_full-inf-shift-place in this-procedure (
     4232                 input p-obj-type
     4233               , input p-obj-code
     4234               , input buf_wth-pobj.wth-code
     4235               , input buf_wth-pobj.w-p-code
     4236               , input p-shift-date
     4237               , input p-shift-num
     4238               , output v-stock-start
     4239               , output v-stock-end
     4240               , output v-income
     4241               , output v-income-cassa
     4242               , output v-income-other
     4243               , output v-incass
     4244               , output v-incass-bank
     4245               , output v-incass-other
     4246               , output v-incass-cassa
     4247           ).
     4248           find first buf_temp_stkWthInPlace
     4249                where buf_temp_stkWthInPlace.w-p-code = buf_wth-pobj.w-p-code
     4250                  and buf_temp_stkWthInPlace.wth-code = buf_wth-pobj.wth-code
     4251           no-error.
     4252           if not available buf_temp_stkWthInPlace
     4253           then do:
     4254             create buf_temp_stkWthInPlace.
     4255             assign
     4256               buf_temp_stkWthInPlace.w-p-code    = buf_wth-pobj.w-p-code
     4257               buf_temp_stkWthInPlace.wth-code    = buf_wth-pobj.wth-code
     4258               buf_temp_stkWthInPlace.w-p-name    = buf_wth-place.w-p-name
     4259               buf_temp_stkWthInPlace.stock-start = v-stock-start
     4260               buf_temp_stkWthInPlace.stock-end   = v-stock-end
     4261             .
     4262             find first buf_wealth no-lock
     4263                  where buf_wealth.wth-code = buf_wth-pobj.wth-code
     4264             no-error.
     4265             if available buf_wealth
     4266             then do:
     4267               assign
     4268                 buf_temp_stkWthInPlace.wth-name = buf_wealth.wth-name
     4269               .
     4270             end.
     4271           end.
     4272         end.
     4273       end.
     4274       for each buf_temp_stkWthInPlace
     4275       :
     4276         if buf_temp_stkWthInPlace.stock-start <> 0
     4277         or buf_temp_stkWthInPlace.stock-end <> 0
     4278         then do:
     4279           run wp-xmltagopen( input 2, input "stkWthInPlace", input "" ).
     4280           run wp-xmltagput( input 3, "objType"        , input string( p-obj-type                            ), input 0 ).
     4281           run wp-xmltagput( input 3, "objCode"        , input string( p-obj-code                            ), input 0 ).
     4282           run wp-xmltagput( input 3, "shiftDate"      , input string( p-shift-date, "99.99.9999"            ), input 0 ).
     4283           run wp-xmltagput( input 3, "shiftNum"       , input string( p-shift-num                           ), input 0 ).
     4284           run wp-xmltagput( input 3, "swpWPCode"      , input string( buf_temp_stkWthInPlace.w-p-code       ), input 0 ).
     4285           run wp-xmltagput( input 3, "swpWthCode"     , input string( buf_temp_stkWthInPlace.wth-code       ), input 0 ).
     4286           run wp-xmltagput( input 3, "swpWPName"      , input string( buf_temp_stkWthInPlace.w-p-name       ), input 0 ).
     4287           run wp-xmltagput( input 3, "swpWthName"     , input string( buf_temp_stkWthInPlace.wth-name       ), input 0 ).
     4288           run wp-xmltagput( input 3, "swpStockStart"  , input string( buf_temp_stkWthInPlace.stock-start    ), input 0 ).
     4289           run wp-xmltagput( input 3, "swpStockEnd"    , input string( buf_temp_stkWthInPlace.stock-end      ), input 0 ).
     4290           run wp-xmltagclose( input 3, input "stkWthInPlace").
     4291         end.
     4292       end.
     4293     end.
     4294   end procedure.
     4295   procedure export-techPro :
     4296   define input parameter p-obj-type   as character        no-undo.
     4297   define input parameter p-obj-code   as integer          no-undo.
     4298   define input parameter p-shift-date as date             no-undo.
     4299   define input parameter p-shift-num  as integer          no-undo.
     4300     define variable v-shftrep2   as character no-undo.
     4301     define variable v-attr-value as character no-undo.
     4302     define variable v-attr-type  as character no-undo.
     4303     define buffer buf_clients        for ub.clients.
     4304     define buffer buf_trn-doc        for ub.trn-doc.
     4305     define buffer buf_doc-line       for ub.doc-line.
     4306     define buffer buf_goods          for ub.goods.
     4307     define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
     4308     define buffer buf_temp_techPro   for temp_techPro.
     4309     define buffer buf_doc-pl         for ub.doc-pl.
     4310     define buffer buf_chk-gds        for ub.chk-gds.
     4311     define buffer buf_chk-gds-pay    for ub.chk-gds-pay.
     4312     DEFINE buffer buf_chk-doc        for ub.chk-doc.
     4313     define buffer buf_temp_chk-doc   for temp_chk-doc.
     4314     define buffer buf_bar-code       for ub.bar-code.
     4315   do
     4316   for buf_clients
     4317     , buf_trn-doc
     4318     , buf_doc-line
     4319     , buf_goods
     4320     , buf_temp_techPro
     4321     , buf_doc-pl
     4322     , buf_chk-gds
     4323     , buf_bar-code
     4324   on error undo, return error
     4325   :
     4326       empty temp-table buf_temp_techPro.
     4327       for each buf_clients no-lock
     4328       on error undo, return error
     4329       :
     4330         run clntattr-value in this-procedure ( input buf_clients.obj-type
     4331                                                , input buf_clients.obj-code
     4332                                                , input 'shftrep2':U
     4333                                                , output v-shftrep2
     4334                                                , output v-attr-type
     4335                                              ).
     4336         if v-shftrep2 = "yes":U
     4337         then do:
     4338           sum-all-trn-doc-tech-pro:
     4339           for each buf_trn-doc no-lock
     4340              where buf_trn-doc.obj-type   = p-obj-type
     4341                and buf_trn-doc.obj-code   = p-obj-code
     4342                and buf_trn-doc.shift-date = p-shift-date
     4343                and buf_trn-doc.shift-num  = p-shift-num
     4344                and buf_trn-doc.status_    = 'факт':U
     4345               on error undo, return error
     4346               :
     4347             def var v-value as character no-undo.
     4348             def var v-type  as character no-undo.
     4349             def var v-tech-pass as logical no-undo.
     4350   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     4351                           input 'techpass':U ,
     4352                          output v-value ,
     4353                          output v-type ) no-error .
     4354             assign
     4355               v-tech-pass = yes when v-value = "yes".
     4356             if  buf_trn-doc.cli-type = buf_clients.obj-type   and
     4357                 buf_trn-doc.cli-code = buf_clients.obj-code   and
     4358                 buf_trn-doc.ext-doc-type = 'we':U
     4359             then do:
     4360               if not (v-tech-pass or can-find(first ub.sale-doc where ub.sale-doc.doc-code = buf_trn-doc.doc-code and ub.sale-doc.doc-kind = 'trf':U))
     4361                 then
     4362               do:
     4363                 undo sum-all-trn-doc-tech-pro, next sum-all-trn-doc-tech-pro.
     4364               end.
     4365               for each buf_doc-line no-lock
     4366                  where buf_doc-line.doc-code = buf_trn-doc.doc-code
     4367                 on error undo, return error
     4368                 :
     4369                 find first buf_temp_techPro
     4370                      where buf_temp_techPro.artic       = buf_doc-line.artic
     4371                        and buf_temp_techPro.prod-type   = buf_doc-line.prod-type
     4372                        and buf_temp_techPro.prod-code   = buf_doc-line.prod-code
     4373                   no-error.
     4374                 if not available buf_temp_techPro then do:
     4375                   create buf_temp_techPro.
     4376                   assign
     4377                     buf_temp_techPro.artic     = buf_doc-line.artic
     4378                     buf_temp_techPro.prod-type = buf_doc-line.prod-type
     4379                     buf_temp_techPro.prod-code = buf_doc-line.prod-code
     4380                   .
     4381                   find first buf_goods no-lock
     4382                        where buf_goods.artic     = buf_temp_techPro.artic
     4383                          and buf_goods.prod-type = buf_temp_techPro.prod-type
     4384                          and buf_goods.prod-code = buf_temp_techPro.prod-code
     4385                     no-error.
     4386                   if available buf_goods then do:
     4387                     assign
     4388                       buf_temp_techPro.gds-code = buf_goods.gds-code
     4389                       buf_temp_techPro.gds-name = buf_goods.gds-name
     4390                     .
     4391                       buf_temp_techPro.envd = no .
     4392                     for each buf_doc-pl no-lock
     4393                        where buf_doc-pl.gds-code = buf_goods.gds-code
     4394                          and buf_doc-pl.obj-code = p-obj-code
     4395                          and buf_doc-pl.obj-type = p-obj-type
     4396                          and buf_doc-pl.out-code = buf_trn-doc.doc-code:
     4397                       assign
     4398                         buf_temp_techPro.pl-code       = buf_doc-pl.pl-code
     4399                         buf_temp_techPro.qnty          = buf_doc-pl.fact-qnty
     4400                         buf_temp_techPro.cli-qnty      = buf_doc-pl.cli-fact-qnty
     4401                         buf_temp_techPro.state-density = buf_doc-pl.cli-fact-qnty / buf_doc-pl.fact-qnty
     4402                       .
     4403                     end.
     4404                   end.
     4405                 end.
     4406                 assign
     4407                   buf_temp_techPro.fact-qnty = buf_temp_techPro.fact-qnty + buf_doc-line.fact-qnty
     4408                 .
     4409                 for each buf_bar-code no-lock
     4410                    where buf_bar-code.gds-code = buf_goods.gds-code :
     4411                   for each buf_chk-doc where buf_chk-doc.chk-type = integer('17':U)
     4412                        and buf_chk-doc.out-code = buf_trn-doc.out-code:
     4413                     find first buf_chk-gds no-lock where buf_chk-gds.b-code = buf_bar-code.b-code
     4414                           and  buf_chk-gds.doc-code = buf_chk-doc.doc-code no-error .
     4415                     if AVAILABLE buf_chk-gds then
     4416                     do:
     4417                       find first buf_temp_chk-doc where buf_temp_chk-doc.b-code = buf_chk-gds.b-code and
     4418                                 buf_temp_chk-doc.doc-code = buf_chk-gds.doc-code and
     4419                                 buf_temp_chk-doc.chk-type = integer('17':U)  no-error.
     4420                       if not AVAILABLE buf_temp_chk-doc then
     4421                       do:
     4422                         create buf_temp_chk-doc .
     4423                         ASSIGN
     4424                           buf_temp_chk-doc.doc-code      = buf_chk-gds.doc-code
     4425                           buf_temp_chk-doc.gds-code      = buf_goods.gds-code
     4426                           buf_temp_chk-doc.b-code        = buf_chk-gds.b-code
     4427                           buf_temp_chk-doc.chk-date      = buf_chk-doc.chk-date
     4428                           buf_temp_chk-doc.qnty          = buf_chk-gds.doc-qnty
     4429                           buf_temp_chk-doc.nozzle-code   = buf_chk-gds.nozzle-code
     4430                           buf_temp_chk-doc.pump          = buf_chk-gds.pump
     4431                           buf_temp_chk-doc.state-density = buf_chk-gds.density
     4432                           buf_temp_chk-doc.pay-desk      = buf_chk-doc.pay-desk
     4433                           buf_temp_chk-doc.pl-code       = integer(buf_chk-gds.loc1)
     4434                           buf_temp_chk-doc.chk-type      = integer('17':U)
     4435                           buf_temp_chk-doc.cashier       = buf_chk-doc.cashier
     4436                           buf_temp_chk-doc.chk-num       = buf_chk-doc.chk-num
     4437                           buf_temp_chk-doc.chk-time      = buf_chk-doc.chk-time
     4438                         .
     4439                       end.
     4440                     end.
     4441                   end.
     4442                 end.
     4443               end.
     4444             end.
     4445           end.
     4446         end.
     4447       end.
     4448       for each buf_temp_techPro
     4449       :
     4450         if buf_temp_techPro.fact-qnty <> 0
     4451         then do:
     4452           run wp-xmltagopen( input 2, input "techPro", input "" ).
     4453           run wp-xmltagput( input 3, "objType"    , input string( p-obj-type                   ), input 0 ).
     4454           run wp-xmltagput( input 3, "objCode"    , input string( p-obj-code                   ), input 0 ).
     4455           run wp-xmltagput( input 3, "shiftDate"  , input string( p-shift-date, "99.99.9999"   ), input 0 ).
     4456           run wp-xmltagput( input 3, "shiftNum"   , input string( p-shift-num                  ), input 0 ).
     4457           run wp-xmltagput( input 3, "tprArtic"   , input string( buf_temp_techPro.artic       ), input 0 ).
     4458           run wp-xmltagput( input 3, "tprProdType", input string( buf_temp_techPro.prod-type   ), input 0 ).
     4459           run wp-xmltagput( input 3, "tprProdCode", input string( buf_temp_techPro.prod-code   ), input 0 ).
     4460           run wp-xmltagput( input 3, "tprGdsCode" , input string( buf_temp_techPro.gds-code    ), input 0 ).
     4461           run wp-xmltagput( input 3, "tprGdsName" , input string( buf_temp_techPro.gds-name    ), input 0 ).
     4462           run wp-xmltagput( input 3, "tprGdsENVD" , input string( buf_temp_techPro.envd        ), input 3 ).
     4463           run wp-xmltagput( input 3, "tprFactQnty", input string( buf_temp_techPro.fact-qnty   ), input 0 ).
     4464           run wp-xmltagopen( input 3, input "tprProPL", input "" ).
     4465           run wp-xmltagput( input 4, "tprProPLCode"  , input string( buf_temp_techPro.pl-code     ), input 0 ).
     4466           run wp-xmltagput( input 4, "tprProQnty"    , input string( buf_temp_techPro.qnty        ), input 0 ).
     4467           run wp-xmltagput( input 4, "tprProCliQnty" , input string( buf_temp_techPro.cli-qnty    ), input 0 ).
     4468           run wp-xmltagput( input 4, "tprProDensity" , input string( buf_temp_techPro.state-density, ">>>>>>>>>9.99"), input 0 ).
     4469           run wp-xmltagclose( input 3, input "tprProPL").
     4470           for each buf_temp_chk-doc where buf_temp_chk-doc.gds-code = buf_temp_techPro.gds-code and buf_temp_chk-doc.chk-type = integer('17':U) :
     4471             run wp-xmltagopen( input 3, input "techProChk", input "" ).
     4472             run wp-xmltagput( input 4, "ChkDate"    , input string( buf_temp_chk-doc.chk-date   ), input 0 ).
     4473             run wp-xmltagput( input 4, "ChkTime"    , input string( buf_temp_chk-doc.chk-time, "hh:mm:ss"   ), input 0 ).
     4474             run wp-xmltagput( input 4, "ChkNum"     , input string( buf_temp_chk-doc.doc-code   ), input 0 ).
     4475             run wp-xmltagput( input 4, "ChkNumDesk" , input string( buf_temp_chk-doc.pay-desk   ), input 0 ).
     4476             run wp-xmltagput( input 4, "ChkQnty"    , input string( buf_temp_chk-doc.qnty       ), input 0 ).
     4477             run wp-xmltagput( input 4, "ChkTRK"     , input string( buf_temp_chk-doc.pump       ), input 0 ).
     4478             run wp-xmltagput( input 4, "ChkNozzle"  , input string( buf_temp_chk-doc.nozzle-code), input 0 ).
     4479             run wp-xmltagput( input 4, "ChkPL"      , input string( buf_temp_chk-doc.pl-code    ), input 2 ).
     4480             run wp-xmltagclose( input 3, input "techProChk").
     4481           end.
     4482         end.
     4483         run wp-xmltagclose( input 2, input "techPro").
     4484       end.
     4485     end.
     4486   end procedure.
     4487   procedure export-CorrChk :
     4488     define input parameter p-obj-type   as character        no-undo.
     4489     define input parameter p-obj-code   as integer          no-undo.
     4490     define input parameter p-shift-date as date             no-undo.
     4491     define input parameter p-shift-num  as integer          no-undo.
     4492     define buffer buf_goods        for ub.goods.
     4493     define buffer buf_chk-gds      for ub.chk-gds.
     4494     define buffer buf_chk-pay      for ub.chk-pay.
     4495     define buffer buf_chk-pay-attr for ub.chk-pay-attr.
     4496     DEFINE buffer buf_chk-doc      for ub.chk-doc.
     4497     define buffer buf_temp_chk-doc for temp_chk-doc.
     4498     define buffer buf_temp_chk-gds for temp_chk-gds.
     4499     define buffer buf_bar-code     for ub.bar-code.
     4500     define variable v-RRN               as character no-undo.
     4501     do
     4502       for  buf_chk-gds
     4503       , buf_chk-pay
     4504       , buf_chk-doc
     4505       on error undo, return error
     4506       :
     4507       empty temp-table buf_temp_chk-doc.
     4508       empty temp-table buf_temp_chk-gds.
     4509       for each buf_chk-doc where (buf_chk-doc.chk-type = integer('44':U) or buf_chk-doc.chk-type = integer('43':U) )
     4510         and buf_chk-doc.shift-date = p-shift-date and buf_chk-doc.shift-num = p-shift-num
     4511         and buf_chk-doc.obj-code = p-obj-code and buf_chk-doc.obj-type = p-obj-type    :
     4512         find first buf_temp_chk-doc where buf_temp_chk-doc.doc-code = buf_chk-doc.doc-code no-error.
     4513         if not AVAILABLE buf_temp_chk-doc then
     4514         do:
     4515           create buf_temp_chk-doc .
     4516           ASSIGN
     4517             buf_temp_chk-doc.doc-code = buf_chk-doc.doc-code
     4518             buf_temp_chk-doc.doc-num  = buf_chk-doc.doc-num
     4519             buf_temp_chk-doc.doc-num2 = buf_chk-doc.doc-num2
     4520             buf_temp_chk-doc.chk-date = buf_chk-doc.chk-date
     4521             buf_temp_chk-doc.pay-desk = buf_chk-doc.pay-desk
     4522             buf_temp_chk-doc.chk-type = buf_chk-doc.chk-type
     4523             buf_temp_chk-doc.cashier  = buf_chk-doc.cashier
     4524             buf_temp_chk-doc.chk-num  = buf_chk-doc.chk-num
     4525             buf_temp_chk-doc.chk-time = buf_chk-doc.chk-time
     4526             buf_temp_chk-doc.netto    = buf_chk-doc.netto
     4527           .
     4528           if num-entries(buf_chk-doc.doc-num2, ":") = 2
     4529           then do :
     4530             if entry(1, buf_chk-doc.doc-num2, ":") = "0"
     4531             then buf_temp_chk-doc.doc-num2 = "самостоятельно" .
     4532             else
     4533             if entry(1, buf_chk-doc.doc-num2, ":") = "1"
     4534             then buf_temp_chk-doc.doc-num2 = "по предписанию" .
     4535             else
     4536             buf_temp_chk-doc.doc-num2 = "неизвестн." .
     4537           end.
     4538           else
     4539           buf_temp_chk-doc.doc-num2 = "неизвестн." .
     4540         end.
     4541         for each buf_chk-gds no-lock where buf_chk-gds.doc-code = buf_chk-doc.doc-code :
     4542           find first buf_temp_chk-gds where buf_temp_chk-gds.doc-code = buf_chk-gds.doc-code and buf_temp_chk-gds.line-num = buf_chk-gds.line-num no-error .
     4543           if not AVAILABLE buf_temp_chk-gds then
     4544           do:
     4545             create buf_temp_chk-gds .
     4546             assign
     4547               buf_temp_chk-gds.doc-code    = buf_chk-gds.doc-code
     4548               buf_temp_chk-gds.b-code      = buf_chk-gds.b-code
     4549               buf_temp_chk-gds.src-sum     = buf_chk-gds.src-sum
     4550               buf_temp_chk-gds.OFDcode     = buf_chk-gds.depart-type
     4551               buf_temp_chk-gds.OFDvalue    = buf_chk-gds.road-tax
     4552               buf_temp_chk-gds.line-num    = buf_chk-gds.line-num
     4553               .
     4554           end.
     4555         end.
     4556       end.
     4557       run wp-xmltagopen( input 2, input "CorrChk", input "" ).
     4558       for each buf_temp_chk-doc where buf_temp_chk-doc.chk-type = integer('43':U):
     4559         run wp-xmltagopen( input 3, input "Check", input "" ).
     4560         run wp-xmltagput( input 4, "ChkTypeName", input string( "ПриходКорр" ), input 0 ).
     4561         run wp-xmltagput( input 4, "ChkType"    , input string( '43':U   ), input 0 ).
     4562         run wp-xmltagput( input 4, "ChkDate"    , input string( buf_temp_chk-doc.chk-date   ), input 0 ).
     4563         run wp-xmltagput( input 4, "ChkTime"    , input string( buf_temp_chk-doc.chk-time, "hh:mm:ss"   ), input 0 ).
     4564         run wp-xmltagput( input 4, "ChkDocNum"  , input string( buf_temp_chk-doc.doc-code   ), input 0 ).
     4565         run wp-xmltagput( input 4, "ChkNum"     , input string( buf_temp_chk-doc.chk-num   ), input 0 ).
     4566         run wp-xmltagput( input 4, "ChkNumDesk" , input string( buf_temp_chk-doc.pay-desk   ), input 0 ).
     4567         run wp-xmltagput( input 4, "ChkTotal"   , input string( buf_temp_chk-doc.netto   ), input 0 ).
     4568         run wp-xmltagput( input 4, "Cashier"    , input string( buf_temp_chk-doc.cashier   ), input 0 ).
     4569         run wp-xmltagput( input 4, "Reason"     , input string( buf_temp_chk-doc.doc-num   ), input 0 ).
     4570         run wp-xmltagput( input 4, "CorrType"   , input string( buf_temp_chk-doc.doc-num2   ), input 0 ).
     4571         for each buf_temp_chk-gds where buf_temp_chk-gds.doc-code = buf_temp_chk-doc.doc-code:
     4572           run wp-xmltagopen( input 4, input "CheckLine", input "" ).
     4573           run wp-xmltagput( input 5, "ChkTaxCode", input string( buf_temp_chk-gds.b-code ), input 0 ).
     4574           run wp-xmltagput( input 5, "ChkSum"    , input string( buf_temp_chk-gds.src-sum ), input 0 ).
     4575           run wp-xmltagput( input 5, "ChkCSTCode"  , input string( buf_temp_chk-gds.OFDcode ), input 0 ).
     4576           run wp-xmltagput( input 5, "ChkCSTValue" , input string( buf_temp_chk-gds.OFDvalue ), input 0 ).
     4577           run wp-xmltagclose( input 4, input "CheckLine").
     4578         end .
     4579         for each buf_chk-pay no-lock where buf_chk-pay.doc-code = buf_temp_chk-doc.doc-code :
     4580           run wp-xmltagopen( input 4, input "CheckPay", input "" ).
     4581           run wp-xmltagput( input 5, "ChkPayCode", input string( buf_chk-pay.pay-code ), input 0 ).
     4582           run wp-xmltagput( input 5, "ChkPaySum" , input string( buf_chk-pay.tot-sum ), input 0 ).
     4583           v-RRN = '' .
     4584           for first buf_chk-pay-attr no-lock
     4585               where buf_chk-pay-attr.doc-code = buf_chk-pay.doc-code
     4586               and buf_chk-pay-attr.attr-code = "CPDOC"
     4587               and buf_chk-pay-attr.line-num = buf_chk-pay.line-num  :
     4588               v-RRN = buf_chk-pay-attr.attr-value .
     4589           end.
     4590           if v-RRN = ''
     4591           then
     4592           do:
     4593               for first buf_chk-pay-attr no-lock
     4594                   where buf_chk-pay-attr.doc-code = buf_chk-pay.doc-code
     4595                   and buf_chk-pay-attr.attr-code = "RRN"
     4596                   and buf_chk-pay-attr.line-num = buf_chk-pay.line-num:
     4597                   v-RRN = buf_chk-pay-attr.attr-value .
     4598               end.
     4599           end.
     4600           run wp-xmltagput( input 5, input "OperationCode", input v-RRN                              , input 0 ).
     4601           run wp-xmltagclose( input 4, input "CheckPay").
     4602         end .
     4603         run wp-xmltagclose( input 3, input "Check").
     4604       end.
     4605       for each buf_temp_chk-doc where buf_temp_chk-doc.chk-type = integer('44':U):
     4606         run wp-xmltagopen( input 3, input "Check", input "" ).
     4607         run wp-xmltagput( input 4, "ChkTypeName", input string( "РасходКорр" ), input 0 ).
     4608         run wp-xmltagput( input 4, "ChkType"    , input string( '44':U   ), input 0 ).
     4609         run wp-xmltagput( input 4, "ChkDate"    , input string( buf_temp_chk-doc.chk-date   ), input 0 ).
     4610         run wp-xmltagput( input 4, "ChkTime"    , input string( buf_temp_chk-doc.chk-time, "hh:mm:ss"   ), input 0 ).
     4611         run wp-xmltagput( input 4, "ChkDocNum"  , input string( buf_temp_chk-doc.doc-code   ), input 0 ).
     4612         run wp-xmltagput( input 4, "ChkNum"     , input string( buf_temp_chk-doc.chk-num   ), input 0 ).
     4613         run wp-xmltagput( input 4, "ChkNumDesk" , input string( buf_temp_chk-doc.pay-desk   ), input 0 ).
     4614         run wp-xmltagput( input 4, "ChkTotal"   , input string( buf_temp_chk-doc.netto   ), input 0 ).
     4615         run wp-xmltagput( input 4, "Cashier"    , input string( buf_temp_chk-doc.cashier   ), input 0 ).
     4616         run wp-xmltagput( input 4, "Reason"     , input string( buf_temp_chk-doc.doc-num   ), input 0 ).
     4617         run wp-xmltagput( input 4, "CorrType"   , input string( buf_temp_chk-doc.doc-num2   ), input 0 ).
     4618         for each buf_temp_chk-gds where buf_temp_chk-gds.doc-code = buf_temp_chk-doc.doc-code:
     4619           run wp-xmltagopen( input 4, input "CheckLine", input "" ).
     4620           run wp-xmltagput( input 5, "ChkTaxCode", input string( buf_temp_chk-gds.b-code ), input 0 ).
     4621           run wp-xmltagput( input 5, "ChkSum"    , input string( buf_temp_chk-gds.src-sum), input 0 ).
     4622           run wp-xmltagput( input 5, "ChkCSTCode"  , input string( buf_temp_chk-gds.OFDcode ), input 0 ).
     4623           run wp-xmltagput( input 5, "ChkCSTValue" , input string( buf_temp_chk-gds.OFDvalue ), input 0 ).
     4624           run wp-xmltagclose( input 4, input "CheckLine").
     4625         end .
     4626         for each buf_chk-pay no-lock where buf_chk-pay.doc-code = buf_temp_chk-doc.doc-code :
     4627           run wp-xmltagopen( input 4, input "CheckPay", input "" ).
     4628           run wp-xmltagput( input 5, "ChkPayCode", input string( buf_chk-pay.pay-code ), input 0 ).
     4629           run wp-xmltagput( input 5, "ChkPaySum" , input string( buf_chk-pay.tot-sum ), input 0 ).
     4630           run wp-xmltagclose( input 4, input "CheckPay").
     4631         end .
     4632         run wp-xmltagclose( input 3, input "Check").
     4633       end.
     4634           run wp-xmltagclose( input 2, input "CorrChk").
     4635     end.
     4636   end procedure.
     4637   procedure export-techChk :
     4638     define input parameter p-obj-type   as character        no-undo.
     4639     define input parameter p-obj-code   as integer          no-undo.
     4640     define input parameter p-shift-date as date             no-undo.
     4641     define input parameter p-shift-num  as integer          no-undo.
     4642     define buffer buf_goods        for ub.goods.
     4643     define buffer buf_chk-gds      for ub.chk-gds.
     4644     DEFINE buffer buf_chk-doc      for ub.chk-doc.
     4645     define buffer buf_temp_chk-doc for temp_chk-doc.
     4646     define buffer buf_temp_chk-gds for temp_chk-gds.
     4647     define buffer buf_bar-code     for ub.bar-code.
     4648     do
     4649       for buf_goods
     4650       , buf_chk-gds
     4651       , buf_bar-code
     4652       , buf_chk-doc
     4653       on error undo, return error
     4654       :
     4655       empty temp-table buf_temp_chk-doc.
     4656       empty temp-table buf_temp_chk-gds.
     4657       for each buf_chk-doc no-lock
     4658          where buf_chk-doc.obj-type = p-obj-type
     4659            and buf_chk-doc.obj-code = p-obj-code
     4660            and buf_chk-doc.shift-date = p-shift-date
     4661            and buf_chk-doc.shift-num  = p-shift-num
     4662            and (buf_chk-doc.chk-type = integer('16':U)
     4663              or buf_chk-doc.chk-type = integer('14':U)
     4664              or buf_chk-doc.chk-type = integer('36':U)
     4665              or buf_chk-doc.chk-type = integer('15':U)
     4666                ) :
     4667           find first buf_temp_chk-doc where buf_temp_chk-doc.doc-code = buf_chk-doc.doc-code no-error.
     4668         if not AVAILABLE buf_temp_chk-doc then do:
     4669           create buf_temp_chk-doc .
     4670           ASSIGN
     4671             buf_temp_chk-doc.doc-code = buf_chk-doc.doc-code
     4672             buf_temp_chk-doc.doc-num2 = buf_chk-doc.doc-num2
     4673             buf_temp_chk-doc.chk-date = buf_chk-doc.chk-date
     4674             buf_temp_chk-doc.pay-desk = buf_chk-doc.pay-desk
     4675             buf_temp_chk-doc.chk-type = buf_chk-doc.chk-type
     4676             buf_temp_chk-doc.cashier  = buf_chk-doc.cashier
     4677             buf_temp_chk-doc.chk-num  = buf_chk-doc.chk-num
     4678             buf_temp_chk-doc.chk-time = buf_chk-doc.chk-time
     4679           .
     4680         end.
     4681         for each buf_chk-gds no-lock where buf_chk-gds.doc-code = buf_chk-doc.doc-code :
     4682           find first buf_bar-code where buf_bar-code.b-code = buf_chk-gds.b-code no-error .
     4683           if AVAILABLE buf_bar-code then
     4684           do:
     4685               find first buf_temp_chk-gds
     4686                    where buf_temp_chk-gds.doc-code = buf_chk-gds.doc-code
     4687                      and buf_temp_chk-gds.line-num = buf_chk-gds.line-num no-error .
     4688               if not AVAILABLE buf_temp_chk-gds then
     4689               do:
     4690                 create buf_temp_chk-gds .
     4691                 assign
     4692                   buf_temp_chk-gds.doc-code    = buf_chk-gds.doc-code
     4693                   buf_temp_chk-gds.gds-code    = buf_bar-code.gds-code
     4694                   buf_temp_chk-gds.b-code      = buf_chk-gds.b-code
     4695                   buf_temp_chk-gds.qnty        = buf_chk-gds.doc-qnty
     4696                   buf_temp_chk-gds.nozzle-code = buf_chk-gds.nozzle-code
     4697                   buf_temp_chk-gds.pump        = buf_chk-gds.pump
     4698                   buf_temp_chk-gds.line-num    = buf_chk-gds.line-num
     4699                 .
     4700                 if buf_chk-doc.chk-type = integer('14':U) then
     4701                 do:
     4702                   if buf_chk-gds.write-off-code = 0 then buf_temp_chk-gds.sbros-type = "не пролито".
     4703                   if buf_chk-gds.write-off-code = 1 then buf_temp_chk-gds.sbros-type = "пролито".
     4704                 end.
     4705               end.
     4706           end.
     4707         end.
     4708       end.
     4709       run wp-xmltagopen( input 2, input "TechChk", input "" ).
     4710       for each buf_temp_chk-doc where buf_temp_chk-doc.chk-type = integer('16':U):
     4711         run wp-xmltagopen( input 3, input "Check", input "" ).
     4712         run wp-xmltagput( input 4, "ChkTypeName", input string( "ПеревТрнзкц" ), input 0 ).
     4713         run wp-xmltagput( input 4, "ChkType"    , input string( '16':U   ), input 0 ).
     4714         run wp-xmltagput( input 4, "ChkDate"    , input string( buf_temp_chk-doc.chk-date   ), input 0 ).
     4715         run wp-xmltagput( input 4, "ChkTime"    , input string( buf_temp_chk-doc.chk-time, "hh:mm:ss"   ), input 0 ).
     4716         run wp-xmltagput( input 4, "ChkDocNum"  , input string( buf_temp_chk-doc.doc-code   ), input 0 ).
     4717         run wp-xmltagput( input 4, "ChkNum"     , input string( buf_temp_chk-doc.chk-num   ), input 0 ).
     4718         run wp-xmltagput( input 4, "ChkNumDesk" , input string( buf_temp_chk-doc.pay-desk   ), input 0 ).
     4719         run wp-xmltagput( input 4, "Cashier"    , input string( buf_temp_chk-doc.cashier   ), input 0 ).
     4720         run wp-xmltagput( input 4, "Reference-num"    , input string( buf_temp_chk-doc.doc-num2   ), input 0 ).
     4721         for each buf_temp_chk-gds where buf_temp_chk-gds.doc-code = buf_temp_chk-doc.doc-code:
     4722           run wp-xmltagopen( input 4, input "CheckGds", input "" ).
     4723           run wp-xmltagput( input 5, "ChkGds-code", input string( buf_temp_chk-gds.gds-code   ), input 0 ).
     4724           run wp-xmltagput( input 5, "ChkQnty"    , input string( buf_temp_chk-gds.qnty,  "->>>>>>>>>9.99"       ), input 0 ).
     4725           run wp-xmltagput( input 5, "ChkTRK"     , input string( buf_temp_chk-gds.pump       ), input 0 ).
     4726           run wp-xmltagput( input 5, "ChkNozzle"  , input string( buf_temp_chk-gds.nozzle-code), input 0 ).
     4727           run wp-xmltagput( input 5, "ChkPL"      , input string( buf_temp_chk-gds.pl-code    ), input 2 ).
     4728           run wp-xmltagclose( input 4, input "CheckGds").
     4729         end.
     4730         run wp-xmltagclose( input 3, input "Check").
     4731       end.
     4732       for each buf_temp_chk-doc where buf_temp_chk-doc.chk-type = integer('14':U):
     4733         run wp-xmltagopen( input 3, input "Check", input "" ).
     4734         run wp-xmltagput( input 4, "ChkTypeName", input string( "СбросТрнзкц" ), input 0 ).
     4735         run wp-xmltagput( input 4, "ChkType"    , input string( '14':U   ), input 0 ).
     4736         run wp-xmltagput( input 4, "ChkDate"    , input string( buf_temp_chk-doc.chk-date   ), input 0 ).
     4737         run wp-xmltagput( input 4, "ChkTime"    , input string( buf_temp_chk-doc.chk-time, "hh:mm:ss"   ), input 0 ).
     4738         run wp-xmltagput( input 4, "ChkDocNum"  , input string( buf_temp_chk-doc.doc-code   ), input 0 ).
     4739         run wp-xmltagput( input 4, "ChkNum"     , input string( buf_temp_chk-doc.chk-num   ), input 0 ).
     4740         run wp-xmltagput( input 4, "ChkNumDesk" , input string( buf_temp_chk-doc.pay-desk   ), input 0 ).
     4741         run wp-xmltagput( input 4, "Cashier"    , input string( buf_temp_chk-doc.cashier   ), input 0 ).
     4742         run wp-xmltagput( input 4, "Reference-num"    , input string( buf_temp_chk-doc.doc-num2   ), input 0 ).
     4743         for each buf_temp_chk-gds where buf_temp_chk-gds.doc-code = buf_temp_chk-doc.doc-code:
     4744           run wp-xmltagopen( input 4, input "CheckGds", input "" ).
     4745           run wp-xmltagput( input 5, "ChkGds-code", input string( buf_temp_chk-gds.gds-code   ), input 0 ).
     4746           run wp-xmltagput( input 5, "ChkReason"  , input string( buf_temp_chk-gds.sbros-type   ), input 0 ).
     4747           run wp-xmltagput( input 5, "ChkQnty"    , input string( buf_temp_chk-gds.qnty,  "->>>>>>>>>9.99"       ), input 0 ).
     4748           run wp-xmltagput( input 5, "ChkTRK"     , input string( buf_temp_chk-gds.pump       ), input 0 ).
     4749           run wp-xmltagput( input 5, "ChkNozzle"  , input string( buf_temp_chk-gds.nozzle-code), input 0 ).
     4750           run wp-xmltagput( input 5, "ChkPL"      , input string( buf_temp_chk-gds.pl-code    ), input 2 ).
     4751           run wp-xmltagclose( input 4, input "CheckGds").
     4752         end.
     4753         run wp-xmltagclose( input 3, input "Check").
     4754       end.
     4755       for each buf_temp_chk-doc where buf_temp_chk-doc.chk-type = integer('36':U):
     4756         run wp-xmltagopen( input 3, input "Check", input "" ).
     4757         run wp-xmltagput( input 4, "ChkTypeName", input string( "РазблТрнзкц" ), input 0 ).
     4758         run wp-xmltagput( input 4, "ChkType"    , input string( '36':U   ), input 0 ).
     4759         run wp-xmltagput( input 4, "ChkDate"    , input string( buf_temp_chk-doc.chk-date   ), input 0 ).
     4760         run wp-xmltagput( input 4, "ChkTime"    , input string( buf_temp_chk-doc.chk-time, "hh:mm:ss"   ), input 0 ).
     4761         run wp-xmltagput( input 4, "ChkDocNum"  , input string( buf_temp_chk-doc.doc-code   ), input 0 ).
     4762         run wp-xmltagput( input 4, "ChkNum"     , input string( buf_temp_chk-doc.chk-num   ), input 0 ).
     4763         run wp-xmltagput( input 4, "ChkNumDesk" , input string( buf_temp_chk-doc.pay-desk   ), input 0 ).
     4764         run wp-xmltagput( input 4, "Cashier"    , input string( buf_temp_chk-doc.cashier   ), input 0 ).
     4765         run wp-xmltagput( input 4, "Reference-num"    , input string( buf_temp_chk-doc.doc-num2   ), input 0 ).
     4766         for each buf_temp_chk-gds where buf_temp_chk-gds.doc-code = buf_temp_chk-doc.doc-code:
     4767           run wp-xmltagopen( input 4, input "CheckGds", input "" ).
     4768           run wp-xmltagput( input 5, "ChkGds-code", input string( buf_temp_chk-gds.gds-code   ), input 0 ).
     4769           run wp-xmltagput( input 5, "ChkQnty"    , input string( buf_temp_chk-gds.qnty,  "->>>>>>>>>9.99"       ), input 0 ).
     4770           run wp-xmltagput( input 5, "ChkTRK"     , input string( buf_temp_chk-gds.pump       ), input 0 ).
     4771           run wp-xmltagput( input 5, "ChkNozzle"  , input string( buf_temp_chk-gds.nozzle-code), input 0 ).
     4772           run wp-xmltagput( input 5, "ChkPL"      , input string( buf_temp_chk-gds.pl-code    ), input 2 ).
     4773           run wp-xmltagclose( input 4, input "CheckGds").
     4774         end.
     4775         run wp-xmltagclose( input 3, input "Check").
     4776       end.
     4777       for each buf_temp_chk-doc where buf_temp_chk-doc.chk-type = integer('15':U):
     4778         run wp-xmltagopen( input 3, input "Check", input "" ).
     4779         run wp-xmltagput( input 4, "ChkTypeName", input string( "Перелив" ), input 0 ).
     4780         run wp-xmltagput( input 4, "ChkType"    , input string( '15':U   ), input 0 ).
     4781         run wp-xmltagput( input 4, "ChkDate"    , input string( buf_temp_chk-doc.chk-date   ), input 0 ).
     4782         run wp-xmltagput( input 4, "ChkTime"    , input string( buf_temp_chk-doc.chk-time, "hh:mm:ss"   ), input 0 ).
     4783         run wp-xmltagput( input 4, "ChkDocNum"  , input string( buf_temp_chk-doc.doc-code   ), input 0 ).
     4784         run wp-xmltagput( input 4, "ChkNum"     , input string( buf_temp_chk-doc.chk-num   ), input 0 ).
     4785         run wp-xmltagput( input 4, "ChkNumDesk" , input string( buf_temp_chk-doc.pay-desk   ), input 0 ).
     4786         run wp-xmltagput( input 4, "Cashier"    , input string( buf_temp_chk-doc.cashier   ), input 0 ).
     4787         run wp-xmltagput( input 4, "Reference-num"    , input string( buf_temp_chk-doc.doc-num2   ), input 0 ).
     4788         for each buf_temp_chk-gds where buf_temp_chk-gds.doc-code = buf_temp_chk-doc.doc-code:
     4789           run wp-xmltagopen( input 4, input "CheckGds", input "" ).
     4790           run wp-xmltagput( input 5, "ChkGds-code", input string( buf_temp_chk-gds.gds-code   ), input 0 ).
     4791           run wp-xmltagput( input 5, "ChkQnty"    , input string( buf_temp_chk-gds.qnty,  "->>>>>>>>>9.99"       ), input 0 ).
     4792           run wp-xmltagput( input 5, "ChkTRK"     , input string( buf_temp_chk-gds.pump       ), input 0 ).
     4793           run wp-xmltagput( input 5, "ChkNozzle"  , input string( buf_temp_chk-gds.nozzle-code), input 0 ).
     4794           run wp-xmltagput( input 5, "ChkPL"      , input string( buf_temp_chk-gds.pl-code    ), input 2 ).
     4795           run wp-xmltagclose( input 4, input "CheckGds").
     4796         end.
     4797         run wp-xmltagclose( input 3, input "Check").
     4798       end.
     4799       run wp-xmltagclose( input 2, input "TechChk").
     4800     end.
     4801   end procedure.
     4802   procedure export-stkShift :
     4803   define input parameter p-obj-type   as character        no-undo.
     4804   define input parameter p-obj-code   as integer          no-undo.
     4805   define input parameter p-shift-date as date             no-undo.
     4806   define input parameter p-shift-num  as integer          no-undo.
     4807   define VARIABLE v-shift-date as date             no-undo.
     4808   define VARIABLE v-shift-num  as integer          no-undo.
     4809   define buffer end_shift-obj      for ub.shift-obj .
     4810   define buffer previous-shift-obj for ub.shift-obj.
     4811   define variable fo      as decimal no-undo init 0.
     4812   define variable prev-fo as decimal no-undo init 0.
     4813   define variable moving  as logical no-undo init yes.
     4814     define buffer buf_rvs-doc              for ub.rvs-doc.
     4815     define buffer buf_rvs-line             for ub.rvs-line.
     4816     define buffer buf_rvs-line-pump        for ub.rvs-line-pump.
     4817     define buffer buf_goods                for ub.goods.
     4818     define buffer buf_temp_stkShiftEnd     for temp_stkShiftEnd.
     4819     define buffer buf_temp_stkPlShiftEnd   for temp_stkPlShiftEnd.
     4820     define buffer buf_temp_stkTRKShiftEnd  for temp_stkTRKShiftEnd.
     4821     define buffer buf_temp_stkShiftOpen    for temp_stkShiftOpen.
     4822     define buffer buf_temp_stkPlShiftOpen  for temp_stkPlShiftOpen.
     4823     define buffer buf_temp_stkTRKShiftOpen for temp_stkTRKShiftOpen.
     4824     find first end_shift-obj share-lock
     4825          where end_shift-obj.obj-type   = p-obj-type
     4826            and end_shift-obj.obj-code   = p-obj-code
     4827            and end_shift-obj.shift-date = p-shift-date
     4828            and end_shift-obj.shift-num  = p-shift-num
     4829       no-error.
     4830     if not available end_shift-obj then do:
     4831       run wp-XMLWriteLog in this-procedure (
     4832            input p-log-file-name
     4833          , input 1
     4834          , input substitute( "&1. Не найдена смена с порядковым номером &2 от &3 для объекта &4 &5. &6. &7. &8."
     4835                                  , vss-description
     4836                                  , p-shift-num
     4837                                  , p-shift-date
     4838                                  , p-obj-type
     4839                                  , p-obj-code
     4840                                  , return-value
     4841                                  , trim(error-status :get-message(1))
     4842                                  , trim(error-status :get-message(2))
     4843                          )
     4844       ).
     4845     end.
     4846     else do:
     4847       assign
     4848         fo = end_shift-obj.fact-order
     4849       .
     4850     end.
     4851     find last previous-shift-obj share-lock
     4852         where previous-shift-obj.obj-type = p-obj-type
     4853           and previous-shift-obj.obj-code = p-obj-code
     4854           and (( previous-shift-obj.shift-date = p-shift-date
     4855              and previous-shift-obj.shift-num < p-shift-num
     4856                )
     4857            or previous-shift-obj.shift-date < p-shift-date
     4858               )
     4859       use-index pi no-error.
     4860     if available previous-shift-obj then do:
     4861       assign
     4862         prev-fo = previous-shift-obj.fact-order
     4863       .
     4864     end.
     4865     do
     4866       for buf_rvs-doc
     4867       , buf_rvs-line
     4868       , buf_goods
     4869       , buf_temp_stkShiftEnd
     4870       , buf_temp_stkPlShiftEnd
     4871       , buf_temp_stkTRKShiftEnd
     4872       on error undo, return error
     4873       :
     4874       empty temp-table buf_temp_stkShiftEnd.
     4875       empty temp-table buf_temp_stkPlShiftEnd.
     4876       empty temp-table buf_temp_stkTRKShiftEnd.
     4877       if available previous-shift-obj then do:
     4878         assign
     4879           v-shift-date = previous-shift-obj.shift-date
     4880           v-shift-num  = previous-shift-obj.shift-num
     4881         .
     4882       end.
     4883       find first buf_rvs-doc no-lock
     4884            where buf_rvs-doc.obj-type     = p-obj-type
     4885              and buf_rvs-doc.obj-code     = p-obj-code
     4886              and buf_rvs-doc.shift-date   = p-shift-date
     4887              and buf_rvs-doc.shift-num    = p-shift-num
     4888              and buf_rvs-doc.status_      = 'факт':U
     4889              and buf_rvs-doc.rvs-type     = 'смена':U
     4890       use-index shift
     4891       no-error.
     4892       if available buf_rvs-doc
     4893       then do:
     4894         for each buf_rvs-line no-lock
     4895            where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     4896              and buf_rvs-line.obj-type = p-obj-type
     4897              and buf_rvs-line.obj-code = p-obj-code
     4898           on error undo, return error
     4899           :
     4900           find first buf_temp_stkShiftEnd
     4901                where buf_temp_stkShiftEnd.gds-code = buf_rvs-line.gds-code
     4902           no-error.
     4903           if not available buf_temp_stkShiftEnd
     4904           then do:
     4905             create buf_temp_stkShiftEnd.
     4906             assign
     4907               buf_temp_stkShiftEnd.gds-code = buf_rvs-line.gds-code
     4908             .
     4909             find first buf_goods no-lock
     4910                  where buf_goods.gds-code = buf_rvs-line.gds-code
     4911             no-error.
     4912             if available buf_goods
     4913             then do:
     4914               assign
     4915                 buf_temp_stkShiftEnd.artic     = buf_goods.artic
     4916                 buf_temp_stkShiftEnd.prod-type = buf_goods.prod-type
     4917                 buf_temp_stkShiftEnd.prod-code = buf_goods.prod-code
     4918                 buf_temp_stkShiftEnd.gds-name  = buf_goods.gds-name
     4919                 buf_temp_stkShiftEnd.qnty      = 0.0
     4920                 buf_temp_stkShiftEnd.cli-qnty  = 0.0
     4921               .
     4922                 buf_temp_stkShiftEnd.envd = no .
     4923             end.
     4924           end.
     4925           assign
     4926             buf_temp_stkShiftEnd.qnty     = buf_temp_stkShiftEnd.qnty + buf_rvs-line.state-measure-qnty
     4927             buf_temp_stkShiftEnd.cli-qnty = buf_temp_stkShiftEnd.cli-qnty + buf_rvs-line.state-measure-cli-qnty
     4928           .
     4929           find first buf_temp_stkPlShiftEnd
     4930                where buf_temp_stkPlShiftEnd.gds-code = buf_rvs-line.gds-code
     4931                  and buf_temp_stkPlShiftEnd.pl-code = buf_rvs-line.pl-code
     4932           no-error.
     4933           if not available buf_temp_stkPlShiftEnd
     4934           then do:
     4935             create buf_temp_stkPlShiftEnd.
     4936             assign
     4937               buf_temp_stkPlShiftEnd.gds-code = buf_rvs-line.gds-code
     4938               buf_temp_stkPlShiftEnd.pl-code  = buf_rvs-line.pl-code
     4939             .
     4940             find first buf_goods no-lock
     4941                  where buf_goods.gds-code = buf_rvs-line.gds-code
     4942             no-error.
     4943             if available buf_goods
     4944             then do:
     4945               assign
     4946                 buf_temp_stkPlShiftEnd.qnty            = buf_rvs-line.state-measure-qnty
     4947                 buf_temp_stkPlShiftEnd.cli-qnty        = buf_rvs-line.state-measure-cli-qnty
     4948                 buf_temp_stkPlShiftEnd.state-density   = buf_rvs-line.state-density
     4949                 buf_temp_stkPlShiftEnd.system-qnty     = buf_rvs-line.system-qnty
     4950                 buf_temp_stkPlShiftEnd.systen-cli-qnty = buf_rvs-line.system-cli-qnty
     4951                 buf_temp_stkPlShiftEnd.temperature     = buf_rvs-line.state-temperature
     4952                 buf_temp_stkPlShiftEnd.level-petrol    = buf_rvs-line.state-level-petrol
     4953                 buf_temp_stkPlShiftEnd.level-total     = buf_rvs-line.state-level-total
     4954                 buf_temp_stkPlShiftEnd.level-water     = buf_rvs-line.state-level-water
     4955                 buf_temp_stkPlShiftEnd.state-add-quantity        = buf_rvs-line.state-add-qnty
     4956               .
     4957             end.
     4958           end.
     4959         end.
     4960         for each buf_rvs-line-pump no-lock where
     4961               buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
     4962           and buf_rvs-line-pump.obj-type = p-obj-type
     4963           and buf_rvs-line-pump.obj-code = p-obj-code
     4964           break
     4965           by buf_rvs-line-pump.pump-code
     4966           by buf_rvs-line-pump.nozzle-code
     4967           on error undo, return error:
     4968           if first-of(buf_rvs-line-pump.nozzle-code) then do:
     4969             find first buf_temp_stkTrkShiftEnd where
     4970                        buf_temp_stkTrkShiftEnd.pump-code = buf_rvs-line-pump.pump-code
     4971               and buf_temp_stkTrkShiftEnd.nozzle-code = buf_rvs-line-pump.nozzle-code
     4972               and buf_temp_stkTRKShiftEnd.pl-code = buf_rvs-line-pump.pl-code no-error.
     4973             if not available buf_temp_stkTrkShiftEnd then do:
     4974               create buf_temp_stkTrkShiftEnd.
     4975               assign
     4976                 buf_temp_stkTRKShiftEnd.pl-code      = buf_rvs-line-pump.pl-code
     4977                 buf_temp_stkTrkShiftEnd.pump-code    = buf_rvs-line-pump.pump-code
     4978                 buf_temp_stkTrkShiftEnd.nozzle-code  = buf_rvs-line-pump.nozzle-code
     4979                 buf_temp_stkTrkShiftEnd.gds-code     = buf_rvs-line-pump.gds-code
     4980                 buf_temp_stkTrkShiftEnd.state-mh-cnt = buf_rvs-line-pump.state-mh-cnt
     4981               .
     4982             end.
     4983           end.
     4984         end.
     4985       end.
     4986       find first buf_rvs-doc no-lock
     4987            where buf_rvs-doc.obj-type     = p-obj-type
     4988              and buf_rvs-doc.obj-code     = p-obj-code
     4989              and buf_rvs-doc.shift-date   = v-shift-date
     4990              and buf_rvs-doc.shift-num    = v-shift-num
     4991              and buf_rvs-doc.status_      = 'факт':U
     4992              and buf_rvs-doc.rvs-type     = 'смена':U
     4993       use-index shift
     4994       no-error.
     4995       if available buf_rvs-doc
     4996       then do:
     4997         for each buf_rvs-line no-lock
     4998            where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     4999              and buf_rvs-line.obj-type = p-obj-type
     5000              and buf_rvs-line.obj-code = p-obj-code
     5001           on error undo, return error
     5002           :
     5003           find first buf_temp_stkShiftOpen
     5004                where buf_temp_stkShiftOpen.gds-code = buf_rvs-line.gds-code
     5005           no-error.
     5006           if not available buf_temp_stkShiftOpen
     5007           then do:
     5008             create buf_temp_stkShiftOpen.
     5009             assign
     5010               buf_temp_stkShiftOpen.gds-code = buf_rvs-line.gds-code
     5011             .
     5012             find first buf_goods no-lock
     5013                  where buf_goods.gds-code = buf_rvs-line.gds-code
     5014             no-error.
     5015             if available buf_goods
     5016             then do:
     5017               assign
     5018                 buf_temp_stkShiftOpen.artic     = buf_goods.artic
     5019                 buf_temp_stkShiftOpen.prod-type = buf_goods.prod-type
     5020                 buf_temp_stkShiftOpen.prod-code = buf_goods.prod-code
     5021                 buf_temp_stkShiftOpen.gds-name  = buf_goods.gds-name
     5022                 buf_temp_stkShiftOpen.qnty      = 0.0
     5023                 buf_temp_stkShiftOpen.cli-qnty  = 0.0
     5024               .
     5025                 buf_temp_stkShiftOpen.envd = no .
     5026             end.
     5027           end.
     5028           assign
     5029             buf_temp_stkShiftOpen.qnty     = buf_temp_stkShiftOpen.qnty + buf_rvs-line.state-measure-qnty
     5030             buf_temp_stkShiftOpen.cli-qnty = buf_temp_stkShiftOpen.cli-qnty + buf_rvs-line.state-measure-cli-qnty
     5031           .
     5032           find first buf_temp_stkPlShiftOpen
     5033                where buf_temp_stkPlShiftOpen.gds-code = buf_rvs-line.gds-code
     5034                  and buf_temp_stkPlShiftOpen.pl-code = buf_rvs-line.pl-code
     5035           no-error.
     5036           if not available buf_temp_stkPlShiftOpen
     5037           then do:
     5038             create buf_temp_stkPlShiftOpen.
     5039             assign
     5040               buf_temp_stkPlShiftOpen.gds-code = buf_rvs-line.gds-code
     5041               buf_temp_stkPlShiftOpen.pl-code  = buf_rvs-line.pl-code
     5042             .
     5043             find first buf_goods no-lock
     5044                  where buf_goods.gds-code = buf_rvs-line.gds-code
     5045             no-error.
     5046             if available buf_goods
     5047             then do:
     5048               assign
     5049                 buf_temp_stkPlShiftOpen.qnty            = buf_rvs-line.state-measure-qnty
     5050                 buf_temp_stkPlShiftOpen.cli-qnty        = buf_rvs-line.state-measure-cli-qnty
     5051                 buf_temp_stkPlShiftOpen.state-density   = buf_rvs-line.state-density
     5052                 buf_temp_stkPlShiftOpen.system-qnty     = buf_rvs-line.system-qnty
     5053                 buf_temp_stkPlShiftOpen.systen-cli-qnty = buf_rvs-line.system-cli-qnty
     5054                 buf_temp_stkPlShiftOpen.temperature     = buf_rvs-line.state-temperature
     5055                 buf_temp_stkPlShiftOpen.level-petrol    = buf_rvs-line.state-level-petrol
     5056                 buf_temp_stkPlShiftOpen.level-total     = buf_rvs-line.state-level-total
     5057                 buf_temp_stkPlShiftOpen.level-water     = buf_rvs-line.state-level-water
     5058                 buf_temp_stkPlShiftOpen.state-add-quantity  = buf_rvs-line.state-add-qnty
     5059               .
     5060             end.
     5061           end.
     5062         end.
     5063         for each buf_rvs-line-pump no-lock where
     5064               buf_rvs-line-pump.rvs-code = buf_rvs-doc.rvs-code
     5065           and buf_rvs-line-pump.obj-type = p-obj-type
     5066           and buf_rvs-line-pump.obj-code = p-obj-code
     5067           break
     5068           by buf_rvs-line-pump.pump-code
     5069           by buf_rvs-line-pump.nozzle-code
     5070           on error undo, return error:
     5071           if first-of(buf_rvs-line-pump.nozzle-code) then do:
     5072             find first buf_temp_stkTrkShiftOpen where
     5073                        buf_temp_stkTrkShiftOpen.pump-code = buf_rvs-line-pump.pump-code
     5074               and buf_temp_stkTrkShiftOpen.nozzle-code = buf_rvs-line-pump.nozzle-code
     5075               and buf_temp_stkTRKShiftOpen.pl-code = buf_rvs-line-pump.pl-code no-error.
     5076             if not available buf_temp_stkTrkShiftOpen then do:
     5077               create buf_temp_stkTrkShiftOpen.
     5078               assign
     5079                 buf_temp_stkTRKShiftOpen.pl-code      = buf_rvs-line-pump.pl-code
     5080                 buf_temp_stkTrkShiftOpen.pump-code    = buf_rvs-line-pump.pump-code
     5081                 buf_temp_stkTrkShiftOpen.nozzle-code  = buf_rvs-line-pump.nozzle-code
     5082                 buf_temp_stkTrkShiftOpen.gds-code     = buf_rvs-line-pump.gds-code
     5083                 buf_temp_stkTrkShiftOpen.state-mh-cnt = buf_rvs-line-pump.state-mh-cnt
     5084               .
     5085             end.
     5086           end.
     5087         end.
     5088       end.
     5089       for each buf_temp_stkShiftEnd
     5090       :
     5091         run wp-xmltagopen( input 2, input "stkShiftEnd", input "" ).
     5092         run wp-xmltagput( input 3, "objType"    , input string( p-obj-type                      ), input 0 ).
     5093         run wp-xmltagput( input 3, "objCode"    , input string( p-obj-code                      ), input 0 ).
     5094         run wp-xmltagput( input 3, "shiftDate"  , input string( p-shift-date, "99.99.9999"      ), input 0 ).
     5095         run wp-xmltagput( input 3, "shiftNum"   , input string( p-shift-num                     ), input 0 ).
     5096         run wp-xmltagput( input 3, "sseArtic"   , input string( buf_temp_stkShiftEnd.artic      ), input 0 ).
     5097         run wp-xmltagput( input 3, "sseProdType", input string( buf_temp_stkShiftEnd.prod-type  ), input 0 ).
     5098         run wp-xmltagput( input 3, "sseProdCode", input string( buf_temp_stkShiftEnd.prod-code  ), input 0 ).
     5099         run wp-xmltagput( input 3, "sseGdsCode" , input string( buf_temp_stkShiftEnd.gds-code   ), input 0 ).
     5100         run wp-xmltagput( input 3, "sseGdsName" , input string( buf_temp_stkShiftEnd.gds-name   ), input 0 ).
     5101         run wp-xmltagput( input 3, "sseGdsENVD" , input string( buf_temp_stkShiftEnd.envd       ), input 3 ).
     5102         run wp-xmltagput( input 3, "sseFactQnty", input string( buf_temp_stkShiftEnd.qnty       ), input 0 ).
     5103         run wp-xmltagput( input 3, "sseCliFactQnty", input string( buf_temp_stkShiftEnd.cli-qnty       ), input 0 ).
     5104         for each buf_temp_stkPlShiftEnd where buf_temp_stkPlShiftEnd.gds-code = buf_temp_stkShiftEnd.gds-code:
     5105           for first buf_temp_stkPlShiftOpen where buf_temp_stkPlShiftOpen.gds-code = buf_temp_stkPlShiftEnd.gds-code
     5106             and buf_temp_stkPlShiftOpen.pl-code = buf_temp_stkPlShiftEnd.pl-code :
     5107             run wp-xmltagopen( input 3, input "stkPlShiftOpen", input "" ).
     5108             run wp-xmltagput( input 4, "ssePlCode", input string( buf_temp_stkPlShiftOpen.pl-code       ), input 0 ).
     5109             run wp-xmltagput( input 4, "ssePlFactQnty", input string( buf_temp_stkPlShiftOpen.qnty       ), input 0 ).
     5110             run wp-xmltagput( input 4, "ssePlCliFactQnty", input string( buf_temp_stkPlShiftOpen.cli-qnty       ), input 0 ).
     5111             run wp-xmltagput( input 4, "ssePlDensity", input string( buf_temp_stkPlShiftOpen.state-density), input 0 ).
     5112             run wp-xmltagput( input 4, "ssePlTemperature", input string( buf_temp_stkPlShiftOpen.temperature), input 0 ).
     5113             run wp-xmltagput( input 4, "ssePlLevelPetrol", input string( buf_temp_stkPlShiftOpen.level-petrol), input 0 ).
     5114             run wp-xmltagput( input 4, "ssePlLevelTotal", input string( buf_temp_stkPlShiftOpen.level-total), input 0 ).
     5115             run wp-xmltagput( input 4, "ssePlLevelWater", input string( buf_temp_stkPlShiftOpen.level-water), input 0 ).
     5116             run wp-xmltagput( input 4, "ssePlAddQuantity", input string( buf_temp_stkPlShiftOpen.state-add-quantity), input 0 ).
     5117             run wp-xmltagput( input 4, "ssePlSysQnty", input string( buf_temp_stkPlShiftOpen.system-qnty), input 0 ).
     5118             run wp-xmltagput( input 4, "ssePlSysWeight", input string( buf_temp_stkPlShiftOpen.systen-cli-qnty), input 0 ).
     5119             run wp-xmltagclose( input 3, input "stkPlShiftOpen").
     5120           end.
     5121           run wp-xmltagopen( input 3, input "stkPlShiftEnd", input "" ).
     5122           run wp-xmltagput( input 4, "ssePlCode", input string( buf_temp_stkPlShiftEnd.pl-code       ), input 0 ).
     5123           run wp-xmltagput( input 4, "ssePlFactQnty", input string( buf_temp_stkPlShiftEnd.qnty       ), input 0 ).
     5124           run wp-xmltagput( input 4, "ssePlCliFactQnty", input string( buf_temp_stkPlShiftEnd.cli-qnty       ), input 0 ).
     5125           run wp-xmltagput( input 4, "ssePlDensity", input string( buf_temp_stkPlShiftEnd.state-density), input 0 ).
     5126           run wp-xmltagput( input 4, "ssePlTemperature", input string(  buf_temp_stkPlShiftEnd.temperature), input 0 ).
     5127           run wp-xmltagput( input 4, "ssePlLevelPetrol", input string(  buf_temp_stkPlShiftEnd.level-petrol), input 0 ).
     5128           run wp-xmltagput( input 4, "ssePlLevelTotal", input string(  buf_temp_stkPlShiftEnd.level-total), input 0 ).
     5129           run wp-xmltagput( input 4, "ssePlLevelWater", input string(  buf_temp_stkPlShiftEnd.level-water), input 0 ).
     5130           run wp-xmltagput( input 4, "ssePlAddQuantity", input string( buf_temp_stkPlShiftEnd.state-add-quantity), input 0 ).
     5131           run wp-xmltagput( input 4, "ssePlSysQnty", input string( buf_temp_stkPlShiftEnd.system-qnty), input 0 ).
     5132           run wp-xmltagput( input 4, "ssePlSysWeight", input string( buf_temp_stkPlShiftEnd.systen-cli-qnty), input 0 ).
     5133           run wp-xmltagclose( input 3, input "stkPlShiftEnd").
     5134         end.
     5135         for each buf_temp_stkTrkShiftEnd where buf_temp_stkTrkShiftEnd.gds-code = buf_temp_stkShiftEnd.gds-code:
     5136           for first  buf_temp_stkTrkShiftOpen where buf_temp_stkTrkShiftOpen.gds-code = buf_temp_stkShiftEnd.gds-code
     5137             and buf_temp_stkTRKShiftOpen.gds-code = buf_temp_stkTRKShiftEnd.gds-code
     5138             and buf_temp_stkTRKShiftOpen.pl-code = buf_temp_stkTRKShiftEnd.pl-code
     5139             and buf_temp_stkTRKShiftOpen.pump-code = buf_temp_stkTRKShiftEnd.pump-code
     5140             and buf_temp_stkTRKShiftOpen.nozzle-code = buf_temp_stkTRKShiftEnd.nozzle-code :
     5141             run wp-xmltagopen( input 3, input "stkTRKShiftOpen", input "" ).
     5142             run wp-xmltagput( input 4, "sseTRKPlCode", input string( buf_temp_stkTRKShiftOpen.pl-code   ), input 0 ).
     5143             run wp-xmltagput( input 4, "sseTRKPump", input string( buf_temp_stkTRKShiftOpen.pump-code   ), input 0 ).
     5144             run wp-xmltagput( input 4, "sseTRKNozzle", input string( buf_temp_stkTRKShiftOpen.nozzle-code   ), input 0 ).
     5145             run wp-xmltagput( input 4, "sseTRKCnt", input string( buf_temp_stkTRKShiftOpen.state-mh-cnt   ), input 0 ).
     5146             run wp-xmltagclose( input 3, input "stkTRKShiftOpen").
     5147           end.
     5148           run wp-xmltagopen( input 3, input "stkTRKShiftEnd", input "" ).
     5149           run wp-xmltagput( input 4, "sseTRKPlCode", input string( buf_temp_stkTRKShiftEnd.pl-code   ), input 0 ).
     5150           run wp-xmltagput( input 4, "sseTRKPump", input string( buf_temp_stkTRKShiftEnd.pump-code   ), input 0 ).
     5151           run wp-xmltagput( input 4, "sseTRKNozzle", input string( buf_temp_stkTRKShiftEnd.nozzle-code   ), input 0 ).
     5152           run wp-xmltagput( input 4, "sseTRKCnt", input string( buf_temp_stkTRKShiftEnd.state-mh-cnt   ), input 0 ).
     5153           run wp-xmltagclose( input 3, input "stkTRKShiftEnd").
     5154         end.
     5155         run wp-xmltagclose( input 2, input "stkShiftEnd").
     5156       end.
     5157     end.
     5158   end procedure.
     5159   procedure export-stkTNP :
     5160   define input parameter p-obj-type   as character        no-undo.
     5161   define input parameter p-obj-code   as integer          no-undo.
     5162   define input parameter p-shift-date as date             no-undo.
     5163   define input parameter p-shift-num  as integer          no-undo.
     5164     define variable v-fact-order-from as decimal no-undo.
     5165     define variable v-fact-order-to   as decimal no-undo.
     5166     define variable v-docs-exists     as logical no-undo.
     5167     define variable v-is-petrol       as logical no-undo.
     5168     define variable v-is-pieces       as logical no-undo.
     5169     define buffer buf_stk-line    for ub.stk-line.
     5170     define buffer buf_ot-line     for ub.ot-line.
     5171     define buffer buf_gds-obj     for ub.gds-obj.
     5172     define buffer buf_goods       for ub.goods.
     5173     define buffer buf_temp_stkTNP for temp_stkTNP.
     5174     do
     5175       for buf_stk-line
     5176       , buf_ot-line
     5177       , buf_gds-obj
     5178       , buf_goods
     5179       , buf_temp_stkTNP
     5180       on error undo, return error
     5181       :
     5182       empty temp-table buf_temp_stkTNP.
     5183       run rep/getfosht.p (
     5184             input p-obj-type
     5185           , input p-obj-code
     5186           , input p-shift-date
     5187           , input p-shift-num
     5188           , output v-fact-order-from
     5189           , output v-fact-order-to
     5190           , output v-docs-exists
     5191       ).
     5192       goods-on-object:
     5193       for each buf_gds-obj no-lock
     5194          where buf_gds-obj.obj-type = p-obj-type
     5195            and buf_gds-obj.obj-code = p-obj-code
     5196         on error undo, return error
     5197         :
     5198         if buf_gds-obj.first-doc > p-shift-date
     5199         then do:
     5200           undo goods-on-object, next goods-on-object.
     5201         end.
     5202   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     5203     (
     5204        input buf_gds-obj.artic
     5205     ,  input buf_gds-obj.prod-type
     5206     ,  input buf_gds-obj.prod-code
     5207     , output v-is-petrol
     5208     , output v-is-pieces
     5209     ) .
     5210         if v-is-petrol  = yes
     5211         and v-is-pieces = no
     5212         then do:
     5213           undo goods-on-object, next goods-on-object.
     5214         end.
     5215         find last buf_stk-line no-lock
     5216             where buf_stk-line.obj-type   = p-obj-type
     5217               and buf_stk-line.obj-code   = p-obj-code
     5218               and buf_stk-line.artic      = buf_gds-obj.artic
     5219               and buf_stk-line.prod-type  = buf_gds-obj.prod-type
     5220               and buf_stk-line.prod-code  = buf_gds-obj.prod-code
     5221               and buf_stk-line.fact-order <= v-fact-order-to
     5222               and buf_stk-line.sum-type   = 'crsa':U
     5223         no-error.
     5224         if available buf_stk-line
     5225         then do:
     5226           find first buf_temp_stkTNP
     5227                where buf_temp_stkTNP.artic     = buf_gds-obj.artic
     5228                  and buf_temp_stkTNP.prod-type = buf_gds-obj.prod-type
     5229                  and buf_temp_stkTNP.prod-code = buf_gds-obj.prod-code
     5230           no-error.
     5231           if not available buf_temp_stkTNP
     5232           then do:
     5233             create buf_temp_stkTNP.
     5234             assign
     5235               buf_temp_stkTNP.artic     = buf_gds-obj.artic
     5236               buf_temp_stkTNP.prod-type = buf_gds-obj.prod-type
     5237               buf_temp_stkTNP.prod-code = buf_gds-obj.prod-code
     5238             .
     5239           end.
     5240           find first buf_goods no-lock
     5241                where buf_goods.artic     = buf_temp_stkTNP.artic
     5242                  and buf_goods.prod-type = buf_temp_stkTNP.prod-type
     5243                  and buf_goods.prod-code = buf_temp_stkTNP.prod-code
     5244           no-error.
     5245           if available buf_goods
     5246           then do:
     5247             assign
     5248               buf_temp_stkTNP.gds-code = buf_goods.gds-code
     5249               buf_temp_stkTNP.gds-name = buf_goods.gds-name
     5250             .
     5251               buf_temp_stkTNP.envd = no .
     5252           end.
     5253           assign
     5254             buf_temp_stkTNP.end-sumSale = buf_stk-line.sum-rubl
     5255             buf_temp_stkTNP.end-sumVat  = buf_stk-line.VAT-rubl
     5256             buf_temp_stkTNP.end-qnty    = buf_stk-line.fact-qnty
     5257           .
     5258         end.
     5259       end.
     5260       for each buf_temp_stkTNP
     5261       :
     5262         assign
     5263           buf_temp_stkTNP.start-sumSale = buf_temp_stkTNP.end-sumSale
     5264           buf_temp_stkTNP.start-sumVat  = buf_temp_stkTNP.end-sumVat
     5265         .
     5266         for each buf_ot-line no-lock
     5267            where buf_ot-line.obj-type  = p-obj-type
     5268              and buf_ot-line.obj-code  = p-obj-code
     5269              and buf_ot-line.artic     = buf_temp_stkTNP.artic
     5270              and buf_ot-line.prod-type = buf_temp_stkTNP.prod-type
     5271              and buf_ot-line.prod-code = buf_temp_stkTNP.prod-code
     5272              and buf_ot-line.fact-order >= v-fact-order-from
     5273              and buf_ot-line.fact-order <= v-fact-order-to
     5274           on error undo, return error
     5275           :
     5276           if buf_ot-line.sum-type  = 'crsa':U
     5277           or buf_ot-line.sum-type  = 'cgsr':U
     5278           then do:
     5279             assign
     5280               buf_temp_stkTNP.start-sumSale = buf_temp_stkTNP.start-sumSale - buf_ot-line.sum-rubl
     5281               buf_temp_stkTNP.start-sumVat  = buf_temp_stkTNP.start-sumVat  - buf_ot-line.VAT-rubl
     5282             .
     5283           end.
     5284         end.
     5285       end.
     5286       for each buf_temp_stkTNP
     5287       :
     5288         if buf_temp_stkTNP.start-sumSale    <> 0
     5289         or buf_temp_stkTNP.start-sumVat     <> 0
     5290         or buf_temp_stkTNP.end-sumSale      <> 0
     5291         or buf_temp_stkTNP.end-sumVat       <> 0
     5292         then do:
     5293           run wp-xmltagopen( input 2, input "stkTNP", input "" ).
     5294           run wp-xmltagput( input 3, "objType"        , input string( p-obj-type                      ), input 0 ).
     5295           run wp-xmltagput( input 3, "objCode"        , input string( p-obj-code                      ), input 0 ).
     5296           run wp-xmltagput( input 3, "shiftDate"      , input string( p-shift-date, "99.99.9999"      ), input 0 ).
     5297           run wp-xmltagput( input 3, "shiftNum"       , input string( p-shift-num                     ), input 0 ).
     5298           run wp-xmltagput( input 3, "stnArtic"       , input string( buf_temp_stkTNP.artic           ), input 0 ).
     5299           run wp-xmltagput( input 3, "stnProdType"    , input string( buf_temp_stkTNP.prod-type       ), input 0 ).
     5300           run wp-xmltagput( input 3, "stnProdCode"    , input string( buf_temp_stkTNP.prod-code       ), input 0 ).
     5301           run wp-xmltagput( input 3, "stnGdsCode"     , input string( buf_temp_stkTNP.gds-code        ), input 0 ).
     5302           run wp-xmltagput( input 3, "stnGdsName"     , input string( buf_temp_stkTNP.gds-name        ), input 0 ).
     5303           run wp-xmltagput( input 3, "stnGdsENVD"     , input string( buf_temp_stkTNP.envd            ), input 3 ).
     5304           run wp-xmltagput( input 3, "stnStartSumSale", input string( buf_temp_stkTNP.start-sumSale   ), input 0 ).
     5305           run wp-xmltagput( input 3, "stnStartSumVat" , input string( buf_temp_stkTNP.start-sumVat    ), input 0 ).
     5306           run wp-xmltagput( input 3, "stnEndSumSale"  , input string( buf_temp_stkTNP.end-sumSale     ), input 0 ).
     5307           run wp-xmltagput( input 3, "stnEndSumVat"   , input string( buf_temp_stkTNP.end-sumVat      ), input 0 ).
     5308           run wp-xmltagput( input 3, "stnEndQnty"     , input string( buf_temp_stkTNP.end-qnty        ), input 0 ).
     5309           run wp-xmltagclose( input 3, input "stkTNP").
     5310         end.
     5311       end.
     5312     end.
     5313   end procedure.
     5314   procedure export-invTRK :
     5315     define input parameter p-obj-type   as character        no-undo.
     5316     define input parameter p-obj-code   as integer          no-undo.
     5317     define input parameter p-shift-date as date             no-undo.
     5318     define input parameter p-shift-num  as integer          no-undo.
     5319     define buffer buf_icnt-doc  for ub.icnt-doc .
     5320     define buffer buf_icnt-line for ub.icnt-line .
     5321     for each buf_icnt-doc no-lock where buf_icnt-doc.obj-type = p-obj-type
     5322       and buf_icnt-doc.obj-code = p-obj-code
     5323       and buf_icnt-doc.shift-date = p-shift-date
     5324       and buf_icnt-doc.shift-num = p-shift-num
     5325       :
     5326       run wp-xmltagopen( input 2, input "invTRK", input "" ).
     5327       run wp-xmltagput( input 3, "DocCode"        , input string( buf_icnt-doc.doc-code                      ), input 0 ).
     5328       run wp-xmltagput( input 3, "DocDate"        , input string( buf_icnt-doc.doc-date                      ), input 0 ).
     5329       run wp-xmltagput( input 3, "shiftDate"      , input string( p-shift-date, "99.99.9999"      ), input 0 ).
     5330       run wp-xmltagput( input 3, "shiftNum"       , input string( p-shift-num                     ), input 0 ).
     5331       for each buf_icnt-line no-lock where buf_icnt-line.doc-code = buf_icnt-doc.doc-code:
     5332         run wp-xmltagopen( input 3, input "indTRK", input "" ).
     5333         run wp-xmltagput( input 4, "GdsCode"      , input string( buf_icnt-line.gds-code           ), input 0 ).
     5334         run wp-xmltagput( input 4, "TrkNum"       , input string( buf_icnt-line.pump-code          ), input 0 ).
     5335         run wp-xmltagput( input 4, "TrkNozzle"    , input string( buf_icnt-line.nozzle-code        ), input 0 ).
     5336         run wp-xmltagput( input 4, "IndEl"        , input string( buf_icnt-line.state-el-cnt       ), input 0 ).
     5337         run wp-xmltagput( input 4, "IndMeh"       , input string( buf_icnt-line.state-mh-cnt       ), input 0 ).
     5338         run wp-xmltagput( input 4, "DIF"          , input string( buf_icnt-line.state-el-cnt - buf_icnt-line.state-mh-cnt   ), input 0 ).
     5339         run wp-xmltagput( input 4, "IndAuto"      , input string( buf_icnt-line.meas-el-cnt    ), input 0 ).
     5340         run wp-xmltagclose( input 3, input "indTRK").
     5341       end.
     5342       run wp-xmltagclose( input 2, input "invTRK").
     5343     end.
     5344   end procedure.
     5345   procedure export-price-sum :
     5346   define input parameter p-obj-type   as character        no-undo.
     5347   define input parameter p-obj-code   as integer          no-undo.
     5348   define input parameter p-shift-date as date             no-undo.
     5349   define input parameter p-shift-num  as integer          no-undo.
     5350     define variable v-fact-order-from as decimal no-undo.
     5351     define variable v-fact-order-to   as decimal no-undo.
     5352     define variable v-docs-exists     as logical no-undo.
     5353     define variable v-is-petrol       as logical no-undo.
     5354     define variable v-is-pieces       as logical no-undo.
     5355     define buffer buf_ot-line           for ub.ot-line.
     5356     define buffer buf_gds-obj           for ub.gds-obj.
     5357     define buffer buf_goods             for ub.goods.
     5358     define buffer buf_temp_sumPriceSale for temp_sumPriceSale.
     5359     do
     5360       for buf_ot-line
     5361       , buf_gds-obj
     5362       , buf_goods
     5363       , buf_temp_sumPriceSale
     5364       on error undo, return error
     5365       :
     5366       empty temp-table buf_temp_sumPriceSale.
     5367       run rep/getfosht.p (
     5368             input p-obj-type
     5369           , input p-obj-code
     5370           , input p-shift-date
     5371           , input p-shift-num
     5372           , output v-fact-order-from
     5373           , output v-fact-order-to
     5374           , output v-docs-exists
     5375       ).
     5376       goods-on-object:
     5377       for each buf_gds-obj no-lock
     5378          where buf_gds-obj.obj-type = p-obj-type
     5379            and buf_gds-obj.obj-code = p-obj-code
     5380       on error undo, return error
     5381       :
     5382   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     5383     (
     5384        input buf_gds-obj.artic
     5385     ,  input buf_gds-obj.prod-type
     5386     ,  input buf_gds-obj.prod-code
     5387     , output v-is-petrol
     5388     , output v-is-pieces
     5389     ) .
     5390         if v-is-petrol  = yes
     5391         and v-is-pieces = no
     5392         then do:
     5393           undo goods-on-object, next goods-on-object.
     5394         end.
     5395         if buf_gds-obj.first-doc > p-shift-date
     5396         then do:
     5397           undo goods-on-object, next goods-on-object.
     5398         end.
     5399         for each buf_ot-line no-lock
     5400            where buf_ot-line.obj-type  = p-obj-type
     5401              and buf_ot-line.obj-code  = p-obj-code
     5402              and buf_ot-line.artic     = buf_gds-obj.artic
     5403              and buf_ot-line.prod-type = buf_gds-obj.prod-type
     5404              and buf_ot-line.prod-code = buf_gds-obj.prod-code
     5405              and buf_ot-line.fact-order >= v-fact-order-from
     5406              and buf_ot-line.fact-order <= v-fact-order-to
     5407           on error undo, return error
     5408           :
     5409           if buf_ot-line.ext-doc-type  = 'ot':U
     5410           then do:
     5411             find first buf_temp_sumPriceSale
     5412                  where buf_temp_sumPriceSale.artic     = buf_ot-line.artic
     5413                    and buf_temp_sumPriceSale.prod-type = buf_ot-line.prod-type
     5414                    and buf_temp_sumPriceSale.prod-code = buf_ot-line.prod-code
     5415             no-error.
     5416             if not available buf_temp_sumPriceSale
     5417             then do:
     5418               create buf_temp_sumPriceSale.
     5419               assign
     5420                 buf_temp_sumPriceSale.artic     = buf_ot-line.artic
     5421                 buf_temp_sumPriceSale.prod-type = buf_ot-line.prod-type
     5422                 buf_temp_sumPriceSale.prod-code = buf_ot-line.prod-code
     5423               .
     5424               find first buf_goods no-lock
     5425                    where buf_goods.artic     = buf_ot-line.artic
     5426                      and buf_goods.prod-type = buf_ot-line.prod-type
     5427                      and buf_goods.prod-code = buf_ot-line.prod-code
     5428               no-error.
     5429               if available buf_goods
     5430               then do:
     5431                 assign
     5432                   buf_temp_sumPriceSale.gds-code = buf_goods.gds-code
     5433                   buf_temp_sumPriceSale.gds-name = buf_goods.gds-name
     5434                 .
     5435                   buf_temp_sumPriceSale.envd = no .
     5436               end.
     5437             end.
     5438             assign
     5439               buf_temp_sumPriceSale.sumSale = buf_temp_sumPriceSale.sumSale + buf_ot-line.sum-rubl
     5440               buf_temp_sumPriceSale.sumVat  = buf_temp_sumPriceSale.sumSale + buf_ot-line.VAT-rubl
     5441             .
     5442           end.
     5443         end.
     5444       end.
     5445       for each buf_temp_sumPriceSale
     5446       :
     5447         if buf_temp_sumPriceSale.sumSale    <> 0
     5448         or buf_temp_sumPriceSale.sumVat     <> 0
     5449         then do:
     5450           run wp-xmltagopen( input 2, input "sumPriceSale", input "" ).
     5451           run wp-xmltagput( input 3, "objType"        , input string( p-obj-type                      ), input 0 ).
     5452           run wp-xmltagput( input 3, "objCode"        , input string( p-obj-code                      ), input 0 ).
     5453           run wp-xmltagput( input 3, "shiftDate"      , input string( p-shift-date, "99.99.9999"      ), input 0 ).
     5454           run wp-xmltagput( input 3, "shiftNum"       , input string( p-shift-num                     ), input 0 ).
     5455           run wp-xmltagput( input 3, "spsArtic"       , input string( buf_temp_sumPriceSale.artic     ), input 0 ).
     5456           run wp-xmltagput( input 3, "spsProdType"    , input string( buf_temp_sumPriceSale.prod-type ), input 0 ).
     5457           run wp-xmltagput( input 3, "spsProdCode"    , input string( buf_temp_sumPriceSale.prod-code ), input 0 ).
     5458           run wp-xmltagput( input 3, "spsGdsCode"     , input string( buf_temp_sumPriceSale.gds-code  ), input 0 ).
     5459           run wp-xmltagput( input 3, "spsGdsName"     , input string( buf_temp_sumPriceSale.gds-name  ), input 0 ).
     5460           run wp-xmltagput( input 3, "spsGdsENVD"     , input string( buf_temp_sumPriceSale.envd      ), input 3 ).
     5461           run wp-xmltagput( input 3, "spsSumSale"     , input string( buf_temp_sumPriceSale.sumSale   ), input 0 ).
     5462           run wp-xmltagput( input 3, "spsSumVat"      , input string( buf_temp_sumPriceSale.sumVat    ), input 0 ).
     5463           run wp-xmltagclose( input 3, input "sumPriceSale").
     5464         end.
     5465       end.
     5466     end.
     5467   end procedure.
     5468   procedure export-stk-den :
     5469     define input parameter p-host-code  as character        no-undo .
     5470     define input parameter p-obj-type   as character        no-undo .
     5471     define input parameter p-obj-code   as integer          no-undo .
     5472     define input parameter p-shift-date as date             no-undo .
     5473     define input parameter p-shift-num  as integer          no-undo .
     5474     define variable v-ost-begin  as decimal no-undo .
     5475     define variable v-ost-end    as decimal no-undo .
     5476     define variable Fact-order-1 like ub.stk-tot.Fact-order no-undo .
     5477     define variable Fact-order-2 like ub.stk-tot.Fact-order no-undo .
     5478     run create_obj-list in this-procedure (p-obj-type, p-obj-code).
     5479     run fostatok in this-procedure (
     5480       input   p-host-code
     5481       ,input   p-obj-code
     5482       ,input   p-obj-type
     5483       ,input   true
     5484       ,input   p-shift-date - 1
     5485       ,input   date('')
     5486       ,input   p-shift-num
     5487       ,input   p-shift-num
     5488       ,input   yes
     5489       ,input   0
     5490       ,input   0
     5491       ,output  v-ost-begin
     5492       ,output  Fact-order-1
     5493       ) no-error .
     5494     run fostatok in this-procedure (
     5495       input   p-host-code
     5496       ,input   p-obj-code
     5497       ,input   p-obj-type
     5498       ,input   true
     5499       ,input   p-shift-date
     5500       ,input   p-shift-date
     5501       ,input   p-shift-num
     5502       ,input   p-shift-num
     5503       ,input   yes
     5504       ,input   0
     5505       ,input   0
     5506       ,output  v-ost-end
     5507       ,output  Fact-order-2
     5508       ) no-error .
     5509     run wp-xmltagopen ( input 2, input "stkDen", input "" ).
     5510     run wp-xmltagput( input 3, "objType"        , input string( p-obj-type                            ), input 0 ).
     5511     run wp-xmltagput( input 3, "objCode"        , input string( p-obj-code                            ), input 0 ).
     5512     run wp-xmltagput( input 3, "shiftDate"      , input string( p-shift-date, "99.99.9999"            ), input 0 ).
     5513     run wp-xmltagput( input 3, "shiftNum"       , input string( p-shift-num                           ), input 0 ).
     5514     run wp-xmltagput( input 3, "ostBegin"       , input string( v-ost-begin                           ), input 0 ).
     5515     run wp-xmltagput( input 3, "ostEnd"         , input string( v-ost-end                             ), input 0 ).
     5516     run wp-xmltagclose( input 2, input "stkDen").
     5517   end procedure.
