     2242   ON choose OF Btn_Sel IN FRAME Dialog-Frame
     2243   do:
     2244     if not bh-wb-egais:available
     2245       then return no-apply.
     2246     case cb-1:
     2247       when 1 then do:
     2248         run bge/egais-wb.w (parparentproc, egais, bh-wb-egais:handle).
     2249         v-uniq-key-rec = bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value.
     2250       end.
     2251       when 2 then do:
     2252         run bge/egais-ticket.w (parparentproc, egais, bh-wb-egais:handle).
     2253         v-uniq-key-rec = bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value.
     2254       end.
     2255       when 3 then do:
     2256         run bge/egais-wb-act.w (parparentproc, egais, bh-wb-egais:handle).
     2257       end.
     2258       when 4 then do:
     2259         run bge/egais-ticket.w (parparentproc, egais, bh-wb-egais:handle).
     2260         v-trn-doc = bh-wb-egais:buffer-field ("trn-doc-code"):buffer-value.
     2261       end.
     2262     end case.
     2263     run proc-row-disp.
     2264     run f-query.
     2265   end.
     2266   ON CHOOSE OF btn_ticket IN FRAME Dialog-Frame
     2267   DO:
     2268     if not bh-wb-egais:available
     2269       then return no-apply.
     2270     run bge/egais-ticket.w (parparentproc, egais, bh-wb-egais).
     2271     v-uniq-key-rec = bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value.
     2272     run proc-row-disp.
     2273     run f-query.
     2274   END.
