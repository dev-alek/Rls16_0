      105   procedure thbjattr_code :
      106      define input  parameter p-upper-code     as character no-undo .
      107      define input  parameter p-code           as character no-undo .
      108      define output parameter p-label          as character no-undo .
      109      define output parameter p-user-can-edit  as logical   no-undo .
      110      define output parameter p-output-display as logical   no-undo .
      111      define output parameter p-other          as character no-undo .
      112      define output parameter p-prop-list      as character no-undo .
      113      define output parameter p-prop-type-list as character no-undo .
      114      define output parameter p-prop-label-list as character no-undo .
      115      define output parameter p-global          as logical no-undo .
      116      define output parameter p-host           as logical no-undo .
      117      define output parameter p-shop           as logical no-undo .
      118      define output parameter p-store          as logical no-undo .
      119      define output parameter p-db             as logical no-undo .
      120      define variable p-region as logical no-undo.
      121      run thbjattr_code_reg in this-procedure (
      122                                               p-upper-code,
      123                                               p-code,
      124                                               output p-label,
      125                                               output p-user-can-edit,
      126                                               output p-output-display,
      127                                               output p-other,
      128                                               output p-prop-list,
      129                                               output p-prop-type-list,
      130                                               output p-prop-label-list,
      131                                               output p-global,
      132                                               output p-host,
      133                                               output p-shop,
      134                                               output p-store,
      135                                               output p-db,
      136                                               output p-region
      137                                               ).
      138   end procedure.
      139   procedure thbjattr_code_reg :
      140   define input  parameter p-upper-code     as character no-undo .
      141   define input  parameter p-code           as character no-undo .
      142   define output parameter p-label          as character no-undo .
      143   define output parameter p-user-can-edit  as logical   no-undo .
      144   define output parameter p-output-display as logical   no-undo .
      145   define output parameter p-other          as character no-undo .
      146   define output parameter p-prop-list      as character no-undo .
      147   define output parameter p-prop-type-list as character no-undo .
      148   define output parameter p-prop-label-list as character no-undo .
      149   define output parameter p-global          as logical no-undo .
      150   define output parameter p-host           as logical no-undo .
      151   define output parameter p-shop           as logical no-undo .
      152   define output parameter p-store          as logical no-undo .
      153   define output parameter p-db             as logical no-undo .
      154   define output parameter p-region         as logical no-undo .
      155   do
      156   on error undo, return error return-value
      157   :
      158       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      159       (input  p-upper-code
      160       ,input  p-code
      161       ,output p-label
      162       ,output p-user-can-edit
      163       ,output p-output-display
      164       ,output p-other
      165       ,output p-prop-list
      166       ,output p-prop-type-list
      167       ,output p-prop-label-list
      168       ,output p-global
      169       ,output p-host
      170       ,output p-shop
      171       ,output p-store
      172       ,output p-db
      173       ,output p-region
      174       ) no-error .
      175     if error-status :error
      176     then do:
      177       undo, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1)).
      178     end.
      179   end.
      180   end procedure.
