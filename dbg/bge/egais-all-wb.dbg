     2403         ,output v-value-logical
     2404         ,output v-value-type
     2405         ,input-output TABLE thbjattr_thbj-attr
     2406         ) no-error .
     2407     assign
     2408       v-fs-rar = v-value-character
     2409     .
     2410     run adm/shattri.p (
     2411          input "get":U
     2412         ,input '':U
     2413         ,input 0
     2414         ,input 'egais':U
     2415         ,input 'egais-exsys':U
     2416         ,output v-value-character
     2417         ,output v-value-date
     2418         ,output v-value-decimal
     2419         ,output v-value-integer
     2420         ,output v-value-logical
     2421         ,output v-value-type
     2422         ,input-output TABLE thbjattr_thbj-attr
     2423         ) no-error .
     2424     assign v-ext-sys = v-value-integer .
     2425     egais = new EGAIS(v-db-num, v-user-id).
     2426     egais:EGAISImpl = new WayBill (v-cntxt-obj-type, v-cntxt-obj-code, v-fs-rar, v-ext-sys).
     2427     egaisWBAdv = cast (egais:EGAISImpl, ibs.th.bge.egais.WayBill).
     2428     egaisWBAdv:ActnEGAISAdm = actnEGAISAdm.
     2429     egaisWBAdv:ActnEGAISSts = actnEGAISSts.
     2430     create query qh-wb-egais.
     2431     create browse browse-hdl-wb-egais
     2432       assign
     2433         title     = 'Накладные ЕГАИС'
     2434         frame     = frame Dialog-Frame:handle
     2435         query     = qh-wb-egais
     2436         x         = 10
     2437         y         = 70
     2438         width     = 119
     2439         height    = 24
     2440         visible   = true
     2441         read-only = true
     2442         sensitive = true
     2443         separators = true
     2444         column-resizable = true
     2445         column-scrolling = true
     2446         triggers:
     2447           on mouse-move-dblclick persistent run msdblcl.
     2448           on row-display persistent run proc-row-disp.
     2449         end triggers
     2450     .
     2451     bh-wb-egais = egais:GetHndlTable(3, "").
     2452     qh-wb-egais:set-buffers (bh-wb-egais).
     2453     qh-wb-egais:query-prepare ("for each tt-wb-hndls by tt-wb-hndls.wb-date descending").
     2454     qh-wb-egais:query-open.
     2455     if not bh-wb-egais = ?
     2456     then do:
     2457       extent (bcol) = bh-wb-egais:num-fields.
     2458       do ii = 1 to bh-wb-egais:num-fields:
     2459         bcol[ii] = browse-hdl-wb-egais:add-like-column('tt-wb-hndls' + '.' + bh-wb-egais:buffer-field (ii):name, 0, 'FILL-IN').
     2460         if entry (ii, egaisWBAdv:SettingsTTList, ';') <> ""
     2461         then do:
     2462           v-windth = integer (entry (1, entry (ii, egaisWBAdv:SettingsTTList, ';'))).
     2463           v-isDisp = entry (2, entry (ii, egaisWBAdv:SettingsTTList, ';')).
     2464           assign
     2465             bcol[ii]:width = v-windth when v-windth > 0
     2466             bcol[ii]:visible = false when v-isDisp = "no"
     2467           .
     2468         end.
     2469       end.
     2470     end.
     2471     f-date = date (now) - 31.
     2472     f-date-2 = ?.
     2473     run f-query.
