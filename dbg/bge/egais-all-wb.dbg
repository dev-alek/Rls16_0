     3935     end.
     3936     if f-date-2 <> ? or f-date <> ? or f-cli-name <> "" or f-type <> ""
     3937       then run f-query.
     3938   end.
     3939   PROCEDURE rejectWB :
     3940     def var v-doc-code as character no-undo.
     3941     def var ticketRasObj as class WayBill no-undo.
     3942     def var bh-TicketHndl as handle no-undo.
     3943     def var qh-TicketHndl as handle no-undo.
     3944   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3945   do:
     3946     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3947       (input  v-cntxt-db-num
     3948       ,input  v-cntxt-userid
     3949       ,input  0
     3950       ,input  'actn_egais-reject':U
     3951       ,input  'object':U
     3952       ,input  v-cntxt-host-code-obj
     3953       ,input  v-cntxt-obj-type
     3954       ,input  v-cntxt-obj-code
     3955       ,input  0
     3956       ,input  0
     3957       ,input  0
     3958       ,input  true
     3959       ,output glog
     3960       )  .
     3961   end.
     3962     if not glog then  return .
     3963     if not bh-wb-egais:available
     3964       then return no-apply.
     3965     case cb-1:
     3966     when 1
     3967     then do:
     3968       bh-wb-gds-EG-header = egais:GetHndlTable(1, bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value).
     3969       if egais:StatusErr
     3970       then do:
     3971         message egais:Msg view-as alert-box error.
     3972         return no-apply.
     3973       end.
     3974       if can-find (first ub.trn-doc where ub.trn-doc.doc-code = bh-wb-egais:buffer-field ("trn-doc-code"):buffer-value)
     3975       then do:
     3976         message substitute ( "Накладная с № &1 уже сформирована, все равно отправить отказ", bh-wb-egais:buffer-field ("trn-doc-code"):buffer-value)
     3977         view-as alert-box question buttons yes-no update isChoise as logical.
     3978         if not isChoise
     3979           then return no-apply.
     3980       end.
     3981       else do:
     3982         message "Отправить отказ?" view-as alert-box question buttons yes-no update isChoise.
     3983         if not isChoise
     3984           then return no-apply.
     3985       end.
     3986       egais:RejectWB(bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value).
     3987       if egais:StatusErr
     3988       then do:
     3989         message egais:Msg view-as alert-box error.
     3990         return no-apply.
     3991       end.
     3992       else run f-query.
     3993     end.
     3994     when 4
     3995     then do:
     3996       ticketRasObj = new WayBill (v-cntxt-obj-type, v-cntxt-obj-code, v-fs-rar, v-ext-sys).
     3997       bh-wb-gds-EG = ?.
     3998       bh-wb-gds-EG-header = ?.
     3999       v-doc-code = bh-wb-egais:buffer-field ("trn-doc-code"):buffer-value.
     4000       bh-TicketHndl = ticketRasObj:GetHndlTable(13, bh-wb-egais:buffer-field ("trn-doc-code"):buffer-value).
     4001       create query qh-TicketHndl.
     4002       qh-TicketHndl:set-buffers (bh-TicketHndl).
     4003       qh-TicketHndl:query-close ().
     4004       qh-TicketHndl:query-prepare ("for each tt-ticket where tt-ticket.regid <> '' and tt-ticket.doc = 'WayBill' by tt-ticket.regid descending").
     4005       qh-TicketHndl:query-open ().
     4006       if not qh-TicketHndl:is-open or not qh-TicketHndl:get-first ()
     4007       then do:
     4008         message "Не найдена накладная ЕГАИС, на которую можно послать отказ.".
     4009         delete object ticketRasObj.
     4010         return.
     4011       end.
     4012       bh-wb-gds-EG-header = egais:GetHndlTable(10, bh-wb-egais:buffer-field ("trn-doc-code"):buffer-value).
     4013       v-uniq-key-rec = bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value.
     4014       egaisWBAdv:SendWBActRejUTM(bh-TicketHndl:buffer-field ("regid"):buffer-value).
     4015       message "Отправлен отказ на накладную ЕГАИС - " + bh-TicketHndl:buffer-field ("regid"):buffer-value view-as alert-box information title "Информация".
     4016       delete object ticketRasObj.
     4017     end.
     4018     end case.
     4019   end procedure.
     4020   PROCEDURE ReqRepealWB :
     4021     def var v-doc-code as character no-undo.
     4022     def var ticketRasObj as class WayBill no-undo.
     4023     def var bh-TicketHndl as handle no-undo.
     4024     def var qh-TicketHndl as handle no-undo.
     4025   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4026   do:
     4027     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4028       (input  v-cntxt-db-num
     4029       ,input  v-cntxt-userid
     4030       ,input  0
     4031       ,input  'actn_egais-reject':U
     4032       ,input  'object':U
     4033       ,input  v-cntxt-host-code-obj
     4034       ,input  v-cntxt-obj-type
     4035       ,input  v-cntxt-obj-code
     4036       ,input  0
     4037       ,input  0
     4038       ,input  0
     4039       ,input  true
     4040       ,output glog
     4041       )  .
     4042   end.
     4043     if not glog then  return .
     4044     if not bh-wb-egais:available
     4045       then return no-apply.
     4046     case cb-1:
     4047     when 1
     4048     then do:
     4049       bh-wb-gds-EG-header = egais:GetHndlTable(1, bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value).
     4050       if egais:StatusErr
     4051       then do:
     4052         message egais:Msg view-as alert-box error.
     4053         return no-apply.
     4054       end.
     4055       if can-find (first ub.trn-doc where ub.trn-doc.doc-code = bh-wb-egais:buffer-field ("trn-doc-code"):buffer-value)
     4056       then do:
     4057         message substitute ( "Накладная с № &1 уже сформирована, все равно отправить запрос на отмену проведения накладной.", bh-wb-egais:buffer-field ("trn-doc-code"):buffer-value)
     4058         view-as alert-box question buttons yes-no update isChoise as logical.
     4059         if not isChoise
     4060           then return no-apply.
     4061       end.
     4062       else do:
     4063         message "Отправить запрос на отмену проведения накладной?" view-as alert-box question buttons yes-no update isChoise.
     4064         if not isChoise
     4065           then return no-apply.
     4066       end.
     4067       egaisWBAdv:SendReqRepealWBUTM(bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value).
     4068       if egaisWBAdv:StatusErr
     4069       then do:
     4070         message egaisWBAdv:Msg view-as alert-box error.
     4071         return no-apply.
     4072       end.
     4073       else run f-query.
     4074     end.
     4075     end case.
     4076   end procedure.
     4077   procedure proc-hide-disp:
     4078     if (cb-1:screen-value in frame Dialog-Frame = "2" or cb-1:screen-value  in frame Dialog-Frame = "1") and actnEGAISAdm
     4079       then Btn_accept:hidden in frame Dialog-Frame = false.
     4080       else Btn_accept:hidden in frame Dialog-Frame = true.
     4081     case cb-1:
     4082     when 1
     4083     then do:
     4084       enable Btn_Save with frame Dialog-Frame.
     4085       Btn_Save:label = "Сохранить".
     4086       Btn_Del:hidden = false.
     4087       Btn_conn:label = "Связать".
     4088       Btn_conn:tooltip = 'Связать накладную ЕГАИС с накладной TH'.
     4089       Btn_conn:hidden = false.
     4090       btn_ticket:hidden = false.
     4091       Btn_delclob:hidden = false.
     4092       Btn_Del:popup-menu in frame Dialog-Frame = menu popup-menu-reject:handle.
     4093       Btn_Del:menu-mouse = 1.
     4094     end.
     4095     when 2 then do:
     4096       enable Btn_Save with frame Dialog-Frame.
     4097       Btn_Save:label = "Отправить".
     4098       Btn_Del:hidden = true.
     4099       Btn_conn:label = "Акт торг.".
     4100       Btn_conn:tooltip = 'Передача продукции в торговый зал ЕГАИС'.
     4101       Btn_conn:hidden = false.
     4102       btn_ticket:hidden = true.
     4103       Btn_delclob:hidden = true.
     4104     end.
     4105     when 3
     4106     then do:
     4107       disable Btn_Save with frame Dialog-Frame.
     4108       Btn_Save:label = "Отправить".
     4109       Btn_Del:hidden = true.
     4110       Btn_conn:hidden = true.
     4111       btn_ticket:hidden = true.
     4112       Btn_delclob:hidden = true.
     4113     end.
     4114     when 4
     4115     then do:
     4116       enable Btn_Save with frame Dialog-Frame.
     4117       Btn_Save:label = "Отправить".
     4118       Btn_Del:hidden = false.
     4119       Btn_conn:hidden = true.
     4120       btn_ticket:hidden = true.
     4121       Btn_delclob:hidden = true.
     4122       Btn_Del:popup-menu in frame Dialog-Frame = ?.
     4123       Btn_Del:menu-mouse = ?.
     4124     end.
     4125     end case.
     4126   end.
     4127   ON leave OF f-cli-code IN FRAME Dialog-Frame
     4128   do:
     4129     run f-query.
     4130   end.
