     2488   define temp-table temp-diasize-handle no-undo
     2489     field handle-value  as handle
     2490     field save-position as decimal
     2491     index xpk is primary unique handle-value
     2492     .
     2493   define temp-table temp-browse-handle no-undo
     2494     field browse-type   as character
     2495     field browse-number as integer
     2496     field browse-handle as handle
     2497     field original-size as decimal
     2498     index xpk is primary unique browse-type browse-number
     2499     index xie browse-type browse-handle
     2500   .
     2501   procedure diasize_change-height :
     2502     define input  parameter p-change-value  as decimal   no-undo .
     2503     define input  parameter p-move-resize   as logical   no-undo .
     2504     define variable v-field-group-handle    as handle    no-undo .
     2505     define variable v-object-handle         as handle    no-undo .
     2506     define variable v-frame-height          as decimal   no-undo .
     2507     define variable v-frame-virtual-height  as decimal   no-undo .
     2508     define variable v-browse-height         as decimal   no-undo .
     2509     define variable v-window-height         as decimal   no-undo .
     2510     define variable v-window-virtual-height as decimal   no-undo .
     2511     define variable v-change-sign           as integer   no-undo .
     2512     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2513     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2514     if p-change-value > 0
     2515     then do:
     2516       if frame Dialog-Frame :height + p-change-value
     2517           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2518       then do:
     2519         assign
     2520           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2521                           - (frame Dialog-Frame :height-chars)
     2522         .
     2523         if p-change-value <= 0
     2524         then do:
     2525           run diasize_position-resize-button in this-procedure .
     2526           return .
     2527         end.
     2528       end.
     2529     end.
     2530     if p-change-value < 0
     2531     then do:
     2532       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2533       then do:
     2534         assign
     2535           p-change-value = v-diasize-orig-frame-height
     2536                          - (frame Dialog-Frame :height-chars)
     2537         .
     2538         if p-change-value >= 0
     2539         then do:
     2540           run diasize_position-resize-button in this-procedure .
     2541           return .
     2542         end.
     2543       end.
     2544     end.
     2545     if p-change-value >= 0
     2546     then do:
     2547       assign
     2548         v-change-sign = 1
     2549       .
     2550     end.
     2551     else do:
     2552       assign
     2553         v-change-sign = -1
     2554       .
     2555     end.
     2556     assign
     2557       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2558     .
     2559     if p-change-value = 0
     2560     then do:
     2561       run diasize_position-resize-button in this-procedure .
     2562       return .
     2563     end.
     2564     move_block:
     2565     do
     2566     on error undo move_block, retry move_block
     2567     :
     2568       if retry
     2569       then do:
     2570         do
     2571         on error undo move_block, leave move_block
     2572         :
     2573           if p-change-value > 0
     2574           then do:
     2575             for each buf_temp-diasize-handle
     2576             on error undo, next
     2577             :
     2578               assign
     2579                 v-object-handle = buf_temp-diasize-handle.handle-value
     2580               .
     2581               if v-object-handle <> v-diasize-resize-button
     2582               then do:
     2583                 assign
     2584                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2585                 .
     2586               end.
     2587             end.
     2588             assign
     2589               v-diasize-browse-handle :height = v-browse-height
     2590             .
     2591             for each buf_temp-browse-handle
     2592               where buf_temp-browse-handle.browse-type = 'height':u
     2593             on error undo, next
     2594             :
     2595               assign
     2596                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2597               .
     2598             end.
     2599             assign
     2600               frame Dialog-Frame :height = v-frame-height
     2601             .
     2602             if frame Dialog-Frame :scrollable = true
     2603             then do:
     2604               assign
     2605                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2606               .
     2607             end.
     2608             run diasize_position-resize-button in this-procedure .
     2609           end.
     2610           else do:
     2611             if frame Dialog-Frame :scrollable = true
     2612             then do:
     2613               assign
     2614                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2615               .
     2616             end.
     2617             assign
     2618               frame Dialog-Frame :height = v-frame-height
     2619             .
     2620             assign
     2621               v-diasize-browse-handle :height = v-browse-height
     2622             .
     2623             for each buf_temp-browse-handle
     2624               where buf_temp-browse-handle.browse-type = 'height':u
     2625             on error undo, next
     2626             :
     2627               assign
     2628                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2629               .
     2630             end.
     2631             for each buf_temp-diasize-handle
     2632             on error undo, next
     2633             :
     2634               assign
     2635                 v-object-handle = buf_temp-diasize-handle.handle-value
     2636               .
     2637               if v-object-handle <> v-diasize-resize-button
     2638               then do:
     2639                 assign
     2640                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2641                 .
     2642               end.
     2643             end.
     2644             run diasize_position-resize-button in this-procedure .
     2645           end.
     2646           assign
     2647             v-diasize-change-size = false
     2648           .
     2649           leave move_block .
     2650         end.
     2651       end.
     2652       assign
     2653         v-diasize-need-full-display = true
     2654       .
     2655       if v-diasize-change-size = false
     2656       then do:
     2657         assign
     2658           v-diasize-change-size = true
     2659         .
     2660       end.
     2661       else do:
     2662         return .
     2663       end.
     2664       assign
     2665         v-frame-height = frame Dialog-Frame :height
     2666         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2667         v-browse-height = v-diasize-browse-handle :height
     2668       .
     2669       for each buf_temp-browse-handle
     2670         where buf_temp-browse-handle.browse-type = 'height':u
     2671       :
     2672         assign
     2673           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2674         .
     2675       end.
     2676       for each buf_temp-diasize-handle
     2677       :
     2678         delete buf_temp-diasize-handle .
     2679       end.
     2680       assign
     2681         v-field-group-handle = frame Dialog-Frame :first-child
     2682       .
     2683       do while valid-handle(v-field-group-handle)
     2684       :
     2685         assign
     2686           v-object-handle = v-field-group-handle :first-child
     2687         .
     2688         do while valid-handle(v-object-handle)
     2689         :
     2690           if  v-object-handle <> v-diasize-browse-handle :handle
     2691           and can-query(v-object-handle, "row")
     2692           and can-query(v-object-handle, "height")
     2693           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2694           then do:
     2695             find first buf_temp-browse-handle
     2696               where buf_temp-browse-handle.browse-type   = 'height':u
     2697                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2698               no-error .
     2699             if available buf_temp-browse-handle
     2700             then do:
     2701             end.
     2702             else do:
     2703               create buf_temp-diasize-handle .
     2704               assign
     2705                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2706                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2707               .
     2708             end.
     2709           end.
     2710           assign
     2711             v-object-handle = v-object-handle :next-sibling
     2712           .
     2713         end.
     2714         assign
     2715           v-field-group-handle = v-field-group-handle :next-sibling
     2716         .
     2717       end.
     2718       do with frame Dialog-Frame
     2719       :
     2720         hide v-diasize-resize-button .
     2721         assign
     2722           v-diasize-resize-button :row    = 1
     2723           v-diasize-resize-button :column = 1
     2724         .
     2725       end.
     2726       if p-change-value > 0
     2727       then do:
     2728         if frame Dialog-Frame :scrollable = true
     2729         then do:
     2730           assign
     2731             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2732             no-error .
     2733           if error-status :error
     2734           or error-status :get-message(1) <> ""
     2735           then do:
     2736             undo move_block, retry move_block .
     2737           end.
     2738         end.
     2739         assign
     2740           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2741           no-error .
     2742         if error-status :error
     2743         or error-status :get-message(1) <> ""
     2744         then do:
     2745           undo move_block, retry move_block .
     2746         end.
     2747         assign
     2748           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2749           no-error .
     2750         if error-status :error
     2751         or error-status :get-message(1) <> ""
     2752         then do:
     2753           undo move_block, retry move_block .
     2754         end.
     2755         for each buf_temp-browse-handle
     2756           where buf_temp-browse-handle.browse-type = 'height':u
     2757         on error undo move_block, retry move_block
     2758         :
     2759           assign
     2760             buf_temp-browse-handle.browse-handle :height
     2761               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2762             no-error .
     2763           if error-status :error
     2764           or error-status :get-message(1) <> ""
     2765           then do:
     2766             undo move_block, retry move_block .
     2767           end.
     2768         end.
     2769         for each buf_temp-diasize-handle
     2770         on error undo move_block, retry move_block
     2771         :
     2772           assign
     2773             v-object-handle = buf_temp-diasize-handle.handle-value
     2774           .
     2775           if v-object-handle <> v-diasize-resize-button
     2776           then do:
     2777             assign
     2778               v-object-handle :row = v-object-handle :row + p-change-value
     2779               no-error .
     2780             if error-status :error
     2781             or error-status :get-message(1) <> ""
     2782             then do:
     2783               undo move_block, retry move_block .
     2784             end.
     2785           end.
     2786         end.
     2787       end.
     2788       else do:
     2789         for each buf_temp-diasize-handle
     2790         on error undo move_block, retry move_block
     2791         :
     2792           assign
     2793             v-object-handle = buf_temp-diasize-handle.handle-value
     2794           .
     2795           if v-object-handle <> v-diasize-resize-button
     2796           then do:
     2797             assign
     2798               v-object-handle :row = v-object-handle :row + p-change-value
     2799               no-error .
     2800             if error-status :error
     2801             or error-status :get-message(1) <> ""
     2802             then do:
     2803               undo move_block, retry move_block .
     2804             end.
     2805           end.
     2806         end.
     2807         assign
     2808           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2809           no-error .
     2810         if error-status :error
     2811         or error-status :get-message(1) <> ""
     2812         then do:
     2813           undo move_block, retry move_block .
     2814         end.
     2815         for each buf_temp-browse-handle
     2816           where buf_temp-browse-handle.browse-type = 'height':u
     2817         on error undo move_block, retry move_block
     2818         :
     2819           assign
     2820             buf_temp-browse-handle.browse-handle :height
     2821               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2822             no-error .
     2823           if error-status :error
     2824           or error-status :get-message(1) <> ""
     2825           then do:
     2826             undo move_block, retry move_block .
     2827           end.
     2828         end.
     2829         assign
     2830           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2831           no-error .
     2832         if error-status :error
     2833         or error-status :get-message(1) <> ""
     2834         then do:
     2835           undo move_block, retry move_block .
     2836         end.
     2837         if frame Dialog-Frame :scrollable = true
     2838         then do:
     2839           assign
     2840             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2841             no-error .
     2842           if error-status :error
     2843           or error-status :get-message(1) <> ""
     2844           then do:
     2845             undo move_block, retry move_block .
     2846           end.
     2847         end.
     2848       end.
     2849       if p-move-resize = true
     2850       then do:
     2851         run diasize_position-resize-button in this-procedure .
     2852       end.
     2853       if v-diasize-wndstore = true
     2854       then do:
     2855         if connected("ub") = true
     2856         then do:
     2857           define variable v-cntxt-db-num        as integer   no-undo .
     2858           define variable v-cntxt-userid        as character no-undo .
     2859           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2860                                             , OUTPUT v-cntxt-userid
     2861                                             ) .
     2862           run gbl/wndsizew.p
     2863             (input  v-cntxt-db-num
     2864             ,input  v-cntxt-userid
     2865             ,input  v-diasize-proc-name
     2866             ,input  'height':u
     2867             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2868             ) .
     2869         end.
     2870       end.
     2871     end.
     2872     assign
     2873       v-diasize-change-size = false
     2874     .
     2875   end procedure.
     2876   procedure diasize_set-height :
     2877     define input  parameter p-new-height  as decimal   no-undo .
     2878     define input  parameter p-move-resize as logical   no-undo .
     2879     do
     2880     on error undo, return error return-value
     2881     :
     2882       run diasize_change-height in this-procedure
     2883         (input  (p-new-height - frame Dialog-Frame :height)
     2884         ,input  p-move-resize
     2885         ) .
     2886     end.
     2887   end procedure.
     2888   procedure diasize_change-width :
     2889     define input  parameter p-change-value as decimal   no-undo .
     2890     define input  parameter p-move-resize  as logical   no-undo .
     2891     define variable v-field-group-handle   as handle    no-undo .
     2892     define variable v-object-handle        as handle    no-undo .
     2893     define variable v-frame-width          as decimal   no-undo .
     2894     define variable v-frame-virtual-width  as decimal   no-undo .
     2895     define variable v-browse-width         as decimal   no-undo .
     2896     define variable v-window-width         as decimal   no-undo .
     2897     define variable v-window-virtual-width as decimal   no-undo .
     2898     define variable v-change-sign          as integer   no-undo .
     2899     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2900     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2901     if p-change-value > 0
     2902     then do:
     2903       if frame Dialog-Frame :width + p-change-value >
     2904           session :width-chars
     2905       then do:
     2906         assign
     2907           p-change-value = session :width-chars - frame Dialog-Frame :width
     2908         .
     2909         if p-change-value <= 0
     2910         then do:
     2911           run diasize_position-resize-button in this-procedure .
     2912           return .
     2913         end.
     2914       end.
     2915     end.
     2916     if p-change-value < 0
     2917     then do:
     2918       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2919       then do:
     2920         assign
     2921           p-change-value = v-diasize-orig-frame-width
     2922                          - frame Dialog-Frame :width
     2923         .
     2924         if p-change-value >= 0
     2925         then do:
     2926           run diasize_position-resize-button in this-procedure .
     2927           return .
     2928         end.
     2929       end.
     2930     end.
     2931     if p-change-value >= 0
     2932     then do:
     2933       assign
     2934         v-change-sign = 1
     2935       .
     2936     end.
     2937     else do:
     2938       assign
     2939         v-change-sign = -1
     2940       .
     2941     end.
     2942     assign
     2943       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2944     .
     2945     if p-change-value = 0
     2946     then do:
     2947       run diasize_position-resize-button in this-procedure .
     2948       return .
     2949     end.
     2950     move_block:
     2951     do
     2952     on error undo move_block, leave move_block
     2953     :
     2954       if retry
     2955       then do:
     2956         do
     2957         on error undo move_block, leave move_block
     2958         :
     2959           if p-change-value > 0
     2960           then do:
     2961             for each buf_temp-diasize-handle
     2962             on error undo, next
     2963             :
     2964               assign
     2965                 v-object-handle = buf_temp-diasize-handle.handle-value
     2966               .
     2967               if v-object-handle <> v-diasize-resize-button
     2968               then do:
     2969                 assign
     2970                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2971                 .
     2972               end.
     2973             end.
     2974             assign
     2975               v-diasize-browse-handle :width = v-browse-width
     2976             .
     2977             for each buf_temp-browse-handle
     2978               where buf_temp-browse-handle.browse-type = 'width':u
     2979             on error undo, next
     2980             :
     2981               assign
     2982                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2983               .
     2984             end.
     2985             assign
     2986               frame Dialog-Frame :width = v-frame-width
     2987             .
     2988             if frame Dialog-Frame :scrollable = true
     2989             then do:
     2990               assign
     2991                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2992               .
     2993             end.
     2994             run diasize_position-resize-button in this-procedure .
     2995           end.
     2996           else do:
     2997             if frame Dialog-Frame :scrollable = true
     2998             then do:
     2999               assign
     3000                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3001               .
     3002             end.
     3003             assign
     3004               frame Dialog-Frame :width = v-frame-width
     3005             .
     3006             for each buf_temp-browse-handle
     3007               where buf_temp-browse-handle.browse-type = 'width':u
     3008             on error undo, next
     3009             :
     3010               assign
     3011                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3012               .
     3013             end.
     3014             assign
     3015               v-diasize-browse-handle :width = v-browse-width
     3016             .
     3017             for each buf_temp-diasize-handle
     3018             on error undo, next
     3019             :
     3020               assign
     3021                 v-object-handle = buf_temp-diasize-handle.handle-value
     3022               .
     3023               if v-object-handle <> v-diasize-resize-button
     3024               then do:
     3025                 assign
     3026                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3027                 .
     3028               end.
     3029             end.
     3030             run diasize_position-resize-button in this-procedure .
     3031           end.
     3032           assign
     3033             v-diasize-change-size = false
     3034           .
     3035           leave move_block .
     3036         end.
     3037       end.
     3038       assign
     3039         v-diasize-need-full-display = true
     3040       .
     3041       if v-diasize-change-size = false
     3042       then do:
     3043         assign
     3044           v-diasize-change-size = true
     3045         .
     3046       end.
     3047       else do:
     3048         return .
     3049       end.
     3050       assign
     3051         v-frame-width = frame Dialog-Frame :width
     3052         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3053         v-browse-width = v-diasize-browse-handle :width
     3054       .
     3055       for each buf_temp-browse-handle
     3056         where buf_temp-browse-handle.browse-type = 'width':u
     3057       :
     3058         assign
     3059           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3060         .
     3061       end.
     3062       for each buf_temp-diasize-handle
     3063       :
     3064         delete buf_temp-diasize-handle .
     3065       end.
     3066       assign
     3067         v-field-group-handle = frame Dialog-Frame :first-child
     3068       .
     3069       do while valid-handle(v-field-group-handle)
     3070       :
     3071         assign
     3072           v-object-handle = v-field-group-handle :first-child
     3073         .
     3074         do while valid-handle(v-object-handle)
     3075         :
     3076           if  v-object-handle <> v-diasize-browse-handle :handle
     3077           and v-object-handle <> v-diasize-resize-button
     3078           and can-query(v-object-handle, "row")
     3079           and can-query(v-object-handle, "height")
     3080           and ( v-object-handle :col + v-object-handle :width
     3081                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3082               )
     3083           then do:
     3084             find first buf_temp-browse-handle
     3085               where buf_temp-browse-handle.browse-type   = 'width':u
     3086                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3087               no-error .
     3088             if available buf_temp-browse-handle
     3089             then do:
     3090             end.
     3091             else do:
     3092               create buf_temp-diasize-handle .
     3093               assign
     3094                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3095                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3096               .
     3097             end.
     3098           end.
     3099           assign
     3100             v-object-handle = v-object-handle :next-sibling
     3101           .
     3102         end.
     3103         assign
     3104           v-field-group-handle = v-field-group-handle :next-sibling
     3105         .
     3106       end.
     3107       do with frame Dialog-Frame
     3108       :
     3109         hide v-diasize-resize-button .
     3110         v-diasize-resize-button :row = 1.
     3111         v-diasize-resize-button :column = 1.
     3112       end.
     3113       if p-change-value > 0
     3114       then do:
     3115         if frame Dialog-Frame :scrollable = true
     3116         then do:
     3117           assign
     3118             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3119             no-error .
     3120           if error-status :error
     3121           or error-status :get-message(1) <> ""
     3122           then do:
     3123             undo move_block, retry move_block.
     3124           end.
     3125         end.
     3126         assign
     3127           frame Dialog-Frame :width = v-frame-width + p-change-value
     3128           no-error .
     3129         if error-status :error
     3130         or error-status :get-message(1) <> ""
     3131         then do:
     3132           undo move_block, retry move_block.
     3133         end.
     3134         assign
     3135           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3136         no-error .
     3137         if error-status :error
     3138         or error-status :get-message(1) <> ""
     3139         then do:
     3140           undo move_block, retry move_block.
     3141         end.
     3142         for each buf_temp-browse-handle
     3143           where buf_temp-browse-handle.browse-type = 'width':u
     3144         on error undo move_block, retry move_block
     3145         :
     3146           assign
     3147             buf_temp-browse-handle.browse-handle :width
     3148               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3149             no-error .
     3150           if error-status :error
     3151           or error-status :get-message(1) <> ""
     3152           then do:
     3153             undo move_block, retry move_block .
     3154           end.
     3155         end.
     3156         for each buf_temp-diasize-handle
     3157         on error undo move_block, retry move_block
     3158         :
     3159           assign
     3160             v-object-handle = buf_temp-diasize-handle.handle-value
     3161           .
     3162           if v-object-handle <> v-diasize-resize-button
     3163           then do:
     3164             assign
     3165               v-object-handle :col = v-object-handle :col + p-change-value
     3166               no-error .
     3167             if error-status :error
     3168             or error-status :get-message(1) <> ""
     3169             then do:
     3170               undo move_block, retry move_block .
     3171             end.
     3172           end.
     3173         end.
     3174       end.
     3175       else do:
     3176         for each buf_temp-diasize-handle
     3177         on error undo move_block, retry move_block
     3178         :
     3179           assign
     3180             v-object-handle = buf_temp-diasize-handle.handle-value
     3181           .
     3182           if v-object-handle <> v-diasize-resize-button
     3183           then do:
     3184             assign
     3185               v-object-handle :col = v-object-handle :col + p-change-value
     3186               no-error .
     3187             if error-status :error
     3188             or error-status :get-message(1) <> ""
     3189             then do:
     3190               undo move_block, retry move_block .
     3191             end.
     3192           end.
     3193         end.
     3194         for each buf_temp-browse-handle
     3195           where buf_temp-browse-handle.browse-type = 'width':u
     3196         on error undo move_block, retry move_block
     3197         :
     3198           assign
     3199             buf_temp-browse-handle.browse-handle :width
     3200               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3201             no-error .
     3202           if error-status :error
     3203           or error-status :get-message(1) <> ""
     3204           then do:
     3205             undo move_block, retry move_block .
     3206           end.
     3207         end.
     3208         assign
     3209           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3210           no-error .
     3211         if error-status :error
     3212         or error-status :get-message(1) <> ""
     3213         then do:
     3214           undo move_block, retry move_block.
     3215         end.
     3216         assign
     3217           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3218         no-error .
     3219         if error-status :error
     3220         or error-status :get-message(1) <> ""
     3221         then do:
     3222           undo move_block, retry move_block.
     3223         end.
     3224         if frame Dialog-Frame :scrollable = true
     3225         then do:
     3226           assign
     3227             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3228           no-error .
     3229           if error-status :error
     3230           or error-status :get-message(1) <> ""
     3231           then do:
     3232             undo move_block, retry move_block.
     3233           end.
     3234         end.
     3235       end.
     3236       if p-move-resize
     3237       then do:
     3238         run diasize_position-resize-button in this-procedure .
     3239       end.
     3240       if v-diasize-wndstore = true
     3241       then do:
     3242         if connected("ub") = true
     3243         then do:
     3244           define variable v-cntxt-db-num        as integer   no-undo .
     3245           define variable v-cntxt-userid        as character no-undo .
     3246           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3247                                             , OUTPUT v-cntxt-userid
     3248                                             ) .
     3249           run gbl/wndsizew.p
     3250             (input  v-cntxt-db-num
     3251             ,input  v-cntxt-userid
     3252             ,input  v-diasize-proc-name
     3253             ,input  'width':u
     3254             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3255             ) .
     3256         end.
     3257       end.
     3258     end.
     3259     assign
     3260       v-diasize-change-size = false
     3261     .
     3262   end procedure.
     3263   procedure diasize_set-width :
     3264     define input  parameter p-new-width  as decimal   no-undo .
     3265     define input  parameter p-move-resize as logical   no-undo .
     3266     do
     3267     on error undo, return error return-value
     3268     :
     3269       run diasize_change-width in this-procedure
     3270         (input  (p-new-width - frame Dialog-Frame :width)
     3271         ,input  p-move-resize
     3272         ) .
     3273     end.
     3274   end procedure.
     3275   procedure diasize_position-resize-button :
     3276     do with frame Dialog-Frame
     3277     :
     3278       hide v-diasize-resize-button .
     3279       assign
     3280         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3281                     - 1
     3282                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3283         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3284                     - 1
     3285                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3286       .
     3287       view v-diasize-resize-button .
     3288     end.
     3289   end procedure.
     3290   on alt-right anywhere
     3291   do:
     3292     run diasize_change-width in this-procedure
     3293       (input 1
     3294       ,input true
     3295       ) .
     3296     return no-apply .
     3297   end.
     3298   on alt-left anywhere
     3299   do:
     3300     run diasize_change-width in this-procedure
     3301       (input -1
     3302       ,input true
     3303       ) .
     3304     return no-apply .
     3305   end.
     3306   on alt-down anywhere
     3307   do:
     3308     run diasize_change-height in this-procedure
     3309       (input 1
     3310       ,input true
     3311       ) .
     3312     return no-apply .
     3313   end.
     3314   on alt-up anywhere
     3315   do:
     3316     run diasize_change-height in this-procedure
     3317       (input -1
     3318       ,input true
     3319       ) .
     3320     return no-apply .
     3321   end.
     3322   on alt-enter of frame Dialog-Frame
     3323   do:
     3324     run diasize_maximize in this-procedure
     3325       (input  ?
     3326       ).
     3327     return no-apply .
     3328   end.
     3329   procedure diasize_end-move :
     3330     do
     3331     on error undo, return error return-value
     3332     :
     3333       define variable v-row-delta as decimal   no-undo .
     3334       define variable v-col-delta as decimal   no-undo .
     3335       define variable v-new-row as decimal   no-undo .
     3336       define variable v-new-col as decimal   no-undo .
     3337       assign
     3338         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3339         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3340       .
     3341       assign
     3342         v-row-delta = v-new-row - frame Dialog-Frame :height
     3343         v-col-delta = v-new-col - frame Dialog-Frame :width
     3344       .
     3345       run diasize_change-height in this-procedure
     3346         (input v-row-delta
     3347         ,input true
     3348         ) .
     3349       run diasize_change-width in this-procedure
     3350         (input v-col-delta
     3351         ,input true
     3352         ) .
     3353     end.
     3354   end procedure.
     3355   procedure diasize_maximize :
     3356     define input  parameter p-action as logical   no-undo .
     3357     do
     3358     on error undo, return error return-value
     3359     :
     3360       if p-action = ?
     3361       then do:
     3362         if v-diasize-need-maximize = true
     3363         then do:
     3364           assign
     3365             p-action = true
     3366           .
     3367         end.
     3368         else do:
     3369           assign
     3370             p-action = false
     3371           .
     3372         end.
     3373       end.
     3374       if p-action = true
     3375       then do:
     3376         run diasize_change-height in this-procedure
     3377           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3378               - frame Dialog-Frame :height-chars
     3379           ,input true
     3380           ) .
     3381         run diasize_change-width in this-procedure
     3382           (input session :width-chars
     3383               - frame Dialog-Frame :width-chars
     3384           ,input true
     3385           ) .
     3386         assign
     3387           v-diasize-need-maximize = false
     3388         .
     3389       end.
     3390       else do:
     3391         run diasize_change-width in this-procedure
     3392           (input v-diasize-orig-frame-width
     3393               - frame Dialog-Frame :width-chars
     3394           ,input true
     3395           ) .
     3396         run diasize_change-height in this-procedure
     3397           (input v-diasize-orig-frame-height
     3398               - frame Dialog-Frame :height-chars
     3399           ,input true
     3400           ) .
     3401         assign
     3402           v-diasize-need-maximize = true
     3403         .
     3404       end.
     3405     end.
     3406   end procedure.
     3407   procedure diasize_restore-orig-size :
     3408     do
     3409     on error undo, return error return-value
     3410     :
     3411       assign
     3412         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3413         v-diasize-current-frame-height = frame Dialog-Frame :height
     3414       .
     3415       run diasize_set-height in this-procedure
     3416         (input  v-diasize-orig-frame-height
     3417         ,input  true
     3418         ) .
     3419       run diasize_set-width in this-procedure
     3420         (input  v-diasize-orig-frame-width
     3421         ,input  true
     3422         ) .
     3423     end.
     3424   end procedure.
     3425   procedure diasize_restore-current-size :
     3426     do
     3427     on error undo, return error return-value
     3428     :
     3429       run diasize_set-height in this-procedure
     3430         (input  v-diasize-current-frame-height
     3431         ,input  true
     3432         ) .
     3433       run diasize_set-width in this-procedure
     3434         (input  v-diasize-current-frame-width
     3435         ,input  true
     3436         ) .
     3437     end.
     3438   end procedure.
     3439   procedure diasize_set-browse-handle :
     3440     define input  parameter p-browse-handle as handle   no-undo .
     3441     define buffer buf_temp-browse-handle for temp-browse-handle .
     3442     do
     3443     on error undo, return error return-value
     3444     :
     3445       assign
     3446         v-diasize-browse-handle = p-browse-handle
     3447       .
     3448       for each buf_temp-browse-handle
     3449       on error undo, return error return-value
     3450       :
     3451         delete buf_temp-browse-handle .
     3452       end.
     3453     end.
     3454   end procedure.
     3455   procedure diasize_add_browse :
     3456     define input  parameter p-browse-type   as character no-undo .
     3457     define input  parameter p-browse-handle as handle    no-undo .
     3458     define buffer buf_temp-browse-handle for temp-browse-handle .
     3459     do
     3460     on error undo, return error return-value
     3461     :
     3462       assign
     3463         v-diasize-browse-number = v-diasize-browse-number + 1
     3464       .
     3465       create buf_temp-browse-handle .
     3466       assign
     3467         buf_temp-browse-handle.browse-type   = p-browse-type
     3468         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3469         buf_temp-browse-handle.browse-handle = p-browse-handle
     3470       .
     3471     end.
     3472   end procedure.
     3473   procedure diasize_init :
     3474     define variable v-default-value    as logical   no-undo .
     3475     define variable v-restore-saved    as logical   no-undo .
     3476     define variable v-resize-value-str as character no-undo .
     3477     do
     3478     on error undo, return error return-value
     3479     :
     3480       do with frame Dialog-Frame
     3481       :
     3482         assign
     3483           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3484           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3485           v-diasize-browse-handle     = browse-hdl-wb-egais
     3486         .
     3487         create button v-diasize-resize-button
     3488         assign
     3489           parent        = frame Dialog-Frame :first-child
     3490           label         = "s"
     3491           height-pixels = 16
     3492           width-pixels  = 16
     3493           visible       = true
     3494           sensitive     = true
     3495           movable       = true
     3496           triggers:
     3497             on end-move persistent run diasize_end-move in this-procedure .
     3498           end triggers.
     3499         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3500         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3501         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3502         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3503         assign
     3504           v-diasize-wndmax = false
     3505         .
     3506         if connected("ub") = true
     3507         then do:
     3508           define variable v-cntxt-db-num        as integer   no-undo .
     3509           define variable v-cntxt-userid        as character no-undo .
     3510           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3511                                             , OUTPUT v-cntxt-userid
     3512                                             ) .
     3513           run gbl/wndpar_r.p
     3514             (input  v-cntxt-db-num
     3515             ,input  v-cntxt-userid
     3516             ,input  'wndmax':U
     3517             ,output v-diasize-wndmax
     3518             ,output v-default-value
     3519             ) .
     3520         end.
     3521         assign
     3522           v-diasize-wndstore = false
     3523         .
     3524         if connected("ub") = true
     3525         then do:
     3526           run gbl/wndpar_r.p
     3527             (input  v-cntxt-db-num
     3528             ,input  v-cntxt-userid
     3529             ,input  'wndstore':U
     3530             ,output v-diasize-wndstore
     3531             ,output v-default-value
     3532             ) .
     3533         end.
     3534         assign
     3535           v-diasize-proc-name = entry(1, program-name(2), '.')
     3536         .
     3537         if v-diasize-wndstore = true
     3538         then do:
     3539           assign
     3540             v-restore-saved = false
     3541           .
     3542           if connected("ub") = true
     3543           then do:
     3544             run gbl/wndsizer.p
     3545               (input  v-cntxt-db-num
     3546               ,input  v-cntxt-userid
     3547               ,input  v-diasize-proc-name
     3548               ,input  'height':u
     3549               ,output v-resize-value-str
     3550               ) .
     3551             if v-resize-value-str <> '':U
     3552             then do:
     3553               run diasize_change-height in this-procedure
     3554                 (input  integer(v-resize-value-str)
     3555                 ,input  true
     3556                 ) .
     3557               assign
     3558                 v-restore-saved = true
     3559               .
     3560             end.
     3561           end.
     3562           if connected("ub") = true
     3563           then do:
     3564             run gbl/wndsizer.p
     3565               (input  v-cntxt-db-num
     3566               ,input  v-cntxt-userid
     3567               ,input  v-diasize-proc-name
     3568               ,input  'width':u
     3569               ,output v-resize-value-str
     3570               ) .
     3571             if v-resize-value-str <> '':U
     3572             then do:
     3573               run diasize_change-width in this-procedure
     3574                 (input  integer(v-resize-value-str)
     3575                 ,input  true
     3576                 ) .
     3577               assign
     3578                 v-restore-saved = true
     3579               .
     3580             end.
     3581           end.
     3582           if v-restore-saved <> true
     3583           then do:
     3584             if v-diasize-wndmax = true
     3585             then do:
     3586               run diasize_maximize in this-procedure
     3587                 (input  true
     3588                 ) .
     3589             end.
     3590           end.
     3591         end.
     3592         else do:
     3593           if v-diasize-wndmax = true
     3594           then do:
     3595             run diasize_maximize in this-procedure
     3596               (input  true
     3597               ) .
     3598           end.
     3599         end.
     3600       end.
     3601     end.
     3602   end procedure.
     3603   procedure diasize_need-full-display :
     3604     define output parameter p-need-full-display as logical   no-undo .
     3605     do
     3606     on error undo, return error return-value
     3607     :
     3608       assign
     3609         p-need-full-display = v-diasize-need-full-display
     3610       .
     3611       assign
     3612         v-diasize-need-full-display = false
     3613       .
     3614     end.
     3615   end procedure.
     3616   procedure get-context :
     3617      define output parameter p-db-num as integer          no-undo.
     3618      define output parameter p-user-id as character        no-undo.
     3619      define variable v-login               as character    no-undo.
     3620      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3621      define buffer buf_user-login  for ub.user-login .
     3622      do
     3623      on error undo, return error
     3624      :
     3625            FIND FIRST buf_sys-ctrl no-lock.
     3626            ASSIGN
     3627               v-login = USERID("ub")
     3628               p-db-num = buf_sys-ctrl.db-num
     3629            .
     3630            FIND FIRST buf_user-login
     3631                 WHERE buf_user-login.db-num = p-db-num
     3632                   AND buf_user-login.user-login = v-login
     3633                 no-lock
     3634                 no-error
     3635                 .
     3636            IF AVAILABLE buf_user-login
     3637            THEN DO:
     3638               assign
     3639                  p-user-id = buf_user-login.user-id
     3640               .
     3641            END.
     3642      end.
     3643   end procedure.
     3644     run diasize_init in this-procedure .
     3645     run enable_UI.
     3646     run proc-hide-disp.
     3647     wait-for go of frame Dialog-Frame.
     3648   end.
     3649   run disable_UI.
     3650   PROCEDURE disable_UI :
     3651     HIDE FRAME Dialog-Frame.
     3652   END PROCEDURE.
     3653   PROCEDURE enable_UI :
     3654     DISPLAY cb-1 f-date f-date-2 f-cli-name f-cli-code f-type TOGGLE_NotConn
     3655         WITH FRAME Dialog-Frame.
     3656     ENABLE Btn_OK Btn_Sel Btn_Save Btn_dnlw Btn_conn Btn_Del btn_ticket
     3657            Btn_accept Btn_delclob cb-1 f-date f-date-2 f-cli-name f-cli-code
     3658            f-type TOGGLE_NotConn
     3659         WITH FRAME Dialog-Frame.
     3660     VIEW FRAME Dialog-Frame.
     3661   END PROCEDURE.
     3662   PROCEDURE f-query :
     3663     def var v-proposition  as char no-undo.
     3664     def var v-proposition1 as char no-undo.
     3665     def var v-rowid as rowid no-undo.
     3666     assign input frame Dialog-Frame
     3667       f-cli-name
     3668       f-cli-code
     3669       f-date
     3670       f-date-2
     3671       f-type
     3672       TOGGLE_NotConn
     3673     .
     3674     v-proposition =
     3675       (if f-date <> ? then "tt-wb-hndls.wb-date >= " + string (f-date) else "") +
     3676       (if f-date-2 <> ? then " and tt-wb-hndls.wb-date <= " + string (f-date-2) else "") +
     3677       (if f-cli-name <> "" then " and tt-wb-hndls.cliname matches '*" + string (f-cli-name) + "*'" else "") +
     3678       (if f-type <> "" and f-type <> "Все" then " and tt-wb-hndls.wb-type matches '" + string (f-type) + "'" else "") +
     3679       (if f-cli-code <> 0 and f-cli-code <> ? then " and tt-wb-hndls.cli matches '*" + string (f-cli-code) + "*'" else "") +
     3680       (if logical (TOGGLE_NotConn) then " and not tt-wb-hndls.isWB" else  "")
     3681       .
     3682     v-proposition = left-trim (v-proposition, " and").
     3683     v-proposition1 = v-proposition.
     3684     v-proposition = "where " + v-proposition.
     3685     case cb-1 :
     3686       when 1 then
     3687       do:
     3688         qh-wb-egais:query-close.
     3689         qh-wb-egais:query-prepare ( substitute ("for each tt-wb-hndls &1 by tt-wb-hndls.wb-date descending", v-proposition) ).
     3690         qh-wb-egais:query-open.
     3691         bh-wb-egais:find-first ( "where (" + v-proposition1 + ")" + "and tt-wb-hndls.uniq-key-rec = " + "'" + v-uniq-key-rec + "'") no-error.
     3692       end.
     3693       when 2 then
     3694       do:
     3695         qh-wb-egais:query-close.
     3696         qh-wb-egais:query-prepare ( substitute ("for each tt-wb-hndls &1 by tt-wb-hndls.wb-date descending", v-proposition) ).
     3697         qh-wb-egais:query-open.
     3698         bh-wb-egais:find-first ( "where (" + v-proposition1 + ")" + "and tt-wb-hndls.uniq-key-rec = " + "'" + v-uniq-key-rec + "'") no-error.
     3699       end.
     3700       when 3 then
     3701       do:
     3702         qh-wb-egais:query-close.
     3703         qh-wb-egais:query-prepare ("for each tt-wb-act-hndls").
     3704         qh-wb-egais:query-open.
     3705       end.
     3706       when 4 then
     3707       do:
     3708         qh-wb-egais:query-close.
     3709         qh-wb-egais:query-prepare ( substitute ("for each tt-wb-hndls &1 by tt-wb-hndls.wb-date descending", v-proposition) ).
     3710         qh-wb-egais:query-open.
     3711         bh-wb-egais:find-first ( "where (" + v-proposition1 + ")" + "and tt-wb-hndls.trn-doc-code = " + "'" + v-trn-doc + "'") no-error.
     3712       end.
     3713     end case.
     3714     if bh-wb-egais:available
     3715       then qh-wb-egais:reposition-to-rowid ( bh-wb-egais:rowid ).
     3716     egaisWBAdv:ReleaseTable_().
     3717   end.
     3718   PROCEDURE msdblcl :
     3719   if cb-1 <> 1 and cb-1 <> 3 and cb-1 <> 2 and cb-1 <> 4
     3720       then apply "choose" to Btn_Save in frame Dialog-Frame .
     3721       else apply "choose" to Btn_Sel in frame Dialog-Frame .
     3722   end.
     3723   PROCEDURE proc-row-disp :
     3724   def var ii as int no-undo.
     3725     if cb-1 = 1 or cb-1 = 2 then do:
     3726       do ii = 1 to extent (bcol).
     3727         if valid-handle (bcol[ii])
     3728           then do:
     3729           assign
     3730             bcol[ii]:bgcolor = DARK_GRAY_COLOR when not bh-wb-egais:buffer-field ("isWb"):buffer-value and not cb-1 = 2
     3731             bcol[ii]:bgcolor = WHITE_COLOR when bh-wb-egais:buffer-field ("isWb"):buffer-value and not cb-1 = 2
     3732             bcol[ii]:bgcolor = RED_COLOR when bh-wb-egais:buffer-field ("EGAISSts"):buffer-value = 'Rejected' or bh-wb-egais:buffer-field ("EGAISSts"):buffer-value = 'Распроведена'
     3733             bcol[ii]:bgcolor = CYAN_COLOR when bh-wb-egais:buffer-field ("trn-doc-code"):buffer-value = 'отказ'
     3734           .
     3735           if bh-wb-egais:buffer-field (ii) = bh-wb-egais:buffer-field ("tts-status_")
     3736           then do:
     3737             assign
     3738               bcol[ii]:bgcolor = GREEN_COLOR when bh-wb-egais:buffer-field ("tts-status_"):buffer-value = "Принят"
     3739               bcol[ii]:bgcolor = RED_COLOR when bh-wb-egais:buffer-field ("tts-status_"):buffer-value = "Отклонен"
     3740             .
     3741           end.
     3742         end.
     3743       end.
     3744     end.
     3745   end.
     3746   PROCEDURE reopen-browse :
     3747     if bh-wb-egais = ?
     3748         then return .
     3749     if valid-handle (browse-hdl-wb-egais) then do:
     3750       v-width  = browse-hdl-wb-egais:width-chars.
     3751       v-height = browse-hdl-wb-egais:height-chars.
     3752     end.
     3753     case cb-1 :
     3754       when 1 then
     3755       do:
     3756         delete object browse-hdl-wb-egais.
     3757         create browse browse-hdl-wb-egais
     3758           assign
     3759             title     = 'Накладные ЕГАИС'
     3760             frame     = frame Dialog-Frame:handle
     3761             query     = qh-wb-egais
     3762             x         = 10
     3763             y         = 70
     3764             width     = if v-width <> 0 then v-width else 119
     3765             height    = if v-height <> 0 then v-height else 24
     3766             visible   = true
     3767             read-only = true
     3768             sensitive = true
     3769             separators = true
     3770             column-resizable = true
     3771             column-scrolling = true
     3772             triggers:
     3773               on mouse-move-dblclick persistent run msdblcl.
     3774               on row-display persistent run proc-row-disp.
     3775             end triggers
     3776         .
     3777         bh-wb-egais = egais:GetHndlTable(3, "").
     3778         qh-wb-egais:set-buffers (bh-wb-egais).
     3779         qh-wb-egais:query-prepare ("for each tt-wb-hndls by tt-wb-hndls.wb-date descending").
     3780         qh-wb-egais:query-open.
     3781         if not bh-wb-egais = ?
     3782         then do:
     3783           do ii = 1 to bh-wb-egais:num-fields:
     3784             bcol[ii] = browse-hdl-wb-egais:add-like-column('tt-wb-hndls' + '.' + bh-wb-egais:buffer-field (ii):name, 0, 'FILL-IN').
     3785             if entry (ii, egaisWBAdv:SettingsTTList, ';') <> ""
     3786             then do:
     3787               v-windth = integer (entry (1, entry (ii, egaisWBAdv:SettingsTTList, ';'))).
     3788               v-isDisp = entry (2, entry (ii, egaisWBAdv:SettingsTTList, ';')).
     3789               assign
     3790                 bcol[ii]:width = v-windth when v-windth > 0
     3791                 bcol[ii]:visible = false when v-isDisp = "no"
     3792               .
     3793             end.
     3794           end.
     3795         end.
     3796         Btn_Sel:label = "Изменить".
     3797         enable Btn_Sel with frame Dialog-Frame.
     3798         v-diasize-browse-handle = browse-hdl-wb-egais.
     3799       end.
     3800       when 2  then
     3801       do:
     3802         delete object browse-hdl-wb-egais.
