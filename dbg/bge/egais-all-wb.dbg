     3856             height    = if v-height <> 0 then v-height else 24
     3857             visible   = true
     3858             read-only = true
     3859             sensitive = true
     3860             separators = true
     3861             column-resizable = true
     3862             column-scrolling = true
     3863             triggers:
     3864               on mouse-move-dblclick persistent run msdblcl.
     3865             end triggers
     3866         .
     3867         bh-wb-egais = egais:GetHndlTable(7, "").
     3868         qh-wb-egais:set-buffers (bh-wb-egais).
     3869         qh-wb-egais:query-prepare ("for each tt-wb-act-hndls").
     3870         qh-wb-egais:query-open.
