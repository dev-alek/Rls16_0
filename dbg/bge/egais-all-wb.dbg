      852   define variable sw as handle no-undo .
      853   define variable v-file              as character no-undo initial "TransferToShop1.xml".
      854   DEFINE VARIABLE hDoc AS HANDLE NO-UNDO.
      855   DEFINE VARIABLE hRoot AS HANDLE NO-UNDO.
      856   DEFINE VARIABLE good AS LOGICAL NO-UNDO.
      857   procedure makeXML :
      858       create sax-writer sw .
      859       sw:formatted = true.
      860       sw:set-output-destination ("file", v-file).
      861       sw:encoding = "UTF-8".
      862       sw:start-document () .
      863       sw:start-element ("ns:Documents") .
      864       sw:insert-attribute ("Version", "1.0") .
      865       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
      866       sw:insert-attribute ("xmlns:xs", "http://www.w3.org/2001/XMLSchema") .
      867       sw:insert-attribute ("xmlns:c", "http://fsrar.ru/WEGAIS/Common") .
      868       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef_v2") .
      869       sw:insert-attribute ("xmlns:tts", "http://fsrar.ru/WEGAIS/TransferToShop") .
      870           sw:start-element ("ns:Owner") .
      871               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
      872           sw:end-element ("ns:Owner") .
      873           sw:start-element ("ns:Document") .
      874               sw:start-element ("ns:TransferToShop") .
      875                   sw:write-data-element ("tts:Identity", tt-act-header.num) no-error .
      876                   sw:start-element ("tts:Header") .
      877                       sw:write-data-element ("tts:TransferNumber", tt-act-header.num) no-error .
      878                       sw:write-data-element ("tts:TransferDate", string(iso-date(tt-act-header.date_))) no-error .
      879                   sw:end-element ("tts:Header") .
      880                   sw:start-element ("tts:Content") .
      881       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
      882                       sw:start-element ("tts:Position") .
      883                           sw:write-data-element ("tts:Identity", string(tt-gds-act.position_)) no-error .
      884                           sw:write-data-element ("tts:Quantity", string(tt-gds-act.qnty)) no-error .
      885                           sw:write-data-element ("gds-code", string(tt-gds-act.gds-code)) no-error .
      886                           sw:write-data-element ("gds-name", tt-gds-act.gds-name) no-error .
      887                           sw:write-data-element ("alc-code", tt-gds-act.alc-code) no-error .
      888                           sw:start-element ("tts:InformB") .
      889                               sw:write-data-element ("pref:BRegId", tt-gds-act.inform-B) no-error .
      890                           sw:end-element ("tts:InformB") .
      891                       sw:end-element ("tts:Position") .
      892       end.
      893                   sw:end-element ("tts:Content") .
      894               sw:end-element ("ns:TransferToShop") .
      895           sw:end-element ("ns:Document") .
      896       sw:end-element ("ns:Documents") .
      897       sw:end-document () .
      898       delete object sw.
      899   end procedure .
      900   procedure makeXMLegais_v2 :
      901       create sax-writer sw .
      902       sw:formatted = true.
      903       sw:set-output-destination ("file", v-file).
      904       sw:encoding = "UTF-8".
      905       sw:start-document () .
      906       sw:start-element ("ns:Documents") .
      907       sw:insert-attribute ("Version", "1.0") .
      908       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
      909       sw:insert-attribute ("xmlns:xs", "http://www.w3.org/2001/XMLSchema") .
      910       sw:insert-attribute ("xmlns:c", "http://fsrar.ru/WEGAIS/Common") .
      911       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef_v2") .
      912       sw:insert-attribute ("xmlns:tts", "http://fsrar.ru/WEGAIS/TransferToShop") .
      913           sw:start-element ("ns:Owner") .
      914               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
      915           sw:end-element ("ns:Owner") .
      916           sw:start-element ("ns:Document") .
      917               sw:start-element ("ns:TransferToShop") .
      918                   sw:write-data-element ("tts:Identity", tt-act-header.num) .
      919                   sw:start-element ("tts:Header") .
      920                       sw:write-data-element ("tts:TransferNumber", tt-act-header.num) .
      921                       sw:write-data-element ("tts:TransferDate", string(iso-date(tt-act-header.date_))) no-error .
      922                   sw:end-element ("tts:Header") .
      923                   sw:start-element ("tts:Content") .
      924       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
      925           if tt-gds-act.qnty <= 0 or trim(tt-gds-act.inform-B) = "" or tt-gds-act.inform-B = ? then next.
      926                       sw:start-element ("tts:Position") .
      927                           sw:write-data-element ("tts:Identity", string(tt-gds-act.position_)) .
      928                           sw:write-data-element ("tts:ProductCode", tt-gds-act.alc-code) no-error .
      929                           sw:write-data-element ("tts:Quantity", string(tt-gds-act.qnty)) .
      930                           sw:start-element ("tts:InformF2") .
      931                             sw:write-data-element ("pref:F2RegId", tt-gds-act.inform-B) .
      932                           sw:end-element ("tts:InformF2") .
      933                       sw:end-element ("tts:Position") .
      934       end.
      935                   sw:end-element ("tts:Content") .
      936               sw:end-element ("ns:TransferToShop") .
      937           sw:end-element ("ns:Document") .
      938       sw:end-element ("ns:Documents") .
      939       sw:end-document () .
      940       delete object sw.
      941   end procedure .
      942   procedure parseXML :
      943       define input parameter inFile as character no-undo .
      944       empty temp-table tt-act-header .
      945       empty temp-table tt-gds-act .
      946       CREATE X-DOCUMENT hDoc.
      947       CREATE X-NODEREF hRoot.
      948       hDoc:encoding = 'utf-8'.
      949       hDoc:LOAD("file", search(inFile),FALSE).
      950       hDoc:GET-DOCUMENT-ELEMENT(hRoot).
      951       RUN GetChildren(hRoot, 1).
      952       DELETE OBJECT hDoc.
      953       DELETE OBJECT hRoot.
      954   end procedure .
      955   procedure GetChildren :
      956       DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
      957       DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
      958       DEFINE VARIABLE i AS INTEGER NO-UNDO.
      959       DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
      960       DEFINE VARIABLE hText AS HANDLE NO-UNDO.
      961       CREATE X-NODEREF hNoderef.
      962       CREATE X-NODEREF hText .
      963       REPEAT i = 1 TO hParent:NUM-CHILDREN:
      964           good = hParent:GET-CHILD(hNoderef,i).
      965           IF NOT good THEN
      966               LEAVE.
      967           IF hNoderef:SUBTYPE <> "element" THEN
      968               NEXT.
      969           hNoderef:GET-CHILD(hText, 1) no-error .
      970           IF hNoderef:NAME = "tts:Header" THEN do :
      971               create tt-act-header .
      972               assign tt-act-header.is-sent = bh-act-header:buffer-field("is-sent"):buffer-value no-error.
      973           end .
      974           .
      975           IF hNoderef:NAME = "tts:TransferNumber" THEN assign tt-act-header.num    = hText:node-value no-error .
      976           IF hNoderef:NAME = "tts:TransferDate" THEN
      977               assign tt-act-header.date_ = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
      978           IF hNoderef:NAME = "tts:Position" THEN do :
      979               assign ii = 0 .
      980               create tt-gds-act .
      981               assign tt-gds-act.num = tt-act-header.num .
      982           end.
      983           IF hNoderef:NAME = "tts:Identity" THEN assign tt-gds-act.position_ = integer(hText:node-value) no-error .
      984           IF hNoderef:NAME = "tts:Quantity" THEN assign tt-gds-act.qnty = decimal(hText:node-value) no-error .
      985           IF hNoderef:NAME = "pref:BRegId"
      986           OR hNoderef:NAME = "pref:F2RegId" THEN assign tt-gds-act.inform-B = (hText:node-value) no-error .
      987           IF hNoderef:NAME = "gds-code"     THEN do :
      988               assign tt-gds-act.gds-code = integer(hText:node-value) no-error .
      989               find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code no-error .
      990               if available buf_goods then assign tt-gds-act.gds-name = buf_goods.gds-name .
      991           end.
      992           if hNoderef:NAME = "gds-name" and trim(tt-gds-act.gds-name) = "" then assign tt-gds-act.gds-name = (hText:node-value) no-error .
      993           IF hNoderef:NAME = "alc-code"
      994           OR hNoderef:NAME = "tts:ProductCode"    THEN assign tt-gds-act.alc-code = (hText:node-value) no-error .
      995           run GetChildren (hNoderef, (level + 1)).
      996       END.
      997       DELETE OBJECT hNoderef.
      998       DELETE OBJECT hText.
      999   END procedure.
