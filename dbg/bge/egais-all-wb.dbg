     3840           end.
     3841         end.
     3842         Btn_Sel:label = "Просмотр".
     3843         v-diasize-browse-handle = browse-hdl-wb-egais.
     3844       end.
     3845       when 3  then
     3846       do:
     3847         delete object browse-hdl-wb-egais.
