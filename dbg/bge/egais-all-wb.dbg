     1581   DEFINE BUTTON Btn_accept
     1582        LABEL "Подтв."
     1583        SIZE 10 BY 1.21.
     1584   DEFINE BUTTON Btn_conn
     1585        LABEL "Связать"
     1586        SIZE 10 BY 1.21.
     1587   DEFINE BUTTON Btn_Del
     1588        LABEL "Отказ"
     1589        SIZE 10 BY 1.21.
     1590   DEFINE BUTTON Btn_delclob
     1591        LABEL "Удалить"
     1592        SIZE 10 BY 1.21 TOOLTIP "Удаляет из базы TH. Если данные в УТМ остались, то будет загружено повторно.".
     1593   DEFINE BUTTON Btn_dnlw
     1594        LABEL "Загрузить"
     1595        SIZE 10 BY 1.21.
     1596   DEFINE BUTTON Btn_OK
     1597        LABEL "Выход"
     1598        SIZE 10 BY 1.21
     1599        BGCOLOR 8 .
     1600   DEFINE BUTTON Btn_Save
     1601        LABEL "Сохранить"
     1602        SIZE 10 BY 1.21
     1603        BGCOLOR 8 .
     1604   DEFINE BUTTON Btn_Sel
     1605        LABEL "Изменить"
     1606        SIZE 10 BY 1.21
     1607        BGCOLOR 8 .
     1608   DEFINE BUTTON btn_ticket
     1609        LABEL "Просмотр"
     1610        SIZE 10 BY 1.21.
     1611   DEFINE VARIABLE cb-1 AS INTEGER FORMAT "->,>>>,>>9" INITIAL 1
     1612        VIEW-AS COMBO-BOX
     1613        LIST-ITEM-PAIRS "Полученные",1,
     1614                        "Закрытые на факт",2,
     1615                        "Акты",3,
     1616                        "Расход",4
     1617        DROP-DOWN-LIST
     1618        SIZE 19.88 BY 1 NO-UNDO.
     1619   DEFINE VARIABLE f-type AS CHARACTER FORMAT "X(256)":U INITIAL "Все"
     1620        LABEL "Тип"
     1621        VIEW-AS COMBO-BOX
     1622        LIST-ITEMS "Все","приход вн.","возврат пост.","расход внутренний","расход внешний"
     1623        DROP-DOWN-LIST
     1624        SIZE 14 BY 1 NO-UNDO.
     1625   DEFINE VARIABLE f-cli-code AS INTEGER FORMAT "->>>>>>9":U INITIAL 0
     1626        LABEL "Код"
     1627        VIEW-AS FILL-IN
     1628        SIZE 14 BY 1 NO-UNDO.
     1629   DEFINE VARIABLE f-cli-name AS CHARACTER FORMAT "x(256)":U
     1630        LABEL "Контрагент"
     1631        VIEW-AS FILL-IN
     1632        SIZE 14 BY 1 NO-UNDO.
     1633   DEFINE VARIABLE f-date AS DATE FORMAT "99/99/99":U
     1634        LABEL "Дата с"
     1635        VIEW-AS FILL-IN
     1636        SIZE 9.5 BY 1 NO-UNDO.
     1637   DEFINE VARIABLE f-date-2 AS DATE FORMAT "99/99/99":U
     1638        LABEL "по"
     1639        VIEW-AS FILL-IN
     1640        SIZE 9.5 BY 1 NO-UNDO.
     1641   DEFINE VARIABLE TOGGLE_NotConn AS LOGICAL INITIAL no
     1642        LABEL "Не связ."
     1643        VIEW-AS TOGGLE-BOX
     1644        SIZE 11.13 BY 1 NO-UNDO.
     1645   DEFINE MENU popup-menu-reject
     1646          MENU-ITEM m_reject LABEL "Отправить акт отказа" ACCELERATOR "ALT-1"
     1647          MENU-ITEM m_reqRepealWB LABEL "Отправить запрос на отмену проведения накладной" ACCELERATOR "ALT-2"
     1648   .
     1649   DEFINE FRAME Dialog-Frame
     1650        Btn_OK AT ROW 1.21 COL 2.63
     1651        Btn_Sel AT ROW 1.21 COL 13.25 WIDGET-ID 6
     1652        Btn_Save AT ROW 1.21 COL 24 WIDGET-ID 10
     1653        Btn_dnlw AT ROW 1.21 COL 34.63 WIDGET-ID 12
     1654        Btn_conn AT ROW 1.21 COL 45 WIDGET-ID 16
     1655        Btn_Del AT ROW 1.21 COL 55.63 WIDGET-ID 14
     1656        btn_ticket AT ROW 1.21 COL 66 WIDGET-ID 36
     1657        Btn_accept AT ROW 1.21 COL 76.63 WIDGET-ID 32
     1658        Btn_delclob AT ROW 1.21 COL 86.88 WIDGET-ID 38
     1659        cb-1 AT ROW 1.21 COL 98.5 COLON-ALIGNED NO-LABEL WIDGET-ID 2
     1660        f-date AT ROW 2.5 COL 8.63 COLON-ALIGNED WIDGET-ID 22
     1661        f-date-2 AT ROW 2.5 COL 22.75 COLON-ALIGNED WIDGET-ID 26
     1662        f-cli-name AT ROW 2.5 COL 45.25 COLON-ALIGNED WIDGET-ID 24
     1663        f-cli-code AT ROW 2.5 COL 65.25 COLON-ALIGNED WIDGET-ID 30
     1664        f-type AT ROW 2.5 COL 85 COLON-ALIGNED WIDGET-ID 28
     1665        TOGGLE_NotConn AT ROW 2.5 COL 101.75 WIDGET-ID 34
     1666        SPACE(8.74) SKIP(25.23)
     1667       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1668            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1669            TITLE "Накладные/акты ЕГАИС" WIDGET-ID 100.
     1670   ASSIGN
     1671          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1672          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1673   ON window-close OF FRAME Dialog-Frame
     1674   do:
     1675     apply "END-ERROR":U to self.
     1676   end.
     1677   ON CHOOSE OF Btn_accept IN FRAME Dialog-Frame
     1678   DO:
     1679     if not bh-wb-egais:available
     1680       then return no-apply.
     1681     if actnEGAISAdm then do:
     1682   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1683   do:
     1684     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1685       (input  v-cntxt-db-num
     1686       ,input  v-cntxt-userid
     1687       ,input  0
     1688       ,input  'actn_egais-accept':U
     1689       ,input  'object':U
     1690       ,input  v-cntxt-host-code-obj
     1691       ,input  v-cntxt-obj-type
     1692       ,input  v-cntxt-obj-code
     1693       ,input  0
     1694       ,input  0
     1695       ,input  0
     1696       ,input  true
     1697       ,output glog
     1698       )  .
     1699   end.
     1700       if not glog then  return .
     1701       message  substitute ("Вы уверены, что хотите подтвердить накладную &1/&2 без проверок?", bh-wb-egais:buffer-field ("trn-doc-code"):buffer-value, entry (1, bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value, chr(6)) ) view-as alert-box question buttons yes-no
     1702         title "" update isChoise as logical.
     1703       if not isChoise
     1704         then return no-apply.
     1705       bh-wb-gds-EG = ?.
     1706       bh-wb-gds-EG-header = ?.
     1707       bh-wb-gds-EG-header = egais:GetHndlTable(1, bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value).
     1708       v-uniq-key-rec = bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value.
     1709       if egais:StatusErr
     1710       then do:
     1711         message egais:Msg view-as alert-box error.
     1712         return no-apply.
     1713       end.
     1714       egaisWBAdv:SendForceAccept().
     1715       if egaisWBAdv:StatusErr
     1716         then message egaisWBAdv:Msg view-as alert-box error.
     1717         else do:
     1718   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input bh-wb-egais:buffer-field('trn-doc-code'):buffer-value ,
     1719                          input 'egais':U ,
     1720                          input '0':U ) no-error .
     1721           message "Отправлен акт на накладную" view-as alert-box.
     1722         end.
     1723       run f-query.
     1724     end.
     1725     else do:
     1726       message "Отсутсвуют права для данной операции." view-as alert-box.
     1727     end.
     1728   END.
     1729   ON choose OF Btn_conn IN FRAME Dialog-Frame
     1730   do:
     1731     def var loc-ref-list as character no-undo.
     1732     def var v-negais     as character no-undo.
     1733     def var v-date       as character no-undo.
     1734     define variable v-part-num    as integer   no-undo.
     1735     define variable v-clob-db-num as integer   no-undo.
     1736     define variable v-int64-id    as int64     no-undo.
     1737     define variable v-info        as character no-undo.
     1738     if not bh-wb-egais:available
     1739       then return no-apply.
     1740     v-uniq-key-rec = bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value.
     1741     case cb-1:
     1742     when 1 then do:
     1743       bh-wb-gds-EG = ?.
     1744       bh-wb-gds-EG-header = ?.
     1745       bh-wb-gds-EG-header = egais:GetHndlTable(1, bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value).
     1746       if egais:StatusErr
     1747       then do:
     1748         message egais:Msg view-as alert-box error.
     1749         return no-apply.
     1750       end.
     1751       run str/all-docs.w
     1752         (  input parparentproc,
     1753             input v-cntxt-host-code-obj ,
     1754             input v-cntxt-obj-type ,
     1755             input v-cntxt-obj-code ,
     1756             input 'выбор':U,
     1757             input ?,
     1758             input 'при':U,
     1759             input ?,
     1760             input ?,
     1761             input "b-sel":U,
     1762             input 'ie':U,
     1763             input no,
     1764             input ?,
     1765             output loc-ref-list ).
     1766       find first ub.trn-doc no-lock where recid (ub.trn-doc) = integer (loc-ref-list) no-error.
     1767       if not available (ub.trn-doc)
     1768         then return.
     1769       bh-wb-gds-EG = ?.
     1770       bh-wb-gds-EG-header = ?.
     1771       bh-wb-gds-EG-header = egais:GetHndlTable(1, bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value).
     1772       bh-wb-gds-EG = egais:GetHndlTable(2, bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value).
     1773       find first ub.clients
     1774         where ub.clients.obj-type = bh-wb-gds-EG-header:buffer-field ("cli-type"):buffer-value
     1775           and ub.clients.obj-code = integer (bh-wb-gds-EG-header:buffer-field ("cli-code"):buffer-value) no-error.
     1776       if not available (ub.clients)
     1777       then do:
     1778         message "Не найден клиент TH для EGAIS контрагентa regID: " + bh-wb-gds-EG-header:buffer-field ('regId-Ship'):buffer-value view-as alert-box.
     1779         return no-apply.
     1780       end.
     1781       find first ub.clients
     1782         where ub.clients.obj-type = bh-wb-gds-EG-header:buffer-field ("obj-type"):buffer-value
     1783           and ub.clients.obj-code = integer (bh-wb-gds-EG-header:buffer-field ("obj-code"):buffer-value) no-error.
     1784       if not available (ub.clients)
     1785       then do:
     1786         message "Не найден объект TH для EGAIS получателя regID: " + bh-wb-gds-EG-header:buffer-field ('regId-Cons'):buffer-value view-as alert-box.
     1787         return no-apply.
     1788       end.
     1789       bh-wb-gds-EG:find-first ("where tt-wb-gds-EG.gds-code = ?", no-lock) no-error.
     1790       if bh-wb-gds-EG:available then do:
     1791         message "Не найден товар TH для EGAIS товара AlcCode: " + bh-wb-gds-EG:buffer-field ('alc-code'):buffer-value view-as alert-box.
     1792         return no-apply.
     1793       end.
     1794       egais:ConnWB(bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value, ub.trn-doc.doc-code).
     1795       if egais:StatusErr
     1796         then message egais:Msg view-as alert-box error.
     1797       else do:
     1798         message "Накладная связана" view-as alert-box.
     1799       end.
     1800       output stream strlog to value ("egaislog.txt") append.
     1801       export stream strlog egais:Msg.
     1802       output stream strlog close.
     1803     end.
     1804     when 2 then do:
     1805       if bh-wb-egais:buffer-field ("EGAISSts"):buffer-value () <> "Accepted"
     1806       then do:
     1807         message 'Aкт передачи в торговый зал возможно сформировать только для накладной в статусе "Accepted"!' view-as alert-box information title "Информация".
     1808         undo, return.
     1809       end.
     1810       find first buf_trn-doc no-lock where buf_trn-doc.doc-code = bh-wb-egais:buffer-field ("trn-doc-code"):buffer-value no-error .
     1811       if error-status :error then return .
     1812       v-date = substitute ("&1&2&3", string (day (now), "99"), string (month (now), "99"),substring (string(year (now)), 3,2)).
     1813       create tt-act-header .
     1814       assign
     1815           tt-act-header.num = "TTS-" + v-date + '-' + substring(v-cntxt-obj-type,1,1) + string(v-cntxt-obj-code) + '-' + buf_trn-doc.doc-code
     1816           tt-act-header.date_ = TODAY
     1817           tt-act-header.is-sent = no
     1818       .
     1819       for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code :
     1820           find first buf_goods no-lock where buf_goods.artic      = buf_doc-line.artic
     1821                                          and buf_goods.prod-type  = buf_doc-line.prod-type
     1822                                          and buf_goods.prod-code  = buf_doc-line.prod-code .
     1823           run gds-attr-value(
     1824             buf_goods.gds-code,
     1825             'alcohol-prod':U,
     1826             output par-alcohol,
     1827             output par-type
     1828           ).
     1829           if par-alcohol = "" or par-alcohol = "no" then next .
     1830           for each buf_parts no-lock where buf_parts.artic        = buf_doc-line.artic
     1831                                        and buf_parts.prod-type    = buf_doc-line.prod-type
     1832                                        and buf_parts.prod-code    = buf_doc-line.prod-code
     1833                                        and buf_parts.obj-type     = buf_doc-line.obj-type
     1834                                        and buf_parts.obj-code     = buf_doc-line.obj-code
     1835                                        and buf_parts.out-code     = buf_doc-line.doc-code :
     1836                assign nn = nn + 1 .
     1837                create tt-gds-act .
     1838                assign
     1839                   tt-gds-act.num          = tt-act-header.num
     1840                   tt-gds-act.gds-code     = buf_goods.gds-code
     1841                   tt-gds-act.gds-name     = buf_goods.gds-name
     1842                   tt-gds-act.position_    = nn
     1843                   tt-gds-act.qnty         = buf_parts.fact-qnty / buf_parts.cli-base-rate
     1844                .
     1845                if num-entries(buf_parts.alc-ref-ab-path) = 4 and entry(3, buf_parts.alc-ref-ab-path) <> "" then do :
     1846                    tt-gds-act.alc-code = entry(3, buf_parts.alc-ref-ab-path) .
     1847                end.
     1848                else do :
     1849                    run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     1850                                                       ,input (buffer buf_goods:handle)
     1851                                                       ,output v-gds-uniq-key-rec).
     1852                    find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     1853                                                      and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     1854                                                      AND X_ext-classif.db-num = 0
     1855                                                      and X_ext-classif.key#_one = buf_goods.gds-code
     1856                                                      and X_ext-classif.key#_two = v-ext-sys
     1857                                                      and X_ext-classif.key#_three = 0
     1858                                                      and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     1859                                                      and X_eXt-classif.charkey_two = ""
     1860                                                      and X_eXt-classif.charkey_three = ""
     1861                                                      and X_eXt-classif.nonunique = 0
     1862                                                      no-error .
     1863                    if available X_ext-classif then tt-gds-act.alc-code = X_eXt-classif.charkey_one .
     1864                end.
     1865                if num-entries(buf_parts.alc-ref-ab-path) = 4 and entry(2, buf_parts.alc-ref-ab-path) <> "" then do :
     1866                    tt-gds-act.inform-B = trim(entry(2, buf_parts.alc-ref-ab-path)) .
     1867                end.
     1868           end .
     1869       end .
     1870       find first tt-gds-act no-error .
     1871       if not available tt-gds-act then do :
     1872           message "В акте нет строк. Сохранение невозможно" view-as alert-box .
     1873           return no-apply.
     1874       end.
     1875       if can-find(tt-gds-act where tt-gds-act.qnty < 1)
     1876       or can-find(tt-gds-act where trim(tt-gds-act.inform-B) = "")
     1877       then do :
     1878           message "Строки, в которых не указана справка Б, и строки, в которых количество меньше 1, не будут учтены при отправке в ЕГАИС!" skip "Продолжить?"
     1879           view-as alert-box question buttons yes-no update glog .
     1880           if not glog then return no-apply.
     1881       end.
     1882       run makeXML in this-procedure no-error.
     1883       if error-status:error then return return-value .
     1884       assign
     1885           v-clob-db-num = ?
     1886           v-int64-id = 0
     1887           v-info = tt-act-header.num + chr(4) + string(tt-act-header.date_) + chr(4) + string(tt-act-header.is-sent) + chr(4) + tt-act-header.answer_
     1888       .
     1889       find first buf_clob-bind exclusive-lock where buf_clob-bind.field-name_  = 'egais-tts':U
     1890         and buf_clob-bind.uniq-key-rec matches substitute ("*&1*", buf_trn-doc.doc-code) no-error .
     1891       if available buf_clob-bind
     1892       then do :
     1893         message "Акт с таким номером уже существует!" view-as alert-box information
     1894           title "Информация".
     1895           release buf_clob-bind.
     1896           return no-apply .
     1897       end.
     1898       run gbl/file2clb.p ( input 'ДОБАВЛЕНИЕ':U
     1899                 ,input ",yes"
     1900                 ,input ?
     1901                 ,input tt-act-header.num
     1902                 ,input 'egais-tts':U
     1903                 ,input v-info
     1904                 ,input-output v-part-num
     1905                 ,input 'egais-tts':U
     1906                 ,input-output v-clob-db-num
     1907                 ,input-output v-int64-id
     1908                 ,input search (v-file)
     1909                 ,input ''
     1910                 ) no-error .
     1911       if error-status:error then message return-value view-as alert-box.
     1912       bh-wb-egais:buffer-field ("tts"):buffer-value () = tt-act-header.num.
     1913       bh-wb-egais:buffer-field ("tts-status_"):buffer-value () = "Новый".
     1914       message substitute ("Создан акт № &1 перемещения в торговый зал", buf_trn-doc.doc-code) view-as alert-box title "Сообщение".
     1915       release buf_clob-bind.
     1916       empty temp-table tt-act-header.
     1917       empty temp-table tt-gds-act.
     1918     end.
     1919     end case.
     1920     run f-query.
     1921   end.
     1922   ON choose OF Btn_Del IN FRAME Dialog-Frame
     1923   do:
     1924     run rejectWB.
     1925   end.
     1926   ON choose of menu-item m_reject IN menu popup-menu-reject
     1927   do:
     1928     run rejectWB.
     1929   end.
     1930   ON choose of menu-item m_reqRepealWB IN menu popup-menu-reject
     1931   do:
     1932     run ReqRepealWB.
     1933   end.
     1934   ON CHOOSE OF Btn_delclob IN FRAME Dialog-Frame
     1935   DO:
     1936     if not bh-wb-egais:available
     1937       then return no-apply.
     1938   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1939   do:
     1940     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1941       (input  v-cntxt-db-num
     1942       ,input  v-cntxt-userid
     1943       ,input  0
     1944       ,input  'actn_egais-adm':U
     1945       ,input  'object':U
     1946       ,input  v-cntxt-host-code-obj
     1947       ,input  v-cntxt-obj-type
     1948       ,input  v-cntxt-obj-code
     1949       ,input  0
     1950       ,input  0
     1951       ,input  0
     1952       ,input  false
     1953       ,output glog
     1954       )  .
     1955   end.
     1956     if not glog then return no-apply.
     1957     if bh-wb-egais:buffer-field ('DbNum'):buffer-value () <>  v-cntxt-db-num
     1958     then do:
     1959       message "Нельзя удалять накладную полученную в другой БД " + bh-wb-egais:buffer-field ('DbNum'):buffer-value ().
     1960       return no-apply.
     1961     end.
     1962     message "Вы уверены что хотите удалить накладную - " bh-wb-egais:buffer-field ('num'):buffer-value () "?" view-as alert-box buttons yes-no update isChoise as logical.
     1963     if not isChoise then return no-apply.
     1964     do trans:
     1965       for each ub.clob-bind exclusive-lock where ub.clob-bind.uniq-key-rec = bh-wb-egais:buffer-field ('uniq-key-rec'):buffer-value () and ub.clob-bind.db-num = bh-wb-egais:buffer-field ('DbNum'):buffer-value ():
     1966         delete ub.clob-bind.
     1967       end.
     1968     end.
     1969     run reopen-browse.
     1970   END.
     1971   ON choose OF Btn_dnlw IN FRAME Dialog-Frame
     1972   do:
     1973     if not search ( v-FS-RAR + '_ReceiptListOfQuery.xml' ) = ?
     1974     then do:
     1975       message "Выполнить полную загрузка (переодически рекомендуется выполнять полную загрузку)?" view-as alert-box question buttons yes-no update isChoise as logical.
     1976       if isChoise
     1977         then egaisWBAdv:FastDwnl = false.
     1978         else egaisWBAdv:FastDwnl = true.
     1979     end.
     1980     egaisWBAdv:GetDocUTM().
     1981     if egaisWBAdv:StatusErr
     1982     then do:
     1983       message "Ошибка: " egaisWBAdv:Msg view-as alert-box error.
     1984     end.
     1985     bh-analiz = egaisWBAdv:HndlAnaliz.
     1986     if bh-analiz <> ?
     1987     then do:
     1988       bh-analiz:find-first ("where isMany") no-error.
     1989       if bh-analiz:available
     1990       then do:
     1991         message "Имеются накладные с одинаковыми номерами. Посмотреть?" view-as alert-box question buttons yes-no update isChoise.
     1992         if isChoise
     1993           then run bge/egais-analiz.w (input parparentproc, input egaisWBAdv).
     1994       end.
     1995     end.
     1996     def var egaisJournal        as class  Journal        no-undo.
     1997     def var ExtFormF1ValueObj      as class  ExtFormF1Value no-undo.
     1998     def var ExtFormF1ValueObjDB    as class  ExtFormF1Value no-undo.
     1999     define variable ExtFormF1Obj           as class     ExtFormF1 no-undo .
     2000     def var egaisFormF1        as class  FormF1         no-undo.
     2001     def var bh-journal-egais    as handle no-undo.
     2002     def var qh-journal-egais    as handle no-undo.
     2003     def var bh-gds-egais-gotten as handle no-undo.
     2004     def var msg                 as character no-undo.
     2005     def var ii                  as integer   no-undo.
     2006     def var jj                  as integer   no-undo.
     2007     output stream str-FormF1 to "logWBDnlFormF1.txt" append.
     2008     egaisJournal = new Journal ().
     2009     ExtFormF1Obj = new ExtFormF1 (yes).
     2010     bh-journal-egais = egaisJournal:GetHndlTable().
     2011     create query qh-journal-egais.
     2012     qh-journal-egais:set-buffers (bh-journal-egais) .
     2013     qh-journal-egais:query-prepare ( substitute ("for each tt_journal-egais where jou-subject = '&1' and jou-status = 'Запрос отправлен' ", 'Справочник справок 1')).
     2014     qh-journal-egais:query-open.
     2015     run waitfram-show in this-procedure ("Ждите... Идет загрузка справок 1.") .
     2016     journal_:
     2017     do while qh-journal-egais:get-next ():
     2018       egaisFormF1 = new FormF1 (v-cntxt-obj-type, v-cntxt-obj-code, v-fs-rar, entry (2, bh-journal-egais:buffer-field ("jou-param"):buffer-value, '|')).
     2019       egaisFormF1:DbNum = v-db-num.
     2020       egaisFormF1:User_Id = v-user-id.
     2021       glog = egaisFormF1:StatusErr .
     2022       if glog then do :
     2023           msg = msg + chr(10) + egaisFormF1:Msg.
     2024       end.
     2025       else do:
     2026         bh-gds-egais-gotten = egaisFormF1:GetHndlTable() .
     2027         if egaisFormF1:Msg = 'Не удалось получить данные от UTM'
     2028         then do:
     2029           message egaisFormF1:Msg + ". Проверьте соединение с УТМ." view-as alert-box error.
     2030           run waitfram-hide in this-procedure.
     2031           output stream str-FormF1 close.
     2032           if valid-object (ExtFormF1Obj)
     2033             then delete object ExtFormF1Obj.
     2034           if valid-handle (qh-journal-egais)
     2035             then delete object qh-journal-egais.
     2036           if valid-object (egaisJournal)
     2037             then delete object egaisJournal.
     2038           run reopen-browse.
     2039           return.
     2040         end.
     2041         if bh-gds-egais-gotten = ? or not bh-gds-egais-gotten:find-first ()
     2042         then do:
     2043           put stream str-FormF1 unformatted chr(10) + egaisFormF1:Msg.
     2044           delete object egaisFormF1.
     2045           next journal_.
     2046         end.
     2047         ExtFormF1ValueObj = cast (bh-gds-egais-gotten:buffer-field("extFormF1ValueObj"):buffer-value, ibs.th.bge.egais.ExtFormF1Value).
     2048         ExtFormF1Obj:OpenQueryExtFormF1 (bh-gds-egais-gotten:buffer-field("formF1code"):buffer-value).
     2049         do ii = 1 to ExtFormF1Obj:NumBundles:
     2050           ExtFormF1ValueObjDB = ExtFormF1Obj:GetExtFormF1Value(ii).
     2051           assign
     2052             ExtFormF1ValueObjDB:CliRegIdOrigCli = ExtFormF1ValueObj:CliRegIdOrigCli
     2053             ExtFormF1ValueObjDB:CliEgaisTypeOrigCli = ExtFormF1ValueObj:CliEgaisTypeOrigCli
     2054             ExtFormF1ValueObjDB:INNOrigCli = ExtFormF1ValueObj:INNOrigCli
     2055             ExtFormF1ValueObjDB:KPPOrigCli = ExtFormF1ValueObj:KPPOrigCli
     2056             ExtFormF1ValueObjDB:FullNameOrigCli = ExtFormF1ValueObj:FullNameOrigCli
     2057             ExtFormF1ValueObjDB:CountryOrigCli = ExtFormF1ValueObj:CountryOrigCli
     2058             ExtFormF1ValueObjDB:RegionOrigCli = ExtFormF1ValueObj:RegionOrigCli
     2059             ExtFormF1ValueObjDB:DescrOrigCli = ExtFormF1ValueObj:DescrOrigCli
     2060           .
     2061           ExtFormF1Obj:SaveEGAISInfo(ExtFormF1ValueObjDB).
     2062           put stream str-FormF1 unformatted chr(10) substitute ('Запись &1/&2 обновлена', ExtFormF1ValueObjDB:AlcCode, ExtFormF1ValueObj:FormF1Code ).
     2063           jj = jj + 1.
     2064         end.
     2065       end.
     2066       delete object egaisFormF1.
     2067     end.
     2068     run waitfram-hide in this-procedure.
     2069     output stream str-FormF1 close.
     2070     if valid-object (ExtFormF1Obj)
     2071       then delete object ExtFormF1Obj.
     2072     if valid-handle (qh-journal-egais)
     2073       then delete object qh-journal-egais.
     2074     if valid-object (egaisJournal)
     2075       then delete object egaisJournal.
     2076     run reopen-browse.
     2077   end.
     2078   ON choose OF Btn_OK IN FRAME Dialog-Frame
     2079   do:
     2080     if valid-object (egais)
     2081       then delete object egais.
     2082     if valid-object (egaisWBAdv)
     2083       then delete object egaisWBAdv.
     2084     apply "go" to frame Dialog-Frame.
     2085   end.
     2086   ON choose OF Btn_Save IN FRAME Dialog-Frame
     2087   do:
     2088     def var v-doc-code as character no-undo.
     2089     if not bh-wb-egais:available
     2090       then return no-apply.
     2091     case cb-1:
     2092     when 1 then do:
     2093       if can-find (first ub.trn-doc where ub.trn-doc.doc-code = bh-wb-egais:buffer-field ("trn-doc-code"):buffer-value)
     2094       then do:
     2095         message substitute ( "Накладная с № &1 уже сформирована", bh-wb-egais:buffer-field ("trn-doc-code"):buffer-value)
     2096         view-as alert-box.
     2097         return no-apply.
     2098       end.
     2099       if bh-wb-egais:buffer-field ("trn-doc-code"):buffer-value = 'отказ'
     2100       then do:
     2101         message "Накладная в статусе отказ. Нельзя сохранить."
     2102         view-as alert-box.
     2103         return no-apply.
     2104       end.
     2105       bh-wb-gds-EG = ?.
     2106       bh-wb-gds-EG-header = ?.
     2107       bh-wb-gds-EG-header = egais:GetHndlTable(1, bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value).
     2108       bh-wb-gds-EG = egais:GetHndlTable(2, bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value).
     2109       v-uniq-key-rec = bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value.
     2110       find first ub.clients no-lock
     2111         where ub.clients.obj-type = bh-wb-gds-EG-header:buffer-field ("cli-type"):buffer-value
     2112           and ub.clients.obj-code = integer (bh-wb-gds-EG-header:buffer-field ("cli-code"):buffer-value) no-error.
     2113       if not available (ub.clients)
     2114       then do:
     2115         message "Не найден клиент TH для EGAIS контрагентa regID: " + bh-wb-gds-EG-header:buffer-field ('regId-Ship'):buffer-value view-as alert-box.
     2116         return no-apply.
     2117       end.
     2118       find first ub.clients no-lock
     2119         where ub.clients.obj-type = bh-wb-gds-EG-header:buffer-field ("obj-type"):buffer-value
     2120           and ub.clients.obj-code = integer (bh-wb-gds-EG-header:buffer-field ("obj-code"):buffer-value) no-error.
     2121       if not available (ub.clients)
     2122       then do:
     2123         message "Не найден объект TH для EGAIS получателя regID: " + bh-wb-gds-EG-header:buffer-field ('regId-Cons'):buffer-value view-as alert-box.
     2124         return no-apply.
     2125       end.
     2126       bh-wb-gds-EG:find-first ("where tt-wb-gds-EG.gds-code = ? or tt-wb-gds-EG.gds-code = 0", no-lock) no-error.
     2127       if bh-wb-gds-EG:available then do:
     2128         message "Не найден товар TH для EGAIS товара AlcCode: " + bh-wb-gds-EG:buffer-field ('alc-code'):buffer-value view-as alert-box.
     2129         return no-apply.
     2130       end.
     2131       egais:SaveWB(bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value).
     2132       if egais:StatusErr
     2133         then message egais:Msg view-as alert-box error.
     2134         else message "Создание накладной завершено" view-as alert-box.
     2135       run f-query.
     2136       run proc-row-disp.
     2137     end.
     2138     when 2 then do:
