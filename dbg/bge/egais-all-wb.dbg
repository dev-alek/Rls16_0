     3813             read-only = true
     3814             sensitive = true
     3815             separators = true
     3816             column-resizable = true
     3817             column-scrolling = true
     3818             triggers:
     3819               on row-display persistent run proc-row-disp.
     3820               on mouse-move-dblclick persistent run msdblcl.
     3821             end triggers
     3822         .
     3823         bh-wb-egais = egais:GetHndlTable(5, "").
     3824         qh-wb-egais:set-buffers (bh-wb-egais).
     3825         qh-wb-egais:query-prepare ("for each tt-wb-hndls by tt-wb-hndls.wb-date descending").
