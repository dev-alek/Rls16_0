     1629   ON VALUE-CHANGED OF T-create IN FRAME Dialog-Frame
     1630   DO:
     1631     ASSIGN
     1632     t-create.
     1633     CASE t-create:
     1634     WHEN YES THEN DO:
     1635       ASSIGN
     1636       t-create-no-th = NO.
     1637       DISPLAY
     1638       t-create-no-th
     1639       WITH FRAME Dialog-Frame.
     1640     END.
     1641     WHEN NO THEN DO:
     1642       ASSIGN
     1643       t-create-no-th = YES.
     1644       DISPLAY
     1645       t-create-no-th
     1646       WITH FRAME Dialog-Frame.
     1647     END.
     1648    END CASE.
     1649   END.
     1650   ON VALUE-CHANGED OF T-create-no-th IN FRAME Dialog-Frame
     1651   DO:
     1652     IF INPUT FRAME Dialog-Frame t-create-no-th = YES THEN DO:
     1653        IF t-create = YES THEN DO:
     1654           MESSAGE
     1655           "Включена опция СОЗДАВАТЬ ОТСУТСТВУЮЩИЕ ПЛАТЕЖИ"
     1656           VIEW-AS ALERT-BOX ERROR.
     1657           t-create-no-th = NO.
     1658           DISPLAY t-create-no-th
     1659           WITH FRAME Dialog-Frame.
     1660        END.
     1661     END.
     1662   END.
