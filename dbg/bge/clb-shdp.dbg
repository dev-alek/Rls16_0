        1   DEFINE TEMP-TABLE temp-schedule-attr NO-UNDO LIKE ub.schedule-attr.
        2   define input PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        3   define input PARAMETER p-curr-host-code LIKE ub.sysconf.host-code NO-UNDO.
        4   define input PARAMETER p-mode           AS CHARACTER NO-UNDO.
        5   define input  parameter p-cre-db-num as integer   no-undo .
        6   define input  parameter p-task-type  as character no-undo .
        7   define input  parameter p-task-num   as integer   no-undo .
        8   define input parameter p-action         as character    no-undo.
        9   define output parameter p-cancel        as logical      no-undo.
       10   define output parameter p-params        as character    no-undo.
       11   define output parameter p-object-list        as character    no-undo.
       12   define output parameter p-doc-type-list      as character    no-undo.
       13   define output parameter p-date-list          as character    no-undo.
       14   define output parameter p-hsch-list          as character    no-undo.
       15   define output parameter p-csch-list          as character    no-undo.
       16   define variable vss-revision    as character no-undo init "$Revision$":U .
       17   define variable vss-author      as character no-undo init "$Author$":U .
       18   define variable vss-date        as character no-undo init "$Date$":U .
       19   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       20   define variable vss-archive     as character no-undo init "$Archive$":U .
       21   define variable vss-description as character no-undo init "Выбор параметров для автоматического эксп/имп фин документов в систему клиент-банк.".
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define new global shared variable g#library  as handle no-undo .
       81   define new global shared variable g#library2 as handle no-undo .
       82   define   shared variable g#auto as logical no-undo.
       83   define   shared variable g#news as logical no-undo.
       84   define   shared variable g#oxml as logical no-undo.
       85   define   shared variable g#esys as logical no-undo.
       86   define   shared variable g#news-source-db as integer no-undo.
       87   define   shared variable g#esys-source-esys as integer no-undo.
       88   define   shared variable g#db-num as integer   no-undo .
       89   define   shared variable g#userid as character no-undo .
       90   define   shared variable g#passwd as character no-undo .
       91   procedure proc-alt-shift-f2:
       92     if not ibs.th.gbl.gbl-var:rcode
       93   then
       94     run gbl\inidebug.p .
       95   end.
       96   procedure proc-alt-shift-f3:
       97     run gbl/prvssinf.p
       98       ( input this-procedure
       99       ) .
      100   end.
      101   define variable v-inform-launched as logical no-undo initial false .
      102   procedure proc-alt-shift-f4:
      103     define variable v-action as character no-undo .
      104     if v-inform-launched = false then do:
      105       assign
      106         v-inform-launched = true
      107       .
      108       run gbl/d-inform.w
      109         (  input self
      110         ,  input this-procedure
      111         , output v-action
      112         ) no-error .
      113       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      114       assign
      115         v-inform-launched = false
      116       .
      117     end.
      118   end.
      119   procedure proc-alt-f1:
      120     run gbl/corrhelp.p
      121       (input this-procedure
      122       ) .
      123   end .
      124   on alt-shift-f2 anywhere do:
      125     run proc-alt-shift-f2.
      126   end.
      127   on alt-shift-f3 anywhere do:
      128     run proc-alt-shift-f3 in this-procedure .
      129   end.
      130   on alt-shift-f4 anywhere do:
      131     run proc-alt-shift-f4 in this-procedure.
      132   end.
      133   on alt-f1 anywhere do:
      134     run proc-alt-f1 in this-procedure .
      135   end.
      136   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137   procedure cur-time :
      138      define output parameter p-today as date      no-undo .
      139      define output parameter p-time  as integer   no-undo .
      140     do
      141     on error undo, return error
      142     :
      143       define variable v-date1 as date      no-undo .
      144       define variable v-date2 as date      no-undo .
      145       define variable v-time  as integer   no-undo .
      146       assign
      147         v-date1 = today
      148         v-time  = time
      149         v-date2 = today
      150       .
      151       if v-date1 <> v-date2
      152       then do:
      153         assign
      154           v-date1 = today
      155           v-time  = v-time
      156         .
      157       end.
      158       assign
      159         p-today = v-date1
      160         p-time  = v-time
      161       .
      162     end.
      163   end.
      164   function cur-time-date returns character
      165   :
      166     return string(today, '99/99/9999':U) .
      167   end.
      168   function cur-time-mjd returns decimal
      169   :
      170     define variable v-date as date      no-undo .
      171     define variable v-time as integer   no-undo .
      172     run cur-time in this-procedure
      173       (output v-date
      174       ,output v-time
      175       ) .
      176     return integer(v-date) - 2400002 + (v-time / 86400) .
      177   end.
      178   function cur-time-get-ending-index returns integer
      179   (input p-number as integer
      180   )
      181   :
      182     if p-number < 0
      183     or p-number = ?
      184     then do:
      185       return 1 .
      186     end.
      187     define variable v-rest as integer   no-undo .
      188     assign
      189       p-number = p-number modulo 100
      190     .
      191     if p-number < 20
      192     then do:
      193       assign
      194         v-rest = p-number
      195       .
      196     end.
      197     else do:
      198       assign
      199         v-rest = p-number modulo 10
      200       .
      201     end.
      202     case v-rest :
      203       when 1
      204       then do:
      205         return 2 .
      206       end.
      207       when 2 or
      208       when 3 or
      209       when 4
      210       then do:
      211         return 3 .
      212       end.
      213       otherwise do:
      214         return 1 .
      215       end.
      216     end case .
      217   end.
      218   procedure cur-time-mjd-to-date :
      219      define input  parameter i-mjd-diff as decimal no-undo.
      220      define output parameter o-Date     as date    no-undo.
      221      define output parameter o-Time     as integer no-undo.
      222      define variable v-day-number as integer   no-undo .
      223      if    i-mjd-diff < 0
      224         or i-mjd-diff = ?
      225      then do:
      226         return "?" .
      227      end.
      228      assign
      229         v-day-number = truncate(i-mjd-diff,0).
      230         o-Date = date(v-day-number + 2400002).
      231         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      232     .
      233   end.
      234   function cur-time-mjd-to-string returns character
      235   (input p-mjd-diff as decimal
      236   )
      237   :
      238     define variable v-day-number as integer   no-undo .
      239     define variable v-seconds    as integer   no-undo .
      240     define variable v-hour       as integer   no-undo .
      241     define variable v-min        as integer   no-undo .
      242     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      243     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      244     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      245     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      246     if p-mjd-diff < 0
      247     or p-mjd-diff = ?
      248     then do:
      249       return "?" .
      250     end.
      251     assign
      252       v-day-number = integer(truncate(p-mjd-diff,0))
      253       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      254     .
      255     if v-seconds > 86400
      256     then do:
      257       assign
      258         v-seconds = 86400 - 1
      259       .
      260     end.
      261     if v-seconds < 0
      262     then do:
      263       assign
      264         v-seconds = 0
      265       .
      266     end.
      267     assign
      268       v-hour = truncate(v-seconds / 3600, 0)
      269     .
      270     assign
      271       v-seconds = v-seconds modulo 3600
      272     .
      273     assign
      274       v-min = truncate(v-seconds / 60, 0)
      275     .
      276     assign
      277       v-seconds = v-seconds modulo 60
      278     .
      279     return
      280         (if v-day-number <> 0
      281           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      282           else ""
      283         )
      284       + (if v-day-number <> 0 or v-hour <> 0
      285           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      286           else ""
      287         )
      288       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      289           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      290           else ""
      291         )
      292       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      293       .
      294   end.
      295   function cur-time-string returns character
      296   :
      297     define variable v-date as date      no-undo .
      298     define variable v-time as integer   no-undo .
      299     run cur-time in this-procedure
      300       (output v-date
      301       ,output v-time
      302       ) .
      303     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      304   end.
      305   function cur-time-string-sec returns character
      306   :
      307     define variable v-date as date      no-undo .
      308     define variable v-time as integer   no-undo .
      309     run cur-time in this-procedure
      310       (output v-date
      311       ,output v-time
      312       ) .
      313     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      314   end.
      315   function cur-time-custom  returns character
      316   (input p-prefix as character
      317   ,input p-date-format as character
      318   ,input p-delimiter as character
      319   ,input p-time-format as character
      320   ,input p-suffix as character
      321   )
      322   :
      323     define variable v-date as date      no-undo .
      324     define variable v-time as integer   no-undo .
      325     run cur-time in this-procedure
      326       (output v-date
      327       ,output v-time
      328       ) .
      329     return
      330       p-prefix
      331       + string(v-date, p-date-format)
      332       + p-delimiter
      333       + string(v-time, p-time-format)
      334       + p-suffix
      335       .
      336   end.
      337   function cur-time-print  returns character
      338   :
      339     define variable v-date as date      no-undo .
      340     define variable v-time as integer   no-undo .
      341     run cur-time in this-procedure
      342       (output v-date
      343       ,output v-time
      344       ) .
      345     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      346   end.
      347   function cur-time-datetime returns datetime
      348   :
      349     define variable v-char as character no-undo .
      350     define variable v-datetime as datetime no-undo .
      351     v-char = cur-time-string().
      352     v-datetime = datetime(v-char).
      353     return  v-datetime.
      354   end.
      355   function cur-time-string-msec returns character
      356   :
      357     define variable v-date as datetime  no-undo .
      358     v-date = now.
      359     return string(v-date) .
      360   end.
      361   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   define temp-table temp-schedule-free no-undo
      363   field free-id as character
      364   field free-task-name as character
      365   field proc-run-name as character
      366   field proc-param-edit-name as character
      367   field conf-param as character
      368   field is-gbd as logical
      369   field is-ubd as logical
      370   field enable-concurrent-0 as logical
      371   field enable-concurrent-db as logical
      372   field other-info as character
      373   field enc-key as character
      374   field is-rum as logical
      375   index pi is unique primary
      376   free-id.
      377   procedure schedule-attr-name :
      378   do
      379     on error undo, return error
      380     :
      381     define input  parameter p-code           as character no-undo .
      382     define output parameter p-type           as character no-undo .
      383     define output parameter p-format         as character no-undo .
      384     define output parameter p-label          as character no-undo .
      385     define output parameter p-user-can-edit  as logical   no-undo .
      386     define output parameter p-output-display as logical   no-undo .
      387     define output parameter p-other          as character no-undo .
      388       if index(p-code, chr(4)) > 0 then do:
      389         p-code = entry(1, p-code, chr(4)).
      390       end.
      391       case p-code :
      392               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      393               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      394               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      395               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      396               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      397               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      398               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      399               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      400               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      401         otherwise do:
      402           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      403         end.
      404       end.
      405     end.
      406   end procedure.
      407   procedure schedule-attr-tooltip :
      408   do
      409     on error undo, return error
      410     :
      411       define input  parameter p-code    as character no-undo .
      412       define output parameter p-tooltip as character no-undo .
      413       define output parameter p-label   as character no-undo .
      414       if index(p-code, chr(4)) > 0 then do:
      415         p-code = entry(1, p-code, chr(4)).
      416       end.
      417       case p-code :
      418               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      419               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      420               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      421               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      422               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      423               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      424               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      425               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      426               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      427         otherwise do:
      428               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      429         end.
      430       end.
      431     end.
      432   end procedure.
      433   procedure schedule-attr-value :
      434   do
      435   on error undo, return error return-value
      436   :
      437   define input parameter  p-cre-db-num as integer    no-undo.
      438   define input parameter  p-task-type  as character  no-undo.
      439   define input parameter  p-task-num   as integer    no-undo.
      440   define input parameter  p-code       as character  no-undo.
      441   define output parameter p-value      as character  no-undo.
      442   define output parameter p-type       as character  no-undo.
      443       define variable v-format         as character no-undo .
      444       define variable v-label          as character no-undo .
      445       define variable v-user-can-edit  as logical   no-undo .
      446       define variable v-output-display as logical   no-undo .
      447       define variable v-other          as character no-undo .
      448       define buffer buf_schedule-attr for ub.schedule-attr.
      449       run schedule-attr-name in this-procedure (
      450             input  p-code
      451           , output p-type
      452           , output v-format
      453           , output v-label
      454           , output v-user-can-edit
      455           , output v-output-display
      456           , output v-other
      457       ) no-error .
      458       if error-status :error
      459       then do:
      460           undo, return error return-value .
      461       end.
      462       if p-code begins ('schd-free-id':U + chr(4))
      463       and entry(2, p-code, chr(4)) = '':U then do:
      464         find first buf_schedule-attr no-lock
      465             where buf_schedule-attr.cre-db-num = p-cre-db-num
      466               and buf_schedule-attr.task-type  = p-task-type
      467               and buf_schedule-attr.task-num   = p-task-num
      468               and buf_schedule-attr.attr-code  begins p-code
      469         no-error .
      470       end.
      471       else do:
      472         find first buf_schedule-attr no-lock
      473             where buf_schedule-attr.cre-db-num = p-cre-db-num
      474               and buf_schedule-attr.task-type  = p-task-type
      475               and buf_schedule-attr.task-num   = p-task-num
      476               and buf_schedule-attr.attr-code  = p-code
      477         no-error .
      478       end.
      479       if available buf_schedule-attr
      480       then do:
      481           assign
      482               p-value = buf_schedule-attr.attr-value
      483           .
      484       end.
      485       else do:
      486         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      487            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      488         end.
      489         else do:
      490           assign
      491               p-value = if p-type = 'L':U then "no":U else ""
      492           .
      493         end.
      494       end.
      495   end.
      496   end procedure.
      497   procedure schedule-attr-write :
      498   do
      499   on error undo, return error
      500   :
      501   define input parameter p-cre-db-num  as integer   no-undo.
      502   define input parameter p-task-type   as character no-undo.
      503   define input parameter p-task-num    as integer   no-undo.
      504   define input parameter p-code        as character no-undo.
      505   define input parameter p-value       as character no-undo.
      506       define variable v-type              as character                no-undo.
      507       define variable v-format            as character                no-undo.
      508       define variable v-label             as character                no-undo.
      509       define variable v-user-can-edit     as logical                  no-undo.
      510       define variable v-output-display    as logical                  no-undo.
      511       define variable v-other             as character                no-undo.
      512       define buffer buf_schedule-attr for ub.schedule-attr .
      513       run schedule-attr-name in this-procedure (
      514             input  p-code
      515           , output v-type
      516           , output v-format
      517           , output v-label
      518           , output v-user-can-edit
      519           , output v-output-display
      520           , output v-other
      521       ) no-error.
      522       if error-status :error
      523       then do:
      524           undo, return error return-value.
      525       end.
      526       find first buf_schedule-attr exclusive-lock
      527            where buf_schedule-attr.cre-db-num = p-cre-db-num
      528              and buf_schedule-attr.task-type  = p-task-type
      529              and buf_schedule-attr.task-num   = p-task-num
      530              and buf_schedule-attr.attr-code  = p-code
      531       no-error.
      532       if not available buf_schedule-attr
      533       then do:
      534           create buf_schedule-attr.
      535           assign
      536             buf_schedule-attr.cre-db-num = p-cre-db-num
      537             buf_schedule-attr.task-type  = p-task-type
      538             buf_schedule-attr.task-num   = p-task-num
      539             buf_schedule-attr.attr-code  = p-code
      540             buf_schedule-attr.attr-value = p-value
      541           .
      542       end.
      543       else do:
      544           assign
      545               buf_schedule-attr.attr-value = p-value
      546           .
      547       end.
      548   end.
      549   end procedure.
      550   procedure schedule-attr-delete :
      551   do
      552   on error undo, return error
      553   :
      554   define input  parameter p-cre-db-num  as integer   no-undo.
      555   define input  parameter p-task-type   as character no-undo.
      556   define input  parameter p-task-num    as integer   no-undo.
      557   define input  parameter p-code        as character no-undo.
      558   define output parameter p-deleted     as logical   no-undo.
      559       define buffer buf_schedule-attr for ub.schedule-attr .
      560       define variable v-type              as character                no-undo.
      561       define variable v-format            as character                no-undo.
      562       define variable v-label             as character                no-undo.
      563       define variable v-user-can-edit     as logical                  no-undo.
      564       define variable v-output-display    as logical                  no-undo.
      565       define variable v-other             as character                no-undo.
      566       run schedule-attr-name in this-procedure (
      567             input p-code
      568           , output v-type
      569           , output v-format
      570           , output v-label
      571           , output v-user-can-edit
      572           , output v-output-display
      573           , output v-other
      574       ) no-error .
      575       if error-status :error
      576       then do:
      577           undo, return error return-value .
      578       end.
      579       find first buf_schedule-attr exclusive-lock
      580            where buf_schedule-attr.cre-db-num = p-cre-db-num
      581              and buf_schedule-attr.task-type  = p-task-type
      582              and buf_schedule-attr.task-num   = p-task-num
      583              and buf_schedule-attr.attr-code  = p-code
      584       no-error.
      585       if not available buf_schedule-attr
      586       then do:
      587           assign
      588               p-deleted = no
      589           .
      590       end.
      591       else do:
      592           delete buf_schedule-attr.
      593           assign
      594               p-deleted = yes
      595           .
      596       end.
      597   end.
      598   end procedure.
      599   procedure schedule-attr-news :
      600   do
      601   on error undo, return error
      602   :
      603       define input  parameter p-code           as character no-undo .
      604       define output parameter p-news           as logical   no-undo .
      605       if index(p-code, chr(4)) > 0 then do:
      606         p-code = entry(1, p-code, chr(4)).
      607       end.
      608       case p-code :
      609               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      610               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      611               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      612               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      613               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      614               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      615               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      616               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      617               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      618         otherwise do:
      619           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      620         end.
      621       end.
      622   end.
      623   end procedure.
      624   procedure schedule-attr-extract-logical :
      625   do
      626   on error undo, return error
      627   :
      628   define input  parameter p-parameter-number   as integer      no-undo.
      629   define input  parameter p-parameter-list     as character    no-undo.
      630   define output parameter p-parameter-value   as logical      no-undo.
      631       if num-entries( p-parameter-list ) > p-parameter-number - 1
      632       then do:
      633           assign
      634               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      635           .
      636       end.
      637       else do:
      638           assign
      639               p-parameter-value   = no
      640           .
      641       end.
      642   end.
      643   end procedure.
      644   procedure schedule-attr-get-free-id :
      645   do
      646   on error undo, return error return-value
      647   :
      648     define input  parameter p-cre-db-num  as integer   no-undo.
      649     define input  parameter p-task-type   as character no-undo.
      650     define input  parameter p-task-num    as integer   no-undo.
      651     define output parameter p-free-id     as character no-undo.
      652     define buffer buf_schedule-attr for ub.schedule-attr.
      653     find first buf_schedule-attr no-lock
      654         where buf_schedule-attr.cre-db-num = p-cre-db-num
      655           and buf_schedule-attr.task-type  = p-task-type
      656           and buf_schedule-attr.task-num   = p-task-num
      657           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      658     no-error .
      659     if available buf_schedule-attr then
      660     assign
      661     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      662     no-error
      663     .
      664   end.
      665   end procedure.
      666   procedure schedule-attr-get-free-props :
      667     define input parameter p-free-id as character no-undo .
      668     define output parameter p-value as character no-undo .
      669     define buffer buf_temp-schedule-free for temp-schedule-free.
      670     do
      671     on error undo, return error return-value
      672     :
      673       find first buf_temp-schedule-free no-lock no-error .
      674       if not available buf_temp-schedule-free then do:
      675         run schedule-attr-fill-free-props in this-procedure .
      676       end.
      677       find first buf_temp-schedule-free where
      678               buf_temp-schedule-free.free-id = p-free-id no-error.
      679       if available buf_temp-schedule-free then do:
      680         assign
      681         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      682                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      683                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      684                   buf_temp-schedule-free.conf-param           + chr(4) +
      685                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      686                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      687                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      688                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      689                   buf_temp-schedule-free.other-info
      690         .
      691       end.
      692       else do:
      693        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      694                              "id произвольной задачи - &5"
      695                              ,vss-workfile
      696                              ,vss-revision
      697                              ,vss-description
      698                              ,chr(10)
      699                              ,p-free-id).
      700       end.
      701     end.
      702   end procedure.
      703   procedure schedule-attr-is-rum-free-id :
      704   define input parameter p-free-id as character no-undo .
      705   define output parameter p-is-rum as logical no-undo .
      706   define buffer buf_temp-schedule-free for temp-schedule-free.
      707   do
      708   on error undo, return error
      709   :
      710       find first buf_temp-schedule-free no-lock no-error .
      711       if not available buf_temp-schedule-free then do:
      712         run schedule-attr-fill-free-props in this-procedure .
      713       end.
      714       find first buf_temp-schedule-free where
      715               buf_temp-schedule-free.free-id = p-free-id no-error.
      716       if available buf_temp-schedule-free
      717       and buf_temp-schedule-free.is-rum
      718       then do:
      719         p-is-rum = yes.
      720       end.
      721   end.
      722   end procedure.
      723   procedure schedule-attr-fill-free-props :
      724   define variable v-path                    as character                no-undo .
      725   DEFINE VARIABLE v-full-path               as character                no-undo .
      726   DEFINE VARIABLE v-file-name               as character                no-undo .
      727   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      728   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      729   define buffer buf_temp-schedule-free for temp-schedule-free.
      730   define variable v-answer as logical no-undo .
      731     do
      732     on error undo, return error substitute("&1 &2 &3&4&5&4"
      733                                           ,vss-workfile
      734                                           ,vss-revision
      735                                           ,vss-description
      736                                           ,chr(10)
      737                                           ,error-status:get-message(1) )
      738     :
      739       run gbl/filename.p (
      740                       input 'cmp/shd-free.d'
      741                     ,output v-full-path
      742                     ,output v-path
      743                     ,output v-file-name
      744                     ,output v-file-name-no-ext
      745                     ,output v-file-name-ext
      746                     ) .
      747       input from value(v-full-path).
      748       repeat :
      749         create buf_temp-schedule-free.
      750         import buf_temp-schedule-free.
      751       END.
      752       input close.
      753       _ff:
      754       for each buf_temp-schedule-free :
      755         if buf_temp-schedule-free.free-id = '':U then do:
      756            delete buf_temp-schedule-free.
      757            next _ff.
      758          end.
      759          run schedule-attr-check-enc in this-procedure (
      760                                                       input  buf_temp-schedule-free.free-id
      761                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      762                                                               buf_temp-schedule-free.proc-param-edit-name +
      763                                                               buf_temp-schedule-free.conf-param +
      764                                                               string(buf_temp-schedule-free.is-gbd) +
      765                                                               string(buf_temp-schedule-free.is-ubd) +
      766                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      767                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      768                                                               string(buf_temp-schedule-free.other-info)
      769                                                               )
      770                                                       ,input  buf_temp-schedule-free.enc-key
      771                                                       ,output v-answer    ) no-error .
      772          if error-status:error
      773          or not v-answer then delete buf_temp-schedule-free.
      774        end.
      775     end.
      776   end procedure.
      777   Function schedule-attr-reverse returns character (str as character).
      778      define variable rev_incl_s as character init "" no-undo .
      779      define variable rev_incl_i as integer no-undo .
      780      define variable rev_incl_l as integer no-undo .
      781      rev_incl_l = length(str).
      782      do rev_incl_i = 1 to rev_incl_l:
      783         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      784      end.
      785      return rev_incl_s.
      786   end.
      787   procedure schedule-attr-check-enc.
      788     define input  parameter p-free-id   as character no-undo .
      789     define input  parameter p-value     as character no-undo .
      790     define input  parameter p-enc-value as character no-undo .
      791     define output parameter p-answer    as logical   no-undo .
      792     define variable tmp         as character no-undo .
      793     define variable v-enc-value as character no-undo .
      794     assign
      795     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      796     .
      797     run schedule-attr-pswd-enc in this-procedure
      798       ( input tmp
      799        ,output v-enc-value
      800       ) no-error .
      801     if error-status:error then do:
      802       message
      803         vss-workfile vss-revision vss-description skip
      804         "Ошибка при вызове процедуры pswd-enc" skip
      805         return-value skip
      806         error-status :get-message(1) skip
      807         view-as alert-box error .
      808       undo, return error .
      809     end.
      810     if v-enc-value = p-enc-value then do:
      811       assign
      812         p-answer = true
      813       .
      814     end.
      815     else do:
      816       assign
      817         p-answer = false
      818       .
      819     end.
      820   end.
      821   procedure schedule-attr-conf-enc.
      822     define input  parameter p-free-id   as character no-undo .
      823     define input  parameter p-value     as character no-undo .
      824     define output parameter p-enc-value as character no-undo .
      825     define variable tmp         as character no-undo .
      826     assign
      827       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      828     .
      829     run schedule-attr-pswd-enc in this-procedure
      830       ( input tmp
      831        ,output p-enc-value
      832       ) no-error .
      833     if error-status:error then do:
      834       message
      835         vss-workfile vss-revision vss-description skip
      836         "Ошибка при вызове процедуры pswd-enc" skip
      837         return-value skip
      838         error-status :get-message(1) skip
      839         view-as alert-box error .
      840       undo, return error .
      841     end.
      842   end procedure.
      843   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      844   procedure schedule-attr-pswd-enc :
      845     define input parameter  pswd     as character no-undo .
      846     define output parameter enc-pswd as character no-undo .
      847     do
      848     on error undo, return error return-value
      849     :
      850       assign
      851         enc-pswd = encode(pswd + string(index(pswd, "k")))
      852       .
      853     end.
      854   end procedure.
      855   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      856     define variable v-cntxt-db-num        as integer   no-undo .
      857     define variable v-cntxt-userid        as character no-undo .
      858     define variable v-cntxt-level         as character no-undo .
      859     define variable v-cntxt-host-code-obj as integer   no-undo .
      860     define variable v-cntxt-obj-type      as character no-undo .
      861     define variable v-cntxt-obj-code      as integer   no-undo .
      862     define variable v-cntxt-db-num-obj    as integer   no-undo .
      863     define variable v-cntxt-is-admin      as logical   no-undo .
      864   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      865   define   temp-table temp_obj-list no-undo
      866       field obj-type as character
      867       field obj-code as integer
      868       index pi is primary unique obj-type obj-code
      869   .
      870   DEFINE   TEMP-TABLE temp_hfin-schet NO-UNDO LIKE ub.fin-schet
      871   .
      872   DEFINE   TEMP-TABLE temp_cfin-schet NO-UNDO LIKE ub.fin-schet
      873   .
      874   define temp-table temp-bik no-undo
      875   field host-code like ub.sysconf.host-code
      876   field code-bank like ub.fin-bank.code-bank
      877   field bik       like ub.fin-bank.bik
      878   field f_name    as character
      879   field o_name    as character
      880   field d-count    as integer
      881   field adresat as character
      882   index pi is unique primary
      883   host-code
      884   bik
      885   .
      886   procedure init-host-list :
      887   define input parameter p-host-list as character no-undo .
      888   define variable v-counter as integer no-undo .
      889   define buffer buf_temp_obj-list for temp_obj-list.
      890     do
      891     on error undo, return error
      892     :
      893     for each buf_temp_obj-list
      894     :
      895         delete buf_temp_obj-list.
      896     end.
      897     do v-counter = 1 to num-entries( p-host-list ) / 2
      898     :
      899         create buf_temp_obj-list.
      900         assign
      901             buf_temp_obj-list.obj-type = entry( 2 * v-counter - 1,  p-host-list )
      902             buf_temp_obj-list.obj-code = integer( entry( 2 * v-counter,      p-host-list ) )
      903         .
      904     end.
      905     end.
      906   end procedure.
      907   procedure fill-hfin-schet :
      908   define input parameter p-hfin-schet as character no-undo .
      909   define variable v-counter as integer no-undo .
      910   define buffer buf_temp_hfin-schet for temp_hfin-schet.
      911     do
      912     on error undo, return error return-value
      913     :
      914         for each buf_temp_hfin-schet
      915         :
      916             delete buf_temp_hfin-schet.
      917         end.
      918         do v-counter = 1 to num-entries( p-hfin-schet ) / 6
      919         :
      920             create buf_temp_hfin-schet.
      921             assign
      922             buf_temp_hfin-schet.host-code = integer( entry( 6 * v-counter - 5,      p-hfin-schet ) )
      923             buf_temp_hfin-schet.r-schet = entry( 6 * v-counter - 4,  p-hfin-schet )
      924             buf_temp_hfin-schet.cli-type =  entry( 6 * v-counter - 3,      p-hfin-schet )
      925             buf_temp_hfin-schet.cli-code = integer( entry( 6 * v-counter - 2,      p-hfin-schet ) )
      926             buf_temp_hfin-schet.code-bank = integer( entry( 6 * v-counter - 1,      p-hfin-schet ) )
      927             buf_temp_hfin-schet.code-schet = integer( entry( 6 * v-counter,      p-hfin-schet ) )
      928             .
      929         end.
      930     end.
      931   end procedure.
      932   procedure fill-cfin-schet :
      933   define input parameter p-cfin-schet as character no-undo .
      934   define variable v-counter as integer no-undo .
      935   define buffer buf_temp_cfin-schet for temp_cfin-schet.
      936     do
      937     on error undo, return error return-value
      938     :
      939         for each buf_temp_cfin-schet
      940         :
      941             delete buf_temp_cfin-schet.
      942         end.
      943         do v-counter = 1 to num-entries( p-cfin-schet ) / 6
      944         :
      945             create buf_temp_cfin-schet.
      946             assign
      947             buf_temp_cfin-schet.host-code = integer( entry( 6 * v-counter - 5,      p-cfin-schet ) )
      948             buf_temp_cfin-schet.r-schet = entry( 6 * v-counter - 4,  p-cfin-schet )
      949             buf_temp_cfin-schet.cli-type =  entry( 6 * v-counter - 3,      p-cfin-schet )
      950             buf_temp_cfin-schet.cli-code = integer( entry( 6 * v-counter - 2,      p-cfin-schet ) )
      951             buf_temp_cfin-schet.code-bank = integer( entry( 6 * v-counter - 1,      p-cfin-schet ) )
      952             buf_temp_cfin-schet.code-schet = integer( entry( 6 * v-counter,      p-cfin-schet ) )
      953             .
      954         end.
      955     end.
      956   end procedure.
      957   define variable v-host-list              as character    no-undo.
      958   define variable v-hsch-list              as character    no-undo.
      959   define variable v-csch-list              as character    no-undo.
      960   define variable v-host-name             as character    no-undo.
      961   dEFINE variable v-param-type            as character    no-undo.
      962   define variable v-today                 as date         no-undo.
      963   define variable v-time                  as integer      no-undo.
      964   define variable v-init-doc-type-list    as character    no-undo.
      965   define variable v-doc-type-list         as character    no-undo.
      966   define variable v-ext-fin-doc-type-list as character extent 2 init
      967   [
      968       "расходное платежное поручение",             'рпп':U
      969   ]                                                           no-undo.
      970   DEFINE BUTTON b-help
      971        LABEL "Помо&щь"
      972        SIZE 10 BY 1.
      973   DEFINE BUTTON bt-sel-csch
      974        IMAGE-UP FILE "btn-down-arrow":U
      975        IMAGE-DOWN FILE "btn-down-arrow":U
      976        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      977        LABEL "..."
      978        SIZE 3.6 BY 1.03.
      979   DEFINE BUTTON bt-sel-doc-type
      980        IMAGE-UP FILE "btn-down-arrow":U
      981        IMAGE-DOWN FILE "btn-down-arrow":U
      982        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      983        LABEL "..."
      984        SIZE 3.6 BY 1.03.
      985   DEFINE BUTTON bt-sel-host
      986        IMAGE-UP FILE "btn-down-arrow":U
      987        IMAGE-DOWN FILE "btn-down-arrow":U
      988        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      989        LABEL "..."
      990        SIZE 3.6 BY 1.03.
      991   DEFINE BUTTON bt-sel-hsch
      992        IMAGE-UP FILE "btn-down-arrow":U
      993        IMAGE-DOWN FILE "btn-down-arrow":U
      994        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      995        LABEL "..."
      996        SIZE 3.6 BY 1.03.
      997   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      998        LABEL "&Отмена"
      999        SIZE 10 BY 1
     1000        BGCOLOR 8 .
     1001   DEFINE BUTTON Btn_OK DEFAULT
     1002        LABEL "&Ввод"
     1003        SIZE 10 BY 1
     1004        BGCOLOR 8 .
     1005   DEFINE VARIABLE ed-csch AS CHARACTER
     1006        VIEW-AS EDITOR NO-BOX
     1007        SIZE 50 BY 2.77
     1008        FGCOLOR 1  NO-UNDO.
     1009   DEFINE VARIABLE ED-doc-type AS CHARACTER INITIAL "Все"
     1010        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
     1011        SIZE 50 BY 2.77 NO-UNDO.
     1012   DEFINE VARIABLE ed-host AS CHARACTER
     1013        VIEW-AS EDITOR NO-BOX
     1014        SIZE 20.3 BY 2.77
     1015        FGCOLOR 1  NO-UNDO.
     1016   DEFINE VARIABLE ed-hsch AS CHARACTER
     1017        VIEW-AS EDITOR NO-BOX
     1018        SIZE 50 BY 2.77
     1019        FGCOLOR 1  NO-UNDO.
     1020   DEFINE VARIABLE f-doc-type-label AS CHARACTER FORMAT "X(256)":U INITIAL "Типы документов"
     1021         VIEW-AS TEXT
     1022        SIZE 15.5 BY .77 NO-UNDO.
     1023   DEFINE VARIABLE f-t-create-1 AS CHARACTER FORMAT "X(256)":U INITIAL "отсутствующие"
     1024         VIEW-AS TEXT
     1025        SIZE 15.5 BY .77 NO-UNDO.
     1026   DEFINE VARIABLE f-t-create-2 AS CHARACTER FORMAT "X(256)":U INITIAL "платежи"
     1027         VIEW-AS TEXT
     1028        SIZE 15.5 BY .77 NO-UNDO.
     1029   DEFINE VARIABLE f-t-create-3 AS CHARACTER FORMAT "X(256)":U INITIAL "платежей"
     1030         VIEW-AS TEXT
     1031        SIZE 15.5 BY .77 NO-UNDO.
     1032   DEFINE VARIABLE f-t-create-4 AS CHARACTER FORMAT "X(256)":U INITIAL "создавать"
     1033         VIEW-AS TEXT
     1034        SIZE 15.5 BY .77 NO-UNDO.
     1035   DEFINE VARIABLE f-t-create-5 AS CHARACTER FORMAT "X(256)":U INITIAL "строки выписки"
     1036         VIEW-AS TEXT
     1037        SIZE 15.5 BY .77 NO-UNDO.
     1038   DEFINE VARIABLE fi-date-from AS DATE FORMAT "99/99/9999":U
     1039        LABEL "Дата с"
     1040        VIEW-AS FILL-IN
     1041        SIZE 12 BY 1 NO-UNDO.
     1042   DEFINE VARIABLE fi-date-to AS DATE FORMAT "99/99/9999":U
     1043        LABEL "по"
     1044        VIEW-AS FILL-IN
     1045        SIZE 12 BY 1 NO-UNDO.
     1046   DEFINE VARIABLE fi-dates-title AS CHARACTER FORMAT "X(256)":U INITIAL " Выбор диапазона дат"
     1047         VIEW-AS TEXT
     1048        SIZE 21.6 BY .67 NO-UNDO.
     1049   DEFINE VARIABLE fi-days-ago AS INTEGER FORMAT ">>>9":U INITIAL 0
     1050        LABEL "Дней назад"
     1051        VIEW-AS FILL-IN
     1052        SIZE 5.4 BY 1 NO-UNDO.
     1053   DEFINE VARIABLE fi-days-amount AS INTEGER FORMAT ">>>9":U INITIAL 0
     1054        LABEL "Количество дней"
     1055        VIEW-AS FILL-IN
     1056        SIZE 5.4 BY 1 NO-UNDO.
     1057   DEFINE VARIABLE fi-encoding-select AS CHARACTER FORMAT "X(256)":U INITIAL "Выбор кодировки"
     1058         VIEW-AS TEXT
     1059        SIZE 19.5 BY .67 NO-UNDO.
     1060   DEFINE VARIABLE fi-format-select AS CHARACTER FORMAT "X(256)":U INITIAL " Выбор формата обмена"
     1061         VIEW-AS TEXT
     1062        SIZE 23.5 BY .67 NO-UNDO.
     1063   DEFINE VARIABLE rs-1 AS INTEGER
     1064        VIEW-AS RADIO-SET VERTICAL
     1065        RADIO-BUTTONS
     1066             "все фирмы", 1,
     1067   "выбранная фирма", 2
     1068        SIZE 19 BY 2.27 NO-UNDO.
     1069   DEFINE VARIABLE RS-action AS CHARACTER INITIAL "exp"
     1070        VIEW-AS RADIO-SET HORIZONTAL
     1071        RADIO-BUTTONS
     1072             "Экспорт", "exp",
     1073   "Импорт", "imp"
     1074        SIZE 39.5 BY 1 NO-UNDO.
     1075   DEFINE VARIABLE rs-csch AS INTEGER
     1076        VIEW-AS RADIO-SET VERTICAL
     1077        RADIO-BUTTONS
     1078             "все счета контраг.", 1,
     1079   "счета выборочно", 2
     1080        SIZE 21 BY 2.27 NO-UNDO.
     1081   DEFINE VARIABLE rs-date AS INTEGER
     1082        VIEW-AS RADIO-SET VERTICAL
     1083        RADIO-BUTTONS
     1084             "за прошлые дни", 0,
     1085   "по текущую", 1,
     1086   "интервал", 2
     1087        SIZE 19.4 BY 3.27 NO-UNDO.
     1088   DEFINE VARIABLE RS-encoding AS CHARACTER
     1089        VIEW-AS RADIO-SET VERTICAL
     1090        RADIO-BUTTONS
     1091             "DOS", "IBM866",
     1092   "Windows", "Windows-1251"
     1093        SIZE 16.5 BY 3.5 NO-UNDO.
     1094   DEFINE VARIABLE RS-format AS CHARACTER
     1095        VIEW-AS RADIO-SET VERTICAL
     1096        RADIO-BUTTONS
     1097             "Item 1", "1"
     1098        SIZE 27.5 BY 3.27 NO-UNDO.
     1099   DEFINE VARIABLE rs-hsch AS INTEGER
     1100        VIEW-AS RADIO-SET VERTICAL
     1101        RADIO-BUTTONS
     1102             "все счета фирмы", 1,
     1103   "счета выборочно", 2
     1104        SIZE 18 BY 2.27 NO-UNDO.
     1105   DEFINE RECTANGLE rct-dates
     1106        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1107        SIZE 76.5 BY 4.47.
     1108   DEFINE RECTANGLE rct-host
     1109        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1110        SIZE 48.5 BY 3.5.
     1111   DEFINE RECTANGLE rct-host-2
     1112        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1113        SIZE 76.5 BY 3.5.
     1114   DEFINE RECTANGLE rct-host-3
     1115        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1116        SIZE 76.5 BY 3.5.
     1117   DEFINE VARIABLE T-create AS LOGICAL INITIAL no
     1118        LABEL "Создавать"
     1119        VIEW-AS TOGGLE-BOX
     1120        SIZE 19.5 BY 1 NO-UNDO.
     1121   DEFINE VARIABLE T-create-no-th AS LOGICAL INITIAL no
     1122        LABEL "Для отсутствующих"
     1123        VIEW-AS TOGGLE-BOX
     1124        SIZE 19.5 BY 1 NO-UNDO.
     1125   DEFINE FRAME Dialog-Frame
     1126        Btn_OK AT ROW 1 COL 1
     1127        Btn_Cancel AT ROW 1 COL 11
     1128        RS-action AT ROW 1 COL 28.5 NO-LABEL
     1129        b-help AT ROW 1 COL 71
     1130        RS-encoding AT ROW 2.5 COL 31.5 NO-LABEL
     1131        RS-format AT ROW 2.77 COL 2 NO-LABEL
     1132        ed-host AT ROW 2.77 COL 78 NO-LABEL
     1133        rs-1 AT ROW 3 COL 52 NO-LABEL
     1134        bt-sel-host AT ROW 4.27 COL 72.5
     1135        rs-hsch AT ROW 6.5 COL 2.5 NO-LABEL
     1136        ed-hsch AT ROW 6.5 COL 27.5 NO-LABEL
     1137        T-create AT ROW 7.27 COL 79.5
     1138        bt-sel-hsch AT ROW 7.77 COL 23
     1139        rs-csch AT ROW 10.27 COL 3 NO-LABEL
     1140        ed-csch AT ROW 10.27 COL 28 NO-LABEL
     1141        T-create-no-th AT ROW 10.33 COL 79.5
     1142        bt-sel-csch AT ROW 11.5 COL 23.5
     1143        fi-days-amount AT ROW 14.27 COL 41.8 COLON-ALIGNED
     1144        rs-date AT ROW 14.57 COL 3.5 NO-LABEL
     1145        fi-days-ago AT ROW 15.47 COL 41.8 COLON-ALIGNED
     1146        fi-date-from AT ROW 16.7 COL 30.6 COLON-ALIGNED
     1147        fi-date-to AT ROW 16.77 COL 47.4 COLON-ALIGNED
     1148        ED-doc-type AT ROW 18.27 COL 22 NO-LABEL
     1149        bt-sel-doc-type AT ROW 18.77 COL 18.5
     1150        fi-format-select AT ROW 2 COL 2 NO-LABEL
     1151        fi-encoding-select AT ROW 2 COL 30.5 NO-LABEL
     1152        f-t-create-1 AT ROW 8.27 COL 79.5 NO-LABEL
     1153        f-t-create-2 AT ROW 9 COL 79.5 NO-LABEL
     1154        f-t-create-3 AT ROW 11.33 COL 79.5 NO-LABEL
     1155        f-t-create-4 AT ROW 12.07 COL 79.5 NO-LABEL
     1156        f-t-create-5 AT ROW 13 COL 79.5 NO-LABEL
     1157        fi-dates-title AT ROW 13.5 COL 3 NO-LABEL
     1158        f-doc-type-label AT ROW 18.77 COL 2.5 NO-LABEL
     1159        rct-host AT ROW 2.5 COL 50.5
     1160        rct-host-2 AT ROW 6.27 COL 2
     1161        rct-host-3 AT ROW 10 COL 2
     1162        rct-dates AT ROW 13.7 COL 2
     1163        SPACE(20.50) SKIP(3.16)
     1164       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1165            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1166            TITLE "Параметры эксп.-имп. фин документов в систему КЛИЕНТ-БАНК"
     1167            CANCEL-BUTTON Btn_Cancel.
     1168   ASSIGN
     1169          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1170          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1171   ASSIGN
     1172          ED-doc-type:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1173   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1174   DO:
     1175     APPLY "END-ERROR":U TO SELF.
     1176   END.
     1177   ON CHOOSE OF bt-sel-csch IN FRAME Dialog-Frame
     1178   DO:
     1179    define variable v-rid-list as character no-undo.
     1180   define variable v-status_ like ub.fin-schet.status_ no-undo init 'тек':U.
     1181   DEFINE VARIABLE v-sch-list AS CHARACTER NO-UNDO.
     1182   define buffer buf_temp_obj-list for temp_obj-list.
     1183   define variable v-host-code like ub.sysconf.host-code no-undo .
     1184       assign
     1185           rs-csch :screen-value  = "2"
     1186       .
     1187       if p-mode = 'shd':U then do:
     1188         find first buf_temp_obj-list no-error .
     1189         if not available buf_temp_obj-list then do:
     1190           message
     1191           "Не выбрана фирма"
     1192           view-as alert-box error .
     1193           return no-apply.
     1194         end.
     1195         assign
     1196         v-host-code = buf_temp_obj-list.obj-code.
     1197       end.
     1198       else do:
     1199         assign
     1200         v-host-code = p-curr-host-code.
     1201       end.
     1202       run ref/finschts.w (
     1203                 INPUT parparentproc
     1204                 ,INPUT v-host-code
     1205                 ,input "b-sel,b-mark":U
     1206                 ,input 'фирма':U
     1207                 ,input '':U
     1208                 ,input 0
     1209                 ,input ?
     1210                 ,input v-host-code
     1211                 ,input 0
     1212                 ,input-output v-status_
     1213                 ,input-output v-rid-list
     1214   ) no-error.
     1215       run fill-sch-list in this-procedure ( input v-rid-list, INPUT 'фирма':U, OUTPUT v-sch-list ) no-error .
     1216       if error-status :error
     1217       then do:
     1218           return no-apply.
     1219       end.
     1220       ASSIGN
     1221           ed-csch :screen-value = v-sch-list
     1222           ed-csch
     1223       .
     1224   END.
     1225   ON CHOOSE OF bt-sel-doc-type IN FRAME Dialog-Frame
     1226   DO:
     1227       define variable v-cancel     as logical           no-undo.
     1228       define variable v-oper-num   as integer           no-undo.
     1229       define variable v-doc-type-select as character no-undo .
     1230       assign
     1231       v-doc-type-select = "fin-doc-bank":U
     1232       .
     1233       run bge/bgeseltp.w (
     1234             input v-doc-type-select
     1235           , input v-init-doc-type-list
     1236           , output v-doc-type-list
     1237           , output v-cancel
     1238       ) no-error.
     1239       if error-status :error
     1240       then do:
     1241           message
     1242             vss-workfile vss-revision vss-description
     1243             skip "Ошибка выбора типов операций."
     1244             skip return-value
     1245             skip trim(error-status :get-message(1))
     1246                  trim(error-status :get-message(2))
     1247                  trim(error-status :get-message(3))
     1248                  trim(error-status :get-message(4))
     1249                  trim(error-status :get-message(5))
     1250           view-as alert-box error.
     1251           undo, return no-apply .
     1252       end.
     1253       if v-cancel = yes
     1254       then do:
     1255           assign
     1256               v-doc-type-list = v-init-doc-type-list
     1257           .
     1258       end.
     1259       else do:
     1260           assign
     1261               v-init-doc-type-list    = v-doc-type-list
     1262           .
     1263           if v-doc-type-list = ''
     1264           then do:
     1265               assign
     1266                   ed-doc-type :screen-value in frame Dialog-Frame = "Все"
     1267                   ed-doc-type
     1268               .
     1269           end.
     1270           else do:
     1271               assign
     1272                   ed-doc-type :screen-value in frame Dialog-Frame = ''
     1273                   ed-doc-type
     1274               .
     1275               do v-oper-num = 1 to 1
     1276               :
     1277                   if lookup( v-ext-fin-doc-type-list [v-oper-num * 2], v-init-doc-type-list ) <> 0
     1278                   then do:
     1279                       assign
     1280                           ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
     1281                                                       + v-ext-fin-doc-type-list [v-oper-num * 2 - 1] + chr(10)
     1282                           ed-doc-type
     1283                       .
     1284                   end.
     1285               end.
     1286           end.
     1287       end.
     1288   END.
     1289   ON CHOOSE OF bt-sel-host IN FRAME Dialog-Frame
     1290   DO:
     1291      define variable v-firm-code like ub.sysconf.host-code no-undo .
     1292      DEFINE VARIABLE v-rec-list AS CHARACTER NO-UNDO.
     1293       assign
     1294           rs-1 :screen-value  = "2"
     1295       .
     1296       define buffer buf_sysconf      for ub.sysconf.
     1297       find first buf_sysconf no-lock
     1298            where buf_sysconf.host-code = p-curr-host-code
     1299       no-error .
     1300       if available buf_sysconf
     1301       then do:
     1302             assign
     1303               v-host-list = string( recid( buf_sysconf ) )
     1304           .
     1305       end.
     1306       run adm/sconfs.w (
     1307             input parparentproc
     1308           , input "b-sel":U
     1309           , input no
     1310           , input p-curr-host-code
     1311           , output v-firm-code
     1312           , input-output v-rec-list
     1313       ) no-error.
     1314       run fill-host-list in this-procedure ( input v-rec-list, OUTPUT v-host-list ) no-error .
     1315       if error-status :error
     1316       then do:
     1317           return no-apply.
     1318       end.
     1319       assign
     1320           ed-host :screen-value = v-host-list
     1321           ed-host
     1322       .
     1323   END.
     1324   ON CHOOSE OF bt-sel-hsch IN FRAME Dialog-Frame
     1325   DO:
     1326    define variable v-rid-list as character no-undo.
     1327   define variable v-status_ like ub.fin-schet.status_ no-undo init 'тек':U.
     1328   DEFINE VARIABLE v-sch-list AS CHARACTER NO-UNDO.
     1329   define variable v-host-code like ub.sysconf.host-code no-undo .
     1330   define buffer buf_temp_obj-list for temp_obj-list.
     1331       assign
     1332           rs-hsch :screen-value  = "2"
     1333       .
     1334       if p-mode = 'shd':U then do:
     1335         find first buf_temp_obj-list no-error .
     1336         if not available buf_temp_obj-list then do:
     1337           message
     1338           "Не выбрана фирма"
     1339           view-as alert-box error .
     1340           return no-apply.
     1341         end.
     1342         assign
     1343         v-host-code = buf_temp_obj-list.obj-code.
     1344       end.
     1345       else do:
     1346         assign
     1347         v-host-code = p-curr-host-code.
     1348       end.
     1349           run ref/finschts.w (
     1350                     INPUT parparentproc
     1351                     ,INPUT v-host-code
     1352                     ,input "b-sel,b-mark":U
     1353                     ,input "company-host":U
     1354                     ,input 'орг':U
     1355                     ,input v-host-code
     1356                     ,input ?
     1357                     ,input v-host-code
     1358                     ,input 0
     1359                     ,input-output v-status_
     1360                     ,input-output v-rid-list
     1361       ) no-error.
     1362       run fill-sch-list in this-procedure ( input v-rid-list, INPUT "company-host", OUTPUT v-sch-list ) no-error .
     1363       if error-status :error
     1364       then do:
     1365           return no-apply.
     1366       end.
     1367       ASSIGN
     1368           ed-hsch :screen-value = v-sch-list
     1369           ed-hsch
     1370       .
     1371   END.
     1372   ON CHOOSE OF Btn_Cancel IN FRAME Dialog-Frame
     1373   DO:
     1374       assign
     1375           p-cancel = yes
     1376       .
     1377   END.
     1378   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     1379   DO:
     1380       define variable v-obj-list as character     no-undo.
     1381       define variable v-deleted as logical     no-undo.
     1382       DEFINE BUFFER buf_schedule-attr FOR ub.schedule-attr.
     1383       DEFINE BUFFER buf_temp-schedule-attr FOR temp-schedule-attr.
     1384       if p-mode = 'shd':U then
     1385       assign
     1386       rs-action
     1387       rs-1
     1388       .
     1389       IF rs-format:SENSITIVE IN FRAME Dialog-Frame THEN
     1390       ASSIGN
     1391       rs-format
     1392       .
     1393       IF rs-action = 'exp' THEN DO:
     1394           ASSIGN
     1395           t-create
     1396           rs-encoding
     1397           rs-date
     1398           fi-days-amount
     1399           fi-days-ago
     1400           fi-date-from
     1401           fi-date-to
     1402           rs-hsch
     1403           rs-csch
     1404           .
     1405       END.
     1406       IF rs-action = 'imp' THEN DO:
     1407           ASSIGN
     1408           t-create
     1409           t-create-no-th
     1410           rs-encoding
     1411           rs-hsch
     1412           .
     1413       END.
     1414       case rs-1
     1415       :
     1416       when 1
     1417       then do:
     1418           assign
     1419               v-host-list = ""
     1420           .
     1421       end.
     1422       when 2
     1423       then do:
     1424           assign
     1425               v-host-list = ""
     1426           .
     1427           for each temp_obj-list
     1428           :
     1429               assign
     1430                   v-host-list = v-host-list
     1431                           + ( if v-host-list = "" then "" else "," ) + temp_obj-list.obj-type
     1432                           + "," + string( temp_obj-list.obj-code )
     1433               .
     1434           end.
     1435       end.
     1436       end case.
     1437       find first temp_obj-list no-error.
     1438       if not available temp_obj-list
     1439       and rs-1 = 2
     1440       then do:
     1441           message
     1442               "Не выбраны фирмы для эксп/имп финдокументов в КЛИЕНТ-БАНК."
     1443           view-as alert-box warning.
     1444           undo, return no-apply.
     1445       end.
     1446       CASE rs-hsch
     1447       :
     1448       when 1
     1449       then do:
     1450           assign
     1451               v-hsch-list = ""
     1452           .
     1453       end.
     1454       when 2
     1455       then do:
     1456           assign
     1457               v-hsch-list = ""
     1458           .
     1459           for each temp_hfin-schet
     1460           :
     1461               assign
     1462                   v-hsch-list = v-hsch-list
     1463                           + ( if v-hsch-list = "" then "" else "," )  +  string(temp_hfin-schet.host-code)
     1464                           + "," + temp_hfin-schet.r-schet
     1465                           + "," + string( temp_hfin-schet.cli-type )
     1466                           + "," + string( temp_hfin-schet.cli-code )
     1467                           + "," + string( temp_hfin-schet.code-bank )
     1468                           + "," + string( temp_hfin-schet.code-schet )
     1469               .
     1470           end.
     1471       end.
     1472       end case.
     1473       find first temp_hfin-schet no-error.
     1474       if not available temp_hfin-schet
     1475       and rs-hsch = 2
     1476       then do:
     1477           message
     1478               "Не выбраны счета СВОЕЙ фирмы для эксп/имп финдокументов в КЛИЕНТ-БАНК."
     1479           view-as alert-box warning.
     1480           undo, return no-apply.
     1481       end.
     1482   CASE rs-csch
     1483       :
     1484       when 1
     1485       then do:
     1486           assign
     1487               v-csch-list = ""
     1488           .
     1489       end.
     1490       when 2
     1491       then do:
     1492           assign
     1493               v-csch-list = ""
     1494           .
     1495           for each temp_cfin-schet
     1496           :
     1497               assign
     1498                   v-csch-list = v-csch-list
     1499                           + ( if v-csch-list = "" then "" else "," ) +  string(temp_cfin-schet.host-code)
     1500                           + "," + temp_cfin-schet.r-schet
     1501                           + "," + string( temp_cfin-schet.cli-type )
     1502                           + "," + string( temp_cfin-schet.cli-code )
     1503                           + "," + string( temp_cfin-schet.code-bank )
     1504                           + "," + string( temp_cfin-schet.code-schet )
     1505               .
     1506           end.
     1507       end.
     1508       end case.
     1509       find first temp_cfin-schet no-error.
     1510       if not available temp_cfin-schet
     1511       and rs-csch = 2
     1512       then do:
     1513           message
     1514               "Не выбраны счета КОНТРАГЕНТОВ для эксп/имп финдокументов в КЛИЕНТ-БАНК."
     1515           view-as alert-box warning.
     1516           undo, return no-apply.
     1517       end.
     1518       CASE rs-date:
     1519         when 0 then do:
     1520         end.
     1521         when 1
     1522         then do:
     1523            if fi-date-from = ? then do:
     1524              message
     1525              "Неверно задана дата начала"
     1526              view-as alert-box error .
     1527              return no-apply.
     1528            end.
     1529         end.
     1530         when 2 then do:
     1531            if fi-date-from > fi-date-to then do:
     1532              message
     1533              "Неверно задан диапазон дат"
     1534              view-as alert-box error .
     1535              return no-apply.
     1536            end.
     1537         end.
     1538       END CASE.
     1539       run attach-attr-to-schedule-line in this-procedure (
     1540             INPUT rs-format
     1541           , INPUT rs-encoding
     1542           , input rs-date
     1543           , input fi-days-amount
     1544           , input fi-days-ago
