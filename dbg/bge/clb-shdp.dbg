     2134   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2135   procedure minbtn-set :
     2136       do
     2137           on error undo, return error return-value
     2138           :
     2139           define variable ii              as integer       no-undo .
     2140           define variable fh              as widget-handle no-undo .
     2141           define variable hh              as widget-handle no-undo .
     2142           define variable v-h             as handle        extent 4 no-undo .
     2143           define variable v-name-button   as character     no-undo .
     2144           define variable v-help-old-x    as decimal       no-undo .
     2145           define variable v-help-old-y    as decimal       no-undo .
     2146           define variable v-help-old-size as decimal       no-undo .
     2147           define variable v-frame-width   as decimal       no-undo .
     2148           define variable jj              as integer       no-undo .
     2149           do
     2150               on error undo, return error
     2151               :
     2152               assign
     2153                   v-frame-width = frame Dialog-Frame:width - 0.3
     2154                   fh            = frame Dialog-Frame:first-child
     2155                   hh            = fh:first-child
     2156                   ii            = 1
     2157                   .
     2158               do while valid-handle(hh):
     2159                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2160                   do:
     2161                       case lc(hh:name) :
     2162                           when "b-help" then
     2163                               do:
     2164                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2165                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2166                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2167                                   hh:TOOLTIP = "Помощь" .
     2168                                   v-help-old-x = hh:column .
     2169                                   v-help-old-y = hh:row    .
     2170                                   v-help-old-size = hh:width .
     2171                                   hh:width-chars = 2.5 .
     2172                               end.
     2173                           when "b-print" then
     2174                               do:
     2175                                   hh:load-image("cmp/b-print.bmp":u) .
     2176                                   hh:TOOLTIP = "Печать" .
     2177                                   v-h[ii] = hh:handle .
     2178                                   ii = ii + 1 .
     2179                                   hh:width-chars = 3 .
     2180                               end.
     2181                           when "b-history" or
     2182                           when "b-hist" then
     2183                               do:
     2184                                   hh:load-image("cmp/b-hist.bmp":u) .
     2185                                   hh:TOOLTIP = "История" .
     2186                                   v-h[ii] = hh:handle .
     2187                                   ii = ii + 1 .
     2188                                   hh:width-chars = 3 .
     2189                               end.
     2190                           when "b-sch" then
     2191                               do:
     2192                                   hh:load-image("cmp/b-sch.bmp":u) .
     2193                                   hh:TOOLTIP = "Установка Фильтра" .
     2194                                   v-h[ii] = hh:handle .
     2195                                   ii = ii + 1 .
     2196                                   hh:width-chars = 3 .
     2197                               end.
     2198                           when "b-hist-user" then
     2199                               do:
     2200                                   hh:load-image("cmp/b-hist.bmp":u) .
     2201                                   hh:TOOLTIP = "История пользователя" .
     2202                                   ii = ii + 1 .
     2203                               end.
     2204                       end case.
     2205                   end.
     2206                   hh = hh:next-sibling.
     2207               end.
     2208               b-help:column = v-frame-width - b-help:width-chars.
     2209               jj = 0.
     2210               repeat ii = 4 to 1 by -1 :
     2211                   if valid-handle (v-h[ii] ) then
     2212                   do:
     2213                       jj  = jj + 1 .
     2214                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2215                       v-h[ii]:row    = v-help-old-y .
     2216                   end.
     2217               end.
     2218           end.
     2219       end.
     2220   end procedure.
     2221   MAIN-BLOCK:
     2222   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2223      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2224       if p-mode = 'shd':U then do:
     2225         assign
     2226         frame Dialog-Frame :title = frame Dialog-Frame :title +
     2227                             substitute(". &1: Задача номер &2"
     2228                             , p-task-type
     2229                             , p-task-num )
     2230         .
     2231       end.
     2232       if p-curr-host-code = 0 then do:
     2233   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2234     run mainmenu_getcntxt in parparentproc
     2235       (output v-cntxt-db-num
     2236       ,output v-cntxt-userid
     2237       ,output v-cntxt-level
     2238       ,output v-cntxt-host-code-obj
     2239       ,output v-cntxt-obj-type
     2240       ,output v-cntxt-obj-code
     2241       ,output v-cntxt-db-num-obj
     2242       ,output v-cntxt-is-admin
     2243       ) .
     2244         assign
     2245         p-curr-host-code = v-cntxt-host-code-obj.
     2246       end.
     2247       run get-host-name in this-procedure ( output v-host-name ) no-error .
     2248       if error-status :error
     2249       then do:
     2250           message
     2251             vss-workfile vss-revision vss-description
     2252             skip "Ошибка при определении имени фирмы"
     2253             skip "Код фирмы:" p-curr-host-code
     2254             skip "Имя фирмы будет отображаться как '" + 'орг':U + string( p-curr-host-code ) + "'"
     2255             skip return-value
     2256             skip trim(error-status :get-message(1))
     2257                  trim(error-status :get-message(2))
     2258                  trim(error-status :get-message(3))
     2259           view-as alert-box warning.
     2260           assign
     2261               v-host-name = 'орг':U + string( p-curr-host-code )
     2262           .
     2263       end.
     2264       run init-param-values in this-procedure (
     2265             input p-cre-db-num
     2266           , input p-task-type
     2267           , input p-task-num
     2268           , output fi-days-amount
     2269           , output rs-date
     2270           , output fi-days-ago
     2271           , output fi-date-from
     2272           , output fi-date-to
     2273           , output v-host-list
     2274           , output v-init-doc-type-list
     2275           , output rs-format
     2276           , output rs-encoding
     2277           , OUTPUT rs-1
     2278           , output rs-action
     2279           , OUTPUT rs-hsch
     2280           , OUTPUT v-hsch-list
     2281           , OUTPUT rs-csch
     2282           , OUTPUT v-csch-list
     2283           , OUTPUT t-create
     2284           , output t-create-no-th
     2285           ).
     2286       run MYenable.
     2287       run host-select in this-procedure (
     2288           input rs-1
     2289       ).
     2290       run date-select in this-procedure (
     2291           input rs-date
     2292       ).
     2293       RUN init-fields in this-procedure .
     2294       apply "value-changed" to rs-action.
     2295       WAIT-FOR GO OF FRAME Dialog-Frame.
     2296   END.
     2297   RUN disable_UI.
     2298   PROCEDURE attach-attr-to-schedule-line :
     2299       define input  parameter p-rs-format          as character no-undo .
     2300       define input  parameter p-rs-encoding        as character no-undo .
     2301       define input  parameter p-rs-date            as integer   no-undo .
     2302       define input  parameter p-days-amount        as integer   no-undo .
     2303       define input  parameter p-days-ago           as integer   no-undo .
     2304       define input  parameter p-date-from          as date      no-undo .
     2305       define input  parameter p-date-to            as date      no-undo .
     2306       define input  parameter p-rs-1               as integer   no-undo .
     2307       define input  parameter p-loc-object-list    as character no-undo .
     2308       define input  parameter p-loc-doc-type-list  as character no-undo .
     2309       define input  parameter p-rs-action          as character no-undo .
     2310       define input  parameter p-rs-hsch            as integer   no-undo .
     2311       define input  parameter p-loc-hsch-list      as character no-undo .
     2312       define input  parameter p-rs-csch            as integer   no-undo .
     2313       define input  parameter p-loc-csch-list      as character no-undo .
     2314       define input  parameter p-create             as logical   no-undo .
     2315       define input  parameter p-create-no-th       as logical   no-undo .
     2316   do
     2317   on error undo, return error
     2318   :
     2319       define variable v-attr-value as character     no-undo.
     2320       define variable v-date-value as character     no-undo.
     2321       define buffer buf_schedule      for ub.schedule.
     2322       define buffer buf_schedule-attr for ub.schedule-attr.
     2323       assign
     2324           v-attr-value =   p-rs-format
     2325                          + chr(44) + p-rs-encoding
     2326                          + chr(44) + string( p-rs-1 )
     2327                          + chr(44) + string( p-curr-host-code )
     2328                          + chr(44) + p-rs-action
     2329                          + chr(44) + string(p-rs-hsch)
     2330                          + chr(44) + string(p-rs-csch)
     2331                          + chr(44) + string(p-create)
     2332                          + chr(44) + string(p-create-no-th)
     2333       .
     2334       assign
     2335           v-date-value = string( p-rs-date )
     2336                           + "," + string( p-days-amount )
     2337                           + "," + string( p-days-ago    )
     2338                           + "," + (if p-date-from = ? then chr(63) else string(p-date-from))
     2339                           + "," + (if p-date-to = ? then chr(63) else string(p-date-to))
     2340       .
     2341       CASE p-mode:
     2342         when 'shd':U then do:
     2343             find first buf_schedule no-lock
     2344                  where buf_schedule.cre-db-num = p-cre-db-num
     2345                    and buf_schedule.task-type  = p-task-type
     2346                    and buf_schedule.task-num   = p-task-num
     2347             no-error.
     2348             if not available buf_schedule
     2349             and (  p-task-type   <> 'autocbnk':U
     2350                 or p-task-num    <> -1 )
     2351             then do:
     2352                 message
     2353                   vss-workfile vss-revision vss-description
     2354                   skip "Не найдена строка расписания."
     2355                   skip return-value
     2356                   skip trim(error-status :get-message(1))
     2357                        trim(error-status :get-message(2))
     2358                        trim(error-status :get-message(3))
     2359                 view-as alert-box error.
     2360                 undo, return error .
     2361             end.
     2362           run schedule-attr-write in this-procedure (
     2363                 input p-cre-db-num
     2364               , input p-task-type
     2365               , input p-task-num
     2366               , input 'schedule-param-list':U
     2367               , input v-attr-value
     2368           ).
     2369           run schedule-attr-write in this-procedure (
     2370                 input p-cre-db-num
     2371               , input p-task-type
     2372               , input p-task-num
     2373               , input 'schedule-obj-list':U
     2374               , input p-loc-object-list
     2375           ).
     2376           run schedule-attr-write in this-procedure (
     2377                 input p-cre-db-num
     2378               , input p-task-type
     2379               , input p-task-num
     2380               , input 'schedule-doc-type-list':U
     2381               , input p-loc-doc-type-list
     2382           ).
     2383           run schedule-attr-write in this-procedure (
     2384                 input p-cre-db-num
     2385               , input p-task-type
     2386               , input p-task-num
     2387               , input 'schedule-filter':U
     2388               , input p-loc-hsch-list
     2389           ).
     2390           run schedule-attr-write in this-procedure (
     2391             input p-cre-db-num
     2392           , input p-task-type
     2393           , input p-task-num
     2394           , input 'schedule-filter-2':U
     2395           , input p-loc-csch-list
     2396       ).
     2397       run schedule-attr-write in this-procedure (
     2398             input p-cre-db-num
     2399           , input p-task-type
     2400           , input p-task-num
     2401           , input 'schedule-date-list':U
     2402           , input v-date-value
     2403       ).
     2404           for each buf_schedule-attr
     2405           on error undo, return error
     2406           :
     2407               if buf_schedule-attr.cre-db-num <> p-cre-db-num
     2408               or buf_schedule-attr.task-type  <> 'autocbnk':U
     2409               or buf_schedule-attr.task-num   <> -1
     2410               or (
     2411                       buf_schedule-attr.attr-code <> 'schedule-param-list':U
     2412                   and buf_schedule-attr.attr-code <> 'schedule-obj-list':U
     2413                   and buf_schedule-attr.attr-code <> 'schedule-date-list':U
     2414                   and buf_schedule-attr.attr-code <> 'schedule-doc-type-list':U
     2415                   and buf_schedule-attr.attr-code <> 'schedule-filter':U
     2416                   and buf_schedule-attr.attr-code <> 'schedule-filter-2':U
     2417       )
     2418               then do:
     2419                   find first buf_schedule
     2420                       where buf_schedule.cre-db-num = buf_schedule-attr.cre-db-num
     2421                         and buf_schedule.task-type  = buf_schedule-attr.task-type
     2422                         and buf_schedule.task-num   = buf_schedule-attr.task-num
     2423                   no-error.
     2424                   if not available buf_schedule
     2425                   then do:
     2426                       delete buf_schedule-attr.
     2427                   end.
     2428               end.
     2429           end.
     2430         end.
     2431         when 'run':U then do:
     2432           assign
     2433           p-params = v-attr-value
     2434           p-object-list = p-loc-object-list
     2435           p-doc-type-list = p-loc-doc-type-list
     2436           p-hsch-list = p-loc-hsch-list
     2437           p-csch-list = p-loc-csch-list
     2438           p-date-list = v-date-value
     2439           .
     2440         end.
     2441       END CASE.
     2442   end.
     2443   END PROCEDURE.
     2444   PROCEDURE cschet-select :
     2445   define input parameter p-rs-csch   as integer      no-undo.
     2446   case p-rs-csch
     2447   :
     2448       when 1
     2449       then do:
     2450           assign
     2451               ed-csch :screen-value in frame Dialog-frame = "Все счета контрагентов"
     2452               ed-csch
     2453           .
     2454       end.
     2455       when 2
     2456       then do:
     2457           assign
     2458               ed-csch :screen-value = ""
     2459               ed-csch
     2460           .
     2461           for each temp_cfin-schet
     2462           :
     2463               assign
     2464                   ed-csch:screen-value = ed-csch :screen-value
     2465                       + ( if ed-csch :screen-value = "" then "" else ", " )
     2466                       + SUBSTITUTE("&1 &2&3 &4/&5",
     2467                              temp_cfin-schet.r-schet
     2468                             ,temp_cfin-schet.cli-type
     2469                             ,temp_cfin-schet.cli-code
     2470                             ,temp_cfin-schet.code-bank
     2471                             ,temp_cfin-schet.code-schet).
     2472                   ed-csch
     2473               .
     2474           end.
     2475       end.
     2476   end case.
     2477   END PROCEDURE.
     2478   PROCEDURE date-select :
     2479   do
     2480   on error undo, return error
     2481   :
     2482   define input parameter p-date-select-value as integer      no-undo.
     2483       case p-date-select-value
     2484       :
     2485           when 0
     2486           then do:
     2487               hide
     2488                   fi-date-from in frame Dialog-Frame
     2489                   fi-date-to
     2490               .
     2491               view
     2492                   fi-days-ago
     2493                   fi-days-amount
     2494               .
     2495               display
     2496               fi-days-ago
     2497               fi-days-amount
     2498               with frame Dialog-Frame .
     2499           end.
     2500           when 1
     2501           then do:
     2502               hide
     2503                   fi-date-to
     2504                   fi-days-ago
     2505                   fi-days-amount
     2506               .
     2507               view
     2508                   fi-date-from
     2509               .
     2510               display
     2511               fi-date-from
     2512               with frame Dialog-Frame .
     2513           end.
     2514           when 2
     2515           then do:
     2516               hide
     2517                   fi-days-ago
     2518                   fi-days-amount
     2519               .
     2520               view
     2521                   fi-date-from
     2522                   fi-date-to
     2523               .
     2524               display
     2525               fi-date-from
     2526               fi-date-to
     2527               with frame Dialog-Frame .
     2528            end.
     2529       end case.
     2530   end.
     2531   END PROCEDURE.
     2532   PROCEDURE disable_UI :
     2533     HIDE FRAME Dialog-Frame.
     2534   END PROCEDURE.
     2535   PROCEDURE enable_UI :
     2536     DISPLAY RS-action RS-encoding RS-format ed-host rs-1 rs-hsch ed-hsch T-create
     2537             rs-csch ed-csch T-create-no-th fi-days-amount rs-date fi-days-ago
     2538             fi-date-from fi-date-to ED-doc-type fi-format-select
     2539             fi-encoding-select f-t-create-1 f-t-create-2 f-t-create-3 f-t-create-4
     2540             f-t-create-5 fi-dates-title f-doc-type-label
     2541         WITH FRAME Dialog-Frame.
     2542     ENABLE Btn_OK rct-host rct-host-2 rct-host-3 rct-dates Btn_Cancel RS-action
     2543            b-help RS-encoding RS-format rs-1 bt-sel-host rs-hsch T-create
     2544            bt-sel-hsch rs-csch T-create-no-th bt-sel-csch fi-days-amount rs-date
     2545            fi-days-ago fi-date-from fi-date-to ED-doc-type bt-sel-doc-type
     2546            fi-format-select fi-encoding-select
     2547         WITH FRAME Dialog-Frame.
     2548     VIEW FRAME Dialog-Frame.
     2549   END PROCEDURE.
     2550   PROCEDURE extract-parameter :
     2551   do
     2552   on error undo, return error
     2553   :
     2554   end.
     2555   END PROCEDURE.
     2556   PROCEDURE fill-host-list :
     2557   do
     2558   on error undo, return error
     2559   :
     2560   define input parameter p-recid-list as character no-undo.
     2561   define output parameter p-host-list as character no-undo.
     2562   define variable v-recid-index as integer no-undo.
     2563   define variable v-recid          as recid    no-undo.
     2564   define buffer buf_sysconf     for ub.sysconf.
     2565   for each temp_obj-list:
     2566       delete temp_obj-list.
     2567   end.
     2568   cre-obj-list:
     2569   do v-recid-index = 1 to num-entries( p-recid-list )
     2570   :
     2571       find first buf_sysconf
     2572            where recid( buf_sysconf ) = integer( entry( v-recid-index, p-recid-list) )
     2573       no-error.
     2574       if error-status :error
     2575       then do:
     2576           message
     2577           "Не найдена запись sysconf для " p-recid-list
     2578           skip v-recid-index entry( v-recid-index, p-recid-list)
     2579           view-as alert-box.
     2580           next cre-obj-list.
     2581       end.
     2582       create temp_obj-list.
     2583       assign
     2584           temp_obj-list.obj-type = 'орг':U
     2585           temp_obj-list.obj-code = buf_sysconf.host-code
     2586       .
     2587       ASSIGN
     2588       p-host-list = p-host-list + (IF p-host-list = '':U THEN '':U ELSE chr(10)) +
     2589                   substitute("&1&2",
     2590                              'орг':U
     2591                              ,buf_sysconf.host-code).
     2592   end.
     2593   end.
     2594   END PROCEDURE.
     2595   PROCEDURE fill-sch-list :
     2596   do
     2597   on error undo, return error
     2598   :
     2599   define input parameter p-recid-list as character no-undo.
     2600   define input parameter p-mode as character no-undo.
     2601   define OUTPUT parameter p-schet-list as character no-undo.
     2602   define variable v-recid-index as integer no-undo.
     2603   define variable v-recid          as recid    no-undo.
     2604   define buffer buf_fin-schet     for ub.fin-schet.
     2605   CASE p-mode:
     2606       WHEN 'фирма':U THEN DO:
     2607           for each temp_cfin-schet:
     2608               delete temp_cfin-schet.
     2609           end.
     2610       END.
     2611       WHEN "company-host" THEN DO:
     2612           for each temp_hfin-schet:
     2613               delete temp_hfin-schet.
     2614           end.
     2615       END.
     2616   END CASE.
     2617   cre-schet-list:
     2618   do v-recid-index = 1 to num-entries( p-recid-list )
     2619   :
     2620       find first buf_fin-schet
     2621            where recid( buf_fin-schet ) = integer( entry( v-recid-index, p-recid-list) )
     2622       no-error.
     2623       if error-status :error
     2624       then do:
     2625           message
     2626           "Не найдена запись fin-schet для " p-recid-list
     2627           skip v-recid-index entry( v-recid-index, p-recid-list)
     2628           view-as alert-box.
     2629           next cre-schet-list.
     2630       end.
     2631       ASSIGN
     2632       p-schet-list = p-schet-list + (IF p-schet-list = '':U THEN '':U ELSE chr(10)) +
     2633                      substitute("&1 &2&3 &4/&5",
     2634                                 buf_fin-schet.r-schet
     2635                                 ,buf_fin-schet.cli-type
     2636                                 ,buf_fin-schet.cli-code
     2637                                 ,buf_fin-schet.code-bank
     2638                                 ,buf_fin-schet.code-schet).
     2639        CASE p-mode:
     2640            WHEN 'фирма':U THEN DO:
     2641                create temp_cfin-schet.
     2642                BUFFER-COPY buf_fin-schet TO temp_cfin-schet.
     2643            END.
     2644            WHEN "company-host":U THEN DO:
     2645                create temp_hfin-schet.
     2646                BUFFER-COPY buf_fin-schet TO temp_hfin-schet.
     2647            END.
     2648        END CASE.
     2649   end.
     2650   END.
     2651   END PROCEDURE.
     2652   PROCEDURE get-host-name :
     2653   do
     2654   on error undo, return error
     2655   :
     2656   define output parameter p-host-name as character    no-undo.
     2657   define buffer buf_clients   for ub.clients.
     2658       find first buf_clients no-lock
     2659            where buf_clients.obj-type = 'орг':U
     2660              and buf_clients.obj-code = p-curr-host-code
     2661       no-error.
     2662       if not available buf_clients
     2663       then do:
     2664           message
     2665             vss-workfile vss-revision vss-description
     2666             skip "Не удалось найти текущую фирму"
     2667             skip return-value
     2668             skip trim(error-status :get-message(1))
     2669                  trim(error-status :get-message(2))
     2670                  trim(error-status :get-message(3))
     2671                  trim(error-status :get-message(4))
     2672                  trim(error-status :get-message(5))
     2673           view-as alert-box error.
     2674           undo, return error .
     2675       end.
     2676       else do:
     2677           assign
     2678               p-host-name = buf_clients.obj-name
     2679           .
     2680       end.
     2681   end.
     2682   END PROCEDURE.
     2683   PROCEDURE host-select :
     2684   do
     2685   on error undo, return error
     2686   :
     2687   define input parameter p-rs-1   as integer      no-undo.
     2688   case p-rs-1
     2689   :
     2690       when 1
     2691       then do:
     2692           assign
     2693               ed-host :screen-value in frame Dialog-frame = "Все фирмы"
     2694               ed-host
     2695           .
     2696       end.
     2697       when 2
     2698       then do:
     2699           assign
     2700               ed-host :screen-value = ""
     2701               ed-host
     2702           .
     2703           for each temp_obj-list
     2704           :
     2705               assign
     2706                   ed-host :screen-value = ed-host :screen-value
     2707                       + ( if ed-host :screen-value = "" then "" else ", " )
     2708                       + temp_obj-list.obj-type + string( temp_obj-list.obj-code )
     2709                   ed-host
     2710               .
     2711           end.
     2712       end.
     2713   end case.
     2714   end.
     2715   END PROCEDURE.
     2716   PROCEDURE hschet-select :
     2717   do
     2718   on error undo, return error
     2719   :
     2720   define input parameter p-rs-hsch   as integer      no-undo.
     2721   case p-rs-hsch
     2722   :
     2723       when 1
     2724       then do:
     2725           assign
     2726               ed-hsch :screen-value in frame Dialog-frame = "Все счета фирмы"
     2727               ed-hsch
     2728           .
     2729       end.
     2730       when 2
     2731       then do:
     2732           assign
     2733               ed-hsch :screen-value = ""
     2734               ed-hsch
     2735           .
     2736           for each temp_hfin-schet
     2737           :
     2738               assign
     2739                   ed-hsch:screen-value = ed-hsch :screen-value
     2740                       + ( if ed-hsch :screen-value = "" then "" else chr(10) )
     2741                       + SUBSTITUTE("&1 &2&3 &4/&5",
     2742                                  temp_hfin-schet.r-schet
     2743                                 ,temp_hfin-schet.cli-type
     2744                                 ,temp_hfin-schet.cli-code
     2745                                 ,temp_hfin-schet.code-bank
     2746                                 ,temp_hfin-schet.code-schet)
     2747                  ed-hsch.
     2748           end.
     2749       end.
     2750   end case.
     2751   end.
     2752   END PROCEDURE.
     2753   PROCEDURE init-fields :
     2754   do
     2755   on error undo, return error
     2756   :
     2757       define variable v-oper-num     as integer           no-undo.
     2758       run manage-options          in this-procedure.
     2759       run manage-rs-1  in this-procedure.
     2760       assign
     2761           v-doc-type-list = v-init-doc-type-list
     2762       .
     2763       v-oper-num = 1.
     2764       assign
     2765           ed-doc-type :screen-value in frame Dialog-Frame =    v-ext-fin-doc-type-list [v-oper-num * 2 - 1] + chr(10)
     2766       v-doc-type-list = v-ext-fin-doc-type-list [v-oper-num * 2]
     2767       ed-doc-type
     2768       .
     2769   end.
     2770   END PROCEDURE.
     2771   PROCEDURE init-param-values :
     2772     define input  parameter p-cre-db-num        as integer   no-undo .
     2773     define input  parameter p-task-type         as character no-undo .
     2774     define input  parameter p-task-num          as integer   no-undo .
     2775     define output parameter p-days-amount       as integer   no-undo .
     2776     define output parameter p-rs-date           as integer   no-undo .
     2777     define output parameter p-days-ago          as integer   no-undo .
     2778     define output parameter p-date-from         as date      no-undo .
     2779     define output parameter p-date-to           as date      no-undo .
     2780     define output parameter p-host-list         as character no-undo .
     2781     define output parameter p-loc-doc-type-list as character no-undo .
     2782     define output parameter p-rs-format         as character no-undo .
     2783     define output parameter p-rs-encoding       as character no-undo .
     2784     define output parameter p-rs-1              as integer   no-undo .
     2785     define output parameter p-rs-action         as character no-undo .
     2786     define output parameter p-rs-hsch           as integer   no-undo .
     2787     define output parameter p-hfin-schet        as character no-undo .
     2788     define output parameter p-rs-csch           as integer   no-undo .
     2789     define output parameter p-cfin-schet        as character no-undo .
     2790     define output parameter p-create            as logical   no-undo .
     2791     define output parameter p-create-no-th      as logical   no-undo .
     2792     do
     2793     on error undo, return error
     2794     :
     2795     define variable v-counter       as integer       no-undo.
     2796     define variable v-param-list    as character     no-undo.
     2797     define variable v-date-list     as character no-undo .
     2798     CASE p-mode:
     2799       when 'shd':U then do:
     2800         run schedule-attr-value in this-procedure (
     2801               input p-cre-db-num
     2802             , input p-task-type
     2803             , input p-task-num
     2804             , input 'schedule-obj-list':U
     2805             , output p-host-list
     2806             , output v-param-type
     2807         ) .
     2808         run init-host-list in this-procedure (input p-host-list).
     2809         run schedule-attr-value in this-procedure (
     2810               input p-cre-db-num
     2811             , input p-task-type
     2812             , input p-task-num
     2813             , input 'schedule-param-list':U
     2814             , output v-param-list
     2815             , output v-param-type
     2816         ) .
     2817         run schedule-attr-value in this-procedure (
     2818               input p-cre-db-num
     2819             , input p-task-type
     2820             , input p-task-num
     2821             , input 'schedule-filter':U
     2822             , output p-hfin-schet
     2823             , output v-param-type
     2824         ) .
     2825         run fill-hfin-schet in this-procedure (input p-hfin-schet).
     2826         run schedule-attr-value in this-procedure (
     2827               input p-cre-db-num
     2828             , input p-task-type
     2829             , input p-task-num
     2830             , input 'schedule-filter-2':U
     2831             , output p-cfin-schet
     2832             , output v-param-type
     2833         ) .
     2834         run fill-cfin-schet in this-procedure (input p-cfin-schet).
     2835         run schedule-attr-value in this-procedure (
     2836               input p-cre-db-num
     2837             , input p-task-type
     2838             , input p-task-num
     2839             , input 'schedule-date-list':U
     2840             , output v-date-list
     2841             , output v-param-type
     2842         ) .
     2843         run schedule-attr-value in this-procedure (
     2844               input p-cre-db-num
     2845             , input p-task-type
     2846             , input p-task-num
     2847             , input 'schedule-doc-type-list':U
     2848             , output p-loc-doc-type-list
     2849             , output v-param-type
     2850         ) .
     2851       end.
     2852       when 'run':U then do:
     2853         assign
     2854         v-param-list = STRING('1s':U) + chr(44) +
     2855                        'ibm866':U + chr(44) +
     2856                        string(2) + chr(44) +
     2857                        string(p-curr-host-code) + chr(44) +
     2858                        p-action + chr(44) +
     2859                        string(1) + chr(44) +
     2860                        string(1) + chr(44) +
     2861                        string(no) + chr(44)
     2862        .
     2863       end.
     2864     END CASE.
     2865       if v-param-list = ""
     2866       or p-mode = 'run':U
     2867       then do:
     2868           assign
     2869           p-rs-format             = '1s':U
     2870           p-rs-encoding           = 'ibm866'
     2871           p-rs-1                  = (if p-mode = 'run' then 2 else 1)
     2872           v-host-list             = (if p-mode = 'run'
     2873                                      then  substitute("&1&2"
     2874                                                     ,'орг':U
     2875                                                     ,p-curr-host-code)
     2876                                      else '':U)
     2877           p-rs-action             = p-action
     2878           p-rs-hsch               = 1
     2879           p-rs-csch               = 1
     2880           p-create               = NO
     2881           p-create-no-th         = yes
     2882           p-rs-action            = p-action
     2883           .
     2884          if p-mode = 'run':U then do:
     2885             create temp_obj-list.
     2886             assign
     2887             temp_obj-list.obj-type = 'орг':U
     2888             temp_obj-list.obj-code = p-curr-host-code
     2889             .
     2890             release temp_obj-list.
     2891           end.
     2892       end.
     2893       else do:
     2894           assign
     2895           p-rs-encoding = entry( 2, v-param-list)
     2896           p-rs-1 = integer( entry( 3, v-param-list) )
     2897           p-rs-action =  entry( 5, v-param-list )
     2898           p-rs-hsch = integer( entry( 6, v-param-list ) )
     2899           p-rs-csch = integer( entry( 7, v-param-list ) )
     2900           p-create = logical( entry( 8, v-param-list ) )
     2901           p-create-no-th = (if num-entries(v-param-list) > 8
     2902                             and not p-create
     2903                             then logical( entry( 9, v-param-list ) )
     2904                             else no)
     2905           .
     2906       end.
     2907       if v-date-list = ""
     2908       then do:
     2909           define variable v-today as date      no-undo.
     2910           define variable v-time  as integer   no-undo.
     2911           run cur-time in this-procedure ( output v-today
     2912                                          , output v-time
     2913                                          ).
     2914           assign
     2915               p-rs-date       = 0
     2916               p-days-amount   = 1
     2917               p-days-ago      = 0
     2918               p-date-from     = v-today - 1
     2919               p-date-to       = v-today - 1
     2920           .
     2921       end.
     2922       else do:
     2923           assign
     2924               p-rs-date       = integer( entry( 1, v-date-list ) )
     2925               p-days-amount   = integer( entry( 2, v-date-list ) )
     2926               p-days-ago      = integer( entry( 3, v-date-list ) )
     2927               p-date-from     = date( entry( 4, v-date-list ) )
     2928               p-date-to       = date( entry( 5, v-date-list ) )
     2929           .
     2930       end.
     2931   end.
     2932   END PROCEDURE.
     2933   PROCEDURE manage-options :
     2934   do
     2935   on error undo, return error
     2936   :
     2937       assign
     2938       rct-host          :visible in frame Dialog-Frame = no
     2939       rct-host-2        :visible in frame Dialog-Frame = no
     2940       rct-host-3        :visible in frame Dialog-Frame = no
     2941       rs-1              :visible in frame Dialog-Frame = no
     2942       bt-sel-host       :visible in frame Dialog-Frame = no
     2943       ed-host           :visible in frame Dialog-Frame = no
     2944       ed-doc-type       :visible in frame Dialog-Frame = no
     2945       bt-sel-doc-type   :visible in frame Dialog-Frame = no
     2946       rs-hsch           :visible in frame Dialog-Frame = no
     2947       bt-sel-hsch       :visible in frame Dialog-Frame = no
     2948       ed-hsch           :visible in frame Dialog-Frame = no
     2949       rs-csch           :visible in frame Dialog-Frame = no
     2950       bt-sel-csch       :visible in frame Dialog-Frame = no
     2951       ed-csch           :visible in frame Dialog-Frame = no
     2952       rct-dates           :visible in frame Dialog-Frame = no
     2953       fi-dates-title      :visible in frame Dialog-Frame = no
     2954       rs-date             :visible in frame Dialog-Frame = no
     2955       fi-days-amount      :visible in frame Dialog-Frame = no
     2956       fi-days-ago         :visible in frame Dialog-Frame = no
     2957       fi-date-from        :visible in frame Dialog-Frame = no
     2958       fi-date-to          :visible in frame Dialog-Frame = no
     2959       f-doc-type-label    :visible in frame Dialog-Frame = no
     2960       t-create            :visible in frame Dialog-Frame = no
     2961       f-t-create-1        :visible in frame Dialog-Frame = no
     2962       f-t-create-2        :visible in frame Dialog-Frame = no
     2963       t-create-no-th      :visible in frame Dialog-Frame = no
     2964       f-t-create-3        :visible in frame Dialog-Frame = no
     2965       f-t-create-4        :visible in frame Dialog-Frame = no
     2966       f-t-create-5        :visible in frame Dialog-Frame = no
     2967   .
     2968   if rs-action = "exp" then do:
     2969       assign
     2970       rct-host          :visible in frame Dialog-Frame = yes
     2971       rct-host-2        :visible in frame Dialog-Frame = yes
     2972       rct-host-3        :visible in frame Dialog-Frame = yes
     2973       rs-1              :visible in frame Dialog-Frame = yes
     2974       bt-sel-host       :visible in frame Dialog-Frame = yes
     2975       ed-host           :visible in frame Dialog-Frame = yes
     2976       ed-doc-type       :visible in frame Dialog-Frame = yes
     2977       bt-sel-doc-type   :visible in frame Dialog-Frame = yes
     2978       rs-hsch           :visible in frame Dialog-Frame = YES
     2979       ed-hsch           :visible in frame Dialog-Frame = YES
     2980       rs-csch           :visible in frame Dialog-Frame = YES
     2981       ed-csch           :visible in frame Dialog-Frame = YES
     2982       f-doc-type-label  :visible in frame Dialog-Frame = YES
     2983       rct-dates           :visible in frame Dialog-Frame = yes
     2984       fi-dates-title      :visible in frame Dialog-Frame = yes
     2985       rs-date             :visible in frame Dialog-Frame = yes
     2986       fi-days-amount      :visible in frame Dialog-Frame = yes
     2987       fi-days-ago         :visible in frame Dialog-Frame = yes
     2988       fi-date-from        :visible in frame Dialog-Frame = yes
     2989       fi-date-to          :visible in frame Dialog-Frame = yes
     2990       bt-sel-hsch       :visible in frame Dialog-Frame = yes
     2991       bt-sel-csch       :visible in frame Dialog-Frame = yes
     2992       .
     2993       run host-select in this-procedure (
     2994       input rs-1
     2995        ).
     2996       run hschet-select in this-procedure (
     2997       input rs-hsch
     2998        ).
     2999       run cschet-select in this-procedure (
     3000       input rs-csch
     3001        ).
     3002       run date-select in this-procedure (
     3003           input rs-date
     3004       ).
     3005       RUN manage-rs-1 IN THIS-PROCEDURE.
     3006       enable
     3007       rs-1 when p-mode = 'shd':U
     3008       bt-sel-host when p-mode = 'shd':U
     3009       ed-host     when p-mode = 'shd':U
     3010       ed-doc-type
     3011       ed-hsch
     3012       ed-csch
     3013       rs-date
     3014       with frame Dialog-Frame .
     3015       DISPLAY
     3016       rs-encoding
     3017       rs-1
     3018       f-doc-type-label
     3019       fi-dates-title
     3020       ed-host     when p-mode = 'shd':U
     3021       ed-doc-type
     3022       ed-hsch
     3023       ed-csch
     3024       rs-date
     3025       with frame Dialog-Frame .
     3026   end.
     3027   if rs-action = "imp" then do:
     3028       ASSIGN
     3029       rct-host          :visible in frame Dialog-Frame = yes
     3030       rct-host-2        :visible in frame Dialog-Frame = yes
     3031       bt-sel-host       :visible in frame Dialog-Frame = yes
     3032       rs-hsch           :visible in frame Dialog-Frame = YES
     3033       ed-hsch           :visible in frame Dialog-Frame = YES
     3034       rs-1              :visible in frame Dialog-Frame = yes
     3035       ed-host           :visible in frame Dialog-Frame = yes
     3036       t-create            :visible in frame Dialog-Frame = YES
     3037       f-t-create-1        :visible in frame Dialog-Frame = YES
     3038       f-t-create-2        :visible in frame Dialog-Frame = YES
     3039       t-create-no-th      :visible in frame Dialog-Frame = YES
     3040       f-t-create-3        :visible in frame Dialog-Frame = YES
     3041       f-t-create-4        :visible in frame Dialog-Frame = YES
     3042       f-t-create-5        :visible in frame Dialog-Frame = YES
     3043       bt-sel-hsch       :visible in frame Dialog-Frame = yes
     3044       .
     3045       run host-select in this-procedure (
     3046       input rs-1
     3047        ).
     3048       run hschet-select in this-procedure (
     3049       input rs-hsch
     3050        ).
     3051       RUN manage-rs-1 IN THIS-PROCEDURE.
     3052       enable
     3053       rs-1 when p-mode = 'shd':U
     3054       bt-sel-host when p-mode = 'shd':U
     3055       ed-host     when p-mode = 'shd':U
     3056       ed-hsch
     3057       t-create
     3058       t-create-no-th
     3059       with frame Dialog-Frame .
     3060       if p-mode = 'run' then do:
     3061         display
     3062         rs-1
     3063         with frame Dialog-Frame .
     3064       end.
     3065       DISPLAY
     3066       f-t-create-1
     3067       f-t-create-2
     3068       f-t-create-3
     3069       f-t-create-4
     3070       f-t-create-5
     3071       rs-1
     3072       t-create
     3073       t-create-no-th
     3074       ed-host     when p-mode = 'shd':U
     3075       ed-hsch
     3076       rs-encoding
     3077       with frame Dialog-Frame .
     3078   END.
     3079   end.
     3080   END PROCEDURE.
     3081   PROCEDURE manage-rs-1 :
     3082   do
     3083   on error undo, return error
     3084   :
     3085    if rs-1 = 1
     3086       then do:
     3087           assign
     3088           rs-hsch = 1
     3089           rs-hsch :sensitive in frame Dialog-Frame = NO
     3090           bt-sel-hsch:sensitive in frame Dialog-Frame = NO
     3091           .
     3092           display
     3093           rs-hsch
     3094           with frame Dialog-Frame .
     3095           run hschet-select in this-procedure (
     3096               input rs-hsch
     3097           ) .
     3098           if rs-action = 'exp' then do:
     3099             assign
     3100             rs-csch = 1
     3101             rs-csch :sensitive in frame Dialog-Frame = NO
     3102             bt-sel-csch:sensitive in frame Dialog-Frame = NO
     3103             .
     3104             display
     3105             rs-csch
     3106             with frame Dialog-Frame .
     3107             run cschet-select in this-procedure (
     3108                 input rs-csch
     3109             ) .
     3110           end.
     3111       end.
     3112       else do:
     3113           assign
     3114           rs-hsch :sensitive in frame Dialog-Frame = YES
     3115           bt-sel-hsch:sensitive in frame Dialog-Frame = YES
     3116           .
     3117           display
     3118           rs-hsch
     3119           with frame Dialog-Frame .
     3120           run hschet-select in this-procedure (
     3121               input rs-hsch
     3122           ) .
     3123           if rs-action = 'exp' then do:
     3124             assign
     3125             rs-csch :sensitive in frame Dialog-Frame = YES
     3126             bt-sel-csch:sensitive in frame Dialog-Frame = YES
     3127             .
     3128             display
     3129             rs-csch
     3130             with frame Dialog-Frame .
     3131             run cschet-select in this-procedure (
     3132                 input rs-csch
     3133             ) .
     3134           end.
     3135       end.
     3136       DISPLAY
     3137       rs-hsch
     3138       rs-csch when rs-action = 'exp'
     3139       WITH FRAME Dialog-Frame.
     3140     end.
     3141   END PROCEDURE.
     3142   PROCEDURE MyEnable :
     3143   dEFINE variable ii                      as INTEGER       no-undo.
     3144   dEFINE VARIABLE v-dop AS CHARACTER NO-UNDO.
     3145   DO ii = 1 TO NUM-ENTRIES('1s':U):
     3146       ASSIGN
     3147       v-dop = v-dop + (IF v-dop = '':U THEN '':U ELSE chr(44)) +
     3148               entry (lookup (ENTRY(ii, '1s':U), '1s':U) + 1, ',' + '1С':U) + chr(44) + ENTRY(ii, '1s':U)  .
     3149   END.
     3150   rs-format:RADIO-BUTTONS IN FRAME Dialog-Frame = v-dop.
     3151   if p-mode = 'shd':U then do:
     3152     if rs-action = '':U
     3153     or rs-action = ?
     3154     then rs-action = 'exp'.
     3155     DISPLAY
     3156     rs-action
     3157     fi-format-select
     3158     fi-encoding-select
     3159     WITH FRAME Dialog-Frame.
     3160   end.
     3161   ENABLE
     3162   Btn_OK
     3163   Btn_Cancel
     3164   b-help
     3165   rs-action when p-mode = 'shd':U
     3166   fi-days-amount
     3167   rs-date
     3168   fi-days-ago
     3169   fi-date-from
     3170   fi-date-to
     3171   rs-encoding
     3172   rs-format
     3173   WITH FRAME Dialog-Frame.
     3174   ASSIGN
     3175   rs-format = '1s':U.
     3176   DISABLE
     3177   rs-format
     3178   WITH FRAME Dialog-Frame.
     3179   VIEW FRAME Dialog-Frame.
     3180   END PROCEDURE.
