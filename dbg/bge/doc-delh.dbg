      518                       then do:
      519                           assign
      520                               p-out-string = p-out-string + " ":U
      521                           .
      522                       end.
      523                       when chr(5)
      524                       then do:
      525                           assign
      526                               p-out-string = p-out-string + " ":U
      527                           .
      528                       end.
      529                       when chr(6)
      530                       then do:
      531                           assign
      532                               p-out-string = p-out-string + " ":U
      533                           .
      534                       end.
      535                       when chr(7)
      536                       then do:
      537                           assign
      538                               p-out-string = p-out-string + " ":U
      539                           .
      540                       end.
      541                       when chr(8)
      542                       then do:
      543                           assign
      544                               p-out-string = p-out-string + " ":U
