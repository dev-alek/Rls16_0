      979   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
      980                                             INPUT iFlagEmpty AS INTEGER).
      981       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
      982       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
      983           DO:
      984               IF iFlagEmpty = 0                           THEN RETURN "".
      985               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
      986               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
      987               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
      988               ELSE RETURN "".
      989           END.
      990       ELSE DO:
      991           run xmlchar-encode in this-procedure (
      992                 input sToPlace
      993               , output sToPlace
      994           ).
      995           ASSIGN
      996               sToPlace = sParName + '="' + sToPlace + '"'
      997           .
      998           RETURN sToPlace.
      999       END.
     1000   END FUNCTION.
     1001   function bge-xml-date returns character
     1002   ( input p-date as date )
     1003   :
     1004     define variable v-date-str as character no-undo .
     1005     run bge-xml-date-to-str in this-procedure ( input   p-date
     1006                                               , output  v-date-str
     1007                                               ) .
     1008     return v-date-str.
     1009   end function.
     1010   function bge-xml-str-date returns character
     1011   ( input p-date-str as character )
     1012   :
     1013     define variable v-date-str as character no-undo .
     1014     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1015                                                   , output  v-date-str
     1016                                                   ) .
     1017     return v-date-str.
     1018   end function.
     1019   function bge-xml-normalize-dec returns decimal
     1020   ( input p-val as decimal )
     1021   :
     1022     return (if p-val = ? then 0 else p-val) .
     1023   end function.
     1024   PROCEDURE wp-XMLTagOpen:
     1025   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1026   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1027   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1028       define variable v-out-string    as character    no-undo.
     1029   do
     1030   on error undo, return error
     1031   :
     1032       if v-bge-xml-bgefmt = "dbf":U
     1033       then do:
     1034       end.
     1035       else do:
     1036           assign
     1037               v-out-string = substitute( "&1&2<&3&4>"
     1038                                       , chr(10)
     1039                                       , fill( " ":U, 4 * iTagLevel)
     1040                                       , sTagName
     1041                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1042                               )
     1043           .
     1044           put stream stmXMLOut unformatted
     1045               v-out-string
     1046           .
     1047       end.
     1048   end.
     1049   END PROCEDURE.
     1050   PROCEDURE wp-XMLTagPut:
     1051     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1052     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1053     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1054     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1055       define variable v-out-string    as character    no-undo.
     1056   do
     1057   on error undo, return error
     1058   :
     1059       if v-bge-xml-bgefmt = "dbf":U
     1060       then do:
     1061           if v-bge-xml-dbf-file-name <> "":U
     1062           then do:
     1063               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1064               export stream stmXMLOut
     1065                   sTagName
     1066                   sParValue
     1067               .
     1068               output stream stmXMLOut close.
     1069           end.
     1070       end.
     1071       else do:
     1072           IF  iFlagEmpty = 1
     1073           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1074           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1075           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1076           THEN DO:
     1077               run xmlchar-encode in this-procedure (
     1078                   input sParValue
     1079                   , output sParValue
     1080               ).
     1081               assign
     1082                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1083                                               , chr(10)
     1084                                               , FILL(" ", 4 * iTagLevel)
     1085                                               , sTagName
     1086                                               , sParValue
     1087                               )
     1088               .
     1089               PUT STREAM stmXMLOut UNFORMATTED
     1090                   v-out-string
     1091               .
     1092           END.
     1093       end.
     1094   end.
     1095   END PROCEDURE.
     1096   PROCEDURE wp-XMLTagClose:
     1097   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1098   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1099       define variable v-out-string    as character    no-undo.
     1100   do
     1101   on error undo, return error
     1102   :
     1103       if v-bge-xml-bgefmt = "dbf":U
     1104       then do:
     1105       end.
     1106       else do:
     1107           assign
     1108               v-out-string = substitute( "&1&2</&3>"
     1109                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1110                                   , fill( " ", 4 * iTagLevel )
     1111                                   , sTagName
     1112                           )
     1113           .
     1114           PUT STREAM stmXMLOut UNFORMATTED
     1115               v-out-string
     1116           .
     1117       end.
     1118   end.
     1119   END PROCEDURE.
     1120   PROCEDURE wp-XMLWriteLog:
     1121     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1122     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1123     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1124   define variable v-str              as character no-undo .
     1125   define variable v-error-append     as logical   no-undo .
     1126   define variable v-error-append-msg as character no-undo .
     1127   assign
     1128     v-str = chr(10)
     1129             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1130             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1131     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1132     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1133     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1134   .
     1135   run bge/bge-log.p (input v-str) no-error .
     1136   if error-status:error then do:
     1137     assign
     1138       v-error-append     = yes
     1139       v-error-append-msg = return-value
     1140     .
     1141   end.
     1142   run gbl/fileapnd.p
     1143     ( input sFileName
     1144     , input v-str
     1145     , input 10
     1146     ) no-error .
     1147   if error-status:error then do:
     1148     assign
     1149       v-error-append     = yes
     1150       v-error-append-msg = substitute( "&1&2&3"
     1151                                       , v-error-append-msg
     1152                                       , chr(10)
     1153                                       , return-value
     1154                                       )
     1155     .
     1156   end.
     1157   if v-error-append
     1158   then do:
     1159     return error substitute( "&1" , v-error-append-msg ) .
     1160   end.
     1161   END PROCEDURE.
     1162   PROCEDURE wp-XMLWriteEDT:
     1163     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1164     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1165     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1166       if valid-handle ( hEDT )
     1167       then do:
     1168           hEDT :move-to-eof().
     1169           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1170                                           OR sToWrite = "&Line") THEN "" ELSE
     1171                                           cur-time-string-sec() + " ").
     1172           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1173                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1174                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1175           hEDT :insert-string(chr(10)).
     1176       end.
     1177       process events.
     1178       output to 'bgescn.txt' append.
     1179           put unformatted
     1180               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1181                                           OR sToWrite = "&Line") THEN "" ELSE
     1182                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1183               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1184                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1185                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1186           .
     1187       output close.
     1188   END PROCEDURE.
     1189   PROCEDURE wp-XMLShowCNT:
     1190     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1191       if valid-handle( hCNT )
     1192       then do:
     1193           ASSIGN hCNT :VISIBLE = TRUE.
     1194       end.
     1195   END PROCEDURE.
     1196   PROCEDURE wp-XMLHideCNT:
     1197     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1198       if valid-handle( hCNT )
     1199       then do:
     1200           ASSIGN hCNT :VISIBLE = FALSE.
     1201       end.
     1202   END PROCEDURE.
     1203   PROCEDURE wp-XMLWriteCNT:
     1204     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1205     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1206       if valid-handle( hCNT )
     1207       then do:
     1208           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1209       end.
     1210   END PROCEDURE.
     1211   procedure bge-xml-write-header:
     1212   do
     1213   on error undo, return error
     1214   :
     1215   define input parameter p-xml-file-name  as character        no-undo.
     1216   define input parameter p-doc-name       as character        no-undo.
     1217   define input parameter p-version        as character        no-undo.
     1218   define input parameter p-db-num         as integer          no-undo.
     1219   define input parameter p-date-from      as date             no-undo.
     1220   define input parameter p-shift-num-from as integer          no-undo.
     1221   define input parameter p-date-to        as date             no-undo.
     1222   define input parameter p-shift-num-to   as integer          no-undo.
     1223   define input parameter p-obj-list       as character        no-undo.
     1224   define input parameter p-doc-type-list  as character        no-undo.
     1225   define input parameter p-pay-code       as logical          no-undo.
     1226   define input parameter p-cst            as logical          no-undo.
     1227   define input parameter p-parts          as logical          no-undo.
     1228   define input parameter p-chk-pay-code   as logical          no-undo.
     1229   define input parameter p-pay-desk       as logical          no-undo.
     1230   define input parameter p-pay-desk-cards as logical          no-undo.
     1231   define input parameter p-deleted        as logical          no-undo.
     1232   define input parameter p-opened-docs    as logical          no-undo.
     1233   define variable v-out-string    as character    no-undo.
     1234   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1235   assign
     1236       v-out-string = substitute( "&1&2&3"
     1237                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1238                           , chr(10)
     1239                           , "<IBS_Trade_House>":U )
     1240   .
     1241   put stream stmXMLOut unformatted
     1242       v-out-string
     1243   .
     1244   run wp-XMLTagOpen(1, "header","").
     1245   if v-bge-xml-bgeflold = "oracle":u
     1246   then do:
     1247     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1248     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1249     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1250     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1251     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1252   end.
     1253   run wp-XMLTagOpen( 2, "manifest", "").
     1254   run wp-XMLTagOpen( 3, "document", "").
     1255   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1256   run wp-XMLTagput( 4, "description", "", 0).
     1257   run wp-XMLTagput( 4, "version", p-version, 0).
     1258   run wp-XMLTagclose( 3, "document" ).
     1259   run wp-XMLTagclose( 2, "manifest" ).
     1260   run wp-XMLTagclose( 1, "header" ).
     1261   run wp-XMLTagOpen(1, "options","").
     1262   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1263   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1264   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1265   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1266   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1267   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1268   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1269   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1270   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1271   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1272   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1273   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1274   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1275   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1276   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1277   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1278   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1279   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1280   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1281   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1282   run wp-XMLTagClose(1, "options").
     1283   run wp-XMLTagOpen( 1, "body", "" ).
     1284   output stream stmXMLOut close.
     1285   end.
     1286   end procedure.
     1287   procedure xml-bge-write-footer:
     1288   do
     1289   on error undo, return error return-value
     1290   :
     1291   define input parameter p-xml-file-name as character    no-undo.
     1292   define variable v-error-num     as integer           no-undo.
     1293   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1294   run wp-XMLTagClose( 1, "body" ).
     1295   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1296   output stream stmXMLOut close.
     1297   if v-bge-xml-bgeflold = "oracle":u
     1298   then do:
     1299     define variable v-tmp-file-name         as character no-undo .
     1300     define variable v-zip-file-name         as character no-undo .
     1301     define variable v-exch-file-name        as character no-undo .
     1302     define variable v-heap-file-name        as character no-undo .
     1303     define variable v-i                     as integer   no-undo .
     1304     define variable v-file-name             as character no-undo .
     1305     define variable v-arc                   as character no-undo .
     1306     define variable v-str                   as character no-undo .
     1307     define variable v-exch-tmp-file-name    as character no-undo .
     1308     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1309     define variable v-bge-xml-exch-dir      as character no-undo .
     1310     define variable v-bge-xml-heap-dir      as character no-undo .
     1311     define variable v-bge-xml-compress-heap as logical   no-undo .
     1312     define variable v-home-dir              as character no-undo .
     1313     define variable v-os-command            as character no-undo .
     1314     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1315     if v-home-dir = ?
     1316     then do:
     1317       undo, return error substitute( "&1&2&3"
     1318                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1319                                     , chr(10)
     1320                                     , "Обратитесь к администратору.":u
     1321                                     ).
     1322     end.
     1323     assign
     1324       v-home-dir = v-home-dir
     1325     .
     1326     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1327     if error-status :error
     1328     then do:
     1329       undo, return error substitute( "&1&2&3"
     1330                                     , "Неверно задан каталог экспорта.":u
     1331                                     , chr(10)
     1332                                     , "Обратитесь к администратору.":u
     1333                                     ).
     1334     end.
     1335     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1336     if v-bge-xml-exch-dir = ?
     1337     then do:
     1338       undo, return error substitute( "&1&2&3"
     1339                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1340                                     , chr(10)
     1341                                     , "Обратитесь к администратору.":u
     1342                                     ).
     1343     end.
     1344     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1345     if error-status :error
     1346     then do:
     1347       undo, return error substitute( "&1&2&3"
     1348                                     , "Неверно задан каталог экспорта (exch).":u
     1349                                     , chr(10)
     1350                                     , "Обратитесь к администратору.":u
     1351                                     ).
     1352     end.
     1353     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1354     if v-bge-xml-heap-dir = ?
     1355     then do:
     1356       undo, return error substitute( "&1&2&3"
     1357                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1358                                     , chr(10)
     1359                                     , "Обратитесь к администратору.":u
     1360                                     ).
     1361     end.
     1362     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1363     if error-status :error
     1364     then do:
     1365       undo, return error substitute( "&1&2&3"
     1366                                     , "Неверно задан каталог экспорта (heap).":u
     1367                                     , chr(10)
     1368                                     , "Обратитесь к администратору.":u
     1369                                     ).
     1370     end.
     1371     get-key-value section "BGE" key "heap-compress" value v-str.
     1372     assign
     1373       v-i = int(v-str)
     1374     no-error .
     1375     if v-i = ? or v-i = 0
     1376     then do:
     1377       assign
     1378         v-bge-xml-compress-heap = no
     1379       .
     1380     end.
     1381     else do:
     1382       assign
     1383         v-bge-xml-compress-heap = yes
     1384       .
     1385     end.
     1386     assign
     1387       v-arc = search( "exe/7za.exe":u )
     1388     .
     1389     if v-arc = ? or v-arc = ""
     1390     then do:
     1391       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1392     end.
     1393     assign
     1394       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1395       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1396       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1397       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1398       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1399       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1400       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1401     .
     1402     run gbl/del-file.p (input v-tmp-file-name) .
     1403     run gbl/del-file.p (input v-zip-file-name) .
     1404     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1405     if v-error-num > 0
     1406     then do:
     1407         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1408                                      , p-xml-file-name + "xm1":u
     1409                                      , v-tmp-file-name
     1410                                      , v-error-num
     1411                                      ).
     1412     end.
     1413     assign
     1414       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1415                                    , v-arc
     1416                                    , v-zip-file-name
     1417                                    , v-tmp-file-name
     1418                                    )
     1419     .
     1420     os-command silent value ( v-os-command ) .
     1421     run gbl/del-file.p (input v-heap-file-name) .
     1422     if v-bge-xml-compress-heap = no
     1423     then do:
     1424       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1425       if v-error-num > 0
     1426       then do:
     1427           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1428                                        , v-tmp-file-name
     1429                                        , v-heap-file-name
     1430                                        , v-error-num
     1431                                        ) .
     1432       end.
     1433     end.
     1434     else do:
     1435       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1436       if v-error-num > 0
     1437       then do:
     1438           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1439                                        , v-zip-file-name
     1440                                        , v-heap-file-name
     1441                                        , v-error-num
     1442                                        ) .
     1443       end.
     1444     end.
     1445     run gbl/del-file.p (input v-tmp-file-name) .
     1446     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1447     if error-status :error then do:
     1448       undo, return error substitute( "&1&2&3"
     1449                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1450                                     , chr(10)
     1451                                     , "Обратитесь к администратору."
     1452                                     ).
     1453     end.
     1454     run gbl/del-file.p (input v-exch-file-name) .
     1455     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1456     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1457     if v-error-num > 0
     1458     then do:
     1459       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1460                                     , v-zip-file-name
     1461                                     , v-exch-tmp-file-name
     1462                                     , v-error-num
     1463                                     ) .
     1464     end.
     1465     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1466     if v-error-num > 0
     1467     then do:
     1468       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1469                                     , v-exch-tmp-file-name
     1470                                     , v-exch-file-name
     1471                                     , v-error-num
     1472                                     ) .
     1473     end.
     1474     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1475   end.
     1476   else do:
     1477     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1478     if v-error-num > 0
     1479     then do:
     1480       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1481                                     , p-xml-file-name + "xm1"
     1482                                     , p-xml-file-name + "xml"
     1483                                     , v-error-num
     1484                                     ) .
     1485     end.
     1486   end.
     1487   if opsys = "unix"
     1488   then do:
     1489       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1490   end.
     1491   end.
     1492   end procedure.
     1493   procedure xml-bge-filename0:
     1494   define input parameter p-prefix   as character no-undo .
     1495   define input parameter p-name     as character no-undo .
     1496   define input parameter p-shared-process as logical no-undo .
     1497   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1498   define output parameter p-xml-file-name  as character no-undo .
     1499   // define output parameter p-fullfnamenoext as character no-undo .
     1500   define output parameter p-locked         as logical      no-undo.
     1501   define variable v-fullfnamenoext as character no-undo .
     1502   define variable v-fileext        as character no-undo .
     1503   define variable v-fullfname      as character no-undo .
     1504   define variable v-error-num      as integer   no-undo .
     1505   do
     1506   on error undo, return error
     1507   :
     1508     case v-bge-xml-bgeflold :
     1509       when "old" then do:
     1510         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1511         v-fileext       = ".xml":U .
     1512         v-fullfname     = v-fullfnamenoext + v-fileext .
     1513         p-xml-file-name = v-fullfname .
     1514         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1515         if v-error-num > 0 then do:
     1516           return error.
     1517         end.
     1518       end.
     1519       when "var" then do:
     1520         case p-prefix :
     1521           when "doc" then do:
     1522             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1523             v-fileext       = ".xml":U .
     1524             v-fullfname     = v-fullfnamenoext + v-fileext .
     1525             p-xml-file-name = v-fullfname .
     1526           end.
     1527           when "day" then do:
     1528             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1529             v-fileext       = ".xml":U .
     1530             v-fullfname     = v-fullfnamenoext + v-fileext .
     1531             p-xml-file-name = v-fullfname .
     1532           end.
     1533           otherwise do:
     1534             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1535             v-fileext       = ".xml":U .
     1536             v-fullfname     = v-fullfnamenoext + v-fileext .
     1537             p-xml-file-name = v-fullfname .
     1538           end.
     1539         end case.
     1540         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1541         if v-error-num > 0 then do:
     1542           return error.
     1543         end.
     1544       end.
     1545       when "new" then do:
     1546                   run bge/genfname.p (
     1547                       input p-home-dir
     1548                       , input p-prefix
     1549                       , input ""
     1550                       , input "xml"
     1551                       , input ""
     1552                       , output p-xml-file-name
     1553                   ).
     1554       end.
     1555       when "no-parameter" then do:
     1556         if p-shared-process then do:
     1557                       run bge/genfname.p (
     1558                           input p-home-dir
     1559                           , input "d"
     1560                           , input ""
     1561                           , input "xml"
     1562                           , input ""
     1563                           , output p-xml-file-name
     1564                       ).
     1565         end.
     1566         else do:
     1567           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1568           v-fileext       = ".xml":U .
     1569           v-fullfname     = v-fullfnamenoext + v-fileext .
     1570           p-xml-file-name = v-fullfname .
     1571           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1572           if v-error-num > 0 then do:
     1573             return error.
     1574           end.
     1575         end.
     1576       end.
     1577     end case.
     1578     assign
     1579       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1580       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1581     .
     1582   end .
     1583   end procedure .
     1584   procedure xml-bge-filename :
     1585   do
     1586   on error undo, return error
     1587   :
     1588   define input parameter p-prefix             as character    no-undo.
     1589   define input parameter p-name               as character    no-undo.
     1590   define input parameter p-shared-process     as logical      no-undo.
     1591   define output parameter p-xml-file-name     as character    no-undo.
     1592   define output parameter p-log-file-name     as character    no-undo.
     1593   define output parameter p-locked            as logical      no-undo.
     1594   define variable v-home-dir          as character no-undo .
     1595   define variable v-error-num         as integer   no-undo .
     1596   define variable v-bge-xml-heap-dir  as character no-undo .
     1597       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1598       if v-home-dir = ?
     1599       then do:
     1600           message
     1601             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1602             skip(1)
     1603             skip "Обратитесь к администратору."
     1604           view-as alert-box error.
     1605           undo, return error .
     1606       end.
     1607       if v-bge-xml-bgeflold <> "oracle"
     1608       then do:
     1609         assign
     1610             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1611         .
     1612       end.
     1613       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1614       if error-status :error
     1615       then do:
     1616           message
     1617             skip "Неверно задан каталог экспорта."
     1618             skip(1)
     1619             skip "Обратитесь к администратору."
     1620           view-as alert-box error.
     1621           undo, return error .
     1622       end.
     1623       if v-bge-xml-bgefmt = "dbf":U
     1624       then do:
     1625           assign
     1626               p-xml-file-name = v-home-dir
     1627               p-locked        = no
     1628           .
     1629       end.
     1630       else do:
     1631           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1632             output p-xml-file-name, output p-locked) .
     1633       end.
     1634       if v-bge-xml-bgeflold = "oracle"
     1635       then do:
     1636         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1637         if v-bge-xml-heap-dir = ?
     1638         then do:
     1639           undo, return error substitute( "&1&2&3"
     1640                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1641                                         , chr(10)
     1642                                         , "Обратитесь к администратору.":u
     1643                                         ).
     1644         end.
     1645         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1646         if error-status :error
     1647         then do:
     1648           undo, return error substitute( "&1&2&3"
     1649                                         , "Неверно задан каталог экспорта (heap).":u
     1650                                         , chr(10)
     1651                                         , "Обратитесь к администратору.":u
     1652                                         ).
     1653         end.
     1654         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1655           assign
     1656             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1657           .
     1658         end.
     1659         else do:
     1660           assign
     1661             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1662           .
     1663         end.
     1664       end.
     1665       else do:
     1666         assign
     1667             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1668         .
     1669       end.
     1670       assign
     1671          v-bge-xml-static-log-file-name = p-log-file-name
     1672       .
     1673   end.
     1674   end procedure.
     1675   procedure bge-xml-read-config :
     1676   do
     1677   on error undo, return error return-value
     1678   :
     1679   define input  parameter p-last-date as date      no-undo .
     1680   define input  parameter p-db-num    as integer   no-undo .
     1681       define variable v-bgeclall      as character     no-undo.
     1682       define variable v-bgedict       as character     no-undo.
     1683       define variable v-bgeshift      as character     no-undo.
     1684       define variable v-par-type      as character     no-undo.
     1685       define variable v-bgeflnm       as character     no-undo.
     1686       define variable v-bgecliiv      as character     no-undo .
     1687       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1688       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1689       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1690       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1691       define variable v-db-num-str    as character     no-undo .
     1692       define variable v-param-type      as character  no-undo .
     1693       define variable v-value-character as character  no-undo .
     1694       define variable v-value-date      as date       no-undo .
     1695       define variable v-value-decimal   as decimal    no-undo .
     1696       define variable v-value-integer   as integer    no-undo .
     1697       define variable v-value-logical   as logical    no-undo .
     1698       define variable v-tth             as handle      no-undo .
     1699       run adm/shattri.p ( input "get":U
     1700                         , input  '':u
     1701                         , input  0
     1702                         , input  'bge-export':U
     1703                         , input  'bgeclall':U
     1704                         , output v-bgecliiv
     1705                         , output v-value-date
     1706                         , output v-value-decimal
     1707                         , output v-value-integer
     1708                         , output v-value-logical
     1709                         , output v-param-type
     1710                         , input-output table-handle v-tth
     1711                         ) no-error .
     1712       if error-status :error
     1713       then do:
     1714         assign
     1715           v-bge-xml-bgecliiv = no
     1716         .
     1717       end.
     1718       else do:
     1719         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1720       end.
     1721       delete object v-tth.
     1722       assign
     1723           v-bge-xml-bgeclall = no
     1724           v-bge-xml-bgedict  = no
     1725       .
     1726       run adm/shattri.p ( input "get":U
     1727                         , input  '':u
     1728                         , input  0
     1729                         , input  'bge-export':U
     1730                         , input  'bgeclall':U
     1731                         , output v-value-character
     1732                         , output v-value-date
     1733                         , output v-value-decimal
     1734                         , output v-value-integer
     1735                         , output v-value-logical
     1736                         , output v-param-type
     1737                         , input-output table-handle v-tth
     1738                         ) no-error .
     1739       if error-status :error
     1740       then do:
     1741         assign
     1742           v-bge-xml-bgeclall = no
     1743         .
     1744       end.
     1745       else do:
     1746         assign
     1747           v-bge-xml-bgeclall = v-value-logical
     1748         .
     1749       end.
     1750       delete object v-tth.
     1751       run adm/shattri.p ( input "get":U
     1752                         , input  '':u
     1753                         , input  0
     1754                         , input  'bge-export':U
     1755                         , input  'bgedict':U
     1756                         , output v-value-character
     1757                         , output v-value-date
     1758                         , output v-value-decimal
     1759                         , output v-value-integer
     1760                         , output v-value-logical
     1761                         , output v-param-type
     1762                         , input-output table-handle v-tth
     1763                         ) no-error .
     1764       if error-status :error
     1765       then do:
     1766         assign
     1767           v-bge-xml-bgedict = no
     1768         .
     1769       end.
     1770       else do:
     1771         assign
     1772           v-bge-xml-bgedict = v-value-logical
     1773         .
     1774       end.
     1775       delete object v-tth.
     1776       run adm/shattri.p ( input "get":U
     1777                         , input  '':u
     1778                         , input  0
     1779                         , input  'bge-export':U
     1780                         , input  'bgefmt':U
     1781                         , output v-value-character
     1782                         , output v-value-date
     1783                         , output v-value-decimal
     1784                         , output v-value-integer
     1785                         , output v-value-logical
     1786                         , output v-param-type
     1787                         , input-output table-handle v-tth
     1788                         ) no-error .
     1789       if error-status :error
     1790       then do:
     1791         assign
     1792           v-bge-xml-bgefmt  = "xml":U
     1793         .
     1794       end.
     1795       else do:
     1796         assign
     1797           v-bge-xml-bgefmt  = v-value-character
     1798         .
     1799       end.
     1800       delete object v-tth.
     1801       run adm/shattri.p ( input "get":U
     1802                         , input  '':u
     1803                         , input  0
     1804                         , input  'bge-export':U
     1805                         , input  'bgeshift':U
     1806                         , output v-value-character
     1807                         , output v-value-date
     1808                         , output v-value-decimal
     1809                         , output v-value-integer
     1810                         , output v-value-logical
     1811                         , output v-param-type
     1812                         , input-output table-handle v-tth
     1813                         ) no-error .
     1814       if error-status :error
     1815       then do:
     1816         assign
     1817             v-bge-xml-shift-mode = no
     1818         .
     1819       end.
     1820       else do:
     1821         assign
     1822             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1823         .
     1824       end.
     1825       delete object v-tth.
     1826       run adm/shattri.p ( input "get":U
     1827                         , input  '':u
     1828                         , input  0
     1829                         , input  'bge-export':U
     1830                         , input  'bgeflold':U
     1831                         , output v-value-character
     1832                         , output v-value-date
     1833                         , output v-value-decimal
     1834                         , output v-value-integer
     1835                         , output v-value-logical
     1836                         , output v-param-type
     1837                         , input-output table-handle v-tth
     1838                         ) no-error .
     1839       if error-status :error
     1840       then do:
     1841         assign
     1842           v-bge-xml-bgeflold = "no-parameter":U
     1843         .
     1844       end.
     1845       else do:
     1846         assign
     1847           v-bge-xml-bgeflold  = v-value-character
     1848         .
     1849       end.
     1850       delete object v-tth.
     1851       assign
     1852         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1853         v-bge-xml-db-num-str  = v-db-num-str
     1854       .
     1855       if p-last-date <> ?
     1856       then do:
     1857           run adm/shattri.p ( input "get":U
     1858                             , input  '':u
     1859                             , input  0
     1860                             , input  'bge-export':U
     1861                             , input  'bgeflnm':U
     1862                             , output v-value-character
     1863                             , output v-value-date
     1864                             , output v-value-decimal
     1865                             , output v-value-integer
     1866                             , output v-value-logical
     1867                             , output v-param-type
     1868                             , input-output table-handle v-tth
     1869                             ) no-error .
     1870           if error-status :error
     1871           then do:
     1872             assign
     1873               v-bgeflnm = '':U
     1874             .
     1875           end.
     1876           else do:
     1877             assign
     1878               v-bgeflnm = v-value-character
     1879             .
     1880           end.
     1881           delete object v-tth.
     1882           if v-bge-xml-bgeflold = "var"
     1883           then do:
     1884               if v-bgeflnm = ?
     1885               or num-entries( v-bgeflnm ) < 2
     1886               then do:
     1887                   assign
     1888                       v-bge-xml-bgeflold = "new"
     1889                   .
     1890               end.
     1891               else do:
     1892                   assign
     1893                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1894                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1895                   .
     1896                   assign
     1897                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1898                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1899                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1900                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1901                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1902                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1903                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1904                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1905                   .
     1906               end.
     1907           end.
     1908       end.
     1909   end.
     1910   end procedure.
     1911   procedure bge-xml-get-ref-filename :
     1912   define input parameter p-in-file-name       as character        no-undo.
     1913   define output parameter p-home-dir          as character        no-undo.
     1914   define output parameter p-out-file-name     as character        no-undo.
     1915   define output parameter p-locked            as logical          no-undo.
     1916       define variable v-counter       as integer      no-undo.
     1917       define variable v-error-level   as integer      no-undo.
     1918   do
     1919   on error undo, return error
     1920   :
     1921       run bge/bge-ini.p (
     1922             input "bge"
     1923           , output p-home-dir
     1924       ).
     1925       if return-value <> "OK"
     1926       then do:
     1927           undo, return error.
     1928       end.
     1929       assign
     1930           p-home-dir = p-home-dir + "\dict":U
     1931       .
     1932       run bge/dir_cd.p (
     1933           input p-home-dir
     1934           , input "CA"
     1935       ).
     1936       if return-value = "ERROR"
     1937       then do:
     1938           undo, return error.
     1939       end.
     1940       assign
     1941           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     1942       .
     1943       assign
     1944           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     1945       .
     1946       wait-lock:
     1947       do v-counter = 1 TO 3
     1948       :
     1949           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     1950           if p-locked = no
     1951           then do:
     1952               leave wait-lock.
     1953           end.
     1954           else do:
     1955               readkey pause 1.
     1956           end.
     1957       END.
     1958       if p-locked = yes
     1959       then do:
     1960           undo, return error.
     1961       end.
     1962       run bge/os_copy.p (
     1963             input "D":U
     1964           , input p-out-file-name + "xml":U
     1965           , input "":U
     1966           , output v-error-level
     1967       ).
     1968       if v-error-level > 0
     1969       then do:
     1970           undo, return error.
     1971       end.
     1972   end.
     1973   end procedure.
     1974   procedure bge-xml-write-ref-header :
     1975   define input parameter p-bge-name as character        no-undo.
     1976   define input parameter p-file-name as character        no-undo.
     1977       define variable v-out-string    as character    no-undo.
     1978   do
     1979   on error undo, return error
     1980   :
     1981       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     1982       put stream stmXMLOut unformatted
     1983           "<?xml version='1.0' encoding='windows-1251'?>":U
     1984       .
     1985       assign
     1986           v-out-string = substitute( "&1&2"
     1987                               , chr(10)
     1988                               , "<IBS_Trade_House>":U )
     1989       .
     1990       put stream stmXMLOut unformatted
     1991           v-out-string
     1992       .
     1993       run wp-XMLTagOpen( 1, "header", "" ).
     1994       if v-bge-xml-bgeflold = "oracle":u
     1995       then do:
     1996         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1997         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1998         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1999         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2000         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2001       end.
     2002       else do:
     2003         run wp-XMLTagOpen( 2, "delivery", "" ).
     2004         run wp-XMLTagOpen( 3, "to", "" ).
     2005         run wp-XMLTagClose( 3, "to" ).
     2006         run wp-XMLTagOpen( 3, "from", "" ).
     2007         run wp-XMLTagClose( 3, "from" ).
     2008         run wp-XMLTagClose( 2, "delivery" ).
     2009       end.
     2010       run wp-XMLTagOpen( 2, "manifest", "" ).
     2011       run wp-XMLTagOpen( 3, "document", "" ).
     2012       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2013       run wp-XMLTagPut( 4, "description", "", 0 ).
     2014       run wp-XMLTagClose( 3, "document" ).
     2015       run wp-XMLTagClose( 2, "manifest" ).
     2016       run wp-XMLTagClose( 1, "header" ).
     2017       run wp-XMLTagOpen( 1, "body", "" ).
     2018   end.
     2019   end procedure.
     2020   procedure bge-xml-write-ref-footer :
     2021   define input parameter p-file-name as character        no-undo.
     2022       define variable v-error-level   as integer      no-undo.
     2023   do
     2024   on error undo, return error
     2025   :
     2026       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2027       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2028       output stream stmXMLOut close.
     2029       run bge/os_copy.p (
     2030             input "M":U
     2031           , input p-file-name + "xm1":U
     2032           , input p-file-name + "xml":U
     2033           , output v-error-level
     2034       ).
     2035       if v-error-level > 0
     2036       then do:
     2037           undo, return error.
     2038       end.
     2039   end.
     2040   end procedure.
     2041   procedure bge-xml-out-dir :
     2042   define output parameter p-out-dir       as character    no-undo.
     2043   define output parameter p-log-file-name as character    no-undo.
     2044   do
     2045   on error undo, return error
     2046   :
     2047       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2048       if p-out-dir = ?
     2049       then do:
     2050           message
     2051             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2052                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2053             skip(1)
     2054             skip "Обратитесь к администратору."
     2055           view-as alert-box error.
     2056           undo, return error .
     2057       end.
     2058       if v-bge-xml-bgeflold <> "oracle" then assign
     2059         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2060       .
     2061       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2062       if error-status :error  then do:
     2063           run wp-XMLWriteLog in this-procedure (
     2064                 input p-log-file-name
     2065               , input 0
     2066               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2067                                   , p-out-dir
     2068                                   , return-value
     2069                                   , trim( error-status :get-message( 1 ) )
     2070                                   )
     2071           ).
     2072           undo, return error.
     2073       end.
     2074       assign
     2075           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2076           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2077       .
     2078   end.
     2079   end procedure.
     2080   procedure bge-xml-out-dir2 :
     2081   define output parameter p-out-dir       as character    no-undo.
     2082   define output parameter p-out-dirR      as character    no-undo.
     2083   define output parameter p-log-file-name as character    no-undo.
     2084   do
     2085   on error undo, return error
     2086   :
     2087       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2088       if p-out-dir = ?
     2089       then do:
     2090           message
     2091             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2092                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2093             skip(1)
     2094             skip "Обратитесь к администратору."
     2095           view-as alert-box error.
     2096           undo, return error .
     2097       end.
     2098       if v-bge-xml-bgeflold <> "oracle" then assign
     2099             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2100             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2101         .
     2102       else p-out-dirR = p-out-dir .
     2103       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2104       if error-status :error  then do:
     2105           run wp-XMLWriteLog in this-procedure (
     2106                 input p-log-file-name
     2107               , input 0
     2108               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2109                                   , p-out-dir
     2110                                   , return-value
     2111                                   , error-status :get-message( 1 )
     2112                                   )
     2113           ).
     2114           undo, return error.
     2115       end.
     2116       if p-out-dirR <> p-out-dir then do:
     2117         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2118         if error-status :error then do:
     2119           run wp-XMLWriteLog in this-procedure (
     2120                 input p-log-file-name
     2121               , input 0
     2122               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2123                                   , p-out-dirR
     2124                                   , return-value
     2125                                   , error-status :get-message( 1 )
     2126                                   )
     2127           ).
     2128           p-out-dirR = p-out-dir .
     2129         end.
     2130       end .
     2131       assign
     2132         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2133         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2134       .
     2135   end.
     2136   end procedure.
     2137   procedure bge-xml-out-file :
     2138   do
     2139   on error undo, return error
     2140   :
     2141   define input parameter p-out-dir            as character        no-undo.
     2142   define input parameter p-prefix             as character        no-undo.
     2143   define input parameter p-sheduled           as logical          no-undo.
     2144   define output parameter p-xml-file-name     as character        no-undo.
     2145   define output parameter p-locked            as logical          no-undo.
     2146   define variable v-home-dir      as character     no-undo.
     2147   define variable v-error-num     as integer       no-undo.
     2148   define variable v-today             as date         no-undo.
     2149   define variable v-time              as integer      no-undo.
     2150       if v-bge-xml-bgefmt = "dbf":U
     2151       then do:
     2152           assign
     2153               p-xml-file-name = p-out-dir
     2154               p-locked        = no
     2155           .
     2156       end.
     2157       else do:
     2158           if v-bge-xml-bgeflold = "firm":U
     2159           then do:
     2160               run bge/genfname.p (
     2161                     input p-out-dir
     2162                   , input p-prefix
     2163                   , input "":U
     2164                   , input "arj":U
     2165                   , input "":U
     2166                   , output p-xml-file-name
     2167               ).
     2168           end.
     2169           else do:
     2170               run bge/genfname.p (
     2171                     input p-out-dir
     2172                   , input p-prefix
     2173                   , input "":U
     2174                   , input "xml":U
     2175                   , input "":U
     2176                   , output p-xml-file-name
     2177               ).
     2178           end.
     2179           assign
     2180               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2181               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2182           .
     2183       end.
     2184   end.
     2185   end procedure.
     2186   procedure bge-xml-init-ext-doc-type :
     2187       define variable v-counter    as integer      no-undo.
     2188       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2189   do
     2190   for buf_temp_ext-doc-type
     2191   on error undo, return error
     2192   :
     2193       empty temp-table buf_temp_ext-doc-type.
     2194       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2195       :
     2196           create buf_temp_ext-doc-type.
     2197           assign
     2198               buf_temp_ext-doc-type.edt-key               = v-counter
     2199               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2200               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2201           .
     2202       end.
     2203   end.
     2204   end procedure.
     2205   procedure bge-xml-get-decimal-shift-num :
     2206   define input parameter p-shift-date     as date             no-undo.
     2207   define input parameter p-shift-num      as integer          no-undo.
     2208   define output parameter p-shift-decimal as decimal          no-undo.
     2209   do
     2210   on error undo, return error
     2211   :
     2212       assign
     2213           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2214       .
     2215   end.
     2216   end procedure.
     2217   procedure bge-xml-ora-exp-filename :
     2218     define input  parameter p-table-name  as character no-undo .
     2219     define input  parameter p-doc-code    as character no-undo .
     2220     define input  parameter p-obj-code    as integer   no-undo .
     2221     define output parameter p-filename    as character no-undo .
     2222     define output parameter p-seq-num     as integer   no-undo .
     2223     define variable v-ora-exp-seq     as integer   no-undo .
     2224     define variable v-ora-exp-seq-str as character no-undo .
     2225     define variable v-home-dir        as character no-undo.
     2226   do
     2227   on error undo, return error return-value
     2228   :
     2229     if v-bge-xml-bgeflold = "oracle":u
     2230     then do:
     2231       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2232       if v-home-dir = ?
     2233       then do:
     2234         undo, return error substitute( "&1&2&3":U
     2235                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2236                                       , chr(10)
     2237                                       , "Обратитесь к администратору.":U
     2238                                       ).
     2239       end.
     2240       assign
     2241           v-home-dir = v-home-dir
     2242       .
     2243       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2244       if error-status :error
     2245       then do:
     2246         undo, return error substitute( "&1&2&3":U
     2247                                       , "Неверно задан каталог экспорта.":U
     2248                                       , chr(10)
     2249                                       , "Обратитесь к администратору.":U
     2250                                       ).
     2251       end.
     2252       assign
     2253         v-ora-exp-seq = ?
     2254       .
     2255       if  p-table-name <> ? and
     2256           p-doc-code <> ?
     2257       then do:
     2258         run bge/get-oesq.p ( input p-table-name
     2259                            , input p-doc-code
     2260                            , output v-ora-exp-seq
     2261                            ) no-error .
     2262         if error-status :error = yes
     2263         then do:
     2264           undo, return error return-value .
     2265         end.
     2266       end.
     2267       if v-ora-exp-seq = ?
     2268       then do:
     2269         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2270         if error-status :error
     2271         then do:
     2272           undo, return error return-value .
     2273         end.
     2274       end.
     2275       if p-table-name <> ? and
     2276          p-doc-code   <> ?
     2277       then do:
     2278         run bge/oesqdoc.p ( input p-table-name
     2279                           , input p-doc-code
     2280                           , input v-ora-exp-seq
     2281                           ) no-error .
     2282         if error-status :error = yes
     2283         then do:
     2284           undo, return error return-value .
     2285         end.
     2286       end.
     2287       assign
     2288         p-seq-num  = v-ora-exp-seq
     2289         p-filename = substitute("&1/&2-000_&3."
     2290                                , v-home-dir
     2291                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2292                                , string(v-ora-exp-seq , "999999999")
     2293                                )
     2294       .
     2295     end.
     2296   end.
     2297   end procedure.
     2298   procedure bge-xml-date-to-str :
     2299     define input  parameter p-date  as date      no-undo .
     2300     define output parameter p-str   as character no-undo .
     2301   do
     2302   on error undo, return error return-value
     2303   :
     2304     if p-date <> ?
     2305     then do:
     2306       assign
     2307         p-str = substitute( "&1-&2-&3"
     2308                           , string( year(p-date)  , "9999")
     2309                           , string( month(p-date) , "99"  )
     2310                           , string( day(p-date)   , "99"  )
     2311                           )
     2312       .
     2313     end.
     2314     else do:
     2315       assign
     2316         p-str = ?
     2317       .
     2318     end.
     2319   end.
     2320   end procedure.
     2321   procedure bge-xml-date-str-to-str :
     2322     define input  parameter p-date-str  as character no-undo .
     2323     define output parameter p-str       as character no-undo .
     2324     define variable v-date          as date      no-undo .
     2325     define variable v-date-valid    as logical   no-undo .
     2326     define variable v-error-message as character no-undo .
     2327   do
     2328   on error undo, return error return-value
     2329   :
     2330     assign
     2331       p-str = ?
     2332     .
     2333     if p-date-str = ? or p-date-str = ""
     2334     then do:
     2335       return .
     2336     end.
     2337     run strtdate in this-procedure ( input  p-date-str
     2338                                    , output v-date
     2339                                    , output v-date-valid
     2340                                    , output v-error-message
     2341                                    ).
     2342     if v-date-valid <> true
     2343     then do:
     2344       return .
     2345     end.
     2346     assign
     2347       p-str = substitute( "&1-&2-&3"
     2348                         , string( year(v-date)  , "9999")
     2349                         , string( month(v-date) , "99"  )
     2350                         , string( day(v-date)   , "99"  )
     2351                         )
     2352     .
     2353   end.
     2354   end procedure.
     2355   procedure bge-xml-fill-tt-bgecliiv :
     2356     define input  parameter p-str as character no-undo .
     2357     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2358     define buffer buf_clients             for ub.clients.
     2359     define variable v-i         as integer   no-undo .
     2360     define variable v-count     as integer   no-undo .
     2361     define variable v-cli-count as integer   no-undo .
     2362     define variable v-client    as character no-undo .
     2363     define variable v-obj-type  as character no-undo .
     2364     define variable v-obj-code  as integer   no-undo .
     2365   do
     2366   on error undo, return error return-value
     2367   :
     2368     empty temp-table buf_tt-bge-xml-bgecliiv.
     2369     assign
     2370       v-bge-xml-bgecliiv = no
     2371       v-cli-count        = num-entries(p-str,';')
     2372     .
     2373     if v-cli-count > 0
     2374     then do:
     2375       _cli-cycle:
     2376       do v-i = 1 to v-cli-count
     2377       :
     2378         assign
     2379           v-client = entry(v-i , p-str, ';')
     2380         .
     2381         if num-entries(v-client) <> 2
     2382         then do:
     2383           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2384         end.
     2385         assign
     2386           v-obj-type = entry(1, v-client)
     2387         .
     2388         assign
     2389           v-obj-code = integer(entry(2, v-client))
     2390         no-error .
     2391         if error-status :error
     2392         then do:
     2393           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2394         end.
     2395         find first buf_clients no-lock
     2396           where buf_clients.obj-type = v-obj-type
     2397             and buf_clients.obj-code = v-obj-code
     2398         no-error.
     2399         if not available buf_clients
     2400         then do:
     2401           next _cli-cycle.
     2402         end.
     2403         find first buf_tt-bge-xml-bgecliiv no-lock
     2404           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2405             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2406         no-error .
     2407         if available buf_tt-bge-xml-bgecliiv
     2408         then do:
     2409           next _cli-cycle.
     2410         end.
     2411         create buf_tt-bge-xml-bgecliiv.
     2412         assign
     2413           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2414           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2415         .
     2416       end.
     2417     end.
     2418     else do:
     2419       assign
     2420         v-bge-xml-bgecliiv = no
     2421       .
     2422       return .
     2423     end.
     2424     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2425     if available buf_tt-bge-xml-bgecliiv
     2426     then do:
     2427       assign
     2428         v-bge-xml-bgecliiv = yes
     2429       .
     2430     end.
     2431   end.
     2432   end procedure.
     2433   procedure bge-xml-resolve-ext-doc-type :
     2434     define input  parameter p-ext-doc-type      as character no-undo .
     2435     define input  parameter p-obj-type          as character no-undo .
     2436     define input  parameter p-obj-code          as integer   no-undo .
     2437     define output parameter p-out-ext-doc-type  as character no-undo .
     2438     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2439   do
     2440   on error undo, return error return-value
     2441   :
     2442     assign
     2443       p-out-ext-doc-type = p-ext-doc-type
     2444     .
     2445     if p-ext-doc-type <> 'ie':U
     2446     then do:
     2447       return .
     2448     end.
     2449     if v-bge-xml-bgecliiv = yes
     2450     then do:
     2451       find first buf_tt-bge-xml-bgecliiv no-lock
     2452         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2453           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2454       no-error .
     2455       if available buf_tt-bge-xml-bgecliiv
     2456       then do:
     2457         assign
     2458           p-out-ext-doc-type = 'iv':U
     2459         .
     2460       end.
     2461     end.
     2462   end.
     2463   end procedure.
     2464   procedure safe-wp-xmltagput :
     2465     define input  parameter pTagLevel   as integer   no-undo .
     2466     define input  parameter pTagName    as character no-undo .
     2467     define input  parameter pParValue   as character no-undo .
     2468     define input  parameter pFlagEmpty  as integer   no-undo .
     2469   do
     2470   on error undo, return error return-value
     2471   :
     2472     if v-bge-xml-bgeflold = "oracle":u
     2473     then do:
     2474       return .
     2475     end.
     2476     run wp-xmltagput in this-procedure ( input pTagLevel
     2477                                        , input pTagName
     2478                                        , input pParValue
     2479                                        , input pFlagEmpty
     2480                                        ).
     2481   end.
     2482   end procedure.
     2483       define buffer buf_c-trn-doc       for ub.c-trn-doc.
     2484   do
     2485   for buf_c-trn-doc
     2486   on error undo, return error
     2487   :
     2488       output stream stmxmlout to value( soutfile + "xm1" ) convert target "1251" append.
     2489       run wp-XMLWriteCNT( hCNT, "" ).
     2490       run wp-XMLWriteEDT( hEDT, 4, "Операция: Выгрузка удаленных документов." ).
     2491       run wp-XMLWriteLog( sLogFile, 0, "&Line" ).
     2492       run wp-XMLWriteLog( sLogFile, 1, "XML - Вывод операции: Выгрузка удаленных документов." ).
     2493       for each buf_c-trn-doc no-lock
     2494          where buf_c-trn-doc.obj-type   = p-obj-type
     2495            and buf_c-trn-doc.obj-code   = p-obj-code
     2496            and buf_c-trn-doc.is-del     = yes
     2497       :
     2498           if  buf_c-trn-doc.corr-shift-date = p-shift-date
     2499           and buf_c-trn-doc.corr-shift-num  = p-shift-num
     2500           then do:
     2501               run wp-XMLWriteCNT in this-procedure (
     2502                     input hCNT
     2503                   , input substitute( "&1", buf_c-trn-doc.doc-code )
     2504               ).
     2505               run wp-XMLWriteLog in this-procedure ( input sLogFile
     2506                                                    , input 1
     2507                                                    , input substitute( "Выгрузка документа &1 в пакет &2"
     2508                                                                      , buf_c-trn-doc.doc-code
     2509                                                                      , sOutFile
     2510                                                                      )
     2511                                                    ).
     2512               run export-c-trn-doc in this-procedure ( input buf_c-trn-doc.doc-code
     2513                                                      , input buf_c-trn-doc.corr-user-db-num
     2514                                                      , input buf_c-trn-doc.chip-num
     2515                                                      ) no-error.
     2516               if error-status :error
     2517               then do:
     2518                   undo, return error vss-description + "Ошибка вывода документа " + buf_c-trn-doc.doc-code.
     2519               end.
     2520               run wp-XMLWriteLog in this-procedure ( input sLogFile
     2521                                                    , input 1
     2522                                                    , input substitute( "Выгрузка документа &1 в пакет &2 завершена."
     2523                                                                      , buf_c-trn-doc.doc-code
     2524                                                                      , sOutFile
     2525                                                                      )
     2526                                                    ).
     2527           end.
     2528       end.
     2529       output stream stmxmlout close.
     2530   end.
     2531   procedure export-c-trn-doc :
     2532   define input parameter p-doc-code           as character        no-undo.
     2533   define input parameter p-corr-user-db-num   as integer          no-undo.
     2534   define input parameter p-chip-num           as integer          no-undo.
     2535       define buffer buf_c-trn-doc   for ub.c-trn-doc.
     2536       define variable v-firm-code as character no-undo .
     2537   do
     2538   for buf_c-trn-doc
     2539   on error undo, return error
     2540   :
     2541       find first buf_c-trn-doc no-lock
     2542            where buf_c-trn-doc.doc-code           = p-doc-code
     2543              and buf_c-trn-doc.corr-user-db-num   = p-corr-user-db-num
     2544              and buf_c-trn-doc.chip-num           = p-chip-num
     2545       .
     2546       assign
     2547         v-firm-code = buf_c-trn-doc.cli-type + string( buf_c-trn-doc.cli-code )
     2548       .
     2549       run wp-xmltagopen( input 2, input "operation", input "" ).
     2550       run wp-xmltagput( input 3, input "referenceNo"  , input buf_c-trn-doc.doc-code                                   , input 0 ).
     2551       run wp-xmltagput( input 3, input "isDel"        , input "yes"                                                    , input 0 ).
     2552       run wp-xmltagput( input 3, input "flagDel"      , input buf_c-trn-doc.is-del                                     , input 0 ).
     2553       run wp-xmltagput( input 3, input "codeOperation", input string( buf_c-trn-doc.ext-doc-type                      ), input 0 ).
     2554       run wp-xmltagput( input 3, input "host"         , input string( buf_c-trn-doc.host-code                         ), input 0 ).
     2555       run wp-xmltagput( input 3, input "store"        , input buf_c-trn-doc.obj-type + string( buf_c-trn-doc.obj-code ), input 0 ).
     2556       run wp-xmltagput( input 3, input "dateDel"      , input string( buf_c-trn-doc.corr-date ,"99.99.9999"           ), input 0 ).
     2557       run wp-xmltagput( input 3, input "dateDelXml"   , input bge-xml-date( buf_c-trn-doc.corr-date )                  , input 0 ).
     2558       run wp-xmltagput( input 3, input "dateDoc"      , input string( buf_c-trn-doc.doc-date  ,"99.99.9999"           ), input 0 ).
     2559       run wp-xmltagput( input 3, input "dateDocXml"   , input bge-xml-date( buf_c-trn-doc.doc-date )                   , input 0 ).
     2560       run wp-xmltagput( input 3, input "dateFact"     , input string( buf_c-trn-doc.fact-date ,"99.99.9999"           ), input 0 ).
     2561       run wp-xmltagput( input 3, input "dateFactXml"  , input bge-xml-date( buf_c-trn-doc.fact-date )                  , input 0 ).
     2562       if buf_c-trn-doc.ext-doc-type <> 'ot':U
     2563       then do:
     2564         run wp-xmltagput( input 3, input "firm"         , input v-firm-code                                              , input 0 ).
     2565       end.
     2566       run wp-xmltagput( input 3, input "factOrder"    , input string( buf_c-trn-doc.fact-order                        ), input 0 ).
     2567       run wp-xmltagput( input 3, input "sysDate"      , input string( buf_c-trn-doc.sys-date ,"99.99.9999"            ), input 0 ).
     2568       run wp-xmltagput( input 3, input "sysDateXml"   , input bge-xml-date( buf_c-trn-doc.sys-date )                   , input 0 ).
     2569       run wp-xmltagput( input 3, input "sysTime"      , input string( buf_c-trn-doc.sys-time                          ), input 0 ).
     2570       run wp-xmltagput( input 3, input "outCode"      , input buf_c-trn-doc.out-code                                   , input 0).
     2571       run wp-xmltagput( input 3, input "reasonCode"   , input string( buf_c-trn-doc.reason-code                       ), input 2 ).
     2572       run wp-xmltagput( input 3, input "comment"      , input buf_c-trn-doc.PS                                         , input 0).
     2573       run wp-xmltagclose( input 2, input "operation" ).
     2574   end.
     2575   end procedure.
