      582   procedure xmlchar-decode :
      583   define input parameter p-in-string      as character        no-undo.
      584   define output parameter p-out-string    as character        no-undo.
      585       define variable v-position      as integer      no-undo.
      586       define variable v-last-position as integer      no-undo.
      587       define variable v-temp-integer  as integer      no-undo.
      588       define variable v-current-char  as character    no-undo.
      589       define variable v-next-char     as character    no-undo.
      590       define variable v-success       as logical      no-undo.
      591   do
      592   on error undo, return error
      593   :
      594       assign
      595           p-out-string = "":U
      596           v-position   = 0
      597       .
      598       replace-cycle:
      599       do while yes
      600       on error undo, return error
      601       :
      602           assign
      603               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      604           .
      605           if v-last-position <= v-position
      606           then do:
      607               if v-position = 0
      608               then do:
      609                   assign
      610                       p-out-string = p-in-string
      611                   .
      612               end.
      613               else do:
      614                   assign
      615                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      616                   .
      617               end.
      618               leave replace-cycle.
      619           end.
      620           else do:
      621               assign
      622                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      623                   v-position      = v-last-position
      624                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      625               .
      626               if v-current-char = "#":U
      627               then do:
      628                   assign
      629                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      630                   .
      631                   if v-last-position > 0
      632                   then do:
      633                       run xmlchar-read-integer in this-procedure
      634                        (
      635                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      636                           , output v-temp-integer
      637                           , output v-success
      638                       ).
      639                       if v-success = yes
      640                       and v-temp-integer >= 1
      641                       and v-temp-integer <= 255
      642                       then do:
      643                           assign
      644                               p-out-string = p-out-string + chr( v-temp-integer )
      645                               v-position   = v-last-position + 1
      646                           .
      647                       end.
      648                       else do:
      649                           assign
      650                               p-out-string = p-out-string + "&":U
      651                               v-position   = v-position   + 1
      652                           .
      653                       end.
      654                   end.
      655                   else do:
      656                       assign
      657                           p-out-string = p-out-string + "&":U
      658                           v-position   = v-position   + 1
      659                       .
      660                   end.
      661               end.
      662               else do:
      663                   case substring( p-in-string, v-position + 1, 3 )
      664                   :
      665                       when "lt;":U
      666                       then do:
      667                           assign
      668                               p-out-string = p-out-string + "<":U
      669                               v-position   = v-position   + 3
      670                           .
      671                       end.
      672                       when "gt;":U
      673                       then do:
      674                           assign
      675                               p-out-string = p-out-string + ">":U
      676                               v-position   = v-position   + 3
      677                           .
      678                       end.
      679                       otherwise do:
      680                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      681                           then do:
      682                               assign
      683                                   p-out-string = p-out-string + "&":U
      684                                   v-position   = v-position   + 4
      685                               .
      686                           end.
      687                           else do:
      688                               case substring( p-in-string, v-position + 1, 5 )
      689                               :
      690                                   when "quot;":U
      691                                   then do:
      692                                       assign
      693                                           p-out-string = p-out-string + '"':U
      694                                           v-position   = v-position   + 5
      695                                       .
      696                                   end.
      697                                   when "apos;":U
      698                                   then do:
      699                                       assign
      700                                           p-out-string = p-out-string + "'":U
      701                                           v-position   = v-position   + 5
      702                                       .
      703                                   end.
      704                                   otherwise do:
      705                                       assign
      706                                           p-out-string = p-out-string + "&":U
      707                                       .
      708                                   end.
      709                               end case.
      710                           end.
      711                       end.
      712                   end case.
      713               end.
      714           end.
      715       end.
      716   end.
      717   end .
      718   procedure xmlchar-read-integer :
      719   define input parameter p-input-string      as character        no-undo.
      720   define output parameter p-output-integer   as integer          no-undo.
      721   define output parameter p-success       as logical          no-undo.
      722   do
      723   on error undo, return error
      724   :
      725       assign
      726           p-output-integer = integer( p-input-string )
      727       no-error.
      728       if error-status :error
      729       then do:
      730           assign
      731               p-success           = no
      732               p-output-integer    = 0
      733           .
      734       end.
      735       else do:
      736           assign
      737               p-success           = yes
      738           .
      739       end.
      740   end.
      741   end.
      742   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      743   procedure strtdate :
      744     define input  parameter p-str         as character no-undo .
      745     define output parameter p-value       as date      no-undo .
      746     define output parameter p-data-valid  as logical   no-undo .
      747     define output parameter p-message     as character no-undo .
      748   do
      749   on error undo, return error return-value
      750   :
      751     define variable v-value       as date      no-undo .
      752     define variable v-i           as integer   no-undo .
      753     define variable v-num         as integer   no-undo .
      754     define variable v-delim       as character no-undo .
      755     define variable v-delim-list  as character no-undo .
      756     define variable v-day         as integer   no-undo .
      757     define variable v-month       as integer   no-undo .
      758     define variable v-year        as integer   no-undo .
      759     define variable v-day-str     as character no-undo .
      760     define variable v-month-str   as character no-undo .
      761     define variable v-year-str    as character no-undo .
      762     assign
      763       p-value       = ?
      764       p-data-valid  = false
      765     .
      766     if p-str = ?
      767     then do:
      768       assign
      769         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      770       .
      771       return .
      772     end.
      773     if p-str = ""
      774     then do:
      775       assign
      776         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      777       .
      778       return .
      779     end.
      780     if length(p-str)  > 10
      781     then do:
      782       assign
      783         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      784       .
      785       return .
      786     end.
      787     assign
      788       v-delim-list = '/,-,.':U
      789     .
      790     _delim:
      791     do v-i = 1 to num-entries( v-delim-list )
      792     :
      793       assign
      794         v-delim = entry( v-i , v-delim-list )
      795         v-num   = num-entries( p-str , v-delim )
      796       .
      797       if v-num <> 3
      798       then do:
      799         assign
      800           v-delim = ''
      801         .
      802       end.
      803       else do:
      804         leave _delim.
      805       end.
      806     end.
      807     if v-delim = ''
      808     then do:
      809       assign
      810         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      811       .
      812       return .
      813     end.
      814     assign
      815       v-day-str   = entry( 1, p-str , v-delim)
      816       v-month-str = entry( 2, p-str , v-delim)
      817       v-year-str  = entry( 3, p-str , v-delim)
      818     .
      819     if  length(v-day-str) > 2   or
      820         length(v-day-str) < 1   or
      821         length(v-month-str) > 2 or
      822         length(v-month-str) < 1 or
      823         (
      824           length(v-year-str) <> 2 and
      825           length(v-year-str) <> 4
      826         )
      827     then do:
      828       assign
      829         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      830       .
      831       return .
      832     end.
      833     if length( v-year-str ) = 2
      834     then do:
      835       assign
      836         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      837       .
      838     end.
      839     assign
      840       v-day   = integer( v-day-str )
      841       v-month = integer( v-month-str)
      842       v-year  = integer( v-year-str)
      843     no-error .
      844     if error-status :error
      845     then do:
      846       assign
      847         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      848       .
      849       return .
      850     end.
      851     if v-day < 1  or
      852        v-day > 31 or
      853        v-month < 1 or
      854        v-month > 12 or
      855        v-year < 0   or
      856        v-year > 5000
      857     then do:
      858       assign
      859         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      860       .
      861       return .
      862     end.
      863     assign
      864       v-value = date( v-month, v-day, v-year )
      865     no-error .
      866     if error-status :error
      867     then do:
      868       assign
      869         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      870       .
      871       return .
      872     end.
      873     assign
      874       p-value       = v-value
      875       p-data-valid  = true
      876     .
      877   end.
      878   end procedure.
      879   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      880   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
