        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle     as handle no-undo .
        5   define input parameter p-db-num-char    as character    no-undo.
        6   define input parameter p-task-type      as character    no-undo.
        7   define input parameter p-task-num       as integer      no-undo.
        8   define input parameter p-db-num         as integer      no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":u .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":u .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":u .
       12   define variable vss-workfile    as character no-undo init "$Workfile: adelrt.p $":u .
       13   define variable vss-archive     as character no-undo init "$Archive: bge/adelrt.p $":u .
       14   define variable vss-description as character no-undo init  "Процедура произвольных автозаданий удаления маршуртизации ВС, работающих без подтверждения" .
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   define temp-table temp-schedule-free no-undo
       75   field free-id as character
       76   field free-task-name as character
       77   field proc-run-name as character
       78   field proc-param-edit-name as character
       79   field conf-param as character
       80   field is-gbd as logical
       81   field is-ubd as logical
       82   field enable-concurrent-0 as logical
       83   field enable-concurrent-db as logical
       84   field other-info as character
       85   field enc-key as character
       86   field is-rum as logical
       87   index pi is unique primary
       88   free-id.
       89   procedure schedule-attr-name :
       90   do
       91     on error undo, return error
       92     :
       93     define input  parameter p-code           as character no-undo .
       94     define output parameter p-type           as character no-undo .
       95     define output parameter p-format         as character no-undo .
       96     define output parameter p-label          as character no-undo .
       97     define output parameter p-user-can-edit  as logical   no-undo .
       98     define output parameter p-output-display as logical   no-undo .
       99     define output parameter p-other          as character no-undo .
      100       if index(p-code, chr(4)) > 0 then do:
      101         p-code = entry(1, p-code, chr(4)).
      102       end.
      103       case p-code :
      104               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      105               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      106               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      107               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      108               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      109               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      110               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      111               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      112               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      113         otherwise do:
      114           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      115         end.
      116       end.
      117     end.
      118   end procedure.
      119   procedure schedule-attr-tooltip :
      120   do
      121     on error undo, return error
      122     :
      123       define input  parameter p-code    as character no-undo .
      124       define output parameter p-tooltip as character no-undo .
      125       define output parameter p-label   as character no-undo .
      126       if index(p-code, chr(4)) > 0 then do:
      127         p-code = entry(1, p-code, chr(4)).
      128       end.
      129       case p-code :
      130               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      131               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      132               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      133               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      134               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      135               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      136               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      137               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      138               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      139         otherwise do:
      140               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      141         end.
      142       end.
      143     end.
      144   end procedure.
      145   procedure schedule-attr-value :
      146   do
      147   on error undo, return error return-value
      148   :
      149   define input parameter  p-cre-db-num as integer    no-undo.
      150   define input parameter  p-task-type  as character  no-undo.
      151   define input parameter  p-task-num   as integer    no-undo.
      152   define input parameter  p-code       as character  no-undo.
      153   define output parameter p-value      as character  no-undo.
      154   define output parameter p-type       as character  no-undo.
      155       define variable v-format         as character no-undo .
      156       define variable v-label          as character no-undo .
      157       define variable v-user-can-edit  as logical   no-undo .
      158       define variable v-output-display as logical   no-undo .
      159       define variable v-other          as character no-undo .
      160       define buffer buf_schedule-attr for ub.schedule-attr.
      161       run schedule-attr-name in this-procedure (
      162             input  p-code
      163           , output p-type
      164           , output v-format
      165           , output v-label
      166           , output v-user-can-edit
      167           , output v-output-display
      168           , output v-other
      169       ) no-error .
      170       if error-status :error
      171       then do:
      172           undo, return error return-value .
      173       end.
      174       if p-code begins ('schd-free-id':U + chr(4))
      175       and entry(2, p-code, chr(4)) = '':U then do:
      176         find first buf_schedule-attr no-lock
      177             where buf_schedule-attr.cre-db-num = p-cre-db-num
      178               and buf_schedule-attr.task-type  = p-task-type
      179               and buf_schedule-attr.task-num   = p-task-num
      180               and buf_schedule-attr.attr-code  begins p-code
      181         no-error .
      182       end.
      183       else do:
      184         find first buf_schedule-attr no-lock
      185             where buf_schedule-attr.cre-db-num = p-cre-db-num
      186               and buf_schedule-attr.task-type  = p-task-type
      187               and buf_schedule-attr.task-num   = p-task-num
      188               and buf_schedule-attr.attr-code  = p-code
      189         no-error .
      190       end.
      191       if available buf_schedule-attr
      192       then do:
      193           assign
      194               p-value = buf_schedule-attr.attr-value
      195           .
      196       end.
      197       else do:
      198         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      199            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      200         end.
      201         else do:
      202           assign
      203               p-value = if p-type = 'L':U then "no":U else ""
      204           .
      205         end.
      206       end.
      207   end.
      208   end procedure.
      209   procedure schedule-attr-write :
      210   do
      211   on error undo, return error
      212   :
      213   define input parameter p-cre-db-num  as integer   no-undo.
      214   define input parameter p-task-type   as character no-undo.
      215   define input parameter p-task-num    as integer   no-undo.
      216   define input parameter p-code        as character no-undo.
      217   define input parameter p-value       as character no-undo.
      218       define variable v-type              as character                no-undo.
      219       define variable v-format            as character                no-undo.
      220       define variable v-label             as character                no-undo.
      221       define variable v-user-can-edit     as logical                  no-undo.
      222       define variable v-output-display    as logical                  no-undo.
      223       define variable v-other             as character                no-undo.
      224       define buffer buf_schedule-attr for ub.schedule-attr .
      225       run schedule-attr-name in this-procedure (
      226             input  p-code
      227           , output v-type
      228           , output v-format
      229           , output v-label
      230           , output v-user-can-edit
      231           , output v-output-display
      232           , output v-other
      233       ) no-error.
      234       if error-status :error
      235       then do:
      236           undo, return error return-value.
      237       end.
      238       find first buf_schedule-attr exclusive-lock
      239            where buf_schedule-attr.cre-db-num = p-cre-db-num
      240              and buf_schedule-attr.task-type  = p-task-type
      241              and buf_schedule-attr.task-num   = p-task-num
      242              and buf_schedule-attr.attr-code  = p-code
      243       no-error.
      244       if not available buf_schedule-attr
      245       then do:
      246           create buf_schedule-attr.
      247           assign
      248             buf_schedule-attr.cre-db-num = p-cre-db-num
      249             buf_schedule-attr.task-type  = p-task-type
      250             buf_schedule-attr.task-num   = p-task-num
      251             buf_schedule-attr.attr-code  = p-code
      252             buf_schedule-attr.attr-value = p-value
      253           .
      254       end.
      255       else do:
      256           assign
      257               buf_schedule-attr.attr-value = p-value
      258           .
      259       end.
      260   end.
      261   end procedure.
      262   procedure schedule-attr-delete :
      263   do
      264   on error undo, return error
      265   :
      266   define input  parameter p-cre-db-num  as integer   no-undo.
      267   define input  parameter p-task-type   as character no-undo.
      268   define input  parameter p-task-num    as integer   no-undo.
      269   define input  parameter p-code        as character no-undo.
      270   define output parameter p-deleted     as logical   no-undo.
      271       define buffer buf_schedule-attr for ub.schedule-attr .
      272       define variable v-type              as character                no-undo.
      273       define variable v-format            as character                no-undo.
      274       define variable v-label             as character                no-undo.
      275       define variable v-user-can-edit     as logical                  no-undo.
      276       define variable v-output-display    as logical                  no-undo.
      277       define variable v-other             as character                no-undo.
      278       run schedule-attr-name in this-procedure (
      279             input p-code
      280           , output v-type
      281           , output v-format
      282           , output v-label
      283           , output v-user-can-edit
      284           , output v-output-display
      285           , output v-other
      286       ) no-error .
      287       if error-status :error
      288       then do:
      289           undo, return error return-value .
      290       end.
      291       find first buf_schedule-attr exclusive-lock
      292            where buf_schedule-attr.cre-db-num = p-cre-db-num
      293              and buf_schedule-attr.task-type  = p-task-type
      294              and buf_schedule-attr.task-num   = p-task-num
      295              and buf_schedule-attr.attr-code  = p-code
      296       no-error.
      297       if not available buf_schedule-attr
      298       then do:
      299           assign
      300               p-deleted = no
      301           .
      302       end.
      303       else do:
      304           delete buf_schedule-attr.
      305           assign
      306               p-deleted = yes
      307           .
      308       end.
      309   end.
      310   end procedure.
      311   procedure schedule-attr-news :
      312   do
      313   on error undo, return error
      314   :
      315       define input  parameter p-code           as character no-undo .
      316       define output parameter p-news           as logical   no-undo .
      317       if index(p-code, chr(4)) > 0 then do:
      318         p-code = entry(1, p-code, chr(4)).
      319       end.
      320       case p-code :
      321               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      322               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      323               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      324               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      325               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      326               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      327               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      328               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      329               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      330         otherwise do:
      331           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      332         end.
      333       end.
      334   end.
      335   end procedure.
      336   procedure schedule-attr-extract-logical :
      337   do
      338   on error undo, return error
      339   :
      340   define input  parameter p-parameter-number   as integer      no-undo.
      341   define input  parameter p-parameter-list     as character    no-undo.
      342   define output parameter p-parameter-value   as logical      no-undo.
      343       if num-entries( p-parameter-list ) > p-parameter-number - 1
      344       then do:
      345           assign
      346               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      347           .
      348       end.
      349       else do:
      350           assign
      351               p-parameter-value   = no
      352           .
      353       end.
      354   end.
      355   end procedure.
      356   procedure schedule-attr-get-free-id :
      357   do
      358   on error undo, return error return-value
      359   :
      360     define input  parameter p-cre-db-num  as integer   no-undo.
      361     define input  parameter p-task-type   as character no-undo.
      362     define input  parameter p-task-num    as integer   no-undo.
      363     define output parameter p-free-id     as character no-undo.
      364     define buffer buf_schedule-attr for ub.schedule-attr.
      365     find first buf_schedule-attr no-lock
      366         where buf_schedule-attr.cre-db-num = p-cre-db-num
      367           and buf_schedule-attr.task-type  = p-task-type
      368           and buf_schedule-attr.task-num   = p-task-num
      369           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      370     no-error .
      371     if available buf_schedule-attr then
      372     assign
      373     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      374     no-error
      375     .
      376   end.
      377   end procedure.
      378   procedure schedule-attr-get-free-props :
      379     define input parameter p-free-id as character no-undo .
      380     define output parameter p-value as character no-undo .
      381     define buffer buf_temp-schedule-free for temp-schedule-free.
      382     do
      383     on error undo, return error return-value
      384     :
      385       find first buf_temp-schedule-free no-lock no-error .
      386       if not available buf_temp-schedule-free then do:
      387         run schedule-attr-fill-free-props in this-procedure .
      388       end.
      389       find first buf_temp-schedule-free where
      390               buf_temp-schedule-free.free-id = p-free-id no-error.
      391       if available buf_temp-schedule-free then do:
      392         assign
      393         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      394                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      395                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      396                   buf_temp-schedule-free.conf-param           + chr(4) +
      397                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      398                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      399                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      400                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      401                   buf_temp-schedule-free.other-info
      402         .
      403       end.
      404       else do:
      405        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      406                              "id произвольной задачи - &5"
      407                              ,vss-workfile
      408                              ,vss-revision
      409                              ,vss-description
      410                              ,chr(10)
      411                              ,p-free-id).
      412       end.
      413     end.
      414   end procedure.
      415   procedure schedule-attr-is-rum-free-id :
      416   define input parameter p-free-id as character no-undo .
      417   define output parameter p-is-rum as logical no-undo .
      418   define buffer buf_temp-schedule-free for temp-schedule-free.
      419   do
      420   on error undo, return error
      421   :
      422       find first buf_temp-schedule-free no-lock no-error .
      423       if not available buf_temp-schedule-free then do:
      424         run schedule-attr-fill-free-props in this-procedure .
      425       end.
      426       find first buf_temp-schedule-free where
      427               buf_temp-schedule-free.free-id = p-free-id no-error.
      428       if available buf_temp-schedule-free
      429       and buf_temp-schedule-free.is-rum
      430       then do:
      431         p-is-rum = yes.
      432       end.
      433   end.
      434   end procedure.
      435   procedure schedule-attr-fill-free-props :
      436   define variable v-path                    as character                no-undo .
      437   DEFINE VARIABLE v-full-path               as character                no-undo .
      438   DEFINE VARIABLE v-file-name               as character                no-undo .
      439   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      440   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      441   define buffer buf_temp-schedule-free for temp-schedule-free.
      442   define variable v-answer as logical no-undo .
      443     do
      444     on error undo, return error substitute("&1 &2 &3&4&5&4"
      445                                           ,vss-workfile
      446                                           ,vss-revision
      447                                           ,vss-description
      448                                           ,chr(10)
      449                                           ,error-status:get-message(1) )
      450     :
      451       run gbl/filename.p (
      452                       input 'cmp/shd-free.d'
      453                     ,output v-full-path
      454                     ,output v-path
      455                     ,output v-file-name
      456                     ,output v-file-name-no-ext
      457                     ,output v-file-name-ext
      458                     ) .
      459       input from value(v-full-path).
      460       repeat :
      461         create buf_temp-schedule-free.
      462         import buf_temp-schedule-free.
      463       END.
      464       input close.
      465       _ff:
      466       for each buf_temp-schedule-free :
      467         if buf_temp-schedule-free.free-id = '':U then do:
      468            delete buf_temp-schedule-free.
      469            next _ff.
      470          end.
      471          run schedule-attr-check-enc in this-procedure (
      472                                                       input  buf_temp-schedule-free.free-id
      473                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      474                                                               buf_temp-schedule-free.proc-param-edit-name +
      475                                                               buf_temp-schedule-free.conf-param +
      476                                                               string(buf_temp-schedule-free.is-gbd) +
      477                                                               string(buf_temp-schedule-free.is-ubd) +
      478                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      479                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      480                                                               string(buf_temp-schedule-free.other-info)
      481                                                               )
      482                                                       ,input  buf_temp-schedule-free.enc-key
      483                                                       ,output v-answer    ) no-error .
      484          if error-status:error
      485          or not v-answer then delete buf_temp-schedule-free.
      486        end.
      487     end.
      488   end procedure.
      489   Function schedule-attr-reverse returns character (str as character).
      490      define variable rev_incl_s as character init "" no-undo .
      491      define variable rev_incl_i as integer no-undo .
      492      define variable rev_incl_l as integer no-undo .
      493      rev_incl_l = length(str).
      494      do rev_incl_i = 1 to rev_incl_l:
      495         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      496      end.
      497      return rev_incl_s.
      498   end.
      499   procedure schedule-attr-check-enc.
      500     define input  parameter p-free-id   as character no-undo .
      501     define input  parameter p-value     as character no-undo .
      502     define input  parameter p-enc-value as character no-undo .
      503     define output parameter p-answer    as logical   no-undo .
      504     define variable tmp         as character no-undo .
      505     define variable v-enc-value as character no-undo .
      506     assign
      507     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      508     .
      509     run schedule-attr-pswd-enc in this-procedure
      510       ( input tmp
      511        ,output v-enc-value
      512       ) no-error .
      513     if error-status:error then do:
      514       message
      515         vss-workfile vss-revision vss-description skip
      516         "Ошибка при вызове процедуры pswd-enc" skip
      517         return-value skip
      518         error-status :get-message(1) skip
      519         view-as alert-box error .
      520       undo, return error .
      521     end.
      522     if v-enc-value = p-enc-value then do:
      523       assign
      524         p-answer = true
      525       .
      526     end.
      527     else do:
      528       assign
      529         p-answer = false
      530       .
      531     end.
      532   end.
      533   procedure schedule-attr-conf-enc.
      534     define input  parameter p-free-id   as character no-undo .
      535     define input  parameter p-value     as character no-undo .
      536     define output parameter p-enc-value as character no-undo .
      537     define variable tmp         as character no-undo .
      538     assign
      539       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      540     .
      541     run schedule-attr-pswd-enc in this-procedure
      542       ( input tmp
      543        ,output p-enc-value
      544       ) no-error .
      545     if error-status:error then do:
      546       message
      547         vss-workfile vss-revision vss-description skip
      548         "Ошибка при вызове процедуры pswd-enc" skip
      549         return-value skip
      550         error-status :get-message(1) skip
      551         view-as alert-box error .
      552       undo, return error .
      553     end.
      554   end procedure.
      555   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      556   procedure schedule-attr-pswd-enc :
      557     define input parameter  pswd     as character no-undo .
      558     define output parameter enc-pswd as character no-undo .
      559     do
      560     on error undo, return error return-value
      561     :
      562       assign
      563         enc-pswd = encode(pswd + string(index(pswd, "k")))
      564       .
      565     end.
      566   end procedure.
      567   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      568   define  shared variable g#auto-pid           as integer   no-undo .
      569   define  shared variable conn-par             as character no-undo .
      570   define  shared variable g#auto-user-id       as character no-undo .
      571   define  shared variable g#auto-user-login    as character no-undo .
      572   define  shared variable g#auto-user-password as character no-undo .
      573   define  shared variable v-socket             as logical   no-undo .
      574   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      575   define  shared variable auto-window-h     as handle    no-undo .
      576   define  shared variable auto-log-msg-h    as handle    no-undo .
      577   define  shared variable hand-log-msg-h    as handle    no-undo .
      578   define  shared variable log-file-name     as character no-undo initial ? .
      579   define  shared variable add-log-file-name as character no-undo initial ? .
      580   define  shared variable writelogvalue     as character no-undo initial ? .
      581   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      582   procedure cur-time :
      583      define output parameter p-today as date      no-undo .
      584      define output parameter p-time  as integer   no-undo .
      585     do
      586     on error undo, return error
      587     :
      588       define variable v-date1 as date      no-undo .
      589       define variable v-date2 as date      no-undo .
      590       define variable v-time  as integer   no-undo .
      591       assign
      592         v-date1 = today
      593         v-time  = time
      594         v-date2 = today
      595       .
      596       if v-date1 <> v-date2
      597       then do:
      598         assign
      599           v-date1 = today
      600           v-time  = v-time
      601         .
      602       end.
      603       assign
      604         p-today = v-date1
      605         p-time  = v-time
      606       .
      607     end.
      608   end.
      609   function cur-time-date returns character
      610   :
      611     return string(today, '99/99/9999':U) .
      612   end.
      613   function cur-time-mjd returns decimal
      614   :
      615     define variable v-date as date      no-undo .
      616     define variable v-time as integer   no-undo .
      617     run cur-time in this-procedure
      618       (output v-date
      619       ,output v-time
      620       ) .
      621     return integer(v-date) - 2400002 + (v-time / 86400) .
      622   end.
      623   function cur-time-get-ending-index returns integer
      624   (input p-number as integer
      625   )
      626   :
      627     if p-number < 0
      628     or p-number = ?
      629     then do:
      630       return 1 .
      631     end.
      632     define variable v-rest as integer   no-undo .
      633     assign
      634       p-number = p-number modulo 100
      635     .
      636     if p-number < 20
      637     then do:
      638       assign
      639         v-rest = p-number
      640       .
      641     end.
      642     else do:
      643       assign
      644         v-rest = p-number modulo 10
      645       .
      646     end.
      647     case v-rest :
      648       when 1
      649       then do:
      650         return 2 .
      651       end.
      652       when 2 or
      653       when 3 or
      654       when 4
      655       then do:
      656         return 3 .
      657       end.
      658       otherwise do:
      659         return 1 .
      660       end.
      661     end case .
      662   end.
      663   procedure cur-time-mjd-to-date :
      664      define input  parameter i-mjd-diff as decimal no-undo.
      665      define output parameter o-Date     as date    no-undo.
      666      define output parameter o-Time     as integer no-undo.
      667      define variable v-day-number as integer   no-undo .
      668      if    i-mjd-diff < 0
      669         or i-mjd-diff = ?
      670      then do:
      671         return "?" .
      672      end.
      673      assign
      674         v-day-number = truncate(i-mjd-diff,0).
      675         o-Date = date(v-day-number + 2400002).
      676         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      677     .
      678   end.
      679   function cur-time-mjd-to-string returns character
      680   (input p-mjd-diff as decimal
      681   )
      682   :
      683     define variable v-day-number as integer   no-undo .
      684     define variable v-seconds    as integer   no-undo .
      685     define variable v-hour       as integer   no-undo .
      686     define variable v-min        as integer   no-undo .
      687     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      688     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      689     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      690     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      691     if p-mjd-diff < 0
      692     or p-mjd-diff = ?
      693     then do:
      694       return "?" .
      695     end.
      696     assign
      697       v-day-number = integer(truncate(p-mjd-diff,0))
      698       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      699     .
      700     if v-seconds > 86400
      701     then do:
      702       assign
      703         v-seconds = 86400 - 1
      704       .
      705     end.
      706     if v-seconds < 0
      707     then do:
      708       assign
      709         v-seconds = 0
      710       .
      711     end.
      712     assign
      713       v-hour = truncate(v-seconds / 3600, 0)
      714     .
      715     assign
      716       v-seconds = v-seconds modulo 3600
      717     .
      718     assign
      719       v-min = truncate(v-seconds / 60, 0)
      720     .
      721     assign
      722       v-seconds = v-seconds modulo 60
      723     .
      724     return
      725         (if v-day-number <> 0
      726           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      727           else ""
      728         )
      729       + (if v-day-number <> 0 or v-hour <> 0
      730           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      731           else ""
      732         )
      733       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      734           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      735           else ""
      736         )
      737       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      738       .
      739   end.
      740   function cur-time-string returns character
      741   :
      742     define variable v-date as date      no-undo .
      743     define variable v-time as integer   no-undo .
      744     run cur-time in this-procedure
      745       (output v-date
      746       ,output v-time
      747       ) .
      748     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      749   end.
      750   function cur-time-string-sec returns character
      751   :
      752     define variable v-date as date      no-undo .
      753     define variable v-time as integer   no-undo .
      754     run cur-time in this-procedure
      755       (output v-date
      756       ,output v-time
      757       ) .
      758     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      759   end.
      760   function cur-time-custom  returns character
      761   (input p-prefix as character
      762   ,input p-date-format as character
      763   ,input p-delimiter as character
      764   ,input p-time-format as character
      765   ,input p-suffix as character
      766   )
      767   :
      768     define variable v-date as date      no-undo .
      769     define variable v-time as integer   no-undo .
      770     run cur-time in this-procedure
      771       (output v-date
      772       ,output v-time
      773       ) .
      774     return
      775       p-prefix
      776       + string(v-date, p-date-format)
      777       + p-delimiter
      778       + string(v-time, p-time-format)
      779       + p-suffix
      780       .
      781   end.
      782   function cur-time-print  returns character
      783   :
      784     define variable v-date as date      no-undo .
      785     define variable v-time as integer   no-undo .
      786     run cur-time in this-procedure
      787       (output v-date
      788       ,output v-time
      789       ) .
      790     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      791   end.
      792   function cur-time-datetime returns datetime
      793   :
      794     define variable v-char as character no-undo .
      795     define variable v-datetime as datetime no-undo .
      796     v-char = cur-time-string().
      797     v-datetime = datetime(v-char).
      798     return  v-datetime.
      799   end.
      800   function cur-time-string-msec returns character
      801   :
      802     define variable v-date as datetime  no-undo .
      803     v-date = now.
      804     return string(v-date) .
      805   end.
      806   define stream LogStream .
      807   define variable mNoTime as logical no-undo.
      808   procedure write-to-log-notime :
      809     define input param i-str as character no-undo .
      810     mNoTime = yes.
      811     run write-to-log (i-str).
      812     mNoTime = no.
      813   end.
      814   procedure write-to-log :
      815     define input param p-str as character no-undo .
      816     do
      817     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      818     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      819     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      820     :
      821       define variable log-res        as logical   no-undo .
      822       define variable v-jj           as integer   no-undo .
      823       if    mNoTime
      824          or writelogvalue eq "AsyncProc"
      825       then
      826          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      827       else
      828          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      829       if auto-log-msg-h <> ? then do:
      830         log-res = auto-log-msg-h:move-to-eof( ) .
      831         log-res = auto-log-msg-h:insert-string( p-str ).
      832       end.
      833       if hand-log-msg-h <> ? then do:
      834         log-res = hand-log-msg-h:move-to-eof( ) .
      835         log-res = hand-log-msg-h:insert-string( p-str ).
      836       end.
      837       assign
      838         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      839         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      840         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      841       .
      842       if add-log-file-name <> ? then do:
      843         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      844           run gbl/fileapnd.p
      845             ( input entry(v-jj, add-log-file-name, chr(1) )
      846             ,input p-str
      847             ,input 20
      848             ) no-error .
      849           if error-status:error then do:
      850             return error return-value .
      851           end.
      852         end.
      853       end.
      854       if writelogvalue eq "AsyncProc"
      855       then do:
      856          p-str = trim(p-str, (chr(13) + chr(10)) )
      857       .
      858          Publish "WriteLogAsunc" (p-str,yes).
      859       end.
      860       else if writelogvalue <> "yes" then do:
      861         run gbl/fileapnd.p
      862           ( input log-file-name
      863           ,input p-str
      864           ,input 20
      865           ) no-error .
      866         if error-status:error then do:
      867           return error return-value .
      868         end.
      869       end.
      870     end.
      871   end procedure.
      872   procedure write-to-screen :
      873     define input param p-str as character no-undo .
      874     do
      875     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      876     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      877     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      878     :
      879       define variable log-res as logical no-undo.
      880       assign
      881         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      882       .
      883       if auto-log-msg-h <> ?
      884       then do:
      885         log-res = auto-log-msg-h:move-to-eof( ) .
      886         log-res = auto-log-msg-h:insert-string( p-str ).
      887       end.
      888       if hand-log-msg-h <> ?
      889       then do:
      890         log-res = hand-log-msg-h:move-to-eof( ) .
      891         log-res = hand-log-msg-h:insert-string( p-str ).
      892       end.
      893     end.
      894   end procedure.
      895   procedure send-msg-to-email :
      896     define input  parameter p-subject      as character no-undo .
      897     define input  parameter p-text-err     as character no-undo .
      898     define input  parameter p-attach-files as character no-undo .
      899     do
      900     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      901     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      902     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      903     :
      904       define variable v-tth             as handle    no-undo .
      905       define variable v-value-character as character no-undo .
      906       define variable v-value-date      as date      no-undo .
      907       define variable v-value-decimal   as decimal   no-undo .
      908       define variable v-value-integer   as integer   no-undo .
      909       define variable v-value-logical   as logical   no-undo .
      910       define variable v-param-type      as character no-undo .
      911       define variable v-email       as character no-undo .
      912       define variable v-tmp-str     as character no-undo .
      913       define variable v-tmp1-str    as character no-undo .
      914       define variable v-ind         as integer   no-undo .
      915       define variable v-num-entries as integer   no-undo .
      916       delete object v-tth no-error.
      917       run adm/shattri.p
      918         ( input "get":U
      919          ,input  "":U
      920          ,input  0
      921          ,input  'auto-task':U
      922          ,input  'send-msg-to-email':U
      923          ,output v-value-character
      924          ,output v-value-date
      925          ,output v-value-decimal
      926          ,output v-value-integer
      927          ,output v-value-logical
      928          ,output v-param-type
      929          ,input-output table-handle v-tth
      930         ) no-error .
      931       if not error-status :error  then do:
      932         assign
      933           v-tmp-str = v-value-character
      934         .
      935       end.
      936       delete object v-tth no-error.
      937       assign
      938         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      939         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      940         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      941         v-num-entries = num-entries( v-tmp-str, chr(44) )
      942         v-email       = "":U
      943       .
      944       do v-ind = 1 to v-num-entries
      945       :
      946         assign
      947           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      948         .
      949         if trim( v-tmp1-str ) <> "":U then do:
      950           if v-email = "":U then do:
      951             assign
      952               v-email = v-tmp1-str
      953             .
      954           end.
      955           else do:
      956             assign
      957               v-email = v-email + chr(44) + v-tmp1-str
      958             .
      959           end.
      960         end.
      961       end.
      962       if v-email <> "":U then do:
      963         run gbl/sendmail.p
      964           ( input v-email
      965           , input p-subject
      966           , input p-text-err
      967           , input p-attach-files
      968           ) no-error .
      969         if error-status :error
      970           or return-value <> "":U
      971         then do:
      972           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      973         end.
      974       end.
      975     end.
      976   end procedure.
      977   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      978   define variable v-waitfram-action01         as character   no-undo .
      979   define variable v-waitfram-action02         as character   no-undo .
      980   define variable v-waitfram-action03         as character   no-undo .
      981   define variable mWaitFramTextBeg            as character   no-undo.
      982   define variable mWaitFramTextEnd            as character   no-undo.
      983   define variable mWaitFramView               as logical     no-undo.
      984   define variable mWaitProcEvent              as logical     no-undo init yes.
      985   define variable mWaitFramInterval           as integer     no-undo init 1 .
      986   define variable mWaitFramStop               as logical     no-undo.
      987   define variable mWaitFramStopUser           as logical     no-undo.
      988   define variable mWaitFramStopTimeOut        as logical     no-undo.
      989   define variable mWaitFramStartProc          as datetime-tz no-undo.
      990   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      991   define button B-WaitFramStop auto-end-key
      992        label "Стоп"
      993        size 10 by 1 tooltip "Остоновить процесс".
      994   define button B-viewProcInfo
      995        label "Информация"
      996        size 15 by 1 tooltip "Информация о процесс".
      997   define frame waitfram
      998     v-waitfram-action01 format "x(72)" no-label skip
      999     v-waitfram-action02 format "x(72)" no-label skip
     1000     v-waitfram-action03 format "x(72)" no-label skip
     1001     B-viewProcInfo
     1002     B-WaitFramStop at row 4 col 30
     1003     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1004     .
     1005   define new global shared variable mBatchMode as logical no-undo init ?.
     1006   define variable mFramBachModHandle as handle no-undo.
     1007   mFramBachModHandle = frame waitfram:handle.
     1008   define variable mFameOldVis as logical no-undo.
     1009   define variable mVisCUrentVin as logical no-undo.
     1010   if session:batch-mode
     1011   then
     1012      mBatchMode = yes.
     1013   if mBatchMode = ? then do:
     1014     mVisCUrentVin = current-window:visible.
     1015     mFameOldVis = mFramBachModHandle:visible.
     1016     mFramBachModHandle:visible  = yes.
     1017     mBatchMode = mFramBachModHandle:visible ne yes.
     1018     mFramBachModHandle:visible = mFameOldVis.
     1019     current-window:visible = mVisCUrentVin.
     1020   end.
     1021    if  log-manager:logfile-name ne ?
     1022     then DO:
     1023         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1024         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1025         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1026     end.
     1027   on choose of B-WaitFramStop in frame waitfram
     1028   do:
     1029     mWaitFramStop = yes.
     1030     mWaitFramStopUser = yes.
     1031   end.
     1032   function waitfram-check-timeout returns logical():
     1033      define variable vtime as int64 no-undo.
     1034      if mWaitFramStopTimeOut
     1035      then
     1036         return yes.
     1037      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1038      if     mWaitFramTimeOut ne ?
     1039         and mWaitFramTimeOut ne 0
     1040         and mWaitFramTimeOut lt vtime
     1041      then do:
     1042         mWaitFramStopTimeOut = yes.
     1043      end.
     1044      return mWaitFramStopTimeOut.
     1045   end.
     1046   procedure waitfram-hide :
     1047     if not session:batch-mode
     1048     then do
     1049     on error undo, return error return-value
     1050     :
     1051       pause 0 before-hide .
     1052       if not mBatchMode then
     1053         hide frame waitfram .
     1054     if     not mWaitFramView
     1055        and mWaitProcEvent
     1056     then
     1057       process events .
     1058     end.
     1059   end procedure.
     1060   procedure waitfram-show :
     1061     define input  parameter p-message as character no-undo .
     1062     define variable v-left-margin as integer   no-undo .
     1063     if not session:batch-mode
     1064     then do
     1065     on error undo, return error return-value
     1066     :
     1067       if length(p-message) <= 70 then do:
     1068         assign
     1069           v-left-margin = integer((70 - length(p-message)) / 2)
     1070         .
     1071         assign
     1072           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1073         .
     1074         assign
     1075           v-waitfram-action01 = " "
     1076           v-waitfram-action02 = " "
     1077                                    + fill(" ", v-left-margin)
     1078                                    + p-message
     1079           v-waitfram-action03 = " "
     1080         .
     1081       end.
     1082       else do:
     1083         define variable vRindex1 as integer no-undo.
     1084         define variable vRindex2 as integer no-undo.
     1085         vRindex1 = r-index(p-message," ",70).
     1086         if vRindex1 = 0
     1087         then
     1088            vRindex1 = 70.
     1089         if length(p-message)  <= vRindex1 + 70 then do:
     1090           assign
     1091             v-waitfram-action01 = " "
     1092             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1093             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1094           .
     1095         end.
     1096         else do:
     1097           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1098           if vRindex2 <= vRindex1
     1099           then
     1100              vRindex2 = vRindex1 + 70.
     1101           assign
     1102             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1103             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1104             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1105           .
     1106         end.
     1107       end.
     1108       B-viewProcInfo:visible   in frame waitfram = no.
     1109       B-viewProcInfo:sensitive in frame waitfram = no.
     1110       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1111       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1112       if  (   mWaitFramView
     1113          or  mWaitProcEvent)
     1114          and not mBatchMode
     1115       then
     1116          display
     1117             v-waitfram-action01 skip
     1118             v-waitfram-action02 skip
     1119             v-waitfram-action03 skip
     1120          with frame waitfram .
     1121       if     mWaitFramView
     1122          then do:
     1123             if     mWaitFramInterval ne ?
     1124                and not mBatchMode
     1125             then
     1126                wait-for go of frame waitfram pause mWaitFramInterval.
     1127          end.
     1128          else
     1129             if     mWaitProcEvent
     1130                and not mBatchMode
     1131             then
     1132                process events .
     1133     end.
     1134   end procedure.
     1135      procedure waitfram-show-this:
     1136         define input  parameter iInterval as int64 no-undo.
     1137         define variable vtime as int64 no-undo.
     1138         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1139         mWaitFramInterval = iInterval.
     1140         run waitfram-show (substitute("&1&2 &3&4" ,
     1141                                       mWaitFramTextBeg ,
     1142                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1143                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1144                                       mWaitFramTextEnd
     1145                                      )
     1146                           ).
     1147      end.
     1148      procedure WaitFramRunPause:
     1149         define input  parameter iInterval as dec no-undo.
     1150         define variable vStart  as datetime-tz no-undo.
     1151         define variable vend    as datetime-tz no-undo.
     1152         define variable vint as int64 no-undo.
     1153         define variable vOk as logical no-undo.
     1154         vStart = now.
     1155         vend   = vStart.
     1156         publish "WaitFramPause" (iInterval,output vOk).
     1157         vend   =  now.
     1158         vint = vend - vStart.
     1159         vint = iInterval - vint / 1000.
     1160         if     not mWaitFramStop
     1161            and (   vint > 0
     1162                 or (    not vOk
     1163                     and iInterval eq ?
     1164                     )
     1165                 )
     1166         then
     1167            run waitfram-show-this (iInterval).
     1168         vend   =  now.
     1169         vint = vend - vStart.
     1170         vint = iInterval - vint / 1000.
     1171         if     not mWaitFramStop
     1172            and vint > 0
     1173         then do:
     1174            run gbl/pause.p (vint * 1000).
     1175         end.
     1176         if iInterval ne ?
     1177         then
     1178            publish "WaitFramStop".
     1179         waitfram-check-timeout().
     1180      end.
     1181      procedure WaitFramWaitFor:
     1182         define input  parameter iInterval as dec no-undo.
     1183         assign
     1184            mWaitFramStartProc   = now
     1185            mWaitFramStopUser    = no
     1186            mWaitFramStopTimeOut = no
     1187         .
     1188         block-wait:
     1189         do while not mWaitFramStop:
     1190            run WaitFramRunPause (iInterval).
     1191            if  waitfram-check-timeout()
     1192            then do:
     1193               leave block-wait.
     1194            end.
     1195         end.
     1196         run waitfram-hide.
     1197      end.
     1198   procedure waitfram-join :
     1199     define input  parameter p-line-1  as character no-undo .
     1200     define input  parameter p-line-2  as character no-undo .
     1201     define input  parameter p-line-3  as character no-undo .
     1202     define output parameter p-message as character no-undo .
     1203     do
     1204     on error undo, return error return-value
     1205     :
     1206       assign
     1207         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1208                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1209                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1210       .
     1211     end.
     1212   end procedure.
     1213   function waitfram-join-function returns character
     1214     (input p-line-1 as character
     1215     ,input p-line-2 as character
     1216     ,input p-line-3 as character
     1217     ).
     1218     define variable v-message as character no-undo .
     1219     run waitfram-join in this-procedure
     1220       (input  p-line-1
     1221       ,input  p-line-2
     1222       ,input  p-line-3
     1223       ,output v-message
     1224       ) .
     1225     return v-message .
     1226   end function .
     1227   define buffer buf_BatchProcess for ub.BatchProcess.
     1228   define variable v-task-num        as integer      no-undo.
     1229   define variable v-param-list      as character    no-undo.
     1230   define variable v-param-type      as character    no-undo.
     1231   define variable v-rec-extsys-list as character    no-undo.
     1232   define variable ii as integer no-undo.
     1233   define variable kk as integer no-undo.
     1234   define variable j as integer no-undo.
     1235   define variable v-last-num-pck as integer no-undo.
     1236   define variable v-rec-ext-sys as recid no-undo.
     1237   define variable v-day-shift as integer no-undo.
     1238   run schedule-attr-value in this-procedure (
     1239     input integer(p-db-num-char)
     1240     , input p-task-type
     1241     , input p-task-num
     1242     , input 'schedule-param-list':U
     1243     , output v-param-list
     1244     , output v-param-type
     1245     ) no-error.
     1246   for each buf_BatchProcess exclusive-lock
     1247     where buf_BatchProcess.BP_Status         = 'N':U
     1248       and buf_BatchProcess.BP_Type           = 'autooxml':U
     1249       and buf_BatchProcess.CharKey_Two       = "auto":U
     1250       and ( buf_BatchProcess.BP_ExecSysDate <= today - 1 )
     1251       and num-entries (buf_BatchProcess.CharKey_Three, chr(3)) > 3
     1252     :
     1253     delete buf_BatchProcess.
     1254   end.
     1255   run write-log-and-file in p-log-handle (      input 1                                                          , input log-file-name                                              , input 1                                                          , input SUBSTITUTE("Удаление маршрутизации ВС.")).
     1256   if v-param-list <> "" then
     1257   do:
     1258     assign
     1259       v-rec-extsys-list = entry (1, v-param-list, "!")
     1260       v-day-shift = integer(entry (2, v-param-list, "!"))
     1261     .
     1262       run write-log-and-file in p-log-handle (      input 1                                                          , input log-file-name                                              , input 1                                                          , input SUBSTITUTE("Установлено &1 дн. хранения пакетов.", v-day-shift)).
     1263     do j = 1 to num-entries (v-rec-extsys-list, ',') .
     1264       assign
     1265         v-rec-ext-sys =  integer (entry (j, v-rec-extsys-list, ',')).
     1266       find first ub.ext-system no-lock where recid(ub.ext-system) = v-rec-ext-sys no-error.
     1267       if not available ub.ext-system then next .
     1268           run write-log-and-file in p-log-handle (      input 1                                                          , input log-file-name                                              , input 1                                                          , input SUBSTITUTE("ВС " + ub.ext-system.esys-name + " № " + string (ub.ext-system.esys-id) + ". Удаление..." )).
     1269       find last ub.esys-pck-sent no-lock where ub.esys-pck-sent.esps-rcvd = no
     1270         and ub.esys-pck-sent.esys-id = ub.ext-system.esys-id
     1271         and ub.esys-pck-sent.esps-sendtxtdate <= today - v-day-shift use-index pi no-error.
     1272       if available ub.esys-pck-sent then assign v-last-num-pck = ub.esys-pck-sent.esps-pack-num .
     1273       release ub.esys-pck-sent.
     1274       for each ub.esys-pck-sent share-lock where ub.esys-pck-sent.esps-rcvd = no
     1275         and ub.esys-pck-sent.esys-id = ub.ext-system.esys-id
     1276         and ub.esys-pck-sent.esps-sendtxtdate <= today - v-day-shift by esps-pack-num
     1277       :
     1278         run waitfram-show in this-procedure (INPUT substitute ("Удаление маршрутизации: Пакет № &1 (посл. пакет № &2)",  string (esys-pck-sent.esps-pack-num), v-last-num-pck)).
     1279         do transaction.
     1280           for each ub.esys-route share-lock where
     1281                         ub.esys-route.esys-id = ub.esys-pck-sent.esys-id
     1282                     and ub.esys-route.db-num = ub.esys-pck-sent.db-num
     1283                     and ub.esys-route.esr-cr-db-num = ub.esys-pck-sent.esps-cr-db-num
     1284                     and ub.esys-route.esr-last-pack = ub.esys-pck-sent.esps-pack-num :
     1285               delete ub.esys-route.
     1286               ii = ii + 1 .
     1287               if ii mod 10 = 0 then run waitfram-show in this-procedure (INPUT substitute ("Удаление маршрутизации: Пакет № &1 (посл. пакет № &2). Удалено записей в пакете &3",  string (ub.esys-pck-sent.esps-pack-num), v-last-num-pck, string (ii))).
     1288           end.
     1289           ub.esys-pck-sent.esps-rcvd = yes.
     1290           ii = 0 .
     1291         end .
     1292         assign
     1293           kk = kk + 1.
     1294       end.
     1295           run write-log-and-file in p-log-handle (      input 1                                                          , input log-file-name                                              , input 1                                                          , input SUBSTITUTE("Удалено &1 пакетов ВС № &2.", kk, ub.ext-system.esys-id)).
     1296       assign
     1297         kk = 0 .
     1298     end.
     1299       run write-log-and-file in p-log-handle (      input 1                                                          , input log-file-name                                              , input 1                                                          , input SUBSTITUTE("Удаление завершено.")).
     1300   end.
     1301   else do:
     1302       run write-log-and-file in p-log-handle (      input 1                                                          , input log-file-name                                              , input 1                                                          , input SUBSTITUTE("Не заданны параметры удаления. Удаление завершено.")).
     1303   end.
