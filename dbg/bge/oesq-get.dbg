      220   procedure db-attr-batch-edit :
      221     define input  parameter p-code           as character no-undo .
      222     define output parameter p-section-num    as integer no-undo .
      223     do
      224     on error undo, return error
      225     :
      226           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-batch-edit in g#attr-lib
      227         (input  p-code
      228         ,output p-section-num
