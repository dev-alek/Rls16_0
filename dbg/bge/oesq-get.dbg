      116     define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      117     define output parameter p-value     like ub.db-attr.attr-value no-undo .
      118     define output parameter p-type      as character no-undo .
      119     do
      120     on error undo, return error
      121     :
      122           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-value in g#attr-lib
      123         (input  p-db-num
      124         ,input  p-code
      125         ,output p-value
      126         ,output p-type
      127         ) no-error .
      128       if error-status :error
      129       then do:
      130         undo, return error return-value .
      131       end.
      132     end.
      133   end procedure.
      134   procedure db-attr-write :
      135     define input parameter p-db-num    like ub.db-attr.db-num     no-undo .
      136     define input parameter p-code      like ub.db-attr.attr-code  no-undo .
      137     define input parameter p-value     like ub.db-attr.attr-value no-undo .
      138     do
      139     on error undo, return error
      140     :
      141           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-write in g#attr-lib
      142         (input p-db-num
      143         ,input p-code
      144         ,input p-value
      145         ) no-error .
      146       if error-status :error
      147       then do:
      148         undo, return error return-value .
      149       end.
      150     end.
      151   end procedure.
      152   procedure db-attr-exist :
      153     define input  parameter p-db-num    like ub.db-attr.db-num     no-undo .
      154     define input  parameter p-code      like ub.db-attr.attr-code  no-undo .
      155     define output parameter p-exist    as logical  no-undo .
      156     do
      157     on error undo, return error
      158     :
      159           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-exist in g#attr-lib
      160         (input  p-db-num
      161         ,input  p-code
      162         ,output p-exist
      163         ) no-error .
      164       if error-status :error
