      236   define buffer buf_sys-ctrl for ub.sys-ctrl.
      237   define variable v-db-attr-exist as logical   no-undo .
      238   define variable v-db-attr-value as character no-undo .
      239   define variable v-db-attr-type  as character no-undo .
      240   define variable v-ora-exp-seq   as integer   no-undo .
      241   do for
      242     buf_sys-ctrl
      243   on error undo, return error return-value
      244   :
      245     find first buf_sys-ctrl no-lock no-error .
      246     if not available buf_sys-ctrl
      247     then do:
      248       undo , return error "Не найдена запись sys-ctrl!" .
      249     end.
      250     run db-attr-exist in this-procedure ( input buf_sys-ctrl.db-num
      251                                         , input 'ora-exp-seq':U
      252                                         , output v-db-attr-exist
      253                                         ) no-error.
      254     if error-status :error
      255     then do:
      256       undo , return error substitute( "Ошибка при определении атрибута номера выгрузки Oracle Retail &1 для БД &2"
      257                                     , 'ora-exp-seq':U
      258                                     , buf_sys-ctrl.db-num
      259                                     ).
      260     end.
      261     if v-db-attr-exist = no
      262     then do:
      263       assign
      264         v-db-attr-value = "1":U
      265       .
      266       run db-attr-write in this-procedure ( input buf_sys-ctrl.db-num
      267                                           , input 'ora-exp-seq':U
      268                                           , input v-db-attr-value
      269                                           ) no-error .
      270       if error-status :error
      271       then do:
      272         undo , return error substitute( "Ошибка инициализации параметра номера выгрузки Oracle Retail &1 для БД &2, значение параметра &3"
      273                                       , 'ora-exp-seq':U
      274                                       , buf_sys-ctrl.db-num
      275                                       , v-db-attr-value
      276                                       ).
      277       end.
      278     end.
      279     else do:
      280       run db-attr-value in this-procedure ( input buf_sys-ctrl.db-num
      281                                           , input 'ora-exp-seq':U
      282                                           , output v-db-attr-value
      283                                           , output v-db-attr-type
      284                                           ) no-error .
      285       if error-status :error
      286       then do:
      287         undo, return error substitute( "Ошибка чтения параметра номера выгрузки Oracle Retail &1 для БД &2"
      288                                      , 'ora-exp-seq':U
      289                                      , buf_sys-ctrl.db-num
      290                                      ).
      291       end.
      292     end.
      293     assign
      294       v-ora-exp-seq = int(v-db-attr-value)
      295     no-error .
      296     if error-status :error
      297     then do:
      298       undo, return error substitute( "Ошибка преобразования параметра номера выгрузки Oracle Retail &1 к числу.&2&3"
      299                                     , 'ora-exp-seq':U
      300                                     , chr(10)
      301                                     , error-status :get-message(1)
      302                                     ).
      303     end.
      304     assign
      305       p-ora-exp-seq = v-ora-exp-seq
      306       v-ora-exp-seq = v-ora-exp-seq + 1
      307     .
      308     run bge/oesq-set.p ( input v-ora-exp-seq ) .
      309   end.
