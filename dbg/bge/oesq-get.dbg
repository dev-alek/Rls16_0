      204   procedure db-attr-manual-edit :
      205     define input  parameter p-code           as character no-undo .
      206     define output parameter p-section-num    as integer no-undo .
      207     do
      208     on error undo, return error
      209     :
      210           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-manual-edit in g#attr-lib
      211         (input  p-code
