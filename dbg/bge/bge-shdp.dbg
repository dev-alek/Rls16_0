     1699        and
     1700        self :sensitive = true
     1701        )
     1702     or (can-query (self, "read-only")
     1703        and
     1704        self :read-only = false
     1705        )
     1706     then do:
     1707       assign
     1708         self :screen-value = ?
     1709       .
     1710     end.
     1711     return no-apply.
     1712   end.
