     1020         ,output v-select-obj-type
     1021         ,output v-select-obj-code
     1022         ) .
     1023     end.
     1024   end.
     1025   procedure thobjs :
     1026      define input        parameter parparentproc     as widget-handle no-undo .
     1027      define input        parameter i-bttns           as character     no-undo .
     1028      define input        parameter i-list-mode       as character     no-undo.
     1029      define input        parameter i-obj-type        as character     no-undo.
     1030      define input        parameter i-db-num          as integer       no-undo.
     1031      define input        parameter i-host-code       as integer       no-undo.
     1032      define input-output parameter p-rid-list        as character     no-undo .
     1033   run ref/thobjs.p
     1034           ( input parparentproc
     1035            ,input  this-procedure :handle
