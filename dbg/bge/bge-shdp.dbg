     1251        rs-1 AT ROW 12.5 COL 3.5 NO-LABEL
     1252        ed-object AT ROW 12.5 COL 20.88 NO-LABEL
     1253        bt-sel-obj AT ROW 14.79 COL 17.38
     1254        ed-doc-type AT ROW 16.71 COL 16.88 NO-LABEL
     1255        ed-doc-type-title AT ROW 16.79 COL 3 NO-LABEL
     1256        bt-sel-doc-type AT ROW 17.38 COL 58.13
     1257        tb-inkass-pay-code AT ROW 19.58 COL 3.13
     1258        tb-cst-code AT ROW 19.58 COL 33.13
     1259        tb-chk-pay-code AT ROW 20.42 COL 3.13
     1260        tb-parts AT ROW 20.42 COL 33.13
     1261        tb-pay-desk AT ROW 21.21 COL 6.13
     1262        tb-not-fact-docs AT ROW 21.21 COL 33.13
     1263        tb-pay-desk-cards AT ROW 22 COL 6.13
     1264        fi-dates-title AT ROW 7.08 COL 1 COLON-ALIGNED NO-LABEL
     1265        fi-doc-options AT ROW 18.79 COL 1 COLON-ALIGNED NO-LABEL
     1266        " Список выгрузки:" VIEW-AS TEXT
     1267             SIZE 18.88 BY .79 AT ROW 2.63 COL 4
     1268        rct-dates AT ROW 7.29 COL 2
     1269        rct-obj AT ROW 12 COL 2
     1270        rct-doc-type AT ROW 16.5 COL 2
     1271        rct-doc-options AT ROW 19 COL 2
     1272        RECT-5 AT ROW 3 COL 2.25
     1273        SPACE(0.37) SKIP(16.28)
     1274       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1275            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1276            TITLE "Параметры экспорта по расписанию"
     1277            CANCEL-BUTTON Btn_Cancel.
     1278   ASSIGN
     1279          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1280          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1281   ASSIGN
     1282          ed-doc-type:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1283   ASSIGN
     1284          ed-object:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1285   ASSIGN
     1286          tb-supp:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1287   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1288   DO:
     1289     APPLY "END-ERROR":U TO SELF.
     1290   END.
     1291   ON CHOOSE OF bt-sel-doc-type IN FRAME Dialog-Frame
     1292   DO:
     1293       define variable v-cancel     as logical           no-undo.
     1294       define variable v-oper-num   as integer           no-undo.
     1295       define variable v-doc-type-select as character no-undo .
     1296       assign
     1297       v-doc-type-select = (if input frame Dialog-Frame tb-exp-doc then "trn-doc":U else "":U)
     1298       v-doc-type-select = (if input frame Dialog-Frame tb-exp-fp
     1299                           then (v-doc-type-select + (if v-doc-type-select = "":U then "":U else chr(44)) + "fin-doc":U)
     1300                           else v-doc-type-select)
     1301       .
     1302       run bge/bgeseltp.w (
     1303             input v-doc-type-select
     1304           , input v-init-doc-type-list
     1305           , output v-doc-type-list
     1306           , output v-cancel
     1307       ) no-error.
     1308       if error-status :error
     1309       then do:
     1310           message
     1311             vss-workfile vss-revision vss-description
     1312             skip "Ошибка выбора типов операций."
     1313             skip return-value
     1314             skip trim(error-status :get-message(1))
     1315                  trim(error-status :get-message(2))
     1316                  trim(error-status :get-message(3))
     1317                  trim(error-status :get-message(4))
     1318                  trim(error-status :get-message(5))
     1319           view-as alert-box error.
     1320           undo, return no-apply .
     1321       end.
     1322       if v-cancel = yes
     1323       then do:
     1324           assign
     1325               v-doc-type-list = v-init-doc-type-list
     1326           .
     1327       end.
     1328       else do:
     1329           assign
     1330               v-init-doc-type-list    = v-doc-type-list
     1331           .
     1332           if v-doc-type-list = ''
     1333           then do:
     1334               assign
     1335                   ed-doc-type :screen-value in frame Dialog-Frame = "Все"
     1336               .
     1337           end.
     1338           else do:
     1339               assign
     1340                   ed-doc-type :screen-value in frame Dialog-Frame = ''
     1341               .
     1342               do v-oper-num = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1343               :
     1344                   if lookup( entry( v-oper-num, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ), v-init-doc-type-list ) <> 0
     1345                   then do:
     1346                       assign
     1347                           ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
     1348                                                       + entry( v-oper-num, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) + chr(10)
     1349                       .
     1350                   end.
     1351               end.
     1352               do v-oper-num = 1 to num-entries( 'пко,рко,ппп,рпп,апп,апр,':U )
     1353               :
     1354                   if lookup( entry( v-oper-num, 'пко,рко,ппп,рпп,апп,апр,':U ), v-init-doc-type-list ) <> 0
     1355                   then do:
     1356                       assign
     1357                           ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
     1358                                                       + entry( v-oper-num, 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,апп,апр':U ) + chr(10)
     1359                       .
     1360                   end.
     1361               end.
     1362           end.
     1363       end.
     1364   END.
     1365   ON CHOOSE OF bt-sel-obj IN FRAME Dialog-Frame
     1366   DO:
     1367       define variable v-obj-list           as character no-undo .
     1368       define variable v-exclude-obj-list   as character no-undo .
     1369       define variable v-object-available as logical   no-undo .
     1370       assign
     1371           rs-1 :screen-value  = "3"
     1372       .
     1373   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1374   run userobjs_clear in this-procedure  .
     1375   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1376   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
     1377     (input  v-cntxt-db-num
     1378     ,input  0
     1379     ,input  v-cntxt-userid
     1380     ,input  v-cntxt-obj-type
     1381     ,input  v-cntxt-obj-code
     1382     ,output v-object-available
     1383     ) no-error .
     1384       if error-status :error
     1385       then do:
     1386         message
     1387           vss-workfile vss-revision vss-description skip
     1388           "Ошибка при вызове процедуры gbl/usobjava.i" skip
     1389           error-status :get-message(1) skip
     1390           return-value skip
     1391           view-as alert-box error .
     1392         undo, return no-apply .
     1393       end.
     1394       if v-object-available = true
     1395       then do:
     1396   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1397   run userobjs_append in this-procedure
     1398     (input  v-cntxt-obj-type
     1399     ,input  v-cntxt-obj-code
     1400     )  .
     1401       end.
     1402       for each temp_obj-list
     1403       :
     1404   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1405   run userobjs_append in this-procedure
     1406     (input  temp_obj-list.obj-type
     1407     ,input  temp_obj-list.obj-code
     1408     )  .
     1409       end.
     1410       define variable v-user-select as logical   no-undo .
     1411   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1412   run userobjs_select-many in this-procedure
     1413     (input  parparentproc
     1414     ,input  v-cntxt-db-num
     1415     ,input  v-cntxt-userid
     1416     ,input  v-cntxt-host-code-obj
     1417     ,input  v-cntxt-obj-type
     1418     ,input  v-cntxt-obj-code
     1419     ,output v-user-select
     1420     )  .
     1421       if v-user-select = true
     1422       then do:
     1423           empty temp-table temp_obj-list.
     1424       end.
     1425       else do:
     1426           message
     1427               "Объект не выбран"
     1428           view-as alert-box information
     1429           title "Выбор объекта".
     1430           return no-apply .
     1431       end.
     1432       define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1433       for each buf_userobjs_temp-user-obj
     1434       on error undo, return no-apply
     1435       :
     1436         create temp_obj-list .
     1437         assign
     1438           temp_obj-list.obj-type = buf_userobjs_temp-user-obj.obj-type
     1439           temp_obj-list.obj-code = buf_userobjs_temp-user-obj.obj-code
     1440         .
     1441       end.
     1442       run select-objects-only-this-db in this-procedure
     1443         (output v-obj-list
     1444         ,output v-exclude-obj-list
     1445         ).
     1446       if v-exclude-obj-list <> ""
     1447       then do:
     1448           message
     1449               "Из списка выбранных объектов исключены"
     1450               skip "объекты, не принадлежащие БД, указанной в расписании:"
     1451               skip(1)
     1452               skip v-exclude-obj-list
     1453           view-as alert-box information.
     1454       end.
     1455       assign
     1456           ed-object :screen-value = v-obj-list
     1457       .
     1458   END.
     1459   ON CHOOSE OF Btn_Cancel IN FRAME Dialog-Frame
     1460   DO:
     1461       assign
     1462           p-cancel = yes
     1463       .
     1464   END.
     1465   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     1466   DO:
     1467       define variable v-obj-list as character     no-undo.
     1468       ASSIGN
     1469           rs-date
     1470           fi-days-amount
     1471           fi-days-ago
     1472           fi-date-from
     1473           fi-date-to
     1474           rs-1
     1475           tb-supp
     1476           tb-inkass-pay-code
     1477           tb-cst-code
     1478           tb-parts
     1479           tb-chk-pay-code
     1480           tb-pay-desk
     1481           tb-pay-desk-cards
     1482           tb-not-fact-docs
     1483           tb-exp-doc
     1484           tb-exp-doc-rvs
     1485           tb-exp-ref
     1486           tb-exp-day
     1487           tb-exp-way
     1488           tb-exp-ref-ext
     1489           tb-exp-stk
     1490           tb-exp-stk-supp
     1491           tb-incr
     1492           tb-exp-checks
     1493           tb-exp-fo
     1494           tb-exp-fp
     1495           tb-exp-s-f
     1496       .
     1497       if tb-exp-doc  = no
     1498       and tb-exp-ref = no
     1499       and tb-exp-fo  = no
     1500       and tb-exp-fp  = no
     1501       and tb-exp-s-f = no
     1502       and ( ( tb-exp-day = no
     1503               and tb-exp-way = no
     1504               and tb-exp-stk = no )
     1505          or ( tb-incr = yes ) )
     1506       then do:
     1507           message
     1508               skip "Выберите по крайней мере один тип выгрузки"
     1509               skip "или отмените ввод параметров выгрузки."
     1510           view-as alert-box warning
     1511           buttons ok
     1512           title "Не выбран тип выгрузки".
     1513           undo, return no-apply.
     1514       end.
     1515       case rs-1
     1516       :
     1517       when 1
     1518       then do:
     1519           assign
     1520               v-obj-list = ""
     1521           .
     1522       end.
     1523       when 2
     1524       then do:
     1525           assign
     1526               v-obj-list = ""
     1527           .
     1528       end.
     1529       when 3
     1530       then do:
     1531           assign
     1532               v-obj-list = ""
     1533           .
     1534           for each temp_obj-list
     1535           :
     1536               assign
     1537                   v-obj-list = v-obj-list
     1538                           + ( if v-obj-list = "" then "" else "," ) + temp_obj-list.obj-type
     1539                           + "," + string( temp_obj-list.obj-code )
     1540               .
     1541           end.
     1542       end.
     1543       end case.
     1544       find first temp_obj-list no-error.
     1545       if not available temp_obj-list
     1546       and rs-1 = 3
     1547       then do:
     1548           message
     1549               "Не выбраны объекты для выгрузки."
     1550           view-as alert-box warning.
     1551           undo, return no-apply.
     1552       end.
     1553       run attach-attr-to-schedule-line in this-procedure (
     1554             input rs-date
     1555           , input fi-days-amount
     1556           , input fi-days-ago
     1557           , input fi-date-from
     1558           , input fi-date-to
     1559           , input rs-1
     1560           , input v-obj-list
     1561           , input v-doc-type-list
