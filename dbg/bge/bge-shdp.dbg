     2144   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2145   on help of frame Dialog-Frame
     2146   do:
     2147     run gbl/app_help.p
     2148       (input this-procedure :file-name
     2149       ,input ''
     2150       ,input ?
     2151       ) no-error.
     2152     if error-status :error then do:
     2153       message
     2154         "Ошибка при вызове помощи"
     2155         error-status :get-message(1)
     2156         view-as alert-box .
     2157     end.
     2158   end.
     2159   run minbtn-set in this-procedure .
     2160   on choose of b-help in frame Dialog-Frame
     2161   do:
     2162     apply "help":u to frame Dialog-Frame .
     2163   end.
     2164   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2165   procedure minbtn-set :
     2166       do
     2167           on error undo, return error return-value
     2168           :
     2169           define variable ii              as integer       no-undo .
     2170           define variable fh              as widget-handle no-undo .
     2171           define variable hh              as widget-handle no-undo .
     2172           define variable v-h             as handle        extent 4 no-undo .
     2173           define variable v-name-button   as character     no-undo .
     2174           define variable v-help-old-x    as decimal       no-undo .
     2175           define variable v-help-old-y    as decimal       no-undo .
     2176           define variable v-help-old-size as decimal       no-undo .
     2177           define variable v-frame-width   as decimal       no-undo .
     2178           define variable jj              as integer       no-undo .
     2179           do
     2180               on error undo, return error
     2181               :
     2182               assign
     2183                   v-frame-width = frame Dialog-Frame:width - 0.3
     2184                   fh            = frame Dialog-Frame:first-child
     2185                   hh            = fh:first-child
     2186                   ii            = 1
     2187                   .
     2188               do while valid-handle(hh):
     2189                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2190                   do:
     2191                       case lc(hh:name) :
     2192                           when "b-help" then
     2193                               do:
     2194                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2195                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2196                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2197                                   hh:TOOLTIP = "Помощь" .
     2198                                   v-help-old-x = hh:column .
     2199                                   v-help-old-y = hh:row    .
     2200                                   v-help-old-size = hh:width .
     2201                                   hh:width-chars = 2.5 .
     2202                               end.
     2203                           when "b-print" then
     2204                               do:
     2205                                   hh:load-image("cmp/b-print.bmp":u) .
     2206                                   hh:TOOLTIP = "Печать" .
     2207                                   v-h[ii] = hh:handle .
     2208                                   ii = ii + 1 .
     2209                                   hh:width-chars = 3 .
     2210                               end.
     2211                           when "b-history" or
     2212                           when "b-hist" then
     2213                               do:
     2214                                   hh:load-image("cmp/b-hist.bmp":u) .
     2215                                   hh:TOOLTIP = "История" .
     2216                                   v-h[ii] = hh:handle .
     2217                                   ii = ii + 1 .
     2218                                   hh:width-chars = 3 .
     2219                               end.
     2220                           when "b-sch" then
     2221                               do:
     2222                                   hh:load-image("cmp/b-sch.bmp":u) .
     2223                                   hh:TOOLTIP = "Установка Фильтра" .
     2224                                   v-h[ii] = hh:handle .
     2225                                   ii = ii + 1 .
     2226                                   hh:width-chars = 3 .
     2227                               end.
     2228                           when "b-hist-user" then
     2229                               do:
     2230                                   hh:load-image("cmp/b-hist.bmp":u) .
     2231                                   hh:TOOLTIP = "История пользователя" .
     2232                                   ii = ii + 1 .
     2233                               end.
     2234                       end case.
     2235                   end.
     2236                   hh = hh:next-sibling.
     2237               end.
     2238               b-help:column = v-frame-width - b-help:width-chars.
     2239               jj = 0.
     2240               repeat ii = 4 to 1 by -1 :
     2241                   if valid-handle (v-h[ii] ) then
     2242                   do:
     2243                       jj  = jj + 1 .
     2244                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2245                       v-h[ii]:row    = v-help-old-y .
     2246                   end.
     2247               end.
     2248           end.
     2249       end.
     2250   end procedure.
     2251   MAIN-BLOCK:
     2252   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2253      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2254       define buffer buf_schedule      for ub.schedule.
     2255       assign
     2256           frame Dialog-Frame :title = frame Dialog-Frame :title
     2257                       + ". " + p-task-type + ": Задача номер " + string( p-task-num )
     2258       .
     2259   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2260     run mainmenu_getcntxt in parparentproc
     2261       (output v-cntxt-db-num
     2262       ,output v-cntxt-userid
     2263       ,output v-cntxt-level
     2264       ,output v-cntxt-host-code-obj
     2265       ,output v-cntxt-obj-type
     2266       ,output v-cntxt-obj-code
     2267       ,output v-cntxt-db-num-obj
     2268       ,output v-cntxt-is-admin
     2269       ) .
     2270       run get-host-name in this-procedure ( output v-host-name ) no-error .
     2271       if error-status :error
     2272       then do:
     2273           message
     2274             vss-workfile vss-revision vss-description
     2275             skip "Ошибка при определении имени фирмы"
     2276             skip "Код фирмы:" v-cntxt-host-code-obj
     2277             skip "Имя фирмы будет отображаться как '" + 'орг':U + string( v-cntxt-host-code-obj ) + "'"
     2278             skip return-value
     2279             skip trim(error-status :get-message(1))
     2280                  trim(error-status :get-message(2))
     2281                  trim(error-status :get-message(3))
     2282           view-as alert-box warning.
     2283           assign
     2284               v-host-name = 'орг':U + string( v-cntxt-host-code-obj )
     2285           .
     2286       end.
     2287       run init-param-values in this-procedure (
     2288             input p-cre-db-num
     2289           , input p-task-type
     2290           , input p-task-num
     2291           , output fi-days-amount
     2292           , output rs-date
     2293           , output fi-days-ago
     2294           , output fi-date-from
     2295           , output fi-date-to
     2296           , output tb-supp
     2297           , output v-obj-list
     2298           , output rs-1
     2299           , output v-init-doc-type-list
     2300           , output tb-inkass-pay-code
     2301           , output tb-cst-code
     2302           , output tb-parts
     2303           , output tb-chk-pay-code
     2304           , output tb-pay-desk
     2305           , output tb-pay-desk-cards
     2306           , output tb-not-fact-docs
     2307           , output tb-exp-doc
     2308           , output tb-exp-doc-rvs
     2309           , output tb-exp-ref
     2310           , output tb-exp-day
     2311           , output tb-exp-way
     2312           , output tb-exp-ref-ext
     2313           , output tb-exp-stk
     2314           , output tb-exp-stk-supp
     2315           , output tb-incr
     2316           , output tb-exp-checks
     2317           , output tb-exp-fo
     2318           , output tb-exp-fp
     2319           , output tb-exp-s-f
     2320       ).
     2321       find first buf_schedule no-lock
     2322            where buf_schedule.cre-db-num = p-cre-db-num
     2323              and buf_schedule.task-type  = p-task-type
     2324              and buf_schedule.task-num   = p-task-num
     2325       no-error.
     2326       if not available buf_schedule
     2327       and (  p-task-type   <> 'autoexp':U
     2328           or p-task-num    <> -1 )
     2329       then do:
     2330           message
     2331             vss-workfile vss-revision vss-description
     2332             skip "Не найдена строка расписания."
     2333             skip return-value
     2334             skip trim(error-status :get-message(1))
     2335                  trim(error-status :get-message(2))
     2336                  trim(error-status :get-message(3))
     2337           view-as alert-box error.
     2338           undo, return error .
     2339       end.
     2340       run enable_UI.
     2341       if available buf_schedule
     2342       and buf_schedule.db-num-char <> "*"
     2343       then do:
     2344           rs-1 :disable("глобально").
     2345           rs-1 :disable("по фирме").
     2346       end.
     2347       run date-select in this-procedure (
     2348           input rs-date
     2349       ).
     2350       run object-select in this-procedure (
     2351           input rs-1
     2352       ).
     2353       run init-fields in this-procedure .
     2354       assign  tb-exp-s-f:HIDDEN = yes .
     2355       WAIT-FOR GO OF FRAME Dialog-Frame.
     2356   END.
     2357   RUN disable_UI.
     2358   PROCEDURE attach-attr-to-schedule-line :
     2359   do
     2360   on error undo, return error
     2361   :
     2362       define input parameter p-rs-date            as integer      no-undo.
     2363       define input parameter p-days-amount        as integer      no-undo.
     2364       define input parameter p-days-ago           as integer      no-undo.
     2365       define input parameter p-date-from          as date         no-undo.
     2366       define input parameter p-date-to            as date         no-undo.
     2367       define input parameter p-rs-1               as integer      no-undo.
     2368       define input parameter p-object-list        as character    no-undo.
     2369       define input parameter p-doc-type-list      as character    no-undo.
     2370       define input parameter p-tb-supp            as logical      no-undo.
     2371       define input parameter p-tb-inkass-pay-code as logical      no-undo.
     2372       define input parameter p-tb-cst-code        as logical      no-undo.
     2373       define input parameter p-tb-parts           as logical      no-undo.
     2374       define input parameter p-tb-chk-pay-code    as logical      no-undo.
     2375       define input parameter p-tb-pay-desk        as logical      no-undo.
     2376       define input parameter p-tb-pay-desk-cards  as logical      no-undo.
     2377       define input parameter p-tb-not-fact-docs   as logical      no-undo.
     2378       define input parameter p-tb-exp-doc         as logical      no-undo.
     2379       define input parameter p-tb-exp-doc-rvs     as logical      no-undo.
     2380       define input parameter p-tb-exp-ref         as logical      no-undo.
     2381       define input parameter p-tb-exp-day         as logical      no-undo.
     2382       define input parameter p-tb-exp-way         as logical      no-undo.
     2383       define input parameter p-tb-exp-ref-ext     as logical      no-undo.
     2384       define input parameter p-tb-exp-stk         as logical      no-undo.
     2385       define input parameter p-tb-exp-stk-supp    as logical      no-undo.
     2386       define input parameter p-tb-incr            as logical      no-undo.
     2387       define input parameter p-tb-exp-checks      as logical      no-undo.
     2388       define input parameter p-tb-exp-fo          as logical      no-undo.
     2389       define input parameter p-tb-exp-fp          as logical      no-undo.
     2390       define input parameter p-tb-exp-s-f         as logical      no-undo.
     2391       define variable v-attr-value as character     no-undo.
     2392       define buffer buf_schedule      for ub.schedule.
     2393       define buffer buf_schedule-attr for ub.schedule-attr.
     2394       find first buf_schedule no-lock
     2395            where buf_schedule.cre-db-num = p-cre-db-num
     2396              and buf_schedule.task-type  = p-task-type
     2397              and buf_schedule.task-num   = p-task-num
     2398       no-error.
     2399       if not available buf_schedule
     2400       and (  p-task-type   <> 'autoexp':U
     2401           or p-task-num    <> -1 )
     2402       then do:
     2403           message
     2404             vss-workfile vss-revision vss-description
     2405             skip "Не найдена строка расписания."
     2406             skip return-value
     2407             skip trim(error-status :get-message(1))
     2408                  trim(error-status :get-message(2))
     2409                  trim(error-status :get-message(3))
     2410           view-as alert-box error.
     2411           undo, return error .
     2412       end.
     2413       assign
     2414           v-attr-value = string( p-rs-1 )
     2415                           + "," + ( if p-tb-inkass-pay-code = yes then "yes" else "no" )
     2416                           + "," + ( if p-tb-cst-code        = yes then "yes" else "no" )
     2417                           + "," + ( if p-tb-not-fact-docs   = yes then "yes" else "no" )
     2418                           + "," + ( if p-tb-supp            = yes then "yes" else "no" )
     2419                           + "," + ( if p-tb-parts           = yes then "yes" else "no" )
     2420                           + "," + ( if p-tb-chk-pay-code    = yes then "yes" else "no" )
     2421                           + "," + ( if p-tb-exp-doc         = yes then "yes" else "no" )
     2422                           + "," + ( if p-tb-exp-ref         = yes then "yes" else "no" )
     2423                           + "," + ( if p-tb-exp-day         = yes then "yes" else "no" )
     2424                           + "," + ( if p-tb-exp-way         = yes then "yes" else "no" )
     2425                           + "," + ( if p-tb-exp-ref-ext     = yes then "yes" else "no" )
     2426                           + "," + ( if p-tb-exp-stk         = yes then "yes" else "no" )
     2427                           + "," + ( if p-tb-exp-stk-supp    = yes then "yes" else "no" )
     2428                           + "," + string( v-cntxt-host-code-obj )
     2429                           + "," + ( if tb-pay-desk          = yes then "yes" else "no" )
     2430                           + "," + ( if tb-incr              = yes then "yes" else "no" )
     2431                           + "," + ( if tb-exp-checks        = yes then "yes" else "no" )
     2432                           + "," + ( if tb-exp-fo            = yes then "yes" else "no" )
     2433                           + "," + ( if tb-exp-fp            = yes then "yes" else "no" )
     2434                           + "," + ( if tb-pay-desk-cards    = yes then "yes" else "no" )
     2435                           + "," + ( if tb-exp-s-f           = yes then "yes" else "no" )
     2436                           + "," + ( if p-tb-exp-doc-rvs     = yes then "yes" else "no" )
     2437       .
     2438       run schedule-attr-write in this-procedure (
     2439             input p-cre-db-num
     2440           , input p-task-type
     2441           , input p-task-num
     2442           , input 'schedule-param-list':U
     2443           , input v-attr-value
     2444       ).
     2445       run schedule-attr-write in this-procedure (
     2446             input p-cre-db-num
     2447           , input p-task-type
     2448           , input p-task-num
     2449           , input 'schedule-obj-list':U
     2450           , input p-object-list
     2451       ).
     2452       run schedule-attr-write in this-procedure (
     2453             input p-cre-db-num
     2454           , input p-task-type
     2455           , input p-task-num
     2456           , input 'schedule-doc-type-list':U
     2457           , input p-doc-type-list
     2458       ).
     2459       assign
     2460           v-attr-value = string( p-rs-date )
     2461                           + "," + string( p-days-amount )
     2462                           + "," + string( p-days-ago    )
     2463                           + "," + string( p-date-from   )
     2464                           + "," + string( p-date-to     )
     2465       .
     2466       run schedule-attr-write in this-procedure (
     2467             input p-cre-db-num
     2468           , input p-task-type
     2469           , input p-task-num
     2470           , input 'schedule-date-list':U
     2471           , input v-attr-value
     2472       ).
     2473       for each buf_schedule-attr
     2474       on error undo, return error
     2475       :
     2476           if buf_schedule-attr.task-type  <> 'autoexp':U
     2477           or buf_schedule-attr.cre-db-num <> p-cre-db-num
     2478           or buf_schedule-attr.task-num   <> -1
     2479           or (
     2480                   buf_schedule-attr.attr-code <> 'schedule-date-list':U
     2481               and buf_schedule-attr.attr-code <> 'schedule-param-list':U
     2482               and buf_schedule-attr.attr-code <> 'schedule-obj-list':U
     2483               and buf_schedule-attr.attr-code <> 'schedule-doc-type-list':U
     2484           )
     2485           then do:
     2486               find first buf_schedule
     2487                    where buf_schedule.cre-db-num = buf_schedule-attr.cre-db-num
     2488                      and buf_schedule.task-type  = buf_schedule-attr.task-type
     2489                      and buf_schedule.task-num   = buf_schedule-attr.task-num
     2490               no-error.
     2491               if not available buf_schedule
     2492               then do:
     2493                   delete buf_schedule-attr.
     2494               end.
     2495           end.
     2496       end.
     2497   end.
     2498   END PROCEDURE.
     2499   PROCEDURE date-select :
     2500   do
     2501   on error undo, return error
     2502   :
     2503   define input parameter p-date-select-value as integer      no-undo.
     2504       case p-date-select-value
     2505       :
     2506           when 0
     2507           then do:
     2508               hide
     2509                   fi-date-from in frame Dialog-Frame
     2510                   fi-date-to
     2511               .
     2512               view
     2513                   fi-days-ago
     2514                   fi-days-amount
     2515               .
     2516           end.
     2517           when 1
     2518           then do:
     2519               hide
     2520                   fi-date-to
     2521                   fi-days-ago
     2522                   fi-days-amount
     2523               .
     2524               view
     2525                   fi-date-from
     2526               .
     2527           end.
     2528           when 2
     2529           then do:
     2530               hide
     2531                   fi-days-ago
     2532                   fi-days-amount
     2533               .
     2534               view
     2535                   fi-date-from
     2536                   fi-date-to
     2537               .
     2538           end.
     2539       end case.
     2540   end.
     2541   END PROCEDURE.
     2542   PROCEDURE disable_UI :
     2543     HIDE FRAME Dialog-Frame.
     2544   END PROCEDURE.
     2545   PROCEDURE enable_UI :
     2546     DISPLAY tb-incr tb-exp-doc tb-exp-doc-rvs tb-exp-ref tb-exp-fo tb-exp-day tb-exp-checks
     2547             tb-exp-ref-ext tb-exp-fp tb-exp-way tb-exp-stk tb-exp-s-f
     2548             tb-exp-stk-supp fi-days-amount rs-date fi-days-ago fi-date-from
     2549             fi-date-to rs-1 ed-object ed-doc-type ed-doc-type-title
     2550             tb-inkass-pay-code tb-cst-code tb-chk-pay-code tb-parts tb-pay-desk
     2551             tb-not-fact-docs tb-pay-desk-cards fi-dates-title fi-doc-options
     2552         WITH FRAME Dialog-Frame.
     2553     ENABLE rct-dates rct-obj rct-doc-type rct-doc-options RECT-5 Btn_OK
     2554            Btn_Cancel tb-incr b-help tb-exp-doc tb-exp-doc-rvs tb-exp-ref tb-exp-fo tb-exp-day
     2555            tb-exp-checks tb-exp-ref-ext tb-exp-fp tb-exp-way tb-exp-stk
     2556            tb-exp-s-f tb-exp-stk-supp fi-days-amount rs-date fi-days-ago
     2557            fi-date-from fi-date-to rs-1 bt-sel-obj ed-doc-type bt-sel-doc-type
     2558            tb-inkass-pay-code tb-cst-code tb-chk-pay-code tb-parts tb-pay-desk
     2559            tb-not-fact-docs tb-pay-desk-cards
     2560         WITH FRAME Dialog-Frame.
     2561     VIEW FRAME Dialog-Frame.
     2562   END PROCEDURE.
     2563   PROCEDURE extract-parameter :
     2564   do
     2565   on error undo, return error
     2566   :
     2567   end.
     2568   END PROCEDURE.
     2569   PROCEDURE get-host-name :
     2570   do
     2571   on error undo, return error
     2572   :
     2573   define output parameter p-host-name as character    no-undo.
     2574   define buffer buf_clients   for ub.clients.
     2575       find first buf_clients no-lock
     2576            where buf_clients.obj-type = 'орг':U
     2577              and buf_clients.obj-code = v-cntxt-host-code-obj
     2578       no-error.
     2579       if not available buf_clients
     2580       then do:
     2581           message
     2582             vss-workfile vss-revision vss-description
     2583             skip "Не удалось найти текущую фирму"
     2584             skip return-value
     2585             skip trim(error-status :get-message(1))
     2586                  trim(error-status :get-message(2))
     2587                  trim(error-status :get-message(3))
     2588                  trim(error-status :get-message(4))
     2589                  trim(error-status :get-message(5))
     2590           view-as alert-box error.
     2591           undo, return error .
     2592       end.
     2593       else do:
     2594           assign
     2595               p-host-name = buf_clients.obj-name
     2596           .
     2597       end.
     2598   end.
     2599   END PROCEDURE.
     2600   PROCEDURE init-fields :
     2601   do
     2602   on error undo, return error
     2603   :
     2604       define variable v-oper-num     as integer           no-undo.
     2605       run manage-tb-exp-stk       in this-procedure.
     2606       run manage-tb-exp-ref       in this-procedure.
     2607       run manage-options          in this-procedure.
     2608       run manage-tb-chk-pay-code  in this-procedure.
     2609       assign
     2610           v-doc-type-list = v-init-doc-type-list
     2611       .
     2612       if v-init-doc-type-list <> ?
     2613       and v-init-doc-type-list <> ''
     2614       then do:
     2615           assign
     2616               ed-doc-type :screen-value in frame Dialog-Frame = ""
     2617           .
     2618           do v-oper-num = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2619           :
     2620               if lookup( entry( v-oper-num, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ), v-init-doc-type-list ) <> 0
     2621               then do:
     2622                   assign
     2623                       ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
     2624                                                   + entry( v-oper-num, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) + chr(10)
     2625                   .
     2626               end.
     2627           end.
     2628           do v-oper-num = 1 to num-entries( 'пко,рко,ппп,рпп,апп,апр,':U )
     2629           :
     2630               if lookup( entry( v-oper-num, 'пко,рко,ппп,рпп,апп,апр,':U ), v-init-doc-type-list ) <> 0
     2631               then do:
     2632                   assign
     2633                       ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
     2634                                                   + entry( v-oper-num, 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,апп,апр':U ) + chr(10)
     2635                   .
     2636               end.
     2637           end.
     2638       end.
     2639   end.
     2640   END PROCEDURE.
     2641   PROCEDURE init-param-values :
     2642   do
     2643   on error undo, return error
     2644   :
     2645   define input  parameter p-cre-db-num            as integer   no-undo .
     2646   define input  parameter p-task-type             as character no-undo .
     2647   define input  parameter p-task-num              as integer   no-undo .
     2648   define output parameter p-days-amount           as integer      no-undo.
     2649   define output parameter p-rs-date               as integer      no-undo.
     2650   define output parameter p-days-ago              as integer      no-undo.
     2651   define output parameter p-date-from             as date         no-undo.
     2652   define output parameter p-date-to               as date         no-undo.
     2653   define output parameter p-tb-supp               as logical      no-undo.
     2654   define output parameter p-obj-list              as character    no-undo.
     2655   define output parameter p-rs-1                  as integer      no-undo.
     2656   define output parameter p-doc-type-list         as character    no-undo.
     2657   define output parameter p-tb-inkass-pay-code    as logical      no-undo.
     2658   define output parameter p-tb-cst-code           as logical      no-undo.
     2659   define output parameter p-tb-parts              as logical      no-undo.
     2660   define output parameter p-tb-chk-pay-code       as logical      no-undo.
     2661   define output parameter p-tb-pay-desk           as logical      no-undo.
     2662   define output parameter p-tb-pay-desk-cards     as logical      no-undo.
     2663   define output parameter p-tb-not-fact-docs      as logical      no-undo.
     2664   define output parameter p-tb-exp-doc            as logical      no-undo.
     2665   define output parameter p-tb-exp-doc-rvs        as logical      no-undo.
     2666   define output parameter p-tb-exp-ref            as logical      no-undo.
     2667   define output parameter p-tb-exp-day            as logical      no-undo.
     2668   define output parameter p-tb-exp-way            as logical      no-undo.
     2669   define output parameter p-tb-exp-ref-ext        as logical      no-undo.
     2670   define output parameter p-tb-exp-stk            as logical      no-undo.
     2671   define output parameter p-tb-exp-stk-supp       as logical      no-undo.
     2672   define output parameter p-tb-incr               as logical      no-undo.
     2673   define output parameter p-tb-exp-checks         as logical      no-undo.
     2674   define output parameter p-tb-exp-fo             as logical      no-undo.
     2675   define output parameter p-tb-exp-fp             as logical      no-undo.
     2676   define output parameter p-tb-exp-s-f            as logical      no-undo.
     2677       define variable v-counter       as integer       no-undo.
     2678       define variable v-param-list    as character     no-undo.
     2679       run schedule-attr-value in this-procedure (
     2680             input p-cre-db-num
     2681           , input p-task-type
     2682           , input p-task-num
     2683           , input 'schedule-doc-type-list':U
     2684           , output p-doc-type-list
     2685           , output v-param-type
     2686       ) .
     2687       run schedule-attr-value in this-procedure (
     2688             input p-cre-db-num
     2689           , input p-task-type
     2690           , input p-task-num
     2691           , input 'schedule-obj-list':U
     2692           , output p-obj-list
     2693           , output v-param-type
     2694       ) .
     2695       for each temp_obj-list
     2696       :
     2697           delete temp_obj-list.
     2698       end.
     2699       do v-counter = 1 to num-entries( p-obj-list ) / 2
     2700       :
     2701           create temp_obj-list.
     2702           assign
     2703               temp_obj-list.obj-type = entry( 2 * v-counter - 1,  p-obj-list )
     2704               temp_obj-list.obj-code = integer( entry( 2 * v-counter,      p-obj-list ) )
     2705           .
     2706       end.
     2707       run schedule-attr-value in this-procedure (
     2708             input p-cre-db-num
     2709           , input p-task-type
     2710           , input p-task-num
     2711           , input 'schedule-param-list':U
     2712           , output v-param-list
     2713           , output v-param-type
     2714       ) .
     2715       if v-param-list = ""
     2716       then do:
     2717           assign
     2718               p-rs-1                  = 0
     2719               p-tb-inkass-pay-code    = no
     2720               p-tb-cst-code           = no
     2721               p-tb-not-fact-docs      = no
     2722               p-tb-supp               = no
     2723               p-tb-parts              = no
     2724               p-tb-chk-pay-code       = no
     2725               p-tb-pay-desk           = no
     2726               p-tb-pay-desk-cards     = no
     2727               p-tb-exp-doc            = no
     2728               p-tb-exp-doc-rvs        = no
     2729               p-tb-exp-ref            = no
     2730               p-tb-exp-day            = no
     2731               p-tb-exp-way            = no
     2732               p-tb-exp-ref-ext        = no
     2733               p-tb-exp-stk            = no
     2734               p-tb-exp-stk-supp       = no
     2735               p-tb-incr               = no
     2736               p-tb-exp-checks         = no
     2737               p-tb-exp-fo             = no
     2738               p-tb-exp-fp             = no
     2739               p-tb-exp-s-f            = no
     2740           .
     2741       end.
     2742       else do:
     2743           assign
     2744               p-rs-1 = integer( entry( 1, v-param-list ) )
     2745           .
     2746           run schedule-attr-extract-logical in this-procedure (
     2747                 input 2
     2748               , input v-param-list
     2749               , output p-tb-inkass-pay-code
     2750           ).
     2751           run schedule-attr-extract-logical in this-procedure (
     2752                 input 3
     2753               , input v-param-list
     2754               , output p-tb-cst-code
     2755           ).
     2756           run schedule-attr-extract-logical in this-procedure (
     2757                 input 4
     2758               , input v-param-list
     2759               , output p-tb-not-fact-docs
     2760           ).
     2761           run schedule-attr-extract-logical in this-procedure (
     2762                 input 5
     2763               , input v-param-list
     2764               , output p-tb-supp
     2765           ).
     2766           run schedule-attr-extract-logical in this-procedure (
     2767                 input 6
     2768               , input v-param-list
     2769               , output p-tb-parts
     2770           ).
     2771           run schedule-attr-extract-logical in this-procedure (
     2772                 input 7
     2773               , input v-param-list
     2774               , output p-tb-chk-pay-code
     2775           ).
     2776           run schedule-attr-extract-logical in this-procedure (
     2777                 input 8
     2778               , input v-param-list
     2779               , output p-tb-exp-doc
     2780           ).
     2781           run schedule-attr-extract-logical in this-procedure (
     2782                 input 9
     2783               , input v-param-list
     2784               , output p-tb-exp-ref
     2785           ).
     2786           run schedule-attr-extract-logical in this-procedure (
     2787                 input 10
     2788               , input v-param-list
     2789               , output p-tb-exp-day
     2790           ).
     2791           run schedule-attr-extract-logical in this-procedure (
     2792                 input 11
     2793               , input v-param-list
     2794               , output p-tb-exp-way
     2795           ).
     2796           run schedule-attr-extract-logical in this-procedure (
     2797                 input 12
     2798               , input v-param-list
     2799               , output p-tb-exp-ref-ext
     2800           ).
     2801           run schedule-attr-extract-logical in this-procedure (
     2802                 input 13
     2803               , input v-param-list
     2804               , output p-tb-exp-stk
     2805           ).
     2806           run schedule-attr-extract-logical in this-procedure (
     2807                 input 14
     2808               , input v-param-list
     2809               , output p-tb-exp-stk-supp
     2810           ).
     2811           run schedule-attr-extract-logical in this-procedure (
     2812                 input 16
     2813               , input v-param-list
     2814               , output p-tb-pay-desk
     2815           ).
     2816           run schedule-attr-extract-logical in this-procedure (
     2817                 input 17
     2818               , input v-param-list
     2819               , output p-tb-incr
     2820           ).
     2821           run schedule-attr-extract-logical in this-procedure (
     2822                 input 18
     2823               , input v-param-list
     2824               , output p-tb-exp-checks
     2825           ).
     2826           run schedule-attr-extract-logical in this-procedure (
     2827                 input 19
     2828               , input v-param-list
     2829               , output p-tb-exp-fo
     2830           ).
     2831           run schedule-attr-extract-logical in this-procedure (
     2832                 input 20
     2833               , input v-param-list
     2834               , output p-tb-exp-fp
     2835           ).
     2836           run schedule-attr-extract-logical in this-procedure (
     2837                 input 21
     2838               , input v-param-list
     2839               , output p-tb-pay-desk-cards
     2840           ).
     2841           run schedule-attr-extract-logical in this-procedure (
     2842                 input 22
     2843               , input v-param-list
     2844               , output p-tb-exp-s-f
     2845           ).
     2846           run schedule-attr-extract-logical in this-procedure (
     2847                 input 23
     2848               , input v-param-list
     2849               , output p-tb-exp-doc-rvs
     2850           ).
     2851       end.
     2852       run schedule-attr-value in this-procedure (
     2853             input p-cre-db-num
     2854           , input p-task-type
     2855           , input p-task-num
     2856           , input 'schedule-date-list':U
     2857           , output v-param-list
     2858           , output v-param-type
     2859       ) .
     2860       if v-param-list = ""
     2861       then do:
     2862           define variable v-today as date      no-undo.
     2863           define variable v-time  as integer   no-undo.
     2864           run cur-time in this-procedure ( output v-today
     2865                                          , output v-time
     2866                                          ).
     2867           assign
     2868               p-rs-date       = 0
     2869               p-days-amount   = 1
     2870               p-days-ago      = 0
     2871               p-date-from     = v-today - 1
     2872               p-date-to       = v-today - 1
     2873           .
     2874       end.
     2875       else do:
     2876           assign
     2877               p-rs-date       = integer( entry( 1, v-param-list ) )
     2878               p-days-amount   = integer( entry( 2, v-param-list ) )
     2879               p-days-ago      = integer( entry( 3, v-param-list ) )
     2880               p-date-from     = date( entry( 4, v-param-list ) )
     2881               p-date-to       = date( entry( 5, v-param-list ) )
     2882           .
     2883       end.
     2884   end.
     2885   END PROCEDURE.
     2886   PROCEDURE manage-options :
     2887   do
     2888   on error undo, return error
     2889   :
     2890       assign
     2891           rct-doc-options     :visible in frame Dialog-Frame = no
     2892           fi-doc-options      :visible in frame Dialog-Frame = no
     2893           tb-inkass-pay-code  :visible in frame Dialog-Frame = no
     2894           tb-chk-pay-code     :visible in frame Dialog-Frame = no
     2895           tb-pay-desk         :visible in frame Dialog-Frame = no
     2896           tb-pay-desk-cards   :visible in frame Dialog-Frame = no
     2897           tb-cst-code         :visible in frame Dialog-Frame = no
     2898           tb-parts            :visible in frame Dialog-Frame = no
     2899           tb-not-fact-docs    :visible in frame Dialog-Frame = no
     2900           rct-doc-type        :visible in frame Dialog-Frame = no
     2901           ed-doc-type-title   :visible in frame Dialog-Frame = no
     2902           ed-doc-type         :visible in frame Dialog-Frame = no
     2903           bt-sel-doc-type     :visible in frame Dialog-Frame = no
     2904           rct-dates           :visible in frame Dialog-Frame = no
     2905           fi-dates-title      :visible in frame Dialog-Frame = no
     2906           rs-date             :visible in frame Dialog-Frame = no
     2907           fi-days-amount      :visible in frame Dialog-Frame = no
     2908           fi-days-ago         :visible in frame Dialog-Frame = no
     2909           fi-date-from        :visible in frame Dialog-Frame = no
     2910           fi-date-to          :visible in frame Dialog-Frame = no
     2911       .
     2912       if tb-incr = yes
     2913       then do:
     2914           assign
     2915               tb-exp-day          :visible in frame Dialog-Frame = no
     2916               tb-exp-way          :visible in frame Dialog-Frame = no
     2917               tb-exp-stk          :visible in frame Dialog-Frame = no
     2918               tb-exp-stk-supp     :visible in frame Dialog-Frame = no
     2919               tb-exp-ref-ext      :visible in frame Dialog-Frame = no
     2920               tb-exp-checks       :visible in frame Dialog-Frame = yes
     2921               rct-obj             :visible in frame Dialog-Frame = yes
     2922               rs-1                :visible in frame Dialog-Frame = yes
     2923               bt-sel-obj          :visible in frame Dialog-Frame = yes
     2924               ed-object           :visible in frame Dialog-Frame = yes
     2925           .
     2926           run object-select in this-procedure (
     2927               input rs-1
     2928           ).
     2929           if tb-exp-doc = yes
     2930           then do:
     2931               enable
     2932                   tb-exp-checks
     2933                   tb-exp-doc-rvs
     2934               with frame Dialog-Frame .
     2935           end.
     2936           else do:
     2937               disable
     2938                   tb-exp-checks
     2939                   tb-exp-doc-rvs
     2940               with frame Dialog-Frame .
     2941           end.
     2942       end.
     2943       else do:
     2944           assign
     2945               tb-exp-day          :visible in frame Dialog-Frame = yes
     2946               tb-exp-way          :visible in frame Dialog-Frame = yes
     2947               tb-exp-stk          :visible in frame Dialog-Frame = yes
     2948               tb-exp-stk-supp     :visible in frame Dialog-Frame = yes
     2949               tb-exp-ref-ext      :visible in frame Dialog-Frame = yes
     2950               tb-exp-checks       :visible in frame Dialog-Frame = no
     2951               rct-obj             :visible in frame Dialog-Frame = no
     2952               rs-1                :visible in frame Dialog-Frame = no
     2953               bt-sel-obj          :visible in frame Dialog-Frame = no
     2954               ed-object           :visible in frame Dialog-Frame = no
     2955           .
     2956           run object-select in this-procedure (
     2957               input rs-1
     2958           ).
     2959           if tb-exp-doc = yes
     2960           then do:
     2961               assign
     2962                   rct-doc-options     :visible in frame Dialog-Frame = yes
     2963                   fi-doc-options      :visible in frame Dialog-Frame = yes
     2964                   tb-inkass-pay-code  :visible in frame Dialog-Frame = yes
     2965                   tb-chk-pay-code     :visible in frame Dialog-Frame = yes
     2966                   tb-pay-desk         :visible in frame Dialog-Frame = yes
     2967                   tb-pay-desk-cards   :visible in frame Dialog-Frame = yes
     2968                   tb-cst-code         :visible in frame Dialog-Frame = yes
     2969                   tb-parts            :visible in frame Dialog-Frame = yes
     2970                   tb-not-fact-docs    :visible in frame Dialog-Frame = yes
     2971               .
     2972               enable
     2973                   tb-exp-doc-rvs
     2974               with frame Dialog-Frame .
     2975           end.
     2976           else do :
     2977               disable
     2978                   tb-exp-doc-rvs
     2979               with frame Dialog-Frame .
     2980           end .
     2981           if tb-exp-doc = yes
     2982           or tb-exp-fp = yes
     2983           or tb-exp-fo = yes
     2984           then do:
     2985               assign
     2986                   rct-doc-type        :visible in frame Dialog-Frame = yes
     2987                   ed-doc-type-title   :visible in frame Dialog-Frame = yes
     2988                   ed-doc-type         :visible in frame Dialog-Frame = yes
     2989                   bt-sel-doc-type     :visible in frame Dialog-Frame = yes
     2990               .
     2991           end.
     2992           if tb-exp-doc = yes
     2993           or tb-exp-ref = yes
     2994           or tb-exp-day = yes
     2995           or tb-exp-way = yes
     2996           or tb-exp-stk = yes
     2997           or tb-exp-fo = yes
     2998           or tb-exp-fp = yes
     2999           or tb-exp-s-f = yes
     3000           then do:
     3001               assign
     3002                   rct-obj             :visible in frame Dialog-Frame = yes
     3003                   rs-1                :visible in frame Dialog-Frame = yes
     3004                   bt-sel-obj          :visible in frame Dialog-Frame = yes
     3005                   ed-object           :visible in frame Dialog-Frame = yes
     3006               .
     3007           end.
     3008           if tb-exp-doc = yes
     3009           or tb-exp-day = yes
     3010           or tb-exp-stk = yes
     3011           or tb-exp-ref = yes
     3012           or tb-exp-fo = yes
     3013           or tb-exp-fp = yes
     3014           or tb-exp-s-f = yes
     3015           then do:
     3016               assign
     3017                   rct-dates           :visible in frame Dialog-Frame = yes
     3018                   fi-dates-title      :visible in frame Dialog-Frame = yes
     3019                   rs-date             :visible in frame Dialog-Frame = yes
     3020                   fi-days-amount      :visible in frame Dialog-Frame = yes
     3021                   fi-days-ago         :visible in frame Dialog-Frame = yes
     3022                   fi-date-from        :visible in frame Dialog-Frame = yes
     3023                   fi-date-to          :visible in frame Dialog-Frame = yes
     3024               .
     3025               run date-select in this-procedure (
     3026                   input rs-date
     3027               ).
     3028           end.
     3029       end.
     3030   end.
     3031   END PROCEDURE.
