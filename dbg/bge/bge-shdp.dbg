        1   define input  parameter parparentproc as handle           no-undo.
        2   define input  parameter p-cre-db-num  as integer   no-undo .
        3   define input  parameter p-task-type   as character no-undo .
        4   define input  parameter p-task-num    as integer   no-undo .
        5   define output parameter p-cancel      as logical      no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Выбор параметров для экспорта по расписанию.".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   define temp-table temp-schedule-free no-undo
      308   field free-id as character
      309   field free-task-name as character
      310   field proc-run-name as character
      311   field proc-param-edit-name as character
      312   field conf-param as character
      313   field is-gbd as logical
      314   field is-ubd as logical
      315   field enable-concurrent-0 as logical
      316   field enable-concurrent-db as logical
      317   field other-info as character
      318   field enc-key as character
      319   field is-rum as logical
      320   index pi is unique primary
      321   free-id.
      322   procedure schedule-attr-name :
      323   do
      324     on error undo, return error
      325     :
      326     define input  parameter p-code           as character no-undo .
      327     define output parameter p-type           as character no-undo .
      328     define output parameter p-format         as character no-undo .
      329     define output parameter p-label          as character no-undo .
      330     define output parameter p-user-can-edit  as logical   no-undo .
      331     define output parameter p-output-display as logical   no-undo .
      332     define output parameter p-other          as character no-undo .
      333       if index(p-code, chr(4)) > 0 then do:
      334         p-code = entry(1, p-code, chr(4)).
      335       end.
      336       case p-code :
      337               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      338               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      339               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      340               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      341               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      342               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      343               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      344               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      345               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      346         otherwise do:
      347           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      348         end.
      349       end.
      350     end.
      351   end procedure.
      352   procedure schedule-attr-tooltip :
      353   do
      354     on error undo, return error
      355     :
      356       define input  parameter p-code    as character no-undo .
      357       define output parameter p-tooltip as character no-undo .
      358       define output parameter p-label   as character no-undo .
      359       if index(p-code, chr(4)) > 0 then do:
      360         p-code = entry(1, p-code, chr(4)).
      361       end.
      362       case p-code :
      363               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      364               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      365               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      366               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      367               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      368               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      369               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      370               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      371               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      372         otherwise do:
      373               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      374         end.
      375       end.
      376     end.
      377   end procedure.
      378   procedure schedule-attr-value :
      379   do
      380   on error undo, return error return-value
      381   :
      382   define input parameter  p-cre-db-num as integer    no-undo.
      383   define input parameter  p-task-type  as character  no-undo.
      384   define input parameter  p-task-num   as integer    no-undo.
      385   define input parameter  p-code       as character  no-undo.
      386   define output parameter p-value      as character  no-undo.
      387   define output parameter p-type       as character  no-undo.
      388       define variable v-format         as character no-undo .
      389       define variable v-label          as character no-undo .
      390       define variable v-user-can-edit  as logical   no-undo .
      391       define variable v-output-display as logical   no-undo .
      392       define variable v-other          as character no-undo .
      393       define buffer buf_schedule-attr for ub.schedule-attr.
      394       run schedule-attr-name in this-procedure (
      395             input  p-code
      396           , output p-type
      397           , output v-format
      398           , output v-label
      399           , output v-user-can-edit
      400           , output v-output-display
      401           , output v-other
      402       ) no-error .
      403       if error-status :error
      404       then do:
      405           undo, return error return-value .
      406       end.
      407       if p-code begins ('schd-free-id':U + chr(4))
      408       and entry(2, p-code, chr(4)) = '':U then do:
      409         find first buf_schedule-attr no-lock
      410             where buf_schedule-attr.cre-db-num = p-cre-db-num
      411               and buf_schedule-attr.task-type  = p-task-type
      412               and buf_schedule-attr.task-num   = p-task-num
      413               and buf_schedule-attr.attr-code  begins p-code
      414         no-error .
      415       end.
      416       else do:
      417         find first buf_schedule-attr no-lock
      418             where buf_schedule-attr.cre-db-num = p-cre-db-num
      419               and buf_schedule-attr.task-type  = p-task-type
      420               and buf_schedule-attr.task-num   = p-task-num
      421               and buf_schedule-attr.attr-code  = p-code
      422         no-error .
      423       end.
      424       if available buf_schedule-attr
      425       then do:
      426           assign
      427               p-value = buf_schedule-attr.attr-value
      428           .
      429       end.
      430       else do:
      431         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      432            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      433         end.
      434         else do:
      435           assign
      436               p-value = if p-type = 'L':U then "no":U else ""
      437           .
      438         end.
      439       end.
      440   end.
      441   end procedure.
      442   procedure schedule-attr-write :
      443   do
      444   on error undo, return error
      445   :
      446   define input parameter p-cre-db-num  as integer   no-undo.
      447   define input parameter p-task-type   as character no-undo.
      448   define input parameter p-task-num    as integer   no-undo.
      449   define input parameter p-code        as character no-undo.
      450   define input parameter p-value       as character no-undo.
      451       define variable v-type              as character                no-undo.
      452       define variable v-format            as character                no-undo.
      453       define variable v-label             as character                no-undo.
      454       define variable v-user-can-edit     as logical                  no-undo.
      455       define variable v-output-display    as logical                  no-undo.
      456       define variable v-other             as character                no-undo.
      457       define buffer buf_schedule-attr for ub.schedule-attr .
      458       run schedule-attr-name in this-procedure (
      459             input  p-code
      460           , output v-type
      461           , output v-format
      462           , output v-label
      463           , output v-user-can-edit
      464           , output v-output-display
      465           , output v-other
      466       ) no-error.
      467       if error-status :error
      468       then do:
      469           undo, return error return-value.
      470       end.
      471       find first buf_schedule-attr exclusive-lock
      472            where buf_schedule-attr.cre-db-num = p-cre-db-num
      473              and buf_schedule-attr.task-type  = p-task-type
      474              and buf_schedule-attr.task-num   = p-task-num
      475              and buf_schedule-attr.attr-code  = p-code
      476       no-error.
      477       if not available buf_schedule-attr
      478       then do:
      479           create buf_schedule-attr.
      480           assign
      481             buf_schedule-attr.cre-db-num = p-cre-db-num
      482             buf_schedule-attr.task-type  = p-task-type
      483             buf_schedule-attr.task-num   = p-task-num
      484             buf_schedule-attr.attr-code  = p-code
      485             buf_schedule-attr.attr-value = p-value
      486           .
      487       end.
      488       else do:
      489           assign
      490               buf_schedule-attr.attr-value = p-value
      491           .
      492       end.
      493   end.
      494   end procedure.
      495   procedure schedule-attr-delete :
      496   do
      497   on error undo, return error
      498   :
      499   define input  parameter p-cre-db-num  as integer   no-undo.
      500   define input  parameter p-task-type   as character no-undo.
      501   define input  parameter p-task-num    as integer   no-undo.
      502   define input  parameter p-code        as character no-undo.
      503   define output parameter p-deleted     as logical   no-undo.
      504       define buffer buf_schedule-attr for ub.schedule-attr .
      505       define variable v-type              as character                no-undo.
      506       define variable v-format            as character                no-undo.
      507       define variable v-label             as character                no-undo.
      508       define variable v-user-can-edit     as logical                  no-undo.
      509       define variable v-output-display    as logical                  no-undo.
      510       define variable v-other             as character                no-undo.
      511       run schedule-attr-name in this-procedure (
      512             input p-code
      513           , output v-type
      514           , output v-format
      515           , output v-label
      516           , output v-user-can-edit
      517           , output v-output-display
      518           , output v-other
      519       ) no-error .
      520       if error-status :error
      521       then do:
      522           undo, return error return-value .
      523       end.
      524       find first buf_schedule-attr exclusive-lock
      525            where buf_schedule-attr.cre-db-num = p-cre-db-num
      526              and buf_schedule-attr.task-type  = p-task-type
      527              and buf_schedule-attr.task-num   = p-task-num
      528              and buf_schedule-attr.attr-code  = p-code
      529       no-error.
      530       if not available buf_schedule-attr
      531       then do:
      532           assign
      533               p-deleted = no
      534           .
      535       end.
      536       else do:
      537           delete buf_schedule-attr.
      538           assign
      539               p-deleted = yes
      540           .
      541       end.
      542   end.
      543   end procedure.
      544   procedure schedule-attr-news :
      545   do
      546   on error undo, return error
      547   :
      548       define input  parameter p-code           as character no-undo .
      549       define output parameter p-news           as logical   no-undo .
      550       if index(p-code, chr(4)) > 0 then do:
      551         p-code = entry(1, p-code, chr(4)).
      552       end.
      553       case p-code :
      554               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      555               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      556               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      557               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      558               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      559               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      560               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      561               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      562               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      563         otherwise do:
      564           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      565         end.
      566       end.
      567   end.
      568   end procedure.
      569   procedure schedule-attr-extract-logical :
      570   do
      571   on error undo, return error
      572   :
      573   define input  parameter p-parameter-number   as integer      no-undo.
      574   define input  parameter p-parameter-list     as character    no-undo.
      575   define output parameter p-parameter-value   as logical      no-undo.
      576       if num-entries( p-parameter-list ) > p-parameter-number - 1
      577       then do:
      578           assign
      579               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      580           .
      581       end.
      582       else do:
      583           assign
      584               p-parameter-value   = no
      585           .
      586       end.
      587   end.
      588   end procedure.
      589   procedure schedule-attr-get-free-id :
      590   do
      591   on error undo, return error return-value
      592   :
      593     define input  parameter p-cre-db-num  as integer   no-undo.
      594     define input  parameter p-task-type   as character no-undo.
      595     define input  parameter p-task-num    as integer   no-undo.
      596     define output parameter p-free-id     as character no-undo.
      597     define buffer buf_schedule-attr for ub.schedule-attr.
      598     find first buf_schedule-attr no-lock
      599         where buf_schedule-attr.cre-db-num = p-cre-db-num
      600           and buf_schedule-attr.task-type  = p-task-type
      601           and buf_schedule-attr.task-num   = p-task-num
      602           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      603     no-error .
      604     if available buf_schedule-attr then
      605     assign
      606     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      607     no-error
      608     .
      609   end.
      610   end procedure.
      611   procedure schedule-attr-get-free-props :
      612     define input parameter p-free-id as character no-undo .
      613     define output parameter p-value as character no-undo .
      614     define buffer buf_temp-schedule-free for temp-schedule-free.
      615     do
      616     on error undo, return error return-value
      617     :
      618       find first buf_temp-schedule-free no-lock no-error .
      619       if not available buf_temp-schedule-free then do:
      620         run schedule-attr-fill-free-props in this-procedure .
      621       end.
      622       find first buf_temp-schedule-free where
      623               buf_temp-schedule-free.free-id = p-free-id no-error.
      624       if available buf_temp-schedule-free then do:
      625         assign
      626         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      627                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      628                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      629                   buf_temp-schedule-free.conf-param           + chr(4) +
      630                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      631                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      632                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      633                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      634                   buf_temp-schedule-free.other-info
      635         .
      636       end.
      637       else do:
      638        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      639                              "id произвольной задачи - &5"
      640                              ,vss-workfile
      641                              ,vss-revision
      642                              ,vss-description
      643                              ,chr(10)
      644                              ,p-free-id).
      645       end.
      646     end.
      647   end procedure.
      648   procedure schedule-attr-is-rum-free-id :
      649   define input parameter p-free-id as character no-undo .
      650   define output parameter p-is-rum as logical no-undo .
      651   define buffer buf_temp-schedule-free for temp-schedule-free.
      652   do
      653   on error undo, return error
      654   :
      655       find first buf_temp-schedule-free no-lock no-error .
      656       if not available buf_temp-schedule-free then do:
      657         run schedule-attr-fill-free-props in this-procedure .
      658       end.
      659       find first buf_temp-schedule-free where
      660               buf_temp-schedule-free.free-id = p-free-id no-error.
      661       if available buf_temp-schedule-free
      662       and buf_temp-schedule-free.is-rum
      663       then do:
      664         p-is-rum = yes.
      665       end.
      666   end.
      667   end procedure.
      668   procedure schedule-attr-fill-free-props :
      669   define variable v-path                    as character                no-undo .
      670   DEFINE VARIABLE v-full-path               as character                no-undo .
      671   DEFINE VARIABLE v-file-name               as character                no-undo .
      672   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      673   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      674   define buffer buf_temp-schedule-free for temp-schedule-free.
      675   define variable v-answer as logical no-undo .
      676     do
      677     on error undo, return error substitute("&1 &2 &3&4&5&4"
      678                                           ,vss-workfile
      679                                           ,vss-revision
      680                                           ,vss-description
      681                                           ,chr(10)
      682                                           ,error-status:get-message(1) )
      683     :
      684       run gbl/filename.p (
      685                       input 'cmp/shd-free.d'
      686                     ,output v-full-path
      687                     ,output v-path
      688                     ,output v-file-name
      689                     ,output v-file-name-no-ext
      690                     ,output v-file-name-ext
      691                     ) .
      692       input from value(v-full-path).
      693       repeat :
      694         create buf_temp-schedule-free.
      695         import buf_temp-schedule-free.
      696       END.
      697       input close.
      698       _ff:
      699       for each buf_temp-schedule-free :
      700         if buf_temp-schedule-free.free-id = '':U then do:
      701            delete buf_temp-schedule-free.
      702            next _ff.
      703          end.
      704          run schedule-attr-check-enc in this-procedure (
      705                                                       input  buf_temp-schedule-free.free-id
      706                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      707                                                               buf_temp-schedule-free.proc-param-edit-name +
      708                                                               buf_temp-schedule-free.conf-param +
      709                                                               string(buf_temp-schedule-free.is-gbd) +
      710                                                               string(buf_temp-schedule-free.is-ubd) +
      711                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      712                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      713                                                               string(buf_temp-schedule-free.other-info)
      714                                                               )
      715                                                       ,input  buf_temp-schedule-free.enc-key
      716                                                       ,output v-answer    ) no-error .
      717          if error-status:error
      718          or not v-answer then delete buf_temp-schedule-free.
      719        end.
      720     end.
      721   end procedure.
      722   Function schedule-attr-reverse returns character (str as character).
      723      define variable rev_incl_s as character init "" no-undo .
      724      define variable rev_incl_i as integer no-undo .
      725      define variable rev_incl_l as integer no-undo .
      726      rev_incl_l = length(str).
      727      do rev_incl_i = 1 to rev_incl_l:
      728         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      729      end.
      730      return rev_incl_s.
      731   end.
      732   procedure schedule-attr-check-enc.
      733     define input  parameter p-free-id   as character no-undo .
      734     define input  parameter p-value     as character no-undo .
      735     define input  parameter p-enc-value as character no-undo .
      736     define output parameter p-answer    as logical   no-undo .
      737     define variable tmp         as character no-undo .
      738     define variable v-enc-value as character no-undo .
      739     assign
      740     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      741     .
      742     run schedule-attr-pswd-enc in this-procedure
      743       ( input tmp
      744        ,output v-enc-value
      745       ) no-error .
      746     if error-status:error then do:
      747       message
      748         vss-workfile vss-revision vss-description skip
      749         "Ошибка при вызове процедуры pswd-enc" skip
      750         return-value skip
      751         error-status :get-message(1) skip
      752         view-as alert-box error .
      753       undo, return error .
      754     end.
      755     if v-enc-value = p-enc-value then do:
      756       assign
      757         p-answer = true
      758       .
      759     end.
      760     else do:
      761       assign
      762         p-answer = false
      763       .
      764     end.
      765   end.
      766   procedure schedule-attr-conf-enc.
      767     define input  parameter p-free-id   as character no-undo .
      768     define input  parameter p-value     as character no-undo .
      769     define output parameter p-enc-value as character no-undo .
      770     define variable tmp         as character no-undo .
      771     assign
      772       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      773     .
      774     run schedule-attr-pswd-enc in this-procedure
      775       ( input tmp
      776        ,output p-enc-value
      777       ) no-error .
      778     if error-status:error then do:
      779       message
      780         vss-workfile vss-revision vss-description skip
      781         "Ошибка при вызове процедуры pswd-enc" skip
      782         return-value skip
      783         error-status :get-message(1) skip
      784         view-as alert-box error .
      785       undo, return error .
      786     end.
      787   end procedure.
      788   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      789   procedure schedule-attr-pswd-enc :
      790     define input parameter  pswd     as character no-undo .
      791     define output parameter enc-pswd as character no-undo .
      792     do
      793     on error undo, return error return-value
      794     :
      795       assign
      796         enc-pswd = encode(pswd + string(index(pswd, "k")))
      797       .
      798     end.
      799   end procedure.
      800   procedure proc-alt-shift-f2:
      801     if not ibs.th.gbl.gbl-var:rcode
      802   then
      803     run gbl\inidebug.p .
      804   end.
      805   procedure proc-alt-shift-f3:
      806     run gbl/prvssinf.p
      807       ( input this-procedure
      808       ) .
      809   end.
      810   define variable v-inform-launched as logical no-undo initial false .
      811   procedure proc-alt-shift-f4:
      812     define variable v-action as character no-undo .
      813     if v-inform-launched = false then do:
      814       assign
      815         v-inform-launched = true
      816       .
      817       run gbl/d-inform.w
      818         (  input self
      819         ,  input this-procedure
      820         , output v-action
      821         ) no-error .
      822       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      823       assign
      824         v-inform-launched = false
      825       .
      826     end.
      827   end.
      828   procedure proc-alt-f1:
      829     run gbl/corrhelp.p
      830       (input this-procedure
      831       ) .
      832   end .
      833   on alt-shift-f2 anywhere do:
      834     run proc-alt-shift-f2.
      835   end.
      836   on alt-shift-f3 anywhere do:
      837     run proc-alt-shift-f3 in this-procedure .
      838   end.
      839   on alt-shift-f4 anywhere do:
      840     run proc-alt-shift-f4 in this-procedure.
      841   end.
      842   on alt-f1 anywhere do:
      843     run proc-alt-f1 in this-procedure .
      844   end.
      845   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      846     define variable v-cntxt-db-num        as integer   no-undo .
      847     define variable v-cntxt-userid        as character no-undo .
      848     define variable v-cntxt-level         as character no-undo .
      849     define variable v-cntxt-host-code-obj as integer   no-undo .
      850     define variable v-cntxt-obj-type      as character no-undo .
      851     define variable v-cntxt-obj-code      as integer   no-undo .
      852     define variable v-cntxt-db-num-obj    as integer   no-undo .
      853     define variable v-cntxt-is-admin      as logical   no-undo .
      854   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      855   define temp-table userobjs_temp-user-obj no-undo
      856     field obj-type as character
      857     field obj-code as integer
      858     index xpk is primary unique obj-type obj-code
      859     .
      860   procedure userobjs_clear :
      861     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      862     do
      863     on error undo, return error return-value
      864     :
      865       for each buf_userobjs_temp-user-obj
      866       on error undo, return error return-value
      867       :
      868         delete buf_userobjs_temp-user-obj .
      869       end.
      870     end.
      871   end .
      872   procedure userobjs_object-count :
      873     define output parameter p-total-count as integer   no-undo .
      874     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      875     do
      876     on error undo, return error return-value
      877     :
      878       assign
      879         p-total-count = 0
      880       .
      881       for each buf_userobjs_temp-user-obj
      882       on error undo, return error return-value
      883       :
      884         assign
      885           p-total-count = p-total-count + 1
      886         .
      887       end.
      888     end.
      889   end.
      890   procedure userobjs_append :
      891      define input  parameter p-obj-type as character no-undo .
      892      define input  parameter p-obj-code as integer   no-undo .
      893     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      894     do
      895     on error undo, return error return-value
      896     :
      897       find first buf_userobjs_temp-user-obj
      898         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      899           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      900         no-error .
      901       if not available buf_userobjs_temp-user-obj
      902       then do:
      903         create buf_userobjs_temp-user-obj .
      904         assign
      905           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      906           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      907         .
      908       end.
      909     end.
      910   end.
      911   procedure userobjs_object-exist :
      912     define output parameter p-object-exist as logical   no-undo .
      913     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      914     do
      915     on error undo, return error return-value
      916     :
      917       find first buf_userobjs_temp-user-obj
      918         no-error .
      919       if not available buf_userobjs_temp-user-obj
      920       then do:
      921         assign
      922           p-object-exist = false
      923         .
      924       end.
      925       else do:
      926         assign
      927           p-object-exist = true
      928         .
      929       end.
      930     end.
      931   end.
      932   procedure userobjs_transfer :
      933     define input  parameter p-callback-handle as handle no-undo .
      934     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      935     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      936     do
      937     on error undo, return error return-value
      938     :
      939       if valid-handle(p-callback-handle) <> true
      940       then do:
      941         message
      942           vss-workfile vss-revision vss-description skip
      943           "Ошибка задания входных параметров" skip
      944           "Неизвестный указатель на процедуру" skip
      945           view-as alert-box error .
      946         undo, return error return-value .
      947       end.
      948       if p-callback-handle :get-signature("userobjs_append") = ""
      949       then do:
      950         message
      951           vss-workfile vss-revision vss-description skip
      952           "Ошибка задания входных параметров" skip
      953           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      954                     ,p-callback-handle :file-name
      955                     ) skip
      956           view-as alert-box error .
      957         undo, return error return-value .
      958       end.
      959       for each buf_userobjs_temp-user-obj
      960       on error undo, return error return-value
      961       :
      962         run userobjs_append in p-callback-handle
      963           (input  buf_userobjs_temp-user-obj.obj-type
      964           ,input  buf_userobjs_temp-user-obj.obj-code
      965           ) .
      966       end.
      967     end.
      968   end procedure.
      969   procedure userobjs_select-one :
      970      define input  parameter parparentproc     as widget-handle no-undo .
      971      define input  parameter p-db-num          as integer   no-undo .
      972      define input  parameter p-user-id         as character no-undo .
      973      define input  parameter p-host-code-obj   as integer   no-undo .
      974      define input  parameter p-obj-type        as character no-undo .
      975      define input  parameter p-obj-code        as integer   no-undo .
      976      define output parameter p-user-select     as logical   no-undo .
      977      define output parameter p-select-obj-type as character no-undo .
      978      define output parameter p-select-obj-code as character no-undo .
