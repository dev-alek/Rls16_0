     1228   DEFINE FRAME Dialog-Frame
     1229        Btn_OK AT ROW 1.25 COL 1.5
     1230        Btn_Cancel AT ROW 1.25 COL 11.5
     1231        tb-incr AT ROW 1.25 COL 23
     1232        b-help AT ROW 1.25 COL 71
     1233        tb-exp-doc AT ROW 3.5 COL 3.75
     1234        tb-exp-doc-rvs at row 4.29 col 6.75
     1235        tb-exp-ref AT ROW 3.5 COL 30.25
     1236        tb-exp-fo AT ROW 3.5 COL 59.75
     1237        tb-exp-day AT ROW 5.08 COL 3.75
     1238        tb-exp-checks AT ROW 5.08 COL 6.75
     1239        tb-exp-ref-ext AT ROW 4.29 COL 33.25
     1240        tb-exp-fp AT ROW 4.5 COL 59.75
     1241        tb-exp-way AT ROW 5.92 COL 3.75
     1242        tb-exp-stk AT ROW 5.08 COL 30.25
     1243        tb-exp-s-f AT ROW 5.63 COL 59.75 WIDGET-ID 2
     1244        tb-exp-stk-supp AT ROW 5.92 COL 33.25
     1245        fi-days-amount AT ROW 7.83 COL 41.75 COLON-ALIGNED
     1246        rs-date AT ROW 8.17 COL 3.5 NO-LABEL
     1247        fi-days-ago AT ROW 9.04 COL 41.75 COLON-ALIGNED
     1248        fi-date-from AT ROW 10.29 COL 30.63 COLON-ALIGNED
     1249        fi-date-to AT ROW 10.33 COL 47.38 COLON-ALIGNED
