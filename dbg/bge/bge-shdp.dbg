     1564           , input tb-cst-code
     1565           , input tb-parts
     1566           , input tb-chk-pay-code
     1567           , input tb-pay-desk
     1568           , input tb-pay-desk-cards
     1569           , input tb-not-fact-docs
     1570           , input tb-exp-doc
     1571           , input tb-exp-doc-rvs
     1572           , input tb-exp-ref
