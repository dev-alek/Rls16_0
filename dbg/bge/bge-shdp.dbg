     3085   PROCEDURE object-select :
     3086   do
     3087   on error undo, return error
     3088   :
     3089   define input parameter p-rs-1   as integer      no-undo.
     3090   case p-rs-1
     3091   :
     3092       when 1
     3093       then do:
     3094           assign
     3095               ed-object :screen-value in frame Dialog-frame = ""
     3096           .
     3097       end.
     3098       when 2
     3099       then do:
     3100           assign
     3101               ed-object :screen-value = v-host-name
     3102           .
     3103       end.
     3104       when 3
     3105       then do:
     3106           assign
     3107               ed-object :screen-value = ""
     3108           .
     3109           for each temp_obj-list
     3110           :
     3111               assign
     3112                   ed-object :screen-value = ed-object :screen-value
     3113                       + ( if ed-object :screen-value = "" then "" else ", " )
     3114                       + temp_obj-list.obj-type + string( temp_obj-list.obj-code )
     3115               .
     3116           end.
     3117       end.
     3118   end case.
     3119   end.
     3120   END PROCEDURE.
     3121   PROCEDURE select-objects-only-this-db :
     3122   define output parameter p-only-this-db-obj-list as character    no-undo.
     3123   define output parameter p-exclude-obj-list      as character    no-undo.
     3124       define variable v-db-num                as integer       no-undo.
     3125       define variable v-obj-type              as character     no-undo.
     3126       define variable v-obj-code              as integer       no-undo.
     3127       define variable v-db-num-char           as character    no-undo.
     3128       define buffer buf_clients       for ub.clients.
     3129       define buffer buf_temp_obj-list for temp_obj-list.
     3130       define buffer buf_temp_db-num   for temp_db-num.
     3131       define buffer buf_schedule      for ub.schedule.
     3132   do
     3133   for buf_clients
     3134     , buf_temp_obj-list
     3135     , buf_temp_db-num
     3136     , buf_schedule
     3137   on error undo, return error
     3138   :
     3139       if p-task-num < 0
     3140       then do:
     3141           assign
     3142               v-db-num-char       = "*":U
     3143               p-exclude-obj-list  = "":U
     3144           .
     3145       end.
     3146       else do:
     3147           find first buf_schedule no-lock
     3148                where buf_schedule.cre-db-num  = p-cre-db-num
     3149                  and buf_schedule.task-type   = p-task-type
     3150                  and buf_schedule.task-num    = p-task-num
     3151           no-error.
     3152           if error-status :error
     3153           then do:
     3154               message
     3155                       vss-workfile vss-revision vss-description
     3156                   skip(1)
     3157                   skip "Не найдена строка расписания для определения параметров."
     3158                   skip return-value
     3159                   skip trim( error-status :get-message( 1 ) )
     3160                       trim( error-status :get-message( 2 ) )
     3161                       trim( error-status :get-message( 3 ) )
     3162               view-as alert-box error.
     3163               undo, return error.
     3164           end.
     3165           assign
     3166               p-only-this-db-obj-list = "":U
     3167               p-exclude-obj-list      = "":U
     3168               v-db-num-char           = buf_schedule.db-num-char
     3169           .
     3170       end.
     3171       if v-db-num-char <> "*":U
     3172       then do:
     3173           run gbl/prcs-lst.p (
     3174                 input v-db-num-char
     3175               , input 0
     3176               , input 99999
     3177               , input no
     3178               , input ( buffer buf_temp_db-num :handle )
     3179               , input "db-num-key":U
     3180           ) no-error .
     3181           if error-status :error
     3182           then do:
     3183               message
     3184                       vss-workfile vss-revision vss-description
     3185                   skip(1)
     3186                   skip "Ошибка разбора списка баз данных."
     3187                   skip return-value
     3188                   skip trim( error-status :get-message( 1 ) )
     3189                       trim( error-status :get-message( 2 ) )
     3190                       trim( error-status :get-message( 3 ) )
     3191               view-as alert-box error.
     3192               undo, return error.
     3193           end.
     3194       end.
     3195       for each buf_temp_obj-list
     3196       :
     3197           find first buf_clients no-lock
     3198                where buf_clients.obj-type = buf_temp_obj-list.obj-type
     3199                  and buf_clients.obj-code = buf_temp_obj-list.obj-code
     3200           .
     3201           if v-db-num-char = "*":U
     3202           then do:
     3203               assign
     3204                   p-only-this-db-obj-list = p-only-this-db-obj-list
     3205                                           + ( if p-only-this-db-obj-list <> "" then ", " else "" )
     3206                                           + buf_temp_obj-list.obj-type + string( buf_temp_obj-list.obj-code )
     3207               .
     3208           end.
     3209           else do:
     3210               find first buf_temp_db-num
     3211                    where buf_temp_db-num.db-num-key = buf_clients.db-num
     3212               no-error.
     3213               if available buf_temp_db-num
     3214               then do:
     3215                   assign
     3216                       p-only-this-db-obj-list = p-only-this-db-obj-list
     3217                                               + ( if p-only-this-db-obj-list <> "" then ", " else "" )
     3218                                               + buf_temp_obj-list.obj-type + string( buf_temp_obj-list.obj-code )
     3219                   .
     3220               end.
     3221               else do:
     3222                   assign
     3223                       p-exclude-obj-list = p-exclude-obj-list
     3224                                               + ( if p-exclude-obj-list <> "" then ", " else "" )
     3225                                               + buf_temp_obj-list.obj-type + string( buf_temp_obj-list.obj-code )
     3226                   .
     3227                   delete buf_temp_obj-list.
     3228               end.
     3229           end.
     3230       end.
     3231   end.
     3232   END PROCEDURE.
