        1   define shared temp-table tt-exts
        2       field ext-rec as recid
        3       field gds-code as integer
        4       index pi as primary unique
        5           ext-rec gds-code
        6   .
        7   define input parameter p-gds-code as integer no-undo .
        8   define output parameter p-rec   as recid no-undo .
        9   define buffer x_ext-classif     for ub.ext-classif .
       10   define buffer x_ext-classif-attr     for ub.ext-classif-attr .
       11   define variable qh-gds-egais as handle no-undo .
       12   define variable br-hndl-gds  as handle no-undo .
       13   define variable ii as integer no-undo .
       14   define new global shared variable g#language as character no-undo .
       15   if g#language <> '' and g#language <> 'rus':U then do:
       16     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       17   end.
       18   function f-name returns character (buffer loc-exts for X_ext-classif-attr) :
       19       if num-entries(loc-exts.attr-value, CHR(4)) = 3 then return entry(3, loc-exts.attr-value, CHR(4)) .
       20       else return "" .
       21   end function .
       22   function f-prod returns character (buffer loc-exts for X_ext-classif-attr) :
       23       if num-entries(loc-exts.attr-value, CHR(4)) = 3 then do :
       24           if num-entries(entry(1, loc-exts.attr-value, CHR(4)), CHR(5)) = 6 then
       25               return entry(4, entry(1, loc-exts.attr-value, CHR(4)), CHR(5)).
       26           else return "" .
       27       end.
       28       else return "" .
       29   end function .
       30   function f-imp returns character (buffer loc-exts for X_ext-classif-attr) :
       31       if num-entries(loc-exts.attr-value, CHR(4)) = 3 then do :
       32           if num-entries(entry(2, loc-exts.attr-value, CHR(4)), CHR(5)) = 6 then
       33               return entry(4, entry(2, loc-exts.attr-value, CHR(4)), CHR(5)).
       34           else return "" .
       35       end.
       36       else return "" .
       37   end function .
       38   DEFINE BUTTON b-cancel AUTO-END-KEY
       39        LABEL "Отмена"
       40        SIZE 15 BY 1.14
       41        BGCOLOR 8 .
       42   DEFINE BUTTON b-select AUTO-GO
       43        LABEL "Выбор"
       44        SIZE 15 BY 1.14
       45        BGCOLOR 8 .
       46   define query br-exts for
       47       tt-exts, x_ext-classif, x_ext-classif-attr   scrolling .
       48   define browse br-exts
       49       query br-exts display
       50           X_ext-classif.charkey_one      COLUMN-LABEL "Алкогольный код"           format "X(25)":U width 25
       51           f-name(BUFFER x_ext-classif-attr)   COLUMN-LABEL "Наименование товара ЕГАИС" format "X(50)":U width 28
       52           f-prod(BUFFER x_ext-classif-attr)   COLUMN-LABEL "Производитель"             format "X(150)":U width 27
       53           f-imp(BUFFER x_ext-classif-attr)    COLUMN-LABEL "Импортёр"                  format "X(150)":U width 27
       54   WITH NO-ROW-MARKERS SEPARATORS SIZE 107 BY 20.2 FIT-LAST-COLUMN.
       55   DEFINE FRAME Dialog-Frame
       56        b-select AT ROW 1.24 COL 2
       57        b-cancel AT ROW 1.24 COL 18
       58        br-exts  at row 2.5 col 2
       59        SPACE(0.5) SKIP(0.5)
       60       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       61            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       62            TITLE "Выбор алкогольного кода из ЕГАИС"
       63            DEFAULT-BUTTON b-select CANCEL-BUTTON b-cancel WIDGET-ID 100.
       64   ASSIGN
       65          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       66          FRAME Dialog-Frame:HIDDEN           = TRUE.
       67   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       68   DO:
       69     APPLY "END-ERROR":U TO SELF.
       70   END.
       71   ON CHOOSE OF b-select IN FRAME Dialog-Frame
       72   DO:
       73       if not available tt-exts then return .
       74       assign
       75           p-rec = tt-exts.ext-rec
       76       .
       77   END.
       78   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       79   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       80   MAIN-BLOCK:
       81   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       82      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
       84   define variable v-diasize-need-maximize        as logical   no-undo init true  .
       85   define variable v-diasize-orig-frame-height    as decimal   no-undo .
       86   define variable v-diasize-orig-frame-width     as decimal   no-undo .
       87   define variable v-diasize-current-frame-width  as decimal   no-undo .
       88   define variable v-diasize-current-frame-height as decimal   no-undo .
       89   define variable v-diasize-change-size          as logical   no-undo .
       90   define variable v-diasize-resize-button        as handle    no-undo .
       91   define variable v-diasize-wndmax               as logical   no-undo .
       92   define variable v-diasize-wndstore             as logical   no-undo .
       93   define variable v-diasize-proc-name            as character no-undo .
       94   define variable v-diasize-browse-handle        as handle    no-undo .
       95   define variable v-diasize-browse-number        as integer   no-undo .
       96   define variable v-diasize-need-full-display    as logical   no-undo init false .
       97   define temp-table temp-diasize-handle no-undo
       98     field handle-value  as handle
       99     field save-position as decimal
      100     index xpk is primary unique handle-value
      101     .
      102   define temp-table temp-browse-handle no-undo
      103     field browse-type   as character
      104     field browse-number as integer
      105     field browse-handle as handle
      106     field original-size as decimal
      107     index xpk is primary unique browse-type browse-number
      108     index xie browse-type browse-handle
      109   .
      110   procedure diasize_change-height :
      111     define input  parameter p-change-value  as decimal   no-undo .
      112     define input  parameter p-move-resize   as logical   no-undo .
      113     define variable v-field-group-handle    as handle    no-undo .
      114     define variable v-object-handle         as handle    no-undo .
      115     define variable v-frame-height          as decimal   no-undo .
      116     define variable v-frame-virtual-height  as decimal   no-undo .
      117     define variable v-browse-height         as decimal   no-undo .
      118     define variable v-window-height         as decimal   no-undo .
      119     define variable v-window-virtual-height as decimal   no-undo .
      120     define variable v-change-sign           as integer   no-undo .
      121     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      122     define buffer buf_temp-browse-handle  for temp-browse-handle .
      123     if p-change-value > 0
      124     then do:
      125       if frame Dialog-Frame :height + p-change-value
      126           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      127       then do:
      128         assign
      129           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      130                           - (frame Dialog-Frame :height-chars)
      131         .
      132         if p-change-value <= 0
      133         then do:
      134           run diasize_position-resize-button in this-procedure .
      135           return .
      136         end.
      137       end.
      138     end.
      139     if p-change-value < 0
      140     then do:
      141       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      142       then do:
      143         assign
      144           p-change-value = v-diasize-orig-frame-height
      145                          - (frame Dialog-Frame :height-chars)
      146         .
      147         if p-change-value >= 0
      148         then do:
      149           run diasize_position-resize-button in this-procedure .
      150           return .
      151         end.
      152       end.
      153     end.
      154     if p-change-value >= 0
      155     then do:
      156       assign
      157         v-change-sign = 1
      158       .
      159     end.
      160     else do:
      161       assign
      162         v-change-sign = -1
      163       .
      164     end.
      165     assign
      166       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      167     .
      168     if p-change-value = 0
      169     then do:
      170       run diasize_position-resize-button in this-procedure .
      171       return .
      172     end.
      173     move_block:
      174     do
      175     on error undo move_block, retry move_block
      176     :
      177       if retry
      178       then do:
      179         do
      180         on error undo move_block, leave move_block
      181         :
      182           if p-change-value > 0
      183           then do:
      184             for each buf_temp-diasize-handle
      185             on error undo, next
      186             :
      187               assign
      188                 v-object-handle = buf_temp-diasize-handle.handle-value
      189               .
      190               if v-object-handle <> v-diasize-resize-button
      191               then do:
      192                 assign
      193                   v-object-handle :row = buf_temp-diasize-handle.save-position
      194                 .
      195               end.
      196             end.
      197             assign
      198               v-diasize-browse-handle :height = v-browse-height
      199             .
      200             for each buf_temp-browse-handle
      201               where buf_temp-browse-handle.browse-type = 'height':u
      202             on error undo, next
      203             :
      204               assign
      205                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      206               .
      207             end.
      208             assign
      209               frame Dialog-Frame :height = v-frame-height
      210             .
      211             if frame Dialog-Frame :scrollable = true
      212             then do:
      213               assign
      214                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      215               .
      216             end.
      217             run diasize_position-resize-button in this-procedure .
      218           end.
      219           else do:
      220             if frame Dialog-Frame :scrollable = true
      221             then do:
      222               assign
      223                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      224               .
      225             end.
      226             assign
      227               frame Dialog-Frame :height = v-frame-height
      228             .
      229             assign
      230               v-diasize-browse-handle :height = v-browse-height
      231             .
      232             for each buf_temp-browse-handle
      233               where buf_temp-browse-handle.browse-type = 'height':u
      234             on error undo, next
      235             :
      236               assign
      237                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      238               .
      239             end.
      240             for each buf_temp-diasize-handle
      241             on error undo, next
      242             :
      243               assign
      244                 v-object-handle = buf_temp-diasize-handle.handle-value
      245               .
      246               if v-object-handle <> v-diasize-resize-button
      247               then do:
      248                 assign
      249                   v-object-handle :row = buf_temp-diasize-handle.save-position
      250                 .
      251               end.
      252             end.
      253             run diasize_position-resize-button in this-procedure .
      254           end.
      255           assign
      256             v-diasize-change-size = false
      257           .
      258           leave move_block .
      259         end.
      260       end.
      261       assign
      262         v-diasize-need-full-display = true
      263       .
      264       if v-diasize-change-size = false
      265       then do:
      266         assign
      267           v-diasize-change-size = true
      268         .
      269       end.
      270       else do:
      271         return .
      272       end.
      273       assign
      274         v-frame-height = frame Dialog-Frame :height
      275         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      276         v-browse-height = v-diasize-browse-handle :height
      277       .
      278       for each buf_temp-browse-handle
      279         where buf_temp-browse-handle.browse-type = 'height':u
      280       :
      281         assign
      282           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      283         .
      284       end.
      285       for each buf_temp-diasize-handle
      286       :
      287         delete buf_temp-diasize-handle .
      288       end.
      289       assign
      290         v-field-group-handle = frame Dialog-Frame :first-child
      291       .
      292       do while valid-handle(v-field-group-handle)
      293       :
      294         assign
      295           v-object-handle = v-field-group-handle :first-child
      296         .
      297         do while valid-handle(v-object-handle)
      298         :
      299           if  v-object-handle <> v-diasize-browse-handle :handle
      300           and can-query(v-object-handle, "row")
      301           and can-query(v-object-handle, "height")
      302           and ( v-object-handle :row > v-diasize-browse-handle :row )
      303           then do:
      304             find first buf_temp-browse-handle
      305               where buf_temp-browse-handle.browse-type   = 'height':u
      306                 and buf_temp-browse-handle.browse-handle = v-object-handle
      307               no-error .
      308             if available buf_temp-browse-handle
      309             then do:
      310             end.
      311             else do:
      312               create buf_temp-diasize-handle .
      313               assign
      314                 buf_temp-diasize-handle.handle-value  = v-object-handle
      315                 buf_temp-diasize-handle.save-position = v-object-handle :row
      316               .
      317             end.
      318           end.
      319           assign
      320             v-object-handle = v-object-handle :next-sibling
      321           .
      322         end.
      323         assign
      324           v-field-group-handle = v-field-group-handle :next-sibling
      325         .
      326       end.
      327       do with frame Dialog-Frame
      328       :
      329         hide v-diasize-resize-button .
      330         assign
      331           v-diasize-resize-button :row    = 1
      332           v-diasize-resize-button :column = 1
      333         .
      334       end.
      335       if p-change-value > 0
      336       then do:
      337         if frame Dialog-Frame :scrollable = true
      338         then do:
      339           assign
      340             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      341             no-error .
      342           if error-status :error
      343           or error-status :get-message(1) <> ""
      344           then do:
      345             undo move_block, retry move_block .
      346           end.
      347         end.
      348         assign
      349           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      350           no-error .
      351         if error-status :error
      352         or error-status :get-message(1) <> ""
      353         then do:
      354           undo move_block, retry move_block .
      355         end.
      356         assign
      357           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      358           no-error .
      359         if error-status :error
      360         or error-status :get-message(1) <> ""
      361         then do:
      362           undo move_block, retry move_block .
      363         end.
      364         for each buf_temp-browse-handle
      365           where buf_temp-browse-handle.browse-type = 'height':u
      366         on error undo move_block, retry move_block
      367         :
      368           assign
      369             buf_temp-browse-handle.browse-handle :height
      370               = buf_temp-browse-handle.browse-handle :height + p-change-value
      371             no-error .
      372           if error-status :error
      373           or error-status :get-message(1) <> ""
      374           then do:
      375             undo move_block, retry move_block .
      376           end.
      377         end.
      378         for each buf_temp-diasize-handle
      379         on error undo move_block, retry move_block
      380         :
      381           assign
      382             v-object-handle = buf_temp-diasize-handle.handle-value
      383           .
      384           if v-object-handle <> v-diasize-resize-button
      385           then do:
      386             assign
      387               v-object-handle :row = v-object-handle :row + p-change-value
      388               no-error .
      389             if error-status :error
      390             or error-status :get-message(1) <> ""
      391             then do:
      392               undo move_block, retry move_block .
      393             end.
      394           end.
      395         end.
      396       end.
      397       else do:
      398         for each buf_temp-diasize-handle
      399         on error undo move_block, retry move_block
      400         :
      401           assign
      402             v-object-handle = buf_temp-diasize-handle.handle-value
      403           .
      404           if v-object-handle <> v-diasize-resize-button
      405           then do:
      406             assign
      407               v-object-handle :row = v-object-handle :row + p-change-value
      408               no-error .
      409             if error-status :error
      410             or error-status :get-message(1) <> ""
      411             then do:
      412               undo move_block, retry move_block .
      413             end.
      414           end.
      415         end.
      416         assign
      417           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      418           no-error .
      419         if error-status :error
      420         or error-status :get-message(1) <> ""
      421         then do:
      422           undo move_block, retry move_block .
      423         end.
      424         for each buf_temp-browse-handle
      425           where buf_temp-browse-handle.browse-type = 'height':u
      426         on error undo move_block, retry move_block
      427         :
      428           assign
      429             buf_temp-browse-handle.browse-handle :height
      430               = buf_temp-browse-handle.browse-handle :height + p-change-value
      431             no-error .
      432           if error-status :error
      433           or error-status :get-message(1) <> ""
      434           then do:
      435             undo move_block, retry move_block .
      436           end.
      437         end.
      438         assign
      439           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      440           no-error .
      441         if error-status :error
      442         or error-status :get-message(1) <> ""
      443         then do:
      444           undo move_block, retry move_block .
      445         end.
      446         if frame Dialog-Frame :scrollable = true
      447         then do:
      448           assign
      449             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      450             no-error .
      451           if error-status :error
      452           or error-status :get-message(1) <> ""
      453           then do:
      454             undo move_block, retry move_block .
      455           end.
      456         end.
      457       end.
      458       if p-move-resize = true
      459       then do:
      460         run diasize_position-resize-button in this-procedure .
      461       end.
      462       if v-diasize-wndstore = true
      463       then do:
      464         if connected("ub") = true
      465         then do:
      466           define variable v-cntxt-db-num        as integer   no-undo .
      467           define variable v-cntxt-userid        as character no-undo .
      468           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      469                                             , OUTPUT v-cntxt-userid
      470                                             ) .
      471           run gbl/wndsizew.p
      472             (input  v-cntxt-db-num
      473             ,input  v-cntxt-userid
      474             ,input  v-diasize-proc-name
      475             ,input  'height':u
      476             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      477             ) .
      478         end.
      479       end.
      480     end.
      481     assign
      482       v-diasize-change-size = false
      483     .
      484   end procedure.
      485   procedure diasize_set-height :
      486     define input  parameter p-new-height  as decimal   no-undo .
      487     define input  parameter p-move-resize as logical   no-undo .
      488     do
      489     on error undo, return error return-value
      490     :
      491       run diasize_change-height in this-procedure
      492         (input  (p-new-height - frame Dialog-Frame :height)
      493         ,input  p-move-resize
      494         ) .
      495     end.
      496   end procedure.
      497   procedure diasize_change-width :
      498     define input  parameter p-change-value as decimal   no-undo .
      499     define input  parameter p-move-resize  as logical   no-undo .
      500     define variable v-field-group-handle   as handle    no-undo .
      501     define variable v-object-handle        as handle    no-undo .
      502     define variable v-frame-width          as decimal   no-undo .
      503     define variable v-frame-virtual-width  as decimal   no-undo .
      504     define variable v-browse-width         as decimal   no-undo .
      505     define variable v-window-width         as decimal   no-undo .
      506     define variable v-window-virtual-width as decimal   no-undo .
      507     define variable v-change-sign          as integer   no-undo .
      508     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      509     define buffer buf_temp-browse-handle  for temp-browse-handle .
      510     if p-change-value > 0
      511     then do:
      512       if frame Dialog-Frame :width + p-change-value >
      513           session :width-chars
      514       then do:
      515         assign
      516           p-change-value = session :width-chars - frame Dialog-Frame :width
      517         .
      518         if p-change-value <= 0
      519         then do:
      520           run diasize_position-resize-button in this-procedure .
      521           return .
      522         end.
      523       end.
      524     end.
      525     if p-change-value < 0
      526     then do:
      527       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      528       then do:
      529         assign
      530           p-change-value = v-diasize-orig-frame-width
      531                          - frame Dialog-Frame :width
      532         .
      533         if p-change-value >= 0
      534         then do:
      535           run diasize_position-resize-button in this-procedure .
      536           return .
      537         end.
      538       end.
      539     end.
      540     if p-change-value >= 0
      541     then do:
      542       assign
      543         v-change-sign = 1
      544       .
      545     end.
      546     else do:
      547       assign
      548         v-change-sign = -1
      549       .
      550     end.
      551     assign
      552       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      553     .
      554     if p-change-value = 0
      555     then do:
      556       run diasize_position-resize-button in this-procedure .
      557       return .
      558     end.
      559     move_block:
      560     do
      561     on error undo move_block, leave move_block
      562     :
      563       if retry
      564       then do:
      565         do
      566         on error undo move_block, leave move_block
      567         :
      568           if p-change-value > 0
      569           then do:
      570             for each buf_temp-diasize-handle
      571             on error undo, next
      572             :
      573               assign
      574                 v-object-handle = buf_temp-diasize-handle.handle-value
      575               .
      576               if v-object-handle <> v-diasize-resize-button
      577               then do:
      578                 assign
      579                   v-object-handle :col = buf_temp-diasize-handle.save-position
      580                 .
      581               end.
      582             end.
      583             assign
      584               v-diasize-browse-handle :width = v-browse-width
      585             .
      586             for each buf_temp-browse-handle
      587               where buf_temp-browse-handle.browse-type = 'width':u
      588             on error undo, next
      589             :
      590               assign
      591                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      592               .
      593             end.
      594             assign
      595               frame Dialog-Frame :width = v-frame-width
      596             .
      597             if frame Dialog-Frame :scrollable = true
      598             then do:
      599               assign
      600                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      601               .
      602             end.
      603             run diasize_position-resize-button in this-procedure .
      604           end.
      605           else do:
      606             if frame Dialog-Frame :scrollable = true
      607             then do:
      608               assign
      609                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      610               .
      611             end.
      612             assign
      613               frame Dialog-Frame :width = v-frame-width
      614             .
      615             for each buf_temp-browse-handle
      616               where buf_temp-browse-handle.browse-type = 'width':u
      617             on error undo, next
      618             :
      619               assign
      620                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      621               .
      622             end.
      623             assign
      624               v-diasize-browse-handle :width = v-browse-width
      625             .
      626             for each buf_temp-diasize-handle
      627             on error undo, next
      628             :
      629               assign
      630                 v-object-handle = buf_temp-diasize-handle.handle-value
      631               .
      632               if v-object-handle <> v-diasize-resize-button
      633               then do:
      634                 assign
      635                   v-object-handle :col = buf_temp-diasize-handle.save-position
      636                 .
      637               end.
      638             end.
      639             run diasize_position-resize-button in this-procedure .
      640           end.
      641           assign
      642             v-diasize-change-size = false
      643           .
      644           leave move_block .
      645         end.
      646       end.
      647       assign
      648         v-diasize-need-full-display = true
      649       .
      650       if v-diasize-change-size = false
      651       then do:
      652         assign
      653           v-diasize-change-size = true
      654         .
      655       end.
      656       else do:
      657         return .
      658       end.
      659       assign
      660         v-frame-width = frame Dialog-Frame :width
      661         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      662         v-browse-width = v-diasize-browse-handle :width
      663       .
      664       for each buf_temp-browse-handle
      665         where buf_temp-browse-handle.browse-type = 'width':u
      666       :
      667         assign
      668           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      669         .
      670       end.
      671       for each buf_temp-diasize-handle
      672       :
      673         delete buf_temp-diasize-handle .
      674       end.
      675       assign
      676         v-field-group-handle = frame Dialog-Frame :first-child
      677       .
      678       do while valid-handle(v-field-group-handle)
      679       :
      680         assign
      681           v-object-handle = v-field-group-handle :first-child
      682         .
      683         do while valid-handle(v-object-handle)
      684         :
      685           if  v-object-handle <> v-diasize-browse-handle :handle
      686           and v-object-handle <> v-diasize-resize-button
      687           and can-query(v-object-handle, "row")
      688           and can-query(v-object-handle, "height")
      689           and ( v-object-handle :col + v-object-handle :width
      690                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      691               )
      692           then do:
      693             find first buf_temp-browse-handle
      694               where buf_temp-browse-handle.browse-type   = 'width':u
      695                 and buf_temp-browse-handle.browse-handle = v-object-handle
      696               no-error .
      697             if available buf_temp-browse-handle
      698             then do:
      699             end.
      700             else do:
      701               create buf_temp-diasize-handle .
      702               assign
      703                 buf_temp-diasize-handle.handle-value  = v-object-handle
      704                 buf_temp-diasize-handle.save-position = v-object-handle :col
      705               .
      706             end.
      707           end.
      708           assign
      709             v-object-handle = v-object-handle :next-sibling
      710           .
      711         end.
      712         assign
      713           v-field-group-handle = v-field-group-handle :next-sibling
      714         .
      715       end.
      716       do with frame Dialog-Frame
      717       :
      718         hide v-diasize-resize-button .
      719         v-diasize-resize-button :row = 1.
      720         v-diasize-resize-button :column = 1.
      721       end.
      722       if p-change-value > 0
      723       then do:
      724         if frame Dialog-Frame :scrollable = true
      725         then do:
      726           assign
      727             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      728             no-error .
      729           if error-status :error
      730           or error-status :get-message(1) <> ""
      731           then do:
      732             undo move_block, retry move_block.
      733           end.
      734         end.
      735         assign
      736           frame Dialog-Frame :width = v-frame-width + p-change-value
      737           no-error .
      738         if error-status :error
      739         or error-status :get-message(1) <> ""
      740         then do:
      741           undo move_block, retry move_block.
      742         end.
      743         assign
      744           v-diasize-browse-handle :width = v-browse-width + p-change-value
      745         no-error .
      746         if error-status :error
      747         or error-status :get-message(1) <> ""
      748         then do:
      749           undo move_block, retry move_block.
      750         end.
      751         for each buf_temp-browse-handle
      752           where buf_temp-browse-handle.browse-type = 'width':u
      753         on error undo move_block, retry move_block
      754         :
      755           assign
      756             buf_temp-browse-handle.browse-handle :width
      757               = buf_temp-browse-handle.browse-handle :width + p-change-value
      758             no-error .
      759           if error-status :error
      760           or error-status :get-message(1) <> ""
      761           then do:
      762             undo move_block, retry move_block .
      763           end.
      764         end.
      765         for each buf_temp-diasize-handle
      766         on error undo move_block, retry move_block
      767         :
      768           assign
      769             v-object-handle = buf_temp-diasize-handle.handle-value
      770           .
      771           if v-object-handle <> v-diasize-resize-button
      772           then do:
      773             assign
      774               v-object-handle :col = v-object-handle :col + p-change-value
      775               no-error .
      776             if error-status :error
      777             or error-status :get-message(1) <> ""
      778             then do:
      779               undo move_block, retry move_block .
      780             end.
      781           end.
      782         end.
      783       end.
      784       else do:
      785         for each buf_temp-diasize-handle
      786         on error undo move_block, retry move_block
      787         :
      788           assign
      789             v-object-handle = buf_temp-diasize-handle.handle-value
      790           .
      791           if v-object-handle <> v-diasize-resize-button
      792           then do:
      793             assign
      794               v-object-handle :col = v-object-handle :col + p-change-value
      795               no-error .
      796             if error-status :error
      797             or error-status :get-message(1) <> ""
      798             then do:
      799               undo move_block, retry move_block .
      800             end.
      801           end.
      802         end.
      803         for each buf_temp-browse-handle
      804           where buf_temp-browse-handle.browse-type = 'width':u
      805         on error undo move_block, retry move_block
      806         :
      807           assign
      808             buf_temp-browse-handle.browse-handle :width
      809               = buf_temp-browse-handle.browse-handle :width + p-change-value
      810             no-error .
      811           if error-status :error
      812           or error-status :get-message(1) <> ""
      813           then do:
      814             undo move_block, retry move_block .
      815           end.
      816         end.
      817         assign
      818           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
      819           no-error .
      820         if error-status :error
      821         or error-status :get-message(1) <> ""
      822         then do:
      823           undo move_block, retry move_block.
      824         end.
      825         assign
      826           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
      827         no-error .
      828         if error-status :error
      829         or error-status :get-message(1) <> ""
      830         then do:
      831           undo move_block, retry move_block.
      832         end.
      833         if frame Dialog-Frame :scrollable = true
      834         then do:
      835           assign
      836             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      837           no-error .
      838           if error-status :error
      839           or error-status :get-message(1) <> ""
      840           then do:
      841             undo move_block, retry move_block.
      842           end.
      843         end.
      844       end.
      845       if p-move-resize
      846       then do:
      847         run diasize_position-resize-button in this-procedure .
      848       end.
      849       if v-diasize-wndstore = true
      850       then do:
      851         if connected("ub") = true
      852         then do:
      853           define variable v-cntxt-db-num        as integer   no-undo .
      854           define variable v-cntxt-userid        as character no-undo .
      855           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      856                                             , OUTPUT v-cntxt-userid
      857                                             ) .
      858           run gbl/wndsizew.p
      859             (input  v-cntxt-db-num
      860             ,input  v-cntxt-userid
      861             ,input  v-diasize-proc-name
      862             ,input  'width':u
      863             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
      864             ) .
      865         end.
      866       end.
      867     end.
      868     assign
      869       v-diasize-change-size = false
      870     .
      871   end procedure.
      872   procedure diasize_set-width :
      873     define input  parameter p-new-width  as decimal   no-undo .
      874     define input  parameter p-move-resize as logical   no-undo .
      875     do
      876     on error undo, return error return-value
      877     :
      878       run diasize_change-width in this-procedure
      879         (input  (p-new-width - frame Dialog-Frame :width)
      880         ,input  p-move-resize
      881         ) .
      882     end.
      883   end procedure.
      884   procedure diasize_position-resize-button :
      885     do with frame Dialog-Frame
      886     :
      887       hide v-diasize-resize-button .
      888       assign
      889         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
      890                     - 1
      891                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
      892         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
      893                     - 1
      894                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
      895       .
      896       view v-diasize-resize-button .
      897     end.
      898   end procedure.
      899   on alt-right anywhere
      900   do:
      901     run diasize_change-width in this-procedure
      902       (input 1
      903       ,input true
      904       ) .
      905     return no-apply .
      906   end.
      907   on alt-left anywhere
      908   do:
      909     run diasize_change-width in this-procedure
      910       (input -1
      911       ,input true
      912       ) .
      913     return no-apply .
      914   end.
      915   on alt-down anywhere
      916   do:
      917     run diasize_change-height in this-procedure
      918       (input 1
      919       ,input true
      920       ) .
      921     return no-apply .
      922   end.
      923   on alt-up anywhere
      924   do:
      925     run diasize_change-height in this-procedure
      926       (input -1
      927       ,input true
      928       ) .
      929     return no-apply .
      930   end.
      931   on alt-enter of frame Dialog-Frame
      932   do:
      933     run diasize_maximize in this-procedure
      934       (input  ?
      935       ).
      936     return no-apply .
      937   end.
      938   procedure diasize_end-move :
      939     do
      940     on error undo, return error return-value
      941     :
      942       define variable v-row-delta as decimal   no-undo .
      943       define variable v-col-delta as decimal   no-undo .
      944       define variable v-new-row as decimal   no-undo .
      945       define variable v-new-col as decimal   no-undo .
      946       assign
      947         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
      948         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
      949       .
      950       assign
      951         v-row-delta = v-new-row - frame Dialog-Frame :height
      952         v-col-delta = v-new-col - frame Dialog-Frame :width
      953       .
      954       run diasize_change-height in this-procedure
      955         (input v-row-delta
      956         ,input true
      957         ) .
      958       run diasize_change-width in this-procedure
      959         (input v-col-delta
      960         ,input true
      961         ) .
      962     end.
      963   end procedure.
      964   procedure diasize_maximize :
      965     define input  parameter p-action as logical   no-undo .
      966     do
      967     on error undo, return error return-value
      968     :
      969       if p-action = ?
      970       then do:
      971         if v-diasize-need-maximize = true
      972         then do:
      973           assign
      974             p-action = true
      975           .
      976         end.
      977         else do:
      978           assign
      979             p-action = false
      980           .
      981         end.
      982       end.
      983       if p-action = true
      984       then do:
      985         run diasize_change-height in this-procedure
      986           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
      987               - frame Dialog-Frame :height-chars
      988           ,input true
      989           ) .
      990         run diasize_change-width in this-procedure
      991           (input session :width-chars
      992               - frame Dialog-Frame :width-chars
      993           ,input true
      994           ) .
      995         assign
      996           v-diasize-need-maximize = false
      997         .
      998       end.
      999       else do:
     1000         run diasize_change-width in this-procedure
     1001           (input v-diasize-orig-frame-width
     1002               - frame Dialog-Frame :width-chars
     1003           ,input true
     1004           ) .
     1005         run diasize_change-height in this-procedure
     1006           (input v-diasize-orig-frame-height
     1007               - frame Dialog-Frame :height-chars
     1008           ,input true
     1009           ) .
     1010         assign
     1011           v-diasize-need-maximize = true
     1012         .
     1013       end.
     1014     end.
     1015   end procedure.
     1016   procedure diasize_restore-orig-size :
     1017     do
     1018     on error undo, return error return-value
     1019     :
     1020       assign
     1021         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1022         v-diasize-current-frame-height = frame Dialog-Frame :height
     1023       .
     1024       run diasize_set-height in this-procedure
     1025         (input  v-diasize-orig-frame-height
     1026         ,input  true
     1027         ) .
     1028       run diasize_set-width in this-procedure
     1029         (input  v-diasize-orig-frame-width
     1030         ,input  true
     1031         ) .
     1032     end.
     1033   end procedure.
     1034   procedure diasize_restore-current-size :
     1035     do
     1036     on error undo, return error return-value
     1037     :
     1038       run diasize_set-height in this-procedure
     1039         (input  v-diasize-current-frame-height
     1040         ,input  true
     1041         ) .
     1042       run diasize_set-width in this-procedure
     1043         (input  v-diasize-current-frame-width
     1044         ,input  true
     1045         ) .
     1046     end.
     1047   end procedure.
     1048   procedure diasize_set-browse-handle :
     1049     define input  parameter p-browse-handle as handle   no-undo .
     1050     define buffer buf_temp-browse-handle for temp-browse-handle .
     1051     do
     1052     on error undo, return error return-value
     1053     :
     1054       assign
     1055         v-diasize-browse-handle = p-browse-handle
     1056       .
     1057       for each buf_temp-browse-handle
     1058       on error undo, return error return-value
     1059       :
     1060         delete buf_temp-browse-handle .
     1061       end.
     1062     end.
     1063   end procedure.
     1064   procedure diasize_add_browse :
     1065     define input  parameter p-browse-type   as character no-undo .
     1066     define input  parameter p-browse-handle as handle    no-undo .
     1067     define buffer buf_temp-browse-handle for temp-browse-handle .
     1068     do
     1069     on error undo, return error return-value
     1070     :
     1071       assign
     1072         v-diasize-browse-number = v-diasize-browse-number + 1
     1073       .
     1074       create buf_temp-browse-handle .
     1075       assign
     1076         buf_temp-browse-handle.browse-type   = p-browse-type
     1077         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1078         buf_temp-browse-handle.browse-handle = p-browse-handle
     1079       .
     1080     end.
     1081   end procedure.
     1082   procedure diasize_init :
     1083     define variable v-default-value    as logical   no-undo .
     1084     define variable v-restore-saved    as logical   no-undo .
     1085     define variable v-resize-value-str as character no-undo .
     1086     do
     1087     on error undo, return error return-value
     1088     :
     1089       do with frame Dialog-Frame
     1090       :
     1091         assign
     1092           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1093           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1094           v-diasize-browse-handle     = browse br-exts :handle
     1095         .
     1096         create button v-diasize-resize-button
     1097         assign
     1098           parent        = frame Dialog-Frame :first-child
     1099           label         = "s"
     1100           height-pixels = 16
     1101           width-pixels  = 16
     1102           visible       = true
     1103           sensitive     = true
     1104           movable       = true
     1105           triggers:
     1106             on end-move persistent run diasize_end-move in this-procedure .
     1107           end triggers.
     1108         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1109         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1110         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1111         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1112         assign
     1113           v-diasize-wndmax = false
     1114         .
     1115         if connected("ub") = true
     1116         then do:
     1117           define variable v-cntxt-db-num        as integer   no-undo .
     1118           define variable v-cntxt-userid        as character no-undo .
     1119           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1120                                             , OUTPUT v-cntxt-userid
     1121                                             ) .
     1122           run gbl/wndpar_r.p
     1123             (input  v-cntxt-db-num
     1124             ,input  v-cntxt-userid
     1125             ,input  'wndmax':U
     1126             ,output v-diasize-wndmax
     1127             ,output v-default-value
     1128             ) .
     1129         end.
     1130         assign
     1131           v-diasize-wndstore = false
     1132         .
     1133         if connected("ub") = true
     1134         then do:
     1135           run gbl/wndpar_r.p
     1136             (input  v-cntxt-db-num
     1137             ,input  v-cntxt-userid
     1138             ,input  'wndstore':U
     1139             ,output v-diasize-wndstore
     1140             ,output v-default-value
     1141             ) .
     1142         end.
     1143         assign
     1144           v-diasize-proc-name = entry(1, program-name(2), '.')
     1145         .
     1146         if v-diasize-wndstore = true
     1147         then do:
     1148           assign
     1149             v-restore-saved = false
     1150           .
     1151           if connected("ub") = true
     1152           then do:
     1153             run gbl/wndsizer.p
     1154               (input  v-cntxt-db-num
     1155               ,input  v-cntxt-userid
     1156               ,input  v-diasize-proc-name
     1157               ,input  'height':u
     1158               ,output v-resize-value-str
     1159               ) .
     1160             if v-resize-value-str <> '':U
     1161             then do:
     1162               run diasize_change-height in this-procedure
     1163                 (input  integer(v-resize-value-str)
     1164                 ,input  true
     1165                 ) .
     1166               assign
     1167                 v-restore-saved = true
     1168               .
     1169             end.
     1170           end.
     1171           if connected("ub") = true
     1172           then do:
     1173             run gbl/wndsizer.p
     1174               (input  v-cntxt-db-num
     1175               ,input  v-cntxt-userid
     1176               ,input  v-diasize-proc-name
     1177               ,input  'width':u
     1178               ,output v-resize-value-str
     1179               ) .
     1180             if v-resize-value-str <> '':U
     1181             then do:
     1182               run diasize_change-width in this-procedure
     1183                 (input  integer(v-resize-value-str)
     1184                 ,input  true
     1185                 ) .
     1186               assign
     1187                 v-restore-saved = true
     1188               .
     1189             end.
     1190           end.
     1191           if v-restore-saved <> true
     1192           then do:
     1193             if v-diasize-wndmax = true
     1194             then do:
     1195               run diasize_maximize in this-procedure
     1196                 (input  true
     1197                 ) .
     1198             end.
     1199           end.
     1200         end.
     1201         else do:
     1202           if v-diasize-wndmax = true
     1203           then do:
     1204             run diasize_maximize in this-procedure
     1205               (input  true
     1206               ) .
     1207           end.
     1208         end.
     1209       end.
     1210     end.
     1211   end procedure.
     1212   procedure diasize_need-full-display :
     1213     define output parameter p-need-full-display as logical   no-undo .
     1214     do
     1215     on error undo, return error return-value
     1216     :
     1217       assign
     1218         p-need-full-display = v-diasize-need-full-display
     1219       .
     1220       assign
     1221         v-diasize-need-full-display = false
     1222       .
     1223     end.
     1224   end procedure.
     1225   procedure get-context :
     1226      define output parameter p-db-num as integer          no-undo.
     1227      define output parameter p-user-id as character        no-undo.
     1228      define variable v-login               as character    no-undo.
     1229      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1230      define buffer buf_user-login  for ub.user-login .
     1231      do
     1232      on error undo, return error
     1233      :
     1234            FIND FIRST buf_sys-ctrl no-lock.
     1235            ASSIGN
     1236               v-login = USERID("ub")
     1237               p-db-num = buf_sys-ctrl.db-num
     1238            .
     1239            FIND FIRST buf_user-login
     1240                 WHERE buf_user-login.db-num = p-db-num
     1241                   AND buf_user-login.user-login = v-login
     1242                 no-lock
     1243                 no-error
     1244                 .
     1245            IF AVAILABLE buf_user-login
     1246            THEN DO:
     1247               assign
     1248                  p-user-id = buf_user-login.user-id
     1249               .
     1250            END.
     1251      end.
     1252   end procedure.
     1253     run diasize_init in this-procedure .
     1254     RUN enable_UI.
     1255     WAIT-FOR GO OF FRAME Dialog-Frame.
     1256   END.
     1257   RUN disable_UI.
     1258   PROCEDURE disable_UI :
     1259     HIDE FRAME Dialog-Frame.
     1260   END PROCEDURE.
     1261   PROCEDURE enable_UI :
     1262     ENABLE b-select b-cancel br-exts
     1263         WITH FRAME Dialog-Frame.
     1264     VIEW FRAME Dialog-Frame.
     1265     br-exts:column-resizable in FRAME Dialog-Frame = true .
     1266     open query br-exts for each tt-exts no-lock where tt-exts.gds-code = p-gds-code,
     1267                            first x_ext-classif no-lock where recid(x_ext-classif) = tt-exts.ext-rec,
     1268                            first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     1269                                                              and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     1270                                                              and X_ext-classif-attr.db-num = X_ext-classif.db-num
     1271                                                              and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     1272                                                              and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     1273                                                              and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     1274                                                              and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     1275                                                              and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     1276                                                              and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     1277                                                              and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     1278                                                              and X_ext-classif-attr.attr-code = 'egais-info' .
     1279   END PROCEDURE.
