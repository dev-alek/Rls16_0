     4300   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4301   procedure get-xcnf_get-xcnf :
     4302   define input  parameter p-esys-id as integer no-undo .
     4303   define input  parameter p-db-num as integer   no-undo .
     4304   define input  parameter p-cr-db-num as integer   no-undo .
     4305   define input  parameter p-pack-num as integer   no-undo .
     4306   define input  parameter p-delivery-method as integer no-undo .
     4307   define parameter buffer buf_temp-esys-pck-sent for THpck-sent.
     4308   define parameter buffer buf_temp-esys-pck-rcvd for THpck-rcvd.
     4309   define parameter buffer curr_temp-esys-pck-sent for THcurr-pack.
     4310   define output parameter p-rec-cnt as integer   no-undo .
     4311   define buffer buf_esys-pck-keys for ub.esys-pck-keys.
     4312   define buffer buf_esys-pck-rcvd for ub.esys-pck-rcvd.
     4313   define buffer buf_esys-pck-sent for ub.esys-pck-sent.
     4314   define buffer buf_esys-route for ub.esys-route.
     4315   define buffer buf_esys-all-attr for ub.esys-all-attr.
     4316   DEFINE VARIABLE v-today as date no-undo .
     4317   DEFINE VARIABLE v-time as integer no-undo .
     4318   define variable v-del-cnt as integer no-undo .
     4319   define variable v-del-pck-num as integer   no-undo.
     4320   define frame del-route
     4321   v-del-pck-num   label "Пакет N" format ">>>>>>>>>9" skip
     4322   v-del-cnt       label "Записей" format ">>>>>>>>>9"
     4323   with view-as dialog-box side-labels 1 columns three-d title "Удаление маршрутизации"
     4324   .
     4325   main-block:
     4326   do
     4327   on error undo, return error return-value
     4328   :
     4329     if p-delivery-method <> integer('5':U) then do:
     4330       find first curr_temp-esys-pck-sent where
     4331                 curr_temp-esys-pck-sent.THesys-id = p-esys-id
     4332             and curr_temp-esys-pck-sent.THpack-num = p-pack-num no-error.
     4333       if not available curr_temp-esys-pck-sent then do:
     4334         undo, return error  substitute("Не найдена запись о текущем пакете &1 THcurr-pack в XML файлe &2:&3&4"
     4335                                         , p-pack-num
     4336                                         , p-xml-file-name
     4337                                         , chr(10)
     4338                                         , error-status:get-message(1)).
     4339       end.
     4340       p-rec-cnt = p-rec-cnt + 1.
     4341       run cur-time in this-procedure ( output v-today, output v-time) no-error .
     4342       if error-status :error then do:
     4343       .
     4344         undo, return error.
     4345       end.
     4346       if trim( curr_temp-esys-pck-sent.THcrc-pack ) = "" then do:
     4347         undo, return error  substitute( "Ошибка обработки пакета: пакет N &1 в XML файлe &2 не имеет ключа!!!"
     4348                                       , p-pack-num
     4349                                       , p-xml-file-name ).
     4350       end.
     4351       if num-entries( curr_temp-esys-pck-sent.THcrc-pack, chr(32) ) < 4 then do:
     4352         undo, return error  substitute( "Ошибка обработки пакета: некорректный ключ (&1) пакета N &2 !!!"
     4353                                     , curr_temp-esys-pck-sent.THcrc-pack
     4354                                     , p-pack-num ).
     4355       end.
     4356     end.
     4357     if p-delivery-method <> integer('5':U) then do:
     4358       for each buf_temp-esys-pck-sent
     4359       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4360       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     4361       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     4362       :
     4363         p-rec-cnt = p-rec-cnt + 1.
     4364         find buf_esys-pck-rcvd exclusive-lock
     4365           where buf_esys-pck-rcvd.esys-id   = p-esys-id
     4366             and buf_esys-pck-rcvd.db-num   = p-db-num
     4367             and buf_esys-pck-rcvd.espr-cr-db-num   = p-cr-db-num
     4368             and buf_esys-pck-rcvd.espr-pack-num = buf_temp-esys-pck-sent.THpack-num
     4369           no-error.
     4370         if not available buf_esys-pck-rcvd then do:
     4371           create buf_esys-pck-rcvd.
     4372           assign
     4373           buf_esys-pck-rcvd.esys-id    = p-esys-id
     4374           buf_esys-pck-rcvd.db-num     = p-db-num
     4375           buf_esys-pck-rcvd.espr-cr-db-num     = p-cr-db-num
     4376           buf_esys-pck-rcvd.espr-pack-num   = buf_temp-esys-pck-sent.THpack-num
     4377           buf_esys-pck-rcvd.espr-rcvd       = buf_temp-esys-pck-sent.THrcvd
     4378           buf_esys-pck-rcvd.espr-rcvd-recs  = 0
     4379           buf_esys-pck-rcvd.espr-total-recs = buf_temp-esys-pck-sent.THtotal-recs
     4380           buf_esys-pck-rcvd.espr-crc-pack   = buf_temp-esys-pck-sent.THcrc-pack
     4381           buf_esys-pck-rcvd.custom-pack-name = buf_temp-esys-pck-sent.THfilename
     4382           .
     4383           find first buf_esys-all-attr share-lock where
     4384                   buf_esys-all-attr.attr-code = 'custom-pack-name':U
     4385               and buf_esys-all-attr.table-name = 'esys-pck-rcvd':U
     4386               and buf_esys-all-attr.key1 = buf_esys-pck-rcvd.espr-pack-num
     4387               and buf_esys-all-attr.key2 = p-esys-id
     4388               and buf_esys-all-attr.key5 = p-db-num
     4389               and buf_esys-all-attr.key6 = p-cr-db-num no-error.
     4390           if available buf_esys-all-attr then do:
     4391             buf_esys-pck-rcvd.custom-pack-name = buf_esys-all-attr.attr-value.
     4392             delete buf_esys-all-attr.
     4393           end.
     4394         end.
     4395       end.
     4396     end.
     4397     for each buf_temp-esys-pck-rcvd
     4398     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4399     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     4400     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     4401     :
     4402       p-rec-cnt = p-rec-cnt + 1.
     4403       find buf_esys-pck-sent share-lock
     4404         where buf_esys-pck-sent.esys-id  = p-esys-id
     4405           and buf_esys-pck-sent.db-num   = p-db-num
     4406           and buf_esys-pck-sent.esps-cr-db-num = p-cr-db-num
     4407           and buf_esys-pck-sent.esps-pack-num = buf_temp-esys-pck-rcvd.THpack-num
     4408         no-error.
     4409       if available buf_esys-pck-sent then do:
     4410         assign
     4411           v-del-cnt = 0
     4412         .
     4413         view frame del-route .
     4414         for each buf_esys-route
     4415           where buf_esys-route.esys-id  = buf_esys-pck-sent.esys-id
     4416             and buf_esys-route.db-num    = buf_esys-pck-sent.db-num
     4417             and buf_esys-route.esr-cr-db-num    = buf_esys-pck-sent.esps-cr-db-num
     4418             and buf_esys-route.esr-last-pack = buf_esys-pck-sent.esps-pack-num
     4419         on error  undo, return error substitute("&1. error buf_esys-route &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4420         on endkey undo, return error substitute("&1. endkey buf_esys-route")
     4421         on stop   undo, return error substitute("&1. stop buf_esys-route")
     4422         :
     4423           assign
     4424             v-del-cnt = v-del-cnt + 1
     4425           .
     4426           do with frame del-route
     4427           :
     4428             assign
     4429               v-del-pck-num :screen-value   = string( buf_esys-route.esr-last-pack, v-del-pck-num :format)
     4430               v-del-cnt :screen-value       = string( v-del-cnt, v-del-cnt :format)
     4431             .
     4432           end.
     4433           delete buf_esys-route.
     4434         end.
     4435         hide frame del-route .
     4436         transaction_block_pck-rcvd:
     4437         do
     4438         on error  undo, return error substitute("&1. error transaction_block_pck-rcvd &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4439         on endkey undo, return error substitute("&1. endkey transaction_block_pck-rcvd")
     4440         on stop   undo, return error substitute("&1. stop transaction_block_pck-rcvd")
     4441         :
     4442           assign
     4443             buf_esys-pck-sent.esps-rcvd        = yes
     4444             buf_esys-pck-sent.esps-rcvdDate    = buf_temp-esys-pck-rcvd.thrcvddate
     4445             buf_esys-pck-sent.esps-RcvdTimeInt = buf_temp-esys-pck-rcvd.thrcvdtimeint
     4446             buf_esys-pck-sent.esps-RcvdTime    = string( buf_temp-esys-pck-rcvd.thrcvdtimeint, "HH:MM:SS" )
     4447           .
     4448         end.
     4449       end.
     4450       delete buf_temp-esys-pck-rcvd.
     4451     end.
     4452   end.
     4453   end procedure.
     4454   procedure get-xcnf_set-xcnf :
     4455   define input  parameter p-esys-id as integer no-undo .
     4456   define input  parameter p-db-num as integer   no-undo .
     4457   define input  parameter p-cr-db-num as integer   no-undo .
     4458   define input  parameter p-pack-num as integer   no-undo .
     4459   define input  parameter p-rec-cnt     as integer   no-undo.
     4460   define input  parameter p-headerh as handle.
     4461   define parameter buffer buf_temp-esys-pck-sent for THpck-sent.
     4462   define parameter buffer buf_temp-esys-pck-rcvd for THpck-rcvd.
     4463   define parameter buffer curr_temp-esys-pck-sent for THcurr-pack.
     4464   define variable v-present as logical no-undo .
     4465   define buffer buf_esys-pck-rcvd for ub.esys-pck-rcvd.
     4466   define buffer buf_esys-pck-sent for ub.esys-pck-sent.
     4467   define buffer buf_esys-all-attr for ub.esys-all-attr.
     4468   do
     4469   on error undo, return error return-value
     4470   :
     4471     transaction_block_end:
     4472     do
     4473     on error  undo, return error substitute("&1. error transaction_block_end &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4474     on endkey undo, return error substitute("&1. endkey transaction_block_end")
     4475     on stop   undo, return error substitute("&1. stop transaction_block_end")
     4476     :
     4477       find first buf_temp-esys-pck-sent
     4478         where buf_temp-esys-pck-sent.THesys-id = p-esys-id
     4479           and buf_temp-esys-pck-sent.THpack-num = p-pack-num
     4480         no-error.
     4481       if not available buf_temp-esys-pck-sent
     4482       then do:
     4483         undo, return error substitute( "&1. Отсутствует полная информация о пакете &2 для ВС &3"
     4484                                       ,vss-workfile
     4485                                       ,p-pack-num
     4486                                       ,p-esys-id
     4487                                     )  .
     4488       end.
     4489   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4490   find buf_esys-pck-rcvd exclusive-lock
     4491     where buf_esys-pck-rcvd.esys-id  = p-esys-id
     4492       and buf_esys-pck-rcvd.db-num   = p-db-num
     4493       and buf_esys-pck-rcvd.espr-cr-db-num   = p-cr-db-num
     4494       and buf_esys-pck-rcvd.espr-pack-num = p-pack-num
     4495     no-error.
     4496   if not available buf_esys-pck-rcvd then do:
     4497     create buf_esys-pck-rcvd.
     4498     assign
     4499     buf_esys-pck-rcvd.esys-id    = p-esys-id
     4500     buf_esys-pck-rcvd.db-num     = p-db-num
     4501     buf_esys-pck-rcvd.espr-cr-db-num     = p-cr-db-num
     4502     buf_esys-pck-rcvd.espr-pack-num   = p-pack-num
     4503     .
     4504   end.
     4505       if new(buf_esys-pck-rcvd) then do:
     4506         buf_esys-pck-rcvd.espr-rcvd       = buf_temp-esys-pck-sent.THrcvd.
     4507       end.
     4508       assign
     4509       buf_esys-pck-rcvd.espr-rcvd-recs  = p-rec-cnt
     4510       buf_esys-pck-rcvd.espr-total-recs = (if valid-handle(p-headerh)
     4511                                            then (if p-headerh:table = "thheader"
     4512                                                  then p-headerh::THtotal-recs
     4513                                                  else 1)
     4514                                            else 1)
     4515       buf_esys-pck-rcvd.espr-CRC-pack   = buf_temp-esys-pck-sent.THCRC-pack
     4516       buf_esys-pck-rcvd.custom-pack-name = buf_temp-esys-pck-sent.THfilename
     4517       .
     4518       find first buf_esys-all-attr share-lock where
     4519               buf_esys-all-attr.attr-code = 'custom-pack-name':U
     4520           and buf_esys-all-attr.table-name = 'esys-pck-rcvd':U
     4521           and buf_esys-all-attr.key1 = buf_esys-pck-rcvd.espr-pack-num
     4522           and buf_esys-all-attr.key2 = p-esys-id
     4523           and buf_esys-all-attr.key5 = p-db-num
     4524           and buf_esys-all-attr.key6 = p-cr-db-num no-error.
     4525       if available buf_esys-all-attr then do:
     4526           buf_esys-pck-rcvd.custom-pack-name = buf_esys-all-attr.attr-value.
     4527           delete buf_esys-all-attr.
     4528       end.
     4529       for each buf_esys-pck-rcvd exclusive-lock
     4530         where buf_esys-pck-rcvd.esys-id = p-esys-id
     4531           and buf_esys-pck-rcvd.db-num = p-db-num
     4532           and buf_esys-pck-rcvd.espr-cr-db-num = p-cr-db-num
     4533           and buf_esys-pck-rcvd.espr-rcvd   = no
     4534       on error  undo, return error substitute("&1. error buf_esys-pck-rcvd &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4535       on endkey undo, return error substitute("&1. endkey buf_esys-pck-rcvd")
     4536       on stop   undo, return error substitute("&1. stop buf_esys-pck-rcvd")
     4537       :
     4538         find first buf_temp-esys-pck-sent no-lock
     4539           where buf_temp-esys-pck-sent.thesys-id = p-esys-id
     4540             and buf_temp-esys-pck-sent.THpack-num = buf_esys-pck-rcvd.espr-pack-num
     4541           no-error .
     4542         if not available buf_temp-esys-pck-sent then do:
     4543           assign
     4544             buf_esys-pck-rcvd.espr-rcvd = yes
     4545           .
     4546         end.
     4547       end.
     4548       run get-xcnf_check-imp-rec in this-procedure
     4549         ( input  "delete":U
     4550         ,input  p-esys-id
     4551         ,input  p-db-num
     4552         ,input  p-cr-db-num
     4553         ,input  p-pack-num
     4554         ,input  ?
     4555         ,output v-present
     4556         ) no-error .
     4557       if error-status :error then do:
     4558         undo, return  error  substitute( "&1. Ошибка при удалении уникальных ключей строк пакета. &2", vss-workfile, return-value ).
     4559       end.
     4560       run ext-system-attr-write in this-procedure
     4561         ( input p-esys-id
     4562         ,input p-db-num
     4563         ,input 'need-gen-new-xpack':U
     4564         ,input "yes":U
     4565         ) no-error.
     4566       if error-status :error then do:
     4567         undo, return error   substitute( "&1. Ошибка записи атрибута формирования нового пакета для ВС &2"
     4568                                       ,vss-workfile
     4569                                       ,p-esys-id~
     4570                                     ).
     4571       end.
     4572     end.
     4573   end.
     4574   end procedure.
     4575   procedure get-xcnf_set0xcnf :
     4576   define input  parameter p-esys-id as integer no-undo .
     4577   define input  parameter p-db-num as integer   no-undo .
     4578   define input  parameter p-cr-db-num as integer   no-undo .
     4579   define input  parameter p-pack-num as integer   no-undo .
     4580   define input  parameter p-delivery-method as integer no-undo .
     4581   define input  parameter p-rec-cnt as integer   no-undo .
     4582   define input  parameter p-headerh as handle no-undo .
     4583   define variable v-present as logical no-undo .
     4584   define variable v-rcvd as logical no-undo .
     4585   define buffer buf_esys-pck-rcvd for ub.esys-pck-rcvd.
     4586   define buffer buf_esys-all-attr for ub.esys-all-attr.
     4587   define buffer buf_temp-esys-pck-sent for THpck-sent.
     4588     do
     4589     on error undo, return error return-value
     4590     :
     4591       find buf_esys-pck-rcvd exclusive-lock
     4592         where buf_esys-pck-rcvd.esys-id  = p-esys-id
     4593           and buf_esys-pck-rcvd.db-num   = p-db-num
     4594           and buf_esys-pck-rcvd.espr-cr-db-num   = p-cr-db-num
     4595           and buf_esys-pck-rcvd.espr-pack-num = p-pack-num
     4596         no-error.
     4597       if not available buf_esys-pck-rcvd then do:
     4598         create buf_esys-pck-rcvd.
     4599         assign
     4600         buf_esys-pck-rcvd.esys-id    = p-esys-id
     4601         buf_esys-pck-rcvd.db-num     = p-db-num
     4602         buf_esys-pck-rcvd.espr-cr-db-num     = p-cr-db-num
     4603         buf_esys-pck-rcvd.espr-pack-num   = p-pack-num
     4604         .
     4605         find first buf_esys-all-attr share-lock where
     4606                 buf_esys-all-attr.attr-code = 'custom-pack-name':U
     4607             and buf_esys-all-attr.table-name = 'esys-pck-rcvd':U
     4608             and buf_esys-all-attr.key1 = buf_esys-pck-rcvd.espr-pack-num
     4609             and buf_esys-all-attr.key2 = p-esys-id
     4610             and buf_esys-all-attr.key5 = p-db-num
     4611             and buf_esys-all-attr.key6 = p-cr-db-num no-error.
     4612         if available buf_esys-all-attr then do:
     4613            buf_esys-pck-rcvd.custom-pack-name = buf_esys-all-attr.attr-value.
     4614            delete buf_esys-all-attr.
     4615         end.
     4616       end.
     4617       define variable v-recs as integer no-undo .
     4618       define variable v-filename as character no-undo .
     4619       if valid-handle(p-headerh) then do:
     4620         case p-headerh:table:
     4621           when  "THheader" then do:
     4622             assign
     4623             v-recs = p-headerh::THtotal-recs
     4624             v-filename = p-headerh::THfilename
     4625             .
     4626           end.
     4627           when "header_" then do:
     4628             define variable v1-flag as logical no-undo .
     4629             assign
     4630             v-recs = 1
     4631             v-filename =  get-short-pack-name( input "get"
     4632                                             , input buf_esys-pck-rcvd.espr-pack-num
     4633                                             , input p-delivery-method
     4634                                             , input buf_esys-pck-rcvd.custom-pack-name
     4635                                             , output v1-flag).
     4636           end.
     4637         end case.
     4638       end.
     4639       else do:
     4640         if p-delivery-method = integer('5':U)
     4641         or p-delivery-method = integer('11':U)
     4642         then do:
     4643           assign
     4644           v-recs = 1
     4645           v-filename = buf_esys-pck-rcvd.custom-pack-name
     4646           .
     4647         end.
     4648       end.
     4649       if p-delivery-method = integer('5':U) then do:
     4650         find first buf_temp-esys-pck-sent no-lock
     4651           where buf_temp-esys-pck-sent.thesys-id = p-esys-id
     4652             and buf_temp-esys-pck-sent.THpack-num = buf_esys-pck-rcvd.espr-pack-num
     4653           no-error .
     4654         if available buf_temp-esys-pck-sent then do:
     4655           v-rcvd = yes.
     4656         end.
     4657       end.
     4658       else do:
     4659         v-rcvd = yes.
     4660       end.
     4661       assign
     4662       buf_esys-pck-rcvd.espr-total-recs = v-recs
     4663       buf_esys-pck-rcvd.espr-rcvd-recs = p-rec-cnt
     4664       buf_esys-pck-rcvd.espr-CRC-pack   = ""
     4665       buf_esys-pck-rcvd.espr-rcvd  = v-rcvd
     4666       buf_esys-pck-rcvd.custom-pack-name = v-filename
     4667       .
     4668       ibs.th.bge.1crn.import.impmsgs:writeError2Db(
     4669          p-esys-id
     4670         ,p-db-num
     4671         ,p-cr-db-num
     4672         ,p-pack-num).
     4673       run str/callnews.p
     4674         (input 'esys-pck-rcvd':U
     4675         ,input (buffer buf_esys-pck-rcvd:handle)
     4676         )  .
     4677       run get-xcnf_check-imp-rec in this-procedure
     4678         ( input  "delete":U
     4679         ,input  p-esys-id
     4680         ,input  p-db-num
     4681         ,input  p-cr-db-num
     4682         ,input  p-pack-num
     4683         ,input  ?
     4684         ,output v-present
     4685         ) no-error .
     4686       if error-status :error then do:
     4687         undo, return  error  substitute( "&1. Ошибка при удалении уникальных ключей строк пакета. &2", vss-workfile, return-value ).
     4688       end.
     4689     end.
     4690   end procedure.
     4691   procedure get-xcnf_check-imp-rec :
     4692     define input  parameter p-action   as character no-undo .
     4693     define input  parameter p-esys-id  as integer no-undo .
     4694     define input  parameter p-db-num   as integer   no-undo .
     4695     define input  parameter p-cr-db-num as integer no-undo .
     4696     define input  parameter p-pack-num as integer   no-undo .
     4697     define input  parameter p-uniq-key as character no-undo .
     4698     define output parameter p-present  as logical   no-undo .
     4699     do
     4700     on error  undo, return error substitute( "&1 (check-imp-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4701     on stop   undo, return error substitute( "&1 (check-imp-rec). stop", vss-workfile )
     4702     on endkey undo, return error substitute( "&1 (check-imp-rec). endkey", vss-workfile )
     4703     :
     4704       define buffer buf_esys-pck-keys for ub.esys-pck-keys .
     4705       case p-action :
     4706         when "create":U then do:
     4707           if not transaction then do:
     4708             message
     4709               vss-workfile vss-revision vss-description skip
     4710               substitute( "Вызов процедуры check-imp-rec( create ) возможен только в одной транзакции с приемом записи!" )
     4711               view-as alert-box error
     4712             .
     4713             return error .
     4714           end.
     4715           find first buf_esys-pck-keys
     4716             where buf_esys-pck-keys.esys-id  = p-esys-id
     4717               and buf_esys-pck-keys.db-num   = p-db-num
     4718               and buf_esys-pck-keys.espr-cr-db-num = p-cr-db-num
     4719               and buf_esys-pck-keys.espr-pack-num = p-pack-num
     4720               and buf_esys-pck-keys.espr-uniq-key = p-uniq-key
     4721             no-error .
     4722           if available buf_esys-pck-keys then do:
     4723             assign
     4724               p-present = true
     4725             .
     4726           end.
     4727           else do:
     4728             do transaction
     4729             on error undo, return error
     4730             :
     4731               create buf_esys-pck-keys .
     4732               assign
     4733               buf_esys-pck-keys.esys-id  = p-esys-id
     4734               buf_esys-pck-keys.db-num   = p-db-num
     4735               buf_esys-pck-keys.espr-cr-db-num = p-cr-db-num
     4736               buf_esys-pck-keys.espr-pack-num = p-pack-num
     4737               buf_esys-pck-keys.espr-uniq-key = p-uniq-key
     4738               p-present = false
     4739               .
     4740             end.
     4741           end.
     4742         end.
     4743         when "delete":U then do:
     4744           for each buf_esys-pck-keys exclusive-lock
     4745             where buf_esys-pck-keys.esys-id  = p-esys-id
     4746               and buf_esys-pck-keys.db-num   = p-db-num
     4747               and buf_esys-pck-keys.espr-cr-db-num = p-cr-db-num
     4748               and buf_esys-pck-keys.espr-pack-num = p-pack-num
     4749           on error  undo, return error substitute( "&1 (check-imp-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4750           on stop   undo, return error substitute( "&1 (check-imp-rec). stop", vss-workfile )
     4751           on endkey undo, return error substitute( "&1 (check-imp-rec). endkey", vss-workfile )
     4752           :
     4753             delete buf_esys-pck-keys.
     4754           end.
     4755         end.
     4756       end case.
     4757     end.
     4758     return.
     4759   end procedure.
     4760   procedure get-xcnf_create-temp-esys-pck-rcvd :
     4761   define input parameter p-esys-id as integer no-undo .
     4762   define input parameter p-pack-num as integer no-undo .
     4763   define input parameter p-crc-pack as character no-undo .
     4764   define input parameter p-rcvd as logical no-undo .
     4765   define input parameter p-rcvd-recs as integer no-undo .
     4766   define input parameter p-total-recs as integer no-undo .
     4767   define input parameter p-rcvd-date as date no-undo .
     4768   define input parameter p-rcvd-time-int as integer no-undo .
     4769   define input parameter p-rcvd-time as character no-undo .
     4770   define buffer buf_temp-esys-pck-rcvd for THpck-rcvd.
     4771   do
     4772   on error undo, return error
     4773   :
     4774     find first buf_temp-esys-pck-rcvd where
     4775               buf_temp-esys-pck-rcvd.THesys-id = p-esys-id
     4776           and buf_temp-esys-pck-rcvd.thpack-num = p-pack-num no-error.
     4777     if not available buf_temp-esys-pck-rcvd then do:
     4778       create buf_temp-esys-pck-rcvd.
     4779       assign
     4780       buf_temp-esys-pck-rcvd.thesys-id = p-esys-id
     4781       buf_temp-esys-pck-rcvd.thpack-num = p-pack-num
     4782       .
     4783     end.
     4784     assign
     4785     buf_temp-esys-pck-rcvd.THcrc-pack  = p-crc-pack
     4786     buf_temp-esys-pck-rcvd.THrcvd-recs   = p-rcvd-recs
     4787     buf_temp-esys-pck-rcvd.THrcvd  = p-rcvd
     4788     buf_temp-esys-pck-rcvd.THtotal-recs   = p-total-recs
     4789     buf_temp-esys-pck-rcvd.THrcvddate  = p-rcvd-date
     4790     buf_temp-esys-pck-rcvd.THrcvdtimeint = p-rcvd-time-int
     4791     buf_temp-esys-pck-rcvd.THrcvdtime  = p-rcvd-time
     4792     .
     4793   end.
     4794   end procedure.
     4795   procedure get-xcnf_create-temp-esys-pck-sent :
     4796   define input parameter p-esys-id as integer no-undo .
     4797   define input parameter p-pack-num as integer no-undo .
     4798   define input parameter p-crc-pack as character no-undo .
     4799   define input parameter p-rcvd as logical no-undo .
     4800   define input parameter p-rcvd-recs as integer no-undo .
     4801   define input parameter p-total-recs as integer no-undo .
     4802   define input parameter p-rcvd-date as date no-undo .
     4803   define input parameter p-rcvd-time-int as integer no-undo .
     4804   define input parameter p-rcvd-time as character no-undo .
     4805   define buffer buf_temp-esys-pck-sent for THpck-sent.
     4806   do
     4807   on error undo, return error
     4808   :
     4809     find first buf_temp-esys-pck-sent where
     4810               buf_temp-esys-pck-sent.THesys-id = p-esys-id
     4811           and buf_temp-esys-pck-sent.thpack-num = p-pack-num no-error.
     4812     if not available buf_temp-esys-pck-sent then do:
     4813       create buf_temp-esys-pck-sent.
     4814       assign
     4815       buf_temp-esys-pck-sent.thesys-id = p-esys-id
     4816       buf_temp-esys-pck-sent.thpack-num = p-pack-num
     4817       .
     4818     end.
     4819     assign
     4820     buf_temp-esys-pck-sent.THcrc-pack  = p-crc-pack
     4821     buf_temp-esys-pck-sent.THtotal-recs   = p-total-recs
     4822     buf_temp-esys-pck-sent.THrcvd  = p-rcvd
     4823     buf_temp-esys-pck-sent.THtotal-recs   = p-total-recs
     4824     buf_temp-esys-pck-sent.THrcvddate  = p-rcvd-date
     4825     buf_temp-esys-pck-sent.THrcvdtimeint = p-rcvd-time-int
     4826     buf_temp-esys-pck-sent.THrcvdtime  = p-rcvd-time
     4827     buf_temp-esys-pck-sent.THtotal-recs = p-total-recs
     4828     .
     4829   end.
     4830   end procedure.
     4831   procedure get-xcnf_find-pack-by-rd-uniq-key-rec :
     4832   define input parameter p-esys-id as integer no-undo .
     4833   define input parameter p-db-num as integer no-undo .
     4834   define input parameter p-uniq-key-rec as character no-undo .
     4835   define buffer buf_esys-route-dump for ub.esys-route-dump.
     4836   define buffer buf_esys-route for ub.esys-route.
     4837   do
     4838   on error undo, return error
     4839   :
     4840     for each buf_esys-route-dump no-lock where
     4841             buf_esys-route-dump.esrd-uniq-key-rec = p-uniq-key-rec,
     4842         first buf_esys-route no-lock where
     4843             buf_esys-route.esr-dump-ord   = buf_esys-route-dump.esrd-dump-ord
     4844         and buf_esys-route.esys-id   = p-esys-id
     4845         and buf_esys-route.db-num   = p-db-num:
     4846       if buf_esys-route.esr-last-pack <> ?
     4847       and buf_esys-route.esr-last-pack >= 0 then do:
     4848         p-pack-num = buf_esys-route.esr-last-pack.
     4849         return.
     4850       end.
     4851     end.
     4852   end.
     4853   end procedure.
     4854   procedure get-xcnf_find-pack-by-rd :
     4855   define input parameter p-esys-id as integer no-undo .
     4856   define input parameter p-db-num as integer no-undo .
     4857   define input parameter p-dump-ord as int64 no-undo .
     4858   define buffer buf_esys-route-dump for ub.esys-route-dump.
     4859   define buffer buf_esys-route for ub.esys-route.
     4860   do
     4861   on error undo, return error
     4862   :
     4863     for each buf_esys-route-dump no-lock where
     4864             buf_esys-route-dump.esrd-dump-ord = p-dump-ord,
     4865         first buf_esys-route no-lock where
     4866             buf_esys-route.esr-dump-ord   = buf_esys-route-dump.esrd-dump-ord
     4867         and buf_esys-route.esys-id   = p-esys-id
     4868         and buf_esys-route.db-num   = p-db-num:
     4869       if buf_esys-route.esr-last-pack <> ?
     4870       and buf_esys-route.esr-last-pack >= 0 then do:
     4871         p-pack-num = buf_esys-route.esr-last-pack.
     4872         return.
     4873       end.
     4874     end.
     4875   end.
     4876   end procedure.
