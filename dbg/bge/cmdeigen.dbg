     4879   define temp-table temp-rel-handle no-undo
     4880   field dh as handle
     4881   field ii as integer
     4882   field active_ as logical
     4883   field child-buffer_ as character
     4884   field parent-buffer_ as character
     4885   field child-buffer-handle as handle
     4886   field parent-buffer-handle as handle
