     5405   procedure fill-ext-classif:
     5406   define input parameter p-db-num as integer no-undo .
     5407   define input parameter p-Key#One  as integer no-undo .
     5408   define input parameter p-Key#Two  as integer no-undo .
     5409   define input parameter p-CharKey_One  as character no-undo .
     5410   do
