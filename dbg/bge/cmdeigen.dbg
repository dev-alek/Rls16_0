     4900   procedure tmpreldf_get-relations :
     4901   define input parameter p-dataseth as handle no-undo .
     4902   define variable v-ii as integer no-undo .
     4903   define buffer buf_temp-rel-handle for temp-rel-handle.
     4904   do
     4905   on error undo, return error
     4906   :
     4907     if not valid-handle(p-dataseth)
     4908     or p-dataseth:type <> "DATASET"
     4909     then do:
     4910       return error substitute("Не определен dataset с handle &1", p-dataseth).
     4911     end.
     4912     for each buf_temp-rel-handle where
     4913             buf_temp-rel-handle.dh = p-dataseth:
     4914       delete buf_temp-rel-handle.
     4915     end.
     4916     do v-ii = 1 to p-dataseth:num-relations:
     4917       create buf_temp-rel-handle.
     4918       assign
     4919       buf_temp-rel-handle.ii = v-ii
     4920       buf_temp-rel-handle.dh = p-dataseth
     4921       buf_temp-rel-handle.active_ = p-dataseth:get-relation(v-ii):active
     4922       buf_temp-rel-handle.child-buffer_ = p-dataseth:get-relation(v-ii):child-buffer:name
     4923       buf_temp-rel-handle.parent-buffer_ = p-dataseth:get-relation(v-ii):parent-buffer:name
     4924       buf_temp-rel-handle.child-buffer-handle = p-dataseth:get-relation(v-ii):child-buffer
     4925       buf_temp-rel-handle.tbl-handle_ = buf_temp-rel-handle.child-buffer-handle
     4926       buf_temp-rel-handle.parent-buffer-handle = p-dataseth:get-relation(v-ii):parent-buffer
     4927       buf_temp-rel-handle.name_ = p-dataseth:get-relation(v-ii):name
     4928       buf_temp-rel-handle.nested_ = p-dataseth:get-relation(v-ii):nested
     4929       buf_temp-rel-handle.relation-fields_ = p-dataseth:get-relation(v-ii):relation-fields
     4930       buf_temp-rel-handle.reposition_ = p-dataseth:get-relation(v-ii):reposition
     4931       buf_temp-rel-handle.type_ = p-dataseth:get-relation(v-ii):type
     4932       buf_temp-rel-handle.query_ = p-dataseth:get-relation(v-ii):query
     4933       buf_temp-rel-handle.where-string_ = p-dataseth:get-relation(v-ii):where-string
     4934       .
     4935     end.
     4936   end.
     4937   end procedure.
     4938   procedure tmpreldf_set-relations :
     4939   define input parameter p-srcdataseth as handle no-undo .
     4940   define input parameter p-trgdataseth as handle no-undo .
     4941   define variable gh as handle no-undo .
     4942   define buffer buf_temp-rel-handle for temp-rel-handle.
     4943   do
     4944   on error undo, return error
     4945   :
     4946     if not valid-handle(p-srcdataseth)
     4947     or p-srcdataseth:type <> "DATASET"
     4948     then do:
     4949       return error substitute("Не определен dataset-источник с handle &1", p-srcdataseth).
     4950     end.
     4951     if not valid-handle(p-trgdataseth)
     4952     or p-trgdataseth:type <> "DATASET"
     4953     then do:
     4954       return error substitute("Не определен dataset-приемник с handle &1", p-trgdataseth).
     4955     end.
     4956     for each buf_temp-rel-handle no-lock where
     4957             buf_temp-rel-handle.dh = p-srcdataseth
     4958     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4959     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     4960     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     4961     :
     4962       gh = p-trgdataseth:ADD-RELATION ( buf_temp-rel-handle.parent-buffer-handle
     4963                                         , buf_temp-rel-handle.child-buffer-handle
     4964                                         , buf_temp-rel-handle.relation-fields_
     4965                                         , buf_temp-rel-handle.reposition_
     4966                                         , buf_temp-rel-handle.nested_).
     4967      if error-status:error
     4968      or not valid-handle(gh) then do:
     4969        undo, return error substitute("Ошибка при добавлении relation &1 в dataset &2", buf_temp-rel-handle.name, p-trgdataseth:name).
     4970      end.
     4971     end.
     4972   end.
     4973   end procedure.
