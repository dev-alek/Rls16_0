        1   block-level on error undo, throw.
        2   define input parameter parparentproc as handle no-undo .
        3   define input parameter p-parent-handle as handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-esys-id as integer   no-undo .
        6   define input parameter p-db-num  as integer   no-undo .
        7   define input parameter p-cr-db-num as integer no-undo .
        8   define input parameter p-xml-file-name as character no-undo .
        9   define input parameter p-file-name as character no-undo .
       10   define input parameter p-pack-data as memptr no-undo . // с 23/VIII-2018 xml-файл читается из memptr, а не из файла
       11   define input parameter p-pack-num as integer   no-undo .
       12   define input parameter p-log-file-name as character no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision: f4cdafb70594, 2001, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: druban $":U .
       15   define variable vss-date        as character no-undo init "$Date: Wed Sep 18 21:00:35 2019 +0300 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: cmdeigen.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: bge/cmdeigen.p $":U .
       18   define variable vss-description as character no-undo init "Импорт файла XML из внешней системы".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   define  shared variable g#auto-pid           as integer   no-undo .
       91   define  shared variable conn-par             as character no-undo .
       92   define  shared variable g#auto-user-id       as character no-undo .
       93   define  shared variable g#auto-user-login    as character no-undo .
       94   define  shared variable g#auto-user-password as character no-undo .
       95   define  shared variable v-socket             as logical   no-undo .
       96   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97   define  shared variable auto-window-h     as handle    no-undo .
