     5456   procedure fill-g-list :
     5457   define input parameter p-gds-code as integer no-undo .
     5458   define input parameter p-obj-type as character no-undo .
     5459   define input parameter p-obj-code as integer no-undo .
     5460   define buffer buf_goods for ub.goods.
     5461   do
     5462   on error undo, return error
     5463   :
     5464     find first gds-list where
     5465               gds-list.gds-code = p-gds-code no-error .
     5466     if not avail gds-list then do:
     5467       if p-obj-type = 'маг':U then do:
     5468         find first gdsolist where
     5469                   gdsolist.gds-code = p-gds-code
     5470             AND  gdsolist.obj-type = p-obj-type
     5471             AND  gdsolist.obj-code = p-obj-code   no-error .
     5472       end.
     5473       else do:
     5474         find first buf_goods no-lock where
     5475                     buf_goods.gds-code = p-gds-code no-error .
     5476         create gds-list.
     5477         buffer-copy buf_goods to gds-list.
     5478       end.
     5479     end.
     5480     if p-obj-type = 'маг':U and not avail gdsolist then do:
     5481       find first gdsolist where
     5482                 gdsolist.gds-code = p-gds-code
     5483           AND  gdsolist.obj-type = p-obj-type
     5484           AND  gdsolist.obj-code = p-obj-code   no-error .
     5485       if not available gdsolist then do:
     5486         find first buf_goods no-lock where
     5487                     buf_goods.gds-code = p-gds-code no-error .
     5488         if avail buf_goods then do:
     5489           create gdsolist.
     5490           buffer-copy buf_goods to gdsolist
     5491           assign
     5492           gdsolist.obj-type = p-obj-type
     5493           gdsolist.obj-code = p-obj-code
     5494           .
     5495         end.
     5496       end.
     5497     end.
     5498     if avail gdsolist then do:
     5499       assign
     5500       gdsolist.to-del = no
     5501       .
     5502       release gdsolist.
     5503     end.
     5504     if avail gds-list then do:
     5505       assign
     5506       gds-list.to-del = no
     5507       .
     5508       release gds-list.
     5509     end.
     5510   end.
     5511   end procedure.
     5512   procedure fill-cash-txn :
     5513   define parameter buffer buf_tax for ub.tax.
     5514   do
     5515   on error undo, return error
     5516   :
     5517     if not can-find( cash-txn where
     5518                     cash-txn.tax-code = buf_tax.tax-code
     5519                 and cash-txn.tax-name = buf_tax.tax-name
     5520                    ) then do:
     5521       create cash-txn.
     5522       assign
     5523       cash-txn.tax-code = buf_tax.tax-code
     5524       cash-txn.tax-name = buf_tax.tax-name
     5525       .
     5526       release cash-txn.
     5527     end.
     5528   end.
     5529   end procedure.
     5530   procedure fill-cash-txr :
     5531   define input parameter p-tax-code as integer no-undo .
     5532   define input parameter p-rate-code as integer no-undo .
     5533   define input parameter p-status_ as character no-undo .
     5534   define input parameter p-host-code as integer no-undo .
     5535   define input parameter p-obj-type as character no-undo .
     5536   define input parameter p-obj-code as integer no-undo .
     5537   define input parameter p-tax-type as character no-undo .
     5538   define input parameter p-value as decimal no-undo .
     5539   define input parameter p-crf as integer no-undo .
     5540   define input parameter p-rec as recid no-undo .
     5541   define buffer buf_tax for ub.tax.
     5542   do
     5543   on error undo, return error
     5544   :
     5545     find first cash-txr where
     5546             cash-txr.tax-code = p-tax-code
     5547         AND cash-txr.host-code = p-host-code
     5548         AND cash-txr.rate-code = p-rate-code
     5549         AND cash-txr.obj-type = p-obj-type
     5550         AND cash-txr.obj-code = p-obj-code
     5551         AND cash-txr.rc = p-rec no-error .
     5552     if not avail cash-txr then do:
     5553       find first  cash-txn where
     5554                       cash-txn.tax-code = p-tax-code no-error .
     5555       if not available cash-txn then do:
     5556         find first buf_tax no-lock where buf_tax.tax-code = p-tax-code.
     5557         create cash-txn.
     5558         assign
     5559         cash-txn.tax-code = buf_tax.tax-code
     5560         cash-txn.tax-name = buf_tax.tax-name
     5561         .
     5562         release cash-txn.
     5563         define variable II as integer no-undo.
     5564         find last  cash-txr where cash-txr.crf > 0 no-error.
     5565         if available cash-txr
     5566         then
     5567            II = cash-txr.crf + 1.
     5568         else
     5569            II = 1.
     5570            _tax-rate:
     5571         FOR EACH ub.tax-rate NO-LOCK WHERE
     5572                             ub.tax-rate.tax-code = buf_tax.tax-code
     5573                         and ub.tax-rate.status_  <>   'удал':U:
     5574                           create cash-txr.
     5575                           assign
     5576                           cash-txr.tax-code = tax-rate.tax-code
     5577                           cash-txr.rate-code = tax-rate.rate-code
     5578                           cash-txr.tax-type = buf_tax.tax-type
     5579                           cash-txr.host-code = p-host-code
     5580                           cash-txr.obj-type = p-obj-type
     5581                           cash-txr.obj-code = p-obj-code
     5582                           cash-txr.status_ = tax-rate.status_
     5583                           cash-txr.rc = RECID(tax-rate)
     5584                           cash-txr.crf = ii
     5585                           ii = ii + 1
     5586                           .
     5587   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5588   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     5589     (input  recid(ub.tax-rate)
     5590     ,input  0
     5591     ,input  0
     5592     ,input  ?
     5593     ,input  p-host-code
     5594     ,input  p-obj-type
     5595     ,input  p-obj-code
     5596     ,output cash-txr.rate-value
     5597     ) no-error .
     5598                           if error-status:error then next _tax-rate.
     5599          END.
     5600       end.
     5601       else do:
     5602          for each cash-txr where cash-txr.tax-code = tax-rate.tax-code:
     5603             delete cash-txr.
     5604          end.
     5605          _tax-rate2:
     5606           FOR EACH ub.tax-rate NO-LOCK WHERE
     5607                             ub.tax-rate.tax-code = buf_tax.tax-code
     5608                         and ub.tax-rate.status_  <>   'удал':U:
     5609                           create cash-txr.
     5610                           assign
     5611                           cash-txr.tax-code = tax-rate.tax-code
     5612                           cash-txr.rate-code = tax-rate.rate-code
     5613                           cash-txr.tax-type = buf_tax.tax-type
     5614                           cash-txr.host-code = p-host-code
     5615                           cash-txr.obj-type = p-obj-type
     5616                           cash-txr.obj-code = p-obj-code
     5617                           cash-txr.status_ = tax-rate.status_
     5618                           cash-txr.rc = RECID(tax-rate)
     5619                           cash-txr.crf = ii
     5620                           ii = ii + 1
     5621                           .
     5622   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5623   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     5624     (input  recid(ub.tax-rate)
     5625     ,input  0
     5626     ,input  0
     5627     ,input  ?
     5628     ,input  p-host-code
     5629     ,input  p-obj-type
     5630     ,input  p-obj-code
     5631     ,output cash-txr.rate-value
     5632     ) no-error .
     5633                           if error-status:error then next _tax-rate2.
     5634          END.
     5635       end.
     5636       find first cash-txr where
     5637             cash-txr.tax-code = p-tax-code
     5638         AND cash-txr.rate-code = p-rate-code
     5639         no-error .
     5640       if not avail cash-txr and  p-status_ <> 'удал':U
     5641       then do:
     5642          create cash-txr.
     5643          assign
     5644          cash-txr.tax-code  = p-tax-code
     5645          cash-txr.rate-code = p-rate-code
     5646          cash-txr.host-code = p-host-code
     5647          cash-txr.obj-type  = p-obj-type
     5648          cash-txr.obj-code  = p-obj-code
     5649          cash-txr.tax-type  = p-tax-type
     5650          cash-txr.crf       = p-crf
     5651          cash-txr.rc        = p-rec
     5652          cash-txr.status_   = (if p-status_ = ? then 'тек':U else p-status_)
     5653          .
     5654       end.
     5655       if  avail cash-txr
     5656       then do:
     5657          if p-status_ eq 'удал':U
     5658          then
     5659             delete cash-txr.
     5660          else assign
     5661          cash-txr.tax-code  = p-tax-code
     5662          cash-txr.rate-code = p-rate-code
     5663          cash-txr.host-code = p-host-code
     5664          cash-txr.obj-type  = p-obj-type
     5665          cash-txr.obj-code  = p-obj-code
     5666          cash-txr.tax-type  = p-tax-type
     5667          cash-txr.crf       = p-crf
     5668          cash-txr.rc        = p-rec
     5669          cash-txr.status_   = (if p-status_ = ? then 'тек':U else p-status_)
     5670          .
     5671       end.
     5672       release cash-txr.
     5673     end.
     5674   end.
     5675   end procedure.
     5676   procedure fill-stpl-list :
     5677   define parameter buffer buf_stop-list for ub.stop-list.
     5678   do
     5679   on error undo, return error
     5680   :
     5681     find first stpl-list where
     5682               stpl-list.classif-type =  buf_stop-list.classif-type
     5683           and stpl-list.stop-list-code = buf_stop-list.stop-list-code no-error .
     5684     if not avail stpl-list then do:
     5685       create stpl-list.
     5686       buffer-copy buf_stop-list
     5687       to stpl-list.
     5688       release stpl-list.
     5689     end.
     5690   end.
     5691   end procedure.
     5692   procedure fill-pbc-list :
     5693   define input parameter p-rc as recid no-undo .
     5694   define input parameter p-gds-code as integer no-undo .
     5695   define input parameter p-b-code as integer no-undo .
     5696   define input parameter p-b-str as character no-undo .
     5697   define input parameter p-bc-on as logical no-undo .
     5698   define input parameter p-del as logical no-undo .
     5699   do
     5700   on error undo, return error
     5701   :
     5702     if p-bc-on = false
     5703     or p-del = yes
     5704     or not can-find(gds-list where gds-list.gds-code     = p-gds-code
     5705                               no-lock ) then do:
     5706       find first pbc-list where pbc-list.rc = p-rc no-error.
     5707       if not available pbc-list then do:
     5708         create pbc-list.
     5709       end.
     5710       assign
     5711       pbc-list.b-code = p-b-code
     5712       pbc-list.b-str = p-b-str
     5713       pbc-list.rc = p-rc
     5714       pbc-list.bc-on = p-bc-on
     5715       pbc-list.del = p-del
     5716       .
     5717       release pbc-list .
     5718     end.
     5719   end.
     5720   end procedure.
     5721   procedure fill-bar-code :
     5722   define input parameter p-b-code as integer no-undo .
     5723   define input parameter p-gds-code as integer no-undo .
     5724   define input parameter p-del as logical no-undo .
     5725   define input parameter p-node-code as integer no-undo .
     5726   define input parameter p-in-code as character no-undo .
     5727   define input parameter p-part-code as character no-undo .
     5728   define input parameter p-cli-base-rate as decimal no-undo .
     5729   define input parameter p-unit-cli as character no-undo .
     5730   do
     5731   on error undo, return error
     5732   :
     5733     if p-del = yes
     5734     or not can-find(gds-list where gds-list.gds-code     = p-gds-code
     5735                               no-lock ) then do:
     5736       find first bc-list where
     5737               bc-list.b-code = p-b-code and bc-list.del = p-del no-error.
     5738       if not avail bc-list then do:
     5739         create bc-list.
     5740         assign
     5741         bc-list.gds-code = p-gds-code
     5742         bc-list.b-code = p-b-code
     5743         bc-list.node-code = p-node-code
     5744         bc-list.in-code = p-in-code
     5745         bc-list.part-code = p-part-code
     5746         bc-list.cli-base-rate = p-cli-base-rate
     5747         bc-list.unit-cli = p-unit-cli
     5748         bc-list.del = p-del
     5749         .
     5750       end.
     5751     end.
     5752   end.
     5753   end procedure.
     5754   procedure fill-pdf :
     5755   define input parameter p-plt-id as integer no-undo .
     5756   define input parameter p-plt-db-num as integer no-undo .
     5757   define input parameter p-pdf-id as integer no-undo .
     5758   define input parameter p-pdf-db-num as integer no-undo .
     5759   define input parameter p-del as logical no-undo .
     5760   define buffer buf_pdf-list for pdf-list.
     5761   do
     5762   on error undo, return error
     5763   :
     5764     find first pdf-list where
     5765              pdf-list.plt-id = p-plt-id
     5766          and pdf-list.plt-db-num = p-plt-db-num
     5767          and pdf-list.pdf-id = p-pdf-id
     5768          and pdf-list.pdf-db = p-pdf-db-num no-error.
     5769     if not available pdf-list then do:
     5770       find last buf_pdf-list use-index oi no-error.
     5771       create pdf-list.
     5772       assign
     5773       pdf-list.plt-id = p-plt-id
     5774       pdf-list.plt-db-num = p-plt-db-num
     5775       pdf-list.pdf-id = p-pdf-id
     5776       pdf-list.pdf-db = p-pdf-db-num
     5777       pdf-list.to-del = p-del
     5778       pdf-list.order-num = (if available buf_pdf-list then buf_pdf-list.order-num + 1 else 1)
     5779       .
     5780       release pdf-list.
     5781     end.
     5782   end.
     5783   end procedure.
     5784   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5785   define variable v_dataseth as handle no-undo .
     5786   define variable glog as logical no-undo .
     5787   define variable v-ok as logical no-undo .
     5788   define variable v-xmlh as handle no-undo .
     5789   define variable v-headerh as handle no-undo .
     5790   define variable v-header-th as handle no-undo .
     5791   define variable v-pckrcvd as handle no-undo .
     5792   define variable v-pcksent as handle no-undo .
     5793   define variable v-currpcksent as handle no-undo .
     5794   define variable v-schema-name as character no-undo .
     5795   define variable v-esys-id as integer no-undo .
     5796   define variable v-schema-tmp-file as character no-undo .
     5797   define variable v-gate-rec as character no-undo .
     5798   define variable v-part-num as integer no-undo init 1.
     5799   define variable v-clob-db-num as integer no-undo .
     5800   define variable v-int64-id as int64 no-undo .
     5801   define variable v-prev-crc as character no-undo .
     5802   define variable v-import-prev-crc as character no-undo .
     5803   define variable v-pck-num                 as integer                  no-undo .
     5804   define variable v-header-obj-type as character no-undo .
     5805   define variable v-header-obj-code as integer no-undo .
     5806   define variable v-rec-cnt     as integer   no-undo.
     5807   define variable v-task as integer no-undo .
     5808   define variable v-task-ok as integer no-undo .
     5809   define variable v-header-schema-name as character no-undo .
     5810   define variable v-header-name as character no-undo .
     5811   define variable v-header-rec as character no-undo .
     5812   define variable v-process as character no-undo .
     5813   define variable v-insert-header as logical   no-undo .
     5814   define variable v-my-message as character no-undo .
     5815   define buffer buf_temp-xml-tables for temp-xml-tables.
     5816   define buffer buf_temp-esys-pck-rcvd for THpck-rcvd.
     5817   define buffer buf_temp-esys-pck-sent for THpck-sent.
     5818   define buffer curr_temp-esys-pck-sent for THcurr-pack.
     5819   define buffer buf_clob-data for ub.clob-data.
     5820   define buffer buf_ext-system for ub.ext-system.
     5821   define buffer buf_temp-param-name for temp-param-name.
     5822   define buffer buf_rule-profile for ub.rule-profile.
     5823   define buffer buf_esys-pck-keys for ub.esys-pck-keys.
     5824   define buffer buf_esys-pck-rcvd for ub.esys-pck-rcvd.
     5825   define buffer buf_esys-pck-sent for ub.esys-pck-sent.
     5826   define buffer buf_temp_xmllib_rec for temp_xmllib_rec.
     5827   define buffer buf_temp_xmllib_rec-fld for temp_xmllib_rec-fld.
     5828   define frame imp-pck
     5829   p-esys-id        label "ВС" skip
     5830   v-pck-num       label "Пакет" format ">>>>>>>>>9" skip
     5831   p-xml-file-name label "Файл пакета" format "x(50)" skip
     5832   v-rec-cnt       label "Основных записей" format ">>>>>>>>>9" skip
     5833   with view-as dialog-box side-labels 1 columns three-d title "** Разбор пакета"
     5834   .
     5835   main-block:
     5836   do
     5837   on error undo, return error return-value
     5838   :
     5839     find first buf_ext-system no-lock where
     5840               buf_ext-system.esys-id = p-esys-id
     5841          and buf_ext-system.db-num = p-db-num
     5842               no-error.
     5843     if not available buf_ext-system then do:
     5844     end.
     5845     assign
     5846     v-xmlh = buffer buf_temp-xml-tables:handle
     5847     v-pckrcvd = buffer buf_temp-esys-pck-rcvd:handle
     5848     v-pcksent = buffer buf_temp-esys-pck-sent:handle
     5849     v-currpcksent = buffer curr_temp-esys-pck-sent:handle
     5850     .
     5851     for each buf_temp-esys-pck-rcvd:
     5852       delete buf_temp-esys-pck-rcvd.
     5853     end.
     5854     for each buf_temp-esys-pck-sent:
     5855       delete buf_temp-esys-pck-sent.
     5856     end.
     5857     for each curr_temp-esys-pck-sent:
     5858       delete curr_temp-esys-pck-sent.
     5859     end.
     5860     case buf_ext-system.delivery-method:
     5861       when integer('3':U) then do:
     5862         assign
     5863         v-header-schema-name = "exe/header_.xsd"
     5864         v-header-name = "header_".
     5865       end.
     5866       when integer('5':U) then do:
     5867         assign
     5868         v-header-schema-name = ""
     5869         v-header-name = "".
     5870       end.
     5871       when integer('9':U) then do:
     5872         assign
     5873         v-header-schema-name = ""
     5874         v-header-name = "".
     5875       end.
     5876       when integer('11':U) then do:
     5877         assign
     5878         v-header-schema-name = ""
     5879         v-header-name = "".
     5880       end.
     5881       otherwise do:
     5882         assign
     5883         v-header-schema-name = "exe/THheader.xsd"
     5884         v-header-name = "THheader".
     5885       end.
     5886     end case.
     5887     if v-header-name <> '' then do:
     5888     run get-gate-rec in this-procedure ( input v-header-schema-name
     5889                                         ,output v-header-rec) no-error.
     5890     if error-status:error then do:
     5891       undo, return error substitute("Не найдено описание xsd-схемы &1 в БД", v-header-schema-name).
     5892     end.
     5893     run get-header-by-rec in this-procedure ( input v-header-rec
     5894                                               ,output v-header-th
     5895                                               ) no-error.
     5896     if error-status:error then do:
     5897       v-my-message = substitute("Ошибка при создании структуры заголовка пакета согласно гейту:&1&2&3&2&4"
     5898                                  , v-header-rec
     5899                                  , chr(10)
     5900                                  , error-status:get-message(1)
     5901                                  , return-value  ) .
     5902       delete object v-header-th no-error.
     5903       undo, return error v-my-message.
     5904     end.
     5905     v-headerh = v-header-th:default-buffer-handle.
     5906     end.
     5907     run  xmllib-set-log-handle in this-procedure (
     5908                                                    input p-log-handle
     5909                                                   ,input "write-to-log"
     5910                                                    ).
     5911     run getoxmlh in this-procedure ( input p-xml-file-name
     5912                                     ,input p-pack-data
     5913                                     ,input v-headerh
     5914                                     ,input buf_ext-system.delivery-method
     5915                                     ) no-error.
     5916   define buffer buf_rec for temp_xmllib_rec.
     5917   define buffer buf_rec-fld for temp_xmllib_rec-fld.
     5918     find first buf_esys-pck-rcvd no-lock
     5919       where buf_esys-pck-rcvd.esys-id = p-esys-id
     5920         and buf_esys-pck-rcvd.db-num   = p-db-num
     5921         and buf_esys-pck-rcvd.espr-cr-db-num   = p-cr-db-num
     5922         and buf_esys-pck-rcvd.espr-pack-num = p-pack-num - 1
     5923       no-error
     5924     .
     5925     if available buf_esys-pck-rcvd then do:
     5926       assign
     5927         v-prev-crc = buf_esys-pck-rcvd.espr-crc-pack
     5928       .
     5929     end.
     5930     else do:
     5931       assign
     5932         v-prev-crc = "":U
     5933       .
     5934     end.
     5935     case buf_ext-system.delivery-method:
     5936       when integer('5':U) then do:
     5937         find first buf_temp_xmllib_rec no-error.
     5938         if not available buf_temp_xmllib_rec
     5939         or lookup(buf_temp_xmllib_rec.recname, "ORDRSP_,DESADV_,STATUS__") = 0
     5940         then do:
     5941           v-my-message = substitute("Неверный тип пакета &1"
     5942                                       , p-pack-num
     5943         , (if available buf_temp_xmllib_rec then buf_temp_xmllib_rec.recname else '')
     5944                                     ) .
     5945           delete object v-header-th no-error.
     5946           return error v-my-message.
     5947         end.
     5948         v-schema-name = substitute("exe/&1.xsd",buf_temp_xmllib_rec.recname).
     5949       end.
     5950       when integer('9':U) then do:
     5951         v-schema-name = entry (1, p-file-name, "_").
     5952         if not can-find(first ub.clients
     5953                         where ub.clients.obj-type = v-header-obj-type
     5954                           and ub.clients.obj-code = v-header-obj-code
     5955                           and ub.clients.db-num   = ibs.th.gbl.gbl-var:g#db-num)
     5956         then do:
     5957           v-my-message = substitute("Адресат пакета &1 (&2&3) НЕИЗВЕСТЕН", p-pack-num, v-header-obj-type, v-header-obj-code) .
     5958           delete object v-header-th no-error.
     5959           return error v-my-message .
     5960         end.
     5961         v-pck-num = p-pack-num.
     5962       end.
     5963       when integer('11':U) then do:
     5964         v-pck-num = integer(entry(3, p-file-name, "_"))  no-error.
     5965         find first buf_temp_xmllib_rec where
     5966                 buf_temp_xmllib_rec.recLevel = 0 no-error.
     5967         if available (buf_temp_xmllib_rec)
     5968           then v-schema-name =   buf_temp_xmllib_rec.recName.
     5969       end.
     5970       when integer('3':U) then do:
     5971         v-esys-id = buf_ext-system.esys-id.
     5972         find first buf_temp_xmllib_rec
     5973              where buf_temp_xmllib_rec.recname = "Oracle_Retail" no-error.
     5974         if not available buf_temp_xmllib_rec then do:
     5975           v-my-message = substitute("Неверный тип пакета &1", p-pack-num, v-header-obj-code) .
     5976           delete object v-header-th no-error.
     5977           return error v-my-message.
     5978         end.
     5979         for first buf_temp_xmllib_rec
     5980             where buf_temp_xmllib_rec.recname = "header_",
     5981              each buf_temp_xmllib_rec-fld
     5982             where buf_temp_xmllib_rec-fld.rec-key = buf_temp_xmllib_rec.rec-key:
     5983           case buf_temp_xmllib_rec-fld.fldname:
     5984             when "obj-type" then do:
     5985               v-header-obj-type = buf_temp_xmllib_rec-fld.fldvalue.
     5986             end.
     5987             when "obj-code" then do:
     5988               assign
     5989               v-header-obj-code = 0
     5990               v-header-obj-code = integer(buf_temp_xmllib_rec-fld.fldvalue) no-error.
     5991             end.
     5992             when "xsd" then do:
     5993               v-schema-name = "exe/" + buf_temp_xmllib_rec-fld.fldvalue.
     5994             end.
     5995             when "date-from" then do:
     5996               run set-exch-date-time in p-parent-handle ( input buf_temp_xmllib_rec-fld.fldvalue) no-error .
     5997             end.
     5998           end case.
     5999         end.
     6000         if not can-find (first ub.clients
     6001                          where ub.clients.obj-type = v-header-obj-type
     6002                            and ub.clients.obj-code = v-header-obj-code
     6003                            and ub.clients.db-num   = ibs.th.gbl.gbl-var:g#db-num)
     6004         then do:
     6005           v-my-message = substitute("Адресат пакета &1 (&2&3) НЕИЗВЕСТЕН", p-pack-num, v-header-obj-type, v-header-obj-code) .
     6006           delete object v-header-th no-error.
     6007           return error v-my-message.
     6008         end.
     6009         v-pck-num = p-pack-num.
     6010       end.
     6011       otherwise do:
     6012     for first buf_temp_xmllib_rec where
     6013             buf_temp_xmllib_rec.recname = "THheader",
     6014           each buf_temp_xmllib_rec-fld where
     6015            buf_temp_xmllib_rec-fld.rec-key = buf_temp_xmllib_rec.rec-key:
     6016       case buf_temp_xmllib_rec-fld.fldname:
     6017          when "THfilename" then do:
     6018          end.
     6019          when "THschema-name" then do:
     6020            v-schema-name = buf_temp_xmllib_rec-fld.fldvalue.
     6021          end.
     6022          when "THimport-esys-id" then do:
     6023            v-esys-id = integer(buf_temp_xmllib_rec-fld.fldvalue) no-error .
     6024          end.
     6025          when "THpack-num" then do:
     6026             v-pck-num = integer(buf_temp_xmllib_rec-fld.fldvalue) no-error.
     6027          end.
     6028          when "THprev-crc" then do:
     6029             v-import-prev-crc = buf_temp_xmllib_rec-fld.fldvalue no-error.
     6030          end.
     6031       end case.
     6032     end.
     6033       end.
     6034     end case.
     6035     if buf_ext-system.delivery-method = integer('5':U)
     6036        or buf_ext-system.delivery-method = integer('9':U)
     6037     then do:
     6038       v-pck-num = p-pack-num.
     6039     end.
     6040     if v-pck-num <> p-pack-num
     6041     and not (buf_ext-system.delivery-method = integer('1':U))
     6042     then do:
     6043       v-my-message = substitute("Номер пакета &1 в заголовке файла &2&5 не совпадает с номером пакета &3 для вн.системы '&4'"
     6044                                    , v-pck-num
     6045                                    , p-xml-file-name
     6046                                    , p-pack-num
     6047                                    ,buf_ext-system.esys-name
     6048                                    , chr(10)) .
     6049       delete object v-header-th no-error.
     6050       return error v-my-message.
     6051     end.
     6052     if buf_ext-system.imp-conf-send > 0  then do:
     6053       if v-import-prev-crc <> v-prev-crc then do:
     6054         v-my-message = substitute("&1. Ошибка приема! Пакет &2 сформирован в некорректной ВС&3" +
     6055                                     "Ключ предыдущего пакета в файле (&4)&3не совпадает с ключом предыдущего пакета в БД (&5)"
     6056                                     , vss-workfile
     6057                                     , v-pck-num
     6058                                     , chr(10)
     6059                                     ,v-import-prev-crc
     6060                                     , v-prev-crc
     6061                                     ) .
     6062         delete object v-header-th no-error.
     6063         undo, return error v-my-message.
     6064       end.
     6065     end.
     6066     if buf_ext-system.delivery-method <> integer('5':U)
     6067       and buf_ext-system.delivery-method <> integer('9':U)
     6068       and buf_ext-system.delivery-method <> integer('11':U)
     6069     then do:
     6070       assign
     6071       v-pck-num = 0.
     6072     end.
     6073     find first buf_temp-param-name where
     6074               buf_temp-param-name.schema-name = v-schema-name
     6075          and  (buf_temp-param-name.esys-id = p-esys-id
     6076               or
     6077               buf_temp-param-name.esys-id = -1)
     6078          no-error.
     6079     if not available buf_temp-param-name then do:
     6080       v-my-message = substitute("Не настроена обработка данных по схеме &1 для вн.системы &2"
     6081                                    , v-schema-name
     6082                                    ,buf_ext-system.esys-name ) .
     6083       delete object v-header-th no-error.
     6084       return error v-my-message.
     6085     end.
     6086       if buf_ext-system.delivery-method <> integer('9':U)
     6087        and buf_ext-system.delivery-method <> integer('11':U) then do:
     6088         run get-gate-rec in this-procedure ( v-schema-name
     6089                                             ,output v-gate-rec) no-error.
     6090         if error-status:error then do:
     6091           undo, return error substitute("Не найдено описание xsd-схемы &1 в БД", v-schema-name).
     6092         end.
     6093         define variable v-longchar as longchar no-undo .
     6094         v-longchar = ''.
     6095         run get-gate-by-rec in this-procedure ( input v-gate-rec
     6096                                               ,output v_dataseth
     6097                                               ,input-output v-xmlh
     6098                                               ,input-output v-longchar
     6099                                               ) no-error.
     6100         if error-status:error then do:
     6101           v-my-message = substitute("Ошибка при создании структуры маршрутизируемых данных согласно гейту:&1&2&3&2&4"
     6102                                     , v-gate-rec
     6103                                     , chr(10)
     6104                                     , error-status:get-message(1)
     6105                                     , return-value ) .
     6106           delete object v-header-th no-error.
     6107           undo, return error v-my-message.
     6108         end.
     6109       end.
     6110       if v-header-name <> '' then do:
     6111     v-headerh = v-header-th:default-buffer-handle.
     6112     find first buf_temp-xml-tables where
     6113               buf_temp-xml-tables.tbl-name = v-headerh:table no-error.
     6114     if not available buf_temp-xml-tables then do:
     6115       v-insert-header = yes.
     6116     create buf_temp-xml-tables.
     6117     assign
     6118     buf_temp-xml-tables.tbl-name = v-headerh:table
     6119     buf_temp-xml-tables.tbl-handle_ = v-headerh
     6120     buf_temp-xml-tables.table-handle_ = v-headerh:table-handle
     6121     buf_temp-xml-tables.order = -3
     6122     buf_temp-xml-tables.gate-handle = v_dataseth
     6123     buf_temp-xml-tables.gate-name = v-schema-name
     6124     buf_temp-xml-tables.uniq-gate-rec = v-gate-rec
     6125     .
     6126    end.
     6127     else do:
     6128       delete object v-header-th.
     6129       v-headerh = buf_temp-xml-tables.table-handle_:default-buffer-handle.
     6130     end.
     6131     end.
     6132     if buf_ext-system.imp-conf-send > 0  then do:
     6133       create buf_temp-xml-tables.
     6134       assign
     6135       buf_temp-xml-tables.tbl-name = v-pckrcvd:table
     6136       buf_temp-xml-tables.tbl-handle_ = v-pckrcvd
     6137       buf_temp-xml-tables.table-handle_ = v-pckrcvd:table-handle
     6138       buf_temp-xml-tables.uniq-gate-rec = v-gate-rec
     6139       buf_temp-xml-tables.gate-name = v_dataseth:name
     6140       buf_temp-xml-tables.gate-handle_ = v_dataseth
     6141       buf_temp-xml-tables.order = -2
     6142       .
     6143       create buf_temp-xml-tables.
     6144       assign
     6145       buf_temp-xml-tables.tbl-name = v-pcksent:table
     6146       buf_temp-xml-tables.tbl-handle_ = v-pcksent
     6147       buf_temp-xml-tables.table-handle_ = v-pcksent:table-handle
     6148       buf_temp-xml-tables.uniq-gate-rec = v-gate-rec
     6149       buf_temp-xml-tables.gate-name = v_dataseth:name
     6150       buf_temp-xml-tables.gate-handle_ = v_dataseth
     6151       buf_temp-xml-tables.order = -1
     6152       .
     6153       create buf_temp-xml-tables.
     6154       assign
     6155       buf_temp-xml-tables.tbl-name = v-currpcksent:table
     6156       buf_temp-xml-tables.tbl-handle_ = v-currpcksent
     6157       buf_temp-xml-tables.table-handle_ = v-currpcksent:table-handle
     6158       buf_temp-xml-tables.uniq-gate-rec = v-gate-rec
     6159       buf_temp-xml-tables.gate-name = v_dataseth:name
     6160       buf_temp-xml-tables.gate-handle_ = v_dataseth
     6161       buf_temp-xml-tables.order = v_dataseth:num-buffers + 1
     6162       .
     6163     end.
     6164     if v-insert-header = yes then do:
     6165     run tmpreldf_get-relations in this-procedure ( input v_dataseth).
     6166     for each buf_temp-xml-tables
     6167     break
     6168     by buf_temp-xml-tables.order
     6169     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     6170     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     6171     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     6172     :
     6173      if first(buf_temp-xml-tables.order) then do:
     6174        glog = v_dataseth:set-buffers ( buf_temp-xml-tables.tbl-handle_) no-error.
     6175      end.
     6176      else do:
     6177        glog = v_dataseth:add-buffer ( buf_temp-xml-tables.tbl-handle_) no-error.
     6178      end.
     6179      if error-status:error
     6180      or not glog
     6181      then do:
     6182         v-my-message = substitute("Ошибка при создании заголовка XML файла:&1&2", chr(10), error-status:get-message(1) ) .
     6183         run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     6184         undo, return error v-my-message.
     6185       end.
     6186     end.
     6187     run tmpreldf_set-relations in this-procedure ( input v_dataseth, input v_dataseth).
     6188       run gbl/_tmpfile.p (
     6189                         input ""
     6190                       , input "xml"
     6191                       , output v-schema-tmp-file) .
     6192     assign
     6193     glog = v_dataseth:WRITE-XMLSCHEMA( "FILE"
     6194                                      , v-schema-tmp-file
     6195                                      , yes
     6196                                      , ?
     6197                                       , no
     6198                                      ) no-error .
     6199     if error-status :error then do:
     6200           v-my-message = substitute("Ошибка при создании временного файла xsd со схемой &1:&2&3"
     6201                                       , v_dataseth:name
     6202                                       , chr(10)
     6203                                       , error-status:get-message(1) ) .
     6204       run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     6205       undo, return error v-my-message.
     6206     end.
     6207     end.
     6208     else do:
     6209       if buf_ext-system.delivery-method <> integer('9':U)
     6210        and buf_ext-system.delivery-method <> integer('11':U)then do:
     6211           run gbl/_tmpfile.p (
     6212                               input ""
     6213                             , input "xml"
     6214                             , output v-schema-tmp-file) .
     6215           COPY-LOB
     6216           FROM  OBJECT v-longchar
     6217           TO  FILE v-schema-tmp-file
     6218           no-convert
     6219           NO-ERROR .
     6220           v-longchar = ''.
     6221           if error-status :error then do:
     6222               v-my-message = substitute("Ошибка при создании временного файла xsd со схемой &1:&2&3"
     6223                                           , v_dataseth:name
     6224                                           , chr(10)
     6225                                           , error-status:get-message(1) ) .
     6226             run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     6227             undo, return error v-my-message.
     6228           end.
     6229         end.
     6230       end.
     6231       if buf_ext-system.delivery-method <> integer('9':U)
     6232        and buf_ext-system.delivery-method <> integer('11':U) then do:
     6233         assign
     6234         v-rec-cnt = 0
     6235         .
     6236         ASSIGN
     6237         glog = v_dataseth:read-xml( "file"
     6238                                   ,p-xml-file-name
     6239                                   ,"merge"
     6240                                   ,v-schema-tmp-file
     6241                                   ,?
     6242                                   ,?
     6243                                   ,"strict"
     6244                                   ) no-error .
     6245         if error-status:error
     6246         then do:
     6247           v-my-message = substitute("Ошибка при чтении XML файла &1 данными через гейт &2:&3&4"
     6248                                           , p-xml-file-name
     6249                                           , v_dataseth:name
     6250                                           , chr(10)
     6251                                           , error-status:get-message(1)) .
     6252           run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     6253           if buf_ext-system.delivery-method = integer('3':U) then do:
     6254             run set-err-type in p-parent-handle ( input 'STRUCTURE') no-error.
     6255           end.
     6256           undo, return error v-my-message.
     6257         end.
     6258          if not glog then do:
     6259             v-my-message = substitute("Не прошел верификацию с помощью схемы &1 XML файл &2:&3&4&3&5"
     6260                                           , v_dataseth:name
     6261                                           , p-xml-file-name
     6262                                           , chr(10)
     6263                                           , error-status:get-message(1)
     6264                                           , error-status:get-message(2) ) .
     6265           run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     6266           os-delete value(v-schema-tmp-file).
     6267           if buf_ext-system.delivery-method = integer('3':U) then do:
     6268             run set-err-type in p-parent-handle ( input 'STRUCTURE') no-error.
     6269           end.
     6270           undo, return error v-my-message.
     6271         end.
     6272       end.
     6273     if buf_ext-system.delivery-method <>  integer('5':U)
     6274       and buf_ext-system.delivery-method <>  integer('9':U)
     6275       and buf_ext-system.delivery-method <>  integer('11':U)
     6276     then do:
     6277     case buf_ext-system.delivery-method:
     6278       when integer('3':U) then do:
     6279         find first buf_temp-xml-tables where
     6280                   buf_temp-xml-tables.tbl-name = v-header-name
     6281               and buf_temp-xml-tables.gate-handle_ = v_dataseth
     6282                   no-error.
     6283       end.
     6284       otherwise do:
     6285     find first buf_temp-xml-tables where
     6286                   buf_temp-xml-tables.tbl-name = v-header-name
     6287           and buf_temp-xml-tables.gate-handle_ = v_dataseth
     6288               no-error.
     6289       end.
     6290     end case.
     6291     if not available buf_temp-xml-tables then do:
     6292        v-my-message = substitute("Не найден THHEADER или Header_ в XML файлe &1:&2&3"
     6293                                       , p-xml-file-name
     6294                                       , chr(10)
     6295                                       , error-status:get-message(1)) .
     6296       run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     6297       os-delete value(v-schema-tmp-file).
     6298       undo, return error v-my-message.
     6299     end.
     6300     glog = buf_temp-xml-tables.tbl-handle_:find-first( "where true") no-error.
     6301     if error-status:error
     6302     or not glog
     6303     or buf_temp-xml-tables.tbl-handle_:available = no then do:
     6304        v-my-message = substitute("Не найдена запись THHEADER или Header_ в XML файлe &1:&2&3"
     6305                                       , p-xml-file-name
     6306                                       , chr(10)
     6307                                       , error-status:get-message(1)) .
     6308       run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     6309       os-delete value(v-schema-tmp-file).
     6310       undo, return error v-my-message.
     6311     end.
     6312     else do:
     6313       case buf_ext-system.delivery-method:
     6314         when integer('1':U) then do:
     6315         v-pck-num = p-pack-num.
     6316         buf_temp-xml-tables.tbl-handle_:buffer-field("THpack-num"):buffer-value = p-pack-num.
     6317           buf_temp-xml-tables.tbl-handle_:buffer-field("THimport-esys-id"):buffer-value = p-esys-id.
     6318         END.
     6319         when integer('3':U) then do:
     6320           v-pck-num = p-pack-num.
     6321         end.
     6322         otherwise do:
     6323           v-pck-num = buf_temp-xml-tables.tbl-handle_:buffer-field("THpack-num"):buffer-value.
     6324           buf_temp-xml-tables.tbl-handle_:buffer-field("THimport-esys-id"):buffer-value = p-esys-id.
     6325         end.
     6326       end.
     6327     end.
     6328     end.
     6329     if buf_ext-system.imp-conf-send > 0
     6330     or buf_ext-system.delivery-method = integer('5':U)
     6331     then do:
     6332       run get-xcnf_get-xcnf in this-procedure (
     6333                                         input p-esys-id
     6334                                        ,input p-db-num
     6335                                        ,input g#db-num
     6336                                        ,input p-pack-num
     6337                                        ,input buf_ext-system.delivery-method
     6338                                        ,buffer buf_temp-esys-pck-sent
     6339                                        ,buffer buf_temp-esys-pck-rcvd
     6340                                        ,buffer curr_temp-esys-pck-sent
     6341                                        ,output v-rec-cnt
     6342                                      ) no-error.
     6343       if error-status :error then do:
     6344        v-my-message = substitute("Ошибка при принятии подтверждений из ВС:&1&2&1&3"
     6345                                    , chr(10)
     6346                                    , error-status:get-message(1)
     6347                                    , return-value ) .
     6348        run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     6349        os-delete value(v-schema-tmp-file).
     6350        undo, return error v-my-message.
     6351       end.
     6352     end.
     6353     assign
     6354     v-rec-cnt = v-rec-cnt + 1
     6355     .
     6356     if buf_ext-system.delivery-method <> integer('9':U)
     6357      and buf_ext-system.delivery-method <> integer('11':U) then do:
     6358       os-delete value(v-schema-tmp-file).
     6359     end.
     6360       _rule-profile:
     6361     for each buf_temp-param-name WHERE
     6362            (buf_temp-param-name.esys-id = p-esys-id
     6363            or
     6364            buf_temp-param-name.esys-id = -1)
     6365         and buf_temp-param-name.schema-name = v-schema-name
     6366     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     6367     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     6368     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     6369     :
     6370       v-task = v-task + 1.
     6371       find first buf_esys-pck-keys no-lock where
