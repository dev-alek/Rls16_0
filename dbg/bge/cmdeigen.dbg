       99   define  shared variable hand-log-msg-h    as handle    no-undo .
      100   define  shared variable log-file-name     as character no-undo initial ? .
      101   define  shared variable add-log-file-name as character no-undo initial ? .
      102   define  shared variable writelogvalue     as character no-undo initial ? .
      103   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      104   procedure cur-time :
      105      define output parameter p-today as date      no-undo .
      106      define output parameter p-time  as integer   no-undo .
      107     do
      108     on error undo, return error
      109     :
      110       define variable v-date1 as date      no-undo .
      111       define variable v-date2 as date      no-undo .
      112       define variable v-time  as integer   no-undo .
      113       assign
      114         v-date1 = today
      115         v-time  = time
      116         v-date2 = today
      117       .
      118       if v-date1 <> v-date2
      119       then do:
      120         assign
      121           v-date1 = today
      122           v-time  = v-time
      123         .
      124       end.
      125       assign
      126         p-today = v-date1
      127         p-time  = v-time
      128       .
      129     end.
      130   end.
      131   function cur-time-date returns character
      132   :
      133     return string(today, '99/99/9999':U) .
      134   end.
      135   function cur-time-mjd returns decimal
      136   :
      137     define variable v-date as date      no-undo .
      138     define variable v-time as integer   no-undo .
      139     run cur-time in this-procedure
      140       (output v-date
      141       ,output v-time
      142       ) .
      143     return integer(v-date) - 2400002 + (v-time / 86400) .
      144   end.
      145   function cur-time-get-ending-index returns integer
      146   (input p-number as integer
      147   )
      148   :
      149     if p-number < 0
      150     or p-number = ?
      151     then do:
      152       return 1 .
      153     end.
      154     define variable v-rest as integer   no-undo .
      155     assign
      156       p-number = p-number modulo 100
      157     .
      158     if p-number < 20
      159     then do:
      160       assign
      161         v-rest = p-number
      162       .
      163     end.
      164     else do:
      165       assign
      166         v-rest = p-number modulo 10
      167       .
      168     end.
      169     case v-rest :
      170       when 1
      171       then do:
      172         return 2 .
      173       end.
      174       when 2 or
      175       when 3 or
      176       when 4
      177       then do:
      178         return 3 .
      179       end.
      180       otherwise do:
      181         return 1 .
      182       end.
      183     end case .
      184   end.
      185   procedure cur-time-mjd-to-date :
      186      define input  parameter i-mjd-diff as decimal no-undo.
      187      define output parameter o-Date     as date    no-undo.
      188      define output parameter o-Time     as integer no-undo.
      189      define variable v-day-number as integer   no-undo .
      190      if    i-mjd-diff < 0
      191         or i-mjd-diff = ?
      192      then do:
      193         return "?" .
      194      end.
      195      assign
      196         v-day-number = truncate(i-mjd-diff,0).
      197         o-Date = date(v-day-number + 2400002).
      198         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200   end.
      201   function cur-time-mjd-to-string returns character
      202   (input p-mjd-diff as decimal
      203   )
      204   :
      205     define variable v-day-number as integer   no-undo .
      206     define variable v-seconds    as integer   no-undo .
      207     define variable v-hour       as integer   no-undo .
      208     define variable v-min        as integer   no-undo .
      209     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      210     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      211     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      212     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      213     if p-mjd-diff < 0
      214     or p-mjd-diff = ?
      215     then do:
      216       return "?" .
      217     end.
      218     assign
      219       v-day-number = integer(truncate(p-mjd-diff,0))
      220       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      221     .
      222     if v-seconds > 86400
      223     then do:
      224       assign
      225         v-seconds = 86400 - 1
      226       .
      227     end.
      228     if v-seconds < 0
      229     then do:
      230       assign
      231         v-seconds = 0
      232       .
      233     end.
      234     assign
      235       v-hour = truncate(v-seconds / 3600, 0)
      236     .
      237     assign
      238       v-seconds = v-seconds modulo 3600
      239     .
      240     assign
      241       v-min = truncate(v-seconds / 60, 0)
      242     .
      243     assign
      244       v-seconds = v-seconds modulo 60
      245     .
      246     return
      247         (if v-day-number <> 0
      248           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      249           else ""
      250         )
      251       + (if v-day-number <> 0 or v-hour <> 0
      252           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      253           else ""
      254         )
      255       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      256           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      257           else ""
      258         )
      259       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      260       .
      261   end.
      262   function cur-time-string returns character
      263   :
      264     define variable v-date as date      no-undo .
      265     define variable v-time as integer   no-undo .
      266     run cur-time in this-procedure
      267       (output v-date
      268       ,output v-time
      269       ) .
      270     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      271   end.
      272   function cur-time-string-sec returns character
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      281   end.
      282   function cur-time-custom  returns character
      283   (input p-prefix as character
      284   ,input p-date-format as character
      285   ,input p-delimiter as character
      286   ,input p-time-format as character
      287   ,input p-suffix as character
      288   )
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return
      297       p-prefix
      298       + string(v-date, p-date-format)
      299       + p-delimiter
      300       + string(v-time, p-time-format)
      301       + p-suffix
      302       .
      303   end.
      304   function cur-time-print  returns character
      305   :
      306     define variable v-date as date      no-undo .
      307     define variable v-time as integer   no-undo .
      308     run cur-time in this-procedure
      309       (output v-date
      310       ,output v-time
      311       ) .
      312     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      313   end.
      314   function cur-time-datetime returns datetime
      315   :
      316     define variable v-char as character no-undo .
      317     define variable v-datetime as datetime no-undo .
      318     v-char = cur-time-string().
      319     v-datetime = datetime(v-char).
      320     return  v-datetime.
      321   end.
      322   function cur-time-string-msec returns character
      323   :
      324     define variable v-date as datetime  no-undo .
      325     v-date = now.
      326     return string(v-date) .
      327   end.
      328   define stream LogStream .
      329   define variable mNoTime as logical no-undo.
      330   procedure write-to-log-notime :
      331     define input param i-str as character no-undo .
      332     mNoTime = yes.
      333     run write-to-log (i-str).
      334     mNoTime = no.
      335   end.
      336   procedure write-to-log :
      337     define input param p-str as character no-undo .
      338     do
      339     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      340     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      341     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      342     :
      343       define variable log-res        as logical   no-undo .
      344       define variable v-jj           as integer   no-undo .
      345       if    mNoTime
      346          or writelogvalue eq "AsyncProc"
      347       then
      348          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      349       else
      350          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      351       if auto-log-msg-h <> ? then do:
      352         log-res = auto-log-msg-h:move-to-eof( ) .
      353         log-res = auto-log-msg-h:insert-string( p-str ).
      354       end.
      355       if hand-log-msg-h <> ? then do:
      356         log-res = hand-log-msg-h:move-to-eof( ) .
      357         log-res = hand-log-msg-h:insert-string( p-str ).
      358       end.
      359       assign
      360         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      361         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      362         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      363       .
      364       if add-log-file-name <> ? then do:
      365         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      366           run gbl/fileapnd.p
      367             ( input entry(v-jj, add-log-file-name, chr(1) )
      368             ,input p-str
      369             ,input 20
      370             ) no-error .
      371           if error-status:error then do:
      372             return error return-value .
      373           end.
      374         end.
      375       end.
      376       if writelogvalue eq "AsyncProc"
      377       then do:
      378          p-str = trim(p-str, (chr(13) + chr(10)) )
      379       .
      380          Publish "WriteLogAsunc" (p-str,yes).
      381       end.
      382       else if writelogvalue <> "yes" then do:
      383         run gbl/fileapnd.p
      384           ( input log-file-name
      385           ,input p-str
      386           ,input 20
      387           ) no-error .
      388         if error-status:error then do:
      389           return error return-value .
      390         end.
      391       end.
      392     end.
      393   end procedure.
      394   procedure write-to-screen :
      395     define input param p-str as character no-undo .
      396     do
      397     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      398     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      399     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      400     :
      401       define variable log-res as logical no-undo.
      402       assign
      403         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      404       .
      405       if auto-log-msg-h <> ?
      406       then do:
      407         log-res = auto-log-msg-h:move-to-eof( ) .
      408         log-res = auto-log-msg-h:insert-string( p-str ).
      409       end.
      410       if hand-log-msg-h <> ?
      411       then do:
      412         log-res = hand-log-msg-h:move-to-eof( ) .
      413         log-res = hand-log-msg-h:insert-string( p-str ).
      414       end.
      415     end.
      416   end procedure.
      417   procedure send-msg-to-email :
      418     define input  parameter p-subject      as character no-undo .
      419     define input  parameter p-text-err     as character no-undo .
      420     define input  parameter p-attach-files as character no-undo .
      421     do
      422     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      423     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      424     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      425     :
      426       define variable v-tth             as handle    no-undo .
      427       define variable v-value-character as character no-undo .
      428       define variable v-value-date      as date      no-undo .
      429       define variable v-value-decimal   as decimal   no-undo .
      430       define variable v-value-integer   as integer   no-undo .
      431       define variable v-value-logical   as logical   no-undo .
      432       define variable v-param-type      as character no-undo .
      433       define variable v-email       as character no-undo .
      434       define variable v-tmp-str     as character no-undo .
      435       define variable v-tmp1-str    as character no-undo .
      436       define variable v-ind         as integer   no-undo .
      437       define variable v-num-entries as integer   no-undo .
      438       delete object v-tth no-error.
      439       run adm/shattri.p
      440         ( input "get":U
      441          ,input  "":U
      442          ,input  0
      443          ,input  'auto-task':U
      444          ,input  'send-msg-to-email':U
      445          ,output v-value-character
      446          ,output v-value-date
      447          ,output v-value-decimal
      448          ,output v-value-integer
      449          ,output v-value-logical
      450          ,output v-param-type
      451          ,input-output table-handle v-tth
      452         ) no-error .
      453       if not error-status :error  then do:
      454         assign
      455           v-tmp-str = v-value-character
      456         .
      457       end.
      458       delete object v-tth no-error.
      459       assign
      460         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      461         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      462         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      463         v-num-entries = num-entries( v-tmp-str, chr(44) )
      464         v-email       = "":U
      465       .
      466       do v-ind = 1 to v-num-entries
      467       :
      468         assign
      469           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      470         .
      471         if trim( v-tmp1-str ) <> "":U then do:
      472           if v-email = "":U then do:
      473             assign
      474               v-email = v-tmp1-str
      475             .
      476           end.
      477           else do:
      478             assign
      479               v-email = v-email + chr(44) + v-tmp1-str
      480             .
      481           end.
      482         end.
      483       end.
      484       if v-email <> "":U then do:
      485         run gbl/sendmail.p
      486           ( input v-email
      487           , input p-subject
      488           , input p-text-err
      489           , input p-attach-files
      490           ) no-error .
      491         if error-status :error
      492           or return-value <> "":U
      493         then do:
      494           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      495         end.
      496       end.
      497     end.
      498   end procedure.
      499   define  shared variable oxml-exch-dir as character no-undo .
      500   define  shared variable oxml-heap-dir as character no-undo .
      501   define variable err-mess as character no-undo .
      502   define temp-table t-pck-conf no-undo
      503     field esys-id         as integer
      504     field db-num          as integer
      505     field current-db-num  as integer
      506     field pack-num        as integer
      507     field rcvd-recs       as integer
      508     field total-recs      as integer
      509     field sys-key         as character
      510     field src_db-key      as character
      511     field ver-num         as character
      512     field prev-crc        as character
      513     field actual-date     as date
      514     field actual-time-int as integer
      515   .
      516   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      517   procedure gen-key-rec :
      518     define input  parameter p-tbl-name    as character no-undo.
      519     define input  parameter p-bh_tbl-name as handle    no-undo.
      520     define output parameter p-key-rec     as character no-undo.
      521     do
      522     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      523     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      524     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      525     :
      526       define variable fh               as handle    no-undo .
      527       define variable v-ok             as logical   no-undo .
      528       define variable v-inform         as character no-undo .
      529       define variable v-ind            as integer   no-undo .
      530       define variable v-idx-field-qnty as integer   no-undo .
      531       if p-tbl-name = ?
      532         or p-tbl-name = "":U
      533       then do:
      534         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      535       end.
      536       if not p-bh_tbl-name:available then do:
      537         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      538       end.
      539       assign
      540         p-key-rec = p-tbl-name
      541         v-inform  = p-bh_tbl-name:index-information(1)
      542         v-ind     = 2
      543       .
      544       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      545       on error undo, return error
      546       :
      547         assign
      548           v-inform = p-bh_tbl-name:index-information( v-ind )
      549           v-ind    = v-ind + 1
      550         .
      551       end.
      552       if v-inform = ?
      553         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      554         or entry( 3, v-inform, ",":U ) <> "1":U
      555       then do:
      556         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      557       end.
      558       else do:
      559         assign
      560           v-idx-field-qnty = num-entries( v-inform ) - 4
      561         .
      562         if v-idx-field-qnty < 2 then do:
      563           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      564         end.
      565         do v-ind = 1 to v-idx-field-qnty by 2
      566         on error undo, return error
      567         :
      568           assign
      569             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      570             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      571           .
      572         end.
      573       end.
      574       if p-key-rec = ? then do:
      575         assign
      576           p-key-rec = "":U
      577         .
      578         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      579       end.
      580     end.
      581     return.
      582   end procedure.
      583   procedure gen-where-keyr-tab :
      584     define input  parameter i-tableSerach as character no-undo.
      585     define input  parameter i-tablekey   as character  no-undo.
      586     define input  parameter p-key-rec    as character  no-undo.
      587     define input  parameter p-key-handle as handle     no-undo .
      588     define input  parameter p-db-name    as character  no-undo .
      589     define input  parameter p-tt-handle  as handle     no-undo .
      590     define output parameter o-Where      as character  no-undo.
      591     do
      592     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      593     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      594     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      595     :
      596       define variable v-full-tbl-name  as character no-undo .
      597       define variable bh_tbl-name      as handle    no-undo .
      598       define variable fh_key           as handle    no-undo .
      599       define variable fh_search        as handle    no-undo .
      600       define variable v-field-num      as integer   no-undo .
      601       define variable v-count-fld      as integer   no-undo .
      602       define variable v-inform         as character no-undo .
      603       define variable v-ind            as integer   no-undo .
      604       define variable v-idx-field-qnty as integer   no-undo .
      605       define variable v-field-name     as character no-undo .
      606       define variable v-field-val      as character no-undo .
      607       define variable v-word-link      as character no-undo .
      608       define variable vTable           as character no-undo.
      609       define variable bh_tbl-key       as handle    no-undo .
      610       assign
      611         p-key-rec = trim( p-key-rec )
      612       .
      613       if p-key-handle <> ? then do:
      614         if not valid-handle(p-key-handle)
      615            or p-key-handle:type <> "buffer"
      616         then do:
      617           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      618         end.
      619         if num-entries( p-key-rec, chr(3) ) > 1
      620           or p-key-rec = ?
      621           or p-key-rec = "":U
      622         then do:
      623           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      624         end.
      625       end.
      626       else do:
      627         if p-key-rec = ?
      628           or p-key-rec = "":U
      629         then do:
      630           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      631         end.
      632       end.
      633       assign
      634         vTable = entry( 1 , p-key-rec, chr(3) )
      635       .
      636       if p-tt-handle <> ?
      637         and ( not valid-handle(p-tt-handle)
      638               or p-tt-handle:type <> "buffer"
      639             )
      640       then do:
      641         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      642       end.
      643       if p-tt-handle = ? then do:
      644         assign
      645           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      646         .
      647         create buffer bh_tbl-name for table v-full-tbl-name .
      648       end.
      649       else do:
      650         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      651       end.
      652       assign
      653         v-inform = bh_tbl-name:index-information(1)
      654         v-ind    = 2
      655       .
      656       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      657       on error undo, return error
      658       :
      659         assign
      660           v-inform = bh_tbl-name:index-information( v-ind )
      661           v-ind    = v-ind + 1
      662         .
      663       end.
      664       if v-inform = ?
      665         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      666         or entry( 3, v-inform, ",":U ) <> "1":U
      667       then do:
      668         delete object bh_tbl-name no-error.
      669         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      670       end.
      671       assign
      672         v-idx-field-qnty = num-entries( v-inform ) - 4
      673       .
      674       if v-idx-field-qnty < 2 then do:
      675         delete object bh_tbl-name no-error.
      676         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      677       end.
      678       assign
      679         o-where     = "where":U
      680         v-word-link = "":U
      681         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      682         v-count-fld = 0
      683       .
      684       if i-tablekey ne "" and i-tablekey ne ?
      685       then do:
      686         assign
      687           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      688         .
      689         create buffer bh_tbl-key for table v-full-tbl-name .
      690       end.
      691       if i-tableSerach ne "" and i-tableSerach ne ?
      692       then do:
      693         delete object bh_tbl-name no-error.
      694         assign
      695           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      696         .
      697         create buffer bh_tbl-name for table v-full-tbl-name .
      698       end.
      699       block_where:
      700       do v-ind = 1 to v-idx-field-qnty by 2
      701       on error undo, return error
      702       :
      703         assign
      704           v-count-fld = v-count-fld + 1
      705         .
      706         if p-key-handle = ?
      707           and v-count-fld > v-field-num
      708         then do:
      709           leave block_where.
      710         end.
      711         define variable VfieldKeyTable as handle no-undo.
      712         assign
      713           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      714           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      715         .
      716         if     bh_tbl-key ne ?
      717         then do:
      718            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      719            if VfieldKeyTable eq ?
      720            then next block_where.
      721         end.
      722         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      723         then
      724            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      725         else
      726            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      727         if p-key-handle = ? then do:
      728           assign
      729             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      730           .
      731         end.
      732         else do:
      733           assign
      734             fh_key = p-key-handle:buffer-field( v-field-name )
      735           .
      736           if fh_key = ?
      737             or not valid-handle( fh_key )
      738           then do:
      739             delete object bh_tbl-name.
      740             if     bh_tbl-key ne ?
      741             then
      742                delete object bh_tbl-key.
      743             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      744           end.
      745           assign
      746             v-field-val = fh_key:buffer-value
      747           .
      748         end.
      749         if fh_search:data-type ="character":U then do:
      750           assign
      751             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      752             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      753             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      754             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      755             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      756             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      757             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      758             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      759             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      760             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      761             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      762             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      763             v-field-val = substitute( '"&1"', v-field-val )
      764           .
      765         end.
      766         assign
      767           o-where = substitute( "&1 &2", o-where, v-field-val )
      768         .
      769         if v-word-link = "":U then do:
      770           assign
      771             v-word-link = "and":U
      772           .
      773         end.
      774       end.
      775       delete object bh_tbl-name.
      776       if     bh_tbl-key ne ?
      777       then
      778          delete object bh_tbl-key.
      779       if p-key-handle = ?
      780         and v-count-fld <> v-field-num
      781       then do:
      782         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      783       end.
      784     end.
      785   end procedure.
      786   procedure gen-hn-keyr-tab :
      787     define input  parameter i-tableSerach as character no-undo.
      788     define input  parameter i-tablekey   as character no-undo.
      789     define input  parameter p-key-rec    as character no-undo.
      790     define input  parameter p-key-handle as handle    no-undo .
      791     define input  parameter p-db-name    as character no-undo .
      792     define input  parameter p-tt-handle  as handle    no-undo .
      793     define input  parameter p-stts-lock  as integer   no-undo .
      794     define output parameter o-hn         as handle    no-undo.
      795     define variable v-full-tbl-name as character no-undo.
      796     define variable v-where         as character no-undo.
      797     define variable bh_tbl-name     as handle    no-undo.
      798     define variable vTable          as character no-undo.
      799     do
      800     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      801     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      802     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      803         run gen-where-keyr-tab(i-tableSerach,
      804                                i-tablekey,
      805                                p-key-rec,
      806                                p-key-handle,
      807                                p-db-name,
      808                                p-tt-handle,
      809                                output v-where).
      810         if i-tableSerach ne "" and i-tableSerach ne ?
      811         then do:
      812            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      813            create buffer bh_tbl-name for table v-full-tbl-name .
      814         end.
      815         else do:
      816            if p-tt-handle = ? then do:
      817               assign
      818                  vTable = entry( 1 , p-key-rec, chr(3) )
      819               .
      820               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      821               create buffer bh_tbl-name for table v-full-tbl-name .
      822            end.
      823            else do:
      824               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      825            end.
      826         end.
      827         if p-tt-handle = ? then do:
      828            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      829         end.
      830         else do:
      831            bh_tbl-name:find-first( v-where ) no-error .
      832         end.
      833         o-hn = bh_tbl-name.
      834      end.
      835   end procedure.
      836   procedure gen-hn-keyr :
      837     define input  parameter p-key-rec    as character no-undo.
      838     define input  parameter p-key-handle as handle    no-undo .
      839     define input  parameter p-db-name    as character no-undo .
      840     define input  parameter p-tt-handle  as handle    no-undo .
      841     define input  parameter p-stts-lock  as integer   no-undo .
      842     define output parameter o-hn         as handle    no-undo.
      843     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      844   end.
      845   procedure gen-row-keyr :
      846     define input  parameter p-key-rec    as character no-undo.
      847     define input  parameter p-key-handle as handle    no-undo .
      848     define input  parameter p-db-name    as character no-undo .
      849     define input  parameter p-tt-handle  as handle    no-undo .
      850     define input  parameter p-stts-lock  as integer   no-undo .
      851     define output parameter p-tbl-row    as rowid     no-undo.
      852     define output parameter p-tbl-name   as character no-undo.
      853     define variable vHn as handle no-undo.
      854       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      855       p-tbl-row = if vHn:available then vHn:rowid else ?.
      856       p-tbl-name =  vHn:table.
      857       delete object vHn no-error.
      858     if p-tbl-row = ? then do:
      859       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      860     end.
      861     else do:
      862       return.
      863     end.
      864   end procedure.
      865   procedure gen-key-fv :
      866     define input  parameter p-key-rec    as character no-undo .
      867     define output parameter p-field-list as character no-undo .
      868     define output parameter p-value-list as character no-undo.
      869     do
      870     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      871     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      872     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      873     :
      874       define variable v-full-tbl-name  as character no-undo .
      875       define variable bh_tbl-name      as handle    no-undo .
      876       define variable v-tbl-name       as character no-undo .
      877       define variable v-field-num      as integer   no-undo .
      878       define variable v-count-fld      as integer   no-undo .
      879       define variable v-inform         as character no-undo .
      880       define variable v-ind            as integer   no-undo .
      881       define variable v-idx-field-qnty as integer   no-undo .
      882       define variable v-delim-key      as character no-undo .
      883       if p-key-rec = ?
      884         or p-key-rec = "":U
      885       then do:
      886         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      887       end.
      888       assign
      889         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      890         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      891       .
      892       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      893       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
      894       assign
      895         v-inform = bh_tbl-name:index-information(1)
      896         v-ind    = 2
      897       .
      898       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      899       on error undo, return error
      900       :
      901         assign
      902           v-inform = bh_tbl-name:index-information( v-ind )
      903           v-ind    = v-ind + 1
      904         .
      905       end.
      906       if v-inform = ?
      907         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      908         or entry( 3, v-inform, ",":U ) <> "1":U
      909       then do:
      910         delete object bh_tbl-name no-error.
      911         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      912       end.
      913       assign
      914         v-idx-field-qnty = num-entries( v-inform ) - 4
      915       .
      916       if v-idx-field-qnty < 2 then do:
      917         delete object bh_tbl-name no-error.
      918         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      919       end.
      920       assign
      921         p-field-list = "":U
      922         p-value-list = "":U
      923         v-delim-key  = "":U
      924         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      925         v-count-fld  = 0
      926       .
      927       block_where:
      928       do v-ind = 1 to v-idx-field-qnty by 2
      929       on error undo, return error
      930       :
      931         assign
      932           v-count-fld = v-count-fld + 1
      933         .
      934         if v-count-fld > v-field-num then do:
      935           leave block_where.
      936         end.
      937         assign
      938           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      939           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      940         .
      941         if v-ind = 1 then do:
      942           assign
      943             v-delim-key = chr(3)
      944           .
      945         end.
      946       end.
      947       delete object bh_tbl-name.
      948       if v-count-fld <> v-field-num then do:
      949         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      950       end.
      951     end.
      952   end procedure.
      953   procedure gen-key-field :
      954     define input  parameter p-table      as character no-undo .
      955     define output parameter p-field-list as character no-undo .
      956     do
      957     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      958     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      959     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      960     :
      961       define variable v-full-tbl-name  as character no-undo .
      962       define variable bh_tbl-name      as handle    no-undo .
      963       define variable v-tbl-name       as character no-undo .
      964       define variable v-field-num      as integer   no-undo .
      965       define variable v-count-fld      as integer   no-undo .
      966       define variable v-inform         as character no-undo .
      967       define variable v-ind            as integer   no-undo .
      968       define variable v-idx-field-qnty as integer   no-undo .
      969       define variable v-delim-key      as character no-undo .
      970       if p-table = ?
      971         or p-table = "":U
      972       then do:
      973         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
      974       end.
      975       assign
      976         v-tbl-name      = p-table
      977         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      978       .
      979       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      980       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
      981       assign
      982         v-inform = bh_tbl-name:index-information(1)
      983         v-ind    = 2
      984       .
      985       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      986       on error undo, return error
      987       :
      988         assign
      989           v-inform = bh_tbl-name:index-information( v-ind )
      990           v-ind    = v-ind + 1
      991         .
      992       end.
      993       if v-inform = ?
      994         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      995         or entry( 3, v-inform, ",":U ) <> "1":U
      996       then do:
      997         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      998       end.
      999       assign
     1000         v-idx-field-qnty = num-entries( v-inform ) - 4
     1001       .
     1002       if v-idx-field-qnty < 2 then do:
     1003         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
     1004       end.
     1005       assign
     1006         p-field-list = "":U
     1007         v-delim-key  = "":U
     1008         v-count-fld  = 0
     1009       .
     1010       block_where:
     1011       do v-ind = 1 to v-idx-field-qnty by 2
     1012       on error undo, return error
     1013       :
     1014         assign
     1015           v-count-fld = v-count-fld + 1
     1016         .
     1017         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1018         if v-ind = 1 then do:
     1019           assign
     1020             v-delim-key = chr(3)
     1021           .
     1022         end.
     1023       end.
     1024       delete object bh_tbl-name.
     1025     end.
     1026   end procedure.
     1027   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1028   define variable tempcxml_v-num_ as integer no-undo .
     1029   define NEW SHARED temp-table temp-xml-tables no-undo
     1030   field order as integer
     1031   field tbl-name as character
     1032   field tbl-handle_ as handle
     1033   field table-handle_ as handle
     1034   field uniq-gate-rec as character
     1035   field gate-name as character
     1036   field gate-handle_ as handle
     1037   field is-parent as logical
     1038   index pi is unique primary
     1039   uniq-gate-rec
     1040   tbl-name
     1041   index iorder
     1042   order
     1043   index gr
     1044   uniq-gate-rec
     1045   index gh
     1046   gate-handle_
     1047   index iparent
     1048   is-parent
     1049   .
     1050   define NEW SHARED temp-table temp-xml-records no-undo
     1051   field tbl-name as character
     1052   field uniq-key-rec as character
     1053   index pi is unique primary
     1054   tbl-name
     1055   uniq-key-rec
     1056   .
     1057   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1058   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1059   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1060   procedure get-gate-file-name :
     1061   define input parameter p-gate-rec as character no-undo .
     1062   define output  parameter p-gate-file-name as character no-undo .
     1063   define buffer buf_clob-data for ub.clob-data.
     1064   define variable v-tbl-row as rowid no-undo .
     1065   define variable v-tbl-name as character no-undo .
     1066   run gen-row-keyr in this-procedure ( input p-gate-rec
     1067                                       ,input ?
     1068                                       ,input "ub"
     1069                                       ,input ?
     1070                                       ,input no-lock
     1071                                       ,output v-tbl-row
     1072                                       ,output v-tbl-name) no-error.
     1073   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1074                                                           ,vss-include-info6
     1075                                                           ,p-gate-rec).
     1076   find first buf_clob-data no-lock where
     1077             rowid(buf_clob-data) = v-tbl-row no-error.
     1078   if not available buf_clob-data then do:
     1079     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1080                                                             ,vss-include-info6
     1081                                                             ,p-gate-rec).
     1082   end.
     1083   p-gate-file-name = buf_clob-data.file-name.
     1084   end procedure.
     1085   procedure get-gate-rec :
     1086   define input  parameter p-gate-name as character no-undo .
     1087   define output parameter p-gate-rec as character no-undo .
     1088   define buffer buf_clob-bind for ub.clob-bind.
     1089   define buffer buf_clob-data for ub.clob-data.
     1090   main-block:
     1091   do
     1092   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info6, return-value, chr(10), error-status :get-message (1))
     1093   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info6 )
     1094   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info6 )
     1095   :
     1096       find first buf_clob-bind no-lock where
     1097                 buf_clob-bind.uniq-key-rec = p-gate-name
     1098             and buf_clob-bind.field-name = '':U
     1099             and buf_clob-bind.part-num = 1
     1100             and buf_clob-bind.resource-type = 'gate':U
     1101             no-error.
     1102       if not available buf_clob-bind then do:
     1103         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1104                                         , p-gate-name
     1105                                         ).
     1106       end.
     1107       find first buf_clob-data no-lock where
     1108                 buf_clob-data.db-num = buf_clob-bind.db-num
     1109             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1110       if not available buf_clob-data then do:
     1111         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1112                                         , buf_clob-bind.db-num
     1113                                         , buf_clob-bind.int64-id
     1114                                         , p-gate-name
     1115                                         ).
     1116       end.
     1117       run gen-key-rec in this-procedure ( input 'clob-data':U
     1118                                 ,input buffer buf_clob-data:handle
     1119                                 ,output p-gate-rec).
     1120   end.
     1121   end procedure.
     1122   procedure get-gate-by-name :
     1123   define input  parameter p-gate-name as character no-undo .
     1124   define output parameter p-gate-rec as character no-undo .
     1125   define output parameter p-dsh as handle no-undo .
     1126   define input-output  parameter p-xmlh as handle no-undo .
     1127   define variable v-ii as integer   no-undo .
     1128   define variable glog as logical   no-undo .
     1129   define variable v-longchar as longchar no-undo .
     1130   define variable v-txmlh as handle no-undo .
     1131   define variable v-db-num as integer no-undo .
     1132   define variable v-int64-id as int64 no-undo .
     1133   define buffer buf_clob-bind for ub.clob-bind.
     1134   define buffer buf_clob-data for ub.clob-data.
     1135   main-block:
     1136   do
     1137   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info6, return-value, chr(10), error-status :get-message (1))
     1138   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info6 )
     1139   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info6 )
     1140   :
     1141       find first buf_clob-bind no-lock where
     1142                 buf_clob-bind.uniq-key-rec = p-gate-name
     1143             and buf_clob-bind.field-name = '':U
     1144             and buf_clob-bind.part-num = 1
     1145             and buf_clob-bind.resource-type = 'gate':U
     1146             no-error.
     1147       if not available buf_clob-bind then do:
     1148         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1149                                         , p-gate-name
     1150                                         ).
     1151       end.
     1152       find first buf_clob-data no-lock where
     1153                 buf_clob-data.db-num = buf_clob-bind.db-num
     1154             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1155       if not available buf_clob-data then do:
     1156         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1157                                         , buf_clob-bind.db-num
     1158                                         , buf_clob-bind.int64-id
     1159                                         , p-gate-name
     1160                                         ).
     1161       end.
     1162       assign
     1163       v-longchar = buf_clob-data.cdata
     1164       .
     1165       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1166       if error-status :error then do:
     1167         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1168       end.
     1169       create dataset p-dsh .
     1170       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1171                                     , v-longchar
     1172                                     , ?
     1173                                     , ?
     1174                                     , ?
     1175                                     ) no-error.
     1176       v-longchar = '':U.
     1177       if error-status :error
     1178       or not glog
     1179       then do:
     1180         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1181       end.
     1182       if not valid-handle(p-xmlh)
     1183       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1184         create temp-table v-txmlh.
     1185         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1186         v-txmlh:temp-table-prepare("temp-xml-tables").
     1187         p-xmlh = v-txmlh:default-buffer-handle.
     1188       end.
     1189       run gen-key-rec in this-procedure ( input 'clob-data':U
     1190                                 ,input buffer buf_clob-data:handle
     1191                                 ,output p-gate-rec).
     1192       do v-ii = 1 to p-dsh:num-buffers:
     1193         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1194         if not p-xmlh:available then do:
     1195           p-xmlh:buffer-create().
     1196           assign
     1197           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1198           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1199           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1200           p-xmlh::gate-handle_ = p-dsh
     1201           p-xmlh::uniq-gate-rec = p-gate-rec
     1202           p-xmlh::gate-name = p-dsh:name
     1203           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1204           .
     1205           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1206             assign
     1207             p-xmlh::order = -3.
     1208           end.
     1209         end.
     1210       end.
     1211   end.
     1212   end procedure.
     1213   procedure get-gate-by-rec :
     1214   define input  parameter p-gate-rec as character no-undo .
     1215   define output parameter p-dsh as handle no-undo .
     1216   define input-output  parameter p-xmlh as handle no-undo .
     1217   define input-output parameter p-longchar  as longchar no-undo .
     1218   define variable v-ii as integer   no-undo .
     1219   define variable glog as logical   no-undo .
     1220   define variable v-rowid as rowid no-undo .
     1221   define variable v-tbl-name as character no-undo .
     1222   define variable v-longchar as longchar no-undo .
     1223   define variable v-txmlh as handle no-undo .
     1224   define buffer buf_clob-data for ub.clob-data.
     1225   main-block:
     1226   do
     1227   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info6, return-value, chr(10), error-status :get-message (1))
     1228   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info6 )
     1229   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info6 )
     1230   :
     1231     run gen-row-keyr in this-procedure (
     1232                                           input  p-gate-rec
     1233                                           ,input  ?
     1234                                           ,input  "ub"
     1235                                           ,input  ?
     1236                                           ,input  NO-LOCK
     1237                                           ,output v-rowid
     1238                                           ,output v-tbl-name   ) no-error.
     1239       find first buf_clob-data no-lock where
     1240                 rowid(buf_clob-data) = v-rowid  no-error.
     1241       if not available buf_clob-data then do:
     1242         undo, return error substitute("Не найден CLOB  &1"
     1243                                         , p-gate-rec
     1244                                         ).
     1245       end.
     1246       assign
     1247       v-longchar = buf_clob-data.cdata
     1248       .
     1249       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1250       if error-status :error then do:
     1251         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1252       end.
     1253       create dataset p-dsh .
     1254       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1255                                     , v-longchar
     1256                                     , ?
     1257                                     , ?
     1258                                     , ?
     1259                                     ) no-error.
     1260       define variable v-esm as character no-undo .
     1261       v-esm = error-status:get-message(1) .
     1262       if p-longchar <> ? then do:
     1263         p-longchar = v-longchar.
     1264       end.
     1265       v-longchar = '':U.
     1266       if error-status :error
     1267       or not glog
     1268       then do:
     1269         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1270                                      , p-gate-rec
     1271                                      , p-gate-rec
     1272                                      , v-esm
     1273                                      ).
     1274       end.
     1275       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1276       if not valid-handle(p-xmlh)
     1277       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1278         create temp-table v-txmlh.
     1279         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1280         v-txmlh:temp-table-prepare("temp-xml-tables").
     1281         p-xmlh = v-txmlh:default-buffer-handle.
     1282       end.
     1283       do v-ii = 1 to p-dsh:num-buffers:
     1284         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1285         if not p-xmlh:available then do:
     1286           p-xmlh:buffer-create().
     1287           assign
     1288           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1289           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1290           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1291           p-xmlh::gate-handle_ = p-dsh
     1292           p-xmlh::uniq-gate-rec = p-gate-rec
     1293           p-xmlh::gate-name = p-dsh:name
     1294           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1295           .
     1296           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1297             assign
     1298             p-xmlh::order = -3.
     1299           end.
     1300           p-xmlh:buffer-release().
     1301         end.
     1302       end.
     1303   end.
     1304   end procedure.
     1305   procedure get-gate-by-file :
     1306   define input  parameter p-schema-file-name as character no-undo .
     1307   define input  parameter p-gate-rec as character no-undo .
     1308   define output parameter p-dsh as handle no-undo .
     1309   define input-output  parameter p-xmlh as handle no-undo .
     1310   define variable v-ii as integer   no-undo .
     1311   define variable glog as logical   no-undo .
     1312   define variable v-rowid as rowid no-undo .
     1313   define variable v-tbl-name as character no-undo .
     1314   define variable v-longchar as longchar no-undo .
     1315   define variable v-txmlh as handle no-undo .
     1316   main-block:
     1317   do
     1318   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info6, return-value, chr(10), error-status :get-message (1))
     1319   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info6 )
     1320   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info6 )
     1321   :
     1322       COPY-LOB
     1323       FROM  FILE p-schema-file-name
     1324       TO  OBJECT v-longchar
     1325       no-convert
     1326       NO-ERROR .
     1327       if error-status :error then do:
     1328           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1329                                     , p-schema-file-name
     1330                                 , chr(10)
     1331                                 , error-status:get-message(1) ).
     1332       end.
     1333       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1334       if error-status :error then do:
     1335         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1336       end.
     1337       create dataset p-dsh .
     1338       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1339                                     , v-longchar
     1340                                     , ?
     1341                                     , ?
     1342                                     , ?
     1343                                     ) no-error.
     1344       v-longchar = ''.
     1345       if error-status :error
     1346       or not glog
     1347       then do:
     1348         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1349                                      , p-schema-file-name
     1350                                      ,chr(10)
     1351                                      , error-status:get-message(1)
     1352                                      ).
     1353       end.
     1354       if not valid-handle(p-xmlh)
     1355       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1356         create temp-table v-txmlh.
     1357         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1358         v-txmlh:temp-table-prepare("temp-xml-tables").
     1359         p-xmlh = v-txmlh:default-buffer-handle.
     1360       end.
     1361       do v-ii = 1 to p-dsh:num-buffers:
     1362         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1363                                      ,p-dsh:get-buffer-handle(v-ii):name
     1364                                      ,p-gate-rec
     1365                                      )) no-error.
     1366         if not p-xmlh:available then do:
     1367           p-xmlh:buffer-create().
     1368           assign
     1369           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1370           p-xmlh::uniq-gate-rec = p-gate-rec
     1371           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1372           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1373           p-xmlh::gate-handle_ = p-dsh
     1374           p-xmlh::gate-name = p-dsh:name
     1375           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1376           .
     1377           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1378             assign
     1379             p-xmlh::order = -3.
     1380           end.
     1381           p-xmlh:buffer-release().
     1382         end.
     1383       end.
     1384   end.
     1385   end procedure.
     1386   procedure gate-clear :
     1387   define input  parameter p-dsh as handle no-undo .
     1388   define input  parameter p-xmlh as handle no-undo .
     1389   define variable v-dsh as handle no-undo .
     1390   define variable v-th as handle no-undo .
     1391     do
     1392     on error undo, return error return-value
     1393     :
     1394       if valid-handle(p-dsh) then do:
     1395         delete object p-dsh.
     1396         v-dsh = p-dsh.
     1397         p-dsh = ?.
     1398       end.
     1399       repeat while true:
     1400         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1401                            , share-lock) no-error.
     1402         if p-xmlh:available then do:
     1403           assign
     1404           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1405           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1406           and valid-handle(v-th)
     1407           and v-th:dynamic = yes
     1408           then do:
     1409             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1410             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1411           end.
     1412           p-xmlh:buffer-delete().
     1413         end.
     1414         else do:
     1415           leave.
     1416         end.
     1417       end.
     1418       if p-xmlh:dynamic = yes
     1419       and valid-handle(p-xmlh)
     1420       then do:
     1421         delete object p-xmlh:table-handle.
     1422         p-xmlh = ?.
     1423       end.
     1424       v-dsh = ?.
     1425     end.
     1426   end procedure.
     1427   procedure all-gates-clear :
     1428   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1429   do
     1430   on error undo, return error
     1431   :
     1432     for each buf_temp-xml-tables
     1433     break
     1434     by buf_temp-xml-tables.uniq-gate-rec
     1435     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1436     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1437     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1438     :
     1439         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1440           delete object buf_temp-xml-tables.gate-handle_.
     1441           buf_temp-xml-tables.gate-handle_ = ?.
     1442         end.
     1443         if valid-handle(buf_temp-xml-tables.table-handle_)
     1444         and buf_temp-xml-tables.table-handle_:dynamic = no
     1445         then do:
     1446           delete object buf_temp-xml-tables.table-handle_.
     1447           buf_temp-xml-tables.table-handle_ = ?.
     1448         end.
     1449         delete buf_temp-xml-tables.
     1450     end.
     1451   end.
     1452   end procedure.
     1453   procedure fix-schemalocation :
     1454   define input-output  parameter p-longchar as longchar no-undo .
     1455   DEFINE VARIABLE hdoc AS HANDLE.
     1456   DEFINE VARIABLE hroot AS HANDLE.
     1457   DEFINE VARIABLE hnode-child AS HANDLE.
     1458   DEFINE VARIABLE hnode-attr AS HANDLE.
     1459   define variable v-jj as integer   no-undo .
     1460   define variable ok as logical   no-undo .
     1461   define variable v-path1                    as character                no-undo .
     1462   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1463   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1464   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1465   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1466   define variable v-schema-location          as character                no-undo .
     1467   do
     1468   on error undo, return error return-value
     1469   :
     1470     CREATE X-DOCUMENT hdoc.
     1471     CREATE X-noderef hroot.
     1472     CREATE X-noderef hnode-child.
     1473     CREATE X-noderef hnode-attr.
     1474     hdoc:load("longchar", p-longchar, no) no-error.
     1475     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1476     hdoc:get-document-element(hroot).
     1477     _repeat:
     1478     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1479       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1480       if not ok then next.
     1481       if hNode-Child:local-name = "include"
     1482       then do:
     1483         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1484           v-schema-location = hnode-attr:node-value.
     1485           run gbl/filename.p (
     1486                           input "exe/" + hnode-attr:node-value
     1487                         ,output v-full-path1
     1488                         ,output v-path1
     1489                         ,output v-file-name1
     1490                         ,output v-file-name-no-ext1
     1491                         ,output v-file-name-ext1
     1492                         ) no-error .
     1493           if error-status :error then do:
     1494             delete object hnode-attr.
     1495             delete object hnode-child.
     1496             delete object hroot.
     1497             delete object hdoc.
     1498             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1499           end.
     1500         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1501         leave  _repeat.
     1502       end.
     1503     END.
     1504     hdoc:save("longchar", p-longchar).
     1505     delete object hnode-attr.
     1506     delete object hnode-child.
     1507     delete object hroot.
     1508     delete object hdoc.
     1509   end.
     1510   end procedure.
     1511   procedure gate-clb_fill-xml-tables :
     1512   define input parameter p-dsh as handle no-undo .
     1513   define input-output parameter p-xmlh as handle no-undo .
     1514   define variable v-ii as integer no-undo .
     1515     do
     1516     on error undo, return error
     1517     :
     1518       do v-ii = 1 to p-dsh:num-buffers:
     1519         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1520         if not p-xmlh:available then do:
     1521           p-xmlh:buffer-create().
     1522           assign
     1523           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1524           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1525           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1526           p-xmlh::gate-handle_ = p-dsh
     1527           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1528           p-xmlh::gate-name = p-dsh:name
     1529           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1530           .
     1531           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1532             assign
     1533             p-xmlh::order = -3.
     1534           end.
     1535           p-xmlh:buffer-release().
     1536         end.
     1537       end.
     1538     end.
     1539   end procedure.
     1540   procedure all-gates-empty :
     1541   define buffer buf_temp-xml-tables for temp-xml-tables.
     1542   do
     1543   on error undo, return error
     1544   :
     1545     for each buf_temp-xml-tables
     1546     break
     1547     by buf_temp-xml-tables.uniq-gate-rec
     1548     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1549     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1550     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1551     :
     1552       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1553         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1554       end.
     1555     end.
     1556   end.
     1557   end procedure.
     1558   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1559   define shared temp-table temp-param-name no-undo
     1560   field profile_id as integer
     1561   field profile-type as character
     1562   field schema-name as character
     1563   field esys-id as integer
     1564   field call_id as character
     1565   field once-more as integer
     1566   field codex_id as integer
     1567   field ruleset_id as integer
     1568   field order_id as integer
     1569   field param-name as character
     1570   field param-type as character
     1571   field pack-process-uniq-key-rec as character
     1572   index pi is primary unique
     1573   esys-id
     1574   schema-name
     1575   profile_id
     1576   call_id
     1577   .
     1578   procedure xmlischn_fill :
     1579   define input  parameter p-codex-id  as integer   no-undo .
     1580   define input  parameter p-ruleset-id as integer   no-undo .
     1581   define buffer buf_rule-call-param  for ub.rule-call-param.
     1582   define buffer buf2_rule-call-param for ub.rule-call-param.
     1583   define buffer buf_temp-param-name for temp-param-name.
     1584   define variable v-esys-id-list as character no-undo .
     1585   define variable v-ii as integer no-undo .
     1586     do
     1587     on error undo, return error return-value
     1588     :
     1589       for each buf_rule-call-param where
     1590               buf_rule-call-param.codex_id = p-codex-id
     1591           and buf_rule-call-param.ruleset_id = p-ruleset-id
     1592       break
     1593       by buf_rule-call-param.call_id
     1594       by buf_rule-call-param.profile_id
     1595       by buf_rule-call-param.once-more
     1596       :
     1597         if first-of(buf_rule-call-param.once-more) then do:
     1598           v-esys-id-list = ''.
     1599           for each buf2_rule-call-param no-lock
     1600              where buf2_rule-call-param.call_id    = buf_rule-call-param.call_id
     1601                and buf2_rule-call-param.codex_id   = buf_rule-call-param.codex_id
     1602                and buf2_rule-call-param.ruleset_id = buf_rule-call-param.ruleset_id
     1603                and buf2_rule-call-param.profile_id = buf_rule-call-param.profile_id
     1604                and buf2_rule-call-param.once-more  = buf_rule-call-param.once-more
     1605                and buf2_rule-call-param.param-2-data-type = 'ext-system':U :
     1606             if buf2_rule-call-param.param-name = "p-esys-id"
     1607                  or
     1608                  (buf2_rule-call-param.param-name = "p-esys-id-list"
     1609                  and
     1610                  buf2_rule-call-param.p-index > 0)
     1611             then do:
     1612               assign
     1613               v-esys-id-list = v-esys-id-list + (if v-esys-id-list = '' then '' else chr(44)) +
     1614                               string( buf2_rule-call-param.param-value-integer)
     1615               .
     1616             end.
     1617           end.
     1618         end.
     1619         if v-esys-id-list = "" then v-esys-id-list = "-1".
     1620         if buf_rule-call-param.param-2-data-type = "xsd" then do:
     1621           find first buf_temp-param-name where
     1622                   buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     1623             and buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     1624             and buf_temp-param-name.call_id = buf_rule-call-param.call_id
     1625             and buf_temp-param-name.once-more = buf_rule-call-param.once-more
     1626             no-error.
     1627           if not available buf_temp-param-name then do:
     1628             do v-ii = 1 to num-entries(v-esys-id-list):
     1629               find first buf_temp-param-name where
     1630                       buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     1631                 and buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     1632                 and buf_temp-param-name.call_id = buf_rule-call-param.call_id
     1633                 and buf_temp-param-name.esys-id = integer(entry(v-ii, v-esys-id-list))
     1634                 no-error.
     1635               if not available buf_temp-param-name then do:
     1636             create buf_temp-param-name.
     1637             assign
     1638             buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     1639             buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     1640             buf_temp-param-name.call_id = buf_rule-call-param.call_id
     1641             buf_temp-param-name.once-more = buf_rule-call-param.once-more
     1642             buf_temp-param-name.esys-id = integer(entry(v-ii, v-esys-id-list))
     1643             buf_temp-param-name.ruleset_id = buf_rule-call-param.ruleset_id
     1644             buf_temp-param-name.codex_id = buf_rule-call-param.codex_id
     1645             buf_temp-param-name.order_id = buf_rule-call-param.order_id
     1646             buf_temp-param-name.param-name = buf_rule-call-param.param-name
     1647               buf_temp-param-name.param-type = "xsd"
     1648               buf_temp-param-name.profile-type = entry (buf_rule-call-param.codex_id, 'dis-card-type,dis-card-type,dis-card-type,dis-card-type,dis-card-type,dis-card-type,,,,,goods,clients,gds-grp,cli-grp,,,,edoc,chk-doc,thref,pdf,rep,ord,fdoc':U)
     1649               buf_temp-param-name.pack-process-uniq-key-rec =
     1650               substitute("&2&1&3&1&4&1&5"
     1651                                                                         , chr(4)
     1652                                                                         , buf_rule-call-param.call_id
     1653                                                                         , buf_rule-call-param.codex_id
     1654                                                                         , buf_rule-call-param.ruleset_id
     1655                                                                         , buf_rule-call-param.order_id)
     1656               .
     1657               end.
     1658             end.
     1659           end.
     1660         end.
     1661         if buf_rule-call-param.param-2-data-type = "sub-type" then do:
     1662           find first buf_temp-param-name where
     1663                   buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     1664             and buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     1665             and buf_temp-param-name.call_id = buf_rule-call-param.call_id
     1666             and buf_temp-param-name.once-more = buf_rule-call-param.once-more
     1667             no-error.
     1668           if not available buf_temp-param-name then do:
     1669             do v-ii = 1 to num-entries(v-esys-id-list):
     1670               find first buf_temp-param-name where
     1671                       buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     1672                 and buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     1673                 and buf_temp-param-name.call_id = buf_rule-call-param.call_id
     1674                 and buf_temp-param-name.esys-id = integer(entry(v-ii, v-esys-id-list))
     1675                 no-error.
     1676               if not available buf_temp-param-name then do:
     1677               create buf_temp-param-name.
     1678               assign
     1679               buf_temp-param-name.schema-name = buf_rule-call-param.param-value-character
     1680               buf_temp-param-name.profile_id = buf_rule-call-param.profile_id
     1681               buf_temp-param-name.call_id = buf_rule-call-param.call_id
     1682               buf_temp-param-name.once-more = buf_rule-call-param.once-more
     1683               buf_temp-param-name.esys-id = integer(entry(v-ii, v-esys-id-list))
     1684               buf_temp-param-name.ruleset_id = buf_rule-call-param.ruleset_id
     1685               buf_temp-param-name.codex_id = buf_rule-call-param.codex_id
     1686               buf_temp-param-name.order_id = buf_rule-call-param.order_id
     1687               buf_temp-param-name.param-name = buf_rule-call-param.param-name
     1688               buf_temp-param-name.param-type = "no-xsd"
     1689             buf_temp-param-name.profile-type = entry (buf_rule-call-param.codex_id, 'dis-card-type,dis-card-type,dis-card-type,dis-card-type,dis-card-type,dis-card-type,,,,,goods,clients,gds-grp,cli-grp,,,,edoc,chk-doc,thref,pdf,rep,ord,fdoc':U)
     1690             buf_temp-param-name.pack-process-uniq-key-rec =
     1691             substitute("&2&1&3&1&4&1&5"
     1692                                                                        , chr(4)
     1693                                                                        , buf_rule-call-param.call_id
     1694                                                                        , buf_rule-call-param.codex_id
     1695                                                                        , buf_rule-call-param.ruleset_id
     1696                                                                        , buf_rule-call-param.order_id)
     1697             .
     1698           end.
     1699         end.
     1700       end.
     1701       end.
     1702       end.
     1703     end.
     1704   end procedure.
     1705   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1706   procedure impxcbsh :
     1707   define input  parameter p-esys-id as integer   no-undo .
     1708   define input  parameter p-pck-num as integer   no-undo .
     1709   define input  parameter p-uniq-gate-rec as character no-undo .
     1710   define input  parameter p-dataseth as handle no-undo .
     1711   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1712   define variable v-esys-cmd-proc-handle as handle no-undo .
     1713   define variable v-esys-cmd-code as integer   no-undo .
     1714   define variable v-esys-rec-ord as integer   no-undo .
     1715   define variable glog as logical   no-undo .
     1716   define variable v_qh as handle no-undo .
     1717   define variable v-dmp-ord-int64 as int64 no-undo .
     1718   define buffer buf_esys-route for ub.esys-route.
     1719   main-block:
     1720   do
     1721   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1722   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1723   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1724   :
     1725     run nws/cmd-bush.p persistent set v-esys-cmd-proc-handle no-error .
     1726     if error-status :error  then do:
     1727       delete procedure v-esys-cmd-proc-handle no-error .
     1728       undo main-block, return error  substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     1729                                           "&5&4&6"
     1730                                           ,vss-workfile
     1731                                           ,vss-revision
     1732                                           ,vss-description
     1733                                           ,chr(10)
     1734                                           ,error-status:get-message(1)
     1735                                           ,return-value ).
     1736     end.
     1737     run begin-create-command in v-esys-cmd-proc-handle
     1738       (input 'cmd-esys-general':U
     1739       ,input string(- p-esys-id)
     1740       ,output v-esys-cmd-code
     1741       ) no-error.
     1742     if error-status :error  then do:
     1743       delete procedure v-esys-cmd-proc-handle no-error .
     1744       undo main-block, return error  substitute("Ошибка при создании команды &1&2&3&1&4"
     1745                                                        , 'cmd-esys-general':U
     1746                                                        , error-status:get-message(1)
     1747                                                        , return-value
     1748                                                        ).
     1749     end.
     1750     for each buf_temp-xml-tables where
     1751             buf_temp-xml-tables.gate-handle_ = p-dataseth
     1752     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1753     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1754     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1755     :
     1756       if buf_temp-xml-tables.tbl-name = "ThHeader" then next.
     1757       if buf_temp-xml-tables.tbl-name = "header_" then next.
     1758       create query v_qh.
     1759       glog = v_qh:set-buffers( buf_temp-xml-tables.tbl-handle_) no-error.
     1760       if error-status:error
     1761       or
     1762       not glog then do:
     1763         undo main-block, return error substitute("Ошибка при попытке получить записи &1&2&3&2&4"
     1764                                                                 , buf_temp-xml-tables.tbl-name
     1765                                                                 , chr(10)
     1766                                                                 , error-status:get-message(1)
     1767                                                                 , return-value).
     1768       end.
     1769       glog = v_qh:query-prepare( substitute( "for each &1 ", buf_temp-xml-tables.tbl-name)) no-error .
     1770       if error-status:error
     1771       or
     1772       not glog then do:
     1773         undo main-block, return error substitute("Ошибка при попытке получить записи &1&2&3&2&4"
     1774                                                               , buf_temp-xml-tables.tbl-name
     1775                                                               , chr(10)
     1776                                                               , error-status:get-message(1)
     1777                                                               , return-value).
     1778       end.
     1779       glog = v_qh:query-open no-error .
     1780       if error-status:error
     1781       or
     1782       not glog then do:
     1783         undo main-block, return error substitute("Ошибка при попытке получить записи &1&2&3&2&4"
     1784                                                               , buf_temp-xml-tables.tbl-name
     1785                                                               , chr(10)
     1786                                                               , error-status:get-message(1)
     1787                                                               , return-value).
     1788       end.
     1789       _record:
     1790       do while true
     1791       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1792       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1793       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1794       :
     1795         v_qh:get-next().
     1796         IF v_qh:query-off-end then leave _record.
     1797         run add-dump in v-esys-cmd-proc-handle
     1798           (input v-esys-cmd-code
     1799           ,input buf_temp-xml-tables.tbl-name
     1800           ,input '+update'
     1801           ,input buf_temp-xml-tables.tbl-handle_
     1802           ,input p-uniq-gate-rec
     1803           ,output v-esys-rec-ord
     1804           ) no-error .
     1805         if error-status:error then do:
     1806           if valid-handle(v-esys-cmd-proc-handle) then do:
     1807             delete procedure v-esys-cmd-proc-handle .
     1808           end.
     1809           undo main-block, return error substitute("Ошибка при добавлении записи &2 в команду с кодом &3&1&4&1&5"
     1810                                               ,chr(10)
     1811                                               ,buf_temp-xml-tables.tbl-name
     1812                                               ,v-esys-cmd-code
     1813                                               ,error-status:get-message(1)
     1814                                               ,return-value
     1815                                               ) .
     1816         end.
     1817       end.
     1818       v_qh:query-close().
     1819       if valid-handle(v_qh) then do:
     1820         delete object v_qh.
     1821         v_qh = ?.
     1822       end.
     1823     end.
     1824     run send-command-esys in v-esys-cmd-proc-handle
     1825       (input v-esys-cmd-code
     1826       ,input string(- p-esys-id)
     1827       ,input g#userid
     1828       ,output v-dmp-ord-int64
     1829       ) no-error.
     1830     if error-status :error then do:
     1831       delete procedure v-esys-cmd-proc-handle no-error.
     1832       undo main-block, return error substitute("Ошибка отсылке во внешнюю систему &1 команды с кодом &2&3&4&3&5"
     1833                                                        , p-esys-id
     1834                                                        , v-esys-cmd-code
     1835                                                        , chr(10)
     1836                                                        , error-status:get-message(1)
     1837                                                        , return-value
     1838                                                        ).
     1839     end.
     1840     delete procedure v-esys-cmd-proc-handle no-error.
     1841     for each buf_esys-route exclusive-lock where
     1842             buf_esys-route.esys-id = - p-esys-id
     1843         and buf_esys-route.esr-dump-ord = v-dmp-ord-int64
     1844         and buf_esys-route.db-num = g#db-num
     1845          and buf_esys-route.esr-cr-db-num = g#db-num
     1846     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1847     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1848     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1849     :
     1850       assign
     1851       buf_esys-route.esr-last-pack = p-pck-num
     1852       .
     1853     end.
     1854   end.
     1855   end procedure.
     1856   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1857   define variable vss-include-info12 as character format "X(65)" no-undo
     1858   initial "@(#)$Workfile$ $Revision$".
     1859   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1860   define stream stmXMLOut.
     1861   define stream stmXMLLog.
     1862   define stream strXMLIn.
     1863   define temp-table temp_xmllib_rec-list no-undo
     1864       field recName       as character
     1865       field recLevel      as integer
     1866       field recOpenLine   as integer
     1867       field recCloseLine  as integer
     1868       field closed        as logical
     1869       index pi is primary unique
     1870           recName
     1871           recLevel
     1872       index cl
     1873           closed
     1874   .
     1875   define temp-table temp_xmllib_rec-fld-list no-undo
     1876       field recName       as character
     1877       field recLevel      as integer
     1878       field fldName       as character
     1879       field fldOpenLine   as integer
     1880       field fldCloseLine  as integer
     1881       field closed        as logical
     1882       index pi is primary unique
     1883           recName
     1884           recLevel
     1885           fldName
     1886       index fn
     1887           fldName
     1888       index cl
     1889           closed
     1890   .
     1891   define temp-table temp_xmllib_rec no-undo
     1892       field rec-key       as integer
     1893       field recLevel      as integer
     1894       field recOpenLine   as integer
     1895       field recCloseLine  as integer
     1896       field recName       as character
     1897       field closed        as logical
     1898       index pi is primary unique
     1899           rec-key
     1900       index nm
     1901           recName
     1902           closed
     1903           rec-key
     1904       index cl
     1905           closed
     1906       index rlv
     1907           recName
     1908           recLevel
     1909           closed
     1910           rec-key
     1911   .
     1912   define temp-table temp_xmllib_rec-fld no-undo
     1913       field fld-key       as integer
     1914       field rec-key       as integer
     1915       field fldOpenLine   as integer
     1916       field fldCloseLine  as integer
     1917       field fldName       as character
     1918       field fldValue      as character
     1919       field closed        as logical
     1920       index pi is primary unique
     1921           fld-key
     1922       index nm
     1923           rec-key
     1924           fldName
     1925           closed
     1926           fld-key
     1927       index cl
     1928           closed
     1929   .
     1930   define variable v-xmllib-rec-key            as integer      no-undo .
     1931   define variable v-xmllib-rec-fld-key        as integer      no-undo .
     1932   define variable v-xmllib-dirname            as character    no-undo .
     1933   define variable v-xmllib-filename           as character    no-undo .
     1934   define variable v-xmllib-log-filename       as character    no-undo .
     1935   define variable v-xmllib-log-handle         as handle       no-undo .
     1936   define variable v-xmllib-log-proc-name      as character    no-undo .
     1937   define variable v-xmllib-error-status       as logical      no-undo .
     1938   define variable v-xmllib-sax-reader-handle  as handle       no-undo .
     1939   define variable v-xmllib-prg-bar-handle     as handle       no-undo .
     1940   define variable v-xmllib-codepage-convert   as logical      no-undo .
     1941   define variable v-xmllib-codepage-source    as character    no-undo .
     1942   define variable v-xmllib-codepage-target    as character    no-undo .
     1943   procedure xmllib-clear-parse-data :
     1944   do
     1945   on error undo, return error
     1946   :
     1947       empty temp-table temp_xmllib_rec-list.
     1948       empty temp-table temp_xmllib_rec-fld-list.
     1949       empty temp-table temp_xmllib_rec.
     1950       empty temp-table temp_xmllib_rec-fld.
     1951   end.
     1952   end procedure.
     1953   procedure xmllib-add-rec-fld :
     1954   define input parameter p-rec-name       as character        no-undo.
     1955   define input parameter p-rec-fld-name   as character        no-undo.
     1956       define buffer buf_rec-list        for temp_xmllib_rec-list.
     1957       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     1958   do
     1959   for buf_rec-list
     1960     , buf_rec-fld-list
     1961   on error undo, return error
     1962   :
     1963       find first buf_rec-list
     1964            where buf_rec-list.recName = p-rec-name
     1965       no-error.
     1966       if not available buf_rec-list
     1967       then do:
     1968           create buf_rec-list.
     1969           assign
     1970               buf_rec-list.recName        = p-rec-name
     1971               buf_rec-list.recOpenLine    = 0
     1972               buf_rec-list.recCloseLine   = 0
     1973               buf_rec-list.closed         = yes
     1974           .
     1975       end.
     1976       find first buf_rec-fld-list
     1977            where buf_rec-fld-list.recName = p-rec-name
     1978              and buf_rec-fld-list.fldName = p-rec-fld-name
     1979       no-error.
     1980       if not available buf_rec-fld-list
     1981       then do:
     1982           create buf_rec-fld-list.
     1983           assign
     1984               buf_rec-fld-list.recName        = p-rec-name
     1985               buf_rec-fld-list.fldName        = p-rec-fld-name
     1986               buf_rec-fld-list.fldOpenLine    = 0
     1987               buf_rec-fld-list.fldCloseLine   = 0
     1988               buf_rec-fld-list.closed         = yes
     1989           .
     1990       end.
     1991   end.
     1992   end procedure.
     1993   procedure xmllib-tag-open:
     1994   define input parameter v-tag-level  as integer      no-undo.
     1995   define input parameter v-tag-name   as character    no-undo.
     1996   define input parameter v-tag-value  as character    no-undo.
     1997   do
     1998   on error undo, return error
     1999   :
     2000       assign
     2001           v-tag-name = trim( v-tag-name )
     2002       .
     2003       put stream stmXMLOut unformatted
     2004           substitute( "&1&2<&3&4&5>"
     2005               , chr(10)
     2006               , fill(" ", 4 * v-tag-level)
     2007               , v-tag-name
     2008               , ( if v-tag-value = "":U or v-tag-value = ? then "":U else " ":U )
     2009               , v-tag-value
     2010           )
     2011       .
     2012   end.
     2013   end procedure.
     2014   procedure xmllib-tag-put:
     2015   define input parameter v-tag-level      as integer      no-undo.
     2016   define input parameter v-tag-name       as character    no-undo.
     2017   define input parameter v-tag-value      as character    no-undo.
     2018   define input parameter v-empty-mode     as integer      no-undo.
     2019   do
     2020   on error undo, return error
     2021   :
     2022       assign
     2023           v-tag-name = trim( v-tag-name )
     2024       .
     2025       if  v-empty-mode = 1
     2026       or (v-empty-mode = 0 and (v-tag-value <> "":U and v-tag-value <> ?) )
     2027       or (v-empty-mode = 2 and (v-tag-value <> "":U and v-tag-value <> ? and v-tag-value <> "0":U))
     2028       or (v-empty-mode = 3 and (v-tag-value <> "":U and v-tag-value <> ? and caps(v-tag-value) <> "no":U))
     2029       then do:
     2030           run xmlchar-encode in this-procedure (
     2031                 input v-tag-value
     2032               , output v-tag-value
     2033           ).
     2034           put stream stmXMLOut unformatted
     2035               substitute( "&1&2<&3>&4</&3>"
     2036                   , chr(10)
     2037                   , fill(" ":U, 4 * v-tag-level)
     2038                   , v-tag-name
     2039                   , v-tag-value
     2040               )
     2041           .
     2042       end.
     2043   end.
     2044   end procedure.
     2045   procedure xmllib-tag-put-null :
     2046   define input parameter p-tag-level  as integer      no-undo.
     2047   define input parameter p-tag-name   as character    no-undo.
     2048   do
     2049   on error undo, return error
     2050   :
     2051       assign
     2052           p-tag-name = trim( p-tag-name )
     2053       .
     2054       put stream stmXMLOut unformatted
     2055           substitute( '&1&2<&3 nil="true" /&3>'
     2056               , chr(10)
     2057               , fill(" ":U, 4 * p-tag-level)
     2058               , p-tag-name
     2059           )
     2060       .
     2061   end.
     2062   end procedure.
     2063   procedure xmllib-tag-close:
     2064   define input parameter v-tag-level as integer      no-undo.
     2065   define input parameter v-tag-name  as character    no-undo.
     2066   do
     2067   on error undo, return error
     2068   :
     2069       assign
     2070           v-tag-name = trim( v-tag-name )
     2071       .
     2072       put stream stmXMLOut unformatted
     2073           substitute( "&1&2</&3>"
     2074               , chr(10)
     2075               , fill( " ":U, 4 * v-tag-level)
     2076               , v-tag-name
     2077           )
     2078       .
     2079   end.
     2080   end procedure.
     2081   procedure xmllib-write-log:
     2082   define input parameter v-filename   as character    no-undo.
     2083   define input parameter v-log-level  as integer      no-undo.
     2084   define input parameter v-out-string as character    no-undo.
     2085   do
     2086   on error undo, return error
     2087   :
     2088       output stream stmXMLLog to value( v-filename ) append.
     2089       put stream stmXMLLog unformatted
     2090           chr(10)
     2091       .
     2092       put stream stmXMLLog unformatted
     2093           ( if v-log-level = 0
     2094             or v-out-string = "&DLine":U
     2095             or v-out-string = "&Line":U
     2096             then "":U
     2097             else cur-time-string-sec() + " ":U )
     2098       .
     2099       put stream stmXMLLog unformatted
     2100           ( if v-out-string = "&Line":U
     2101             then fill( "-":U, 80 )
     2102             else if v-out-string = "&DLine":U
     2103                  then fill( "=":U, 80 )
     2104                  else v-out-string )
     2105       .
     2106       output stream stmXMLLog close.
     2107   end.
     2108   end procedure.
     2109   procedure xmllib-write-edt:
     2110   define input parameter v-editor-handle    as handle       no-undo.
     2111   define input parameter v-log-level        as integer      no-undo.
     2112   define input parameter v-out-string       as character    no-undo.
     2113   do
     2114   on error undo, return error
     2115   :
     2116       if valid-handle ( v-editor-handle )
     2117       then do:
     2118           v-editor-handle :move-to-eof().
     2119           v-editor-handle :insert-string( ( if v-log-level = 0
     2120                                             or v-out-string = "&DLine":U
     2121                                             or v-out-string = "&Line":U
     2122                                             then "":U
     2123                                             else cur-time-string-sec() + " ":U
     2124                                         ) ).
     2125           v-editor-handle :insert-string( ( if v-out-string = "&Line":U
     2126                                             then fill( "-":U, 80 )
     2127                                             else if v-out-string = "&DLine":U then fill("=":U, 80)
     2128                                             else fill( " ":U, v-log-level) + v-out-string
     2129                                         ) ).
     2130           v-editor-handle :insert-string( chr(10) ).
     2131       end.
     2132   end.
     2133   end procedure.
     2134   procedure xmllib-show-cnt:
     2135   define input parameter v-fillin-handle     as handle   no-undo.
     2136   do
     2137   on error undo, return error
     2138   :
     2139       if valid-handle( v-fillin-handle )
     2140       then do:
     2141           assign
     2142               v-fillin-handle :visible = true
     2143           .
     2144       end.
     2145   end.
     2146   end procedure.
     2147   procedure xmllib-hide-cnt:
     2148   define input parameter v-fillin-handle     as handle   no-undo.
     2149   do
     2150   on error undo, return error
     2151   :
     2152       if valid-handle( v-fillin-handle )
     2153       then do:
     2154           assign v-fillin-handle :visible = false.
     2155       end.
     2156   end.
     2157   end procedure.
     2158   procedure xmllib-write-cnt:
     2159   define input parameter v-fillin-handle    as handle       no-undo.
     2160   define input parameter v-fillin-string    as character    no-undo.
     2161   do
     2162   on error undo, return error
     2163   :
     2164       if valid-handle( v-fillin-handle )
     2165       then do:
     2166           assign
     2167               v-fillin-handle :SCREEN-value = v-fillin-string
     2168           .
     2169       end.
     2170   end.
     2171   end procedure.
     2172   procedure xmllib-write-header:
     2173   define input parameter p-first-file     as logical      no-undo.
     2174   define input parameter p-xml-file-name  as character    no-undo.
     2175   define input parameter p-list-file-name as character    no-undo.
     2176   define input parameter p-file-number    as integer      no-undo.
     2177   define input parameter p-have-prev      as logical      no-undo.
     2178   define input parameter p-prev-filename  as character    no-undo.
     2179   define input parameter p-parameter-list as character    no-undo.
     2180       define variable v-counter    as integer        no-undo.
     2181   do
     2182   on error undo, return error
     2183   :
     2184       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2185       put stream stmXMLOut unformatted
     2186           "<?xml version='1.0' encoding='windows-1251'?>"
     2187       .
     2188       run xmllib-tag-open( input 0, input "root"          , input "":U ).
     2189       run xmllib-tag-open( input 0, input "THheader"        , input "":U ).
     2190       run xmllib-tag-put( input 1 , input "THfileName"      , input p-xml-file-name + "xml":U  , input 0 ).
     2191       run xmllib-tag-put( input 1 , input "THfileNumber"    , input string( p-file-number     ), input 0 ).
     2192       run xmllib-tag-put( input 1 , input "THhavePrev"      , input string( p-have-prev       ), input 3 ).
     2193       run xmllib-tag-put( input 1 , input "THprevFileName"  , input p-prev-filename            , input 0 ).
     2194       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2195       :
     2196           run xmllib-tag-put(
     2197                 input 1
     2198               , input entry( 2 * v-counter, p-parameter-list )
     2199               , input entry( 2 * v-counter + 1, p-parameter-list )
     2200               , input 0
     2201           ).
     2202       end.
     2203       run xmllib-tag-close( input 0, input "THheader" ).
     2204       output stream stmXMLOut close.
     2205       if p-list-file-name <> "":U
     2206       then do:
     2207           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2208           if p-first-file = yes
     2209           then do:
     2210               put stream stmXMLOut unformatted
     2211                   "<?xml version='1.0' encoding='windows-1251'?>"
     2212               .
     2213               run xmllib-tag-open( input 0, input "OpenXML", input "" ).
     2214           end.
     2215           run xmllib-tag-open( input 1, input "THfile", input "" ).
     2216           run xmllib-tag-put( input 2, input "THfileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2217           run xmllib-tag-put( input 2, input "THfileNumber"     , input string( p-file-number     ), input 0 ).
     2218           run xmllib-tag-put( input 2, input "THhavePrev"       , input string( p-have-prev       ), input 3 ).
     2219           run xmllib-tag-put( input 2, input "THprevFileName"   , input p-prev-filename            , input 0 ).
     2220           do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2221           :
     2222               run xmllib-tag-put(
     2223                   input 2
     2224                   , input entry( 2 * v-counter, p-parameter-list )
     2225                   , input entry( 2 * v-counter + 1, p-parameter-list )
     2226                   , input 0
     2227               ).
     2228           end.
     2229           run xmllib-tag-close( input 1, input "THfile" ).
     2230           output stream stmXMLOut close.
     2231       end.
     2232   end.
     2233   end procedure.
     2234   procedure xmllib-write-footer:
     2235   define input parameter p-last-file      as logical      no-undo.
     2236   define input parameter p-xml-file-name  as character    no-undo.
     2237   define input parameter p-list-file-name as character    no-undo.
     2238   define input parameter p-have-next      as logical      no-undo.
     2239   define input parameter p-next-file-name as character    no-undo.
     2240       define variable v-error-num     as integer           no-undo.
     2241   do
     2242   on error undo, return error
     2243   :
     2244       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2245       if p-have-next = yes
     2246       then do:
     2247           run xmllib-tag-open( input 0, input "footer", "" ).
     2248           run xmllib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2249           run xmllib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2250           run xmllib-tag-close( input 0, input "footer" ).
     2251       end.
     2252       run xmllib-tag-close( input 0, input "root" ).
     2253       output stream stmXMLOut close.
     2254       run bge/os_copy.p (
     2255             input "M"
     2256           , input p-xml-file-name + "tmp"
     2257           , input p-xml-file-name + "xml"
     2258           , output v-error-num
     2259       ).
     2260       if p-last-file = yes
     2261       and p-list-file-name <> "":U
     2262       then do:
     2263           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2264               run xmllib-tag-close( input 0, input "OpenXML" ).
     2265           output stream stmXMLOut close.
     2266           run bge/os_copy.p (
     2267                 input "M"
     2268               , input p-list-file-name + "tmp"
     2269               , input p-list-file-name + "xml":U
     2270               , output v-error-num
     2271           ).
     2272       end.
     2273   end.
     2274   end procedure.
     2275   procedure xmllib-filename :
     2276   define input parameter p-subdir             as character        no-undo.
     2277   define input parameter p-prefix             as character    no-undo.
     2278   define output parameter p-xml-file-name     as character    no-undo.
     2279   define output parameter p-log-file-name     as character    no-undo.
     2280   define output parameter p-list-file-name    as character    no-undo.
     2281       define variable v-home-dir  as character    no-undo.
     2282       define variable v-error-num as integer      no-undo.
     2283   do
     2284   on error undo, return error
     2285   :
     2286       get-key-value section "OXML" key "oxml-dir" value v-home-dir.
     2287       if v-home-dir = ?
     2288       then do:
     2289           message
     2290             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2291             skip "Нет параметра oxml-dir в секции [OXML]."
     2292             skip(1)
     2293             skip "Обратитесь к администратору."
     2294           view-as alert-box error.
     2295           undo, return error .
     2296       end.
     2297       if p-subdir <> "":U
     2298       then do:
     2299           assign
     2300               v-home-dir = substitute( "&1/out/&2", v-home-dir, p-subdir )
     2301           .
     2302       end.
     2303       run gbl/dir-cre.p (
     2304           input v-home-dir
     2305       ) no-error.
     2306       if error-status :error
     2307       then do:
     2308           message
     2309             skip "Неверно задан каталог экспорта в ini-файле."
     2310             skip "Не удаётся создать каталог, указанный параметром"
     2311             skip "oxml-dir в секции [OXML]."
     2312             skip(1)
     2313             skip "Обратитесь к администратору."
     2314           view-as alert-box error.
     2315           undo, return error .
     2316       end.
     2317       run bge/genfname.p (
     2318             input v-home-dir
     2319           , input p-prefix
     2320           , input ""
     2321           , input "xml"
     2322           , input "tmp"
     2323           , output p-xml-file-name
     2324       ).
     2325       assign
     2326           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2327           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2328           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2329       .
     2330   end.
     2331   end procedure.
     2332   procedure xmllib-check-file-size :
     2333   define input parameter p-out-filename   as character    no-undo.
     2334   define output parameter p-is-big        as logical      no-undo.
     2335       define variable v-current-position    as integer        no-undo.
     2336   do
     2337   on error undo, return error
     2338   :
     2339       assign
     2340           v-current-position = seek( stmXMLOut )
     2341       .
     2342       if v-current-position / 1024 / 1024  >= 100
     2343       then do:
     2344           assign
     2345               p-is-big = yes
     2346           .
     2347       end.
     2348   end.
     2349   end procedure.
     2350   procedure xmllib-parse-file :
     2351   define input parameter p-full-filename      as character        no-undo.
     2352       define variable v-num-dirs              as integer      no-undo .
     2353       define variable v-str                   as character    no-undo .
     2354       define variable v-str-count             as int64        no-undo .
     2355   do
     2356   on error undo, return error
     2357   :
     2358       assign
     2359           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     2360           v-xmllib-error-status   = no
     2361       .
     2362       if v-num-dirs > 1
     2363       then do:
     2364           assign
     2365               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     2366               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     2367           .
     2368       end.
     2369       else do:
     2370           assign
     2371               v-xmllib-filename = p-full-filename
     2372               v-xmllib-dirname  = "":U
     2373           .
     2374       end.
     2375       if valid-handle(v-xmllib-prg-bar-handle)
     2376       then do:
     2377   if session :set-wait-state( "compiler" ) then.
     2378         input stream strXMLIn from value(p-full-filename) .
     2379         repeat
     2380         :
     2381           import stream strXMLIn unformatted v-str no-error .
     2382           assign
     2383             v-str-count = v-str-count + 1
     2384           .
     2385         end.
     2386         input stream strXMLIn close .
     2387   if session :set-wait-state( "" ) then.
     2388         run prg-bar_init-cb-handle in this-procedure ( input v-xmllib-prg-bar-handle ) .
     2389         run prg-bar_new in this-procedure ( input 1 , input v-str-count) .
     2390         run prg-bar_show in this-procedure .
     2391       end.
     2392       create sax-reader v-xmllib-sax-reader-handle.
     2393       v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ).
     2394       v-xmllib-sax-reader-handle :sax-parse( ) no-error.
     2395       if error-status :error
     2396       then do:
     2397           run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2398                                                                       ,vss-workfile
     2399                                                                       ,vss-revision
     2400                                                                       ,vss-description
     2401                                                                       ,chr(10)
     2402                                                                       ,return-value
     2403                                                                       ,trim(error-status :get-message(1))
     2404                                                                       ,trim(error-status :get-message(2))
     2405                                                                       ,trim(error-status :get-message(3)))
     2406                                                     ).
     2407           undo, return error .
     2408       end.
     2409       if v-xmllib-error-status <> no
     2410       then do:
     2411           run xmllib-parse-error in this-procedure (
     2412               input "*** При обработке XML файла были ошибки."
     2413           ).
     2414           delete object v-xmllib-sax-reader-handle.
     2415       end.
     2416       delete object v-xmllib-sax-reader-handle.
     2417       if valid-handle(v-xmllib-prg-bar-handle)
     2418       then do:
     2419         run prg-bar_delete in this-procedure .
     2420       end.
     2421   end.
     2422   end procedure.
     2423   procedure xmllib-parse-progressive :
     2424   define input parameter p-full-filename      as character no-undo .
     2425   define input parameter p-pack-data          as memptr no-undo .
     2426   define input parameter p-parse-first        as logical no-undo .
     2427   define input parameter p-first-err          as logical no-undo .
     2428   define output parameter p-parse-status as integer no-undo .
     2429   define variable v-num-dirs              as integer no-undo .
     2430   define variable glog                    as logical no-undo .
     2431   define variable v-pack-size             as int64 no-undo .
     2432   do
     2433   on error undo, return error
     2434   :
     2435     if p-parse-first then do:
     2436       if valid-handle(v-xmllib-sax-reader-handle)
     2437       then do:
     2438       end.
     2439       assign
     2440           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     2441           v-xmllib-error-status   = no
     2442       .
     2443       if v-num-dirs > 1
     2444       then do:
     2445           assign
     2446               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     2447               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     2448           .
     2449       end.
     2450       else do:
     2451           assign
     2452               v-xmllib-filename = p-full-filename
     2453               v-xmllib-dirname  = "":U
     2454           .
     2455       end.
     2456       create sax-reader v-xmllib-sax-reader-handle.
     2457       v-pack-size = get-size (p-pack-data) .
     2458       if v-pack-size > 0 then
     2459         glog = v-xmllib-sax-reader-handle :set-input-source( "MEMPTR":U, p-pack-data ) no-error.
     2460       else
     2461         glog = v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ) no-error.
     2462       if error-status :error
     2463       or not glog
     2464       then do:
     2465         delete object v-xmllib-sax-reader-handle.
     2466         run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2467                                                                     ,vss-workfile
     2468                                                                     ,vss-revision
     2469                                                                     ,vss-description
     2470                                                                     ,chr(10)
     2471                                                                     ,return-value
     2472                                                                     ,trim(error-status :get-message(1))
     2473                                                                     ,trim(error-status :get-message(2))
     2474                                                                     ,trim(error-status :get-message(3)) )
     2475                                                   ).
     2476         undo, return error .
     2477       end.
     2478       v-xmllib-sax-reader-handle :sax-parse-first( ) no-error.
     2479     end.
     2480     else do:
     2481       v-xmllib-sax-reader-handle :sax-parse-next( ) no-error.
     2482     end.
     2483     if error-status :error
     2484     then do:
     2485       delete object v-xmllib-sax-reader-handle.
     2486       run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     2487                                                                   ,vss-workfile
     2488                                                                   ,vss-revision
     2489                                                                   ,vss-description
     2490                                                                   ,chr(10)
     2491                                                                   ,return-value
     2492                                                                   ,trim(error-status :get-message(1))
     2493                                                                   ,trim(error-status :get-message(2))
     2494                                                                   ,trim(error-status :get-message(3)) )
     2495                                                 ).
     2496       undo, return error .
     2497     end.
     2498     if v-xmllib-error-status <> no
     2499     then do:
     2500       run xmllib-parse-error in this-procedure (
     2501           input "*** При обработке XML файла были ошибки."
     2502       ).
     2503       if p-first-err then do:
     2504         delete object v-xmllib-sax-reader-handle.
     2505       end.
     2506       else do:
     2507         v-xmllib-error-status = no.
     2508       end.
     2509     end.
     2510     if v-xmllib-sax-reader-handle:parse-status = SAX-COMPLETE  then do:
     2511       p-parse-status = SAX-COMPLETE.
     2512       delete object v-xmllib-sax-reader-handle.
     2513       return '':U.
     2514     end.
     2515     else do:
     2516       p-parse-status = v-xmllib-sax-reader-handle:parse-status.
     2517       return '':U.
     2518     end.
     2519   end.
     2520   end procedure.
     2521   procedure StartElement :
     2522   define input parameter p-name-space     as character        no-undo.
     2523   define input parameter p-local-name     as character        no-undo.
     2524   define input parameter p-q-name         as character        no-undo.
     2525   define input parameter p-attributes     as handle           no-undo.
     2526       define buffer buf_rec             for temp_xmllib_rec.
     2527       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     2528       define buffer buf_rec-list        for temp_xmllib_rec-list.
     2529       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     2530   do
     2531   for buf_rec
     2532     , buf_rec-fld
     2533     , buf_rec-list
     2534     , buf_rec-fld-list
     2535   on error undo, return error
     2536   :
     2537       if valid-handle(v-xmllib-prg-bar-handle)
     2538       then do:
     2539         run prg-bar_stepto in this-procedure ( input SELF:LOCATOR-LINE-NUMBER ) .
     2540       end.
     2541       find first buf_rec-list
     2542            where buf_rec-list.recName = p-q-name
     2543       no-error.
     2544       if available buf_rec-list
     2545       then do:
     2546           if buf_rec-list.closed = no
     2547           then do:
     2548               find first buf_rec-fld-list
     2549                    where buf_rec-fld-list.recName = buf_rec-list.recName
     2550                      and buf_rec-fld-list.fldName = p-q-name
     2551               no-error.
     2552               if available buf_rec-fld-list
     2553               and buf_rec-list.recName = buf_rec-fld-list.recName
     2554               then do:
     2555                   if buf_rec-fld-list.closed = no
     2556                   then do:
     2557                       run xmllib-parse-error in this-procedure (
     2558                           input substitute( "Ошибка 1 открытия поля <&1> записи <&2>: Поле с этим именем уже открыто на строке &3."
     2559                                           , p-q-name
     2560                                           , p-q-name
     2561                                           , buf_rec-fld-list.fldOpenLine
     2562                                           )
     2563                       ).
     2564                   end.
     2565                   else do:
     2566                       run xmllib-parse-rec-fld-open in this-procedure (
     2567                             input buf_rec-list.recName
     2568                           , input buf_rec-list.recLevel
     2569                           , input buf_rec-fld-list.fldName
     2570                       ).
     2571                       assign
     2572                           buf_rec-fld-list.closed         = no
     2573                           buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2574                           buf_rec-fld-list.fldCloseLine   = 0
     2575                       .
     2576                   end.
     2577               end.
     2578               else do:
     2579                   assign
     2580                       buf_rec-list.recLevel = buf_rec-list.recLevel + 1
     2581                   .
     2582                   run xmllib-parse-rec-open in this-procedure (
     2583                         input buf_rec-list.recName
     2584                       , input buf_rec-list.recLevel
     2585                   ).
     2586                   assign
     2587                       buf_rec-list.closed         = no
     2588                       buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2589                       buf_rec-list.recCloseLine   = 0
     2590                   .
     2591               end.
     2592           end.
     2593           else do:
     2594               run xmllib-parse-rec-open in this-procedure (
     2595                     input buf_rec-list.recName
     2596                   , input buf_rec-list.recLevel
     2597               ).
     2598               assign
     2599                   buf_rec-list.closed         = no
     2600                   buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2601                   buf_rec-list.recCloseLine   = 0
     2602               .
     2603           end.
     2604       end.
     2605       else do:
     2606           open-record:
     2607           for each buf_rec-fld-list
     2608              where buf_rec-fld-list.fldName = p-q-name
     2609           :
     2610               find first buf_rec-list
     2611                    where buf_rec-list.recName = buf_rec-fld-list.recName
     2612                      and buf_rec-list.closed  = no
     2613               no-error.
     2614               if available buf_rec-list
     2615               then do:
     2616                   run xmllib-parse-rec-fld-open in this-procedure (
     2617                         input buf_rec-list.recName
     2618                       , input buf_rec-list.recLevel
     2619                       , input buf_rec-fld-list.fldName
     2620                   ).
     2621                   assign
     2622                       buf_rec-fld-list.recLevel       = buf_rec-list.recLevel
     2623                       buf_rec-fld-list.closed         = no
     2624                       buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     2625                       buf_rec-fld-list.fldCloseLine   = 0
     2626                   .
     2627                   leave open-record.
     2628               end.
     2629           end.
     2630       end.
     2631   end.
     2632   end procedure.
     2633   procedure Characters :
     2634   define input parameter p-char-data  as memptr.
     2635   define input parameter p-numchars   as integer.
     2636       define variable v-data-string    as character    no-undo.
     2637       define variable v-cp-utf8           as integer no-undo init 65001 .
     2638       define variable v-cp-windows1251    as integer no-undo init 1251 .
     2639       define buffer buf_xmllib_rec             for temp_xmllib_rec.
     2640       define buffer buf_xmllib_rec-fld         for temp_xmllib_rec-fld.
     2641       define buffer buf_xmllib_rec-list        for temp_xmllib_rec-list.
     2642       define buffer buf_xmllib_rec-fld-list    for temp_xmllib_rec-fld-list.
     2643   do
     2644   for buf_xmllib_rec
     2645     , buf_xmllib_rec-fld
     2646     , buf_xmllib_rec-list
     2647     , buf_xmllib_rec-fld-list
     2648   on error undo, return error
     2649   :
     2650       find first buf_xmllib_rec-list
     2651            where buf_xmllib_rec-list.closed = no
     2652       no-error.
     2653       if available buf_xmllib_rec-list
     2654       then do:
     2655           find first buf_xmllib_rec-fld-list
     2656                where buf_xmllib_rec-fld-list.closed = no
     2657           no-error.
     2658           if available buf_xmllib_rec-fld-list
     2659           and buf_xmllib_rec-fld-list.recName  = buf_xmllib_rec-list.recName
     2660           and buf_xmllib_rec-fld-list.recLevel = buf_xmllib_rec-list.recLevel
     2661           then do:
     2662               find last buf_xmllib_rec
     2663                   where buf_xmllib_rec.recName  = buf_xmllib_rec-list.recName
     2664                     and buf_xmllib_rec.recLevel = buf_xmllib_rec-list.recLevel
     2665                     and buf_xmllib_rec.closed   = no
     2666               use-index nm
     2667               no-error.
     2668               if available buf_xmllib_rec
     2669               then do:
     2670                   find last buf_xmllib_rec-fld
     2671                       where buf_xmllib_rec-fld.rec-key = buf_xmllib_rec.rec-key
     2672                         and buf_xmllib_rec-fld.fldName = buf_xmllib_rec-fld-list.fldName
     2673                         and buf_xmllib_rec-fld.closed = no
     2674                   use-index nm
     2675                   no-error.
     2676                   if available buf_xmllib_rec-fld
     2677                   then do:
     2678                       assign
     2679                           v-data-string = get-string( p-char-data, 1, get-size( p-char-data ) )
     2680                       .
     2681                       if v-xmllib-codepage-convert = yes
     2682                       then do:
     2683                         assign
     2684                             v-data-string = codepage-convert( v-data-string , v-xmllib-codepage-target , v-xmllib-codepage-source )
     2685                         .
     2686                       end.
     2687                       run xmlchar-decode in this-procedure (
     2688                           input v-data-string
     2689                           , output v-data-string
     2690                       ).
     2691                       assign
     2692                           buf_xmllib_rec-fld.fldValue = trim( substitute( "&1&2", buf_xmllib_rec-fld.fldValue, v-data-string ) )
     2693                       .
     2694                   end.
     2695               end.
     2696           end.
     2697       end.
     2698   end.
     2699   end procedure.
     2700   procedure EndElement :
     2701   define input parameter p-name-space     as character        no-undo.
     2702   define input parameter p-local-name     as character        no-undo.
     2703   define input parameter p-q-name         as character        no-undo.
     2704       define buffer buf_rec             for temp_xmllib_rec.
     2705       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     2706       define buffer buf_rec-list        for temp_xmllib_rec-list.
     2707       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     2708   do
     2709   for buf_rec
     2710     , buf_rec-fld
     2711     , buf_rec-list
     2712     , buf_rec-fld-list
     2713   on error undo, return error
     2714   :
     2715       find last buf_rec-list
     2716           where buf_rec-list.recName = p-q-name
     2717       use-index pi
     2718       no-error.
     2719       if available buf_rec-list
     2720       then do:
     2721           if buf_rec-list.closed = yes
     2722           then do:
     2723               run xmllib-parse-error in this-procedure (
     2724                   input substitute( "Ошибка закрытия записи или поля <&1>: Нет метки открытой записи."
     2725                                   , p-q-name
     2726                                   )
     2727               ).
     2728           end.
     2729           else do:
     2730               find last buf_rec
     2731                   where buf_rec.recName  = buf_rec-list.recName
     2732                     and buf_rec.recLevel = buf_rec-list.recLevel
     2733                     and buf_rec.closed   = no
     2734               use-index nm
     2735               no-error.
     2736               if not available buf_rec
     2737               then do:
     2738                   run xmllib-parse-error in this-procedure (
     2739                       input substitute( "Ошибка закрытия записи или поля <&1> уровня &2: Нет открытой записи."
     2740                                       , p-q-name
     2741                                       , buf_rec-list.recLevel
     2742                                       )
     2743                   ).
     2744               end.
     2745               else do:
     2746                   find first buf_rec-fld-list
     2747                        where buf_rec-fld-list.recName  = buf_rec.recName
     2748                          and buf_rec-fld-list.recLevel = buf_rec.recLevel
     2749                          and buf_rec-fld-list.fldName  = p-q-name
     2750                          and buf_rec-fld-list.closed   = no
     2751                   no-error.
     2752                   if not available buf_rec-fld-list
     2753                   then do:
     2754                       if buf_rec.recName <> p-q-name
     2755                       then do:
     2756                           run xmllib-parse-error in this-procedure (
     2757                               input substitute( "Ошибка закрытия записи <&1>: Имя открытой записи не совпадает с именем метки."
     2758                                               , buf_rec.recName
     2759                                               )
     2760                           ).
     2761                       end.
     2762                       else do:
     2763                           assign
     2764                               buf_rec.closed              = yes
     2765                               buf_rec.recCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     2766                               buf_rec-list.recCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     2767                           .
     2768                           if buf_rec-list.recLevel > 0
     2769                           then do:
     2770                               assign
     2771                                   buf_rec-list.recLevel = buf_rec-list.recLevel - 1
     2772                               .
     2773                               for each buf_rec-fld-list
     2774                                  where buf_rec-fld-list.recName = buf_rec-list.recName
     2775                               :
     2776                                   assign
     2777                                       buf_rec-fld-list.recLevel = buf_rec-fld-list.recLevel - 1
     2778                                   .
     2779                               end.
     2780                           end.
     2781                           else do:
     2782                               assign
     2783                                   buf_rec-list.closed         = yes
     2784                               .
     2785                           end.
     2786                       end.
     2787                   end.
     2788                   else do:
     2789                       find last buf_rec-fld
     2790                           where buf_rec-fld.rec-key = buf_rec.rec-key
     2791                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     2792                             and buf_rec-fld.closed  = no
     2793                       use-index nm
     2794                       no-error.
     2795                       if not available buf_rec-fld
     2796                       then do:
     2797                           run xmllib-parse-error in this-procedure (
     2798                               input substitute( "Ошибка 2 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     2799                                               , buf_rec-fld-list.fldName
     2800                                               , buf_rec.recName
     2801                                               , buf_rec.recLevel
     2802                                               )
     2803                           ).
     2804                       end.
     2805                       else do:
     2806                           assign
     2807                               buf_rec-fld.closed              = yes
     2808                               buf_rec-fld-list.closed         = yes
     2809                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     2810                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     2811                           .
     2812                       end.
     2813                   end.
     2814               end.
     2815           end.
     2816       end.
     2817       else do:
     2818           close-field-rec:
     2819           for each buf_rec-fld-list
     2820              where buf_rec-fld-list.fldName = p-q-name
     2821           :
     2822               find first buf_rec-list
     2823                    where buf_rec-list.recName  = buf_rec-fld-list.recName
     2824                      and buf_rec-list.recLevel = buf_rec-fld-list.recLevel
     2825                      and buf_rec-list.closed   = no
     2826               no-error.
     2827               if available buf_rec-list
     2828               then do:
     2829                   find last buf_rec
     2830                       where buf_rec.recName  = buf_rec-list.recName
     2831                         and buf_rec.recLevel = buf_rec-list.recLevel
     2832                         and buf_rec.closed   = no
     2833                   use-index nm
     2834                   no-error.
     2835                   if not available buf_rec
     2836                   then do:
     2837                       run xmllib-parse-error in this-procedure (
     2838                           input substitute( "Ошибка закрытия поля <&1>: Нет открытой записи."
     2839                                           , p-q-name
     2840                                           )
     2841                       ).
     2842                   end.
     2843                   else do:
     2844                       find last buf_rec-fld
     2845                           where buf_rec-fld.rec-key = buf_rec.rec-key
     2846                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     2847                             and buf_rec-fld.closed  = no
     2848                       use-index nm
     2849                       no-error.
     2850                       if not available buf_rec-fld
     2851                       then do:
     2852                           run xmllib-parse-error in this-procedure (
     2853                               input substitute( "Ошибка 1 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     2854                                               , buf_rec-fld-list.fldName
     2855                                               , buf_rec.recName
     2856                                               , buf_rec.recLevel
     2857                                               )
     2858                           ).
     2859                       end.
     2860                       else do:
     2861                           assign
     2862                               buf_rec-fld.closed              = yes
     2863                               buf_rec-fld-list.closed         = yes
     2864                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     2865                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     2866                           .
     2867                       end.
     2868                   end.
     2869                   leave close-field-rec.
     2870               end.
     2871           end.
     2872       end.
     2873   end.
     2874   end procedure.
     2875   procedure Error :
     2876   define input parameter p-error-message     as character        no-undo.
     2877   do
     2878   on error undo, return error
     2879   :
     2880       run xmllib-parse-error in this-procedure (
     2881           input p-error-message
     2882       ).
     2883       assign
     2884           v-xmllib-error-status = yes
     2885       .
     2886   end.
     2887   end procedure.
     2888   procedure xmllib-parse-error :
     2889   define input parameter p-err-message    as character        no-undo.
     2890   do
     2891   on error undo, return error
     2892   :
     2893       if valid-handle(v-xmllib-log-handle) then do:
     2894         run value(v-xmllib-log-proc-name) in  v-xmllib-log-handle
     2895                  (input substitute("&1Файл:    &2 &3&1Строка &4&1&5"
     2896                                    ,chr(10)
     2897                                    ,v-xmllib-dirname
     2898                                    ,v-xmllib-filename
     2899                                    ,(if valid-handle(v-xmllib-sax-reader-handle)
     2900                                      then v-xmllib-sax-reader-handle :locator-line-number
     2901                                      else ?)
     2902                                    ,p-err-message)).
     2903       end.
     2904       else do:
     2905         if v-xmllib-log-filename = "":U
     2906         then do:
     2907             message
     2908                     vss-workfile vss-revision vss-description
     2909                 skip "Файл:   " v-xmllib-dirname v-xmllib-filename
     2910                 skip "Строка: " (if valid-handle(v-xmllib-sax-reader-handle)
     2911                                  then v-xmllib-sax-reader-handle :locator-line-number
     2912                                  else ?)
     2913                 skip(1)
     2914                 skip p-err-message
     2915                 skip return-value
     2916                 skip trim( error-status :get-message( 1 ) )
     2917                     trim( error-status :get-message( 2 ) )
     2918                     trim( error-status :get-message( 3 ) )
     2919             view-as alert-box error.
     2920             undo, return error.
     2921         end.
     2922         else do:
     2923           output to value( v-xmllib-log-filename ).
     2924           put unformatted
     2925               substitute( "&1&2", chr(10), p-err-message )
     2926           .
     2927           output close.
     2928         end.
     2929       end.
     2930   end.
     2931   end procedure.
     2932   procedure xmllib-set-log-filename :
     2933   define input parameter p-log-filename   as character        no-undo.
     2934   do
     2935   on error undo, return error
     2936   :
     2937       run gbl/fileapnd.p (
     2938             input p-log-filename
     2939           , input "":U
     2940           , input 10
     2941       ) no-error.
     2942       if error-status :error
     2943       then do:
     2944           assign
     2945               v-xmllib-log-filename = "":U
     2946           .
     2947       end.
     2948       else do:
     2949           assign
     2950               v-xmllib-log-filename = p-log-filename
     2951           .
     2952       end.
     2953   end.
     2954   end procedure.
     2955   procedure xmllib-set-log-handle :
     2956   define input parameter p-log-handle    as handle        no-undo.
     2957   define input parameter p-log-proc-name as character no-undo .
     2958   do
     2959   on error undo, return error
     2960   :
     2961       if valid-handle(p-log-handle)
     2962       and lookup(p-log-proc-name, p-log-handle:internal-entries) > 0
     2963       then do:
     2964         assign
     2965         v-xmllib-log-handle    = p-log-handle
     2966         v-xmllib-log-proc-name = p-log-proc-name
     2967         .
     2968       end.
     2969       else do:
     2970         assign
     2971         v-xmllib-log-handle    = ?
     2972         v-xmllib-log-proc-name = '':U
     2973         .
     2974       end.
     2975   end.
     2976   end procedure.
     2977   procedure xmllib-set-prg-bar-handle :
     2978   define input parameter p-handle    as handle        no-undo.
     2979   do
     2980   on error undo, return error
     2981   :
     2982       if valid-handle(p-handle)
     2983       then do:
     2984         assign
     2985           v-xmllib-prg-bar-handle = p-handle
     2986         .
     2987       end.
     2988       else do:
     2989         assign
     2990           v-xmllib-prg-bar-handle = ?
     2991         .
     2992       end.
     2993   end.
     2994   end procedure.
     2995   procedure xmllib-set-codepage-convert :
     2996     define input  parameter p-codepage-source as character no-undo .
     2997     define input  parameter p-codepage-target as character no-undo .
     2998   do
     2999   on error undo, return error return-value
     3000   :
     3001     if ( p-codepage-source <> "" and p-codepage-target <> "" )
     3002     then do:
     3003       assign
     3004         v-xmllib-codepage-convert = yes
     3005         v-xmllib-codepage-source  = p-codepage-source
     3006         v-xmllib-codepage-target  = p-codepage-target
     3007       .
     3008     end.
     3009     else do:
     3010       assign
     3011         v-xmllib-codepage-convert = no
     3012         v-xmllib-codepage-source  = ""
     3013         v-xmllib-codepage-target  = ""
     3014       .
     3015     end.
     3016   end.
     3017   end procedure.
     3018   procedure xmllib-parse-rec-open :
     3019   define input parameter p-rec-name   as character        no-undo.
     3020   define input parameter p-rec-level  as integer          no-undo.
     3021       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     3022   do
     3023   for buf_temp_xmllib_rec
     3024   on error undo, return error
     3025   :
     3026        find first buf_temp_xmllib_rec
     3027            where buf_temp_xmllib_rec.recName = p-rec-name
     3028              and buf_temp_xmllib_rec.recLevel = p-rec-level
     3029              and buf_temp_xmllib_rec.closed  = no
     3030       use-index nm
     3031       no-error.
     3032       if available buf_temp_xmllib_rec
     3033       then do:
     3034           run xmllib-parse-error in this-procedure (
     3035               input substitute( "Ошибка 2 открытия записи <&1>: Запись с этим именем и уровнем &2 уже открыта на строке &3."
     3036                               , p-rec-name
     3037                               , p-rec-level
     3038                               , buf_temp_xmllib_rec.recOpenLine
     3039                               )
     3040           ).
     3041       end.
     3042       else do:
     3043           assign
     3044               v-xmllib-rec-key    = v-xmllib-rec-key + 1
     3045           .
     3046           create buf_temp_xmllib_rec.
     3047           assign
     3048               buf_temp_xmllib_rec.rec-key         = v-xmllib-rec-key
     3049               buf_temp_xmllib_rec.recOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     3050               buf_temp_xmllib_rec.recCloseLine    = 0
     3051               buf_temp_xmllib_rec.recName         = p-rec-name
     3052               buf_temp_xmllib_rec.recLevel        = p-rec-level
     3053               buf_temp_xmllib_rec.closed          = no
     3054           .
     3055       end.
     3056   end.
     3057   end procedure.
     3058   procedure xmllib-parse-rec-fld-open :
     3059   define input parameter p-rec-name   as character        no-undo.
     3060   define input parameter p-rec-level  as integer          no-undo.
     3061   define input parameter p-fld-name   as character        no-undo.
     3062       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     3063       define buffer buf_temp_xmllib_rec-fld   for temp_xmllib_rec-fld.
     3064   do
     3065   for buf_temp_xmllib_rec
     3066     , buf_temp_xmllib_rec-fld
     3067   on error undo, return error substitute( "Ошибка в xmllib-parse-rec-fld-open. &1. &2. &3"
     3068                                           , return-value
     3069                                           , trim( error-status :get-message( 1 ) )
     3070                                           , trim( error-status :get-message( 2 ) ) )
     3071   :
     3072       find last buf_temp_xmllib_rec
     3073           where buf_temp_xmllib_rec.recName   = p-rec-name
     3074             and buf_temp_xmllib_rec.recLevel  = p-rec-level
     3075             and buf_temp_xmllib_rec.closed    = no
     3076       use-index nm
     3077       no-error.
     3078       if not available buf_temp_xmllib_rec
     3079       then do:
     3080           run xmllib-parse-error in this-procedure (
     3081               input substitute( "Ошибка 2 открытия поля <&2> в записи <&1> уровня &3: Нет открытой записи."
     3082                               , p-rec-name
     3083                               , p-fld-name
     3084                               , p-rec-level
     3085                               )
     3086           ).
     3087       end.
     3088       else do:
     3089           find last buf_temp_xmllib_rec-fld
     3090               where buf_temp_xmllib_rec-fld.rec-key  = buf_temp_xmllib_rec.rec-key
     3091                 and buf_temp_xmllib_rec-fld.fldName  = p-fld-name
     3092                 and buf_temp_xmllib_rec-fld.closed   = no
     3093           use-index nm
     3094           no-error.
     3095           if available buf_temp_xmllib_rec-fld
     3096           then do:
     3097               run xmllib-parse-error in this-procedure (
     3098                   input substitute( "Ошибка 3 открытия поля <&2> в записи <&1>: Поле с этим именем уже открыто на строке &3."
     3099                                   , p-rec-name
     3100                                   , p-fld-name
     3101                                   , buf_temp_xmllib_rec-fld.fldOpenLine
     3102                                   )
     3103               ).
     3104           end.
     3105           else do:
     3106               assign
     3107                   v-xmllib-rec-fld-key    = v-xmllib-rec-fld-key + 1
     3108               .
     3109               create buf_temp_xmllib_rec-fld.
     3110               assign
     3111                   buf_temp_xmllib_rec-fld.fld-key         = v-xmllib-rec-fld-key
     3112                   buf_temp_xmllib_rec-fld.rec-key         = buf_temp_xmllib_rec.rec-key
     3113                   buf_temp_xmllib_rec-fld.fldOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     3114                   buf_temp_xmllib_rec-fld.fldCloseLine    = 0
     3115                   buf_temp_xmllib_rec-fld.fldName         = p-fld-name
     3116                   buf_temp_xmllib_rec-fld.closed          = no
     3117               .
     3118           end.
     3119       end.
     3120   end.
     3121   end procedure.
     3122   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3123   define temp-table THpck-sent no-undo
     3124   field THfilename as character field THcrc-pack as character field THcredate as date field THcrenum as integer  field THcretimeint as integer field THcretime as character   field THrcvddate  as date field THpack-num  as integer  field THrcvdtimeint as integer field THrcvdtime  as character   field THrcvd  as logical      field THsendtxtdate as date field THsendtxttimeint as integer field THsendtxttime as character  field THtotal-recs  as integer  field THesys-id  as integer     index pi is unique primary THesys-id                  THpack-num                 index ircvd                THesys-id                  THrcvd
     3125   .
     3126   define temp-table THcurr-pack no-undo
     3127   field THfilename as character field THcrc-pack as character field THcredate as date field THcrenum as integer  field THcretimeint as integer field THcretime as character   field THrcvddate  as date field THpack-num  as integer  field THrcvdtimeint as integer field THrcvdtime  as character   field THrcvd  as logical      field THsendtxtdate as date field THsendtxttimeint as integer field THsendtxttime as character  field THtotal-recs  as integer  field THesys-id  as integer     index pi is unique primary THesys-id                  THpack-num                 index ircvd                THesys-id                  THrcvd
     3128   .
     3129   define temp-table THpck-rcvd no-undo
     3130   field THfilename as character
     3131   field THesys-id  as integer
     3132   field THcrc-pack as character
     3133   field THpack-num  as integer
     3134   field THrcvd-recs  as integer
     3135   field THrcvd as logical
     3136   field THtotal-recs  as integer
     3137   field THrcvddate  as date
     3138   field THrcvdtimeint as integer
     3139   field THrcvdtime  as character
     3140   index pi is unique primary
     3141   THesys-id
     3142   THpack-num
     3143   index rcvd
     3144   THesys-id
     3145   THrcvd
     3146   .
     3147   procedure get-header-by-rec :
     3148   define input  parameter p-gate-rec as character no-undo .
     3149   define output parameter p-tth as handle no-undo .
     3150   define variable v-ii as integer   no-undo .
     3151   define variable glog as logical   no-undo .
     3152   define variable v-rowid as rowid no-undo .
     3153   define variable v-tbl-name as character no-undo .
     3154   define variable v-longchar as longchar no-undo .
     3155   define variable v-txmlh as handle no-undo .
     3156   define buffer buf_clob-data for ub.clob-data.
     3157   main-block:
     3158   do
     3159   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info14, return-value, chr(10), error-status :get-message (1))
     3160   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info14 )
     3161   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info14 )
     3162   :
     3163     run gen-row-keyr in  this-procedure  (
     3164                                           input  p-gate-rec
     3165                                           ,input  ?
     3166                                           ,input  "ub"
     3167                                           ,input  ?
     3168                                           ,input  NO-LOCK
     3169                                           ,output v-rowid
     3170                                           ,output v-tbl-name   ) no-error.
     3171       find first buf_clob-data no-lock where
     3172                 rowid(buf_clob-data) = v-rowid  no-error.
     3173       if not available buf_clob-data then do:
     3174         undo, return error substitute("Не найден CLOB  &1"
     3175                                         , p-gate-rec
     3176                                         ).
     3177       end.
     3178       assign
     3179       v-longchar = buf_clob-data.cdata
     3180       .
     3181       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     3182       if error-status :error then do:
     3183         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     3184       end.
     3185       create temp-table p-tth .
     3186       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     3187                                     , v-longchar
     3188                                     , ?
     3189                                     , ?
     3190                                     , ?
     3191                                     ) no-error.
     3192       v-longchar = '':U.
     3193       define variable v-esm as character no-undo .
     3194       v-esm = error-status:get-message(1).
     3195       if error-status :error
     3196       or not glog
     3197       then do:
     3198         delete object p-tth no-error.
     3199         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     3200                                    , p-gate-rec
     3201                                    , buf_clob-data.file-name_
     3202                                    , chr(10)
     3203                                    , v-esm
     3204                                     ).
     3205       end.
     3206   end.
     3207   end procedure.
     3208   procedure getoxmlh :
     3209   define input parameter p-xml-file-name as character no-undo .
     3210   define input parameter p-pack-data     as memptr no-undo .
     3211   define input parameter p-headerh as handle no-undo .
     3212   define input parameter p-delivery-method as integer no-undo .
     3213   define variable v-parse-status as integer no-undo .
     3214   define buffer buf_rec for temp_xmllib_rec.
     3215   define buffer buf_rec-fld for temp_xmllib_rec-fld.
     3216   define variable v-end-of-header as logical   no-undo .
     3217   define variable v-ii as integer   no-undo .
     3218   define variable v-root-name as character no-undo .
     3219   define buffer buf_temp_xmllib_rec for temp_xmllib_rec.
     3220   do
     3221   on error undo, return error return-value
     3222   :
     3223     run xmllib-clear-parse-data in this-procedure.
     3224     if valid-handle(p-headerh) then do:
     3225     do v-ii = 1 to p-headerh:num-fields:
     3226       run xmllib-add-rec-fld  in this-procedure (
     3227                                                    input p-headerh:table
     3228                                                   ,input (p-headerh:buffer-field(v-ii):name)
     3229                                                 )  .
     3230     end.
     3231     end.
     3232     case p-delivery-method:
     3233       when integer('3':U) then do:
     3234         v-root-name = "Oracle_Retail".
     3235         run xmllib-add-rec-fld  in this-procedure (
     3236                                                       input v-root-name
     3237                                                     ,input ""
     3238                                                   )  .
     3239       end.
     3240       when integer('5':U) then do:
     3241         run xmllib-add-rec-fld  in this-procedure (
     3242                                                       input "ORDER_"
     3243                                                     ,input ""
     3244                                                   )  .
     3245         run xmllib-add-rec-fld  in this-procedure (
     3246                                                       input "STATUS__"
     3247                                                     ,input ""
     3248                                                   )  .
     3249         run xmllib-add-rec-fld  in this-procedure (
     3250                                                       input "ORDRSP_"
     3251                                                     ,input ""
     3252                                                   )  .
     3253         run xmllib-add-rec-fld  in this-procedure (
     3254                                                       input "DESADV_"
     3255                                                     ,input ""
     3256                                                   )  .
     3257         run xmllib-add-rec-fld  in this-procedure (
     3258                                                       input "RECADV_"
     3259                                                     ,input ""
     3260                                                   )  .
     3261       end.
     3262       when integer('9':U) then do:
     3263               run xmllib-add-rec-fld  in this-procedure (
     3264                                                       input "statusReport"
     3265                                                     ,input ""
     3266                                                   )  .
     3267       end.
     3268       when integer('11':U) then do:
     3269         v-root-name = "".
     3270         run xmllib-add-rec-fld  in this-procedure (
     3271                                                       input "ERPRN-GC"
     3272                                                     ,input ""
     3273                                                   )  .
     3274       end.
     3275       otherwise do:
     3276         v-root-name = "".
     3277         run xmllib-add-rec-fld  in this-procedure (
     3278                                                   input v-root-name
     3279                                                  ,input ""
     3280                                               )  .
     3281       end.
     3282     end case.
     3283     run xmllib-parse-progressive ( input p-xml-file-name
     3284                                   ,input p-pack-data
     3285                                   ,input yes
     3286                                   ,input no
     3287                                   ,output v-parse-status) no-error .
     3288     repeat while not (error-status:error
     3289                       or
     3290                       v-parse-status = sax-complete
     3291                       or available buf_temp_xmllib_rec
     3292                       ):
     3293       if valid-handle(p-headerh)  then do:
     3294       find first buf_temp_xmllib_rec where
     3295                 buf_temp_xmllib_rec.recname = p-headerh:table
     3296             and buf_temp_xmllib_rec.closed = yes no-error.
     3297       end.
     3298       else do:
     3299         find first buf_temp_xmllib_rec no-error.
     3300       end.
     3301       error-status:error = no .
     3302       run xmllib-parse-progressive ( input p-xml-file-name
     3303                                     ,input p-pack-data
     3304                                     ,input no
     3305                                     ,input no
     3306                                     ,output v-parse-status) no-error .
     3307     end.
     3308   end.
     3309   end procedure.
     3310   define variable vss-include-info15 as character format "X(65)" no-undo
     3311   initial "@(#)$Workfile$ $Revision$".
     3312   procedure xmlchar-test :
     3313   define input parameter p-in-string          as character        no-undo.
     3314   define output parameter p-out-string-enc    as character        no-undo.
     3315   define output parameter p-out-string-dec    as character        no-undo.
     3316   do
     3317   on error undo, return error
     3318   :
     3319          run xmlchar-encode in this-procedure
     3320       (
     3321             input p-in-string
     3322           , output p-out-string-enc
     3323       ).
     3324          run xmlchar-decode in this-procedure
     3325       (
     3326             input p-out-string-enc
     3327           , output p-out-string-dec
     3328       ).
     3329   end.
     3330   end .
     3331   procedure xmlchar-encode :
     3332   define input parameter p-in-string      as character        no-undo.
     3333   define output parameter p-out-string    as character        no-undo.
     3334       define variable v-position      as integer      no-undo.
     3335       define variable v-current-char  as character    no-undo.
     3336   do
     3337   on error undo, return error
     3338   :
     3339       assign
     3340           p-out-string = "":U
     3341       .
     3342       case p-in-string
     3343       :
     3344           when ?
     3345           then do:
     3346               assign
     3347                   p-out-string = "?":U
     3348               .
     3349           end.
     3350           when "?":U
     3351           then do:
     3352               assign
     3353                   p-out-string = "&#63;":U
     3354               .
     3355           end.
     3356           otherwise do:
     3357               do v-position = 1 to length( p-in-string )
     3358               :
     3359                   assign
     3360                       v-current-char = substring( p-in-string, v-position, 1 )
     3361                   .
     3362                   case v-current-char
     3363                   :
     3364                       when "&":U
     3365                       then do:
     3366                           assign
     3367                               p-out-string = p-out-string + "&amp;":U
     3368                           .
     3369                       end.
     3370                       when ">":U
     3371                       then do:
     3372                           assign
     3373                               p-out-string = p-out-string + "&gt;":U
     3374                           .
     3375                       end.
     3376                       when "<":U
     3377                       then do:
     3378                           assign
     3379                               p-out-string = p-out-string + "&lt;":U
     3380                           .
     3381                       end.
     3382                       when "'":U
     3383                       then do:
     3384                           assign
     3385                               p-out-string = p-out-string + "&apos;":U
     3386                           .
     3387                       end.
     3388                       when '"':U
     3389                       then do:
     3390                           assign
     3391                               p-out-string = p-out-string + "&quot;":U
     3392                           .
     3393                       end.
     3394                       when chr(1)
     3395                       then do:
     3396                           assign
     3397                               p-out-string = p-out-string + "":U
     3398                           .
     3399                       end.
     3400                       when chr(2)
     3401                       then do:
     3402                           assign
     3403                               p-out-string = p-out-string + "":U
     3404                           .
     3405                       end.
     3406                       when chr(3)
     3407                       then do:
     3408                           assign
     3409                               p-out-string = p-out-string + "":U
     3410                           .
     3411                       end.
     3412                       when chr(4)
     3413                       then do:
     3414                           assign
     3415                               p-out-string = p-out-string + "":U
     3416                           .
     3417                       end.
     3418                       when chr(5)
     3419                       then do:
     3420                           assign
     3421                               p-out-string = p-out-string + "":U
     3422                           .
     3423                       end.
     3424                       when chr(6)
     3425                       then do:
     3426                           assign
     3427                               p-out-string = p-out-string + "":U
     3428                           .
     3429                       end.
     3430                       when chr(7)
     3431                       then do:
     3432                           assign
     3433                               p-out-string = p-out-string + "":U
     3434                           .
     3435                       end.
     3436                       when chr(8)
     3437                       then do:
     3438                           assign
     3439                               p-out-string = p-out-string + "":U
     3440                           .
     3441                       end.
     3442                       when chr(9)
     3443                       then do:
     3444                           assign
     3445                               p-out-string = p-out-string + "":U
     3446                           .
     3447                       end.
     3448                       when chr(29)
     3449                       then do:
     3450                           assign
     3451                               p-out-string = p-out-string + "":U
     3452                           .
     3453                       end.
     3454                       when chr(10)
     3455                       then do:
     3456                           assign
     3457                               p-out-string = p-out-string + "&#10;":U
     3458                           .
     3459                       end.
     3460                       when chr(13)
     3461                       then do:
     3462                           assign
     3463                               p-out-string = p-out-string + "&#13;":U
     3464                           .
     3465                       end.
     3466                       otherwise do:
     3467                           assign
     3468                               p-out-string = p-out-string + v-current-char
     3469                           .
     3470                       end.
     3471                   end case.
     3472               end.
     3473           end.
     3474       end case.
     3475   end.
     3476   end .
     3477   procedure xmlchar-encode-1c :
     3478   define input parameter p-in-string      as character        no-undo.
     3479   define output parameter p-out-string    as character        no-undo.
     3480       define variable v-position      as integer      no-undo.
     3481       define variable v-current-char  as character    no-undo.
     3482   do
     3483   on error undo, return error
     3484   :
     3485       assign
     3486           p-out-string = "":U
     3487       .
     3488       case p-in-string
     3489       :
     3490           when ?
     3491           then do:
     3492               assign
     3493                   p-out-string = "?":U
     3494               .
     3495           end.
     3496           otherwise do:
     3497               do v-position = 1 to length( p-in-string )
     3498               :
     3499                   assign
     3500                       v-current-char = substring( p-in-string, v-position, 1 )
     3501                   .
     3502                   case v-current-char
     3503                   :
     3504                       when chr(1)
     3505                       then do:
     3506                           assign
     3507                               p-out-string = p-out-string + " ":U
     3508                           .
     3509                       end.
     3510                       when chr(2)
     3511                       then do:
     3512                           assign
     3513                               p-out-string = p-out-string + " ":U
     3514                           .
     3515                       end.
     3516                       when chr(3)
     3517                       then do:
     3518                           assign
     3519                               p-out-string = p-out-string + " ":U
     3520                           .
     3521                       end.
     3522                       when chr(4)
     3523                       then do:
     3524                           assign
     3525                               p-out-string = p-out-string + " ":U
     3526                           .
     3527                       end.
     3528                       when chr(5)
     3529                       then do:
     3530                           assign
     3531                               p-out-string = p-out-string + " ":U
     3532                           .
     3533                       end.
     3534                       when chr(6)
     3535                       then do:
     3536                           assign
     3537                               p-out-string = p-out-string + " ":U
     3538                           .
     3539                       end.
     3540                       when chr(7)
     3541                       then do:
     3542                           assign
     3543                               p-out-string = p-out-string + " ":U
     3544                           .
     3545                       end.
     3546                       when chr(8)
     3547                       then do:
     3548                           assign
     3549                               p-out-string = p-out-string + " ":U
     3550                           .
     3551                       end.
     3552                       when chr(9)
     3553                       then do:
     3554                           assign
     3555                               p-out-string = p-out-string + " ":U
     3556                           .
     3557                       end.
     3558                       when chr(29)
     3559                       then do:
     3560                           assign
     3561                               p-out-string = p-out-string + " ":U
     3562                           .
     3563                       end.
     3564                       when chr(10)
     3565                       then do:
     3566                           assign
     3567                               p-out-string = p-out-string + " ":U
     3568                           .
     3569                       end.
     3570                       when chr(13)
     3571                       then do:
     3572                           assign
     3573                               p-out-string = p-out-string + " ":U
     3574                           .
     3575                       end.
     3576                       otherwise do:
     3577                           assign
     3578                               p-out-string = p-out-string + v-current-char
     3579                           .
     3580                       end.
     3581                   end case.
     3582               end.
     3583           end.
     3584       end case.
     3585   end.
     3586   end .
     3587   procedure xmlchar-decode :
     3588   define input parameter p-in-string      as character        no-undo.
     3589   define output parameter p-out-string    as character        no-undo.
     3590       define variable v-position      as integer      no-undo.
     3591       define variable v-last-position as integer      no-undo.
     3592       define variable v-temp-integer  as integer      no-undo.
     3593       define variable v-current-char  as character    no-undo.
     3594       define variable v-next-char     as character    no-undo.
     3595       define variable v-success       as logical      no-undo.
     3596   do
     3597   on error undo, return error
     3598   :
     3599       assign
     3600           p-out-string = "":U
     3601           v-position   = 0
     3602       .
     3603       replace-cycle:
     3604       do while yes
     3605       on error undo, return error
     3606       :
     3607           assign
     3608               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     3609           .
     3610           if v-last-position <= v-position
     3611           then do:
     3612               if v-position = 0
     3613               then do:
     3614                   assign
     3615                       p-out-string = p-in-string
     3616                   .
     3617               end.
     3618               else do:
     3619                   assign
     3620                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     3621                   .
     3622               end.
     3623               leave replace-cycle.
     3624           end.
     3625           else do:
     3626               assign
     3627                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     3628                   v-position      = v-last-position
     3629                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     3630               .
     3631               if v-current-char = "#":U
     3632               then do:
     3633                   assign
     3634                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     3635                   .
     3636                   if v-last-position > 0
     3637                   then do:
     3638                       run xmlchar-read-integer in this-procedure
     3639                        (
     3640                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     3641                           , output v-temp-integer
     3642                           , output v-success
     3643                       ).
     3644                       if v-success = yes
     3645                       and v-temp-integer >= 1
     3646                       and v-temp-integer <= 255
     3647                       then do:
     3648                           assign
     3649                               p-out-string = p-out-string + chr( v-temp-integer )
     3650                               v-position   = v-last-position + 1
     3651                           .
     3652                       end.
     3653                       else do:
     3654                           assign
     3655                               p-out-string = p-out-string + "&":U
     3656                               v-position   = v-position   + 1
     3657                           .
     3658                       end.
     3659                   end.
     3660                   else do:
     3661                       assign
     3662                           p-out-string = p-out-string + "&":U
     3663                           v-position   = v-position   + 1
     3664                       .
     3665                   end.
     3666               end.
     3667               else do:
     3668                   case substring( p-in-string, v-position + 1, 3 )
     3669                   :
     3670                       when "lt;":U
     3671                       then do:
     3672                           assign
     3673                               p-out-string = p-out-string + "<":U
     3674                               v-position   = v-position   + 3
     3675                           .
     3676                       end.
     3677                       when "gt;":U
     3678                       then do:
     3679                           assign
     3680                               p-out-string = p-out-string + ">":U
     3681                               v-position   = v-position   + 3
     3682                           .
     3683                       end.
     3684                       otherwise do:
     3685                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     3686                           then do:
     3687                               assign
     3688                                   p-out-string = p-out-string + "&":U
     3689                                   v-position   = v-position   + 4
     3690                               .
     3691                           end.
     3692                           else do:
     3693                               case substring( p-in-string, v-position + 1, 5 )
     3694                               :
     3695                                   when "quot;":U
     3696                                   then do:
     3697                                       assign
     3698                                           p-out-string = p-out-string + '"':U
     3699                                           v-position   = v-position   + 5
     3700                                       .
     3701                                   end.
     3702                                   when "apos;":U
     3703                                   then do:
     3704                                       assign
     3705                                           p-out-string = p-out-string + "'":U
     3706                                           v-position   = v-position   + 5
     3707                                       .
     3708                                   end.
     3709                                   otherwise do:
     3710                                       assign
     3711                                           p-out-string = p-out-string + "&":U
     3712                                       .
     3713                                   end.
     3714                               end case.
     3715                           end.
     3716                       end.
     3717                   end case.
     3718               end.
     3719           end.
     3720       end.
     3721   end.
     3722   end .
     3723   procedure xmlchar-read-integer :
     3724   define input parameter p-input-string      as character        no-undo.
     3725   define output parameter p-output-integer   as integer          no-undo.
     3726   define output parameter p-success       as logical          no-undo.
     3727   do
     3728   on error undo, return error
     3729   :
     3730       assign
     3731           p-output-integer = integer( p-input-string )
     3732       no-error.
     3733       if error-status :error
     3734       then do:
     3735           assign
     3736               p-success           = no
     3737               p-output-integer    = 0
     3738           .
     3739       end.
     3740       else do:
     3741           assign
     3742               p-success           = yes
     3743           .
     3744       end.
     3745   end.
     3746   end.
     3747   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3748   procedure esallatr-name :
     3749   do
     3750     on error undo, return error
     3751     :
     3752     define input  parameter p-code           as character no-undo .
     3753     define output parameter p-type           as character no-undo .
     3754     define output parameter p-format         as character no-undo .
     3755     define output parameter p-label          as character no-undo .
     3756     define output parameter p-user-can-edit  as logical   no-undo .
     3757     define output parameter p-output-display as logical   no-undo .
     3758     define output parameter p-other          as character no-undo .
     3759       case p-code :
     3760               when 'custom-pack-name':U then do:     assign     p-label = "Имя файла в ВС"     p-type = 'C':U      p-format = "X(255)"     p-label = "Имя файла в ВС"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
     3761               when 'route-custom-pack-name':U then do:     assign     p-label = "Иям файла в ВС"     p-type = 'C':U      p-format = "X(255)"     p-label = "Иям файла в ВС"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
     3762         otherwise do:
     3763           undo, return error substitute("неизвестный атрибут ВС &1", p-code) .
     3764         end.
     3765       end.
     3766     end.
     3767   end procedure.
     3768   procedure esallatr-tooltip :
     3769   do
     3770     on error undo, return error
     3771     :
     3772       define input  parameter p-code    as character no-undo .
     3773       define output parameter p-tooltip as character no-undo .
     3774       define output parameter p-label   as character no-undo .
     3775       case p-code :
     3776               when 'custom-pack-name':U then do:     assign     p-tooltip = "Имя файла в ВС"     p-label = "Имя файла в ВС" .   end.
     3777               when 'route-custom-pack-name':U then do:     assign     p-tooltip = "Имя файла в ВС"     p-label = "Иям файла в ВС" .   end.
     3778         otherwise do:
     3779           undo, return error substitute("Неизвестный атрибут ВС &1", p-code) .
     3780         end.
     3781       end.
     3782     end.
     3783   end procedure.
     3784   procedure esallatr-value :
     3785   do
     3786     on error undo, return error
     3787     :
     3788     define input  parameter p-table-name as character no-undo .
     3789     define input  parameter p-key1     as int64 no-undo .
     3790     define input  parameter p-key2     as int64 no-undo .
     3791     define input  parameter p-key3     as character no-undo .
     3792     define input  parameter p-key4     as character no-undo .
     3793     define input  parameter p-key5     as int64 no-undo .
     3794     define input  parameter p-key6     as int64 no-undo .
     3795     define input  parameter p-key7     as character no-undo .
     3796     define input  parameter p-key8     as character no-undo .
     3797     define input  parameter p-code     as character no-undo .
     3798     define output parameter p-value    as character no-undo .
     3799     define output parameter p-type     as character no-undo .
     3800     define buffer buf_esys-all-attr for ub.esys-all-attr.
     3801     define variable v-format         as character no-undo .
     3802     define variable v-label          as character no-undo .
     3803     define variable v-user-can-edit  as logical   no-undo .
     3804     define variable v-output-display as logical   no-undo .
     3805     define variable v-other          as character no-undo .
     3806       run esallatr-name in this-procedure
     3807         (input  p-code
     3808         ,output p-type
     3809         ,output v-format
     3810         ,output v-label
     3811         ,output v-user-can-edit
     3812         ,output v-output-display
     3813         ,output v-other
     3814         ) no-error .
     3815       if error-status :error then do:
     3816         undo, return error return-value .
     3817       end.
     3818       Find first  buf_esys-all-attr no-lock where
     3819                   buf_esys-all-attr.attr-code = p-code
     3820              and  buf_esys-all-attr.table-name  = p-table-name
     3821              and  buf_esys-all-attr.key1  = p-key1
     3822              and  buf_esys-all-attr.key2  = p-key2
     3823              and  buf_esys-all-attr.key3  = p-key3
     3824              and  buf_esys-all-attr.key4  = p-key4
     3825              and  buf_esys-all-attr.key5  = p-key5
     3826              and  buf_esys-all-attr.key6  = p-key6
     3827              and  buf_esys-all-attr.key7  = p-key7
     3828              and  buf_esys-all-attr.key8  = p-key8  no-error .
     3829      if avail buf_esys-all-attr then do:
     3830       assign
     3831       p-value = buf_esys-all-attr.attr-value.
     3832      end.
     3833      else do:
     3834       assign
     3835       p-value = if p-type = 'L':U then "no":U else "".
     3836      end.
     3837   end.
     3838   end procedure.
     3839   procedure esallatr-write :
     3840     do
     3841     on error undo, return error
     3842     :
     3843       define input  parameter p-table-name as character no-undo .
     3844       define input  parameter p-key1     as int64 no-undo .
     3845       define input  parameter p-key2     as int64 no-undo .
     3846       define input  parameter p-key3     as character no-undo .
     3847       define input  parameter p-key4     as character no-undo .
     3848       define input  parameter p-key5     as int64 no-undo .
     3849       define input  parameter p-key6     as int64 no-undo .
     3850       define input  parameter p-key7     as character no-undo .
     3851       define input  parameter p-key8     as character no-undo .
     3852       define input  parameter p-code     as character no-undo .
     3853       define input  parameter p-value    like ub.esys-all-attr.attr-value no-undo .
     3854       define buffer buf_esys-all-attr for ub.esys-all-attr .
     3855       define variable v-type           as character no-undo .
     3856       define variable v-format         as character no-undo .
     3857       define variable v-label          as character no-undo .
     3858       define variable v-user-can-edit  as logical   no-undo .
     3859       define variable v-output-display as logical   no-undo .
     3860       define variable v-other          as character no-undo .
     3861       run esallatr-name in this-procedure
     3862         (input  p-code
     3863         ,output v-type
     3864         ,output v-format
     3865         ,output v-label
     3866         ,output v-user-can-edit
     3867         ,output v-output-display
     3868         ,output v-other
     3869         ) no-error .
     3870       if error-status :error then do:
     3871         undo, return error return-value .
     3872       end.
     3873       Find first  buf_esys-all-attr exclusive-lock where
     3874                   buf_esys-all-attr.attr-code = p-code
     3875              and  buf_esys-all-attr.table-name  = p-table-name
     3876              and  buf_esys-all-attr.key1  = p-key1
     3877              and  buf_esys-all-attr.key2  = p-key2
     3878              and  buf_esys-all-attr.key3  = p-key3
     3879              and  buf_esys-all-attr.key4  = p-key4
     3880              and  buf_esys-all-attr.key5  = p-key5
     3881              and  buf_esys-all-attr.key6  = p-key6
     3882              and  buf_esys-all-attr.key7  = p-key7
     3883              and  buf_esys-all-attr.key8  = p-key8  no-error .
     3884       if not available buf_esys-all-attr then do:
     3885         assign
     3886         buf_esys-all-attr.attr-code = p-code
     3887         buf_esys-all-attr.table-name  = p-table-name
     3888         buf_esys-all-attr.key1  = p-key1
     3889         buf_esys-all-attr.key2  = p-key2
     3890         buf_esys-all-attr.key3  = p-key3
     3891         buf_esys-all-attr.key4  = p-key4
     3892         buf_esys-all-attr.key5  = p-key5
     3893         buf_esys-all-attr.key6  = p-key6
     3894         buf_esys-all-attr.key7  = p-key7
     3895         buf_esys-all-attr.key8  = p-key8
     3896         buf_esys-all-attr.attr-value = p-value
     3897         no-error.
     3898       end.
     3899       ELSE
     3900       assign
     3901       buf_esys-all-attr.attr-value = p-value no-error
     3902       .
     3903     end.
     3904   end procedure.
     3905   procedure esallatr-exist :
     3906     do
     3907     on error undo, return error
     3908     :
     3909       define input  parameter p-table-name as character no-undo .
     3910       define input  parameter p-key1     as int64 no-undo .
     3911       define input  parameter p-key2     as int64 no-undo .
     3912       define input  parameter p-key3     as character no-undo .
     3913       define input  parameter p-key4     as character no-undo .
     3914       define input  parameter p-key5     as int64 no-undo .
     3915       define input  parameter p-key6     as int64 no-undo .
     3916       define input  parameter p-key7     as character no-undo .
     3917       define input  parameter p-key8     as character no-undo .
     3918       define input  parameter p-code     like ub.esys-all-attr.attr-code  no-undo .
     3919       define output parameter p-exist   AS LOGICAL no-undo .
     3920       define buffer buf_esys-all-attr for ub.esys-all-attr .
     3921       define variable v-type           as character no-undo .
     3922       define variable v-format         as character no-undo .
     3923       define variable v-label          as character no-undo .
     3924       define variable v-user-can-edit  as logical   no-undo .
     3925       define variable v-output-display as logical   no-undo .
     3926       define variable v-other          as character no-undo .
     3927       run esallatr-name in this-procedure
     3928         (input  p-code
     3929         ,output v-type
     3930         ,output v-format
     3931         ,output v-label
     3932         ,output v-user-can-edit
     3933         ,output v-output-display
     3934         ,output v-other
     3935         ) no-error .
     3936       if error-status :error then do:
     3937         undo, return error return-value .
     3938       end.
     3939       Find first  buf_esys-all-attr no-lock where
     3940                   buf_esys-all-attr.attr-code = p-code
     3941              and  buf_esys-all-attr.table-name  = p-table-name
     3942              and  buf_esys-all-attr.key1  = p-key1
     3943              and  buf_esys-all-attr.key2  = p-key2
     3944              and  buf_esys-all-attr.key3  = p-key3
     3945              and  buf_esys-all-attr.key4  = p-key4
     3946              and  buf_esys-all-attr.key5  = p-key5
     3947              and  buf_esys-all-attr.key6  = p-key6
     3948              and  buf_esys-all-attr.key7  = p-key7
     3949              and  buf_esys-all-attr.key8  = p-key8  no-error .
     3950       if available buf_esys-all-attr then do:
     3951         P-EXIST = YES.
     3952       end.
     3953     end.
     3954   end procedure.
     3955   procedure esallatr-delete :
     3956     do
     3957     on error undo, return error
     3958     :
     3959       define input  parameter p-table-name as character no-undo .
     3960       define input  parameter p-key1     as int64 no-undo .
     3961       define input  parameter p-key2     as int64 no-undo .
     3962       define input  parameter p-key3     as character no-undo .
     3963       define input  parameter p-key4     as character no-undo .
     3964       define input  parameter p-key5     as int64 no-undo .
     3965       define input  parameter p-key6     as int64 no-undo .
     3966       define input  parameter p-key7     as character no-undo .
     3967       define input  parameter p-key8     as character no-undo .
     3968       define input parameter  p-code     like ub.esys-all-attr.attr-code  no-undo .
     3969       define output parameter p-deleted  as logical no-undo .
     3970       define buffer buf_esys-all-attr for ub.esys-all-attr .
     3971       define variable v-type           as character no-undo .
     3972       define variable v-format         as character no-undo .
     3973       define variable v-label          as character no-undo .
     3974       define variable v-user-can-edit  as logical   no-undo .
     3975       define variable v-output-display as logical   no-undo .
     3976       define variable v-other          as character no-undo .
     3977       run esallatr-name in this-procedure
     3978         (input  p-code
     3979         ,output v-type
     3980         ,output v-format
     3981         ,output v-label
     3982         ,output v-user-can-edit
     3983         ,output v-output-display
     3984         ,output v-other
     3985         ) no-error .
     3986       if error-status :error then do:
     3987         undo, return error return-value .
     3988       end.
     3989       Find first  buf_esys-all-attr exclusive-lock where
     3990                   buf_esys-all-attr.attr-code = p-code
     3991              and  buf_esys-all-attr.table-name  = p-table-name
     3992              and  buf_esys-all-attr.key1  = p-key1
     3993              and  buf_esys-all-attr.key2  = p-key2
     3994              and  buf_esys-all-attr.key3  = p-key3
     3995              and  buf_esys-all-attr.key4  = p-key4
     3996              and  buf_esys-all-attr.key5  = p-key5
     3997              and  buf_esys-all-attr.key6  = p-key6
     3998              and  buf_esys-all-attr.key7  = p-key7
     3999              and  buf_esys-all-attr.key8  = p-key8  no-error .
     4000       if not available buf_esys-all-attr then do:
     4001         p-DELETED = NO.
     4002       end.
     4003       ELSE DO:
     4004         delete buf_esys-all-attr.
     4005         p-DELETED = YES.
     4006       END.
     4007     end.
     4008   end procedure.
     4009   procedure esallatr-news :
     4010     do
     4011     on error undo, return error
     4012     :
     4013       define input  parameter p-code           as character no-undo .
     4014       define output parameter p-news           as logical   no-undo .
     4015       case p-code :
     4016               when 'custom-pack-name':U then do:     assign     p-news = true.   end.
     4017               when 'route-custom-pack-name':U then do:     assign     p-news = true.   end.
     4018         otherwise do:
     4019           undo, return error substitute("неизвестный атрибут ВС &1", p-code ).
     4020         end.
     4021       end.
     4022     end.
     4023   end procedure.
     4024   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4025   function get-short-pack-name returns character ( input p-action as character
     4026                                                   ,input p-pack-num as integer
     4027                                                   ,input p-delivery-method as integer
     4028                                                   ,input p-custom-pack-name as character
     4029                                                   ,output p-custom-flag as logical
     4030                                                   ):
     4031   define variable v-short-pack-name as character no-undo .
     4032   define buffer buf_esys-pck-rcvd for ub.esys-pck-rcvd.
     4033   define buffer buf_clients for ub.clients.
     4034   define variable v-int-point as character no-undo .
     4035   define variable v-type as character no-undo .
     4036   case p-delivery-method:
     4037    when integer('3':U) then do:
     4038      find first buf_clients no-lock where
     4039               buf_clients.db-num = g#db-num
     4040            and buf_clients.obj-type = 'маг':U no-error .
     4041      if not available buf_clients then do:
     4042       find first buf_clients no-lock where
     4043                 buf_clients.db-num = g#db-num
     4044             and buf_clients.obj-type = 'скл':U no-error .
     4045      end.
     4046      case p-action:
     4047        when "put"
     4048        or when "fput" then do:
     4049           v-short-pack-name = (if available buf_clients
     4050                              then  string(buf_clients.obj-code, (if buf_clients.obj-code > 999 then "9999" else "999"))
     4051                              else "___") + "-" + "000" + "_"
     4052                              + string( p-pack-num, "999999999":U ) + ".DAT":U.
     4053        end.
     4054        when "get"
     4055        or when "fget" then do:
     4056          v-short-pack-name = "000" + "-" +
     4057                              (if available buf_clients
     4058                              then  string(buf_clients.obj-code, (if buf_clients.obj-code > 999 then "9999" else "999"))
     4059                              else "___") + "_"
     4060                              + string( p-pack-num, "999999999":U ) + ".DAT":U.
     4061        end.
     4062      end case.
     4063      p-custom-flag = yes.
     4064    end.
     4065    when integer('5':U) then do:
     4066      if p-action = "get" then do:
     4067        find first buf_esys-pck-rcvd  where
     4068                   buf_esys-pck-rcvd.espr-pack-num = p-pack-num - 1
     4069               and buf_esys-pck-rcvd.esys-id = p-esys-id
     4070               and buf_esys-pck-rcvd.db-num = p-db-num
     4071               and buf_esys-pck-rcvd.espr-cr-db-num = g#db-num no-error.
     4072        if available buf_esys-pck-rcvd
     4073        and (p-custom-pack-name = ""
     4074             or
     4075             num-entries(p-custom-pack-name, "_") < 2
     4076             or  (num-entries(buf_esys-pck-rcvd.custom-pack-name, "_") >= 2
     4077                  and entry(2, buf_esys-pck-rcvd.custom-pack-name, "_") >= entry(2, p-custom-pack-name, "_")
     4078                  )
     4079             ) then do:
     4080          p-custom-flag = yes.
     4081          return ''.
     4082        end.
     4083      end.
     4084      p-custom-flag = yes.
     4085      v-short-pack-name = p-custom-pack-name.
     4086    end.
     4087    when integer('9':U) then do:
     4088      p-custom-flag = yes.
     4089      v-short-pack-name = p-custom-pack-name.
     4090    end.
     4091    when integer('11':U) then do:
     4092      case p-action:
     4093        when "put"
     4094        or when "fput" then do:
     4095          run db-attr-value in this-procedure
     4096              (input g#db-num
     4097              ,input 'int-point':U
     4098              ,output v-int-point
     4099              ,output v-type
     4100              ) no-error .
     4101          p-custom-flag = yes.
     4102          v-short-pack-name = v-int-point + "_00000_" + string(p-pack-num) + "_"
     4103                            + string(day(now), "99") + string(month(now), "99") + string(year(now), "9999")
     4104                            + substring(string(TIME, "HH:MM:SS"), 1, 2)
     4105                            + substring(string(TIME, "HH:MM:SS"), 4, 2)
     4106                            + substring(string(TIME, "HH:MM:SS"), 7, 2)
     4107                            + ".xml" .
     4108        end.
     4109        when "get"
     4110        or when "fget" then do:
     4111          p-custom-flag = yes.
     4112          v-short-pack-name = p-custom-pack-name.
     4113        end.
     4114      end case.
     4115    end.
     4116    otherwise do:
     4117      v-short-pack-name = "o":U + string( p-pack-num, "999999999":U ) + ".":U.
     4118    end.
     4119   end case.
     4120   return v-short-pack-name.
     4121   end function.
