     6660             ,input 'xml-esys-import':U
     6661             ,input buf_temp-param-name.profile_id
     6662             ,input buf_temp-param-name.codex_id
     6663             ,input buf_temp-param-name.ruleset_id
     6664             ,input g#db-num
     6665             ,input buf_temp-param-name.call_id
     6666             ,input (
     6667                    string(p-esys-id) + chr(4) +
     6668                    p-xml-file-name + chr(4) +
     6669                    string(v_dataseth) + chr(4) +
     6670                    string(v-pck-num) + chr(4) +
     6671                    p-log-file-name + chr(4) +
     6672                    buf_temp-param-name.param-name + chr(4) +
     6673                    buf_temp-param-name.schema-name + chr(4)
     6674                     )
     6675             ,input yes
     6676             ) no-error .
     6677           if error-status:error then do:
     6678             v-my-message = substitute("Ошибка при импорте данных по схеме &2:&3профайл правил &1&3&4&3&5"
     6679                                         ,buf_temp-param-name.profile_id
     6680                                         ,v-schema-name
     6681                                         ,chr(10)
     6682                                         , error-status:get-message(1)
     6683                                         , return-value
     6684                                         ) .
     6685             run write-log in p-log-handle ( input 2, input v-my-message ).
     6686             if buf_temp-param-name.ruleset_id = 5 then do:
     6687             end.
     6688             next _rule-profile.
     6689           end.
     6690         end.
     6691         otherwise do:
     6692           v-my-message = substitute("Неизвестный тип &1  профайла &2 для обработки данных по схеме &3"
     6693                                         ,buf_temp-param-name.profile-type
     6694                                       ,buf_temp-param-name.profile_id
     6695                                       , v-schema-name) .
     6696           run write-log in p-log-handle ( input 2, input v-my-message ).
     6697           next _rule-profile.
     6698         end.
     6699       end case.
     6700       v-task-ok = v-task-ok + 1.
     6701       find first buf_esys-pck-keys no-lock where
     6702               buf_esys-pck-keys.esys-id = p-esys-id
     6703           and buf_esys-pck-keys.db-num = p-db-num
     6704           and buf_esys-pck-keys.espr-cr-db-num = g#db-num
     6705           and buf_esys-pck-keys.espr-pack-num = v-pck-num
     6706           and buf_esys-pck-keys.espr-prev-uniq-key = ''
     6707           and buf_esys-pck-keys.espr-uniq-key = substitute("&2&1&3&1&4&1&5"
     6708                                                               , chr(4)
     6709                                                               , buf_temp-param-name.call_id
     6710                                                               , buf_temp-param-name.codex_id
     6711                                                               , buf_temp-param-name.ruleset_id
     6712                                                               , buf_temp-param-name.order_id)
     6713           no-error.
     6714       if not available buf_esys-pck-keys then do:
     6715         do transaction
     6716         on error undo, return error
     6717         :
     6718           create buf_esys-pck-keys.
     6719           assign
     6720           buf_esys-pck-keys.esys-id = p-esys-id
     6721           buf_esys-pck-keys.db-num = p-db-num
     6722           buf_esys-pck-keys.espr-cr-db-num = g#db-num
     6723           buf_esys-pck-keys.espr-pack-num = v-pck-num
     6724           buf_esys-pck-keys.espr-prev-uniq-key = ''
     6725           buf_esys-pck-keys.espr-uniq-key = substitute("&2&1&3&1&4&1&5"
     6726                                                                 , chr(4)
     6727                                                                 , buf_temp-param-name.call_id
     6728                                                                 , buf_temp-param-name.codex_id
     6729                                                                 , buf_temp-param-name.ruleset_id
     6730                                                                 , buf_temp-param-name.order_id)
     6731           .
     6732         end.
     6733       end.
     6734     end.
     6735     v-rec-cnt = v-rec-cnt + 1
     6736     .
     6737       if valid-handle(v-headerh) then do:
     6738     if v-headerh:available
     6739     and v-headerh:table = "THheader"
     6740     and v-headerh::THtotal-recs <> v-rec-cnt then do:
     6741       v-my-message = substitute("Не совпадает количество считанных записей и ожидаемое количество :&1" +
     6742                                    "принято: &2&1"  +
     6743                                    "должно быть: &3"
     6744                                    ,chr(10)
     6745                                    ,v-rec-cnt
     6746                                   ,v-headerh::THtotal-recs) .
     6747       run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     6748       os-delete value(v-schema-tmp-file).
     6749       undo, return error v-my-message.
     6750     end.
     6751   end.
     6752     if v-task = v-task-ok then do:
     6753       if buf_ext-system.delivery-method = integer('5':U)  then do:
     6754         run get-xcnf_get-xcnf in this-procedure (
     6755                                           input p-esys-id
     6756                                         ,input p-db-num
     6757                                         ,input g#db-num
     6758                                         ,input p-pack-num
     6759                                         ,input buf_ext-system.delivery-method
     6760                                         ,buffer buf_temp-esys-pck-sent
     6761                                         ,buffer buf_temp-esys-pck-rcvd
     6762                                         ,buffer curr_temp-esys-pck-sent
     6763                                         ,output v-rec-cnt
     6764                                       ) no-error.
     6765         if error-status :error then do:
     6766           v-my-message = substitute("Ошибка при принятии подтверждений из ВС:&1&2&1&3"
     6767                                     , chr(10)
     6768                                     , error-status:get-message(1)
     6769                                     , return-value ) .
     6770         run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     6771         os-delete value(v-schema-tmp-file).
     6772         undo, return error v-my-message.
     6773         end.
     6774       end.
     6775       if buf_ext-system.imp-conf-send  = integer('1':U)
     6776       then do:
     6777         run get-xcnf_set-xcnf in this-procedure (
     6778                                          input p-esys-id
     6779                                         ,input p-db-num
     6780                                         ,input g#db-num
     6781                                         ,input p-pack-num
     6782                                         ,input v-rec-cnt
     6783                                         ,input v-headerh
     6784                                         ,buffer buf_temp-esys-pck-sent
     6785                                         ,buffer buf_temp-esys-pck-rcvd
     6786                                         ,buffer curr_temp-esys-pck-sent
     6787                                       ) no-error.
     6788       if error-status :error then do:
     6789         v-my-message = substitute("Ошибка при выставлении подтверждений:&1&2&1&3"
     6790                                     , chr(10)
     6791                                     , error-status:get-message(1)
     6792                                     , return-value ) .
     6793         run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     6794         os-delete value(v-schema-tmp-file).
     6795         undo, return error v-my-message.
     6796       end.
     6797       end.
     6798       else do:
     6799         run get-xcnf_set0xcnf in this-procedure (
     6800                                          input p-esys-id
     6801                                         ,input p-db-num
     6802                                         ,input g#db-num
     6803                                         ,input p-pack-num
     6804                                         ,input buf_ext-system.delivery-method
     6805                                         ,input v-rec-cnt
     6806                                         ,input v-headerh
     6807                                         )  no-error.
     6808         if error-status :error then do:
     6809           v-my-message = substitute("Ошибка при выставлении подтверждений:&1&2&1&3"
     6810                                     , chr(10)
     6811                                     , error-status:get-message(1)
     6812                                     , return-value ) .
     6813           run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     6814           os-delete value(v-schema-tmp-file).
     6815           undo, return error v-my-message.
     6816         end.
     6817       end.
     6818     end.
     6819     for each buf_temp-esys-pck-sent  :
     6820       delete buf_temp-esys-pck-sent .
     6821     end.
     6822     run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     6823     run send-to-cash in this-procedure no-error.
     6824     return.
     6825   end.
     6826   procedure set-err-type :
     6827   define input parameter p-err-type as character no-undo .
     6828   do
     6829   on error undo, return error
     6830   :
     6831     run set-err-type in p-parent-handle ( input p-err-type) no-error.
     6832     if error-status:error then do:
     6833       return error return-value .
     6834     end.
     6835   end.
     6836   end procedure.
