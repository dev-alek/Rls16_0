     6380                                                               , buf_temp-param-name.codex_id
     6381                                                               , buf_temp-param-name.ruleset_id
     6382                                                               , buf_temp-param-name.order_id)
     6383           no-error.
     6384       if available buf_esys-pck-keys then do:
     6385         v-task-ok = v-task-ok + 1.
     6386         next _rule-profile.
     6387       end.
     6388         case buf_temp-param-name.profile-type:
