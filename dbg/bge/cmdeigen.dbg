     5155   DEFINE new shared TEMP-TABLE thbjattr-list no-undo like ub.thbj-attr .
     5156   define new shared var sendEMRC   as logical no-undo.
     5157   define new shared var settingUpd as logical no-undo.
     5158   define new shared var sendMarkType as logical no-undo.
     5159   define new shared var sendGisMt as logical no-undo.
     5160   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5161   procedure send-to-cash:
     5162     if not can-find(first ub.cash-desk where
     5163                     ub.cash-desk.db-num = ibs.th.gbl.gbl-var:g#db-num AND
     5164                     ub.cash-desk.cash-on = yes) then return.
     5165     do
     5166     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     5167     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     5168     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     5169     :
     5170       if can-find(first gds-list no-lock)
     5171       or can-find(first gdsolist no-lock)
     5172       or can-find(first bc-list no-lock)
     5173       or can-find(first pbc-list no-lock)
     5174       or can-find(first cash-txn no-lock)
     5175       or can-find(first cash-txr no-lock)
     5176       or can-find(first dc-list no-lock)
     5177       or can-find(first dc-dis-card-mask no-lock)
     5178       or can-find(first stpl-list no-lock)
     5179       or can-find(first pdf-list no-lock)
     5180       or can-find(first cash-pay-list no-lock)
     5181       or can-find(first ext-classif-list no-lock)
     5182       or can-find(first c-ext-classif-list no-lock)
     5183       or can-find(first PromoAction-list no-lock)
     5184       or can-find(first thbjattr-list no-lock)
     5185       or sendEMRC
     5186       or settingUpd
     5187       or sendMarkType
     5188       then do:
     5189         run str/diallog.w (
     5190                            input parparentproc
     5191                           ,input ?
     5192                           ,input 'str/sendnall.p':U
     5193                           ,input string(ibs.th.gbl.gbl-var:g#db-num)
     5194                           ,input yes
     5195                           ,input '':U
     5196                           ,input 'Отправка информации на кассу') no-error .
     5197       end.
     5198     end.
     5199   end procedure.
     5200   procedure fill-setting :
     5201      define input parameter i-obj      as character no-undo .
     5202      define input parameter i-obj-type as character no-undo .
     5203      define input parameter i-obj-code as integer   no-undo .
     5204      define input parameter i-parent   as character no-undo .
     5205      define input parameter i-code     as character no-undo .
     5206      define buffer buf_thbj-attr for ub.thbj-attr.
     5207      define buffer buf_sys-ctrl for ub.sys-ctrl.
     5208      define buffer buf_clients for ub.clients.
     5209      define variable v-db-num    as integer no-undo.
     5210      define variable v-shop-code as integer no-undo.
     5211      define variable v-reg-code  as integer no-undo.
     5212      settingUpd = yes.
     5213      sendGisMt = no.
     5214      if i-obj = "thbj-attr"
     5215      then do:
     5216         v-db-num  = ibs.th.gbl.gbl-var:g#db-num.
     5217         if v-db-num <> 0 then do:
     5218             find first buf_clients no-lock
     5219                  where buf_clients.obj-type = 'маг':U
     5220                    and buf_clients.db-num   = v-db-num
     5221                no-error.
     5222             if available buf_clients then v-shop-code = buf_clients.obj-code.
     5223         end.
     5224      end.
     5225      if i-obj = "thbj-attr" and
     5226         (i-parent = 'gisMT':U or i-parent = 'marking':U)
     5227      then do:
     5228         if i-parent = 'gisMT':U and i-obj-type = "" and i-obj-code = 0 then do:
     5229             if not can-find(first buf_thbj-attr no-lock where
     5230                                   buf_thbj-attr.obj-type = 'БД':U
     5231                               and buf_thbj-attr.obj-code = v-db-num
     5232                               and buf_thbj-attr.upper-prop-code = i-parent
     5233                               and buf_thbj-attr.prop-code = i-code)
     5234             then sendGisMt = yes.
     5235         end.
     5236         if i-parent = 'gisMT':U and i-obj-type = 'регион':U then do:
     5237             sendGisMt = yes.
     5238         end.
     5239         else if (i-parent = 'gisMT':U and i-obj-type = 'БД':U and i-obj-code = v-db-num)
     5240            then sendGisMt = yes.
     5241         else if i-parent = 'marking':U and i-obj-type = 'маг':U and i-obj-code = v-shop-code
     5242            then sendGisMt = yes.
     5243         else if i-parent = 'marking':U and i-obj-type = "" then do:
     5244             if not can-find(first buf_thbj-attr no-lock where
     5245                                   buf_thbj-attr.obj-type = 'маг':U
     5246                               and buf_thbj-attr.obj-code = v-shop-code
     5247                               and buf_thbj-attr.upper-prop-code = i-parent
     5248                               and buf_thbj-attr.prop-code = i-code)
     5249             then sendGisMt = yes.
     5250         end.
     5251         if sendGisMt = yes then do:
     5252             if not can-find(first thbjattr-list where
     5253                                   thbjattr-list.obj-type = i-obj-type
     5254                               and thbjattr-list.obj-code = i-obj-code
     5255                               and thbjattr-list.upper-prop-code = i-parent
     5256                               and thbjattr-list.prop-code = i-code)
     5257             then do:
     5258                 create thbjattr-list.
     5259                 assign
     5260                    thbjattr-list.obj-type = i-obj-type
     5261                    thbjattr-list.obj-code = i-obj-code
     5262                    thbjattr-list.upper-prop-code = i-parent
     5263                    thbjattr-list.prop-code = i-code
     5264                    .
     5265             end.
     5266         end.
     5267      end.
     5268   end procedure.
     5269   procedure fill-code :
     5270      define input parameter i-parent as character no-undo .
     5271      define input parameter i-code   as character no-undo .
     5272      if i-parent begins "EMC"
     5273      then
     5274         sendEMRC = yes.
     5275      if i-parent begins "MarkType"
     5276      then
     5277         sendMarkType = yes.
     5278   end procedure.
     5279   procedure fill-gds-list :
     5280   define parameter buffer buf_goods for ub.goods.
     5281   do
     5282   on error undo, return error
     5283   :
     5284     for first gds-list where gds-list.gds-code = buf_goods.gds-code:
     5285       delete gds-list.
     5286     end.
     5287     create gds-list.
     5288     buffer-copy buf_goods to gds-list no-error.
     5289     if error-status:error then message error-status:get-message(1) view-as alert-box.
     5290     release gds-list.
     5291   end.
     5292   end procedure.
     5293   procedure fill-dc-list :
     5294   define parameter buffer buf_dis-card for ub.dis-card .
     5295   do
     5296   on error undo, return error
     5297   :
     5298     find first dc-list where
     5299               dc-list.d-card = buf_dis-card.d-card no-lock no-error.
     5300     if not available dc-list then do:
     5301       create dc-list.
     5302       buffer-copy buf_dis-card to dc-list.
     5303       release dc-list.
     5304     end.
     5305   end.
     5306   end procedure.
     5307   procedure fill-dc-list-mask :
     5308   define parameter buffer buf_dis-card-mask for ub.dis-card-mask .
     5309   do
     5310   on error undo, return error
     5311   :
     5312      find first dc-list where
     5313               dc-list.d-card = buf_dis-card-mask.mask no-lock no-error.
     5314      if not available dc-list
     5315      then do:
     5316         find first ub.dis-card no-lock where
     5317                    ub.dis-card.d-card = buf_dis-card-mask.mask no-error .
     5318         if  available dis-card
     5319         then
     5320            run fill-dc-list(buffer dis-card) .
     5321      end.
     5322     find first dc-dis-card-mask where
     5323                dc-dis-card-mask.mask-num = buf_dis-card-mask.mask-num no-lock no-error.
     5324     buffer-copy buf_dis-card-mask to dc-dis-card-mask.
     5325     release dc-dis-card-mask.
     5326   end.
     5327   end procedure.
     5328   procedure fill-dc-list-mask-attr :
     5329   define parameter buffer buf_dis-card-mask-attr for ub.dis-card-mask-attr .
     5330   define buffer dis-card-mask for ub.dis-card-mask .
     5331   do
     5332   on error undo, return error
     5333   :
     5334     find first dc-dis-card-mask where
     5335                dc-dis-card-mask.mask-num = buf_dis-card-mask-attr.mask-num no-lock no-error.
     5336     if not available dc-dis-card-mask
     5337     then do:
     5338        find first dis-card-mask where dis-card-mask.mask-num eq buf_dis-card-mask-attr.mask-num no-lock no-error.
     5339        if available dis-card-mask
     5340        then
     5341           run  fill-dc-list-mask (buffer dis-card-mask).
     5342     end.
     5343     find first dc-dis-card-mask-attr where
     5344               dc-dis-card-mask-attr.mask-num  = buf_dis-card-mask-attr.mask-num
     5345          and  dc-dis-card-mask-attr.attr-code = buf_dis-card-mask-attr.attr-code
     5346               no-lock no-error.
     5347     buffer-copy buf_dis-card-mask-attr to dc-dis-card-mask-attr.
     5348     release dc-dis-card-mask-attr.
     5349   end.
     5350   end procedure.
     5351   procedure fill-dc-list-attr :
     5352   define input parameter p-d-card as character no-undo .
     5353   define input parameter p-emitent-host-code as integer no-undo .
     5354   do
     5355   on error undo, return error
     5356   :
     5357     find first dc-list where
     5358               dc-list.d-card = p-d-card no-error .
     5359     if not avail dc-list then do:
     5360       create dc-list.
     5361       assign
     5362       dc-list.d-card = p-d-card
     5363       dc-list.emitent-host-code = p-emitent-host-code
     5364       .
     5365       release dc-list.
     5366     end.
     5367   end.
     5368   end procedure.
     5369   procedure fill-cash-pay :
     5370   define input parameter p-cdpay-code as integer no-undo .
     5371   define input parameter p-curr-code  as integer no-undo .
     5372   do
     5373   on error undo, return error
