     5380          cash-pay-list.cdpay-code = p-cdpay-code
     5381          cash-pay-list.curr-code  = p-curr-code
     5382       .
     5383       release cash-pay-list.
     5384     end.
     5385   end.
     5386   end procedure.
     5387   procedure fill-PromoAction :
