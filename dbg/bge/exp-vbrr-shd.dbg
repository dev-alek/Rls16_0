        1   block-level on error undo, throw.
        2   define variable vss-revision as character no-undo init "$Revision: $":U.
        3   define variable vss-author as character no-undo init "$Author: SShalanin $":U.
        4   define variable vss-date as character no-undo init "$Date: $":U.
        5   define variable vss-workfile as character no-undo init "$Workfile: exp-VBRR-shd.p $":U.
        6   define variable vss-archive as character no-undo init "$Archive: bge/exp-VBRR-shd.p $":U.
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define input parameter parparentproc as widget-handle no-undo.
       67   define input parameter p_parent-handle as widget-handle no-undo.
       68   define input parameter p_log-handle as handle no-undo.
       69   define input parameter p_db-num-char as character no-undo.
       70   define input parameter p_task-type as character no-undo.
       71   define input parameter p_task-num as integer no-undo.
       72   define input parameter p_db-num as integer no-undo.
       73   define variable  ptrl as character no-undo.
       74   define variable v-param-list as character no-undo.
       75   define variable v-param-type as character no-undo.
       76   define variable v-directory as character no-undo.
       77   define variable v-type-exp as integer no-undo.
       78   define variable v-per-izm as character no-undo.
       79   define variable  v-place as integer no-undo.
       80   define variable v-login as char no-undo.
       81   define variable v-password as char no-undo.
       82   define variable v-code_TNP as char no-undo.
       83   define variable v-code_pool as char no-undo.
       84   define variable v-code_system as integer no-undo.
       85   define variable v-long-code as integer no-undo.
       86   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   define temp-table temp-schedule-free no-undo
       88   field free-id as character
       89   field free-task-name as character
       90   field proc-run-name as character
       91   field proc-param-edit-name as character
       92   field conf-param as character
       93   field is-gbd as logical
       94   field is-ubd as logical
       95   field enable-concurrent-0 as logical
       96   field enable-concurrent-db as logical
       97   field other-info as character
       98   field enc-key as character
       99   field is-rum as logical
      100   index pi is unique primary
      101   free-id.
      102   procedure schedule-attr-name :
      103   do
      104     on error undo, return error
      105     :
      106     define input  parameter p-code           as character no-undo .
      107     define output parameter p-type           as character no-undo .
      108     define output parameter p-format         as character no-undo .
      109     define output parameter p-label          as character no-undo .
      110     define output parameter p-user-can-edit  as logical   no-undo .
      111     define output parameter p-output-display as logical   no-undo .
      112     define output parameter p-other          as character no-undo .
      113       if index(p-code, chr(4)) > 0 then do:
      114         p-code = entry(1, p-code, chr(4)).
      115       end.
      116       case p-code :
      117               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      118               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      119               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      120               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      121               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      122               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      123               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      124               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      125               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      126         otherwise do:
      127           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      128         end.
      129       end.
      130     end.
      131   end procedure.
      132   procedure schedule-attr-tooltip :
      133   do
      134     on error undo, return error
      135     :
      136       define input  parameter p-code    as character no-undo .
      137       define output parameter p-tooltip as character no-undo .
      138       define output parameter p-label   as character no-undo .
      139       if index(p-code, chr(4)) > 0 then do:
      140         p-code = entry(1, p-code, chr(4)).
      141       end.
      142       case p-code :
      143               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      144               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      145               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      146               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      147               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      148               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      149               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      150               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      151               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      152         otherwise do:
      153               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      154         end.
      155       end.
      156     end.
      157   end procedure.
      158   procedure schedule-attr-value :
      159   do
      160   on error undo, return error return-value
      161   :
      162   define input parameter  p-cre-db-num as integer    no-undo.
      163   define input parameter  p-task-type  as character  no-undo.
      164   define input parameter  p-task-num   as integer    no-undo.
      165   define input parameter  p-code       as character  no-undo.
      166   define output parameter p-value      as character  no-undo.
      167   define output parameter p-type       as character  no-undo.
      168       define variable v-format         as character no-undo .
      169       define variable v-label          as character no-undo .
      170       define variable v-user-can-edit  as logical   no-undo .
      171       define variable v-output-display as logical   no-undo .
      172       define variable v-other          as character no-undo .
      173       define buffer buf_schedule-attr for ub.schedule-attr.
      174       run schedule-attr-name in this-procedure (
      175             input  p-code
      176           , output p-type
      177           , output v-format
      178           , output v-label
      179           , output v-user-can-edit
      180           , output v-output-display
      181           , output v-other
      182       ) no-error .
      183       if error-status :error
      184       then do:
      185           undo, return error return-value .
      186       end.
      187       if p-code begins ('schd-free-id':U + chr(4))
      188       and entry(2, p-code, chr(4)) = '':U then do:
      189         find first buf_schedule-attr no-lock
      190             where buf_schedule-attr.cre-db-num = p-cre-db-num
      191               and buf_schedule-attr.task-type  = p-task-type
      192               and buf_schedule-attr.task-num   = p-task-num
      193               and buf_schedule-attr.attr-code  begins p-code
      194         no-error .
      195       end.
      196       else do:
      197         find first buf_schedule-attr no-lock
      198             where buf_schedule-attr.cre-db-num = p-cre-db-num
      199               and buf_schedule-attr.task-type  = p-task-type
      200               and buf_schedule-attr.task-num   = p-task-num
      201               and buf_schedule-attr.attr-code  = p-code
      202         no-error .
      203       end.
      204       if available buf_schedule-attr
      205       then do:
      206           assign
      207               p-value = buf_schedule-attr.attr-value
      208           .
      209       end.
      210       else do:
      211         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      212            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      213         end.
      214         else do:
      215           assign
      216               p-value = if p-type = 'L':U then "no":U else ""
      217           .
      218         end.
      219       end.
      220   end.
      221   end procedure.
      222   procedure schedule-attr-write :
      223   do
      224   on error undo, return error
      225   :
      226   define input parameter p-cre-db-num  as integer   no-undo.
      227   define input parameter p-task-type   as character no-undo.
      228   define input parameter p-task-num    as integer   no-undo.
      229   define input parameter p-code        as character no-undo.
      230   define input parameter p-value       as character no-undo.
      231       define variable v-type              as character                no-undo.
      232       define variable v-format            as character                no-undo.
      233       define variable v-label             as character                no-undo.
      234       define variable v-user-can-edit     as logical                  no-undo.
      235       define variable v-output-display    as logical                  no-undo.
      236       define variable v-other             as character                no-undo.
      237       define buffer buf_schedule-attr for ub.schedule-attr .
      238       run schedule-attr-name in this-procedure (
      239             input  p-code
      240           , output v-type
      241           , output v-format
      242           , output v-label
      243           , output v-user-can-edit
      244           , output v-output-display
      245           , output v-other
      246       ) no-error.
      247       if error-status :error
      248       then do:
      249           undo, return error return-value.
      250       end.
      251       find first buf_schedule-attr exclusive-lock
      252            where buf_schedule-attr.cre-db-num = p-cre-db-num
      253              and buf_schedule-attr.task-type  = p-task-type
      254              and buf_schedule-attr.task-num   = p-task-num
      255              and buf_schedule-attr.attr-code  = p-code
      256       no-error.
      257       if not available buf_schedule-attr
      258       then do:
      259           create buf_schedule-attr.
      260           assign
      261             buf_schedule-attr.cre-db-num = p-cre-db-num
      262             buf_schedule-attr.task-type  = p-task-type
      263             buf_schedule-attr.task-num   = p-task-num
      264             buf_schedule-attr.attr-code  = p-code
      265             buf_schedule-attr.attr-value = p-value
      266           .
      267       end.
      268       else do:
      269           assign
      270               buf_schedule-attr.attr-value = p-value
      271           .
      272       end.
      273   end.
      274   end procedure.
      275   procedure schedule-attr-delete :
      276   do
      277   on error undo, return error
      278   :
      279   define input  parameter p-cre-db-num  as integer   no-undo.
      280   define input  parameter p-task-type   as character no-undo.
      281   define input  parameter p-task-num    as integer   no-undo.
      282   define input  parameter p-code        as character no-undo.
      283   define output parameter p-deleted     as logical   no-undo.
      284       define buffer buf_schedule-attr for ub.schedule-attr .
      285       define variable v-type              as character                no-undo.
      286       define variable v-format            as character                no-undo.
      287       define variable v-label             as character                no-undo.
      288       define variable v-user-can-edit     as logical                  no-undo.
      289       define variable v-output-display    as logical                  no-undo.
      290       define variable v-other             as character                no-undo.
      291       run schedule-attr-name in this-procedure (
      292             input p-code
      293           , output v-type
      294           , output v-format
      295           , output v-label
      296           , output v-user-can-edit
      297           , output v-output-display
      298           , output v-other
      299       ) no-error .
      300       if error-status :error
      301       then do:
      302           undo, return error return-value .
      303       end.
      304       find first buf_schedule-attr exclusive-lock
      305            where buf_schedule-attr.cre-db-num = p-cre-db-num
      306              and buf_schedule-attr.task-type  = p-task-type
      307              and buf_schedule-attr.task-num   = p-task-num
      308              and buf_schedule-attr.attr-code  = p-code
      309       no-error.
      310       if not available buf_schedule-attr
      311       then do:
      312           assign
      313               p-deleted = no
      314           .
      315       end.
      316       else do:
      317           delete buf_schedule-attr.
      318           assign
      319               p-deleted = yes
      320           .
      321       end.
      322   end.
      323   end procedure.
      324   procedure schedule-attr-news :
      325   do
      326   on error undo, return error
      327   :
      328       define input  parameter p-code           as character no-undo .
      329       define output parameter p-news           as logical   no-undo .
      330       if index(p-code, chr(4)) > 0 then do:
      331         p-code = entry(1, p-code, chr(4)).
      332       end.
      333       case p-code :
      334               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      335               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      336               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      337               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      338               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      339               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      340               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      341               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      342               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      343         otherwise do:
      344           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      345         end.
      346       end.
      347   end.
      348   end procedure.
      349   procedure schedule-attr-extract-logical :
      350   do
      351   on error undo, return error
      352   :
      353   define input  parameter p-parameter-number   as integer      no-undo.
      354   define input  parameter p-parameter-list     as character    no-undo.
      355   define output parameter p-parameter-value   as logical      no-undo.
      356       if num-entries( p-parameter-list ) > p-parameter-number - 1
      357       then do:
      358           assign
      359               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      360           .
      361       end.
      362       else do:
      363           assign
      364               p-parameter-value   = no
      365           .
      366       end.
      367   end.
      368   end procedure.
      369   procedure schedule-attr-get-free-id :
      370   do
      371   on error undo, return error return-value
      372   :
      373     define input  parameter p-cre-db-num  as integer   no-undo.
      374     define input  parameter p-task-type   as character no-undo.
      375     define input  parameter p-task-num    as integer   no-undo.
      376     define output parameter p-free-id     as character no-undo.
      377     define buffer buf_schedule-attr for ub.schedule-attr.
      378     find first buf_schedule-attr no-lock
      379         where buf_schedule-attr.cre-db-num = p-cre-db-num
      380           and buf_schedule-attr.task-type  = p-task-type
      381           and buf_schedule-attr.task-num   = p-task-num
      382           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      383     no-error .
      384     if available buf_schedule-attr then
      385     assign
      386     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      387     no-error
      388     .
      389   end.
      390   end procedure.
      391   procedure schedule-attr-get-free-props :
      392     define input parameter p-free-id as character no-undo .
      393     define output parameter p-value as character no-undo .
      394     define buffer buf_temp-schedule-free for temp-schedule-free.
      395     do
      396     on error undo, return error return-value
      397     :
      398       find first buf_temp-schedule-free no-lock no-error .
      399       if not available buf_temp-schedule-free then do:
      400         run schedule-attr-fill-free-props in this-procedure .
      401       end.
      402       find first buf_temp-schedule-free where
      403               buf_temp-schedule-free.free-id = p-free-id no-error.
      404       if available buf_temp-schedule-free then do:
      405         assign
      406         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      407                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      408                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      409                   buf_temp-schedule-free.conf-param           + chr(4) +
      410                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      411                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      412                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      413                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      414                   buf_temp-schedule-free.other-info
      415         .
      416       end.
      417       else do:
      418        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      419                              "id произвольной задачи - &5"
      420                              ,vss-workfile
      421                              ,vss-revision
      422                              ,vss-description
      423                              ,chr(10)
      424                              ,p-free-id).
      425       end.
      426     end.
      427   end procedure.
      428   procedure schedule-attr-is-rum-free-id :
      429   define input parameter p-free-id as character no-undo .
      430   define output parameter p-is-rum as logical no-undo .
      431   define buffer buf_temp-schedule-free for temp-schedule-free.
      432   do
      433   on error undo, return error
      434   :
      435       find first buf_temp-schedule-free no-lock no-error .
      436       if not available buf_temp-schedule-free then do:
      437         run schedule-attr-fill-free-props in this-procedure .
      438       end.
      439       find first buf_temp-schedule-free where
      440               buf_temp-schedule-free.free-id = p-free-id no-error.
      441       if available buf_temp-schedule-free
      442       and buf_temp-schedule-free.is-rum
      443       then do:
      444         p-is-rum = yes.
      445       end.
      446   end.
      447   end procedure.
      448   procedure schedule-attr-fill-free-props :
      449   define variable v-path                    as character                no-undo .
      450   DEFINE VARIABLE v-full-path               as character                no-undo .
      451   DEFINE VARIABLE v-file-name               as character                no-undo .
      452   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      453   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      454   define buffer buf_temp-schedule-free for temp-schedule-free.
      455   define variable v-answer as logical no-undo .
      456     do
      457     on error undo, return error substitute("&1 &2 &3&4&5&4"
      458                                           ,vss-workfile
      459                                           ,vss-revision
      460                                           ,vss-description
      461                                           ,chr(10)
      462                                           ,error-status:get-message(1) )
      463     :
      464       run gbl/filename.p (
      465                       input 'cmp/shd-free.d'
      466                     ,output v-full-path
      467                     ,output v-path
      468                     ,output v-file-name
      469                     ,output v-file-name-no-ext
      470                     ,output v-file-name-ext
      471                     ) .
      472       input from value(v-full-path).
      473       repeat :
      474         create buf_temp-schedule-free.
      475         import buf_temp-schedule-free.
      476       END.
      477       input close.
      478       _ff:
      479       for each buf_temp-schedule-free :
      480         if buf_temp-schedule-free.free-id = '':U then do:
      481            delete buf_temp-schedule-free.
      482            next _ff.
      483          end.
      484          run schedule-attr-check-enc in this-procedure (
      485                                                       input  buf_temp-schedule-free.free-id
      486                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      487                                                               buf_temp-schedule-free.proc-param-edit-name +
      488                                                               buf_temp-schedule-free.conf-param +
      489                                                               string(buf_temp-schedule-free.is-gbd) +
      490                                                               string(buf_temp-schedule-free.is-ubd) +
      491                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      492                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      493                                                               string(buf_temp-schedule-free.other-info)
      494                                                               )
      495                                                       ,input  buf_temp-schedule-free.enc-key
      496                                                       ,output v-answer    ) no-error .
      497          if error-status:error
      498          or not v-answer then delete buf_temp-schedule-free.
      499        end.
      500     end.
      501   end procedure.
      502   Function schedule-attr-reverse returns character (str as character).
      503      define variable rev_incl_s as character init "" no-undo .
      504      define variable rev_incl_i as integer no-undo .
      505      define variable rev_incl_l as integer no-undo .
      506      rev_incl_l = length(str).
      507      do rev_incl_i = 1 to rev_incl_l:
      508         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      509      end.
      510      return rev_incl_s.
      511   end.
      512   procedure schedule-attr-check-enc.
      513     define input  parameter p-free-id   as character no-undo .
      514     define input  parameter p-value     as character no-undo .
      515     define input  parameter p-enc-value as character no-undo .
      516     define output parameter p-answer    as logical   no-undo .
      517     define variable tmp         as character no-undo .
      518     define variable v-enc-value as character no-undo .
      519     assign
      520     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      521     .
      522     run schedule-attr-pswd-enc in this-procedure
      523       ( input tmp
      524        ,output v-enc-value
      525       ) no-error .
      526     if error-status:error then do:
      527       message
      528         vss-workfile vss-revision vss-description skip
      529         "Ошибка при вызове процедуры pswd-enc" skip
      530         return-value skip
      531         error-status :get-message(1) skip
      532         view-as alert-box error .
      533       undo, return error .
      534     end.
      535     if v-enc-value = p-enc-value then do:
      536       assign
      537         p-answer = true
      538       .
      539     end.
      540     else do:
      541       assign
      542         p-answer = false
      543       .
      544     end.
      545   end.
      546   procedure schedule-attr-conf-enc.
      547     define input  parameter p-free-id   as character no-undo .
      548     define input  parameter p-value     as character no-undo .
      549     define output parameter p-enc-value as character no-undo .
      550     define variable tmp         as character no-undo .
      551     assign
      552       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      553     .
      554     run schedule-attr-pswd-enc in this-procedure
      555       ( input tmp
      556        ,output p-enc-value
      557       ) no-error .
      558     if error-status:error then do:
      559       message
      560         vss-workfile vss-revision vss-description skip
      561         "Ошибка при вызове процедуры pswd-enc" skip
      562         return-value skip
      563         error-status :get-message(1) skip
      564         view-as alert-box error .
      565       undo, return error .
      566     end.
      567   end procedure.
      568   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      569   procedure schedule-attr-pswd-enc :
      570     define input parameter  pswd     as character no-undo .
      571     define output parameter enc-pswd as character no-undo .
      572     do
      573     on error undo, return error return-value
      574     :
      575       assign
      576         enc-pswd = encode(pswd + string(index(pswd, "k")))
      577       .
      578     end.
      579   end procedure.
      580   run schedule-attr-value in this-procedure (input integer(p_db-num-char),
      581       input p_task-type,
      582       input p_task-num,
      583       input 'schedule-param-list':U,
      584       output v-param-list,
      585       output v-param-type).
      586   assign
      587       v-directory = entry(1,v-param-list,chr(4))
      588     v-place  = integer(entry(2,v-param-list,chr(4)))
      589        v-login = entry(3,v-param-list,chr(4))
      590       v-password = entry(4,v-param-list,chr(4))
      591       v-code_TNP =entry(5,v-param-list,chr(4))
      592       v-code_pool = entry(6,v-param-list,chr(4))
      593       v-code_system = integer(entry(7,v-param-list,chr(4)))
      594       v-long-code = integer (entry(8,v-param-list,chr(4)))
      595      NO-ERROR.
      596       run bge\exp-VBRR-p.p ( p_log-handle,
      597           v-directory,
      598           v-place,
      599           v-login,
      600           v-password,
      601           v-code_tnp,
      602           v-code_pool,
      603           v-code_system,
      604           v-long-code
      605           ) .
