      602   define buffer buf_clients for ub.clients.
      603   define variable v-host-name as character no-undo.
      604   DEFINE BUTTON bt-sel-obj
      605        IMAGE-UP FILE "btn-down-arrow":U
      606        IMAGE-DOWN FILE "btn-down-arrow":U
      607        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      608        LABEL "..."
      609        SIZE 3.6 BY 1.05.
      610   DEFINE BUTTON Btn_OK AUTO-GO
      611        LABEL "&Выход"
      612        SIZE 15 BY 1.14
      613        BGCOLOR 8 .
      614   DEFINE BUTTON Btn_save
      615        LABEL "Сохранить"
      616        SIZE 15 BY 1.14.
      617   DEFINE VARIABLE EDITOR-objects AS CHARACTER
      618        VIEW-AS EDITOR NO-BOX
      619        SIZE 45 BY 3.38
      620        FGCOLOR 1  NO-UNDO.
      621   DEFINE VARIABLE d_date AS DATE FORMAT "99/99/9999":U INITIAL today
      622        LABEL "Дата"
      623        VIEW-AS FILL-IN
      624        SIZE 12 BY .95 NO-UNDO.
      625   DEFINE VARIABLE i_op-id AS INTEGER INITIAL 1
      626        LABEL "operation-id"
      627        VIEW-AS FILL-IN
      628        SIZE 11 BY .95 NO-UNDO.
      629   DEFINE VARIABLE i_shift AS INTEGER FORMAT ">9":U INITIAL 0
      630        LABEL "Порядок смены"
      631        VIEW-AS FILL-IN
      632        SIZE 5 BY .95 NO-UNDO.
      633   DEFINE VARIABLE RADIO-SET_objects AS INTEGER
      634        VIEW-AS RADIO-SET VERTICAL
      635        RADIO-BUTTONS
      636             "по фирме", 1,
      637   "по объектам", 2
      638        SIZE 18 BY 3 NO-UNDO.
      639   DEFINE RECTANGLE RECT-1
      640        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      641        SIZE 69 BY 4.05.
      642   DEFINE FRAME Dialog-Frame
      643        Btn_OK AT ROW 1.24 COL 2
      644        Btn_save AT ROW 1.24 COL 18 WIDGET-ID 2
      645        d_date AT ROW 2.91 COL 7 COLON-ALIGNED WIDGET-ID 4
      646        i_shift AT ROW 2.91 COL 39 COLON-ALIGNED WIDGET-ID 6
      647        i_op-id AT ROW 2.91 COL 58 COLON-ALIGNED WIDGET-ID 20
      648        RADIO-SET_objects AT ROW 4.81 COL 4 NO-LABEL WIDGET-ID 8
      649        EDITOR-objects AT ROW 4.81 COL 25 NO-LABEL WIDGET-ID 14
      650        bt-sel-obj AT ROW 6.48 COL 21 WIDGET-ID 18
      651        RECT-1 AT ROW 4.33 COL 2 WIDGET-ID 12
      652        SPACE(1.19) SKIP(0.23)
      653       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      654            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      655            TITLE "Изменение даты выгрузки данных в SAP"
      656            DEFAULT-BUTTON Btn_OK WIDGET-ID 100.
      657   ASSIGN
      658          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      659          FRAME Dialog-Frame:HIDDEN           = TRUE.
      660   ASSIGN
      661          i_op-id:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      662   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      663   DO:
      664     APPLY "END-ERROR":U TO SELF.
      665   END.
      666   ON CHOOSE OF bt-sel-obj IN FRAME Dialog-Frame
      667   DO:
      668       define variable v-obj-list as character no-undo.
      669       define variable v-exclude-obj-list as character no-undo.
      670       define variable v-object-available as logical no-undo.
      671       RADIO-SET_objects:screen-value = "2".
      672   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      673   run userobjs_clear in this-procedure  .
      674   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      675   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
      676     (input  v-cntxt-db-num
      677     ,input  0
      678     ,input  v-cntxt-userid
      679     ,input  v-cntxt-obj-type
      680     ,input  v-cntxt-obj-code
      681     ,output v-object-available
      682     ) no-error .
      683       if error-status :error then do:
      684           message vss-workfile vss-revision vss-description skip
      685           "Ошибка при вызове процедуры gbl/usobjava.i" skip
      686           error-status :get-message(1) skip
      687           return-value skip
      688           view-as alert-box error.
      689           undo, return no-apply.
      690       end.
      691       if v-object-available = true then do:
      692   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      693   run userobjs_append in this-procedure
      694     (input  v-cntxt-obj-type
      695     ,input  v-cntxt-obj-code
      696     )  .
      697       end.
      698       define variable v-user-select as logical no-undo.
      699   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      700   run userobjs_select-many in this-procedure
      701     (input  parparentproc
      702     ,input  v-cntxt-db-num
      703     ,input  v-cntxt-userid
      704     ,input  v-cntxt-host-code-obj
      705     ,input  v-cntxt-obj-type
      706     ,input  v-cntxt-obj-code
      707     ,output v-user-select
      708     )  .
      709       if v-user-select <> true then do:
      710         message "Объект не выбран" view-as alert-box information.
      711         return no-apply.
      712       end.
      713       v-obj-list = "".
      714       for each userobjs_temp-user-obj:
      715           v-obj-list = v-obj-list + (if v-obj-list <> "" then ", " else "")
      716                      + userobjs_temp-user-obj.obj-type + string( userobjs_temp-user-obj.obj-code).
      717       end.
      718       EDITOR-objects :screen-value = v-obj-list.
      719   END.
      720   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      721   DO:
      722       APPLY "GO" TO FRAME Dialog-Frame.
      723   END.
      724   ON CHOOSE OF Btn_save IN FRAME Dialog-Frame
      725   DO:
      726       ASSIGN
      727       d_date
      728       i_shift
      729       i_op-id
      730       RADIO-SET_objects.
      731       if d_date = ? then do:
      732           message "Введите дату." view-as alert-box.
      733           return.
      734       end.
      735       case RADIO-SET_objects:
      736           when 1 then do:
      737               for each buf_clients no-lock where buf_clients.host-code = v-cntxt-host-code-obj:
      738                   run clntattr-write in this-procedure (input buf_clients.obj-type
      739                                                        ,input buf_clients.obj-code
      740                                                        ,input 'bge-sap-sng-last-shift':U
      741                                                        ,input substitute ("&1,&2,&3",d_date ,i_shift,i_op-id)).
      742               end.
      743           end.
      744           when 2 then do:
      745               for each userobjs_temp-user-obj no-lock:
      746                   run clntattr-write in this-procedure (input userobjs_temp-user-obj.obj-type
      747                                                        ,input userobjs_temp-user-obj.obj-code
      748                                                        ,input 'bge-sap-sng-last-shift':U
      749                                                        ,input substitute ("&1,&2,&3",d_date ,i_shift,i_op-id)).
      750               end.
      751           end.
      752       end case.
      753   APPLY "GO" TO FRAME Dialog-Frame.
      754   END.
      755   ON VALUE-CHANGED OF RADIO-SET_objects IN FRAME Dialog-Frame
      756   DO:
      757       case RADIO-SET_objects :screen-value in frame Dialog-frame:
      758           when "1" then  EDITOR-objects:screen-value = v-host-name.
      759           when "2" then do:
      760               for each userobjs_temp-user-obj:
      761                   delete userobjs_temp-user-obj.
      762               end.
      763               create userobjs_temp-user-obj.
      764               assign
      765                   userobjs_temp-user-obj.obj-type = v-cntxt-obj-type
      766                   userobjs_temp-user-obj.obj-code = v-cntxt-obj-code
      767                   EDITOR-objects:screen-value = v-cntxt-obj-type + string(v-cntxt-obj-code).
      768           end.
      769       end case.
      770   END.
      771   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      772   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      773   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      774   on ' ' of d_date in frame Dialog-Frame
      775   do:
      776     if (can-query (self, "sensitive")
      777        and
      778        self :sensitive = true
      779        )
      780     or (can-query (self, "read-only")
      781        and
      782        self :read-only = false
      783        )
      784     then do:
      785       assign
      786         self :screen-value = ?
      787       .
      788     end.
      789     return no-apply.
      790   end.
      791   on delete-character of d_date in frame Dialog-Frame
      792   do:
      793     if (can-query (self, "sensitive")
      794        and
      795        self :sensitive = true
      796        )
      797     or (can-query (self, "read-only")
      798        and
      799        self :read-only = false
      800        )
      801     then do:
      802       assign
      803         self :screen-value = ?
      804       .
      805     end.
      806     return no-apply.
      807   end.
      808   on ctrl-d of d_date in frame Dialog-Frame
      809   do:
      810     define variable v-curr-sv-date as date no-undo .
      811     if (can-query (self, "sensitive")
      812        and
      813        self :sensitive = true
      814        )
      815     or (can-query (self, "read-only")
      816        and
      817        self :read-only = false
      818        )
      819     then do:
      820       if self :handle <> focus :handle
      821       then do:
      822         apply "entry":u to self .
      823       end.
      824       run gbl/getcurdt.p
      825         (output v-curr-sv-date
      826         ) .
      827       assign
      828         self :screen-value = string(v-curr-sv-date) .
      829       .
      830     end.
      831     return no-apply.
      832   end.
      833   on ctrl-b of d_date in frame Dialog-Frame
      834   do:
      835     if (can-query (self, "sensitive")
      836        and
      837        self :sensitive = true
      838        )
      839     or (can-query (self, "read-only")
      840        and
      841        self :read-only = false
      842        )
      843     then do:
      844       if self :handle <> focus :handle
      845       then do:
      846         apply "entry":u to self .
      847       end.
      848       define variable v-curr-sv-date as date no-undo .
      849       define variable v-new-sv-date  as date no-undo .
      850       assign
      851         v-curr-sv-date = date(self :screen-value) no-error
      852       .
      853       if v-curr-sv-date = ?
      854       then do:
      855         run gbl/getcurdt.p
      856           (output v-curr-sv-date
      857           ) .
      858       end.
      859       if v-curr-sv-date <> ?
      860       then do:
      861         assign
      862           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      863         .
      864         assign
      865           self :screen-value = string(v-new-sv-date) .
      866         .
      867       end.
      868     end.
      869     return no-apply .
      870   end.
      871   on ctrl-e of d_date in frame Dialog-Frame
      872   do:
      873     if (can-query (self, "sensitive")
      874        and
      875        self :sensitive = true
      876        )
      877     or (can-query (self, "read-only")
      878        and
      879        self :read-only = false
      880        )
      881     then do:
      882       if self :handle <> focus :handle
      883       then do:
      884         apply "entry":u to self .
      885       end.
      886       define variable v-curr-sv-date as date no-undo .
      887       define variable v-new-sv-date  as date no-undo .
      888       assign
      889         v-curr-sv-date = date(self :screen-value) no-error
      890       .
      891       if v-curr-sv-date = ?
      892       then do:
      893         run gbl/getcurdt.p
      894           (output v-curr-sv-date
      895           ) .
      896       end.
      897       if v-curr-sv-date <> ?
      898       then do:
      899         run gbl/lastdate.p
      900           (input  v-curr-sv-date
      901           ,output v-new-sv-date
      902           ).
      903         assign
      904           self :screen-value = string(v-new-sv-date) .
      905         .
      906       end.
      907     end.
      908     return no-apply .
      909   end.
      910   on ctrl-f of d_date in frame Dialog-Frame
      911   do:
      912     if (can-query (self, "sensitive")
      913        and
      914        self :sensitive = true
      915        )
      916     or (can-query (self, "read-only")
      917        and
      918        self :read-only = false
      919        )
      920     then do:
      921       if self :handle <> focus :handle
      922       then do:
      923         apply "entry":u to self .
      924       end.
      925       define variable v-ok            as logical   no-undo .
      926       define variable v-curr-sv-date  as date      no-undo .
      927       define variable v-description   as character no-undo .
      928       assign
      929         v-curr-sv-date = date(self :screen-value) no-error
      930       .
      931       if v-curr-sv-date = ?
      932       then do:
      933         run gbl/getcurdt.p
      934           (output v-curr-sv-date
      935           ) .
      936       end.
      937       if v-curr-sv-date <> ?
      938       then do:
      939         run gbl/d-inpday.w
      940           (input ?
      941           ,input "Выбор даты"
      942           ,input v-description
      943           ,input ""
      944           ,input-output v-curr-sv-date
      945           ,output v-ok
      946           ).
      947         if v-ok = true
      948         then do:
      949           assign
      950             self :screen-value = string(v-curr-sv-date) .
      951           .
      952         end.
      953       end.
      954     end.
      955     return no-apply .
      956   end.
      957     define MENU m-ed-date8
      958       MENU-ITEM m-ed-date8-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      959       MENU-ITEM m-ed-date8-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      960       MENU-ITEM m-ed-date8-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      961       MENU-ITEM m-ed-date8-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      962       .
      963     if d_date :POPUP-MENU in frame Dialog-Frame = ?
      964     then do:
      965       ASSIGN
      966         d_date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date8 :HANDLE
      967         d_date :MENU-MOUSE in frame Dialog-Frame = 3
      968       .
      969     end.
      970     define variable v-label-handle8 as handle no-undo .
      971     assign
      972       v-label-handle8 = d_date :side-label-handle in frame Dialog-Frame
      973     .
      974     if valid-handle (v-label-handle8)
      975     then do:
      976       if v-label-handle8 :tooltip = ""
      977       or v-label-handle8 :tooltip = ?
      978       then do:
      979         assign
      980           v-label-handle8 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      981         .
      982       end.
      983     end.
      984     ON CHOOSE OF MENU-ITEM m-ed-date8-1 in menu m-ed-date8 DO:
      985       apply "ctrl-b":U to d_date in frame Dialog-Frame .
      986     END.
      987     ON CHOOSE OF MENU-ITEM m-ed-date8-2 in menu m-ed-date8 DO:
      988       apply "ctrl-d":U to d_date in frame Dialog-Frame .
      989     END.
      990     ON CHOOSE OF MENU-ITEM m-ed-date8-3 in menu m-ed-date8 DO:
      991       apply "ctrl-e":U to d_date in frame Dialog-Frame .
      992     END.
      993     ON CHOOSE OF MENU-ITEM m-ed-date8-4 in menu m-ed-date8 DO:
      994       apply "ctrl-f":U to d_date in frame Dialog-Frame .
      995     END.
      996   MAIN-BLOCK:
      997   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      998      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      999   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1000     run mainmenu_getcntxt in parparentproc
     1001       (output v-cntxt-db-num
     1002       ,output v-cntxt-userid
     1003       ,output v-cntxt-level
     1004       ,output v-cntxt-host-code-obj
     1005       ,output v-cntxt-obj-type
     1006       ,output v-cntxt-obj-code
     1007       ,output v-cntxt-db-num-obj
     1008       ,output v-cntxt-is-admin
     1009       ) .
     1010     run get-host-name in this-procedure ( output v-host-name ) no-error .
     1011     if error-status :error
     1012     then do:
     1013         message
     1014           vss-workfile vss-revision vss-description
     1015           skip "Ошибка при определении имени фирмы"
     1016           skip "Код фирмы:" v-cntxt-host-code-obj
     1017           skip "Имя фирмы будет отображаться как '" + 'орг':U + string( v-cntxt-host-code-obj ) + "'"
     1018           skip return-value
     1019           skip trim(error-status :get-message(1))
     1020                trim(error-status :get-message(2))
     1021                trim(error-status :get-message(3))
     1022                trim(error-status :get-message(4))
     1023                trim(error-status :get-message(5))
     1024         view-as alert-box warning.
     1025         assign
     1026             v-host-name = 'орг':U + string(v-cntxt-host-code-obj).
     1027       end.
     1028     run get-values in this-procedure.
     1029     RUN enable_UI.
     1030     WAIT-FOR GO OF FRAME Dialog-Frame.
     1031   END.
     1032   RUN disable_UI.
     1033   PROCEDURE disable_UI :
     1034     HIDE FRAME Dialog-Frame.
     1035   END PROCEDURE.
     1036   PROCEDURE enable_UI :
     1037     DISPLAY d_date i_shift i_op-id RADIO-SET_objects EDITOR-objects
     1038         WITH FRAME Dialog-Frame.
     1039     ENABLE RECT-1 Btn_OK Btn_save d_date i_shift i_op-id RADIO-SET_objects
     1040            bt-sel-obj
     1041         WITH FRAME Dialog-Frame.
     1042     VIEW FRAME Dialog-Frame.
     1043   END PROCEDURE.
     1044   PROCEDURE get-host-name :
     1045   do on error undo, return error:
     1046   define output parameter p-host-name as character no-undo.
     1047   define buffer buf_clients for ub.clients.
     1048       find first buf_clients no-lock where buf_clients.obj-type = 'орг':U
     1049                                        and buf_clients.obj-code = v-cntxt-host-code-obj no-error.
     1050       if not available buf_clients then do:
     1051           message vss-workfile vss-revision vss-description skip
     1052             "Не удалось найти текущую фирму" skip
     1053             return-value skip
     1054             trim(error-status :get-message(1))
     1055             trim(error-status :get-message(2))
     1056             trim(error-status :get-message(3))
     1057             trim(error-status :get-message(4))
     1058             trim(error-status :get-message(5))
     1059           view-as alert-box error.
     1060           undo, return error.
     1061       end.
     1062       else do:
     1063           p-host-name = buf_clients.obj-name.
     1064       end.
     1065   end.
     1066   END PROCEDURE.
     1067   PROCEDURE get-values :
     1068       define variable c_value as character no-undo.
     1069       define variable c_type as character no-undo.
     1070       do on error undo, return error:
     1071           run clntattr-value in this-procedure (input v-cntxt-obj-type
     1072                                                ,input v-cntxt-obj-code
     1073                                                ,input 'bge-sap-sng-last-shift':U
     1074                                                ,output c_value
     1075                                                ,output c_type).
     1076           if num-entries(c_value,",") = 3 then do:
     1077               assign
     1078                   RADIO-SET_objects:screen-value in frame dialog-frame = "2"
     1079                   EDITOR-objects :screen-value in frame Dialog-frame = v-cntxt-obj-type + string( v-cntxt-obj-code ).
     1080               assign
     1081                   EDITOR-objects
     1082                   RADIO-SET_objects
     1083                   d_date = date(entry(1,c_value,","))
     1084                   i_shift = integer(entry(2,c_value,","))
     1085                   i_op-id = integer(entry(3,c_value,",")) no-error.
     1086               display d_date i_shift with frame Dialog-Frame.
     1087           create userobjs_temp-user-obj.
     1088           assign userobjs_temp-user-obj.obj-code = v-cntxt-obj-code
     1089                  userobjs_temp-user-obj.obj-type = v-cntxt-obj-type.
     1090           end.
     1091       end.
     1092   END PROCEDURE.
