      398   procedure schedule-attr-name :
      399   do
      400     on error undo, return error
      401     :
      402     define input  parameter p-code           as character no-undo .
      403     define output parameter p-type           as character no-undo .
      404     define output parameter p-format         as character no-undo .
      405     define output parameter p-label          as character no-undo .
      406     define output parameter p-user-can-edit  as logical   no-undo .
      407     define output parameter p-output-display as logical   no-undo .
      408     define output parameter p-other          as character no-undo .
      409       if index(p-code, chr(4)) > 0 then do:
      410         p-code = entry(1, p-code, chr(4)).
      411       end.
      412       case p-code :
      413               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      414               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      415               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      416               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      417               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      418               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      419               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      420               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      421               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      422         otherwise do:
      423           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      424         end.
      425       end.
      426     end.
      427   end procedure.
      428   procedure schedule-attr-tooltip :
      429   do
      430     on error undo, return error
      431     :
      432       define input  parameter p-code    as character no-undo .
      433       define output parameter p-tooltip as character no-undo .
      434       define output parameter p-label   as character no-undo .
      435       if index(p-code, chr(4)) > 0 then do:
      436         p-code = entry(1, p-code, chr(4)).
      437       end.
      438       case p-code :
      439               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      440               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      441               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      442               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      443               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      444               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      445               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      446               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      447               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      448         otherwise do:
      449               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      450         end.
      451       end.
      452     end.
      453   end procedure.
      454   procedure schedule-attr-value :
      455   do
      456   on error undo, return error return-value
      457   :
      458   define input parameter  p-cre-db-num as integer    no-undo.
      459   define input parameter  p-task-type  as character  no-undo.
      460   define input parameter  p-task-num   as integer    no-undo.
      461   define input parameter  p-code       as character  no-undo.
      462   define output parameter p-value      as character  no-undo.
      463   define output parameter p-type       as character  no-undo.
      464       define variable v-format         as character no-undo .
      465       define variable v-label          as character no-undo .
      466       define variable v-user-can-edit  as logical   no-undo .
      467       define variable v-output-display as logical   no-undo .
      468       define variable v-other          as character no-undo .
      469       define buffer buf_schedule-attr for ub.schedule-attr.
      470       run schedule-attr-name in this-procedure (
      471             input  p-code
      472           , output p-type
      473           , output v-format
      474           , output v-label
      475           , output v-user-can-edit
      476           , output v-output-display
      477           , output v-other
      478       ) no-error .
      479       if error-status :error
      480       then do:
      481           undo, return error return-value .
      482       end.
      483       if p-code begins ('schd-free-id':U + chr(4))
      484       and entry(2, p-code, chr(4)) = '':U then do:
      485         find first buf_schedule-attr no-lock
      486             where buf_schedule-attr.cre-db-num = p-cre-db-num
      487               and buf_schedule-attr.task-type  = p-task-type
      488               and buf_schedule-attr.task-num   = p-task-num
      489               and buf_schedule-attr.attr-code  begins p-code
      490         no-error .
      491       end.
      492       else do:
      493         find first buf_schedule-attr no-lock
      494             where buf_schedule-attr.cre-db-num = p-cre-db-num
      495               and buf_schedule-attr.task-type  = p-task-type
      496               and buf_schedule-attr.task-num   = p-task-num
      497               and buf_schedule-attr.attr-code  = p-code
      498         no-error .
      499       end.
      500       if available buf_schedule-attr
      501       then do:
      502           assign
      503               p-value = buf_schedule-attr.attr-value
      504           .
      505       end.
      506       else do:
      507         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      508            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      509         end.
      510         else do:
      511           assign
      512               p-value = if p-type = 'L':U then "no":U else ""
      513           .
      514         end.
      515       end.
      516   end.
      517   end procedure.
      518   procedure schedule-attr-write :
      519   do
      520   on error undo, return error
      521   :
      522   define input parameter p-cre-db-num  as integer   no-undo.
      523   define input parameter p-task-type   as character no-undo.
      524   define input parameter p-task-num    as integer   no-undo.
      525   define input parameter p-code        as character no-undo.
      526   define input parameter p-value       as character no-undo.
      527       define variable v-type              as character                no-undo.
      528       define variable v-format            as character                no-undo.
      529       define variable v-label             as character                no-undo.
      530       define variable v-user-can-edit     as logical                  no-undo.
      531       define variable v-output-display    as logical                  no-undo.
      532       define variable v-other             as character                no-undo.
      533       define buffer buf_schedule-attr for ub.schedule-attr .
      534       run schedule-attr-name in this-procedure (
      535             input  p-code
      536           , output v-type
      537           , output v-format
      538           , output v-label
      539           , output v-user-can-edit
      540           , output v-output-display
      541           , output v-other
      542       ) no-error.
      543       if error-status :error
      544       then do:
      545           undo, return error return-value.
      546       end.
      547       find first buf_schedule-attr exclusive-lock
      548            where buf_schedule-attr.cre-db-num = p-cre-db-num
      549              and buf_schedule-attr.task-type  = p-task-type
      550              and buf_schedule-attr.task-num   = p-task-num
      551              and buf_schedule-attr.attr-code  = p-code
      552       no-error.
      553       if not available buf_schedule-attr
      554       then do:
      555           create buf_schedule-attr.
      556           assign
      557             buf_schedule-attr.cre-db-num = p-cre-db-num
      558             buf_schedule-attr.task-type  = p-task-type
      559             buf_schedule-attr.task-num   = p-task-num
      560             buf_schedule-attr.attr-code  = p-code
      561             buf_schedule-attr.attr-value = p-value
      562           .
      563       end.
      564       else do:
      565           assign
      566               buf_schedule-attr.attr-value = p-value
      567           .
      568       end.
      569   end.
      570   end procedure.
      571   procedure schedule-attr-delete :
      572   do
      573   on error undo, return error
      574   :
      575   define input  parameter p-cre-db-num  as integer   no-undo.
      576   define input  parameter p-task-type   as character no-undo.
      577   define input  parameter p-task-num    as integer   no-undo.
      578   define input  parameter p-code        as character no-undo.
      579   define output parameter p-deleted     as logical   no-undo.
      580       define buffer buf_schedule-attr for ub.schedule-attr .
      581       define variable v-type              as character                no-undo.
      582       define variable v-format            as character                no-undo.
      583       define variable v-label             as character                no-undo.
      584       define variable v-user-can-edit     as logical                  no-undo.
      585       define variable v-output-display    as logical                  no-undo.
      586       define variable v-other             as character                no-undo.
      587       run schedule-attr-name in this-procedure (
      588             input p-code
      589           , output v-type
      590           , output v-format
      591           , output v-label
      592           , output v-user-can-edit
      593           , output v-output-display
      594           , output v-other
      595       ) no-error .
      596       if error-status :error
      597       then do:
      598           undo, return error return-value .
      599       end.
      600       find first buf_schedule-attr exclusive-lock
      601            where buf_schedule-attr.cre-db-num = p-cre-db-num
      602              and buf_schedule-attr.task-type  = p-task-type
      603              and buf_schedule-attr.task-num   = p-task-num
      604              and buf_schedule-attr.attr-code  = p-code
      605       no-error.
      606       if not available buf_schedule-attr
      607       then do:
      608           assign
      609               p-deleted = no
      610           .
      611       end.
      612       else do:
      613           delete buf_schedule-attr.
      614           assign
      615               p-deleted = yes
      616           .
      617       end.
      618   end.
      619   end procedure.
      620   procedure schedule-attr-news :
      621   do
      622   on error undo, return error
      623   :
      624       define input  parameter p-code           as character no-undo .
      625       define output parameter p-news           as logical   no-undo .
      626       if index(p-code, chr(4)) > 0 then do:
      627         p-code = entry(1, p-code, chr(4)).
      628       end.
      629       case p-code :
      630               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      631               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      632               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      633               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      634               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      635               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      636               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      637               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      638               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      639         otherwise do:
      640           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      641         end.
      642       end.
      643   end.
      644   end procedure.
      645   procedure schedule-attr-extract-logical :
      646   do
      647   on error undo, return error
      648   :
      649   define input  parameter p-parameter-number   as integer      no-undo.
      650   define input  parameter p-parameter-list     as character    no-undo.
      651   define output parameter p-parameter-value   as logical      no-undo.
      652       if num-entries( p-parameter-list ) > p-parameter-number - 1
      653       then do:
      654           assign
      655               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      656           .
      657       end.
      658       else do:
      659           assign
      660               p-parameter-value   = no
      661           .
      662       end.
      663   end.
      664   end procedure.
      665   procedure schedule-attr-get-free-id :
      666   do
      667   on error undo, return error return-value
      668   :
      669     define input  parameter p-cre-db-num  as integer   no-undo.
      670     define input  parameter p-task-type   as character no-undo.
      671     define input  parameter p-task-num    as integer   no-undo.
      672     define output parameter p-free-id     as character no-undo.
      673     define buffer buf_schedule-attr for ub.schedule-attr.
      674     find first buf_schedule-attr no-lock
      675         where buf_schedule-attr.cre-db-num = p-cre-db-num
      676           and buf_schedule-attr.task-type  = p-task-type
      677           and buf_schedule-attr.task-num   = p-task-num
      678           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      679     no-error .
      680     if available buf_schedule-attr then
      681     assign
      682     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      683     no-error
      684     .
      685   end.
      686   end procedure.
      687   procedure schedule-attr-get-free-props :
      688     define input parameter p-free-id as character no-undo .
      689     define output parameter p-value as character no-undo .
      690     define buffer buf_temp-schedule-free for temp-schedule-free.
      691     do
      692     on error undo, return error return-value
      693     :
      694       find first buf_temp-schedule-free no-lock no-error .
      695       if not available buf_temp-schedule-free then do:
      696         run schedule-attr-fill-free-props in this-procedure .
      697       end.
      698       find first buf_temp-schedule-free where
      699               buf_temp-schedule-free.free-id = p-free-id no-error.
      700       if available buf_temp-schedule-free then do:
      701         assign
      702         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      703                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      704                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      705                   buf_temp-schedule-free.conf-param           + chr(4) +
      706                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      707                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      708                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      709                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      710                   buf_temp-schedule-free.other-info
      711         .
      712       end.
      713       else do:
      714        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      715                              "id произвольной задачи - &5"
      716                              ,vss-workfile
      717                              ,vss-revision
      718                              ,vss-description
      719                              ,chr(10)
      720                              ,p-free-id).
      721       end.
      722     end.
      723   end procedure.
      724   procedure schedule-attr-is-rum-free-id :
      725   define input parameter p-free-id as character no-undo .
      726   define output parameter p-is-rum as logical no-undo .
      727   define buffer buf_temp-schedule-free for temp-schedule-free.
      728   do
      729   on error undo, return error
      730   :
      731       find first buf_temp-schedule-free no-lock no-error .
      732       if not available buf_temp-schedule-free then do:
      733         run schedule-attr-fill-free-props in this-procedure .
      734       end.
      735       find first buf_temp-schedule-free where
      736               buf_temp-schedule-free.free-id = p-free-id no-error.
      737       if available buf_temp-schedule-free
      738       and buf_temp-schedule-free.is-rum
      739       then do:
      740         p-is-rum = yes.
      741       end.
      742   end.
      743   end procedure.
      744   procedure schedule-attr-fill-free-props :
      745   define variable v-path                    as character                no-undo .
      746   DEFINE VARIABLE v-full-path               as character                no-undo .
      747   DEFINE VARIABLE v-file-name               as character                no-undo .
      748   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      749   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      750   define buffer buf_temp-schedule-free for temp-schedule-free.
      751   define variable v-answer as logical no-undo .
      752     do
      753     on error undo, return error substitute("&1 &2 &3&4&5&4"
      754                                           ,vss-workfile
      755                                           ,vss-revision
      756                                           ,vss-description
      757                                           ,chr(10)
      758                                           ,error-status:get-message(1) )
      759     :
      760       run gbl/filename.p (
      761                       input 'cmp/shd-free.d'
      762                     ,output v-full-path
      763                     ,output v-path
      764                     ,output v-file-name
      765                     ,output v-file-name-no-ext
      766                     ,output v-file-name-ext
      767                     ) .
      768       input from value(v-full-path).
      769       repeat :
      770         create buf_temp-schedule-free.
      771         import buf_temp-schedule-free.
      772       END.
      773       input close.
      774       _ff:
      775       for each buf_temp-schedule-free :
      776         if buf_temp-schedule-free.free-id = '':U then do:
      777            delete buf_temp-schedule-free.
      778            next _ff.
      779          end.
      780          run schedule-attr-check-enc in this-procedure (
      781                                                       input  buf_temp-schedule-free.free-id
      782                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      783                                                               buf_temp-schedule-free.proc-param-edit-name +
      784                                                               buf_temp-schedule-free.conf-param +
      785                                                               string(buf_temp-schedule-free.is-gbd) +
      786                                                               string(buf_temp-schedule-free.is-ubd) +
      787                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      788                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      789                                                               string(buf_temp-schedule-free.other-info)
      790                                                               )
      791                                                       ,input  buf_temp-schedule-free.enc-key
      792                                                       ,output v-answer    ) no-error .
      793          if error-status:error
      794          or not v-answer then delete buf_temp-schedule-free.
      795        end.
      796     end.
      797   end procedure.
      798   Function schedule-attr-reverse returns character (str as character).
      799      define variable rev_incl_s as character init "" no-undo .
      800      define variable rev_incl_i as integer no-undo .
      801      define variable rev_incl_l as integer no-undo .
      802      rev_incl_l = length(str).
      803      do rev_incl_i = 1 to rev_incl_l:
      804         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      805      end.
      806      return rev_incl_s.
      807   end.
      808   procedure schedule-attr-check-enc.
      809     define input  parameter p-free-id   as character no-undo .
      810     define input  parameter p-value     as character no-undo .
      811     define input  parameter p-enc-value as character no-undo .
      812     define output parameter p-answer    as logical   no-undo .
      813     define variable tmp         as character no-undo .
      814     define variable v-enc-value as character no-undo .
      815     assign
      816     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      817     .
      818     run schedule-attr-pswd-enc in this-procedure
      819       ( input tmp
      820        ,output v-enc-value
      821       ) no-error .
      822     if error-status:error then do:
      823       message
      824         vss-workfile vss-revision vss-description skip
      825         "Ошибка при вызове процедуры pswd-enc" skip
      826         return-value skip
      827         error-status :get-message(1) skip
      828         view-as alert-box error .
      829       undo, return error .
      830     end.
      831     if v-enc-value = p-enc-value then do:
      832       assign
      833         p-answer = true
      834       .
      835     end.
      836     else do:
      837       assign
      838         p-answer = false
      839       .
      840     end.
      841   end.
      842   procedure schedule-attr-conf-enc.
      843     define input  parameter p-free-id   as character no-undo .
      844     define input  parameter p-value     as character no-undo .
      845     define output parameter p-enc-value as character no-undo .
      846     define variable tmp         as character no-undo .
      847     assign
      848       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      849     .
      850     run schedule-attr-pswd-enc in this-procedure
      851       ( input tmp
      852        ,output p-enc-value
      853       ) no-error .
      854     if error-status:error then do:
      855       message
      856         vss-workfile vss-revision vss-description skip
      857         "Ошибка при вызове процедуры pswd-enc" skip
      858         return-value skip
      859         error-status :get-message(1) skip
      860         view-as alert-box error .
      861       undo, return error .
      862     end.
      863   end procedure.
      864   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      865   procedure schedule-attr-pswd-enc :
      866     define input parameter  pswd     as character no-undo .
      867     define output parameter enc-pswd as character no-undo .
      868     do
      869     on error undo, return error return-value
      870     :
      871       assign
      872         enc-pswd = encode(pswd + string(index(pswd, "k")))
      873       .
      874     end.
      875   end procedure.
      876   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      877   procedure cur-time :
      878      define output parameter p-today as date      no-undo .
      879      define output parameter p-time  as integer   no-undo .
      880     do
      881     on error undo, return error
      882     :
      883       define variable v-date1 as date      no-undo .
      884       define variable v-date2 as date      no-undo .
      885       define variable v-time  as integer   no-undo .
      886       assign
      887         v-date1 = today
      888         v-time  = time
      889         v-date2 = today
      890       .
      891       if v-date1 <> v-date2
      892       then do:
      893         assign
      894           v-date1 = today
      895           v-time  = v-time
      896         .
      897       end.
      898       assign
      899         p-today = v-date1
      900         p-time  = v-time
      901       .
      902     end.
      903   end.
      904   function cur-time-date returns character
      905   :
      906     return string(today, '99/99/9999':U) .
      907   end.
      908   function cur-time-mjd returns decimal
      909   :
      910     define variable v-date as date      no-undo .
      911     define variable v-time as integer   no-undo .
      912     run cur-time in this-procedure
      913       (output v-date
      914       ,output v-time
      915       ) .
      916     return integer(v-date) - 2400002 + (v-time / 86400) .
      917   end.
      918   function cur-time-get-ending-index returns integer
      919   (input p-number as integer
      920   )
      921   :
      922     if p-number < 0
      923     or p-number = ?
      924     then do:
      925       return 1 .
      926     end.
      927     define variable v-rest as integer   no-undo .
      928     assign
      929       p-number = p-number modulo 100
      930     .
      931     if p-number < 20
      932     then do:
      933       assign
      934         v-rest = p-number
      935       .
      936     end.
      937     else do:
      938       assign
      939         v-rest = p-number modulo 10
      940       .
      941     end.
      942     case v-rest :
      943       when 1
      944       then do:
      945         return 2 .
      946       end.
      947       when 2 or
      948       when 3 or
      949       when 4
      950       then do:
      951         return 3 .
      952       end.
      953       otherwise do:
      954         return 1 .
      955       end.
      956     end case .
      957   end.
      958   procedure cur-time-mjd-to-date :
      959      define input  parameter i-mjd-diff as decimal no-undo.
      960      define output parameter o-Date     as date    no-undo.
      961      define output parameter o-Time     as integer no-undo.
      962      define variable v-day-number as integer   no-undo .
      963      if    i-mjd-diff < 0
      964         or i-mjd-diff = ?
      965      then do:
      966         return "?" .
      967      end.
      968      assign
      969         v-day-number = truncate(i-mjd-diff,0).
      970         o-Date = date(v-day-number + 2400002).
      971         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      972     .
      973   end.
      974   function cur-time-mjd-to-string returns character
      975   (input p-mjd-diff as decimal
      976   )
      977   :
      978     define variable v-day-number as integer   no-undo .
      979     define variable v-seconds    as integer   no-undo .
      980     define variable v-hour       as integer   no-undo .
      981     define variable v-min        as integer   no-undo .
      982     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      983     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      984     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      985     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      986     if p-mjd-diff < 0
      987     or p-mjd-diff = ?
      988     then do:
      989       return "?" .
      990     end.
      991     assign
      992       v-day-number = integer(truncate(p-mjd-diff,0))
      993       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      994     .
      995     if v-seconds > 86400
      996     then do:
      997       assign
      998         v-seconds = 86400 - 1
      999       .
     1000     end.
     1001     if v-seconds < 0
     1002     then do:
     1003       assign
     1004         v-seconds = 0
     1005       .
     1006     end.
     1007     assign
     1008       v-hour = truncate(v-seconds / 3600, 0)
     1009     .
     1010     assign
     1011       v-seconds = v-seconds modulo 3600
     1012     .
     1013     assign
     1014       v-min = truncate(v-seconds / 60, 0)
     1015     .
     1016     assign
     1017       v-seconds = v-seconds modulo 60
     1018     .
     1019     return
     1020         (if v-day-number <> 0
     1021           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1022           else ""
     1023         )
     1024       + (if v-day-number <> 0 or v-hour <> 0
     1025           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1026           else ""
     1027         )
     1028       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1029           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1030           else ""
     1031         )
     1032       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1033       .
     1034   end.
     1035   function cur-time-string returns character
     1036   :
     1037     define variable v-date as date      no-undo .
     1038     define variable v-time as integer   no-undo .
     1039     run cur-time in this-procedure
     1040       (output v-date
     1041       ,output v-time
     1042       ) .
     1043     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1044   end.
     1045   function cur-time-string-sec returns character
     1046   :
     1047     define variable v-date as date      no-undo .
     1048     define variable v-time as integer   no-undo .
     1049     run cur-time in this-procedure
     1050       (output v-date
     1051       ,output v-time
     1052       ) .
     1053     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1054   end.
     1055   function cur-time-custom  returns character
     1056   (input p-prefix as character
     1057   ,input p-date-format as character
     1058   ,input p-delimiter as character
     1059   ,input p-time-format as character
     1060   ,input p-suffix as character
     1061   )
     1062   :
     1063     define variable v-date as date      no-undo .
     1064     define variable v-time as integer   no-undo .
     1065     run cur-time in this-procedure
     1066       (output v-date
     1067       ,output v-time
     1068       ) .
     1069     return
     1070       p-prefix
     1071       + string(v-date, p-date-format)
     1072       + p-delimiter
     1073       + string(v-time, p-time-format)
     1074       + p-suffix
     1075       .
     1076   end.
     1077   function cur-time-print  returns character
     1078   :
     1079     define variable v-date as date      no-undo .
     1080     define variable v-time as integer   no-undo .
     1081     run cur-time in this-procedure
     1082       (output v-date
     1083       ,output v-time
     1084       ) .
     1085     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1086   end.
     1087   function cur-time-datetime returns datetime
     1088   :
     1089     define variable v-char as character no-undo .
     1090     define variable v-datetime as datetime no-undo .
     1091     v-char = cur-time-string().
     1092     v-datetime = datetime(v-char).
     1093     return  v-datetime.
     1094   end.
     1095   function cur-time-string-msec returns character
     1096   :
     1097     define variable v-date as datetime  no-undo .
     1098     v-date = now.
     1099     return string(v-date) .
     1100   end.
     1101   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1102   PROCEDURE verify-ini-entry:
     1103   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     1104   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     1105   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     1106   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     1107   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     1108   define variable v-mess as character no-undo .
     1109   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     1110   if ini-entry-value = ? and ini-key-name begins "spl"
     1111   then
     1112   get-key-value section ini-section-name key "splall" value ini-entry-value.
     1113   if ini-entry-value = ? and ini-key-name begins "sav"
     1114   then
     1115   get-key-value section ini-section-name key "savall" value ini-entry-value.
     1116   if ini-entry-value = ? then do:
     1117     assign
     1118     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     1119                       , chr(10)
     1120                       , ini-section-name
     1121                       , ini-key-name
     1122                       , error-msg-text).
     1123       if not silence then do:
     1124         message
     1125         v-mess
     1126         view-as alert-box ERROR  .
     1127         return error.
     1128       end.
     1129       else do:
     1130         return error v-mess.
     1131       end.
     1132   end.
     1133   END PROCEDURE.
     1134   PROCEDURE verify-file:
     1135   DEFINE INPUT  PARAMETER filename       as character no-undo.
     1136   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     1137   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     1138   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     1139   file-info:file-name = filename.
     1140   found = NOT (file-info:full-pathname = ?).
     1141   if NOT found  then do:
     1142     if not silence then do:
     1143       message error-msg-text
     1144       view-as alert-box ERROR.
     1145       return error.
     1146     end.
     1147     else return error error-msg-text.
     1148   end.
     1149   END PROCEDURE.
     1150   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1151     define variable v-cntxt-db-num        as integer   no-undo .
     1152     define variable v-cntxt-userid        as character no-undo .
     1153     define variable v-cntxt-level         as character no-undo .
     1154     define variable v-cntxt-host-code-obj as integer   no-undo .
     1155     define variable v-cntxt-obj-type      as character no-undo .
     1156     define variable v-cntxt-obj-code      as integer   no-undo .
     1157     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1158     define variable v-cntxt-is-admin      as logical   no-undo .
     1159   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1160   procedure gen-key-rec :
     1161     define input  parameter p-tbl-name    as character no-undo.
     1162     define input  parameter p-bh_tbl-name as handle    no-undo.
     1163     define output parameter p-key-rec     as character no-undo.
     1164     do
     1165     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1166     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1167     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1168     :
     1169       define variable fh               as handle    no-undo .
     1170       define variable v-ok             as logical   no-undo .
     1171       define variable v-inform         as character no-undo .
     1172       define variable v-ind            as integer   no-undo .
     1173       define variable v-idx-field-qnty as integer   no-undo .
     1174       if p-tbl-name = ?
     1175         or p-tbl-name = "":U
     1176       then do:
     1177         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info6 ).
     1178       end.
     1179       if not p-bh_tbl-name:available then do:
     1180         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info6, p-tbl-name ).
     1181       end.
     1182       assign
     1183         p-key-rec = p-tbl-name
     1184         v-inform  = p-bh_tbl-name:index-information(1)
     1185         v-ind     = 2
     1186       .
     1187       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1188       on error undo, return error
     1189       :
     1190         assign
     1191           v-inform = p-bh_tbl-name:index-information( v-ind )
     1192           v-ind    = v-ind + 1
     1193         .
     1194       end.
     1195       if v-inform = ?
     1196         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1197         or entry( 3, v-inform, ",":U ) <> "1":U
     1198       then do:
     1199         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, p-tbl-name ).
     1200       end.
     1201       else do:
     1202         assign
     1203           v-idx-field-qnty = num-entries( v-inform ) - 4
     1204         .
     1205         if v-idx-field-qnty < 2 then do:
     1206           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, p-tbl-name ).
     1207         end.
     1208         do v-ind = 1 to v-idx-field-qnty by 2
     1209         on error undo, return error
     1210         :
     1211           assign
     1212             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1213             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1214           .
     1215         end.
     1216       end.
     1217       if p-key-rec = ? then do:
     1218         assign
     1219           p-key-rec = "":U
     1220         .
     1221         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info6, p-tbl-name ).
     1222       end.
     1223     end.
     1224     return.
     1225   end procedure.
     1226   procedure gen-where-keyr-tab :
     1227     define input  parameter i-tableSerach as character no-undo.
     1228     define input  parameter i-tablekey   as character  no-undo.
     1229     define input  parameter p-key-rec    as character  no-undo.
     1230     define input  parameter p-key-handle as handle     no-undo .
     1231     define input  parameter p-db-name    as character  no-undo .
     1232     define input  parameter p-tt-handle  as handle     no-undo .
     1233     define output parameter o-Where      as character  no-undo.
     1234     do
     1235     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1236     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1237     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1238     :
     1239       define variable v-full-tbl-name  as character no-undo .
     1240       define variable bh_tbl-name      as handle    no-undo .
     1241       define variable fh_key           as handle    no-undo .
     1242       define variable fh_search        as handle    no-undo .
     1243       define variable v-field-num      as integer   no-undo .
     1244       define variable v-count-fld      as integer   no-undo .
     1245       define variable v-inform         as character no-undo .
     1246       define variable v-ind            as integer   no-undo .
     1247       define variable v-idx-field-qnty as integer   no-undo .
     1248       define variable v-field-name     as character no-undo .
     1249       define variable v-field-val      as character no-undo .
     1250       define variable v-word-link      as character no-undo .
     1251       define variable vTable           as character no-undo.
     1252       define variable bh_tbl-key       as handle    no-undo .
     1253       assign
     1254         p-key-rec = trim( p-key-rec )
     1255       .
     1256       if p-key-handle <> ? then do:
     1257         if not valid-handle(p-key-handle)
     1258            or p-key-handle:type <> "buffer"
     1259         then do:
     1260           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info6 ).
     1261         end.
     1262         if num-entries( p-key-rec, chr(3) ) > 1
     1263           or p-key-rec = ?
     1264           or p-key-rec = "":U
     1265         then do:
     1266           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info6, p-key-rec ).
     1267         end.
     1268       end.
     1269       else do:
     1270         if p-key-rec = ?
     1271           or p-key-rec = "":U
     1272         then do:
     1273           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
     1274         end.
     1275       end.
     1276       assign
     1277         vTable = entry( 1 , p-key-rec, chr(3) )
     1278       .
     1279       if p-tt-handle <> ?
     1280         and ( not valid-handle(p-tt-handle)
     1281               or p-tt-handle:type <> "buffer"
     1282             )
     1283       then do:
     1284         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info6, vTable, chr(10) ).
     1285       end.
     1286       if p-tt-handle = ? then do:
     1287         assign
     1288           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1289         .
     1290         create buffer bh_tbl-name for table v-full-tbl-name .
     1291       end.
     1292       else do:
     1293         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1294       end.
     1295       assign
     1296         v-inform = bh_tbl-name:index-information(1)
     1297         v-ind    = 2
     1298       .
     1299       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1300       on error undo, return error
     1301       :
     1302         assign
     1303           v-inform = bh_tbl-name:index-information( v-ind )
     1304           v-ind    = v-ind + 1
     1305         .
     1306       end.
     1307       if v-inform = ?
     1308         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1309         or entry( 3, v-inform, ",":U ) <> "1":U
     1310       then do:
     1311         delete object bh_tbl-name no-error.
     1312         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info6, vTable ).
     1313       end.
     1314       assign
     1315         v-idx-field-qnty = num-entries( v-inform ) - 4
     1316       .
     1317       if v-idx-field-qnty < 2 then do:
     1318         delete object bh_tbl-name no-error.
     1319         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, vTable ).
     1320       end.
     1321       assign
     1322         o-where     = "where":U
     1323         v-word-link = "":U
     1324         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1325         v-count-fld = 0
     1326       .
     1327       if i-tablekey ne "" and i-tablekey ne ?
     1328       then do:
     1329         assign
     1330           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1331         .
     1332         create buffer bh_tbl-key for table v-full-tbl-name .
     1333       end.
     1334       if i-tableSerach ne "" and i-tableSerach ne ?
     1335       then do:
     1336         delete object bh_tbl-name no-error.
     1337         assign
     1338           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1339         .
     1340         create buffer bh_tbl-name for table v-full-tbl-name .
     1341       end.
     1342       block_where:
     1343       do v-ind = 1 to v-idx-field-qnty by 2
     1344       on error undo, return error
     1345       :
     1346         assign
     1347           v-count-fld = v-count-fld + 1
     1348         .
     1349         if p-key-handle = ?
     1350           and v-count-fld > v-field-num
     1351         then do:
     1352           leave block_where.
     1353         end.
     1354         define variable VfieldKeyTable as handle no-undo.
     1355         assign
     1356           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1357           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1358         .
     1359         if     bh_tbl-key ne ?
     1360         then do:
     1361            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1362            if VfieldKeyTable eq ?
     1363            then next block_where.
     1364         end.
     1365         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1366         then
     1367            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1368         else
     1369            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1370         if p-key-handle = ? then do:
     1371           assign
     1372             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1373           .
     1374         end.
     1375         else do:
     1376           assign
     1377             fh_key = p-key-handle:buffer-field( v-field-name )
     1378           .
     1379           if fh_key = ?
     1380             or not valid-handle( fh_key )
     1381           then do:
     1382             delete object bh_tbl-name.
     1383             if     bh_tbl-key ne ?
     1384             then
     1385                delete object bh_tbl-key.
     1386             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info6, p-key-handle:name, v-field-name ).
     1387           end.
     1388           assign
     1389             v-field-val = fh_key:buffer-value
     1390           .
     1391         end.
     1392         if fh_search:data-type ="character":U then do:
     1393           assign
     1394             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1395             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1396             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1397             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1398             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1399             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1400             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1401             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1402             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1403             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1404             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1405             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1406             v-field-val = substitute( '"&1"', v-field-val )
     1407           .
     1408         end.
     1409         assign
     1410           o-where = substitute( "&1 &2", o-where, v-field-val )
     1411         .
     1412         if v-word-link = "":U then do:
     1413           assign
     1414             v-word-link = "and":U
     1415           .
     1416         end.
     1417       end.
     1418       delete object bh_tbl-name.
     1419       if     bh_tbl-key ne ?
     1420       then
     1421          delete object bh_tbl-key.
     1422       if p-key-handle = ?
     1423         and v-count-fld <> v-field-num
     1424       then do:
     1425         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info6, vTable ).
     1426       end.
     1427     end.
     1428   end procedure.
     1429   procedure gen-hn-keyr-tab :
     1430     define input  parameter i-tableSerach as character no-undo.
     1431     define input  parameter i-tablekey   as character no-undo.
     1432     define input  parameter p-key-rec    as character no-undo.
     1433     define input  parameter p-key-handle as handle    no-undo .
     1434     define input  parameter p-db-name    as character no-undo .
     1435     define input  parameter p-tt-handle  as handle    no-undo .
     1436     define input  parameter p-stts-lock  as integer   no-undo .
     1437     define output parameter o-hn         as handle    no-undo.
     1438     define variable v-full-tbl-name as character no-undo.
     1439     define variable v-where         as character no-undo.
     1440     define variable bh_tbl-name     as handle    no-undo.
     1441     define variable vTable          as character no-undo.
     1442     do
     1443     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1444     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1445     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1446         run gen-where-keyr-tab(i-tableSerach,
     1447                                i-tablekey,
     1448                                p-key-rec,
     1449                                p-key-handle,
     1450                                p-db-name,
     1451                                p-tt-handle,
     1452                                output v-where).
     1453         if i-tableSerach ne "" and i-tableSerach ne ?
     1454         then do:
     1455            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1456            create buffer bh_tbl-name for table v-full-tbl-name .
     1457         end.
     1458         else do:
     1459            if p-tt-handle = ? then do:
     1460               assign
     1461                  vTable = entry( 1 , p-key-rec, chr(3) )
     1462               .
     1463               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1464               create buffer bh_tbl-name for table v-full-tbl-name .
     1465            end.
     1466            else do:
     1467               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1468            end.
     1469         end.
     1470         if p-tt-handle = ? then do:
     1471            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1472         end.
     1473         else do:
     1474            bh_tbl-name:find-first( v-where ) no-error .
     1475         end.
     1476         o-hn = bh_tbl-name.
     1477      end.
     1478   end procedure.
     1479   procedure gen-hn-keyr :
     1480     define input  parameter p-key-rec    as character no-undo.
     1481     define input  parameter p-key-handle as handle    no-undo .
     1482     define input  parameter p-db-name    as character no-undo .
     1483     define input  parameter p-tt-handle  as handle    no-undo .
     1484     define input  parameter p-stts-lock  as integer   no-undo .
     1485     define output parameter o-hn         as handle    no-undo.
     1486     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1487   end.
     1488   procedure gen-row-keyr :
     1489     define input  parameter p-key-rec    as character no-undo.
     1490     define input  parameter p-key-handle as handle    no-undo .
     1491     define input  parameter p-db-name    as character no-undo .
     1492     define input  parameter p-tt-handle  as handle    no-undo .
     1493     define input  parameter p-stts-lock  as integer   no-undo .
     1494     define output parameter p-tbl-row    as rowid     no-undo.
     1495     define output parameter p-tbl-name   as character no-undo.
     1496     define variable vHn as handle no-undo.
     1497       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1498       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1499       p-tbl-name =  vHn:table.
     1500       delete object vHn no-error.
     1501     if p-tbl-row = ? then do:
     1502       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info6, p-tbl-name, p-key-rec ).
     1503     end.
     1504     else do:
     1505       return.
     1506     end.
     1507   end procedure.
     1508   procedure gen-key-fv :
     1509     define input  parameter p-key-rec    as character no-undo .
     1510     define output parameter p-field-list as character no-undo .
     1511     define output parameter p-value-list as character no-undo.
     1512     do
     1513     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1514     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1515     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1516     :
     1517       define variable v-full-tbl-name  as character no-undo .
     1518       define variable bh_tbl-name      as handle    no-undo .
     1519       define variable v-tbl-name       as character no-undo .
     1520       define variable v-field-num      as integer   no-undo .
     1521       define variable v-count-fld      as integer   no-undo .
     1522       define variable v-inform         as character no-undo .
     1523       define variable v-ind            as integer   no-undo .
     1524       define variable v-idx-field-qnty as integer   no-undo .
     1525       define variable v-delim-key      as character no-undo .
     1526       if p-key-rec = ?
     1527         or p-key-rec = "":U
     1528       then do:
     1529         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
     1530       end.
     1531       assign
     1532         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1533         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1534       .
     1535       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1536       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info6 ).
     1537       assign
     1538         v-inform = bh_tbl-name:index-information(1)
     1539         v-ind    = 2
     1540       .
     1541       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1542       on error undo, return error
     1543       :
     1544         assign
     1545           v-inform = bh_tbl-name:index-information( v-ind )
     1546           v-ind    = v-ind + 1
     1547         .
     1548       end.
     1549       if v-inform = ?
     1550         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1551         or entry( 3, v-inform, ",":U ) <> "1":U
     1552       then do:
     1553         delete object bh_tbl-name no-error.
     1554         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
     1555       end.
     1556       assign
     1557         v-idx-field-qnty = num-entries( v-inform ) - 4
     1558       .
     1559       if v-idx-field-qnty < 2 then do:
     1560         delete object bh_tbl-name no-error.
     1561         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
     1562       end.
     1563       assign
     1564         p-field-list = "":U
     1565         p-value-list = "":U
     1566         v-delim-key  = "":U
     1567         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1568         v-count-fld  = 0
     1569       .
     1570       block_where:
     1571       do v-ind = 1 to v-idx-field-qnty by 2
     1572       on error undo, return error
     1573       :
     1574         assign
     1575           v-count-fld = v-count-fld + 1
     1576         .
     1577         if v-count-fld > v-field-num then do:
     1578           leave block_where.
     1579         end.
     1580         assign
     1581           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1582           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1583         .
     1584         if v-ind = 1 then do:
     1585           assign
     1586             v-delim-key = chr(3)
     1587           .
     1588         end.
     1589       end.
     1590       delete object bh_tbl-name.
     1591       if v-count-fld <> v-field-num then do:
     1592         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info6, v-tbl-name ).
     1593       end.
     1594     end.
     1595   end procedure.
     1596   procedure gen-key-field :
     1597     define input  parameter p-table      as character no-undo .
     1598     define output parameter p-field-list as character no-undo .
     1599     do
     1600     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1601     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1602     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1603     :
     1604       define variable v-full-tbl-name  as character no-undo .
     1605       define variable bh_tbl-name      as handle    no-undo .
     1606       define variable v-tbl-name       as character no-undo .
     1607       define variable v-field-num      as integer   no-undo .
     1608       define variable v-count-fld      as integer   no-undo .
     1609       define variable v-inform         as character no-undo .
     1610       define variable v-ind            as integer   no-undo .
     1611       define variable v-idx-field-qnty as integer   no-undo .
     1612       define variable v-delim-key      as character no-undo .
     1613       if p-table = ?
     1614         or p-table = "":U
     1615       then do:
     1616         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info6 ).
     1617       end.
     1618       assign
     1619         v-tbl-name      = p-table
     1620         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1621       .
     1622       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1623       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info6 ).
     1624       assign
     1625         v-inform = bh_tbl-name:index-information(1)
     1626         v-ind    = 2
     1627       .
     1628       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1629       on error undo, return error
     1630       :
     1631         assign
     1632           v-inform = bh_tbl-name:index-information( v-ind )
     1633           v-ind    = v-ind + 1
     1634         .
     1635       end.
     1636       if v-inform = ?
     1637         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1638         or entry( 3, v-inform, ",":U ) <> "1":U
     1639       then do:
     1640         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
     1641       end.
     1642       assign
     1643         v-idx-field-qnty = num-entries( v-inform ) - 4
     1644       .
     1645       if v-idx-field-qnty < 2 then do:
     1646         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
     1647       end.
     1648       assign
     1649         p-field-list = "":U
     1650         v-delim-key  = "":U
     1651         v-count-fld  = 0
     1652       .
     1653       block_where:
     1654       do v-ind = 1 to v-idx-field-qnty by 2
     1655       on error undo, return error
     1656       :
     1657         assign
     1658           v-count-fld = v-count-fld + 1
     1659         .
     1660         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1661         if v-ind = 1 then do:
     1662           assign
     1663             v-delim-key = chr(3)
     1664           .
     1665         end.
     1666       end.
     1667       delete object bh_tbl-name.
     1668     end.
     1669   end procedure.
     1670   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1671   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1672   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1673   FUNCTION get-region RETURNS CHARACTER
     1674     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1675     define variable par-region as character no-undo.
     1676     if parhost-code = 0 and
     1677          parobj-type = "":U and
     1678          parobj-code = 0 then do:
     1679          par-region = "Глобально".
     1680          return par-region.
     1681       end.
     1682       if parobj-type = 'орг':U then do:
     1683          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1684          return par-region.
     1685       end.
     1686       if parobj-type = 'регион':U
     1687       then do:
     1688          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1689          return par-region.
     1690       end.
     1691       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1692       return par-region.
     1693   END FUNCTION.
     1694   FUNCTION get-objregion RETURNS CHARACTER
     1695     (  input parobj-type as character, input parobj-code as integer ) :
     1696     define variable par-region as character no-undo.
     1697     if  parobj-type = "":U and
     1698         parobj-code = 0
     1699     then do:
     1700        par-region = "Глобально".
     1701     end.
     1702     else if parobj-type = 'орг':U
     1703     then do:
     1704        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1705     end.
     1706     else if parobj-type = 'регион':U
     1707     then do:
     1708        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1709     end.
     1710     else
     1711        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1712     return par-region.
     1713   END FUNCTION.
     1714   FUNCTION calldscr returns character ( input p-call-id as character):
     1715   define variable v-descr as character no-undo .
     1716   define variable v-field-list as character no-undo .
     1717   define variable v-value-list as character no-undo.
     1718   define variable v-prop-label as character no-undo .
     1719   define variable v-node-label as character no-undo .
     1720   define variable v-dt-code as integer no-undo .
     1721   define variable v-host-code as integer no-undo .
     1722   define variable v-obj-type as character no-undo .
     1723   define variable v-obj-code as integer no-undo .
     1724   define variable v-label as character no-undo .
     1725   define variable v-node-code as integer no-undo .
     1726   define buffer buf_prop-head for ub.prop-head.
     1727   define buffer buf_prop-ref for ub.prop-ref.
     1728   define buffer buf_prop-map for ub.prop-map.
     1729   run gen-key-fv in this-procedure ( input p-call-id
     1730                                     ,output v-field-list
     1731                                     ,output v-value-list) no-error .
     1732   if error-status:error then return p-call-id.
     1733   CASE entry(1, p-call-id, chr(3)):
     1734     when 'dis-card-type':U then do:
     1735       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
     1736                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1737                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     1738                            ).
     1739     end.
     1740     when 'dis-card':U then do:
     1741       v-descr = substitute("ДК: № &1"
     1742                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1743                            ).
     1744     end.
     1745     when 'dis-card-property':U then do:
     1746       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1747       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1748       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1749       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
     1750       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1751       find first buf_prop-ref no-lock where
     1752                 buf_prop-ref.dt-code = v-dt-code no-error .
     1753       if available buf_prop-ref then do:
     1754         find first buf_prop-head no-lock where
     1755                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
     1756         v-prop-label = buf_prop-head.prop-label.
     1757         find first buf_prop-map no-lock where
     1758                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
     1759               and buf_prop-map.node-code = v-node-code no-error .
     1760         if available buf_prop-map then do:
     1761           v-label = buf_prop-map.node-label.
     1762         end.
     1763       end.
     1764       v-descr = substitute("ДК: № &1 &2:&3 &4"
     1765                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1766                            ,v-prop-label
     1767                            ,v-label
     1768                            ,get-region(v-host-code, v-obj-type, v-obj-code)
     1769                            ).
     1770     end.
     1771     when 'clients':U then do:
     1772       v-descr = substitute("&1&2"
     1773                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1774                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1775                            ).
     1776     end.
     1777     when 'ext-system':U then do:
     1778       v-descr = substitute("Внешняя система &1"
     1779                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1780                            ).
     1781     end.
     1782     WHEN 'thbj-attr':U then do:
     1783       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1784       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1785       then do:
     1786         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1787           v-descr = "Операции с товарами".
     1788         end.
     1789         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1790           v-descr = "Операции с клиентами".
     1791         end.
     1792         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1793           v-descr = "Операции с группами товаров".
     1794         end.
     1795         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1796           v-descr = "Операции с группами клиентов".
     1797         end.
     1798         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1799           v-descr = "Операции с чеками на POS IBS-TH".
     1800         end.
     1801         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1802           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1803         end.
     1804         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1805           v-descr = "Операции в системе электронного документооборота".
     1806         end.
     1807         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1808           v-descr = "Операции со справочниками".
     1809         end.
     1810         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1811           v-descr = "Операции с ДНЦ и переоценками".
     1812         end.
     1813         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1814           v-descr = "Отчеты".
     1815         end.
     1816         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1817           v-descr = "Операции с заказами".
     1818         end.
     1819       end.
     1820     end.
     1821     when 'cash-desk':U then do:
     1822       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1823                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1824                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1825                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1826                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1827                            ).
     1828     end.
     1829     when 'ext-file':U then do:
     1830       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1831                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1832                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1833                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1834                            ).
     1835     end.
     1836   end case.
     1837   return v-descr.
     1838   end function.
     1839   DEFINE VARIABLE v-dir-save AS CHARACTER NO-UNDO.
     1840   DEFINE VARIABLE l-dircrt AS LOGICAL NO-UNDO.
     1841   DEFINE VARIABLE v-rid-list          AS CHARACTER NO-UNDO.
     1842   define variable v-rid               as recid     no-undo .
     1843   DEFINE VARIABLE v-ok                AS logical   NO-UNDO.
     1844   define variable v-esys-id           as integer   no-undo .
     1845   define variable ref-list as character no-undo.
     1846   define variable ref-rec as recid no-undo.
     1847   define buffer buf_clients for ub.clients.
     1848   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1849   DEFINE BUTTON b-dir-sel
     1850        IMAGE-UP FILE "btn-down-arrow":U
     1851        IMAGE-DOWN FILE "btn-down-arrow":U
     1852        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1853        LABEL "..."
     1854        SIZE 3.63 BY 1.04.
     1855   DEFINE BUTTON b-save
     1856        LABEL "Сохранить"
     1857        SIZE 12 BY 1
     1858        BGCOLOR 8 .
     1859   DEFINE BUTTON B-Help
     1860        LABEL "Помо&щь"
     1861        SIZE 12 BY 1
     1862        BGCOLOR 8 .
     1863   DEFINE BUTTON b-quit AUTO-END-KEY
     1864        LABEL "&Отмена"
     1865        SIZE 12 BY 1
     1866        BGCOLOR 8 .
     1867   DEFINE VARIABLE v-directory AS CHARACTER FORMAT "X(256)":U
     1868        LABEL "Директория"
     1869        VIEW-AS FILL-IN
     1870        SIZE 62.5 BY 1
     1871        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1872   DEFINE FRAME Dialog-Frame
     1873        b-save AT ROW 1 COL 2
     1874        b-quit AT ROW 1 COL 14
     1875        B-Help AT ROW 1 COL 54.88
     1876        b-dir-sel AT ROW 2.5 COL 78
     1877        v-directory AT ROW 2.5 COL 3
     1878        SPACE(2) SKIP(1)
     1879       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1880            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1881            TITLE "Параметры архивации логов"
     1882            DEFAULT-BUTTON b-save CANCEL-BUTTON b-quit.
     1883   ASSIGN
     1884          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1885          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1886   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1887   DO:
     1888     APPLY "END-ERROR":U TO SELF.
     1889   END.
     1890   ON CHOOSE OF b-dir-sel IN FRAME Dialog-Frame
     1891   DO:
     1892     define variable c-dir-name  as character no-undo.
     1893     define variable c-dir-type  as character no-undo.
     1894     define variable l-can-write as logical   no-undo.
     1895   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1896   if lookup(self :type
     1897            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1898            ) = 0
     1899   then do:
     1900     message
     1901       "$Workfile$"
     1902       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1903       "Интерфейсный элемент" self :name  skip
     1904       "Тип" self :type  skip
     1905       "Процедура" this-procedure :file-name skip
     1906       view-as alert-box .
     1907   end.
     1908   else do:
     1909     apply "entry":u to self  .
     1910     if focus :handle <> self :handle  then do:
     1911       return no-apply .
     1912     end.
     1913   end.
     1914     run gbl/dir-sel.p ( output c-dir-name, output c-dir-type, output l-can-write ).
     1915     if c-dir-name = '':U or c-dir-name = ? or
     1916        c-dir-type = '':U or c-dir-type = ? then do:
     1917       return no-apply.
     1918     end.
     1919     if l-can-write <> yes then do:
     1920       message 'Вы не имеете права писать в выбранную директорию:' c-dir-name view-as alert-box error.
     1921       return no-apply.
     1922     end.
     1923     assign  v-directory = c-dir-name.
     1924     display v-directory with frame Dialog-Frame.
     1925       .
     1926   END.
     1927   ON CHOOSE OF B-save IN FRAME Dialog-Frame
     1928   DO:
     1929     ASSIGN
     1930       v-directory
     1931     .
     1932     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1933     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1934     APPLY "GO" TO FRAME Dialog-Frame.
     1935   END.
     1936   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1937   DO:
     1938         assign
     1939           p-cancel = yes
     1940       .
     1941   END.
     1942   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1943   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1944   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1945   on help of frame Dialog-Frame
     1946   do:
     1947     run gbl/app_help.p
     1948       (input this-procedure :file-name
     1949       ,input ''
     1950       ,input ?
     1951       ) no-error.
     1952     if error-status :error then do:
     1953       message
     1954         "Ошибка при вызове помощи"
     1955         error-status :get-message(1)
     1956         view-as alert-box .
     1957     end.
     1958   end.
     1959   run minbtn-set in this-procedure .
     1960   on choose of b-help in frame Dialog-Frame
     1961   do:
     1962     apply "help":u to frame Dialog-Frame .
     1963   end.
     1964   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1965   procedure minbtn-set :
     1966       do
     1967           on error undo, return error return-value
     1968           :
     1969           define variable ii              as integer       no-undo .
     1970           define variable fh              as widget-handle no-undo .
     1971           define variable hh              as widget-handle no-undo .
     1972           define variable v-h             as handle        extent 4 no-undo .
     1973           define variable v-name-button   as character     no-undo .
     1974           define variable v-help-old-x    as decimal       no-undo .
     1975           define variable v-help-old-y    as decimal       no-undo .
     1976           define variable v-help-old-size as decimal       no-undo .
     1977           define variable v-frame-width   as decimal       no-undo .
     1978           define variable jj              as integer       no-undo .
     1979           do
     1980               on error undo, return error
     1981               :
     1982               assign
     1983                   v-frame-width = frame Dialog-Frame:width - 0.3
     1984                   fh            = frame Dialog-Frame:first-child
     1985                   hh            = fh:first-child
     1986                   ii            = 1
     1987                   .
     1988               do while valid-handle(hh):
     1989                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1990                   do:
     1991                       case lc(hh:name) :
     1992                           when "b-help" then
     1993                               do:
     1994                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1995                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1996                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1997                                   hh:TOOLTIP = "Помощь" .
     1998                                   v-help-old-x = hh:column .
     1999                                   v-help-old-y = hh:row    .
     2000                                   v-help-old-size = hh:width .
     2001                                   hh:width-chars = 2.5 .
     2002                               end.
     2003                           when "b-print" then
     2004                               do:
     2005                                   hh:load-image("cmp/b-print.bmp":u) .
     2006                                   hh:TOOLTIP = "Печать" .
     2007                                   v-h[ii] = hh:handle .
     2008                                   ii = ii + 1 .
     2009                                   hh:width-chars = 3 .
     2010                               end.
     2011                           when "b-history" or
     2012                           when "b-hist" then
     2013                               do:
     2014                                   hh:load-image("cmp/b-hist.bmp":u) .
     2015                                   hh:TOOLTIP = "История" .
     2016                                   v-h[ii] = hh:handle .
     2017                                   ii = ii + 1 .
     2018                                   hh:width-chars = 3 .
     2019                               end.
     2020                           when "b-sch" then
     2021                               do:
     2022                                   hh:load-image("cmp/b-sch.bmp":u) .
     2023                                   hh:TOOLTIP = "Установка Фильтра" .
     2024                                   v-h[ii] = hh:handle .
     2025                                   ii = ii + 1 .
     2026                                   hh:width-chars = 3 .
     2027                               end.
     2028                           when "b-hist-user" then
     2029                               do:
     2030                                   hh:load-image("cmp/b-hist.bmp":u) .
     2031                                   hh:TOOLTIP = "История пользователя" .
     2032                                   ii = ii + 1 .
     2033                               end.
     2034                       end case.
     2035                   end.
     2036                   hh = hh:next-sibling.
     2037               end.
     2038               b-help:column = v-frame-width - b-help:width-chars.
     2039               jj = 0.
     2040               repeat ii = 4 to 1 by -1 :
     2041                   if valid-handle (v-h[ii] ) then
     2042                   do:
     2043                       jj  = jj + 1 .
     2044                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2045                       v-h[ii]:row    = v-help-old-y .
     2046                   end.
     2047               end.
     2048           end.
     2049       end.
     2050   end procedure.
     2051   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2052     run mainmenu_getcntxt in parparentproc
     2053       (output v-cntxt-db-num
     2054       ,output v-cntxt-userid
     2055       ,output v-cntxt-level
     2056       ,output v-cntxt-host-code-obj
     2057       ,output v-cntxt-obj-type
     2058       ,output v-cntxt-obj-code
     2059       ,output v-cntxt-db-num-obj
     2060       ,output v-cntxt-is-admin
     2061       ) .
     2062   MAIN-BLOCK:
     2063   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2064      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2065     if p-mode = 'shd':U then do:
     2066       assign
     2067       frame Dialog-Frame :title = frame Dialog-Frame :title +
     2068                         substitute(". &1: Задача номер &2"
     2069                         , p-task-type
     2070                         , p-task-num )
     2071       .
     2072     end.
     2073     run init-param-values in this-procedure  no-error .
     2074     if error-status :error then undo, return error .
     2075     RUN Myenable.
     2076     WAIT-FOR GO OF FRAME Dialog-Frame.
     2077   END.
     2078   RUN disable_UI.
     2079   PROCEDURE attach-attr-to-schedule-line :
     2080   DEFINE INPUT PARAMETER p-param-list AS CHARACTER NO-UNDO.
     2081     define buffer buf_schedule      for schedule.
     2082     define buffer buf_schedule-attr for schedule-attr.
     2083     define buffer lock-batchprocess for ub.batchprocess.
     2084     run gbl/lock-prc.p
     2085       (input 'schd':U
     2086       ,input 'imp-aazs':U
     2087       ,input 0
     2088       ,input 0
     2089       ,input '':U
     2090       ,input ""
     2091       ,input ""
     2092       ,input (
     2093       "Сохранение параметров импорта из ААЗС "
     2094       )
     2095       ,input yes
     2096       ,buffer lock-batchprocess
     2097       ) no-error .
     2098     FIND FIRST buf_schedule-attr NO-LOCK WHERE
     2099       buf_schedule-attr.task-type   = p-task-type
     2100       and buf_schedule-attr.cre-db-num = INTEGER(p-cre-db-num)
     2101       and buf_schedule-attr.attr-code = ('schd-free-id':U + chr(4) + 'imp-aazs') NO-ERROR.
     2102     IF AVAILABLE  buf_schedule-attr
     2103       AND buf_schedule-attr.task-num <> p-task-num
     2104       AND buf_schedule-attr.task-num <> - 1
     2105       and p-task-num <> - 1
     2106       THEN
     2107     DO:
     2108       MESSAGE
     2109         substitute("Уже есть расписание сохранения параметров импорта из ААЗС  для БД &1&2" +
     2110         "номер расписания &3"
     2111         ,buf_schedule-attr.cre-db-num
     2112         ,chr(10)
     2113         ,buf_schedule-attr.task-num)
     2114         VIEW-AS ALERT-BOX ERROR.
     2115       UNDO, RETURN ERROR.
     2116     END.
     2117     find first buf_schedule no-lock
     2118       where buf_schedule.task-type   = p-task-type
     2119       and buf_schedule.cre-db-num  = INTEGER(p-cre-db-num)
     2120       and buf_schedule.task-num    = p-task-num
     2121       no-error.
     2122     if not available buf_schedule
     2123       and (  p-task-type   <> 'autofree':U
     2124       or p-task-num    <> -1 )
     2125       then
     2126     do:
     2127       message
     2128         vss-workfile vss-revision vss-description
     2129         skip
     2130         "Не найдена строка расписания."
     2131         skip return-value
     2132         skip trim(error-status :get-message(1))
     2133         trim(error-status :get-message(2))
     2134         trim(error-status :get-message(3))
     2135         view-as alert-box error.
     2136       undo, return error .
     2137     end.
     2138     run schedule-attr-write in this-procedure (
     2139       input INTEGER(p-cre-db-num)
     2140       , input p-task-type
     2141       , input p-task-num
     2142       , input 'schedule-param-list':U
     2143       , input p-param-list
     2144       ).
     2145   END PROCEDURE.
     2146   PROCEDURE disable_UI :
     2147     HIDE FRAME Dialog-Frame.
     2148   END PROCEDURE.
     2149   PROCEDURE enable_UI :
     2150     DISPLAY v-directory
     2151         WITH FRAME Dialog-Frame.
     2152     ENABLE B-save b-quit B-Help b-dir-sel v-directory
     2153         WITH FRAME Dialog-Frame.
     2154     VIEW FRAME Dialog-Frame.
     2155   END PROCEDURE.
     2156   PROCEDURE init-param-values :
     2157   do
     2158   on error undo, return error
     2159   :
     2160   define variable v-param-list    as character     no-undo.
     2161   define variable v-param-type    as character     no-undo.
     2162   define variable v-entry  as character no-undo .
     2163   define variable v-task-num as integer   no-undo .
     2164     v-directory:screen-value in frame Dialog-Frame = "".
     2165     assign v-directory.
     2166     case p-mode:
     2167       when "shd"
     2168       then do:
     2169         run schedule-attr-value in this-procedure (input p-cre-db-num
     2170             , input p-task-type
     2171             , input p-task-num
     2172             , input 'schedule-param-list':U
     2173             ,output v-param-list
     2174             ,output v-param-type).
     2175         if v-param-list <> ""  then
     2176         do:
     2177           v-directory  = v-param-list no-error.
     2178         end.
     2179         display v-directory  with frame Dialog-Frame.
     2180         ENABLE
     2181         B-save
     2182         b-quit
     2183         B-Help
     2184         b-dir-sel
     2185         v-directory
     2186         WITH FRAME Dialog-Frame.
     2187       end.
     2188     end case.
     2189   END.
     2190   END PROCEDURE.
     2191   PROCEDURE MyEnable :
     2192   VIEW FRAME Dialog-Frame.
     2193   END PROCEDURE.
     2194   procedure wri-log-and-file :
     2195       define input parameter p-log-string     as char       no-undo.
     2196   end procedure .
     2197   PROCEDURE proc-save :
     2198   DEFINE VARIABLE v-param-list AS CHARACTER NO-UNDO.
     2199   DEFINE VARIABLE v-file-name AS CHARACTER NO-UNDO.
     2200   define variable v-dop-file-name as character no-undo .
     2201   define variable v-obj-list as character no-undo .
     2202   define variable ii as integer   no-undo .
     2203   define variable c-dir-type as character no-undo .
     2204   define variable l-can-write as logical no-undo .
     2205   DEFINE VARIABLE v-other-param AS CHARACTER NO-UNDO.
     2206   file-info:file-name = v-directory.
     2207   if file-info:file-type = ? then do:
     2208       message substitute("Директории &1 не существует.",v-directory) skip
     2209       "Создать?" view-as alert-box warning buttons yes-no update l-dircrt.
     2210       if l-dircrt then do:
     2211           os-create-dir value(v-directory).
     2212           if os-error <> 0 then do:
     2213               message substitute("Невозможно создать директорию &1",v-directory) view-as alert-box error.
     2214               leave.
     2215           end.
     2216       end.
     2217       else leave.
     2218   end.
     2219   RUN verify-file in this-procedure
     2220                                     ( input v-directory
     2221                                     , input substitute("Не найден каталог &1"
     2222                                                   , v-directory)
     2223                                     ,input no
     2224                                     ,output glog) no-error.
     2225   if error-status:error or not glog then return error return-value .
     2226   if index( file-info:file-type, "W" ) = 0  then do:
     2227     message
     2228     'Вы не имеете права писать в выбранную директорию: '
     2229     v-directory view-as alert-box error.
     2230     return error.
     2231   end.
     2232     v-param-list = v-directory.
     2233     run attach-attr-to-schedule-line in this-procedure ( INPUT v-param-list ).
     2234     run schedule-attr-write in this-procedure (input p-cre-db-num,
     2235                                                input p-task-type,
     2236                                                input p-task-num,
     2237                                                input 'schedule-obj-list':U,
     2238                                                input v-obj-list).
     2239     message "Параметры сохранены!" view-as alert-box information.
     2240   END PROCEDURE.
