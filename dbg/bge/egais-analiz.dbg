     1761           and can-query(v-object-handle, "height")
     1762           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1763           then do:
     1764             find first buf_temp-browse-handle
     1765               where buf_temp-browse-handle.browse-type   = 'height':u
     1766                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1767               no-error .
