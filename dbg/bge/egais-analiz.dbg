        1   using ibs.th.bge.egais.*.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter egaisWB as class WayBill no-undo.
        4   define variable vss-revision               as character no-undo init "$Revision$":U .
        5   define variable vss-author                 as character no-undo init "$Author$":U .
        6   define variable vss-date                   as character no-undo init "$Date$":U .
        7   define variable vss-workfile               as character no-undo init "$Workfile$":U .
        8   define variable vss-archive                as character no-undo init "$Archive$":U .
        9   define variable vss-description            as character no-undo init "Журнал запросов ЕГАИС".
       10   define variable bh-wb-analiz               as handle    no-undo.
       11   define variable browse-hdl-analiz          as handle    no-undo.
       12   define variable qh-analiz                  as handle    no-undo.
       13   define variable bcol                       as handle    extent no-undo.
       14   define variable v-db-num                   as integer   no-undo .
       15   define variable v-user-id                  as character no-undo .
       16   define variable v-user-select              as character no-undo .
       17   define variable v-select-obj-type          as character no-undo .
       18   define variable v-select-obj-code          as integer   no-undo .
       19   define variable v-obj-uniq-key-rec         as character no-undo .
       20   define variable v-gds-uniq-key-rec         as character no-undo .
       21   define variable v-rid                      as recid     no-undo .
       22   define variable v-uniq-key-rec             as character no-undo .
       23   define variable url_                       as character no-undo .
       24   define buffer buf_clients   for ub.clients .
       25   define buffer x_ext-classif for ub.ext-classif.
       26   define buffer buf_goods     for ub.goods .
       27   define new global shared variable g#language as character no-undo .
       28   if g#language <> '' and g#language <> 'rus':U then do:
       29     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       30   end.
       31   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       32   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
       33   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
       34   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
       35   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
       36   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
       37   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       38   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       39   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       40   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       41   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
       42   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
       43   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
       44   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
       45   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
       46   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
       47   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
       48   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
       49   define new global shared variable g#library  as handle no-undo .
       50   define new global shared variable g#library2 as handle no-undo .
       51   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       52     define variable v-cntxt-db-num        as integer   no-undo .
       53     define variable v-cntxt-userid        as character no-undo .
       54     define variable v-cntxt-level         as character no-undo .
       55     define variable v-cntxt-host-code-obj as integer   no-undo .
       56     define variable v-cntxt-obj-type      as character no-undo .
       57     define variable v-cntxt-obj-code      as integer   no-undo .
       58     define variable v-cntxt-db-num-obj    as integer   no-undo .
       59     define variable v-cntxt-is-admin      as logical   no-undo .
       60   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       61   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       62   procedure gen-key-rec :
       63     define input  parameter p-tbl-name    as character no-undo.
       64     define input  parameter p-bh_tbl-name as handle    no-undo.
       65     define output parameter p-key-rec     as character no-undo.
       66     do
       67     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       68     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       69     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       70     :
       71       define variable fh               as handle    no-undo .
       72       define variable v-ok             as logical   no-undo .
       73       define variable v-inform         as character no-undo .
       74       define variable v-ind            as integer   no-undo .
       75       define variable v-idx-field-qnty as integer   no-undo .
       76       if p-tbl-name = ?
       77         or p-tbl-name = "":U
       78       then do:
       79         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
       80       end.
       81       if not p-bh_tbl-name:available then do:
       82         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
       83       end.
       84       assign
       85         p-key-rec = p-tbl-name
       86         v-inform  = p-bh_tbl-name:index-information(1)
       87         v-ind     = 2
       88       .
       89       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
       90       on error undo, return error
       91       :
       92         assign
       93           v-inform = p-bh_tbl-name:index-information( v-ind )
       94           v-ind    = v-ind + 1
       95         .
       96       end.
       97       if v-inform = ?
       98         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
       99         or entry( 3, v-inform, ",":U ) <> "1":U
      100       then do:
      101         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      102       end.
      103       else do:
      104         assign
      105           v-idx-field-qnty = num-entries( v-inform ) - 4
      106         .
      107         if v-idx-field-qnty < 2 then do:
      108           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      109         end.
      110         do v-ind = 1 to v-idx-field-qnty by 2
      111         on error undo, return error
      112         :
      113           assign
      114             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      115             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      116           .
      117         end.
      118       end.
      119       if p-key-rec = ? then do:
      120         assign
      121           p-key-rec = "":U
      122         .
      123         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      124       end.
      125     end.
      126     return.
      127   end procedure.
      128   procedure gen-where-keyr-tab :
      129     define input  parameter i-tableSerach as character no-undo.
      130     define input  parameter i-tablekey   as character  no-undo.
      131     define input  parameter p-key-rec    as character  no-undo.
      132     define input  parameter p-key-handle as handle     no-undo .
      133     define input  parameter p-db-name    as character  no-undo .
      134     define input  parameter p-tt-handle  as handle     no-undo .
      135     define output parameter o-Where      as character  no-undo.
      136     do
      137     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      138     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      139     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      140     :
      141       define variable v-full-tbl-name  as character no-undo .
      142       define variable bh_tbl-name      as handle    no-undo .
      143       define variable fh_key           as handle    no-undo .
      144       define variable fh_search        as handle    no-undo .
      145       define variable v-field-num      as integer   no-undo .
      146       define variable v-count-fld      as integer   no-undo .
      147       define variable v-inform         as character no-undo .
      148       define variable v-ind            as integer   no-undo .
      149       define variable v-idx-field-qnty as integer   no-undo .
      150       define variable v-field-name     as character no-undo .
      151       define variable v-field-val      as character no-undo .
      152       define variable v-word-link      as character no-undo .
      153       define variable vTable           as character no-undo.
      154       define variable bh_tbl-key       as handle    no-undo .
      155       assign
      156         p-key-rec = trim( p-key-rec )
      157       .
      158       if p-key-handle <> ? then do:
      159         if not valid-handle(p-key-handle)
      160            or p-key-handle:type <> "buffer"
      161         then do:
      162           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      163         end.
      164         if num-entries( p-key-rec, chr(3) ) > 1
      165           or p-key-rec = ?
      166           or p-key-rec = "":U
      167         then do:
      168           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      169         end.
      170       end.
      171       else do:
      172         if p-key-rec = ?
      173           or p-key-rec = "":U
      174         then do:
      175           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      176         end.
      177       end.
      178       assign
      179         vTable = entry( 1 , p-key-rec, chr(3) )
      180       .
      181       if p-tt-handle <> ?
      182         and ( not valid-handle(p-tt-handle)
      183               or p-tt-handle:type <> "buffer"
      184             )
      185       then do:
      186         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      187       end.
      188       if p-tt-handle = ? then do:
      189         assign
      190           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      191         .
      192         create buffer bh_tbl-name for table v-full-tbl-name .
      193       end.
      194       else do:
      195         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      196       end.
      197       assign
      198         v-inform = bh_tbl-name:index-information(1)
      199         v-ind    = 2
      200       .
      201       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      202       on error undo, return error
      203       :
      204         assign
      205           v-inform = bh_tbl-name:index-information( v-ind )
      206           v-ind    = v-ind + 1
      207         .
      208       end.
      209       if v-inform = ?
      210         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      211         or entry( 3, v-inform, ",":U ) <> "1":U
      212       then do:
      213         delete object bh_tbl-name no-error.
      214         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      215       end.
      216       assign
      217         v-idx-field-qnty = num-entries( v-inform ) - 4
      218       .
      219       if v-idx-field-qnty < 2 then do:
      220         delete object bh_tbl-name no-error.
      221         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      222       end.
      223       assign
      224         o-where     = "where":U
      225         v-word-link = "":U
      226         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      227         v-count-fld = 0
      228       .
      229       if i-tablekey ne "" and i-tablekey ne ?
      230       then do:
      231         assign
      232           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      233         .
      234         create buffer bh_tbl-key for table v-full-tbl-name .
      235       end.
      236       if i-tableSerach ne "" and i-tableSerach ne ?
      237       then do:
      238         delete object bh_tbl-name no-error.
      239         assign
      240           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      241         .
      242         create buffer bh_tbl-name for table v-full-tbl-name .
      243       end.
      244       block_where:
      245       do v-ind = 1 to v-idx-field-qnty by 2
      246       on error undo, return error
      247       :
      248         assign
      249           v-count-fld = v-count-fld + 1
      250         .
      251         if p-key-handle = ?
      252           and v-count-fld > v-field-num
      253         then do:
      254           leave block_where.
      255         end.
      256         define variable VfieldKeyTable as handle no-undo.
      257         assign
      258           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      259           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      260         .
      261         if     bh_tbl-key ne ?
      262         then do:
      263            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      264            if VfieldKeyTable eq ?
      265            then next block_where.
      266         end.
      267         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      268         then
      269            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      270         else
      271            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      272         if p-key-handle = ? then do:
      273           assign
      274             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      275           .
      276         end.
      277         else do:
      278           assign
      279             fh_key = p-key-handle:buffer-field( v-field-name )
      280           .
      281           if fh_key = ?
      282             or not valid-handle( fh_key )
      283           then do:
      284             delete object bh_tbl-name.
      285             if     bh_tbl-key ne ?
      286             then
      287                delete object bh_tbl-key.
      288             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      289           end.
      290           assign
      291             v-field-val = fh_key:buffer-value
      292           .
      293         end.
      294         if fh_search:data-type ="character":U then do:
      295           assign
      296             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      297             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      298             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      299             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      300             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      301             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      302             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      303             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      304             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      305             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      306             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      307             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      308             v-field-val = substitute( '"&1"', v-field-val )
      309           .
      310         end.
      311         assign
      312           o-where = substitute( "&1 &2", o-where, v-field-val )
      313         .
      314         if v-word-link = "":U then do:
      315           assign
      316             v-word-link = "and":U
      317           .
      318         end.
      319       end.
      320       delete object bh_tbl-name.
      321       if     bh_tbl-key ne ?
      322       then
      323          delete object bh_tbl-key.
      324       if p-key-handle = ?
      325         and v-count-fld <> v-field-num
      326       then do:
      327         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      328       end.
      329     end.
      330   end procedure.
      331   procedure gen-hn-keyr-tab :
      332     define input  parameter i-tableSerach as character no-undo.
      333     define input  parameter i-tablekey   as character no-undo.
      334     define input  parameter p-key-rec    as character no-undo.
      335     define input  parameter p-key-handle as handle    no-undo .
      336     define input  parameter p-db-name    as character no-undo .
      337     define input  parameter p-tt-handle  as handle    no-undo .
      338     define input  parameter p-stts-lock  as integer   no-undo .
      339     define output parameter o-hn         as handle    no-undo.
      340     define variable v-full-tbl-name as character no-undo.
      341     define variable v-where         as character no-undo.
      342     define variable bh_tbl-name     as handle    no-undo.
      343     define variable vTable          as character no-undo.
      344     do
      345     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      346     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      347     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      348         run gen-where-keyr-tab(i-tableSerach,
      349                                i-tablekey,
      350                                p-key-rec,
      351                                p-key-handle,
      352                                p-db-name,
      353                                p-tt-handle,
      354                                output v-where).
      355         if i-tableSerach ne "" and i-tableSerach ne ?
      356         then do:
      357            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      358            create buffer bh_tbl-name for table v-full-tbl-name .
      359         end.
      360         else do:
      361            if p-tt-handle = ? then do:
      362               assign
      363                  vTable = entry( 1 , p-key-rec, chr(3) )
      364               .
      365               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      366               create buffer bh_tbl-name for table v-full-tbl-name .
      367            end.
      368            else do:
      369               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      370            end.
      371         end.
      372         if p-tt-handle = ? then do:
      373            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      374         end.
      375         else do:
      376            bh_tbl-name:find-first( v-where ) no-error .
      377         end.
      378         o-hn = bh_tbl-name.
      379      end.
      380   end procedure.
      381   procedure gen-hn-keyr :
      382     define input  parameter p-key-rec    as character no-undo.
      383     define input  parameter p-key-handle as handle    no-undo .
      384     define input  parameter p-db-name    as character no-undo .
      385     define input  parameter p-tt-handle  as handle    no-undo .
      386     define input  parameter p-stts-lock  as integer   no-undo .
      387     define output parameter o-hn         as handle    no-undo.
      388     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      389   end.
      390   procedure gen-row-keyr :
      391     define input  parameter p-key-rec    as character no-undo.
      392     define input  parameter p-key-handle as handle    no-undo .
      393     define input  parameter p-db-name    as character no-undo .
      394     define input  parameter p-tt-handle  as handle    no-undo .
      395     define input  parameter p-stts-lock  as integer   no-undo .
      396     define output parameter p-tbl-row    as rowid     no-undo.
      397     define output parameter p-tbl-name   as character no-undo.
      398     define variable vHn as handle no-undo.
      399       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      400       p-tbl-row = if vHn:available then vHn:rowid else ?.
      401       p-tbl-name =  vHn:table.
      402       delete object vHn no-error.
      403     if p-tbl-row = ? then do:
      404       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      405     end.
      406     else do:
      407       return.
      408     end.
      409   end procedure.
      410   procedure gen-key-fv :
      411     define input  parameter p-key-rec    as character no-undo .
      412     define output parameter p-field-list as character no-undo .
      413     define output parameter p-value-list as character no-undo.
      414     do
      415     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      416     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      417     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      418     :
      419       define variable v-full-tbl-name  as character no-undo .
      420       define variable bh_tbl-name      as handle    no-undo .
      421       define variable v-tbl-name       as character no-undo .
      422       define variable v-field-num      as integer   no-undo .
      423       define variable v-count-fld      as integer   no-undo .
      424       define variable v-inform         as character no-undo .
      425       define variable v-ind            as integer   no-undo .
      426       define variable v-idx-field-qnty as integer   no-undo .
      427       define variable v-delim-key      as character no-undo .
      428       if p-key-rec = ?
      429         or p-key-rec = "":U
      430       then do:
      431         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      432       end.
      433       assign
      434         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      435         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      436       .
      437       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      438       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      439       assign
      440         v-inform = bh_tbl-name:index-information(1)
      441         v-ind    = 2
      442       .
      443       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      444       on error undo, return error
      445       :
      446         assign
      447           v-inform = bh_tbl-name:index-information( v-ind )
      448           v-ind    = v-ind + 1
      449         .
      450       end.
      451       if v-inform = ?
      452         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      453         or entry( 3, v-inform, ",":U ) <> "1":U
      454       then do:
      455         delete object bh_tbl-name no-error.
      456         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      457       end.
      458       assign
      459         v-idx-field-qnty = num-entries( v-inform ) - 4
      460       .
      461       if v-idx-field-qnty < 2 then do:
      462         delete object bh_tbl-name no-error.
      463         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      464       end.
      465       assign
      466         p-field-list = "":U
      467         p-value-list = "":U
      468         v-delim-key  = "":U
      469         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      470         v-count-fld  = 0
      471       .
      472       block_where:
      473       do v-ind = 1 to v-idx-field-qnty by 2
      474       on error undo, return error
      475       :
      476         assign
      477           v-count-fld = v-count-fld + 1
      478         .
      479         if v-count-fld > v-field-num then do:
      480           leave block_where.
      481         end.
      482         assign
      483           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      484           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      485         .
      486         if v-ind = 1 then do:
      487           assign
      488             v-delim-key = chr(3)
      489           .
      490         end.
      491       end.
      492       delete object bh_tbl-name.
      493       if v-count-fld <> v-field-num then do:
      494         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      495       end.
      496     end.
      497   end procedure.
      498   procedure gen-key-field :
      499     define input  parameter p-table      as character no-undo .
      500     define output parameter p-field-list as character no-undo .
      501     do
      502     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      503     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      504     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      505     :
      506       define variable v-full-tbl-name  as character no-undo .
      507       define variable bh_tbl-name      as handle    no-undo .
      508       define variable v-tbl-name       as character no-undo .
      509       define variable v-field-num      as integer   no-undo .
      510       define variable v-count-fld      as integer   no-undo .
      511       define variable v-inform         as character no-undo .
      512       define variable v-ind            as integer   no-undo .
      513       define variable v-idx-field-qnty as integer   no-undo .
      514       define variable v-delim-key      as character no-undo .
      515       if p-table = ?
      516         or p-table = "":U
      517       then do:
      518         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      519       end.
      520       assign
      521         v-tbl-name      = p-table
      522         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      523       .
      524       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      525       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      526       assign
      527         v-inform = bh_tbl-name:index-information(1)
      528         v-ind    = 2
      529       .
      530       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      531       on error undo, return error
      532       :
      533         assign
      534           v-inform = bh_tbl-name:index-information( v-ind )
      535           v-ind    = v-ind + 1
      536         .
      537       end.
      538       if v-inform = ?
      539         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      540         or entry( 3, v-inform, ",":U ) <> "1":U
      541       then do:
      542         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      543       end.
      544       assign
      545         v-idx-field-qnty = num-entries( v-inform ) - 4
      546       .
      547       if v-idx-field-qnty < 2 then do:
      548         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      549       end.
      550       assign
      551         p-field-list = "":U
      552         v-delim-key  = "":U
      553         v-count-fld  = 0
      554       .
      555       block_where:
      556       do v-ind = 1 to v-idx-field-qnty by 2
      557       on error undo, return error
      558       :
      559         assign
      560           v-count-fld = v-count-fld + 1
      561         .
      562         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      563         if v-ind = 1 then do:
      564           assign
      565             v-delim-key = chr(3)
      566           .
      567         end.
      568       end.
      569       delete object bh_tbl-name.
      570     end.
      571   end procedure.
