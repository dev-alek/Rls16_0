     1443   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
     1444        LABEL "Выход"
     1445        SIZE 15 BY 1.15
     1446        BGCOLOR 8 .
     1447   DEFINE BUTTON btn_del
     1448        LABEL "Удалить"
     1449        SIZE 15 BY 1.15 TOOLTIP "Безвозвратное удаления записи с УТМ".
     1450   DEFINE FRAME Dialog-Frame
     1451        Btn_Cancel AT ROW 1.26 COL 2
     1452        btn_del AT ROW 1.26 COL 17.75
     1453        SPACE(76.24) SKIP(23.32)
     1454       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1455            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1456            TITLE "Акт на накладную ЕГАИС"
     1457            CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
     1458   ASSIGN
     1459          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1460          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1461   ON window-close OF FRAME Dialog-Frame
     1462   do:
     1463       apply "END-ERROR":U to self.
     1464     end.
     1465   ON choose OF btn_del IN FRAME Dialog-Frame
     1466   do:
     1467     def var cmd as char no-undo.
     1468     if qh-analiz:get-current () = ?
     1469     then do:
     1470       message "Установите курсор на запись, которую хотите удалить." view-as alert-box information.
     1471       return no-apply.
     1472     end.
     1473     url_ = bh-wb-analiz:buffer-field ('url_'):buffer-value ().
     1474     if not egaisWB:actnEGAISAdm
     1475     then do:
     1476       return no-apply.
     1477     end.
     1478     message "Вы уверены что хотите удалить запись " + url_ + "? Также будет помечена как неверная запись в TH, если такая имеется по этой записи." view-as alert-box question buttons yes-no update isChoise as log.
     1479     if isChoise
     1480     then do:
     1481       cmd = substitute ("&1  -X DELETE &2", search ("exe/curl.exe"), url_).
     1482       os-command value (cmd).
     1483       do trans:
     1484         for each ub.clob-bind exclusive-lock
     1485           where ub.clob-bind.uniq-key-rec = bh-wb-analiz:buffer-field ('uniq-key-rec'):buffer-value ()
     1486             and ub.clob-bind.resource-type = bh-wb-analiz:buffer-field ('resource-type'):buffer-value ():
     1487             ub.clob-bind.uniq-key-rec = ub.clob-bind.uniq-key-rec + "#отмена".
     1488         end.
     1489         bh-wb-analiz:buffer-delete ().
     1490       end.
     1491     end.
     1492     else do:
     1493       return no-apply.
     1494     end.
     1495     run refresh-view.
     1496   end.
     1497   if valid-handle(active-window) and frame Dialog-Frame:PARENT eq ?
     1498     then frame Dialog-Frame:PARENT = active-window.
     1499   MAIN-BLOCK:
     1500   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
     1501     on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
     1502     def var ii as int no-undo.
     1503   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1504   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
     1505     (output v-db-num
     1506     ,output v-user-id
     1507     ) no-error .
     1508   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1509     run mainmenu_getcntxt in parparentproc
     1510       (output v-cntxt-db-num
     1511       ,output v-cntxt-userid
     1512       ,output v-cntxt-level
     1513       ,output v-cntxt-host-code-obj
     1514       ,output v-cntxt-obj-type
     1515       ,output v-cntxt-obj-code
     1516       ,output v-cntxt-db-num-obj
     1517       ,output v-cntxt-is-admin
     1518       ) .
     1519     create browse browse-hdl-analiz
     1520       assign
     1521       title     = ''
     1522       frame     = frame Dialog-Frame:handle
     1523       query     = qh-analiz
     1524       x         = 10
     1525       y         = 42
     1526       width     = 100
     1527       height    = 22
     1528       visible   = true
     1529       read-only = true
     1530       sensitive = true
     1531       separators = true
     1532       column-resizable = true
     1533       .
     1534     bh-wb-analiz = egaisWB:HndlAnaliz.
     1535     create query qh-analiz.
     1536     qh-analiz:set-buffers (bh-wb-analiz).
     1537     qh-analiz:query-prepare ("for each tt-analiz where tt-analiz.isMany by tt-analiz.nnOrder").
     1538     qh-analiz:query-open.
     1539     browse-hdl-analiz:query = qh-analiz.
     1540     do ii = 1 to bh-wb-analiz:num-fields:
     1541       browse-hdl-analiz:add-like-column('tt-analiz' + '.' + bh-wb-analiz:buffer-field (ii):name, 0, 'FILL-IN').
     1542     end.
     1543   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1544   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1545   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1546   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1547   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1548   define variable v-diasize-current-frame-height as decimal   no-undo .
     1549   define variable v-diasize-change-size          as logical   no-undo .
     1550   define variable v-diasize-resize-button        as handle    no-undo .
     1551   define variable v-diasize-wndmax               as logical   no-undo .
     1552   define variable v-diasize-wndstore             as logical   no-undo .
     1553   define variable v-diasize-proc-name            as character no-undo .
     1554   define variable v-diasize-browse-handle        as handle    no-undo .
     1555   define variable v-diasize-browse-number        as integer   no-undo .
     1556   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1557   define temp-table temp-diasize-handle no-undo
     1558     field handle-value  as handle
     1559     field save-position as decimal
     1560     index xpk is primary unique handle-value
     1561     .
     1562   define temp-table temp-browse-handle no-undo
     1563     field browse-type   as character
     1564     field browse-number as integer
     1565     field browse-handle as handle
     1566     field original-size as decimal
     1567     index xpk is primary unique browse-type browse-number
     1568     index xie browse-type browse-handle
     1569   .
     1570   procedure diasize_change-height :
     1571     define input  parameter p-change-value  as decimal   no-undo .
     1572     define input  parameter p-move-resize   as logical   no-undo .
     1573     define variable v-field-group-handle    as handle    no-undo .
     1574     define variable v-object-handle         as handle    no-undo .
     1575     define variable v-frame-height          as decimal   no-undo .
     1576     define variable v-frame-virtual-height  as decimal   no-undo .
     1577     define variable v-browse-height         as decimal   no-undo .
     1578     define variable v-window-height         as decimal   no-undo .
     1579     define variable v-window-virtual-height as decimal   no-undo .
     1580     define variable v-change-sign           as integer   no-undo .
     1581     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1582     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1583     if p-change-value > 0
     1584     then do:
     1585       if frame Dialog-Frame :height + p-change-value
     1586           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1587       then do:
     1588         assign
     1589           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1590                           - (frame Dialog-Frame :height-chars)
     1591         .
     1592         if p-change-value <= 0
     1593         then do:
     1594           run diasize_position-resize-button in this-procedure .
     1595           return .
     1596         end.
     1597       end.
     1598     end.
     1599     if p-change-value < 0
     1600     then do:
     1601       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1602       then do:
     1603         assign
     1604           p-change-value = v-diasize-orig-frame-height
     1605                          - (frame Dialog-Frame :height-chars)
     1606         .
     1607         if p-change-value >= 0
     1608         then do:
     1609           run diasize_position-resize-button in this-procedure .
     1610           return .
     1611         end.
     1612       end.
     1613     end.
     1614     if p-change-value >= 0
     1615     then do:
     1616       assign
     1617         v-change-sign = 1
     1618       .
     1619     end.
     1620     else do:
     1621       assign
     1622         v-change-sign = -1
     1623       .
     1624     end.
     1625     assign
     1626       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1627     .
     1628     if p-change-value = 0
     1629     then do:
     1630       run diasize_position-resize-button in this-procedure .
     1631       return .
     1632     end.
     1633     move_block:
     1634     do
     1635     on error undo move_block, retry move_block
     1636     :
     1637       if retry
     1638       then do:
     1639         do
     1640         on error undo move_block, leave move_block
     1641         :
     1642           if p-change-value > 0
     1643           then do:
     1644             for each buf_temp-diasize-handle
     1645             on error undo, next
     1646             :
     1647               assign
     1648                 v-object-handle = buf_temp-diasize-handle.handle-value
     1649               .
     1650               if v-object-handle <> v-diasize-resize-button
     1651               then do:
     1652                 assign
     1653                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1654                 .
     1655               end.
     1656             end.
     1657             assign
     1658               v-diasize-browse-handle :height = v-browse-height
     1659             .
     1660             for each buf_temp-browse-handle
     1661               where buf_temp-browse-handle.browse-type = 'height':u
     1662             on error undo, next
     1663             :
     1664               assign
     1665                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1666               .
     1667             end.
     1668             assign
     1669               frame Dialog-Frame :height = v-frame-height
     1670             .
     1671             if frame Dialog-Frame :scrollable = true
     1672             then do:
     1673               assign
     1674                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1675               .
     1676             end.
     1677             run diasize_position-resize-button in this-procedure .
     1678           end.
     1679           else do:
     1680             if frame Dialog-Frame :scrollable = true
     1681             then do:
     1682               assign
     1683                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1684               .
     1685             end.
     1686             assign
     1687               frame Dialog-Frame :height = v-frame-height
     1688             .
     1689             assign
     1690               v-diasize-browse-handle :height = v-browse-height
     1691             .
     1692             for each buf_temp-browse-handle
     1693               where buf_temp-browse-handle.browse-type = 'height':u
     1694             on error undo, next
     1695             :
     1696               assign
     1697                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1698               .
     1699             end.
     1700             for each buf_temp-diasize-handle
     1701             on error undo, next
     1702             :
     1703               assign
     1704                 v-object-handle = buf_temp-diasize-handle.handle-value
     1705               .
     1706               if v-object-handle <> v-diasize-resize-button
     1707               then do:
     1708                 assign
     1709                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1710                 .
     1711               end.
     1712             end.
     1713             run diasize_position-resize-button in this-procedure .
     1714           end.
     1715           assign
     1716             v-diasize-change-size = false
     1717           .
