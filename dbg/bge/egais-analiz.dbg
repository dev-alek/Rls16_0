     1792           v-diasize-resize-button :column = 1
     1793         .
     1794       end.
     1795       if p-change-value > 0
     1796       then do:
     1797         if frame Dialog-Frame :scrollable = true
     1798         then do:
     1799           assign
     1800             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1801             no-error .
     1802           if error-status :error
     1803           or error-status :get-message(1) <> ""
     1804           then do:
     1805             undo move_block, retry move_block .
     1806           end.
     1807         end.
     1808         assign
     1809           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1810           no-error .
     1811         if error-status :error
     1812         or error-status :get-message(1) <> ""
     1813         then do:
     1814           undo move_block, retry move_block .
