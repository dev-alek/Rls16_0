     1943     .
     1944   end procedure.
     1945   procedure diasize_set-height :
     1946     define input  parameter p-new-height  as decimal   no-undo .
     1947     define input  parameter p-move-resize as logical   no-undo .
     1948     do
     1949     on error undo, return error return-value
     1950     :
     1951       run diasize_change-height in this-procedure
     1952         (input  (p-new-height - frame Dialog-Frame :height)
     1953         ,input  p-move-resize
     1954         ) .
     1955     end.
     1956   end procedure.
     1957   procedure diasize_change-width :
     1958     define input  parameter p-change-value as decimal   no-undo .
     1959     define input  parameter p-move-resize  as logical   no-undo .
     1960     define variable v-field-group-handle   as handle    no-undo .
     1961     define variable v-object-handle        as handle    no-undo .
     1962     define variable v-frame-width          as decimal   no-undo .
     1963     define variable v-frame-virtual-width  as decimal   no-undo .
     1964     define variable v-browse-width         as decimal   no-undo .
     1965     define variable v-window-width         as decimal   no-undo .
     1966     define variable v-window-virtual-width as decimal   no-undo .
     1967     define variable v-change-sign          as integer   no-undo .
     1968     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1969     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1970     if p-change-value > 0
     1971     then do:
     1972       if frame Dialog-Frame :width + p-change-value >
     1973           session :width-chars
     1974       then do:
     1975         assign
     1976           p-change-value = session :width-chars - frame Dialog-Frame :width
     1977         .
     1978         if p-change-value <= 0
     1979         then do:
     1980           run diasize_position-resize-button in this-procedure .
     1981           return .
     1982         end.
     1983       end.
     1984     end.
     1985     if p-change-value < 0
     1986     then do:
     1987       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1988       then do:
     1989         assign
     1990           p-change-value = v-diasize-orig-frame-width
     1991                          - frame Dialog-Frame :width
     1992         .
     1993         if p-change-value >= 0
     1994         then do:
     1995           run diasize_position-resize-button in this-procedure .
     1996           return .
     1997         end.
     1998       end.
     1999     end.
     2000     if p-change-value >= 0
     2001     then do:
     2002       assign
     2003         v-change-sign = 1
     2004       .
     2005     end.
     2006     else do:
     2007       assign
     2008         v-change-sign = -1
     2009       .
     2010     end.
     2011     assign
     2012       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2013     .
     2014     if p-change-value = 0
     2015     then do:
     2016       run diasize_position-resize-button in this-procedure .
     2017       return .
     2018     end.
     2019     move_block:
     2020     do
     2021     on error undo move_block, leave move_block
