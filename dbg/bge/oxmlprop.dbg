        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Настройки OpenXML (SmartObject))".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define stream test.
      112   define variable v-old-exch-dir as character no-undo .
      113   define variable v-old-heap-dir as character no-undo .
      114   DEFINE BUTTON b-save DEFAULT
      115        LABEL "&Сохранить"
      116        SIZE 10 BY 1
      117        BGCOLOR 8 .
      118   DEFINE BUTTON b-sel-exch-dir DEFAULT
      119        IMAGE-UP FILE "btn-down-arrow":U
      120        IMAGE-DOWN FILE "btn-down-arrow":U
      121        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      122        LABEL "":L
      123        SIZE 2.5 BY 1.08.
      124   DEFINE BUTTON b-sel-heap-dir DEFAULT
      125        IMAGE-UP FILE "btn-down-arrow":U
      126        IMAGE-DOWN FILE "btn-down-arrow":U
      127        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      128        LABEL "":L
      129        SIZE 2.5 BY 1.08.
      130   DEFINE VARIABLE v-exch-dir AS CHARACTER FORMAT "X(256)":U
      131        LABEL "каталог exch"
      132        VIEW-AS FILL-IN
      133        SIZE 38 BY 1 NO-UNDO.
      134   DEFINE VARIABLE v-heap-dir AS CHARACTER FORMAT "X(256)":U
      135        LABEL "каталог heap"
      136        VIEW-AS FILL-IN
      137        SIZE 38 BY 1 NO-UNDO.
      138   DEFINE FRAME F-Main
      139        b-save AT ROW 1.13 COL 1
      140        b-sel-exch-dir AT ROW 2.5 COL 55
      141        v-exch-dir AT ROW 2.54 COL 14 COLON-ALIGNED
      142        b-sel-heap-dir AT ROW 3.67 COL 55
      143        v-heap-dir AT ROW 3.75 COL 14 COLON-ALIGNED
      144       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      145            SIDE-LABELS NO-UNDERLINE THREE-D
      146            AT COL 1 ROW 1
      147            SIZE 58.25 BY 4.5.
      148   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      149   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      150   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      151   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      152   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      153   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      154   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      155   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      156       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
      157   RUN ensure-broker.
      158   THIS-PROCEDURE:ADM-DATA =
      159        'ADM1.1~`':U +
      160        'SmartObject~`':U +
      161        'FRAME~`':U +
      162        'NO ~`':U +
      163        '~`':U +
      164        '~`':U +
      165        '~`':U +
      166        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      167           + "~`":U +
      168        'Layout,Hide-on-Init~`':U +
      169        '~`':U +
      170        '~`':U +
      171        '~`~`~`~`~`~`~`~`~`~`~`':U +
      172        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      173            THEN "^^":U
      174        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      175             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      176   PROCEDURE adm-apply-entry :
      177     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      178   END PROCEDURE.
      179   PROCEDURE adm-destroy :
      180    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      181   END PROCEDURE.
      182   PROCEDURE adm-disable :
      183       DISABLE b-save b-sel-exch-dir v-exch-dir b-sel-heap-dir v-heap-dir WITH FRAME F-Main.
      184       RUN dispatch ('disable-fields':U).
      185       RUN set-attribute-list ('ENABLED=no':U).
      186       RETURN.
      187   END PROCEDURE.
      188   PROCEDURE adm-edit-attribute-list :
      189         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
      190         RETURN.
      191   END PROCEDURE.
      192   PROCEDURE adm-enable :
      193       ENABLE UNLESS-HIDDEN b-save b-sel-exch-dir v-exch-dir b-sel-heap-dir v-heap-dir WITH FRAME F-Main.
      194       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      195       RUN set-attribute-list ('ENABLED=yes':U).
      196       RETURN.
      197   END PROCEDURE.
      198   PROCEDURE adm-exit :
      199        RUN notify ('exit':U).
      200     RETURN.
      201   END PROCEDURE.
      202   PROCEDURE adm-hide :
      203     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      204   END PROCEDURE.
      205   PROCEDURE adm-initialize :
      206     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      207   END PROCEDURE.
      208   PROCEDURE adm-show-errors :
      209       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      210       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      211           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      212       END.
      213       RETURN.
      214   END PROCEDURE.
      215   PROCEDURE adm-UIB-mode :
      216     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      217   END PROCEDURE.
      218   PROCEDURE adm-view :
      219     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      220   END PROCEDURE.
      221   PROCEDURE dispatch :
      222       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      223       RUN broker-dispatch IN adm-broker-hdl
      224           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      225       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      226   END PROCEDURE.
      227   PROCEDURE ensure-broker :
      228   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      229   IF RETURN-VALUE NE "ADM-Broker":U THEN
      230   DO:
      231       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      232       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      233   END.
      234   END PROCEDURE.
      235   PROCEDURE get-attribute :
      236     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      237     RUN broker-get-attribute IN adm-broker-hdl
      238         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      239     RETURN RETURN-VALUE.
      240   END PROCEDURE.
      241   PROCEDURE get-attribute-list :
      242     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      243     RUN broker-get-attribute-list IN adm-broker-hdl
      244         (INPUT THIS-PROCEDURE,
      245          INPUT ?,
      246          OUTPUT p-attr-list) NO-ERROR.
      247     RETURN.
      248   END PROCEDURE.
      249   PROCEDURE new-state :
      250     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      251     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      252     RETURN.
      253   END PROCEDURE.
      254   PROCEDURE notify :
      255     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      256     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      257     IF RETURN-VALUE = "ADM-ERROR":U THEN
      258         RETURN "ADM-ERROR":U.
      259     RETURN.
      260   END PROCEDURE.
      261   PROCEDURE set-attribute-list :
      262     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      263     RUN ensure-broker.
      264     RUN broker-set-attribute-list IN adm-broker-hdl
      265         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      266     RETURN.
      267   END PROCEDURE.
      268   PROCEDURE set-position :
      269       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      270       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      271       IF VALID-HANDLE(adm-object-hdl) THEN
      272       DO:
      273           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
      274           IF adm-object-hdl:TYPE = "WINDOW":U THEN
      275           DO:
      276             IF p-row = 0 THEN p-row =
      277               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
      278             IF p-col = 0 THEN p-col =
      279               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
      280           END.
      281           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
      282           DO:
      283             parent-hdl = adm-object-hdl:PARENT.
      284             IF p-row = 0 THEN p-row =
      285               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
      286                 parent-hdl:ROW.
      287             IF p-col = 0 THEN p-col =
      288               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
      289                 parent-hdl:COL.
      290           END.
      291           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
      292           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
      293         ASSIGN adm-object-hdl:ROW    =   p-row
      294                adm-object-hdl:COLUMN =   p-col.
      295       END.
      296       RETURN.
      297   END PROCEDURE.
      298   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
      299       STRING(adm-object-hdl)).
      300   PAUSE 0 BEFORE-HIDE.
      301   PROCEDURE adm-change-page :
      302     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
      303     END PROCEDURE.
      304   PROCEDURE delete-page :
      305     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
      306     RUN broker-delete-page IN adm-broker-hdl
      307         (INPUT THIS-PROCEDURE, INPUT p-page#).
      308     END PROCEDURE.
      309   PROCEDURE init-object :
      310     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
      311     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
      312     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
      313     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
      314     RUN broker-init-object IN adm-broker-hdl
      315         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
      316          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
      317     RETURN.
      318   END PROCEDURE.
      319   PROCEDURE init-pages :
      320     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
      321     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      322         INPUT p-page-list) NO-ERROR.
      323     END PROCEDURE.
      324   PROCEDURE select-page :
      325     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
      326     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      327         INPUT p-page#) NO-ERROR.
      328     END PROCEDURE.
      329   PROCEDURE view-page :
      330     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
      331     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      332         INPUT p-page#).
      333     END PROCEDURE.
      334   ON CHOOSE OF b-save IN FRAME F-Main
      335   DO:
      336     define variable v-err-message as character no-undo .
      337     assign
      338       v-exch-dir
      339       v-heap-dir
      340     .
      341     if v-exch-dir = v-heap-dir then do:
      342       message
      343       "Каталог EXCH и каталог HEAP должны различаться." skip(1)
      344       "папкой обмена EXCH для системы OXML указан каталог" skip
      345       v-exch-dir skip(1)
      346       "папкой разбора HEAP для системы OXML указан каталог" skip
      347       v-heap-dir
      348       view-as alert-box error .
      349       return no-apply.
      350     end.
      351     run check-dir ( input-output v-exch-dir ) no-error.
      352     if error-status :error then do:
      353       message
      354         vss-workfile vss-revision vss-description skip
      355         return-value skip
      356         error-status :get-message(0) skip
      357         error-status :get-message(1)
      358         view-as alert-box error.
      359       return no-apply.
      360     end.
      361     else do:
      362       if v-exch-dir <> v-old-exch-dir then do:
      363         v-err-message = ibs.th.gbl.gbl-inipar:PutKeyValue("OXML":U, "oxml-exch-dir":U, v-exch-dir) .
      364         if v-err-message > "" then do:
      365           message
      366             vss-workfile vss-revision vss-description skip
      367             v-err-message skip(1)
      368             "Возможно, файл настроек progress доступен только для чтения." skip
      369             "Сохранение параметра отклонено."
      370             view-as alert-box error.
      371           return no-apply.
      372         end.
      373       end.
      374     end.
      375     run check-dir ( input-output v-heap-dir ) no-error.
      376     if error-status :error then do:
      377       message
      378         vss-workfile vss-revision vss-description skip
      379         return-value skip
      380         error-status :get-message(0) skip
      381         error-status :get-message(1)
      382         view-as alert-box error.
      383       return no-apply.
      384     end.
      385     else do:
      386       if v-heap-dir <> v-old-heap-dir then do:
      387         v-err-message = ibs.th.gbl.gbl-inipar:PutKeyValue("OXML":U, "oxml-dir":U, v-heap-dir) .
      388         if v-err-message > "" then do:
      389           message
      390             vss-workfile vss-revision vss-description skip
      391             v-err-message skip(1)
      392             "Возможно, файл настроек progress доступен только для чтения." skip
      393             "Сохранение параметра отклонено."
      394             view-as alert-box error.
      395           return no-apply.
      396         end.
      397       end.
      398     end.
      399     message
      400       "Настройки OpenXML сохранены"
      401       view-as alert-box information.
      402   END.
      403   ON CHOOSE OF b-sel-exch-dir IN FRAME F-Main
      404   DO:
      405     define variable v-dir-name  as character no-undo .
      406     define variable v-type      as character no-undo .
      407     define variable v-can-write as logical   no-undo .
      408     run gbl/dir-sel.p ( output v-dir-name
      409                    ,output v-type
      410                    ,output v-can-write
      411                   ).
      412     if v-can-write then do:
      413       assign
      414         v-exch-dir = v-dir-name
      415       .
      416       display
      417         v-exch-dir
      418         with frame F-Main
      419       .
      420     end.
      421     APPLY "ENTRY" TO v-exch-dir IN FRAME F-Main .
      422   END.
      423   ON CHOOSE OF b-sel-heap-dir IN FRAME F-Main
      424   DO:
      425     define variable v-dir-name  as character no-undo .
      426     define variable v-type      as character no-undo .
      427     define variable v-can-write as logical   no-undo .
      428     run gbl/dir-sel.p ( output v-dir-name
      429                    ,output v-type
      430                    ,output v-can-write
      431                   ).
      432     if v-can-write then do:
      433       assign
      434         v-heap-dir = v-dir-name
      435       .
      436       display
      437         v-heap-dir
      438         with frame F-Main
      439       .
      440     end.
      441     APPLY "ENTRY" TO v-heap-dir IN FRAME F-Main .
      442   END.
      443   if not this-procedure :persistent
      444   then do:
      445     message
      446       vss-workfile vss-revision vss-description skip
      447       "Ошибка при запуске процедуры" skip
      448       "Данную процедуру следует запускать только с параметром persistent" skip
      449       view-as alert-box error .
      450     undo, return error .
      451   end.
      452   assign
      453     v-exch-dir = ibs.th.gbl.gbl-inipar:oxmlExchDir
      454     v-heap-dir = ibs.th.gbl.gbl-inipar:oxmlDir
      455   .
      456   assign
      457     v-exch-dir = "":U when v-exch-dir = ?
      458     v-heap-dir = "":U when v-heap-dir = ?
      459   .
      460   assign
      461     v-old-exch-dir = v-exch-dir
      462     v-old-heap-dir = v-heap-dir
      463   .
      464   PROCEDURE adm-create-objects :
      465   END PROCEDURE.
      466   PROCEDURE adm-row-available :
      467     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      468     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      469     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      470     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      471     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      472     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      473     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      474     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      475     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      476     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      477     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      478     IF adm-updating-record THEN RETURN.
      479     RUN get-attribute ('FIELDS-ENABLED':U).
      480     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      481     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      482         OUTPUT link-handle) NO-ERROR.
      483     IF link-handle = "":U THEN
      484         RETURN.
      485     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      486     IF NUM-ENTRIES(link-handle) > 1 THEN
      487         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      488             "encountered more than one RECORD-SOURCE.":U SKIP
      489             "The first - ":U record-source-hdl:file-name " - will be used.":U
      490                VIEW-AS ALERT-BOX ERROR.
      491     RUN get-attribute ('Key-Name':U).
      492     key-name = RETURN-VALUE.
      493     IF key-name = "":U THEN key-name = ?.
      494     IF key-name NE ? THEN DO:
      495       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      496         NO-ERROR.
      497       IF key-value NE ? THEN
      498         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      499     END.
      500   IF VALID-HANDLE (adm-object-hdl) THEN
      501       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      502   RUN notify IN THIS-PROCEDURE ('row-available':U).
      503   END PROCEDURE.
      504   PROCEDURE check-dir :
      505   define input-output parameter p-dir-name as character no-undo .
      506   do
      507   on error undo, return error
      508   :
      509     define variable v-log as logical no-undo .
      510     assign
      511       file-info:file-name = p-dir-name
      512     .
      513     if file-info:file-type <> ?
      514       and index( file-info:file-type, "D":U ) <> 0
      515     then do:
      516       output stream test to "test.tst":U .
      517       put stream test unformatted "test":U skip.
      518       output stream test close.
      519       os-copy "test.tst":U value( p-dir-name ) .
      520       if os-error <> 0 then do:
      521         return error string( "Каталог" + chr(32) + p-dir-name + chr(32)
      522                              + "недоступен для чтения и(или) записи!"
      523                              + chr(10) + "Сохранение параметров невозможно."
      524                            ).
      525       end.
      526       else do:
      527         os-delete value( "test.tst":U ) .
      528         os-delete value( p-dir-name + chr(92) + "test.tst":U ) .
      529       end.
      530     end.
      531     else do:
      532       message
      533         "Каталог" p-dir-name "не существует!" skip
      534         "Cоздать его?"
      535         view-as alert-box information buttons yes-no update v-log.
      536       if v-log = false then do:
      537         return error substitute( "Отказ от создания каталога!" ).
      538       end.
      539       else do:
      540         run gbl/dir-cre.p ( input p-dir-name ) no-error .
      541         if error-status:error then do:
      542           return error substitute( "Ошибка при создании каталога &1&2&3", p-dir-name, chr(10), return-value ).
      543         end.
      544       end.
      545     end.
      546     assign
      547       file-info:file-name = p-dir-name
      548     .
      549     if file-info:file-type <> ? then do:
      550       assign
      551         p-dir-name = file-info:full-pathname
      552       .
      553     end.
      554   end.
      555   END PROCEDURE.
      556   PROCEDURE disable_UI :
      557     HIDE FRAME F-Main.
      558     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      559   END PROCEDURE.
      560   PROCEDURE enable_UI :
      561     DISPLAY v-exch-dir v-heap-dir
      562         WITH FRAME F-Main.
      563     ENABLE b-save b-sel-exch-dir v-exch-dir b-sel-heap-dir v-heap-dir
      564         WITH FRAME F-Main.
      565   END PROCEDURE.
      566   PROCEDURE send-records :
      567   END PROCEDURE.
      568   PROCEDURE state-changed :
      569     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
      570     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      571   END PROCEDURE.
