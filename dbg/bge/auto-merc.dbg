      523     define variable v-issuerId            as character no-undo .
      524     define variable v-login               as character no-undo .
      525     define variable v-login_is            as character no-undo .
      526     define variable v-password            as character no-undo .
      527     define variable v-initiator           as character no-undo .
      528     define variable v-type-connect        as integer   no-undo .
      529     define variable v-server              as integer   no-undo .
      530     define variable v-proxy-login         as character no-undo .
      531     define variable v-proxy-pswd          as character no-undo .
      532     define variable v-proxy-addres        as character no-undo .
      533     define variable v-proxy-ssl           as logical   no-undo .
      534     define variable v-appId           as character no-undo .
      535     define variable v-status_         as character no-undo .
      536     define variable v-Msg             as character no-undo .
      537     define buffer buf_ext-classif       for ub.ext-classif .
      538     define buffer buf2_ext-classif      for ub.ext-classif .
      539     define buffer buf_ext-system        for ub.ext-system .
      540     define buffer buf_parts             for ub.parts .
      541     define buffer buf_vsd               for ub.vsd .
      542     define buffer buf_clients           for ub.clients .
      543     define buffer buf_esys-all-attr     for ub.esys-all-attr .
      544     define buffer buf_db                for ub.db .
      545     define variable mercury       as class ibs.th.bge.mercury.mercury       no-undo.
      546     define variable vsdStorage    as class ibs.th.gbl.storage.vsdtostorage  no-undo.
      547     define variable vsdsTHObj     as class ibs.th.str.mercury.vsdsubs       no-undo.
      548     define variable vsdTHObj      as class ibs.th.str.mercury.vsdsub        no-undo.
      549     define variable vsdStsType    as class ibs.th.str.mercury.vsdstatustype no-undo.
      550     define variable objThObj      as class ibs.th.str.clients.clisub        no-undo.
      551     define variable objKeyRec     as class ibs.th.gbl.keyrec                no-undo.
      552     define variable v-part-rowid as rowid no-undo .
      553     define variable v-tbl-name as character no-undo .
      554     define variable ii as integer no-undo.
      555     if transaction then do:
      556       message
      557         substitute( "&1. Вызов данной процедуры невозможен при наличии транзакции", vss-workfile )
      558         view-as alert-box error .
      559       return error .
      560     end.
      561     if valid-handle( session :first-procedure ) then do:
      562       assign
      563         v-main-proc-name = "gbl/mainproc.p":U
      564         v-proc-handle    = session :first-procedure
      565         v-count-main-prc = 0
      566         v-pers-proc-name = "":U
      567       .
      568       do while valid-handle( v-proc-handle )
      569       :
      570         if v-proc-handle :file-name = v-main-proc-name then do:
      571           assign
      572             v-count-main-prc = v-count-main-prc + 1
      573           .
      574         end.
      575         else do:
      576           assign
      577             v-pers-proc-name = v-pers-proc-name + chr(44) + v-proc-handle :file-name
      578           .
      579         end.
      580         assign
      581           v-proc-handle = v-proc-handle:next-sibling no-error
      582         .
      583       end.
      584       if v-count-main-prc > 1
      585         or v-pers-proc-name <> "":U
      586       then do:
      587         message
      588           substitute( "&1. Вызов данной процедуры невозможен при наличии определений persistent prosedures &2"
      589                       + "Список недопустимых процедур: &3&2"
      590                       + "Исключение - единственная процедура &4&2"
      591                       + "Определений данной процедуры &5&2"
      592                       , vss-workfile
      593                       , chr(10)
      594                       , v-pers-proc-name
      595                       , v-main-proc-name
      596                       , v-count-main-prc
      597                      )
      598           view-as alert-box error .
      599         return error .
      600       end.
      601     end.
      602     assign
      603       g#auto                = true
      604       v-num-entries-db-list = num-entries( p-list-db )
      605     .
      606     run gbl/set-gbl.p
      607       (input true
      608       ,input p-user-login
      609       ,input p-user-password
      610       ) no-error.
      611     if error-status :error
      612     then do:
      613       run write-to-log( substitute("&1. Ошибка при инициализации переменных g#... &2&3&4"
      614                                     ,vss-workfile
      615                                     ,error-status:get-message(error-status:num-messages)
      616                                     ,chr(10)
      617                                     ,return-value
      618                                   )
      619                       ) .
      620       return error.
      621     end.
      622     assign
      623       g#auto = true
      624     .
      625     find first buf_ext-system no-lock where buf_ext-system.esys-type = integer('10':U) no-error.
      626     if not available buf_ext-system
      627     then do :
      628       run write-to-log( "Нет внешней системы с типом Меркурий." ) .
      629       return .
      630     end.
      631     SECURITY-POLICY:SYMMETRIC-ENCRYPTION-KEY = GENERATE-PBE-KEY("sysadm").
      632     objThObj = new clisub ().
      633     vsdStsType = new vsdstatustype().
      634     run write-to-log( "Получение ответов на отправленные запросы " ) .
      635     ans_ :
      636     for each buf_esys-all-attr no-lock where buf_esys-all-attr.table-name = "esys-pck-sent"
      637                                         and buf_esys-all-attr.attr-code = "mercury"
      638                                         and buf_esys-all-attr.key3 = "Запрос отправлен" :
      639       find first buf_vsd no-lock where buf_vsd.UUID = buf_esys-all-attr.attr-value no-error.
      640       if not available buf_vsd then next ans_ .
      641       if not can-do(p-list-db, string(buf_vsd.db-num))
      642       then do :
      643         next ans_ .
      644       end .
      645   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      646   empty temp-table thbjattr_thbj-attr.
      647   run adm/shattri.p (
      648      input "get":U
      649     ,input buf_vsd.obj-type
      650     ,input buf_vsd.obj-code
      651     ,input 'mercur':U
      652     ,input  ""
      653     ,output v-value-character
      654     ,output v-value-date
      655     ,output v-value-decimal
      656     ,output v-value-integer
      657     ,output v-value-logical
      658     ,output par-type
      659     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      660     ) no-error .
      661       for each thbjattr_thbj-attr :
      662         case thbjattr_thbj-attr.prop-code :
      663           when "apikey" then v-apiKey = thbjattr_thbj-attr.property-value-character .
      664           when "login" then v-login = thbjattr_thbj-attr.property-value-character .
      665           when "login_is" then v-login_is = thbjattr_thbj-attr.property-value-character .
      666           when "password" then v-password = thbjattr_thbj-attr.property-value-character .
      667           when "type-connect" then v-type-connect = thbjattr_thbj-attr.property-value-integer .
      668           when "server" then v-server = thbjattr_thbj-attr.property-value-integer .
      669           when "proxy-addres" then v-proxy-addres = thbjattr_thbj-attr.property-value-character .
      670           when "proxy-login" then do:
      671             if thbjattr_thbj-attr.property-value-character <> ""
      672             then do :
      673   define variable vss-include-info7 as character format "X(65)" no-undo
      674   initial "@(#)$Workfile$ $Revision$".
      675   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      676     (input  thbjattr_thbj-attr.property-value-character
      677     ,output v-proxy-login
      678     ) no-error .
      679             end.
      680           end.
      681           when "proxy-pswd" then do:
      682             if thbjattr_thbj-attr.property-value-character <> ""
      683             then do :
      684   define variable vss-include-info8 as character format "X(65)" no-undo
      685   initial "@(#)$Workfile$ $Revision$".
      686   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      687     (input  thbjattr_thbj-attr.property-value-character
      688     ,output v-proxy-pswd
      689     ) no-error .
      690             end.
      691           end.
      692           when "proxy-ssl" then v-proxy-ssl = thbjattr_thbj-attr.property-value-logical .
      693         end case.
      694       end.
      695       if g#db-num <> 0 and v-type-connect = 2
      696       then do :
      697         next ans_ .
      698       end.
      699       find first buf_clients no-lock where buf_clients.obj-type = buf_vsd.obj-type and buf_clients.obj-code = buf_vsd.obj-code no-error.
      700       if not available buf_clients
      701       then do :
      702         run write-to-log( "В ВСД с UUID " + buf_vsd.UUID + " не верно задан объект!!!") .
      703         next ans_ .
      704       end.
      705       if v-type-connect = 1 and g#db-num <> 0 and g#db-num <> buf_clients.db-num
      706       then do :
      707         next ans_ .
      708       end.
      709       if g#db-num = 0 and v-type-connect = 1 and buf_clients.db-num <> 0
      710       then do :
      711         next ans_ .
      712       end.
      713       find first buf_db no-lock where buf_db.db-num = buf_clients.db-num .
      714       if buf_db.stts = 2
      715       then do :
      716         run write-to-log( "БД " + string(buf_db.db-num) + " выгружается. Пропускаем." ).
      717         next ans_ .
      718       end.
      719       find first buf_ext-classif no-lock
      720             where buf_ext-classif.classif-subject = 'clients':U
      721               and buf_ext-classif.classif-name = 'clients-esys':U
      722               and buf_ext-classif.db-num = 0
      723               and buf_ext-classif.key#_one = buf_ext-system.esys-id
      724               and buf_ext-classif.uniq-key-rec = 'clients':U + chr(3) + "орг" + chr(3) + string (buf_clients.host-code)
      725               no-error.
      726       if not available buf_ext-classif
      727       then do :
      728         run write-to-log( "Фирма орг" + string (buf_clients.host-code) + " не синхронизирована с ФГИС Меркурий (Нет GUID'а ХЗ)" ) .
      729         next ans_ .
      730       end.
      731       v-issuerId = entry(1, buf_ext-classif.charKey_Two, chr(6)) .
      732       mercury = new mercury(v-apiKey, v-issuerId, v-login, v-password, v-login_is, buf_ext-system.esys-id, v-server, v-proxy-addres, v-proxy-login, v-proxy-pswd, v-proxy-ssl, buf_db.db-num).
      733       mercury:vsdId = buf_esys-all-attr.key1.
      734       case buf_esys-all-attr.key2 :
      735         when 1
      736         then do :
      737           find first buf_vsd no-lock where buf_vsd.UUID = buf_esys-all-attr.attr-value and buf_vsd.ID =  buf_esys-all-attr.key1 no-error.
      738           if not available buf_vsd then next .
      739           objKeyRec = new keyrec () .
      740           objKeyRec:GenRowKeyr(buf_vsd.part-key, ?, "ub", ?, ?, v-part-rowid, v-tbl-name) .
      741           delete object objKeyRec no-error .
      742           find first buf_parts no-lock where rowid (buf_parts) = v-part-rowid no-error.
      743           if not available  buf_parts
      744           then do :
      745             run write-to-log( "ВСД с UUID " + buf_vsd.UUID + " не привязана к партии!!!") .
      746             next ans_.
      747           end.
      748           run write-to-log( "Получение ответа на запрос ВСД по UUID " + buf_vsd.UUID ) .
      749           do transaction :
      750             mercury:receiveVetDoc(input buf_esys-all-attr.key7, input LC(buf_esys-all-attr.attr-value), input buf_parts.qnty, input buf_parts.fact-qnty, input (buf_vsd.status_ = vsdStsType:IsUtilized), output v-Status_, output v-Msg) .
      751             delete object mercury no-error .
      752             find first ub.esys-all-attr exclusive-lock where rowid(ub.esys-all-attr) = rowid(buf_esys-all-attr) .
      753             if v-Status_ = "COMPLETED"
      754             then ub.esys-all-attr.key3 = "Ответ получен" .
      755             else do :
      756               v-Msg = trim(trim(v-Msg, chr(10))) .
      757               if v-Msg = ""
      758               then do :
      759                 v-Msg = "Нет связи со шлюзом Ветис.Api..." .
      760                 run write-to-log( v-Msg ) .
      761               end.
      762               else do :
      763                 ub.esys-all-attr.key3 = "Запрос отклонён" .
      764                 run write-to-log( "UUID ВСД:  " + buf_esys-all-attr.attr-value + chr(10) + v-Msg ) .
      765               end.
      766             end.
      767             release ub.esys-all-attr .
      768           end.
      769         end.
      770         when 2
      771         then do :
      772           run write-to-log( "Получение ответа на запрос на гашение ВСД с UUID " + buf_esys-all-attr.attr-value ) .
      773           do transaction :
      774             mercury:receiveIncomingConsignmentResponse(input buf_esys-all-attr.key7, input buf_esys-all-attr.attr-value, output v-Status_, output v-Msg) .
      775             delete object mercury no-error .
      776             find first ub.esys-all-attr exclusive-lock where rowid(ub.esys-all-attr) = rowid(buf_esys-all-attr) .
      777             if v-Status_ = "COMPLETED"
      778             then ub.esys-all-attr.key3 = "Ответ получен" .
      779             else do :
      780               v-Msg = trim(trim(v-Msg, chr(10))) .
      781               if v-Msg = ""
      782               then do :
      783                 v-Msg = "Нет связи со шлюзом Ветис.Api..." .
      784                 run write-to-log( v-Msg ) .
      785               end.
      786               else do :
      787                 ub.esys-all-attr.key3 = "Запрос отклонён" .
      788                 if v-Msg = "MERC14561"
      789                 or v-Msg = "MERC14562"
      790                 or v-Msg = "MERC14563"
      791                 then
      792                   run write-to-log( "UUID ВСД:  " + buf_esys-all-attr.attr-value + chr(10) + "Ошибка наименования продукции " + v-Msg + ". ВСД будет погашено с актом несоответсвия." ) .
      793                 else
      794                 if v-Msg = "MERC14258"
      795                 or v-Msg = "MERC14537"
      796                 then
      797                   run write-to-log( "UUID ВСД:  " + buf_esys-all-attr.attr-value + chr(10) + "Ошибка номера партии/ТТН " + v-Msg + ". ВСД будет погашено с актом несоответсвия." ) .
      798                 else
      799                   run write-to-log( "UUID ВСД:  " + buf_esys-all-attr.attr-value + chr(10) + v-Msg ) .
      800               end.
      801             end.
      802           end.
      803         end.
      804       end case.
      805       delete object mercury no-error .
      806     end.
      807     pause 0.2 .
      808     do v-ind = 1 to v-num-entries-db-list
      809     on error undo, return error
      810     :
      811       assign
      812         v-db-num = integer( entry( v-ind, p-list-db ) )
      813       .
      814       find first buf_db no-lock where buf_db.db-num = v-db-num .
      815       if buf_db.stts = 2
      816       then do :
      817         run write-to-log( "БД " + string(v-db-num) + " выгружается. Пропускаем." ).
      818         next .
      819       end.
      820       run write-to-log( "Работа с БД " + string(v-db-num) ) .
      821       clients_ :
      822       for each clients no-lock where clients.obj-type = 'маг':U
      823                                  and clients.db-num = v-db-num
      824                                  and clients.stts = 0 :
      825   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      826   empty temp-table thbjattr_thbj-attr.
      827   run adm/shattri.p (
      828      input "get":U
      829     ,input clients.obj-type
      830     ,input clients.obj-code
      831     ,input 'mercur':U
      832     ,input  ""
      833     ,output v-value-character
      834     ,output v-value-date
      835     ,output v-value-decimal
      836     ,output v-value-integer
      837     ,output v-value-logical
      838     ,output par-type
      839     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      840     ) no-error .
      841         for each thbjattr_thbj-attr :
      842           case thbjattr_thbj-attr.prop-code :
      843             when "apikey" then v-apiKey = thbjattr_thbj-attr.property-value-character .
      844             when "login" then v-login = thbjattr_thbj-attr.property-value-character .
      845             when "login_is" then v-login_is = thbjattr_thbj-attr.property-value-character .
      846             when "password" then v-password = thbjattr_thbj-attr.property-value-character .
      847             when "type-connect" then v-type-connect = thbjattr_thbj-attr.property-value-integer .
      848             when "server" then v-server = thbjattr_thbj-attr.property-value-integer .
      849             when "proxy-addres" then v-proxy-addres = thbjattr_thbj-attr.property-value-character .
      850             when "proxy-login" then do:
      851               if thbjattr_thbj-attr.property-value-character <> ""
      852               then do :
      853   define variable vss-include-info10 as character format "X(65)" no-undo
      854   initial "@(#)$Workfile$ $Revision$".
      855   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      856     (input  thbjattr_thbj-attr.property-value-character
      857     ,output v-proxy-login
      858     ) no-error .
      859               end.
      860             end.
      861             when "proxy-pswd" then do:
      862               if thbjattr_thbj-attr.property-value-character <> ""
      863               then do :
      864   define variable vss-include-info11 as character format "X(65)" no-undo
      865   initial "@(#)$Workfile$ $Revision$".
      866   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      867     (input  thbjattr_thbj-attr.property-value-character
      868     ,output v-proxy-pswd
      869     ) no-error .
      870               end.
      871             end.
      872             when "proxy-ssl" then v-proxy-ssl = thbjattr_thbj-attr.property-value-logical .
      873           end case.
      874         end.
      875         if v-type-connect = 1 and g#db-num <> 0 and g#db-num <> clients.db-num
      876         then do :
      877           next clients_.
      878         end.
      879         if g#db-num <> 0 and v-type-connect = 2
      880         then do :
      881           next clients_.
      882         end.
      883         if g#db-num = 0 and v-type-connect = 1 and clients.db-num <> 0
      884         then do :
      885           next clients_.
      886         end.
      887         find first buf_ext-classif no-lock
      888               where buf_ext-classif.classif-subject = 'clients':U
      889                 and buf_ext-classif.classif-name = 'clients-esys':U
      890                 and buf_ext-classif.db-num = 0
      891                 and buf_ext-classif.key#_one = buf_ext-system.esys-id
      892                 and buf_ext-classif.uniq-key-rec = 'clients':U + chr(3) + "орг" + chr(3) + string (clients.host-code)
      893                 no-error.
      894         if not available buf_ext-classif
      895         then do :
      896           run write-to-log( "Фирма орг" + string (clients.host-code) + " не синхронизирована с ФГИС Меркурий (Нет GUID'а ХЗ)" ) .
      897           next clients_.
      898         end.
      899         v-issuerId = entry(1, buf_ext-classif.charKey_Two, chr(6)) .
      900         mercury = new mercury(v-apiKey, v-issuerId, v-login, v-password, v-login_is, buf_ext-system.esys-id, v-server, v-proxy-addres, v-proxy-login, v-proxy-pswd, v-proxy-ssl, buf_db.db-num).
      901         objThObj:ObjType = clients.obj-type.
      902         objThObj:ObjCode = clients.obj-code.
      903         vsdsTHObj = new vsdsubs ().
      904         vsdsTHObj:IsDelChildObj = yes .
      905         vsdStorage = new vsdtostorage ().
      906         vsdsTHObj = vsdStorage:getVSDsubs(input objThObj).
      907         find first buf_ext-classif no-lock
      908             where buf_ext-classif.classif-subject = 'clients':U
      909               and buf_ext-classif.classif-name = 'clients-esys':U
      910               and buf_ext-classif.db-num = 0
      911               and buf_ext-classif.key#_one = buf_ext-system.esys-id
      912               and buf_ext-classif.uniq-key-rec = 'clients':U + chr(3) + clients.obj-type + chr(3) + string (clients.obj-code)
      913               no-error.
      914         run write-to-log( "Отправка запросов по объекту " + clients.obj-type + string(clients.obj-code) ) .
      915         vsds_ :
      916         do ii = 1 to vsdsTHObj:GetItem (ii):
      917           if ii = 1 and not available buf_ext-classif
      918           then do :
      919             run write-to-log( "Объект маг" + string (clients.obj-code) + " не синхронизирован с ФГИС Меркурий (Нет GUID'а предприятия)" ) .
      920             delete object vsdsTHObj no-error .
      921             delete object vsdStorage no-error .
      922             next clients_.
      923           end.
      924           if date(vsdsTHObj:VsdObjCurr:FactDatetime) < (today - 14) then next vsds_ .
      925           if vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsNeedCheck
      926           or vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsErrCheck
      927           or vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsErrUtilized
      928           then do :
      929             if vsdsTHObj:VsdObjCurr:UUID = "" or vsdsTHObj:VsdObjCurr:UUID = ? or vsdsTHObj:VsdObjCurr:FactDatetime = ? then next .
      930             find first buf2_ext-classif no-lock
      931                 where buf2_ext-classif.classif-subject = 'clients':U
      932                   and buf2_ext-classif.classif-name = 'clients-esys':U
      933                   and buf2_ext-classif.db-num = 0
      934                   and buf2_ext-classif.key#_one = buf_ext-system.esys-id
      935                   and buf2_ext-classif.uniq-key-rec = 'clients':U + chr(3) + vsdsTHObj:VsdObjCurr:CliType + chr(3) + string (vsdsTHObj:VsdObjCurr:CliCode)
      936                   no-error.
      937             if not available buf2_ext-classif
      938             then do :
      939               vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsErrCheck .
      940               vsdsTHObj:VsdObjCurr:MsgErr = "Контрагент-поставщик не синхронизирован с ФГИС Меркурий." .
      941               do transaction :
      942                 vsdStorage:updateDB(vsdsTHObj:VsdObjCurr) .
      943               end.
      944               run write-to-log( "UUID ВСД: " + vsdsTHObj:VsdObjCurr:UUID + " .   Контрагент-поставщик не синхронизирован с ФГИС Меркурий. Запрос не отправлен." ) .
      945               next vsds_.
      946             end.
      947             else do :
      948               if num-entries(buf2_ext-classif.charKey_Two, chr(6)) = 2
      949               then do :
      950                 if entry(1, buf2_ext-classif.charKey_Two, chr(6)) = ""
      951                 or entry(2, buf2_ext-classif.charKey_Two, chr(6)) = ""
      952                 then do :
      953                   if vsdsTHObj:VsdObjCurr:CliType = 'маг'
      954                   then do :
      955                     if entry(2, buf2_ext-classif.charKey_Two, chr(6)) = ""
      956                     then do :
      957                       vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsErrCheck .
      958                       vsdsTHObj:VsdObjCurr:MsgErr = "Не заполнен GUID предприятия поставщика." .
      959                       do transaction :
      960                         vsdStorage:updateDB(vsdsTHObj:VsdObjCurr) .
      961                       end.
      962                       run write-to-log( "UUID ВСД: " + vsdsTHObj:VsdObjCurr:UUID + " .   Не заполнены GUID предприятия поставщика. Запрос не отправлен." ) .
      963                       next vsds_.
      964                     end.
      965                   end.
      966                   else do :
      967                     vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsErrCheck .
      968                     vsdsTHObj:VsdObjCurr:MsgErr = "Не заполнены GUID'ы хоз. субъекта поставщика и/или предприятия поставщика." .
      969                     do transaction :
      970                       vsdStorage:updateDB(vsdsTHObj:VsdObjCurr) .
      971                     end.
      972                     run write-to-log( "UUID ВСД: " + vsdsTHObj:VsdObjCurr:UUID + " .   Не заполнены GUID'ы хоз. субъекта поставщика и/или предприятия поставщика. Запрос не отправлен." ) .
      973                     next vsds_.
      974                   end.
      975                 end .
      976               end.
      977               else do :
      978                 vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsErrCheck .
      979                 vsdsTHObj:VsdObjCurr:MsgErr = "Не верный формат связки поставщика с ФГИС Меркурий" .
      980                 vsdStorage:updateDB(vsdsTHObj:VsdObjCurr) .
      981                 run write-to-log( "UUID ВСД: " + vsdsTHObj:VsdObjCurr:UUID + " .   Не верный формат связки поставщика с ФГИС Меркурий. Запрос не отправлен." ) .
      982                 next vsds_.
      983               end.
      984             end.
      985             find first buf_esys-all-attr no-lock where buf_esys-all-attr.table-name = "esys-pck-sent"
      986                                                   and buf_esys-all-attr.attr-code = "mercury"
      987                                                   and buf_esys-all-attr.attr-value = vsdsTHObj:VsdObjCurr:UUID
      988                                                   and buf_esys-all-attr.key1 = vsdsTHObj:VsdObjCurr:ID
      989                                                   and buf_esys-all-attr.key2 = 1
      990                                                   and buf_esys-all-attr.key3 = "Запрос отправлен"
      991                                                   no-error .
      992             if available buf_esys-all-attr then next vsds_ .
      993             run write-to-log( "Отправка запроса на получение ВСД по UUID " + vsdsTHObj:VsdObjCurr:UUID ) .
      994             mercury:GetVetDocumentByUuid(LC(vsdsTHObj:VsdObjCurr:UUID), entry(2, buf_ext-classif.charKey_Two, chr(6)), v-appId, v-status_, v-Msg) .
      995             if v-status_ <> "ACCEPTED"
      996             then do :
      997               v-Msg = trim(trim(v-Msg, chr(10))) .
      998               if v-Msg = "" then v-Msg = "Нет связи со шлюзом Ветис.Api..." .
      999               run write-to-log( v-Msg ) .
     1000               next  vsds_.
     1001             end .
     1002             do transaction :
     1003               create buf_esys-all-attr .
     1004               assign
     1005                 buf_esys-all-attr.table-name = "esys-pck-sent"
     1006                 buf_esys-all-attr.attr-code = "mercury"
     1007                 buf_esys-all-attr.key3 = "Запрос отправлен"
     1008                 buf_esys-all-attr.key4 = string(now)
     1009                 buf_esys-all-attr.key7 = v-appId
     1010                 buf_esys-all-attr.key2 = 1
     1011                 buf_esys-all-attr.key8 = g#auto-user-id
     1012               .
     1013               buf_esys-all-attr.key1 = vsdsTHObj:VsdObjCurr:ID .
     1014               buf_esys-all-attr.attr-value = LC(vsdsTHObj:VsdObjCurr:UUID) .
     1015             end.
     1016           end.
     1017           if vsdsTHObj:VsdObjCurr:Status_ = vsdStsType:IsNeedUtilized
     1018           then do :
     1019             if vsdsTHObj:VsdObjCurr:UUID = "" or vsdsTHObj:VsdObjCurr:UUID = ? or vsdsTHObj:VsdObjCurr:FactDatetime = ? then next .
     1020             find first buf_esys-all-attr no-lock where buf_esys-all-attr.table-name = "esys-pck-sent"
     1021                                                   and buf_esys-all-attr.attr-code = "mercury"
     1022                                                   and buf_esys-all-attr.attr-value = vsdsTHObj:VsdObjCurr:UUID
     1023                                                   and buf_esys-all-attr.key1 = vsdsTHObj:VsdObjCurr:ID
     1024                                                   and buf_esys-all-attr.key2 = 2
     1025                                                   and buf_esys-all-attr.key3 = "Запрос отправлен"
     1026                                                   no-error .
     1027             if available buf_esys-all-attr then next  vsds_.
     1028             objKeyRec = new keyrec () .
     1029             objKeyRec:GenRowKeyr(vsdsTHObj:VsdObjCurr:PartKey, ?, "ub", ?, ?, v-part-rowid, v-tbl-name) .
     1030             delete object objKeyRec no-error .
     1031             find first buf_parts no-lock where rowid (buf_parts) = v-part-rowid no-error.
     1032             if not available  buf_parts
     1033             then do :
     1034               run write-to-log( "ВСД с UUID " + vsdsTHObj:VsdObjCurr:UUID + " не привязана к партии!!!") .
     1035               next vsds_.
     1036             end.
     1037             run write-to-log( "Отправка запроса на гашение ВСД с UUID " + vsdsTHObj:VsdObjCurr:UUID ) .
     1038             mercury:processIncomingConsignment(vsdsTHObj, buf_parts.qnty, buf_parts.fact-qnty, v-appId, v-status_, v-Msg) .
     1039             if v-status_ <> "ACCEPTED"
     1040             then do :
     1041               v-Msg = trim(trim(v-Msg, chr(10))) .
     1042               if v-Msg = "" then v-Msg = "Нет связи со шлюзом Ветис.Api..." .
     1043               run write-to-log( v-Msg ) .
     1044               next vsds_ .
     1045             end .
     1046             do transaction :
     1047               create buf_esys-all-attr .
     1048               assign
     1049                 buf_esys-all-attr.table-name = "esys-pck-sent"
     1050                 buf_esys-all-attr.attr-code = "mercury"
     1051                 buf_esys-all-attr.key3 = "Запрос отправлен"
     1052                 buf_esys-all-attr.key4 = string(now)
     1053                 buf_esys-all-attr.key7 = v-appId
     1054                 buf_esys-all-attr.key2 = 2
     1055                 buf_esys-all-attr.key8 = g#auto-user-id
     1056               .
     1057               buf_esys-all-attr.key1 = vsdsTHObj:VsdObjCurr:ID .
     1058               buf_esys-all-attr.attr-value = LC(vsdsTHObj:VsdObjCurr:UUID) .
     1059             end.
     1060           end.
     1061         end.
     1062         delete object vsdsTHObj .
     1063         delete object vsdStorage .
     1064         delete object mercury no-error .
     1065       end.
     1066       run write-to-log( "Закончена работа с БД " + string(v-db-num) ) .
     1067       pause 0.2 .
     1068     end.
     1069     delete object objThObj no-error .
     1070     delete object vsdStsType no-error .
     1071   end.
