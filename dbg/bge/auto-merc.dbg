        1   block-level on error undo, throw.
        2   using Progress.Lang.*.
        3   using ibs.th.str.gds.*.
        4   using ibs.th.str.mercury.*.
        5   using ibs.th.gbl.*.
        6   using ibs.th.gbl.storage.*.
        7   using ibs.th.str.clients.*.
        8   using ibs.th.bge.mercury.*.
        9   define input  parameter p-user-login    as character no-undo .
       10   define input  parameter p-user-password as character no-undo .
       11   define input  parameter p-list-db       as character no-undo .
       12   def var vss-revision    as character no-undo init "$Revision: d6a01d2b837a, 2559, rls $":U .
       13   def var vss-author      as character no-undo init "$Author: SSlivenko $":U .
       14   def var vss-date        as character no-undo init "$Date: Вт авг 11 18:31:46 2020 +0300 $":U .
       15   def var vss-workfile    as character no-undo init "$Workfile: auto-merc.p $":U .
       16   def var vss-archive     as character no-undo init "$Archive: bge/auto-merc.p $":U .
       17   def var vss-description as character no-undo init "Работа с ФГИС меркурий".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   define  shared variable g#auto-pid           as integer   no-undo .
       89   define  shared variable conn-par             as character no-undo .
       90   define  shared variable g#auto-user-id       as character no-undo .
       91   define  shared variable g#auto-user-login    as character no-undo .
       92   define  shared variable g#auto-user-password as character no-undo .
       93   define  shared variable v-socket             as logical   no-undo .
       94   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       95   define  shared variable auto-window-h     as handle    no-undo .
       96   define  shared variable auto-log-msg-h    as handle    no-undo .
       97   define  shared variable hand-log-msg-h    as handle    no-undo .
       98   define  shared variable log-file-name     as character no-undo initial ? .
       99   define  shared variable add-log-file-name as character no-undo initial ? .
      100   define  shared variable writelogvalue     as character no-undo initial ? .
      101   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      102   procedure cur-time :
      103      define output parameter p-today as date      no-undo .
      104      define output parameter p-time  as integer   no-undo .
      105     do
      106     on error undo, return error
      107     :
      108       define variable v-date1 as date      no-undo .
      109       define variable v-date2 as date      no-undo .
      110       define variable v-time  as integer   no-undo .
      111       assign
      112         v-date1 = today
      113         v-time  = time
      114         v-date2 = today
      115       .
      116       if v-date1 <> v-date2
      117       then do:
      118         assign
      119           v-date1 = today
      120           v-time  = v-time
      121         .
      122       end.
      123       assign
      124         p-today = v-date1
      125         p-time  = v-time
      126       .
      127     end.
      128   end.
      129   function cur-time-date returns character
      130   :
      131     return string(today, '99/99/9999':U) .
      132   end.
      133   function cur-time-mjd returns decimal
      134   :
      135     define variable v-date as date      no-undo .
      136     define variable v-time as integer   no-undo .
      137     run cur-time in this-procedure
      138       (output v-date
      139       ,output v-time
      140       ) .
      141     return integer(v-date) - 2400002 + (v-time / 86400) .
      142   end.
      143   function cur-time-get-ending-index returns integer
      144   (input p-number as integer
      145   )
      146   :
      147     if p-number < 0
      148     or p-number = ?
      149     then do:
      150       return 1 .
      151     end.
      152     define variable v-rest as integer   no-undo .
      153     assign
      154       p-number = p-number modulo 100
      155     .
      156     if p-number < 20
      157     then do:
      158       assign
      159         v-rest = p-number
      160       .
      161     end.
      162     else do:
      163       assign
      164         v-rest = p-number modulo 10
      165       .
      166     end.
      167     case v-rest :
      168       when 1
      169       then do:
      170         return 2 .
      171       end.
      172       when 2 or
      173       when 3 or
      174       when 4
      175       then do:
      176         return 3 .
      177       end.
      178       otherwise do:
      179         return 1 .
      180       end.
      181     end case .
      182   end.
      183   procedure cur-time-mjd-to-date :
      184      define input  parameter i-mjd-diff as decimal no-undo.
      185      define output parameter o-Date     as date    no-undo.
      186      define output parameter o-Time     as integer no-undo.
      187      define variable v-day-number as integer   no-undo .
      188      if    i-mjd-diff < 0
      189         or i-mjd-diff = ?
      190      then do:
      191         return "?" .
      192      end.
      193      assign
      194         v-day-number = truncate(i-mjd-diff,0).
      195         o-Date = date(v-day-number + 2400002).
      196         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      197     .
      198   end.
      199   function cur-time-mjd-to-string returns character
      200   (input p-mjd-diff as decimal
      201   )
      202   :
      203     define variable v-day-number as integer   no-undo .
      204     define variable v-seconds    as integer   no-undo .
      205     define variable v-hour       as integer   no-undo .
      206     define variable v-min        as integer   no-undo .
      207     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      208     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      209     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      210     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      211     if p-mjd-diff < 0
      212     or p-mjd-diff = ?
      213     then do:
      214       return "?" .
      215     end.
      216     assign
      217       v-day-number = integer(truncate(p-mjd-diff,0))
      218       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      219     .
      220     if v-seconds > 86400
      221     then do:
      222       assign
      223         v-seconds = 86400 - 1
      224       .
      225     end.
      226     if v-seconds < 0
      227     then do:
      228       assign
      229         v-seconds = 0
      230       .
      231     end.
      232     assign
      233       v-hour = truncate(v-seconds / 3600, 0)
      234     .
      235     assign
      236       v-seconds = v-seconds modulo 3600
      237     .
      238     assign
      239       v-min = truncate(v-seconds / 60, 0)
      240     .
      241     assign
      242       v-seconds = v-seconds modulo 60
      243     .
      244     return
      245         (if v-day-number <> 0
      246           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      247           else ""
      248         )
      249       + (if v-day-number <> 0 or v-hour <> 0
      250           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      251           else ""
      252         )
      253       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      254           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      255           else ""
      256         )
      257       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      258       .
      259   end.
      260   function cur-time-string returns character
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      269   end.
      270   function cur-time-string-sec returns character
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      279   end.
      280   function cur-time-custom  returns character
      281   (input p-prefix as character
      282   ,input p-date-format as character
      283   ,input p-delimiter as character
      284   ,input p-time-format as character
      285   ,input p-suffix as character
      286   )
      287   :
      288     define variable v-date as date      no-undo .
      289     define variable v-time as integer   no-undo .
      290     run cur-time in this-procedure
      291       (output v-date
      292       ,output v-time
      293       ) .
      294     return
      295       p-prefix
      296       + string(v-date, p-date-format)
      297       + p-delimiter
      298       + string(v-time, p-time-format)
      299       + p-suffix
      300       .
      301   end.
      302   function cur-time-print  returns character
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      311   end.
      312   function cur-time-datetime returns datetime
      313   :
      314     define variable v-char as character no-undo .
      315     define variable v-datetime as datetime no-undo .
      316     v-char = cur-time-string().
      317     v-datetime = datetime(v-char).
      318     return  v-datetime.
      319   end.
      320   function cur-time-string-msec returns character
      321   :
      322     define variable v-date as datetime  no-undo .
      323     v-date = now.
      324     return string(v-date) .
      325   end.
      326   define stream LogStream .
      327   define variable mNoTime as logical no-undo.
      328   procedure write-to-log-notime :
      329     define input param i-str as character no-undo .
      330     mNoTime = yes.
      331     run write-to-log (i-str).
      332     mNoTime = no.
      333   end.
      334   procedure write-to-log :
      335     define input param p-str as character no-undo .
      336     do
      337     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      338     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      339     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      340     :
      341       define variable log-res        as logical   no-undo .
      342       define variable v-jj           as integer   no-undo .
      343       if    mNoTime
      344          or writelogvalue eq "AsyncProc"
      345       then
      346          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      347       else
      348          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      349       if auto-log-msg-h <> ? then do:
      350         log-res = auto-log-msg-h:move-to-eof( ) .
      351         log-res = auto-log-msg-h:insert-string( p-str ).
      352       end.
      353       if hand-log-msg-h <> ? then do:
      354         log-res = hand-log-msg-h:move-to-eof( ) .
      355         log-res = hand-log-msg-h:insert-string( p-str ).
      356       end.
      357       assign
      358         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      359         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      360         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      361       .
      362       if add-log-file-name <> ? then do:
      363         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      364           run gbl/fileapnd.p
      365             ( input entry(v-jj, add-log-file-name, chr(1) )
      366             ,input p-str
      367             ,input 20
      368             ) no-error .
      369           if error-status:error then do:
      370             return error return-value .
      371           end.
      372         end.
      373       end.
      374       if writelogvalue eq "AsyncProc"
      375       then do:
      376          p-str = trim(p-str, (chr(13) + chr(10)) )
      377       .
      378          Publish "WriteLogAsunc" (p-str,yes).
      379       end.
      380       else if writelogvalue <> "yes" then do:
      381         run gbl/fileapnd.p
      382           ( input log-file-name
      383           ,input p-str
      384           ,input 20
      385           ) no-error .
      386         if error-status:error then do:
      387           return error return-value .
      388         end.
      389       end.
      390     end.
      391   end procedure.
      392   procedure write-to-screen :
      393     define input param p-str as character no-undo .
      394     do
      395     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      396     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      397     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      398     :
      399       define variable log-res as logical no-undo.
      400       assign
      401         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      402       .
      403       if auto-log-msg-h <> ?
      404       then do:
      405         log-res = auto-log-msg-h:move-to-eof( ) .
      406         log-res = auto-log-msg-h:insert-string( p-str ).
      407       end.
      408       if hand-log-msg-h <> ?
      409       then do:
      410         log-res = hand-log-msg-h:move-to-eof( ) .
      411         log-res = hand-log-msg-h:insert-string( p-str ).
      412       end.
      413     end.
      414   end procedure.
      415   procedure send-msg-to-email :
      416     define input  parameter p-subject      as character no-undo .
      417     define input  parameter p-text-err     as character no-undo .
      418     define input  parameter p-attach-files as character no-undo .
      419     do
      420     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      421     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      422     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      423     :
      424       define variable v-tth             as handle    no-undo .
      425       define variable v-value-character as character no-undo .
      426       define variable v-value-date      as date      no-undo .
      427       define variable v-value-decimal   as decimal   no-undo .
      428       define variable v-value-integer   as integer   no-undo .
      429       define variable v-value-logical   as logical   no-undo .
      430       define variable v-param-type      as character no-undo .
      431       define variable v-email       as character no-undo .
      432       define variable v-tmp-str     as character no-undo .
      433       define variable v-tmp1-str    as character no-undo .
      434       define variable v-ind         as integer   no-undo .
      435       define variable v-num-entries as integer   no-undo .
      436       delete object v-tth no-error.
      437       run adm/shattri.p
      438         ( input "get":U
      439          ,input  "":U
      440          ,input  0
      441          ,input  'auto-task':U
      442          ,input  'send-msg-to-email':U
      443          ,output v-value-character
      444          ,output v-value-date
      445          ,output v-value-decimal
      446          ,output v-value-integer
      447          ,output v-value-logical
      448          ,output v-param-type
      449          ,input-output table-handle v-tth
      450         ) no-error .
      451       if not error-status :error  then do:
      452         assign
      453           v-tmp-str = v-value-character
      454         .
      455       end.
      456       delete object v-tth no-error.
      457       assign
      458         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      459         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      460         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      461         v-num-entries = num-entries( v-tmp-str, chr(44) )
      462         v-email       = "":U
      463       .
      464       do v-ind = 1 to v-num-entries
      465       :
      466         assign
      467           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      468         .
      469         if trim( v-tmp1-str ) <> "":U then do:
      470           if v-email = "":U then do:
      471             assign
      472               v-email = v-tmp1-str
      473             .
      474           end.
      475           else do:
      476             assign
      477               v-email = v-email + chr(44) + v-tmp1-str
      478             .
      479           end.
      480         end.
      481       end.
      482       if v-email <> "":U then do:
      483         run gbl/sendmail.p
      484           ( input v-email
      485           , input p-subject
      486           , input p-text-err
      487           , input p-attach-files
      488           ) no-error .
      489         if error-status :error
      490           or return-value <> "":U
      491         then do:
      492           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      493         end.
      494       end.
      495     end.
      496   end procedure.
      497   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      498   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      499   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
