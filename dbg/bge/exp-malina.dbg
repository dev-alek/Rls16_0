     1070        SIZE 3 BY .88.
     1071   DEFINE BUTTON b-obj
     1072        IMAGE-UP FILE "btn-down-arrow":U
     1073        IMAGE-DOWN FILE "btn-down-arrow":U
     1074        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1075        LABEL ""
     1076        SIZE 3 BY .88.
     1077   DEFINE BUTTON b-save
     1078        LABEL "Сохранить"
     1079        SIZE 15 BY 1.13.
     1080   DEFINE BUTTON b-start
     1081        LABEL "Запустить"
     1082        SIZE 15 BY 1.13.
     1083   DEFINE VARIABLE e-obj AS CHARACTER
     1084        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1085        SIZE 42.5 BY 4.71 NO-UNDO.
