     1129        SIZE 11.13 BY .83 NO-UNDO.
     1130   DEFINE VARIABLE v-goods AS LOGICAL INITIAL yes
     1131        LABEL "Товарный классификатор"
     1132        VIEW-AS TOGGLE-BOX
     1133        SIZE 25 BY .83 NO-UNDO.
     1134   DEFINE FRAME gDialog
     1135        b-start AT ROW 1.25 COL 2 WIDGET-ID 8
     1136        b-save AT ROW 1.25 COL 38
     1137        b-close AT ROW 1.25 COL 54.5
     1138        v-company AT ROW 3.25 COL 25 COLON-ALIGNED WIDGET-ID 10
     1139        v-goods AT ROW 3.25 COL 44 WIDGET-ID 28
     1140        v-chk AT ROW 4.42 COL 44 WIDGET-ID 30
     1141        v-category AT ROW 4.5 COL 25 COLON-ALIGNED WIDGET-ID 38
     1142        t-location AT ROW 5.5 COL 44 WIDGET-ID 46
     1143        v-category-2 AT ROW 5.75 COL 25 COLON-ALIGNED WIDGET-ID 48
     1144        v-diapmin AT ROW 7.25 COL 25 COLON-ALIGNED WIDGET-ID 40
     1145        v-diapmax AT ROW 7.25 COL 33.5 COLON-ALIGNED NO-LABEL WIDGET-ID 42
     1146        v-directory AT ROW 8.5 COL 25 COLON-ALIGNED WIDGET-ID 12
     1147        b-dir AT ROW 8.5 COL 67 WIDGET-ID 22
     1148        v-prefix AT ROW 9.75 COL 25 COLON-ALIGNED WIDGET-ID 6
     1149        rs-obj AT ROW 12.5 COL 2 NO-LABEL WIDGET-ID 34
     1150        b-obj AT ROW 12.5 COL 19.5 WIDGET-ID 24
     1151        e-obj AT ROW 12.5 COL 27 NO-LABEL WIDGET-ID 32
     1152        "-" VIEW-AS TEXT
     1153             SIZE 1.5 BY .67 AT ROW 7.5 COL 33.25 WIDGET-ID 44
     1154        RECT-2 AT ROW 3 COL 43 WIDGET-ID 14
     1155        SPACE(0.87) SKIP(11.24)
     1156       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1157            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1158            TITLE "Выгрузка информации в систему ~"Малина~""
     1159            DEFAULT-BUTTON b-save CANCEL-BUTTON b-close WIDGET-ID 100.
     1160   ASSIGN
     1161          FRAME gDialog:SCROLLABLE       = FALSE
     1162          FRAME gDialog:HIDDEN           = TRUE.
     1163   ASSIGN
     1164          e-obj:READ-ONLY IN FRAME gDialog        = TRUE.
     1165   ON WINDOW-CLOSE OF FRAME gDialog
     1166   DO:
     1167     APPLY "END-ERROR":U TO SELF.
     1168   END.
     1169   ON CHOOSE OF b-dir IN FRAME gDialog
     1170   DO:
     1171     system-dialog get-dir c-dir.
     1172     v-directory:screen-value in frame gDialog = c-dir.
     1173   END.
     1174   ON CHOOSE OF b-obj IN FRAME gDialog
     1175   DO:
     1176       define variable v-exclude-obj-list as character no-undo.
     1177       define variable v-user-select as logical no-undo.
     1178       define variable v-object-available as logical no-undo.
     1179       rs-obj:screen-value = "2".
     1180   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1181   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
     1182     (input  v-cntxt-db-num
     1183     ,input  0
     1184     ,input  v-cntxt-userid
     1185     ,input  v-cntxt-obj-type
     1186     ,input  v-cntxt-obj-code
     1187     ,output v-object-available
     1188     ) no-error .
     1189       if error-status :error then do:
     1190           message vss-workfile vss-revision vss-description skip
     1191           "Ошибка при вызове процедуры gbl/usobjava.i" skip
     1192           error-status :get-message(1) skip
     1193           return-value skip
     1194           view-as alert-box error.
     1195           undo, return no-apply.
     1196       end.
     1197       if v-object-available = true then do:
     1198   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1199   run userobjs_append in this-procedure
     1200     (input  v-cntxt-obj-type
     1201     ,input  v-cntxt-obj-code
     1202     )  .
     1203       end.
     1204   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1205   run userobjs_select-many in this-procedure
     1206     (input  parparentproc
     1207     ,input  v-cntxt-db-num
     1208     ,input  v-cntxt-userid
     1209     ,input  v-cntxt-host-code-obj
     1210     ,input  v-cntxt-obj-type
     1211     ,input  v-cntxt-obj-code
     1212     ,output v-user-select
     1213     )  .
     1214       if v-user-select <> true then do:
     1215         message "Объект не выбран" view-as alert-box information.
     1216         return no-apply.
     1217       end.
     1218       v-obj-list = "".
     1219       e-obj:screen-value = "".
     1220       for each userobjs_temp-user-obj:
     1221           v-obj-list = v-obj-list + userobjs_temp-user-obj.obj-type + chr(44) +
     1222               string(userobjs_temp-user-obj.obj-code) + chr(4).
     1223               find first buf_clients where buf_clients.obj-code = userobjs_temp-user-obj.obj-code
     1224                   and buf_clients.obj-type = userobjs_temp-user-obj.obj-type no-lock no-error.
     1225               e-obj:screen-value = e-obj:screen-value +
     1226                   (if buf_clients.obj-name <> '' then buf_clients.obj-name
     1227                   else userobjs_temp-user-obj.obj-type + string(userobjs_temp-user-obj.obj-code))
     1228                   + "," + chr(13).
     1229       end.
     1230   END.
     1231   ON CHOOSE OF b-save IN FRAME gDialog
     1232   DO:
     1233       DEFINE VARIABLE l-dircrt AS LOGICAL.
     1234       ASSIGN
     1235           v-company
     1236           v-category
     1237           v-category-2
     1238           v-diapmin
     1239           v-diapmax
     1240           v-directory
     1241           v-prefix
     1242           v-goods
     1243           v-chk
     1244           rs-obj
     1245           t-location.
     1246       v-directory = right-trim(v-directory,'/\') + '\'.
     1247       file-info:file-name = v-directory.
     1248       if file-info:file-type = ? then do:
     1249           message substitute("Директории &1 не существует.",v-directory) skip
     1250           "Создать?" view-as alert-box warning buttons yes-no update l-dircrt.
     1251           if l-dircrt then do:
     1252               os-create-dir value(v-directory).
     1253               if os-error <> 0 then do:
     1254                   message substitute("Невозможно создать директорию &1",v-directory) view-as alert-box error.
     1255                   leave.
     1256               end.
     1257           end.
     1258           else leave.
     1259       end.
     1260       else do:
     1261           if not (file-info:file-type begins "D":U) then do:
     1262               message substitute("&1 не является директорией.",v-directory) view-as alert-box error.
     1263               leave.
     1264           end.
     1265       end.
     1266       if v-diapmin >= v-diapmax then do:
     1267           message "Неверно указаны границы диапазона пакетов" view-as alert-box error.
     1268           leave.
     1269       end.
     1270       v-param-list = string(v-company) + chr(4) +
     1271                      v-directory + chr(4) +
     1272                      v-prefix + chr(4) +
     1273                      string(v-goods:CHECKED) + chr(4) +
     1274                      string(v-chk)  + chr(4) +
     1275                      string(v-category) + chr(4) +
     1276                      string(v-diapmin) + chr(4) +
     1277                      string(v-diapmax) + chr(4) +
     1278                      string(t-location) + chr(4) + string(v-category-2) +
     1279                      chr(4).
     1280       run attach-attr-to-schedule-line in this-procedure ( INPUT v-param-list ).
     1281       run schedule-attr-write in this-procedure (input p-db-num-char,
     1282                                                  input p-task-type,
     1283                                                  input p-task-num,
     1284                                                  input 'schedule-obj-list':U,
     1285                                                  input v-obj-list).
     1286       message "Параметры сохранены!" view-as alert-box information.
     1287       apply "go".
     1288   END.
     1289   ON CHOOSE OF b-start IN FRAME gDialog
     1290   DO:
     1291     DEFINE VARIABLE l-dircrt AS LOGICAL NO-UNDO.
     1292     define variable h-par as widget-handle  no-undo.
     1293     DEFINE variable loghandle AS HANDLE no-undo.
     1294     DEFINE VARIABLE v-objects AS CHARACTER NO-UNDO.
     1295     ASSIGN
     1296       v-company
     1297       v-directory
     1298       v-prefix
     1299       v-category
     1300       v-category-2
     1301       v-diapmin
     1302       v-diapmax
     1303       .
     1304     v-directory = RIGHT-TRIM(v-directory,'/\') + '\'.
     1305     FILE-INFO:FILE-NAME = v-directory.
     1306     IF FILE-INFO:FILE-TYPE = ? THEN DO:
     1307       MESSAGE SUBSTITUTE("Директории &1 не существует.",v-directory) SKIP
     1308           "Создать?" VIEW-AS ALERT-BOX WARNING BUTTONS YES-NO UPDATE l-dircrt.
     1309           IF l-dircrt THEN DO:
     1310               OS-CREATE-DIR VALUE(v-directory).
     1311               IF OS-ERROR <> 0 THEN DO:
     1312                   MESSAGE SUBSTITUTE("Невозможно создать директорию &1",v-directory) VIEW-AS ALERT-BOX ERROR.
     1313                   LEAVE.
     1314               END.
     1315           END.
     1316           ELSE LEAVE.
     1317       END.
     1318       ELSE DO:
     1319           IF NOT (FILE-INFO:FILE-TYPE BEGINS "D":U) THEN DO:
     1320               MESSAGE SUBSTITUTE("&1 не является директорией.",v-directory) VIEW-AS ALERT-BOX ERROR.
     1321               LEAVE.
     1322           END.
     1323       END.
     1324       if rs-obj = 1 then do:
     1325           for each buf_clients no-lock where buf_clients.host-code = v-cntxt-host-code-obj:
     1326               if buf_clients.stts <> 0 then next.
     1327               create userobjs_temp-user-obj.
     1328               assign
     1329                   userobjs_temp-user-obj.obj-code = buf_clients.obj-code
     1330                   userobjs_temp-user-obj.obj-type = buf_clients.obj-type.
     1331           end.
     1332       end.
     1333       if v-diapmin >= v-diapmax then do:
     1334           message "Неверно указаны границы диапазона пакетов" view-as alert-box error.
     1335           leave.
     1336       end.
     1337       run bge\exp-malinap.p ( table userobjs_temp-user-obj,
     1338                               v-company,
     1339                               v-directory,
     1340                               v-prefix,
     1341                               v-goods:CHECKED,
     1342                               v-chk:CHECKED,
     1343                               v-category,
     1344                               v-diapmin,
     1345                               v-diapmax,
     1346                               this-procedure:handle,
     1347                               t-location:CHECKED,
     1348                               v-category-2
     1349                          ) .
     1350       apply "go".
     1351   END.
     1352   ON VALUE-CHANGED OF rs-obj IN FRAME gDialog
     1353   DO:
     1354       case rs-obj :screen-value in frame gDialog:
     1355           when "1" then do:
     1356               e-obj:screen-value = v-host-name.
     1357               hide b-obj in frame gDialog.
     1358               for each userobjs_temp-user-obj:
     1359                   delete userobjs_temp-user-obj.
     1360               end.
     1361               v-obj-list = 'орг':U + chr(44) + string(v-cntxt-host-code-obj).
     1362           end.
     1363           when "2" then do:
     1364               display b-obj with frame gDialog.
     1365               create userobjs_temp-user-obj.
     1366               assign
     1367               userobjs_temp-user-obj.obj-code = v-cntxt-obj-code
     1368               userobjs_temp-user-obj.obj-type = v-cntxt-obj-type.
     1369               v-obj-list = userobjs_temp-user-obj.obj-type + chr(44) + string(userobjs_temp-user-obj.obj-code) + chr(4).
     1370               find first buf_clients where buf_clients.obj-type = userobjs_temp-user-obj.obj-type
     1371                                        and buf_clients.obj-code = userobjs_temp-user-obj.obj-code no-lock no-error.
     1372               e-obj:screen-value in frame gDialog = if buf_clients.obj-name <> '' then buf_clients.obj-name
     1373                                                     else userobjs_temp-user-obj.obj-type + string(userobjs_temp-user-obj.obj-code).
     1374           end.
     1375       end case.
     1376   END.
     1377   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME gDialog:PARENT eq ?
     1378   THEN FRAME gDialog:PARENT = ACTIVE-WINDOW.
     1379   MAIN-BLOCK:
     1380   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1381      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1382   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1383     run mainmenu_getcntxt in parparentproc
     1384       (output v-cntxt-db-num
     1385       ,output v-cntxt-userid
     1386       ,output v-cntxt-level
     1387       ,output v-cntxt-host-code-obj
     1388       ,output v-cntxt-obj-type
     1389       ,output v-cntxt-obj-code
     1390       ,output v-cntxt-db-num-obj
     1391       ,output v-cntxt-is-admin
     1392       ) .
     1393     run get-host-name in this-procedure ( output v-host-name ) no-error .
     1394     if error-status :error
     1395     then do:
     1396         message
     1397           vss-workfile vss-revision vss-description
     1398           skip "Ошибка при определении имени фирмы"
     1399           skip "Код фирмы:" v-cntxt-host-code-obj
     1400           skip "Имя фирмы будет отображаться как '" + 'орг':U + string( v-cntxt-host-code-obj ) + "'"
     1401           skip return-value
     1402           skip trim(error-status :get-message(1))
     1403                trim(error-status :get-message(2))
     1404                trim(error-status :get-message(3))
     1405                trim(error-status :get-message(4))
     1406                trim(error-status :get-message(5))
     1407         view-as alert-box warning.
     1408         assign
     1409             v-host-name = 'орг':U + string(v-cntxt-host-code-obj).
     1410     end.
     1411     RUN enable_UI.
     1412     RUN my-enable.
     1413     WAIT-FOR GO OF FRAME gDialog.
     1414   END.
     1415   RUN disable_UI.
     1416   PROCEDURE adm-create-objects :
     1417   END PROCEDURE.
     1418   PROCEDURE attach-attr-to-schedule-line :
     1419   DEFINE INPUT PARAMETER p-param-list AS CHARACTER NO-UNDO.
     1420     define buffer buf_schedule      for schedule.
     1421     define buffer buf_schedule-attr for schedule-attr.
     1422     define buffer lock-batchprocess for ub.batchprocess.
     1423     run gbl/lock-prc.p
     1424       (input 'schd':U
     1425       ,input 'exp-malina':U
     1426       ,input 0
     1427       ,input 0
     1428       ,input '':U
     1429       ,input ""
     1430       ,input ""
     1431       ,input (
     1432       "Сохранение параметров Малина"
     1433       )
     1434       ,input yes
     1435       ,buffer lock-batchprocess
     1436       ) no-error .
     1437     FIND FIRST buf_schedule-attr NO-LOCK WHERE
     1438       buf_schedule-attr.task-type   = p-task-type
     1439       and buf_schedule-attr.cre-db-num = INTEGER(p-db-num-char)
     1440       and buf_schedule-attr.attr-code = ('schd-free-id':U + chr(4) + 'exp-malina') NO-ERROR.
     1441     IF AVAILABLE  buf_schedule-attr
     1442       AND buf_schedule-attr.task-num <> p-task-num
     1443       AND buf_schedule-attr.task-num <> - 1
     1444       and p-task-num <> - 1
     1445       THEN
     1446     DO:
     1447       MESSAGE
     1448         substitute("Уже есть расписание сохранения параметров Малина для БД &1&2" +
     1449         "номер расписания &3"
     1450         ,buf_schedule-attr.cre-db-num
     1451         ,chr(10)
     1452         ,buf_schedule-attr.task-num)
     1453         VIEW-AS ALERT-BOX ERROR.
     1454       UNDO, RETURN ERROR.
     1455     END.
     1456     find first buf_schedule no-lock
     1457       where buf_schedule.task-type   = p-task-type
     1458       and buf_schedule.cre-db-num  = INTEGER(p-db-num-char)
     1459       and buf_schedule.task-num    = p-task-num
     1460       no-error.
     1461     if not available buf_schedule
     1462       and (  p-task-type   <> 'autofree':U
     1463       or p-db-num-char <> p-db-num-char
     1464       or p-task-num    <> -1 )
     1465       then
     1466     do:
     1467       message
     1468         vss-workfile vss-revision vss-description
     1469         skip
     1470         "Не найдена строка расписания."
     1471         skip return-value
     1472         skip trim(error-status :get-message(1))
     1473         trim(error-status :get-message(2))
     1474         trim(error-status :get-message(3))
     1475         view-as alert-box error.
     1476       undo, return error .
     1477     end.
     1478     run schedule-attr-write in this-procedure (
     1479       input INTEGER(p-db-num-char)
     1480       , input p-task-type
     1481       , input p-task-num
     1482       , input 'schedule-param-list':U
     1483       , input p-param-list
     1484       ).
     1485   END PROCEDURE.
     1486   PROCEDURE disable_UI :
     1487     HIDE FRAME gDialog.
     1488   END PROCEDURE.
     1489   PROCEDURE enable_UI :
     1490     DISPLAY v-company v-goods v-chk v-category t-location v-category-2 v-diapmin
     1491             v-diapmax v-directory v-prefix rs-obj e-obj
     1492         WITH FRAME gDialog.
     1493     ENABLE RECT-2 b-start b-save b-close v-company v-goods v-chk v-category
     1494            t-location v-category-2 v-diapmin v-diapmax v-directory b-dir v-prefix
     1495            rs-obj b-obj e-obj
     1496         WITH FRAME gDialog.
     1497     VIEW FRAME gDialog.
     1498   END PROCEDURE.
     1499   PROCEDURE get-host-name :
     1500   do on error undo, return error:
     1501   define output parameter p-host-name as character no-undo.
     1502       find first buf_clients no-lock where buf_clients.obj-type = 'орг':U
     1503                                        and buf_clients.obj-code = v-cntxt-host-code-obj no-error.
     1504       if not available buf_clients then do:
     1505           message vss-workfile vss-revision vss-description skip
     1506             "Не удалось найти текущую фирму" skip
     1507             return-value skip
     1508             trim(error-status :get-message(1))
     1509             trim(error-status :get-message(2))
     1510             trim(error-status :get-message(3))
     1511             trim(error-status :get-message(4))
     1512             trim(error-status :get-message(5))
     1513           view-as alert-box error.
     1514           undo, return error.
     1515       end.
     1516       else do:
     1517           p-host-name = buf_clients.obj-name.
     1518       end.
     1519   END.
     1520   END PROCEDURE.
     1521   PROCEDURE my-enable :
     1522   ASSIGN
     1523       rs-obj:screen-value in frame gDialog = "2"
     1524       v-directory:screen-value in frame gDialog = session:temp-directory.
     1525   case p-mode:
     1526       when "run" then do:
     1527           create userobjs_temp-user-obj.
     1528       assign
     1529           userobjs_temp-user-obj.obj-code = v-cntxt-obj-code
     1530           userobjs_temp-user-obj.obj-type = v-cntxt-obj-type.
     1531       v-obj-list = userobjs_temp-user-obj.obj-type + chr(44) + string(userobjs_temp-user-obj.obj-code) + chr(4).
     1532       find first buf_clients where buf_clients.obj-type = userobjs_temp-user-obj.obj-type
     1533                                and buf_clients.obj-code = userobjs_temp-user-obj.obj-code no-lock no-error.
     1534       e-obj:screen-value in frame gDialog = if buf_clients.obj-name <> '' then buf_clients.obj-name
     1535                                             else userobjs_temp-user-obj.obj-type + string(userobjs_temp-user-obj.obj-code).
     1536           hide b-save in frame gDialog.
     1537       end.
     1538       when "shd" then do:
     1539           hide b-start in frame gDialog.
     1540           run schedule-attr-value in this-procedure (input p-db-num-char,
     1541                                                      input p-task-type,
     1542                                                      input p-task-num,
     1543                                                      input 'schedule-param-list':U,
     1544                                                      output v-param-list,
     1545                                                      output v-param-type).
     1546           if v-param-list <> "" then do:
     1547               ASSIGN
     1548                   v-company = integer(entry(1,v-param-list,chr(4)))
     1549                   v-directory = entry(2,v-param-list,chr(4))
     1550                   v-prefix = entry(3,v-param-list,chr(4))
     1551                   v-goods = logical(entry(4,v-param-list,chr(4)))
     1552                   v-chk = logical(entry(5,v-param-list,chr(4)))
     1553                   v-category = integer(entry(6,v-param-list,chr(4)))
     1554                   v-diapmin = integer(entry(7,v-param-list,chr(4)))
     1555                   v-diapmax = integer(entry(8,v-param-list,chr(4)))
     1556                   t-location = logical(entry(9,v-param-list,chr(4)))
     1557                   v-category-2 = entry(10,v-param-list,chr(4))
     1558                   NO-ERROR.
     1559               DISPLAY v-company WITH FRAME gDialog.
     1560               DISPLAY v-directory WITH FRAME gDialog.
     1561               DISPLAY v-prefix WITH FRAME gDialog.
     1562               DISPLAY v-goods WITH FRAME gDialog.
     1563               DISPLAY v-chk WITH FRAME gDialog.
     1564               DISPLAY v-category WITH FRAME gDialog.
     1565               DISPLAY v-category-2 WITH FRAME gDialog.
     1566               DISPLAY v-diapmin WITH FRAME gDialog.
     1567               DISPLAY v-diapmax
     1568                       t-location
     1569               WITH FRAME gDialog.
     1570           end.
     1571           run schedule-attr-value in this-procedure (input p-db-num-char,
     1572                                                      input p-task-type,
     1573                                                      input p-task-num,
     1574                                                      input 'schedule-obj-list':U,
     1575                                                      output v-obj-list,
     1576                                                      output v-param-type).
     1577           if v-obj-list <> "" then do:
     1578               for each userobjs_temp-user-obj:
     1579                   delete userobjs_temp-user-obj.
     1580               end.
     1581               if v-obj-list begins 'орг':U then do:
     1582                   find first buf_clients where buf_clients.obj-type = entry(1, v-obj-list, chr(44))
     1583                       and buf_clients.obj-code = integer(entry(2, v-obj-list, chr(44))) no-lock no-error.
     1584                   if available(buf_clients) then
     1585                   e-obj:screen-value = if buf_clients.obj-name <> '' then buf_clients.obj-name
     1586                                        else buf_clients.obj-type + string(buf_clients.obj-code).
     1587                   rs-obj = 1.
     1588                   display rs-obj with frame gDialog.
     1589               end.
     1590               else do:
     1591                   e-obj:screen-value = "".
     1592                   do ii = 1 to num-entries(v-obj-list, chr(4)) on error undo, next:
     1593                       v-entry = entry(ii, v-obj-list, chr(4)).
     1594                       find first buf_clients where buf_clients.obj-type = entry(1, v-entry, chr(44))
     1595                           and buf_clients.obj-code = integer(entry(2, v-entry, chr(44))) no-lock no-error.
     1596                        if available buf_clients then do:
     1597                            e-obj:screen-value = e-obj:screen-value +
     1598                            (if buf_clients.obj-name <> '' then buf_clients.obj-name
     1599                            else buf_clients.obj-type + string(buf_clients.obj-code))
     1600                            + "," + chr(13).
     1601                            create userobjs_temp-user-obj.
     1602                            assign
     1603                            userobjs_temp-user-obj.obj-type = buf_clients.obj-type
     1604                            userobjs_temp-user-obj.obj-code = buf_clients.obj-code.
     1605                        end.
     1606                   end.
     1607                   rs-obj = 2.
     1608                   display rs-obj with frame gDialog.
     1609               end.
     1610           end.
     1611       end.
     1612   end case.
     1613   assign
     1614       e-obj
     1615       rs-obj
     1616       v-directory.
     1617   END PROCEDURE.
     1618   PROCEDURE write-log-and-file :
     1619   define input parameter p-tab-position as integer no-undo.
     1620   define input parameter p-file-name as char no-undo.
     1621   define input parameter p-log-level as integer no-undo.
     1622   define input parameter p-log-string as char no-undo.
     1623   output stream StreamLog to value(p-file-name) append.
     1624   put stream StreamLog unformatted chr(10).
     1625   put stream StreamLog unformatted cur-time-string-sec() " " p-log-string.
     1626   output stream StreamLog close.
     1627   END PROCEDURE.
