     1097        SIZE 14 BY 1 NO-UNDO.
     1098   DEFINE VARIABLE v-diapmax AS INTEGER FORMAT "999":U INITIAL 99
     1099        VIEW-AS FILL-IN
     1100        SIZE 5.5 BY 1 NO-UNDO.
     1101   DEFINE VARIABLE v-diapmin AS INTEGER FORMAT "999":U INITIAL 0
     1102        LABEL "Диапазон пакетов"
     1103        VIEW-AS FILL-IN
     1104        SIZE 5.5 BY 1 NO-UNDO.
     1105   DEFINE VARIABLE v-directory AS CHARACTER FORMAT "X(256)":U
