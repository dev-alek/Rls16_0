     1056   define variable v-obj-list as character no-undo.
     1057   define variable v-param-list as character no-undo.
     1058   define variable v-param-type as character no-undo.
     1059   define variable ii as integer no-undo.
     1060   define variable v-entry as character no-undo.
     1061   define stream StreamLog.
     1062   DEFINE BUTTON b-close AUTO-END-KEY
