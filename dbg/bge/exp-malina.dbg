      135   define temp-table userobjs_temp-user-obj no-undo
      136     field obj-type as character
      137     field obj-code as integer
      138     index xpk is primary unique obj-type obj-code
      139     .
      140   procedure userobjs_clear :
      141     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      142     do
      143     on error undo, return error return-value
      144     :
      145       for each buf_userobjs_temp-user-obj
      146       on error undo, return error return-value
      147       :
      148         delete buf_userobjs_temp-user-obj .
      149       end.
      150     end.
      151   end .
      152   procedure userobjs_object-count :
      153     define output parameter p-total-count as integer   no-undo .
      154     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      155     do
      156     on error undo, return error return-value
      157     :
      158       assign
      159         p-total-count = 0
      160       .
      161       for each buf_userobjs_temp-user-obj
      162       on error undo, return error return-value
      163       :
      164         assign
      165           p-total-count = p-total-count + 1
      166         .
      167       end.
      168     end.
      169   end.
      170   procedure userobjs_append :
      171      define input  parameter p-obj-type as character no-undo .
      172      define input  parameter p-obj-code as integer   no-undo .
      173     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      174     do
      175     on error undo, return error return-value
      176     :
      177       find first buf_userobjs_temp-user-obj
      178         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      179           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      180         no-error .
      181       if not available buf_userobjs_temp-user-obj
      182       then do:
      183         create buf_userobjs_temp-user-obj .
      184         assign
      185           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      186           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      187         .
      188       end.
      189     end.
      190   end.
      191   procedure userobjs_object-exist :
      192     define output parameter p-object-exist as logical   no-undo .
      193     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      194     do
      195     on error undo, return error return-value
      196     :
      197       find first buf_userobjs_temp-user-obj
      198         no-error .
      199       if not available buf_userobjs_temp-user-obj
      200       then do:
      201         assign
      202           p-object-exist = false
      203         .
      204       end.
      205       else do:
      206         assign
      207           p-object-exist = true
      208         .
      209       end.
      210     end.
      211   end.
      212   procedure userobjs_transfer :
      213     define input  parameter p-callback-handle as handle no-undo .
      214     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      215     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      216     do
      217     on error undo, return error return-value
      218     :
      219       if valid-handle(p-callback-handle) <> true
      220       then do:
      221         message
      222           vss-workfile vss-revision vss-description skip
      223           "Ошибка задания входных параметров" skip
      224           "Неизвестный указатель на процедуру" skip
      225           view-as alert-box error .
      226         undo, return error return-value .
      227       end.
      228       if p-callback-handle :get-signature("userobjs_append") = ""
      229       then do:
      230         message
      231           vss-workfile vss-revision vss-description skip
      232           "Ошибка задания входных параметров" skip
      233           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      234                     ,p-callback-handle :file-name
      235                     ) skip
      236           view-as alert-box error .
      237         undo, return error return-value .
      238       end.
      239       for each buf_userobjs_temp-user-obj
      240       on error undo, return error return-value
      241       :
      242         run userobjs_append in p-callback-handle
      243           (input  buf_userobjs_temp-user-obj.obj-type
      244           ,input  buf_userobjs_temp-user-obj.obj-code
      245           ) .
      246       end.
      247     end.
      248   end procedure.
      249   procedure userobjs_select-one :
      250      define input  parameter parparentproc     as widget-handle no-undo .
      251      define input  parameter p-db-num          as integer   no-undo .
      252      define input  parameter p-user-id         as character no-undo .
      253      define input  parameter p-host-code-obj   as integer   no-undo .
      254      define input  parameter p-obj-type        as character no-undo .
      255      define input  parameter p-obj-code        as integer   no-undo .
      256      define output parameter p-user-select     as logical   no-undo .
      257      define output parameter p-select-obj-type as character no-undo .
      258      define output parameter p-select-obj-code as character no-undo .
