      305   procedure thobjs :
      306      define input        parameter parparentproc     as widget-handle no-undo .
      307      define input        parameter i-bttns           as character     no-undo .
      308      define input        parameter i-list-mode       as character     no-undo.
      309      define input        parameter i-obj-type        as character     no-undo.
      310      define input        parameter i-db-num          as integer       no-undo.
      311      define input        parameter i-host-code       as integer       no-undo.
