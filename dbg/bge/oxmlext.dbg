     1074                   skip return-value
     1075                   skip trim(error-status :get-message(1))
     1076                        trim(error-status :get-message(2))
     1077                        trim(error-status :get-message(3))
     1078               view-as alert-box error.
     1079               undo, return no-apply.
     1080           end.
     1081           else do:
     1082           end.
     1083           run openbr in this-procedure .
     1084           apply "value-changed" to br-table.
     1085           apply "entry" to br-table.
     1086           if v-focused-row > 1
