     1821     assign
     1822       v-diasize-change-size = false
     1823     .
     1824   end procedure.
     1825   procedure diasize_set-height :
     1826     define input  parameter p-new-height  as decimal   no-undo .
     1827     define input  parameter p-move-resize as logical   no-undo .
     1828     do
     1829     on error undo, return error return-value
     1830     :
     1831       run diasize_change-height in this-procedure
     1832         (input  (p-new-height - frame Dialog-Frame :height)
     1833         ,input  p-move-resize
     1834         ) .
     1835     end.
     1836   end procedure.
     1837   procedure diasize_change-width :
     1838     define input  parameter p-change-value as decimal   no-undo .
     1839     define input  parameter p-move-resize  as logical   no-undo .
     1840     define variable v-field-group-handle   as handle    no-undo .
     1841     define variable v-object-handle        as handle    no-undo .
