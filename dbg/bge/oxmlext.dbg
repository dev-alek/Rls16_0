      997         run change-doc in this-procedure (
      998               input buf_init_ext-system.esys-id
      999             , input buf_init_ext-system.db-num
     1000         ) no-error.
     1001         if error-status :error
     1002         then do:
     1003             message
     1004                       vss-workfile vss-revision vss-description
     1005                 skip "Ошибка изменения параметров внешней подсистемы."
     1006                 skip return-value
     1007                 skip trim(error-status :get-message(1))
     1008                       trim(error-status :get-message(2))
     1009                       trim(error-status :get-message(3))
     1010             view-as alert-box error.
     1011             undo, return no-apply .
     1012         end.
     1013         apply "entry" to br-table.
     1014         apply "value-changed" to br-table.
     1015     end.
     1016     run openbr in this-procedure .
     1017     apply "value-changed" to br-table.
     1018     apply "entry" to br-table.
     1019     br-table :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dialog-Frame.
     1020     reposition br-table to row v-repositioned-row no-error.
     1021   END.
     1022   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1023   DO:
     1024       define variable v-focused-row       as integer  no-undo.
     1025       define variable v-repositioned-row  as integer  no-undo.
     1026       define variable v-can-delete        as logical  no-undo.
     1027   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1028   do:
     1029     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1030       (input  v-cntxt-db-num
     1031       ,input  v-cntxt-userid
     1032       ,input  0
     1033       ,input  'actn_openxml-subsystem_deletion':U
     1034       ,input  'global':U
     1035       ,input  0
     1036       ,input  '':U
     1037       ,input  0
     1038       ,input  0
     1039       ,input  0
     1040       ,input  0
     1041       ,input  yes
     1042       ,output v-can-delete
     1043       )  .
     1044   end.
     1045       if v-can-delete = no
     1046       then do:
     1047           undo, return no-apply.
     1048       end.
     1049       if v-can-delete = yes
     1050       and available buf_init_ext-system
     1051       then do:
     1052           if buf_init_ext-system.esys-status <> 0
     1053           and buf_init_ext-system.esys-type = integer('0':U)
     1054           then do:
     1055               message
     1056                        "Для удаления внешней подсистемы"
     1057                   skip "надо сначала её остановить."
     1058               view-as alert-box error.
     1059               undo, return no-apply.
     1060           end.
     1061           assign
     1062               v-focused-row      = br-table :focused-row in frame Dialog-Frame.
     1063               v-repositioned-row = current-result-row( "br-table" )
     1064           .
     1065           run delete-doc in this-procedure (
     1066                 input buf_init_ext-system.esys-id
     1067               , input buf_init_ext-system.db-num
     1068           ) no-error.
