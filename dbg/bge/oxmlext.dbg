     1643           then do:
     1644             find first buf_temp-browse-handle
     1645               where buf_temp-browse-handle.browse-type   = 'height':u
     1646                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1647               no-error .
     1648             if available buf_temp-browse-handle
     1649             then do:
     1650             end.
     1651             else do:
     1652               create buf_temp-diasize-handle .
     1653               assign
     1654                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1655                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1656               .
     1657             end.
     1658           end.
     1659           assign
     1660             v-object-handle = v-object-handle :next-sibling
     1661           .
     1662         end.
