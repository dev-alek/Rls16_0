      473     run proc-alt-shift-f4 in this-procedure.
      474   end.
      475   on alt-f1 anywhere do:
      476     run proc-alt-f1 in this-procedure .
      477   end.
      478   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      479   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      480   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      481   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      482   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
