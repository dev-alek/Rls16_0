      755       define variable v-oxmlext-status            as character    no-undo.
      756       define variable v-oxmlext-date              as character    no-undo.
      757   define variable v-doc-rec as recid no-undo .
      758   define variable v-last-list-mode            as character no-undo .
      759   define variable v-last-esys-type            as integer   no-undo .
      760   define variable func as character no-undo .
      761   define buffer buf_init_ext-system for ext-system.
      762   FUNCTION get-selected-mark returns logical
      763     ( p-esys-id as integer, p-db-num as integer )  FORWARD.
      764   DEFINE MENU MENU-B-func
