      496   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      497   define variable v-waitfram-action01         as character   no-undo .
      498   define variable v-waitfram-action02         as character   no-undo .
      499   define variable v-waitfram-action03         as character   no-undo .
      500   define variable mWaitFramTextBeg            as character   no-undo.
      501   define variable mWaitFramTextEnd            as character   no-undo.
      502   define variable mWaitFramView               as logical     no-undo.
      503   define variable mWaitProcEvent              as logical     no-undo init yes.
      504   define variable mWaitFramInterval           as integer     no-undo init 1 .
      505   define variable mWaitFramStop               as logical     no-undo.
      506   define variable mWaitFramStopUser           as logical     no-undo.
      507   define variable mWaitFramStopTimeOut        as logical     no-undo.
      508   define variable mWaitFramStartProc          as datetime-tz no-undo.
      509   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      510   define button B-WaitFramStop auto-end-key
      511        label "Стоп"
      512        size 10 by 1 tooltip "Остоновить процесс".
      513   define button B-viewProcInfo
      514        label "Информация"
      515        size 15 by 1 tooltip "Информация о процесс".
      516   define frame waitfram
      517     v-waitfram-action01 format "x(72)" no-label skip
      518     v-waitfram-action02 format "x(72)" no-label skip
      519     v-waitfram-action03 format "x(72)" no-label skip
      520     B-viewProcInfo
      521     B-WaitFramStop at row 4 col 30
      522     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      523     .
      524   define new global shared variable mBatchMode as logical no-undo init ?.
      525   define variable mFramBachModHandle as handle no-undo.
      526   mFramBachModHandle = frame waitfram:handle.
      527   define variable mFameOldVis as logical no-undo.
      528   define variable mVisCUrentVin as logical no-undo.
      529   if session:batch-mode
      530   then
      531      mBatchMode = yes.
      532   if mBatchMode = ? then do:
      533     mVisCUrentVin = current-window:visible.
      534     mFameOldVis = mFramBachModHandle:visible.
      535     mFramBachModHandle:visible  = yes.
      536     mBatchMode = mFramBachModHandle:visible ne yes.
      537     mFramBachModHandle:visible = mFameOldVis.
      538     current-window:visible = mVisCUrentVin.
      539   end.
      540    if  log-manager:logfile-name ne ?
      541     then DO:
      542         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      543         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      544         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      545     end.
      546   on choose of B-WaitFramStop in frame waitfram
      547   do:
      548     mWaitFramStop = yes.
      549     mWaitFramStopUser = yes.
      550   end.
      551   function waitfram-check-timeout returns logical():
      552      define variable vtime as int64 no-undo.
      553      if mWaitFramStopTimeOut
      554      then
      555         return yes.
      556      vtime = ( now - mWaitFramStartProc ) / 1000 .
      557      if     mWaitFramTimeOut ne ?
      558         and mWaitFramTimeOut ne 0
      559         and mWaitFramTimeOut lt vtime
      560      then do:
      561         mWaitFramStopTimeOut = yes.
      562      end.
      563      return mWaitFramStopTimeOut.
      564   end.
      565   procedure waitfram-hide :
      566     if not session:batch-mode
      567     then do
      568     on error undo, return error return-value
      569     :
      570       pause 0 before-hide .
      571       if not mBatchMode then
      572         hide frame waitfram .
      573     if     not mWaitFramView
      574        and mWaitProcEvent
      575     then
      576       process events .
      577     end.
      578   end procedure.
      579   procedure waitfram-show :
      580     define input  parameter p-message as character no-undo .
      581     define variable v-left-margin as integer   no-undo .
      582     if not session:batch-mode
      583     then do
      584     on error undo, return error return-value
      585     :
      586       if length(p-message) <= 70 then do:
      587         assign
      588           v-left-margin = integer((70 - length(p-message)) / 2)
      589         .
      590         assign
      591           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      592         .
      593         assign
      594           v-waitfram-action01 = " "
      595           v-waitfram-action02 = " "
      596                                    + fill(" ", v-left-margin)
      597                                    + p-message
      598           v-waitfram-action03 = " "
      599         .
      600       end.
      601       else do:
      602         define variable vRindex1 as integer no-undo.
      603         define variable vRindex2 as integer no-undo.
      604         vRindex1 = r-index(p-message," ",70).
      605         if vRindex1 = 0
      606         then
      607            vRindex1 = 70.
      608         if length(p-message)  <= vRindex1 + 70 then do:
      609           assign
      610             v-waitfram-action01 = " "
      611             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      612             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      613           .
      614         end.
      615         else do:
      616           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      617           if vRindex2 <= vRindex1
      618           then
      619              vRindex2 = vRindex1 + 70.
      620           assign
      621             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      622             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      623             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      624           .
      625         end.
      626       end.
      627       B-viewProcInfo:visible   in frame waitfram = no.
      628       B-viewProcInfo:sensitive in frame waitfram = no.
      629       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      630       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      631       if  (   mWaitFramView
      632          or  mWaitProcEvent)
      633          and not mBatchMode
      634       then
      635          display
      636             v-waitfram-action01 skip
      637             v-waitfram-action02 skip
      638             v-waitfram-action03 skip
      639          with frame waitfram .
      640       if     mWaitFramView
      641          then do:
      642             if     mWaitFramInterval ne ?
      643                and not mBatchMode
      644             then
      645                wait-for go of frame waitfram pause mWaitFramInterval.
      646          end.
      647          else
      648             if     mWaitProcEvent
      649                and not mBatchMode
      650             then
      651                process events .
      652     end.
      653   end procedure.
      654      procedure waitfram-show-this:
      655         define input  parameter iInterval as int64 no-undo.
      656         define variable vtime as int64 no-undo.
      657         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      658         mWaitFramInterval = iInterval.
      659         run waitfram-show (substitute("&1&2 &3&4" ,
      660                                       mWaitFramTextBeg ,
      661                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      662                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      663                                       mWaitFramTextEnd
      664                                      )
      665                           ).
      666      end.
      667      procedure WaitFramRunPause:
      668         define input  parameter iInterval as dec no-undo.
      669         define variable vStart  as datetime-tz no-undo.
      670         define variable vend    as datetime-tz no-undo.
      671         define variable vint as int64 no-undo.
      672         define variable vOk as logical no-undo.
      673         vStart = now.
      674         vend   = vStart.
      675         publish "WaitFramPause" (iInterval,output vOk).
      676         vend   =  now.
      677         vint = vend - vStart.
      678         vint = iInterval - vint / 1000.
      679         if     not mWaitFramStop
      680            and (   vint > 0
      681                 or (    not vOk
      682                     and iInterval eq ?
      683                     )
      684                 )
      685         then
      686            run waitfram-show-this (iInterval).
      687         vend   =  now.
      688         vint = vend - vStart.
      689         vint = iInterval - vint / 1000.
      690         if     not mWaitFramStop
      691            and vint > 0
      692         then do:
      693            run gbl/pause.p (vint * 1000).
      694         end.
      695         if iInterval ne ?
      696         then
      697            publish "WaitFramStop".
      698         waitfram-check-timeout().
      699      end.
      700      procedure WaitFramWaitFor:
      701         define input  parameter iInterval as dec no-undo.
      702         assign
      703            mWaitFramStartProc   = now
      704            mWaitFramStopUser    = no
      705            mWaitFramStopTimeOut = no
      706         .
      707         block-wait:
      708         do while not mWaitFramStop:
      709            run WaitFramRunPause (iInterval).
      710            if  waitfram-check-timeout()
      711            then do:
      712               leave block-wait.
      713            end.
      714         end.
      715         run waitfram-hide.
      716      end.
      717   procedure waitfram-join :
      718     define input  parameter p-line-1  as character no-undo .
      719     define input  parameter p-line-2  as character no-undo .
      720     define input  parameter p-line-3  as character no-undo .
      721     define output parameter p-message as character no-undo .
      722     do
      723     on error undo, return error return-value
      724     :
      725       assign
      726         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      727                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      728                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      729       .
      730     end.
      731   end procedure.
      732   function waitfram-join-function returns character
      733     (input p-line-1 as character
      734     ,input p-line-2 as character
      735     ,input p-line-3 as character
      736     ).
      737     define variable v-message as character no-undo .
      738     run waitfram-join in this-procedure
      739       (input  p-line-1
      740       ,input  p-line-2
      741       ,input  p-line-3
      742       ,output v-message
      743       ) .
      744     return v-message .
      745   end function .
      746       define temp-table temp_select no-undo
      747           field sel-key   as integer
      748           field esys-id   as integer
      749           field db-num    as integer
      750           field selected  as logical
      751           index pi is primary unique
      752               sel-key
      753       .
