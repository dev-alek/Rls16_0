     1317   on help of frame Dialog-Frame
     1318   do:
     1319     run gbl/app_help.p
     1320       (input this-procedure :file-name
     1321       ,input ''
     1322       ,input ?
     1323       ) no-error.
     1324     if error-status :error then do:
     1325       message
     1326         "Ошибка при вызове помощи"
     1327         error-status :get-message(1)
     1328         view-as alert-box .
     1329     end.
     1330   end.
     1331   run minbtn-set in this-procedure .
     1332   on choose of b-help in frame Dialog-Frame
     1333   do:
     1334     apply "help":u to frame Dialog-Frame .
     1335   end.
     1336   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1337   procedure minbtn-set :
     1338       do
     1339           on error undo, return error return-value
     1340           :
     1341           define variable ii              as integer       no-undo .
     1342           define variable fh              as widget-handle no-undo .
     1343           define variable hh              as widget-handle no-undo .
     1344           define variable v-h             as handle        extent 4 no-undo .
     1345           define variable v-name-button   as character     no-undo .
     1346           define variable v-help-old-x    as decimal       no-undo .
     1347           define variable v-help-old-y    as decimal       no-undo .
     1348           define variable v-help-old-size as decimal       no-undo .
     1349           define variable v-frame-width   as decimal       no-undo .
     1350           define variable jj              as integer       no-undo .
     1351           do
     1352               on error undo, return error
     1353               :
     1354               assign
     1355                   v-frame-width = frame Dialog-Frame:width - 0.3
     1356                   fh            = frame Dialog-Frame:first-child
     1357                   hh            = fh:first-child
     1358                   ii            = 1
     1359                   .
     1360               do while valid-handle(hh):
     1361                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1362                   do:
     1363                       case lc(hh:name) :
     1364                           when "b-help" then
     1365                               do:
     1366                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1367                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1368                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1369                                   hh:TOOLTIP = "Помощь" .
     1370                                   v-help-old-x = hh:column .
     1371                                   v-help-old-y = hh:row    .
     1372                                   v-help-old-size = hh:width .
     1373                                   hh:width-chars = 2.5 .
     1374                               end.
     1375                           when "b-print" then
     1376                               do:
     1377                                   hh:load-image("cmp/b-print.bmp":u) .
     1378                                   hh:TOOLTIP = "Печать" .
     1379                                   v-h[ii] = hh:handle .
     1380                                   ii = ii + 1 .
     1381                                   hh:width-chars = 3 .
     1382                               end.
     1383                           when "b-history" or
     1384                           when "b-hist" then
     1385                               do:
     1386                                   hh:load-image("cmp/b-hist.bmp":u) .
     1387                                   hh:TOOLTIP = "История" .
     1388                                   v-h[ii] = hh:handle .
     1389                                   ii = ii + 1 .
     1390                                   hh:width-chars = 3 .
     1391                               end.
     1392                           when "b-sch" then
     1393                               do:
     1394                                   hh:load-image("cmp/b-sch.bmp":u) .
     1395                                   hh:TOOLTIP = "Установка Фильтра" .
     1396                                   v-h[ii] = hh:handle .
     1397                                   ii = ii + 1 .
     1398                                   hh:width-chars = 3 .
     1399                               end.
     1400                           when "b-hist-user" then
     1401                               do:
     1402                                   hh:load-image("cmp/b-hist.bmp":u) .
     1403                                   hh:TOOLTIP = "История пользователя" .
     1404                                   ii = ii + 1 .
     1405                               end.
     1406                       end case.
     1407                   end.
     1408                   hh = hh:next-sibling.
     1409               end.
     1410               b-help:column = v-frame-width - b-help:width-chars.
     1411               jj = 0.
     1412               repeat ii = 4 to 1 by -1 :
     1413                   if valid-handle (v-h[ii] ) then
     1414                   do:
     1415                       jj  = jj + 1 .
     1416                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1417                       v-h[ii]:row    = v-help-old-y .
     1418                   end.
     1419               end.
     1420           end.
     1421       end.
     1422   end procedure.
     1423   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1424   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1425   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1426   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1427   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1428   define variable v-diasize-current-frame-height as decimal   no-undo .
     1429   define variable v-diasize-change-size          as logical   no-undo .
     1430   define variable v-diasize-resize-button        as handle    no-undo .
     1431   define variable v-diasize-wndmax               as logical   no-undo .
     1432   define variable v-diasize-wndstore             as logical   no-undo .
     1433   define variable v-diasize-proc-name            as character no-undo .
     1434   define variable v-diasize-browse-handle        as handle    no-undo .
     1435   define variable v-diasize-browse-number        as integer   no-undo .
     1436   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1437   define temp-table temp-diasize-handle no-undo
     1438     field handle-value  as handle
     1439     field save-position as decimal
     1440     index xpk is primary unique handle-value
     1441     .
     1442   define temp-table temp-browse-handle no-undo
     1443     field browse-type   as character
     1444     field browse-number as integer
     1445     field browse-handle as handle
     1446     field original-size as decimal
     1447     index xpk is primary unique browse-type browse-number
     1448     index xie browse-type browse-handle
     1449   .
     1450   procedure diasize_change-height :
     1451     define input  parameter p-change-value  as decimal   no-undo .
     1452     define input  parameter p-move-resize   as logical   no-undo .
     1453     define variable v-field-group-handle    as handle    no-undo .
     1454     define variable v-object-handle         as handle    no-undo .
     1455     define variable v-frame-height          as decimal   no-undo .
     1456     define variable v-frame-virtual-height  as decimal   no-undo .
     1457     define variable v-browse-height         as decimal   no-undo .
     1458     define variable v-window-height         as decimal   no-undo .
     1459     define variable v-window-virtual-height as decimal   no-undo .
     1460     define variable v-change-sign           as integer   no-undo .
     1461     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1462     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1463     if p-change-value > 0
     1464     then do:
     1465       if frame Dialog-Frame :height + p-change-value
     1466           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1467       then do:
     1468         assign
     1469           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1470                           - (frame Dialog-Frame :height-chars)
     1471         .
     1472         if p-change-value <= 0
     1473         then do:
     1474           run diasize_position-resize-button in this-procedure .
     1475           return .
     1476         end.
     1477       end.
     1478     end.
     1479     if p-change-value < 0
     1480     then do:
     1481       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1482       then do:
     1483         assign
     1484           p-change-value = v-diasize-orig-frame-height
     1485                          - (frame Dialog-Frame :height-chars)
     1486         .
     1487         if p-change-value >= 0
     1488         then do:
     1489           run diasize_position-resize-button in this-procedure .
     1490           return .
     1491         end.
     1492       end.
     1493     end.
     1494     if p-change-value >= 0
     1495     then do:
     1496       assign
     1497         v-change-sign = 1
     1498       .
     1499     end.
     1500     else do:
     1501       assign
     1502         v-change-sign = -1
     1503       .
     1504     end.
     1505     assign
     1506       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1507     .
     1508     if p-change-value = 0
     1509     then do:
     1510       run diasize_position-resize-button in this-procedure .
     1511       return .
     1512     end.
     1513     move_block:
     1514     do
     1515     on error undo move_block, retry move_block
     1516     :
     1517       if retry
     1518       then do:
     1519         do
     1520         on error undo move_block, leave move_block
     1521         :
     1522           if p-change-value > 0
     1523           then do:
     1524             for each buf_temp-diasize-handle
     1525             on error undo, next
     1526             :
     1527               assign
     1528                 v-object-handle = buf_temp-diasize-handle.handle-value
     1529               .
     1530               if v-object-handle <> v-diasize-resize-button
     1531               then do:
     1532                 assign
     1533                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1534                 .
     1535               end.
     1536             end.
     1537             assign
     1538               v-diasize-browse-handle :height = v-browse-height
     1539             .
     1540             for each buf_temp-browse-handle
     1541               where buf_temp-browse-handle.browse-type = 'height':u
     1542             on error undo, next
     1543             :
     1544               assign
     1545                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1546               .
     1547             end.
     1548             assign
     1549               frame Dialog-Frame :height = v-frame-height
     1550             .
     1551             if frame Dialog-Frame :scrollable = true
     1552             then do:
     1553               assign
     1554                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1555               .
     1556             end.
     1557             run diasize_position-resize-button in this-procedure .
     1558           end.
     1559           else do:
     1560             if frame Dialog-Frame :scrollable = true
     1561             then do:
     1562               assign
     1563                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1564               .
     1565             end.
     1566             assign
     1567               frame Dialog-Frame :height = v-frame-height
     1568             .
     1569             assign
     1570               v-diasize-browse-handle :height = v-browse-height
     1571             .
     1572             for each buf_temp-browse-handle
     1573               where buf_temp-browse-handle.browse-type = 'height':u
     1574             on error undo, next
     1575             :
     1576               assign
     1577                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1578               .
     1579             end.
     1580             for each buf_temp-diasize-handle
     1581             on error undo, next
     1582             :
     1583               assign
     1584                 v-object-handle = buf_temp-diasize-handle.handle-value
     1585               .
     1586               if v-object-handle <> v-diasize-resize-button
     1587               then do:
     1588                 assign
     1589                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1590                 .
     1591               end.
     1592             end.
     1593             run diasize_position-resize-button in this-procedure .
     1594           end.
     1595           assign
     1596             v-diasize-change-size = false
     1597           .
