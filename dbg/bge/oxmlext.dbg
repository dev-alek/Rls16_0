      801   DEFINE VARIABLE filt-combo AS INTEGER FORMAT "->,>>>,>>9" INITIAL 0
      802        LABEL "Тип ВС"
      803        VIEW-AS COMBO-BOX INNER-LINES 10
      804        LIST-ITEM-PAIRS "Item 1",0
