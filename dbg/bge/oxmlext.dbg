      487   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      488   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      489   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      490   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      491   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
