     1605       then do:
     1606         assign
     1607           v-diasize-change-size = true
     1608         .
     1609       end.
     1610       else do:
     1611         return .
     1612       end.
     1613       assign
     1614         v-frame-height = frame Dialog-Frame :height
     1615         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1616         v-browse-height = v-diasize-browse-handle :height
     1617       .
     1618       for each buf_temp-browse-handle
     1619         where buf_temp-browse-handle.browse-type = 'height':u
     1620       :
     1621         assign
     1622           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1623         .
