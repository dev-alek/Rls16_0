      970     v-repositioned-row = current-result-row( "br-table" )
      971     .
      972   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      973   do:
      974     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      975       (input  v-cntxt-db-num
      976       ,input  v-cntxt-userid
      977       ,input  0
      978       ,input  'actn_openxml-subsystem_update':U
      979       ,input  'global':U
      980       ,input  0
      981       ,input  '':U
      982       ,input  0
      983       ,input  0
      984       ,input  0
      985       ,input  0
      986       ,input  yes
      987       ,output v-have-rights
      988       )  .
      989   end.
      990     if v-have-rights = no
