     1845     define variable v-window-width         as decimal   no-undo .
     1846     define variable v-window-virtual-width as decimal   no-undo .
     1847     define variable v-change-sign          as integer   no-undo .
     1848     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1849     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1850     if p-change-value > 0
     1851     then do:
     1852       if frame Dialog-Frame :width + p-change-value >
     1853           session :width-chars
     1854       then do:
     1855         assign
     1856           p-change-value = session :width-chars - frame Dialog-Frame :width
     1857         .
     1858         if p-change-value <= 0
     1859         then do:
     1860           run diasize_position-resize-button in this-procedure .
     1861           return .
     1862         end.
     1863       end.
     1864     end.
     1865     if p-change-value < 0
     1866     then do:
     1867       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1868       then do:
     1869         assign
     1870           p-change-value = v-diasize-orig-frame-width
     1871                          - frame Dialog-Frame :width
     1872         .
     1873         if p-change-value >= 0
     1874         then do:
     1875           run diasize_position-resize-button in this-procedure .
     1876           return .
     1877         end.
     1878       end.
     1879     end.
     1880     if p-change-value >= 0
     1881     then do:
     1882       assign
     1883         v-change-sign = 1
     1884       .
     1885     end.
     1886     else do:
     1887       assign
     1888         v-change-sign = -1
     1889       .
     1890     end.
     1891     assign
     1892       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1893     .
     1894     if p-change-value = 0
     1895     then do:
     1896       run diasize_position-resize-button in this-procedure .
     1897       return .
     1898     end.
     1899     move_block:
     1900     do
     1901     on error undo move_block, leave move_block
     1902     :
     1903       if retry
     1904       then do:
     1905         do
