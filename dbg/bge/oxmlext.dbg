     1672           v-diasize-resize-button :column = 1
     1673         .
     1674       end.
     1675       if p-change-value > 0
     1676       then do:
     1677         if frame Dialog-Frame :scrollable = true
     1678         then do:
     1679           assign
     1680             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1681             no-error .
     1682           if error-status :error
     1683           or error-status :get-message(1) <> ""
     1684           then do:
     1685             undo move_block, retry move_block .
     1686           end.
     1687         end.
     1688         assign
     1689           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1690           no-error .
     1691         if error-status :error
     1692         or error-status :get-message(1) <> ""
     1693         then do:
     1694           undo move_block, retry move_block .
