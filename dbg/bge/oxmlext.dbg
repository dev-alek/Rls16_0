      441       ) .
      442   end.
      443   define variable v-inform-launched as logical no-undo initial false .
      444   procedure proc-alt-shift-f4:
      445     define variable v-action as character no-undo .
      446     if v-inform-launched = false then do:
      447       assign
      448         v-inform-launched = true
      449       .
