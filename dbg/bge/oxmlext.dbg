     2198           run gbl/wndsizew.p
     2199             (input  v-cntxt-db-num
     2200             ,input  v-cntxt-userid
     2201             ,input  v-diasize-proc-name
     2202             ,input  'width':u
     2203             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2204             ) .
