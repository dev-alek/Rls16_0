      870   END.
      871   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      872   DO:
      873       define variable v-have-rights    as logical        no-undo.
      874   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      875   do:
      876     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      877       (input  v-cntxt-db-num
      878       ,input  v-cntxt-userid
      879       ,input  0
      880       ,input  'actn_openxml-subsystem_add-def':U
      881       ,input  'global':U
      882       ,input  0
      883       ,input  '':U
      884       ,input  0
      885       ,input  0
      886       ,input  0
      887       ,input  0
      888       ,input  yes
      889       ,output v-have-rights
      890       )  .
      891   end.
      892       if v-have-rights = yes
      893       then do:
      894         if v-cntxt-db-num = 0 then do:
      895           if not (p-list-mode = "esys-type"
      896                   or
      897                   p-list-mode = "special")
      898           then do:
      899           define variable choice as integer no-undo .
      900           run gbl/d-askw.w (input "Добавление типа ВНЕШНЕЙ СИСТЕМЫ",
      901                             input  "Выбор типа ВНЕШНЕЙ СИСТЕМЫ",
      902                             input "|",
      903                             input "Внешняя система|Специальная|Отменить",
      904                             input "||",
      905                             input 1,
      906                             input 3,
      907                             output choice).
      908           if choice = 3
      909           then do:
      910               return no-apply.
      911           end.
      912         end.
      913         else do:
      914             if p-esys-type = integer('0':U) then choice = 1.
      915             if p-esys-type > integer('0':U) then choice = 2.
      916         end.
      917         end.
      918         else do:
      919           message
      920           "На текущий момент в УБД ВС добавлять запрещено"
      921           view-as alert-box error .
      922           return no-apply.
      923         end.
      924         run add-doc in this-procedure ( input integer((if choice = 1
      925                                                        then '0':U
      926                                                        else '1':U))).
      927         run openbr in this-procedure .
      928         apply "value-changed" to br-table.
      929         apply "entry" to br-table.
      930     end.
      931   END.
      932   ON CHOOSE OF MENU-ITEM m_exp-kontur
      933   DO:
      934     assign
      935     func = "exp-kontur"
      936     .
      937     APPLY "CHOOSE" TO b-func IN FRAME Dialog-Frame.
      938   END.
      939   ON CHOOSE OF b-func IN FRAME Dialog-Frame
      940   DO:
      941     if not available buf_init_ext-system THEN return no-apply.
      942     if func = "":U then do:
      943       run gbl/pop-up.p ( input self :handle, input no ) no-error.
      944       if error-status :error then do: return no-apply. end.
      945     end.
      946     if func = "":U then do:
      947         return no-apply.
      948     end.
      949     if func = "exp-kontur" then do :
      950         if buf_init_ext-system.whole-send-news <> integer('9':U) then do :
      951             message "Данная функция доступна только для ВС с методом доставки " 'Контур.EDI':U view-as alert-box .
      952         end.
      953         else do :
      954             run waitfram-show in this-procedure ( input "Ждите... Идет экспорт информации в систему EDI" ).
      955             run cus/exp-clients_kontur.p (input parparentproc
      956                                          ,buffer buf_init_ext-system
      957                                          ) .
      958             run waitfram-hide in this-procedure .
      959             message "Экспорт завершен" view-as alert-box .
      960         end.
      961     end.
      962   END.
