      825         get-selected-mark ( buf_init_ext-system.esys-id, buf_init_ext-system.db-num ) @ v-oxmlext-selected-mark   format " */  " column-label " * "
      826         buf_init_ext-system.esys-id
      827         ( if buf_init_ext-system.esys-status = -1
      828           then substitute( "новая&1", ( if buf_init_ext-system.esys-type > integer('0':U) then " (сп)" else "" ) )
      829           else ( if buf_init_ext-system.esys-status = 1
      830                  then substitute( "в работе&1", ( if buf_init_ext-system.esys-type > integer('0':U) then " (сп)" else "" ) )
      831                  else substitute( "останов&1", ( if buf_init_ext-system.esys-type > integer('0':U) then " (сп)" else "" ) ) ) ) @ v-oxmlext-status                                                            FORMAT "X(15)"  column-label " Статус "
      832         substring( string( buf_init_ext-system.esys-date-change, "99/99/9999" ), 1, 10 ) @ v-oxmlext-date  FORMAT "X(10)"   COLUMN-LABEL "Дата"
      833         buf_init_ext-system.esys-have-export                                                                      format " +/ -"  column-label "Экс"
      834         buf_init_ext-system.esys-db-num-exp                                                                       format ">>>>9 " column-label "БДэкс"
      835         buf_init_ext-system.esys-have-import                                                                      format " +/ -"  column-label "Имп"
      836         buf_init_ext-system.esys-db-num-imp                                                                       format ">>>>9 " column-label "БДимп"
      837         buf_init_ext-system.esys-name
      838       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16.24.
      839   DEFINE FRAME Dialog-Frame
      840        b-exit AT ROW 1 COL 1
      841        b-sel AT ROW 1 COL 11
      842        b-select AT ROW 1 COL 14
      843        b-help AT ROW 1 COL 95
