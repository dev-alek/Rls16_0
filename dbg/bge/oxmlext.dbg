        1   define input parameter parparentproc    as widget-handle  no-undo.
        2   define input parameter bttns                as character      no-undo.
        3   define input parameter p-list-mode          as character      no-undo.
        4   define input parameter p-db-num-imp         as integer        no-undo.
        5   define input parameter p-db-num-exp         as integer        no-undo.
        6   define input parameter p-status             as character      no-undo.
        7   define input parameter p-esys-type          as integer        no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Список внешних подсистем OpenXML".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   procedure cur-time :
       76      define output parameter p-today as date      no-undo .
       77      define output parameter p-time  as integer   no-undo .
       78     do
       79     on error undo, return error
       80     :
       81       define variable v-date1 as date      no-undo .
       82       define variable v-date2 as date      no-undo .
       83       define variable v-time  as integer   no-undo .
       84       assign
       85         v-date1 = today
       86         v-time  = time
       87         v-date2 = today
       88       .
       89       if v-date1 <> v-date2
       90       then do:
       91         assign
       92           v-date1 = today
       93           v-time  = v-time
       94         .
       95       end.
       96       assign
       97         p-today = v-date1
       98         p-time  = v-time
       99       .
      100     end.
      101   end.
      102   function cur-time-date returns character
      103   :
      104     return string(today, '99/99/9999':U) .
      105   end.
      106   function cur-time-mjd returns decimal
      107   :
      108     define variable v-date as date      no-undo .
      109     define variable v-time as integer   no-undo .
      110     run cur-time in this-procedure
      111       (output v-date
      112       ,output v-time
      113       ) .
      114     return integer(v-date) - 2400002 + (v-time / 86400) .
      115   end.
      116   function cur-time-get-ending-index returns integer
      117   (input p-number as integer
      118   )
      119   :
      120     if p-number < 0
      121     or p-number = ?
      122     then do:
      123       return 1 .
      124     end.
      125     define variable v-rest as integer   no-undo .
      126     assign
      127       p-number = p-number modulo 100
      128     .
      129     if p-number < 20
      130     then do:
      131       assign
      132         v-rest = p-number
      133       .
      134     end.
      135     else do:
      136       assign
      137         v-rest = p-number modulo 10
      138       .
      139     end.
      140     case v-rest :
      141       when 1
      142       then do:
      143         return 2 .
      144       end.
      145       when 2 or
      146       when 3 or
      147       when 4
      148       then do:
      149         return 3 .
      150       end.
      151       otherwise do:
      152         return 1 .
      153       end.
      154     end case .
      155   end.
      156   procedure cur-time-mjd-to-date :
      157      define input  parameter i-mjd-diff as decimal no-undo.
      158      define output parameter o-Date     as date    no-undo.
      159      define output parameter o-Time     as integer no-undo.
      160      define variable v-day-number as integer   no-undo .
      161      if    i-mjd-diff < 0
      162         or i-mjd-diff = ?
      163      then do:
      164         return "?" .
      165      end.
      166      assign
      167         v-day-number = truncate(i-mjd-diff,0).
      168         o-Date = date(v-day-number + 2400002).
      169         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      170     .
      171   end.
      172   function cur-time-mjd-to-string returns character
      173   (input p-mjd-diff as decimal
      174   )
      175   :
      176     define variable v-day-number as integer   no-undo .
      177     define variable v-seconds    as integer   no-undo .
      178     define variable v-hour       as integer   no-undo .
      179     define variable v-min        as integer   no-undo .
      180     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      181     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      182     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      183     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      184     if p-mjd-diff < 0
      185     or p-mjd-diff = ?
      186     then do:
      187       return "?" .
      188     end.
      189     assign
      190       v-day-number = integer(truncate(p-mjd-diff,0))
      191       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      192     .
      193     if v-seconds > 86400
      194     then do:
      195       assign
      196         v-seconds = 86400 - 1
      197       .
      198     end.
      199     if v-seconds < 0
      200     then do:
      201       assign
      202         v-seconds = 0
      203       .
      204     end.
      205     assign
      206       v-hour = truncate(v-seconds / 3600, 0)
      207     .
      208     assign
      209       v-seconds = v-seconds modulo 3600
      210     .
      211     assign
      212       v-min = truncate(v-seconds / 60, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 60
      216     .
      217     return
      218         (if v-day-number <> 0
      219           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      220           else ""
      221         )
      222       + (if v-day-number <> 0 or v-hour <> 0
      223           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      227           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      228           else ""
      229         )
      230       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      231       .
      232   end.
      233   function cur-time-string returns character
      234   :
      235     define variable v-date as date      no-undo .
      236     define variable v-time as integer   no-undo .
      237     run cur-time in this-procedure
      238       (output v-date
      239       ,output v-time
      240       ) .
      241     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      242   end.
      243   function cur-time-string-sec returns character
      244   :
      245     define variable v-date as date      no-undo .
      246     define variable v-time as integer   no-undo .
      247     run cur-time in this-procedure
      248       (output v-date
      249       ,output v-time
      250       ) .
      251     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      252   end.
      253   function cur-time-custom  returns character
      254   (input p-prefix as character
      255   ,input p-date-format as character
      256   ,input p-delimiter as character
      257   ,input p-time-format as character
      258   ,input p-suffix as character
      259   )
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return
      268       p-prefix
      269       + string(v-date, p-date-format)
      270       + p-delimiter
      271       + string(v-time, p-time-format)
      272       + p-suffix
      273       .
      274   end.
      275   function cur-time-print  returns character
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      284   end.
      285   function cur-time-datetime returns datetime
      286   :
      287     define variable v-char as character no-undo .
      288     define variable v-datetime as datetime no-undo .
      289     v-char = cur-time-string().
      290     v-datetime = datetime(v-char).
      291     return  v-datetime.
      292   end.
      293   function cur-time-string-msec returns character
      294   :
      295     define variable v-date as datetime  no-undo .
      296     v-date = now.
      297     return string(v-date) .
      298   end.
      299   define variable vss-include-info1 as character format "X(65)" no-undo
      300   initial "@(#)$Workfile$ $Revision$".
      301   procedure oxmlext-create :
      302   define input parameter p-mainmenu-handle    as handle           no-undo.
      303   define input parameter p-current-db-num     as integer          no-undo.
      304   define output parameter p-esys-id           as integer          no-undo.
      305       define variable v-today     as date         no-undo.
      306       define variable v-time      as integer      no-undo.
      307       define variable v-userid    as character    no-undo.
      308       define buffer buf_ext-system        for ub.ext-system.
      309   do
      310   for buf_ext-system
      311   on error undo, return error
      312   :
      313       run cur-time in this-procedure (
      314             output v-today
      315           , output v-time
      316       ).
      317       run oxmlext-esys-id in this-procedure (
      318           output p-esys-id
      319       ).
      320       run get-userid in p-mainmenu-handle (
      321           output v-userid
      322       ).
      323       create buf_ext-system.
      324       assign
      325           buf_ext-system.esys-id                          = p-esys-id
      326           buf_ext-system.db-num                           = p-current-db-num
      327           buf_ext-system.esys-date-change                 = v-today
      328           buf_ext-system.esys-chk-ingr-imp                = no
      329           buf_ext-system.esys-chk-seq-imp                 = no
      330           buf_ext-system.esys-date-change-attr            = v-today
      331           buf_ext-system.esys-date-change-exp             = v-today
      332           buf_ext-system.esys-date-change-imp             = v-today
      333           buf_ext-system.esys-db-num-exp                  = p-current-db-num
      334           buf_ext-system.esys-db-num-imp                  = p-current-db-num
      335           buf_ext-system.esys-des                         = ""
      336           buf_ext-system.esys-file-chk-ing-imp            = "":U
      337           buf_ext-system.esys-have-export                 = no
      338           buf_ext-system.esys-have-import                 = no
      339           buf_ext-system.esys-have-proc-chk-ing-imp       = no
      340           buf_ext-system.esys-last-pack                   = 0
      341           buf_ext-system.esys-name                        = "<Новая внешняя система>"
      342           buf_ext-system.esys-num-days-keep-exp           = 0
      343           buf_ext-system.esys-num-days-keep-imp           = 0
      344           buf_ext-system.esys-proc-chk-ing-imp            = "":U
      345           buf_ext-system.esys-send-news-exp               = no
      346           buf_ext-system.esys-send-news-imp               = no
      347           buf_ext-system.esys-status                      = integer( '-1':U )
      348           buf_ext-system.esys-work-update                 = no
      349           buf_ext-system.esys-creid                       = v-userid
      350           buf_ext-system.esys-sys-date                    = v-today
      351           buf_ext-system.esys-sys-time-int                = v-time
      352           buf_ext-system.esys-sys-time                    = string( v-time, "HH:MM:SS" )
      353           buf_ext-system.esys-user-name                   = v-userid
      354           buf_ext-system.esys-user-db-num                 = p-current-db-num
      355       .
      356   end.
      357   end procedure.
      358   procedure oxmlext-start-subsystem :
      359   define input parameter p-esys-id    as integer          no-undo.
      360   define input parameter p-db-num     as integer          no-undo.
      361       define buffer buf_ext-system        for ub.ext-system.
      362   do
      363   for buf_ext-system
      364   on error undo, return error
      365   :
      366       find first buf_ext-system exclusive-lock
      367            where buf_ext-system.esys-id = p-esys-id
      368              and buf_ext-system.db-num  = p-db-num
      369       .
      370       if buf_ext-system.esys-status = 20
      371       then do:
      372           assign
      373               buf_ext-system.esys-status = 21
      374           .
      375       end.
      376       else do:
      377           assign
      378               buf_ext-system.esys-status = 1
      379           .
      380       end.
      381   end.
      382   end procedure.
      383   procedure oxmlext-stop-subsystem :
      384   define input parameter p-esys-id    as integer          no-undo.
      385   define input parameter p-db-num     as integer          no-undo.
      386       define buffer buf_ext-system        for ub.ext-system.
      387   do
      388   for buf_ext-system
      389   on error undo, return error
      390   :
      391       find first buf_ext-system exclusive-lock
      392            where buf_ext-system.esys-id = p-esys-id
      393              and buf_ext-system.db-num  = p-db-num
      394       .
      395       if buf_ext-system.esys-status = 21
      396       then do:
      397           assign
      398               buf_ext-system.esys-status = 20
      399           .
      400       end.
      401       else do:
      402           assign
      403               buf_ext-system.esys-status = 0
      404           .
      405       end.
      406   end.
      407   end procedure.
      408   procedure oxmlext-stop-import :
      409   define input parameter p-esys-id    as integer          no-undo.
      410   define input parameter p-db-num     as integer          no-undo.
      411   do
      412   on error undo, return error
      413   :
      414   end.
      415   end procedure.
      416   procedure oxmlext-stop-export :
      417   define input parameter p-esys-id    as integer          no-undo.
      418   define input parameter p-db-num     as integer          no-undo.
      419   do
      420   on error undo, return error
      421   :
      422   end.
      423   end procedure.
      424   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      425     define variable v-cntxt-db-num        as integer   no-undo .
      426     define variable v-cntxt-userid        as character no-undo .
      427     define variable v-cntxt-level         as character no-undo .
