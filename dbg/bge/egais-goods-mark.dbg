      454           ,input "b-sel,b-add"
      455           ,input 'текущие':U
      456           ,input 'все':U
      457           ,input 'все':U
      458           ,input ?
      459           ,input ?
      460           ,input ?
      461           ,input ?
      462           ,input v-cntxt-obj-type
      463           ,input v-cntxt-obj-code
      464           ,input ?
      465           ,output ref-list).
      466         find first ub.goods where recid (ub.goods) = integer (ref-list) no-lock no-error .
      467         find first ub.goods-attr where ub.goods-attr.gds-code = ub.goods.gds-code and goods-attr.attr-code = "alcohol-prod" no-lock no-error .
      468         if available ub.goods-attr then do:
      469         if extGdsObj:NumBundles > 0 then
      470           do:
      471             do ii = 1 to extGdsObj:NumBundles:
      472               v-gds-code = extGdsObj:GetExtGdsValue(ii):GdsCode .
      473               v-GdsCodenew = ub.goods.gds-code .
      474               if v-GdsCodenew = v-Gds-Code then do:
      475                 message "Такой товар уже есть"
      476                 view-as alert-box.
      477                 return no-apply.
      478               end.
      479             end.
      480           end.
      481         extGdsValueObjnew = new ExtGdsValue () .
      482         extGdsObj:CopyEgaisInfo(extGdsObj:GetExtGdsValue(), extGdsValueObjnew).
      483         extGdsValueObjnew:GdsCode = v-GdsCodenew.
      484         extGdsValueObjnew:AlcCode = p-alc-code.
      485         extGdsObj:CreateExtGds (extGdsValueObjnew).
      486         extGdsObj:OpenQueryExtGds(p-gds-code, p-alc-code).
      487         find first tt-goods where tt-goods.gds-code = extGdsValueObjnew:GdsCode and
      488           tt-goods.gds-name = ub.goods.gds-name and
      489           tt-goods.artic    = ub.goods.artic no-lock no-error.
      490         if not available tt-goods then do:
      491         create tt-goods .
      492           tt-goods.alc-code = extGdsValueObjnew:AlcCode .
      493           tt-goods.gds-code = extGdsValueObjnew:GdsCode .
      494           tt-goods.gds-name = ub.goods.gds-name .
      495           tt-goods.artic    = ub.goods.artic .
      496           tt-goods.import-full-name = extGdsValueObjnew:FullNameImpor .
      497           tt-goods.prod-full-name   = extGdsValueObjnew:FullNameProd .
      498           tt-goods.CliRegIdProd = extGdsValueObjnew:CliRegIdProd .
      499           tt-goods.CountryProd = extGdsValueObjnew:CountryProd .
      500           tt-goods.INNProd = extGdsValueObjnew:INNProd .
      501           tt-goods.KPPProd = extGdsValueObjnew:KPPProd .
      502           tt-goods.CliRegIdImpor = extGdsValueObjnew:CliRegIdImpor .
      503           tt-goods.CountryImpor = extGdsValueObjnew:CountryImpor .
      504           tt-goods.INNImpor = extGdsValueObjnew:INNImpor .
      505           tt-goods.KPPImpor = extGdsValueObjnew:KPPImpor .
      506           .
      507         end.
      508         end.
      509         else do:
      510           message "Товар не является алкогольным"
      511           view-as alert-box.
      512         end.
      513         open query br-goods for each tt-goods .
      514   END.
      515   ON choose OF Btn_Cancel IN FRAME Dialog-Frame
      516   DO:
      517     assign
      518       p-alc-code = v-alc-code-old
      519       p-gds-code = v-gds-code-old
      520     .
      521   END.
      522   on value-changed of br-goods do:
      523     run local-value-changed.
      524   end.
      525   ON choose OF Btn_del IN FRAME Dialog-Frame
      526   DO:
      527         define variable glog         as logical no-undo.
      528   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      529   do:
      530     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      531       (input  v-cntxt-db-num
      532       ,input  v-cntxt-userid
      533       ,input  0
      534       ,input  'actn_egais-ref':U
      535       ,input  'object':U
      536       ,input  v-cntxt-host-code-obj
      537       ,input  v-cntxt-obj-type
      538       ,input  v-cntxt-obj-code
      539       ,input  0
      540       ,input  0
      541       ,input  0
      542       ,input  true
      543       ,output glog
      544       )  .
      545   end.
      546     if not glog then  return .
      547         extGdsObj:DeleteExtGds (tt-goods.gds-code, p-alc-code).
      548         delete tt-goods.
      549         extGdsObj:OpenQueryExtGds(p-gds-code, p-alc-code).
      550         open query br-goods for each tt-goods .
      551   END.
      552   ON choose OF Btn_OK IN FRAME Dialog-Frame
      553   DO:
      554         if available tt-goods then do:
      555         assign
      556           p-alc-code = tt-goods.alc-code
      557           p-gds-code = tt-goods.gds-code
      558           p-gds-name = tt-goods.gds-name
      559           p-import-full-name = tt-goods.import-full-name
      560           p-prod-full-name   = tt-goods.prod-full-name
      561           .
      562          end.
      563         RUN disable_UI.
      564       END.
      565     IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      566       THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      567     MAIN-BLOCK:
      568     DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      569       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      570       assign
      571         v-gds-code-old = p-gds-code
      572         v-alc-code-old = p-alc-code
      573       .
      574       RUN enable_UI.
      575       RUN enable_goods.
      576       WAIT-FOR GO OF FRAME Dialog-Frame.
      577     END.
      578     RUN disable_UI.
      579   PROCEDURE disable_UI :
      580     HIDE FRAME Dialog-Frame.
      581   END PROCEDURE.
      582   PROCEDURE enable_goods :
      583     define variable extGdsValueObj  as class ExtGdsValue no-undo.
      584     extGdsObj = new ExtGds (true).
      585     extGdsObj:OpenQueryExtGds(p-gds-code, p-alc-code).
      586     if extGdsObj:NumBundles > 0 then
      587     do:
      588       do ii = 1 to extGdsObj:NumBundles:
      589         v-gds-code = extGdsObj:GetExtGdsValue(ii):GdsCode .
      590         find first ub.goods where ub.goods.gds-code = v-gds-code no-lock no-error.
      591         if not available (ub.goods) then do:
      592           message "Не найден товар с кодом - " v-gds-code view-as alert-box.
      593         end.
      594         extGdsValueObj = extGdsObj:GetExtGdsValue(ii).
      595         create tt-goods .
      596         assign
      597           tt-goods.gds-code = extGdsValueObj:GdsCode
      598           tt-goods.alc-code = extGdsValueObj:AlcCode
      599           tt-goods.gds-name = ub.goods.gds-name
      600           tt-goods.artic    = ub.goods.artic
      601           tt-goods.import-full-name = extGdsValueObj:FullNameImpor
      602           tt-goods.prod-full-name   = extGdsValueObj:FullNameProd
      603           tt-goods.CliRegIdProd = extGdsValueObj:CliRegIdProd
      604           tt-goods.CountryProd = extGdsValueObj:CountryProd
      605           tt-goods.INNProd = extGdsValueObj:INNProd
      606           tt-goods.KPPProd = extGdsValueObj:KPPProd
      607           tt-goods.CliRegIdImpor = extGdsValueObj:CliRegIdImpor
      608           tt-goods.CountryImpor = extGdsValueObj:CountryImpor
      609           tt-goods.INNImpor = extGdsValueObj:INNImpor
      610           tt-goods.KPPImpor = extGdsValueObj:KPPImpor
      611         .
      612       end.
      613     end.
      614     open query br-goods for each tt-goods .
      615     run local-value-changed.
      616   END PROCEDURE.
      617   PROCEDURE local-value-changed :
      618     if available tt-goods then do:
      619       if length (tt-goods.prod-full-name) > 33 then do:
      620         v-prod-name = substring (tt-goods.prod-full-name,1,36,"character") .
      621         v-prod-name1 = substring (tt-goods.prod-full-name,37,81,"character") .
      622       end.
      623       else v-prod-name = tt-goods.prod-full-name .
      624       DISPLAY v-prod-name @ v-FullNameProd with frame Dialog-Frame.
      625       DISPLAY v-prod-name1 @ v-FullNameProd-2 with frame Dialog-Frame.
      626       DISPLAY tt-goods.CliRegIdProd @ v-CliRegIdProd with frame Dialog-Frame.
      627       DISPLAY tt-goods.CountryProd @ v-CountryProd with frame Dialog-Frame.
      628       DISPLAY tt-goods.INNProd @ v-INNProd with frame Dialog-Frame.
      629       DISPLAY tt-goods.KPPProd @ v-KPPProd with frame Dialog-Frame.
      630       if length (tt-goods.import-full-name) > 33 then do:
      631         v-imp-name = substring (tt-goods.import-full-name,1,36,"character") .
      632         v-imp-name1 = substring (tt-goods.import-full-name,37,81,"character") .
      633       end.
      634       else v-imp-name = tt-goods.import-full-name .
      635       DISPLAY v-imp-name @ v-FullNameImpor with frame Dialog-Frame.
      636       DISPLAY v-imp-name1 @ v-FullNameImpor-2 with frame Dialog-Frame.
      637       DISPLAY tt-goods.CliRegIdImpor @ v-CliRegIdImpor with frame Dialog-Frame.
      638       DISPLAY tt-goods.CountryImpor @ v-CountryImpor with frame Dialog-Frame.
      639       DISPLAY tt-goods.INNImpor @ v-INNImpor with frame Dialog-Frame.
      640       DISPLAY tt-goods.KPPImpor @ v-KPPImpor with frame Dialog-Frame.
      641       DISPLAY tt-goods.alc-code @ v-AlcCode with frame Dialog-Frame.
      642       DISPLAY string(tt-goods.gds-code) @ v-GdsCode with frame Dialog-Frame.
      643       if length (tt-goods.gds-name) > 33 then do:
      644         v-gds-name = substring (tt-goods.gds-name,1,33,"character") .
      645         v-gds-name1 = substring (tt-goods.gds-name,34,67,"character") .
      646       end.
      647       else v-gds-name = tt-goods.gds-name .
      648       DISPLAY v-gds-name @ v-FullNameGds with frame Dialog-Frame.
      649       DISPLAY v-gds-name1 @ v-FullNameGds-2 with frame Dialog-Frame.
      650     end.
      651   END PROCEDURE.
      652   PROCEDURE enable_UI :
      653     ENABLE Btn_OK Btn_Cancel Btn_add Btn_del br-goods
      654         WITH FRAME Dialog-Frame.
      655     if p-mode = 'ПРОСМОТР':U then do:
      656     DISABLE Btn_add Btn_del
      657         WITH FRAME Dialog-Frame.
      658     end.
      659     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      660     end.
      661     if p-mode = 'ВЫБОР':U  then do:
      662      DISABLE Btn_add Btn_del Btn_OK WITH FRAME Dialog-Frame.
      663     end.
      664     VIEW FRAME Dialog-Frame.
      665   END PROCEDURE.
