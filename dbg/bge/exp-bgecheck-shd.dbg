        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: $":U.
        3   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U.
        4   define variable vss-date        as character no-undo init "$Date: $":U.
        5   define variable vss-workfile    as character no-undo init "$Workfile: exp-bgecheck-shd.p $":U.
        6   define variable vss-archive     as character no-undo init "$Archive: bge/exp-bgecheck-shd.p $":U.
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define input parameter parparentproc as widget-handle no-undo.
       67   define input parameter p_parent-handle as widget-handle no-undo.
       68   define input parameter p_log-handle as handle no-undo.
       69   define input parameter p_db-num-char as character no-undo.
       70   define input parameter p_task-type as character no-undo.
       71   define input parameter p_task-num as integer no-undo.
       72   define input parameter p_db-num as integer no-undo.
       73   define variable v-directory        as char      no-undo.
       74   define variable v-ftp-address      as char      no-undo .
       75   define variable v-per              as integer   no-undo .
       76   define variable v-login            as char      no-undo .
       77   define variable v-password         as char      no-undo .
       78   define variable p-pack-lim         as int64     no-undo.
       79   define variable date_exp_from      as date      no-undo.
       80   define variable date_exp_to        as date      no-undo.
       81   define variable p-range            as integer   no-undo.
       82   define variable p-host-code        as integer   no-undo.
       83   define variable p-obj-list         as char      no-undo.
       84   define variable p-pay-type-list    as character no-undo.
       85   define variable p-gds-type         as char      no-undo.
       86   define variable p-doc-type-list    as character no-undo.
       87   define variable v-dc-num-full      as character no-undo.
       88   define variable v-inf-bonus        as logical   no-undo.
       89   define variable v-place            as integer   no-undo.
       90   define variable v-code_pool        as char      no-undo.
       91   define variable tb-rs-2            as char      no-undo.
       92   define variable tb-pay-desk-cards  as logical   no-undo.
       93   define variable tb-pay-desk        as logical   no-undo.
       94   define variable tb-parts           as logical   no-undo.
       95   define variable tb-inkass-pay-code as logical   no-undo.
       96   define variable tb-deleted         as logical   no-undo.
       97   define variable tb-chk-pay-code    as logical   no-undo.
       98   define variable tb-cst-code        as logical   no-undo.
       99   define variable tb-exp-checks      as logical   no-undo.
      100   define variable tb-chk-type as character no-undo.
      101   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      102   define temp-table temp-schedule-free no-undo
      103   field free-id as character
      104   field free-task-name as character
      105   field proc-run-name as character
      106   field proc-param-edit-name as character
      107   field conf-param as character
      108   field is-gbd as logical
      109   field is-ubd as logical
      110   field enable-concurrent-0 as logical
      111   field enable-concurrent-db as logical
      112   field other-info as character
      113   field enc-key as character
      114   field is-rum as logical
      115   index pi is unique primary
      116   free-id.
      117   procedure schedule-attr-name :
      118   do
      119     on error undo, return error
      120     :
      121     define input  parameter p-code           as character no-undo .
      122     define output parameter p-type           as character no-undo .
      123     define output parameter p-format         as character no-undo .
      124     define output parameter p-label          as character no-undo .
      125     define output parameter p-user-can-edit  as logical   no-undo .
      126     define output parameter p-output-display as logical   no-undo .
      127     define output parameter p-other          as character no-undo .
      128       if index(p-code, chr(4)) > 0 then do:
      129         p-code = entry(1, p-code, chr(4)).
      130       end.
      131       case p-code :
      132               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      133               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      134               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      135               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      136               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      137               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      138               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      139               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      140               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      141         otherwise do:
      142           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      143         end.
      144       end.
      145     end.
      146   end procedure.
      147   procedure schedule-attr-tooltip :
      148   do
      149     on error undo, return error
      150     :
      151       define input  parameter p-code    as character no-undo .
      152       define output parameter p-tooltip as character no-undo .
      153       define output parameter p-label   as character no-undo .
      154       if index(p-code, chr(4)) > 0 then do:
      155         p-code = entry(1, p-code, chr(4)).
      156       end.
      157       case p-code :
      158               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      159               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      160               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      161               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      162               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      163               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      164               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      165               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      166               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      167         otherwise do:
      168               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      169         end.
      170       end.
      171     end.
      172   end procedure.
      173   procedure schedule-attr-value :
      174   do
      175   on error undo, return error return-value
      176   :
      177   define input parameter  p-cre-db-num as integer    no-undo.
      178   define input parameter  p-task-type  as character  no-undo.
      179   define input parameter  p-task-num   as integer    no-undo.
      180   define input parameter  p-code       as character  no-undo.
      181   define output parameter p-value      as character  no-undo.
      182   define output parameter p-type       as character  no-undo.
      183       define variable v-format         as character no-undo .
      184       define variable v-label          as character no-undo .
      185       define variable v-user-can-edit  as logical   no-undo .
      186       define variable v-output-display as logical   no-undo .
      187       define variable v-other          as character no-undo .
      188       define buffer buf_schedule-attr for ub.schedule-attr.
      189       run schedule-attr-name in this-procedure (
      190             input  p-code
      191           , output p-type
      192           , output v-format
      193           , output v-label
      194           , output v-user-can-edit
      195           , output v-output-display
      196           , output v-other
      197       ) no-error .
      198       if error-status :error
      199       then do:
      200           undo, return error return-value .
      201       end.
      202       if p-code begins ('schd-free-id':U + chr(4))
      203       and entry(2, p-code, chr(4)) = '':U then do:
      204         find first buf_schedule-attr no-lock
      205             where buf_schedule-attr.cre-db-num = p-cre-db-num
      206               and buf_schedule-attr.task-type  = p-task-type
      207               and buf_schedule-attr.task-num   = p-task-num
      208               and buf_schedule-attr.attr-code  begins p-code
      209         no-error .
      210       end.
      211       else do:
      212         find first buf_schedule-attr no-lock
      213             where buf_schedule-attr.cre-db-num = p-cre-db-num
      214               and buf_schedule-attr.task-type  = p-task-type
      215               and buf_schedule-attr.task-num   = p-task-num
      216               and buf_schedule-attr.attr-code  = p-code
      217         no-error .
      218       end.
      219       if available buf_schedule-attr
      220       then do:
      221           assign
      222               p-value = buf_schedule-attr.attr-value
      223           .
      224       end.
      225       else do:
      226         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      227            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      228         end.
      229         else do:
      230           assign
      231               p-value = if p-type = 'L':U then "no":U else ""
      232           .
      233         end.
      234       end.
      235   end.
      236   end procedure.
      237   procedure schedule-attr-write :
      238   do
      239   on error undo, return error
      240   :
      241   define input parameter p-cre-db-num  as integer   no-undo.
      242   define input parameter p-task-type   as character no-undo.
      243   define input parameter p-task-num    as integer   no-undo.
      244   define input parameter p-code        as character no-undo.
      245   define input parameter p-value       as character no-undo.
      246       define variable v-type              as character                no-undo.
      247       define variable v-format            as character                no-undo.
      248       define variable v-label             as character                no-undo.
      249       define variable v-user-can-edit     as logical                  no-undo.
      250       define variable v-output-display    as logical                  no-undo.
      251       define variable v-other             as character                no-undo.
      252       define buffer buf_schedule-attr for ub.schedule-attr .
      253       run schedule-attr-name in this-procedure (
      254             input  p-code
      255           , output v-type
      256           , output v-format
      257           , output v-label
      258           , output v-user-can-edit
      259           , output v-output-display
      260           , output v-other
      261       ) no-error.
      262       if error-status :error
      263       then do:
      264           undo, return error return-value.
      265       end.
      266       find first buf_schedule-attr exclusive-lock
      267            where buf_schedule-attr.cre-db-num = p-cre-db-num
      268              and buf_schedule-attr.task-type  = p-task-type
      269              and buf_schedule-attr.task-num   = p-task-num
      270              and buf_schedule-attr.attr-code  = p-code
      271       no-error.
      272       if not available buf_schedule-attr
      273       then do:
      274           create buf_schedule-attr.
      275           assign
      276             buf_schedule-attr.cre-db-num = p-cre-db-num
      277             buf_schedule-attr.task-type  = p-task-type
      278             buf_schedule-attr.task-num   = p-task-num
      279             buf_schedule-attr.attr-code  = p-code
      280             buf_schedule-attr.attr-value = p-value
      281           .
      282       end.
      283       else do:
      284           assign
      285               buf_schedule-attr.attr-value = p-value
      286           .
      287       end.
      288   end.
      289   end procedure.
      290   procedure schedule-attr-delete :
      291   do
      292   on error undo, return error
      293   :
      294   define input  parameter p-cre-db-num  as integer   no-undo.
      295   define input  parameter p-task-type   as character no-undo.
      296   define input  parameter p-task-num    as integer   no-undo.
      297   define input  parameter p-code        as character no-undo.
      298   define output parameter p-deleted     as logical   no-undo.
      299       define buffer buf_schedule-attr for ub.schedule-attr .
      300       define variable v-type              as character                no-undo.
      301       define variable v-format            as character                no-undo.
      302       define variable v-label             as character                no-undo.
      303       define variable v-user-can-edit     as logical                  no-undo.
      304       define variable v-output-display    as logical                  no-undo.
      305       define variable v-other             as character                no-undo.
      306       run schedule-attr-name in this-procedure (
      307             input p-code
      308           , output v-type
      309           , output v-format
      310           , output v-label
      311           , output v-user-can-edit
      312           , output v-output-display
      313           , output v-other
      314       ) no-error .
      315       if error-status :error
      316       then do:
      317           undo, return error return-value .
      318       end.
      319       find first buf_schedule-attr exclusive-lock
      320            where buf_schedule-attr.cre-db-num = p-cre-db-num
      321              and buf_schedule-attr.task-type  = p-task-type
      322              and buf_schedule-attr.task-num   = p-task-num
      323              and buf_schedule-attr.attr-code  = p-code
      324       no-error.
      325       if not available buf_schedule-attr
      326       then do:
      327           assign
      328               p-deleted = no
      329           .
      330       end.
      331       else do:
      332           delete buf_schedule-attr.
      333           assign
      334               p-deleted = yes
      335           .
      336       end.
      337   end.
      338   end procedure.
      339   procedure schedule-attr-news :
      340   do
      341   on error undo, return error
      342   :
      343       define input  parameter p-code           as character no-undo .
      344       define output parameter p-news           as logical   no-undo .
      345       if index(p-code, chr(4)) > 0 then do:
      346         p-code = entry(1, p-code, chr(4)).
      347       end.
      348       case p-code :
      349               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      350               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      351               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      352               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      353               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      354               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      355               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      356               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      357               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      358         otherwise do:
      359           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      360         end.
      361       end.
      362   end.
      363   end procedure.
      364   procedure schedule-attr-extract-logical :
      365   do
      366   on error undo, return error
      367   :
      368   define input  parameter p-parameter-number   as integer      no-undo.
      369   define input  parameter p-parameter-list     as character    no-undo.
      370   define output parameter p-parameter-value   as logical      no-undo.
      371       if num-entries( p-parameter-list ) > p-parameter-number - 1
      372       then do:
      373           assign
      374               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      375           .
      376       end.
      377       else do:
      378           assign
      379               p-parameter-value   = no
      380           .
      381       end.
      382   end.
      383   end procedure.
      384   procedure schedule-attr-get-free-id :
      385   do
      386   on error undo, return error return-value
      387   :
      388     define input  parameter p-cre-db-num  as integer   no-undo.
      389     define input  parameter p-task-type   as character no-undo.
      390     define input  parameter p-task-num    as integer   no-undo.
      391     define output parameter p-free-id     as character no-undo.
      392     define buffer buf_schedule-attr for ub.schedule-attr.
      393     find first buf_schedule-attr no-lock
      394         where buf_schedule-attr.cre-db-num = p-cre-db-num
      395           and buf_schedule-attr.task-type  = p-task-type
      396           and buf_schedule-attr.task-num   = p-task-num
      397           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      398     no-error .
      399     if available buf_schedule-attr then
      400     assign
      401     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      402     no-error
      403     .
      404   end.
      405   end procedure.
      406   procedure schedule-attr-get-free-props :
      407     define input parameter p-free-id as character no-undo .
      408     define output parameter p-value as character no-undo .
      409     define buffer buf_temp-schedule-free for temp-schedule-free.
      410     do
      411     on error undo, return error return-value
      412     :
      413       find first buf_temp-schedule-free no-lock no-error .
      414       if not available buf_temp-schedule-free then do:
      415         run schedule-attr-fill-free-props in this-procedure .
      416       end.
      417       find first buf_temp-schedule-free where
      418               buf_temp-schedule-free.free-id = p-free-id no-error.
      419       if available buf_temp-schedule-free then do:
      420         assign
      421         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      422                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      423                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      424                   buf_temp-schedule-free.conf-param           + chr(4) +
      425                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      426                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      427                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      428                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      429                   buf_temp-schedule-free.other-info
      430         .
      431       end.
      432       else do:
      433        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      434                              "id произвольной задачи - &5"
      435                              ,vss-workfile
      436                              ,vss-revision
      437                              ,vss-description
      438                              ,chr(10)
      439                              ,p-free-id).
      440       end.
      441     end.
      442   end procedure.
      443   procedure schedule-attr-is-rum-free-id :
      444   define input parameter p-free-id as character no-undo .
      445   define output parameter p-is-rum as logical no-undo .
      446   define buffer buf_temp-schedule-free for temp-schedule-free.
      447   do
      448   on error undo, return error
      449   :
      450       find first buf_temp-schedule-free no-lock no-error .
      451       if not available buf_temp-schedule-free then do:
      452         run schedule-attr-fill-free-props in this-procedure .
      453       end.
      454       find first buf_temp-schedule-free where
      455               buf_temp-schedule-free.free-id = p-free-id no-error.
      456       if available buf_temp-schedule-free
      457       and buf_temp-schedule-free.is-rum
      458       then do:
      459         p-is-rum = yes.
      460       end.
      461   end.
      462   end procedure.
      463   procedure schedule-attr-fill-free-props :
      464   define variable v-path                    as character                no-undo .
      465   DEFINE VARIABLE v-full-path               as character                no-undo .
      466   DEFINE VARIABLE v-file-name               as character                no-undo .
      467   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      468   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      469   define buffer buf_temp-schedule-free for temp-schedule-free.
      470   define variable v-answer as logical no-undo .
      471     do
      472     on error undo, return error substitute("&1 &2 &3&4&5&4"
      473                                           ,vss-workfile
      474                                           ,vss-revision
      475                                           ,vss-description
      476                                           ,chr(10)
      477                                           ,error-status:get-message(1) )
      478     :
      479       run gbl/filename.p (
      480                       input 'cmp/shd-free.d'
      481                     ,output v-full-path
      482                     ,output v-path
      483                     ,output v-file-name
      484                     ,output v-file-name-no-ext
      485                     ,output v-file-name-ext
      486                     ) .
      487       input from value(v-full-path).
      488       repeat :
      489         create buf_temp-schedule-free.
      490         import buf_temp-schedule-free.
      491       END.
      492       input close.
      493       _ff:
      494       for each buf_temp-schedule-free :
      495         if buf_temp-schedule-free.free-id = '':U then do:
      496            delete buf_temp-schedule-free.
      497            next _ff.
      498          end.
      499          run schedule-attr-check-enc in this-procedure (
      500                                                       input  buf_temp-schedule-free.free-id
      501                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      502                                                               buf_temp-schedule-free.proc-param-edit-name +
      503                                                               buf_temp-schedule-free.conf-param +
      504                                                               string(buf_temp-schedule-free.is-gbd) +
      505                                                               string(buf_temp-schedule-free.is-ubd) +
      506                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      507                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      508                                                               string(buf_temp-schedule-free.other-info)
      509                                                               )
      510                                                       ,input  buf_temp-schedule-free.enc-key
      511                                                       ,output v-answer    ) no-error .
      512          if error-status:error
      513          or not v-answer then delete buf_temp-schedule-free.
      514        end.
      515     end.
      516   end procedure.
      517   Function schedule-attr-reverse returns character (str as character).
      518      define variable rev_incl_s as character init "" no-undo .
      519      define variable rev_incl_i as integer no-undo .
      520      define variable rev_incl_l as integer no-undo .
      521      rev_incl_l = length(str).
      522      do rev_incl_i = 1 to rev_incl_l:
      523         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      524      end.
      525      return rev_incl_s.
      526   end.
      527   procedure schedule-attr-check-enc.
      528     define input  parameter p-free-id   as character no-undo .
      529     define input  parameter p-value     as character no-undo .
      530     define input  parameter p-enc-value as character no-undo .
      531     define output parameter p-answer    as logical   no-undo .
      532     define variable tmp         as character no-undo .
      533     define variable v-enc-value as character no-undo .
      534     assign
      535     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      536     .
      537     run schedule-attr-pswd-enc in this-procedure
      538       ( input tmp
      539        ,output v-enc-value
      540       ) no-error .
      541     if error-status:error then do:
      542       message
      543         vss-workfile vss-revision vss-description skip
      544         "Ошибка при вызове процедуры pswd-enc" skip
      545         return-value skip
      546         error-status :get-message(1) skip
      547         view-as alert-box error .
      548       undo, return error .
      549     end.
      550     if v-enc-value = p-enc-value then do:
      551       assign
      552         p-answer = true
      553       .
      554     end.
      555     else do:
      556       assign
      557         p-answer = false
      558       .
      559     end.
      560   end.
      561   procedure schedule-attr-conf-enc.
      562     define input  parameter p-free-id   as character no-undo .
      563     define input  parameter p-value     as character no-undo .
      564     define output parameter p-enc-value as character no-undo .
      565     define variable tmp         as character no-undo .
      566     assign
      567       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      568     .
      569     run schedule-attr-pswd-enc in this-procedure
      570       ( input tmp
      571        ,output p-enc-value
      572       ) no-error .
      573     if error-status:error then do:
      574       message
      575         vss-workfile vss-revision vss-description skip
      576         "Ошибка при вызове процедуры pswd-enc" skip
      577         return-value skip
      578         error-status :get-message(1) skip
      579         view-as alert-box error .
      580       undo, return error .
      581     end.
      582   end procedure.
      583   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      584   procedure schedule-attr-pswd-enc :
      585     define input parameter  pswd     as character no-undo .
      586     define output parameter enc-pswd as character no-undo .
      587     do
      588     on error undo, return error return-value
      589     :
      590       assign
      591         enc-pswd = encode(pswd + string(index(pswd, "k")))
      592       .
      593     end.
      594   end procedure.
      595   define variable v-param-list as character no-undo.
      596   define variable v-param-type as character no-undo.
      597   run schedule-attr-value in this-procedure (input integer(p_db-num-char),
      598       input p_task-type,
      599       input p_task-num,
      600       input 'schedule-param-list':U,
      601       output v-param-list,
      602       output v-param-type).
      603   v-place  = integer(entry(1,v-param-list,chr(4))).
      604   if v-place = 1 then
      605   do:
      606       assign
      607           v-directory        = entry (2, v-param-list, chr(4))
      608           v-per              = integer(ENTRY(3, v-param-list, chr(4)))
      609           p-range            = integer(entry(4,v-param-list,chr(4)))
      610           p-host-code        = integer(entry(5,v-param-list,chr(4)))
      611           p-obj-list         = (entry(6,v-param-list,chr(4)))
      612           p-pay-type-list    = (entry(7,v-param-list,chr(4)))
      613           p-gds-type         = (entry(8,v-param-list,chr(4)))
      614           p-doc-type-list    = (entry(9,v-param-list,chr(4)))
      615           v-dc-num-full      = (entry(10,v-param-list,chr(4)))
      616           v-inf-bonus        = logical(entry(11,v-param-list,chr(4)))
      617           v-code_pool        = (entry(12,v-param-list,chr(4)))
      618           tb-pay-desk-cards  = logical (entry(13,v-param-list,chr(4)))
      619           tb-pay-desk        = logical (entry(14,v-param-list,chr(4)))
      620           tb-parts           = logical(entry(15,v-param-list,chr(4)))
      621           tb-inkass-pay-code = logical (entry(16,v-param-list,chr(4)))
      622           tb-deleted         = logical (entry(17,v-param-list,chr(4)))
      623           tb-chk-pay-code    = logical (entry(18,v-param-list,chr(4)))
      624           tb-cst-code        = logical (entry(19,v-param-list,chr(4)))
      625           tb-exp-checks      = logical  (entry(20,v-param-list,chr(4)))
      626           tb-rs-2            = entry(21,v-param-list,chr(4))
      627           tb-chk-type = entry(22,v-param-list,chr(4))
      628           no-error.
      629           p-pack-lim         = 90 no-error.
      630           if p-pack-lim = ? then p-pack-lim = 0.
      631   end.
      632   if v-place = 2 then
      633   do :
      634       assign
      635           v-ftp-address      = entry (2, v-param-list, chr(4))
      636           v-per              = integer(ENTRY(3, v-param-list, chr(4)))
      637           v-login            = ENTRY(4, v-param-list, chr(4))
      638           v-password         = ENTRY(5, v-param-list, chr(4))
      639           p-range            = integer(entry(6,v-param-list,chr(4)))
      640           p-host-code        = integer(entry(7,v-param-list,chr(4)))
      641           p-obj-list         = (entry(8,v-param-list,chr(4)))
      642           p-pay-type-list    = (entry(9,v-param-list,chr(4)))
      643           p-gds-type         = (entry(10,v-param-list,chr(4)))
      644           p-doc-type-list    = (entry(11,v-param-list,chr(4)))
      645           v-dc-num-full      = (entry(12,v-param-list,chr(4)))
      646           v-inf-bonus        = logical(entry(13,v-param-list,chr(4)))
      647           v-code_pool        = (entry(14,v-param-list,chr(4)))
      648           tb-pay-desk-cards  = logical (entry(15,v-param-list,chr(4)))
      649           tb-pay-desk        = logical (entry(16,v-param-list,chr(4)))
      650           tb-parts           = logical(entry(17,v-param-list,chr(4)))
      651           tb-inkass-pay-code = logical (entry(18,v-param-list,chr(4)))
      652           tb-deleted         = logical (entry(19,v-param-list,chr(4)))
      653           tb-chk-pay-code    = logical (entry(20,v-param-list,chr(4)))
      654           tb-cst-code        = logical (entry(21,v-param-list,chr(4)))
      655         tb-exp-checks   =     logical(entry(22,v-param-list,chr(4)))
      656          tb-rs-2 = entry(23,v-param-list,chr(4))
      657            tb-chk-type = entry(24,v-param-list,chr(4))
      658          no-error
      659           .
      660           p-pack-lim         = 90 no-error.
      661           if p-pack-lim = ? then p-pack-lim = 0.
      662   end.
      663   if v-place = 1  then
      664       run bge\bgecheck-new.p ( p_log-handle
      665           , v-directory
      666           , v-place
      667           , ""
      668           , ""
      669           , p-pack-lim
      670           , date_exp_from
      671           , date_exp_to
      672           , p-range
      673           , p-host-code
      674           , p-obj-list
      675           , p-pay-type-list
      676           , p-gds-type
      677           , p-doc-type-list
      678           ,  v-dc-num-full
      679           , v-per
      680           , v-inf-bonus
      681           , v-code_pool
      682           , tb-chk-type
      683           ) .
      684   if v-place = 2  then
      685       run bge\bgecheck-new.p ( p_log-handle,
      686           v-ftp-address
      687           , v-place
      688           , v-login
      689           , v-password
      690           , p-pack-lim
      691           , date_exp_from
      692           , date_exp_to
      693           , p-range
      694           , p-host-code
      695           , p-obj-list
      696           , p-pay-type-list
      697           , p-gds-type
      698           , p-doc-type-list
      699           ,  v-dc-num-full
      700           , v-per
      701           , v-inf-bonus
      702           , v-code_pool
      703           ,tb-chk-type
      704           ) .
