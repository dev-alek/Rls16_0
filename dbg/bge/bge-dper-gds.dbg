     3007   define variable v-time              as integer      no-undo.
     3008   define temp-table temp_obj-list no-undo
     3009       field obj-type as character
     3010       field obj-code as integer
     3011       index pi is primary unique obj-type obj-code
     3012   .
     3013   DEFINE BUTTON b-help
