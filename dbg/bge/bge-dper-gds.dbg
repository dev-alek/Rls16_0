     4027     then do:
     4028       ASSIGN
     4029         date_to :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date17 :HANDLE
     4030         date_to :MENU-MOUSE in frame Dialog-Frame = 3
     4031       .
     4032     end.
     4033     define variable v-label-handle17 as handle no-undo .
     4034     assign
     4035       v-label-handle17 = date_to :side-label-handle in frame Dialog-Frame
     4036     .
     4037     if valid-handle (v-label-handle17)
     4038     then do:
     4039       if v-label-handle17 :tooltip = ""
     4040       or v-label-handle17 :tooltip = ?
     4041       then do:
     4042         assign
     4043           v-label-handle17 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     4044         .
     4045       end.
     4046     end.
     4047     ON CHOOSE OF MENU-ITEM m-ed-date17-1 in menu m-ed-date17 DO:
     4048       apply "ctrl-b":U to date_to in frame Dialog-Frame .
     4049     END.
     4050     ON CHOOSE OF MENU-ITEM m-ed-date17-2 in menu m-ed-date17 DO:
     4051       apply "ctrl-d":U to date_to in frame Dialog-Frame .
     4052     END.
     4053     ON CHOOSE OF MENU-ITEM m-ed-date17-3 in menu m-ed-date17 DO:
     4054       apply "ctrl-e":U to date_to in frame Dialog-Frame .
     4055     END.
     4056     ON CHOOSE OF MENU-ITEM m-ed-date17-4 in menu m-ed-date17 DO:
     4057       apply "ctrl-f":U to date_to in frame Dialog-Frame .
     4058     END.
     4059   ASSIGN
     4060       date_from = v-today
     4061       date_to   = v-today
     4062   .
     4063   MAIN-BLOCK:
     4064   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4065      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4066       run cur-time in this-procedure (
     4067           output v-today
     4068           , output v-time
     4069       ).
     4070   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4071     run mainmenu_getcntxt in parparentproc
     4072       (output v-cntxt-db-num
     4073       ,output v-cntxt-userid
     4074       ,output v-cntxt-level
     4075       ,output v-cntxt-host-code-obj
     4076       ,output v-cntxt-obj-type
     4077       ,output v-cntxt-obj-code
     4078       ,output v-cntxt-db-num-obj
     4079       ,output v-cntxt-is-admin
     4080       ) .
     4081       assign
     4082           v-bge-dper-host-code  = v-cntxt-host-code-obj
     4083           v-bge-dper-store-type = v-cntxt-obj-type
     4084           v-bge-dper-store-code = v-cntxt-obj-code
     4085       .
     4086   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4087   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4088     (input  v-bge-dper-store-type
     4089     ,input  v-bge-dper-store-code
     4090     ,output v-bge-dper-host-code
     4091     )  .
     4092       run get-host-name in this-procedure ( output v-host-name ) no-error .
     4093       if error-status :error
     4094       then do:
     4095           message
     4096             vss-workfile vss-revision vss-description
     4097             skip "Ошибка при определении имени фирмы"
     4098             skip "Код фирмы:" v-bge-dper-host-code
     4099             skip "Имя фирмы будет отображаться как '" + 'орг':U + string( v-bge-dper-host-code ) + "'"
     4100             skip return-value
     4101             skip trim(error-status :get-message(1))
     4102                  trim(error-status :get-message(2))
     4103                  trim(error-status :get-message(3))
     4104                  trim(error-status :get-message(4))
     4105                  trim(error-status :get-message(5))
     4106           view-as alert-box warning.
     4107           assign
     4108               v-host-name = 'орг':U + string( v-bge-dper-host-code )
     4109           .
     4110       end.
     4111       run bge-xml-init-ext-doc-type in this-procedure .
     4112       RUN enable_UI.
     4113       IF p-output-type = 6
     4114       THEN DO:
     4115          ASSIGN
     4116             bt-cash-pay:SENSITIVE IN FRAME Dialog-Frame = FALSE
     4117             rs-cash-pay:SENSITIVE IN FRAME Dialog-Frame = FALSE
     4118          .
     4119       END.
     4120       ELSE DO:
     4121          HIDE
     4122             bt-cash-pay
     4123             rs-cash-pay
     4124          .
     4125       END.
     4126       if p-output-type = 0
     4127       or p-output-type = 2
     4128       or p-output-type = 3
     4129       or p-output-type = 5
     4130       or p-output-type = 6
     4131       then do:
     4132           assign
     4133               ed-doc-type :screen-value = chr(10) + "    Все"
     4134           .
     4135           disable ed-doc-type.
     4136           hide
     4137               bt-sel-doc-type
     4138               tb-inkass-pay-code
     4139               tb-cst-code
     4140               tb-parts
     4141               tb-pay-desk
     4142               tb-pay-desk-cards
     4143               tb-deleted
     4144           .
     4145           if  p-output-type <> 6
     4146           then do:
     4147               hide
     4148               tb-chk-pay-code
     4149               .
     4150           END.
     4151           if p-output-type <> 3
     4152           AND p-output-type <> 6
     4153           then do:
     4154               hide
     4155                   RECT-1
     4156                   rs-1
     4157                   bt-sel-obj
     4158                   ed-object
     4159               .
     4160           end.
     4161       end.
     4162       if p-output-type = 2
     4163       then do:
     4164           view tb-supp in frame Dialog-Frame .
     4165           enable tb-supp with frame Dialog-Frame .
     4166       end.
     4167       if p-output-type = 4
     4168       or p-output-type = 5
     4169       then do:
