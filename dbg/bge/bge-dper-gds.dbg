      569   define variable vss-include-info5 as character format "X(65)" no-undo
      570   initial "@(#)$Workfile$ $Revision$".
      571   procedure xmlchar-test :
      572   define input parameter p-in-string          as character        no-undo.
      573   define output parameter p-out-string-enc    as character        no-undo.
      574   define output parameter p-out-string-dec    as character        no-undo.
      575   do
      576   on error undo, return error
      577   :
      578          run xmlchar-encode in this-procedure
      579       (
      580             input p-in-string
      581           , output p-out-string-enc
      582       ).
      583          run xmlchar-decode in this-procedure
      584       (
      585             input p-out-string-enc
      586           , output p-out-string-dec
      587       ).
      588   end.
      589   end .
      590   procedure xmlchar-encode :
      591   define input parameter p-in-string      as character        no-undo.
      592   define output parameter p-out-string    as character        no-undo.
      593       define variable v-position      as integer      no-undo.
      594       define variable v-current-char  as character    no-undo.
      595   do
      596   on error undo, return error
      597   :
      598       assign
      599           p-out-string = "":U
      600       .
      601       case p-in-string
      602       :
      603           when ?
      604           then do:
      605               assign
      606                   p-out-string = "?":U
      607               .
      608           end.
      609           when "?":U
      610           then do:
      611               assign
      612                   p-out-string = "&#63;":U
      613               .
      614           end.
      615           otherwise do:
      616               do v-position = 1 to length( p-in-string )
      617               :
      618                   assign
      619                       v-current-char = substring( p-in-string, v-position, 1 )
      620                   .
      621                   case v-current-char
      622                   :
      623                       when "&":U
      624                       then do:
      625                           assign
      626                               p-out-string = p-out-string + "&amp;":U
      627                           .
      628                       end.
      629                       when ">":U
      630                       then do:
      631                           assign
      632                               p-out-string = p-out-string + "&gt;":U
      633                           .
      634                       end.
      635                       when "<":U
      636                       then do:
      637                           assign
      638                               p-out-string = p-out-string + "&lt;":U
      639                           .
      640                       end.
      641                       when "'":U
      642                       then do:
      643                           assign
      644                               p-out-string = p-out-string + "&apos;":U
      645                           .
      646                       end.
      647                       when '"':U
      648                       then do:
      649                           assign
      650                               p-out-string = p-out-string + "&quot;":U
      651                           .
      652                       end.
      653                       when chr(1)
      654                       then do:
      655                           assign
      656                               p-out-string = p-out-string + "":U
      657                           .
      658                       end.
      659                       when chr(2)
      660                       then do:
      661                           assign
      662                               p-out-string = p-out-string + "":U
      663                           .
      664                       end.
      665                       when chr(3)
      666                       then do:
      667                           assign
      668                               p-out-string = p-out-string + "":U
      669                           .
      670                       end.
      671                       when chr(4)
      672                       then do:
      673                           assign
      674                               p-out-string = p-out-string + "":U
      675                           .
      676                       end.
      677                       when chr(5)
      678                       then do:
      679                           assign
      680                               p-out-string = p-out-string + "":U
      681                           .
      682                       end.
      683                       when chr(6)
      684                       then do:
      685                           assign
      686                               p-out-string = p-out-string + "":U
      687                           .
      688                       end.
      689                       when chr(7)
      690                       then do:
      691                           assign
      692                               p-out-string = p-out-string + "":U
      693                           .
      694                       end.
      695                       when chr(8)
      696                       then do:
      697                           assign
      698                               p-out-string = p-out-string + "":U
      699                           .
      700                       end.
      701                       when chr(9)
      702                       then do:
      703                           assign
      704                               p-out-string = p-out-string + "":U
      705                           .
      706                       end.
      707                       when chr(29)
      708                       then do:
      709                           assign
      710                               p-out-string = p-out-string + "":U
      711                           .
      712                       end.
      713                       when chr(10)
      714                       then do:
      715                           assign
      716                               p-out-string = p-out-string + "&#10;":U
      717                           .
      718                       end.
      719                       when chr(13)
      720                       then do:
      721                           assign
      722                               p-out-string = p-out-string + "&#13;":U
      723                           .
      724                       end.
      725                       otherwise do:
      726                           assign
      727                               p-out-string = p-out-string + v-current-char
      728                           .
      729                       end.
      730                   end case.
      731               end.
      732           end.
      733       end case.
      734   end.
      735   end .
      736   procedure xmlchar-encode-1c :
      737   define input parameter p-in-string      as character        no-undo.
      738   define output parameter p-out-string    as character        no-undo.
      739       define variable v-position      as integer      no-undo.
      740       define variable v-current-char  as character    no-undo.
      741   do
      742   on error undo, return error
      743   :
      744       assign
      745           p-out-string = "":U
      746       .
      747       case p-in-string
      748       :
      749           when ?
      750           then do:
      751               assign
      752                   p-out-string = "?":U
      753               .
      754           end.
      755           otherwise do:
      756               do v-position = 1 to length( p-in-string )
      757               :
      758                   assign
      759                       v-current-char = substring( p-in-string, v-position, 1 )
      760                   .
      761                   case v-current-char
      762                   :
      763                       when chr(1)
      764                       then do:
      765                           assign
      766                               p-out-string = p-out-string + " ":U
      767                           .
      768                       end.
      769                       when chr(2)
      770                       then do:
      771                           assign
      772                               p-out-string = p-out-string + " ":U
      773                           .
      774                       end.
      775                       when chr(3)
      776                       then do:
      777                           assign
      778                               p-out-string = p-out-string + " ":U
      779                           .
      780                       end.
      781                       when chr(4)
      782                       then do:
      783                           assign
      784                               p-out-string = p-out-string + " ":U
      785                           .
      786                       end.
      787                       when chr(5)
      788                       then do:
      789                           assign
      790                               p-out-string = p-out-string + " ":U
      791                           .
      792                       end.
      793                       when chr(6)
      794                       then do:
      795                           assign
      796                               p-out-string = p-out-string + " ":U
      797                           .
      798                       end.
      799                       when chr(7)
      800                       then do:
      801                           assign
      802                               p-out-string = p-out-string + " ":U
      803                           .
      804                       end.
      805                       when chr(8)
      806                       then do:
      807                           assign
      808                               p-out-string = p-out-string + " ":U
      809                           .
      810                       end.
      811                       when chr(9)
      812                       then do:
      813                           assign
      814                               p-out-string = p-out-string + " ":U
      815                           .
      816                       end.
      817                       when chr(29)
      818                       then do:
      819                           assign
      820                               p-out-string = p-out-string + " ":U
      821                           .
      822                       end.
      823                       when chr(10)
      824                       then do:
      825                           assign
      826                               p-out-string = p-out-string + " ":U
      827                           .
      828                       end.
      829                       when chr(13)
      830                       then do:
      831                           assign
      832                               p-out-string = p-out-string + " ":U
      833                           .
      834                       end.
      835                       otherwise do:
      836                           assign
      837                               p-out-string = p-out-string + v-current-char
      838                           .
      839                       end.
      840                   end case.
      841               end.
      842           end.
      843       end case.
      844   end.
      845   end .
      846   procedure xmlchar-decode :
      847   define input parameter p-in-string      as character        no-undo.
      848   define output parameter p-out-string    as character        no-undo.
      849       define variable v-position      as integer      no-undo.
      850       define variable v-last-position as integer      no-undo.
      851       define variable v-temp-integer  as integer      no-undo.
      852       define variable v-current-char  as character    no-undo.
      853       define variable v-next-char     as character    no-undo.
      854       define variable v-success       as logical      no-undo.
      855   do
      856   on error undo, return error
      857   :
      858       assign
      859           p-out-string = "":U
      860           v-position   = 0
      861       .
      862       replace-cycle:
      863       do while yes
      864       on error undo, return error
      865       :
      866           assign
      867               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      868           .
      869           if v-last-position <= v-position
      870           then do:
      871               if v-position = 0
      872               then do:
      873                   assign
      874                       p-out-string = p-in-string
      875                   .
      876               end.
      877               else do:
      878                   assign
      879                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      880                   .
      881               end.
      882               leave replace-cycle.
      883           end.
      884           else do:
      885               assign
      886                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      887                   v-position      = v-last-position
      888                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      889               .
      890               if v-current-char = "#":U
      891               then do:
      892                   assign
      893                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      894                   .
      895                   if v-last-position > 0
      896                   then do:
      897                       run xmlchar-read-integer in this-procedure
      898                        (
      899                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      900                           , output v-temp-integer
      901                           , output v-success
      902                       ).
      903                       if v-success = yes
      904                       and v-temp-integer >= 1
      905                       and v-temp-integer <= 255
      906                       then do:
      907                           assign
      908                               p-out-string = p-out-string + chr( v-temp-integer )
      909                               v-position   = v-last-position + 1
      910                           .
      911                       end.
      912                       else do:
      913                           assign
      914                               p-out-string = p-out-string + "&":U
      915                               v-position   = v-position   + 1
      916                           .
      917                       end.
      918                   end.
      919                   else do:
      920                       assign
      921                           p-out-string = p-out-string + "&":U
      922                           v-position   = v-position   + 1
      923                       .
      924                   end.
      925               end.
      926               else do:
      927                   case substring( p-in-string, v-position + 1, 3 )
      928                   :
      929                       when "lt;":U
      930                       then do:
      931                           assign
      932                               p-out-string = p-out-string + "<":U
      933                               v-position   = v-position   + 3
      934                           .
      935                       end.
      936                       when "gt;":U
      937                       then do:
      938                           assign
      939                               p-out-string = p-out-string + ">":U
      940                               v-position   = v-position   + 3
      941                           .
      942                       end.
      943                       otherwise do:
      944                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      945                           then do:
      946                               assign
      947                                   p-out-string = p-out-string + "&":U
      948                                   v-position   = v-position   + 4
      949                               .
      950                           end.
      951                           else do:
      952                               case substring( p-in-string, v-position + 1, 5 )
      953                               :
      954                                   when "quot;":U
      955                                   then do:
      956                                       assign
      957                                           p-out-string = p-out-string + '"':U
      958                                           v-position   = v-position   + 5
      959                                       .
      960                                   end.
      961                                   when "apos;":U
      962                                   then do:
      963                                       assign
      964                                           p-out-string = p-out-string + "'":U
      965                                           v-position   = v-position   + 5
      966                                       .
      967                                   end.
      968                                   otherwise do:
      969                                       assign
      970                                           p-out-string = p-out-string + "&":U
      971                                       .
      972                                   end.
      973                               end case.
      974                           end.
      975                       end.
      976                   end case.
      977               end.
      978           end.
      979       end.
      980   end.
      981   end .
      982   procedure xmlchar-read-integer :
      983   define input parameter p-input-string      as character        no-undo.
      984   define output parameter p-output-integer   as integer          no-undo.
      985   define output parameter p-success       as logical          no-undo.
      986   do
      987   on error undo, return error
      988   :
      989       assign
      990           p-output-integer = integer( p-input-string )
      991       no-error.
      992       if error-status :error
      993       then do:
      994           assign
      995               p-success           = no
      996               p-output-integer    = 0
      997           .
      998       end.
      999       else do:
     1000           assign
     1001               p-success           = yes
     1002           .
     1003       end.
     1004   end.
     1005   end.
     1006   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1007   procedure strtdate :
     1008     define input  parameter p-str         as character no-undo .
     1009     define output parameter p-value       as date      no-undo .
     1010     define output parameter p-data-valid  as logical   no-undo .
     1011     define output parameter p-message     as character no-undo .
     1012   do
     1013   on error undo, return error return-value
     1014   :
     1015     define variable v-value       as date      no-undo .
     1016     define variable v-i           as integer   no-undo .
     1017     define variable v-num         as integer   no-undo .
     1018     define variable v-delim       as character no-undo .
     1019     define variable v-delim-list  as character no-undo .
     1020     define variable v-day         as integer   no-undo .
     1021     define variable v-month       as integer   no-undo .
     1022     define variable v-year        as integer   no-undo .
     1023     define variable v-day-str     as character no-undo .
     1024     define variable v-month-str   as character no-undo .
     1025     define variable v-year-str    as character no-undo .
     1026     assign
     1027       p-value       = ?
     1028       p-data-valid  = false
     1029     .
     1030     if p-str = ?
     1031     then do:
     1032       assign
     1033         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
     1034       .
     1035       return .
     1036     end.
     1037     if p-str = ""
     1038     then do:
     1039       assign
     1040         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
     1041       .
     1042       return .
     1043     end.
     1044     if length(p-str)  > 10
     1045     then do:
     1046       assign
     1047         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
     1048       .
     1049       return .
     1050     end.
     1051     assign
     1052       v-delim-list = '/,-,.':U
     1053     .
     1054     _delim:
     1055     do v-i = 1 to num-entries( v-delim-list )
     1056     :
     1057       assign
     1058         v-delim = entry( v-i , v-delim-list )
     1059         v-num   = num-entries( p-str , v-delim )
     1060       .
     1061       if v-num <> 3
     1062       then do:
     1063         assign
     1064           v-delim = ''
     1065         .
     1066       end.
     1067       else do:
     1068         leave _delim.
     1069       end.
     1070     end.
     1071     if v-delim = ''
     1072     then do:
     1073       assign
     1074         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
     1075       .
     1076       return .
     1077     end.
     1078     assign
     1079       v-day-str   = entry( 1, p-str , v-delim)
     1080       v-month-str = entry( 2, p-str , v-delim)
     1081       v-year-str  = entry( 3, p-str , v-delim)
     1082     .
     1083     if  length(v-day-str) > 2   or
     1084         length(v-day-str) < 1   or
     1085         length(v-month-str) > 2 or
     1086         length(v-month-str) < 1 or
     1087         (
     1088           length(v-year-str) <> 2 and
     1089           length(v-year-str) <> 4
     1090         )
     1091     then do:
     1092       assign
     1093         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
     1094       .
     1095       return .
     1096     end.
     1097     if length( v-year-str ) = 2
     1098     then do:
     1099       assign
     1100         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
     1101       .
     1102     end.
     1103     assign
     1104       v-day   = integer( v-day-str )
     1105       v-month = integer( v-month-str)
     1106       v-year  = integer( v-year-str)
     1107     no-error .
     1108     if error-status :error
     1109     then do:
     1110       assign
     1111         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
     1112       .
     1113       return .
     1114     end.
     1115     if v-day < 1  or
     1116        v-day > 31 or
     1117        v-month < 1 or
     1118        v-month > 12 or
     1119        v-year < 0   or
     1120        v-year > 5000
     1121     then do:
     1122       assign
     1123         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
     1124       .
     1125       return .
     1126     end.
     1127     assign
     1128       v-value = date( v-month, v-day, v-year )
     1129     no-error .
     1130     if error-status :error
     1131     then do:
     1132       assign
     1133         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
     1134       .
     1135       return .
     1136     end.
     1137     assign
     1138       p-value       = v-value
     1139       p-data-valid  = true
     1140     .
     1141   end.
     1142   end procedure.
