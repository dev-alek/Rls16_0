      366   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367     define variable v-cntxt-db-num        as integer   no-undo .
      368     define variable v-cntxt-userid        as character no-undo .
      369     define variable v-cntxt-level         as character no-undo .
      370     define variable v-cntxt-host-code-obj as integer   no-undo .
      371     define variable v-cntxt-obj-type      as character no-undo .
      372     define variable v-cntxt-obj-code      as integer   no-undo .
      373     define variable v-cntxt-db-num-obj    as integer   no-undo .
      374     define variable v-cntxt-is-admin      as logical   no-undo .
      375   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   define temp-table userobjs_temp-user-obj no-undo
      377     field obj-type as character
      378     field obj-code as integer
      379     index xpk is primary unique obj-type obj-code
      380     .
      381   procedure userobjs_clear :
      382     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      383     do
      384     on error undo, return error return-value
      385     :
      386       for each buf_userobjs_temp-user-obj
      387       on error undo, return error return-value
      388       :
      389         delete buf_userobjs_temp-user-obj .
      390       end.
      391     end.
      392   end .
      393   procedure userobjs_object-count :
      394     define output parameter p-total-count as integer   no-undo .
      395     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      396     do
      397     on error undo, return error return-value
      398     :
      399       assign
      400         p-total-count = 0
      401       .
      402       for each buf_userobjs_temp-user-obj
      403       on error undo, return error return-value
      404       :
      405         assign
      406           p-total-count = p-total-count + 1
      407         .
      408       end.
      409     end.
      410   end.
      411   procedure userobjs_append :
      412      define input  parameter p-obj-type as character no-undo .
      413      define input  parameter p-obj-code as integer   no-undo .
      414     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      415     do
      416     on error undo, return error return-value
      417     :
      418       find first buf_userobjs_temp-user-obj
      419         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      420           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      421         no-error .
      422       if not available buf_userobjs_temp-user-obj
      423       then do:
      424         create buf_userobjs_temp-user-obj .
      425         assign
      426           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      427           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      428         .
      429       end.
      430     end.
      431   end.
      432   procedure userobjs_object-exist :
      433     define output parameter p-object-exist as logical   no-undo .
      434     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      435     do
      436     on error undo, return error return-value
      437     :
      438       find first buf_userobjs_temp-user-obj
      439         no-error .
      440       if not available buf_userobjs_temp-user-obj
      441       then do:
      442         assign
      443           p-object-exist = false
      444         .
      445       end.
      446       else do:
      447         assign
      448           p-object-exist = true
      449         .
      450       end.
      451     end.
      452   end.
      453   procedure userobjs_transfer :
      454     define input  parameter p-callback-handle as handle no-undo .
      455     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      456     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      457     do
      458     on error undo, return error return-value
      459     :
      460       if valid-handle(p-callback-handle) <> true
      461       then do:
      462         message
      463           vss-workfile vss-revision vss-description skip
      464           "Ошибка задания входных параметров" skip
      465           "Неизвестный указатель на процедуру" skip
      466           view-as alert-box error .
      467         undo, return error return-value .
      468       end.
      469       if p-callback-handle :get-signature("userobjs_append") = ""
      470       then do:
      471         message
      472           vss-workfile vss-revision vss-description skip
      473           "Ошибка задания входных параметров" skip
      474           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      475                     ,p-callback-handle :file-name
      476                     ) skip
      477           view-as alert-box error .
      478         undo, return error return-value .
      479       end.
      480       for each buf_userobjs_temp-user-obj
      481       on error undo, return error return-value
      482       :
      483         run userobjs_append in p-callback-handle
      484           (input  buf_userobjs_temp-user-obj.obj-type
      485           ,input  buf_userobjs_temp-user-obj.obj-code
      486           ) .
      487       end.
      488     end.
      489   end procedure.
      490   procedure userobjs_select-one :
      491      define input  parameter parparentproc     as widget-handle no-undo .
      492      define input  parameter p-db-num          as integer   no-undo .
      493      define input  parameter p-user-id         as character no-undo .
      494      define input  parameter p-host-code-obj   as integer   no-undo .
