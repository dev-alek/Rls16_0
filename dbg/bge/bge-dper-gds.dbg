     3156        RECT-2 AT ROW 9.05 COL 2
     3157        RECT-1 AT ROW 4.43 COL 1.8
     3158        RECT-3 AT ROW 11.43 COL 2
     3159        RECT-5 AT ROW 16.71 COL 2 WIDGET-ID 4
     3160        SPACE(0.99) SKIP(0.28)
     3161       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3162            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3163            TITLE "Диапазон дат для экспорта".
     3164   ASSIGN
     3165          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     3166          FRAME Dialog-Frame:HIDDEN           = TRUE.
     3167   ASSIGN
     3168          bt-cash-pay:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     3169   ASSIGN
     3170          ed-doc-type:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     3171   ASSIGN
     3172          ed-doc-type-label:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     3173   ASSIGN
     3174          ed-doc-type-label-2:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     3175   ASSIGN
     3176          rs-cash-pay:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     3177   ASSIGN
     3178          tb-supp:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     3179   ON WINDOW-CLOSE OF FRAME Dialog-Frame
