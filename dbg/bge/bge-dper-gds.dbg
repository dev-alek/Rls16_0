     3195   ON CHOOSE OF bt-sel-doc-type IN FRAME Dialog-Frame
     3196   DO:
     3197       define variable v-cancel     as logical           no-undo.
     3198       run bge/bgeseltp.w (
     3199             input "trn-doc":U
     3200           , input p-init-doc-type-list
     3201           , output p-doc-type-list
     3202           , output v-cancel
     3203       ) no-error.
     3204       if error-status :error
     3205       then do:
     3206           message
     3207             vss-workfile vss-revision vss-description
     3208             skip "Ошибка выбора типов операций."
     3209             skip return-value
     3210             skip trim(error-status :get-message(1))
     3211                  trim(error-status :get-message(2))
     3212                  trim(error-status :get-message(3))
     3213                  trim(error-status :get-message(4))
     3214                  trim(error-status :get-message(5))
     3215           view-as alert-box error.
     3216           undo, return no-apply .
     3217       end.
     3218       if v-cancel = yes
     3219       then do:
     3220           assign
     3221               p-doc-type-list = p-init-doc-type-list
     3222           .
     3223       end.
     3224       else do:
     3225           assign
     3226               p-init-doc-type-list    = p-doc-type-list
     3227           .
     3228           if p-doc-type-list = ''
     3229           then do:
     3230               assign
     3231                   ed-doc-type :screen-value in frame Dialog-Frame = "Все"
     3232               .
     3233           end.
     3234           else do:
     3235               assign
     3236                   ed-doc-type :screen-value in frame Dialog-Frame = ''
     3237               .
     3238               for each temp_ext-doc-type
     3239               :
     3240                   if lookup( temp_ext-doc-type.ext-doc-type, p-init-doc-type-list ) <> 0
     3241                   then do:
     3242                       assign
     3243                           ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
     3244                                                       + temp_ext-doc-type.ext-doc-type-label + chr(10)
     3245                       .
     3246                   end.
     3247               end.
     3248           end.
     3249       end.
     3250   END.
     3251   ON CHOOSE OF bt-sel-obj IN FRAME Dialog-Frame
     3252   DO:
     3253      define variable v-host-code like ub.sysconf.host-code no-undo .
     3254       assign
     3255           rs-1 :screen-value  = "3"
     3256       .
     3257       define variable v-object-available as logical   no-undo .
     3258   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3259   run userobjs_clear in this-procedure  .
     3260   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3261   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
     3262     (input  v-cntxt-db-num
     3263     ,input  0
     3264     ,input  v-cntxt-userid
     3265     ,input  v-bge-dper-store-type
     3266     ,input  v-bge-dper-store-code
     3267     ,output v-object-available
     3268     ) no-error .
     3269       if error-status :error
     3270       then do:
     3271         message
     3272           vss-workfile vss-revision vss-description skip
     3273           "Ошибка при вызове процедуры gbl/usobjava.i" skip
     3274           error-status :get-message(1) skip
     3275           return-value skip
     3276           view-as alert-box error .
     3277         undo, return no-apply .
     3278       end.
     3279       if v-object-available = true
     3280       then do:
     3281   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3282   run userobjs_append in this-procedure
     3283     (input  v-bge-dper-store-type
     3284     ,input  v-bge-dper-store-code
     3285     )  .
     3286       end.
     3287       define variable v-user-select as logical   no-undo .
     3288   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3289   run userobjs_select-many in this-procedure
     3290     (input  parparentproc
     3291     ,input  v-cntxt-db-num
     3292     ,input  v-cntxt-userid
     3293     ,input  v-cntxt-host-code-obj
     3294     ,input  v-cntxt-obj-type
     3295     ,input  v-cntxt-obj-code
     3296     ,output v-user-select
     3297     )  .
     3298       if v-user-select <> true
     3299       then do:
     3300         message
     3301           "Объект не выбран"
     3302           view-as alert-box information .
     3303         return no-apply .
     3304       end.
     3305       define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     3306       for each temp_obj-list:
     3307         delete temp_obj-list.
     3308       end.
     3309       for each buf_userobjs_temp-user-obj
     3310       on error undo, return no-apply
     3311       :
     3312         create temp_obj-list.
     3313         assign
     3314           temp_obj-list.obj-type = buf_userobjs_temp-user-obj.obj-type
     3315           temp_obj-list.obj-code = buf_userobjs_temp-user-obj.obj-code
     3316           .
     3317       end.
     3318       assign
     3319           v-obj-list = ""
     3320       .
     3321       for each temp_obj-list
     3322       :
     3323           assign v-obj-list = v-obj-list + (if v-obj-list <> "" then ", " else "" )
     3324                                       + temp_obj-list.obj-type + string( temp_obj-list.obj-code ).
     3325       end.
     3326       assign
     3327           ed-object :screen-value = v-obj-list
     3328       .
     3329   END.
     3330   ON CHOOSE OF Btn_Cancel IN FRAME Dialog-Frame
     3331   DO:
     3332       assign
     3333           p-cancel = yes
     3334       .
     3335       apply "window-close" to frame Dialog-Frame.
     3336   END.
     3337   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     3338   DO:
     3339       ASSIGN
     3340           date_from
     3341           date_to
     3342           tb-inkass-pay-code
     3343           tb-cst-code
     3344           tb-parts
     3345           tb-deleted
     3346           tb-supp
     3347           tb-exp-checks
     3348           rs-1
     3349           rs-2
     3350           tb-chk-pay-code
     3351           tb-pay-desk
     3352           tb-pay-desk-cards
     3353           date_exp_from = date_from
     3354           date_exp_to   = date_to
     3355       .
     3356       assign
     3357         p-chk      = tb-exp-checks
     3358         p-gds-type = rs-2
     3359       .
     3360       if date_from > date_to
     3361       and p-output-type <> 4
     3362       and p-output-type <> 5
     3363       then do:
     3364           message
     3365               "Даты интервала заданы неверно. "
     3366               skip " Нижняя дата интервала должна быть меньше верхней."
     3367               skip(1) "Задайте интервал дат правильно или отмените экспорт."
     3368           view-as alert-box information.
     3369           apply "entry" to date_from.
     3370           undo, return no-apply.
     3371       end.
     3372       if p-output-type = 0
     3373       then do:
     3374         case rs-1 :screen-value
     3375         :
     3376         when "1"
     3377         then do:
     3378             assign
     3379                 p-range = 1
     3380                 p-obj-list = ""
     3381             .
     3382         end.
     3383         when "2"
     3384         then do:
     3385             assign
     3386                 p-range = 2
     3387                 p-obj-list = ""
     3388             .
     3389         end.
     3390         when "3"
     3391         then do:
     3392             assign
     3393                 p-range = 3
     3394                 p-obj-list = ""
     3395             .
     3396             for each temp_obj-list
     3397             :
     3398                 assign
     3399                     p-obj-list = p-obj-list
     3400                             + ( if p-obj-list = "" then "" else "," ) + temp_obj-list.obj-type
     3401                             + "," + string( temp_obj-list.obj-code )
     3402                 .
     3403             end.
     3404         end.
     3405         end case.
     3406       end.
     3407       if p-output-type = 2
     3408       then do:
     3409           assign
     3410               p-cst = tb-supp
     3411               p-range     = 2
     3412               p-host-code = v-bge-dper-host-code
     3413               p-obj-list  = ""
     3414           .
     3415       end.
     3416       if p-output-type = 1
     3417       or p-output-type = 3
     3418       or p-output-type = 4
     3419       or p-output-type = 5
     3420       or p-output-type = 6
     3421       then do:
     3422           if p-output-type = 1
     3423           then do:
     3424               assign
     3425                   p-pay-code     = tb-inkass-pay-code
     3426                   p-cst          = tb-cst-code
     3427                   p-parts        = tb-parts
     3428                   p-deleted      = tb-deleted
     3429                   p-chk-pay-code = tb-chk-pay-code
     3430                   p-pay-desk     = tb-pay-desk
     3431                   p-pay-desk-cards = tb-pay-desk-cards
     3432               .
     3433           end.
     3434           case rs-1 :screen-value
     3435           :
     3436           when "1"
     3437           then do:
     3438               assign
     3439                   p-range = 1
     3440                   p-obj-list = ""
     3441               .
     3442           end.
     3443           when "2"
     3444           then do:
     3445               assign
     3446                   p-range = 2
     3447                   p-host-code = v-bge-dper-host-code
     3448                   p-obj-list = ""
     3449               .
     3450           end.
     3451           when "3"
     3452           then do:
     3453               assign
     3454                   p-range = 3
     3455                   p-obj-list = ""
     3456               .
     3457               for each temp_obj-list
     3458               :
     3459                   assign
     3460                       p-obj-list = p-obj-list
     3461                               + ( if p-obj-list = "" then "" else "," ) + temp_obj-list.obj-type
     3462                               + "," + string( temp_obj-list.obj-code )
     3463                   .
     3464               end.
     3465           end.
     3466           end case.
     3467       end.
     3468       run flt-save in this-procedure .
     3469       APPLY "GO" TO FRAME Dialog-Frame.
     3470   END.
     3471   ON RETURN OF date_from IN FRAME Dialog-Frame
     3472   DO:
     3473       APPLY "ENTRY" TO date_to IN FRAME Dialog-Frame.
     3474       RETURN NO-APPLY.
     3475   END.
     3476   ON RETURN OF date_to IN FRAME Dialog-Frame
     3477   DO:
     3478       APPLY "ENTRY" TO btn_OK IN FRAME Dialog-Frame.
     3479       RETURN NO-APPLY.
     3480   END.
     3481   ON VALUE-CHANGED OF rs-1 IN FRAME Dialog-Frame
     3482   DO:
     3483   run object-select in this-procedure no-error .
     3484   if error-status :error
     3485   then do:
     3486       undo, return no-apply.
     3487   end.
     3488   assign
     3489       rs-1
     3490   .
     3491   END.
     3492   ON VALUE-CHANGED OF rs-cash-pay IN FRAME Dialog-Frame
     3493   DO:
     3494     bt-cash-pay :SENSITIVE IN FRAME Dialog-Frame = LOGICAL(rs-cash-pay:SCREEN-VALUE IN FRAME Dialog-Frame).
     3495   END.
     3496   ON VALUE-CHANGED OF tb-chk-pay-code IN FRAME Dialog-Frame
     3497   DO:
     3498       assign
     3499           tb-chk-pay-code
     3500       .
     3501       rs-cash-pay :SENSITIVE IN FRAME Dialog-Frame = tb-chk-pay-code.
     3502       run manage-tb-chk-pay-code in this-procedure.
     3503   END.
     3504   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3505   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3506   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3507   on help of frame Dialog-Frame
     3508   do:
     3509     run gbl/app_help.p
     3510       (input this-procedure :file-name
     3511       ,input ''
     3512       ,input ?
     3513       ) no-error.
     3514     if error-status :error then do:
     3515       message
     3516         "Ошибка при вызове помощи"
     3517         error-status :get-message(1)
     3518         view-as alert-box .
     3519     end.
     3520   end.
     3521   run minbtn-set in this-procedure .
     3522   on choose of b-help in frame Dialog-Frame
     3523   do:
     3524     apply "help":u to frame Dialog-Frame .
     3525   end.
     3526   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3527   procedure minbtn-set :
     3528       do
     3529           on error undo, return error return-value
     3530           :
     3531           define variable ii              as integer       no-undo .
     3532           define variable fh              as widget-handle no-undo .
     3533           define variable hh              as widget-handle no-undo .
     3534           define variable v-h             as handle        extent 4 no-undo .
     3535           define variable v-name-button   as character     no-undo .
     3536           define variable v-help-old-x    as decimal       no-undo .
     3537           define variable v-help-old-y    as decimal       no-undo .
     3538           define variable v-help-old-size as decimal       no-undo .
     3539           define variable v-frame-width   as decimal       no-undo .
     3540           define variable jj              as integer       no-undo .
     3541           do
     3542               on error undo, return error
     3543               :
     3544               assign
     3545                   v-frame-width = frame Dialog-Frame:width - 0.3
     3546                   fh            = frame Dialog-Frame:first-child
     3547                   hh            = fh:first-child
     3548                   ii            = 1
     3549                   .
     3550               do while valid-handle(hh):
     3551                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3552                   do:
     3553                       case lc(hh:name) :
     3554                           when "b-help" then
     3555                               do:
     3556                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3557                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3558                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3559                                   hh:TOOLTIP = "Помощь" .
     3560                                   v-help-old-x = hh:column .
     3561                                   v-help-old-y = hh:row    .
     3562                                   v-help-old-size = hh:width .
     3563                                   hh:width-chars = 2.5 .
     3564                               end.
     3565                           when "b-print" then
     3566                               do:
     3567                                   hh:load-image("cmp/b-print.bmp":u) .
     3568                                   hh:TOOLTIP = "Печать" .
     3569                                   v-h[ii] = hh:handle .
     3570                                   ii = ii + 1 .
     3571                                   hh:width-chars = 3 .
     3572                               end.
     3573                           when "b-history" or
     3574                           when "b-hist" then
     3575                               do:
     3576                                   hh:load-image("cmp/b-hist.bmp":u) .
     3577                                   hh:TOOLTIP = "История" .
     3578                                   v-h[ii] = hh:handle .
     3579                                   ii = ii + 1 .
     3580                                   hh:width-chars = 3 .
     3581                               end.
     3582                           when "b-sch" then
     3583                               do:
     3584                                   hh:load-image("cmp/b-sch.bmp":u) .
     3585                                   hh:TOOLTIP = "Установка Фильтра" .
     3586                                   v-h[ii] = hh:handle .
     3587                                   ii = ii + 1 .
     3588                                   hh:width-chars = 3 .
     3589                               end.
     3590                           when "b-hist-user" then
     3591                               do:
     3592                                   hh:load-image("cmp/b-hist.bmp":u) .
     3593                                   hh:TOOLTIP = "История пользователя" .
     3594                                   ii = ii + 1 .
     3595                               end.
     3596                       end case.
     3597                   end.
     3598                   hh = hh:next-sibling.
     3599               end.
     3600               b-help:column = v-frame-width - b-help:width-chars.
     3601               jj = 0.
     3602               repeat ii = 4 to 1 by -1 :
     3603                   if valid-handle (v-h[ii] ) then
     3604                   do:
     3605                       jj  = jj + 1 .
     3606                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3607                       v-h[ii]:row    = v-help-old-y .
     3608                   end.
     3609               end.
     3610           end.
     3611       end.
     3612   end procedure.
     3613   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3614   on ' ' of date_from in frame Dialog-Frame
     3615   do:
     3616     if (can-query (self, "sensitive")
     3617        and
     3618        self :sensitive = true
     3619        )
     3620     or (can-query (self, "read-only")
     3621        and
     3622        self :read-only = false
     3623        )
     3624     then do:
     3625       assign
     3626         self :screen-value = ?
     3627       .
     3628     end.
     3629     return no-apply.
     3630   end.
     3631   on delete-character of date_from in frame Dialog-Frame
     3632   do:
     3633     if (can-query (self, "sensitive")
     3634        and
     3635        self :sensitive = true
     3636        )
     3637     or (can-query (self, "read-only")
     3638        and
     3639        self :read-only = false
     3640        )
     3641     then do:
     3642       assign
     3643         self :screen-value = ?
     3644       .
     3645     end.
     3646     return no-apply.
     3647   end.
     3648   on ctrl-d of date_from in frame Dialog-Frame
     3649   do:
     3650     define variable v-curr-sv-date as date no-undo .
     3651     if (can-query (self, "sensitive")
     3652        and
     3653        self :sensitive = true
     3654        )
     3655     or (can-query (self, "read-only")
     3656        and
     3657        self :read-only = false
     3658        )
     3659     then do:
     3660       if self :handle <> focus :handle
     3661       then do:
     3662         apply "entry":u to self .
     3663       end.
     3664       run gbl/getcurdt.p
     3665         (output v-curr-sv-date
     3666         ) .
     3667       assign
     3668         self :screen-value = string(v-curr-sv-date) .
     3669       .
     3670     end.
     3671     return no-apply.
     3672   end.
     3673   on ctrl-b of date_from in frame Dialog-Frame
     3674   do:
     3675     if (can-query (self, "sensitive")
     3676        and
     3677        self :sensitive = true
     3678        )
     3679     or (can-query (self, "read-only")
     3680        and
     3681        self :read-only = false
     3682        )
     3683     then do:
     3684       if self :handle <> focus :handle
     3685       then do:
     3686         apply "entry":u to self .
     3687       end.
     3688       define variable v-curr-sv-date as date no-undo .
     3689       define variable v-new-sv-date  as date no-undo .
     3690       assign
     3691         v-curr-sv-date = date(self :screen-value) no-error
     3692       .
     3693       if v-curr-sv-date = ?
     3694       then do:
     3695         run gbl/getcurdt.p
     3696           (output v-curr-sv-date
     3697           ) .
     3698       end.
     3699       if v-curr-sv-date <> ?
     3700       then do:
     3701         assign
     3702           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     3703         .
     3704         assign
     3705           self :screen-value = string(v-new-sv-date) .
     3706         .
     3707       end.
     3708     end.
     3709     return no-apply .
     3710   end.
     3711   on ctrl-e of date_from in frame Dialog-Frame
     3712   do:
     3713     if (can-query (self, "sensitive")
     3714        and
     3715        self :sensitive = true
     3716        )
     3717     or (can-query (self, "read-only")
     3718        and
     3719        self :read-only = false
     3720        )
     3721     then do:
     3722       if self :handle <> focus :handle
     3723       then do:
     3724         apply "entry":u to self .
     3725       end.
     3726       define variable v-curr-sv-date as date no-undo .
     3727       define variable v-new-sv-date  as date no-undo .
     3728       assign
     3729         v-curr-sv-date = date(self :screen-value) no-error
     3730       .
     3731       if v-curr-sv-date = ?
     3732       then do:
     3733         run gbl/getcurdt.p
     3734           (output v-curr-sv-date
     3735           ) .
     3736       end.
     3737       if v-curr-sv-date <> ?
     3738       then do:
     3739         run gbl/lastdate.p
     3740           (input  v-curr-sv-date
     3741           ,output v-new-sv-date
     3742           ).
     3743         assign
     3744           self :screen-value = string(v-new-sv-date) .
     3745         .
     3746       end.
     3747     end.
     3748     return no-apply .
     3749   end.
     3750   on ctrl-f of date_from in frame Dialog-Frame
     3751   do:
     3752     if (can-query (self, "sensitive")
     3753        and
     3754        self :sensitive = true
     3755        )
     3756     or (can-query (self, "read-only")
     3757        and
     3758        self :read-only = false
     3759        )
     3760     then do:
     3761       if self :handle <> focus :handle
     3762       then do:
     3763         apply "entry":u to self .
     3764       end.
     3765       define variable v-ok            as logical   no-undo .
     3766       define variable v-curr-sv-date  as date      no-undo .
     3767       define variable v-description   as character no-undo .
     3768       assign
     3769         v-curr-sv-date = date(self :screen-value) no-error
     3770       .
     3771       if v-curr-sv-date = ?
     3772       then do:
     3773         run gbl/getcurdt.p
     3774           (output v-curr-sv-date
     3775           ) .
     3776       end.
     3777       if v-curr-sv-date <> ?
     3778       then do:
     3779         run gbl/d-inpday.w
     3780           (input ?
     3781           ,input "Выбор даты"
     3782           ,input v-description
     3783           ,input ""
     3784           ,input-output v-curr-sv-date
     3785           ,output v-ok
     3786           ).
     3787         if v-ok = true
     3788         then do:
     3789           assign
     3790             self :screen-value = string(v-curr-sv-date) .
     3791           .
     3792         end.
     3793       end.
     3794     end.
     3795     return no-apply .
     3796   end.
