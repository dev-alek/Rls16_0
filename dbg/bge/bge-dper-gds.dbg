     4171               ed-doc-type :screen-value = chr(10) + "    Все"
     4172           .
     4173           hide
     4174               tb-supp
     4175               bt-sel-doc-type
     4176               tb-inkass-pay-code
     4177               tb-cst-code
     4178               tb-parts
     4179               tb-chk-pay-code
     4180               tb-pay-desk
     4181               tb-pay-desk-cards
     4182               tb-deleted
     4183               date_from
     4184               RECT-2
     4185               ed-doc-type
     4186               ed-doc-type-label
     4187           .
     4188           if p-output-type = 5
     4189           then do:
     4190               hide
     4191                   date_to
     4192               .
     4193               view
     4194                   RECT-1
     4195                   rs-1
     4196                   bt-sel-obj
     4197                   ed-object
     4198               .
     4199               assign
     4200                   frame Dialog-Frame :title = "Выбор объектов для экспорта"
     4201               .
     4202           end.
     4203       end.
     4204       run init-fields in this-procedure .
     4205       WAIT-FOR GO OF FRAME Dialog-Frame.
     4206   END.
     4207   RUN disable_UI.
     4208   PROCEDURE disable_UI :
     4209     HIDE FRAME Dialog-Frame.
     4210   END PROCEDURE.
     4211   PROCEDURE enable_UI :
     4212     DISPLAY date_from date_to ed-object rs-1 ed-doc-type ed-doc-type-label
     4213             tb-inkass-pay-code tb-deleted tb-cst-code tb-exp-checks tb-parts
     4214             tb-chk-pay-code rs-cash-pay tb-pay-desk tb-pay-desk-cards
     4215             ed-doc-type-label-2 rs-2
     4216         WITH FRAME Dialog-Frame.
     4217     ENABLE RECT-2 RECT-1 RECT-3 RECT-5 Btn_OK Btn_Cancel b-help date_from date_to
     4218            rs-1 bt-sel-obj ed-doc-type bt-sel-doc-type tb-inkass-pay-code
     4219            tb-deleted tb-cst-code tb-exp-checks tb-parts tb-chk-pay-code
     4220            rs-cash-pay tb-pay-desk bt-cash-pay tb-pay-desk-cards rs-2
     4221         WITH FRAME Dialog-Frame.
     4222     VIEW FRAME Dialog-Frame.
     4223   END PROCEDURE.
     4224   PROCEDURE flt-load :
     4225     define variable v-obj-range      as integer   no-undo .
     4226     define variable v-obj-list       as character no-undo .
     4227     define variable v-doc-range      as integer   no-undo .
     4228     define variable v-doc-list       as character no-undo .
     4229     define variable v-userid         as character no-undo .
     4230     define variable v-naim           as character no-undo .
     4231     define variable v-list           as character no-undo .
     4232     define variable v-print-graft    as logical   no-undo .
     4233     define variable v-sort-gr        as logical   no-undo .
     4234     define variable v-type-price     as logical   no-undo .
     4235     define variable v-type-val       as logical   no-undo .
     4236     define variable v-found          as logical   no-undo .
     4237     define variable v-str            as character no-undo .
     4238     define variable v-obj-tot        as integer   no-undo .
     4239     define variable v-i              as integer   no-undo .
     4240     define variable v-obj-type       as character no-undo .
     4241     define variable v-obj-code       as integer   no-undo .
     4242   do
     4243   on error undo, return error return-value
     4244   :
     4245     run uf-get (
     4246         input   'bge-dper.w':U
     4247       , input   v-cntxt-userid
     4248       , output  v-list
     4249       , output  v-naim
     4250       , output  v-print-graft
     4251       , output  v-sort-gr
     4252       , output  v-type-price
     4253       , output  v-type-val
     4254       ) .
     4255     if num-entries(v-naim) = 11
     4256     then do:
     4257       assign
     4258         date_from           = date(    entry( 1, v-naim ) )
     4259         date_to             = date(    entry( 2, v-naim ) )
     4260         tb-chk-pay-code     = logical( entry( 3, v-naim ) )
     4261         tb-cst-code         = logical( entry( 4, v-naim ) )
     4262         tb-deleted          = logical( entry( 5, v-naim ) )
     4263         tb-exp-checks       = logical( entry( 6, v-naim ) )
     4264         tb-inkass-pay-code  = logical( entry( 7, v-naim ) )
     4265         tb-parts            = logical( entry( 8, v-naim ) )
     4266         tb-pay-desk         = logical( entry( 9, v-naim ) )
     4267         tb-pay-desk-cards   = logical( entry(10, v-naim ) )
     4268         tb-supp             = logical( entry(11, v-naim ) )
     4269       .
     4270       if tb-chk-pay-code = yes
     4271       then do:
     4272         enable
     4273           tb-pay-desk
     4274           tb-pay-desk-cards
     4275         with frame Dialog-Frame.
     4276       end.
     4277       display
     4278         date_from
     4279         date_to
     4280         tb-chk-pay-code
     4281         tb-cst-code
     4282         tb-deleted
     4283         tb-exp-checks
     4284         tb-inkass-pay-code
     4285         tb-parts
     4286         tb-pay-desk
     4287         tb-pay-desk-cards
     4288         tb-supp           when p-output-type = 2
     4289       with frame Dialog-Frame.
     4290     end.
     4291     if num-entries(v-list,';') = 2
     4292     then do:
     4293       assign
     4294         v-str = entry( 1 , v-list, ';')
     4295       .
     4296       if num-entries(v-str,':') = 2
     4297       then do:
     4298         assign
     4299           rs-1        = integer(entry(1, v-str, ':'))
     4300           v-obj-list  = entry(2, v-str, ':')
     4301           v-obj-tot   = num-entries(v-obj-list)
     4302         .
     4303         if rs-1 = 3 and v-obj-tot < 2
     4304         then do:
     4305           assign
     4306             rs-1 = 1
     4307           .
     4308         end.
     4309         run object-select in this-procedure .
     4310         display
     4311           rs-1
     4312         with frame Dialog-Frame.
     4313         if rs-1 = 3
     4314         then do:
     4315           if v-obj-tot modulo 2 = 0
     4316           then do:
     4317             for each temp_obj-list
     4318             :
     4319               delete temp_obj-list.
     4320             end.
     4321             do v-i = 1 to v-obj-tot / 2
     4322             :
     4323               assign
     4324                 v-obj-type = entry( v-i * 2 - 1, v-obj-list )
     4325                 v-obj-code = integer( entry( v-i * 2, v-obj-list ) )
     4326               .
     4327               find first temp_obj-list no-lock
     4328                 where temp_obj-list.obj-type = v-obj-type
     4329                   and temp_obj-list.obj-code = v-obj-code
     4330               no-error .
     4331               if not available temp_obj-list
     4332               then do:
     4333                 create temp_obj-list.
     4334                 assign
     4335                   temp_obj-list.obj-type = v-obj-type
     4336                   temp_obj-list.obj-code = v-obj-code
     4337                 .
     4338               end.
     4339             end.
     4340             assign
     4341               ed-object :screen-value in frame Dialog-Frame = v-obj-list
     4342             .
     4343           end.
     4344         end.
     4345       end.
     4346       assign
     4347         v-str = entry( 2 , v-list, ';')
     4348       .
     4349       if v-str = ''
     4350       then do:
     4351         assign
     4352           ed-doc-type = "Все":u
     4353         .
     4354       end.
     4355       else do:
     4356         assign
     4357           ed-doc-type = ''
     4358         .
     4359         for each temp_ext-doc-type
     4360         :
     4361           if lookup( temp_ext-doc-type.ext-doc-type, v-str ) <> 0
     4362           then do:
     4363             assign
     4364               ed-doc-type = ed-doc-type + temp_ext-doc-type.ext-doc-type-label + chr(10)
     4365               p-doc-type-list = p-doc-type-list + temp_ext-doc-type.ext-doc-type + ','
     4366             .
     4367           end.
     4368         end.
     4369         assign
     4370           p-doc-type-list = trim(p-doc-type-list , ',')
     4371         .
     4372       end.
     4373       display
     4374         ed-doc-type
     4375       with frame Dialog-Frame.
     4376     end.
     4377   end.
     4378   END PROCEDURE.
     4379   PROCEDURE flt-save :
     4380     define variable v-obj-range      as integer   no-undo .
     4381     define variable v-obj-list       as character no-undo .
     4382     define variable v-doc-range      as integer   no-undo .
     4383     define variable v-doc-list       as character no-undo .
     4384     define variable v-userid         as character no-undo .
     4385     define variable v-naim           as character no-undo .
     4386     define variable v-list           as character no-undo .
     4387     define variable v-print-graft    as logical   no-undo .
     4388     define variable v-sort-gr        as logical   no-undo .
     4389     define variable v-type-price     as logical   no-undo .
     4390     define variable v-type-val       as logical   no-undo .
     4391   do
     4392   on error undo, return error return-value
     4393   :
     4394     assign frame Dialog-Frame
     4395       date_from
     4396       date_to
     4397       tb-chk-pay-code
     4398       tb-cst-code
     4399       tb-deleted
     4400       tb-exp-checks
     4401       tb-inkass-pay-code
     4402       tb-parts
     4403       tb-pay-desk
     4404       tb-pay-desk-cards
     4405       tb-supp
     4406       rs-1
     4407       rs-2
     4408     .
     4409     case rs-1 :screen-value
     4410     :
     4411     when "1"
     4412     then do:
     4413         assign
     4414             v-obj-range = 1
     4415             v-obj-list = ""
     4416         .
     4417     end.
     4418     when "2"
     4419     then do:
     4420         assign
     4421             v-obj-range = 2
     4422             v-obj-list = ""
     4423         .
     4424     end.
     4425     when "3"
     4426     then do:
     4427         assign
     4428             v-obj-range = 3
     4429             v-obj-list = ""
     4430         .
     4431         for each temp_obj-list
     4432         :
     4433             assign
     4434                 v-obj-list = v-obj-list
     4435                         + ( if v-obj-list = "" then "" else "," ) + temp_obj-list.obj-type
     4436                         + "," + string( temp_obj-list.obj-code )
     4437             .
     4438         end.
     4439     end.
     4440     end case.
     4441     assign
     4442       v-naim       = string(date_from         ) + "," +
     4443                      string(date_to           ) + "," +
     4444                      string(tb-chk-pay-code   ) + "," +
     4445                      string(tb-cst-code       ) + "," +
     4446                      string(tb-deleted        ) + "," +
     4447                      string(tb-exp-checks     ) + "," +
     4448                      string(tb-inkass-pay-code) + "," +
     4449                      string(tb-parts          ) + "," +
     4450                      string(tb-pay-desk       ) + "," +
     4451                      string(tb-pay-desk-cards ) + "," +
     4452                      string(tb-supp           )
     4453       v-list       = substitute( "&1:&2;&3"
     4454                                , v-obj-range
     4455                                , v-obj-list
     4456                                , p-doc-type-list
     4457                                )
     4458     .
     4459     run uf-set ( input 'bge-dper.w':U
     4460                , input v-cntxt-userid
     4461                , input v-list
     4462                , input v-naim
     4463                , input v-print-graft
     4464                , input v-sort-gr
     4465                , input v-type-price
     4466                , input v-type-val
     4467                ) .
     4468   end.
     4469   END PROCEDURE.
     4470   PROCEDURE get-host-name :
     4471   do
     4472   on error undo, return error
     4473   :
     4474   define output parameter p-host-name as character    no-undo.
     4475   define buffer buf_clients   for ub.clients.
     4476       find first buf_clients no-lock
     4477            where buf_clients.obj-type = 'орг':U
     4478              and buf_clients.obj-code = v-bge-dper-host-code
     4479       no-error.
     4480       if not available buf_clients
     4481       then do:
     4482           message
     4483             vss-workfile vss-revision vss-description
     4484             skip "Не удалось найти текущую фирму"
     4485             skip return-value
     4486             skip trim(error-status :get-message(1))
     4487                  trim(error-status :get-message(2))
     4488                  trim(error-status :get-message(3))
     4489                  trim(error-status :get-message(4))
     4490                  trim(error-status :get-message(5))
     4491           view-as alert-box error.
     4492           undo, return error .
     4493       end.
     4494       else do:
     4495           assign
     4496               p-host-name = buf_clients.obj-name
     4497           .
     4498       end.
     4499   end.
     4500   END PROCEDURE.
     4501   PROCEDURE init-fields :
     4502   do
     4503   on error undo, return error
     4504   :
     4505       define variable v-oper-num     as integer           no-undo.
     4506       run manage-tb-chk-pay-code in this-procedure.
     4507       assign
     4508           p-doc-type-list = p-init-doc-type-list
     4509       .
     4510       assign
     4511           rs-1 :screen-value in frame dialog-frame = "2"
     4512           ed-object :screen-value in frame Dialog-frame = 'орг':U + string( v-bge-dper-host-code ) + " " + v-host-name
     4513       .
     4514       assign
     4515           rs-1
     4516       .
     4517       if p-init-doc-type-list <> ?
     4518       and p-init-doc-type-list <> ''
     4519       then do:
     4520           for each temp_ext-doc-type
     4521           :
     4522               if lookup( temp_ext-doc-type.ext-doc-type, p-init-doc-type-list ) <> 0
     4523               then do:
     4524                   assign
     4525                       ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
     4526                                                   + temp_ext-doc-type.ext-doc-type-label + chr(10)
     4527                   .
     4528               end.
     4529           end.
     4530       end.
     4531       assign
     4532         date_to = today
     4533       .
     4534       display
     4535         date_to
     4536       with frame Dialog-Frame.
     4537       run flt-load in this-procedure .
     4538   end.
     4539   END PROCEDURE.
     4540   PROCEDURE manage-tb-chk-pay-code :
     4541   do
     4542   on error undo, return error
     4543   :
     4544       if tb-chk-pay-code = yes
     4545       then do:
     4546           assign
     4547               tb-pay-desk :sensitive in frame Dialog-Frame = yes
     4548               tb-pay-desk-cards :sensitive in frame Dialog-Frame = yes
     4549           .
     4550       end.
     4551       else do:
     4552           assign
     4553               tb-pay-desk :sensitive in frame Dialog-Frame = no
     4554               tb-pay-desk-cards :sensitive in frame Dialog-Frame = no
     4555           .
     4556       end.
     4557   end.
     4558   END PROCEDURE.
     4559   PROCEDURE object-select :
     4560   do
     4561   on error undo, return error
     4562   :
     4563   case rs-1 :screen-value in frame Dialog-frame
     4564   :
     4565       when "1"
     4566       then do:
     4567           assign
     4568               ed-object :screen-value = ""
     4569           .
     4570       end.
     4571       when "2"
     4572       then do:
     4573           assign
     4574               ed-object :screen-value = v-host-name
     4575           .
     4576       end.
     4577       when "3"
     4578       then do:
     4579           for each temp_obj-list
     4580           :
     4581               delete temp_obj-list.
     4582           end.
     4583           create temp_obj-list.
     4584           assign
     4585               temp_obj-list.obj-type  = v-bge-dper-store-type
     4586               temp_obj-list.obj-code  = v-bge-dper-store-code
     4587               ed-object :screen-value = v-bge-dper-store-type + string( v-bge-dper-store-code )
     4588           .
     4589       end.
     4590   end case.
     4591   end.
     4592   END PROCEDURE.
