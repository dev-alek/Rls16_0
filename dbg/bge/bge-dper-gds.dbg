     2753   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
     2754   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
     2755   procedure uf-name :
     2756     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     2757     define output parameter p-use-List_     as logical   no-undo .
     2758     define output parameter p-type-List_     as character no-undo .
     2759     define output parameter p-format-List_   as character no-undo .
