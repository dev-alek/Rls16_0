     3961       then do:
     3962         run gbl/lastdate.p
     3963           (input  v-curr-sv-date
     3964           ,output v-new-sv-date
     3965           ).
     3966         assign
     3967           self :screen-value = string(v-new-sv-date) .
     3968         .
     3969       end.
     3970     end.
     3971     return no-apply .
     3972   end.
     3973   on ctrl-f of date_to in frame Dialog-Frame
     3974   do:
     3975     if (can-query (self, "sensitive")
     3976        and
     3977        self :sensitive = true
     3978        )
     3979     or (can-query (self, "read-only")
     3980        and
     3981        self :read-only = false
     3982        )
     3983     then do:
     3984       if self :handle <> focus :handle
     3985       then do:
     3986         apply "entry":u to self .
     3987       end.
     3988       define variable v-ok            as logical   no-undo .
     3989       define variable v-curr-sv-date  as date      no-undo .
     3990       define variable v-description   as character no-undo .
     3991       assign
     3992         v-curr-sv-date = date(self :screen-value) no-error
     3993       .
     3994       if v-curr-sv-date = ?
     3995       then do:
     3996         run gbl/getcurdt.p
     3997           (output v-curr-sv-date
     3998           ) .
     3999       end.
     4000       if v-curr-sv-date <> ?
     4001       then do:
     4002         run gbl/d-inpday.w
     4003           (input ?
     4004           ,input "Выбор даты"
     4005           ,input v-description
     4006           ,input ""
     4007           ,input-output v-curr-sv-date
     4008           ,output v-ok
     4009           ).
     4010         if v-ok = true
     4011         then do:
     4012           assign
     4013             self :screen-value = string(v-curr-sv-date) .
     4014           .
     4015         end.
     4016       end.
     4017     end.
     4018     return no-apply .
     4019   end.
     4020     define MENU m-ed-date17
     4021       MENU-ITEM m-ed-date17-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     4022       MENU-ITEM m-ed-date17-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     4023       MENU-ITEM m-ed-date17-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     4024       MENU-ITEM m-ed-date17-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
