      120     run proc-alt-shift-f3 in this-procedure .
      121   end.
      122   on alt-shift-f4 anywhere do:
      123     run proc-alt-shift-f4 in this-procedure.
      124   end.
      125   on alt-f1 anywhere do:
      126     run proc-alt-f1 in this-procedure .
      127   end.
      128   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   define  shared variable g#auto-pid           as integer   no-undo .
      131   define  shared variable conn-par             as character no-undo .
      132   define  shared variable g#auto-user-id       as character no-undo .
      133   define  shared variable g#auto-user-login    as character no-undo .
      134   define  shared variable g#auto-user-password as character no-undo .
      135   define  shared variable v-socket             as logical   no-undo .
      136   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137   define  shared variable auto-window-h     as handle    no-undo .
      138   define  shared variable auto-log-msg-h    as handle    no-undo .
      139   define  shared variable hand-log-msg-h    as handle    no-undo .
      140   define  shared variable log-file-name     as character no-undo initial ? .
      141   define  shared variable add-log-file-name as character no-undo initial ? .
      142   define  shared variable writelogvalue     as character no-undo initial ? .
      143   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      144   procedure cur-time :
      145      define output parameter p-today as date      no-undo .
      146      define output parameter p-time  as integer   no-undo .
      147     do
      148     on error undo, return error
      149     :
      150       define variable v-date1 as date      no-undo .
      151       define variable v-date2 as date      no-undo .
      152       define variable v-time  as integer   no-undo .
      153       assign
      154         v-date1 = today
      155         v-time  = time
      156         v-date2 = today
      157       .
      158       if v-date1 <> v-date2
      159       then do:
      160         assign
      161           v-date1 = today
      162           v-time  = v-time
      163         .
      164       end.
      165       assign
      166         p-today = v-date1
      167         p-time  = v-time
      168       .
      169     end.
      170   end.
      171   function cur-time-date returns character
      172   :
      173     return string(today, '99/99/9999':U) .
      174   end.
      175   function cur-time-mjd returns decimal
      176   :
      177     define variable v-date as date      no-undo .
      178     define variable v-time as integer   no-undo .
      179     run cur-time in this-procedure
      180       (output v-date
      181       ,output v-time
      182       ) .
      183     return integer(v-date) - 2400002 + (v-time / 86400) .
      184   end.
      185   function cur-time-get-ending-index returns integer
      186   (input p-number as integer
      187   )
      188   :
      189     if p-number < 0
      190     or p-number = ?
      191     then do:
      192       return 1 .
      193     end.
      194     define variable v-rest as integer   no-undo .
      195     assign
      196       p-number = p-number modulo 100
      197     .
      198     if p-number < 20
      199     then do:
      200       assign
      201         v-rest = p-number
      202       .
      203     end.
      204     else do:
      205       assign
      206         v-rest = p-number modulo 10
      207       .
      208     end.
      209     case v-rest :
      210       when 1
      211       then do:
      212         return 2 .
      213       end.
      214       when 2 or
      215       when 3 or
      216       when 4
      217       then do:
      218         return 3 .
      219       end.
      220       otherwise do:
      221         return 1 .
      222       end.
      223     end case .
      224   end.
      225   procedure cur-time-mjd-to-date :
      226      define input  parameter i-mjd-diff as decimal no-undo.
      227      define output parameter o-Date     as date    no-undo.
      228      define output parameter o-Time     as integer no-undo.
      229      define variable v-day-number as integer   no-undo .
      230      if    i-mjd-diff < 0
      231         or i-mjd-diff = ?
      232      then do:
      233         return "?" .
      234      end.
      235      assign
      236         v-day-number = truncate(i-mjd-diff,0).
      237         o-Date = date(v-day-number + 2400002).
      238         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      239     .
      240   end.
      241   function cur-time-mjd-to-string returns character
      242   (input p-mjd-diff as decimal
      243   )
      244   :
      245     define variable v-day-number as integer   no-undo .
      246     define variable v-seconds    as integer   no-undo .
      247     define variable v-hour       as integer   no-undo .
      248     define variable v-min        as integer   no-undo .
      249     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      250     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      251     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      252     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      253     if p-mjd-diff < 0
      254     or p-mjd-diff = ?
      255     then do:
      256       return "?" .
      257     end.
      258     assign
      259       v-day-number = integer(truncate(p-mjd-diff,0))
      260       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      261     .
      262     if v-seconds > 86400
      263     then do:
      264       assign
      265         v-seconds = 86400 - 1
      266       .
      267     end.
      268     if v-seconds < 0
      269     then do:
      270       assign
      271         v-seconds = 0
      272       .
      273     end.
      274     assign
      275       v-hour = truncate(v-seconds / 3600, 0)
      276     .
      277     assign
      278       v-seconds = v-seconds modulo 3600
      279     .
      280     assign
      281       v-min = truncate(v-seconds / 60, 0)
      282     .
      283     assign
      284       v-seconds = v-seconds modulo 60
      285     .
      286     return
      287         (if v-day-number <> 0
      288           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      289           else ""
      290         )
      291       + (if v-day-number <> 0 or v-hour <> 0
      292           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      293           else ""
      294         )
      295       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      296           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      297           else ""
      298         )
      299       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      300       .
      301   end.
      302   function cur-time-string returns character
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      311   end.
      312   function cur-time-string-sec returns character
      313   :
      314     define variable v-date as date      no-undo .
      315     define variable v-time as integer   no-undo .
      316     run cur-time in this-procedure
      317       (output v-date
      318       ,output v-time
      319       ) .
      320     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      321   end.
      322   function cur-time-custom  returns character
      323   (input p-prefix as character
      324   ,input p-date-format as character
      325   ,input p-delimiter as character
      326   ,input p-time-format as character
      327   ,input p-suffix as character
      328   )
      329   :
      330     define variable v-date as date      no-undo .
      331     define variable v-time as integer   no-undo .
      332     run cur-time in this-procedure
      333       (output v-date
      334       ,output v-time
      335       ) .
      336     return
      337       p-prefix
      338       + string(v-date, p-date-format)
      339       + p-delimiter
      340       + string(v-time, p-time-format)
      341       + p-suffix
      342       .
      343   end.
      344   function cur-time-print  returns character
      345   :
      346     define variable v-date as date      no-undo .
      347     define variable v-time as integer   no-undo .
      348     run cur-time in this-procedure
      349       (output v-date
      350       ,output v-time
      351       ) .
      352     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      353   end.
      354   function cur-time-datetime returns datetime
      355   :
      356     define variable v-char as character no-undo .
      357     define variable v-datetime as datetime no-undo .
      358     v-char = cur-time-string().
      359     v-datetime = datetime(v-char).
      360     return  v-datetime.
      361   end.
      362   function cur-time-string-msec returns character
      363   :
      364     define variable v-date as datetime  no-undo .
      365     v-date = now.
      366     return string(v-date) .
      367   end.
      368   define stream LogStream .
      369   define variable mNoTime as logical no-undo.
      370   procedure write-to-log-notime :
      371     define input param i-str as character no-undo .
      372     mNoTime = yes.
      373     run write-to-log (i-str).
      374     mNoTime = no.
      375   end.
      376   procedure write-to-log :
      377     define input param p-str as character no-undo .
      378     do
      379     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      380     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      381     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      382     :
      383       define variable log-res        as logical   no-undo .
      384       define variable v-jj           as integer   no-undo .
      385       if    mNoTime
      386          or writelogvalue eq "AsyncProc"
      387       then
      388          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      389       else
      390          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      391       if auto-log-msg-h <> ? then do:
      392         log-res = auto-log-msg-h:move-to-eof( ) .
      393         log-res = auto-log-msg-h:insert-string( p-str ).
      394       end.
      395       if hand-log-msg-h <> ? then do:
      396         log-res = hand-log-msg-h:move-to-eof( ) .
      397         log-res = hand-log-msg-h:insert-string( p-str ).
      398       end.
      399       assign
      400         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      401         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      402         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      403       .
      404       if add-log-file-name <> ? then do:
      405         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      406           run gbl/fileapnd.p
      407             ( input entry(v-jj, add-log-file-name, chr(1) )
      408             ,input p-str
      409             ,input 20
      410             ) no-error .
      411           if error-status:error then do:
      412             return error return-value .
      413           end.
      414         end.
      415       end.
      416       if writelogvalue eq "AsyncProc"
      417       then do:
      418          p-str = trim(p-str, (chr(13) + chr(10)) )
      419       .
      420          Publish "WriteLogAsunc" (p-str,yes).
      421       end.
      422       else if writelogvalue <> "yes" then do:
      423         run gbl/fileapnd.p
      424           ( input log-file-name
      425           ,input p-str
      426           ,input 20
      427           ) no-error .
      428         if error-status:error then do:
      429           return error return-value .
      430         end.
      431       end.
      432     end.
      433   end procedure.
      434   procedure write-to-screen :
      435     define input param p-str as character no-undo .
      436     do
      437     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      438     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      439     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      440     :
      441       define variable log-res as logical no-undo.
      442       assign
      443         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      444       .
      445       if auto-log-msg-h <> ?
      446       then do:
      447         log-res = auto-log-msg-h:move-to-eof( ) .
      448         log-res = auto-log-msg-h:insert-string( p-str ).
      449       end.
      450       if hand-log-msg-h <> ?
      451       then do:
      452         log-res = hand-log-msg-h:move-to-eof( ) .
      453         log-res = hand-log-msg-h:insert-string( p-str ).
      454       end.
      455     end.
      456   end procedure.
      457   procedure send-msg-to-email :
      458     define input  parameter p-subject      as character no-undo .
      459     define input  parameter p-text-err     as character no-undo .
      460     define input  parameter p-attach-files as character no-undo .
      461     do
      462     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      463     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      464     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      465     :
      466       define variable v-tth             as handle    no-undo .
      467       define variable v-value-character as character no-undo .
      468       define variable v-value-date      as date      no-undo .
      469       define variable v-value-decimal   as decimal   no-undo .
      470       define variable v-value-integer   as integer   no-undo .
      471       define variable v-value-logical   as logical   no-undo .
      472       define variable v-param-type      as character no-undo .
      473       define variable v-email       as character no-undo .
      474       define variable v-tmp-str     as character no-undo .
      475       define variable v-tmp1-str    as character no-undo .
      476       define variable v-ind         as integer   no-undo .
      477       define variable v-num-entries as integer   no-undo .
      478       delete object v-tth no-error.
      479       run adm/shattri.p
      480         ( input "get":U
      481          ,input  "":U
      482          ,input  0
      483          ,input  'auto-task':U
      484          ,input  'send-msg-to-email':U
      485          ,output v-value-character
      486          ,output v-value-date
      487          ,output v-value-decimal
      488          ,output v-value-integer
      489          ,output v-value-logical
      490          ,output v-param-type
      491          ,input-output table-handle v-tth
      492         ) no-error .
      493       if not error-status :error  then do:
      494         assign
      495           v-tmp-str = v-value-character
      496         .
      497       end.
      498       delete object v-tth no-error.
      499       assign
      500         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      501         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      502         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      503         v-num-entries = num-entries( v-tmp-str, chr(44) )
      504         v-email       = "":U
      505       .
      506       do v-ind = 1 to v-num-entries
      507       :
      508         assign
      509           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      510         .
      511         if trim( v-tmp1-str ) <> "":U then do:
      512           if v-email = "":U then do:
      513             assign
      514               v-email = v-tmp1-str
      515             .
      516           end.
      517           else do:
      518             assign
      519               v-email = v-email + chr(44) + v-tmp1-str
      520             .
      521           end.
      522         end.
      523       end.
      524       if v-email <> "":U then do:
      525         run gbl/sendmail.p
      526           ( input v-email
      527           , input p-subject
      528           , input p-text-err
      529           , input p-attach-files
      530           ) no-error .
      531         if error-status :error
      532           or return-value <> "":U
      533         then do:
      534           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      535         end.
      536       end.
      537     end.
      538   end procedure.
      539   define  shared variable oxml-exch-dir as character no-undo .
      540   define  shared variable oxml-heap-dir as character no-undo .
      541   define variable err-mess as character no-undo .
      542   define temp-table t-pck-conf no-undo
      543     field esys-id         as integer
      544     field db-num          as integer
      545     field current-db-num  as integer
      546     field pack-num        as integer
      547     field rcvd-recs       as integer
      548     field total-recs      as integer
      549     field sys-key         as character
      550     field src_db-key      as character
      551     field ver-num         as character
      552     field prev-crc        as character
      553     field actual-date     as date
      554     field actual-time-int as integer
      555   .
      556   define variable log-res as logical no-undo .
      557   define variable v-db-num as integer no-undo .
      558   define variable v-key-passed-date as date no-undo .
      559   define variable v-imp-err as character no-undo .
      560   define buffer buf_db for ub.db .
      561   define buffer buf_ext-system for ub.ext-system .
      562   define buffer buf_sys-ctrl for ub.sys-ctrl.
      563   DEFINE MENU MENU-b-other
      564          MENU-ITEM m_send-ora-rcpt LABEL "Квитанц. для ВС типа Oracle Retail".
      565   DEFINE BUTTON b-conf-pck DEFAULT
      566        LABEL "Под&тверд."
      567        SIZE 10 BY 1 TOOLTIP "Подтвердить пакет".
      568   DEFINE BUTTON b-create DEFAULT
      569        LABEL "Под&готовить новые"
      570        SIZE 20 BY 1 TOOLTIP "Подготовка новых пакетов для всех ВС"
      571        BGCOLOR 8 .
      572   DEFINE BUTTON b-get DEFAULT
      573        LABEL "При&нять"
      574        SIZE 10 BY 1 TOOLTIP "Принять почту не разбирая пакет".
      575   DEFINE BUTTON b-get-pck DEFAULT
      576        LABEL "&Принять/Разобрать"
      577        SIZE 20 BY 1 TOOLTIP "Принять и затем разобрать пришедшую почту".
      578   DEFINE BUTTON b-help
      579        LABEL "Помо&щь"
      580        SIZE 3 BY 1
      581        BGCOLOR 8 .
      582   DEFINE BUTTON b-imp-err DEFAULT
      583        LABEL "&Ошибки"
      584        SIZE 10 BY 1 TOOLTIP "Ошибки импорта по пакету".
      585   DEFINE BUTTON b-info DEFAULT
      586        LABEL "&Доп.инфо"
      587        SIZE 10 BY 1 TOOLTIP "Дополнительная информация о пакете".
      588   DEFINE BUTTON b-other DEFAULT
      589        LABEL "&Другое"
      590        SIZE 10 BY 1 TOOLTIP "Другие действия".
      591   DEFINE BUTTON b-packlist DEFAULT
      592        LABEL "&Сообщения"
      593        SIZE 16 BY 1 TOOLTIP "Список соббщений в отправленном пакете".
      594   DEFINE BUTTON b-proc-pck DEFAULT
      595        LABEL "&Разобрать"
      596        SIZE 10 BY 1 TOOLTIP "Только разобрать пакет, не принимая новых".
      597   DEFINE BUTTON b-quit AUTO-GO DEFAULT
      598        LABEL "Вы&ход "
      599        SIZE 10 BY 1 TOOLTIP "Выход из новостей"
      600        BGCOLOR 8 .
      601   DEFINE BUTTON b-send DEFAULT
      602        LABEL "&Отправить"
      603        SIZE 10 BY 1 TOOLTIP "Отправить конкретный пакет с его переформированием".
      604   DEFINE BUTTON b-send-all DEFAULT
      605        LABEL "Отпр. в&cе"
      606        SIZE 10 BY 1 TOOLTIP "Отправить все неподтвержденные пакеты с их переформированием".
      607   DEFINE BUTTON b-send-new DEFAULT
      608        LABEL "Отпр&авить новые"
      609        SIZE 20 BY 1 TOOLTIP "Отправка новых и некоторых неподтвержденных пакетов"
      610        BGCOLOR 8 .
      611   DEFINE BUTTON b-unsend DEFAULT
      612        LABEL "&Данные"
      613        SIZE 10 BY 1 TOOLTIP "Неотправленнная или неподтвержденая информация".
      614   DEFINE VARIABLE oxml-log AS CHARACTER INITIAL ?
      615        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL LARGE
      616        SIZE 98 BY 6 TOOLTIP "Просмотр файла с сообщениями о работе OpenXML"
      617        FONT 4 NO-UNDO.
      618   DEFINE QUERY br-esys FOR
      619         X_ext-system SCROLLING.
      620   DEFINE QUERY pck-rcvd FOR
      621         X_esys-pck-rcvd SCROLLING.
      622   DEFINE QUERY pck-sent FOR
      623         X_esys-pck-sent SCROLLING.
      624   DEFINE BROWSE br-esys
      625     QUERY br-esys DISPLAY
      626         X_ext-system.esys-id column-label "ВС"
      627   (X_ext-system.esys-type > integer('0':U)) column-label "Спец" format "+/"
      628   (X_ext-system.esys-have-export and X_ext-system.esys-db-num-exp = v-db-num)  column-label "Экспорт!в тек.БД" format "+/"
      629   (X_ext-system.esys-have-import and X_ext-system.esys-db-num-imp = v-db-num)  column-label "Импорт!в тек.БД" format "+/"
      630   X_ext-system.esys-name
      631       WITH SEPARATORS SIZE 50 BY 14.52 FIT-LAST-COLUMN TOOLTIP "Рабочие ВС".
      632   DEFINE BROWSE pck-rcvd
      633     QUERY pck-rcvd NO-LOCK DISPLAY
      634         X_esys-pck-rcvd.espr-pack-num COLUMN-LABEL "Номер" FORMAT ">>>>>>9":U
      635         X_esys-pck-rcvd.espr-rcvd COLUMN-LABEL "Подтв." FORMAT "yes/no":U
      636         v-imp-err COLUMN-LABEL "Ош." FORMAT "X(1)":U
      637         X_esys-pck-rcvd.espr-total-recs COLUMN-LABEL "Записей в пакете" FORMAT ">>>>>>>>>9":U
      638     X_esys-pck-rcvd.custom-pack-name COLUMN-LABEL "Имя пакета в ВС" FORMAT "X(255)":U WIDTH 30
      639       WITH NO-ASSIGN NO-ROW-MARKERS SEPARATORS SIZE 46.6 BY 6.52
      640            FONT 4
      641            TITLE "Полученные пакеты" FIT-LAST-COLUMN TOOLTIP "Полученные пакеты от данной ВС".
      642   DEFINE BROWSE pck-sent
      643     QUERY pck-sent NO-LOCK DISPLAY
      644         X_esys-pck-sent.esps-pack-num COLUMN-LABEL "Номер" FORMAT ">>>>>>9":U
      645         X_esys-pck-sent.esps-rcvd COLUMN-LABEL "Подтв." FORMAT "yes/no":U
      646         X_esys-pck-sent.esps-total-recs COLUMN-LABEL "Записей в пакете" FORMAT ">>>>>>>>>9":U
      647         X_esys-pck-sent.custom-pack-name COLUMN-LABEL "Имя пакета в ВС" FORMAT "X(255)":U WIDTH 30
      648       WITH NO-ASSIGN NO-ROW-MARKERS SEPARATORS SIZE 46.6 BY 7
      649            FONT 4
      650            TITLE "Отправленные пакеты" FIT-LAST-COLUMN TOOLTIP "Отправленные пакеты в данную ВС".
      651   DEFINE FRAME oxmlhand
      652        b-quit AT ROW 1 COL 1
      653        b-create AT ROW 1 COL 11
      654        b-packlist AT ROW 1 COL 77 WIDGET-ID 6
      655        b-help AT ROW 1 COL 95
      656        br-esys AT ROW 2 COL 1
      657        pck-sent AT ROW 2 COL 52
      658        b-send AT ROW 9 COL 52
      659        b-send-all AT ROW 9 COL 62
      660        b-conf-pck AT ROW 9 COL 72 WIDGET-ID 2
      661        b-info AT ROW 9 COL 86.8
      662        pck-rcvd AT ROW 10 COL 52 WIDGET-ID 100
      663        b-imp-err AT ROW 16.48 COL 87 WIDGET-ID 8
      664        b-get-pck AT ROW 16.52 COL 1
      665        b-send-new AT ROW 16.52 COL 21
      666        b-unsend AT ROW 16.52 COL 41
      667        b-get AT ROW 16.52 COL 52
      668        b-proc-pck AT ROW 16.52 COL 62
      669        b-other AT ROW 16.52 COL 72 WIDGET-ID 4
      670        oxml-log AT ROW 17.52 COL 1 NO-LABEL
      671        SPACE(0.29) SKIP(0.24)
      672       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      673            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      674            TITLE "".
      675   ASSIGN
      676          FRAME oxmlhand:SCROLLABLE       = FALSE.
      677   ASSIGN
      678          b-other:POPUP-MENU IN FRAME oxmlhand       = MENU MENU-b-other:HANDLE.
      679   ASSIGN
      680          oxml-log:READ-ONLY IN FRAME oxmlhand        = TRUE.
      681   ASSIGN
      682          pck-rcvd:HIDDEN  IN FRAME oxmlhand                = TRUE.
      683   ON WINDOW-CLOSE OF FRAME oxmlhand
      684   DO:
      685     APPLY "END-ERROR":U TO SELF.
      686   END.
      687   ON CHOOSE OF b-conf-pck IN FRAME oxmlhand
      688   DO:
      689       if not available X_ext-system then do:                 message                   "Не выбрана ВС."                   view-as alert-box information.                 return no-apply.               end.               find first buf_ext-system no-lock                 where buf_ext-system.esys-id = X_ext-system.esys-id                    and  buf_ext-system.db-num = X_ext-system.db-num                 no-error .               if not available buf_ext-system then do:                 message                   substitute( "ВС &1 удалена.", X_ext-system.esys-id )                   view-as alert-box information.                 run refresh-brws                   ( input yes ) .                 return no-apply.               end.
      690       if not available X_esys-pck-sent THEN do:
      691           message "Нет готовых пакетов." view-as alert-box .
      692           return no-apply.
      693       end.
      694      run bge/confepck.p (  INPUT parparentproc
      695                           ,INPUT p-log-handle
      696                           ,input log-file-name
      697                           ,INPUT NO
      698                           ,INPUT X_esys-pck-sent.esys-id
      699                           ,INPUT X_esys-pck-sent.db-num
      700                           ,INPUT X_esys-pck-sent.esps-cr-db-num
      701                           ,INPUT X_esys-pck-sent.esps-pack-num) NO-ERROR.
      702      IF ERROR-STATUS:ERROR THEN DO:
      703         MESSAGE
      704         ERROR-STATUS:get-message(1) SKIP
      705         RETURN-VALUE
      706         VIEW-AS ALERT-BOX.
      707      END.
      708      run refresh-brws in this-procedure ( input yes ).
      709   END.
      710   ON CHOOSE OF b-create IN FRAME oxmlhand
      711   DO:
      712     define variable v-message  as character no-undo .
      713     define variable v-err-code as integer   no-undo .
      714     run write-to-log ( substitute( "Подготовка новых пакетов." ) ).
      715     run bge/cnewxpck.p (
      716                        input substitute("&1,&2"
      717                                        ,X_ext-system.esys-id
      718                                        ,X_ext-system.db-num)
      719                      , output v-err-code
      720     ) no-error .
      721     if error-status:error
      722     then do:
      723       run write-to-log( substitute( "&1. ERROR!!! Ошибка при подготовке пакетов OpenXML &2&3&4"
      724                                     ,vss-workfile
      725                                     ,error-status:get-message(error-status:num-messages)
      726                                     ,chr(10)
      727                                     ,return-value
      728                                   )
      729                       ) .
      730     end.
      731     else do:
      732       assign
      733         v-message = return-value
      734       .
      735       if v-message <> "":U then do:
      736         run write-to-log ( substitute( "&1", v-message ) ).
      737       end.
      738       run write-to-log ( substitute( "Завершена подготовка новых пакетов." ) ).
      739     end.
      740     run refresh-brws in this-procedure  ( input yes ) .
      741   END.
      742   ON CHOOSE OF b-get IN FRAME oxmlhand
      743   DO:
      744     run esys-key in this-procedure ( input-output v-key-passed-date ) no-error.
      745     if error-status:error then return no-apply.
      746       if not available X_ext-system then do:                 message                   "Не выбрана ВС."                   view-as alert-box information.                 return no-apply.               end.               find first buf_ext-system no-lock                 where buf_ext-system.esys-id = X_ext-system.esys-id                    and  buf_ext-system.db-num = X_ext-system.db-num                 no-error .               if not available buf_ext-system then do:                 message                   substitute( "ВС &1 удалена.", X_ext-system.esys-id )                   view-as alert-box information.                 run refresh-brws                   ( input yes ) .                 return no-apply.               end.
      747       assign
      748       add-log-file-name = substring( log-file-name, 1, r-index( log-file-name, '.':u) - 1 ) + substitute( "-&1.log", X_ext-system.esys-id )
      749       .
      750       run bge/oxmlinx.p ( input parparentproc
      751                          ,input this-procedure:handle
      752                          ,input p-log-handle
      753                          ,input substitute("take,&1,&2,&3"
      754                                         ,v-db-num
      755                                         ,X_ext-system.esys-id
      756                                         ,X_ext-system.db-num
      757                                         )
      758                     ) no-error.
      759       if error-status:error then do:
      760         run write-to-log( vss-workfile + chr(32)
      761                           + substitute( "ERROR!!! Ошибка при приеме пакета данных из ВС &1"
      762                           ,X_ext-system.esys-id ) + chr(10)
      763                           + substitute( "&1", error-status:get-message(error-status:num-messages) ) + chr(10)
      764                           + substitute( "&1", return-value )
      765                         ) .
      766       end.
      767       assign
      768       add-log-file-name = ?
      769       .
      770       run refresh-brws in this-procedure ( input yes ).
      771   END.
      772   ON CHOOSE OF b-get-pck IN FRAME oxmlhand
      773   DO:
      774     run esys-key in this-procedure ( input-output v-key-passed-date ) no-error.
      775     if error-status:error then return no-apply.
      776    if not available X_ext-system then do:                 message                   "Не выбрана ВС."                   view-as alert-box information.                 return no-apply.               end.               find first buf_ext-system no-lock                 where buf_ext-system.esys-id = X_ext-system.esys-id                    and  buf_ext-system.db-num = X_ext-system.db-num                 no-error .               if not available buf_ext-system then do:                 message                   substitute( "ВС &1 удалена.", X_ext-system.esys-id )                   view-as alert-box information.                 run refresh-brws                   ( input yes ) .                 return no-apply.               end.
      777       assign
      778       add-log-file-name = substring( log-file-name, 1, r-index( log-file-name, '.':u) - 1 ) + substitute( "-&1.log", X_ext-system.esys-id )
      779       .
      780       run bge/oxmlinx.p ( input parparentproc
      781                          ,input this-procedure:handle
      782                          ,input p-log-handle
      783                          ,input substitute("take+analys,&1,&2,&3"
      784                                         ,v-db-num
      785                                         ,X_ext-system.esys-id
      786                                         ,X_ext-system.db-num)
      787                     ) no-error.
      788       if error-status:error then do:
      789         run write-to-log( vss-workfile + chr(32)
      790                           + substitute( "ERROR!!! Ошибка при приеме пакетов данных из ВС &1", X_ext-system.esys-id ) + chr(10)
      791                           + substitute( "&1", error-status:get-message(error-status:num-messages) ) + chr(10)
      792                           + substitute( "&1", return-value )
      793                         ) .
      794       end.
      795       assign
      796       add-log-file-name = ?
      797       .
      798       run refresh-brws in this-procedure ( input yes ).
      799   END.
      800   ON CHOOSE OF b-imp-err IN FRAME oxmlhand
      801   DO:
      802     run bge/pack-err.w ( input X_esys-pck-rcvd.esys-id
      803                         ,input X_esys-pck-rcvd.db-num
      804                         ,input X_esys-pck-rcvd.espr-cr-db-num
      805                         ,input X_esys-pck-rcvd.espr-pack-num
      806                   ) no-error.
      807   END.
      808   ON CHOOSE OF b-info IN FRAME oxmlhand
      809   DO:
      810     if not available X_ext-system then do:                 message                   "Не выбрана ВС."                   view-as alert-box information.                 return no-apply.               end.               find first buf_ext-system no-lock                 where buf_ext-system.esys-id = X_ext-system.esys-id                    and  buf_ext-system.db-num = X_ext-system.db-num                 no-error .               if not available buf_ext-system then do:                 message                   substitute( "ВС &1 удалена.", X_ext-system.esys-id )                   view-as alert-box information.                 run refresh-brws                   ( input yes ) .                 return no-apply.               end.
      811     run bge/packxinf.w ( input X_esys-pck-sent.esys-id
      812                         ,input X_esys-pck-sent.db-num
      813                         ,input X_esys-pck-sent.esps-cr-db-num
      814                         ,input X_esys-pck-sent.esps-pack-num
      815                   ) no-error.
      816   END.
      817   ON CHOOSE OF b-packlist IN FRAME oxmlhand
      818   DO:
      819       if not available X_esys-pck-sent THEN do:
      820           message "Не выбран пакет для просмотра." view-as alert-box .
      821           return no-apply.
      822       end.
      823       run bge/viewpack.w ( X_ext-system.esys-id
      824                           ,X_ext-system.db-num
      825                           ,X_esys-pck-sent.esps-cr-db-num
      826                           ,X_esys-pck-sent.esps-pack-num
      827                           ) no-error.
      828       run refresh-brws
      829         ( input yes )
      830       .
      831   END.
      832   ON CHOOSE OF b-proc-pck IN FRAME oxmlhand
      833   DO:
      834      if not available X_ext-system then do:                 message                   "Не выбрана ВС."                   view-as alert-box information.                 return no-apply.               end.               find first buf_ext-system no-lock                 where buf_ext-system.esys-id = X_ext-system.esys-id                    and  buf_ext-system.db-num = X_ext-system.db-num                 no-error .               if not available buf_ext-system then do:                 message                   substitute( "ВС &1 удалена.", X_ext-system.esys-id )                   view-as alert-box information.                 run refresh-brws                   ( input yes ) .                 return no-apply.               end.
      835     if not available X_esys-pck-rcvd then do:
      836       message
      837       "Отстутствует пакет для разбора"
      838       view-as alert-box .
      839       undo, return no-apply.
      840     end.
      841     assign
      842     add-log-file-name = substring( log-file-name, 1, r-index( log-file-name, '.':u) - 1 ) + substitute( "-&1.log", X_ext-system.esys-id )
      843     .
      844     run bge/oxmlinx.p ( input parparentproc
      845                         ,input this-procedure:handle
      846                         ,input p-log-handle
      847                         ,input substitute("analys,&1,&2,&3,&4,&5"
      848                                       ,v-db-num
      849                                       ,X_ext-system.esys-id
      850                                       ,X_ext-system.db-num
      851                                       ,X_esys-pck-rcvd.espr-cr-db-num
      852                                       ,X_esys-pck-rcvd.espr-pack-num
      853                                       )
      854                   ) no-error.
      855     if error-status:error then do:
      856       run write-to-log( vss-workfile + chr(32)
      857                         + substitute( "ERROR!!! Ошибка при приеме пакета данных из ВС &1"
      858                         ,X_ext-system.esys-id ) + chr(10)
      859                         + substitute( "&1", error-status:get-message(error-status:num-messages) ) + chr(10)
      860                         + substitute( "&1", return-value )
      861                       ) .
      862     end.
      863     assign
      864     add-log-file-name = ?
      865     .
      866     run refresh-brws in this-procedure ( input yes ).
      867   END.
      868   ON CHOOSE OF b-send IN FRAME oxmlhand
      869   DO:
      870     run esys-key in this-procedure ( input-output v-key-passed-date ) no-error.
      871     if error-status:error then return no-apply.
      872       if not available X_ext-system then do:                 message                   "Не выбрана ВС."                   view-as alert-box information.                 return no-apply.               end.               find first buf_ext-system no-lock                 where buf_ext-system.esys-id = X_ext-system.esys-id                    and  buf_ext-system.db-num = X_ext-system.db-num                 no-error .               if not available buf_ext-system then do:                 message                   substitute( "ВС &1 удалена.", X_ext-system.esys-id )                   view-as alert-box information.                 run refresh-brws                   ( input yes ) .                 return no-apply.               end.
      873       if not available X_esys-pck-sent THEN do:
      874           message "Не выбран пакет для отправки." view-as alert-box .
      875           return no-apply.
      876       end.
      877       if X_esys-pck-sent.esps-rcvd = no
      878       or can-find(first ub.esys-route no-lock where
      879                        ub.esys-route.esys-id = X_esys-pck-sent.esys-id
      880                     and ub.esys-route.db-num = X_esys-pck-sent.db-num
      881                     and ub.esys-route.esr-cr-db-num = g#db-num
      882                     and ub.esys-route.esr-last-pack = X_esys-pck-sent.esps-pack-num
      883                     )
      884       then do:
      885         assign
      886         add-log-file-name = substring( log-file-name, 1, r-index( log-file-name, '.':u) - 1 ) + substitute( "-&1.log", X_ext-system.esys-id )
      887         .
      888         run bge/oxmloutx.p ( input parparentproc
      889                             ,input this-procedure:handle
      890                             ,input p-log-handle
      891                             ,input substitute("one-pack,&1,&2,&3,&4,&5"
      892                                         ,v-db-num
      893                                         ,X_ext-system.esys-id
      894                                         ,X_ext-system.db-num
      895                                         ,X_esys-pck-sent.esps-cr-db-num
      896                                         ,X_esys-pck-sent.esps-pack-num)
      897                       ) no-error.
      898         if error-status:error then do:
      899           run write-to-log( vss-workfile + chr(32)
      900                             + substitute( "ERROR!!! Ошибка при отправке одного пакета данных в ВС &1", X_ext-system.esys-id ) + chr(10)
      901                             + substitute( "&1", error-status:get-message(error-status:num-messages) ) + chr(10)
      902                             + substitute( "&1", return-value )
      903                           ) .
      904         end.
      905         assign
      906         add-log-file-name = ?
      907         .
      908         run refresh-brws
      909           ( input yes )
      910         .
      911       end.
      912       else do:
      913         message
      914           vss-workfile vss-revision vss-description skip
      915           substitute( "Отправить пакет &1 нельзя.", X_esys-pck-sent.esps-pack-num ) skip
      916           substitute( "Получено подтверждение о его приеме и данные уже удалены." )
      917           view-as alert-box information
      918         .
      919       end.
      920   END.
      921   ON CHOOSE OF b-send-all IN FRAME oxmlhand
      922   DO:
      923     run esys-key in this-procedure ( input-output v-key-passed-date ) no-error.
      924     if error-status:error then return no-apply.
      925       if not available X_ext-system then do:                 message                   "Не выбрана ВС."                   view-as alert-box information.                 return no-apply.               end.               find first buf_ext-system no-lock                 where buf_ext-system.esys-id = X_ext-system.esys-id                    and  buf_ext-system.db-num = X_ext-system.db-num                 no-error .               if not available buf_ext-system then do:                 message                   substitute( "ВС &1 удалена.", X_ext-system.esys-id )                   view-as alert-box information.                 run refresh-brws                   ( input yes ) .                 return no-apply.               end.
      926       if not available X_esys-pck-sent THEN do:
      927           message "Нет готовых пакетов." view-as alert-box .
      928           return no-apply.
      929       end.
      930       assign
      931       add-log-file-name = substring( log-file-name, 1, r-index( log-file-name, '.':u) - 1 ) + substitute( "-&1.log", X_ext-system.esys-id )
      932       .
      933        run bge/oxmloutx.p ( input parparentproc
      934                             ,input this-procedure:handle
      935                             ,input p-log-handle
      936                             ,input substitute("one-esys-unconf,&1,&2,&3,-1,-1"
      937                                         ,v-db-num
      938                                         ,X_ext-system.esys-id
      939                                         ,X_ext-system.db-num
      940                                           )
      941                       ) no-error.
      942         if error-status:error then do:
      943           run write-to-log( vss-workfile + chr(32)
      944                         + substitute( "ERROR!!! Ошибка при отправке всех неподтвержденных пакетов данных в ВС &1", X_ext-system.esys-id ) + chr(10)
      945                         + substitute( "&1", error-status:get-message(error-status:num-messages) ) + chr(10)
      946                         + substitute( "&1", return-value )
      947                       ) .
      948         end.
      949      assign
      950      add-log-file-name = ?
      951      .
      952         run refresh-brws in this-procedure ( input yes ).
      953   END.
      954   ON CHOOSE OF b-send-new IN FRAME oxmlhand
      955   DO:
      956     run esys-key in this-procedure ( input-output v-key-passed-date ) no-error.
      957     if error-status:error then return no-apply.
      958       if not available X_ext-system then do:                 message                   "Не выбрана ВС."                   view-as alert-box information.                 return no-apply.               end.               find first buf_ext-system no-lock                 where buf_ext-system.esys-id = X_ext-system.esys-id                    and  buf_ext-system.db-num = X_ext-system.db-num                 no-error .               if not available buf_ext-system then do:                 message                   substitute( "ВС &1 удалена.", X_ext-system.esys-id )                   view-as alert-box information.                 run refresh-brws                   ( input yes ) .                 return no-apply.               end.
      959       assign
      960       add-log-file-name = substring( log-file-name, 1, r-index( log-file-name, '.':u) - 1 ) + substitute( "-&1.log", X_ext-system.esys-id )
      961       .
      962       run bge/oxmloutx.p ( input parparentproc
      963                             ,input this-procedure:handle
      964                             ,input p-log-handle
      965                             ,input substitute("one-esys,&1,&2,&3"
      966                                         ,v-db-num
      967                                         ,X_ext-system.esys-id
      968                                         ,X_ext-system.db-num
      969                                           )
      970                       ) no-error.
      971       if error-status:error then do:
      972         run write-to-log( vss-workfile + chr(32)
      973                           + substitute( "ERROR!!! Ошибка при отправке Данных в ВС &1", X_ext-system.esys-id)  + chr(10)
      974                           + substitute( "&1", error-status:get-message(error-status:num-messages) ) + chr(10)
      975                           + substitute( "&1", return-value )
      976                         ) .
      977       end.
      978       assign
      979       add-log-file-name = ?
      980       .
      981       run refresh-brws in this-procedure ( input yes ).
      982   END.
      983   ON CHOOSE OF b-unsend IN FRAME oxmlhand
      984   DO:
      985     if not available X_ext-system then do:                 message                   "Не выбрана ВС."                   view-as alert-box information.                 return no-apply.               end.               find first buf_ext-system no-lock                 where buf_ext-system.esys-id = X_ext-system.esys-id                    and  buf_ext-system.db-num = X_ext-system.db-num                 no-error .               if not available buf_ext-system then do:                 message                   substitute( "ВС &1 удалена.", X_ext-system.esys-id )                   view-as alert-box information.                 run refresh-brws                   ( input yes ) .                 return no-apply.               end.
      986     run bge/vxroute.w ( input X_ext-system.esys-id, input X_ext-system.db-num ) .
      987   END.
      988   ON VALUE-CHANGED OF br-esys IN FRAME oxmlhand
      989   DO:
      990     run refresh-brws in this-procedure  ( input no )  .
      991   END.
      992   ON CHOOSE OF MENU-ITEM m_send-ora-rcpt
      993   DO:
      994   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      995   MESSAGE
      996   "ВЫ действительно хотите сформировать подтверждение для пакета ?" SKIP
      997   "(Скорее всего оно уже было сформировано)" SKIP
      998   VIEW-AS ALERT-BOX QUESTION buttons YES-NO UPDATE glog.
      999   IF NOT glog THEN RETURN NO-APPLY.
     1000     run bge/rorarcpt.p ( INPUT parparentproc
     1001                         ,INPUT p-log-handle
     1002                         ,input no
     1003                         ,INPUT X_ext-system.esys-id
     1004                         ,INPUT X_ext-system.db-num
     1005                         ,INPUT X_esys-pck-rcvd.espr-pack-num) NO-ERROR.
     1006   if error-status:error then do:
     1007     message error-status:get-message(1)
     1008     return-value
     1009     view-as alert-box error .
     1010   end.
     1011   END.
     1012   ON ROW-DISPLAY OF pck-rcvd IN FRAME oxmlhand
     1013   DO:
     1014     define buffer esys-pck-rcvd-err for ub.esys-pck-rcvd-err.
     1015     v-imp-err = if can-find(first esys-pck-rcvd-err where
     1016                                   esys-pck-rcvd-err.esys-id        = X_esys-pck-rcvd.esys-id
     1017                               AND esys-pck-rcvd-err.db-num         = X_esys-pck-rcvd.db-num
     1018                               AND esys-pck-rcvd-err.espr-cr-db-num = X_esys-pck-rcvd.espr-cr-db-num
     1019                               AND esys-pck-rcvd-err.espr-pack-num  = X_esys-pck-rcvd.espr-pack-num)
     1020                 then "+" else "".
     1021   END.
     1022   ON VALUE-CHANGED OF pck-rcvd IN FRAME oxmlhand
     1023   DO:
     1024     define buffer esys-pck-rcvd-err for ub.esys-pck-rcvd-err.
     1025       ASSIGN
     1026       MENU-ITEM m_send-ora-rcpt:SENSITIVE IN MENU MENU-b-other = NO.
     1027     IF NOT AVAILABLE X_ext-system  THEN DO:
     1028     END.
     1029     ELSE DO:
     1030        IF AVAILABLE X_esys-pck-rcvd THEN DO:
     1031           CASE X_ext-system.delivery-method:
     1032             WHEN INTEGER('3':U) THEN DO:
     1033                 ASSIGN
     1034                 MENU-ITEM m_send-ora-rcpt:SENSITIVE IN MENU MENU-b-other = YES.
     1035             END.
     1036             OTHERWISE DO:
     1037             END.
     1038           END CASE.
     1039         END.
     1040         ELSE DO:
     1041         END.
     1042         if can-find(first esys-pck-rcvd-err where
     1043                           esys-pck-rcvd-err.esys-id        = X_esys-pck-rcvd.esys-id
     1044                       AND esys-pck-rcvd-err.db-num         = X_esys-pck-rcvd.db-num
     1045                       AND esys-pck-rcvd-err.espr-cr-db-num = X_esys-pck-rcvd.espr-cr-db-num
     1046                       AND esys-pck-rcvd-err.espr-pack-num  = X_esys-pck-rcvd.espr-pack-num)
     1047           then enable b-imp-err with frame oxmlhand.
     1048           else disable b-imp-err with frame oxmlhand.
     1049     END.
     1050   END.
     1051   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME oxmlhand:PARENT eq ?
     1052   THEN FRAME oxmlhand:PARENT = ACTIVE-WINDOW.
     1053   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1054   on f5 of frame oxmlhand anywhere
     1055   do:
     1056      run refresh-brws in this-procedure  ( input yes).
     1057       apply "VALUE-CHANGED" to br-esys.
     1058   end.
     1059   MAIN-BLOCK:
     1060   DO
     1061   ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1062   ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1063   :
     1064     find first buf_sys-ctrl no-lock.
     1065     run gbl/set-gbl.p
     1066       (input false
     1067       ,input p-user-login
     1068       ,input p-user-password
     1069       ) no-error.
     1070     if error-status:error then do:
     1071       run write-to-log( substitute( "&1. Ошибка при инициализации переменных g#...&2&3"
     1072                                     ,vss-workfile
     1073                                     ,chr(10)
     1074                                     ,error-status:get-message(error-status:num-messages)
     1075                                   )
     1076                       ) .
     1077       return error.
     1078     end.
     1079   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1080   on help of frame oxmlhand
     1081   do:
     1082     run gbl/app_help.p
     1083       (input this-procedure :file-name
     1084       ,input ''
     1085       ,input ?
     1086       ) no-error.
     1087     if error-status :error then do:
     1088       message
     1089         "Ошибка при вызове помощи"
     1090         error-status :get-message(1)
     1091         view-as alert-box .
     1092     end.
     1093   end.
     1094   run minbtn-set in this-procedure .
     1095   on choose of b-help in frame oxmlhand
     1096   do:
     1097     apply "help":u to frame oxmlhand .
     1098   end.
     1099   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1100   procedure minbtn-set :
     1101       do
     1102           on error undo, return error return-value
     1103           :
     1104           define variable ii              as integer       no-undo .
     1105           define variable fh              as widget-handle no-undo .
     1106           define variable hh              as widget-handle no-undo .
     1107           define variable v-h             as handle        extent 4 no-undo .
     1108           define variable v-name-button   as character     no-undo .
     1109           define variable v-help-old-x    as decimal       no-undo .
     1110           define variable v-help-old-y    as decimal       no-undo .
     1111           define variable v-help-old-size as decimal       no-undo .
     1112           define variable v-frame-width   as decimal       no-undo .
     1113           define variable jj              as integer       no-undo .
     1114           do
     1115               on error undo, return error
     1116               :
     1117               assign
     1118                   v-frame-width = frame oxmlhand:width - 0.3
     1119                   fh            = frame oxmlhand:first-child
     1120                   hh            = fh:first-child
     1121                   ii            = 1
     1122                   .
     1123               do while valid-handle(hh):
     1124                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1125                   do:
     1126                       case lc(hh:name) :
     1127                           when "b-help" then
     1128                               do:
     1129                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1130                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1131                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1132                                   hh:TOOLTIP = "Помощь" .
     1133                                   v-help-old-x = hh:column .
     1134                                   v-help-old-y = hh:row    .
     1135                                   v-help-old-size = hh:width .
     1136                                   hh:width-chars = 2.5 .
     1137                               end.
     1138                           when "b-print" then
     1139                               do:
     1140                                   hh:load-image("cmp/b-print.bmp":u) .
     1141                                   hh:TOOLTIP = "Печать" .
     1142                                   v-h[ii] = hh:handle .
     1143                                   ii = ii + 1 .
     1144                                   hh:width-chars = 3 .
     1145                               end.
     1146                           when "b-history" or
     1147                           when "b-hist" then
     1148                               do:
     1149                                   hh:load-image("cmp/b-hist.bmp":u) .
     1150                                   hh:TOOLTIP = "История" .
     1151                                   v-h[ii] = hh:handle .
     1152                                   ii = ii + 1 .
     1153                                   hh:width-chars = 3 .
     1154                               end.
     1155                           when "b-sch" then
     1156                               do:
     1157                                   hh:load-image("cmp/b-sch.bmp":u) .
     1158                                   hh:TOOLTIP = "Установка Фильтра" .
     1159                                   v-h[ii] = hh:handle .
     1160                                   ii = ii + 1 .
     1161                                   hh:width-chars = 3 .
     1162                               end.
     1163                           when "b-hist-user" then
     1164                               do:
     1165                                   hh:load-image("cmp/b-hist.bmp":u) .
     1166                                   hh:TOOLTIP = "История пользователя" .
     1167                                   ii = ii + 1 .
     1168                               end.
     1169                       end case.
     1170                   end.
     1171                   hh = hh:next-sibling.
     1172               end.
     1173               b-help:column = v-frame-width - b-help:width-chars.
     1174               jj = 0.
     1175               repeat ii = 4 to 1 by -1 :
     1176                   if valid-handle (v-h[ii] ) then
     1177                   do:
     1178                       jj  = jj + 1 .
     1179                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1180                       v-h[ii]:row    = v-help-old-y .
     1181                   end.
     1182               end.
     1183           end.
     1184       end.
     1185   end procedure.
     1186   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1187   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1188   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1189   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1190   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1191   define variable v-diasize-current-frame-height as decimal   no-undo .
     1192   define variable v-diasize-change-size          as logical   no-undo .
     1193   define variable v-diasize-resize-button        as handle    no-undo .
     1194   define variable v-diasize-wndmax               as logical   no-undo .
     1195   define variable v-diasize-wndstore             as logical   no-undo .
     1196   define variable v-diasize-proc-name            as character no-undo .
     1197   define variable v-diasize-browse-handle        as handle    no-undo .
     1198   define variable v-diasize-browse-number        as integer   no-undo .
     1199   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1200   define temp-table temp-diasize-handle no-undo
     1201     field handle-value  as handle
     1202     field save-position as decimal
     1203     index xpk is primary unique handle-value
     1204     .
     1205   define temp-table temp-browse-handle no-undo
     1206     field browse-type   as character
     1207     field browse-number as integer
     1208     field browse-handle as handle
     1209     field original-size as decimal
     1210     index xpk is primary unique browse-type browse-number
     1211     index xie browse-type browse-handle
     1212   .
     1213   procedure diasize_change-height :
     1214     define input  parameter p-change-value  as decimal   no-undo .
     1215     define input  parameter p-move-resize   as logical   no-undo .
     1216     define variable v-field-group-handle    as handle    no-undo .
     1217     define variable v-object-handle         as handle    no-undo .
     1218     define variable v-frame-height          as decimal   no-undo .
     1219     define variable v-frame-virtual-height  as decimal   no-undo .
     1220     define variable v-browse-height         as decimal   no-undo .
     1221     define variable v-window-height         as decimal   no-undo .
     1222     define variable v-window-virtual-height as decimal   no-undo .
     1223     define variable v-change-sign           as integer   no-undo .
     1224     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1225     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1226     if p-change-value > 0
     1227     then do:
     1228       if frame oxmlhand :height + p-change-value
     1229           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1230       then do:
     1231         assign
     1232           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1233                           - (frame oxmlhand :height-chars)
     1234         .
     1235         if p-change-value <= 0
     1236         then do:
     1237           run diasize_position-resize-button in this-procedure .
     1238           return .
     1239         end.
     1240       end.
     1241     end.
     1242     if p-change-value < 0
     1243     then do:
     1244       if frame oxmlhand :height + p-change-value < v-diasize-orig-frame-height
     1245       then do:
     1246         assign
     1247           p-change-value = v-diasize-orig-frame-height
     1248                          - (frame oxmlhand :height-chars)
     1249         .
     1250         if p-change-value >= 0
     1251         then do:
     1252           run diasize_position-resize-button in this-procedure .
     1253           return .
     1254         end.
     1255       end.
     1256     end.
     1257     if p-change-value >= 0
     1258     then do:
     1259       assign
     1260         v-change-sign = 1
     1261       .
     1262     end.
     1263     else do:
     1264       assign
     1265         v-change-sign = -1
     1266       .
     1267     end.
     1268     assign
     1269       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1270     .
     1271     if p-change-value = 0
     1272     then do:
     1273       run diasize_position-resize-button in this-procedure .
     1274       return .
     1275     end.
     1276     move_block:
     1277     do
     1278     on error undo move_block, retry move_block
     1279     :
     1280       if retry
     1281       then do:
     1282         do
     1283         on error undo move_block, leave move_block
     1284         :
     1285           if p-change-value > 0
     1286           then do:
     1287             for each buf_temp-diasize-handle
     1288             on error undo, next
     1289             :
     1290               assign
     1291                 v-object-handle = buf_temp-diasize-handle.handle-value
     1292               .
     1293               if v-object-handle <> v-diasize-resize-button
     1294               then do:
     1295                 assign
     1296                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1297                 .
     1298               end.
     1299             end.
     1300             assign
     1301               v-diasize-browse-handle :height = v-browse-height
     1302             .
     1303             for each buf_temp-browse-handle
     1304               where buf_temp-browse-handle.browse-type = 'height':u
     1305             on error undo, next
     1306             :
     1307               assign
     1308                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1309               .
     1310             end.
     1311             assign
     1312               frame oxmlhand :height = v-frame-height
     1313             .
     1314             if frame oxmlhand :scrollable = true
     1315             then do:
     1316               assign
     1317                 frame oxmlhand :virtual-height = v-frame-virtual-height
     1318               .
     1319             end.
     1320             run diasize_position-resize-button in this-procedure .
     1321           end.
     1322           else do:
     1323             if frame oxmlhand :scrollable = true
     1324             then do:
     1325               assign
     1326                 frame oxmlhand :virtual-height = v-frame-virtual-height
     1327               .
     1328             end.
     1329             assign
     1330               frame oxmlhand :height = v-frame-height
     1331             .
     1332             assign
     1333               v-diasize-browse-handle :height = v-browse-height
     1334             .
     1335             for each buf_temp-browse-handle
     1336               where buf_temp-browse-handle.browse-type = 'height':u
     1337             on error undo, next
     1338             :
     1339               assign
     1340                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1341               .
     1342             end.
     1343             for each buf_temp-diasize-handle
     1344             on error undo, next
     1345             :
     1346               assign
     1347                 v-object-handle = buf_temp-diasize-handle.handle-value
     1348               .
     1349               if v-object-handle <> v-diasize-resize-button
     1350               then do:
     1351                 assign
     1352                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1353                 .
     1354               end.
     1355             end.
     1356             run diasize_position-resize-button in this-procedure .
     1357           end.
     1358           assign
     1359             v-diasize-change-size = false
     1360           .
     1361           leave move_block .
     1362         end.
     1363       end.
     1364       assign
     1365         v-diasize-need-full-display = true
     1366       .
     1367       if v-diasize-change-size = false
     1368       then do:
     1369         assign
     1370           v-diasize-change-size = true
     1371         .
     1372       end.
     1373       else do:
     1374         return .
     1375       end.
     1376       assign
     1377         v-frame-height = frame oxmlhand :height
     1378         v-frame-virtual-height = frame oxmlhand :virtual-height
     1379         v-browse-height = v-diasize-browse-handle :height
     1380       .
     1381       for each buf_temp-browse-handle
     1382         where buf_temp-browse-handle.browse-type = 'height':u
     1383       :
     1384         assign
     1385           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1386         .
     1387       end.
     1388       for each buf_temp-diasize-handle
     1389       :
     1390         delete buf_temp-diasize-handle .
     1391       end.
     1392       assign
     1393         v-field-group-handle = frame oxmlhand :first-child
     1394       .
     1395       do while valid-handle(v-field-group-handle)
     1396       :
     1397         assign
     1398           v-object-handle = v-field-group-handle :first-child
     1399         .
     1400         do while valid-handle(v-object-handle)
     1401         :
     1402           if  v-object-handle <> v-diasize-browse-handle :handle
     1403           and can-query(v-object-handle, "row")
     1404           and can-query(v-object-handle, "height")
     1405           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1406           then do:
     1407             find first buf_temp-browse-handle
     1408               where buf_temp-browse-handle.browse-type   = 'height':u
     1409                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1410               no-error .
     1411             if available buf_temp-browse-handle
     1412             then do:
     1413             end.
     1414             else do:
     1415               create buf_temp-diasize-handle .
     1416               assign
     1417                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1418                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1419               .
     1420             end.
     1421           end.
     1422           assign
     1423             v-object-handle = v-object-handle :next-sibling
     1424           .
     1425         end.
     1426         assign
     1427           v-field-group-handle = v-field-group-handle :next-sibling
     1428         .
     1429       end.
     1430       do with frame oxmlhand
     1431       :
     1432         hide v-diasize-resize-button .
     1433         assign
     1434           v-diasize-resize-button :row    = 1
     1435           v-diasize-resize-button :column = 1
     1436         .
     1437       end.
     1438       if p-change-value > 0
     1439       then do:
     1440         if frame oxmlhand :scrollable = true
     1441         then do:
     1442           assign
     1443             frame oxmlhand :virtual-height = frame oxmlhand :virtual-height + p-change-value
     1444             no-error .
     1445           if error-status :error
     1446           or error-status :get-message(1) <> ""
     1447           then do:
     1448             undo move_block, retry move_block .
     1449           end.
     1450         end.
     1451         assign
     1452           frame oxmlhand :height = frame oxmlhand :height + p-change-value
     1453           no-error .
     1454         if error-status :error
     1455         or error-status :get-message(1) <> ""
     1456         then do:
     1457           undo move_block, retry move_block .
     1458         end.
     1459         assign
     1460           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1461           no-error .
     1462         if error-status :error
     1463         or error-status :get-message(1) <> ""
     1464         then do:
     1465           undo move_block, retry move_block .
     1466         end.
     1467         for each buf_temp-browse-handle
     1468           where buf_temp-browse-handle.browse-type = 'height':u
     1469         on error undo move_block, retry move_block
     1470         :
     1471           assign
     1472             buf_temp-browse-handle.browse-handle :height
     1473               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1474             no-error .
     1475           if error-status :error
     1476           or error-status :get-message(1) <> ""
     1477           then do:
     1478             undo move_block, retry move_block .
     1479           end.
     1480         end.
     1481         for each buf_temp-diasize-handle
     1482         on error undo move_block, retry move_block
     1483         :
     1484           assign
     1485             v-object-handle = buf_temp-diasize-handle.handle-value
     1486           .
     1487           if v-object-handle <> v-diasize-resize-button
     1488           then do:
     1489             assign
     1490               v-object-handle :row = v-object-handle :row + p-change-value
     1491               no-error .
     1492             if error-status :error
     1493             or error-status :get-message(1) <> ""
     1494             then do:
     1495               undo move_block, retry move_block .
     1496             end.
     1497           end.
     1498         end.
     1499       end.
     1500       else do:
     1501         for each buf_temp-diasize-handle
     1502         on error undo move_block, retry move_block
     1503         :
     1504           assign
     1505             v-object-handle = buf_temp-diasize-handle.handle-value
     1506           .
     1507           if v-object-handle <> v-diasize-resize-button
     1508           then do:
     1509             assign
     1510               v-object-handle :row = v-object-handle :row + p-change-value
     1511               no-error .
     1512             if error-status :error
     1513             or error-status :get-message(1) <> ""
     1514             then do:
     1515               undo move_block, retry move_block .
     1516             end.
     1517           end.
     1518         end.
     1519         assign
     1520           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1521           no-error .
     1522         if error-status :error
     1523         or error-status :get-message(1) <> ""
     1524         then do:
     1525           undo move_block, retry move_block .
     1526         end.
     1527         for each buf_temp-browse-handle
     1528           where buf_temp-browse-handle.browse-type = 'height':u
     1529         on error undo move_block, retry move_block
     1530         :
     1531           assign
     1532             buf_temp-browse-handle.browse-handle :height
     1533               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1534             no-error .
     1535           if error-status :error
     1536           or error-status :get-message(1) <> ""
     1537           then do:
     1538             undo move_block, retry move_block .
     1539           end.
     1540         end.
     1541         assign
     1542           frame oxmlhand :height = frame oxmlhand :height + p-change-value
     1543           no-error .
     1544         if error-status :error
     1545         or error-status :get-message(1) <> ""
     1546         then do:
     1547           undo move_block, retry move_block .
     1548         end.
     1549         if frame oxmlhand :scrollable = true
     1550         then do:
     1551           assign
     1552             frame oxmlhand :virtual-height = frame oxmlhand :virtual-height + p-change-value
     1553             no-error .
     1554           if error-status :error
     1555           or error-status :get-message(1) <> ""
     1556           then do:
     1557             undo move_block, retry move_block .
     1558           end.
     1559         end.
     1560       end.
     1561       if p-move-resize = true
     1562       then do:
     1563         run diasize_position-resize-button in this-procedure .
     1564       end.
     1565       if v-diasize-wndstore = true
     1566       then do:
     1567         if connected("ub") = true
     1568         then do:
     1569           define variable v-cntxt-db-num        as integer   no-undo .
     1570           define variable v-cntxt-userid        as character no-undo .
     1571           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1572                                             , OUTPUT v-cntxt-userid
     1573                                             ) .
     1574           run gbl/wndsizew.p
     1575             (input  v-cntxt-db-num
     1576             ,input  v-cntxt-userid
     1577             ,input  v-diasize-proc-name
     1578             ,input  'height':u
     1579             ,input  string(frame oxmlhand :height - v-diasize-orig-frame-height)
     1580             ) .
     1581         end.
     1582       end.
     1583     end.
     1584     assign
     1585       v-diasize-change-size = false
     1586     .
     1587   end procedure.
     1588   procedure diasize_set-height :
     1589     define input  parameter p-new-height  as decimal   no-undo .
     1590     define input  parameter p-move-resize as logical   no-undo .
     1591     do
     1592     on error undo, return error return-value
     1593     :
     1594       run diasize_change-height in this-procedure
     1595         (input  (p-new-height - frame oxmlhand :height)
     1596         ,input  p-move-resize
     1597         ) .
     1598     end.
     1599   end procedure.
     1600   procedure diasize_change-width :
     1601     define input  parameter p-change-value as decimal   no-undo .
     1602     define input  parameter p-move-resize  as logical   no-undo .
     1603     define variable v-field-group-handle   as handle    no-undo .
     1604     define variable v-object-handle        as handle    no-undo .
     1605     define variable v-frame-width          as decimal   no-undo .
     1606     define variable v-frame-virtual-width  as decimal   no-undo .
     1607     define variable v-browse-width         as decimal   no-undo .
     1608     define variable v-window-width         as decimal   no-undo .
     1609     define variable v-window-virtual-width as decimal   no-undo .
     1610     define variable v-change-sign          as integer   no-undo .
     1611     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1612     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1613     if p-change-value > 0
     1614     then do:
     1615       if frame oxmlhand :width + p-change-value >
     1616           session :width-chars
     1617       then do:
     1618         assign
     1619           p-change-value = session :width-chars - frame oxmlhand :width
     1620         .
     1621         if p-change-value <= 0
     1622         then do:
     1623           run diasize_position-resize-button in this-procedure .
     1624           return .
     1625         end.
     1626       end.
     1627     end.
     1628     if p-change-value < 0
     1629     then do:
     1630       if frame oxmlhand :width + p-change-value < v-diasize-orig-frame-width
     1631       then do:
     1632         assign
     1633           p-change-value = v-diasize-orig-frame-width
     1634                          - frame oxmlhand :width
     1635         .
     1636         if p-change-value >= 0
     1637         then do:
     1638           run diasize_position-resize-button in this-procedure .
     1639           return .
     1640         end.
     1641       end.
     1642     end.
     1643     if p-change-value >= 0
     1644     then do:
     1645       assign
     1646         v-change-sign = 1
     1647       .
     1648     end.
     1649     else do:
     1650       assign
     1651         v-change-sign = -1
     1652       .
     1653     end.
     1654     assign
     1655       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1656     .
     1657     if p-change-value = 0
     1658     then do:
     1659       run diasize_position-resize-button in this-procedure .
     1660       return .
     1661     end.
     1662     move_block:
     1663     do
     1664     on error undo move_block, leave move_block
     1665     :
     1666       if retry
     1667       then do:
     1668         do
     1669         on error undo move_block, leave move_block
     1670         :
     1671           if p-change-value > 0
     1672           then do:
     1673             for each buf_temp-diasize-handle
     1674             on error undo, next
     1675             :
     1676               assign
     1677                 v-object-handle = buf_temp-diasize-handle.handle-value
     1678               .
     1679               if v-object-handle <> v-diasize-resize-button
     1680               then do:
     1681                 assign
     1682                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1683                 .
     1684               end.
     1685             end.
     1686             assign
     1687               v-diasize-browse-handle :width = v-browse-width
     1688             .
     1689             for each buf_temp-browse-handle
     1690               where buf_temp-browse-handle.browse-type = 'width':u
     1691             on error undo, next
     1692             :
     1693               assign
     1694                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1695               .
     1696             end.
     1697             assign
     1698               frame oxmlhand :width = v-frame-width
     1699             .
     1700             if frame oxmlhand :scrollable = true
     1701             then do:
     1702               assign
     1703                 frame oxmlhand :virtual-width = v-frame-virtual-width
     1704               .
     1705             end.
     1706             run diasize_position-resize-button in this-procedure .
     1707           end.
     1708           else do:
     1709             if frame oxmlhand :scrollable = true
     1710             then do:
     1711               assign
     1712                 frame oxmlhand :virtual-width = v-frame-virtual-width
     1713               .
     1714             end.
     1715             assign
     1716               frame oxmlhand :width = v-frame-width
     1717             .
     1718             for each buf_temp-browse-handle
     1719               where buf_temp-browse-handle.browse-type = 'width':u
     1720             on error undo, next
     1721             :
     1722               assign
     1723                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1724               .
     1725             end.
     1726             assign
     1727               v-diasize-browse-handle :width = v-browse-width
     1728             .
     1729             for each buf_temp-diasize-handle
     1730             on error undo, next
     1731             :
     1732               assign
     1733                 v-object-handle = buf_temp-diasize-handle.handle-value
     1734               .
     1735               if v-object-handle <> v-diasize-resize-button
     1736               then do:
     1737                 assign
     1738                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1739                 .
     1740               end.
     1741             end.
     1742             run diasize_position-resize-button in this-procedure .
     1743           end.
     1744           assign
     1745             v-diasize-change-size = false
     1746           .
     1747           leave move_block .
     1748         end.
     1749       end.
     1750       assign
     1751         v-diasize-need-full-display = true
     1752       .
     1753       if v-diasize-change-size = false
     1754       then do:
     1755         assign
     1756           v-diasize-change-size = true
     1757         .
     1758       end.
     1759       else do:
     1760         return .
     1761       end.
     1762       assign
     1763         v-frame-width = frame oxmlhand :width
     1764         v-frame-virtual-width = frame oxmlhand :virtual-width
     1765         v-browse-width = v-diasize-browse-handle :width
     1766       .
     1767       for each buf_temp-browse-handle
     1768         where buf_temp-browse-handle.browse-type = 'width':u
     1769       :
     1770         assign
     1771           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1772         .
     1773       end.
     1774       for each buf_temp-diasize-handle
     1775       :
     1776         delete buf_temp-diasize-handle .
     1777       end.
     1778       assign
     1779         v-field-group-handle = frame oxmlhand :first-child
     1780       .
     1781       do while valid-handle(v-field-group-handle)
     1782       :
     1783         assign
     1784           v-object-handle = v-field-group-handle :first-child
     1785         .
     1786         do while valid-handle(v-object-handle)
     1787         :
     1788           if  v-object-handle <> v-diasize-browse-handle :handle
     1789           and v-object-handle <> v-diasize-resize-button
     1790           and can-query(v-object-handle, "row")
     1791           and can-query(v-object-handle, "height")
     1792           and ( v-object-handle :col + v-object-handle :width
     1793                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1794               )
     1795           then do:
     1796             find first buf_temp-browse-handle
     1797               where buf_temp-browse-handle.browse-type   = 'width':u
     1798                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1799               no-error .
     1800             if available buf_temp-browse-handle
     1801             then do:
     1802             end.
     1803             else do:
     1804               create buf_temp-diasize-handle .
     1805               assign
     1806                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1807                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1808               .
     1809             end.
     1810           end.
     1811           assign
     1812             v-object-handle = v-object-handle :next-sibling
     1813           .
     1814         end.
     1815         assign
     1816           v-field-group-handle = v-field-group-handle :next-sibling
     1817         .
     1818       end.
     1819       do with frame oxmlhand
     1820       :
     1821         hide v-diasize-resize-button .
     1822         v-diasize-resize-button :row = 1.
     1823         v-diasize-resize-button :column = 1.
     1824       end.
     1825       if p-change-value > 0
     1826       then do:
     1827         if frame oxmlhand :scrollable = true
     1828         then do:
     1829           assign
     1830             frame oxmlhand :virtual-width = frame oxmlhand :virtual-width + p-change-value
     1831             no-error .
     1832           if error-status :error
     1833           or error-status :get-message(1) <> ""
     1834           then do:
     1835             undo move_block, retry move_block.
     1836           end.
     1837         end.
     1838         assign
     1839           frame oxmlhand :width = v-frame-width + p-change-value
     1840           no-error .
     1841         if error-status :error
     1842         or error-status :get-message(1) <> ""
     1843         then do:
     1844           undo move_block, retry move_block.
     1845         end.
     1846         assign
     1847           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1848         no-error .
     1849         if error-status :error
     1850         or error-status :get-message(1) <> ""
     1851         then do:
     1852           undo move_block, retry move_block.
     1853         end.
     1854         for each buf_temp-browse-handle
     1855           where buf_temp-browse-handle.browse-type = 'width':u
     1856         on error undo move_block, retry move_block
     1857         :
     1858           assign
     1859             buf_temp-browse-handle.browse-handle :width
     1860               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1861             no-error .
     1862           if error-status :error
     1863           or error-status :get-message(1) <> ""
     1864           then do:
     1865             undo move_block, retry move_block .
     1866           end.
     1867         end.
     1868         for each buf_temp-diasize-handle
     1869         on error undo move_block, retry move_block
     1870         :
     1871           assign
     1872             v-object-handle = buf_temp-diasize-handle.handle-value
     1873           .
     1874           if v-object-handle <> v-diasize-resize-button
     1875           then do:
     1876             assign
     1877               v-object-handle :col = v-object-handle :col + p-change-value
     1878               no-error .
     1879             if error-status :error
     1880             or error-status :get-message(1) <> ""
     1881             then do:
     1882               undo move_block, retry move_block .
     1883             end.
     1884           end.
     1885         end.
     1886       end.
     1887       else do:
     1888         for each buf_temp-diasize-handle
     1889         on error undo move_block, retry move_block
     1890         :
     1891           assign
     1892             v-object-handle = buf_temp-diasize-handle.handle-value
     1893           .
     1894           if v-object-handle <> v-diasize-resize-button
     1895           then do:
     1896             assign
     1897               v-object-handle :col = v-object-handle :col + p-change-value
     1898               no-error .
     1899             if error-status :error
     1900             or error-status :get-message(1) <> ""
     1901             then do:
     1902               undo move_block, retry move_block .
     1903             end.
     1904           end.
     1905         end.
     1906         for each buf_temp-browse-handle
     1907           where buf_temp-browse-handle.browse-type = 'width':u
     1908         on error undo move_block, retry move_block
     1909         :
     1910           assign
     1911             buf_temp-browse-handle.browse-handle :width
     1912               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1913             no-error .
     1914           if error-status :error
     1915           or error-status :get-message(1) <> ""
     1916           then do:
     1917             undo move_block, retry move_block .
     1918           end.
     1919         end.
     1920         assign
     1921           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1922           no-error .
     1923         if error-status :error
     1924         or error-status :get-message(1) <> ""
     1925         then do:
     1926           undo move_block, retry move_block.
     1927         end.
     1928         assign
     1929           frame oxmlhand :width = frame oxmlhand :width + p-change-value
     1930         no-error .
     1931         if error-status :error
     1932         or error-status :get-message(1) <> ""
     1933         then do:
     1934           undo move_block, retry move_block.
     1935         end.
     1936         if frame oxmlhand :scrollable = true
     1937         then do:
     1938           assign
     1939             frame oxmlhand :virtual-width = frame oxmlhand :virtual-width + p-change-value
     1940           no-error .
     1941           if error-status :error
     1942           or error-status :get-message(1) <> ""
     1943           then do:
     1944             undo move_block, retry move_block.
     1945           end.
     1946         end.
     1947       end.
     1948       if p-move-resize
     1949       then do:
     1950         run diasize_position-resize-button in this-procedure .
     1951       end.
     1952       if v-diasize-wndstore = true
     1953       then do:
     1954         if connected("ub") = true
     1955         then do:
     1956           define variable v-cntxt-db-num        as integer   no-undo .
     1957           define variable v-cntxt-userid        as character no-undo .
     1958           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1959                                             , OUTPUT v-cntxt-userid
     1960                                             ) .
     1961           run gbl/wndsizew.p
     1962             (input  v-cntxt-db-num
     1963             ,input  v-cntxt-userid
     1964             ,input  v-diasize-proc-name
     1965             ,input  'width':u
     1966             ,input  string(frame oxmlhand :width - v-diasize-orig-frame-width)
     1967             ) .
     1968         end.
     1969       end.
     1970     end.
     1971     assign
     1972       v-diasize-change-size = false
     1973     .
     1974   end procedure.
     1975   procedure diasize_set-width :
     1976     define input  parameter p-new-width  as decimal   no-undo .
     1977     define input  parameter p-move-resize as logical   no-undo .
     1978     do
     1979     on error undo, return error return-value
     1980     :
     1981       run diasize_change-width in this-procedure
     1982         (input  (p-new-width - frame oxmlhand :width)
     1983         ,input  p-move-resize
     1984         ) .
     1985     end.
     1986   end procedure.
     1987   procedure diasize_position-resize-button :
     1988     do with frame oxmlhand
     1989     :
     1990       hide v-diasize-resize-button .
     1991       assign
     1992         v-diasize-resize-button :row = frame oxmlhand :height - v-diasize-resize-button :height
     1993                     - 1
     1994                     - (frame oxmlhand :border-bottom-pixels / session :pixels-per-row)
     1995         v-diasize-resize-button :col = frame oxmlhand :width - v-diasize-resize-button :width
     1996                     - 1
     1997                     - (frame oxmlhand :border-right-pixels / session :pixels-per-column)
     1998       .
     1999       view v-diasize-resize-button .
     2000     end.
     2001   end procedure.
     2002   on alt-right anywhere
     2003   do:
     2004     run diasize_change-width in this-procedure
     2005       (input 1
     2006       ,input true
     2007       ) .
     2008     return no-apply .
     2009   end.
     2010   on alt-left anywhere
     2011   do:
     2012     run diasize_change-width in this-procedure
     2013       (input -1
     2014       ,input true
     2015       ) .
     2016     return no-apply .
     2017   end.
     2018   on alt-down anywhere
     2019   do:
     2020     run diasize_change-height in this-procedure
     2021       (input 1
     2022       ,input true
     2023       ) .
     2024     return no-apply .
     2025   end.
     2026   on alt-up anywhere
     2027   do:
     2028     run diasize_change-height in this-procedure
     2029       (input -1
     2030       ,input true
     2031       ) .
     2032     return no-apply .
     2033   end.
     2034   on alt-enter of frame oxmlhand
     2035   do:
     2036     run diasize_maximize in this-procedure
     2037       (input  ?
     2038       ).
     2039     return no-apply .
     2040   end.
     2041   procedure diasize_end-move :
     2042     do
     2043     on error undo, return error return-value
     2044     :
     2045       define variable v-row-delta as decimal   no-undo .
     2046       define variable v-col-delta as decimal   no-undo .
     2047       define variable v-new-row as decimal   no-undo .
     2048       define variable v-new-col as decimal   no-undo .
     2049       assign
     2050         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2051         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2052       .
     2053       assign
     2054         v-row-delta = v-new-row - frame oxmlhand :height
     2055         v-col-delta = v-new-col - frame oxmlhand :width
     2056       .
     2057       run diasize_change-height in this-procedure
     2058         (input v-row-delta
     2059         ,input true
     2060         ) .
     2061       run diasize_change-width in this-procedure
     2062         (input v-col-delta
     2063         ,input true
     2064         ) .
     2065     end.
     2066   end procedure.
     2067   procedure diasize_maximize :
     2068     define input  parameter p-action as logical   no-undo .
     2069     do
     2070     on error undo, return error return-value
     2071     :
     2072       if p-action = ?
     2073       then do:
     2074         if v-diasize-need-maximize = true
     2075         then do:
     2076           assign
     2077             p-action = true
     2078           .
     2079         end.
     2080         else do:
     2081           assign
     2082             p-action = false
     2083           .
     2084         end.
     2085       end.
     2086       if p-action = true
     2087       then do:
     2088         run diasize_change-height in this-procedure
     2089           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2090               - frame oxmlhand :height-chars
     2091           ,input true
     2092           ) .
     2093         run diasize_change-width in this-procedure
     2094           (input session :width-chars
     2095               - frame oxmlhand :width-chars
     2096           ,input true
     2097           ) .
     2098         assign
     2099           v-diasize-need-maximize = false
     2100         .
     2101       end.
     2102       else do:
     2103         run diasize_change-width in this-procedure
     2104           (input v-diasize-orig-frame-width
     2105               - frame oxmlhand :width-chars
     2106           ,input true
     2107           ) .
     2108         run diasize_change-height in this-procedure
     2109           (input v-diasize-orig-frame-height
     2110               - frame oxmlhand :height-chars
     2111           ,input true
     2112           ) .
     2113         assign
     2114           v-diasize-need-maximize = true
     2115         .
     2116       end.
     2117     end.
     2118   end procedure.
     2119   procedure diasize_restore-orig-size :
     2120     do
     2121     on error undo, return error return-value
     2122     :
     2123       assign
     2124         v-diasize-current-frame-width  = frame oxmlhand :width
     2125         v-diasize-current-frame-height = frame oxmlhand :height
     2126       .
     2127       run diasize_set-height in this-procedure
     2128         (input  v-diasize-orig-frame-height
     2129         ,input  true
     2130         ) .
     2131       run diasize_set-width in this-procedure
     2132         (input  v-diasize-orig-frame-width
     2133         ,input  true
     2134         ) .
     2135     end.
     2136   end procedure.
     2137   procedure diasize_restore-current-size :
     2138     do
     2139     on error undo, return error return-value
     2140     :
     2141       run diasize_set-height in this-procedure
     2142         (input  v-diasize-current-frame-height
     2143         ,input  true
     2144         ) .
     2145       run diasize_set-width in this-procedure
     2146         (input  v-diasize-current-frame-width
     2147         ,input  true
     2148         ) .
     2149     end.
     2150   end procedure.
     2151   procedure diasize_set-browse-handle :
     2152     define input  parameter p-browse-handle as handle   no-undo .
     2153     define buffer buf_temp-browse-handle for temp-browse-handle .
     2154     do
     2155     on error undo, return error return-value
     2156     :
     2157       assign
     2158         v-diasize-browse-handle = p-browse-handle
     2159       .
     2160       for each buf_temp-browse-handle
     2161       on error undo, return error return-value
     2162       :
     2163         delete buf_temp-browse-handle .
     2164       end.
     2165     end.
     2166   end procedure.
     2167   procedure diasize_add_browse :
     2168     define input  parameter p-browse-type   as character no-undo .
     2169     define input  parameter p-browse-handle as handle    no-undo .
     2170     define buffer buf_temp-browse-handle for temp-browse-handle .
     2171     do
     2172     on error undo, return error return-value
     2173     :
     2174       assign
     2175         v-diasize-browse-number = v-diasize-browse-number + 1
     2176       .
     2177       create buf_temp-browse-handle .
     2178       assign
     2179         buf_temp-browse-handle.browse-type   = p-browse-type
     2180         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2181         buf_temp-browse-handle.browse-handle = p-browse-handle
     2182       .
     2183     end.
     2184   end procedure.
     2185   procedure diasize_init :
     2186     define variable v-default-value    as logical   no-undo .
     2187     define variable v-restore-saved    as logical   no-undo .
     2188     define variable v-resize-value-str as character no-undo .
     2189     do
     2190     on error undo, return error return-value
     2191     :
     2192       do with frame oxmlhand
     2193       :
     2194         assign
     2195           v-diasize-orig-frame-height = frame oxmlhand :height
     2196           v-diasize-orig-frame-width  = frame oxmlhand :width
     2197           v-diasize-browse-handle     = browse br-esys :handle
     2198         .
     2199         create button v-diasize-resize-button
     2200         assign
     2201           parent        = frame oxmlhand :first-child
     2202           label         = "s"
     2203           height-pixels = 16
     2204           width-pixels  = 16
     2205           visible       = true
     2206           sensitive     = true
     2207           movable       = true
     2208           triggers:
     2209             on end-move persistent run diasize_end-move in this-procedure .
     2210           end triggers.
     2211         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2212         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2213         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2214         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2215         assign
     2216           v-diasize-wndmax = false
     2217         .
     2218         if connected("ub") = true
     2219         then do:
     2220           define variable v-cntxt-db-num        as integer   no-undo .
     2221           define variable v-cntxt-userid        as character no-undo .
     2222           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2223                                             , OUTPUT v-cntxt-userid
     2224                                             ) .
     2225           run gbl/wndpar_r.p
     2226             (input  v-cntxt-db-num
     2227             ,input  v-cntxt-userid
     2228             ,input  'wndmax':U
     2229             ,output v-diasize-wndmax
     2230             ,output v-default-value
     2231             ) .
     2232         end.
     2233         assign
     2234           v-diasize-wndstore = false
     2235         .
     2236         if connected("ub") = true
     2237         then do:
     2238           run gbl/wndpar_r.p
     2239             (input  v-cntxt-db-num
     2240             ,input  v-cntxt-userid
     2241             ,input  'wndstore':U
     2242             ,output v-diasize-wndstore
     2243             ,output v-default-value
     2244             ) .
     2245         end.
     2246         assign
     2247           v-diasize-proc-name = entry(1, program-name(2), '.')
     2248         .
     2249         if v-diasize-wndstore = true
     2250         then do:
     2251           assign
     2252             v-restore-saved = false
     2253           .
     2254           if connected("ub") = true
     2255           then do:
     2256             run gbl/wndsizer.p
     2257               (input  v-cntxt-db-num
     2258               ,input  v-cntxt-userid
     2259               ,input  v-diasize-proc-name
     2260               ,input  'height':u
     2261               ,output v-resize-value-str
     2262               ) .
     2263             if v-resize-value-str <> '':U
     2264             then do:
     2265               run diasize_change-height in this-procedure
     2266                 (input  integer(v-resize-value-str)
     2267                 ,input  true
     2268                 ) .
     2269               assign
     2270                 v-restore-saved = true
     2271               .
     2272             end.
     2273           end.
     2274           if connected("ub") = true
     2275           then do:
     2276             run gbl/wndsizer.p
     2277               (input  v-cntxt-db-num
     2278               ,input  v-cntxt-userid
     2279               ,input  v-diasize-proc-name
     2280               ,input  'width':u
     2281               ,output v-resize-value-str
     2282               ) .
     2283             if v-resize-value-str <> '':U
     2284             then do:
     2285               run diasize_change-width in this-procedure
     2286                 (input  integer(v-resize-value-str)
     2287                 ,input  true
     2288                 ) .
     2289               assign
     2290                 v-restore-saved = true
     2291               .
     2292             end.
     2293           end.
     2294           if v-restore-saved <> true
     2295           then do:
     2296             if v-diasize-wndmax = true
     2297             then do:
     2298               run diasize_maximize in this-procedure
     2299                 (input  true
     2300                 ) .
     2301             end.
     2302           end.
     2303         end.
     2304         else do:
     2305           if v-diasize-wndmax = true
     2306           then do:
     2307             run diasize_maximize in this-procedure
     2308               (input  true
     2309               ) .
     2310           end.
     2311         end.
     2312       end.
     2313     end.
     2314   end procedure.
     2315   procedure diasize_need-full-display :
     2316     define output parameter p-need-full-display as logical   no-undo .
     2317     do
     2318     on error undo, return error return-value
     2319     :
     2320       assign
     2321         p-need-full-display = v-diasize-need-full-display
     2322       .
     2323       assign
     2324         v-diasize-need-full-display = false
     2325       .
     2326     end.
     2327   end procedure.
     2328   procedure get-context :
     2329      define output parameter p-db-num as integer          no-undo.
     2330      define output parameter p-user-id as character        no-undo.
     2331      define variable v-login               as character    no-undo.
     2332      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2333      define buffer buf_user-login  for ub.user-login .
     2334      do
     2335      on error undo, return error
     2336      :
     2337            FIND FIRST buf_sys-ctrl no-lock.
     2338            ASSIGN
     2339               v-login = USERID("ub")
     2340               p-db-num = buf_sys-ctrl.db-num
     2341            .
     2342            FIND FIRST buf_user-login
     2343                 WHERE buf_user-login.db-num = p-db-num
     2344                   AND buf_user-login.user-login = v-login
     2345                 no-lock
     2346                 no-error
     2347                 .
     2348            IF AVAILABLE buf_user-login
     2349            THEN DO:
     2350               assign
     2351                  p-user-id = buf_user-login.user-id
     2352               .
     2353            END.
     2354      end.
     2355   end procedure.
     2356       run diasize_init in this-procedure .
     2357     assign
     2358       hand-log-msg-h = oxml-log:handle
     2359     g#esys = true
     2360     .
     2361     define variable mDBInfo as character no-undo.
     2362     run adm/db-info.p ( output v-db-num, output mDBInfo ) no-error .
     2363     if error-status:error then do:
     2364       run write-to-log( substitute( "&1. &2&3&4"
     2365                                     ,vss-workfile
     2366                                     ,mDBInfo
     2367                                     ,chr(10)
     2368                                     ,error-status:get-message(error-status:num-messages)
     2369                                   )
     2370                       ) .
     2371       return error.
     2372     end.
     2373     assign
     2374      frame oxmlhand:title = substitute("OpenXML &1", mDBInfo)
     2375      br-esys:num-locked-columns IN FRAME oxmlhand = 1
     2376     .
     2377     RUN Myenable in this-procedure.
     2378     do
     2379     on ERROR  undo, leave
     2380     on ENDKEY undo, leave
     2381     on STOP   undo, retry
     2382     :
     2383       wait-for go of frame oxmlhand.
     2384     end.
     2385   END.
     2386   RUN disable_UI.
     2387   PROCEDURE disable_UI :
     2388     HIDE FRAME oxmlhand.
     2389   END PROCEDURE.
     2390   PROCEDURE enable_UI :
     2391     DISPLAY oxml-log
     2392         WITH FRAME oxmlhand.
     2393     ENABLE b-quit b-create b-packlist b-help br-esys pck-sent b-send b-send-all
     2394            b-conf-pck b-info pck-rcvd b-imp-err b-get-pck b-send-new b-unsend
     2395            b-get b-proc-pck b-other oxml-log
     2396         WITH FRAME oxmlhand.
     2397     OPEN QUERY br-esys FOR EACH X_ext-system NO-LOCK by X_ext-system.esys-id    INDEXED-REPOSITION .    OPEN QUERY pck-sent FOR EACH X_esys-pck-sent.
     2398   END PROCEDURE.
     2399   PROCEDURE esys-key :
     2400   define input-output parameter p-key-passed-date as date no-undo .
     2401   define variable v-key-ok as logical no-undo .
     2402   define variable v-mess as character no-undo .
     2403   DEFINE VARIABLE v-today as date no-undo .
     2404   DEFINE VARIABLE v-time as integer no-undo .
     2405   run cur-time in this-procedure ( output v-today, output v-time).
     2406   if p-key-passed-date = ?
     2407   or p-key-passed-date < v-today then do:
     2408     run bge/esys-key.p ( input g#db-num
     2409                         ,input no
     2410                         ,output v-key-ok
     2411                         ,output v-mess) no-error.
     2412     if error-status:error then do:
     2413       message
     2414       substitute( "&2&1Ошибка при выполнении проверки конф. параметров по типам ВС&1&3&1&4"
     2415                                         , chr(10)
     2416                                         , vss-workfile
     2417                                         , return-value
     2418                                         , error-status :get-message( error-status :num-messages )
     2419                                                       )
     2420       view-as alert-box error.
     2421       return error.
     2422     end.
     2423     if not v-key-ok then do:
     2424       message
     2425       substitute( "При проверке конфигурационных параметров по типам ВС обнаружено несоответствие&1&2&1Продолжение работы невозможно&1"
     2426                                         , chr(10)
     2427                                         , v-mess       )
     2428       view-as alert-box error .
     2429       return error.
     2430     end.
     2431     assign
     2432     p-key-passed-date = v-today.
     2433   end.
     2434   END PROCEDURE.
     2435   PROCEDURE MyEnable :
     2436   b-other:MENU-MOUSE IN FRAME oxmlhand = 1.
     2437   DISPLAY oxml-log
     2438   WITH FRAME oxmlhand.
     2439   ENABLE
     2440   b-quit b-create b-help
     2441   br-esys
     2442   pck-sent
     2443   b-send
     2444   b-packlist
     2445   b-send-all
     2446   b-conf-pck
     2447   b-info
     2448   pck-rcvd
     2449   b-get-pck
     2450   b-send-new
     2451   b-other
     2452   b-unsend
     2453   b-get
     2454   b-proc-pck
     2455   oxml-log
     2456   WITH FRAME oxmlhand.
     2457   run Openbr-esys in this-procedure .
     2458   apply "VALUE-CHANGED" to br-esys.
     2459   apply "VALUE-CHANGED" to pck-rcvd.
     2460   END PROCEDURE.
     2461   PROCEDURE Openbr-esys :
     2462   OPEN QUERY br-esys FOR EACH X_ext-system NO-LOCK where
     2463   (X_ext-system.esys-have-export and
     2464       X_ext-system.esys-db-num-exp = buf_sys-ctrl.db-num)
     2465       or
     2466   (X_ext-system.esys-have-import and
     2467       X_ext-system.esys-db-num-imp = buf_sys-ctrl.db-num
     2468       )
     2469   by X_ext-system.esys-id
     2470       INDEXED-REPOSITION.
     2471   END PROCEDURE.
     2472   PROCEDURE Openbr-pck-rcvd :
     2473   OPEN QUERY pck-rcvd FOR EACH X_esys-pck-rcvd
     2474         WHERE X_esys-pck-rcvd.esys-id = X_ext-system.esys-id
     2475         and X_esys-pck-rcvd.db-num = X_ext-system.db-num
     2476         and X_esys-pck-rcvd.espr-cr-db-num = buf_sys-ctrl.db-num
     2477         NO-LOCK
     2478       BY X_esys-pck-rcvd.esys-id DESCENDING
     2479       BY X_esys-pck-rcvd.db-num DESCENDING
     2480       BY X_esys-pck-rcvd.espr-cr-db-num DESCENDING
     2481       BY X_esys-pck-rcvd.espr-pack-num DESCENDING INDEXED-REPOSITION.
     2482    END PROCEDURE.
     2483   PROCEDURE Openbr-pck-sent :
     2484   OPEN QUERY pck-sent FOR EACH X_esys-pck-sent
     2485         WHERE X_esys-pck-sent.esys-id = X_ext-system.esys-id
     2486         and X_esys-pck-sent.db-num = X_ext-system.db-num
     2487         and X_esys-pck-sent.esps-cr-db-num = buf_sys-ctrl.db-num
     2488         NO-LOCK
     2489       BY X_esys-pck-sent.esys-id DESCENDING
     2490       BY X_esys-pck-sent.db-num DESCENDING
     2491       BY X_esys-pck-sent.esps-cr-db-num DESCENDING
     2492       BY X_esys-pck-sent.esps-pack-num DESCENDING INDEXED-REPOSITION.
     2493   END PROCEDURE.
     2494   PROCEDURE refresh-brws :
     2495   define input parameter p-with-esys as logical no-undo .
     2496     define variable v-rowid as rowid no-undo .
     2497     if p-with-esys = true then do:
     2498       assign
     2499         log-res = browse br-esys:set-repositioned-row( browse br-esys :focused-row, 'CONDITIONAL':u)
     2500         v-rowid = rowid( X_ext-system )
     2501       .
     2502       run Openbr-esys in this-procedure.
     2503       reposition br-esys to rowid v-rowid no-error .
     2504     end.
     2505     run Openbr-pck-rcvd in this-procedure.
     2506     run Openbr-pck-sent in this-procedure.
     2507    if available X_esys-pck-sent then do:
     2508       assign
     2509         log-res = pck-sent:select-row( 1 ) IN FRAME oxmlhand
     2510       .
     2511     end.
     2512     if available X_esys-pck-rcvd then do:
     2513       assign
     2514         log-res = pck-rcvd:select-row( 1 ) IN FRAME oxmlhand
     2515       .
     2516     end.
     2517   END PROCEDURE.
