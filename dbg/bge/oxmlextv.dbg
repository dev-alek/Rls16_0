        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter p-unique-key         as character        no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: oxmlextv.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: bge/oxmlextv.p $":U .
        9   define variable vss-description as character no-undo init "openXML. Выбор внешней системы".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71     define variable v-cntxt-db-num        as integer   no-undo .
       72     define variable v-cntxt-userid        as character no-undo .
       73     define variable v-cntxt-level         as character no-undo .
       74     define variable v-cntxt-host-code-obj as integer   no-undo .
       75     define variable v-cntxt-obj-type      as character no-undo .
       76     define variable v-cntxt-obj-code      as integer   no-undo .
       77     define variable v-cntxt-db-num-obj    as integer   no-undo .
       78     define variable v-cntxt-is-admin      as logical   no-undo .
       79   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   procedure gen-key-rec :
       81     define input  parameter p-tbl-name    as character no-undo.
       82     define input  parameter p-bh_tbl-name as handle    no-undo.
       83     define output parameter p-key-rec     as character no-undo.
       84     do
       85     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       86     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       87     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       88     :
       89       define variable fh               as handle    no-undo .
       90       define variable v-ok             as logical   no-undo .
       91       define variable v-inform         as character no-undo .
       92       define variable v-ind            as integer   no-undo .
       93       define variable v-idx-field-qnty as integer   no-undo .
       94       if p-tbl-name = ?
       95         or p-tbl-name = "":U
       96       then do:
       97         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
       98       end.
       99       if not p-bh_tbl-name:available then do:
      100         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      101       end.
      102       assign
      103         p-key-rec = p-tbl-name
      104         v-inform  = p-bh_tbl-name:index-information(1)
      105         v-ind     = 2
      106       .
      107       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      108       on error undo, return error
      109       :
      110         assign
      111           v-inform = p-bh_tbl-name:index-information( v-ind )
      112           v-ind    = v-ind + 1
      113         .
      114       end.
      115       if v-inform = ?
      116         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      117         or entry( 3, v-inform, ",":U ) <> "1":U
      118       then do:
      119         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      120       end.
      121       else do:
      122         assign
      123           v-idx-field-qnty = num-entries( v-inform ) - 4
      124         .
      125         if v-idx-field-qnty < 2 then do:
      126           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      127         end.
      128         do v-ind = 1 to v-idx-field-qnty by 2
      129         on error undo, return error
      130         :
      131           assign
      132             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      133             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      134           .
      135         end.
      136       end.
      137       if p-key-rec = ? then do:
      138         assign
      139           p-key-rec = "":U
      140         .
      141         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      142       end.
      143     end.
      144     return.
      145   end procedure.
      146   procedure gen-where-keyr-tab :
      147     define input  parameter i-tableSerach as character no-undo.
      148     define input  parameter i-tablekey   as character  no-undo.
      149     define input  parameter p-key-rec    as character  no-undo.
      150     define input  parameter p-key-handle as handle     no-undo .
      151     define input  parameter p-db-name    as character  no-undo .
      152     define input  parameter p-tt-handle  as handle     no-undo .
      153     define output parameter o-Where      as character  no-undo.
      154     do
      155     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      156     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      157     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      158     :
      159       define variable v-full-tbl-name  as character no-undo .
      160       define variable bh_tbl-name      as handle    no-undo .
      161       define variable fh_key           as handle    no-undo .
      162       define variable fh_search        as handle    no-undo .
      163       define variable v-field-num      as integer   no-undo .
      164       define variable v-count-fld      as integer   no-undo .
      165       define variable v-inform         as character no-undo .
      166       define variable v-ind            as integer   no-undo .
      167       define variable v-idx-field-qnty as integer   no-undo .
      168       define variable v-field-name     as character no-undo .
      169       define variable v-field-val      as character no-undo .
      170       define variable v-word-link      as character no-undo .
      171       define variable vTable           as character no-undo.
      172       define variable bh_tbl-key       as handle    no-undo .
      173       assign
      174         p-key-rec = trim( p-key-rec )
      175       .
      176       if p-key-handle <> ? then do:
      177         if not valid-handle(p-key-handle)
      178            or p-key-handle:type <> "buffer"
      179         then do:
      180           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      181         end.
      182         if num-entries( p-key-rec, chr(3) ) > 1
      183           or p-key-rec = ?
      184           or p-key-rec = "":U
      185         then do:
      186           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      187         end.
      188       end.
      189       else do:
      190         if p-key-rec = ?
      191           or p-key-rec = "":U
      192         then do:
      193           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      194         end.
      195       end.
      196       assign
      197         vTable = entry( 1 , p-key-rec, chr(3) )
      198       .
      199       if p-tt-handle <> ?
      200         and ( not valid-handle(p-tt-handle)
      201               or p-tt-handle:type <> "buffer"
      202             )
      203       then do:
      204         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      205       end.
      206       if p-tt-handle = ? then do:
      207         assign
      208           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      209         .
      210         create buffer bh_tbl-name for table v-full-tbl-name .
      211       end.
      212       else do:
      213         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      214       end.
      215       assign
      216         v-inform = bh_tbl-name:index-information(1)
      217         v-ind    = 2
      218       .
      219       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      220       on error undo, return error
      221       :
      222         assign
      223           v-inform = bh_tbl-name:index-information( v-ind )
      224           v-ind    = v-ind + 1
      225         .
      226       end.
      227       if v-inform = ?
      228         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      229         or entry( 3, v-inform, ",":U ) <> "1":U
      230       then do:
      231         delete object bh_tbl-name no-error.
      232         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      233       end.
      234       assign
      235         v-idx-field-qnty = num-entries( v-inform ) - 4
      236       .
      237       if v-idx-field-qnty < 2 then do:
      238         delete object bh_tbl-name no-error.
      239         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      240       end.
      241       assign
      242         o-where     = "where":U
      243         v-word-link = "":U
      244         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      245         v-count-fld = 0
      246       .
      247       if i-tablekey ne "" and i-tablekey ne ?
      248       then do:
      249         assign
      250           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      251         .
      252         create buffer bh_tbl-key for table v-full-tbl-name .
      253       end.
      254       if i-tableSerach ne "" and i-tableSerach ne ?
      255       then do:
      256         delete object bh_tbl-name no-error.
      257         assign
      258           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      259         .
      260         create buffer bh_tbl-name for table v-full-tbl-name .
      261       end.
      262       block_where:
      263       do v-ind = 1 to v-idx-field-qnty by 2
      264       on error undo, return error
      265       :
      266         assign
      267           v-count-fld = v-count-fld + 1
      268         .
      269         if p-key-handle = ?
      270           and v-count-fld > v-field-num
      271         then do:
      272           leave block_where.
      273         end.
      274         define variable VfieldKeyTable as handle no-undo.
      275         assign
      276           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      277           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      278         .
      279         if     bh_tbl-key ne ?
      280         then do:
      281            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      282            if VfieldKeyTable eq ?
      283            then next block_where.
      284         end.
      285         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      286         then
      287            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      288         else
      289            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      290         if p-key-handle = ? then do:
      291           assign
      292             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      293           .
      294         end.
      295         else do:
      296           assign
      297             fh_key = p-key-handle:buffer-field( v-field-name )
      298           .
      299           if fh_key = ?
      300             or not valid-handle( fh_key )
      301           then do:
      302             delete object bh_tbl-name.
      303             if     bh_tbl-key ne ?
      304             then
      305                delete object bh_tbl-key.
      306             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      307           end.
      308           assign
      309             v-field-val = fh_key:buffer-value
      310           .
      311         end.
      312         if fh_search:data-type ="character":U then do:
      313           assign
      314             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      315             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      316             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      317             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      318             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      319             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      320             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      321             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      322             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      323             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      324             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      325             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      326             v-field-val = substitute( '"&1"', v-field-val )
      327           .
      328         end.
      329         assign
      330           o-where = substitute( "&1 &2", o-where, v-field-val )
      331         .
      332         if v-word-link = "":U then do:
      333           assign
      334             v-word-link = "and":U
      335           .
      336         end.
      337       end.
      338       delete object bh_tbl-name.
      339       if     bh_tbl-key ne ?
      340       then
      341          delete object bh_tbl-key.
      342       if p-key-handle = ?
      343         and v-count-fld <> v-field-num
      344       then do:
      345         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      346       end.
      347     end.
      348   end procedure.
      349   procedure gen-hn-keyr-tab :
      350     define input  parameter i-tableSerach as character no-undo.
      351     define input  parameter i-tablekey   as character no-undo.
      352     define input  parameter p-key-rec    as character no-undo.
      353     define input  parameter p-key-handle as handle    no-undo .
      354     define input  parameter p-db-name    as character no-undo .
      355     define input  parameter p-tt-handle  as handle    no-undo .
      356     define input  parameter p-stts-lock  as integer   no-undo .
      357     define output parameter o-hn         as handle    no-undo.
      358     define variable v-full-tbl-name as character no-undo.
      359     define variable v-where         as character no-undo.
      360     define variable bh_tbl-name     as handle    no-undo.
      361     define variable vTable          as character no-undo.
      362     do
      363     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      364     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      365     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      366         run gen-where-keyr-tab(i-tableSerach,
      367                                i-tablekey,
      368                                p-key-rec,
      369                                p-key-handle,
      370                                p-db-name,
      371                                p-tt-handle,
      372                                output v-where).
      373         if i-tableSerach ne "" and i-tableSerach ne ?
      374         then do:
      375            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      376            create buffer bh_tbl-name for table v-full-tbl-name .
      377         end.
      378         else do:
      379            if p-tt-handle = ? then do:
      380               assign
      381                  vTable = entry( 1 , p-key-rec, chr(3) )
      382               .
      383               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      384               create buffer bh_tbl-name for table v-full-tbl-name .
      385            end.
      386            else do:
      387               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      388            end.
      389         end.
      390         if p-tt-handle = ? then do:
      391            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      392         end.
      393         else do:
      394            bh_tbl-name:find-first( v-where ) no-error .
      395         end.
      396         o-hn = bh_tbl-name.
      397      end.
      398   end procedure.
      399   procedure gen-hn-keyr :
      400     define input  parameter p-key-rec    as character no-undo.
      401     define input  parameter p-key-handle as handle    no-undo .
      402     define input  parameter p-db-name    as character no-undo .
      403     define input  parameter p-tt-handle  as handle    no-undo .
      404     define input  parameter p-stts-lock  as integer   no-undo .
      405     define output parameter o-hn         as handle    no-undo.
      406     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      407   end.
      408   procedure gen-row-keyr :
      409     define input  parameter p-key-rec    as character no-undo.
      410     define input  parameter p-key-handle as handle    no-undo .
      411     define input  parameter p-db-name    as character no-undo .
      412     define input  parameter p-tt-handle  as handle    no-undo .
      413     define input  parameter p-stts-lock  as integer   no-undo .
      414     define output parameter p-tbl-row    as rowid     no-undo.
      415     define output parameter p-tbl-name   as character no-undo.
      416     define variable vHn as handle no-undo.
      417       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      418       p-tbl-row = if vHn:available then vHn:rowid else ?.
      419       p-tbl-name =  vHn:table.
      420       delete object vHn no-error.
      421     if p-tbl-row = ? then do:
      422       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      423     end.
      424     else do:
      425       return.
      426     end.
      427   end procedure.
      428   procedure gen-key-fv :
      429     define input  parameter p-key-rec    as character no-undo .
      430     define output parameter p-field-list as character no-undo .
      431     define output parameter p-value-list as character no-undo.
      432     do
      433     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      434     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      435     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      436     :
      437       define variable v-full-tbl-name  as character no-undo .
      438       define variable bh_tbl-name      as handle    no-undo .
      439       define variable v-tbl-name       as character no-undo .
      440       define variable v-field-num      as integer   no-undo .
      441       define variable v-count-fld      as integer   no-undo .
      442       define variable v-inform         as character no-undo .
      443       define variable v-ind            as integer   no-undo .
      444       define variable v-idx-field-qnty as integer   no-undo .
      445       define variable v-delim-key      as character no-undo .
      446       if p-key-rec = ?
      447         or p-key-rec = "":U
      448       then do:
      449         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      450       end.
      451       assign
      452         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      453         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      454       .
      455       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      456       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      457       assign
      458         v-inform = bh_tbl-name:index-information(1)
      459         v-ind    = 2
      460       .
      461       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      462       on error undo, return error
      463       :
      464         assign
      465           v-inform = bh_tbl-name:index-information( v-ind )
      466           v-ind    = v-ind + 1
      467         .
      468       end.
      469       if v-inform = ?
      470         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      471         or entry( 3, v-inform, ",":U ) <> "1":U
      472       then do:
      473         delete object bh_tbl-name no-error.
      474         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      475       end.
      476       assign
      477         v-idx-field-qnty = num-entries( v-inform ) - 4
      478       .
      479       if v-idx-field-qnty < 2 then do:
      480         delete object bh_tbl-name no-error.
      481         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      482       end.
      483       assign
      484         p-field-list = "":U
      485         p-value-list = "":U
      486         v-delim-key  = "":U
      487         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      488         v-count-fld  = 0
      489       .
      490       block_where:
      491       do v-ind = 1 to v-idx-field-qnty by 2
      492       on error undo, return error
      493       :
      494         assign
      495           v-count-fld = v-count-fld + 1
      496         .
      497         if v-count-fld > v-field-num then do:
      498           leave block_where.
      499         end.
      500         assign
      501           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      502           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      503         .
      504         if v-ind = 1 then do:
      505           assign
      506             v-delim-key = chr(3)
      507           .
      508         end.
      509       end.
      510       delete object bh_tbl-name.
      511       if v-count-fld <> v-field-num then do:
      512         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      513       end.
      514     end.
      515   end procedure.
      516   procedure gen-key-field :
      517     define input  parameter p-table      as character no-undo .
      518     define output parameter p-field-list as character no-undo .
      519     do
      520     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      521     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      522     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      523     :
      524       define variable v-full-tbl-name  as character no-undo .
      525       define variable bh_tbl-name      as handle    no-undo .
      526       define variable v-tbl-name       as character no-undo .
      527       define variable v-field-num      as integer   no-undo .
      528       define variable v-count-fld      as integer   no-undo .
      529       define variable v-inform         as character no-undo .
      530       define variable v-ind            as integer   no-undo .
      531       define variable v-idx-field-qnty as integer   no-undo .
      532       define variable v-delim-key      as character no-undo .
      533       if p-table = ?
      534         or p-table = "":U
      535       then do:
      536         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      537       end.
      538       assign
      539         v-tbl-name      = p-table
      540         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      541       .
      542       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      543       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      544       assign
      545         v-inform = bh_tbl-name:index-information(1)
      546         v-ind    = 2
      547       .
      548       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      549       on error undo, return error
      550       :
      551         assign
      552           v-inform = bh_tbl-name:index-information( v-ind )
      553           v-ind    = v-ind + 1
      554         .
      555       end.
      556       if v-inform = ?
      557         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      558         or entry( 3, v-inform, ",":U ) <> "1":U
      559       then do:
      560         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      561       end.
      562       assign
      563         v-idx-field-qnty = num-entries( v-inform ) - 4
      564       .
      565       if v-idx-field-qnty < 2 then do:
      566         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      567       end.
      568       assign
      569         p-field-list = "":U
      570         v-delim-key  = "":U
      571         v-count-fld  = 0
      572       .
      573       block_where:
      574       do v-ind = 1 to v-idx-field-qnty by 2
      575       on error undo, return error
      576       :
      577         assign
      578           v-count-fld = v-count-fld + 1
      579         .
      580         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      581         if v-ind = 1 then do:
      582           assign
      583             v-delim-key = chr(3)
      584           .
      585         end.
      586       end.
      587       delete object bh_tbl-name.
      588     end.
      589   end procedure.
      590       define variable v-esys-unique-key   as character    no-undo.
      591       define variable v-field-list        as character    no-undo.
      592       define variable v-value-list        as character    no-undo.
      593       define variable v-have-rights       as logical      no-undo.
      594       define variable v-current-db-num    as integer      no-undo.
      595       define variable v-success           as logical      no-undo.
      596       define variable v-esys-id           as integer      no-undo.
      597       define variable v-db-num            as integer      no-undo.
      598       define buffer buf_ext-system        for ub.ext-system.
      599   do
      600   for buf_ext-system
      601   on error undo, return error
      602   :
      603   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      604     run mainmenu_getcntxt in p-mainmenu-handle
      605       (output v-cntxt-db-num
      606       ,output v-cntxt-userid
      607       ,output v-cntxt-level
      608       ,output v-cntxt-host-code-obj
      609       ,output v-cntxt-obj-type
      610       ,output v-cntxt-obj-code
      611       ,output v-cntxt-db-num-obj
      612       ,output v-cntxt-is-admin
      613       ) .
      614   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      615   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      616     (output v-current-db-num
      617     )  .
      618       run gen-key-fv in this-procedure (
      619             input p-unique-key
      620           , output v-field-list
      621           , output v-value-list
      622       ).
      623   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      624   do:
      625     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      626       (input  v-cntxt-db-num
      627       ,input  v-cntxt-userid
      628       ,input  0
      629       ,input  'actn_openxml-subsystem_lookup':U
      630       ,input  'firm':U
      631       ,input  v-cntxt-host-code-obj
      632       ,input  '':U
      633       ,input  0
      634       ,input  0
      635       ,input  0
      636       ,input  0
      637       ,input  yes
      638       ,output v-have-rights
      639       )  .
      640   end.
      641       assign
      642           v-esys-id = integer( entry( 1, v-value-list, chr(3) ) )
      643           v-db-num  = integer( entry( 2, v-value-list, chr(3) ) )
      644       no-error.
      645       if error-status :error
      646       then do:
      647           message
      648                    vss-workfile vss-revision vss-description
      649               skip(1)
      650               skip "Ошибка преобразования первичного ключа, полученного при выборе"
      651               skip "Первичный ключ (поля):" v-field-list
      652               skip "Первичный ключ (значения):" v-value-list
      653           view-as alert-box error.
      654           undo, return error.
      655       end.
      656       find first buf_ext-system no-lock
      657            where buf_ext-system.esys-id = v-esys-id
      658              and buf_ext-system.db-num  = v-db-num
      659       no-error.
      660       if v-have-rights = yes
      661       and available buf_ext-system
      662       then do:
      663           run bge/oxmlextd.w (
      664                 input p-mainmenu-handle
      665               , input this-procedure
      666               , input 'ПРОСМОТР':U
      667               , input v-esys-id
      668               , input v-db-num
      669               , input v-current-db-num
      670               , output v-success
      671           ) no-error.
      672           if error-status :error
      673           then do:
      674               message
      675                       vss-workfile vss-revision vss-description
      676                   skip(1)
      677                   skip "Ошибка просмотра записи внешней подсистемы."
      678                   skip return-value
      679                   skip trim(error-status :get-message(1))
      680                       trim(error-status :get-message(2))
      681                       trim(error-status :get-message(3))
      682               view-as alert-box error.
      683               undo, return error .
      684           end.
      685       end.
      686   end.
