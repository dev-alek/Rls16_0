     1014   do
     1015   on error undo, return error
     1016   :
     1017       assign
     1018           p-out-string = "":U
     1019       .
     1020       case p-in-string
     1021       :
     1022           when ?
     1023           then do:
     1024               assign
     1025                   p-out-string = "?":U
     1026               .
     1027           end.
