     1054                       when chr(4)
     1055                       then do:
     1056                           assign
     1057                               p-out-string = p-out-string + " ":U
     1058                           .
     1059                       end.
     1060                       when chr(5)
     1061                       then do:
     1062                           assign
     1063                               p-out-string = p-out-string + " ":U
     1064                           .
     1065                       end.
     1066                       when chr(6)
     1067                       then do:
     1068                           assign
     1069                               p-out-string = p-out-string + " ":U
     1070                           .
     1071                       end.
     1072                       when chr(7)
     1073                       then do:
     1074                           assign
     1075                               p-out-string = p-out-string + " ":U
     1076                           .
     1077                       end.
     1078                       when chr(8)
     1079                       then do:
     1080                           assign
     1081                               p-out-string = p-out-string + " ":U
     1082                           .
