     1516   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1517                                             INPUT iFlagEmpty AS INTEGER).
     1518       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1519       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1520           DO:
     1521               IF iFlagEmpty = 0                           THEN RETURN "".
     1522               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1523               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1524               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1525               ELSE RETURN "".
     1526           END.
     1527       ELSE DO:
     1528           run xmlchar-encode in this-procedure (
     1529                 input sToPlace
     1530               , output sToPlace
     1531           ).
     1532           ASSIGN
     1533               sToPlace = sParName + '="' + sToPlace + '"'
     1534           .
     1535           RETURN sToPlace.
     1536       END.
     1537   END FUNCTION.
     1538   function bge-xml-date returns character
     1539   ( input p-date as date )
     1540   :
     1541     define variable v-date-str as character no-undo .
     1542     run bge-xml-date-to-str in this-procedure ( input   p-date
     1543                                               , output  v-date-str
     1544                                               ) .
     1545     return v-date-str.
     1546   end function.
     1547   function bge-xml-str-date returns character
     1548   ( input p-date-str as character )
     1549   :
     1550     define variable v-date-str as character no-undo .
     1551     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1552                                                   , output  v-date-str
     1553                                                   ) .
     1554     return v-date-str.
     1555   end function.
     1556   function bge-xml-normalize-dec returns decimal
     1557   ( input p-val as decimal )
     1558   :
     1559     return (if p-val = ? then 0 else p-val) .
     1560   end function.
     1561   PROCEDURE wp-XMLTagOpen:
     1562   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1563   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1564   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1565       define variable v-out-string    as character    no-undo.
     1566   do
     1567   on error undo, return error
     1568   :
     1569       if v-bge-xml-bgefmt = "dbf":U
     1570       then do:
     1571       end.
     1572       else do:
     1573           assign
     1574               v-out-string = substitute( "&1&2<&3&4>"
     1575                                       , chr(10)
     1576                                       , fill( " ":U, 4 * iTagLevel)
     1577                                       , sTagName
     1578                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1579                               )
     1580           .
     1581           put stream stmXMLOut unformatted
     1582               v-out-string
     1583           .
     1584       end.
     1585   end.
     1586   END PROCEDURE.
     1587   PROCEDURE wp-XMLTagPut:
     1588     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1589     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1590     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1591     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1592       define variable v-out-string    as character    no-undo.
     1593   do
     1594   on error undo, return error
     1595   :
     1596       if v-bge-xml-bgefmt = "dbf":U
     1597       then do:
     1598           if v-bge-xml-dbf-file-name <> "":U
     1599           then do:
     1600               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1601               export stream stmXMLOut
     1602                   sTagName
     1603                   sParValue
     1604               .
     1605               output stream stmXMLOut close.
     1606           end.
     1607       end.
     1608       else do:
     1609           IF  iFlagEmpty = 1
     1610           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1611           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1612           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1613           THEN DO:
     1614               run xmlchar-encode in this-procedure (
     1615                   input sParValue
     1616                   , output sParValue
     1617               ).
     1618               assign
     1619                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1620                                               , chr(10)
     1621                                               , FILL(" ", 4 * iTagLevel)
     1622                                               , sTagName
     1623                                               , sParValue
     1624                               )
     1625               .
     1626               PUT STREAM stmXMLOut UNFORMATTED
     1627                   v-out-string
     1628               .
     1629           END.
     1630       end.
     1631   end.
     1632   END PROCEDURE.
     1633   PROCEDURE wp-XMLTagClose:
     1634   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1635   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1636       define variable v-out-string    as character    no-undo.
     1637   do
     1638   on error undo, return error
     1639   :
     1640       if v-bge-xml-bgefmt = "dbf":U
     1641       then do:
     1642       end.
     1643       else do:
     1644           assign
     1645               v-out-string = substitute( "&1&2</&3>"
     1646                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1647                                   , fill( " ", 4 * iTagLevel )
     1648                                   , sTagName
     1649                           )
     1650           .
     1651           PUT STREAM stmXMLOut UNFORMATTED
     1652               v-out-string
     1653           .
     1654       end.
     1655   end.
     1656   END PROCEDURE.
     1657   PROCEDURE wp-XMLWriteLog:
     1658     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1659     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1660     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1661   define variable v-str              as character no-undo .
     1662   define variable v-error-append     as logical   no-undo .
     1663   define variable v-error-append-msg as character no-undo .
     1664   assign
     1665     v-str = chr(10)
     1666             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1667             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1668     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1669     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1670     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1671   .
     1672   run bge/bge-log.p (input v-str) no-error .
     1673   if error-status:error then do:
     1674     assign
     1675       v-error-append     = yes
     1676       v-error-append-msg = return-value
     1677     .
     1678   end.
     1679   run gbl/fileapnd.p
     1680     ( input sFileName
     1681     , input v-str
     1682     , input 10
     1683     ) no-error .
     1684   if error-status:error then do:
     1685     assign
     1686       v-error-append     = yes
     1687       v-error-append-msg = substitute( "&1&2&3"
     1688                                       , v-error-append-msg
     1689                                       , chr(10)
     1690                                       , return-value
     1691                                       )
     1692     .
     1693   end.
     1694   if v-error-append
     1695   then do:
     1696     return error substitute( "&1" , v-error-append-msg ) .
     1697   end.
     1698   END PROCEDURE.
     1699   PROCEDURE wp-XMLWriteEDT:
     1700     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1701     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1702     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1703       if valid-handle ( hEDT )
     1704       then do:
     1705           hEDT :move-to-eof().
     1706           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1707                                           OR sToWrite = "&Line") THEN "" ELSE
     1708                                           cur-time-string-sec() + " ").
     1709           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1710                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1711                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1712           hEDT :insert-string(chr(10)).
     1713       end.
     1714       process events.
     1715       output to 'bgescn.txt' append.
     1716           put unformatted
     1717               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1718                                           OR sToWrite = "&Line") THEN "" ELSE
     1719                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1720               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1721                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1722                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1723           .
     1724       output close.
     1725   END PROCEDURE.
     1726   PROCEDURE wp-XMLShowCNT:
     1727     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1728       if valid-handle( hCNT )
     1729       then do:
     1730           ASSIGN hCNT :VISIBLE = TRUE.
     1731       end.
     1732   END PROCEDURE.
     1733   PROCEDURE wp-XMLHideCNT:
     1734     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1735       if valid-handle( hCNT )
     1736       then do:
     1737           ASSIGN hCNT :VISIBLE = FALSE.
     1738       end.
     1739   END PROCEDURE.
     1740   PROCEDURE wp-XMLWriteCNT:
     1741     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1742     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1743       if valid-handle( hCNT )
     1744       then do:
     1745           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1746       end.
     1747   END PROCEDURE.
     1748   procedure bge-xml-write-header:
     1749   do
     1750   on error undo, return error
     1751   :
     1752   define input parameter p-xml-file-name  as character        no-undo.
     1753   define input parameter p-doc-name       as character        no-undo.
     1754   define input parameter p-version        as character        no-undo.
     1755   define input parameter p-db-num         as integer          no-undo.
     1756   define input parameter p-date-from      as date             no-undo.
     1757   define input parameter p-shift-num-from as integer          no-undo.
     1758   define input parameter p-date-to        as date             no-undo.
     1759   define input parameter p-shift-num-to   as integer          no-undo.
     1760   define input parameter p-obj-list       as character        no-undo.
     1761   define input parameter p-doc-type-list  as character        no-undo.
     1762   define input parameter p-pay-code       as logical          no-undo.
     1763   define input parameter p-cst            as logical          no-undo.
     1764   define input parameter p-parts          as logical          no-undo.
     1765   define input parameter p-chk-pay-code   as logical          no-undo.
     1766   define input parameter p-pay-desk       as logical          no-undo.
     1767   define input parameter p-pay-desk-cards as logical          no-undo.
     1768   define input parameter p-deleted        as logical          no-undo.
     1769   define input parameter p-opened-docs    as logical          no-undo.
     1770   define variable v-out-string    as character    no-undo.
     1771   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1772   assign
     1773       v-out-string = substitute( "&1&2&3"
     1774                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1775                           , chr(10)
     1776                           , "<IBS_Trade_House>":U )
     1777   .
     1778   put stream stmXMLOut unformatted
     1779       v-out-string
     1780   .
     1781   run wp-XMLTagOpen(1, "header","").
     1782   if v-bge-xml-bgeflold = "oracle":u
     1783   then do:
     1784     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1785     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1786     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1787     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1788     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1789   end.
     1790   run wp-XMLTagOpen( 2, "manifest", "").
     1791   run wp-XMLTagOpen( 3, "document", "").
     1792   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1793   run wp-XMLTagput( 4, "description", "", 0).
     1794   run wp-XMLTagput( 4, "version", p-version, 0).
     1795   run wp-XMLTagclose( 3, "document" ).
     1796   run wp-XMLTagclose( 2, "manifest" ).
     1797   run wp-XMLTagclose( 1, "header" ).
     1798   run wp-XMLTagOpen(1, "options","").
     1799   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1800   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1801   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1802   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1803   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1804   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1805   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1806   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1807   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1808   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1809   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1810   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1811   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1812   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1813   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1814   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1815   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1816   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1817   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1818   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1819   run wp-XMLTagClose(1, "options").
     1820   run wp-XMLTagOpen( 1, "body", "" ).
     1821   output stream stmXMLOut close.
     1822   end.
     1823   end procedure.
     1824   procedure xml-bge-write-footer:
     1825   do
     1826   on error undo, return error return-value
     1827   :
     1828   define input parameter p-xml-file-name as character    no-undo.
     1829   define variable v-error-num     as integer           no-undo.
     1830   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1831   run wp-XMLTagClose( 1, "body" ).
     1832   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1833   output stream stmXMLOut close.
     1834   if v-bge-xml-bgeflold = "oracle":u
     1835   then do:
     1836     define variable v-tmp-file-name         as character no-undo .
     1837     define variable v-zip-file-name         as character no-undo .
     1838     define variable v-exch-file-name        as character no-undo .
     1839     define variable v-heap-file-name        as character no-undo .
     1840     define variable v-i                     as integer   no-undo .
     1841     define variable v-file-name             as character no-undo .
     1842     define variable v-arc                   as character no-undo .
     1843     define variable v-str                   as character no-undo .
     1844     define variable v-exch-tmp-file-name    as character no-undo .
     1845     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1846     define variable v-bge-xml-exch-dir      as character no-undo .
     1847     define variable v-bge-xml-heap-dir      as character no-undo .
     1848     define variable v-bge-xml-compress-heap as logical   no-undo .
     1849     define variable v-home-dir              as character no-undo .
     1850     define variable v-os-command            as character no-undo .
     1851     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1852     if v-home-dir = ?
     1853     then do:
     1854       undo, return error substitute( "&1&2&3"
     1855                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1856                                     , chr(10)
     1857                                     , "Обратитесь к администратору.":u
     1858                                     ).
     1859     end.
     1860     assign
     1861       v-home-dir = v-home-dir
     1862     .
     1863     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1864     if error-status :error
     1865     then do:
     1866       undo, return error substitute( "&1&2&3"
     1867                                     , "Неверно задан каталог экспорта.":u
     1868                                     , chr(10)
     1869                                     , "Обратитесь к администратору.":u
     1870                                     ).
     1871     end.
     1872     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1873     if v-bge-xml-exch-dir = ?
     1874     then do:
     1875       undo, return error substitute( "&1&2&3"
     1876                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1877                                     , chr(10)
     1878                                     , "Обратитесь к администратору.":u
     1879                                     ).
     1880     end.
     1881     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1882     if error-status :error
     1883     then do:
     1884       undo, return error substitute( "&1&2&3"
     1885                                     , "Неверно задан каталог экспорта (exch).":u
     1886                                     , chr(10)
     1887                                     , "Обратитесь к администратору.":u
     1888                                     ).
     1889     end.
     1890     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1891     if v-bge-xml-heap-dir = ?
     1892     then do:
     1893       undo, return error substitute( "&1&2&3"
     1894                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1895                                     , chr(10)
     1896                                     , "Обратитесь к администратору.":u
     1897                                     ).
     1898     end.
     1899     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1900     if error-status :error
     1901     then do:
     1902       undo, return error substitute( "&1&2&3"
     1903                                     , "Неверно задан каталог экспорта (heap).":u
     1904                                     , chr(10)
     1905                                     , "Обратитесь к администратору.":u
     1906                                     ).
     1907     end.
     1908     get-key-value section "BGE" key "heap-compress" value v-str.
     1909     assign
     1910       v-i = int(v-str)
     1911     no-error .
     1912     if v-i = ? or v-i = 0
     1913     then do:
     1914       assign
     1915         v-bge-xml-compress-heap = no
     1916       .
     1917     end.
     1918     else do:
     1919       assign
     1920         v-bge-xml-compress-heap = yes
     1921       .
     1922     end.
     1923     assign
     1924       v-arc = search( "exe/7za.exe":u )
     1925     .
     1926     if v-arc = ? or v-arc = ""
     1927     then do:
     1928       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1929     end.
     1930     assign
     1931       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1932       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1933       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1934       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1935       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1936       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1937       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1938     .
     1939     run gbl/del-file.p (input v-tmp-file-name) .
     1940     run gbl/del-file.p (input v-zip-file-name) .
     1941     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1942     if v-error-num > 0
     1943     then do:
     1944         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1945                                      , p-xml-file-name + "xm1":u
     1946                                      , v-tmp-file-name
     1947                                      , v-error-num
     1948                                      ).
     1949     end.
     1950     assign
     1951       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1952                                    , v-arc
     1953                                    , v-zip-file-name
     1954                                    , v-tmp-file-name
     1955                                    )
     1956     .
     1957     os-command silent value ( v-os-command ) .
     1958     run gbl/del-file.p (input v-heap-file-name) .
     1959     if v-bge-xml-compress-heap = no
     1960     then do:
     1961       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1962       if v-error-num > 0
     1963       then do:
     1964           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1965                                        , v-tmp-file-name
     1966                                        , v-heap-file-name
     1967                                        , v-error-num
     1968                                        ) .
     1969       end.
     1970     end.
     1971     else do:
     1972       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1973       if v-error-num > 0
     1974       then do:
     1975           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1976                                        , v-zip-file-name
     1977                                        , v-heap-file-name
     1978                                        , v-error-num
     1979                                        ) .
     1980       end.
     1981     end.
     1982     run gbl/del-file.p (input v-tmp-file-name) .
     1983     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1984     if error-status :error then do:
     1985       undo, return error substitute( "&1&2&3"
     1986                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1987                                     , chr(10)
     1988                                     , "Обратитесь к администратору."
     1989                                     ).
     1990     end.
     1991     run gbl/del-file.p (input v-exch-file-name) .
     1992     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1993     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1994     if v-error-num > 0
     1995     then do:
     1996       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1997                                     , v-zip-file-name
     1998                                     , v-exch-tmp-file-name
     1999                                     , v-error-num
     2000                                     ) .
     2001     end.
     2002     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     2003     if v-error-num > 0
     2004     then do:
     2005       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     2006                                     , v-exch-tmp-file-name
     2007                                     , v-exch-file-name
     2008                                     , v-error-num
     2009                                     ) .
     2010     end.
     2011     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     2012   end.
     2013   else do:
     2014     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     2015     if v-error-num > 0
     2016     then do:
     2017       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     2018                                     , p-xml-file-name + "xm1"
     2019                                     , p-xml-file-name + "xml"
     2020                                     , v-error-num
     2021                                     ) .
     2022     end.
     2023   end.
     2024   if opsys = "unix"
     2025   then do:
     2026       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     2027   end.
     2028   end.
     2029   end procedure.
     2030   procedure xml-bge-filename0:
     2031   define input parameter p-prefix   as character no-undo .
     2032   define input parameter p-name     as character no-undo .
     2033   define input parameter p-shared-process as logical no-undo .
     2034   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     2035   define output parameter p-xml-file-name  as character no-undo .
     2036   // define output parameter p-fullfnamenoext as character no-undo .
     2037   define output parameter p-locked         as logical      no-undo.
     2038   define variable v-fullfnamenoext as character no-undo .
     2039   define variable v-fileext        as character no-undo .
     2040   define variable v-fullfname      as character no-undo .
     2041   define variable v-error-num      as integer   no-undo .
     2042   do
     2043   on error undo, return error
     2044   :
     2045     case v-bge-xml-bgeflold :
     2046       when "old" then do:
     2047         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     2048         v-fileext       = ".xml":U .
     2049         v-fullfname     = v-fullfnamenoext + v-fileext .
     2050         p-xml-file-name = v-fullfname .
     2051         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     2052         if v-error-num > 0 then do:
     2053           return error.
     2054         end.
     2055       end.
     2056       when "var" then do:
     2057         case p-prefix :
     2058           when "doc" then do:
     2059             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     2060             v-fileext       = ".xml":U .
     2061             v-fullfname     = v-fullfnamenoext + v-fileext .
     2062             p-xml-file-name = v-fullfname .
     2063           end.
     2064           when "day" then do:
     2065             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     2066             v-fileext       = ".xml":U .
     2067             v-fullfname     = v-fullfnamenoext + v-fileext .
     2068             p-xml-file-name = v-fullfname .
     2069           end.
     2070           otherwise do:
     2071             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     2072             v-fileext       = ".xml":U .
     2073             v-fullfname     = v-fullfnamenoext + v-fileext .
     2074             p-xml-file-name = v-fullfname .
     2075           end.
     2076         end case.
     2077         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     2078         if v-error-num > 0 then do:
     2079           return error.
     2080         end.
     2081       end.
     2082       when "new" then do:
     2083                   run bge/genfname.p (
     2084                       input p-home-dir
     2085                       , input p-prefix
     2086                       , input ""
     2087                       , input "xml"
     2088                       , input ""
     2089                       , output p-xml-file-name
     2090                   ).
     2091       end.
     2092       when "no-parameter" then do:
     2093         if p-shared-process then do:
     2094                       run bge/genfname.p (
     2095                           input p-home-dir
     2096                           , input "d"
     2097                           , input ""
     2098                           , input "xml"
     2099                           , input ""
     2100                           , output p-xml-file-name
     2101                       ).
     2102         end.
     2103         else do:
     2104           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     2105           v-fileext       = ".xml":U .
     2106           v-fullfname     = v-fullfnamenoext + v-fileext .
     2107           p-xml-file-name = v-fullfname .
     2108           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     2109           if v-error-num > 0 then do:
     2110             return error.
     2111           end.
     2112         end.
     2113       end.
     2114     end case.
     2115     assign
     2116       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2117       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     2118     .
     2119   end .
     2120   end procedure .
     2121   procedure xml-bge-filename :
     2122   do
     2123   on error undo, return error
     2124   :
     2125   define input parameter p-prefix             as character    no-undo.
     2126   define input parameter p-name               as character    no-undo.
     2127   define input parameter p-shared-process     as logical      no-undo.
     2128   define output parameter p-xml-file-name     as character    no-undo.
     2129   define output parameter p-log-file-name     as character    no-undo.
     2130   define output parameter p-locked            as logical      no-undo.
     2131   define variable v-home-dir          as character no-undo .
     2132   define variable v-error-num         as integer   no-undo .
     2133   define variable v-bge-xml-heap-dir  as character no-undo .
     2134       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2135       if v-home-dir = ?
     2136       then do:
     2137           message
     2138             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2139             skip(1)
     2140             skip "Обратитесь к администратору."
     2141           view-as alert-box error.
     2142           undo, return error .
     2143       end.
     2144       if v-bge-xml-bgeflold <> "oracle"
     2145       then do:
     2146         assign
     2147             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     2148         .
     2149       end.
     2150       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2151       if error-status :error
     2152       then do:
     2153           message
     2154             skip "Неверно задан каталог экспорта."
     2155             skip(1)
     2156             skip "Обратитесь к администратору."
     2157           view-as alert-box error.
     2158           undo, return error .
     2159       end.
     2160       if v-bge-xml-bgefmt = "dbf":U
     2161       then do:
     2162           assign
     2163               p-xml-file-name = v-home-dir
     2164               p-locked        = no
     2165           .
     2166       end.
     2167       else do:
     2168           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     2169             output p-xml-file-name, output p-locked) .
     2170       end.
     2171       if v-bge-xml-bgeflold = "oracle"
     2172       then do:
     2173         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     2174         if v-bge-xml-heap-dir = ?
     2175         then do:
     2176           undo, return error substitute( "&1&2&3"
     2177                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     2178                                         , chr(10)
     2179                                         , "Обратитесь к администратору.":u
     2180                                         ).
     2181         end.
     2182         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     2183         if error-status :error
     2184         then do:
     2185           undo, return error substitute( "&1&2&3"
     2186                                         , "Неверно задан каталог экспорта (heap).":u
     2187                                         , chr(10)
     2188                                         , "Обратитесь к администратору.":u
     2189                                         ).
     2190         end.
     2191         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     2192           assign
     2193             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     2194           .
     2195         end.
     2196         else do:
     2197           assign
     2198             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     2199           .
     2200         end.
     2201       end.
     2202       else do:
     2203         assign
     2204             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     2205         .
     2206       end.
     2207       assign
     2208          v-bge-xml-static-log-file-name = p-log-file-name
     2209       .
     2210   end.
     2211   end procedure.
     2212   procedure bge-xml-read-config :
     2213   do
     2214   on error undo, return error return-value
     2215   :
     2216   define input  parameter p-last-date as date      no-undo .
     2217   define input  parameter p-db-num    as integer   no-undo .
     2218       define variable v-bgeclall      as character     no-undo.
     2219       define variable v-bgedict       as character     no-undo.
     2220       define variable v-bgeshift      as character     no-undo.
     2221       define variable v-par-type      as character     no-undo.
     2222       define variable v-bgeflnm       as character     no-undo.
     2223       define variable v-bgecliiv      as character     no-undo .
     2224       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     2225       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     2226       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     2227       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     2228       define variable v-db-num-str    as character     no-undo .
     2229       define variable v-param-type      as character  no-undo .
     2230       define variable v-value-character as character  no-undo .
     2231       define variable v-value-date      as date       no-undo .
     2232       define variable v-value-decimal   as decimal    no-undo .
     2233       define variable v-value-integer   as integer    no-undo .
     2234       define variable v-value-logical   as logical    no-undo .
     2235       define variable v-tth             as handle      no-undo .
     2236       run adm/shattri.p ( input "get":U
     2237                         , input  '':u
     2238                         , input  0
     2239                         , input  'bge-export':U
     2240                         , input  'bgeclall':U
     2241                         , output v-bgecliiv
     2242                         , output v-value-date
     2243                         , output v-value-decimal
     2244                         , output v-value-integer
     2245                         , output v-value-logical
     2246                         , output v-param-type
     2247                         , input-output table-handle v-tth
     2248                         ) no-error .
     2249       if error-status :error
     2250       then do:
     2251         assign
     2252           v-bge-xml-bgecliiv = no
     2253         .
     2254       end.
     2255       else do:
     2256         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     2257       end.
     2258       delete object v-tth.
     2259       assign
     2260           v-bge-xml-bgeclall = no
     2261           v-bge-xml-bgedict  = no
     2262       .
     2263       run adm/shattri.p ( input "get":U
     2264                         , input  '':u
     2265                         , input  0
     2266                         , input  'bge-export':U
     2267                         , input  'bgeclall':U
     2268                         , output v-value-character
     2269                         , output v-value-date
     2270                         , output v-value-decimal
     2271                         , output v-value-integer
     2272                         , output v-value-logical
     2273                         , output v-param-type
     2274                         , input-output table-handle v-tth
     2275                         ) no-error .
     2276       if error-status :error
     2277       then do:
     2278         assign
     2279           v-bge-xml-bgeclall = no
     2280         .
     2281       end.
     2282       else do:
     2283         assign
     2284           v-bge-xml-bgeclall = v-value-logical
     2285         .
     2286       end.
     2287       delete object v-tth.
     2288       run adm/shattri.p ( input "get":U
     2289                         , input  '':u
     2290                         , input  0
     2291                         , input  'bge-export':U
     2292                         , input  'bgedict':U
     2293                         , output v-value-character
     2294                         , output v-value-date
     2295                         , output v-value-decimal
     2296                         , output v-value-integer
     2297                         , output v-value-logical
     2298                         , output v-param-type
     2299                         , input-output table-handle v-tth
     2300                         ) no-error .
     2301       if error-status :error
     2302       then do:
     2303         assign
     2304           v-bge-xml-bgedict = no
     2305         .
     2306       end.
     2307       else do:
     2308         assign
     2309           v-bge-xml-bgedict = v-value-logical
     2310         .
     2311       end.
     2312       delete object v-tth.
     2313       run adm/shattri.p ( input "get":U
     2314                         , input  '':u
     2315                         , input  0
     2316                         , input  'bge-export':U
     2317                         , input  'bgefmt':U
     2318                         , output v-value-character
     2319                         , output v-value-date
     2320                         , output v-value-decimal
     2321                         , output v-value-integer
     2322                         , output v-value-logical
     2323                         , output v-param-type
     2324                         , input-output table-handle v-tth
     2325                         ) no-error .
     2326       if error-status :error
     2327       then do:
     2328         assign
     2329           v-bge-xml-bgefmt  = "xml":U
     2330         .
     2331       end.
     2332       else do:
     2333         assign
     2334           v-bge-xml-bgefmt  = v-value-character
     2335         .
     2336       end.
     2337       delete object v-tth.
     2338       run adm/shattri.p ( input "get":U
     2339                         , input  '':u
     2340                         , input  0
     2341                         , input  'bge-export':U
     2342                         , input  'bgeshift':U
     2343                         , output v-value-character
     2344                         , output v-value-date
     2345                         , output v-value-decimal
     2346                         , output v-value-integer
     2347                         , output v-value-logical
     2348                         , output v-param-type
     2349                         , input-output table-handle v-tth
     2350                         ) no-error .
     2351       if error-status :error
     2352       then do:
     2353         assign
     2354             v-bge-xml-shift-mode = no
     2355         .
     2356       end.
     2357       else do:
     2358         assign
     2359             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     2360         .
     2361       end.
     2362       delete object v-tth.
     2363       run adm/shattri.p ( input "get":U
     2364                         , input  '':u
     2365                         , input  0
     2366                         , input  'bge-export':U
     2367                         , input  'bgeflold':U
     2368                         , output v-value-character
     2369                         , output v-value-date
     2370                         , output v-value-decimal
     2371                         , output v-value-integer
     2372                         , output v-value-logical
     2373                         , output v-param-type
     2374                         , input-output table-handle v-tth
     2375                         ) no-error .
     2376       if error-status :error
     2377       then do:
     2378         assign
     2379           v-bge-xml-bgeflold = "no-parameter":U
     2380         .
     2381       end.
     2382       else do:
     2383         assign
     2384           v-bge-xml-bgeflold  = v-value-character
     2385         .
     2386       end.
     2387       delete object v-tth.
     2388       assign
     2389         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     2390         v-bge-xml-db-num-str  = v-db-num-str
     2391       .
     2392       if p-last-date <> ?
     2393       then do:
     2394           run adm/shattri.p ( input "get":U
     2395                             , input  '':u
     2396                             , input  0
     2397                             , input  'bge-export':U
     2398                             , input  'bgeflnm':U
     2399                             , output v-value-character
     2400                             , output v-value-date
     2401                             , output v-value-decimal
     2402                             , output v-value-integer
     2403                             , output v-value-logical
     2404                             , output v-param-type
     2405                             , input-output table-handle v-tth
     2406                             ) no-error .
     2407           if error-status :error
     2408           then do:
     2409             assign
     2410               v-bgeflnm = '':U
     2411             .
     2412           end.
     2413           else do:
     2414             assign
     2415               v-bgeflnm = v-value-character
     2416             .
     2417           end.
     2418           delete object v-tth.
     2419           if v-bge-xml-bgeflold = "var"
     2420           then do:
     2421               if v-bgeflnm = ?
     2422               or num-entries( v-bgeflnm ) < 2
     2423               then do:
     2424                   assign
     2425                       v-bge-xml-bgeflold = "new"
     2426                   .
     2427               end.
     2428               else do:
     2429                   assign
     2430                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     2431                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     2432                   .
     2433                   assign
     2434                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     2435                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     2436                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2437                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     2438                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     2439                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     2440                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2441                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     2442                   .
     2443               end.
     2444           end.
     2445       end.
     2446   end.
     2447   end procedure.
     2448   procedure bge-xml-get-ref-filename :
     2449   define input parameter p-in-file-name       as character        no-undo.
     2450   define output parameter p-home-dir          as character        no-undo.
     2451   define output parameter p-out-file-name     as character        no-undo.
     2452   define output parameter p-locked            as logical          no-undo.
     2453       define variable v-counter       as integer      no-undo.
     2454       define variable v-error-level   as integer      no-undo.
     2455   do
     2456   on error undo, return error
     2457   :
     2458       run bge/bge-ini.p (
     2459             input "bge"
     2460           , output p-home-dir
     2461       ).
     2462       if return-value <> "OK"
     2463       then do:
     2464           undo, return error.
     2465       end.
     2466       assign
     2467           p-home-dir = p-home-dir + "\dict":U
     2468       .
     2469       run bge/dir_cd.p (
     2470           input p-home-dir
     2471           , input "CA"
     2472       ).
     2473       if return-value = "ERROR"
     2474       then do:
     2475           undo, return error.
     2476       end.
     2477       assign
     2478           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     2479       .
     2480       assign
     2481           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     2482       .
     2483       wait-lock:
     2484       do v-counter = 1 TO 3
     2485       :
     2486           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     2487           if p-locked = no
     2488           then do:
     2489               leave wait-lock.
     2490           end.
     2491           else do:
     2492               readkey pause 1.
     2493           end.
     2494       END.
     2495       if p-locked = yes
     2496       then do:
     2497           undo, return error.
     2498       end.
     2499       run bge/os_copy.p (
     2500             input "D":U
     2501           , input p-out-file-name + "xml":U
     2502           , input "":U
     2503           , output v-error-level
     2504       ).
     2505       if v-error-level > 0
     2506       then do:
     2507           undo, return error.
     2508       end.
     2509   end.
     2510   end procedure.
     2511   procedure bge-xml-write-ref-header :
     2512   define input parameter p-bge-name as character        no-undo.
     2513   define input parameter p-file-name as character        no-undo.
     2514       define variable v-out-string    as character    no-undo.
     2515   do
     2516   on error undo, return error
     2517   :
     2518       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2519       put stream stmXMLOut unformatted
     2520           "<?xml version='1.0' encoding='windows-1251'?>":U
     2521       .
     2522       assign
     2523           v-out-string = substitute( "&1&2"
     2524                               , chr(10)
     2525                               , "<IBS_Trade_House>":U )
     2526       .
     2527       put stream stmXMLOut unformatted
     2528           v-out-string
     2529       .
     2530       run wp-XMLTagOpen( 1, "header", "" ).
     2531       if v-bge-xml-bgeflold = "oracle":u
     2532       then do:
     2533         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2534         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2535         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2536         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2537         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2538       end.
     2539       else do:
     2540         run wp-XMLTagOpen( 2, "delivery", "" ).
     2541         run wp-XMLTagOpen( 3, "to", "" ).
     2542         run wp-XMLTagClose( 3, "to" ).
     2543         run wp-XMLTagOpen( 3, "from", "" ).
     2544         run wp-XMLTagClose( 3, "from" ).
     2545         run wp-XMLTagClose( 2, "delivery" ).
     2546       end.
     2547       run wp-XMLTagOpen( 2, "manifest", "" ).
     2548       run wp-XMLTagOpen( 3, "document", "" ).
     2549       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2550       run wp-XMLTagPut( 4, "description", "", 0 ).
     2551       run wp-XMLTagClose( 3, "document" ).
     2552       run wp-XMLTagClose( 2, "manifest" ).
     2553       run wp-XMLTagClose( 1, "header" ).
     2554       run wp-XMLTagOpen( 1, "body", "" ).
     2555   end.
     2556   end procedure.
     2557   procedure bge-xml-write-ref-footer :
     2558   define input parameter p-file-name as character        no-undo.
     2559       define variable v-error-level   as integer      no-undo.
     2560   do
     2561   on error undo, return error
     2562   :
     2563       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2564       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2565       output stream stmXMLOut close.
     2566       run bge/os_copy.p (
     2567             input "M":U
     2568           , input p-file-name + "xm1":U
     2569           , input p-file-name + "xml":U
     2570           , output v-error-level
     2571       ).
     2572       if v-error-level > 0
     2573       then do:
     2574           undo, return error.
     2575       end.
     2576   end.
     2577   end procedure.
     2578   procedure bge-xml-out-dir :
     2579   define output parameter p-out-dir       as character    no-undo.
     2580   define output parameter p-log-file-name as character    no-undo.
     2581   do
     2582   on error undo, return error
     2583   :
     2584       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2585       if p-out-dir = ?
     2586       then do:
     2587           message
     2588             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2589                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2590             skip(1)
     2591             skip "Обратитесь к администратору."
     2592           view-as alert-box error.
     2593           undo, return error .
     2594       end.
     2595       if v-bge-xml-bgeflold <> "oracle" then assign
     2596         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2597       .
     2598       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2599       if error-status :error  then do:
     2600           run wp-XMLWriteLog in this-procedure (
     2601                 input p-log-file-name
     2602               , input 0
     2603               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2604                                   , p-out-dir
     2605                                   , return-value
     2606                                   , trim( error-status :get-message( 1 ) )
     2607                                   )
     2608           ).
     2609           undo, return error.
     2610       end.
     2611       assign
     2612           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2613           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2614       .
     2615   end.
     2616   end procedure.
     2617   procedure bge-xml-out-dir2 :
     2618   define output parameter p-out-dir       as character    no-undo.
     2619   define output parameter p-out-dirR      as character    no-undo.
     2620   define output parameter p-log-file-name as character    no-undo.
     2621   do
     2622   on error undo, return error
     2623   :
     2624       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2625       if p-out-dir = ?
     2626       then do:
     2627           message
     2628             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2629                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2630             skip(1)
     2631             skip "Обратитесь к администратору."
     2632           view-as alert-box error.
     2633           undo, return error .
     2634       end.
     2635       if v-bge-xml-bgeflold <> "oracle" then assign
     2636             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2637             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2638         .
     2639       else p-out-dirR = p-out-dir .
     2640       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2641       if error-status :error  then do:
     2642           run wp-XMLWriteLog in this-procedure (
     2643                 input p-log-file-name
     2644               , input 0
     2645               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2646                                   , p-out-dir
     2647                                   , return-value
     2648                                   , error-status :get-message( 1 )
     2649                                   )
     2650           ).
     2651           undo, return error.
     2652       end.
     2653       if p-out-dirR <> p-out-dir then do:
     2654         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2655         if error-status :error then do:
     2656           run wp-XMLWriteLog in this-procedure (
     2657                 input p-log-file-name
     2658               , input 0
     2659               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2660                                   , p-out-dirR
     2661                                   , return-value
     2662                                   , error-status :get-message( 1 )
     2663                                   )
     2664           ).
     2665           p-out-dirR = p-out-dir .
     2666         end.
     2667       end .
     2668       assign
     2669         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2670         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2671       .
     2672   end.
     2673   end procedure.
     2674   procedure bge-xml-out-file :
     2675   do
     2676   on error undo, return error
     2677   :
     2678   define input parameter p-out-dir            as character        no-undo.
     2679   define input parameter p-prefix             as character        no-undo.
     2680   define input parameter p-sheduled           as logical          no-undo.
     2681   define output parameter p-xml-file-name     as character        no-undo.
     2682   define output parameter p-locked            as logical          no-undo.
     2683   define variable v-home-dir      as character     no-undo.
     2684   define variable v-error-num     as integer       no-undo.
     2685   define variable v-today             as date         no-undo.
     2686   define variable v-time              as integer      no-undo.
     2687       if v-bge-xml-bgefmt = "dbf":U
     2688       then do:
     2689           assign
     2690               p-xml-file-name = p-out-dir
     2691               p-locked        = no
     2692           .
     2693       end.
     2694       else do:
     2695           if v-bge-xml-bgeflold = "firm":U
     2696           then do:
     2697               run bge/genfname.p (
     2698                     input p-out-dir
     2699                   , input p-prefix
     2700                   , input "":U
     2701                   , input "arj":U
     2702                   , input "":U
     2703                   , output p-xml-file-name
     2704               ).
     2705           end.
     2706           else do:
     2707               run bge/genfname.p (
     2708                     input p-out-dir
     2709                   , input p-prefix
     2710                   , input "":U
     2711                   , input "xml":U
     2712                   , input "":U
     2713                   , output p-xml-file-name
     2714               ).
     2715           end.
     2716           assign
     2717               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2718               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2719           .
     2720       end.
     2721   end.
     2722   end procedure.
     2723   procedure bge-xml-init-ext-doc-type :
     2724       define variable v-counter    as integer      no-undo.
     2725       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2726   do
     2727   for buf_temp_ext-doc-type
     2728   on error undo, return error
     2729   :
     2730       empty temp-table buf_temp_ext-doc-type.
     2731       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2732       :
     2733           create buf_temp_ext-doc-type.
     2734           assign
     2735               buf_temp_ext-doc-type.edt-key               = v-counter
     2736               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2737               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2738           .
     2739       end.
     2740   end.
     2741   end procedure.
     2742   procedure bge-xml-get-decimal-shift-num :
     2743   define input parameter p-shift-date     as date             no-undo.
     2744   define input parameter p-shift-num      as integer          no-undo.
     2745   define output parameter p-shift-decimal as decimal          no-undo.
     2746   do
     2747   on error undo, return error
     2748   :
     2749       assign
     2750           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2751       .
     2752   end.
     2753   end procedure.
     2754   procedure bge-xml-ora-exp-filename :
     2755     define input  parameter p-table-name  as character no-undo .
     2756     define input  parameter p-doc-code    as character no-undo .
     2757     define input  parameter p-obj-code    as integer   no-undo .
     2758     define output parameter p-filename    as character no-undo .
     2759     define output parameter p-seq-num     as integer   no-undo .
     2760     define variable v-ora-exp-seq     as integer   no-undo .
     2761     define variable v-ora-exp-seq-str as character no-undo .
     2762     define variable v-home-dir        as character no-undo.
     2763   do
     2764   on error undo, return error return-value
     2765   :
     2766     if v-bge-xml-bgeflold = "oracle":u
     2767     then do:
     2768       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2769       if v-home-dir = ?
     2770       then do:
     2771         undo, return error substitute( "&1&2&3":U
     2772                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2773                                       , chr(10)
     2774                                       , "Обратитесь к администратору.":U
     2775                                       ).
     2776       end.
     2777       assign
     2778           v-home-dir = v-home-dir
     2779       .
     2780       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2781       if error-status :error
     2782       then do:
     2783         undo, return error substitute( "&1&2&3":U
     2784                                       , "Неверно задан каталог экспорта.":U
     2785                                       , chr(10)
     2786                                       , "Обратитесь к администратору.":U
     2787                                       ).
     2788       end.
     2789       assign
     2790         v-ora-exp-seq = ?
     2791       .
     2792       if  p-table-name <> ? and
     2793           p-doc-code <> ?
     2794       then do:
     2795         run bge/get-oesq.p ( input p-table-name
     2796                            , input p-doc-code
     2797                            , output v-ora-exp-seq
     2798                            ) no-error .
     2799         if error-status :error = yes
     2800         then do:
     2801           undo, return error return-value .
     2802         end.
     2803       end.
     2804       if v-ora-exp-seq = ?
     2805       then do:
     2806         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2807         if error-status :error
     2808         then do:
     2809           undo, return error return-value .
     2810         end.
     2811       end.
     2812       if p-table-name <> ? and
     2813          p-doc-code   <> ?
     2814       then do:
     2815         run bge/oesqdoc.p ( input p-table-name
     2816                           , input p-doc-code
     2817                           , input v-ora-exp-seq
     2818                           ) no-error .
     2819         if error-status :error = yes
     2820         then do:
     2821           undo, return error return-value .
     2822         end.
     2823       end.
     2824       assign
     2825         p-seq-num  = v-ora-exp-seq
     2826         p-filename = substitute("&1/&2-000_&3."
     2827                                , v-home-dir
     2828                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2829                                , string(v-ora-exp-seq , "999999999")
     2830                                )
     2831       .
     2832     end.
     2833   end.
     2834   end procedure.
     2835   procedure bge-xml-date-to-str :
     2836     define input  parameter p-date  as date      no-undo .
     2837     define output parameter p-str   as character no-undo .
     2838   do
     2839   on error undo, return error return-value
     2840   :
     2841     if p-date <> ?
     2842     then do:
     2843       assign
     2844         p-str = substitute( "&1-&2-&3"
     2845                           , string( year(p-date)  , "9999")
     2846                           , string( month(p-date) , "99"  )
     2847                           , string( day(p-date)   , "99"  )
     2848                           )
     2849       .
     2850     end.
     2851     else do:
     2852       assign
     2853         p-str = ?
     2854       .
     2855     end.
     2856   end.
     2857   end procedure.
     2858   procedure bge-xml-date-str-to-str :
     2859     define input  parameter p-date-str  as character no-undo .
     2860     define output parameter p-str       as character no-undo .
     2861     define variable v-date          as date      no-undo .
     2862     define variable v-date-valid    as logical   no-undo .
     2863     define variable v-error-message as character no-undo .
     2864   do
     2865   on error undo, return error return-value
     2866   :
     2867     assign
     2868       p-str = ?
     2869     .
     2870     if p-date-str = ? or p-date-str = ""
     2871     then do:
     2872       return .
     2873     end.
     2874     run strtdate in this-procedure ( input  p-date-str
     2875                                    , output v-date
     2876                                    , output v-date-valid
     2877                                    , output v-error-message
     2878                                    ).
     2879     if v-date-valid <> true
     2880     then do:
     2881       return .
     2882     end.
     2883     assign
     2884       p-str = substitute( "&1-&2-&3"
     2885                         , string( year(v-date)  , "9999")
     2886                         , string( month(v-date) , "99"  )
     2887                         , string( day(v-date)   , "99"  )
     2888                         )
     2889     .
     2890   end.
     2891   end procedure.
     2892   procedure bge-xml-fill-tt-bgecliiv :
     2893     define input  parameter p-str as character no-undo .
     2894     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2895     define buffer buf_clients             for ub.clients.
     2896     define variable v-i         as integer   no-undo .
     2897     define variable v-count     as integer   no-undo .
     2898     define variable v-cli-count as integer   no-undo .
     2899     define variable v-client    as character no-undo .
     2900     define variable v-obj-type  as character no-undo .
     2901     define variable v-obj-code  as integer   no-undo .
     2902   do
     2903   on error undo, return error return-value
     2904   :
     2905     empty temp-table buf_tt-bge-xml-bgecliiv.
     2906     assign
     2907       v-bge-xml-bgecliiv = no
     2908       v-cli-count        = num-entries(p-str,';')
     2909     .
     2910     if v-cli-count > 0
     2911     then do:
     2912       _cli-cycle:
     2913       do v-i = 1 to v-cli-count
     2914       :
     2915         assign
     2916           v-client = entry(v-i , p-str, ';')
     2917         .
     2918         if num-entries(v-client) <> 2
     2919         then do:
     2920           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2921         end.
     2922         assign
     2923           v-obj-type = entry(1, v-client)
     2924         .
     2925         assign
     2926           v-obj-code = integer(entry(2, v-client))
     2927         no-error .
     2928         if error-status :error
     2929         then do:
     2930           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2931         end.
     2932         find first buf_clients no-lock
     2933           where buf_clients.obj-type = v-obj-type
     2934             and buf_clients.obj-code = v-obj-code
     2935         no-error.
     2936         if not available buf_clients
     2937         then do:
     2938           next _cli-cycle.
     2939         end.
     2940         find first buf_tt-bge-xml-bgecliiv no-lock
     2941           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2942             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2943         no-error .
     2944         if available buf_tt-bge-xml-bgecliiv
     2945         then do:
     2946           next _cli-cycle.
     2947         end.
     2948         create buf_tt-bge-xml-bgecliiv.
     2949         assign
     2950           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2951           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2952         .
     2953       end.
     2954     end.
     2955     else do:
     2956       assign
     2957         v-bge-xml-bgecliiv = no
     2958       .
     2959       return .
     2960     end.
     2961     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2962     if available buf_tt-bge-xml-bgecliiv
     2963     then do:
     2964       assign
     2965         v-bge-xml-bgecliiv = yes
     2966       .
     2967     end.
     2968   end.
     2969   end procedure.
     2970   procedure bge-xml-resolve-ext-doc-type :
     2971     define input  parameter p-ext-doc-type      as character no-undo .
     2972     define input  parameter p-obj-type          as character no-undo .
     2973     define input  parameter p-obj-code          as integer   no-undo .
     2974     define output parameter p-out-ext-doc-type  as character no-undo .
     2975     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2976   do
     2977   on error undo, return error return-value
     2978   :
     2979     assign
     2980       p-out-ext-doc-type = p-ext-doc-type
     2981     .
     2982     if p-ext-doc-type <> 'ie':U
     2983     then do:
     2984       return .
     2985     end.
     2986     if v-bge-xml-bgecliiv = yes
     2987     then do:
     2988       find first buf_tt-bge-xml-bgecliiv no-lock
     2989         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2990           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2991       no-error .
     2992       if available buf_tt-bge-xml-bgecliiv
     2993       then do:
     2994         assign
     2995           p-out-ext-doc-type = 'iv':U
     2996         .
     2997       end.
     2998     end.
     2999   end.
     3000   end procedure.
     3001   procedure safe-wp-xmltagput :
     3002     define input  parameter pTagLevel   as integer   no-undo .
     3003     define input  parameter pTagName    as character no-undo .
     3004     define input  parameter pParValue   as character no-undo .
     3005     define input  parameter pFlagEmpty  as integer   no-undo .
     3006   do
     3007   on error undo, return error return-value
     3008   :
     3009     if v-bge-xml-bgeflold = "oracle":u
     3010     then do:
     3011       return .
     3012     end.
     3013     run wp-xmltagput in this-procedure ( input pTagLevel
     3014                                        , input pTagName
     3015                                        , input pParValue
     3016                                        , input pFlagEmpty
     3017                                        ).
     3018   end.
     3019   end procedure.
     3020   define variable vss-include-info6 as character format "X(65)" no-undo
     3021   initial "@(#)$Workfile$ $Revision$".
     3022   define temp-table temp_dbflib_field no-undo
     3023       field field-name        as character    format "x(32)"
     3024       field data-type         as character
     3025       field field-decimals    as integer
     3026       field dbfield-name      as character    format "x(11)"
     3027       field field-handle      as handle
     3028       field field-length      as integer      format ">>>9"
     3029       index field-name        is primary unique
     3030           field-name
     3031   .
     3032   define temp-table temp_dbflib_data no-undo
     3033       field record-number as integer
     3034       field field-name    as character
     3035       field data-value    as character
     3036       index pi is primary unique
     3037           record-number
     3038           field-name
     3039   .
     3040   define variable v-dbflib-reclength      as integer      no-undo.
     3041   define variable v-field-amount          as integer      no-undo.
     3042   define stream dbf-stream.
     3043   procedure dbflib-write-dbf :
     3044   define input parameter p-filename       as character        no-undo.
     3045   define input parameter p-record-amount  as integer          no-undo.
     3046       define variable v-date          as date         no-undo.
     3047       define variable v-string-value  as character    no-undo.
     3048       define variable raw-value       as raw          no-undo.
     3049       define variable v-record-count  as integer      no-undo.
     3050       define buffer buf_temp_dbflib_field    for temp_dbflib_field.
     3051       define buffer buf_temp_dbflib_data     for temp_dbflib_data.
     3052   do
     3053   for buf_temp_dbflib_field
     3054     , buf_temp_dbflib_data
     3055   on error undo, return error
     3056   :
     3057       output stream dbf-stream to value( p-filename ) binary no-convert.
     3058       put stream dbf-stream
     3059           control "~003":U
     3060       .
     3061       run dbflib-makebinary (
     3062             input year( today ) - 2000
     3063           , input 1
     3064           , output raw-value
     3065       ).
     3066       put stream dbf-stream control raw-value.
     3067       run dbflib-makebinary (
     3068           month( today )
     3069           , input 1
     3070           , output raw-value
     3071       ).
     3072       put stream dbf-stream control raw-value.
     3073       run dbflib-makebinary (
     3074             input day( today )
     3075           , input 1
     3076           , output raw-value
     3077       ).
     3078       put stream dbf-stream control raw-value.
     3079       run dbflib-makebinary (
     3080             input p-record-amount
     3081           , input 4
     3082           , output raw-value
     3083       ).
     3084       put stream dbf-stream control raw-value.
     3085       run dbflib-makebinary (
     3086             input ( 32 + 32 * v-field-amount + 1 )
     3087           , input 2
     3088           , output raw-value
     3089       ).
     3090       put stream dbf-stream control raw-value.
     3091       run dbflib-makebinary (
     3092             input v-dbflib-reclength + 1
     3093           , input 2
     3094           , output raw-value
     3095       ).
     3096       put stream dbf-stream control raw-value.
     3097       put stream dbf-stream control null( 20 ).
     3098       for each buf_temp_dbflib_field
     3099       :
     3100           put stream dbf-stream control
     3101               buf_temp_dbflib_field.dbfield-name
     3102               null( 11 - length( buf_temp_dbflib_field.dbfield-name ) )
     3103           .
     3104           case buf_temp_dbflib_field.data-type:
     3105               when "character":U
     3106               then do:
     3107                   put stream dbf-stream "C".
     3108               end.
     3109               when "integer":U
     3110               or when "decimal"
     3111               then do:
     3112                   put stream dbf-stream "N".
     3113               end.
     3114               when "logical":U
     3115               then do:
     3116                   put stream dbf-stream "L".
     3117               end.
     3118               when "date":U
     3119               then do:
     3120                   put stream dbf-stream "D".
     3121               end.
     3122               otherwise do:
     3123                   undo, return error substitute("Unknown field type for &1: &2",
     3124                                                   buf_temp_dbflib_field.field-handle:name,
     3125                                                   buf_temp_dbflib_field.data-type).
     3126               end.
     3127           end case.
     3128           put stream dbf-stream control
     3129               null( 4 )
     3130               chr( buf_temp_dbflib_field.field-length )
     3131           .
     3132           if buf_temp_dbflib_field.field-decimals = 0
     3133           then do:
     3134               put stream dbf-stream control null.
     3135           end.
     3136           else do:
     3137               put stream dbf-stream control
     3138                   chr( buf_temp_dbflib_field.field-decimals )
     3139               .
     3140           end.
     3141           put stream dbf-stream control
     3142               null(2)
     3143               chr(1)
     3144               null(11)
     3145          .
     3146       end.
     3147       put stream dbf-stream control
     3148           chr(13)
     3149       .
     3150       do v-record-count = 1 to p-record-amount
     3151       on error undo, return error
     3152       :
     3153           for each buf_temp_dbflib_data
     3154              where buf_temp_dbflib_data.record-number = v-record-count
     3155           :
     3156               put stream dbf-stream
     3157                   " "
     3158               .
     3159               find first buf_temp_dbflib_field
     3160               where buf_temp_dbflib_field.field-name = buf_temp_dbflib_data.field-name
     3161               no-error.
     3162               if available buf_temp_dbflib_field
     3163               then do:
     3164                   case buf_temp_dbflib_field.data-type
     3165                   :
     3166                       when "logical":U
     3167                       then do:
     3168                           put stream dbf-stream unformatted
     3169                               ( if buf_temp_dbflib_data.data-value = "yes":U
     3170                               then "T":U
     3171                               else "F":U )
     3172                           .
     3173                       end.
     3174                       when "date":U
     3175                       then do:
     3176                           assign
     3177                               v-date = date( buf_temp_dbflib_data.data-value )
     3178                           .
     3179                           put stream dbf-stream unformatted
     3180                               year( v-date )
     3181                               month( v-date ) format "99"
     3182                               day( v-date ) format "99"
     3183                           .
     3184                       end.
     3185                       when "decimal":U
     3186                       or when "integer":U
     3187                       then do:
     3188                           if session:numeric-format = "EUROPEAN":U
     3189                           then do:
     3190                               assign
     3191                                   v-string-value = replace( string( buf_temp_dbflib_data.data-value ), ".":U, "":U )
     3192                                   v-string-value = replace( v-string-value, ",":U, ".":U )
     3193                               .
     3194                           end.
     3195                           else do:
     3196                               assign
     3197                                   v-string-value = replace( string( buf_temp_dbflib_data.data-value ),",","")
     3198                               .
     3199                           end.
     3200                           put stream dbf-stream unformatted
     3201                               v-string-value
     3202                               fill( " ":U, buf_temp_dbflib_field.field-length - length( v-string-value ) )
     3203                           .
     3204                       end.
     3205                       otherwise do:
     3206                           put stream dbf-stream unformatted
     3207                               string( buf_temp_dbflib_data.data-value )
     3208                               fill( " ", buf_temp_dbflib_field.field-length - length( string( buf_temp_dbflib_data.data-value ) ) )
     3209                           .
     3210                       end.
     3211                   end case.
     3212               end.
     3213           end.
     3214       end.
     3215       output stream dbf-stream close.
     3216   end.
     3217   end procedure.
     3218   PROCEDURE dbflib-makebinary:
     3219   define input parameter anumm#     as integer      no-undo.
     3220   define input parameter abyte#     as integer      no-undo.
     3221   define output parameter raw-value as raw          no-undo.
     3222       define variable acoun#    as integer      no-undo.
     3223   do
     3224   on error undo, return error
     3225   :
     3226       assign
     3227           length( raw-value ) = abyte#
     3228       .
     3229       if anumm# <0
     3230       then do:
     3231           message
     3232                    vss-workfile vss-revision vss-description
     3233               skip(1)
     3234               skip ": This routine works for positive integers only."
     3235               skip "Received value of" anumm# "is invalid."
     3236               skip return-value
     3237               skip trim(error-status :get-message(1))
     3238                    trim(error-status :get-message(2))
     3239                    trim(error-status :get-message(3))
     3240           view-as alert-box error
     3241           title "Conversion to binary".
     3242           undo, return error .
     3243       end.
     3244       if anumm# > 0
     3245       and anumm# modulo anumm# / EXP( anumm#, abyte#) > 256
     3246       then do:
     3247           message
     3248                    vss-workfile vss-revision vss-description
     3249               skip(1)
     3250               skip ": received number" anumm#
     3251               skip "does not fit in" abyte# "bytes."
     3252               skip return-value
     3253               skip trim(error-status :get-message(1))
     3254                    trim(error-status :get-message(2))
     3255                    trim(error-status :get-message(3))
     3256           view-as alert-box error
     3257           title "Conversion to binary".
     3258           undo, return error .
     3259       end.
     3260       do acoun# = abyte# to 1 by -1
     3261       on error undo, return error
     3262       :
     3263           put-byte( raw-value, acoun# ) = int( truncate( anumm# / EXP( 256, acoun# - 1 ), 0 ) ).
     3264           if anumm# ne 0
     3265           then do:
     3266               assign
     3267                   anumm# = anumm# modulo EXP( 256, acoun# - 1 )
     3268               .
     3269           end.
     3270       end.
     3271   end.
     3272   END PROCEDURE.
     3273   procedure dbflib-init :
     3274       define buffer buf_temp_dbflib_field    for temp_dbflib_field.
     3275       define buffer buf_temp_dbflib_data     for temp_dbflib_data.
     3276   do
     3277   for buf_temp_dbflib_field
     3278     , buf_temp_dbflib_data
     3279   :
     3280       empty temp-table buf_temp_dbflib_field.
     3281       empty temp-table buf_temp_dbflib_data.
     3282       assign
     3283           v-dbflib-reclength = 0
     3284           v-field-amount     = 0
     3285       .
     3286   end.
     3287   end procedure.
     3288   procedure dbflib-add-field :
     3289   define input parameter p-field-name     as character        no-undo.
     3290   define input parameter p-field-length   as integer          no-undo.
     3291   define input parameter p-data-type      as character        no-undo.
     3292   define input parameter p-field-decimals as integer          no-undo.
     3293       define buffer buf_temp_dbflib_field    for temp_dbflib_field.
     3294   do
     3295   for buf_temp_dbflib_field
     3296   on error undo, return error
     3297   :
     3298       find first buf_temp_dbflib_field
     3299            where buf_temp_dbflib_field.field-name       = p-field-name
     3300       no-error.
     3301       if not available buf_temp_dbflib_field
     3302       then do:
     3303           create buf_temp_dbflib_field.
     3304           assign
     3305               buf_temp_dbflib_field.field-name       = p-field-name
     3306               buf_temp_dbflib_field.field-length     = p-field-length
     3307               buf_temp_dbflib_field.data-type        = p-data-type
     3308               buf_temp_dbflib_field.field-decimals   = p-field-decimals
     3309               buf_temp_dbflib_field.dbfield-name     = caps( replace( substring( p-field-name, 1, 11 ), "-":U, "_":U ) )
     3310               v-dbflib-reclength                     = v-dbflib-reclength + buf_temp_dbflib_field.field-length
     3311               v-field-amount                         = v-field-amount + 1
     3312           .
     3313       end.
     3314   end.
     3315   end procedure.
     3316   procedure dbflib-add-data :
     3317   define input parameter p-record-number  as integer          no-undo.
     3318   define input parameter p-field-name     as character        no-undo.
     3319   define input parameter p-data-value     as character        no-undo.
     3320       define buffer buf_temp_dbflib_data      for temp_dbflib_data.
     3321   do
     3322   for buf_temp_dbflib_data
     3323   on error undo, return error
     3324   :
     3325       find first buf_temp_dbflib_data
     3326            where buf_temp_dbflib_data.record-number  = p-record-number
     3327              and buf_temp_dbflib_data.field-name     = p-field-name
     3328       no-error.
     3329       if not available buf_temp_dbflib_data
     3330       then do:
     3331           create buf_temp_dbflib_data.
     3332           assign
     3333               buf_temp_dbflib_data.record-number  = p-record-number
     3334               buf_temp_dbflib_data.field-name     = p-field-name
     3335               buf_temp_dbflib_data.data-value     = p-data-value
     3336           .
     3337       end.
     3338   end.
     3339   end procedure.
     3340   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3341     define variable v-cntxt-db-num        as integer   no-undo .
     3342     define variable v-cntxt-userid        as character no-undo .
     3343     define variable v-cntxt-level         as character no-undo .
