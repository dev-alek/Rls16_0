     1465       index pi is primary unique
     1466           doc-num
     1467   .
     1468   define temp-table temp_fin-doc-code no-undo
     1469       field host-code as integer
     1470       field fin-doc-code as integer
     1471       index pi is primary unique
     1472           host-code
     1473           fin-doc-code
     1474   .
     1475   define temp-table temp_del-fin-doc-code no-undo
     1476       field host-code as integer
     1477       field fin-doc-code as integer
     1478       field corr-user-db-num as integer
     1479       field chip-num as integer
     1480       index pi is primary unique
     1481           host-code
     1482           fin-doc-code
     1483           corr-user-db-num
     1484           chip-num
     1485   .
     1486   define temp-table temp_fin-ob no-undo
     1487       field host-code as integer
     1488       field fin-doc-code as character
     1489       index pi is primary unique
     1490           host-code
     1491           fin-doc-code
     1492   .
     1493   define temp-table temp_del-fin-ob no-undo
     1494       field host-code as integer
     1495       field fin-doc-code as character
     1496       field corr-user-db-num as integer
     1497       field chip-num as integer
     1498       index pi is primary unique
     1499           host-code
     1500           fin-doc-code
     1501           corr-user-db-num
     1502           chip-num
     1503   .
     1504   define temp-table temp_ord-doc-code no-undo
