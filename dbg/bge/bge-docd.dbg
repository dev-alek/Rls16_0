     1097                       then do:
     1098                           assign
     1099                               p-out-string = p-out-string + " ":U
     1100                           .
     1101                       end.
     1102                       when chr(13)
     1103                       then do:
     1104                           assign
     1105                               p-out-string = p-out-string + " ":U
     1106                           .
     1107                       end.
     1108                       otherwise do:
     1109                           assign
     1110                               p-out-string = p-out-string + v-current-char
     1111                           .
     1112                       end.
     1113                   end case.
     1114               end.
     1115           end.
     1116       end case.
     1117   end.
     1118   end .
     1119   procedure xmlchar-decode :
     1120   define input parameter p-in-string      as character        no-undo.
     1121   define output parameter p-out-string    as character        no-undo.
     1122       define variable v-position      as integer      no-undo.
     1123       define variable v-last-position as integer      no-undo.
     1124       define variable v-temp-integer  as integer      no-undo.
     1125       define variable v-current-char  as character    no-undo.
     1126       define variable v-next-char     as character    no-undo.
     1127       define variable v-success       as logical      no-undo.
     1128   do
     1129   on error undo, return error
     1130   :
     1131       assign
     1132           p-out-string = "":U
     1133           v-position   = 0
     1134       .
     1135       replace-cycle:
     1136       do while yes
     1137       on error undo, return error
     1138       :
     1139           assign
     1140               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1141           .
     1142           if v-last-position <= v-position
     1143           then do:
     1144               if v-position = 0
     1145               then do:
     1146                   assign
     1147                       p-out-string = p-in-string
     1148                   .
     1149               end.
     1150               else do:
     1151                   assign
     1152                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1153                   .
     1154               end.
     1155               leave replace-cycle.
     1156           end.
     1157           else do:
     1158               assign
     1159                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1160                   v-position      = v-last-position
     1161                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1162               .
     1163               if v-current-char = "#":U
     1164               then do:
     1165                   assign
     1166                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1167                   .
     1168                   if v-last-position > 0
     1169                   then do:
     1170                       run xmlchar-read-integer in this-procedure
     1171                        (
     1172                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1173                           , output v-temp-integer
     1174                           , output v-success
     1175                       ).
     1176                       if v-success = yes
     1177                       and v-temp-integer >= 1
     1178                       and v-temp-integer <= 255
     1179                       then do:
     1180                           assign
     1181                               p-out-string = p-out-string + chr( v-temp-integer )
     1182                               v-position   = v-last-position + 1
     1183                           .
     1184                       end.
     1185                       else do:
     1186                           assign
     1187                               p-out-string = p-out-string + "&":U
     1188                               v-position   = v-position   + 1
     1189                           .
     1190                       end.
     1191                   end.
     1192                   else do:
     1193                       assign
     1194                           p-out-string = p-out-string + "&":U
     1195                           v-position   = v-position   + 1
     1196                       .
     1197                   end.
     1198               end.
     1199               else do:
     1200                   case substring( p-in-string, v-position + 1, 3 )
     1201                   :
     1202                       when "lt;":U
     1203                       then do:
     1204                           assign
     1205                               p-out-string = p-out-string + "<":U
     1206                               v-position   = v-position   + 3
     1207                           .
     1208                       end.
     1209                       when "gt;":U
     1210                       then do:
     1211                           assign
     1212                               p-out-string = p-out-string + ">":U
     1213                               v-position   = v-position   + 3
     1214                           .
     1215                       end.
     1216                       otherwise do:
     1217                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1218                           then do:
     1219                               assign
     1220                                   p-out-string = p-out-string + "&":U
     1221                                   v-position   = v-position   + 4
     1222                               .
     1223                           end.
     1224                           else do:
     1225                               case substring( p-in-string, v-position + 1, 5 )
     1226                               :
     1227                                   when "quot;":U
     1228                                   then do:
     1229                                       assign
     1230                                           p-out-string = p-out-string + '"':U
     1231                                           v-position   = v-position   + 5
     1232                                       .
     1233                                   end.
     1234                                   when "apos;":U
     1235                                   then do:
     1236                                       assign
     1237                                           p-out-string = p-out-string + "'":U
     1238                                           v-position   = v-position   + 5
     1239                                       .
     1240                                   end.
     1241                                   otherwise do:
     1242                                       assign
     1243                                           p-out-string = p-out-string + "&":U
     1244                                       .
     1245                                   end.
     1246                               end case.
     1247                           end.
     1248                       end.
     1249                   end case.
     1250               end.
     1251           end.
     1252       end.
     1253   end.
     1254   end .
     1255   procedure xmlchar-read-integer :
     1256   define input parameter p-input-string      as character        no-undo.
     1257   define output parameter p-output-integer   as integer          no-undo.
     1258   define output parameter p-success       as logical          no-undo.
     1259   do
     1260   on error undo, return error
     1261   :
     1262       assign
     1263           p-output-integer = integer( p-input-string )
     1264       no-error.
     1265       if error-status :error
     1266       then do:
     1267           assign
     1268               p-success           = no
     1269               p-output-integer    = 0
     1270           .
     1271       end.
     1272       else do:
     1273           assign
     1274               p-success           = yes
     1275           .
     1276       end.
     1277   end.
     1278   end.
     1279   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1280   procedure strtdate :
     1281     define input  parameter p-str         as character no-undo .
     1282     define output parameter p-value       as date      no-undo .
     1283     define output parameter p-data-valid  as logical   no-undo .
     1284     define output parameter p-message     as character no-undo .
     1285   do
     1286   on error undo, return error return-value
     1287   :
     1288     define variable v-value       as date      no-undo .
     1289     define variable v-i           as integer   no-undo .
     1290     define variable v-num         as integer   no-undo .
     1291     define variable v-delim       as character no-undo .
     1292     define variable v-delim-list  as character no-undo .
     1293     define variable v-day         as integer   no-undo .
     1294     define variable v-month       as integer   no-undo .
     1295     define variable v-year        as integer   no-undo .
     1296     define variable v-day-str     as character no-undo .
     1297     define variable v-month-str   as character no-undo .
     1298     define variable v-year-str    as character no-undo .
     1299     assign
     1300       p-value       = ?
     1301       p-data-valid  = false
     1302     .
     1303     if p-str = ?
     1304     then do:
     1305       assign
     1306         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
     1307       .
     1308       return .
     1309     end.
     1310     if p-str = ""
     1311     then do:
     1312       assign
     1313         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
     1314       .
     1315       return .
     1316     end.
     1317     if length(p-str)  > 10
     1318     then do:
     1319       assign
     1320         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
     1321       .
     1322       return .
     1323     end.
     1324     assign
     1325       v-delim-list = '/,-,.':U
     1326     .
     1327     _delim:
     1328     do v-i = 1 to num-entries( v-delim-list )
     1329     :
     1330       assign
     1331         v-delim = entry( v-i , v-delim-list )
     1332         v-num   = num-entries( p-str , v-delim )
     1333       .
     1334       if v-num <> 3
     1335       then do:
     1336         assign
     1337           v-delim = ''
     1338         .
     1339       end.
     1340       else do:
     1341         leave _delim.
     1342       end.
     1343     end.
     1344     if v-delim = ''
     1345     then do:
     1346       assign
     1347         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
     1348       .
     1349       return .
     1350     end.
     1351     assign
     1352       v-day-str   = entry( 1, p-str , v-delim)
     1353       v-month-str = entry( 2, p-str , v-delim)
     1354       v-year-str  = entry( 3, p-str , v-delim)
     1355     .
     1356     if  length(v-day-str) > 2   or
     1357         length(v-day-str) < 1   or
     1358         length(v-month-str) > 2 or
     1359         length(v-month-str) < 1 or
     1360         (
     1361           length(v-year-str) <> 2 and
     1362           length(v-year-str) <> 4
     1363         )
     1364     then do:
     1365       assign
     1366         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
     1367       .
     1368       return .
     1369     end.
     1370     if length( v-year-str ) = 2
     1371     then do:
     1372       assign
     1373         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
     1374       .
     1375     end.
     1376     assign
     1377       v-day   = integer( v-day-str )
     1378       v-month = integer( v-month-str)
     1379       v-year  = integer( v-year-str)
     1380     no-error .
     1381     if error-status :error
     1382     then do:
     1383       assign
     1384         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
     1385       .
     1386       return .
     1387     end.
     1388     if v-day < 1  or
     1389        v-day > 31 or
     1390        v-month < 1 or
     1391        v-month > 12 or
     1392        v-year < 0   or
     1393        v-year > 5000
     1394     then do:
     1395       assign
     1396         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
     1397       .
     1398       return .
     1399     end.
     1400     assign
     1401       v-value = date( v-month, v-day, v-year )
     1402     no-error .
     1403     if error-status :error
     1404     then do:
     1405       assign
     1406         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
     1407       .
     1408       return .
     1409     end.
     1410     assign
     1411       p-value       = v-value
     1412       p-data-valid  = true
     1413     .
     1414   end.
     1415   end procedure.
     1416   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
     1417   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
     1418   define variable v-bge-xml-bgedict       as logical  init no  no-undo.
     1419   define variable v-bge-xml-bgeflold      as character         no-undo.
     1420   define variable v-bge-xml-bgefmt        as character         no-undo.
     1421   define variable v-bge-xml-shift-mode    as logical           no-undo.
     1422   define variable v-bge-xml-bgeflnm-doc   as character         no-undo.
     1423   define variable v-bge-xml-bgeflnm-day   as character         no-undo.
     1424   define variable v-bge-xml-log-file-name as character    no-undo.
     1425   define variable v-bge-xml-dbf-file-name as character    no-undo.
     1426   define variable v-bge-xml-db-num-str    as character    no-undo .
     1427   define variable v-bge-xml-static-log-file-name as character    no-undo.
     1428   define temp-table temp_ext-doc-type no-undo
