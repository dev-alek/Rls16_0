     3348     define variable v-cntxt-is-admin      as logical   no-undo .
     3349   define stream in-stream.
     3350       define variable v-xml-file-name     as character            no-undo.
     3351       define variable v-log-file-name     as character            no-undo.
     3352       define variable v-locked            as logical              no-undo.
     3353       define variable v-log-string        as character            no-undo.
     3354       define variable v-fact-order-from   like ub.stk-tot.fact-order no-undo.
     3355       define variable v-fact-order-to     like ub.stk-tot.fact-order no-undo.
     3356       define variable v-docs-exists       as logical              no-undo.
     3357       define variable v-obj-counter       as integer              no-undo.
     3358       define variable v-db-num            as integer              no-undo.
     3359       define variable v-yesno             as logical              no-undo.
     3360   do
     3361   on error undo, return error return-value
     3362   :
     3363   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3364     run mainmenu_getcntxt in parparentproc
     3365       (output v-cntxt-db-num
     3366       ,output v-cntxt-userid
     3367       ,output v-cntxt-level
     3368       ,output v-cntxt-host-code-obj
     3369       ,output v-cntxt-obj-type
     3370       ,output v-cntxt-obj-code
     3371       ,output v-cntxt-db-num-obj
     3372       ,output v-cntxt-is-admin
     3373       ) .
     3374       run bge-xml-init-ext-doc-type in this-procedure .
     3375   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3376   do:
     3377     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3378       (input  v-cntxt-db-num
     3379       ,input  v-cntxt-userid
     3380       ,input  0
     3381       ,input  'actn_documents_export':U
     3382       ,input  'firm':U
     3383       ,input  v-cntxt-host-code-obj
     3384       ,input  '':U
     3385       ,input  0
     3386       ,input  0
     3387       ,input  0
     3388       ,input  0
     3389       ,input  yes
     3390       ,output v-yesno
     3391       )  .
     3392   end.
     3393       if v-yesno = no
     3394       then do:
     3395           return error.
     3396       end.
     3397       run init-temphost.
     3398       assign
     3399           v-log-string = ", по всем фирмам"
     3400       .
     3401       case p-range:
     3402       when 2
     3403       then do:
     3404           for each temp-obj
     3405           where temp-obj.host-code <> v-cntxt-host-code-obj
     3406           :
     3407               delete temp-obj.
     3408           end.
     3409           assign
     3410               v-log-string = ", по фирме (код фирмы " + string( v-cntxt-host-code-obj ) + ")"
     3411           .
     3412       end.
     3413       when 3
     3414       then do:
     3415           for each temp-obj
     3416           :
     3417               delete temp-obj.
     3418           end.
     3419           do v-obj-counter = 1 to num-entries ( p-obj-list ) / 2
     3420           :
     3421               create temp-obj.
     3422               assign
     3423                   temp-obj.obj-type = entry( v-obj-counter * 2 - 1, p-obj-list )
     3424                   temp-obj.obj-code = integer( entry( v-obj-counter * 2, p-obj-list ) )
     3425               no-error .
     3426               if error-status :error
     3427               then do:
     3428                   message
     3429                   vss-workfile vss-revision vss-description
     3430                   skip "Ошибка чтения списка объектов"
     3431                   skip return-value
     3432                   skip trim(error-status :get-message(1))
     3433                       trim(error-status :get-message(2))
     3434                       trim(error-status :get-message(3))
     3435                       trim(error-status :get-message(4))
     3436                       trim(error-status :get-message(5))
     3437                   view-as alert-box error.
     3438                   undo, return error .
     3439               end.
     3440   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3441   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3442     (input  temp-obj.obj-type
     3443     ,input  temp-obj.obj-code
     3444     ,output temp-obj.host-code
     3445     ) no-error .
     3446               if error-status :error
     3447               then do:
     3448                   message
     3449                   vss-workfile vss-revision vss-description
     3450                   skip "Не найдена фирма для объекта" temp-obj.obj-type temp-obj.obj-code
     3451                   skip return-value
     3452                   skip trim(error-status :get-message(1))
     3453                       trim(error-status :get-message(2))
     3454                       trim(error-status :get-message(3))
     3455                       trim(error-status :get-message(4))
     3456                       trim(error-status :get-message(5))
     3457                   view-as alert-box error.
     3458                   undo, return error .
     3459               end.
     3460           end.
     3461           assign
     3462               v-log-string = ", по объектам: " + p-obj-list
     3463           .
     3464       end.
     3465       end case.
     3466       run bge-xml-read-config in this-procedure ( input p-date-to
     3467                                                 , input ?
     3468                                                 ) no-error.
     3469       if error-status :error
     3470       then do:
     3471           message
     3472           vss-workfile vss-revision vss-description
     3473           skip "Ошибка чтения параметров экспорта."
     3474           skip "Для экспорта данных будут приняты параметры по умолчанию."
     3475           skip return-value
     3476           skip trim(error-status :get-message(1))
     3477               trim(error-status :get-message(2))
     3478               trim(error-status :get-message(3))
     3479           view-as alert-box error.
     3480       end.
     3481       run xml-bge-filename in this-procedure (
     3482             input "doc"
     3483           , input "document"
     3484           , input "no"
     3485           , output v-xml-file-name
     3486           , output v-log-file-name
     3487           , output v-locked
     3488       ).
     3489       run wp-XMLWriteLog in this-procedure (
     3490             input v-log-file-name
     3491           , input 1
     3492           , input "&DLine"
     3493       ).
     3494       run wp-XMLWriteLog in this-procedure (
     3495             input v-log-file-name
     3496           , input 1
     3497           , input substitute( "Начало выгрузки в DBF" )
     3498       ).
     3499       run wp-XMLWriteLog in this-procedure (
     3500             input v-log-file-name
     3501           , input 1
     3502           , input substitute( "................с параметрами: Дата с: &1, дата по: &2"
     3503                                   , p-date-from
     3504                                   , p-date-to
     3505                             )
     3506       ).
     3507       run wp-XMLWriteLog in this-procedure (
     3508             input v-log-file-name
     3509           , input 1
     3510           , input substitute( "................с параметрами: ... список объектов: &1", p-obj-list )
     3511       ).
     3512       run wp-XMLWriteLog in this-procedure (
     3513             input v-log-file-name
     3514           , input 1
     3515           , input substitute( "................с параметрами: ... типы документов: &1", p-doc-type-list )
     3516       ).
     3517       run wp-XMLWriteLog in this-procedure (
     3518             input v-log-file-name
     3519           , input 1
     3520           , input substitute( "................с параметрами: ... надо ли виды платежей: &1, ГТД: &2, партии: &3, типы кассовых платежей: &4, кассы: &5, преф.карт: &6, удал.документы: &7, незакр.документы: &8"
     3521                                                         , p-pay-code
     3522                                                         , p-cst
     3523                                                         , p-parts
     3524                                                         , p-chk-pay-code
     3525                                                         , p-pay-desk
     3526                                                         , p-pay-desk-cards
     3527                                                         , p-deleted
     3528                                                         , p-opened-docs )
     3529       ).
     3530       object-of-list:
     3531       for each temp-obj
     3532       :
     3533           run export-docs-by-object (
     3534                 input temp-obj.host-code
     3535               , input temp-obj.obj-type
     3536               , input temp-obj.obj-code
     3537           ) no-error.
     3538           if error-status :error
     3539           then do:
     3540               message
     3541               vss-workfile vss-revision vss-description
     3542               skip "Ошибка экспорта документов по объекту"
     3543               skip "Тип объекта:" temp-obj.obj-type
     3544               skip "Код объекта:" temp-obj.obj-code
     3545               skip return-value
     3546               skip trim(error-status :get-message(1))
     3547                   trim(error-status :get-message(2))
     3548                   trim(error-status :get-message(3))
     3549                   trim(error-status :get-message(4))
     3550                   trim(error-status :get-message(5))
     3551               view-as alert-box error.
     3552               next object-of-list.
     3553           end.
     3554       end.
     3555       run wp-XMLWriteLog in this-procedure (
     3556             input v-log-file-name
     3557           , input 1
     3558           , input substitute( "Данные выгружены в .D - файлы. Идёт преобразование в DBF..." )
     3559       ).
     3560       run convert-to-dbf in this-procedure (
     3561             input v-xml-file-name
     3562           , input v-log-file-name
     3563       ).
     3564       run wp-XMLWriteLog in this-procedure (
     3565             input v-log-file-name
     3566           , input 1
     3567           , input substitute( "Данные преобразованы в DBF" )
     3568       ).
     3569       run wp-XMLWriteLog in this-procedure (
     3570             input v-log-file-name
     3571           , input 1
     3572           , input "&DLine"
     3573       ).
     3574   end.
     3575   procedure export-docs-by-object :
     3576   define input parameter p-host-code  as integer      no-undo.
     3577   define input parameter p-obj-type   as character    no-undo.
     3578   define input parameter p-obj-code   as integer      no-undo.
     3579       define variable v-archive-ok        as logical      no-undo.
     3580       define variable v-comment           as character    no-undo.
     3581       define variable v-err-message       as character    no-undo.
     3582   do
     3583   on error undo, return error return-value
     3584   :
     3585       run wp-XMLWriteEDT( hEDT, 1, string( p-obj-type ) + " " + string( p-obj-code ) ).
     3586       run wp-XMLWriteEDT( hEDT, 4,  "Расчет архивов").
     3587       run bge/bge-ahz.p (
     3588             input parparentproc
     3589           , input p-obj-type
     3590           , input p-obj-code
     3591           , input yes
     3592           , input yes
     3593           , input no
     3594           , input p-date-from
     3595           , input p-date-to
     3596           , output v-archive-ok
     3597           , output v-comment
     3598       ) no-error.
     3599       if error-status :error
     3600       then do:
     3601           message
     3602           vss-workfile vss-revision vss-description
     3603           skip "Ошибка проверки архивов на объекте."
     3604           skip "Тип объекта:" p-obj-type
     3605           skip "Код объекта:" p-obj-code
     3606           skip return-value
     3607           skip trim(error-status :get-message(1))
     3608               trim(error-status :get-message(2))
     3609               trim(error-status :get-message(3))
     3610           view-as alert-box error.
     3611           undo, return error .
     3612       end.
     3613       if v-archive-ok = no
     3614       then do:
     3615           assign
     3616               v-err-message = substitute( "*** Документы по объекту &1 &2 в интервале дат &3 - &4 не будут выгружены. Архивы по объекту в заданном интервале дат не целостные. &5."
     3617                                       , p-obj-type
     3618                                       , p-obj-code
     3619                                       , p-date-from
     3620                                       , p-date-to
     3621                                       , v-comment       )
     3622           .
     3623           run wp-XMLWriteLog in this-procedure (
     3624                 input v-log-file-name
     3625               , input 1
     3626               , input v-err-message
     3627           ).
     3628           message
     3629                    vss-workfile vss-revision vss-description
     3630               skip(1)
     3631               skip v-err-message
     3632           view-as alert-box error.
     3633           undo, return error.
     3634       end.
     3635       process events.
     3636       run rep/get-fo.p (
     3637             input  p-obj-type
     3638           , input  p-obj-code
     3639           , input  p-date-from
     3640           , input  p-date-to
     3641           , output v-fact-order-from
     3642           , output v-fact-order-to
     3643           , output v-docs-exists
     3644       ) no-error .
     3645       if error-status :error
     3646       then do:
     3647           message
     3648             vss-workfile vss-revision vss-description
     3649             skip "Ошибка определения границ fact-order для поиска по архивам"
     3650             skip return-value
     3651             skip trim(error-status :get-message(1))
     3652                  trim(error-status :get-message(2))
     3653                  trim(error-status :get-message(3))
     3654                  trim(error-status :get-message(4))
     3655                  trim(error-status :get-message(5))
     3656           view-as alert-box error.
     3657           undo, return error .
     3658       end.
     3659       if v-docs-exists = no
     3660       then do:
     3661           run wp-XMLWriteEDT( hEDT, 4, "В заданном диапазоне дат нет закрытых документов").
     3662       end.
     3663       else do:
     3664           run wp-XMLShowCNT(hCNT).
     3665           for each temp_ext-doc-type
     3666           :
     3667               if lookup( temp_ext-doc-type.ext-doc-type, p-doc-type-list ) <> 0
     3668               or p-doc-type-list = "":U
     3669               then do:
     3670                   run bge/doc-oper.p (
     3671                         input p-host-code
     3672                       , input p-obj-type
     3673                       , input p-obj-code
     3674                       , input temp_ext-doc-type.ext-doc-type
     3675                       , input temp_ext-doc-type.ext-doc-type-label
     3676                       , input v-fact-order-from
     3677                       , input v-fact-order-to
     3678                       , input p-date-from
     3679                       , input p-date-to
     3680                       , input p-pay-code
     3681                       , input p-cst
     3682                       , input p-parts
     3683                       , input p-chk-pay-code
     3684                       , input p-pay-desk
     3685                       , input p-pay-desk-cards
     3686                       , input p-chk
     3687                       , input p-doc-rvs
     3688                       , input v-xml-file-name
     3689                       , input v-log-file-name
     3690                       , input this-procedure
     3691                       , input hEDT
     3692                       , input hCNT
     3693                   ) no-error.
     3694                   if error-status :error
     3695                   then do:
     3696                       run wp-XMLWriteEDT(
     3697                             input hEDT
     3698                           , input 1
     3699                           , input substitute( "Ошибка экспорта документов. &1. &2. &3."
     3700                                               , return-value
     3701                                               , trim(error-status :get-message( 1 ) )
     3702                                               , trim(error-status :get-message( 2 ) ) )
     3703                       ).
     3704                       message
     3705                                vss-workfile vss-revision vss-description
     3706                           skip(1)
     3707                           skip "Ошибка экспорта документов."
     3708                           skip return-value
     3709                           skip trim( error-status :get-message( 1 ) )
     3710                                trim( error-status :get-message( 2 ) )
     3711                                trim( error-status :get-message( 3 ) )
     3712                       view-as alert-box error.
     3713                       undo, return error.
     3714                   end.
     3715               end.
     3716           end.
     3717           run wp-XMLHideCNT(hCNT).
     3718       end.
     3719       process events.
     3720   end.
     3721   end procedure.
     3722   procedure cb-fill_bge-xml_goods :
     3723   define input parameter p-gds-code   as integer          no-undo.
     3724   do
     3725   on error undo, return error
     3726   :
     3727       find first temp_bge-xml_goods
     3728            where temp_bge-xml_goods.gds-code = p-gds-code
     3729       no-error.
     3730       if not available temp_bge-xml_goods
     3731       then do:
     3732           create temp_bge-xml_goods.
     3733           assign
     3734               temp_bge-xml_goods.gds-code = p-gds-code
     3735           .
     3736       end.
     3737   end.
     3738   end procedure.
     3739   procedure cb-fill_bge-xml_clients :
     3740   define input parameter p-obj-type   as character        no-undo.
     3741   define input parameter p-obj-code   as integer          no-undo.
     3742       define buffer buf_temp_bge-xml_clients      for temp_bge-xml_clients.
     3743   do
     3744   for buf_temp_bge-xml_clients
     3745   on error undo, return error
     3746   :
     3747       find first buf_temp_bge-xml_clients
     3748            where buf_temp_bge-xml_clients.obj-type = p-obj-type
     3749              and buf_temp_bge-xml_clients.obj-code = p-obj-code
     3750       no-error.
     3751       if not available buf_temp_bge-xml_clients
     3752       then do:
     3753           create buf_temp_bge-xml_clients.
     3754           assign
     3755               buf_temp_bge-xml_clients.obj-type = p-obj-type
     3756               buf_temp_bge-xml_clients.obj-code = p-obj-code
     3757           .
     3758       end.
     3759   end.
     3760   end procedure.
     3761   procedure convert-to-dbf :
     3762   define input parameter p-dir-name       as character        no-undo.
     3763   define input parameter p-log-filename   as character        no-undo.
     3764       define variable v-field-name     as character    no-undo.
     3765       define variable v-field-length   as integer      no-undo.
     3766       define variable v-field-value    as character    no-undo.
     3767       define buffer buf_temp-filelist     for temp-filelist.
     3768   do
     3769   for buf_temp-filelist
     3770   on error undo, return error return-value
     3771   :
     3772       run filelist-clear in this-procedure .
     3773       run filelist-init in this-procedure (
     3774             input p-dir-name
     3775           , input yes
     3776           , input "d":U
     3777           , input ?
     3778       ).
     3779       for each buf_temp-filelist
     3780       :
     3781           input stream in-stream from value( buf_temp-filelist.full-name ).
     3782           case substring( buf_temp-filelist.file-name, 1, 4 )
     3783           :
     3784               when "head":U
     3785               or when "hpss":U
     3786               or when "hcss":U
     3787               or when "hdsm":U
     3788               or when "hcsm":U
     3789               or when "hssm":U
     3790               or when "hbiv":U
     3791               or when "haiv":U
     3792               or when "hspc":U
     3793               or when "hsps":U
     3794               or when "lhdr":U
     3795               or when "ldtl":U
     3796               or when "lprt":U
     3797               or when "ldsm":U
     3798               or when "lcsm":U
     3799               or when "lssm":U
     3800               or when "lbiv":U
     3801               or when "laiv":U
     3802               or when "lspc":U
     3803               or when "lsps":U
     3804               then do:
     3805                   run dbflib-init in this-procedure.
     3806                   repeat:
     3807                       import stream in-stream
     3808                           v-field-name
     3809                           v-field-value
     3810                       .
     3811                       if v-field-value = ?
     3812                       then do:
     3813                           assign
     3814                               v-field-value = "":U
     3815                               v-field-length = 0
     3816                           .
     3817                       end.
     3818                       else do:
     3819                           assign
     3820                               v-field-length = length( v-field-value )
     3821                           .
     3822                       end.
     3823                       run dbflib-add-field in this-procedure (
     3824                             input v-field-name
     3825                           , input 255
     3826                           , input "character":U
     3827                           , input 0
     3828                       ).
     3829                       run dbflib-add-data in this-procedure (
     3830                             input 1
     3831                           , input v-field-name
     3832                           , input v-field-value
     3833                       ).
     3834                   end.
     3835                   run dbflib-write-dbf in this-procedure (
     3836                       input substitute( "&1/&2.dbf":U, p-dir-name, buf_temp-filelist.file-name-no-ext )
     3837                     , input 1
     3838                   ) no-error.
     3839                   if error-status :error
     3840                   then do:
     3841                       message
     3842                                vss-workfile vss-revision vss-description
     3843                           skip(1)
     3844                           skip "Ошибка записи файла формата dbf."
     3845                           skip return-value
     3846                           skip trim( error-status :get-message( 1 ) )
     3847                                trim( error-status :get-message( 2 ) )
     3848                                trim( error-status :get-message( 3 ) )
     3849                       view-as alert-box error.
     3850                       undo, return error.
     3851                   end.
     3852               end.
     3853           end case.
     3854           input stream in-stream close.
     3855           os-delete value( buf_temp-filelist.full-name ).
     3856       end.
     3857   end.
     3858   end procedure.
