        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as handle               no-undo.
        3   define input parameter p-date-from      as date       no-undo.
        4   define input parameter p-date-to        as date       no-undo.
        5   define input parameter p-range          as integer    no-undo.
        6   define input parameter p-obj-list       as character  no-undo.
        7   define input parameter p-doc-type-list  as character  no-undo.
        8   define input parameter p-pay-code       as logical    no-undo.
        9   define input parameter p-cst            as logical    no-undo.
       10   define input parameter p-parts          as logical    no-undo.
       11   define input parameter p-chk-pay-code   as logical    no-undo.
       12   define input parameter p-pay-desk       as logical    no-undo.
       13   define input parameter p-pay-desk-cards as logical    no-undo.
       14   define input parameter p-deleted        as logical    no-undo.
       15   define input parameter p-chk            as logical    no-undo.
       16   define input parameter p-doc-rvs        as logical    no-undo.
       17   define input parameter p-opened-docs    as logical    no-undo.
       18   define input parameter hedt             as handle     no-undo.
       19   define input parameter hcnt             as handle     no-undo.
       20   define variable vss-revision    as character no-undo init "$Revision: a61e6bb0c7e0, 2871, rls $":U .
       21   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
       22   define variable vss-date        as character no-undo init "$Date: Пн ноя 22 19:49:10 2021 +0300 $":U .
       23   define variable vss-workfile    as character no-undo init "$Workfile: bge-docd.p $":U .
       24   define variable vss-archive     as character no-undo init "$Archive: bge/bge-docd.p $":U .
       25   define variable vss-description as character no-undo init "Экспорт во Внешнюю Бухгалтерию документов с выводом в dbf".
       26   procedure vss-get-info :
       27     define output parameter p-vss-revision    like vss-revision    no-undo .
       28     define output parameter p-vss-author      like vss-author      no-undo .
       29     define output parameter p-vss-date        like vss-date        no-undo .
       30     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       31     define output parameter p-vss-archive     like vss-archive     no-undo .
       32     define output parameter p-vss-description like vss-description no-undo .
       33     assign
       34       p-vss-revision    = vss-revision
       35       p-vss-author      = vss-author
       36       p-vss-date        = vss-date
       37       p-vss-workfile    = vss-workfile
       38       p-vss-archive     = vss-archive
       39       p-vss-description = vss-description
       40     .
       41   end procedure.
       42   procedure vss-get-parameters :
       43     define output parameter p-vss-parameters as character no-undo .
       44   end procedure.
       45   define new global shared variable g#vssrevis-logger as handle    no-undo .
       46   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       47   define variable v-vssrevis-logger                   as handle    no-undo .
       48   procedure vss-logevent :
       49     define input  parameter p-extra-paramters as character no-undo .
       50     define variable v-vssrevis-parameters as character no-undo .
       51     do
       52     on error undo, return error return-value
       53     :
       54       if  valid-handle(v-vssrevis-logger)
       55       and v-vssrevis-logger :get-signature("logevent") <> ""
       56       then do:
       57         run vss-get-parameters in this-procedure
       58           (output v-vssrevis-parameters
       59           ).
       60         run logevent in v-vssrevis-logger
       61           (input vss-workfile
       62           ,input vss-revision
       63           ,input v-vssrevis-parameters
       64           ,input p-extra-paramters
       65           ).
       66       end.
       67     end.
       68   end procedure.
       69   assign
       70     v-vssrevis-logger = g#vssrevis-logger
       71   .
       72   if  valid-handle(v-vssrevis-logger)
       73   and v-vssrevis-logger :get-signature("logevent") <> ""
       74   then do:
       75     assign
       76       v-vssrevis-logevent = true
       77     .
       78     run vss-logevent in this-procedure (input vss-description) .
       79   end.
       80   define new global shared variable g#language as character no-undo .
       81   if g#language <> '' and g#language <> 'rus':U then do:
       82     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       83   end.
       84   define new global shared variable g#library  as handle no-undo .
       85   define new global shared variable g#library2 as handle no-undo .
       86   define variable vss-include-info0 as character format "X(65)" no-undo
       87   initial "@(#)$Workfile$ $Revision$".
       88   define variable v-filelist-total-file-num           as integer      no-undo .
       89   define variable v-filelist-total-dir-num            as integer      no-undo .
       90   define variable v-filelist-main-procedure-handle    as handle       no-undo .
       91   define variable v-filelist-main-procedure-name      as character    no-undo .
       92   define temp-table temp-dirlist no-undo
       93       field dir-full-name     as character
       94       field dir-short-name    as character
       95       field need-process      as logical
       96       index xpk is primary unique dir-full-name
       97   .
       98   define temp-table temp-filelist no-undo
       99     field file-name        as character
      100     field file-name-no-ext as character
      101     field file-extension   as character
      102     field directory-name   as character
      103     field full-name        as character
      104     field dir-short-name   as character
      105     field need-process     as logical
      106     index xpk is unique primary full-name
      107     index xie1 directory-name file-name
      108     index xie2 directory-name file-name-no-ext
      109     index xie3 file-name
      110     index xie4 file-name-no-ext
      111     index xie5 need-process file-name
      112     .
      113   define stream dir-list .
      114   procedure filelist-get-file-num :
      115     define output parameter p-file-num as integer   no-undo .
      116     do
      117     on error undo, return error return-value
      118     :
      119       assign
      120         p-file-num = v-filelist-total-file-num
      121       .
      122     end.
      123   end procedure.
      124   procedure filelist-clear :
      125     do
      126     on error undo, return error return-value
      127     :
      128       define buffer buf_filelist for temp-filelist .
      129       assign
      130         v-filelist-total-file-num = 0
      131       .
      132       for each buf_filelist
      133       on error undo, return error
      134       :
      135         delete buf_filelist .
      136       end.
      137     end.
      138   end procedure.
      139   procedure filelist-init :
      140     do
      141     on error undo, return error
      142     :
      143       define input parameter p-dir-name       as character no-undo .
      144       define input parameter p-filter-ext     as logical   no-undo .
      145       define input parameter p-ext-list       as character no-undo .
      146       define input parameter p-dir-short-name as character no-undo .
      147       define buffer buf_temp-filelist for temp-filelist .
      148       if p-filter-ext = true
      149          and p-ext-list = ?
      150       or (p-filter-ext = false
      151          and p-ext-list <> ?
      152          and p-ext-list <> "":U
      153          )
      154       then do:
      155         message
      156           vss-workfile vss-revision vss-description skip
      157           "Ошибка задания входных параметров" skip
      158           "p-filter-ext" p-filter-ext skip
      159           "p-ext-list"   p-ext-list   skip
      160           view-as alert-box error .
      161         undo, return error .
      162       end.
      163       for each buf_temp-filelist
      164         where buf_temp-filelist.directory-name = p-dir-name
      165       on error undo, return error return-value
      166       :
      167         delete buf_temp-filelist .
      168       end.
      169       input stream dir-list from os-dir( p-dir-name ).
      170       define variable v-file                  as character no-undo .
      171       define variable v-path                  as character no-undo .
      172       define variable v-mask                  as character no-undo .
      173       define variable v-extension             as character no-undo .
      174       define variable v-file-name-without-ext as character no-undo .
      175       repeat
      176       on error undo, return error
      177       :
      178         import stream dir-list v-file v-path v-mask .
      179         if  v-mask <> ?
      180         and v-mask begins 'F':u
      181         then do:
      182         end.
      183         else do:
      184           next .
      185         end.
      186         if num-entries(v-file, '.':u) > 1
      187         then do:
      188           assign
      189             v-extension = entry(num-entries(v-file, '.':u), v-file,  '.':u )
      190             v-file-name-without-ext = entry(num-entries(v-file, '.':u) - 1, v-file, '.':u )
      191           .
      192         end.
      193         else do:
      194           assign
      195             v-extension = ''
      196             v-file-name-without-ext = v-file
      197           .
      198         end.
      199         if p-filter-ext = true
      200         then do:
      201           if lookup(v-extension, p-ext-list) = 0
      202           then do:
      203             next .
      204           end.
      205         end.
      206         create buf_temp-filelist .
      207         assign
      208           buf_temp-filelist.file-name        = v-file
      209           buf_temp-filelist.directory-name   = p-dir-name
      210           buf_temp-filelist.file-name-no-ext = v-file-name-without-ext
      211           buf_temp-filelist.file-extension   = v-extension
      212           buf_temp-filelist.full-name        = p-dir-name + '/':u + v-file
      213           buf_temp-filelist.dir-short-name   = p-dir-short-name
      214         .
      215         assign
      216           v-filelist-total-file-num = v-filelist-total-file-num + 1
      217         .
      218         if v-filelist-main-procedure-handle <> ?
      219         then do:
      220           run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle
      221             (input "file":U
      222             , input v-filelist-total-file-num
      223             , input buf_temp-filelist.full-name
      224             , input buf_temp-filelist.file-name
      225             ) no-error.
      226           if error-status :error
      227           then do:
      228             message
      229               vss-workfile vss-revision vss-description skip
      230               "filelist-dirlist-subdir-init" skip(1)
      231               skip "Ошибка при вызове процедуры вывода"
      232               skip "результатов сканирования каталогов."
      233               skip return-value
      234               skip trim(error-status :get-message(1))
      235                       trim(error-status :get-message(2))
      236                       trim(error-status :get-message(3))
      237               view-as alert-box error.
      238             undo, return error .
      239           end.
      240         end.
      241       end.
      242       input stream dir-list close .
      243       return.
      244     end.
      245   end procedure.
      246   procedure filelist-dirlist-init-by-list :
      247     do
      248     on error undo, return error
      249     :
      250       define input parameter p-root-dir   as character no-undo .
      251       define input parameter p-dir-list   as character no-undo .
      252       define input parameter p-filter-ext as logical   no-undo .
      253       define input parameter p-ext-list   as character no-undo .
      254       define variable v-num-appdir as integer   no-undo .
      255       do v-num-appdir = 1 to num-entries(p-dir-list)
      256       :
      257         define variable v-curr-dir  as character no-undo .
      258         assign
      259           v-curr-dir = entry(v-num-appdir, p-dir-list)
      260         .
      261         run filelist-init in this-procedure
      262           (input p-root-dir + '/':u + v-curr-dir
      263           ,input p-filter-ext
      264           ,input p-ext-list
      265           ,input v-curr-dir
      266           ) .
      267       end.
      268     end.
      269   end procedure.
      270   procedure filelist-dirlist-clear :
      271     do
      272     on error undo, return error
      273     :
      274       define buffer buf_temp-dirlist for temp-dirlist .
      275       assign
      276           v-filelist-total-dir-num = 0
      277       .
      278       for each buf_temp-dirlist
      279       on error undo, return error
      280       :
      281         delete buf_temp-dirlist .
      282       end.
      283     end.
      284   end procedure.
      285   procedure filelist-dirlist-subdir-init :
      286   define input parameter p-dir-name   as character no-undo .
      287       define buffer buf_temp-dirlist for temp-dirlist .
      288   do
      289   for buf_temp-dirlist
      290   on error undo, return error
      291   :
      292       assign
      293           file-info :file-name = p-dir-name
      294       .
      295       if file-info :full-pathname = ?
      296       or index( file-info :file-type, "D" ) = 0
      297       then do:
      298           message
      299               vss-workfile vss-revision vss-description skip
      300               "filelist-dirlist-init: Заданного каталога не существует."
      301               skip (1)
      302               skip "Задан каталог:"
      303               skip substitute( "'&1'", p-dir-name )
      304           view-as alert-box error .
      305           undo, return error .
      306       end.
      307       input stream dir-list from os-dir( p-dir-name ).
      308       define variable v-file                  as character no-undo .
      309       define variable v-path                  as character no-undo .
      310       define variable v-mask                  as character no-undo .
      311       file-in-directory:
      312       repeat
      313       on error undo, return error
      314       :
      315           import stream dir-list
      316               v-file
      317               v-path
      318               v-mask
      319           .
      320           if  v-mask = ?
      321           or index( v-mask, 'D':u ) = 0
      322           or v-file = ".":U
      323           or v-file = "..":U
      324           then do:
      325               next file-in-directory.
      326           end.
      327           else do:
      328               find first buf_temp-dirlist
      329                    where buf_temp-dirlist.dir-full-name    = v-path
      330               no-error.
      331               if not available buf_temp-dirlist
      332               then do:
      333                   create buf_temp-dirlist .
      334                   assign
      335                       buf_temp-dirlist.dir-full-name    = v-path
      336                       buf_temp-dirlist.dir-short-name   = v-file
      337                       buf_temp-dirlist.need-process     = yes
      338                   .
      339               end.
      340               assign
      341                   v-filelist-total-dir-num = v-filelist-total-dir-num + 1
      342               .
      343               if v-filelist-main-procedure-handle <> ?
      344               then do:
      345                   run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle (
      346                         input "dir":U
      347                       , input v-filelist-total-dir-num
      348                       , input buf_temp-dirlist.dir-full-name
      349                       , input buf_temp-dirlist.dir-short-name
      350                   ) no-error.
      351                   if error-status :error
      352                   then do:
      353                       message
      354                           vss-workfile vss-revision vss-description skip
      355                           "filelist-dirlist-subdir-init"
      356                           skip(1)
      357                           skip "Ошибка при вызове процедуры вывода"
      358                           skip "результатов сканирования каталогов."
      359                           skip return-value
      360                           skip trim(error-status :get-message(1))
      361                                trim(error-status :get-message(2))
      362                                trim(error-status :get-message(3))
      363                       view-as alert-box error.
      364                       undo, return error .
      365                   end.
      366               end.
      367           end.
      368       end.
      369       input stream dir-list close .
      370   end.
      371   end procedure.
      372   procedure filelist-dirlist-init :
      373   define input parameter p-dir-name   as character no-undo .
      374       define variable v-file  as character no-undo.
      375       define variable v-path  as character no-undo.
      376       define variable v-mask  as character no-undo.
      377       define buffer buf_temp-dirlist for temp-dirlist .
      378   do
      379   for buf_temp-dirlist
      380   on error undo, return error
      381   :
      382       assign
      383           file-info :file-name = p-dir-name
      384       .
      385       if file-info :full-pathname = ?
      386       or index( file-info :file-type, "D" ) = 0
      387       then do:
      388           message
      389               vss-workfile vss-revision vss-description skip
      390               "filelist-dirlist-init: Заданного каталога не существует."
      391               skip (1)
      392               skip "Задан каталог:"
      393               skip substitute( "'&1'", p-dir-name )
      394           view-as alert-box error .
      395           undo, return error .
      396       end.
      397       for each buf_temp-dirlist
      398          where buf_temp-dirlist.dir-full-name begins file-info :full-pathname
      399       on error undo, return error return-value
      400       :
      401           delete buf_temp-dirlist .
      402       end.
      403       create buf_temp-dirlist .
      404       assign
      405           buf_temp-dirlist.dir-full-name    = file-info :full-pathname
      406           buf_temp-dirlist.dir-short-name   = file-info :file-name
      407           buf_temp-dirlist.need-process     = yes
      408       .
      409       do
      410       while available buf_temp-dirlist
      411       on error undo, return error
      412       :
      413           run filelist-dirlist-subdir-init in this-procedure (
      414               input buf_temp-dirlist.dir-full-name
      415           ).
      416           assign
      417               buf_temp-dirlist.need-process = no
      418           .
      419           find first buf_temp-dirlist
      420                where buf_temp-dirlist.need-process = yes
      421           no-error.
      422       end.
      423   end.
      424   end procedure.
      425   procedure filelist-set-procedure-handle :
      426   define input parameter p-proc-handle    as handle           no-undo.
      427   define input parameter p-proc-name      as character        no-undo.
      428       define variable v-signature    as character    no-undo.
      429   do
      430   on error undo, return error
      431   :
      432       if p-proc-handle = ?
      433       or not valid-handle( p-proc-handle )
      434       or p-proc-handle :get-signature( p-proc-name ) = ""
      435       then do:
      436           assign
      437               v-filelist-main-procedure-handle = ?
      438               v-filelist-main-procedure-name   = ""
      439           .
      440           undo, return error "filelist-set-procedure-handle: Ошибка передачи handle основной процедуры или имени процедуры обработки результатов сканирования каталогов.".
      441       end.
      442       else do:
      443           assign
      444               v-signature = p-proc-handle :get-signature( p-proc-name )
      445           .
      446           if entry(   1, v-signature )    = "PROCEDURE":U
      447           and entry( 1, entry(  3, v-signature ), " ":U ) = "INPUT":U
      448           and entry( 3, entry(  3, v-signature ), " ":U ) = "CHARACTER":U
      449           and entry( 1, entry(  4, v-signature ), " ":U ) = "INPUT":U
      450           and entry( 3, entry(  4, v-signature ), " ":U ) = "INTEGER":U
      451           and entry( 1, entry(  5, v-signature ), " ":U ) = "INPUT":U
      452           and entry( 3, entry(  5, v-signature ), " ":U ) = "CHARACTER":U
      453           and entry( 1, entry(  6, v-signature ), " ":U ) = "INPUT":U
      454           and entry( 3, entry(  6, v-signature ), " ":U ) = "CHARACTER":U
      455           then do:
      456               assign
      457                   v-filelist-main-procedure-handle = p-proc-handle
      458                   v-filelist-main-procedure-name   = p-proc-name
      459               .
      460           end.
      461           else do:
      462               assign
      463                   v-filelist-main-procedure-handle = ?
      464                   v-filelist-main-procedure-name   = ""
      465               .
      466               undo, return error "filelist-set-procedure-handle: Ошибка задания параметров процедуры обработки результатов сканирования каталогов.".
      467           end.
      468       end.
      469   end.
      470   end procedure.
      471   procedure filelist-clear-procedure-handle :
      472   do
      473   on error undo, return error
      474   :
      475       assign
      476           v-filelist-main-procedure-handle = ?
      477           v-filelist-main-procedure-name   = ?
      478       .
      479   end.
      480   end procedure.
      481   procedure filelist-build-by-dirlist :
      482       define buffer buf_temp-dirlist      for temp-dirlist.
      483   do
      484   for buf_temp-dirlist
      485   on error undo, return error
      486   :
      487       for each buf_temp-dirlist
      488       on error undo, return error
      489       :
      490           run filelist-init in this-procedure (
      491                 input buf_temp-dirlist.dir-full-name
      492               , input no
      493               , input "":U
      494               , input buf_temp-dirlist.dir-short-name
      495           ).
      496       end.
      497   end.
      498   end procedure.
      499   procedure filelist-check-dir-exists :
      500   define input parameter p-dir-name   as character        no-undo.
      501   define output parameter p-exists    as logical          no-undo.
      502   do
      503   on error undo, return error
      504   :
      505       assign
      506           file-info :file-name = p-dir-name
      507       .
      508       if file-info :file-type <> ?
      509       and substring( file-info :file-type, 1, 1 ) = "D":U
      510       then do:
      511           assign
      512               p-exists = yes
      513           .
      514       end.
      515       else do:
      516           assign
      517               p-exists = no
      518           .
      519       end.
      520   end.
      521   end procedure.
      522   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      523   define  temp-table temp-host no-undo
      524     field host-code like ub.store.host-code
      525     index xpk host-code
      526   .
      527   define  temp-table temp-obj no-undo
      528     field obj-type  like ub.clients.obj-type
      529     field obj-code  like ub.clients.obj-code
      530     field host-code like ub.store.host-code
      531     field db-num    like ub.clients.db-num
      532     index xpk  obj-type obj-code
      533     index xie1 host-code
      534     index xie2 db-num host-code
      535   .
      536   procedure init-temphost:
      537     define buffer buf_store   for ub.store .
      538     define buffer buf_shop    for ub.shop .
      539     define buffer buf_clients for ub.clients .
      540     define buffer buf_db for ub.db .
      541     define buffer buf_temp-host for temp-host .
      542     define buffer buf_temp-obj for temp-obj .
      543     do
      544     on error undo, return error return-value
      545     :
      546       for each buf_store
      547       on error undo, return error
      548       :
      549         find first buf_temp-host
      550           where buf_temp-host.host-code = buf_store.host-code
      551           no-error .
      552         if not available buf_temp-host
      553         then do:
      554           create buf_temp-host .
      555           assign
      556             buf_temp-host.host-code = buf_store.host-code
      557           .
      558         end.
      559         find first buf_clients no-lock
      560           where buf_clients.obj-type = 'скл':U
      561             and buf_clients.obj-code = buf_store.obj-code
      562           no-error .
      563         if not available buf_clients
      564         then do:
      565           message
      566             "Ошибка при поиске клиента" skip
      567             "Клиент" 'скл':U buf_store.obj-code skip
      568             view-as alert-box error .
      569           undo, return error .
      570         end.
      571         create buf_temp-obj .
      572         assign
      573           buf_temp-obj.obj-type  = 'скл':U
      574           buf_temp-obj.obj-code  = buf_store.obj-code
      575           buf_temp-obj.host-code = buf_store.host-code
      576           buf_temp-obj.db-num    = buf_clients.db-num
      577         .
      578       end.
      579       for each buf_shop
      580       on error undo, return error
      581       :
      582         find first buf_temp-host
      583           where buf_temp-host.host-code = buf_shop.host-code
      584           no-error .
      585         if not available buf_temp-host
      586         then do:
      587           create buf_temp-host .
      588           assign
      589             buf_temp-host.host-code = buf_shop.host-code
      590           .
      591         end.
      592         find first buf_clients no-lock
      593           where buf_clients.obj-type = 'маг':U
      594             and buf_clients.obj-code = buf_shop.obj-code
      595           no-error .
      596         if not available buf_clients then do:
      597           message
      598             "Ошибка при поиске клиента" skip
      599             "Клиент" 'маг':U buf_shop.obj-code skip
      600             view-as alert-box error .
      601           undo, return error .
      602         end.
      603         create buf_temp-obj .
      604         assign
      605           buf_temp-obj.obj-type  = 'маг':U
      606           buf_temp-obj.obj-code  = buf_shop.obj-code
      607           buf_temp-obj.host-code = buf_shop.host-code
      608           buf_temp-obj.db-num    = buf_clients.db-num
      609         .
      610       end.
      611     end.
      612   end.
      613   define variable vss-include-info2 as character format "X(65)" no-undo
      614   initial "@(#)$Workfile$ $Revision$".
      615   DEF STREAM stmXMLOut.
      616   DEF STREAM stmXMLLog.
      617   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      618   procedure cur-time :
      619      define output parameter p-today as date      no-undo .
      620      define output parameter p-time  as integer   no-undo .
      621     do
      622     on error undo, return error
      623     :
      624       define variable v-date1 as date      no-undo .
      625       define variable v-date2 as date      no-undo .
      626       define variable v-time  as integer   no-undo .
      627       assign
      628         v-date1 = today
      629         v-time  = time
      630         v-date2 = today
      631       .
      632       if v-date1 <> v-date2
      633       then do:
      634         assign
      635           v-date1 = today
      636           v-time  = v-time
      637         .
      638       end.
      639       assign
      640         p-today = v-date1
      641         p-time  = v-time
      642       .
      643     end.
      644   end.
      645   function cur-time-date returns character
      646   :
      647     return string(today, '99/99/9999':U) .
      648   end.
      649   function cur-time-mjd returns decimal
      650   :
      651     define variable v-date as date      no-undo .
      652     define variable v-time as integer   no-undo .
      653     run cur-time in this-procedure
      654       (output v-date
      655       ,output v-time
      656       ) .
      657     return integer(v-date) - 2400002 + (v-time / 86400) .
      658   end.
      659   function cur-time-get-ending-index returns integer
      660   (input p-number as integer
      661   )
      662   :
      663     if p-number < 0
      664     or p-number = ?
      665     then do:
      666       return 1 .
      667     end.
      668     define variable v-rest as integer   no-undo .
      669     assign
      670       p-number = p-number modulo 100
      671     .
      672     if p-number < 20
      673     then do:
      674       assign
      675         v-rest = p-number
      676       .
      677     end.
      678     else do:
      679       assign
      680         v-rest = p-number modulo 10
      681       .
      682     end.
      683     case v-rest :
      684       when 1
      685       then do:
      686         return 2 .
      687       end.
      688       when 2 or
      689       when 3 or
      690       when 4
      691       then do:
      692         return 3 .
      693       end.
      694       otherwise do:
      695         return 1 .
      696       end.
      697     end case .
      698   end.
      699   procedure cur-time-mjd-to-date :
      700      define input  parameter i-mjd-diff as decimal no-undo.
      701      define output parameter o-Date     as date    no-undo.
      702      define output parameter o-Time     as integer no-undo.
      703      define variable v-day-number as integer   no-undo .
      704      if    i-mjd-diff < 0
      705         or i-mjd-diff = ?
      706      then do:
      707         return "?" .
      708      end.
      709      assign
      710         v-day-number = truncate(i-mjd-diff,0).
      711         o-Date = date(v-day-number + 2400002).
      712         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      713     .
      714   end.
      715   function cur-time-mjd-to-string returns character
      716   (input p-mjd-diff as decimal
      717   )
      718   :
      719     define variable v-day-number as integer   no-undo .
      720     define variable v-seconds    as integer   no-undo .
      721     define variable v-hour       as integer   no-undo .
      722     define variable v-min        as integer   no-undo .
      723     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      724     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      725     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      726     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      727     if p-mjd-diff < 0
      728     or p-mjd-diff = ?
      729     then do:
      730       return "?" .
      731     end.
      732     assign
      733       v-day-number = integer(truncate(p-mjd-diff,0))
      734       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      735     .
      736     if v-seconds > 86400
      737     then do:
      738       assign
      739         v-seconds = 86400 - 1
      740       .
      741     end.
      742     if v-seconds < 0
      743     then do:
      744       assign
      745         v-seconds = 0
      746       .
      747     end.
      748     assign
      749       v-hour = truncate(v-seconds / 3600, 0)
      750     .
      751     assign
      752       v-seconds = v-seconds modulo 3600
      753     .
      754     assign
      755       v-min = truncate(v-seconds / 60, 0)
      756     .
      757     assign
      758       v-seconds = v-seconds modulo 60
      759     .
      760     return
      761         (if v-day-number <> 0
      762           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      763           else ""
      764         )
      765       + (if v-day-number <> 0 or v-hour <> 0
      766           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      767           else ""
      768         )
      769       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      770           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      771           else ""
      772         )
      773       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      774       .
      775   end.
      776   function cur-time-string returns character
      777   :
      778     define variable v-date as date      no-undo .
      779     define variable v-time as integer   no-undo .
      780     run cur-time in this-procedure
      781       (output v-date
      782       ,output v-time
      783       ) .
      784     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      785   end.
      786   function cur-time-string-sec returns character
      787   :
      788     define variable v-date as date      no-undo .
      789     define variable v-time as integer   no-undo .
      790     run cur-time in this-procedure
      791       (output v-date
      792       ,output v-time
      793       ) .
      794     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      795   end.
      796   function cur-time-custom  returns character
      797   (input p-prefix as character
      798   ,input p-date-format as character
      799   ,input p-delimiter as character
      800   ,input p-time-format as character
      801   ,input p-suffix as character
      802   )
      803   :
      804     define variable v-date as date      no-undo .
      805     define variable v-time as integer   no-undo .
      806     run cur-time in this-procedure
      807       (output v-date
      808       ,output v-time
      809       ) .
      810     return
      811       p-prefix
      812       + string(v-date, p-date-format)
      813       + p-delimiter
      814       + string(v-time, p-time-format)
      815       + p-suffix
      816       .
      817   end.
      818   function cur-time-print  returns character
      819   :
      820     define variable v-date as date      no-undo .
      821     define variable v-time as integer   no-undo .
      822     run cur-time in this-procedure
      823       (output v-date
      824       ,output v-time
      825       ) .
      826     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      827   end.
      828   function cur-time-datetime returns datetime
      829   :
      830     define variable v-char as character no-undo .
      831     define variable v-datetime as datetime no-undo .
      832     v-char = cur-time-string().
      833     v-datetime = datetime(v-char).
      834     return  v-datetime.
      835   end.
      836   function cur-time-string-msec returns character
      837   :
      838     define variable v-date as datetime  no-undo .
      839     v-date = now.
      840     return string(v-date) .
      841   end.
      842   define variable vss-include-info4 as character format "X(65)" no-undo
      843   initial "@(#)$Workfile$ $Revision$".
      844   procedure xmlchar-test :
      845   define input parameter p-in-string          as character        no-undo.
      846   define output parameter p-out-string-enc    as character        no-undo.
      847   define output parameter p-out-string-dec    as character        no-undo.
      848   do
      849   on error undo, return error
      850   :
      851          run xmlchar-encode in this-procedure
      852       (
      853             input p-in-string
      854           , output p-out-string-enc
      855       ).
      856          run xmlchar-decode in this-procedure
      857       (
      858             input p-out-string-enc
      859           , output p-out-string-dec
      860       ).
      861   end.
      862   end .
      863   procedure xmlchar-encode :
      864   define input parameter p-in-string      as character        no-undo.
      865   define output parameter p-out-string    as character        no-undo.
      866       define variable v-position      as integer      no-undo.
      867       define variable v-current-char  as character    no-undo.
      868   do
      869   on error undo, return error
      870   :
      871       assign
      872           p-out-string = "":U
      873       .
      874       case p-in-string
      875       :
      876           when ?
      877           then do:
      878               assign
      879                   p-out-string = "?":U
      880               .
      881           end.
      882           when "?":U
      883           then do:
      884               assign
      885                   p-out-string = "&#63;":U
      886               .
      887           end.
      888           otherwise do:
      889               do v-position = 1 to length( p-in-string )
      890               :
      891                   assign
      892                       v-current-char = substring( p-in-string, v-position, 1 )
      893                   .
      894                   case v-current-char
      895                   :
      896                       when "&":U
      897                       then do:
      898                           assign
      899                               p-out-string = p-out-string + "&amp;":U
      900                           .
      901                       end.
      902                       when ">":U
      903                       then do:
      904                           assign
      905                               p-out-string = p-out-string + "&gt;":U
      906                           .
      907                       end.
      908                       when "<":U
      909                       then do:
      910                           assign
      911                               p-out-string = p-out-string + "&lt;":U
      912                           .
      913                       end.
      914                       when "'":U
      915                       then do:
      916                           assign
      917                               p-out-string = p-out-string + "&apos;":U
      918                           .
      919                       end.
      920                       when '"':U
      921                       then do:
      922                           assign
      923                               p-out-string = p-out-string + "&quot;":U
      924                           .
      925                       end.
      926                       when chr(1)
      927                       then do:
      928                           assign
      929                               p-out-string = p-out-string + "":U
      930                           .
      931                       end.
      932                       when chr(2)
      933                       then do:
      934                           assign
      935                               p-out-string = p-out-string + "":U
      936                           .
      937                       end.
      938                       when chr(3)
      939                       then do:
      940                           assign
      941                               p-out-string = p-out-string + "":U
      942                           .
      943                       end.
      944                       when chr(4)
      945                       then do:
      946                           assign
      947                               p-out-string = p-out-string + "":U
      948                           .
      949                       end.
      950                       when chr(5)
      951                       then do:
      952                           assign
      953                               p-out-string = p-out-string + "":U
      954                           .
      955                       end.
      956                       when chr(6)
      957                       then do:
      958                           assign
      959                               p-out-string = p-out-string + "":U
      960                           .
      961                       end.
      962                       when chr(7)
      963                       then do:
      964                           assign
      965                               p-out-string = p-out-string + "":U
      966                           .
      967                       end.
      968                       when chr(8)
      969                       then do:
      970                           assign
      971                               p-out-string = p-out-string + "":U
      972                           .
      973                       end.
      974                       when chr(9)
      975                       then do:
      976                           assign
      977                               p-out-string = p-out-string + "":U
      978                           .
      979                       end.
      980                       when chr(29)
      981                       then do:
      982                           assign
      983                               p-out-string = p-out-string + "":U
      984                           .
      985                       end.
      986                       when chr(10)
      987                       then do:
      988                           assign
      989                               p-out-string = p-out-string + "&#10;":U
      990                           .
      991                       end.
      992                       when chr(13)
      993                       then do:
      994                           assign
      995                               p-out-string = p-out-string + "&#13;":U
      996                           .
      997                       end.
      998                       otherwise do:
      999                           assign
     1000                               p-out-string = p-out-string + v-current-char
     1001                           .
     1002                       end.
     1003                   end case.
     1004               end.
     1005           end.
     1006       end case.
     1007   end.
     1008   end .
     1009   procedure xmlchar-encode-1c :
     1010   define input parameter p-in-string      as character        no-undo.
