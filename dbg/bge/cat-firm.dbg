        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: c89b59c2f62e, 135, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        4   define variable vss-date        as character no-undo init "$Date: Mon Feb 16 20:48:25 2015 +0400 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: cat-firm.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: bge/cat-firm.p $":U .
        7   define variable vss-description as character no-undo init "Экспорт контрагентов".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   define  temp-table temp-host no-undo
       79     field host-code like ub.store.host-code
       80     index xpk host-code
       81   .
       82   define  temp-table temp-obj no-undo
       83     field obj-type  like ub.clients.obj-type
       84     field obj-code  like ub.clients.obj-code
       85     field host-code like ub.store.host-code
       86     field db-num    like ub.clients.db-num
       87     index xpk  obj-type obj-code
       88     index xie1 host-code
       89     index xie2 db-num host-code
       90   .
       91   procedure init-temphost:
       92     define buffer buf_store   for ub.store .
       93     define buffer buf_shop    for ub.shop .
       94     define buffer buf_clients for ub.clients .
       95     define buffer buf_db for ub.db .
       96     define buffer buf_temp-host for temp-host .
       97     define buffer buf_temp-obj for temp-obj .
       98     do
       99     on error undo, return error return-value
      100     :
      101       for each buf_store
      102       on error undo, return error
      103       :
      104         find first buf_temp-host
      105           where buf_temp-host.host-code = buf_store.host-code
      106           no-error .
      107         if not available buf_temp-host
      108         then do:
      109           create buf_temp-host .
      110           assign
      111             buf_temp-host.host-code = buf_store.host-code
      112           .
      113         end.
      114         find first buf_clients no-lock
      115           where buf_clients.obj-type = 'скл':U
      116             and buf_clients.obj-code = buf_store.obj-code
      117           no-error .
      118         if not available buf_clients
      119         then do:
      120           message
      121             "Ошибка при поиске клиента" skip
      122             "Клиент" 'скл':U buf_store.obj-code skip
      123             view-as alert-box error .
      124           undo, return error .
      125         end.
      126         create buf_temp-obj .
      127         assign
      128           buf_temp-obj.obj-type  = 'скл':U
      129           buf_temp-obj.obj-code  = buf_store.obj-code
      130           buf_temp-obj.host-code = buf_store.host-code
      131           buf_temp-obj.db-num    = buf_clients.db-num
      132         .
      133       end.
      134       for each buf_shop
      135       on error undo, return error
      136       :
      137         find first buf_temp-host
      138           where buf_temp-host.host-code = buf_shop.host-code
      139           no-error .
      140         if not available buf_temp-host
      141         then do:
      142           create buf_temp-host .
      143           assign
      144             buf_temp-host.host-code = buf_shop.host-code
      145           .
      146         end.
      147         find first buf_clients no-lock
      148           where buf_clients.obj-type = 'маг':U
      149             and buf_clients.obj-code = buf_shop.obj-code
      150           no-error .
      151         if not available buf_clients then do:
      152           message
      153             "Ошибка при поиске клиента" skip
      154             "Клиент" 'маг':U buf_shop.obj-code skip
      155             view-as alert-box error .
      156           undo, return error .
      157         end.
      158         create buf_temp-obj .
      159         assign
      160           buf_temp-obj.obj-type  = 'маг':U
      161           buf_temp-obj.obj-code  = buf_shop.obj-code
      162           buf_temp-obj.host-code = buf_shop.host-code
      163           buf_temp-obj.db-num    = buf_clients.db-num
      164         .
      165       end.
      166     end.
      167   end.
      168   define variable vss-include-info1 as character format "X(65)" no-undo
      169   initial "@(#)$Workfile$ $Revision$".
      170   DEF STREAM stmXMLOut.
      171   DEF STREAM stmXMLLog.
      172   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      173   procedure cur-time :
      174      define output parameter p-today as date      no-undo .
      175      define output parameter p-time  as integer   no-undo .
      176     do
      177     on error undo, return error
      178     :
      179       define variable v-date1 as date      no-undo .
      180       define variable v-date2 as date      no-undo .
      181       define variable v-time  as integer   no-undo .
      182       assign
      183         v-date1 = today
      184         v-time  = time
      185         v-date2 = today
      186       .
      187       if v-date1 <> v-date2
      188       then do:
      189         assign
      190           v-date1 = today
      191           v-time  = v-time
      192         .
      193       end.
      194       assign
      195         p-today = v-date1
      196         p-time  = v-time
      197       .
      198     end.
      199   end.
      200   function cur-time-date returns character
      201   :
      202     return string(today, '99/99/9999':U) .
      203   end.
      204   function cur-time-mjd returns decimal
      205   :
      206     define variable v-date as date      no-undo .
      207     define variable v-time as integer   no-undo .
      208     run cur-time in this-procedure
      209       (output v-date
      210       ,output v-time
      211       ) .
      212     return integer(v-date) - 2400002 + (v-time / 86400) .
      213   end.
      214   function cur-time-get-ending-index returns integer
      215   (input p-number as integer
      216   )
      217   :
      218     if p-number < 0
      219     or p-number = ?
      220     then do:
      221       return 1 .
      222     end.
      223     define variable v-rest as integer   no-undo .
      224     assign
      225       p-number = p-number modulo 100
      226     .
      227     if p-number < 20
      228     then do:
      229       assign
      230         v-rest = p-number
      231       .
      232     end.
      233     else do:
      234       assign
      235         v-rest = p-number modulo 10
      236       .
      237     end.
      238     case v-rest :
      239       when 1
      240       then do:
      241         return 2 .
      242       end.
      243       when 2 or
      244       when 3 or
      245       when 4
      246       then do:
      247         return 3 .
      248       end.
      249       otherwise do:
      250         return 1 .
      251       end.
      252     end case .
      253   end.
      254   procedure cur-time-mjd-to-date :
      255      define input  parameter i-mjd-diff as decimal no-undo.
      256      define output parameter o-Date     as date    no-undo.
      257      define output parameter o-Time     as integer no-undo.
      258      define variable v-day-number as integer   no-undo .
      259      if    i-mjd-diff < 0
      260         or i-mjd-diff = ?
      261      then do:
      262         return "?" .
      263      end.
      264      assign
      265         v-day-number = truncate(i-mjd-diff,0).
      266         o-Date = date(v-day-number + 2400002).
      267         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      268     .
      269   end.
      270   function cur-time-mjd-to-string returns character
      271   (input p-mjd-diff as decimal
      272   )
      273   :
      274     define variable v-day-number as integer   no-undo .
      275     define variable v-seconds    as integer   no-undo .
      276     define variable v-hour       as integer   no-undo .
      277     define variable v-min        as integer   no-undo .
      278     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      279     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      280     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      281     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      282     if p-mjd-diff < 0
      283     or p-mjd-diff = ?
      284     then do:
      285       return "?" .
      286     end.
      287     assign
      288       v-day-number = integer(truncate(p-mjd-diff,0))
      289       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      290     .
      291     if v-seconds > 86400
      292     then do:
      293       assign
      294         v-seconds = 86400 - 1
      295       .
      296     end.
      297     if v-seconds < 0
      298     then do:
      299       assign
      300         v-seconds = 0
      301       .
      302     end.
      303     assign
      304       v-hour = truncate(v-seconds / 3600, 0)
      305     .
      306     assign
      307       v-seconds = v-seconds modulo 3600
      308     .
      309     assign
      310       v-min = truncate(v-seconds / 60, 0)
      311     .
      312     assign
      313       v-seconds = v-seconds modulo 60
      314     .
      315     return
      316         (if v-day-number <> 0
      317           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      318           else ""
      319         )
      320       + (if v-day-number <> 0 or v-hour <> 0
      321           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      322           else ""
      323         )
      324       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      325           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      326           else ""
      327         )
      328       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      329       .
      330   end.
      331   function cur-time-string returns character
      332   :
      333     define variable v-date as date      no-undo .
      334     define variable v-time as integer   no-undo .
      335     run cur-time in this-procedure
      336       (output v-date
      337       ,output v-time
      338       ) .
      339     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      340   end.
      341   function cur-time-string-sec returns character
      342   :
      343     define variable v-date as date      no-undo .
      344     define variable v-time as integer   no-undo .
      345     run cur-time in this-procedure
      346       (output v-date
      347       ,output v-time
      348       ) .
      349     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      350   end.
      351   function cur-time-custom  returns character
      352   (input p-prefix as character
      353   ,input p-date-format as character
      354   ,input p-delimiter as character
      355   ,input p-time-format as character
      356   ,input p-suffix as character
      357   )
      358   :
      359     define variable v-date as date      no-undo .
      360     define variable v-time as integer   no-undo .
      361     run cur-time in this-procedure
      362       (output v-date
      363       ,output v-time
      364       ) .
      365     return
      366       p-prefix
      367       + string(v-date, p-date-format)
      368       + p-delimiter
      369       + string(v-time, p-time-format)
      370       + p-suffix
      371       .
      372   end.
      373   function cur-time-print  returns character
      374   :
      375     define variable v-date as date      no-undo .
      376     define variable v-time as integer   no-undo .
      377     run cur-time in this-procedure
      378       (output v-date
      379       ,output v-time
      380       ) .
      381     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      382   end.
      383   function cur-time-datetime returns datetime
      384   :
      385     define variable v-char as character no-undo .
      386     define variable v-datetime as datetime no-undo .
      387     v-char = cur-time-string().
      388     v-datetime = datetime(v-char).
      389     return  v-datetime.
      390   end.
      391   function cur-time-string-msec returns character
      392   :
      393     define variable v-date as datetime  no-undo .
      394     v-date = now.
      395     return string(v-date) .
      396   end.
      397   define variable vss-include-info3 as character format "X(65)" no-undo
      398   initial "@(#)$Workfile$ $Revision$".
      399   procedure xmlchar-test :
      400   define input parameter p-in-string          as character        no-undo.
      401   define output parameter p-out-string-enc    as character        no-undo.
      402   define output parameter p-out-string-dec    as character        no-undo.
      403   do
      404   on error undo, return error
      405   :
      406          run xmlchar-encode in this-procedure
      407       (
      408             input p-in-string
      409           , output p-out-string-enc
      410       ).
      411          run xmlchar-decode in this-procedure
      412       (
      413             input p-out-string-enc
      414           , output p-out-string-dec
      415       ).
      416   end.
      417   end .
      418   procedure xmlchar-encode :
      419   define input parameter p-in-string      as character        no-undo.
      420   define output parameter p-out-string    as character        no-undo.
      421       define variable v-position      as integer      no-undo.
      422       define variable v-current-char  as character    no-undo.
      423   do
      424   on error undo, return error
      425   :
      426       assign
      427           p-out-string = "":U
      428       .
      429       case p-in-string
      430       :
      431           when ?
      432           then do:
      433               assign
      434                   p-out-string = "?":U
      435               .
      436           end.
      437           when "?":U
      438           then do:
      439               assign
      440                   p-out-string = "&#63;":U
      441               .
      442           end.
      443           otherwise do:
      444               do v-position = 1 to length( p-in-string )
      445               :
      446                   assign
      447                       v-current-char = substring( p-in-string, v-position, 1 )
      448                   .
      449                   case v-current-char
      450                   :
      451                       when "&":U
      452                       then do:
      453                           assign
      454                               p-out-string = p-out-string + "&amp;":U
      455                           .
      456                       end.
      457                       when ">":U
      458                       then do:
      459                           assign
      460                               p-out-string = p-out-string + "&gt;":U
      461                           .
      462                       end.
      463                       when "<":U
      464                       then do:
      465                           assign
      466                               p-out-string = p-out-string + "&lt;":U
      467                           .
      468                       end.
      469                       when "'":U
      470                       then do:
      471                           assign
      472                               p-out-string = p-out-string + "&apos;":U
      473                           .
      474                       end.
      475                       when '"':U
      476                       then do:
      477                           assign
      478                               p-out-string = p-out-string + "&quot;":U
      479                           .
      480                       end.
      481                       when chr(1)
      482                       then do:
      483                           assign
      484                               p-out-string = p-out-string + "":U
      485                           .
      486                       end.
      487                       when chr(2)
      488                       then do:
      489                           assign
      490                               p-out-string = p-out-string + "":U
      491                           .
      492                       end.
      493                       when chr(3)
      494                       then do:
      495                           assign
      496                               p-out-string = p-out-string + "":U
      497                           .
      498                       end.
      499                       when chr(4)
      500                       then do:
      501                           assign
      502                               p-out-string = p-out-string + "":U
      503                           .
      504                       end.
      505                       when chr(5)
      506                       then do:
      507                           assign
      508                               p-out-string = p-out-string + "":U
      509                           .
      510                       end.
      511                       when chr(6)
      512                       then do:
      513                           assign
      514                               p-out-string = p-out-string + "":U
      515                           .
      516                       end.
      517                       when chr(7)
      518                       then do:
      519                           assign
      520                               p-out-string = p-out-string + "":U
      521                           .
      522                       end.
      523                       when chr(8)
      524                       then do:
      525                           assign
      526                               p-out-string = p-out-string + "":U
      527                           .
      528                       end.
      529                       when chr(9)
      530                       then do:
      531                           assign
      532                               p-out-string = p-out-string + "":U
      533                           .
      534                       end.
      535                       when chr(29)
      536                       then do:
      537                           assign
      538                               p-out-string = p-out-string + "":U
      539                           .
      540                       end.
      541                       when chr(10)
      542                       then do:
      543                           assign
      544                               p-out-string = p-out-string + "&#10;":U
      545                           .
      546                       end.
      547                       when chr(13)
      548                       then do:
      549                           assign
      550                               p-out-string = p-out-string + "&#13;":U
      551                           .
      552                       end.
      553                       otherwise do:
      554                           assign
      555                               p-out-string = p-out-string + v-current-char
      556                           .
      557                       end.
      558                   end case.
      559               end.
      560           end.
      561       end case.
      562   end.
      563   end .
      564   procedure xmlchar-encode-1c :
      565   define input parameter p-in-string      as character        no-undo.
      566   define output parameter p-out-string    as character        no-undo.
      567       define variable v-position      as integer      no-undo.
