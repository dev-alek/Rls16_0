     1071   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1072                                             INPUT iFlagEmpty AS INTEGER).
     1073       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1074       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1075           DO:
     1076               IF iFlagEmpty = 0                           THEN RETURN "".
     1077               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1078               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1079               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1080               ELSE RETURN "".
     1081           END.
     1082       ELSE DO:
     1083           run xmlchar-encode in this-procedure (
     1084                 input sToPlace
     1085               , output sToPlace
     1086           ).
     1087           ASSIGN
     1088               sToPlace = sParName + '="' + sToPlace + '"'
     1089           .
     1090           RETURN sToPlace.
     1091       END.
     1092   END FUNCTION.
     1093   function bge-xml-date returns character
     1094   ( input p-date as date )
     1095   :
     1096     define variable v-date-str as character no-undo .
     1097     run bge-xml-date-to-str in this-procedure ( input   p-date
     1098                                               , output  v-date-str
     1099                                               ) .
     1100     return v-date-str.
     1101   end function.
     1102   function bge-xml-str-date returns character
     1103   ( input p-date-str as character )
     1104   :
     1105     define variable v-date-str as character no-undo .
     1106     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1107                                                   , output  v-date-str
     1108                                                   ) .
     1109     return v-date-str.
     1110   end function.
     1111   function bge-xml-normalize-dec returns decimal
     1112   ( input p-val as decimal )
     1113   :
     1114     return (if p-val = ? then 0 else p-val) .
     1115   end function.
     1116   PROCEDURE wp-XMLTagOpen:
     1117   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1118   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1119   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1120       define variable v-out-string    as character    no-undo.
     1121   do
     1122   on error undo, return error
     1123   :
     1124       if v-bge-xml-bgefmt = "dbf":U
     1125       then do:
     1126       end.
     1127       else do:
     1128           assign
     1129               v-out-string = substitute( "&1&2<&3&4>"
     1130                                       , chr(10)
     1131                                       , fill( " ":U, 4 * iTagLevel)
     1132                                       , sTagName
     1133                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1134                               )
     1135           .
     1136           put stream stmXMLOut unformatted
     1137               v-out-string
     1138           .
     1139       end.
     1140   end.
     1141   END PROCEDURE.
     1142   PROCEDURE wp-XMLTagPut:
     1143     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1144     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1145     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1146     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1147       define variable v-out-string    as character    no-undo.
     1148   do
     1149   on error undo, return error
     1150   :
     1151       if v-bge-xml-bgefmt = "dbf":U
     1152       then do:
     1153           if v-bge-xml-dbf-file-name <> "":U
     1154           then do:
     1155               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1156               export stream stmXMLOut
     1157                   sTagName
     1158                   sParValue
     1159               .
     1160               output stream stmXMLOut close.
     1161           end.
     1162       end.
     1163       else do:
     1164           IF  iFlagEmpty = 1
     1165           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1166           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1167           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1168           THEN DO:
     1169               run xmlchar-encode in this-procedure (
     1170                   input sParValue
     1171                   , output sParValue
     1172               ).
     1173               assign
     1174                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1175                                               , chr(10)
     1176                                               , FILL(" ", 4 * iTagLevel)
     1177                                               , sTagName
     1178                                               , sParValue
     1179                               )
     1180               .
     1181               PUT STREAM stmXMLOut UNFORMATTED
     1182                   v-out-string
     1183               .
     1184           END.
     1185       end.
     1186   end.
     1187   END PROCEDURE.
     1188   PROCEDURE wp-XMLTagClose:
     1189   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1190   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1191       define variable v-out-string    as character    no-undo.
     1192   do
     1193   on error undo, return error
     1194   :
     1195       if v-bge-xml-bgefmt = "dbf":U
     1196       then do:
     1197       end.
     1198       else do:
     1199           assign
     1200               v-out-string = substitute( "&1&2</&3>"
     1201                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1202                                   , fill( " ", 4 * iTagLevel )
     1203                                   , sTagName
     1204                           )
     1205           .
     1206           PUT STREAM stmXMLOut UNFORMATTED
     1207               v-out-string
     1208           .
     1209       end.
     1210   end.
     1211   END PROCEDURE.
     1212   PROCEDURE wp-XMLWriteLog:
     1213     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1214     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1215     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1216   define variable v-str              as character no-undo .
     1217   define variable v-error-append     as logical   no-undo .
     1218   define variable v-error-append-msg as character no-undo .
     1219   assign
     1220     v-str = chr(10)
     1221             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1222             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1223     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1224     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1225     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1226   .
     1227   run bge/bge-log.p (input v-str) no-error .
     1228   if error-status:error then do:
     1229     assign
     1230       v-error-append     = yes
     1231       v-error-append-msg = return-value
     1232     .
     1233   end.
     1234   run gbl/fileapnd.p
     1235     ( input sFileName
     1236     , input v-str
     1237     , input 10
     1238     ) no-error .
     1239   if error-status:error then do:
     1240     assign
     1241       v-error-append     = yes
     1242       v-error-append-msg = substitute( "&1&2&3"
     1243                                       , v-error-append-msg
     1244                                       , chr(10)
     1245                                       , return-value
     1246                                       )
     1247     .
     1248   end.
     1249   if v-error-append
     1250   then do:
     1251     return error substitute( "&1" , v-error-append-msg ) .
     1252   end.
     1253   END PROCEDURE.
     1254   PROCEDURE wp-XMLWriteEDT:
     1255     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1256     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1257     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1258       if valid-handle ( hEDT )
     1259       then do:
     1260           hEDT :move-to-eof().
     1261           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1262                                           OR sToWrite = "&Line") THEN "" ELSE
     1263                                           cur-time-string-sec() + " ").
     1264           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1265                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1266                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1267           hEDT :insert-string(chr(10)).
     1268       end.
     1269       process events.
     1270       output to 'bgescn.txt' append.
     1271           put unformatted
     1272               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1273                                           OR sToWrite = "&Line") THEN "" ELSE
     1274                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1275               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1276                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1277                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1278           .
     1279       output close.
     1280   END PROCEDURE.
     1281   PROCEDURE wp-XMLShowCNT:
     1282     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1283       if valid-handle( hCNT )
     1284       then do:
     1285           ASSIGN hCNT :VISIBLE = TRUE.
     1286       end.
     1287   END PROCEDURE.
     1288   PROCEDURE wp-XMLHideCNT:
     1289     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1290       if valid-handle( hCNT )
     1291       then do:
     1292           ASSIGN hCNT :VISIBLE = FALSE.
     1293       end.
     1294   END PROCEDURE.
     1295   PROCEDURE wp-XMLWriteCNT:
     1296     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1297     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1298       if valid-handle( hCNT )
     1299       then do:
     1300           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1301       end.
     1302   END PROCEDURE.
     1303   procedure bge-xml-write-header:
     1304   do
     1305   on error undo, return error
     1306   :
     1307   define input parameter p-xml-file-name  as character        no-undo.
     1308   define input parameter p-doc-name       as character        no-undo.
     1309   define input parameter p-version        as character        no-undo.
     1310   define input parameter p-db-num         as integer          no-undo.
     1311   define input parameter p-date-from      as date             no-undo.
     1312   define input parameter p-shift-num-from as integer          no-undo.
     1313   define input parameter p-date-to        as date             no-undo.
     1314   define input parameter p-shift-num-to   as integer          no-undo.
     1315   define input parameter p-obj-list       as character        no-undo.
     1316   define input parameter p-doc-type-list  as character        no-undo.
     1317   define input parameter p-pay-code       as logical          no-undo.
     1318   define input parameter p-cst            as logical          no-undo.
     1319   define input parameter p-parts          as logical          no-undo.
     1320   define input parameter p-chk-pay-code   as logical          no-undo.
     1321   define input parameter p-pay-desk       as logical          no-undo.
     1322   define input parameter p-pay-desk-cards as logical          no-undo.
     1323   define input parameter p-deleted        as logical          no-undo.
     1324   define input parameter p-opened-docs    as logical          no-undo.
     1325   define variable v-out-string    as character    no-undo.
     1326   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1327   assign
     1328       v-out-string = substitute( "&1&2&3"
     1329                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1330                           , chr(10)
     1331                           , "<IBS_Trade_House>":U )
     1332   .
     1333   put stream stmXMLOut unformatted
     1334       v-out-string
     1335   .
     1336   run wp-XMLTagOpen(1, "header","").
     1337   if v-bge-xml-bgeflold = "oracle":u
     1338   then do:
     1339     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1340     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1341     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1342     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1343     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1344   end.
     1345   run wp-XMLTagOpen( 2, "manifest", "").
     1346   run wp-XMLTagOpen( 3, "document", "").
     1347   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1348   run wp-XMLTagput( 4, "description", "", 0).
     1349   run wp-XMLTagput( 4, "version", p-version, 0).
     1350   run wp-XMLTagclose( 3, "document" ).
     1351   run wp-XMLTagclose( 2, "manifest" ).
     1352   run wp-XMLTagclose( 1, "header" ).
     1353   run wp-XMLTagOpen(1, "options","").
     1354   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1355   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1356   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1357   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1358   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1359   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1360   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1361   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1362   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1363   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1364   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1365   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1366   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1367   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1368   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1369   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1370   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1371   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1372   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1373   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1374   run wp-XMLTagClose(1, "options").
     1375   run wp-XMLTagOpen( 1, "body", "" ).
     1376   output stream stmXMLOut close.
     1377   end.
     1378   end procedure.
     1379   procedure xml-bge-write-footer:
     1380   do
     1381   on error undo, return error return-value
     1382   :
     1383   define input parameter p-xml-file-name as character    no-undo.
     1384   define variable v-error-num     as integer           no-undo.
     1385   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1386   run wp-XMLTagClose( 1, "body" ).
     1387   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1388   output stream stmXMLOut close.
     1389   if v-bge-xml-bgeflold = "oracle":u
     1390   then do:
     1391     define variable v-tmp-file-name         as character no-undo .
     1392     define variable v-zip-file-name         as character no-undo .
     1393     define variable v-exch-file-name        as character no-undo .
     1394     define variable v-heap-file-name        as character no-undo .
     1395     define variable v-i                     as integer   no-undo .
     1396     define variable v-file-name             as character no-undo .
     1397     define variable v-arc                   as character no-undo .
     1398     define variable v-str                   as character no-undo .
     1399     define variable v-exch-tmp-file-name    as character no-undo .
     1400     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1401     define variable v-bge-xml-exch-dir      as character no-undo .
     1402     define variable v-bge-xml-heap-dir      as character no-undo .
     1403     define variable v-bge-xml-compress-heap as logical   no-undo .
     1404     define variable v-home-dir              as character no-undo .
     1405     define variable v-os-command            as character no-undo .
     1406     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1407     if v-home-dir = ?
     1408     then do:
     1409       undo, return error substitute( "&1&2&3"
     1410                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1411                                     , chr(10)
     1412                                     , "Обратитесь к администратору.":u
     1413                                     ).
     1414     end.
     1415     assign
     1416       v-home-dir = v-home-dir
     1417     .
     1418     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1419     if error-status :error
     1420     then do:
     1421       undo, return error substitute( "&1&2&3"
     1422                                     , "Неверно задан каталог экспорта.":u
     1423                                     , chr(10)
     1424                                     , "Обратитесь к администратору.":u
     1425                                     ).
     1426     end.
     1427     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1428     if v-bge-xml-exch-dir = ?
     1429     then do:
     1430       undo, return error substitute( "&1&2&3"
     1431                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1432                                     , chr(10)
     1433                                     , "Обратитесь к администратору.":u
     1434                                     ).
     1435     end.
     1436     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1437     if error-status :error
     1438     then do:
     1439       undo, return error substitute( "&1&2&3"
     1440                                     , "Неверно задан каталог экспорта (exch).":u
     1441                                     , chr(10)
     1442                                     , "Обратитесь к администратору.":u
     1443                                     ).
     1444     end.
     1445     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1446     if v-bge-xml-heap-dir = ?
     1447     then do:
     1448       undo, return error substitute( "&1&2&3"
     1449                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1450                                     , chr(10)
     1451                                     , "Обратитесь к администратору.":u
     1452                                     ).
     1453     end.
     1454     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1455     if error-status :error
     1456     then do:
     1457       undo, return error substitute( "&1&2&3"
     1458                                     , "Неверно задан каталог экспорта (heap).":u
     1459                                     , chr(10)
     1460                                     , "Обратитесь к администратору.":u
     1461                                     ).
     1462     end.
     1463     get-key-value section "BGE" key "heap-compress" value v-str.
     1464     assign
     1465       v-i = int(v-str)
     1466     no-error .
     1467     if v-i = ? or v-i = 0
     1468     then do:
     1469       assign
     1470         v-bge-xml-compress-heap = no
     1471       .
     1472     end.
     1473     else do:
     1474       assign
     1475         v-bge-xml-compress-heap = yes
     1476       .
     1477     end.
     1478     assign
     1479       v-arc = search( "exe/7za.exe":u )
     1480     .
     1481     if v-arc = ? or v-arc = ""
     1482     then do:
     1483       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1484     end.
     1485     assign
     1486       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1487       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1488       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1489       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1490       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1491       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1492       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1493     .
     1494     run gbl/del-file.p (input v-tmp-file-name) .
     1495     run gbl/del-file.p (input v-zip-file-name) .
     1496     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1497     if v-error-num > 0
     1498     then do:
     1499         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1500                                      , p-xml-file-name + "xm1":u
     1501                                      , v-tmp-file-name
     1502                                      , v-error-num
     1503                                      ).
     1504     end.
     1505     assign
     1506       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1507                                    , v-arc
     1508                                    , v-zip-file-name
     1509                                    , v-tmp-file-name
     1510                                    )
     1511     .
     1512     os-command silent value ( v-os-command ) .
     1513     run gbl/del-file.p (input v-heap-file-name) .
     1514     if v-bge-xml-compress-heap = no
     1515     then do:
     1516       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1517       if v-error-num > 0
     1518       then do:
     1519           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1520                                        , v-tmp-file-name
     1521                                        , v-heap-file-name
     1522                                        , v-error-num
     1523                                        ) .
     1524       end.
     1525     end.
     1526     else do:
     1527       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1528       if v-error-num > 0
     1529       then do:
     1530           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1531                                        , v-zip-file-name
     1532                                        , v-heap-file-name
     1533                                        , v-error-num
     1534                                        ) .
     1535       end.
     1536     end.
     1537     run gbl/del-file.p (input v-tmp-file-name) .
     1538     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1539     if error-status :error then do:
     1540       undo, return error substitute( "&1&2&3"
     1541                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1542                                     , chr(10)
     1543                                     , "Обратитесь к администратору."
     1544                                     ).
     1545     end.
     1546     run gbl/del-file.p (input v-exch-file-name) .
     1547     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1548     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1549     if v-error-num > 0
     1550     then do:
     1551       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1552                                     , v-zip-file-name
     1553                                     , v-exch-tmp-file-name
     1554                                     , v-error-num
     1555                                     ) .
     1556     end.
     1557     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1558     if v-error-num > 0
     1559     then do:
     1560       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1561                                     , v-exch-tmp-file-name
     1562                                     , v-exch-file-name
     1563                                     , v-error-num
     1564                                     ) .
     1565     end.
     1566     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1567   end.
     1568   else do:
     1569     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1570     if v-error-num > 0
     1571     then do:
     1572       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1573                                     , p-xml-file-name + "xm1"
     1574                                     , p-xml-file-name + "xml"
     1575                                     , v-error-num
     1576                                     ) .
     1577     end.
     1578   end.
     1579   if opsys = "unix"
     1580   then do:
     1581       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1582   end.
     1583   end.
     1584   end procedure.
     1585   procedure xml-bge-filename0:
     1586   define input parameter p-prefix   as character no-undo .
     1587   define input parameter p-name     as character no-undo .
     1588   define input parameter p-shared-process as logical no-undo .
     1589   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1590   define output parameter p-xml-file-name  as character no-undo .
     1591   // define output parameter p-fullfnamenoext as character no-undo .
     1592   define output parameter p-locked         as logical      no-undo.
     1593   define variable v-fullfnamenoext as character no-undo .
     1594   define variable v-fileext        as character no-undo .
     1595   define variable v-fullfname      as character no-undo .
     1596   define variable v-error-num      as integer   no-undo .
     1597   do
     1598   on error undo, return error
     1599   :
     1600     case v-bge-xml-bgeflold :
     1601       when "old" then do:
     1602         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1603         v-fileext       = ".xml":U .
     1604         v-fullfname     = v-fullfnamenoext + v-fileext .
     1605         p-xml-file-name = v-fullfname .
     1606         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1607         if v-error-num > 0 then do:
     1608           return error.
     1609         end.
     1610       end.
     1611       when "var" then do:
     1612         case p-prefix :
     1613           when "doc" then do:
     1614             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1615             v-fileext       = ".xml":U .
     1616             v-fullfname     = v-fullfnamenoext + v-fileext .
     1617             p-xml-file-name = v-fullfname .
     1618           end.
     1619           when "day" then do:
     1620             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1621             v-fileext       = ".xml":U .
     1622             v-fullfname     = v-fullfnamenoext + v-fileext .
     1623             p-xml-file-name = v-fullfname .
     1624           end.
     1625           otherwise do:
     1626             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1627             v-fileext       = ".xml":U .
     1628             v-fullfname     = v-fullfnamenoext + v-fileext .
     1629             p-xml-file-name = v-fullfname .
     1630           end.
     1631         end case.
     1632         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1633         if v-error-num > 0 then do:
     1634           return error.
     1635         end.
     1636       end.
     1637       when "new" then do:
     1638                   run bge/genfname.p (
     1639                       input p-home-dir
     1640                       , input p-prefix
     1641                       , input ""
     1642                       , input "xml"
     1643                       , input ""
     1644                       , output p-xml-file-name
     1645                   ).
     1646       end.
     1647       when "no-parameter" then do:
     1648         if p-shared-process then do:
     1649                       run bge/genfname.p (
     1650                           input p-home-dir
     1651                           , input "d"
     1652                           , input ""
     1653                           , input "xml"
     1654                           , input ""
     1655                           , output p-xml-file-name
     1656                       ).
     1657         end.
     1658         else do:
     1659           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1660           v-fileext       = ".xml":U .
     1661           v-fullfname     = v-fullfnamenoext + v-fileext .
     1662           p-xml-file-name = v-fullfname .
     1663           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1664           if v-error-num > 0 then do:
     1665             return error.
     1666           end.
     1667         end.
     1668       end.
     1669     end case.
     1670     assign
     1671       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1672       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1673     .
     1674   end .
     1675   end procedure .
     1676   procedure xml-bge-filename :
     1677   do
     1678   on error undo, return error
     1679   :
     1680   define input parameter p-prefix             as character    no-undo.
     1681   define input parameter p-name               as character    no-undo.
     1682   define input parameter p-shared-process     as logical      no-undo.
     1683   define output parameter p-xml-file-name     as character    no-undo.
     1684   define output parameter p-log-file-name     as character    no-undo.
     1685   define output parameter p-locked            as logical      no-undo.
     1686   define variable v-home-dir          as character no-undo .
     1687   define variable v-error-num         as integer   no-undo .
     1688   define variable v-bge-xml-heap-dir  as character no-undo .
     1689       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1690       if v-home-dir = ?
     1691       then do:
     1692           message
     1693             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1694             skip(1)
     1695             skip "Обратитесь к администратору."
     1696           view-as alert-box error.
     1697           undo, return error .
     1698       end.
     1699       if v-bge-xml-bgeflold <> "oracle"
     1700       then do:
     1701         assign
     1702             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1703         .
     1704       end.
     1705       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1706       if error-status :error
     1707       then do:
     1708           message
     1709             skip "Неверно задан каталог экспорта."
     1710             skip(1)
     1711             skip "Обратитесь к администратору."
     1712           view-as alert-box error.
     1713           undo, return error .
     1714       end.
     1715       if v-bge-xml-bgefmt = "dbf":U
     1716       then do:
     1717           assign
     1718               p-xml-file-name = v-home-dir
     1719               p-locked        = no
     1720           .
     1721       end.
     1722       else do:
     1723           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1724             output p-xml-file-name, output p-locked) .
     1725       end.
     1726       if v-bge-xml-bgeflold = "oracle"
     1727       then do:
     1728         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1729         if v-bge-xml-heap-dir = ?
     1730         then do:
     1731           undo, return error substitute( "&1&2&3"
     1732                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1733                                         , chr(10)
     1734                                         , "Обратитесь к администратору.":u
     1735                                         ).
     1736         end.
     1737         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1738         if error-status :error
     1739         then do:
     1740           undo, return error substitute( "&1&2&3"
     1741                                         , "Неверно задан каталог экспорта (heap).":u
     1742                                         , chr(10)
     1743                                         , "Обратитесь к администратору.":u
     1744                                         ).
     1745         end.
     1746         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1747           assign
     1748             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1749           .
     1750         end.
     1751         else do:
     1752           assign
     1753             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1754           .
     1755         end.
     1756       end.
     1757       else do:
     1758         assign
     1759             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1760         .
     1761       end.
     1762       assign
     1763          v-bge-xml-static-log-file-name = p-log-file-name
     1764       .
     1765   end.
     1766   end procedure.
     1767   procedure bge-xml-read-config :
     1768   do
     1769   on error undo, return error return-value
     1770   :
     1771   define input  parameter p-last-date as date      no-undo .
     1772   define input  parameter p-db-num    as integer   no-undo .
     1773       define variable v-bgeclall      as character     no-undo.
     1774       define variable v-bgedict       as character     no-undo.
     1775       define variable v-bgeshift      as character     no-undo.
     1776       define variable v-par-type      as character     no-undo.
     1777       define variable v-bgeflnm       as character     no-undo.
     1778       define variable v-bgecliiv      as character     no-undo .
     1779       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1780       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1781       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1782       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1783       define variable v-db-num-str    as character     no-undo .
     1784       define variable v-param-type      as character  no-undo .
     1785       define variable v-value-character as character  no-undo .
     1786       define variable v-value-date      as date       no-undo .
     1787       define variable v-value-decimal   as decimal    no-undo .
     1788       define variable v-value-integer   as integer    no-undo .
     1789       define variable v-value-logical   as logical    no-undo .
     1790       define variable v-tth             as handle      no-undo .
     1791       run adm/shattri.p ( input "get":U
     1792                         , input  '':u
     1793                         , input  0
     1794                         , input  'bge-export':U
     1795                         , input  'bgeclall':U
     1796                         , output v-bgecliiv
     1797                         , output v-value-date
     1798                         , output v-value-decimal
     1799                         , output v-value-integer
     1800                         , output v-value-logical
     1801                         , output v-param-type
     1802                         , input-output table-handle v-tth
     1803                         ) no-error .
     1804       if error-status :error
     1805       then do:
     1806         assign
     1807           v-bge-xml-bgecliiv = no
     1808         .
     1809       end.
     1810       else do:
     1811         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1812       end.
     1813       delete object v-tth.
     1814       assign
     1815           v-bge-xml-bgeclall = no
     1816           v-bge-xml-bgedict  = no
     1817       .
     1818       run adm/shattri.p ( input "get":U
     1819                         , input  '':u
     1820                         , input  0
     1821                         , input  'bge-export':U
     1822                         , input  'bgeclall':U
     1823                         , output v-value-character
     1824                         , output v-value-date
     1825                         , output v-value-decimal
     1826                         , output v-value-integer
     1827                         , output v-value-logical
     1828                         , output v-param-type
     1829                         , input-output table-handle v-tth
     1830                         ) no-error .
     1831       if error-status :error
     1832       then do:
     1833         assign
     1834           v-bge-xml-bgeclall = no
     1835         .
     1836       end.
     1837       else do:
     1838         assign
     1839           v-bge-xml-bgeclall = v-value-logical
     1840         .
     1841       end.
     1842       delete object v-tth.
     1843       run adm/shattri.p ( input "get":U
     1844                         , input  '':u
     1845                         , input  0
     1846                         , input  'bge-export':U
     1847                         , input  'bgedict':U
     1848                         , output v-value-character
     1849                         , output v-value-date
     1850                         , output v-value-decimal
     1851                         , output v-value-integer
     1852                         , output v-value-logical
     1853                         , output v-param-type
     1854                         , input-output table-handle v-tth
     1855                         ) no-error .
     1856       if error-status :error
     1857       then do:
     1858         assign
     1859           v-bge-xml-bgedict = no
     1860         .
     1861       end.
     1862       else do:
     1863         assign
     1864           v-bge-xml-bgedict = v-value-logical
     1865         .
     1866       end.
     1867       delete object v-tth.
     1868       run adm/shattri.p ( input "get":U
     1869                         , input  '':u
     1870                         , input  0
     1871                         , input  'bge-export':U
     1872                         , input  'bgefmt':U
     1873                         , output v-value-character
     1874                         , output v-value-date
     1875                         , output v-value-decimal
     1876                         , output v-value-integer
     1877                         , output v-value-logical
     1878                         , output v-param-type
     1879                         , input-output table-handle v-tth
     1880                         ) no-error .
     1881       if error-status :error
     1882       then do:
     1883         assign
     1884           v-bge-xml-bgefmt  = "xml":U
     1885         .
     1886       end.
     1887       else do:
     1888         assign
     1889           v-bge-xml-bgefmt  = v-value-character
     1890         .
     1891       end.
     1892       delete object v-tth.
     1893       run adm/shattri.p ( input "get":U
     1894                         , input  '':u
     1895                         , input  0
     1896                         , input  'bge-export':U
     1897                         , input  'bgeshift':U
     1898                         , output v-value-character
     1899                         , output v-value-date
     1900                         , output v-value-decimal
     1901                         , output v-value-integer
     1902                         , output v-value-logical
     1903                         , output v-param-type
     1904                         , input-output table-handle v-tth
     1905                         ) no-error .
     1906       if error-status :error
     1907       then do:
     1908         assign
     1909             v-bge-xml-shift-mode = no
     1910         .
     1911       end.
     1912       else do:
     1913         assign
     1914             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1915         .
     1916       end.
     1917       delete object v-tth.
     1918       run adm/shattri.p ( input "get":U
     1919                         , input  '':u
     1920                         , input  0
     1921                         , input  'bge-export':U
     1922                         , input  'bgeflold':U
     1923                         , output v-value-character
     1924                         , output v-value-date
     1925                         , output v-value-decimal
     1926                         , output v-value-integer
     1927                         , output v-value-logical
     1928                         , output v-param-type
     1929                         , input-output table-handle v-tth
     1930                         ) no-error .
     1931       if error-status :error
     1932       then do:
     1933         assign
     1934           v-bge-xml-bgeflold = "no-parameter":U
     1935         .
     1936       end.
     1937       else do:
     1938         assign
     1939           v-bge-xml-bgeflold  = v-value-character
     1940         .
     1941       end.
     1942       delete object v-tth.
     1943       assign
     1944         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1945         v-bge-xml-db-num-str  = v-db-num-str
     1946       .
     1947       if p-last-date <> ?
     1948       then do:
     1949           run adm/shattri.p ( input "get":U
     1950                             , input  '':u
     1951                             , input  0
     1952                             , input  'bge-export':U
     1953                             , input  'bgeflnm':U
     1954                             , output v-value-character
     1955                             , output v-value-date
     1956                             , output v-value-decimal
     1957                             , output v-value-integer
     1958                             , output v-value-logical
     1959                             , output v-param-type
     1960                             , input-output table-handle v-tth
     1961                             ) no-error .
     1962           if error-status :error
     1963           then do:
     1964             assign
     1965               v-bgeflnm = '':U
     1966             .
     1967           end.
     1968           else do:
     1969             assign
     1970               v-bgeflnm = v-value-character
     1971             .
     1972           end.
     1973           delete object v-tth.
     1974           if v-bge-xml-bgeflold = "var"
     1975           then do:
     1976               if v-bgeflnm = ?
     1977               or num-entries( v-bgeflnm ) < 2
     1978               then do:
     1979                   assign
     1980                       v-bge-xml-bgeflold = "new"
     1981                   .
     1982               end.
     1983               else do:
     1984                   assign
     1985                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1986                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1987                   .
     1988                   assign
     1989                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1990                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1991                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1992                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1993                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1994                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1995                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1996                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1997                   .
     1998               end.
     1999           end.
     2000       end.
     2001   end.
     2002   end procedure.
     2003   procedure bge-xml-get-ref-filename :
     2004   define input parameter p-in-file-name       as character        no-undo.
     2005   define output parameter p-home-dir          as character        no-undo.
     2006   define output parameter p-out-file-name     as character        no-undo.
     2007   define output parameter p-locked            as logical          no-undo.
     2008       define variable v-counter       as integer      no-undo.
     2009       define variable v-error-level   as integer      no-undo.
     2010   do
     2011   on error undo, return error
     2012   :
     2013       run bge/bge-ini.p (
     2014             input "bge"
     2015           , output p-home-dir
     2016       ).
     2017       if return-value <> "OK"
     2018       then do:
     2019           undo, return error.
     2020       end.
     2021       assign
     2022           p-home-dir = p-home-dir + "\dict":U
     2023       .
     2024       run bge/dir_cd.p (
     2025           input p-home-dir
     2026           , input "CA"
     2027       ).
     2028       if return-value = "ERROR"
     2029       then do:
     2030           undo, return error.
     2031       end.
     2032       assign
     2033           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     2034       .
     2035       assign
     2036           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     2037       .
     2038       wait-lock:
     2039       do v-counter = 1 TO 3
     2040       :
     2041           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     2042           if p-locked = no
     2043           then do:
     2044               leave wait-lock.
     2045           end.
     2046           else do:
     2047               readkey pause 1.
     2048           end.
     2049       END.
     2050       if p-locked = yes
     2051       then do:
     2052           undo, return error.
     2053       end.
     2054       run bge/os_copy.p (
     2055             input "D":U
     2056           , input p-out-file-name + "xml":U
     2057           , input "":U
     2058           , output v-error-level
     2059       ).
     2060       if v-error-level > 0
     2061       then do:
     2062           undo, return error.
     2063       end.
     2064   end.
     2065   end procedure.
     2066   procedure bge-xml-write-ref-header :
     2067   define input parameter p-bge-name as character        no-undo.
     2068   define input parameter p-file-name as character        no-undo.
     2069       define variable v-out-string    as character    no-undo.
     2070   do
     2071   on error undo, return error
     2072   :
     2073       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2074       put stream stmXMLOut unformatted
     2075           "<?xml version='1.0' encoding='windows-1251'?>":U
     2076       .
     2077       assign
     2078           v-out-string = substitute( "&1&2"
     2079                               , chr(10)
     2080                               , "<IBS_Trade_House>":U )
     2081       .
     2082       put stream stmXMLOut unformatted
     2083           v-out-string
     2084       .
     2085       run wp-XMLTagOpen( 1, "header", "" ).
     2086       if v-bge-xml-bgeflold = "oracle":u
     2087       then do:
     2088         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2089         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2090         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2091         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2092         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2093       end.
     2094       else do:
     2095         run wp-XMLTagOpen( 2, "delivery", "" ).
     2096         run wp-XMLTagOpen( 3, "to", "" ).
     2097         run wp-XMLTagClose( 3, "to" ).
     2098         run wp-XMLTagOpen( 3, "from", "" ).
     2099         run wp-XMLTagClose( 3, "from" ).
     2100         run wp-XMLTagClose( 2, "delivery" ).
     2101       end.
     2102       run wp-XMLTagOpen( 2, "manifest", "" ).
     2103       run wp-XMLTagOpen( 3, "document", "" ).
     2104       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2105       run wp-XMLTagPut( 4, "description", "", 0 ).
     2106       run wp-XMLTagClose( 3, "document" ).
     2107       run wp-XMLTagClose( 2, "manifest" ).
     2108       run wp-XMLTagClose( 1, "header" ).
     2109       run wp-XMLTagOpen( 1, "body", "" ).
     2110   end.
     2111   end procedure.
     2112   procedure bge-xml-write-ref-footer :
     2113   define input parameter p-file-name as character        no-undo.
     2114       define variable v-error-level   as integer      no-undo.
     2115   do
     2116   on error undo, return error
     2117   :
     2118       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2119       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2120       output stream stmXMLOut close.
     2121       run bge/os_copy.p (
     2122             input "M":U
     2123           , input p-file-name + "xm1":U
     2124           , input p-file-name + "xml":U
     2125           , output v-error-level
     2126       ).
     2127       if v-error-level > 0
     2128       then do:
     2129           undo, return error.
     2130       end.
     2131   end.
     2132   end procedure.
     2133   procedure bge-xml-out-dir :
     2134   define output parameter p-out-dir       as character    no-undo.
     2135   define output parameter p-log-file-name as character    no-undo.
     2136   do
     2137   on error undo, return error
     2138   :
     2139       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2140       if p-out-dir = ?
     2141       then do:
     2142           message
     2143             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2144                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2145             skip(1)
     2146             skip "Обратитесь к администратору."
     2147           view-as alert-box error.
     2148           undo, return error .
     2149       end.
     2150       if v-bge-xml-bgeflold <> "oracle" then assign
     2151         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2152       .
     2153       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2154       if error-status :error  then do:
     2155           run wp-XMLWriteLog in this-procedure (
     2156                 input p-log-file-name
     2157               , input 0
     2158               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2159                                   , p-out-dir
     2160                                   , return-value
     2161                                   , trim( error-status :get-message( 1 ) )
     2162                                   )
     2163           ).
     2164           undo, return error.
     2165       end.
     2166       assign
     2167           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2168           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2169       .
     2170   end.
     2171   end procedure.
     2172   procedure bge-xml-out-dir2 :
     2173   define output parameter p-out-dir       as character    no-undo.
     2174   define output parameter p-out-dirR      as character    no-undo.
     2175   define output parameter p-log-file-name as character    no-undo.
     2176   do
     2177   on error undo, return error
     2178   :
     2179       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2180       if p-out-dir = ?
     2181       then do:
     2182           message
     2183             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2184                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2185             skip(1)
     2186             skip "Обратитесь к администратору."
     2187           view-as alert-box error.
     2188           undo, return error .
     2189       end.
     2190       if v-bge-xml-bgeflold <> "oracle" then assign
     2191             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2192             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2193         .
     2194       else p-out-dirR = p-out-dir .
     2195       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2196       if error-status :error  then do:
     2197           run wp-XMLWriteLog in this-procedure (
     2198                 input p-log-file-name
     2199               , input 0
     2200               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2201                                   , p-out-dir
     2202                                   , return-value
     2203                                   , error-status :get-message( 1 )
     2204                                   )
     2205           ).
     2206           undo, return error.
     2207       end.
     2208       if p-out-dirR <> p-out-dir then do:
     2209         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2210         if error-status :error then do:
     2211           run wp-XMLWriteLog in this-procedure (
     2212                 input p-log-file-name
     2213               , input 0
     2214               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2215                                   , p-out-dirR
     2216                                   , return-value
     2217                                   , error-status :get-message( 1 )
     2218                                   )
     2219           ).
     2220           p-out-dirR = p-out-dir .
     2221         end.
     2222       end .
     2223       assign
     2224         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2225         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2226       .
     2227   end.
     2228   end procedure.
     2229   procedure bge-xml-out-file :
     2230   do
     2231   on error undo, return error
     2232   :
     2233   define input parameter p-out-dir            as character        no-undo.
     2234   define input parameter p-prefix             as character        no-undo.
     2235   define input parameter p-sheduled           as logical          no-undo.
     2236   define output parameter p-xml-file-name     as character        no-undo.
     2237   define output parameter p-locked            as logical          no-undo.
     2238   define variable v-home-dir      as character     no-undo.
     2239   define variable v-error-num     as integer       no-undo.
     2240   define variable v-today             as date         no-undo.
     2241   define variable v-time              as integer      no-undo.
     2242       if v-bge-xml-bgefmt = "dbf":U
     2243       then do:
     2244           assign
     2245               p-xml-file-name = p-out-dir
     2246               p-locked        = no
     2247           .
     2248       end.
     2249       else do:
     2250           if v-bge-xml-bgeflold = "firm":U
     2251           then do:
     2252               run bge/genfname.p (
     2253                     input p-out-dir
     2254                   , input p-prefix
     2255                   , input "":U
     2256                   , input "arj":U
     2257                   , input "":U
     2258                   , output p-xml-file-name
     2259               ).
     2260           end.
     2261           else do:
     2262               run bge/genfname.p (
     2263                     input p-out-dir
     2264                   , input p-prefix
     2265                   , input "":U
     2266                   , input "xml":U
     2267                   , input "":U
     2268                   , output p-xml-file-name
     2269               ).
     2270           end.
     2271           assign
     2272               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2273               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2274           .
     2275       end.
     2276   end.
     2277   end procedure.
     2278   procedure bge-xml-init-ext-doc-type :
     2279       define variable v-counter    as integer      no-undo.
     2280       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2281   do
     2282   for buf_temp_ext-doc-type
     2283   on error undo, return error
     2284   :
     2285       empty temp-table buf_temp_ext-doc-type.
     2286       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2287       :
     2288           create buf_temp_ext-doc-type.
     2289           assign
     2290               buf_temp_ext-doc-type.edt-key               = v-counter
     2291               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2292               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2293           .
     2294       end.
     2295   end.
     2296   end procedure.
     2297   procedure bge-xml-get-decimal-shift-num :
     2298   define input parameter p-shift-date     as date             no-undo.
     2299   define input parameter p-shift-num      as integer          no-undo.
     2300   define output parameter p-shift-decimal as decimal          no-undo.
     2301   do
     2302   on error undo, return error
     2303   :
     2304       assign
     2305           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2306       .
     2307   end.
     2308   end procedure.
     2309   procedure bge-xml-ora-exp-filename :
     2310     define input  parameter p-table-name  as character no-undo .
     2311     define input  parameter p-doc-code    as character no-undo .
     2312     define input  parameter p-obj-code    as integer   no-undo .
     2313     define output parameter p-filename    as character no-undo .
     2314     define output parameter p-seq-num     as integer   no-undo .
     2315     define variable v-ora-exp-seq     as integer   no-undo .
     2316     define variable v-ora-exp-seq-str as character no-undo .
     2317     define variable v-home-dir        as character no-undo.
     2318   do
     2319   on error undo, return error return-value
     2320   :
     2321     if v-bge-xml-bgeflold = "oracle":u
     2322     then do:
     2323       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2324       if v-home-dir = ?
     2325       then do:
     2326         undo, return error substitute( "&1&2&3":U
     2327                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2328                                       , chr(10)
     2329                                       , "Обратитесь к администратору.":U
     2330                                       ).
     2331       end.
     2332       assign
     2333           v-home-dir = v-home-dir
     2334       .
     2335       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2336       if error-status :error
     2337       then do:
     2338         undo, return error substitute( "&1&2&3":U
     2339                                       , "Неверно задан каталог экспорта.":U
     2340                                       , chr(10)
     2341                                       , "Обратитесь к администратору.":U
     2342                                       ).
     2343       end.
     2344       assign
     2345         v-ora-exp-seq = ?
     2346       .
     2347       if  p-table-name <> ? and
     2348           p-doc-code <> ?
     2349       then do:
     2350         run bge/get-oesq.p ( input p-table-name
     2351                            , input p-doc-code
     2352                            , output v-ora-exp-seq
     2353                            ) no-error .
     2354         if error-status :error = yes
     2355         then do:
     2356           undo, return error return-value .
     2357         end.
     2358       end.
     2359       if v-ora-exp-seq = ?
     2360       then do:
     2361         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2362         if error-status :error
     2363         then do:
     2364           undo, return error return-value .
     2365         end.
     2366       end.
     2367       if p-table-name <> ? and
     2368          p-doc-code   <> ?
     2369       then do:
     2370         run bge/oesqdoc.p ( input p-table-name
     2371                           , input p-doc-code
     2372                           , input v-ora-exp-seq
     2373                           ) no-error .
     2374         if error-status :error = yes
     2375         then do:
     2376           undo, return error return-value .
     2377         end.
     2378       end.
     2379       assign
     2380         p-seq-num  = v-ora-exp-seq
     2381         p-filename = substitute("&1/&2-000_&3."
     2382                                , v-home-dir
     2383                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2384                                , string(v-ora-exp-seq , "999999999")
     2385                                )
     2386       .
     2387     end.
     2388   end.
     2389   end procedure.
     2390   procedure bge-xml-date-to-str :
     2391     define input  parameter p-date  as date      no-undo .
     2392     define output parameter p-str   as character no-undo .
     2393   do
     2394   on error undo, return error return-value
     2395   :
     2396     if p-date <> ?
     2397     then do:
     2398       assign
     2399         p-str = substitute( "&1-&2-&3"
     2400                           , string( year(p-date)  , "9999")
     2401                           , string( month(p-date) , "99"  )
     2402                           , string( day(p-date)   , "99"  )
     2403                           )
     2404       .
     2405     end.
     2406     else do:
     2407       assign
     2408         p-str = ?
     2409       .
     2410     end.
     2411   end.
     2412   end procedure.
     2413   procedure bge-xml-date-str-to-str :
     2414     define input  parameter p-date-str  as character no-undo .
     2415     define output parameter p-str       as character no-undo .
     2416     define variable v-date          as date      no-undo .
     2417     define variable v-date-valid    as logical   no-undo .
     2418     define variable v-error-message as character no-undo .
     2419   do
     2420   on error undo, return error return-value
     2421   :
     2422     assign
     2423       p-str = ?
     2424     .
     2425     if p-date-str = ? or p-date-str = ""
     2426     then do:
     2427       return .
     2428     end.
     2429     run strtdate in this-procedure ( input  p-date-str
     2430                                    , output v-date
     2431                                    , output v-date-valid
     2432                                    , output v-error-message
     2433                                    ).
     2434     if v-date-valid <> true
     2435     then do:
     2436       return .
     2437     end.
     2438     assign
     2439       p-str = substitute( "&1-&2-&3"
     2440                         , string( year(v-date)  , "9999")
     2441                         , string( month(v-date) , "99"  )
     2442                         , string( day(v-date)   , "99"  )
     2443                         )
     2444     .
     2445   end.
     2446   end procedure.
     2447   procedure bge-xml-fill-tt-bgecliiv :
     2448     define input  parameter p-str as character no-undo .
     2449     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2450     define buffer buf_clients             for ub.clients.
     2451     define variable v-i         as integer   no-undo .
     2452     define variable v-count     as integer   no-undo .
     2453     define variable v-cli-count as integer   no-undo .
     2454     define variable v-client    as character no-undo .
     2455     define variable v-obj-type  as character no-undo .
     2456     define variable v-obj-code  as integer   no-undo .
     2457   do
     2458   on error undo, return error return-value
     2459   :
     2460     empty temp-table buf_tt-bge-xml-bgecliiv.
     2461     assign
     2462       v-bge-xml-bgecliiv = no
     2463       v-cli-count        = num-entries(p-str,';')
     2464     .
     2465     if v-cli-count > 0
     2466     then do:
     2467       _cli-cycle:
     2468       do v-i = 1 to v-cli-count
     2469       :
     2470         assign
     2471           v-client = entry(v-i , p-str, ';')
     2472         .
     2473         if num-entries(v-client) <> 2
     2474         then do:
     2475           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2476         end.
     2477         assign
     2478           v-obj-type = entry(1, v-client)
     2479         .
     2480         assign
     2481           v-obj-code = integer(entry(2, v-client))
     2482         no-error .
     2483         if error-status :error
     2484         then do:
     2485           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2486         end.
     2487         find first buf_clients no-lock
     2488           where buf_clients.obj-type = v-obj-type
     2489             and buf_clients.obj-code = v-obj-code
     2490         no-error.
     2491         if not available buf_clients
     2492         then do:
     2493           next _cli-cycle.
     2494         end.
     2495         find first buf_tt-bge-xml-bgecliiv no-lock
     2496           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2497             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2498         no-error .
     2499         if available buf_tt-bge-xml-bgecliiv
     2500         then do:
     2501           next _cli-cycle.
     2502         end.
     2503         create buf_tt-bge-xml-bgecliiv.
     2504         assign
     2505           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2506           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2507         .
     2508       end.
     2509     end.
     2510     else do:
     2511       assign
     2512         v-bge-xml-bgecliiv = no
     2513       .
     2514       return .
     2515     end.
     2516     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2517     if available buf_tt-bge-xml-bgecliiv
     2518     then do:
     2519       assign
     2520         v-bge-xml-bgecliiv = yes
     2521       .
     2522     end.
     2523   end.
     2524   end procedure.
     2525   procedure bge-xml-resolve-ext-doc-type :
     2526     define input  parameter p-ext-doc-type      as character no-undo .
     2527     define input  parameter p-obj-type          as character no-undo .
     2528     define input  parameter p-obj-code          as integer   no-undo .
     2529     define output parameter p-out-ext-doc-type  as character no-undo .
     2530     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2531   do
     2532   on error undo, return error return-value
     2533   :
     2534     assign
     2535       p-out-ext-doc-type = p-ext-doc-type
     2536     .
     2537     if p-ext-doc-type <> 'ie':U
     2538     then do:
     2539       return .
     2540     end.
     2541     if v-bge-xml-bgecliiv = yes
     2542     then do:
     2543       find first buf_tt-bge-xml-bgecliiv no-lock
     2544         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2545           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2546       no-error .
     2547       if available buf_tt-bge-xml-bgecliiv
     2548       then do:
     2549         assign
     2550           p-out-ext-doc-type = 'iv':U
     2551         .
     2552       end.
     2553     end.
     2554   end.
     2555   end procedure.
     2556   procedure safe-wp-xmltagput :
     2557     define input  parameter pTagLevel   as integer   no-undo .
     2558     define input  parameter pTagName    as character no-undo .
     2559     define input  parameter pParValue   as character no-undo .
     2560     define input  parameter pFlagEmpty  as integer   no-undo .
     2561   do
     2562   on error undo, return error return-value
     2563   :
     2564     if v-bge-xml-bgeflold = "oracle":u
     2565     then do:
     2566       return .
     2567     end.
     2568     run wp-xmltagput in this-procedure ( input pTagLevel
     2569                                        , input pTagName
     2570                                        , input pParValue
     2571                                        , input pFlagEmpty
     2572                                        ).
     2573   end.
     2574   end procedure.
     2575   define input parameter p-mode           as character    no-undo.
     2576   define input parameter p-host-code      as integer      no-undo.
     2577   define input parameter table for temp_bge-xml_clients .
     2578   define input parameter p-file-name      as character    no-undo.
     2579       define variable strPutOut       AS CHAR FORMAT "X(255)" NO-UNDO.
     2580       define variable strHomeDir      AS CHAR                 NO-UNDO.
     2581       define variable strOutFile      AS CHAR                 NO-UNDO.
     2582       define variable sLogFile        AS CHAR                 NO-UNDO.
     2583       define variable iRepeater       AS INT  INIT 0          NO-UNDO.
     2584       define variable bolLKfile       AS LOG  INIT NO         NO-UNDO.
     2585       define variable ErrorLevel      AS INT                  NO-UNDO.
     2586       define variable sObjType        AS CHAR                 NO-UNDO.
     2587       define variable iObjCode        AS INT                  NO-UNDO.
     2588       define buffer buf_clients       for ub.clients.
     2589   do
     2590   for buf_clients
     2591   on error undo, return error
     2592   :
     2593       run bge-xml-read-config in this-procedure ( input ?
     2594                                                 , input ?
     2595       ) no-error.
     2596       if error-status :error
     2597       then do:
     2598           message
     2599           vss-workfile vss-revision vss-description
     2600           skip "Ошибка чтения параметров экспорта."
     2601           skip "Для экспорта данных будут приняты параметры по умолчанию."
     2602           skip return-value
     2603           skip trim(error-status :get-message(1))
     2604               trim(error-status :get-message(2))
     2605               trim(error-status :get-message(3))
     2606           view-as alert-box error.
     2607       end.
     2608       run bge/bge-ini.p ("bge", OUTPUT strHomeDir).
     2609       IF RETURN-VALUE <> "OK" THEN RETURN "ERROR".
     2610       strHomeDir = strHomeDir + "\dict".
     2611       run bge/dir_cd.p (strHomeDir, "CA").
     2612       IF RETURN-VALUE = "ERROR" THEN RETURN "ERROR".
     2613       strOutFile = strHomeDir + "\" + "firm" + p-file-name + ".".
     2614       bolLKfile = (SEARCH (strOutFile + "xml") <> ?).
     2615       DO iRepeater = 1 TO 3 WHILE bolLKfile:
     2616       bolLKfile = (SEARCH (strOutFile + "lk") <> ?).
     2617       IF bolLKfile THEN READKEY PAUSE 1.
     2618       END.
     2619       IF bolLKfile THEN RETURN "LOCKED".
     2620       run bge/os_copy.p ("D", strOutFile + "xml", "", OUTPUT ErrorLevel).
     2621       IF ErrorLevel > 0 THEN RETURN "ERROR".
     2622       OUTPUT STREAM stmXMLOut TO VALUE(strOutFile + "xm1") CONVERT TARGET "1251".
     2623       ASSIGN sLogFile = strHomeDir + "\" + "Actions.log".
     2624       run wp-XMLWriteLog in this-procedure ( input sLogFile, input 0, input "&Line" ).
     2625       run wp-XMLWriteLog in this-procedure ( input sLogFile, input 1, input "XML - Вывод КОНТРАГЕНТОВ" ).
     2626       run write-header in this-procedure.
     2627       IF lookup( "list":U, p-mode ) = 0
     2628       THEN DO:
     2629           run init-temphost.
     2630           if v-bge-xml-bgeclall = no
     2631           and p-host-code <> 0
     2632           then do:
     2633               for each temp-obj
     2634               where temp-obj.host-code = p-host-code
     2635               :
     2636                   find first buf_clients
     2637                        where buf_clients.obj-type = temp-obj.obj-type
     2638                          and buf_clients.obj-code = temp-obj.obj-code
     2639                   no-error.
     2640                   if error-status :error
     2641                   then do:
     2642                       run wp-xmlwritelog(slogfile, 1, "*** ERROR *** Не найден клиент " + temp-obj.obj-type + " " + string(temp-obj.obj-code) ).
     2643                       undo, next.
     2644                   end.
     2645                   run write-client in this-procedure (
     2646                         input buf_clients.obj-type
     2647                       , input buf_clients.obj-code
     2648                   ).
     2649               end.
     2650           end.
     2651           else do:
     2652               for each temp-obj
     2653               :
     2654                   find first buf_clients
     2655                        where buf_clients.obj-type = temp-obj.obj-type
     2656                          and buf_clients.obj-code = temp-obj.obj-code
     2657                   no-error.
     2658                   if error-status :error
     2659                   then do:
     2660                       run wp-xmlwritelog(slogfile, 1, "*** ERROR *** Не найден клиент " + temp-obj.obj-type + " " + string(temp-obj.obj-code) ).
     2661                       undo, next.
     2662                   end.
     2663                   run write-client in this-procedure (
     2664                         input buf_clients.obj-type
     2665                       , input buf_clients.obj-code
     2666                   ).
     2667               end.
     2668           end.
     2669           for each buf_clients no-lock
     2670              where buf_clients.obj-type <> 'маг':U
     2671                and buf_clients.obj-type <> 'скл':U
     2672           on error undo, return error
     2673           :
     2674               run write-client in this-procedure (
     2675                     input buf_clients.obj-type
     2676                   , input buf_clients.obj-code
     2677               ).
     2678           end.
     2679       END.
     2680       ELSE DO:
     2681           for each temp_bge-xml_clients
     2682           on error undo, return error
     2683           :
     2684               run write-client in this-procedure (
     2685                     input temp_bge-xml_clients.obj-type
     2686                   , input temp_bge-xml_clients.obj-code
     2687               ).
     2688           end.
     2689       END.
     2690       run wp-XMLTagClose(1, "body").
     2691       run wp-XMLTagClose(0, "IBS_Trade_House").
     2692       output stream stmXMLOut close.
     2693       run bge/os_copy.p ("M", strOutFile + "xm1", strOutFile + "xml", OUTPUT ErrorLevel).
     2694       IF ErrorLevel > 0 THEN RETURN "ERROR".
     2695       IF OPSYS = "UNIX" THEN OS-COMMAND SILENT
     2696       chmod 666 value (strOutFile + "xml") 2>/dev/null.
     2697       return "OK".
     2698   end.
     2699   procedure write-client:
     2700   do
     2701   on error undo, return error
     2702   :
     2703     define input parameter p-obj-type   as character        no-undo.
     2704     define input parameter p-obj-code   as integer          no-undo.
     2705   define variable v-out-string    as character    no-undo.
     2706   define variable v-self-host     as logical      no-undo.
     2707   define buffer buf_clients       for ub.clients.
     2708   define buffer buf_person        for ub.person.
     2709   define buffer buf_firm          for ub.firm.
     2710   define buffer buf_sysconf       for ub.sysconf.
     2711   define buffer buf_fin-schet     for ub.fin-schet.
     2712   define buffer buf_fin-bank      for ub.fin-bank.
     2713   define buffer buf_place-io      for ub.place-io.
     2714   define buffer buf_point-io      for ub.point-io.
     2715   find first buf_clients no-lock
     2716        where buf_clients.obj-type = p-obj-type
     2717          and buf_clients.obj-code = p-obj-code
     2718   no-error .
     2719   if not available buf_clients
     2720   then do:
     2721     return .
     2722   end.
     2723   assign
     2724       v-self-host = yes
     2725   .
     2726   if p-obj-type = 'орг':U
     2727   then do:
     2728       find first buf_sysconf no-lock
     2729            where buf_sysconf.host-code = p-obj-code
     2730       no-error.
     2731       if available buf_sysconf
     2732       then do:
     2733           assign
     2734               v-self-host = yes
     2735           .
     2736       end.
     2737   end.
     2738   run wp-XMLTagOpen in this-procedure ( input 2, "firm","").
     2739   run wp-XMLTagPut in this-procedure ( input 3, input "referenceNo", input buf_clients.obj-type + string(buf_clients.obj-code), input 0 ).
     2740   run wp-XMLTagPut in this-procedure ( input 3, input "name"       , input buf_clients.obj-name                               , input 0 ).
     2741   run wp-XMLTagPut in this-procedure ( input 3, input "orgtype"    , input buf_clients.obj-type                               , input 0 ).
     2742   run wp-XMLTagPut in this-procedure ( input 3, input "selfHost"   , input string( v-self-host )                              , input 3 ).
     2743   if buf_clients.stts <> 0
     2744   then do:
     2745       run wp-XMLTagPut in this-procedure ( input 3, input "status", input string(buf_clients.stts), input 0 ).
     2746   end.
     2747   run wp-XMLTagPut in this-procedure ( input 3, input "isBuyCons" , input string( buf_clients.buy-cons), 3).
     2748   run wp-XMLTagPut in this-procedure ( input 3, input "isBuyGoods", input string( buf_clients.buy-gds ), 3).
     2749   run wp-XMLTagPut in this-procedure ( input 3, input "isBuyServ" , input string( buf_clients.buy-serv), 3).
     2750   run wp-XMLTagPut in this-procedure ( input 3, input "isProd"    , input string( buf_clients.is-prod ), 3).
     2751   run wp-XMLTagPut in this-procedure ( input 3, input "isSupCons" , input string( buf_clients.sup-cons), 3).
     2752   run wp-XMLTagPut in this-procedure ( input 3, input "isSupGoods", input string( buf_clients.sup-gds ), 3).
     2753   run wp-XMLTagPut in this-procedure ( input 3, input "isSupServ" , input string( buf_clients.sup-serv), 3).
     2754   run wp-XMLTagPut in this-procedure ( input 3, input "comment", input buf_clients.PS, input 0 ).
     2755   if buf_clients.obj-type = 'орг':U
     2756   then do:
     2757       find first buf_firm no-lock
     2758            where buf_firm.firm-code = buf_clients.obj-code
     2759       no-error.
     2760       if available buf_firm
     2761       then do:
     2762           run wp-XMLTagPut(3, "ename", buf_firm.engl-name, 0).
     2763           assign
     2764               v-out-string = ( if buf_firm.ind = 0
     2765                                or buf_firm.ind = ?
     2766                                then ""
     2767                                else string( buf_firm.ind ) )
     2768                               + ( if buf_firm.ind = 0
     2769                                   or buf_firm.ind = ?
     2770                                   or buf_firm.city=""
     2771                                   then ""
     2772                                   else ", " )
     2773                               + buf_firm.city
     2774           .
     2775           assign
     2776               v-out-string = v-out-string
     2777                               + ( if v-out-string = ""
     2778                                   or buf_firm.addres1 = ""
     2779                                   or buf_firm.addres1 = ?
     2780                                   then ""
     2781                                   else ", " )
     2782                               + buf_firm.addres1
     2783           .
     2784           assign
     2785               v-out-string = v-out-string
     2786                               + ( if v-out-string = ""
     2787                                   or buf_firm.addres2 = ""
     2788                                   or buf_firm.addres2 = ?
     2789                                   then ""
     2790                                   else ", " )
     2791                               + buf_firm.addres2
     2792           .
     2793           run wp-XMLTagPut in this-procedure ( input 3, input "regAddr" , input v-out-string          , input 0).
     2794           run wp-XMLTagPut in this-procedure (
     2795                 input 3
     2796               , input "postAddr"
     2797               , input buf_firm.post-addr1
     2798                       + ( if buf_firm.post-addr1 = ""
     2799                           or buf_firm.post-addr1 = ?
     2800                           or buf_firm.post-addr2 = ""
     2801                           or buf_firm.post-addr2 = ?
     2802                           then ""
     2803                           else ", " )
     2804                       + buf_firm.post-addr2
     2805               , input 0
     2806           ).
     2807           run wp-XMLTagPut in this-procedure (
     2808                 input 3
     2809               , input "phones"
     2810               , input buf_firm.phone
     2811                       + ( if buf_firm.phone = ""
     2812                           or buf_firm.phone = ?
     2813                           or buf_firm.fax = ""
     2814                           or buf_firm.fax = ?
     2815                           then ""
     2816                           else ", " )
     2817                       + buf_firm.fax
     2818                       + ( if buf_firm.phone = ""
     2819                           or buf_firm.phone = ?
     2820                           or buf_firm.fax = ""
     2821                           or buf_firm.fax = ?
     2822                           then ""
     2823                           else "(f)" )
     2824               , input 0
     2825           ).
     2826           run wp-XMLTagPut in this-procedure ( input 3, input "inn"  , input buf_firm.inn  , input 0 ).
     2827           run wp-XMLTagPut in this-procedure ( input 3, input "kpp"           , input buf_firm.kpp        , input 0 ).
     2828           run wp-XMLTagPut in this-procedure ( input 3, input "okonh", input buf_firm.okonh, input 0 ).
     2829           run wp-XMLTagPut in this-procedure ( input 3, input "okpo" , input buf_firm.okpo , input 0 ).
     2830           run wp-XMLTagPut in this-procedure ( input 3, input "director"      , input buf_firm.director   , input 0 ).
     2831           run wp-XMLTagPut in this-procedure ( input 3, input "contactPsn"    , input buf_firm.contact-psn, input 0 ).
     2832           run wp-XMLTagPut in this-procedure ( input 3, input "email"         , input buf_firm.e-mail     , input 0 ).
     2833           for each buf_sysconf no-lock
     2834           on error undo, return error
     2835           :
     2836               for each buf_fin-schet no-lock
     2837                  where buf_fin-schet.host-code = buf_sysconf.host-code
     2838                    and buf_fin-schet.cli-type  = buf_clients.obj-type
     2839                    and buf_fin-schet.cli-code  = buf_clients.obj-code
     2840               on error undo, return error
     2841               :
     2842                   if buf_fin-schet.status_  <> 'удал':U
     2843                   then do:
     2844                       run wp-XMLTagOpen in this-procedure ( input 3, input "BankInfo", input "" ).
     2845                       run wp-XMLTagPut in this-procedure ( input 4, input "hostFirmCode"  , input string( buf_fin-schet.host-code ) , input 0 ).
     2846                       run wp-XMLTagPut in this-procedure ( input 4, input "accountNumber" , input string( buf_fin-schet.r-schet )   , input 0 ).
     2847                       run wp-XMLTagPut in this-procedure ( input 4, input "bAccountNumber", input string( buf_fin-schet.c-schet )   , input 0 ).
     2848                       run wp-XMLTagPut in this-procedure ( input 4, input "currCode"      , input string( buf_fin-schet.curr-code ) , input 0 ).
     2849                       find first buf_fin-bank no-lock
     2850                           where buf_fin-bank.host-code = p-host-code
     2851                           and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     2852                       no-error.
     2853                       if available buf_fin-bank
     2854                       then do:
     2855                           run wp-XMLTagPut in this-procedure ( input 4, input "bankCode"      , input string( buf_fin-schet.code-bank ) , input 0 ).
     2856                           run wp-XMLTagPut in this-procedure ( input 4, input "bankName"      , input string( buf_fin-bank.bank-name )  , input 0 ).
     2857                           run wp-XMLTagPut in this-procedure ( input 4, input "Address1"      , input string( entry(1, buf_fin-bank.addres, chr(4)))    , input 0 ).
     2858                           run wp-XMLTagPut in this-procedure ( input 4, input "Address2"      , input string( buf_fin-bank.addres1 )    , input 0 ).
     2859                       end.
     2860                       run wp-XMLTagClose in this-procedure ( input 3, input "BankInfo" ).
     2861                   end.
     2862               end.
     2863           end.
     2864       end.
     2865   end.
     2866   if buf_clients.obj-type = 'чел':U
     2867   then do:
     2868       find first buf_person no-lock
     2869            where buf_person.psn-code = buf_clients.obj-code
     2870       no-error.
     2871       if available buf_person
     2872       then do:
     2873           run wp-XMLTagPut in this-procedure ( input 3, input "inn", input buf_person.inn, input 0 ).
     2874           run wp-XMLTagPut in this-procedure ( input 3, input "kpp"   , input buf_person.kpp      , input 0 ).
     2875           run wp-XMLTagPut in this-procedure ( input 3, input "email" , input buf_person.e-mail   , input 0 ).
     2876       end.
     2877   end.
     2878           for each buf_place-io no-lock
     2879              where buf_place-io.obj-type  = buf_clients.obj-type
     2880                and buf_place-io.obj-code  = buf_clients.obj-code
     2881           on error undo, return error
     2882           :
     2883             run wp-XMLTagOpen in this-procedure ( input 3, input "Place-io-Info", input "" ).
     2884             run wp-XMLTagPut in this-procedure ( input 4, input "place-io-code"  , input string( buf_place-io.place-io-code ) , input 0 ).
     2885             run wp-XMLTagPut in this-procedure ( input 4, input "place-io-name"  , input string( buf_place-io.place-io-name ) , input 0 ).
     2886             run wp-XMLTagPut in this-procedure ( input 4, input "place-io-type"  , input string( buf_place-io.place-io-type ) , input 0 ).
     2887             run wp-XMLTagPut in this-procedure ( input 4, input "PS"  , input string( buf_place-io.PS ) , input 0 ).
     2888             run wp-XMLTagPut in this-procedure ( input 4, input "status_"  , input string( buf_place-io.status_ ) , input 0 ).
     2889             run wp-XMLTagClose in this-procedure ( input 3, input "Place-io-Info" ).
     2890           end.
     2891           for each buf_point-io no-lock
     2892              where buf_point-io.cli-type  = buf_clients.obj-type
     2893                and buf_point-io.cli-code  = buf_clients.obj-code
     2894           on error undo, return error
     2895           :
     2896             run wp-XMLTagOpen in this-procedure ( input 3, input "point-io-Info", input "" ).
     2897             run wp-XMLTagPut in this-procedure ( input 4, input "point-code"  , input string( buf_point-io.point-code ) , input 0 ).
     2898             run wp-XMLTagPut in this-procedure ( input 4, input "db-num"  , input string( buf_point-io.db-num ) , input 0 ).
     2899             run wp-XMLTagPut in this-procedure ( input 4, input "point-name"  , input string( buf_point-io.point-name ) , input 0 ).
     2900             run wp-XMLTagPut in this-procedure ( input 4, input "point-type"  , input string( buf_point-io.point-type ) , input 0 ).
     2901             run wp-XMLTagPut in this-procedure ( input 4, input "PS"  , input string( buf_point-io.PS ) , input 0 ).
     2902             run wp-XMLTagPut in this-procedure ( input 4, input "status_"  , input string( buf_point-io.status_ ) , input 0 ).
     2903             run wp-XMLTagPut in this-procedure ( input 4, input "is-default"  , input string( buf_point-io.is-default ) , input 0 ).
     2904             run wp-XMLTagPut in this-procedure ( input 4, input "address"  , input string( buf_point-io.address ) , input 0 ).
     2905             run wp-XMLTagPut in this-procedure ( input 4, input "dist"  , input string( buf_point-io.dist ) , input 0 ).
     2906             run wp-XMLTagClose in this-procedure ( input 3, input "point-io-Info" ).
     2907           end.
     2908   run wp-XMLTagClose in this-procedure ( input 2, input "firm" ).
     2909   end.
     2910   end procedure.
     2911   procedure write-header:
     2912   do
     2913   on error undo, return error
     2914   :
     2915   put stream stmXMLOut unformatted
     2916       "<?xml version='1.0' encoding='windows-1251'?>"
     2917   .
     2918   put stream stmXMLOut unformatted
     2919       chr(10) + '<IBS_Trade_House>'
     2920   .
     2921   run wp-XMLTagOpen in this-procedure  ( input 1, input "header"      , input "").
     2922   run wp-XMLTagOpen in this-procedure  ( input 2, input "delivery"    , input "").
     2923   run wp-XMLTagOpen in this-procedure  ( input 3, input "to"          , input "").
     2924   run wp-XMLTagClose in this-procedure ( input 3, input "to" ).
     2925   run wp-XMLTagOpen in this-procedure  ( input 3, input "from"        , input "").
     2926   run wp-XMLTagClose in this-procedure ( input 3, input "from" ).
     2927   run wp-XMLTagClose in this-procedure ( input 2, input "delivery" ).
     2928   run wp-XMLTagOpen in this-procedure  ( input 2, input "manifest"    , input "").
     2929   run wp-XMLTagOpen in this-procedure  ( input 3, input "document"    , input "").
     2930   run wp-XMLTagPut in this-procedure   ( input 4, input "name"        , input "firm", input 0).
     2931   run wp-XMLTagPut in this-procedure   ( input 4, input "description" , input ""              , input 0).
     2932   run wp-XMLTagClose in this-procedure ( input 3, input "document" ).
     2933   run wp-XMLTagClose in this-procedure ( input 2, input "manifest" ).
     2934   run wp-XMLTagClose in this-procedure ( input 1, input "header" ).
     2935   run wp-XMLTagOpen in this-procedure  ( input 1, input "body"        , input "").
     2936   end.
     2937   end procedure.
