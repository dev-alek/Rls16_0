      652                       then do:
      653                           assign
      654                               p-out-string = p-out-string + " ":U
      655                           .
      656                       end.
      657                       when chr(13)
      658                       then do:
      659                           assign
      660                               p-out-string = p-out-string + " ":U
      661                           .
      662                       end.
      663                       otherwise do:
      664                           assign
      665                               p-out-string = p-out-string + v-current-char
      666                           .
      667                       end.
      668                   end case.
      669               end.
      670           end.
      671       end case.
      672   end.
      673   end .
      674   procedure xmlchar-decode :
      675   define input parameter p-in-string      as character        no-undo.
      676   define output parameter p-out-string    as character        no-undo.
      677       define variable v-position      as integer      no-undo.
      678       define variable v-last-position as integer      no-undo.
      679       define variable v-temp-integer  as integer      no-undo.
      680       define variable v-current-char  as character    no-undo.
      681       define variable v-next-char     as character    no-undo.
      682       define variable v-success       as logical      no-undo.
      683   do
      684   on error undo, return error
      685   :
      686       assign
      687           p-out-string = "":U
      688           v-position   = 0
      689       .
      690       replace-cycle:
      691       do while yes
      692       on error undo, return error
      693       :
      694           assign
      695               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      696           .
      697           if v-last-position <= v-position
      698           then do:
      699               if v-position = 0
      700               then do:
      701                   assign
      702                       p-out-string = p-in-string
      703                   .
      704               end.
      705               else do:
      706                   assign
      707                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      708                   .
      709               end.
      710               leave replace-cycle.
      711           end.
      712           else do:
      713               assign
      714                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      715                   v-position      = v-last-position
      716                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      717               .
      718               if v-current-char = "#":U
      719               then do:
      720                   assign
      721                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      722                   .
      723                   if v-last-position > 0
      724                   then do:
      725                       run xmlchar-read-integer in this-procedure
      726                        (
      727                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      728                           , output v-temp-integer
      729                           , output v-success
      730                       ).
      731                       if v-success = yes
      732                       and v-temp-integer >= 1
      733                       and v-temp-integer <= 255
      734                       then do:
      735                           assign
      736                               p-out-string = p-out-string + chr( v-temp-integer )
      737                               v-position   = v-last-position + 1
      738                           .
      739                       end.
      740                       else do:
      741                           assign
      742                               p-out-string = p-out-string + "&":U
      743                               v-position   = v-position   + 1
      744                           .
      745                       end.
      746                   end.
      747                   else do:
      748                       assign
      749                           p-out-string = p-out-string + "&":U
      750                           v-position   = v-position   + 1
      751                       .
      752                   end.
      753               end.
      754               else do:
      755                   case substring( p-in-string, v-position + 1, 3 )
      756                   :
      757                       when "lt;":U
      758                       then do:
      759                           assign
      760                               p-out-string = p-out-string + "<":U
      761                               v-position   = v-position   + 3
      762                           .
      763                       end.
      764                       when "gt;":U
      765                       then do:
      766                           assign
      767                               p-out-string = p-out-string + ">":U
      768                               v-position   = v-position   + 3
      769                           .
      770                       end.
      771                       otherwise do:
      772                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      773                           then do:
      774                               assign
      775                                   p-out-string = p-out-string + "&":U
      776                                   v-position   = v-position   + 4
      777                               .
      778                           end.
      779                           else do:
      780                               case substring( p-in-string, v-position + 1, 5 )
      781                               :
      782                                   when "quot;":U
      783                                   then do:
      784                                       assign
      785                                           p-out-string = p-out-string + '"':U
      786                                           v-position   = v-position   + 5
      787                                       .
      788                                   end.
      789                                   when "apos;":U
      790                                   then do:
      791                                       assign
      792                                           p-out-string = p-out-string + "'":U
      793                                           v-position   = v-position   + 5
      794                                       .
      795                                   end.
      796                                   otherwise do:
      797                                       assign
      798                                           p-out-string = p-out-string + "&":U
      799                                       .
      800                                   end.
      801                               end case.
      802                           end.
      803                       end.
      804                   end case.
      805               end.
      806           end.
      807       end.
      808   end.
      809   end .
      810   procedure xmlchar-read-integer :
      811   define input parameter p-input-string      as character        no-undo.
      812   define output parameter p-output-integer   as integer          no-undo.
      813   define output parameter p-success       as logical          no-undo.
      814   do
      815   on error undo, return error
      816   :
      817       assign
      818           p-output-integer = integer( p-input-string )
      819       no-error.
      820       if error-status :error
      821       then do:
      822           assign
      823               p-success           = no
      824               p-output-integer    = 0
      825           .
      826       end.
      827       else do:
      828           assign
      829               p-success           = yes
      830           .
      831       end.
      832   end.
      833   end.
      834   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      835   procedure strtdate :
      836     define input  parameter p-str         as character no-undo .
      837     define output parameter p-value       as date      no-undo .
      838     define output parameter p-data-valid  as logical   no-undo .
      839     define output parameter p-message     as character no-undo .
      840   do
      841   on error undo, return error return-value
      842   :
      843     define variable v-value       as date      no-undo .
      844     define variable v-i           as integer   no-undo .
      845     define variable v-num         as integer   no-undo .
      846     define variable v-delim       as character no-undo .
      847     define variable v-delim-list  as character no-undo .
      848     define variable v-day         as integer   no-undo .
      849     define variable v-month       as integer   no-undo .
      850     define variable v-year        as integer   no-undo .
      851     define variable v-day-str     as character no-undo .
      852     define variable v-month-str   as character no-undo .
      853     define variable v-year-str    as character no-undo .
      854     assign
      855       p-value       = ?
      856       p-data-valid  = false
      857     .
      858     if p-str = ?
      859     then do:
      860       assign
      861         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      862       .
      863       return .
      864     end.
      865     if p-str = ""
      866     then do:
      867       assign
      868         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      869       .
      870       return .
      871     end.
      872     if length(p-str)  > 10
      873     then do:
      874       assign
      875         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      876       .
      877       return .
      878     end.
      879     assign
      880       v-delim-list = '/,-,.':U
      881     .
      882     _delim:
      883     do v-i = 1 to num-entries( v-delim-list )
      884     :
      885       assign
      886         v-delim = entry( v-i , v-delim-list )
      887         v-num   = num-entries( p-str , v-delim )
      888       .
      889       if v-num <> 3
      890       then do:
      891         assign
      892           v-delim = ''
      893         .
      894       end.
      895       else do:
      896         leave _delim.
      897       end.
      898     end.
      899     if v-delim = ''
      900     then do:
      901       assign
      902         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      903       .
      904       return .
      905     end.
      906     assign
      907       v-day-str   = entry( 1, p-str , v-delim)
      908       v-month-str = entry( 2, p-str , v-delim)
      909       v-year-str  = entry( 3, p-str , v-delim)
      910     .
      911     if  length(v-day-str) > 2   or
      912         length(v-day-str) < 1   or
      913         length(v-month-str) > 2 or
      914         length(v-month-str) < 1 or
      915         (
      916           length(v-year-str) <> 2 and
      917           length(v-year-str) <> 4
      918         )
      919     then do:
      920       assign
      921         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      922       .
      923       return .
      924     end.
      925     if length( v-year-str ) = 2
      926     then do:
      927       assign
      928         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      929       .
      930     end.
      931     assign
      932       v-day   = integer( v-day-str )
      933       v-month = integer( v-month-str)
      934       v-year  = integer( v-year-str)
      935     no-error .
      936     if error-status :error
      937     then do:
      938       assign
      939         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      940       .
      941       return .
      942     end.
      943     if v-day < 1  or
      944        v-day > 31 or
      945        v-month < 1 or
      946        v-month > 12 or
      947        v-year < 0   or
      948        v-year > 5000
      949     then do:
      950       assign
      951         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      952       .
      953       return .
      954     end.
      955     assign
      956       v-value = date( v-month, v-day, v-year )
      957     no-error .
      958     if error-status :error
      959     then do:
      960       assign
      961         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      962       .
      963       return .
      964     end.
      965     assign
      966       p-value       = v-value
      967       p-data-valid  = true
      968     .
      969   end.
      970   end procedure.
      971   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      972   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
      973   define variable v-bge-xml-bgedict       as logical  init no  no-undo.
      974   define variable v-bge-xml-bgeflold      as character         no-undo.
      975   define variable v-bge-xml-bgefmt        as character         no-undo.
      976   define variable v-bge-xml-shift-mode    as logical           no-undo.
      977   define variable v-bge-xml-bgeflnm-doc   as character         no-undo.
      978   define variable v-bge-xml-bgeflnm-day   as character         no-undo.
      979   define variable v-bge-xml-log-file-name as character    no-undo.
      980   define variable v-bge-xml-dbf-file-name as character    no-undo.
      981   define variable v-bge-xml-db-num-str    as character    no-undo .
      982   define variable v-bge-xml-static-log-file-name as character    no-undo.
      983   define temp-table temp_ext-doc-type no-undo
