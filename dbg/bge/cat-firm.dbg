     1020       index pi is primary unique
     1021           doc-num
     1022   .
     1023   define temp-table temp_fin-doc-code no-undo
     1024       field host-code as integer
     1025       field fin-doc-code as integer
     1026       index pi is primary unique
     1027           host-code
     1028           fin-doc-code
     1029   .
     1030   define temp-table temp_del-fin-doc-code no-undo
     1031       field host-code as integer
     1032       field fin-doc-code as integer
     1033       field corr-user-db-num as integer
     1034       field chip-num as integer
