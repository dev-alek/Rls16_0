     1043       field fin-doc-code as character
     1044       index pi is primary unique
     1045           host-code
     1046           fin-doc-code
     1047   .
     1048   define temp-table temp_del-fin-ob no-undo
     1049       field host-code as integer
     1050       field fin-doc-code as character
     1051       field corr-user-db-num as integer
     1052       field chip-num as integer
