      522     define variable v-login               as character no-undo .
      523     define variable v-login_is            as character no-undo .
      524     define variable v-password            as character no-undo .
      525     define variable v-initiator           as character no-undo .
      526     define variable v-type-connect        as integer   no-undo .
      527     define variable v-server              as integer   no-undo .
      528     define variable v-proxy-login         as character no-undo .
      529     define variable v-proxy-pswd          as character no-undo .
      530     define variable v-proxy-addres        as character no-undo .
      531     define variable v-appId           as character no-undo .
      532     define variable v-status_         as character no-undo .
      533     define variable v-Msg             as character no-undo .
      534     define buffer buf_devisPC           for ub.devisPC .
      535     define buffer buf_devisPC-attr      for ub.devisPC-attr .
      536     define variable objThObj      as clisub.
      537     define variable objKeyRec     as keyrec.
      538     define variable v-part-rowid as rowid no-undo .
      539     define variable v-tbl-name as character no-undo .
      540     define variable ii as integer no-undo.
      541     if transaction then do:
      542       message
      543         substitute( "&1. Вызов данной процедуры невозможен при наличии транзакции", vss-workfile )
      544         view-as alert-box error .
      545       return error .
      546     end.
      547     if valid-handle( session :first-procedure ) then do:
      548       assign
      549         v-main-proc-name = "gbl/mainproc.p":U
      550         v-proc-handle    = session :first-procedure
      551         v-count-main-prc = 0
      552         v-pers-proc-name = "":U
      553       .
      554       do while valid-handle( v-proc-handle )
      555       :
      556         if v-proc-handle :file-name = v-main-proc-name then do:
      557           assign
      558             v-count-main-prc = v-count-main-prc + 1
      559           .
      560         end.
      561         else do:
      562           assign
      563             v-pers-proc-name = v-pers-proc-name + chr(44) + v-proc-handle :file-name
      564           .
      565         end.
      566         assign
      567           v-proc-handle = v-proc-handle:next-sibling no-error
      568         .
      569       end.
      570       if v-count-main-prc > 1
      571         or v-pers-proc-name <> "":U
      572       then do:
      573         message
      574           substitute( "&1. Вызов данной процедуры невозможен при наличии определений persistent prosedures &2"
      575                       + "Список недопустимых процедур: &3&2"
      576                       + "Исключение - единственная процедура &4&2"
      577                       + "Определений данной процедуры &5&2"
      578                       , vss-workfile
      579                       , chr(10)
      580                       , v-pers-proc-name
      581                       , v-main-proc-name
      582                       , v-count-main-prc
      583                      )
      584           view-as alert-box error .
      585         return error .
      586       end.
      587     end.
      588     assign
      589       g#auto                = true
      590       v-num-entries-db-list = num-entries( p-list-db )
      591     .
      592     run gbl/set-gbl.p
      593       (input true
      594       ,input p-user-login
      595       ,input p-user-password
      596       ) no-error.
      597     if error-status :error
      598     then do:
      599       run write-to-log( substitute("&1. Ошибка при инициализации переменных g#... &2&3&4"
      600                                     ,vss-workfile
      601                                     ,error-status:get-message(error-status:num-messages)
      602                                     ,chr(10)
      603                                     ,return-value
      604                                   )
      605                       ) .
      606       return error.
      607     end.
      608     assign
      609       g#auto = true
      610     .
      611     objThObj = new clisub ().
      612     run write-to-log( "Отправка запросов на кассы " ) .
      613     do v-ind = 1 to v-num-entries-db-list
      614     on error undo, return error
      615     :
      616       assign
      617         v-db-num = integer( entry( v-ind, p-list-db ) )
      618       .
      619       run write-to-log( "Работа с БД " + string(v-db-num) ) .
      620       clients_ :
      621       for each clients no-lock where clients.obj-type = 'маг':U
      622                                  and clients.db-num = v-db-num
      623                                  and clients.stts = 0 :
      624         run write-to-log( "Отправка запросов по объекту " + clients.obj-type + string(clients.obj-code) ) .
      625       end .
      626       run write-to-log( "Закончена работа с БД " + string(v-db-num) ) .
      627     end.
      628     delete object objThObj no-error .
      629   end.
