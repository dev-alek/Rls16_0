      580   procedure xmlchar-decode :
      581   define input parameter p-in-string      as character        no-undo.
      582   define output parameter p-out-string    as character        no-undo.
      583       define variable v-position      as integer      no-undo.
      584       define variable v-last-position as integer      no-undo.
      585       define variable v-temp-integer  as integer      no-undo.
      586       define variable v-current-char  as character    no-undo.
      587       define variable v-next-char     as character    no-undo.
      588       define variable v-success       as logical      no-undo.
      589   do
      590   on error undo, return error
      591   :
      592       assign
      593           p-out-string = "":U
      594           v-position   = 0
      595       .
      596       replace-cycle:
      597       do while yes
      598       on error undo, return error
      599       :
      600           assign
      601               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      602           .
      603           if v-last-position <= v-position
      604           then do:
      605               if v-position = 0
      606               then do:
      607                   assign
      608                       p-out-string = p-in-string
      609                   .
      610               end.
      611               else do:
      612                   assign
      613                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      614                   .
      615               end.
      616               leave replace-cycle.
      617           end.
      618           else do:
      619               assign
      620                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      621                   v-position      = v-last-position
      622                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      623               .
      624               if v-current-char = "#":U
      625               then do:
      626                   assign
      627                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      628                   .
      629                   if v-last-position > 0
      630                   then do:
      631                       run xmlchar-read-integer in this-procedure
      632                        (
      633                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      634                           , output v-temp-integer
      635                           , output v-success
      636                       ).
      637                       if v-success = yes
      638                       and v-temp-integer >= 1
      639                       and v-temp-integer <= 255
      640                       then do:
      641                           assign
      642                               p-out-string = p-out-string + chr( v-temp-integer )
      643                               v-position   = v-last-position + 1
      644                           .
      645                       end.
      646                       else do:
      647                           assign
      648                               p-out-string = p-out-string + "&":U
      649                               v-position   = v-position   + 1
      650                           .
      651                       end.
      652                   end.
      653                   else do:
      654                       assign
      655                           p-out-string = p-out-string + "&":U
      656                           v-position   = v-position   + 1
      657                       .
      658                   end.
      659               end.
      660               else do:
      661                   case substring( p-in-string, v-position + 1, 3 )
      662                   :
      663                       when "lt;":U
      664                       then do:
      665                           assign
      666                               p-out-string = p-out-string + "<":U
      667                               v-position   = v-position   + 3
      668                           .
      669                       end.
      670                       when "gt;":U
      671                       then do:
      672                           assign
      673                               p-out-string = p-out-string + ">":U
      674                               v-position   = v-position   + 3
      675                           .
      676                       end.
      677                       otherwise do:
      678                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      679                           then do:
      680                               assign
      681                                   p-out-string = p-out-string + "&":U
      682                                   v-position   = v-position   + 4
      683                               .
      684                           end.
      685                           else do:
      686                               case substring( p-in-string, v-position + 1, 5 )
      687                               :
      688                                   when "quot;":U
      689                                   then do:
      690                                       assign
      691                                           p-out-string = p-out-string + '"':U
      692                                           v-position   = v-position   + 5
      693                                       .
      694                                   end.
      695                                   when "apos;":U
      696                                   then do:
      697                                       assign
      698                                           p-out-string = p-out-string + "'":U
      699                                           v-position   = v-position   + 5
      700                                       .
      701                                   end.
      702                                   otherwise do:
      703                                       assign
      704                                           p-out-string = p-out-string + "&":U
      705                                       .
      706                                   end.
      707                               end case.
      708                           end.
      709                       end.
      710                   end case.
      711               end.
      712           end.
      713       end.
      714   end.
      715   end .
      716   procedure xmlchar-read-integer :
      717   define input parameter p-input-string      as character        no-undo.
      718   define output parameter p-output-integer   as integer          no-undo.
      719   define output parameter p-success       as logical          no-undo.
      720   do
      721   on error undo, return error
      722   :
      723       assign
      724           p-output-integer = integer( p-input-string )
      725       no-error.
      726       if error-status :error
      727       then do:
      728           assign
      729               p-success           = no
      730               p-output-integer    = 0
      731           .
      732       end.
      733       else do:
      734           assign
      735               p-success           = yes
      736           .
      737       end.
      738   end.
      739   end.
      740   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      741   procedure strtdate :
      742     define input  parameter p-str         as character no-undo .
      743     define output parameter p-value       as date      no-undo .
      744     define output parameter p-data-valid  as logical   no-undo .
      745     define output parameter p-message     as character no-undo .
      746   do
      747   on error undo, return error return-value
      748   :
      749     define variable v-value       as date      no-undo .
      750     define variable v-i           as integer   no-undo .
      751     define variable v-num         as integer   no-undo .
      752     define variable v-delim       as character no-undo .
      753     define variable v-delim-list  as character no-undo .
      754     define variable v-day         as integer   no-undo .
      755     define variable v-month       as integer   no-undo .
      756     define variable v-year        as integer   no-undo .
      757     define variable v-day-str     as character no-undo .
      758     define variable v-month-str   as character no-undo .
      759     define variable v-year-str    as character no-undo .
      760     assign
      761       p-value       = ?
      762       p-data-valid  = false
      763     .
      764     if p-str = ?
      765     then do:
      766       assign
      767         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      768       .
      769       return .
      770     end.
      771     if p-str = ""
      772     then do:
      773       assign
      774         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      775       .
      776       return .
      777     end.
      778     if length(p-str)  > 10
      779     then do:
      780       assign
      781         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      782       .
      783       return .
      784     end.
      785     assign
      786       v-delim-list = '/,-,.':U
      787     .
      788     _delim:
      789     do v-i = 1 to num-entries( v-delim-list )
      790     :
      791       assign
      792         v-delim = entry( v-i , v-delim-list )
      793         v-num   = num-entries( p-str , v-delim )
      794       .
      795       if v-num <> 3
      796       then do:
      797         assign
      798           v-delim = ''
      799         .
      800       end.
      801       else do:
      802         leave _delim.
      803       end.
      804     end.
      805     if v-delim = ''
      806     then do:
      807       assign
      808         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      809       .
      810       return .
      811     end.
      812     assign
      813       v-day-str   = entry( 1, p-str , v-delim)
      814       v-month-str = entry( 2, p-str , v-delim)
      815       v-year-str  = entry( 3, p-str , v-delim)
      816     .
      817     if  length(v-day-str) > 2   or
      818         length(v-day-str) < 1   or
      819         length(v-month-str) > 2 or
      820         length(v-month-str) < 1 or
      821         (
      822           length(v-year-str) <> 2 and
      823           length(v-year-str) <> 4
      824         )
      825     then do:
      826       assign
      827         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      828       .
      829       return .
      830     end.
      831     if length( v-year-str ) = 2
      832     then do:
      833       assign
      834         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      835       .
      836     end.
      837     assign
      838       v-day   = integer( v-day-str )
      839       v-month = integer( v-month-str)
      840       v-year  = integer( v-year-str)
      841     no-error .
      842     if error-status :error
      843     then do:
      844       assign
      845         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      846       .
      847       return .
      848     end.
      849     if v-day < 1  or
      850        v-day > 31 or
      851        v-month < 1 or
      852        v-month > 12 or
      853        v-year < 0   or
      854        v-year > 5000
      855     then do:
      856       assign
      857         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      858       .
      859       return .
      860     end.
      861     assign
      862       v-value = date( v-month, v-day, v-year )
      863     no-error .
      864     if error-status :error
      865     then do:
      866       assign
      867         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      868       .
      869       return .
      870     end.
      871     assign
      872       p-value       = v-value
      873       p-data-valid  = true
      874     .
      875   end.
      876   end procedure.
      877   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      878   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
