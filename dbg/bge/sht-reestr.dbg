      977   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
      978                                             INPUT iFlagEmpty AS INTEGER).
      979       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
      980       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
      981           DO:
      982               IF iFlagEmpty = 0                           THEN RETURN "".
      983               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
      984               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
      985               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
      986               ELSE RETURN "".
      987           END.
      988       ELSE DO:
      989           run xmlchar-encode in this-procedure (
      990                 input sToPlace
      991               , output sToPlace
      992           ).
      993           ASSIGN
      994               sToPlace = sParName + '="' + sToPlace + '"'
      995           .
      996           RETURN sToPlace.
      997       END.
      998   END FUNCTION.
      999   function bge-xml-date returns character
     1000   ( input p-date as date )
     1001   :
     1002     define variable v-date-str as character no-undo .
     1003     run bge-xml-date-to-str in this-procedure ( input   p-date
     1004                                               , output  v-date-str
     1005                                               ) .
     1006     return v-date-str.
     1007   end function.
     1008   function bge-xml-str-date returns character
     1009   ( input p-date-str as character )
     1010   :
     1011     define variable v-date-str as character no-undo .
     1012     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1013                                                   , output  v-date-str
     1014                                                   ) .
     1015     return v-date-str.
     1016   end function.
     1017   function bge-xml-normalize-dec returns decimal
     1018   ( input p-val as decimal )
     1019   :
     1020     return (if p-val = ? then 0 else p-val) .
     1021   end function.
     1022   PROCEDURE wp-XMLTagOpen:
     1023   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1024   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1025   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1026       define variable v-out-string    as character    no-undo.
     1027   do
     1028   on error undo, return error
     1029   :
     1030       if v-bge-xml-bgefmt = "dbf":U
     1031       then do:
     1032       end.
     1033       else do:
     1034           assign
     1035               v-out-string = substitute( "&1&2<&3&4>"
     1036                                       , chr(10)
     1037                                       , fill( " ":U, 4 * iTagLevel)
     1038                                       , sTagName
     1039                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1040                               )
     1041           .
     1042           put stream stmXMLOut unformatted
     1043               v-out-string
     1044           .
     1045       end.
     1046   end.
     1047   END PROCEDURE.
     1048   PROCEDURE wp-XMLTagPut:
     1049     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1050     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1051     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1052     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1053       define variable v-out-string    as character    no-undo.
     1054   do
     1055   on error undo, return error
     1056   :
     1057       if v-bge-xml-bgefmt = "dbf":U
     1058       then do:
     1059           if v-bge-xml-dbf-file-name <> "":U
     1060           then do:
     1061               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1062               export stream stmXMLOut
     1063                   sTagName
     1064                   sParValue
     1065               .
     1066               output stream stmXMLOut close.
     1067           end.
     1068       end.
     1069       else do:
     1070           IF  iFlagEmpty = 1
     1071           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1072           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1073           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1074           THEN DO:
     1075               run xmlchar-encode in this-procedure (
     1076                   input sParValue
     1077                   , output sParValue
     1078               ).
     1079               assign
     1080                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1081                                               , chr(10)
     1082                                               , FILL(" ", 4 * iTagLevel)
     1083                                               , sTagName
     1084                                               , sParValue
     1085                               )
     1086               .
     1087               PUT STREAM stmXMLOut UNFORMATTED
     1088                   v-out-string
     1089               .
     1090           END.
     1091       end.
     1092   end.
     1093   END PROCEDURE.
     1094   PROCEDURE wp-XMLTagClose:
     1095   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1096   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1097       define variable v-out-string    as character    no-undo.
     1098   do
     1099   on error undo, return error
     1100   :
     1101       if v-bge-xml-bgefmt = "dbf":U
     1102       then do:
     1103       end.
     1104       else do:
     1105           assign
     1106               v-out-string = substitute( "&1&2</&3>"
     1107                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1108                                   , fill( " ", 4 * iTagLevel )
     1109                                   , sTagName
     1110                           )
     1111           .
     1112           PUT STREAM stmXMLOut UNFORMATTED
     1113               v-out-string
     1114           .
     1115       end.
     1116   end.
     1117   END PROCEDURE.
     1118   PROCEDURE wp-XMLWriteLog:
     1119     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1120     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1121     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1122   define variable v-str              as character no-undo .
     1123   define variable v-error-append     as logical   no-undo .
     1124   define variable v-error-append-msg as character no-undo .
     1125   assign
     1126     v-str = chr(10)
     1127             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1128             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1129     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1130     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1131     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1132   .
     1133   run bge/bge-log.p (input v-str) no-error .
     1134   if error-status:error then do:
     1135     assign
     1136       v-error-append     = yes
     1137       v-error-append-msg = return-value
     1138     .
     1139   end.
     1140   run gbl/fileapnd.p
     1141     ( input sFileName
     1142     , input v-str
     1143     , input 10
     1144     ) no-error .
     1145   if error-status:error then do:
     1146     assign
     1147       v-error-append     = yes
     1148       v-error-append-msg = substitute( "&1&2&3"
     1149                                       , v-error-append-msg
     1150                                       , chr(10)
     1151                                       , return-value
     1152                                       )
     1153     .
     1154   end.
     1155   if v-error-append
     1156   then do:
     1157     return error substitute( "&1" , v-error-append-msg ) .
     1158   end.
     1159   END PROCEDURE.
     1160   PROCEDURE wp-XMLWriteEDT:
     1161     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1162     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1163     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1164       if valid-handle ( hEDT )
     1165       then do:
     1166           hEDT :move-to-eof().
     1167           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1168                                           OR sToWrite = "&Line") THEN "" ELSE
     1169                                           cur-time-string-sec() + " ").
     1170           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1171                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1172                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1173           hEDT :insert-string(chr(10)).
     1174       end.
     1175       process events.
     1176       output to 'bgescn.txt' append.
     1177           put unformatted
     1178               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1179                                           OR sToWrite = "&Line") THEN "" ELSE
     1180                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1181               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1182                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1183                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1184           .
     1185       output close.
     1186   END PROCEDURE.
     1187   PROCEDURE wp-XMLShowCNT:
     1188     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1189       if valid-handle( hCNT )
     1190       then do:
     1191           ASSIGN hCNT :VISIBLE = TRUE.
     1192       end.
     1193   END PROCEDURE.
     1194   PROCEDURE wp-XMLHideCNT:
     1195     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1196       if valid-handle( hCNT )
     1197       then do:
     1198           ASSIGN hCNT :VISIBLE = FALSE.
     1199       end.
     1200   END PROCEDURE.
     1201   PROCEDURE wp-XMLWriteCNT:
     1202     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1203     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1204       if valid-handle( hCNT )
     1205       then do:
     1206           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1207       end.
     1208   END PROCEDURE.
     1209   procedure bge-xml-write-header:
     1210   do
     1211   on error undo, return error
     1212   :
     1213   define input parameter p-xml-file-name  as character        no-undo.
     1214   define input parameter p-doc-name       as character        no-undo.
     1215   define input parameter p-version        as character        no-undo.
     1216   define input parameter p-db-num         as integer          no-undo.
     1217   define input parameter p-date-from      as date             no-undo.
     1218   define input parameter p-shift-num-from as integer          no-undo.
     1219   define input parameter p-date-to        as date             no-undo.
     1220   define input parameter p-shift-num-to   as integer          no-undo.
     1221   define input parameter p-obj-list       as character        no-undo.
     1222   define input parameter p-doc-type-list  as character        no-undo.
     1223   define input parameter p-pay-code       as logical          no-undo.
     1224   define input parameter p-cst            as logical          no-undo.
     1225   define input parameter p-parts          as logical          no-undo.
     1226   define input parameter p-chk-pay-code   as logical          no-undo.
     1227   define input parameter p-pay-desk       as logical          no-undo.
     1228   define input parameter p-pay-desk-cards as logical          no-undo.
     1229   define input parameter p-deleted        as logical          no-undo.
     1230   define input parameter p-opened-docs    as logical          no-undo.
     1231   define variable v-out-string    as character    no-undo.
     1232   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1233   assign
     1234       v-out-string = substitute( "&1&2&3"
     1235                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1236                           , chr(10)
     1237                           , "<IBS_Trade_House>":U )
     1238   .
     1239   put stream stmXMLOut unformatted
     1240       v-out-string
     1241   .
     1242   run wp-XMLTagOpen(1, "header","").
     1243   if v-bge-xml-bgeflold = "oracle":u
     1244   then do:
     1245     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1246     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1247     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1248     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1249     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1250   end.
     1251   run wp-XMLTagOpen( 2, "manifest", "").
     1252   run wp-XMLTagOpen( 3, "document", "").
     1253   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1254   run wp-XMLTagput( 4, "description", "", 0).
     1255   run wp-XMLTagput( 4, "version", p-version, 0).
     1256   run wp-XMLTagclose( 3, "document" ).
     1257   run wp-XMLTagclose( 2, "manifest" ).
     1258   run wp-XMLTagclose( 1, "header" ).
     1259   run wp-XMLTagOpen(1, "options","").
     1260   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1261   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1262   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1263   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1264   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1265   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1266   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1267   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1268   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1269   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1270   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1271   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1272   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1273   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1274   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1275   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1276   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1277   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1278   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1279   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1280   run wp-XMLTagClose(1, "options").
     1281   run wp-XMLTagOpen( 1, "body", "" ).
     1282   output stream stmXMLOut close.
     1283   end.
     1284   end procedure.
     1285   procedure xml-bge-write-footer:
     1286   do
     1287   on error undo, return error return-value
     1288   :
     1289   define input parameter p-xml-file-name as character    no-undo.
     1290   define variable v-error-num     as integer           no-undo.
     1291   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1292   run wp-XMLTagClose( 1, "body" ).
     1293   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1294   output stream stmXMLOut close.
     1295   if v-bge-xml-bgeflold = "oracle":u
     1296   then do:
     1297     define variable v-tmp-file-name         as character no-undo .
     1298     define variable v-zip-file-name         as character no-undo .
     1299     define variable v-exch-file-name        as character no-undo .
     1300     define variable v-heap-file-name        as character no-undo .
     1301     define variable v-i                     as integer   no-undo .
     1302     define variable v-file-name             as character no-undo .
     1303     define variable v-arc                   as character no-undo .
     1304     define variable v-str                   as character no-undo .
     1305     define variable v-exch-tmp-file-name    as character no-undo .
     1306     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1307     define variable v-bge-xml-exch-dir      as character no-undo .
     1308     define variable v-bge-xml-heap-dir      as character no-undo .
     1309     define variable v-bge-xml-compress-heap as logical   no-undo .
     1310     define variable v-home-dir              as character no-undo .
     1311     define variable v-os-command            as character no-undo .
     1312     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1313     if v-home-dir = ?
     1314     then do:
     1315       undo, return error substitute( "&1&2&3"
     1316                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1317                                     , chr(10)
     1318                                     , "Обратитесь к администратору.":u
     1319                                     ).
     1320     end.
     1321     assign
     1322       v-home-dir = v-home-dir
     1323     .
     1324     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1325     if error-status :error
     1326     then do:
     1327       undo, return error substitute( "&1&2&3"
     1328                                     , "Неверно задан каталог экспорта.":u
     1329                                     , chr(10)
     1330                                     , "Обратитесь к администратору.":u
     1331                                     ).
     1332     end.
     1333     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1334     if v-bge-xml-exch-dir = ?
     1335     then do:
     1336       undo, return error substitute( "&1&2&3"
     1337                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1338                                     , chr(10)
     1339                                     , "Обратитесь к администратору.":u
     1340                                     ).
     1341     end.
     1342     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1343     if error-status :error
     1344     then do:
     1345       undo, return error substitute( "&1&2&3"
     1346                                     , "Неверно задан каталог экспорта (exch).":u
     1347                                     , chr(10)
     1348                                     , "Обратитесь к администратору.":u
     1349                                     ).
     1350     end.
     1351     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1352     if v-bge-xml-heap-dir = ?
     1353     then do:
     1354       undo, return error substitute( "&1&2&3"
     1355                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1356                                     , chr(10)
     1357                                     , "Обратитесь к администратору.":u
     1358                                     ).
     1359     end.
     1360     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1361     if error-status :error
     1362     then do:
     1363       undo, return error substitute( "&1&2&3"
     1364                                     , "Неверно задан каталог экспорта (heap).":u
     1365                                     , chr(10)
     1366                                     , "Обратитесь к администратору.":u
     1367                                     ).
     1368     end.
     1369     get-key-value section "BGE" key "heap-compress" value v-str.
     1370     assign
     1371       v-i = int(v-str)
     1372     no-error .
     1373     if v-i = ? or v-i = 0
     1374     then do:
     1375       assign
     1376         v-bge-xml-compress-heap = no
     1377       .
     1378     end.
     1379     else do:
     1380       assign
     1381         v-bge-xml-compress-heap = yes
     1382       .
     1383     end.
     1384     assign
     1385       v-arc = search( "exe/7za.exe":u )
     1386     .
     1387     if v-arc = ? or v-arc = ""
     1388     then do:
     1389       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1390     end.
     1391     assign
     1392       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1393       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1394       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1395       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1396       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1397       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1398       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1399     .
     1400     run gbl/del-file.p (input v-tmp-file-name) .
     1401     run gbl/del-file.p (input v-zip-file-name) .
     1402     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1403     if v-error-num > 0
     1404     then do:
     1405         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1406                                      , p-xml-file-name + "xm1":u
     1407                                      , v-tmp-file-name
     1408                                      , v-error-num
     1409                                      ).
     1410     end.
     1411     assign
     1412       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1413                                    , v-arc
     1414                                    , v-zip-file-name
     1415                                    , v-tmp-file-name
     1416                                    )
     1417     .
     1418     os-command silent value ( v-os-command ) .
     1419     run gbl/del-file.p (input v-heap-file-name) .
     1420     if v-bge-xml-compress-heap = no
     1421     then do:
     1422       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1423       if v-error-num > 0
     1424       then do:
     1425           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1426                                        , v-tmp-file-name
     1427                                        , v-heap-file-name
     1428                                        , v-error-num
     1429                                        ) .
     1430       end.
     1431     end.
     1432     else do:
     1433       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1434       if v-error-num > 0
     1435       then do:
     1436           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1437                                        , v-zip-file-name
     1438                                        , v-heap-file-name
     1439                                        , v-error-num
     1440                                        ) .
     1441       end.
     1442     end.
     1443     run gbl/del-file.p (input v-tmp-file-name) .
     1444     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1445     if error-status :error then do:
     1446       undo, return error substitute( "&1&2&3"
     1447                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1448                                     , chr(10)
     1449                                     , "Обратитесь к администратору."
     1450                                     ).
     1451     end.
     1452     run gbl/del-file.p (input v-exch-file-name) .
     1453     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1454     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1455     if v-error-num > 0
     1456     then do:
     1457       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1458                                     , v-zip-file-name
     1459                                     , v-exch-tmp-file-name
     1460                                     , v-error-num
     1461                                     ) .
     1462     end.
     1463     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1464     if v-error-num > 0
     1465     then do:
     1466       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1467                                     , v-exch-tmp-file-name
     1468                                     , v-exch-file-name
     1469                                     , v-error-num
     1470                                     ) .
     1471     end.
     1472     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1473   end.
     1474   else do:
     1475     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1476     if v-error-num > 0
     1477     then do:
     1478       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1479                                     , p-xml-file-name + "xm1"
     1480                                     , p-xml-file-name + "xml"
     1481                                     , v-error-num
     1482                                     ) .
     1483     end.
     1484   end.
     1485   if opsys = "unix"
     1486   then do:
     1487       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1488   end.
     1489   end.
     1490   end procedure.
     1491   procedure xml-bge-filename0:
     1492   define input parameter p-prefix   as character no-undo .
     1493   define input parameter p-name     as character no-undo .
     1494   define input parameter p-shared-process as logical no-undo .
     1495   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1496   define output parameter p-xml-file-name  as character no-undo .
     1497   // define output parameter p-fullfnamenoext as character no-undo .
     1498   define output parameter p-locked         as logical      no-undo.
     1499   define variable v-fullfnamenoext as character no-undo .
     1500   define variable v-fileext        as character no-undo .
     1501   define variable v-fullfname      as character no-undo .
     1502   define variable v-error-num      as integer   no-undo .
     1503   do
     1504   on error undo, return error
     1505   :
     1506     case v-bge-xml-bgeflold :
     1507       when "old" then do:
     1508         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1509         v-fileext       = ".xml":U .
     1510         v-fullfname     = v-fullfnamenoext + v-fileext .
     1511         p-xml-file-name = v-fullfname .
     1512         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1513         if v-error-num > 0 then do:
     1514           return error.
     1515         end.
     1516       end.
     1517       when "var" then do:
     1518         case p-prefix :
     1519           when "doc" then do:
     1520             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1521             v-fileext       = ".xml":U .
     1522             v-fullfname     = v-fullfnamenoext + v-fileext .
     1523             p-xml-file-name = v-fullfname .
     1524           end.
     1525           when "day" then do:
     1526             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1527             v-fileext       = ".xml":U .
     1528             v-fullfname     = v-fullfnamenoext + v-fileext .
     1529             p-xml-file-name = v-fullfname .
     1530           end.
     1531           otherwise do:
     1532             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1533             v-fileext       = ".xml":U .
     1534             v-fullfname     = v-fullfnamenoext + v-fileext .
     1535             p-xml-file-name = v-fullfname .
     1536           end.
     1537         end case.
     1538         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1539         if v-error-num > 0 then do:
     1540           return error.
     1541         end.
     1542       end.
     1543       when "new" then do:
     1544                   run bge/genfname.p (
     1545                       input p-home-dir
     1546                       , input p-prefix
     1547                       , input ""
     1548                       , input "xml"
     1549                       , input ""
     1550                       , output p-xml-file-name
     1551                   ).
     1552       end.
     1553       when "no-parameter" then do:
     1554         if p-shared-process then do:
     1555                       run bge/genfname.p (
     1556                           input p-home-dir
     1557                           , input "d"
     1558                           , input ""
     1559                           , input "xml"
     1560                           , input ""
     1561                           , output p-xml-file-name
     1562                       ).
     1563         end.
     1564         else do:
     1565           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1566           v-fileext       = ".xml":U .
     1567           v-fullfname     = v-fullfnamenoext + v-fileext .
     1568           p-xml-file-name = v-fullfname .
     1569           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1570           if v-error-num > 0 then do:
     1571             return error.
     1572           end.
     1573         end.
     1574       end.
     1575     end case.
     1576     assign
     1577       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1578       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1579     .
     1580   end .
     1581   end procedure .
     1582   procedure xml-bge-filename :
     1583   do
     1584   on error undo, return error
     1585   :
     1586   define input parameter p-prefix             as character    no-undo.
     1587   define input parameter p-name               as character    no-undo.
     1588   define input parameter p-shared-process     as logical      no-undo.
     1589   define output parameter p-xml-file-name     as character    no-undo.
     1590   define output parameter p-log-file-name     as character    no-undo.
     1591   define output parameter p-locked            as logical      no-undo.
     1592   define variable v-home-dir          as character no-undo .
     1593   define variable v-error-num         as integer   no-undo .
     1594   define variable v-bge-xml-heap-dir  as character no-undo .
     1595       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1596       if v-home-dir = ?
     1597       then do:
     1598           message
     1599             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1600             skip(1)
     1601             skip "Обратитесь к администратору."
     1602           view-as alert-box error.
     1603           undo, return error .
     1604       end.
     1605       if v-bge-xml-bgeflold <> "oracle"
     1606       then do:
     1607         assign
     1608             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1609         .
     1610       end.
     1611       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1612       if error-status :error
     1613       then do:
     1614           message
     1615             skip "Неверно задан каталог экспорта."
     1616             skip(1)
     1617             skip "Обратитесь к администратору."
     1618           view-as alert-box error.
     1619           undo, return error .
     1620       end.
     1621       if v-bge-xml-bgefmt = "dbf":U
     1622       then do:
     1623           assign
     1624               p-xml-file-name = v-home-dir
     1625               p-locked        = no
     1626           .
     1627       end.
     1628       else do:
     1629           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1630             output p-xml-file-name, output p-locked) .
     1631       end.
     1632       if v-bge-xml-bgeflold = "oracle"
     1633       then do:
     1634         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1635         if v-bge-xml-heap-dir = ?
     1636         then do:
     1637           undo, return error substitute( "&1&2&3"
     1638                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1639                                         , chr(10)
     1640                                         , "Обратитесь к администратору.":u
     1641                                         ).
     1642         end.
     1643         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1644         if error-status :error
     1645         then do:
     1646           undo, return error substitute( "&1&2&3"
     1647                                         , "Неверно задан каталог экспорта (heap).":u
     1648                                         , chr(10)
     1649                                         , "Обратитесь к администратору.":u
     1650                                         ).
     1651         end.
     1652         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1653           assign
     1654             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1655           .
     1656         end.
     1657         else do:
     1658           assign
     1659             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1660           .
     1661         end.
     1662       end.
     1663       else do:
     1664         assign
     1665             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1666         .
     1667       end.
     1668       assign
     1669          v-bge-xml-static-log-file-name = p-log-file-name
     1670       .
     1671   end.
     1672   end procedure.
     1673   procedure bge-xml-read-config :
     1674   do
     1675   on error undo, return error return-value
     1676   :
     1677   define input  parameter p-last-date as date      no-undo .
     1678   define input  parameter p-db-num    as integer   no-undo .
     1679       define variable v-bgeclall      as character     no-undo.
     1680       define variable v-bgedict       as character     no-undo.
     1681       define variable v-bgeshift      as character     no-undo.
     1682       define variable v-par-type      as character     no-undo.
     1683       define variable v-bgeflnm       as character     no-undo.
     1684       define variable v-bgecliiv      as character     no-undo .
     1685       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1686       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1687       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1688       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1689       define variable v-db-num-str    as character     no-undo .
     1690       define variable v-param-type      as character  no-undo .
     1691       define variable v-value-character as character  no-undo .
     1692       define variable v-value-date      as date       no-undo .
     1693       define variable v-value-decimal   as decimal    no-undo .
     1694       define variable v-value-integer   as integer    no-undo .
     1695       define variable v-value-logical   as logical    no-undo .
     1696       define variable v-tth             as handle      no-undo .
     1697       run adm/shattri.p ( input "get":U
     1698                         , input  '':u
     1699                         , input  0
     1700                         , input  'bge-export':U
     1701                         , input  'bgeclall':U
     1702                         , output v-bgecliiv
     1703                         , output v-value-date
     1704                         , output v-value-decimal
     1705                         , output v-value-integer
     1706                         , output v-value-logical
     1707                         , output v-param-type
     1708                         , input-output table-handle v-tth
     1709                         ) no-error .
     1710       if error-status :error
     1711       then do:
     1712         assign
     1713           v-bge-xml-bgecliiv = no
     1714         .
     1715       end.
     1716       else do:
     1717         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1718       end.
     1719       delete object v-tth.
     1720       assign
     1721           v-bge-xml-bgeclall = no
     1722           v-bge-xml-bgedict  = no
     1723       .
     1724       run adm/shattri.p ( input "get":U
     1725                         , input  '':u
     1726                         , input  0
     1727                         , input  'bge-export':U
     1728                         , input  'bgeclall':U
     1729                         , output v-value-character
     1730                         , output v-value-date
     1731                         , output v-value-decimal
     1732                         , output v-value-integer
     1733                         , output v-value-logical
     1734                         , output v-param-type
     1735                         , input-output table-handle v-tth
     1736                         ) no-error .
     1737       if error-status :error
     1738       then do:
     1739         assign
     1740           v-bge-xml-bgeclall = no
     1741         .
     1742       end.
     1743       else do:
     1744         assign
     1745           v-bge-xml-bgeclall = v-value-logical
     1746         .
     1747       end.
     1748       delete object v-tth.
     1749       run adm/shattri.p ( input "get":U
     1750                         , input  '':u
     1751                         , input  0
     1752                         , input  'bge-export':U
     1753                         , input  'bgedict':U
     1754                         , output v-value-character
     1755                         , output v-value-date
     1756                         , output v-value-decimal
     1757                         , output v-value-integer
     1758                         , output v-value-logical
     1759                         , output v-param-type
     1760                         , input-output table-handle v-tth
     1761                         ) no-error .
     1762       if error-status :error
     1763       then do:
     1764         assign
     1765           v-bge-xml-bgedict = no
     1766         .
     1767       end.
     1768       else do:
     1769         assign
     1770           v-bge-xml-bgedict = v-value-logical
     1771         .
     1772       end.
     1773       delete object v-tth.
     1774       run adm/shattri.p ( input "get":U
     1775                         , input  '':u
     1776                         , input  0
     1777                         , input  'bge-export':U
     1778                         , input  'bgefmt':U
     1779                         , output v-value-character
     1780                         , output v-value-date
     1781                         , output v-value-decimal
     1782                         , output v-value-integer
     1783                         , output v-value-logical
     1784                         , output v-param-type
     1785                         , input-output table-handle v-tth
     1786                         ) no-error .
     1787       if error-status :error
     1788       then do:
     1789         assign
     1790           v-bge-xml-bgefmt  = "xml":U
     1791         .
     1792       end.
     1793       else do:
     1794         assign
     1795           v-bge-xml-bgefmt  = v-value-character
     1796         .
     1797       end.
     1798       delete object v-tth.
     1799       run adm/shattri.p ( input "get":U
     1800                         , input  '':u
     1801                         , input  0
     1802                         , input  'bge-export':U
     1803                         , input  'bgeshift':U
     1804                         , output v-value-character
     1805                         , output v-value-date
     1806                         , output v-value-decimal
     1807                         , output v-value-integer
     1808                         , output v-value-logical
     1809                         , output v-param-type
     1810                         , input-output table-handle v-tth
     1811                         ) no-error .
     1812       if error-status :error
     1813       then do:
     1814         assign
     1815             v-bge-xml-shift-mode = no
     1816         .
     1817       end.
     1818       else do:
     1819         assign
     1820             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1821         .
     1822       end.
     1823       delete object v-tth.
     1824       run adm/shattri.p ( input "get":U
     1825                         , input  '':u
     1826                         , input  0
     1827                         , input  'bge-export':U
     1828                         , input  'bgeflold':U
     1829                         , output v-value-character
     1830                         , output v-value-date
     1831                         , output v-value-decimal
     1832                         , output v-value-integer
     1833                         , output v-value-logical
     1834                         , output v-param-type
     1835                         , input-output table-handle v-tth
     1836                         ) no-error .
     1837       if error-status :error
     1838       then do:
     1839         assign
     1840           v-bge-xml-bgeflold = "no-parameter":U
     1841         .
     1842       end.
     1843       else do:
     1844         assign
     1845           v-bge-xml-bgeflold  = v-value-character
     1846         .
     1847       end.
     1848       delete object v-tth.
     1849       assign
     1850         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1851         v-bge-xml-db-num-str  = v-db-num-str
     1852       .
     1853       if p-last-date <> ?
     1854       then do:
     1855           run adm/shattri.p ( input "get":U
     1856                             , input  '':u
     1857                             , input  0
     1858                             , input  'bge-export':U
     1859                             , input  'bgeflnm':U
     1860                             , output v-value-character
     1861                             , output v-value-date
     1862                             , output v-value-decimal
     1863                             , output v-value-integer
     1864                             , output v-value-logical
     1865                             , output v-param-type
     1866                             , input-output table-handle v-tth
     1867                             ) no-error .
     1868           if error-status :error
     1869           then do:
     1870             assign
     1871               v-bgeflnm = '':U
     1872             .
     1873           end.
     1874           else do:
     1875             assign
     1876               v-bgeflnm = v-value-character
     1877             .
     1878           end.
     1879           delete object v-tth.
     1880           if v-bge-xml-bgeflold = "var"
     1881           then do:
     1882               if v-bgeflnm = ?
     1883               or num-entries( v-bgeflnm ) < 2
     1884               then do:
     1885                   assign
     1886                       v-bge-xml-bgeflold = "new"
     1887                   .
     1888               end.
     1889               else do:
     1890                   assign
     1891                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1892                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1893                   .
     1894                   assign
     1895                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1896                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1897                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1898                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1899                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1900                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1901                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1902                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1903                   .
     1904               end.
     1905           end.
     1906       end.
     1907   end.
     1908   end procedure.
     1909   procedure bge-xml-get-ref-filename :
     1910   define input parameter p-in-file-name       as character        no-undo.
     1911   define output parameter p-home-dir          as character        no-undo.
     1912   define output parameter p-out-file-name     as character        no-undo.
     1913   define output parameter p-locked            as logical          no-undo.
     1914       define variable v-counter       as integer      no-undo.
     1915       define variable v-error-level   as integer      no-undo.
     1916   do
     1917   on error undo, return error
     1918   :
     1919       run bge/bge-ini.p (
     1920             input "bge"
     1921           , output p-home-dir
     1922       ).
     1923       if return-value <> "OK"
     1924       then do:
     1925           undo, return error.
     1926       end.
     1927       assign
     1928           p-home-dir = p-home-dir + "\dict":U
     1929       .
     1930       run bge/dir_cd.p (
     1931           input p-home-dir
     1932           , input "CA"
     1933       ).
     1934       if return-value = "ERROR"
     1935       then do:
     1936           undo, return error.
     1937       end.
     1938       assign
     1939           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     1940       .
     1941       assign
     1942           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     1943       .
     1944       wait-lock:
     1945       do v-counter = 1 TO 3
     1946       :
     1947           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     1948           if p-locked = no
     1949           then do:
     1950               leave wait-lock.
     1951           end.
     1952           else do:
     1953               readkey pause 1.
     1954           end.
     1955       END.
     1956       if p-locked = yes
     1957       then do:
     1958           undo, return error.
     1959       end.
     1960       run bge/os_copy.p (
     1961             input "D":U
     1962           , input p-out-file-name + "xml":U
     1963           , input "":U
     1964           , output v-error-level
     1965       ).
     1966       if v-error-level > 0
     1967       then do:
     1968           undo, return error.
     1969       end.
     1970   end.
     1971   end procedure.
     1972   procedure bge-xml-write-ref-header :
     1973   define input parameter p-bge-name as character        no-undo.
     1974   define input parameter p-file-name as character        no-undo.
     1975       define variable v-out-string    as character    no-undo.
     1976   do
     1977   on error undo, return error
     1978   :
     1979       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     1980       put stream stmXMLOut unformatted
     1981           "<?xml version='1.0' encoding='windows-1251'?>":U
     1982       .
     1983       assign
     1984           v-out-string = substitute( "&1&2"
     1985                               , chr(10)
     1986                               , "<IBS_Trade_House>":U )
     1987       .
     1988       put stream stmXMLOut unformatted
     1989           v-out-string
     1990       .
     1991       run wp-XMLTagOpen( 1, "header", "" ).
     1992       if v-bge-xml-bgeflold = "oracle":u
     1993       then do:
     1994         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1995         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1996         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1997         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1998         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1999       end.
     2000       else do:
     2001         run wp-XMLTagOpen( 2, "delivery", "" ).
     2002         run wp-XMLTagOpen( 3, "to", "" ).
     2003         run wp-XMLTagClose( 3, "to" ).
     2004         run wp-XMLTagOpen( 3, "from", "" ).
     2005         run wp-XMLTagClose( 3, "from" ).
     2006         run wp-XMLTagClose( 2, "delivery" ).
     2007       end.
     2008       run wp-XMLTagOpen( 2, "manifest", "" ).
     2009       run wp-XMLTagOpen( 3, "document", "" ).
     2010       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2011       run wp-XMLTagPut( 4, "description", "", 0 ).
     2012       run wp-XMLTagClose( 3, "document" ).
     2013       run wp-XMLTagClose( 2, "manifest" ).
     2014       run wp-XMLTagClose( 1, "header" ).
     2015       run wp-XMLTagOpen( 1, "body", "" ).
     2016   end.
     2017   end procedure.
     2018   procedure bge-xml-write-ref-footer :
     2019   define input parameter p-file-name as character        no-undo.
     2020       define variable v-error-level   as integer      no-undo.
     2021   do
     2022   on error undo, return error
     2023   :
     2024       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2025       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2026       output stream stmXMLOut close.
     2027       run bge/os_copy.p (
     2028             input "M":U
     2029           , input p-file-name + "xm1":U
     2030           , input p-file-name + "xml":U
     2031           , output v-error-level
     2032       ).
     2033       if v-error-level > 0
     2034       then do:
     2035           undo, return error.
     2036       end.
     2037   end.
     2038   end procedure.
     2039   procedure bge-xml-out-dir :
     2040   define output parameter p-out-dir       as character    no-undo.
     2041   define output parameter p-log-file-name as character    no-undo.
     2042   do
     2043   on error undo, return error
     2044   :
     2045       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2046       if p-out-dir = ?
     2047       then do:
     2048           message
     2049             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2050                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2051             skip(1)
     2052             skip "Обратитесь к администратору."
     2053           view-as alert-box error.
     2054           undo, return error .
     2055       end.
     2056       if v-bge-xml-bgeflold <> "oracle" then assign
     2057         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2058       .
     2059       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2060       if error-status :error  then do:
     2061           run wp-XMLWriteLog in this-procedure (
     2062                 input p-log-file-name
     2063               , input 0
     2064               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2065                                   , p-out-dir
     2066                                   , return-value
     2067                                   , trim( error-status :get-message( 1 ) )
     2068                                   )
     2069           ).
     2070           undo, return error.
     2071       end.
     2072       assign
     2073           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2074           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2075       .
     2076   end.
     2077   end procedure.
     2078   procedure bge-xml-out-dir2 :
     2079   define output parameter p-out-dir       as character    no-undo.
     2080   define output parameter p-out-dirR      as character    no-undo.
     2081   define output parameter p-log-file-name as character    no-undo.
     2082   do
     2083   on error undo, return error
     2084   :
     2085       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2086       if p-out-dir = ?
     2087       then do:
     2088           message
     2089             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2090                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2091             skip(1)
     2092             skip "Обратитесь к администратору."
     2093           view-as alert-box error.
     2094           undo, return error .
     2095       end.
     2096       if v-bge-xml-bgeflold <> "oracle" then assign
     2097             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2098             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2099         .
     2100       else p-out-dirR = p-out-dir .
     2101       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2102       if error-status :error  then do:
     2103           run wp-XMLWriteLog in this-procedure (
     2104                 input p-log-file-name
     2105               , input 0
     2106               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2107                                   , p-out-dir
     2108                                   , return-value
     2109                                   , error-status :get-message( 1 )
     2110                                   )
     2111           ).
     2112           undo, return error.
     2113       end.
     2114       if p-out-dirR <> p-out-dir then do:
     2115         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2116         if error-status :error then do:
     2117           run wp-XMLWriteLog in this-procedure (
     2118                 input p-log-file-name
     2119               , input 0
     2120               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2121                                   , p-out-dirR
     2122                                   , return-value
     2123                                   , error-status :get-message( 1 )
     2124                                   )
     2125           ).
     2126           p-out-dirR = p-out-dir .
     2127         end.
     2128       end .
     2129       assign
     2130         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2131         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2132       .
     2133   end.
     2134   end procedure.
     2135   procedure bge-xml-out-file :
     2136   do
     2137   on error undo, return error
     2138   :
     2139   define input parameter p-out-dir            as character        no-undo.
     2140   define input parameter p-prefix             as character        no-undo.
     2141   define input parameter p-sheduled           as logical          no-undo.
     2142   define output parameter p-xml-file-name     as character        no-undo.
     2143   define output parameter p-locked            as logical          no-undo.
     2144   define variable v-home-dir      as character     no-undo.
     2145   define variable v-error-num     as integer       no-undo.
     2146   define variable v-today             as date         no-undo.
     2147   define variable v-time              as integer      no-undo.
     2148       if v-bge-xml-bgefmt = "dbf":U
     2149       then do:
     2150           assign
     2151               p-xml-file-name = p-out-dir
     2152               p-locked        = no
     2153           .
     2154       end.
     2155       else do:
     2156           if v-bge-xml-bgeflold = "firm":U
     2157           then do:
     2158               run bge/genfname.p (
     2159                     input p-out-dir
     2160                   , input p-prefix
     2161                   , input "":U
     2162                   , input "arj":U
     2163                   , input "":U
     2164                   , output p-xml-file-name
     2165               ).
     2166           end.
     2167           else do:
     2168               run bge/genfname.p (
     2169                     input p-out-dir
     2170                   , input p-prefix
     2171                   , input "":U
     2172                   , input "xml":U
     2173                   , input "":U
     2174                   , output p-xml-file-name
     2175               ).
     2176           end.
     2177           assign
     2178               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2179               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2180           .
     2181       end.
     2182   end.
     2183   end procedure.
     2184   procedure bge-xml-init-ext-doc-type :
     2185       define variable v-counter    as integer      no-undo.
     2186       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2187   do
     2188   for buf_temp_ext-doc-type
     2189   on error undo, return error
     2190   :
     2191       empty temp-table buf_temp_ext-doc-type.
     2192       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2193       :
     2194           create buf_temp_ext-doc-type.
     2195           assign
     2196               buf_temp_ext-doc-type.edt-key               = v-counter
     2197               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2198               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2199           .
     2200       end.
     2201   end.
     2202   end procedure.
     2203   procedure bge-xml-get-decimal-shift-num :
     2204   define input parameter p-shift-date     as date             no-undo.
     2205   define input parameter p-shift-num      as integer          no-undo.
     2206   define output parameter p-shift-decimal as decimal          no-undo.
     2207   do
     2208   on error undo, return error
     2209   :
     2210       assign
     2211           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2212       .
     2213   end.
     2214   end procedure.
     2215   procedure bge-xml-ora-exp-filename :
     2216     define input  parameter p-table-name  as character no-undo .
     2217     define input  parameter p-doc-code    as character no-undo .
     2218     define input  parameter p-obj-code    as integer   no-undo .
     2219     define output parameter p-filename    as character no-undo .
     2220     define output parameter p-seq-num     as integer   no-undo .
     2221     define variable v-ora-exp-seq     as integer   no-undo .
     2222     define variable v-ora-exp-seq-str as character no-undo .
     2223     define variable v-home-dir        as character no-undo.
     2224   do
     2225   on error undo, return error return-value
     2226   :
     2227     if v-bge-xml-bgeflold = "oracle":u
     2228     then do:
     2229       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2230       if v-home-dir = ?
     2231       then do:
     2232         undo, return error substitute( "&1&2&3":U
     2233                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2234                                       , chr(10)
     2235                                       , "Обратитесь к администратору.":U
     2236                                       ).
     2237       end.
     2238       assign
     2239           v-home-dir = v-home-dir
     2240       .
     2241       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2242       if error-status :error
     2243       then do:
     2244         undo, return error substitute( "&1&2&3":U
     2245                                       , "Неверно задан каталог экспорта.":U
     2246                                       , chr(10)
     2247                                       , "Обратитесь к администратору.":U
     2248                                       ).
     2249       end.
     2250       assign
     2251         v-ora-exp-seq = ?
     2252       .
     2253       if  p-table-name <> ? and
     2254           p-doc-code <> ?
     2255       then do:
     2256         run bge/get-oesq.p ( input p-table-name
     2257                            , input p-doc-code
     2258                            , output v-ora-exp-seq
     2259                            ) no-error .
     2260         if error-status :error = yes
     2261         then do:
     2262           undo, return error return-value .
     2263         end.
     2264       end.
     2265       if v-ora-exp-seq = ?
     2266       then do:
     2267         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2268         if error-status :error
     2269         then do:
     2270           undo, return error return-value .
     2271         end.
     2272       end.
     2273       if p-table-name <> ? and
     2274          p-doc-code   <> ?
     2275       then do:
     2276         run bge/oesqdoc.p ( input p-table-name
     2277                           , input p-doc-code
     2278                           , input v-ora-exp-seq
     2279                           ) no-error .
     2280         if error-status :error = yes
     2281         then do:
     2282           undo, return error return-value .
     2283         end.
     2284       end.
     2285       assign
     2286         p-seq-num  = v-ora-exp-seq
     2287         p-filename = substitute("&1/&2-000_&3."
     2288                                , v-home-dir
     2289                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2290                                , string(v-ora-exp-seq , "999999999")
     2291                                )
     2292       .
     2293     end.
     2294   end.
     2295   end procedure.
     2296   procedure bge-xml-date-to-str :
     2297     define input  parameter p-date  as date      no-undo .
     2298     define output parameter p-str   as character no-undo .
     2299   do
     2300   on error undo, return error return-value
     2301   :
     2302     if p-date <> ?
     2303     then do:
     2304       assign
     2305         p-str = substitute( "&1-&2-&3"
     2306                           , string( year(p-date)  , "9999")
     2307                           , string( month(p-date) , "99"  )
     2308                           , string( day(p-date)   , "99"  )
     2309                           )
     2310       .
     2311     end.
     2312     else do:
     2313       assign
     2314         p-str = ?
     2315       .
     2316     end.
     2317   end.
     2318   end procedure.
     2319   procedure bge-xml-date-str-to-str :
     2320     define input  parameter p-date-str  as character no-undo .
     2321     define output parameter p-str       as character no-undo .
     2322     define variable v-date          as date      no-undo .
     2323     define variable v-date-valid    as logical   no-undo .
     2324     define variable v-error-message as character no-undo .
     2325   do
     2326   on error undo, return error return-value
     2327   :
     2328     assign
     2329       p-str = ?
     2330     .
     2331     if p-date-str = ? or p-date-str = ""
     2332     then do:
     2333       return .
     2334     end.
     2335     run strtdate in this-procedure ( input  p-date-str
     2336                                    , output v-date
     2337                                    , output v-date-valid
     2338                                    , output v-error-message
     2339                                    ).
     2340     if v-date-valid <> true
     2341     then do:
     2342       return .
     2343     end.
     2344     assign
     2345       p-str = substitute( "&1-&2-&3"
     2346                         , string( year(v-date)  , "9999")
     2347                         , string( month(v-date) , "99"  )
     2348                         , string( day(v-date)   , "99"  )
     2349                         )
     2350     .
     2351   end.
     2352   end procedure.
     2353   procedure bge-xml-fill-tt-bgecliiv :
     2354     define input  parameter p-str as character no-undo .
     2355     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2356     define buffer buf_clients             for ub.clients.
     2357     define variable v-i         as integer   no-undo .
     2358     define variable v-count     as integer   no-undo .
     2359     define variable v-cli-count as integer   no-undo .
     2360     define variable v-client    as character no-undo .
     2361     define variable v-obj-type  as character no-undo .
     2362     define variable v-obj-code  as integer   no-undo .
     2363   do
     2364   on error undo, return error return-value
     2365   :
     2366     empty temp-table buf_tt-bge-xml-bgecliiv.
     2367     assign
     2368       v-bge-xml-bgecliiv = no
     2369       v-cli-count        = num-entries(p-str,';')
     2370     .
     2371     if v-cli-count > 0
     2372     then do:
     2373       _cli-cycle:
     2374       do v-i = 1 to v-cli-count
     2375       :
     2376         assign
     2377           v-client = entry(v-i , p-str, ';')
     2378         .
     2379         if num-entries(v-client) <> 2
     2380         then do:
     2381           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2382         end.
     2383         assign
     2384           v-obj-type = entry(1, v-client)
     2385         .
     2386         assign
     2387           v-obj-code = integer(entry(2, v-client))
     2388         no-error .
     2389         if error-status :error
     2390         then do:
     2391           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2392         end.
     2393         find first buf_clients no-lock
     2394           where buf_clients.obj-type = v-obj-type
     2395             and buf_clients.obj-code = v-obj-code
     2396         no-error.
     2397         if not available buf_clients
     2398         then do:
     2399           next _cli-cycle.
     2400         end.
     2401         find first buf_tt-bge-xml-bgecliiv no-lock
     2402           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2403             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2404         no-error .
     2405         if available buf_tt-bge-xml-bgecliiv
     2406         then do:
     2407           next _cli-cycle.
     2408         end.
     2409         create buf_tt-bge-xml-bgecliiv.
     2410         assign
     2411           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2412           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2413         .
     2414       end.
     2415     end.
     2416     else do:
     2417       assign
     2418         v-bge-xml-bgecliiv = no
     2419       .
     2420       return .
     2421     end.
     2422     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2423     if available buf_tt-bge-xml-bgecliiv
     2424     then do:
     2425       assign
     2426         v-bge-xml-bgecliiv = yes
     2427       .
     2428     end.
     2429   end.
     2430   end procedure.
     2431   procedure bge-xml-resolve-ext-doc-type :
     2432     define input  parameter p-ext-doc-type      as character no-undo .
     2433     define input  parameter p-obj-type          as character no-undo .
     2434     define input  parameter p-obj-code          as integer   no-undo .
     2435     define output parameter p-out-ext-doc-type  as character no-undo .
     2436     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2437   do
     2438   on error undo, return error return-value
     2439   :
     2440     assign
     2441       p-out-ext-doc-type = p-ext-doc-type
     2442     .
     2443     if p-ext-doc-type <> 'ie':U
     2444     then do:
     2445       return .
     2446     end.
     2447     if v-bge-xml-bgecliiv = yes
     2448     then do:
     2449       find first buf_tt-bge-xml-bgecliiv no-lock
     2450         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2451           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2452       no-error .
     2453       if available buf_tt-bge-xml-bgecliiv
     2454       then do:
     2455         assign
     2456           p-out-ext-doc-type = 'iv':U
     2457         .
     2458       end.
     2459     end.
     2460   end.
     2461   end procedure.
     2462   procedure safe-wp-xmltagput :
     2463     define input  parameter pTagLevel   as integer   no-undo .
     2464     define input  parameter pTagName    as character no-undo .
     2465     define input  parameter pParValue   as character no-undo .
     2466     define input  parameter pFlagEmpty  as integer   no-undo .
     2467   do
     2468   on error undo, return error return-value
     2469   :
     2470     if v-bge-xml-bgeflold = "oracle":u
     2471     then do:
     2472       return .
     2473     end.
     2474     run wp-xmltagput in this-procedure ( input pTagLevel
     2475                                        , input pTagName
     2476                                        , input pParValue
     2477                                        , input pFlagEmpty
     2478                                        ).
     2479   end.
     2480   end procedure.
     2481   define new global shared variable g#library  as handle no-undo .
     2482   define new global shared variable g#library2 as handle no-undo .
     2483   define   shared variable g#auto as logical no-undo.
     2484   define   shared variable g#news as logical no-undo.
     2485   define   shared variable g#oxml as logical no-undo.
     2486   define   shared variable g#esys as logical no-undo.
     2487   define   shared variable g#news-source-db as integer no-undo.
     2488   define   shared variable g#esys-source-esys as integer no-undo.
     2489   define   shared variable g#db-num as integer   no-undo .
     2490   define   shared variable g#userid as character no-undo .
     2491   define   shared variable g#passwd as character no-undo .
     2492       define buffer   in-vatp-trn-docloc  for ub.trn-doc .
     2493       define buffer   in-vatp-partsloc    for ub.parts   .
     2494       define buffer   in-vatp-docloc      for ub.trn-doc .
     2495       define buffer   in-vatp-goodsloc    for ub.goods   .
     2496       define buffer   in-vatp-sysconfloc  for ub.sysconf .
     2497       define buffer   in-vatp_doc-attrloc for ub.doc-attr.
     2498       define variable in-vatp-have-vat-sltloc       as   logical initial yes    no-undo.
     2499       define variable vat-pc-locloc                 like ub.doc-line.vat-pc     no-undo.
     2500       define variable varinvprbloc                  as   character              no-undo.
     2501       define variable slt-pc-locloc                 like ub.doc-line.slt-pc     no-undo.
     2502       define variable cli-base-rateloc              as   decimal                no-undo.
     2503       define variable price-rubl-with-tax-locloc    like ub.doc-line.price-rubl no-undo.
     2504       define variable price-base-with-tax-locloc    like ub.doc-line.price-base no-undo.
     2505       define variable price-cli-with-tax-locloc     like ub.doc-line.price-cli  no-undo.
     2506       define variable price-rubl-without-tax-locloc like ub.doc-line.price-rubl no-undo.
     2507       define variable price-base-without-tax-locloc like ub.doc-line.price-base no-undo.
     2508       define variable price-cli-without-tax-locloc  like ub.doc-line.price-base no-undo.
     2509       define variable vat-base-locloc               like ub.doc-line.price-base no-undo.
     2510       define variable vat-rubl-locloc               like ub.doc-line.price-rubl no-undo.
     2511       define variable vat-cli-locloc                like ub.doc-line.price-rubl no-undo.
     2512       define variable slt-base-locloc               like ub.doc-line.price-base no-undo.
     2513       define variable slt-rubl-locloc               like ub.doc-line.price-rubl no-undo.
     2514       define variable slt-cli-locloc                like ub.doc-line.price-rubl no-undo.
     2515       define variable road-tax-base-locloc          like ub.doc-line.road-tax   no-undo.
     2516       define variable road-tax-rubl-locloc          like ub.doc-line.road-tax   no-undo.
     2517       define variable road-tax-cli-locloc           like ub.doc-line.road-tax   no-undo.
     2518       define variable transport-base-locloc         like ub.doc-line.price-base no-undo.
     2519       define variable transport-rubl-locloc         like ub.doc-line.price-rubl no-undo.
     2520       define variable transport-cli-locloc          like ub.doc-line.price-rubl no-undo.
     2521       define variable other-base-locloc             like ub.doc-line.price-base no-undo.
     2522       define variable other-rubl-locloc             like ub.doc-line.price-rubl no-undo.
     2523       define variable other-cli-locloc              like ub.doc-line.price-rubl no-undo.
     2524       define variable exch-rate-cli-locloc          like ub.trn-doc.exch-rate   no-undo.
     2525       define variable varinvatp-envdloc             as   character              no-undo.
     2526       define variable varinvatp-typeloc             as   character              no-undo.
     2527   define variable v-store-name       as character no-undo .
     2528   define variable v-qnty-before      as decimal no-undo .
     2529   define variable v-qnty-after       as decimal no-undo .
     2530   define variable v-doc-sumr-before  as decimal no-undo .
     2531   define variable v-doc-sumr-after   as decimal no-undo .
     2532   define variable v-cost-sumr-before as decimal no-undo .
     2533   define variable v-cost-sumr-after  as decimal no-undo .
     2534   define variable v-cost-sumr        as decimal no-undo .
     2535   define buffer buf_trn-doc     for ub.trn-doc .
     2536   define buffer buf_doc-line    for ub.doc-line .
     2537   define buffer buf_parts       for ub.parts .
     2538   define buffer buf_trn-doc-sum for ub.trn-doc-sum .
     2539   define buffer buf_gds-dtl     for ub.gds-dtl .
     2540   define buffer buf_price-doc   for ub.price-doc .
     2541   define buffer buf_fbr-doc     for ub.fbr-doc .
     2542   do on error undo, return error :
     2543     output stream stmxmlout to value( soutfile + "xm1" ) convert target "1251" append.
     2544     run wp-XMLWriteCNT( hCNT, "" ).
     2545     run wp-XMLWriteEDT( hEDT, 4, "Операция: Выгрузка отчёта-реестра документов." ).
     2546     run wp-XMLWriteLog( sLogFile, 0, "&Line" ).
     2547     run wp-XMLWriteLog( sLogFile, 1, "XML - Вывод операции: Выгрузка отчёта-реестра документов." ).
     2548     v-store-name = substitute("&1&2", p-obj-type, p-obj-code).
     2549     for each buf_trn-doc no-lock
     2550        where buf_trn-doc.obj-type   = p-obj-type
     2551          and buf_trn-doc.obj-code   = p-obj-code
     2552          and buf_trn-doc.shift-date = p-shift-date
     2553          and buf_trn-doc.shift-num  = p-shift-num
     2554          and buf_trn-doc.status_    = 'факт':U
     2555          and can-do ('ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,wm,im,ot,fbr':U, buf_trn-doc.ext-doc-type) = true
     2556     :
     2557       run wp-xmltagopen ( input 2, input "expDocument", input "" ).
     2558       run wp-xmltagput( input 3, input "store",         input v-store-name,             input 0 ).
     2559       run wp-xmltagput( input 3, input "shiftNum",      input buf_trn-doc.shift-num,    input 0 ).
     2560       run wp-xmltagput( input 3, input "shiftDate",     input string(buf_trn-doc.shift-date, "99.99.9999"), input 0 ).
     2561       run wp-xmltagput( input 3, input "codeOperation", input buf_trn-doc.ext-doc-type, input 0 ).
     2562       run wp-xmltagput( input 3, input "factOrder"    , input string(buf_trn-doc.fact-order), input 0 ).
     2563       run wp-xmltagput( input 3, input "dateDoc"      , input string(buf_trn-doc.doc-date,   "99.99.9999"), input 0 ).
     2564       run wp-xmltagput( input 3, input "referenceNo"  , input buf_trn-doc.doc-code,     input 0 ).
     2565       run wp-xmltagput( input 3, input "firm",          input buf_trn-doc.cli-type + string( buf_trn-doc.cli-code ), input 0 ).
     2566       v-cost-sumr = 0 .
     2567       for each buf_doc-line no-lock
     2568          where buf_doc-line.doc-code = buf_trn-doc.doc-code :
     2569         for each buf_parts no-lock
     2570            where buf_parts.out-code  = buf_doc-line.doc-code
     2571              and buf_parts.obj-type  = buf_doc-line.obj-type
     2572              and buf_parts.obj-code  = buf_doc-line.obj-code
     2573              and buf_parts.artic     = buf_doc-line.artic
     2574              and buf_parts.prod-type = buf_doc-line.prod-type
     2575              and buf_parts.prod-code = buf_doc-line.prod-code :
     2576   assign
     2577     price-rubl-with-tax-locloc = buf_parts.price-rubl
     2578     price-base-with-tax-locloc = buf_parts.price-base
     2579   .
     2580   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2581   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2582     (output varinvprbloc
     2583     )  .
     2584     if buf_parts.out-code = 'free-zone':U     or
     2585        buf_parts.out-code = 'out-zone':U   or
     2586        buf_parts.doc-type = 'акт':U then do:
     2587       assign
     2588         in-vatp-have-vat-sltloc = yes.
     2589     end.
     2590     else do:
     2591       find first in-vatp_doc-attrloc no-lock
     2592         where in-vatp_doc-attrloc.doc-code  = buf_parts.out-code
     2593           and in-vatp_doc-attrloc.attr-code = 'envd':U
     2594         no-error .
     2595       if not available in-vatp_doc-attrloc then do:
     2596         assign
     2597           in-vatp-have-vat-sltloc = yes.
     2598       end.
     2599       else do:
     2600            in-vatp-have-vat-sltloc = no.
     2601       end.
     2602     end.
     2603     assign
     2604      price-cli-with-tax-locloc = buf_parts.price-cli
     2605      cli-base-rateloc          = buf_parts.cli-base-rate.
     2606     ASSIGN   road-tax-base-locloc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     2607              road-tax-rubl-locloc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     2608     ASSIGN  transport-base-locloc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     2609             transport-rubl-locloc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     2610             other-base-locloc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     2611             other-rubl-locloc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     2612             vat-pc-locloc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     2613             slt-pc-locloc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     2614             ASSIGN   slt-base-locloc    = (if in-vatp-have-vat-sltloc = no then 0 else (price-base-with-tax-locloc - ((if road-tax-base-locloc  = ? then 0 else road-tax-base-locloc) + (if transport-base-locloc = ? then 0 else transport-base-locloc) + (if other-base-locloc = ? then 0 else other-base-locloc)))                           * slt-pc-locloc / (100 + slt-pc-locloc))                        vat-base-locloc    = (if in-vatp-have-vat-sltloc = no then 0 else (price-base-with-tax-locloc - ((if road-tax-base-locloc  = ? then 0 else road-tax-base-locloc) + (if transport-base-locloc = ? then 0 else transport-base-locloc) + (if other-base-locloc = ? then 0 else other-base-locloc))) * (1 - slt-pc-locloc / (100 + slt-pc-locloc)) * vat-pc-locloc / (100 + vat-pc-locloc)).
     2615       ASSIGN   slt-rubl-locloc    = (if in-vatp-have-vat-sltloc = no then 0 else (price-rubl-with-tax-locloc - ((if road-tax-rubl-locloc  = ? then 0 else road-tax-rubl-locloc) + (if transport-rubl-locloc = ? then 0 else transport-rubl-locloc) + (if other-rubl-locloc = ? then 0 else other-rubl-locloc)))                           * slt-pc-locloc / (100 + slt-pc-locloc))                        vat-rubl-locloc    = (if in-vatp-have-vat-sltloc = no then 0 else (price-rubl-with-tax-locloc - ((if road-tax-rubl-locloc  = ? then 0 else road-tax-rubl-locloc) + (if transport-rubl-locloc = ? then 0 else transport-rubl-locloc) + (if other-rubl-locloc = ? then 0 else other-rubl-locloc))) * (1 - slt-pc-locloc / (100 + slt-pc-locloc)) * vat-pc-locloc / (100 + vat-pc-locloc)).
     2616     assign
     2617       exch-rate-cli-locloc = (buf_parts.price-rubl - transport-rubl-locloc - other-rubl-locloc - road-tax-rubl-locloc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-locloc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-locloc else 0)) / buf_parts.price-cli .
     2618     assign
     2619       slt-cli-locloc        = slt-rubl-locloc       / exch-rate-cli-locloc
     2620       vat-cli-locloc        = vat-rubl-locloc       / exch-rate-cli-locloc
     2621       road-tax-cli-locloc   = road-tax-rubl-locloc  / exch-rate-cli-locloc
     2622       transport-cli-locloc  = 0
     2623       other-cli-locloc      = 0
     2624     .
     2625   ASSIGN
     2626             price-base-without-tax-locloc = price-base-with-tax-locloc - vat-base-locloc - slt-base-locloc - ((if road-tax-base-locloc  = ? then 0 else road-tax-base-locloc) + (if transport-base-locloc = ? then 0 else transport-base-locloc) + (if other-base-locloc = ? then 0 else other-base-locloc))
     2627       price-rubl-without-tax-locloc = price-rubl-with-tax-locloc - vat-rubl-locloc - slt-rubl-locloc - ((if road-tax-rubl-locloc  = ? then 0 else road-tax-rubl-locloc) + (if transport-rubl-locloc = ? then 0 else transport-rubl-locloc) + (if other-rubl-locloc = ? then 0 else other-rubl-locloc))
     2628   .
     2629           v-cost-sumr = v-cost-sumr + price-rubl-with-tax-locloc * buf_parts.fact-qnty .
     2630         end .
     2631       end .
     2632       case buf_trn-doc.ext-doc-type :
     2633         when 'vt':U or
     2634         when 'vp':U then do :
     2635           do:
     2636             find first buf_trn-doc-sum no-lock
     2637                  where buf_trn-doc-sum.doc-code = buf_trn-doc.doc-code
     2638                    and buf_trn-doc-sum.sum-type = 'bd':U
     2639               no-error.
     2640             if available buf_trn-doc-sum then assign
     2641               v-qnty-before      = buf_trn-doc-sum.fact-qnty
     2642               v-doc-sumr-before  = buf_trn-doc-sum.crsa-sum-rubl
     2643               v-cost-sumr-before = buf_trn-doc-sum.cost-sum-rubl
     2644             .
     2645             else assign
     2646               v-qnty-before      = 0
     2647               v-doc-sumr-before  = 0
     2648               v-cost-sumr-before = 0
     2649             .
     2650             find first buf_trn-doc-sum no-lock
     2651                  where buf_trn-doc-sum.doc-code = buf_trn-doc.doc-code
     2652                    and buf_trn-doc-sum.sum-type = 'ad':U
     2653               no-error.
     2654             if available buf_trn-doc-sum then assign
     2655               v-qnty-after       = buf_trn-doc-sum.fact-qnty
     2656               v-doc-sumr-after   = buf_trn-doc-sum.crsa-sum-rubl
     2657               v-cost-sumr-after  = buf_trn-doc-sum.cost-sum-rubl
     2658             .
     2659             else assign
     2660               v-qnty-after       = 0
     2661               v-doc-sumr-after   = 0
     2662               v-cost-sumr-after  = 0
     2663             .
     2664           end .
     2665           run wp-xmltagopen ( input 3, input "beforeSum", input "" ).
     2666           run wp-xmltagput( input 4, input "qnty"         , input string(v-qnty-before),      input 0 ).
     2667           run wp-xmltagput( input 4, input "DocSum_SumR"  , input string(v-doc-sumr-before),  input 0 ).
     2668           run wp-xmltagput( input 4, input "CostSum_SumR" , input string(v-cost-sumr-before), input 0 ).
     2669           run wp-xmltagclose( input 3, input "beforeSum" ).
     2670           run wp-xmltagopen ( input 3, input "afterSum",  input "" ).
     2671           run wp-xmltagput( input 4, input "qnty"         , input string(v-qnty-after),       input 0 ).
     2672           run wp-xmltagput( input 4, input "DocSum_SumR"  , input string(v-doc-sumr-after),   input 0 ).
     2673           run wp-xmltagput( input 4, input "CostSum_SumR" , input string(v-cost-sumr-after),  input 0 ).
     2674           run wp-xmltagclose( input 3, input "afterSum" ).
     2675         end .
     2676         when 'rs':U or
     2677         when 'es':U then do :
     2678           run wp-xmltagput( input 3, input "quantity"     , input string(buf_trn-doc.fact-qnty), input 0 ).
     2679           run wp-xmltagput( input 3, input "DocSum_SumR"  , input string(buf_trn-doc.tot-fact - buf_trn-doc.tot-calc),  input 0 ).
     2680           run wp-xmltagput( input 3, input "CostSum_SumR" , input string(v-cost-sumr),  input 0 ).
     2681         end .
     2682         otherwise do :
     2683           run wp-xmltagput( input 3, input "quantity"     , input string(buf_trn-doc.fact-qnty), input 0 ).
     2684           run wp-xmltagput( input 3, input "DocSum_SumR"  , input string(buf_trn-doc.tot-doc),   input 0 ).
     2685           run wp-xmltagput( input 3, input "CostSum_SumR" , input string(v-cost-sumr),  input 0 ).
     2686         end .
     2687       end case .
     2688       run wp-xmltagclose( input 2, input "expDocument" ).
     2689     end .
     2690     for each buf_price-doc no-lock
     2691        where buf_price-doc.obj-type   = p-obj-type
     2692          and buf_price-doc.obj-code   = p-obj-code
     2693          and buf_price-doc.shift-date = p-shift-date
     2694          and buf_price-doc.shift-num  = p-shift-num
     2695          and buf_price-doc.status_    = 'акт':U
     2696     :
     2697       run wp-xmltagopen ( input 2, input "expDocument", input "" ).
     2698       run wp-xmltagput( input 3, input "store",         input v-store-name,            input 0 ).
     2699       run wp-xmltagput( input 3, input "shiftNum",      input buf_price-doc.shift-num, input 0 ).
     2700       run wp-xmltagput( input 3, input "shiftDate",     input string(buf_price-doc.shift-date, "99.99.9999"), input 0 ).
     2701       run wp-xmltagput( input 3, input "codeOperation", input 'ot':U,       input 0 ).
     2702       run wp-xmltagput( input 3, input "factOrder"    , input string(buf_price-doc.fact-order), input 0 ).
     2703       run wp-xmltagput( input 3, input "dateDoc"      , input string(buf_price-doc.doc-date,   "99.99.9999"), input 0 ).
     2704       run wp-xmltagput( input 3, input "referenceNo"  , input buf_price-doc.doc-num,   input 0 ).
     2705       run wp-xmltagput( input 3, input "quantity"     , input string(buf_price-doc.rest-qnty), input 1 ).
     2706       run wp-xmltagput( input 3, input "DocSum_SumR"  , input string(buf_price-doc.sale-base), input 1 ).
     2707       run wp-xmltagclose( input 2, input "expDocument" ).
     2708     end .
     2709     run wp-XMLWriteLog in this-procedure
     2710     ( input sLogFile
     2711     , input 1
     2712     , input substitute( "Выгрузка отчёта-реестра документов в пакет &1 завершена."
     2713                        , sOutFile
     2714                       )
     2715     ).
     2716     output stream stmxmlout close.
     2717   end .
