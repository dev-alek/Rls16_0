        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 19a7bcd6f844, 1625, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
        4   define variable vss-date        as character no-undo init "$Date: Tue Nov 06 04:41:39 2018 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: sht-reestr.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: bge/sht-reestr.p $":U .
        7   define variable vss-description as character no-undo init "Экспорт отчёта-реестра документов выгрузки в Лексему".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define input parameter p-obj-type   as character   no-undo.
       63   define input parameter p-obj-code   as integer     no-undo.
       64   define input parameter p-shift-date as date        no-undo.
       65   define input parameter p-shift-num  as integer     no-undo.
       66   define input parameter sOutFile     as character   no-undo.
       67   define input parameter sLogFile     as character   no-undo.
       68   define input parameter hEDT         as handle      no-undo.
       69   define input parameter hCNT         as handle      no-undo.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define variable vss-include-info0 as character format "X(65)" no-undo
       75   initial "@(#)$Workfile$ $Revision$".
       76   DEF STREAM stmXMLOut.
       77   DEF STREAM stmXMLLog.
       78   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure cur-time :
       80      define output parameter p-today as date      no-undo .
       81      define output parameter p-time  as integer   no-undo .
       82     do
       83     on error undo, return error
       84     :
       85       define variable v-date1 as date      no-undo .
       86       define variable v-date2 as date      no-undo .
       87       define variable v-time  as integer   no-undo .
       88       assign
       89         v-date1 = today
       90         v-time  = time
       91         v-date2 = today
       92       .
       93       if v-date1 <> v-date2
       94       then do:
       95         assign
       96           v-date1 = today
       97           v-time  = v-time
       98         .
       99       end.
      100       assign
      101         p-today = v-date1
      102         p-time  = v-time
      103       .
      104     end.
      105   end.
      106   function cur-time-date returns character
      107   :
      108     return string(today, '99/99/9999':U) .
      109   end.
      110   function cur-time-mjd returns decimal
      111   :
      112     define variable v-date as date      no-undo .
      113     define variable v-time as integer   no-undo .
      114     run cur-time in this-procedure
      115       (output v-date
      116       ,output v-time
      117       ) .
      118     return integer(v-date) - 2400002 + (v-time / 86400) .
      119   end.
      120   function cur-time-get-ending-index returns integer
      121   (input p-number as integer
      122   )
      123   :
      124     if p-number < 0
      125     or p-number = ?
      126     then do:
      127       return 1 .
      128     end.
      129     define variable v-rest as integer   no-undo .
      130     assign
      131       p-number = p-number modulo 100
      132     .
      133     if p-number < 20
      134     then do:
      135       assign
      136         v-rest = p-number
      137       .
      138     end.
      139     else do:
      140       assign
      141         v-rest = p-number modulo 10
      142       .
      143     end.
      144     case v-rest :
      145       when 1
      146       then do:
      147         return 2 .
      148       end.
      149       when 2 or
      150       when 3 or
      151       when 4
      152       then do:
      153         return 3 .
      154       end.
      155       otherwise do:
      156         return 1 .
      157       end.
      158     end case .
      159   end.
      160   procedure cur-time-mjd-to-date :
      161      define input  parameter i-mjd-diff as decimal no-undo.
      162      define output parameter o-Date     as date    no-undo.
      163      define output parameter o-Time     as integer no-undo.
      164      define variable v-day-number as integer   no-undo .
      165      if    i-mjd-diff < 0
      166         or i-mjd-diff = ?
      167      then do:
      168         return "?" .
      169      end.
      170      assign
      171         v-day-number = truncate(i-mjd-diff,0).
      172         o-Date = date(v-day-number + 2400002).
      173         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      174     .
      175   end.
      176   function cur-time-mjd-to-string returns character
      177   (input p-mjd-diff as decimal
      178   )
      179   :
      180     define variable v-day-number as integer   no-undo .
      181     define variable v-seconds    as integer   no-undo .
      182     define variable v-hour       as integer   no-undo .
      183     define variable v-min        as integer   no-undo .
      184     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      185     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      186     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      187     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      188     if p-mjd-diff < 0
      189     or p-mjd-diff = ?
      190     then do:
      191       return "?" .
      192     end.
      193     assign
      194       v-day-number = integer(truncate(p-mjd-diff,0))
      195       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197     if v-seconds > 86400
      198     then do:
      199       assign
      200         v-seconds = 86400 - 1
      201       .
      202     end.
      203     if v-seconds < 0
      204     then do:
      205       assign
      206         v-seconds = 0
      207       .
      208     end.
      209     assign
      210       v-hour = truncate(v-seconds / 3600, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 3600
      214     .
      215     assign
      216       v-min = truncate(v-seconds / 60, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 60
      220     .
      221     return
      222         (if v-day-number <> 0
      223           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0
      227           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      231           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      232           else ""
      233         )
      234       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      235       .
      236   end.
      237   function cur-time-string returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      246   end.
      247   function cur-time-string-sec returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      256   end.
      257   function cur-time-custom  returns character
      258   (input p-prefix as character
      259   ,input p-date-format as character
      260   ,input p-delimiter as character
      261   ,input p-time-format as character
      262   ,input p-suffix as character
      263   )
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return
      272       p-prefix
      273       + string(v-date, p-date-format)
      274       + p-delimiter
      275       + string(v-time, p-time-format)
      276       + p-suffix
      277       .
      278   end.
      279   function cur-time-print  returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-datetime returns datetime
      290   :
      291     define variable v-char as character no-undo .
      292     define variable v-datetime as datetime no-undo .
      293     v-char = cur-time-string().
      294     v-datetime = datetime(v-char).
      295     return  v-datetime.
      296   end.
      297   function cur-time-string-msec returns character
      298   :
      299     define variable v-date as datetime  no-undo .
      300     v-date = now.
      301     return string(v-date) .
      302   end.
      303   define variable vss-include-info2 as character format "X(65)" no-undo
      304   initial "@(#)$Workfile$ $Revision$".
      305   procedure xmlchar-test :
      306   define input parameter p-in-string          as character        no-undo.
      307   define output parameter p-out-string-enc    as character        no-undo.
      308   define output parameter p-out-string-dec    as character        no-undo.
      309   do
      310   on error undo, return error
      311   :
      312          run xmlchar-encode in this-procedure
      313       (
      314             input p-in-string
      315           , output p-out-string-enc
      316       ).
      317          run xmlchar-decode in this-procedure
      318       (
      319             input p-out-string-enc
      320           , output p-out-string-dec
      321       ).
      322   end.
      323   end .
      324   procedure xmlchar-encode :
      325   define input parameter p-in-string      as character        no-undo.
      326   define output parameter p-out-string    as character        no-undo.
      327       define variable v-position      as integer      no-undo.
      328       define variable v-current-char  as character    no-undo.
      329   do
      330   on error undo, return error
      331   :
      332       assign
      333           p-out-string = "":U
      334       .
      335       case p-in-string
      336       :
      337           when ?
      338           then do:
      339               assign
      340                   p-out-string = "?":U
      341               .
      342           end.
      343           when "?":U
      344           then do:
      345               assign
      346                   p-out-string = "&#63;":U
      347               .
      348           end.
      349           otherwise do:
      350               do v-position = 1 to length( p-in-string )
      351               :
      352                   assign
      353                       v-current-char = substring( p-in-string, v-position, 1 )
      354                   .
      355                   case v-current-char
      356                   :
      357                       when "&":U
      358                       then do:
      359                           assign
      360                               p-out-string = p-out-string + "&amp;":U
      361                           .
      362                       end.
      363                       when ">":U
      364                       then do:
      365                           assign
      366                               p-out-string = p-out-string + "&gt;":U
      367                           .
      368                       end.
      369                       when "<":U
      370                       then do:
      371                           assign
      372                               p-out-string = p-out-string + "&lt;":U
      373                           .
      374                       end.
      375                       when "'":U
      376                       then do:
      377                           assign
      378                               p-out-string = p-out-string + "&apos;":U
      379                           .
      380                       end.
      381                       when '"':U
      382                       then do:
      383                           assign
      384                               p-out-string = p-out-string + "&quot;":U
      385                           .
      386                       end.
      387                       when chr(1)
      388                       then do:
      389                           assign
      390                               p-out-string = p-out-string + "":U
      391                           .
      392                       end.
      393                       when chr(2)
      394                       then do:
      395                           assign
      396                               p-out-string = p-out-string + "":U
      397                           .
      398                       end.
      399                       when chr(3)
      400                       then do:
      401                           assign
      402                               p-out-string = p-out-string + "":U
      403                           .
      404                       end.
      405                       when chr(4)
      406                       then do:
      407                           assign
      408                               p-out-string = p-out-string + "":U
      409                           .
      410                       end.
      411                       when chr(5)
      412                       then do:
      413                           assign
      414                               p-out-string = p-out-string + "":U
      415                           .
      416                       end.
      417                       when chr(6)
      418                       then do:
      419                           assign
      420                               p-out-string = p-out-string + "":U
      421                           .
      422                       end.
      423                       when chr(7)
      424                       then do:
      425                           assign
      426                               p-out-string = p-out-string + "":U
      427                           .
      428                       end.
      429                       when chr(8)
      430                       then do:
      431                           assign
      432                               p-out-string = p-out-string + "":U
      433                           .
      434                       end.
      435                       when chr(9)
      436                       then do:
      437                           assign
      438                               p-out-string = p-out-string + "":U
      439                           .
      440                       end.
      441                       when chr(29)
      442                       then do:
      443                           assign
      444                               p-out-string = p-out-string + "":U
      445                           .
      446                       end.
      447                       when chr(10)
      448                       then do:
      449                           assign
      450                               p-out-string = p-out-string + "&#10;":U
      451                           .
      452                       end.
      453                       when chr(13)
      454                       then do:
      455                           assign
      456                               p-out-string = p-out-string + "&#13;":U
      457                           .
      458                       end.
      459                       otherwise do:
      460                           assign
      461                               p-out-string = p-out-string + v-current-char
      462                           .
      463                       end.
      464                   end case.
      465               end.
      466           end.
      467       end case.
      468   end.
      469   end .
      470   procedure xmlchar-encode-1c :
      471   define input parameter p-in-string      as character        no-undo.
      472   define output parameter p-out-string    as character        no-undo.
