     1000   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1001                                             INPUT iFlagEmpty AS INTEGER).
     1002       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1003       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1004           DO:
     1005               IF iFlagEmpty = 0                           THEN RETURN "".
     1006               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1007               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1008               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1009               ELSE RETURN "".
     1010           END.
     1011       ELSE DO:
     1012           run xmlchar-encode in this-procedure (
     1013                 input sToPlace
     1014               , output sToPlace
     1015           ).
     1016           ASSIGN
     1017               sToPlace = sParName + '="' + sToPlace + '"'
     1018           .
     1019           RETURN sToPlace.
     1020       END.
     1021   END FUNCTION.
     1022   function bge-xml-date returns character
     1023   ( input p-date as date )
     1024   :
     1025     define variable v-date-str as character no-undo .
     1026     run bge-xml-date-to-str in this-procedure ( input   p-date
     1027                                               , output  v-date-str
     1028                                               ) .
     1029     return v-date-str.
     1030   end function.
     1031   function bge-xml-str-date returns character
     1032   ( input p-date-str as character )
     1033   :
     1034     define variable v-date-str as character no-undo .
     1035     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1036                                                   , output  v-date-str
     1037                                                   ) .
     1038     return v-date-str.
     1039   end function.
     1040   function bge-xml-normalize-dec returns decimal
     1041   ( input p-val as decimal )
     1042   :
     1043     return (if p-val = ? then 0 else p-val) .
     1044   end function.
     1045   PROCEDURE wp-XMLTagOpen:
     1046   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1047   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1048   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1049       define variable v-out-string    as character    no-undo.
     1050   do
     1051   on error undo, return error
     1052   :
     1053       if v-bge-xml-bgefmt = "dbf":U
     1054       then do:
     1055       end.
     1056       else do:
     1057           assign
     1058               v-out-string = substitute( "&1&2<&3&4>"
     1059                                       , chr(10)
     1060                                       , fill( " ":U, 4 * iTagLevel)
     1061                                       , sTagName
     1062                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1063                               )
     1064           .
     1065           put stream stmXMLOut unformatted
     1066               v-out-string
     1067           .
     1068       end.
     1069   end.
     1070   END PROCEDURE.
     1071   PROCEDURE wp-XMLTagPut:
     1072     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1073     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1074     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1075     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1076       define variable v-out-string    as character    no-undo.
     1077   do
     1078   on error undo, return error
     1079   :
     1080       if v-bge-xml-bgefmt = "dbf":U
     1081       then do:
     1082           if v-bge-xml-dbf-file-name <> "":U
     1083           then do:
     1084               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1085               export stream stmXMLOut
     1086                   sTagName
     1087                   sParValue
     1088               .
     1089               output stream stmXMLOut close.
     1090           end.
     1091       end.
     1092       else do:
     1093           IF  iFlagEmpty = 1
     1094           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1095           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1096           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1097           THEN DO:
     1098               run xmlchar-encode in this-procedure (
     1099                   input sParValue
     1100                   , output sParValue
     1101               ).
     1102               assign
     1103                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1104                                               , chr(10)
     1105                                               , FILL(" ", 4 * iTagLevel)
     1106                                               , sTagName
     1107                                               , sParValue
     1108                               )
     1109               .
     1110               PUT STREAM stmXMLOut UNFORMATTED
     1111                   v-out-string
     1112               .
     1113           END.
     1114       end.
     1115   end.
     1116   END PROCEDURE.
     1117   PROCEDURE wp-XMLTagClose:
     1118   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1119   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1120       define variable v-out-string    as character    no-undo.
     1121   do
     1122   on error undo, return error
     1123   :
     1124       if v-bge-xml-bgefmt = "dbf":U
     1125       then do:
     1126       end.
     1127       else do:
     1128           assign
     1129               v-out-string = substitute( "&1&2</&3>"
     1130                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1131                                   , fill( " ", 4 * iTagLevel )
     1132                                   , sTagName
     1133                           )
     1134           .
     1135           PUT STREAM stmXMLOut UNFORMATTED
     1136               v-out-string
     1137           .
     1138       end.
     1139   end.
     1140   END PROCEDURE.
     1141   PROCEDURE wp-XMLWriteLog:
     1142     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1143     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1144     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1145   define variable v-str              as character no-undo .
     1146   define variable v-error-append     as logical   no-undo .
     1147   define variable v-error-append-msg as character no-undo .
     1148   assign
     1149     v-str = chr(10)
     1150             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1151             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1152     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1153     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1154     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1155   .
     1156   run bge/bge-log.p (input v-str) no-error .
     1157   if error-status:error then do:
     1158     assign
     1159       v-error-append     = yes
     1160       v-error-append-msg = return-value
     1161     .
     1162   end.
     1163   run gbl/fileapnd.p
     1164     ( input sFileName
     1165     , input v-str
     1166     , input 10
     1167     ) no-error .
     1168   if error-status:error then do:
     1169     assign
     1170       v-error-append     = yes
     1171       v-error-append-msg = substitute( "&1&2&3"
     1172                                       , v-error-append-msg
     1173                                       , chr(10)
     1174                                       , return-value
     1175                                       )
     1176     .
     1177   end.
     1178   if v-error-append
     1179   then do:
     1180     return error substitute( "&1" , v-error-append-msg ) .
     1181   end.
     1182   END PROCEDURE.
     1183   PROCEDURE wp-XMLWriteEDT:
     1184     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1185     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1186     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1187       if valid-handle ( hEDT )
     1188       then do:
     1189           hEDT :move-to-eof().
     1190           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1191                                           OR sToWrite = "&Line") THEN "" ELSE
     1192                                           cur-time-string-sec() + " ").
     1193           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1194                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1195                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1196           hEDT :insert-string(chr(10)).
     1197       end.
     1198       process events.
     1199       output to 'bgescn.txt' append.
     1200           put unformatted
     1201               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1202                                           OR sToWrite = "&Line") THEN "" ELSE
     1203                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1204               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1205                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1206                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1207           .
     1208       output close.
     1209   END PROCEDURE.
     1210   PROCEDURE wp-XMLShowCNT:
     1211     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1212       if valid-handle( hCNT )
     1213       then do:
     1214           ASSIGN hCNT :VISIBLE = TRUE.
     1215       end.
     1216   END PROCEDURE.
     1217   PROCEDURE wp-XMLHideCNT:
     1218     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1219       if valid-handle( hCNT )
     1220       then do:
     1221           ASSIGN hCNT :VISIBLE = FALSE.
     1222       end.
     1223   END PROCEDURE.
     1224   PROCEDURE wp-XMLWriteCNT:
     1225     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1226     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1227       if valid-handle( hCNT )
     1228       then do:
     1229           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1230       end.
     1231   END PROCEDURE.
     1232   procedure bge-xml-write-header:
     1233   do
     1234   on error undo, return error
     1235   :
     1236   define input parameter p-xml-file-name  as character        no-undo.
     1237   define input parameter p-doc-name       as character        no-undo.
     1238   define input parameter p-version        as character        no-undo.
     1239   define input parameter p-db-num         as integer          no-undo.
     1240   define input parameter p-date-from      as date             no-undo.
     1241   define input parameter p-shift-num-from as integer          no-undo.
     1242   define input parameter p-date-to        as date             no-undo.
     1243   define input parameter p-shift-num-to   as integer          no-undo.
     1244   define input parameter p-obj-list       as character        no-undo.
     1245   define input parameter p-doc-type-list  as character        no-undo.
     1246   define input parameter p-pay-code       as logical          no-undo.
     1247   define input parameter p-cst            as logical          no-undo.
     1248   define input parameter p-parts          as logical          no-undo.
     1249   define input parameter p-chk-pay-code   as logical          no-undo.
     1250   define input parameter p-pay-desk       as logical          no-undo.
     1251   define input parameter p-pay-desk-cards as logical          no-undo.
     1252   define input parameter p-deleted        as logical          no-undo.
     1253   define input parameter p-opened-docs    as logical          no-undo.
     1254   define variable v-out-string    as character    no-undo.
     1255   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1256   assign
     1257       v-out-string = substitute( "&1&2&3"
     1258                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1259                           , chr(10)
     1260                           , "<IBS_Trade_House>":U )
     1261   .
     1262   put stream stmXMLOut unformatted
     1263       v-out-string
     1264   .
     1265   run wp-XMLTagOpen(1, "header","").
     1266   if v-bge-xml-bgeflold = "oracle":u
     1267   then do:
     1268     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1269     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1270     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1271     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1272     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1273   end.
     1274   run wp-XMLTagOpen( 2, "manifest", "").
     1275   run wp-XMLTagOpen( 3, "document", "").
     1276   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1277   run wp-XMLTagput( 4, "description", "", 0).
     1278   run wp-XMLTagput( 4, "version", p-version, 0).
     1279   run wp-XMLTagclose( 3, "document" ).
     1280   run wp-XMLTagclose( 2, "manifest" ).
     1281   run wp-XMLTagclose( 1, "header" ).
     1282   run wp-XMLTagOpen(1, "options","").
     1283   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1284   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1285   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1286   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1287   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1288   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1289   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1290   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1291   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1292   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1293   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1294   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1295   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1296   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1297   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1298   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1299   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1300   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1301   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1302   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1303   run wp-XMLTagClose(1, "options").
     1304   run wp-XMLTagOpen( 1, "body", "" ).
     1305   output stream stmXMLOut close.
     1306   end.
     1307   end procedure.
     1308   procedure xml-bge-write-footer:
     1309   do
     1310   on error undo, return error return-value
     1311   :
     1312   define input parameter p-xml-file-name as character    no-undo.
     1313   define variable v-error-num     as integer           no-undo.
     1314   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1315   run wp-XMLTagClose( 1, "body" ).
     1316   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1317   output stream stmXMLOut close.
     1318   if v-bge-xml-bgeflold = "oracle":u
     1319   then do:
     1320     define variable v-tmp-file-name         as character no-undo .
     1321     define variable v-zip-file-name         as character no-undo .
     1322     define variable v-exch-file-name        as character no-undo .
     1323     define variable v-heap-file-name        as character no-undo .
     1324     define variable v-i                     as integer   no-undo .
     1325     define variable v-file-name             as character no-undo .
     1326     define variable v-arc                   as character no-undo .
     1327     define variable v-str                   as character no-undo .
     1328     define variable v-exch-tmp-file-name    as character no-undo .
     1329     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1330     define variable v-bge-xml-exch-dir      as character no-undo .
     1331     define variable v-bge-xml-heap-dir      as character no-undo .
     1332     define variable v-bge-xml-compress-heap as logical   no-undo .
     1333     define variable v-home-dir              as character no-undo .
     1334     define variable v-os-command            as character no-undo .
     1335     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1336     if v-home-dir = ?
     1337     then do:
     1338       undo, return error substitute( "&1&2&3"
     1339                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1340                                     , chr(10)
     1341                                     , "Обратитесь к администратору.":u
     1342                                     ).
     1343     end.
     1344     assign
     1345       v-home-dir = v-home-dir
     1346     .
     1347     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1348     if error-status :error
     1349     then do:
     1350       undo, return error substitute( "&1&2&3"
     1351                                     , "Неверно задан каталог экспорта.":u
     1352                                     , chr(10)
     1353                                     , "Обратитесь к администратору.":u
     1354                                     ).
     1355     end.
     1356     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1357     if v-bge-xml-exch-dir = ?
     1358     then do:
     1359       undo, return error substitute( "&1&2&3"
     1360                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1361                                     , chr(10)
     1362                                     , "Обратитесь к администратору.":u
     1363                                     ).
     1364     end.
     1365     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1366     if error-status :error
     1367     then do:
     1368       undo, return error substitute( "&1&2&3"
     1369                                     , "Неверно задан каталог экспорта (exch).":u
     1370                                     , chr(10)
     1371                                     , "Обратитесь к администратору.":u
     1372                                     ).
     1373     end.
     1374     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1375     if v-bge-xml-heap-dir = ?
     1376     then do:
     1377       undo, return error substitute( "&1&2&3"
     1378                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1379                                     , chr(10)
     1380                                     , "Обратитесь к администратору.":u
     1381                                     ).
     1382     end.
     1383     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1384     if error-status :error
     1385     then do:
     1386       undo, return error substitute( "&1&2&3"
     1387                                     , "Неверно задан каталог экспорта (heap).":u
     1388                                     , chr(10)
     1389                                     , "Обратитесь к администратору.":u
     1390                                     ).
     1391     end.
     1392     get-key-value section "BGE" key "heap-compress" value v-str.
     1393     assign
     1394       v-i = int(v-str)
     1395     no-error .
     1396     if v-i = ? or v-i = 0
     1397     then do:
     1398       assign
     1399         v-bge-xml-compress-heap = no
     1400       .
     1401     end.
     1402     else do:
     1403       assign
     1404         v-bge-xml-compress-heap = yes
     1405       .
     1406     end.
     1407     assign
     1408       v-arc = search( "exe/7za.exe":u )
     1409     .
     1410     if v-arc = ? or v-arc = ""
     1411     then do:
     1412       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1413     end.
     1414     assign
     1415       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1416       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1417       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1418       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1419       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1420       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1421       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1422     .
     1423     run gbl/del-file.p (input v-tmp-file-name) .
     1424     run gbl/del-file.p (input v-zip-file-name) .
     1425     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1426     if v-error-num > 0
     1427     then do:
     1428         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1429                                      , p-xml-file-name + "xm1":u
     1430                                      , v-tmp-file-name
     1431                                      , v-error-num
     1432                                      ).
     1433     end.
     1434     assign
     1435       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1436                                    , v-arc
     1437                                    , v-zip-file-name
     1438                                    , v-tmp-file-name
     1439                                    )
     1440     .
     1441     os-command silent value ( v-os-command ) .
     1442     run gbl/del-file.p (input v-heap-file-name) .
     1443     if v-bge-xml-compress-heap = no
     1444     then do:
     1445       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1446       if v-error-num > 0
     1447       then do:
     1448           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1449                                        , v-tmp-file-name
     1450                                        , v-heap-file-name
     1451                                        , v-error-num
     1452                                        ) .
     1453       end.
     1454     end.
     1455     else do:
     1456       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1457       if v-error-num > 0
     1458       then do:
     1459           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1460                                        , v-zip-file-name
     1461                                        , v-heap-file-name
     1462                                        , v-error-num
     1463                                        ) .
     1464       end.
     1465     end.
     1466     run gbl/del-file.p (input v-tmp-file-name) .
     1467     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1468     if error-status :error then do:
     1469       undo, return error substitute( "&1&2&3"
     1470                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1471                                     , chr(10)
     1472                                     , "Обратитесь к администратору."
     1473                                     ).
     1474     end.
     1475     run gbl/del-file.p (input v-exch-file-name) .
     1476     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1477     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1478     if v-error-num > 0
     1479     then do:
     1480       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1481                                     , v-zip-file-name
     1482                                     , v-exch-tmp-file-name
     1483                                     , v-error-num
     1484                                     ) .
     1485     end.
     1486     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1487     if v-error-num > 0
     1488     then do:
     1489       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1490                                     , v-exch-tmp-file-name
     1491                                     , v-exch-file-name
     1492                                     , v-error-num
     1493                                     ) .
     1494     end.
     1495     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1496   end.
     1497   else do:
     1498     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1499     if v-error-num > 0
     1500     then do:
     1501       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1502                                     , p-xml-file-name + "xm1"
     1503                                     , p-xml-file-name + "xml"
     1504                                     , v-error-num
     1505                                     ) .
     1506     end.
     1507   end.
     1508   if opsys = "unix"
     1509   then do:
     1510       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1511   end.
     1512   end.
     1513   end procedure.
     1514   procedure xml-bge-filename0:
     1515   define input parameter p-prefix   as character no-undo .
     1516   define input parameter p-name     as character no-undo .
     1517   define input parameter p-shared-process as logical no-undo .
     1518   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1519   define output parameter p-xml-file-name  as character no-undo .
     1520   // define output parameter p-fullfnamenoext as character no-undo .
     1521   define output parameter p-locked         as logical      no-undo.
     1522   define variable v-fullfnamenoext as character no-undo .
     1523   define variable v-fileext        as character no-undo .
     1524   define variable v-fullfname      as character no-undo .
     1525   define variable v-error-num      as integer   no-undo .
     1526   do
     1527   on error undo, return error
     1528   :
     1529     case v-bge-xml-bgeflold :
     1530       when "old" then do:
     1531         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1532         v-fileext       = ".xml":U .
     1533         v-fullfname     = v-fullfnamenoext + v-fileext .
     1534         p-xml-file-name = v-fullfname .
     1535         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1536         if v-error-num > 0 then do:
     1537           return error.
     1538         end.
     1539       end.
     1540       when "var" then do:
     1541         case p-prefix :
     1542           when "doc" then do:
     1543             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1544             v-fileext       = ".xml":U .
     1545             v-fullfname     = v-fullfnamenoext + v-fileext .
     1546             p-xml-file-name = v-fullfname .
     1547           end.
     1548           when "day" then do:
     1549             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1550             v-fileext       = ".xml":U .
     1551             v-fullfname     = v-fullfnamenoext + v-fileext .
     1552             p-xml-file-name = v-fullfname .
     1553           end.
     1554           otherwise do:
     1555             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1556             v-fileext       = ".xml":U .
     1557             v-fullfname     = v-fullfnamenoext + v-fileext .
     1558             p-xml-file-name = v-fullfname .
     1559           end.
     1560         end case.
     1561         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1562         if v-error-num > 0 then do:
     1563           return error.
     1564         end.
     1565       end.
     1566       when "new" then do:
     1567                   run bge/genfname.p (
     1568                       input p-home-dir
     1569                       , input p-prefix
     1570                       , input ""
     1571                       , input "xml"
     1572                       , input ""
     1573                       , output p-xml-file-name
     1574                   ).
     1575       end.
     1576       when "no-parameter" then do:
     1577         if p-shared-process then do:
     1578                       run bge/genfname.p (
     1579                           input p-home-dir
     1580                           , input "d"
     1581                           , input ""
     1582                           , input "xml"
     1583                           , input ""
     1584                           , output p-xml-file-name
     1585                       ).
     1586         end.
     1587         else do:
     1588           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1589           v-fileext       = ".xml":U .
     1590           v-fullfname     = v-fullfnamenoext + v-fileext .
     1591           p-xml-file-name = v-fullfname .
     1592           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1593           if v-error-num > 0 then do:
     1594             return error.
     1595           end.
     1596         end.
     1597       end.
     1598     end case.
     1599     assign
     1600       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1601       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1602     .
     1603   end .
     1604   end procedure .
     1605   procedure xml-bge-filename :
     1606   do
     1607   on error undo, return error
     1608   :
     1609   define input parameter p-prefix             as character    no-undo.
     1610   define input parameter p-name               as character    no-undo.
     1611   define input parameter p-shared-process     as logical      no-undo.
     1612   define output parameter p-xml-file-name     as character    no-undo.
     1613   define output parameter p-log-file-name     as character    no-undo.
     1614   define output parameter p-locked            as logical      no-undo.
     1615   define variable v-home-dir          as character no-undo .
     1616   define variable v-error-num         as integer   no-undo .
     1617   define variable v-bge-xml-heap-dir  as character no-undo .
     1618       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1619       if v-home-dir = ?
     1620       then do:
     1621           message
     1622             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1623             skip(1)
     1624             skip "Обратитесь к администратору."
     1625           view-as alert-box error.
     1626           undo, return error .
     1627       end.
     1628       if v-bge-xml-bgeflold <> "oracle"
     1629       then do:
     1630         assign
     1631             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1632         .
     1633       end.
     1634       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1635       if error-status :error
     1636       then do:
     1637           message
     1638             skip "Неверно задан каталог экспорта."
     1639             skip(1)
     1640             skip "Обратитесь к администратору."
     1641           view-as alert-box error.
     1642           undo, return error .
     1643       end.
     1644       if v-bge-xml-bgefmt = "dbf":U
     1645       then do:
     1646           assign
     1647               p-xml-file-name = v-home-dir
     1648               p-locked        = no
     1649           .
     1650       end.
     1651       else do:
     1652           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1653             output p-xml-file-name, output p-locked) .
     1654       end.
     1655       if v-bge-xml-bgeflold = "oracle"
     1656       then do:
     1657         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1658         if v-bge-xml-heap-dir = ?
     1659         then do:
     1660           undo, return error substitute( "&1&2&3"
     1661                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1662                                         , chr(10)
     1663                                         , "Обратитесь к администратору.":u
     1664                                         ).
     1665         end.
     1666         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1667         if error-status :error
     1668         then do:
     1669           undo, return error substitute( "&1&2&3"
     1670                                         , "Неверно задан каталог экспорта (heap).":u
     1671                                         , chr(10)
     1672                                         , "Обратитесь к администратору.":u
     1673                                         ).
     1674         end.
     1675         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1676           assign
     1677             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1678           .
     1679         end.
     1680         else do:
     1681           assign
     1682             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1683           .
     1684         end.
     1685       end.
     1686       else do:
     1687         assign
     1688             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1689         .
     1690       end.
     1691       assign
     1692          v-bge-xml-static-log-file-name = p-log-file-name
     1693       .
     1694   end.
     1695   end procedure.
     1696   procedure bge-xml-read-config :
     1697   do
     1698   on error undo, return error return-value
     1699   :
     1700   define input  parameter p-last-date as date      no-undo .
     1701   define input  parameter p-db-num    as integer   no-undo .
     1702       define variable v-bgeclall      as character     no-undo.
     1703       define variable v-bgedict       as character     no-undo.
     1704       define variable v-bgeshift      as character     no-undo.
     1705       define variable v-par-type      as character     no-undo.
     1706       define variable v-bgeflnm       as character     no-undo.
     1707       define variable v-bgecliiv      as character     no-undo .
     1708       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1709       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1710       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1711       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1712       define variable v-db-num-str    as character     no-undo .
     1713       define variable v-param-type      as character  no-undo .
     1714       define variable v-value-character as character  no-undo .
     1715       define variable v-value-date      as date       no-undo .
     1716       define variable v-value-decimal   as decimal    no-undo .
     1717       define variable v-value-integer   as integer    no-undo .
     1718       define variable v-value-logical   as logical    no-undo .
     1719       define variable v-tth             as handle      no-undo .
     1720       run adm/shattri.p ( input "get":U
     1721                         , input  '':u
     1722                         , input  0
     1723                         , input  'bge-export':U
     1724                         , input  'bgeclall':U
     1725                         , output v-bgecliiv
     1726                         , output v-value-date
     1727                         , output v-value-decimal
     1728                         , output v-value-integer
     1729                         , output v-value-logical
     1730                         , output v-param-type
     1731                         , input-output table-handle v-tth
     1732                         ) no-error .
     1733       if error-status :error
     1734       then do:
     1735         assign
     1736           v-bge-xml-bgecliiv = no
     1737         .
     1738       end.
     1739       else do:
     1740         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1741       end.
     1742       delete object v-tth.
     1743       assign
     1744           v-bge-xml-bgeclall = no
     1745           v-bge-xml-bgedict  = no
     1746       .
     1747       run adm/shattri.p ( input "get":U
     1748                         , input  '':u
     1749                         , input  0
     1750                         , input  'bge-export':U
     1751                         , input  'bgeclall':U
     1752                         , output v-value-character
     1753                         , output v-value-date
     1754                         , output v-value-decimal
     1755                         , output v-value-integer
     1756                         , output v-value-logical
     1757                         , output v-param-type
     1758                         , input-output table-handle v-tth
     1759                         ) no-error .
     1760       if error-status :error
     1761       then do:
     1762         assign
     1763           v-bge-xml-bgeclall = no
     1764         .
     1765       end.
     1766       else do:
     1767         assign
     1768           v-bge-xml-bgeclall = v-value-logical
     1769         .
     1770       end.
     1771       delete object v-tth.
     1772       run adm/shattri.p ( input "get":U
     1773                         , input  '':u
     1774                         , input  0
     1775                         , input  'bge-export':U
     1776                         , input  'bgedict':U
     1777                         , output v-value-character
     1778                         , output v-value-date
     1779                         , output v-value-decimal
     1780                         , output v-value-integer
     1781                         , output v-value-logical
     1782                         , output v-param-type
     1783                         , input-output table-handle v-tth
     1784                         ) no-error .
     1785       if error-status :error
     1786       then do:
     1787         assign
     1788           v-bge-xml-bgedict = no
     1789         .
     1790       end.
     1791       else do:
     1792         assign
     1793           v-bge-xml-bgedict = v-value-logical
     1794         .
     1795       end.
     1796       delete object v-tth.
     1797       run adm/shattri.p ( input "get":U
     1798                         , input  '':u
     1799                         , input  0
     1800                         , input  'bge-export':U
     1801                         , input  'bgefmt':U
     1802                         , output v-value-character
     1803                         , output v-value-date
     1804                         , output v-value-decimal
     1805                         , output v-value-integer
     1806                         , output v-value-logical
     1807                         , output v-param-type
     1808                         , input-output table-handle v-tth
     1809                         ) no-error .
     1810       if error-status :error
     1811       then do:
     1812         assign
     1813           v-bge-xml-bgefmt  = "xml":U
     1814         .
     1815       end.
     1816       else do:
     1817         assign
     1818           v-bge-xml-bgefmt  = v-value-character
     1819         .
     1820       end.
     1821       delete object v-tth.
     1822       run adm/shattri.p ( input "get":U
     1823                         , input  '':u
     1824                         , input  0
     1825                         , input  'bge-export':U
     1826                         , input  'bgeshift':U
     1827                         , output v-value-character
     1828                         , output v-value-date
     1829                         , output v-value-decimal
     1830                         , output v-value-integer
     1831                         , output v-value-logical
     1832                         , output v-param-type
     1833                         , input-output table-handle v-tth
     1834                         ) no-error .
     1835       if error-status :error
     1836       then do:
     1837         assign
     1838             v-bge-xml-shift-mode = no
     1839         .
     1840       end.
     1841       else do:
     1842         assign
     1843             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1844         .
     1845       end.
     1846       delete object v-tth.
     1847       run adm/shattri.p ( input "get":U
     1848                         , input  '':u
     1849                         , input  0
     1850                         , input  'bge-export':U
     1851                         , input  'bgeflold':U
     1852                         , output v-value-character
     1853                         , output v-value-date
     1854                         , output v-value-decimal
     1855                         , output v-value-integer
     1856                         , output v-value-logical
     1857                         , output v-param-type
     1858                         , input-output table-handle v-tth
     1859                         ) no-error .
     1860       if error-status :error
     1861       then do:
     1862         assign
     1863           v-bge-xml-bgeflold = "no-parameter":U
     1864         .
     1865       end.
     1866       else do:
     1867         assign
     1868           v-bge-xml-bgeflold  = v-value-character
     1869         .
     1870       end.
     1871       delete object v-tth.
     1872       assign
     1873         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1874         v-bge-xml-db-num-str  = v-db-num-str
     1875       .
     1876       if p-last-date <> ?
     1877       then do:
     1878           run adm/shattri.p ( input "get":U
     1879                             , input  '':u
     1880                             , input  0
     1881                             , input  'bge-export':U
     1882                             , input  'bgeflnm':U
     1883                             , output v-value-character
     1884                             , output v-value-date
     1885                             , output v-value-decimal
     1886                             , output v-value-integer
     1887                             , output v-value-logical
     1888                             , output v-param-type
     1889                             , input-output table-handle v-tth
     1890                             ) no-error .
     1891           if error-status :error
     1892           then do:
     1893             assign
     1894               v-bgeflnm = '':U
     1895             .
     1896           end.
     1897           else do:
     1898             assign
     1899               v-bgeflnm = v-value-character
     1900             .
     1901           end.
     1902           delete object v-tth.
     1903           if v-bge-xml-bgeflold = "var"
     1904           then do:
     1905               if v-bgeflnm = ?
     1906               or num-entries( v-bgeflnm ) < 2
     1907               then do:
     1908                   assign
     1909                       v-bge-xml-bgeflold = "new"
     1910                   .
     1911               end.
     1912               else do:
     1913                   assign
     1914                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1915                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1916                   .
     1917                   assign
     1918                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1919                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1920                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1921                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1922                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1923                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1924                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1925                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1926                   .
     1927               end.
     1928           end.
     1929       end.
     1930   end.
     1931   end procedure.
     1932   procedure bge-xml-get-ref-filename :
     1933   define input parameter p-in-file-name       as character        no-undo.
     1934   define output parameter p-home-dir          as character        no-undo.
     1935   define output parameter p-out-file-name     as character        no-undo.
     1936   define output parameter p-locked            as logical          no-undo.
     1937       define variable v-counter       as integer      no-undo.
     1938       define variable v-error-level   as integer      no-undo.
     1939   do
     1940   on error undo, return error
     1941   :
     1942       run bge/bge-ini.p (
     1943             input "bge"
     1944           , output p-home-dir
     1945       ).
     1946       if return-value <> "OK"
     1947       then do:
     1948           undo, return error.
     1949       end.
     1950       assign
     1951           p-home-dir = p-home-dir + "\dict":U
     1952       .
     1953       run bge/dir_cd.p (
     1954           input p-home-dir
     1955           , input "CA"
     1956       ).
     1957       if return-value = "ERROR"
     1958       then do:
     1959           undo, return error.
     1960       end.
     1961       assign
     1962           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     1963       .
     1964       assign
     1965           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     1966       .
     1967       wait-lock:
     1968       do v-counter = 1 TO 3
     1969       :
     1970           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     1971           if p-locked = no
     1972           then do:
     1973               leave wait-lock.
     1974           end.
     1975           else do:
     1976               readkey pause 1.
     1977           end.
     1978       END.
     1979       if p-locked = yes
     1980       then do:
     1981           undo, return error.
     1982       end.
     1983       run bge/os_copy.p (
     1984             input "D":U
     1985           , input p-out-file-name + "xml":U
     1986           , input "":U
     1987           , output v-error-level
     1988       ).
     1989       if v-error-level > 0
     1990       then do:
     1991           undo, return error.
     1992       end.
     1993   end.
     1994   end procedure.
     1995   procedure bge-xml-write-ref-header :
     1996   define input parameter p-bge-name as character        no-undo.
     1997   define input parameter p-file-name as character        no-undo.
     1998       define variable v-out-string    as character    no-undo.
     1999   do
     2000   on error undo, return error
     2001   :
     2002       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2003       put stream stmXMLOut unformatted
     2004           "<?xml version='1.0' encoding='windows-1251'?>":U
     2005       .
     2006       assign
     2007           v-out-string = substitute( "&1&2"
     2008                               , chr(10)
     2009                               , "<IBS_Trade_House>":U )
     2010       .
     2011       put stream stmXMLOut unformatted
     2012           v-out-string
     2013       .
     2014       run wp-XMLTagOpen( 1, "header", "" ).
     2015       if v-bge-xml-bgeflold = "oracle":u
     2016       then do:
     2017         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2018         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2019         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2020         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2021         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2022       end.
     2023       else do:
     2024         run wp-XMLTagOpen( 2, "delivery", "" ).
     2025         run wp-XMLTagOpen( 3, "to", "" ).
     2026         run wp-XMLTagClose( 3, "to" ).
     2027         run wp-XMLTagOpen( 3, "from", "" ).
     2028         run wp-XMLTagClose( 3, "from" ).
     2029         run wp-XMLTagClose( 2, "delivery" ).
     2030       end.
     2031       run wp-XMLTagOpen( 2, "manifest", "" ).
     2032       run wp-XMLTagOpen( 3, "document", "" ).
     2033       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2034       run wp-XMLTagPut( 4, "description", "", 0 ).
     2035       run wp-XMLTagClose( 3, "document" ).
     2036       run wp-XMLTagClose( 2, "manifest" ).
     2037       run wp-XMLTagClose( 1, "header" ).
     2038       run wp-XMLTagOpen( 1, "body", "" ).
     2039   end.
     2040   end procedure.
     2041   procedure bge-xml-write-ref-footer :
     2042   define input parameter p-file-name as character        no-undo.
     2043       define variable v-error-level   as integer      no-undo.
     2044   do
     2045   on error undo, return error
     2046   :
     2047       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2048       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2049       output stream stmXMLOut close.
     2050       run bge/os_copy.p (
     2051             input "M":U
     2052           , input p-file-name + "xm1":U
     2053           , input p-file-name + "xml":U
     2054           , output v-error-level
     2055       ).
     2056       if v-error-level > 0
     2057       then do:
     2058           undo, return error.
     2059       end.
     2060   end.
     2061   end procedure.
     2062   procedure bge-xml-out-dir :
     2063   define output parameter p-out-dir       as character    no-undo.
     2064   define output parameter p-log-file-name as character    no-undo.
     2065   do
     2066   on error undo, return error
     2067   :
     2068       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2069       if p-out-dir = ?
     2070       then do:
     2071           message
     2072             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2073                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2074             skip(1)
     2075             skip "Обратитесь к администратору."
     2076           view-as alert-box error.
     2077           undo, return error .
     2078       end.
     2079       if v-bge-xml-bgeflold <> "oracle" then assign
     2080         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2081       .
     2082       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2083       if error-status :error  then do:
     2084           run wp-XMLWriteLog in this-procedure (
     2085                 input p-log-file-name
     2086               , input 0
     2087               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2088                                   , p-out-dir
     2089                                   , return-value
     2090                                   , trim( error-status :get-message( 1 ) )
     2091                                   )
     2092           ).
     2093           undo, return error.
     2094       end.
     2095       assign
     2096           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2097           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2098       .
     2099   end.
     2100   end procedure.
     2101   procedure bge-xml-out-dir2 :
     2102   define output parameter p-out-dir       as character    no-undo.
     2103   define output parameter p-out-dirR      as character    no-undo.
     2104   define output parameter p-log-file-name as character    no-undo.
     2105   do
     2106   on error undo, return error
     2107   :
     2108       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2109       if p-out-dir = ?
     2110       then do:
     2111           message
     2112             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2113                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2114             skip(1)
     2115             skip "Обратитесь к администратору."
     2116           view-as alert-box error.
     2117           undo, return error .
     2118       end.
     2119       if v-bge-xml-bgeflold <> "oracle" then assign
     2120             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2121             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2122         .
     2123       else p-out-dirR = p-out-dir .
     2124       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2125       if error-status :error  then do:
     2126           run wp-XMLWriteLog in this-procedure (
     2127                 input p-log-file-name
     2128               , input 0
     2129               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2130                                   , p-out-dir
     2131                                   , return-value
     2132                                   , error-status :get-message( 1 )
     2133                                   )
     2134           ).
     2135           undo, return error.
     2136       end.
     2137       if p-out-dirR <> p-out-dir then do:
     2138         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2139         if error-status :error then do:
     2140           run wp-XMLWriteLog in this-procedure (
     2141                 input p-log-file-name
     2142               , input 0
     2143               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2144                                   , p-out-dirR
     2145                                   , return-value
     2146                                   , error-status :get-message( 1 )
     2147                                   )
     2148           ).
     2149           p-out-dirR = p-out-dir .
     2150         end.
     2151       end .
     2152       assign
     2153         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2154         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2155       .
     2156   end.
     2157   end procedure.
     2158   procedure bge-xml-out-file :
     2159   do
     2160   on error undo, return error
     2161   :
     2162   define input parameter p-out-dir            as character        no-undo.
     2163   define input parameter p-prefix             as character        no-undo.
     2164   define input parameter p-sheduled           as logical          no-undo.
     2165   define output parameter p-xml-file-name     as character        no-undo.
     2166   define output parameter p-locked            as logical          no-undo.
     2167   define variable v-home-dir      as character     no-undo.
     2168   define variable v-error-num     as integer       no-undo.
     2169   define variable v-today             as date         no-undo.
     2170   define variable v-time              as integer      no-undo.
     2171       if v-bge-xml-bgefmt = "dbf":U
     2172       then do:
     2173           assign
     2174               p-xml-file-name = p-out-dir
     2175               p-locked        = no
     2176           .
     2177       end.
     2178       else do:
     2179           if v-bge-xml-bgeflold = "firm":U
     2180           then do:
     2181               run bge/genfname.p (
     2182                     input p-out-dir
     2183                   , input p-prefix
     2184                   , input "":U
     2185                   , input "arj":U
     2186                   , input "":U
     2187                   , output p-xml-file-name
     2188               ).
     2189           end.
     2190           else do:
     2191               run bge/genfname.p (
     2192                     input p-out-dir
     2193                   , input p-prefix
     2194                   , input "":U
     2195                   , input "xml":U
     2196                   , input "":U
     2197                   , output p-xml-file-name
     2198               ).
     2199           end.
     2200           assign
     2201               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2202               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2203           .
     2204       end.
     2205   end.
     2206   end procedure.
     2207   procedure bge-xml-init-ext-doc-type :
     2208       define variable v-counter    as integer      no-undo.
     2209       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2210   do
     2211   for buf_temp_ext-doc-type
     2212   on error undo, return error
     2213   :
     2214       empty temp-table buf_temp_ext-doc-type.
     2215       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2216       :
     2217           create buf_temp_ext-doc-type.
     2218           assign
     2219               buf_temp_ext-doc-type.edt-key               = v-counter
     2220               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2221               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2222           .
     2223       end.
     2224   end.
     2225   end procedure.
     2226   procedure bge-xml-get-decimal-shift-num :
     2227   define input parameter p-shift-date     as date             no-undo.
     2228   define input parameter p-shift-num      as integer          no-undo.
     2229   define output parameter p-shift-decimal as decimal          no-undo.
     2230   do
     2231   on error undo, return error
     2232   :
     2233       assign
     2234           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2235       .
     2236   end.
     2237   end procedure.
     2238   procedure bge-xml-ora-exp-filename :
     2239     define input  parameter p-table-name  as character no-undo .
     2240     define input  parameter p-doc-code    as character no-undo .
     2241     define input  parameter p-obj-code    as integer   no-undo .
     2242     define output parameter p-filename    as character no-undo .
     2243     define output parameter p-seq-num     as integer   no-undo .
     2244     define variable v-ora-exp-seq     as integer   no-undo .
     2245     define variable v-ora-exp-seq-str as character no-undo .
     2246     define variable v-home-dir        as character no-undo.
     2247   do
     2248   on error undo, return error return-value
     2249   :
     2250     if v-bge-xml-bgeflold = "oracle":u
     2251     then do:
     2252       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2253       if v-home-dir = ?
     2254       then do:
     2255         undo, return error substitute( "&1&2&3":U
     2256                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2257                                       , chr(10)
     2258                                       , "Обратитесь к администратору.":U
     2259                                       ).
     2260       end.
     2261       assign
     2262           v-home-dir = v-home-dir
     2263       .
     2264       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2265       if error-status :error
     2266       then do:
     2267         undo, return error substitute( "&1&2&3":U
     2268                                       , "Неверно задан каталог экспорта.":U
     2269                                       , chr(10)
     2270                                       , "Обратитесь к администратору.":U
     2271                                       ).
     2272       end.
     2273       assign
     2274         v-ora-exp-seq = ?
     2275       .
     2276       if  p-table-name <> ? and
     2277           p-doc-code <> ?
     2278       then do:
     2279         run bge/get-oesq.p ( input p-table-name
     2280                            , input p-doc-code
     2281                            , output v-ora-exp-seq
     2282                            ) no-error .
     2283         if error-status :error = yes
     2284         then do:
     2285           undo, return error return-value .
     2286         end.
     2287       end.
     2288       if v-ora-exp-seq = ?
     2289       then do:
     2290         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2291         if error-status :error
     2292         then do:
     2293           undo, return error return-value .
     2294         end.
     2295       end.
     2296       if p-table-name <> ? and
     2297          p-doc-code   <> ?
     2298       then do:
     2299         run bge/oesqdoc.p ( input p-table-name
     2300                           , input p-doc-code
     2301                           , input v-ora-exp-seq
     2302                           ) no-error .
     2303         if error-status :error = yes
     2304         then do:
     2305           undo, return error return-value .
     2306         end.
     2307       end.
     2308       assign
     2309         p-seq-num  = v-ora-exp-seq
     2310         p-filename = substitute("&1/&2-000_&3."
     2311                                , v-home-dir
     2312                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2313                                , string(v-ora-exp-seq , "999999999")
     2314                                )
     2315       .
     2316     end.
     2317   end.
     2318   end procedure.
     2319   procedure bge-xml-date-to-str :
     2320     define input  parameter p-date  as date      no-undo .
     2321     define output parameter p-str   as character no-undo .
     2322   do
     2323   on error undo, return error return-value
     2324   :
     2325     if p-date <> ?
     2326     then do:
     2327       assign
     2328         p-str = substitute( "&1-&2-&3"
     2329                           , string( year(p-date)  , "9999")
     2330                           , string( month(p-date) , "99"  )
     2331                           , string( day(p-date)   , "99"  )
     2332                           )
     2333       .
     2334     end.
     2335     else do:
     2336       assign
     2337         p-str = ?
     2338       .
     2339     end.
     2340   end.
     2341   end procedure.
     2342   procedure bge-xml-date-str-to-str :
     2343     define input  parameter p-date-str  as character no-undo .
     2344     define output parameter p-str       as character no-undo .
     2345     define variable v-date          as date      no-undo .
     2346     define variable v-date-valid    as logical   no-undo .
     2347     define variable v-error-message as character no-undo .
     2348   do
     2349   on error undo, return error return-value
     2350   :
     2351     assign
     2352       p-str = ?
     2353     .
     2354     if p-date-str = ? or p-date-str = ""
     2355     then do:
     2356       return .
     2357     end.
     2358     run strtdate in this-procedure ( input  p-date-str
     2359                                    , output v-date
     2360                                    , output v-date-valid
     2361                                    , output v-error-message
     2362                                    ).
     2363     if v-date-valid <> true
     2364     then do:
     2365       return .
     2366     end.
     2367     assign
     2368       p-str = substitute( "&1-&2-&3"
     2369                         , string( year(v-date)  , "9999")
     2370                         , string( month(v-date) , "99"  )
     2371                         , string( day(v-date)   , "99"  )
     2372                         )
     2373     .
     2374   end.
     2375   end procedure.
     2376   procedure bge-xml-fill-tt-bgecliiv :
     2377     define input  parameter p-str as character no-undo .
     2378     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2379     define buffer buf_clients             for ub.clients.
     2380     define variable v-i         as integer   no-undo .
     2381     define variable v-count     as integer   no-undo .
     2382     define variable v-cli-count as integer   no-undo .
     2383     define variable v-client    as character no-undo .
     2384     define variable v-obj-type  as character no-undo .
     2385     define variable v-obj-code  as integer   no-undo .
     2386   do
     2387   on error undo, return error return-value
     2388   :
     2389     empty temp-table buf_tt-bge-xml-bgecliiv.
     2390     assign
     2391       v-bge-xml-bgecliiv = no
     2392       v-cli-count        = num-entries(p-str,';')
     2393     .
     2394     if v-cli-count > 0
     2395     then do:
     2396       _cli-cycle:
     2397       do v-i = 1 to v-cli-count
     2398       :
     2399         assign
     2400           v-client = entry(v-i , p-str, ';')
     2401         .
     2402         if num-entries(v-client) <> 2
     2403         then do:
     2404           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2405         end.
     2406         assign
     2407           v-obj-type = entry(1, v-client)
     2408         .
     2409         assign
     2410           v-obj-code = integer(entry(2, v-client))
     2411         no-error .
     2412         if error-status :error
     2413         then do:
     2414           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2415         end.
     2416         find first buf_clients no-lock
     2417           where buf_clients.obj-type = v-obj-type
     2418             and buf_clients.obj-code = v-obj-code
     2419         no-error.
     2420         if not available buf_clients
     2421         then do:
     2422           next _cli-cycle.
     2423         end.
     2424         find first buf_tt-bge-xml-bgecliiv no-lock
     2425           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2426             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2427         no-error .
     2428         if available buf_tt-bge-xml-bgecliiv
     2429         then do:
     2430           next _cli-cycle.
     2431         end.
     2432         create buf_tt-bge-xml-bgecliiv.
     2433         assign
     2434           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2435           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2436         .
     2437       end.
     2438     end.
     2439     else do:
     2440       assign
     2441         v-bge-xml-bgecliiv = no
     2442       .
     2443       return .
     2444     end.
     2445     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2446     if available buf_tt-bge-xml-bgecliiv
     2447     then do:
     2448       assign
     2449         v-bge-xml-bgecliiv = yes
     2450       .
     2451     end.
     2452   end.
     2453   end procedure.
     2454   procedure bge-xml-resolve-ext-doc-type :
     2455     define input  parameter p-ext-doc-type      as character no-undo .
     2456     define input  parameter p-obj-type          as character no-undo .
     2457     define input  parameter p-obj-code          as integer   no-undo .
     2458     define output parameter p-out-ext-doc-type  as character no-undo .
     2459     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2460   do
     2461   on error undo, return error return-value
     2462   :
     2463     assign
     2464       p-out-ext-doc-type = p-ext-doc-type
     2465     .
     2466     if p-ext-doc-type <> 'ie':U
     2467     then do:
     2468       return .
     2469     end.
     2470     if v-bge-xml-bgecliiv = yes
     2471     then do:
     2472       find first buf_tt-bge-xml-bgecliiv no-lock
     2473         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2474           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2475       no-error .
     2476       if available buf_tt-bge-xml-bgecliiv
     2477       then do:
     2478         assign
     2479           p-out-ext-doc-type = 'iv':U
     2480         .
     2481       end.
     2482     end.
     2483   end.
     2484   end procedure.
     2485   procedure safe-wp-xmltagput :
     2486     define input  parameter pTagLevel   as integer   no-undo .
     2487     define input  parameter pTagName    as character no-undo .
     2488     define input  parameter pParValue   as character no-undo .
     2489     define input  parameter pFlagEmpty  as integer   no-undo .
     2490   do
     2491   on error undo, return error return-value
     2492   :
     2493     if v-bge-xml-bgeflold = "oracle":u
     2494     then do:
     2495       return .
     2496     end.
     2497     run wp-xmltagput in this-procedure ( input pTagLevel
     2498                                        , input pTagName
     2499                                        , input pParValue
     2500                                        , input pFlagEmpty
     2501                                        ).
     2502   end.
     2503   end procedure.
