     8975                                 if last-of( treal-4.curr-code ) then do:
     8976                                     if v-found-paycard then do:
     8977                                     run wp-xmltagclose( 6, "payCards" ).
     8978                                     end.
     8979                                     if v-found-paycode then do:
     8980                                     run wp-xmltagclose( 5, "payCode" ).
     8981                                     end.
     8982                                 end.
     8983                              end.
     8984                           end.
     8985                       end.
     8986                   end case.
     8987               end.
     8988               run wp-xmltagclose( 4, "goodPayCode" ).
     8989           end.
     8990       end.
     8991   end.
     8992   end procedure.
     8993   procedure get-base-code-okv :
     8994   define input parameter p-base-code          as integer          no-undo.
     8995   define output parameter p-base-code-okv     as integer          no-undo.
     8996       define buffer buf_currency      for ub.currency.
     8997   do
     8998   for buf_currency
     8999   on error undo, return error
     9000   :
     9001       find first buf_currency no-lock
     9002            where buf_currency.curr-code = p-base-code
     9003       .
     9004       assign
     9005           p-base-code-okv = buf_currency.okv-code
     9006       .
     9007   end.
     9008   end procedure.
     9009   procedure export-bc-price :
     9010     define input  parameter p-obj-type  as character no-undo .
     9011     define input  parameter p-obj-code  as integer   no-undo .
     9012     define input  parameter p-doc-code  as character no-undo .
     9013     define input  parameter p-b-code    as integer   no-undo .
     9014     define buffer base-bar-code             for ub.bar-code.
     9015     define buffer buf_bar-code              for ub.bar-code.
     9016     define buffer buf_units                 for ub.units.
     9017     define buffer buf_price-list            for ub.price-list.
     9018     define variable v-doc-num     as character          no-undo .
     9019     define variable v-price-sale  as decimal            no-undo .
     9020     define variable v-road-tax    as decimal            no-undo .
     9021     define variable v-excise      as decimal            no-undo .
     9022   do for base-bar-code
     9023        , buf_bar-code
     9024        , buf_units
     9025        , buf_price-list
     9026   on error undo, return error return-value
     9027   :
     9028     find base-bar-code no-lock
     9029       where base-bar-code.b-code = p-b-code
     9030     no-error .
     9031     if not available base-bar-code
     9032     then do:
     9033       return .
     9034     end.
     9035     bc-cycle:
     9036     for each buf_price-list no-lock
     9037       where  buf_price-list.doc-num     = p-doc-code
     9038         and  buf_price-list.price-type  = ''
     9039       , each buf_bar-code no-lock
     9040       where buf_bar-code.b-code    = buf_price-list.b-code
     9041         and buf_bar-code.gds-code  = base-bar-code.gds-code
     9042         and buf_bar-code.node-code = base-bar-code.node-code
     9043         and buf_bar-code.part-code = base-bar-code.part-code
     9044         and buf_bar-code.in-code   = base-bar-code.in-code
     9045     :
     9046       assign
     9047         v-price-sale = buf_price-list.price-sale
     9048       .
     9049       run wp-xmltagopen in this-procedure ( input 4, input "bcPrice", input "" ).
     9050       run wp-xmltagput( 5, "bCode"      , string( buf_bar-code.b-code         ), 0 ).
     9051       run wp-xmltagput( 5, "unitCli"    , string( buf_bar-code.unit-cli       ), 0 ).
     9052       run wp-xmltagput( 5, "cliBaseRate", string( buf_bar-code.cli-base-rate  ), 0 ).
     9053       run wp-xmltagput( 5, "priceSale"  , string( v-price-sale                ), 0 ).
     9054       run wp-xmltagclose in this-procedure ( input 4, input "bcPrice" ).
     9055     end.
     9056   end.
     9057   end procedure.
     9058   procedure calc-lines :
     9059   do
     9060   on error undo, return error
     9061   :
     9062     define input parameter  p-doc-code      as character        no-undo.
     9063     define output parameter p-sum-all-parts as decimal          no-undo.
     9064     DEFINE BUFFER t-doc FOR trn-doc.
     9065     define variable p-fact-qnty             as decimal          no-undo.
     9066     find first t-doc no-lock
     9067          where t-doc.doc-code   = p-doc-code
     9068          no-error.
     9069     if avail t-doc then
     9070          ASSIGN
     9071          p-sum-all-parts = vat-rubl .
     9072   end .
     9073   end procedure.
