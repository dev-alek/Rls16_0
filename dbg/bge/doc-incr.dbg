     5673                                                                   , trim(error-status :get-message(2))
     5674                                                                   )
     5675                                                 ).
     5676         end.
     5677       end.
     5678       empty temp-table buf_tt-docs.
     5679   end.
     5680   end procedure.
     5681   procedure export-from-archive :
     5682   define input parameter p-ext-doc-type           as character        no-undo.
     5683   define input parameter p-doc-code               as character        no-undo.
     5684   define input parameter p-doc-date               as date             no-undo.
     5685   define input parameter p-fact-date              as date             no-undo.
     5686   define input parameter p-reason-code            as integer          no-undo.
     5687   define input parameter p-doc-PS                 as character        no-undo.
     5688   define input parameter p-fact-order             as decimal          no-undo.
     5689   define input parameter p-sys-date               as date             no-undo.
     5690   define input parameter p-sys-time               as character        no-undo.
     5691   define input parameter p-firm-code              as character        no-undo.
     5692   define input parameter p-ord-num                as character        no-undo.
     5693   define input parameter p-ship-num               as character        no-undo.
     5694   define input parameter p-ship-date              as date             no-undo.
     5695   define input parameter p-payment-code           as integer          no-undo.
     5696   define input parameter p-hold-doc-code-child    as character        no-undo.
     5697   define input parameter p-hold-doc-code-parent   as character        no-undo.
     5698   define input parameter p-hold-obj-type          as character        no-undo.
     5699   define input parameter p-hold-obj-code          as integer          no-undo.
     5700   define input parameter p-out-code               as character        no-undo.
     5701   define input parameter p-supp-dog-code          as character        no-undo.
     5702   define input parameter p-supp-ndog              as character        no-undo.
     5703   define input parameter p-supp-ddog              as character        no-undo.
     5704   define input parameter p-d-card                 as character        no-undo.
     5705   define input parameter p-cli-type               as character        no-undo.
     5706   define input parameter p-cli-code               as integer          no-undo.
     5707   define input parameter p-is-envd_               as logical          no-undo.
     5708   define input parameter p-sum-all-parts          as decimal          no-undo.
     5709       define variable v-exists-before     as logical      no-undo.
     5710       define variable v-exists-after      as logical      no-undo.
     5711       define variable v-obj-type          as character    no-undo.
     5712       define variable v-obj-code          as integer      no-undo.
     5713       define variable v-qnty              as decimal      no-undo.
     5714       define variable v-excise-base       as decimal      no-undo.
