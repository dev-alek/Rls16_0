     5594                     , input substitute( "Ошибка экспорта удаленного документа. Номер документа: &1. &2. &3 &4 "
     5595                                         , v-doc-code
     5596                                         , return-value
     5597                                         , trim(error-status :get-message(1))
     5598                                         , trim(error-status :get-message(2))
     5599                                     )
     5600                 ).
