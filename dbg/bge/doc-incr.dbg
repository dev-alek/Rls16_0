     5285                                                                     , input 'price-doc':U
     5286                                                                     , input v-doc-code
     5287                                                                     , input sLogFile
     5288                                                                     ).
     5289                 end.
     5290               end.
     5291             end.
     5292             when 'trn-doc':U
     5293             then do:
     5294               find first buf_trn-doc share-lock
     5295                 where buf_trn-doc.doc-code = buf_tt-docs.doc-code
     5296               no-error .
