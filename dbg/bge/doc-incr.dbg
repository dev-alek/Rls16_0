      603   procedure xmlchar-decode :
      604   define input parameter p-in-string      as character        no-undo.
      605   define output parameter p-out-string    as character        no-undo.
      606       define variable v-position      as integer      no-undo.
      607       define variable v-last-position as integer      no-undo.
      608       define variable v-temp-integer  as integer      no-undo.
      609       define variable v-current-char  as character    no-undo.
      610       define variable v-next-char     as character    no-undo.
      611       define variable v-success       as logical      no-undo.
      612   do
      613   on error undo, return error
      614   :
      615       assign
      616           p-out-string = "":U
      617           v-position   = 0
      618       .
      619       replace-cycle:
      620       do while yes
      621       on error undo, return error
      622       :
      623           assign
      624               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      625           .
      626           if v-last-position <= v-position
      627           then do:
      628               if v-position = 0
      629               then do:
      630                   assign
      631                       p-out-string = p-in-string
      632                   .
      633               end.
      634               else do:
      635                   assign
      636                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      637                   .
      638               end.
      639               leave replace-cycle.
      640           end.
      641           else do:
      642               assign
      643                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      644                   v-position      = v-last-position
      645                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      646               .
      647               if v-current-char = "#":U
      648               then do:
      649                   assign
      650                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      651                   .
      652                   if v-last-position > 0
      653                   then do:
      654                       run xmlchar-read-integer in this-procedure
      655                        (
      656                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      657                           , output v-temp-integer
      658                           , output v-success
      659                       ).
      660                       if v-success = yes
      661                       and v-temp-integer >= 1
      662                       and v-temp-integer <= 255
      663                       then do:
      664                           assign
      665                               p-out-string = p-out-string + chr( v-temp-integer )
      666                               v-position   = v-last-position + 1
      667                           .
      668                       end.
      669                       else do:
      670                           assign
      671                               p-out-string = p-out-string + "&":U
      672                               v-position   = v-position   + 1
      673                           .
      674                       end.
      675                   end.
      676                   else do:
      677                       assign
      678                           p-out-string = p-out-string + "&":U
      679                           v-position   = v-position   + 1
      680                       .
      681                   end.
      682               end.
      683               else do:
      684                   case substring( p-in-string, v-position + 1, 3 )
      685                   :
      686                       when "lt;":U
      687                       then do:
      688                           assign
      689                               p-out-string = p-out-string + "<":U
      690                               v-position   = v-position   + 3
      691                           .
      692                       end.
      693                       when "gt;":U
      694                       then do:
      695                           assign
      696                               p-out-string = p-out-string + ">":U
      697                               v-position   = v-position   + 3
      698                           .
      699                       end.
      700                       otherwise do:
      701                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      702                           then do:
      703                               assign
      704                                   p-out-string = p-out-string + "&":U
      705                                   v-position   = v-position   + 4
      706                               .
      707                           end.
      708                           else do:
      709                               case substring( p-in-string, v-position + 1, 5 )
      710                               :
      711                                   when "quot;":U
      712                                   then do:
      713                                       assign
      714                                           p-out-string = p-out-string + '"':U
      715                                           v-position   = v-position   + 5
      716                                       .
      717                                   end.
      718                                   when "apos;":U
      719                                   then do:
      720                                       assign
      721                                           p-out-string = p-out-string + "'":U
      722                                           v-position   = v-position   + 5
      723                                       .
      724                                   end.
      725                                   otherwise do:
      726                                       assign
      727                                           p-out-string = p-out-string + "&":U
      728                                       .
      729                                   end.
      730                               end case.
      731                           end.
      732                       end.
      733                   end case.
      734               end.
      735           end.
      736       end.
      737   end.
      738   end .
      739   procedure xmlchar-read-integer :
      740   define input parameter p-input-string      as character        no-undo.
      741   define output parameter p-output-integer   as integer          no-undo.
      742   define output parameter p-success       as logical          no-undo.
      743   do
      744   on error undo, return error
      745   :
      746       assign
      747           p-output-integer = integer( p-input-string )
      748       no-error.
      749       if error-status :error
      750       then do:
      751           assign
      752               p-success           = no
      753               p-output-integer    = 0
      754           .
      755       end.
      756       else do:
      757           assign
      758               p-success           = yes
      759           .
      760       end.
      761   end.
      762   end.
      763   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      764   procedure strtdate :
      765     define input  parameter p-str         as character no-undo .
      766     define output parameter p-value       as date      no-undo .
      767     define output parameter p-data-valid  as logical   no-undo .
      768     define output parameter p-message     as character no-undo .
      769   do
      770   on error undo, return error return-value
      771   :
      772     define variable v-value       as date      no-undo .
      773     define variable v-i           as integer   no-undo .
      774     define variable v-num         as integer   no-undo .
      775     define variable v-delim       as character no-undo .
      776     define variable v-delim-list  as character no-undo .
      777     define variable v-day         as integer   no-undo .
      778     define variable v-month       as integer   no-undo .
      779     define variable v-year        as integer   no-undo .
      780     define variable v-day-str     as character no-undo .
      781     define variable v-month-str   as character no-undo .
      782     define variable v-year-str    as character no-undo .
      783     assign
      784       p-value       = ?
      785       p-data-valid  = false
      786     .
      787     if p-str = ?
      788     then do:
      789       assign
      790         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      791       .
      792       return .
      793     end.
      794     if p-str = ""
      795     then do:
      796       assign
      797         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      798       .
      799       return .
      800     end.
      801     if length(p-str)  > 10
      802     then do:
      803       assign
      804         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      805       .
      806       return .
      807     end.
      808     assign
      809       v-delim-list = '/,-,.':U
      810     .
      811     _delim:
      812     do v-i = 1 to num-entries( v-delim-list )
      813     :
      814       assign
      815         v-delim = entry( v-i , v-delim-list )
      816         v-num   = num-entries( p-str , v-delim )
      817       .
      818       if v-num <> 3
      819       then do:
      820         assign
      821           v-delim = ''
      822         .
      823       end.
      824       else do:
      825         leave _delim.
      826       end.
      827     end.
      828     if v-delim = ''
      829     then do:
      830       assign
      831         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      832       .
      833       return .
      834     end.
      835     assign
      836       v-day-str   = entry( 1, p-str , v-delim)
      837       v-month-str = entry( 2, p-str , v-delim)
      838       v-year-str  = entry( 3, p-str , v-delim)
      839     .
      840     if  length(v-day-str) > 2   or
      841         length(v-day-str) < 1   or
      842         length(v-month-str) > 2 or
      843         length(v-month-str) < 1 or
      844         (
      845           length(v-year-str) <> 2 and
      846           length(v-year-str) <> 4
      847         )
      848     then do:
      849       assign
      850         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      851       .
      852       return .
      853     end.
      854     if length( v-year-str ) = 2
      855     then do:
      856       assign
      857         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      858       .
      859     end.
      860     assign
      861       v-day   = integer( v-day-str )
      862       v-month = integer( v-month-str)
      863       v-year  = integer( v-year-str)
      864     no-error .
      865     if error-status :error
      866     then do:
      867       assign
      868         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      869       .
      870       return .
      871     end.
      872     if v-day < 1  or
      873        v-day > 31 or
      874        v-month < 1 or
      875        v-month > 12 or
      876        v-year < 0   or
      877        v-year > 5000
      878     then do:
      879       assign
      880         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      881       .
      882       return .
      883     end.
      884     assign
      885       v-value = date( v-month, v-day, v-year )
      886     no-error .
      887     if error-status :error
      888     then do:
      889       assign
      890         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      891       .
      892       return .
      893     end.
      894     assign
      895       p-value       = v-value
      896       p-data-valid  = true
      897     .
      898   end.
      899   end procedure.
      900   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      901   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
