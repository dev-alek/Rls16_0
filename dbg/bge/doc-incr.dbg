     6039                       assign
     6040                           temp_cost_cat-id_ot-supp-tot.cat-id   = buf_cost_ot-supp-tot.cat-id
     6041                       .
     6042                   end.
     6043                   find first temp_cost_cli_ot-supp-tot
     6044                        where temp_cost_cli_ot-supp-tot.cat-id   = buf_cost_ot-supp-tot.cat-id
     6045                          and temp_cost_cli_ot-supp-tot.cli-type = buf_cost_ot-supp-tot.cli-type
     6046                          and temp_cost_cli_ot-supp-tot.cli-code = buf_cost_ot-supp-tot.cli-code
     6047                   no-error.
     6048                   if not available temp_cost_cli_ot-supp-tot
     6049                   then do:
     6050                       create temp_cost_cli_ot-supp-tot.
     6051                       assign
     6052                           temp_cost_cli_ot-supp-tot.cat-id            = buf_cost_ot-supp-tot.cat-id
     6053                           temp_cost_cli_ot-supp-tot.cli-type          = buf_cost_ot-supp-tot.cli-type
     6054                           temp_cost_cli_ot-supp-tot.cli-code          = buf_cost_ot-supp-tot.cli-code
     6055                           temp_cost_cli_ot-supp-tot.sum-rubl          = buf_cost_ot-supp-tot.sum-rubl
     6056                           temp_cost_cli_ot-supp-tot.vat-rubl          = buf_cost_ot-supp-tot.vat-rubl
     6057                           temp_cost_cli_ot-supp-tot.slt-rubl          = buf_cost_ot-supp-tot.slt-rubl
     6058                           temp_cost_cli_ot-supp-tot.road-tax-rubl     = buf_cost_ot-supp-tot.road-tax-rubl
     6059                           temp_cost_cli_ot-supp-tot.transport-rubl    = buf_cost_ot-supp-tot.transport-rubl
     6060                           temp_cost_cli_ot-supp-tot.other-rubl        = buf_cost_ot-supp-tot.other-rubl
     6061                           temp_cost_cli_ot-supp-tot.excise-rubl       = buf_cost_ot-supp-tot.excise-rubl
     6062                           temp_cost_cli_ot-supp-tot.sum-base          = buf_cost_ot-supp-tot.sum-base
     6063                           temp_cost_cli_ot-supp-tot.vat-base          = buf_cost_ot-supp-tot.vat-base
     6064                           temp_cost_cli_ot-supp-tot.slt-base          = buf_cost_ot-supp-tot.slt-base
     6065                           temp_cost_cli_ot-supp-tot.road-tax-base     = buf_cost_ot-supp-tot.road-tax-base
     6066                           temp_cost_cli_ot-supp-tot.transport-base    = buf_cost_ot-supp-tot.transport-base
     6067                           temp_cost_cli_ot-supp-tot.other-base        = buf_cost_ot-supp-tot.other-base
     6068                           temp_cost_cli_ot-supp-tot.excise-base       = buf_cost_ot-supp-tot.excise-base
     6069                           temp_cost_cli_ot-supp-tot.fact-qnty         = buf_cost_ot-supp-tot.fact-qnty
     6070                       .
     6071                   end.
     6072               end.
     6073           end.
     6074           for each temp_cost_cat-id_ot-supp-line no-lock
     6075           on error undo, return error
     6076           :
     6077               delete temp_cost_cat-id_ot-supp-line.
     6078           end.
     6079           for each temp_cost_cli_ot-supp-line no-lock
     6080           on error undo, return error
     6081           :
     6082               delete temp_cost_cli_ot-supp-line.
     6083           end.
     6084           for each buf_cost_ot-supp-line no-lock
     6085               where buf_cost_ot-supp-line.doc-code = p-doc-code
     6086           on error undo, return error
     6087           :
     6088               if buf_cost_ot-supp-line.sum-type = 'cost':U + 'p':U
     6089               then do:
     6090                   find first temp_cost_cat-id_ot-supp-line
     6091                           where temp_cost_cat-id_ot-supp-line.artic      = buf_cost_ot-supp-line.artic
     6092                           and temp_cost_cat-id_ot-supp-line.prod-type  = buf_cost_ot-supp-line.prod-type
     6093                           and temp_cost_cat-id_ot-supp-line.prod-code  = buf_cost_ot-supp-line.prod-code
     6094                           and temp_cost_cat-id_ot-supp-line.cat-id     = buf_cost_ot-supp-line.cat-id
     6095                   no-error.
     6096                   if not available temp_cost_cat-id_ot-supp-line
     6097                   then do:
     6098                       create temp_cost_cat-id_ot-supp-line.
     6099                       assign
     6100                           temp_cost_cat-id_ot-supp-line.artic     = buf_cost_ot-supp-line.artic
     6101                           temp_cost_cat-id_ot-supp-line.prod-type = buf_cost_ot-supp-line.prod-type
     6102                           temp_cost_cat-id_ot-supp-line.prod-code = buf_cost_ot-supp-line.prod-code
     6103                           temp_cost_cat-id_ot-supp-line.cat-id    = buf_cost_ot-supp-line.cat-id
     6104                       .
     6105                   end.
     6106                   find first temp_cost_cli_ot-supp-line
     6107                           where temp_cost_cli_ot-supp-line.artic      = buf_cost_ot-supp-line.artic
     6108                           and temp_cost_cli_ot-supp-line.prod-type  = buf_cost_ot-supp-line.prod-type
     6109                           and temp_cost_cli_ot-supp-line.prod-code  = buf_cost_ot-supp-line.prod-code
     6110                           and temp_cost_cli_ot-supp-line.cat-id     = buf_cost_ot-supp-line.cat-id
     6111                           and temp_cost_cli_ot-supp-line.cli-type   = buf_cost_ot-supp-line.cli-type
     6112                           and temp_cost_cli_ot-supp-line.cli-code   = buf_cost_ot-supp-line.cli-code
     6113                   no-error.
     6114                   if not available temp_cost_cli_ot-supp-line
     6115                   then do:
     6116                       create temp_cost_cli_ot-supp-line.
     6117                       assign
     6118                           temp_cost_cli_ot-supp-line.artic             = buf_cost_ot-supp-line.artic
     6119                           temp_cost_cli_ot-supp-line.prod-type         = buf_cost_ot-supp-line.prod-type
     6120                           temp_cost_cli_ot-supp-line.prod-code         = buf_cost_ot-supp-line.prod-code
     6121                           temp_cost_cli_ot-supp-line.cat-id            = buf_cost_ot-supp-line.cat-id
