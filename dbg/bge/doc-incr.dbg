     4020   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4021   procedure factord :
     4022     define input  parameter p-fact-date            as date    no-undo .
     4023     define input  parameter p-fact-time            as integer no-undo .
     4024     define input  parameter p-fact-num             as integer no-undo .
     4025     define input  parameter p-shift-date           as date    no-undo .
     4026     define input  parameter p-shift-num            as integer no-undo .
     4027     define input  parameter p-shift-on             as logical no-undo .
     4028     define output parameter p-fact-order           as decimal no-undo .
     4029     define output parameter p-shift-end-fact-order as decimal no-undo .
     4030     define output parameter p-day-end-fact-order   as decimal no-undo .
     4031     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     4032     if p-fact-date = ?
     4033     then do:
     4034       return error "Не указана фактическая дата" .
     4035     end.
     4036     define variable v-fact-date-num as integer no-undo .
     4037     assign
     4038       v-fact-date-num = integer(p-fact-date)
     4039     .
     4040     if p-fact-num = ?
     4041     or p-fact-num = 0
     4042     then do:
     4043       return error "Не задан p-fact-num " + string(p-fact-num) .
     4044     end.
     4045     if p-fact-num < 0
     4046     then do:
     4047       return error "Отрицательный fact-num " + string(p-fact-num) .
     4048     end.
     4049     if p-fact-num >= 100000000
     4050     then do:
     4051       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     4052     end.
     4053     if p-shift-on = true
     4054     then do:
     4055       if p-shift-date = ?
     4056       then do:
     4057         return error "Не задана дата смены" .
     4058       end.
     4059       if p-shift-num = ?
     4060       or p-shift-num = 0
     4061       then do:
     4062         return error "Не задан номер смены" .
     4063       end.
     4064     end.
     4065     else do:
     4066       assign
     4067         p-shift-date = p-fact-date
     4068         p-shift-num  = 24
     4069       .
     4070     end.
     4071     define variable v-shift-offset as integer no-undo .
     4072     if p-shift-date = p-fact-date
     4073     then do:
     4074       assign
     4075         v-shift-offset = 1
     4076       .
     4077     end.
     4078     if p-shift-date < p-fact-date
     4079     then do:
     4080       assign
     4081         v-shift-offset = 0
     4082       .
     4083     end.
     4084     if p-shift-date > p-fact-date
     4085     then do:
     4086       message
     4087         vss-workfile vss-revision vss-description skip
     4088         "Неправильная дата закрытия смены" skip
     4089         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     4090         view-as alert-box error .
     4091       undo, return error
     4092         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     4093           ,string(p-fact-date, '99/99/9999':U)
     4094           ,string(p-shift-date, '99/99/9999':U)
     4095           )
     4096       .
     4097     end.
     4098     if p-shift-num < 1
     4099     or p-shift-num > 24
     4100     then do:
     4101       message
     4102         vss-workfile vss-revision vss-description skip
     4103         "Неправильный номер смены" skip
     4104         "p-shift-num" p-shift-num skip
     4105         view-as alert-box error .
     4106       undo, return error return-value .
     4107     end.
     4108     assign
     4109       p-fact-order           = v-fact-date-num
     4110                              + v-shift-offset * 0.5
     4111                              + p-shift-num    * 0.02 - 0.01
     4112                              + p-fact-num     * 0.0000000001
     4113       p-shift-end-fact-order = v-fact-date-num
     4114                              + v-shift-offset * 0.5
     4115                              + p-shift-num    * 0.02
     4116       p-day-end-fact-order   = v-fact-date-num
     4117                              + 0.99
     4118     .
     4119     if p-fact-order           <= v-fact-date-num
     4120     or p-shift-end-fact-order <= v-fact-date-num
     4121     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     4122     or p-shift-end-fact-order >= p-day-end-fact-order
     4123     then do:
     4124       message
     4125         vss-workfile vss-revision vss-description skip
     4126         "Внутренняя ошибка при генерации фактического номера" skip
     4127         "p-fact-date"            p-fact-date            skip
     4128         "p-fact-time"            p-fact-time            skip
     4129         "p-fact-num"             p-fact-num             skip
     4130         "p-shift-date"           p-shift-date           skip
     4131         "p-shift-num"            p-shift-num            skip
     4132         "p-shift-on"             p-shift-on             skip
     4133         "p-shift-end-fact-order" p-shift-end-fact-order skip
     4134         "p-day-end-fact-order"   p-day-end-fact-order   skip
     4135         "v-fact-date-num"        v-fact-date-num        skip
     4136         view-as alert-box error .
     4137       undo, return error return-value .
     4138     end.
     4139   end procedure.
     4140   procedure day-begin-fact-order :
     4141     define input  parameter p-fact-date            as date    no-undo .
     4142     define output parameter p-day-begin-fact-order as decimal no-undo .
     4143     do
     4144     on error undo, return error return-value
     4145     :
     4146       if p-fact-date = ?
     4147       then do:
     4148         assign
     4149           p-day-begin-fact-order = 0
     4150         .
     4151       end.
     4152       else do:
     4153         assign
     4154           p-day-begin-fact-order = integer(p-fact-date)
     4155         .
     4156       end.
     4157     end.
     4158   end procedure.
     4159   procedure factord-max-fact-order :
     4160     define output parameter p-max-fact-order as decimal   no-undo .
     4161     do
     4162     on error undo, return error return-value
     4163     :
     4164       run day-begin-fact-order in this-procedure
     4165         (input  date(1, 1, 5000)
     4166         ,output p-max-fact-order
     4167         ) .
     4168     end.
     4169   end procedure.
     4170   procedure factord-cut-archive :
     4171     define input  parameter p-obj-type             as character no-undo .
     4172     define input  parameter p-obj-code             as integer   no-undo .
     4173     define input  parameter p-fact-date            as date      no-undo .
     4174     define output parameter p-shift-on             as logical   no-undo .
     4175     define output parameter p-shift-date           as date      no-undo .
     4176     define output parameter p-shift-num            as integer   no-undo .
     4177     define output parameter p-day-end-fact-order   as decimal   no-undo .
     4178     define output parameter p-shift-end-fact-order as decimal   no-undo .
     4179     define variable v-fact-order as decimal   no-undo .
     4180     define buffer buf_shift-obj for ub.shift-obj .
     4181     do
     4182     on error undo, return error return-value
     4183     :
     4184   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4185   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     4186     (input  p-obj-type
     4187     ,input  p-obj-code
     4188     ,input  'shift-on=request'
     4189     ,output p-shift-on
     4190     ) no-error .
     4191       if error-status :error
     4192       then do:
     4193         message
     4194           vss-workfile vss-revision vss-description skip
     4195           "Ошибка при определении атрибута объекта" skip
     4196           "Объект" p-obj-type p-obj-code skip
     4197           error-status :get-message(1) skip
     4198           return-value skip
     4199           view-as alert-box error .
     4200         undo, return error return-value .
     4201       end.
     4202       if p-shift-on = false
     4203       then do:
     4204         assign
     4205           p-shift-date               = ?
     4206           p-shift-num                = 0
     4207         .
     4208       end.
     4209       else do:
     4210         find first buf_shift-obj share-lock
     4211           where buf_shift-obj.obj-type   = p-obj-type
     4212             and buf_shift-obj.obj-code   = p-obj-code
     4213             and buf_shift-obj.shift-date > p-fact-date
     4214           use-index pi
     4215           no-error .
     4216         if not available buf_shift-obj
     4217         or buf_shift-obj.status_ <> 'зкр':U
     4218         then do:
     4219           message
     4220             vss-workfile vss-revision vss-description skip
     4221             "Невозможно вычислить последнюю смену" skip
     4222             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     4223             "Объект" p-obj-type p-obj-code skip
     4224             "Дата" p-fact-date skip
     4225             view-as alert-box error .
     4226           undo, return error return-value .
     4227         end.
     4228         find last buf_shift-obj share-lock
     4229           where buf_shift-obj.obj-type = p-obj-type
     4230             and buf_shift-obj.obj-code = p-obj-code
     4231             and buf_shift-obj.shift-date <= p-fact-date
     4232           use-index pi
     4233           no-error .
     4234         if available buf_shift-obj
     4235         then do:
     4236           if  buf_shift-obj.status_ = 'зкр':U
     4237           then do:
     4238             assign
     4239               p-shift-date = buf_shift-obj.shift-date
     4240               p-shift-num  = buf_shift-obj.shift-num
     4241             .
     4242           end.
     4243           else do:
     4244             message
     4245               vss-workfile vss-revision vss-description skip
     4246               "Невозможно вычислить последнюю смену" skip
     4247               "Статус смены отличен от статуса" 'зкр':U skip
     4248               "Объект" p-obj-type p-obj-code skip
     4249               "Дата" p-fact-date skip
     4250               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     4251               view-as alert-box error .
     4252             undo, return error return-value .
     4253           end.
     4254         end.
     4255         else do:
     4256           assign
     4257             p-shift-date = p-fact-date - 1
     4258             p-shift-num  = 1
     4259           .
     4260         end.
     4261       end.
     4262       run factord in this-procedure
     4263         (input  p-fact-date
     4264         ,input  1
     4265         ,input  1
     4266         ,input  p-shift-date
     4267         ,input  p-shift-num
     4268         ,input  p-shift-on
     4269         ,output v-fact-order
     4270         ,output p-shift-end-fact-order
     4271         ,output p-day-end-fact-order
     4272         ) no-error .
     4273       if error-status :error
     4274       then do:
     4275         message
     4276           vss-workfile vss-revision vss-description skip
     4277           "Ошибка при вызове процедуры factord"
     4278           error-status :get-message(1) skip
     4279           return-value skip
     4280           view-as alert-box error .
     4281         undo, return error return-value .
     4282       end.
     4283     end.
     4284   end procedure.
     4285   procedure factord-lock-shift :
     4286     define input  parameter p-obj-type  as character no-undo .
     4287     define input  parameter p-obj-code  as integer   no-undo .
     4288     define input  parameter p-fact-date as date      no-undo .
     4289     define parameter buffer buf_shift-obj for ub.shift-obj .
     4290     define variable v-shift-on      as logical   no-undo .
     4291     define variable v-extra-message as character no-undo .
     4292     define variable v-error as character no-undo .
     4293     do
     4294     on error undo, return error return-value
     4295     :
     4296   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4297   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     4298     (input  p-obj-type
     4299     ,input  p-obj-code
     4300     ,input  'shift-on=request'
     4301     ,output v-shift-on
     4302     ) no-error .
     4303       if error-status :error
     4304       then do:
     4305         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     4306         undo, return error v-error .
     4307       end.
     4308       if v-shift-on = true
     4309       then do:
     4310         find first buf_shift-obj share-lock
     4311           where buf_shift-obj.obj-type   = p-obj-type
     4312             and buf_shift-obj.obj-code   = p-obj-code
     4313             and buf_shift-obj.shift-date > p-fact-date
     4314           use-index pi
     4315           no-error .
     4316         if not available buf_shift-obj
     4317         or buf_shift-obj.status_ <> 'зкр':U
     4318         then do:
     4319           find last buf_shift-obj
     4320             where buf_shift-obj.obj-type = p-obj-type
     4321               and buf_shift-obj.obj-code = p-obj-code
     4322               and buf_shift-obj.status_  = 'зкр':U
     4323             use-index stts
     4324             no-error .
     4325           if available buf_shift-obj
     4326           then do:
     4327             assign
     4328               v-extra-message =
     4329                     substitute("Дата начала последеней закрытой смены на объекте &1"
     4330                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     4331                               )
     4332             .
     4333           end.
     4334           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     4335           undo, return error v-error .
     4336         end.
     4337       end.
     4338     end.
     4339   end procedure.
     4340   procedure factord-end-day :
     4341     define input  parameter p-fact-date            as date    no-undo .
     4342     define output parameter p-day-end-fact-order   as decimal no-undo .
     4343     do
     4344     on error undo, return error return-value
     4345     :
     4346       if p-fact-date = ?
     4347       then do:
     4348         return error "Не указана фактическая дата" .
     4349       end.
     4350       assign
     4351         p-day-end-fact-order = integer(p-fact-date) + 0.99
     4352       .
     4353     end.
     4354   end procedure.
     4355   procedure factord-to-date :
     4356     define input  parameter p-fact-order as decimal no-undo .
     4357     define output parameter p-fact-date  as date    no-undo .
     4358     define variable v-ref-date  as date      no-undo .
     4359     define variable v-ref-delta as integer   no-undo .
     4360     do
     4361     on error undo, return error return-value
     4362     :
     4363       if p-fact-order = ?
     4364       or p-fact-order = 0
     4365       then do:
     4366         return error "Не указан fact-order" .
     4367       end.
     4368       assign
     4369         v-ref-date  = date(1, 1, 2000)
     4370       .
     4371       assign
     4372         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     4373       .
     4374       assign
     4375         p-fact-date = v-ref-date + v-ref-delta
     4376       .
     4377     end.
     4378   end procedure.
     4379   procedure factord-to-fact-num :
     4380     define input  parameter p-fact-order as decimal no-undo .
     4381     define output parameter p-fact-num   as integer no-undo .
     4382     define variable v-fact-order-trunc as decimal no-undo .
     4383     do
     4384     on error undo, return error return-value
     4385     :
     4386       if p-fact-order = ?
     4387       or p-fact-order = 0
     4388       then do:
     4389         return error "Не указан fact-order" .
     4390       end.
     4391       assign
     4392        v-fact-order-trunc = truncate(p-fact-order, 2)
     4393       .
     4394       assign
     4395         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     4396       .
     4397     end.
     4398   end procedure.
     4399   procedure factord-to-shift-num :
     4400     define input  parameter p-fact-order as decimal no-undo .
     4401     define output parameter p-shift-num   as integer no-undo .
     4402     define variable  p-shift-numd  as decimal   no-undo .
     4403     define variable v-fact-order-trunc as decimal no-undo .
     4404     do
     4405     on error undo, return error return-value
     4406     :
     4407       if p-fact-order = ?
     4408       or p-fact-order = 0
     4409       then do:
     4410         return error "Не указан fact-order" .
     4411       end.
     4412       assign
     4413        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     4414       .
     4415       if v-fact-order-trunc < 0.5 then do:
     4416         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     4417       end.
     4418       assign
     4419         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     4420         .
     4421        assign
     4422         p-shift-num = truncate (p-shift-numd , 0)
     4423       .
     4424     end.
     4425   end procedure.
     4426   do
     4427   on error undo, return error return-value
     4428   :
     4429   if not valid-handle( p-parent-proc )
     4430   then do:
     4431       return.
     4432   end.
