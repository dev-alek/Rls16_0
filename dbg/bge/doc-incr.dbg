     3605   define buffer buf_goods for ub.goods.
     3606   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3607   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3608   procedure cp-attr-code :
     3609     do
     3610     on error undo, return error
     3611     :
     3612       define input  parameter p-code           as character no-undo .
     3613       define output parameter p-type           as character no-undo .
     3614       define output parameter p-format         as character no-undo .
     3615       define output parameter p-label          as character no-undo .
     3616       define output parameter p-range          as integer   no-undo .
     3617       define output parameter p-user-can-edit  as logical   no-undo .
     3618       define output parameter p-output-display as logical   no-undo .
     3619       define output parameter p-other          as character no-undo .
     3620       case p-code :
     3621               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     3622               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
     3623               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
     3624               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
     3625               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     3626               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     3627               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     3628               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     3629               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     3630               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     3631         otherwise do:
     3632           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
     3633         end.
     3634       end.
     3635     end.
     3636   end procedure.
     3637   procedure cp-attr-tooltip :
     3638     do
     3639     on error undo, return error
     3640     :
     3641       define input  parameter p-code    as character no-undo .
     3642       define output parameter p-tooltip as character no-undo .
     3643       define output parameter p-label   as character no-undo .
     3644       case p-code :
     3645               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
     3646               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
     3647               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
     3648               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
     3649               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
     3650               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
     3651               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
     3652               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
     3653               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
     3654               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
     3655         otherwise do:
     3656           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
     3657         end.
     3658       end.
     3659     end.
     3660   end procedure.
     3661   procedure cp-attr-value :
     3662     do
     3663     on error undo, return error
     3664     :
     3665       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     3666       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     3667       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     3668       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     3669       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     3670       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
     3671       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
     3672       define output parameter p-type        as character no-undo .
     3673       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     3674       define variable v-format         as character no-undo .
     3675       define variable v-label          as character no-undo .
     3676       define variable v-range          as integer   no-undo .
     3677       define variable v-user-can-edit  as logical   no-undo .
     3678       define variable v-output-display as logical   no-undo .
     3679       define variable v-other          as character no-undo .
     3680       run cp-attr-code in this-procedure
     3681         (input  p-code
     3682         ,output p-type
     3683         ,output v-format
     3684         ,output v-label
     3685         ,output v-range
     3686         ,output v-user-can-edit
     3687         ,output v-output-display
     3688         ,output v-other
     3689         ) no-error .
     3690       if error-status :error then do:
     3691         undo, return error return-value .
     3692       end.
     3693       find first buf_cash-pay-attr no-lock
     3694         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     3695           and buf_cash-pay-attr.curr-code  = p-curr-code
     3696           and buf_cash-pay-attr.host-code  = p-host-code
     3697           and buf_cash-pay-attr.obj-type   = p-obj-type
     3698           and buf_cash-pay-attr.obj-code   = p-obj-code
     3699           and buf_cash-pay-attr.attr-code  = p-code
     3700         no-error .
     3701       if avail buf_cash-pay-attr then do:
     3702         assign
     3703           p-value =  buf_cash-pay-attr.attr-value
     3704         .
     3705       end.
     3706       else do:
     3707         assign
     3708           p-value = if p-type = 'L':U then "no":U else ""
     3709         .
     3710       end.
     3711     end.
     3712   end procedure.
     3713   procedure cp-attr-write :
     3714     do
     3715     on error undo, return error
     3716     :
     3717       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     3718       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     3719       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     3720       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     3721       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     3722       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     3723       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
     3724       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     3725       define buffer last_cash-pay-attr for ub.cash-pay-attr .
     3726       define variable v-type           as character no-undo .
     3727       define variable v-format         as character no-undo .
     3728       define variable v-label          as character no-undo .
     3729       define variable v-range          as integer   no-undo .
     3730       define variable v-user-can-edit  as logical   no-undo .
     3731       define variable v-output-display as logical   no-undo .
     3732       define variable v-other          as character no-undo .
     3733       run cp-attr-code in this-procedure
     3734         (input  p-code
     3735         ,output v-type
     3736         ,output v-format
     3737         ,output v-label
     3738         ,output v-range
     3739         ,output v-user-can-edit
     3740         ,output v-output-display
     3741         ,output v-other
     3742         ) no-error .
     3743       if error-status :error then do:
     3744         undo, return error return-value .
     3745       end.
     3746       find first buf_cash-pay-attr exclusive-lock
     3747         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     3748           and buf_cash-pay-attr.curr-code  = p-curr-code
     3749           and buf_cash-pay-attr.host-code  = p-host-code
     3750           and buf_cash-pay-attr.obj-type   = p-obj-type
     3751           and buf_cash-pay-attr.obj-code   = p-obj-code
     3752           and buf_cash-pay-attr.attr-code = p-code
     3753         no-error .
     3754       if not available buf_cash-pay-attr then do:
     3755         create buf_cash-pay-attr .
     3756         assign
     3757         buf_cash-pay-attr.cdpay-code = p-cdpay-code
     3758         buf_cash-pay-attr.curr-code  = p-curr-code
     3759         buf_cash-pay-attr.host-code  = p-host-code
     3760         buf_cash-pay-attr.obj-type   = p-obj-type
     3761         buf_cash-pay-attr.obj-code   = p-obj-code
     3762         buf_cash-pay-attr.attr-code = p-code
     3763         .
     3764       end.
     3765       assign
     3766         buf_cash-pay-attr.attr-value = p-value
     3767       .
     3768       release buf_cash-pay-attr no-error .
     3769       if error-status:error then do:
     3770         undo, return error return-value .
     3771       end.
     3772     end.
     3773   end procedure.
     3774   procedure cp-attr-exist :
     3775     do
     3776     on error undo, return error
     3777     :
     3778       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     3779       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     3780       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     3781       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     3782       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     3783       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     3784       define output parameter p-exist   as logical  no-undo .
     3785       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     3786       define variable v-type           as character no-undo .
     3787       define variable v-format         as character no-undo .
     3788       define variable v-label          as character no-undo .
     3789       define variable v-range          as integer   no-undo .
     3790       define variable v-user-can-edit  as logical   no-undo .
     3791       define variable v-output-display as logical   no-undo .
     3792       define variable v-other          as character no-undo .
     3793       run cp-attr-code in this-procedure
     3794         (input  p-code
     3795         ,output v-type
     3796         ,output v-format
     3797         ,output v-label
     3798         ,output v-range
     3799         ,output v-user-can-edit
     3800         ,output v-output-display
     3801         ,output v-other
     3802         ) no-error .
     3803       if error-status :error then do:
     3804         undo, return error return-value .
     3805       end.
     3806       find first buf_cash-pay-attr exclusive-lock
     3807         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     3808           and buf_cash-pay-attr.curr-code  = p-curr-code
     3809           and buf_cash-pay-attr.host-code  = p-host-code
     3810           and buf_cash-pay-attr.obj-type   = p-obj-type
     3811           and buf_cash-pay-attr.obj-code   = p-obj-code
     3812           and buf_cash-pay-attr.attr-code = p-code
     3813         no-error .
     3814       if  available buf_cash-pay-attr then do:
     3815         p-exist = yes.
     3816       end.
     3817     end.
     3818   end procedure.
     3819   procedure cp-attr-delete :
     3820     do
     3821     on error undo, return error
     3822     :
     3823       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     3824       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     3825       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     3826       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     3827       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     3828       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     3829       define output parameter p-deleted  as logical no-undo.
     3830       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     3831       define variable v-type           as character no-undo .
     3832       define variable v-format         as character no-undo .
     3833       define variable v-label          as character no-undo .
     3834       define variable v-range          as integer   no-undo .
     3835       define variable v-user-can-edit  as logical   no-undo .
     3836       define variable v-output-display as logical   no-undo .
     3837       define variable v-other          as character no-undo .
     3838       run cp-attr-code in this-procedure
     3839         (input  p-code
     3840         ,output v-type
     3841         ,output v-format
     3842         ,output v-label
     3843         ,output v-range
     3844         ,output v-user-can-edit
     3845         ,output v-output-display
     3846         ,output v-other
     3847         ) no-error .
     3848       if error-status :error then do:
     3849         undo, return error return-value .
     3850       end.
     3851       find first buf_cash-pay-attr exclusive-lock
     3852         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     3853           and buf_cash-pay-attr.curr-code  = p-curr-code
     3854           and buf_cash-pay-attr.host-code  = p-host-code
     3855           and buf_cash-pay-attr.obj-type   = p-obj-type
     3856           and buf_cash-pay-attr.obj-code   = p-obj-code
     3857           and buf_cash-pay-attr.attr-code = p-code
     3858         no-error NO-WAIT.
     3859       if not available buf_cash-pay-attr then do:
     3860         p-deleted = no.
     3861       end.
     3862       else do:
     3863         delete buf_cash-pay-attr no-error .
     3864         if error-status:error then do:
     3865           undo, return error return-value .
     3866         end.
     3867         p-deleted = yes.
     3868       end.
     3869     end.
     3870   end procedure.
     3871   procedure cp-attr-news :
     3872     do
     3873     on error undo, return error
     3874     :
     3875       define input  parameter p-code           as character no-undo .
     3876       define output parameter p-news           as logical   no-undo .
     3877       case p-code :
     3878               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     3879               when 'grp-code':U then do:     assign     p-news = true.   end.
     3880               when 'is-use':U then do:     assign     p-news = true.   end.
     3881               when 'dop-doc':U then do:     assign     p-news = true.   end.
     3882               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     3883               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     3884               when 'form_km3':U then do:     assign     p-news = false.   end.
     3885               when 'bal_malina':U then do:     assign     p-news = false.   end.
     3886               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     3887               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     3888         otherwise do:
     3889           p-news = no.
     3890         end.
     3891       end.
     3892     end.
     3893   end procedure.
