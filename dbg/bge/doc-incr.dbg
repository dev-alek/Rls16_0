     5514            and buf_c-trn-doc.obj-code = p-obj-code
     5515            and buf_c-trn-doc.is-del   = yes
     5516       on error undo, return error
     5517       :
     5518         _export-block:
     5519         do transaction
     5520         on error undo _export-block , return error return-value
     5521         :
     5522           if buf_c-trn-doc.bge-date = ?
     5523           then do:
     5524             if v-bge-xml-bgeflold = "oracle":u
     5525             then do:
     5526               output stream stmxmlout close.
