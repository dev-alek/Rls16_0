     5556                   , input 0
     5557                   , input v-date-from
     5558                   , input 0
     5559                   , input v-date-to
     5560                   , input 0
     5561                   , input v-obj-list
     5562                   , input buf_c-trn-doc.ext-doc-type
     5563                   , input p-pay-code
     5564                   , input p-cst
     5565                   , input p-parts
     5566                   , input p-chk-pay-code
     5567                   , input p-pay-desk
     5568                   , input p-pay-desk-cards
     5569                   , input no
     5570                   , input no
     5571               ).
     5572               OUTPUT STREAM stmXMLOut TO VALUE( v-exp-ora-filename + "xm1" ) CONVERT TARGET "1251" APPEND.
     5573               run wp-XMLWriteLog in this-procedure ( input sLogFile
     5574                                                     , input 1
     5575                                                     , input substitute( "Выгрузка удаленного документа &1 в пакет &2."
     5576                                                                       , buf_c-trn-doc.doc-code
     5577                                                                       , v-exp-ora-filename + "xml"
     5578                                                                       )
     5579                                                     ).
     5580             end.
     5581             assign
