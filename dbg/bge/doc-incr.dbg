     6844           run wp-xmltagput( 5, "transportr", string( abs( buf_ot-line-crsa-loop.transport-rubl ) ), 2 ).
     6845           run wp-xmltagput( 5, "otherr",     string( abs( buf_ot-line-crsa-loop.other-rubl     ) ), 2 ).
     6846           run wp-xmltagput( 5, "exciser",    string( abs( buf_ot-line-crsa-loop.excise-rubl    ) ), 2 ).
     6847           run wp-xmltagput( 5, "sumb",       string( abs( buf_ot-line-crsa-loop.sum-base       ) ), 2 ).
     6848           run wp-xmltagput( 5, "VATb",       string( abs( buf_ot-line-crsa-loop.vat-base       ) ), 2 ).
     6849           run wp-xmltagput( 5, "SLTb",       string( abs( buf_ot-line-crsa-loop.slt-base       ) ), 2 ).
     6850           run wp-xmltagput( 5, "roadTaxb",   string( abs( buf_ot-line-crsa-loop.road-tax-base  ) ), 2 ).
     6851           run wp-xmltagput( 5, "transportb", string( abs( buf_ot-line-crsa-loop.transport-base ) ), 2 ).
     6852           run wp-xmltagput( 5, "otherb",     string( abs( buf_ot-line-crsa-loop.other-base     ) ), 2 ).
