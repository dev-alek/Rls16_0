     6898                           run wp-xmltagput( 8, "VATr",        string( abs( temp_cost_cli_ot-supp-line.vat-rubl         ) ), 2 ).
     6899                           run wp-xmltagput( 8, "SLTr",        string( abs( temp_cost_cli_ot-supp-line.slt-rubl         ) ), 2 ).
     6900                           run wp-xmltagput( 8, "roadTaxr",    string( abs( temp_cost_cli_ot-supp-line.road-tax-rubl    ) ), 2 ).
     6901                           run wp-xmltagput( 8, "transportr",  string( abs( temp_cost_cli_ot-supp-line.transport-rubl   ) ), 2 ).
     6902                           run wp-xmltagput( 8, "otherr",      string( abs( temp_cost_cli_ot-supp-line.other-rubl       ) ), 2 ).
     6903                           run wp-xmltagput( 8, "exciser",     string( abs( temp_cost_cli_ot-supp-line.excise-rubl      ) ), 2 ).
     6904                           run wp-xmltagput( 8, "sumb",        string( abs( temp_cost_cli_ot-supp-line.sum-base         ) ), 2 ).
     6905                           run wp-xmltagput( 8, "VATb",        string( abs( temp_cost_cli_ot-supp-line.vat-base         ) ), 2 ).
     6906                           run wp-xmltagput( 8, "SLTb",        string( abs( temp_cost_cli_ot-supp-line.slt-base         ) ), 2 ).
     6907                           run wp-xmltagput( 8, "roadTaxb",    string( abs( temp_cost_cli_ot-supp-line.road-tax-base    ) ), 2 ).
     6908                           run wp-xmltagput( 8, "transportb",  string( abs( temp_cost_cli_ot-supp-line.transport-base   ) ), 2 ).
     6909                           run wp-xmltagput( 8, "otherb",      string( abs( temp_cost_cli_ot-supp-line.other-base       ) ), 2 ).
     6910                           run wp-xmltagput( 8, "exciseb",     string( abs( temp_cost_cli_ot-supp-line.excise-base      ) ), 2 ).
     6911                           run wp-xmltagclose( 7,  "cost" ).
     6912                           find first buf_sale_ot-supp-line no-lock
     6913                                   where buf_sale_ot-supp-line.doc-code    = p-doc-code
     6914                                   and buf_sale_ot-supp-line.cli-type    = temp_cost_cli_ot-supp-line.cli-type
     6915                                   and buf_sale_ot-supp-line.cli-code    = temp_cost_cli_ot-supp-line.cli-code
     6916                                   and buf_sale_ot-supp-line.artic       = temp_cost_cli_ot-supp-line.artic
     6917                                   and buf_sale_ot-supp-line.prod-type   = temp_cost_cli_ot-supp-line.prod-type
     6918                                   and buf_sale_ot-supp-line.prod-code   = temp_cost_cli_ot-supp-line.prod-code
     6919                                   and buf_sale_ot-supp-line.sum-type    = 'sale':U
     6920                                   and buf_sale_ot-supp-line.cat-id      = '##':U
     6921                           no-error.
     6922                           if available buf_sale_ot-supp-line
     6923                           then do:
     6924                               run wp-xmltagopen( 7, "sale", "" ).
     6925                               if buf_sale_ot-supp-line.sum-rubl < 0
