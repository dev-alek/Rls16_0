     5720       define variable v-other-rubl        as decimal      no-undo.
     5721       define variable v-today             as date         no-undo.
     5722       define variable v-time              as integer      no-undo.
     5723       define variable v-scale-is-empty    as logical      no-undo.
     5724              define variable ii                      as integer   no-undo.
     5725           define variable v-attrcode              as char no-undo.
     5726           define variable v-SectionName           as char no-undo.
     5727           define variable v-DocQnty               as decimal no-undo.
     5728           define variable v-CliQnty               as decimal no-undo.
     5729           define variable v-FactQnty              as decimal no-undo.
     5730           define variable v-FactDensity           as decimal no-undo.
     5731           define variable v-DocDensity            as decimal no-undo.
     5732           define variable v-TankVol               as decimal no-undo.
     5733           define variable v-TankDensity           as decimal no-undo.
     5734           define variable v-TankDensityPomi       as decimal no-undo.
     5735           define variable v-TankVolPomi           as decimal no-undo.
     5736           define variable v-tank-vol              as decimal   no-undo .
     5737           define variable v-tank-density          as decimal   no-undo .
     5738           define variable v-SectionNum            as integer   no-undo.
     5739           define variable v-total-tank-density    as decimal   no-undo.
     5740           define variable v-tankweight            as decimal   no-undo.
     5741           define variable v-sum-parts             as decimal   no-undo.
     5742       define buffer buf_ot-tot-sale           for ub.ot-tot.
     5743       define buffer buf_ot-tot-cost           for ub.ot-tot.
     5744       define buffer buf_ot-tot-crsa           for ub.ot-tot.
     5745       define buffer buf_ot-tot-crsa-loop      for ub.ot-tot.
     5746       define buffer buf_ot-line-sale          for ub.ot-line.
     5747       define buffer buf_ot-line-cost          for ub.ot-line.
     5748       define buffer buf_ot-line-crsa          for ub.ot-line.
     5749       define buffer buf_ot-line-crsa-loop     for ub.ot-line.
     5750       define buffer buf_cost_ot-supp-line     for ub.ot-supp-line.
     5751       define buffer buf_sale_ot-supp-line     for ub.ot-supp-line.
     5752       define buffer buf_cost_ot-supp-tot      for ub.ot-supp-tot.
     5753       define buffer buf_sale_ot-supp-tot      for ub.ot-supp-tot.
     5754       define buffer buf_doc-line              for ub.doc-line.
     5755       define buffer buf_parts                 for ub.parts.
     5756       define buffer buf_parts-attr            for ub.parts-attr.
     5757       define buffer buf_parts-root            for parts-root.
     5758       define buffer buf_doc-line-sum          for ub.doc-line-sum.
     5759       define buffer buf_inkas                 for ub.inkas.
     5760       define buffer buf_units                 for ub.units.
     5761       define buffer buf_price-list            for ub.price-list.
     5762       define buffer buf_doc-line-attr         for ub.doc-line-attr.
     5763       define buffer buf_doc-pl                for ub.doc-pl.
     5764   do
     5765   for buf_ot-tot-sale
     5766     , buf_ot-tot-cost
     5767     , buf_ot-tot-crsa
     5768     , buf_ot-tot-crsa-loop
     5769     , buf_ot-line-sale
     5770     , buf_ot-line-cost
     5771     , buf_ot-line-crsa
     5772     , buf_ot-line-crsa-loop
     5773     , buf_cost_ot-supp-line
     5774     , buf_sale_ot-supp-line
     5775     , buf_cost_ot-supp-tot
     5776     , buf_sale_ot-supp-tot
     5777     , buf_doc-line
     5778     , buf_parts
     5779     , buf_parts-attr
     5780     , buf_parts-root
     5781     , buf_doc-line-sum
     5782     , buf_inkas
     5783     , buf_units
     5784     , buf_price-list
     5785   on error undo, return error return-value
     5786   on endkey undo, return error return-value
     5787   :
     5788       find first buf_ot-tot-crsa-loop no-lock
     5789            where buf_ot-tot-crsa-loop.doc-code    = p-doc-code
     5790              and buf_ot-tot-crsa-loop.sum-type    = 'crsa':U
     5791              and buf_ot-tot-crsa-loop.cat-id      = '##,##':U
     5792       no-error.
     5793       if not available buf_ot-tot-crsa-loop
     5794       then do:
     5795           run wp-XMLWriteLog( sLogFile, 1, substitute("Для документа &1 не найдена запись в архиве." , p-doc-code )).
     5796           undo, return error .
     5797       end.
     5798       assign
     5799           v-obj-type = buf_ot-tot-crsa-loop.obj-type
     5800           v-obj-code = buf_ot-tot-crsa-loop.obj-code
     5801       .
     5802       case p-ext-doc-type
     5803       :
     5804           when 'ot':U
     5805           then do:
     5806               find first buf_ot-tot-sale no-lock
     5807                    where buf_ot-tot-sale.doc-code = p-doc-code
     5808                      and buf_ot-tot-sale.sum-type = 'crsa':U
     5809                      and buf_ot-tot-sale.cat-id   = buf_ot-tot-crsa-loop.cat-id
     5810               no-error.
     5811               if not available buf_ot-tot-sale
     5812               then do:
     5813                   run wp-XMLWriteLog( sLogFile, 1, "Не найден документ переоценки " + string( p-doc-code ) ).
     5814                   undo, return error.
     5815               end.
     5816           end.
     5817           otherwise do:
     5818               find first buf_ot-tot-sale no-lock
     5819                    where buf_ot-tot-sale.doc-code = p-doc-code
     5820                      and buf_ot-tot-sale.sum-type = 'sale':U
     5821                      and buf_ot-tot-sale.cat-id   = buf_ot-tot-crsa-loop.cat-id
     5822               no-error.
     5823               if not available buf_ot-tot-sale
     5824               then do:
     5825                   find first buf_ot-tot-sale no-lock
     5826                        where buf_ot-tot-sale.doc-code = p-doc-code
     5827                          and buf_ot-tot-sale.sum-type = 'sasr':U
     5828                          and buf_ot-tot-sale.cat-id   = buf_ot-tot-crsa-loop.cat-id
     5829                   no-error.
     5830               end.
     5831               if not available buf_ot-tot-sale
     5832               then do:
     5833                   if buf_ot-tot-crsa-loop.fact-qnty <> 0
     5834                   then do:
     5835                       run wp-XMLWriteLog( sLogFile, 1, "В архивах нет записей sum-type = 'sale':U или 'sasr':U для документа номер " + string( p-doc-code ) + " ( ext-doc-type = " + p-ext-doc-type + ")" ).
     5836                   end.
     5837               end.
     5838               else do:
     5839                   if buf_ot-tot-crsa-loop.fact-qnty <> buf_ot-tot-sale.fact-qnty
     5840                   then do:
     5841                       run wp-XMLWriteLog( sLogFile, 1, "Не совпадает фактическое количество для записей архивов sum-type = 'sale':U и 'crsa':U для документа номер " + string( p-doc-code ) + " ( ext-doc-type = " + p-ext-doc-type + ")" ).
     5842                   end.
     5843               end.
     5844           end.
     5845       end case.
     5846       run wp-XMLWriteCnt( hcnt, "   " + string( p-doc-code ) + " от " + string( p-fact-date ) ) .
     5847       process events.
     5848       run write-doc-header in this-procedure (
     5849             input v-obj-type
     5850           , input v-obj-code
     5851           , input p-ext-doc-type
     5852           , input p-doc-code
     5853           , input p-doc-date
     5854           , input p-fact-date
     5855           , input p-reason-code
     5856           , input p-doc-PS
     5857           , input p-fact-order
     5858           , input p-sys-date
     5859           , input p-sys-time
     5860           , input p-firm-code
     5861           , input p-ord-num
     5862           , input p-ship-num
     5863           , input p-ship-date
     5864           , input p-payment-code
     5865           , input p-hold-doc-code-child
     5866           , input p-hold-doc-code-parent
     5867           , input p-hold-obj-type
     5868           , input p-hold-obj-code
     5869           , input p-out-code
     5870           , input p-supp-dog-code
     5871           , input p-supp-ndog
     5872           , input p-supp-ddog
     5873           , input p-d-card
     5874           , input p-cli-type
     5875           , input p-cli-code
     5876       ) no-error.
     5877       if p-ext-doc-type <> 'ot':U
     5878       and p-pay-code = yes
     5879       or ( p-chk-pay-code = yes
     5880       and ( p-ext-doc-type = 'es':U or p-ext-doc-type = 'rs':U ) )
     5881       then do:
     5882               case p-ext-doc-type :
     5883                   when 'es':U
     5884                   then do:
     5885                       assign
     5886                           v-is-out                = 1
     5887                           v-inkas-pay-desk-type   = 'при':U
     5888                       .
     5889                       find first buf_inkas no-lock
     5890                               where buf_inkas.inkas-code = p-doc-code
     5891                       no-error.
     5892                   end.
     5893                   when 'rs':U
     5894                   then do:
     5895                       assign
     5896                           v-is-out                = -1
     5897                           v-inkas-pay-desk-type   = 'рас':U
     5898                       .
     5899                       find first buf_inkas no-lock
     5900                               where buf_inkas.inkas-code = p-out-code
     5901                       no-error.
     5902                   end.
     5903               end case.
     5904               if available buf_inkas
     5905               then do:
     5906                   run bge/bgepych2.p (
     5907                         input buf_inkas.inkas-code
     5908                       , input p-ext-doc-type
     5909                       , input p-pay-desk
     5910                       , input p-pay-desk-cards
     5911                       , input yes
     5912                       , input yes
     5913                       , input yes
     5914                   ) no-error.
     5915                   if ERROR-STATUS:error then do:
     5916                       run wp-XMLWriteLog(  sLogFile, 1, error-status:get-message(1) + string( p-doc-code ) ).
     5917                   end.
     5918                   if p-pay-code = yes
     5919                   then do:
     5920                       run get-inkas-pay-desk in this-procedure (
     5921                             input buf_inkas.inkas-code
     5922                           , input buf_inkas.obj-type
     5923                           , input buf_inkas.obj-code
     5924                           , input v-inkas-pay-desk-type
     5925                       ) no-error .
     5926                       if error-status:error
     5927                       then do:
     5928                           run wp-XMLWriteLog(  sLogFile, 1, "*** ERR: *** Не удалось рассчитать разбивку по кодам оплат по документу N "+ string( p-doc-code ) ).
     5929                       end.
     5930                       run wp-xmltagopen( 3, "cassSum","" ).
     5931                       for each temp_inkas-pay
     5932                       on error undo, return error
     5933                       :
     5934                           run wp-xmltagopen( 4, "payCode", "" ).
     5935                           run wp-xmltagput( 5, "code", string( temp_inkas-pay.pay-code ), 0 ).
     5936                           run wp-xmltagput( 5, "sum",  string( v-is-out * temp_inkas-pay.tot-sum ),  1 ).
     5937                           run wp-xmltagput( 5, "sumb", string( v-is-out * temp_inkas-pay.tot-base ), 1 ).
     5938                           run wp-xmltagput( 5, "sumr", string( v-is-out * temp_inkas-pay.tot-rubl ), 1 ).
     5939                           run wp-xmltagclose( 4, "payCode" ).
     5940                       end.
     5941                       run wp-xmltagclose( 3, "cassSum" ).
     5942                   end.
     5943               end.
     5944               else do:
     5945                   if p-ext-doc-type = 'es':U
     5946                   or p-ext-doc-type = 'rs':U
     5947                   then do:
     5948                       run wp-XMLWriteLog(  sLogFile, 1, "*** ERR: *** Не найден inkas для документа расхода или возврата по кассе N " + string( p-doc-code ) ).
     5949                   end.
     5950               end.
     5951       end.
     5952       if available buf_ot-tot-sale
     5953       then do:
     5954           run wp-xmltagopen( 3, "docSum","" ).
     5955           run wp-xmltagput( 4, "sumr"      , string( abs( buf_ot-tot-sale.sum-rubl       ) ), 1 ).
     5956           if p-is-envd_ eq NO then
     5957             run wp-xmltagput( 4, "VATr"      , string( abs( buf_ot-tot-sale.vat-rubl     ) ), 1 ).
     5958           else
     5959             run wp-xmltagput( 4, "VATr"      , string( abs( p-sum-all-parts              ) ), 1 ).
     5960           run wp-xmltagput( 4, "SLTr"      , string( abs( buf_ot-tot-sale.slt-rubl       ) ), 1 ).
     5961           run wp-xmltagput( 4, "roadTaxr"  , string( abs( buf_ot-tot-sale.road-tax-rubl  ) ), 1 ).
     5962           run wp-xmltagput( 4, "transportr", string( abs( buf_ot-tot-sale.transport-rubl ) ), 1 ).
     5963           run wp-xmltagput( 4, "otherr"    , string( abs( buf_ot-tot-sale.other-rubl     ) ), 1 ).
     5964           run wp-xmltagput( 4, "exciser"   , string( abs( buf_ot-tot-sale.excise-rubl    ) ), 1 ).
     5965           run wp-xmltagput( 4, "sumb"      , string( abs( buf_ot-tot-sale.sum-base       ) ), 1 ).
     5966           run wp-xmltagput( 4, "VATb"      , string( abs( buf_ot-tot-sale.vat-base       ) ), 1 ).
     5967           run wp-xmltagput( 4, "SLTb"      , string( abs( buf_ot-tot-sale.slt-base       ) ), 1 ).
     5968           run wp-xmltagput( 4, "roadTaxb"  , string( abs( buf_ot-tot-sale.road-tax-base  ) ), 1 ).
     5969           run wp-xmltagput( 4, "transportb", string( abs( buf_ot-tot-sale.transport-base ) ), 1 ).
     5970           run wp-xmltagput( 4, "otherb"    , string( abs( buf_ot-tot-sale.other-base     ) ), 1 ).
     5971           run wp-xmltagput( 4, "exciseb"   , string( abs( buf_ot-tot-sale.excise-base    ) ), 1 ).
     5972           run wp-xmltagclose( 3, "docSum" ).
     5973       end.
     5974       if p-ext-doc-type <> 'ot':U
     5975       then do:
     5976           find first buf_ot-tot-cost no-lock
     5977                where buf_ot-tot-cost.doc-code    = p-doc-code
     5978                  and buf_ot-tot-cost.sum-type    = 'cost':U
     5979                  and buf_ot-tot-cost.cat-id      = '##,##':U
     5980           no-error.
     5981           if not available buf_ot-tot-cost
     5982           then do:
     5983               find first buf_ot-tot-cost no-lock
     5984                    where buf_ot-tot-cost.doc-code    = p-doc-code
     5985                      and buf_ot-tot-cost.sum-type    = 'cssr':U
     5986                      and buf_ot-tot-cost.cat-id      = '##,##':U
     5987               no-error.
     5988           end.
     5989           if available buf_ot-tot-cost
     5990           then do:
     5991               run wp-xmltagopen( 3, "costSum", "" ).
     5992               run wp-xmltagput( 4, "sumr",        string( abs( buf_ot-tot-cost.sum-rubl       ) ), 1 ).
     5993               if p-is-envd_ eq NO then
     5994                 run wp-xmltagput( 4, "VATr",        string( abs( buf_ot-tot-cost.vat-rubl     ) ), 1 ).
     5995               else
     5996                 run wp-xmltagput( 4, "VATr",        string( abs( p-sum-all-parts              ) ), 1 ).
     5997               run wp-xmltagput( 4, "SLTr",        string( abs( buf_ot-tot-cost.slt-rubl       ) ), 1 ).
     5998               run wp-xmltagput( 4, "roadTaxr",    string( abs( buf_ot-tot-cost.road-tax-rubl  ) ), 1 ).
     5999               run wp-xmltagput( 4, "transportr",  string( abs( buf_ot-tot-cost.transport-rubl ) ), 1 ).
     6000               run wp-xmltagput( 4, "otherr",      string( abs( buf_ot-tot-cost.other-rubl     ) ), 1 ).
     6001               run wp-xmltagput( 4, "exciser",     string( abs( buf_ot-tot-cost.excise-rubl    ) ), 1 ).
     6002               run wp-xmltagput( 4, "sumb",        string( abs( buf_ot-tot-cost.sum-base       ) ), 1 ).
     6003               run wp-xmltagput( 4, "VATb",        string( abs( buf_ot-tot-cost.vat-base       ) ), 1 ).
     6004               run wp-xmltagput( 4, "SLTb",        string( abs( buf_ot-tot-cost.slt-base       ) ), 1 ).
     6005               run wp-xmltagput( 4, "roadTaxb",    string( abs( buf_ot-tot-cost.road-tax-base  ) ), 1 ).
     6006               run wp-xmltagput( 4, "transportb",  string( abs( buf_ot-tot-cost.transport-base ) ), 1 ).
     6007               run wp-xmltagput( 4, "otherb",      string( abs( buf_ot-tot-cost.other-base     ) ), 1 ).
     6008               run wp-xmltagput( 4, "exciseb",     string( abs( buf_ot-tot-cost.excise-base    ) ), 1 ).
     6009               run wp-xmltagclose( 3, "costSum" ).
     6010           end.
     6011           else do:
     6012               if available buf_ot-tot-sale
     6013               then do:
     6014                   run wp-XMLWriteLog( sLogFile, 1, "*** ERR: *** В архиве не найдена запись с sum-type = 'cost':U или 'cssr':U для документа " + string( p-doc-code ) ).
     6015               end.
     6016           end.
     6017           for each temp_cost_cat-id_ot-supp-tot no-lock
     6018           on error undo, return error
     6019           :
     6020               delete temp_cost_cat-id_ot-supp-tot.
     6021           end.
     6022           for each temp_cost_cli_ot-supp-tot no-lock
     6023           on error undo, return error
     6024           :
     6025               delete temp_cost_cli_ot-supp-tot.
     6026           end.
     6027           for each buf_cost_ot-supp-tot no-lock
     6028               where buf_cost_ot-supp-tot.doc-code = p-doc-code
     6029           on error undo, return error
     6030           :
     6031               if buf_cost_ot-supp-tot.sum-type = 'cost':U + 'p':U
     6032               then do:
     6033                   find first temp_cost_cat-id_ot-supp-tot
     6034                           where temp_cost_cat-id_ot-supp-tot.cat-id   = buf_cost_ot-supp-tot.cat-id
     6035                   no-error.
     6036                   if not available temp_cost_cat-id_ot-supp-tot
     6037                   then do:
