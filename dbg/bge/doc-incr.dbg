     3903               when 'paycard-edit-prefix':U then do:     assign     p-hist = true.   end.
     3904               when 'form_km3':U then do:     assign     p-hist = true.   end.
     3905               when 'bal_malina':U then do:     assign     p-hist = true.   end.
     3906               when 'max_proc_sum':U then do:     assign     p-hist = true.   end.
     3907               when 'mask_card_kup':U then do:     assign     p-hist = true.   end.
     3908         otherwise do:
