     6123                           temp_cost_cli_ot-supp-line.cli-code          = buf_cost_ot-supp-line.cli-code
     6124                           temp_cost_cli_ot-supp-line.sum-rubl          = buf_cost_ot-supp-line.sum-rubl
     6125                           temp_cost_cli_ot-supp-line.vat-rubl          = buf_cost_ot-supp-line.vat-rubl
     6126                           temp_cost_cli_ot-supp-line.slt-rubl          = buf_cost_ot-supp-line.slt-rubl
