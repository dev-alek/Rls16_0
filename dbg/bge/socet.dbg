        1   block-level on error undo, throw.
        2   define variable vss-revision0    as character no-undo init "$Revision:$":U .
        3   define variable vss-author0      as character no-undo init "$Author:$":U .
        4   define variable vss-date0        as character no-undo init "$Date:$":U .
        5   define variable vss-workfile0    as character no-undo init "$Workfile:$":U .
        6   define variable vss-archive0     as character no-undo init "$Archive:$":U .
        7   define variable vss-description0 as character no-undo init "Работа С сокетом".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   procedure PutMesAsunc:
       13       define input  parameter Itext as character no-undo.
       14       define variable vflag as logical no-undo.
       15       Publish "WriteLogAsunc" (Itext, yes)  .
       16   end.
       17   procedure PutMesAsuncNoTime:
       18       define input  parameter Itext as character no-undo.
       19       define variable vflag as logical no-undo.
       20       Publish "WriteLogAsunc" (Itext,no)  .
       21   end.
       22   procedure PutStatAsunc:
       23       define input  parameter Itext as character no-undo.
       24       Publish "PutStatAsunc" (Itext,no) .
       25        run
       26       PutMesAsunc (itext).
       27   end.
       28   procedure PutStatAsuncNoTime:
       29       define input  parameter Itext as character no-undo.
       30       Publish "PutStatAsunc" (Itext,no)  .
       31        run
       32       PutMesAsuncNoTime (itext).
       33   end.
       34   procedure PutStatAsuncAdd:
       35       define input  parameter Itext as character no-undo.
       36       Publish "PutStatAsunc" (Itext,yes)  .
       37   end.
       38   procedure PutFileLogAsunc:
       39       define input  parameter IFile as character no-undo.
       40       Publish "PutFileLogAsunc" (ifile)  .
       41   end.
       42   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       43   define variable v-waitfram-action01         as character   no-undo .
       44   define variable v-waitfram-action02         as character   no-undo .
       45   define variable v-waitfram-action03         as character   no-undo .
       46   define variable mWaitFramTextBeg            as character   no-undo.
       47   define variable mWaitFramTextEnd            as character   no-undo.
       48   define variable mWaitFramView               as logical     no-undo.
       49   define variable mWaitProcEvent              as logical     no-undo init yes.
       50   define variable mWaitFramInterval           as integer     no-undo init 1 .
       51   define variable mWaitFramStop               as logical     no-undo.
       52   define variable mWaitFramStopUser           as logical     no-undo.
       53   define variable mWaitFramStopTimeOut        as logical     no-undo.
       54   define variable mWaitFramStartProc          as datetime-tz no-undo.
       55   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       56   define button B-WaitFramStop auto-end-key
       57        label "Стоп"
       58        size 10 by 1 tooltip "Остоновить процесс".
       59   define button B-viewProcInfo
       60        label "Информация"
       61        size 15 by 1 tooltip "Информация о процесс".
       62   define frame waitfram
       63     v-waitfram-action01 format "x(72)" no-label skip
       64     v-waitfram-action02 format "x(72)" no-label skip
       65     v-waitfram-action03 format "x(72)" no-label skip
       66     B-viewProcInfo
       67     B-WaitFramStop at row 4 col 30
       68     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       69     .
       70   define new global shared variable mBatchMode as logical no-undo init ?.
       71   define variable mFramBachModHandle as handle no-undo.
       72   mFramBachModHandle = frame waitfram:handle.
       73   define variable mFameOldVis as logical no-undo.
       74   define variable mVisCUrentVin as logical no-undo.
       75   if session:batch-mode
       76   then
       77      mBatchMode = yes.
       78   if mBatchMode = ? then do:
       79     mVisCUrentVin = current-window:visible.
       80     mFameOldVis = mFramBachModHandle:visible.
       81     mFramBachModHandle:visible  = yes.
       82     mBatchMode = mFramBachModHandle:visible ne yes.
       83     mFramBachModHandle:visible = mFameOldVis.
       84     current-window:visible = mVisCUrentVin.
       85   end.
       86    if  log-manager:logfile-name ne ?
       87     then DO:
       88         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
       89         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
       90         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
       91     end.
       92   on choose of B-WaitFramStop in frame waitfram
       93   do:
       94     mWaitFramStop = yes.
       95     mWaitFramStopUser = yes.
       96   end.
       97   function waitfram-check-timeout returns logical():
       98      define variable vtime as int64 no-undo.
       99      if mWaitFramStopTimeOut
      100      then
      101         return yes.
      102      vtime = ( now - mWaitFramStartProc ) / 1000 .
      103      if     mWaitFramTimeOut ne ?
      104         and mWaitFramTimeOut ne 0
      105         and mWaitFramTimeOut lt vtime
      106      then do:
      107         mWaitFramStopTimeOut = yes.
      108      end.
      109      return mWaitFramStopTimeOut.
      110   end.
      111   procedure waitfram-hide :
      112     if not session:batch-mode
      113     then do
      114     on error undo, return error return-value
      115     :
      116       pause 0 before-hide .
      117       if not mBatchMode then
      118         hide frame waitfram .
      119     if     not mWaitFramView
      120        and mWaitProcEvent
      121     then
      122       process events .
      123     end.
      124   end procedure.
      125   procedure waitfram-show :
      126     define input  parameter p-message as character no-undo .
      127     define variable v-left-margin as integer   no-undo .
      128     if not session:batch-mode
      129     then do
      130     on error undo, return error return-value
      131     :
      132       if length(p-message) <= 70 then do:
      133         assign
      134           v-left-margin = integer((70 - length(p-message)) / 2)
      135         .
      136         assign
      137           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      138         .
      139         assign
      140           v-waitfram-action01 = " "
      141           v-waitfram-action02 = " "
      142                                    + fill(" ", v-left-margin)
      143                                    + p-message
      144           v-waitfram-action03 = " "
      145         .
      146       end.
      147       else do:
      148         define variable vRindex1 as integer no-undo.
      149         define variable vRindex2 as integer no-undo.
      150         vRindex1 = r-index(p-message," ",70).
      151         if vRindex1 = 0
      152         then
      153            vRindex1 = 70.
      154         if length(p-message)  <= vRindex1 + 70 then do:
      155           assign
      156             v-waitfram-action01 = " "
      157             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      158             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      159           .
      160         end.
      161         else do:
      162           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      163           if vRindex2 <= vRindex1
      164           then
      165              vRindex2 = vRindex1 + 70.
      166           assign
      167             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      168             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      169             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      170           .
      171         end.
      172       end.
      173       B-viewProcInfo:visible   in frame waitfram = no.
      174       B-viewProcInfo:sensitive in frame waitfram = no.
      175       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      176       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      177       if  (   mWaitFramView
      178          or  mWaitProcEvent)
      179          and not mBatchMode
      180       then
      181          display
      182             v-waitfram-action01 skip
      183             v-waitfram-action02 skip
      184             v-waitfram-action03 skip
      185          with frame waitfram .
      186       if     mWaitFramView
      187          then do:
      188             if     mWaitFramInterval ne ?
      189                and not mBatchMode
      190             then
      191                wait-for go of frame waitfram pause mWaitFramInterval.
      192          end.
      193          else
      194             if     mWaitProcEvent
      195                and not mBatchMode
      196             then
      197                process events .
      198     end.
      199   end procedure.
      200      procedure waitfram-show-this:
      201         define input  parameter iInterval as int64 no-undo.
      202         define variable vtime as int64 no-undo.
      203         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      204         mWaitFramInterval = iInterval.
      205         run waitfram-show (substitute("&1&2 &3&4" ,
      206                                       mWaitFramTextBeg ,
      207                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      208                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      209                                       mWaitFramTextEnd
      210                                      )
      211                           ).
      212      end.
      213      procedure WaitFramRunPause:
      214         define input  parameter iInterval as dec no-undo.
      215         define variable vStart  as datetime-tz no-undo.
      216         define variable vend    as datetime-tz no-undo.
      217         define variable vint as int64 no-undo.
      218         define variable vOk as logical no-undo.
      219         vStart = now.
      220         vend   = vStart.
      221         publish "WaitFramPause" (iInterval,output vOk).
      222         vend   =  now.
      223         vint = vend - vStart.
      224         vint = iInterval - vint / 1000.
      225         if     not mWaitFramStop
      226            and (   vint > 0
      227                 or (    not vOk
      228                     and iInterval eq ?
      229                     )
      230                 )
      231         then
      232            run waitfram-show-this (iInterval).
      233         vend   =  now.
      234         vint = vend - vStart.
      235         vint = iInterval - vint / 1000.
      236         if     not mWaitFramStop
      237            and vint > 0
      238         then do:
      239            run gbl/pause.p (vint * 1000).
      240         end.
      241         if iInterval ne ?
      242         then
      243            publish "WaitFramStop".
      244         waitfram-check-timeout().
      245      end.
      246      procedure WaitFramWaitFor:
      247         define input  parameter iInterval as dec no-undo.
      248         assign
      249            mWaitFramStartProc   = now
      250            mWaitFramStopUser    = no
      251            mWaitFramStopTimeOut = no
      252         .
      253         block-wait:
      254         do while not mWaitFramStop:
      255            run WaitFramRunPause (iInterval).
      256            if  waitfram-check-timeout()
      257            then do:
      258               leave block-wait.
      259            end.
      260         end.
      261         run waitfram-hide.
      262      end.
      263   procedure waitfram-join :
      264     define input  parameter p-line-1  as character no-undo .
      265     define input  parameter p-line-2  as character no-undo .
      266     define input  parameter p-line-3  as character no-undo .
      267     define output parameter p-message as character no-undo .
      268     do
      269     on error undo, return error return-value
      270     :
      271       assign
      272         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      273                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      274                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      275       .
      276     end.
      277   end procedure.
      278   function waitfram-join-function returns character
      279     (input p-line-1 as character
      280     ,input p-line-2 as character
      281     ,input p-line-3 as character
      282     ).
      283     define variable v-message as character no-undo .
      284     run waitfram-join in this-procedure
      285       (input  p-line-1
      286       ,input  p-line-2
      287       ,input  p-line-3
      288       ,output v-message
      289       ) .
      290     return v-message .
      291   end function .
      292   define variable mHSocket       as handle      no-undo.
      293   define variable mWebRespHead   as longchar    no-undo.
      294   define variable mWebResp       as longchar    no-undo.
      295   define variable mWebRespMptr   as memptr      no-undo.
      296   define variable OerrMsg        as character   no-undo.
      297   define variable mFileLogSocet  as character   no-undo.
      298   define variable mReturnHttp    as logical     no-undo.
      299   define variable mAddTimeOut    as logical     no-undo init yes.
      300   define variable mSocetBegTime  as datetime-tz no-undo.
      301   define variable mSocetEndTime  as dec         no-undo.
      302   define variable mWriteRespFile as character   no-undo.
      303   define variable mTypeResponse  as character   no-undo init "POST".
      304   publish "getSocetLog" (output mFileLogSocet).
      305   if
      306      (   mFileLogSocet eq ""
      307       or mFileLogSocet eq ?)
      308      and session:debug-alert
      309   then
      310      mFileLogSocet = "socet.log".
      311   procedure ConectSocet:
      312      define input  parameter iHost       as character no-undo.
      313      define input  parameter iPort       as character no-undo.
      314      define input  parameter iUrl        as character no-undo.
      315      define input  parameter iPostData   as longchar  no-undo.
      316      define input  parameter iReturnType as character no-undo.
      317      define input  parameter iTimeOut    as decimal   no-undo.
      318      define input  parameter iSilent     as logical   no-undo.
      319      define input  parameter iTextWait   as character no-undo.
      320      mWaitFramTextBeg = iTextWait.
      321      run SendReqSocet (iHost, iPort, iUrl, iPostData, iReturnType, 'getResponse').
      322      if OerrMsg eq ""
      323      then
      324         run waitrespsocet (iTimeOut, iSilent, iTextWait).
      325      mSocetEndTime = (now - mSocetBegTime) / 1000.
      326   end.
      327   procedure SendReqSocet:
      328      define input  parameter iHost            as character no-undo.
      329      define input  parameter iPort            as character no-undo.
      330      define input  parameter iUrl             as character no-undo.
      331      define input  parameter iPostData        as longchar  no-undo.
      332      define input  parameter iReturnType      as character no-undo.
      333      define input  parameter iProcGetResponse as character no-undo.
      334      mSocetBegTime = now.
      335      run writeLogSocet in this-procedure (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
      336      assign
      337         mWebResp         = ""
      338         mWebResphead     = ""
      339         OerrMsg          = ""
      340         mReturnHttp      = iReturnType eq "xml" or iReturnType eq "http" or iReturnType eq "yes"
      341         iProcGetResponse = "getResponse"  when iProcGetResponse eq ? or iProcGetResponse eq ""
      342      .
      343      define variable vPostData as longchar                       no-undo.
      344      if    iHost eq ""
      345         or iHost eq ?
      346      then do:
      347         oErrMsg = substitute("Не задан host &1 или port &2.", ihost ,iport).
      348         run writeLogSocet in this-procedure (oErrMsg).
      349         return oErrMsg.
      350      end.
      351      run waitfram-show (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
      352      create socket mHSocket.
      353      mHSocket:connect('-H ' + iHost + ' -S ' + iPort) no-error.
      354      if mHSocket:connected() = false
      355      then do:
      356         run waitfram-hide .
      357         oErrMsg = substitute( "Не удалось установить соединение: &1" , error-status:get-message(1)).
      358         run writeLogSocet in this-procedure (oErrMsg).
      359         delete object mHSocket.
      360         return oErrMsg.
      361      end.
      362      run waitfram-show ("Отправка данных").
      363      mHSocket:set-read-response-procedure(iProcGetResponse).
      364      run PostRequest (
      365       input iUrl,
      366       input iHost + ":" + iPort,
      367       input iPostData
      368       ).
      369       run waitfram-hide .
      370   end.
      371   procedure WaitRespSocet:
      372      define input  parameter iTimeOut   as decimal   no-undo.
      373      define input  parameter iSilent    as logical   no-undo.
      374      define input  parameter iTextWait  as character no-undo.
      375      if    not valid-handle (mHSocket )
      376      then do:
      377         run writeLogSocet in this-procedure (substitute("Потерян объект соединения")).
      378         return "End connected".
      379      end.
      380      if mHSocket:connected() = false
      381      then do:
      382         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespSocet")).
      383         oErrMsg = "Not connected".
      384         return oErrMsg.
      385      end.
      386      mWaitFramView = if iSilent ne yes then yes else no.
      387      mWaitFramTextBeg = iTextWait.
      388      mWaitFramTimeOut = iTimeOut.
      389      mWaitFramTextEnd = "".
      390      mWaitFramStop = no.
      391      if mAddTimeOut
      392      then do:
      393         mWaitFramTimeOut = 300.
      394         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при уcтановке соодинения",mWaitFramTimeOut)).
      395      end.
      396      run writeLogSocet in this-procedure (substitute("Ожидаем ответ TimeOut &1 сек.",iTimeOut )).
      397      subscribe   to "WaitFramStop" anywhere run-procedure "WaitRespTestStop".
      398      run WaitFramWaitFor(1).
      399      unsubscribe "WaitFramStop".
      400      if mWaitFramStopUser
      401      then do:
      402         OerrMsg = substitute("Операция прервана пользователем." ).
      403         run writeLogSocet in this-procedure (OerrMsg).
      404      end.
      405      else if mWaitFramStopTimeOut
      406      then do:
      407         OerrMsg = substitute("Привышено время ожидания &1 сек. Ответ не получен.",iTimeOut ).
      408         run writeLogSocet in this-procedure (OerrMsg).
      409      end.
      410      run waitfram-hide .
      411      mHSocket:disconnect() no-error.
      412      delete object mHSocket.
      413   end.
      414   procedure WaitRespTestStop:
      415      if mWaitFramStopTimeOut
      416      then
      417         return.
      418      if     (mWebResp ne ""
      419          and mWebResp ne ?)
      420      then do:
      421         mWaitFramStop = yes.
      422         return.
      423      end.
      424      else if mHSocket:connected() = false
      425      then do:
      426         mWaitFramStop = yes.
      427         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespTestStop")).
      428         oErrMsg = "Not connected".
      429         return oErrMsg.
      430      end.
      431      wait-for read-response of mHSocket pause 0.001.
      432   end.
      433   procedure PostRequest:
      434      define input parameter iPostUrl  as char.
      435      define input parameter iPostHost as char.
      436      define input parameter iPostData as longchar.
      437      define variable vCRequest      as longchar.
      438      define variable vMRequest       as memptr.
      439      if iPostUrl ne ?
      440      then do:
      441         vCRequest =substitute(
      442         '&5 /&2 HTTP/1.1&1'                                   +
      443         'Host: &4&1'                                           +
      444         'User-Agent: Apache-HttpClient/4.1.1 (java 1.5)&1'    +
      445         'Accept: */*&1' +
      446         'Content-Type: text/xml&1'               +
      447         'Content-Length: &3&1'                                  +
      448         '&1'
      449         ,
      450         chr(13) + chr(10),
      451         iPostUrl,
      452         length(iPostData),
      453         iPostHost,
      454         mTypeResponse) + iPostData.
      455      end.
      456      else
      457         vCRequest = iPostData.
      458      run writeLogSocet in this-procedure (substitute("Отправляем запрос &1.",chr(13) + chr(10) )).
      459      run writeLogSocet in this-procedure (vCRequest).
      460      SET-SIZE(vMRequest)            = 0.
      461      SET-SIZE(vMRequest)            = length(vCRequest) + 1.
      462      SET-BYTE-ORDER(vMRequest)      = big-endian.
      463      PUT-STRING(vMRequest,1)        = vCRequest .
      464      if mHSocket:connected() = false then
      465      do:
      466         run writeLogSocet in this-procedure ("Соединение было разорвано другой стороной getResponse").
      467         oErrMsg = "Not connected".
      468         delete object mHSocket no-error.
      469         return oErrMsg.
      470      end.
      471      mHSocket:write(vMRequest, 1, length(vCRequest)).
      472      run writeLogSocet in this-procedure ("Запрос отправлен.").
      473   end procedure.
      474   function hex-to-int returns integer (
      475     input p-hex-code  as character  ).
      476     define variable v-int-code as integer   no-undo .
      477     define variable v-ind      as integer   no-undo .
      478     define variable v-digit    as integer   no-undo .
      479     define variable v-letter   as character no-undo .
      480     do v-ind = 1 to length(p-hex-code)
      481     :
      482       assign
      483         v-letter = caps(substring(p-hex-code, v-ind, 1))
      484       .
      485       assign
      486         v-digit = index('123456789ABCDEF':u, v-letter)
      487       .
      488       assign
      489         v-int-code = v-int-code * 16 + v-digit
      490       .
      491     end.
      492     return v-int-code .
      493   end function .
      494   procedure getResponse:
      495      define variable vFlagTag     as logical          no-undo init no.
      496      define variable vResponse    as memptr           no-undo.
      497      define variable vCnt         as int64            no-undo.
      498      define variable vMessage     as longchar         no-undo.
      499      define variable v-cont-length as int64 no-undo.
      500      define variable vi           as integer no-undo.
      501      define variable v-hd-line    as character no-undo.
      502      define variable level        as integer no-undo initial 2.
      503      repeat while program-name(level) <> ?:
      504        if program-name(level) = program-name(1) then do:
      505          run writeLogSocet in this-procedure (substitute("Повторный вызов getResponse.")).
      506          return "".
      507        end.
      508        level = level + 1.
      509      end.
      510      if mHSocket:connected() = false then
      511      do:
      512         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной getResponse")).
      513         oErrMsg = "Not connected".
      514         return oErrMsg.
      515      end.
      516      if mAddTimeOut
      517      then do:
      518         mWaitFramTimeOut = 1000.
      519         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при получении ответа",mWaitFramTimeOut)).
      520      end.
      521      run writeLogSocet in this-procedure (substitute("Получаем ответ")).
      522      mWaitFramTextEnd = "Получаем ответ".
      523      define variable vWaitProcEvent as logical no-undo.
      524      vWaitProcEvent = mWaitProcEvent.
      525      mWaitProcEvent = no.
      526      run WaitFramRunPause (?).
      527      define variable vByte as int64 no-undo.
      528      define variable vNextMese as int64 no-undo init 100000.
      529      define variable VFlag as logical no-undo init ? .
      530      mWaitFramStop = no.
      531      mWaitFramStopTimeOut = no.
      532      block-wait:
      533      do while mHSocket:get-bytes-available() > 0:
      534         VFlag = no.
      535         define variable vNumByte as integer no-undo.
      536         vNumByte =   mHSocket:get-bytes-available().
      537         if vNumByte > 30000 then vNumByte = 30000.
      538         SET-SIZE(vResponse) = vNumByte + 1.
      539         SET-BYTE-ORDER(vResponse) = big-endian.
      540         mHSocket:read(vResponse,1,vNumByte).
      541         vMessage = vMessage + GET-STRING(vResponse,1).
      542         if  mReturnHTTp
      543         then do:
      544            vCnt = index(vMessage,chr(13) + chr(10) + chr(13) + chr(10)).
      545            if vCnt > 0
      546            then do:
      547               mReturnHttp = no.
      548               mWebResphead = substring (vMessage,1,vCnt).
      549               vMessage     = substring (vMessage,vCnt + 4).
      550               mWebResphead = replace (mWebResphead,";",chr(13) + chr(10)).
      551               do vi = 1 to num-entries(mWebResphead,chr(13) + chr(10)):
      552                  v-hd-line = trim(entry(vi,mWebResphead,chr(13) + chr(10))).
      553                  if  v-hd-line  begins "Content-Length"  then  do:
      554                     v-cont-length = INT(trim(substring(v-hd-line,16,length(v-hd-line)))).
      555                  end.
      556                  else if v-hd-line  begins "Transfer-Encoding"
      557                  then do :
      558                     define variable vChunked as logical no-undo.
      559                     vchunked = index(v-hd-line,"chunked",19) > 0.
      560                  end.
      561               end.
      562            end.
      563         end.
      564         vByte = vByte + vNumByte.
      565         SET-SIZE(vResponse) = 0.
      566         if v-cont-length > 0 and length (vMessage) >= v-cont-length
      567         then
      568            leave block-wait.
      569         if not mHSocket:get-bytes-available() > 0
      570         then do:
      571            VFlag = yes.
      572            run WaitFramRunPause (?).
      573            run gbl/pause.p (1000) .
      574         end.
      575         else if vByte > vNextMese
      576         then do:
      577            vNextMese = vNextMese + 100000.
      578            mWaitFramTextEnd = substitute ("Получаем ответ прочитано &1 байт ",vByte) .
      579            run WaitFramRunPause (?).
      580         end.
      581         if mWaitFramStopTimeOut
      582         then do:
      583            mWebResp = "".
      584            leave block-wait.
      585         end.
      586      end.
      587      if VFlag ne false
      588      then
      589         run writeLogSocet in this-procedure (substitute ("Завершена обработка &1",If VFlag eq  yes then " 0 байт за последнию секунду" else " пустой ответ(((")).
      590      mWaitFramStop = yes.
      591      run writeLogSocet         in this-procedure ("Получен ответ").
      592      run writeLogSocetOnlyText in this-procedure (mWebResphead).
      593      run writeLogSocetOnlyText in this-procedure (substitute("&1&2&1&2",chr(13) , chr(10) )).
      594      run writeLogSocetOnlyText in this-procedure (vMessage).
      595      run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
      596      mHSocket:disconnect() no-error.
      597      if v-cont-length > 0
      598      then
      599         mWebResp = substring (vMessage,1,v-cont-length).
      600      else if vChunked
      601      then do:
      602         define variable vByteCopy as int64 no-undo init 1.
      603         Block-Copy:
      604         do while length(vMessage) > 0:
      605            vByteCopy = 1.
      606            vCnt = index (vMessage,chr(13) + chr(10)) - 1.
      607            vByteCopy = vByteCopy +  vCnt + 2.
      608            v-cont-length = hex-to-int(string(substring (vMessage,1,vCnt))).
      609            if v-cont-length eq 0
      610            then
      611               leave Block-copy.
      612            mWebResp = mWebResp + substring (vMessage,vByteCopy,  v-cont-length).
      613            vByteCopy = vByteCopy + v-cont-length + 2.
      614            vMessage = substring  (vMessage,vByteCopy).
      615         end.
      616         run writeLogSocet         in this-procedure ("Заголовок").
      617         run writeLogSocetOnlyText in this-procedure (mWebResphead).
      618         run writeLogSocet         in this-procedure ("Тело ответа").
      619         run writeLogSocetOnlyText in this-procedure (mWebResp).
      620        run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
      621      end.
      622      else
      623         mWebResp = vMessage.
      624      mWaitProcEvent = vWaitProcEvent.
      625      mSocetEndTime = (now - mSocetBegTime) / 1000.
      626      copy-lob mWebResp to mWebRespMptr.
      627      if     mWriteRespFile ne ""
      628         and mWriteRespFile ne ?
      629      then
      630           run gbl/fileapnd.p
      631                ( mWriteRespFile
      632                , mWebResp + chr(13) + chr(10)
      633                ,input 10
      634                ) no-error .
      635   end procedure.
      636   procedure writeLogSocet:
      637      define input  parameter itext as longchar no-undo.
      638      if mFileLogSocet eq "Async"
      639      then
      640         run PutMesAsunc(itext).
      641      else if     mFileLogSocet ne ?
      642              and mFileLogSocet ne ""
      643      then do:
      644         run gbl/fileapnd.p
      645             ( mFileLogSocet
      646             , substitute("&1 &2 ", string(today), string(time, "HH:MM:SS"))
      647             ,input 10
      648             ) no-error .
      649         run writeLogSocetOnlyText(itext).
      650         run gbl/fileapnd.p
      651             ( mFileLogSocet
      652             , substitute(" &1&2", chr(13) , chr(10))
      653             ,input 10
      654             ) no-error .
      655      end.
      656   end.
      657   procedure writeLogSocetOnlyText:
      658      define input  parameter itext as longchar no-undo.
      659      if mFileLogSocet eq "Async"
      660      then
      661         run PutMesAsunc(itext).
      662      else if     mFileLogSocet ne ?
      663              and mFileLogSocet ne ""
      664      then do:
      665         if length(itext) > 32000
      666         then
      667            copy-lob
      668      from object itext
      669      to file mFileLogSocet append
      670      no-error
      671      .
      672         else
      673         run gbl/fileapnd.p
      674             ( mFileLogSocet
      675             , string(itext)
      676             ,input 10
      677             ) no-error .
      678      end.
      679   end.
      680   procedure Disconect:
      681      mHSocket:disconnect() no-error.
      682      delete object mHSocket no-error.
      683   end.
      684   define variable mAsyncProc as class ibs.th.file.AsyncProc.
      685   run ibs\th\file\getasyncproc.p (output mAsyncProc).
      686   define variable mstopAsunc as logical no-undo.
      687   function StopCheck returns logical:
      688      define variable oFlag as logical no-undo.
      689      run StopCheckAsync (output oFlag).
      690      return oFlag.
      691   end.
      692   procedure StopCheckAsync:
      693       define output  parameter oFlag as logical no-undo.
      694       if mstopAsunc
      695       then
      696          oFlag = mstopAsunc.
      697       else do:
      698          oFlag = mAsyncProc:CheckStop().
      699          mstopAsunc = oFlag.
      700       end.
      701   end.
      702   function GetParamAsunc returns character
      703   (input iNumPar as integer  ):
      704      return mAsyncProc:GetPARAM(iNumPar).
      705   end.
      706   function GetParamAsuncStr returns ibs.th.file.asyncparam
      707   (input iParamName as character ):
      708      return mAsyncProc:GetPARAM(iParamName).
      709   end.
      710          mAsyncProc:mProcPublish = this-procedure.
      711   procedure setParam:
      712      define input parameter iParamName  as character no-undo.
      713      define input parameter iParamValue as character no-undo.
      714      if iParamName eq "addTimeOut"
      715      then
      716         mAddTimeOut = logical(iParamValue) no-error.
      717      else if iParamName eq "TimeOut"
      718      then
      719         mWaitFramTimeOut = int(iParamValue).
      720      else if iParamName eq "FileLogSocet"
      721      then
      722         mFileLogSocet = iParamValue.
      723      else if iParamName eq "TypeResponce"
      724      then
      725         mTypeResponse = iParamValue.
      726   end.
      727   procedure isEndWork:
      728      define output parameter oWorkEnd as logical no-undo.
      729      oWorkEnd = mWaitFramStop.
      730   end.
      731   procedure getResponceMemptr:
      732      define output parameter oMemptr as memptr no-undo.
      733      if OerrMsg eq ""
      734      then
      735         oMemptr = mWebRespMptr.
      736      delete object mHSocket no-error.
      737   end.
      738   procedure getResponceLongchar:
      739      define output parameter oMemptr as longchar no-undo.
      740      if OerrMsg eq ""
      741      then
      742         oMemptr = mWebResp.
      743      delete object mHSocket no-error.
      744   end.
      745   procedure IsWorkSocet:
      746      define output parameter oValidSocet as logical no-undo.
      747      oValidSocet = valid-handle(mHSocket).
      748   end.
      749   on delete of this-procedure do:
      750      run Disconect.
      751   end.
