      188   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      189   procedure thbjattr_code :
      190      define input  parameter p-upper-code     as character no-undo .
      191      define input  parameter p-code           as character no-undo .
      192      define output parameter p-label          as character no-undo .
      193      define output parameter p-user-can-edit  as logical   no-undo .
      194      define output parameter p-output-display as logical   no-undo .
      195      define output parameter p-other          as character no-undo .
      196      define output parameter p-prop-list      as character no-undo .
      197      define output parameter p-prop-type-list as character no-undo .
      198      define output parameter p-prop-label-list as character no-undo .
      199      define output parameter p-global          as logical no-undo .
      200      define output parameter p-host           as logical no-undo .
      201      define output parameter p-shop           as logical no-undo .
      202      define output parameter p-store          as logical no-undo .
      203      define output parameter p-db             as logical no-undo .
      204      define variable p-region as logical no-undo.
      205      run thbjattr_code_reg in this-procedure (
      206                                               p-upper-code,
      207                                               p-code,
      208                                               output p-label,
      209                                               output p-user-can-edit,
      210                                               output p-output-display,
      211                                               output p-other,
      212                                               output p-prop-list,
      213                                               output p-prop-type-list,
      214                                               output p-prop-label-list,
      215                                               output p-global,
      216                                               output p-host,
      217                                               output p-shop,
      218                                               output p-store,
      219                                               output p-db,
      220                                               output p-region
      221                                               ).
      222   end procedure.
      223   procedure thbjattr_code_reg :
      224   define input  parameter p-upper-code     as character no-undo .
      225   define input  parameter p-code           as character no-undo .
      226   define output parameter p-label          as character no-undo .
      227   define output parameter p-user-can-edit  as logical   no-undo .
      228   define output parameter p-output-display as logical   no-undo .
      229   define output parameter p-other          as character no-undo .
      230   define output parameter p-prop-list      as character no-undo .
      231   define output parameter p-prop-type-list as character no-undo .
      232   define output parameter p-prop-label-list as character no-undo .
      233   define output parameter p-global          as logical no-undo .
      234   define output parameter p-host           as logical no-undo .
      235   define output parameter p-shop           as logical no-undo .
      236   define output parameter p-store          as logical no-undo .
      237   define output parameter p-db             as logical no-undo .
      238   define output parameter p-region         as logical no-undo .
      239   do
      240   on error undo, return error return-value
      241   :
      242       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      243       (input  p-upper-code
      244       ,input  p-code
      245       ,output p-label
      246       ,output p-user-can-edit
      247       ,output p-output-display
      248       ,output p-other
      249       ,output p-prop-list
      250       ,output p-prop-type-list
      251       ,output p-prop-label-list
      252       ,output p-global
      253       ,output p-host
      254       ,output p-shop
      255       ,output p-store
      256       ,output p-db
      257       ,output p-region
      258       ) no-error .
      259     if error-status :error
      260     then do:
      261       undo, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1)).
      262     end.
      263   end.
      264   end procedure.
