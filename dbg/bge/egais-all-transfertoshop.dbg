      439   procedure thbjattr_delete-section :
      440   define input  parameter p-obj-type   like ub.thbj-attr.obj-type   no-undo .
      441   define input  parameter p-obj-code   like ub.thbj-attr.obj-code   no-undo .
      442   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
      443   do
      444   on error undo, return error return-value
      445   :
      446       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_delete-section in g#attr-lib
      447       (input  p-obj-type
      448       ,input  p-obj-code
      449       ,input  p-upper-code
      450       ) no-error .
      451     if error-status :error
      452     then do:
      453       undo, return error return-value .
      454     end.
      455   end.
      456   end procedure.
      457   procedure thbjattr_manual-edit :
      458   define input  parameter p-ucode          as character no-undo .
      459   define input  parameter p-code           as character no-undo .
      460   define output parameter p-section-num    as integer no-undo .
      461   do
      462   on error undo, return error return-value
      463   :
      464       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_manual-edit in g#attr-lib
      465       (input  p-ucode
      466       ,input  p-code
      467       ,output  p-section-num
      468       ) no-error .
      469     if error-status :error
      470     then do:
      471       undo, return error return-value .
      472     end.
      473   end.
      474   end procedure.
      475   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      476   define temp-table tt-act-header
      477       field num           as character        label "№ акта"      format "X(30)"
      478       field date_         as date             label "Дата акта"
      479       field is-sent       as logical
      480       field answer_       as character        label "Ответ"       format "X(1500)"
      481       field RegID         as character        label "Рег. номер"  format "X(50)"
      482       index pi as primary unique
      483           num
      484   .
      485   define temp-table tt-gds-act
      486       field num           as character                label "№ акта"
      487       field position_     as integer                  label "№ пп"                    format ">>>9"
      488       field gds-code      like ub.goods.gds-code      label "Код товара   "
      489       field alc-code      as character                label "Алкогольный код"         format "X(21)"
      490       field gds-name      like ub.goods.gds-name      label "Наименование товара"     format "X(35)"
      491       field qnty          as decimal                  label "Количество"
      492       field inform-B      as character                label "Справка Б"               format "X(20)"
      493       index pi as primary unique
      494           position_
      495       index code
      496           gds-code
      497   .
      498   define variable sw as handle no-undo .
      499   define variable v-file              as character no-undo initial "TransferToShop1.xml".
      500   DEFINE VARIABLE hDoc AS HANDLE NO-UNDO.
      501   DEFINE VARIABLE hRoot AS HANDLE NO-UNDO.
      502   DEFINE VARIABLE good AS LOGICAL NO-UNDO.
      503   procedure makeXML :
      504       create sax-writer sw .
      505       sw:formatted = true.
      506       sw:set-output-destination ("file", v-file).
      507       sw:encoding = "UTF-8".
      508       sw:start-document () .
      509       sw:start-element ("ns:Documents") .
      510       sw:insert-attribute ("Version", "1.0") .
      511       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
      512       sw:insert-attribute ("xmlns:xs", "http://www.w3.org/2001/XMLSchema") .
      513       sw:insert-attribute ("xmlns:c", "http://fsrar.ru/WEGAIS/Common") .
      514       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef_v2") .
      515       sw:insert-attribute ("xmlns:tts", "http://fsrar.ru/WEGAIS/TransferToShop") .
      516           sw:start-element ("ns:Owner") .
      517               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
      518           sw:end-element ("ns:Owner") .
      519           sw:start-element ("ns:Document") .
      520               sw:start-element ("ns:TransferToShop") .
      521                   sw:write-data-element ("tts:Identity", tt-act-header.num) no-error .
      522                   sw:start-element ("tts:Header") .
      523                       sw:write-data-element ("tts:TransferNumber", tt-act-header.num) no-error .
      524                       sw:write-data-element ("tts:TransferDate", string(iso-date(tt-act-header.date_))) no-error .
      525                   sw:end-element ("tts:Header") .
      526                   sw:start-element ("tts:Content") .
      527       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
      528                       sw:start-element ("tts:Position") .
      529                           sw:write-data-element ("tts:Identity", string(tt-gds-act.position_)) no-error .
      530                           sw:write-data-element ("tts:Quantity", string(tt-gds-act.qnty)) no-error .
      531                           sw:write-data-element ("gds-code", string(tt-gds-act.gds-code)) no-error .
      532                           sw:write-data-element ("gds-name", tt-gds-act.gds-name) no-error .
      533                           sw:write-data-element ("alc-code", tt-gds-act.alc-code) no-error .
      534                           sw:start-element ("tts:InformB") .
      535                               sw:write-data-element ("pref:BRegId", tt-gds-act.inform-B) no-error .
      536                           sw:end-element ("tts:InformB") .
      537                       sw:end-element ("tts:Position") .
      538       end.
      539                   sw:end-element ("tts:Content") .
      540               sw:end-element ("ns:TransferToShop") .
      541           sw:end-element ("ns:Document") .
      542       sw:end-element ("ns:Documents") .
      543       sw:end-document () .
      544       delete object sw.
      545   end procedure .
      546   procedure makeXMLegais_v2 :
      547       create sax-writer sw .
      548       sw:formatted = true.
      549       sw:set-output-destination ("file", v-file).
      550       sw:encoding = "UTF-8".
      551       sw:start-document () .
      552       sw:start-element ("ns:Documents") .
      553       sw:insert-attribute ("Version", "1.0") .
      554       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
      555       sw:insert-attribute ("xmlns:xs", "http://www.w3.org/2001/XMLSchema") .
      556       sw:insert-attribute ("xmlns:c", "http://fsrar.ru/WEGAIS/Common") .
      557       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef_v2") .
      558       sw:insert-attribute ("xmlns:tts", "http://fsrar.ru/WEGAIS/TransferToShop") .
      559           sw:start-element ("ns:Owner") .
      560               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
      561           sw:end-element ("ns:Owner") .
      562           sw:start-element ("ns:Document") .
      563               sw:start-element ("ns:TransferToShop") .
      564                   sw:write-data-element ("tts:Identity", tt-act-header.num) .
      565                   sw:start-element ("tts:Header") .
      566                       sw:write-data-element ("tts:TransferNumber", tt-act-header.num) .
      567                       sw:write-data-element ("tts:TransferDate", string(iso-date(tt-act-header.date_))) no-error .
      568                   sw:end-element ("tts:Header") .
      569                   sw:start-element ("tts:Content") .
      570       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
      571           if tt-gds-act.qnty <= 0 or trim(tt-gds-act.inform-B) = "" or tt-gds-act.inform-B = ? then next.
      572                       sw:start-element ("tts:Position") .
      573                           sw:write-data-element ("tts:Identity", string(tt-gds-act.position_)) .
      574                           sw:write-data-element ("tts:ProductCode", tt-gds-act.alc-code) no-error .
      575                           sw:write-data-element ("tts:Quantity", string(tt-gds-act.qnty)) .
      576                           sw:start-element ("tts:InformF2") .
      577                             sw:write-data-element ("pref:F2RegId", tt-gds-act.inform-B) .
      578                           sw:end-element ("tts:InformF2") .
      579                       sw:end-element ("tts:Position") .
      580       end.
      581                   sw:end-element ("tts:Content") .
      582               sw:end-element ("ns:TransferToShop") .
      583           sw:end-element ("ns:Document") .
      584       sw:end-element ("ns:Documents") .
      585       sw:end-document () .
      586       delete object sw.
      587   end procedure .
      588   procedure parseXML :
      589       define input parameter inFile as character no-undo .
      590       empty temp-table tt-act-header .
      591       empty temp-table tt-gds-act .
      592       CREATE X-DOCUMENT hDoc.
      593       CREATE X-NODEREF hRoot.
      594       hDoc:encoding = 'utf-8'.
      595       hDoc:LOAD("file", search(inFile),FALSE).
      596       hDoc:GET-DOCUMENT-ELEMENT(hRoot).
      597       RUN GetChildren(hRoot, 1).
      598       DELETE OBJECT hDoc.
      599       DELETE OBJECT hRoot.
      600   end procedure .
      601   procedure GetChildren :
      602       DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
      603       DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
      604       DEFINE VARIABLE i AS INTEGER NO-UNDO.
      605       DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
      606       DEFINE VARIABLE hText AS HANDLE NO-UNDO.
      607       CREATE X-NODEREF hNoderef.
      608       CREATE X-NODEREF hText .
      609       REPEAT i = 1 TO hParent:NUM-CHILDREN:
      610           good = hParent:GET-CHILD(hNoderef,i).
      611           IF NOT good THEN
      612               LEAVE.
      613           IF hNoderef:SUBTYPE <> "element" THEN
      614               NEXT.
      615           hNoderef:GET-CHILD(hText, 1) no-error .
      616           IF hNoderef:NAME = "tts:Header" THEN do :
      617               create tt-act-header .
      618               assign tt-act-header.is-sent = bh-act-header:buffer-field("is-sent"):buffer-value no-error.
      619           end .
      620           .
      621           IF hNoderef:NAME = "tts:TransferNumber" THEN assign tt-act-header.num    = hText:node-value no-error .
      622           IF hNoderef:NAME = "tts:TransferDate" THEN
      623               assign tt-act-header.date_ = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
      624           IF hNoderef:NAME = "tts:Position" THEN do :
      625               assign ii = 0 .
      626               create tt-gds-act .
      627               assign tt-gds-act.num = tt-act-header.num .
      628           end.
      629           IF hNoderef:NAME = "tts:Identity" THEN assign tt-gds-act.position_ = integer(hText:node-value) no-error .
      630           IF hNoderef:NAME = "tts:Quantity" THEN assign tt-gds-act.qnty = decimal(hText:node-value) no-error .
      631           IF hNoderef:NAME = "pref:BRegId"
      632           OR hNoderef:NAME = "pref:F2RegId" THEN assign tt-gds-act.inform-B = (hText:node-value) no-error .
      633           IF hNoderef:NAME = "gds-code"     THEN do :
      634               assign tt-gds-act.gds-code = integer(hText:node-value) no-error .
      635               find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code no-error .
      636               if available buf_goods then assign tt-gds-act.gds-name = buf_goods.gds-name .
      637           end.
      638           if hNoderef:NAME = "gds-name" and trim(tt-gds-act.gds-name) = "" then assign tt-gds-act.gds-name = (hText:node-value) no-error .
      639           IF hNoderef:NAME = "alc-code"
      640           OR hNoderef:NAME = "tts:ProductCode"    THEN assign tt-gds-act.alc-code = (hText:node-value) no-error .
      641           run GetChildren (hNoderef, (level + 1)).
      642       END.
      643       DELETE OBJECT hNoderef.
      644       DELETE OBJECT hText.
      645   END procedure.
      646   DEFINE BUTTON Btn_lkp
      647        LABEL "Просмотр"
      648        SIZE 15 BY 1.13.
      649   DEFINE BUTTON Btn_create
      650        LABEL "Создать"
      651        SIZE 15 BY 1.13.
      652   DEFINE BUTTON Btn_chg
      653        LABEL "Изменить"
      654        SIZE 15 BY 1.13.
      655   DEFINE BUTTON Btn_del
      656        LABEL "Удалить"
      657        SIZE 15 BY 1.13.
      658   DEFINE BUTTON Btn_send
      659        LABEL "Отправить"
      660        SIZE 15 BY 1.13.
      661   DEFINE BUTTON Btn_OK AUTO-GO
      662        LABEL "Выход"
      663        SIZE 15 BY 1.13
      664        BGCOLOR 8 .
      665   DEFINE BUTTON Btn_Ans
      666        LABEL "Посмотреть ответ"
      667        SIZE 20 BY 1.13
      668        BGCOLOR 8 .
      669   DEFINE BUTTON Btn_Edit
      670        LABEL "Редактировать"
      671        SIZE 15 BY 1.13 tooltip "Вернуть в 'Новые' для редактирования"
      672        BGCOLOR 8 .
      673   DEFINE VARIABLE f-date AS DATE FORMAT "99/99/99":U
      674        LABEL "Дата с"
      675        VIEW-AS FILL-IN
      676        SIZE 9.5 BY 1 NO-UNDO.
      677   DEFINE VARIABLE f-date-2 AS DATE FORMAT "99/99/99":U
      678        LABEL "по"
      679        VIEW-AS FILL-IN
      680        SIZE 9.5 BY 1 NO-UNDO.
      681   DEFINE VARIABLE f-num AS character FORMAT "X(30)":U
      682        LABEL "номер"
      683        VIEW-AS FILL-IN
      684        SIZE 30 BY 1 NO-UNDO.
      685   DEFINE VARIABLE RADIO-SET-1 AS INTEGER INITIAL 1
      686        VIEW-AS RADIO-SET HORIZONTAL
      687        RADIO-BUTTONS
      688             "Новые", 1,
      689             "Отправленные", 2
      690        SIZE 27 BY 1.25 NO-UNDO.
      691   DEFINE FRAME Dialog-Frame
      692        Btn_OK AT ROW 1.2 COL 2
      693        Btn_create at row 1.2 col 17
      694        Btn_chg at row 1.2 col 32
      695        Btn_del at row 1.2 col 47
      696        Btn_send at row 1.2 col 62
      697        Btn_Ans AT ROW 1.2 COL 32 WIDGET-ID 10
      698        Btn_lkp AT ROW 1.2 COL 17 WIDGET-ID 12
      699            Btn_Edit AT ROW 1.2 COL 52
      700        RADIO-SET-1 AT ROW 1.2 COL 80 NO-LABEL WIDGET-ID 2
      701        f-date AT ROW 2.5 COL 8.63 COLON-ALIGNED WIDGET-ID 22
      702        f-date-2 AT ROW 2.5 COL 22.75 COLON-ALIGNED WIDGET-ID 26
      703        f-num AT ROW 2.5 COL 45 COLON-ALIGNED WIDGET-ID 56
      704        SPACE(2) SKIP(22.2)
      705       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      706            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      707            TITLE "Передача продукции в торговый зал ЕГАИС"
      708            DEFAULT-BUTTON Btn_OK WIDGET-ID 100.
      709   ASSIGN
      710          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      711          FRAME Dialog-Frame:HIDDEN           = TRUE.
      712   ON window-close OF FRAME Dialog-Frame
      713   do:
      714       delete object egais no-error .
      715     apply "END-ERROR":U to self.
      716   end.
      717   ON CHOOSE OF Btn_lkp IN FRAME Dialog-Frame
      718   DO:
      719       if not bh-act-header:available then return no-apply .
      720       run bge/egais-TransferToShop.w (parparentproc, 'ПРОСМОТР':U, egais, v-ext-sys, v-fs-rar, bh-act-header:handle) .
      721   END.
      722   ON CHOOSE OF Btn_Edit IN FRAME Dialog-Frame
      723   DO:
      724       if not bh-act-header:available then return no-apply .
      725       find last buf_clob-bind where buf_clob-bind.field-name_ = 'egais-tts':U and buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value .
      726       entry(3, buf_clob-bind.descr, chr(4)) = string(no) no-error .
      727       entry(4, buf_clob-bind.descr, chr(4)) = "" no-error .
      728       entry(5, buf_clob-bind.descr, chr(4)) = "" no-error .
      729       bh-act-header:buffer-field ("is-sent"):buffer-value = string(no) no-error .
      730       bh-act-header:buffer-field ("answer_"):buffer-value = "" no-error .
      731       bh-act-header:buffer-field ("RegID"):buffer-value = "" no-error .
      732       find first ub.esys-all-attr
      733                   where ub.esys-all-attr.table-name = "esys-pck-sent"
      734                   and ub.esys-all-attr.attr-code = "egais"
      735                   and ub.esys-all-attr.key2       = 4
      736                   and ub.esys-all-attr.attr-value = buf_clob-bind.uniq-key-rec
      737                   no-error.
      738       if available (ub.esys-all-attr )
      739       then do:
      740         delete ub.esys-all-attr .
      741       end.
      742       run refresh-query .
      743   END.
      744   ON CHOOSE OF Btn_create IN FRAME Dialog-Frame
      745   DO:
      746       run bge/egais-TransferToShop.w (parparentproc, 'ДОБАВЛЕНИЕ':U, egais, v-ext-sys, v-fs-rar, bh-act-header:handle) .
      747       bh-act-header = egais:GetHndlTable(3, "").
      748       run refresh-query.
      749   END.
      750   ON CHOOSE OF Btn_chg IN FRAME Dialog-Frame
      751   DO:
      752       if not bh-act-header:available then return no-apply .
      753       v-act-num = bh-act-header:buffer-field ("num"):buffer-value .
      754       run bge/egais-TransferToShop.w (parparentproc, 'ИЗМЕНЕНИЕ':U, egais, v-ext-sys, v-fs-rar, bh-act-header:handle) .
      755       bh-act-header = egais:GetHndlTable(3, "").
      756       run refresh-query.
      757   END.
      758   ON CHOOSE OF Btn_del IN FRAME Dialog-Frame
      759   DO:
      760       if not bh-act-header:available then return no-apply .
      761       find last buf_clob-bind where buf_clob-bind.field-name_ = 'egais-tts':U and buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value .
      762       delete buf_clob-bind .
      763       bh-act-header:buffer-delete () .
      764       run refresh-query.
      765   END.
      766   ON CHOOSE OF Btn_send IN FRAME Dialog-Frame
      767   DO:
      768       if not bh-act-header:available then return no-apply .
      769       find last buf_clob-bind where buf_clob-bind.field-name_ = 'egais-tts':U and buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value .
      770       find first buf_clob-data no-lock where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
      771       os-delete "temp-TransferToShop.xml".
      772       copy-lob
      773       from  object buf_clob-data.cdata
      774       to  file 'temp-TransferToShop.xml'
      775       no-convert
      776       no-error .
      777       run parseXML in this-procedure (input "temp-TransferToShop.xml") .
      778       find first tt-act-header .
      779       v-file = 'TransferToShop.xml' .
      780       os-delete "TransferToShop.xml" .
      781       run makeXMLegais_v2 .
      782       egais:inNum = tt-act-header.num .
      783       egais:SendRequestUTM() .
      784       glog = egais:IsSent .
      785       glog = egais:StatusErr .
      786       if glog then do :
      787           message egais:Msg view-as alert-box.
      788           return no-apply.
      789       end.
      790       else do :
      791           entry (3, buf_clob-bind.descr, chr(4)) = "yes".
      792           bh-act-header:buffer-field ("is-sent"):buffer-value = true.
      793       end.
      794       run refresh-query.
      795       message "Акт " egais:inNum " отправлен" view-as alert-box .
      796   END.
      797   ON CHOOSE OF Btn_Ans IN FRAME Dialog-Frame
      798   DO:
      799     if not bh-act-header:available
      800       then return no-apply.
      801       v-act-num = bh-act-header:buffer-field ("num"):buffer-value .
      802         egais:inNum = bh-act-header:buffer-field ("num"):buffer-value .
      803         egais:GetHndlTable(2, bh-act-header:buffer-field ("num"):buffer-value) .
      804         glog = egais:StatusErr .
      805         if glog
      806         and (bh-act-header:buffer-field ("answer_"):buffer-value = ""
      807           or bh-act-header:buffer-field ("answer_"):buffer-value = ? )
      808         then do :
      809               message egais:Msg view-as alert-box.
      810               return no-apply.
      811         end.
      812         else message (bh-act-header:buffer-field ("answer_"):buffer-value) view-as alert-box information .
      813     run refresh-query.
      814   END.
      815   ON value-changed OF RADIO-SET-1 IN FRAME Dialog-Frame
      816   do:
      817     assign RADIO-SET-1 .
      818     if RADIO-SET-1 = 1
      819     then do :
      820       ENABLE Btn_create Btn_chg Btn_del Btn_send
      821         WITH FRAME Dialog-Frame.
      822       HIDE Btn_Ans Btn_lkp Btn_Edit in FRAME Dialog-Frame.
      823     end.
      824     else do :
      825       ENABLE Btn_Ans Btn_lkp Btn_Edit
      826         WITH FRAME Dialog-Frame.
      827       HIDE Btn_create Btn_chg Btn_del Btn_send in FRAME Dialog-Frame.
      828     end.
      829     run refresh-query.
      830   end.
      831   ON leave OF f-date IN FRAME Dialog-Frame
      832   do:
      833     run refresh-query.
      834   end.
      835   ON return OF f-date IN FRAME Dialog-Frame
      836   do:
      837     run refresh-query.
      838   end.
      839   ON leave OF f-date-2 IN FRAME Dialog-Frame
      840   do:
      841     run refresh-query.
      842   end.
      843   ON return OF f-date-2 IN FRAME Dialog-Frame
      844   do:
      845     run refresh-query.
      846   end.
      847   ON return OF f-num IN FRAME Dialog-Frame
      848   do:
      849     run refresh-query.
      850   end.
      851   if valid-handle(active-window) and frame Dialog-Frame:PARENT eq ?
      852   then frame Dialog-Frame:PARENT = active-window.
      853   MAIN-BLOCK:
      854   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
      855      on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
      856   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      857   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
      858     (output v-db-num
      859     ,output v-user-id
      860     ) no-error .
      861     empty temp-table thbjattr_thbj-attr .
      862     run adm/shattri.p (
      863          input "get":U
      864         ,input v-cntxt-obj-type
      865         ,input v-cntxt-obj-code
      866         ,input 'egais':U
      867         ,input 'egais-fsrar':U
      868         ,output v-value-character
      869         ,output v-value-date
      870         ,output v-value-decimal
      871         ,output v-value-integer
      872         ,output v-value-logical
      873         ,output v-value-type
      874         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      875         ) no-error .
      876     assign
      877       v-fs-rar = v-value-character
      878     .
      879     run adm/shattri.p (
      880          input "get":U
      881         ,input '':U
      882         ,input 0
      883         ,input 'egais':U
      884         ,input 'egais-exsys':U
      885         ,output v-value-character
      886         ,output v-value-date
      887         ,output v-value-decimal
      888         ,output v-value-integer
      889         ,output v-value-logical
      890         ,output v-value-type
      891         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      892         ) no-error .
      893     assign v-ext-sys = v-value-integer .
      894     egais = new TransferToShop (v-cntxt-obj-type, v-cntxt-obj-code, v-fs-rar, v-ext-sys).
      895     egais:DbNum = v-db-num .
      896     egais:User_Id = v-user-id .
      897     bh-act-header = egais:GetHndlTable(3, "").
      898     create query qh-act-header.
      899     f-date = date (now) - 31.
      900     f-date-2 = ?.
      901     run refresh-query.
      902     create browse browse-hdl-act-header
      903       assign
      904         title     = 'Акты о передаче продукции в торговый зал'
      905         frame     = frame Dialog-Frame:handle
      906         query     = qh-act-header
      907         x         = 10
      908         y         = 60
      909         width     = 104
      910         height    = 22
      911         visible   = true
      912         read-only = true
      913         sensitive = true
      914         separators = true
      915         column-resizable = true
      916         column-scrolling = true
      917         triggers:
      918         end triggers
      919     .
      920     on row-display of browse-hdl-act-header do :
      921         if valid-handle (calc-col-hndl) then do :
      922             if RADIO-SET-1 = 1 then calc-col-hndl:SCREEN-VALUE = "Новый" .
      923             else do :
      924               assign v-RegID = bh-act-header:buffer-field ("RegID"):buffer-value .
      925               if v-RegID = "" or v-RegID = ? or num-entries(v-RegID, CHR(5)) <> 2 then calc-col-hndl:SCREEN-VALUE = "Отправлен" .
      926               if num-entries(v-RegID, CHR(5)) = 2 then do :
      927                   if entry(2, v-RegID, CHR(5)) = "R" then do :
      928                       calc-col-hndl:SCREEN-VALUE = "Отклонен" .
      929                       calc-col-hndl:bgcolor = red_color .
      930                   end.
      931                   if entry(2, v-RegID, CHR(5)) = "A" then do :
      932                       calc-col-hndl:SCREEN-VALUE = "Принят" .
      933                       calc-col-hndl:bgcolor = green_color .
      934                   end.
      935               end.
      936             end.
      937         end.
      938         if valid-handle (calc-col-hndl2) then do :
      939             if RADIO-SET-1 = 1 then calc-col-hndl2:SCREEN-VALUE = " - " .
      940             else do :
      941               assign v-RegID = bh-act-header:buffer-field ("RegID"):buffer-value .
      942               calc-col-hndl2:SCREEN-VALUE = entry(1, v-RegID, CHR(5)) .
      943             end.
      944         end.
      945     end.
      946     ON value-changed OF browse-hdl-act-header
      947     do:
      948         if calc-col-hndl:SCREEN-VALUE = "Отклонен" then enable Btn_Edit with FRAME Dialog-Frame .
      949                                                    else disable Btn_Edit with FRAME Dialog-Frame .
      950     end.
      951     if not bh-act-header = ?
      952     then do:
      953       do ii = 1 to bh-act-header:num-fields - 3:
      954         bcol[ii] = browse-hdl-act-header:add-like-column('tt-act-header' + '.' + bh-act-header:buffer-field (ii):name, 0, 'FILL-IN').
      955       end.
      956           calc-col-hndl = browse-hdl-act-header:add-calc-column("char", "X(10)", "", "Статус") .
      957           calc-col-hndl2 = browse-hdl-act-header:add-calc-column("char", "X(20)", "", "RegID") .
      958       browse-hdl-act-header:get-browse-column (1):width-chars = 30.
      959       browse-hdl-act-header:get-browse-column (2):width-chars = 37.
      960           browse-hdl-act-header:get-browse-column (3):width-chars = 10.
      961           browse-hdl-act-header:get-browse-column (4):width-chars = 20.
      962     end.
      963     run enable_UI.
      964     apply "value-changed" to RADIO-SET-1 in frame Dialog-Frame.
      965     wait-for go of frame Dialog-Frame.
      966   end.
      967   run disable_UI.
      968   PROCEDURE disable_UI :
      969     HIDE FRAME Dialog-Frame.
      970   END PROCEDURE.
      971   PROCEDURE enable_UI :
      972     DISPLAY RADIO-SET-1 f-date f-date-2 f-num
      973         WITH FRAME Dialog-Frame.
      974     ENABLE Btn_OK RADIO-SET-1 f-date f-date-2 f-num
      975         WITH FRAME Dialog-Frame.
      976     VIEW FRAME Dialog-Frame.
      977   END PROCEDURE.
      978   PROCEDURE refresh-query :
      979   def var v-proposition  as char no-undo.
      980   if bh-act-header = ?
      981     then return .
      982     assign input frame Dialog-Frame
      983       f-date
      984       f-date-2
      985       f-num
      986     .
      987     v-proposition =
      988       (if f-date <> ? then " and tt-act-header.date_ >= " + string (f-date) else "") +
      989       (if f-date-2 <> ? then " and tt-act-header.date_ <= " + string (f-date-2) else "") +
      990       (if f-num <> ? and f-num <> "" then (" and tt-act-header.num matches '*" + f-num + "*'") else "")
      991       .
      992   case RADIO-SET-1 :
      993       when 1  then
      994       do:
      995         qh-act-header:query-close.
      996         qh-act-header:set-buffers (bh-act-header).
      997         qh-act-header:query-prepare ( substitute ("for each tt-act-header where not tt-act-header.is-sent &1 by tt-act-header.date_ descending", v-proposition) ).
      998         qh-act-header:query-open.
      999         bh-act-header:find-first ( "where tt-act-header.num = " + "'" + v-act-num + "'" + v-proposition) no-error .
     1000       end.
     1001       when 2  then
     1002       do:
     1003         qh-act-header:query-close.
     1004         qh-act-header:set-buffers (bh-act-header).
     1005         qh-act-header:query-prepare ( substitute ("for each tt-act-header where tt-act-header.is-sent &1 by tt-act-header.date_ descending", v-proposition) ).
     1006         qh-act-header:query-open.
     1007         bh-act-header:find-first ( "where tt-act-header.num = " + "'" + v-act-num + "'" + v-proposition ) no-error .
     1008       end.
     1009     end case.
     1010   if bh-act-header:available
     1011     then qh-act-header:reposition-to-rowid ( bh-act-header:rowid ) no-error.
     1012   if valid-handle (browse-hdl-act-header) then apply "value-changed" to browse-hdl-act-header.
     1013   end.
     1014   PROCEDURE proc-row-leave :
     1015     if false then do:
     1016       do ii = 1 to extent (bcol).
     1017         bcol[ii]:bgcolor = RED_COLOR.
     1018       end.
     1019     end.
     1020   end.
