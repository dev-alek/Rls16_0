     1597   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1598                                             INPUT iFlagEmpty AS INTEGER).
     1599       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1600       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1601           DO:
     1602               IF iFlagEmpty = 0                           THEN RETURN "".
     1603               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1604               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1605               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1606               ELSE RETURN "".
     1607           END.
     1608       ELSE DO:
     1609           run xmlchar-encode in this-procedure (
     1610                 input sToPlace
     1611               , output sToPlace
     1612           ).
     1613           ASSIGN
     1614               sToPlace = sParName + '="' + sToPlace + '"'
     1615           .
     1616           RETURN sToPlace.
     1617       END.
     1618   END FUNCTION.
     1619   function bge-xml-date returns character
     1620   ( input p-date as date )
     1621   :
     1622     define variable v-date-str as character no-undo .
     1623     run bge-xml-date-to-str in this-procedure ( input   p-date
     1624                                               , output  v-date-str
     1625                                               ) .
     1626     return v-date-str.
     1627   end function.
     1628   function bge-xml-str-date returns character
     1629   ( input p-date-str as character )
     1630   :
     1631     define variable v-date-str as character no-undo .
     1632     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1633                                                   , output  v-date-str
     1634                                                   ) .
     1635     return v-date-str.
     1636   end function.
     1637   function bge-xml-normalize-dec returns decimal
     1638   ( input p-val as decimal )
     1639   :
     1640     return (if p-val = ? then 0 else p-val) .
     1641   end function.
     1642   PROCEDURE wp-XMLTagOpen:
     1643   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1644   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1645   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1646       define variable v-out-string    as character    no-undo.
     1647   do
     1648   on error undo, return error
     1649   :
     1650       if v-bge-xml-bgefmt = "dbf":U
     1651       then do:
     1652       end.
     1653       else do:
     1654           assign
     1655               v-out-string = substitute( "&1&2<&3&4>"
     1656                                       , chr(10)
     1657                                       , fill( " ":U, 4 * iTagLevel)
     1658                                       , sTagName
     1659                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1660                               )
     1661           .
     1662           put stream stmXMLOut unformatted
     1663               v-out-string
     1664           .
     1665       end.
     1666   end.
     1667   END PROCEDURE.
     1668   PROCEDURE wp-XMLTagPut:
     1669     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1670     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1671     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1672     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1673       define variable v-out-string    as character    no-undo.
     1674   do
     1675   on error undo, return error
     1676   :
     1677       if v-bge-xml-bgefmt = "dbf":U
     1678       then do:
     1679           if v-bge-xml-dbf-file-name <> "":U
     1680           then do:
     1681               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1682               export stream stmXMLOut
     1683                   sTagName
     1684                   sParValue
     1685               .
     1686               output stream stmXMLOut close.
     1687           end.
     1688       end.
     1689       else do:
     1690           IF  iFlagEmpty = 1
     1691           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1692           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1693           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1694           THEN DO:
     1695               run xmlchar-encode in this-procedure (
     1696                   input sParValue
     1697                   , output sParValue
     1698               ).
     1699               assign
     1700                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1701                                               , chr(10)
     1702                                               , FILL(" ", 4 * iTagLevel)
     1703                                               , sTagName
     1704                                               , sParValue
     1705                               )
     1706               .
     1707               PUT STREAM stmXMLOut UNFORMATTED
     1708                   v-out-string
     1709               .
     1710           END.
     1711       end.
     1712   end.
     1713   END PROCEDURE.
     1714   PROCEDURE wp-XMLTagClose:
     1715   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1716   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1717       define variable v-out-string    as character    no-undo.
     1718   do
     1719   on error undo, return error
     1720   :
     1721       if v-bge-xml-bgefmt = "dbf":U
     1722       then do:
     1723       end.
     1724       else do:
     1725           assign
     1726               v-out-string = substitute( "&1&2</&3>"
     1727                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1728                                   , fill( " ", 4 * iTagLevel )
     1729                                   , sTagName
     1730                           )
     1731           .
     1732           PUT STREAM stmXMLOut UNFORMATTED
     1733               v-out-string
     1734           .
     1735       end.
     1736   end.
     1737   END PROCEDURE.
     1738   PROCEDURE wp-XMLWriteLog:
     1739     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1740     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1741     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1742   define variable v-str              as character no-undo .
     1743   define variable v-error-append     as logical   no-undo .
     1744   define variable v-error-append-msg as character no-undo .
     1745   assign
     1746     v-str = chr(10)
     1747             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1748             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1749     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1750     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1751     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1752   .
     1753   run bge/bge-log.p (input v-str) no-error .
     1754   if error-status:error then do:
     1755     assign
     1756       v-error-append     = yes
     1757       v-error-append-msg = return-value
     1758     .
     1759   end.
     1760   run gbl/fileapnd.p
     1761     ( input sFileName
     1762     , input v-str
     1763     , input 10
     1764     ) no-error .
     1765   if error-status:error then do:
     1766     assign
     1767       v-error-append     = yes
     1768       v-error-append-msg = substitute( "&1&2&3"
     1769                                       , v-error-append-msg
     1770                                       , chr(10)
     1771                                       , return-value
     1772                                       )
     1773     .
     1774   end.
     1775   if v-error-append
     1776   then do:
     1777     return error substitute( "&1" , v-error-append-msg ) .
     1778   end.
     1779   END PROCEDURE.
     1780   PROCEDURE wp-XMLWriteEDT:
     1781     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1782     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1783     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1784       if valid-handle ( hEDT )
     1785       then do:
     1786           hEDT :move-to-eof().
     1787           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1788                                           OR sToWrite = "&Line") THEN "" ELSE
     1789                                           cur-time-string-sec() + " ").
     1790           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1791                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1792                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1793           hEDT :insert-string(chr(10)).
     1794       end.
     1795       process events.
     1796       output to 'bgescn.txt' append.
     1797           put unformatted
     1798               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1799                                           OR sToWrite = "&Line") THEN "" ELSE
     1800                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1801               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1802                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1803                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1804           .
     1805       output close.
     1806   END PROCEDURE.
     1807   PROCEDURE wp-XMLShowCNT:
     1808     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1809       if valid-handle( hCNT )
     1810       then do:
     1811           ASSIGN hCNT :VISIBLE = TRUE.
     1812       end.
     1813   END PROCEDURE.
     1814   PROCEDURE wp-XMLHideCNT:
     1815     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1816       if valid-handle( hCNT )
     1817       then do:
     1818           ASSIGN hCNT :VISIBLE = FALSE.
     1819       end.
     1820   END PROCEDURE.
     1821   PROCEDURE wp-XMLWriteCNT:
     1822     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1823     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1824       if valid-handle( hCNT )
     1825       then do:
     1826           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1827       end.
     1828   END PROCEDURE.
     1829   procedure bge-xml-write-header:
     1830   do
     1831   on error undo, return error
     1832   :
     1833   define input parameter p-xml-file-name  as character        no-undo.
     1834   define input parameter p-doc-name       as character        no-undo.
     1835   define input parameter p-version        as character        no-undo.
     1836   define input parameter p-db-num         as integer          no-undo.
     1837   define input parameter p-date-from      as date             no-undo.
     1838   define input parameter p-shift-num-from as integer          no-undo.
     1839   define input parameter p-date-to        as date             no-undo.
     1840   define input parameter p-shift-num-to   as integer          no-undo.
     1841   define input parameter p-obj-list       as character        no-undo.
     1842   define input parameter p-doc-type-list  as character        no-undo.
     1843   define input parameter p-pay-code       as logical          no-undo.
     1844   define input parameter p-cst            as logical          no-undo.
     1845   define input parameter p-parts          as logical          no-undo.
     1846   define input parameter p-chk-pay-code   as logical          no-undo.
     1847   define input parameter p-pay-desk       as logical          no-undo.
     1848   define input parameter p-pay-desk-cards as logical          no-undo.
     1849   define input parameter p-deleted        as logical          no-undo.
     1850   define input parameter p-opened-docs    as logical          no-undo.
     1851   define variable v-out-string    as character    no-undo.
     1852   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1853   assign
     1854       v-out-string = substitute( "&1&2&3"
     1855                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1856                           , chr(10)
     1857                           , "<IBS_Trade_House>":U )
     1858   .
     1859   put stream stmXMLOut unformatted
     1860       v-out-string
     1861   .
     1862   run wp-XMLTagOpen(1, "header","").
     1863   if v-bge-xml-bgeflold = "oracle":u
     1864   then do:
     1865     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1866     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1867     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1868     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1869     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1870   end.
     1871   run wp-XMLTagOpen( 2, "manifest", "").
     1872   run wp-XMLTagOpen( 3, "document", "").
     1873   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1874   run wp-XMLTagput( 4, "description", "", 0).
     1875   run wp-XMLTagput( 4, "version", p-version, 0).
     1876   run wp-XMLTagclose( 3, "document" ).
     1877   run wp-XMLTagclose( 2, "manifest" ).
     1878   run wp-XMLTagclose( 1, "header" ).
     1879   run wp-XMLTagOpen(1, "options","").
     1880   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1881   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1882   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1883   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1884   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1885   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1886   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1887   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1888   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1889   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1890   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1891   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1892   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1893   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1894   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1895   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1896   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1897   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1898   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1899   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1900   run wp-XMLTagClose(1, "options").
     1901   run wp-XMLTagOpen( 1, "body", "" ).
     1902   output stream stmXMLOut close.
     1903   end.
     1904   end procedure.
     1905   procedure xml-bge-write-footer:
     1906   do
     1907   on error undo, return error return-value
     1908   :
     1909   define input parameter p-xml-file-name as character    no-undo.
     1910   define variable v-error-num     as integer           no-undo.
     1911   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1912   run wp-XMLTagClose( 1, "body" ).
     1913   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1914   output stream stmXMLOut close.
     1915   if v-bge-xml-bgeflold = "oracle":u
     1916   then do:
     1917     define variable v-tmp-file-name         as character no-undo .
     1918     define variable v-zip-file-name         as character no-undo .
     1919     define variable v-exch-file-name        as character no-undo .
     1920     define variable v-heap-file-name        as character no-undo .
     1921     define variable v-i                     as integer   no-undo .
     1922     define variable v-file-name             as character no-undo .
     1923     define variable v-arc                   as character no-undo .
     1924     define variable v-str                   as character no-undo .
     1925     define variable v-exch-tmp-file-name    as character no-undo .
     1926     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1927     define variable v-bge-xml-exch-dir      as character no-undo .
     1928     define variable v-bge-xml-heap-dir      as character no-undo .
     1929     define variable v-bge-xml-compress-heap as logical   no-undo .
     1930     define variable v-home-dir              as character no-undo .
     1931     define variable v-os-command            as character no-undo .
     1932     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1933     if v-home-dir = ?
     1934     then do:
     1935       undo, return error substitute( "&1&2&3"
     1936                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1937                                     , chr(10)
     1938                                     , "Обратитесь к администратору.":u
     1939                                     ).
     1940     end.
     1941     assign
     1942       v-home-dir = v-home-dir
     1943     .
     1944     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1945     if error-status :error
     1946     then do:
     1947       undo, return error substitute( "&1&2&3"
     1948                                     , "Неверно задан каталог экспорта.":u
     1949                                     , chr(10)
     1950                                     , "Обратитесь к администратору.":u
     1951                                     ).
     1952     end.
     1953     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1954     if v-bge-xml-exch-dir = ?
     1955     then do:
     1956       undo, return error substitute( "&1&2&3"
     1957                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1958                                     , chr(10)
     1959                                     , "Обратитесь к администратору.":u
     1960                                     ).
     1961     end.
     1962     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1963     if error-status :error
     1964     then do:
     1965       undo, return error substitute( "&1&2&3"
     1966                                     , "Неверно задан каталог экспорта (exch).":u
     1967                                     , chr(10)
     1968                                     , "Обратитесь к администратору.":u
     1969                                     ).
     1970     end.
     1971     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1972     if v-bge-xml-heap-dir = ?
     1973     then do:
     1974       undo, return error substitute( "&1&2&3"
     1975                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1976                                     , chr(10)
     1977                                     , "Обратитесь к администратору.":u
     1978                                     ).
     1979     end.
     1980     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1981     if error-status :error
     1982     then do:
     1983       undo, return error substitute( "&1&2&3"
     1984                                     , "Неверно задан каталог экспорта (heap).":u
     1985                                     , chr(10)
     1986                                     , "Обратитесь к администратору.":u
     1987                                     ).
     1988     end.
     1989     get-key-value section "BGE" key "heap-compress" value v-str.
     1990     assign
     1991       v-i = int(v-str)
     1992     no-error .
     1993     if v-i = ? or v-i = 0
     1994     then do:
     1995       assign
     1996         v-bge-xml-compress-heap = no
     1997       .
     1998     end.
     1999     else do:
     2000       assign
     2001         v-bge-xml-compress-heap = yes
     2002       .
     2003     end.
     2004     assign
     2005       v-arc = search( "exe/7za.exe":u )
     2006     .
     2007     if v-arc = ? or v-arc = ""
     2008     then do:
     2009       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     2010     end.
     2011     assign
     2012       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     2013       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     2014       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     2015       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     2016       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     2017       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     2018       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     2019     .
     2020     run gbl/del-file.p (input v-tmp-file-name) .
     2021     run gbl/del-file.p (input v-zip-file-name) .
     2022     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     2023     if v-error-num > 0
     2024     then do:
     2025         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     2026                                      , p-xml-file-name + "xm1":u
     2027                                      , v-tmp-file-name
     2028                                      , v-error-num
     2029                                      ).
     2030     end.
     2031     assign
     2032       v-os-command     = substitute( "&1 a -tzip &2 &3"
     2033                                    , v-arc
     2034                                    , v-zip-file-name
     2035                                    , v-tmp-file-name
     2036                                    )
     2037     .
     2038     os-command silent value ( v-os-command ) .
     2039     run gbl/del-file.p (input v-heap-file-name) .
     2040     if v-bge-xml-compress-heap = no
     2041     then do:
     2042       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     2043       if v-error-num > 0
     2044       then do:
     2045           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     2046                                        , v-tmp-file-name
     2047                                        , v-heap-file-name
     2048                                        , v-error-num
     2049                                        ) .
     2050       end.
     2051     end.
     2052     else do:
     2053       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     2054       if v-error-num > 0
     2055       then do:
     2056           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     2057                                        , v-zip-file-name
     2058                                        , v-heap-file-name
     2059                                        , v-error-num
     2060                                        ) .
     2061       end.
     2062     end.
     2063     run gbl/del-file.p (input v-tmp-file-name) .
     2064     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     2065     if error-status :error then do:
     2066       undo, return error substitute( "&1&2&3"
     2067                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     2068                                     , chr(10)
     2069                                     , "Обратитесь к администратору."
     2070                                     ).
     2071     end.
     2072     run gbl/del-file.p (input v-exch-file-name) .
     2073     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     2074     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     2075     if v-error-num > 0
     2076     then do:
     2077       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     2078                                     , v-zip-file-name
     2079                                     , v-exch-tmp-file-name
     2080                                     , v-error-num
     2081                                     ) .
     2082     end.
     2083     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     2084     if v-error-num > 0
     2085     then do:
     2086       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     2087                                     , v-exch-tmp-file-name
     2088                                     , v-exch-file-name
     2089                                     , v-error-num
     2090                                     ) .
     2091     end.
     2092     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     2093   end.
     2094   else do:
     2095     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     2096     if v-error-num > 0
     2097     then do:
     2098       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     2099                                     , p-xml-file-name + "xm1"
     2100                                     , p-xml-file-name + "xml"
     2101                                     , v-error-num
     2102                                     ) .
     2103     end.
     2104   end.
     2105   if opsys = "unix"
     2106   then do:
     2107       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     2108   end.
     2109   end.
     2110   end procedure.
     2111   procedure xml-bge-filename0:
     2112   define input parameter p-prefix   as character no-undo .
     2113   define input parameter p-name     as character no-undo .
     2114   define input parameter p-shared-process as logical no-undo .
     2115   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     2116   define output parameter p-xml-file-name  as character no-undo .
     2117   // define output parameter p-fullfnamenoext as character no-undo .
     2118   define output parameter p-locked         as logical      no-undo.
     2119   define variable v-fullfnamenoext as character no-undo .
     2120   define variable v-fileext        as character no-undo .
     2121   define variable v-fullfname      as character no-undo .
     2122   define variable v-error-num      as integer   no-undo .
     2123   do
     2124   on error undo, return error
     2125   :
     2126     case v-bge-xml-bgeflold :
     2127       when "old" then do:
     2128         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     2129         v-fileext       = ".xml":U .
     2130         v-fullfname     = v-fullfnamenoext + v-fileext .
     2131         p-xml-file-name = v-fullfname .
     2132         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     2133         if v-error-num > 0 then do:
     2134           return error.
     2135         end.
     2136       end.
     2137       when "var" then do:
     2138         case p-prefix :
     2139           when "doc" then do:
     2140             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     2141             v-fileext       = ".xml":U .
     2142             v-fullfname     = v-fullfnamenoext + v-fileext .
     2143             p-xml-file-name = v-fullfname .
     2144           end.
     2145           when "day" then do:
     2146             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     2147             v-fileext       = ".xml":U .
     2148             v-fullfname     = v-fullfnamenoext + v-fileext .
     2149             p-xml-file-name = v-fullfname .
     2150           end.
     2151           otherwise do:
     2152             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     2153             v-fileext       = ".xml":U .
     2154             v-fullfname     = v-fullfnamenoext + v-fileext .
     2155             p-xml-file-name = v-fullfname .
     2156           end.
     2157         end case.
     2158         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     2159         if v-error-num > 0 then do:
     2160           return error.
     2161         end.
     2162       end.
     2163       when "new" then do:
     2164                   run bge/genfname.p (
     2165                       input p-home-dir
     2166                       , input p-prefix
     2167                       , input ""
     2168                       , input "xml"
     2169                       , input ""
     2170                       , output p-xml-file-name
     2171                   ).
     2172       end.
     2173       when "no-parameter" then do:
     2174         if p-shared-process then do:
     2175                       run bge/genfname.p (
     2176                           input p-home-dir
     2177                           , input "d"
     2178                           , input ""
     2179                           , input "xml"
     2180                           , input ""
     2181                           , output p-xml-file-name
     2182                       ).
     2183         end.
     2184         else do:
     2185           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     2186           v-fileext       = ".xml":U .
     2187           v-fullfname     = v-fullfnamenoext + v-fileext .
     2188           p-xml-file-name = v-fullfname .
     2189           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     2190           if v-error-num > 0 then do:
     2191             return error.
     2192           end.
     2193         end.
     2194       end.
     2195     end case.
     2196     assign
     2197       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2198       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     2199     .
     2200   end .
     2201   end procedure .
     2202   procedure xml-bge-filename :
     2203   do
     2204   on error undo, return error
     2205   :
     2206   define input parameter p-prefix             as character    no-undo.
     2207   define input parameter p-name               as character    no-undo.
     2208   define input parameter p-shared-process     as logical      no-undo.
     2209   define output parameter p-xml-file-name     as character    no-undo.
     2210   define output parameter p-log-file-name     as character    no-undo.
     2211   define output parameter p-locked            as logical      no-undo.
     2212   define variable v-home-dir          as character no-undo .
     2213   define variable v-error-num         as integer   no-undo .
     2214   define variable v-bge-xml-heap-dir  as character no-undo .
     2215       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2216       if v-home-dir = ?
     2217       then do:
     2218           message
     2219             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2220             skip(1)
     2221             skip "Обратитесь к администратору."
     2222           view-as alert-box error.
     2223           undo, return error .
     2224       end.
     2225       if v-bge-xml-bgeflold <> "oracle"
     2226       then do:
     2227         assign
     2228             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     2229         .
     2230       end.
     2231       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2232       if error-status :error
     2233       then do:
     2234           message
     2235             skip "Неверно задан каталог экспорта."
     2236             skip(1)
     2237             skip "Обратитесь к администратору."
     2238           view-as alert-box error.
     2239           undo, return error .
     2240       end.
     2241       if v-bge-xml-bgefmt = "dbf":U
     2242       then do:
     2243           assign
     2244               p-xml-file-name = v-home-dir
     2245               p-locked        = no
     2246           .
     2247       end.
     2248       else do:
     2249           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     2250             output p-xml-file-name, output p-locked) .
     2251       end.
     2252       if v-bge-xml-bgeflold = "oracle"
     2253       then do:
     2254         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     2255         if v-bge-xml-heap-dir = ?
     2256         then do:
     2257           undo, return error substitute( "&1&2&3"
     2258                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     2259                                         , chr(10)
     2260                                         , "Обратитесь к администратору.":u
     2261                                         ).
     2262         end.
     2263         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     2264         if error-status :error
     2265         then do:
     2266           undo, return error substitute( "&1&2&3"
     2267                                         , "Неверно задан каталог экспорта (heap).":u
     2268                                         , chr(10)
     2269                                         , "Обратитесь к администратору.":u
     2270                                         ).
     2271         end.
     2272         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     2273           assign
     2274             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     2275           .
     2276         end.
     2277         else do:
     2278           assign
     2279             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     2280           .
     2281         end.
     2282       end.
     2283       else do:
     2284         assign
     2285             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     2286         .
     2287       end.
     2288       assign
     2289          v-bge-xml-static-log-file-name = p-log-file-name
     2290       .
     2291   end.
     2292   end procedure.
     2293   procedure bge-xml-read-config :
     2294   do
     2295   on error undo, return error return-value
     2296   :
     2297   define input  parameter p-last-date as date      no-undo .
     2298   define input  parameter p-db-num    as integer   no-undo .
     2299       define variable v-bgeclall      as character     no-undo.
     2300       define variable v-bgedict       as character     no-undo.
     2301       define variable v-bgeshift      as character     no-undo.
     2302       define variable v-par-type      as character     no-undo.
     2303       define variable v-bgeflnm       as character     no-undo.
     2304       define variable v-bgecliiv      as character     no-undo .
     2305       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     2306       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     2307       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     2308       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     2309       define variable v-db-num-str    as character     no-undo .
     2310       define variable v-param-type      as character  no-undo .
     2311       define variable v-value-character as character  no-undo .
     2312       define variable v-value-date      as date       no-undo .
     2313       define variable v-value-decimal   as decimal    no-undo .
     2314       define variable v-value-integer   as integer    no-undo .
     2315       define variable v-value-logical   as logical    no-undo .
     2316       define variable v-tth             as handle      no-undo .
     2317       run adm/shattri.p ( input "get":U
     2318                         , input  '':u
     2319                         , input  0
     2320                         , input  'bge-export':U
     2321                         , input  'bgeclall':U
     2322                         , output v-bgecliiv
     2323                         , output v-value-date
     2324                         , output v-value-decimal
     2325                         , output v-value-integer
     2326                         , output v-value-logical
     2327                         , output v-param-type
     2328                         , input-output table-handle v-tth
     2329                         ) no-error .
     2330       if error-status :error
     2331       then do:
     2332         assign
     2333           v-bge-xml-bgecliiv = no
     2334         .
     2335       end.
     2336       else do:
     2337         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     2338       end.
     2339       delete object v-tth.
     2340       assign
     2341           v-bge-xml-bgeclall = no
     2342           v-bge-xml-bgedict  = no
     2343       .
     2344       run adm/shattri.p ( input "get":U
     2345                         , input  '':u
     2346                         , input  0
     2347                         , input  'bge-export':U
     2348                         , input  'bgeclall':U
     2349                         , output v-value-character
     2350                         , output v-value-date
     2351                         , output v-value-decimal
     2352                         , output v-value-integer
     2353                         , output v-value-logical
     2354                         , output v-param-type
     2355                         , input-output table-handle v-tth
     2356                         ) no-error .
     2357       if error-status :error
     2358       then do:
     2359         assign
     2360           v-bge-xml-bgeclall = no
     2361         .
     2362       end.
     2363       else do:
     2364         assign
     2365           v-bge-xml-bgeclall = v-value-logical
     2366         .
     2367       end.
     2368       delete object v-tth.
     2369       run adm/shattri.p ( input "get":U
     2370                         , input  '':u
     2371                         , input  0
     2372                         , input  'bge-export':U
     2373                         , input  'bgedict':U
     2374                         , output v-value-character
     2375                         , output v-value-date
     2376                         , output v-value-decimal
     2377                         , output v-value-integer
     2378                         , output v-value-logical
     2379                         , output v-param-type
     2380                         , input-output table-handle v-tth
     2381                         ) no-error .
     2382       if error-status :error
     2383       then do:
     2384         assign
     2385           v-bge-xml-bgedict = no
     2386         .
     2387       end.
     2388       else do:
     2389         assign
     2390           v-bge-xml-bgedict = v-value-logical
     2391         .
     2392       end.
     2393       delete object v-tth.
     2394       run adm/shattri.p ( input "get":U
     2395                         , input  '':u
     2396                         , input  0
     2397                         , input  'bge-export':U
     2398                         , input  'bgefmt':U
     2399                         , output v-value-character
     2400                         , output v-value-date
     2401                         , output v-value-decimal
     2402                         , output v-value-integer
     2403                         , output v-value-logical
     2404                         , output v-param-type
     2405                         , input-output table-handle v-tth
     2406                         ) no-error .
     2407       if error-status :error
     2408       then do:
     2409         assign
     2410           v-bge-xml-bgefmt  = "xml":U
     2411         .
     2412       end.
     2413       else do:
     2414         assign
     2415           v-bge-xml-bgefmt  = v-value-character
     2416         .
     2417       end.
     2418       delete object v-tth.
     2419       run adm/shattri.p ( input "get":U
     2420                         , input  '':u
     2421                         , input  0
     2422                         , input  'bge-export':U
     2423                         , input  'bgeshift':U
     2424                         , output v-value-character
     2425                         , output v-value-date
     2426                         , output v-value-decimal
     2427                         , output v-value-integer
     2428                         , output v-value-logical
     2429                         , output v-param-type
     2430                         , input-output table-handle v-tth
     2431                         ) no-error .
     2432       if error-status :error
     2433       then do:
     2434         assign
     2435             v-bge-xml-shift-mode = no
     2436         .
     2437       end.
     2438       else do:
     2439         assign
     2440             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     2441         .
     2442       end.
     2443       delete object v-tth.
     2444       run adm/shattri.p ( input "get":U
     2445                         , input  '':u
     2446                         , input  0
     2447                         , input  'bge-export':U
     2448                         , input  'bgeflold':U
     2449                         , output v-value-character
     2450                         , output v-value-date
     2451                         , output v-value-decimal
     2452                         , output v-value-integer
     2453                         , output v-value-logical
     2454                         , output v-param-type
     2455                         , input-output table-handle v-tth
     2456                         ) no-error .
     2457       if error-status :error
     2458       then do:
     2459         assign
     2460           v-bge-xml-bgeflold = "no-parameter":U
     2461         .
     2462       end.
     2463       else do:
     2464         assign
     2465           v-bge-xml-bgeflold  = v-value-character
     2466         .
     2467       end.
     2468       delete object v-tth.
     2469       assign
     2470         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     2471         v-bge-xml-db-num-str  = v-db-num-str
     2472       .
     2473       if p-last-date <> ?
     2474       then do:
     2475           run adm/shattri.p ( input "get":U
     2476                             , input  '':u
     2477                             , input  0
     2478                             , input  'bge-export':U
     2479                             , input  'bgeflnm':U
     2480                             , output v-value-character
     2481                             , output v-value-date
     2482                             , output v-value-decimal
     2483                             , output v-value-integer
     2484                             , output v-value-logical
     2485                             , output v-param-type
     2486                             , input-output table-handle v-tth
     2487                             ) no-error .
     2488           if error-status :error
     2489           then do:
     2490             assign
     2491               v-bgeflnm = '':U
     2492             .
     2493           end.
     2494           else do:
     2495             assign
     2496               v-bgeflnm = v-value-character
     2497             .
     2498           end.
     2499           delete object v-tth.
     2500           if v-bge-xml-bgeflold = "var"
     2501           then do:
     2502               if v-bgeflnm = ?
     2503               or num-entries( v-bgeflnm ) < 2
     2504               then do:
     2505                   assign
     2506                       v-bge-xml-bgeflold = "new"
     2507                   .
     2508               end.
     2509               else do:
     2510                   assign
     2511                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     2512                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     2513                   .
     2514                   assign
     2515                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     2516                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     2517                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2518                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     2519                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     2520                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     2521                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2522                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     2523                   .
     2524               end.
     2525           end.
     2526       end.
     2527   end.
     2528   end procedure.
     2529   procedure bge-xml-get-ref-filename :
     2530   define input parameter p-in-file-name       as character        no-undo.
     2531   define output parameter p-home-dir          as character        no-undo.
     2532   define output parameter p-out-file-name     as character        no-undo.
     2533   define output parameter p-locked            as logical          no-undo.
     2534       define variable v-counter       as integer      no-undo.
     2535       define variable v-error-level   as integer      no-undo.
     2536   do
     2537   on error undo, return error
     2538   :
     2539       run bge/bge-ini.p (
     2540             input "bge"
     2541           , output p-home-dir
     2542       ).
     2543       if return-value <> "OK"
     2544       then do:
     2545           undo, return error.
     2546       end.
     2547       assign
     2548           p-home-dir = p-home-dir + "\dict":U
     2549       .
     2550       run bge/dir_cd.p (
     2551           input p-home-dir
     2552           , input "CA"
     2553       ).
     2554       if return-value = "ERROR"
     2555       then do:
     2556           undo, return error.
     2557       end.
     2558       assign
     2559           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     2560       .
     2561       assign
     2562           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     2563       .
     2564       wait-lock:
     2565       do v-counter = 1 TO 3
     2566       :
     2567           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     2568           if p-locked = no
     2569           then do:
     2570               leave wait-lock.
     2571           end.
     2572           else do:
     2573               readkey pause 1.
     2574           end.
     2575       END.
     2576       if p-locked = yes
     2577       then do:
     2578           undo, return error.
     2579       end.
     2580       run bge/os_copy.p (
     2581             input "D":U
     2582           , input p-out-file-name + "xml":U
     2583           , input "":U
     2584           , output v-error-level
     2585       ).
     2586       if v-error-level > 0
     2587       then do:
     2588           undo, return error.
     2589       end.
     2590   end.
     2591   end procedure.
     2592   procedure bge-xml-write-ref-header :
     2593   define input parameter p-bge-name as character        no-undo.
     2594   define input parameter p-file-name as character        no-undo.
     2595       define variable v-out-string    as character    no-undo.
     2596   do
     2597   on error undo, return error
     2598   :
     2599       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2600       put stream stmXMLOut unformatted
     2601           "<?xml version='1.0' encoding='windows-1251'?>":U
     2602       .
     2603       assign
     2604           v-out-string = substitute( "&1&2"
     2605                               , chr(10)
     2606                               , "<IBS_Trade_House>":U )
     2607       .
     2608       put stream stmXMLOut unformatted
     2609           v-out-string
     2610       .
     2611       run wp-XMLTagOpen( 1, "header", "" ).
     2612       if v-bge-xml-bgeflold = "oracle":u
     2613       then do:
     2614         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2615         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2616         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2617         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2618         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2619       end.
     2620       else do:
     2621         run wp-XMLTagOpen( 2, "delivery", "" ).
     2622         run wp-XMLTagOpen( 3, "to", "" ).
     2623         run wp-XMLTagClose( 3, "to" ).
     2624         run wp-XMLTagOpen( 3, "from", "" ).
     2625         run wp-XMLTagClose( 3, "from" ).
     2626         run wp-XMLTagClose( 2, "delivery" ).
     2627       end.
     2628       run wp-XMLTagOpen( 2, "manifest", "" ).
     2629       run wp-XMLTagOpen( 3, "document", "" ).
     2630       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2631       run wp-XMLTagPut( 4, "description", "", 0 ).
     2632       run wp-XMLTagClose( 3, "document" ).
     2633       run wp-XMLTagClose( 2, "manifest" ).
     2634       run wp-XMLTagClose( 1, "header" ).
     2635       run wp-XMLTagOpen( 1, "body", "" ).
     2636   end.
     2637   end procedure.
     2638   procedure bge-xml-write-ref-footer :
     2639   define input parameter p-file-name as character        no-undo.
     2640       define variable v-error-level   as integer      no-undo.
     2641   do
     2642   on error undo, return error
     2643   :
     2644       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2645       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2646       output stream stmXMLOut close.
     2647       run bge/os_copy.p (
     2648             input "M":U
     2649           , input p-file-name + "xm1":U
     2650           , input p-file-name + "xml":U
     2651           , output v-error-level
     2652       ).
     2653       if v-error-level > 0
     2654       then do:
     2655           undo, return error.
     2656       end.
     2657   end.
     2658   end procedure.
     2659   procedure bge-xml-out-dir :
     2660   define output parameter p-out-dir       as character    no-undo.
     2661   define output parameter p-log-file-name as character    no-undo.
     2662   do
     2663   on error undo, return error
     2664   :
     2665       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2666       if p-out-dir = ?
     2667       then do:
     2668           message
     2669             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2670                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2671             skip(1)
     2672             skip "Обратитесь к администратору."
     2673           view-as alert-box error.
     2674           undo, return error .
     2675       end.
     2676       if v-bge-xml-bgeflold <> "oracle" then assign
     2677         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2678       .
     2679       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2680       if error-status :error  then do:
     2681           run wp-XMLWriteLog in this-procedure (
     2682                 input p-log-file-name
     2683               , input 0
     2684               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2685                                   , p-out-dir
     2686                                   , return-value
     2687                                   , trim( error-status :get-message( 1 ) )
     2688                                   )
     2689           ).
     2690           undo, return error.
     2691       end.
     2692       assign
     2693           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2694           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2695       .
     2696   end.
     2697   end procedure.
     2698   procedure bge-xml-out-dir2 :
     2699   define output parameter p-out-dir       as character    no-undo.
     2700   define output parameter p-out-dirR      as character    no-undo.
     2701   define output parameter p-log-file-name as character    no-undo.
     2702   do
     2703   on error undo, return error
     2704   :
     2705       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2706       if p-out-dir = ?
     2707       then do:
     2708           message
     2709             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2710                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2711             skip(1)
     2712             skip "Обратитесь к администратору."
     2713           view-as alert-box error.
     2714           undo, return error .
     2715       end.
     2716       if v-bge-xml-bgeflold <> "oracle" then assign
     2717             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2718             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2719         .
     2720       else p-out-dirR = p-out-dir .
     2721       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2722       if error-status :error  then do:
     2723           run wp-XMLWriteLog in this-procedure (
     2724                 input p-log-file-name
     2725               , input 0
     2726               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2727                                   , p-out-dir
     2728                                   , return-value
     2729                                   , error-status :get-message( 1 )
     2730                                   )
     2731           ).
     2732           undo, return error.
     2733       end.
     2734       if p-out-dirR <> p-out-dir then do:
     2735         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2736         if error-status :error then do:
     2737           run wp-XMLWriteLog in this-procedure (
     2738                 input p-log-file-name
     2739               , input 0
     2740               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2741                                   , p-out-dirR
     2742                                   , return-value
     2743                                   , error-status :get-message( 1 )
     2744                                   )
     2745           ).
     2746           p-out-dirR = p-out-dir .
     2747         end.
     2748       end .
     2749       assign
     2750         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2751         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2752       .
     2753   end.
     2754   end procedure.
     2755   procedure bge-xml-out-file :
     2756   do
     2757   on error undo, return error
     2758   :
     2759   define input parameter p-out-dir            as character        no-undo.
     2760   define input parameter p-prefix             as character        no-undo.
     2761   define input parameter p-sheduled           as logical          no-undo.
     2762   define output parameter p-xml-file-name     as character        no-undo.
     2763   define output parameter p-locked            as logical          no-undo.
     2764   define variable v-home-dir      as character     no-undo.
     2765   define variable v-error-num     as integer       no-undo.
     2766   define variable v-today             as date         no-undo.
     2767   define variable v-time              as integer      no-undo.
     2768       if v-bge-xml-bgefmt = "dbf":U
     2769       then do:
     2770           assign
     2771               p-xml-file-name = p-out-dir
     2772               p-locked        = no
     2773           .
     2774       end.
     2775       else do:
     2776           if v-bge-xml-bgeflold = "firm":U
     2777           then do:
     2778               run bge/genfname.p (
     2779                     input p-out-dir
     2780                   , input p-prefix
     2781                   , input "":U
     2782                   , input "arj":U
     2783                   , input "":U
     2784                   , output p-xml-file-name
     2785               ).
     2786           end.
     2787           else do:
     2788               run bge/genfname.p (
     2789                     input p-out-dir
     2790                   , input p-prefix
     2791                   , input "":U
     2792                   , input "xml":U
     2793                   , input "":U
     2794                   , output p-xml-file-name
     2795               ).
     2796           end.
     2797           assign
     2798               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2799               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2800           .
     2801       end.
     2802   end.
     2803   end procedure.
     2804   procedure bge-xml-init-ext-doc-type :
     2805       define variable v-counter    as integer      no-undo.
     2806       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2807   do
     2808   for buf_temp_ext-doc-type
     2809   on error undo, return error
     2810   :
     2811       empty temp-table buf_temp_ext-doc-type.
     2812       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2813       :
     2814           create buf_temp_ext-doc-type.
     2815           assign
     2816               buf_temp_ext-doc-type.edt-key               = v-counter
     2817               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2818               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2819           .
     2820       end.
     2821   end.
     2822   end procedure.
     2823   procedure bge-xml-get-decimal-shift-num :
     2824   define input parameter p-shift-date     as date             no-undo.
     2825   define input parameter p-shift-num      as integer          no-undo.
     2826   define output parameter p-shift-decimal as decimal          no-undo.
     2827   do
     2828   on error undo, return error
     2829   :
     2830       assign
     2831           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2832       .
     2833   end.
     2834   end procedure.
     2835   procedure bge-xml-ora-exp-filename :
     2836     define input  parameter p-table-name  as character no-undo .
     2837     define input  parameter p-doc-code    as character no-undo .
     2838     define input  parameter p-obj-code    as integer   no-undo .
     2839     define output parameter p-filename    as character no-undo .
     2840     define output parameter p-seq-num     as integer   no-undo .
     2841     define variable v-ora-exp-seq     as integer   no-undo .
     2842     define variable v-ora-exp-seq-str as character no-undo .
     2843     define variable v-home-dir        as character no-undo.
     2844   do
     2845   on error undo, return error return-value
     2846   :
     2847     if v-bge-xml-bgeflold = "oracle":u
     2848     then do:
     2849       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2850       if v-home-dir = ?
     2851       then do:
     2852         undo, return error substitute( "&1&2&3":U
     2853                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2854                                       , chr(10)
     2855                                       , "Обратитесь к администратору.":U
     2856                                       ).
     2857       end.
     2858       assign
     2859           v-home-dir = v-home-dir
     2860       .
     2861       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2862       if error-status :error
     2863       then do:
     2864         undo, return error substitute( "&1&2&3":U
     2865                                       , "Неверно задан каталог экспорта.":U
     2866                                       , chr(10)
     2867                                       , "Обратитесь к администратору.":U
     2868                                       ).
     2869       end.
     2870       assign
     2871         v-ora-exp-seq = ?
     2872       .
     2873       if  p-table-name <> ? and
     2874           p-doc-code <> ?
     2875       then do:
     2876         run bge/get-oesq.p ( input p-table-name
     2877                            , input p-doc-code
     2878                            , output v-ora-exp-seq
     2879                            ) no-error .
     2880         if error-status :error = yes
     2881         then do:
     2882           undo, return error return-value .
     2883         end.
     2884       end.
     2885       if v-ora-exp-seq = ?
     2886       then do:
     2887         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2888         if error-status :error
     2889         then do:
     2890           undo, return error return-value .
     2891         end.
     2892       end.
     2893       if p-table-name <> ? and
     2894          p-doc-code   <> ?
     2895       then do:
     2896         run bge/oesqdoc.p ( input p-table-name
     2897                           , input p-doc-code
     2898                           , input v-ora-exp-seq
     2899                           ) no-error .
     2900         if error-status :error = yes
     2901         then do:
     2902           undo, return error return-value .
     2903         end.
     2904       end.
     2905       assign
     2906         p-seq-num  = v-ora-exp-seq
     2907         p-filename = substitute("&1/&2-000_&3."
     2908                                , v-home-dir
     2909                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2910                                , string(v-ora-exp-seq , "999999999")
     2911                                )
     2912       .
     2913     end.
     2914   end.
     2915   end procedure.
     2916   procedure bge-xml-date-to-str :
     2917     define input  parameter p-date  as date      no-undo .
     2918     define output parameter p-str   as character no-undo .
     2919   do
     2920   on error undo, return error return-value
     2921   :
     2922     if p-date <> ?
     2923     then do:
     2924       assign
     2925         p-str = substitute( "&1-&2-&3"
     2926                           , string( year(p-date)  , "9999")
     2927                           , string( month(p-date) , "99"  )
     2928                           , string( day(p-date)   , "99"  )
     2929                           )
     2930       .
     2931     end.
     2932     else do:
     2933       assign
     2934         p-str = ?
     2935       .
     2936     end.
     2937   end.
     2938   end procedure.
     2939   procedure bge-xml-date-str-to-str :
     2940     define input  parameter p-date-str  as character no-undo .
     2941     define output parameter p-str       as character no-undo .
     2942     define variable v-date          as date      no-undo .
     2943     define variable v-date-valid    as logical   no-undo .
     2944     define variable v-error-message as character no-undo .
     2945   do
     2946   on error undo, return error return-value
     2947   :
     2948     assign
     2949       p-str = ?
     2950     .
     2951     if p-date-str = ? or p-date-str = ""
     2952     then do:
     2953       return .
     2954     end.
     2955     run strtdate in this-procedure ( input  p-date-str
     2956                                    , output v-date
     2957                                    , output v-date-valid
     2958                                    , output v-error-message
     2959                                    ).
     2960     if v-date-valid <> true
     2961     then do:
     2962       return .
     2963     end.
     2964     assign
     2965       p-str = substitute( "&1-&2-&3"
     2966                         , string( year(v-date)  , "9999")
     2967                         , string( month(v-date) , "99"  )
     2968                         , string( day(v-date)   , "99"  )
     2969                         )
     2970     .
     2971   end.
     2972   end procedure.
     2973   procedure bge-xml-fill-tt-bgecliiv :
     2974     define input  parameter p-str as character no-undo .
     2975     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2976     define buffer buf_clients             for ub.clients.
     2977     define variable v-i         as integer   no-undo .
     2978     define variable v-count     as integer   no-undo .
     2979     define variable v-cli-count as integer   no-undo .
     2980     define variable v-client    as character no-undo .
     2981     define variable v-obj-type  as character no-undo .
     2982     define variable v-obj-code  as integer   no-undo .
     2983   do
     2984   on error undo, return error return-value
     2985   :
     2986     empty temp-table buf_tt-bge-xml-bgecliiv.
     2987     assign
     2988       v-bge-xml-bgecliiv = no
     2989       v-cli-count        = num-entries(p-str,';')
     2990     .
     2991     if v-cli-count > 0
     2992     then do:
     2993       _cli-cycle:
     2994       do v-i = 1 to v-cli-count
     2995       :
     2996         assign
     2997           v-client = entry(v-i , p-str, ';')
     2998         .
     2999         if num-entries(v-client) <> 2
     3000         then do:
     3001           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     3002         end.
     3003         assign
     3004           v-obj-type = entry(1, v-client)
     3005         .
     3006         assign
     3007           v-obj-code = integer(entry(2, v-client))
     3008         no-error .
     3009         if error-status :error
     3010         then do:
     3011           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     3012         end.
     3013         find first buf_clients no-lock
     3014           where buf_clients.obj-type = v-obj-type
     3015             and buf_clients.obj-code = v-obj-code
     3016         no-error.
     3017         if not available buf_clients
     3018         then do:
     3019           next _cli-cycle.
     3020         end.
     3021         find first buf_tt-bge-xml-bgecliiv no-lock
     3022           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     3023             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     3024         no-error .
     3025         if available buf_tt-bge-xml-bgecliiv
     3026         then do:
     3027           next _cli-cycle.
     3028         end.
     3029         create buf_tt-bge-xml-bgecliiv.
     3030         assign
     3031           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     3032           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     3033         .
     3034       end.
     3035     end.
     3036     else do:
     3037       assign
     3038         v-bge-xml-bgecliiv = no
     3039       .
     3040       return .
     3041     end.
     3042     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     3043     if available buf_tt-bge-xml-bgecliiv
     3044     then do:
     3045       assign
     3046         v-bge-xml-bgecliiv = yes
     3047       .
     3048     end.
     3049   end.
     3050   end procedure.
     3051   procedure bge-xml-resolve-ext-doc-type :
     3052     define input  parameter p-ext-doc-type      as character no-undo .
     3053     define input  parameter p-obj-type          as character no-undo .
     3054     define input  parameter p-obj-code          as integer   no-undo .
     3055     define output parameter p-out-ext-doc-type  as character no-undo .
     3056     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     3057   do
     3058   on error undo, return error return-value
     3059   :
     3060     assign
     3061       p-out-ext-doc-type = p-ext-doc-type
     3062     .
     3063     if p-ext-doc-type <> 'ie':U
     3064     then do:
     3065       return .
     3066     end.
     3067     if v-bge-xml-bgecliiv = yes
     3068     then do:
     3069       find first buf_tt-bge-xml-bgecliiv no-lock
     3070         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     3071           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     3072       no-error .
     3073       if available buf_tt-bge-xml-bgecliiv
     3074       then do:
     3075         assign
     3076           p-out-ext-doc-type = 'iv':U
     3077         .
     3078       end.
     3079     end.
     3080   end.
     3081   end procedure.
     3082   procedure safe-wp-xmltagput :
     3083     define input  parameter pTagLevel   as integer   no-undo .
     3084     define input  parameter pTagName    as character no-undo .
     3085     define input  parameter pParValue   as character no-undo .
     3086     define input  parameter pFlagEmpty  as integer   no-undo .
     3087   do
     3088   on error undo, return error return-value
     3089   :
     3090     if v-bge-xml-bgeflold = "oracle":u
     3091     then do:
     3092       return .
     3093     end.
     3094     run wp-xmltagput in this-procedure ( input pTagLevel
     3095                                        , input pTagName
     3096                                        , input pParValue
     3097                                        , input pFlagEmpty
     3098                                        ).
     3099   end.
     3100   end procedure.
     3101   define stream sout.
     3102   define variable v-obj-list          as character    no-undo.
     3103   define variable v-host-code         as integer      no-undo.
     3104   define variable v-host-name         as character    no-undo.
     3105   define variable v-today             as date         no-undo.
     3106   define variable v-time              as integer      no-undo.
     3107   define temp-table temp_obj-list no-undo
     3108       field obj-type as character
     3109       field obj-code as integer
     3110       index pi is primary unique obj-type obj-code
     3111   .
     3112   define variable v-obj-type   like ub.clients.obj-type no-undo .
     3113   define variable v-obj-code   like ub.clients.obj-code no-undo .
     3114   define variable v-obj-name   like ub.clients.obj-name no-undo .
     3115   define variable v-table-name as character             no-undo .
     3116   define variable v-doc-code   as character             no-undo .
     3117   define frame info
     3118     v-obj-name    format "X(20)"        label "Объект"  skip
     3119     v-table-name  format "X(30)"        label "Таблица" skip
     3120     v-doc-code    format "X(14)"        label "Номер документа"
     3121   with view-as dialog-box side-labels three-d title "Обработка документов":U .
     3122   DEFINE BUTTON b-help
     3123        LABEL "Помо&щь"
     3124        SIZE 10 BY 1.
     3125   DEFINE BUTTON bt-clear-incr
     3126        LABEL "Снять"
     3127        SIZE 12 BY 1 TOOLTIP "Снять пометку выгруженности документов".
     3128   DEFINE BUTTON bt-sel-obj
     3129        IMAGE-UP FILE "btn-down-arrow":U
     3130        IMAGE-DOWN FILE "btn-down-arrow":U
     3131        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     3132        LABEL "..."
     3133        SIZE 3.63 BY 1.04.
     3134   DEFINE BUTTON bt-set-incr
     3135        LABEL "Установить"
     3136        SIZE 12 BY 1 TOOLTIP "Установить пометку выгруженности документов".
     3137   DEFINE BUTTON Btn_OK DEFAULT
     3138        LABEL "&Выход"
     3139        SIZE 10 BY 1
     3140        BGCOLOR 8 .
     3141   DEFINE BUTTON BUTTON-1
     3142        LABEL "test"
     3143        SIZE 7.5 BY 1.13.
     3144   DEFINE VARIABLE ed-object AS CHARACTER
     3145        VIEW-AS EDITOR NO-BOX
     3146        SIZE 35.63 BY 3.38
     3147        FGCOLOR 1  NO-UNDO.
     3148   DEFINE VARIABLE date_from AS DATE FORMAT "99/99/9999":U
     3149        LABEL "Дата с"
     3150        VIEW-AS FILL-IN
     3151        SIZE 12 BY 1 NO-UNDO.
     3152   DEFINE VARIABLE date_to AS DATE FORMAT "99/99/9999":U
     3153        LABEL "по"
     3154        VIEW-AS FILL-IN
     3155        SIZE 12 BY 1 NO-UNDO.
     3156   DEFINE VARIABLE fi-shift-num AS INTEGER FORMAT ">9":U INITIAL 0
     3157        LABEL "Порядок смены"
     3158        VIEW-AS FILL-IN
     3159        SIZE 4.5 BY 1 NO-UNDO.
     3160   DEFINE VARIABLE rs-1 AS INTEGER
     3161        VIEW-AS RADIO-SET VERTICAL
     3162        RADIO-BUTTONS
     3163             "глобально", 1,
     3164   "по фирме", 2,
     3165   "по объектам", 3
     3166        SIZE 13.75 BY 3.25 NO-UNDO.
     3167   DEFINE RECTANGLE RECT-1
     3168        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     3169        SIZE 55.38 BY 4.38.
     3170   DEFINE VARIABLE tg-shift AS LOGICAL INITIAL no
     3171        LABEL "По смене"
     3172        VIEW-AS TOGGLE-BOX
     3173        SIZE 11.13 BY .83 NO-UNDO.
     3174   DEFINE FRAME Dialog-Frame
     3175        Btn_OK AT ROW 1.25 COL 1.5
     3176        bt-set-incr AT ROW 1.25 COL 11.5
     3177        bt-clear-incr AT ROW 1.25 COL 23.5
     3178        BUTTON-1 AT ROW 1.25 COL 37
     3179        b-help AT ROW 1.25 COL 47
     3180        tg-shift AT ROW 2.75 COL 2
     3181        date_from AT ROW 4 COL 12 COLON-ALIGNED
     3182        date_to AT ROW 4 COL 29 COLON-ALIGNED
     3183        fi-shift-num AT ROW 4 COL 38.5 COLON-ALIGNED
     3184        ed-object AT ROW 6.04 COL 20.88 NO-LABEL
     3185        rs-1 AT ROW 6.13 COL 3.13 NO-LABEL
     3186        bt-sel-obj AT ROW 8.29 COL 17.13
     3187        RECT-1 AT ROW 5.5 COL 2
     3188        SPACE(0.86) SKIP(0.36)
     3189       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3190            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3191            TITLE "Установка инкрементальной выгрузки документов".
     3192   ASSIGN
     3193          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     3194          FRAME Dialog-Frame:HIDDEN           = TRUE.
     3195   ASSIGN
     3196          BUTTON-1:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     3197   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     3198   DO:
     3199     APPLY "END-ERROR":U TO SELF.
     3200   END.
     3201   ON CHOOSE OF bt-clear-incr IN FRAME Dialog-Frame
     3202   DO:
     3203       ASSIGN
     3204           date_from
     3205           date_to
     3206           rs-1
     3207       .
     3208       run test-input in this-procedure .
     3209   if session :set-wait-state( "compiler" ) then.
     3210       run fill-temphost in this-procedure (
     3211             input rs-1
     3212           , input ed-object :screen-value
     3213       ) no-error.
     3214       if error-status :error
     3215       then do:
     3216           message
     3217                    vss-workfile vss-revision vss-description
     3218               skip "Ошибка создания списка объектов."
     3219               skip return-value
     3220               skip trim(error-status :get-message(1))
     3221                    trim(error-status :get-message(2))
     3222                    trim(error-status :get-message(3))
     3223           view-as alert-box error.
     3224           undo, return no-apply .
     3225       end.
     3226       view frame info.
     3227       run write-log in this-procedure ( input substitute( "Снятие даты инкрементальной выгрузки &1 &2."
     3228                                                         , if tg-shift = yes then "по сменам" else "по документам"
     3229                                                         , if tg-shift = yes then string(date_from , "99/99/9999") + ' ' + string(fi-shift-num)
     3230                                                                             else 'c ' + string(date_from , "99/99/9999") + ' по ' + string(date_to , "99/99/9999")
     3231                                                         )
     3232                                       ).
     3233       for each temp-obj
     3234       :
     3235           run clear-incr in this-procedure (
     3236                 input temp-obj.obj-type
     3237               , input temp-obj.obj-code
     3238               , input tg-shift
     3239               , input date_from
     3240               , input date_to
     3241               , input fi-shift-num
     3242           ) no-error.
     3243           if error-status :error
     3244           then do:
     3245             run write-log in this-procedure ( input substitute( "&1 &2 &3&4Ошибка снятия даты инкрементальной выгрузки&4Объект: &5 &6&4&7&8&9"
     3246                                                               , vss-workfile
     3247                                                               , vss-revision
     3248                                                               , vss-description
     3249                                                               , chr(10)
     3250                                                               , temp-obj.obj-type
     3251                                                               , temp-obj.obj-code
     3252                                                               , return-value
     3253                                                               , trim(error-status :get-message(1))
     3254                                                               , trim(error-status :get-message(2))
     3255                                                               )
     3256                                             ).
     3257               message
     3258                        vss-workfile vss-revision vss-description
     3259                   skip "Ошибка очистки даты инкрементальной выгрузки"
     3260                   skip "Объект:" temp-obj.obj-type temp-obj.obj-code
     3261                   skip return-value
     3262                   skip trim(error-status :get-message(1))
     3263                        trim(error-status :get-message(2))
     3264                        trim(error-status :get-message(3))
     3265               view-as alert-box error.
     3266           end.
     3267       end.
     3268       run write-log-nl in this-procedure .
     3269       hide frame info.
     3270   if session :set-wait-state( "" ) then.
     3271       if tg-shift = yes
     3272       then do:
     3273           message
     3274                    "Для выбранных объектов"
     3275               skip "дата и номер смены выгрузки "
     3276               skip "установлены по смене,"
     3277               skip "предыдущей выбранной."
     3278           view-as alert-box information.
     3279       end.
     3280       else do:
     3281           message
     3282               "Дата инкрементальной выгрузки"
     3283               skip "снята"
     3284               skip "для выбранных объектов"
     3285               skip "в диапазоне дат документов"
     3286               skip date_from "-" date_to
     3287           view-as alert-box information.
     3288       end.
     3289   END.
     3290   ON CHOOSE OF bt-sel-obj IN FRAME Dialog-Frame
     3291   DO:
     3292       define variable v-obj-list           as character no-undo .
     3293       define variable v-exclude-obj-list   as character no-undo .
     3294       define variable v-object-available   as logical   no-undo .
     3295       assign
     3296           rs-1 :screen-value  = "3"
     3297       .
     3298   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3299   run userobjs_clear in this-procedure  .
     3300   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3301   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
     3302     (input  v-cntxt-db-num
     3303     ,input  0
     3304     ,input  v-cntxt-userid
     3305     ,input  v-cntxt-obj-type
     3306     ,input  v-cntxt-obj-code
     3307     ,output v-object-available
     3308     ) no-error .
     3309       if error-status :error
     3310       then do:
     3311         message
     3312           vss-workfile vss-revision vss-description skip
     3313           "Ошибка при вызове процедуры gbl/usobjava.i" skip
     3314           error-status :get-message(1) skip
     3315           return-value skip
     3316           view-as alert-box error .
     3317         undo, return no-apply .
     3318       end.
     3319       if v-object-available = true
     3320       then do:
     3321   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3322   run userobjs_append in this-procedure
     3323     (input  v-cntxt-obj-type
     3324     ,input  v-cntxt-obj-code
     3325     )  .
     3326       end.
     3327       define variable v-user-select as logical   no-undo .
     3328   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3329   run userobjs_select-many in this-procedure
     3330     (input  parparentproc
     3331     ,input  v-cntxt-db-num
     3332     ,input  v-cntxt-userid
     3333     ,input  v-cntxt-host-code-obj
     3334     ,input  v-cntxt-obj-type
     3335     ,input  v-cntxt-obj-code
     3336     ,output v-user-select
     3337     )  .
     3338       if v-user-select <> true
     3339       then do:
     3340         message
     3341           "Объект не выбран"
     3342           view-as alert-box information .
     3343         return no-apply .
     3344       end.
     3345       define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     3346       for each temp_obj-list:
     3347           delete temp_obj-list.
     3348       end.
     3349       for each buf_userobjs_temp-user-obj
     3350       on error undo, return no-apply
     3351       :
     3352         find first temp_obj-list where
     3353                 temp_obj-list.obj-type = buf_userobjs_temp-user-obj.obj-type
     3354             and temp_obj-list.obj-code = buf_userobjs_temp-user-obj.obj-code no-error.
     3355         if not available temp_obj-list then do:
     3356         create temp_obj-list .
     3357         assign
     3358           temp_obj-list.obj-type = buf_userobjs_temp-user-obj.obj-type
     3359           temp_obj-list.obj-code = buf_userobjs_temp-user-obj.obj-code
     3360         .
     3361       end.
     3362       end.
     3363       assign
     3364           v-obj-list = ""
     3365       .
     3366       for each temp_obj-list
     3367       :
     3368           assign v-obj-list = v-obj-list + (if v-obj-list <> "" then ", " else "" )
     3369                                       + temp_obj-list.obj-type + string( temp_obj-list.obj-code ).
     3370       end.
     3371       assign
     3372           ed-object :screen-value = v-obj-list
     3373       .
     3374   END.
     3375   ON CHOOSE OF bt-set-incr IN FRAME Dialog-Frame
