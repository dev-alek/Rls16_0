      925   procedure xmlchar-test :
      926   define input parameter p-in-string          as character        no-undo.
      927   define output parameter p-out-string-enc    as character        no-undo.
      928   define output parameter p-out-string-dec    as character        no-undo.
      929   do
      930   on error undo, return error
      931   :
      932          run xmlchar-encode in this-procedure
      933       (
      934             input p-in-string
      935           , output p-out-string-enc
      936       ).
      937          run xmlchar-decode in this-procedure
      938       (
      939             input p-out-string-enc
      940           , output p-out-string-dec
      941       ).
      942   end.
      943   end .
      944   procedure xmlchar-encode :
      945   define input parameter p-in-string      as character        no-undo.
      946   define output parameter p-out-string    as character        no-undo.
      947       define variable v-position      as integer      no-undo.
      948       define variable v-current-char  as character    no-undo.
      949   do
      950   on error undo, return error
      951   :
      952       assign
      953           p-out-string = "":U
      954       .
      955       case p-in-string
      956       :
      957           when ?
      958           then do:
      959               assign
      960                   p-out-string = "?":U
      961               .
      962           end.
      963           when "?":U
      964           then do:
      965               assign
      966                   p-out-string = "&#63;":U
      967               .
      968           end.
      969           otherwise do:
      970               do v-position = 1 to length( p-in-string )
      971               :
      972                   assign
      973                       v-current-char = substring( p-in-string, v-position, 1 )
      974                   .
      975                   case v-current-char
      976                   :
      977                       when "&":U
      978                       then do:
      979                           assign
      980                               p-out-string = p-out-string + "&amp;":U
      981                           .
      982                       end.
      983                       when ">":U
      984                       then do:
      985                           assign
      986                               p-out-string = p-out-string + "&gt;":U
      987                           .
      988                       end.
      989                       when "<":U
      990                       then do:
      991                           assign
      992                               p-out-string = p-out-string + "&lt;":U
      993                           .
      994                       end.
      995                       when "'":U
      996                       then do:
      997                           assign
      998                               p-out-string = p-out-string + "&apos;":U
      999                           .
     1000                       end.
     1001                       when '"':U
     1002                       then do:
     1003                           assign
     1004                               p-out-string = p-out-string + "&quot;":U
     1005                           .
     1006                       end.
     1007                       when chr(1)
     1008                       then do:
     1009                           assign
     1010                               p-out-string = p-out-string + "":U
     1011                           .
     1012                       end.
     1013                       when chr(2)
     1014                       then do:
     1015                           assign
     1016                               p-out-string = p-out-string + "":U
     1017                           .
     1018                       end.
     1019                       when chr(3)
     1020                       then do:
     1021                           assign
     1022                               p-out-string = p-out-string + "":U
     1023                           .
     1024                       end.
     1025                       when chr(4)
     1026                       then do:
     1027                           assign
     1028                               p-out-string = p-out-string + "":U
     1029                           .
     1030                       end.
     1031                       when chr(5)
     1032                       then do:
     1033                           assign
     1034                               p-out-string = p-out-string + "":U
     1035                           .
     1036                       end.
     1037                       when chr(6)
     1038                       then do:
     1039                           assign
     1040                               p-out-string = p-out-string + "":U
     1041                           .
     1042                       end.
     1043                       when chr(7)
     1044                       then do:
     1045                           assign
     1046                               p-out-string = p-out-string + "":U
     1047                           .
     1048                       end.
     1049                       when chr(8)
     1050                       then do:
     1051                           assign
     1052                               p-out-string = p-out-string + "":U
     1053                           .
     1054                       end.
     1055                       when chr(9)
     1056                       then do:
     1057                           assign
     1058                               p-out-string = p-out-string + "":U
     1059                           .
     1060                       end.
     1061                       when chr(29)
     1062                       then do:
     1063                           assign
     1064                               p-out-string = p-out-string + "":U
     1065                           .
     1066                       end.
     1067                       when chr(10)
     1068                       then do:
     1069                           assign
     1070                               p-out-string = p-out-string + "&#10;":U
     1071                           .
     1072                       end.
     1073                       when chr(13)
     1074                       then do:
     1075                           assign
     1076                               p-out-string = p-out-string + "&#13;":U
     1077                           .
     1078                       end.
     1079                       otherwise do:
     1080                           assign
     1081                               p-out-string = p-out-string + v-current-char
     1082                           .
     1083                       end.
     1084                   end case.
     1085               end.
     1086           end.
     1087       end case.
     1088   end.
     1089   end .
     1090   procedure xmlchar-encode-1c :
     1091   define input parameter p-in-string      as character        no-undo.
     1092   define output parameter p-out-string    as character        no-undo.
     1093       define variable v-position      as integer      no-undo.
     1094       define variable v-current-char  as character    no-undo.
     1095   do
     1096   on error undo, return error
     1097   :
     1098       assign
     1099           p-out-string = "":U
     1100       .
     1101       case p-in-string
     1102       :
     1103           when ?
     1104           then do:
     1105               assign
     1106                   p-out-string = "?":U
     1107               .
     1108           end.
     1109           otherwise do:
     1110               do v-position = 1 to length( p-in-string )
     1111               :
     1112                   assign
     1113                       v-current-char = substring( p-in-string, v-position, 1 )
     1114                   .
     1115                   case v-current-char
     1116                   :
     1117                       when chr(1)
     1118                       then do:
     1119                           assign
     1120                               p-out-string = p-out-string + " ":U
     1121                           .
     1122                       end.
     1123                       when chr(2)
     1124                       then do:
     1125                           assign
     1126                               p-out-string = p-out-string + " ":U
     1127                           .
     1128                       end.
     1129                       when chr(3)
     1130                       then do:
     1131                           assign
     1132                               p-out-string = p-out-string + " ":U
     1133                           .
     1134                       end.
     1135                       when chr(4)
     1136                       then do:
     1137                           assign
     1138                               p-out-string = p-out-string + " ":U
     1139                           .
     1140                       end.
     1141                       when chr(5)
     1142                       then do:
     1143                           assign
     1144                               p-out-string = p-out-string + " ":U
     1145                           .
     1146                       end.
     1147                       when chr(6)
     1148                       then do:
     1149                           assign
     1150                               p-out-string = p-out-string + " ":U
     1151                           .
     1152                       end.
     1153                       when chr(7)
     1154                       then do:
     1155                           assign
     1156                               p-out-string = p-out-string + " ":U
     1157                           .
     1158                       end.
     1159                       when chr(8)
     1160                       then do:
     1161                           assign
     1162                               p-out-string = p-out-string + " ":U
     1163                           .
     1164                       end.
     1165                       when chr(9)
     1166                       then do:
     1167                           assign
     1168                               p-out-string = p-out-string + " ":U
     1169                           .
     1170                       end.
     1171                       when chr(29)
     1172                       then do:
     1173                           assign
     1174                               p-out-string = p-out-string + " ":U
     1175                           .
     1176                       end.
     1177                       when chr(10)
     1178                       then do:
     1179                           assign
     1180                               p-out-string = p-out-string + " ":U
     1181                           .
     1182                       end.
     1183                       when chr(13)
     1184                       then do:
     1185                           assign
     1186                               p-out-string = p-out-string + " ":U
     1187                           .
     1188                       end.
     1189                       otherwise do:
     1190                           assign
     1191                               p-out-string = p-out-string + v-current-char
     1192                           .
     1193                       end.
     1194                   end case.
     1195               end.
     1196           end.
     1197       end case.
     1198   end.
     1199   end .
     1200   procedure xmlchar-decode :
     1201   define input parameter p-in-string      as character        no-undo.
     1202   define output parameter p-out-string    as character        no-undo.
     1203       define variable v-position      as integer      no-undo.
     1204       define variable v-last-position as integer      no-undo.
     1205       define variable v-temp-integer  as integer      no-undo.
     1206       define variable v-current-char  as character    no-undo.
     1207       define variable v-next-char     as character    no-undo.
     1208       define variable v-success       as logical      no-undo.
     1209   do
     1210   on error undo, return error
     1211   :
     1212       assign
     1213           p-out-string = "":U
     1214           v-position   = 0
     1215       .
     1216       replace-cycle:
     1217       do while yes
     1218       on error undo, return error
     1219       :
     1220           assign
     1221               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1222           .
     1223           if v-last-position <= v-position
     1224           then do:
     1225               if v-position = 0
     1226               then do:
     1227                   assign
     1228                       p-out-string = p-in-string
     1229                   .
     1230               end.
     1231               else do:
     1232                   assign
     1233                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1234                   .
     1235               end.
     1236               leave replace-cycle.
     1237           end.
     1238           else do:
     1239               assign
     1240                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1241                   v-position      = v-last-position
     1242                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1243               .
     1244               if v-current-char = "#":U
     1245               then do:
     1246                   assign
     1247                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1248                   .
     1249                   if v-last-position > 0
     1250                   then do:
     1251                       run xmlchar-read-integer in this-procedure
     1252                        (
     1253                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1254                           , output v-temp-integer
     1255                           , output v-success
     1256                       ).
     1257                       if v-success = yes
     1258                       and v-temp-integer >= 1
     1259                       and v-temp-integer <= 255
     1260                       then do:
     1261                           assign
     1262                               p-out-string = p-out-string + chr( v-temp-integer )
     1263                               v-position   = v-last-position + 1
     1264                           .
     1265                       end.
     1266                       else do:
     1267                           assign
     1268                               p-out-string = p-out-string + "&":U
     1269                               v-position   = v-position   + 1
     1270                           .
     1271                       end.
     1272                   end.
     1273                   else do:
     1274                       assign
     1275                           p-out-string = p-out-string + "&":U
     1276                           v-position   = v-position   + 1
     1277                       .
     1278                   end.
     1279               end.
     1280               else do:
     1281                   case substring( p-in-string, v-position + 1, 3 )
     1282                   :
     1283                       when "lt;":U
     1284                       then do:
     1285                           assign
     1286                               p-out-string = p-out-string + "<":U
     1287                               v-position   = v-position   + 3
     1288                           .
     1289                       end.
     1290                       when "gt;":U
     1291                       then do:
     1292                           assign
     1293                               p-out-string = p-out-string + ">":U
     1294                               v-position   = v-position   + 3
     1295                           .
     1296                       end.
     1297                       otherwise do:
     1298                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1299                           then do:
     1300                               assign
     1301                                   p-out-string = p-out-string + "&":U
     1302                                   v-position   = v-position   + 4
     1303                               .
     1304                           end.
     1305                           else do:
     1306                               case substring( p-in-string, v-position + 1, 5 )
     1307                               :
     1308                                   when "quot;":U
     1309                                   then do:
     1310                                       assign
     1311                                           p-out-string = p-out-string + '"':U
     1312                                           v-position   = v-position   + 5
     1313                                       .
     1314                                   end.
     1315                                   when "apos;":U
     1316                                   then do:
     1317                                       assign
     1318                                           p-out-string = p-out-string + "'":U
     1319                                           v-position   = v-position   + 5
     1320                                       .
     1321                                   end.
     1322                                   otherwise do:
     1323                                       assign
     1324                                           p-out-string = p-out-string + "&":U
     1325                                       .
     1326                                   end.
     1327                               end case.
     1328                           end.
     1329                       end.
     1330                   end case.
     1331               end.
     1332           end.
     1333       end.
     1334   end.
     1335   end .
     1336   procedure xmlchar-read-integer :
     1337   define input parameter p-input-string      as character        no-undo.
     1338   define output parameter p-output-integer   as integer          no-undo.
     1339   define output parameter p-success       as logical          no-undo.
     1340   do
     1341   on error undo, return error
     1342   :
     1343       assign
     1344           p-output-integer = integer( p-input-string )
     1345       no-error.
     1346       if error-status :error
     1347       then do:
     1348           assign
     1349               p-success           = no
     1350               p-output-integer    = 0
     1351           .
     1352       end.
     1353       else do:
     1354           assign
     1355               p-success           = yes
     1356           .
     1357       end.
     1358   end.
     1359   end.
     1360   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1361   procedure strtdate :
     1362     define input  parameter p-str         as character no-undo .
     1363     define output parameter p-value       as date      no-undo .
     1364     define output parameter p-data-valid  as logical   no-undo .
     1365     define output parameter p-message     as character no-undo .
     1366   do
     1367   on error undo, return error return-value
     1368   :
     1369     define variable v-value       as date      no-undo .
     1370     define variable v-i           as integer   no-undo .
     1371     define variable v-num         as integer   no-undo .
     1372     define variable v-delim       as character no-undo .
     1373     define variable v-delim-list  as character no-undo .
     1374     define variable v-day         as integer   no-undo .
     1375     define variable v-month       as integer   no-undo .
     1376     define variable v-year        as integer   no-undo .
     1377     define variable v-day-str     as character no-undo .
     1378     define variable v-month-str   as character no-undo .
     1379     define variable v-year-str    as character no-undo .
     1380     assign
     1381       p-value       = ?
     1382       p-data-valid  = false
     1383     .
     1384     if p-str = ?
     1385     then do:
     1386       assign
     1387         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
     1388       .
     1389       return .
     1390     end.
     1391     if p-str = ""
     1392     then do:
     1393       assign
     1394         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
     1395       .
     1396       return .
     1397     end.
     1398     if length(p-str)  > 10
     1399     then do:
     1400       assign
     1401         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
     1402       .
     1403       return .
     1404     end.
     1405     assign
     1406       v-delim-list = '/,-,.':U
     1407     .
     1408     _delim:
     1409     do v-i = 1 to num-entries( v-delim-list )
     1410     :
     1411       assign
     1412         v-delim = entry( v-i , v-delim-list )
     1413         v-num   = num-entries( p-str , v-delim )
     1414       .
     1415       if v-num <> 3
     1416       then do:
     1417         assign
     1418           v-delim = ''
     1419         .
     1420       end.
     1421       else do:
     1422         leave _delim.
     1423       end.
     1424     end.
     1425     if v-delim = ''
     1426     then do:
     1427       assign
     1428         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
     1429       .
     1430       return .
     1431     end.
     1432     assign
     1433       v-day-str   = entry( 1, p-str , v-delim)
     1434       v-month-str = entry( 2, p-str , v-delim)
     1435       v-year-str  = entry( 3, p-str , v-delim)
     1436     .
     1437     if  length(v-day-str) > 2   or
     1438         length(v-day-str) < 1   or
     1439         length(v-month-str) > 2 or
     1440         length(v-month-str) < 1 or
     1441         (
     1442           length(v-year-str) <> 2 and
     1443           length(v-year-str) <> 4
     1444         )
     1445     then do:
     1446       assign
     1447         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
     1448       .
     1449       return .
     1450     end.
     1451     if length( v-year-str ) = 2
     1452     then do:
     1453       assign
     1454         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
     1455       .
     1456     end.
     1457     assign
     1458       v-day   = integer( v-day-str )
     1459       v-month = integer( v-month-str)
     1460       v-year  = integer( v-year-str)
     1461     no-error .
     1462     if error-status :error
     1463     then do:
     1464       assign
     1465         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
     1466       .
     1467       return .
     1468     end.
     1469     if v-day < 1  or
     1470        v-day > 31 or
     1471        v-month < 1 or
     1472        v-month > 12 or
     1473        v-year < 0   or
     1474        v-year > 5000
     1475     then do:
     1476       assign
     1477         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
     1478       .
     1479       return .
     1480     end.
     1481     assign
     1482       v-value = date( v-month, v-day, v-year )
     1483     no-error .
     1484     if error-status :error
     1485     then do:
     1486       assign
     1487         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
     1488       .
     1489       return .
     1490     end.
     1491     assign
     1492       p-value       = v-value
     1493       p-data-valid  = true
     1494     .
     1495   end.
     1496   end procedure.
     1497   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
     1498   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
     1499   define variable v-bge-xml-bgedict       as logical  init no  no-undo.
