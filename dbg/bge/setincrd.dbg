     4106   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4107     run mainmenu_getcntxt in parparentproc
     4108       (output v-cntxt-db-num
     4109       ,output v-cntxt-userid
     4110       ,output v-cntxt-level
     4111       ,output v-cntxt-host-code-obj
     4112       ,output v-cntxt-obj-type
     4113       ,output v-cntxt-obj-code
     4114       ,output v-cntxt-db-num-obj
     4115       ,output v-cntxt-is-admin
     4116       ) .
     4117       run get-host-name in this-procedure ( output v-host-name ) no-error .
     4118       if error-status :error
     4119       then do:
     4120           message
     4121             vss-workfile vss-revision vss-description
     4122             skip "Ошибка при определении имени фирмы"
     4123             skip "Код фирмы:" v-cntxt-host-code-obj
     4124             skip "Имя фирмы будет отображаться как '" + 'орг':U + string( v-host-code ) + "'"
     4125             skip return-value
     4126             skip trim(error-status :get-message(1))
     4127                  trim(error-status :get-message(2))
     4128                  trim(error-status :get-message(3))
     4129                  trim(error-status :get-message(4))
     4130                  trim(error-status :get-message(5))
     4131           view-as alert-box warning.
     4132           assign
     4133               v-host-name = 'орг':U + string( v-cntxt-host-code-obj )
     4134           .
     4135       end.
