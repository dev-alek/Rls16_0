     3387           , input ed-object :screen-value
     3388       ) no-error.
     3389       if error-status :error
     3390       then do:
     3391           message
     3392                    vss-workfile vss-revision vss-description
     3393               skip "Ошибка создания списка объектов."
     3394               skip return-value
     3395               skip trim(error-status :get-message(1))
     3396                    trim(error-status :get-message(2))
     3397                    trim(error-status :get-message(3))
     3398           view-as alert-box error.
     3399           undo, return no-apply .
     3400       end.
     3401       view frame info.
     3402       run write-log in this-procedure ( input substitute( "Установка даты инкрементальной выгрузки &1 &2."
     3403                                                         , if tg-shift = yes then "по сменам" else "по документам"
     3404                                                         , if tg-shift = yes then string(date_from , "99/99/9999") + ' ' + string(fi-shift-num)
     3405                                                                             else 'c ' + string(date_from , "99/99/9999") + ' по ' + string(date_to , "99/99/9999")
     3406                                                         )
     3407                                       ).
     3408       for each temp-obj
     3409       :
     3410           run set-incr in this-procedure (
     3411                 input temp-obj.obj-type
     3412               , input temp-obj.obj-code
     3413               , input tg-shift
     3414               , input date_from
     3415               , input date_to
     3416               , input fi-shift-num
     3417               , input v-today
     3418           ) no-error.
     3419           if error-status :error
