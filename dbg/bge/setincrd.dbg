     3421             run write-log in this-procedure ( input substitute( "&1 &2 &3&4Ошибка установки даты инкрементальной выгрузки&4Объект: &5 &6&4&7&8&9"
     3422                                                               , vss-workfile
     3423                                                               , vss-revision
     3424                                                               , vss-description
     3425                                                               , chr(10)
     3426                                                               , temp-obj.obj-type
     3427                                                               , temp-obj.obj-code
     3428                                                               , return-value
     3429                                                               , trim(error-status :get-message(1))
     3430                                                               , trim(error-status :get-message(2))
     3431                                                               )
     3432                                             ).
     3433               message
     3434                        vss-workfile vss-revision vss-description
     3435                   skip "Ошибка установки даты инкрементальной выгрузки"
     3436                   skip "Объект:" temp-obj.obj-type temp-obj.obj-code
     3437                   skip return-value
     3438                   skip trim(error-status :get-message(1))
     3439                        trim(error-status :get-message(2))
     3440                        trim(error-status :get-message(3))
