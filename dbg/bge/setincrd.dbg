        1   define input parameter parparentproc    as handle           no-undo.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Установка или удаление пометки выгруженности документов для инкрементальной выгрузки.".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define   shared variable g#auto as logical no-undo.
       69   define   shared variable g#news as logical no-undo.
       70   define   shared variable g#oxml as logical no-undo.
       71   define   shared variable g#esys as logical no-undo.
       72   define   shared variable g#news-source-db as integer no-undo.
       73   define   shared variable g#esys-source-esys as integer no-undo.
       74   define   shared variable g#db-num as integer   no-undo .
       75   define   shared variable g#userid as character no-undo .
       76   define   shared variable g#passwd as character no-undo .
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   procedure cur-time :
       79      define output parameter p-today as date      no-undo .
       80      define output parameter p-time  as integer   no-undo .
       81     do
       82     on error undo, return error
       83     :
       84       define variable v-date1 as date      no-undo .
       85       define variable v-date2 as date      no-undo .
       86       define variable v-time  as integer   no-undo .
       87       assign
       88         v-date1 = today
       89         v-time  = time
       90         v-date2 = today
       91       .
       92       if v-date1 <> v-date2
       93       then do:
       94         assign
       95           v-date1 = today
       96           v-time  = v-time
       97         .
       98       end.
       99       assign
      100         p-today = v-date1
      101         p-time  = v-time
      102       .
      103     end.
      104   end.
      105   function cur-time-date returns character
      106   :
      107     return string(today, '99/99/9999':U) .
      108   end.
      109   function cur-time-mjd returns decimal
      110   :
      111     define variable v-date as date      no-undo .
      112     define variable v-time as integer   no-undo .
      113     run cur-time in this-procedure
      114       (output v-date
      115       ,output v-time
      116       ) .
      117     return integer(v-date) - 2400002 + (v-time / 86400) .
      118   end.
      119   function cur-time-get-ending-index returns integer
      120   (input p-number as integer
      121   )
      122   :
      123     if p-number < 0
      124     or p-number = ?
      125     then do:
      126       return 1 .
      127     end.
      128     define variable v-rest as integer   no-undo .
      129     assign
      130       p-number = p-number modulo 100
      131     .
      132     if p-number < 20
      133     then do:
      134       assign
      135         v-rest = p-number
      136       .
      137     end.
      138     else do:
      139       assign
      140         v-rest = p-number modulo 10
      141       .
      142     end.
      143     case v-rest :
      144       when 1
      145       then do:
      146         return 2 .
      147       end.
      148       when 2 or
      149       when 3 or
      150       when 4
      151       then do:
      152         return 3 .
      153       end.
      154       otherwise do:
      155         return 1 .
      156       end.
      157     end case .
      158   end.
      159   procedure cur-time-mjd-to-date :
      160      define input  parameter i-mjd-diff as decimal no-undo.
      161      define output parameter o-Date     as date    no-undo.
      162      define output parameter o-Time     as integer no-undo.
      163      define variable v-day-number as integer   no-undo .
      164      if    i-mjd-diff < 0
      165         or i-mjd-diff = ?
      166      then do:
      167         return "?" .
      168      end.
      169      assign
      170         v-day-number = truncate(i-mjd-diff,0).
      171         o-Date = date(v-day-number + 2400002).
      172         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      173     .
      174   end.
      175   function cur-time-mjd-to-string returns character
      176   (input p-mjd-diff as decimal
      177   )
      178   :
      179     define variable v-day-number as integer   no-undo .
      180     define variable v-seconds    as integer   no-undo .
      181     define variable v-hour       as integer   no-undo .
      182     define variable v-min        as integer   no-undo .
      183     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      184     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      185     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      186     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      187     if p-mjd-diff < 0
      188     or p-mjd-diff = ?
      189     then do:
      190       return "?" .
      191     end.
      192     assign
      193       v-day-number = integer(truncate(p-mjd-diff,0))
      194       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      195     .
      196     if v-seconds > 86400
      197     then do:
      198       assign
      199         v-seconds = 86400 - 1
      200       .
      201     end.
      202     if v-seconds < 0
      203     then do:
      204       assign
      205         v-seconds = 0
      206       .
      207     end.
      208     assign
      209       v-hour = truncate(v-seconds / 3600, 0)
      210     .
      211     assign
      212       v-seconds = v-seconds modulo 3600
      213     .
      214     assign
      215       v-min = truncate(v-seconds / 60, 0)
      216     .
      217     assign
      218       v-seconds = v-seconds modulo 60
      219     .
      220     return
      221         (if v-day-number <> 0
      222           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      223           else ""
      224         )
      225       + (if v-day-number <> 0 or v-hour <> 0
      226           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      230           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      231           else ""
      232         )
      233       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      234       .
      235   end.
      236   function cur-time-string returns character
      237   :
      238     define variable v-date as date      no-undo .
      239     define variable v-time as integer   no-undo .
      240     run cur-time in this-procedure
      241       (output v-date
      242       ,output v-time
      243       ) .
      244     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      245   end.
      246   function cur-time-string-sec returns character
      247   :
      248     define variable v-date as date      no-undo .
      249     define variable v-time as integer   no-undo .
      250     run cur-time in this-procedure
      251       (output v-date
      252       ,output v-time
      253       ) .
      254     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      255   end.
      256   function cur-time-custom  returns character
      257   (input p-prefix as character
      258   ,input p-date-format as character
      259   ,input p-delimiter as character
      260   ,input p-time-format as character
      261   ,input p-suffix as character
      262   )
      263   :
      264     define variable v-date as date      no-undo .
      265     define variable v-time as integer   no-undo .
      266     run cur-time in this-procedure
      267       (output v-date
      268       ,output v-time
      269       ) .
      270     return
      271       p-prefix
      272       + string(v-date, p-date-format)
      273       + p-delimiter
      274       + string(v-time, p-time-format)
      275       + p-suffix
      276       .
      277   end.
      278   function cur-time-print  returns character
      279   :
      280     define variable v-date as date      no-undo .
      281     define variable v-time as integer   no-undo .
      282     run cur-time in this-procedure
      283       (output v-date
      284       ,output v-time
      285       ) .
      286     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      287   end.
      288   function cur-time-datetime returns datetime
      289   :
      290     define variable v-char as character no-undo .
      291     define variable v-datetime as datetime no-undo .
      292     v-char = cur-time-string().
      293     v-datetime = datetime(v-char).
      294     return  v-datetime.
      295   end.
      296   function cur-time-string-msec returns character
      297   :
      298     define variable v-date as datetime  no-undo .
      299     v-date = now.
      300     return string(v-date) .
      301   end.
      302   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      303   define  temp-table temp-host no-undo
      304     field host-code like ub.store.host-code
      305     index xpk host-code
      306   .
      307   define  temp-table temp-obj no-undo
      308     field obj-type  like ub.clients.obj-type
      309     field obj-code  like ub.clients.obj-code
      310     field host-code like ub.store.host-code
      311     field db-num    like ub.clients.db-num
      312     index xpk  obj-type obj-code
      313     index xie1 host-code
      314     index xie2 db-num host-code
      315   .
      316   procedure init-temphost:
      317     define buffer buf_store   for ub.store .
      318     define buffer buf_shop    for ub.shop .
      319     define buffer buf_clients for ub.clients .
      320     define buffer buf_db for ub.db .
      321     define buffer buf_temp-host for temp-host .
      322     define buffer buf_temp-obj for temp-obj .
      323     do
      324     on error undo, return error return-value
      325     :
      326       for each buf_store
      327       on error undo, return error
      328       :
      329         find first buf_temp-host
      330           where buf_temp-host.host-code = buf_store.host-code
      331           no-error .
      332         if not available buf_temp-host
      333         then do:
      334           create buf_temp-host .
      335           assign
      336             buf_temp-host.host-code = buf_store.host-code
      337           .
      338         end.
      339         find first buf_clients no-lock
      340           where buf_clients.obj-type = 'скл':U
      341             and buf_clients.obj-code = buf_store.obj-code
      342           no-error .
      343         if not available buf_clients
      344         then do:
      345           message
      346             "Ошибка при поиске клиента" skip
      347             "Клиент" 'скл':U buf_store.obj-code skip
      348             view-as alert-box error .
      349           undo, return error .
      350         end.
      351         create buf_temp-obj .
      352         assign
      353           buf_temp-obj.obj-type  = 'скл':U
      354           buf_temp-obj.obj-code  = buf_store.obj-code
      355           buf_temp-obj.host-code = buf_store.host-code
      356           buf_temp-obj.db-num    = buf_clients.db-num
      357         .
      358       end.
      359       for each buf_shop
      360       on error undo, return error
      361       :
      362         find first buf_temp-host
      363           where buf_temp-host.host-code = buf_shop.host-code
      364           no-error .
      365         if not available buf_temp-host
      366         then do:
      367           create buf_temp-host .
      368           assign
      369             buf_temp-host.host-code = buf_shop.host-code
      370           .
      371         end.
      372         find first buf_clients no-lock
      373           where buf_clients.obj-type = 'маг':U
      374             and buf_clients.obj-code = buf_shop.obj-code
      375           no-error .
      376         if not available buf_clients then do:
      377           message
      378             "Ошибка при поиске клиента" skip
      379             "Клиент" 'маг':U buf_shop.obj-code skip
      380             view-as alert-box error .
      381           undo, return error .
      382         end.
      383         create buf_temp-obj .
      384         assign
      385           buf_temp-obj.obj-type  = 'маг':U
      386           buf_temp-obj.obj-code  = buf_shop.obj-code
      387           buf_temp-obj.host-code = buf_shop.host-code
      388           buf_temp-obj.db-num    = buf_clients.db-num
      389         .
      390       end.
      391     end.
      392   end.
      393   procedure proc-alt-shift-f2:
      394     if not ibs.th.gbl.gbl-var:rcode
      395   then
      396     run gbl\inidebug.p .
      397   end.
      398   procedure proc-alt-shift-f3:
      399     run gbl/prvssinf.p
      400       ( input this-procedure
      401       ) .
      402   end.
      403   define variable v-inform-launched as logical no-undo initial false .
      404   procedure proc-alt-shift-f4:
      405     define variable v-action as character no-undo .
      406     if v-inform-launched = false then do:
      407       assign
      408         v-inform-launched = true
      409       .
      410       run gbl/d-inform.w
      411         (  input self
      412         ,  input this-procedure
      413         , output v-action
      414         ) no-error .
      415       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      416       assign
      417         v-inform-launched = false
      418       .
      419     end.
      420   end.
      421   procedure proc-alt-f1:
      422     run gbl/corrhelp.p
      423       (input this-procedure
      424       ) .
      425   end .
      426   on alt-shift-f2 anywhere do:
      427     run proc-alt-shift-f2.
      428   end.
      429   on alt-shift-f3 anywhere do:
      430     run proc-alt-shift-f3 in this-procedure .
      431   end.
      432   on alt-shift-f4 anywhere do:
      433     run proc-alt-shift-f4 in this-procedure.
      434   end.
      435   on alt-f1 anywhere do:
      436     run proc-alt-f1 in this-procedure .
      437   end.
      438   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      439     define variable v-cntxt-db-num        as integer   no-undo .
      440     define variable v-cntxt-userid        as character no-undo .
      441     define variable v-cntxt-level         as character no-undo .
      442     define variable v-cntxt-host-code-obj as integer   no-undo .
      443     define variable v-cntxt-obj-type      as character no-undo .
      444     define variable v-cntxt-obj-code      as integer   no-undo .
      445     define variable v-cntxt-db-num-obj    as integer   no-undo .
      446     define variable v-cntxt-is-admin      as logical   no-undo .
      447   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      448   define temp-table userobjs_temp-user-obj no-undo
      449     field obj-type as character
      450     field obj-code as integer
      451     index xpk is primary unique obj-type obj-code
      452     .
      453   procedure userobjs_clear :
      454     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      455     do
      456     on error undo, return error return-value
      457     :
      458       for each buf_userobjs_temp-user-obj
      459       on error undo, return error return-value
      460       :
      461         delete buf_userobjs_temp-user-obj .
      462       end.
      463     end.
      464   end .
      465   procedure userobjs_object-count :
      466     define output parameter p-total-count as integer   no-undo .
      467     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      468     do
      469     on error undo, return error return-value
      470     :
      471       assign
      472         p-total-count = 0
      473       .
      474       for each buf_userobjs_temp-user-obj
      475       on error undo, return error return-value
