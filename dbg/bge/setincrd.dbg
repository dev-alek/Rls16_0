      479         .
      480       end.
      481     end.
      482   end.
      483   procedure userobjs_append :
      484      define input  parameter p-obj-type as character no-undo .
      485      define input  parameter p-obj-code as integer   no-undo .
      486     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      487     do
      488     on error undo, return error return-value
      489     :
      490       find first buf_userobjs_temp-user-obj
      491         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      492           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      493         no-error .
      494       if not available buf_userobjs_temp-user-obj
      495       then do:
      496         create buf_userobjs_temp-user-obj .
      497         assign
      498           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      499           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      500         .
      501       end.
      502     end.
      503   end.
      504   procedure userobjs_object-exist :
      505     define output parameter p-object-exist as logical   no-undo .
      506     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      507     do
      508     on error undo, return error return-value
      509     :
      510       find first buf_userobjs_temp-user-obj
      511         no-error .
      512       if not available buf_userobjs_temp-user-obj
      513       then do:
      514         assign
      515           p-object-exist = false
      516         .
      517       end.
      518       else do:
      519         assign
      520           p-object-exist = true
      521         .
      522       end.
      523     end.
      524   end.
      525   procedure userobjs_transfer :
      526     define input  parameter p-callback-handle as handle no-undo .
      527     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      528     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      529     do
      530     on error undo, return error return-value
      531     :
      532       if valid-handle(p-callback-handle) <> true
      533       then do:
      534         message
      535           vss-workfile vss-revision vss-description skip
      536           "Ошибка задания входных параметров" skip
      537           "Неизвестный указатель на процедуру" skip
      538           view-as alert-box error .
      539         undo, return error return-value .
      540       end.
      541       if p-callback-handle :get-signature("userobjs_append") = ""
      542       then do:
      543         message
      544           vss-workfile vss-revision vss-description skip
      545           "Ошибка задания входных параметров" skip
      546           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      547                     ,p-callback-handle :file-name
      548                     ) skip
      549           view-as alert-box error .
      550         undo, return error return-value .
      551       end.
      552       for each buf_userobjs_temp-user-obj
      553       on error undo, return error return-value
      554       :
      555         run userobjs_append in p-callback-handle
      556           (input  buf_userobjs_temp-user-obj.obj-type
      557           ,input  buf_userobjs_temp-user-obj.obj-code
      558           ) .
      559       end.
      560     end.
      561   end procedure.
      562   procedure userobjs_select-one :
      563      define input  parameter parparentproc     as widget-handle no-undo .
      564      define input  parameter p-db-num          as integer   no-undo .
      565      define input  parameter p-user-id         as character no-undo .
      566      define input  parameter p-host-code-obj   as integer   no-undo .
      567      define input  parameter p-obj-type        as character no-undo .
      568      define input  parameter p-obj-code        as integer   no-undo .
      569      define output parameter p-user-select     as logical   no-undo .
      570      define output parameter p-select-obj-type as character no-undo .
      571      define output parameter p-select-obj-code as character no-undo .
      572     do
      573     on error undo, return error return-value
      574     :
      575       run gbl/userobjs.w
      576         (input  parparentproc
      577         ,input  this-procedure :handle
      578         ,input  p-db-num
      579         ,input  p-user-id
      580         ,input  p-host-code-obj
      581         ,input  p-obj-type
      582         ,input  p-obj-code
      583         ,INPUT  "b-sel"
      584         ,output p-user-select
      585         ,output p-select-obj-type
      586         ,output p-select-obj-code
      587         ) .
      588     end.
      589   end.
      590   procedure userobjs_select-many :
