     1553           host-code
     1554           fin-doc-code
     1555   .
     1556   define temp-table temp_del-fin-doc-code no-undo
     1557       field host-code as integer
     1558       field fin-doc-code as integer
     1559       field corr-user-db-num as integer
     1560       field chip-num as integer
     1561       index pi is primary unique
     1562           host-code
     1563           fin-doc-code
     1564           corr-user-db-num
     1565           chip-num
     1566   .
     1567   define temp-table temp_fin-ob no-undo
