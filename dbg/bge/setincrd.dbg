     3466   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     3467   DO:
     3468       APPLY "GO" TO FRAME Dialog-Frame.
     3469   END.
     3470   ON CHOOSE OF BUTTON-1 IN FRAME Dialog-Frame
     3471   DO:
     3472       DEFINE VARIABLE v-shift-date    AS CHARACTER  NO-UNDO.
     3473       DEFINE VARIABLE v-shift-num     AS CHARACTER  NO-UNDO.
     3474       DEFINE VARIABLE v-par-type      AS CHARACTER  NO-UNDO.
     3475       run fill-temphost in this-procedure (
     3476           input rs-1
     3477         , input ed-object :screen-value
     3478       ) no-error.
     3479       if error-status :error
     3480       then do:
     3481         message
     3482                  vss-workfile vss-revision vss-description
     3483             skip "Ошибка создания списка объектов."
     3484             skip return-value
     3485             skip trim(error-status :get-message(1))
     3486                  trim(error-status :get-message(2))
     3487                  trim(error-status :get-message(3))
     3488         view-as alert-box error.
     3489         undo, return no-apply .
     3490       end.
     3491       for each temp-obj
     3492       :
     3493           run clntattr-value in this-procedure (
     3494                 input temp-obj.obj-type
     3495               , input temp-obj.obj-code
     3496               , input 'bge-incr-last-shift-date':U
     3497               , OUTPUT v-shift-date
     3498               , OUTPUT v-par-type
     3499           ).
     3500           run clntattr-value in this-procedure (
     3501                 input temp-obj.obj-type
     3502               , input temp-obj.obj-code
     3503               , input 'bge-incr-last-shift-num':U
     3504               , OUTPUT v-shift-num
     3505               , OUTPUT v-par-type
     3506           ).
     3507           message
     3508               "Объект:" temp-obj.obj-type temp-obj.obj-code
     3509               SKIP "Смена:" v-shift-date v-shift-num
     3510           view-as alert-box.
     3511       END.
     3512   END.
     3513   ON RETURN OF date_from IN FRAME Dialog-Frame
     3514   DO:
     3515       APPLY "ENTRY" TO date_to IN FRAME Dialog-Frame.
     3516       RETURN NO-APPLY.
     3517   END.
     3518   ON RETURN OF date_to IN FRAME Dialog-Frame
     3519   DO:
     3520       APPLY "ENTRY" TO btn_OK IN FRAME Dialog-Frame.
     3521       RETURN NO-APPLY.
     3522   END.
     3523   ON VALUE-CHANGED OF rs-1 IN FRAME Dialog-Frame
     3524   DO:
     3525   run object-select in this-procedure no-error .
     3526   if error-status :error
     3527   then do:
     3528       undo, return no-apply.
     3529   end.
     3530   assign
     3531       rs-1
     3532   .
     3533   END.
     3534   ON VALUE-CHANGED OF tg-shift IN FRAME Dialog-Frame
     3535   DO:
     3536       assign
     3537           tg-shift
     3538       .
     3539       run manage-tg-shift in this-procedure.
     3540   END.
     3541   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3542   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3543   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3544   on help of frame Dialog-Frame
     3545   do:
     3546     run gbl/app_help.p
     3547       (input this-procedure :file-name
     3548       ,input ''
     3549       ,input ?
     3550       ) no-error.
     3551     if error-status :error then do:
     3552       message
     3553         "Ошибка при вызове помощи"
     3554         error-status :get-message(1)
     3555         view-as alert-box .
     3556     end.
     3557   end.
     3558   run minbtn-set in this-procedure .
     3559   on choose of b-help in frame Dialog-Frame
     3560   do:
     3561     apply "help":u to frame Dialog-Frame .
     3562   end.
     3563   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3564   procedure minbtn-set :
     3565       do
     3566           on error undo, return error return-value
     3567           :
     3568           define variable ii              as integer       no-undo .
     3569           define variable fh              as widget-handle no-undo .
     3570           define variable hh              as widget-handle no-undo .
     3571           define variable v-h             as handle        extent 4 no-undo .
     3572           define variable v-name-button   as character     no-undo .
     3573           define variable v-help-old-x    as decimal       no-undo .
     3574           define variable v-help-old-y    as decimal       no-undo .
     3575           define variable v-help-old-size as decimal       no-undo .
     3576           define variable v-frame-width   as decimal       no-undo .
     3577           define variable jj              as integer       no-undo .
     3578           do
     3579               on error undo, return error
     3580               :
     3581               assign
     3582                   v-frame-width = frame Dialog-Frame:width - 0.3
     3583                   fh            = frame Dialog-Frame:first-child
     3584                   hh            = fh:first-child
     3585                   ii            = 1
     3586                   .
     3587               do while valid-handle(hh):
     3588                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3589                   do:
     3590                       case lc(hh:name) :
     3591                           when "b-help" then
     3592                               do:
     3593                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3594                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3595                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3596                                   hh:TOOLTIP = "Помощь" .
     3597                                   v-help-old-x = hh:column .
     3598                                   v-help-old-y = hh:row    .
     3599                                   v-help-old-size = hh:width .
     3600                                   hh:width-chars = 2.5 .
     3601                               end.
     3602                           when "b-print" then
     3603                               do:
     3604                                   hh:load-image("cmp/b-print.bmp":u) .
     3605                                   hh:TOOLTIP = "Печать" .
     3606                                   v-h[ii] = hh:handle .
     3607                                   ii = ii + 1 .
     3608                                   hh:width-chars = 3 .
     3609                               end.
     3610                           when "b-history" or
     3611                           when "b-hist" then
     3612                               do:
     3613                                   hh:load-image("cmp/b-hist.bmp":u) .
     3614                                   hh:TOOLTIP = "История" .
     3615                                   v-h[ii] = hh:handle .
     3616                                   ii = ii + 1 .
     3617                                   hh:width-chars = 3 .
     3618                               end.
     3619                           when "b-sch" then
     3620                               do:
     3621                                   hh:load-image("cmp/b-sch.bmp":u) .
     3622                                   hh:TOOLTIP = "Установка Фильтра" .
     3623                                   v-h[ii] = hh:handle .
     3624                                   ii = ii + 1 .
     3625                                   hh:width-chars = 3 .
     3626                               end.
     3627                           when "b-hist-user" then
     3628                               do:
     3629                                   hh:load-image("cmp/b-hist.bmp":u) .
     3630                                   hh:TOOLTIP = "История пользователя" .
     3631                                   ii = ii + 1 .
     3632                               end.
     3633                       end case.
     3634                   end.
     3635                   hh = hh:next-sibling.
     3636               end.
     3637               b-help:column = v-frame-width - b-help:width-chars.
     3638               jj = 0.
     3639               repeat ii = 4 to 1 by -1 :
     3640                   if valid-handle (v-h[ii] ) then
     3641                   do:
     3642                       jj  = jj + 1 .
     3643                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3644                       v-h[ii]:row    = v-help-old-y .
     3645                   end.
     3646               end.
     3647           end.
     3648       end.
     3649   end procedure.
     3650   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3651   on ' ' of date_from in frame Dialog-Frame
     3652   do:
     3653     if (can-query (self, "sensitive")
     3654        and
     3655        self :sensitive = true
     3656        )
     3657     or (can-query (self, "read-only")
     3658        and
     3659        self :read-only = false
     3660        )
     3661     then do:
     3662       assign
     3663         self :screen-value = ?
     3664       .
     3665     end.
     3666     return no-apply.
     3667   end.
     3668   on delete-character of date_from in frame Dialog-Frame
     3669   do:
     3670     if (can-query (self, "sensitive")
     3671        and
     3672        self :sensitive = true
     3673        )
     3674     or (can-query (self, "read-only")
     3675        and
     3676        self :read-only = false
     3677        )
     3678     then do:
     3679       assign
     3680         self :screen-value = ?
