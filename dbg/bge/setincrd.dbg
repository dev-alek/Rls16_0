     4140   RUN disable_UI.
     4141   PROCEDURE clear-incr :
     4142   define input parameter p-obj-type   as character    no-undo.
     4143   define input parameter p-obj-code   as integer      no-undo.
     4144   define input parameter p-by-shift   as logical          no-undo.
     4145   define input parameter p-date-from  as date         no-undo.
     4146   define input parameter p-date-to    as date         no-undo.
     4147   define input parameter p-shift-num  as integer          no-undo.
     4148       define variable v-shift-obj-on      as logical      no-undo.
     4149       define variable v-last-shift-date   as date         no-undo.
     4150       define variable v-last-shift-num    as integer      no-undo.
     4151       define variable v-obj-name-str      as character    no-undo .
     4152       define variable v-table-name-str    as character    no-undo .
     4153       define buffer buf_c-trn-doc     for ub.c-trn-doc.
     4154       define buffer buf_trn-doc       for ub.trn-doc.
     4155       define buffer buf_shift-obj     for ub.shift-obj.
     4156       define buffer buf_price-doc     for ub.price-doc.
     4157       define buffer buf_ord-doc       for ub.ord-doc.
     4158   do
     4159   for buf_c-trn-doc
     4160     , buf_trn-doc
     4161     , buf_shift-obj
     4162     , buf_price-doc
     4163     , buf_ord-doc
     4164   on error undo, return error
     4165   :
     4166       assign
     4167         v-obj-name-str = p-obj-type + " " + trim(string(p-obj-code , ">>>>>>>>9"))
     4168       .
     4169       if p-by-shift = yes
     4170       then do:
     4171           do with frame info   :     assign       v-obj-name :screen-value    = string( v-obj-name-str   , v-obj-name :format    )       v-table-name :screen-value  = string( v-table-name-str , v-table-name :format  )       v-doc-code :screen-value    = string( ""   , v-doc-code :format    )     .   end.   process events.
     4172   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4173   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     4174     (input  p-obj-type
     4175     ,input  p-obj-code
     4176     ,input  'shift-on=request'
     4177     ,output v-shift-obj-on
     4178     ) no-error .
     4179           if error-status :error
     4180           then do:
     4181               message
     4182                   vss-workfile vss-revision vss-description
     4183                   skip "Ошибка при определении типа сменный/не-сменный для объекта"
     4184                   skip "Объект" temp-obj.obj-type temp-obj.obj-code
     4185                   skip "Атрибут" 'shift-on=request':U
     4186                   skip error-status :get-message(1)
     4187                   skip return-value
     4188               view-as alert-box error .
     4189               undo, return error .
     4190           end.
     4191           if v-shift-obj-on = yes
     4192           then do:
     4193               find last buf_shift-obj no-lock
     4194                   where buf_shift-obj.obj-type    = p-obj-type
     4195                     and buf_shift-obj.obj-code    = p-obj-code
     4196                     and buf_shift-obj.shift-date  = p-date-from
     4197                     and buf_shift-obj.shift-num   < p-shift-num
     4198               use-index pi
     4199               no-error.
     4200               if not available buf_shift-obj
     4201               then do:
     4202                   find last buf_shift-obj no-lock
     4203                       where buf_shift-obj.obj-type    = p-obj-type
     4204                         and buf_shift-obj.obj-code    = p-obj-code
     4205                         and buf_shift-obj.shift-date  < p-date-from
     4206                   use-index pi
     4207                   no-error.
     4208               end.
     4209               if not available buf_shift-obj
     4210               then do:
     4211                   assign
     4212                       v-last-shift-date = p-date-from - 1
     4213                       v-last-shift-num  = 0
     4214                   .
     4215               end.
     4216               else do:
     4217                   assign
     4218                       v-last-shift-date = buf_shift-obj.shift-date
     4219                       v-last-shift-num  = buf_shift-obj.shift-num
     4220                   .
     4221               end.
     4222               run clntattr-write in this-procedure (
     4223                     input p-obj-type
     4224                   , input p-obj-code
     4225                   , input 'bge-incr-last-shift-date':U
     4226                   , input string( v-last-shift-date )
     4227               ).
     4228               run clntattr-write in this-procedure (
     4229                     input p-obj-type
     4230                   , input p-obj-code
     4231                   , input 'bge-incr-last-shift-num':U
     4232                   , input string( v-last-shift-num )
     4233               ).
     4234               run write-log in this-procedure ( input substitute( "Для объекта &1 &2 последняя выгруженная смена &3 порядок &4."
     4235                                                                 , p-obj-type
     4236                                                                 , p-obj-code
     4237                                                                 , v-last-shift-date
     4238                                                                 , v-last-shift-num
     4239                                                                 )
     4240                                               ).
     4241           end.
     4242       end.
     4243       else do:
     4244           assign
     4245             v-table-name-str  = "trn-doc"
     4246           .
     4247           for each buf_trn-doc no-lock
     4248              where buf_trn-doc.obj-type  = p-obj-type
     4249                and buf_trn-doc.obj-code  = p-obj-code
     4250                and buf_trn-doc.status_   = 'факт':U
     4251                and buf_trn-doc.fact-date >= p-date-from
     4252                and buf_trn-doc.fact-date <= p-date-to
     4253           on error undo, return error
     4254           :
     4255               do with frame info   :     assign       v-obj-name :screen-value    = string( v-obj-name-str   , v-obj-name :format    )       v-table-name :screen-value  = string( v-table-name-str , v-table-name :format  )       v-doc-code :screen-value    = string( buf_trn-doc.doc-code   , v-doc-code :format    )     .   end.   process events.
     4256               run bge/clrbgedt.p ( input 'trn-doc':U
     4257                                  , input buf_trn-doc.doc-code
     4258                                  ).
     4259           end.
     4260           assign
     4261             v-table-name-str = "c-trn-doc"
     4262           .
     4263           for each buf_c-trn-doc no-lock
     4264              where buf_c-trn-doc.obj-type  = p-obj-type
     4265                and buf_c-trn-doc.obj-code  = p-obj-code
     4266           on error undo, return error
     4267           :
     4268               if  buf_c-trn-doc.fact-date >= p-date-from
     4269               and buf_c-trn-doc.fact-date <= p-date-to
     4270               then do:
     4271                   do with frame info   :     assign       v-obj-name :screen-value    = string( v-obj-name-str   , v-obj-name :format    )       v-table-name :screen-value  = string( v-table-name-str , v-table-name :format  )       v-doc-code :screen-value    = string( buf_c-trn-doc.doc-code   , v-doc-code :format    )     .   end.   process events.
     4272                   run bge/clrbgedt.p ( input 'c-trn-doc':U
     4273                                      , input buf_c-trn-doc.doc-code
     4274                                      ).
     4275               end.
     4276           end.
     4277           assign
     4278             v-table-name-str = "price-doc"
     4279           .
     4280           for each buf_price-doc no-lock
     4281              where buf_price-doc.obj-type  = p-obj-type
     4282                and buf_price-doc.obj-code  = p-obj-code
     4283                and buf_price-doc.status_   = 'акт':U
     4284                and buf_price-doc.fact-date >= p-date-from
     4285                and buf_price-doc.fact-date <= p-date-to
     4286           on error undo, return error
     4287           :
     4288               do with frame info   :     assign       v-obj-name :screen-value    = string( v-obj-name-str   , v-obj-name :format    )       v-table-name :screen-value  = string( v-table-name-str , v-table-name :format  )       v-doc-code :screen-value    = string( buf_price-doc.doc-num   , v-doc-code :format    )     .   end.   process events.
     4289               run bge/clrbgedt.p ( input 'price-doc':U
     4290                                  , input buf_price-doc.doc-num
     4291                                  ).
     4292           end.
     4293           assign
     4294             v-table-name-str = "ord-doc"
     4295           .
     4296           for each buf_ord-doc no-lock
     4297             where buf_ord-doc.obj-type    = p-obj-type
     4298               and buf_ord-doc.obj-code    = p-obj-code
     4299               and buf_ord-doc.status_     = 'факт':U
     4300               and buf_ord-doc.fact-date  >= p-date-from
     4301               and buf_ord-doc.fact-date  <= p-date-to
     4302           on error undo, return error
     4303           :
     4304               do with frame info   :     assign       v-obj-name :screen-value    = string( v-obj-name-str   , v-obj-name :format    )       v-table-name :screen-value  = string( v-table-name-str , v-table-name :format  )       v-doc-code :screen-value    = string( buf_ord-doc.doc-code   , v-doc-code :format    )     .   end.   process events.
     4305               run bge/clrbgedt.p ( input 'ord-doc':U
     4306                                  , input buf_ord-doc.doc-code
     4307                                  ).
     4308           end.
     4309           run write-log in this-procedure ( input substitute( "Снятие даты инкрементальной выгрузки по объекту &1 &2 завершено ."
     4310                                                             , p-obj-type
     4311                                                             , p-obj-code
     4312                                                             )
     4313                                           ).
     4314       end.
     4315   end.
     4316   END PROCEDURE.
     4317   PROCEDURE disable_UI :
     4318     HIDE FRAME Dialog-Frame.
     4319   END PROCEDURE.
     4320   PROCEDURE enable_UI :
     4321     DISPLAY tg-shift date_from date_to fi-shift-num ed-object rs-1
     4322         WITH FRAME Dialog-Frame.
     4323     ENABLE RECT-1 Btn_OK bt-set-incr bt-clear-incr b-help tg-shift date_from
     4324            date_to fi-shift-num rs-1 bt-sel-obj
     4325         WITH FRAME Dialog-Frame.
     4326     VIEW FRAME Dialog-Frame.
     4327   END PROCEDURE.
     4328   PROCEDURE fill-temphost :
     4329   do
     4330   on error undo, return error
     4331   :
     4332   define input parameter p-range      as integer      no-undo.
     4333   define input parameter p-obj-list   as character    no-undo.
     4334       define variable v-log-string    as character      no-undo.
     4335       define variable v-obj-counter   as integer        no-undo.
     4336       empty temp-table temp-obj.
     4337       RUN init-temphost.
     4338       assign
     4339           v-log-string = ", по всем фирмам"
     4340       .
     4341       case p-range:
     4342       when 2
     4343       then do:
     4344           for each temp-obj
     4345           where temp-obj.host-code <> v-cntxt-host-code-obj
     4346           :
     4347               delete temp-obj.
     4348           end.
     4349           assign
     4350               v-log-string = ", по фирме (код фирмы " + string( v-cntxt-host-code-obj ) + ")"
     4351           .
     4352       end.
     4353       when 3
     4354       then do:
     4355           for each temp-obj
     4356           :
     4357               delete temp-obj.
     4358           end.
     4359           do v-obj-counter = 1 to num-entries ( p-obj-list )
     4360           :
     4361               create temp-obj.
     4362               assign
     4363                   temp-obj.obj-type = substring( trim( entry( v-obj-counter, p-obj-list ) ), 1, 3 )
     4364                   temp-obj.obj-code = integer( substring( trim( entry( v-obj-counter, p-obj-list ) ), 4 ) )
     4365               no-error .
     4366               if error-status :error
     4367               then do:
     4368                   message
     4369                   vss-workfile vss-revision vss-description
     4370                   skip "Ошибка чтения списка объектов"
     4371                   skip return-value
     4372                   skip trim(error-status :get-message(1))
     4373                       trim(error-status :get-message(2))
     4374                       trim(error-status :get-message(3))
     4375                   view-as alert-box error.
     4376                   undo, return error .
     4377               end.
     4378   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4379   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4380     (input  temp-obj.obj-type
     4381     ,input  temp-obj.obj-code
     4382     ,output temp-obj.host-code
     4383     ) no-error .
     4384               if error-status :error
     4385               then do:
     4386                   message
     4387                   vss-workfile vss-revision vss-description
     4388                   skip "Не найдена фирма для объекта" temp-obj.obj-type temp-obj.obj-code
     4389                   skip return-value
     4390                   skip trim(error-status :get-message(1))
     4391                       trim(error-status :get-message(2))
     4392                       trim(error-status :get-message(3))
     4393                   view-as alert-box error.
     4394                   undo, return error .
     4395               end.
     4396           end.
     4397           assign
     4398               v-log-string = ", по объектам: " + p-obj-list
     4399           .
     4400       end.
     4401       end case.
     4402   end.
     4403   END PROCEDURE.
     4404   PROCEDURE get-host-name :
     4405   do
     4406   on error undo, return error
     4407   :
     4408   define output parameter p-host-name as character    no-undo.
     4409   define buffer buf_clients   for ub.clients.
     4410       find first buf_clients no-lock
     4411            where buf_clients.obj-type = 'орг':U
     4412              and buf_clients.obj-code = v-cntxt-host-code-obj
     4413       no-error.
     4414       if not available buf_clients
     4415       then do:
     4416           message
     4417             vss-workfile vss-revision vss-description
     4418             skip "Не удалось найти текущую фирму"
     4419             skip return-value
     4420             skip trim(error-status :get-message(1))
     4421                  trim(error-status :get-message(2))
     4422                  trim(error-status :get-message(3))
     4423                  trim(error-status :get-message(4))
     4424                  trim(error-status :get-message(5))
     4425           view-as alert-box error.
     4426           undo, return error .
     4427       end.
     4428       else do:
     4429           assign
     4430               p-host-name = buf_clients.obj-name
     4431           .
     4432       end.
     4433   end.
     4434   END PROCEDURE.
     4435   PROCEDURE init-fields :
     4436   do
     4437   on error undo, return error
     4438   :
     4439       define variable v-oper-num     as integer           no-undo.
     4440       run bge-xml-read-config in this-procedure ( input ?
     4441                                                 , input ?
     4442                                                 ).
     4443       assign
     4444           rs-1 :screen-value in frame dialog-frame = "2"
     4445           ed-object :screen-value in frame Dialog-frame = 'орг':U + string( v-host-code ) + " " + v-host-name
     4446       .
     4447       assign
     4448         rs-1
     4449         tg-shift = v-bge-xml-shift-mode
     4450       .
     4451       display
     4452         tg-shift
     4453       with frame Dialog-Frame.
     4454       run manage-tg-shift in this-procedure .
     4455       if v-bge-xml-shift-mode = yes
     4456       then do:
     4457         message
     4458           "Внимание!" skip
     4459           "Параметр bgeshift имеет значение distinct."  skip
     4460           "Выгрузка объектов производится посменно."
     4461         view-as alert-box information.
     4462       end.
     4463   end.
     4464   END PROCEDURE.
     4465   PROCEDURE manage-tg-shift :
     4466   do
     4467   with frame Dialog-Frame
     4468   on error undo, return error
     4469   :
     4470       if tg-shift = yes
     4471       then do:
     4472           assign
     4473               date_from :label = "Дата смены"
     4474           .
     4475           hide
     4476               date_to
     4477           .
     4478           view
     4479               fi-shift-num
     4480           .
     4481       end.
     4482       else do:
     4483           assign
     4484               date_from :label = "Дата с"
     4485           .
     4486           hide
     4487               fi-shift-num
     4488           .
     4489           view
     4490               date_to
     4491           .
     4492       end.
     4493   end.
     4494   END PROCEDURE.
     4495   PROCEDURE object-select :
     4496   do
     4497   on error undo, return error
     4498   :
     4499   case rs-1 :screen-value in frame Dialog-frame
     4500   :
     4501       when "1"
     4502       then do:
     4503           assign
     4504               ed-object :screen-value = ""
     4505           .
     4506       end.
     4507       when "2"
     4508       then do:
     4509           assign
     4510               ed-object :screen-value = v-host-name
     4511           .
     4512       end.
     4513       when "3"
     4514       then do:
     4515           for each temp_obj-list
     4516           :
     4517               delete temp_obj-list.
     4518           end.
     4519           create temp_obj-list.
     4520           assign
     4521               temp_obj-list.obj-type = v-cntxt-obj-type
     4522               temp_obj-list.obj-code = v-cntxt-obj-code
     4523               ed-object :screen-value = v-cntxt-obj-type + string( v-cntxt-obj-code )
     4524           .
     4525       end.
     4526   end case.
     4527   end.
     4528   END PROCEDURE.
     4529   PROCEDURE set-incr :
     4530   define input parameter p-obj-type   as character        no-undo.
     4531   define input parameter p-obj-code   as integer          no-undo.
     4532   define input parameter p-by-shift   as logical          no-undo.
     4533   define input parameter p-date-from  as date             no-undo.
     4534   define input parameter p-date-to    as date             no-undo.
     4535   define input parameter p-shift-num  as integer          no-undo.
     4536   define input parameter p-set-date   as date             no-undo.
     4537       define variable v-shift-obj-on    as logical      no-undo.
     4538       define variable v-obj-name-str      as character    no-undo .
     4539       define variable v-table-name-str    as character    no-undo .
     4540       define buffer buf_trn-doc       for ub.trn-doc.
     4541       define buffer buf_c-trn-doc     for ub.c-trn-doc.
     4542       define buffer buf_price-doc     for ub.price-doc.
     4543       define buffer buf_ord-doc       for ub.ord-doc.
     4544   do
     4545   for buf_trn-doc
     4546     , buf_c-trn-doc
     4547     , buf_price-doc
     4548     , buf_ord-doc
     4549   on error undo, return error
     4550   :
     4551       assign
     4552         v-obj-name-str = p-obj-type + " " + trim(string(p-obj-code , ">>>>>>>>9"))
     4553       .
     4554       if p-by-shift = yes
     4555       then do:
     4556           do with frame info   :     assign       v-obj-name :screen-value    = string( v-obj-name-str   , v-obj-name :format    )       v-table-name :screen-value  = string( v-table-name-str , v-table-name :format  )       v-doc-code :screen-value    = string( ""   , v-doc-code :format    )     .   end.   process events.
     4557   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4558   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     4559     (input  p-obj-type
     4560     ,input  p-obj-code
     4561     ,input  'shift-on=request'
     4562     ,output v-shift-obj-on
     4563     ) no-error .
     4564           if error-status :error
     4565           then do:
     4566               message
     4567                   vss-workfile vss-revision vss-description
     4568                   skip "Ошибка при определении типа сменный/не-сменный для объекта"
     4569                   skip "Объект" temp-obj.obj-type temp-obj.obj-code
     4570                   skip "Атрибут" 'shift-on=request':U
     4571                   skip error-status :get-message(1)
     4572                   skip return-value
     4573               view-as alert-box error .
     4574               undo, return error .
     4575           end.
     4576           if v-shift-obj-on = yes
     4577           then do:
     4578               run clntattr-write in this-procedure (
     4579                     input p-obj-type
     4580                   , input p-obj-code
     4581                   , input 'bge-incr-last-shift-date':U
     4582                   , input string( p-date-from )
     4583               ).
     4584               run clntattr-write in this-procedure (
     4585                     input p-obj-type
     4586                   , input p-obj-code
     4587                   , input 'bge-incr-last-shift-num':U
     4588                   , input string( p-shift-num )
     4589               ).
     4590               run write-log in this-procedure ( input substitute( "Для объекта &1 &2 последняя выгруженная смена &3 порядок &4."
     4591                                                                 , p-obj-type
     4592                                                                 , p-obj-code
     4593                                                                 , p-date-from
     4594                                                                 , p-shift-num
     4595                                                                 )
     4596                                               ).
     4597           end.
     4598       end.
     4599       else do:
     4600           assign
     4601             v-table-name-str  = "trn-doc"
     4602           .
     4603           for each buf_trn-doc no-lock
     4604              where buf_trn-doc.obj-type  = p-obj-type
     4605                and buf_trn-doc.obj-code  = p-obj-code
     4606                and buf_trn-doc.status_   = 'факт':U
     4607                and buf_trn-doc.fact-date >= p-date-from
     4608                and buf_trn-doc.fact-date <= p-date-to
     4609           on error undo, return error
     4610           :
     4611               do with frame info   :     assign       v-obj-name :screen-value    = string( v-obj-name-str   , v-obj-name :format    )       v-table-name :screen-value  = string( v-table-name-str , v-table-name :format  )       v-doc-code :screen-value    = string( buf_trn-doc.doc-code   , v-doc-code :format    )     .   end.   process events.
     4612               run bge/setbgedt.p ( input 'trn-doc':U
     4613                                  , input buf_trn-doc.doc-code
     4614                                  , input p-set-date
     4615                                  ).
     4616           end.
     4617           assign
     4618             v-table-name-str = "c-trn-doc"
     4619           .
     4620           for each buf_c-trn-doc no-lock
     4621              where buf_c-trn-doc.obj-type  = p-obj-type
     4622                and buf_c-trn-doc.obj-code  = p-obj-code
     4623           on error undo, return error
     4624           :
     4625               if  buf_c-trn-doc.fact-date >= p-date-from
     4626               and buf_c-trn-doc.fact-date <= p-date-to
     4627               then do:
     4628                   do with frame info   :     assign       v-obj-name :screen-value    = string( v-obj-name-str   , v-obj-name :format    )       v-table-name :screen-value  = string( v-table-name-str , v-table-name :format  )       v-doc-code :screen-value    = string( buf_c-trn-doc.doc-code   , v-doc-code :format    )     .   end.   process events.
     4629                   run bge/setbgedt.p ( input 'c-trn-doc':U
     4630                                      , input buf_c-trn-doc.doc-code
     4631                                      , input p-set-date
     4632                                      ).
     4633               end.
     4634           end.
     4635           assign
     4636             v-table-name-str = "price-doc"
     4637           .
     4638           for each buf_price-doc no-lock
     4639              where buf_price-doc.obj-type  = p-obj-type
     4640                and buf_price-doc.obj-code  = p-obj-code
     4641                and buf_price-doc.status_   = 'акт':U
     4642                and buf_price-doc.fact-date >= p-date-from
     4643                and buf_price-doc.fact-date <= p-date-to
     4644           on error undo, return error
     4645           :
     4646               do with frame info   :     assign       v-obj-name :screen-value    = string( v-obj-name-str   , v-obj-name :format    )       v-table-name :screen-value  = string( v-table-name-str , v-table-name :format  )       v-doc-code :screen-value    = string( buf_price-doc.doc-num   , v-doc-code :format    )     .   end.   process events.
     4647               run bge/setbgedt.p ( input 'price-doc':U
     4648                                  , input buf_price-doc.doc-num
     4649                                  , input p-set-date
     4650                                  ).
     4651           end.
     4652           assign
     4653             v-table-name-str = "ord-doc"
     4654           .
     4655           for each buf_ord-doc no-lock
     4656             where buf_ord-doc.obj-type  = p-obj-type
     4657               and buf_ord-doc.obj-code  = p-obj-code
     4658               and buf_ord-doc.status_   = 'факт':U
     4659               and buf_ord-doc.fact-date >= p-date-from
     4660               and buf_ord-doc.fact-date <= p-date-to
     4661           on error undo, return error
     4662           :
     4663               do with frame info   :     assign       v-obj-name :screen-value    = string( v-obj-name-str   , v-obj-name :format    )       v-table-name :screen-value  = string( v-table-name-str , v-table-name :format  )       v-doc-code :screen-value    = string( buf_ord-doc.doc-code   , v-doc-code :format    )     .   end.   process events.
     4664               run bge/setbgedt.p ( input 'ord-doc':U
     4665                                  , input buf_ord-doc.doc-code
     4666                                  , input p-set-date
     4667                                  ).
     4668           end.
     4669           run write-log in this-procedure ( input substitute( "Установка даты инкрементальной выгрузки по объекту &1 &2 завершена ."
     4670                                                             , p-obj-type
     4671                                                             , p-obj-code
     4672                                                             )
     4673                                           ).
     4674       end.
     4675   end.
     4676   END PROCEDURE.
     4677   PROCEDURE test-input :
     4678   do
     4679   on error undo, return error
     4680   :
     4681       if date_from > date_to
     4682       then do:
     4683           message
     4684               "Даты интервала заданы неверно. "
     4685               skip " Нижняя дата интервала должна быть меньше верхней."
     4686               skip(1) "Задайте интервал дат правильно или отмените экспорт."
     4687           view-as alert-box information.
     4688           apply "entry" to date_from in frame Dialog-Frame .
     4689           undo, return error.
     4690       end.
     4691   end.
     4692   END PROCEDURE.
     4693   PROCEDURE write-incr-dates :
     4694     define buffer buf_clients for ub.clients.
     4695   do
     4696   on error undo, return error return-value
     4697   :
     4698   end.
     4699   END PROCEDURE.
     4700   PROCEDURE write-log :
     4701     define input  parameter p-message as character no-undo .
     4702     define variable v-today             as date         no-undo.
     4703     define variable v-time              as integer      no-undo.
     4704   do
     4705   on error undo, return error return-value
     4706   :
     4707     run cur-time in this-procedure ( output v-today
     4708                                    , output v-time
     4709                                    ).
     4710     output stream sout to value("setincrd.log") append.
     4711     put stream sout unformatted substitute("&1 &2 &3&4"
     4712                                           , string(v-today , "99/99/9999")
     4713                                           , string(v-time, "HH:MM:SS")
     4714                                           , p-message
     4715                                           , chr(10)
     4716                                           ).
     4717     output stream sout close.
     4718   end.
     4719   END PROCEDURE.
     4720   PROCEDURE write-log-nl :
     4721   do
     4722   on error undo, return error return-value
     4723   :
     4724     output stream sout to value("setincrd.log") append.
     4725     put stream sout unformatted chr(10) .
     4726     output stream sout close.
