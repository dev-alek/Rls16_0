     1569       field fin-doc-code as character
     1570       index pi is primary unique
     1571           host-code
     1572           fin-doc-code
     1573   .
     1574   define temp-table temp_del-fin-ob no-undo
     1575       field host-code as integer
     1576       field fin-doc-code as character
     1577       field corr-user-db-num as integer
     1578       field chip-num as integer
     1579       index pi is primary unique
     1580           host-code
     1581           fin-doc-code
     1582           corr-user-db-num
     1583           chip-num
     1584   .
     1585   define temp-table temp_ord-doc-code no-undo
