     1501   define variable v-bge-xml-bgefmt        as character         no-undo.
     1502   define variable v-bge-xml-shift-mode    as logical           no-undo.
     1503   define variable v-bge-xml-bgeflnm-doc   as character         no-undo.
     1504   define variable v-bge-xml-bgeflnm-day   as character         no-undo.
     1505   define variable v-bge-xml-log-file-name as character    no-undo.
     1506   define variable v-bge-xml-dbf-file-name as character    no-undo.
     1507   define variable v-bge-xml-db-num-str    as character    no-undo .
