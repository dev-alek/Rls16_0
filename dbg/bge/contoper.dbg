        1   block-level on error undo, throw.
        2   define input parameter p-host-code              as integer                 no-undo.
        3   define input parameter p-ext-doc-type           as character               no-undo.
        4   define input parameter p-oper-name              as character               no-undo.
        5   define input parameter p-date1                  as date                    no-undo.
        6   define input parameter p-date2                  as date                    no-undo.
        7   define input parameter p-obj-list               as character               no-undo.
        8   define input parameter p-doc-type-list          as character               no-undo.
        9   define input parameter p-parameter-list         as character               no-undo.
       10   define input parameter p-xml-file-name          as character               no-undo.
       11   define input parameter p-log-file-name          as character               no-undo.
       12   define input parameter p-list-file-name         as character               no-undo.
       13   define input parameter p-xml-file-number        as integer                 no-undo.
       14   define input parameter hEDT                     as handle                  no-undo.
       15   define input parameter hCNT                     as handle                  no-undo.
       16   define output parameter p-last-xml-file-name    as character               no-undo.
       17   define output parameter p-last-xml-file-number  as integer                 no-undo.
       18   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       19   def var vss-author      as character no-undo init "$Author: expertek $":U .
       20   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       21   def var vss-workfile    as character no-undo init "$Workfile: contoper.p $":U .
       22   def var vss-archive     as character no-undo init "$Archive: bge/contoper.p $":U .
       23   def var vss-description as character no-undo init "Экспорт договоров".
       24   procedure vss-get-info :
       25     define output parameter p-vss-revision    like vss-revision    no-undo .
       26     define output parameter p-vss-author      like vss-author      no-undo .
       27     define output parameter p-vss-date        like vss-date        no-undo .
       28     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       29     define output parameter p-vss-archive     like vss-archive     no-undo .
       30     define output parameter p-vss-description like vss-description no-undo .
       31     assign
       32       p-vss-revision    = vss-revision
       33       p-vss-author      = vss-author
       34       p-vss-date        = vss-date
       35       p-vss-workfile    = vss-workfile
       36       p-vss-archive     = vss-archive
       37       p-vss-description = vss-description
       38     .
       39   end procedure.
       40   procedure vss-get-parameters :
       41     define output parameter p-vss-parameters as character no-undo .
       42   end procedure.
       43   define new global shared variable g#vssrevis-logger as handle    no-undo .
       44   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       45   define variable v-vssrevis-logger                   as handle    no-undo .
       46   procedure vss-logevent :
       47     define input  parameter p-extra-paramters as character no-undo .
       48     define variable v-vssrevis-parameters as character no-undo .
       49     do
       50     on error undo, return error return-value
       51     :
       52       if  valid-handle(v-vssrevis-logger)
       53       and v-vssrevis-logger :get-signature("logevent") <> ""
       54       then do:
       55         run vss-get-parameters in this-procedure
       56           (output v-vssrevis-parameters
       57           ).
       58         run logevent in v-vssrevis-logger
       59           (input vss-workfile
       60           ,input vss-revision
       61           ,input v-vssrevis-parameters
       62           ,input p-extra-paramters
       63           ).
       64       end.
       65     end.
       66   end procedure.
       67   assign
       68     v-vssrevis-logger = g#vssrevis-logger
       69   .
       70   if  valid-handle(v-vssrevis-logger)
       71   and v-vssrevis-logger :get-signature("logevent") <> ""
       72   then do:
       73     assign
       74       v-vssrevis-logevent = true
       75     .
       76     run vss-logevent in this-procedure (input vss-description) .
       77   end.
       78   define new global shared variable g#language as character no-undo .
       79   if g#language <> '' and g#language <> 'rus':U then do:
       80     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       81   end.
       82   define new global shared variable g#library  as handle no-undo .
       83   define new global shared variable g#library2 as handle no-undo .
       84   define   shared variable g#auto as logical no-undo.
       85   define   shared variable g#news as logical no-undo.
       86   define   shared variable g#oxml as logical no-undo.
       87   define   shared variable g#esys as logical no-undo.
       88   define   shared variable g#news-source-db as integer no-undo.
       89   define   shared variable g#esys-source-esys as integer no-undo.
       90   define   shared variable g#db-num as integer   no-undo .
       91   define   shared variable g#userid as character no-undo .
       92   define   shared variable g#passwd as character no-undo .
       93   define variable vss-include-info0 as character format "X(65)" no-undo
       94   initial "@(#)$Workfile$ $Revision$".
       95   define variable v-bgelib-bgefmt        as character         no-undo.
       96   define variable v-bgelib-bgeflold      as character         no-undo.
       97   define stream stmXMLOut.
       98   define stream stmXMLLog.
       99   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   procedure cur-time :
      101      define output parameter p-today as date      no-undo .
      102      define output parameter p-time  as integer   no-undo .
      103     do
      104     on error undo, return error
      105     :
      106       define variable v-date1 as date      no-undo .
      107       define variable v-date2 as date      no-undo .
      108       define variable v-time  as integer   no-undo .
      109       assign
      110         v-date1 = today
      111         v-time  = time
      112         v-date2 = today
      113       .
      114       if v-date1 <> v-date2
      115       then do:
      116         assign
      117           v-date1 = today
      118           v-time  = v-time
      119         .
      120       end.
      121       assign
      122         p-today = v-date1
      123         p-time  = v-time
      124       .
      125     end.
      126   end.
      127   function cur-time-date returns character
      128   :
      129     return string(today, '99/99/9999':U) .
      130   end.
      131   function cur-time-mjd returns decimal
      132   :
      133     define variable v-date as date      no-undo .
      134     define variable v-time as integer   no-undo .
      135     run cur-time in this-procedure
      136       (output v-date
      137       ,output v-time
      138       ) .
      139     return integer(v-date) - 2400002 + (v-time / 86400) .
      140   end.
      141   function cur-time-get-ending-index returns integer
      142   (input p-number as integer
      143   )
      144   :
      145     if p-number < 0
      146     or p-number = ?
      147     then do:
      148       return 1 .
      149     end.
      150     define variable v-rest as integer   no-undo .
      151     assign
      152       p-number = p-number modulo 100
      153     .
      154     if p-number < 20
      155     then do:
      156       assign
      157         v-rest = p-number
      158       .
      159     end.
      160     else do:
      161       assign
      162         v-rest = p-number modulo 10
      163       .
      164     end.
      165     case v-rest :
      166       when 1
      167       then do:
      168         return 2 .
      169       end.
      170       when 2 or
      171       when 3 or
      172       when 4
      173       then do:
      174         return 3 .
      175       end.
      176       otherwise do:
      177         return 1 .
      178       end.
      179     end case .
      180   end.
      181   procedure cur-time-mjd-to-date :
      182      define input  parameter i-mjd-diff as decimal no-undo.
      183      define output parameter o-Date     as date    no-undo.
      184      define output parameter o-Time     as integer no-undo.
      185      define variable v-day-number as integer   no-undo .
      186      if    i-mjd-diff < 0
      187         or i-mjd-diff = ?
      188      then do:
      189         return "?" .
      190      end.
      191      assign
      192         v-day-number = truncate(i-mjd-diff,0).
      193         o-Date = date(v-day-number + 2400002).
      194         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      195     .
      196   end.
      197   function cur-time-mjd-to-string returns character
      198   (input p-mjd-diff as decimal
      199   )
      200   :
      201     define variable v-day-number as integer   no-undo .
      202     define variable v-seconds    as integer   no-undo .
      203     define variable v-hour       as integer   no-undo .
      204     define variable v-min        as integer   no-undo .
      205     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      206     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      207     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      208     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      209     if p-mjd-diff < 0
      210     or p-mjd-diff = ?
      211     then do:
      212       return "?" .
      213     end.
      214     assign
      215       v-day-number = integer(truncate(p-mjd-diff,0))
      216       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      217     .
      218     if v-seconds > 86400
      219     then do:
      220       assign
      221         v-seconds = 86400 - 1
      222       .
      223     end.
      224     if v-seconds < 0
      225     then do:
      226       assign
      227         v-seconds = 0
      228       .
      229     end.
      230     assign
      231       v-hour = truncate(v-seconds / 3600, 0)
      232     .
      233     assign
      234       v-seconds = v-seconds modulo 3600
      235     .
      236     assign
      237       v-min = truncate(v-seconds / 60, 0)
      238     .
      239     assign
      240       v-seconds = v-seconds modulo 60
      241     .
      242     return
      243         (if v-day-number <> 0
      244           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      245           else ""
      246         )
      247       + (if v-day-number <> 0 or v-hour <> 0
      248           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      249           else ""
      250         )
      251       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      252           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      253           else ""
      254         )
      255       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      256       .
      257   end.
      258   function cur-time-string returns character
      259   :
      260     define variable v-date as date      no-undo .
      261     define variable v-time as integer   no-undo .
      262     run cur-time in this-procedure
      263       (output v-date
      264       ,output v-time
      265       ) .
      266     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      267   end.
      268   function cur-time-string-sec returns character
      269   :
      270     define variable v-date as date      no-undo .
      271     define variable v-time as integer   no-undo .
      272     run cur-time in this-procedure
      273       (output v-date
      274       ,output v-time
      275       ) .
      276     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      277   end.
      278   function cur-time-custom  returns character
      279   (input p-prefix as character
      280   ,input p-date-format as character
      281   ,input p-delimiter as character
      282   ,input p-time-format as character
      283   ,input p-suffix as character
      284   )
      285   :
      286     define variable v-date as date      no-undo .
      287     define variable v-time as integer   no-undo .
      288     run cur-time in this-procedure
      289       (output v-date
      290       ,output v-time
      291       ) .
      292     return
      293       p-prefix
      294       + string(v-date, p-date-format)
      295       + p-delimiter
      296       + string(v-time, p-time-format)
      297       + p-suffix
      298       .
      299   end.
      300   function cur-time-print  returns character
      301   :
      302     define variable v-date as date      no-undo .
      303     define variable v-time as integer   no-undo .
      304     run cur-time in this-procedure
      305       (output v-date
      306       ,output v-time
      307       ) .
      308     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      309   end.
      310   function cur-time-datetime returns datetime
      311   :
      312     define variable v-char as character no-undo .
      313     define variable v-datetime as datetime no-undo .
      314     v-char = cur-time-string().
      315     v-datetime = datetime(v-char).
      316     return  v-datetime.
      317   end.
      318   function cur-time-string-msec returns character
      319   :
      320     define variable v-date as datetime  no-undo .
      321     v-date = now.
      322     return string(v-date) .
      323   end.
      324   define variable vss-include-info2 as character format "X(65)" no-undo
      325   initial "@(#)$Workfile$ $Revision$".
      326   procedure xmlchar-test :
      327   define input parameter p-in-string          as character        no-undo.
      328   define output parameter p-out-string-enc    as character        no-undo.
      329   define output parameter p-out-string-dec    as character        no-undo.
      330   do
      331   on error undo, return error
      332   :
      333          run xmlchar-encode in this-procedure
      334       (
      335             input p-in-string
      336           , output p-out-string-enc
      337       ).
      338          run xmlchar-decode in this-procedure
      339       (
      340             input p-out-string-enc
      341           , output p-out-string-dec
      342       ).
      343   end.
      344   end .
      345   procedure xmlchar-encode :
      346   define input parameter p-in-string      as character        no-undo.
      347   define output parameter p-out-string    as character        no-undo.
      348       define variable v-position      as integer      no-undo.
      349       define variable v-current-char  as character    no-undo.
      350   do
      351   on error undo, return error
      352   :
      353       assign
      354           p-out-string = "":U
      355       .
      356       case p-in-string
      357       :
      358           when ?
      359           then do:
      360               assign
      361                   p-out-string = "?":U
      362               .
      363           end.
      364           when "?":U
      365           then do:
      366               assign
      367                   p-out-string = "&#63;":U
      368               .
      369           end.
      370           otherwise do:
      371               do v-position = 1 to length( p-in-string )
      372               :
      373                   assign
      374                       v-current-char = substring( p-in-string, v-position, 1 )
      375                   .
      376                   case v-current-char
      377                   :
      378                       when "&":U
      379                       then do:
      380                           assign
      381                               p-out-string = p-out-string + "&amp;":U
      382                           .
      383                       end.
      384                       when ">":U
      385                       then do:
      386                           assign
      387                               p-out-string = p-out-string + "&gt;":U
      388                           .
      389                       end.
      390                       when "<":U
      391                       then do:
      392                           assign
      393                               p-out-string = p-out-string + "&lt;":U
      394                           .
      395                       end.
      396                       when "'":U
      397                       then do:
      398                           assign
      399                               p-out-string = p-out-string + "&apos;":U
      400                           .
      401                       end.
      402                       when '"':U
      403                       then do:
      404                           assign
      405                               p-out-string = p-out-string + "&quot;":U
      406                           .
      407                       end.
      408                       when chr(1)
      409                       then do:
      410                           assign
      411                               p-out-string = p-out-string + "":U
      412                           .
      413                       end.
      414                       when chr(2)
      415                       then do:
      416                           assign
      417                               p-out-string = p-out-string + "":U
      418                           .
      419                       end.
      420                       when chr(3)
      421                       then do:
      422                           assign
      423                               p-out-string = p-out-string + "":U
      424                           .
      425                       end.
      426                       when chr(4)
      427                       then do:
      428                           assign
      429                               p-out-string = p-out-string + "":U
      430                           .
      431                       end.
      432                       when chr(5)
      433                       then do:
      434                           assign
      435                               p-out-string = p-out-string + "":U
      436                           .
      437                       end.
      438                       when chr(6)
      439                       then do:
      440                           assign
      441                               p-out-string = p-out-string + "":U
      442                           .
      443                       end.
      444                       when chr(7)
      445                       then do:
      446                           assign
      447                               p-out-string = p-out-string + "":U
      448                           .
      449                       end.
      450                       when chr(8)
      451                       then do:
      452                           assign
      453                               p-out-string = p-out-string + "":U
      454                           .
      455                       end.
      456                       when chr(9)
      457                       then do:
      458                           assign
      459                               p-out-string = p-out-string + "":U
      460                           .
      461                       end.
      462                       when chr(29)
      463                       then do:
      464                           assign
      465                               p-out-string = p-out-string + "":U
      466                           .
      467                       end.
      468                       when chr(10)
      469                       then do:
      470                           assign
      471                               p-out-string = p-out-string + "&#10;":U
      472                           .
      473                       end.
      474                       when chr(13)
      475                       then do:
      476                           assign
      477                               p-out-string = p-out-string + "&#13;":U
      478                           .
      479                       end.
      480                       otherwise do:
      481                           assign
      482                               p-out-string = p-out-string + v-current-char
      483                           .
      484                       end.
      485                   end case.
      486               end.
      487           end.
      488       end case.
      489   end.
      490   end .
