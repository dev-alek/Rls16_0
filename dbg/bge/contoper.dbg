      601   procedure xmlchar-decode :
      602   define input parameter p-in-string      as character        no-undo.
      603   define output parameter p-out-string    as character        no-undo.
      604       define variable v-position      as integer      no-undo.
      605       define variable v-last-position as integer      no-undo.
      606       define variable v-temp-integer  as integer      no-undo.
      607       define variable v-current-char  as character    no-undo.
      608       define variable v-next-char     as character    no-undo.
      609       define variable v-success       as logical      no-undo.
      610   do
      611   on error undo, return error
      612   :
      613       assign
      614           p-out-string = "":U
      615           v-position   = 0
      616       .
      617       replace-cycle:
      618       do while yes
      619       on error undo, return error
      620       :
      621           assign
      622               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      623           .
      624           if v-last-position <= v-position
      625           then do:
      626               if v-position = 0
      627               then do:
      628                   assign
      629                       p-out-string = p-in-string
      630                   .
      631               end.
      632               else do:
      633                   assign
      634                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      635                   .
      636               end.
      637               leave replace-cycle.
      638           end.
      639           else do:
      640               assign
      641                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      642                   v-position      = v-last-position
      643                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      644               .
      645               if v-current-char = "#":U
      646               then do:
      647                   assign
      648                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      649                   .
      650                   if v-last-position > 0
      651                   then do:
      652                       run xmlchar-read-integer in this-procedure
      653                        (
      654                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      655                           , output v-temp-integer
      656                           , output v-success
      657                       ).
      658                       if v-success = yes
      659                       and v-temp-integer >= 1
      660                       and v-temp-integer <= 255
      661                       then do:
      662                           assign
      663                               p-out-string = p-out-string + chr( v-temp-integer )
      664                               v-position   = v-last-position + 1
      665                           .
      666                       end.
      667                       else do:
      668                           assign
      669                               p-out-string = p-out-string + "&":U
      670                               v-position   = v-position   + 1
      671                           .
      672                       end.
      673                   end.
      674                   else do:
      675                       assign
      676                           p-out-string = p-out-string + "&":U
      677                           v-position   = v-position   + 1
      678                       .
      679                   end.
      680               end.
      681               else do:
      682                   case substring( p-in-string, v-position + 1, 3 )
      683                   :
      684                       when "lt;":U
      685                       then do:
      686                           assign
      687                               p-out-string = p-out-string + "<":U
      688                               v-position   = v-position   + 3
      689                           .
      690                       end.
      691                       when "gt;":U
      692                       then do:
      693                           assign
      694                               p-out-string = p-out-string + ">":U
      695                               v-position   = v-position   + 3
      696                           .
      697                       end.
      698                       otherwise do:
      699                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      700                           then do:
      701                               assign
      702                                   p-out-string = p-out-string + "&":U
      703                                   v-position   = v-position   + 4
      704                               .
      705                           end.
      706                           else do:
      707                               case substring( p-in-string, v-position + 1, 5 )
      708                               :
      709                                   when "quot;":U
      710                                   then do:
      711                                       assign
      712                                           p-out-string = p-out-string + '"':U
      713                                           v-position   = v-position   + 5
      714                                       .
      715                                   end.
      716                                   when "apos;":U
      717                                   then do:
      718                                       assign
      719                                           p-out-string = p-out-string + "'":U
      720                                           v-position   = v-position   + 5
      721                                       .
      722                                   end.
      723                                   otherwise do:
      724                                       assign
      725                                           p-out-string = p-out-string + "&":U
      726                                       .
      727                                   end.
      728                               end case.
      729                           end.
      730                       end.
      731                   end case.
      732               end.
      733           end.
      734       end.
      735   end.
      736   end .
      737   procedure xmlchar-read-integer :
      738   define input parameter p-input-string      as character        no-undo.
      739   define output parameter p-output-integer   as integer          no-undo.
      740   define output parameter p-success       as logical          no-undo.
      741   do
      742   on error undo, return error
      743   :
      744       assign
      745           p-output-integer = integer( p-input-string )
      746       no-error.
      747       if error-status :error
      748       then do:
      749           assign
      750               p-success           = no
      751               p-output-integer    = 0
      752           .
      753       end.
      754       else do:
      755           assign
      756               p-success           = yes
      757           .
      758       end.
      759   end.
      760   end.
      761   define variable v-bgelib-bgeclall           as logical      no-undo.
      762   define variable v-bgelib-bgedict            as logical      no-undo.
      763   define temp-table temp_ext-doc-type no-undo
      764       field edt-key               as integer
      765       field ext-doc-type          as character
      766       field ext-doc-type-label    as character
      767       index pi is primary unique
      768           edt-key
      769   .
      770   define temp-table temp_bgelib_goods no-undo
      771       field gds-code as integer
      772       index pi is primary unique
      773           gds-code
      774   .
      775   define temp-table temp_bgelib_clients no-undo
      776       field obj-type as character
      777       field obj-code as integer
      778       index pi is primary unique
      779           obj-type
      780           obj-code
      781   .
      782   define temp-table temp_bgelib_dis-card no-undo
      783       field d-card as character
      784       index pi is primary unique
      785           d-card
      786   .
      787   define temp-table temp_bgelib_trn-doc no-undo
      788       field doc-code as integer
      789   .
      790   procedure bgelib-tag-open:
      791   do
      792   on error undo, return error
      793   :
      794   define input parameter v-tag-level  as integer      no-undo.
      795   define input parameter v-tag-name   as character    no-undo.
      796   define input parameter v-tag-value  as character    no-undo.
      797       put stream stmXMLOut unformatted
      798           chr(10)
      799           + fill(" ", 4 * v-tag-level)
      800           + "<" + v-tag-name
      801           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      802           + v-tag-value + ">"
      803       .
      804   end.
      805   end procedure.
      806   procedure bgelib-tag-put:
      807   do
      808   on error undo, return error
      809   :
      810   define input parameter v-tag-level      as integer      no-undo.
      811   define input parameter v-tag-name       as character    no-undo.
      812   define input parameter v-tag-value      as character    no-undo.
      813   define input parameter v-empty-mode     as integer      no-undo.
      814       v-tag-name = trim(v-tag-name).
      815       if  v-empty-mode = 1
      816       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      817       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      818       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      819       then do:
      820           run xmlchar-encode in this-procedure (
      821                 input v-tag-value
      822               , output v-tag-value
      823           ).
      824           put stream stmXMLOut unformatted
      825               chr(10) + fill(" ", 4 * v-tag-level)
      826                           + '<' + v-tag-name + '>'
      827                           + v-tag-value
      828                           + '</' + v-tag-name + '>'
      829           .
      830       end.
      831   end.
      832   end procedure.
      833   procedure bgelib-tag-close:
      834   do
      835   on error undo, return error
      836   :
      837   define input parameter v-tag-level as integer      no-undo.
      838   define input parameter v-tag-name  as character    no-undo.
      839       put stream stmXMLOut unformatted
      840           chr(10)
      841           + fill( " ", 4 * v-tag-level)
      842           + '</' + v-tag-name + '>'
      843       .
      844   end.
      845   end procedure.
      846   procedure bgelib-write-log:
      847   do
      848   on error undo, return error
      849   :
      850   define input parameter v-filename   as character    no-undo.
      851   define input parameter v-log-level  as integer      no-undo.
      852   define input parameter v-out-string as character    no-undo.
      853       output stream stmXMLLog to value( v-filename ) append.
      854       put stream stmXMLLog unformatted
      855           chr(10)
      856       .
      857       put stream stmXMLLog unformatted
      858           ( if v-log-level = 0
      859             or v-out-string = "&DLine"
      860             or v-out-string = "&Line"
      861             then ""
      862             else cur-time-string-sec() + " " )
      863       .
      864       put stream stmXMLLog unformatted
      865           ( if v-out-string = "&Line"
      866             then fill( "-", 80 )
      867             else if v-out-string = "&DLine"
      868                  then fill( "=", 80 )
      869                  else v-out-string )
      870       .
      871       output stream stmXMLLog close.
      872   end.
      873   end procedure.
      874   procedure bgelib-write-edt:
      875   do
      876   on error undo, return error
      877   :
      878   define input parameter v-editor-handle    as handle       no-undo.
      879   define input parameter v-log-level        as integer      no-undo.
      880   define input parameter v-out-string       as character    no-undo.
      881       if valid-handle ( v-editor-handle )
      882       then do:
      883           v-editor-handle :move-to-eof().
      884           v-editor-handle :insert-string( ( if v-log-level = 0
      885                                             or v-out-string = "&DLine"
      886                                             or v-out-string = "&Line"
      887                                             then ""
      888                                             else cur-time-string-sec() + " "
      889                                         ) ).
      890           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      891                                             then fill( "-", 80 )
      892                                             else if v-out-string = "&DLine" then fill("=", 80)
      893                                             else fill( " ", v-log-level) + v-out-string
      894                                         ) ).
      895           v-editor-handle :insert-string( chr(10) ).
      896       end.
      897       process events.
      898       output to 'bgescn.txt' append.
      899           put unformatted
      900               chr(10)
      901               string( ( if v-log-level = 0
      902                         or v-out-string = "&DLine"
      903                         or v-out-string = "&Line"
      904                         then ""
      905                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      906                     ) )
      907               string( ( if v-out-string = "&Line"
      908                         then fill( "-", 80 )
      909                         else if v-out-string = "&DLine"
      910                              then fill( "=", 80 )
      911                              else fill( " ", v-log-level ) + v-out-string
      912                     ) )
      913           .
      914       output close.
      915   end.
      916   end procedure.
      917   procedure bgelib-show-cnt:
      918   do
      919   on error undo, return error
      920   :
      921   define input parameter v-fillin-handle     as handle   no-undo.
      922       if valid-handle( v-fillin-handle )
      923       then do:
      924           assign
      925               v-fillin-handle :visible = true
      926           .
      927       end.
      928   end.
      929   end procedure.
      930   procedure bgelib-hide-cnt:
      931   do
      932   on error undo, return error
      933   :
      934   define input parameter v-fillin-handle     as handle   no-undo.
      935       if valid-handle( v-fillin-handle )
      936       then do:
      937           assign v-fillin-handle :visible = false.
      938       end.
      939   end.
      940   end procedure.
      941   procedure bgelib-write-cnt:
      942   do
      943   on error undo, return error
      944   :
      945   define input parameter v-fillin-handle    as handle       no-undo.
      946   define input parameter v-fillin-string    as character    no-undo.
      947       if valid-handle( v-fillin-handle )
      948       then do:
      949           assign
      950               v-fillin-handle :SCREEN-value = v-fillin-string
      951           .
      952       end.
      953   end.
      954   end procedure.
      955   procedure bgelib-write-header:
      956   do
      957   on error undo, return error
      958   :
      959   define input parameter p-first-file     as logical      no-undo.
      960   define input parameter p-xml-file-name  as character    no-undo.
      961   define input parameter p-list-file-name as character    no-undo.
      962   define input parameter p-file-number    as integer      no-undo.
      963   define input parameter p-have-prev      as logical      no-undo.
      964   define input parameter p-prev-filename  as character    no-undo.
      965   define input parameter p-obj-list       as character    no-undo.
      966   define input parameter p-doc-type-list  as character    no-undo.
      967   define input parameter p-parameter-list as character    no-undo.
      968       define variable v-counter    as integer        no-undo.
      969       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      970       put stream stmXMLOut unformatted
      971           "<?xml version='1.0' encoding='windows-1251'?>"
      972       .
      973       run bgelib-tag-open( input 0, input "root"  , input "" ).
      974       run bgelib-tag-open( input 0, input "header", input "" ).
      975       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      976       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      977       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      978       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      979       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      980       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      981       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      982       :
      983           run bgelib-tag-put(
      984                 input 1
      985               , input entry( 2 * v-counter, p-parameter-list )
      986               , input entry( 2 * v-counter + 1, p-parameter-list )
      987               , input 0
      988           ).
      989       end.
      990       run bgelib-tag-close( input 0, input "header" ).
      991       output stream stmXMLOut close.
      992       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      993       if p-first-file = yes
      994       then do:
      995           put stream stmXMLOut unformatted
      996               "<?xml version='1.0' encoding='windows-1251'?>"
      997           .
      998           run bgelib-tag-open( input 0, input "export", input "" ).
      999       end.
     1000       run bgelib-tag-open( input 1, input "file", input "" ).
     1001       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1002       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1003       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1004       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1005       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1006       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1007       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1008       :
     1009           run bgelib-tag-put(
     1010                 input 2
     1011               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1012               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1013               , input 0
     1014           ).
     1015       end.
     1016       run bgelib-tag-close( input 1, input "file" ).
     1017       output stream stmXMLOut close.
     1018   end.
     1019   end procedure.
     1020   procedure bgelib-write-footer:
     1021   do
     1022   on error undo, return error
     1023   :
     1024   define input parameter p-last-file      as logical      no-undo.
     1025   define input parameter p-xml-file-name  as character    no-undo.
     1026   define input parameter p-list-file-name as character    no-undo.
     1027   define input parameter p-have-next      as logical      no-undo.
     1028   define input parameter p-next-file-name as character    no-undo.
     1029       define variable v-error-num     as integer           no-undo.
     1030       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1031       if p-have-next = yes
     1032       then do:
     1033           run bgelib-tag-open( input 0, input "footer", "" ).
     1034           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1035           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1036           run bgelib-tag-close( input 0, input "footer" ).
     1037       end.
     1038       run bgelib-tag-close( input 0, input "root" ).
     1039       output stream stmXMLOut close.
     1040       run bge/os_copy.p (
     1041             input "M"
     1042           , input p-xml-file-name + "tmp"
     1043           , input p-xml-file-name + "xml"
     1044           , output v-error-num
     1045       ).
     1046       if p-last-file = yes
     1047       then do:
     1048           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1049               run bgelib-tag-close( input 0, input "export" ).
     1050           output stream stmXMLOut close.
     1051           run bge/os_copy.p (
     1052                 input "M"
     1053               , input p-list-file-name + "tmp"
     1054               , input p-list-file-name + "xml"
     1055               , output v-error-num
     1056           ).
     1057       end.
     1058   end.
     1059   end procedure.
     1060   procedure bgelib-filename :
     1061   do
     1062   on error undo, return error
     1063   :
     1064   define input parameter p-prefix             as character    no-undo.
     1065   define output parameter p-xml-file-name     as character    no-undo.
     1066   define output parameter p-log-file-name     as character    no-undo.
     1067   define output parameter p-list-file-name    as character    no-undo.
     1068       define variable v-home-dir  as character    no-undo.
     1069       define variable v-error-num as integer      no-undo.
     1070       get-key-value section "BGE" key "outdir" value v-home-dir.
     1071       if v-home-dir = ?
     1072       then do:
     1073           message
     1074             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1075             skip(1)
     1076             skip "Обратитесь к администратору."
     1077           view-as alert-box error.
     1078           undo, return error .
     1079       end.
     1080       run gbl/dir-cre.p (
     1081           input v-home-dir
     1082       ) no-error.
     1083       if error-status :error
     1084       then do:
     1085           message
     1086             skip "Неверно задан каталог экспорта."
     1087             skip(1)
     1088             skip "Обратитесь к администратору."
     1089           view-as alert-box error.
     1090           undo, return error .
     1091       end.
     1092       run bge/genfname.p (
     1093             input v-home-dir
     1094           , input p-prefix
     1095           , input ""
     1096           , input "xml"
     1097           , input "tmp"
     1098           , output p-xml-file-name
     1099       ).
     1100       assign
     1101           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1102           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1103           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1104       .
     1105   end.
     1106   end procedure.
     1107   procedure bgelib-read-config :
     1108   do
     1109   on error undo, return error
     1110   :
     1111   define variable v-par-type as character     no-undo.
     1112     define variable v-param-type      as character  no-undo .
     1113     define variable v-value-character as character  no-undo .
     1114     define variable v-value-date      as date       no-undo .
     1115     define variable v-value-decimal   as decimal    no-undo .
     1116     define variable v-value-integer   as integer    no-undo .
     1117     define variable v-value-logical   as logical    no-undo .
     1118     define variable v-tth             as handle     no-undo .
     1119       assign
     1120           v-bgelib-bgeclall = no
     1121           v-bgelib-bgedict  = no
     1122       .
     1123       run adm/shattri.p ( input "get":U
     1124                         , input  '':u
     1125                         , input  0
     1126                         , input  'bge-export':U
     1127                         , input  'bgeclall':U
     1128                         , output v-value-character
     1129                         , output v-value-date
     1130                         , output v-value-decimal
     1131                         , output v-value-integer
     1132                         , output v-value-logical
     1133                         , output v-param-type
     1134                         , input-output table-handle v-tth
     1135                         ) no-error .
     1136       if error-status :error
     1137       then do:
     1138         assign
     1139           v-bgelib-bgeclall = no
     1140         .
     1141       end.
     1142       else do:
     1143         assign
     1144           v-bgelib-bgeclall = v-value-logical
     1145         .
     1146       end.
     1147       delete object v-tth.
     1148       run adm/shattri.p ( input "get":U
     1149                         , input  '':u
     1150                         , input  0
     1151                         , input  'bge-export':U
     1152                         , input  'bgedict':U
     1153                         , output v-value-character
     1154                         , output v-value-date
     1155                         , output v-value-decimal
     1156                         , output v-value-integer
     1157                         , output v-value-logical
     1158                         , output v-param-type
     1159                         , input-output table-handle v-tth
     1160                         ) no-error .
     1161       if error-status :error
     1162       then do:
     1163         assign
     1164           v-bgelib-bgedict = no
     1165         .
     1166       end.
     1167       else do:
     1168         assign
     1169           v-bgelib-bgedict = v-value-logical
     1170         .
     1171       end.
     1172       delete object v-tth.
     1173       run adm/shattri.p ( input "get":U
     1174                         , input  '':u
     1175                         , input  0
     1176                         , input  'bge-export':U
     1177                         , input  'bgefmt':U
     1178                         , output v-value-character
     1179                         , output v-value-date
     1180                         , output v-value-decimal
     1181                         , output v-value-integer
     1182                         , output v-value-logical
     1183                         , output v-param-type
     1184                         , input-output table-handle v-tth
     1185                         ) no-error .
     1186       if error-status :error
     1187       then do:
     1188         assign
     1189           v-bgelib-bgefmt  = "xml":U
     1190         .
     1191       end.
     1192       else do:
     1193         assign
     1194           v-bgelib-bgefmt  = v-value-character
     1195         .
     1196       end.
     1197       delete object v-tth.
     1198       run adm/shattri.p ( input "get":U
     1199                         , input  '':u
     1200                         , input  0
     1201                         , input  'bge-export':U
     1202                         , input  'bgeflold':U
     1203                         , output v-value-character
     1204                         , output v-value-date
     1205                         , output v-value-decimal
     1206                         , output v-value-integer
     1207                         , output v-value-logical
     1208                         , output v-param-type
     1209                         , input-output table-handle v-tth
     1210                         ) no-error .
     1211       if error-status :error
     1212       then do:
     1213         assign
     1214           v-bgelib-bgeflold  = "old":U
     1215         .
     1216       end.
     1217       else do:
     1218         assign
     1219           v-bgelib-bgeflold  = v-value-character
     1220         .
     1221       end.
     1222       delete object v-tth.
     1223   end.
     1224   end procedure.
     1225   procedure bgelib-check-file-size :
     1226   do
     1227   on error undo, return error
     1228   :
     1229   define input parameter p-out-filename   as character    no-undo.
     1230   define output parameter p-is-big        as logical      no-undo.
     1231       define variable v-current-position    as integer        no-undo.
     1232       assign
     1233           v-current-position = seek( stmXMLOut )
     1234       .
     1235       if v-current-position / 1024 / 1024  >= 100
     1236       then do:
     1237           assign
     1238               p-is-big = yes
     1239           .
     1240       end.
     1241   end.
     1242   end procedure.
     1243   procedure bgelib-init-ext-doc-type :
     1244       define variable v-counter    as integer      no-undo.
     1245       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1246   do
     1247   for buf_temp_ext-doc-type
     1248   on error undo, return error
     1249   :
     1250       empty temp-table buf_temp_ext-doc-type.
     1251       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1252       :
     1253           create buf_temp_ext-doc-type.
     1254           assign
     1255               buf_temp_ext-doc-type.edt-key               = v-counter
     1256               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1257               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1258           .
     1259       end.
     1260   end.
     1261   end procedure.
     1262   define new global shared variable g#lib-trn  as handle no-undo .
     1263   define new global shared variable g#lib-trn2 as handle no-undo .
     1264   define new global shared variable g#lib-trn3 as handle no-undo .
     1265   define new global shared variable g#lib-trn4 as handle no-undo .
     1266   do
     1267   on error undo, return error
     1268   :
     1269     define variable v-exists-operation          as logical      no-undo.
     1270     define variable v-last-file-position        as integer       no-undo.
     1271       ASSIGN  v-exists-operation = NO .
     1272       RUN bgelib-write-cnt( hCNT, "" ).
     1273       assign p-last-xml-file-name = p-xml-file-name .
     1274       run export-documents in this-procedure (
     1275             input p-obj-list
     1276           , input p-doc-type-list
     1277           , input p-parameter-list
     1278           , input p-xml-file-name
     1279           , input p-log-file-name
     1280           , input p-list-file-name
     1281           , input p-xml-file-number
     1282           , output p-last-xml-file-name
     1283           , output p-last-xml-file-number
     1284       ).
     1285   end.
     1286   procedure export-documents :
     1287   do
     1288   on error undo, return error
     1289   :
     1290     define input parameter p-obj-list               as character    no-undo.
     1291     define input parameter p-doc-type-list          as character    no-undo.
     1292     define input parameter p-parameter-list         as character    no-undo.
     1293     define input parameter p-xml-file-name          as character    no-undo.
     1294     define input parameter p-log-file-name          as character    no-undo.
     1295     define input parameter p-list-file-name         as character    no-undo.
     1296     define input parameter p-xml-file-number        as integer      no-undo.
     1297     define output parameter p-last-xml-file-name    as character    no-undo.
     1298     define output parameter p-last-xml-file-number  as integer      no-undo.
     1299     define variable v-exists-before as logical      no-undo.
     1300     define variable v-exists-after  as logical      no-undo.
     1301     define variable v-need-new-file  as logical     no-undo.
     1302     define variable v-need-disk-spc  as logical     no-undo.
     1303     define variable v-cancel         as logical     no-undo.
     1304     define variable v-prev-filename  as character   no-undo.
     1305     define variable v-void-string    as character   no-undo.
     1306   define variable vss-include-info3 as character format "X(65)" no-undo
     1307   initial "@(#)$Workfile$ $Revision$".
     1308     define buffer buf_contract for ub.contract.
     1309     define buffer buf_contract-attr for ub.contract-attr .
     1310     define buffer buf_contract-specif for ub.contract-specif.
     1311     assign
     1312         p-last-xml-file-name    = p-xml-file-name
     1313         p-last-xml-file-number  = p-xml-file-number
     1314     .
     1315     output stream stmxmlout to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1316   export-documents:
     1317     for each buf_contract no-lock where
     1318             buf_contract.host-code = p-host-code
     1319         AND buf_contract.contract-date >= p-date1
     1320         AND buf_contract.contract-date <= p-date2
     1321         AND buf_contract.status_ = 'тек':U
     1322     on error undo, return error
     1323     :
     1324       if buf_contract.doc-type <> p-ext-doc-type then next export-documents.
     1325       if v-need-new-file = yes  then do:
     1326         output stream stmxmlout close.
     1327         assign v-prev-filename = p-xml-file-name .
     1328         run bgelib-filename in this-procedure (
     1329                 input "contract"
     1330               , output p-xml-file-name
     1331               , output v-void-string
     1332               , output v-void-string
     1333           ).
     1334           run bgelib-write-footer in this-procedure (
     1335                 input no
     1336               , input v-prev-filename
     1337               , input p-list-file-name
     1338               , input yes
     1339               , input p-xml-file-name + "xml":U
     1340           ).
     1341           run bgelib-write-log in this-procedure (
     1342               input p-log-file-name
     1343               , input 1
     1344               , input substitute( "Данные выгружены в файл &1", replace( p-xml-file-name, "/", "\" ) + "xml")
     1345           ).
     1346           assign
     1347               p-last-xml-file-number   = p-xml-file-number + 1
     1348               p-last-xml-file-name     = p-xml-file-name
     1349           .
     1350           run bgelib-write-header in this-procedure (
     1351                 input no
     1352               , input p-last-xml-file-name
     1353               , input p-list-file-name
     1354               , input p-last-xml-file-number
     1355               , input yes
     1356               , input v-prev-filename + "xml":U
     1357               , input p-obj-list
     1358               , input p-doc-type-list
     1359               , input p-parameter-list
     1360           ).
     1361          output stream stmxmlout to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1362          assign v-need-new-file = no .
     1363       end.
     1364       if not v-exists-operation then do:
     1365         run bgelib-write-edt in this-procedure ( hEDT, 4, "Операция " + string( p-oper-name ) ).
     1366         run bgelib-write-log in this-procedure ( p-log-file-name, 0, "&Line" ).
     1367         run bgelib-write-log in this-procedure ( p-log-file-name, 1, "XML - Вывод операции " + string( p-oper-name ) + " (" + p-ext-doc-type + ")" ).
     1368         assign v-exists-operation = yes .
     1369       end.
     1370       run bgelib-write-cnt( hcnt, "   " + string(buf_contract.contract-code ) + " от " + string( buf_contract.contract-date ) ) .
     1371       process events.
     1372   define variable vss-include-info4 as character format "X(65)" no-undo
     1373   initial "@(#)$Workfile$ $Revision$".
     1374   run bgelib-tag-open in this-procedure ( input 0, substitute("&1", 'contract'),  "" ).
