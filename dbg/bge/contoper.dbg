     1476   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'cor-acc1-out-payoff'),  input string(buf_contract.cor-acc1-out-payoff), input 1 ).
     1477   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'spec-prc'),  input string(buf_contract.spec-prc), input 1 ).
     1478   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'spec-check'),  input string(buf_contract.spec-check), input 1 ).
     1479   for first buf_contract-attr no-lock where buf_contract-attr.host-code = buf_contract.host-code and buf_contract-attr.contract-code = buf_contract.contract-code and
     1480   buf_contract-attr.attr-code = "contract-edi":
     1481   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'edi'),  input string(if buf_contract-attr.attr-value = "yes" then "1" else "0"), input 1 ).
     1482   end.
     1483   run bgelib-tag-close in this-procedure ( input 0, substitute("&1", 'contract')).
     1484   for each buf_contract-specif no-lock
     1485       where buf_contract-specif.contract-num = buf_contract.contract-code
     1486       AND   buf_contract-specif.host-code = buf_contract.host-code
     1487   on error undo, return error
     1488   :
     1489         run bgelib-tag-open in this-procedure ( input 0, substitute("&1", 'contract-specif'),  "" ).
     1490         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contract-num'),  input string(buf_contract-specif.contract-num), input 1 ).
     1491         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'host-code'),  input string(buf_contract-specif.host-code), input 1 ).
     1492         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'gds-code'),  input string(buf_contract-specif.gds-code), input 1 ).
     1493         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'price-cli'),  input string(buf_contract-specif.price-cli), input 1 ).
     1494         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'prc'),  input string(buf_contract-specif.prc), input 1 ).
     1495         run bgelib-tag-close in this-procedure ( input 0, substitute("&1", 'contract-specif')).
     1496   end.
     1497       if v-last-file-position = 0 or seek( stmxmlout ) - v-last-file-position > 1048576 then do:
     1498         run gbl/chkfree.p (
     1499             input substring( p-xml-file-name, 1, 1 )
     1500             , input 200
     1501             , output v-need-disk-spc
     1502         ) .
     1503         if v-need-disk-spc = yes then do:
     1504             run gbl/waitfrsp.w (
     1505                 input substring( p-xml-file-name, 1, 1 )
     1506                 , input 200
     1507                 , output v-cancel
     1508             ) .
     1509             if v-cancel = yes then undo, return error.
     1510         end.
     1511         assign v-last-file-position = seek( stmxmlout )  .
     1512       end.
     1513       run bgelib-check-file-size in this-procedure ( input p-xml-file-name + "tmp", output v-need-new-file ).
     1514     end.
     1515     output stream stmxmlout close.
     1516   end.
     1517   end procedure.
