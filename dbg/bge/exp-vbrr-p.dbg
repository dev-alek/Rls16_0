      665   PROCEDURE InternetConnectA EXTERNAL "wininet.dll" PERSISTENT:
      666     define input parameter  hInternetSession  as  long.
      667     define input parameter  lpszServerName    as  char.
      668     define input parameter  nServerPort       as  long.
      669     define input parameter  lpszUserName      as  char.
      670     define input parameter  lpszPassword      as  char.
      671     define input parameter  dwService         as  long.
      672     define input parameter  dwFlags           as  long.
      673     define input parameter  dwContext         as  long.
      674     define return parameter hInternetConnect  as  long.
      675   END.
      676   PROCEDURE InternetGetLastResponseInfoA EXTERNAL "wininet.dll" PERSISTENT:
      677     define output parameter lpdwError          as  long.
      678     define output parameter lpszBuffer         as  char.
      679     define input-output  parameter lpdwBufferLength   as  long.
      680     define return parameter iResultCode       as  long.
      681   END.
      682   PROCEDURE InternetOpenUrlA EXTERNAL "wininet.dll" PERSISTENT:
      683     define input parameter  hInternetSession  as  long.
      684     define input parameter  lpszUrl           as  char.
      685     define input parameter  lpszHeaders       as  char.
      686     define input parameter  dwHeadersLength   as  long.
      687     define input parameter  dwFlags           as  long.
      688     define input parameter  dwContext         as  long.
      689     define return parameter iResultCode       as  long.
      690   END.
      691   PROCEDURE InternetOpenA EXTERNAL "wininet.dll" PERSISTENT:
      692     define input parameter  sAgent            as  char.
      693     define input parameter  lAccessType       as  long.
      694     define input parameter  sProxyName        as  char.
      695     define input parameter  sProxyBypass      as  char.
      696     define input parameter  lFlags            as  long.
      697     define return parameter iResultCode       as  long.
      698   END.
      699   PROCEDURE InternetReadFile EXTERNAL "wininet.dll" PERSISTENT:
      700     define input  parameter  hFile            as  long.
