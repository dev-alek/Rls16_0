      944           end.
      945   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      946   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pgtxvalg in g#library
      947     (input  buf_goods.gds-code
      948     ,input  '1':U
      949     ,input  ?
      950     ,output v-vat-pc
      951     ) no-error .
      952           hSAXWriter:START-ELEMENT ("GoodsLocalItem") no-error.
      953           hSAXWriter:WRITE-DATA-ELEMENT("ExtCode" , string(buf_goods.gds-code, fill("9", p-long-code)) ) no-error.
      954           hSAXWriter:WRITE-DATA-ELEMENT("GoodsItemCode" , string(v-localcode)) no-error.
      955           hSAXWriter:WRITE-DATA-ELEMENT("Name" , buf_goods.gds-name) no-error.
      956           hSAXWriter:WRITE-DATA-ELEMENT("LatinName" , buf_goods.engl-name) no-error.
      957           hSAXWriter:WRITE-DATA-ELEMENT("VAT" , string(v-vat-pc)) no-error.
      958           hSAXWriter:WRITE-DATA-ELEMENT("AddData", "UNIT_TYPE=" + string(v-units-okei) ) no-error.
