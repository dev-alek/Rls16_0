      965   end.
      966   for each buf_code no-lock where
      967            buf_code.parent  = "DTSeasons":
      968     find first buf_ext-classif no-lock where buf_ext-classif.classif-subject = 'goods':U
      969         and buf_ext-classif.classif-name = 'exp-esys-gds-code':U
      970         and buf_ext-classif.key#_two = p-code_system
      971         and buf_ext-classif.key#_three = 0
      972         and buf_ext-classif.key#_one = integer(buf_code.code) no-error.
      973     if available buf_ext-classif then
      974     do:
      975       find first buf_units no-lock where
      976                  buf_units.unit-name = buf_code.misc3 no-error.
      977       v-units-okei = if available buf_units then buf_units.okei else 0.
      978       hSAXWriter:START-ELEMENT ("GoodsLocalItem") no-error.
      979       hSAXWriter:WRITE-DATA-ELEMENT("ExtCode" , string(buf_code.code, fill("9", p-long-code)) ) no-error.
      980       hSAXWriter:WRITE-DATA-ELEMENT("GoodsItemCode" , string(buf_ext-classif.charkey_one) ) no-error.
      981       hSAXWriter:WRITE-DATA-ELEMENT("Name" , buf_code.codename) no-error.
      982       hSAXWriter:WRITE-DATA-ELEMENT("LatinName" , buf_code.misc1) no-error.
      983       hSAXWriter:WRITE-DATA-ELEMENT("VAT" , buf_code.misc2) no-error.
      984       hSAXWriter:WRITE-DATA-ELEMENT("AddData", "UNIT_TYPE=" + string(v-units-okei) ) no-error.
      985       hSAXWriter:WRITE-DATA-ELEMENT("UnitType" , string(v-units-okei) ) no-error.
      986       hSAXWriter:WRITE-DATA-ELEMENT("IsActive" , if buf_code.status_ = 0 then "Yes" else "No") no-error.
      987       hSAXWriter:WRITE-DATA-ELEMENT("EffectiveDate" , "2010-01-01") no-error.
      988       hSAXWriter:WRITE-DATA-ELEMENT("ExpirationDate" , "2100-01-01") no-error.
      989       hSAXWriter:end-ELEMENT ("GoodsLocalItem") no-error.
      990     end.
      991   end.
      992   hSAXWriter:end-ELEMENT ("GoodsLocalItems") no-error.
      993   hSAXWriter:end-ELEMENT ("GoodsLocalSet") no-error.
      994   hSAXWriter:end-ELEMENT ("GoodsLocalSets") no-error.
      995   hSAXWriter:end-ELEMENT ("GoodsLocalFile") no-error.
      996   hSAXWriter:end-document() no-error.
      997   if p-place = 2 then
      998   do:
      999       if p-directory <> "":U
     1000           then
     1001       do:
     1002           run ftp-send in this-procedure (input (file_name )) no-error.
     1003           if error-status:error
     1004               then
     1005           do:
     1006                                 run write-log-and-file in p-log-handle (           input 1                                                               , input log-file-name                                                   , input 1                                                               , input substitute("Ошибка отправки по FTP: &1", return-value)).
     1007           end.
     1008           else
     1009           do:
     1010               os-delete value( file_name  ).
     1011           end.
     1012       end.
     1013   end.
     1014   procedure grp-line:
     1015       define input parameter p-grp-code as integer.
     1016       define output parameter p-ext-class-grp as character .
     1017   p-ext-class-grp = "".
     1018       find first gds-grp  no-lock  where gds-grp.node-code = p-grp-code no-error.
     1019       if available gds-grp  then
     1020       do:
     1021           find first buf_ext-classif no-lock where buf_ext-classif.classif-subject = 'gds-grp':U
     1022               and buf_ext-classif.classif-name = 'gds-grp':U
     1023               and buf_ext-classif.key#_two = p-code_system
     1024               and buf_ext-classif.key#_three = 0
     1025               and buf_ext-classif.key#_one =  gds-grp.node-code   no-error.
     1026           if available buf_ext-classif then
     1027           do:
     1028               p-ext-class-grp = buf_ext-classif.charkey_one.
     1029               return no-apply.
     1030           end.
     1031           run grp-line(input gds-grp.upper-code, output p-ext-class-grp) .
     1032       end.
     1033   end procedure.
     1034   procedure ftp-send :
     1035       define input parameter p-file-name as character        no-undo.
     1036       define variable v-parameter as character no-undo.
     1037       do
     1038           on error undo, return error
     1039           :
     1040           p-directory = trim(trim(replace(p-directory,'ftp:',""),chr(47)),chr(92)).
     1041           v-parameter = p-directory + chr(4) +
     1042               p-login + chr(4) +
     1043               p-password + chr(4) +
     1044               string(134217728) + chr(4) + ''
     1045               +
     1046               p-file-name  + chr(4) +
     1047                p-file-name + chr(4) +
     1048               string(no) + chr(4) + log-file-name.
     1049           run gbl/ftp-put.p   ( input this-procedure:handle
     1050               ,input this-procedure:handle
     1051               , input p-log-handle
     1052               , input v-parameter
     1053               ) no-error.
     1054       end.
     1055   end procedure.
