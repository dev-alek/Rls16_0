      927               and buf_ext-classif.classif-name = 'exp-esys-gds-code':U
      928               and buf_ext-classif.key#_two = p-code_system
      929               and buf_ext-classif.key#_three = 0
      930               and buf_ext-classif.key#_one = buf_goods.gds-code no-error.
      931           if not available buf_ext-classif then
      932           do:
      933               run  grp-line (input buf_goods.grp-code, output v-ext-class-grp ) .
      934                 if  v-ext-class-grp <> ""  then   do:
      935            v-localcode =  v-ext-class-grp.
      936            end.
      937             else do:
      938             v-localcode = p-code_TNP.
