      768   DEFINE INPUT PARAMETER p-log-handle AS HANDLE NO-UNDO.
      769   DEFINE INPUT PARAMETER p-directory AS CHARACTER NO-UNDO.
      770   define input parameter p-place as integer no-undo.
      771   define input parameter p-login as char no-undo.
      772   define input parameter p-password as char no-undo.
      773   define input parameter p-code_TNP as char no-undo.
      774   define input parameter p-code_pool as char no-undo.
      775   define input parameter p-code_system as integer no-undo.
      776   define input parameter p-long-code as integer no-undo.
      777   define variable v-ext-class-grp as character no-undo.
      778   define variable v-upper-code as integer no-undo.
      779   define variable v-localcode   as char      no-undo.
      780   define variable v-is-petrol   as logical   no-undo.
      781   define variable v-is-pieces   as logical   no-undo.
      782   define variable xml-date-file as character no-undo.
      783   define variable xml-time-file as character no-undo.
      784   DEFINE VARIABLE file_name     AS CHARACTER NO-UNDO.
      785   DEFINE VARIABLE v-date-file   AS CHARACTER NO-UNDO.
      786   DEFINE VARIABLE log-file-name AS CHARACTER NO-UNDO.
      787   define variable v-vat-pc      as decimal   no-undo.
      788   define variable par-type as character no-undo.
      789   define variable  ptrl as character no-undo.
      790   define variable v-number as character no-undo.
      791   define variable  v-units-okei as integer no-undo.
      792   define buffer buf_ext-classif for ext-classif.
      793   define buffer buf_goods       for goods.
      794   define buffer buf_goods-attr  for goods-attr.
      795   define buffer buf_units for units.
      796   define buffer buf_gds-grp for gds-grp.
      797   define buffer buf_code for ub.code.
      798   xml-date-file = STRING(YEAR(TODAY), "9999") + "-" + STRING(MONTH(TODAY), "99") + "-" + STRING(DAY(TODAY), "99").
      799   xml-time-file = substring(string(time,"HH:MM:SS"),1,2) + ":" + substring(string(time,"HH:MM:SS"),4,2) + ":" + substring(string(time,"HH:MM:SS"),7,2).
      800   v-number = substring(string(time,"HH:MM"),1,2) + substring(string(time,"HH:MM"),4,2).
      801   v-date-file  = STRING(YEAR(TODAY), "9999") + STRING(MONTH(TODAY), "99") + STRING(DAY(TODAY), "99") +    string(integer(v-number), fill("9", 5)).
      802   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      803     (input  'spl-ptrl'
      804     ,input  '':U
      805     ,input  '':U
      806     ,input  '':U
      807     ,input  '':U
      808     ,input  '':U
      809     ,input  '':U
      810     ,input  NO
      811     ,output ptrl
      812     ,output par-type
      813     ) NO-ERROR .
      814   if p-place = 1 then
      815   do:
      816       log-file-name = p-directory + "Goods-VBBR.txt":U.
      817       file_name = p-directory + ' Goods':U + string(integer(ptrl) , fill("9", 5 ))  + v-date-file  + '.xml'.
      818   end.
      819   if p-place = 2 then
      820   do:
      821       file_name = session:temp-directory + 'Goods':U +  string(integer(ptrl) , fill("9", 5) )  +  v-date-file  + '.xml'.
      822       assign
      823           log-file-name = "Goods-VBBR.log"
      824           .
      825    end.
      826   define variable hSAXWriter as handle no-undo.
      827   create sax-writer hSAXWriter no-error.
      828   hSAXWriter:set-output-destination("file":U, file_name) no-error.
      829   hSAXWriter:formatted = true.
      830   hSAXWriter:encoding = "windows-1251":U.
      831   hSAXWriter:start-document() no-error.
      832   hSAXWriter:START-ELEMENT ("GoodsLocalFile") no-error.
      833   hSAXWriter:START-ELEMENT ("FileHeader") no-error.
      834   hSAXWriter:WRITE-DATA-ELEMENT("FileLabel" , "FG"  ) no-error.
      835   hSAXWriter:WRITE-DATA-ELEMENT("FormatVersion" , "1.0"  ) no-error.
      836   hSAXWriter:WRITE-DATA-ELEMENT("Sender" , ptrl ) no-error.
      837   hSAXWriter:WRITE-DATA-ELEMENT("CreationDate" , xml-date-file ) no-error.
      838   hSAXWriter:WRITE-DATA-ELEMENT("CreationTime" , xml-time-file ) no-error.
      839   hSAXWriter:WRITE-DATA-ELEMENT("Number" ,  string(integer(v-number), fill("9", 5)) ) no-error.
      840   hSAXWriter:WRITE-DATA-ELEMENT("Institution" , string(integer(ptrl) , fill("9", 5) ) ) no-error.
      841   hSAXWriter:end-ELEMENT ("FileHeader") no-error.
      842   hSAXWriter:START-ELEMENT ("GoodsLocalSets") no-error.
      843   hSAXWriter:START-ELEMENT ("GoodsLocalSet") no-error.
      844   hSAXWriter:WRITE-DATA-ELEMENT("Code" , p-code_pool) no-error.
      845   hSAXWriter:WRITE-DATA-ELEMENT("Name" , p-code_pool ) no-error.
      846   hSAXWriter:START-ELEMENT ("GoodsLocalItems") no-error.
      847   for each buf_goods where buf_goods.stts = 0  no-lock :
      848        find first buf_units no-lock
      849            where buf_units.unit-name = buf_goods.unit-base  no-error.
      850              v-units-okei = buf_units.okei.
      851       if buf_goods.gds-type = 'у':U and  can-find (first buf_goods-attr where buf_goods-attr.gds-code = buf_goods.gds-code and buf_goods-attr.attr-code = 'office-type':U )  then next.
      852       if not buf_goods.gds-type = 'у':U then
      853       do:
      854   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      855     (
      856        input buf_goods.artic
      857     ,  input buf_goods.prod-type
      858     ,  input buf_goods.prod-code
      859     , output v-is-petrol
      860     , output v-is-pieces
      861     ) .
      862       end.
      863       if buf_goods.gds-type = 'у':U or  v-is-petrol then
      864       do:
      865           find first buf_ext-classif no-lock where buf_ext-classif.classif-subject = 'goods':U
      866               and buf_ext-classif.classif-name = 'exp-esys-gds-code':U
      867               and buf_ext-classif.key#_two = p-code_system
      868               and buf_ext-classif.key#_three = 0
      869               and buf_ext-classif.key#_one = buf_goods.gds-code no-error.
      870           if not available buf_ext-classif then
      871           do:
      872         run  grp-line (input buf_goods.grp-code, output v-ext-class-grp ) .
      873              if  v-ext-class-grp <> ""  then   do:
      874            v-localcode =  v-ext-class-grp.
      875   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      876   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pgtxvalg in g#library
      877     (input  buf_goods.gds-code
      878     ,input  '1':U
      879     ,input  ?
      880     ,output v-vat-pc
      881     ) no-error .
      882           hSAXWriter:START-ELEMENT ("GoodsLocalItem") no-error.
      883           hSAXWriter:WRITE-DATA-ELEMENT("ExtCode" , string(buf_goods.gds-code, fill("9", p-long-code)) ) no-error.
      884           hSAXWriter:WRITE-DATA-ELEMENT("GoodsItemCode" , string(v-localcode) ) no-error.
      885           hSAXWriter:WRITE-DATA-ELEMENT("Name" , buf_goods.gds-name) no-error.
      886           hSAXWriter:WRITE-DATA-ELEMENT("LatinName" , buf_goods.engl-name) no-error.
      887           hSAXWriter:WRITE-DATA-ELEMENT("VAT" , string(v-vat-pc)) no-error.
      888           hSAXWriter:WRITE-DATA-ELEMENT("AddData", "UNIT_TYPE=" + string(v-units-okei) ) no-error.
      889           hSAXWriter:WRITE-DATA-ELEMENT("UnitType" , string(v-units-okei) ) no-error.
      890           hSAXWriter:WRITE-DATA-ELEMENT("IsActive" , "Yes") no-error.
      891           hSAXWriter:WRITE-DATA-ELEMENT("EffectiveDate" , "2010-01-01") no-error.
      892           hSAXWriter:WRITE-DATA-ELEMENT("ExpirationDate" , "2100-01-01") no-error.
      893           hSAXWriter:end-ELEMENT ("GoodsLocalItem") no-error.
      894            end.
      895             else do:
      896                                        run write-log-and-file in p-log-handle (           input 1                                                               , input log-file-name                                                   , input 1                                                               , input SUBSTITUTE("Товар: &1 &2.", buf_goods.gds-name, buf_goods.gds-code)).
      897                                        run write-log-and-file in p-log-handle (           input 1                                                               , input log-file-name                                                   , input 1                                                               , input substitute("Ошибка: нет соответствующего кода внешней системы ")).
      898            end.
      899     end.
      900           else
      901           do:
      902               v-localcode = buf_ext-classif.charkey_one.
