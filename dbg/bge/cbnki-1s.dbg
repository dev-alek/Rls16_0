      231      ,'Получатель='                     , 'receiver-inn/receiver-name'
      232      ,'Получатель1='                    , 'receiver-name'
      233      ,'Получатель2='                    , 'receiver-r-schet'
      234      ,'Получатель3='                    , 'receiver-bank-name'
      235      ,'Получатель4='                    , 'receiver-bank-city'
      236      ,'ПолучательСчет='                 , 'receiver-r-schet'
      237      ,'ПолучательИНН='                  , 'receiver-INN'
      238      ,'ПолучательКПП='                  , 'receiver-kpp'
      239      ,'ПолучательРасчСчет='             , 'receiver-r-schet'
      240      ,'ПолучательБИК='                  , 'receiver-bik'
      241      ,'ПолучательКорСчет='              , 'receiver-c-schet'
      242      ,'ПолучательБанк1='                , 'receiver-bank-name'
      243      ,'ПолучательБанк2='                , 'receiver-bank-city'
      244      ,'СтатусСоставителя='              , 'stat-pl'
      245      ,'ПоказательКБК='                  , 'f104'
      246      ,'ПоказательОснования='            , 'f106'
      247      ,'ОКАТО='                          , 'f105'
      248      ,'ПоказательПериода='              , 'f107'
      249      ,'ПоказательНомера='               , 'f108'
      250      ,'ПоказательДаты='                 , 'f109'
      251      ,'ПоказательТипа='                 , 'f110'
      252      ,'НазначениеПлатежа='              , 'naznach-plat/'
      253      ,'ВидПлатежа='                     , 'vid-plat'
      254      ,'ВидОплаты='                      , 'vid-opl'
      255      ,'Очередность='                    , 'ocher-pl'
      256      ,'СрокПлатежа='                    , 'srok-pl'
      257      ,'СекцияДокумент='                 , 'fin-ext-doc-type/'
      258      ,'ДатаСписано='                    , 'fact-date'
