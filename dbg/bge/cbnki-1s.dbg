        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-log-handle  as handle no-undo .
        4   define input parameter p-file-name as character no-undo .
        5   define input parameter p-host-code like ub.sysconf.host-code no-undo .
        6   define input parameter p-bik       like ub.fin-bank.bik      no-undo .
        7   define input parameter p-code-bank like ub.fin-bank.code-bank no-undo .
