      271      ,'КвитанцияВремя'                  , 'cvitname'
      272      ,'КвитанцияСодержание'             , 'cvitcont'
      273                                      ] no-undo.
      274   define variable h-init-statement as character  extent 40 init
      275   [
      276       'ДатаНачала='                     , 'start-date'
      277      ,'ДатаКонца='                      , 'end-date'
      278      ,'РасчСчет='                       , 'r-schet'
      279      ,'НачальныйОстаток='               , 'start-sum-doc'
      280      ,'КонечныйОстаток='                , 'end-sum-doc'
      281      ,'ВсегоПоступило='                 , 'in-sum-doc'
      282      ,'ВсегоСписано='                   , 'out-sum-doc'
      283      ,'СекцияРасчСчет='                 , 'fins-ext-doc-type/'
      284      ,''                                , 'fins-ext-doc-type'
      285      ,''                                , 'fins-doc-type'
      286      ,''                                , 'host-code'
      287      ,''                                , 'curr-code'
      288      ,''                                , 'code-schet'
      289      ,''                                , 'code-bank'
      290      ,''                                , 'cli-name'
      291      ,''                                , 'bank-name'
      292      ,''                                , 'bank-city'
      293      ,''                                , 'cl-bank'
      294      ,''                                , 'bik'
      295      ,'ДатаСоздания='                   , 'bank-date'
      296                                      ] no-undo.
      297       for each temp_hfields:
      298         delete temp_hfields.
      299       end.
      300       do ii = 1 to (if p-mode = 'exp' then 42 else 58):
      301         create temp_hfields.
      302         assign
      303         temp_hfields.order_ = ii
      304         temp_hfields.label_ = h-init-doc[ii * 2 - 1]
      305         temp_hfields.name_ = h-init-doc[ii * 2]
      306         temp_hfields.subject = 'fin-doc':U
      307         .
      308       end.
      309       do ii = 1 to (if p-mode = 'exp' then 0 else 20):
      310         create temp_hfields.
      311         assign
      312         temp_hfields.order_ = ii
      313         temp_hfields.label_ = h-init-statement[ii * 2 - 1]
      314         temp_hfields.name_ = h-init-statement[ii * 2]
      315         temp_hfields.subject = 'fin-statement':U
      316         .
      317       end.
      318     end.
      319   end procedure.
      320   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      321   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      322   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      323   procedure cur-time :
      324      define output parameter p-today as date      no-undo .
      325      define output parameter p-time  as integer   no-undo .
      326     do
      327     on error undo, return error
      328     :
      329       define variable v-date1 as date      no-undo .
      330       define variable v-date2 as date      no-undo .
      331       define variable v-time  as integer   no-undo .
      332       assign
      333         v-date1 = today
      334         v-time  = time
      335         v-date2 = today
      336       .
      337       if v-date1 <> v-date2
      338       then do:
      339         assign
      340           v-date1 = today
      341           v-time  = v-time
      342         .
      343       end.
      344       assign
      345         p-today = v-date1
      346         p-time  = v-time
      347       .
      348     end.
      349   end.
      350   function cur-time-date returns character
      351   :
      352     return string(today, '99/99/9999':U) .
      353   end.
      354   function cur-time-mjd returns decimal
      355   :
      356     define variable v-date as date      no-undo .
      357     define variable v-time as integer   no-undo .
      358     run cur-time in this-procedure
      359       (output v-date
      360       ,output v-time
      361       ) .
      362     return integer(v-date) - 2400002 + (v-time / 86400) .
      363   end.
      364   function cur-time-get-ending-index returns integer
      365   (input p-number as integer
      366   )
      367   :
      368     if p-number < 0
      369     or p-number = ?
      370     then do:
      371       return 1 .
      372     end.
      373     define variable v-rest as integer   no-undo .
      374     assign
      375       p-number = p-number modulo 100
      376     .
      377     if p-number < 20
      378     then do:
      379       assign
      380         v-rest = p-number
      381       .
      382     end.
      383     else do:
      384       assign
      385         v-rest = p-number modulo 10
      386       .
      387     end.
      388     case v-rest :
      389       when 1
      390       then do:
      391         return 2 .
      392       end.
      393       when 2 or
      394       when 3 or
      395       when 4
      396       then do:
      397         return 3 .
      398       end.
      399       otherwise do:
      400         return 1 .
      401       end.
      402     end case .
      403   end.
      404   procedure cur-time-mjd-to-date :
      405      define input  parameter i-mjd-diff as decimal no-undo.
      406      define output parameter o-Date     as date    no-undo.
      407      define output parameter o-Time     as integer no-undo.
      408      define variable v-day-number as integer   no-undo .
      409      if    i-mjd-diff < 0
      410         or i-mjd-diff = ?
      411      then do:
      412         return "?" .
      413      end.
      414      assign
      415         v-day-number = truncate(i-mjd-diff,0).
      416         o-Date = date(v-day-number + 2400002).
      417         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      418     .
      419   end.
      420   function cur-time-mjd-to-string returns character
      421   (input p-mjd-diff as decimal
      422   )
      423   :
      424     define variable v-day-number as integer   no-undo .
      425     define variable v-seconds    as integer   no-undo .
      426     define variable v-hour       as integer   no-undo .
      427     define variable v-min        as integer   no-undo .
      428     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      429     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      430     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      431     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      432     if p-mjd-diff < 0
      433     or p-mjd-diff = ?
      434     then do:
      435       return "?" .
      436     end.
      437     assign
      438       v-day-number = integer(truncate(p-mjd-diff,0))
      439       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      440     .
      441     if v-seconds > 86400
      442     then do:
      443       assign
      444         v-seconds = 86400 - 1
      445       .
      446     end.
      447     if v-seconds < 0
      448     then do:
      449       assign
      450         v-seconds = 0
      451       .
      452     end.
      453     assign
      454       v-hour = truncate(v-seconds / 3600, 0)
      455     .
      456     assign
      457       v-seconds = v-seconds modulo 3600
      458     .
      459     assign
      460       v-min = truncate(v-seconds / 60, 0)
      461     .
      462     assign
      463       v-seconds = v-seconds modulo 60
      464     .
      465     return
      466         (if v-day-number <> 0
      467           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      468           else ""
      469         )
      470       + (if v-day-number <> 0 or v-hour <> 0
      471           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      472           else ""
      473         )
      474       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      475           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      476           else ""
      477         )
      478       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      479       .
      480   end.
      481   function cur-time-string returns character
      482   :
      483     define variable v-date as date      no-undo .
      484     define variable v-time as integer   no-undo .
      485     run cur-time in this-procedure
      486       (output v-date
      487       ,output v-time
      488       ) .
      489     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      490   end.
      491   function cur-time-string-sec returns character
      492   :
      493     define variable v-date as date      no-undo .
      494     define variable v-time as integer   no-undo .
      495     run cur-time in this-procedure
      496       (output v-date
      497       ,output v-time
      498       ) .
      499     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      500   end.
      501   function cur-time-custom  returns character
      502   (input p-prefix as character
      503   ,input p-date-format as character
      504   ,input p-delimiter as character
      505   ,input p-time-format as character
      506   ,input p-suffix as character
      507   )
      508   :
      509     define variable v-date as date      no-undo .
      510     define variable v-time as integer   no-undo .
      511     run cur-time in this-procedure
      512       (output v-date
      513       ,output v-time
      514       ) .
      515     return
      516       p-prefix
      517       + string(v-date, p-date-format)
      518       + p-delimiter
      519       + string(v-time, p-time-format)
      520       + p-suffix
      521       .
      522   end.
      523   function cur-time-print  returns character
      524   :
      525     define variable v-date as date      no-undo .
      526     define variable v-time as integer   no-undo .
      527     run cur-time in this-procedure
      528       (output v-date
      529       ,output v-time
      530       ) .
      531     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      532   end.
      533   function cur-time-datetime returns datetime
      534   :
      535     define variable v-char as character no-undo .
      536     define variable v-datetime as datetime no-undo .
      537     v-char = cur-time-string().
      538     v-datetime = datetime(v-char).
      539     return  v-datetime.
      540   end.
      541   function cur-time-string-msec returns character
      542   :
      543     define variable v-date as datetime  no-undo .
      544     v-date = now.
      545     return string(v-date) .
      546   end.
      547   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      548   procedure write-fin-doc-attr-proc :
      549   define parameter buffer buf_fin-doc-attr for ub.fin-doc-attr.
      550   define variable v-date as date no-undo .
      551   define variable v-time as integer no-undo .
      552   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
      553     do
      554     on error undo, return error
      555     :
      556       if not available buf_fin-doc-attr then do:
      557         undo, return error (vss-workfile + chr(32) + vss-revision + chr(32) + vss-description  + chr(10) +
      558                       "Ошибка задания входных параметров:Не определен атрибут платежа" ).
      559       end.
      560       run cur-time in this-procedure(output v-date, output v-time).
      561       create buf_c-fin-doc-attr.
      562       buffer-copy buf_fin-doc-attr to buf_c-fin-doc-attr
      563       assign
      564       buf_c-fin-doc-attr.chip-num           = next-value (s-corr-chip, ub)
      565       buf_c-fin-doc-attr.corr-time          = v-time
      566       buf_c-fin-doc-attr.corr-user-db-num   = g#db-num
      567       buf_c-fin-doc-attr.corr-user-name     = g#userid
      568       buf_c-fin-doc-attr.corr-date          = v-date
      569       .
      570       release buf_c-fin-doc-attr.
      571     end.
      572   end procedure.
      573   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      574   procedure factord :
      575     define input  parameter p-fact-date            as date    no-undo .
      576     define input  parameter p-fact-time            as integer no-undo .
      577     define input  parameter p-fact-num             as integer no-undo .
      578     define input  parameter p-shift-date           as date    no-undo .
      579     define input  parameter p-shift-num            as integer no-undo .
      580     define input  parameter p-shift-on             as logical no-undo .
      581     define output parameter p-fact-order           as decimal no-undo .
      582     define output parameter p-shift-end-fact-order as decimal no-undo .
      583     define output parameter p-day-end-fact-order   as decimal no-undo .
      584     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      585     if p-fact-date = ?
      586     then do:
      587       return error "Не указана фактическая дата" .
      588     end.
      589     define variable v-fact-date-num as integer no-undo .
      590     assign
      591       v-fact-date-num = integer(p-fact-date)
      592     .
      593     if p-fact-num = ?
      594     or p-fact-num = 0
      595     then do:
      596       return error "Не задан p-fact-num " + string(p-fact-num) .
      597     end.
      598     if p-fact-num < 0
      599     then do:
      600       return error "Отрицательный fact-num " + string(p-fact-num) .
      601     end.
      602     if p-fact-num >= 100000000
      603     then do:
      604       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      605     end.
      606     if p-shift-on = true
      607     then do:
      608       if p-shift-date = ?
      609       then do:
      610         return error "Не задана дата смены" .
      611       end.
      612       if p-shift-num = ?
      613       or p-shift-num = 0
      614       then do:
      615         return error "Не задан номер смены" .
      616       end.
      617     end.
      618     else do:
      619       assign
      620         p-shift-date = p-fact-date
      621         p-shift-num  = 24
      622       .
      623     end.
      624     define variable v-shift-offset as integer no-undo .
      625     if p-shift-date = p-fact-date
      626     then do:
      627       assign
      628         v-shift-offset = 1
      629       .
      630     end.
      631     if p-shift-date < p-fact-date
      632     then do:
      633       assign
      634         v-shift-offset = 0
      635       .
      636     end.
      637     if p-shift-date > p-fact-date
      638     then do:
      639       message
      640         vss-workfile vss-revision vss-description skip
      641         "Неправильная дата закрытия смены" skip
      642         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      643         view-as alert-box error .
      644       undo, return error
      645         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      646           ,string(p-fact-date, '99/99/9999':U)
      647           ,string(p-shift-date, '99/99/9999':U)
      648           )
      649       .
      650     end.
      651     if p-shift-num < 1
      652     or p-shift-num > 24
      653     then do:
      654       message
      655         vss-workfile vss-revision vss-description skip
      656         "Неправильный номер смены" skip
      657         "p-shift-num" p-shift-num skip
      658         view-as alert-box error .
      659       undo, return error return-value .
      660     end.
      661     assign
      662       p-fact-order           = v-fact-date-num
      663                              + v-shift-offset * 0.5
      664                              + p-shift-num    * 0.02 - 0.01
      665                              + p-fact-num     * 0.0000000001
      666       p-shift-end-fact-order = v-fact-date-num
      667                              + v-shift-offset * 0.5
      668                              + p-shift-num    * 0.02
      669       p-day-end-fact-order   = v-fact-date-num
      670                              + 0.99
      671     .
      672     if p-fact-order           <= v-fact-date-num
      673     or p-shift-end-fact-order <= v-fact-date-num
      674     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      675     or p-shift-end-fact-order >= p-day-end-fact-order
      676     then do:
      677       message
      678         vss-workfile vss-revision vss-description skip
      679         "Внутренняя ошибка при генерации фактического номера" skip
      680         "p-fact-date"            p-fact-date            skip
      681         "p-fact-time"            p-fact-time            skip
      682         "p-fact-num"             p-fact-num             skip
      683         "p-shift-date"           p-shift-date           skip
      684         "p-shift-num"            p-shift-num            skip
      685         "p-shift-on"             p-shift-on             skip
      686         "p-shift-end-fact-order" p-shift-end-fact-order skip
      687         "p-day-end-fact-order"   p-day-end-fact-order   skip
      688         "v-fact-date-num"        v-fact-date-num        skip
      689         view-as alert-box error .
      690       undo, return error return-value .
      691     end.
      692   end procedure.
      693   procedure day-begin-fact-order :
      694     define input  parameter p-fact-date            as date    no-undo .
      695     define output parameter p-day-begin-fact-order as decimal no-undo .
      696     do
      697     on error undo, return error return-value
      698     :
      699       if p-fact-date = ?
      700       then do:
      701         assign
      702           p-day-begin-fact-order = 0
      703         .
      704       end.
      705       else do:
      706         assign
      707           p-day-begin-fact-order = integer(p-fact-date)
      708         .
      709       end.
      710     end.
      711   end procedure.
      712   procedure factord-max-fact-order :
      713     define output parameter p-max-fact-order as decimal   no-undo .
      714     do
      715     on error undo, return error return-value
      716     :
      717       run day-begin-fact-order in this-procedure
      718         (input  date(1, 1, 5000)
      719         ,output p-max-fact-order
      720         ) .
      721     end.
      722   end procedure.
      723   procedure factord-cut-archive :
      724     define input  parameter p-obj-type             as character no-undo .
      725     define input  parameter p-obj-code             as integer   no-undo .
      726     define input  parameter p-fact-date            as date      no-undo .
      727     define output parameter p-shift-on             as logical   no-undo .
      728     define output parameter p-shift-date           as date      no-undo .
      729     define output parameter p-shift-num            as integer   no-undo .
      730     define output parameter p-day-end-fact-order   as decimal   no-undo .
      731     define output parameter p-shift-end-fact-order as decimal   no-undo .
      732     define variable v-fact-order as decimal   no-undo .
      733     define buffer buf_shift-obj for ub.shift-obj .
      734     do
      735     on error undo, return error return-value
      736     :
      737   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      738   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      739     (input  p-obj-type
      740     ,input  p-obj-code
      741     ,input  'shift-on=request'
      742     ,output p-shift-on
      743     ) no-error .
      744       if error-status :error
      745       then do:
      746         message
      747           vss-workfile vss-revision vss-description skip
      748           "Ошибка при определении атрибута объекта" skip
      749           "Объект" p-obj-type p-obj-code skip
      750           error-status :get-message(1) skip
      751           return-value skip
      752           view-as alert-box error .
      753         undo, return error return-value .
      754       end.
      755       if p-shift-on = false
      756       then do:
      757         assign
      758           p-shift-date               = ?
      759           p-shift-num                = 0
      760         .
      761       end.
      762       else do:
      763         find first buf_shift-obj share-lock
      764           where buf_shift-obj.obj-type   = p-obj-type
      765             and buf_shift-obj.obj-code   = p-obj-code
      766             and buf_shift-obj.shift-date > p-fact-date
      767           use-index pi
      768           no-error .
      769         if not available buf_shift-obj
      770         or buf_shift-obj.status_ <> 'зкр':U
      771         then do:
      772           message
      773             vss-workfile vss-revision vss-description skip
      774             "Невозможно вычислить последнюю смену" skip
      775             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      776             "Объект" p-obj-type p-obj-code skip
      777             "Дата" p-fact-date skip
      778             view-as alert-box error .
      779           undo, return error return-value .
      780         end.
      781         find last buf_shift-obj share-lock
      782           where buf_shift-obj.obj-type = p-obj-type
      783             and buf_shift-obj.obj-code = p-obj-code
      784             and buf_shift-obj.shift-date <= p-fact-date
      785           use-index pi
      786           no-error .
      787         if available buf_shift-obj
      788         then do:
      789           if  buf_shift-obj.status_ = 'зкр':U
      790           then do:
      791             assign
      792               p-shift-date = buf_shift-obj.shift-date
      793               p-shift-num  = buf_shift-obj.shift-num
      794             .
      795           end.
      796           else do:
      797             message
      798               vss-workfile vss-revision vss-description skip
      799               "Невозможно вычислить последнюю смену" skip
      800               "Статус смены отличен от статуса" 'зкр':U skip
      801               "Объект" p-obj-type p-obj-code skip
      802               "Дата" p-fact-date skip
      803               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      804               view-as alert-box error .
      805             undo, return error return-value .
      806           end.
      807         end.
      808         else do:
      809           assign
      810             p-shift-date = p-fact-date - 1
      811             p-shift-num  = 1
      812           .
      813         end.
      814       end.
      815       run factord in this-procedure
      816         (input  p-fact-date
      817         ,input  1
      818         ,input  1
      819         ,input  p-shift-date
      820         ,input  p-shift-num
      821         ,input  p-shift-on
      822         ,output v-fact-order
      823         ,output p-shift-end-fact-order
      824         ,output p-day-end-fact-order
      825         ) no-error .
      826       if error-status :error
      827       then do:
      828         message
      829           vss-workfile vss-revision vss-description skip
      830           "Ошибка при вызове процедуры factord"
      831           error-status :get-message(1) skip
      832           return-value skip
      833           view-as alert-box error .
      834         undo, return error return-value .
      835       end.
      836     end.
      837   end procedure.
      838   procedure factord-lock-shift :
      839     define input  parameter p-obj-type  as character no-undo .
      840     define input  parameter p-obj-code  as integer   no-undo .
      841     define input  parameter p-fact-date as date      no-undo .
      842     define parameter buffer buf_shift-obj for ub.shift-obj .
      843     define variable v-shift-on      as logical   no-undo .
      844     define variable v-extra-message as character no-undo .
      845     define variable v-error as character no-undo .
      846     do
      847     on error undo, return error return-value
      848     :
      849   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      850   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      851     (input  p-obj-type
      852     ,input  p-obj-code
      853     ,input  'shift-on=request'
      854     ,output v-shift-on
      855     ) no-error .
      856       if error-status :error
      857       then do:
      858         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      859         undo, return error v-error .
      860       end.
      861       if v-shift-on = true
      862       then do:
      863         find first buf_shift-obj share-lock
      864           where buf_shift-obj.obj-type   = p-obj-type
      865             and buf_shift-obj.obj-code   = p-obj-code
      866             and buf_shift-obj.shift-date > p-fact-date
      867           use-index pi
      868           no-error .
      869         if not available buf_shift-obj
      870         or buf_shift-obj.status_ <> 'зкр':U
      871         then do:
      872           find last buf_shift-obj
      873             where buf_shift-obj.obj-type = p-obj-type
      874               and buf_shift-obj.obj-code = p-obj-code
      875               and buf_shift-obj.status_  = 'зкр':U
      876             use-index stts
      877             no-error .
      878           if available buf_shift-obj
      879           then do:
      880             assign
      881               v-extra-message =
      882                     substitute("Дата начала последеней закрытой смены на объекте &1"
      883                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      884                               )
      885             .
      886           end.
      887           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      888           undo, return error v-error .
      889         end.
      890       end.
      891     end.
      892   end procedure.
      893   procedure factord-end-day :
      894     define input  parameter p-fact-date            as date    no-undo .
      895     define output parameter p-day-end-fact-order   as decimal no-undo .
      896     do
      897     on error undo, return error return-value
      898     :
      899       if p-fact-date = ?
      900       then do:
      901         return error "Не указана фактическая дата" .
      902       end.
      903       assign
      904         p-day-end-fact-order = integer(p-fact-date) + 0.99
      905       .
      906     end.
      907   end procedure.
      908   procedure factord-to-date :
      909     define input  parameter p-fact-order as decimal no-undo .
      910     define output parameter p-fact-date  as date    no-undo .
      911     define variable v-ref-date  as date      no-undo .
      912     define variable v-ref-delta as integer   no-undo .
      913     do
      914     on error undo, return error return-value
      915     :
      916       if p-fact-order = ?
      917       or p-fact-order = 0
      918       then do:
      919         return error "Не указан fact-order" .
      920       end.
      921       assign
      922         v-ref-date  = date(1, 1, 2000)
      923       .
      924       assign
      925         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      926       .
      927       assign
      928         p-fact-date = v-ref-date + v-ref-delta
      929       .
      930     end.
      931   end procedure.
      932   procedure factord-to-fact-num :
      933     define input  parameter p-fact-order as decimal no-undo .
      934     define output parameter p-fact-num   as integer no-undo .
      935     define variable v-fact-order-trunc as decimal no-undo .
      936     do
      937     on error undo, return error return-value
      938     :
      939       if p-fact-order = ?
      940       or p-fact-order = 0
      941       then do:
      942         return error "Не указан fact-order" .
      943       end.
      944       assign
      945        v-fact-order-trunc = truncate(p-fact-order, 2)
      946       .
      947       assign
      948         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      949       .
      950     end.
      951   end procedure.
      952   procedure factord-to-shift-num :
      953     define input  parameter p-fact-order as decimal no-undo .
      954     define output parameter p-shift-num   as integer no-undo .
      955     define variable  p-shift-numd  as decimal   no-undo .
      956     define variable v-fact-order-trunc as decimal no-undo .
      957     do
      958     on error undo, return error return-value
      959     :
      960       if p-fact-order = ?
      961       or p-fact-order = 0
      962       then do:
      963         return error "Не указан fact-order" .
      964       end.
      965       assign
      966        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      967       .
      968       if v-fact-order-trunc < 0.5 then do:
      969         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      970       end.
      971       assign
      972         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      973         .
      974        assign
      975         p-shift-num = truncate (p-shift-numd , 0)
      976       .
      977     end.
      978   end procedure.
      979   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      980   procedure gen-b-code :
      981     define input  parameter type-code like ub.code-range.range-type no-undo .
      982     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      983     do
      984     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      985     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      986     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      987     :
      988       define buffer buf_thbj-attr     for ub.thbj-attr .
      989       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      990       define buffer buf_code-range for ub.code-range .
      991       define variable l-code         as   integer              no-undo .
      992       define variable v-db-num       like ub.db.db-num         no-undo .
      993       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      994       if type-code = 'sslc':U
      995       or type-code = 'ssgb':U
      996       then do:
      997         message
      998           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      999           "Обратитесь к администратору системы."
     1000           view-as alert-box error .
     1001         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
     1002       end.
     1003       run trg/getpcode.p ( input  type-code
     1004                      ,output cfg-param-code
     1005                     ).
     1006       run get-next-seq( input  type-code,
     1007                         output l-code
     1008                       ).
     1009       find first buf_sys-ctrl no-lock.
     1010       if type-code = 'sclc':U
     1011       or type-code = 'pglc':U
     1012       then do:
     1013         assign
     1014           v-db-num = 0
     1015         .
     1016       end.
     1017       else do:
     1018         assign
     1019           v-db-num = buf_sys-ctrl.db-num
     1020         .
     1021       end.
     1022       find first buf_code-range no-lock
     1023         where buf_code-range.db-num     = v-db-num
     1024           and buf_code-range.range-type = type-code
     1025           and buf_code-range.stts       = "a"
     1026         use-index stts
     1027         no-error .
     1028       if available buf_code-range
     1029          and l-code <= buf_code-range.last-code
     1030          and l-code >= buf_code-range.first-code then do:
     1031         assign
     1032           p-b-code = l-code
     1033         .
     1034       end.
     1035       else do:
     1036         if available buf_code-range
     1037            and l-code < buf_code-range.last-code then do:
     1038           message
     1039             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
     1040             "Обратитесь к администратору системы."
     1041             view-as alert-box error .
     1042           undo, return error "sequence":U .
     1043         end.
     1044         do transaction
     1045         on error undo, return error
     1046         :
     1047           find first buf_thbj-attr exclusive-lock
     1048             where buf_thbj-attr.upper-prop-code = 'code-range':U
     1049               and buf_thbj-attr.prop-code = cfg-param-code
     1050               and buf_thbj-attr.obj-type   = 'БД':U
     1051               and buf_thbj-attr.obj-code   = v-db-num
     1052             no-error .
     1053           if not available buf_thbj-attr then do:
     1054             find first buf_thbj-attr exclusive-lock
     1055               where buf_thbj-attr.upper-prop-code = 'code-range':U
     1056                 and buf_thbj-attr.prop-code = cfg-param-code
     1057                 and buf_thbj-attr.obj-type   = ''
     1058                 and buf_thbj-attr.obj-code   = 0
     1059               no-error .
     1060             if not available buf_thbj-attr then do:
     1061               if not locked buf_thbj-attr then do:
     1062                 message
     1063                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
     1064                   "Обратитесь к администратору системы."
     1065                   view-as alert-box error .
     1066               end.
     1067               undo, return error "config":U .
     1068             end.
     1069           end.
     1070           run get-next-seq( input type-code,
     1071                             output l-code
     1072                           ).
     1073           find first buf_code-range
     1074             where buf_code-range.db-num     = v-db-num
     1075               and buf_code-range.range-type = type-code
     1076               and buf_code-range.stts       = "a"
     1077             use-index stts
     1078             no-error .
     1079           if available buf_code-range
     1080           and l-code <= buf_code-range.last-code
     1081           and l-code >= buf_code-range.first-code
     1082           then do:
     1083             assign
     1084               p-b-code = l-code
     1085             .
     1086           end.
     1087           else do:
     1088             if available buf_code-range then do:
     1089               assign
     1090                 buf_code-range.stts = "u"
     1091               .
     1092             end.
     1093             find first buf_code-range
     1094               where buf_code-range.db-num     = v-db-num
     1095                 and buf_code-range.range-type = type-code
     1096                 and buf_code-range.stts       = "f"
     1097               use-index stts
     1098               no-error .
     1099             if not available buf_code-range then do:
     1100               message
     1101                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
     1102                 "Обратитесь к администратору системы"
     1103                 view-as alert-box error .
     1104               undo, return error "code-range":U .
     1105             end.
     1106             assign
     1107               buf_code-range.stts           = "a"
     1108             .
     1109             if buf_code-range.first-code = 1 then do:
     1110               run set-seq-cr( input type-code,
     1111                               input buf_code-range.first-code
     1112                             ).
     1113               assign
     1114                 p-b-code = 1
     1115               .
     1116             end.
     1117             else do:
     1118               run set-seq-cr( input type-code,
     1119                               input ( buf_code-range.first-code - 1 )
     1120                             ).
     1121               run get-next-seq( input type-code,
     1122                                 output p-b-code
     1123                               ).
     1124             end.
     1125           end.
     1126         end.
     1127       end.
     1128     end.
     1129   end procedure.
     1130   procedure get-next-seq :
     1131     define input  parameter type-code like ub.code-range.range-type no-undo .
     1132     define output parameter next-seq  as   integer                  no-undo .
     1133     do
     1134     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1135     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
     1136     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
     1137     :
     1138       case type-code:
     1139         when 'bcgb':U then do:
     1140           assign
     1141             next-seq = next-value(s-bcgb-code, ub)
     1142           .
     1143         end.
     1144         when 'scgb':U then do:
     1145           assign
     1146             next-seq = next-value(s-scgb-code, ub)
     1147           .
     1148         end.
     1149         when 'sclc':U then do:
     1150           assign
     1151             next-seq = next-value(s-sclc-code, ub)
     1152           .
     1153         end.
     1154         when 'pglc':U then do:
     1155           assign
     1156             next-seq = next-value(s-pglc-code, ub)
     1157           .
     1158         end.
     1159         when 'dcgb':U then do:
     1160           assign
     1161             next-seq = next-value(s-dcgb-code, ub)
     1162           .
     1163         end.
     1164         when 'ctgb':U then do:
     1165           assign
     1166             next-seq = next-value(s-ctgb-code, ub)
     1167           .
     1168         end.
     1169         when 'drgb':U then do:
     1170           assign
     1171             next-seq = next-value(s-drgb-code, ub)
     1172           .
     1173         end.
     1174         when 'fmgb':U then do:
     1175           assign
     1176             next-seq = next-value(s-fmgb-code, ub)
     1177           .
     1178         end.
     1179         when 'pngb':U then do:
     1180           assign
     1181             next-seq = next-value(s-pngb-code, ub)
     1182           .
     1183         end.
     1184         when 'cagb':U then do:
     1185           assign
     1186             next-seq = next-value(s-cagb-code, ub)
     1187           .
     1188         end.
     1189         when 'fdgb':U then do:
     1190           assign
     1191             next-seq = next-value(s-fin-doc, ub)
     1192           .
     1193         end.
     1194       end case.
     1195     end.
     1196   end procedure.
     1197   procedure set-seq-cr :
     1198     define input parameter type-code like ub.code-range.range-type no-undo .
     1199     define input parameter set-val   like ub.code-range.first-code no-undo .
     1200     do
     1201     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1202     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
     1203     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
     1204     :
     1205       case type-code:
     1206         when 'bcgb':U then do:
     1207           assign
     1208             current-value(s-bcgb-code, ub) = set-val
     1209           .
     1210         end.
     1211         when 'scgb':U then do:
     1212           assign
     1213             current-value(s-scgb-code, ub) = set-val
     1214           .
     1215         end.
     1216         when 'sclc':U then do:
     1217           assign
     1218             current-value(s-sclc-code, ub) = set-val
     1219           .
     1220         end.
     1221         when 'pglc':U then do:
     1222           assign
     1223             current-value(s-pglc-code, ub) = set-val
     1224           .
     1225         end.
     1226         when 'dcgb':U then do:
     1227           assign
     1228             current-value(s-dcgb-code, ub) = set-val
     1229           .
     1230         end.
     1231         when 'ctgb':U then do:
     1232           assign
     1233             current-value(s-ctgb-code, ub) = set-val
     1234           .
     1235         end.
     1236         when 'drgb':U then do:
     1237           assign
     1238             current-value(s-drgb-code, ub) = set-val
     1239           .
     1240         end.
     1241         when 'fmgb':U then do:
     1242           assign
     1243             current-value(s-fmgb-code, ub) = set-val
     1244           .
     1245         end.
     1246         when 'pngb':U then do:
     1247           assign
     1248             current-value(s-pngb-code, ub) = set-val
     1249           .
     1250         end.
     1251         when 'cagb':U then do:
     1252           assign
     1253             current-value(s-cagb-code, ub) = set-val
     1254           .
     1255         end.
     1256         when 'fdgb':U then do:
     1257           assign
     1258             current-value(s-fin-doc, ub) = set-val
     1259           .
     1260         end.
     1261       end case.
     1262     end.
     1263   end procedure.
     1264   procedure new-bcod-gen-code-range :
     1265     do
     1266     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1267     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     1268     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     1269     :
     1270       define input parameter p-db-num  like ub.db.db-num             no-undo .
     1271       define input parameter type-code like ub.code-range.range-type no-undo .
     1272       define buffer buf_code-range      for ub.code-range .
     1273       define buffer last_code-range     for ub.code-range .
     1274       define buffer last-1_code-range   for ub.code-range .
     1275       define buffer last-2_code-range   for ub.code-range .
     1276       define buffer last-3_code-range   for ub.code-range .
     1277       define buffer buf_sys-ctrl        for ub.sys-ctrl .
     1278       define variable conf-par       as character no-undo .
     1279       define variable par-type       as character no-undo .
     1280       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     1281       define variable v-cre-cdrg as logical   no-undo .
     1282       define variable v-cre-str  as character no-undo .
     1283       define variable v-cr1      as integer no-undo .
     1284       define variable v-cr2      as integer no-undo .
     1285       define variable v-cr3      as integer no-undo .
     1286       define variable v-cmax     as integer no-undo .
     1287       find first buf_sys-ctrl no-lock .
     1288       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
     1289         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
     1290                                       ,vss-workfile
     1291                                       ,vss-revision
     1292                                       ,vss-description
     1293                                       ,chr(10)
     1294                                       , p-db-num
     1295                                      ).
     1296       end.
     1297       run trg/getpcode.p ( input  type-code
     1298                      ,output cfg-param-code
     1299                     ).
     1300       for each buf_code-range
     1301         where buf_code-range.db-num     = -1
     1302           and buf_code-range.range-type = type-code
     1303           and buf_code-range.stts       = "f"
     1304       by buf_code-range.first-code
     1305       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1306       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     1307       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     1308       :
     1309         assign
     1310           buf_code-range.db-num = p-db-num
     1311         .
     1312         return .
     1313       end.
     1314       assign
     1315         v-cre-cdrg = TRUE
     1316       .
     1317       case type-code:
     1318         when 'sclc':U
     1319         or when 'scgb':U
     1320         or when 'pglc':U
     1321         then do:
     1322           find last last-1_code-range no-lock
     1323             where last-1_code-range.range-type = 'sclc':U
     1324             no-error .
     1325           if available last-1_code-range then do:
     1326             v-cr1 = last-1_code-range.last-code.
     1327           end.
     1328           find last last-2_code-range no-lock
     1329             where last-2_code-range.range-type = 'scgb':U
     1330             no-error .
     1331           if available last-2_code-range then do:
     1332             v-cr2 = last-2_code-range.last-code.
     1333             end.
     1334           find last last-3_code-range no-lock
     1335             where last-3_code-range.range-type = 'pglc':U
     1336             no-error .
     1337           if available last-3_code-range then do:
     1338             v-cr3 = last-3_code-range.last-code.
     1339           end.
     1340           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     1341           .
     1342           if v-cmax = v-cr1  then do:
     1343               find last last_code-range no-lock
     1344                 where recid( last_code-range ) = recid( last-1_code-range )
     1345                 .
     1346             end.
     1347           if v-cmax = v-cr2  then do:
     1348               find last last_code-range no-lock
     1349                 where recid( last_code-range ) = recid( last-2_code-range )
     1350                 .
     1351             end.
     1352           if v-cmax = v-cr3  then do:
     1353             find last last_code-range no-lock
     1354               where recid( last_code-range ) = recid( last-3_code-range )
     1355               .
     1356           end.
     1357           if last_code-range.last-code + 1 > 99999 then do:
     1358             assign
     1359               v-cre-cdrg = FALSE
     1360             .
     1361           end.
     1362         end.
     1363         when 'bcgb':U
     1364         or when 'sslc':U
     1365         or when 'ssgb':U
     1366         then do:
     1367           find last last-1_code-range no-lock
     1368             where last-1_code-range.range-type = 'sslc':U
     1369             no-error .
     1370           if available last-1_code-range then do:
     1371             v-cr1 = last-1_code-range.last-code.
     1372           end.
     1373           find last last-2_code-range no-lock
     1374             where last-2_code-range.range-type = 'bcgb':U
     1375             no-error .
     1376           if available last-2_code-range then do:
     1377             v-cr2 = last-2_code-range.last-code.
     1378             end.
     1379           find last last-3_code-range no-lock
     1380             where last-3_code-range.range-type = 'ssgb':U
     1381             no-error .
     1382           if available last-3_code-range then do:
     1383             v-cr3 = last-3_code-range.last-code.
     1384           end.
     1385           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     1386           .
     1387           if v-cmax = v-cr1  then do:
     1388               find last last_code-range no-lock
     1389                 where recid( last_code-range ) = recid( last-1_code-range )
     1390                 .
     1391             end.
     1392           if v-cmax = v-cr2  then do:
     1393               find last last_code-range no-lock
     1394                 where recid( last_code-range ) = recid( last-2_code-range )
     1395                 .
     1396             end.
     1397           if v-cmax = v-cr3  then do:
     1398             find last last_code-range no-lock
     1399               where recid( last_code-range ) = recid( last-3_code-range )
     1400               .
     1401           end.
     1402         end.
     1403         otherwise do:
     1404           find last last_code-range no-lock
     1405             where last_code-range.range-type = type-code
     1406             no-error .
     1407         end.
     1408       end case.
     1409       if not available last_code-range then do:
     1410         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
     1411                                       ,vss-workfile
     1412                                       ,vss-revision
     1413                                       ,vss-description
     1414                                       , chr(10)
     1415                                       , type-code
     1416                                      ) .
     1417       end.
     1418       define variable v-mes9 as character no-undo .
     1419       define variable v-param-type9 as character no-undo .
     1420       define variable v-value-character9 as INTEGER no-undo .
     1421       define variable v-value-date9 as date no-undo .
     1422       define variable v-value-decimal9 as decimal no-undo .
     1423       define variable v-value-integer9 AS integer no-undo .
     1424       define variable v-value-logical9 AS LOGICAL no-undo .
     1425       define variable v-tth9 as handle no-undo .
     1426       run adm/shattri.p (
     1427           input "get":U
     1428           ,input  'БД':U
     1429           ,input  p-db-num
     1430           ,input  'code-range':U
     1431           ,input  cfg-param-code
     1432           ,output v-value-character9
     1433           ,output v-value-date9
     1434           ,output v-value-decimal9
     1435           ,output v-value-integer9
     1436           ,output v-value-logical9
     1437           ,output v-param-type9
     1438           ,INPUT-OUTPUT table-handle v-tth9
     1439           ) no-error .
     1440       if error-status :error then do:
     1441         delete object v-tth9.
     1442         v-mes9 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
     1443                            , error-status:get-message(1)
     1444                            , chr(10)
     1445                            , return-value ).
     1446         undo, return error v-mes9.
     1447       end.
     1448       delete object v-tth9.
     1449       if v-cre-cdrg = TRUE then do:
     1450         create buf_code-range .
     1451         assign
     1452           buf_code-range.db-num     = p-db-num
     1453           buf_code-range.range-type = type-code
     1454           buf_code-range.stts       = "f"
     1455           buf_code-range.first-code = last_code-range.last-code + 1
     1456           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer9)
     1457           v-cre-str = "Свободный диапазон успешно создан"
     1458         .
     1459       end.
     1460       else do:
     1461         assign
     1462           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
     1463                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
     1464         .
     1465       end.
     1466     end.
     1467     return v-cre-str .
     1468   end procedure.
     1469   procedure gen-new-code-range-if-neces :
     1470     define input parameter v-db-num           like ub.db.db-num             no-undo .
     1471     define input parameter v-range-type       like ub.code-range.range-type no-undo .
     1472     define input parameter v-cur-code         as   integer                  no-undo .
     1473     define input parameter v-g#news           as   logical                  no-undo .
     1474     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
     1475     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
     1476     do
     1477     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1478     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
     1479     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
     1480     :
     1481       define variable l-code-range-exist as logical   no-undo init false .
     1482       define variable v-db-for-send      as character no-undo .
     1483       define buffer buf_code-range  for ub.code-range .
     1484       define buffer buf1_code-range for ub.code-range .
     1485       define buffer buf_db          for ub.db .
     1486       find first buf_code-range
     1487         where buf_code-range.range-type = v-range-type
     1488           and buf_code-range.last-code >= v-cur-code
     1489         use-index last-codei
     1490         no-error .
     1491       if
     1492       (
     1493          available buf_code-range
     1494          and
     1495         (buf_code-range.db-num = v-db-num
     1496           and
     1497         buf_code-range.first-code <= v-cur-code
     1498         )
     1499       or
     1500         (
     1501           v-range-type = 'drgb':U
     1502           AND
     1503           v-cur-code = 0
     1504         )
     1505      )
     1506      then do:
     1507         assign
     1508           l-code-range-exist = true
     1509         .
     1510         if v-g#news
     1511         and buf_code-range.stts = "f" then do:
     1512           assign
     1513             buf_code-range.stts = "u"
     1514           .
     1515         end.
     1516       end.
     1517       if not l-code-range-exist
     1518          and v-g#news-source-db <> 0
     1519       then do:
     1520         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
     1521                                       ,vss-workfile
     1522                                       ,vss-revision
     1523                                       ,vss-description
     1524                                       ,chr(10)
     1525                                       ,v-db-num
     1526                                       ,v-range-type
     1527                                       ,v-cur-code
     1528                                      ).
     1529       end.
     1530       if (not l-code-range-exist
     1531           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
     1532          )
     1533       and ( not can-find (first buf1_code-range no-lock
     1534                           where buf1_code-range.db-num = v-db-num
     1535                             and buf1_code-range.range-type = v-range-type
     1536                             and buf1_code-range.stts = "f"
     1537                          )
     1538           )
     1539       then do:
     1540         if v-g#db-num = 0 then do:
     1541           run new-bcod-gen-code-range in this-procedure
     1542             (input v-db-num,
     1543              input v-range-type
     1544             ) no-error .
     1545           if error-status :error then do:
     1546             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
     1547                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
     1548                                           ,v-db-num
     1549                                           ,v-range-type
     1550                                           ,v-cur-code
     1551                                           ,chr(10)
     1552                                           ,error-status:get-message(1)
     1553                                           ,return-value
     1554                                          ).
     1555           end.
     1556         end.
     1557         else do:
     1558           if v-range-type = 'sclc':U
     1559           or v-range-type = 'pglc':U
     1560           then do:
     1561             assign
     1562               v-db-for-send = "":U
     1563             .
     1564             if v-g#db-num = 0 then do:
     1565               for each buf_db no-lock
     1566                 where buf_db.db-num > 0
     1567                   and buf_db.db-num <> v-g#news-source-db
     1568               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1569               :
     1570                 assign
     1571                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
     1572                 .
     1573               end.
     1574               assign
     1575                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     1576               .
     1577             end.
     1578             else do:
     1579               if not v-g#news then do:
     1580                 assign
     1581                   v-db-for-send = "0":U
     1582                 .
     1583               end.
     1584             end.
     1585             run nws/cr-route.p ( input 'send-cmd':U
     1586                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     1587                                  "code-range":U + chr(1) +
     1588                                  (if v-range-type = 'sclc':U
     1589                                   then string( current-value(s-sclc-code, ub))
     1590                                   else string( current-value(s-pglc-code, ub))
     1591                                   ) + chr(1) +
     1592                                   v-range-type)
     1593                           ,input ?
     1594                           ,input v-db-for-send
     1595                           ) no-error .
     1596             if error-status :error then do:
     1597               undo, return error return-value.
     1598             end.
     1599           end.
     1600         end.
     1601       end.
     1602     end.
     1603   end procedure.
     1604   procedure cre-loc-sc-code-range :
     1605     define input parameter v-cur-code as integer no-undo .
     1606   define input parameter p-cdrg-type as character no-undo .
     1607     do
     1608     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1609     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     1610     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     1611     :
     1612       define buffer buf_code-range for ub.code-range .
     1613       find first buf_code-range
     1614            where buf_code-range.range-type = p-cdrg-type
     1615              and buf_code-range.first-code >= v-cur-code
     1616            no-error .
     1617       if not available buf_code-range then do:
     1618         run new-bcod-gen-code-range in this-procedure
     1619           ( input 0,
     1620             input p-cdrg-type
     1621           ) no-error .
     1622         if error-status :error then do:
     1623           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     1624                                          + "Код &2&1&3 &4"
     1625                                         , chr(10)
     1626                                         , v-cur-code
     1627                                         , error-status:get-message(1)
     1628                                         , return-value
     1629                                        ) .
     1630         end.
     1631       end.
     1632     end.
     1633   end procedure.
     1634   procedure mark-used-if-need :
     1635   define input parameter p-cur-code as integer no-undo .
     1636   define input parameter p-range-type like ub.code-range.range-type no-undo .
     1637   define input parameter p-db-num like ub.code-range.db-num no-undo .
     1638     do
     1639     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1640     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     1641     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     1642     :
     1643       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     1644       define buffer buf_code-range for ub.code-range .
     1645       assign
     1646       v-db-num = if p-range-type = 'sclc':U
     1647                  then 0
     1648                  else p-db-num
     1649       .
     1650   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1651   define buffer locK-batchprocess10 for ub.batchprocess.
     1652   run gbl/lock-prc.p
     1653       (input 'lscc':U
     1654       ,input 0
     1655       ,input 0
     1656       ,input 0
     1657       ,input ""
     1658       ,input ""
     1659       ,input ""
     1660       ,input (
     1661               ",,,Вкл/выкл лок. вес. кодов"
     1662              )
     1663       ,input true
     1664       ,buffer lock-batchprocess10
     1665       ) no-error .
     1666     if error-status :error then do:
     1667       message
     1668         vss-workfile vss-revision vss-description skip
     1669         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     1670         view-as alert-box error .
     1671       undo, return error .
     1672     end.
     1673       find first buf_code-range
     1674            where buf_code-range.range-type = p-range-type
     1675              and buf_code-range.first-code >= p-cur-code
     1676              and buf_code-range.last-code <= p-cur-code
     1677              and buf_code-range.db-num = v-db-num
     1678            no-error .
     1679       if not available buf_code-range then do:
     1680         message
     1681           vss-workfile vss-revision vss-description skip
     1682           "Ошибка при создании поиске диапазона" skip
     1683           "База данных" p-db-num skip
     1684           "Код" p-cur-code skip
     1685           "Тип" p-range-type
     1686           error-status :get-message(1) skip
     1687           return-value skip
     1688           view-as alert-box error .
     1689         undo, return error .
     1690       end.
     1691       if buf_code-range.stts = "f":U then do:
     1692         assign
     1693         buf_code-range.stts = "u":U
     1694         .
     1695       end.
     1696     end.
     1697   end procedure.
     1698   FUNCTION cbnki-period-to-String returns character(input  p-date1 as date, input p-date2 as date):
     1699   define variable v-date-str as character no-undo .
     1700   assign
     1701   v-date-str = string(YEAR(p-date1), "9999":U) + chr(47) +
     1702                string(Month(p-date1), "99":U) + chr(47) +
     1703                string(DAY(p-date1), "99":U) + '-':U +
     1704                string(YEAR(p-date2), "9999":U) + chr(47) +
     1705                string(Month(p-date2), "99":U) + chr(47) +
     1706                string(DAY(p-date2), "99":U).
     1707   return v-date-str.
     1708   END FUNCTION.
     1709   define variable log-file-name as character no-undo init "ext-cbnk.log".
     1710   define variable sss as character no-undo .
     1711   define variable var-file-line-num as integer no-undo .
     1712   define variable ii as integer no-undo .
     1713   define variable n-entry as character no-undo extent 2.
     1714   define variable v-count as integer no-undo .
     1715   define variable gbl-type as character no-undo .
     1716   define variable gbl-schet as character no-undo .
     1717   DEFINE VARIABLE accept-types               as   character no-undo init "Платежное поручение".
     1718   define variable exist as logical no-undo init yes.
     1719   define variable exist-statement as logical no-undo init yes.
     1720   define variable in-doc as integer no-undo .
     1721   define variable in-statement as integer no-undo .
     1722   define variable v-version-TH as character no-undo .
     1723   define variable v-exchange-file as logical no-undo .
     1724   define variable v-crit-err   as logical no-undo .
     1725   define variable v-seq as integer no-undo .
     1726   define variable v-seq-statement as integer no-undo .
     1727   define variable v-bank-date-chr as character no-undo .
     1728   define stream PrnLibStream.
     1729   define temp-table tt-1s-fin-doc no-undo like ub.fin-doc
     1730   field fin-doc-code-th as integer
     1731   .
     1732   define temp-table tt-th-fin-doc no-undo like ub.fin-doc.
     1733   define temp-table tt-1s-fin-statement no-undo like ub.fin-statement.
     1734   define temp-table tt-th-fin-statement no-undo like ub.fin-statement.
     1735   DEFINE TEMP-TABLE tt0-fin-doc-attr NO-UNDO LIKE ub.fin-doc-attr.
     1736   DEFINE TEMP-TABLE tt0-fin-doc-tax NO-UNDO LIKE ub.fin-doc-tax.
     1737   DEFINE TEMP-TABLE tt0-payment NO-UNDO LIKE ub.payment.
     1738   do
     1739   on error undo, return error
     1740   :
     1741     for each tt-1s-fin-doc:
     1742       delete tt-1s-fin-doc.
     1743     end.
     1744     for each tt-th-fin-doc:
     1745       delete tt-th-fin-doc.
     1746     end.
     1747     if p-encoding = 'WIndows-1251' then do:
     1748       input stream PRnLibStream from value( p-file-name ).
     1749     end.
     1750     else do:
     1751       input stream PRnLibStream from value( p-file-name ) convert source p-encoding.
     1752     end.
     1753                   run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("&3Чтение файла импорта &1 Отправитель &2&3" +                               "Банк с БИК &4"                                                            ,  p-file-name                                                             , p-adresat                                                                , chr(10)                                                            , p-bik   )).
     1754     _repeat:
     1755     REPEAT :
     1756     _line:
     1757     DO TRANSACTION:
     1758       import stream PrnLibStream unformatted sss.
     1759       assign
     1760       var-file-line-num = var-file-line-num + 1
     1761       .
     1762       if var-file-line-num modulo 50 = 0 then do:
     1763         run show-counter in p-log-handle .
     1764         run write-counter in p-log-handle (substitute("Файл &1: прочитано строк &2", p-file-name, var-file-line-num)).
     1765       end.
     1766       if sss = "" or sss = ? then do:
     1767           assign
     1768           n-entry[1] = ""
     1769           n-entry[2] = ""
     1770           .
     1771           leave _line.
     1772       end.
     1773       assign
     1774       n-entry[1] = entry(1, sss, "=")
     1775       n-entry[2] = (if num-entries(sss, '=':U) > 1
     1776                     then substring(sss, length(n-entry[1]) + 2)
     1777                     else '':U)
     1778       .
     1779     END.
     1780     DO TRANSACTION :
     1781       if n-entry[2] = 'Windows'
     1782       or n-entry[2] = 'DOS' then do:
     1783         if (n-entry[2] = 'Windows'
     1784         and p-encoding <> 'WIndows-1251'
     1785         )
     1786         or (n-entry[2] = 'DOS'
     1787         and p-encoding <> 'ibm866') then do:
     1788             input stream PrnLibStream close.
     1789             p-view-log = yes.
     1790             run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Неверно выбрана кодировка: выбрана &1,&2а в импортируемом файле &3&2Файл &4"                          , (if p-encoding = 'Windows-1251' then 'Windows' else 'DOS')                                                 , chr(10)                                                                                              , n-entry[2]                                                                                                 , p-file-name                                             )).
     1791             return.
     1792         end.
     1793       end.
     1794       CASE n-entry[1]:
     1795         when '1CClientBankExchange' then do:
     1796           assign
     1797           v-exchange-file = yes
     1798           .
     1799         end.
     1800         when 'КонецФайла' then do:
     1801           if in-doc > 0 then do:
     1802             assign
     1803             v-crit-err = yes
     1804             p-view-log = yes.
     1805                   run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Метка <КонецФайла> в середине секции документа:&1Импорт прерван&1"                              , chr(10)                                                                                          )).
     1806             return.
     1807           end.
     1808         end.
     1809         when ''
     1810         or
     1811         when 'КонецДокумента'
     1812         then do:
     1813           run proc-end-doc in this-procedure no-error .
     1814           if error-status:error  then do:
     1815             v-crit-err = yes.
     1816             if (return-value = '':U or
     1817             return-value = 'error')
     1818             then do:
     1819               input stream PrnLibStream close.
     1820               p-view-log = yes.
     1821                   run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Ошибки при чтении файла:&1&2 &3&1Импорт прерван&1"                              , chr(10)                                                                                                  , error-status:get-message(1)                                                                                    , return-value                                   )).
     1822               return.
     1823             end.
     1824             else do:
     1825               p-view-log = yes.
     1826                   run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input return-value).
     1827             end.
     1828           end.
     1829           if return-value = 'error' then do:
     1830             input stream PrnLibStream close.
     1831             return.
     1832           end.
     1833         end.
     1834         when 'ДатаСоздания' then do:
     1835           assign
     1836           v-bank-date-chr = n-entry[2]
     1837           .
     1838         end.
     1839         when 'Получатель' then do:
     1840           if in-doc = 0 then do:
     1841             run gbl/getvers.p (output v-version-TH).
     1842             v-version-TH = substitute('IBS TH &1', v-version-TH).
     1843             if n-entry[2] <> v-version-TH then do:
     1844               input stream PrnLibStream close.
     1845                 p-view-log = yes.
     1846                   run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Неверный получатель: &1&2, ожидалось &3&2Файл &4"                              , n-entry[2]                                                     , chr(10)                                                                                                  , v-version-TH                                                                                                     , p-file-name                                             )).
     1847                 return.
     1848             end.
     1849           end.
     1850         end.
     1851         when 'Отправитель' then do:
     1852           if n-entry[2] <> p-adresat then do:
     1853             input stream PrnLibStream close.
     1854               p-view-log = yes.
     1855               run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Неверный отправитель: &1&2, ожидалось &3&2Файл &4"                            , n-entry[2]                                                   , chr(10)                                                                                                , p-adresat                                                                                                    , p-file-name                                             )).
     1856               return.
     1857           end.
     1858         end.
     1859         when 'ВерсияФормата' then do:
     1860           if n-entry[2] <> '1.01' then do:
     1861              input stream PrnLibStream close.
     1862               p-view-log = yes.
     1863               run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Неверная версия формата: &1&2, ожидалось &3&2Файл &4"                            , n-entry[2]                                                   , chr(10)                                                                                                , '1.01'                                                                                        , p-file-name                                             )).
     1864               return.
     1865           end.
     1866         end.
     1867         when 'СекцияДокумент' then  do:
     1868           if not v-exchange-file then do:
     1869              input stream PrnLibStream close.
     1870               p-view-log = yes.
     1871               run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input "!!!Отсутствует признак файла обмена (1CClientBankExchange)").
     1872               return.
     1873           end.
     1874           run proc-end-gen in this-procedure no-error .
     1875           if error-status:error  then do:
     1876             v-crit-err = yes.
     1877             if (return-value = '':U or
     1878             return-value = 'error')
     1879             then do:
     1880               input stream PrnLibStream close.
     1881               p-view-log = yes.
     1882                   run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Ошибки при чтении файла:&1&2 &3&1Импорт прерван&1"                              , chr(10)                                                                                                  , error-status:get-message(1)                                                                                    , return-value                                   )).
     1883               return.
     1884             end.
     1885             else do:
     1886               p-view-log = yes.
     1887                   run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input return-value).
     1888             end.
     1889           end.
     1890           if return-value = 'error' then do:
     1891             input stream PrnLibStream close.
     1892             return.
     1893           end.
     1894           run proc-00-doc in this-procedure no-error .
     1895           if return-value = 'error' then do:
     1896             input stream PrnLibStream close.
     1897             return.
     1898           end.
     1899         end.
     1900         when 'РасчСчет' then  do:
     1901           assign
     1902           gbl-schet = n-entry[2].
     1903         end.
     1904         when 'СекцияРасчСчет' then  do:
     1905           if not v-exchange-file then do:
     1906              input stream PrnLibStream close.
     1907               p-view-log = yes.
     1908               run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input "!!!Отсутствует признак файла обмена (1CClientBankExchange)").
     1909               return.
     1910           end.
     1911           run proc-end-gen in this-procedure no-error .
     1912           if error-status:error  then do:
     1913             v-crit-err = yes.
     1914             if (return-value = '':U or
     1915             return-value = 'error')
     1916             then do:
     1917               input stream PrnLibStream close.
     1918               p-view-log = yes.
     1919                   run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Ошибки при чтении файла:&1&2 &3&1Импорт прерван&1"                              , chr(10)                                                                                                  , error-status:get-message(1)                                                                                    , return-value                                   )).
     1920               return.
     1921             end.
     1922             else do:
     1923               p-view-log = yes.
     1924                   run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input return-value).
     1925             end.
     1926           end.
     1927           if return-value = 'error' then do:
     1928             input stream PrnLibStream close.
     1929             return.
     1930           end.
     1931           run proc-00-statement in this-procedure no-error .
     1932           if return-value = 'error' then do:
     1933             input stream PrnLibStream close.
     1934             return.
     1935           end.
     1936         end.
     1937         when 'КонецРасчСчет' then  do:
     1938           run proc-end-statement in this-procedure no-error .
     1939           if error-status:error  then do:
     1940             v-crit-err = yes.
     1941             if (return-value = '':U or
     1942             return-value = 'error')
     1943             then do:
     1944               input stream PrnLibStream close.
     1945               p-view-log = yes.
     1946                   run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Ошибки при чтении файла:&1&2 &3&1Импорт прерван&1"                              , chr(10)                                                                                                  , error-status:get-message(1)                                                                                    , return-value                                   )).
     1947               return.
     1948             end.
     1949             else do:
     1950               p-view-log = yes.
     1951                   run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input return-value).
     1952             end.
     1953           end.
     1954           if return-value = 'error' then do:
     1955             input stream PrnLibStream close.
     1956             return.
     1957           end.
     1958         end.
     1959         otherwise do:
     1960           find first temp_hfields where
     1961                       temp_hfields.label_ = (n-entry[1] + '=':U) no-error.
     1962             if available temp_hfields then do:
     1963               if (not exist and temp_hfields.subject = 'fin-doc':U)
     1964               or (not exist-statement and temp_hfields.subject = 'fin-statement':U)
     1965               then do:
     1966                 if in-doc > 0
     1967                 and in-statement = 0
     1968                 then do:
     1969                   assign
     1970                   TEMP_hfields.value_ = n-entry[2]
     1971                   temp_hfields.readed = yes
     1972                   .
     1973                 end.
     1974                 if in-statement > 0
     1975                 and in-doc = 0
     1976                 then do:
     1977                   assign
     1978                   TEMP_hfields.value_ = n-entry[2]
     1979                   temp_hfields.readed = yes
     1980                   .
     1981                 end.
     1982                 if in-doc = 0
     1983                 and in-statement = 0 then do:
     1984                   assign
     1985                   in-doc = 0
     1986                   in-statement = 0
     1987                   exist = yes
     1988                   exist-statement = yes
     1989                   p-view-log = yes.
     1990                   run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Поле &1 вне секции документа или секции выписки пл счету&2Файл &3 строка &4"                            , temp_hfields.label_                                                               , chr(10)                                                                     , p-file-name                                                                       , var-file-line-num                     )).
     1991                   input stream PrnLibStream close.
     1992                   return.
     1993                 end.
     1994               end.
     1995             end.
     1996             else do:
     1997               if in-doc > 0 then do:
     1998                 p-view-log = yes.
     1999                   run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Неизвестное поле <&1> при импорте документа&2Файл &3"                              , n-entry[1]                                                                          , chr(10)                                                                       , p-file-name                                                                         , var-file-line-num)).
     2000               end.
     2001               if in-statement > 0 then do:
     2002                 p-view-log = yes.
     2003                   run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Неизвестное поле <&1> при импорте выписки&2Файл &3"                              , n-entry[1]                                                                          , chr(10)                                                                       , p-file-name                                                                         , var-file-line-num)).
     2004               end.
     2005             end.
     2006           end.
     2007         END CASE .
     2008       END.
     2009     END .
     2010     DO TRANSACTION:
     2011       run proc-end-gen in this-procedure no-error .
     2012       if error-status:error  then do:
     2013         v-crit-err = yes.
     2014         if (return-value = '':U or
     2015         return-value = 'error')
     2016         then do:
     2017           input stream PrnLibStream close.
     2018           p-view-log = yes.
     2019             run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Ошибки при чтении файла:&1&2 &3&1Импорт прерван&1"                          , chr(10)                                                                                              , error-status:get-message(1)                                                                                , return-value                                   )).
     2020           return.
     2021         end.
     2022         else do:
     2023           p-view-log = yes.
     2024             run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input return-value).
     2025         end.
     2026       end.
     2027       if return-value = 'error' then do:
     2028         input stream PrnLibStream close.
     2029         return.
     2030       end.
     2031     END.
     2032     assign
     2033     error-status:error = false.
     2034     input stream PrnLibStream close.
     2035   end.
     2036   run show-counter in p-log-handle .
     2037   run write-counter in p-log-handle ('':U).
     2038   if not v-crit-err then do:
     2039     run proc-write-out in this-procedure no-error.
     2040     if error-status:error then do:
     2041       run hide-counter in p-log-handle.
     2042                 p-view-log = yes.
     2043                   run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Ошибка при обработке импортируемых документов&1&2 &3&1&4&1"                              , chr(10)                                                                       , error-status:get-message(1)                                                         , return-value                                                                        , 'все импортированные изменения НЕ будут сохранены'               )).
     2044       assign
     2045       p-processed = 0
     2046       p-created = 0
     2047       .
     2048     end.
     2049   end.
     2050   procedure proc-00-doc:
     2051     do
     2052     on error undo, return error
     2053     :
     2054       assign
     2055       gbl-type = n-entry[2]
     2056       p-count = p-count + 1
     2057       .
     2058       if can-do(accept-types,  gbl-type ) then do:
     2059         for each temp_hfields where temp_hfields.subject = 'fin-doc':U:
     2060           assign
     2061           temp_hfields.value_ = ?
     2062           temp_hfields.imported = no
     2063           temp_hfields.readed = no
     2064           .
     2065         end.
     2066         find first temp_hfields where
     2067                   temp_hfields.subject = 'fin-doc':U
     2068               and temp_hfields.label_ = (n-entry[1] + '=':U).
     2069         assign
     2070         TEMP_hfields.value_ = n-entry[2]
     2071         TEMP_hfields.readed = yes
     2072         .
     2073         assign
     2074         in-doc = var-file-line-num
     2075         exist = no
     2076         .
     2077       end.
     2078       else do:
     2079         assign
     2080         exist = yes
     2081         .
     2082         return.
     2083       end.
     2084     end.
     2085   end procedure.
     2086   procedure proc-00-statement:
     2087   define variable gbl-r-schet as character no-undo .
     2088     do
     2089     on error undo, return error
     2090     :
     2091       assign
     2092       gbl-r-schet = n-entry[2]
     2093       p-count-statement = p-count-statement + 1
     2094       .
     2095       if p-rs-hsch = 2 then do:
     2096         find first temp_hfin-schet no-lock where
     2097                 temp_hfin-schet.host-code = p-host-code
     2098             AND temp_hfin-schet.r-schet = gbl-r-schet no-error .
     2099         if not available temp_hfin-schet then do:
     2100           assign
     2101           exist-statement = yes.
     2102           return.
     2103         end.
     2104       end.
     2105       else do :
     2106         for each temp_hfields where temp_hfields.subject = 'fin-statement':U:
     2107           assign
     2108           temp_hfields.value_ = ?
     2109           temp_hfields.imported = no
     2110           temp_hfields.readed = no
     2111           .
     2112         end.
     2113         find first temp_hfields where
     2114                   temp_hfields.subject = 'fin-statement':U
     2115               and temp_hfields.label_ = ('РасчСчет' + '=':U)  .
     2116         assign
     2117         TEMP_hfields.value_ = gbl-schet
     2118         TEMP_hfields.readed = yes
     2119         .
     2120         find first temp_hfields where
     2121                   temp_hfields.subject = 'fin-statement':U
     2122               and temp_hfields.label_ = ('ДатаСоздания' + '=':U) .
     2123         assign
     2124         TEMP_hfields.value_ = v-bank-date-chr
     2125         TEMP_hfields.readed = yes
     2126         .
     2127         find first temp_hfields where
     2128                   temp_hfields.subject = 'fin-statement':U
     2129               and temp_hfields.label_ = (n-entry[1] + '=':U).
     2130         assign
     2131         TEMP_hfields.value_ = n-entry[2]
     2132         TEMP_hfields.readed = yes
     2133         .
     2134         assign
     2135         in-statement = var-file-line-num
     2136         exist-statement = no
     2137         .
     2138       end.
     2139     end.
     2140   end procedure.
     2141   procedure proc-end-gen :
     2142     do
     2143     on error undo, return error
     2144     :
     2145       if in-doc > 0 then do:
     2146         run proc-end-doc in this-procedure .
     2147       end.
     2148       if in-statement > 0 then do:
     2149         run proc-end-statement in this-procedure .
     2150       end.
     2151     end.
     2152   end procedure.
     2153   procedure proc-end-doc :
     2154   define variable h-buffer as handle no-undo .
     2155   define variable h-field as handle no-undo .
     2156   define variable ii as integer no-undo .
     2157   define variable v-dop as character no-undo .
     2158   define variable v-dop2 as character no-undo .
     2159   define variable v-inn as integer no-undo .
     2160   define variable v-skip as logical no-undo .
     2161   define variable v-mess as character no-undo .
     2162   define buffer buf_fin-schet for ub.fin-schet.
     2163   define buffer buf_sysconf for ub.sysconf.
     2164   define buffer buf_fin-bank for ub.fin-bank.
     2165   define buffer buf_temp_hfields for temp_hfields.
     2166   define buffer find_first-fin-bank for ub.fin-bank.
     2167   define buffer receiver-firm for ub.firm.
     2168   define buffer receiver-person for ub.person.
     2169   define buffer payer-firm for ub.firm.
     2170   define buffer payer-person for ub.person.
     2171     _main:
     2172     do
     2173     on error undo _main, return error
     2174     :
     2175       if in-doc = 0 or exist then return.
     2176       assign
     2177       in-doc = 0
     2178       exist  = yes
     2179       .
     2180       find first temp_hfields no-lock where
     2181                 temp_hfields.subject = 'fin-doc':U
     2182             and temp_Hfields.name_ = 'fact-date'
     2183             AND temp_Hfields.readed = yes
     2184                 no-error.
     2185       if not available temp_hfields then do:
     2186                     run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Отсутствует обязательный реквизит платежа <ДатаСписано>(<ДатаПоступило>)&1Файл &2 строка НАЧАЛА ДОКУМЕНТА &3"                             , chr(10)                                                                      , p-file-name                                                                        , var-file-line-num                                        )).
     2187              p-view-log = yes.
     2188              assign
     2189              in-doc = 0
     2190              exist = yes.
     2191              return "error".
     2192        end.
     2193        create tt-1s-fin-doc.
     2194        assign
     2195        tt-1s-fin-doc.status_ = 'факт':U.
     2196        assign
     2197        tt-1s-fin-doc.fin-doc-code = - (v-seq + 1)
     2198        v-seq = v-seq + 1
     2199        .
     2200        assign
     2201        h-buffer = buffer tt-1s-fin-doc:handle
     2202        .
     2203        do ii = 1 to h-buffer:num-fields:
     2204          assign
     2205          h-field = h-buffer:buffer-field(ii)
     2206          .
     2207          find first temp_hfields no-lock where
     2208                    temp_hfields.subject = 'fin-doc':U
     2209                and temp_hfields.name_ = h-field:name
     2210                AND temp_hfields.readed = yes  no-error.
     2211          if available temp_hfields then do:
     2212            CASE h-field:data-type:
     2213              when 'date' then do:
     2214                 assign
     2215                 h-field:buffer-value = date(temp_hfields.value_)
     2216                 no-error .
     2217              end.
     2218              when 'integer' then do:
     2219                 assign
     2220                 h-field:buffer-value = integer(temp_hfields.value_)
     2221                 no-error .
     2222              end.
     2223             when 'decimal' then do:
     2224                 assign
     2225                 h-field:buffer-value = decimal(temp_hfields.value_)
     2226                 no-error .
     2227              end.
     2228              when 'logical' then do:
     2229                 assign
     2230                 h-field:buffer-value = logical(temp_hfields.value_)
     2231                 no-error .
     2232              end.
     2233              when 'character' then do:
     2234                assign
     2235                h-field:buffer-value = temp_hfields.value_
     2236                .
     2237              end.
     2238              otherwise do:
     2239                error-status:error = no.
     2240              end.
     2241            END CASE.
     2242            if error-status:error then do:
     2243                     run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Неверное значение поля &1: &5&2Файл &3 строка НАЧАЛА ДОКУМЕНТА &4"                             , temp_hfields.label_                                                                , chr(10)                                                                      , p-file-name                                                                        , var-file-line-num                                                                  , temp_hfields.value_                      )).
     2244              p-view-log = yes.
     2245              delete tt-1s-fin-doc.
     2246              assign
     2247              in-doc = 0
     2248              exist = yes.
     2249              return "error".
     2250            end.
     2251            assign
     2252            temp_Hfields.imported = yes.
     2253         end.
     2254       end.
     2255       for each temp_hfields where
     2256                 temp_hfields.imported = no
     2257             AND temp_hfields.readed = yes
     2258             and temp_hfields.subject = 'fin-doc':U
     2259             :
     2260          CASE temp_hfields.name_ :
     2261           when 'fin-ext-doc-type/' then do:
     2262             CASE temp_hfields.value_ :
     2263               when 'Платежное поручение' then do:
     2264                 for each find_first-fin-bank where
     2265                         find_first-fin-bank.host-code = p-host-code
     2266                     AND find_first-fin-bank.bik       = p-bik
     2267                     AND find_first-fin-bank.status_   = 'тек':U,
     2268                     first buf_fin-schet no-lock where
     2269                           buf_fin-schet.host-code = find_first-fin-bank.host-code
     2270                       and buf_fin-schet.code-bank = find_first-fin-bank.code-bank
     2271                       AND buf_fin-schet.r-schet =  tt-1s-fin-doc.payer-r-schet
     2272                       and buf_fin-schet.status_ = 'тек':U
     2273                       and buf_fin-schet.cli-type = 'орг':U
     2274                       and buf_fin-schet.cli-code = find_first-fin-bank.host-code:
     2275                   LEAVE.
     2276                 end.
     2277                 if available buf_fin-schet then do:
     2278                   assign
     2279                   tt-1s-fin-doc.fin-ext-doc-type = 'рпп':U
     2280                   tt-1s-fin-doc.fin-doc-type = 'рпп':U
     2281                   tt-1s-fin-doc.host-code    = p-host-code
     2282                   tt-1s-fin-doc.payer-type = 'орг':U
     2283                   tt-1s-fin-doc.payer-code = buf_fin-schet.cli-code
     2284                   tt-1s-fin-doc.payer-code-schet = buf_fin-schet.code-schet
     2285                   tt-1s-fin-doc.curr-code = buf_fin-schet.curr-code
     2286                   .
     2287                   find first buf_temp_hfields where buf_temp_hfields.subject = 'fin-doc':U                                                          and buf_temp_hfields.name_ = 'payer-type' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2288                   find first buf_temp_hfields where buf_temp_hfields.subject = 'fin-doc':U                                                          and buf_temp_hfields.name_ = 'payer-code' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2289                   find first buf_temp_hfields where buf_temp_hfields.subject = 'fin-doc':U                                                          and buf_temp_hfields.name_ = 'payer-code-bank' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2290                   find first buf_temp_hfields where buf_temp_hfields.subject = 'fin-doc':U                                                          and buf_temp_hfields.name_ = 'payer-code-schet' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2291                   find first buf_temp_hfields where buf_temp_hfields.subject = 'fin-doc':U                                                          and buf_temp_hfields.name_ = 'curr-code' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2292                   if p-rs-hsch = 2 then do:
     2293                     find first temp_hfin-schet no-lock where
     2294                             temp_hfin-schet.host-code = tt-1s-fin-doc.host-code
     2295                         AND temp_hfin-schet.code-schet = tt-1s-fin-doc.payer-code-schet no-error .
     2296                     if not available temp_hfin-schet then do:
     2297                       assign
     2298                       v-skip = yes.
     2299                     end.
     2300                   end.
     2301                   if not v-skip then do:
     2302                     find first buf_fin-bank no-lock where
     2303                               buf_Fin-bank.host-code = tt-1s-fin-doc.host-code
     2304                           AND buf_Fin-bank.bik = tt-1s-fin-doc.receiver-bik
     2305                           AND buf_Fin-bank.cor-acc = tt-1s-fin-doc.receiver-c-schet
     2306                           and buf_fin-bank.status_ = 'тек':U no-error.
     2307                     if not available buf_fin-bank then do:
     2308                       v-mess = substitute("!!!Не найден в БД (или удален) банк ПОЛУЧАТЕЛЯ&1 - БИК &2&1Коррсчет &3"
     2309                                          , chr(10)
     2310                                          , tt-1s-fin-doc.receiver-bik
     2311                                          , tt-1s-fin-doc.receiver-c-schet
     2312                                          ).
     2313                       undo _main, return error v-mess.
     2314                     end.
     2315                     for each buf_fin-schet no-lock where
     2316                             buf_fin-schet.host-code = tt-1s-fin-doc.host-code
     2317                         AND buf_fin-schet.code-bank =  buf_fin-bank.code-bank
     2318                         AND buf_fin-schet.r-schet =  tt-1s-fin-doc.receiver-r-schet
     2319                         AND buf_fin-schet.status_ = 'тек':U:
     2320                       if buf_fin-schet.cli-type = 'орг':U then do:
     2321                         find first receiver-firm no-lock where
     2322                                 receiver-firm.firm-code = buf_fin-schet.cli-code
     2323                             and receiver-firm.inn = tt-1s-fin-doc.receiver-inn no-error.
     2324                         if available receiver-firm then leave.
     2325                       end.
     2326                       if buf_fin-schet.cli-type = 'чел':U then do:
     2327                         find first receiver-person no-lock where
     2328                                receiver-person.psn-code = buf_fin-schet.cli-code
     2329                             and receiver-person.inn = tt-1s-fin-doc.receiver-inn no-error.
     2330                         if available receiver-person then leave.
     2331                       end.
     2332                     end.
     2333                     if not available buf_fin-schet then do:
     2334                       assign
     2335                       v-mess =  substitute("!!!Не найден в БД (или удален) счет ПОЛУЧАТЕЛЯ&1 банк с БИК &2 (вн код &3),&1р/с &4, ИНН &5 "
     2336                                          , chr(10)
     2337                                          , tt-1s-fin-doc.receiver-bik
     2338                                          , buf_fin-bank.code-bank
     2339                                          , tt-1s-fin-doc.receiver-r-schet
     2340                                          , tt-1s-fin-doc.receiver-inn
     2341                                          ).
     2342                       undo _main, return error v-mess.
     2343                     end.
     2344                     assign
     2345                     tt-1s-fin-doc.receiver-code-schet = buf_fin-schet.code-schet
     2346                     tt-1s-fin-doc.receiver-type = buf_fin-schet.cli-type
     2347                     tt-1s-fin-doc.receiver-code = buf_fin-schet.cli-code
     2348                     .
     2349                   find first buf_temp_hfields where buf_temp_hfields.subject = 'fin-doc':U                                                          and buf_temp_hfields.name_ = 'receiver-code-schet' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2350                   find first buf_temp_hfields where buf_temp_hfields.subject = 'fin-doc':U                                                          and buf_temp_hfields.name_ = 'receiver-code' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2351                   find first buf_temp_hfields where buf_temp_hfields.subject = 'fin-doc':U                                                          and buf_temp_hfields.name_ = 'receiver-type' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2352                   end.
     2353                 end.
     2354                 else do:
     2355                   for each find_first-fin-bank where
     2356                           find_first-fin-bank.host-code = p-host-code
     2357                       AND find_first-fin-bank.bik       = p-bik
     2358                       AND find_first-fin-bank.status_   = 'тек':U,
     2359                       first buf_fin-schet no-lock where
     2360                             buf_fin-schet.host-code = find_first-fin-bank.host-code
     2361                         and buf_fin-schet.code-bank = find_first-fin-bank.code-bank
     2362                         AND buf_fin-schet.r-schet =  tt-1s-fin-doc.receiver-r-schet
     2363                         and buf_fin-schet.status_ = 'тек':U
     2364                         and buf_fin-schet.cli-type = 'орг':U
     2365                         and buf_fin-schet.cli-code = find_first-fin-bank.host-code:
     2366                     LEAVE.
     2367                   end.
     2368                   if available buf_fin-schet then do:
     2369                     assign
     2370                     tt-1s-fin-doc.fin-ext-doc-type = 'ппп':U
     2371                     tt-1s-fin-doc.fin-doc-type = 'ппп':U
     2372                     tt-1s-fin-doc.host-code    = p-host-code
     2373                     tt-1s-fin-doc.receiver-type = 'орг':U
     2374                     tt-1s-fin-doc.receiver-code = buf_fin-schet.cli-code
     2375                     tt-1s-fin-doc.receiver-code-schet = buf_fin-schet.code-schet
     2376                     tt-1s-fin-doc.curr-code = buf_fin-schet.curr-code
     2377                     .
     2378                   find first buf_temp_hfields where buf_temp_hfields.subject = 'fin-doc':U                                                          and buf_temp_hfields.name_ = 'receiver-type' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2379                   find first buf_temp_hfields where buf_temp_hfields.subject = 'fin-doc':U                                                          and buf_temp_hfields.name_ = 'receiver-code' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2380                   find first buf_temp_hfields where buf_temp_hfields.subject = 'fin-doc':U                                                          and buf_temp_hfields.name_ = 'receiver-code-schet' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2381                   find first buf_temp_hfields where buf_temp_hfields.subject = 'fin-doc':U                                                          and buf_temp_hfields.name_ = 'curr-code' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2382                   end.
     2383                   else do:
     2384                     assign
     2385                     v-seq = v-seq + 1
     2386                     v-mess = substitute("!!!Документ &1 фирма &2&3Плательщик &4&3Получатель &5&3"  +
     2387                                 'счета ПЛАТЕЛЬЩИКА И ПОЛУЧАТЕЛЯ отсутствуют в БД'
     2388                               , tt-1s-fin-doc.prn-doc-code
     2389                               , p-host-code
     2390                               , chr(10)
     2391                               , tt-1s-fin-doc.payer-name
     2392                               , tt-1s-fin-doc.receiver-name                                  ).
     2393                     assign
     2394                     v-crit-err = yes.
     2395                     undo _main, return error v-mess.
     2396                   end.
     2397                   if p-rs-hsch = 2 then do:
     2398                     find first temp_hfin-schet no-lock where
     2399                             temp_hfin-schet.host-code = tt-1s-fin-doc.host-code
     2400                         AND temp_hfin-schet.code-schet = tt-1s-fin-doc.receiver-code-schet no-error .
     2401                     if not available temp_hfin-schet then do:
     2402                       assign
     2403                       v-skip = yes.
     2404                     end.
     2405                   end.
     2406                   if not v-skip then do:
     2407                     find first buf_fin-bank no-lock where
     2408                               buf_Fin-bank.host-code = tt-1s-fin-doc.host-code
     2409                           AND buf_Fin-bank.bik = tt-1s-fin-doc.payer-bik
     2410                           AND buf_fin-bank.status_ = 'тек':U
     2411                           AND buf_fin-bank.cor-acc = tt-1s-fin-doc.payer-c-schet  no-error.
     2412                     if not available buf_fin-bank then do:
     2413                       v-mess = substitute("!!!Не найден (или удален) в БД банк ПЛАТЕЛЬЩИКА&1 - БИК &2&1Коррсчет &3"
     2414                                          , chr(10)
     2415                                          , tt-1s-fin-doc.payer-bik
     2416                                          , tt-1s-fin-doc.payer-c-schet
     2417                                          ).
     2418                       undo _main, return error v-mess.
     2419                     end.
     2420                     for each buf_fin-schet no-lock where
     2421                             buf_fin-schet.host-code = tt-1s-fin-doc.host-code
     2422                         AND buf_fin-schet.code-bank =  buf_fin-bank.code-bank
     2423                         AND buf_fin-schet.r-schet =  tt-1s-fin-doc.payer-r-schet
     2424                         AND buf_fin-schet.status_ = 'тек':U :
     2425                       if buf_fin-schet.cli-type = 'орг':U then do:
     2426                         find first payer-firm no-lock where
     2427                                 payer-firm.firm-code = buf_fin-schet.cli-code
     2428                             and payer-firm.inn = tt-1s-fin-doc.payer-inn no-error.
     2429                         if available payer-firm then leave.
     2430                       end.
     2431                       if buf_fin-schet.cli-type = 'чел':U then do:
     2432                         find first payer-person no-lock where
     2433                                payer-person.psn-code = buf_fin-schet.cli-code
     2434                             and payer-person.inn = tt-1s-fin-doc.payer-inn no-error.
     2435                         if available payer-person then leave.
     2436                       end.
     2437                     end.
     2438                     if not available buf_fin-schet then do:
     2439                       assign
     2440                       v-mess =  substitute("!!!Не найден в БД (или удален) счет ПЛАТЕЛЬЩИКА&1 банк с БИК &2 (вн код &3),&1р/с &4, ИНН &5 "
     2441                                          , chr(10)
     2442                                          , tt-1s-fin-doc.payer-bik
     2443                                          , buf_fin-bank.code-bank
     2444                                          , tt-1s-fin-doc.payer-r-schet
     2445                                          , tt-1s-fin-doc.payer-inn
     2446                                          ).
     2447                       undo _main, return error v-mess.
     2448                     end.
     2449                     assign
     2450                     tt-1s-fin-doc.payer-code-schet = buf_fin-schet.code-schet
     2451                     tt-1s-fin-doc.payer-type = buf_fin-schet.cli-type
     2452                     tt-1s-fin-doc.payer-code = buf_fin-schet.cli-code
     2453                     .
     2454                   find first buf_temp_hfields where buf_temp_hfields.subject = 'fin-doc':U                                                          and buf_temp_hfields.name_ = 'payer-code-schet' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2455                   find first buf_temp_hfields where buf_temp_hfields.subject = 'fin-doc':U                                                          and buf_temp_hfields.name_ = 'payer-code' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2456                   find first buf_temp_hfields where buf_temp_hfields.subject = 'fin-doc':U                                                          and buf_temp_hfields.name_ = 'payer-type' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2457                   end.
     2458                 end.
     2459               end.
     2460             END CASE.
     2461             if v-skip = yes then do:
     2462               v-mess = substitute("!!!Документ &1 фирма &2&3Плательщик &4&3Получатель &5&3"  +
     2463                                 'счет ПЛАТЕЛЬЩИКА(ПОЛУЧАТЕЛЯ) НЕ ВЫБРАН для импорта - пропускаем'
     2464                               , tt-1s-fin-doc.prn-doc-code
     2465                               , p-host-code
     2466                               , chr(10)
     2467                               , tt-1s-fin-doc.payer-name
     2468                               , tt-1s-fin-doc.receiver-name                                  ).
     2469                 delete tt-1s-fin-doc.
     2470               return.
     2471             end.
     2472                   find first buf_temp_hfields where buf_temp_hfields.subject = 'fin-doc':U                                                          and buf_temp_hfields.name_ = 'fin-ext-doc-type/' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2473                   find first buf_temp_hfields where buf_temp_hfields.subject = 'fin-doc':U                                                          and buf_temp_hfields.name_ = 'fin-doc-type' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2474                   find first buf_temp_hfields where buf_temp_hfields.subject = 'fin-doc':U                                                          and buf_temp_hfields.name_ = 'host-code' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2475           end.
     2476           when 'payer-inn/payer-name' then do:
     2477             if tt-1s-fin-doc.payer-inn = ? then do:
     2478               assign
     2479               v-inn = index(temp_hfields.value_, ' ИНН ')
     2480               .
     2481               if v-inn = 0 then do:
     2482                 assign
     2483                 v-inn = index(temp_hfields.value_, 'ИНН ')
     2484                 .
     2485               end.
     2486               if v-inn <> 0 then do:
     2487                 assign
     2488                 v-dop = substring(temp_hfields.value_, v-inn + 1).
     2489                 _ii:
     2490                 do ii = 1 to num-entries(v-dop, chr(32) ):
     2491                   v-dop2 = substring(v-dop, length(entry(ii, v-dop, chr(32) ))  + 2).
     2492                   if entry(ii, v-dop, chr(32) ) <> '':U then do:
     2493                     assign
     2494                     tt-1s-fin-doc.payer-inn = entry(ii, v-dop, chr(32) )
     2495                     tt-1s-fin-doc.payer-name = (if tt-1s-fin-doc.payer-name = '':U then trim(v-dop2) else tt-1s-fin-doc.payer-name)
     2496                     .
     2497                     leave _ii.
     2498                   end.
     2499                 end.
     2500               end.
     2501             end.
     2502           end.
     2503           when 'receiver-inn/receiver-name' then do:
     2504             if tt-1s-fin-doc.receiver-inn = ? then do:
     2505               assign
     2506               v-inn = index(temp_hfields.value_, ' ИНН ')
     2507               .
     2508               if v-inn = 0 then do:
     2509                 assign
     2510                 v-inn = index(temp_hfields.value_, 'ИНН ')
     2511                 .
     2512               end.
     2513               if v-inn <> 0 then do:
     2514                 assign
     2515                 v-dop = substring(temp_hfields.value_, v-inn + 1).
     2516                 _ii:
     2517                 do ii = 1 to num-entries(v-dop, chr(32) ):
     2518                   v-dop2 = substring(v-dop, length(entry(ii, v-dop, chr(32) ))  + 2).
     2519                   if entry(ii, v-dop, chr(32) ) <> '':U then do:
     2520                     assign
     2521                     tt-1s-fin-doc.receiver-inn = entry(ii, v-dop, chr(32) )
     2522                     tt-1s-fin-doc.receiver-name = (if tt-1s-fin-doc.receiver-name = '':U then trim(v-dop2) else tt-1s-fin-doc.receiver-name)
     2523                     .
     2524                     leave _ii.
     2525                   end.
     2526                 end.
     2527               end.
     2528             end.
     2529           end.
     2530           when 'naznach-plat/' then do:
     2531             tt-1s-fin-doc.naznach-plat = temp_hfields.value_
     2532             .
     2533                   find first buf_temp_hfields where buf_temp_hfields.subject = 'fin-doc':U                                                          and buf_temp_hfields.name_ = 'naznach-plat/' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2534           end.
     2535           otherwise do:
     2536             error-status:error = no.
     2537           end.
     2538         END CASE.
     2539       end.
     2540       run show-counter in p-log-handle .
     2541       run write-counter in p-log-handle (substitute("Импорт БИК &1 Фирма &2: считано документов &3"
     2542                                       , p-bik
     2543                                       , p-host-code
     2544                                       , p-count)).
     2545       assign
     2546       in-doc = 0
     2547       exist  = yes
     2548       .
     2549     end.
     2550   end procedure.
     2551   procedure proc-end-statement:
     2552   define variable h-buffer as handle no-undo .
     2553   define variable h-field as handle no-undo .
     2554   define variable ii as integer no-undo .
     2555   define variable v-skip as logical no-undo .
     2556   define variable v-mess as character no-undo .
     2557   define buffer buf_fin-schet for ub.fin-schet.
     2558   define buffer buf_clients for ub.clients.
     2559   define buffer buf_fin-bank for ub.fin-bank.
     2560   define buffer buf_temp_hfields for temp_hfields.
     2561   define buffer find_first-fin-bank for ub.fin-bank.
     2562     _main:
     2563     do
     2564     on error undo _main, return error
     2565     :
     2566       if in-statement = 0
     2567       or exist-statement then return.
     2568       assign
     2569       in-statement = 0
     2570       exist-statement  = yes
     2571       .
     2572       find first temp_hfields no-lock where
     2573                 temp_hfields.subject = 'fin-statement':U
     2574             and temp_Hfields.name_ = 'start-date'
     2575             AND temp_Hfields.readed = yes
     2576                 no-error.
     2577       if not available temp_hfields then do:
     2578                     run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Отсутствует обязательный реквизит выписки <ДатаНачала>&1Файл &2 строка НАЧАЛА ВЫПИСКИ &3"                             , chr(10)                                                                      , p-file-name                                                                        , var-file-line-num                                        )).
     2579              p-view-log = yes.
     2580              assign
     2581              in-doc = 0
     2582              exist = yes.
     2583              return "error".
     2584        end.
     2585       find first temp_hfields no-lock where
     2586                 temp_hfields.subject = 'fin-statement':U
     2587             and temp_Hfields.name_ = 'end-date'
     2588             AND temp_Hfields.readed = yes
     2589                 no-error.
     2590       if not available temp_hfields then do:
     2591                     run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Отсутствует обязательный реквизит выписки <ДатаКонца>&1Файл &2 строка НАЧАЛА ВЫПИСКИ &3"                             , chr(10)                                                                      , p-file-name                                                                        , var-file-line-num                                        )).
     2592              p-view-log = yes.
     2593              assign
     2594              in-doc = 0
     2595              exist = yes.
     2596              return "error".
     2597        end.
     2598        create tt-1s-fin-statement.
     2599        assign
     2600        tt-1s-fin-statement.sttm-code = v-seq-statement + 1
     2601        v-seq-statement = v-seq-statement + 1
     2602        .
     2603        assign
     2604        h-buffer = buffer tt-1s-fin-statement:handle
     2605        .
     2606        do ii = 1 to h-buffer:num-fields:
     2607          assign
     2608          h-field = h-buffer:buffer-field(ii)
     2609          .
     2610          find first temp_hfields no-lock where
     2611                    temp_hfields.subject = 'fin-statement':U
     2612                and temp_hfields.name_ = h-field:name
     2613                AND temp_hfields.readed = yes  no-error.
     2614          if available temp_hfields then do:
     2615            CASE h-field:data-type:
     2616              when 'date' then do:
     2617                 assign
     2618                 h-field:buffer-value = date(temp_hfields.value_)
     2619                 no-error .
     2620              end.
     2621              when 'integer' then do:
     2622                 assign
     2623                 h-field:buffer-value = integer(temp_hfields.value_)
     2624                 no-error .
     2625              end.
     2626             when 'decimal' then do:
     2627                 assign
     2628                 h-field:buffer-value = decimal(temp_hfields.value_)
     2629                 no-error .
     2630              end.
     2631              when 'logical' then do:
     2632                 assign
     2633                 h-field:buffer-value = logical(temp_hfields.value_)
     2634                 no-error .
     2635              end.
     2636              when 'character' then do:
     2637                assign
     2638                h-field:buffer-value = temp_hfields.value_
     2639                .
     2640              end.
     2641              otherwise do:
     2642                error-status:error = no.
     2643              end.
     2644            END CASE.
     2645            if error-status:error then do:
     2646                     run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Неверное значение поля &1: &5&2Файл &3 строка НАЧАЛА ВЫПИСКИ &4"                             , temp_hfields.label_                                                                , chr(10)                                                                      , p-file-name                                                                        , var-file-line-num                                                                  , temp_hfields.value_                      )).
     2647              p-view-log = yes.
     2648              delete tt-1s-fin-statement.
     2649              assign
     2650              in-doc = 0
     2651              exist = yes.
     2652              return "error".
     2653            end.
     2654            assign
     2655            temp_Hfields.imported = yes.
     2656         end.
     2657       end.
     2658       for each temp_hfields where
     2659                 temp_hfields.subject = 'fin-statement':U
     2660             and temp_hfields.imported = no
     2661             AND temp_hfields.readed = yes :
     2662          CASE temp_hfields.name_ :
     2663           when 'fins-ext-doc-type/' then do:
     2664             for each find_first-fin-bank where
     2665                     find_first-fin-bank.host-code = p-host-code
     2666                 AND find_first-fin-bank.bik       = p-bik
     2667                 AND find_first-fin-bank.status_   = 'тек':U,
     2668                 first buf_fin-schet no-lock where
     2669                       buf_fin-schet.host-code = find_first-fin-bank.host-code
     2670                   and buf_fin-schet.code-bank = find_first-fin-bank.code-bank
     2671                   AND buf_fin-schet.r-schet =  tt-1s-fin-statement.r-schet
     2672                   and buf_fin-schet.status_ = 'тек':U
     2673                   and buf_fin-schet.cli-type = 'орг':U
     2674                   and buf_fin-schet.cli-code = find_first-fin-bank.host-code:
     2675               LEAVE.
     2676             end.
     2677             if available buf_fin-schet then do:
     2678               find first buf_clients no-lock where
     2679                         buf_clients.obj-type = 'орг':U
     2680                    and  buf_clients.obj-code = p-host-code.
     2681               assign
     2682               tt-1s-fin-statement.fins-ext-doc-type = 'стд':U
     2683               tt-1s-fin-statement.fins-doc-type = 'стд':U
     2684               tt-1s-fin-statement.host-code    = p-host-code
     2685               tt-1s-fin-statement.code-schet = buf_fin-schet.code-schet
     2686               tt-1s-fin-statement.c-schet = buf_fin-schet.c-schet
     2687               tt-1s-fin-statement.cl-bank = '1s':U
     2688               tt-1s-fin-statement.code-bank = buf_fin-schet.code-bank
     2689               tt-1s-fin-statement.curr-code = buf_fin-schet.curr-code
     2690               tt-1s-fin-statement.bank-name = find_first-fin-bank.bank-name
     2691               tt-1s-fin-statement.bank-city = find_first-fin-bank.bank-city
     2692               tt-1s-fin-statement.bik = find_first-fin-bank.bik
     2693               tt-1s-fin-statement.status_ = 'новый':U
     2694               tt-1s-fin-statement.cli-name = buf_clients.obj-name
     2695               .
     2696               find first buf_temp_hfields where  buf_temp_hfields.subject = 'fin-statement':U                                                      and buf_temp_hfields.name_ = 'start-date' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2697               find first buf_temp_hfields where  buf_temp_hfields.subject = 'fin-statement':U                                                      and buf_temp_hfields.name_ = 'end-date' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2698               find first buf_temp_hfields where  buf_temp_hfields.subject = 'fin-statement':U                                                      and buf_temp_hfields.name_ = 'start-sum-doc' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2699               find first buf_temp_hfields where  buf_temp_hfields.subject = 'fin-statement':U                                                      and buf_temp_hfields.name_ = 'end-sum-doc' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2700               find first buf_temp_hfields where  buf_temp_hfields.subject = 'fin-statement':U                                                      and buf_temp_hfields.name_ = 'in-sum-doc' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2701               find first buf_temp_hfields where  buf_temp_hfields.subject = 'fin-statement':U                                                      and buf_temp_hfields.name_ = 'out-sum-doc' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2702               find first buf_temp_hfields where  buf_temp_hfields.subject = 'fin-statement':U                                                      and buf_temp_hfields.name_ = 'r-schet' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2703               find first buf_temp_hfields where  buf_temp_hfields.subject = 'fin-statement':U                                                      and buf_temp_hfields.name_ = 'code-schet' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2704               find first buf_temp_hfields where  buf_temp_hfields.subject = 'fin-statement':U                                                      and buf_temp_hfields.name_ = 'cli-name' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2705               find first buf_temp_hfields where  buf_temp_hfields.subject = 'fin-statement':U                                                      and buf_temp_hfields.name_ = 'bank-name' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2706               find first buf_temp_hfields where  buf_temp_hfields.subject = 'fin-statement':U                                                      and buf_temp_hfields.name_ = 'bank-city' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2707               find first buf_temp_hfields where  buf_temp_hfields.subject = 'fin-statement':U                                                      and buf_temp_hfields.name_ = 'code-bank' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2708               find first buf_temp_hfields where  buf_temp_hfields.subject = 'fin-statement':U                                                      and buf_temp_hfields.name_ = 'cl-bank' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2709               find first buf_temp_hfields where  buf_temp_hfields.subject = 'fin-statement':U                                                      and buf_temp_hfields.name_ = 'bik' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2710               if p-rs-hsch = 2 then do:
     2711                 find first temp_hfin-schet no-lock where
     2712                         temp_hfin-schet.host-code = tt-1s-fin-statement.host-code
     2713                     AND temp_hfin-schet.code-schet = tt-1s-fin-statement.code-schet no-error .
     2714                 if not available temp_hfin-schet then do:
     2715                   assign
     2716                   v-skip = yes.
     2717                 end.
     2718               end.
     2719               if not v-skip then do:
     2720                 find first buf_Clients no-lock where
     2721                           buf_clients.obj-type = 'орг':U
     2722                       and buf_clients.obj-code = p-host-code no-error.
     2723                 if not available buf_clients then do:
     2724                   v-mess = substitute("!!!Не найден в БД ДЕРЖАТЕЛЬ СЧЕТА &1&2 - БИК &3&1Коррсчет &4"
     2725                                       , tt-1s-fin-statement.r-schet
     2726                                       , chr(10)
     2727                                       , tt-1s-fin-statement.bik
     2728                                       , tt-1s-fin-statement.c-schet
     2729                                       ).
     2730                   undo _main, return error v-mess.
     2731                 end.
     2732                 assign
     2733                 tt-1s-fin-statement.cli-name = buf_clients.obj-name
     2734                 .
     2735               end.
     2736             end.
     2737             else do:
     2738               assign
     2739               v-seq-statement = v-seq-statement + 1
     2740               v-mess = substitute("!!!Выписка &1 фирма &2&3Счет &4 БИК &5:&3"  +
     2741                           'счет для ВЫПИСКИ отсутствует в БД'
     2742                         , cbnki-period-to-String(tt-1s-fin-statement.start-date, tt-1s-fin-statement.end-date)
     2743                         , p-host-code
     2744                         , chr(10)
     2745                         , tt-1s-fin-statement.r-schet
     2746                         , tt-1s-fin-statement.bik       ).
     2747               assign
     2748               v-crit-err = yes.
     2749               undo _main, return error v-mess.
     2750             end.
     2751             if v-skip = yes then do:
     2752               v-mess = substitute("!!!Выписка &1 фирма &2&3Счет &4 БИК &5"  +
     2753                                 'счет НЕ ВЫБРАН для импорта - пропускаем'
     2754                               , cbnki-period-to-String(tt-1s-fin-statement.start-date, tt-1s-fin-statement.end-date)
     2755                               , p-host-code
     2756                               , chr(10)
     2757                               , tt-1s-fin-statement.r-schet
     2758                               , tt-1s-fin-statement.bik                                  ).
     2759                 delete tt-1s-fin-statement.
     2760               return.
     2761             end.
     2762                   find first buf_temp_hfields where  buf_temp_hfields.subject = 'fin-statement':U                                                      and buf_temp_hfields.name_ = 'fins-ext-doc-type/' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2763                   find first buf_temp_hfields where  buf_temp_hfields.subject = 'fin-statement':U                                                      and buf_temp_hfields.name_ = 'fins-doc-type' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2764                   find first buf_temp_hfields where  buf_temp_hfields.subject = 'fin-statement':U                                                      and buf_temp_hfields.name_ = 'host-code' no-error.                       if available buf_temp_hfields then do:                                                                    assign                                                                                             buf_temp_hfields.imported = yes.                                                                     end.
     2765           end.
     2766           otherwise do:
     2767             error-status:error = no.
     2768           end.
     2769         END CASE.
     2770       end.
     2771       run show-counter in p-log-handle .
     2772       run write-counter in p-log-handle (substitute("Импорт БИК &1 Фирма &2: считано выписок &3"
     2773                                       , p-bik
     2774                                       , p-host-code
     2775                                       , p-count-statement)).
     2776       assign
     2777       in-statement = 0
     2778       exist-statement  = yes
     2779       .
     2780     end.
     2781   end procedure.
     2782   procedure proc-write-out :
     2783   define variable v-do as logical no-undo .
     2784   define variable h-buffer as handle no-undo .
     2785   define variable h-field as handle no-undo .
     2786   define variable h-1s-buffer as handle no-undo .
     2787   define variable h-1s-field as handle no-undo .
     2788   define variable v-date like ub.fin-doc.fact-date no-undo .
     2789   define variable v-result as character no-undo .
     2790   define variable v-doc-rec as recid no-undo .
     2791   define variable v-create as logical no-undo .
     2792   DEFINE VARIABLE v-today as date no-undo .
     2793   DEFINE VARIABLE v-time as integer no-undo .
     2794   define variable v-do-bank as logical no-undo .
     2795   define variable v-do-fact as logical no-undo .
     2796   define buffer buf_fin-doc for ub.fin-doc.
     2797   define buffer buf_fin-statement for ub.fin-statement.
     2798     _main:
     2799     do  transaction
     2800     on error undo, return error return-value
     2801     :
     2802       _tt-1s-fin-doc:
     2803       for each tt-1s-fin-doc
     2804       on error undo _main, return error
     2805       :
     2806         assign
     2807         v-do = no
     2808         v-create = no
     2809         .
     2810         find first buf_fin-doc where
     2811                   buf_fin-doc.prn-doc-code = tt-1s-fin-doc.prn-doc-code
     2812               AND  buf_fin-doc.host-code = p-host-code
     2813               AND  buf_fin-doc.doc-date = tt-1s-fin-doc.doc-date
     2814               AND  buf_fin-doc.fin-ext-doc-type = tt-1s-fin-doc.fin-ext-doc-type
     2815               AND  buf_fin-doc.payer-r-schet = tt-1s-fin-doc.payer-r-schet
     2816               AND  buf_fin-doc.receiver-r-schet = tt-1s-fin-doc.receiver-r-schet no-error .
     2817         v-do = no.
     2818         if available buf_fin-doc then do:
     2819           if buf_fin-doc.status_ = 'банк':U
     2820           and tt-1s-fin-doc.fact-date <> ?
     2821           then do:
     2822             assign
     2823             v-do = yes
     2824             .
     2825           end.
     2826           else do:
     2827               if tt-1s-fin-doc.fact-date = ? then do:
     2828                 assign
     2829                 v-do = no.
     2830               end.
     2831               else do:
     2832                         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Документ &1 фирма &2&3Плательщик &4&3Получатель &5&3"  +                                'находится в статусе &6, закрыть на факт НЕВОЗМОЖНО'                                                 , tt-1s-fin-doc.prn-doc-code                                                             , p-host-code                                                                         , chr(10)                                                                       , buf_fin-doc.payer-name                                                              , buf_fin-doc.receiver-name                                                           , buf_fin-doc.status_)).
     2833                 p-view-log = yes.
     2834                 undo _main, return error .
     2835               end.
     2836           end.
     2837         end.
     2838         else do:
     2839             run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Документ &1 фирма &2&3Плательщик &4&3Получатель &5&3"  +                                'отсутствует в БД&6'                                                 , tt-1s-fin-doc.prn-doc-code                                                             , p-host-code                                                                         , chr(10)                                                                       , tt-1s-fin-doc.payer-name                                                              , tt-1s-fin-doc.receiver-name                                                            , (if p-do-create then ' согласно настройкам он будет создан' else '')  )).
     2840           if p-do-create then do:
     2841              assign
     2842              v-create = yes
     2843              v-do = no
     2844              .
     2845           end.
     2846           else do:
     2847             NEXT _tt-1s-fin-doc.
     2848           end.
     2849         end.
     2850         if v-do or v-create then do:
     2851           create tt-th-fin-doc.
     2852           assign
     2853           tt-th-fin-doc.stat-pl = ''
     2854           tt-th-fin-doc.ocher-pl = "6":U
     2855           .
     2856           assign
     2857           h-buffer = buffer tt-th-Fin-doc:handle
     2858           h-1s-buffer = buffer tt-1s-Fin-doc:handle
     2859           .
     2860           if not v-create then
     2861           buffer-copy buf_fin-doc to tt-th-fin-doc.
     2862           _tt:
     2863           for each temp_hfields where
     2864                   temp_hfields.imported = yes
     2865               and temp_hfields.subject = 'fin-doc':U:
     2866             if tt-1s-fin-doc.fin-EXT-doc-type = 'ппп':U then do:
     2867                if lookup(temp_hfields.name_ , 'stat-pl,f104,f105,f106,f107,f108,f109,f110':U) > 0
     2868                then next _tt.
     2869             end.
     2870             if index(temp_hfields.name , chr(47)) > 0 then do:
     2871               CASE temp_hfields.name:
     2872                 when 'payer-INN/payer-name':U
     2873                 then do:
     2874                   assign
     2875                   tt-th-fin-doc.payer-inn = tt-1s-fin-doc.payer-inn
     2876                   .
     2877                   next _tt.
     2878                 end.
     2879                 when 'receiver-INN/receiver-name':U
     2880                 then do:
     2881                   assign
     2882                   tt-th-fin-doc.receiver-inn = tt-1s-fin-doc.receiver-inn
     2883                   .
     2884                   next _tt.
     2885                 end.
     2886                 otherwise do:
     2887                   h-field = h-buffer:buffer-field(entry(1, temp_hfields.name_, chr(47))).
     2888                   h-1s-field = h-1s-buffer:buffer-field(entry(1, temp_hfields.name_, chr(47))).
     2889                 end.
     2890               END CASE.
     2891             end.
     2892             else do:
     2893               h-field = h-buffer:buffer-field(temp_hfields.name_).
     2894               h-1s-field = h-1s-buffer:buffer-field(temp_hfields.name_).
     2895               if h-field:name = 'fact-date' then NEXT _tt.
     2896             end.
     2897             assign
     2898             h-field:buffer-value = h-1s-field:buffer-value
     2899             .
     2900           end.
     2901           if not v-create then do:
     2902             v-result = '':U.
     2903             buffer-compare tt-th-fin-doc to buf_fin-doc
     2904             save result in v-result.
     2905             if v-result <> '':U then do:
     2906               assign
     2907               v-doc-rec = recid(buf_fin-doc).
     2908                 run ref/findoc0.p (
     2909               input-output v-doc-rec
     2910                     ,input ('ИЗМЕНЕНИЕ':U + chr(4) + 'cl-bank')
     2911                     ,input yes
     2912                     ,input tt-th-fin-doc.host-code            ,input tt-th-fin-doc.fin-doc-code         ,input tt-th-fin-doc.an-uchet-code        ,input tt-th-fin-doc.an-uchet-value       ,input tt-th-fin-doc.base-rate            ,input tt-th-fin-doc.base-scale           ,input tt-th-fin-doc.cel-nazn-code        ,input tt-th-fin-doc.cel-nazn-value       ,input tt-th-fin-doc.contract-code        ,input tt-th-fin-doc.contract-curr        ,input tt-th-fin-doc.contract-rate        ,input tt-th-fin-doc.contract-scale       ,input tt-th-fin-doc.cor-acc              ,input tt-th-fin-doc.cor-acc-value        ,input tt-th-fin-doc.cor-acc1             ,input tt-th-fin-doc.cor-acc1-value       ,input tt-th-fin-doc.curr-code            ,input tt-th-fin-doc.doc-date             ,input tt-th-fin-doc.shift-date           ,input tt-th-fin-doc.shift-num            ,input tt-th-fin-doc.shift-name           ,input tt-th-fin-doc.enclosure            ,input tt-th-fin-doc.exch-rate            ,input tt-th-fin-doc.exch-scale           ,input tt-th-fin-doc.f104                 ,input tt-th-fin-doc.f105                 ,input tt-th-fin-doc.f106                 ,input tt-th-fin-doc.f107                 ,input tt-th-fin-doc.f108                 ,input tt-th-fin-doc.f109                 ,input tt-th-fin-doc.f110                 ,input tt-th-fin-doc.f22                  ,input tt-th-fin-doc.f23                  ,input tt-th-fin-doc.fact-date            ,input tt-th-fin-doc.fin-doc-type         ,input tt-th-fin-doc.fin-ext-doc-type     ,input tt-th-fin-doc.in-doc-code          ,input tt-th-fin-doc.in-host-code         ,input tt-th-fin-doc.including            ,input tt-th-fin-doc.nazn-pl              ,input tt-th-fin-doc.naznach-plat         ,input tt-th-fin-doc.ocher-pl             ,input tt-th-fin-doc.out-doc-code         ,input tt-th-fin-doc.out-host-code        ,input tt-th-fin-doc.pay-date             ,input tt-th-fin-doc.payer-bank-name      ,input tt-th-fin-doc.payer-bank-city      ,input tt-th-fin-doc.payer-bik            ,input tt-th-fin-doc.payer-c-schet        ,input tt-th-fin-doc.payer-code           ,input tt-th-fin-doc.payer-code-schet     ,input tt-th-fin-doc.payer-dop1           ,input tt-th-fin-doc.payer-dop2           ,input tt-th-fin-doc.payer-inn            ,input tt-th-fin-doc.payer-kpp            ,input tt-th-fin-doc.payer-name           ,input tt-th-fin-doc.payer-okpo           ,input tt-th-fin-doc.payer-passport      ,input tt-th-fin-doc.payer-r-schet        ,input tt-th-fin-doc.payer-type           ,input tt-th-fin-doc.perm-date            ,input tt-th-fin-doc.prn-doc-code         ,input tt-th-fin-doc.PS                   ,input tt-th-fin-doc.receiver-bank-name   ,input tt-th-fin-doc.receiver-bank-city   ,input tt-th-fin-doc.receiver-bik         ,input tt-th-fin-doc.receiver-c-schet     ,input tt-th-fin-doc.receiver-code        ,input tt-th-fin-doc.receiver-code-schet  ,input tt-th-fin-doc.receiver-dop1        ,input tt-th-fin-doc.receiver-dop2        ,input tt-th-fin-doc.receiver-inn         ,input tt-th-fin-doc.receiver-kpp         ,input tt-th-fin-doc.receiver-name        ,input tt-th-fin-doc.receiver-okpo        ,input tt-th-fin-doc.receiver-passport    ,input tt-th-fin-doc.receiver-r-schet     ,input tt-th-fin-doc.receiver-type        ,input tt-th-fin-doc.srok-pl              ,input tt-th-fin-doc.stat-pl              ,input tt-th-fin-doc.str-podr-code        ,input tt-th-fin-doc.str-podr-type        ,input tt-th-fin-doc.str-podr-name        ,input tt-th-fin-doc.sum-base             ,input tt-th-fin-doc.sum-doc              ,input tt-th-fin-doc.sum-rubl             ,input tt-th-fin-doc.sum-contr            ,input tt-th-fin-doc.trn-doc-code         ,input tt-th-fin-doc.vid-opl              ,input tt-th-fin-doc.vid-plat
     2913                     ,input tt-th-fin-doc.con-sum-rubl         ,input tt-th-fin-doc.con-sum-base         ,input tt-th-fin-doc.con-sum-doc          ,input tt-th-fin-doc.con-sum-contr        ,input tt-th-fin-doc.con-stat             ,input tt-th-fin-doc.payer-sign1                ,input tt-th-fin-doc.payer-sign2                ,input tt-th-fin-doc.payer-sign3                ,input tt-th-fin-doc.payer-sign4                ,input tt-th-fin-doc.receiver-sign1                ,input tt-th-fin-doc.receiver-sign2                ,input tt-th-fin-doc.receiver-sign3                ,input tt-th-fin-doc.receiver-sign4                ,input tt-th-fin-doc.obj-type                   ,input tt-th-fin-doc.obj-code                   ,input tt-th-fin-doc.doc-author                 ,input tt-th-fin-doc.fact-author                ,input tt-th-fin-doc.CashBookId
     2914                     ,input table tt0-fin-doc-tax
     2915                     ,input table tt0-fin-doc-attr
     2916                     ,input no
     2917                     ,input table tt0-payment
     2918               ) no-error.
     2919               if error-status:error then do:
     2920                 p-view-log = yes.
     2921                   run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Документ &1 фирма &2&3Плательщик &4&3Получатель &5&3"  +                                  'ОШИБКА ПРИ ОБНОВЛЕНИИ ДОКУМЕНТА изменениями из системы КЛИЕНТ-БАНК&3:&6 &7'                                                   , tt-1s-fin-doc.prn-doc-code                                                               , p-host-code                                                                           , chr(10)                                                                         , tt-1s-fin-doc.payer-name                                                                , tt-1s-fin-doc.receiver-name                                                              , error-status:get-message(1)                                                             , return-value   )).
     2922                 undo _main, return error .
     2923               end.
     2924             end.
     2925           end.
     2926         end.
     2927         if v-create then do:
     2928           run proc-create-fin-doc in this-procedure ( buffer tt-th-fin-doc
     2929                                                      ,buffer tt-1s-fin-doc
     2930                                                      ) no-error .
     2931           if error-status:error then do:
     2932             p-view-log = yes.
     2933             run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Документ &1 фирма &2&3Плательщик &4&3Получатель &5&3"  +                                'ОШИБКА ПРИ  СОЗДАНИИ ДОКУМЕНТА:&3&6 &7'                                                 , tt-1s-fin-doc.prn-doc-code                                                             , p-host-code                                                                         , chr(10)                                                                       , tt-1s-fin-doc.payer-name                                                              , tt-1s-fin-doc.receiver-name                                                            , error-status:get-message(1)                                                           , return-value   )).
     2934             undo _main, return error .
     2935           end.
     2936         end.
     2937         if v-do then do:
     2938           assign
     2939           v-date = tt-1s-fin-doc.fact-date
     2940           .
     2941           run trg/findstat.p (
     2942                            input parparentproc
     2943                           ,input buf_fin-doc.host-code
     2944                           ,input buf_fin-doc.fin-doc-code
     2945                           ,input '<закрытие документа>':U
     2946                           ,input 'cl-bank'
     2947                           ,input 'факт':U
     2948                           ,input-output v-date
     2949                           ,input yes
     2950                                         ) no-error .
     2951           if error-status:error then do:
     2952                 run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Документ &1 фирма &2&3Плательщик &4&3Получатель &5&3"  +                                  'ОШИБКА ПРИ ЗАКРЫТИИ ДОКУМЕНТА НА ФАКТ:&3&6&3&7'                                                   , tt-1s-fin-doc.prn-doc-code                                                               , p-host-code                                                                           , chr(10)                                                                         , tt-1s-fin-doc.payer-name                                                                , tt-1s-fin-doc.receiver-name                                                              , error-status:get-message(1)                                                             , return-value   )).
     2953               undo _main, return error .
     2954           end.
     2955           assign
     2956           tt-1s-fin-doc.status_ = 'факт':U
     2957           tt-th-fin-doc.status_ = 'факт':U
     2958           .
     2959         end.
     2960         if available buf_fin-doc then do:
     2961           tt-1s-fin-doc.fin-doc-code-th = buf_fin-doc.fin-doc-code.
     2962         end.
     2963         assign
     2964         p-processed = p-processed + 1
     2965         .
     2966         run show-counter in p-log-handle .
     2967         run write-counter in p-log-handle (substitute("Импорт: БИК &1 Фирма &2: ОБРАБОТАНО документов &3"
     2968                                         , p-bik
     2969                                         , p-host-code
     2970                                         , p-processed)).
     2971       end.
     2972       _tt-1s-fin-statement:
     2973       for each tt-1s-fin-statement
     2974       on error undo _main, return error
     2975       :
     2976         assign
     2977         v-do = no
     2978         v-create = no
     2979         .
     2980         find first buf_fin-statement where
     2981                    buf_fin-statement.host-code = p-host-code
     2982               AND  buf_fin-statement.start-date = tt-1s-fin-statement.start-date
     2983               AND  buf_fin-statement.end-date = tt-1s-fin-statement.end-date
     2984               AND  buf_fin-statement.fins-ext-doc-type = tt-1s-fin-statement.fins-ext-doc-type
     2985               AND  buf_fin-statement.code-bank = tt-1s-fin-statement.code-bank
     2986               AND  buf_fin-statement.code-schet = tt-1s-fin-statement.code-schet
     2987               no-error .
     2988         assign
     2989         v-do-bank = no
     2990         v-do-fact = no
     2991         .
     2992         if available buf_fin-statement then do:
     2993           v-doc-rec = recid(buf_fin-statement).
     2994           if buf_fin-statement.status_ = 'банк':U
     2995           then do:
     2996             assign
     2997             v-do-fact = yes
     2998             .
     2999           end.
     3000           else do:
     3001             if buf_fin-statement.status_ = 'новый':U and tt-1s-fin-statement.bank-date <> ? then do:
     3002               assign
     3003               v-do-bank = yes.
     3004             end.
     3005             else do:
     3006                             run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Выписка &1 фирма &2&3Счет &4 БИК &5&3"  +                                      'находится в статусе &6, закрыть на банк НЕВОЗМОЖНО'                                , cbnki-period-to-String(tt-1s-fin-statement.start-date, tt-1s-fin-statement.end-date)                               , p-host-code                                                                         , chr(10)                                                                       , buf_fin-statement.r-schet                                                           , buf_fin-statement.bik                                                               , buf_fin-statement.status_)).
     3007                 p-view-log = yes.
     3008                 undo _main, return error .
     3009             end.
     3010           end.
     3011         end.
     3012         else do:
     3013           assign
     3014           v-create = yes
     3015           v-do-fact = yes
     3016           v-do-bank = yes
     3017           .
     3018         end.
     3019         if not v-create then do:
     3020           run proc-insert-statement-lines in this-procedure ( (buffer buf_Fin-statement:handle) ).
     3021           buffer-copy buf_fin-statement to tt-th-fin-statement.
     3022         end.
     3023         if v-do-bank or v-do-fact or v-create then do:
     3024           create tt-th-fin-statement.
     3025           assign
     3026           h-buffer = buffer tt-th-fin-statement:handle
     3027           h-1s-buffer = buffer tt-1s-fin-statement:handle
     3028           .
     3029           _tt:
     3030           for each temp_hfields where
     3031                   temp_hfields.imported = yes
     3032               and temp_hfields.subject = 'fin-statement':U:
     3033             if temp_hfields.name_ = 'fins-ext-doc-type/' then NEXT _tt.
     3034             h-field = h-buffer:buffer-field(temp_hfields.name_).
     3035             if h-field:name = 'fact-date' then NEXT _tt.
     3036             if h-field:name = 'bank-date' then NEXT _tt.
     3037             h-1s-field = h-1s-buffer:buffer-field(temp_hfields.name_).
     3038             assign
     3039             h-field:buffer-value = h-1s-field:buffer-value
     3040             .
     3041           end.
     3042           if not v-create then do:
     3043             v-result = ''.
     3044             buffer-compare tt-th-fin-statement
     3045             using num-docs start-sum-doc end-sum-doc in-sum-doc out-sum-doc
     3046             to buf_fin-statement
     3047             save result in v-result.
     3048             if v-result <> '':U then do:
     3049               assign
     3050               v-doc-rec = recid(buf_fin-statement).
     3051                 define variable v-lines-exist as logical no-undo .
     3052               run ref/finsttm0.p
     3053                               (input yes
     3054                               ,input-output v-doc-rec
     3055                               ,input       ('ИЗМЕНЕНИЕ':U + chr(4) + 'cl-bank')
     3056                               ,input '1s':U
     3057                               ,input tt-th-fin-statement.host-code            ,input tt-th-fin-statement.sttm-code            ,input tt-th-fin-statement.curr-code            ,input tt-th-fin-statement.doc-date             ,input tt-th-fin-statement.bank-date            ,input tt-th-fin-statement.fact-date            ,input tt-th-fin-statement.fins-doc-type        ,input tt-th-fin-statement.fins-ext-doc-type    ,input tt-th-fin-statement.code-bank            ,input tt-th-fin-statement.bank-name            ,input tt-th-fin-statement.bank-city            ,input tt-th-fin-statement.bik                  ,input tt-th-fin-statement.code-schet           ,input tt-th-fin-statement.r-schet              ,input tt-th-fin-statement.c-schet              ,input tt-th-fin-statement.cli-name             ,input tt-th-fin-statement.prn-doc-code         ,input tt-th-fin-statement.PS                   ,input tt-th-fin-statement.sum-doc              ,input tt-th-fin-statement.start-sum-doc-th     ,input tt-th-fin-statement.start-sum-doc        ,input tt-th-fin-statement.in-sum-doc           ,input tt-th-fin-statement.out-sum-doc          ,input tt-th-fin-statement.end-sum-doc          ,input tt-th-fin-statement.num-docs             ,input tt-th-fin-statement.start-date           ,input tt-th-fin-statement.end-date
     3058                               ,input 'новый':U
     3059                               ,input v-lines-exist
     3060                               ) no-error .
     3061               if error-status:error then do:
     3062                 p-view-log = yes.
     3063                   run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Выписка &1 фирма &2&3Счет &4 БИК &5&3"  +                                  'ОШИБКА ПРИ ОБНОВЛЕНИИ выписки изменениями из системы КЛИЕНТ-БАНК&3:&6 &7'                               , cbnki-period-to-String(tt-1s-fin-statement.start-date, tt-1s-fin-statement.end-date)                               , p-host-code                                                                           , chr(10)                                                                         , tt-1s-fin-statement.r-schet                                                                , tt-1s-fin-statement.bik                                                              , error-status:get-message(1)                                                             , return-value   )).
     3064                 undo _main, return error .
     3065               end.
     3066             end.
     3067           end.
     3068         end.
     3069         if v-create then do:
     3070           run proc-create-fin-statement in this-procedure ( buffer tt-th-fin-statement) no-error .
     3071           if error-status:error then do:
     3072             p-view-log = yes.
     3073             run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Выписка &1 фирма &2&3Счета &4 БИК &5&3"  +                                'ОШИБКА ПРИ  СОЗДАНИИ ВЫПИСКИ:&3&6 &7'                                                 , cbnki-period-to-String(tt-1s-fin-statement.start-date, tt-1s-fin-statement.end-date)                             , p-host-code                                                                          , chr(10)                                                                        , tt-1s-fin-statement.r-schet                                                          , tt-1s-fin-statement.BIK                                                              , error-status:get-message(1)                                                           , return-value   )).
     3074             undo _main, return error .
     3075           end.
     3076           find first buf_Fin-statement no-lock where
     3077                     buf_fin-statement.host-code = p-host-code
     3078                 and buf_fin-statement.sttm-code = tt-th-fin-statement.sttm-code.
     3079           run proc-insert-statement-lines in this-procedure ( (buffer buf_Fin-statement:handle) ).
     3080         end.
     3081         if buf_fin-statement.num-docs = buf_fin-statement.num-docs-th
     3082         and buf_fin-statement.start-sum-doc = buf_fin-statement.start-sum-doc-th
     3083         and buf_fin-statement.end-sum-doc = buf_fin-statement.end-sum-doc-th
     3084         and buf_fin-statement.in-sum-doc = buf_fin-statement.in-sum-doc-th
     3085         and buf_fin-statement.out-sum-doc = buf_fin-statement.out-sum-doc-th
     3086         and buf_fin-statement.sum-doc = buf_fin-statement.sum-doc-th then do:
     3087           if buf_fin-statement.status_ = 'новый':U then do:
     3088             run trg/finsstat.p (
     3089                             input buf_fin-statement.host-code
     3090                             ,input buf_fin-statement.sttm-code
     3091                             ,input '<закрытие документа>':U
     3092                             ,input '1s':U
     3093                             ,input 'банк':U
     3094                             ,input-output tt-1s-fin-statement.bank-date
     3095                             ,input yes
     3096                                           ) no-error .
     3097             if error-status:error then do:
     3098                     run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Выписка &1 фирма &2&3Счета &4 БИК &5&3"  +                                    'ОШИБКА ПРИ ЗАКРЫТИИ ВЫПИСКИ НА БАНК&3:&6 &7'                                    , cbnki-period-to-String(tt-1s-fin-statement.start-date, tt-1s-fin-statement.end-date)                                 , p-host-code                                                                      , chr(10)                                                                    , tt-1s-fin-statement.r-schet                                                      , tt-1s-fin-statement.bik                                                          , error-status:get-message(1)                                                      , return-value   )).
     3099                 undo _main, return error .
     3100             end.
     3101           end.
     3102           if buf_fin-statement.status_ = 'банк':U then do:
     3103             run cur-time in this-procedure(output v-today, output v-time).
     3104             assign
     3105             v-date = v-today
     3106             .
     3107             run trg/finsstat.p (
     3108                             input buf_fin-statement.host-code
     3109                             ,input buf_fin-statement.sttm-code
     3110                             ,input '<закрытие документа>':U
     3111                             ,input '1s':U
     3112                             ,input 'факт':U
     3113                             ,input-output v-date
     3114                             ,input yes
     3115                                           ) no-error .
     3116             if error-status:error then do:
     3117                     run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Выписка &1 фирма &2&3Счета &4 БИК &5&3"  +                                    'ОШИБКА ПРИ ЗАКРЫТИИ ВЫПИСКИ НА ФАКТ&3:&6 &7'                                    , cbnki-period-to-String(tt-1s-fin-statement.start-date, tt-1s-fin-statement.end-date)                                 , p-host-code                                                                      , chr(10)                                                                    , tt-1s-fin-statement.r-schet                                                      , tt-1s-fin-statement.bik                                                          , error-status:get-message(1)                                                      , return-value   )).
     3118                 undo _main, return error .
     3119             end.
     3120           end.
     3121         end.
     3122         assign
     3123         p-processed-statement = p-processed-statement + 1
     3124         .
     3125         run show-counter in p-log-handle .
     3126         run write-counter in p-log-handle (substitute("Импорт: БИК &1 Фирма &2: ОБРАБОТАНО выписок &3"
     3127                                         , p-bik
     3128                                         , p-host-code
     3129                                         , p-processed-statement)).
     3130       end.
     3131     end.
     3132   end procedure.
     3133   procedure proc-create-fin-doc :
     3134   define parameter buffer buf_tt-th-fin-doc for tt-th-fin-doc.
     3135   define parameter buffer buf_tt-1s-fin-doc for tt-1s-fin-doc.
     3136   define variable v-doc-rec as recid no-undo .
     3137   define variable v-curr-abbr like ub.currency.curr-abbr no-undo.
     3138   define variable v-contract-rate like ub.fin-doc.exch-rate no-undo.
     3139   define variable v-contract-scale like ub.fin-doc.exch-scale no-undo.
     3140   define variable v-base-code like ub.sysconf.host-code no-undo.
     3141   define variable v-mess as character no-undo .
     3142   DEFINE VARIABLE v-today as date no-undo .
     3143   DEFINE VARIABLE v-time as integer no-undo .
     3144   define variable v-fd-code as integer no-undo .
     3145   define buffer buf_sysconf for ub.sysconf.
     3146   define buffer buf_firm for ub.firm.
     3147   define buffer buf_fin-bank for ub.fin-bank.
     3148   define buffer buf_fin-schet for ub.fin-schet.
     3149   define buffer buf_fin-code-cor-acc for ub.fin-code-cor-acc.
     3150   define buffer buf_fin-code-an-uchet for ub.fin-code-an-uchet.
     3151   define buffer buf_fin-code-cel-nazn for ub.fin-code-cel-nazn.
     3152   define buffer buf_fin-doc for ub.fin-doc.
     3153   define buffer receiver-firm for ub.firm.
     3154   define buffer receiver-person for ub.person.
     3155   define buffer payer-firm for ub.firm.
     3156   define buffer payer-person for ub.person.
     3157     do
     3158     on error undo, return error
     3159     :
     3160       run gen-b-code in this-procedure ( input 'fdgb':U
     3161                                        , output v-fd-code) no-error .
     3162       if error-status:error then do:
     3163         undo, return error substitute("Ошибка при генерации внутреннего номера фин. док-та:&1&2&1&3"
     3164                                      , chr(10)
     3165                                      , error-status:get-message(1)
     3166                                      , return-value ).
     3167       end.
     3168       assign
     3169       buf_tt-th-fin-doc.contract-curr = 0
     3170       buf_tt-th-fin-doc.base-rate = 1
     3171       buf_tt-th-fin-doc.base-scale = 1
     3172       buf_tt-th-fin-doc.exch-rate = 1
     3173       buf_tt-th-fin-doc.exch-scale = 1
     3174       buf_tt-th-fin-doc.contract-rate = 1
     3175       buf_tt-th-fin-doc.contract-scale = 1
     3176       buf_tt-th-fin-doc.obj-type      = '':U
     3177       buf_tt-th-fin-doc.obj-code      = 0
     3178       buf_tt-th-fin-doc.contract-code = 0
     3179       buf_tt-th-fin-doc.fin-doc-code  = v-fd-code
     3180       buf_tt-th-fin-doc.status_       = 'новый':U
     3181       buf_tt-th-fin-doc.user-db-num-doc = g#db-num
     3182       buf_tt-th-fin-doc.user-name-doc = g#userid
     3183       buf_tt-th-fin-doc.doc-author    = '1s':U
     3184       .
     3185       CASE buf_tt-th-fin-doc.fin-ext-doc-type:
     3186         when 'рпп':U then do:
     3187           find first buf_sysconf where
     3188                     buf_sysconf.host-code = buf_tt-th-fin-doc.payer-code.
     3189           v-base-code = buf_sysconf.base-code.
     3190           find first buf_firm where
     3191                     buf_firm.firm-code = buf_tt-th-fin-doc.payer-code
     3192           .
     3193           assign
     3194           buf_tt-th-fin-doc.payer-sign1  = buf_firm.director
     3195           buf_tt-th-fin-doc.payer-sign2  = buf_sysconf.snr-accnt
     3196           buf_tt-th-fin-doc.host-code    = buf_tt-th-fin-doc.payer-code
     3197           .
     3198           if buf_tt-th-fin-doc.payer-code <> p-host-code then do:
     3199             undo, return error substitute("!!!В файле для фирмы &1 обнаружена платежка фирмы &2"
     3200                                           ,p-host-code
     3201                                           ,buf_tt-th-fin-doc.payer-code).
     3202           end.
     3203           find first buf_fin-bank no-lock where
     3204                     buf_Fin-bank.host-code = buf_tt-th-fin-doc.host-code
     3205                 AND buf_Fin-bank.bik = buf_tt-th-fin-doc.receiver-bik
     3206                 AND buf_Fin-bank.cor-acc = buf_tt-th-fin-doc.receiver-c-schet no-error.
     3207           if not available buf_fin-bank then do:
     3208             assign
     3209             v-mess = substitute("!!!Не найден в БД (или удален) банк ПОЛУЧАТЕЛЯ&1 - БИК &2&1Коррсчет &3"
     3210                                 , chr(10)
     3211                                 , buf_tt-th-fin-doc.receiver-bik
     3212                                 , buf_tt-th-fin-doc.receiver-c-schet
     3213                                 ).
     3214             undo, return error v-mess.
     3215           end.
     3216           if buf_fin-bank.status_ <> 'тек':U then do:
     3217             undo, return error substitute("!!!банк ПОЛУЧАТЕЛЯ БИК &1 имеет статус", buf_fin-bank.status_).
     3218           end.
     3219           for each buf_fin-schet no-lock where
     3220                   buf_fin-schet.host-code = buf_tt-th-fin-doc.host-code
     3221               AND buf_fin-schet.code-bank =  buf_fin-bank.code-bank
     3222               AND buf_fin-schet.r-schet =  buf_tt-th-fin-doc.receiver-r-schet
     3223               AND buf_fin-schet.status_ =  'тек':U :
     3224             if buf_fin-schet.cli-type = 'орг':U then do:
     3225               find first receiver-firm no-lock where
     3226                       receiver-firm.firm-code = buf_fin-schet.cli-code
     3227                   and receiver-firm.inn = tt-1s-fin-doc.receiver-inn no-error.
     3228               if available receiver-firm then leave.
     3229             end.
     3230             if buf_fin-schet.cli-type = 'чел':U then do:
     3231               find first receiver-person no-lock where
     3232                       receiver-person.psn-code = buf_fin-schet.cli-code
     3233                   and receiver-person.inn = tt-1s-fin-doc.receiver-inn no-error.
     3234               if available receiver-person then leave.
     3235             end.
     3236           end.
     3237           if not available buf_fin-schet then do:
     3238             assign
     3239             v-mess =  substitute("!!!Не найден в БД (или удален) счет ПОЛУЧАТЕЛЯ&1 банк с БИК &2 (вн код &3),&1р/с &4, ИНН &5"
     3240                       , chr(10)
     3241                       , buf_tt-th-fin-doc.receiver-bik
     3242                       , buf_fin-bank.code-bank
     3243                       , buf_tt-th-fin-doc.receiver-r-schet
     3244                       , buf_tt-th-fin-doc.receiver-inn
     3245                       ).
     3246             undo, return error v-mess.
     3247           end.
     3248           assign
     3249           buf_tt-th-fin-doc.receiver-code-schet = buf_fin-schet.code-schet
     3250           buf_tt-th-fin-doc.receiver-c-schet = buf_fin-schet.c-schet
     3251           buf_tt-th-fin-doc.receiver-type = buf_fin-schet.cli-type
     3252           buf_tt-th-fin-doc.receiver-code = buf_fin-schet.cli-code
     3253           buf_tt-th-fin-doc.cel-nazn-code = buf_sysconf.cel-nazn-code-out
     3254           buf_tt-th-fin-doc.an-uchet-code = buf_sysconf.an-uchet-code-out
     3255           buf_tt-th-fin-doc.cor-acc       = buf_sysconf.cor-acc-out
     3256           .
     3257         end.
     3258         when 'ппп':U then do:
     3259           find first buf_sysconf where
     3260                     buf_sysconf.host-code = buf_tt-th-fin-doc.receiver-code.
     3261           v-base-code = buf_sysconf.base-code.
     3262           buf_tt-th-fin-doc.host-code     = buf_tt-th-fin-doc.receiver-code.
     3263           if buf_tt-th-fin-doc.receiver-code <> p-host-code then do:
     3264             undo, return error substitute("!!!В файле для фирмы &1 обнаружена платежка фирмы &2"
     3265                                           ,p-host-code
     3266                                           ,buf_tt-th-fin-doc.receiver-code).
     3267           end.
     3268           find first buf_fin-bank no-lock where
     3269                     buf_Fin-bank.host-code = buf_tt-th-fin-doc.host-code
     3270                 AND buf_Fin-bank.bik = buf_tt-th-fin-doc.payer-bik
     3271                 AND buf_Fin-bank.cor-acc = buf_tt-th-fin-doc.payer-c-schet  no-error.
     3272           if not available buf_fin-bank then do:
     3273             assign
     3274             v-mess = substitute("!!!Не найден в БД (или удален) банк ПЛАТЕЛЬЩИКА&1 - БИК &2&1Коррсчет &3"
     3275                                 , chr(10)
     3276                                 , buf_tt-th-fin-doc.payer-bik
     3277                                 , buf_tt-th-fin-doc.payer-c-schet
     3278                                 ).
     3279             undo, return error v-mess.
     3280           end.
     3281           if buf_fin-bank.status_ <> 'тек':U then do:
     3282             undo, return error substitute("!!!банк ПЛАТЕЛЬЩИКА БИК &1 имеет статус", buf_fin-bank.status_).
     3283           end.
     3284           for each buf_fin-schet no-lock where
     3285                   buf_fin-schet.host-code = buf_tt-th-fin-doc.host-code
     3286               AND buf_fin-schet.code-bank =  buf_fin-bank.code-bank
     3287               AND buf_fin-schet.r-schet =  buf_tt-th-fin-doc.payer-r-schet
     3288               AND buf_fin-schet.status_ = 'тек':U :
     3289             if buf_fin-schet.cli-type = 'орг':U then do:
     3290               find first payer-firm no-lock where
     3291                       payer-firm.firm-code = buf_fin-schet.cli-code
     3292                   and payer-firm.inn = tt-1s-fin-doc.payer-inn no-error.
     3293               if available payer-firm then leave.
     3294             end.
     3295             if buf_fin-schet.cli-type = 'чел':U then do:
     3296               find first payer-person no-lock where
     3297                       payer-person.psn-code = buf_fin-schet.cli-code
     3298                   and payer-person.inn = tt-1s-fin-doc.payer-inn no-error.
     3299               if available payer-person then leave.
     3300             end.
     3301           end.
     3302           if not available buf_fin-schet then do:
     3303             assign
     3304             v-mess =  substitute("!!!Не найден в БД (или удален) счет ПЛАТЕЛЬЩИКА&1 банк с БИК &2 (вн код &3),&1р/с &4, ИНН &5"
     3305                       , chr(10)
     3306                       , buf_tt-th-fin-doc.payer-bik
     3307                       , buf_fin-bank.code-bank
     3308                       , buf_tt-th-fin-doc.payer-r-schet
     3309                       , buf_tt-th-fin-doc.payer-inn
     3310                       ).
     3311             undo, return error v-mess.
     3312           end.
     3313           assign
     3314           buf_tt-th-fin-doc.payer-code-schet = buf_fin-schet.code-schet
     3315           buf_tt-th-fin-doc.payer-c-schet = buf_fin-schet.c-schet
     3316           buf_tt-th-fin-doc.payer-type = buf_fin-schet.cli-type
     3317           buf_tt-th-fin-doc.payer-code = buf_fin-schet.cli-code
     3318           buf_tt-th-fin-doc.cel-nazn-code = buf_sysconf.cel-nazn-code-in
     3319           buf_tt-th-fin-doc.an-uchet-code = buf_sysconf.an-uchet-code-in
     3320           buf_tt-th-fin-doc.cor-acc       = buf_sysconf.cor-acc-in
     3321           .
     3322         end.
     3323       END CASE.
     3324   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3325   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     3326     (input  buf_tt-th-fin-doc.host-code
     3327     ,input  buf_tt-th-fin-doc.doc-date
     3328     ,output buf_tt-th-fin-doc.base-rate
     3329     ,output buf_tt-th-fin-doc.base-scale
     3330     )  .
     3331   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3332   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     3333     (input  buf_tt-th-fin-doc.curr-code
     3334     ,input  buf_tt-th-fin-doc.doc-date
     3335     ,output buf_tt-th-fin-doc.exch-rate
     3336     ,output buf_tt-th-fin-doc.exch-scale
     3337     ,output v-curr-abbr
     3338     )  .
     3339   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3340   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     3341     (input  buf_tt-th-fin-doc.contract-curr
     3342     ,input  buf_tt-th-fin-doc.doc-date
     3343     ,output buf_tt-th-fin-doc.contract-rate
     3344     ,output buf_tt-th-fin-doc.contract-scale
     3345     ,output v-curr-abbr
     3346     )  .
     3347       CASE buf_tt-th-fin-doc.curr-code:
     3348         when 0 then do:
     3349           assign
     3350           buf_tt-th-fin-doc.sum-rubl = buf_tt-th-fin-doc.sum-doc
     3351           buf_tt-th-fin-doc.sum-base = buf_tt-th-fin-doc.sum-doc / buf_tt-th-fin-doc.base-rate * buf_tt-th-fin-doc.base-scale
     3352           buf_tt-th-fin-doc.sum-contr = (if buf_tt-th-fin-doc.contract-curr = 0                                                       then buf_tt-th-fin-doc.sum-rubl                                                       else buf_tt-th-fin-doc.sum-rubl / (buf_tt-th-fin-doc.contract-rate / buf_tt-th-fin-doc.contract-scale)                                                     )
     3353           .
     3354         end.
     3355         when v-base-code then do:
     3356           assign
     3357           buf_tt-th-fin-doc.sum-rubl = buf_tt-th-fin-doc.sum-doc * buf_tt-th-fin-doc.exch-rate / buf_tt-th-fin-doc.exch-scale
     3358           buf_tt-th-fin-doc.sum-base = buf_tt-th-fin-doc.sum-rubl / buf_tt-th-fin-doc.base-rate * buf_tt-th-fin-doc.base-scale
     3359           buf_tt-th-fin-doc.sum-contr = (if buf_tt-th-fin-doc.contract-curr = 0                                                       then buf_tt-th-fin-doc.sum-rubl                                                       else buf_tt-th-fin-doc.sum-rubl / (buf_tt-th-fin-doc.contract-rate / buf_tt-th-fin-doc.contract-scale)                                                     )
     3360           .
     3361         end.
     3362         otherwise do:
     3363           assign
     3364           buf_tt-th-fin-doc.sum-rubl = buf_tt-th-fin-doc.sum-doc * buf_tt-th-fin-doc.exch-rate / buf_tt-th-fin-doc.exch-scale
     3365           buf_tt-th-fin-doc.sum-base = buf_tt-th-fin-doc.sum-rubl / buf_tt-th-fin-doc.base-rate * buf_tt-th-fin-doc.base-scale
     3366           buf_tt-th-fin-doc.sum-contr = (if buf_tt-th-fin-doc.contract-curr = 0                                                       then buf_tt-th-fin-doc.sum-rubl                                                       else buf_tt-th-fin-doc.sum-rubl / (buf_tt-th-fin-doc.contract-rate / buf_tt-th-fin-doc.contract-scale)                                                     )
     3367           .
     3368         end.
     3369       END CASE.
     3370       if buf_tt-th-fin-doc.cor-acc <> 0 then do:
     3371         find first buf_fin-code-cor-acc no-lock where
     3372                   buf_fin-code-cor-acc.host-code = p-host-code
     3373               AND buf_fin-code-cor-acc.fin-code = buf_tt-th-fin-doc.cor-acc .
     3374         assign
     3375         buf_tt-th-fin-doc.cor-acc-value = buf_fin-code-cor-acc.code-value
     3376         .
     3377       end.
     3378       if buf_tt-th-fin-doc.cor-acc1 <> 0 then do:
     3379         find first buf_fin-code-cor-acc no-lock where
     3380                   buf_fin-code-cor-acc.host-code = p-host-code
     3381               AND buf_fin-code-cor-acc.fin-code = buf_tt-th-fin-doc.cor-acc1.
     3382         assign
     3383         buf_tt-th-fin-doc.cor-acc1-value = buf_fin-code-cor-acc.code-value
     3384         .
     3385       end.
     3386       if buf_tt-th-fin-doc.AN-UCHET-CODE <> 0 then do:
     3387         find first buf_fin-code-AN-UCHET no-lock where
     3388                   buf_fin-code-an-uchet.host-code = p-host-code
     3389               AND buf_fin-code-an-uchet.fin-code = buf_tt-th-fin-doc.an-uchet-code.
     3390         assign
     3391         buf_tt-th-fin-doc.an-uchet-value = buf_fin-code-an-uchet.code-value
     3392         .
     3393       end.
     3394       if buf_tt-th-fin-doc.cel-nazn-code <> 0 then do:
     3395           find first buf_fin-code-cel-nazn no-lock where
     3396                     buf_fin-code-cel-nazn.host-code = p-host-code
     3397                 AND buf_fin-code-cel-nazn.fin-code = buf_tt-th-fin-doc.cel-nazn-code.
     3398          assign
     3399          buf_tt-th-fin-doc.cel-nazn-value = buf_fin-code-cel-nazn.code-value
     3400          .
     3401       end.
     3402       run proc-create-default-tax  in this-procedure (buffer buf_tt-th-fin-doc).
     3403       assign
     3404       v-doc-rec = ?.
     3405       run ref/findoc0.p (
     3406       input-output v-doc-rec
     3407             ,input ('ДОБАВЛЕНИЕ':U + chr(4) + 'cl-bank')
     3408             ,input yes
     3409             ,input buf_tt-th-fin-doc.host-code            ,input buf_tt-th-fin-doc.fin-doc-code         ,input buf_tt-th-fin-doc.an-uchet-code        ,input buf_tt-th-fin-doc.an-uchet-value       ,input buf_tt-th-fin-doc.base-rate            ,input buf_tt-th-fin-doc.base-scale           ,input buf_tt-th-fin-doc.cel-nazn-code        ,input buf_tt-th-fin-doc.cel-nazn-value       ,input buf_tt-th-fin-doc.contract-code        ,input buf_tt-th-fin-doc.contract-curr        ,input buf_tt-th-fin-doc.contract-rate        ,input buf_tt-th-fin-doc.contract-scale       ,input buf_tt-th-fin-doc.cor-acc              ,input buf_tt-th-fin-doc.cor-acc-value        ,input buf_tt-th-fin-doc.cor-acc1             ,input buf_tt-th-fin-doc.cor-acc1-value       ,input buf_tt-th-fin-doc.curr-code            ,input buf_tt-th-fin-doc.doc-date             ,input buf_tt-th-fin-doc.shift-date           ,input buf_tt-th-fin-doc.shift-num            ,input buf_tt-th-fin-doc.shift-name           ,input buf_tt-th-fin-doc.enclosure            ,input buf_tt-th-fin-doc.exch-rate            ,input buf_tt-th-fin-doc.exch-scale           ,input buf_tt-th-fin-doc.f104                 ,input buf_tt-th-fin-doc.f105                 ,input buf_tt-th-fin-doc.f106                 ,input buf_tt-th-fin-doc.f107                 ,input buf_tt-th-fin-doc.f108                 ,input buf_tt-th-fin-doc.f109                 ,input buf_tt-th-fin-doc.f110                 ,input buf_tt-th-fin-doc.f22                  ,input buf_tt-th-fin-doc.f23                  ,input buf_tt-th-fin-doc.fact-date            ,input buf_tt-th-fin-doc.fin-doc-type         ,input buf_tt-th-fin-doc.fin-ext-doc-type     ,input buf_tt-th-fin-doc.in-doc-code          ,input buf_tt-th-fin-doc.in-host-code         ,input buf_tt-th-fin-doc.including            ,input buf_tt-th-fin-doc.nazn-pl              ,input buf_tt-th-fin-doc.naznach-plat         ,input buf_tt-th-fin-doc.ocher-pl             ,input buf_tt-th-fin-doc.out-doc-code         ,input buf_tt-th-fin-doc.out-host-code        ,input buf_tt-th-fin-doc.pay-date             ,input buf_tt-th-fin-doc.payer-bank-name      ,input buf_tt-th-fin-doc.payer-bank-city      ,input buf_tt-th-fin-doc.payer-bik            ,input buf_tt-th-fin-doc.payer-c-schet        ,input buf_tt-th-fin-doc.payer-code           ,input buf_tt-th-fin-doc.payer-code-schet     ,input buf_tt-th-fin-doc.payer-dop1           ,input buf_tt-th-fin-doc.payer-dop2           ,input buf_tt-th-fin-doc.payer-inn            ,input buf_tt-th-fin-doc.payer-kpp            ,input buf_tt-th-fin-doc.payer-name           ,input buf_tt-th-fin-doc.payer-okpo           ,input buf_tt-th-fin-doc.payer-passport      ,input buf_tt-th-fin-doc.payer-r-schet        ,input buf_tt-th-fin-doc.payer-type           ,input buf_tt-th-fin-doc.perm-date            ,input buf_tt-th-fin-doc.prn-doc-code         ,input buf_tt-th-fin-doc.PS                   ,input buf_tt-th-fin-doc.receiver-bank-name   ,input buf_tt-th-fin-doc.receiver-bank-city   ,input buf_tt-th-fin-doc.receiver-bik         ,input buf_tt-th-fin-doc.receiver-c-schet     ,input buf_tt-th-fin-doc.receiver-code        ,input buf_tt-th-fin-doc.receiver-code-schet  ,input buf_tt-th-fin-doc.receiver-dop1        ,input buf_tt-th-fin-doc.receiver-dop2        ,input buf_tt-th-fin-doc.receiver-inn         ,input buf_tt-th-fin-doc.receiver-kpp         ,input buf_tt-th-fin-doc.receiver-name        ,input buf_tt-th-fin-doc.receiver-okpo        ,input buf_tt-th-fin-doc.receiver-passport    ,input buf_tt-th-fin-doc.receiver-r-schet     ,input buf_tt-th-fin-doc.receiver-type        ,input buf_tt-th-fin-doc.srok-pl              ,input buf_tt-th-fin-doc.stat-pl              ,input buf_tt-th-fin-doc.str-podr-code        ,input buf_tt-th-fin-doc.str-podr-type        ,input buf_tt-th-fin-doc.str-podr-name        ,input buf_tt-th-fin-doc.sum-base             ,input buf_tt-th-fin-doc.sum-doc              ,input buf_tt-th-fin-doc.sum-rubl             ,input buf_tt-th-fin-doc.sum-contr            ,input buf_tt-th-fin-doc.trn-doc-code         ,input buf_tt-th-fin-doc.vid-opl              ,input buf_tt-th-fin-doc.vid-plat
     3410             ,input buf_tt-th-fin-doc.con-sum-rubl         ,input buf_tt-th-fin-doc.con-sum-base         ,input buf_tt-th-fin-doc.con-sum-doc          ,input buf_tt-th-fin-doc.con-sum-contr        ,input buf_tt-th-fin-doc.con-stat             ,input buf_tt-th-fin-doc.payer-sign1                ,input buf_tt-th-fin-doc.payer-sign2                ,input buf_tt-th-fin-doc.payer-sign3                ,input buf_tt-th-fin-doc.payer-sign4                ,input buf_tt-th-fin-doc.receiver-sign1                ,input buf_tt-th-fin-doc.receiver-sign2                ,input buf_tt-th-fin-doc.receiver-sign3                ,input buf_tt-th-fin-doc.receiver-sign4                ,input buf_tt-th-fin-doc.obj-type                   ,input buf_tt-th-fin-doc.obj-code                   ,input buf_tt-th-fin-doc.doc-author                 ,input buf_tt-th-fin-doc.fact-author                ,input buf_tt-th-fin-doc.CashBookId
     3411             ,input table tt0-fin-doc-tax
     3412             ,input table tt0-fin-doc-attr
     3413             ,input no
     3414             ,input table tt0-payment
     3415       ) no-error.
     3416       if error-status:error then do:
     3417         undo, return error return-value .
     3418       end.
     3419       else do:
     3420         find first buf_fin-doc no-lock where recid(buf_fin-doc) = v-doc-rec.
     3421         assign
     3422         buf_tt-1s-fin-doc.fin-doc-code-th = buf_fin-doc.fin-doc-code.
     3423         assign
     3424         p-created = p-created + 1
     3425         .
     3426       end.
     3427       run cur-time in this-procedure(output v-today, output v-time).
     3428       run trg/findstat.p (
     3429                        input parparentproc
     3430                       ,input buf_fin-doc.host-code
     3431                       ,input buf_fin-doc.fin-doc-code
     3432                       ,input '<закрытие документа>':U
     3433                       ,input 'cl-bank'
     3434                       ,input 'разрешен':U
     3435                       ,input-output v-today
     3436                       ,input yes
     3437                                     ) no-error .
     3438       if error-status:error then do:
     3439           run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Документ &1 фирма &2&3Плательщик &4&3Получатель &5&3"  +                              'ОШИБКА ПРИ ЗАКРЫТИИ СОЗДАННОГО ДОКУМЕНТА ДО СТАТУСА РАЗРЕШЕН:&3&6&3&7'                                               , buf_tt-1s-fin-doc.prn-doc-code                                                           , p-host-code                                                                       , chr(10)                                                                     , buf_tt-1s-fin-doc.payer-name                                                            , buf_tt-1s-fin-doc.receiver-name                                                          , error-status:get-message(1)                                                         , return-value   )).
     3440           undo, return error .
     3441       end.
     3442       assign
     3443       buf_tt-1s-fin-doc.status_ = 'разрешен':U
     3444       buf_tt-1s-fin-doc.perm-date = v-today
     3445       buf_tt-th-fin-doc.status_ = 'разрешен':U
     3446       buf_tt-th-fin-doc.perm-date = v-today
     3447       .
     3448       run cur-time in this-procedure(output v-today, output v-time).
     3449       run trg/findstat.p (
     3450                        input parparentproc
     3451                       ,input buf_fin-doc.host-code
     3452                       ,input buf_fin-doc.fin-doc-code
     3453                       ,input '<закрытие документа>':U
     3454                       ,input 'cl-bank'
     3455                       ,input 'банк':U
     3456                       ,input-output v-today
     3457                       ,input yes
     3458                                     ) no-error .
     3459       if error-status:error then do:
     3460           run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input substitute("!!!Документ &1 фирма &2&3Плательщик &4&3Получатель &5&3"  +                              'ОШИБКА ПРИ ЗАКРЫТИИ СОЗДАННОГО ДОКУМЕНТА ДО СТАТУСА БАНК:&3&6&3&7'                                               , buf_tt-1s-fin-doc.prn-doc-code                                                           , p-host-code                                                                       , chr(10)                                                                     , buf_tt-1s-fin-doc.payer-name                                                            , buf_tt-1s-fin-doc.receiver-name                                                          , error-status:get-message(1)                                                         , return-value   )).
     3461           undo, return error .
     3462       end.
     3463       assign
     3464       buf_tt-1s-fin-doc.status_ = 'банк':U
     3465       buf_tt-1s-fin-doc.pay-date = v-today
     3466       buf_tt-th-fin-doc.status_ = 'банк':U
     3467       buf_tt-th-fin-doc.pay-date = v-today
     3468       .
     3469     end.
     3470   end procedure.
     3471   procedure proc-create-default-tax :
     3472   define parameter buffer buf_tt-fin-doc for tt-th-fin-doc.
     3473     do
     3474     on error undo, return error
     3475     :
     3476         find tt0-fin-doc-tax where
     3477                   tt0-fin-doc-tax.fin-doc-code = buf_tt-fin-doc.fin-doc-code
     3478             AND tt0-fin-doc-tax.host-code = buf_tt-fin-doc.host-code no-error .
     3479         if not avail tt0-fin-doc-tax
     3480         and not AMBIGUOUS tt0-fin-doc-tax
     3481         then do:
     3482           create tt0-fin-doc-tax.
     3483         end.
     3484         if AMBIGUOUS tt0-fin-doc-tax then return.
     3485         assign
     3486         tt0-fin-doc-tax.fin-doc-code = buf_tt-fin-doc.fin-doc-code
     3487         tt0-fin-doc-tax.host-code = buf_tt-fin-doc.host-code
     3488         tt0-fin-doc-tax.line-num  = 1
     3489         tt0-fin-doc-tax.slt-pc    = 0
     3490         tt0-fin-doc-tax.sum-line-doc = buf_tt-fin-doc.sum-doc
     3491         tt0-fin-doc-tax.sum-slt-line-doc = 0
     3492         tt0-fin-doc-tax.sum-vat-line-doc = 0
     3493         tt0-fin-doc-tax.vat-pc           = 0
     3494         tt0-fin-doc-tax.with-slt         = no
     3495         tt0-fin-doc-tax.with-vat         = no
     3496         tt0-fin-doc-tax.sum-line-doc     = buf_tt-fin-doc.sum-doc
     3497         .
     3498         release tt0-fin-doc-tax.
     3499     end.
     3500   end procedure.
     3501   procedure proc-insert-statement-lines :
     3502   define input parameter p-bh as handle no-undo .
     3503   define variable v-host-code as integer no-undo .
     3504   define variable v-start-date as date no-undo .
     3505   define variable v-end-date as date no-undo .
     3506   define variable v-mess as character no-undo .
     3507   define variable v-ii as integer no-undo .
     3508   define variable v-status_ as character no-undo .
     3509   define buffer buf_tt-1s-fin-doc for tt-1s-fin-doc.
     3510   define buffer buf_tt-th-fin-doc for tt-th-fin-doc.
     3511   define buffer buf_fin-doc for ub.fin-doc.
     3512   main-block:
     3513   do
     3514   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3515   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     3516   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     3517   :
     3518     assign
     3519     v-host-code = p-bh:buffer-field("host-code"):buffer-value
     3520     v-start-date = p-bh:buffer-field("start-date"):buffer-value
     3521     v-end-date = p-bh:buffer-field("end-date"):buffer-value
     3522     .
     3523     do v-ii = 1 to 2:
     3524       if v-ii = 1 then v-status_ = 'факт':U.
     3525       if v-ii = 2 then v-status_ = 'банк':U.
     3526       _line:
     3527       for each buf_tt-1s-fin-doc no-lock where
     3528             buf_tt-1s-fin-doc.host-code = v-host-code
     3529         and  buf_tt-1s-fin-doc.status_ = v-status_
     3530         and  buf_tt-1s-fin-doc.fact-date >= v-start-date
     3531         and  buf_tt-1s-fin-doc.fact-date <= v-end-date
     3532       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3533       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     3534       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     3535       :
     3536         if  not (buf_tt-1s-fin-doc.fin-ext-doc-type = 'рпп':U
     3537         and  buf_tt-1s-fin-doc.payer-code-schet = p-bh:buffer-field("code-schet"):buffer-value)
     3538         and  not (buf_tt-1s-fin-doc.fin-ext-doc-type = 'ппп':U
     3539         and buf_tt-1s-fin-doc.receiver-code-schet = p-bh:buffer-field("code-schet"):buffer-value)  then next _line.
     3540         find first buf_tt-th-fin-doc no-lock where
     3541                   buf_tt-th-fin-doc.host-code = p-host-code
     3542               and buf_tt-th-fin-doc.fin-doc-code = buf_tt-1s-fin-doc.fin-doc-code-th no-error.
     3543         if not available buf_tt-th-fin-doc
     3544         and p-create-no-th then do:
     3545           define variable v-line-rec as recid no-undo .
     3546           run ref/finsttml.p (
     3547                         INPUT NO
     3548                         ,INPUT-OUTPUT v-line-rec
     3549                         ,INPUT 'ДОБАВЛЕНИЕ':U
     3550                         ,INPUT p-bh:buffer-field("host-code"):buffer-value
     3551                         ,INPUT p-bh:buffer-field("sttm-code"):buffer-value
     3552                         ,INPUT 0
     3553                         ,INPUT buf_tt-1s-fin-doc.pay-date
     3554                         ,INPUT buf_tt-1s-fin-doc.prn-doc-code
     3555                         ,INPUT buf_tt-1s-fin-doc.fin-ext-doc-type
     3556                         ,input (if buf_tt-1s-fin-doc.fin-ext-doc-type = 'рпп':U
     3557                                then buf_tt-1s-fin-doc.receiver-bik
     3558                                else buf_tt-1s-fin-doc.payer-bik)
     3559                         ,input (if buf_tt-1s-fin-doc.fin-ext-doc-type = 'рпп':U
     3560                                then buf_tt-1s-fin-doc.receiver-bank-name
     3561                                else buf_tt-1s-fin-doc.payer-bank-name)
     3562                         ,input (if buf_tt-1s-fin-doc.fin-ext-doc-type = 'рпп':U
     3563                                then buf_tt-1s-fin-doc.receiver-bank-city
     3564                                else buf_tt-1s-fin-doc.payer-bank-city)
     3565                         ,input (if buf_tt-1s-fin-doc.fin-ext-doc-type = 'рпп':U
     3566                                then buf_tt-1s-fin-doc.receiver-c-schet
     3567                                else buf_tt-1s-fin-doc.payer-c-schet )
     3568                         ,input (if buf_tt-1s-fin-doc.fin-ext-doc-type = 'рпп':U
     3569                                then buf_tt-1s-fin-doc.receiver-r-schet
     3570                                else buf_tt-1s-fin-doc.payer-r-schet )
     3571                         ,input (if buf_tt-1s-fin-doc.fin-ext-doc-type = 'рпп':U
     3572                                then buf_tt-1s-fin-doc.receiver-name
     3573                                else buf_tt-1s-fin-doc.payer-name )
     3574                         ,input (if buf_tt-1s-fin-doc.fin-ext-doc-type = 'рпп':U
     3575                                then buf_tt-1s-fin-doc.receiver-inn
     3576                                else buf_tt-1s-fin-doc.payer-inn )
     3577                         ,input (if buf_tt-1s-fin-doc.fin-ext-doc-type = 'рпп':U
     3578                                then buf_tt-1s-fin-doc.receiver-kpp
     3579                                else buf_tt-1s-fin-doc.payer-kpp )
     3580                         ,INPUT buf_tt-1s-fin-doc.sum-doc
     3581                         ,INPUT '1s':U
     3582                         ,input buf_tt-1s-fin-doc.naznach-plat
     3583                           )
     3584               no-error.
     3585           if error-status:error then do:
     3586             v-mess = substitute("Ошибка при включении в выписку импортированного платежа&1" +
     3587                                 "Выписка &2 Фирма &3&1Счет &4 БИК &5&1"
     3588                                 ,chr(10)
     3589                                 ,cbnki-period-to-String(p-bh:buffer-field("start-date"):buffer-value, p-bh:buffer-field("end-date"):buffer-value)
     3590                                 ,p-bh:buffer-field("hostcode"):buffer-value
     3591                                 ,p-bh:buffer-field("r-schet"):buffer-value
     3592                                 ,p-bh:buffer-field("bik"):buffer-value)  +
     3593                      substitute("Документ &1&2&3&2&4"
     3594                                 , buf_tt-1s-fin-doc.prn-doc-code
     3595                                 ,chr(10)
     3596                                 , error-status:get-message(1)
     3597                                 , return-value )   .
     3598             run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input v-mess).
     3599             undo _line, next _line.
     3600           end.
     3601         end.
     3602         else do:
     3603           find first buf_fin-doc no-lock where
     3604                     buf_fin-doc.host-code = v-host-code
     3605                 and buf_fin-doc.fin-doc-code = buf_tt-th-fin-doc.fin-doc-code no-error.
     3606           if not available buf_fin-doc then do:
     3607           end.
     3608           if buf_fin-doc.sttm-code = 0 then do:
     3609             run ref/finsttml.p (
     3610                            INPUT NO
     3611                           ,INPUT-OUTPUT v-line-rec
     3612                           ,INPUT 'ДОБАВЛЕНИЕ':U
     3613                           ,INPUT p-bh:buffer-field("host-code"):buffer-value
     3614                           ,INPUT p-bh:buffer-field("sttm-code"):buffer-value
     3615                           ,INPUT buf_tt-th-fin-doc.fin-doc-code
     3616                           ,INPUT buf_tt-th-fin-doc.pay-date
     3617                           ,INPUT buf_tt-th-fin-doc.prn-doc-code
     3618                           ,INPUT buf_tt-th-fin-doc.fin-ext-doc-type
     3619                           ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     3620                                 then buf_fin-doc.receiver-bik
     3621                                 else buf_fin-doc.payer-bik)
     3622                           ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     3623                                 then buf_fin-doc.receiver-bank-name
     3624                                 else buf_fin-doc.payer-bank-name)
     3625                           ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     3626                                 then buf_fin-doc.receiver-bank-city
     3627                                 else buf_fin-doc.payer-bank-city)
     3628                           ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     3629                                 then buf_fin-doc.receiver-c-schet
     3630                                 else buf_fin-doc.payer-c-schet )
     3631                           ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     3632                                 then buf_fin-doc.receiver-r-schet
     3633                                 else buf_fin-doc.payer-r-schet )
     3634                           ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     3635                                 then buf_fin-doc.receiver-name
     3636                                 else buf_fin-doc.payer-name )
     3637                           ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     3638                                 then buf_fin-doc.receiver-inn
     3639                                 else buf_fin-doc.payer-inn )
     3640                           ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     3641                                 then buf_fin-doc.receiver-kpp
     3642                                 else buf_fin-doc.payer-kpp )
     3643                           ,INPUT buf_tt-th-fin-doc.sum-doc
     3644                           ,INPUT '1s':U
     3645                           ,input buf_tt-th-fin-doc.ps
     3646                             )
     3647                 no-error.
     3648             if error-status:error then do:
     3649               v-mess = substitute("Ошибка при включении в выписку импортированного платежа&1" +
     3650                                   "Выписка &2 Фирма &3&1Счет &4 БИК &5&1"
     3651                                   ,chr(10)
     3652                                   ,cbnki-period-to-String(p-bh:buffer-field("start-date"):buffer-value, p-bh:buffer-field("end-date"):buffer-value)
     3653                                   ,p-bh:buffer-field("hostcode"):buffer-value
     3654                                   ,p-bh:buffer-field("r-schet"):buffer-value
     3655                                   ,p-bh:buffer-field("bik"):buffer-value) +
     3656                       substitute("Документ &1&2&3&2&4"
     3657                                   , buf_tt-1s-fin-doc.prn-doc-code
     3658                                   ,chr(10)
     3659                                   , error-status:get-message(1)
     3660                                   , return-value ).
     3661             run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input v-mess).
     3662               undo _line, next _line.
     3663             end.
     3664           end.
     3665           else do:
     3666             if  buf_fin-doc.sttm-code = p-bh:buffer-field("sttm-code"):buffer-value then do:
     3667               next _line.
     3668             end.
     3669             else do:
     3670               v-mess = substitute("Не удалось включить в выписку импортированный платеж&1" +
     3671                                   "&1Платеж уже привязан к другой выписке" +
     3672                                   "Выписка &2 Фирма &3&1Счет &4 БИК &5&1"
     3673                                   ,chr(10)
     3674                                   ,cbnki-period-to-String(p-bh:buffer-field("start-date"):buffer-value, p-bh:buffer-field("end-date"):buffer-value)
     3675                                   ,p-bh:buffer-field("hostcode"):buffer-value
     3676                                   ,p-bh:buffer-field("r-schet"):buffer-value
     3677                                   ,p-bh:buffer-field("bik"):buffer-value) +
     3678                       substitute("Документ &1&2&3&2&4"
     3679                                   , buf_tt-1s-fin-doc.prn-doc-code
     3680                                   ,chr(10)
     3681                                   , error-status:get-message(1)
     3682                                   , return-value ).
     3683             run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input v-mess).
     3684               undo _line, next _line.
     3685             end.
     3686           end.
     3687         end.
     3688       end.
     3689     end.
     3690     _line2:
     3691     for each buf_fin-doc no-lock where
     3692           buf_fin-doc.host-code = v-host-code
     3693       and  buf_fin-doc.status_ = 'факт':U
     3694       and  buf_fin-doc.fact-date >= v-start-date
     3695       and  buf_fin-doc.fact-date <= v-end-date
     3696     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3697     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     3698     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     3699     :
     3700       if  not (buf_fin-doc.fin-ext-doc-type = 'рпп':U
     3701       and  buf_fin-doc.payer-code-schet = p-bh:buffer-field("code-schet"):buffer-value)
     3702       and  not (buf_fin-doc.fin-ext-doc-type = 'ппп':U
     3703       and buf_fin-doc.receiver-code-schet = p-bh:buffer-field("code-schet"):buffer-value)  then next _line2.
     3704       if buf_fin-doc.sttm-code = 0 then do:
     3705         run ref/finsttml.p (
     3706                         INPUT NO
     3707                       ,INPUT-OUTPUT v-line-rec
     3708                       ,INPUT 'ДОБАВЛЕНИЕ':U
     3709                       ,INPUT p-bh:buffer-field("host-code"):buffer-value
     3710                       ,INPUT p-bh:buffer-field("sttm-code"):buffer-value
     3711                       ,INPUT buf_fin-doc.fin-doc-code
     3712                       ,INPUT buf_fin-doc.pay-date
     3713                       ,INPUT buf_fin-doc.prn-doc-code
     3714                       ,INPUT buf_fin-doc.fin-ext-doc-type
     3715                       ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     3716                             then buf_fin-doc.receiver-bik
     3717                             else buf_fin-doc.payer-bik)
     3718                       ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     3719                             then buf_fin-doc.receiver-bank-name
     3720                             else buf_fin-doc.payer-bank-name)
     3721                       ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     3722                             then buf_fin-doc.receiver-bank-city
     3723                             else buf_fin-doc.payer-bank-city)
     3724                       ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     3725                             then buf_fin-doc.receiver-c-schet
     3726                             else buf_fin-doc.payer-c-schet )
     3727                       ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     3728                             then buf_fin-doc.receiver-r-schet
     3729                             else buf_fin-doc.payer-r-schet )
     3730                       ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     3731                             then buf_fin-doc.receiver-name
     3732                             else buf_fin-doc.payer-name )
     3733                       ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     3734                             then buf_fin-doc.receiver-inn
     3735                             else buf_fin-doc.payer-inn )
     3736                       ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     3737                             then buf_fin-doc.receiver-kpp
     3738                             else buf_fin-doc.payer-kpp )
     3739                       ,INPUT buf_fin-doc.sum-doc
     3740                       ,INPUT '1s':U
     3741                       ,input buf_fin-doc.ps
     3742                         )
     3743             no-error.
     3744         if error-status:error then do:
     3745           v-mess = substitute("Ошибка при включении платежа в выписку&1" +
     3746                               "Выписка &2 Фирма &3&1Счет &4 БИК &5&1"
     3747                               ,chr(10)
     3748                               ,cbnki-period-to-String(p-bh:buffer-field("start-date"):buffer-value, p-bh:buffer-field("end-date"):buffer-value)
     3749                               ,p-bh:buffer-field("hostcode"):buffer-value
     3750                               ,p-bh:buffer-field("r-schet"):buffer-value
     3751                               ,p-bh:buffer-field("bik"):buffer-value) +
     3752                   substitute("Документ &1&2&3&2&4"
     3753                               , buf_tt-1s-fin-doc.prn-doc-code
     3754                               ,chr(10)
     3755                               , error-status:get-message(1)
     3756                               , return-value ).
     3757         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input v-mess).
     3758           undo _line2, next _line2.
     3759         end.
     3760       end.
     3761       else do:
     3762         if  buf_fin-doc.sttm-code = p-bh:buffer-field("sttm-code"):buffer-value then do:
     3763           next _line2.
     3764         end.
     3765         else do:
     3766           v-mess = substitute("Не удалось включить платеж в выписку&1" +
     3767                               "&1Платеж уже привязан к другой выписке" +
     3768                               "Выписка &2 Фирма &3&1Счет &4 БИК &5&1"
     3769                               ,chr(10)
     3770                               ,cbnki-period-to-String(p-bh:buffer-field("start-date"):buffer-value, p-bh:buffer-field("end-date"):buffer-value)
     3771                               ,p-bh:buffer-field("hostcode"):buffer-value
     3772                               ,p-bh:buffer-field("r-schet"):buffer-value
     3773                               ,p-bh:buffer-field("bik"):buffer-value) +
     3774                   substitute("Документ &1&2&3&2&4"
     3775                               , buf_tt-1s-fin-doc.prn-doc-code
     3776                               ,chr(10)
     3777                               , error-status:get-message(1)
     3778                               , return-value ).
     3779         run write-log-and-file in p-log-handle (                                                                                               input 1                                                                                    , input log-file-name                                                                        , input 1                                                                                    , input v-mess).
     3780           undo _line2, next _line2.
     3781         end.
     3782       end.
     3783     end.
     3784   end.
     3785   end procedure.
     3786   procedure proc-create-fin-statement :
     3787   define parameter buffer buf_tt-th-fin-statement for tt-th-fin-statement.
     3788   define variable v-doc-rec as recid no-undo .
     3789   DEFINE VARIABLE v-today as date no-undo .
     3790   DEFINE VARIABLE v-time as integer no-undo .
     3791   define buffer buf_fin-statement for ub.fin-statement.
     3792     do
     3793     on error undo, return error
     3794     :
     3795       run cur-time in this-procedure ( output v-today, output v-time).
     3796       assign
     3797       buf_tt-th-fin-statement.prn-doc-code = cbnki-period-to-String(tt-th-fin-statement.start-date
     3798                                                                     ,tt-th-fin-statement.end-date)
     3799       buf_tt-th-fin-statement.status_      = 'новый':U
     3800       buf_tt-th-fin-statement.doc-date     = v-today
     3801       buf_tt-th-fin-statement.sum-doc      = buf_tt-th-fin-statement.in-sum-doc - buf_tt-th-fin-statement.out-sum-doc
     3802       buf_tt-th-fin-statement.fins-ext-doc-type = 'стд':U
     3803       .
     3804    run ref/finsttm0.p
     3805                    (input yes
     3806                    ,input-output v-doc-rec
     3807                    ,input  'ДОБАВЛЕНИЕ':U
     3808                    ,input  '1s':U
     3809                    ,input buf_tt-th-fin-statement.host-code            ,input buf_tt-th-fin-statement.sttm-code            ,input buf_tt-th-fin-statement.curr-code            ,input buf_tt-th-fin-statement.doc-date             ,input buf_tt-th-fin-statement.bank-date            ,input buf_tt-th-fin-statement.fact-date            ,input buf_tt-th-fin-statement.fins-doc-type        ,input buf_tt-th-fin-statement.fins-ext-doc-type    ,input buf_tt-th-fin-statement.code-bank            ,input buf_tt-th-fin-statement.bank-name            ,input buf_tt-th-fin-statement.bank-city            ,input buf_tt-th-fin-statement.bik                  ,input buf_tt-th-fin-statement.code-schet           ,input buf_tt-th-fin-statement.r-schet              ,input buf_tt-th-fin-statement.c-schet              ,input buf_tt-th-fin-statement.cli-name             ,input buf_tt-th-fin-statement.prn-doc-code         ,input buf_tt-th-fin-statement.PS                   ,input buf_tt-th-fin-statement.sum-doc              ,input buf_tt-th-fin-statement.start-sum-doc-th     ,input buf_tt-th-fin-statement.start-sum-doc        ,input buf_tt-th-fin-statement.in-sum-doc           ,input buf_tt-th-fin-statement.out-sum-doc          ,input buf_tt-th-fin-statement.end-sum-doc          ,input buf_tt-th-fin-statement.num-docs             ,input buf_tt-th-fin-statement.start-date           ,input buf_tt-th-fin-statement.end-date
     3810                    ,input buf_tt-th-fin-statement.status_
     3811                    ,input no
     3812                    ) no-error .
     3813       if error-status:error then do:
     3814         undo, return error return-value .
     3815       end.
     3816       else do:
     3817         assign
     3818         p-created-statement = p-created-statement + 1
     3819         .
     3820         find first buf_fin-statement no-lock where
     3821                   recid(buf_fin-statement) = v-doc-rec.
     3822         assign
     3823         buf_tt-th-fin-statement.sttm-code = buf_fin-statement.sttm-code
     3824         .
     3825       end.
     3826     end.
     3827   end procedure.
