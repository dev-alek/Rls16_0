      117   procedure init-host-list :
      118   define input parameter p-host-list as character no-undo .
      119   define variable v-counter as integer no-undo .
      120   define buffer buf_temp_obj-list for temp_obj-list.
      121     do
      122     on error undo, return error
      123     :
      124     for each buf_temp_obj-list
      125     :
      126         delete buf_temp_obj-list.
      127     end.
      128     do v-counter = 1 to num-entries( p-host-list ) / 2
      129     :
      130         create buf_temp_obj-list.
      131         assign
      132             buf_temp_obj-list.obj-type = entry( 2 * v-counter - 1,  p-host-list )
      133             buf_temp_obj-list.obj-code = integer( entry( 2 * v-counter,      p-host-list ) )
      134         .
      135     end.
      136     end.
      137   end procedure.
      138   procedure fill-hfin-schet :
      139   define input parameter p-hfin-schet as character no-undo .
      140   define variable v-counter as integer no-undo .
      141   define buffer buf_temp_hfin-schet for temp_hfin-schet.
      142     do
      143     on error undo, return error return-value
      144     :
      145         for each buf_temp_hfin-schet
      146         :
      147             delete buf_temp_hfin-schet.
      148         end.
      149         do v-counter = 1 to num-entries( p-hfin-schet ) / 6
      150         :
      151             create buf_temp_hfin-schet.
      152             assign
      153             buf_temp_hfin-schet.host-code = integer( entry( 6 * v-counter - 5,      p-hfin-schet ) )
      154             buf_temp_hfin-schet.r-schet = entry( 6 * v-counter - 4,  p-hfin-schet )
      155             buf_temp_hfin-schet.cli-type =  entry( 6 * v-counter - 3,      p-hfin-schet )
      156             buf_temp_hfin-schet.cli-code = integer( entry( 6 * v-counter - 2,      p-hfin-schet ) )
      157             buf_temp_hfin-schet.code-bank = integer( entry( 6 * v-counter - 1,      p-hfin-schet ) )
      158             buf_temp_hfin-schet.code-schet = integer( entry( 6 * v-counter,      p-hfin-schet ) )
      159             .
      160         end.
      161     end.
      162   end procedure.
