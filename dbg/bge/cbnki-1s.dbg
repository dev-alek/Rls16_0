       15   define output parameter p-processed as integer no-undo .
       16   define output parameter p-created as integer no-undo .
       17   define output parameter p-count-statement as integer no-undo .
       18   define output parameter p-processed-statement as integer no-undo .
       19   define output parameter p-created-statement as integer no-undo .
       20   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       21   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       22   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       23   define variable vss-workfile    as character no-undo init "$Workfile: cbnki-1s.p $":U .
       24   define variable vss-archive     as character no-undo init "$Archive: bge/cbnki-1s.p $":U .
       25   define variable vss-description as character no-undo init "Разбор файла системы КЛИЕНТ-БАНК формата 1s".
       26   procedure vss-get-info :
       27     define output parameter p-vss-revision    like vss-revision    no-undo .
       28     define output parameter p-vss-author      like vss-author      no-undo .
       29     define output parameter p-vss-date        like vss-date        no-undo .
       30     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       31     define output parameter p-vss-archive     like vss-archive     no-undo .
       32     define output parameter p-vss-description like vss-description no-undo .
       33     assign
       34       p-vss-revision    = vss-revision
       35       p-vss-author      = vss-author
       36       p-vss-date        = vss-date
       37       p-vss-workfile    = vss-workfile
       38       p-vss-archive     = vss-archive
       39       p-vss-description = vss-description
       40     .
