     3166     delete object browse-hdl-wb-egais-header.
     3167     delete object browse-hdl-wb-egais.
     3168     create query gh-wb-egais-header.
     3169     create browse browse-hdl-wb-egais-header
     3170       assign
     3171       title     = 'Накладная ЕГАИС'
     3172       frame     = frame Dialog-Frame:handle
     3173       query     = gh-wb-egais-header
     3174       x         = 10
     3175       y         = 42
     3176       width     = 119
     3177       height    = 5
     3178       visible   = true
     3179       read-only = true
     3180       sensitive = true
     3181       separators = true
     3182       column-resizable = true
     3183       .
     3184     create query gh-wb-egais.
     3185     create browse browse-hdl-wb-egais
     3186       assign
     3187       title     = 'Список товаров ЕГАИС'
     3188       frame     = frame Dialog-Frame:handle
     3189       query     = gh-wb-egais
     3190       x         = 10
     3191       y         = 102
     3192       width     = 119
     3193       height    = 22
     3194       visible   = true
     3195       read-only = true
     3196       sensitive = true
     3197       separators = true
     3198       column-resizable = true
     3199       triggers:
     3200         on mouse-move-dblclick persistent run msdblcl.
     3201         on row-display persistent run proc-row-leave.
     3202       end triggers
     3203       .
     3204     egais:GetHndlTable(1, bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value).
     3205     if egais:StatusErr
     3206     then do:
     3207       message egais:Msg view-as alert-box error.
     3208       return no-apply.
     3209     end.
     3210     bh-wb-gds-EG-header = cast (egais:EGAISImpl, ibs.th.bge.egais.WayBill):HndlHeader.
     3211     bh-wb-gds-EG = cast (egais:EGAISImpl, ibs.th.bge.egais.WayBill):HndlLine.
     3212     gh-wb-egais-header:set-buffers (bh-wb-gds-EG-header).
     3213     gh-wb-egais-header:query-prepare ("for each tt-wb-header").
     3214     gh-wb-egais-header:query-open.
     3215     do ii = 1 to bh-wb-gds-EG-header:num-fields:
     3216       bcol-h[ii] = browse-hdl-wb-egais-header:add-like-column('tt-wb-header' + '.' + bh-wb-gds-EG-header:buffer-field (ii):name, 0, 'FILL-IN').
     3217       if ii = 6 then bcol-h[ii]:width = 20.
     3218     end.
     3219     gh-wb-egais:set-buffers (bh-wb-gds-EG).
     3220     gh-wb-egais:query-prepare ("for each tt-wb-gds-EG by nn").
     3221     gh-wb-egais:query-open.
     3222     do ii = 1 to bh-wb-gds-EG:num-fields:
     3223       bcol[ii] = browse-hdl-wb-egais:add-like-column('tt-wb-gds-EG' + '.' + bh-wb-gds-EG:buffer-field (ii):name, 0, 'FILL-IN').
     3224       if ii = 2 then bcol[ii]:width = 50.
     3225       if ii = 8 then bcol[ii]:width = 20.
     3226     end.
     3227     run refresh-view.
     3228   end.
     3229   PROCEDURE refresh-view :
     3230     f-cons = bh-wb-gds-EG-header:buffer-field ("clientCons"):buffer-value.
     3231     f-ship = bh-wb-gds-EG-header:buffer-field ("client"):buffer-value.
     3232     display Btn_Cancel f-cons F-ship b-choose-cons b-choose-ship btn_conn with frame Dialog-Frame.
     3233     ENABLE Btn_Cancel b-choose-cons btn_conn
     3234       WITH FRAME Dialog-Frame.
     3235     VIEW FRAME Dialog-Frame.
     3236     bh-wb-gds-EG:find-first ().
     3237     if bh-wb-gds-EG-header:buffer-field ("client"):buffer-value <> ""
     3238       then disable b-choose-ship with frame Dialog-Frame.
     3239     browse-hdl-wb-egais:refresh ().
     3240     browse-hdl-wb-egais-header:refresh ().
     3241   end.
     3242   PROCEDURE proc-row-leave :
     3243     def var ii as int no-undo.
     3244     do ii = 1 to extent (bcol):
     3245       if valid-handle (bcol[ii]) and bh-wb-gds-EG:buffer-field ("color-sts"):buffer-value <> ?
     3246         then bcol[ii]:bgcolor = bh-wb-gds-EG:buffer-field ("color-sts"):buffer-value.
     3247     end.
     3248   end.
