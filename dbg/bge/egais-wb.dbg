     1456   DEFINE BUTTON b-choose-cons
     1457     IMAGE-UP FILE "btn-down-arrow":U
     1458     IMAGE-DOWN FILE "btn-down-arrow":U
     1459     IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1460     LABEL "b-choose-date-pov-plotn"
     1461     SIZE 3 BY 1.
     1462   DEFINE BUTTON b-choose-ship
     1463     IMAGE-UP FILE "btn-down-arrow":U
     1464     IMAGE-DOWN FILE "btn-down-arrow":U
     1465     IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1466     LABEL "b-choose-ship"
     1467     SIZE 3 BY 1.
     1468   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
     1469     LABEL "Выход"
     1470     SIZE 15 BY 1.13
     1471     BGCOLOR 8 .
     1472   DEFINE BUTTON btn_conn
     1473     LABEL "Связать"
     1474     SIZE 15 BY 1.13.
     1475   DEFINE VARIABLE f-cons AS CHARACTER FORMAT "X(256)":U
     1476     LABEL "Объект"
     1477     VIEW-AS FILL-IN
     1478     SIZE 14 BY 1 NO-UNDO.
     1479   DEFINE VARIABLE F-ship AS CHARACTER FORMAT "X(256)":U
     1480     LABEL "Контрагент"
     1481     VIEW-AS FILL-IN
     1482     SIZE 14 BY 1 NO-UNDO.
     1483   DEFINE FRAME Dialog-Frame
     1484     Btn_Cancel AT ROW 1.25 COL 2
     1485     btn_conn AT ROW 1.25 COL 18.5 WIDGET-ID 78
     1486     b-choose-ship AT ROW 1.25 COL 61 WIDGET-ID 76
     1487     F-ship AT ROW 1.29 COL 44.5 COLON-ALIGNED WIDGET-ID 2
     1488     f-cons AT ROW 1.29 COL 72.38 COLON-ALIGNED WIDGET-ID 4
     1489     b-choose-cons AT ROW 1.29 COL 89.5 WIDGET-ID 74
     1490     SPACE(29.00) SKIP(25.28)
     1491     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1492     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1493     TITLE "Накладная ЕГАИС"
     1494     CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
     1495   ASSIGN
     1496     FRAME Dialog-Frame:SCROLLABLE = FALSE
     1497     FRAME Dialog-Frame:HIDDEN     = TRUE.
     1498   ASSIGN
     1499     b-choose-cons:HIDDEN IN FRAME Dialog-Frame = TRUE.
     1500   ASSIGN
     1501     b-choose-ship:HIDDEN IN FRAME Dialog-Frame = TRUE.
     1502   ON window-close OF FRAME Dialog-Frame
     1503     do:
     1504       apply "END-ERROR":U to self.
     1505     end.
     1506   ON CHOOSE OF b-choose-cons IN FRAME Dialog-Frame
     1507     DO:
     1508       def var v-old-regId as char no-undo init ?.
     1509       find first X_ext-classif no-lock  where X_ext-classif.classif-subject = 'clients':U
     1510         and X_ext-classif.classif-name = 'clients-esys':U
     1511         and X_ext-classif.db-num = 0
     1512         and X_ext-classif.key#_one = v-ext-sys
     1513         and X_eXt-classif.CharKey_Three = bh-wb-gds-EG-header:buffer-field ("regID-cons"):buffer-value
     1514         and X_eXt-classif.CharKey_Two <> ""
     1515         no-error.
     1516       if available (X_eXt-classif)
     1517         then v-old-regId = X_eXt-classif.CharKey_Three.
     1518       run gbl/userobjs.w (
     1519         input parparentproc
     1520         , input this-procedure :handle
     1521         , input v-db-num
     1522         , input v-user-id
     1523         , input v-cntxt-host-code-obj
     1524         , input v-cntxt-obj-type
     1525         , input v-cntxt-obj-code
     1526         , input 'b-sel'
     1527         , output v-user-select
     1528         , output v-select-obj-type
     1529         , output v-select-obj-code
     1530         ) no-error.
     1531       find first buf_clients no-lock where buf_clients.obj-type = v-select-obj-type and buf_clients.obj-code = v-select-obj-code no-error.
     1532       if not available (buf_clients)
     1533         then return no-apply.
     1534       run gen-key-rec in this-procedure   ( input 'clients':U
     1535         ,input buffer buf_clients:handle
     1536         ,output v-obj-uniq-key-rec).
     1537       find first X_ext-classif no-lock  where X_ext-classif.classif-subject = 'clients':U
     1538         and X_ext-classif.classif-name = 'clients-esys':U
     1539         and X_ext-classif.db-num = 0
     1540         and X_ext-classif.key#_one = v-ext-sys
     1541         and X_eXt-classif.uniq-key-rec = v-obj-uniq-key-rec
     1542         no-error.
     1543       if v-old-regId = ? then do:
     1544         run ref/extclas1.p ( input 'ДОБАВЛЕНИЕ':U
     1545           ,input yes
     1546           ,input-output v-rid
     1547           ,input 'clients':U
     1548           ,input 'clients-esys':U
     1549           ,input 0
     1550           ,input v-ext-sys
     1551           ,input 0
     1552           ,input 0
     1553           ,input '':U
     1554           ,input buf_clients.obj-type + string (buf_clients.obj-code)
     1555           ,input bh-wb-gds-EG-header:buffer-field ("regID-cons"):buffer-value
     1556           ,input 0
     1557           ,input v-obj-uniq-key-rec ) no-error.
     1558         if error-status:error then
     1559         do:
     1560           message return-value " " error-status:get-message(1) view-as alert-box .
     1561           undo, return no-apply .
     1562         end.
     1563       end.
     1564       else do:
     1565         if not available (x_ext-classif) or v-old-regId <> X_eXt-classif.CharKey_Three
     1566         then do:
     1567           message 'Нельзя выбрать объект с другим кодом ЕГАИС' view-as alert-box.
     1568           return no-apply.
     1569         end.
     1570       end.
     1571       do trans:
     1572         find first ub.clob-bind where ub.clob-bind.uniq-key-rec = v-uniq-key-rec and ub.clob-bind.field-name_ = 'egais-wb':U.
     1573         entry (9, ub.clob-bind.descr, chr(4)) = buf_clients.obj-type + string (buf_clients.obj-code).
     1574         bh-wb-egais:buffer-field ("obj"):buffer-value = buf_clients.obj-type + string (buf_clients.obj-code).
     1575         release ub.clob-bind.
     1576       end.
     1577       delete object browse-hdl-wb-egais-header.
     1578       delete object browse-hdl-wb-egais.
     1579       create query gh-wb-egais-header.
     1580       create browse browse-hdl-wb-egais-header
     1581         assign
     1582         title     = 'Накладная ЕГАИС'
     1583         frame     = frame Dialog-Frame:handle
     1584         query     = gh-wb-egais-header
     1585         x         = 10
     1586         y         = 42
     1587         width     = 119
     1588         height    = 5
     1589         visible   = true
     1590         read-only = true
     1591         sensitive = true
     1592         separators = true
     1593         column-resizable = true
     1594         .
     1595       create query gh-wb-egais.
     1596       create browse browse-hdl-wb-egais
     1597         assign
     1598         title     = 'Список товаров ЕГАИС'
     1599         frame     = frame Dialog-Frame:handle
     1600         query     = gh-wb-egais
     1601         x         = 10
     1602         y         = 102
     1603         width     = 119
     1604         height    = 22
     1605         visible   = true
     1606         read-only = true
     1607         sensitive = true
     1608         separators = true
     1609         column-resizable = true
     1610         triggers:
     1611           on mouse-move-dblclick persistent run msdblcl.
     1612           on row-display persistent run proc-row-leave.
     1613         end triggers
     1614         .
     1615       egais:GetHndlTable(1, bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value).
     1616       if egais:StatusErr
     1617       then do:
     1618         message egais:Msg view-as alert-box error.
     1619         return no-apply.
     1620       end.
     1621       bh-wb-gds-EG-header = cast (egais:EGAISImpl, ibs.th.bge.egais.WayBill):HndlHeader.
     1622       bh-wb-gds-EG = cast (egais:EGAISImpl, ibs.th.bge.egais.WayBill):HndlLine.
     1623       gh-wb-egais-header:set-buffers (bh-wb-gds-EG-header).
     1624       gh-wb-egais-header:query-prepare ("for each tt-wb-header").
     1625       gh-wb-egais-header:query-open.
     1626       do ii = 1 to bh-wb-gds-EG-header:num-fields:
     1627         bcol-h[ii] = browse-hdl-wb-egais-header:add-like-column('tt-wb-header' + '.' + bh-wb-gds-EG-header:buffer-field (ii):name, 0, 'FILL-IN').
     1628         if ii = 6 then bcol-h[ii]:width = 20.
     1629       end.
     1630       gh-wb-egais:set-buffers (bh-wb-gds-EG).
     1631       gh-wb-egais:query-prepare ("for each tt-wb-gds-EG by nn").
     1632       gh-wb-egais:query-open.
     1633       do ii = 1 to bh-wb-gds-EG:num-fields:
     1634         bcol[ii] = browse-hdl-wb-egais:add-like-column('tt-wb-gds-EG' + '.' + bh-wb-gds-EG:buffer-field (ii):name, 0, 'FILL-IN').
     1635         if ii = 2 then bcol[ii]:width = 50.
     1636         if ii = 8 then bcol[ii]:width = 20.
     1637       end.
     1638       run refresh-view.
     1639     END.
     1640   ON CHOOSE OF b-choose-ship IN FRAME Dialog-Frame
     1641     DO:
     1642       def var v-rid-list as character no-undo.
     1643     END.
     1644   ON CHOOSE OF btn_conn IN FRAME Dialog-Frame
     1645     DO:
     1646       if bh-wb-gds-EG = ?
     1647         then
     1648       do:
     1649         message "Не выбран товар" view-as alert-box.
     1650         return no-apply.
     1651       end.
     1652       run msdblcl.
     1653     END.
     1654   if valid-handle(active-window) and frame Dialog-Frame:PARENT eq ?
     1655     then frame Dialog-Frame:PARENT = active-window.
     1656   MAIN-BLOCK:
     1657   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
     1658     on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
     1659     extGdsObj = new ExtGds(true).
     1660   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1661   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
     1662     (output v-db-num
     1663     ,output v-user-id
     1664     ) no-error .
     1665   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1666     run mainmenu_getcntxt in parparentproc
     1667       (output v-cntxt-db-num
     1668       ,output v-cntxt-userid
     1669       ,output v-cntxt-level
     1670       ,output v-cntxt-host-code-obj
     1671       ,output v-cntxt-obj-type
     1672       ,output v-cntxt-obj-code
     1673       ,output v-cntxt-db-num-obj
     1674       ,output v-cntxt-is-admin
     1675       ) .
     1676     find first ub.ext-system where ub.ext-system.delivery-method = integer ('10':U).
     1677     assign
     1678       v-ext-sys = ub.ext-system.esys-id .
     1679     create query gh-wb-egais-header.
     1680     create browse browse-hdl-wb-egais-header
     1681       assign
     1682       title     = 'Накладная ЕГАИС'
     1683       frame     = frame Dialog-Frame:handle
     1684       query     = gh-wb-egais-header
     1685       x         = 10
     1686       y         = 42
     1687       width     = 119
     1688       height    = 5
     1689       visible   = true
     1690       read-only = true
     1691       sensitive = true
     1692       separators = true
     1693       column-resizable = true
     1694       .
     1695     create query gh-wb-egais.
     1696     create browse browse-hdl-wb-egais
     1697       assign
     1698       title     = 'Список товаров ЕГАИС'
     1699       frame     = frame Dialog-Frame:handle
     1700       query     = gh-wb-egais
     1701       x         = 10
     1702       y         = 102
     1703       width     = 119
     1704       height    = 22
     1705       visible   = true
     1706       read-only = true
     1707       sensitive = true
     1708       separators = true
     1709       column-resizable = true
     1710       triggers:
     1711         on mouse-move-dblclick persistent run msdblcl.
     1712         on row-display persistent run proc-row-leave.
     1713       end triggers
     1714       .
     1715     egais:GetHndlTable(1, bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value).
     1716     if egais:StatusErr
     1717     then do:
     1718       message egais:Msg view-as alert-box error.
     1719       return no-apply.
     1720     end.
     1721     bh-wb-gds-EG-header = cast (egais:EGAISImpl, ibs.th.bge.egais.WayBill):HndlHeader.
     1722     bh-wb-gds-EG = cast (egais:EGAISImpl, ibs.th.bge.egais.WayBill):HndlLine.
     1723     gh-wb-egais-header:set-buffers (bh-wb-gds-EG-header).
     1724     gh-wb-egais-header:query-prepare ("for each tt-wb-header").
     1725     gh-wb-egais-header:query-open.
     1726     extent (bcol-h) = bh-wb-gds-EG-header:num-fields.
     1727     do ii = 1 to bh-wb-gds-EG-header:num-fields:
     1728       bcol-h[ii] = browse-hdl-wb-egais-header:add-like-column('tt-wb-header' + '.' + bh-wb-gds-EG-header:buffer-field (ii):name, 0, 'FILL-IN').
     1729       if ii = 6 then bcol-h[ii]:width = 20.
     1730     end.
     1731     gh-wb-egais:set-buffers (bh-wb-gds-EG).
     1732     gh-wb-egais:query-prepare ("for each tt-wb-gds-EG by nn").
     1733     gh-wb-egais:query-open.
     1734     extent (bcol) = bh-wb-gds-EG:num-fields.
     1735     do ii = 1 to bh-wb-gds-EG:num-fields:
     1736       bcol[ii] = browse-hdl-wb-egais:add-like-column('tt-wb-gds-EG' + '.' + bh-wb-gds-EG:buffer-field (ii):name, 0, 'FILL-IN').
     1737       if ii = 2 then bcol[ii]:width = 50.
     1738       if ii = 8 then bcol[ii]:width = 20.
     1739     end.
     1740   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1741   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1742   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1743   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1744   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1745   define variable v-diasize-current-frame-height as decimal   no-undo .
     1746   define variable v-diasize-change-size          as logical   no-undo .
     1747   define variable v-diasize-resize-button        as handle    no-undo .
     1748   define variable v-diasize-wndmax               as logical   no-undo .
     1749   define variable v-diasize-wndstore             as logical   no-undo .
     1750   define variable v-diasize-proc-name            as character no-undo .
     1751   define variable v-diasize-browse-handle        as handle    no-undo .
     1752   define variable v-diasize-browse-number        as integer   no-undo .
     1753   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1754   define temp-table temp-diasize-handle no-undo
     1755     field handle-value  as handle
     1756     field save-position as decimal
     1757     index xpk is primary unique handle-value
     1758     .
     1759   define temp-table temp-browse-handle no-undo
     1760     field browse-type   as character
     1761     field browse-number as integer
     1762     field browse-handle as handle
     1763     field original-size as decimal
     1764     index xpk is primary unique browse-type browse-number
     1765     index xie browse-type browse-handle
     1766   .
     1767   procedure diasize_change-height :
     1768     define input  parameter p-change-value  as decimal   no-undo .
     1769     define input  parameter p-move-resize   as logical   no-undo .
     1770     define variable v-field-group-handle    as handle    no-undo .
     1771     define variable v-object-handle         as handle    no-undo .
     1772     define variable v-frame-height          as decimal   no-undo .
     1773     define variable v-frame-virtual-height  as decimal   no-undo .
     1774     define variable v-browse-height         as decimal   no-undo .
     1775     define variable v-window-height         as decimal   no-undo .
     1776     define variable v-window-virtual-height as decimal   no-undo .
     1777     define variable v-change-sign           as integer   no-undo .
     1778     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1779     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1780     if p-change-value > 0
     1781     then do:
     1782       if frame Dialog-Frame :height + p-change-value
     1783           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1784       then do:
     1785         assign
     1786           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1787                           - (frame Dialog-Frame :height-chars)
     1788         .
     1789         if p-change-value <= 0
     1790         then do:
     1791           run diasize_position-resize-button in this-procedure .
     1792           return .
     1793         end.
     1794       end.
     1795     end.
     1796     if p-change-value < 0
     1797     then do:
     1798       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1799       then do:
     1800         assign
     1801           p-change-value = v-diasize-orig-frame-height
     1802                          - (frame Dialog-Frame :height-chars)
     1803         .
     1804         if p-change-value >= 0
     1805         then do:
     1806           run diasize_position-resize-button in this-procedure .
     1807           return .
     1808         end.
     1809       end.
     1810     end.
     1811     if p-change-value >= 0
     1812     then do:
     1813       assign
     1814         v-change-sign = 1
     1815       .
     1816     end.
     1817     else do:
     1818       assign
     1819         v-change-sign = -1
     1820       .
     1821     end.
     1822     assign
     1823       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1824     .
     1825     if p-change-value = 0
     1826     then do:
     1827       run diasize_position-resize-button in this-procedure .
     1828       return .
     1829     end.
     1830     move_block:
     1831     do
     1832     on error undo move_block, retry move_block
     1833     :
     1834       if retry
     1835       then do:
     1836         do
     1837         on error undo move_block, leave move_block
     1838         :
     1839           if p-change-value > 0
     1840           then do:
     1841             for each buf_temp-diasize-handle
     1842             on error undo, next
     1843             :
     1844               assign
     1845                 v-object-handle = buf_temp-diasize-handle.handle-value
     1846               .
     1847               if v-object-handle <> v-diasize-resize-button
     1848               then do:
     1849                 assign
     1850                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1851                 .
     1852               end.
     1853             end.
     1854             assign
     1855               v-diasize-browse-handle :height = v-browse-height
     1856             .
     1857             for each buf_temp-browse-handle
     1858               where buf_temp-browse-handle.browse-type = 'height':u
     1859             on error undo, next
     1860             :
     1861               assign
     1862                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1863               .
     1864             end.
     1865             assign
     1866               frame Dialog-Frame :height = v-frame-height
     1867             .
     1868             if frame Dialog-Frame :scrollable = true
     1869             then do:
     1870               assign
     1871                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1872               .
     1873             end.
     1874             run diasize_position-resize-button in this-procedure .
     1875           end.
     1876           else do:
     1877             if frame Dialog-Frame :scrollable = true
     1878             then do:
     1879               assign
     1880                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1881               .
     1882             end.
     1883             assign
     1884               frame Dialog-Frame :height = v-frame-height
     1885             .
     1886             assign
     1887               v-diasize-browse-handle :height = v-browse-height
     1888             .
     1889             for each buf_temp-browse-handle
     1890               where buf_temp-browse-handle.browse-type = 'height':u
     1891             on error undo, next
     1892             :
     1893               assign
     1894                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1895               .
     1896             end.
     1897             for each buf_temp-diasize-handle
     1898             on error undo, next
     1899             :
     1900               assign
     1901                 v-object-handle = buf_temp-diasize-handle.handle-value
     1902               .
     1903               if v-object-handle <> v-diasize-resize-button
     1904               then do:
     1905                 assign
     1906                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1907                 .
     1908               end.
     1909             end.
     1910             run diasize_position-resize-button in this-procedure .
     1911           end.
     1912           assign
     1913             v-diasize-change-size = false
     1914           .
     1915           leave move_block .
     1916         end.
     1917       end.
     1918       assign
     1919         v-diasize-need-full-display = true
     1920       .
     1921       if v-diasize-change-size = false
     1922       then do:
     1923         assign
     1924           v-diasize-change-size = true
     1925         .
     1926       end.
     1927       else do:
     1928         return .
     1929       end.
     1930       assign
     1931         v-frame-height = frame Dialog-Frame :height
     1932         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1933         v-browse-height = v-diasize-browse-handle :height
     1934       .
     1935       for each buf_temp-browse-handle
     1936         where buf_temp-browse-handle.browse-type = 'height':u
     1937       :
     1938         assign
     1939           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1940         .
     1941       end.
     1942       for each buf_temp-diasize-handle
     1943       :
     1944         delete buf_temp-diasize-handle .
     1945       end.
     1946       assign
     1947         v-field-group-handle = frame Dialog-Frame :first-child
     1948       .
     1949       do while valid-handle(v-field-group-handle)
     1950       :
     1951         assign
     1952           v-object-handle = v-field-group-handle :first-child
     1953         .
     1954         do while valid-handle(v-object-handle)
     1955         :
     1956           if  v-object-handle <> v-diasize-browse-handle :handle
     1957           and can-query(v-object-handle, "row")
     1958           and can-query(v-object-handle, "height")
     1959           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1960           then do:
     1961             find first buf_temp-browse-handle
     1962               where buf_temp-browse-handle.browse-type   = 'height':u
     1963                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1964               no-error .
     1965             if available buf_temp-browse-handle
     1966             then do:
     1967             end.
     1968             else do:
     1969               create buf_temp-diasize-handle .
     1970               assign
     1971                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1972                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1973               .
     1974             end.
     1975           end.
     1976           assign
     1977             v-object-handle = v-object-handle :next-sibling
     1978           .
     1979         end.
     1980         assign
     1981           v-field-group-handle = v-field-group-handle :next-sibling
     1982         .
     1983       end.
     1984       do with frame Dialog-Frame
     1985       :
     1986         hide v-diasize-resize-button .
     1987         assign
     1988           v-diasize-resize-button :row    = 1
     1989           v-diasize-resize-button :column = 1
     1990         .
     1991       end.
     1992       if p-change-value > 0
     1993       then do:
     1994         if frame Dialog-Frame :scrollable = true
     1995         then do:
     1996           assign
     1997             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1998             no-error .
     1999           if error-status :error
     2000           or error-status :get-message(1) <> ""
     2001           then do:
     2002             undo move_block, retry move_block .
     2003           end.
     2004         end.
     2005         assign
     2006           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2007           no-error .
     2008         if error-status :error
     2009         or error-status :get-message(1) <> ""
     2010         then do:
     2011           undo move_block, retry move_block .
     2012         end.
     2013         assign
     2014           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2015           no-error .
     2016         if error-status :error
     2017         or error-status :get-message(1) <> ""
     2018         then do:
     2019           undo move_block, retry move_block .
     2020         end.
     2021         for each buf_temp-browse-handle
     2022           where buf_temp-browse-handle.browse-type = 'height':u
     2023         on error undo move_block, retry move_block
     2024         :
     2025           assign
     2026             buf_temp-browse-handle.browse-handle :height
     2027               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2028             no-error .
     2029           if error-status :error
     2030           or error-status :get-message(1) <> ""
     2031           then do:
     2032             undo move_block, retry move_block .
     2033           end.
     2034         end.
     2035         for each buf_temp-diasize-handle
     2036         on error undo move_block, retry move_block
     2037         :
     2038           assign
     2039             v-object-handle = buf_temp-diasize-handle.handle-value
     2040           .
     2041           if v-object-handle <> v-diasize-resize-button
     2042           then do:
     2043             assign
     2044               v-object-handle :row = v-object-handle :row + p-change-value
     2045               no-error .
     2046             if error-status :error
     2047             or error-status :get-message(1) <> ""
     2048             then do:
     2049               undo move_block, retry move_block .
     2050             end.
     2051           end.
     2052         end.
     2053       end.
     2054       else do:
     2055         for each buf_temp-diasize-handle
     2056         on error undo move_block, retry move_block
     2057         :
     2058           assign
     2059             v-object-handle = buf_temp-diasize-handle.handle-value
     2060           .
     2061           if v-object-handle <> v-diasize-resize-button
     2062           then do:
     2063             assign
     2064               v-object-handle :row = v-object-handle :row + p-change-value
     2065               no-error .
     2066             if error-status :error
     2067             or error-status :get-message(1) <> ""
     2068             then do:
     2069               undo move_block, retry move_block .
     2070             end.
     2071           end.
     2072         end.
     2073         assign
     2074           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2075           no-error .
     2076         if error-status :error
     2077         or error-status :get-message(1) <> ""
     2078         then do:
     2079           undo move_block, retry move_block .
     2080         end.
     2081         for each buf_temp-browse-handle
     2082           where buf_temp-browse-handle.browse-type = 'height':u
     2083         on error undo move_block, retry move_block
     2084         :
     2085           assign
     2086             buf_temp-browse-handle.browse-handle :height
     2087               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2088             no-error .
     2089           if error-status :error
     2090           or error-status :get-message(1) <> ""
     2091           then do:
     2092             undo move_block, retry move_block .
     2093           end.
     2094         end.
     2095         assign
     2096           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2097           no-error .
     2098         if error-status :error
     2099         or error-status :get-message(1) <> ""
     2100         then do:
     2101           undo move_block, retry move_block .
     2102         end.
     2103         if frame Dialog-Frame :scrollable = true
     2104         then do:
     2105           assign
     2106             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2107             no-error .
     2108           if error-status :error
     2109           or error-status :get-message(1) <> ""
     2110           then do:
     2111             undo move_block, retry move_block .
     2112           end.
     2113         end.
     2114       end.
     2115       if p-move-resize = true
     2116       then do:
     2117         run diasize_position-resize-button in this-procedure .
     2118       end.
     2119       if v-diasize-wndstore = true
     2120       then do:
     2121         if connected("ub") = true
     2122         then do:
     2123           define variable v-cntxt-db-num        as integer   no-undo .
     2124           define variable v-cntxt-userid        as character no-undo .
     2125           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2126                                             , OUTPUT v-cntxt-userid
     2127                                             ) .
     2128           run gbl/wndsizew.p
     2129             (input  v-cntxt-db-num
     2130             ,input  v-cntxt-userid
     2131             ,input  v-diasize-proc-name
     2132             ,input  'height':u
     2133             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2134             ) .
     2135         end.
     2136       end.
     2137     end.
     2138     assign
     2139       v-diasize-change-size = false
     2140     .
     2141   end procedure.
     2142   procedure diasize_set-height :
     2143     define input  parameter p-new-height  as decimal   no-undo .
     2144     define input  parameter p-move-resize as logical   no-undo .
     2145     do
     2146     on error undo, return error return-value
     2147     :
     2148       run diasize_change-height in this-procedure
     2149         (input  (p-new-height - frame Dialog-Frame :height)
     2150         ,input  p-move-resize
     2151         ) .
     2152     end.
     2153   end procedure.
     2154   procedure diasize_change-width :
     2155     define input  parameter p-change-value as decimal   no-undo .
     2156     define input  parameter p-move-resize  as logical   no-undo .
     2157     define variable v-field-group-handle   as handle    no-undo .
     2158     define variable v-object-handle        as handle    no-undo .
     2159     define variable v-frame-width          as decimal   no-undo .
     2160     define variable v-frame-virtual-width  as decimal   no-undo .
     2161     define variable v-browse-width         as decimal   no-undo .
     2162     define variable v-window-width         as decimal   no-undo .
     2163     define variable v-window-virtual-width as decimal   no-undo .
     2164     define variable v-change-sign          as integer   no-undo .
     2165     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2166     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2167     if p-change-value > 0
     2168     then do:
     2169       if frame Dialog-Frame :width + p-change-value >
     2170           session :width-chars
     2171       then do:
     2172         assign
     2173           p-change-value = session :width-chars - frame Dialog-Frame :width
     2174         .
     2175         if p-change-value <= 0
     2176         then do:
     2177           run diasize_position-resize-button in this-procedure .
     2178           return .
     2179         end.
     2180       end.
     2181     end.
     2182     if p-change-value < 0
     2183     then do:
     2184       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2185       then do:
     2186         assign
     2187           p-change-value = v-diasize-orig-frame-width
     2188                          - frame Dialog-Frame :width
     2189         .
     2190         if p-change-value >= 0
     2191         then do:
     2192           run diasize_position-resize-button in this-procedure .
     2193           return .
     2194         end.
     2195       end.
     2196     end.
     2197     if p-change-value >= 0
     2198     then do:
     2199       assign
     2200         v-change-sign = 1
     2201       .
     2202     end.
     2203     else do:
     2204       assign
     2205         v-change-sign = -1
     2206       .
     2207     end.
     2208     assign
     2209       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2210     .
     2211     if p-change-value = 0
     2212     then do:
     2213       run diasize_position-resize-button in this-procedure .
     2214       return .
     2215     end.
     2216     move_block:
     2217     do
     2218     on error undo move_block, leave move_block
     2219     :
     2220       if retry
     2221       then do:
     2222         do
     2223         on error undo move_block, leave move_block
     2224         :
     2225           if p-change-value > 0
     2226           then do:
     2227             for each buf_temp-diasize-handle
     2228             on error undo, next
     2229             :
     2230               assign
     2231                 v-object-handle = buf_temp-diasize-handle.handle-value
     2232               .
     2233               if v-object-handle <> v-diasize-resize-button
     2234               then do:
     2235                 assign
     2236                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2237                 .
     2238               end.
     2239             end.
     2240             assign
     2241               v-diasize-browse-handle :width = v-browse-width
     2242             .
     2243             for each buf_temp-browse-handle
     2244               where buf_temp-browse-handle.browse-type = 'width':u
     2245             on error undo, next
     2246             :
     2247               assign
     2248                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2249               .
     2250             end.
     2251             assign
     2252               frame Dialog-Frame :width = v-frame-width
     2253             .
     2254             if frame Dialog-Frame :scrollable = true
     2255             then do:
     2256               assign
     2257                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2258               .
     2259             end.
     2260             run diasize_position-resize-button in this-procedure .
     2261           end.
     2262           else do:
     2263             if frame Dialog-Frame :scrollable = true
     2264             then do:
     2265               assign
     2266                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2267               .
     2268             end.
     2269             assign
     2270               frame Dialog-Frame :width = v-frame-width
     2271             .
     2272             for each buf_temp-browse-handle
     2273               where buf_temp-browse-handle.browse-type = 'width':u
     2274             on error undo, next
     2275             :
     2276               assign
     2277                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2278               .
     2279             end.
     2280             assign
     2281               v-diasize-browse-handle :width = v-browse-width
     2282             .
     2283             for each buf_temp-diasize-handle
     2284             on error undo, next
     2285             :
     2286               assign
     2287                 v-object-handle = buf_temp-diasize-handle.handle-value
     2288               .
     2289               if v-object-handle <> v-diasize-resize-button
     2290               then do:
     2291                 assign
     2292                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2293                 .
     2294               end.
     2295             end.
     2296             run diasize_position-resize-button in this-procedure .
     2297           end.
     2298           assign
     2299             v-diasize-change-size = false
     2300           .
     2301           leave move_block .
     2302         end.
     2303       end.
     2304       assign
     2305         v-diasize-need-full-display = true
     2306       .
     2307       if v-diasize-change-size = false
     2308       then do:
     2309         assign
     2310           v-diasize-change-size = true
     2311         .
     2312       end.
     2313       else do:
     2314         return .
     2315       end.
     2316       assign
     2317         v-frame-width = frame Dialog-Frame :width
     2318         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2319         v-browse-width = v-diasize-browse-handle :width
     2320       .
     2321       for each buf_temp-browse-handle
     2322         where buf_temp-browse-handle.browse-type = 'width':u
     2323       :
     2324         assign
     2325           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2326         .
     2327       end.
     2328       for each buf_temp-diasize-handle
     2329       :
     2330         delete buf_temp-diasize-handle .
     2331       end.
     2332       assign
     2333         v-field-group-handle = frame Dialog-Frame :first-child
     2334       .
     2335       do while valid-handle(v-field-group-handle)
     2336       :
     2337         assign
     2338           v-object-handle = v-field-group-handle :first-child
     2339         .
     2340         do while valid-handle(v-object-handle)
     2341         :
     2342           if  v-object-handle <> v-diasize-browse-handle :handle
     2343           and v-object-handle <> v-diasize-resize-button
     2344           and can-query(v-object-handle, "row")
     2345           and can-query(v-object-handle, "height")
     2346           and ( v-object-handle :col + v-object-handle :width
     2347                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2348               )
     2349           then do:
     2350             find first buf_temp-browse-handle
     2351               where buf_temp-browse-handle.browse-type   = 'width':u
     2352                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2353               no-error .
     2354             if available buf_temp-browse-handle
     2355             then do:
     2356             end.
     2357             else do:
     2358               create buf_temp-diasize-handle .
     2359               assign
     2360                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2361                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2362               .
     2363             end.
     2364           end.
     2365           assign
     2366             v-object-handle = v-object-handle :next-sibling
     2367           .
     2368         end.
     2369         assign
     2370           v-field-group-handle = v-field-group-handle :next-sibling
     2371         .
     2372       end.
     2373       do with frame Dialog-Frame
     2374       :
     2375         hide v-diasize-resize-button .
     2376         v-diasize-resize-button :row = 1.
     2377         v-diasize-resize-button :column = 1.
     2378       end.
     2379       if p-change-value > 0
     2380       then do:
     2381         if frame Dialog-Frame :scrollable = true
     2382         then do:
     2383           assign
     2384             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2385             no-error .
     2386           if error-status :error
     2387           or error-status :get-message(1) <> ""
     2388           then do:
     2389             undo move_block, retry move_block.
     2390           end.
     2391         end.
     2392         assign
     2393           frame Dialog-Frame :width = v-frame-width + p-change-value
     2394           no-error .
     2395         if error-status :error
     2396         or error-status :get-message(1) <> ""
     2397         then do:
     2398           undo move_block, retry move_block.
     2399         end.
     2400         assign
     2401           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2402         no-error .
     2403         if error-status :error
     2404         or error-status :get-message(1) <> ""
     2405         then do:
     2406           undo move_block, retry move_block.
     2407         end.
     2408         for each buf_temp-browse-handle
     2409           where buf_temp-browse-handle.browse-type = 'width':u
     2410         on error undo move_block, retry move_block
     2411         :
     2412           assign
     2413             buf_temp-browse-handle.browse-handle :width
     2414               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2415             no-error .
     2416           if error-status :error
     2417           or error-status :get-message(1) <> ""
     2418           then do:
     2419             undo move_block, retry move_block .
     2420           end.
     2421         end.
     2422         for each buf_temp-diasize-handle
     2423         on error undo move_block, retry move_block
     2424         :
     2425           assign
     2426             v-object-handle = buf_temp-diasize-handle.handle-value
     2427           .
     2428           if v-object-handle <> v-diasize-resize-button
     2429           then do:
     2430             assign
     2431               v-object-handle :col = v-object-handle :col + p-change-value
     2432               no-error .
     2433             if error-status :error
     2434             or error-status :get-message(1) <> ""
     2435             then do:
     2436               undo move_block, retry move_block .
     2437             end.
     2438           end.
     2439         end.
     2440       end.
     2441       else do:
     2442         for each buf_temp-diasize-handle
     2443         on error undo move_block, retry move_block
     2444         :
     2445           assign
     2446             v-object-handle = buf_temp-diasize-handle.handle-value
     2447           .
     2448           if v-object-handle <> v-diasize-resize-button
     2449           then do:
     2450             assign
     2451               v-object-handle :col = v-object-handle :col + p-change-value
     2452               no-error .
     2453             if error-status :error
     2454             or error-status :get-message(1) <> ""
     2455             then do:
     2456               undo move_block, retry move_block .
     2457             end.
     2458           end.
     2459         end.
     2460         for each buf_temp-browse-handle
     2461           where buf_temp-browse-handle.browse-type = 'width':u
     2462         on error undo move_block, retry move_block
     2463         :
     2464           assign
     2465             buf_temp-browse-handle.browse-handle :width
     2466               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2467             no-error .
     2468           if error-status :error
     2469           or error-status :get-message(1) <> ""
     2470           then do:
     2471             undo move_block, retry move_block .
     2472           end.
     2473         end.
     2474         assign
     2475           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2476           no-error .
     2477         if error-status :error
     2478         or error-status :get-message(1) <> ""
     2479         then do:
     2480           undo move_block, retry move_block.
     2481         end.
     2482         assign
     2483           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2484         no-error .
     2485         if error-status :error
     2486         or error-status :get-message(1) <> ""
     2487         then do:
     2488           undo move_block, retry move_block.
     2489         end.
     2490         if frame Dialog-Frame :scrollable = true
     2491         then do:
     2492           assign
     2493             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2494           no-error .
     2495           if error-status :error
     2496           or error-status :get-message(1) <> ""
     2497           then do:
     2498             undo move_block, retry move_block.
     2499           end.
     2500         end.
     2501       end.
     2502       if p-move-resize
     2503       then do:
     2504         run diasize_position-resize-button in this-procedure .
     2505       end.
     2506       if v-diasize-wndstore = true
     2507       then do:
     2508         if connected("ub") = true
     2509         then do:
     2510           define variable v-cntxt-db-num        as integer   no-undo .
     2511           define variable v-cntxt-userid        as character no-undo .
     2512           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2513                                             , OUTPUT v-cntxt-userid
     2514                                             ) .
     2515           run gbl/wndsizew.p
     2516             (input  v-cntxt-db-num
     2517             ,input  v-cntxt-userid
     2518             ,input  v-diasize-proc-name
     2519             ,input  'width':u
     2520             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2521             ) .
     2522         end.
     2523       end.
     2524     end.
     2525     assign
     2526       v-diasize-change-size = false
     2527     .
     2528   end procedure.
     2529   procedure diasize_set-width :
     2530     define input  parameter p-new-width  as decimal   no-undo .
     2531     define input  parameter p-move-resize as logical   no-undo .
     2532     do
     2533     on error undo, return error return-value
     2534     :
     2535       run diasize_change-width in this-procedure
     2536         (input  (p-new-width - frame Dialog-Frame :width)
     2537         ,input  p-move-resize
     2538         ) .
     2539     end.
     2540   end procedure.
     2541   procedure diasize_position-resize-button :
     2542     do with frame Dialog-Frame
     2543     :
     2544       hide v-diasize-resize-button .
     2545       assign
     2546         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2547                     - 1
     2548                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2549         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2550                     - 1
     2551                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2552       .
     2553       view v-diasize-resize-button .
     2554     end.
     2555   end procedure.
     2556   on alt-right anywhere
     2557   do:
     2558     run diasize_change-width in this-procedure
     2559       (input 1
     2560       ,input true
     2561       ) .
     2562     return no-apply .
     2563   end.
     2564   on alt-left anywhere
     2565   do:
     2566     run diasize_change-width in this-procedure
     2567       (input -1
     2568       ,input true
     2569       ) .
     2570     return no-apply .
     2571   end.
     2572   on alt-down anywhere
     2573   do:
     2574     run diasize_change-height in this-procedure
     2575       (input 1
     2576       ,input true
     2577       ) .
     2578     return no-apply .
     2579   end.
     2580   on alt-up anywhere
     2581   do:
     2582     run diasize_change-height in this-procedure
     2583       (input -1
     2584       ,input true
     2585       ) .
     2586     return no-apply .
     2587   end.
     2588   on alt-enter of frame Dialog-Frame
     2589   do:
     2590     run diasize_maximize in this-procedure
     2591       (input  ?
     2592       ).
     2593     return no-apply .
     2594   end.
     2595   procedure diasize_end-move :
     2596     do
     2597     on error undo, return error return-value
     2598     :
     2599       define variable v-row-delta as decimal   no-undo .
     2600       define variable v-col-delta as decimal   no-undo .
     2601       define variable v-new-row as decimal   no-undo .
     2602       define variable v-new-col as decimal   no-undo .
     2603       assign
     2604         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2605         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2606       .
     2607       assign
     2608         v-row-delta = v-new-row - frame Dialog-Frame :height
     2609         v-col-delta = v-new-col - frame Dialog-Frame :width
     2610       .
     2611       run diasize_change-height in this-procedure
     2612         (input v-row-delta
     2613         ,input true
     2614         ) .
     2615       run diasize_change-width in this-procedure
     2616         (input v-col-delta
     2617         ,input true
     2618         ) .
     2619     end.
     2620   end procedure.
     2621   procedure diasize_maximize :
     2622     define input  parameter p-action as logical   no-undo .
     2623     do
     2624     on error undo, return error return-value
     2625     :
     2626       if p-action = ?
     2627       then do:
     2628         if v-diasize-need-maximize = true
     2629         then do:
     2630           assign
     2631             p-action = true
     2632           .
     2633         end.
     2634         else do:
     2635           assign
     2636             p-action = false
     2637           .
     2638         end.
     2639       end.
     2640       if p-action = true
     2641       then do:
     2642         run diasize_change-height in this-procedure
     2643           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2644               - frame Dialog-Frame :height-chars
     2645           ,input true
     2646           ) .
     2647         run diasize_change-width in this-procedure
     2648           (input session :width-chars
     2649               - frame Dialog-Frame :width-chars
     2650           ,input true
     2651           ) .
     2652         assign
     2653           v-diasize-need-maximize = false
     2654         .
     2655       end.
     2656       else do:
     2657         run diasize_change-width in this-procedure
     2658           (input v-diasize-orig-frame-width
     2659               - frame Dialog-Frame :width-chars
     2660           ,input true
     2661           ) .
     2662         run diasize_change-height in this-procedure
     2663           (input v-diasize-orig-frame-height
     2664               - frame Dialog-Frame :height-chars
     2665           ,input true
     2666           ) .
     2667         assign
     2668           v-diasize-need-maximize = true
     2669         .
     2670       end.
     2671     end.
     2672   end procedure.
     2673   procedure diasize_restore-orig-size :
     2674     do
     2675     on error undo, return error return-value
     2676     :
     2677       assign
     2678         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2679         v-diasize-current-frame-height = frame Dialog-Frame :height
     2680       .
     2681       run diasize_set-height in this-procedure
     2682         (input  v-diasize-orig-frame-height
     2683         ,input  true
     2684         ) .
     2685       run diasize_set-width in this-procedure
     2686         (input  v-diasize-orig-frame-width
     2687         ,input  true
     2688         ) .
     2689     end.
     2690   end procedure.
     2691   procedure diasize_restore-current-size :
     2692     do
     2693     on error undo, return error return-value
     2694     :
     2695       run diasize_set-height in this-procedure
     2696         (input  v-diasize-current-frame-height
     2697         ,input  true
     2698         ) .
     2699       run diasize_set-width in this-procedure
     2700         (input  v-diasize-current-frame-width
     2701         ,input  true
     2702         ) .
     2703     end.
     2704   end procedure.
     2705   procedure diasize_set-browse-handle :
     2706     define input  parameter p-browse-handle as handle   no-undo .
     2707     define buffer buf_temp-browse-handle for temp-browse-handle .
     2708     do
     2709     on error undo, return error return-value
     2710     :
     2711       assign
     2712         v-diasize-browse-handle = p-browse-handle
     2713       .
     2714       for each buf_temp-browse-handle
     2715       on error undo, return error return-value
     2716       :
     2717         delete buf_temp-browse-handle .
     2718       end.
     2719     end.
     2720   end procedure.
     2721   procedure diasize_add_browse :
     2722     define input  parameter p-browse-type   as character no-undo .
     2723     define input  parameter p-browse-handle as handle    no-undo .
     2724     define buffer buf_temp-browse-handle for temp-browse-handle .
     2725     do
     2726     on error undo, return error return-value
     2727     :
     2728       assign
     2729         v-diasize-browse-number = v-diasize-browse-number + 1
     2730       .
     2731       create buf_temp-browse-handle .
     2732       assign
     2733         buf_temp-browse-handle.browse-type   = p-browse-type
     2734         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2735         buf_temp-browse-handle.browse-handle = p-browse-handle
     2736       .
     2737     end.
     2738   end procedure.
     2739   procedure diasize_init :
     2740     define variable v-default-value    as logical   no-undo .
     2741     define variable v-restore-saved    as logical   no-undo .
     2742     define variable v-resize-value-str as character no-undo .
     2743     do
     2744     on error undo, return error return-value
     2745     :
     2746       do with frame Dialog-Frame
     2747       :
     2748         assign
     2749           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2750           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2751           v-diasize-browse-handle     = browse-hdl-wb-egais
     2752         .
     2753         create button v-diasize-resize-button
     2754         assign
     2755           parent        = frame Dialog-Frame :first-child
     2756           label         = "s"
     2757           height-pixels = 16
     2758           width-pixels  = 16
     2759           visible       = true
     2760           sensitive     = true
     2761           movable       = true
     2762           triggers:
     2763             on end-move persistent run diasize_end-move in this-procedure .
     2764           end triggers.
     2765         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2766         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2767         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2768         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2769         assign
     2770           v-diasize-wndmax = false
     2771         .
     2772         if connected("ub") = true
     2773         then do:
     2774           define variable v-cntxt-db-num        as integer   no-undo .
     2775           define variable v-cntxt-userid        as character no-undo .
     2776           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2777                                             , OUTPUT v-cntxt-userid
     2778                                             ) .
     2779           run gbl/wndpar_r.p
     2780             (input  v-cntxt-db-num
     2781             ,input  v-cntxt-userid
     2782             ,input  'wndmax':U
     2783             ,output v-diasize-wndmax
     2784             ,output v-default-value
     2785             ) .
     2786         end.
     2787         assign
     2788           v-diasize-wndstore = false
     2789         .
     2790         if connected("ub") = true
     2791         then do:
     2792           run gbl/wndpar_r.p
     2793             (input  v-cntxt-db-num
     2794             ,input  v-cntxt-userid
     2795             ,input  'wndstore':U
     2796             ,output v-diasize-wndstore
     2797             ,output v-default-value
     2798             ) .
     2799         end.
     2800         assign
     2801           v-diasize-proc-name = entry(1, program-name(2), '.')
     2802         .
     2803         if v-diasize-wndstore = true
     2804         then do:
     2805           assign
     2806             v-restore-saved = false
     2807           .
     2808           if connected("ub") = true
     2809           then do:
     2810             run gbl/wndsizer.p
     2811               (input  v-cntxt-db-num
     2812               ,input  v-cntxt-userid
     2813               ,input  v-diasize-proc-name
     2814               ,input  'height':u
     2815               ,output v-resize-value-str
     2816               ) .
     2817             if v-resize-value-str <> '':U
     2818             then do:
     2819               run diasize_change-height in this-procedure
     2820                 (input  integer(v-resize-value-str)
     2821                 ,input  true
     2822                 ) .
     2823               assign
     2824                 v-restore-saved = true
     2825               .
     2826             end.
     2827           end.
     2828           if connected("ub") = true
     2829           then do:
     2830             run gbl/wndsizer.p
     2831               (input  v-cntxt-db-num
     2832               ,input  v-cntxt-userid
     2833               ,input  v-diasize-proc-name
     2834               ,input  'width':u
     2835               ,output v-resize-value-str
     2836               ) .
     2837             if v-resize-value-str <> '':U
     2838             then do:
     2839               run diasize_change-width in this-procedure
     2840                 (input  integer(v-resize-value-str)
     2841                 ,input  true
     2842                 ) .
     2843               assign
     2844                 v-restore-saved = true
     2845               .
     2846             end.
     2847           end.
     2848           if v-restore-saved <> true
     2849           then do:
     2850             if v-diasize-wndmax = true
     2851             then do:
     2852               run diasize_maximize in this-procedure
     2853                 (input  true
     2854                 ) .
     2855             end.
     2856           end.
     2857         end.
     2858         else do:
     2859           if v-diasize-wndmax = true
     2860           then do:
     2861             run diasize_maximize in this-procedure
     2862               (input  true
     2863               ) .
     2864           end.
     2865         end.
     2866       end.
     2867     end.
     2868   end procedure.
     2869   procedure diasize_need-full-display :
     2870     define output parameter p-need-full-display as logical   no-undo .
     2871     do
     2872     on error undo, return error return-value
     2873     :
     2874       assign
     2875         p-need-full-display = v-diasize-need-full-display
     2876       .
     2877       assign
     2878         v-diasize-need-full-display = false
     2879       .
     2880     end.
     2881   end procedure.
     2882   procedure get-context :
     2883      define output parameter p-db-num as integer          no-undo.
     2884      define output parameter p-user-id as character        no-undo.
     2885      define variable v-login               as character    no-undo.
     2886      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2887      define buffer buf_user-login  for ub.user-login .
     2888      do
     2889      on error undo, return error
     2890      :
     2891            FIND FIRST buf_sys-ctrl no-lock.
     2892            ASSIGN
     2893               v-login = USERID("ub")
     2894               p-db-num = buf_sys-ctrl.db-num
     2895            .
     2896            FIND FIRST buf_user-login
     2897                 WHERE buf_user-login.db-num = p-db-num
     2898                   AND buf_user-login.user-login = v-login
     2899                 no-lock
     2900                 no-error
     2901                 .
     2902            IF AVAILABLE buf_user-login
     2903            THEN DO:
     2904               assign
     2905                  p-user-id = buf_user-login.user-id
     2906               .
     2907            END.
     2908      end.
     2909   end procedure.
     2910     run diasize_init in this-procedure .
     2911     run enable_UI.
     2912     bh-wb-gds-EG:find-first ("", no-lock) no-error.
     2913     run refresh-view.
     2914     v-uniq-key-rec  = bh-wb-egais:buffer-field ("uniq-key-rec"):buffer-value.
     2915     wait-for go of frame Dialog-Frame.
     2916   end.
     2917   run disable_UI.
     2918   PROCEDURE disable_UI :
     2919     HIDE FRAME Dialog-Frame.
     2920   END PROCEDURE.
     2921   PROCEDURE enable_UI :
     2922     DISPLAY F-ship f-cons
     2923       WITH FRAME Dialog-Frame.
     2924     ENABLE Btn_Cancel btn_conn
     2925       WITH FRAME Dialog-Frame.
     2926     VIEW FRAME Dialog-Frame.
     2927   END PROCEDURE.
     2928   PROCEDURE msdblcl :
     2929     def    var      v-rid-list  as character no-undo.
     2930     define variable par-alcohol as character no-undo .
     2931     define variable par-type    as character no-undo .
     2932     define buffer buf_ext-classif for ub.ext-classif.
     2933     def var nnList as int no-undo.
     2934     def var v-add as logical no-undo.
     2935     def var v-numBnd as int no-undo.
     2936     define variable v-prod-full-name as character no-undo .
     2937     define variable v-import-full-name as character no-undo .
     2938     define variable v-gds-code as int no-undo .
     2939     define variable v-gds-name as character no-undo .
     2940     def var glog as  log no-undo.
     2941     if bh-wb-gds-EG:buffer-field ("gds-code"):buffer-value <> "0" then
     2942     do :
     2943       extGdsObj:OpenQueryExtGds(0, bh-wb-gds-EG:buffer-field ("alc-code"):buffer-value).
     2944       v-numBnd = extGdsObj:NumBundles.
     2945       def var v-alc-code as char no-undo.
     2946       v-alc-code = bh-wb-gds-EG:buffer-field ("alc-code"):buffer-value.
     2947       run bge/egais-goods-mark.w (
     2948                                   input parparentproc,
     2949                                   input 'ИЗМЕНЕНИЕ':U,
     2950                                   input-output v-alc-code,
     2951                                   input-output v-gds-code,
     2952                                   output v-gds-name,
     2953                                   output v-prod-full-name,
     2954                                   output v-import-full-name )  .
     2955       if v-gds-code = 0 or v-gds-code = ?
     2956         then return no-apply.
     2957       find buf_goods where buf_goods.gds-code = v-gds-code no-lock.
     2958       run gds-attr-value(
     2959         buf_goods.gds-code,
     2960         'alcohol-prod':U,
     2961         output par-alcohol,
     2962         output par-type
     2963         ).
     2964       if par-alcohol = "" or par-alcohol = "no" then
     2965       do :
     2966         message "Выбранный товар не является алкогольной продукцией." view-as alert-box.
     2967         return no-apply.
     2968       end.
     2969       if buf_goods.ms-base <> bh-wb-gds-EG:buffer-field ("ms-base"):buffer-value and (bh-wb-gds-EG:buffer-field ("ms-base"):buffer-value <> 0 and bh-wb-gds-EG:buffer-field ("ms-base"):buffer-value <> ?)
     2970       then do:
     2971         message "У выбранного товара не соответсвует объем" view-as alert-box.
     2972         return no-apply.
     2973       end.
     2974       find first ub.alc-type-gds
     2975            where ub.alc-type-gds.gds-code = buf_goods.gds-code
     2976              and ub.alc-type-gds.create-user-db-num = 0 no-lock no-error.
     2977       if not available (ub.alc-type-gds)
     2978       then do:
     2979         message "У выбранного товара не задана алкогольная группа" view-as alert-box.
     2980         return no-apply.
     2981       end.
     2982       else do:
     2983         find first ub.alc-type where ub.alc-type-gds.alc-type-inner-code = ub.alc-type.alc-type-inner-code no-lock no-error.
     2984         if not available (ub.alc-type)
     2985         then do:
     2986           message "Не найдена алкогольная группа" view-as alert-box.
     2987           return no-apply.
     2988         end.
     2989       end.
     2990       extGdsValueObj = new ExtGdsValue().
     2991       v-prod = bh-wb-gds-EG:buffer-field ("prod-list"):buffer-value.
     2992       v-impor = bh-wb-gds-EG:buffer-field ("importer-list"):buffer-value.
     2993       extGdsValueObj:AlcCode = bh-wb-gds-EG:buffer-field ("alc-code"):buffer-value.
     2994       extGdsValueObj:GdsCode = buf_goods.gds-code.
     2995       extGdsValueObj:CliRegIdProd = entry (1, v-prod, chr(5)).
     2996       extGdsValueObj:INNProd = entry (2, v-prod, chr(5)).
     2997       extGdsValueObj:KPPProd = entry (3, v-prod, chr(5)).
     2998       extGdsValueObj:FullNameProd = entry (4, v-prod, chr(5)).
     2999       extGdsValueObj:CountryProd = entry (5, v-prod, chr(5)).
     3000       extGdsValueObj:DescrProd = entry (6, v-prod, chr(5)).
     3001       extGdsValueObj:CliEgaisTypeProd = entry (7, v-prod, chr(5)).
     3002       extGdsValueObj:RegionProd = entry (8, v-prod, chr(5)).
     3003       extGdsValueObj:CliRegIdImpor = entry (1, v-impor, chr(5)).
     3004       extGdsValueObj:INNImpor = entry (2, v-impor, chr(5)).
     3005       extGdsValueObj:KPPImpor = entry (3, v-impor, chr(5)).
     3006       extGdsValueObj:FullNameImpor = entry (4, v-impor, chr(5)).
     3007       extGdsValueObj:CountryImpor = entry (5, v-impor, chr(5)).
     3008       extGdsValueObj:DescrImpor = entry (6, v-impor, chr(5)).
     3009       extGdsValueObj:FullNameGds = bh-wb-gds-EG:buffer-field ("gds-name"):buffer-value.
     3010       extGdsObj:OpenQueryExtGds (buf_goods.gds-code, bh-wb-gds-EG:buffer-field ("alc-code"):buffer-value).
     3011       if extGdsObj:NumBundles = 0 and bh-wb-gds-EG:buffer-field ("gds-code"):buffer-value <> ? then do:
     3012         message substitute ("Добавить новую связку для - &1?", bh-wb-gds-EG:buffer-field ("alc-code"):buffer-value) view-as alert-box
     3013         question buttons yes-no
     3014         title "" update v-add.
     3015         if not v-add
     3016           then message substitute ("Связка будет удалена &1/&2", bh-wb-gds-EG:buffer-field ("gds-code"):buffer-value, bh-wb-gds-EG:buffer-field ("alc-code"):buffer-value) view-as alert-box
     3017                   question buttons ok-cancel title "" update v-ok as log.
     3018           else message substitute ("Будет добавлена новая связка для - &1", bh-wb-gds-EG:buffer-field ("alc-code"):buffer-value) view-as alert-box
     3019                   question buttons ok-cancel title "" update v-ok.
     3020         if not v-ok
     3021           then undo, return no-apply.
     3022       end.
     3023       do trans:
     3024       if extGdsObj:NumBundles = 0
     3025       then do:
     3026         if not v-add
     3027           then extGdsObj:DeleteExtGds(integer (bh-wb-gds-EG:buffer-field ("gds-code"):buffer-value), bh-wb-gds-EG:buffer-field ("alc-code"):buffer-value).
     3028         if extGdsObj:CreateExtGds(extGdsValueObj)
     3029         then do:
     3030             find first buf_clob-bind exclusive-lock where buf_clob-bind.uniq-key-rec = v-uniq-key-rec and buf_clob-bind.field-name_ = 'egais-ref-b':U.
     3031             if not available (buf_clob-bind)
     3032             then do:
     3033               message "По товарам нет справки Б".
     3034               undo, return no-apply.
     3035             end.
     3036             nnList = lookup (bh-wb-gds-EG:buffer-field ("refB"):buffer-value, buf_clob-bind.descr).
     3037             if nnList > 0
     3038             then do:
     3039               entry (nnList - 1, buf_clob-bind.descr) = string (buf_goods.gds-code).
     3040             end.
     3041             else do:
     3042               buf_clob-bind.descr = buf_clob-bind.descr + "," +  string (buf_goods.gds-code) + "," + bh-wb-gds-EG:buffer-field ("refB"):buffer-value.
     3043               buf_clob-bind.descr = left-trim (buf_clob-bind.descr, ",").
     3044             end.
     3045             release buf_clob-bind.
     3046         end.
     3047         else do:
     3048           message "Ошибка добавления записи в справочник: " extGdsObj:ReturnMsg view-as alert-box .
     3049           undo, return no-apply .
     3050         end.
     3051       end.
     3052       else do:
     3053           find first buf_clob-bind exclusive-lock where buf_clob-bind.uniq-key-rec = v-uniq-key-rec and buf_clob-bind.field-name_ = 'egais-ref-b':U.
     3054           if not available (buf_clob-bind)
     3055           then do:
     3056             message "По товарам нет справки Б".
     3057             undo, return no-apply.
     3058           end.
     3059           nnList = lookup (bh-wb-gds-EG:buffer-field ("refB"):buffer-value, buf_clob-bind.descr).
     3060           if nnList > 0
     3061           then do:
     3062             entry (nnList - 1, buf_clob-bind.descr) = string (buf_goods.gds-code).
     3063           end.
     3064           else do:
     3065             buf_clob-bind.descr = buf_clob-bind.descr + "," +  string (buf_goods.gds-code) + "," + bh-wb-gds-EG:buffer-field ("refB"):buffer-value.
     3066             buf_clob-bind.descr = left-trim (buf_clob-bind.descr, ",").
     3067           end.
     3068           release buf_clob-bind.
     3069       end.
     3070       end.
     3071     end.
     3072     else
     3073     do :
     3074   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3075   do:
     3076     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3077       (input  v-cntxt-db-num
     3078       ,input  v-cntxt-userid
     3079       ,input  0
     3080       ,input  'actn_egais-ref':U
     3081       ,input  'object':U
