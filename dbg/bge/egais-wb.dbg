      642   :
      643       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      644       (input  p-upper-code
      645       ,input  p-code
      646       ,output p-label
      647       ,output p-user-can-edit
      648       ,output p-output-display
      649       ,output p-other
      650       ,output p-prop-list
      651       ,output p-prop-type-list
      652       ,output p-prop-label-list
      653       ,output p-global
      654       ,output p-host
      655       ,output p-shop
      656       ,output p-store
      657       ,output p-db
      658       ,output p-region
      659       ) no-error .
      660     if error-status :error
      661     then do:
      662       undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1)).
      663     end.
      664   end.
