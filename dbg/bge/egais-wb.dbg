     3083       ,input  v-cntxt-obj-type
     3084       ,input  v-cntxt-obj-code
     3085       ,input  0
     3086       ,input  0
     3087       ,input  0
     3088       ,input  true
     3089       ,output glog
     3090       )  .
     3091   end.
     3092       if not glog then  return .
     3093       run ref/gds-ref.p
     3094         ( parparentproc
     3095         ,'b-add,b-sel'
     3096         ,?
     3097         ,?
     3098         ,?
     3099         ,?
     3100         ,?
     3101         ,?
     3102         ,?
     3103         ,v-cntxt-obj-type
     3104         ,v-cntxt-obj-code
     3105         ,?
     3106         , output v-rid-list) no-error.
     3107       if v-rid-list = "" or v-rid-list = ?
     3108         then return no-apply.
     3109       find buf_goods where recid (buf_goods) = integer (v-rid-list) no-lock.
     3110       run gds-attr-value(
     3111         buf_goods.gds-code,
     3112         'alcohol-prod':U,
     3113         output par-alcohol,
     3114         output par-type
     3115         ).
     3116       if par-alcohol = "" or par-alcohol = "no" then
     3117       do :
     3118         message "Выбранный товар не является алкогольной продукцией." view-as alert-box.
     3119         return no-apply.
     3120       end.
     3121       if buf_goods.ms-base <> bh-wb-gds-EG:buffer-field ("ms-base"):buffer-value and (bh-wb-gds-EG:buffer-field ("ms-base"):buffer-value <> 0 and bh-wb-gds-EG:buffer-field ("ms-base"):buffer-value <> ?)
     3122       then do:
     3123         message "У выбранного товара не соответсвует объем" view-as alert-box.
     3124         return no-apply.
     3125       end.
     3126       find first ub.alc-type-gds
     3127            where ub.alc-type-gds.gds-code = buf_goods.gds-code
     3128              and ub.alc-type-gds.create-user-db-num = 0 no-lock no-error.
     3129       if not available (ub.alc-type-gds)
     3130       then do:
     3131         message "У выбранного товара не задана алкогольная группа" view-as alert-box.
