     3142       extGdsValueObj = new ExtGdsValue().
     3143       v-prod = bh-wb-gds-EG:buffer-field ("prod-list"):buffer-value.
     3144       v-impor = bh-wb-gds-EG:buffer-field ("importer-list"):buffer-value.
