      625   define input  parameter p-upper-code     as character no-undo .
      626   define input  parameter p-code           as character no-undo .
      627   define output parameter p-label          as character no-undo .
      628   define output parameter p-user-can-edit  as logical   no-undo .
      629   define output parameter p-output-display as logical   no-undo .
      630   define output parameter p-other          as character no-undo .
      631   define output parameter p-prop-list      as character no-undo .
      632   define output parameter p-prop-type-list as character no-undo .
      633   define output parameter p-prop-label-list as character no-undo .
      634   define output parameter p-global          as logical no-undo .
      635   define output parameter p-host           as logical no-undo .
      636   define output parameter p-shop           as logical no-undo .
      637   define output parameter p-store          as logical no-undo .
      638   define output parameter p-db             as logical no-undo .
      639   define output parameter p-region         as logical no-undo .
