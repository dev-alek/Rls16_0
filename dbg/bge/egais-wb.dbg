        1   using ibs.th.bge.egais.*.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter egais as class EGAIS no-undo.
        4   define input parameter bh-wb-egais as handle no-undo.
        5   define variable vss-revision               as character no-undo init "$Revision$":U .
        6   define variable vss-author                 as character no-undo init "$Author$":U .
        7   define variable vss-date                   as character no-undo init "$Date$":U .
        8   define variable vss-workfile               as character no-undo init "$Workfile$":U .
        9   define variable vss-archive                as character no-undo init "$Archive$":U .
       10   define variable vss-description            as character no-undo init "Журнал запросов ЕГАИС".
       11   define variable th-wb-egais                as handle    no-undo.
       12   define variable gh-wb-egais                as handle    no-undo.
       13   define variable bh-wb-gds-EG               as handle    no-undo.
       14   define variable browse-hdl-wb-egais        as handle    no-undo.
       15   define variable gh-wb-egais-header         as handle    no-undo.
       16   define variable bh-wb-gds-EG-header        as handle    no-undo.
       17   define variable browse-hdl-wb-egais-header as handle    no-undo.
       18   define variable bcol                       as handle    extent no-undo.
       19   define variable bcol-h                     as handle    extent no-undo.
       20   define variable v-db-num                   as integer   no-undo .
       21   define variable v-user-id                  as character no-undo .
       22   define variable v-user-select              as character no-undo .
       23   define variable v-select-obj-type          as character no-undo .
       24   define variable v-select-obj-code          as integer   no-undo .
       25   define variable v-obj-uniq-key-rec         as character no-undo .
       26   define variable v-ext-sys                  as integer   no-undo .
       27   define variable v-rid                      as recid     no-undo .
       28   define variable v-uniq-key-rec             as character no-undo .
       29   define variable glog                       as logical no-undo .
       30   define variable ii                         as integer no-undo .
       31   define variable extGdsObj                  as class ExtGds no-undo .
       32   define variable extGdsValueObj             as class ExtGdsValue no-undo .
       33   define variable v-prod                     as character no-undo .
       34   define variable v-impor                    as character no-undo .
       35   define buffer buf_clients   for ub.clients .
       36   define buffer buf_firm      for ub.firm .
       37   define buffer x_ext-classif for ub.ext-classif.
       38   define buffer buf_goods     for ub.goods .
       39   define buffer buf_clob-bind for ub.clob-bind .
       40   define new global shared variable g#language as character no-undo .
       41   if g#language <> '' and g#language <> 'rus':U then do:
       42     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       43   end.
       44   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       45   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
       46   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
       47   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
       48   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
       49   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
       50   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       51   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       52   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       53   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       54   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
       55   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
       56   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
       57   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
       58   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
       59   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
       60   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
       61   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
       62   define new global shared variable g#library  as handle no-undo .
       63   define new global shared variable g#library2 as handle no-undo .
       64   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       65     define variable v-cntxt-db-num        as integer   no-undo .
       66     define variable v-cntxt-userid        as character no-undo .
       67     define variable v-cntxt-level         as character no-undo .
       68     define variable v-cntxt-host-code-obj as integer   no-undo .
       69     define variable v-cntxt-obj-type      as character no-undo .
       70     define variable v-cntxt-obj-code      as integer   no-undo .
       71     define variable v-cntxt-db-num-obj    as integer   no-undo .
       72     define variable v-cntxt-is-admin      as logical   no-undo .
       73   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   procedure gen-key-rec :
       76     define input  parameter p-tbl-name    as character no-undo.
       77     define input  parameter p-bh_tbl-name as handle    no-undo.
       78     define output parameter p-key-rec     as character no-undo.
       79     do
       80     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       81     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       82     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       83     :
       84       define variable fh               as handle    no-undo .
       85       define variable v-ok             as logical   no-undo .
       86       define variable v-inform         as character no-undo .
       87       define variable v-ind            as integer   no-undo .
       88       define variable v-idx-field-qnty as integer   no-undo .
       89       if p-tbl-name = ?
       90         or p-tbl-name = "":U
       91       then do:
       92         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
       93       end.
       94       if not p-bh_tbl-name:available then do:
       95         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
       96       end.
       97       assign
       98         p-key-rec = p-tbl-name
       99         v-inform  = p-bh_tbl-name:index-information(1)
      100         v-ind     = 2
      101       .
      102       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      103       on error undo, return error
      104       :
      105         assign
      106           v-inform = p-bh_tbl-name:index-information( v-ind )
      107           v-ind    = v-ind + 1
      108         .
      109       end.
      110       if v-inform = ?
      111         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      112         or entry( 3, v-inform, ",":U ) <> "1":U
      113       then do:
      114         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      115       end.
      116       else do:
      117         assign
      118           v-idx-field-qnty = num-entries( v-inform ) - 4
      119         .
      120         if v-idx-field-qnty < 2 then do:
      121           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      122         end.
      123         do v-ind = 1 to v-idx-field-qnty by 2
      124         on error undo, return error
      125         :
      126           assign
      127             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      128             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      129           .
      130         end.
      131       end.
      132       if p-key-rec = ? then do:
      133         assign
      134           p-key-rec = "":U
      135         .
      136         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      137       end.
      138     end.
      139     return.
      140   end procedure.
      141   procedure gen-where-keyr-tab :
      142     define input  parameter i-tableSerach as character no-undo.
      143     define input  parameter i-tablekey   as character  no-undo.
      144     define input  parameter p-key-rec    as character  no-undo.
      145     define input  parameter p-key-handle as handle     no-undo .
      146     define input  parameter p-db-name    as character  no-undo .
      147     define input  parameter p-tt-handle  as handle     no-undo .
      148     define output parameter o-Where      as character  no-undo.
      149     do
      150     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      151     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      152     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      153     :
      154       define variable v-full-tbl-name  as character no-undo .
      155       define variable bh_tbl-name      as handle    no-undo .
      156       define variable fh_key           as handle    no-undo .
      157       define variable fh_search        as handle    no-undo .
      158       define variable v-field-num      as integer   no-undo .
      159       define variable v-count-fld      as integer   no-undo .
      160       define variable v-inform         as character no-undo .
      161       define variable v-ind            as integer   no-undo .
      162       define variable v-idx-field-qnty as integer   no-undo .
      163       define variable v-field-name     as character no-undo .
      164       define variable v-field-val      as character no-undo .
      165       define variable v-word-link      as character no-undo .
      166       define variable vTable           as character no-undo.
      167       define variable bh_tbl-key       as handle    no-undo .
      168       assign
      169         p-key-rec = trim( p-key-rec )
      170       .
      171       if p-key-handle <> ? then do:
      172         if not valid-handle(p-key-handle)
      173            or p-key-handle:type <> "buffer"
      174         then do:
      175           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      176         end.
      177         if num-entries( p-key-rec, chr(3) ) > 1
      178           or p-key-rec = ?
      179           or p-key-rec = "":U
      180         then do:
      181           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      182         end.
      183       end.
      184       else do:
      185         if p-key-rec = ?
      186           or p-key-rec = "":U
      187         then do:
      188           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      189         end.
      190       end.
      191       assign
      192         vTable = entry( 1 , p-key-rec, chr(3) )
      193       .
      194       if p-tt-handle <> ?
      195         and ( not valid-handle(p-tt-handle)
      196               or p-tt-handle:type <> "buffer"
      197             )
      198       then do:
      199         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      200       end.
      201       if p-tt-handle = ? then do:
      202         assign
      203           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      204         .
      205         create buffer bh_tbl-name for table v-full-tbl-name .
      206       end.
      207       else do:
      208         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      209       end.
      210       assign
      211         v-inform = bh_tbl-name:index-information(1)
      212         v-ind    = 2
      213       .
      214       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      215       on error undo, return error
      216       :
      217         assign
      218           v-inform = bh_tbl-name:index-information( v-ind )
      219           v-ind    = v-ind + 1
      220         .
      221       end.
      222       if v-inform = ?
      223         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      224         or entry( 3, v-inform, ",":U ) <> "1":U
      225       then do:
      226         delete object bh_tbl-name no-error.
      227         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      228       end.
      229       assign
      230         v-idx-field-qnty = num-entries( v-inform ) - 4
      231       .
      232       if v-idx-field-qnty < 2 then do:
      233         delete object bh_tbl-name no-error.
      234         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      235       end.
      236       assign
      237         o-where     = "where":U
      238         v-word-link = "":U
      239         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      240         v-count-fld = 0
      241       .
      242       if i-tablekey ne "" and i-tablekey ne ?
      243       then do:
      244         assign
      245           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      246         .
      247         create buffer bh_tbl-key for table v-full-tbl-name .
      248       end.
      249       if i-tableSerach ne "" and i-tableSerach ne ?
      250       then do:
      251         delete object bh_tbl-name no-error.
      252         assign
      253           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      254         .
      255         create buffer bh_tbl-name for table v-full-tbl-name .
      256       end.
      257       block_where:
      258       do v-ind = 1 to v-idx-field-qnty by 2
      259       on error undo, return error
      260       :
      261         assign
      262           v-count-fld = v-count-fld + 1
      263         .
      264         if p-key-handle = ?
      265           and v-count-fld > v-field-num
      266         then do:
      267           leave block_where.
      268         end.
      269         define variable VfieldKeyTable as handle no-undo.
      270         assign
      271           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      272           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      273         .
      274         if     bh_tbl-key ne ?
      275         then do:
      276            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      277            if VfieldKeyTable eq ?
      278            then next block_where.
      279         end.
      280         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      281         then
      282            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      283         else
      284            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      285         if p-key-handle = ? then do:
      286           assign
      287             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      288           .
      289         end.
      290         else do:
      291           assign
      292             fh_key = p-key-handle:buffer-field( v-field-name )
      293           .
      294           if fh_key = ?
      295             or not valid-handle( fh_key )
      296           then do:
      297             delete object bh_tbl-name.
      298             if     bh_tbl-key ne ?
      299             then
      300                delete object bh_tbl-key.
      301             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      302           end.
      303           assign
      304             v-field-val = fh_key:buffer-value
      305           .
      306         end.
      307         if fh_search:data-type ="character":U then do:
      308           assign
      309             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      310             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      311             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      312             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      313             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      314             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      315             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      316             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      317             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      318             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      319             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      320             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      321             v-field-val = substitute( '"&1"', v-field-val )
      322           .
      323         end.
      324         assign
      325           o-where = substitute( "&1 &2", o-where, v-field-val )
      326         .
      327         if v-word-link = "":U then do:
      328           assign
      329             v-word-link = "and":U
      330           .
      331         end.
      332       end.
      333       delete object bh_tbl-name.
      334       if     bh_tbl-key ne ?
      335       then
      336          delete object bh_tbl-key.
      337       if p-key-handle = ?
      338         and v-count-fld <> v-field-num
      339       then do:
      340         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      341       end.
      342     end.
      343   end procedure.
      344   procedure gen-hn-keyr-tab :
      345     define input  parameter i-tableSerach as character no-undo.
      346     define input  parameter i-tablekey   as character no-undo.
      347     define input  parameter p-key-rec    as character no-undo.
      348     define input  parameter p-key-handle as handle    no-undo .
      349     define input  parameter p-db-name    as character no-undo .
      350     define input  parameter p-tt-handle  as handle    no-undo .
      351     define input  parameter p-stts-lock  as integer   no-undo .
      352     define output parameter o-hn         as handle    no-undo.
      353     define variable v-full-tbl-name as character no-undo.
      354     define variable v-where         as character no-undo.
      355     define variable bh_tbl-name     as handle    no-undo.
      356     define variable vTable          as character no-undo.
      357     do
      358     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      359     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      360     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      361         run gen-where-keyr-tab(i-tableSerach,
      362                                i-tablekey,
      363                                p-key-rec,
      364                                p-key-handle,
      365                                p-db-name,
      366                                p-tt-handle,
      367                                output v-where).
      368         if i-tableSerach ne "" and i-tableSerach ne ?
      369         then do:
      370            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      371            create buffer bh_tbl-name for table v-full-tbl-name .
      372         end.
      373         else do:
      374            if p-tt-handle = ? then do:
      375               assign
      376                  vTable = entry( 1 , p-key-rec, chr(3) )
      377               .
      378               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      379               create buffer bh_tbl-name for table v-full-tbl-name .
      380            end.
      381            else do:
      382               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      383            end.
      384         end.
      385         if p-tt-handle = ? then do:
      386            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      387         end.
      388         else do:
      389            bh_tbl-name:find-first( v-where ) no-error .
      390         end.
      391         o-hn = bh_tbl-name.
      392      end.
      393   end procedure.
      394   procedure gen-hn-keyr :
      395     define input  parameter p-key-rec    as character no-undo.
      396     define input  parameter p-key-handle as handle    no-undo .
      397     define input  parameter p-db-name    as character no-undo .
      398     define input  parameter p-tt-handle  as handle    no-undo .
      399     define input  parameter p-stts-lock  as integer   no-undo .
      400     define output parameter o-hn         as handle    no-undo.
      401     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      402   end.
      403   procedure gen-row-keyr :
      404     define input  parameter p-key-rec    as character no-undo.
      405     define input  parameter p-key-handle as handle    no-undo .
      406     define input  parameter p-db-name    as character no-undo .
      407     define input  parameter p-tt-handle  as handle    no-undo .
      408     define input  parameter p-stts-lock  as integer   no-undo .
      409     define output parameter p-tbl-row    as rowid     no-undo.
      410     define output parameter p-tbl-name   as character no-undo.
      411     define variable vHn as handle no-undo.
      412       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      413       p-tbl-row = if vHn:available then vHn:rowid else ?.
      414       p-tbl-name =  vHn:table.
      415       delete object vHn no-error.
      416     if p-tbl-row = ? then do:
      417       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      418     end.
      419     else do:
      420       return.
      421     end.
      422   end procedure.
      423   procedure gen-key-fv :
      424     define input  parameter p-key-rec    as character no-undo .
      425     define output parameter p-field-list as character no-undo .
      426     define output parameter p-value-list as character no-undo.
      427     do
      428     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      429     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      430     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      431     :
      432       define variable v-full-tbl-name  as character no-undo .
      433       define variable bh_tbl-name      as handle    no-undo .
      434       define variable v-tbl-name       as character no-undo .
      435       define variable v-field-num      as integer   no-undo .
      436       define variable v-count-fld      as integer   no-undo .
      437       define variable v-inform         as character no-undo .
      438       define variable v-ind            as integer   no-undo .
      439       define variable v-idx-field-qnty as integer   no-undo .
      440       define variable v-delim-key      as character no-undo .
      441       if p-key-rec = ?
      442         or p-key-rec = "":U
      443       then do:
      444         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      445       end.
      446       assign
      447         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      448         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      449       .
      450       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      451       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      452       assign
      453         v-inform = bh_tbl-name:index-information(1)
      454         v-ind    = 2
      455       .
      456       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      457       on error undo, return error
      458       :
      459         assign
      460           v-inform = bh_tbl-name:index-information( v-ind )
      461           v-ind    = v-ind + 1
      462         .
      463       end.
      464       if v-inform = ?
      465         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      466         or entry( 3, v-inform, ",":U ) <> "1":U
      467       then do:
      468         delete object bh_tbl-name no-error.
      469         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      470       end.
      471       assign
      472         v-idx-field-qnty = num-entries( v-inform ) - 4
      473       .
      474       if v-idx-field-qnty < 2 then do:
      475         delete object bh_tbl-name no-error.
      476         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      477       end.
      478       assign
      479         p-field-list = "":U
      480         p-value-list = "":U
      481         v-delim-key  = "":U
      482         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      483         v-count-fld  = 0
      484       .
      485       block_where:
      486       do v-ind = 1 to v-idx-field-qnty by 2
      487       on error undo, return error
      488       :
      489         assign
      490           v-count-fld = v-count-fld + 1
      491         .
      492         if v-count-fld > v-field-num then do:
      493           leave block_where.
      494         end.
      495         assign
      496           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      497           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      498         .
      499         if v-ind = 1 then do:
      500           assign
      501             v-delim-key = chr(3)
      502           .
      503         end.
      504       end.
      505       delete object bh_tbl-name.
      506       if v-count-fld <> v-field-num then do:
      507         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      508       end.
      509     end.
      510   end procedure.
      511   procedure gen-key-field :
      512     define input  parameter p-table      as character no-undo .
      513     define output parameter p-field-list as character no-undo .
      514     do
      515     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      516     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      517     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      518     :
      519       define variable v-full-tbl-name  as character no-undo .
      520       define variable bh_tbl-name      as handle    no-undo .
      521       define variable v-tbl-name       as character no-undo .
      522       define variable v-field-num      as integer   no-undo .
      523       define variable v-count-fld      as integer   no-undo .
      524       define variable v-inform         as character no-undo .
      525       define variable v-ind            as integer   no-undo .
      526       define variable v-idx-field-qnty as integer   no-undo .
      527       define variable v-delim-key      as character no-undo .
      528       if p-table = ?
      529         or p-table = "":U
      530       then do:
      531         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      532       end.
      533       assign
      534         v-tbl-name      = p-table
      535         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      536       .
      537       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      538       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      539       assign
      540         v-inform = bh_tbl-name:index-information(1)
      541         v-ind    = 2
      542       .
      543       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      544       on error undo, return error
      545       :
      546         assign
      547           v-inform = bh_tbl-name:index-information( v-ind )
      548           v-ind    = v-ind + 1
      549         .
      550       end.
      551       if v-inform = ?
      552         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      553         or entry( 3, v-inform, ",":U ) <> "1":U
      554       then do:
      555         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      556       end.
      557       assign
      558         v-idx-field-qnty = num-entries( v-inform ) - 4
      559       .
      560       if v-idx-field-qnty < 2 then do:
      561         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      562       end.
      563       assign
      564         p-field-list = "":U
      565         v-delim-key  = "":U
      566         v-count-fld  = 0
      567       .
      568       block_where:
      569       do v-ind = 1 to v-idx-field-qnty by 2
      570       on error undo, return error
      571       :
      572         assign
      573           v-count-fld = v-count-fld + 1
      574         .
      575         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      576         if v-ind = 1 then do:
      577           assign
      578             v-delim-key = chr(3)
      579           .
      580         end.
      581       end.
      582       delete object bh_tbl-name.
      583     end.
      584   end procedure.
      585   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      586   define new global shared variable g#attr-lib  as handle no-undo .
      587   define variable v-attr-lib-variable as handle no-undo .
      588   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      589   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      590   procedure thbjattr_code :
      591      define input  parameter p-upper-code     as character no-undo .
      592      define input  parameter p-code           as character no-undo .
      593      define output parameter p-label          as character no-undo .
      594      define output parameter p-user-can-edit  as logical   no-undo .
      595      define output parameter p-output-display as logical   no-undo .
      596      define output parameter p-other          as character no-undo .
      597      define output parameter p-prop-list      as character no-undo .
      598      define output parameter p-prop-type-list as character no-undo .
      599      define output parameter p-prop-label-list as character no-undo .
