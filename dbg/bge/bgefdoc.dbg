        1   block-level on error undo, throw.
        2   define input parameter p-date-from      as date       no-undo.
        3   define input parameter p-date-to        as date       no-undo.
        4   define input parameter p-range          as integer    no-undo.
        5   define input parameter p-mode           as character  no-undo.
        6   define input parameter p-host-code      as integer    no-undo .
        7   define input parameter p-obj-list       as character  no-undo.
        8   define input parameter p-db-num         as integer    no-undo.
        9   define input parameter p-doc-type-list  as character  no-undo.
       10   define input parameter hedt             as handle     no-undo.
       11   define input parameter hcnt             as handle     no-undo.
       12   define variable vss-revision    as character no-undo init "$Revision: 2d6430604525, 1301, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       14   define variable vss-date        as character no-undo init "$date: 18.08.03 18:20 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: bgefdoc.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: bge/bgefdoc.p $":U .
       17   define variable vss-description as character no-undo init "Экспорт во Внешнюю Бухгалтерию документов и суммарного расхода по чекам".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define  temp-table temp-host no-undo
       80     field host-code like ub.store.host-code
       81     index xpk host-code
       82   .
       83   define  temp-table temp-obj no-undo
       84     field obj-type  like ub.clients.obj-type
       85     field obj-code  like ub.clients.obj-code
       86     field host-code like ub.store.host-code
       87     field db-num    like ub.clients.db-num
       88     index xpk  obj-type obj-code
       89     index xie1 host-code
       90     index xie2 db-num host-code
       91   .
       92   procedure init-temphost:
       93     define buffer buf_store   for ub.store .
       94     define buffer buf_shop    for ub.shop .
       95     define buffer buf_clients for ub.clients .
       96     define buffer buf_db for ub.db .
       97     define buffer buf_temp-host for temp-host .
       98     define buffer buf_temp-obj for temp-obj .
       99     do
      100     on error undo, return error return-value
      101     :
      102       for each buf_store
      103       on error undo, return error
      104       :
      105         find first buf_temp-host
      106           where buf_temp-host.host-code = buf_store.host-code
      107           no-error .
      108         if not available buf_temp-host
      109         then do:
      110           create buf_temp-host .
      111           assign
      112             buf_temp-host.host-code = buf_store.host-code
      113           .
      114         end.
      115         find first buf_clients no-lock
      116           where buf_clients.obj-type = 'скл':U
      117             and buf_clients.obj-code = buf_store.obj-code
      118           no-error .
      119         if not available buf_clients
      120         then do:
      121           message
      122             "Ошибка при поиске клиента" skip
      123             "Клиент" 'скл':U buf_store.obj-code skip
      124             view-as alert-box error .
      125           undo, return error .
      126         end.
      127         create buf_temp-obj .
      128         assign
      129           buf_temp-obj.obj-type  = 'скл':U
      130           buf_temp-obj.obj-code  = buf_store.obj-code
      131           buf_temp-obj.host-code = buf_store.host-code
      132           buf_temp-obj.db-num    = buf_clients.db-num
      133         .
      134       end.
      135       for each buf_shop
      136       on error undo, return error
      137       :
      138         find first buf_temp-host
      139           where buf_temp-host.host-code = buf_shop.host-code
      140           no-error .
      141         if not available buf_temp-host
      142         then do:
      143           create buf_temp-host .
      144           assign
      145             buf_temp-host.host-code = buf_shop.host-code
      146           .
      147         end.
      148         find first buf_clients no-lock
      149           where buf_clients.obj-type = 'маг':U
      150             and buf_clients.obj-code = buf_shop.obj-code
      151           no-error .
      152         if not available buf_clients then do:
      153           message
      154             "Ошибка при поиске клиента" skip
      155             "Клиент" 'маг':U buf_shop.obj-code skip
      156             view-as alert-box error .
      157           undo, return error .
      158         end.
      159         create buf_temp-obj .
      160         assign
      161           buf_temp-obj.obj-type  = 'маг':U
      162           buf_temp-obj.obj-code  = buf_shop.obj-code
      163           buf_temp-obj.host-code = buf_shop.host-code
      164           buf_temp-obj.db-num    = buf_clients.db-num
      165         .
      166       end.
      167     end.
      168   end.
      169   define variable vss-include-info1 as character format "X(65)" no-undo
      170   initial "@(#)$Workfile$ $Revision$".
      171   define variable v-bgelib-bgefmt        as character         no-undo.
      172   define variable v-bgelib-bgeflold      as character         no-undo.
