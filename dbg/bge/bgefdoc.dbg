      401   initial "@(#)$Workfile$ $Revision$".
      402   procedure xmlchar-test :
      403   define input parameter p-in-string          as character        no-undo.
      404   define output parameter p-out-string-enc    as character        no-undo.
      405   define output parameter p-out-string-dec    as character        no-undo.
      406   do
      407   on error undo, return error
      408   :
      409          run xmlchar-encode in this-procedure
      410       (
      411             input p-in-string
      412           , output p-out-string-enc
      413       ).
      414          run xmlchar-decode in this-procedure
      415       (
      416             input p-out-string-enc
      417           , output p-out-string-dec
      418       ).
      419   end.
      420   end .
      421   procedure xmlchar-encode :
      422   define input parameter p-in-string      as character        no-undo.
      423   define output parameter p-out-string    as character        no-undo.
      424       define variable v-position      as integer      no-undo.
      425       define variable v-current-char  as character    no-undo.
      426   do
      427   on error undo, return error
      428   :
      429       assign
      430           p-out-string = "":U
      431       .
      432       case p-in-string
      433       :
      434           when ?
      435           then do:
      436               assign
      437                   p-out-string = "?":U
      438               .
      439           end.
      440           when "?":U
      441           then do:
      442               assign
      443                   p-out-string = "&#63;":U
      444               .
      445           end.
      446           otherwise do:
      447               do v-position = 1 to length( p-in-string )
      448               :
      449                   assign
      450                       v-current-char = substring( p-in-string, v-position, 1 )
      451                   .
      452                   case v-current-char
      453                   :
      454                       when "&":U
      455                       then do:
      456                           assign
      457                               p-out-string = p-out-string + "&amp;":U
      458                           .
      459                       end.
      460                       when ">":U
      461                       then do:
      462                           assign
      463                               p-out-string = p-out-string + "&gt;":U
      464                           .
      465                       end.
      466                       when "<":U
      467                       then do:
      468                           assign
      469                               p-out-string = p-out-string + "&lt;":U
      470                           .
      471                       end.
      472                       when "'":U
      473                       then do:
      474                           assign
      475                               p-out-string = p-out-string + "&apos;":U
      476                           .
      477                       end.
      478                       when '"':U
      479                       then do:
      480                           assign
      481                               p-out-string = p-out-string + "&quot;":U
      482                           .
      483                       end.
      484                       when chr(1)
      485                       then do:
      486                           assign
      487                               p-out-string = p-out-string + "":U
      488                           .
      489                       end.
      490                       when chr(2)
      491                       then do:
      492                           assign
      493                               p-out-string = p-out-string + "":U
      494                           .
      495                       end.
      496                       when chr(3)
      497                       then do:
      498                           assign
      499                               p-out-string = p-out-string + "":U
      500                           .
      501                       end.
      502                       when chr(4)
      503                       then do:
      504                           assign
      505                               p-out-string = p-out-string + "":U
      506                           .
      507                       end.
      508                       when chr(5)
      509                       then do:
      510                           assign
      511                               p-out-string = p-out-string + "":U
      512                           .
      513                       end.
      514                       when chr(6)
      515                       then do:
      516                           assign
      517                               p-out-string = p-out-string + "":U
      518                           .
      519                       end.
      520                       when chr(7)
      521                       then do:
      522                           assign
      523                               p-out-string = p-out-string + "":U
      524                           .
      525                       end.
      526                       when chr(8)
      527                       then do:
      528                           assign
      529                               p-out-string = p-out-string + "":U
      530                           .
      531                       end.
      532                       when chr(9)
      533                       then do:
      534                           assign
      535                               p-out-string = p-out-string + "":U
      536                           .
      537                       end.
      538                       when chr(29)
      539                       then do:
      540                           assign
      541                               p-out-string = p-out-string + "":U
      542                           .
      543                       end.
      544                       when chr(10)
      545                       then do:
      546                           assign
      547                               p-out-string = p-out-string + "&#10;":U
      548                           .
      549                       end.
      550                       when chr(13)
      551                       then do:
      552                           assign
      553                               p-out-string = p-out-string + "&#13;":U
      554                           .
      555                       end.
      556                       otherwise do:
      557                           assign
      558                               p-out-string = p-out-string + v-current-char
      559                           .
      560                       end.
      561                   end case.
      562               end.
      563           end.
      564       end case.
      565   end.
      566   end .
      567   procedure xmlchar-encode-1c :
