      175   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      176   procedure cur-time :
      177      define output parameter p-today as date      no-undo .
      178      define output parameter p-time  as integer   no-undo .
      179     do
      180     on error undo, return error
      181     :
      182       define variable v-date1 as date      no-undo .
      183       define variable v-date2 as date      no-undo .
      184       define variable v-time  as integer   no-undo .
      185       assign
      186         v-date1 = today
      187         v-time  = time
      188         v-date2 = today
      189       .
      190       if v-date1 <> v-date2
      191       then do:
      192         assign
      193           v-date1 = today
      194           v-time  = v-time
      195         .
      196       end.
      197       assign
      198         p-today = v-date1
      199         p-time  = v-time
      200       .
      201     end.
      202   end.
      203   function cur-time-date returns character
      204   :
      205     return string(today, '99/99/9999':U) .
      206   end.
      207   function cur-time-mjd returns decimal
      208   :
      209     define variable v-date as date      no-undo .
      210     define variable v-time as integer   no-undo .
      211     run cur-time in this-procedure
      212       (output v-date
      213       ,output v-time
      214       ) .
      215     return integer(v-date) - 2400002 + (v-time / 86400) .
      216   end.
      217   function cur-time-get-ending-index returns integer
      218   (input p-number as integer
      219   )
      220   :
      221     if p-number < 0
      222     or p-number = ?
      223     then do:
      224       return 1 .
      225     end.
      226     define variable v-rest as integer   no-undo .
      227     assign
      228       p-number = p-number modulo 100
      229     .
      230     if p-number < 20
      231     then do:
      232       assign
      233         v-rest = p-number
      234       .
      235     end.
      236     else do:
      237       assign
      238         v-rest = p-number modulo 10
      239       .
      240     end.
      241     case v-rest :
      242       when 1
      243       then do:
      244         return 2 .
      245       end.
      246       when 2 or
      247       when 3 or
      248       when 4
      249       then do:
      250         return 3 .
      251       end.
      252       otherwise do:
      253         return 1 .
      254       end.
      255     end case .
      256   end.
      257   procedure cur-time-mjd-to-date :
      258      define input  parameter i-mjd-diff as decimal no-undo.
      259      define output parameter o-Date     as date    no-undo.
      260      define output parameter o-Time     as integer no-undo.
      261      define variable v-day-number as integer   no-undo .
      262      if    i-mjd-diff < 0
      263         or i-mjd-diff = ?
      264      then do:
      265         return "?" .
      266      end.
      267      assign
      268         v-day-number = truncate(i-mjd-diff,0).
      269         o-Date = date(v-day-number + 2400002).
      270         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      271     .
      272   end.
      273   function cur-time-mjd-to-string returns character
      274   (input p-mjd-diff as decimal
      275   )
      276   :
      277     define variable v-day-number as integer   no-undo .
      278     define variable v-seconds    as integer   no-undo .
      279     define variable v-hour       as integer   no-undo .
      280     define variable v-min        as integer   no-undo .
      281     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      282     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      283     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      284     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      285     if p-mjd-diff < 0
      286     or p-mjd-diff = ?
      287     then do:
      288       return "?" .
      289     end.
      290     assign
      291       v-day-number = integer(truncate(p-mjd-diff,0))
      292       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      293     .
      294     if v-seconds > 86400
      295     then do:
      296       assign
      297         v-seconds = 86400 - 1
      298       .
      299     end.
      300     if v-seconds < 0
      301     then do:
      302       assign
      303         v-seconds = 0
      304       .
      305     end.
      306     assign
      307       v-hour = truncate(v-seconds / 3600, 0)
      308     .
      309     assign
      310       v-seconds = v-seconds modulo 3600
      311     .
      312     assign
      313       v-min = truncate(v-seconds / 60, 0)
      314     .
      315     assign
      316       v-seconds = v-seconds modulo 60
      317     .
      318     return
      319         (if v-day-number <> 0
      320           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      321           else ""
      322         )
      323       + (if v-day-number <> 0 or v-hour <> 0
      324           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      325           else ""
      326         )
      327       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      328           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      329           else ""
      330         )
      331       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      332       .
      333   end.
      334   function cur-time-string returns character
      335   :
      336     define variable v-date as date      no-undo .
      337     define variable v-time as integer   no-undo .
      338     run cur-time in this-procedure
      339       (output v-date
      340       ,output v-time
      341       ) .
      342     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      343   end.
      344   function cur-time-string-sec returns character
      345   :
      346     define variable v-date as date      no-undo .
      347     define variable v-time as integer   no-undo .
      348     run cur-time in this-procedure
      349       (output v-date
      350       ,output v-time
      351       ) .
      352     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      353   end.
      354   function cur-time-custom  returns character
      355   (input p-prefix as character
      356   ,input p-date-format as character
      357   ,input p-delimiter as character
      358   ,input p-time-format as character
      359   ,input p-suffix as character
      360   )
      361   :
      362     define variable v-date as date      no-undo .
      363     define variable v-time as integer   no-undo .
      364     run cur-time in this-procedure
      365       (output v-date
      366       ,output v-time
      367       ) .
      368     return
      369       p-prefix
      370       + string(v-date, p-date-format)
      371       + p-delimiter
      372       + string(v-time, p-time-format)
      373       + p-suffix
      374       .
      375   end.
      376   function cur-time-print  returns character
      377   :
      378     define variable v-date as date      no-undo .
      379     define variable v-time as integer   no-undo .
      380     run cur-time in this-procedure
      381       (output v-date
      382       ,output v-time
      383       ) .
      384     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      385   end.
      386   function cur-time-datetime returns datetime
      387   :
      388     define variable v-char as character no-undo .
      389     define variable v-datetime as datetime no-undo .
      390     v-char = cur-time-string().
      391     v-datetime = datetime(v-char).
      392     return  v-datetime.
      393   end.
      394   function cur-time-string-msec returns character
      395   :
      396     define variable v-date as datetime  no-undo .
      397     v-date = now.
      398     return string(v-date) .
      399   end.
