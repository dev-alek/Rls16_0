      647                       end.
      648                       when chr(29)
      649                       then do:
      650                           assign
      651                               p-out-string = p-out-string + " ":U
      652                           .
      653                       end.
      654                       when chr(10)
      655                       then do:
      656                           assign
      657                               p-out-string = p-out-string + " ":U
      658                           .
      659                       end.
      660                       when chr(13)
      661                       then do:
      662                           assign
      663                               p-out-string = p-out-string + " ":U
      664                           .
      665                       end.
      666                       otherwise do:
      667                           assign
      668                               p-out-string = p-out-string + v-current-char
      669                           .
      670                       end.
      671                   end case.
      672               end.
      673           end.
      674       end case.
      675   end.
      676   end .
      677   procedure xmlchar-decode :
      678   define input parameter p-in-string      as character        no-undo.
      679   define output parameter p-out-string    as character        no-undo.
      680       define variable v-position      as integer      no-undo.
      681       define variable v-last-position as integer      no-undo.
      682       define variable v-temp-integer  as integer      no-undo.
      683       define variable v-current-char  as character    no-undo.
      684       define variable v-next-char     as character    no-undo.
      685       define variable v-success       as logical      no-undo.
      686   do
      687   on error undo, return error
      688   :
      689       assign
      690           p-out-string = "":U
      691           v-position   = 0
      692       .
      693       replace-cycle:
      694       do while yes
      695       on error undo, return error
      696       :
      697           assign
      698               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      699           .
      700           if v-last-position <= v-position
      701           then do:
      702               if v-position = 0
      703               then do:
      704                   assign
      705                       p-out-string = p-in-string
      706                   .
      707               end.
      708               else do:
      709                   assign
      710                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      711                   .
      712               end.
      713               leave replace-cycle.
      714           end.
      715           else do:
      716               assign
      717                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      718                   v-position      = v-last-position
      719                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      720               .
      721               if v-current-char = "#":U
      722               then do:
      723                   assign
      724                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      725                   .
      726                   if v-last-position > 0
      727                   then do:
      728                       run xmlchar-read-integer in this-procedure
      729                        (
      730                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      731                           , output v-temp-integer
      732                           , output v-success
      733                       ).
      734                       if v-success = yes
      735                       and v-temp-integer >= 1
      736                       and v-temp-integer <= 255
      737                       then do:
      738                           assign
      739                               p-out-string = p-out-string + chr( v-temp-integer )
      740                               v-position   = v-last-position + 1
      741                           .
      742                       end.
      743                       else do:
      744                           assign
      745                               p-out-string = p-out-string + "&":U
      746                               v-position   = v-position   + 1
      747                           .
      748                       end.
      749                   end.
      750                   else do:
      751                       assign
      752                           p-out-string = p-out-string + "&":U
      753                           v-position   = v-position   + 1
      754                       .
      755                   end.
      756               end.
      757               else do:
      758                   case substring( p-in-string, v-position + 1, 3 )
      759                   :
      760                       when "lt;":U
      761                       then do:
      762                           assign
      763                               p-out-string = p-out-string + "<":U
      764                               v-position   = v-position   + 3
      765                           .
      766                       end.
      767                       when "gt;":U
      768                       then do:
      769                           assign
      770                               p-out-string = p-out-string + ">":U
      771                               v-position   = v-position   + 3
      772                           .
      773                       end.
      774                       otherwise do:
      775                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      776                           then do:
      777                               assign
      778                                   p-out-string = p-out-string + "&":U
      779                                   v-position   = v-position   + 4
      780                               .
      781                           end.
      782                           else do:
      783                               case substring( p-in-string, v-position + 1, 5 )
      784                               :
      785                                   when "quot;":U
      786                                   then do:
      787                                       assign
      788                                           p-out-string = p-out-string + '"':U
      789                                           v-position   = v-position   + 5
      790                                       .
      791                                   end.
      792                                   when "apos;":U
      793                                   then do:
      794                                       assign
      795                                           p-out-string = p-out-string + "'":U
      796                                           v-position   = v-position   + 5
      797                                       .
      798                                   end.
      799                                   otherwise do:
      800                                       assign
      801                                           p-out-string = p-out-string + "&":U
      802                                       .
      803                                   end.
      804                               end case.
      805                           end.
      806                       end.
      807                   end case.
      808               end.
      809           end.
      810       end.
      811   end.
      812   end .
      813   procedure xmlchar-read-integer :
      814   define input parameter p-input-string      as character        no-undo.
      815   define output parameter p-output-integer   as integer          no-undo.
      816   define output parameter p-success       as logical          no-undo.
      817   do
      818   on error undo, return error
      819   :
      820       assign
      821           p-output-integer = integer( p-input-string )
      822       no-error.
      823       if error-status :error
      824       then do:
      825           assign
      826               p-success           = no
      827               p-output-integer    = 0
      828           .
      829       end.
      830       else do:
      831           assign
      832               p-success           = yes
      833           .
      834       end.
      835   end.
      836   end.
      837   define variable v-bgelib-bgeclall           as logical      no-undo.
      838   define variable v-bgelib-bgedict            as logical      no-undo.
      839   define temp-table temp_ext-doc-type no-undo
      840       field edt-key               as integer
      841       field ext-doc-type          as character
      842       field ext-doc-type-label    as character
      843       index pi is primary unique
      844           edt-key
      845   .
      846   define temp-table temp_bgelib_goods no-undo
      847       field gds-code as integer
      848       index pi is primary unique
      849           gds-code
      850   .
      851   define temp-table temp_bgelib_clients no-undo
      852       field obj-type as character
      853       field obj-code as integer
      854       index pi is primary unique
      855           obj-type
      856           obj-code
      857   .
      858   define temp-table temp_bgelib_dis-card no-undo
      859       field d-card as character
      860       index pi is primary unique
      861           d-card
      862   .
      863   define temp-table temp_bgelib_trn-doc no-undo
      864       field doc-code as integer
      865   .
      866   procedure bgelib-tag-open:
      867   do
      868   on error undo, return error
      869   :
      870   define input parameter v-tag-level  as integer      no-undo.
      871   define input parameter v-tag-name   as character    no-undo.
      872   define input parameter v-tag-value  as character    no-undo.
      873       put stream stmXMLOut unformatted
      874           chr(10)
      875           + fill(" ", 4 * v-tag-level)
      876           + "<" + v-tag-name
      877           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      878           + v-tag-value + ">"
      879       .
      880   end.
      881   end procedure.
      882   procedure bgelib-tag-put:
      883   do
      884   on error undo, return error
      885   :
      886   define input parameter v-tag-level      as integer      no-undo.
      887   define input parameter v-tag-name       as character    no-undo.
      888   define input parameter v-tag-value      as character    no-undo.
      889   define input parameter v-empty-mode     as integer      no-undo.
      890       v-tag-name = trim(v-tag-name).
      891       if  v-empty-mode = 1
      892       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      893       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      894       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      895       then do:
      896           run xmlchar-encode in this-procedure (
      897                 input v-tag-value
      898               , output v-tag-value
      899           ).
      900           put stream stmXMLOut unformatted
      901               chr(10) + fill(" ", 4 * v-tag-level)
      902                           + '<' + v-tag-name + '>'
      903                           + v-tag-value
      904                           + '</' + v-tag-name + '>'
      905           .
      906       end.
      907   end.
      908   end procedure.
      909   procedure bgelib-tag-close:
      910   do
      911   on error undo, return error
      912   :
      913   define input parameter v-tag-level as integer      no-undo.
      914   define input parameter v-tag-name  as character    no-undo.
      915       put stream stmXMLOut unformatted
      916           chr(10)
      917           + fill( " ", 4 * v-tag-level)
      918           + '</' + v-tag-name + '>'
      919       .
      920   end.
      921   end procedure.
      922   procedure bgelib-write-log:
      923   do
      924   on error undo, return error
      925   :
      926   define input parameter v-filename   as character    no-undo.
      927   define input parameter v-log-level  as integer      no-undo.
      928   define input parameter v-out-string as character    no-undo.
      929       output stream stmXMLLog to value( v-filename ) append.
      930       put stream stmXMLLog unformatted
      931           chr(10)
      932       .
      933       put stream stmXMLLog unformatted
      934           ( if v-log-level = 0
      935             or v-out-string = "&DLine"
      936             or v-out-string = "&Line"
      937             then ""
      938             else cur-time-string-sec() + " " )
      939       .
      940       put stream stmXMLLog unformatted
      941           ( if v-out-string = "&Line"
      942             then fill( "-", 80 )
      943             else if v-out-string = "&DLine"
      944                  then fill( "=", 80 )
      945                  else v-out-string )
      946       .
      947       output stream stmXMLLog close.
      948   end.
      949   end procedure.
      950   procedure bgelib-write-edt:
      951   do
      952   on error undo, return error
      953   :
      954   define input parameter v-editor-handle    as handle       no-undo.
      955   define input parameter v-log-level        as integer      no-undo.
      956   define input parameter v-out-string       as character    no-undo.
      957       if valid-handle ( v-editor-handle )
      958       then do:
      959           v-editor-handle :move-to-eof().
      960           v-editor-handle :insert-string( ( if v-log-level = 0
      961                                             or v-out-string = "&DLine"
      962                                             or v-out-string = "&Line"
      963                                             then ""
      964                                             else cur-time-string-sec() + " "
      965                                         ) ).
      966           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      967                                             then fill( "-", 80 )
      968                                             else if v-out-string = "&DLine" then fill("=", 80)
      969                                             else fill( " ", v-log-level) + v-out-string
      970                                         ) ).
      971           v-editor-handle :insert-string( chr(10) ).
      972       end.
      973       process events.
      974       output to 'bgescn.txt' append.
      975           put unformatted
      976               chr(10)
      977               string( ( if v-log-level = 0
      978                         or v-out-string = "&DLine"
      979                         or v-out-string = "&Line"
      980                         then ""
      981                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      982                     ) )
      983               string( ( if v-out-string = "&Line"
      984                         then fill( "-", 80 )
      985                         else if v-out-string = "&DLine"
      986                              then fill( "=", 80 )
      987                              else fill( " ", v-log-level ) + v-out-string
      988                     ) )
      989           .
      990       output close.
      991   end.
      992   end procedure.
      993   procedure bgelib-show-cnt:
      994   do
      995   on error undo, return error
      996   :
      997   define input parameter v-fillin-handle     as handle   no-undo.
      998       if valid-handle( v-fillin-handle )
      999       then do:
     1000           assign
     1001               v-fillin-handle :visible = true
     1002           .
     1003       end.
     1004   end.
     1005   end procedure.
     1006   procedure bgelib-hide-cnt:
     1007   do
     1008   on error undo, return error
     1009   :
     1010   define input parameter v-fillin-handle     as handle   no-undo.
     1011       if valid-handle( v-fillin-handle )
     1012       then do:
     1013           assign v-fillin-handle :visible = false.
     1014       end.
     1015   end.
     1016   end procedure.
     1017   procedure bgelib-write-cnt:
     1018   do
     1019   on error undo, return error
     1020   :
     1021   define input parameter v-fillin-handle    as handle       no-undo.
     1022   define input parameter v-fillin-string    as character    no-undo.
     1023       if valid-handle( v-fillin-handle )
     1024       then do:
     1025           assign
     1026               v-fillin-handle :SCREEN-value = v-fillin-string
     1027           .
     1028       end.
     1029   end.
     1030   end procedure.
     1031   procedure bgelib-write-header:
     1032   do
     1033   on error undo, return error
     1034   :
     1035   define input parameter p-first-file     as logical      no-undo.
     1036   define input parameter p-xml-file-name  as character    no-undo.
     1037   define input parameter p-list-file-name as character    no-undo.
     1038   define input parameter p-file-number    as integer      no-undo.
     1039   define input parameter p-have-prev      as logical      no-undo.
     1040   define input parameter p-prev-filename  as character    no-undo.
     1041   define input parameter p-obj-list       as character    no-undo.
     1042   define input parameter p-doc-type-list  as character    no-undo.
     1043   define input parameter p-parameter-list as character    no-undo.
     1044       define variable v-counter    as integer        no-undo.
     1045       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1046       put stream stmXMLOut unformatted
     1047           "<?xml version='1.0' encoding='windows-1251'?>"
     1048       .
     1049       run bgelib-tag-open( input 0, input "root"  , input "" ).
     1050       run bgelib-tag-open( input 0, input "header", input "" ).
     1051       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1052       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1053       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1054       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1055       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     1056       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1057       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1058       :
     1059           run bgelib-tag-put(
     1060                 input 1
     1061               , input entry( 2 * v-counter, p-parameter-list )
     1062               , input entry( 2 * v-counter + 1, p-parameter-list )
     1063               , input 0
     1064           ).
     1065       end.
     1066       run bgelib-tag-close( input 0, input "header" ).
     1067       output stream stmXMLOut close.
     1068       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1069       if p-first-file = yes
     1070       then do:
     1071           put stream stmXMLOut unformatted
     1072               "<?xml version='1.0' encoding='windows-1251'?>"
     1073           .
     1074           run bgelib-tag-open( input 0, input "export", input "" ).
     1075       end.
     1076       run bgelib-tag-open( input 1, input "file", input "" ).
     1077       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1078       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1079       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1080       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1081       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1082       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1083       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1084       :
     1085           run bgelib-tag-put(
     1086                 input 2
     1087               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1088               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1089               , input 0
     1090           ).
     1091       end.
     1092       run bgelib-tag-close( input 1, input "file" ).
     1093       output stream stmXMLOut close.
     1094   end.
     1095   end procedure.
     1096   procedure bgelib-write-footer:
     1097   do
     1098   on error undo, return error
     1099   :
     1100   define input parameter p-last-file      as logical      no-undo.
     1101   define input parameter p-xml-file-name  as character    no-undo.
     1102   define input parameter p-list-file-name as character    no-undo.
     1103   define input parameter p-have-next      as logical      no-undo.
     1104   define input parameter p-next-file-name as character    no-undo.
     1105       define variable v-error-num     as integer           no-undo.
     1106       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1107       if p-have-next = yes
     1108       then do:
     1109           run bgelib-tag-open( input 0, input "footer", "" ).
     1110           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1111           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1112           run bgelib-tag-close( input 0, input "footer" ).
     1113       end.
     1114       run bgelib-tag-close( input 0, input "root" ).
     1115       output stream stmXMLOut close.
     1116       run bge/os_copy.p (
     1117             input "M"
     1118           , input p-xml-file-name + "tmp"
     1119           , input p-xml-file-name + "xml"
     1120           , output v-error-num
     1121       ).
     1122       if p-last-file = yes
     1123       then do:
     1124           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1125               run bgelib-tag-close( input 0, input "export" ).
     1126           output stream stmXMLOut close.
     1127           run bge/os_copy.p (
     1128                 input "M"
     1129               , input p-list-file-name + "tmp"
     1130               , input p-list-file-name + "xml"
     1131               , output v-error-num
     1132           ).
     1133       end.
     1134   end.
     1135   end procedure.
     1136   procedure bgelib-filename :
     1137   do
     1138   on error undo, return error
     1139   :
     1140   define input parameter p-prefix             as character    no-undo.
     1141   define output parameter p-xml-file-name     as character    no-undo.
     1142   define output parameter p-log-file-name     as character    no-undo.
     1143   define output parameter p-list-file-name    as character    no-undo.
     1144       define variable v-home-dir  as character    no-undo.
     1145       define variable v-error-num as integer      no-undo.
     1146       get-key-value section "BGE" key "outdir" value v-home-dir.
     1147       if v-home-dir = ?
     1148       then do:
     1149           message
     1150             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1151             skip(1)
     1152             skip "Обратитесь к администратору."
     1153           view-as alert-box error.
     1154           undo, return error .
     1155       end.
     1156       run gbl/dir-cre.p (
     1157           input v-home-dir
     1158       ) no-error.
     1159       if error-status :error
     1160       then do:
     1161           message
     1162             skip "Неверно задан каталог экспорта."
     1163             skip(1)
     1164             skip "Обратитесь к администратору."
     1165           view-as alert-box error.
     1166           undo, return error .
     1167       end.
     1168       run bge/genfname.p (
     1169             input v-home-dir
     1170           , input p-prefix
     1171           , input ""
     1172           , input "xml"
     1173           , input "tmp"
     1174           , output p-xml-file-name
     1175       ).
     1176       assign
     1177           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1178           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1179           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1180       .
     1181   end.
     1182   end procedure.
     1183   procedure bgelib-read-config :
     1184   do
     1185   on error undo, return error
     1186   :
     1187   define variable v-par-type as character     no-undo.
     1188     define variable v-param-type      as character  no-undo .
     1189     define variable v-value-character as character  no-undo .
     1190     define variable v-value-date      as date       no-undo .
     1191     define variable v-value-decimal   as decimal    no-undo .
     1192     define variable v-value-integer   as integer    no-undo .
     1193     define variable v-value-logical   as logical    no-undo .
     1194     define variable v-tth             as handle     no-undo .
     1195       assign
     1196           v-bgelib-bgeclall = no
     1197           v-bgelib-bgedict  = no
     1198       .
     1199       run adm/shattri.p ( input "get":U
     1200                         , input  '':u
     1201                         , input  0
     1202                         , input  'bge-export':U
     1203                         , input  'bgeclall':U
     1204                         , output v-value-character
     1205                         , output v-value-date
     1206                         , output v-value-decimal
     1207                         , output v-value-integer
     1208                         , output v-value-logical
     1209                         , output v-param-type
     1210                         , input-output table-handle v-tth
     1211                         ) no-error .
     1212       if error-status :error
     1213       then do:
     1214         assign
     1215           v-bgelib-bgeclall = no
     1216         .
     1217       end.
     1218       else do:
     1219         assign
     1220           v-bgelib-bgeclall = v-value-logical
     1221         .
     1222       end.
     1223       delete object v-tth.
     1224       run adm/shattri.p ( input "get":U
     1225                         , input  '':u
     1226                         , input  0
     1227                         , input  'bge-export':U
     1228                         , input  'bgedict':U
     1229                         , output v-value-character
     1230                         , output v-value-date
     1231                         , output v-value-decimal
     1232                         , output v-value-integer
     1233                         , output v-value-logical
     1234                         , output v-param-type
     1235                         , input-output table-handle v-tth
     1236                         ) no-error .
     1237       if error-status :error
     1238       then do:
     1239         assign
     1240           v-bgelib-bgedict = no
     1241         .
     1242       end.
     1243       else do:
     1244         assign
     1245           v-bgelib-bgedict = v-value-logical
     1246         .
     1247       end.
     1248       delete object v-tth.
     1249       run adm/shattri.p ( input "get":U
     1250                         , input  '':u
     1251                         , input  0
     1252                         , input  'bge-export':U
     1253                         , input  'bgefmt':U
     1254                         , output v-value-character
     1255                         , output v-value-date
     1256                         , output v-value-decimal
     1257                         , output v-value-integer
     1258                         , output v-value-logical
     1259                         , output v-param-type
     1260                         , input-output table-handle v-tth
     1261                         ) no-error .
     1262       if error-status :error
     1263       then do:
     1264         assign
     1265           v-bgelib-bgefmt  = "xml":U
     1266         .
     1267       end.
     1268       else do:
     1269         assign
     1270           v-bgelib-bgefmt  = v-value-character
     1271         .
     1272       end.
     1273       delete object v-tth.
     1274       run adm/shattri.p ( input "get":U
     1275                         , input  '':u
     1276                         , input  0
     1277                         , input  'bge-export':U
     1278                         , input  'bgeflold':U
     1279                         , output v-value-character
     1280                         , output v-value-date
     1281                         , output v-value-decimal
     1282                         , output v-value-integer
     1283                         , output v-value-logical
     1284                         , output v-param-type
     1285                         , input-output table-handle v-tth
     1286                         ) no-error .
     1287       if error-status :error
     1288       then do:
     1289         assign
     1290           v-bgelib-bgeflold  = "old":U
     1291         .
     1292       end.
     1293       else do:
     1294         assign
     1295           v-bgelib-bgeflold  = v-value-character
     1296         .
     1297       end.
     1298       delete object v-tth.
     1299   end.
     1300   end procedure.
     1301   procedure bgelib-check-file-size :
     1302   do
     1303   on error undo, return error
     1304   :
     1305   define input parameter p-out-filename   as character    no-undo.
     1306   define output parameter p-is-big        as logical      no-undo.
     1307       define variable v-current-position    as integer        no-undo.
     1308       assign
     1309           v-current-position = seek( stmXMLOut )
     1310       .
     1311       if v-current-position / 1024 / 1024  >= 100
     1312       then do:
     1313           assign
     1314               p-is-big = yes
     1315           .
     1316       end.
     1317   end.
     1318   end procedure.
     1319   procedure bgelib-init-ext-doc-type :
     1320       define variable v-counter    as integer      no-undo.
     1321       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1322   do
     1323   for buf_temp_ext-doc-type
     1324   on error undo, return error
     1325   :
     1326       empty temp-table buf_temp_ext-doc-type.
     1327       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1328       :
     1329           create buf_temp_ext-doc-type.
     1330           assign
     1331               buf_temp_ext-doc-type.edt-key               = v-counter
     1332               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1333               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1334           .
     1335       end.
     1336   end.
     1337   end procedure.
     1338   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1339   procedure factord :
     1340     define input  parameter p-fact-date            as date    no-undo .
     1341     define input  parameter p-fact-time            as integer no-undo .
     1342     define input  parameter p-fact-num             as integer no-undo .
     1343     define input  parameter p-shift-date           as date    no-undo .
     1344     define input  parameter p-shift-num            as integer no-undo .
     1345     define input  parameter p-shift-on             as logical no-undo .
     1346     define output parameter p-fact-order           as decimal no-undo .
     1347     define output parameter p-shift-end-fact-order as decimal no-undo .
     1348     define output parameter p-day-end-fact-order   as decimal no-undo .
     1349     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1350     if p-fact-date = ?
     1351     then do:
     1352       return error "Не указана фактическая дата" .
     1353     end.
     1354     define variable v-fact-date-num as integer no-undo .
     1355     assign
     1356       v-fact-date-num = integer(p-fact-date)
     1357     .
     1358     if p-fact-num = ?
     1359     or p-fact-num = 0
     1360     then do:
     1361       return error "Не задан p-fact-num " + string(p-fact-num) .
     1362     end.
     1363     if p-fact-num < 0
     1364     then do:
     1365       return error "Отрицательный fact-num " + string(p-fact-num) .
     1366     end.
     1367     if p-fact-num >= 100000000
     1368     then do:
     1369       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1370     end.
     1371     if p-shift-on = true
     1372     then do:
     1373       if p-shift-date = ?
     1374       then do:
     1375         return error "Не задана дата смены" .
     1376       end.
     1377       if p-shift-num = ?
     1378       or p-shift-num = 0
     1379       then do:
     1380         return error "Не задан номер смены" .
     1381       end.
     1382     end.
     1383     else do:
     1384       assign
     1385         p-shift-date = p-fact-date
     1386         p-shift-num  = 24
     1387       .
     1388     end.
     1389     define variable v-shift-offset as integer no-undo .
     1390     if p-shift-date = p-fact-date
     1391     then do:
     1392       assign
     1393         v-shift-offset = 1
     1394       .
     1395     end.
     1396     if p-shift-date < p-fact-date
     1397     then do:
     1398       assign
     1399         v-shift-offset = 0
     1400       .
     1401     end.
     1402     if p-shift-date > p-fact-date
     1403     then do:
     1404       message
     1405         vss-workfile vss-revision vss-description skip
     1406         "Неправильная дата закрытия смены" skip
     1407         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1408         view-as alert-box error .
     1409       undo, return error
     1410         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1411           ,string(p-fact-date, '99/99/9999':U)
     1412           ,string(p-shift-date, '99/99/9999':U)
     1413           )
     1414       .
     1415     end.
     1416     if p-shift-num < 1
     1417     or p-shift-num > 24
     1418     then do:
     1419       message
     1420         vss-workfile vss-revision vss-description skip
     1421         "Неправильный номер смены" skip
     1422         "p-shift-num" p-shift-num skip
     1423         view-as alert-box error .
     1424       undo, return error return-value .
     1425     end.
     1426     assign
     1427       p-fact-order           = v-fact-date-num
     1428                              + v-shift-offset * 0.5
     1429                              + p-shift-num    * 0.02 - 0.01
     1430                              + p-fact-num     * 0.0000000001
     1431       p-shift-end-fact-order = v-fact-date-num
     1432                              + v-shift-offset * 0.5
     1433                              + p-shift-num    * 0.02
     1434       p-day-end-fact-order   = v-fact-date-num
     1435                              + 0.99
     1436     .
     1437     if p-fact-order           <= v-fact-date-num
     1438     or p-shift-end-fact-order <= v-fact-date-num
     1439     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1440     or p-shift-end-fact-order >= p-day-end-fact-order
     1441     then do:
     1442       message
     1443         vss-workfile vss-revision vss-description skip
     1444         "Внутренняя ошибка при генерации фактического номера" skip
     1445         "p-fact-date"            p-fact-date            skip
     1446         "p-fact-time"            p-fact-time            skip
     1447         "p-fact-num"             p-fact-num             skip
     1448         "p-shift-date"           p-shift-date           skip
     1449         "p-shift-num"            p-shift-num            skip
     1450         "p-shift-on"             p-shift-on             skip
     1451         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1452         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1453         "v-fact-date-num"        v-fact-date-num        skip
     1454         view-as alert-box error .
     1455       undo, return error return-value .
     1456     end.
     1457   end procedure.
     1458   procedure day-begin-fact-order :
     1459     define input  parameter p-fact-date            as date    no-undo .
     1460     define output parameter p-day-begin-fact-order as decimal no-undo .
     1461     do
     1462     on error undo, return error return-value
     1463     :
     1464       if p-fact-date = ?
     1465       then do:
     1466         assign
     1467           p-day-begin-fact-order = 0
     1468         .
     1469       end.
     1470       else do:
     1471         assign
     1472           p-day-begin-fact-order = integer(p-fact-date)
     1473         .
     1474       end.
     1475     end.
     1476   end procedure.
     1477   procedure factord-max-fact-order :
     1478     define output parameter p-max-fact-order as decimal   no-undo .
     1479     do
     1480     on error undo, return error return-value
     1481     :
     1482       run day-begin-fact-order in this-procedure
     1483         (input  date(1, 1, 5000)
     1484         ,output p-max-fact-order
     1485         ) .
     1486     end.
     1487   end procedure.
     1488   procedure factord-cut-archive :
     1489     define input  parameter p-obj-type             as character no-undo .
     1490     define input  parameter p-obj-code             as integer   no-undo .
     1491     define input  parameter p-fact-date            as date      no-undo .
     1492     define output parameter p-shift-on             as logical   no-undo .
     1493     define output parameter p-shift-date           as date      no-undo .
     1494     define output parameter p-shift-num            as integer   no-undo .
     1495     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1496     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1497     define variable v-fact-order as decimal   no-undo .
     1498     define buffer buf_shift-obj for ub.shift-obj .
     1499     do
     1500     on error undo, return error return-value
     1501     :
     1502   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1503   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1504     (input  p-obj-type
     1505     ,input  p-obj-code
     1506     ,input  'shift-on=request'
     1507     ,output p-shift-on
     1508     ) no-error .
     1509       if error-status :error
     1510       then do:
     1511         message
     1512           vss-workfile vss-revision vss-description skip
     1513           "Ошибка при определении атрибута объекта" skip
     1514           "Объект" p-obj-type p-obj-code skip
     1515           error-status :get-message(1) skip
     1516           return-value skip
     1517           view-as alert-box error .
     1518         undo, return error return-value .
     1519       end.
     1520       if p-shift-on = false
     1521       then do:
     1522         assign
     1523           p-shift-date               = ?
     1524           p-shift-num                = 0
     1525         .
     1526       end.
     1527       else do:
     1528         find first buf_shift-obj share-lock
     1529           where buf_shift-obj.obj-type   = p-obj-type
     1530             and buf_shift-obj.obj-code   = p-obj-code
     1531             and buf_shift-obj.shift-date > p-fact-date
     1532           use-index pi
     1533           no-error .
     1534         if not available buf_shift-obj
     1535         or buf_shift-obj.status_ <> 'зкр':U
     1536         then do:
     1537           message
     1538             vss-workfile vss-revision vss-description skip
     1539             "Невозможно вычислить последнюю смену" skip
     1540             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1541             "Объект" p-obj-type p-obj-code skip
     1542             "Дата" p-fact-date skip
     1543             view-as alert-box error .
     1544           undo, return error return-value .
     1545         end.
     1546         find last buf_shift-obj share-lock
     1547           where buf_shift-obj.obj-type = p-obj-type
     1548             and buf_shift-obj.obj-code = p-obj-code
     1549             and buf_shift-obj.shift-date <= p-fact-date
     1550           use-index pi
     1551           no-error .
     1552         if available buf_shift-obj
     1553         then do:
     1554           if  buf_shift-obj.status_ = 'зкр':U
     1555           then do:
     1556             assign
     1557               p-shift-date = buf_shift-obj.shift-date
     1558               p-shift-num  = buf_shift-obj.shift-num
     1559             .
     1560           end.
     1561           else do:
     1562             message
     1563               vss-workfile vss-revision vss-description skip
     1564               "Невозможно вычислить последнюю смену" skip
     1565               "Статус смены отличен от статуса" 'зкр':U skip
     1566               "Объект" p-obj-type p-obj-code skip
     1567               "Дата" p-fact-date skip
     1568               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1569               view-as alert-box error .
     1570             undo, return error return-value .
     1571           end.
     1572         end.
     1573         else do:
     1574           assign
     1575             p-shift-date = p-fact-date - 1
     1576             p-shift-num  = 1
     1577           .
     1578         end.
     1579       end.
     1580       run factord in this-procedure
     1581         (input  p-fact-date
     1582         ,input  1
     1583         ,input  1
     1584         ,input  p-shift-date
     1585         ,input  p-shift-num
     1586         ,input  p-shift-on
     1587         ,output v-fact-order
     1588         ,output p-shift-end-fact-order
     1589         ,output p-day-end-fact-order
     1590         ) no-error .
     1591       if error-status :error
     1592       then do:
     1593         message
     1594           vss-workfile vss-revision vss-description skip
     1595           "Ошибка при вызове процедуры factord"
     1596           error-status :get-message(1) skip
     1597           return-value skip
     1598           view-as alert-box error .
     1599         undo, return error return-value .
     1600       end.
     1601     end.
     1602   end procedure.
     1603   procedure factord-lock-shift :
     1604     define input  parameter p-obj-type  as character no-undo .
     1605     define input  parameter p-obj-code  as integer   no-undo .
     1606     define input  parameter p-fact-date as date      no-undo .
     1607     define parameter buffer buf_shift-obj for ub.shift-obj .
     1608     define variable v-shift-on      as logical   no-undo .
     1609     define variable v-extra-message as character no-undo .
     1610     define variable v-error as character no-undo .
     1611     do
     1612     on error undo, return error return-value
     1613     :
     1614   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1615   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1616     (input  p-obj-type
     1617     ,input  p-obj-code
     1618     ,input  'shift-on=request'
     1619     ,output v-shift-on
     1620     ) no-error .
     1621       if error-status :error
     1622       then do:
     1623         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1624         undo, return error v-error .
     1625       end.
     1626       if v-shift-on = true
     1627       then do:
     1628         find first buf_shift-obj share-lock
     1629           where buf_shift-obj.obj-type   = p-obj-type
     1630             and buf_shift-obj.obj-code   = p-obj-code
     1631             and buf_shift-obj.shift-date > p-fact-date
     1632           use-index pi
     1633           no-error .
     1634         if not available buf_shift-obj
     1635         or buf_shift-obj.status_ <> 'зкр':U
     1636         then do:
     1637           find last buf_shift-obj
     1638             where buf_shift-obj.obj-type = p-obj-type
     1639               and buf_shift-obj.obj-code = p-obj-code
     1640               and buf_shift-obj.status_  = 'зкр':U
     1641             use-index stts
     1642             no-error .
     1643           if available buf_shift-obj
     1644           then do:
     1645             assign
     1646               v-extra-message =
     1647                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1648                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1649                               )
     1650             .
     1651           end.
     1652           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1653           undo, return error v-error .
     1654         end.
     1655       end.
     1656     end.
     1657   end procedure.
     1658   procedure factord-end-day :
     1659     define input  parameter p-fact-date            as date    no-undo .
     1660     define output parameter p-day-end-fact-order   as decimal no-undo .
     1661     do
     1662     on error undo, return error return-value
     1663     :
     1664       if p-fact-date = ?
     1665       then do:
     1666         return error "Не указана фактическая дата" .
     1667       end.
     1668       assign
     1669         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1670       .
     1671     end.
     1672   end procedure.
     1673   procedure factord-to-date :
     1674     define input  parameter p-fact-order as decimal no-undo .
     1675     define output parameter p-fact-date  as date    no-undo .
     1676     define variable v-ref-date  as date      no-undo .
     1677     define variable v-ref-delta as integer   no-undo .
     1678     do
     1679     on error undo, return error return-value
     1680     :
     1681       if p-fact-order = ?
     1682       or p-fact-order = 0
     1683       then do:
     1684         return error "Не указан fact-order" .
     1685       end.
     1686       assign
     1687         v-ref-date  = date(1, 1, 2000)
     1688       .
     1689       assign
     1690         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1691       .
     1692       assign
     1693         p-fact-date = v-ref-date + v-ref-delta
     1694       .
     1695     end.
     1696   end procedure.
     1697   procedure factord-to-fact-num :
     1698     define input  parameter p-fact-order as decimal no-undo .
     1699     define output parameter p-fact-num   as integer no-undo .
     1700     define variable v-fact-order-trunc as decimal no-undo .
     1701     do
     1702     on error undo, return error return-value
     1703     :
     1704       if p-fact-order = ?
     1705       or p-fact-order = 0
     1706       then do:
     1707         return error "Не указан fact-order" .
     1708       end.
     1709       assign
     1710        v-fact-order-trunc = truncate(p-fact-order, 2)
     1711       .
     1712       assign
     1713         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1714       .
     1715     end.
     1716   end procedure.
     1717   procedure factord-to-shift-num :
     1718     define input  parameter p-fact-order as decimal no-undo .
     1719     define output parameter p-shift-num   as integer no-undo .
     1720     define variable  p-shift-numd  as decimal   no-undo .
     1721     define variable v-fact-order-trunc as decimal no-undo .
     1722     do
     1723     on error undo, return error return-value
     1724     :
     1725       if p-fact-order = ?
     1726       or p-fact-order = 0
     1727       then do:
     1728         return error "Не указан fact-order" .
     1729       end.
     1730       assign
     1731        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1732       .
     1733       if v-fact-order-trunc < 0.5 then do:
     1734         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1735       end.
     1736       assign
     1737         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1738         .
     1739        assign
     1740         p-shift-num = truncate (p-shift-numd , 0)
     1741       .
     1742     end.
     1743   end procedure.
     1744   do
     1745   on error undo, return error
     1746   :
     1747       define variable v-xml-file-name     as character            no-undo.
     1748       define variable v-log-file-name     as character            no-undo.
     1749       define variable v-list-file-name    as character            no-undo.
     1750       define variable v-xml-file-number   as integer              no-undo.
     1751       define variable v-log-string        as character            no-undo.
     1752       define variable v-oper-num          as integer              no-undo.
     1753       define variable v-fact-order-from   like ub.stk-tot.fact-order no-undo.
     1754       define variable v-fact-order-to     like ub.stk-tot.fact-order no-undo.
     1755       define variable v-docs-exists       as logical              no-undo.
     1756       define variable v-obj-counter       as integer              no-undo.
     1757       define variable v-db-num            as integer              no-undo.
     1758       define variable v-cancel            as logical              no-undo.
     1759       define variable v-space-available   as logical              no-undo.
     1760       define variable v-parameter-list    as character            no-undo.
     1761       define variable v-obj-type as character no-undo .
     1762       define variable v-obj-code as integer   no-undo .
     1763       define variable v-host-code as integer   no-undo .
     1764       define variable v-host-str  as character no-undo init "" .
     1765       define variable v-ext-fin-doc-type-list as character extent 12 init
     1766       [
     1767           "приходный кассовый ордер",                  'пко':U,
     1768           "расходный кассовый ордер",                  'рко':U,
     1769           "приходное платежное поручение",             'ппп':U,
     1770           "расходное платежное поручение",             'рпп':U,
     1771           "приходный АПЗ",                             'апп':U,
     1772           "расходный АПЗ",                             'апр':U
     1773       ]                                                           no-undo.
     1774       run init-temphost.
     1775       assign
     1776           v-log-string = " по всем фирмам"
     1777       .
     1778       case p-range:
     1779       when 2
     1780       then do:
     1781           for each temp-host
     1782           :
     1783               delete temp-host.
     1784           end.
     1785           if p-mode = "shd":U then do:
     1786             create temp-host.
     1787             assign
     1788             temp-host.host-code = p-host-code
     1789             no-error .
     1790                 assign
     1791                     v-log-string = " по фирме: " + p-obj-list
     1792                 .
     1793           end.
     1794           else do:
     1795             do v-obj-counter = 1 to num-entries ( p-obj-list ) / 2
     1796             :
     1797                 create temp-host.
     1798                 assign
     1799                 temp-host.host-code = integer( entry( v-obj-counter * 2, p-obj-list ) )
     1800                 no-error .
     1801                 if error-status :error
     1802                 then do:
     1803                     message
     1804                     vss-workfile vss-revision vss-description
     1805                     skip "Ошибка чтения списка фирм"
     1806                     skip return-value
     1807                     skip trim(error-status :get-message(1))
     1808                         trim(error-status :get-message(2))
     1809                         trim(error-status :get-message(3))
     1810                     view-as alert-box error.
     1811                     undo, return error .
     1812                 end.
     1813                 assign
     1814                     v-log-string = " по фирмам: " + p-obj-list
     1815                 .
     1816             end.
     1817           end.
     1818       end.
     1819       when 3
     1820       then do:
     1821           for each temp-host
     1822           :
     1823               delete temp-host.
     1824           end.
     1825           do v-obj-counter = 1 to num-entries ( p-obj-list ) / 2
     1826           :
     1827           v-obj-type = entry( (v-obj-counter * 2 ) - 1 , p-obj-list )     .
     1828           v-obj-code = integer( entry( v-obj-counter * 2, p-obj-list ) )  .
     1829   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1830   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1831     (input  v-obj-type
     1832     ,input  v-obj-code
     1833     ,output v-host-code
     1834     )  .
     1835           if not can-find ( first temp-host where temp-host.host-code = v-host-code) then do:
     1836               v-host-str = v-host-str + "," + string(v-host-code).
     1837               create temp-host.
     1838               assign
     1839               temp-host.host-code = v-host-code
     1840               no-error .
     1841               if error-status :error
     1842               then do:
     1843                   message
     1844                   vss-workfile vss-revision vss-description
     1845                   skip "Ошибка чтения списка фирм"
     1846                   skip return-value
     1847                   skip trim(error-status :get-message(1))
     1848                       trim(error-status :get-message(2))
     1849                       trim(error-status :get-message(3))
     1850                   view-as alert-box error.
     1851                   undo, return error .
     1852               end.
     1853           end.
     1854           end.
     1855           assign
     1856               v-log-string = " по фирмам объектов: " + v-host-str
     1857           .
     1858       end.
     1859       end case.
     1860       run bgelib-filename in this-procedure (
     1861             input "fin-doc"
     1862           , output v-xml-file-name
     1863           , output v-log-file-name
     1864           , output v-list-file-name
     1865       ).
     1866       run gbl/waitfrsp.w (
     1867             input substring( v-xml-file-name, 1, 1 )
     1868           , input 200
     1869           , output v-cancel
     1870       ) .
     1871       if v-cancel = yes
     1872       then do:
     1873           undo, return error .
     1874       end.
     1875       run bgelib-write-log in this-procedure (
     1876             input v-log-file-name
     1877           , input 1
     1878           , input "&DLine"
     1879       ).
     1880       run bgelib-write-log in this-procedure (
     1881             input v-log-file-name
     1882           , input 1
     1883           , input substitute( "Начало выгрузки в файл &1"
     1884                                   , replace( v-xml-file-name, "/", "\" ) + "tmp"
     1885                             )
     1886       ).
     1887       run bgelib-write-log in this-procedure (
     1888             input v-log-file-name
     1889           , input 1
     1890           , input substitute( "................с параметрами: Дата с: &1, дата по: &2"
     1891                                   , p-date-from
     1892                                   , p-date-to
     1893                             )
     1894       ).
     1895       run bgelib-write-log in this-procedure (
     1896             input v-log-file-name
     1897           , input 1
     1898           , input substitute( "................с параметрами: ... &1: &2"
     1899                              ,v-log-string
     1900                              )
     1901       ).
     1902       run bgelib-write-log in this-procedure (
     1903             input v-log-file-name
     1904           , input 1
     1905           , input substitute( "................с параметрами: ... типы документов: &1", p-doc-type-list )
     1906       ).
     1907       assign
     1908           v-parameter-list         =  substitute( "&1,&2,&3,&4,&5,&6,&7,&8,&9"
     1909                                                  , 7
     1910                                                  , "docName"          , "finDocument":U
     1911                                                  , "version"          , replace("14.0 " + replace( vss-revision + vss-date, "$", " " ),',','')
     1912                                                  , "exportDate"       , string( today,          "99/99/9999" )
     1913                                                  , "exportTime"       , string( time,           "HH:MM:SS"   )
     1914                                                 )
     1915                                     + substitute( ",&1,&2,&3,&4,&5,&6"
     1916                                                  , "baseNum"          , p-db-num
     1917                                                  , "dateFrom"         , string( p-date-from,    "99/99/9999" )
     1918                                                  , "dateto"           , string( p-date-to,      "99/99/9999" )
     1919                                                 )
     1920       .
     1921       run bgelib-write-header in this-procedure (
     1922             input yes
     1923           , input v-xml-file-name
     1924           , input v-list-file-name
     1925           , input 1
     1926           , input no
     1927           , input ""
     1928           , input p-obj-list
     1929           , input p-doc-type-list
     1930           , input v-parameter-list
     1931       ).
     1932       object-of-list:
     1933       for each temp-host
     1934       :
     1935           run export-docs-by-host (
     1936                 input temp-host.host-code
     1937               , input v-xml-file-name
     1938               , input v-log-file-name
     1939               , input v-list-file-name
     1940               , input v-xml-file-number
     1941               , output v-xml-file-name
     1942               , output v-xml-file-number
     1943           ) no-error.
     1944           if error-status :error
     1945           then do:
     1946               message
     1947               vss-workfile vss-revision vss-description
     1948               skip "Ошибка экспорта финансовых документов по фирме"
     1949               skip "Код фирмы:" temp-host.host-code
     1950               skip return-value
     1951               skip trim(error-status :get-message(1))
     1952                    trim(error-status :get-message(2))
     1953                    trim(error-status :get-message(3))
     1954               view-as alert-box error.
     1955               next object-of-list.
     1956           end.
     1957       end.
     1958       run bgelib-write-footer in this-procedure (
     1959             input yes
     1960           , input v-xml-file-name
     1961           , input v-list-file-name
     1962           , input no
     1963           , input ""
     1964       ).
     1965       run bgelib-write-log in this-procedure (
     1966             input v-log-file-name
     1967           , input 1
     1968           , input substitute( "Данные выгружены в файл &1"
     1969                                   , replace( v-xml-file-name, "/", "\" ) + "xml"
     1970                             )
     1971       ).
     1972       run bgelib-write-log in this-procedure (
     1973             input v-log-file-name
     1974           , input 1
     1975           , input "&DLine"
     1976       ).
     1977   end.
     1978   procedure export-docs-by-host :
     1979   do
     1980   on error undo, return error
     1981   :
     1982   define input parameter p-host-code              as integer      no-undo.
     1983   define input parameter p-xml-file-name          as character    no-undo.
     1984   define input parameter p-log-file-name          as character    no-undo.
     1985   define input parameter p-list-file-name         as character    no-undo.
     1986   define input parameter p-xml-file-number        as integer      no-undo.
     1987   define output parameter p-new-xml-file-name     as character    no-undo.
     1988   define output parameter p-new-xml-file-number   as integer      no-undo.
     1989   define buffer buf_fin-doc for ub.fin-doc.
     1990       assign
     1991           p-new-xml-file-name     = p-xml-file-name
     1992           p-new-xml-file-number   = p-xml-file-number
     1993       .
     1994       run bgelib-write-edt( hEDT, 1, string("Фирма :") + string( p-host-code ) ).
     1995       run day-begin-fact-order in this-procedure (
     1996                                                     input  p-date-from
     1997                                                     ,output v-fact-order-from
     1998                                                     ) no-error .
     1999       if error-status :error
     2000       then do:
     2001           message
     2002             vss-workfile vss-revision vss-description
     2003             skip "Ошибка определения границ fact-order для поиска"
     2004             skip return-value
     2005             skip trim(error-status :get-message(1))
     2006                  trim(error-status :get-message(2))
     2007                  trim(error-status :get-message(3))
     2008           view-as alert-box error.
     2009           undo, return error .
     2010       end.
     2011       run factord-end-day  in this-procedure (
     2012                                                     input  p-date-to
     2013                                                     ,output v-fact-order-to
     2014                                                     ) no-error .
     2015       if error-status :error
     2016       then do:
     2017           message
     2018             vss-workfile vss-revision vss-description
     2019             skip "Ошибка определения границ fact-order для поиска"
     2020             skip return-value
     2021             skip trim(error-status :get-message(1))
     2022                  trim(error-status :get-message(2))
     2023                  trim(error-status :get-message(3))
     2024           view-as alert-box error.
     2025           undo, return error .
     2026       end.
     2027       find first buf_fin-doc no-lock where
     2028                 buf_fin-doc.host-code = p-host-code
     2029         AND buf_fin-doc.fact-order >= v-fact-order-from
     2030         AND buf_fin-doc.fact-order <= v-fact-order-to
     2031         AND buf_fin-doc.status_ = 'факт':U no-error .
     2032       if not available buf_fin-doc
     2033       then do:
     2034           run bgelib-write-edt( hEDT, 4, "В заданном диапазоне дат нет закрытых документов").
     2035           return .
     2036       end.
     2037       run bgelib-show-cnt(hCNT).
     2038       do v-oper-num = 1 to 6
     2039       :
     2040           if lookup( v-ext-fin-doc-type-list [v-oper-num * 2], p-doc-type-list ) <> 0
     2041           or p-doc-type-list = ""
     2042           then do:
     2043               run bge/fdocoper.p (
     2044                     input p-host-code
     2045                   , input v-ext-fin-doc-type-list [v-oper-num * 2]
     2046                   , input v-ext-fin-doc-type-list [v-oper-num * 2 - 1]
     2047                   , input v-fact-order-from
     2048                   , input v-fact-order-to
     2049                   , input p-doc-type-list
     2050                   , input p-obj-list
     2051                   , input p-db-num
     2052                   , input p-range
     2053                   , input p-mode
     2054                   , input v-parameter-list
     2055                   , input p-xml-file-name
     2056                   , input p-log-file-name
     2057                   , input p-list-file-name
     2058                   , input p-xml-file-number
     2059                   , input hEDT
     2060                   , input hCNT
     2061                   , output p-new-xml-file-name
     2062                   , output p-new-xml-file-number
     2063               ) no-error.
     2064               if error-status :error
     2065               then do:
     2066                   run bgelib-write-edt( hEDT, 1, string(return-value)).
     2067               end.
     2068               assign
     2069                   p-xml-file-name     = p-new-xml-file-name
     2070                   p-xml-file-number   = p-new-xml-file-number
     2071               .
     2072           end.
     2073       end.
     2074       run bgelib-show-cnt(hCNT).
     2075   end.
     2076   end procedure.
