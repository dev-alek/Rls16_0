      965   DEFINE INPUT PARAMETER p-location AS logical NO-UNDO.
      966   DEFINE INPUT PARAMETER p-categ-loc AS char NO-UNDO.
      967   DEFINE variable v-bonus-pay AS char NO-UNDO.
      968   DEFINE VARIABLE i-i AS INTEGER INITIAL 0 NO-UNDO.
      969   DEFINE VARIABLE i-j AS INTEGER INITIAL 0 NO-UNDO.
      970   DEFINE VARIABLE i-hh AS INTEGER INITIAL 0 NO-UNDO.
      971   DEFINE VARIABLE i-mm AS INTEGER INITIAL 0 NO-UNDO.
      972   DEFINE VARIABLE i-ss AS INTEGER INITIAL 0 NO-UNDO.
      973   DEFINE VARIABLE c-ch AS CHARACTER NO-UNDO.
      974   DEFINE VARIABLE i-gdscnt AS INTEGER INITIAL 0 NO-UNDO.
      975   DEFINE VARIABLE i-chkcnt AS INTEGER INITIAL 0 NO-UNDO.
      976   DEFINE VARIABLE i-numfile AS INTEGER INITIAL 0 NO-UNDO.
      977   DEFINE VARIABLE i-numline AS INTEGER INITIAL 0 NO-UNDO.
      978   DEFINE VARIABLE i-tender-code AS INTEGER INITIAL 0 NO-UNDO.
      979   DEFINE VARIABLE file_name AS CHARACTER NO-UNDO.
      980   DEFINE VARIABLE c-logname AS CHARACTER NO-UNDO.
      981   DEFINE VARIABLE c-value AS CHARACTER NO-UNDO.
      982   DEFINE VARIABLE c-type AS CHARACTER NO-UNDO.
      983   DEFINE VARIABLE c-locid AS CHARACTER NO-UNDO.
      984   DEFINE VARIABLE d-date AS DATE NO-UNDO.
      985   DEFINE VARIABLE i-shift AS INTEGER INITIAL 0 NO-UNDO.
      986   DEFINE VARIABLE i-op-id AS INTEGER INITIAL 0 NO-UNDO.
      987   DEFINE VARIABLE b-malina AS LOGICAL NO-UNDO.
      988   DEFINE VARIABLE b-ball-malina AS LOGICAL NO-UNDO.
      989   DEFINE VARIABLE c-locfile AS CHARACTER NO-UNDO.
      990   define variable v-attr-value    as character no-undo .
      991   define variable v-attr-type     as character no-undo .
      992   DEFINE BUFFER buf_gds-grp FOR gds-grp.
      993   DEFINE BUFFER buf_goods FOR goods.
      994   DEFINE BUFFER buf_shift-obj FOR ub.shift-obj.
      995   DEFINE BUFFER buf_previous-shift-obj FOR ub.shift-obj.
      996   DEFINE BUFFER buf_chk-doc FOR ub.chk-doc.
      997   DEFINE BUFFER buf_chk-gds-pay FOR ub.chk-gds-pay.
      998   DEFINE BUFFER buf_chk-gds FOR ub.chk-gds.
      999   DEFINE BUFFER buf_chk-pay FOR ub.chk-pay.
     1000   DEFINE BUFFER buf_clients FOR ub.clients.
     1001   DEFINE BUFFER buf_sysconf FOR ub.sysconf.
     1002   DEFINE BUFFER buf_bar-code FOR ub.bar-code.
     1003   DEFINE BUFFER buf_db-attr FOR ub.db-attr.
     1004   define BUFFER buf_cash-pay-attr FOR ub.cash-pay-attr.
     1005   DEFINE TEMP-TABLE tt_goods NO-UNDO
     1006       FIELD partner_id AS CHARACTER FORMAT "x(3)"
     1007       FIELD sku_id AS CHARACTER FORMAT "x(20)"
     1008       FIELD category_id AS CHARACTER FORMAT "x(20)"
     1009       FIELD parent_category_id AS CHARACTER FORMAT "x(20)"
     1010       FIELD descr AS CHARACTER FORMAT "x(50)"
     1011       FIELD long_descr AS CHARACTER FORMAT "x(150)"
     1012       FIELD error_code AS CHARACTER FORMAT "x(3)"
     1013       FIELD error_message AS CHARACTER FORMAT "x(30)"
     1014       .
     1015   DEFINE TEMP-TABLE tt_chk-doc no-undo
     1016       FIELD partner_id AS CHARACTER FORMAT "x(3)"
     1017       FIELD transaction_id AS CHARACTER FORMAT "x(20)"
     1018       FIELD transaction_line_number AS CHARACTER FORMAT "x(3)"
     1019       FIELD transaction_date AS CHARACTER
     1020       FIELD card_number AS CHARACTER FORMAT "x(16)"
     1021       FIELD card_barcode AS CHARACTER FORMAT "x(13)"
     1022       FIELD location_id AS CHARACTER FORMAT "x(20)"
     1023       FIELD tender_code AS CHARACTER FORMAT "x(5)"
     1024       FIELD total_sum AS CHARACTER FORMAT "x(19)"
     1025       FIELD invest_sum AS CHARACTER FORMAT "x(19)"
     1026       FIELD certificate_id AS CHARACTER FORMAT "x(13)"
     1027       FIELD transaction_descr AS CHARACTER FORMAT "x(30)"
     1028       FIELD location_descr AS CHARACTER FORMAT "x(50)"
     1029       FIELD sku_id AS CHARACTER FORMAT "x(20)"
     1030       FIELD sku_qty AS CHARACTER FORMAT "x(20)"
     1031       FIELD sku_price AS CHARACTER FORMAT "x(19)"
     1032       FIELD line_cost AS CHARACTER FORMAT "x(19)"
     1033       FIELD sku_descr AS CHARACTER FORMAT "x(50)"
     1034       FIELD transaction_attrs AS CHARACTER FORMAT "x(550)"
     1035       FIELD standard_points AS CHARACTER FORMAT "x(19)"
     1036       FIELD bonus_points AS CHARACTER FORMAT "x(19)"
     1037       FIELD error_code AS CHARACTER FORMAT "x(3)"
     1038       FIELD error_message AS CHARACTER FORMAT "x(30)"
     1039       .
     1040   def buffer  buf-tt_chk-doc for tt_chk-doc.
     1041   def var l-cash as log no-undo.
     1042   def var l-bank as log no-undo.
     1043   def var l-bonus as log no-undo.
     1044   def var l-visa as log no-undo.
     1045   def var l-master as log no-undo.
     1046   def var l-maestro as log no-undo.
     1047   def var l-reiff as log no-undo.
     1048   def var sum-bonus as dec format '>>>>>>>>9' no-undo.
     1049   c-logname = p-directory + "exp-malina.txt".
     1050   run write-log-and-file in p-log-handle     (input 1, input c-logname, input 1, input substitute("Начало выгрузки данных в Малину")).
     1051   IF p-goods THEN DO:
     1052   def var i-cg as int no-undo format '>>>>>>>>9'.
     1053           run write-log-and-file in p-log-handle     (input 1, input c-logname, input 1, input substitute("Начало выгрузки товарного классификатора")).
     1054       FIND FIRST buf_db-attr WHERE buf_db-attr.db-num = g#db-num AND buf_db-attr.attr-code = 'malina-goods' NO-ERROR.
     1055       IF AVAILABLE buf_db-attr THEN DO:
     1056           IF TODAY = DATE(ENTRY(1,buf_db-attr.attr-value)) THEN do:
     1057               i-numfile = INTEGER(ENTRY(2,buf_db-attr.attr-value)) + 1.
     1058               IF i-numfile < p-diapmin THEN i-numfile = p-diapmin.
     1059           end.
     1060           ELSE
     1061               i-numfile = p-diapmin.
     1062       END.
     1063       ELSE DO:
     1064           CREATE buf_db-attr.
     1065           ASSIGN
     1066               buf_db-attr.db-num = g#db-num
     1067               buf_db-attr.attr-code = 'malina-goods'
     1068               buf_db-attr.attr-value = STRING(TODAY) + ",0"
     1069               i-numfile = p-diapmin.
     1070       END.
     1071       RUN bge/exp-malina-lockattr.p
     1072           ( input g#db-num
     1073           ,input "malina-goods":U
     1074           ,buffer buf_db-attr
     1075           ) NO-ERROR.
     1076       IF ERROR-STATUS:ERROR THEN DO:
     1077           MESSAGE
     1078               vss-workfile vss-revision vss-description SKIP
     1079               SUBSTITUTE( "Ошибка при блокировке атрибута БД" ) SKIP
     1080               RETURN-VALUE SKIP
     1081               ERROR-STATUS:GET-MESSAGE ( ERROR-STATUS:NUM-MESSAGES )
     1082               VIEW-AS ALERT-BOX ERROR
     1083               .
     1084           RETURN ERROR .
     1085       END.
     1086       FOR EACH buf_gds-grp where node-code > 1 NO-LOCK:
     1087           CREATE tt_goods.
     1088           ASSIGN
     1089               tt_goods.partner_id = STRING(p-company,"999")
     1090               tt_goods.sku_id = ''
     1091               tt_goods.category_id = STRING(buf_gds-grp.node-code) + '_' + STRING(p-category)
     1092               tt_goods.parent_category_id = IF buf_gds-grp.upper-code <= 1 THEN STRING(p-categ-loc) ELSE STRING(buf_gds-grp.upper-code) + '_' + STRING(p-category)
     1093               tt_goods.descr = buf_gds-grp.node-name
     1094               tt_goods.long_descr = ''
     1095               tt_goods.error_code = ''
     1096               tt_goods.error_message = ''
     1097               NO-ERROR.
     1098       END.
     1099       FOR EACH buf_goods WHERE buf_goods.stts = 0 NO-LOCK:
     1100           CREATE tt_goods.
     1101           ASSIGN
     1102               tt_goods.partner_id = STRING(p-company,"999")
     1103               tt_goods.sku_id = STRING(buf_goods.gds-code) + '_' + STRING(p-category)
     1104               tt_goods.category_id = STRING(buf_goods.grp-code) + '_' + STRING(p-category)
     1105               tt_goods.parent_category_id = ''
     1106               tt_goods.descr = buf_goods.gds-name
     1107               tt_goods.long_descr = ''
     1108               tt_goods.error_code = ''
     1109               tt_goods.error_message = ''
     1110               NO-ERROR.
     1111       END.
     1112           run write-log-and-file in p-log-handle     (input 1, input c-logname, input 1, input substitute("Сохраняем товарный классификатор в файл.")).
     1113       file_name = p-directory + STRING(p-company,"999") + 'cg' + STRING(YEAR(TODAY), "9999") + STRING(MONTH(TODAY), "99") + STRING(DAY(TODAY), "99") + STRING(i-numfile, "999") + '.lsp'.
     1114       OUTPUT TO VALUE(file_name).
     1115       i-i = 0.
     1116       FOR EACH tt_goods NO-LOCK:
     1117           ASSIGN
     1118               i-i = i-i + 1
     1119               i-gdscnt = i-gdscnt + 1
     1120               c-ch = tt_goods.partner_id + CHR(59) +
     1121                   tt_goods.sku_id  + CHR(59) +
     1122                   tt_goods.category_id + CHR(59) +
     1123                   tt_goods.parent_category_id + CHR(59) +
     1124                   tt_goods.descr + CHR(59) +
     1125                   tt_goods.long_descr + CHR(59) +
     1126                   tt_goods.error_code + CHR(59) +
     1127                   tt_goods.error_message.
     1128           PUT UNFORMATTED c-ch SKIP.
     1129           i-cg = i-cg + 1.
     1130           IF i-i >= 1000000 THEN DO:
     1131               OUTPUT CLOSE.
     1132               i-numfile = i-numfile + 1.
     1133               IF i-numfile > p-diapmax THEN DO:
     1134                   MESSAGE
     1135                       vss-workfile vss-revision vss-description SKIP
     1136                       SUBSTITUTE( "Превышен диапазон при выгрузке товарного классификатора!" ) SKIP
     1137                       RETURN-VALUE SKIP
     1138                       ERROR-STATUS:GET-MESSAGE ( ERROR-STATUS:NUM-MESSAGES )
     1139                       VIEW-AS ALERT-BOX ERROR
     1140                       .
     1141                   RETURN ERROR .
     1142               END.
     1143               file_name = p-directory + STRING(p-company,"999") + 'cg' + STRING(YEAR(TODAY), "9999") + STRING(MONTH(TODAY), "99") + STRING(DAY(TODAY), "99") + STRING(i-numfile, "999") + '.lsp'.
     1144               OUTPUT TO VALUE(file_name).
     1145           END.
     1146       END.
     1147       OUTPUT CLOSE.
     1148       file_name = p-directory + STRING(p-company,"999") + 'cg' + STRING(YEAR(TODAY), "9999") + STRING(MONTH(TODAY), "99") + STRING(DAY(TODAY), "99") + STRING(i-numfile, "999") + '.ok'.
     1149       OUTPUT TO VALUE(file_name).
     1150       put UNFORMATTED i-cg skip.
     1151       OUTPUT CLOSE.
     1152       buf_db-attr.attr-value = STRING(TODAY) + "," + string(i-numfile).
     1153       RELEASE db-attr.
     1154           run write-log-and-file in p-log-handle     (input 1, input c-logname, input 1, input substitute("Выгрузка товарного классификатора завершена.")).
     1155   END.
     1156   IF p-location OR p-chk THEN DO:
     1157           run write-log-and-file in p-log-handle     (input 1, input c-logname, input 1, input substitute("Начало загрузки мэппинга локаций")).
     1158       c-locfile = p-directory + 'location.inf'.
     1159       FILE-INFO:FILE-NAME = c-locfile.
     1160       IF FILE-INFO:FULL-PATHNAME = ? THEN DO:
     1161                   run write-log-and-file in p-log-handle     (input 1, input c-logname, input 1, input substitute("Файл локаций не найден. (&1)", c-locfile)).
     1162       END.
     1163       ELSE DO:
     1164           INPUT FROM VALUE (c-locfile).
     1165           REPEAT:
     1166               IMPORT UNFORMATTED c-ch.
     1167               IF NUM-ENTRIES(c-ch,';') = 2 THEN DO:
     1168                   CREATE tt-location_id.
     1169                   ASSIGN
     1170                       tt-location_id.new-code = ENTRY(1,c-ch,';')
     1171                       tt-location_id.old-code = ENTRY(2,c-ch,';')
     1172                       .
     1173               END.
     1174           END.
     1175           INPUT CLOSE.
     1176                   run write-log-and-file in p-log-handle     (input 1, input c-logname, input 1, input substitute("Файл локаций загружен. (&1)", c-locfile)).
     1177       END.
     1178   END.
     1179   IF p-location THEN DO:
     1180       FIND FIRST buf_db-attr WHERE buf_db-attr.db-num = g#db-num AND buf_db-attr.attr-code = 'malina-location':U NO-ERROR.
     1181       IF AVAILABLE buf_db-attr THEN DO:
     1182           IF TODAY = DATE(ENTRY(1,buf_db-attr.attr-value)) THEN do:
     1183               i-numfile = INTEGER(ENTRY(2,buf_db-attr.attr-value)) + 1.
     1184               IF i-numfile < p-diapmin THEN i-numfile = p-diapmin.
     1185           end.
     1186           ELSE
     1187               i-numfile = p-diapmin.
     1188       END.
     1189       ELSE DO:
     1190           CREATE buf_db-attr.
     1191           ASSIGN
     1192               buf_db-attr.db-num = g#db-num
     1193               buf_db-attr.attr-code = 'malina-location':U
     1194               buf_db-attr.attr-value = STRING(TODAY) + ",0"
     1195               i-numfile = p-diapmin.
     1196       END.
     1197       file_name = p-directory + STRING(p-company,"999") + 'co' + STRING(YEAR(TODAY), "9999") + STRING(MONTH(TODAY), "99") + STRING(DAY(TODAY), "99") + STRING(i-numfile, "999") + '.lsp'.
     1198       OUTPUT TO VALUE(file_name).
     1199       RUN bge/exp-malina-lockattr.p
     1200           ( input g#db-num
     1201           ,input "malina-location":U
     1202           ,buffer buf_db-attr
     1203           ) NO-ERROR.
     1204       IF ERROR-STATUS:ERROR THEN DO:
     1205           MESSAGE
     1206               vss-workfile vss-revision vss-description SKIP
     1207               SUBSTITUTE( "Ошибка при блокировке атрибута БД" ) SKIP
     1208               RETURN-VALUE SKIP
     1209               ERROR-STATUS:GET-MESSAGE ( ERROR-STATUS:NUM-MESSAGES )
     1210               VIEW-AS ALERT-BOX ERROR
     1211               .
     1212           RETURN ERROR .
     1213       END.
     1214      def var i-co as int format '>>>>>>>>9'.
     1215       for each ub.clients where obj-type = 'маг':U and ub.clients.stts = 0, first tt_obj where tt_obj.obj-type = clients.obj-type and tt_obj.obj-code = clients.obj-code  no-lock:
     1216           c-locid = p-categ-loc + string(ub.clients.obj-code).
     1217              FIND FIRST tt-location_id WHERE tt-location_id.new-code = c-locid  NO-LOCK NO-ERROR.
     1218                       IF AVAILABLE tt-location_id THEN c-locid = tt-location_id.old-code.
     1219           c-ch = STRING(p-company,"999") + CHR(59) + CHR(59) +
     1220                   c-locid  + CHR(59) +
     1221                   STRING(p-categ-loc) + CHR(59) +
     1222                   clients.obj-name + CHR(59) +  clients.obj-name + CHR(59)  + CHR(59).
     1223           PUT UNFORMATTED c-ch SKIP.
     1224           i-co = i-co + 1.
     1225           for each cash-desk no-lock where
     1226               cash-desk.obj-code = clients.obj-code and
     1227               cash-desk.is-del = no:
     1228               c-locid = string(ub.clients.obj-code) + '_':U + string(cash-desk.cash-num) + '_' + STRING(p-categ-loc).
     1229               FIND FIRST tt-location_id WHERE tt-location_id.new-code = c-locid  NO-LOCK NO-ERROR.
     1230               IF AVAILABLE tt-location_id THEN c-locid = tt-location_id.old-code.
     1231               c-ch = STRING(p-company,"999") + CHR(59) + c-locid  +
     1232                   CHR(59) + p-categ-loc + string(ub.clients.obj-code) + CHR(59) + CHR(59) +
     1233                   clients.obj-name + ' cassa ' + string(cash-desk.cash-num) + CHR(59) +  CHR(59)  + CHR(59).
     1234               PUT UNFORMATTED c-ch SKIP.
     1235               i-co = i-co + 1.
     1236           end.
     1237       end.
     1238       OUTPUT CLOSE.
     1239   file_name = p-directory + STRING(p-company,"999") + 'co' + STRING(YEAR(TODAY), "9999") + STRING(MONTH(TODAY), "99") + STRING(DAY(TODAY), "99") + STRING(i-numfile, "999") + '.ok'.
     1240       OUTPUT TO VALUE(file_name).
     1241       put UNFORMATTED i-co skip.
     1242       OUTPUT CLOSE.
     1243       buf_db-attr.attr-value = STRING(TODAY) + "," + string(i-numfile).
     1244       RELEASE db-attr.
     1245           run write-log-and-file in p-log-handle     (input 1, input c-logname, input 1, input substitute("Выгрузка классификатора объектов(локаций) завершена.")).
     1246   END.
     1247   IF p-chk THEN DO:
     1248           run write-log-and-file in p-log-handle     (input 1, input c-logname, input 1, input substitute("Начало выгрузки чеков")).
     1249       FIND FIRST db-attr WHERE db-attr.db-num = g#db-num AND db-attr.attr-code = 'malina-chk' NO-ERROR.
     1250       IF AVAILABLE db-attr THEN DO:
     1251           IF TODAY = DATE(ENTRY(1,db-attr.attr-value)) THEN do:
     1252               i-numfile = INTEGER(ENTRY(2,db-attr.attr-value)) + 1.
     1253               IF i-numfile < p-diapmin THEN i-numfile = p-diapmin.
     1254           end.
     1255           ELSE
     1256               i-numfile = p-diapmin.
     1257       END.
     1258       ELSE DO:
     1259           CREATE db-attr.
     1260           ASSIGN
     1261               db-attr.db-num = g#db-num
     1262               db-attr.attr-code = 'malina-chk'
     1263               db-attr.attr-value = STRING(TODAY) + ",0"
     1264               i-numfile = p-diapmin.
     1265       END.
     1266               FOR EACH buf_cash-pay-attr where buf_cash-pay-attr.attr-code  = "bal_malina" and
     1267                                                  buf_cash-pay-attr.attr-value = "yes":
     1268               if v-bonus-pay = "" then do:
     1269                     v-bonus-pay = string(buf_cash-pay-attr.cdpay-code).
     1270                   end.
     1271                   else v-bonus-pay = v-bonus-pay + "," + string(buf_cash-pay-attr.cdpay-code).
     1272               END.
     1273       for each tt_obj no-lock:
     1274           run clntattr-value in this-procedure (input tt_obj.obj-type,
     1275                                                 input tt_obj.obj-code,
     1276                                                 input 'bge-exp-malina-last-shift':U,
     1277                                                 output c-value,
     1278                                                 output c-type) NO-ERROR.
     1279           if c-value = "" then do:
     1280               c-value = "1/1/1900,1,1".
     1281               run clntattr-write in this-procedure (input tt_obj.obj-type,
     1282                                                     input tt_obj.obj-code,
     1283                                                     input 'bge-exp-malina-last-shift':U,
     1284                                                     input c-value) NO-ERROR.
     1285           end.
     1286           if error-status:error then do:
     1287                           run write-log-and-file in p-log-handle     (input 1, input c-logname, input 1, input substitute("Ошибка в атрибуте объекта. Объект &1&2",tt_obj.obj-type,tt_obj.obj-code)).
     1288               next.
     1289           end.
     1290           assign
     1291               d-date = date(entry(1,c-value,","))
     1292               i-shift = integer(entry(2,c-value,","))
     1293               i-op-id = integer(entry(3,c-value,",")) NO-ERROR.
     1294           for each buf_shift-obj where buf_shift-obj.obj-type = tt_obj.obj-type
     1295                                  and buf_shift-obj.obj-code = tt_obj.obj-code
     1296                                  and ((buf_shift-obj.shift-date = d-date
     1297                                           and buf_shift-obj.shift-num > i-shift)
     1298                                       or buf_shift-obj.shift-date > d-date)
     1299                                  and buf_shift-obj.status_ = 'зкр':U
     1300                                  use-index stts no-lock:
     1301               run rep/rpychk0.p (input "r-ptrsp2",
     1302                                  input buf_shift-obj.obj-type,
     1303                                  input buf_shift-obj.obj-code,
     1304                                  input ?,
     1305                                  input ?,
     1306                                  input buf_shift-obj.shift-date,
     1307                                  input ?,
     1308                                  input buf_shift-obj.shift-num,
     1309                                  input ?,
     1310                                  input ?).
     1311               FIND FIRST buf_clients WHERE buf_clients.obj-type = buf_shift-obj.obj-type
     1312                                        AND buf_clients.obj-code = buf_shift-obj.obj-code NO-LOCK NO-ERROR.
     1313               IF AVAILABLE buf_clients THEN DO:
     1314                   FIND FIRST buf_sysconf WHERE buf_sysconf.host-code = buf_clients.host-code NO-LOCK NO-ERROR.
     1315               END.
     1316               FOR EACH buf_chk-doc WHERE buf_chk-doc.obj-type = buf_shift-obj.obj-type
     1317                                          AND buf_chk-doc.obj-code = buf_shift-obj.obj-code
     1318                                          AND buf_chk-doc.shift-date = buf_shift-obj.shift-date
     1319                                          AND buf_chk-doc.shift-num = buf_shift-obj.shift-num
     1320                                          and (string(buf_chk-doc.chk-type)  = '1':U or string(buf_chk-doc.chk-type)  = '6':U) NO-LOCK:
     1321                   ASSIGN
     1322                       i-numline = 0
     1323                       b-malina = FALSE
     1324                                           b-ball-malina = FALSE
     1325                       .
     1326                   DO i-i = 1 TO NUM-ENTRIES (p-prefix):
     1327                       IF buf_chk-doc.d-card BEGINS ENTRY ( i-i, p-prefix) THEN b-malina = TRUE.
     1328                   END.
     1329                  DO i-j = 1 TO NUM-ENTRIES (v-bonus-pay):
     1330                       if CAN-FIND (ub.chk-pay where chk-pay.doc-code = buf_chk-doc.doc-code and chk-pay.pay-code = int(ENTRY (i-j,v-bonus-pay,",")) no-lock) then do:
     1331                            b-ball-malina = TRUE.
     1332                       end.
     1333                  end.
     1334                   IF b-malina  or b-ball-malina THEN DO:
     1335                       ASSIGN
     1336                           i-hh = TRUNCATE(buf_chk-doc.chk-time / 3600, 0)
     1337                           i-mm = TRUNCATE((buf_chk-doc.chk-time - (i-hh * 3600)) / 60, 0)
     1338                           i-ss = TRUNCATE((buf_chk-doc.chk-time - (i-hh * 3600) - (i-mm * 60)) / 60, 0).
     1339                       c-ch = STRING(buf_chk-doc.obj-code) + "_" + STRING(buf_chk-doc.pay-desk) + '_' + STRING(p-categ-loc).
     1340                       FOR FIRST tt-location_id WHERE tt-location_id.new-code = c-ch NO-LOCK:
     1341                           c-ch = tt-location_id.old-code.
     1342                       END.
     1343                       CREATE tt_chk-doc.
     1344                       ASSIGN
     1345                           tt_chk-doc.partner_id = STRING(p-company,"999")
     1346                           tt_chk-doc.transaction_id = STRING(buf_chk-doc.doc-code) + '_' + STRING(p-category)
     1347                           tt_chk-doc.transaction_line_number = "0"
     1348                           tt_chk-doc.transaction_date = STRING(YEAR(buf_chk-doc.chk-date),"9999") + STRING(MONTH(buf_chk-doc.chk-date), "99") + STRING(DAY(buf_chk-doc.chk-date), "99") +
     1349                                                         STRING(i-hh,"99") + STRING(i-mm ,"99") + STRING(i-ss ,"99")
     1350                           tt_chk-doc.card_number = IF LENGTH(buf_chk-doc.src-d-card) = 16 THEN buf_chk-doc.src-d-card ELSE ""
     1351                           tt_chk-doc.card_barcode = IF LENGTH(buf_chk-doc.src-d-card) = 13 THEN buf_chk-doc.src-d-card ELSE ""
     1352                           tt_chk-doc.location_id = c-ch
     1353                           tt_chk-doc.total_sum = STRING(int(buf_chk-doc.netto * 100))
     1354                           tt_chk-doc.invest_sum = string(int(buf_chk-doc.netto))
     1355                           tt_chk-doc.certificate_id = ""
     1356                           tt_chk-doc.transaction_descr = ""
     1357                           tt_chk-doc.location_descr = ""
     1358                           tt_chk-doc.sku_id = ""
     1359                           tt_chk-doc.sku_qty = ""
     1360                           tt_chk-doc.sku_price = ""
     1361                           tt_chk-doc.line_cost = ""
     1362                           tt_chk-doc.sku_descr = ""
     1363                           tt_chk-doc.transaction_attrs = ""
     1364                           tt_chk-doc.standard_points = ""
     1365                           tt_chk-doc.bonus_points = ""
     1366                           tt_chk-doc.error_code = ""
     1367                           tt_chk-doc.error_message = ""
     1368                           .
     1369                       assign
     1370                       l-cash = no
     1371                       l-bank = no
     1372                       l-bonus = no
     1373                       sum-bonus = 0
     1374                       l-visa = no
     1375                       l-master = no
     1376                       l-maestro = no
     1377                       l-reiff = no
     1378                       i-tender-code = 0
     1379                           .
     1380                       FOR EACH buf_chk-gds-pay WHERE buf_chk-gds-pay.doc-code = buf_chk-doc.doc-code NO-LOCK:
     1381                           i-numline = i-numline + 1.
     1382                           FIND FIRST buf_bar-code WHERE buf_bar-code.b-code = buf_chk-gds-pay.b-code NO-LOCK NO-ERROR.
     1383                           run gds-attr-value in this-procedure
     1384                               ( input  buf_bar-code.gds-code
     1385                               , input  'ban-bonus':U
     1386                               , output v-attr-value
     1387                               , output v-attr-type
     1388                               ) .
     1389                           if lookup(v-attr-value, 'true,yes':u) > 0 then do:
     1390                           assign
     1391                               tt_chk-doc.total_sum = STRING(int(tt_chk-doc.total_sum) - int(buf_chk-gds-pay.tot-r-b * 100 ))
     1392                               tt_chk-doc.invest_sum = string(int(tt_chk-doc.invest_sum) - int(buf_chk-gds-pay.tot-r-b))
     1393                               .
     1394                               next .
     1395                           end.
     1396                           CREATE buf-tt_chk-doc.
     1397                           ASSIGN
     1398                               buf-tt_chk-doc.partner_id = STRING(p-company,"999")
     1399                               buf-tt_chk-doc.transaction_id = STRING(buf_chk-doc.doc-code) + '_' + STRING(p-category)
     1400                               buf-tt_chk-doc.transaction_line_number = STRING(i-numline)
     1401                               buf-tt_chk-doc.transaction_date = ""
     1402                               buf-tt_chk-doc.card_number = ""
     1403                               buf-tt_chk-doc.card_barcode = ""
     1404                               buf-tt_chk-doc.location_id = ""
     1405                               buf-tt_chk-doc.tender_code = ""
     1406                               buf-tt_chk-doc.total_sum = ""
     1407                               buf-tt_chk-doc.invest_sum = ""
     1408                               buf-tt_chk-doc.certificate_id = ""
     1409                               buf-tt_chk-doc.transaction_descr = ""
     1410                               buf-tt_chk-doc.location_descr = ""
     1411                               buf-tt_chk-doc.sku_id = IF AVAILABLE buf_bar-code THEN STRING(buf_bar-code.gds-code) + '_' + STRING(p-category) ELSE ""
     1412                               buf-tt_chk-doc.sku_qty = LEFT-TRIM(STRING(buf_chk-gds-pay.eff-doc-qnty, "->>>>>>>>>.9999"))
     1413                               buf-tt_chk-doc.sku_price = STRING(buf_chk-gds-pay.price-base * 100)
     1414                               buf-tt_chk-doc.line_cost = STRING(int(buf_chk-gds-pay.tot-r-b * 100 ))
     1415                               buf-tt_chk-doc.sku_descr = ""
     1416                               buf-tt_chk-doc.transaction_attrs = ""
     1417                               buf-tt_chk-doc.standard_points = ""
     1418                               buf-tt_chk-doc.bonus_points = ""
     1419                               buf-tt_chk-doc.error_code = ""
     1420                               buf-tt_chk-doc.error_message = ""
     1421                               .
     1422                           if buf_chk-gds-pay.pay-code = buf_sysconf.cash-pay then l-cash = yes.
     1423                           else if lookup (string(buf_chk-gds-pay.pay-code), v-bonus-pay) > 0 then do:
     1424                               l-bonus = yes.
     1425                               sum-bonus = sum-bonus + (buf_chk-gds-pay.tot-r-b * 100 / buf_chk-gds-pay.eff-doc-qnty).
     1426                               tt_chk-doc.card_number = IF LENGTH(buf_chk-gds-pay.pay-card) = 16 THEN buf_chk-gds-pay.pay-card ELSE "".
     1427                               tt_chk-doc.card_barcode = IF LENGTH(buf_chk-gds-pay.pay-card) = 13 THEN buf_chk-gds-pay.pay-card ELSE "".
     1428                           end.
     1429                           else l-bank = yes.
     1430                           IF buf_chk-gds-pay.pay-card <> '0' and not  lookup (string(buf_chk-gds-pay.pay-code), v-bonus-pay) > 0 THEN DO:
     1431                               IF buf_chk-gds-pay.pay-card BEGINS '422287' THEN l-reiff = YES.
     1432                               ELSE IF buf_chk-gds-pay.pay-card BEGINS '4' THEN l-visa = YES.
     1433                               ELSE IF buf_chk-gds-pay.pay-card BEGINS '5' THEN l-master = YES.
     1434                               ELSE IF buf_chk-gds-pay.pay-card BEGINS '3' or buf_chk-gds-pay.pay-card BEGINS '6'  THEN l-maestro = YES.
     1435                           END.
     1436                       END.
     1437                       IF l-bank OR l-bonus THEN DO:
     1438                           i-tender-code = i-tender-code + 3.
     1439                           IF l-bonus THEN i-tender-code = i-tender-code + 8192.
     1440                           IF l-reiff THEN i-tender-code = i-tender-code + 2048.
     1441                           IF l-visa THEN i-tender-code = i-tender-code + 4.
     1442                           IF l-master THEN i-tender-code = i-tender-code + 8.
     1443                           IF l-maestro THEN i-tender-code = i-tender-code + 32.
     1444                           IF NOT l-bonus AND NOT l-reiff AND NOT l-visa AND NOT l-master AND NOT l-maestro THEN i-tender-code = i-tender-code + 1024.
     1445                       END.
     1446                       IF l-cash AND i-tender-code <> 0 THEN DO:
     1447                           i-tender-code = i-tender-code + 4096.
     1448                       END.
     1449                       tt_chk-doc.tender_code = STRING(i-tender-code).
     1450                   END.
     1451               END.
     1452               if not error-status:error then do:
     1453                   FIND FIRST tt_obj_shift WHERE tt_obj_shift.obj-type = tt_obj.obj-type
     1454                                             AND tt_obj_shift.obj-code = tt_obj.obj-code EXCLUSIVE-LOCK NO-ERROR.
     1455                   IF NOT AVAILABLE tt_obj_shift THEN DO:
     1456                       CREATE tt_obj_shift.
     1457                       ASSIGN
     1458                           tt_obj_shift.obj-type = tt_obj.obj-type
     1459                           tt_obj_shift.obj-code = tt_obj.obj-code.
     1460                   END.
     1461                   tt_obj_shift.shift-attr = substitute("&1,&2,&3", buf_shift-obj.shift-date,buf_shift-obj.shift-num,i-op-id).
     1462                                   run write-log-and-file in p-log-handle     (input 1, input c-logname, input 1, input substitute("Выборка чеков завершена. Объект &1&2, смена &3 за &4",                     tt_obj.obj-type,tt_obj.obj-code,buf_shift-obj.shift-num,buf_shift-obj.shift-date)).
     1463               end.
     1464               else do:
     1465                                   run write-log-and-file in p-log-handle     (input 1, input c-logname, input 1, input substitute( "На объекте &1&2 возникли ошибки. Дата: &3, Смена: &4",                     tt_obj.obj-type,tt_obj.obj-code,buf_shift-obj.shift-date,buf_shift-obj.shift-num)).
     1466                   leave.
     1467               end.
     1468           end.
     1469       end.
     1470           run write-log-and-file in p-log-handle     (input 1, input c-logname, input 1, input substitute("Сохраняем чеки в файл.")).
     1471       file_name = p-directory + STRING(p-company,"999") + 'tr' + STRING(YEAR(TODAY), "9999") + STRING(MONTH(TODAY), "99") + STRING(DAY(TODAY), "99") + STRING(i-numfile, "999") + '.lsp'.
     1472       OUTPUT TO VALUE(file_name).
     1473       i-i = 0.
     1474       FOR EACH tt_chk-doc where ( tt_chk-doc.transaction_line_number = "0" and int(total_sum) <> 0 and int(total_sum) <> ?) or tt_chk-doc.transaction_line_number <> "0" NO-LOCK:
     1475           IF i-i >= 299990 and int(tt_chk-doc.transaction_line_number) = 0  THEN DO:
     1476               OUTPUT CLOSE.
     1477               file_name = p-directory + STRING(p-company,"999") + 'tr' + STRING(YEAR(TODAY), "9999") + STRING(MONTH(TODAY), "99") + STRING(DAY(TODAY), "99") + STRING(i-numfile, "999") + '.ok'.
     1478               OUTPUT TO VALUE(file_name).
     1479               put unformatted i-i skip.
     1480               OUTPUT CLOSE.
     1481               i-numfile = i-numfile + 1.
     1482               IF i-numfile > p-diapmax THEN DO:
     1483                   MESSAGE
     1484                       vss-workfile vss-revision vss-description SKIP
     1485                       SUBSTITUTE( "Превышен диапазон при выгрузке чеков!" ) SKIP
     1486                       RETURN-VALUE SKIP
     1487                       ERROR-STATUS:GET-MESSAGE ( ERROR-STATUS:NUM-MESSAGES )
     1488                       VIEW-AS ALERT-BOX ERROR
     1489                       .
     1490                   RETURN ERROR .
     1491               END.
     1492               file_name = p-directory + STRING(p-company,"999") + 'tr' + STRING(YEAR(TODAY), "9999") + STRING(MONTH(TODAY), "99") + STRING(DAY(TODAY), "99") + STRING(i-numfile, "999") + '.lsp'.
     1493               OUTPUT TO VALUE(file_name).
     1494               i-i = 0.
     1495           END.
     1496           ASSIGN
     1497               i-i = i-i + 1
     1498               i-chkcnt = i-chkcnt + 1
     1499               c-ch = tt_chk-doc.partner_id + CHR(59) +
     1500                   tt_chk-doc.transaction_id  + CHR(59) +
     1501                   tt_chk-doc.transaction_line_number + CHR(59) +
     1502                   tt_chk-doc.transaction_date + CHR(59) +
     1503                   tt_chk-doc.card_number + CHR(59) +
     1504                   tt_chk-doc.card_barcode + CHR(59) +
     1505                   tt_chk-doc.location_id + CHR(59) +
     1506                   tt_chk-doc.tender_code + CHR(59) +
     1507                   tt_chk-doc.total_sum + CHR(59) +
     1508                   tt_chk-doc.invest_sum + CHR(59) +
     1509                   tt_chk-doc.certificate_id + CHR(59) +
     1510                   tt_chk-doc.transaction_descr + CHR(59) +
     1511                   tt_chk-doc.location_descr + CHR(59) +
     1512                   tt_chk-doc.sku_id + CHR(59) +
     1513                   tt_chk-doc.sku_qty + CHR(59) +
     1514                   tt_chk-doc.sku_price + CHR(59) +
     1515                   tt_chk-doc.line_cost + CHR(59) +
     1516                   tt_chk-doc.sku_descr + CHR(59) +
     1517                   tt_chk-doc.transaction_attrs + CHR(59) +
     1518                   tt_chk-doc.standard_points + CHR(59) +
     1519                   tt_chk-doc.bonus_points + CHR(59) +
     1520                   tt_chk-doc.error_code + CHR(59) +
     1521                   tt_chk-doc.error_message.
     1522           PUT UNFORMATTED c-ch SKIP.
     1523       END.
     1524       OUTPUT CLOSE.
     1525       FOR EACH tt_obj_shift NO-LOCK:
     1526           run clntattr-write in this-procedure (input tt_obj_shift.obj-type,
     1527                                                 input tt_obj_shift.obj-code,
     1528                                                 input 'bge-exp-malina-last-shift':U,
     1529                                                 input tt_obj_shift.shift-attr) NO-ERROR.
     1530           if error-status:error then do:
     1531                           run write-log-and-file in p-log-handle     (input 1, input c-logname, input 1, input substitute("Ошибка записи атрибута. Объект &1&2, смена &3 за &4.&5",                 tt_obj_shift.obj-type,tt_obj_shift.obj-code,entry(2,tt_obj_shift.shift-attr,","),date(entry(1,tt_obj_shift.shift-attr,",")),return-value + error-status:get-message(1) )).
     1532           end.
     1533       END.
     1534           run write-log-and-file in p-log-handle     (input 1, input c-logname, input 1, input substitute("Формируем файл-флаг.")).
     1535       file_name = p-directory + STRING(p-company,"999") + 'tr' + STRING(YEAR(TODAY), "9999") + STRING(MONTH(TODAY), "99") + STRING(DAY(TODAY), "99") + STRING(i-numfile, "999") + '.ok'.
     1536       OUTPUT TO VALUE(file_name).
     1537       put unformatted i-i skip.
     1538       OUTPUT CLOSE.
     1539       db-attr.attr-value = STRING(TODAY) + "," + string(i-numfile).
     1540       RELEASE db-attr.
     1541           run write-log-and-file in p-log-handle     (input 1, input c-logname, input 1, input substitute("Выгрузка чеков завершена.")).
     1542   END.
     1543   run write-log-and-file in p-log-handle     (input 1, input c-logname, input 1, input substitute("Экспорт данных в Малину завершён.")).
     1544   run write-log-and-file in p-log-handle     (input 1, input c-logname, input 1, input substitute("Процесс завершён.")).
