      323   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      324   procedure cur-time :
      325      define output parameter p-today as date      no-undo .
      326      define output parameter p-time  as integer   no-undo .
      327     do
      328     on error undo, return error
      329     :
      330       define variable v-date1 as date      no-undo .
      331       define variable v-date2 as date      no-undo .
      332       define variable v-time  as integer   no-undo .
      333       assign
      334         v-date1 = today
      335         v-time  = time
      336         v-date2 = today
      337       .
      338       if v-date1 <> v-date2
      339       then do:
      340         assign
      341           v-date1 = today
      342           v-time  = v-time
      343         .
      344       end.
      345       assign
      346         p-today = v-date1
      347         p-time  = v-time
      348       .
      349     end.
      350   end.
      351   function cur-time-date returns character
      352   :
      353     return string(today, '99/99/9999':U) .
      354   end.
      355   function cur-time-mjd returns decimal
      356   :
      357     define variable v-date as date      no-undo .
      358     define variable v-time as integer   no-undo .
      359     run cur-time in this-procedure
      360       (output v-date
      361       ,output v-time
      362       ) .
      363     return integer(v-date) - 2400002 + (v-time / 86400) .
      364   end.
      365   function cur-time-get-ending-index returns integer
      366   (input p-number as integer
      367   )
      368   :
      369     if p-number < 0
      370     or p-number = ?
      371     then do:
      372       return 1 .
      373     end.
      374     define variable v-rest as integer   no-undo .
      375     assign
      376       p-number = p-number modulo 100
      377     .
      378     if p-number < 20
      379     then do:
      380       assign
      381         v-rest = p-number
      382       .
      383     end.
      384     else do:
      385       assign
      386         v-rest = p-number modulo 10
      387       .
      388     end.
      389     case v-rest :
      390       when 1
      391       then do:
      392         return 2 .
      393       end.
      394       when 2 or
      395       when 3 or
      396       when 4
      397       then do:
      398         return 3 .
      399       end.
      400       otherwise do:
      401         return 1 .
      402       end.
      403     end case .
      404   end.
      405   procedure cur-time-mjd-to-date :
      406      define input  parameter i-mjd-diff as decimal no-undo.
      407      define output parameter o-Date     as date    no-undo.
      408      define output parameter o-Time     as integer no-undo.
      409      define variable v-day-number as integer   no-undo .
      410      if    i-mjd-diff < 0
      411         or i-mjd-diff = ?
      412      then do:
      413         return "?" .
      414      end.
      415      assign
      416         v-day-number = truncate(i-mjd-diff,0).
      417         o-Date = date(v-day-number + 2400002).
      418         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      419     .
      420   end.
      421   function cur-time-mjd-to-string returns character
      422   (input p-mjd-diff as decimal
      423   )
      424   :
      425     define variable v-day-number as integer   no-undo .
      426     define variable v-seconds    as integer   no-undo .
      427     define variable v-hour       as integer   no-undo .
      428     define variable v-min        as integer   no-undo .
      429     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      430     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      431     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      432     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      433     if p-mjd-diff < 0
      434     or p-mjd-diff = ?
      435     then do:
      436       return "?" .
      437     end.
      438     assign
      439       v-day-number = integer(truncate(p-mjd-diff,0))
      440       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      441     .
      442     if v-seconds > 86400
      443     then do:
      444       assign
      445         v-seconds = 86400 - 1
      446       .
      447     end.
      448     if v-seconds < 0
      449     then do:
      450       assign
      451         v-seconds = 0
      452       .
      453     end.
      454     assign
      455       v-hour = truncate(v-seconds / 3600, 0)
      456     .
      457     assign
      458       v-seconds = v-seconds modulo 3600
      459     .
      460     assign
      461       v-min = truncate(v-seconds / 60, 0)
      462     .
      463     assign
      464       v-seconds = v-seconds modulo 60
      465     .
      466     return
      467         (if v-day-number <> 0
      468           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      469           else ""
      470         )
      471       + (if v-day-number <> 0 or v-hour <> 0
      472           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      473           else ""
      474         )
      475       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      476           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      477           else ""
      478         )
      479       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      480       .
      481   end.
      482   function cur-time-string returns character
      483   :
      484     define variable v-date as date      no-undo .
      485     define variable v-time as integer   no-undo .
      486     run cur-time in this-procedure
      487       (output v-date
      488       ,output v-time
      489       ) .
      490     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      491   end.
      492   function cur-time-string-sec returns character
      493   :
      494     define variable v-date as date      no-undo .
      495     define variable v-time as integer   no-undo .
      496     run cur-time in this-procedure
      497       (output v-date
      498       ,output v-time
      499       ) .
      500     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      501   end.
      502   function cur-time-custom  returns character
      503   (input p-prefix as character
      504   ,input p-date-format as character
      505   ,input p-delimiter as character
      506   ,input p-time-format as character
      507   ,input p-suffix as character
      508   )
      509   :
      510     define variable v-date as date      no-undo .
      511     define variable v-time as integer   no-undo .
      512     run cur-time in this-procedure
      513       (output v-date
      514       ,output v-time
      515       ) .
      516     return
      517       p-prefix
      518       + string(v-date, p-date-format)
      519       + p-delimiter
      520       + string(v-time, p-time-format)
      521       + p-suffix
      522       .
      523   end.
      524   function cur-time-print  returns character
      525   :
      526     define variable v-date as date      no-undo .
      527     define variable v-time as integer   no-undo .
      528     run cur-time in this-procedure
      529       (output v-date
      530       ,output v-time
      531       ) .
      532     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      533   end.
      534   function cur-time-datetime returns datetime
      535   :
      536     define variable v-char as character no-undo .
      537     define variable v-datetime as datetime no-undo .
      538     v-char = cur-time-string().
      539     v-datetime = datetime(v-char).
      540     return  v-datetime.
      541   end.
      542   function cur-time-string-msec returns character
      543   :
      544     define variable v-date as datetime  no-undo .
      545     v-date = now.
      546     return string(v-date) .
      547   end.
      548   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      549   define temp-table temp-schedule-free no-undo
      550   field free-id as character
      551   field free-task-name as character
      552   field proc-run-name as character
      553   field proc-param-edit-name as character
      554   field conf-param as character
      555   field is-gbd as logical
      556   field is-ubd as logical
      557   field enable-concurrent-0 as logical
      558   field enable-concurrent-db as logical
      559   field other-info as character
      560   field enc-key as character
      561   field is-rum as logical
      562   index pi is unique primary
      563   free-id.
      564   procedure schedule-attr-name :
      565   do
      566     on error undo, return error
      567     :
      568     define input  parameter p-code           as character no-undo .
      569     define output parameter p-type           as character no-undo .
      570     define output parameter p-format         as character no-undo .
      571     define output parameter p-label          as character no-undo .
      572     define output parameter p-user-can-edit  as logical   no-undo .
      573     define output parameter p-output-display as logical   no-undo .
      574     define output parameter p-other          as character no-undo .
      575       if index(p-code, chr(4)) > 0 then do:
      576         p-code = entry(1, p-code, chr(4)).
      577       end.
      578       case p-code :
      579               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      580               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      581               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      582               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      583               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      584               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      585               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      586               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      587               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      588         otherwise do:
      589           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      590         end.
      591       end.
      592     end.
      593   end procedure.
      594   procedure schedule-attr-tooltip :
      595   do
      596     on error undo, return error
      597     :
      598       define input  parameter p-code    as character no-undo .
      599       define output parameter p-tooltip as character no-undo .
      600       define output parameter p-label   as character no-undo .
      601       if index(p-code, chr(4)) > 0 then do:
      602         p-code = entry(1, p-code, chr(4)).
      603       end.
      604       case p-code :
      605               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      606               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      607               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      608               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      609               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      610               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      611               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      612               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      613               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      614         otherwise do:
      615               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      616         end.
      617       end.
      618     end.
      619   end procedure.
      620   procedure schedule-attr-value :
      621   do
      622   on error undo, return error return-value
      623   :
      624   define input parameter  p-cre-db-num as integer    no-undo.
      625   define input parameter  p-task-type  as character  no-undo.
      626   define input parameter  p-task-num   as integer    no-undo.
      627   define input parameter  p-code       as character  no-undo.
      628   define output parameter p-value      as character  no-undo.
      629   define output parameter p-type       as character  no-undo.
      630       define variable v-format         as character no-undo .
      631       define variable v-label          as character no-undo .
      632       define variable v-user-can-edit  as logical   no-undo .
      633       define variable v-output-display as logical   no-undo .
      634       define variable v-other          as character no-undo .
      635       define buffer buf_schedule-attr for ub.schedule-attr.
      636       run schedule-attr-name in this-procedure (
      637             input  p-code
      638           , output p-type
      639           , output v-format
      640           , output v-label
      641           , output v-user-can-edit
      642           , output v-output-display
      643           , output v-other
      644       ) no-error .
      645       if error-status :error
      646       then do:
      647           undo, return error return-value .
      648       end.
      649       if p-code begins ('schd-free-id':U + chr(4))
      650       and entry(2, p-code, chr(4)) = '':U then do:
      651         find first buf_schedule-attr no-lock
      652             where buf_schedule-attr.cre-db-num = p-cre-db-num
      653               and buf_schedule-attr.task-type  = p-task-type
      654               and buf_schedule-attr.task-num   = p-task-num
      655               and buf_schedule-attr.attr-code  begins p-code
      656         no-error .
      657       end.
      658       else do:
      659         find first buf_schedule-attr no-lock
      660             where buf_schedule-attr.cre-db-num = p-cre-db-num
      661               and buf_schedule-attr.task-type  = p-task-type
      662               and buf_schedule-attr.task-num   = p-task-num
      663               and buf_schedule-attr.attr-code  = p-code
      664         no-error .
      665       end.
      666       if available buf_schedule-attr
      667       then do:
      668           assign
      669               p-value = buf_schedule-attr.attr-value
      670           .
      671       end.
      672       else do:
      673         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      674            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      675         end.
      676         else do:
      677           assign
      678               p-value = if p-type = 'L':U then "no":U else ""
      679           .
      680         end.
      681       end.
      682   end.
      683   end procedure.
      684   procedure schedule-attr-write :
      685   do
      686   on error undo, return error
      687   :
      688   define input parameter p-cre-db-num  as integer   no-undo.
      689   define input parameter p-task-type   as character no-undo.
      690   define input parameter p-task-num    as integer   no-undo.
      691   define input parameter p-code        as character no-undo.
      692   define input parameter p-value       as character no-undo.
      693       define variable v-type              as character                no-undo.
      694       define variable v-format            as character                no-undo.
      695       define variable v-label             as character                no-undo.
      696       define variable v-user-can-edit     as logical                  no-undo.
      697       define variable v-output-display    as logical                  no-undo.
      698       define variable v-other             as character                no-undo.
      699       define buffer buf_schedule-attr for ub.schedule-attr .
      700       run schedule-attr-name in this-procedure (
      701             input  p-code
      702           , output v-type
      703           , output v-format
      704           , output v-label
      705           , output v-user-can-edit
      706           , output v-output-display
      707           , output v-other
      708       ) no-error.
      709       if error-status :error
      710       then do:
      711           undo, return error return-value.
      712       end.
      713       find first buf_schedule-attr exclusive-lock
      714            where buf_schedule-attr.cre-db-num = p-cre-db-num
      715              and buf_schedule-attr.task-type  = p-task-type
      716              and buf_schedule-attr.task-num   = p-task-num
      717              and buf_schedule-attr.attr-code  = p-code
      718       no-error.
      719       if not available buf_schedule-attr
      720       then do:
      721           create buf_schedule-attr.
      722           assign
      723             buf_schedule-attr.cre-db-num = p-cre-db-num
      724             buf_schedule-attr.task-type  = p-task-type
      725             buf_schedule-attr.task-num   = p-task-num
      726             buf_schedule-attr.attr-code  = p-code
      727             buf_schedule-attr.attr-value = p-value
      728           .
      729       end.
      730       else do:
      731           assign
      732               buf_schedule-attr.attr-value = p-value
      733           .
      734       end.
      735   end.
      736   end procedure.
      737   procedure schedule-attr-delete :
      738   do
      739   on error undo, return error
      740   :
      741   define input  parameter p-cre-db-num  as integer   no-undo.
      742   define input  parameter p-task-type   as character no-undo.
      743   define input  parameter p-task-num    as integer   no-undo.
      744   define input  parameter p-code        as character no-undo.
      745   define output parameter p-deleted     as logical   no-undo.
      746       define buffer buf_schedule-attr for ub.schedule-attr .
      747       define variable v-type              as character                no-undo.
      748       define variable v-format            as character                no-undo.
      749       define variable v-label             as character                no-undo.
      750       define variable v-user-can-edit     as logical                  no-undo.
      751       define variable v-output-display    as logical                  no-undo.
      752       define variable v-other             as character                no-undo.
      753       run schedule-attr-name in this-procedure (
      754             input p-code
      755           , output v-type
      756           , output v-format
      757           , output v-label
      758           , output v-user-can-edit
      759           , output v-output-display
      760           , output v-other
      761       ) no-error .
      762       if error-status :error
      763       then do:
      764           undo, return error return-value .
      765       end.
      766       find first buf_schedule-attr exclusive-lock
      767            where buf_schedule-attr.cre-db-num = p-cre-db-num
      768              and buf_schedule-attr.task-type  = p-task-type
      769              and buf_schedule-attr.task-num   = p-task-num
      770              and buf_schedule-attr.attr-code  = p-code
      771       no-error.
      772       if not available buf_schedule-attr
      773       then do:
      774           assign
      775               p-deleted = no
      776           .
      777       end.
      778       else do:
      779           delete buf_schedule-attr.
      780           assign
      781               p-deleted = yes
      782           .
      783       end.
      784   end.
      785   end procedure.
      786   procedure schedule-attr-news :
      787   do
      788   on error undo, return error
      789   :
      790       define input  parameter p-code           as character no-undo .
      791       define output parameter p-news           as logical   no-undo .
      792       if index(p-code, chr(4)) > 0 then do:
      793         p-code = entry(1, p-code, chr(4)).
      794       end.
      795       case p-code :
      796               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      797               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      798               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      799               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      800               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      801               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      802               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      803               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      804               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      805         otherwise do:
      806           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      807         end.
      808       end.
      809   end.
      810   end procedure.
      811   procedure schedule-attr-extract-logical :
      812   do
      813   on error undo, return error
      814   :
      815   define input  parameter p-parameter-number   as integer      no-undo.
      816   define input  parameter p-parameter-list     as character    no-undo.
      817   define output parameter p-parameter-value   as logical      no-undo.
      818       if num-entries( p-parameter-list ) > p-parameter-number - 1
      819       then do:
      820           assign
      821               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      822           .
      823       end.
      824       else do:
      825           assign
      826               p-parameter-value   = no
      827           .
      828       end.
      829   end.
      830   end procedure.
      831   procedure schedule-attr-get-free-id :
      832   do
      833   on error undo, return error return-value
      834   :
      835     define input  parameter p-cre-db-num  as integer   no-undo.
      836     define input  parameter p-task-type   as character no-undo.
      837     define input  parameter p-task-num    as integer   no-undo.
      838     define output parameter p-free-id     as character no-undo.
      839     define buffer buf_schedule-attr for ub.schedule-attr.
      840     find first buf_schedule-attr no-lock
      841         where buf_schedule-attr.cre-db-num = p-cre-db-num
      842           and buf_schedule-attr.task-type  = p-task-type
      843           and buf_schedule-attr.task-num   = p-task-num
      844           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      845     no-error .
      846     if available buf_schedule-attr then
      847     assign
      848     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      849     no-error
      850     .
      851   end.
      852   end procedure.
      853   procedure schedule-attr-get-free-props :
      854     define input parameter p-free-id as character no-undo .
      855     define output parameter p-value as character no-undo .
      856     define buffer buf_temp-schedule-free for temp-schedule-free.
      857     do
      858     on error undo, return error return-value
      859     :
      860       find first buf_temp-schedule-free no-lock no-error .
      861       if not available buf_temp-schedule-free then do:
      862         run schedule-attr-fill-free-props in this-procedure .
      863       end.
      864       find first buf_temp-schedule-free where
      865               buf_temp-schedule-free.free-id = p-free-id no-error.
      866       if available buf_temp-schedule-free then do:
      867         assign
      868         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      869                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      870                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      871                   buf_temp-schedule-free.conf-param           + chr(4) +
      872                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      873                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      874                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      875                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      876                   buf_temp-schedule-free.other-info
      877         .
      878       end.
      879       else do:
      880        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      881                              "id произвольной задачи - &5"
      882                              ,vss-workfile
      883                              ,vss-revision
      884                              ,vss-description
      885                              ,chr(10)
      886                              ,p-free-id).
      887       end.
      888     end.
      889   end procedure.
      890   procedure schedule-attr-is-rum-free-id :
      891   define input parameter p-free-id as character no-undo .
      892   define output parameter p-is-rum as logical no-undo .
      893   define buffer buf_temp-schedule-free for temp-schedule-free.
      894   do
      895   on error undo, return error
      896   :
      897       find first buf_temp-schedule-free no-lock no-error .
      898       if not available buf_temp-schedule-free then do:
      899         run schedule-attr-fill-free-props in this-procedure .
      900       end.
      901       find first buf_temp-schedule-free where
      902               buf_temp-schedule-free.free-id = p-free-id no-error.
      903       if available buf_temp-schedule-free
      904       and buf_temp-schedule-free.is-rum
      905       then do:
      906         p-is-rum = yes.
      907       end.
      908   end.
      909   end procedure.
      910   procedure schedule-attr-fill-free-props :
      911   define variable v-path                    as character                no-undo .
      912   DEFINE VARIABLE v-full-path               as character                no-undo .
      913   DEFINE VARIABLE v-file-name               as character                no-undo .
      914   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      915   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      916   define buffer buf_temp-schedule-free for temp-schedule-free.
      917   define variable v-answer as logical no-undo .
      918     do
      919     on error undo, return error substitute("&1 &2 &3&4&5&4"
      920                                           ,vss-workfile
      921                                           ,vss-revision
      922                                           ,vss-description
      923                                           ,chr(10)
      924                                           ,error-status:get-message(1) )
      925     :
      926       run gbl/filename.p (
      927                       input 'cmp/shd-free.d'
      928                     ,output v-full-path
      929                     ,output v-path
      930                     ,output v-file-name
      931                     ,output v-file-name-no-ext
      932                     ,output v-file-name-ext
      933                     ) .
      934       input from value(v-full-path).
      935       repeat :
      936         create buf_temp-schedule-free.
      937         import buf_temp-schedule-free.
      938       END.
      939       input close.
      940       _ff:
      941       for each buf_temp-schedule-free :
      942         if buf_temp-schedule-free.free-id = '':U then do:
      943            delete buf_temp-schedule-free.
      944            next _ff.
      945          end.
      946          run schedule-attr-check-enc in this-procedure (
      947                                                       input  buf_temp-schedule-free.free-id
      948                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      949                                                               buf_temp-schedule-free.proc-param-edit-name +
      950                                                               buf_temp-schedule-free.conf-param +
      951                                                               string(buf_temp-schedule-free.is-gbd) +
      952                                                               string(buf_temp-schedule-free.is-ubd) +
      953                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      954                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      955                                                               string(buf_temp-schedule-free.other-info)
      956                                                               )
      957                                                       ,input  buf_temp-schedule-free.enc-key
      958                                                       ,output v-answer    ) no-error .
      959          if error-status:error
      960          or not v-answer then delete buf_temp-schedule-free.
      961        end.
      962     end.
      963   end procedure.
      964   Function schedule-attr-reverse returns character (str as character).
      965      define variable rev_incl_s as character init "" no-undo .
      966      define variable rev_incl_i as integer no-undo .
      967      define variable rev_incl_l as integer no-undo .
      968      rev_incl_l = length(str).
      969      do rev_incl_i = 1 to rev_incl_l:
      970         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      971      end.
      972      return rev_incl_s.
      973   end.
      974   procedure schedule-attr-check-enc.
      975     define input  parameter p-free-id   as character no-undo .
      976     define input  parameter p-value     as character no-undo .
      977     define input  parameter p-enc-value as character no-undo .
      978     define output parameter p-answer    as logical   no-undo .
      979     define variable tmp         as character no-undo .
      980     define variable v-enc-value as character no-undo .
      981     assign
      982     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      983     .
      984     run schedule-attr-pswd-enc in this-procedure
      985       ( input tmp
      986        ,output v-enc-value
      987       ) no-error .
      988     if error-status:error then do:
      989       message
      990         vss-workfile vss-revision vss-description skip
      991         "Ошибка при вызове процедуры pswd-enc" skip
      992         return-value skip
      993         error-status :get-message(1) skip
      994         view-as alert-box error .
      995       undo, return error .
      996     end.
      997     if v-enc-value = p-enc-value then do:
      998       assign
      999         p-answer = true
     1000       .
     1001     end.
     1002     else do:
     1003       assign
     1004         p-answer = false
     1005       .
     1006     end.
     1007   end.
     1008   procedure schedule-attr-conf-enc.
     1009     define input  parameter p-free-id   as character no-undo .
     1010     define input  parameter p-value     as character no-undo .
     1011     define output parameter p-enc-value as character no-undo .
     1012     define variable tmp         as character no-undo .
     1013     assign
     1014       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
     1015     .
     1016     run schedule-attr-pswd-enc in this-procedure
     1017       ( input tmp
     1018        ,output p-enc-value
     1019       ) no-error .
     1020     if error-status:error then do:
     1021       message
     1022         vss-workfile vss-revision vss-description skip
     1023         "Ошибка при вызове процедуры pswd-enc" skip
     1024         return-value skip
     1025         error-status :get-message(1) skip
     1026         view-as alert-box error .
     1027       undo, return error .
     1028     end.
     1029   end procedure.
     1030   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1031   procedure schedule-attr-pswd-enc :
     1032     define input parameter  pswd     as character no-undo .
     1033     define output parameter enc-pswd as character no-undo .
     1034     do
     1035     on error undo, return error return-value
     1036     :
     1037       assign
     1038         enc-pswd = encode(pswd + string(index(pswd, "k")))
     1039       .
     1040     end.
     1041   end procedure.
     1042   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO .
     1043   DEFINE INPUT PARAMETER p-curr-host-code LIKE ub.sysconf.host-code NO-UNDO .
     1044   DEFINE INPUT PARAMETER p-curr-obj-type  LIKE ub.clients.obj-type NO-UNDO .
     1045   DEFINE INPUT PARAMETER p-curr-obj-code  LIKE ub.clients.obj-code NO-UNDO .
     1046   DEFINE INPUT PARAMETER p-mode           AS CHARACTER NO-UNDO.
     1047   DEFINE INPUT PARAMETER p-db-num-char    AS CHARACTER    NO-UNDO.
     1048   DEFINE INPUT PARAMETER p-task-type      AS CHARACTER    NO-UNDO.
     1049   DEFINE INPUT PARAMETER p-task-num       AS INTEGER      NO-UNDO.
     1050   DEFINE INPUT PARAMETER p-action         AS CHARACTER    NO-UNDO.
     1051   DEFINE OUTPUT PARAMETER p-cancel        AS LOGICAL      NO-UNDO.
     1052   DEFINE OUTPUT PARAMETER p-params        AS CHARACTER    NO-UNDO.
     1053   define buffer buf_clients for ub.clients.
     1054   define variable c-dir as character no-undo.
     1055   define variable v-host-name as character no-undo.
     1056   define variable v-obj-list as character no-undo.
     1057   define variable v-param-list as character no-undo.
     1058   define variable v-param-type as character no-undo.
     1059   define variable ii as integer no-undo.
     1060   define variable v-entry as character no-undo.
     1061   define stream StreamLog.
     1062   DEFINE BUTTON b-close AUTO-END-KEY
     1063        LABEL "Отменить"
     1064        SIZE 15 BY 1.13.
     1065   DEFINE BUTTON b-dir
     1066        IMAGE-UP FILE "btn-down-arrow":U
     1067        IMAGE-DOWN FILE "btn-down-arrow":U
     1068        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1069        LABEL ""
     1070        SIZE 3 BY .88.
     1071   DEFINE BUTTON b-save
     1072        LABEL "Сохранить"
     1073        SIZE 15 BY 1.13.
     1074   DEFINE BUTTON b-start
     1075        LABEL "Запустить"
     1076        SIZE 15 BY 1.13.
     1077   DEFINE VARIABLE f-grp-fuel AS INTEGER FORMAT "->>>>>>9":U INITIAL 0
     1078        LABEL "Код группы для топлива"
     1079        VIEW-AS FILL-IN
     1080        SIZE 14 BY 1 NO-UNDO.
     1081   DEFINE VARIABLE f-grp-spec AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     1082        LABEL "Код группы для товаров, запрещенных к начислению"
     1083        VIEW-AS FILL-IN
     1084        SIZE 14 BY 1 NO-UNDO.
     1085   DEFINE VARIABLE v-company AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 39069
     1086        LABEL "Идентификатор компании"
     1087        VIEW-AS FILL-IN
     1088        SIZE 14 BY 1 NO-UNDO.
     1089   DEFINE VARIABLE v-directory AS CHARACTER FORMAT "X(256)":U
     1090        LABEL "Директория"
     1091        VIEW-AS FILL-IN
     1092        SIZE 22.5 BY 1 NO-UNDO.
     1093   DEFINE VARIABLE v-prefix AS CHARACTER FORMAT "X(256)":U
     1094        LABEL "Код региона~\Префикс для кодов"
     1095        VIEW-AS FILL-IN
     1096        SIZE 25.5 BY 1 NO-UNDO.
     1097   DEFINE FRAME gDialog
     1098        b-start AT ROW 1.25 COL 2 WIDGET-ID 8
     1099        b-save AT ROW 1.25 COL 49
     1100        b-close AT ROW 1.25 COL 65
     1101        v-company AT ROW 3.25 COL 30.5 COLON-ALIGNED WIDGET-ID 10
     1102        v-directory AT ROW 4.5 COL 30.5 COLON-ALIGNED WIDGET-ID 12
     1103        b-dir AT ROW 4.5 COL 55.13 WIDGET-ID 22
     1104        v-prefix AT ROW 5.75 COL 30.5 COLON-ALIGNED WIDGET-ID 6
     1105        f-grp-fuel AT ROW 7.5 COL 50 COLON-ALIGNED WIDGET-ID 38
     1106        f-grp-spec AT ROW 9.04 COL 50 COLON-ALIGNED WIDGET-ID 40
     1107        SPACE(14.37) SKIP(3.74)
     1108       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1109            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1110            TITLE "Выгрузка информации в систему ~"Карбон~""
     1111            DEFAULT-BUTTON b-save CANCEL-BUTTON b-close WIDGET-ID 100.
     1112   ASSIGN
     1113          FRAME gDialog:SCROLLABLE       = FALSE
     1114          FRAME gDialog:HIDDEN           = TRUE.
     1115   ON WINDOW-CLOSE OF FRAME gDialog
     1116   DO:
     1117     APPLY "END-ERROR":U TO SELF.
     1118   END.
     1119   ON CHOOSE OF b-dir IN FRAME gDialog
     1120   DO:
     1121     system-dialog get-dir c-dir.
     1122     v-directory:screen-value in frame gDialog = c-dir.
     1123   END.
     1124   ON CHOOSE OF b-save IN FRAME gDialog
     1125   DO:
     1126       DEFINE VARIABLE l-dircrt AS LOGICAL.
     1127   run check-param no-error.
     1128   If error-status:error then return no-apply.
     1129       ASSIGN
     1130           v-company
     1131           v-directory
     1132           v-prefix
     1133           f-grp-fuel
     1134           f-grp-spec.
     1135       v-directory = right-trim(v-directory,'/\') + '\'.
     1136       file-info:file-name = v-directory.
     1137       if file-info:file-type = ? then do:
     1138           message substitute("Директории &1 не существует.",v-directory) skip
     1139           "Создать?" view-as alert-box warning buttons yes-no update l-dircrt.
     1140           if l-dircrt then do:
     1141               os-create-dir value(v-directory).
     1142               if os-error <> 0 then do:
     1143                   message substitute("Невозможно создать директорию &1",v-directory) view-as alert-box error.
     1144                   leave.
     1145               end.
     1146           end.
     1147           else leave.
     1148       end.
     1149       else do:
     1150           if not (file-info:file-type begins "D":U) then do:
     1151               message substitute("&1 не является директорией.",v-directory) view-as alert-box error.
     1152               leave.
     1153           end.
     1154       end.
     1155       v-param-list = string(v-company) + chr(4) + v-directory + chr(4) + v-prefix + chr(4) + string(f-grp-fuel) + chr(4) + string(f-grp-spec).
     1156       run attach-attr-to-schedule-line in this-procedure ( INPUT v-param-list ).
     1157       run schedule-attr-write in this-procedure (input p-db-num-char,
     1158                                                  input p-task-type,
     1159                                                  input p-task-num,
     1160                                                  input 'schedule-obj-list':U,
     1161                                                  input v-obj-list).
     1162       message "Параметры сохранены!" view-as alert-box information.
     1163       apply "go".
     1164   END.
     1165   ON CHOOSE OF b-start IN FRAME gDialog
     1166   DO:
     1167     DEFINE VARIABLE l-dircrt AS LOGICAL NO-UNDO.
     1168     define variable h-par as widget-handle  no-undo.
     1169     DEFINE variable loghandle AS HANDLE no-undo.
     1170     DEFINE VARIABLE v-objects AS CHARACTER NO-UNDO.
     1171   run check-param no-error.
     1172   If error-status:error then return no-apply.
     1173     ASSIGN
     1174       v-company
     1175       v-directory
     1176       v-prefix
     1177       f-grp-fuel
     1178       f-grp-spec.
     1179     v-directory = RIGHT-TRIM(v-directory,'/\') + '\'.
     1180     FILE-INFO:FILE-NAME = v-directory.
     1181     IF FILE-INFO:FILE-TYPE = ? THEN DO:
     1182       MESSAGE SUBSTITUTE("Директории &1 не существует.",v-directory) SKIP
     1183           "Создать?" VIEW-AS ALERT-BOX WARNING BUTTONS YES-NO UPDATE l-dircrt.
     1184           IF l-dircrt THEN DO:
     1185               OS-CREATE-DIR VALUE(v-directory).
     1186               IF OS-ERROR <> 0 THEN DO:
     1187                   MESSAGE SUBSTITUTE("Невозможно создать директорию &1",v-directory) VIEW-AS ALERT-BOX ERROR.
     1188                   LEAVE.
     1189               END.
     1190           END.
     1191           ELSE LEAVE.
     1192       END.
     1193       ELSE DO:
     1194           IF NOT (FILE-INFO:FILE-TYPE BEGINS "D":U) THEN DO:
     1195               MESSAGE SUBSTITUTE("&1 не является директорией.",v-directory) VIEW-AS ALERT-BOX ERROR.
     1196               LEAVE.
     1197           END.
     1198       END.
     1199       run bge\exp-carbon.p ( this-procedure:handle,
     1200                               v-company,
     1201                               v-directory,
     1202                               v-prefix,
     1203                               f-grp-fuel,
     1204                               f-grp-spec
     1205                          ) .
     1206       apply "go".
     1207   END.
     1208   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME gDialog:PARENT eq ?
     1209   THEN FRAME gDialog:PARENT = ACTIVE-WINDOW.
     1210   MAIN-BLOCK:
     1211   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1212      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1213   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1214     run mainmenu_getcntxt in parparentproc
     1215       (output v-cntxt-db-num
     1216       ,output v-cntxt-userid
     1217       ,output v-cntxt-level
     1218       ,output v-cntxt-host-code-obj
     1219       ,output v-cntxt-obj-type
     1220       ,output v-cntxt-obj-code
     1221       ,output v-cntxt-db-num-obj
     1222       ,output v-cntxt-is-admin
     1223       ) .
     1224     run get-host-name in this-procedure ( output v-host-name ) no-error .
     1225     if error-status :error
     1226     then do:
     1227         message
     1228           vss-workfile vss-revision vss-description
     1229           skip "Ошибка при определении имени фирмы"
     1230           skip "Код фирмы:" v-cntxt-host-code-obj
     1231           skip "Имя фирмы будет отображаться как '" + 'орг':U + string( v-cntxt-host-code-obj ) + "'"
     1232           skip return-value
     1233           skip trim(error-status :get-message(1))
     1234                trim(error-status :get-message(2))
     1235                trim(error-status :get-message(3))
     1236                trim(error-status :get-message(4))
     1237                trim(error-status :get-message(5))
     1238         view-as alert-box warning.
     1239         assign
     1240             v-host-name = 'орг':U + string(v-cntxt-host-code-obj).
     1241     end.
     1242     RUN enable_UI.
     1243     RUN my-enable.
     1244     WAIT-FOR GO OF FRAME gDialog.
     1245   END.
     1246   RUN disable_UI.
     1247   PROCEDURE adm-create-objects :
     1248   END PROCEDURE.
     1249   PROCEDURE attach-attr-to-schedule-line :
     1250   DEFINE INPUT PARAMETER p-param-list AS CHARACTER NO-UNDO.
     1251     define buffer buf_schedule      for schedule.
     1252     define buffer buf_schedule-attr for schedule-attr.
     1253     define buffer lock-batchprocess for ub.batchprocess.
     1254     run gbl/lock-prc.p
     1255       (input 'schd':U
     1256       ,input 'exp-carbon':U
     1257       ,input 0
     1258       ,input 0
     1259       ,input '':U
     1260       ,input ""
     1261       ,input ""
     1262       ,input (
     1263       "Сохранение параметров Карбон"
     1264       )
     1265       ,input yes
     1266       ,buffer lock-batchprocess
     1267       ) no-error .
     1268     FIND FIRST buf_schedule-attr NO-LOCK WHERE
     1269       buf_schedule-attr.task-type   = p-task-type
     1270       and buf_schedule-attr.cre-db-num = INTEGER(p-db-num-char)
     1271       and buf_schedule-attr.attr-code = ('schd-free-id':U + chr(4) + 'exp-carbon') NO-ERROR.
     1272     IF AVAILABLE  buf_schedule-attr
     1273       AND buf_schedule-attr.task-num <> p-task-num
     1274       AND buf_schedule-attr.task-num <> - 1
     1275       and p-task-num <> - 1
     1276       THEN
     1277     DO:
     1278       MESSAGE
     1279         substitute("Уже есть расписание сохранения параметров Карбон для БД &1&2" +
     1280         "номер расписания &3"
     1281         ,buf_schedule-attr.cre-db-num
     1282         ,chr(10)
     1283         ,buf_schedule-attr.task-num)
     1284         VIEW-AS ALERT-BOX ERROR.
     1285       UNDO, RETURN ERROR.
     1286     END.
     1287     find first buf_schedule no-lock
     1288       where buf_schedule.task-type   = p-task-type
     1289       and buf_schedule.cre-db-num  = INTEGER(p-db-num-char)
     1290       and buf_schedule.task-num    = p-task-num
     1291       no-error.
     1292     if not available buf_schedule
     1293       and (  p-task-type   <> 'autofree':U
     1294       or p-db-num-char <> p-db-num-char
     1295       or p-task-num    <> -1 )
     1296       then
     1297     do:
     1298       message
     1299         vss-workfile vss-revision vss-description
     1300         skip
     1301         "Не найдена строка расписания."
     1302         skip return-value
     1303         skip trim(error-status :get-message(1))
     1304         trim(error-status :get-message(2))
     1305         trim(error-status :get-message(3))
     1306         view-as alert-box error.
     1307       undo, return error .
     1308     end.
     1309     run schedule-attr-write in this-procedure (
     1310       input INTEGER(p-db-num-char)
     1311       , input p-task-type
     1312       , input p-task-num
     1313       , input 'schedule-param-list':U
     1314       , input p-param-list
     1315       ).
     1316   END PROCEDURE.
     1317   PROCEDURE check-param :
     1318     DEFINE VARIABLE l-dircrt AS LOGICAL NO-UNDO.
     1319     define variable h-par as widget-handle  no-undo.
     1320     DEFINE variable loghandle AS HANDLE no-undo.
     1321   ASSIGN frame gDialog
     1322           v-company
     1323           v-directory
     1324           v-prefix
     1325           f-grp-fuel
     1326           f-grp-spec
     1327           .
     1328       v-directory = right-trim(v-directory,'/\') + '\'.
     1329       file-info:file-name = v-directory.
     1330       if file-info:file-type = ? then do:
     1331           message substitute("Директории &1 не существует.",v-directory) skip
     1332           "Создать?" view-as alert-box warning buttons yes-no update l-dircrt.
     1333           if l-dircrt then do:
     1334               os-create-dir value(v-directory).
     1335               if os-error <> 0 then do:
     1336                   message substitute("Невозможно создать директорию &1",v-directory) view-as alert-box error.
     1337                   leave.
     1338               end.
     1339           end.
     1340           else leave.
     1341       end.
     1342       else do:
     1343           if not (file-info:file-type begins "D":U) then do:
     1344               message substitute("&1 не является директорией.",v-directory) view-as alert-box error.
     1345               leave.
     1346           end.
     1347       end.
     1348       if v-prefix = ? or v-prefix = '' then do:
     1349           message 'Не указано значение Кода региона' view-as alert-box error.
     1350           apply 'entry':U to v-prefix.
     1351           return error.
     1352       end.
     1353           if f-grp-fuel > 0 then.
     1354           else do:
     1355               message 'Не указано значение Кода группы для топлива' view-as alert-box error.
     1356               apply 'entry':U to f-grp-fuel.
     1357           return error.
     1358           end.
     1359           if f-grp-spec > 0 then.
     1360           else do:
     1361               message 'Не указано значение Кода группы для товаров, на которые не начисляются бонусы' view-as alert-box error.
     1362               apply 'entry':U to f-grp-spec.
     1363           return error.
     1364           end.
     1365   END PROCEDURE.
     1366   PROCEDURE disable_UI :
     1367     HIDE FRAME gDialog.
     1368   END PROCEDURE.
     1369   PROCEDURE enable_UI :
     1370     DISPLAY v-company v-directory v-prefix f-grp-fuel f-grp-spec
     1371         WITH FRAME gDialog.
     1372     ENABLE b-start b-save b-close v-company v-directory b-dir v-prefix f-grp-fuel
     1373            f-grp-spec
     1374         WITH FRAME gDialog.
     1375     VIEW FRAME gDialog.
     1376   END PROCEDURE.
     1377   PROCEDURE get-host-name :
     1378   do on error undo, return error:
     1379   define output parameter p-host-name as character no-undo.
     1380       find first buf_clients no-lock where buf_clients.obj-type = 'орг':U
     1381                                        and buf_clients.obj-code = v-cntxt-host-code-obj no-error.
     1382       if not available buf_clients then do:
     1383           message vss-workfile vss-revision vss-description skip
     1384             "Не удалось найти текущую фирму" skip
     1385             return-value skip
     1386             trim(error-status :get-message(1))
     1387             trim(error-status :get-message(2))
     1388             trim(error-status :get-message(3))
     1389             trim(error-status :get-message(4))
     1390             trim(error-status :get-message(5))
     1391           view-as alert-box error.
     1392           undo, return error.
     1393       end.
     1394       else do:
     1395           p-host-name = buf_clients.obj-name.
     1396       end.
     1397   END.
     1398   END PROCEDURE.
     1399   PROCEDURE my-enable :
     1400   ASSIGN
     1401       v-directory:screen-value in frame gDialog = session:temp-directory.
     1402   assign
     1403       v-directory.
     1404   case p-mode:
     1405       when "run" then do:
     1406           hide b-save in frame gDialog.
     1407       end.
     1408       when "shd" then do:
     1409           hide b-start in frame gDialog.
     1410           run schedule-attr-value in this-procedure (input p-db-num-char,
     1411                                                      input p-task-type,
     1412                                                      input p-task-num,
     1413                                                      input 'schedule-param-list':U,
     1414                                                      output v-param-list,
     1415                                                      output v-param-type).
     1416           if v-param-list <> "" then do:
     1417               ASSIGN
     1418                   v-company = integer(entry(1,v-param-list,chr(4)))
     1419                   v-directory = entry(2,v-param-list,chr(4))
     1420                   v-prefix = entry(3,v-param-list,chr(4))
     1421                   f-grp-fuel = int(entry(4,v-param-list,chr(4)))
     1422                   f-grp-spec = int(entry(5,v-param-list,chr(4)))
     1423                   NO-ERROR.
     1424               DISPLAY v-company WITH FRAME gDialog.
     1425               DISPLAY v-directory WITH FRAME gDialog.
     1426               DISPLAY v-prefix WITH FRAME gDialog.
     1427               DISPLAY f-grp-fuel WITH FRAME gDialog.
     1428               DISPLAY f-grp-spec WITH FRAME gDialog.
     1429           end.
     1430       end.
     1431   end case.
     1432   END PROCEDURE.
     1433   PROCEDURE write-log-and-file :
     1434   define input parameter p-tab-position as integer no-undo.
     1435   define input parameter p-file-name as char no-undo.
     1436   define input parameter p-log-level as integer no-undo.
     1437   define input parameter p-log-string as char no-undo.
     1438   output stream StreamLog to value(p-file-name) append.
     1439   put stream StreamLog unformatted chr(10).
     1440   put stream StreamLog unformatted cur-time-string-sec() " " p-log-string.
     1441   output stream StreamLog close.
     1442   END PROCEDURE.
