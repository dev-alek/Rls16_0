      147   function record_time returns character():
      148           return substitute("&1-&2-&3 &4", string(year(today),"9999"),
      149                                            string(month(today),"99"),
      150                                            string(day(today),"99"),
      151                                            string(time,"HH:MM:SS":U)).
      152   end function.
      153   find first buf_rvs-doc where buf_rvs-doc.obj-type = p_obj-type
      154                            and buf_rvs-doc.obj-code = p_obj-code
      155                            and buf_rvs-doc.shift-num = p_shift-num
      156                            and buf_rvs-doc.shift-date = p_shift-date
      157                            and buf_rvs-doc.rvs-type = 'смена':U
      158                            and buf_rvs-doc.status_ = 'факт':U no-lock no-error.
      159   find last buf_previous-shift-obj where buf_previous-shift-obj.obj-type = p_obj-type
      160                                      and buf_previous-shift-obj.obj-code = p_obj-code
      161                                      and ((buf_previous-shift-obj.shift-date = p_shift-date
      162                                           and buf_previous-shift-obj.shift-num < p_shift-num)
      163                                       or buf_previous-shift-obj.shift-date < p_shift-date) no-lock no-error.
      164   find first buf_prev_rvs-doc where buf_prev_rvs-doc.obj-type = p_obj-type
      165                                 and buf_prev_rvs-doc.obj-code = p_obj-code
      166                                 and buf_prev_rvs-doc.shift-num = buf_previous-shift-obj.shift-num
      167                                 and buf_prev_rvs-doc.shift-date = buf_previous-shift-obj.shift-date
      168                                 and buf_prev_rvs-doc.rvs-type = 'смена':U
      169                                 and buf_prev_rvs-doc.status_ = 'факт':U no-lock no-error.
      170   if not available buf_prev_rvs-doc then
      171   find first buf_prev_rvs-doc where buf_prev_rvs-doc.obj-type = p_obj-type
      172                                 and buf_prev_rvs-doc.obj-code = p_obj-code
      173                                 and buf_prev_rvs-doc.shift-date = p_shift-date
      174                                 and buf_prev_rvs-doc.shift-num = p_shift-num
      175                                 and buf_prev_rvs-doc.status_ = 'факт':U
      176                                 and buf_prev_rvs-doc.rvs-type = 'контроль':U no-lock.
      177   create sax-writer hSAXWriter.
      178   hSAXWriter:set-output-destination("file":U, p_xml).
      179   hSAXWriter:formatted = true.
      180   hSAXWriter:encoding = "UTF-8":U.
      181   hSAXWriter:standalone = no.
      182   hSAXWriter:start-document().
      183   hSAXWriter:write-external-dtd("oilix-log":U,"oilix-log.dtd":U).
      184   hSAXWriter:start-element("oilix-log":U).
      185       hSAXWriter:start-element("record":U).
      186           hSAXWriter:insert-attribute ("time":U, record_time()).
      187           hSAXWriter:write-empty-element("log-start":U).
      188               hSAXWriter:insert-attribute("shift":U,string(p_shift-num)) no-error.
      189               hSAXWriter:insert-attribute("source":U,substitute("azk-&1",p_obj-code)) no-error.
      190               hSAXWriter:insert-attribute("log-name":U,p_xml) no-error.
      191               hSAXWriter:insert-attribute("prev-log-name":U,"") no-error.
      192       hSAXWriter:end-element("record":U).
      193       for each buf_prev_rvs-line where buf_prev_rvs-line.rvs-code = buf_prev_rvs-doc.rvs-code no-lock:
      194           find first buf_place where buf_place.obj-type = buf_prev_rvs-line.obj-type
      195                                  and buf_place.obj-code = buf_prev_rvs-line.obj-code
      196                                  and buf_place.pl-code = buf_prev_rvs-line.pl-code no-lock.
      197           hSAXWriter:start-element("record":U).
      198               hSAXWriter:insert-attribute ("time":U, record_time()).
      199               hSAXWriter:write-empty-element("tank-start":U).
      200                   hSAXWriter:insert-attribute("tank":U,buf_place.loc1) no-error.
      201                   hSAXWriter:insert-attribute("litres":U,string(buf_prev_rvs-line.state-measure-qnty)) no-error.
      202                   hSAXWriter:insert-attribute("weight":U,string(buf_prev_rvs-line.state-measure-cli-qnty)) no-error.
      203                   hSAXWriter:insert-attribute("gas":U,string(buf_prev_rvs-line.gds-code)) no-error.
      204           hSAXWriter:end-element("record":U).
      205       end.
      206       for each buf_rvs-line where buf_rvs-line.rvs-code = buf_prev_rvs-doc.rvs-code no-lock:
      207           find first buf_place where buf_place.obj-type = buf_rvs-line.obj-type
      208                                  and buf_place.obj-code = buf_rvs-line.obj-code
      209                                  and buf_place.pl-code = buf_rvs-line.pl-code no-lock.
      210           for each buf_rvs-line-pump where buf_rvs-line-pump.rvs-code = buf_rvs-line.rvs-code
      211                                        and buf_rvs-line-pump.obj-code = buf_rvs-line.obj-code
      212                                        and buf_rvs-line-pump.obj-type = buf_rvs-line.obj-type
      213                                        and buf_rvs-line-pump.pl-code = buf_rvs-line.pl-code
      214                                        and buf_rvs-line-pump.gds-code = buf_rvs-line.gds-code no-lock:
      215               find first buf_prev_rvs-line-pump where buf_prev_rvs-line-pump.rvs-code = buf_prev_rvs-doc.rvs-code
      216                                                   and buf_prev_rvs-line-pump.obj-type = buf_prev_rvs-doc.obj-type
      217                                                   and buf_prev_rvs-line-pump.obj-code = buf_prev_rvs-doc.obj-code
      218                                                   and buf_prev_rvs-line-pump.pl-code = buf_rvs-line-pump.pl-code
      219                                                   and buf_prev_rvs-line-pump.gds-code = buf_rvs-line-pump.gds-code
      220                                                   and buf_prev_rvs-line-pump.pump-code = buf_rvs-line-pump.pump-code
      221                                                   and buf_prev_rvs-line-pump.nozzle-code = buf_rvs-line-pump.nozzle-code no-lock.
      222               hSAXWriter:start-element("record":U).
      223                   hSAXWriter:insert-attribute ("time":U, record_time()).
      224                   hSAXWriter:write-empty-element("nozzle-info":U).
      225                       hSAXWriter:insert-attribute("nozzle":U,string(buf_rvs-line-pump.nozzle-code)) no-error.
      226                       hSAXWriter:insert-attribute("start-counter":U,string(buf_prev_rvs-line-pump.state-mh-cnt)) no-error.
      227                       hSAXWriter:insert-attribute("end-counter":U,string(buf_rvs-line-pump.state-mh-cnt)) no-error.
      228                       hSAXWriter:insert-attribute("litres":U,string(buf_rvs-line-pump.state-mh-qnty)) no-error.
      229                       hSAXWriter:insert-attribute("tank":U,buf_place.loc1) no-error.
      230                       hSAXWriter:insert-attribute("trk":U,string(buf_rvs-line-pump.pump-code)) no-error.
      231               hSAXWriter:end-element("record":U).
      232           end.
      233       end.
      234       for each buf_rvs-line where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code no-lock:
      235           find first buf_place where buf_place.obj-type = buf_rvs-line.obj-type
      236                                  and buf_place.obj-code = buf_rvs-line.obj-code
      237                                  and buf_place.pl-code = buf_rvs-line.pl-code no-lock.
      238           hSAXWriter:start-element("record":U).
      239               hSAXWriter:insert-attribute ("time":U, record_time()).
      240               hSAXWriter:write-empty-element("tank-end":U).
      241                   hSAXWriter:insert-attribute("tank":U,buf_place.loc1) no-error.
      242                   hSAXWriter:insert-attribute("level":U,left-trim(string(buf_rvs-line.state-level-petrol,">>>>>>> >>>>>9.999"))) no-error.
      243                   hSAXWriter:insert-attribute("litres":U,left-trim(string(buf_rvs-line.state-measure-qnty,">>>>>>>>>>>>9.999"))) no-error.
      244                   hSAXWriter:insert-attribute("weight":U,left-trim(string(buf_rvs-line.state-measure-cli-qnty,">>>>>>>>>>>>9.999"))) no-error.
      245                   hSAXWriter:insert-attribute("lms-level":U,left-trim(string(buf_rvs-line.state-level-total,">>>>>>>>>>>>9.999"))) no-error.
      246                   hSAXWriter:insert-attribute("lms-litres":U,left-trim(string(buf_rvs-line.measure-qnty,">>>>>>>>>>>>9.999"))) no-error.
      247                   hSAXWriter:insert-attribute("lms-water":U,left-trim(string(buf_rvs-line.brutto-qnty - buf_rvs-line.measure-qnty,">>>>>>>>>>>>9.999"))) no-error.
      248                   hSAXWriter:insert-attribute("lms-density":U,left-trim(string(buf_rvs-line.density,">>>>>>>>>>>>9.999"))) no-error.
      249                   hSAXWriter:insert-attribute("lms-temperature":U,string(buf_rvs-line.temperature)) no-error.
      250                   hSAXWriter:insert-attribute("log-name":U,p_xml) no-error.
      251                   hSAXWriter:insert-attribute("next-log-name":U,"") no-error.
      252           hSAXWriter:end-element("record":U).
      253       end.
      254       for each buf_trn-doc where buf_trn-doc.obj-type = p_obj-type
      255                              and buf_trn-doc.obj-code = p_obj-code
      256                              and buf_trn-doc.shift-date = p_shift-date
      257                              and buf_trn-doc.shift-num = p_shift-num
      258                              and buf_trn-doc.status_ = 'факт':U
      259                              and lookup(buf_trn-doc.ext-doc-type, "ie,iv":U,",") > 0 no-lock:
      260           for each buf_doc-line where buf_doc-line.doc-code = buf_trn-doc.doc-code no-lock:
      261   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      262     (
      263        input buf_doc-line.artic
      264     ,  input buf_doc-line.prod-type
      265     ,  input buf_doc-line.prod-code
      266     , output is-petrolium
      267     , output is-pieces
      268     ) .
      269               if is-petrolium = true then do:
      270                   find first buf_goods where buf_goods.prod-type = buf_doc-line.prod-type
      271                                          and buf_goods.prod-code = buf_doc-line.prod-code
      272                                          and buf_goods.artic = buf_doc-line.artic no-lock.
      273                   for each buf_doc-pl where buf_doc-pl.obj-type = p_obj-type
      274                                         and buf_doc-pl.obj-code = p_obj-code
      275                                         and buf_doc-pl.out-code = buf_doc-line.doc-code
      276                                         and buf_doc-pl.gds-code = buf_goods.gds-code no-lock:
      277                       find first buf_place where buf_place.obj-type = buf_doc-pl.obj-type
      278                                              and buf_place.obj-code = buf_doc-pl.obj-code
      279                                              and buf_place.pl-code = buf_doc-pl.pl-code no-lock.
      280                       hSAXWriter:start-element("record":U).
      281                           hSAXWriter:insert-attribute ("time":U, record_time()).
      282                           hSAXWriter:write-empty-element("tank-income":U).
      283                               hSAXWriter:insert-attribute("tank":U,buf_place.loc1) no-error.
      284                               hSAXWriter:insert-attribute("ttn-volume":U,left-trim(string(buf_doc-pl.doc-qnty,">>>>>>>>>>>>9.999"))) no-error.
      285                               hSAXWriter:insert-attribute("ttn-weight":U,left-trim(string(buf_doc-pl.cli-qnty,">>>>>>>>>>>>9.999"))) no-error.
      286                               hSAXWriter:insert-attribute("temperature":U,string(buf_doc-line.temperature)) no-error.
      287                               hSAXWriter:insert-attribute("density":U,left-trim(string(buf_doc-line.fact-density,">>>>>>>>>>>>9.999"))) no-error.
      288                               hSAXWriter:insert-attribute("income-volume":U,string(buf_doc-pl.fact-qnty)) no-error.
      289                               hSAXWriter:insert-attribute("income-weight":U,string(buf_doc-pl.cli-fact-qnty)) no-error.
      290                               hSAXWriter:insert-attribute("ttn":U,buf_doc-line.doc-code) no-error.
      291                       hSAXWriter:end-element("record":U).
      292                   end.
      293               end.
      294           end.
      295       end.
      296       for each buf_chk-gds-pay where buf_chk-gds-pay.obj-code = p_obj-code
      297                                  and buf_chk-gds-pay.obj-type = p_obj-type
      298                                  and buf_chk-gds-pay.shift-date = p_shift-date
      299                                  and buf_chk-gds-pay.shift-num = p_shift-num no-lock:
      300           find first buf_bar-code where buf_bar-code.b-code = buf_chk-gds-pay.b-code no-lock.
      301           case entry(1,buf_chk-gds-pay.line-type,chr(4)) :
      302               when 'т':U then do:
      303                   find first tt_goods-rls where tt_goods-rls.barcode = buf_bar-code.gds-code
      304                                             and tt_goods-rls.bn-mode = buf_chk-gds-pay.pay-code no-error.
      305                   if not available(tt_goods-rls) then do:
      306   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      308     (input  p_obj-type
      309     ,input  p_obj-code
      310     ,output v-host-code
      311     )  .
      312                       find last buf_tax-rate-gds where buf_tax-rate-gds.gds-code = buf_bar-code.gds-code
      313                                                    and buf_tax-rate-gds.tax-code = integer('1':U)
      314                                                    and buf_tax-rate-gds.host-code = v-host-code
      315                                                    and buf_tax-rate-gds.obj-code = p_obj-code
      316                                                    and buf_tax-rate-gds.obj-type = p_obj-type
      317                                                    and buf_tax-rate-gds.fact-order <= integer(p_shift-date) no-lock no-error.
      318                       if not available(buf_tax-rate-gds) then
      319                           find last buf_tax-rate-gds where buf_tax-rate-gds.gds-code  = buf_bar-code.gds-code
      320                                                        and buf_tax-rate-gds.tax-code  = integer('1':U)
      321                                                        and buf_tax-rate-gds.host-code  = 0
      322                                                        and buf_tax-rate-gds.obj-type  = ''
      323                                                        and buf_tax-rate-gds.obj-code  = 0
      324                                                        and buf_tax-rate-gds.fact-order <= integer(p_shift-date) no-lock no-error.
      325                       create tt_goods-rls.
      326                       assign
      327                       tt_goods-rls.bn-mode = buf_chk-gds-pay.pay-code
      328                       tt_goods-rls.tax-code = buf_tax-rate-gds.rate-code
      329                       tt_goods-rls.barcode = buf_bar-code.gds-code.
      330                   end.
      331                   assign
      332                   tt_goods-rls.sum = tt_goods-rls.sum + buf_chk-gds-pay.tot-r-b
      333                   tt_goods-rls.num = tt_goods-rls.num + buf_chk-gds-pay.eff-doc-qnty
      334                   tt_goods-rls.price = tt_goods-rls.price + buf_chk-gds-pay.price-base * buf_chk-gds-pay.eff-doc-qnty.
      335               end.
      336               when 'у':U then do:
      337                   find first tt_office-rls where tt_office-rls.service-id = buf_bar-code.gds-code
      338                                             and tt_office-rls.bn-mode = buf_chk-gds-pay.pay-code no-error.
      339                   if not available(tt_office-rls) then do:
      340                       create tt_office-rls.
      341                       assign
      342                       tt_office-rls.bn-mode = buf_chk-gds-pay.pay-code
      343                       tt_office-rls.service-id = buf_bar-code.gds-code.
      344                   end.
      345                   tt_office-rls.sum = tt_office-rls.sum + buf_chk-gds-pay.tot-r-b.
      346               end.
      347               when 'топ':U then do:
      348                   find first buf_chk-gds where buf_chk-gds.doc-code = buf_chk-gds-pay.doc-code
      349                                            and buf_chk-gds.line-num = buf_chk-gds-pay.line-num no-lock no-error.
      350                   find first tt_petrol-rls where tt_petrol-rls.bn-mode = buf_chk-gds-pay.pay-code
      351                                              and tt_petrol-rls.gas = buf_bar-code.gds-code
      352                                              and tt_petrol-rls.tank = buf_chk-gds.loc1
      353                                              and tt_petrol-rls.trk = buf_chk-gds.pump
      354                                              and tt_petrol-rls.nozzle = buf_chk-gds.nozzle-code no-error.
      355                   find first tt_pay-types where tt_pay-types.bn-mode = tt_petrol-rls.bn-mode
      356                                             and tt_pay-types.curr-code = buf_chk-gds-pay.curr-code no-error.
      357                   if not available(tt_petrol-rls) then do:
      358                       create tt_petrol-rls.
      359                       assign
      360                       tt_petrol-rls.bn-mode = buf_chk-gds-pay.pay-code
      361                       tt_petrol-rls.gas = buf_bar-code.gds-code
      362                       tt_petrol-rls.tank = buf_chk-gds.loc1
      363                       tt_petrol-rls.trk = buf_chk-gds.pump
      364                       tt_petrol-rls.nozzle = buf_chk-gds.nozzle-code
      365                       tt_petrol-rls.density = buf_chk-gds.density no-error.
      366                       if not available(tt_pay-types) then do:
      367                           create tt_pay-types.
      368                           assign
      369                           tt_pay-types.bn-mode = tt_petrol-rls.bn-mode
      370                           tt_pay-types.curr-code = buf_chk-gds-pay.curr-code.
      371                           find first buf_cash-pay where buf_cash-pay.cdpay-code = tt_petrol-rls.bn-mode
      372                                                     and buf_cash-pay.curr-code = buf_chk-gds-pay.curr-code no-error.
      373                               if buf_cash-pay.atr128 then tt_pay-types.card-type = 's':U.
      374                               else do:
      375                                   find first buf_wealth where buf_wealth.wth-code = buf_cash-pay.wth-code no-error.
      376                                   if available(buf_wealth) and buf_wealth.is-ser = 1 then tt_pay-types.card-type = 't':U.
      377                                   else tt_pay-types.card-type = 'o':U.
      378                               end.
      379                       end.
      380                   end.
      381                   if tt_pay-types.card-type = 's':U or tt_pay-types.card-type = 't':U then do:
      382                       create tt_pay-cards.
      383                       assign
      384                       tt_pay-cards.id = buf_chk-gds-pay.pay-card
      385                       tt_pay-cards.card-type = tt_pay-types.card-type
      386                       tt_pay-cards.row-id = rowid(tt_petrol-rls).
      387                   end.
      388                   assign
      389                   tt_petrol-rls.litres = tt_petrol-rls.litres + buf_chk-gds-pay.eff-doc-qnty
      390                   tt_petrol-rls.preset = tt_petrol-rls.litres
      391                   tt_petrol-rls.sum  = tt_petrol-rls.sum + buf_chk-gds-pay.tot-r-b
      392                   tt_petrol-rls.weight = tt_petrol-rls.litres * tt_petrol-rls.density
      393                   tt_petrol-rls.price = tt_petrol-rls.sum / tt_petrol-rls.litres no-error.
      394               end.
      395           end case.
      396       end.
      397       for each tt_petrol-rls no-lock:
      398                   hSAXWriter:start-element("record":U).
      399                       hSAXWriter:insert-attribute ("time":U, record_time()).
      400                       hSAXWriter:start-element("filling":U).
      401                           hSAXWriter:insert-attribute("operation-id":U,string(p_operation-id)) no-error.
      402                           hSAXWriter:insert-attribute("bn-mode":U,string(tt_petrol-rls.bn-mode)) no-error.
      403                           hSAXWriter:insert-attribute("gas":U,string(tt_petrol-rls.gas)) no-error.
      404                           hSAXWriter:insert-attribute("preset":U,left-trim(string(tt_petrol-rls.preset,">>>>>>>>>>>>9.999"))) no-error.
      405                           hSAXWriter:insert-attribute("litres":U,left-trim(string(tt_petrol-rls.litres,">>>>>>>>>>>>9.999"))) no-error.
      406                           hSAXWriter:insert-attribute("weight":U,left-trim(string(tt_petrol-rls.weight,">>>>>>>>>>>>9.999"))) no-error.
      407                           hSAXWriter:insert-attribute("price":U,left-trim(string(tt_petrol-rls.price,">>>>>>>>>>>>9.99"))) no-error.
      408                           hSAXWriter:insert-attribute("sum":U,left-trim(string(tt_petrol-rls.sum,">>>>>>>>>>>>9.99"))) no-error.
      409                           hSAXWriter:insert-attribute("trk":U,string(tt_petrol-rls.trk)) no-error.
      410                           hSAXWriter:insert-attribute("tank":U,tt_petrol-rls.tank) no-error.
      411                           hSAXWriter:insert-attribute("density":U,left-trim(string(tt_petrol-rls.density,">>>>>>>>>>>>9.999"))) no-error.
      412                           hSAXWriter:insert-attribute("nozzle":U,string(tt_petrol-rls.nozzle)) no-error.
      413                           p_operation-id = p_operation-id + 1.
      414                           for each tt_pay-cards where tt_pay-cards.row-id = rowid(tt_petrol-rls) break by tt_pay-cards.card-type:
      415                               if tt_pay-cards.card-type = 's':U then do:
      416                                   hSAXWriter:write-empty-element("card-info":U).
      417                                       hSAXWriter:insert-attribute("card",tt_pay-cards.id) no-error.
      418                               end.
      419                               if tt_pay-cards.card-type = 't':U then do:
      420                                   run str/wthidnt.p (input tt_pay-cards.id
      421                                                     ,output v-ser-code
      422                                                     ,output v-db-num
      423                                                     ,output v-stts
      424                                                     ,output v-wth-code
      425                                                     ,output v-gds-code
      426                                                     ,output v-par-code
      427                                                     ,output v-zone
      428                                                     ,output v-FromDate
      429                                                     ,output v-ToDate
      430                                                     ,output v-range) no-error.
      431                                   find first buf_wth-par where buf_wth-par.wth-code = v-wth-code
      432                                                            and buf_wth-par.par-code = v-par-code no-lock no-error.
      433                                   hSAXWriter:start-element("ticket-info-list":U).
      434                                       hSAXWriter:write-empty-element("ticket-info":U).
      435                                           hSAXWriter:insert-attribute("id":U,tt_pay-cards.id) no-error.
      436                                           hSAXWriter:insert-attribute("litres":U,left-trim(string(buf_wth-par.par-val,">>>>>>>>>>>>9.999"))) no-error.
      437                                   hSAXWriter:end-element("ticket-info-list":U).
      438                               end.
      439                           end.
      440                       hSAXWriter:end-element("filling":U).
      441                   hSAXWriter:end-element("record":U).
      442       end.
      443       for each tt_office-rls no-lock:
      444           hSAXWriter:start-element("record":U).
      445               hSAXWriter:insert-attribute ("time":U, record_time()).
      446               hSAXWriter:write-empty-element("service":U).
      447                   hSAXWriter:insert-attribute("operation-id":U,string(p_operation-id)) no-error.
      448                   hSAXWriter:insert-attribute("bn-mode":U,string(tt_office-rls.bn-mode)) no-error.
      449                   hSAXWriter:insert-attribute("service-id":U,string(tt_office-rls.service-id)) no-error.
      450                   hSAXWriter:insert-attribute("sum":U,left-trim(string(tt_office-rls.sum,">>>>>>>>>>>>9.99"))) no-error.
      451                   p_operation-id = p_operation-id + 1.
      452           hSAXWriter:end-element("record":U).
      453       end.
      454       if p_agregation_nds then do:
      455           for each tt_goods-rls break by tt_goods-rls.tax-code by tt_goods-rls.bn-mode:
      456               accumulate tt_goods-rls.sum (total by tt_goods-rls.bn-mode).
      457               accumulate tt_goods-rls.num (total by tt_goods-rls.bn-mode).
      458               if last-of(tt_goods-rls.bn-mode) then do:
      459                   hSAXWriter:start-element("record":U).
      460                       hSAXWriter:insert-attribute ("time":U, record_time()).
      461                       hSAXWriter:write-empty-element("payment":U).
      462                           hSAXWriter:insert-attribute("operation-id":U,string(p_operation-id)) no-error.
      463                           hSAXWriter:insert-attribute("bn-mode":U,string(tt_goods-rls.bn-mode)) no-error.
      464                           hSAXWriter:insert-attribute("sum":U,left-trim(string(accum total by tt_goods-rls.bn-mode tt_goods-rls.sum,">>>>>>>>>>>>9.99"))) no-error.
      465                           p_operation-id = p_operation-id + 1.
      466                           hSAXWriter:start-element("sellings":U).
      467                               hSAXWriter:write-empty-element("selling":U).
      468                                   hSAXWriter:insert-attribute("tax-code":U,string(tt_goods-rls.tax-code)) no-error.
      469                                   hSAXWriter:insert-attribute("barcode":U,"") no-error.
      470                                   hSAXWriter:insert-attribute("num":U,left-trim(string(accum total by tt_goods-rls.bn-mode tt_goods-rls.num,">>>>>>>>>>>>9.999"))) no-error.
      471                                   hSAXWriter:insert-attribute("price":U,"") no-error.
      472                           hSAXWriter:end-element("sellings":U).
      473                   hSAXWriter:end-element("record":U).
      474               end.
      475           end.
      476       end.
      477       else do:
      478           for each tt_goods-rls no-lock:
      479               hSAXWriter:start-element("record":U).
      480                   hSAXWriter:insert-attribute ("time":U, record_time()).
      481                   hSAXWriter:write-empty-element("payment":U).
      482                       hSAXWriter:insert-attribute("operation-id":U,string(p_operation-id)) no-error.
      483                       hSAXWriter:insert-attribute("bn-mode":U,string(tt_goods-rls.bn-mode)) no-error.
      484                       hSAXWriter:insert-attribute("sum":U,left-trim(string(tt_goods-rls.sum,">>>>>>>>>>>>9.99"))) no-error.
      485                       p_operation-id = p_operation-id + 1.
      486                       hSAXWriter:start-element("sellings":U).
      487                           hSAXWriter:write-empty-element("selling":U).
      488                               hSAXWriter:insert-attribute("tax-code":U,string(tt_goods-rls.tax-code)) no-error.
      489                               hSAXWriter:insert-attribute("barcode":U,string(tt_goods-rls.barcode)) no-error.
      490                               hSAXWriter:insert-attribute("num":U,string(tt_goods-rls.num)) no-error.
      491                               hSAXWriter:insert-attribute("price":U,string(tt_goods-rls.price / tt_goods-rls.num)) no-error.
      492                       hSAXWriter:end-element("sellings":U).
      493               hSAXWriter:end-element("record":U).
      494           end.
      495       end.
      496   hSAXWriter:end-element("oilix-log":U).
      497   hSAXWriter:end-document().
      498   delete object hSAXWriter no-error.
