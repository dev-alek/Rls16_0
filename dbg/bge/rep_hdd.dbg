      119   end.
      120   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121     define variable v-cntxt-db-num        as integer   no-undo .
      122     define variable v-cntxt-userid        as character no-undo .
      123     define variable v-cntxt-level         as character no-undo .
      124     define variable v-cntxt-host-code-obj as integer   no-undo .
      125     define variable v-cntxt-obj-type      as character no-undo .
      126     define variable v-cntxt-obj-code      as integer   no-undo .
      127     define variable v-cntxt-db-num-obj    as integer   no-undo .
      128     define variable v-cntxt-is-admin      as logical   no-undo .
      129   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   define temp-table temp-schedule-free no-undo
      131   field free-id as character
      132   field free-task-name as character
      133   field proc-run-name as character
      134   field proc-param-edit-name as character
      135   field conf-param as character
      136   field is-gbd as logical
      137   field is-ubd as logical
      138   field enable-concurrent-0 as logical
      139   field enable-concurrent-db as logical
      140   field other-info as character
      141   field enc-key as character
      142   field is-rum as logical
      143   index pi is unique primary
      144   free-id.
      145   procedure schedule-attr-name :
      146   do
      147     on error undo, return error
      148     :
      149     define input  parameter p-code           as character no-undo .
      150     define output parameter p-type           as character no-undo .
      151     define output parameter p-format         as character no-undo .
      152     define output parameter p-label          as character no-undo .
      153     define output parameter p-user-can-edit  as logical   no-undo .
      154     define output parameter p-output-display as logical   no-undo .
      155     define output parameter p-other          as character no-undo .
      156       if index(p-code, chr(4)) > 0 then do:
      157         p-code = entry(1, p-code, chr(4)).
      158       end.
      159       case p-code :
      160               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      161               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      162               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      163               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      164               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      165               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      166               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      167               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      168               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      169         otherwise do:
      170           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      171         end.
      172       end.
      173     end.
      174   end procedure.
      175   procedure schedule-attr-tooltip :
      176   do
      177     on error undo, return error
      178     :
      179       define input  parameter p-code    as character no-undo .
      180       define output parameter p-tooltip as character no-undo .
      181       define output parameter p-label   as character no-undo .
      182       if index(p-code, chr(4)) > 0 then do:
      183         p-code = entry(1, p-code, chr(4)).
      184       end.
      185       case p-code :
      186               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      187               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      188               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      189               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      190               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      191               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      192               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      193               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      194               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      195         otherwise do:
      196               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      197         end.
      198       end.
      199     end.
      200   end procedure.
      201   procedure schedule-attr-value :
      202   do
      203   on error undo, return error return-value
      204   :
      205   define input parameter  p-cre-db-num as integer    no-undo.
      206   define input parameter  p-task-type  as character  no-undo.
      207   define input parameter  p-task-num   as integer    no-undo.
      208   define input parameter  p-code       as character  no-undo.
      209   define output parameter p-value      as character  no-undo.
      210   define output parameter p-type       as character  no-undo.
      211       define variable v-format         as character no-undo .
      212       define variable v-label          as character no-undo .
      213       define variable v-user-can-edit  as logical   no-undo .
      214       define variable v-output-display as logical   no-undo .
      215       define variable v-other          as character no-undo .
      216       define buffer buf_schedule-attr for ub.schedule-attr.
      217       run schedule-attr-name in this-procedure (
      218             input  p-code
      219           , output p-type
      220           , output v-format
      221           , output v-label
      222           , output v-user-can-edit
      223           , output v-output-display
      224           , output v-other
      225       ) no-error .
      226       if error-status :error
      227       then do:
      228           undo, return error return-value .
      229       end.
      230       if p-code begins ('schd-free-id':U + chr(4))
      231       and entry(2, p-code, chr(4)) = '':U then do:
      232         find first buf_schedule-attr no-lock
      233             where buf_schedule-attr.cre-db-num = p-cre-db-num
      234               and buf_schedule-attr.task-type  = p-task-type
      235               and buf_schedule-attr.task-num   = p-task-num
      236               and buf_schedule-attr.attr-code  begins p-code
      237         no-error .
      238       end.
      239       else do:
      240         find first buf_schedule-attr no-lock
      241             where buf_schedule-attr.cre-db-num = p-cre-db-num
      242               and buf_schedule-attr.task-type  = p-task-type
      243               and buf_schedule-attr.task-num   = p-task-num
      244               and buf_schedule-attr.attr-code  = p-code
      245         no-error .
      246       end.
      247       if available buf_schedule-attr
      248       then do:
      249           assign
      250               p-value = buf_schedule-attr.attr-value
      251           .
      252       end.
      253       else do:
      254         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      255            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      256         end.
      257         else do:
      258           assign
      259               p-value = if p-type = 'L':U then "no":U else ""
      260           .
      261         end.
      262       end.
      263   end.
      264   end procedure.
      265   procedure schedule-attr-write :
      266   do
      267   on error undo, return error
      268   :
      269   define input parameter p-cre-db-num  as integer   no-undo.
      270   define input parameter p-task-type   as character no-undo.
      271   define input parameter p-task-num    as integer   no-undo.
      272   define input parameter p-code        as character no-undo.
      273   define input parameter p-value       as character no-undo.
      274       define variable v-type              as character                no-undo.
      275       define variable v-format            as character                no-undo.
      276       define variable v-label             as character                no-undo.
      277       define variable v-user-can-edit     as logical                  no-undo.
      278       define variable v-output-display    as logical                  no-undo.
      279       define variable v-other             as character                no-undo.
      280       define buffer buf_schedule-attr for ub.schedule-attr .
      281       run schedule-attr-name in this-procedure (
      282             input  p-code
      283           , output v-type
      284           , output v-format
      285           , output v-label
      286           , output v-user-can-edit
      287           , output v-output-display
      288           , output v-other
      289       ) no-error.
      290       if error-status :error
      291       then do:
      292           undo, return error return-value.
      293       end.
      294       find first buf_schedule-attr exclusive-lock
      295            where buf_schedule-attr.cre-db-num = p-cre-db-num
      296              and buf_schedule-attr.task-type  = p-task-type
      297              and buf_schedule-attr.task-num   = p-task-num
      298              and buf_schedule-attr.attr-code  = p-code
      299       no-error.
      300       if not available buf_schedule-attr
      301       then do:
      302           create buf_schedule-attr.
      303           assign
      304             buf_schedule-attr.cre-db-num = p-cre-db-num
      305             buf_schedule-attr.task-type  = p-task-type
      306             buf_schedule-attr.task-num   = p-task-num
      307             buf_schedule-attr.attr-code  = p-code
      308             buf_schedule-attr.attr-value = p-value
      309           .
      310       end.
      311       else do:
      312           assign
      313               buf_schedule-attr.attr-value = p-value
      314           .
      315       end.
      316   end.
      317   end procedure.
      318   procedure schedule-attr-delete :
      319   do
      320   on error undo, return error
      321   :
      322   define input  parameter p-cre-db-num  as integer   no-undo.
      323   define input  parameter p-task-type   as character no-undo.
      324   define input  parameter p-task-num    as integer   no-undo.
      325   define input  parameter p-code        as character no-undo.
      326   define output parameter p-deleted     as logical   no-undo.
      327       define buffer buf_schedule-attr for ub.schedule-attr .
      328       define variable v-type              as character                no-undo.
      329       define variable v-format            as character                no-undo.
      330       define variable v-label             as character                no-undo.
      331       define variable v-user-can-edit     as logical                  no-undo.
      332       define variable v-output-display    as logical                  no-undo.
      333       define variable v-other             as character                no-undo.
      334       run schedule-attr-name in this-procedure (
      335             input p-code
      336           , output v-type
      337           , output v-format
      338           , output v-label
      339           , output v-user-can-edit
      340           , output v-output-display
      341           , output v-other
      342       ) no-error .
      343       if error-status :error
      344       then do:
      345           undo, return error return-value .
      346       end.
      347       find first buf_schedule-attr exclusive-lock
      348            where buf_schedule-attr.cre-db-num = p-cre-db-num
      349              and buf_schedule-attr.task-type  = p-task-type
      350              and buf_schedule-attr.task-num   = p-task-num
      351              and buf_schedule-attr.attr-code  = p-code
      352       no-error.
      353       if not available buf_schedule-attr
      354       then do:
      355           assign
      356               p-deleted = no
      357           .
      358       end.
      359       else do:
      360           delete buf_schedule-attr.
      361           assign
      362               p-deleted = yes
      363           .
      364       end.
      365   end.
      366   end procedure.
      367   procedure schedule-attr-news :
      368   do
      369   on error undo, return error
      370   :
      371       define input  parameter p-code           as character no-undo .
      372       define output parameter p-news           as logical   no-undo .
      373       if index(p-code, chr(4)) > 0 then do:
      374         p-code = entry(1, p-code, chr(4)).
      375       end.
      376       case p-code :
      377               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      378               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      379               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      380               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      381               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      382               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      383               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      384               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      385               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      386         otherwise do:
      387           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      388         end.
      389       end.
      390   end.
      391   end procedure.
      392   procedure schedule-attr-extract-logical :
      393   do
      394   on error undo, return error
      395   :
      396   define input  parameter p-parameter-number   as integer      no-undo.
      397   define input  parameter p-parameter-list     as character    no-undo.
      398   define output parameter p-parameter-value   as logical      no-undo.
      399       if num-entries( p-parameter-list ) > p-parameter-number - 1
      400       then do:
      401           assign
      402               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      403           .
      404       end.
      405       else do:
      406           assign
      407               p-parameter-value   = no
      408           .
      409       end.
      410   end.
      411   end procedure.
      412   procedure schedule-attr-get-free-id :
      413   do
      414   on error undo, return error return-value
      415   :
      416     define input  parameter p-cre-db-num  as integer   no-undo.
      417     define input  parameter p-task-type   as character no-undo.
      418     define input  parameter p-task-num    as integer   no-undo.
      419     define output parameter p-free-id     as character no-undo.
      420     define buffer buf_schedule-attr for ub.schedule-attr.
      421     find first buf_schedule-attr no-lock
      422         where buf_schedule-attr.cre-db-num = p-cre-db-num
      423           and buf_schedule-attr.task-type  = p-task-type
      424           and buf_schedule-attr.task-num   = p-task-num
      425           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      426     no-error .
      427     if available buf_schedule-attr then
      428     assign
      429     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      430     no-error
      431     .
      432   end.
      433   end procedure.
      434   procedure schedule-attr-get-free-props :
      435     define input parameter p-free-id as character no-undo .
      436     define output parameter p-value as character no-undo .
      437     define buffer buf_temp-schedule-free for temp-schedule-free.
      438     do
      439     on error undo, return error return-value
      440     :
      441       find first buf_temp-schedule-free no-lock no-error .
      442       if not available buf_temp-schedule-free then do:
      443         run schedule-attr-fill-free-props in this-procedure .
      444       end.
      445       find first buf_temp-schedule-free where
      446               buf_temp-schedule-free.free-id = p-free-id no-error.
      447       if available buf_temp-schedule-free then do:
      448         assign
      449         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      450                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      451                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      452                   buf_temp-schedule-free.conf-param           + chr(4) +
      453                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      454                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      455                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      456                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      457                   buf_temp-schedule-free.other-info
      458         .
      459       end.
      460       else do:
      461        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      462                              "id произвольной задачи - &5"
      463                              ,vss-workfile
      464                              ,vss-revision
      465                              ,vss-description
      466                              ,chr(10)
      467                              ,p-free-id).
      468       end.
      469     end.
      470   end procedure.
      471   procedure schedule-attr-is-rum-free-id :
      472   define input parameter p-free-id as character no-undo .
      473   define output parameter p-is-rum as logical no-undo .
      474   define buffer buf_temp-schedule-free for temp-schedule-free.
      475   do
      476   on error undo, return error
      477   :
      478       find first buf_temp-schedule-free no-lock no-error .
      479       if not available buf_temp-schedule-free then do:
      480         run schedule-attr-fill-free-props in this-procedure .
      481       end.
      482       find first buf_temp-schedule-free where
      483               buf_temp-schedule-free.free-id = p-free-id no-error.
      484       if available buf_temp-schedule-free
      485       and buf_temp-schedule-free.is-rum
      486       then do:
      487         p-is-rum = yes.
      488       end.
      489   end.
      490   end procedure.
      491   procedure schedule-attr-fill-free-props :
      492   define variable v-path                    as character                no-undo .
      493   DEFINE VARIABLE v-full-path               as character                no-undo .
      494   DEFINE VARIABLE v-file-name               as character                no-undo .
      495   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      496   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      497   define buffer buf_temp-schedule-free for temp-schedule-free.
      498   define variable v-answer as logical no-undo .
      499     do
      500     on error undo, return error substitute("&1 &2 &3&4&5&4"
      501                                           ,vss-workfile
      502                                           ,vss-revision
      503                                           ,vss-description
      504                                           ,chr(10)
      505                                           ,error-status:get-message(1) )
      506     :
      507       run gbl/filename.p (
      508                       input 'cmp/shd-free.d'
      509                     ,output v-full-path
      510                     ,output v-path
      511                     ,output v-file-name
      512                     ,output v-file-name-no-ext
      513                     ,output v-file-name-ext
      514                     ) .
      515       input from value(v-full-path).
      516       repeat :
      517         create buf_temp-schedule-free.
      518         import buf_temp-schedule-free.
      519       END.
      520       input close.
      521       _ff:
      522       for each buf_temp-schedule-free :
      523         if buf_temp-schedule-free.free-id = '':U then do:
      524            delete buf_temp-schedule-free.
      525            next _ff.
      526          end.
      527          run schedule-attr-check-enc in this-procedure (
      528                                                       input  buf_temp-schedule-free.free-id
      529                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      530                                                               buf_temp-schedule-free.proc-param-edit-name +
      531                                                               buf_temp-schedule-free.conf-param +
      532                                                               string(buf_temp-schedule-free.is-gbd) +
      533                                                               string(buf_temp-schedule-free.is-ubd) +
      534                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      535                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      536                                                               string(buf_temp-schedule-free.other-info)
      537                                                               )
      538                                                       ,input  buf_temp-schedule-free.enc-key
      539                                                       ,output v-answer    ) no-error .
      540          if error-status:error
      541          or not v-answer then delete buf_temp-schedule-free.
      542        end.
      543     end.
      544   end procedure.
      545   Function schedule-attr-reverse returns character (str as character).
      546      define variable rev_incl_s as character init "" no-undo .
      547      define variable rev_incl_i as integer no-undo .
      548      define variable rev_incl_l as integer no-undo .
      549      rev_incl_l = length(str).
      550      do rev_incl_i = 1 to rev_incl_l:
      551         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      552      end.
      553      return rev_incl_s.
      554   end.
      555   procedure schedule-attr-check-enc.
      556     define input  parameter p-free-id   as character no-undo .
      557     define input  parameter p-value     as character no-undo .
      558     define input  parameter p-enc-value as character no-undo .
      559     define output parameter p-answer    as logical   no-undo .
      560     define variable tmp         as character no-undo .
      561     define variable v-enc-value as character no-undo .
      562     assign
      563     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      564     .
      565     run schedule-attr-pswd-enc in this-procedure
      566       ( input tmp
      567        ,output v-enc-value
      568       ) no-error .
      569     if error-status:error then do:
      570       message
      571         vss-workfile vss-revision vss-description skip
      572         "Ошибка при вызове процедуры pswd-enc" skip
      573         return-value skip
      574         error-status :get-message(1) skip
      575         view-as alert-box error .
      576       undo, return error .
      577     end.
      578     if v-enc-value = p-enc-value then do:
      579       assign
      580         p-answer = true
      581       .
      582     end.
      583     else do:
      584       assign
      585         p-answer = false
      586       .
      587     end.
      588   end.
      589   procedure schedule-attr-conf-enc.
      590     define input  parameter p-free-id   as character no-undo .
      591     define input  parameter p-value     as character no-undo .
      592     define output parameter p-enc-value as character no-undo .
      593     define variable tmp         as character no-undo .
      594     assign
      595       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      596     .
      597     run schedule-attr-pswd-enc in this-procedure
      598       ( input tmp
      599        ,output p-enc-value
      600       ) no-error .
      601     if error-status:error then do:
      602       message
      603         vss-workfile vss-revision vss-description skip
      604         "Ошибка при вызове процедуры pswd-enc" skip
      605         return-value skip
      606         error-status :get-message(1) skip
      607         view-as alert-box error .
      608       undo, return error .
      609     end.
      610   end procedure.
      611   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      612   procedure schedule-attr-pswd-enc :
      613     define input parameter  pswd     as character no-undo .
      614     define output parameter enc-pswd as character no-undo .
      615     do
      616     on error undo, return error return-value
      617     :
      618       assign
      619         enc-pswd = encode(pswd + string(index(pswd, "k")))
      620       .
      621     end.
      622   end procedure.
      623   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      624   procedure factord :
      625     define input  parameter p-fact-date            as date    no-undo .
      626     define input  parameter p-fact-time            as integer no-undo .
      627     define input  parameter p-fact-num             as integer no-undo .
      628     define input  parameter p-shift-date           as date    no-undo .
      629     define input  parameter p-shift-num            as integer no-undo .
      630     define input  parameter p-shift-on             as logical no-undo .
      631     define output parameter p-fact-order           as decimal no-undo .
      632     define output parameter p-shift-end-fact-order as decimal no-undo .
      633     define output parameter p-day-end-fact-order   as decimal no-undo .
      634     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      635     if p-fact-date = ?
      636     then do:
      637       return error "Не указана фактическая дата" .
      638     end.
      639     define variable v-fact-date-num as integer no-undo .
      640     assign
      641       v-fact-date-num = integer(p-fact-date)
      642     .
      643     if p-fact-num = ?
      644     or p-fact-num = 0
      645     then do:
      646       return error "Не задан p-fact-num " + string(p-fact-num) .
      647     end.
      648     if p-fact-num < 0
      649     then do:
      650       return error "Отрицательный fact-num " + string(p-fact-num) .
      651     end.
      652     if p-fact-num >= 100000000
      653     then do:
      654       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      655     end.
      656     if p-shift-on = true
      657     then do:
      658       if p-shift-date = ?
      659       then do:
      660         return error "Не задана дата смены" .
      661       end.
      662       if p-shift-num = ?
      663       or p-shift-num = 0
      664       then do:
      665         return error "Не задан номер смены" .
      666       end.
      667     end.
      668     else do:
      669       assign
      670         p-shift-date = p-fact-date
      671         p-shift-num  = 24
      672       .
      673     end.
      674     define variable v-shift-offset as integer no-undo .
      675     if p-shift-date = p-fact-date
      676     then do:
      677       assign
      678         v-shift-offset = 1
      679       .
      680     end.
      681     if p-shift-date < p-fact-date
      682     then do:
      683       assign
      684         v-shift-offset = 0
      685       .
      686     end.
      687     if p-shift-date > p-fact-date
      688     then do:
      689       message
      690         vss-workfile vss-revision vss-description skip
      691         "Неправильная дата закрытия смены" skip
      692         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      693         view-as alert-box error .
      694       undo, return error
      695         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      696           ,string(p-fact-date, '99/99/9999':U)
      697           ,string(p-shift-date, '99/99/9999':U)
      698           )
      699       .
      700     end.
      701     if p-shift-num < 1
      702     or p-shift-num > 24
      703     then do:
      704       message
      705         vss-workfile vss-revision vss-description skip
      706         "Неправильный номер смены" skip
      707         "p-shift-num" p-shift-num skip
      708         view-as alert-box error .
      709       undo, return error return-value .
      710     end.
      711     assign
      712       p-fact-order           = v-fact-date-num
      713                              + v-shift-offset * 0.5
      714                              + p-shift-num    * 0.02 - 0.01
      715                              + p-fact-num     * 0.0000000001
      716       p-shift-end-fact-order = v-fact-date-num
      717                              + v-shift-offset * 0.5
      718                              + p-shift-num    * 0.02
      719       p-day-end-fact-order   = v-fact-date-num
      720                              + 0.99
      721     .
      722     if p-fact-order           <= v-fact-date-num
      723     or p-shift-end-fact-order <= v-fact-date-num
      724     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      725     or p-shift-end-fact-order >= p-day-end-fact-order
      726     then do:
      727       message
      728         vss-workfile vss-revision vss-description skip
      729         "Внутренняя ошибка при генерации фактического номера" skip
      730         "p-fact-date"            p-fact-date            skip
      731         "p-fact-time"            p-fact-time            skip
      732         "p-fact-num"             p-fact-num             skip
      733         "p-shift-date"           p-shift-date           skip
      734         "p-shift-num"            p-shift-num            skip
      735         "p-shift-on"             p-shift-on             skip
      736         "p-shift-end-fact-order" p-shift-end-fact-order skip
      737         "p-day-end-fact-order"   p-day-end-fact-order   skip
      738         "v-fact-date-num"        v-fact-date-num        skip
      739         view-as alert-box error .
      740       undo, return error return-value .
      741     end.
      742   end procedure.
      743   procedure day-begin-fact-order :
      744     define input  parameter p-fact-date            as date    no-undo .
      745     define output parameter p-day-begin-fact-order as decimal no-undo .
      746     do
      747     on error undo, return error return-value
      748     :
      749       if p-fact-date = ?
      750       then do:
      751         assign
      752           p-day-begin-fact-order = 0
      753         .
      754       end.
      755       else do:
      756         assign
      757           p-day-begin-fact-order = integer(p-fact-date)
      758         .
      759       end.
      760     end.
      761   end procedure.
      762   procedure factord-max-fact-order :
      763     define output parameter p-max-fact-order as decimal   no-undo .
      764     do
      765     on error undo, return error return-value
      766     :
      767       run day-begin-fact-order in this-procedure
      768         (input  date(1, 1, 5000)
      769         ,output p-max-fact-order
      770         ) .
      771     end.
      772   end procedure.
      773   procedure factord-cut-archive :
      774     define input  parameter p-obj-type             as character no-undo .
      775     define input  parameter p-obj-code             as integer   no-undo .
      776     define input  parameter p-fact-date            as date      no-undo .
      777     define output parameter p-shift-on             as logical   no-undo .
      778     define output parameter p-shift-date           as date      no-undo .
      779     define output parameter p-shift-num            as integer   no-undo .
      780     define output parameter p-day-end-fact-order   as decimal   no-undo .
      781     define output parameter p-shift-end-fact-order as decimal   no-undo .
      782     define variable v-fact-order as decimal   no-undo .
      783     define buffer buf_shift-obj for ub.shift-obj .
      784     do
      785     on error undo, return error return-value
      786     :
      787   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      788   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      789     (input  p-obj-type
      790     ,input  p-obj-code
      791     ,input  'shift-on=request'
      792     ,output p-shift-on
      793     ) no-error .
      794       if error-status :error
      795       then do:
      796         message
      797           vss-workfile vss-revision vss-description skip
      798           "Ошибка при определении атрибута объекта" skip
      799           "Объект" p-obj-type p-obj-code skip
      800           error-status :get-message(1) skip
      801           return-value skip
      802           view-as alert-box error .
      803         undo, return error return-value .
      804       end.
      805       if p-shift-on = false
      806       then do:
      807         assign
      808           p-shift-date               = ?
      809           p-shift-num                = 0
      810         .
      811       end.
      812       else do:
      813         find first buf_shift-obj share-lock
      814           where buf_shift-obj.obj-type   = p-obj-type
      815             and buf_shift-obj.obj-code   = p-obj-code
      816             and buf_shift-obj.shift-date > p-fact-date
      817           use-index pi
      818           no-error .
      819         if not available buf_shift-obj
      820         or buf_shift-obj.status_ <> 'зкр':U
      821         then do:
      822           message
      823             vss-workfile vss-revision vss-description skip
      824             "Невозможно вычислить последнюю смену" skip
      825             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      826             "Объект" p-obj-type p-obj-code skip
      827             "Дата" p-fact-date skip
      828             view-as alert-box error .
      829           undo, return error return-value .
      830         end.
      831         find last buf_shift-obj share-lock
      832           where buf_shift-obj.obj-type = p-obj-type
      833             and buf_shift-obj.obj-code = p-obj-code
      834             and buf_shift-obj.shift-date <= p-fact-date
      835           use-index pi
      836           no-error .
      837         if available buf_shift-obj
      838         then do:
      839           if  buf_shift-obj.status_ = 'зкр':U
      840           then do:
      841             assign
      842               p-shift-date = buf_shift-obj.shift-date
      843               p-shift-num  = buf_shift-obj.shift-num
      844             .
      845           end.
      846           else do:
      847             message
      848               vss-workfile vss-revision vss-description skip
      849               "Невозможно вычислить последнюю смену" skip
      850               "Статус смены отличен от статуса" 'зкр':U skip
      851               "Объект" p-obj-type p-obj-code skip
      852               "Дата" p-fact-date skip
      853               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      854               view-as alert-box error .
      855             undo, return error return-value .
      856           end.
      857         end.
      858         else do:
      859           assign
      860             p-shift-date = p-fact-date - 1
      861             p-shift-num  = 1
      862           .
      863         end.
      864       end.
      865       run factord in this-procedure
      866         (input  p-fact-date
      867         ,input  1
      868         ,input  1
      869         ,input  p-shift-date
      870         ,input  p-shift-num
      871         ,input  p-shift-on
      872         ,output v-fact-order
      873         ,output p-shift-end-fact-order
      874         ,output p-day-end-fact-order
      875         ) no-error .
      876       if error-status :error
      877       then do:
      878         message
      879           vss-workfile vss-revision vss-description skip
      880           "Ошибка при вызове процедуры factord"
      881           error-status :get-message(1) skip
      882           return-value skip
      883           view-as alert-box error .
      884         undo, return error return-value .
      885       end.
      886     end.
      887   end procedure.
      888   procedure factord-lock-shift :
      889     define input  parameter p-obj-type  as character no-undo .
      890     define input  parameter p-obj-code  as integer   no-undo .
      891     define input  parameter p-fact-date as date      no-undo .
      892     define parameter buffer buf_shift-obj for ub.shift-obj .
      893     define variable v-shift-on      as logical   no-undo .
      894     define variable v-extra-message as character no-undo .
      895     define variable v-error as character no-undo .
      896     do
      897     on error undo, return error return-value
      898     :
      899   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      900   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      901     (input  p-obj-type
      902     ,input  p-obj-code
      903     ,input  'shift-on=request'
      904     ,output v-shift-on
      905     ) no-error .
      906       if error-status :error
      907       then do:
      908         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      909         undo, return error v-error .
      910       end.
      911       if v-shift-on = true
      912       then do:
      913         find first buf_shift-obj share-lock
      914           where buf_shift-obj.obj-type   = p-obj-type
      915             and buf_shift-obj.obj-code   = p-obj-code
      916             and buf_shift-obj.shift-date > p-fact-date
      917           use-index pi
      918           no-error .
      919         if not available buf_shift-obj
      920         or buf_shift-obj.status_ <> 'зкр':U
      921         then do:
      922           find last buf_shift-obj
      923             where buf_shift-obj.obj-type = p-obj-type
      924               and buf_shift-obj.obj-code = p-obj-code
      925               and buf_shift-obj.status_  = 'зкр':U
      926             use-index stts
      927             no-error .
      928           if available buf_shift-obj
      929           then do:
      930             assign
      931               v-extra-message =
      932                     substitute("Дата начала последеней закрытой смены на объекте &1"
      933                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      934                               )
      935             .
      936           end.
      937           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      938           undo, return error v-error .
      939         end.
      940       end.
      941     end.
      942   end procedure.
      943   procedure factord-end-day :
      944     define input  parameter p-fact-date            as date    no-undo .
      945     define output parameter p-day-end-fact-order   as decimal no-undo .
      946     do
      947     on error undo, return error return-value
      948     :
      949       if p-fact-date = ?
      950       then do:
      951         return error "Не указана фактическая дата" .
      952       end.
      953       assign
      954         p-day-end-fact-order = integer(p-fact-date) + 0.99
      955       .
      956     end.
      957   end procedure.
      958   procedure factord-to-date :
      959     define input  parameter p-fact-order as decimal no-undo .
      960     define output parameter p-fact-date  as date    no-undo .
      961     define variable v-ref-date  as date      no-undo .
      962     define variable v-ref-delta as integer   no-undo .
      963     do
      964     on error undo, return error return-value
      965     :
      966       if p-fact-order = ?
      967       or p-fact-order = 0
      968       then do:
      969         return error "Не указан fact-order" .
      970       end.
      971       assign
      972         v-ref-date  = date(1, 1, 2000)
      973       .
      974       assign
      975         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      976       .
      977       assign
      978         p-fact-date = v-ref-date + v-ref-delta
      979       .
      980     end.
      981   end procedure.
      982   procedure factord-to-fact-num :
      983     define input  parameter p-fact-order as decimal no-undo .
      984     define output parameter p-fact-num   as integer no-undo .
      985     define variable v-fact-order-trunc as decimal no-undo .
      986     do
      987     on error undo, return error return-value
      988     :
      989       if p-fact-order = ?
      990       or p-fact-order = 0
      991       then do:
      992         return error "Не указан fact-order" .
      993       end.
      994       assign
      995        v-fact-order-trunc = truncate(p-fact-order, 2)
      996       .
      997       assign
      998         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      999       .
     1000     end.
     1001   end procedure.
     1002   procedure factord-to-shift-num :
     1003     define input  parameter p-fact-order as decimal no-undo .
     1004     define output parameter p-shift-num   as integer no-undo .
     1005     define variable  p-shift-numd  as decimal   no-undo .
     1006     define variable v-fact-order-trunc as decimal no-undo .
     1007     do
     1008     on error undo, return error return-value
     1009     :
     1010       if p-fact-order = ?
     1011       or p-fact-order = 0
     1012       then do:
     1013         return error "Не указан fact-order" .
     1014       end.
     1015       assign
     1016        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1017       .
     1018       if v-fact-order-trunc < 0.5 then do:
     1019         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1020       end.
     1021       assign
     1022         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1023         .
     1024        assign
     1025         p-shift-num = truncate (p-shift-numd , 0)
     1026       .
     1027     end.
     1028   end procedure.
     1029   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1030   procedure cur-time :
     1031      define output parameter p-today as date      no-undo .
     1032      define output parameter p-time  as integer   no-undo .
     1033     do
     1034     on error undo, return error
     1035     :
     1036       define variable v-date1 as date      no-undo .
     1037       define variable v-date2 as date      no-undo .
     1038       define variable v-time  as integer   no-undo .
     1039       assign
     1040         v-date1 = today
     1041         v-time  = time
     1042         v-date2 = today
     1043       .
     1044       if v-date1 <> v-date2
     1045       then do:
     1046         assign
     1047           v-date1 = today
     1048           v-time  = v-time
     1049         .
     1050       end.
     1051       assign
     1052         p-today = v-date1
     1053         p-time  = v-time
     1054       .
     1055     end.
     1056   end.
     1057   function cur-time-date returns character
     1058   :
     1059     return string(today, '99/99/9999':U) .
     1060   end.
     1061   function cur-time-mjd returns decimal
     1062   :
     1063     define variable v-date as date      no-undo .
     1064     define variable v-time as integer   no-undo .
     1065     run cur-time in this-procedure
     1066       (output v-date
     1067       ,output v-time
     1068       ) .
     1069     return integer(v-date) - 2400002 + (v-time / 86400) .
     1070   end.
     1071   function cur-time-get-ending-index returns integer
     1072   (input p-number as integer
     1073   )
     1074   :
     1075     if p-number < 0
     1076     or p-number = ?
     1077     then do:
     1078       return 1 .
     1079     end.
     1080     define variable v-rest as integer   no-undo .
     1081     assign
     1082       p-number = p-number modulo 100
     1083     .
     1084     if p-number < 20
     1085     then do:
     1086       assign
     1087         v-rest = p-number
     1088       .
     1089     end.
     1090     else do:
     1091       assign
     1092         v-rest = p-number modulo 10
     1093       .
     1094     end.
     1095     case v-rest :
     1096       when 1
     1097       then do:
     1098         return 2 .
     1099       end.
     1100       when 2 or
     1101       when 3 or
     1102       when 4
     1103       then do:
     1104         return 3 .
     1105       end.
     1106       otherwise do:
     1107         return 1 .
     1108       end.
     1109     end case .
     1110   end.
     1111   procedure cur-time-mjd-to-date :
     1112      define input  parameter i-mjd-diff as decimal no-undo.
     1113      define output parameter o-Date     as date    no-undo.
     1114      define output parameter o-Time     as integer no-undo.
     1115      define variable v-day-number as integer   no-undo .
     1116      if    i-mjd-diff < 0
     1117         or i-mjd-diff = ?
     1118      then do:
     1119         return "?" .
     1120      end.
     1121      assign
     1122         v-day-number = truncate(i-mjd-diff,0).
     1123         o-Date = date(v-day-number + 2400002).
     1124         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1125     .
     1126   end.
     1127   function cur-time-mjd-to-string returns character
     1128   (input p-mjd-diff as decimal
     1129   )
     1130   :
     1131     define variable v-day-number as integer   no-undo .
     1132     define variable v-seconds    as integer   no-undo .
     1133     define variable v-hour       as integer   no-undo .
     1134     define variable v-min        as integer   no-undo .
     1135     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1136     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1137     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1138     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1139     if p-mjd-diff < 0
     1140     or p-mjd-diff = ?
     1141     then do:
     1142       return "?" .
     1143     end.
     1144     assign
     1145       v-day-number = integer(truncate(p-mjd-diff,0))
     1146       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1147     .
     1148     if v-seconds > 86400
     1149     then do:
     1150       assign
     1151         v-seconds = 86400 - 1
     1152       .
     1153     end.
     1154     if v-seconds < 0
     1155     then do:
     1156       assign
     1157         v-seconds = 0
     1158       .
     1159     end.
     1160     assign
     1161       v-hour = truncate(v-seconds / 3600, 0)
     1162     .
     1163     assign
     1164       v-seconds = v-seconds modulo 3600
     1165     .
     1166     assign
     1167       v-min = truncate(v-seconds / 60, 0)
     1168     .
     1169     assign
     1170       v-seconds = v-seconds modulo 60
     1171     .
     1172     return
     1173         (if v-day-number <> 0
     1174           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1175           else ""
     1176         )
     1177       + (if v-day-number <> 0 or v-hour <> 0
     1178           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1179           else ""
     1180         )
     1181       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1182           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1183           else ""
     1184         )
     1185       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1186       .
     1187   end.
     1188   function cur-time-string returns character
     1189   :
     1190     define variable v-date as date      no-undo .
     1191     define variable v-time as integer   no-undo .
     1192     run cur-time in this-procedure
     1193       (output v-date
     1194       ,output v-time
     1195       ) .
     1196     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1197   end.
     1198   function cur-time-string-sec returns character
     1199   :
     1200     define variable v-date as date      no-undo .
     1201     define variable v-time as integer   no-undo .
     1202     run cur-time in this-procedure
     1203       (output v-date
     1204       ,output v-time
     1205       ) .
     1206     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1207   end.
     1208   function cur-time-custom  returns character
     1209   (input p-prefix as character
     1210   ,input p-date-format as character
     1211   ,input p-delimiter as character
     1212   ,input p-time-format as character
     1213   ,input p-suffix as character
     1214   )
     1215   :
     1216     define variable v-date as date      no-undo .
     1217     define variable v-time as integer   no-undo .
     1218     run cur-time in this-procedure
     1219       (output v-date
     1220       ,output v-time
     1221       ) .
     1222     return
     1223       p-prefix
     1224       + string(v-date, p-date-format)
     1225       + p-delimiter
     1226       + string(v-time, p-time-format)
     1227       + p-suffix
     1228       .
     1229   end.
     1230   function cur-time-print  returns character
     1231   :
     1232     define variable v-date as date      no-undo .
     1233     define variable v-time as integer   no-undo .
     1234     run cur-time in this-procedure
     1235       (output v-date
     1236       ,output v-time
     1237       ) .
     1238     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1239   end.
     1240   function cur-time-datetime returns datetime
     1241   :
     1242     define variable v-char as character no-undo .
     1243     define variable v-datetime as datetime no-undo .
     1244     v-char = cur-time-string().
     1245     v-datetime = datetime(v-char).
     1246     return  v-datetime.
     1247   end.
     1248   function cur-time-string-msec returns character
     1249   :
     1250     define variable v-date as datetime  no-undo .
     1251     v-date = now.
     1252     return string(v-date) .
     1253   end.
     1254   define variable v-task-num   as integer   no-undo.
     1255   define variable v-param-list as character no-undo.
     1256   define variable v-param-type as character no-undo.
     1257   define buffer buf_schedule      for ub.schedule.
     1258   define buffer buf_schedule-attr for ub.schedule-attr.
     1259   define variable v-ii1        as integer   no-undo.
     1260   define variable v-ii2        as integer   no-undo.
     1261   define variable num-days     as integer   no-undo.
     1262   define variable v-db-list    as character no-undo .
     1263   define variable v-today      as date      no-undo.
     1264   define variable v-time       as integer   no-undo.
     1265   DEFINE variable v-date_from  as date      no-undo .
     1266   define variable v-folder     as character no-undo .
     1267   define variable v-file       as character no-undo .
     1268   do
     1269     on error undo, return error
     1270     :
     1271     if p-task-num > 0
     1272       then
     1273     do:
     1274       v-task-num = p-task-num.
     1275     end.
     1276     else
     1277     do:
     1278       for each buf_schedule
     1279         where buf_schedule.task-type     = p-task-type
     1280         AND buf_schedule.cre-db-num    = INTEGER(p-db-num-char)
     1281         no-lock
     1282         ,
     1283         first buf_schedule-attr
     1284         where buf_schedule-attr.task-type   = p-task-type
     1285         AND buf_schedule-attr.cre-db-num  = INTEGER(p-db-num-char)
     1286         AND buf_schedule-attr.task-num    = buf_schedule.task-num
     1287         AND buf_schedule-attr.attr-code   = ('schd-free-id':U + chr(4) + 'rep-RC')
     1288         no-lock
     1289         :
     1290         ASSIGN
     1291           v-task-num = buf_schedule.task-num
     1292           .
     1293         leave .
     1294       end.
     1295     end.
     1296     if v-task-num > 0
     1297       then
     1298     do:
     1299       run schedule-attr-value in this-procedure  ( input p-db-num-char
     1300         , input p-task-type
     1301         , input v-task-num
     1302         , input 'schedule-param-list':U
     1303         , output v-param-list
     1304         , output v-param-type
     1305         ) NO-ERROR .
     1306     end.
     1307     v-ii2 = num-entries( v-param-list, chr(4) ).
     1308     if v-ii2 < 3 THEN
     1309     do:
     1310       do v-ii1 = v-ii2 to 3:
     1311         v-param-list = v-param-list
     1312           + '':U
     1313           + chr(4).
     1314       end.
     1315     end.
     1316     ASSIGN
     1317                 v-folder    = ENTRY(1, v-param-list, chr(4))
     1318                 v-file      = ENTRY(2, v-param-list, chr(4))
     1319                 num-days    = INTEGER( ENTRY(4, v-param-list, chr(4)) )
     1320       .
     1321     if v-task-num > 0 then
     1322       run schedule-attr-value in this-procedure  ( input p-db-num-char
     1323         , input p-task-type
     1324         , input v-task-num
     1325         , input 'schedule-obj-list':U
     1326         , output v-db-list
     1327         , output v-param-type
     1328         ) NO-ERROR .
     1329     run cur-time in this-procedure ( output v-today
     1330     , output v-time
     1331     ).
     1332     v-date_from = v-today - num-days .
     1333     run rep/hdd-report-shd.p ( INPUT parparentproc
     1334       , INPUT v-date_from
     1335       , INPUT v-today
     1336       , INPUT v-db-list
     1337       , input v-folder
     1338       , input v-file
     1339       ) .
     1340   end.
