     1819   define temp-table tt-gds no-undo
     1820       field gds-code          like ub.goods.gds-code          label "Код товара в TH"
     1821       field gds-name          like ub.goods.gds-name          label "Полное наименование" format "X(100)"
     1822       field alc-code          as character                    label "Алкогольный код"
     1823       field ms-base           like ub.goods.ms-base           label "Объем"               format ">>>9.9<<"
     1824       field alc-type-code     like ub.alc-type.alc-type-code  label "Код АП"
     1825       field proof             like ub.goods.proof             label "Крепость"            format ">9.9"
     1826       field fromEgais         as logical
     1827       field egais-name        as character                    label "Наименование ЕГАИС"  format "X(100)"
     1828       field prod-info         as character
     1829       field imp-info          as character
     1830       field old-gds-code      like ub.goods.gds-code
     1831       field old-alc-code      as character
     1832       index pi as primary
     1833           gds-code
     1834       index name_ as word-index
     1835           gds-name
     1836       index alc
     1837           alc-code
     1838   .
     1839   define buffer old_tt-gds for tt-gds .
     1840   define buffer buf_tt-gds for tt-gds .
     1841   define buffer buf2_tt-gds for tt-gds .
     1842   def var egais as class EGAIS.
     1843   def var extGdsObj as class ExtGds.
     1844   def var numBundles as integer no-undo .
     1845   def var bh-gds-egais as handle no-undo .
     1846   def var qh-gds-egais as handle no-undo .
     1847   define buffer buf_firm for ub.firm .
     1848   define buffer buf_clients for ub.clients .
     1849   define buffer buf_clients-attr for ub.clients-attr .
     1850   define buffer buf_goods for ub.goods .
     1851   define buffer buf_goods-attr for ub.goods-attr .
     1852   DEFINE BUFFER X_ext-classif FOR ub.ext-classif.
     1853   DEFINE BUFFER XX_ext-classif FOR ub.ext-classif.
     1854   DEFINE BUFFER X_ext-classif-attr FOR ub.ext-classif-attr.
     1855   DEFINE BUFFER XX_ext-classif-attr FOR ub.ext-classif-attr.
     1856   define variable select-list as longchar no-undo .
     1857   define variable ref-list    as character no-undo .
     1858   define variable ii          as integer   no-undo .
     1859   define variable v-rid       as recid     no-undo .
     1860   define variable par-alcohol as character no-undo .
     1861   define variable par-egais-name as character no-undo .
     1862   define variable par-type    as character no-undo .
     1863   define variable v-kpp       as character no-undo .
     1864   define variable v-org-inn   as character no-undo .
     1865   define variable v-isSent    as logical   no-undo .
     1866   define variable v-outId     as character no-undo .
     1867   define variable v-ext-sys   as integer   no-undo .
     1868   define variable v-replyId   as character no-undo .
     1869   define variable v-alc-code  as character no-undo .
     1870   define variable entry7      as character no-undo .
     1871   define variable entry8      as character no-undo .
     1872   define variable glog        as logical no-undo .
     1873   define variable v-gds-uniq-key-rec as character no-undo .
     1874   define variable saved as logical no-undo initial no .
     1875   define variable gds-rec as recid no-undo .
     1876   define variable v-value-character  as character no-undo .
     1877   define variable v-value-decimal    as decimal   no-undo .
     1878   define variable v-value-integer    as integer   no-undo .
     1879   define variable v-value-logical    as logical   no-undo .
     1880   define variable v-value-type       as character no-undo .
     1881   define variable v-value-date       as date      no-undo .
     1882   define variable v-org as character no-undo .
     1883   define variable v-fs-rar as character no-undo .
     1884   FUNCTION get-mark RETURNS CHARACTER
     1885   (buffer local-gds for tt-gds ):
     1886   if lookup (string (recid (local-gds)), select-list) > 0  then return "*".
     1887                                                              else return "".
     1888   end function.
     1889   define variable v-prod as character no-undo view-as text format "X(11)" label "Производитель" .
     1890   define variable v-prod-name as character no-undo view-as text format "X(30)" .
     1891   define variable letter as character no-undo .
     1892   Define variable NameContext as character view-as fill-in size 30 by 1 fgcolor 12 no-undo .
     1893   Define variable NameContext2 as character no-undo initial "" .
     1894   DEFINE BUTTON b-mark
     1895        LABEL "&*"
     1896        SIZE 3 BY 1.14 .
     1897   DEFINE BUTTON b-cancel AUTO-END-KEY
     1898        LABEL "Выход"
     1899        SIZE 15 BY 1.14
     1900        BGCOLOR 8 .
     1901   DEFINE BUTTON b-load
     1902        LABEL "Запрос"
     1903        tooltip "Отправить запрос в ЕГАИС"
     1904        SIZE 15 BY 1.14
     1905        BGCOLOR 8 .
     1906   DEFINE BUTTON b-save
     1907        LABEL "Сохранить"
     1908        tooltip "Записать данные в справочник"
     1909        SIZE 15 BY 1.14
     1910        BGCOLOR 8 .
     1911   DEFINE BUTTON b-answer
     1912        LABEL "Получить ответ"
     1913        SIZE 15 BY 1.14
     1914        BGCOLOR 8 .
     1915   DEFINE BUTTON b-lkp
     1916        LABEL "Просмотр"
     1917        SIZE 15 BY 1.14
     1918        BGCOLOR 8 .
     1919   DEFINE BUTTON b-good
     1920        LABEL "Товар"
     1921        SIZE 15 BY 1.14
     1922        BGCOLOR 8 .
     1923   DEFINE BUTTON b-connect
     1924        LABEL "Связать"
     1925        SIZE 13 BY 1.14
     1926        BGCOLOR 8 .
     1927   DEFINE BUTTON b-sel-all
     1928        LABEL "&+":L
     1929        SIZE 3 BY 1.14 TOOLTIP "Отметить все объекты".
     1930   DEFINE BUTTON b-unmark
     1931        LABEL "&-":L
     1932        SIZE 3 BY 1.14 TOOLTIP "Снять все отметки".
     1933   DEFINE BUTTON b-prod
     1934        IMAGE-UP FILE "btn-down-arrow":U
     1935        IMAGE-DOWN FILE "btn-down-arrow":U
     1936        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1937        LABEL ""
     1938        SIZE 3 BY 1.14 TOOLTIP "Выбор производителя".
     1939   DEFINE VARIABLE rs-sort AS INTEGER
     1940        VIEW-AS RADIO-SET HORIZONTAL
     1941        RADIO-BUTTONS
     1942           "&названию", 1,
     1943           "&коду в TH", 2,
     1944           "&алк. коду", 3
     1945        SIZE 40 BY 1.14 NO-UNDO.
     1946   DEFINE VARIABLE rs-mode AS INTEGER
     1947        VIEW-AS RADIO-SET VERTICAL
     1948        RADIO-BUTTONS
     1949           "&изменить", 1,
     1950           "&добавить", 2
     1951        SIZE 10 BY 2 TOOLTIP "ИЗМЕНЕНИЕ - если есть алкогольный код, заменяет его на новый, если нет - создает. ДОБАВЛЕНИЕ - добавляет алкогольный код к уже существующим" NO-UNDO .
     1952    define rectangle rect1 edge-pixels 3 graphic-edge no-fill size-chars 13.3 by 3.5 .
     1953   DEFINE QUERY br-goods FOR
     1954         tt-gds SCROLLING.
     1955   DEFINE BROWSE br-goods
     1956     QUERY br-goods  DISPLAY
     1957       get-mark(BUFFER tt-gds) COLUMN-LABEL "*"  FORMAT "X(1)":U
     1958       tt-gds.gds-code COLUMN-LABEL "Код товара в TH" FORMAT ">>>>>>>>9"
     1959       tt-gds.gds-name COLUMN-LABEL "Наименование товара" FORMAT "X(100)":U width 38
     1960       tt-gds.alc-code COLUMN-LABEL "Алкогольный код" FORMAT "X(25)":U
     1961       tt-gds.ms-base  COLUMN-LABEL "Объем" FORMAT ">>>9.9<<"
     1962       tt-gds.proof    COLUMN-LABEL "Крепость" FORMAT ">9.9"
     1963       tt-gds.alc-type-code COLUMN-LABEL "Код АП" FORMAT "X(4)":U
     1964       tt-gds.egais-name COLUMN-LABEL "Наименование в ЕГАИС" FORMAT "X(100)":U width 39
     1965       WITH NO-ROW-MARKERS SEPARATORS SIZE 105 BY 20.2 FIT-LAST-COLUMN.
     1966   DEFINE FRAME Dialog-Frame
     1967        b-mark AT ROW 2.5 COL 2
     1968        b-sel-all AT ROW 2.5 COL 5
     1969        b-unmark AT ROW 2.5 COL 8
     1970        b-load AT ROW 1.24 COL 32
     1971        b-answer AT ROW 1.24 COL 47
     1972        b-save AT ROW 1.24 COL 17
     1973        b-lkp AT ROW 1.24 COL 62
     1974        b-good AT ROW 1.24 COL 77
     1975        b-cancel AT ROW 1.24 COL 2
     1976        v-prod AT ROW 2.7 COL 13
     1977        b-prod AT ROW 2.5 COL 40
     1978        v-prod-name AT ROW 2.7 COL 45 no-label
     1979        "Сортировать по:" VIEW-AS TEXT
     1980             SIZE 15 BY 1.14 AT ROW 3.6 COL 2 WIDGET-ID 18
     1981        rs-sort AT ROW 3.6 COL 18 no-label
     1982        rs-mode at row 2.5 col 93 no-label
     1983        rect1 at row 1.2 col 91.9
     1984        b-connect AT ROW 1.24 COL 92
     1985        NameContext at row 4.6 col 2 label "Нач. слова"
     1986        br-goods AT ROW 5.8 COL 2 WIDGET-ID 200
     1987        SPACE(1) SKIP(0.32)
     1988       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1989            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1990            TITLE "Алкогольная продукция ЕГАИС"
     1991            DEFAULT-BUTTON b-load CANCEL-BUTTON b-cancel WIDGET-ID 100.
     1992   assign br-goods:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 1 .
     1993   ASSIGN
     1994          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1995          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1996   ON return OF NameContext IN FRAME Dialog-Frame do:
     1997       assign NameContext.
     1998       if NameContext = "" then NameContext2 = "" .
     1999       else do :
     2000           letter = substring(NameContext, length(NameContext), 1) .
     2001           if letter = 'н'
     2002           or letter = 'о'
     2003           or letter = 'э'
     2004           or letter = 'ю'
     2005           or letter = 'я'
     2006           then NameContext2 = trim(NameContext).
     2007           else NameContext2 = trim(NameContext) + "*" .
     2008       end.
     2009       run refresh-query in this-procedure.
     2010   end.
     2011   on F9 of frame Dialog-Frame anywhere do:
     2012     if not available tt-gds then  return no-apply.
     2013     if tt-gds.gds-code = 0  then  return no-apply.
     2014     find first goods no-lock where goods.gds-code = tt-gds.gds-code .
     2015     gds-rec = recid(goods) .
     2016     run ref/gds-form.w
     2017       (input  parParentProc
     2018       ,input  'ИЗМЕНЕНИЕ':U
     2019       ,input  v-cntxt-obj-type
     2020       ,input  v-cntxt-obj-code
     2021       ,input ?
     2022       ,input-output gds-rec
     2023       ).
     2024   end.
     2025   ON CHOOSE OF b-good IN FRAME Dialog-Frame
     2026   DO:
     2027       apply "F9" to frame Dialog-Frame .
     2028   END.
     2029   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2030   DO:
     2031     APPLY "END-ERROR":U TO SELF.
     2032   END.
     2033   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     2034   DO:
     2035     run proc-b-mark in this-procedure no-error.
     2036   END.
     2037   ON CHOOSE OF b-sel-all IN FRAME Dialog-Frame
     2038   DO:
     2039     assign select-list = "".
     2040     if not available tt-gds then return.
     2041     for each tt-gds no-lock :
     2042   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2043   define variable v-str-recid10 as character no-undo .
     2044   define variable v-num-entry10 as integer   no-undo .
     2045   assign
     2046     v-str-recid10 = trim( string( recid( tt-gds ) , "->>>>>>>>>>>9":U ) )
     2047     v-num-entry10 = lookup( v-str-recid10 , select-list )
     2048   .
     2049   if v-num-entry10 > 0 then do:
     2050     assign
     2051       entry( v-num-entry10, select-list ) = "":U
     2052       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2053     .
     2054   end.
     2055   else do:
     2056     assign
     2057       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid10
     2058     .
     2059   end.
     2060     end.
     2061     br-goods:refresh() in frame Dialog-Frame .
     2062   END.
     2063   ON CHOOSE OF b-unmark IN FRAME Dialog-Frame
     2064   DO:
     2065     if not available tt-gds then return.
     2066     select-list  = "".
     2067     br-goods:refresh() in frame Dialog-Frame .
     2068   END.
     2069   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     2070   DO:
     2071       message "Все несохранённые данные будут потеряны. Вы уверены, что хотите выйти?"
     2072       view-as alert-box question buttons yes-no update glog.
     2073       if not glog then return no-apply .
     2074   END.
     2075   ON CHOOSE OF b-prod IN FRAME Dialog-Frame
     2076   DO:
     2077       run sel-prod in this-procedure .
     2078       assign
     2079         rs-sort
     2080       .
     2081       run refresh-query in this-procedure.
     2082   END.
     2083   ON VALUE-CHANGED OF rs-sort IN FRAME Dialog-Frame
     2084   DO:
     2085     assign
     2086       rs-sort
     2087     .
     2088     run refresh-query in this-procedure.
     2089   END.
     2090   ON VALUE-CHANGED OF rs-mode IN FRAME Dialog-Frame
     2091   DO:
     2092     assign
     2093       rs-mode
     2094     .
     2095   END.
     2096   ON CHOOSE OF b-connect IN FRAME Dialog-Frame
     2097   DO:
     2098       if not available tt-gds then return no-apply.
     2099       assign v-rid = recid(tt-gds) .
     2100       if tt-gds.fromEgais then do :
     2101           run ref/gds-ref.p (parparentproc, 'b-sel,b-add', ?, ?, ?, ?, ?, ?, ?, v-cntxt-obj-type, v-cntxt-obj-code, ?, output ref-list) no-error.
     2102           if error-status:error or ref-list = ? or ref-list = "" then
     2103           do:
     2104               message "Ошибка при выборе товара." view-as alert-box.
     2105               return no-apply.
     2106           end.
     2107           find first buf_goods where recid(buf_goods) = integer(ref-list) no-error.
     2108           if tt-gds.gds-code = 0 or tt-gds.gds-code = ? or rs-mode = 1 then do :
     2109               assign
     2110                   tt-gds.gds-code = buf_goods.gds-code
     2111                   tt-gds.gds-name = buf_goods.gds-name
     2112                   tt-gds.ms-base  = buf_goods.ms-base
     2113                   tt-gds.proof    = buf_goods.proof
     2114               .
     2115           end.
     2116           else do :
     2117               find first buf_tt-gds no-lock where buf_tt-gds.gds-code = buf_goods.gds-code
     2118                                               and buf_tt-gds.alc-code = tt-gds.alc-code
     2119                                               and recid(buf_tt-gds) <> recid(tt-gds) no-error .
     2120               if not available buf_tt-gds then do :
     2121                   create buf2_tt-gds .
     2122                   buffer-copy tt-gds except gds-code gds-name ms-base proof old-gds-code to buf2_tt-gds
     2123                       assign
     2124                           buf2_tt-gds.gds-code = buf_goods.gds-code
     2125                           buf2_tt-gds.gds-name = buf_goods.gds-name
     2126                           buf2_tt-gds.ms-base  = buf_goods.ms-base
     2127                           buf2_tt-gds.proof    = buf_goods.proof
     2128                   .
     2129               end.
     2130           end.
     2131       end.
     2132       else do :
     2133           run bge/egais-select-good.w (input tt-gds.ms-base
     2134                                       ,input tt-gds.proof
     2135                                       ,input tt-gds.alc-type-code
     2136                                       ,input bh-gds-egais:handle
     2137                                       ,output v-alc-code) .
     2138           if v-alc-code <> "" and v-alc-code <> ? then do :
     2139               if tt-gds.alc-code = "" or tt-gds.alc-code = ? then assign tt-gds.alc-code = v-alc-code .
     2140               else do :
     2141                   if rs-mode = 1 then assign tt-gds.alc-code = v-alc-code .
     2142                   if rs-mode = 2 then do :
     2143                       find first buf_tt-gds no-lock where buf_tt-gds.gds-code = tt-gds.gds-code
     2144                                                       and buf_tt-gds.alc-code = v-alc-code
     2145                                                       and recid(buf_tt-gds) <> recid(tt-gds) no-error .
     2146                       if not available buf_tt-gds then do :
     2147                           create buf2_tt-gds .
     2148                           buffer-copy tt-gds except alc-code old-alc-code to buf2_tt-gds
     2149                               assign buf2_tt-gds.alc-code = v-alc-code
     2150                           .
     2151                       end.
     2152                   end.
     2153               end.
     2154           end.
     2155       end.
     2156       run refresh-query in this-procedure.
     2157       reposition br-goods to recid v-rid .
     2158   END.
     2159   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     2160   DO:
     2161       if select-list = "" then do :
     2162           message "Не выбрано ни одной строки" view-as alert-box .
     2163           return no-apply.
     2164       end.
     2165       if not valid-handle(bh-gds-egais)
     2166       then do :
     2167           message "Сначала получите ответ из ЕГАИС" view-as alert-box .
     2168           return no-apply.
     2169       end.
     2170       if valid-handle(bh-gds-egais)
     2171       then do :
     2172           bh-gds-egais:find-first () no-error.
     2173           if not bh-gds-egais:available
     2174           then do :
     2175               message "По данному производителю (ИНН) ответ из ЕГАИС не содержит позиций" view-as alert-box .
     2176               return no-apply.
     2177           end.
     2178       end.
     2179       _ii_ :
     2180       do ii = 1 to num-entries(select-list) :
     2181           def var v-i-element as character no-undo.
     2182           v-i-element = (entry(ii, select-list)).
     2183           for first tt-gds exclusive-lock where recid(tt-gds) = integer(v-i-element) and tt-gds.gds-code > 0 :
     2184               if tt-gds.alc-code <> "" and tt-gds.alc-code <> ? then do :
     2185                   bh-gds-egais:find-unique (substitute("where trim(tt-gds-EG.alc-code) = '&1'", trim(tt-gds.alc-code)), no-lock) no-error.
     2186               end.
     2187               else do :
     2188                   bh-gds-egais:find-unique (substitute("where trim(tt-gds-EG.gds-name) = '&1'", trim(tt-gds.gds-name)), no-lock) no-error.
     2189               end.
     2190               if bh-gds-egais:available and not bh-gds-egais:ambiguous and tt-gds.alc-code <> "" then do transaction :
     2191                   if tt-gds.alc-type-code <> bh-gds-egais:buffer-field("alc-type-code"):buffer-value then do :
     2192                       find first ub.alc-type no-lock
     2193                            where ub.alc-type.alc-type-code = trim(bh-gds-egais:buffer-field("alc-type-code"):buffer-value) no-error .
     2194                       if available ub.alc-type then do :
     2195                           find first ub.alc-type-gds
     2196                                where ub.alc-type-gds.gds-code = tt-gds.gds-code
     2197                                  and ub.alc-type-gds.create-user-db-num = 0 EXCLUSIVE-LOCK no-error.
     2198                           if not available ub.alc-type-gds then do :
     2199                               create ub.alc-type-gds.
     2200                           end.
     2201                           assign
     2202                               ub.alc-type-gds.gds-code            = tt-gds.gds-code
     2203                               ub.alc-type-gds.alc-type-inner-code = ub.alc-type.alc-type-inner-code
     2204                               ub.alc-type-gds.create-user-db-num  = 0
     2205                           .
     2206                       end.
     2207                   end.
     2208                   assign
     2209                       tt-gds.egais-name = bh-gds-egais:buffer-field("gds-name"):buffer-value
     2210                       tt-gds.imp-info   = bh-gds-egais:buffer-field("imp-info"):buffer-value
     2211                       tt-gds.prod-info   = bh-gds-egais:buffer-field("prod-info"):buffer-value
     2212                   .
     2213                   if tt-gds.old-gds-code = 0 or tt-gds.old-gds-code = ? then tt-gds.old-gds-code = tt-gds.gds-code .
     2214                   if tt-gds.old-alc-code = "" or tt-gds.old-alc-code = ? then tt-gds.old-alc-code = tt-gds.alc-code .
     2215                   for first buf_goods no-lock where buf_goods.gds-code = tt-gds.gds-code :
     2216                       run gen-key-rec IN THIS-PROCEDURE (  input 'goods':U
     2217                                                           ,input (buffer buf_goods:handle)
     2218                                                           ,output v-gds-uniq-key-rec).
     2219                       find first X_ext-classif exclusive-lock  where X_ext-classif.classif-subject = 'goods':U
     2220                                                                  and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2221                                                                  AND X_ext-classif.db-num = 0
     2222                                                                  and X_ext-classif.key#_one = tt-gds.old-gds-code
     2223                                                                  and X_ext-classif.key#_two = v-ext-sys
     2224                                                                  and X_ext-classif.key#_three = 0
     2225                                                                  and X_eXt-classif.charkey_one = tt-gds.old-alc-code
     2226                                                                  and X_eXt-classif.charkey_two = ""
     2227                                                                  and X_eXt-classif.charkey_three = ""
     2228                                                                  and X_eXt-classif.nonunique = 0
     2229                                                                  no-error.
     2230                       if available X_ext-classif then do :
     2231                           find first X_ext-classif-attr exclusive-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     2232                                                                          and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     2233                                                                          and X_ext-classif-attr.db-num = X_ext-classif.db-num
     2234                                                                          and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     2235                                                                          and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     2236                                                                          and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     2237                                                                          and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     2238                                                                          and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     2239                                                                          and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     2240                                                                          and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     2241                                                                          and X_ext-classif-attr.attr-code = 'egais-info'
     2242                                                                          no-error .
     2243                           if not available X_ext-classif-attr then do :
     2244                               create X_ext-classif-attr .
     2245                               assign
     2246                                   X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     2247                                   X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     2248                                   X_ext-classif-attr.db-num = X_ext-classif.db-num
     2249                                   X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     2250                                   X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     2251                                   X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     2252                                   X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     2253                                   X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     2254                                   X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     2255                                   X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     2256                                   X_ext-classif-attr.attr-code = 'egais-info'
     2257                               .
     2258                           end.
     2259                           else do :
     2260                               if tt-gds.imp-info = ? or tt-gds.imp-info = ""
     2261                               or tt-gds.imp-info = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
     2262                               or tt-gds.imp-info = chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
     2263                               then
     2264                               tt-gds.imp-info = entry(2, X_ext-classif-attr.attr-value, CHR(4)) no-error .
     2265                               if tt-gds.imp-info = ? or tt-gds.imp-info = ""
     2266                               then tt-gds.imp-info = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) .
     2267                               if num-entries(tt-gds.imp-info, CHR(5)) = 6
     2268                               then tt-gds.imp-info = tt-gds.imp-info + chr(5) + chr(5) .
     2269                               if num-entries(entry(2, X_ext-classif-attr.attr-value, CHR(4)), CHR(5)) > 6
     2270                               then entry7 = entry (7, entry(2, X_ext-classif-attr.attr-value, CHR(4)), chr(5)) no-error .
     2271                               else entry7 = "" .
     2272                               if entry (7, tt-gds.imp-info, chr(5)) = ? or entry (7, tt-gds.imp-info, chr(5)) = ""
     2273                               then entry (7, tt-gds.imp-info, chr(5)) = entry7 no-error.
     2274                               if num-entries(entry(1, X_ext-classif-attr.attr-value, CHR(4)), CHR(5)) > 6
     2275                               then entry7 = entry (7, entry(1, X_ext-classif-attr.attr-value, CHR(4)), chr(5)) no-error .
     2276                               else entry7 = "" .
     2277                               if entry (7, tt-gds.prod-info, chr(5)) = ? or entry (7, tt-gds.prod-info, chr(5)) = ""
     2278                               then entry (7, tt-gds.prod-info, chr(5)) = entry7 no-error.
     2279                               if num-entries(entry(1, X_ext-classif-attr.attr-value, CHR(4)), CHR(5)) > 6
     2280                               then entry8 = entry (8, entry(1, X_ext-classif-attr.attr-value, CHR(4)), chr(5)) no-error .
     2281                               else entry8 = "" .
     2282                               if entry (8, tt-gds.prod-info, chr(5)) = ? or entry (8, tt-gds.prod-info, chr(5)) = ""
     2283                               then entry (8, tt-gds.prod-info, chr(5)) = entry8 no-error.
     2284                           end.
     2285                           assign
     2286                               X_ext-classif.key#_one = tt-gds.gds-code
     2287                               X_ext-classif.charkey_one = tt-gds.alc-code
     2288                               X_ext-classif.uniq-key-rec = v-gds-uniq-key-rec
     2289                           no-error .
     2290                           if error-status:error then do :
     2291                               message "Уже есть связка, где код товара в TH " string(tt-gds.gds-code) " - алк. код " tt-gds.alc-code view-as alert-box .
     2292                               next _ii_ .
     2293                           end.
     2294                           assign
     2295                               X_ext-classif-attr.key#_one = tt-gds.gds-code
     2296                               X_ext-classif-attr.charkey_one = tt-gds.alc-code
     2297                           no-error.
     2298                           assign X_ext-classif-attr.attr-value = (tt-gds.prod-info + CHR(4) + tt-gds.imp-info + CHR(4) + tt-gds.egais-name) .
     2299                       end.
     2300                       else do :
     2301                           run ref/extclas1.p (
     2302                               INPUT 'ДОБАВЛЕНИЕ':U
     2303                               ,INPUT yes
     2304                               ,INPUT-OUTPUT v-rid
     2305                               ,INPUT 'goods':U
     2306                               ,INPUT 'exp-esys-gds-code':U
     2307                               ,input 0
     2308                               ,input buf_goods.gds-code
     2309                               ,input v-ext-sys
     2310                               ,input 0
     2311                               ,input tt-gds.alc-code
     2312                               ,input ""
     2313                               ,input ""
     2314                               ,input 0
     2315                               ,input v-gds-uniq-key-rec ) no-error.
     2316                           if error-status:error then
     2317                           do:
     2318                               if error-status:get-message(1) = "" and (return-value = '' or return-value = ?) then
     2319                                   message "Ошибка добавления записи в справочник!" skip
     2320                                           "Скорее всего, уже есть связка, где код товара в TH " string(tt-gds.gds-code) " - алк. код " tt-gds.alc-code  view-as alert-box .
     2321                               else
     2322                                   message return-value skip error-status:get-message(1) view-as alert-box .
     2323                               next _ii_ .
     2324                           end.
     2325                           find first X_ext-classif no-lock where recid(X_ext-classif) = v-rid.
     2326                           find first X_ext-classif-attr exclusive-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     2327                                                                          and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     2328                                                                          and X_ext-classif-attr.db-num = X_ext-classif.db-num
     2329                                                                          and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     2330                                                                          and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     2331                                                                          and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     2332                                                                          and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     2333                                                                          and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     2334                                                                          and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     2335                                                                          and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     2336                                                                          and X_ext-classif-attr.attr-code = 'egais-info'
     2337                                                                          no-error .
     2338                           if not available X_ext-classif-attr then do :
     2339                               create X_ext-classif-attr .
     2340                               assign
     2341                                   X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     2342                                   X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     2343                                   X_ext-classif-attr.db-num = X_ext-classif.db-num
     2344                                   X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     2345                                   X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     2346                                   X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     2347                                   X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     2348                                   X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     2349                                   X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     2350                                   X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     2351                                   X_ext-classif-attr.attr-code = 'egais-info'
     2352                               .
     2353                           end.
     2354                           else do :
     2355                               if tt-gds.imp-info = ? or tt-gds.imp-info = ""
     2356                               or tt-gds.imp-info = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
     2357                               or tt-gds.imp-info = chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
     2358                               then
     2359                               tt-gds.imp-info = entry(2, X_ext-classif-attr.attr-value, CHR(4)) no-error .
     2360                               if tt-gds.imp-info = ? or tt-gds.imp-info = ""
     2361                               then tt-gds.imp-info = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) .
     2362                               if num-entries(tt-gds.imp-info, CHR(5)) = 6
     2363                               then tt-gds.imp-info = tt-gds.imp-info + chr(5) + chr(5) .
     2364                               if num-entries(entry(2, X_ext-classif-attr.attr-value, CHR(4)), CHR(5)) > 6
     2365                               then entry7 = entry (7, entry(2, X_ext-classif-attr.attr-value, CHR(4)), chr(5)) no-error .
     2366                               else entry7 = "" .
     2367                               if entry (7, tt-gds.imp-info, chr(5)) = ? or entry (7, tt-gds.imp-info, chr(5)) = ""
     2368                               then entry (7, tt-gds.imp-info, chr(5)) = entry7 no-error.
     2369                               if num-entries(entry(1, X_ext-classif-attr.attr-value, CHR(4)), CHR(5)) > 6
     2370                               then entry7 = entry (7, entry(1, X_ext-classif-attr.attr-value, CHR(4)), chr(5)) no-error .
     2371                               else entry7 = "" .
     2372                               if entry (7, tt-gds.prod-info, chr(5)) = ? or entry (7, tt-gds.prod-info, chr(5)) = ""
     2373                               then entry (7, tt-gds.prod-info, chr(5)) = entry7 no-error.
     2374                               if num-entries(entry(1, X_ext-classif-attr.attr-value, CHR(4)), CHR(5)) > 6
     2375                               then entry8 = entry (8, entry(1, X_ext-classif-attr.attr-value, CHR(4)), chr(5)) no-error .
     2376                               else entry8 = "" .
     2377                               if entry (8, tt-gds.prod-info, chr(5)) = ? or entry (8, tt-gds.prod-info, chr(5)) = ""
     2378                               then entry (8, tt-gds.prod-info, chr(5)) = entry8 no-error.
     2379                           end.
     2380                           assign X_ext-classif-attr.attr-value = (tt-gds.prod-info + CHR(4) + tt-gds.imp-info + CHR(4) + tt-gds.egais-name) .
     2381                       end.
     2382                   end.
     2383                   find first old_tt-gds exclusive-lock where old_tt-gds.gds-code = tt-gds.gds-code
     2384                                                          and old_tt-gds.alc-code = tt-gds.alc-code
     2385                                                          and recid(old_tt-gds) <> recid(tt-gds) no-error.
     2386                   if available old_tt-gds then do :
     2387                       delete old_tt-gds .
     2388                   end.
     2389               end.
     2390           end.
     2391       end.
     2392       message "Сохранение завершено" view-as alert-box.
     2393       run refresh-query in this-procedure.
     2394   END.
     2395   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     2396   DO:
     2397       if available tt-gds and tt-gds.gds-code <> 0 and valid-handle(bh-gds-egais) then do :
     2398           if tt-gds.alc-code <> ? and tt-gds.alc-code <> "" then do :
     2399               bh-gds-egais:find-unique (substitute("where tt-gds-EG.alc-code = '&1'", tt-gds.alc-code), no-lock) no-error.
     2400           end.
     2401           else do :
     2402               bh-gds-egais:find-unique (substitute("where tt-gds-EG.gds-name = '&1'", tt-gds.gds-name), no-lock) no-error.
     2403           end.
     2404           if bh-gds-egais:ambiguous then do :
     2405               message "В ЕГАИС более одного товара с точно таким же наименованием. Сначала свяжите товар" view-as alert-box .
     2406               return no-apply .
     2407           end.
     2408           if bh-gds-egais:available then do :
     2409               run bge/egais-gds-diff.w (input rowid(tt-gds), input buffer tt-gds:handle, input bh-gds-egais:handle).
     2410           end.
     2411           else do :
     2412               message "Нет различий по данному товару" view-as alert-box.
     2413               return no-apply.
     2414           end.
     2415       end.
     2416   END.
     2417   ON CHOOSE OF b-load IN FRAME Dialog-Frame
     2418   DO:
     2419       if not available buf_clients then do :
     2420           message "Сначала выберите производителя" view-as alert-box.
     2421           return no-apply.
     2422       end.
     2423       egais:SendRequestUTM() .
     2424       glog = egais:IsSent .
     2425       if glog then enable b-answer WITH FRAME Dialog-Frame.
     2426       else disable b-answer WITH FRAME Dialog-Frame .
     2427       glog = egais:StatusErr .
     2428       if glog then do :
     2429           message egais:Msg view-as alert-box.
     2430           return no-apply.
     2431       end.
     2432       else do :
     2433           v-replyId = egais:ReplyId.
     2434       end.
     2435   END.
     2436   ON CHOOSE OF b-answer IN FRAME Dialog-Frame
     2437   DO:
     2438       bh-gds-egais = egais:GetHndlTable() .
     2439       glog = egais:StatusErr .
     2440       if glog then do :
     2441           message egais:Msg view-as alert-box.
     2442           return no-apply.
     2443       end.
     2444       if not valid-handle(bh-gds-egais) then do :
     2445           message "Ошибка при получении ответа от ЕГАИС" view-as alert-box error .
     2446           return no-apply .
     2447       end.
     2448       create query qh-gds-egais .
     2449       extGdsObj = new ExtGds(yes).
     2450       qh-gds-egais:set-buffers (bh-gds-egais) .
     2451       qh-gds-egais:query-prepare ("for each tt-gds-eg").
     2452       qh-gds-egais:query-open.
     2453       _repeat:
     2454       repeat:
     2455           qh-gds-egais:get-next ().
     2456           if qh-gds-egais:query-off-end then leave _repeat.
     2457           find first tt-gds no-lock where trim(tt-gds.gds-name) = trim(bh-gds-egais:buffer-field ("gds-name"):buffer-value) and not tt-gds.fromEgais no-error.
     2458           if not available tt-gds then do :
     2459               create tt-gds.
     2460               buffer tt-gds:handle:buffer-copy (bh-gds-egais) .
     2461               assign tt-gds.fromEgais = yes .
     2462               extGdsObj:OpenQueryExtGds(0, tt-gds.alc-code).
     2463               if extGdsObj:NumBundles = 1 then do :
     2464                   tt-gds.gds-code = extGdsObj:GetExtGdsValue(1):GdsCode no-error .
     2465               end.
     2466           end.
     2467       end.
     2468       run refresh-query in this-procedure.
     2469       delete object extGdsObj no-error .
     2470       apply "value-changed" to br-goods .
     2471       if valid-handle(bh-gds-egais)
     2472       then do :
     2473           bh-gds-egais:find-first () no-error.
     2474           if not bh-gds-egais:available
     2475           then do :
     2476               message "По данному производителю (ИНН) ответ из ЕГАИС не содержит позиций" view-as alert-box .
     2477               return no-apply.
     2478           end.
     2479       end.
     2480   END.
     2481   on row-display of br-goods IN FRAME Dialog-Frame
     2482   DO:
     2483       if tt-gds.gds-code = 0 then tt-gds.gds-code:bgcolor in browse br-goods = yellow_color .
     2484       if valid-handle(bh-gds-egais) then do :
     2485           if tt-gds.alc-code <> ? and tt-gds.alc-code <> "" then do :
     2486               bh-gds-egais:find-unique (substitute("where tt-gds-EG.alc-code = '&1'", tt-gds.alc-code), no-lock) no-error.
     2487           end.
     2488           else do :
     2489               bh-gds-egais:find-unique (substitute("where tt-gds-EG.gds-name = '&1'", tt-gds.gds-name), no-lock) no-error.
     2490           end.
     2491           if bh-gds-egais:available and not bh-gds-egais:ambiguous and not tt-gds.fromEgais then do :
     2492               if bh-gds-egais:buffer-field ("gds-name"):buffer-value <> tt-gds.gds-name then tt-gds.gds-name:bgcolor in browse br-goods = red_color .
     2493               if bh-gds-egais:buffer-field ("ms-base"):buffer-value <> tt-gds.ms-base then tt-gds.ms-base:bgcolor in browse br-goods = red_color .
     2494               if bh-gds-egais:buffer-field ("proof"):buffer-value <> tt-gds.proof then tt-gds.proof:bgcolor in browse br-goods = red_color .
     2495               if bh-gds-egais:buffer-field ("alc-code"):buffer-value <> tt-gds.alc-code then tt-gds.alc-code:bgcolor in browse br-goods = red_color .
     2496               if bh-gds-egais:buffer-field ("alc-type-code"):buffer-value <> tt-gds.alc-type-code then tt-gds.alc-type-code:bgcolor in browse br-goods = red_color .
     2497           end.
     2498       end.
     2499   end.
     2500   on value-changed of br-goods IN FRAME Dialog-Frame
     2501   DO:
     2502       if available tt-gds then do :
     2503           if tt-gds.gds-code = ? or tt-gds.gds-code = 0 then do :
     2504               disable b-good with frame Dialog-Frame .
     2505               if tt-gds.fromEgais then enable b-connect rs-mode with frame Dialog-Frame .
     2506               else disable b-connect rs-mode with frame Dialog-Frame .
     2507           end.
     2508           else do :
     2509               enable b-good with frame Dialog-Frame .
     2510               if valid-handle(bh-gds-egais) then enable b-connect rs-mode with frame Dialog-Frame .
     2511               else disable b-connect rs-mode with frame Dialog-Frame .
     2512           end.
     2513       end.
     2514   end.
     2515   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2516   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2517   MAIN-BLOCK:
     2518   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2519      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2520   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2521   do:
     2522     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2523       (input  v-cntxt-db-num
     2524       ,input  v-cntxt-userid
     2525       ,input  0
     2526       ,input  'actn_egais-ref':U
     2527       ,input  'object':U
     2528       ,input  v-cntxt-host-code-obj
     2529       ,input  v-cntxt-obj-type
     2530       ,input  v-cntxt-obj-code
     2531       ,input  0
     2532       ,input  0
     2533       ,input  0
     2534       ,input  true
     2535       ,output glog
     2536       )  .
     2537   end.
     2538     if not glog then  return .
     2539     assign
     2540         rs-sort = 1
     2541         rs-mode = 1
     2542     .
     2543     find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = v-cntxt-host-code-obj.
     2544     find first buf_firm no-lock where buf_firm.firm-code = v-cntxt-host-code-obj.
     2545     if valid-handle(bh-gds-egais) then do :
     2546         delete object bh-gds-egais .
     2547     end.
     2548     if valid-handle(qh-gds-egais) then do :
     2549         delete object qh-gds-egais .
     2550     end.
     2551     empty temp-table thbjattr_thbj-attr .
     2552     run adm/shattri.p (
     2553          input "get":U
     2554         ,input v-cntxt-obj-type
     2555         ,input v-cntxt-obj-code
     2556         ,input 'egais':U
     2557         ,input 'egais-fsrar':U
     2558         ,output v-value-character
     2559         ,output v-value-date
     2560         ,output v-value-decimal
     2561         ,output v-value-integer
     2562         ,output v-value-logical
     2563         ,output v-value-type
     2564         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2565         ) no-error .
     2566     assign
     2567       v-org = buf_clients.obj-name
     2568       v-fs-rar = v-value-character
     2569       v-org-inn = buf_firm.inn
     2570     .
     2571     egais = new EGAIS(v-cntxt-db-num, v-cntxt-userid).
     2572     run adm/shattri.p (
     2573          input "get":U
     2574         ,input '':U
     2575         ,input 0
     2576         ,input 'egais':U
     2577         ,input 'egais-exsys':U
     2578         ,output v-value-character
     2579         ,output v-value-date
     2580         ,output v-value-decimal
     2581         ,output v-value-integer
     2582         ,output v-value-logical
     2583         ,output v-value-type
     2584         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2585         ) no-error .
     2586     assign v-ext-sys = v-value-integer .
     2587     release buf_clients .
     2588   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2589   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2590   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2591   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2592   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2593   define variable v-diasize-current-frame-height as decimal   no-undo .
     2594   define variable v-diasize-change-size          as logical   no-undo .
     2595   define variable v-diasize-resize-button        as handle    no-undo .
     2596   define variable v-diasize-wndmax               as logical   no-undo .
     2597   define variable v-diasize-wndstore             as logical   no-undo .
     2598   define variable v-diasize-proc-name            as character no-undo .
     2599   define variable v-diasize-browse-handle        as handle    no-undo .
     2600   define variable v-diasize-browse-number        as integer   no-undo .
     2601   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2602   define temp-table temp-diasize-handle no-undo
     2603     field handle-value  as handle
     2604     field save-position as decimal
     2605     index xpk is primary unique handle-value
     2606     .
     2607   define temp-table temp-browse-handle no-undo
     2608     field browse-type   as character
     2609     field browse-number as integer
     2610     field browse-handle as handle
     2611     field original-size as decimal
     2612     index xpk is primary unique browse-type browse-number
     2613     index xie browse-type browse-handle
     2614   .
     2615   procedure diasize_change-height :
     2616     define input  parameter p-change-value  as decimal   no-undo .
     2617     define input  parameter p-move-resize   as logical   no-undo .
     2618     define variable v-field-group-handle    as handle    no-undo .
     2619     define variable v-object-handle         as handle    no-undo .
     2620     define variable v-frame-height          as decimal   no-undo .
     2621     define variable v-frame-virtual-height  as decimal   no-undo .
     2622     define variable v-browse-height         as decimal   no-undo .
     2623     define variable v-window-height         as decimal   no-undo .
     2624     define variable v-window-virtual-height as decimal   no-undo .
     2625     define variable v-change-sign           as integer   no-undo .
     2626     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2627     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2628     if p-change-value > 0
     2629     then do:
     2630       if frame Dialog-Frame :height + p-change-value
     2631           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2632       then do:
     2633         assign
     2634           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2635                           - (frame Dialog-Frame :height-chars)
     2636         .
     2637         if p-change-value <= 0
     2638         then do:
     2639           run diasize_position-resize-button in this-procedure .
     2640           return .
     2641         end.
     2642       end.
     2643     end.
     2644     if p-change-value < 0
     2645     then do:
     2646       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2647       then do:
     2648         assign
     2649           p-change-value = v-diasize-orig-frame-height
     2650                          - (frame Dialog-Frame :height-chars)
     2651         .
     2652         if p-change-value >= 0
     2653         then do:
     2654           run diasize_position-resize-button in this-procedure .
     2655           return .
     2656         end.
     2657       end.
     2658     end.
     2659     if p-change-value >= 0
     2660     then do:
     2661       assign
     2662         v-change-sign = 1
     2663       .
     2664     end.
     2665     else do:
     2666       assign
     2667         v-change-sign = -1
     2668       .
     2669     end.
     2670     assign
     2671       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2672     .
     2673     if p-change-value = 0
     2674     then do:
     2675       run diasize_position-resize-button in this-procedure .
     2676       return .
     2677     end.
     2678     move_block:
     2679     do
     2680     on error undo move_block, retry move_block
     2681     :
     2682       if retry
     2683       then do:
     2684         do
     2685         on error undo move_block, leave move_block
     2686         :
     2687           if p-change-value > 0
     2688           then do:
     2689             for each buf_temp-diasize-handle
     2690             on error undo, next
     2691             :
     2692               assign
     2693                 v-object-handle = buf_temp-diasize-handle.handle-value
     2694               .
     2695               if v-object-handle <> v-diasize-resize-button
     2696               then do:
     2697                 assign
     2698                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2699                 .
     2700               end.
     2701             end.
     2702             assign
     2703               v-diasize-browse-handle :height = v-browse-height
     2704             .
     2705             for each buf_temp-browse-handle
     2706               where buf_temp-browse-handle.browse-type = 'height':u
     2707             on error undo, next
     2708             :
     2709               assign
     2710                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2711               .
     2712             end.
     2713             assign
     2714               frame Dialog-Frame :height = v-frame-height
     2715             .
     2716             if frame Dialog-Frame :scrollable = true
     2717             then do:
     2718               assign
     2719                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2720               .
     2721             end.
     2722             run diasize_position-resize-button in this-procedure .
     2723           end.
     2724           else do:
     2725             if frame Dialog-Frame :scrollable = true
     2726             then do:
     2727               assign
     2728                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2729               .
     2730             end.
     2731             assign
     2732               frame Dialog-Frame :height = v-frame-height
     2733             .
     2734             assign
     2735               v-diasize-browse-handle :height = v-browse-height
     2736             .
     2737             for each buf_temp-browse-handle
     2738               where buf_temp-browse-handle.browse-type = 'height':u
     2739             on error undo, next
     2740             :
     2741               assign
     2742                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2743               .
     2744             end.
     2745             for each buf_temp-diasize-handle
     2746             on error undo, next
     2747             :
     2748               assign
     2749                 v-object-handle = buf_temp-diasize-handle.handle-value
     2750               .
     2751               if v-object-handle <> v-diasize-resize-button
     2752               then do:
     2753                 assign
     2754                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2755                 .
     2756               end.
     2757             end.
     2758             run diasize_position-resize-button in this-procedure .
     2759           end.
     2760           assign
     2761             v-diasize-change-size = false
     2762           .
     2763           leave move_block .
     2764         end.
     2765       end.
     2766       assign
     2767         v-diasize-need-full-display = true
     2768       .
     2769       if v-diasize-change-size = false
     2770       then do:
     2771         assign
     2772           v-diasize-change-size = true
     2773         .
     2774       end.
     2775       else do:
     2776         return .
     2777       end.
     2778       assign
     2779         v-frame-height = frame Dialog-Frame :height
     2780         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2781         v-browse-height = v-diasize-browse-handle :height
     2782       .
     2783       for each buf_temp-browse-handle
     2784         where buf_temp-browse-handle.browse-type = 'height':u
     2785       :
     2786         assign
     2787           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2788         .
     2789       end.
     2790       for each buf_temp-diasize-handle
     2791       :
     2792         delete buf_temp-diasize-handle .
     2793       end.
     2794       assign
     2795         v-field-group-handle = frame Dialog-Frame :first-child
     2796       .
     2797       do while valid-handle(v-field-group-handle)
     2798       :
     2799         assign
     2800           v-object-handle = v-field-group-handle :first-child
     2801         .
     2802         do while valid-handle(v-object-handle)
     2803         :
     2804           if  v-object-handle <> v-diasize-browse-handle :handle
     2805           and can-query(v-object-handle, "row")
     2806           and can-query(v-object-handle, "height")
     2807           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2808           then do:
     2809             find first buf_temp-browse-handle
     2810               where buf_temp-browse-handle.browse-type   = 'height':u
     2811                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2812               no-error .
     2813             if available buf_temp-browse-handle
     2814             then do:
     2815             end.
     2816             else do:
     2817               create buf_temp-diasize-handle .
     2818               assign
     2819                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2820                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2821               .
     2822             end.
     2823           end.
     2824           assign
     2825             v-object-handle = v-object-handle :next-sibling
     2826           .
     2827         end.
     2828         assign
     2829           v-field-group-handle = v-field-group-handle :next-sibling
     2830         .
     2831       end.
     2832       do with frame Dialog-Frame
     2833       :
     2834         hide v-diasize-resize-button .
     2835         assign
     2836           v-diasize-resize-button :row    = 1
     2837           v-diasize-resize-button :column = 1
     2838         .
     2839       end.
     2840       if p-change-value > 0
     2841       then do:
     2842         if frame Dialog-Frame :scrollable = true
     2843         then do:
     2844           assign
     2845             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2846             no-error .
     2847           if error-status :error
     2848           or error-status :get-message(1) <> ""
     2849           then do:
     2850             undo move_block, retry move_block .
     2851           end.
     2852         end.
     2853         assign
     2854           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2855           no-error .
     2856         if error-status :error
     2857         or error-status :get-message(1) <> ""
     2858         then do:
     2859           undo move_block, retry move_block .
     2860         end.
     2861         assign
     2862           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2863           no-error .
     2864         if error-status :error
     2865         or error-status :get-message(1) <> ""
     2866         then do:
     2867           undo move_block, retry move_block .
     2868         end.
     2869         for each buf_temp-browse-handle
     2870           where buf_temp-browse-handle.browse-type = 'height':u
     2871         on error undo move_block, retry move_block
     2872         :
     2873           assign
     2874             buf_temp-browse-handle.browse-handle :height
     2875               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2876             no-error .
     2877           if error-status :error
     2878           or error-status :get-message(1) <> ""
     2879           then do:
     2880             undo move_block, retry move_block .
     2881           end.
     2882         end.
     2883         for each buf_temp-diasize-handle
     2884         on error undo move_block, retry move_block
     2885         :
     2886           assign
     2887             v-object-handle = buf_temp-diasize-handle.handle-value
     2888           .
     2889           if v-object-handle <> v-diasize-resize-button
     2890           then do:
     2891             assign
     2892               v-object-handle :row = v-object-handle :row + p-change-value
     2893               no-error .
     2894             if error-status :error
     2895             or error-status :get-message(1) <> ""
     2896             then do:
     2897               undo move_block, retry move_block .
     2898             end.
     2899           end.
     2900         end.
     2901       end.
     2902       else do:
     2903         for each buf_temp-diasize-handle
     2904         on error undo move_block, retry move_block
     2905         :
     2906           assign
     2907             v-object-handle = buf_temp-diasize-handle.handle-value
     2908           .
     2909           if v-object-handle <> v-diasize-resize-button
     2910           then do:
     2911             assign
     2912               v-object-handle :row = v-object-handle :row + p-change-value
     2913               no-error .
     2914             if error-status :error
     2915             or error-status :get-message(1) <> ""
     2916             then do:
     2917               undo move_block, retry move_block .
     2918             end.
     2919           end.
     2920         end.
     2921         assign
     2922           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2923           no-error .
     2924         if error-status :error
     2925         or error-status :get-message(1) <> ""
     2926         then do:
     2927           undo move_block, retry move_block .
     2928         end.
     2929         for each buf_temp-browse-handle
     2930           where buf_temp-browse-handle.browse-type = 'height':u
     2931         on error undo move_block, retry move_block
     2932         :
     2933           assign
     2934             buf_temp-browse-handle.browse-handle :height
     2935               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2936             no-error .
     2937           if error-status :error
     2938           or error-status :get-message(1) <> ""
     2939           then do:
     2940             undo move_block, retry move_block .
     2941           end.
     2942         end.
     2943         assign
     2944           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2945           no-error .
     2946         if error-status :error
     2947         or error-status :get-message(1) <> ""
     2948         then do:
     2949           undo move_block, retry move_block .
     2950         end.
     2951         if frame Dialog-Frame :scrollable = true
     2952         then do:
     2953           assign
     2954             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2955             no-error .
     2956           if error-status :error
     2957           or error-status :get-message(1) <> ""
     2958           then do:
     2959             undo move_block, retry move_block .
     2960           end.
     2961         end.
     2962       end.
     2963       if p-move-resize = true
     2964       then do:
     2965         run diasize_position-resize-button in this-procedure .
     2966       end.
     2967       if v-diasize-wndstore = true
     2968       then do:
     2969         if connected("ub") = true
     2970         then do:
     2971           define variable v-cntxt-db-num        as integer   no-undo .
     2972           define variable v-cntxt-userid        as character no-undo .
     2973           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2974                                             , OUTPUT v-cntxt-userid
     2975                                             ) .
     2976           run gbl/wndsizew.p
     2977             (input  v-cntxt-db-num
     2978             ,input  v-cntxt-userid
     2979             ,input  v-diasize-proc-name
     2980             ,input  'height':u
     2981             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2982             ) .
     2983         end.
     2984       end.
     2985     end.
     2986     assign
     2987       v-diasize-change-size = false
     2988     .
     2989   end procedure.
     2990   procedure diasize_set-height :
     2991     define input  parameter p-new-height  as decimal   no-undo .
     2992     define input  parameter p-move-resize as logical   no-undo .
     2993     do
     2994     on error undo, return error return-value
     2995     :
     2996       run diasize_change-height in this-procedure
     2997         (input  (p-new-height - frame Dialog-Frame :height)
     2998         ,input  p-move-resize
     2999         ) .
     3000     end.
     3001   end procedure.
     3002   procedure diasize_change-width :
     3003     define input  parameter p-change-value as decimal   no-undo .
     3004     define input  parameter p-move-resize  as logical   no-undo .
     3005     define variable v-field-group-handle   as handle    no-undo .
     3006     define variable v-object-handle        as handle    no-undo .
     3007     define variable v-frame-width          as decimal   no-undo .
     3008     define variable v-frame-virtual-width  as decimal   no-undo .
     3009     define variable v-browse-width         as decimal   no-undo .
     3010     define variable v-window-width         as decimal   no-undo .
     3011     define variable v-window-virtual-width as decimal   no-undo .
     3012     define variable v-change-sign          as integer   no-undo .
     3013     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3014     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3015     if p-change-value > 0
     3016     then do:
     3017       if frame Dialog-Frame :width + p-change-value >
     3018           session :width-chars
     3019       then do:
     3020         assign
     3021           p-change-value = session :width-chars - frame Dialog-Frame :width
     3022         .
     3023         if p-change-value <= 0
     3024         then do:
     3025           run diasize_position-resize-button in this-procedure .
     3026           return .
     3027         end.
     3028       end.
     3029     end.
     3030     if p-change-value < 0
     3031     then do:
     3032       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3033       then do:
     3034         assign
     3035           p-change-value = v-diasize-orig-frame-width
     3036                          - frame Dialog-Frame :width
     3037         .
     3038         if p-change-value >= 0
     3039         then do:
     3040           run diasize_position-resize-button in this-procedure .
     3041           return .
     3042         end.
     3043       end.
     3044     end.
     3045     if p-change-value >= 0
     3046     then do:
     3047       assign
     3048         v-change-sign = 1
     3049       .
     3050     end.
     3051     else do:
     3052       assign
     3053         v-change-sign = -1
     3054       .
     3055     end.
     3056     assign
     3057       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3058     .
     3059     if p-change-value = 0
     3060     then do:
     3061       run diasize_position-resize-button in this-procedure .
     3062       return .
     3063     end.
     3064     move_block:
     3065     do
     3066     on error undo move_block, leave move_block
     3067     :
     3068       if retry
     3069       then do:
     3070         do
     3071         on error undo move_block, leave move_block
     3072         :
     3073           if p-change-value > 0
     3074           then do:
     3075             for each buf_temp-diasize-handle
     3076             on error undo, next
     3077             :
     3078               assign
     3079                 v-object-handle = buf_temp-diasize-handle.handle-value
     3080               .
     3081               if v-object-handle <> v-diasize-resize-button
     3082               then do:
     3083                 assign
     3084                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3085                 .
     3086               end.
     3087             end.
     3088             assign
     3089               v-diasize-browse-handle :width = v-browse-width
     3090             .
     3091             for each buf_temp-browse-handle
     3092               where buf_temp-browse-handle.browse-type = 'width':u
     3093             on error undo, next
     3094             :
     3095               assign
     3096                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3097               .
     3098             end.
     3099             assign
     3100               frame Dialog-Frame :width = v-frame-width
     3101             .
     3102             if frame Dialog-Frame :scrollable = true
     3103             then do:
     3104               assign
     3105                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3106               .
     3107             end.
     3108             run diasize_position-resize-button in this-procedure .
     3109           end.
     3110           else do:
     3111             if frame Dialog-Frame :scrollable = true
     3112             then do:
     3113               assign
     3114                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3115               .
     3116             end.
     3117             assign
     3118               frame Dialog-Frame :width = v-frame-width
     3119             .
     3120             for each buf_temp-browse-handle
     3121               where buf_temp-browse-handle.browse-type = 'width':u
     3122             on error undo, next
     3123             :
     3124               assign
     3125                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3126               .
     3127             end.
     3128             assign
     3129               v-diasize-browse-handle :width = v-browse-width
     3130             .
     3131             for each buf_temp-diasize-handle
     3132             on error undo, next
     3133             :
     3134               assign
     3135                 v-object-handle = buf_temp-diasize-handle.handle-value
     3136               .
     3137               if v-object-handle <> v-diasize-resize-button
     3138               then do:
     3139                 assign
     3140                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3141                 .
     3142               end.
     3143             end.
     3144             run diasize_position-resize-button in this-procedure .
     3145           end.
     3146           assign
     3147             v-diasize-change-size = false
     3148           .
     3149           leave move_block .
     3150         end.
     3151       end.
     3152       assign
     3153         v-diasize-need-full-display = true
     3154       .
     3155       if v-diasize-change-size = false
     3156       then do:
     3157         assign
     3158           v-diasize-change-size = true
     3159         .
     3160       end.
     3161       else do:
     3162         return .
     3163       end.
     3164       assign
     3165         v-frame-width = frame Dialog-Frame :width
     3166         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3167         v-browse-width = v-diasize-browse-handle :width
     3168       .
     3169       for each buf_temp-browse-handle
     3170         where buf_temp-browse-handle.browse-type = 'width':u
     3171       :
     3172         assign
     3173           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3174         .
     3175       end.
     3176       for each buf_temp-diasize-handle
     3177       :
     3178         delete buf_temp-diasize-handle .
     3179       end.
     3180       assign
     3181         v-field-group-handle = frame Dialog-Frame :first-child
     3182       .
     3183       do while valid-handle(v-field-group-handle)
     3184       :
     3185         assign
     3186           v-object-handle = v-field-group-handle :first-child
     3187         .
     3188         do while valid-handle(v-object-handle)
     3189         :
     3190           if  v-object-handle <> v-diasize-browse-handle :handle
     3191           and v-object-handle <> v-diasize-resize-button
     3192           and can-query(v-object-handle, "row")
     3193           and can-query(v-object-handle, "height")
     3194           and ( v-object-handle :col + v-object-handle :width
     3195                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3196               )
     3197           then do:
     3198             find first buf_temp-browse-handle
     3199               where buf_temp-browse-handle.browse-type   = 'width':u
     3200                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3201               no-error .
     3202             if available buf_temp-browse-handle
     3203             then do:
     3204             end.
     3205             else do:
     3206               create buf_temp-diasize-handle .
     3207               assign
     3208                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3209                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3210               .
     3211             end.
     3212           end.
     3213           assign
     3214             v-object-handle = v-object-handle :next-sibling
     3215           .
     3216         end.
     3217         assign
     3218           v-field-group-handle = v-field-group-handle :next-sibling
     3219         .
     3220       end.
     3221       do with frame Dialog-Frame
     3222       :
     3223         hide v-diasize-resize-button .
     3224         v-diasize-resize-button :row = 1.
     3225         v-diasize-resize-button :column = 1.
     3226       end.
     3227       if p-change-value > 0
     3228       then do:
     3229         if frame Dialog-Frame :scrollable = true
     3230         then do:
     3231           assign
     3232             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3233             no-error .
     3234           if error-status :error
     3235           or error-status :get-message(1) <> ""
     3236           then do:
     3237             undo move_block, retry move_block.
     3238           end.
     3239         end.
     3240         assign
     3241           frame Dialog-Frame :width = v-frame-width + p-change-value
     3242           no-error .
     3243         if error-status :error
     3244         or error-status :get-message(1) <> ""
     3245         then do:
     3246           undo move_block, retry move_block.
     3247         end.
     3248         assign
     3249           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3250         no-error .
     3251         if error-status :error
     3252         or error-status :get-message(1) <> ""
     3253         then do:
     3254           undo move_block, retry move_block.
     3255         end.
     3256         for each buf_temp-browse-handle
     3257           where buf_temp-browse-handle.browse-type = 'width':u
     3258         on error undo move_block, retry move_block
     3259         :
     3260           assign
     3261             buf_temp-browse-handle.browse-handle :width
     3262               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3263             no-error .
     3264           if error-status :error
     3265           or error-status :get-message(1) <> ""
     3266           then do:
     3267             undo move_block, retry move_block .
     3268           end.
     3269         end.
     3270         for each buf_temp-diasize-handle
     3271         on error undo move_block, retry move_block
     3272         :
     3273           assign
     3274             v-object-handle = buf_temp-diasize-handle.handle-value
     3275           .
     3276           if v-object-handle <> v-diasize-resize-button
     3277           then do:
     3278             assign
     3279               v-object-handle :col = v-object-handle :col + p-change-value
     3280               no-error .
     3281             if error-status :error
     3282             or error-status :get-message(1) <> ""
     3283             then do:
     3284               undo move_block, retry move_block .
     3285             end.
     3286           end.
     3287         end.
     3288       end.
     3289       else do:
     3290         for each buf_temp-diasize-handle
     3291         on error undo move_block, retry move_block
     3292         :
     3293           assign
     3294             v-object-handle = buf_temp-diasize-handle.handle-value
     3295           .
     3296           if v-object-handle <> v-diasize-resize-button
     3297           then do:
     3298             assign
     3299               v-object-handle :col = v-object-handle :col + p-change-value
     3300               no-error .
     3301             if error-status :error
     3302             or error-status :get-message(1) <> ""
     3303             then do:
     3304               undo move_block, retry move_block .
     3305             end.
     3306           end.
     3307         end.
     3308         for each buf_temp-browse-handle
     3309           where buf_temp-browse-handle.browse-type = 'width':u
     3310         on error undo move_block, retry move_block
     3311         :
     3312           assign
     3313             buf_temp-browse-handle.browse-handle :width
     3314               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3315             no-error .
     3316           if error-status :error
     3317           or error-status :get-message(1) <> ""
     3318           then do:
     3319             undo move_block, retry move_block .
     3320           end.
     3321         end.
     3322         assign
     3323           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3324           no-error .
     3325         if error-status :error
     3326         or error-status :get-message(1) <> ""
     3327         then do:
     3328           undo move_block, retry move_block.
     3329         end.
     3330         assign
     3331           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3332         no-error .
     3333         if error-status :error
     3334         or error-status :get-message(1) <> ""
     3335         then do:
     3336           undo move_block, retry move_block.
     3337         end.
     3338         if frame Dialog-Frame :scrollable = true
     3339         then do:
     3340           assign
     3341             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3342           no-error .
     3343           if error-status :error
     3344           or error-status :get-message(1) <> ""
     3345           then do:
     3346             undo move_block, retry move_block.
     3347           end.
     3348         end.
     3349       end.
     3350       if p-move-resize
     3351       then do:
     3352         run diasize_position-resize-button in this-procedure .
     3353       end.
     3354       if v-diasize-wndstore = true
     3355       then do:
     3356         if connected("ub") = true
     3357         then do:
     3358           define variable v-cntxt-db-num        as integer   no-undo .
     3359           define variable v-cntxt-userid        as character no-undo .
     3360           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3361                                             , OUTPUT v-cntxt-userid
     3362                                             ) .
     3363           run gbl/wndsizew.p
     3364             (input  v-cntxt-db-num
     3365             ,input  v-cntxt-userid
     3366             ,input  v-diasize-proc-name
     3367             ,input  'width':u
     3368             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3369             ) .
     3370         end.
     3371       end.
     3372     end.
     3373     assign
     3374       v-diasize-change-size = false
     3375     .
     3376   end procedure.
     3377   procedure diasize_set-width :
     3378     define input  parameter p-new-width  as decimal   no-undo .
     3379     define input  parameter p-move-resize as logical   no-undo .
     3380     do
     3381     on error undo, return error return-value
     3382     :
     3383       run diasize_change-width in this-procedure
     3384         (input  (p-new-width - frame Dialog-Frame :width)
     3385         ,input  p-move-resize
     3386         ) .
     3387     end.
     3388   end procedure.
     3389   procedure diasize_position-resize-button :
     3390     do with frame Dialog-Frame
     3391     :
     3392       hide v-diasize-resize-button .
     3393       assign
     3394         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3395                     - 1
     3396                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3397         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3398                     - 1
     3399                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3400       .
     3401       view v-diasize-resize-button .
     3402     end.
     3403   end procedure.
     3404   on alt-right anywhere
     3405   do:
     3406     run diasize_change-width in this-procedure
     3407       (input 1
     3408       ,input true
     3409       ) .
     3410     return no-apply .
     3411   end.
     3412   on alt-left anywhere
     3413   do:
     3414     run diasize_change-width in this-procedure
     3415       (input -1
     3416       ,input true
     3417       ) .
     3418     return no-apply .
     3419   end.
     3420   on alt-down anywhere
     3421   do:
     3422     run diasize_change-height in this-procedure
     3423       (input 1
     3424       ,input true
     3425       ) .
     3426     return no-apply .
     3427   end.
     3428   on alt-up anywhere
     3429   do:
     3430     run diasize_change-height in this-procedure
     3431       (input -1
     3432       ,input true
     3433       ) .
     3434     return no-apply .
     3435   end.
     3436   on alt-enter of frame Dialog-Frame
     3437   do:
     3438     run diasize_maximize in this-procedure
     3439       (input  ?
     3440       ).
     3441     return no-apply .
     3442   end.
     3443   procedure diasize_end-move :
     3444     do
     3445     on error undo, return error return-value
     3446     :
     3447       define variable v-row-delta as decimal   no-undo .
     3448       define variable v-col-delta as decimal   no-undo .
     3449       define variable v-new-row as decimal   no-undo .
     3450       define variable v-new-col as decimal   no-undo .
     3451       assign
     3452         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3453         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3454       .
     3455       assign
     3456         v-row-delta = v-new-row - frame Dialog-Frame :height
     3457         v-col-delta = v-new-col - frame Dialog-Frame :width
     3458       .
     3459       run diasize_change-height in this-procedure
     3460         (input v-row-delta
     3461         ,input true
     3462         ) .
     3463       run diasize_change-width in this-procedure
     3464         (input v-col-delta
     3465         ,input true
     3466         ) .
     3467     end.
     3468   end procedure.
     3469   procedure diasize_maximize :
     3470     define input  parameter p-action as logical   no-undo .
     3471     do
     3472     on error undo, return error return-value
     3473     :
     3474       if p-action = ?
     3475       then do:
     3476         if v-diasize-need-maximize = true
     3477         then do:
     3478           assign
     3479             p-action = true
     3480           .
     3481         end.
     3482         else do:
     3483           assign
     3484             p-action = false
     3485           .
     3486         end.
     3487       end.
     3488       if p-action = true
     3489       then do:
     3490         run diasize_change-height in this-procedure
     3491           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3492               - frame Dialog-Frame :height-chars
     3493           ,input true
     3494           ) .
     3495         run diasize_change-width in this-procedure
     3496           (input session :width-chars
     3497               - frame Dialog-Frame :width-chars
     3498           ,input true
     3499           ) .
     3500         assign
     3501           v-diasize-need-maximize = false
     3502         .
     3503       end.
     3504       else do:
     3505         run diasize_change-width in this-procedure
     3506           (input v-diasize-orig-frame-width
     3507               - frame Dialog-Frame :width-chars
     3508           ,input true
     3509           ) .
     3510         run diasize_change-height in this-procedure
     3511           (input v-diasize-orig-frame-height
     3512               - frame Dialog-Frame :height-chars
     3513           ,input true
     3514           ) .
     3515         assign
     3516           v-diasize-need-maximize = true
     3517         .
     3518       end.
     3519     end.
     3520   end procedure.
     3521   procedure diasize_restore-orig-size :
     3522     do
     3523     on error undo, return error return-value
     3524     :
     3525       assign
     3526         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3527         v-diasize-current-frame-height = frame Dialog-Frame :height
     3528       .
     3529       run diasize_set-height in this-procedure
     3530         (input  v-diasize-orig-frame-height
     3531         ,input  true
     3532         ) .
     3533       run diasize_set-width in this-procedure
     3534         (input  v-diasize-orig-frame-width
     3535         ,input  true
     3536         ) .
     3537     end.
     3538   end procedure.
     3539   procedure diasize_restore-current-size :
     3540     do
     3541     on error undo, return error return-value
     3542     :
     3543       run diasize_set-height in this-procedure
     3544         (input  v-diasize-current-frame-height
     3545         ,input  true
     3546         ) .
     3547       run diasize_set-width in this-procedure
     3548         (input  v-diasize-current-frame-width
     3549         ,input  true
     3550         ) .
     3551     end.
     3552   end procedure.
     3553   procedure diasize_set-browse-handle :
     3554     define input  parameter p-browse-handle as handle   no-undo .
     3555     define buffer buf_temp-browse-handle for temp-browse-handle .
     3556     do
     3557     on error undo, return error return-value
     3558     :
     3559       assign
     3560         v-diasize-browse-handle = p-browse-handle
     3561       .
     3562       for each buf_temp-browse-handle
     3563       on error undo, return error return-value
     3564       :
     3565         delete buf_temp-browse-handle .
     3566       end.
     3567     end.
     3568   end procedure.
     3569   procedure diasize_add_browse :
     3570     define input  parameter p-browse-type   as character no-undo .
     3571     define input  parameter p-browse-handle as handle    no-undo .
     3572     define buffer buf_temp-browse-handle for temp-browse-handle .
     3573     do
     3574     on error undo, return error return-value
     3575     :
     3576       assign
     3577         v-diasize-browse-number = v-diasize-browse-number + 1
     3578       .
     3579       create buf_temp-browse-handle .
     3580       assign
     3581         buf_temp-browse-handle.browse-type   = p-browse-type
     3582         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3583         buf_temp-browse-handle.browse-handle = p-browse-handle
     3584       .
     3585     end.
     3586   end procedure.
     3587   procedure diasize_init :
     3588     define variable v-default-value    as logical   no-undo .
     3589     define variable v-restore-saved    as logical   no-undo .
     3590     define variable v-resize-value-str as character no-undo .
     3591     do
     3592     on error undo, return error return-value
     3593     :
     3594       do with frame Dialog-Frame
     3595       :
     3596         assign
     3597           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3598           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3599           v-diasize-browse-handle     = browse br-goods :handle
     3600         .
     3601         create button v-diasize-resize-button
     3602         assign
     3603           parent        = frame Dialog-Frame :first-child
     3604           label         = "s"
     3605           height-pixels = 16
     3606           width-pixels  = 16
     3607           visible       = true
     3608           sensitive     = true
     3609           movable       = true
     3610           triggers:
     3611             on end-move persistent run diasize_end-move in this-procedure .
     3612           end triggers.
     3613         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3614         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3615         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3616         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3617         assign
     3618           v-diasize-wndmax = false
     3619         .
     3620         if connected("ub") = true
     3621         then do:
     3622           define variable v-cntxt-db-num        as integer   no-undo .
     3623           define variable v-cntxt-userid        as character no-undo .
     3624           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3625                                             , OUTPUT v-cntxt-userid
     3626                                             ) .
     3627           run gbl/wndpar_r.p
     3628             (input  v-cntxt-db-num
     3629             ,input  v-cntxt-userid
     3630             ,input  'wndmax':U
     3631             ,output v-diasize-wndmax
     3632             ,output v-default-value
     3633             ) .
     3634         end.
     3635         assign
     3636           v-diasize-wndstore = false
     3637         .
     3638         if connected("ub") = true
     3639         then do:
     3640           run gbl/wndpar_r.p
     3641             (input  v-cntxt-db-num
     3642             ,input  v-cntxt-userid
     3643             ,input  'wndstore':U
     3644             ,output v-diasize-wndstore
     3645             ,output v-default-value
     3646             ) .
     3647         end.
     3648         assign
     3649           v-diasize-proc-name = entry(1, program-name(2), '.')
     3650         .
     3651         if v-diasize-wndstore = true
     3652         then do:
     3653           assign
     3654             v-restore-saved = false
     3655           .
     3656           if connected("ub") = true
     3657           then do:
     3658             run gbl/wndsizer.p
     3659               (input  v-cntxt-db-num
     3660               ,input  v-cntxt-userid
     3661               ,input  v-diasize-proc-name
     3662               ,input  'height':u
     3663               ,output v-resize-value-str
     3664               ) .
     3665             if v-resize-value-str <> '':U
     3666             then do:
     3667               run diasize_change-height in this-procedure
     3668                 (input  integer(v-resize-value-str)
     3669                 ,input  true
     3670                 ) .
     3671               assign
     3672                 v-restore-saved = true
     3673               .
     3674             end.
     3675           end.
     3676           if connected("ub") = true
     3677           then do:
     3678             run gbl/wndsizer.p
     3679               (input  v-cntxt-db-num
     3680               ,input  v-cntxt-userid
     3681               ,input  v-diasize-proc-name
     3682               ,input  'width':u
     3683               ,output v-resize-value-str
     3684               ) .
     3685             if v-resize-value-str <> '':U
     3686             then do:
     3687               run diasize_change-width in this-procedure
     3688                 (input  integer(v-resize-value-str)
     3689                 ,input  true
     3690                 ) .
     3691               assign
     3692                 v-restore-saved = true
     3693               .
     3694             end.
     3695           end.
     3696           if v-restore-saved <> true
     3697           then do:
     3698             if v-diasize-wndmax = true
     3699             then do:
     3700               run diasize_maximize in this-procedure
     3701                 (input  true
     3702                 ) .
     3703             end.
     3704           end.
     3705         end.
     3706         else do:
     3707           if v-diasize-wndmax = true
     3708           then do:
     3709             run diasize_maximize in this-procedure
     3710               (input  true
     3711               ) .
     3712           end.
     3713         end.
     3714       end.
     3715     end.
     3716   end procedure.
     3717   procedure diasize_need-full-display :
     3718     define output parameter p-need-full-display as logical   no-undo .
     3719     do
     3720     on error undo, return error return-value
     3721     :
     3722       assign
     3723         p-need-full-display = v-diasize-need-full-display
     3724       .
     3725       assign
     3726         v-diasize-need-full-display = false
     3727       .
     3728     end.
     3729   end procedure.
     3730   procedure get-context :
     3731      define output parameter p-db-num as integer          no-undo.
     3732      define output parameter p-user-id as character        no-undo.
     3733      define variable v-login               as character    no-undo.
     3734      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3735      define buffer buf_user-login  for ub.user-login .
     3736      do
     3737      on error undo, return error
     3738      :
     3739            FIND FIRST buf_sys-ctrl no-lock.
     3740            ASSIGN
     3741               v-login = USERID("ub")
     3742               p-db-num = buf_sys-ctrl.db-num
     3743            .
     3744            FIND FIRST buf_user-login
     3745                 WHERE buf_user-login.db-num = p-db-num
     3746                   AND buf_user-login.user-login = v-login
     3747                 no-lock
     3748                 no-error
     3749                 .
     3750            IF AVAILABLE buf_user-login
     3751            THEN DO:
     3752               assign
     3753                  p-user-id = buf_user-login.user-id
     3754               .
     3755            END.
     3756      end.
     3757   end procedure.
     3758     run diasize_init in this-procedure .
     3759     RUN enable_UI.
     3760     WAIT-FOR GO OF FRAME Dialog-Frame.
     3761   END.
     3762   RUN disable_UI.
     3763   PROCEDURE proc-b-mark :
     3764     define variable varlog as logical   no-undo .
     3765     if not available tt-gds then return.
     3766     run local-mark in this-procedure.
     3767     assign varlog = br-goods :select-next-row( ) in frame Dialog-Frame.
     3768     apply "ENTRY":U to br-goods in frame Dialog-Frame.
     3769     br-goods:refresh() in frame Dialog-Frame .
     3770   END PROCEDURE.
     3771   PROCEDURE local-mark :
     3772     if not available tt-gds then do:
     3773       message "Неправильный выбор строки.".
     3774       return no-apply.
     3775     end.
     3776   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3777   define variable v-str-recid14 as character no-undo .
     3778   define variable v-num-entry14 as integer   no-undo .
     3779   assign
     3780     v-str-recid14 = trim( string( recid( tt-gds ) , "->>>>>>>>>>>9":U ) )
     3781     v-num-entry14 = lookup( v-str-recid14 , select-list )
     3782   .
     3783   if v-num-entry14 > 0 then do:
     3784     assign
     3785       entry( v-num-entry14, select-list ) = "":U
     3786       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     3787     .
     3788   end.
     3789   else do:
     3790     assign
     3791       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid14
     3792     .
     3793   end.
     3794     br-goods:refresh() in frame Dialog-Frame .
     3795   END PROCEDURE.
     3796   PROCEDURE fill-tt :
     3797       define variable v-alc-type-code as character no-undo .
     3798       extGdsObj = new ExtGds(yes).
     3799       for each tt-gds :
     3800           delete tt-gds .
     3801       end.
     3802       if not available buf_clients then return.
     3803       for each buf_goods no-lock where buf_goods.prod-code = buf_clients.obj-code
     3804                                    and buf_goods.prod-type = buf_clients.obj-type :
     3805           run gds-attr-value(
     3806               buf_goods.gds-code,
     3807               'alcohol-prod':U,
     3808               output par-alcohol,
     3809               output par-type
     3810           ).
     3811           if par-alcohol <> "" and par-alcohol <> "no" then do :
     3812               extGdsObj:OpenQueryExtGds(buf_goods.gds-code, "").
     3813               v-alc-type-code = "" .
     3814               for first ub.alc-type-gds where ub.alc-type-gds.gds-code = buf_goods.gds-code no-lock,
     3815                   first ub.alc-type where ub.alc-type.alc-type-inner-code = ub.alc-type-gds.alc-type-inner-code no-lock :
     3816                   assign v-alc-type-code = ub.alc-type.alc-type-code .
     3817               end.
     3818               if extGdsObj:NumBundles = 0 then do :
     3819                   create tt-gds .
     3820                   assign
     3821                       tt-gds.gds-code = buf_goods.gds-code
     3822                       tt-gds.gds-name = buf_goods.gds-name
     3823                       tt-gds.ms-base  = buf_goods.ms-base
     3824                       tt-gds.proof    = buf_goods.proof
     3825                       tt-gds.old-gds-code = buf_goods.gds-code
     3826                       tt-gds.alc-type-code = v-alc-type-code
     3827                   .
     3828               end.
     3829               else
     3830               do numBundles = 1 to extGdsObj:NumBundles :
     3831                   create tt-gds .
     3832                   assign
     3833                       tt-gds.gds-code = buf_goods.gds-code
     3834                       tt-gds.gds-name = buf_goods.gds-name
     3835                       tt-gds.ms-base  = buf_goods.ms-base
     3836                       tt-gds.proof    = buf_goods.proof
     3837                       tt-gds.old-gds-code = buf_goods.gds-code
     3838                       tt-gds.alc-type-code = v-alc-type-code
     3839                   .
     3840                   assign
     3841                       tt-gds.alc-code = extGdsObj:GetExtGdsValue(numBundles):AlcCode
     3842                       tt-gds.old-alc-code = extGdsObj:GetExtGdsValue(numBundles):AlcCode
     3843                       tt-gds.egais-name = extGdsObj:GetExtGdsValue(numBundles):FullNameGds
     3844                   .
     3845               end.
     3846           end.
     3847       end.
     3848       delete object extGdsObj no-error .
     3849   END PROCEDURE.
     3850   PROCEDURE refresh-query :
     3851     if NameContext2 = "" then do :
     3852         case rs-sort :
     3853           when 1 then do:
     3854             OPEN QUERY br-goods FOR EACH tt-gds
     3855                        by tt-gds.gds-name
     3856                        indexed-reposition .
     3857           end.
     3858           when 2 then do:
     3859             OPEN QUERY br-goods FOR EACH tt-gds
     3860                        by tt-gds.gds-code
     3861                        indexed-reposition .
     3862           end.
     3863           OTHERWISE do:
     3864             OPEN QUERY br-goods FOR EACH tt-gds
     3865                        by tt-gds.alc-code
     3866                        indexed-reposition .
     3867           end.
     3868         end case.
     3869     end.
     3870     else do :
     3871         case rs-sort :
     3872           when 1 then do:
     3873             OPEN QUERY br-goods FOR EACH tt-gds where tt-gds.gds-name contains NameContext2
     3874                        by tt-gds.gds-name
     3875                        indexed-reposition .
     3876           end.
     3877           when 2 then do:
     3878             OPEN QUERY br-goods FOR EACH tt-gds where tt-gds.gds-name contains NameContext2
     3879                        by tt-gds.gds-code
     3880                        indexed-reposition .
     3881           end.
     3882           OTHERWISE do:
     3883             OPEN QUERY br-goods FOR EACH tt-gds where tt-gds.gds-name contains NameContext2
     3884                        by tt-gds.alc-code
     3885                        indexed-reposition .
     3886           end.
     3887         end case.
     3888     end.
     3889   END PROCEDURE.
     3890   procedure sel-prod :
     3891       assign
     3892           ref-list = "":U
     3893       .
     3894       run ref/cli-all.w (
     3895                          input parparentproc
     3896                       ,  input "b-sel"
     3897                       ,  input 'все':U
     3898                       ,  input 'все':U
     3899                       ,  input 'текущие':U
     3900                       ,  input ?
     3901                       ,  input ",,,,,,NO,,,"
     3902                       ,  input ?
     3903                       , output ref-list
     3904                       ) .
     3905       if ref-list = "":U then do:
     3906           RUN enable_UI IN THIS-PROCEDURE.
     3907           return no-apply.
     3908       end.
     3909       find first buf_clients no-lock where recid(buf_clients) = integer(ref-list) .
     3910       if available buf_clients then do :
     3911           assign
     3912               v-prod = buf_clients.obj-type + string(buf_clients.obj-code)
     3913               v-prod-name = buf_clients.obj-name
     3914           .
     3915           find first buf_firm no-lock where buf_firm.firm-code = buf_clients.obj-code no-error .
     3916           if available buf_firm then do :
     3917               if trim(buf_firm.inn) = "" or buf_firm.inn = ? then do :
     3918                   message "У производителя не заполнен ИНН. Для отправки запроса в ЕГАИС необходим корректный ИНН" view-as alert-box.
     3919                   return error.
     3920               end.
     3921               egais:EGAISImpl = new DictGds(v-cntxt-obj-type, v-cntxt-obj-code, v-fs-rar, buf_firm.inn) .
     3922           end.
     3923       end.
     3924       display v-prod v-prod-name with frame Dialog-Frame.
     3925       run fill-tt.
     3926       run refresh-query in this-procedure .
     3927       apply "value-changed" to br-goods IN FRAME Dialog-Frame .
     3928   end procedure.
     3929   PROCEDURE disable_UI :
     3930     HIDE FRAME Dialog-Frame.
     3931   END PROCEDURE.
     3932   PROCEDURE enable_UI :
     3933     DISPLAY rs-sort
     3934         WITH FRAME Dialog-Frame.
     3935     ENABLE b-mark b-sel-all b-unmark b-load rs-sort b-save b-lkp b-cancel b-prod br-goods NameContext
     3936         WITH FRAME Dialog-Frame.
     3937     VIEW FRAME Dialog-Frame.
     3938     br-goods:column-resizable in FRAME Dialog-Frame = true .
     3939     run refresh-query in this-procedure .
     3940   END PROCEDURE.
