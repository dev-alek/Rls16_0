      430   procedure clntattr-code :
      431     define input  parameter p-code           as character no-undo .
      432     define output parameter p-type           as character no-undo .
      433     define output parameter p-format         as character no-undo .
      434     define output parameter p-label          as character no-undo .
      435     define output parameter p-user-can-edit  as logical   no-undo .
      436     define output parameter p-output-display as logical   no-undo .
      437     define output parameter p-other          as character no-undo .
      438     do
