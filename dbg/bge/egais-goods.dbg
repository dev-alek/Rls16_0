      709   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      710   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      711   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      712   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      713   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      714   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      715   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      716   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      717   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      718   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      719   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      720   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      721   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      722   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      723   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      724   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      725   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      726   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      727   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      728   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      729   procedure gen-key-rec :
      730     define input  parameter p-tbl-name    as character no-undo.
      731     define input  parameter p-bh_tbl-name as handle    no-undo.
      732     define output parameter p-key-rec     as character no-undo.
      733     do
      734     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      735     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      736     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      737     :
      738       define variable fh               as handle    no-undo .
      739       define variable v-ok             as logical   no-undo .
      740       define variable v-inform         as character no-undo .
      741       define variable v-ind            as integer   no-undo .
      742       define variable v-idx-field-qnty as integer   no-undo .
      743       if p-tbl-name = ?
      744         or p-tbl-name = "":U
      745       then do:
      746         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info7 ).
      747       end.
      748       if not p-bh_tbl-name:available then do:
      749         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info7, p-tbl-name ).
      750       end.
      751       assign
      752         p-key-rec = p-tbl-name
      753         v-inform  = p-bh_tbl-name:index-information(1)
      754         v-ind     = 2
      755       .
      756       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      757       on error undo, return error
      758       :
      759         assign
      760           v-inform = p-bh_tbl-name:index-information( v-ind )
      761           v-ind    = v-ind + 1
      762         .
      763       end.
      764       if v-inform = ?
      765         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      766         or entry( 3, v-inform, ",":U ) <> "1":U
      767       then do:
      768         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, p-tbl-name ).
      769       end.
      770       else do:
      771         assign
      772           v-idx-field-qnty = num-entries( v-inform ) - 4
      773         .
      774         if v-idx-field-qnty < 2 then do:
      775           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, p-tbl-name ).
      776         end.
      777         do v-ind = 1 to v-idx-field-qnty by 2
      778         on error undo, return error
      779         :
      780           assign
      781             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      782             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      783           .
      784         end.
      785       end.
      786       if p-key-rec = ? then do:
      787         assign
      788           p-key-rec = "":U
      789         .
      790         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info7, p-tbl-name ).
      791       end.
      792     end.
      793     return.
      794   end procedure.
      795   procedure gen-where-keyr-tab :
      796     define input  parameter i-tableSerach as character no-undo.
      797     define input  parameter i-tablekey   as character  no-undo.
      798     define input  parameter p-key-rec    as character  no-undo.
      799     define input  parameter p-key-handle as handle     no-undo .
      800     define input  parameter p-db-name    as character  no-undo .
      801     define input  parameter p-tt-handle  as handle     no-undo .
      802     define output parameter o-Where      as character  no-undo.
      803     do
      804     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      805     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      806     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      807     :
      808       define variable v-full-tbl-name  as character no-undo .
      809       define variable bh_tbl-name      as handle    no-undo .
      810       define variable fh_key           as handle    no-undo .
      811       define variable fh_search        as handle    no-undo .
      812       define variable v-field-num      as integer   no-undo .
      813       define variable v-count-fld      as integer   no-undo .
      814       define variable v-inform         as character no-undo .
      815       define variable v-ind            as integer   no-undo .
      816       define variable v-idx-field-qnty as integer   no-undo .
      817       define variable v-field-name     as character no-undo .
      818       define variable v-field-val      as character no-undo .
      819       define variable v-word-link      as character no-undo .
      820       define variable vTable           as character no-undo.
      821       define variable bh_tbl-key       as handle    no-undo .
      822       assign
      823         p-key-rec = trim( p-key-rec )
      824       .
      825       if p-key-handle <> ? then do:
      826         if not valid-handle(p-key-handle)
      827            or p-key-handle:type <> "buffer"
      828         then do:
      829           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info7 ).
      830         end.
      831         if num-entries( p-key-rec, chr(3) ) > 1
      832           or p-key-rec = ?
      833           or p-key-rec = "":U
      834         then do:
      835           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info7, p-key-rec ).
      836         end.
      837       end.
      838       else do:
      839         if p-key-rec = ?
      840           or p-key-rec = "":U
      841         then do:
      842           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
      843         end.
      844       end.
      845       assign
      846         vTable = entry( 1 , p-key-rec, chr(3) )
      847       .
      848       if p-tt-handle <> ?
      849         and ( not valid-handle(p-tt-handle)
      850               or p-tt-handle:type <> "buffer"
      851             )
      852       then do:
      853         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info7, vTable, chr(10) ).
      854       end.
      855       if p-tt-handle = ? then do:
      856         assign
      857           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      858         .
      859         create buffer bh_tbl-name for table v-full-tbl-name .
      860       end.
      861       else do:
      862         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      863       end.
      864       assign
      865         v-inform = bh_tbl-name:index-information(1)
      866         v-ind    = 2
      867       .
      868       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      869       on error undo, return error
      870       :
      871         assign
      872           v-inform = bh_tbl-name:index-information( v-ind )
      873           v-ind    = v-ind + 1
      874         .
      875       end.
      876       if v-inform = ?
      877         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      878         or entry( 3, v-inform, ",":U ) <> "1":U
      879       then do:
      880         delete object bh_tbl-name no-error.
      881         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info7, vTable ).
      882       end.
      883       assign
      884         v-idx-field-qnty = num-entries( v-inform ) - 4
      885       .
      886       if v-idx-field-qnty < 2 then do:
      887         delete object bh_tbl-name no-error.
      888         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, vTable ).
      889       end.
      890       assign
      891         o-where     = "where":U
      892         v-word-link = "":U
      893         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      894         v-count-fld = 0
      895       .
      896       if i-tablekey ne "" and i-tablekey ne ?
      897       then do:
      898         assign
      899           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      900         .
      901         create buffer bh_tbl-key for table v-full-tbl-name .
      902       end.
      903       if i-tableSerach ne "" and i-tableSerach ne ?
      904       then do:
      905         delete object bh_tbl-name no-error.
      906         assign
      907           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      908         .
      909         create buffer bh_tbl-name for table v-full-tbl-name .
      910       end.
      911       block_where:
      912       do v-ind = 1 to v-idx-field-qnty by 2
      913       on error undo, return error
      914       :
      915         assign
      916           v-count-fld = v-count-fld + 1
      917         .
      918         if p-key-handle = ?
      919           and v-count-fld > v-field-num
      920         then do:
      921           leave block_where.
      922         end.
      923         define variable VfieldKeyTable as handle no-undo.
      924         assign
      925           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      926           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      927         .
      928         if     bh_tbl-key ne ?
      929         then do:
      930            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      931            if VfieldKeyTable eq ?
      932            then next block_where.
      933         end.
      934         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      935         then
      936            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      937         else
      938            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      939         if p-key-handle = ? then do:
      940           assign
      941             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      942           .
      943         end.
      944         else do:
      945           assign
      946             fh_key = p-key-handle:buffer-field( v-field-name )
      947           .
      948           if fh_key = ?
      949             or not valid-handle( fh_key )
      950           then do:
      951             delete object bh_tbl-name.
      952             if     bh_tbl-key ne ?
      953             then
      954                delete object bh_tbl-key.
      955             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info7, p-key-handle:name, v-field-name ).
      956           end.
      957           assign
      958             v-field-val = fh_key:buffer-value
      959           .
      960         end.
      961         if fh_search:data-type ="character":U then do:
      962           assign
      963             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      964             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      965             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      966             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      967             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      968             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      969             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      970             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      971             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      972             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      973             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      974             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      975             v-field-val = substitute( '"&1"', v-field-val )
      976           .
      977         end.
      978         assign
      979           o-where = substitute( "&1 &2", o-where, v-field-val )
      980         .
      981         if v-word-link = "":U then do:
      982           assign
      983             v-word-link = "and":U
      984           .
      985         end.
      986       end.
      987       delete object bh_tbl-name.
      988       if     bh_tbl-key ne ?
      989       then
      990          delete object bh_tbl-key.
      991       if p-key-handle = ?
      992         and v-count-fld <> v-field-num
      993       then do:
      994         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info7, vTable ).
      995       end.
      996     end.
      997   end procedure.
      998   procedure gen-hn-keyr-tab :
      999     define input  parameter i-tableSerach as character no-undo.
     1000     define input  parameter i-tablekey   as character no-undo.
     1001     define input  parameter p-key-rec    as character no-undo.
     1002     define input  parameter p-key-handle as handle    no-undo .
     1003     define input  parameter p-db-name    as character no-undo .
     1004     define input  parameter p-tt-handle  as handle    no-undo .
     1005     define input  parameter p-stts-lock  as integer   no-undo .
     1006     define output parameter o-hn         as handle    no-undo.
     1007     define variable v-full-tbl-name as character no-undo.
     1008     define variable v-where         as character no-undo.
     1009     define variable bh_tbl-name     as handle    no-undo.
     1010     define variable vTable          as character no-undo.
     1011     do
     1012     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1013     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1014     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1015         run gen-where-keyr-tab(i-tableSerach,
     1016                                i-tablekey,
     1017                                p-key-rec,
     1018                                p-key-handle,
     1019                                p-db-name,
     1020                                p-tt-handle,
     1021                                output v-where).
     1022         if i-tableSerach ne "" and i-tableSerach ne ?
     1023         then do:
     1024            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1025            create buffer bh_tbl-name for table v-full-tbl-name .
     1026         end.
     1027         else do:
     1028            if p-tt-handle = ? then do:
     1029               assign
     1030                  vTable = entry( 1 , p-key-rec, chr(3) )
     1031               .
     1032               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1033               create buffer bh_tbl-name for table v-full-tbl-name .
     1034            end.
     1035            else do:
     1036               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1037            end.
     1038         end.
     1039         if p-tt-handle = ? then do:
     1040            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1041         end.
     1042         else do:
     1043            bh_tbl-name:find-first( v-where ) no-error .
     1044         end.
     1045         o-hn = bh_tbl-name.
     1046      end.
     1047   end procedure.
     1048   procedure gen-hn-keyr :
     1049     define input  parameter p-key-rec    as character no-undo.
     1050     define input  parameter p-key-handle as handle    no-undo .
     1051     define input  parameter p-db-name    as character no-undo .
     1052     define input  parameter p-tt-handle  as handle    no-undo .
     1053     define input  parameter p-stts-lock  as integer   no-undo .
     1054     define output parameter o-hn         as handle    no-undo.
     1055     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1056   end.
     1057   procedure gen-row-keyr :
     1058     define input  parameter p-key-rec    as character no-undo.
     1059     define input  parameter p-key-handle as handle    no-undo .
     1060     define input  parameter p-db-name    as character no-undo .
     1061     define input  parameter p-tt-handle  as handle    no-undo .
     1062     define input  parameter p-stts-lock  as integer   no-undo .
     1063     define output parameter p-tbl-row    as rowid     no-undo.
     1064     define output parameter p-tbl-name   as character no-undo.
     1065     define variable vHn as handle no-undo.
     1066       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1067       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1068       p-tbl-name =  vHn:table.
     1069       delete object vHn no-error.
     1070     if p-tbl-row = ? then do:
     1071       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info7, p-tbl-name, p-key-rec ).
     1072     end.
     1073     else do:
     1074       return.
     1075     end.
     1076   end procedure.
     1077   procedure gen-key-fv :
     1078     define input  parameter p-key-rec    as character no-undo .
     1079     define output parameter p-field-list as character no-undo .
     1080     define output parameter p-value-list as character no-undo.
     1081     do
     1082     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1083     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1084     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1085     :
     1086       define variable v-full-tbl-name  as character no-undo .
     1087       define variable bh_tbl-name      as handle    no-undo .
     1088       define variable v-tbl-name       as character no-undo .
     1089       define variable v-field-num      as integer   no-undo .
     1090       define variable v-count-fld      as integer   no-undo .
     1091       define variable v-inform         as character no-undo .
     1092       define variable v-ind            as integer   no-undo .
     1093       define variable v-idx-field-qnty as integer   no-undo .
     1094       define variable v-delim-key      as character no-undo .
     1095       if p-key-rec = ?
     1096         or p-key-rec = "":U
     1097       then do:
     1098         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1099       end.
     1100       assign
     1101         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1102         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1103       .
     1104       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1105       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info7 ).
     1106       assign
     1107         v-inform = bh_tbl-name:index-information(1)
     1108         v-ind    = 2
     1109       .
     1110       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1111       on error undo, return error
     1112       :
     1113         assign
     1114           v-inform = bh_tbl-name:index-information( v-ind )
     1115           v-ind    = v-ind + 1
     1116         .
     1117       end.
     1118       if v-inform = ?
     1119         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1120         or entry( 3, v-inform, ",":U ) <> "1":U
     1121       then do:
     1122         delete object bh_tbl-name no-error.
     1123         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1124       end.
     1125       assign
     1126         v-idx-field-qnty = num-entries( v-inform ) - 4
     1127       .
     1128       if v-idx-field-qnty < 2 then do:
     1129         delete object bh_tbl-name no-error.
     1130         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1131       end.
     1132       assign
     1133         p-field-list = "":U
     1134         p-value-list = "":U
     1135         v-delim-key  = "":U
     1136         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1137         v-count-fld  = 0
     1138       .
     1139       block_where:
     1140       do v-ind = 1 to v-idx-field-qnty by 2
     1141       on error undo, return error
     1142       :
     1143         assign
     1144           v-count-fld = v-count-fld + 1
     1145         .
     1146         if v-count-fld > v-field-num then do:
     1147           leave block_where.
     1148         end.
     1149         assign
     1150           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1151           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1152         .
     1153         if v-ind = 1 then do:
     1154           assign
     1155             v-delim-key = chr(3)
     1156           .
     1157         end.
     1158       end.
     1159       delete object bh_tbl-name.
     1160       if v-count-fld <> v-field-num then do:
     1161         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info7, v-tbl-name ).
     1162       end.
     1163     end.
     1164   end procedure.
     1165   procedure gen-key-field :
     1166     define input  parameter p-table      as character no-undo .
     1167     define output parameter p-field-list as character no-undo .
     1168     do
     1169     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1170     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1171     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1172     :
     1173       define variable v-full-tbl-name  as character no-undo .
     1174       define variable bh_tbl-name      as handle    no-undo .
     1175       define variable v-tbl-name       as character no-undo .
     1176       define variable v-field-num      as integer   no-undo .
     1177       define variable v-count-fld      as integer   no-undo .
     1178       define variable v-inform         as character no-undo .
     1179       define variable v-ind            as integer   no-undo .
     1180       define variable v-idx-field-qnty as integer   no-undo .
     1181       define variable v-delim-key      as character no-undo .
     1182       if p-table = ?
     1183         or p-table = "":U
     1184       then do:
     1185         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info7 ).
     1186       end.
     1187       assign
     1188         v-tbl-name      = p-table
     1189         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1190       .
     1191       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1192       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info7 ).
     1193       assign
     1194         v-inform = bh_tbl-name:index-information(1)
     1195         v-ind    = 2
     1196       .
     1197       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1198       on error undo, return error
     1199       :
     1200         assign
     1201           v-inform = bh_tbl-name:index-information( v-ind )
     1202           v-ind    = v-ind + 1
     1203         .
     1204       end.
     1205       if v-inform = ?
     1206         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1207         or entry( 3, v-inform, ",":U ) <> "1":U
     1208       then do:
     1209         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1210       end.
     1211       assign
     1212         v-idx-field-qnty = num-entries( v-inform ) - 4
     1213       .
     1214       if v-idx-field-qnty < 2 then do:
     1215         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1216       end.
     1217       assign
     1218         p-field-list = "":U
     1219         v-delim-key  = "":U
     1220         v-count-fld  = 0
     1221       .
     1222       block_where:
     1223       do v-ind = 1 to v-idx-field-qnty by 2
     1224       on error undo, return error
     1225       :
     1226         assign
     1227           v-count-fld = v-count-fld + 1
     1228         .
     1229         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1230         if v-ind = 1 then do:
     1231           assign
     1232             v-delim-key = chr(3)
     1233           .
     1234         end.
     1235       end.
     1236       delete object bh_tbl-name.
     1237     end.
     1238   end procedure.
     1239   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1240   procedure gds-attr-name :
     1241     define input  parameter p-code           as character no-undo .
     1242     define output parameter p-type           as character no-undo .
     1243     define output parameter p-format         as character no-undo .
     1244     define output parameter p-label          as character no-undo .
     1245     define output parameter p-user-can-edit  as logical   no-undo .
     1246     define output parameter p-output-display as logical   no-undo .
     1247     define output parameter p-other          as character no-undo .
     1248     do
     1249     on error undo, return error
     1250     :
     1251           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
     1252         (input  p-code
     1253         ,output p-type
     1254         ,output p-format
     1255         ,output p-label
     1256         ,output p-user-can-edit
     1257         ,output p-output-display
     1258         ,output p-other
     1259         ) no-error .
     1260       if error-status :error
     1261       then do:
     1262         undo, return error return-value .
     1263       end.
     1264     end.
     1265   end procedure.
     1266   procedure gds-attr-tooltip :
     1267     define input  parameter p-code    as character no-undo .
     1268     define output parameter p-tooltip as character no-undo .
     1269     define output parameter p-label   as character no-undo .
     1270     do
     1271     on error undo, return error
     1272     :
     1273           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-tooltip in g#attr-lib
     1274         (input  p-code
     1275         ,output p-tooltip
     1276         ,output p-label
     1277         ) no-error .
     1278       if error-status :error
     1279       then do:
     1280         undo, return error return-value .
     1281       end.
     1282     end.
     1283   end procedure.
     1284   procedure gds-attr-value :
     1285     define input  parameter p-gds-code as integer   no-undo .
     1286     define input  parameter p-code     as character no-undo .
     1287     define output parameter p-value    as character no-undo .
     1288     define output parameter p-type     as character no-undo .
     1289     do
