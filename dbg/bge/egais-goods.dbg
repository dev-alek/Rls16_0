      120     define variable v-cntxt-userid        as character no-undo .
      121     define variable v-cntxt-level         as character no-undo .
      122     define variable v-cntxt-host-code-obj as integer   no-undo .
      123     define variable v-cntxt-obj-type      as character no-undo .
      124     define variable v-cntxt-obj-code      as integer   no-undo .
      125     define variable v-cntxt-db-num-obj    as integer   no-undo .
      126     define variable v-cntxt-is-admin      as logical   no-undo .
      127   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128     run mainmenu_getcntxt in parparentproc
      129       (output v-cntxt-db-num
      130       ,output v-cntxt-userid
      131       ,output v-cntxt-level
      132       ,output v-cntxt-host-code-obj
      133       ,output v-cntxt-obj-type
      134       ,output v-cntxt-obj-code
      135       ,output v-cntxt-db-num-obj
      136       ,output v-cntxt-is-admin
      137       ) .
      138   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   define new global shared variable g#attr-lib  as handle no-undo .
      140   define variable v-attr-lib-variable as handle no-undo .
      141   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      142   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      143   procedure thbjattr_code :
      144      define input  parameter p-upper-code     as character no-undo .
      145      define input  parameter p-code           as character no-undo .
      146      define output parameter p-label          as character no-undo .
      147      define output parameter p-user-can-edit  as logical   no-undo .
      148      define output parameter p-output-display as logical   no-undo .
      149      define output parameter p-other          as character no-undo .
      150      define output parameter p-prop-list      as character no-undo .
      151      define output parameter p-prop-type-list as character no-undo .
      152      define output parameter p-prop-label-list as character no-undo .
      153      define output parameter p-global          as logical no-undo .
      154      define output parameter p-host           as logical no-undo .
      155      define output parameter p-shop           as logical no-undo .
      156      define output parameter p-store          as logical no-undo .
      157      define output parameter p-db             as logical no-undo .
      158      define variable p-region as logical no-undo.
      159      run thbjattr_code_reg in this-procedure (
      160                                               p-upper-code,
      161                                               p-code,
      162                                               output p-label,
      163                                               output p-user-can-edit,
      164                                               output p-output-display,
      165                                               output p-other,
      166                                               output p-prop-list,
      167                                               output p-prop-type-list,
      168                                               output p-prop-label-list,
      169                                               output p-global,
      170                                               output p-host,
      171                                               output p-shop,
      172                                               output p-store,
      173                                               output p-db,
      174                                               output p-region
      175                                               ).
      176   end procedure.
      177   procedure thbjattr_code_reg :
      178   define input  parameter p-upper-code     as character no-undo .
      179   define input  parameter p-code           as character no-undo .
      180   define output parameter p-label          as character no-undo .
      181   define output parameter p-user-can-edit  as logical   no-undo .
      182   define output parameter p-output-display as logical   no-undo .
      183   define output parameter p-other          as character no-undo .
      184   define output parameter p-prop-list      as character no-undo .
      185   define output parameter p-prop-type-list as character no-undo .
      186   define output parameter p-prop-label-list as character no-undo .
      187   define output parameter p-global          as logical no-undo .
      188   define output parameter p-host           as logical no-undo .
      189   define output parameter p-shop           as logical no-undo .
      190   define output parameter p-store          as logical no-undo .
      191   define output parameter p-db             as logical no-undo .
      192   define output parameter p-region         as logical no-undo .
      193   do
      194   on error undo, return error return-value
      195   :
      196       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      197       (input  p-upper-code
      198       ,input  p-code
      199       ,output p-label
      200       ,output p-user-can-edit
      201       ,output p-output-display
      202       ,output p-other
      203       ,output p-prop-list
      204       ,output p-prop-type-list
      205       ,output p-prop-label-list
      206       ,output p-global
      207       ,output p-host
      208       ,output p-shop
      209       ,output p-store
      210       ,output p-db
      211       ,output p-region
      212       ) no-error .
      213     if error-status :error
      214     then do:
      215       undo, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message (1)).
      216     end.
      217   end.
      218   end procedure.
