        1   block-level on error undo, throw.
        2   define input parameter parparentproc        as widget-handle no-undo .
        3   define input parameter p-format-type        as character no-undo.
        4   define input parameter p-export-type        as character no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision: a61e6bb0c7e0, 2871, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
        7   define variable vss-date        as character no-undo init "$date: 14.08.03 11:06 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: bge.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: bge/bge.p $":U .
       10   define variable vss-description as character no-undo init "Экспорт XML".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "X(65)" no-undo
       72   initial "@(#)$Workfile$ $Revision$".
       73   define variable v-bgelib-bgefmt        as character         no-undo.
       74   define variable v-bgelib-bgeflold      as character         no-undo.
       75   define stream stmXMLOut.
       76   define stream stmXMLLog.
       77   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   procedure cur-time :
       79      define output parameter p-today as date      no-undo .
       80      define output parameter p-time  as integer   no-undo .
       81     do
       82     on error undo, return error
       83     :
       84       define variable v-date1 as date      no-undo .
       85       define variable v-date2 as date      no-undo .
       86       define variable v-time  as integer   no-undo .
       87       assign
       88         v-date1 = today
       89         v-time  = time
       90         v-date2 = today
       91       .
       92       if v-date1 <> v-date2
       93       then do:
       94         assign
       95           v-date1 = today
       96           v-time  = v-time
       97         .
       98       end.
       99       assign
      100         p-today = v-date1
      101         p-time  = v-time
      102       .
      103     end.
      104   end.
      105   function cur-time-date returns character
      106   :
      107     return string(today, '99/99/9999':U) .
      108   end.
      109   function cur-time-mjd returns decimal
      110   :
      111     define variable v-date as date      no-undo .
      112     define variable v-time as integer   no-undo .
      113     run cur-time in this-procedure
      114       (output v-date
      115       ,output v-time
      116       ) .
      117     return integer(v-date) - 2400002 + (v-time / 86400) .
      118   end.
      119   function cur-time-get-ending-index returns integer
      120   (input p-number as integer
      121   )
      122   :
      123     if p-number < 0
      124     or p-number = ?
      125     then do:
      126       return 1 .
      127     end.
      128     define variable v-rest as integer   no-undo .
      129     assign
      130       p-number = p-number modulo 100
      131     .
      132     if p-number < 20
      133     then do:
      134       assign
      135         v-rest = p-number
      136       .
      137     end.
      138     else do:
      139       assign
      140         v-rest = p-number modulo 10
      141       .
      142     end.
      143     case v-rest :
      144       when 1
      145       then do:
      146         return 2 .
      147       end.
      148       when 2 or
      149       when 3 or
      150       when 4
      151       then do:
      152         return 3 .
      153       end.
      154       otherwise do:
      155         return 1 .
      156       end.
      157     end case .
      158   end.
      159   procedure cur-time-mjd-to-date :
      160      define input  parameter i-mjd-diff as decimal no-undo.
      161      define output parameter o-Date     as date    no-undo.
      162      define output parameter o-Time     as integer no-undo.
      163      define variable v-day-number as integer   no-undo .
      164      if    i-mjd-diff < 0
      165         or i-mjd-diff = ?
      166      then do:
      167         return "?" .
      168      end.
      169      assign
      170         v-day-number = truncate(i-mjd-diff,0).
      171         o-Date = date(v-day-number + 2400002).
      172         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      173     .
      174   end.
      175   function cur-time-mjd-to-string returns character
      176   (input p-mjd-diff as decimal
      177   )
      178   :
      179     define variable v-day-number as integer   no-undo .
      180     define variable v-seconds    as integer   no-undo .
      181     define variable v-hour       as integer   no-undo .
      182     define variable v-min        as integer   no-undo .
      183     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      184     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      185     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      186     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      187     if p-mjd-diff < 0
      188     or p-mjd-diff = ?
      189     then do:
      190       return "?" .
      191     end.
      192     assign
      193       v-day-number = integer(truncate(p-mjd-diff,0))
      194       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      195     .
      196     if v-seconds > 86400
      197     then do:
      198       assign
      199         v-seconds = 86400 - 1
      200       .
      201     end.
      202     if v-seconds < 0
      203     then do:
      204       assign
      205         v-seconds = 0
      206       .
      207     end.
      208     assign
      209       v-hour = truncate(v-seconds / 3600, 0)
      210     .
      211     assign
      212       v-seconds = v-seconds modulo 3600
      213     .
      214     assign
      215       v-min = truncate(v-seconds / 60, 0)
      216     .
      217     assign
      218       v-seconds = v-seconds modulo 60
      219     .
      220     return
      221         (if v-day-number <> 0
      222           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      223           else ""
      224         )
      225       + (if v-day-number <> 0 or v-hour <> 0
      226           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      230           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      231           else ""
      232         )
      233       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      234       .
      235   end.
      236   function cur-time-string returns character
      237   :
      238     define variable v-date as date      no-undo .
      239     define variable v-time as integer   no-undo .
      240     run cur-time in this-procedure
      241       (output v-date
      242       ,output v-time
      243       ) .
      244     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      245   end.
      246   function cur-time-string-sec returns character
      247   :
      248     define variable v-date as date      no-undo .
      249     define variable v-time as integer   no-undo .
      250     run cur-time in this-procedure
      251       (output v-date
      252       ,output v-time
      253       ) .
      254     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      255   end.
      256   function cur-time-custom  returns character
      257   (input p-prefix as character
      258   ,input p-date-format as character
      259   ,input p-delimiter as character
      260   ,input p-time-format as character
      261   ,input p-suffix as character
      262   )
      263   :
      264     define variable v-date as date      no-undo .
      265     define variable v-time as integer   no-undo .
      266     run cur-time in this-procedure
      267       (output v-date
      268       ,output v-time
      269       ) .
      270     return
      271       p-prefix
      272       + string(v-date, p-date-format)
      273       + p-delimiter
      274       + string(v-time, p-time-format)
      275       + p-suffix
      276       .
      277   end.
      278   function cur-time-print  returns character
      279   :
      280     define variable v-date as date      no-undo .
      281     define variable v-time as integer   no-undo .
      282     run cur-time in this-procedure
      283       (output v-date
      284       ,output v-time
      285       ) .
      286     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      287   end.
      288   function cur-time-datetime returns datetime
      289   :
      290     define variable v-char as character no-undo .
      291     define variable v-datetime as datetime no-undo .
      292     v-char = cur-time-string().
      293     v-datetime = datetime(v-char).
      294     return  v-datetime.
      295   end.
      296   function cur-time-string-msec returns character
      297   :
      298     define variable v-date as datetime  no-undo .
      299     v-date = now.
      300     return string(v-date) .
      301   end.
      302   define variable vss-include-info2 as character format "X(65)" no-undo
      303   initial "@(#)$Workfile$ $Revision$".
      304   procedure xmlchar-test :
      305   define input parameter p-in-string          as character        no-undo.
      306   define output parameter p-out-string-enc    as character        no-undo.
      307   define output parameter p-out-string-dec    as character        no-undo.
      308   do
      309   on error undo, return error
      310   :
      311          run xmlchar-encode in this-procedure
      312       (
      313             input p-in-string
      314           , output p-out-string-enc
      315       ).
      316          run xmlchar-decode in this-procedure
      317       (
      318             input p-out-string-enc
      319           , output p-out-string-dec
      320       ).
      321   end.
      322   end .
      323   procedure xmlchar-encode :
      324   define input parameter p-in-string      as character        no-undo.
      325   define output parameter p-out-string    as character        no-undo.
      326       define variable v-position      as integer      no-undo.
      327       define variable v-current-char  as character    no-undo.
      328   do
      329   on error undo, return error
      330   :
      331       assign
      332           p-out-string = "":U
      333       .
      334       case p-in-string
      335       :
      336           when ?
      337           then do:
      338               assign
      339                   p-out-string = "?":U
      340               .
      341           end.
      342           when "?":U
      343           then do:
      344               assign
      345                   p-out-string = "&#63;":U
      346               .
      347           end.
      348           otherwise do:
      349               do v-position = 1 to length( p-in-string )
      350               :
      351                   assign
      352                       v-current-char = substring( p-in-string, v-position, 1 )
      353                   .
      354                   case v-current-char
      355                   :
      356                       when "&":U
      357                       then do:
      358                           assign
      359                               p-out-string = p-out-string + "&amp;":U
      360                           .
      361                       end.
      362                       when ">":U
      363                       then do:
      364                           assign
      365                               p-out-string = p-out-string + "&gt;":U
      366                           .
      367                       end.
      368                       when "<":U
      369                       then do:
      370                           assign
      371                               p-out-string = p-out-string + "&lt;":U
      372                           .
      373                       end.
      374                       when "'":U
      375                       then do:
      376                           assign
      377                               p-out-string = p-out-string + "&apos;":U
      378                           .
      379                       end.
      380                       when '"':U
      381                       then do:
      382                           assign
      383                               p-out-string = p-out-string + "&quot;":U
      384                           .
      385                       end.
      386                       when chr(1)
      387                       then do:
      388                           assign
      389                               p-out-string = p-out-string + "":U
      390                           .
      391                       end.
      392                       when chr(2)
      393                       then do:
      394                           assign
      395                               p-out-string = p-out-string + "":U
      396                           .
      397                       end.
      398                       when chr(3)
      399                       then do:
      400                           assign
      401                               p-out-string = p-out-string + "":U
      402                           .
      403                       end.
      404                       when chr(4)
      405                       then do:
      406                           assign
      407                               p-out-string = p-out-string + "":U
      408                           .
      409                       end.
      410                       when chr(5)
      411                       then do:
      412                           assign
      413                               p-out-string = p-out-string + "":U
      414                           .
      415                       end.
      416                       when chr(6)
      417                       then do:
      418                           assign
      419                               p-out-string = p-out-string + "":U
      420                           .
      421                       end.
      422                       when chr(7)
      423                       then do:
      424                           assign
      425                               p-out-string = p-out-string + "":U
      426                           .
      427                       end.
      428                       when chr(8)
      429                       then do:
      430                           assign
      431                               p-out-string = p-out-string + "":U
      432                           .
      433                       end.
      434                       when chr(9)
      435                       then do:
      436                           assign
      437                               p-out-string = p-out-string + "":U
      438                           .
      439                       end.
      440                       when chr(29)
      441                       then do:
      442                           assign
      443                               p-out-string = p-out-string + "":U
      444                           .
      445                       end.
      446                       when chr(10)
      447                       then do:
      448                           assign
      449                               p-out-string = p-out-string + "&#10;":U
      450                           .
      451                       end.
      452                       when chr(13)
      453                       then do:
      454                           assign
      455                               p-out-string = p-out-string + "&#13;":U
      456                           .
      457                       end.
      458                       otherwise do:
      459                           assign
      460                               p-out-string = p-out-string + v-current-char
      461                           .
      462                       end.
      463                   end case.
      464               end.
      465           end.
      466       end case.
      467   end.
      468   end .
      469   procedure xmlchar-encode-1c :
      470   define input parameter p-in-string      as character        no-undo.
      471   define output parameter p-out-string    as character        no-undo.
      472       define variable v-position      as integer      no-undo.
      473       define variable v-current-char  as character    no-undo.
      474   do
      475   on error undo, return error
      476   :
