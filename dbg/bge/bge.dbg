     2395   PROCEDURE export-shift :
     2396       define variable v-date-from         as date         no-undo.
     2397       define variable v-shift-num-from    as integer      no-undo.
     2398       define variable v-date-to           as date         no-undo.
     2399       define variable v-shift-num-to      as integer      no-undo.
     2400       define variable v-range             as integer      no-undo.
     2401       define variable v-obj-list          as character    no-undo.
     2402       define variable v-void-logical      as logical      no-undo.
     2403       define variable v-void-character    as character    no-undo.
     2404       define variable v-cancel            as logical      no-undo.
     2405   do
     2406   on error undo, return error
     2407   :
     2408       run bge/bge-dpeh.w (
     2409             input parparentproc
     2410           , input 5
     2411           , input "":U
     2412           , output v-date-from
     2413           , output v-shift-num-from
     2414           , output v-date-to
     2415           , output v-shift-num-to
     2416           , output v-void-logical
     2417           , output v-range
     2418           , output v-bge-host-code
     2419           , output v-obj-list
     2420           , output v-void-character
     2421           , output v-void-logical
     2422           , output v-void-logical
     2423           , output v-void-logical
     2424           , output v-void-logical
     2425           , output v-void-logical
     2426           , output v-void-logical
     2427           , output v-void-logical
     2428           , output v-void-logical
     2429           , output v-void-logical
     2430           , output v-cancel
     2431       ) no-error .
     2432       if error-status :error
     2433       then do:
     2434           message
     2435           vss-workfile vss-revision vss-description
     2436           skip "Ошибка ввода параметров выгрузки документов."
     2437           skip return-value
     2438           skip trim(error-status :get-message(1))
     2439               trim(error-status :get-message(2))
     2440               trim(error-status :get-message(3))
     2441           view-as alert-box error.
     2442           undo, return error .
     2443       end.
     2444       if v-cancel = yes
     2445       then do:
     2446           undo, return error .
     2447       end.
     2448       if v-date-from = ? or v-date-to = ?
     2449       then do:
     2450           return error.
     2451       end.
     2452       run bgelib-write-edt in this-procedure (
     2453             input v-bge-editor-handle
     2454           , input 1
     2455           , input substitute( "Экспорт смен, &1 (смена &2) - &3 (смена &4)"
     2456                               , string( v-date-from, "99.99.99" )
     2457                               , v-shift-num-from
     2458                               , string( v-date-to, "99.99.99" )
     2459                               , v-shift-num-to    )
     2460       ).
     2461       run bgelib-write-edt in this-procedure (
     2462             input v-bge-editor-handle
     2463           , input 1
     2464           , input substitute( "Диапазон: &1"
     2465                                   , ( if v-range = 1
     2466                                       then " по всем фирмам"
     2467                                       else ( if v-range = 2
     2468                                              then " по всем объектам текущей фирмы"
     2469                                              else " по объектам: " + v-obj-list ) ) )
     2470       ).
     2471       run bge/bge-shft.p (
     2472             input parparentproc
     2473           , input v-date-from
     2474           , input v-shift-num-from
     2475           , input v-date-to
     2476           , input v-shift-num-to
     2477           , input v-range
     2478           , input v-obj-list
     2479           , input v-bge-editor-handle
     2480           , input v-bge-fillin-handle
     2481       ) no-error.
     2482       if error-status :error
     2483       then do:
     2484           message
     2485           vss-workfile vss-revision vss-description
     2486           skip "Ошибка экспорта документов"
     2487           skip return-value
     2488           skip trim(error-status :get-message(1))
