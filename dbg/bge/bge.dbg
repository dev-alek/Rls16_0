      579   procedure xmlchar-decode :
      580   define input parameter p-in-string      as character        no-undo.
      581   define output parameter p-out-string    as character        no-undo.
      582       define variable v-position      as integer      no-undo.
      583       define variable v-last-position as integer      no-undo.
      584       define variable v-temp-integer  as integer      no-undo.
      585       define variable v-current-char  as character    no-undo.
      586       define variable v-next-char     as character    no-undo.
      587       define variable v-success       as logical      no-undo.
      588   do
      589   on error undo, return error
      590   :
      591       assign
      592           p-out-string = "":U
      593           v-position   = 0
      594       .
      595       replace-cycle:
      596       do while yes
      597       on error undo, return error
      598       :
      599           assign
      600               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      601           .
      602           if v-last-position <= v-position
      603           then do:
      604               if v-position = 0
      605               then do:
      606                   assign
      607                       p-out-string = p-in-string
      608                   .
      609               end.
      610               else do:
      611                   assign
      612                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      613                   .
      614               end.
      615               leave replace-cycle.
      616           end.
      617           else do:
      618               assign
      619                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      620                   v-position      = v-last-position
      621                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      622               .
      623               if v-current-char = "#":U
      624               then do:
      625                   assign
      626                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      627                   .
      628                   if v-last-position > 0
      629                   then do:
      630                       run xmlchar-read-integer in this-procedure
      631                        (
      632                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      633                           , output v-temp-integer
      634                           , output v-success
      635                       ).
      636                       if v-success = yes
      637                       and v-temp-integer >= 1
      638                       and v-temp-integer <= 255
      639                       then do:
      640                           assign
      641                               p-out-string = p-out-string + chr( v-temp-integer )
      642                               v-position   = v-last-position + 1
      643                           .
      644                       end.
      645                       else do:
      646                           assign
      647                               p-out-string = p-out-string + "&":U
      648                               v-position   = v-position   + 1
      649                           .
      650                       end.
      651                   end.
      652                   else do:
      653                       assign
      654                           p-out-string = p-out-string + "&":U
      655                           v-position   = v-position   + 1
      656                       .
      657                   end.
      658               end.
      659               else do:
      660                   case substring( p-in-string, v-position + 1, 3 )
      661                   :
      662                       when "lt;":U
      663                       then do:
      664                           assign
      665                               p-out-string = p-out-string + "<":U
      666                               v-position   = v-position   + 3
      667                           .
      668                       end.
      669                       when "gt;":U
      670                       then do:
      671                           assign
      672                               p-out-string = p-out-string + ">":U
      673                               v-position   = v-position   + 3
      674                           .
      675                       end.
      676                       otherwise do:
      677                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      678                           then do:
      679                               assign
      680                                   p-out-string = p-out-string + "&":U
      681                                   v-position   = v-position   + 4
      682                               .
      683                           end.
      684                           else do:
      685                               case substring( p-in-string, v-position + 1, 5 )
      686                               :
      687                                   when "quot;":U
      688                                   then do:
      689                                       assign
      690                                           p-out-string = p-out-string + '"':U
      691                                           v-position   = v-position   + 5
      692                                       .
      693                                   end.
      694                                   when "apos;":U
      695                                   then do:
      696                                       assign
      697                                           p-out-string = p-out-string + "'":U
      698                                           v-position   = v-position   + 5
      699                                       .
      700                                   end.
      701                                   otherwise do:
      702                                       assign
      703                                           p-out-string = p-out-string + "&":U
      704                                       .
      705                                   end.
      706                               end case.
      707                           end.
      708                       end.
      709                   end case.
      710               end.
      711           end.
      712       end.
      713   end.
      714   end .
      715   procedure xmlchar-read-integer :
      716   define input parameter p-input-string      as character        no-undo.
      717   define output parameter p-output-integer   as integer          no-undo.
      718   define output parameter p-success       as logical          no-undo.
      719   do
      720   on error undo, return error
      721   :
      722       assign
      723           p-output-integer = integer( p-input-string )
      724       no-error.
      725       if error-status :error
      726       then do:
      727           assign
      728               p-success           = no
      729               p-output-integer    = 0
      730           .
      731       end.
      732       else do:
      733           assign
      734               p-success           = yes
      735           .
      736       end.
      737   end.
      738   end.
      739   define variable v-bgelib-bgeclall           as logical      no-undo.
      740   define variable v-bgelib-bgedict            as logical      no-undo.
      741   define temp-table temp_ext-doc-type no-undo
      742       field edt-key               as integer
      743       field ext-doc-type          as character
      744       field ext-doc-type-label    as character
      745       index pi is primary unique
      746           edt-key
      747   .
      748   define temp-table temp_bgelib_goods no-undo
      749       field gds-code as integer
      750       index pi is primary unique
      751           gds-code
      752   .
      753   define temp-table temp_bgelib_clients no-undo
      754       field obj-type as character
      755       field obj-code as integer
      756       index pi is primary unique
      757           obj-type
      758           obj-code
      759   .
      760   define temp-table temp_bgelib_dis-card no-undo
      761       field d-card as character
      762       index pi is primary unique
      763           d-card
      764   .
      765   define temp-table temp_bgelib_trn-doc no-undo
      766       field doc-code as integer
      767   .
      768   procedure bgelib-tag-open:
      769   do
      770   on error undo, return error
      771   :
      772   define input parameter v-tag-level  as integer      no-undo.
      773   define input parameter v-tag-name   as character    no-undo.
      774   define input parameter v-tag-value  as character    no-undo.
      775       put stream stmXMLOut unformatted
      776           chr(10)
      777           + fill(" ", 4 * v-tag-level)
      778           + "<" + v-tag-name
      779           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      780           + v-tag-value + ">"
      781       .
      782   end.
      783   end procedure.
      784   procedure bgelib-tag-put:
      785   do
      786   on error undo, return error
      787   :
      788   define input parameter v-tag-level      as integer      no-undo.
      789   define input parameter v-tag-name       as character    no-undo.
      790   define input parameter v-tag-value      as character    no-undo.
      791   define input parameter v-empty-mode     as integer      no-undo.
      792       v-tag-name = trim(v-tag-name).
      793       if  v-empty-mode = 1
      794       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      795       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      796       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      797       then do:
      798           run xmlchar-encode in this-procedure (
      799                 input v-tag-value
      800               , output v-tag-value
      801           ).
      802           put stream stmXMLOut unformatted
      803               chr(10) + fill(" ", 4 * v-tag-level)
      804                           + '<' + v-tag-name + '>'
      805                           + v-tag-value
      806                           + '</' + v-tag-name + '>'
      807           .
      808       end.
      809   end.
      810   end procedure.
      811   procedure bgelib-tag-close:
      812   do
      813   on error undo, return error
      814   :
      815   define input parameter v-tag-level as integer      no-undo.
      816   define input parameter v-tag-name  as character    no-undo.
      817       put stream stmXMLOut unformatted
      818           chr(10)
      819           + fill( " ", 4 * v-tag-level)
      820           + '</' + v-tag-name + '>'
      821       .
      822   end.
      823   end procedure.
      824   procedure bgelib-write-log:
      825   do
      826   on error undo, return error
      827   :
      828   define input parameter v-filename   as character    no-undo.
      829   define input parameter v-log-level  as integer      no-undo.
      830   define input parameter v-out-string as character    no-undo.
      831       output stream stmXMLLog to value( v-filename ) append.
      832       put stream stmXMLLog unformatted
      833           chr(10)
      834       .
      835       put stream stmXMLLog unformatted
      836           ( if v-log-level = 0
      837             or v-out-string = "&DLine"
      838             or v-out-string = "&Line"
      839             then ""
      840             else cur-time-string-sec() + " " )
      841       .
      842       put stream stmXMLLog unformatted
      843           ( if v-out-string = "&Line"
      844             then fill( "-", 80 )
      845             else if v-out-string = "&DLine"
      846                  then fill( "=", 80 )
      847                  else v-out-string )
      848       .
      849       output stream stmXMLLog close.
      850   end.
      851   end procedure.
      852   procedure bgelib-write-edt:
      853   do
      854   on error undo, return error
      855   :
      856   define input parameter v-editor-handle    as handle       no-undo.
      857   define input parameter v-log-level        as integer      no-undo.
      858   define input parameter v-out-string       as character    no-undo.
      859       if valid-handle ( v-editor-handle )
      860       then do:
      861           v-editor-handle :move-to-eof().
      862           v-editor-handle :insert-string( ( if v-log-level = 0
      863                                             or v-out-string = "&DLine"
      864                                             or v-out-string = "&Line"
      865                                             then ""
      866                                             else cur-time-string-sec() + " "
      867                                         ) ).
      868           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      869                                             then fill( "-", 80 )
      870                                             else if v-out-string = "&DLine" then fill("=", 80)
      871                                             else fill( " ", v-log-level) + v-out-string
      872                                         ) ).
      873           v-editor-handle :insert-string( chr(10) ).
      874       end.
      875       process events.
      876       output to 'bgescn.txt' append.
      877           put unformatted
      878               chr(10)
      879               string( ( if v-log-level = 0
      880                         or v-out-string = "&DLine"
      881                         or v-out-string = "&Line"
      882                         then ""
      883                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      884                     ) )
      885               string( ( if v-out-string = "&Line"
      886                         then fill( "-", 80 )
      887                         else if v-out-string = "&DLine"
      888                              then fill( "=", 80 )
      889                              else fill( " ", v-log-level ) + v-out-string
      890                     ) )
      891           .
      892       output close.
      893   end.
      894   end procedure.
      895   procedure bgelib-show-cnt:
      896   do
      897   on error undo, return error
      898   :
      899   define input parameter v-fillin-handle     as handle   no-undo.
      900       if valid-handle( v-fillin-handle )
      901       then do:
      902           assign
      903               v-fillin-handle :visible = true
      904           .
      905       end.
      906   end.
      907   end procedure.
      908   procedure bgelib-hide-cnt:
      909   do
      910   on error undo, return error
      911   :
      912   define input parameter v-fillin-handle     as handle   no-undo.
      913       if valid-handle( v-fillin-handle )
      914       then do:
      915           assign v-fillin-handle :visible = false.
      916       end.
      917   end.
      918   end procedure.
      919   procedure bgelib-write-cnt:
      920   do
      921   on error undo, return error
      922   :
      923   define input parameter v-fillin-handle    as handle       no-undo.
      924   define input parameter v-fillin-string    as character    no-undo.
      925       if valid-handle( v-fillin-handle )
      926       then do:
      927           assign
      928               v-fillin-handle :SCREEN-value = v-fillin-string
      929           .
      930       end.
      931   end.
      932   end procedure.
      933   procedure bgelib-write-header:
      934   do
      935   on error undo, return error
      936   :
      937   define input parameter p-first-file     as logical      no-undo.
      938   define input parameter p-xml-file-name  as character    no-undo.
      939   define input parameter p-list-file-name as character    no-undo.
      940   define input parameter p-file-number    as integer      no-undo.
      941   define input parameter p-have-prev      as logical      no-undo.
      942   define input parameter p-prev-filename  as character    no-undo.
      943   define input parameter p-obj-list       as character    no-undo.
      944   define input parameter p-doc-type-list  as character    no-undo.
      945   define input parameter p-parameter-list as character    no-undo.
      946       define variable v-counter    as integer        no-undo.
      947       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      948       put stream stmXMLOut unformatted
      949           "<?xml version='1.0' encoding='windows-1251'?>"
      950       .
      951       run bgelib-tag-open( input 0, input "root"  , input "" ).
      952       run bgelib-tag-open( input 0, input "header", input "" ).
      953       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      954       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      955       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      956       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      957       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      958       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      959       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      960       :
      961           run bgelib-tag-put(
      962                 input 1
      963               , input entry( 2 * v-counter, p-parameter-list )
      964               , input entry( 2 * v-counter + 1, p-parameter-list )
      965               , input 0
      966           ).
      967       end.
      968       run bgelib-tag-close( input 0, input "header" ).
      969       output stream stmXMLOut close.
      970       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      971       if p-first-file = yes
      972       then do:
      973           put stream stmXMLOut unformatted
      974               "<?xml version='1.0' encoding='windows-1251'?>"
      975           .
      976           run bgelib-tag-open( input 0, input "export", input "" ).
      977       end.
      978       run bgelib-tag-open( input 1, input "file", input "" ).
      979       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      980       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      981       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      982       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
      983       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
      984       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      985       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      986       :
      987           run bgelib-tag-put(
      988                 input 2
      989               , input trim(entry( 2 * v-counter, p-parameter-list ))
      990               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
      991               , input 0
      992           ).
      993       end.
      994       run bgelib-tag-close( input 1, input "file" ).
      995       output stream stmXMLOut close.
      996   end.
      997   end procedure.
      998   procedure bgelib-write-footer:
      999   do
     1000   on error undo, return error
     1001   :
     1002   define input parameter p-last-file      as logical      no-undo.
     1003   define input parameter p-xml-file-name  as character    no-undo.
     1004   define input parameter p-list-file-name as character    no-undo.
     1005   define input parameter p-have-next      as logical      no-undo.
     1006   define input parameter p-next-file-name as character    no-undo.
     1007       define variable v-error-num     as integer           no-undo.
     1008       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1009       if p-have-next = yes
     1010       then do:
     1011           run bgelib-tag-open( input 0, input "footer", "" ).
     1012           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1013           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1014           run bgelib-tag-close( input 0, input "footer" ).
     1015       end.
     1016       run bgelib-tag-close( input 0, input "root" ).
     1017       output stream stmXMLOut close.
     1018       run bge/os_copy.p (
     1019             input "M"
     1020           , input p-xml-file-name + "tmp"
     1021           , input p-xml-file-name + "xml"
     1022           , output v-error-num
     1023       ).
     1024       if p-last-file = yes
     1025       then do:
     1026           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1027               run bgelib-tag-close( input 0, input "export" ).
     1028           output stream stmXMLOut close.
     1029           run bge/os_copy.p (
     1030                 input "M"
     1031               , input p-list-file-name + "tmp"
     1032               , input p-list-file-name + "xml"
     1033               , output v-error-num
     1034           ).
     1035       end.
     1036   end.
     1037   end procedure.
     1038   procedure bgelib-filename :
     1039   do
     1040   on error undo, return error
     1041   :
     1042   define input parameter p-prefix             as character    no-undo.
     1043   define output parameter p-xml-file-name     as character    no-undo.
     1044   define output parameter p-log-file-name     as character    no-undo.
     1045   define output parameter p-list-file-name    as character    no-undo.
     1046       define variable v-home-dir  as character    no-undo.
     1047       define variable v-error-num as integer      no-undo.
     1048       get-key-value section "BGE" key "outdir" value v-home-dir.
     1049       if v-home-dir = ?
     1050       then do:
     1051           message
     1052             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1053             skip(1)
     1054             skip "Обратитесь к администратору."
     1055           view-as alert-box error.
     1056           undo, return error .
     1057       end.
     1058       run gbl/dir-cre.p (
     1059           input v-home-dir
     1060       ) no-error.
     1061       if error-status :error
     1062       then do:
     1063           message
     1064             skip "Неверно задан каталог экспорта."
     1065             skip(1)
     1066             skip "Обратитесь к администратору."
     1067           view-as alert-box error.
     1068           undo, return error .
     1069       end.
     1070       run bge/genfname.p (
     1071             input v-home-dir
     1072           , input p-prefix
     1073           , input ""
     1074           , input "xml"
     1075           , input "tmp"
     1076           , output p-xml-file-name
     1077       ).
     1078       assign
     1079           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1080           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1081           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1082       .
     1083   end.
     1084   end procedure.
     1085   procedure bgelib-read-config :
     1086   do
     1087   on error undo, return error
     1088   :
     1089   define variable v-par-type as character     no-undo.
     1090     define variable v-param-type      as character  no-undo .
     1091     define variable v-value-character as character  no-undo .
     1092     define variable v-value-date      as date       no-undo .
     1093     define variable v-value-decimal   as decimal    no-undo .
     1094     define variable v-value-integer   as integer    no-undo .
     1095     define variable v-value-logical   as logical    no-undo .
     1096     define variable v-tth             as handle     no-undo .
     1097       assign
     1098           v-bgelib-bgeclall = no
     1099           v-bgelib-bgedict  = no
     1100       .
     1101       run adm/shattri.p ( input "get":U
     1102                         , input  '':u
     1103                         , input  0
     1104                         , input  'bge-export':U
     1105                         , input  'bgeclall':U
     1106                         , output v-value-character
     1107                         , output v-value-date
     1108                         , output v-value-decimal
     1109                         , output v-value-integer
     1110                         , output v-value-logical
     1111                         , output v-param-type
     1112                         , input-output table-handle v-tth
     1113                         ) no-error .
     1114       if error-status :error
     1115       then do:
     1116         assign
     1117           v-bgelib-bgeclall = no
     1118         .
     1119       end.
     1120       else do:
     1121         assign
     1122           v-bgelib-bgeclall = v-value-logical
     1123         .
     1124       end.
     1125       delete object v-tth.
     1126       run adm/shattri.p ( input "get":U
     1127                         , input  '':u
     1128                         , input  0
     1129                         , input  'bge-export':U
     1130                         , input  'bgedict':U
     1131                         , output v-value-character
     1132                         , output v-value-date
     1133                         , output v-value-decimal
     1134                         , output v-value-integer
     1135                         , output v-value-logical
     1136                         , output v-param-type
     1137                         , input-output table-handle v-tth
     1138                         ) no-error .
     1139       if error-status :error
     1140       then do:
     1141         assign
     1142           v-bgelib-bgedict = no
     1143         .
     1144       end.
     1145       else do:
     1146         assign
     1147           v-bgelib-bgedict = v-value-logical
     1148         .
     1149       end.
     1150       delete object v-tth.
     1151       run adm/shattri.p ( input "get":U
     1152                         , input  '':u
     1153                         , input  0
     1154                         , input  'bge-export':U
     1155                         , input  'bgefmt':U
     1156                         , output v-value-character
     1157                         , output v-value-date
     1158                         , output v-value-decimal
     1159                         , output v-value-integer
     1160                         , output v-value-logical
     1161                         , output v-param-type
     1162                         , input-output table-handle v-tth
     1163                         ) no-error .
     1164       if error-status :error
     1165       then do:
     1166         assign
     1167           v-bgelib-bgefmt  = "xml":U
     1168         .
     1169       end.
     1170       else do:
     1171         assign
     1172           v-bgelib-bgefmt  = v-value-character
     1173         .
     1174       end.
     1175       delete object v-tth.
     1176       run adm/shattri.p ( input "get":U
     1177                         , input  '':u
     1178                         , input  0
     1179                         , input  'bge-export':U
     1180                         , input  'bgeflold':U
     1181                         , output v-value-character
     1182                         , output v-value-date
     1183                         , output v-value-decimal
     1184                         , output v-value-integer
     1185                         , output v-value-logical
     1186                         , output v-param-type
     1187                         , input-output table-handle v-tth
     1188                         ) no-error .
     1189       if error-status :error
     1190       then do:
     1191         assign
     1192           v-bgelib-bgeflold  = "old":U
     1193         .
     1194       end.
     1195       else do:
     1196         assign
     1197           v-bgelib-bgeflold  = v-value-character
     1198         .
     1199       end.
     1200       delete object v-tth.
     1201   end.
     1202   end procedure.
     1203   procedure bgelib-check-file-size :
     1204   do
     1205   on error undo, return error
     1206   :
     1207   define input parameter p-out-filename   as character    no-undo.
     1208   define output parameter p-is-big        as logical      no-undo.
     1209       define variable v-current-position    as integer        no-undo.
     1210       assign
     1211           v-current-position = seek( stmXMLOut )
     1212       .
     1213       if v-current-position / 1024 / 1024  >= 100
     1214       then do:
     1215           assign
     1216               p-is-big = yes
     1217           .
     1218       end.
     1219   end.
     1220   end procedure.
     1221   procedure bgelib-init-ext-doc-type :
     1222       define variable v-counter    as integer      no-undo.
     1223       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1224   do
     1225   for buf_temp_ext-doc-type
     1226   on error undo, return error
     1227   :
     1228       empty temp-table buf_temp_ext-doc-type.
     1229       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1230       :
     1231           create buf_temp_ext-doc-type.
     1232           assign
     1233               buf_temp_ext-doc-type.edt-key               = v-counter
     1234               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1235               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1236           .
     1237       end.
     1238   end.
     1239   end procedure.
     1240   procedure proc-alt-shift-f2:
     1241     if not ibs.th.gbl.gbl-var:rcode
     1242   then
     1243     run gbl\inidebug.p .
     1244   end.
     1245   procedure proc-alt-shift-f3:
     1246     run gbl/prvssinf.p
     1247       ( input this-procedure
     1248       ) .
     1249   end.
     1250   define variable v-inform-launched as logical no-undo initial false .
     1251   procedure proc-alt-shift-f4:
     1252     define variable v-action as character no-undo .
     1253     if v-inform-launched = false then do:
     1254       assign
     1255         v-inform-launched = true
     1256       .
     1257       run gbl/d-inform.w
     1258         (  input self
     1259         ,  input this-procedure
     1260         , output v-action
     1261         ) no-error .
     1262       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1263       assign
     1264         v-inform-launched = false
     1265       .
     1266     end.
     1267   end.
     1268   procedure proc-alt-f1:
     1269     run gbl/corrhelp.p
     1270       (input this-procedure
     1271       ) .
     1272   end .
     1273   on alt-shift-f2 anywhere do:
     1274     run proc-alt-shift-f2.
     1275   end.
     1276   on alt-shift-f3 anywhere do:
     1277     run proc-alt-shift-f3 in this-procedure .
     1278   end.
     1279   on alt-shift-f4 anywhere do:
     1280     run proc-alt-shift-f4 in this-procedure.
     1281   end.
     1282   on alt-f1 anywhere do:
     1283     run proc-alt-f1 in this-procedure .
     1284   end.
     1285   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1286     define variable v-cntxt-db-num        as integer   no-undo .
     1287     define variable v-cntxt-userid        as character no-undo .
     1288     define variable v-cntxt-level         as character no-undo .
     1289     define variable v-cntxt-host-code-obj as integer   no-undo .
     1290     define variable v-cntxt-obj-type      as character no-undo .
     1291     define variable v-cntxt-obj-code      as integer   no-undo .
     1292     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1293     define variable v-cntxt-is-admin      as logical   no-undo .
     1294   define variable v-bge-isbgeold          as logical      no-undo.
     1295   define variable v-bge-host-code         as integer      no-undo.
     1296   define variable v-bge-editor-handle     as handle       no-undo.
     1297   define variable v-bge-fillin-handle     as handle       no-undo.
     1298   define variable v-bge-shift-mode        as logical      no-undo.
     1299   define variable v-bge-format-dbf        as logical      no-undo.
     1300   define variable v-host-code             as integer      no-undo.
     1301   define variable v-pay-type-list         as character    no-undo.
     1302   def var go-ahead as logical no-undo.
     1303   define BUTton Btn_OK AUto-end-KEY
     1304        LABEL "OK"
     1305        SIZE 10 BY 1.13
     1306        BGCOLor 8 .
     1307   define variable EDT-LOG as character
     1308        view-as EDItor SCROLLBAR-VERTICAL no-WorD-WRAP LARGE
     1309        SIZE 82.88 BY 15.67 no-undo.
     1310   define variable DLG-COUNTER as character format "X(65)":U
     1311        view-as text
     1312        SIZE 65.00 BY 1.17
     1313        FGCOLor 9  no-undo.
     1314   define frame DLG-LOG
     1315        DLG-COUNTER at ROW 1.04 COL 11.00 colon-aligned no-label
     1316        Btn_OK at ROW 1.08 COL 1.75
     1317        EDT-LOG at ROW 2.38 COL 1.5 no-label
     1318        space(0.36) skip(0.15)
     1319       with view-as DIALOG-BOX KEEP-TAB-orDER
     1320            SIDE-LABELS no-UNDERLinE THREE-D  SCROLLABLE
     1321            TITLE "Экспорт XML"
     1322            defAULT-BUTton Btn_OK.
     1323   assign
     1324          frame DLG-LOG:SCROLLABLE       = false
     1325          frame DLG-LOG:HIDDEN           = true.
     1326   assign
     1327          EDT-LOG:READ-onLY in frame DLG-LOG        = true
     1328   .
     1329   on WindoW-close OF frame DLG-LOG
     1330   do:
     1331     APPLY "end-error":U to SELF.
     1332   end.
     1333   if VALID-handle(ACTIVE-WindoW) and frame DLG-LOG:PARENT eq ?
     1334   then frame DLG-LOG:PARENT = ACTIVE-WindoW.
     1335   MAin-BLOCK:
     1336   do on error   undo MAin-BLOCK, leave MAin-BLOCK
     1337      on end-key undo MAin-BLOCK, leave MAin-BLOCK:
     1338   define variable v-par-value     as character      no-undo.
     1339   define variable v-par-type      as character      no-undo.
     1340   define variable v-param-type      as character  no-undo .
     1341   define variable v-value-character as character  no-undo .
     1342   define variable v-value-date      as date       no-undo .
     1343   define variable v-value-decimal   as decimal    no-undo .
     1344   define variable v-value-integer   as integer    no-undo .
     1345   define variable v-value-logical   as logical    no-undo .
     1346   define variable v-tth             as handle     no-undo .
     1347   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1348     run mainmenu_getcntxt in parparentproc
     1349       (output v-cntxt-db-num
     1350       ,output v-cntxt-userid
     1351       ,output v-cntxt-level
     1352       ,output v-cntxt-host-code-obj
     1353       ,output v-cntxt-obj-type
     1354       ,output v-cntxt-obj-code
     1355       ,output v-cntxt-db-num-obj
     1356       ,output v-cntxt-is-admin
     1357       ) .
     1358   assign
     1359       v-bge-isbgeold  = ( p-format-type = "tree":U )
     1360       v-bge-host-code = v-cntxt-host-code-obj
     1361   .
     1362   run bgelib-read-config in this-procedure .
     1363   assign
     1364       v-bge-editor-handle = EDT-LOG :handle
     1365   in frame DLG-LOG.
     1366   assign
     1367       v-bge-fillin-handle = DLG-COUNTER :handle
     1368   in frame DLG-LOG.
     1369   run adm/shattri.p ( input "get":U
     1370                     , input  '':u
     1371                     , input  0
     1372                     , input  'bge-export':U
     1373                     , input  'bgeshift':U
     1374                     , output v-value-character
     1375                     , output v-value-date
     1376                     , output v-value-decimal
     1377                     , output v-value-integer
     1378                     , output v-value-logical
     1379                     , output v-param-type
     1380                     , input-output table-handle v-tth
     1381                     ) no-error .
     1382   if error-status :error
     1383   then do:
     1384     assign
     1385         v-bge-shift-mode = no
     1386     .
     1387   end.
     1388   else do:
     1389     assign
     1390         v-bge-shift-mode = ( v-value-character = "distinct":U )
     1391     .
     1392   end.
     1393   delete object v-tth.
     1394   run adm/shattri.p ( input "get":U
     1395                     , input  '':u
     1396                     , input  0
     1397                     , input  'bge-export':U
     1398                     , input  'bgefmt':U
     1399                     , output v-value-character
     1400                     , output v-value-date
     1401                     , output v-value-decimal
     1402                     , output v-value-integer
     1403                     , output v-value-logical
     1404                     , output v-param-type
     1405                     , input-output table-handle v-tth
     1406                     ) no-error .
     1407   if error-status :error
     1408   then do:
     1409     assign
     1410         v-bge-format-dbf = no
     1411     .
     1412   end.
     1413   else do:
     1414     assign
     1415         v-bge-format-dbf = ( v-value-character = "dbf":U )
     1416     .
     1417   end.
     1418   delete object v-tth.
     1419   case p-export-type:
     1420       when 'ALL-DOC-REF'
     1421       then do:
     1422       end.
     1423       when 'ALL-DAY-WAY'
     1424       then do:
     1425       end.
     1426       when 'DOC'
     1427       then do:
     1428       end.
     1429       when 'SHIFT'
     1430       then do:
     1431       end.
     1432       when 'FINDOC'
     1433       then do:
     1434       end.
     1435       when 'FIN-OB'
     1436       then do:
     1437       end.
     1438       when 'CONTRACT'
     1439       then do:
     1440       end.
     1441       when 'SCHET-FACTUR'
     1442       then do:
     1443       end.
     1444       when 'STK'
     1445       then do:
     1446       end.
     1447       when 'STD'
     1448       then do:
     1449       end.
     1450       when 'STT'
     1451       then do:
     1452       end.
     1453       when 'PRC'
     1454       then do:
     1455       end.
     1456       when 'DAY'
     1457       then do:
     1458       end.
     1459       when 'WAY'
     1460       then do:
     1461                   message       "Экспортировать данные по товарам в пути? Операция может занять много времени"     view-as alert-box question     buttons yes-no     title "Экспорт XML"     update go-ahead.
     1462           if go-ahead = no
     1463           then do:
     1464               undo, return no-apply.
     1465           end.
     1466       end.
     1467       when 'KASS'
     1468       then do:
     1469       end.
     1470       when 'REF'
     1471       then do:
     1472                   message       "Экспортировать справочники? Операция может занять много времени"     view-as alert-box question     buttons yes-no     title "Экспорт XML"     update go-ahead.
     1473           if go-ahead = no
     1474           then do:
     1475               undo, return no-apply.
     1476           end.
     1477       end.
     1478       when 'CARD'
     1479       then do:
     1480               message       "Экспортировать данные продаж по дисконтным картам? Операция может занять много времени"     view-as alert-box question     buttons yes-no     title "Экспорт XML"     update go-ahead.
     1481         if go-ahead = no
     1482         then do:
     1483           return.
     1484         end.
     1485       end.
     1486       otherwise do:
     1487           if entry( 1, p-export-type ) <> "util"
     1488           then do:
     1489               message
     1490                   "Неверный параметр вызова программы экспорта bge.p"
     1491               view-as alert-box.
     1492               return.
     1493           end.
     1494       end.
     1495   end case.
     1496     run enable_UI.
     1497     run start-bge.
     1498     WAIT-for GO OF frame DLG-LOG.
     1499   end.
     1500   run disable_UI.
     1501   procedure disable_UI :
     1502     hide frame DLG-LOG.
     1503   end procedure.
     1504   procedure enable_UI :
     1505     display DLG-COUNTER EDT-LOG
     1506         with frame DLG-LOG.
     1507     enable DLG-COUNTER Btn_OK EDT-LOG
     1508         with frame DLG-LOG.
     1509     view frame DLG-LOG.
     1510     assign DLG-COUNTER :visible = false.
     1511   end procedure.
     1512   procedure start-bge:
     1513   do
     1514   on error undo, return error
     1515   :
     1516   define variable v-date-from         as date             no-undo.
     1517   define variable v-shift-num-from    as integer          no-undo.
     1518   define variable v-date-to           as date             no-undo.
     1519   define variable v-shift-num-to      as integer          no-undo.
     1520   define variable v-range             as integer          no-undo.
     1521   define variable v-obj-list          as character        no-undo.
     1522   define variable v-pay-code          as logical          no-undo.
     1523   define variable v-doc-type-list     as character        no-undo.
     1524   define variable v-cst               as logical          no-undo.
     1525   define variable v-parts             as logical          no-undo.
     1526   define variable v-chk-pay-code      as logical          no-undo.
     1527   define variable v-pay-desk          as logical          no-undo.
     1528   define variable v-pay-desk-cards    as logical          no-undo.
     1529   define variable v-deleted           as logical          no-undo.
     1530   define variable v-count             as integer          no-undo.
     1531   define variable v-list-item         as character        no-undo.
     1532   define variable v-cancel            as logical          no-undo.
     1533   case p-export-type:
     1534       when "ALL-DOC-REF":U
     1535       then do:
     1536           run bgelib-write-edt in this-procedure (
     1537                 input v-bge-editor-handle
     1538               , input 1
     1539               , input "Экспорт документов и справочников..."
     1540           ).
     1541           if v-bge-shift-mode = yes
     1542           and v-bgelib-bgefmt = "xml":U
     1543           then do:
     1544               run export-docs-shifts in this-procedure (
     1545                   input no
     1546               ).
     1547           end.
     1548           else do:
     1549               run export-docs-no-shifts in this-procedure (
     1550                     input no
     1551               ).
     1552           end.
     1553           run export-refs in this-procedure.
     1554           run bgelib-write-edt in this-procedure ( v-bge-editor-handle, 1, "Экспорт документов и справочников завершён." ).
     1555       end.
     1556       when "ALL-DAY-WAY":U
     1557       then do:
     1558           run bgelib-write-edt in this-procedure ( v-bge-editor-handle, 1, "Экспорт данных по товарам по дням и по товарам в пути..." ).
     1559           run export-day in this-procedure.
     1560           run export-way in this-procedure.
     1561           run bgelib-write-edt in this-procedure ( v-bge-editor-handle, 1, "Экспорт данных по товарам по дням и по товарам в пути завершён.").
     1562       end.
     1563       when "SHIFT":U
     1564       then do:
     1565           run export-shift in this-procedure.
     1566       end.
     1567       when "DOC":U
     1568       then do:
     1569           if v-bge-shift-mode = yes
     1570           and v-bgelib-bgefmt = "xml":U
     1571           then do:
     1572               run export-docs-shifts in this-procedure (
     1573                   input no
     1574               ).
     1575           end.
     1576           else do:
     1577               run export-docs-no-shifts in this-procedure (
     1578                   input no
     1579               ).
     1580           end.
     1581       end.
     1582       when "STK":U
     1583       then do:
     1584           run export-stk in this-procedure (
     1585                 input 2
     1586               , input yes
     1587           ).
     1588       end.
     1589       when "STD":U
     1590       then do:
     1591           run export-std in this-procedure.
     1592       end.
     1593       when "STT":U
     1594       then do:
     1595           run export-stt in this-procedure.
     1596       end.
     1597       when "PRC":U
     1598       then do:
     1599           run export-prc in this-procedure.
     1600       end.
     1601     when "DAY":U
     1602     then do:
     1603           run export-day in this-procedure.
     1604     end.
     1605     when "WAY":U
     1606     then do:
     1607       run export-way in this-procedure.
     1608     end.
     1609     when "KASS":U
     1610     then do:
     1611       run export-kass in this-procedure (
     1612           input 0
     1613       ).
     1614     end.
     1615     when "REF":U
     1616     then do:
     1617       run export-refs in this-procedure.
     1618     end.
     1619     when "CARD":U
     1620     then do:
     1621       run export-card in this-procedure .
     1622     end.
     1623     when "FINDOC":U
     1624     then do:
     1625       run export-findoc in this-procedure.
     1626     END.
     1627     when "FIN-OB":U
     1628     then do:
     1629       run export-fin-ob in this-procedure.
     1630     END.
     1631     when "CONTRACT":U
     1632     then do:
     1633       run export-contract in this-procedure.
     1634     END.
     1635     when "SCHET-FACTUR":U
     1636     then do:
     1637       run export-schet-factur in this-procedure.
     1638     end.
     1639     OTHERWISE do:
     1640       if entry( 1, p-export-type ) <> "util":U
     1641       then do:
     1642           run bgelib-write-edt in this-procedure ( v-bge-editor-handle, 1, "Неверный параметр " + p-export-type + " в вызове процедуры" + vss-description).
     1643       end.
     1644       else do:
     1645           if entry( 2, p-export-type ) = "g-expie":U
     1646           then do:
     1647               if v-bge-shift-mode = yes
     1648               and v-bgelib-bgefmt = "xml":U
     1649               then do:
     1650                   run export-docs-shifts in this-procedure (
     1651                       input yes
     1652                   ).
     1653               end.
     1654               else do:
     1655                   run export-docs-no-shifts in this-procedure (
     1656                       input yes
     1657                   ).
     1658               end.
     1659           end.
     1660           else do:
     1661               do v-count = 2 to num-entries( p-export-type )
     1662               :
     1663                   case entry( v-count, p-export-type )
     1664                   :
     1665                       when "1"
     1666                       then do:
     1667                           run export-refs in this-procedure.
     1668                       end.
     1669                       when "2"
     1670                       then do:
     1671                           if v-bge-shift-mode = yes
     1672                           and v-bgelib-bgefmt = "xml":U
     1673                           then do:
     1674                               run export-docs-shifts in this-procedure (
     1675                                   input no
     1676                               ).
     1677                           end.
     1678                           else do:
     1679                               run export-docs-no-shifts in this-procedure (
     1680                                   input no
     1681                               ).
     1682                           end.
     1683                       end.
     1684                       when "3"
     1685                       then do:
     1686                           run export-kass in this-procedure (
     1687                               input 1
     1688                           ).
     1689                       end.
     1690                       when "4"
     1691                       then do:
     1692                           run export-stk in this-procedure (
     1693                                 input 1
     1694                               , input no
     1695                           ).
     1696                       end.
     1697                       when "5"
     1698                       then do:
     1699                           run export-day in this-procedure .
     1700                       end.
     1701                       when "6"
     1702                       then do:
     1703                           run export-way in this-procedure.
     1704                       end.
     1705                       otherwise do:
     1706                           run bgelib-write-edt in this-procedure ( v-bge-editor-handle, 1, "Ошибка выбора типа экспорта ..." ).
     1707                       end.
     1708                   end case.
     1709               end.
     1710           end.
     1711       end.
     1712     end.
     1713   end case.
     1714   enable
     1715       Btn_Ok
     1716       EDT-LOG
     1717   with frame DLG-LOG.
     1718   end.
     1719   end procedure.
     1720   PROCEDURE export-docs-no-shifts :
     1721   define input parameter p-need-opened-docs   as logical          no-undo.
     1722       define variable v-date-from         as date         no-undo.
     1723       define variable v-shift-num-from    as integer      no-undo.
     1724       define variable v-date-to           as date         no-undo.
     1725       define variable v-shift-num-to      as integer      no-undo.
     1726       define variable v-shift-on          as logical      no-undo.
     1727       define variable v-range             as integer      no-undo.
     1728       define variable v-obj-list          as character    no-undo.
     1729       define variable v-pay-code          as logical      no-undo.
     1730       define variable v-doc-type-list     as character    no-undo.
     1731       define variable v-cst               as logical      no-undo.
     1732       define variable v-parts             as logical      no-undo.
     1733       define variable v-chk-pay-code      as logical      no-undo.
     1734       define variable v-pay-desk          as logical      no-undo.
     1735       define variable v-pay-desk-cards    as logical      no-undo.
     1736       define variable v-deleted           as logical      no-undo.
     1737       define variable v-chk               as logical      no-undo.
     1738       define variable v-doc-rvs           as logical      no-undo.
     1739       define variable v-cancel            as logical      no-undo.
     1740   do
     1741   on error undo, return error
     1742   :
     1743       run bge/bge-dper.w (
     1744             input parparentproc
     1745           , input 1
     1746           , input v-doc-type-list
     1747           , output v-date-from
     1748           , output v-date-to
     1749           , output v-range
     1750           , output v-bge-host-code
     1751           , output v-obj-list
     1752           , OUTPUT v-pay-type-list
     1753           , output v-doc-type-list
     1754           , output v-pay-code
     1755           , output v-cst
     1756           , output v-parts
     1757           , output v-chk-pay-code
     1758           , output v-pay-desk
     1759           , output v-pay-desk-cards
     1760           , output v-deleted
     1761           , output v-chk
     1762           , output v-doc-rvs
     1763           , output v-cancel
     1764       ) no-error .
     1765       if error-status :error
     1766       then do:
     1767           message
     1768           vss-workfile vss-revision vss-description
     1769           skip "Ошибка ввода параметров выгрузки документов."
     1770           skip return-value
     1771           skip trim(error-status :get-message(1))
     1772               trim(error-status :get-message(2))
     1773               trim(error-status :get-message(3))
     1774           view-as alert-box error.
     1775           undo, return error .
     1776       end.
     1777       if v-cancel = yes
     1778       then do:
     1779           undo, return error .
     1780       end.
     1781       if v-date-from = ? or v-date-to = ?
     1782       then do:
     1783           return error.
     1784       end.
     1785       run bgelib-write-edt in this-procedure (
     1786             input v-bge-editor-handle
     1787           , input 1
     1788           , input substitute( "Экспорт документов, диапазон дат &1 - &2"
     1789                                   , string( v-date-from, "99.99.99" )
     1790                                   , string( v-date-to, "99.99.99" ) )
     1791       ).
     1792       run bgelib-write-edt in this-procedure (
     1793           input v-bge-editor-handle
     1794           , input 1
     1795           , input substitute( "Диапазон: &1"
     1796                                   , ( if v-range = 1
     1797                                       then " по всем фирмам"
     1798                                       else ( if v-range = 2
     1799                                              then " по всем объектам текущей фирмы"
     1800                                              else " по объектам: " + v-obj-list ) ) )
     1801       ).
     1802       if v-pay-code = yes
     1803       then do:
     1804           run bgelib-write-edt in this-procedure ( v-bge-editor-handle, 1, "По видам оплат" ).
     1805       end.
     1806       if v-cst = yes
     1807       then do:
     1808           run bgelib-write-edt in this-procedure ( v-bge-editor-handle, 1, "Со строкой ГТД в документах" ).
     1809       end.
     1810       if v-parts = yes
     1811       then do:
     1812           run bgelib-write-edt in this-procedure ( v-bge-editor-handle, 1, "По партиям" ).
     1813       end.
     1814       if v-chk-pay-code = yes
     1815       then do:
     1816           run bgelib-write-edt in this-procedure ( v-bge-editor-handle, 1, "По типам кассовых платежей" ).
     1817       end.
