     2288   PROCEDURE export-day :
     2289       define variable v-date-from         as date         no-undo.
     2290       define variable v-shift-num-from    as integer      no-undo.
     2291       define variable v-date-to           as date         no-undo.
     2292       define variable v-shift-num-to      as integer      no-undo.
     2293       define variable v-shift-on          as logical      no-undo.
     2294       define variable v-range             as integer      no-undo.
     2295       define variable v-obj-list          as character    no-undo.
     2296       define variable v-pay-code          as logical      no-undo.
     2297       define variable v-doc-type-list     as character    no-undo.
     2298       define variable v-cst               as logical      no-undo.
     2299       define variable v-parts             as logical      no-undo.
     2300       define variable v-chk-pay-code      as logical      no-undo.
     2301       define variable v-pay-desk          as logical      no-undo.
     2302       define variable v-pay-desk-cards    as logical      no-undo.
     2303       define variable v-deleted           as logical      no-undo.
     2304       define variable v-chk               as logical      no-undo.
     2305       define variable v-doc-rvs           as logical      no-undo.
     2306       define variable v-cancel            as logical      no-undo.
     2307   do
     2308   on error undo, return error
     2309   :
     2310       run bgelib-write-edt in this-procedure ( v-bge-editor-handle, 1, "Экспорт данных по товарам по дням..." ).
     2311       run bge/bge-dper.w (
     2312             input parparentproc
     2313           , input 3
     2314           , input v-doc-type-list
     2315           , output v-date-from
     2316           , output v-date-to
     2317           , output v-range
     2318           , output v-bge-host-code
     2319           , output v-obj-list
     2320           , OUTPUT v-pay-type-list
     2321           , output v-doc-type-list
     2322           , output v-pay-code
     2323           , output v-cst
     2324           , output v-parts
     2325           , output v-chk-pay-code
     2326           , output v-pay-desk
     2327           , output v-pay-desk-cards
     2328           , output v-deleted
     2329           , output v-chk
     2330           , output v-doc-rvs
     2331           , output v-cancel
     2332       ) no-error .
     2333       if error-status :error
