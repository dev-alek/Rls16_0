     2896           , output v-pay-code
     2897           , output v-cst
     2898           , output v-parts
     2899           , output v-chk-pay-code
     2900           , output v-pay-desk
     2901           , output v-pay-desk-cards
     2902           , output v-deleted
     2903           , output v-chk
     2904           , output v-doc-rvs
     2905           , output v-cancel
     2906       ) no-error .
