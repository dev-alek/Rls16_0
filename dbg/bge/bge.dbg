     1828           run bgelib-write-edt in this-procedure ( v-bge-editor-handle, 1, "Удаленные документы" ).
     1829       end.
     1830       if v-chk = yes
     1831       then do:
     1832           run bgelib-write-edt in this-procedure ( v-bge-editor-handle, 1, "Чеки" ).
     1833       end.
     1834       if v-bge-format-dbf = yes
     1835       then do:
     1836           run bge/bge-docd.p (
     1837                 input parparentproc
     1838               , input v-date-from
     1839               , input v-date-to
     1840               , input v-range
     1841               , input v-obj-list
     1842               , input v-doc-type-list
     1843               , input v-pay-code
     1844               , input v-cst
     1845               , input v-parts
     1846               , input v-chk-pay-code
     1847               , input v-pay-desk
