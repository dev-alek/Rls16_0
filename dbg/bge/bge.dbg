     2911             skip "Ошибка ввода параметров выгрузки документов."
     2912             skip return-value
     2913             skip trim(error-status :get-message(1))
     2914                  trim(error-status :get-message(2))
     2915                  trim(error-status :get-message(3))
     2916           view-as alert-box error.
     2917           undo, return error .
     2918       end.
     2919       if v-cancel = yes
