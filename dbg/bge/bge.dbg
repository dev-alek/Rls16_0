     3258   PROCEDURE export-schet-factur :
     3259       define variable v-date-from         as date         no-undo.
     3260       define variable v-date-to           as date         no-undo.
     3261       define variable v-range             as integer      no-undo.
     3262       define variable v-obj-list          as character    no-undo.
     3263       define variable v-cancel            as logical      no-undo.
     3264   do
     3265   on error undo, return error
     3266   :
     3267       run bge/bge-s-f.w (
     3268             input parparentproc
     3269           , output v-date-from
     3270           , output v-date-to
     3271           , output v-range
     3272           , output v-obj-list
     3273           , output v-cancel
     3274       ) no-error .
     3275       if error-status :error
     3276       then do:
     3277           message
     3278             vss-workfile vss-revision vss-description skip "Ошибка ввода параметров выгрузки счетов-фактур." skip return-value
     3279             skip trim(error-status :get-message(1))  trim(error-status :get-message(2)) trim(error-status :get-message(3))
     3280           view-as alert-box error.
     3281           undo, return error .
     3282       end.
     3283       if v-cancel = yes
     3284       then do:
     3285           undo, return error .
     3286       end.
     3287       if v-date-from = ?
     3288       or v-date-to = ?
     3289       then do:
     3290           return error.
     3291       end.
     3292       run bgelib-write-edt in this-procedure (
     3293             input v-bge-editor-handle
     3294           , input 1
     3295           , input substitute( "Экспорт счетов-фактур, диапазон дат &1 - &2"
     3296                               , string(v-date-from, "99.99.99")
     3297                               , string(v-date-to, "99.99.99")    )
     3298       ).
     3299       run bgelib-write-edt in this-procedure (
     3300             input v-bge-editor-handle
     3301           , input 1
     3302           , input "Диапазон:" + ( if v-range = 1 then " по всем фирмам" else (" по фирмам: "  + v-obj-list) )
     3303       ).
     3304       process events.
     3305       run bge/bge-sf.p (
     3306             input parparentproc
     3307           , input v-date-from
     3308           , input v-date-to
     3309           , input v-range
     3310           , input v-obj-list
     3311           , input v-bge-editor-handle
     3312           , input v-bge-fillin-handle
     3313       ) no-error.
     3314       if error-status :error
     3315       then do:
     3316         message
     3317           vss-workfile vss-revision vss-description skip "Ошибка экспорта счетов-фактур" skip return-value
     3318           skip trim(error-status :get-message(1))  trim(error-status :get-message(2)) trim(error-status :get-message(3))
     3319         view-as alert-box error.
     3320         undo, return error .
     3321       end.
     3322       run bgelib-write-edt in this-procedure (
     3323             input v-bge-editor-handle
     3324           , input 1
     3325           , input "Экспорт счетов-фактур завершен."
     3326       ).
     3327   end.
     3328   END PROCEDURE.
