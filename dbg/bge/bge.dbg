      519                       end.
      520                       when chr(5)
      521                       then do:
      522                           assign
      523                               p-out-string = p-out-string + " ":U
      524                           .
      525                       end.
      526                       when chr(6)
      527                       then do:
      528                           assign
      529                               p-out-string = p-out-string + " ":U
      530                           .
      531                       end.
      532                       when chr(7)
      533                       then do:
      534                           assign
      535                               p-out-string = p-out-string + " ":U
      536                           .
      537                       end.
      538                       when chr(8)
      539                       then do:
      540                           assign
      541                               p-out-string = p-out-string + " ":U
      542                           .
      543                       end.
      544                       when chr(9)
      545                       then do:
      546                           assign
      547                               p-out-string = p-out-string + " ":U
