     3009                         ).
     3010       run bgelib-write-edt in this-procedure ( v-bge-editor-handle, 1, "Диапазон:"
     3011                                   + ( if v-range = 1
     3012                                       then " по всем фирмам"
     3013                                       else ( if v-range = 2
     3014                                              then " по всем объектам текущей фирмы"
     3015                                              else " по объектам: " + v-obj-list ) )
     3016                         ).
     3017       if v-bge-isbgeold = yes
