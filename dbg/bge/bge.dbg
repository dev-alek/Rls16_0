     2922       end.
     2923       if v-date-from = ? or v-date-to = ? then return error.
     2924       run bgelib-write-edt in this-procedure ( v-bge-editor-handle, 1, "Экспорт продаж через кассы..."
     2925                                   + ", диапазон дат " + string(v-date-from, "99.99.99")
     2926                                   + " - " + string(v-date-to, "99.99.99")
     2927                                   + " ..."
     2928                         ).
