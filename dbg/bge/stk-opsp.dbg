      990   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
      991                                             INPUT iFlagEmpty AS INTEGER).
      992       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
      993       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
      994           DO:
      995               IF iFlagEmpty = 0                           THEN RETURN "".
      996               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
      997               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
      998               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
      999               ELSE RETURN "".
     1000           END.
     1001       ELSE DO:
     1002           run xmlchar-encode in this-procedure (
     1003                 input sToPlace
     1004               , output sToPlace
     1005           ).
     1006           ASSIGN
     1007               sToPlace = sParName + '="' + sToPlace + '"'
     1008           .
     1009           RETURN sToPlace.
     1010       END.
     1011   END FUNCTION.
     1012   function bge-xml-date returns character
     1013   ( input p-date as date )
     1014   :
     1015     define variable v-date-str as character no-undo .
     1016     run bge-xml-date-to-str in this-procedure ( input   p-date
     1017                                               , output  v-date-str
     1018                                               ) .
     1019     return v-date-str.
     1020   end function.
     1021   function bge-xml-str-date returns character
     1022   ( input p-date-str as character )
     1023   :
     1024     define variable v-date-str as character no-undo .
     1025     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1026                                                   , output  v-date-str
     1027                                                   ) .
     1028     return v-date-str.
     1029   end function.
     1030   function bge-xml-normalize-dec returns decimal
     1031   ( input p-val as decimal )
     1032   :
     1033     return (if p-val = ? then 0 else p-val) .
     1034   end function.
     1035   PROCEDURE wp-XMLTagOpen:
     1036   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1037   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1038   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1039       define variable v-out-string    as character    no-undo.
     1040   do
     1041   on error undo, return error
     1042   :
     1043       if v-bge-xml-bgefmt = "dbf":U
     1044       then do:
     1045       end.
     1046       else do:
     1047           assign
     1048               v-out-string = substitute( "&1&2<&3&4>"
     1049                                       , chr(10)
     1050                                       , fill( " ":U, 4 * iTagLevel)
     1051                                       , sTagName
     1052                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1053                               )
     1054           .
     1055           put stream stmXMLOut unformatted
     1056               v-out-string
     1057           .
     1058       end.
     1059   end.
     1060   END PROCEDURE.
     1061   PROCEDURE wp-XMLTagPut:
     1062     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1063     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1064     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1065     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1066       define variable v-out-string    as character    no-undo.
     1067   do
     1068   on error undo, return error
     1069   :
     1070       if v-bge-xml-bgefmt = "dbf":U
     1071       then do:
     1072           if v-bge-xml-dbf-file-name <> "":U
     1073           then do:
     1074               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1075               export stream stmXMLOut
     1076                   sTagName
     1077                   sParValue
     1078               .
     1079               output stream stmXMLOut close.
     1080           end.
     1081       end.
     1082       else do:
     1083           IF  iFlagEmpty = 1
     1084           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1085           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1086           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1087           THEN DO:
     1088               run xmlchar-encode in this-procedure (
     1089                   input sParValue
     1090                   , output sParValue
     1091               ).
     1092               assign
     1093                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1094                                               , chr(10)
     1095                                               , FILL(" ", 4 * iTagLevel)
     1096                                               , sTagName
     1097                                               , sParValue
     1098                               )
     1099               .
     1100               PUT STREAM stmXMLOut UNFORMATTED
     1101                   v-out-string
     1102               .
     1103           END.
     1104       end.
     1105   end.
     1106   END PROCEDURE.
     1107   PROCEDURE wp-XMLTagClose:
     1108   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1109   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1110       define variable v-out-string    as character    no-undo.
     1111   do
     1112   on error undo, return error
     1113   :
     1114       if v-bge-xml-bgefmt = "dbf":U
     1115       then do:
     1116       end.
     1117       else do:
     1118           assign
     1119               v-out-string = substitute( "&1&2</&3>"
     1120                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1121                                   , fill( " ", 4 * iTagLevel )
     1122                                   , sTagName
     1123                           )
     1124           .
     1125           PUT STREAM stmXMLOut UNFORMATTED
     1126               v-out-string
     1127           .
     1128       end.
     1129   end.
     1130   END PROCEDURE.
     1131   PROCEDURE wp-XMLWriteLog:
     1132     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1133     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1134     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1135   define variable v-str              as character no-undo .
     1136   define variable v-error-append     as logical   no-undo .
     1137   define variable v-error-append-msg as character no-undo .
     1138   assign
     1139     v-str = chr(10)
     1140             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1141             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1142     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1143     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1144     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1145   .
     1146   run bge/bge-log.p (input v-str) no-error .
     1147   if error-status:error then do:
     1148     assign
     1149       v-error-append     = yes
     1150       v-error-append-msg = return-value
     1151     .
     1152   end.
     1153   run gbl/fileapnd.p
     1154     ( input sFileName
     1155     , input v-str
     1156     , input 10
     1157     ) no-error .
     1158   if error-status:error then do:
     1159     assign
     1160       v-error-append     = yes
     1161       v-error-append-msg = substitute( "&1&2&3"
     1162                                       , v-error-append-msg
     1163                                       , chr(10)
     1164                                       , return-value
     1165                                       )
     1166     .
     1167   end.
     1168   if v-error-append
     1169   then do:
     1170     return error substitute( "&1" , v-error-append-msg ) .
     1171   end.
     1172   END PROCEDURE.
     1173   PROCEDURE wp-XMLWriteEDT:
     1174     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1175     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1176     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1177       if valid-handle ( hEDT )
     1178       then do:
     1179           hEDT :move-to-eof().
     1180           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1181                                           OR sToWrite = "&Line") THEN "" ELSE
     1182                                           cur-time-string-sec() + " ").
     1183           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1184                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1185                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1186           hEDT :insert-string(chr(10)).
     1187       end.
     1188       process events.
     1189       output to 'bgescn.txt' append.
     1190           put unformatted
     1191               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1192                                           OR sToWrite = "&Line") THEN "" ELSE
     1193                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1194               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1195                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1196                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1197           .
     1198       output close.
     1199   END PROCEDURE.
     1200   PROCEDURE wp-XMLShowCNT:
     1201     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1202       if valid-handle( hCNT )
     1203       then do:
     1204           ASSIGN hCNT :VISIBLE = TRUE.
     1205       end.
     1206   END PROCEDURE.
     1207   PROCEDURE wp-XMLHideCNT:
     1208     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1209       if valid-handle( hCNT )
     1210       then do:
     1211           ASSIGN hCNT :VISIBLE = FALSE.
     1212       end.
     1213   END PROCEDURE.
     1214   PROCEDURE wp-XMLWriteCNT:
     1215     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1216     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1217       if valid-handle( hCNT )
     1218       then do:
     1219           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1220       end.
     1221   END PROCEDURE.
     1222   procedure bge-xml-write-header:
     1223   do
     1224   on error undo, return error
     1225   :
     1226   define input parameter p-xml-file-name  as character        no-undo.
     1227   define input parameter p-doc-name       as character        no-undo.
     1228   define input parameter p-version        as character        no-undo.
     1229   define input parameter p-db-num         as integer          no-undo.
     1230   define input parameter p-date-from      as date             no-undo.
     1231   define input parameter p-shift-num-from as integer          no-undo.
     1232   define input parameter p-date-to        as date             no-undo.
     1233   define input parameter p-shift-num-to   as integer          no-undo.
     1234   define input parameter p-obj-list       as character        no-undo.
     1235   define input parameter p-doc-type-list  as character        no-undo.
     1236   define input parameter p-pay-code       as logical          no-undo.
     1237   define input parameter p-cst            as logical          no-undo.
     1238   define input parameter p-parts          as logical          no-undo.
     1239   define input parameter p-chk-pay-code   as logical          no-undo.
     1240   define input parameter p-pay-desk       as logical          no-undo.
     1241   define input parameter p-pay-desk-cards as logical          no-undo.
     1242   define input parameter p-deleted        as logical          no-undo.
     1243   define input parameter p-opened-docs    as logical          no-undo.
     1244   define variable v-out-string    as character    no-undo.
     1245   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1246   assign
     1247       v-out-string = substitute( "&1&2&3"
     1248                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1249                           , chr(10)
     1250                           , "<IBS_Trade_House>":U )
     1251   .
     1252   put stream stmXMLOut unformatted
     1253       v-out-string
     1254   .
     1255   run wp-XMLTagOpen(1, "header","").
     1256   if v-bge-xml-bgeflold = "oracle":u
     1257   then do:
     1258     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1259     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1260     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1261     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1262     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1263   end.
     1264   run wp-XMLTagOpen( 2, "manifest", "").
     1265   run wp-XMLTagOpen( 3, "document", "").
     1266   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1267   run wp-XMLTagput( 4, "description", "", 0).
     1268   run wp-XMLTagput( 4, "version", p-version, 0).
     1269   run wp-XMLTagclose( 3, "document" ).
     1270   run wp-XMLTagclose( 2, "manifest" ).
     1271   run wp-XMLTagclose( 1, "header" ).
     1272   run wp-XMLTagOpen(1, "options","").
     1273   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1274   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1275   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1276   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1277   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1278   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1279   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1280   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1281   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1282   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1283   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1284   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1285   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1286   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1287   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1288   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1289   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1290   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1291   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1292   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1293   run wp-XMLTagClose(1, "options").
     1294   run wp-XMLTagOpen( 1, "body", "" ).
     1295   output stream stmXMLOut close.
     1296   end.
     1297   end procedure.
     1298   procedure xml-bge-write-footer:
     1299   do
     1300   on error undo, return error return-value
     1301   :
     1302   define input parameter p-xml-file-name as character    no-undo.
     1303   define variable v-error-num     as integer           no-undo.
     1304   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1305   run wp-XMLTagClose( 1, "body" ).
     1306   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1307   output stream stmXMLOut close.
     1308   if v-bge-xml-bgeflold = "oracle":u
     1309   then do:
     1310     define variable v-tmp-file-name         as character no-undo .
     1311     define variable v-zip-file-name         as character no-undo .
     1312     define variable v-exch-file-name        as character no-undo .
     1313     define variable v-heap-file-name        as character no-undo .
     1314     define variable v-i                     as integer   no-undo .
     1315     define variable v-file-name             as character no-undo .
     1316     define variable v-arc                   as character no-undo .
     1317     define variable v-str                   as character no-undo .
     1318     define variable v-exch-tmp-file-name    as character no-undo .
     1319     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1320     define variable v-bge-xml-exch-dir      as character no-undo .
     1321     define variable v-bge-xml-heap-dir      as character no-undo .
     1322     define variable v-bge-xml-compress-heap as logical   no-undo .
     1323     define variable v-home-dir              as character no-undo .
     1324     define variable v-os-command            as character no-undo .
     1325     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1326     if v-home-dir = ?
     1327     then do:
     1328       undo, return error substitute( "&1&2&3"
     1329                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1330                                     , chr(10)
     1331                                     , "Обратитесь к администратору.":u
     1332                                     ).
     1333     end.
     1334     assign
     1335       v-home-dir = v-home-dir
     1336     .
     1337     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1338     if error-status :error
     1339     then do:
     1340       undo, return error substitute( "&1&2&3"
     1341                                     , "Неверно задан каталог экспорта.":u
     1342                                     , chr(10)
     1343                                     , "Обратитесь к администратору.":u
     1344                                     ).
     1345     end.
     1346     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1347     if v-bge-xml-exch-dir = ?
     1348     then do:
     1349       undo, return error substitute( "&1&2&3"
     1350                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1351                                     , chr(10)
     1352                                     , "Обратитесь к администратору.":u
     1353                                     ).
     1354     end.
     1355     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1356     if error-status :error
     1357     then do:
     1358       undo, return error substitute( "&1&2&3"
     1359                                     , "Неверно задан каталог экспорта (exch).":u
     1360                                     , chr(10)
     1361                                     , "Обратитесь к администратору.":u
     1362                                     ).
     1363     end.
     1364     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1365     if v-bge-xml-heap-dir = ?
     1366     then do:
     1367       undo, return error substitute( "&1&2&3"
     1368                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1369                                     , chr(10)
     1370                                     , "Обратитесь к администратору.":u
     1371                                     ).
     1372     end.
     1373     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1374     if error-status :error
     1375     then do:
     1376       undo, return error substitute( "&1&2&3"
     1377                                     , "Неверно задан каталог экспорта (heap).":u
     1378                                     , chr(10)
     1379                                     , "Обратитесь к администратору.":u
     1380                                     ).
     1381     end.
     1382     get-key-value section "BGE" key "heap-compress" value v-str.
     1383     assign
     1384       v-i = int(v-str)
     1385     no-error .
     1386     if v-i = ? or v-i = 0
     1387     then do:
     1388       assign
     1389         v-bge-xml-compress-heap = no
     1390       .
     1391     end.
     1392     else do:
     1393       assign
     1394         v-bge-xml-compress-heap = yes
     1395       .
     1396     end.
     1397     assign
     1398       v-arc = search( "exe/7za.exe":u )
     1399     .
     1400     if v-arc = ? or v-arc = ""
     1401     then do:
     1402       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1403     end.
     1404     assign
     1405       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1406       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1407       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1408       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1409       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1410       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1411       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1412     .
     1413     run gbl/del-file.p (input v-tmp-file-name) .
     1414     run gbl/del-file.p (input v-zip-file-name) .
     1415     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1416     if v-error-num > 0
     1417     then do:
     1418         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1419                                      , p-xml-file-name + "xm1":u
     1420                                      , v-tmp-file-name
     1421                                      , v-error-num
     1422                                      ).
     1423     end.
     1424     assign
     1425       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1426                                    , v-arc
     1427                                    , v-zip-file-name
     1428                                    , v-tmp-file-name
     1429                                    )
     1430     .
     1431     os-command silent value ( v-os-command ) .
     1432     run gbl/del-file.p (input v-heap-file-name) .
     1433     if v-bge-xml-compress-heap = no
     1434     then do:
     1435       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1436       if v-error-num > 0
     1437       then do:
     1438           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1439                                        , v-tmp-file-name
     1440                                        , v-heap-file-name
     1441                                        , v-error-num
     1442                                        ) .
     1443       end.
     1444     end.
     1445     else do:
     1446       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1447       if v-error-num > 0
     1448       then do:
     1449           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1450                                        , v-zip-file-name
     1451                                        , v-heap-file-name
     1452                                        , v-error-num
     1453                                        ) .
     1454       end.
     1455     end.
     1456     run gbl/del-file.p (input v-tmp-file-name) .
     1457     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1458     if error-status :error then do:
     1459       undo, return error substitute( "&1&2&3"
     1460                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1461                                     , chr(10)
     1462                                     , "Обратитесь к администратору."
     1463                                     ).
     1464     end.
     1465     run gbl/del-file.p (input v-exch-file-name) .
     1466     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1467     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1468     if v-error-num > 0
     1469     then do:
     1470       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1471                                     , v-zip-file-name
     1472                                     , v-exch-tmp-file-name
     1473                                     , v-error-num
     1474                                     ) .
     1475     end.
     1476     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1477     if v-error-num > 0
     1478     then do:
     1479       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1480                                     , v-exch-tmp-file-name
     1481                                     , v-exch-file-name
     1482                                     , v-error-num
     1483                                     ) .
     1484     end.
     1485     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1486   end.
     1487   else do:
     1488     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1489     if v-error-num > 0
     1490     then do:
     1491       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1492                                     , p-xml-file-name + "xm1"
     1493                                     , p-xml-file-name + "xml"
     1494                                     , v-error-num
     1495                                     ) .
     1496     end.
     1497   end.
     1498   if opsys = "unix"
     1499   then do:
     1500       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1501   end.
     1502   end.
     1503   end procedure.
     1504   procedure xml-bge-filename0:
     1505   define input parameter p-prefix   as character no-undo .
     1506   define input parameter p-name     as character no-undo .
     1507   define input parameter p-shared-process as logical no-undo .
     1508   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1509   define output parameter p-xml-file-name  as character no-undo .
     1510   // define output parameter p-fullfnamenoext as character no-undo .
     1511   define output parameter p-locked         as logical      no-undo.
     1512   define variable v-fullfnamenoext as character no-undo .
     1513   define variable v-fileext        as character no-undo .
     1514   define variable v-fullfname      as character no-undo .
     1515   define variable v-error-num      as integer   no-undo .
     1516   do
     1517   on error undo, return error
     1518   :
     1519     case v-bge-xml-bgeflold :
     1520       when "old" then do:
     1521         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1522         v-fileext       = ".xml":U .
     1523         v-fullfname     = v-fullfnamenoext + v-fileext .
     1524         p-xml-file-name = v-fullfname .
     1525         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1526         if v-error-num > 0 then do:
     1527           return error.
     1528         end.
     1529       end.
     1530       when "var" then do:
     1531         case p-prefix :
     1532           when "doc" then do:
     1533             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1534             v-fileext       = ".xml":U .
     1535             v-fullfname     = v-fullfnamenoext + v-fileext .
     1536             p-xml-file-name = v-fullfname .
     1537           end.
     1538           when "day" then do:
     1539             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1540             v-fileext       = ".xml":U .
     1541             v-fullfname     = v-fullfnamenoext + v-fileext .
     1542             p-xml-file-name = v-fullfname .
     1543           end.
     1544           otherwise do:
     1545             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1546             v-fileext       = ".xml":U .
     1547             v-fullfname     = v-fullfnamenoext + v-fileext .
     1548             p-xml-file-name = v-fullfname .
     1549           end.
     1550         end case.
     1551         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1552         if v-error-num > 0 then do:
     1553           return error.
     1554         end.
     1555       end.
     1556       when "new" then do:
     1557                   run bge/genfname.p (
     1558                       input p-home-dir
     1559                       , input p-prefix
     1560                       , input ""
     1561                       , input "xml"
     1562                       , input ""
     1563                       , output p-xml-file-name
     1564                   ).
     1565       end.
     1566       when "no-parameter" then do:
     1567         if p-shared-process then do:
     1568                       run bge/genfname.p (
     1569                           input p-home-dir
     1570                           , input "d"
     1571                           , input ""
     1572                           , input "xml"
     1573                           , input ""
     1574                           , output p-xml-file-name
     1575                       ).
     1576         end.
     1577         else do:
     1578           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1579           v-fileext       = ".xml":U .
     1580           v-fullfname     = v-fullfnamenoext + v-fileext .
     1581           p-xml-file-name = v-fullfname .
     1582           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1583           if v-error-num > 0 then do:
     1584             return error.
     1585           end.
     1586         end.
     1587       end.
     1588     end case.
     1589     assign
     1590       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1591       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1592     .
     1593   end .
     1594   end procedure .
     1595   procedure xml-bge-filename :
     1596   do
     1597   on error undo, return error
     1598   :
     1599   define input parameter p-prefix             as character    no-undo.
     1600   define input parameter p-name               as character    no-undo.
     1601   define input parameter p-shared-process     as logical      no-undo.
     1602   define output parameter p-xml-file-name     as character    no-undo.
     1603   define output parameter p-log-file-name     as character    no-undo.
     1604   define output parameter p-locked            as logical      no-undo.
     1605   define variable v-home-dir          as character no-undo .
     1606   define variable v-error-num         as integer   no-undo .
     1607   define variable v-bge-xml-heap-dir  as character no-undo .
     1608       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1609       if v-home-dir = ?
     1610       then do:
     1611           message
     1612             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1613             skip(1)
     1614             skip "Обратитесь к администратору."
     1615           view-as alert-box error.
     1616           undo, return error .
     1617       end.
     1618       if v-bge-xml-bgeflold <> "oracle"
     1619       then do:
     1620         assign
     1621             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1622         .
     1623       end.
     1624       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1625       if error-status :error
     1626       then do:
     1627           message
     1628             skip "Неверно задан каталог экспорта."
     1629             skip(1)
     1630             skip "Обратитесь к администратору."
     1631           view-as alert-box error.
     1632           undo, return error .
     1633       end.
     1634       if v-bge-xml-bgefmt = "dbf":U
     1635       then do:
     1636           assign
     1637               p-xml-file-name = v-home-dir
     1638               p-locked        = no
     1639           .
     1640       end.
     1641       else do:
     1642           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1643             output p-xml-file-name, output p-locked) .
     1644       end.
     1645       if v-bge-xml-bgeflold = "oracle"
     1646       then do:
     1647         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1648         if v-bge-xml-heap-dir = ?
     1649         then do:
     1650           undo, return error substitute( "&1&2&3"
     1651                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1652                                         , chr(10)
     1653                                         , "Обратитесь к администратору.":u
     1654                                         ).
     1655         end.
     1656         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1657         if error-status :error
     1658         then do:
     1659           undo, return error substitute( "&1&2&3"
     1660                                         , "Неверно задан каталог экспорта (heap).":u
     1661                                         , chr(10)
     1662                                         , "Обратитесь к администратору.":u
     1663                                         ).
     1664         end.
     1665         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1666           assign
     1667             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1668           .
     1669         end.
     1670         else do:
     1671           assign
     1672             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1673           .
     1674         end.
     1675       end.
     1676       else do:
     1677         assign
     1678             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1679         .
     1680       end.
     1681       assign
     1682          v-bge-xml-static-log-file-name = p-log-file-name
     1683       .
     1684   end.
     1685   end procedure.
     1686   procedure bge-xml-read-config :
     1687   do
     1688   on error undo, return error return-value
     1689   :
     1690   define input  parameter p-last-date as date      no-undo .
     1691   define input  parameter p-db-num    as integer   no-undo .
     1692       define variable v-bgeclall      as character     no-undo.
     1693       define variable v-bgedict       as character     no-undo.
     1694       define variable v-bgeshift      as character     no-undo.
     1695       define variable v-par-type      as character     no-undo.
     1696       define variable v-bgeflnm       as character     no-undo.
     1697       define variable v-bgecliiv      as character     no-undo .
     1698       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1699       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1700       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1701       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1702       define variable v-db-num-str    as character     no-undo .
     1703       define variable v-param-type      as character  no-undo .
     1704       define variable v-value-character as character  no-undo .
     1705       define variable v-value-date      as date       no-undo .
     1706       define variable v-value-decimal   as decimal    no-undo .
     1707       define variable v-value-integer   as integer    no-undo .
     1708       define variable v-value-logical   as logical    no-undo .
     1709       define variable v-tth             as handle      no-undo .
     1710       run adm/shattri.p ( input "get":U
     1711                         , input  '':u
     1712                         , input  0
     1713                         , input  'bge-export':U
     1714                         , input  'bgeclall':U
     1715                         , output v-bgecliiv
     1716                         , output v-value-date
     1717                         , output v-value-decimal
     1718                         , output v-value-integer
     1719                         , output v-value-logical
     1720                         , output v-param-type
     1721                         , input-output table-handle v-tth
     1722                         ) no-error .
     1723       if error-status :error
     1724       then do:
     1725         assign
     1726           v-bge-xml-bgecliiv = no
     1727         .
     1728       end.
     1729       else do:
     1730         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1731       end.
     1732       delete object v-tth.
     1733       assign
     1734           v-bge-xml-bgeclall = no
     1735           v-bge-xml-bgedict  = no
     1736       .
     1737       run adm/shattri.p ( input "get":U
     1738                         , input  '':u
     1739                         , input  0
     1740                         , input  'bge-export':U
     1741                         , input  'bgeclall':U
     1742                         , output v-value-character
     1743                         , output v-value-date
     1744                         , output v-value-decimal
     1745                         , output v-value-integer
     1746                         , output v-value-logical
     1747                         , output v-param-type
     1748                         , input-output table-handle v-tth
     1749                         ) no-error .
     1750       if error-status :error
     1751       then do:
     1752         assign
     1753           v-bge-xml-bgeclall = no
     1754         .
     1755       end.
     1756       else do:
     1757         assign
     1758           v-bge-xml-bgeclall = v-value-logical
     1759         .
     1760       end.
     1761       delete object v-tth.
     1762       run adm/shattri.p ( input "get":U
     1763                         , input  '':u
     1764                         , input  0
     1765                         , input  'bge-export':U
     1766                         , input  'bgedict':U
     1767                         , output v-value-character
     1768                         , output v-value-date
     1769                         , output v-value-decimal
     1770                         , output v-value-integer
     1771                         , output v-value-logical
     1772                         , output v-param-type
     1773                         , input-output table-handle v-tth
     1774                         ) no-error .
     1775       if error-status :error
     1776       then do:
     1777         assign
     1778           v-bge-xml-bgedict = no
     1779         .
     1780       end.
     1781       else do:
     1782         assign
     1783           v-bge-xml-bgedict = v-value-logical
     1784         .
     1785       end.
     1786       delete object v-tth.
     1787       run adm/shattri.p ( input "get":U
     1788                         , input  '':u
     1789                         , input  0
     1790                         , input  'bge-export':U
     1791                         , input  'bgefmt':U
     1792                         , output v-value-character
     1793                         , output v-value-date
     1794                         , output v-value-decimal
     1795                         , output v-value-integer
     1796                         , output v-value-logical
     1797                         , output v-param-type
     1798                         , input-output table-handle v-tth
     1799                         ) no-error .
     1800       if error-status :error
     1801       then do:
     1802         assign
     1803           v-bge-xml-bgefmt  = "xml":U
     1804         .
     1805       end.
     1806       else do:
     1807         assign
     1808           v-bge-xml-bgefmt  = v-value-character
     1809         .
     1810       end.
     1811       delete object v-tth.
     1812       run adm/shattri.p ( input "get":U
     1813                         , input  '':u
     1814                         , input  0
     1815                         , input  'bge-export':U
     1816                         , input  'bgeshift':U
     1817                         , output v-value-character
     1818                         , output v-value-date
     1819                         , output v-value-decimal
     1820                         , output v-value-integer
     1821                         , output v-value-logical
     1822                         , output v-param-type
     1823                         , input-output table-handle v-tth
     1824                         ) no-error .
     1825       if error-status :error
     1826       then do:
     1827         assign
     1828             v-bge-xml-shift-mode = no
     1829         .
     1830       end.
     1831       else do:
     1832         assign
     1833             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1834         .
     1835       end.
     1836       delete object v-tth.
     1837       run adm/shattri.p ( input "get":U
     1838                         , input  '':u
     1839                         , input  0
     1840                         , input  'bge-export':U
     1841                         , input  'bgeflold':U
     1842                         , output v-value-character
     1843                         , output v-value-date
     1844                         , output v-value-decimal
     1845                         , output v-value-integer
     1846                         , output v-value-logical
     1847                         , output v-param-type
     1848                         , input-output table-handle v-tth
     1849                         ) no-error .
     1850       if error-status :error
     1851       then do:
     1852         assign
     1853           v-bge-xml-bgeflold = "no-parameter":U
     1854         .
     1855       end.
     1856       else do:
     1857         assign
     1858           v-bge-xml-bgeflold  = v-value-character
     1859         .
     1860       end.
     1861       delete object v-tth.
     1862       assign
     1863         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1864         v-bge-xml-db-num-str  = v-db-num-str
     1865       .
     1866       if p-last-date <> ?
     1867       then do:
     1868           run adm/shattri.p ( input "get":U
     1869                             , input  '':u
     1870                             , input  0
     1871                             , input  'bge-export':U
     1872                             , input  'bgeflnm':U
     1873                             , output v-value-character
     1874                             , output v-value-date
     1875                             , output v-value-decimal
     1876                             , output v-value-integer
     1877                             , output v-value-logical
     1878                             , output v-param-type
     1879                             , input-output table-handle v-tth
     1880                             ) no-error .
     1881           if error-status :error
     1882           then do:
     1883             assign
     1884               v-bgeflnm = '':U
     1885             .
     1886           end.
     1887           else do:
     1888             assign
     1889               v-bgeflnm = v-value-character
     1890             .
     1891           end.
     1892           delete object v-tth.
     1893           if v-bge-xml-bgeflold = "var"
     1894           then do:
     1895               if v-bgeflnm = ?
     1896               or num-entries( v-bgeflnm ) < 2
     1897               then do:
     1898                   assign
     1899                       v-bge-xml-bgeflold = "new"
     1900                   .
     1901               end.
     1902               else do:
     1903                   assign
     1904                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1905                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1906                   .
     1907                   assign
     1908                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1909                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1910                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1911                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1912                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1913                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1914                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1915                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1916                   .
     1917               end.
     1918           end.
     1919       end.
     1920   end.
     1921   end procedure.
     1922   procedure bge-xml-get-ref-filename :
     1923   define input parameter p-in-file-name       as character        no-undo.
     1924   define output parameter p-home-dir          as character        no-undo.
     1925   define output parameter p-out-file-name     as character        no-undo.
     1926   define output parameter p-locked            as logical          no-undo.
     1927       define variable v-counter       as integer      no-undo.
     1928       define variable v-error-level   as integer      no-undo.
     1929   do
     1930   on error undo, return error
     1931   :
     1932       run bge/bge-ini.p (
     1933             input "bge"
     1934           , output p-home-dir
     1935       ).
     1936       if return-value <> "OK"
     1937       then do:
     1938           undo, return error.
     1939       end.
     1940       assign
     1941           p-home-dir = p-home-dir + "\dict":U
     1942       .
     1943       run bge/dir_cd.p (
     1944           input p-home-dir
     1945           , input "CA"
     1946       ).
     1947       if return-value = "ERROR"
     1948       then do:
     1949           undo, return error.
     1950       end.
     1951       assign
     1952           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     1953       .
     1954       assign
     1955           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     1956       .
     1957       wait-lock:
     1958       do v-counter = 1 TO 3
     1959       :
     1960           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     1961           if p-locked = no
     1962           then do:
     1963               leave wait-lock.
     1964           end.
     1965           else do:
     1966               readkey pause 1.
     1967           end.
     1968       END.
     1969       if p-locked = yes
     1970       then do:
     1971           undo, return error.
     1972       end.
     1973       run bge/os_copy.p (
     1974             input "D":U
     1975           , input p-out-file-name + "xml":U
     1976           , input "":U
     1977           , output v-error-level
     1978       ).
     1979       if v-error-level > 0
     1980       then do:
     1981           undo, return error.
     1982       end.
     1983   end.
     1984   end procedure.
     1985   procedure bge-xml-write-ref-header :
     1986   define input parameter p-bge-name as character        no-undo.
     1987   define input parameter p-file-name as character        no-undo.
     1988       define variable v-out-string    as character    no-undo.
     1989   do
     1990   on error undo, return error
     1991   :
     1992       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     1993       put stream stmXMLOut unformatted
     1994           "<?xml version='1.0' encoding='windows-1251'?>":U
     1995       .
     1996       assign
     1997           v-out-string = substitute( "&1&2"
     1998                               , chr(10)
     1999                               , "<IBS_Trade_House>":U )
     2000       .
     2001       put stream stmXMLOut unformatted
     2002           v-out-string
     2003       .
     2004       run wp-XMLTagOpen( 1, "header", "" ).
     2005       if v-bge-xml-bgeflold = "oracle":u
     2006       then do:
     2007         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2008         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2009         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2010         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2011         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2012       end.
     2013       else do:
     2014         run wp-XMLTagOpen( 2, "delivery", "" ).
     2015         run wp-XMLTagOpen( 3, "to", "" ).
     2016         run wp-XMLTagClose( 3, "to" ).
     2017         run wp-XMLTagOpen( 3, "from", "" ).
     2018         run wp-XMLTagClose( 3, "from" ).
     2019         run wp-XMLTagClose( 2, "delivery" ).
     2020       end.
     2021       run wp-XMLTagOpen( 2, "manifest", "" ).
     2022       run wp-XMLTagOpen( 3, "document", "" ).
     2023       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2024       run wp-XMLTagPut( 4, "description", "", 0 ).
     2025       run wp-XMLTagClose( 3, "document" ).
     2026       run wp-XMLTagClose( 2, "manifest" ).
     2027       run wp-XMLTagClose( 1, "header" ).
     2028       run wp-XMLTagOpen( 1, "body", "" ).
     2029   end.
     2030   end procedure.
     2031   procedure bge-xml-write-ref-footer :
     2032   define input parameter p-file-name as character        no-undo.
     2033       define variable v-error-level   as integer      no-undo.
     2034   do
     2035   on error undo, return error
     2036   :
     2037       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2038       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2039       output stream stmXMLOut close.
     2040       run bge/os_copy.p (
     2041             input "M":U
     2042           , input p-file-name + "xm1":U
     2043           , input p-file-name + "xml":U
     2044           , output v-error-level
     2045       ).
     2046       if v-error-level > 0
     2047       then do:
     2048           undo, return error.
     2049       end.
     2050   end.
     2051   end procedure.
     2052   procedure bge-xml-out-dir :
     2053   define output parameter p-out-dir       as character    no-undo.
     2054   define output parameter p-log-file-name as character    no-undo.
     2055   do
     2056   on error undo, return error
     2057   :
     2058       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2059       if p-out-dir = ?
     2060       then do:
     2061           message
     2062             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2063                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2064             skip(1)
     2065             skip "Обратитесь к администратору."
     2066           view-as alert-box error.
     2067           undo, return error .
     2068       end.
     2069       if v-bge-xml-bgeflold <> "oracle" then assign
     2070         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2071       .
     2072       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2073       if error-status :error  then do:
     2074           run wp-XMLWriteLog in this-procedure (
     2075                 input p-log-file-name
     2076               , input 0
     2077               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2078                                   , p-out-dir
     2079                                   , return-value
     2080                                   , trim( error-status :get-message( 1 ) )
     2081                                   )
     2082           ).
     2083           undo, return error.
     2084       end.
     2085       assign
     2086           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2087           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2088       .
     2089   end.
     2090   end procedure.
     2091   procedure bge-xml-out-dir2 :
     2092   define output parameter p-out-dir       as character    no-undo.
     2093   define output parameter p-out-dirR      as character    no-undo.
     2094   define output parameter p-log-file-name as character    no-undo.
     2095   do
     2096   on error undo, return error
     2097   :
     2098       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2099       if p-out-dir = ?
     2100       then do:
     2101           message
     2102             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2103                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2104             skip(1)
     2105             skip "Обратитесь к администратору."
     2106           view-as alert-box error.
     2107           undo, return error .
     2108       end.
     2109       if v-bge-xml-bgeflold <> "oracle" then assign
     2110             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2111             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2112         .
     2113       else p-out-dirR = p-out-dir .
     2114       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2115       if error-status :error  then do:
     2116           run wp-XMLWriteLog in this-procedure (
     2117                 input p-log-file-name
     2118               , input 0
     2119               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2120                                   , p-out-dir
     2121                                   , return-value
     2122                                   , error-status :get-message( 1 )
     2123                                   )
     2124           ).
     2125           undo, return error.
     2126       end.
     2127       if p-out-dirR <> p-out-dir then do:
     2128         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2129         if error-status :error then do:
     2130           run wp-XMLWriteLog in this-procedure (
     2131                 input p-log-file-name
     2132               , input 0
     2133               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2134                                   , p-out-dirR
     2135                                   , return-value
     2136                                   , error-status :get-message( 1 )
     2137                                   )
     2138           ).
     2139           p-out-dirR = p-out-dir .
     2140         end.
     2141       end .
     2142       assign
     2143         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2144         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2145       .
     2146   end.
     2147   end procedure.
     2148   procedure bge-xml-out-file :
     2149   do
     2150   on error undo, return error
     2151   :
     2152   define input parameter p-out-dir            as character        no-undo.
     2153   define input parameter p-prefix             as character        no-undo.
     2154   define input parameter p-sheduled           as logical          no-undo.
     2155   define output parameter p-xml-file-name     as character        no-undo.
     2156   define output parameter p-locked            as logical          no-undo.
     2157   define variable v-home-dir      as character     no-undo.
     2158   define variable v-error-num     as integer       no-undo.
     2159   define variable v-today             as date         no-undo.
     2160   define variable v-time              as integer      no-undo.
     2161       if v-bge-xml-bgefmt = "dbf":U
     2162       then do:
     2163           assign
     2164               p-xml-file-name = p-out-dir
     2165               p-locked        = no
     2166           .
     2167       end.
     2168       else do:
     2169           if v-bge-xml-bgeflold = "firm":U
     2170           then do:
     2171               run bge/genfname.p (
     2172                     input p-out-dir
     2173                   , input p-prefix
     2174                   , input "":U
     2175                   , input "arj":U
     2176                   , input "":U
     2177                   , output p-xml-file-name
     2178               ).
     2179           end.
     2180           else do:
     2181               run bge/genfname.p (
     2182                     input p-out-dir
     2183                   , input p-prefix
     2184                   , input "":U
     2185                   , input "xml":U
     2186                   , input "":U
     2187                   , output p-xml-file-name
     2188               ).
     2189           end.
     2190           assign
     2191               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2192               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2193           .
     2194       end.
     2195   end.
     2196   end procedure.
     2197   procedure bge-xml-init-ext-doc-type :
     2198       define variable v-counter    as integer      no-undo.
     2199       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2200   do
     2201   for buf_temp_ext-doc-type
     2202   on error undo, return error
     2203   :
     2204       empty temp-table buf_temp_ext-doc-type.
     2205       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2206       :
     2207           create buf_temp_ext-doc-type.
     2208           assign
     2209               buf_temp_ext-doc-type.edt-key               = v-counter
     2210               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2211               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2212           .
     2213       end.
     2214   end.
     2215   end procedure.
     2216   procedure bge-xml-get-decimal-shift-num :
     2217   define input parameter p-shift-date     as date             no-undo.
     2218   define input parameter p-shift-num      as integer          no-undo.
     2219   define output parameter p-shift-decimal as decimal          no-undo.
     2220   do
     2221   on error undo, return error
     2222   :
     2223       assign
     2224           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2225       .
     2226   end.
     2227   end procedure.
     2228   procedure bge-xml-ora-exp-filename :
     2229     define input  parameter p-table-name  as character no-undo .
     2230     define input  parameter p-doc-code    as character no-undo .
     2231     define input  parameter p-obj-code    as integer   no-undo .
     2232     define output parameter p-filename    as character no-undo .
     2233     define output parameter p-seq-num     as integer   no-undo .
     2234     define variable v-ora-exp-seq     as integer   no-undo .
     2235     define variable v-ora-exp-seq-str as character no-undo .
     2236     define variable v-home-dir        as character no-undo.
     2237   do
     2238   on error undo, return error return-value
     2239   :
     2240     if v-bge-xml-bgeflold = "oracle":u
     2241     then do:
     2242       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2243       if v-home-dir = ?
     2244       then do:
     2245         undo, return error substitute( "&1&2&3":U
     2246                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2247                                       , chr(10)
     2248                                       , "Обратитесь к администратору.":U
     2249                                       ).
     2250       end.
     2251       assign
     2252           v-home-dir = v-home-dir
     2253       .
     2254       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2255       if error-status :error
     2256       then do:
     2257         undo, return error substitute( "&1&2&3":U
     2258                                       , "Неверно задан каталог экспорта.":U
     2259                                       , chr(10)
     2260                                       , "Обратитесь к администратору.":U
     2261                                       ).
     2262       end.
     2263       assign
     2264         v-ora-exp-seq = ?
     2265       .
     2266       if  p-table-name <> ? and
     2267           p-doc-code <> ?
     2268       then do:
     2269         run bge/get-oesq.p ( input p-table-name
     2270                            , input p-doc-code
     2271                            , output v-ora-exp-seq
     2272                            ) no-error .
     2273         if error-status :error = yes
     2274         then do:
     2275           undo, return error return-value .
     2276         end.
     2277       end.
     2278       if v-ora-exp-seq = ?
     2279       then do:
     2280         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2281         if error-status :error
     2282         then do:
     2283           undo, return error return-value .
     2284         end.
     2285       end.
     2286       if p-table-name <> ? and
     2287          p-doc-code   <> ?
     2288       then do:
     2289         run bge/oesqdoc.p ( input p-table-name
     2290                           , input p-doc-code
     2291                           , input v-ora-exp-seq
     2292                           ) no-error .
     2293         if error-status :error = yes
     2294         then do:
     2295           undo, return error return-value .
     2296         end.
     2297       end.
     2298       assign
     2299         p-seq-num  = v-ora-exp-seq
     2300         p-filename = substitute("&1/&2-000_&3."
     2301                                , v-home-dir
     2302                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2303                                , string(v-ora-exp-seq , "999999999")
     2304                                )
     2305       .
     2306     end.
     2307   end.
     2308   end procedure.
     2309   procedure bge-xml-date-to-str :
     2310     define input  parameter p-date  as date      no-undo .
     2311     define output parameter p-str   as character no-undo .
     2312   do
     2313   on error undo, return error return-value
     2314   :
     2315     if p-date <> ?
     2316     then do:
     2317       assign
     2318         p-str = substitute( "&1-&2-&3"
     2319                           , string( year(p-date)  , "9999")
     2320                           , string( month(p-date) , "99"  )
     2321                           , string( day(p-date)   , "99"  )
     2322                           )
     2323       .
     2324     end.
     2325     else do:
     2326       assign
     2327         p-str = ?
     2328       .
     2329     end.
     2330   end.
     2331   end procedure.
     2332   procedure bge-xml-date-str-to-str :
     2333     define input  parameter p-date-str  as character no-undo .
     2334     define output parameter p-str       as character no-undo .
     2335     define variable v-date          as date      no-undo .
     2336     define variable v-date-valid    as logical   no-undo .
     2337     define variable v-error-message as character no-undo .
     2338   do
     2339   on error undo, return error return-value
     2340   :
     2341     assign
     2342       p-str = ?
     2343     .
     2344     if p-date-str = ? or p-date-str = ""
     2345     then do:
     2346       return .
     2347     end.
     2348     run strtdate in this-procedure ( input  p-date-str
     2349                                    , output v-date
     2350                                    , output v-date-valid
     2351                                    , output v-error-message
     2352                                    ).
     2353     if v-date-valid <> true
     2354     then do:
     2355       return .
     2356     end.
     2357     assign
     2358       p-str = substitute( "&1-&2-&3"
     2359                         , string( year(v-date)  , "9999")
     2360                         , string( month(v-date) , "99"  )
     2361                         , string( day(v-date)   , "99"  )
     2362                         )
     2363     .
     2364   end.
     2365   end procedure.
     2366   procedure bge-xml-fill-tt-bgecliiv :
     2367     define input  parameter p-str as character no-undo .
     2368     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2369     define buffer buf_clients             for ub.clients.
     2370     define variable v-i         as integer   no-undo .
     2371     define variable v-count     as integer   no-undo .
     2372     define variable v-cli-count as integer   no-undo .
     2373     define variable v-client    as character no-undo .
     2374     define variable v-obj-type  as character no-undo .
     2375     define variable v-obj-code  as integer   no-undo .
     2376   do
     2377   on error undo, return error return-value
     2378   :
     2379     empty temp-table buf_tt-bge-xml-bgecliiv.
     2380     assign
     2381       v-bge-xml-bgecliiv = no
     2382       v-cli-count        = num-entries(p-str,';')
     2383     .
     2384     if v-cli-count > 0
     2385     then do:
     2386       _cli-cycle:
     2387       do v-i = 1 to v-cli-count
     2388       :
     2389         assign
     2390           v-client = entry(v-i , p-str, ';')
     2391         .
     2392         if num-entries(v-client) <> 2
     2393         then do:
     2394           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2395         end.
     2396         assign
     2397           v-obj-type = entry(1, v-client)
     2398         .
     2399         assign
     2400           v-obj-code = integer(entry(2, v-client))
     2401         no-error .
     2402         if error-status :error
     2403         then do:
     2404           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2405         end.
     2406         find first buf_clients no-lock
     2407           where buf_clients.obj-type = v-obj-type
     2408             and buf_clients.obj-code = v-obj-code
     2409         no-error.
     2410         if not available buf_clients
     2411         then do:
     2412           next _cli-cycle.
     2413         end.
     2414         find first buf_tt-bge-xml-bgecliiv no-lock
     2415           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2416             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2417         no-error .
     2418         if available buf_tt-bge-xml-bgecliiv
     2419         then do:
     2420           next _cli-cycle.
     2421         end.
     2422         create buf_tt-bge-xml-bgecliiv.
     2423         assign
     2424           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2425           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2426         .
     2427       end.
     2428     end.
     2429     else do:
     2430       assign
     2431         v-bge-xml-bgecliiv = no
     2432       .
     2433       return .
     2434     end.
     2435     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2436     if available buf_tt-bge-xml-bgecliiv
     2437     then do:
     2438       assign
     2439         v-bge-xml-bgecliiv = yes
     2440       .
     2441     end.
     2442   end.
     2443   end procedure.
     2444   procedure bge-xml-resolve-ext-doc-type :
     2445     define input  parameter p-ext-doc-type      as character no-undo .
     2446     define input  parameter p-obj-type          as character no-undo .
     2447     define input  parameter p-obj-code          as integer   no-undo .
     2448     define output parameter p-out-ext-doc-type  as character no-undo .
     2449     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2450   do
     2451   on error undo, return error return-value
     2452   :
     2453     assign
     2454       p-out-ext-doc-type = p-ext-doc-type
     2455     .
     2456     if p-ext-doc-type <> 'ie':U
     2457     then do:
     2458       return .
     2459     end.
     2460     if v-bge-xml-bgecliiv = yes
     2461     then do:
     2462       find first buf_tt-bge-xml-bgecliiv no-lock
     2463         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2464           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2465       no-error .
     2466       if available buf_tt-bge-xml-bgecliiv
     2467       then do:
     2468         assign
     2469           p-out-ext-doc-type = 'iv':U
     2470         .
     2471       end.
     2472     end.
     2473   end.
     2474   end procedure.
     2475   procedure safe-wp-xmltagput :
     2476     define input  parameter pTagLevel   as integer   no-undo .
     2477     define input  parameter pTagName    as character no-undo .
     2478     define input  parameter pParValue   as character no-undo .
     2479     define input  parameter pFlagEmpty  as integer   no-undo .
     2480   do
     2481   on error undo, return error return-value
     2482   :
     2483     if v-bge-xml-bgeflold = "oracle":u
     2484     then do:
     2485       return .
     2486     end.
     2487     run wp-xmltagput in this-procedure ( input pTagLevel
     2488                                        , input pTagName
     2489                                        , input pParValue
     2490                                        , input pFlagEmpty
     2491                                        ).
     2492   end.
     2493   end procedure.
     2494       def temp-table temp-good no-undo
     2495           field gds-code                  like ub.goods.gds-code
     2496           field supp-type                 like ub.stk-supp-line.cli-type
     2497           field supp-code                 like ub.stk-supp-line.cli-code
     2498           field artic                     like ub.goods.artic
     2499           field prod-type                 like ub.goods.prod-type
     2500           field prod-code                 like ub.goods.prod-code
     2501           field gds-name                  like ub.goods.gds-name
     2502           field qnty-first                like ub.stk-supp-line.fact-qnty
     2503           field sum-first-rubl            like ub.stk-supp-line.sum-rubl
     2504           field sum-first-base            like ub.stk-supp-line.sum-base
     2505           field sum-VAT-first-rubl        like ub.stk-supp-line.VAT-rubl
     2506           field sum-VAT-first-base        like ub.stk-supp-line.VAT-base
     2507           field sum-other-first-rubl      like ub.stk-supp-line.other-rubl
     2508           field sum-other-first-base      like ub.stk-supp-line.other-base
     2509           field sum-transport-first-rubl  like ub.stk-supp-line.transport-rubl
     2510           field sum-transport-first-base  like ub.stk-supp-line.transport-base
     2511           field qnty-last                 like ub.stk-supp-line.fact-qnty
     2512           field sum-last-rubl             like ub.stk-supp-line.sum-rubl
     2513           field sum-last-base             like ub.stk-supp-line.sum-base
     2514           field sum-VAT-last-rubl         like ub.stk-supp-line.VAT-rubl
     2515           field sum-VAT-last-base         like ub.stk-supp-line.VAT-base
     2516           field sum-other-last-rubl       like ub.stk-supp-line.other-rubl
     2517           field sum-other-last-base       like ub.stk-supp-line.other-base
     2518           field sum-transport-last-rubl   like ub.stk-supp-line.transport-rubl
     2519           field sum-transport-last-base   like ub.stk-supp-line.transport-base
     2520           index pi is primary unique gds-code supp-type supp-code
     2521       .
     2522       define variable v-good-counter  as integer       no-undo.
     2523       define variable v-host-code     as integer       no-undo.
     2524       define variable v-base-code     as integer       no-undo.
     2525   define variable v-base-code-okv as integer       no-undo.
     2526       define buffer buf_goods         for ub.goods.
     2527       define buffer buf_gds-obj       for ub.gds-obj.
     2528       define buffer buf_clients       for ub.clients.
     2529       define buffer buf_stk-supp-line for ub.stk-supp-line.
     2530   do
     2531   for buf_goods
     2532     , buf_gds-obj
     2533     , buf_clients
     2534   on error undo, return error
     2535   :
     2536   OUTPUT STREAM stmXMLOut TO VALUE(sOutFile + "xm1") CONVERT TARGET "1251" APPEND.
     2537   RUN wp-XMLWriteCNT(hCNT, "").
     2538   run wp-xmltagopen( 2, "operation","").
     2539   run wp-xmltagput( 3, "codeOperation", "stk", 0 ).
     2540   run wp-xmltagput( 3, "store"     , p-obj-type + string(p-obj-code), 0 ).
     2541   run wp-xmltagput( 3, "dateStart" , string(p-date-from,"99.99.9999"), 0 ).
     2542   run wp-xmltagput( 3, "dateEnd"   , string(p-date-to  ,"99.99.9999"), 0 ).
     2543   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2544   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2545     (input  p-obj-type
     2546     ,input  p-obj-code
     2547     ,output v-host-code
     2548     )  .
     2549   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2550   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2551     (input  v-host-code
     2552     ,output v-base-code
     2553     )  .
     2554   run get-base-code-okv in this-procedure (
     2555         input v-base-code
     2556       , output v-base-code-okv
     2557   ).
     2558   run wp-xmltagput( 3, "valutCode" , string( v-base-code ), 0 ).
     2559   run wp-xmltagput( 3, "valutCodeOKV" , string( v-base-code-okv   ), 0 ).
     2560   good-on-object:
     2561   for each buf_gds-obj no-lock
     2562      where buf_gds-obj.obj-type = p-obj-type
     2563        and buf_gds-obj.obj-code = p-obj-code
     2564   break by buf_gds-obj.artic
     2565         by buf_gds-obj.prod-type
     2566         by buf_gds-obj.prod-code
     2567   :
     2568       for each temp-good
     2569       :
     2570           delete temp-good.
     2571       end.
     2572       if buf_gds-obj.last-doc < p-date-from
     2573       then do:
     2574           for each buf_clients no-lock
     2575           :
     2576               find last buf_stk-supp-line no-lock
     2577                   where buf_stk-supp-line.obj-type  = buf_gds-obj.obj-type
     2578                     and buf_stk-supp-line.obj-code  = buf_gds-obj.obj-code
     2579                     and buf_stk-supp-line.cli-type  = buf_clients.obj-type
     2580                     and buf_stk-supp-line.cli-code  = buf_clients.obj-code
     2581                     and buf_stk-supp-line.artic     = buf_gds-obj.artic
     2582                     and buf_stk-supp-line.prod-type = buf_gds-obj.prod-type
     2583                     and buf_stk-supp-line.prod-code = buf_gds-obj.prod-code
     2584                     and buf_stk-supp-line.sum-type  = 'cost':U
     2585                     and buf_stk-supp-line.cat-id    = '##':U
     2586                     and buf_stk-supp-line.fact-order <= p-fact-order-to
     2587               use-index category
     2588               no-error.
     2589               if available buf_stk-supp-line
     2590               then do:
     2591                   create temp-good.
     2592                   assign
     2593                       temp-good.gds-code                  = buf_gds-obj.gds-code
     2594                       temp-good.supp-type                 = buf_clients.obj-type
     2595                       temp-good.supp-code                 = buf_clients.obj-code
     2596                       temp-good.artic                     = buf_gds-obj.artic
     2597                       temp-good.prod-type                 = buf_gds-obj.prod-type
     2598                       temp-good.prod-code                 = buf_gds-obj.prod-code
     2599                       temp-good.qnty-first                = buf_stk-supp-line.fact-qnty
     2600                       temp-good.qnty-last                 = buf_stk-supp-line.fact-qnty
     2601                       temp-good.sum-last-rubl             = buf_stk-supp-line.sum-rubl
     2602                       temp-good.sum-last-base             = buf_stk-supp-line.sum-base
     2603                       temp-good.sum-VAT-last-rubl         = buf_stk-supp-line.VAT-rubl
     2604                       temp-good.sum-VAT-last-base         = buf_stk-supp-line.VAT-base
     2605                       temp-good.sum-other-last-rubl       = buf_stk-supp-line.other-rubl
     2606                       temp-good.sum-other-last-base       = buf_stk-supp-line.other-base
     2607                       temp-good.sum-transport-last-rubl   = buf_stk-supp-line.transport-rubl
     2608                       temp-good.sum-transport-last-base   = buf_stk-supp-line.transport-base
     2609                       temp-good.sum-first-rubl            = buf_stk-supp-line.sum-rubl
     2610                       temp-good.sum-first-base            = buf_stk-supp-line.sum-base
     2611                       temp-good.sum-VAT-first-rubl        = buf_stk-supp-line.VAT-rubl
     2612                       temp-good.sum-VAT-first-base        = buf_stk-supp-line.VAT-base
     2613                       temp-good.sum-other-first-rubl      = buf_stk-supp-line.other-rubl
     2614                       temp-good.sum-other-first-base      = buf_stk-supp-line.other-base
     2615                       temp-good.sum-transport-first-rubl  = buf_stk-supp-line.transport-rubl
     2616                       temp-good.sum-transport-first-base  = buf_stk-supp-line.transport-base
     2617                   .
     2618                   find first buf_goods no-lock
     2619                       where buf_goods.artic     = buf_gds-obj.artic
     2620                         and buf_goods.prod-type = buf_gds-obj.prod-type
     2621                         and buf_goods.prod-code = buf_gds-obj.prod-code
     2622                   no-error.
     2623                   if available buf_goods
     2624                   then do:
     2625                       assign
     2626                           temp-good.gds-name       = buf_goods.gds-name
     2627                       .
     2628                   end.
     2629                   else do:
     2630                       assign
     2631                           temp-good.gds-name       = ""
     2632                       .
     2633                   end.
     2634                   run write-result in this-procedure (
     2635                         input temp-good.gds-code
     2636                       , input temp-good.supp-type
     2637                       , input temp-good.supp-code
     2638                   ).
     2639               end.
     2640               else do:
     2641               end.
     2642           end.
     2643           next good-on-object.
     2644       end.
     2645       if buf_gds-obj.first-doc > p-date-to
     2646       then do:
     2647           next good-on-object.
     2648       end.
     2649       for each buf_clients no-lock
     2650       :
     2651           create temp-good.
     2652           assign
     2653               temp-good.gds-code                  = buf_gds-obj.gds-code
     2654               temp-good.supp-type                 = buf_clients.obj-type
     2655               temp-good.supp-code                 = buf_clients.obj-code
     2656               temp-good.artic                     = buf_gds-obj.artic
     2657               temp-good.prod-type                 = buf_gds-obj.prod-type
     2658               temp-good.prod-code                 = buf_gds-obj.prod-code
     2659               temp-good.qnty-first                = 0
     2660               temp-good.qnty-last                 = 0
     2661               temp-good.sum-first-rubl            = 0
     2662               temp-good.sum-first-base            = 0
     2663               temp-good.sum-VAT-first-rubl        = 0
     2664               temp-good.sum-VAT-first-base        = 0
     2665               temp-good.sum-other-first-rubl      = 0
     2666               temp-good.sum-other-first-base      = 0
     2667               temp-good.sum-transport-first-rubl  = 0
     2668               temp-good.sum-transport-first-base  = 0
     2669               temp-good.sum-last-rubl             = 0
     2670               temp-good.sum-last-base             = 0
     2671               temp-good.sum-VAT-last-rubl         = 0
     2672               temp-good.sum-VAT-last-base         = 0
     2673               temp-good.sum-other-last-rubl       = 0
     2674               temp-good.sum-other-last-base       = 0
     2675               temp-good.sum-transport-last-rubl   = 0
     2676               temp-good.sum-transport-last-base   = 0
     2677           .
     2678           find first buf_goods no-lock
     2679                where buf_goods.artic     = buf_gds-obj.artic
     2680                  and buf_goods.prod-type = buf_gds-obj.prod-type
     2681                  and buf_goods.prod-code = buf_gds-obj.prod-code
     2682           no-error.
     2683           if available buf_goods
     2684           then do:
     2685               assign
     2686                   temp-good.gds-name              = buf_goods.gds-name
     2687               .
     2688           end.
     2689           else do:
     2690               assign
     2691                   temp-good.gds-name              = ""
     2692               .
     2693           end.
     2694           find last buf_stk-supp-line no-lock
     2695               where buf_stk-supp-line.obj-type  = buf_gds-obj.obj-type
     2696                 and buf_stk-supp-line.obj-code  = buf_gds-obj.obj-code
     2697                 and buf_stk-supp-line.cli-type  = buf_clients.obj-type
     2698                 and buf_stk-supp-line.cli-code  = buf_clients.obj-code
     2699                 and buf_stk-supp-line.artic     = buf_gds-obj.artic
     2700                 and buf_stk-supp-line.prod-type = buf_gds-obj.prod-type
     2701                 and buf_stk-supp-line.prod-code = buf_gds-obj.prod-code
     2702                 and buf_stk-supp-line.sum-type  = 'cost':U
     2703                 and buf_stk-supp-line.cat-id    = '##':U
     2704                 and buf_stk-supp-line.fact-order <= p-fact-order-to
     2705           use-index category
     2706           no-error.
     2707           if available buf_stk-supp-line
     2708           then do:
     2709               assign
     2710                   temp-good.qnty-last                 = buf_stk-supp-line.fact-qnty
     2711                   temp-good.sum-last-rubl             = buf_stk-supp-line.sum-rubl
     2712                   temp-good.sum-last-base             = buf_stk-supp-line.sum-base
     2713                   temp-good.sum-VAT-last-rubl         = buf_stk-supp-line.VAT-rubl
     2714                   temp-good.sum-VAT-last-base         = buf_stk-supp-line.VAT-base
     2715                   temp-good.sum-other-last-rubl       = buf_stk-supp-line.other-rubl
     2716                   temp-good.sum-other-last-base       = buf_stk-supp-line.other-base
     2717                   temp-good.sum-transport-last-rubl   = buf_stk-supp-line.transport-rubl
     2718                   temp-good.sum-transport-last-base   = buf_stk-supp-line.transport-base
     2719               .
     2720           end.
     2721           find last buf_stk-supp-line no-lock
     2722               where buf_stk-supp-line.obj-type  = buf_gds-obj.obj-type
     2723                 and buf_stk-supp-line.obj-code  = buf_gds-obj.obj-code
     2724                 and buf_stk-supp-line.cli-type  = buf_clients.obj-type
     2725                 and buf_stk-supp-line.cli-code  = buf_clients.obj-code
     2726                 and buf_stk-supp-line.artic     = buf_gds-obj.artic
     2727                 and buf_stk-supp-line.prod-type = buf_gds-obj.prod-type
     2728                 and buf_stk-supp-line.prod-code = buf_gds-obj.prod-code
     2729                 and buf_stk-supp-line.sum-type  = 'cost':U
     2730                 and buf_stk-supp-line.cat-id    = '##':U
     2731                 and buf_stk-supp-line.fact-order <= p-fact-order-from
     2732           use-index category
     2733           no-error.
     2734           if available buf_stk-supp-line
     2735           then do:
     2736               assign
     2737                   temp-good.qnty-first                = buf_stk-supp-line.fact-qnty
     2738                   temp-good.sum-first-rubl            = buf_stk-supp-line.sum-rubl
     2739                   temp-good.sum-first-base            = buf_stk-supp-line.sum-base
     2740                   temp-good.sum-VAT-first-rubl        = buf_stk-supp-line.VAT-rubl
     2741                   temp-good.sum-VAT-first-base        = buf_stk-supp-line.VAT-base
     2742                   temp-good.sum-other-first-rubl      = buf_stk-supp-line.other-rubl
     2743                   temp-good.sum-other-first-base      = buf_stk-supp-line.other-base
     2744                   temp-good.sum-transport-first-rubl  = buf_stk-supp-line.transport-rubl
     2745                   temp-good.sum-transport-first-base  = buf_stk-supp-line.transport-base
     2746               .
     2747           end.
     2748           run write-result in this-procedure (
     2749                 input temp-good.gds-code
     2750               , input temp-good.supp-type
     2751               , input temp-good.supp-code
     2752           ) .
     2753       end.
     2754   end.
     2755   run wp-xmltagclose(2, "operation").
     2756   output stream stmxmlout close.
     2757   if session :set-wait-state( "" ) then.
     2758   end.
     2759   procedure write-result :
     2760   do
     2761   on error undo, return error
     2762   :
     2763   define input parameter p-gds-code   as integer      no-undo.
     2764   define input parameter p-supp-type  as character    no-undo.
     2765   define input parameter p-supp-code  as integer      no-undo.
     2766       find first temp-good
     2767            where temp-good.gds-code   = p-gds-code
     2768              and temp-good.supp-type  = p-supp-type
     2769              and temp-good.supp-code  = p-supp-code
     2770       .
     2771       if temp-good.qnty-first     <> 0
     2772       or temp-good.sum-first-rubl <> 0
     2773       or temp-good.sum-first-base <> 0
     2774       or temp-good.qnty-last      <> 0
     2775       or temp-good.sum-last-rubl  <> 0
     2776       or temp-good.sum-last-base  <> 0
     2777       then do:
     2778           process events.
     2779           assign
     2780               v-good-counter = v-good-counter + 1
     2781           .
     2782           run wp-xmltagopen( 3, "good", "" ).
     2783           run wp-xmltagput( 4, "code"       , string( temp-good.gds-code )       , 0 ).
     2784           run wp-xmltagput( 4, "suppType"   , string( temp-good.supp-type )      , 0 ).
     2785           run wp-xmltagput( 4, "suppCode"   , string( temp-good.supp-code )      , 0 ).
     2786           run wp-xmltagput( 4, "artic"      , temp-good.artic                    , 0 ).
     2787           run wp-xmltagput( 4, "prodType"   , temp-good.prod-type                , 0 ).
     2788           run wp-xmltagput( 4, "prodCode"   , string( temp-good.prod-code )      , 0 ).
     2789           run wp-xmltagput( 4, "name"       , temp-good.gds-name                 , 0 ).
     2790           run wp-xmltagput( 4, "qntyStart"  , string( temp-good.qnty-first     ) , 0 ).
     2791           run wp-xmltagput( input 4, input "sumStartR"            , input string( temp-good.sum-first-rubl            ) , input 0 ).
     2792           run wp-xmltagput( input 4, input "sumStartB"            , input string( temp-good.sum-first-base            ) , input 0 ).
     2793           run wp-xmltagput( input 4, input "sumStartVATR"         , input string( temp-good.sum-VAT-first-rubl        ) , input 0 ).
     2794           run wp-xmltagput( input 4, input "sumStartVATB"         , input string( temp-good.sum-VAT-first-base        ) , input 0 ).
     2795           run wp-xmltagput( input 4, input "sumStartOtherR"       , input string( temp-good.sum-other-first-rubl      ) , input 0 ).
     2796           run wp-xmltagput( input 4, input "sumStartOtherB"       , input string( temp-good.sum-other-first-base      ) , input 0 ).
     2797           run wp-xmltagput( input 4, input "sumStartTransportR"   , input string( temp-good.sum-transport-first-rubl  ) , input 0 ).
     2798           run wp-xmltagput( input 4, input "sumStartTransportB"   , input string( temp-good.sum-transport-first-base  ) , input 0 ).
     2799           run wp-xmltagput( input 4, input "qntyEnd"              , input string( temp-good.qnty-last                 ) , input 0 ).
     2800           run wp-xmltagput( input 4, input "sumEndR"              , input string( temp-good.sum-last-rubl             ) , input 0 ).
     2801           run wp-xmltagput( input 4, input "sumEndB"              , input string( temp-good.sum-last-base             ) , input 0 ).
     2802           run wp-xmltagput( input 4, input "sumEndVATR"           , input string( temp-good.sum-VAT-last-rubl         ) , input 0 ).
     2803           run wp-xmltagput( input 4, input "sumEndVATB"           , input string( temp-good.sum-VAT-last-base         ) , input 0 ).
     2804           run wp-xmltagput( input 4, input "sumEndOtherR"         , input string( temp-good.sum-other-last-rubl       ) , input 0 ).
     2805           run wp-xmltagput( input 4, input "sumEndOtherB"         , input string( temp-good.sum-other-last-base       ) , input 0 ).
     2806           run wp-xmltagput( input 4, input "sumEndTransportR"     , input string( temp-good.sum-transport-last-rubl   ) , input 0 ).
     2807           run wp-xmltagput( input 4, input "sumEndTransportB"     , input string( temp-good.sum-transport-last-base   ) , input 0 ).
     2808           run wp-xmltagclose( 3, "good" ).
     2809           if v-good-counter modulo 10 = 0
     2810           then do:
     2811               run wp-XMLWriteCnt( hcnt, string( v-good-counter ) ).
     2812               process events.
     2813           end.
     2814       end.
     2815   end.
     2816   end procedure.
     2817   procedure get-base-code-okv :
     2818   define input parameter p-base-code          as integer          no-undo.
     2819   define output parameter p-base-code-okv     as integer          no-undo.
     2820       define buffer buf_currency      for ub.currency.
     2821   do
     2822   for buf_currency
     2823   on error undo, return error
     2824   :
     2825       find first buf_currency no-lock
     2826            where buf_currency.curr-code = p-base-code
     2827       .
     2828       assign
     2829           p-base-code-okv = buf_currency.okv-code
     2830       .
     2831   end.
     2832   end procedure.
