      593   procedure xmlchar-decode :
      594   define input parameter p-in-string      as character        no-undo.
      595   define output parameter p-out-string    as character        no-undo.
      596       define variable v-position      as integer      no-undo.
      597       define variable v-last-position as integer      no-undo.
      598       define variable v-temp-integer  as integer      no-undo.
      599       define variable v-current-char  as character    no-undo.
      600       define variable v-next-char     as character    no-undo.
      601       define variable v-success       as logical      no-undo.
      602   do
      603   on error undo, return error
      604   :
      605       assign
      606           p-out-string = "":U
      607           v-position   = 0
      608       .
      609       replace-cycle:
      610       do while yes
      611       on error undo, return error
      612       :
      613           assign
      614               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      615           .
      616           if v-last-position <= v-position
      617           then do:
      618               if v-position = 0
      619               then do:
      620                   assign
      621                       p-out-string = p-in-string
      622                   .
      623               end.
      624               else do:
      625                   assign
      626                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      627                   .
      628               end.
      629               leave replace-cycle.
      630           end.
      631           else do:
      632               assign
      633                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      634                   v-position      = v-last-position
      635                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      636               .
      637               if v-current-char = "#":U
      638               then do:
      639                   assign
      640                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      641                   .
      642                   if v-last-position > 0
      643                   then do:
      644                       run xmlchar-read-integer in this-procedure
      645                        (
      646                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      647                           , output v-temp-integer
      648                           , output v-success
      649                       ).
      650                       if v-success = yes
      651                       and v-temp-integer >= 1
      652                       and v-temp-integer <= 255
      653                       then do:
      654                           assign
      655                               p-out-string = p-out-string + chr( v-temp-integer )
      656                               v-position   = v-last-position + 1
      657                           .
      658                       end.
      659                       else do:
      660                           assign
      661                               p-out-string = p-out-string + "&":U
      662                               v-position   = v-position   + 1
      663                           .
      664                       end.
      665                   end.
      666                   else do:
      667                       assign
      668                           p-out-string = p-out-string + "&":U
      669                           v-position   = v-position   + 1
      670                       .
      671                   end.
      672               end.
      673               else do:
      674                   case substring( p-in-string, v-position + 1, 3 )
      675                   :
      676                       when "lt;":U
      677                       then do:
      678                           assign
      679                               p-out-string = p-out-string + "<":U
      680                               v-position   = v-position   + 3
      681                           .
      682                       end.
      683                       when "gt;":U
      684                       then do:
      685                           assign
      686                               p-out-string = p-out-string + ">":U
      687                               v-position   = v-position   + 3
      688                           .
      689                       end.
      690                       otherwise do:
      691                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      692                           then do:
      693                               assign
      694                                   p-out-string = p-out-string + "&":U
      695                                   v-position   = v-position   + 4
      696                               .
      697                           end.
      698                           else do:
      699                               case substring( p-in-string, v-position + 1, 5 )
      700                               :
      701                                   when "quot;":U
      702                                   then do:
      703                                       assign
      704                                           p-out-string = p-out-string + '"':U
      705                                           v-position   = v-position   + 5
      706                                       .
      707                                   end.
      708                                   when "apos;":U
      709                                   then do:
      710                                       assign
      711                                           p-out-string = p-out-string + "'":U
      712                                           v-position   = v-position   + 5
      713                                       .
      714                                   end.
      715                                   otherwise do:
      716                                       assign
      717                                           p-out-string = p-out-string + "&":U
      718                                       .
      719                                   end.
      720                               end case.
      721                           end.
      722                       end.
      723                   end case.
      724               end.
      725           end.
      726       end.
      727   end.
      728   end .
      729   procedure xmlchar-read-integer :
      730   define input parameter p-input-string      as character        no-undo.
      731   define output parameter p-output-integer   as integer          no-undo.
      732   define output parameter p-success       as logical          no-undo.
      733   do
      734   on error undo, return error
      735   :
      736       assign
      737           p-output-integer = integer( p-input-string )
      738       no-error.
      739       if error-status :error
      740       then do:
      741           assign
      742               p-success           = no
      743               p-output-integer    = 0
      744           .
      745       end.
      746       else do:
      747           assign
      748               p-success           = yes
      749           .
      750       end.
      751   end.
      752   end.
      753   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      754   procedure strtdate :
      755     define input  parameter p-str         as character no-undo .
      756     define output parameter p-value       as date      no-undo .
      757     define output parameter p-data-valid  as logical   no-undo .
      758     define output parameter p-message     as character no-undo .
      759   do
      760   on error undo, return error return-value
      761   :
      762     define variable v-value       as date      no-undo .
      763     define variable v-i           as integer   no-undo .
      764     define variable v-num         as integer   no-undo .
      765     define variable v-delim       as character no-undo .
      766     define variable v-delim-list  as character no-undo .
      767     define variable v-day         as integer   no-undo .
      768     define variable v-month       as integer   no-undo .
      769     define variable v-year        as integer   no-undo .
      770     define variable v-day-str     as character no-undo .
      771     define variable v-month-str   as character no-undo .
      772     define variable v-year-str    as character no-undo .
      773     assign
      774       p-value       = ?
      775       p-data-valid  = false
      776     .
      777     if p-str = ?
      778     then do:
      779       assign
      780         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      781       .
      782       return .
      783     end.
      784     if p-str = ""
      785     then do:
      786       assign
      787         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      788       .
      789       return .
      790     end.
      791     if length(p-str)  > 10
      792     then do:
      793       assign
      794         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      795       .
      796       return .
      797     end.
      798     assign
      799       v-delim-list = '/,-,.':U
      800     .
      801     _delim:
      802     do v-i = 1 to num-entries( v-delim-list )
      803     :
      804       assign
      805         v-delim = entry( v-i , v-delim-list )
      806         v-num   = num-entries( p-str , v-delim )
      807       .
      808       if v-num <> 3
      809       then do:
      810         assign
      811           v-delim = ''
      812         .
      813       end.
      814       else do:
      815         leave _delim.
      816       end.
      817     end.
      818     if v-delim = ''
      819     then do:
      820       assign
      821         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      822       .
      823       return .
      824     end.
      825     assign
      826       v-day-str   = entry( 1, p-str , v-delim)
      827       v-month-str = entry( 2, p-str , v-delim)
      828       v-year-str  = entry( 3, p-str , v-delim)
      829     .
      830     if  length(v-day-str) > 2   or
      831         length(v-day-str) < 1   or
      832         length(v-month-str) > 2 or
      833         length(v-month-str) < 1 or
      834         (
      835           length(v-year-str) <> 2 and
      836           length(v-year-str) <> 4
      837         )
      838     then do:
      839       assign
      840         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      841       .
      842       return .
      843     end.
      844     if length( v-year-str ) = 2
      845     then do:
      846       assign
      847         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      848       .
      849     end.
      850     assign
      851       v-day   = integer( v-day-str )
      852       v-month = integer( v-month-str)
      853       v-year  = integer( v-year-str)
      854     no-error .
      855     if error-status :error
      856     then do:
      857       assign
      858         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      859       .
      860       return .
      861     end.
      862     if v-day < 1  or
      863        v-day > 31 or
      864        v-month < 1 or
      865        v-month > 12 or
      866        v-year < 0   or
      867        v-year > 5000
      868     then do:
      869       assign
      870         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      871       .
      872       return .
      873     end.
      874     assign
      875       v-value = date( v-month, v-day, v-year )
      876     no-error .
      877     if error-status :error
      878     then do:
      879       assign
      880         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      881       .
      882       return .
      883     end.
      884     assign
      885       p-value       = v-value
      886       p-data-valid  = true
      887     .
      888   end.
      889   end procedure.
      890   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      891   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
      892   define variable v-bge-xml-bgedict       as logical  init no  no-undo.
      893   define variable v-bge-xml-bgeflold      as character         no-undo.
      894   define variable v-bge-xml-bgefmt        as character         no-undo.
      895   define variable v-bge-xml-shift-mode    as logical           no-undo.
      896   define variable v-bge-xml-bgeflnm-doc   as character         no-undo.
      897   define variable v-bge-xml-bgeflnm-day   as character         no-undo.
      898   define variable v-bge-xml-log-file-name as character    no-undo.
      899   define variable v-bge-xml-dbf-file-name as character    no-undo.
      900   define variable v-bge-xml-db-num-str    as character    no-undo .
      901   define variable v-bge-xml-static-log-file-name as character    no-undo.
