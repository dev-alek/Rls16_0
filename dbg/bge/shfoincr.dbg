     1028       field fin-doc-code as integer
     1029       index pi is primary unique
     1030           host-code
     1031           fin-doc-code
     1032   .
     1033   define temp-table temp_del-fin-doc-code no-undo
     1034       field host-code as integer
     1035       field fin-doc-code as integer
     1036       field corr-user-db-num as integer
     1037       field chip-num as integer
     1038       index pi is primary unique
     1039           host-code
     1040           fin-doc-code
     1041           corr-user-db-num
     1042           chip-num
     1043   .
     1044   define temp-table temp_fin-ob no-undo
     1045       field host-code as integer
     1046       field fin-doc-code as character
     1047       index pi is primary unique
     1048           host-code
     1049           fin-doc-code
     1050   .
     1051   define temp-table temp_del-fin-ob no-undo
     1052       field host-code as integer
     1053       field fin-doc-code as character
     1054       field corr-user-db-num as integer
     1055       field chip-num as integer
     1056       index pi is primary unique
     1057           host-code
     1058           fin-doc-code
     1059           corr-user-db-num
     1060           chip-num
