      649                       then do:
      650                           assign
      651                               p-out-string = p-out-string + " ":U
      652                           .
      653                       end.
      654                       when chr(10)
      655                       then do:
      656                           assign
      657                               p-out-string = p-out-string + " ":U
      658                           .
      659                       end.
      660                       when chr(13)
      661                       then do:
      662                           assign
      663                               p-out-string = p-out-string + " ":U
      664                           .
      665                       end.
      666                       otherwise do:
      667                           assign
      668                               p-out-string = p-out-string + v-current-char
      669                           .
      670                       end.
      671                   end case.
      672               end.
      673           end.
      674       end case.
      675   end.
      676   end .
      677   procedure xmlchar-decode :
      678   define input parameter p-in-string      as character        no-undo.
      679   define output parameter p-out-string    as character        no-undo.
      680       define variable v-position      as integer      no-undo.
      681       define variable v-last-position as integer      no-undo.
      682       define variable v-temp-integer  as integer      no-undo.
      683       define variable v-current-char  as character    no-undo.
      684       define variable v-next-char     as character    no-undo.
      685       define variable v-success       as logical      no-undo.
      686   do
      687   on error undo, return error
      688   :
      689       assign
      690           p-out-string = "":U
      691           v-position   = 0
      692       .
      693       replace-cycle:
      694       do while yes
      695       on error undo, return error
      696       :
      697           assign
      698               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      699           .
      700           if v-last-position <= v-position
      701           then do:
      702               if v-position = 0
      703               then do:
      704                   assign
      705                       p-out-string = p-in-string
      706                   .
      707               end.
      708               else do:
      709                   assign
      710                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      711                   .
      712               end.
      713               leave replace-cycle.
      714           end.
      715           else do:
      716               assign
      717                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      718                   v-position      = v-last-position
      719                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      720               .
      721               if v-current-char = "#":U
      722               then do:
      723                   assign
      724                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      725                   .
      726                   if v-last-position > 0
      727                   then do:
      728                       run xmlchar-read-integer in this-procedure
      729                        (
      730                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      731                           , output v-temp-integer
      732                           , output v-success
      733                       ).
      734                       if v-success = yes
      735                       and v-temp-integer >= 1
      736                       and v-temp-integer <= 255
      737                       then do:
      738                           assign
      739                               p-out-string = p-out-string + chr( v-temp-integer )
      740                               v-position   = v-last-position + 1
      741                           .
      742                       end.
      743                       else do:
      744                           assign
      745                               p-out-string = p-out-string + "&":U
      746                               v-position   = v-position   + 1
      747                           .
      748                       end.
      749                   end.
      750                   else do:
      751                       assign
      752                           p-out-string = p-out-string + "&":U
      753                           v-position   = v-position   + 1
      754                       .
      755                   end.
      756               end.
      757               else do:
      758                   case substring( p-in-string, v-position + 1, 3 )
      759                   :
      760                       when "lt;":U
      761                       then do:
      762                           assign
      763                               p-out-string = p-out-string + "<":U
      764                               v-position   = v-position   + 3
      765                           .
      766                       end.
      767                       when "gt;":U
      768                       then do:
      769                           assign
      770                               p-out-string = p-out-string + ">":U
      771                               v-position   = v-position   + 3
      772                           .
      773                       end.
      774                       otherwise do:
      775                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      776                           then do:
      777                               assign
      778                                   p-out-string = p-out-string + "&":U
      779                                   v-position   = v-position   + 4
      780                               .
      781                           end.
      782                           else do:
      783                               case substring( p-in-string, v-position + 1, 5 )
      784                               :
      785                                   when "quot;":U
      786                                   then do:
      787                                       assign
      788                                           p-out-string = p-out-string + '"':U
      789                                           v-position   = v-position   + 5
      790                                       .
      791                                   end.
      792                                   when "apos;":U
      793                                   then do:
      794                                       assign
      795                                           p-out-string = p-out-string + "'":U
      796                                           v-position   = v-position   + 5
      797                                       .
      798                                   end.
      799                                   otherwise do:
      800                                       assign
      801                                           p-out-string = p-out-string + "&":U
      802                                       .
      803                                   end.
      804                               end case.
      805                           end.
      806                       end.
      807                   end case.
      808               end.
      809           end.
      810       end.
      811   end.
      812   end .
      813   procedure xmlchar-read-integer :
      814   define input parameter p-input-string      as character        no-undo.
      815   define output parameter p-output-integer   as integer          no-undo.
      816   define output parameter p-success       as logical          no-undo.
      817   do
      818   on error undo, return error
      819   :
      820       assign
      821           p-output-integer = integer( p-input-string )
      822       no-error.
      823       if error-status :error
      824       then do:
      825           assign
      826               p-success           = no
      827               p-output-integer    = 0
      828           .
      829       end.
      830       else do:
      831           assign
      832               p-success           = yes
      833           .
      834       end.
      835   end.
      836   end.
      837   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      838   procedure strtdate :
      839     define input  parameter p-str         as character no-undo .
      840     define output parameter p-value       as date      no-undo .
      841     define output parameter p-data-valid  as logical   no-undo .
      842     define output parameter p-message     as character no-undo .
      843   do
      844   on error undo, return error return-value
      845   :
      846     define variable v-value       as date      no-undo .
      847     define variable v-i           as integer   no-undo .
      848     define variable v-num         as integer   no-undo .
      849     define variable v-delim       as character no-undo .
      850     define variable v-delim-list  as character no-undo .
      851     define variable v-day         as integer   no-undo .
      852     define variable v-month       as integer   no-undo .
      853     define variable v-year        as integer   no-undo .
      854     define variable v-day-str     as character no-undo .
      855     define variable v-month-str   as character no-undo .
      856     define variable v-year-str    as character no-undo .
      857     assign
      858       p-value       = ?
      859       p-data-valid  = false
      860     .
      861     if p-str = ?
      862     then do:
      863       assign
      864         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      865       .
      866       return .
      867     end.
      868     if p-str = ""
      869     then do:
      870       assign
      871         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      872       .
      873       return .
      874     end.
      875     if length(p-str)  > 10
      876     then do:
      877       assign
      878         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      879       .
      880       return .
      881     end.
      882     assign
      883       v-delim-list = '/,-,.':U
      884     .
      885     _delim:
      886     do v-i = 1 to num-entries( v-delim-list )
      887     :
      888       assign
      889         v-delim = entry( v-i , v-delim-list )
      890         v-num   = num-entries( p-str , v-delim )
      891       .
      892       if v-num <> 3
      893       then do:
      894         assign
      895           v-delim = ''
      896         .
      897       end.
      898       else do:
      899         leave _delim.
      900       end.
      901     end.
      902     if v-delim = ''
      903     then do:
      904       assign
      905         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      906       .
      907       return .
      908     end.
      909     assign
      910       v-day-str   = entry( 1, p-str , v-delim)
      911       v-month-str = entry( 2, p-str , v-delim)
      912       v-year-str  = entry( 3, p-str , v-delim)
      913     .
      914     if  length(v-day-str) > 2   or
      915         length(v-day-str) < 1   or
      916         length(v-month-str) > 2 or
      917         length(v-month-str) < 1 or
      918         (
      919           length(v-year-str) <> 2 and
      920           length(v-year-str) <> 4
      921         )
      922     then do:
      923       assign
      924         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      925       .
      926       return .
      927     end.
      928     if length( v-year-str ) = 2
      929     then do:
      930       assign
      931         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      932       .
      933     end.
      934     assign
      935       v-day   = integer( v-day-str )
      936       v-month = integer( v-month-str)
      937       v-year  = integer( v-year-str)
      938     no-error .
      939     if error-status :error
      940     then do:
      941       assign
      942         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      943       .
      944       return .
      945     end.
      946     if v-day < 1  or
      947        v-day > 31 or
      948        v-month < 1 or
      949        v-month > 12 or
      950        v-year < 0   or
      951        v-year > 5000
      952     then do:
      953       assign
      954         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      955       .
      956       return .
      957     end.
      958     assign
      959       v-value = date( v-month, v-day, v-year )
      960     no-error .
      961     if error-status :error
      962     then do:
      963       assign
      964         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      965       .
      966       return .
      967     end.
      968     assign
      969       p-value       = v-value
      970       p-data-valid  = true
      971     .
      972   end.
      973   end procedure.
      974   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      975   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
      976   define variable v-bge-xml-bgedict       as logical  init no  no-undo.
      977   define variable v-bge-xml-bgeflold      as character         no-undo.
      978   define variable v-bge-xml-bgefmt        as character         no-undo.
      979   define variable v-bge-xml-shift-mode    as logical           no-undo.
      980   define variable v-bge-xml-bgeflnm-doc   as character         no-undo.
      981   define variable v-bge-xml-bgeflnm-day   as character         no-undo.
      982   define variable v-bge-xml-log-file-name as character    no-undo.
      983   define variable v-bge-xml-dbf-file-name as character    no-undo.
      984   define variable v-bge-xml-db-num-str    as character    no-undo .
      985   define variable v-bge-xml-static-log-file-name as character    no-undo.
      986   define temp-table temp_ext-doc-type no-undo
