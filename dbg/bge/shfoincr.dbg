        1   block-level on error undo, throw.
        2   define input parameter p-db-num         as integer    no-undo.
        3   define input parameter p-range          as integer    no-undo.
        4   define input parameter p-obj-list       as character  no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: shfoincr.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: bge/shfoincr.p $":U .
       10   define variable vss-description as character no-undo init "Инкрементальный экспорт во Внешнюю Бухгалтерию ФО".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   define  temp-table temp-host no-undo
       82     field host-code like ub.store.host-code
       83     index xpk host-code
       84   .
       85   define  temp-table temp-obj no-undo
       86     field obj-type  like ub.clients.obj-type
       87     field obj-code  like ub.clients.obj-code
       88     field host-code like ub.store.host-code
       89     field db-num    like ub.clients.db-num
       90     index xpk  obj-type obj-code
       91     index xie1 host-code
       92     index xie2 db-num host-code
       93   .
       94   procedure init-temphost:
       95     define buffer buf_store   for ub.store .
       96     define buffer buf_shop    for ub.shop .
       97     define buffer buf_clients for ub.clients .
       98     define buffer buf_db for ub.db .
       99     define buffer buf_temp-host for temp-host .
      100     define buffer buf_temp-obj for temp-obj .
      101     do
      102     on error undo, return error return-value
      103     :
      104       for each buf_store
      105       on error undo, return error
      106       :
      107         find first buf_temp-host
      108           where buf_temp-host.host-code = buf_store.host-code
      109           no-error .
      110         if not available buf_temp-host
      111         then do:
      112           create buf_temp-host .
      113           assign
      114             buf_temp-host.host-code = buf_store.host-code
      115           .
      116         end.
      117         find first buf_clients no-lock
      118           where buf_clients.obj-type = 'скл':U
      119             and buf_clients.obj-code = buf_store.obj-code
      120           no-error .
      121         if not available buf_clients
      122         then do:
      123           message
      124             "Ошибка при поиске клиента" skip
      125             "Клиент" 'скл':U buf_store.obj-code skip
      126             view-as alert-box error .
      127           undo, return error .
      128         end.
      129         create buf_temp-obj .
      130         assign
      131           buf_temp-obj.obj-type  = 'скл':U
      132           buf_temp-obj.obj-code  = buf_store.obj-code
      133           buf_temp-obj.host-code = buf_store.host-code
      134           buf_temp-obj.db-num    = buf_clients.db-num
      135         .
      136       end.
      137       for each buf_shop
      138       on error undo, return error
      139       :
      140         find first buf_temp-host
      141           where buf_temp-host.host-code = buf_shop.host-code
      142           no-error .
      143         if not available buf_temp-host
      144         then do:
      145           create buf_temp-host .
      146           assign
      147             buf_temp-host.host-code = buf_shop.host-code
      148           .
      149         end.
      150         find first buf_clients no-lock
      151           where buf_clients.obj-type = 'маг':U
      152             and buf_clients.obj-code = buf_shop.obj-code
      153           no-error .
      154         if not available buf_clients then do:
      155           message
      156             "Ошибка при поиске клиента" skip
      157             "Клиент" 'маг':U buf_shop.obj-code skip
      158             view-as alert-box error .
      159           undo, return error .
      160         end.
      161         create buf_temp-obj .
      162         assign
      163           buf_temp-obj.obj-type  = 'маг':U
      164           buf_temp-obj.obj-code  = buf_shop.obj-code
      165           buf_temp-obj.host-code = buf_shop.host-code
      166           buf_temp-obj.db-num    = buf_clients.db-num
      167         .
      168       end.
      169     end.
      170   end.
      171   define variable vss-include-info1 as character format "X(65)" no-undo
      172   initial "@(#)$Workfile$ $Revision$".
      173   DEF STREAM stmXMLOut.
      174   DEF STREAM stmXMLLog.
      175   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      176   procedure cur-time :
      177      define output parameter p-today as date      no-undo .
      178      define output parameter p-time  as integer   no-undo .
      179     do
      180     on error undo, return error
      181     :
      182       define variable v-date1 as date      no-undo .
      183       define variable v-date2 as date      no-undo .
      184       define variable v-time  as integer   no-undo .
      185       assign
      186         v-date1 = today
      187         v-time  = time
      188         v-date2 = today
      189       .
      190       if v-date1 <> v-date2
      191       then do:
      192         assign
      193           v-date1 = today
      194           v-time  = v-time
      195         .
      196       end.
      197       assign
      198         p-today = v-date1
      199         p-time  = v-time
      200       .
      201     end.
      202   end.
      203   function cur-time-date returns character
      204   :
      205     return string(today, '99/99/9999':U) .
      206   end.
      207   function cur-time-mjd returns decimal
      208   :
      209     define variable v-date as date      no-undo .
      210     define variable v-time as integer   no-undo .
      211     run cur-time in this-procedure
      212       (output v-date
      213       ,output v-time
      214       ) .
      215     return integer(v-date) - 2400002 + (v-time / 86400) .
      216   end.
      217   function cur-time-get-ending-index returns integer
      218   (input p-number as integer
      219   )
      220   :
      221     if p-number < 0
      222     or p-number = ?
      223     then do:
      224       return 1 .
      225     end.
      226     define variable v-rest as integer   no-undo .
      227     assign
      228       p-number = p-number modulo 100
      229     .
      230     if p-number < 20
      231     then do:
      232       assign
      233         v-rest = p-number
      234       .
      235     end.
      236     else do:
      237       assign
      238         v-rest = p-number modulo 10
      239       .
      240     end.
      241     case v-rest :
      242       when 1
      243       then do:
      244         return 2 .
      245       end.
      246       when 2 or
      247       when 3 or
      248       when 4
      249       then do:
      250         return 3 .
      251       end.
      252       otherwise do:
      253         return 1 .
      254       end.
      255     end case .
      256   end.
      257   procedure cur-time-mjd-to-date :
      258      define input  parameter i-mjd-diff as decimal no-undo.
      259      define output parameter o-Date     as date    no-undo.
      260      define output parameter o-Time     as integer no-undo.
      261      define variable v-day-number as integer   no-undo .
      262      if    i-mjd-diff < 0
      263         or i-mjd-diff = ?
      264      then do:
      265         return "?" .
      266      end.
      267      assign
      268         v-day-number = truncate(i-mjd-diff,0).
      269         o-Date = date(v-day-number + 2400002).
      270         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      271     .
      272   end.
      273   function cur-time-mjd-to-string returns character
      274   (input p-mjd-diff as decimal
      275   )
      276   :
      277     define variable v-day-number as integer   no-undo .
      278     define variable v-seconds    as integer   no-undo .
      279     define variable v-hour       as integer   no-undo .
      280     define variable v-min        as integer   no-undo .
      281     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      282     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      283     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      284     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      285     if p-mjd-diff < 0
      286     or p-mjd-diff = ?
      287     then do:
      288       return "?" .
      289     end.
      290     assign
      291       v-day-number = integer(truncate(p-mjd-diff,0))
      292       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      293     .
      294     if v-seconds > 86400
      295     then do:
      296       assign
      297         v-seconds = 86400 - 1
      298       .
      299     end.
      300     if v-seconds < 0
      301     then do:
      302       assign
      303         v-seconds = 0
      304       .
      305     end.
      306     assign
      307       v-hour = truncate(v-seconds / 3600, 0)
      308     .
      309     assign
      310       v-seconds = v-seconds modulo 3600
      311     .
      312     assign
      313       v-min = truncate(v-seconds / 60, 0)
      314     .
      315     assign
      316       v-seconds = v-seconds modulo 60
      317     .
      318     return
      319         (if v-day-number <> 0
      320           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      321           else ""
      322         )
      323       + (if v-day-number <> 0 or v-hour <> 0
      324           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      325           else ""
      326         )
      327       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      328           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      329           else ""
      330         )
      331       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      332       .
      333   end.
      334   function cur-time-string returns character
      335   :
      336     define variable v-date as date      no-undo .
      337     define variable v-time as integer   no-undo .
      338     run cur-time in this-procedure
      339       (output v-date
      340       ,output v-time
      341       ) .
      342     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      343   end.
      344   function cur-time-string-sec returns character
      345   :
      346     define variable v-date as date      no-undo .
      347     define variable v-time as integer   no-undo .
      348     run cur-time in this-procedure
      349       (output v-date
      350       ,output v-time
      351       ) .
      352     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      353   end.
      354   function cur-time-custom  returns character
      355   (input p-prefix as character
      356   ,input p-date-format as character
      357   ,input p-delimiter as character
      358   ,input p-time-format as character
      359   ,input p-suffix as character
      360   )
      361   :
      362     define variable v-date as date      no-undo .
      363     define variable v-time as integer   no-undo .
      364     run cur-time in this-procedure
      365       (output v-date
      366       ,output v-time
      367       ) .
      368     return
      369       p-prefix
      370       + string(v-date, p-date-format)
      371       + p-delimiter
      372       + string(v-time, p-time-format)
      373       + p-suffix
      374       .
      375   end.
      376   function cur-time-print  returns character
      377   :
      378     define variable v-date as date      no-undo .
      379     define variable v-time as integer   no-undo .
      380     run cur-time in this-procedure
      381       (output v-date
      382       ,output v-time
      383       ) .
      384     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      385   end.
      386   function cur-time-datetime returns datetime
      387   :
      388     define variable v-char as character no-undo .
      389     define variable v-datetime as datetime no-undo .
      390     v-char = cur-time-string().
      391     v-datetime = datetime(v-char).
      392     return  v-datetime.
      393   end.
      394   function cur-time-string-msec returns character
      395   :
      396     define variable v-date as datetime  no-undo .
      397     v-date = now.
      398     return string(v-date) .
      399   end.
      400   define variable vss-include-info3 as character format "X(65)" no-undo
      401   initial "@(#)$Workfile$ $Revision$".
      402   procedure xmlchar-test :
      403   define input parameter p-in-string          as character        no-undo.
      404   define output parameter p-out-string-enc    as character        no-undo.
      405   define output parameter p-out-string-dec    as character        no-undo.
      406   do
      407   on error undo, return error
      408   :
      409          run xmlchar-encode in this-procedure
      410       (
      411             input p-in-string
      412           , output p-out-string-enc
      413       ).
      414          run xmlchar-decode in this-procedure
      415       (
      416             input p-out-string-enc
      417           , output p-out-string-dec
      418       ).
      419   end.
      420   end .
      421   procedure xmlchar-encode :
      422   define input parameter p-in-string      as character        no-undo.
      423   define output parameter p-out-string    as character        no-undo.
      424       define variable v-position      as integer      no-undo.
      425       define variable v-current-char  as character    no-undo.
      426   do
      427   on error undo, return error
      428   :
      429       assign
      430           p-out-string = "":U
      431       .
      432       case p-in-string
      433       :
      434           when ?
      435           then do:
      436               assign
      437                   p-out-string = "?":U
      438               .
      439           end.
      440           when "?":U
      441           then do:
      442               assign
      443                   p-out-string = "&#63;":U
      444               .
      445           end.
      446           otherwise do:
      447               do v-position = 1 to length( p-in-string )
      448               :
      449                   assign
      450                       v-current-char = substring( p-in-string, v-position, 1 )
      451                   .
      452                   case v-current-char
      453                   :
      454                       when "&":U
      455                       then do:
      456                           assign
      457                               p-out-string = p-out-string + "&amp;":U
      458                           .
      459                       end.
      460                       when ">":U
      461                       then do:
      462                           assign
      463                               p-out-string = p-out-string + "&gt;":U
      464                           .
      465                       end.
      466                       when "<":U
      467                       then do:
      468                           assign
      469                               p-out-string = p-out-string + "&lt;":U
      470                           .
      471                       end.
      472                       when "'":U
      473                       then do:
      474                           assign
      475                               p-out-string = p-out-string + "&apos;":U
      476                           .
      477                       end.
      478                       when '"':U
      479                       then do:
      480                           assign
      481                               p-out-string = p-out-string + "&quot;":U
      482                           .
      483                       end.
      484                       when chr(1)
      485                       then do:
      486                           assign
      487                               p-out-string = p-out-string + "":U
      488                           .
      489                       end.
      490                       when chr(2)
      491                       then do:
      492                           assign
      493                               p-out-string = p-out-string + "":U
      494                           .
      495                       end.
      496                       when chr(3)
      497                       then do:
      498                           assign
      499                               p-out-string = p-out-string + "":U
      500                           .
      501                       end.
      502                       when chr(4)
      503                       then do:
      504                           assign
      505                               p-out-string = p-out-string + "":U
      506                           .
      507                       end.
      508                       when chr(5)
      509                       then do:
      510                           assign
      511                               p-out-string = p-out-string + "":U
      512                           .
      513                       end.
      514                       when chr(6)
      515                       then do:
      516                           assign
      517                               p-out-string = p-out-string + "":U
      518                           .
      519                       end.
      520                       when chr(7)
      521                       then do:
      522                           assign
      523                               p-out-string = p-out-string + "":U
      524                           .
      525                       end.
      526                       when chr(8)
      527                       then do:
      528                           assign
      529                               p-out-string = p-out-string + "":U
      530                           .
      531                       end.
      532                       when chr(9)
      533                       then do:
      534                           assign
      535                               p-out-string = p-out-string + "":U
      536                           .
      537                       end.
      538                       when chr(29)
      539                       then do:
      540                           assign
      541                               p-out-string = p-out-string + "":U
      542                           .
      543                       end.
      544                       when chr(10)
      545                       then do:
      546                           assign
      547                               p-out-string = p-out-string + "&#10;":U
      548                           .
      549                       end.
      550                       when chr(13)
      551                       then do:
      552                           assign
      553                               p-out-string = p-out-string + "&#13;":U
      554                           .
      555                       end.
      556                       otherwise do:
      557                           assign
      558                               p-out-string = p-out-string + v-current-char
      559                           .
      560                       end.
      561                   end case.
      562               end.
      563           end.
      564       end case.
      565   end.
      566   end .
      567   procedure xmlchar-encode-1c :
