      379   procedure cur-time :
      380      define output parameter p-today as date      no-undo .
      381      define output parameter p-time  as integer   no-undo .
      382     do
      383     on error undo, return error
      384     :
      385       define variable v-date1 as date      no-undo .
      386       define variable v-date2 as date      no-undo .
      387       define variable v-time  as integer   no-undo .
      388       assign
      389         v-date1 = today
      390         v-time  = time
      391         v-date2 = today
      392       .
      393       if v-date1 <> v-date2
      394       then do:
      395         assign
      396           v-date1 = today
      397           v-time  = v-time
      398         .
      399       end.
      400       assign
      401         p-today = v-date1
      402         p-time  = v-time
      403       .
      404     end.
      405   end.
      406   function cur-time-date returns character
      407   :
      408     return string(today, '99/99/9999':U) .
      409   end.
      410   function cur-time-mjd returns decimal
      411   :
      412     define variable v-date as date      no-undo .
      413     define variable v-time as integer   no-undo .
      414     run cur-time in this-procedure
      415       (output v-date
      416       ,output v-time
      417       ) .
      418     return integer(v-date) - 2400002 + (v-time / 86400) .
      419   end.
      420   function cur-time-get-ending-index returns integer
      421   (input p-number as integer
      422   )
      423   :
      424     if p-number < 0
      425     or p-number = ?
      426     then do:
      427       return 1 .
      428     end.
      429     define variable v-rest as integer   no-undo .
      430     assign
      431       p-number = p-number modulo 100
      432     .
      433     if p-number < 20
      434     then do:
      435       assign
      436         v-rest = p-number
      437       .
      438     end.
      439     else do:
      440       assign
      441         v-rest = p-number modulo 10
      442       .
      443     end.
      444     case v-rest :
      445       when 1
      446       then do:
      447         return 2 .
      448       end.
      449       when 2 or
      450       when 3 or
      451       when 4
      452       then do:
      453         return 3 .
      454       end.
      455       otherwise do:
      456         return 1 .
      457       end.
      458     end case .
      459   end.
      460   procedure cur-time-mjd-to-date :
      461      define input  parameter i-mjd-diff as decimal no-undo.
      462      define output parameter o-Date     as date    no-undo.
      463      define output parameter o-Time     as integer no-undo.
      464      define variable v-day-number as integer   no-undo .
      465      if    i-mjd-diff < 0
      466         or i-mjd-diff = ?
      467      then do:
      468         return "?" .
      469      end.
      470      assign
      471         v-day-number = truncate(i-mjd-diff,0).
      472         o-Date = date(v-day-number + 2400002).
      473         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      474     .
      475   end.
      476   function cur-time-mjd-to-string returns character
      477   (input p-mjd-diff as decimal
      478   )
      479   :
      480     define variable v-day-number as integer   no-undo .
      481     define variable v-seconds    as integer   no-undo .
      482     define variable v-hour       as integer   no-undo .
      483     define variable v-min        as integer   no-undo .
      484     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      485     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      486     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      487     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      488     if p-mjd-diff < 0
      489     or p-mjd-diff = ?
      490     then do:
      491       return "?" .
      492     end.
      493     assign
      494       v-day-number = integer(truncate(p-mjd-diff,0))
      495       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      496     .
      497     if v-seconds > 86400
      498     then do:
      499       assign
      500         v-seconds = 86400 - 1
      501       .
      502     end.
      503     if v-seconds < 0
      504     then do:
      505       assign
      506         v-seconds = 0
      507       .
      508     end.
      509     assign
      510       v-hour = truncate(v-seconds / 3600, 0)
      511     .
      512     assign
      513       v-seconds = v-seconds modulo 3600
      514     .
      515     assign
      516       v-min = truncate(v-seconds / 60, 0)
      517     .
      518     assign
      519       v-seconds = v-seconds modulo 60
      520     .
      521     return
      522         (if v-day-number <> 0
      523           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      524           else ""
      525         )
      526       + (if v-day-number <> 0 or v-hour <> 0
      527           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      528           else ""
      529         )
      530       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      531           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      532           else ""
      533         )
      534       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      535       .
      536   end.
      537   function cur-time-string returns character
      538   :
      539     define variable v-date as date      no-undo .
      540     define variable v-time as integer   no-undo .
      541     run cur-time in this-procedure
      542       (output v-date
      543       ,output v-time
      544       ) .
      545     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      546   end.
      547   function cur-time-string-sec returns character
      548   :
      549     define variable v-date as date      no-undo .
      550     define variable v-time as integer   no-undo .
      551     run cur-time in this-procedure
      552       (output v-date
      553       ,output v-time
      554       ) .
      555     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      556   end.
      557   function cur-time-custom  returns character
      558   (input p-prefix as character
      559   ,input p-date-format as character
      560   ,input p-delimiter as character
      561   ,input p-time-format as character
      562   ,input p-suffix as character
      563   )
      564   :
      565     define variable v-date as date      no-undo .
      566     define variable v-time as integer   no-undo .
      567     run cur-time in this-procedure
      568       (output v-date
      569       ,output v-time
      570       ) .
      571     return
      572       p-prefix
      573       + string(v-date, p-date-format)
      574       + p-delimiter
      575       + string(v-time, p-time-format)
      576       + p-suffix
      577       .
      578   end.
      579   function cur-time-print  returns character
      580   :
      581     define variable v-date as date      no-undo .
      582     define variable v-time as integer   no-undo .
      583     run cur-time in this-procedure
      584       (output v-date
      585       ,output v-time
      586       ) .
      587     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      588   end.
      589   function cur-time-datetime returns datetime
      590   :
      591     define variable v-char as character no-undo .
      592     define variable v-datetime as datetime no-undo .
      593     v-char = cur-time-string().
      594     v-datetime = datetime(v-char).
      595     return  v-datetime.
      596   end.
      597   function cur-time-string-msec returns character
      598   :
      599     define variable v-date as datetime  no-undo .
      600     v-date = now.
      601     return string(v-date) .
      602   end.
      603   define stream LogStream .
      604   define variable mNoTime as logical no-undo.
      605   procedure write-to-log-notime :
      606     define input param i-str as character no-undo .
      607     mNoTime = yes.
      608     run write-to-log (i-str).
      609     mNoTime = no.
      610   end.
      611   procedure write-to-log :
      612     define input param p-str as character no-undo .
      613     do
      614     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      615     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      616     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      617     :
      618       define variable log-res        as logical   no-undo .
      619       define variable v-jj           as integer   no-undo .
      620       if    mNoTime
      621          or writelogvalue eq "AsyncProc"
      622       then
      623          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      624       else
      625          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      626       if auto-log-msg-h <> ? then do:
      627         log-res = auto-log-msg-h:move-to-eof( ) .
      628         log-res = auto-log-msg-h:insert-string( p-str ).
      629       end.
      630       if hand-log-msg-h <> ? then do:
      631         log-res = hand-log-msg-h:move-to-eof( ) .
      632         log-res = hand-log-msg-h:insert-string( p-str ).
      633       end.
      634       assign
      635         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      636         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      637         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      638       .
      639       if add-log-file-name <> ? then do:
      640         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      641           run gbl/fileapnd.p
      642             ( input entry(v-jj, add-log-file-name, chr(1) )
      643             ,input p-str
      644             ,input 20
      645             ) no-error .
      646           if error-status:error then do:
      647             return error return-value .
      648           end.
      649         end.
      650       end.
      651       if writelogvalue eq "AsyncProc"
      652       then do:
      653          p-str = trim(p-str, (chr(13) + chr(10)) )
      654       .
      655          Publish "WriteLogAsunc" (p-str,yes).
      656       end.
      657       else if writelogvalue <> "yes" then do:
      658         run gbl/fileapnd.p
      659           ( input log-file-name
      660           ,input p-str
      661           ,input 20
      662           ) no-error .
      663         if error-status:error then do:
      664           return error return-value .
      665         end.
      666       end.
      667     end.
      668   end procedure.
      669   procedure write-to-screen :
      670     define input param p-str as character no-undo .
      671     do
      672     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      673     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      674     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      675     :
      676       define variable log-res as logical no-undo.
      677       assign
      678         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      679       .
      680       if auto-log-msg-h <> ?
      681       then do:
      682         log-res = auto-log-msg-h:move-to-eof( ) .
      683         log-res = auto-log-msg-h:insert-string( p-str ).
      684       end.
      685       if hand-log-msg-h <> ?
      686       then do:
      687         log-res = hand-log-msg-h:move-to-eof( ) .
      688         log-res = hand-log-msg-h:insert-string( p-str ).
      689       end.
      690     end.
      691   end procedure.
      692   procedure send-msg-to-email :
      693     define input  parameter p-subject      as character no-undo .
      694     define input  parameter p-text-err     as character no-undo .
      695     define input  parameter p-attach-files as character no-undo .
      696     do
      697     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      698     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      699     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      700     :
      701       define variable v-tth             as handle    no-undo .
      702       define variable v-value-character as character no-undo .
      703       define variable v-value-date      as date      no-undo .
      704       define variable v-value-decimal   as decimal   no-undo .
      705       define variable v-value-integer   as integer   no-undo .
      706       define variable v-value-logical   as logical   no-undo .
      707       define variable v-param-type      as character no-undo .
      708       define variable v-email       as character no-undo .
      709       define variable v-tmp-str     as character no-undo .
      710       define variable v-tmp1-str    as character no-undo .
      711       define variable v-ind         as integer   no-undo .
      712       define variable v-num-entries as integer   no-undo .
      713       delete object v-tth no-error.
      714       run adm/shattri.p
      715         ( input "get":U
      716          ,input  "":U
      717          ,input  0
      718          ,input  'auto-task':U
      719          ,input  'send-msg-to-email':U
      720          ,output v-value-character
      721          ,output v-value-date
      722          ,output v-value-decimal
      723          ,output v-value-integer
      724          ,output v-value-logical
      725          ,output v-param-type
      726          ,input-output table-handle v-tth
      727         ) no-error .
      728       if not error-status :error  then do:
      729         assign
      730           v-tmp-str = v-value-character
      731         .
      732       end.
      733       delete object v-tth no-error.
      734       assign
      735         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      736         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      737         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      738         v-num-entries = num-entries( v-tmp-str, chr(44) )
      739         v-email       = "":U
      740       .
      741       do v-ind = 1 to v-num-entries
      742       :
      743         assign
      744           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      745         .
      746         if trim( v-tmp1-str ) <> "":U then do:
      747           if v-email = "":U then do:
      748             assign
      749               v-email = v-tmp1-str
      750             .
      751           end.
      752           else do:
      753             assign
      754               v-email = v-email + chr(44) + v-tmp1-str
      755             .
      756           end.
      757         end.
      758       end.
      759       if v-email <> "":U then do:
      760         run gbl/sendmail.p
      761           ( input v-email
      762           , input p-subject
      763           , input p-text-err
      764           , input p-attach-files
      765           ) no-error .
      766         if error-status :error
      767           or return-value <> "":U
      768         then do:
      769           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      770         end.
      771       end.
      772     end.
      773   end procedure.
      774   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      775   define temp-table temp-schedule-free no-undo
      776   field free-id as character
      777   field free-task-name as character
      778   field proc-run-name as character
      779   field proc-param-edit-name as character
      780   field conf-param as character
      781   field is-gbd as logical
      782   field is-ubd as logical
      783   field enable-concurrent-0 as logical
      784   field enable-concurrent-db as logical
      785   field other-info as character
      786   field enc-key as character
      787   field is-rum as logical
      788   index pi is unique primary
      789   free-id.
      790   procedure schedule-attr-name :
      791   do
      792     on error undo, return error
      793     :
      794     define input  parameter p-code           as character no-undo .
      795     define output parameter p-type           as character no-undo .
      796     define output parameter p-format         as character no-undo .
      797     define output parameter p-label          as character no-undo .
      798     define output parameter p-user-can-edit  as logical   no-undo .
      799     define output parameter p-output-display as logical   no-undo .
      800     define output parameter p-other          as character no-undo .
      801       if index(p-code, chr(4)) > 0 then do:
      802         p-code = entry(1, p-code, chr(4)).
      803       end.
      804       case p-code :
      805               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      806               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      807               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      808               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      809               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      810               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      811               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      812               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      813               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      814         otherwise do:
      815           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      816         end.
      817       end.
      818     end.
      819   end procedure.
      820   procedure schedule-attr-tooltip :
      821   do
      822     on error undo, return error
      823     :
      824       define input  parameter p-code    as character no-undo .
      825       define output parameter p-tooltip as character no-undo .
      826       define output parameter p-label   as character no-undo .
      827       if index(p-code, chr(4)) > 0 then do:
      828         p-code = entry(1, p-code, chr(4)).
      829       end.
      830       case p-code :
      831               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      832               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      833               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      834               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      835               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      836               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      837               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      838               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      839               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      840         otherwise do:
      841               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      842         end.
      843       end.
      844     end.
      845   end procedure.
      846   procedure schedule-attr-value :
      847   do
      848   on error undo, return error return-value
      849   :
      850   define input parameter  p-cre-db-num as integer    no-undo.
      851   define input parameter  p-task-type  as character  no-undo.
      852   define input parameter  p-task-num   as integer    no-undo.
      853   define input parameter  p-code       as character  no-undo.
      854   define output parameter p-value      as character  no-undo.
      855   define output parameter p-type       as character  no-undo.
      856       define variable v-format         as character no-undo .
      857       define variable v-label          as character no-undo .
      858       define variable v-user-can-edit  as logical   no-undo .
      859       define variable v-output-display as logical   no-undo .
      860       define variable v-other          as character no-undo .
      861       define buffer buf_schedule-attr for ub.schedule-attr.
      862       run schedule-attr-name in this-procedure (
      863             input  p-code
      864           , output p-type
      865           , output v-format
      866           , output v-label
      867           , output v-user-can-edit
      868           , output v-output-display
      869           , output v-other
      870       ) no-error .
      871       if error-status :error
      872       then do:
      873           undo, return error return-value .
      874       end.
      875       if p-code begins ('schd-free-id':U + chr(4))
      876       and entry(2, p-code, chr(4)) = '':U then do:
      877         find first buf_schedule-attr no-lock
      878             where buf_schedule-attr.cre-db-num = p-cre-db-num
      879               and buf_schedule-attr.task-type  = p-task-type
      880               and buf_schedule-attr.task-num   = p-task-num
      881               and buf_schedule-attr.attr-code  begins p-code
      882         no-error .
      883       end.
      884       else do:
      885         find first buf_schedule-attr no-lock
      886             where buf_schedule-attr.cre-db-num = p-cre-db-num
      887               and buf_schedule-attr.task-type  = p-task-type
      888               and buf_schedule-attr.task-num   = p-task-num
      889               and buf_schedule-attr.attr-code  = p-code
      890         no-error .
      891       end.
      892       if available buf_schedule-attr
      893       then do:
      894           assign
      895               p-value = buf_schedule-attr.attr-value
      896           .
      897       end.
      898       else do:
      899         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      900            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      901         end.
      902         else do:
      903           assign
      904               p-value = if p-type = 'L':U then "no":U else ""
      905           .
      906         end.
      907       end.
      908   end.
      909   end procedure.
      910   procedure schedule-attr-write :
      911   do
      912   on error undo, return error
      913   :
      914   define input parameter p-cre-db-num  as integer   no-undo.
      915   define input parameter p-task-type   as character no-undo.
      916   define input parameter p-task-num    as integer   no-undo.
      917   define input parameter p-code        as character no-undo.
      918   define input parameter p-value       as character no-undo.
      919       define variable v-type              as character                no-undo.
      920       define variable v-format            as character                no-undo.
      921       define variable v-label             as character                no-undo.
      922       define variable v-user-can-edit     as logical                  no-undo.
      923       define variable v-output-display    as logical                  no-undo.
      924       define variable v-other             as character                no-undo.
      925       define buffer buf_schedule-attr for ub.schedule-attr .
      926       run schedule-attr-name in this-procedure (
      927             input  p-code
      928           , output v-type
      929           , output v-format
      930           , output v-label
      931           , output v-user-can-edit
      932           , output v-output-display
      933           , output v-other
      934       ) no-error.
      935       if error-status :error
      936       then do:
      937           undo, return error return-value.
      938       end.
      939       find first buf_schedule-attr exclusive-lock
      940            where buf_schedule-attr.cre-db-num = p-cre-db-num
      941              and buf_schedule-attr.task-type  = p-task-type
      942              and buf_schedule-attr.task-num   = p-task-num
      943              and buf_schedule-attr.attr-code  = p-code
      944       no-error.
      945       if not available buf_schedule-attr
      946       then do:
      947           create buf_schedule-attr.
      948           assign
      949             buf_schedule-attr.cre-db-num = p-cre-db-num
      950             buf_schedule-attr.task-type  = p-task-type
      951             buf_schedule-attr.task-num   = p-task-num
      952             buf_schedule-attr.attr-code  = p-code
      953             buf_schedule-attr.attr-value = p-value
      954           .
      955       end.
      956       else do:
      957           assign
      958               buf_schedule-attr.attr-value = p-value
      959           .
      960       end.
      961   end.
      962   end procedure.
      963   procedure schedule-attr-delete :
      964   do
      965   on error undo, return error
      966   :
      967   define input  parameter p-cre-db-num  as integer   no-undo.
      968   define input  parameter p-task-type   as character no-undo.
      969   define input  parameter p-task-num    as integer   no-undo.
      970   define input  parameter p-code        as character no-undo.
      971   define output parameter p-deleted     as logical   no-undo.
      972       define buffer buf_schedule-attr for ub.schedule-attr .
      973       define variable v-type              as character                no-undo.
      974       define variable v-format            as character                no-undo.
      975       define variable v-label             as character                no-undo.
      976       define variable v-user-can-edit     as logical                  no-undo.
      977       define variable v-output-display    as logical                  no-undo.
      978       define variable v-other             as character                no-undo.
      979       run schedule-attr-name in this-procedure (
      980             input p-code
      981           , output v-type
      982           , output v-format
      983           , output v-label
      984           , output v-user-can-edit
      985           , output v-output-display
      986           , output v-other
      987       ) no-error .
      988       if error-status :error
      989       then do:
      990           undo, return error return-value .
      991       end.
      992       find first buf_schedule-attr exclusive-lock
      993            where buf_schedule-attr.cre-db-num = p-cre-db-num
      994              and buf_schedule-attr.task-type  = p-task-type
      995              and buf_schedule-attr.task-num   = p-task-num
      996              and buf_schedule-attr.attr-code  = p-code
      997       no-error.
      998       if not available buf_schedule-attr
      999       then do:
     1000           assign
     1001               p-deleted = no
     1002           .
     1003       end.
     1004       else do:
     1005           delete buf_schedule-attr.
     1006           assign
     1007               p-deleted = yes
     1008           .
     1009       end.
     1010   end.
     1011   end procedure.
     1012   procedure schedule-attr-news :
     1013   do
     1014   on error undo, return error
     1015   :
     1016       define input  parameter p-code           as character no-undo .
     1017       define output parameter p-news           as logical   no-undo .
     1018       if index(p-code, chr(4)) > 0 then do:
     1019         p-code = entry(1, p-code, chr(4)).
     1020       end.
     1021       case p-code :
     1022               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
     1023               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
     1024               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
     1025               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
     1026               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
     1027               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
     1028               when 'schedule-filter':U then do:     assign     p-news = false.   end.
     1029               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
     1030               when 'schd-free-id':U then do:     assign     p-news = false.   end.
     1031         otherwise do:
     1032           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
     1033         end.
     1034       end.
     1035   end.
     1036   end procedure.
     1037   procedure schedule-attr-extract-logical :
     1038   do
     1039   on error undo, return error
     1040   :
     1041   define input  parameter p-parameter-number   as integer      no-undo.
     1042   define input  parameter p-parameter-list     as character    no-undo.
     1043   define output parameter p-parameter-value   as logical      no-undo.
     1044       if num-entries( p-parameter-list ) > p-parameter-number - 1
     1045       then do:
     1046           assign
     1047               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
     1048           .
     1049       end.
     1050       else do:
     1051           assign
     1052               p-parameter-value   = no
     1053           .
     1054       end.
     1055   end.
     1056   end procedure.
     1057   procedure schedule-attr-get-free-id :
     1058   do
     1059   on error undo, return error return-value
     1060   :
     1061     define input  parameter p-cre-db-num  as integer   no-undo.
     1062     define input  parameter p-task-type   as character no-undo.
     1063     define input  parameter p-task-num    as integer   no-undo.
     1064     define output parameter p-free-id     as character no-undo.
     1065     define buffer buf_schedule-attr for ub.schedule-attr.
     1066     find first buf_schedule-attr no-lock
     1067         where buf_schedule-attr.cre-db-num = p-cre-db-num
     1068           and buf_schedule-attr.task-type  = p-task-type
     1069           and buf_schedule-attr.task-num   = p-task-num
     1070           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
     1071     no-error .
     1072     if available buf_schedule-attr then
     1073     assign
     1074     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
     1075     no-error
     1076     .
     1077   end.
     1078   end procedure.
     1079   procedure schedule-attr-get-free-props :
     1080     define input parameter p-free-id as character no-undo .
     1081     define output parameter p-value as character no-undo .
     1082     define buffer buf_temp-schedule-free for temp-schedule-free.
     1083     do
     1084     on error undo, return error return-value
     1085     :
     1086       find first buf_temp-schedule-free no-lock no-error .
     1087       if not available buf_temp-schedule-free then do:
     1088         run schedule-attr-fill-free-props in this-procedure .
     1089       end.
     1090       find first buf_temp-schedule-free where
     1091               buf_temp-schedule-free.free-id = p-free-id no-error.
     1092       if available buf_temp-schedule-free then do:
     1093         assign
     1094         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
     1095                   buf_temp-schedule-free.proc-run-name        + chr(4) +
     1096                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
     1097                   buf_temp-schedule-free.conf-param           + chr(4) +
     1098                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
     1099                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
     1100                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
     1101                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
     1102                   buf_temp-schedule-free.other-info
     1103         .
     1104       end.
     1105       else do:
     1106        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
     1107                              "id произвольной задачи - &5"
     1108                              ,vss-workfile
     1109                              ,vss-revision
     1110                              ,vss-description
     1111                              ,chr(10)
     1112                              ,p-free-id).
     1113       end.
     1114     end.
     1115   end procedure.
     1116   procedure schedule-attr-is-rum-free-id :
     1117   define input parameter p-free-id as character no-undo .
     1118   define output parameter p-is-rum as logical no-undo .
     1119   define buffer buf_temp-schedule-free for temp-schedule-free.
     1120   do
     1121   on error undo, return error
     1122   :
     1123       find first buf_temp-schedule-free no-lock no-error .
     1124       if not available buf_temp-schedule-free then do:
     1125         run schedule-attr-fill-free-props in this-procedure .
     1126       end.
     1127       find first buf_temp-schedule-free where
     1128               buf_temp-schedule-free.free-id = p-free-id no-error.
     1129       if available buf_temp-schedule-free
     1130       and buf_temp-schedule-free.is-rum
     1131       then do:
     1132         p-is-rum = yes.
     1133       end.
     1134   end.
     1135   end procedure.
     1136   procedure schedule-attr-fill-free-props :
     1137   define variable v-path                    as character                no-undo .
     1138   DEFINE VARIABLE v-full-path               as character                no-undo .
     1139   DEFINE VARIABLE v-file-name               as character                no-undo .
     1140   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     1141   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     1142   define buffer buf_temp-schedule-free for temp-schedule-free.
     1143   define variable v-answer as logical no-undo .
     1144     do
     1145     on error undo, return error substitute("&1 &2 &3&4&5&4"
     1146                                           ,vss-workfile
     1147                                           ,vss-revision
     1148                                           ,vss-description
     1149                                           ,chr(10)
     1150                                           ,error-status:get-message(1) )
     1151     :
     1152       run gbl/filename.p (
     1153                       input 'cmp/shd-free.d'
     1154                     ,output v-full-path
     1155                     ,output v-path
     1156                     ,output v-file-name
     1157                     ,output v-file-name-no-ext
     1158                     ,output v-file-name-ext
     1159                     ) .
     1160       input from value(v-full-path).
     1161       repeat :
     1162         create buf_temp-schedule-free.
     1163         import buf_temp-schedule-free.
     1164       END.
     1165       input close.
     1166       _ff:
     1167       for each buf_temp-schedule-free :
     1168         if buf_temp-schedule-free.free-id = '':U then do:
     1169            delete buf_temp-schedule-free.
     1170            next _ff.
     1171          end.
     1172          run schedule-attr-check-enc in this-procedure (
     1173                                                       input  buf_temp-schedule-free.free-id
     1174                                                      ,input  (buf_temp-schedule-free.proc-run-name +
     1175                                                               buf_temp-schedule-free.proc-param-edit-name +
     1176                                                               buf_temp-schedule-free.conf-param +
     1177                                                               string(buf_temp-schedule-free.is-gbd) +
     1178                                                               string(buf_temp-schedule-free.is-ubd) +
     1179                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
     1180                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
     1181                                                               string(buf_temp-schedule-free.other-info)
     1182                                                               )
     1183                                                       ,input  buf_temp-schedule-free.enc-key
     1184                                                       ,output v-answer    ) no-error .
     1185          if error-status:error
     1186          or not v-answer then delete buf_temp-schedule-free.
     1187        end.
     1188     end.
     1189   end procedure.
     1190   Function schedule-attr-reverse returns character (str as character).
     1191      define variable rev_incl_s as character init "" no-undo .
     1192      define variable rev_incl_i as integer no-undo .
     1193      define variable rev_incl_l as integer no-undo .
     1194      rev_incl_l = length(str).
     1195      do rev_incl_i = 1 to rev_incl_l:
     1196         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
     1197      end.
     1198      return rev_incl_s.
     1199   end.
     1200   procedure schedule-attr-check-enc.
     1201     define input  parameter p-free-id   as character no-undo .
     1202     define input  parameter p-value     as character no-undo .
     1203     define input  parameter p-enc-value as character no-undo .
     1204     define output parameter p-answer    as logical   no-undo .
     1205     define variable tmp         as character no-undo .
     1206     define variable v-enc-value as character no-undo .
     1207     assign
     1208     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
     1209     .
     1210     run schedule-attr-pswd-enc in this-procedure
     1211       ( input tmp
     1212        ,output v-enc-value
     1213       ) no-error .
     1214     if error-status:error then do:
     1215       message
     1216         vss-workfile vss-revision vss-description skip
     1217         "Ошибка при вызове процедуры pswd-enc" skip
     1218         return-value skip
     1219         error-status :get-message(1) skip
     1220         view-as alert-box error .
     1221       undo, return error .
     1222     end.
     1223     if v-enc-value = p-enc-value then do:
     1224       assign
     1225         p-answer = true
     1226       .
     1227     end.
     1228     else do:
     1229       assign
     1230         p-answer = false
     1231       .
     1232     end.
     1233   end.
     1234   procedure schedule-attr-conf-enc.
     1235     define input  parameter p-free-id   as character no-undo .
     1236     define input  parameter p-value     as character no-undo .
     1237     define output parameter p-enc-value as character no-undo .
     1238     define variable tmp         as character no-undo .
     1239     assign
     1240       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
     1241     .
     1242     run schedule-attr-pswd-enc in this-procedure
     1243       ( input tmp
     1244        ,output p-enc-value
     1245       ) no-error .
     1246     if error-status:error then do:
     1247       message
     1248         vss-workfile vss-revision vss-description skip
     1249         "Ошибка при вызове процедуры pswd-enc" skip
     1250         return-value skip
     1251         error-status :get-message(1) skip
     1252         view-as alert-box error .
     1253       undo, return error .
     1254     end.
     1255   end procedure.
     1256   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1257   procedure schedule-attr-pswd-enc :
     1258     define input parameter  pswd     as character no-undo .
     1259     define output parameter enc-pswd as character no-undo .
     1260     do
     1261     on error undo, return error return-value
     1262     :
     1263       assign
     1264         enc-pswd = encode(pswd + string(index(pswd, "k")))
     1265       .
     1266     end.
     1267   end procedure.
     1268   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1269   DEFINE VARIABLE v-dir-name  AS CHARACTER NO-UNDO .
     1270   DEFINE VARIABLE v-dir-type  AS CHARACTER NO-UNDO .
     1271   DEFINE VARIABLE v-can-read  AS LOGICAL   NO-UNDO .
     1272   DEFINE VARIABLE v-param-list    AS CHARACTER     NO-UNDO.
     1273   DEFINE VARIABLE v-param-type    AS CHARACTER     NO-UNDO.
     1274   DEFINE VARIABLE v-computer-tcp-name    AS CHARACTER NO-UNDO .
     1275   DEFINE VARIABLE v-computer-ip-addr     AS CHARACTER NO-UNDO .
     1276   DEFINE VARIABLE v-target    AS CHARACTER NO-UNDO .
     1277   DEFINE VARIABLE thGisMtOff AS CLASS GisMtOffline NO-UNDO .
     1278   DEFINE TEMP-TABLE ttreport-header NO-UNDO
     1279      XML-NODE-NAME "report-header"
     1280      FIELD reqid        AS RECID SERIALIZE-HIDDEN
     1281      FIELD f_datetime-tz     AS DATETIME-TZ XML-NODE-NAME "datetime-tz"
     1282      FIELD report-name     AS CHAR
     1283      FIELD report-label AS CHAR
     1284      FIELD report-db-num AS INT
     1285      FIELD report-db-name AS CHAR
     1286      FIELD report-db-hist AS CHAR
     1287      INDEX reqidpar reqid
     1288      .
     1289    DEFINE TEMP-TABLE ttreplicationStatus NO-UNDO
     1290      XML-NODE-NAME "replicationStatus"
     1291      FIELD reqid      AS RECID     SERIALIZE-HIDDEN
     1292      FIELD f_status   AS CHARACTER XML-NODE-NAME "status"
     1293      FIELD f_version  AS CHARACTER XML-NODE-NAME "version"
     1294      FIELD lastUpdate AS CHARACTER
     1295      FIELD lastSync   AS CHARACTER
     1296      FIELD inst       AS CHARACTER
     1297      FIELD vers       AS CHARACTER XML-NODE-NAME "dbVersion"
     1298      FIELD timeLag    AS CHARACTER
     1299      FIELD onlineTime AS CHARACTER
     1300      INDEX reqidpar reqid
     1301      .
     1302    DEFINE DATASET gismt-report-body  XML-NODE-NAME "report-lmchzsts" FOR ttreport-header, ttreplicationStatus.
     1303     define temp-table ttfiles-inf  no-undo serialize-name  "files"
     1304      field md5            as char
     1305      field name           as char
     1306      field timestamp      as char
     1307      index timestamp timestamp.
     1308     define dataset data-files-adr SERIALIZE-HIDDEN  for ttfiles-inf .
     1309     define stream out_data.
     1310     define variable vImpArchSts as logical no-undo.
     1311   DO
     1312   ON ERROR UNDO, RETURN ERROR RETURN-VALUE
     1313   :
     1314       ASSIGN
     1315       log-file-name = "shd-free.log".
     1316       RUN gbl/set-gbl.p
     1317         (INPUT  TRUE
     1318         ,INPUT  g#auto-user-id
     1319         ,INPUT  g#auto-user-password
     1320         ) NO-ERROR.
     1321       IF ERROR-STATUS :ERROR
     1322       THEN DO:
     1323         DEF VAR v-err-str AS CHARACTER NO-UNDO.
     1324         v-err-str = ERROR-STATUS:GET-MESSAGE(ERROR-STATUS:NUM-MESSAGES) + chr(10) + RETURN-VALUE.
     1325          run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("!!!Ошибка при инициализации переменных g#... &1&2"                                      , v-err-str                                      , chr(10))).
     1326           RETURN.
     1327       END.
     1328       RUN schedule-attr-value IN this-procedure (
     1329             INPUT p-cre-db-num
     1330           , INPUT p-task-type
     1331           , INPUT p-task-num
     1332           , INPUT 'schedule-param-list':U
     1333           , OUTPUT v-param-list
     1334           , OUTPUT v-param-type
     1335       ).
     1336       IF v-param-list = "":U THEN DO:
     1337          run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("!!!Не заданы параметры отчета о состоянии ЛМ ЧЗ &1&2"                                      , p-task-num                                             , chr(10))).
     1338          RETURN.
     1339       END.
     1340       v-dir-name = v-param-list NO-ERROR.
     1341       ASSIGN
     1342       FILE-INFO:FILE-NAME = v-dir-name
     1343       v-dir-type = FILE-INFO:FILE-TYPE
     1344       .
     1345       IF INDEX( v-dir-type, "D" ) = 0 THEN DO:
     1346         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("!!!Выбранный для формирования отчета каталог &1 - недоступен&2"                                      , v-dir-name                                      , chr(10))).
     1347         RETURN .
     1348       END.
     1349       RUN CalcStatus (v-dir-name) NO-ERROR .
     1350       IF ERROR-STATUS:ERROR THEN DO:
     1351         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("!!!Ошибка при формировании отчета&3&1&3&2&3"                                      , return-value                                      , error-status:get-message(1)                                      , chr(10))).
     1352       END.
     1353       ELSE DO:
     1354         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("!!!Формирование отчета о состоянии ЛМ ЧЗ завершено.&1"                                      , chr(10))).
     1355       END.
     1356       RUN GetArchFromKassa (OUTPUT vImpArchSts) NO-ERROR.
     1357       IF ERROR-STATUS:ERROR THEN DO:
     1358         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("!!!Ошибка при загрузке архива с кассы &3&1&3&2&3"                                      , return-value                                      , error-status:get-message(1)                                      , chr(10))).
     1359       END.
     1360       ELSE IF vImpArchSts THEN DO:
     1361         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("!!!Архивы с касс загружены.&1"                                      , chr(10))).
     1362       END.
     1363       ELSE DO:
     1364         run write-log-and-file in p-log-handle (          input 1                                                            , input log-file-name                                                , input 1                                                            , input substitute("!!!Архивы для загрузки с касс отсутствуют.&1"                                      , chr(10))).
     1365       END.
     1366   END.
     1367   DELETE OBJECT thGisMtOff NO-ERROR.
     1368   PROCEDURE CalcStatus:
     1369       DEFINE INPUT PARAM iDirName AS CHARACTER NO-UNDO.
     1370       DEFINE VARIABLE vStatus   AS CHARACTER NO-UNDO.
     1371       DEFINE VARIABLE v-version AS CHARACTER NO-UNDO.
     1372       DEFINE VARIABLE vTimeLag  AS CHARACTER NO-UNDO.
     1373       DEFINE VARIABLE vOnlineTimeD AS DECIMAL NO-UNDO.
     1374       DEFINE VARIABLE vOnlineTime AS INT64    NO-UNDO.
     1375       DEFINE VARIABLE vTimeBegErr AS DATETIME-TZ NO-UNDO.
     1376       DEFINE VARIABLE vlastUpdate AS CHARACTER NO-UNDO.
     1377       DEFINE VARIABLE vLastSync   AS CHARACTER NO-UNDO.
     1378       DEFINE VARIABLE vInst       AS CHARACTER NO-UNDO.
     1379       DEFINE VARIABLE vdbVersion  AS CHARACTER NO-UNDO.
     1380       DEFINE BUFFER buf_code FOR ub.code.
     1381       thGisMtOff =  NEW GisMtOffline() NO-ERROR.
     1382       vStatus = thGisMtOff:GetChkStsOffline(OUTPUT v-version,
     1383                                             OUTPUT vTimeLag,
     1384                                             OUTPUT vlastUpdate,
     1385                                             OUTPUT vLastSync,
     1386                                             OUTPUT vInst,
     1387                                             OUTPUT vdbVersion) NO-ERROR.
     1388       FIND FIRST buf_code WHERE buf_code.parent EQ "GisMt"
     1389              AND buf_code.code   EQ "GisMtErr"
     1390          NO-LOCK NO-WAIT NO-ERROR.
     1391       IF AVAILABLE buf_code
     1392          AND buf_code.codevalue > ""
     1393       THEN DO:
     1394          vTimeBegErr = DATETIME-TZ(buf_code.codevalue) NO-ERROR.
     1395          IF vTimeBegErr <> ? THEN DO:
     1396             vOnlineTimeD = (NOW - vTimeBegErr) / 3600000.
     1397             vOnlineTime = ROUND(vOnlineTimeD,0).
     1398             if vOnlineTime < vOnlineTimeD then vOnlineTime = vOnlineTime + 1.
     1399          END.
     1400          ELSE vOnlineTime = 0.
     1401       END.
     1402       ELSE vOnlineTime = 0.
     1403       RUN Put2Xml (iDirName,
     1404                    vStatus,
     1405                    v-version,
     1406                    vTimeLag,
     1407                    STRING(vOnlineTime),
     1408                    vlastUpdate,
     1409                    vLastSync,
     1410                    vInst,
     1411                    vdbVersion) NO-ERROR.
     1412   END PROCEDURE.
     1413   PROCEDURE Put2Xml:
     1414       DEFINE INPUT PARAM iDirName AS CHARACTER NO-UNDO.
     1415       DEFINE INPUT PARAMETER iStatus AS CHARACTER NO-UNDO.
     1416       DEFINE INPUT PARAMETER iVersion AS CHARACTER NO-UNDO.
     1417       DEFINE INPUT PARAMETER iTimeLag AS CHARACTER NO-UNDO.
     1418       DEFINE INPUT PARAMETER iOnlineTime AS CHARACTER NO-UNDO.
     1419       DEFINE INPUT PARAMETER vlastUpdate AS CHARACTER NO-UNDO.
     1420       DEFINE INPUT PARAMETER vLastSync AS CHARACTER NO-UNDO.
     1421       DEFINE INPUT PARAMETER vInst AS CHARACTER NO-UNDO.
     1422       DEFINE INPUT PARAMETER vdbVersion AS CHARACTER NO-UNDO.
     1423       DEFINE VARIABLE vFileResult AS CHARACTER NO-UNDO.
     1424       DEFINE VARIABLE vFileName AS CHARACTER NO-UNDO.
     1425       DEFINE VARIABLE vRetOk AS LOGICAL NO-UNDO.
     1426       DEFINE VARIABLE vWorkDir AS CHARACTER NO-UNDO.
     1427       DEFINE VARIABLE v-obj-name AS CHARACTER NO-UNDO.
     1428       DEFINE VARIABLE v-db-num AS INTEGER NO-UNDO.
     1429       DEFINE VARIABLE v-par-type  AS CHARACTER NO-UNDO.
     1430       DEFINE VARIABLE v-hist-code AS CHARACTER NO-UNDO.
     1431       DEFINE VARIABLE v-hist-name AS CHARACTER NO-UNDO.
     1432       DEFINE BUFFER buf_sys-ctrl FOR ub.sys-ctrl .
     1433       DEFINE BUFFER buf_clients FOR ub.clients .
     1434        FIND FIRST buf_sys-ctrl NO-LOCK NO-ERROR.
     1435        IF AVAILABLE buf_sys-ctrl AND buf_sys-ctrl.db-num <> 0
     1436        THEN DO:
     1437            FIND FIRST buf_clients NO-LOCK WHERE
     1438                      buf_clients.db-num = buf_sys-ctrl.db-num NO-ERROR.
     1439            IF AVAIL buf_clients
     1440            THEN ASSIGN
     1441                   v-obj-name = buf_clients.obj-name
     1442                   v-db-num  = buf_sys-ctrl.db-num
     1443                   .
     1444        END.
     1445       RUN db-attr-value(INPUT v-db-num,INPUT 'hist-code':U,OUTPUT v-hist-code ,OUTPUT v-par-type) .
     1446       RUN db-attr-value(INPUT v-db-num,INPUT 'hist-name':U,OUTPUT v-hist-name ,OUTPUT v-par-type) .
     1447       vWorkDir = iDirName.
     1448       vFileName = "LmChz-" + string(TODAY,"99-99-9999")
     1449                     + "_" + string(v-db-num).
     1450       RUN GenFileName (vWorkDir, vFileName, OUTPUT vfileresult).
     1451       if vfileresult = "" then return error "Не удалось инициализировать имя файла.".
     1452       CREATE ttreport-header.
     1453       ASSIGN
     1454          ttreport-header.reqid = 1
     1455          ttreport-header.f_datetime-tz  = NOW
     1456          ttreport-header.report-name    = "lmchzsts"
     1457          ttreport-header.report-label   = "Отчет о состоянии ЛМЧЗ"
     1458          ttreport-header.report-db-num  = v-db-num
     1459          ttreport-header.report-db-name = v-obj-name
     1460          ttreport-header.report-db-hist = v-hist-code
     1461          .
     1462       CREATE ttreplicationStatus.
     1463       ASSIGN
     1464          ttreplicationStatus.reqid      = 1
     1465          ttreplicationStatus.f_status   = iStatus
     1466          ttreplicationStatus.f_version  = iVersion
     1467          ttreplicationStatus.timeLag    = iTimeLag
     1468          ttreplicationStatus.onlineTime = iOnlineTime
     1469          ttreplicationStatus.lastUpdate = vlastUpdate
     1470          ttreplicationStatus.lastSync   = vLastSync
     1471          ttreplicationStatus.inst       = vInst
     1472          ttreplicationStatus.vers       = vdbVersion
     1473          .
     1474       vRetOk = DATASET gismt-report-body:WRITE-XML("FILE":U, vfileresult, TRUE, "windows-1251", ?, FALSE, TRUE ,FALSE,TRUE ) no-error.
     1475   END PROCEDURE.
     1476   PROCEDURE GenFileName:
     1477     DEFINE INPUT PARAM iWorkDir      AS CHAR NO-UNDO.
     1478     DEFINE INPUT PARAM iFileNameBase AS CHAR NO-UNDO.
     1479     DEFINE OUTPUT PARAM oFileNameGen AS CHAR NO-UNDO.
     1480     DEFINE VARIABLE v-name        AS CHARACTER NO-UNDO .
     1481     DEFINE VARIABLE v-check-name  AS CHARACTER NO-UNDO .
     1482     DEFINE VARIABLE vNum AS INTEGER NO-UNDO.
     1483     DEFINE VARIABLE vExtension  AS CHARACTER NO-UNDO.
     1484     DEFINE VARIABLE vDirDelim   AS CHARACTER NO-UNDO INIT "\":u.
     1485     ASSIGN
     1486       vNum = 0
     1487       vExtension = '.':u + "xml"
     1488       oFileNameGen = ""
     1489       .
     1490     v-check-name = "something".
     1491     DO WHILE v-check-name <> ? and vNum < 99:
     1492       ASSIGN
     1493         vNum = vNum + 1
     1494       .
     1495       ASSIGN
     1496         v-name = iWorkDir + vDirDelim + iFileNameBase + "-" + string(vNum,"99":U) + vExtension
     1497       .
     1498       ASSIGN
     1499         v-check-name = SEARCH(v-name)
     1500       .
     1501     END.
     1502     if v-check-name = ?
     1503     then oFileNameGen = v-name.
     1504   END PROCEDURE.
     1505   procedure GetArchFromKassa:
     1506      define output param oImpSts as logical no-undo.
     1507      define buffer for-cash-desk for ub.cash-desk.
     1508      define variable vOneImpSts as logical no-undo.
     1509      define variable vFolder as character no-undo.
     1510      define variable vDirDelim    as character no-undo init "\":u.
     1511      vFolder   = "Архивы взаимодействия с ГИС МТ" .
     1512      if objExists(vFolder,"D") eq ?
     1513          then os-create-dir VALUE(vFolder).
     1514      oImpSts = no.
     1515      for each for-cash-desk no-lock where
     1516               for-cash-desk.db-num   eq g#db-num
     1517           and for-cash-desk.cash-on  eq yes
     1518           :
     1519           if num-entries(for-cash-desk.addr-path, chr(4)) >= 2 then
     1520           do:
     1521              run write-log-and-file in p-log-handle ( input 1
     1522                                             , input log-file-name
     1523                                             , input 1
     1524                                             , input substitute("Запрос архивов кассы номер &1", for-cash-desk.cash-num)).
     1525              run GetArchFromOneKassa (entry(1, for-cash-desk.addr-path, chr(4))
     1526                                       + '://' + entry(1,entry(2, for-cash-desk.addr-path, chr(4)),":"),
     1527                                       substitute("&1&3&2",vFolder,for-cash-desk.cash-num,vDirDelim),
     1528                                       for-cash-desk.cash-num,
     1529                                       output vOneImpSts ).
     1530              if vOneImpSts then
     1531              run write-log-and-file in p-log-handle ( input 1
     1532                                             , input log-file-name
     1533                                             , input 1
     1534                                             , input substitute("Архивы с кассы номер &1 загружены", for-cash-desk.cash-num)).
     1535           end.
     1536           else
     1537              run write-log-and-file in p-log-handle ( input 1
     1538                                             , input log-file-name
     1539                                             , input 1
     1540                                             , input substitute("!!!В справочнике для кассы номер &1 некорректно задан адрес и порт кассы", for-cash-desk.cash-num)).
     1541           oImpSts = oImpSts or vOneImpSts.
     1542      end.
     1543   end procedure.
     1544   procedure GetArchFromOneKassa:
     1545       define input param iAddrPath   as char no-undo.
     1546       define input param iCashFolder as char no-undo.
     1547       define input param iCashNum    as char no-undo.
     1548       define output param oOneImpSts as logical no-undo.
     1549       define buffer buf_code for code.
     1550       define variable vTimeStart      as int64 no-undo.
     1551       define variable vCmd            as character no-undo.
     1552       define variable vFileResult     as character no-undo.
     1553       define variable vFileResultErr  as character no-undo.
     1554       define variable vFileResArch    as character no-undo.
     1555       define variable vFileResArchErr as character no-undo.
     1556       define variable vConnectTime    as decimal no-undo.
     1557       define variable vlongJson       as longchar no-undo.
     1558       define variable hDS             as handle no-undo.
     1559       define variable vRetOk          as logical no-undo.
     1560       define variable v-chk-sum-signature as char no-undo.
     1561       define variable vFileListCmd    as character no-undo.
     1562       define variable vFileArhCmd     as character no-undo.
     1563       define variable vFileReqPath    as character no-undo.
     1564       define variable vMyWorkDir      as character no-undo.
     1565       define variable vFolder         as character no-undo.
     1566       define variable vFolderPath     as character no-undo.
     1567       define variable vDirDelim       as character no-undo init "\":u.
     1568       define variable vFileArh        as character no-undo.
     1569       define variable vFileReqErrPath as character no-undo.
     1570       FIND FIRST buf_code WHERE buf_code.parent EQ "GisMt"
     1571                             AND buf_code.code   EQ substitute("ArchDate:&1",iCashNum)
     1572            NO-LOCK NO-ERROR.
     1573       if avail buf_code then
     1574          vTimeStart = int64(buf_code.CodeValue) no-error.
     1575       else vTimeStart = 0.
     1576       if vTimeStart = ? then vTimeStart = 0.
     1577       vConnectTime = 30.
     1578       empty temp-table ttfiles-inf.
     1579       RUN gbl/_tmpfile.p ( "PiotLogList", ".txt", OUTPUT vFileResult ) .
     1580       RUN gbl/_tmpfile.p ( "PiotLogListErr", ".txt", OUTPUT vFileResultErr ) .
     1581       if session:debug-alert then run gbl/_tmpfile.p ("PiotLogListCmd", ".bat", output vFileListCmd) .
     1582       vCmd = SUBSTITUTE ('&1  --connect-timeout &6 --max-time &6 --location --request GET "&2:1501/PiotLogList?archDate=&3" --header "Accept: application/json" >&4 --stderr &5',
     1583                         SEARCH ("exe/curl.exe"),
     1584                         iAddrPath,
     1585                         vTimeStart,
     1586                         vFileResult,
     1587                         vFileResultErr,
     1588                         vConnectTime
     1589                         ).
     1590       if session:debug-alert then
     1591        do:
     1592            OUTPUT STREAM out_data TO value(vFileListCmd).
     1593            PUT STREAM out_data UNFORMATTED
     1594             vCmd .
     1595            OUTPUT STREAM out_data CLOSE.
     1596        end.
     1597       os-command silent value(vCmd).
     1598       IF searchFile(vFileResult) <> ?
     1599       THEN DO :
     1600          if objExists(iCashFolder,"D") eq ?
     1601          then os-create-dir VALUE(iCashFolder).
     1602          copy-lob from file vFileResult to vlongJson no-error.
     1603          hDS = dataset data-files-adr:handle.
     1604          vRetOk  = hDS:read-json("longchar":U, vlongJson) no-error.
     1605          for each ttfiles-inf:
     1606              oOneImpSts = yes .
     1607              vFileResArch = ttfiles-inf.name.
     1608              vFileResArchErr = "Err" + entry(1,ttfiles-inf.name,".") + ".txt".
     1609              vCmd = SUBSTITUTE ('&1  --connect-timeout &6 --max-time &6 --location --request GET "&2:1501/PiotLogArch?archName=&3" --header "Accept: application/octet-stream" --output &4 --stderr &5',
     1610                                 SEARCH ("exe/curl.exe"),
     1611                                 iAddrPath,
     1612                                 ttfiles-inf.name,
     1613                                 vFileResArch,
     1614                                 vFileResArchErr,
     1615                                 vConnectTime
     1616                                 ).
     1617               if session:debug-alert then run gbl/_tmpfile.p ("PiotLogArhCmd", ".bat", output vFileArhCmd) .
     1618               if session:debug-alert then
     1619                do:
     1620                    OUTPUT STREAM out_data TO value(vFileArhCmd).
     1621                    PUT STREAM out_data UNFORMATTED
     1622                     vCmd .
     1623                    OUTPUT STREAM out_data CLOSE.
     1624                end.
     1625               os-command silent value(vCmd).
     1626               if searchFile(vFileResArch) = ? then do:
     1627                   run DelTmpFiles (substitute("&2&1&3&1&4",
     1628                                               chr(4),vFileResult,vFileResultErr,vFileResArchErr)).
     1629                   return error substitute("Не удалось загрузить архив &1",
     1630                                           vFileResArch).
     1631               end.
     1632               run gbl/md5.p
     1633                   (input  searchFile(vFileResArch)
     1634                   ,output v-chk-sum-signature
     1635                   ) .
     1636               if v-chk-sum-signature <> ttfiles-inf.md5
     1637               then do:
     1638                   run DelTmpFiles (substitute("&2&1&3&1&4&1&5",
     1639                                               chr(4),vFileResult,vFileResultErr,vFileResArchErr,vFileResArch)).
     1640                   return error substitute("Не совпадает проверочная сумма архива: Проверочная контрольная сумма: &1 сумма архива: &2",
     1641                                           ttfiles-inf.md5, v-chk-sum-signature).
     1642               end.
     1643               else do
     1644               transaction:
     1645                  assign
     1646                      vFileReqPath = searchFile(vFileResArch)
     1647                      vFileReqErrPath = searchFile(vFileResArchErr)
     1648                      vMyWorkDir = substring(vFileReqPath,1,index(vFileReqPath,vFileResArch) - 1)
     1649                      vFolderPath  = vMyWorkDir + iCashFolder
     1650                      vFileArh = vFolderPath + vDirDelim + vFileResArch
     1651                      .
     1652                  copy-lob from file(vFileReqPath) to file(vFileArh) no-error.
     1653                  if error-status:error then do:
     1654                      return error "Ошибка записи файла в папку архивов".
     1655                  end.
     1656                  run SaveArchDate (iCashNum, ttfiles-inf.timestamp).
     1657                  run DelTmpFiles (substitute("&2&1&3",
     1658                                              chr(4),vFileReqErrPath,vFileReqPath)).
     1659               end.
     1660          end.
     1661       END.
     1662       run DelTmpFiles (substitute("&2&1&3",
     1663                                   chr(4),vFileResult,vFileResultErr)).
     1664   end procedure.
     1665   procedure SaveArchDate.
     1666       define input parameter iCashNum   as character no-undo.
     1667       define input parameter iTimeStamp as character no-undo.
     1668       def buffer buf_code for ub.code.
     1669       do transaction:
     1670          find first buf_code exclusive-lock where
     1671                     buf_code.parent eq "GisMt"
     1672                 and buf_code.code   eq substitute("ArchDate:&1",iCashNum)
     1673            no-wait no-error.
     1674          if avail buf_code then
     1675             buf_code.CodeValue = ttfiles-inf.timestamp no-error.
     1676          else if not ambiguous buf_code then do:
     1677             FIND FIRST buf_code WHERE buf_code.parent EQ ""
     1678                                   AND buf_code.code   EQ "GisMt"
     1679             NO-LOCK NO-ERROR.
     1680             IF NOT AVAILABLE buf_code THEN DO:
     1681               CREATE buf_code.
     1682               ASSIGN
     1683                  buf_code.parent = ""
     1684                  buf_code.code = "GisMt"
     1685                  buf_code.codename = "Онлайн проверка КМ"
     1686                  .
     1687               RELEASE buf_code NO-ERROR.
     1688             END.
     1689             create buf_code.
     1690             assign
     1691                buf_code.parent = "GisMt"
     1692                buf_code.code = substitute("ArchDate:&1",iCashNum)
     1693                buf_code.codename = substitute("Время последнего загруженного архива с кассы № &1 (unixtime)", iCashNum)
     1694                buf_code.CodeValue = ttfiles-inf.timestamp
     1695             .
     1696             release buf_code no-error.
     1697          end.
     1698       end.
     1699   end procedure.
     1700   procedure DelTmpFiles.
     1701      define input param iListFile as char no-undo.
     1702      def var vCount as int no-undo.
     1703      def var vFileName as char no-undo.
     1704      if not session:debug-alert then
     1705      do vCount = 1 to num-entries(iListFile,chr(4)):
     1706         vFileName = entry(vCount,iListFile,chr(4)).
     1707         if vFileName <> ""  then vFileName = searchFile(vFileName).
     1708         if vFileName <> "" and vFileName <> ?
     1709            then os-delete silent value(vFileName)     no-error.
     1710      end.
     1711   end procedure.
