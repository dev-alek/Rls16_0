      132   function objExists return character
      133   (input  ifolder as character,
      134    input  iType   as character  ):
      135       define variable vFileType as character no-undo init "D,F".
      136       define variable vi        as integer no-undo.
      137       define variable vtype as character no-undo.
      138       if iType ne ?
      139       then
      140          vFileType = iType.
      141       do vi = 1 to num-entries(vFileType):
      142          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
      143          vtype = file-information:file-type.
      144          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      145             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      146             index(vtype , entry(vi,vFileType )) > 0
      147          then return file-information:full-pathname .
      148          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
      149          vtype = file-information:file-type.
      150          if file-information:file-name <> "" and
      151             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      152             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      153             index( vtype, entry(vi,vFileType )) > 0
      154          then return file-information:full-pathname .
      155       end.
      156       return ? .
      157   end.
      158   function SearchFile return character
      159   (input  ifile as character):
      160      return objExists(ifile,?).
      161   end.
      162   function SearchPFile return character
      163   (input inFile as char):
      164        define variable oFile       as character no-undo.
      165        define variable vFileSearch as character no-undo.
      166        define variable vNumEntry   as integer no-undo.
      167        if inFile = "" then return ?.
      168        vNumEntry = num-entries(inFile,".").
      169        vFileSearch = inFile.
      170        if    vNumEntry > 0
      171           and (   entry(vNumEntry,inFile,".") eq "p"
      172                or entry(vNumEntry,inFile,".") eq "w")
      173        then do:
      174           entry(vNumEntry,vFileSearch, ".") = "r".
      175           oFile = search(vFileSearch ).
      176           if oFile eq ?
      177           then
      178              oFile = search(inFile).
      179        end.
      180        else
      181           oFile = search(vFileSearch).
      182        return oFile.
      183     end.
