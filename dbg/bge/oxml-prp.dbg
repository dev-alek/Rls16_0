        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Настройки OpenXML".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   procedure proc-alt-shift-f2:
       63     if not ibs.th.gbl.gbl-var:rcode
       64   then
       65     run gbl\inidebug.p .
       66   end.
       67   procedure proc-alt-shift-f3:
       68     run gbl/prvssinf.p
       69       ( input this-procedure
       70       ) .
       71   end.
       72   define variable v-inform-launched as logical no-undo initial false .
       73   procedure proc-alt-shift-f4:
       74     define variable v-action as character no-undo .
       75     if v-inform-launched = false then do:
       76       assign
       77         v-inform-launched = true
       78       .
       79       run gbl/d-inform.w
       80         (  input self
       81         ,  input this-procedure
       82         , output v-action
       83         ) no-error .
       84       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       85       assign
       86         v-inform-launched = false
       87       .
       88     end.
       89   end.
       90   procedure proc-alt-f1:
       91     run gbl/corrhelp.p
       92       (input this-procedure
       93       ) .
       94   end .
       95   on alt-shift-f2 anywhere do:
       96     run proc-alt-shift-f2.
       97   end.
       98   on alt-shift-f3 anywhere do:
       99     run proc-alt-shift-f3 in this-procedure .
      100   end.
      101   on alt-shift-f4 anywhere do:
      102     run proc-alt-shift-f4 in this-procedure.
      103   end.
      104   on alt-f1 anywhere do:
      105     run proc-alt-f1 in this-procedure .
      106   end.
      107   DEFINE VARIABLE h_oxml-prop AS HANDLE NO-UNDO.
      108   DEFINE BUTTON b-exit AUTO-GO
      109        LABEL "&Выход"
      110        SIZE 10 BY 1
      111        BGCOLOR 8 .
      112   DEFINE BUTTON b-help
      113        LABEL "Помо&щь"
      114        SIZE 10 BY 1
      115        BGCOLOR 8 .
      116   DEFINE FRAME oxml-prp
      117        b-exit AT ROW 1.17 COL 2
      118        b-help AT ROW 1.17 COL 12
      119        SPACE(40.37) SKIP(5.28)
      120       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      121            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      122            TITLE "Настройки OpenXML".
      123   ASSIGN
      124          FRAME oxml-prp:SCROLLABLE       = FALSE
      125          FRAME oxml-prp:HIDDEN           = TRUE.
      126   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      127   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      128   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      129   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      130   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      131   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      132   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      133   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      134       ASSIGN adm-object-hdl = FRAME oxml-prp:HANDLE.
      135   RUN ensure-broker.
      136   THIS-PROCEDURE:ADM-DATA =
      137        'ADM1.1~`':U +
      138        'SmartDialog~`':U +
      139        'DIALOG-BOX~`':U +
      140        'NO ~`':U +
      141        '~`':U +
      142        '~`':U +
      143        '~`':U +
      144        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      145           + "~`":U +
      146        'Layout,Hide-on-Init~`':U +
      147        '~`':U +
      148        '~`':U +
      149        '~`~`~`~`~`~`~`~`~`~`~`':U +
      150        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      151            THEN "^^":U
      152        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      153             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      154   PROCEDURE adm-apply-entry :
      155     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      156   END PROCEDURE.
      157   PROCEDURE adm-destroy :
      158    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      159   END PROCEDURE.
      160   PROCEDURE adm-disable :
      161       DISABLE b-exit b-help WITH FRAME oxml-prp.
      162       RUN dispatch ('disable-fields':U).
      163       RUN set-attribute-list ('ENABLED=no':U).
      164       RETURN.
      165   END PROCEDURE.
      166   PROCEDURE adm-edit-attribute-list :
      167         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
      168         RETURN.
      169   END PROCEDURE.
      170   PROCEDURE adm-enable :
      171       ENABLE UNLESS-HIDDEN b-exit b-help WITH FRAME oxml-prp.
      172       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      173       RUN set-attribute-list ('ENABLED=yes':U).
      174       RETURN.
      175   END PROCEDURE.
      176   PROCEDURE adm-exit :
      177        RUN notify ('exit':U).
      178     RETURN.
      179   END PROCEDURE.
      180   PROCEDURE adm-hide :
      181     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      182   END PROCEDURE.
      183   PROCEDURE adm-initialize :
      184     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      185   END PROCEDURE.
      186   PROCEDURE adm-show-errors :
      187       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      188       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      189           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      190       END.
      191       RETURN.
      192   END PROCEDURE.
      193   PROCEDURE adm-UIB-mode :
      194     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      195   END PROCEDURE.
      196   PROCEDURE adm-view :
      197     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      198   END PROCEDURE.
      199   PROCEDURE dispatch :
      200       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      201       RUN broker-dispatch IN adm-broker-hdl
      202           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      203       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      204   END PROCEDURE.
      205   PROCEDURE ensure-broker :
      206   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      207   IF RETURN-VALUE NE "ADM-Broker":U THEN
      208   DO:
      209       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      210       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      211   END.
      212   END PROCEDURE.
      213   PROCEDURE get-attribute :
      214     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      215     RUN broker-get-attribute IN adm-broker-hdl
      216         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      217     RETURN RETURN-VALUE.
      218   END PROCEDURE.
      219   PROCEDURE get-attribute-list :
      220     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      221     RUN broker-get-attribute-list IN adm-broker-hdl
      222         (INPUT THIS-PROCEDURE,
      223          INPUT ?,
      224          OUTPUT p-attr-list) NO-ERROR.
      225     RETURN.
      226   END PROCEDURE.
      227   PROCEDURE new-state :
      228     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      229     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      230     RETURN.
      231   END PROCEDURE.
      232   PROCEDURE notify :
      233     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      234     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      235     IF RETURN-VALUE = "ADM-ERROR":U THEN
      236         RETURN "ADM-ERROR":U.
      237     RETURN.
      238   END PROCEDURE.
      239   PROCEDURE set-attribute-list :
      240     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      241     RUN ensure-broker.
      242     RUN broker-set-attribute-list IN adm-broker-hdl
      243         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      244     RETURN.
      245   END PROCEDURE.
      246   PROCEDURE set-position :
      247       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      248       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      249       IF VALID-HANDLE(adm-object-hdl) THEN
      250       DO:
      251           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
      252           IF adm-object-hdl:TYPE = "WINDOW":U THEN
      253           DO:
      254             IF p-row = 0 THEN p-row =
      255               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
      256             IF p-col = 0 THEN p-col =
      257               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
      258           END.
      259           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
      260           DO:
      261             parent-hdl = adm-object-hdl:PARENT.
      262             IF p-row = 0 THEN p-row =
      263               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
      264                 parent-hdl:ROW.
      265             IF p-col = 0 THEN p-col =
      266               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
      267                 parent-hdl:COL.
      268           END.
      269           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
      270           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
      271         ASSIGN adm-object-hdl:ROW    =   p-row
      272                adm-object-hdl:COLUMN =   p-col.
      273       END.
      274       RETURN.
      275   END PROCEDURE.
      276   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
      277       STRING(adm-object-hdl)).
      278   PAUSE 0 BEFORE-HIDE.
      279   PROCEDURE adm-change-page :
      280     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
      281     END PROCEDURE.
      282   PROCEDURE delete-page :
      283     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
      284     RUN broker-delete-page IN adm-broker-hdl
      285         (INPUT THIS-PROCEDURE, INPUT p-page#).
      286     END PROCEDURE.
      287   PROCEDURE init-object :
      288     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
      289     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
      290     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
      291     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
      292     RUN broker-init-object IN adm-broker-hdl
      293         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
      294          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
      295     RETURN.
      296   END PROCEDURE.
      297   PROCEDURE init-pages :
      298     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
      299     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      300         INPUT p-page-list) NO-ERROR.
      301     END PROCEDURE.
      302   PROCEDURE select-page :
      303     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
      304     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      305         INPUT p-page#) NO-ERROR.
      306     END PROCEDURE.
      307   PROCEDURE view-page :
      308     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
      309     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
      310         INPUT p-page#).
      311     END PROCEDURE.
      312   ON WINDOW-CLOSE OF FRAME oxml-prp
      313   DO:
      314     APPLY "END-ERROR":U TO SELF.
      315   END.
      316   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      317   on help of frame oxml-prp
      318   do:
      319     run gbl/app_help.p
      320       (input this-procedure :file-name
      321       ,input ''
      322       ,input ?
      323       ) no-error.
      324     if error-status :error then do:
      325       message
      326         "Ошибка при вызове помощи"
      327         error-status :get-message(1)
      328         view-as alert-box .
      329     end.
      330   end.
      331   run minbtn-set in this-procedure .
      332   on choose of b-help in frame oxml-prp
      333   do:
      334     apply "help":u to frame oxml-prp .
      335   end.
      336   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      337   procedure minbtn-set :
      338       do
      339           on error undo, return error return-value
      340           :
      341           define variable ii              as integer       no-undo .
      342           define variable fh              as widget-handle no-undo .
      343           define variable hh              as widget-handle no-undo .
      344           define variable v-h             as handle        extent 4 no-undo .
      345           define variable v-name-button   as character     no-undo .
      346           define variable v-help-old-x    as decimal       no-undo .
      347           define variable v-help-old-y    as decimal       no-undo .
      348           define variable v-help-old-size as decimal       no-undo .
      349           define variable v-frame-width   as decimal       no-undo .
      350           define variable jj              as integer       no-undo .
      351           do
      352               on error undo, return error
      353               :
      354               assign
      355                   v-frame-width = frame oxml-prp:width - 0.3
      356                   fh            = frame oxml-prp:first-child
      357                   hh            = fh:first-child
      358                   ii            = 1
      359                   .
      360               do while valid-handle(hh):
      361                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      362                   do:
      363                       case lc(hh:name) :
      364                           when "b-help" then
      365                               do:
      366                                   hh:load-image-up("cmp/b-help.bmp":u) .
      367                                   hh:load-image-down("cmp/b-help.bmp":u) .
      368                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      369                                   hh:TOOLTIP = "Помощь" .
      370                                   v-help-old-x = hh:column .
      371                                   v-help-old-y = hh:row    .
      372                                   v-help-old-size = hh:width .
      373                                   hh:width-chars = 2.5 .
      374                               end.
      375                           when "b-print" then
      376                               do:
      377                                   hh:load-image("cmp/b-print.bmp":u) .
      378                                   hh:TOOLTIP = "Печать" .
      379                                   v-h[ii] = hh:handle .
      380                                   ii = ii + 1 .
      381                                   hh:width-chars = 3 .
      382                               end.
      383                           when "b-history" or
      384                           when "b-hist" then
      385                               do:
      386                                   hh:load-image("cmp/b-hist.bmp":u) .
      387                                   hh:TOOLTIP = "История" .
      388                                   v-h[ii] = hh:handle .
      389                                   ii = ii + 1 .
      390                                   hh:width-chars = 3 .
      391                               end.
      392                           when "b-sch" then
      393                               do:
      394                                   hh:load-image("cmp/b-sch.bmp":u) .
      395                                   hh:TOOLTIP = "Установка Фильтра" .
      396                                   v-h[ii] = hh:handle .
      397                                   ii = ii + 1 .
      398                                   hh:width-chars = 3 .
      399                               end.
      400                           when "b-hist-user" then
      401                               do:
      402                                   hh:load-image("cmp/b-hist.bmp":u) .
      403                                   hh:TOOLTIP = "История пользователя" .
      404                                   ii = ii + 1 .
      405                               end.
      406                       end case.
      407                   end.
      408                   hh = hh:next-sibling.
      409               end.
      410               b-help:column = v-frame-width - b-help:width-chars.
      411               jj = 0.
      412               repeat ii = 4 to 1 by -1 :
      413                   if valid-handle (v-h[ii] ) then
      414                   do:
      415                       jj  = jj + 1 .
      416                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      417                       v-h[ii]:row    = v-help-old-y .
      418                   end.
      419               end.
      420           end.
      421       end.
      422   end procedure.
      423   IF THIS-PROCEDURE:PERSISTENT THEN DO:
      424       MESSAGE "A SmartDialog is not intended ":U SKIP
      425               "to be run Persistent or to be placed ":U SKIP
      426               "in another SmartObject at UIB design time.":U
      427               VIEW-AS ALERT-BOX ERROR.
      428       RUN disable_UI.
      429       DELETE PROCEDURE THIS-PROCEDURE.
      430       RETURN.
      431   END.
      432   RUN dispatch ('create-objects':U).
      433   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME oxml-prp:PARENT eq ?
      434   THEN FRAME oxml-prp:PARENT = ACTIVE-WINDOW.
      435   MAIN-BLOCK:
      436   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      437      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      438     RUN dispatch IN THIS-PROCEDURE ('initialize':U).
      439     WAIT-FOR GO OF FRAME oxml-prp.
      440   END.
      441   RUN dispatch IN THIS-PROCEDURE ('destroy':U).
      442   PROCEDURE adm-create-objects :
      443     DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.
      444     RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
      445     ASSIGN adm-current-page = INTEGER(RETURN-VALUE).
      446     CASE adm-current-page:
      447       WHEN 0 THEN DO:
      448          RUN init-object IN THIS-PROCEDURE (
      449                INPUT  'bge/oxmlprop.w':U ,
      450                INPUT  FRAME oxml-prp:HANDLE ,
      451                INPUT  'Layout = ':U ,
      452                OUTPUT h_oxml-prop ).
      453          RUN set-position IN h_oxml-prop ( 2.63 , 2.63 ) NO-ERROR.
      454          RUN adjust-tab-order IN adm-broker-hdl ( h_oxml-prop ,
      455                b-help:HANDLE , 'AFTER':U ).
      456       END.
      457     END CASE.
      458     IF adm-current-page eq 0
      459     THEN RUN select-page IN THIS-PROCEDURE ( 1 ).
      460   END PROCEDURE.
      461   PROCEDURE adm-row-available :
      462     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      463     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      464     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      465     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      466     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      467     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      468     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      469     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      470     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      471     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      472     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      473     IF adm-updating-record THEN RETURN.
      474     RUN get-attribute ('FIELDS-ENABLED':U).
      475     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      476     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      477         OUTPUT link-handle) NO-ERROR.
      478     IF link-handle = "":U THEN
      479         RETURN.
      480     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      481     IF NUM-ENTRIES(link-handle) > 1 THEN
      482         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      483             "encountered more than one RECORD-SOURCE.":U SKIP
      484             "The first - ":U record-source-hdl:file-name " - will be used.":U
      485                VIEW-AS ALERT-BOX ERROR.
      486     RUN get-attribute ('Key-Name':U).
      487     key-name = RETURN-VALUE.
      488     IF key-name = "":U THEN key-name = ?.
      489     IF key-name NE ? THEN DO:
      490       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      491         NO-ERROR.
      492       IF key-value NE ? THEN
      493         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      494     END.
      495   IF VALID-HANDLE (adm-object-hdl) THEN
      496       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      497   RUN notify IN THIS-PROCEDURE ('row-available':U).
      498   END PROCEDURE.
      499   PROCEDURE disable_UI :
      500     HIDE FRAME oxml-prp.
      501   END PROCEDURE.
      502   PROCEDURE enable_UI :
      503     ENABLE b-exit b-help
      504         WITH FRAME oxml-prp.
      505     VIEW FRAME oxml-prp.
      506   END PROCEDURE.
      507   PROCEDURE send-records :
      508   END PROCEDURE.
      509   PROCEDURE state-changed :
      510     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
      511     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      512   END PROCEDURE.
