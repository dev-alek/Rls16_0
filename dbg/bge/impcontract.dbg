     1176   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1177   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1178   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     1179   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     1180   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     1181   ASSIGN
     1182      v-S_CONTRACT                = "Contract":U
     1183      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     1184      v-DELIM_CHR_3               = ","
     1185      .
     1186   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     1187   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     1188   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1189   FUNCTION Can-Find-Spec RETURN LOGICAL (
     1190      INPUT iHost-Code    AS INTEGER,
     1191      INPUT iContract-Num AS INTEGER,
     1192      INPUT iGds-Code     AS INTEGER ):
     1193      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     1194      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     1195      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     1196      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1197      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     1198      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     1199          INPUT  iHost-Code,
     1200          INPUT  iContract-Num,
     1201          OUTPUT iTmp-Extent3
     1202          ).
     1203      IF iTmp-Extent3[1] = 2 THEN DO:
     1204         ASSIGN
     1205            iTmp-Host-Code      = iTmp-Extent3[2]
     1206            iTmp-Contract-Num   = iTmp-Extent3[3]
     1207            .
     1208      END. ELSE DO:
     1209         ASSIGN
     1210            iTmp-Host-Code      = iHost-Code
     1211            iTmp-Contract-Num   = iContract-Num
     1212            .
     1213      END.
     1214      IF iGds-Code = ? THEN DO:
     1215         ASSIGN
     1216            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1217                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1218                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1219                           ).
     1220      END. ELSE DO:
     1221            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1222                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1223                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1224                              AND buf_Spec.Gds-Code      = iGds-Code
     1225                            ).
     1226      END.
     1227      RETURN (lRet).
     1228   END FUNCTION.
     1229   PROCEDURE MS-Contract-EXTENT-3:
     1230      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1231      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1232      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1233      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1234      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1235      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1236      FIND FIRST buf_Cont-2 WHERE
     1237                 buf_Cont-2.Host-Code      = i-Host-Code
     1238             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1239           NO-LOCK NO-ERROR.
     1240      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1241         RETURN.
     1242      END.
     1243      FOR FIRST buf_Ext-Classif WHERE
     1244                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1245           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1246                                               STRING(i-Contract-code)
     1247           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1248          NO-LOCK,
     1249          EACH buf_Cont WHERE
     1250               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1251           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1252          NO-LOCK:
     1253          ASSIGN
     1254             i-Ret[1] = 1
     1255             i-Ret[2] = buf_Cont.Host-code
     1256             i-Ret[3] = buf_Cont.Contract-code
     1257             .
     1258          LEAVE.
     1259      END.
     1260      IF i-Ret[1] <> 1 THEN DO:
     1261         FOR FIRST buf_Ext-Classif WHERE
     1262                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1263              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1264                                                  STRING(i-Contract-code)
     1265              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1266             NO-LOCK,
     1267             EACH buf_Cont WHERE
     1268                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1269              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1270             NO-LOCK:
     1271             ASSIGN
     1272                i-Ret[1] = 2
     1273                i-Ret[2] = buf_Cont.Host-code
     1274                i-Ret[3] = buf_Cont.Contract-code
     1275                .
     1276             LEAVE.
     1277         END.
     1278      END.
     1279      RETURN.
     1280   END PROCEDURE.
     1281   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1282   DEFINE VARIABLE v-gl-UVEDOMLENIE as CHARACTER NO-UNDO INITIAL "Uvedomlenie":U.
     1283   FUNCTION Get-Contract-Attr RETURN CHARACTER(
     1284            INPUT iHost-Code AS INTEGER,
     1285            INPUT iContract-Code  AS INTEGER,
     1286            INPUT cAttr-code      AS CHARACTER):
     1287      DEFINE BUFFER buf_Contract-Attr FOR ub.Contract-Attr.
     1288      FIND FIRST buf_Contract-Attr WHERE
     1289                 buf_Contract-Attr.Host-code     = iHost-Code
     1290             AND buf_Contract-Attr.Contract-code = iContract-Code
     1291             AND buf_Contract-Attr.Attr-code     = cAttr-code
     1292           NO-LOCK NO-ERROR.
     1293      RETURN (IF AVAILABLE buf_Contract-Attr THEN buf_Contract-Attr.Attr-value ELSE ?).
     1294   END FUNCTION.
     1295   PROCEDURE Modify-Contract-Attr:
     1296      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
     1297      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
     1298      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
     1299      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
     1300      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
     1301      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
     1302      Tran:
     1303      DO TRANSACTION
     1304         ON ENDKEY UNDO Tran, RETRY Tran
     1305         ON ERROR  UNDO Tran, RETRY Tran
     1306         ON QUIT   UNDO Tran, RETRY Tran
     1307         ON STOP   UNDO Tran, RETRY Tran:
     1308         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1309         FIND FIRST buf_Contract-Attr WHERE
     1310                    buf_Contract-Attr.Host-Code      = iHost-Code
     1311                AND buf_Contract-Attr.Contract-Code  = iContract-Code
     1312                AND buf_Contract-Attr.Attr-code      = cAttr-code
     1313              NO-LOCK NO-ERROR.
     1314         IF NOT AVAILABLE buf_Contract-Attr THEN DO:
     1315            CREATE buf_Contract-Attr NO-ERROR.
     1316            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1317         END. ELSE DO:
     1318            FIND CURRENT buf_Contract-Attr EXCLUSIVE-LOCK NO-ERROR.
     1319            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1320         END.
     1321         ASSIGN
     1322            buf_Contract-Attr.Host-Code      = iHost-Code
     1323            buf_Contract-Attr.Contract-Code  = iContract-Code
     1324            buf_Contract-Attr.Attr-code      = cAttr-code
     1325            buf_Contract-Attr.Attr-value     = cAttr-value
     1326            NO-ERROR.
     1327         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1328         RELEASE buf_Contract-Attr NO-ERROR.
     1329         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1330      END.
     1331      RETURN.
     1332   END PROCEDURE.
     1333   PROCEDURE Create-Contract-Attr:
     1334      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
     1335      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
     1336      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
     1337      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
     1338      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
     1339      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
     1340      Tran:
     1341      DO TRANSACTION
     1342         ON ENDKEY UNDO Tran, RETRY Tran
     1343         ON ERROR  UNDO Tran, RETRY Tran
     1344         ON QUIT   UNDO Tran, RETRY Tran
     1345         ON STOP   UNDO Tran, RETRY Tran:
     1346         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1347         CREATE buf_Contract-Attr NO-ERROR.
     1348         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1349         ASSIGN
     1350            buf_Contract-Attr.Host-Code      = iHost-Code
     1351            buf_Contract-Attr.Contract-Code  = iContract-Code
     1352            buf_Contract-Attr.Attr-code      = cAttr-code
     1353            buf_Contract-Attr.Attr-value     = cAttr-value
     1354            NO-ERROR.
     1355         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1356         RELEASE buf_Contract-Attr NO-ERROR.
     1357         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1358      END.
     1359      RETURN.
     1360   END PROCEDURE.
     1361   FUNCTION Is-MS-Contract RETURN LOGICAL(BUFFER buf_Master FOR ub.Contract, BUFFER buf_Slave  FOR ub.Contract) FORWARD.
     1362   FUNCTION Is-Master-Slave-Contract RETURN CHARACTER( BUFFER buf_Contract FOR ub.Contract) FORWARD.
     1363   FUNCTION Is-MS-Contract-Int RETURN INTEGER (BUFFER buf_Contract FOR ub.Contract) FORWARD.
     1364   PROCEDURE Delete-Contract-Specif:
     1365      DEFINE PARAMETER BUFFER buf_Contract FOR ub.Contract.
     1366      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1367      DEFINE BUFFER buf_Specif      FOR ub.Contract-Specif.
     1368      DEFINE BUFFER buf_Specif-Attr FOR ub.Contract-Specif-Attr.
     1369      Tran:
     1370      DO TRANSACTION
     1371         ON ENDKEY UNDO Tran, RETRY Tran
     1372         ON ERROR  UNDO Tran, RETRY Tran
     1373         ON QUIT   UNDO Tran, RETRY Tran
     1374         ON STOP   UNDO Tran, RETRY Tran:
     1375         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1376         FOR EACH buf_Specif-Attr WHERE
     1377                  buf_Specif-Attr.Host-code     = buf_Contract.Host-code
     1378              AND buf_Specif-Attr.Contract-Num  = buf_Contract.Contract-code
     1379             EXCLUSIVE-LOCK:
     1380             DELETE buf_Specif-Attr NO-ERROR.
     1381             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1382         END.
     1383         FOR EACH buf_Specif WHERE
     1384                  buf_Specif.Host-code     = buf_Contract.Host-code
     1385              AND buf_Specif.Contract-Num  = buf_Contract.Contract-code
     1386             EXCLUSIVE-LOCK:
     1387             DELETE buf_Specif NO-ERROR.
     1388            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1389         END.
     1390      END.
     1391      RETURN.
     1392   END PROCEDURE.
     1393   PROCEDURE Modify-Slave-Contract:
     1394      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1395      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1396      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1397      DEFINE BUFFER buf_Slave FOR ub.Contract.
     1398      Tran:
     1399      DO TRANSACTION
     1400         ON ENDKEY UNDO Tran, RETRY Tran
     1401         ON ERROR  UNDO Tran, RETRY Tran
     1402         ON QUIT   UNDO Tran, RETRY Tran
     1403         ON STOP   UNDO Tran, RETRY Tran:
     1404         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1405         FOR EACH buf_Ext-Classif WHERE
     1406                  buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1407              AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1408              AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1409             NO-LOCK,
     1410             FIRST buf_Slave WHERE
     1411                   buf_Slave.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1412               AND buf_Slave.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1413             EXCLUSIVE-LOCK:
     1414             BUFFER-COPY
     1415               buf_Master
     1416             EXCEPT
     1417               Host-code                               Contract-code                           Own-name                                an-uchet-code-out                       cel-nazn-code-out                       cor-acc-out                             cor-acc1-out                            an-uchet-code-in                        cel-nazn-code-in                        cor-acc-in                              cor-acc1-in                             an-uchet-code-out-cash                  cel-nazn-code-out-cash                  cor-acc-out-cash                        cor-acc1-out-cash                       an-uchet-code-in-cash                   cel-nazn-code-in-cash                   cor-acc-in-cash                         cor-acc1-in-cash                        an-uchet-code-out-payoff                cel-nazn-code-out-payoff                cor-acc-out-payoff                      cor-acc1-out-payoff                     an-uchet-code-in-payoff                 cel-nazn-code-in-payoff                 cor-acc-in-payoff                       cor-acc1-in-payoff                      transport-cli-type                      transport-cli-code                      transport-host                          transport-contract                      transport-uslov                         transport-value                         own-code-schet-start                    own-sign-post                           own-sign                                contract-city                           fin-VAT-pc                              srok-opl                                gen-factur-srok                         own-addres                              own-inn                                 own-kpp
     1418             TO buf_Slave
     1419             NO-ERROR.
     1420             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1421             RELEASE buf_Slave NO-ERROR.
     1422             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1423         END.
     1424      END.
     1425      RETURN.
     1426   END PROCEDURE.
     1427   PROCEDURE Change-Stat-Slave-Contract:
     1428      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1429      DEFINE INPUT PARAMETER cStatus  AS CHARACTER NO-UNDO.
     1430      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1431      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1432      DEFINE BUFFER buf_Slave FOR ub.Contract.
     1433      Tran:
     1434      DO TRANSACTION
     1435         ON ENDKEY UNDO Tran, RETRY Tran
     1436         ON ERROR  UNDO Tran, RETRY Tran
     1437         ON QUIT   UNDO Tran, RETRY Tran
     1438         ON STOP   UNDO Tran, RETRY Tran:
     1439         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1440         FOR EACH buf_Ext-Classif WHERE
     1441                  buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1442              AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1443              AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1444             NO-LOCK,
     1445             FIRST buf_Slave WHERE
     1446                   buf_Slave.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1447               AND buf_Slave.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1448             EXCLUSIVE-LOCK:
     1449             ASSIGN
     1450                buf_Slave.Status_ = cStatus
     1451                NO-ERROR.
     1452             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1453             RELEASE buf_Slave NO-ERROR.
     1454             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1455         END.
     1456      END.
     1457      RETURN.
     1458   END PROCEDURE.
     1459   PROCEDURE Delete-Ref-Master-Slave:
     1460      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1461      DEFINE PARAMETER BUFFER buf_Slave  FOR ub.Contract.
     1462      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1463      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1464      IF NOT Is-MS-Contract(BUFFER buf_Master, BUFFER buf_Slave) THEN DO:
     1465         cError = PROGRAM-NAME(1) + ":" + "Между договорами нет связи Master->Slave".
     1466         RETURN.
     1467      END.
     1468      Tran:
     1469      FOR FIRST buf_Ext-Classif WHERE
     1470                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1471            AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1472            AND buf_Ext-Classif.CharKey_Two  = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     1473            AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1474          EXCLUSIVE-LOCK
     1475          TRANSACTION
     1476          ON ENDKEY UNDO Tran, RETRY Tran
     1477          ON ERROR  UNDO Tran, RETRY Tran
     1478          ON QUIT   UNDO Tran, RETRY Tran
     1479          ON STOP   UNDO Tran, RETRY Tran:
     1480          IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1481          DELETE buf_Ext-Classif NO-ERROR.
     1482          IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1483      END.
     1484      RETURN.
     1485   END PROCEDURE.
     1486   PROCEDURE Create-Ref-Master-Slave:
     1487      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     1488      DEFINE PARAMETER BUFFER buf_Slave  FOR ub.Contract.
     1489      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     1490      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1491      DEFINE VARIABLE cKeyRec AS CHARACTER NO-UNDO INITIAL "".
     1492      IF Is-MS-Contract(BUFFER buf_Master, BUFFER buf_Slave) THEN DO:
     1493         cError = PROGRAM-NAME(1) + ":" + "Между договорами  уже есть связь Master->Slave".
     1494         RETURN.
     1495      END.
     1496      RUN gen-key-rec IN THIS-PROCEDURE(
     1497          INPUT  v-S_CONTRACT,
     1498          INPUT  BUFFER buf_Master:HANDLE,
     1499          OUTPUT cKeyRec
     1500          ) NO-ERROR.
     1501      IF ERROR-STATUS:ERROR THEN DO:
     1502         cError = PROGRAM-NAME(1) + ":" + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.
     1503         RETURN.
     1504      END.
     1505      Tran:
     1506      DO TRANSACTION
     1507         ON ENDKEY UNDO Tran, RETRY Tran
     1508         ON ERROR  UNDO Tran, RETRY Tran
     1509         ON QUIT   UNDO Tran, RETRY Tran
     1510         ON STOP   UNDO Tran, RETRY Tran:
     1511         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     1512         CREATE buf_Ext-Classif NO-ERROR.
     1513         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1514         ASSIGN
     1515            buf_Ext-Classif.Classif-name    = v-S_CONTRACT
     1516            buf_Ext-Classif.Classif-subject = v-S_CONTRACT
     1517            buf_Ext-Classif.CharKey_One     = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1518            buf_Ext-Classif.CharKey_Two     = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     1519            buf_Ext-Classif.DB-num          = buf_Master.Db-num
     1520            buf_Ext-Classif.Uniq-key-rec    = cKeyRec
     1521            NO-ERROR.
     1522         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1523         RELEASE buf_Ext-Classif NO-ERROR.
     1524         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     1525      END.
     1526      RETURN.
     1527   END PROCEDURE.
     1528   FUNCTION Is-MS-Contract-Int-2 RETURN INTEGER (
     1529                                 i-Host-Code AS INTEGER,
     1530                                 i-Contract-Code AS INTEGER):
     1531      DEFINE BUFFER buf_Contract FOR ub.Contract.
     1532      DEFINE VARIABLE iRet AS INTEGER NO-UNDO INITIAL 0.
     1533      FIND FIRST buf_Contract WHERE
     1534                 buf_Contract.Host-Code      = i-Host-Code
     1535             AND buf_Contract.Contract-code  = i-Contract-Code
     1536           NO-LOCK NO-ERROR.
     1537      IF AVAILABLE buf_Contract THEN DO:
     1538         ASSIGN
     1539            iRet = Is-MS-Contract-Int(BUFFER buf_Contract).
     1540      END.
     1541      RETURN (iRet).
     1542   END FUNCTION.
     1543   FUNCTION Is-MS-Contract-Int RETURN INTEGER (BUFFER buf_Contract FOR ub.Contract):
     1544      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1545      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1546      DEFINE VARIABLE iRet AS INTEGER NO-UNDO INITIAL 0.
     1547      FOR FIRST buf_Ext-Classif WHERE
     1548                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1549           AND  buf_Ext-Classif.CharKey_One  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1550                                               STRING(buf_Contract.contract-code)
     1551           AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1552          NO-LOCK,
     1553          EACH buf_Cont WHERE
     1554               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1555           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1556          NO-LOCK:
     1557          ASSIGN
     1558             iRet = 1.
     1559          LEAVE.
     1560      END.
     1561      IF iRet <> 1 THEN DO:
     1562         FOR FIRST buf_Ext-Classif WHERE
     1563                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1564              AND  buf_Ext-Classif.CharKey_Two  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1565                                                  STRING(buf_Contract.contract-code)
     1566              AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1567             NO-LOCK,
     1568             EACH buf_Cont WHERE
     1569                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1570              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1571             NO-LOCK:
     1572             ASSIGN
     1573                iRet = 2.
     1574             LEAVE.
     1575         END.
     1576      END.
     1577      RETURN (iRet).
     1578   END FUNCTION.
     1579   FUNCTION Is-Master-Slave-Contract RETURN CHARACTER( BUFFER buf_Contract FOR ub.Contract):
     1580      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1581      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1582      DEFINE VARIABLE cRet AS CHARACTER NO-UNDO INITIAL "".
     1583      FOR FIRST buf_Ext-Classif WHERE
     1584                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1585           AND  buf_Ext-Classif.CharKey_One  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1586                                               STRING(buf_Contract.contract-code)
     1587           AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1588          NO-LOCK,
     1589          EACH buf_Cont WHERE
     1590               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1591           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1592          NO-LOCK:
     1593          ASSIGN
     1594             cRet = "+".
     1595          LEAVE.
     1596      END.
     1597      IF cRet = "" THEN DO:
     1598         FOR FIRST buf_Ext-Classif WHERE
     1599                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1600              AND  buf_Ext-Classif.CharKey_Two  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     1601                                                  STRING(buf_Contract.contract-code)
     1602              AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     1603             NO-LOCK,
     1604             EACH buf_Cont WHERE
     1605                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1606              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1607             NO-LOCK:
     1608             ASSIGN
     1609                cRet = (IF buf_Cont.Contract-prn-code = "" THEN  STRING(buf_Cont.Contract-code) ELSE buf_Cont.Contract-prn-code).
     1610             LEAVE.
     1611         END.
     1612      END.
     1613      RETURN (cRet).
     1614   END FUNCTION.
     1615   FUNCTION Is-MS-Contract RETURN LOGICAL(
     1616            BUFFER buf_Master FOR ub.Contract,
     1617            BUFFER buf_Slave  FOR ub.Contract):
     1618      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1619      RETURN CAN-FIND ( FIRST buf_Ext-Classif WHERE
     1620                          buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1621                      AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1622                      AND buf_Ext-Classif.CharKey_Two  = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     1623                      AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1624                    NO-LOCK).
     1625   END FUNCTION.
     1626   FUNCTION Get-Num-Slave-Contract RETURN CHARACTER(
     1627            BUFFER buf_Master FOR ub.Contract,
     1628            INPUT iSlave-Host-Code AS INTEGER
     1629            ):
     1630      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     1631      DEFINE BUFFER buf_Contract    FOR ub.Contract.
     1632      DEFINE VARIABLE cRet AS CHARACTER NO-UNDO INITIAL "".
     1633      FIND FIRST buf_Ext-Classif WHERE
     1634                 buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1635             AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     1636             AND buf_Ext-Classif.CharKey_Two  BEGINS STRING(iSlave-Host-Code) + v-DELIM_CHR_3
     1637             AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     1638           NO-LOCK NO-ERROR.
     1639      IF AVAILABLE buf_Ext-Classif THEN DO:
     1640         IF CAN-FIND (FIRST buf_Contract WHERE
     1641                            buf_Contract.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1642                        AND buf_Contract.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1643                       NO-LOCK) THEN DO:
     1644            ASSIGN
     1645               cRet = ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3).
     1646         END. ELSE DO:
     1647            ASSIGN
     1648               cRet = "ERROR:" + "Ошибка связи мастер договора " +
     1649                      STRING(buf_Master.Host-Code) + "," + STRING(buf_Master.Contract-code) + " " +
     1650                      "c Host-code=" + STRING(iSlave-Host-Code).
     1651         END.
     1652      END.
     1653      RETURN (cRet).
     1654   END FUNCTION.
     1655   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
     1656       LABEL "Отмена"
     1657       SIZE 10 BY 1
     1658       BGCOLOR 8 .
     1659   DEFINE BUTTON Btn_change
     1660       LABEL "Изменить"
     1661       SIZE 10 BY 1
     1662       BGCOLOR 8 .
     1663   DEFINE BUTTON Btn_del
     1664       LABEL "Удалить"
     1665       SIZE 10 BY 1
     1666       BGCOLOR 8 .
     1667   DEFINE BUTTON Btn_EXIT AUTO-GO
     1668       LABEL "Сохранить"
     1669       SIZE 10 BY 1
     1670       BGCOLOR 8 .
     1671   DEFINE BUTTON Btn_imp
     1672       LABEL "Импорт"
     1673       SIZE 10 BY 1
     1674       BGCOLOR 8 .
     1675   DEFINE BUTTON Btn_OK AUTO-GO
     1676       LABEL "Ввод"
     1677       SIZE 10 BY 1
     1678       BGCOLOR 8 .
     1679   DEFINE QUERY br-contract FOR
     1680       tt-contract SCROLLING.
     1681   DEFINE BROWSE br-contract
     1682       QUERY br-contract NO-LOCK DISPLAY
     1683       tt-contract.doc-type FORMAT "X(4)":U WIDTH 10         LABEL "Тип"
     1684       tt-contract.cli-type FORMAT "X(3)":U WIDTH 10         LABEL "Объект"
     1685       tt-contract.cli-code FORMAT ">>>>>>>>>>>9":U          LABEL "Код"
     1686       tt-contract.contract-prn-code FORMAT "X(16)":U        LABEL "Номер"
     1687       tt-contract.contract-type FORMAT "X(50)":U            LABEL "Тип договора"
     1688       tt-contract.contract-date FORMAT "99/99/9999":U       LABEL "Дата"
     1689       tt-contract.contract-date-beg FORMAT "99/99/9999":U   LABEL "Начало"
     1690       tt-contract.contract-date-end FORMAT "99/99/9999":U   LABEL "Конец"
     1691       tt-contract.host-code FORMAT "9999999999":U WIDTH 13.63    LABEL "Фирма"
     1692       (if tt-contract.edi then "+":U else "-":U) format "X(1)":U LABEL "Поставки через ЭДО"
     1693       WITH NO-ROW-MARKERS SEPARATORS SIZE 95.5 BY 15.5 FIT-LAST-COLUMN.
     1694   DEFINE FRAME Dialog-Frame
     1695       Btn_OK AT ROW 1.25 COL 2
     1696       Btn_EXIT AT ROW 1.25 COL 2
     1697       Btn_Cancel AT ROW 1.25 COL 12
     1698       Btn_del AT ROW 1.25 COL 22
     1699       Btn_change AT ROW 1.25 COL 22 WIDGET-ID 2
     1700       Btn_imp AT ROW 1.25 COL 22
     1701       br-contract AT ROW 2.5 COL 1.5 WIDGET-ID 200
     1702       SPACE(0.62) SKIP(0.03)
     1703       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1704       SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1705       TITLE "Импорт договоров"
     1706       DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
     1707   ASSIGN
     1708       FRAME Dialog-Frame:SCROLLABLE = FALSE.
     1709   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1710       DO:
     1711           APPLY "END-ERROR":U TO SELF.
     1712       END.
     1713   ON ROW-DISPLAY OF br-contract IN FRAME Dialog-Frame
     1714       DO:
     1715           if tt-contract.contract-type = ""  then
     1716           do:
     1717               tt-contract.contract-type:BGCOLOR in browse br-contract = red_COLOR.
     1718           end.
     1719           if tt-contract.contract-prn-code = "" then
     1720           do:
     1721               tt-contract.contract-prn-code:BGCOLOR in browse br-contract = red_COLOR.
     1722           end.
     1723           if tt-contract.cli-code = 0 then
     1724           do:
     1725               tt-contract.cli-code:BGCOLOR in browse br-contract = red_COLOR.
     1726           end.
     1727           if tt-contract.cli-type = "" then
     1728           do:
     1729               tt-contract.cli-type:BGCOLOR in browse br-contract = red_COLOR.
     1730           end.
     1731           if tt-contract.doc-type = "" then
     1732           do:
     1733               tt-contract.doc-type:BGCOLOR in browse br-contract = red_COLOR.
     1734           end.
     1735           find first clients no-lock where clients.obj-type = tt-contract.cli-type
     1736                                        and clients.obj-code = tt-contract.cli-code
     1737                                        no-error.
     1738           if not available clients
     1739           then do :
     1740             tt-contract.cli-code:BGCOLOR in browse br-contract = red_COLOR.
     1741             tt-contract.cli-type:BGCOLOR in browse br-contract = red_COLOR.
     1742           end.
     1743           find first firm no-lock where firm.firm-code = tt-contract.host-code no-error .
     1744           if not available firm
     1745           then do :
     1746             tt-contract.host-code:BGCOLOR in browse br-contract = red_COLOR.
     1747           end.
     1748       END.
     1749   ON CHOOSE OF Btn_change IN FRAME Dialog-Frame
     1750       DO:
     1751           define buffer buf_tt-contract for tt-contract .
     1752           define VARIABLE v-doc-type          as character no-undo .
     1753           define VARIABLE v-cli-type          as character no-undo .
     1754           DEFINE VARIABLE v-cli-code          as integer   no-undo .
     1755           DEFINE VARIABLE v-contract-prn-code as character no-undo .
     1756           DEFINE VARIABLE v-contract-type     as character no-undo .
     1757           DEFINE VARIABLE v-contract-date     as date      no-undo .
     1758           DEFINE VARIABLE v-contract-date-beg as date      no-undo .
     1759           DEFINE VARIABLE v-contract-date-end as date      no-undo .
     1760           DEFINE VARIABLE v-host-code         as integer   no-undo .
     1761           assign
     1762               v-doc-type          = tt-contract.doc-type
     1763               v-cli-type          = tt-contract.cli-type
     1764               v-cli-code          = tt-contract.cli-code
     1765               v-contract-prn-code = tt-contract.contract-prn-code
     1766               v-contract-type     = tt-contract.contract-type
     1767               v-contract-date     = tt-contract.contract-date
     1768               v-contract-date-beg = tt-contract.contract-date-beg
     1769               v-contract-date-end = tt-contract.contract-date-end
     1770               v-host-code         = tt-contract.host-code
     1771               .
     1772           run bge/edit_contract.w (
     1773               input-output v-doc-type,
     1774               input-output v-cli-type,
     1775               input-output v-cli-code,
     1776               input-output v-contract-prn-code,
     1777               input-output v-contract-type,
     1778               input-output v-contract-date,
     1779               input-output v-contract-date-beg,
     1780               input-output v-contract-date-end,
     1781               input-output v-host-code
     1782               ) no-error .
     1783           find first buf_tt-contract where buf_tt-contract.contract-prn-code = tt-contract.contract-prn-code no-error .
     1784           if not AVAILABLE buf_tt-contract then
     1785           do:
     1786               create buf_tt-contract .
     1787               tt-contract.contract-prn-code = v-contract-prn-code .
     1788           end.
     1789           assign
     1790               tt-contract.doc-type          = v-doc-type
     1791               tt-contract.cli-type          = v-cli-type
     1792               tt-contract.cli-code          = v-cli-code
     1793               tt-contract.contract-type     = v-contract-type
     1794               tt-contract.contract-date     = v-contract-date
     1795               tt-contract.contract-date-beg = v-contract-date-beg
     1796               tt-contract.contract-date-end = v-contract-date-end
     1797               tt-contract.host-code         = v-host-code
     1798               .
     1799       END.
     1800   ON CHOOSE OF Btn_del IN FRAME Dialog-Frame
     1801       DO:
     1802       END.
     1803   ON CHOOSE OF Btn_EXIT IN FRAME Dialog-Frame
     1804       DO:
     1805           run create-proc in this-procedure no-error .
     1806           if return-value = "cancel" then return no-apply .
     1807       END.
     1808   ON choose OF Btn_imp IN FRAME Dialog-Frame
     1809       DO:
     1810           run proc-choose-file no-error .
     1811       END.
     1812   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1813       THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1814   MAIN-BLOCK:
     1815   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1816       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1817       RUN enable_UI.
     1818       WAIT-FOR GO OF FRAME Dialog-Frame.
     1819   END.
     1820   RUN disable_UI.
     1821   PROCEDURE disable_UI :
     1822       HIDE FRAME Dialog-Frame.
     1823   END PROCEDURE.
     1824   PROCEDURE enable_UI :
     1825       ENABLE Btn_OK Btn_EXIT Btn_Cancel Btn_imp br-contract
     1826           WITH FRAME Dialog-Frame.
     1827       OPEN QUERY br-contract FOR EACH tt-contract NO-LOCK INDEXED-REPOSITION.
     1828   END PROCEDURE.
     1829   PROCEDURE proc-choose-file :
     1830       if search (v-proc-name-err) <> ? then
     1831       do:
     1832           os-delete value(v-proc-name-err).
     1833       end.
     1834       if search (v-proc-name-alc) <> ? then
     1835       do:
     1836           os-delete value(v-proc-name-alc).
     1837       end.
     1838       DEFINE VARIABLE vCh AS CHARACTER NO-UNDO.
     1839       DEFINE VARIABLE vLg AS LOGICAL   NO-UNDO.
     1840       def    var      ii  as int.
     1841       SYSTEM-DIALOG GET-FILE vCh
     1842           MUST-EXIST
     1843           TITLE "Выбор файла"
     1844           USE-FILENAME UPDATE vLg.
     1845       IF vCh <> "" THEN
     1846       DO:
     1847           output stream str-err to value(v-proc-name-err)   .
     1848           INPUT FROM value(vCh).
     1849           REPEAT:
     1850               create tt-contract .
     1851               import DELIMITER ";" tt-contract no-error.
     1852               tt-contract.doc-type = trim(tt-contract.doc-type) .
     1853               if tt-contract.doc-type <> 'при':U and tt-contract.doc-type <> 'рас':U and tt-contract.doc-type <> "" then
     1854               do:
     1855                   put stream str-err unformatted
     1856                       "Не существующий тип документа" + " " + tt-contract.doc-type + "."
     1857                       skip .
     1858                   tt-contract.log-error = yes .
     1859                   tt-contract.doc-type = "" .
     1860               end.
     1861               tt-contract.cli-type = trim(tt-contract.cli-type) .
     1862               if tt-contract.cli-type <> 'чел':U and tt-contract.cli-type <> 'орг':U and tt-contract.cli-type <> "" then
     1863               do:
     1864                   put stream str-err unformatted
     1865                       "Не существующий тип поставщика" + " " + tt-contract.cli-type + "."
     1866                       skip .
     1867                   tt-contract.log-error = yes .
     1868                   tt-contract.cli-type = "" .
     1869               end.
     1870               if tt-contract.cli-code <> 0 then
     1871               do:
     1872                   find first buf_clients no-lock where buf_clients.obj-code = tt-contract.cli-code and buf_clients.obj-type = tt-contract.cli-type no-error .
     1873                   if not AVAILABLE buf_clients then
     1874                   do:
     1875                       put stream str-err unformatted
     1876                           "Нет поставщика с типом" + " " + tt-contract.cli-type + " и кодом " + string(tt-contract.cli-code)
     1877                           skip .
     1878                       tt-contract.log-error = yes .
     1879                       tt-contract.cli-code = 0 .
     1880                   end.
     1881                   else
     1882                   do:
     1883                       tt-contract.cli-name = buf_clients.obj-name .
     1884                   end.
     1885               end.
     1886               tt-contract.contract-prn-code = trim(tt-contract.contract-prn-code) .
     1887               if tt-contract.cli-code <>  0 and tt-contract.cli-type <> "" and tt-contract.doc-type <> "" and (tt-contract.contract-prn-code = "" or tt-contract.contract-prn-code = ?) then
     1888               do:
     1889                   put stream str-err unformatted
     1890                       "Не задан номер договора."
     1891                       skip .
     1892                   tt-contract.log-error = yes .
     1893                   tt-contract.contract-prn-code = "".
     1894               end.
     1895               tt-contract.contract-type = trim(tt-contract.contract-type) .
     1896               if tt-contract.contract-type <> 'Купли-продажи':U
     1897                   and tt-contract.contract-type <> 'Консигнации':U
     1898                   and tt-contract.contract-type <> 'Ответственного хранения':U
     1899                   and tt-contract.contract-type <> 'Агентский договор':U
     1900                   and tt-contract.contract-type <> 'Давальческого сырья':U
     1901                   and tt-contract.contract-type <> 'Продажи через ТПСИ':U
     1902                   and tt-contract.contract-type <> ""
     1903                   then
     1904               do:
     1905                   put stream str-err unformatted
     1906                       "Не существующий тип договора  " + tt-contract.contract-type + "."
     1907                       skip .
     1908                   tt-contract.log-error = yes .
     1909                   tt-contract.contract-type = "" .
     1910               end.
     1911               find first firm no-lock where firm.firm-code = tt-contract.host-code no-error .
     1912               if not available firm
     1913               then do :
     1914                 put stream str-err unformatted
     1915                       "Не найдена собственная фирма с кодом  " + string(tt-contract.host-code) + "."
     1916                       skip .
     1917                   tt-contract.log-error = yes .
     1918                   tt-contract.host-code = 0 .
     1919               end.
     1920           END.
     1921           INPUT CLOSE.
     1922           output stream str-err close.
     1923           message substitute("Импорт контрактов завершен.")
     1924               view-as alert-box.
     1925       END.
     1926       for each tt-contract:
     1927           if tt-contract.doc-type = "" and tt-contract.cli-type = "" and tt-contract.cli-code = 0 then
     1928           do:
     1929               DELETE tt-contract .
     1930           end.
     1931       end.
     1932       open query br-contract for each tt-contract .
     1933   END PROCEDURE.
     1934   PROCEDURE create-proc :
     1935       define variable p-sys-date     as date      no-undo .
     1936       define variable p-sys-time     as character no-undo .
     1937       define variable p-sys-time-int as integer   no-undo .
     1938       define variable f-code         as integer   no-undo .
     1939       define variable v-log          as logical   no-undo .
     1940       define variable bad-contract-list as character no-undo .
     1941       find first tt-contract no-lock where tt-contract.log-error = yes no-error .
     1942       if available tt-contract
     1943       then do :
     1944         for each tt-contract no-lock where tt-contract.log-error = yes :
     1945           bad-contract-list = bad-contract-list + tt-contract.contract-prn-code + ", " .
     1946         end.
     1947         bad-contract-list = trim(bad-contract-list) .
     1948         bad-contract-list = trim(bad-contract-list, ",") .
     1949         message "Список договоров, которые НЕ будут сохранены: " skip
     1950                 bad-contract-list skip
     1951                 "Ошибки в файле impcontract.err" skip
     1952                 "Продолжить?"
     1953         view-as alert-box question buttons yes-no update v-log .
     1954         if not v-log
     1955         then do :
     1956           return "cancel" .
     1957         end.
     1958       end .
     1959       for each tt-contract no-lock where tt-contract.log-error = no and tt-contract.doc-type <> "":
     1960           find first b_contract EXCLUSIVE-LOCK where b_contract.contract-prn-code = tt-contract.contract-prn-code and b_contract.cli-code = tt-contract.cli-code
     1961           and b_contract.cli-type = tt-contract.cli-type no-error .
     1962           if not AVAILABLE (b_contract) then
     1963           do:
     1964               run gen-b-code in this-procedure ( input 'ctgb':U, output f-code) no-error .
     1965               if error-status:error then
     1966               do:
     1967                   message "Ошибка при генерации внутреннего № договора" view-as alert-box ERROR.
     1968                   return error.
     1969               end.
     1970   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1971   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdburt in g#library
     1972     (output tt-contract.user-db-num
     1973     ,output tt-contract.user-name
     1974     ,output p-sys-date
     1975     ,output p-sys-time
     1976     ,output p-sys-time-int
     1977     )  .
     1978               create b_contract .
     1979               assign
     1980                   b_contract.contract-code     = f-code
     1981                   b_contract.contract-prn-code = tt-contract.contract-prn-code
     1982                   b_contract.cli-type          = tt-contract.cli-type
     1983                   b_contract.cli-code          = tt-contract.cli-code
     1984                   b_contract.cli-name          = tt-contract.cli-name
     1985                   .
     1986           end.
     1987           assign
     1988               b_contract.doc-type          = tt-contract.doc-type
     1989               b_contract.host-code         = tt-contract.host-code
     1990               b_contract.contract-type     = tt-contract.contract-type
     1991               b_contract.status_           = 'тек':U
     1992               b_contract.user-db-num       = tt-contract.user-db-num
     1993               b_contract.contract-date     = tt-contract.contract-date
     1994               b_contract.contract-date-beg = tt-contract.contract-date-beg
     1995               b_contract.contract-date-end = tt-contract.contract-date-end
     1996               b_contract.contract-prn-code = tt-contract.contract-prn-code
     1997               .
     1998         if tt-contract.edi then do:
     1999           find first b_contract-attr exclusive-lock where b_contract-attr.host-code = b_contract.host-code and b_contract-attr.contract-code = b_contract.contract-code
     2000           and b_contract-attr.attr-code = "contract-edi"  no-error .
     2001           if available (b_contract-attr) then b_contract-attr.attr-value = string(tt-contract.edi) .
     2002           else do:
     2003             create b_contract-attr .
     2004             assign
     2005             b_contract-attr.host-code = b_contract.host-code
     2006             b_contract-attr.contract-code = b_contract.contract-code
     2007             b_contract-attr.attr-code = "contract-edi"
     2008             b_contract-attr.attr-value = string (tt-contract.edi)
     2009             .
     2010           end.
     2011         end.
     2012       end.
     2013   END PROCEDURE.
