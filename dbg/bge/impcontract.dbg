        1   define input parameter parparentproc as widget-handle no-undo .
        2   define variable l-error         as logical   no-undo.
        3   define variable v-user-action   as character no-undo.
        4   define variable v-printed       as logical   no-undo.
        5   define variable v-proc-name-err as character no-undo initial 'impcontract.err'.
        6   define variable v-proc-name-alc as character no-undo initial 'imp-contr.txt'.
        7   define variable browse-br-marks as handle    no-undo.
        8   define variable bcol            as handle    no-undo.
        9   define variable bcol1           as handle    no-undo.
       10   define variable bcol2           as handle    no-undo.
       11   define variable bcol3           as handle    no-undo.
       12   define variable bcol4           as handle    no-undo.
       13   define variable bcol5           as handle    no-undo.
       14   define variable v-mode          as character no-undo.
       15   DEFINE buffer buf_clients for ub.clients .
       16   define buffer b_contract  for ub.contract.
       17   define buffer b_contract-attr for ub.contract-attr .
       18   define stream str-err .
       19   define stream str-contract .
       20   define TEMP-TABLE tt-contract no-undo
       21       field doc-type          as character
       22       field cli-type          as character
       23       field cli-code          as integer
       24       field contract-prn-code as character
       25       field contract-type     as character
       26       field contract-date     as DATE
       27       field contract-date-beg as date
       28       field contract-date-end as date
       29       field host-code         as integer
       30       field edi               as logical
       31       field contract-code     as integer
       32       field cli-name          as character
       33       field user-name         as character
       34       field user-db-num       as integer
       35       field log-error         as LOGICAL   INIT no
       36       index host-code contract-date contract-prn-code.
       37   define variable vss-revision    as character no-undo init "$Revision$":U .
       38   define variable vss-author      as character no-undo init "$Author$":U .
       39   define variable vss-date        as character no-undo init "$Date$":U .
       40   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       41   define variable vss-archive     as character no-undo init "$Archive$":U .
       42   define variable vss-description as character no-undo init "Импорт контрактов".
       43   procedure vss-get-info :
       44     define output parameter p-vss-revision    like vss-revision    no-undo .
       45     define output parameter p-vss-author      like vss-author      no-undo .
       46     define output parameter p-vss-date        like vss-date        no-undo .
       47     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       48     define output parameter p-vss-archive     like vss-archive     no-undo .
       49     define output parameter p-vss-description like vss-description no-undo .
       50     assign
       51       p-vss-revision    = vss-revision
       52       p-vss-author      = vss-author
       53       p-vss-date        = vss-date
       54       p-vss-workfile    = vss-workfile
       55       p-vss-archive     = vss-archive
       56       p-vss-description = vss-description
       57     .
       58   end procedure.
       59   procedure vss-get-parameters :
       60     define output parameter p-vss-parameters as character no-undo .
       61   end procedure.
       62   define new global shared variable g#vssrevis-logger as handle    no-undo .
       63   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       64   define variable v-vssrevis-logger                   as handle    no-undo .
       65   procedure vss-logevent :
       66     define input  parameter p-extra-paramters as character no-undo .
       67     define variable v-vssrevis-parameters as character no-undo .
       68     do
       69     on error undo, return error return-value
       70     :
       71       if  valid-handle(v-vssrevis-logger)
       72       and v-vssrevis-logger :get-signature("logevent") <> ""
       73       then do:
       74         run vss-get-parameters in this-procedure
       75           (output v-vssrevis-parameters
       76           ).
       77         run logevent in v-vssrevis-logger
       78           (input vss-workfile
       79           ,input vss-revision
       80           ,input v-vssrevis-parameters
       81           ,input p-extra-paramters
       82           ).
       83       end.
       84     end.
       85   end procedure.
       86   assign
       87     v-vssrevis-logger = g#vssrevis-logger
       88   .
       89   if  valid-handle(v-vssrevis-logger)
       90   and v-vssrevis-logger :get-signature("logevent") <> ""
       91   then do:
       92     assign
       93       v-vssrevis-logevent = true
       94     .
       95     run vss-logevent in this-procedure (input vss-description) .
       96   end.
       97   define new global shared variable g#language as character no-undo .
       98   if g#language <> '' and g#language <> 'rus':U then do:
       99     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      100   end.
      101   procedure proc-alt-shift-f2:
      102     if not ibs.th.gbl.gbl-var:rcode
      103   then
      104     run gbl\inidebug.p .
      105   end.
      106   procedure proc-alt-shift-f3:
      107     run gbl/prvssinf.p
      108       ( input this-procedure
      109       ) .
      110   end.
      111   define variable v-inform-launched as logical no-undo initial false .
      112   procedure proc-alt-shift-f4:
      113     define variable v-action as character no-undo .
      114     if v-inform-launched = false then do:
      115       assign
      116         v-inform-launched = true
      117       .
      118       run gbl/d-inform.w
      119         (  input self
      120         ,  input this-procedure
      121         , output v-action
      122         ) no-error .
      123       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      124       assign
      125         v-inform-launched = false
      126       .
      127     end.
      128   end.
      129   procedure proc-alt-f1:
      130     run gbl/corrhelp.p
      131       (input this-procedure
      132       ) .
      133   end .
      134   on alt-shift-f2 anywhere do:
      135     run proc-alt-shift-f2.
      136   end.
      137   on alt-shift-f3 anywhere do:
      138     run proc-alt-shift-f3 in this-procedure .
      139   end.
      140   on alt-shift-f4 anywhere do:
      141     run proc-alt-shift-f4 in this-procedure.
      142   end.
      143   on alt-f1 anywhere do:
      144     run proc-alt-f1 in this-procedure .
      145   end.
      146   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      147   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      148   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      149   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      150   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      151   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      152   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      153   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      154   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      155   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      156   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      157   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      158   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      159   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      160   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      161   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      162   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      163   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      164   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      165   procedure gen-b-code :
      166     define input  parameter type-code like ub.code-range.range-type no-undo .
      167     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      168     do
      169     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      170     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      171     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      172     :
      173       define buffer buf_thbj-attr     for ub.thbj-attr .
      174       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      175       define buffer buf_code-range for ub.code-range .
      176       define variable l-code         as   integer              no-undo .
      177       define variable v-db-num       like ub.db.db-num         no-undo .
      178       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      179       if type-code = 'sslc':U
      180       or type-code = 'ssgb':U
      181       then do:
      182         message
      183           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      184           "Обратитесь к администратору системы."
      185           view-as alert-box error .
      186         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      187       end.
      188       run trg/getpcode.p ( input  type-code
      189                      ,output cfg-param-code
      190                     ).
      191       run get-next-seq( input  type-code,
      192                         output l-code
      193                       ).
      194       find first buf_sys-ctrl no-lock.
      195       if type-code = 'sclc':U
      196       or type-code = 'pglc':U
      197       then do:
      198         assign
      199           v-db-num = 0
      200         .
      201       end.
      202       else do:
      203         assign
      204           v-db-num = buf_sys-ctrl.db-num
      205         .
      206       end.
      207       find first buf_code-range no-lock
      208         where buf_code-range.db-num     = v-db-num
      209           and buf_code-range.range-type = type-code
      210           and buf_code-range.stts       = "a"
      211         use-index stts
      212         no-error .
      213       if available buf_code-range
      214          and l-code <= buf_code-range.last-code
      215          and l-code >= buf_code-range.first-code then do:
      216         assign
      217           p-b-code = l-code
      218         .
      219       end.
      220       else do:
      221         if available buf_code-range
      222            and l-code < buf_code-range.last-code then do:
      223           message
      224             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      225             "Обратитесь к администратору системы."
      226             view-as alert-box error .
      227           undo, return error "sequence":U .
      228         end.
      229         do transaction
      230         on error undo, return error
      231         :
      232           find first buf_thbj-attr exclusive-lock
      233             where buf_thbj-attr.upper-prop-code = 'code-range':U
      234               and buf_thbj-attr.prop-code = cfg-param-code
      235               and buf_thbj-attr.obj-type   = 'БД':U
      236               and buf_thbj-attr.obj-code   = v-db-num
      237             no-error .
      238           if not available buf_thbj-attr then do:
      239             find first buf_thbj-attr exclusive-lock
      240               where buf_thbj-attr.upper-prop-code = 'code-range':U
      241                 and buf_thbj-attr.prop-code = cfg-param-code
      242                 and buf_thbj-attr.obj-type   = ''
      243                 and buf_thbj-attr.obj-code   = 0
      244               no-error .
      245             if not available buf_thbj-attr then do:
      246               if not locked buf_thbj-attr then do:
      247                 message
      248                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      249                   "Обратитесь к администратору системы."
      250                   view-as alert-box error .
      251               end.
      252               undo, return error "config":U .
      253             end.
      254           end.
      255           run get-next-seq( input type-code,
      256                             output l-code
      257                           ).
      258           find first buf_code-range
      259             where buf_code-range.db-num     = v-db-num
      260               and buf_code-range.range-type = type-code
      261               and buf_code-range.stts       = "a"
      262             use-index stts
      263             no-error .
      264           if available buf_code-range
      265           and l-code <= buf_code-range.last-code
      266           and l-code >= buf_code-range.first-code
      267           then do:
      268             assign
      269               p-b-code = l-code
      270             .
      271           end.
      272           else do:
      273             if available buf_code-range then do:
      274               assign
      275                 buf_code-range.stts = "u"
      276               .
      277             end.
      278             find first buf_code-range
      279               where buf_code-range.db-num     = v-db-num
      280                 and buf_code-range.range-type = type-code
      281                 and buf_code-range.stts       = "f"
      282               use-index stts
      283               no-error .
      284             if not available buf_code-range then do:
      285               message
      286                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      287                 "Обратитесь к администратору системы"
      288                 view-as alert-box error .
      289               undo, return error "code-range":U .
      290             end.
      291             assign
      292               buf_code-range.stts           = "a"
      293             .
      294             if buf_code-range.first-code = 1 then do:
      295               run set-seq-cr( input type-code,
      296                               input buf_code-range.first-code
      297                             ).
      298               assign
      299                 p-b-code = 1
      300               .
      301             end.
      302             else do:
      303               run set-seq-cr( input type-code,
      304                               input ( buf_code-range.first-code - 1 )
      305                             ).
      306               run get-next-seq( input type-code,
      307                                 output p-b-code
      308                               ).
      309             end.
      310           end.
      311         end.
      312       end.
      313     end.
      314   end procedure.
      315   procedure get-next-seq :
      316     define input  parameter type-code like ub.code-range.range-type no-undo .
      317     define output parameter next-seq  as   integer                  no-undo .
      318     do
      319     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      320     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      321     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      322     :
      323       case type-code:
      324         when 'bcgb':U then do:
      325           assign
      326             next-seq = next-value(s-bcgb-code, ub)
      327           .
      328         end.
      329         when 'scgb':U then do:
      330           assign
      331             next-seq = next-value(s-scgb-code, ub)
      332           .
      333         end.
      334         when 'sclc':U then do:
      335           assign
      336             next-seq = next-value(s-sclc-code, ub)
      337           .
      338         end.
      339         when 'pglc':U then do:
      340           assign
      341             next-seq = next-value(s-pglc-code, ub)
      342           .
      343         end.
      344         when 'dcgb':U then do:
      345           assign
      346             next-seq = next-value(s-dcgb-code, ub)
      347           .
      348         end.
      349         when 'ctgb':U then do:
      350           assign
      351             next-seq = next-value(s-ctgb-code, ub)
      352           .
      353         end.
      354         when 'drgb':U then do:
      355           assign
      356             next-seq = next-value(s-drgb-code, ub)
      357           .
      358         end.
      359         when 'fmgb':U then do:
      360           assign
      361             next-seq = next-value(s-fmgb-code, ub)
      362           .
      363         end.
      364         when 'pngb':U then do:
      365           assign
      366             next-seq = next-value(s-pngb-code, ub)
      367           .
      368         end.
      369         when 'cagb':U then do:
      370           assign
      371             next-seq = next-value(s-cagb-code, ub)
      372           .
      373         end.
      374         when 'fdgb':U then do:
      375           assign
      376             next-seq = next-value(s-fin-doc, ub)
      377           .
      378         end.
      379       end case.
      380     end.
      381   end procedure.
      382   procedure set-seq-cr :
      383     define input parameter type-code like ub.code-range.range-type no-undo .
      384     define input parameter set-val   like ub.code-range.first-code no-undo .
      385     do
      386     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      387     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      388     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      389     :
      390       case type-code:
      391         when 'bcgb':U then do:
      392           assign
      393             current-value(s-bcgb-code, ub) = set-val
      394           .
      395         end.
      396         when 'scgb':U then do:
      397           assign
      398             current-value(s-scgb-code, ub) = set-val
      399           .
      400         end.
      401         when 'sclc':U then do:
      402           assign
      403             current-value(s-sclc-code, ub) = set-val
      404           .
      405         end.
      406         when 'pglc':U then do:
      407           assign
      408             current-value(s-pglc-code, ub) = set-val
      409           .
      410         end.
      411         when 'dcgb':U then do:
      412           assign
      413             current-value(s-dcgb-code, ub) = set-val
      414           .
      415         end.
      416         when 'ctgb':U then do:
      417           assign
      418             current-value(s-ctgb-code, ub) = set-val
      419           .
      420         end.
      421         when 'drgb':U then do:
      422           assign
      423             current-value(s-drgb-code, ub) = set-val
      424           .
      425         end.
      426         when 'fmgb':U then do:
      427           assign
      428             current-value(s-fmgb-code, ub) = set-val
      429           .
      430         end.
      431         when 'pngb':U then do:
      432           assign
      433             current-value(s-pngb-code, ub) = set-val
      434           .
      435         end.
      436         when 'cagb':U then do:
      437           assign
      438             current-value(s-cagb-code, ub) = set-val
      439           .
      440         end.
      441         when 'fdgb':U then do:
      442           assign
      443             current-value(s-fin-doc, ub) = set-val
      444           .
      445         end.
      446       end case.
      447     end.
      448   end procedure.
      449   procedure new-bcod-gen-code-range :
      450     do
      451     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      452     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      453     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      454     :
      455       define input parameter p-db-num  like ub.db.db-num             no-undo .
      456       define input parameter type-code like ub.code-range.range-type no-undo .
      457       define buffer buf_code-range      for ub.code-range .
      458       define buffer last_code-range     for ub.code-range .
      459       define buffer last-1_code-range   for ub.code-range .
      460       define buffer last-2_code-range   for ub.code-range .
      461       define buffer last-3_code-range   for ub.code-range .
      462       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      463       define variable conf-par       as character no-undo .
      464       define variable par-type       as character no-undo .
      465       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      466       define variable v-cre-cdrg as logical   no-undo .
      467       define variable v-cre-str  as character no-undo .
      468       define variable v-cr1      as integer no-undo .
      469       define variable v-cr2      as integer no-undo .
      470       define variable v-cr3      as integer no-undo .
      471       define variable v-cmax     as integer no-undo .
      472       find first buf_sys-ctrl no-lock .
      473       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      474         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      475                                       ,vss-workfile
      476                                       ,vss-revision
      477                                       ,vss-description
      478                                       ,chr(10)
      479                                       , p-db-num
      480                                      ).
      481       end.
      482       run trg/getpcode.p ( input  type-code
      483                      ,output cfg-param-code
      484                     ).
      485       for each buf_code-range
      486         where buf_code-range.db-num     = -1
      487           and buf_code-range.range-type = type-code
      488           and buf_code-range.stts       = "f"
      489       by buf_code-range.first-code
      490       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      491       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      492       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      493       :
      494         assign
      495           buf_code-range.db-num = p-db-num
      496         .
      497         return .
      498       end.
      499       assign
      500         v-cre-cdrg = TRUE
      501       .
      502       case type-code:
      503         when 'sclc':U
      504         or when 'scgb':U
      505         or when 'pglc':U
      506         then do:
      507           find last last-1_code-range no-lock
      508             where last-1_code-range.range-type = 'sclc':U
      509             no-error .
      510           if available last-1_code-range then do:
      511             v-cr1 = last-1_code-range.last-code.
      512           end.
      513           find last last-2_code-range no-lock
      514             where last-2_code-range.range-type = 'scgb':U
      515             no-error .
      516           if available last-2_code-range then do:
      517             v-cr2 = last-2_code-range.last-code.
      518             end.
      519           find last last-3_code-range no-lock
      520             where last-3_code-range.range-type = 'pglc':U
      521             no-error .
      522           if available last-3_code-range then do:
      523             v-cr3 = last-3_code-range.last-code.
      524           end.
      525           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      526           .
      527           if v-cmax = v-cr1  then do:
      528               find last last_code-range no-lock
      529                 where recid( last_code-range ) = recid( last-1_code-range )
      530                 .
      531             end.
      532           if v-cmax = v-cr2  then do:
      533               find last last_code-range no-lock
      534                 where recid( last_code-range ) = recid( last-2_code-range )
      535                 .
      536             end.
      537           if v-cmax = v-cr3  then do:
      538             find last last_code-range no-lock
      539               where recid( last_code-range ) = recid( last-3_code-range )
      540               .
      541           end.
      542           if last_code-range.last-code + 1 > 99999 then do:
      543             assign
      544               v-cre-cdrg = FALSE
      545             .
      546           end.
      547         end.
      548         when 'bcgb':U
      549         or when 'sslc':U
      550         or when 'ssgb':U
      551         then do:
      552           find last last-1_code-range no-lock
      553             where last-1_code-range.range-type = 'sslc':U
      554             no-error .
      555           if available last-1_code-range then do:
      556             v-cr1 = last-1_code-range.last-code.
      557           end.
      558           find last last-2_code-range no-lock
      559             where last-2_code-range.range-type = 'bcgb':U
      560             no-error .
      561           if available last-2_code-range then do:
      562             v-cr2 = last-2_code-range.last-code.
      563             end.
      564           find last last-3_code-range no-lock
      565             where last-3_code-range.range-type = 'ssgb':U
      566             no-error .
      567           if available last-3_code-range then do:
      568             v-cr3 = last-3_code-range.last-code.
      569           end.
      570           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      571           .
      572           if v-cmax = v-cr1  then do:
      573               find last last_code-range no-lock
      574                 where recid( last_code-range ) = recid( last-1_code-range )
      575                 .
      576             end.
      577           if v-cmax = v-cr2  then do:
      578               find last last_code-range no-lock
      579                 where recid( last_code-range ) = recid( last-2_code-range )
      580                 .
      581             end.
      582           if v-cmax = v-cr3  then do:
      583             find last last_code-range no-lock
      584               where recid( last_code-range ) = recid( last-3_code-range )
      585               .
      586           end.
      587         end.
      588         otherwise do:
      589           find last last_code-range no-lock
      590             where last_code-range.range-type = type-code
      591             no-error .
      592         end.
      593       end case.
      594       if not available last_code-range then do:
      595         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      596                                       ,vss-workfile
      597                                       ,vss-revision
      598                                       ,vss-description
      599                                       , chr(10)
      600                                       , type-code
      601                                      ) .
      602       end.
      603       define variable v-mes1 as character no-undo .
      604       define variable v-param-type1 as character no-undo .
      605       define variable v-value-character1 as INTEGER no-undo .
      606       define variable v-value-date1 as date no-undo .
      607       define variable v-value-decimal1 as decimal no-undo .
      608       define variable v-value-integer1 AS integer no-undo .
      609       define variable v-value-logical1 AS LOGICAL no-undo .
      610       define variable v-tth1 as handle no-undo .
      611       run adm/shattri.p (
      612           input "get":U
      613           ,input  'БД':U
      614           ,input  p-db-num
      615           ,input  'code-range':U
      616           ,input  cfg-param-code
      617           ,output v-value-character1
      618           ,output v-value-date1
      619           ,output v-value-decimal1
      620           ,output v-value-integer1
      621           ,output v-value-logical1
      622           ,output v-param-type1
      623           ,INPUT-OUTPUT table-handle v-tth1
      624           ) no-error .
      625       if error-status :error then do:
      626         delete object v-tth1.
      627         v-mes1 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      628                            , error-status:get-message(1)
      629                            , chr(10)
      630                            , return-value ).
      631         undo, return error v-mes1.
      632       end.
      633       delete object v-tth1.
      634       if v-cre-cdrg = TRUE then do:
      635         create buf_code-range .
      636         assign
      637           buf_code-range.db-num     = p-db-num
      638           buf_code-range.range-type = type-code
      639           buf_code-range.stts       = "f"
      640           buf_code-range.first-code = last_code-range.last-code + 1
      641           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer1)
      642           v-cre-str = "Свободный диапазон успешно создан"
      643         .
      644       end.
      645       else do:
      646         assign
      647           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      648                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      649         .
      650       end.
      651     end.
      652     return v-cre-str .
      653   end procedure.
      654   procedure gen-new-code-range-if-neces :
      655     define input parameter v-db-num           like ub.db.db-num             no-undo .
      656     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      657     define input parameter v-cur-code         as   integer                  no-undo .
      658     define input parameter v-g#news           as   logical                  no-undo .
      659     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      660     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      661     do
      662     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      663     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      664     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      665     :
      666       define variable l-code-range-exist as logical   no-undo init false .
      667       define variable v-db-for-send      as character no-undo .
      668       define buffer buf_code-range  for ub.code-range .
      669       define buffer buf1_code-range for ub.code-range .
      670       define buffer buf_db          for ub.db .
      671       find first buf_code-range
      672         where buf_code-range.range-type = v-range-type
      673           and buf_code-range.last-code >= v-cur-code
      674         use-index last-codei
      675         no-error .
      676       if
      677       (
      678          available buf_code-range
      679          and
      680         (buf_code-range.db-num = v-db-num
      681           and
      682         buf_code-range.first-code <= v-cur-code
      683         )
      684       or
      685         (
      686           v-range-type = 'drgb':U
      687           AND
      688           v-cur-code = 0
      689         )
      690      )
      691      then do:
      692         assign
      693           l-code-range-exist = true
      694         .
      695         if v-g#news
      696         and buf_code-range.stts = "f" then do:
      697           assign
      698             buf_code-range.stts = "u"
      699           .
      700         end.
      701       end.
      702       if not l-code-range-exist
      703          and v-g#news-source-db <> 0
      704       then do:
      705         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      706                                       ,vss-workfile
      707                                       ,vss-revision
      708                                       ,vss-description
      709                                       ,chr(10)
      710                                       ,v-db-num
      711                                       ,v-range-type
      712                                       ,v-cur-code
      713                                      ).
      714       end.
      715       if (not l-code-range-exist
      716           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      717          )
      718       and ( not can-find (first buf1_code-range no-lock
      719                           where buf1_code-range.db-num = v-db-num
      720                             and buf1_code-range.range-type = v-range-type
      721                             and buf1_code-range.stts = "f"
      722                          )
      723           )
      724       then do:
      725         if v-g#db-num = 0 then do:
      726           run new-bcod-gen-code-range in this-procedure
      727             (input v-db-num,
      728              input v-range-type
      729             ) no-error .
      730           if error-status :error then do:
      731             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      732                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      733                                           ,v-db-num
      734                                           ,v-range-type
      735                                           ,v-cur-code
      736                                           ,chr(10)
      737                                           ,error-status:get-message(1)
      738                                           ,return-value
      739                                          ).
      740           end.
      741         end.
      742         else do:
      743           if v-range-type = 'sclc':U
      744           or v-range-type = 'pglc':U
      745           then do:
      746             assign
      747               v-db-for-send = "":U
      748             .
      749             if v-g#db-num = 0 then do:
      750               for each buf_db no-lock
      751                 where buf_db.db-num > 0
      752                   and buf_db.db-num <> v-g#news-source-db
      753               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      754               :
      755                 assign
      756                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      757                 .
      758               end.
      759               assign
      760                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      761               .
      762             end.
      763             else do:
      764               if not v-g#news then do:
      765                 assign
      766                   v-db-for-send = "0":U
      767                 .
      768               end.
      769             end.
      770             run nws/cr-route.p ( input 'send-cmd':U
      771                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      772                                  "code-range":U + chr(1) +
      773                                  (if v-range-type = 'sclc':U
      774                                   then string( current-value(s-sclc-code, ub))
      775                                   else string( current-value(s-pglc-code, ub))
      776                                   ) + chr(1) +
      777                                   v-range-type)
      778                           ,input ?
      779                           ,input v-db-for-send
      780                           ) no-error .
      781             if error-status :error then do:
      782               undo, return error return-value.
      783             end.
      784           end.
      785         end.
      786       end.
      787     end.
      788   end procedure.
      789   procedure cre-loc-sc-code-range :
      790     define input parameter v-cur-code as integer no-undo .
      791   define input parameter p-cdrg-type as character no-undo .
      792     do
      793     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      794     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      795     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      796     :
      797       define buffer buf_code-range for ub.code-range .
      798       find first buf_code-range
      799            where buf_code-range.range-type = p-cdrg-type
      800              and buf_code-range.first-code >= v-cur-code
      801            no-error .
      802       if not available buf_code-range then do:
      803         run new-bcod-gen-code-range in this-procedure
      804           ( input 0,
      805             input p-cdrg-type
      806           ) no-error .
      807         if error-status :error then do:
      808           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      809                                          + "Код &2&1&3 &4"
      810                                         , chr(10)
      811                                         , v-cur-code
      812                                         , error-status:get-message(1)
      813                                         , return-value
      814                                        ) .
      815         end.
      816       end.
      817     end.
      818   end procedure.
      819   procedure mark-used-if-need :
      820   define input parameter p-cur-code as integer no-undo .
      821   define input parameter p-range-type like ub.code-range.range-type no-undo .
      822   define input parameter p-db-num like ub.code-range.db-num no-undo .
      823     do
      824     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      825     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      826     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      827     :
      828       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      829       define buffer buf_code-range for ub.code-range .
      830       assign
      831       v-db-num = if p-range-type = 'sclc':U
      832                  then 0
      833                  else p-db-num
      834       .
      835   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      836   define buffer locK-batchprocess2 for ub.batchprocess.
      837   run gbl/lock-prc.p
      838       (input 'lscc':U
      839       ,input 0
      840       ,input 0
      841       ,input 0
      842       ,input ""
      843       ,input ""
      844       ,input ""
      845       ,input (
      846               ",,,Вкл/выкл лок. вес. кодов"
      847              )
      848       ,input true
      849       ,buffer lock-batchprocess2
      850       ) no-error .
      851     if error-status :error then do:
      852       message
      853         vss-workfile vss-revision vss-description skip
      854         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      855         view-as alert-box error .
      856       undo, return error .
      857     end.
      858       find first buf_code-range
      859            where buf_code-range.range-type = p-range-type
      860              and buf_code-range.first-code >= p-cur-code
      861              and buf_code-range.last-code <= p-cur-code
      862              and buf_code-range.db-num = v-db-num
      863            no-error .
      864       if not available buf_code-range then do:
      865         message
      866           vss-workfile vss-revision vss-description skip
      867           "Ошибка при создании поиске диапазона" skip
      868           "База данных" p-db-num skip
      869           "Код" p-cur-code skip
      870           "Тип" p-range-type
      871           error-status :get-message(1) skip
      872           return-value skip
      873           view-as alert-box error .
      874         undo, return error .
      875       end.
      876       if buf_code-range.stts = "f":U then do:
      877         assign
      878         buf_code-range.stts = "u":U
      879         .
      880       end.
      881     end.
      882   end procedure.
      883   define new global shared variable g#library  as handle no-undo .
      884   define new global shared variable g#library2 as handle no-undo .
      885   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      886   define new global shared variable g#attr-lib  as handle no-undo .
      887   define variable v-attr-lib-variable as handle no-undo .
      888   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      889   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      890   procedure thbjattr_code :
      891      define input  parameter p-upper-code     as character no-undo .
      892      define input  parameter p-code           as character no-undo .
      893      define output parameter p-label          as character no-undo .
      894      define output parameter p-user-can-edit  as logical   no-undo .
      895      define output parameter p-output-display as logical   no-undo .
      896      define output parameter p-other          as character no-undo .
      897      define output parameter p-prop-list      as character no-undo .
      898      define output parameter p-prop-type-list as character no-undo .
      899      define output parameter p-prop-label-list as character no-undo .
      900      define output parameter p-global          as logical no-undo .
      901      define output parameter p-host           as logical no-undo .
      902      define output parameter p-shop           as logical no-undo .
      903      define output parameter p-store          as logical no-undo .
      904      define output parameter p-db             as logical no-undo .
      905      define variable p-region as logical no-undo.
      906      run thbjattr_code_reg in this-procedure (
      907                                               p-upper-code,
      908                                               p-code,
      909                                               output p-label,
      910                                               output p-user-can-edit,
      911                                               output p-output-display,
      912                                               output p-other,
      913                                               output p-prop-list,
      914                                               output p-prop-type-list,
      915                                               output p-prop-label-list,
      916                                               output p-global,
      917                                               output p-host,
      918                                               output p-shop,
      919                                               output p-store,
      920                                               output p-db,
      921                                               output p-region
      922                                               ).
      923   end procedure.
      924   procedure thbjattr_code_reg :
      925   define input  parameter p-upper-code     as character no-undo .
      926   define input  parameter p-code           as character no-undo .
      927   define output parameter p-label          as character no-undo .
      928   define output parameter p-user-can-edit  as logical   no-undo .
      929   define output parameter p-output-display as logical   no-undo .
      930   define output parameter p-other          as character no-undo .
      931   define output parameter p-prop-list      as character no-undo .
      932   define output parameter p-prop-type-list as character no-undo .
      933   define output parameter p-prop-label-list as character no-undo .
      934   define output parameter p-global          as logical no-undo .
      935   define output parameter p-host           as logical no-undo .
      936   define output parameter p-shop           as logical no-undo .
      937   define output parameter p-store          as logical no-undo .
      938   define output parameter p-db             as logical no-undo .
      939   define output parameter p-region         as logical no-undo .
      940   do
      941   on error undo, return error return-value
      942   :
      943       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      944       (input  p-upper-code
      945       ,input  p-code
      946       ,output p-label
      947       ,output p-user-can-edit
      948       ,output p-output-display
      949       ,output p-other
      950       ,output p-prop-list
      951       ,output p-prop-type-list
      952       ,output p-prop-label-list
      953       ,output p-global
      954       ,output p-host
      955       ,output p-shop
      956       ,output p-store
      957       ,output p-db
      958       ,output p-region
      959       ) no-error .
      960     if error-status :error
      961     then do:
      962       undo, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1)).
      963     end.
      964   end.
      965   end procedure.
      966   procedure thbjattr_tooltip :
      967   define input  parameter p-upper-code  as character no-undo .
      968   define input  parameter p-code      as character no-undo .
      969   define output parameter p-tooltip   as character no-undo .
      970   define output parameter p-label     as character no-undo .
      971   define output parameter p-tooltip-code as character no-undo .
