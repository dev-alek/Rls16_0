      973   on error undo, return error return-value
      974   :
      975       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_tooltip in g#attr-lib
      976       (input  p-upper-code
      977       ,input  p-code
      978       ,output p-tooltip
      979       ,output p-label
      980       ,output p-tooltip-code
      981       ) no-error .
