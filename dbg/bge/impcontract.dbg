      988   procedure thbjattr_legacy :
      989   define input  parameter p-upper-code     as character no-undo .
      990   define output parameter p-level-way      as character no-undo .
      991   define output parameter p-up-way         as character no-undo .
      992   do
      993   on error undo, return error return-value
      994   :
      995       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_legacy in g#attr-lib
      996       (input  p-upper-code
      997       ,output p-level-way
      998       ,output p-up-way
      999       ) no-error .
     1000     if error-status :error
     1001     then do:
     1002       undo, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1)).
     1003     end.
     1004   end.
     1005   end procedure.
     1006   procedure thbjattr_value :
     1007   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
     1008   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
     1009   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
     1010   define input  parameter p-code     like ub.thbj-attr.prop-code  no-undo .
     1011   define output parameter p-value-character like ub.thbj-attr.property-value-character no-undo .
     1012   define output parameter p-value-date    like ub.thbj-attr.property-value-date no-undo .
     1013   define output parameter p-value-decimal like ub.thbj-attr.property-value-decimal no-undo .
     1014   define output parameter p-value-integer like ub.thbj-attr.property-value-integer no-undo .
     1015   define output parameter p-value-logical like ub.thbj-attr.property-value-logical no-undo .
     1016   define output parameter p-type     as character no-undo .
     1017   define output parameter p-found as decimal no-undo .
     1018   do
     1019   on error undo, return error return-value
     1020   :
     1021       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_value in g#attr-lib
     1022       (input  p-obj-type
     1023       ,input  p-obj-code
     1024       ,input  p-upper-code
     1025       ,input  p-code
     1026       ,output p-value-character
     1027       ,output p-value-date
     1028       ,output p-value-decimal
     1029       ,output p-value-integer
     1030       ,output p-value-logical
     1031       ,output p-type
     1032       ,output p-found
     1033       ) no-error .
     1034     if error-status :error
     1035     then do:
     1036       undo, return error return-value .
     1037     end.
     1038   end.
