      194   procedure schedule-attr-name :
      195   do
      196     on error undo, return error
      197     :
      198     define input  parameter p-code           as character no-undo .
      199     define output parameter p-type           as character no-undo .
      200     define output parameter p-format         as character no-undo .
      201     define output parameter p-label          as character no-undo .
      202     define output parameter p-user-can-edit  as logical   no-undo .
      203     define output parameter p-output-display as logical   no-undo .
      204     define output parameter p-other          as character no-undo .
      205       if index(p-code, chr(4)) > 0 then do:
      206         p-code = entry(1, p-code, chr(4)).
      207       end.
      208       case p-code :
      209               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      210               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      211               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      212               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      213               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      214               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      215               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      216               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      217               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      218         otherwise do:
      219           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      220         end.
      221       end.
      222     end.
      223   end procedure.
      224   procedure schedule-attr-tooltip :
      225   do
      226     on error undo, return error
      227     :
      228       define input  parameter p-code    as character no-undo .
      229       define output parameter p-tooltip as character no-undo .
      230       define output parameter p-label   as character no-undo .
      231       if index(p-code, chr(4)) > 0 then do:
      232         p-code = entry(1, p-code, chr(4)).
      233       end.
      234       case p-code :
      235               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      236               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      237               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      238               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      239               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      240               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      241               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      242               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      243               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      244         otherwise do:
      245               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      246         end.
      247       end.
      248     end.
      249   end procedure.
      250   procedure schedule-attr-value :
      251   do
      252   on error undo, return error return-value
      253   :
      254   define input parameter  p-cre-db-num as integer    no-undo.
      255   define input parameter  p-task-type  as character  no-undo.
      256   define input parameter  p-task-num   as integer    no-undo.
      257   define input parameter  p-code       as character  no-undo.
      258   define output parameter p-value      as character  no-undo.
      259   define output parameter p-type       as character  no-undo.
      260       define variable v-format         as character no-undo .
      261       define variable v-label          as character no-undo .
      262       define variable v-user-can-edit  as logical   no-undo .
      263       define variable v-output-display as logical   no-undo .
      264       define variable v-other          as character no-undo .
      265       define buffer buf_schedule-attr for ub.schedule-attr.
      266       run schedule-attr-name in this-procedure (
      267             input  p-code
      268           , output p-type
      269           , output v-format
      270           , output v-label
      271           , output v-user-can-edit
      272           , output v-output-display
      273           , output v-other
      274       ) no-error .
      275       if error-status :error
      276       then do:
      277           undo, return error return-value .
      278       end.
      279       if p-code begins ('schd-free-id':U + chr(4))
      280       and entry(2, p-code, chr(4)) = '':U then do:
      281         find first buf_schedule-attr no-lock
      282             where buf_schedule-attr.cre-db-num = p-cre-db-num
      283               and buf_schedule-attr.task-type  = p-task-type
      284               and buf_schedule-attr.task-num   = p-task-num
      285               and buf_schedule-attr.attr-code  begins p-code
      286         no-error .
      287       end.
      288       else do:
      289         find first buf_schedule-attr no-lock
      290             where buf_schedule-attr.cre-db-num = p-cre-db-num
      291               and buf_schedule-attr.task-type  = p-task-type
      292               and buf_schedule-attr.task-num   = p-task-num
      293               and buf_schedule-attr.attr-code  = p-code
      294         no-error .
      295       end.
      296       if available buf_schedule-attr
      297       then do:
      298           assign
      299               p-value = buf_schedule-attr.attr-value
      300           .
      301       end.
      302       else do:
      303         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      304            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      305         end.
      306         else do:
      307           assign
      308               p-value = if p-type = 'L':U then "no":U else ""
      309           .
      310         end.
      311       end.
      312   end.
      313   end procedure.
      314   procedure schedule-attr-write :
      315   do
      316   on error undo, return error
      317   :
      318   define input parameter p-cre-db-num  as integer   no-undo.
      319   define input parameter p-task-type   as character no-undo.
      320   define input parameter p-task-num    as integer   no-undo.
      321   define input parameter p-code        as character no-undo.
      322   define input parameter p-value       as character no-undo.
      323       define variable v-type              as character                no-undo.
      324       define variable v-format            as character                no-undo.
      325       define variable v-label             as character                no-undo.
      326       define variable v-user-can-edit     as logical                  no-undo.
      327       define variable v-output-display    as logical                  no-undo.
      328       define variable v-other             as character                no-undo.
      329       define buffer buf_schedule-attr for ub.schedule-attr .
      330       run schedule-attr-name in this-procedure (
      331             input  p-code
      332           , output v-type
      333           , output v-format
      334           , output v-label
      335           , output v-user-can-edit
      336           , output v-output-display
      337           , output v-other
      338       ) no-error.
      339       if error-status :error
      340       then do:
      341           undo, return error return-value.
      342       end.
      343       find first buf_schedule-attr exclusive-lock
      344            where buf_schedule-attr.cre-db-num = p-cre-db-num
      345              and buf_schedule-attr.task-type  = p-task-type
      346              and buf_schedule-attr.task-num   = p-task-num
      347              and buf_schedule-attr.attr-code  = p-code
      348       no-error.
      349       if not available buf_schedule-attr
      350       then do:
      351           create buf_schedule-attr.
      352           assign
      353             buf_schedule-attr.cre-db-num = p-cre-db-num
      354             buf_schedule-attr.task-type  = p-task-type
      355             buf_schedule-attr.task-num   = p-task-num
      356             buf_schedule-attr.attr-code  = p-code
      357             buf_schedule-attr.attr-value = p-value
      358           .
      359       end.
      360       else do:
      361           assign
      362               buf_schedule-attr.attr-value = p-value
      363           .
      364       end.
      365   end.
      366   end procedure.
      367   procedure schedule-attr-delete :
      368   do
      369   on error undo, return error
      370   :
      371   define input  parameter p-cre-db-num  as integer   no-undo.
      372   define input  parameter p-task-type   as character no-undo.
      373   define input  parameter p-task-num    as integer   no-undo.
      374   define input  parameter p-code        as character no-undo.
      375   define output parameter p-deleted     as logical   no-undo.
      376       define buffer buf_schedule-attr for ub.schedule-attr .
      377       define variable v-type              as character                no-undo.
      378       define variable v-format            as character                no-undo.
      379       define variable v-label             as character                no-undo.
      380       define variable v-user-can-edit     as logical                  no-undo.
      381       define variable v-output-display    as logical                  no-undo.
      382       define variable v-other             as character                no-undo.
      383       run schedule-attr-name in this-procedure (
      384             input p-code
      385           , output v-type
      386           , output v-format
      387           , output v-label
      388           , output v-user-can-edit
      389           , output v-output-display
      390           , output v-other
      391       ) no-error .
      392       if error-status :error
      393       then do:
      394           undo, return error return-value .
      395       end.
      396       find first buf_schedule-attr exclusive-lock
      397            where buf_schedule-attr.cre-db-num = p-cre-db-num
      398              and buf_schedule-attr.task-type  = p-task-type
      399              and buf_schedule-attr.task-num   = p-task-num
      400              and buf_schedule-attr.attr-code  = p-code
      401       no-error.
      402       if not available buf_schedule-attr
      403       then do:
      404           assign
      405               p-deleted = no
      406           .
      407       end.
      408       else do:
      409           delete buf_schedule-attr.
      410           assign
      411               p-deleted = yes
      412           .
      413       end.
      414   end.
      415   end procedure.
      416   procedure schedule-attr-news :
      417   do
      418   on error undo, return error
      419   :
      420       define input  parameter p-code           as character no-undo .
      421       define output parameter p-news           as logical   no-undo .
      422       if index(p-code, chr(4)) > 0 then do:
      423         p-code = entry(1, p-code, chr(4)).
      424       end.
      425       case p-code :
      426               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      427               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      428               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      429               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      430               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      431               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      432               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      433               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      434               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      435         otherwise do:
      436           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      437         end.
      438       end.
      439   end.
      440   end procedure.
      441   procedure schedule-attr-extract-logical :
      442   do
      443   on error undo, return error
      444   :
      445   define input  parameter p-parameter-number   as integer      no-undo.
      446   define input  parameter p-parameter-list     as character    no-undo.
      447   define output parameter p-parameter-value   as logical      no-undo.
      448       if num-entries( p-parameter-list ) > p-parameter-number - 1
      449       then do:
      450           assign
      451               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      452           .
      453       end.
      454       else do:
      455           assign
      456               p-parameter-value   = no
      457           .
      458       end.
      459   end.
      460   end procedure.
      461   procedure schedule-attr-get-free-id :
      462   do
      463   on error undo, return error return-value
      464   :
      465     define input  parameter p-cre-db-num  as integer   no-undo.
      466     define input  parameter p-task-type   as character no-undo.
      467     define input  parameter p-task-num    as integer   no-undo.
      468     define output parameter p-free-id     as character no-undo.
      469     define buffer buf_schedule-attr for ub.schedule-attr.
      470     find first buf_schedule-attr no-lock
      471         where buf_schedule-attr.cre-db-num = p-cre-db-num
      472           and buf_schedule-attr.task-type  = p-task-type
      473           and buf_schedule-attr.task-num   = p-task-num
      474           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      475     no-error .
      476     if available buf_schedule-attr then
      477     assign
      478     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      479     no-error
      480     .
      481   end.
      482   end procedure.
      483   procedure schedule-attr-get-free-props :
      484     define input parameter p-free-id as character no-undo .
      485     define output parameter p-value as character no-undo .
      486     define buffer buf_temp-schedule-free for temp-schedule-free.
      487     do
      488     on error undo, return error return-value
      489     :
      490       find first buf_temp-schedule-free no-lock no-error .
      491       if not available buf_temp-schedule-free then do:
      492         run schedule-attr-fill-free-props in this-procedure .
      493       end.
      494       find first buf_temp-schedule-free where
      495               buf_temp-schedule-free.free-id = p-free-id no-error.
      496       if available buf_temp-schedule-free then do:
      497         assign
      498         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      499                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      500                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      501                   buf_temp-schedule-free.conf-param           + chr(4) +
      502                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      503                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      504                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      505                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      506                   buf_temp-schedule-free.other-info
      507         .
      508       end.
      509       else do:
      510        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      511                              "id произвольной задачи - &5"
      512                              ,vss-workfile
      513                              ,vss-revision
      514                              ,vss-description
      515                              ,chr(10)
      516                              ,p-free-id).
      517       end.
      518     end.
      519   end procedure.
      520   procedure schedule-attr-is-rum-free-id :
      521   define input parameter p-free-id as character no-undo .
      522   define output parameter p-is-rum as logical no-undo .
      523   define buffer buf_temp-schedule-free for temp-schedule-free.
      524   do
      525   on error undo, return error
      526   :
      527       find first buf_temp-schedule-free no-lock no-error .
      528       if not available buf_temp-schedule-free then do:
      529         run schedule-attr-fill-free-props in this-procedure .
      530       end.
      531       find first buf_temp-schedule-free where
      532               buf_temp-schedule-free.free-id = p-free-id no-error.
      533       if available buf_temp-schedule-free
      534       and buf_temp-schedule-free.is-rum
      535       then do:
      536         p-is-rum = yes.
      537       end.
      538   end.
      539   end procedure.
      540   procedure schedule-attr-fill-free-props :
      541   define variable v-path                    as character                no-undo .
      542   DEFINE VARIABLE v-full-path               as character                no-undo .
      543   DEFINE VARIABLE v-file-name               as character                no-undo .
      544   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      545   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      546   define buffer buf_temp-schedule-free for temp-schedule-free.
      547   define variable v-answer as logical no-undo .
      548     do
      549     on error undo, return error substitute("&1 &2 &3&4&5&4"
      550                                           ,vss-workfile
      551                                           ,vss-revision
      552                                           ,vss-description
      553                                           ,chr(10)
      554                                           ,error-status:get-message(1) )
      555     :
      556       run gbl/filename.p (
      557                       input 'cmp/shd-free.d'
      558                     ,output v-full-path
      559                     ,output v-path
      560                     ,output v-file-name
      561                     ,output v-file-name-no-ext
      562                     ,output v-file-name-ext
      563                     ) .
      564       input from value(v-full-path).
      565       repeat :
      566         create buf_temp-schedule-free.
      567         import buf_temp-schedule-free.
      568       END.
      569       input close.
      570       _ff:
      571       for each buf_temp-schedule-free :
      572         if buf_temp-schedule-free.free-id = '':U then do:
      573            delete buf_temp-schedule-free.
      574            next _ff.
      575          end.
      576          run schedule-attr-check-enc in this-procedure (
      577                                                       input  buf_temp-schedule-free.free-id
      578                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      579                                                               buf_temp-schedule-free.proc-param-edit-name +
      580                                                               buf_temp-schedule-free.conf-param +
      581                                                               string(buf_temp-schedule-free.is-gbd) +
      582                                                               string(buf_temp-schedule-free.is-ubd) +
      583                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      584                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      585                                                               string(buf_temp-schedule-free.other-info)
      586                                                               )
      587                                                       ,input  buf_temp-schedule-free.enc-key
      588                                                       ,output v-answer    ) no-error .
      589          if error-status:error
      590          or not v-answer then delete buf_temp-schedule-free.
      591        end.
      592     end.
      593   end procedure.
      594   Function schedule-attr-reverse returns character (str as character).
      595      define variable rev_incl_s as character init "" no-undo .
      596      define variable rev_incl_i as integer no-undo .
      597      define variable rev_incl_l as integer no-undo .
      598      rev_incl_l = length(str).
      599      do rev_incl_i = 1 to rev_incl_l:
      600         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      601      end.
      602      return rev_incl_s.
      603   end.
      604   procedure schedule-attr-check-enc.
      605     define input  parameter p-free-id   as character no-undo .
      606     define input  parameter p-value     as character no-undo .
      607     define input  parameter p-enc-value as character no-undo .
      608     define output parameter p-answer    as logical   no-undo .
      609     define variable tmp         as character no-undo .
      610     define variable v-enc-value as character no-undo .
      611     assign
      612     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      613     .
      614     run schedule-attr-pswd-enc in this-procedure
      615       ( input tmp
      616        ,output v-enc-value
      617       ) no-error .
      618     if error-status:error then do:
      619       message
      620         vss-workfile vss-revision vss-description skip
      621         "Ошибка при вызове процедуры pswd-enc" skip
      622         return-value skip
      623         error-status :get-message(1) skip
      624         view-as alert-box error .
      625       undo, return error .
      626     end.
      627     if v-enc-value = p-enc-value then do:
      628       assign
      629         p-answer = true
      630       .
      631     end.
      632     else do:
      633       assign
      634         p-answer = false
      635       .
      636     end.
      637   end.
      638   procedure schedule-attr-conf-enc.
      639     define input  parameter p-free-id   as character no-undo .
      640     define input  parameter p-value     as character no-undo .
      641     define output parameter p-enc-value as character no-undo .
      642     define variable tmp         as character no-undo .
      643     assign
      644       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      645     .
      646     run schedule-attr-pswd-enc in this-procedure
      647       ( input tmp
      648        ,output p-enc-value
      649       ) no-error .
      650     if error-status:error then do:
      651       message
      652         vss-workfile vss-revision vss-description skip
      653         "Ошибка при вызове процедуры pswd-enc" skip
      654         return-value skip
      655         error-status :get-message(1) skip
      656         view-as alert-box error .
      657       undo, return error .
      658     end.
      659   end procedure.
      660   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      661   procedure schedule-attr-pswd-enc :
      662     define input parameter  pswd     as character no-undo .
      663     define output parameter enc-pswd as character no-undo .
      664     do
      665     on error undo, return error return-value
      666     :
      667       assign
      668         enc-pswd = encode(pswd + string(index(pswd, "k")))
      669       .
      670     end.
      671   end procedure.
      672   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      673   define input parameter parparentproc as widget-handle no-undo .
      674   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo .
      675   define input parameter p-curr-obj-type  like ub.clients.obj-type no-undo .
      676   define input parameter p-curr-obj-code  like ub.clients.obj-code no-undo .
      677   define input PARAMETER p-mode           AS CHARACTER NO-UNDO.
      678   define input parameter p-db-num-char    as character    no-undo.
      679   define input parameter p-task-type      as character    no-undo.
      680   define input parameter p-task-num       as integer      no-undo.
      681   define input parameter p-action         as character    no-undo.
      682   define output parameter p-cancel        as logical      no-undo.
      683   define output parameter p-params        as character    no-undo.
      684   define variable v-text         as character no-undo .
      685   define variable v-text-oss     as character no-undo .
      686   define variable v-text-gds     as character no-undo .
      687   define variable v-today        as date      no-undo .
      688   define variable v-rid-list     as character no-undo.
      689   define variable v-rid-list-oss as character no-undo.
      690   define variable v-rid-list-gds as character no-undo.
      691   define variable pList as character no-undo .
      692   define variable c-dir          as character no-undo.
      693   DEFINE BUTTON b-dir
      694        IMAGE-UP FILE "btn-down-arrow":U
      695        IMAGE-DOWN FILE "btn-down-arrow":U
      696        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      697        LABEL ""
      698        SIZE 3 BY .88.
      699   DEFINE BUTTON b-exit AUTO-GO
      700        LABEL "&Ввод"
      701        SIZE 10 BY 1
      702        BGCOLOR 8 .
      703   DEFINE BUTTON b-quit AUTO-END-KEY
      704        LABEL "&Отмена"
      705        SIZE 10 BY 1
      706        BGCOLOR 8 .
      707   DEFINE VARIABLE EDITOR-1 AS CHARACTER
      708        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      709        SIZE 40.63 BY 4 NO-UNDO.
      710   DEFINE VARIABLE EDITOR-2 AS CHARACTER INITIAL "Все"
      711        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      712        SIZE 40.63 BY 3.71 NO-UNDO.
      713   DEFINE VARIABLE EDITOR-3 AS CHARACTER INITIAL "Все"
      714        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
      715        SIZE 40.63 BY 3.71 NO-UNDO.
      716   DEFINE VARIABLE num-days AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
      717        LABEL "За последние"
      718        VIEW-AS FILL-IN
      719        SIZE 14 BY 1 NO-UNDO.
      720   DEFINE VARIABLE v-file AS CHARACTER FORMAT "X(25)":U
      721        LABEL "Имя файла"
      722        VIEW-AS FILL-IN
      723        SIZE 30.63 BY 1 NO-UNDO.
      724   DEFINE VARIABLE v-folder AS CHARACTER FORMAT "X(25)":U
      725        LABEL "Путь для выгрузки файла"
      726        VIEW-AS FILL-IN
      727        SIZE 27.5 BY 1 NO-UNDO.
      728   DEFINE VARIABLE RADIO-SET-1 AS INTEGER INITIAL 2
      729        VIEW-AS RADIO-SET VERTICAL
      730        RADIO-BUTTONS
      731             "Текущий", 2,
      732   "Все по фирме", 1,
      733   "Выборочно", 3,
      734   "Все", 4
      735        SIZE 15 BY 3 NO-UNDO.
      736   DEFINE VARIABLE RADIO-SET-2 AS INTEGER INITIAL 1
      737        VIEW-AS RADIO-SET VERTICAL
      738        RADIO-BUTTONS
      739             "Все", 1,
      740   "Выборочно", 2
      741        SIZE 15 BY 1.71 NO-UNDO.
      742   DEFINE VARIABLE RADIO-SET-3 AS INTEGER INITIAL 1
      743        VIEW-AS RADIO-SET VERTICAL
      744        RADIO-BUTTONS
      745             "Все", 1,
      746   "Выборочно", 2
      747        SIZE 15 BY 1.71 NO-UNDO.
      748   DEFINE RECTANGLE RECT-1
      749        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      750        SIZE 60 BY 4.71.
      751   DEFINE RECTANGLE RECT-2
      752        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      753        SIZE 60 BY 4.71.
      754   DEFINE RECTANGLE RECT-3
      755        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      756        SIZE 60 BY 4.71.
      757   DEFINE RECTANGLE RECT-8
      758        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      759        SIZE 60 BY 2.79.
      760   DEFINE FRAME Dialog-Frame
      761        b-exit AT ROW 1 COL 2.63
      762        b-quit AT ROW 1 COL 12.63
      763        num-days AT ROW 2.5 COL 19.5 COLON-ALIGNED WIDGET-ID 22
      764        EDITOR-1 AT ROW 4.5 COL 21.25 NO-LABEL
      765        RADIO-SET-1 AT ROW 5.08 COL 4 NO-LABEL
      766        EDITOR-2 AT ROW 9.75 COL 21.13 NO-LABEL WIDGET-ID 2
      767        RADIO-SET-2 AT ROW 10.04 COL 3.88 NO-LABEL WIDGET-ID 4
      768        EDITOR-3 AT ROW 14.75 COL 21.13 NO-LABEL WIDGET-ID 12
      769        RADIO-SET-3 AT ROW 15.04 COL 3.88 NO-LABEL WIDGET-ID 14
      770        v-folder AT ROW 19.63 COL 29 COLON-ALIGNED
      771        b-dir AT ROW 19.67 COL 58.63 WIDGET-ID 30
      772        v-file AT ROW 20.75 COL 29 COLON-ALIGNED
      773        "дней" VIEW-AS TEXT
      774             SIZE 8 BY 1 AT ROW 2.5 COL 36 WIDGET-ID 32
      775        " Выбор платежных агентов/операторов:" VIEW-AS TEXT
      776             SIZE 37.63 BY .67 AT ROW 9 COL 3.38 WIDGET-ID 26
      777             FGCOLOR 4
      778        " Выгрузка в:" VIEW-AS TEXT
      779             SIZE 13.63 BY .67 AT ROW 18.75 COL 4.88
      780             FGCOLOR 4
      781        " Выбор объектов:" VIEW-AS TEXT
      782             SIZE 17 BY .67 AT ROW 4.04 COL 3.38
      783             FGCOLOR 4
      784        " Выбор товаров платежного агента/оператора:" VIEW-AS TEXT
      785             SIZE 43.63 BY .67 AT ROW 14 COL 3.38 WIDGET-ID 28
      786             FGCOLOR 4
      787        RECT-1 AT ROW 4.29 COL 2.63
      788        RECT-8 AT ROW 19.17 COL 2.5
      789        RECT-2 AT ROW 9.25 COL 2.5 WIDGET-ID 10
      790        RECT-3 AT ROW 14.25 COL 2.5 WIDGET-ID 20
      791        SPACE(1.49) SKIP(3.95)
      792       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      793            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      794            TITLE "Параметры выгрузки банковских продуктов"
      795            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      796   ASSIGN
      797          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      798          FRAME Dialog-Frame:HIDDEN           = TRUE.
      799   ASSIGN
      800          EDITOR-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      801   ASSIGN
      802          EDITOR-2:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      803   ASSIGN
      804          EDITOR-3:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      805   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      806   DO:
      807       APPLY "END-ERROR":U TO SELF.
      808     END.
      809   ON CHOOSE OF b-dir IN FRAME Dialog-Frame
      810   DO:
      811       system-dialog get-dir c-dir.
      812       v-folder:screen-value in frame Dialog-Frame = c-dir.
      813     END.
      814   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      815   DO:
      816       RUN proc-save IN THIS-PROCEDURE .
      817     END.
      818   ON VALUE-CHANGED OF RADIO-SET-1 IN FRAME Dialog-Frame
      819   DO:
      820       ASSIGN
      821         Radio-set-1
      822         .
      823       CASE RADIO-SET-1:
      824         WHEN 1 THEN
      825           DO:
      826             EDITOR-1 = "":U.
      827             EMPTY TEMP-TABLE tt-obj.
      828             FOR EACH ub.clients NO-LOCK
      829               WHERE ub.clients.obj-type = 'маг':U
      830               :
      831               CREATE tt-obj.
      832               ASSIGN
      833                 tt-obj.obj-code  = ub.clients.obj-code
      834                 tt-obj.obj-type  = ub.clients.obj-type
      835                 tt-obj.obj-name  = ub.clients.obj-name
      836                 tt-obj.host-code = ub.clients.host-code
      837                 .
      838               ASSIGN
      839                 v-text = v-text + chr(10) + ub.clients.obj-name
      840                 .
      841             END.
      842             ASSIGN
      843               v-text   = TRIM(v-text, chr(10))
      844               EDITOR-1 = v-text
      845               .
      846           END.
      847         WHEN 2 THEN
      848           DO:
      849             EMPTY TEMP-TABLE tt-obj.
      850             FIND FIRST ub.clients
      851               WHERE ub.clients.obj-type = v-cntxt-obj-type
      852               AND ub.clients.obj-code = v-cntxt-obj-code
      853               NO-LOCK
      854               .
      855             CREATE tt-obj.
      856             ASSIGN
      857               tt-obj.obj-code  = ub.clients.obj-code
      858               tt-obj.obj-type  = ub.clients.obj-type
      859               tt-obj.obj-name  = ub.clients.obj-name
      860               tt-obj.host-code = ub.clients.host-code
      861               .
      862             ASSIGN
      863               EDITOR-1 = ub.clients.obj-name
      864               .
      865           END.
      866         WHEN 3
      867         THEN
      868           DO:
      869             run ref/cli-all.w ( parParentProc
      870               , input "b-sel,b-mark"
      871               , 'маг':U
      872               , ?
      873               , ?
      874               , ?
      875               , ?
      876               , ?
      877               , output  v-rid-list
      878               ) .
      879             IF  v-rid-list <> "":U
      880               AND v-rid-list <> ?
      881               THEN
      882             DO:
      883               EDITOR-1 = "":U.
      884               define variable v-ii1  as integer   no-undo.
      885               define variable v-text as character no-undo.
      886               EMPTY TEMP-TABLE tt-obj.
      887               DO v-ii1 = 1 to num-entries(v-rid-list):
      888                 FIND FIRST ub.clients
      889                   WHERE RECID( ub.clients ) = integer(entry(v-ii1, v-rid-list))
      890                   NO-LOCK
      891                   .
      892                 ASSIGN
      893                   v-text = v-text + chr(10) + ub.clients.obj-name
      894                   .
      895                 CREATE tt-obj.
      896                 ASSIGN
      897                   tt-obj.obj-code  = ub.clients.obj-code
      898                   tt-obj.obj-type  = ub.clients.obj-type
      899                   tt-obj.obj-name  = ub.clients.obj-name
      900                   tt-obj.host-code = ub.clients.host-code
      901                   .
      902               END.
      903               ASSIGN
      904                 v-text   = TRIM(v-text, chr(10))
      905                 EDITOR-1 = v-text
      906                 .
      907             END.
      908           END.
      909         WHEN 4 THEN
      910           DO:
      911             EDITOR-1 = "Все":U.
      912             EMPTY TEMP-TABLE tt-obj.
      913             FOR EACH ub.clients
      914               WHERE ub.clients.obj-type = 'маг':U
      915               NO-LOCK
      916               :
      917               CREATE tt-obj.
      918               ASSIGN
      919                 tt-obj.obj-code  = ub.clients.obj-code
      920                 tt-obj.obj-type  = ub.clients.obj-type
      921                 tt-obj.obj-name  = ub.clients.obj-name
      922                 tt-obj.host-code = ub.clients.host-code
      923                 .
      924               ASSIGN
      925                 v-text = v-text + chr(10) + ub.clients.obj-name
      926                 .
      927             END.
      928           END.
      929         OTHERWISE
      930         DO:
      931         END.
      932       END case.
      933       DISPLAY
      934         EDITOR-1
      935         WITH FRAME Dialog-Frame.
      936     END.
      937   ON VALUE-CHANGED OF RADIO-SET-2 IN FRAME Dialog-Frame
      938   DO:
      939       ASSIGN
      940         Radio-set-2
      941         .
      942       CASE RADIO-SET-2:
      943         WHEN 2
      944         THEN
      945           DO:
      946             run ref/bpa.p(INPUT parparentproc,INPUT 'ВЫБОР':U,OUTPUT pList) no-error.
      947             if pList <> ? or pList <> ""
      948               THEN
      949             DO:
      950               EDITOR-2 = "":U.
      951               define variable v-ii1 as integer no-undo.
      952               EMPTY TEMP-TABLE tt-oss-ref.
      953               v-text-oss = "" .
      954               trim (pList,chr(6)) .
      955               DO v-ii1 = 1 to num-entries (pList,chr(6)):
      956                 FIND FIRST ub.OperServ no-lock
      957                   WHERE ub.OperServ.id = integer(entry(v-ii1,pList,chr(6)))
      958                   no-error
      959                   .
      960                   if available (ub.OperServ) then do:
      961                 ASSIGN
      962                   v-text-oss = v-text-oss + chr(10) + ub.OperServ.ext-code.
      963                 .
      964                 buffer-copy ub.OperServ to tt-oss-ref .
      965                 end.
      966               END.
      967               ASSIGN
      968                 v-text-oss = TRIM(v-text-oss, chr(10))
      969                 EDITOR-2   = v-text-oss
      970                 .
      971             END.
      972             else do:
      973               assign
      974               RADIO-SET-2 = 1 .
      975               DISPLAY RADIO-SET-2 WITH FRAME Dialog-Frame.
      976             end.
      977           END.
      978         WHEN 1 THEN
      979           DO:
      980             EDITOR-2 = "Все":U.
      981             EMPTY TEMP-TABLE tt-oss-ref.
      982             FOR EACH ub.OperServ
      983               NO-LOCK
      984               :
      985              CREATE tt-oss-ref.
      986              buffer-copy ub.OperServ to tt-oss-ref .
      987               ASSIGN
      988                 v-text-oss = v-text-oss + chr(10) + ub.OperServ.ext-code
      989                 .
      990             END.
      991           END.
      992         OTHERWISE
      993         DO:
      994         END.
      995       END case.
      996       DISPLAY
      997         EDITOR-2
      998         WITH FRAME Dialog-Frame.
      999     END.
     1000   ON VALUE-CHANGED OF RADIO-SET-3 IN FRAME Dialog-Frame
     1001   DO:
     1002       ASSIGN
     1003         Radio-set-3
     1004         .
     1005       CASE RADIO-SET-3:
     1006         WHEN 2
     1007         THEN
     1008           DO:
     1009             run str/gds-list.w ( input parparentproc
     1010               , input v-cntxt-host-code-obj
     1011               , input v-cntxt-obj-type
     1012               , input v-cntxt-obj-code).
     1013             if can-find(first gds-list no-lock) then
     1014             do:
     1015               EDITOR-3 = "":U.
     1016               define variable v-ii1 as integer no-undo.
     1017               EMPTY TEMP-TABLE tt-gds-list.
     1018               v-text-gds = "" .
     1019               for each gds-list no-lock, first ub.goods-attr
     1020                 where ub.goods-attr.attr-code  = 'oper-serv-idd':U
     1021                 and ub.goods-attr.gds-code  = gds-list.gds-code
     1022                 NO-LOCK:
     1023                 ASSIGN
     1024                   v-text-gds = v-text-gds + chr(10) + gds-list.gds-name.
     1025                 .
     1026                 CREATE tt-gds-list.
     1027                 ASSIGN
     1028                   tt-gds-list.artic     = gds-list.artic
     1029                   tt-gds-list.gds-code  = gds-list.gds-code
     1030                   tt-gds-list.gds-name  = gds-list.gds-name
     1031                   tt-gds-list.prod-code = gds-list.prod-code
     1032                   tt-gds-list.prod-type = gds-list.prod-type
     1033                   .
     1034               END.
     1035               ASSIGN
     1036                 v-text-gds = TRIM(v-text-gds, chr(10))
     1037                 EDITOR-3   = v-text-gds
     1038                 .
     1039             END.
     1040             else do:
     1041               assign
     1042               RADIO-SET-3 = 1 .
     1043               DISPLAY RADIO-SET-3 WITH FRAME Dialog-Frame.
     1044             end.
     1045           END.
     1046         WHEN 1 THEN
     1047           DO:
     1048             EDITOR-3 = "Все":U.
     1049             EMPTY TEMP-TABLE tt-gds-list.
     1050             FOR EACH ub.goods-attr
     1051               where ub.goods-attr.attr-code  = 'oper-serv-idd':U no-lock,
     1052               each ub.goods where ub.goods-attr.gds-code  = ub.goods.gds-code
     1053               NO-LOCK
     1054               :
     1055               CREATE tt-gds-list.
     1056               ASSIGN
     1057                 tt-gds-list.artic     = ub.goods.artic
     1058                 tt-gds-list.gds-code  = ub.goods.gds-code
     1059                 tt-gds-list.gds-name  = ub.goods.gds-name
     1060                 tt-gds-list.prod-code = ub.goods.prod-code
     1061                 tt-gds-list.prod-type = ub.goods.prod-type
     1062                 .
     1063               ASSIGN
     1064                 v-text-gds = v-text-gds + chr(10) + ub.goods.gds-name
     1065                 .
     1066             END.
     1067           END.
     1068         OTHERWISE
     1069         DO:
     1070         END.
     1071       END case.
     1072       DISPLAY
     1073         EDITOR-3
     1074         WITH FRAME Dialog-Frame.
     1075     END.
     1076   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1077     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1078   MAIN-BLOCK:
     1079   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1080     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1081   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1082     run mainmenu_getcntxt in parparentproc
     1083       (output v-cntxt-db-num
     1084       ,output v-cntxt-userid
     1085       ,output v-cntxt-level
     1086       ,output v-cntxt-host-code-obj
     1087       ,output v-cntxt-obj-type
     1088       ,output v-cntxt-obj-code
     1089       ,output v-cntxt-db-num-obj
     1090       ,output v-cntxt-is-admin
     1091       ) .
     1092   if p-mode = 'shd':U then
     1093   do:
     1094     assign
     1095       frame Dialog-Frame :title = frame Dialog-Frame :title +
     1096                           substitute(". &1: БД &2, Задача номер &3"
     1097                           , p-task-type
     1098                           , p-db-num-char
     1099                           , p-task-num )
     1100       .
     1101   end.
     1102   run init-param-values in this-procedure ( input p-task-type
     1103     , input p-db-num-char
     1104     , input p-task-num
     1105     ) .
     1106   RUN enable_UI.
     1107   WAIT-FOR GO OF FRAME Dialog-Frame.
     1108   END.
     1109   RUN disable_UI.
     1110   PROCEDURE attach-attr-to-schedule-line :
     1111     DEFINE INPUT PARAMETER p-param-list AS CHARACTER NO-UNDO.
     1112     define input  parameter p-obj-list as character no-undo .
     1113     define input  parameter p-oss-list as character no-undo .
     1114     define input  parameter p-gds-list as character no-undo .
     1115     define buffer buf_schedule      for schedule.
     1116     define buffer buf_schedule-attr for schedule-attr.
     1117     define buffer lock-batchprocess for ub.batchprocess.
     1118     CASE p-mode:
     1119       when 'shd':U then
     1120         do:
     1121           run gbl/lock-prc.p
     1122             (input 'schd':U
     1123             ,input 'help-road':U
     1124             ,input 0
     1125             ,input 0
     1126             ,input '':U
     1127             ,input ""
     1128             ,input ""
     1129             ,input (
     1130             "выгрузка реализации банковских продуктов"
     1131             )
     1132             ,input yes
     1133             ,buffer lock-batchprocess
     1134             ) no-error .
     1135           FIND FIRST buf_schedule-attr NO-LOCK WHERE
     1136             buf_schedule-attr.task-type   = p-task-type
     1137             and buf_schedule-attr.cre-db-num = INTEGER(p-db-num-char)
     1138             and buf_schedule-attr.attr-code = ('schd-free-id':U + chr(4) + 'help-road') NO-ERROR.
     1139           IF AVAILABLE  buf_schedule-attr
     1140             AND buf_schedule-attr.task-num <> p-task-num
     1141             AND buf_schedule-attr.task-num <> - 1
     1142             and p-task-num <> - 1
     1143             THEN
     1144           DO:
     1145             MESSAGE
     1146               substitute("Уже есть расписание выгрузки реализации банковских продуктов для БД &1&2" +
     1147               "номер расписания &3"
     1148               ,buf_schedule-attr.cre-db-num
     1149               ,chr(10)
     1150               ,buf_schedule-attr.task-num)
     1151               VIEW-AS ALERT-BOX ERROR.
     1152             UNDO, RETURN ERROR.
     1153           END.
     1154           find first buf_schedule no-lock
     1155             where buf_schedule.task-type   = p-task-type
     1156             and buf_schedule.cre-db-num  = INTEGER(p-db-num-char)
     1157             and buf_schedule.task-num    = p-task-num
     1158             no-error.
     1159           if not available buf_schedule
     1160             and (  p-task-type   <> 'autofree':U
     1161             or p-db-num-char <> p-db-num-char
     1162             or p-task-num    <> -1 )
     1163             then
     1164           do:
     1165             message
     1166               vss-workfile vss-revision vss-description
     1167               skip
     1168               "Не найдена строка расписания."
     1169               skip return-value
     1170               skip trim(error-status :get-message(1))
     1171               trim(error-status :get-message(2))
     1172               trim(error-status :get-message(3))
     1173               view-as alert-box error.
     1174             undo, return error .
     1175           end.
     1176           run schedule-attr-write in this-procedure (
     1177             input INTEGER(p-db-num-char)
     1178             , input p-task-type
     1179             , input p-task-num
     1180             , input 'schedule-param-list':U
     1181             , input p-param-list
     1182             ).
     1183           run schedule-attr-write in this-procedure (
     1184             input INTEGER(p-db-num-char)
     1185             , input p-task-type
     1186             , input p-task-num
     1187             , input 'schedule-obj-list':U
     1188             , input p-obj-list
     1189             ).
     1190           run schedule-attr-write in this-procedure (
     1191             input INTEGER(p-db-num-char)
     1192             , input p-task-type
     1193             , input p-task-num
     1194             , input 'schedule-oss-list':U
     1195             , input p-oss-list
     1196             ).
     1197           run schedule-attr-write in this-procedure (
     1198             input INTEGER(p-db-num-char)
     1199             , input p-task-type
     1200             , input p-task-num
     1201             , input 'schedule-gds-list':U
     1202             , input p-gds-list
     1203             ).
     1204         end.
     1205       when 'run':U then
     1206         do:
     1207           p-params = p-param-list.
     1208         end.
     1209     END CASE.
     1210   END PROCEDURE.
     1211   PROCEDURE check-host-list :
     1212     define input-output parameter pHost-code-list as character no-undo.
     1213     define variable iCount        as integer   no-undo.
     1214     define variable cTemp         as character no-undo.
     1215     define variable iTempHostCode as integer   no-undo.
     1216     define variable cNewHostList  as character no-undo.
     1217     define variable lOk           as logical   no-undo.
     1218     do iCount = 1 to num-entries( pHost-code-list ):
     1219       cTemp = entry( iCount, pHost-code-list ).
     1220       assign
     1221         iTempHostCode = integer( cTemp ) no-error
     1222         .
     1223       run validate-host( iTempHostCode, no, no, output lOk ).
     1224       if lOk and lookup( string( iTempHostCode ), cNewHostList ) = 0
     1225         then
     1226       do:
     1227         assign
     1228           cNewHostList = cNewHostList + ',' + string( iTempHostCode )
     1229           .
     1230       end.
     1231     end.
     1232     pHost-code-list = trim( cNewHostList, ',' ).
     1233     return.
     1234   END PROCEDURE.
     1235   PROCEDURE convert :
     1236     define input-output parameter v-rid-list as character no-undo.
     1237     define variable v-list as character no-undo .
     1238     define variable v-ind  as integer   no-undo .
     1239     define buffer buf_sysconf for ub.sysconf.
     1240     do
     1241       on error undo, return error return-value
     1242       :
     1243       do v-ind = 1 to num-entries(v-rid-list)
     1244         :
     1245         find first buf_sysconf no-lock
     1246           where recid(buf_sysconf) = integer(entry(v-ind, v-rid-list))
     1247           no-error .
     1248         if available buf_sysconf
     1249           then
     1250         do:
     1251           assign
     1252             v-list = v-list
     1253                     + (if v-list = '':U
     1254                       then '':U
     1255                       else chr(44)
     1256                       )
     1257                     + string(buf_sysconf.host-code)
     1258             .
     1259         end.
     1260       end.
     1261       assign
     1262         v-rid-list = v-list
     1263         .
     1264     end.
     1265   END PROCEDURE.
     1266   PROCEDURE disable_UI :
     1267     HIDE FRAME Dialog-Frame.
     1268   END PROCEDURE.
     1269   PROCEDURE enable_UI :
     1270     DISPLAY num-days EDITOR-1 RADIO-SET-1 EDITOR-2 RADIO-SET-2 EDITOR-3
     1271             RADIO-SET-3 v-folder v-file
     1272         WITH FRAME Dialog-Frame.
     1273     ENABLE RECT-1 RECT-8 RECT-2 RECT-3 b-exit b-quit num-days EDITOR-1
     1274            RADIO-SET-1 EDITOR-2 RADIO-SET-2 EDITOR-3 RADIO-SET-3 v-folder b-dir
     1275            v-file
     1276         WITH FRAME Dialog-Frame.
     1277     VIEW FRAME Dialog-Frame.
     1278   END PROCEDURE.
     1279   PROCEDURE init-param-values :
     1280     do
     1281       on error undo, return error
     1282       :
     1283       define input parameter p-task-type              as character    no-undo.
     1284       define input parameter p-db-num-char            as character    no-undo.
     1285       define input parameter p-task-num               as integer      no-undo.
     1286       define variable v-param-list as character no-undo.
     1287       define variable v-param-type as character no-undo.
     1288       define variable v-obj-list   as character no-undo .
     1289       define variable v-gds-list   as character no-undo .
     1290       define variable v-oss-list   as character no-undo .
     1291       define variable ii           as integer   no-undo .
     1292       define variable v-entry-1    as character no-undo .
     1293       define variable v-entry-2    as character no-undo .
     1294       define variable v-entry-3    as character no-undo .
     1295       define variable v-task-num   as integer   no-undo .
     1296       define variable v-ii1        as integer   no-undo.
     1297       define variable v-text       as character no-undo.
     1298       define variable v-ii2        as integer   no-undo.
     1299       define buffer buf_tt-obj        for tt-obj.
     1300       define buffer buf_tt-oss-ref    for tt-oss-ref.
     1301       define buffer buf_tt-gds-list   for tt-gds-list.
     1302       define buffer buf_schedule      for ub.schedule.
     1303       define buffer buf_schedule-attr for ub.schedule-attr.
     1304       DO WITH FRAME Dialog-Frame:
     1305         CASE p-mode:
     1306           when 'shd':U then
     1307             do:
     1308               if p-task-num > 0
     1309                 then
     1310               do:
     1311                 v-task-num = p-task-num.
     1312               end.
     1313               else
     1314               do:
     1315                 for each buf_schedule
     1316                   where buf_schedule.task-type     = p-task-type
     1317                   AND buf_schedule.cre-db-num    = INTEGER(p-db-num-char)
     1318                   no-lock
     1319                   ,
     1320                   first buf_schedule-attr
     1321                   where buf_schedule-attr.task-type   = p-task-type
     1322                   AND buf_schedule-attr.cre-db-num  = INTEGER(p-db-num-char)
     1323                   AND buf_schedule-attr.task-num    = buf_schedule.task-num
     1324                   AND buf_schedule-attr.attr-code   = ('schd-free-id':U + chr(4) + 'help-road')
     1325                   no-lock
     1326                   :
     1327                   ASSIGN
     1328                     v-task-num = buf_schedule.task-num
     1329                     .
     1330                   leave .
     1331                 end.
     1332               end.
     1333               if v-task-num > 0
     1334                 then
     1335               do:
     1336                 run schedule-attr-value in this-procedure  ( input p-db-num-char
     1337                   , input p-task-type
     1338                   , input v-task-num
     1339                   , input 'schedule-param-list':U
     1340                   , output v-param-list
     1341                   , output v-param-type
     1342                   ) .
     1343                 run schedule-attr-value in this-procedure  ( input p-db-num-char
     1344                   , input p-task-type
     1345                   , input v-task-num
     1346                   , input 'schedule-obj-list':U
     1347                   , output v-obj-list
     1348                   , output v-param-type
     1349                   ) .
     1350                 run schedule-attr-value in this-procedure  ( input p-db-num-char
     1351                   , input p-task-type
     1352                   , input v-task-num
     1353                   , input 'schedule-oss-list':U
     1354                   , output v-oss-list
     1355                   , output v-param-type
     1356                   ) .
     1357                 run schedule-attr-value in this-procedure  ( input p-db-num-char
     1358                   , input p-task-type
     1359                   , input v-task-num
     1360                   , input 'schedule-gds-list':U
     1361                   , output v-gds-list
     1362                   , output v-param-type
     1363                   ) .
     1364               end.
     1365               v-ii2 = num-entries( v-param-list, chr(4) ).
     1366               if v-ii2 < 7 THEN
     1367               do:
     1368                 do v-ii1 = v-ii2 to 6:
     1369                   v-param-list = v-param-list
     1370                     + '':U
     1371                     + chr(4).
     1372                 end.
     1373               end.
     1374               ASSIGN
     1375                 v-folder    = ENTRY(1, v-param-list, chr(4))
     1376                 v-file      = ENTRY(2, v-param-list, chr(4))
     1377                 RADIO-SET-1 = INTEGER( ENTRY(3, v-param-list, chr(4)) )
     1378                 RADIO-SET-2 = INTEGER( ENTRY(4, v-param-list, chr(4)) )
     1379                 RADIO-SET-3 = INTEGER( ENTRY(5, v-param-list, chr(4)) )
     1380                 num-days    = INTEGER( ENTRY(6, v-param-list, chr(4)) )
     1381                 .
     1382               if RADIO-SET-1 = 0 then RADIO-SET-1 = 2 .
     1383               if RADIO-SET-2 = 0 then RADIO-SET-2 = 1 .
     1384               if RADIO-SET-3 = 0 then RADIO-SET-3 = 1 .
     1385               DISPLAY
     1386                 v-folder
     1387                 v-file
     1388                 RADIO-SET-1
     1389                 RADIO-SET-2
     1390                 RADIO-SET-3
     1391                 num-days
     1392                 .
     1393               EMPTY TEMP-TABLE buf_tt-obj.
     1394               IF v-obj-list <> "":U
     1395                 and RADIO-SET-1 = 3
     1396                 THEN
     1397               do ii = 1 to num-entries(v-obj-list, chr(4))
     1398                 on error undo, next
     1399                 :
     1400                 assign
     1401                   v-entry-1 = entry(ii, v-obj-list, chr(4))
     1402                   .
     1403                 FIND FIRST ub.clients
     1404                   WHERE ub.clients.obj-type = ENTRY(1, v-entry-1, chr(44))
     1405                   AND ub.clients.obj-code = INTEGER(ENTRY(2, v-entry-1, chr(44)))
     1406                   NO-LOCK
     1407                   NO-ERROR
     1408                   .
     1409                 IF AVAILABLE ub.clients
     1410                   THEN
     1411                 DO:
     1412                   create tt-obj.
     1413                   ASSIGN
     1414                     tt-obj.obj-code  = ub.clients.obj-code
     1415                     tt-obj.obj-type  = ub.clients.obj-type
     1416                     tt-obj.obj-name  = ub.clients.obj-name
     1417                     tt-obj.host-code = ub.clients.host-code
     1418                     v-text           = v-text + chr(10) + ub.clients.obj-name
     1419                     .
     1420                 END.
     1421                 ASSIGN
     1422                   v-text   = TRIM(v-text, chr(10))
     1423                   EDITOR-1 = v-text
     1424                   .
     1425               end.
     1426               ELSE
     1427               DO:
     1428                 if RADIO-SET-1 = 4 then
     1429                 do:
     1430                   EDITOR-1 = "Все":U.
     1431                   FOR EACH ub.clients
     1432                     WHERE ub.clients.obj-type = 'маг':U
     1433                     NO-LOCK
     1434                     :
     1435                     CREATE tt-obj.
     1436                     ASSIGN
     1437                       tt-obj.obj-code  = ub.clients.obj-code
     1438                       tt-obj.obj-type  = ub.clients.obj-type
     1439                       tt-obj.obj-name  = ub.clients.obj-name
     1440                       tt-obj.host-code = ub.clients.host-code
     1441                       .
     1442                   END.
     1443                 end.
     1444                 else
     1445                 do:
     1446                   apply "VALUE-CHANGED" TO RADIO-SET-1.
     1447                 end.
     1448               END.
     1449               DISPLAY
     1450                 EDITOR-1
     1451                 WITH FRAME Dialog-Frame.
     1452               EMPTY TEMP-TABLE buf_tt-oss-ref.
     1453               IF v-oss-list <> "":U
     1454                 and RADIO-SET-2 = 2
     1455                 THEN
     1456               do ii = 1 to num-entries(v-oss-list, chr(4))
     1457                 on error undo, next
     1458                 :
     1459                 assign
     1460                   v-entry-2 = entry(ii, v-oss-list, chr(4))
     1461                   .
     1462                 Find first ub.OperServ
     1463                   WHERE ub.OperServ.id = INTEGER(ENTRY(1, v-entry-2, chr(44)))
     1464                   NO-LOCK no-error .
     1465                 if available (ub.OperServ) then
     1466                 do:
     1467                   CREATE tt-oss-ref.
     1468                   buffer-copy ub.OperServ to tt-oss-ref .
     1469                     v-text-oss                   = v-text-oss + chr(10) + ub.OperServ.ext-code
     1470                     .
     1471                 END.
     1472                 ASSIGN
     1473                   v-text-oss = TRIM(v-text-oss, chr(10))
     1474                   EDITOR-2   = v-text-oss
     1475                   .
     1476               end.
     1477               ELSE
     1478               DO:
     1479                 if RADIO-SET-2 = 1 then
     1480                 do:
     1481                   EDITOR-2 = "Все":U.
     1482                   FOR EACH ub.OperServ
     1483                     NO-LOCK
     1484                     :
     1485                     if available (ub.OperServ) then
     1486                     do:
     1487                       CREATE tt-oss-ref.
     1488                       buffer-copy ub.OperServ to tt-oss-ref .
     1489                     END.
     1490                   end.
     1491                 END.
     1492               end.
     1493               DISPLAY
     1494                 EDITOR-2
     1495                 WITH FRAME Dialog-Frame.
     1496               EMPTY TEMP-TABLE buf_tt-gds-list.
     1497               IF v-gds-list <> "":U
     1498                 and RADIO-SET-3 = 2
     1499                 THEN
     1500               do ii = 1 to num-entries(v-gds-list, chr(4))
     1501                 on error undo, next
     1502                 :
     1503                 assign
     1504                   v-entry-3 = entry(ii, v-gds-list, chr(4))
     1505                   .
     1506                 find first ub.goods-attr no-lock
     1507                   where ub.goods-attr.attr-code  = 'oper-serv-idd':U
     1508                   and ub.goods-attr.gds-code = INTEGER(ENTRY(1, v-entry-3, chr(44)))
     1509                   no-error .
     1510                 if available (ub.goods-attr) then
     1511                 do:
     1512                   find first ub.goods no-lock where ub.goods-attr.gds-code = ub.goods.gds-code no-error .
     1513                   if available (ub.goods) then
     1514                   do:
     1515                     CREATE tt-gds-list.
     1516                     ASSIGN
     1517                       tt-gds-list.artic     = ub.goods.artic
     1518                       tt-gds-list.gds-code  = ub.goods.gds-code
     1519                       tt-gds-list.gds-name  = ub.goods.gds-name
     1520                       tt-gds-list.prod-code = ub.goods.prod-code
     1521                       tt-gds-list.prod-type = ub.goods.prod-type
     1522                       v-text-gds            = v-text-gds + chr(10) + ub.goods.gds-name
     1523                       .
     1524                   end.
     1525                 end.
     1526                 ASSIGN
     1527                   v-text-gds = TRIM(v-text-gds, chr(10))
     1528                   EDITOR-3   = v-text-gds
     1529                   .
     1530               end.
     1531               ELSE
     1532               DO:
     1533                 if RADIO-SET-3 = 1 then
     1534                 do:
     1535                   EDITOR-3 = "Все":U.
     1536                   for each ub.goods-attr no-lock
     1537                     where ub.goods-attr.attr-code  = 'oper-serv-idd':U,
     1538                     each ub.goods no-lock where ub.goods.gds-code = ub.goods-attr.gds-code
     1539                     :
     1540                     CREATE tt-gds-list.
     1541                     ASSIGN
     1542                       tt-gds-list.artic     = ub.goods.artic
     1543                       tt-gds-list.gds-code  = ub.goods.gds-code
     1544                       tt-gds-list.gds-name  = ub.goods.gds-name
     1545                       tt-gds-list.prod-code = ub.goods.prod-code
     1546                       tt-gds-list.prod-type = ub.goods.prod-type
     1547                       .
     1548                   end.
     1549                 END.
     1550               end.
     1551               DISPLAY
     1552                 EDITOR-3
     1553                 WITH FRAME Dialog-Frame.
     1554             END.
     1555           WHEN 'run'
     1556           THEN
     1557             DO:
     1558               v-param-list = '':U
     1559                 + chr(4)
     1560                 + '':U
     1561                 + chr(4)
     1562                 + '':U
     1563                 + chr(4)
     1564                 + '':U
     1565                 + chr(4)
     1566                 + '':U
     1567                 + chr(4).
     1568             END.
     1569         END CASE.
     1570       END.
     1571     END.
     1572   END PROCEDURE.
     1573   PROCEDURE proc-save :
     1574     DEFINE VARIABLE glog             AS LOGICAL   NO-UNDO.
     1575     DEFINE VARIABLE v-param-list     AS CHARACTER NO-UNDO.
     1576     define variable v-obj-list       as character no-undo .
     1577     define variable v-list           as character no-undo .
     1578     define variable v-oss-list       as character no-undo .
     1579     define variable v-gds-list       as character no-undo .
     1580     define variable ii               as integer   no-undo .
     1581     define variable v-exists         as logical   no-undo .
     1582     define variable v-date-file-name as character no-undo.
     1583     define variable v-time-file      as char      no-undo.
     1584     define buffer buf_tt-obj      for tt-obj .
     1585     define buffer buf_tt-oss-ref  for tt-oss-ref .
     1586     define buffer buf_tt-gds-list for tt-gds-list .
     1587     define variable v-file-name as character no-undo .
     1588     ASSIGN
     1589       FRAME Dialog-Frame
     1590       RADIO-SET-1
     1591       RADIO-SET-2
     1592       RADIO-SET-3
     1593       EDITOR-1
     1594       EDITOR-2
     1595       EDITOR-3
     1596       v-folder
     1597       v-file
     1598       num-days
     1599       .
     1600     if num-days < 0 then
     1601     do:
     1602       message
     1603         "Кол-во дней задан неверно. "
     1604         skip "Задайте интервал правильно или отмените экспорт."
     1605         view-as alert-box information.
     1606       apply "entry" to num-days.
     1607       undo, return no-apply.
     1608     end.
     1609     if not can-find( first buf_tt-obj ) then
     1610     do:
     1611       message
     1612         "Не заданы объекты для выгрузки"
     1613         view-as alert-box error .
     1614       return error.
     1615     end.
     1616     v-obj-list = ''.
     1617     for each buf_tt-obj :
     1618       assign
     1619         v-obj-list = v-obj-list
     1620                    + buf_tt-obj.obj-type + chr(44)
     1621                    + string(buf_tt-obj.obj-code) + chr(4)
     1622         .
     1623     end.
     1624     if not can-find( first buf_tt-oss-ref ) then
     1625     do:
     1626       message
     1627         "Не заданы платежные агенты/операторы для выгрузки"
     1628         view-as alert-box error .
     1629       return error.
     1630     end.
     1631     v-oss-list = ''.
     1632     for each buf_tt-oss-ref :
     1633       assign
     1634         v-oss-list = v-oss-list + string (buf_tt-oss-ref.id) + chr(4)
     1635         .
     1636     end.
     1637     if not can-find( first buf_tt-gds-list ) then
     1638     do:
     1639       message
     1640         "Не заданы товары платежного агента/оператора для выгрузки"
     1641         view-as alert-box error .
     1642       return error.
     1643     end.
     1644     v-gds-list = ''.
     1645     for each buf_tt-gds-list :
     1646       assign
     1647         v-gds-list = v-gds-list
     1648                    + string (buf_tt-gds-list.gds-code)  + chr(4)
     1649         .
     1650     end.
     1651     if v-file = "" then
     1652     do:
     1653       assign
     1654         v-time-file      = replace(  string(time,"HH:MM:SS"),  ":",  ""  )
     1655         v-today          = today
     1656         v-date-file-name = STRING(YEAR(v-today), "9999") +  STRING(DAY(v-today), "99") + STRING(MONTH(v-today), "99")
     1657         v-file           = substitute( "rep_PA_&1_&2"
     1658                                   , v-date-file-name, v-time-file )
     1659         .
     1660     end.
     1661     ASSIGN
     1662       v-obj-list = TRIM(v-obj-list, chr(4)).
     1663     v-oss-list = TRIM(v-oss-list, chr(4)).
     1664     v-gds-list = TRIM(v-gds-list, chr(4)).
     1665     v-param-list = v-folder + chr(4) +
     1666       v-file   + chr(4) +
     1667       STRING( RADIO-SET-1 ) + chr(4) +
     1668       STRING( RADIO-SET-2 ) + chr(4) +
     1669       STRING( RADIO-SET-3 ) + chr(4) +
     1670       string(if num-days <> ? then string(num-days) else "") + chr(4)
     1671       .
     1672     IF p-mode = 'shd' THEN
     1673     DO:
     1674       run attach-attr-to-schedule-line in this-procedure ( INPUT v-param-list
     1675         , INPUT v-obj-list
     1676         , input v-oss-list
     1677         , input v-gds-list
     1678         ) .
     1679     END.
     1680   END PROCEDURE.
