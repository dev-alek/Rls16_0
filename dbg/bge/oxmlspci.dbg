     1384   ON CHOOSE OF b-db-export IN FRAME Dialog-Frame
     1385   DO:
     1386   define variable v-rid as recid no-undo.
     1387   define buffer buf_db for ub.db.
     1388      run adm/dbs.w ( INPUT parparentproc
     1389                     ,INPUT 'ПРОСМОТР':U
     1390                     ,OUTPUT v-rid) NO-ERROR.
     1391      IF ERROR-STATUS:ERROR THEN return no-apply.
     1392       FIND FIRST buf_db NO-LOCK WHERE
     1393              recid(buf_db) = v-rid no-error.
     1394      if available buf_db then do:
     1395         assign
     1396         tt-ext-system.esys-db-num-exp = buf_db.db-num
     1397         f-exp-db-name = buf_db.db-name.
     1398         display
     1399         tt-ext-system.esys-db-num-exp
     1400         f-exp-db-name
     1401         with frame Dialog-Frame.
     1402      end.
     1403   END.
     1404   ON CHOOSE OF b-db-import IN FRAME Dialog-Frame
     1405   DO:
     1406     define variable v-rid as recid no-undo.
     1407   define buffer buf_db for ub.db.
     1408      run adm/dbs.w ( INPUT parparentproc
     1409                     ,INPUT 'ПРОСМОТР':U
     1410                     ,OUTPUT v-rid) NO-ERROR.
     1411      IF ERROR-STATUS:ERROR THEN RETURN no-apply.
     1412       FIND FIRST buf_db NO-LOCK WHERE
     1413              recid(buf_db) = v-rid no-error.
     1414      if available buf_db then do:
     1415         assign
     1416         tt-ext-system.esys-db-num-imp = buf_db.db-num
     1417         f-imp-db-name = buf_db.db-name
     1418         .
     1419         display
     1420         tt-ext-system.esys-db-num-imp
     1421         f-imp-db-name
     1422         with frame Dialog-Frame.
     1423      end.
     1424   END.
