        1   DEFINE BUFFER locked_ext-system FOR ext-system.
        2   DEFINE TEMP-TABLE tt-ext-system NO-UNDO LIKE ext-system.
        3   DEFINE TEMP-TABLE tt-ext-system-attr NO-UNDO LIKE ext-system-attr.
        4   define input parameter parparentproc        as handle           no-undo.
        5   define input parameter p-mode               as character        no-undo.
        6   define input-output parameter p-esys-id     as integer          no-undo.
        7   define input parameter p-db-num             as integer          no-undo.
        8   define output parameter p-success           as logical          no-undo.
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Open XML. Редактирование записи внешней подсистемы с типом специальна ".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define variable vss-include-info0 as character format "X(65)" no-undo
       74   initial "@(#)$Workfile$ $Revision$".
       75   procedure oxmlext-create :
       76   define input parameter p-mainmenu-handle    as handle           no-undo.
       77   define input parameter p-current-db-num     as integer          no-undo.
       78   define output parameter p-esys-id           as integer          no-undo.
       79       define variable v-today     as date         no-undo.
       80       define variable v-time      as integer      no-undo.
       81       define variable v-userid    as character    no-undo.
       82       define buffer buf_ext-system        for ub.ext-system.
       83   do
       84   for buf_ext-system
       85   on error undo, return error
       86   :
       87       run cur-time in this-procedure (
       88             output v-today
       89           , output v-time
       90       ).
       91       run oxmlext-esys-id in this-procedure (
       92           output p-esys-id
       93       ).
       94       run get-userid in p-mainmenu-handle (
       95           output v-userid
       96       ).
       97       create buf_ext-system.
       98       assign
       99           buf_ext-system.esys-id                          = p-esys-id
      100           buf_ext-system.db-num                           = p-current-db-num
      101           buf_ext-system.esys-date-change                 = v-today
      102           buf_ext-system.esys-chk-ingr-imp                = no
      103           buf_ext-system.esys-chk-seq-imp                 = no
      104           buf_ext-system.esys-date-change-attr            = v-today
      105           buf_ext-system.esys-date-change-exp             = v-today
      106           buf_ext-system.esys-date-change-imp             = v-today
      107           buf_ext-system.esys-db-num-exp                  = p-current-db-num
      108           buf_ext-system.esys-db-num-imp                  = p-current-db-num
      109           buf_ext-system.esys-des                         = ""
      110           buf_ext-system.esys-file-chk-ing-imp            = "":U
      111           buf_ext-system.esys-have-export                 = no
      112           buf_ext-system.esys-have-import                 = no
      113           buf_ext-system.esys-have-proc-chk-ing-imp       = no
      114           buf_ext-system.esys-last-pack                   = 0
      115           buf_ext-system.esys-name                        = "<Новая внешняя система>"
      116           buf_ext-system.esys-num-days-keep-exp           = 0
      117           buf_ext-system.esys-num-days-keep-imp           = 0
      118           buf_ext-system.esys-proc-chk-ing-imp            = "":U
      119           buf_ext-system.esys-send-news-exp               = no
      120           buf_ext-system.esys-send-news-imp               = no
      121           buf_ext-system.esys-status                      = integer( '-1':U )
      122           buf_ext-system.esys-work-update                 = no
      123           buf_ext-system.esys-creid                       = v-userid
      124           buf_ext-system.esys-sys-date                    = v-today
      125           buf_ext-system.esys-sys-time-int                = v-time
      126           buf_ext-system.esys-sys-time                    = string( v-time, "HH:MM:SS" )
      127           buf_ext-system.esys-user-name                   = v-userid
      128           buf_ext-system.esys-user-db-num                 = p-current-db-num
      129       .
      130   end.
      131   end procedure.
      132   procedure oxmlext-start-subsystem :
      133   define input parameter p-esys-id    as integer          no-undo.
      134   define input parameter p-db-num     as integer          no-undo.
      135       define buffer buf_ext-system        for ub.ext-system.
      136   do
      137   for buf_ext-system
      138   on error undo, return error
      139   :
      140       find first buf_ext-system exclusive-lock
      141            where buf_ext-system.esys-id = p-esys-id
      142              and buf_ext-system.db-num  = p-db-num
      143       .
      144       if buf_ext-system.esys-status = 20
      145       then do:
      146           assign
      147               buf_ext-system.esys-status = 21
      148           .
      149       end.
      150       else do:
      151           assign
      152               buf_ext-system.esys-status = 1
      153           .
      154       end.
      155   end.
      156   end procedure.
      157   procedure oxmlext-stop-subsystem :
      158   define input parameter p-esys-id    as integer          no-undo.
      159   define input parameter p-db-num     as integer          no-undo.
      160       define buffer buf_ext-system        for ub.ext-system.
      161   do
      162   for buf_ext-system
      163   on error undo, return error
      164   :
      165       find first buf_ext-system exclusive-lock
      166            where buf_ext-system.esys-id = p-esys-id
      167              and buf_ext-system.db-num  = p-db-num
      168       .
      169       if buf_ext-system.esys-status = 21
      170       then do:
      171           assign
      172               buf_ext-system.esys-status = 20
      173           .
      174       end.
      175       else do:
      176           assign
      177               buf_ext-system.esys-status = 0
      178           .
      179       end.
      180   end.
      181   end procedure.
      182   procedure oxmlext-stop-import :
      183   define input parameter p-esys-id    as integer          no-undo.
      184   define input parameter p-db-num     as integer          no-undo.
      185   do
      186   on error undo, return error
      187   :
      188   end.
      189   end procedure.
      190   procedure oxmlext-stop-export :
      191   define input parameter p-esys-id    as integer          no-undo.
      192   define input parameter p-db-num     as integer          no-undo.
      193   do
      194   on error undo, return error
      195   :
      196   end.
      197   end procedure.
      198   procedure proc-alt-shift-f2:
      199     if not ibs.th.gbl.gbl-var:rcode
      200   then
      201     run gbl\inidebug.p .
      202   end.
      203   procedure proc-alt-shift-f3:
      204     run gbl/prvssinf.p
      205       ( input this-procedure
      206       ) .
      207   end.
      208   define variable v-inform-launched as logical no-undo initial false .
      209   procedure proc-alt-shift-f4:
      210     define variable v-action as character no-undo .
      211     if v-inform-launched = false then do:
      212       assign
      213         v-inform-launched = true
      214       .
      215       run gbl/d-inform.w
      216         (  input self
      217         ,  input this-procedure
      218         , output v-action
      219         ) no-error .
      220       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      221       assign
      222         v-inform-launched = false
      223       .
      224     end.
      225   end.
      226   procedure proc-alt-f1:
      227     run gbl/corrhelp.p
      228       (input this-procedure
      229       ) .
      230   end .
      231   on alt-shift-f2 anywhere do:
      232     run proc-alt-shift-f2.
      233   end.
      234   on alt-shift-f3 anywhere do:
      235     run proc-alt-shift-f3 in this-procedure .
      236   end.
      237   on alt-shift-f4 anywhere do:
      238     run proc-alt-shift-f4 in this-procedure.
      239   end.
      240   on alt-f1 anywhere do:
      241     run proc-alt-f1 in this-procedure .
      242   end.
      243   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      244     define variable v-cntxt-db-num        as integer   no-undo .
      245     define variable v-cntxt-userid        as character no-undo .
      246     define variable v-cntxt-level         as character no-undo .
      247     define variable v-cntxt-host-code-obj as integer   no-undo .
      248     define variable v-cntxt-obj-type      as character no-undo .
      249     define variable v-cntxt-obj-code      as integer   no-undo .
      250     define variable v-cntxt-db-num-obj    as integer   no-undo .
      251     define variable v-cntxt-is-admin      as logical   no-undo .
      252   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      253   procedure gen-key-rec :
      254     define input  parameter p-tbl-name    as character no-undo.
      255     define input  parameter p-bh_tbl-name as handle    no-undo.
      256     define output parameter p-key-rec     as character no-undo.
      257     do
      258     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      259     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      260     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      261     :
      262       define variable fh               as handle    no-undo .
      263       define variable v-ok             as logical   no-undo .
      264       define variable v-inform         as character no-undo .
      265       define variable v-ind            as integer   no-undo .
      266       define variable v-idx-field-qnty as integer   no-undo .
      267       if p-tbl-name = ?
      268         or p-tbl-name = "":U
      269       then do:
      270         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      271       end.
      272       if not p-bh_tbl-name:available then do:
      273         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      274       end.
      275       assign
      276         p-key-rec = p-tbl-name
      277         v-inform  = p-bh_tbl-name:index-information(1)
      278         v-ind     = 2
      279       .
      280       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      281       on error undo, return error
      282       :
      283         assign
      284           v-inform = p-bh_tbl-name:index-information( v-ind )
      285           v-ind    = v-ind + 1
      286         .
      287       end.
      288       if v-inform = ?
      289         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      290         or entry( 3, v-inform, ",":U ) <> "1":U
      291       then do:
      292         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      293       end.
      294       else do:
      295         assign
      296           v-idx-field-qnty = num-entries( v-inform ) - 4
      297         .
      298         if v-idx-field-qnty < 2 then do:
      299           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      300         end.
      301         do v-ind = 1 to v-idx-field-qnty by 2
      302         on error undo, return error
      303         :
      304           assign
      305             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      306             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      307           .
      308         end.
      309       end.
      310       if p-key-rec = ? then do:
      311         assign
      312           p-key-rec = "":U
      313         .
      314         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      315       end.
      316     end.
      317     return.
      318   end procedure.
      319   procedure gen-where-keyr-tab :
      320     define input  parameter i-tableSerach as character no-undo.
      321     define input  parameter i-tablekey   as character  no-undo.
      322     define input  parameter p-key-rec    as character  no-undo.
      323     define input  parameter p-key-handle as handle     no-undo .
      324     define input  parameter p-db-name    as character  no-undo .
      325     define input  parameter p-tt-handle  as handle     no-undo .
      326     define output parameter o-Where      as character  no-undo.
      327     do
      328     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      329     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      330     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      331     :
      332       define variable v-full-tbl-name  as character no-undo .
      333       define variable bh_tbl-name      as handle    no-undo .
      334       define variable fh_key           as handle    no-undo .
      335       define variable fh_search        as handle    no-undo .
      336       define variable v-field-num      as integer   no-undo .
      337       define variable v-count-fld      as integer   no-undo .
      338       define variable v-inform         as character no-undo .
      339       define variable v-ind            as integer   no-undo .
      340       define variable v-idx-field-qnty as integer   no-undo .
      341       define variable v-field-name     as character no-undo .
      342       define variable v-field-val      as character no-undo .
      343       define variable v-word-link      as character no-undo .
      344       define variable vTable           as character no-undo.
      345       define variable bh_tbl-key       as handle    no-undo .
      346       assign
      347         p-key-rec = trim( p-key-rec )
      348       .
      349       if p-key-handle <> ? then do:
      350         if not valid-handle(p-key-handle)
      351            or p-key-handle:type <> "buffer"
      352         then do:
      353           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      354         end.
      355         if num-entries( p-key-rec, chr(3) ) > 1
      356           or p-key-rec = ?
      357           or p-key-rec = "":U
      358         then do:
      359           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      360         end.
      361       end.
      362       else do:
      363         if p-key-rec = ?
      364           or p-key-rec = "":U
      365         then do:
      366           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      367         end.
      368       end.
      369       assign
      370         vTable = entry( 1 , p-key-rec, chr(3) )
      371       .
      372       if p-tt-handle <> ?
      373         and ( not valid-handle(p-tt-handle)
      374               or p-tt-handle:type <> "buffer"
      375             )
      376       then do:
      377         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      378       end.
      379       if p-tt-handle = ? then do:
      380         assign
      381           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      382         .
      383         create buffer bh_tbl-name for table v-full-tbl-name .
      384       end.
      385       else do:
      386         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      387       end.
      388       assign
      389         v-inform = bh_tbl-name:index-information(1)
      390         v-ind    = 2
      391       .
      392       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      393       on error undo, return error
      394       :
      395         assign
      396           v-inform = bh_tbl-name:index-information( v-ind )
      397           v-ind    = v-ind + 1
      398         .
      399       end.
      400       if v-inform = ?
      401         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      402         or entry( 3, v-inform, ",":U ) <> "1":U
      403       then do:
      404         delete object bh_tbl-name no-error.
      405         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      406       end.
      407       assign
      408         v-idx-field-qnty = num-entries( v-inform ) - 4
      409       .
      410       if v-idx-field-qnty < 2 then do:
      411         delete object bh_tbl-name no-error.
      412         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      413       end.
      414       assign
      415         o-where     = "where":U
      416         v-word-link = "":U
      417         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      418         v-count-fld = 0
      419       .
      420       if i-tablekey ne "" and i-tablekey ne ?
      421       then do:
      422         assign
      423           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      424         .
      425         create buffer bh_tbl-key for table v-full-tbl-name .
      426       end.
      427       if i-tableSerach ne "" and i-tableSerach ne ?
      428       then do:
      429         delete object bh_tbl-name no-error.
      430         assign
      431           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      432         .
      433         create buffer bh_tbl-name for table v-full-tbl-name .
      434       end.
      435       block_where:
      436       do v-ind = 1 to v-idx-field-qnty by 2
      437       on error undo, return error
      438       :
      439         assign
      440           v-count-fld = v-count-fld + 1
      441         .
      442         if p-key-handle = ?
      443           and v-count-fld > v-field-num
      444         then do:
      445           leave block_where.
      446         end.
      447         define variable VfieldKeyTable as handle no-undo.
      448         assign
      449           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      450           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      451         .
      452         if     bh_tbl-key ne ?
      453         then do:
      454            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      455            if VfieldKeyTable eq ?
      456            then next block_where.
      457         end.
      458         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      459         then
      460            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      461         else
      462            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      463         if p-key-handle = ? then do:
      464           assign
      465             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      466           .
      467         end.
      468         else do:
      469           assign
      470             fh_key = p-key-handle:buffer-field( v-field-name )
      471           .
      472           if fh_key = ?
      473             or not valid-handle( fh_key )
      474           then do:
      475             delete object bh_tbl-name.
      476             if     bh_tbl-key ne ?
      477             then
      478                delete object bh_tbl-key.
      479             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      480           end.
      481           assign
      482             v-field-val = fh_key:buffer-value
      483           .
      484         end.
      485         if fh_search:data-type ="character":U then do:
      486           assign
      487             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      488             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      489             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      490             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      491             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      492             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      493             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      494             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      495             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      496             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      497             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      498             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      499             v-field-val = substitute( '"&1"', v-field-val )
      500           .
      501         end.
      502         assign
      503           o-where = substitute( "&1 &2", o-where, v-field-val )
      504         .
      505         if v-word-link = "":U then do:
      506           assign
      507             v-word-link = "and":U
      508           .
      509         end.
      510       end.
      511       delete object bh_tbl-name.
      512       if     bh_tbl-key ne ?
      513       then
      514          delete object bh_tbl-key.
      515       if p-key-handle = ?
      516         and v-count-fld <> v-field-num
      517       then do:
      518         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      519       end.
      520     end.
      521   end procedure.
      522   procedure gen-hn-keyr-tab :
      523     define input  parameter i-tableSerach as character no-undo.
      524     define input  parameter i-tablekey   as character no-undo.
      525     define input  parameter p-key-rec    as character no-undo.
      526     define input  parameter p-key-handle as handle    no-undo .
      527     define input  parameter p-db-name    as character no-undo .
      528     define input  parameter p-tt-handle  as handle    no-undo .
      529     define input  parameter p-stts-lock  as integer   no-undo .
      530     define output parameter o-hn         as handle    no-undo.
      531     define variable v-full-tbl-name as character no-undo.
      532     define variable v-where         as character no-undo.
      533     define variable bh_tbl-name     as handle    no-undo.
      534     define variable vTable          as character no-undo.
      535     do
      536     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      537     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      538     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      539         run gen-where-keyr-tab(i-tableSerach,
      540                                i-tablekey,
      541                                p-key-rec,
      542                                p-key-handle,
      543                                p-db-name,
      544                                p-tt-handle,
      545                                output v-where).
      546         if i-tableSerach ne "" and i-tableSerach ne ?
      547         then do:
      548            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      549            create buffer bh_tbl-name for table v-full-tbl-name .
      550         end.
      551         else do:
      552            if p-tt-handle = ? then do:
      553               assign
      554                  vTable = entry( 1 , p-key-rec, chr(3) )
      555               .
      556               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      557               create buffer bh_tbl-name for table v-full-tbl-name .
      558            end.
      559            else do:
      560               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      561            end.
      562         end.
      563         if p-tt-handle = ? then do:
      564            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      565         end.
      566         else do:
      567            bh_tbl-name:find-first( v-where ) no-error .
      568         end.
      569         o-hn = bh_tbl-name.
      570      end.
      571   end procedure.
      572   procedure gen-hn-keyr :
      573     define input  parameter p-key-rec    as character no-undo.
      574     define input  parameter p-key-handle as handle    no-undo .
      575     define input  parameter p-db-name    as character no-undo .
      576     define input  parameter p-tt-handle  as handle    no-undo .
      577     define input  parameter p-stts-lock  as integer   no-undo .
      578     define output parameter o-hn         as handle    no-undo.
      579     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      580   end.
      581   procedure gen-row-keyr :
      582     define input  parameter p-key-rec    as character no-undo.
      583     define input  parameter p-key-handle as handle    no-undo .
      584     define input  parameter p-db-name    as character no-undo .
      585     define input  parameter p-tt-handle  as handle    no-undo .
      586     define input  parameter p-stts-lock  as integer   no-undo .
      587     define output parameter p-tbl-row    as rowid     no-undo.
      588     define output parameter p-tbl-name   as character no-undo.
      589     define variable vHn as handle no-undo.
      590       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      591       p-tbl-row = if vHn:available then vHn:rowid else ?.
      592       p-tbl-name =  vHn:table.
      593       delete object vHn no-error.
      594     if p-tbl-row = ? then do:
      595       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      596     end.
      597     else do:
      598       return.
      599     end.
      600   end procedure.
      601   procedure gen-key-fv :
      602     define input  parameter p-key-rec    as character no-undo .
      603     define output parameter p-field-list as character no-undo .
      604     define output parameter p-value-list as character no-undo.
      605     do
      606     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      607     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      608     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      609     :
      610       define variable v-full-tbl-name  as character no-undo .
      611       define variable bh_tbl-name      as handle    no-undo .
      612       define variable v-tbl-name       as character no-undo .
      613       define variable v-field-num      as integer   no-undo .
      614       define variable v-count-fld      as integer   no-undo .
      615       define variable v-inform         as character no-undo .
      616       define variable v-ind            as integer   no-undo .
      617       define variable v-idx-field-qnty as integer   no-undo .
      618       define variable v-delim-key      as character no-undo .
      619       if p-key-rec = ?
      620         or p-key-rec = "":U
      621       then do:
      622         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      623       end.
      624       assign
      625         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      626         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      627       .
      628       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      629       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      630       assign
      631         v-inform = bh_tbl-name:index-information(1)
      632         v-ind    = 2
      633       .
      634       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      635       on error undo, return error
      636       :
      637         assign
      638           v-inform = bh_tbl-name:index-information( v-ind )
      639           v-ind    = v-ind + 1
      640         .
      641       end.
      642       if v-inform = ?
      643         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      644         or entry( 3, v-inform, ",":U ) <> "1":U
      645       then do:
      646         delete object bh_tbl-name no-error.
      647         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      648       end.
      649       assign
      650         v-idx-field-qnty = num-entries( v-inform ) - 4
      651       .
      652       if v-idx-field-qnty < 2 then do:
      653         delete object bh_tbl-name no-error.
      654         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      655       end.
      656       assign
      657         p-field-list = "":U
      658         p-value-list = "":U
      659         v-delim-key  = "":U
      660         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      661         v-count-fld  = 0
      662       .
      663       block_where:
      664       do v-ind = 1 to v-idx-field-qnty by 2
      665       on error undo, return error
      666       :
      667         assign
      668           v-count-fld = v-count-fld + 1
      669         .
      670         if v-count-fld > v-field-num then do:
      671           leave block_where.
      672         end.
      673         assign
      674           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      675           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      676         .
      677         if v-ind = 1 then do:
      678           assign
      679             v-delim-key = chr(3)
      680           .
      681         end.
      682       end.
      683       delete object bh_tbl-name.
      684       if v-count-fld <> v-field-num then do:
      685         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      686       end.
      687     end.
      688   end procedure.
      689   procedure gen-key-field :
      690     define input  parameter p-table      as character no-undo .
      691     define output parameter p-field-list as character no-undo .
      692     do
      693     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      694     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      695     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      696     :
      697       define variable v-full-tbl-name  as character no-undo .
      698       define variable bh_tbl-name      as handle    no-undo .
      699       define variable v-tbl-name       as character no-undo .
      700       define variable v-field-num      as integer   no-undo .
      701       define variable v-count-fld      as integer   no-undo .
      702       define variable v-inform         as character no-undo .
      703       define variable v-ind            as integer   no-undo .
      704       define variable v-idx-field-qnty as integer   no-undo .
      705       define variable v-delim-key      as character no-undo .
      706       if p-table = ?
      707         or p-table = "":U
      708       then do:
      709         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      710       end.
      711       assign
      712         v-tbl-name      = p-table
      713         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      714       .
      715       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      716       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      717       assign
      718         v-inform = bh_tbl-name:index-information(1)
      719         v-ind    = 2
      720       .
      721       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      722       on error undo, return error
      723       :
      724         assign
      725           v-inform = bh_tbl-name:index-information( v-ind )
      726           v-ind    = v-ind + 1
      727         .
      728       end.
      729       if v-inform = ?
      730         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      731         or entry( 3, v-inform, ",":U ) <> "1":U
      732       then do:
      733         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      734       end.
      735       assign
      736         v-idx-field-qnty = num-entries( v-inform ) - 4
      737       .
      738       if v-idx-field-qnty < 2 then do:
      739         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      740       end.
      741       assign
      742         p-field-list = "":U
      743         v-delim-key  = "":U
      744         v-count-fld  = 0
      745       .
      746       block_where:
      747       do v-ind = 1 to v-idx-field-qnty by 2
      748       on error undo, return error
      749       :
      750         assign
      751           v-count-fld = v-count-fld + 1
      752         .
      753         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      754         if v-ind = 1 then do:
      755           assign
      756             v-delim-key = chr(3)
      757           .
      758         end.
      759       end.
      760       delete object bh_tbl-name.
      761     end.
      762   end procedure.
      763   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      764   define new global shared variable g#attr-lib  as handle no-undo .
      765   define variable v-attr-lib-variable as handle no-undo .
      766   procedure ext-system-attr-code :
      767     define input  parameter p-code           as character no-undo .
      768     define output parameter p-type           as character no-undo .
      769     define output parameter p-format         as character no-undo .
      770     define output parameter p-label          as character no-undo .
      771     define output parameter p-user-can-edit  as logical   no-undo .
      772     define output parameter p-output-display as logical   no-undo .
      773     define output parameter p-other          as character no-undo .
      774     do
      775     on error undo, return error
      776     :
      777           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-code in g#attr-lib
      778         (input  p-code
