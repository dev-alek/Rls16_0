      923   end procedure.
      924   procedure ext-system-attr-batch-edit :
      925     define input  parameter p-code           as character no-undo .
      926     define output parameter p-section-num    as integer no-undo .
      927     do
      928     on error undo, return error
      929     :
      930           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-batch-edit in g#attr-lib
      931         (input  p-code
      932         ,output p-section-num
      933         ) no-error .
      934       if error-status :error
      935       then do:
      936         undo, return error return-value .
      937       end.
      938     end.
      939   end procedure.
