     1478   on choose of b-obj in frame motp-frame
     1479   do :
     1480     define variable v-rid-list as character no-undo .
     1481     define variable v-rid-rec  as recid no-undo .
     1482     define buffer buf_shop for ub.shop .
     1483     v-rid-list = "" .
     1484     run adm/shops.w ( input parparentproc
     1485                      ,input "b-sel"
     1486                      ,input-output v-rid-list
     1487                      ,no ).
     1488     if v-rid-list = "":U then return.
     1489     v-rid-rec = integer(v-rid-list) no-error .
     1490     find first buf_shop no-lock where recid(buf_shop) = v-rid-rec no-error .
     1491     if available buf_shop then f-obj:screen-value = 'маг':U + string(buf_shop.obj-code) .
     1492     assign f-obj .
     1493   end .
     1494   on value-changed of f-obj in frame motp-frame
     1495   do :
     1496     assign f-obj .
     1497   end .
     1498   on choose of b-obj in frame diadoc-frame
     1499   do :
     1500     define variable v-rid-list as character no-undo .
     1501     define variable v-rid-rec  as recid no-undo .
     1502     define buffer buf_shop for ub.shop .
     1503     v-rid-list = "" .
     1504     run adm/shops.w ( input parparentproc
     1505                      ,input "b-sel"
     1506                      ,input-output v-rid-list
     1507                      ,no ).
     1508     if v-rid-list = "":U then return.
     1509     v-rid-rec = integer(v-rid-list) no-error .
     1510     find first buf_shop no-lock where recid(buf_shop) = v-rid-rec no-error .
     1511     if available buf_shop then f-obj:screen-value = 'маг':U + string(buf_shop.obj-code) .
     1512     assign f-obj .
     1513   end .
     1514   on value-changed of f-obj in frame diadoc-frame
     1515   do :
     1516     assign f-obj .
     1517   end .
