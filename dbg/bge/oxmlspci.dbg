     1442      if error-status:error then return no-apply.
     1443      assign
     1444      p-success = yes.
     1445   END.
     1446   ON CHOOSE OF b-links IN FRAME Dialog-Frame
     1447   DO:
     1448   IF link-option = '':U THEN DO:
     1449      run gbl/pop-up.p ( INPUT SELF:handle, input no ) no-error.
     1450      if error-status :error then do: return no-apply. end.
     1451   end.
     1452   if link-option = "":U then do:
     1453         return no-apply.
     1454   end.
     1455   run proc-b-link IN THIS-PROCEDURE ( INPUT link-option) NO-ERROR.
     1456   IF ERROR-STATUS:ERROR THEN DO:
     1457       link-option = '':U.
     1458       RETURN NO-APPLY.
     1459   END.
     1460   link-option = '':U.
     1461   END.
     1462   on choose of b-host-code in frame motp-frame
     1463   do :
