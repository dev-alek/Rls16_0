        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as handle           no-undo.
        3   define input parameter p-obj-type       as character        no-undo.
        4   define input parameter p-obj-code       as integer          no-undo.
        5   define input parameter p-verify-arh     as logical          no-undo.
        6   define input parameter p-verify-ahsp    as logical          no-undo.
        7   define input parameter p-verify-aht     as logical          no-undo.
        8   define input parameter p-date-from      as date             no-undo.
        9   define input parameter p-date-to        as date             no-undo.
       10   define output parameter p-archive-ok    as logical          no-undo.
       11   define output parameter p-comment       as character        no-undo.
       12   define variable vss-revision    as character no-undo init "$Revision: 56408f49832e, 136, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       14   define variable vss-date        as character no-undo init "$Date: Mon Feb 16 20:48:25 2015 +0400 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: bge-ahz.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: bge/bge-ahz.p $":U .
       17   define variable vss-description as character no-undo init "Проверка архивов для диапазона дат для выгрузки".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88     define variable v-cntxt-db-num        as integer   no-undo .
       89     define variable v-cntxt-userid        as character no-undo .
       90     define variable v-cntxt-level         as character no-undo .
       91     define variable v-cntxt-host-code-obj as integer   no-undo .
       92     define variable v-cntxt-obj-type      as character no-undo .
       93     define variable v-cntxt-obj-code      as integer   no-undo .
       94     define variable v-cntxt-db-num-obj    as integer   no-undo .
       95     define variable v-cntxt-is-admin      as logical   no-undo .
       96   define buffer buf_sys-ctrl    for ub.sys-ctrl.
       97   define buffer buf_user-login  for ub.user-login.
       98   define variable v-date-from    as date          no-undo .
       99   define variable v-date-to      as date          no-undo .
      100   define variable v-can-print    as logical       no-undo .
      101   define variable v-login        as character     no-undo .
      102   do
      103   on error undo, return error
      104   :
      105       find first buf_sys-ctrl no-lock .
      106       assign
      107         v-login = userid("ub")
      108         v-cntxt-db-num = buf_sys-ctrl.db-num
      109       .
      110       find first buf_user-login no-lock
      111         where buf_user-login.db-num     = v-cntxt-db-num
      112           and buf_user-login.user-login = v-login
      113       no-error .
      114       if not available buf_user-login
      115       then do:
      116         undo, return error substitute( "Не найдена запись пользователя. БД:&1 Логин: &2"
      117                                      , v-cntxt-db-num
      118                                      , v-login
      119                                      ) .
      120       end.
      121       assign
      122         v-cntxt-userid  = buf_user-login.user-id
      123         v-date-from     = p-date-from
      124         v-date-to       = p-date-to
      125       .
      126       run rep/chk-ahz.p (
      127             input        p-obj-type
      128           , input        p-obj-code
      129           , input        yes
      130           , input        p-verify-arh
      131           , input        p-verify-ahsp
      132           , input        p-verify-aht
      133           , input        if g#auto then no else yes
      134           , input        v-cntxt-db-num
      135           , input        v-cntxt-userid
      136           , input-output v-date-from
      137           , input-output v-date-to
      138           , output       p-archive-ok
      139           , output       p-comment
      140           , output       v-can-print
      141       ) no-error .
      142       if error-status :error
      143       then do:
      144           undo, return error substitute( "Ошибка при вызове программы chk-ahz.p. &1. &2. &3"
      145               , return-value
      146               , trim(error-status :get-message(1))
      147               , trim(error-status :get-message(2))
      148           ) .
      149       end.
      150       if v-date-from <> p-date-from
      151       or v-date-to   <> p-date-to
      152       then do:
      153           assign
      154               p-archive-ok = no
      155               p-comment    = substitute( "Выгрузка не может быть произведена. &1", p-comment )
      156           .
      157       end.
      158   end.
