        1   define input parameter parparentproc as widget-handle no-undo .
        2   define output parameter p-num as character no-undo format "X(20)" .
        3   define output parameter p-date as date no-undo .
        4   define output parameter p-type as character no-undo format "X(20)" .
        5   define output parameter p-ok as logical no-undo initial no .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Создание акта о списании ЕГАИС".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define new global shared variable g#language as character no-undo .
      112   if g#language <> '' and g#language <> 'rus':U then do:
      113     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      114   end.
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116     define variable v-cntxt-db-num        as integer   no-undo .
      117     define variable v-cntxt-userid        as character no-undo .
      118     define variable v-cntxt-level         as character no-undo .
      119     define variable v-cntxt-host-code-obj as integer   no-undo .
      120     define variable v-cntxt-obj-type      as character no-undo .
      121     define variable v-cntxt-obj-code      as integer   no-undo .
      122     define variable v-cntxt-db-num-obj    as integer   no-undo .
      123     define variable v-cntxt-is-admin      as logical   no-undo .
      124   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125     run mainmenu_getcntxt in parparentproc
      126       (output v-cntxt-db-num
      127       ,output v-cntxt-userid
      128       ,output v-cntxt-level
      129       ,output v-cntxt-host-code-obj
      130       ,output v-cntxt-obj-type
      131       ,output v-cntxt-obj-code
      132       ,output v-cntxt-db-num-obj
      133       ,output v-cntxt-is-admin
      134       ) .
      135   define buffer buf_clob-bind     for ub.clob-bind .
      136   define variable v-date              as character no-undo .
      137   DEFINE BUTTON b-cancel AUTO-END-KEY
      138        LABEL "Отмена"
      139        SIZE 15 BY 1.14
      140        BGCOLOR 8 .
      141   DEFINE BUTTON b-ok AUTO-GO
      142        LABEL "Ввод"
      143        SIZE 15 BY 1.14
      144        BGCOLOR 8 .
      145   DEFINE FRAME Dialog-Frame
      146        b-ok AT ROW 1.24 COL 2
      147        b-cancel AT ROW 1.24 COL 17
      148        p-num at row 2.5 col 2 format "X(20)"  label "Номер"
      149        p-date at row 2.5 col 32   label "Дата"
      150        p-type at row 2.5 col 51   label "Основание списания"
      151           view-as combo-box inner-lines 7
      152           list-items "Пересортица,Недостача,Уценка,Порча,Потери,Проверки,Арест"
      153           DROP-DOWN-LIST
      154        SPACE(0.5) SKIP(0.5)
      155       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      156            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      157            TITLE "Акт о списании"
      158            DEFAULT-BUTTON b-ok CANCEL-BUTTON b-cancel WIDGET-ID 100.
      159   ASSIGN
      160          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      161          FRAME Dialog-Frame:HIDDEN           = TRUE.
      162   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      163   DO:
      164     APPLY "END-ERROR":U TO SELF.
      165   END.
      166   ON VALUE-CHANGED OF p-type IN FRAME Dialog-Frame
      167   DO:
      168     assign p-type.
      169   END.
      170   ON CHOOSE OF b-ok IN FRAME Dialog-Frame
      171   DO:
      172       assign
      173           p-num
      174           p-date
      175           p-type
      176       .
      177       find first buf_clob-bind no-lock where buf_clob-bind.uniq-key-rec = p-num
      178                                          and buf_clob-bind.field-name_  = 'egais-awo':U no-error .
      179       if available buf_clob-bind then do :
      180           message "Акт с таким номером уже существует!" view-as alert-box .
      181           return no-apply .
      182       end.
      183       p-ok = yes .
      184   END.
      185   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      186   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      187   MAIN-BLOCK:
      188   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      189      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      190     assign p-type:list-items = "Пересортица,Недостача,Уценка,Порча,Потери,Проверки,Арест,Иные цели,Реализация" .
      191     assign v-date = substitute ("&1&2&3", string (day (now), "99"), string (month (now), "99"),substring (string(year (now)), 3,2)).
      192     assign
      193       p-num = "AWO-" + v-date + '-' + substring(v-cntxt-obj-type,1,1) + string(v-cntxt-obj-code) + '-' + string(int(TIME))
      194       p-date = TODAY
      195       p-type = "Недостача"
      196     .
      197     display p-num p-date p-type with frame Dialog-Frame.
      198     enable  p-date p-type with frame Dialog-Frame.
      199     RUN enable_UI.
      200     WAIT-FOR GO OF FRAME Dialog-Frame.
      201   END.
      202   RUN disable_UI.
      203   PROCEDURE disable_UI :
      204     HIDE FRAME Dialog-Frame.
      205   END PROCEDURE.
      206   PROCEDURE enable_UI :
      207     ENABLE b-ok b-cancel
      208         WITH FRAME Dialog-Frame.
      209     VIEW FRAME Dialog-Frame.
      210   END PROCEDURE.
