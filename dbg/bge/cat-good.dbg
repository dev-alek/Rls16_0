      535                       end.
      536                       when chr(7)
      537                       then do:
      538                           assign
      539                               p-out-string = p-out-string + " ":U
      540                           .
      541                       end.
      542                       when chr(8)
      543                       then do:
      544                           assign
      545                               p-out-string = p-out-string + " ":U
      546                           .
      547                       end.
