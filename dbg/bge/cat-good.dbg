     4904       define variable v-ext-doc-type      as character        no-undo.
     4905       define variable v-trn-doc-recid     as recid            no-undo.
     4906       define variable varchip-code        as integer          no-undo.
     4907       define variable varchip-code2       as integer          no-undo.
     4908       define variable v-chip-counter      as integer          no-undo.
     4909       define buffer buf_trn-doc       for ub.trn-doc.
