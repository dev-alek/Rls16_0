     4941           , input p-doc-type
     4942           , output v-doc-code
     4943       ).
     4944       find first buf_trn-doc no-lock
     4945            where buf_trn-doc.doc-code = v-doc-code
     4946       no-error.
     4947       if not available buf_trn-doc
     4948       then do:
     4949           if p-doc-type <> 'спи':U
     4950           then do:
     4951               message
     4952                   "Не найден документ '" p-doc-type "'"
     4953                   "по документу производства " p-fbr-doc-code
     4954               view-as alert-box.
     4955               undo, return error.
     4956           end.
     4957           else do:
     4958           end.
     4959       end.
     4960       else do:
     4961           assign
     4962               v-trn-doc-recid = recid( buf_trn-doc )
     4963               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     4964           .
     4965           if v-ext-doc-type = 'ev':U
     4966           then do:
     4967               find first buf_pri_trn-doc no-lock
     4968                    where buf_pri_trn-doc.out-code     = v-doc-code
     4969                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     4970               no-error.
     4971               if available buf_pri_trn-doc
     4972               then do:
     4973                   run str/del-doc.p (
     4974                         input parparentproc
     4975                       , input buf_pri_trn-doc.doc-code
     4976                       , input v-cntxt-db-num
     4977                       , input "delfbr.err"
     4978                       , input ?
     4979                       , input p-fbr-doc-code
     4980                       , input v-cntxt-userid
     4981                       , input 0
     4982                       , input (if p-ph-chip-num <> ?
     4983                               then p-ph-chip-num
     4984                               else (if varchip-code <> 0
     4985                                   then varchip-code
     4986                                   else ?)
     4987                               )
     4988                       , output varchip-code2
     4989                   ) no-error.
     4990                   if error-status :error
     4991                   then do:
     4992                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     4993                                                   ,buf_pri_trn-doc.doc-code
     4994                                                   ,p-fbr-doc-code
     4995                                                   , chr(10)
     4996                                                   , error-status:get-message(1)
     4997                                                   , return-value ).
     4998                   end.
     4999               end.
     5000           end.
     5001           define buffer buf_out_trn-doc       for ub.trn-doc.
     5002           if p-doc-type = 'при':U
     5003           then do:
     5004               assign
     5005                   v-chip-counter = 0
     5006               .
     5007               for each buf_out_trn-doc exclusive-lock
     5008                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     5009               on error undo, return error
     5010               :
     5011                   assign
     5012                       v-chip-counter = v-chip-counter + 1
     5013                   .
     5014                   if v-chip-counter > 1
     5015                   then do:
     5016                       assign
     5017                           varchip-code = varchip-code2
     5018                       .
     5019                   end.
     5020                   run str/del-doc.p (
     5021                         input parparentproc
     5022                       , input buf_out_trn-doc.doc-code
     5023                       , input v-cntxt-db-num
     5024                       , input "delfbr.err"
     5025                       , input ?
     5026                       , input p-fbr-doc-code
     5027                       , input v-cntxt-userid
     5028                       , input 0
     5029                       , input (if p-ph-chip-num <> ?
     5030                               then p-ph-chip-num
     5031                               else (if varchip-code <> 0
     5032                                   then varchip-code
     5033                                   else ?)
     5034                               )
     5035                       , output varchip-code2
     5036                   ) no-error.
     5037                   if error-status :error
     5038                   then do:
     5039                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     5040                                                   ,buf_out_trn-doc.doc-code
     5041                                                   ,buf_trn-doc.doc-code
     5042                                                   ,p-fbr-doc-code
     5043                                                   , chr(10)
     5044                                                   , error-status:get-message(1)
     5045                                                   , return-value ).
     5046                   end.
     5047               end.
     5048           end.
     5049           run str/del-doc.p (
     5050                 input parparentproc
     5051               , input buf_trn-doc.doc-code
     5052               , input v-cntxt-db-num
     5053               , input "delfbr.err"
     5054               , input ?
     5055               , input p-fbr-doc-code
     5056               , input v-cntxt-userid
     5057               , input 0
     5058               , input (if p-ph-chip-num <> ?
     5059                        then p-ph-chip-num
     5060                        else (if varchip-code <> 0
     5061                              then varchip-code
     5062                              else ?)
     5063                        )
     5064               , output varchip-code2
     5065           ) no-error.
     5066           if error-status :error
     5067           then do:
     5068               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     5069                                             ,buf_trn-doc.doc-code
     5070                                             ,p-fbr-doc-code
     5071                                             , chr(10)
     5072                                             , error-status:get-message(1)
     5073                                             , return-value ).
     5074           end.
     5075           if p-doc-type = 'рас':U
     5076           or p-doc-type = 'спи':U
     5077           then do:
     5078               assign
     5079                   v-chip-counter = 0
     5080               .
     5081               for each buf_cons_trn-doc no-lock
     5082                  where buf_cons_trn-doc.out-code      = v-doc-code
     5083                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     5084               :
     5085                   assign
     5086                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     5087                       v-chip-counter = v-chip-counter + 1
     5088                   .
     5089                   assign
     5090                   varchip-code = if v-chip-counter = 2
     5091                                  then varchip-code2
     5092                                  else varchip-code.
     5093                   run str/del-doc.p (
     5094                         input parparentproc
     5095                       , input buf_cons_trn-doc.doc-code
     5096                       , input v-cntxt-db-num
     5097                       , input "delfbr.err"
     5098                       , input ?
     5099                       , input ?
     5100                       , input v-cntxt-userid
     5101                       , input 0
     5102                       , input (if p-ph-chip-num <> ?
     5103                                then p-ph-chip-num
     5104                                else ( if v-chip-counter = 1
     5105                                       then ?
     5106                                       else varchip-code )
     5107                                )
     5108                       , output varchip-code2
     5109                   ) no-error.
     5110                   if error-status :error
     5111                   then do:
     5112                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     5113                                                     ,buf_cons_trn-doc.doc-code
     5114                                                     ,p-fbr-doc-code
     5115                                                     , chr(10)
     5116                                                     , error-status:get-message(1)
     5117                                                     , return-value ).
     5118                   end.
     5119                   assign
     5120                       p-chip-num = varchip-code2
     5121                   .
     5122               end.
     5123           end.
     5124           assign
     5125               p-chip-num = varchip-code2
     5126           .
     5127       end.
     5128   end.
     5129   END PROCEDURE.
     5130   PROCEDURE fbrlib-print-del-error-message :
     5131   do
     5132   on error undo, return error
     5133   :
     5134       define variable v-user-action   as character    no-undo.
     5135       define variable v-printed       as logical      no-undo.
     5136       message
     5137           vss-workfile vss-revision vss-description
     5138           skip "Ошибка при удалении документа."
     5139           skip return-value
     5140           skip trim(error-status :get-message(1))
     5141           skip trim(error-status :get-message(2))
     5142           skip trim(error-status :get-message(3))
     5143       view-as alert-box error.
     5144       if search ("delfbr.err") <> ?
     5145       then do:
     5146         run gbl/prnfilen.w
     5147           (input  "Ошибки при удалении документа производства"
     5148           ,input  0
     5149           ,input  "delfbr.err"
     5150           ,input  7
     5151           ,output v-user-action
     5152           ,output v-printed
     5153           ).
     5154       end.
     5155   end.
     5156   END PROCEDURE.
     5157   procedure fbrlib-calc-brutto :
     5158   define input parameter p-recipe-type        as character        no-undo.
     5159   define input parameter p-netto              as decimal          no-undo.
     5160   define input parameter p-coeff-value        as decimal          no-undo.
     5161   define input parameter p-coeff-waste        as decimal          no-undo.
     5162   define input parameter p-brutto             as decimal          no-undo.
     5163   define input parameter p-calc-method        as integer          no-undo.
     5164   define output parameter p-new-netto         as decimal          no-undo.
     5165   define output parameter p-new-coeff-waste   as decimal          no-undo.
     5166   define output parameter p-new-brutto        as decimal          no-undo.
     5167   define output parameter p-new-calc-method   as integer          no-undo.
     5168   do
     5169   on error undo, return error
     5170   :
     5171       if p-recipe-type <> 'производство':U
     5172       then do:
     5173           assign
     5174               p-new-coeff-waste = 0
     5175               p-new-calc-method = 1
     5176               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     5177               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     5178           .
     5179       end.
     5180       else do:
     5181           assign
     5182               p-new-calc-method = p-calc-method
     5183           .
     5184           if p-coeff-waste = 0
     5185           then do:
     5186               assign
     5187                   p-coeff-value = 0
     5188               .
     5189           end.
     5190           case p-calc-method
     5191           :
     5192               when 1
     5193               then do:
     5194                   assign
     5195                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     5196                       p-new-coeff-waste   = p-coeff-waste
     5197                       p-new-brutto        = p-brutto
     5198                   .
     5199               end.
     5200               when 2
     5201               then do:
     5202                   assign
     5203                       p-new-netto         = p-netto
     5204                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     5205                       p-new-brutto        = p-brutto
     5206                   .
     5207               end.
     5208               when 3
     5209               then do:
     5210                   assign
     5211                       p-new-netto         = p-netto
     5212                       p-new-coeff-waste   = p-coeff-waste
     5213                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     5214                   .
     5215               end.
     5216               otherwise do:
     5217                   define variable v-yesno    as logical      no-undo.
     5218                   assign
     5219                       v-yesno = yes
     5220                   .
     5221                   message
     5222                       "Неверный метод для расчета брутто, нетто и процента потерь."
     5223                       skip "Значение метода должно быть 1, 2 или 3."
     5224                       skip(1)
     5225                       skip "Заданное значение:" p-calc-method
     5226                       skip(1)
     5227                       skip "Установить значение метода расчета 1"
     5228                       skip "(расчет нетто по брутто и проценту потерь)?"
     5229                   view-as alert-box warning
     5230                   buttons yes-no
     5231                   title "Неверное значение метода пересчета в строках документа-производства"
     5232                   update v-yesno
     5233                   .
     5234                   if v-yesno = yes
     5235                   then do:
     5236                       assign
     5237                           p-new-calc-method   = 1
     5238                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     5239                           p-new-coeff-waste   = p-coeff-waste
     5240                           p-new-brutto        = p-brutto
     5241                       .
     5242                   end.
     5243                   else do:
     5244                       message
     5245                               vss-workfile vss-revision vss-description
     5246                           skip(1)
     5247                           skip "Ошибка расчета брутто, нетто и процента потерь."
     5248                           skip return-value
     5249                           skip trim(error-status :get-message(1))
     5250                               trim(error-status :get-message(2))
     5251                               trim(error-status :get-message(3))
     5252                       view-as alert-box error
     5253                       title "Неверное значение метода расчета"
     5254                       .
     5255                       undo, return error .
     5256                   end.
     5257               end.
     5258           end case.
     5259       end.
     5260   end.
     5261   end procedure.
     5262   procedure fbrlib-check-brutto :
     5263   define input parameter p-recipe-type        as character        no-undo.
     5264   define input parameter p-netto              as decimal          no-undo.
     5265   define input parameter p-coeff-value        as decimal          no-undo.
     5266   define input parameter p-coeff-waste        as decimal          no-undo.
     5267   define input parameter p-brutto             as decimal          no-undo.
     5268   define input parameter p-calc-method        as integer          no-undo.
     5269   define output parameter p-error-message     as character        no-undo.
     5270   define output parameter p-not-good          as logical          no-undo.
     5271   do
     5272   on error undo, return error
     5273   :
     5274       if p-recipe-type <> 'производство':U
     5275       then do:
     5276           if p-netto <> p-brutto
     5277           or p-coeff-waste <> 0
     5278           then do:
     5279               assign
     5280                   p-not-good      = yes
     5281                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     5282                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     5283               .
     5284           end.
     5285       end.
     5286       else do:
     5287           if p-coeff-waste = 0
     5288           then do:
     5289               assign
     5290                   p-coeff-value = 0
     5291               .
     5292           end.
     5293           case p-calc-method
     5294           :
     5295               when 1
     5296               then do:
     5297                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     5298                   then do:
     5299                       assign
     5300                           p-not-good      = yes
     5301                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     5302                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     5303                       .
     5304                   end.
     5305               end.
     5306               when 2
     5307               then do:
     5308                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     5309                   then do:
     5310                       assign
     5311                           p-not-good      = yes
     5312                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     5313                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     5314                       .
     5315                   end.
     5316               end.
     5317               when 3
     5318               then do:
     5319                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     5320                   then do:
     5321                       assign
     5322                           p-not-good      = yes
     5323                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     5324                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     5325                       .
     5326                   end.
     5327               end.
     5328               otherwise do:
     5329                   assign
     5330                       p-not-good      = yes
     5331                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     5332                   .
     5333               end.
     5334           end case.
     5335       end.
     5336   end.
     5337   end procedure.
     5338   procedure fbrlib-check-fbr-recipe :
     5339   define input parameter p-doc-code       as character        no-undo.
     5340   define input parameter p-recipe-code    as character        no-undo.
     5341   define output parameter p-is-correct    as logical          no-undo.
     5342       define variable v-comp-factor    as decimal      no-undo.
     5343       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     5344       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     5345       define buffer buf_fbr-line          for ub.fbr-line.
     5346   do
     5347   for buf_fbr-recipe
     5348     , buf_fbr-recipe-gds
     5349     , buf_fbr-line
     5350   on error undo, return error
     5351   :
     5352       assign
     5353           p-is-correct = yes
     5354       .
     5355       find first buf_fbr-recipe no-lock
     5356            where buf_fbr-recipe.doc-code    = p-doc-code
     5357              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     5358       .
     5359       if not available buf_fbr-recipe then do:
     5360         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     5361       end.
     5362       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     5363       then do:
     5364       end.
     5365       else do:
     5366           find first buf_fbr-line no-lock
     5367                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     5368                  and buf_fbr-line.is-comp     = yes
     5369                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     5370                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     5371                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     5372                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     5373           .
     5374           assign
     5375               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     5376           .
     5377           recipe-line-cycle:
     5378           for each buf_fbr-recipe-gds no-lock
     5379              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     5380                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     5381           on error undo, return error
     5382           :
     5383               find first buf_fbr-line no-lock
     5384                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     5385                      and buf_fbr-line.is-comp     = no
     5386                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     5387                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     5388                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     5389                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     5390               .
     5391               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     5392               then do:
     5393                   assign
     5394                       p-is-correct = no
     5395                   .
     5396                   leave recipe-line-cycle.
     5397               end.
     5398           end.
     5399       end.
     5400   end.
     5401   end procedure.
     5402   procedure fbrlib-get-recipe-type :
     5403   define input parameter p-fbr-doc-code   as character        no-undo.
     5404   define input parameter p-recipe-code    as character        no-undo.
     5405   define output parameter p-recipe-type   as character        no-undo.
     5406       define buffer buf_recipe        for ub.recipe.
     5407       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     5408   do
     5409   for buf_recipe
     5410     , buf_fbr-recipe
     5411   on error undo, return error
     5412   :
     5413       if p-fbr-doc-code = ""
     5414       then do:
     5415           find first buf_recipe no-lock
     5416                where buf_recipe.recipe-code = p-recipe-code
     5417           no-error.
     5418           if available buf_recipe
     5419           then do:
     5420               assign
     5421                   p-recipe-type = buf_recipe.recipe-type
     5422               .
     5423           end.
     5424           else do:
     5425               assign
     5426                   p-recipe-type = "":U
     5427               .
     5428           end.
     5429       end.
     5430       else do:
     5431           find first buf_fbr-recipe no-lock
     5432                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     5433                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     5434           no-error.
     5435           if available buf_fbr-recipe
     5436           then do:
     5437               assign
     5438                   p-recipe-type = buf_fbr-recipe.recipe-type
     5439               .
     5440           end.
     5441           else do:
     5442               assign
     5443                   p-recipe-type = "":U
     5444               .
     5445           end.
     5446       end.
     5447   end.
     5448   end procedure.
     5449   PROCEDURE calc-comp-from-ingr :
     5450   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     5451   define input parameter p-fact-qnty                          as decimal      no-undo.
     5452   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     5453   define output parameter p-comp-qnty                         as decimal      no-undo.
     5454       define variable v-ingr-qnty     as decimal       no-undo.
     5455       define buffer buf_i_fbr-line    for ub.fbr-line.
     5456       define buffer buf_fbr-line      for ub.fbr-line.
     5457       define buffer buf_recipe        for ub.fbr-recipe.
     5458       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     5459   do
     5460   for buf_i_fbr-line
     5461     , buf_fbr-line
     5462     , buf_recipe
     5463     , buf_recipe-gds
     5464   on error undo, return error
     5465   :
     5466       find first buf_i_fbr-line no-lock
     5467            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     5468       .
     5469       find first buf_recipe no-lock
     5470            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     5471              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     5472       no-error.
     5473       if not available buf_recipe
     5474       then do:
     5475           message
     5476                   vss-workfile vss-revision vss-description
     5477               skip "В строке производства не указан рецепт."
     5478               skip "Невозможно рассчитать количество составного товара."
     5479               skip return-value
     5480               skip trim(error-status :get-message(1))
     5481                   trim(error-status :get-message(2))
     5482                   trim(error-status :get-message(3))
     5483           view-as alert-box error.
     5484           undo, return error .
     5485       end.
     5486       if buf_recipe.recipe-type = 'альтернатива':U
     5487       then do:
     5488           for each buf_fbr-line no-lock
     5489              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     5490                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     5491                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     5492           on error undo, return error
     5493           :
     5494               find first buf_recipe-gds no-lock
     5495                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     5496                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     5497                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     5498                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     5499                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     5500               .
     5501               assign
     5502                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     5503               .
     5504           end.
     5505           assign
     5506               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     5507           .
     5508       end.
     5509       else do:
     5510           find first buf_recipe-gds no-lock
     5511                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     5512                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     5513                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     5514                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     5515                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     5516           .
     5517           assign
     5518               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     5519           .
     5520       end.
     5521       find first buf_fbr-line no-lock
     5522            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     5523              and buf_fbr-line.is-comp     = yes
     5524              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     5525       .
     5526       assign
     5527           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     5528       .
     5529   end.
     5530   END PROCEDURE.
     5531   PROCEDURE get-temp_dressing-ingr-used-qnty :
     5532   define input parameter p-recipe-code    as character    no-undo.
     5533   define input parameter p-gds-code       as integer      no-undo.
     5534   define output parameter p-line-qnty     as decimal      no-undo.
     5535   define output parameter p-used-qnty     as decimal      no-undo.
     5536   define output parameter p-recipe-qnty   as decimal      no-undo.
     5537       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     5538   do
     5539   for buf_temp_dressing-ingr
     5540   on error undo, return error
     5541   :
     5542       find first buf_temp_dressing-ingr no-lock
     5543            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     5544              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     5545       no-error.
     5546       if available buf_temp_dressing-ingr
     5547       then do:
     5548           assign
     5549               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     5550               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     5551               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     5552           .
     5553       end.
     5554       else do:
     5555           assign
     5556               p-line-qnty     = 0
     5557               p-used-qnty     = 0
     5558               p-recipe-qnty   = 0
     5559           .
     5560       end.
     5561   end.
     5562   END PROCEDURE.
     5563   PROCEDURE fbrlib_adjust-recipe :
     5564   do
     5565   on error undo, return error
     5566   :
     5567   define input parameter parparentproc as widget-handle no-undo .
     5568   define input parameter p-fbrhist-handle as handle no-undo .
     5569   define input parameter p-doc-code       as character    no-undo.
     5570   define input parameter p-recipe-code    as character    no-undo.
     5571   define input parameter p-price-sale-obj-type as character no-undo .
     5572   define input parameter p-price-sale-obj-code as integer no-undo .
     5573       define variable v-recipe-qnty       as decimal      no-undo.
     5574       define variable v-comp-qnty         as decimal      no-undo.
     5575       define variable v-recipe-gds-qnty   as decimal      no-undo.
     5576       define variable v-ingr-qnty         as decimal      no-undo.
     5577       define variable v-qnty              as decimal      no-undo.
     5578       define variable v-coeff-waste       as decimal      no-undo.
     5579       define variable v-brutto-qnty       as decimal      no-undo.
     5580       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     5581       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     5582       define buffer buf_fbr-line          for ub.fbr-line.
     5583       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     5584       find first buf_fbr-recipe no-lock
     5585            where buf_fbr-recipe.doc-code      = p-doc-code
     5586              and buf_fbr-recipe.recipe-code   = p-recipe-code
     5587       .
     5588       assign
     5589           v-recipe-qnty = buf_fbr-recipe.qnty
     5590       .
     5591       find first buf_fbr-line no-lock
     5592            where buf_fbr-line.doc-code    = p-doc-code
     5593              and buf_fbr-line.is-comp     = yes
     5594              and buf_fbr-line.recipe-code = p-recipe-code
     5595       .
     5596       assign
     5597           v-comp-qnty = buf_fbr-line.fact-qnty
     5598       .
     5599       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     5600       then do:
     5601       end.
     5602       else do:
     5603           for each buf_fbr-recipe-gds no-lock
     5604              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     5605                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     5606           on error undo, return error
     5607           :
     5608               find first buf_fbr-line no-lock
     5609                    where buf_fbr-line.doc-code    = p-doc-code
     5610                      and buf_fbr-line.is-comp     = no
     5611                      and buf_fbr-line.recipe-code = p-recipe-code
     5612                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     5613                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     5614                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     5615               .
     5616               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     5617               then do:
     5618                   do transaction
     5619                   on error undo, return error
     5620                   :
     5621                       find first buf_el_fbr-recipe-gds exclusive-lock
     5622                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     5623                       .
     5624                       assign
     5625                           buf_el_fbr-recipe-gds.calc-method   = 1
     5626                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     5627                       .
     5628                       run fbrlib-calc-brutto in this-procedure (
     5629                             input buf_fbr-recipe.recipe-type
     5630                           , input 0
     5631                           , input buf_el_fbr-recipe-gds.coeff-value
     5632                           , input buf_el_fbr-recipe-gds.coeff-waste
     5633                           , input buf_el_fbr-recipe-gds.brutto-qnty
     5634                           , input 1
     5635                           , output buf_el_fbr-recipe-gds.qnty
     5636                           , output buf_el_fbr-recipe-gds.coeff-waste
     5637                           , output buf_el_fbr-recipe-gds.brutto-qnty
     5638                           , output buf_el_fbr-recipe-gds.calc-method
     5639                       ).
     5640                   end.
     5641               end.
     5642           end.
     5643           run fbrlib_adjust-doc-lines in this-procedure (
     5644                 input parparentproc
     5645               , input p-fbrhist-handle
     5646               , input p-doc-code
     5647               , input p-recipe-code
     5648               , input p-price-sale-obj-type
     5649               , input p-price-sale-obj-code
     5650           ).
     5651       end.
     5652   end.
     5653   END PROCEDURE.
     5654   PROCEDURE fbrlib_adjust-doc-lines :
     5655   define input parameter parparentproc as widget-handle no-undo .
     5656   define input parameter p-fbrhist-handle as handle no-undo .
     5657   define input parameter p-doc-code       as character    no-undo.
     5658   define input parameter p-recipe-code    as character    no-undo.
     5659   define input parameter p-price-sale-obj-type as character no-undo .
     5660   define input parameter p-price-sale-obj-code as integer no-undo .
     5661   define variable v-comp-qnty         as decimal      no-undo.
     5662   define variable v-trn-type          as character    no-undo.
     5663   define variable v-ingr-qnty         as decimal      no-undo.
     5664   define variable v-recipe-qnty       as decimal      no-undo.
     5665   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     5666   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     5667   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     5668   define buffer buf_fbr-line          for ub.fbr-line.
     5669   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     5670   define buffer buf_goods             for ub.goods.
     5671   define buffer buf_fbr-doc           for ub.fbr-doc.
     5672   do
     5673   for buf_fbr-recipe
     5674     , buf_fbr-recipe-gds
     5675     , buf_fbr-line
     5676     , buf_coeff_fbr-line
     5677     , buf_goods
     5678     , buf_fbr-doc
     5679   on error undo, return error
     5680   :
     5681       find first buf_fbr-line no-lock
     5682            where buf_fbr-line.doc-code      = p-doc-code
     5683              and buf_fbr-line.is-comp       = yes
     5684              and buf_fbr-line.recipe-code   = p-recipe-code
     5685       .
     5686       find first buf_fbr-doc no-lock
     5687            where buf_fbr-doc.doc-code      = p-doc-code
     5688       .
     5689       assign
     5690           v-comp-qnty = buf_fbr-line.fact-qnty
     5691           v-trn-type  = buf_fbr-line.trn-type
     5692       .
     5693       find first buf_fbr-recipe no-lock
     5694            where buf_fbr-recipe.doc-code    = p-doc-code
     5695              and buf_fbr-recipe.recipe-code = p-recipe-code
     5696       .
     5697       assign
     5698       v-recipe-qnty = buf_fbr-recipe.qnty
     5699       .
     5700       do transaction
     5701       on error undo, return error
     5702       :
     5703           for each buf_fbr-recipe-gds no-lock
     5704              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     5705                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     5706           on error undo, return error
     5707           :
     5708               find first buf_fbr-line no-lock
     5709                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     5710                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     5711                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     5712                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     5713                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     5714               no-error.
     5715               if not available buf_fbr-line
     5716               then do:
     5717                   find first buf_goods no-lock
     5718                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     5719                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     5720                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     5721                   .
     5722                   run str/fbr-crln.p (
     5723                         input parparentproc
     5724                       , input recid( buf_fbr-doc )
     5725                       , input recid( buf_goods )
     5726                       , input buf_fbr-recipe-gds.recipe-code
     5727                       , input v-trn-type
     5728                       , input no
     5729                       , input no
     5730                       , input buf_fbr-doc.obj-type
     5731                       , input buf_fbr-doc.obj-code
     5732                       , output v-fbr-v-fbr-doc-line-recid
     5733                   ).
     5734                   find first buf_fbr-line no-lock
     5735                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     5736                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     5737                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     5738                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     5739                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     5740                   no-error.
     5741                   if not available buf_fbr-line
     5742                   then do:
     5743                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     5744                                                      , p-doc-code
     5745                                                      , buf_fbr-recipe-gds.artic
     5746                                                      , buf_fbr-recipe-gds.prod-type
     5747                                                      , buf_fbr-recipe-gds.prod-code).
     5748                   end.
     5749               end.
     5750               find first buf_coeff_fbr-line exclusive-lock
     5751                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     5752               .
     5753               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     5754               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     5755               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     5756               then do:
     5757                   assign
     5758                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     5759                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     5760                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     5761                   .
     5762               end.
     5763           end.
     5764       end.
     5765       define variable v-need-goods    as logical       no-undo.
     5766       define variable v-need-goods-list       as character     no-undo.
     5767       define variable v-need-goods-qnty-list  as character     no-undo.
     5768       find first buf_fbr-line no-lock
     5769            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     5770              and buf_fbr-line.is-comp     = yes
     5771              and buf_fbr-line.recipe-code = p-recipe-code
     5772       .
     5773       run str/fbr-qnty.p (
     5774             input parparentproc
     5775           , input p-fbrhist-handle
     5776           , input recid( buf_fbr-doc )
     5777           , input recid( buf_fbr-line )
     5778           , input no
     5779           , input "ingr"
     5780           , input no
     5781           , input p-price-sale-obj-type
     5782           , input p-price-sale-obj-code
     5783           , input no
     5784           , input no
     5785           , input no
     5786           , output v-need-goods
     5787           , output v-need-goods-list
     5788           , output v-need-goods-qnty-list
     5789       ).
     5790   end.
     5791   END PROCEDURE.
     5792   procedure fbrlib_check-before-close :
     5793   define input parameter p-doc-code as character no-undo .
     5794   define variable same-sale as decimal no-undo .
     5795   define variable is-waste as logical no-undo .
     5796   define variable fix-price as logical no-undo .
     5797   define buffer buf_fbr-doc for ub.fbr-doc.
     5798   define buffer buf_fbr-line for ub.fbr-line.
     5799   define buffer buf_goods for ub.goods.
     5800   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     5801   do
     5802   on error undo, return error
     5803   :
     5804     for each buf_fbr-line no-lock
     5805         where buf_fbr-line.doc-code = p-doc-code
     5806       , each buf_goods no-lock
     5807         where buf_goods.artic     = buf_fbr-line.artic
     5808           and buf_goods.prod-type = buf_fbr-line.prod-type
     5809           and buf_goods.prod-code = buf_fbr-line.prod-code
     5810     break by buf_fbr-line.prod-type
     5811           by buf_fbr-line.prod-code
     5812           by buf_fbr-line.artic
     5813     :
     5814       if first-of (buf_fbr-line.artic)
     5815       then do:
     5816         assign
     5817         same-sale = buf_fbr-line.price-sale
     5818         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     5819         fix-price = buf_fbr-line.is-calc
     5820         .
     5821       end.
     5822       if same-sale <> buf_fbr-line.price-sale
     5823       then do:
     5824           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     5825                                         ,p-doc-code
     5826                                         ,buf_goods.artic
     5827                                         ,buf_goods.gds-name
     5828                                         ,chr(10)).
     5829       end.
     5830       if fix-price <> buf_fbr-line.is-calc then do:
     5831           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     5832                                         ,p-doc-code
     5833                                         ,buf_goods.artic
     5834                                         ,buf_goods.gds-name
     5835                                         ,chr(10)).
     5836       end.
     5837       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     5838       then do:
     5839         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     5840                                         ,p-doc-code
     5841                                         ,buf_goods.artic
     5842                                         ,buf_goods.gds-name
     5843                                         ,chr(10)).
     5844       end.
     5845       if buf_fbr-line.rsrv-qnty <> ?
     5846       and buf_goods.gds-type <> 'у':U
     5847       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     5848       and buf_fbr-line.fact-qnty <> 0
     5849       then do:
     5850         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     5851           if  can-find(first buf_fbr-gds-obj no-lock where
     5852                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     5853               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     5854               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     5855               and buf_fbr-gds-obj.is-null-price  )  then .
     5856                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     5857                                         ,p-doc-code
     5858                                         ,buf_goods.artic
     5859                                         ,buf_goods.gds-name
     5860                                         ,chr(10)
     5861                                         ,buf_fbr-line.recipe-code
     5862                                         ).
     5863         end.
     5864         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     5865                                         ,p-doc-code
     5866                                         ,buf_goods.artic
     5867                                         ,buf_goods.gds-name
     5868                                         ,chr(10)
     5869                                         ,buf_fbr-line.recipe-code
     5870                                         ).
     5871       end.
     5872     end.
     5873   end.
     5874   end procedure.
     5875   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5876   define  temp-table temp-host no-undo
     5877     field host-code like ub.store.host-code
     5878     index xpk host-code
     5879   .
     5880   define  temp-table temp-obj no-undo
     5881     field obj-type  like ub.clients.obj-type
     5882     field obj-code  like ub.clients.obj-code
     5883     field host-code like ub.store.host-code
     5884     field db-num    like ub.clients.db-num
     5885     index xpk  obj-type obj-code
     5886     index xie1 host-code
     5887     index xie2 db-num host-code
     5888   .
     5889   procedure init-temphost:
     5890     define buffer buf_store   for ub.store .
     5891     define buffer buf_shop    for ub.shop .
     5892     define buffer buf_clients for ub.clients .
     5893     define buffer buf_db for ub.db .
     5894     define buffer buf_temp-host for temp-host .
     5895     define buffer buf_temp-obj for temp-obj .
     5896     do
     5897     on error undo, return error return-value
     5898     :
     5899       for each buf_store
     5900       on error undo, return error
     5901       :
     5902         find first buf_temp-host
     5903           where buf_temp-host.host-code = buf_store.host-code
     5904           no-error .
     5905         if not available buf_temp-host
     5906         then do:
     5907           create buf_temp-host .
     5908           assign
     5909             buf_temp-host.host-code = buf_store.host-code
     5910           .
     5911         end.
     5912         find first buf_clients no-lock
     5913           where buf_clients.obj-type = 'скл':U
     5914             and buf_clients.obj-code = buf_store.obj-code
     5915           no-error .
     5916         if not available buf_clients
     5917         then do:
     5918           message
     5919             "Ошибка при поиске клиента" skip
     5920             "Клиент" 'скл':U buf_store.obj-code skip
     5921             view-as alert-box error .
     5922           undo, return error .
     5923         end.
     5924         create buf_temp-obj .
     5925         assign
     5926           buf_temp-obj.obj-type  = 'скл':U
     5927           buf_temp-obj.obj-code  = buf_store.obj-code
     5928           buf_temp-obj.host-code = buf_store.host-code
     5929           buf_temp-obj.db-num    = buf_clients.db-num
     5930         .
     5931       end.
     5932       for each buf_shop
     5933       on error undo, return error
     5934       :
     5935         find first buf_temp-host
     5936           where buf_temp-host.host-code = buf_shop.host-code
     5937           no-error .
     5938         if not available buf_temp-host
     5939         then do:
     5940           create buf_temp-host .
     5941           assign
     5942             buf_temp-host.host-code = buf_shop.host-code
     5943           .
     5944         end.
     5945         find first buf_clients no-lock
     5946           where buf_clients.obj-type = 'маг':U
     5947             and buf_clients.obj-code = buf_shop.obj-code
     5948           no-error .
     5949         if not available buf_clients then do:
     5950           message
     5951             "Ошибка при поиске клиента" skip
     5952             "Клиент" 'маг':U buf_shop.obj-code skip
     5953             view-as alert-box error .
     5954           undo, return error .
     5955         end.
     5956         create buf_temp-obj .
     5957         assign
     5958           buf_temp-obj.obj-type  = 'маг':U
     5959           buf_temp-obj.obj-code  = buf_shop.obj-code
     5960           buf_temp-obj.host-code = buf_shop.host-code
     5961           buf_temp-obj.db-num    = buf_clients.db-num
     5962         .
     5963       end.
     5964     end.
     5965   end.
