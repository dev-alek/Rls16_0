     4916   on error undo, return error
     4917   :
     4918   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4919     define variable v-cntxt-db-num        as integer   no-undo .
     4920     define variable v-cntxt-userid        as character no-undo .
     4921     define variable v-cntxt-level         as character no-undo .
     4922     define variable v-cntxt-host-code-obj as integer   no-undo .
     4923     define variable v-cntxt-obj-type      as character no-undo .
     4924     define variable v-cntxt-obj-code      as integer   no-undo .
     4925     define variable v-cntxt-db-num-obj    as integer   no-undo .
     4926     define variable v-cntxt-is-admin      as logical   no-undo .
     4927   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4928     run mainmenu_getcntxt in parparentproc
     4929       (output v-cntxt-db-num
     4930       ,output v-cntxt-userid
     4931       ,output v-cntxt-level
     4932       ,output v-cntxt-host-code-obj
     4933       ,output v-cntxt-obj-type
     4934       ,output v-cntxt-obj-code
     4935       ,output v-cntxt-db-num-obj
     4936       ,output v-cntxt-is-admin
