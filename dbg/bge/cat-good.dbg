     3132   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     3133   do
     3134   on error undo, return error
     3135   :
     3136   define input parameter p-fbr-doc-code as character    no-undo.
     3137       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     3138       define variable v-gds-name      as character    no-undo.
     3139       define buffer buf_fbr-doc               for ub.fbr-doc.
     3140       define buffer buf_fbr-line              for ub.fbr-line.
     3141       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     3142       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     3143       find first buf_fbr-doc no-lock
     3144            where buf_fbr-doc.doc-code = p-fbr-doc-code
     3145       .
     3146       for each buf_temp_fbrlib_recipe
     3147       :
     3148           delete buf_temp_fbrlib_recipe.
     3149       end.
     3150       for each buf_fbr-line no-lock
     3151          where buf_fbr-line.doc-code = p-fbr-doc-code
     3152       :
     3153           find first buf_temp_fbrlib_recipe
     3154                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     3155           no-error.
     3156           if not available buf_temp_fbrlib_recipe
     3157           then do:
     3158               create buf_temp_fbrlib_recipe.
     3159               assign
     3160                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     3161                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     3162               .
     3163           end.
     3164       end.
     3165       for each buf_temp_fbrlib_recipe
     3166       :
     3167           assign
     3168               buf_temp_fbrlib_recipe.count-income                = 0
     3169               buf_temp_fbrlib_recipe.qnty-income                 = 0
     3170               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     3171               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     3172               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     3173               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     3174               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     3175               buf_temp_fbrlib_recipe.count-write-off             = 0
     3176               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     3177               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     3178               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     3179               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     3180               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     3181               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     3182           .
     3183           for each buf_fbr-line no-lock
     3184              where buf_fbr-line.doc-code     = p-fbr-doc-code
     3185                and buf_fbr-line.trn-type     = 'при':U
     3186                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     3187           :
     3188               if ( buf_fbr-line.price-base   = ?
     3189                   or buf_fbr-line.price-rubl = ?
     3190                   or buf_fbr-line.price-base <= 0
     3191                   or buf_fbr-line.price-rubl <= 0 )
     3192               and buf_fbr-line.fact-qnty <> 0
     3193               and buf_fbr-line.rsrv-qnty <> ?
     3194               and buf_fbr-doc.is-free    = no
     3195               then do:
     3196   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3197   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     3198     (input  buf_fbr-line.artic
     3199     ,input  buf_fbr-line.prod-type
     3200     ,input  buf_fbr-line.prod-code
     3201     ,output v-gds-name
     3202     ) no-error .
     3203                   if error-status :error
     3204                   then do:
     3205                       assign
     3206                           v-gds-name = ""
     3207                       .
     3208                   end.
     3209                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     3210                                                 ,vss-description
     3211                                                 ,buf_fbr-doc.doc-code
     3212                                                 ,chr(10)
     3213                                                 ,buf_fbr-line.recipe-code
     3214                                                 ,buf_fbr-line.artic
     3215                                                 ,v-gds-name).
     3216               end.
     3217               assign
     3218                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     3219                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     3220                                                                   + buf_fbr-line.fact-qnty
     3221                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     3222                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     3223               .
     3224               if buf_fbr-line.is-waste = no
     3225               then do:
     3226                   assign
     3227                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     3228                                                                       + buf_fbr-line.price-sum-base
     3229                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     3230                                                                       + buf_fbr-line.price-sum-rubl
     3231                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     3232                                                                       + buf_fbr-line.price-sum-vat-base
     3233                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     3234                                                                       + buf_fbr-line.price-sum-vat-rubl
     3235                   .
     3236               end.
     3237           end.
     3238           for each buf_fbr-line no-lock
     3239              where buf_fbr-line.doc-code     = p-fbr-doc-code
     3240                and buf_fbr-line.trn-type     = 'спи':U
     3241                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     3242           :
     3243               if ( buf_fbr-line.price-base   = ?
     3244                   or buf_fbr-line.price-rubl = ?
     3245                   or buf_fbr-line.price-base <= 0
     3246                   or buf_fbr-line.price-rubl <= 0 )
     3247               and buf_fbr-line.fact-qnty <> 0
     3248               and buf_fbr-line.rsrv-qnty <> ?
     3249               and buf_fbr-doc.is-free    = no
     3250               and buf_fbr-doc.status_    = 'разрешен':U
     3251               then do:
     3252   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3253   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     3254     (input  buf_fbr-line.artic
     3255     ,input  buf_fbr-line.prod-type
     3256     ,input  buf_fbr-line.prod-code
     3257     ,output v-gds-name
     3258     ) no-error .
     3259                   if error-status :error
     3260                   then do:
     3261                       assign
     3262                           v-gds-name = ""
     3263                       .
     3264                   end.
     3265                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     3266                                                 ,vss-description
     3267                                                 ,buf_fbr-doc.doc-code
     3268                                                 ,chr(10)
     3269                                                 ,buf_fbr-line.recipe-code
     3270                                                 ,buf_fbr-line.artic
     3271                                                 ,v-gds-name).
     3272               end.
     3273               assign
     3274                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     3275                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     3276                                                                   + buf_fbr-line.fact-qnty
     3277                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     3278                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     3279               .
     3280               if buf_fbr-line.is-waste = no
     3281               then do:
     3282                   assign
     3283                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     3284                                                                       + buf_fbr-line.price-sum-base
     3285                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     3286                                                                       + buf_fbr-line.price-sum-rubl
     3287                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     3288                                                                       + buf_fbr-line.price-sum-vat-base
     3289                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     3290                                                                       + buf_fbr-line.price-sum-vat-rubl
     3291                   .
     3292               end.
     3293           end.
     3294           if buf_fbr-doc.status_    = 'разрешен':U
     3295           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     3296           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     3297           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     3298           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     3299               )
     3300           then do:
     3301            undo, return error
     3302               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     3303                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     3304                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     3305                           "Сумма в &9.&4&7&4&4&8&2"
     3306                          , buf_fbr-doc.doc-code
     3307                          , chr(10)
     3308                          , buf_temp_fbrlib_recipe.recipe-code
     3309                          , chr(9)
     3310                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     3311                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     3312                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     3313                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     3314                          , "руб"
     3315                          )
     3316              +
     3317              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     3318                         "НДС в &7.&1&5&1&1&6&4"
     3319                        ,  chr(9)
     3320                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     3321                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     3322                        ,chr(10)
     3323                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     3324                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     3325                        ,"руб"
     3326                        )       .
     3327           end.
     3328       end.
     3329   end.
     3330   end procedure.
     3331   procedure fbrlib-fill-sum-fbr-doc :
     3332   do
     3333   on error undo, return error
     3334   :
     3335   define input parameter p-fbr-doc-recid  as recid        no-undo.
     3336   define input parameter p-mode           as character    no-undo.
     3337       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     3338       define buffer buf_fbr-doc           for ub.fbr-doc.
     3339       define buffer buf_fbr-line          for ub.fbr-line.
     3340       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     3341       define variable v-in-count          as integer       no-undo.
     3342       define variable v-out-count         as integer       no-undo.
     3343       find first buf_fbr-doc exclusive-lock
     3344            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     3345       .
     3346       find first buf_temp_fbrlib_recipe no-error.
     3347       if not available buf_temp_fbrlib_recipe
     3348       then do:
     3349           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     3350               input buf_fbr-doc.doc-code
     3351           ) no-error.
     3352           if error-status :error
     3353           then do:
     3354               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     3355                                              , vss-description
     3356                                              , chr(10)
     3357                                              , error-status:get-message(1)
     3358                                              , return-value ).
     3359           end.
     3360       end.
     3361       assign
     3362           v-in-count                  = 0
     3363           buf_fbr-doc.in-qnty         = 0
     3364           buf_fbr-doc.in-sale         = 0
     3365           buf_fbr-doc.in-base         = 0
     3366           buf_fbr-doc.in-rubl         = 0
     3367           buf_fbr-doc.in-vat-base     = 0
     3368           buf_fbr-doc.in-vat-rubl     = 0
     3369           v-out-count                 = 0
     3370           buf_fbr-doc.out-qnty        = 0
     3371           buf_fbr-doc.out-sale        = 0
     3372           buf_fbr-doc.out-base        = 0
     3373           buf_fbr-doc.out-rubl        = 0
     3374           buf_fbr-doc.out-vat-base    = 0
     3375           buf_fbr-doc.out-vat-rubl    = 0
     3376       .
     3377       for each buf_temp_fbrlib_recipe
     3378       :
     3379           assign
     3380               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     3381               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     3382               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     3383               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     3384               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     3385               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     3386               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     3387               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     3388               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     3389               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     3390               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     3391               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     3392               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     3393               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     3394           .
     3395       end.
     3396       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     3397       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     3398       or p-mode <> 'факт':U
     3399       then do:
     3400           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     3401           then do:
     3402               assign
     3403                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     3404                                   + string( v-out-count, ">>>,>>9" )
     3405                                   + chr(10) + "Строк исходных товаров : "
     3406                                   + string( v-in-count, ">>>,>>9" )
     3407               .
     3408           end.
     3409       end.
     3410       else do:
     3411         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     3412                                       "Сумма списанных товаров в &3 - &4&2" +
     3413                                       "Сумма оприходованных товаров в &3 - &5&2" +
     3414                                       "Сумма оприходованных товаров в &3 - &6&2" +
     3415                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     3416                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     3417                                       , buf_fbr-doc.doc-code
     3418                                       , chr(10)
     3419                                       , "рублях"
     3420                                       , round( buf_fbr-doc.out-rubl, 2 )
     3421                                       , round( buf_fbr-doc.in-rubl,  2 )
     3422                                       , round( buf_fbr-doc.in-rubl,  2 )
     3423                                       , round( buf_fbr-doc.out-base, 2 )
     3424                                       , round( buf_fbr-doc.in-base,  2 )).
     3425       end.
     3426   end.
     3427   end procedure.
     3428   procedure fbrlib-calc-prices :
     3429   do
     3430   on error undo, return error
     3431   :
     3432   define input parameter p-fbr-line-recid as recid        no-undo.
     3433   define input parameter p-price-obj-type as character    no-undo.
     3434   define input parameter p-price-obj-code as integer      no-undo.
     3435   define output parameter p-current-price as decimal      no-undo.
     3436       define variable v-void          as decimal       no-undo.
     3437       define variable v-void-char     as character     no-undo.
     3438       define variable v-gds-code      as integer       no-undo.
     3439       define variable v-b-code        as integer       no-undo.
     3440       define buffer buf_fbr-doc   for ub.fbr-doc.
     3441       define buffer buf_fbr-line  for ub.fbr-line.
     3442       define buffer buf_gds-prt   for ub.gds-prt.
     3443       define buffer buf_bar-code  for ub.bar-code.
     3444       find first buf_fbr-line no-lock
     3445           where recid( buf_fbr-line ) = p-fbr-line-recid
     3446       .
     3447   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3448   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     3449     (input  buf_fbr-line.artic
     3450     ,input  buf_fbr-line.prod-type
     3451     ,input  buf_fbr-line.prod-code
     3452     ,output v-gds-code
     3453     ) no-error .
     3454       if error-status :error
     3455       then do:
     3456         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     3457                                         ,vss-workfile
     3458                                         ,vss-revision
     3459                                         ,vss-description
     3460                                         ,chr(10)
     3461                                         , error-status:get-message(1)
     3462                                         , return-value
     3463                                         , buf_fbr-line.artic
     3464                                         ).
     3465       end.
     3466   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3467     (input  v-gds-code
     3468     ,input  ?
     3469     ,output v-b-code
     3470     ) no-error .
     3471       if error-status :error
     3472       then do:
     3473         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     3474                                         ,vss-workfile
     3475                                         ,vss-revision
     3476                                         ,vss-description
     3477                                         ,chr(10)
     3478                                         , error-status:get-message(1)
     3479                                         , return-value
     3480                                         , v-gds-code
     3481                                         ).
     3482       end.
     3483       if buf_fbr-line.is-calc = no
     3484       then do:
     3485   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3486   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3487     (input  p-price-obj-type
     3488     ,input  p-price-obj-code
     3489     ,input  v-b-code
     3490     ,input  0
     3491     ,input  0
     3492     ,output v-void-char
     3493     ,output p-current-price
     3494     ,output v-void
     3495     ,output v-void
     3496     ) no-error .
     3497           if error-status :error
     3498           then do:
     3499             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     3500                                             ,vss-workfile
     3501                                             ,vss-revision
     3502                                             ,vss-description
     3503                                             ,chr(10)
     3504                                             , error-status:get-message(1)
     3505                                             , return-value
     3506                                             , v-gds-code
     3507                                             ).
     3508           end.
     3509       end.
     3510       else do:
     3511           assign
     3512               p-current-price = buf_fbr-line.price-sale
     3513           .
     3514       end.
     3515   end.
     3516   end procedure.
     3517   procedure fbrlib-put-in-order-recipe :
     3518   do
     3519   on error undo, return error
     3520   :
     3521   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3522       define variable v-recipe-counter    as integer          no-undo.
     3523       define variable v-recipe-amount     as integer init 0   no-undo.
     3524       define variable v-child-counter     as integer          no-undo.
     3525       define variable v-is-call-cycle     as logical          no-undo.
     3526       define variable v-str as character     no-undo.
     3527       define buffer buf_in_fbr-line       for ub.fbr-line.
     3528       define buffer buf_dress_fbr-line    for ub.fbr-line.
     3529       define buffer buf_fbr-line          for ub.fbr-line.
     3530       define buffer buf_recipe-gds        for ub.recipe-gds.
     3531       define buffer buf_recipe            for ub.recipe.
     3532       for each temp_recipe-childs-qnty
     3533       :
     3534           delete temp_recipe-childs-qnty.
     3535       end.
     3536       for each temp_recipe-childs
     3537       :
     3538           delete temp_recipe-childs.
     3539       end.
     3540       for each temp_recipe-order
     3541       :
     3542           delete temp_recipe-order.
     3543       end.
     3544       for each buf_fbr-line no-lock
     3545          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     3546       on error undo, return error
     3547       :
     3548           find first temp_recipe-childs-qnty
     3549                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     3550           no-error.
     3551           if not available temp_recipe-childs-qnty
     3552           then do:
     3553               create temp_recipe-childs-qnty.
     3554               assign
     3555                   v-recipe-amount                     = v-recipe-amount + 1
     3556                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     3557                   temp_recipe-childs-qnty.order       = v-recipe-amount
     3558                   temp_recipe-childs-qnty.childs-qnty = 0
     3559                   v-child-counter                     = 0
     3560               .
     3561           end.
     3562       end.
     3563       for each buf_in_fbr-line no-lock
     3564          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     3565            and buf_in_fbr-line.trn-type = 'спи':U
     3566       on error undo, return error
     3567       :
     3568           for each buf_dress_fbr-line no-lock
     3569              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     3570                and buf_dress_fbr-line.trn-type    = 'при':U
     3571                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     3572                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     3573                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     3574           on error undo, return error
     3575           :
     3576               find first buf_recipe no-lock
     3577                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     3578               .
     3579               if buf_in_fbr-line.is-comp = yes
     3580               then do:
     3581                   find last temp_recipe-childs-qnty
     3582                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     3583                   .
     3584                   assign
     3585                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     3586                   .
     3587                   create temp_recipe-childs.
     3588                   assign
     3589                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     3590                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     3591                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     3592                   .
     3593               end.
     3594               else do:
     3595               end.
     3596           end.
     3597       end.
     3598       for each buf_in_fbr-line no-lock
     3599          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     3600            and buf_in_fbr-line.trn-type = 'при':U
     3601       on error undo, return error
     3602       :
     3603           find first buf_recipe no-lock
     3604                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     3605           no-error.
     3606           if buf_in_fbr-line.is-comp = no
     3607           then do:
     3608           end.
     3609           else do:
     3610               for each buf_recipe-gds no-lock
     3611               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     3612               :
     3613                   for each buf_fbr-line no-lock
     3614                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     3615                       and buf_fbr-line.trn-type    = 'при':U
     3616                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     3617                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     3618                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     3619                   on error undo, return error
     3620                   :
     3621                       find first buf_recipe no-lock
     3622                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     3623                       .
     3624                       if buf_recipe.recipe-type = 'разделка':U
     3625                       then do:
     3626                       end.
     3627                       else do:
     3628                           find last temp_recipe-childs-qnty
     3629                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     3630                           .
     3631                           assign
     3632                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     3633                           .
     3634                           create temp_recipe-childs.
     3635                           assign
     3636                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     3637                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     3638                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     3639                           .
     3640                       end.
     3641                   end.
     3642               end.
     3643           end.
     3644       end.
     3645       for each temp_recipe-order
     3646       on error undo, return error
     3647       :
     3648           delete temp_recipe-order.
     3649       end.
     3650       assign
     3651           v-fbrlib-recipe-order = 0
     3652       .
     3653       do v-recipe-counter = 1 to v-recipe-amount
     3654       on error undo, return error
     3655       :
     3656           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     3657                 input v-recipe-counter
     3658               , input 0
     3659               , output v-is-call-cycle
     3660           ).
     3661           if v-is-call-cycle = yes
     3662           then do:
     3663               message
     3664                       "Достигнут максимальный уровень вложенности рецептов."
     3665                   skip(1)
     3666                   skip "Невозможно упорядочить рецепты."
     3667                   skip(1)
     3668                   skip "Необходимо изменить структуру рецептов,"
     3669                   skip "используемых при формировании"
     3670                   skip "данного документа производства."
     3671               view-as alert-box error
     3672               title "Невозможно рассчитать документ производства".
     3673               for each temp_recipe-childs-qnty
     3674               :
     3675                   delete temp_recipe-childs-qnty.
     3676               end.
     3677               for each temp_recipe-childs
     3678               :
     3679                   delete temp_recipe-childs.
     3680               end.
     3681               for each temp_recipe-order
     3682               :
     3683                   delete temp_recipe-order.
     3684               end.
     3685               for each temp_recipe-order
     3686               on error undo, return error
     3687               :
     3688                   delete temp_recipe-order.
     3689               end.
     3690               for each temp_fbrlib_recipe
     3691               on error undo, return error
     3692               :
     3693                   delete temp_recipe-order.
     3694               end.
     3695               undo, return error.
     3696           end.
     3697       end.
     3698   end.
     3699   end procedure.
     3700   procedure fbrlib-add-recipe-in-tmp-order :
     3701   do
     3702   on error undo, return error
     3703   :
     3704   define input parameter p-order              as integer      no-undo.
     3705   define input parameter p-call-counter       as integer      no-undo.
     3706   define output parameter p-is-call-cycle     as logical      no-undo.
     3707       define variable v-nodes-counter     as integer       no-undo.
     3708       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     3709       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     3710       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     3711       define buffer buf_temp_recipe-order         for temp_recipe-order.
     3712       assign
     3713           p-call-counter = p-call-counter + 1
     3714       .
     3715       if p-call-counter > 50
     3716       then do:
     3717           assign
     3718               p-is-call-cycle = yes
     3719           .
     3720       end.
     3721       else do:
     3722           find first buf_temp_recipe-childs-qnty
     3723                where buf_temp_recipe-childs-qnty.order = p-order
     3724           .
     3725           find first buf_temp_recipe-order
     3726                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     3727           no-error.
     3728           if not available buf_temp_recipe-order
     3729           then do:
     3730               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     3731               :
     3732                   find first buf_temp_recipe-childs
     3733                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     3734                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     3735                   .
     3736                   find first buf_c_temp_recipe-childs-qnty
     3737                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     3738                   .
     3739                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     3740                         input buf_c_temp_recipe-childs-qnty.order
     3741                       , input p-call-counter
     3742                       , output p-is-call-cycle
     3743                   ).
     3744                   if p-is-call-cycle = yes
     3745                   then do:
     3746                       return.
     3747                   end.
     3748               end.
     3749               assign
     3750                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     3751               .
     3752               create buf_temp_recipe-order.
     3753               assign
     3754                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     3755                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     3756               .
     3757           end.
     3758       end.
     3759   end.
     3760   end procedure.
     3761   procedure fbrlib-get-trn-type :
     3762   define input parameter p-recipe-code    as character    no-undo.
     3763   define input parameter p-goods-recid    as recid        no-undo.
     3764   define input parameter p-is-integration as logical      no-undo.
     3765   define output parameter p-is-comp       as logical      no-undo.
     3766   define output parameter p-trn-type      as character    no-undo.
     3767   define buffer buf_recipe    for ub.recipe.
     3768   define buffer buf_goods     for ub.goods.
     3769   do
     3770   for buf_recipe
     3771     , buf_goods
     3772   on error undo, return error
     3773   :
     3774       find first buf_goods no-lock
     3775            where recid( buf_goods ) = p-goods-recid
     3776       .
     3777       find first buf_recipe no-lock
     3778            where buf_recipe.recipe-code = p-recipe-code
     3779       no-error.
     3780       if not available buf_recipe
     3781       then do:
     3782           assign
     3783               p-is-comp = no
     3784               p-trn-type = "":U
     3785           .
     3786           undo, return.
     3787       end.
     3788       if  buf_recipe.artic        = buf_goods.artic
     3789       and buf_recipe.prod-type    = buf_goods.prod-type
     3790       and buf_recipe.prod-code    = buf_goods.prod-code
     3791       then do:
     3792           assign
     3793               p-is-comp = yes
     3794           .
     3795       end.
     3796       else do:
     3797           assign
     3798               p-is-comp = no
     3799           .
     3800       end.
     3801       case buf_recipe.recipe-type
     3802       :
     3803           when 'производство':U
     3804           then do:
     3805               if p-is-comp = yes
     3806               then do:
     3807                   assign
     3808                       p-trn-type = 'при':U
     3809                   .
     3810               end.
     3811               else do:
     3812                   assign
     3813                       p-trn-type = 'спи':U
     3814                   .
     3815               end.
     3816           end.
     3817           when 'альтернатива':U
     3818           then do:
     3819               if p-is-comp = yes
     3820               then do:
     3821                   assign
     3822                       p-trn-type = 'при':U
     3823                   .
     3824               end.
     3825               else do:
     3826                   assign
     3827                       p-trn-type = 'спи':U
     3828                   .
     3829               end.
     3830           end.
     3831           when 'разделка':U
     3832           then do:
     3833               if p-is-comp = no
     3834               then do:
     3835                   assign
     3836                       p-trn-type = 'при':U
     3837                   .
     3838               end.
     3839               else do:
     3840                   assign
     3841                       p-trn-type = 'спи':U
     3842                   .
     3843               end.
     3844           end.
     3845           when 'комплектация':U
     3846           then do:
     3847               if p-is-integration = ?
     3848               then do:
     3849                   message
     3850                       "Выберите тип операции по рецепту комплектации:"
     3851                       skip (2) "YES - комплектация"
     3852                       skip     "NO - разукомплектация"
     3853                   view-as alert-box question
     3854                   buttons YES-NO
     3855                   update p-is-integration.
     3856               end.
     3857               if p-is-integration = yes
     3858               then do:
     3859                   if p-is-comp = yes
     3860                   then do:
     3861                       assign
     3862                           p-trn-type = 'при':U
     3863                       .
     3864                   end.
     3865                   else do:
     3866                       assign
     3867                           p-trn-type = 'спи':U
     3868                       .
     3869                   end.
     3870               end.
     3871               else do:
     3872                   if p-is-comp = yes
     3873                   then do:
     3874                       assign
     3875                           p-trn-type = 'спи':U
     3876                       .
     3877                   end.
     3878                   else do:
     3879                       assign
     3880                           p-trn-type = 'при':U
     3881                       .
     3882                   end.
     3883               end.
     3884           end.
     3885       end case.
     3886   end.
     3887   end procedure.
     3888   procedure fbrlib-get-mark :
     3889   define input parameter p-recipe-code    as character    no-undo.
     3890   define output parameter p-mark          as logical    no-undo.
     3891   define buffer buf_goods-attr     for ub.goods-attr.
     3892   define buffer buf_recipe-gds for ub.recipe-gds .
     3893       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     3894            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     3895                                               buf_goods-attr.attr-code = 'mark-type':U:
     3896            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     3897               p-mark = true .
     3898               return .
     3899            end.
     3900       end.
     3901   end procedure.
     3902   procedure fbrlib-check-temp-tables :
     3903   do
     3904   on error undo, return error
     3905   :
     3906   define input parameter p-title  as character    no-undo.
     3907       define variable v-str               as character        no-undo.
     3908       assign
     3909           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     3910       .
     3911       for each temp_recipe-childs-qnty
     3912       on error undo, return error
     3913       :
     3914           assign
     3915               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     3916                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     3917                       + "   " + string( temp_recipe-childs-qnty.order )
     3918                       + chr(10)
     3919           .
     3920       end.
     3921       assign
     3922           v-str = v-str + "temp_recipe-childs:" + chr(10)
     3923       .
     3924       for each temp_recipe-childs
     3925       on error undo, return error
     3926       :
     3927           assign
     3928               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     3929                       + "   " + string( temp_recipe-childs.child-code )
     3930                       + "   " + string( temp_recipe-childs.child-recipe-code )
     3931                       + chr(10)
     3932           .
     3933       end.
     3934       assign
     3935           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     3936       .
     3937       for each temp_recipe-order
     3938       on error undo, return error
     3939       :
     3940           assign
     3941               v-str   = v-str + string( temp_recipe-order.recipe-code )
     3942                       + "   " + string( temp_recipe-order.order )
     3943                       + chr(10)
     3944           .
     3945       end.
     3946       assign
     3947           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     3948       .
     3949       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     3950       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     3951       for each temp_fbrlib_recipe
     3952       on error undo, return error
     3953       :
     3954           assign
     3955               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     3956                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     3957                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     3958                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     3959                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     3960                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     3961                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     3962                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     3963                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     3964                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     3965                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     3966                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     3967                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     3968                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     3969                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     3970                       + chr(10)
     3971           .
     3972           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     3973       end.
     3974   end.
     3975   end procedure.
     3976   procedure fbrlib-s-coeff-value :
     3977   define input  parameter p-gds-code    as integer        no-undo.
     3978   define input  parameter p-date        as date           no-undo.
     3979   define input  parameter p-obj-type    as character      no-undo.
     3980   define input  parameter p-obj-code    as integer        no-undo.
     3981   define output parameter p-coeff-value as decimal        no-undo.
     3982   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     3983       define variable v-date          as date         no-undo.
     3984       define variable v-host-code     as integer      no-undo.
     3985       define buffer buf_goods       for ub.goods.
     3986       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     3987       define buffer buf_clients     for ub.clients.
     3988       define buffer buf_s-coeff     for ub.s-coeff.
     3989   do
     3990   for buf_goods
     3991     , buf_fbr-gds-obj
     3992     , buf_clients
     3993     , buf_s-coeff
     3994   on error undo, return error return-value
     3995   :
     3996       find first buf_goods no-lock
     3997            where buf_goods.gds-code = p-gds-code
     3998       no-error .
     3999       if not available buf_goods
     4000       then do:
     4001          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     4002       end.
     4003       find first buf_clients no-lock
     4004            where buf_clients.obj-type = p-obj-type
     4005              and buf_clients.obj-code = p-obj-code
     4006       no-error.
     4007       if not available buf_clients
     4008       then do:
     4009          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     4010       end.
     4011       assign
     4012           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     4013       .
     4014       find first buf_fbr-gds-obj no-lock
     4015            where buf_fbr-gds-obj.gds-code = p-gds-code
     4016              and buf_fbr-gds-obj.obj-type = p-obj-type
     4017              and buf_fbr-gds-obj.obj-code = p-obj-code
     4018       no-error.
     4019       if not available buf_fbr-gds-obj
     4020       or buf_fbr-gds-obj.is-season = no
     4021       then do:
     4022           assign
     4023               p-coeff-value = 0
     4024           .
     4025           return.
     4026       end.
     4027   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4028   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4029     (input  p-obj-type
     4030     ,input  p-obj-code
     4031     ,output v-host-code
     4032     )  .
     4033       find last buf_s-coeff no-lock
     4034           where buf_s-coeff.gds-code = p-gds-code
     4035             and buf_s-coeff.host-code = v-host-code
     4036             and buf_s-coeff.obj-type = p-obj-type
     4037             and buf_s-coeff.obj-code = p-obj-code
     4038             and buf_s-coeff.s-date <= v-date
     4039       no-error.
     4040       if available buf_s-coeff
     4041       then do:
     4042           assign
     4043               p-coeff-value = buf_s-coeff.coeff-value
     4044           .
     4045           return.
     4046       end.
     4047       find last buf_s-coeff no-lock
     4048           where buf_s-coeff.gds-code = p-gds-code
     4049             and buf_s-coeff.host-code = v-host-code
     4050             and buf_s-coeff.obj-type = "":U
     4051             and buf_s-coeff.obj-code = 0
     4052             and buf_s-coeff.s-date <= v-date
     4053       no-error.
     4054       if available buf_s-coeff
     4055       then do:
     4056           assign
     4057               p-coeff-value = buf_s-coeff.coeff-value
     4058           .
     4059           return.
     4060       end.
     4061       find last buf_s-coeff no-lock
     4062           where buf_s-coeff.gds-code = p-gds-code
     4063             and buf_s-coeff.host-code = 0
     4064             and buf_s-coeff.obj-type = "":U
     4065             and buf_s-coeff.obj-code = 0
     4066             and buf_s-coeff.s-date <= v-date
     4067       no-error.
     4068       if available buf_s-coeff
     4069       then do:
     4070           assign
     4071               p-coeff-value = buf_s-coeff.coeff-value
     4072           .
     4073       end.
     4074       else do:
     4075           assign
     4076               p-coeff-value = 0
     4077           .
     4078       end.
     4079   end.
     4080   end procedure.
     4081   procedure fbrlib_create-fbr-recipe-gds :
     4082   define input parameter p-doc-code         as character      no-undo.
     4083   define input parameter p-recipe-code      as character      no-undo.
     4084   define input parameter p-prod-type        as character      no-undo.
     4085   define input parameter p-prod-code        as integer        no-undo.
     4086   define input parameter p-artic            as character      no-undo.
     4087   define input parameter p-gds-code         as integer        no-undo.
     4088   define input parameter p-is-waste         as logical        no-undo.
     4089   define input parameter p-proc-number      as integer        no-undo.
     4090   define input parameter p-obj-date         as date           no-undo.
     4091   define input parameter p-obj-type         as character      no-undo.
     4092   define input parameter p-obj-code         as integer        no-undo.
     4093   define input parameter p-calc-method      as decimal        no-undo.
     4094   define input parameter p-coeff-waste      as decimal        no-undo.
     4095   define input parameter p-orig-qnty        as decimal        no-undo.
     4096   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     4097       define variable v-coeff-season  as decimal      no-undo.
     4098       define variable v-void-decimal  as decimal      no-undo.
     4099       define variable v-void-integer  as integer      no-undo.
     4100       define variable v-recipe-type   as character    no-undo.
     4101       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4102       define buffer buf_goods             for ub.goods.
     4103       define buffer buf_recipe            for ub.recipe.
     4104   do
     4105   for buf_fbr-recipe-gds
     4106     , buf_recipe
     4107     , buf_goods
     4108   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4109   :
     4110       find first buf_fbr-recipe-gds exclusive-lock
     4111            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4112              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4113              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     4114              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     4115              and buf_fbr-recipe-gds.artic       = p-artic
     4116       no-error.
     4117       if not available buf_fbr-recipe-gds
     4118       then do:
     4119           create buf_fbr-recipe-gds.
     4120           assign
     4121               buf_fbr-recipe-gds.doc-code           = p-doc-code
     4122               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     4123               buf_fbr-recipe-gds.prod-type          = p-prod-type
     4124               buf_fbr-recipe-gds.prod-code          = p-prod-code
     4125               buf_fbr-recipe-gds.artic              = p-artic
     4126               buf_fbr-recipe-gds.gds-code           = p-gds-code
     4127               buf_fbr-recipe-gds.is-waste           = p-is-waste
     4128               buf_fbr-recipe-gds.proc-number        = p-proc-number
     4129               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     4130               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     4131           .
     4132           find first buf_goods no-lock
     4133                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     4134                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     4135                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     4136           .
     4137           run fbrlib-s-coeff-value in this-procedure (
     4138                 input buf_goods.gds-code
     4139               , input p-obj-date
     4140               , input p-obj-type
     4141               , input p-obj-code
     4142               , output v-coeff-season
     4143           ) no-error.
     4144           if error-status:error
     4145           then do:
     4146               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     4147           end.
     4148           assign
     4149               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     4150               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     4151               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     4152           .
     4153           run fbrlib-get-recipe-type in this-procedure (
     4154                 input buf_fbr-recipe-gds.doc-code
     4155               , input buf_fbr-recipe-gds.recipe-code
     4156               , output v-recipe-type
     4157           ).
     4158           if v-recipe-type <> 'производство':U
     4159           then do:
     4160               assign
     4161                   buf_fbr-recipe-gds.coeff-value  = 0
     4162                   buf_fbr-recipe-gds.coeff-waste  = 0
     4163                   buf_fbr-recipe-gds.calc-method  = 1
     4164                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     4165               .
     4166           end.
     4167           else do:
     4168               run fbrlib-calc-brutto in this-procedure (
     4169                     input v-recipe-type
     4170                   , input buf_fbr-recipe-gds.qnty
     4171                   , input buf_fbr-recipe-gds.coeff-value
     4172                   , input buf_fbr-recipe-gds.coeff-waste
     4173                   , input 0
     4174                   , input 3
     4175                   , output v-void-decimal
     4176                   , output v-void-decimal
     4177                   , output buf_fbr-recipe-gds.brutto-qnty
     4178                   , output v-void-integer
     4179               ).
     4180               assign
     4181                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     4182               .
     4183               run fbrlib-calc-brutto in this-procedure (
     4184                     input v-recipe-type
     4185                   , input buf_fbr-recipe-gds.qnty
     4186                   , input buf_fbr-recipe-gds.coeff-value
     4187                   , input buf_fbr-recipe-gds.coeff-waste
     4188                   , input buf_fbr-recipe-gds.brutto-qnty
     4189                   , input buf_fbr-recipe-gds.calc-method
     4190                   , output buf_fbr-recipe-gds.qnty
     4191                   , output v-void-decimal
     4192                   , output v-void-decimal
     4193                   , output v-void-integer
     4194               ).
     4195           end.
     4196       end.
     4197   end.
     4198   end procedure.
     4199   procedure fbrlib-set-default-recipe :
     4200   define input parameter p-obj-type   as character    no-undo.
     4201   define input parameter p-obj-code   as integer      no-undo.
     4202   define input parameter p-gds-code   as integer      no-undo.
     4203       define variable v-artic             as character    no-undo.
     4204       define variable v-prod-type         as character    no-undo.
     4205       define variable v-prod-code         as character    no-undo.
     4206       define variable v-recipe-code       as character    no-undo.
     4207       define variable v-fbr-gds-obj-recid as recid        no-undo.
     4208       define variable v-recipe-found      as logical      no-undo.
     4209       define buffer buf_recipe        for ub.recipe.
     4210       define buffer buf_other_recipe  for ub.recipe.
     4211       define buffer buf_goods         for ub.goods.
     4212       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     4213   do
     4214   for buf_recipe
     4215     , buf_goods
     4216     , buf_fbr-gds-obj
     4217   on error undo, return error
     4218   :
     4219       find first buf_goods no-lock
     4220            where buf_goods.gds-code = p-gds-code
     4221       .
     4222       run fbrlib-get-obj-recipe in this-procedure (
     4223             input p-obj-type
     4224           , input p-obj-code
     4225           , input p-gds-code
     4226           , output v-recipe-code
     4227       ).
     4228       if v-recipe-code <> ""
     4229       then do:
     4230           find first buf_recipe no-lock
     4231               where buf_recipe.recipe-code = v-recipe-code
     4232           no-error.
     4233           if not available buf_recipe
     4234           then do:
     4235               assign
     4236                   v-recipe-code = ""
     4237               .
     4238           end.
     4239       end.
     4240       if v-recipe-code = ""
     4241       then do:
     4242           find first buf_fbr-gds-obj exclusive-lock
     4243                where buf_fbr-gds-obj.obj-type = p-obj-type
     4244                  and buf_fbr-gds-obj.obj-code = p-obj-code
     4245                  and buf_fbr-gds-obj.gds-code = p-gds-code
     4246           no-error.
     4247           if not available buf_fbr-gds-obj
     4248           then do:
     4249               run ref/fgdsobj1.p (
     4250                     input-output v-fbr-gds-obj-recid
     4251                   , input 'ДОБАВЛЕНИЕ':U
     4252                   , input no
     4253                   , input p-gds-code
     4254                   , input p-obj-type
     4255                   , input p-obj-code
     4256                   , input 0
     4257                   , input ""
     4258                   , input 0
     4259                   , input no
     4260                   , input no
     4261                   , input no
     4262                   , input no
     4263                   , input no
     4264                   , input no
     4265               ) no-error.
     4266               if error-status:error
     4267               then do:
     4268                   message
     4269                           vss-workfile vss-revision vss-description
     4270                       skip "Ошибка изменения атрибутов товара на объекте"
     4271                       skip return-value
     4272                       skip trim(error-status :get-message(1))
     4273                               trim(error-status :get-message(2))
     4274                               trim(error-status :get-message(3))
     4275                   view-as alert-box error.
     4276                   undo, return error .
     4277               end.
     4278               find first buf_fbr-gds-obj exclusive-lock
     4279                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     4280               .
     4281           end.
     4282           assign
     4283               v-recipe-found = no
     4284           .
     4285           for first buf_recipe no-lock
     4286               where buf_recipe.obj-type    = p-obj-type
     4287                 and buf_recipe.obj-code    = p-obj-code
     4288                 and buf_recipe.artic       = buf_goods.artic
     4289                 and buf_recipe.prod-type   = buf_goods.prod-type
     4290                 and buf_recipe.prod-code   = buf_goods.prod-code
     4291                 and buf_recipe.recipe-type = 'производство':U
     4292                 or (
     4293                     buf_recipe.obj-type    = ""
     4294                 and buf_recipe.obj-code    = 0
     4295                 and buf_recipe.artic       = buf_goods.artic
     4296                 and buf_recipe.prod-type   = buf_goods.prod-type
     4297                 and buf_recipe.prod-code   = buf_goods.prod-code
     4298                 and buf_recipe.recipe-type = 'производство':U
     4299                     )
     4300           :
     4301               assign
     4302                   v-recipe-found = yes
     4303                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     4304               .
     4305           end.
     4306           if v-recipe-found = no
     4307           then do:
     4308               for first buf_recipe no-lock
     4309                   where buf_recipe.obj-type    = p-obj-type
     4310                     and buf_recipe.obj-code    = p-obj-code
     4311                     and buf_recipe.artic       = buf_goods.artic
     4312                     and buf_recipe.prod-type   = buf_goods.prod-type
     4313                     and buf_recipe.prod-code   = buf_goods.prod-code
     4314                     and buf_recipe.recipe-type <> 'альтернатива':U
     4315                     or (
     4316                         buf_recipe.obj-type    = ""
     4317                     and buf_recipe.obj-code    = 0
     4318                     and buf_recipe.artic       = buf_goods.artic
     4319                     and buf_recipe.prod-type   = buf_goods.prod-type
     4320                     and buf_recipe.prod-code   = buf_goods.prod-code
     4321                     and buf_recipe.recipe-type <> 'альтернатива':U
     4322                         )
     4323               :
     4324                   assign
     4325                       v-recipe-found = yes
     4326                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     4327                   .
     4328               end.
     4329               if v-recipe-found = no
     4330               then do:
     4331                   for first buf_recipe no-lock
     4332                       where buf_recipe.obj-type    = p-obj-type
     4333                         and buf_recipe.obj-code    = p-obj-code
     4334                         and buf_recipe.artic       = buf_goods.artic
     4335                         and buf_recipe.prod-type   = buf_goods.prod-type
     4336                         and buf_recipe.prod-code   = buf_goods.prod-code
     4337                         or (
     4338                             buf_recipe.obj-type    = ""
     4339                         and buf_recipe.obj-code    = 0
     4340                         and buf_recipe.artic       = buf_goods.artic
     4341                         and buf_recipe.prod-type   = buf_goods.prod-type
     4342                         and buf_recipe.prod-code   = buf_goods.prod-code
     4343                             )
     4344                   :
     4345                       assign
     4346                           v-recipe-found = yes
     4347                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     4348                       .
     4349                   end.
     4350                   if v-recipe-found = no
     4351                   then do:
     4352                       assign
     4353                           buf_fbr-gds-obj.default-recipe-code = ""
     4354                       .
     4355                   end.
     4356               end.
     4357           end.
     4358       end.
     4359   end.
     4360   end procedure.
     4361   procedure fbrlib-get-obj-recipe :
     4362   define input parameter p-obj-type       as character    no-undo.
     4363   define input parameter p-obj-code       as integer      no-undo.
     4364   define input parameter p-gds-code       as integer      no-undo.
     4365   define output parameter p-recipe-code   as character    no-undo.
     4366       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     4367   do
     4368   for buf_fbr-gds-obj
     4369   on error undo, return error
     4370   :
     4371       find first buf_fbr-gds-obj no-lock
     4372            where buf_fbr-gds-obj.obj-type = p-obj-type
     4373              and buf_fbr-gds-obj.obj-code = p-obj-code
     4374              and buf_fbr-gds-obj.gds-code = p-gds-code
     4375       no-error.
     4376       if available buf_fbr-gds-obj
     4377       then do:
     4378           assign
     4379               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     4380           .
     4381       end.
     4382       else do:
     4383           assign
     4384               p-recipe-code = ""
     4385           .
     4386       end.
     4387   end.
     4388   end procedure.
     4389   procedure fbrlib-create-or-update-recipe-gds :
     4390   define input parameter p-recipe-code    as character        no-undo.
     4391   define input parameter p-gds-code       as integer          no-undo.
     4392   define input parameter p-is-waste       as logical          no-undo.
     4393   define input parameter p-qnty           as decimal          no-undo.
     4394   define input parameter p-proc-number    as integer          no-undo.
     4395   define input parameter p-nws-self       as logical          no-undo.
     4396       define variable v-max-proc-num  as integer      no-undo.
     4397       define variable v-recipe-type   as character    no-undo.
     4398       define buffer buf_goods             for ub.goods.
     4399       define buffer buf_recipe-gds        for ub.recipe-gds.
     4400       define buffer buf_recipe            for ub.recipe.
     4401       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     4402   do
     4403   for buf_goods
     4404     , buf_recipe-gds
     4405     , buf_recipe
     4406     , buf_proc_recipe-gds
     4407   on error undo, return error
     4408   :
     4409       find first buf_recipe no-lock
     4410            where buf_recipe.recipe-code = p-recipe-code
     4411       .
     4412       find first buf_goods no-lock
     4413            where buf_goods.gds-code = p-gds-code
     4414       .
     4415       find first buf_recipe-gds
     4416            where buf_recipe-gds.recipe-code = p-recipe-code
     4417              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     4418              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     4419              and buf_recipe-gds.artic       = buf_goods.artic
     4420       no-error.
     4421       if not available buf_recipe-gds
     4422       then do:
     4423           create buf_recipe-gds.
     4424           assign
     4425               buf_recipe-gds.recipe-code = p-recipe-code
     4426               buf_recipe-gds.gds-code    = p-gds-code
     4427               buf_recipe-gds.prod-type   = buf_goods.prod-type
     4428               buf_recipe-gds.prod-code   = buf_goods.prod-code
     4429               buf_recipe-gds.artic       = buf_goods.artic
     4430           .
     4431           assign
     4432               buf_recipe-gds.is-waste    = no
     4433               buf_recipe-gds.qnty        = 0
     4434               buf_recipe-gds.coeff-waste = 0
     4435               buf_recipe-gds.brutto-qnty = 0
     4436               buf_recipe-gds.proc-number = 0
     4437               buf_recipe-gds.nws-self    = no
     4438           .
     4439       end.
     4440       assign
     4441           buf_recipe-gds.is-waste    = p-is-waste
     4442       .
     4443       run fbrlib-get-recipe-type in this-procedure (
     4444             input "":U
     4445           , input buf_recipe-gds.recipe-code
     4446           , output v-recipe-type
     4447       ).
     4448       if v-recipe-type <> 'производство':U
     4449       then do:
     4450           assign
     4451               buf_recipe-gds.calc-method = 1
     4452               buf_recipe-gds.qnty        = p-qnty
     4453               buf_recipe-gds.brutto-qnty = p-qnty
     4454               buf_recipe-gds.coeff-waste = 0
     4455           .
     4456       end.
     4457       else do:
     4458           assign
     4459               buf_recipe-gds.calc-method = 1
     4460               buf_recipe-gds.brutto-qnty = p-qnty
     4461           .
     4462           run fbrlib-calc-brutto in this-procedure (
     4463                 input v-recipe-type
     4464               , input 0
     4465               , input 0
     4466               , input buf_recipe-gds.coeff-waste
     4467               , input buf_recipe-gds.brutto-qnty
     4468               , input 1
     4469               , output buf_recipe-gds.qnty
     4470               , output buf_recipe-gds.coeff-waste
     4471               , output buf_recipe-gds.brutto-qnty
     4472               , output buf_recipe-gds.calc-method
     4473           ).
     4474       end.
     4475       assign
     4476           buf_recipe-gds.nws-self    = p-nws-self
     4477       .
     4478       if buf_recipe.recipe-type = 'альтернатива':U
     4479       and buf_recipe-gds.proc-number <> 0
     4480       then do:
     4481       end.
     4482       else do:
     4483           if p-proc-number <> 0
     4484           then do:
     4485               assign
     4486                   buf_recipe-gds.proc-number = p-proc-number
     4487               .
     4488           end.
     4489           else do:
     4490               assign
     4491                   v-max-proc-num = 0
     4492               .
     4493               for each buf_proc_recipe-gds no-lock
     4494                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     4495               :
     4496                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     4497                   then do:
     4498                       assign
     4499                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     4500                       .
     4501                   end.
     4502               end.
     4503               assign
     4504                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     4505               .
     4506           end.
     4507       end.
     4508   end.
     4509   end procedure.
     4510   PROCEDURE fbrlib-create-or-update-recipe :
     4511   define input parameter p-mode               as character    no-undo.
     4512   define input parameter p-obj-type           as character    no-undo.
     4513   define input parameter p-obj-code           as integer      no-undo.
     4514   define input parameter p-recipe-code        as character    no-undo.
     4515   define input parameter p-recipe-type        as character    no-undo.
     4516   define input parameter p-gds-code           as integer      no-undo.
     4517   define input parameter p-name               as character    no-undo.
     4518   define input parameter p-design             as character    no-undo.
     4519   define input parameter p-order              as integer      no-undo.
     4520   define input parameter p-quality            as character    no-undo.
     4521   define input parameter p-ref-num            as character    no-undo.
     4522   define input parameter p-technique          as character    no-undo.
     4523   define input parameter p-template           as character    no-undo.
     4524   define input parameter p-qnty               as decimal      no-undo.
     4525   define input parameter p-portion-qnty       as integer      no-undo.
     4526   define input parameter p-portion-weight     as decimal      no-undo.
     4527   define output parameter p-new-recipe-code   as character    no-undo.
     4528       define variable v-host-code         as integer      no-undo.
     4529       define variable v-fbr-gds-obj-recid as recid        no-undo.
     4530       define buffer buf_recipe    for ub.recipe.
     4531       define buffer buf_goods     for ub.goods.
     4532   do
     4533   for buf_recipe
     4534     , buf_goods
     4535   on error undo, return error
     4536   :
     4537       if p-mode <> 'ДОБАВЛЕНИЕ':U
     4538       and p-mode <> 'ИЗМЕНЕНИЕ':U
     4539       then do:
     4540           message
     4541               skip "Ошибка задания типа операции для создания или измения рецепта."
     4542               skip (1)
     4543               skip "Задан тип операции:" p-mode
     4544           view-as alert-box error.
     4545           undo, return error .
     4546       end.
     4547       if p-recipe-code = ""
     4548       then do:
     4549   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4550   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4551     (input  p-obj-type
     4552     ,input  p-obj-code
     4553     ,output v-host-code
     4554     )  .
     4555           find first buf_goods no-lock
     4556                where buf_goods.gds-code = p-gds-code
     4557           .
     4558           create buf_recipe .
     4559           run fbrcode-gen-recipe-code in this-procedure (
     4560                 input p-obj-type
     4561               , input p-obj-code
     4562               , output buf_recipe.recipe-code
     4563           ).
     4564           assign
     4565               buf_recipe.artic               = buf_goods.artic
     4566               buf_recipe.prod-type           = buf_goods.prod-type
     4567               buf_recipe.prod-code           = buf_goods.prod-code
     4568               buf_recipe.recipe-type         = p-recipe-type
     4569               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     4570               buf_recipe.gds-code            = p-gds-code
     4571               buf_recipe.host-code           = v-host-code
     4572               buf_recipe.obj-type            = p-obj-type
     4573               buf_recipe.obj-code            = p-obj-code
     4574               buf_recipe.recipe-design       = ""
     4575               buf_recipe.recipe-order        = 0
     4576               buf_recipe.recipe-quality      = ""
     4577               buf_recipe.recipe-ref-num      = ""
     4578               buf_recipe.recipe-technique    = ""
     4579               buf_recipe.recipe-template     = ""
     4580               buf_recipe.qnty                = 1.0
     4581               buf_recipe.portion-qnty        = 1
     4582               buf_recipe.portion-weight      = 0
     4583           .
     4584       end.
     4585       if p-name <> ""
     4586       then do:
     4587           assign
     4588               buf_recipe.recipe-name = p-name
     4589           .
     4590       end.
     4591       assign
     4592           buf_recipe.recipe-design       = p-design
     4593           buf_recipe.recipe-order        = p-order
     4594           buf_recipe.recipe-quality      = p-quality
     4595           buf_recipe.recipe-ref-num      = p-ref-num
     4596           buf_recipe.recipe-technique    = p-technique
     4597           buf_recipe.recipe-template     = p-template
     4598           buf_recipe.qnty                = p-qnty
     4599           buf_recipe.portion-qnty        = p-portion-qnty
     4600           buf_recipe.portion-weight      = p-portion-weight
     4601       .
     4602       assign
     4603           p-new-recipe-code = buf_recipe.recipe-code
     4604       .
     4605       run fbrlib-set-default-recipe in this-procedure (
     4606             input p-obj-type
     4607           , input p-obj-code
     4608           , input buf_goods.gds-code
     4609       ).
     4610   end.
     4611   END PROCEDURE.
     4612   PROCEDURE fbrlib-delete-fact-fbr-doc :
     4613   define input parameter parparentproc-handle as widget-handle no-undo .
     4614   define input parameter p-doc-code   as character no-undo.
     4615   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     4616       define variable v-shift-on      as logical      no-undo.
     4617       define variable v-shift-date    as date         no-undo.
     4618       define variable v-shift-num     as integer      no-undo.
     4619       define variable v-shift-name    as character    no-undo.
     4620       define variable v-obj-date      as date         no-undo.
     4621       define variable v-chip-num      as integer      no-undo.
     4622       define buffer buf_fbr-doc       for ub.fbr-doc.
     4623       define buffer buf_fbr-line      for ub.fbr-line.
     4624       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     4625       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     4626       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     4627       define buffer buf_marking-lines for ub.marking-lines .
     4628       define buffer buf_marking       for ub.marking .
     4629       define buffer buf_goods         for ub.goods .
     4630   do
     4631   for buf_fbr-doc
     4632     , buf_fbr-line
     4633     , buf_c-fbr-doc
     4634     , buf_fbr-recipe
     4635     , buf_fbr-recipe-gds
     4636     , buf_goods
     4637     , buf_marking
     4638     , buf_marking-lines
     4639   on error undo, return error
     4640   :
     4641   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4642     define variable v-cntxt-db-num        as integer   no-undo .
     4643     define variable v-cntxt-userid        as character no-undo .
     4644     define variable v-cntxt-level         as character no-undo .
     4645     define variable v-cntxt-host-code-obj as integer   no-undo .
     4646     define variable v-cntxt-obj-type      as character no-undo .
     4647     define variable v-cntxt-obj-code      as integer   no-undo .
     4648     define variable v-cntxt-db-num-obj    as integer   no-undo .
     4649     define variable v-cntxt-is-admin      as logical   no-undo .
     4650   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4651     run mainmenu_getcntxt in parparentproc-handle
     4652       (output v-cntxt-db-num
     4653       ,output v-cntxt-userid
     4654       ,output v-cntxt-level
     4655       ,output v-cntxt-host-code-obj
     4656       ,output v-cntxt-obj-type
     4657       ,output v-cntxt-obj-code
     4658       ,output v-cntxt-db-num-obj
     4659       ,output v-cntxt-is-admin
     4660       ) .
     4661       if search ("delfbr.err") <> ?
     4662       then do:
     4663           os-delete "delfbr.err".
     4664       end.
     4665     _del-block:
     4666       do transaction
     4667     on error undo _del-block, return error return-value
     4668     on endkey undo _del-block , return error return-value
     4669     on stop undo _del-block , return error return-value
     4670       :
     4671           find first buf_fbr-doc exclusive-lock
     4672                where buf_fbr-doc.doc-code = p-doc-code
     4673           no-error.
     4674           if not available buf_fbr-doc
     4675           then do:
     4676         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     4677                                           ,vss-workfile
     4678                                           ,vss-revision
     4679                                           ,vss-description
     4680                                           ,chr(10)
     4681                                           , p-doc-code).
     4682           end.
     4683           run fbrlib-delete-fact-trn-doc in this-procedure (
     4684               input parparentproc-handle
     4685              ,input p-doc-code
     4686              ,input 'при':U
     4687              ,input p-chip-num
     4688              ,output v-chip-num
     4689           ) no-error.
     4690           if error-status :error
     4691           then do:
     4692               run fbrlib-print-del-error-message in this-procedure .
     4693         undo _del-block, return error.
     4694           end.
     4695           assign
     4696           p-chip-num = (if p-chip-num = ?
     4697                         then v-chip-num
     4698                         else p-chip-num).
     4699           run fbrlib-delete-fact-trn-doc in this-procedure (
     4700               input parparentproc-handle
     4701              ,input p-doc-code
     4702              ,input 'рас':U
     4703              ,input p-chip-num
     4704              ,output v-chip-num
     4705           ) no-error.
     4706           if error-status :error
     4707           then do:
     4708               run fbrlib-print-del-error-message in this-procedure .
     4709         undo _del-block, return error.
     4710           end.
     4711           run fbrlib-delete-fact-trn-doc in this-procedure (
     4712               input parparentproc-handle
     4713              ,input p-doc-code
     4714              ,input 'спи':U
     4715              ,input p-chip-num
     4716              ,output v-chip-num
     4717           ) no-error.
     4718           if error-status :error
     4719           then do:
     4720               run fbrlib-print-del-error-message in this-procedure .
     4721         undo _del-block, return error.
     4722           end.
     4723           create buf_c-fbr-doc.
     4724           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     4725   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4726   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     4727     (input  buf_fbr-doc.obj-type
     4728     ,input  buf_fbr-doc.obj-code
     4729     ,output v-obj-date
     4730     ) no-error .
     4731           if error-status :error
     4732           or v-obj-date = ?
     4733           then do:
     4734         undo _del-block, return error "Нет текущей даты на объекте документа.".
     4735           end.
     4736   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4737   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     4738     (input  buf_fbr-doc.obj-type
     4739     ,input  buf_fbr-doc.obj-code
     4740     ,input  'shift-on=request'
     4741     ,output v-shift-on
     4742     )  .
     4743           if v-shift-on
     4744           then do:
     4745   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4746   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     4747     (input  buf_fbr-doc.obj-type
     4748     ,input  buf_fbr-doc.obj-code
     4749     ,output v-shift-date
     4750     ,output v-shift-num
     4751     ,output v-shift-name
     4752     ) no-error .
     4753               if error-status :error
     4754               then do:
     4755           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     4756               end.
     4757           end.
     4758           else do:
     4759               assign
     4760                   v-shift-date = ?
     4761                   v-shift-num  = ?
     4762                   v-shift-name = ?
     4763               .
     4764           end.
     4765           define variable v-today       as date         no-undo.
     4766           define variable v-time        as integer      no-undo.
     4767           run cur-time in this-procedure (
     4768                 output v-today
     4769               , output v-time
     4770           ).
     4771           assign
     4772               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     4773               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     4774               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     4775               buf_c-fbr-doc.corr-date        = v-today
     4776               buf_c-fbr-doc.corr-time        = v-time
     4777               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     4778               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     4779               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     4780               buf_c-fbr-doc.is-del           = yes
     4781           .
     4782           assign
     4783               buf_fbr-doc.is-del = yes
     4784           .
     4785           for each buf_fbr-line exclusive-lock
     4786              where buf_fbr-line.doc-code = p-doc-code
     4787       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4788       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     4789       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     4790           :
     4791               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     4792                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     4793                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     4794               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     4795                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     4796                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     4797                                                       and buf_marking-lines.in-code  = "manufacturing"
     4798                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     4799                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     4800                                                       and buf_marking-lines.prt-code = 0
     4801               :
     4802                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     4803                   assign
     4804                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     4805                   .
     4806                 end .
     4807                 delete buf_marking-lines.
     4808               end .
     4809               delete buf_fbr-line.
     4810           end.
     4811           for each buf_fbr-recipe exclusive-lock
     4812              where buf_fbr-recipe.doc-code = p-doc-code
     4813       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4814       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     4815       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     4816           :
     4817               delete buf_fbr-recipe.
     4818           end.
     4819           for each buf_fbr-recipe-gds exclusive-lock
     4820              where buf_fbr-recipe-gds.doc-code = p-doc-code
     4821       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4822       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     4823       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     4824           :
     4825               delete buf_fbr-recipe-gds.
     4826           end.
     4827           delete buf_fbr-doc.
     4828       end.
     4829   end.
     4830   END PROCEDURE.
     4831   PROCEDURE fbrlib-del-trn-doc :
     4832   do
     4833   on error undo, return error
     4834   :
     4835   define input parameter parparentproc        as widget-handle no-undo .
     4836   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     4837   define input parameter p-trn-doc-type       as character    no-undo.
     4838   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     4839   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     4840       define variable v-trn-doc-doc-code  as character     no-undo.
     4841       define buffer buf_trn-doc       for ub.trn-doc.
     4842   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4843     define variable v-cntxt-db-num        as integer   no-undo .
     4844     define variable v-cntxt-userid        as character no-undo .
     4845     define variable v-cntxt-level         as character no-undo .
     4846     define variable v-cntxt-host-code-obj as integer   no-undo .
     4847     define variable v-cntxt-obj-type      as character no-undo .
     4848     define variable v-cntxt-obj-code      as integer   no-undo .
     4849     define variable v-cntxt-db-num-obj    as integer   no-undo .
     4850     define variable v-cntxt-is-admin      as logical   no-undo .
     4851   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4852     run mainmenu_getcntxt in parparentproc
     4853       (output v-cntxt-db-num
     4854       ,output v-cntxt-userid
     4855       ,output v-cntxt-level
     4856       ,output v-cntxt-host-code-obj
     4857       ,output v-cntxt-obj-type
     4858       ,output v-cntxt-obj-code
     4859       ,output v-cntxt-db-num-obj
     4860       ,output v-cntxt-is-admin
     4861       ) .
     4862       run fbrcode-trn-doc in this-procedure (
     4863             input 'производство':U
     4864           , input p-fbr-doc-doc-code
     4865           , input p-trn-doc-type
     4866           , output v-trn-doc-doc-code
     4867       ).
     4868       find first buf_trn-doc no-lock
     4869            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     4870       no-error.
     4871       if available buf_trn-doc
     4872       then do:
     4873           run str/del-doc.p (
     4874                 input parparentproc
     4875               , input buf_trn-doc.doc-code
     4876               , input v-cntxt-db-num
     4877               , input "del-doc.err"
     4878               , input ?
     4879               , input p-fbr-doc-doc-code
     4880               , input v-cntxt-userid
     4881               , input 0
     4882               , input p-phchip-num
     4883               , output p-chip-num
     4884           ) no-error.
     4885           if error-status :error
     4886           then do:
     4887             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     4888                                           ,v-trn-doc-doc-code
     4889                                           ,p-fbr-doc-doc-code
     4890                                           , chr(10)
     4891                                           , error-status:get-message(1)
     4892                                           , return-value ).
     4893           end.
     4894       end.
     4895   end.
     4896   END PROCEDURE.
     4897   PROCEDURE fbrlib-delete-fact-trn-doc :
     4898   define input parameter parparentproc    as widget-handle    no-undo.
