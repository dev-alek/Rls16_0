      980   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
      981                                             INPUT iFlagEmpty AS INTEGER).
      982       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
      983       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
      984           DO:
      985               IF iFlagEmpty = 0                           THEN RETURN "".
      986               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
      987               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
      988               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
      989               ELSE RETURN "".
      990           END.
      991       ELSE DO:
      992           run xmlchar-encode in this-procedure (
      993                 input sToPlace
      994               , output sToPlace
      995           ).
      996           ASSIGN
      997               sToPlace = sParName + '="' + sToPlace + '"'
      998           .
      999           RETURN sToPlace.
     1000       END.
     1001   END FUNCTION.
     1002   function bge-xml-date returns character
     1003   ( input p-date as date )
     1004   :
     1005     define variable v-date-str as character no-undo .
     1006     run bge-xml-date-to-str in this-procedure ( input   p-date
     1007                                               , output  v-date-str
     1008                                               ) .
     1009     return v-date-str.
     1010   end function.
     1011   function bge-xml-str-date returns character
     1012   ( input p-date-str as character )
     1013   :
     1014     define variable v-date-str as character no-undo .
     1015     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1016                                                   , output  v-date-str
     1017                                                   ) .
     1018     return v-date-str.
     1019   end function.
     1020   function bge-xml-normalize-dec returns decimal
     1021   ( input p-val as decimal )
     1022   :
     1023     return (if p-val = ? then 0 else p-val) .
     1024   end function.
     1025   PROCEDURE wp-XMLTagOpen:
     1026   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1027   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1028   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1029       define variable v-out-string    as character    no-undo.
     1030   do
     1031   on error undo, return error
     1032   :
     1033       if v-bge-xml-bgefmt = "dbf":U
     1034       then do:
     1035       end.
     1036       else do:
     1037           assign
     1038               v-out-string = substitute( "&1&2<&3&4>"
     1039                                       , chr(10)
     1040                                       , fill( " ":U, 4 * iTagLevel)
     1041                                       , sTagName
     1042                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1043                               )
     1044           .
     1045           put stream stmXMLOut unformatted
     1046               v-out-string
     1047           .
     1048       end.
     1049   end.
     1050   END PROCEDURE.
     1051   PROCEDURE wp-XMLTagPut:
     1052     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1053     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1054     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1055     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1056       define variable v-out-string    as character    no-undo.
     1057   do
     1058   on error undo, return error
     1059   :
     1060       if v-bge-xml-bgefmt = "dbf":U
     1061       then do:
     1062           if v-bge-xml-dbf-file-name <> "":U
     1063           then do:
     1064               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1065               export stream stmXMLOut
     1066                   sTagName
     1067                   sParValue
     1068               .
     1069               output stream stmXMLOut close.
     1070           end.
     1071       end.
     1072       else do:
     1073           IF  iFlagEmpty = 1
     1074           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1075           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1076           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1077           THEN DO:
     1078               run xmlchar-encode in this-procedure (
     1079                   input sParValue
     1080                   , output sParValue
     1081               ).
     1082               assign
     1083                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1084                                               , chr(10)
     1085                                               , FILL(" ", 4 * iTagLevel)
     1086                                               , sTagName
     1087                                               , sParValue
     1088                               )
     1089               .
     1090               PUT STREAM stmXMLOut UNFORMATTED
     1091                   v-out-string
     1092               .
     1093           END.
     1094       end.
     1095   end.
     1096   END PROCEDURE.
     1097   PROCEDURE wp-XMLTagClose:
     1098   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1099   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1100       define variable v-out-string    as character    no-undo.
     1101   do
     1102   on error undo, return error
     1103   :
     1104       if v-bge-xml-bgefmt = "dbf":U
     1105       then do:
     1106       end.
     1107       else do:
     1108           assign
     1109               v-out-string = substitute( "&1&2</&3>"
     1110                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1111                                   , fill( " ", 4 * iTagLevel )
     1112                                   , sTagName
     1113                           )
     1114           .
     1115           PUT STREAM stmXMLOut UNFORMATTED
     1116               v-out-string
     1117           .
     1118       end.
     1119   end.
     1120   END PROCEDURE.
     1121   PROCEDURE wp-XMLWriteLog:
     1122     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1123     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1124     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1125   define variable v-str              as character no-undo .
     1126   define variable v-error-append     as logical   no-undo .
     1127   define variable v-error-append-msg as character no-undo .
     1128   assign
     1129     v-str = chr(10)
     1130             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1131             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1132     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1133     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1134     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1135   .
     1136   run bge/bge-log.p (input v-str) no-error .
     1137   if error-status:error then do:
     1138     assign
     1139       v-error-append     = yes
     1140       v-error-append-msg = return-value
     1141     .
     1142   end.
     1143   run gbl/fileapnd.p
     1144     ( input sFileName
     1145     , input v-str
     1146     , input 10
     1147     ) no-error .
     1148   if error-status:error then do:
     1149     assign
     1150       v-error-append     = yes
     1151       v-error-append-msg = substitute( "&1&2&3"
     1152                                       , v-error-append-msg
     1153                                       , chr(10)
     1154                                       , return-value
     1155                                       )
     1156     .
     1157   end.
     1158   if v-error-append
     1159   then do:
     1160     return error substitute( "&1" , v-error-append-msg ) .
     1161   end.
     1162   END PROCEDURE.
     1163   PROCEDURE wp-XMLWriteEDT:
     1164     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1165     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1166     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1167       if valid-handle ( hEDT )
     1168       then do:
     1169           hEDT :move-to-eof().
     1170           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1171                                           OR sToWrite = "&Line") THEN "" ELSE
     1172                                           cur-time-string-sec() + " ").
     1173           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1174                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1175                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1176           hEDT :insert-string(chr(10)).
     1177       end.
     1178       process events.
     1179       output to 'bgescn.txt' append.
     1180           put unformatted
     1181               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1182                                           OR sToWrite = "&Line") THEN "" ELSE
     1183                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1184               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1185                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1186                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1187           .
     1188       output close.
     1189   END PROCEDURE.
     1190   PROCEDURE wp-XMLShowCNT:
     1191     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1192       if valid-handle( hCNT )
     1193       then do:
     1194           ASSIGN hCNT :VISIBLE = TRUE.
     1195       end.
     1196   END PROCEDURE.
     1197   PROCEDURE wp-XMLHideCNT:
     1198     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1199       if valid-handle( hCNT )
     1200       then do:
     1201           ASSIGN hCNT :VISIBLE = FALSE.
     1202       end.
     1203   END PROCEDURE.
     1204   PROCEDURE wp-XMLWriteCNT:
     1205     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1206     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1207       if valid-handle( hCNT )
     1208       then do:
     1209           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1210       end.
     1211   END PROCEDURE.
     1212   procedure bge-xml-write-header:
     1213   do
     1214   on error undo, return error
     1215   :
     1216   define input parameter p-xml-file-name  as character        no-undo.
     1217   define input parameter p-doc-name       as character        no-undo.
     1218   define input parameter p-version        as character        no-undo.
     1219   define input parameter p-db-num         as integer          no-undo.
     1220   define input parameter p-date-from      as date             no-undo.
     1221   define input parameter p-shift-num-from as integer          no-undo.
     1222   define input parameter p-date-to        as date             no-undo.
     1223   define input parameter p-shift-num-to   as integer          no-undo.
     1224   define input parameter p-obj-list       as character        no-undo.
     1225   define input parameter p-doc-type-list  as character        no-undo.
     1226   define input parameter p-pay-code       as logical          no-undo.
     1227   define input parameter p-cst            as logical          no-undo.
     1228   define input parameter p-parts          as logical          no-undo.
     1229   define input parameter p-chk-pay-code   as logical          no-undo.
     1230   define input parameter p-pay-desk       as logical          no-undo.
     1231   define input parameter p-pay-desk-cards as logical          no-undo.
     1232   define input parameter p-deleted        as logical          no-undo.
     1233   define input parameter p-opened-docs    as logical          no-undo.
     1234   define variable v-out-string    as character    no-undo.
     1235   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1236   assign
     1237       v-out-string = substitute( "&1&2&3"
     1238                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1239                           , chr(10)
     1240                           , "<IBS_Trade_House>":U )
     1241   .
     1242   put stream stmXMLOut unformatted
     1243       v-out-string
     1244   .
     1245   run wp-XMLTagOpen(1, "header","").
     1246   if v-bge-xml-bgeflold = "oracle":u
     1247   then do:
     1248     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1249     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1250     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1251     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1252     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1253   end.
     1254   run wp-XMLTagOpen( 2, "manifest", "").
     1255   run wp-XMLTagOpen( 3, "document", "").
     1256   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1257   run wp-XMLTagput( 4, "description", "", 0).
     1258   run wp-XMLTagput( 4, "version", p-version, 0).
     1259   run wp-XMLTagclose( 3, "document" ).
     1260   run wp-XMLTagclose( 2, "manifest" ).
     1261   run wp-XMLTagclose( 1, "header" ).
     1262   run wp-XMLTagOpen(1, "options","").
     1263   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1264   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1265   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1266   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1267   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1268   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1269   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1270   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1271   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1272   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1273   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1274   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1275   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1276   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1277   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1278   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1279   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1280   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1281   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1282   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1283   run wp-XMLTagClose(1, "options").
     1284   run wp-XMLTagOpen( 1, "body", "" ).
     1285   output stream stmXMLOut close.
     1286   end.
     1287   end procedure.
     1288   procedure xml-bge-write-footer:
     1289   do
     1290   on error undo, return error return-value
     1291   :
     1292   define input parameter p-xml-file-name as character    no-undo.
     1293   define variable v-error-num     as integer           no-undo.
     1294   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1295   run wp-XMLTagClose( 1, "body" ).
     1296   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1297   output stream stmXMLOut close.
     1298   if v-bge-xml-bgeflold = "oracle":u
     1299   then do:
     1300     define variable v-tmp-file-name         as character no-undo .
     1301     define variable v-zip-file-name         as character no-undo .
     1302     define variable v-exch-file-name        as character no-undo .
     1303     define variable v-heap-file-name        as character no-undo .
     1304     define variable v-i                     as integer   no-undo .
     1305     define variable v-file-name             as character no-undo .
     1306     define variable v-arc                   as character no-undo .
     1307     define variable v-str                   as character no-undo .
     1308     define variable v-exch-tmp-file-name    as character no-undo .
     1309     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1310     define variable v-bge-xml-exch-dir      as character no-undo .
     1311     define variable v-bge-xml-heap-dir      as character no-undo .
     1312     define variable v-bge-xml-compress-heap as logical   no-undo .
     1313     define variable v-home-dir              as character no-undo .
     1314     define variable v-os-command            as character no-undo .
     1315     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1316     if v-home-dir = ?
     1317     then do:
     1318       undo, return error substitute( "&1&2&3"
     1319                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1320                                     , chr(10)
     1321                                     , "Обратитесь к администратору.":u
     1322                                     ).
     1323     end.
     1324     assign
     1325       v-home-dir = v-home-dir
     1326     .
     1327     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1328     if error-status :error
     1329     then do:
     1330       undo, return error substitute( "&1&2&3"
     1331                                     , "Неверно задан каталог экспорта.":u
     1332                                     , chr(10)
     1333                                     , "Обратитесь к администратору.":u
     1334                                     ).
     1335     end.
     1336     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1337     if v-bge-xml-exch-dir = ?
     1338     then do:
     1339       undo, return error substitute( "&1&2&3"
     1340                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1341                                     , chr(10)
     1342                                     , "Обратитесь к администратору.":u
     1343                                     ).
     1344     end.
     1345     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1346     if error-status :error
     1347     then do:
     1348       undo, return error substitute( "&1&2&3"
     1349                                     , "Неверно задан каталог экспорта (exch).":u
     1350                                     , chr(10)
     1351                                     , "Обратитесь к администратору.":u
     1352                                     ).
     1353     end.
     1354     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1355     if v-bge-xml-heap-dir = ?
     1356     then do:
     1357       undo, return error substitute( "&1&2&3"
     1358                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1359                                     , chr(10)
     1360                                     , "Обратитесь к администратору.":u
     1361                                     ).
     1362     end.
     1363     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1364     if error-status :error
     1365     then do:
     1366       undo, return error substitute( "&1&2&3"
     1367                                     , "Неверно задан каталог экспорта (heap).":u
     1368                                     , chr(10)
     1369                                     , "Обратитесь к администратору.":u
     1370                                     ).
     1371     end.
     1372     get-key-value section "BGE" key "heap-compress" value v-str.
     1373     assign
     1374       v-i = int(v-str)
     1375     no-error .
     1376     if v-i = ? or v-i = 0
     1377     then do:
     1378       assign
     1379         v-bge-xml-compress-heap = no
     1380       .
     1381     end.
     1382     else do:
     1383       assign
     1384         v-bge-xml-compress-heap = yes
     1385       .
     1386     end.
     1387     assign
     1388       v-arc = search( "exe/7za.exe":u )
     1389     .
     1390     if v-arc = ? or v-arc = ""
     1391     then do:
     1392       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1393     end.
     1394     assign
     1395       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1396       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1397       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1398       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1399       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1400       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1401       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1402     .
     1403     run gbl/del-file.p (input v-tmp-file-name) .
     1404     run gbl/del-file.p (input v-zip-file-name) .
     1405     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1406     if v-error-num > 0
     1407     then do:
     1408         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1409                                      , p-xml-file-name + "xm1":u
     1410                                      , v-tmp-file-name
     1411                                      , v-error-num
     1412                                      ).
     1413     end.
     1414     assign
     1415       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1416                                    , v-arc
     1417                                    , v-zip-file-name
     1418                                    , v-tmp-file-name
     1419                                    )
     1420     .
     1421     os-command silent value ( v-os-command ) .
     1422     run gbl/del-file.p (input v-heap-file-name) .
     1423     if v-bge-xml-compress-heap = no
     1424     then do:
     1425       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1426       if v-error-num > 0
     1427       then do:
     1428           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1429                                        , v-tmp-file-name
     1430                                        , v-heap-file-name
     1431                                        , v-error-num
     1432                                        ) .
     1433       end.
     1434     end.
     1435     else do:
     1436       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1437       if v-error-num > 0
     1438       then do:
     1439           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1440                                        , v-zip-file-name
     1441                                        , v-heap-file-name
     1442                                        , v-error-num
     1443                                        ) .
     1444       end.
     1445     end.
     1446     run gbl/del-file.p (input v-tmp-file-name) .
     1447     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1448     if error-status :error then do:
     1449       undo, return error substitute( "&1&2&3"
     1450                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1451                                     , chr(10)
     1452                                     , "Обратитесь к администратору."
     1453                                     ).
     1454     end.
     1455     run gbl/del-file.p (input v-exch-file-name) .
     1456     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1457     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1458     if v-error-num > 0
     1459     then do:
     1460       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1461                                     , v-zip-file-name
     1462                                     , v-exch-tmp-file-name
     1463                                     , v-error-num
     1464                                     ) .
     1465     end.
     1466     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1467     if v-error-num > 0
     1468     then do:
     1469       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1470                                     , v-exch-tmp-file-name
     1471                                     , v-exch-file-name
     1472                                     , v-error-num
     1473                                     ) .
     1474     end.
     1475     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1476   end.
     1477   else do:
     1478     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1479     if v-error-num > 0
     1480     then do:
     1481       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1482                                     , p-xml-file-name + "xm1"
     1483                                     , p-xml-file-name + "xml"
     1484                                     , v-error-num
     1485                                     ) .
     1486     end.
     1487   end.
     1488   if opsys = "unix"
     1489   then do:
     1490       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1491   end.
     1492   end.
     1493   end procedure.
     1494   procedure xml-bge-filename0:
     1495   define input parameter p-prefix   as character no-undo .
     1496   define input parameter p-name     as character no-undo .
     1497   define input parameter p-shared-process as logical no-undo .
     1498   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1499   define output parameter p-xml-file-name  as character no-undo .
     1500   // define output parameter p-fullfnamenoext as character no-undo .
     1501   define output parameter p-locked         as logical      no-undo.
     1502   define variable v-fullfnamenoext as character no-undo .
     1503   define variable v-fileext        as character no-undo .
     1504   define variable v-fullfname      as character no-undo .
     1505   define variable v-error-num      as integer   no-undo .
     1506   do
     1507   on error undo, return error
     1508   :
     1509     case v-bge-xml-bgeflold :
     1510       when "old" then do:
     1511         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1512         v-fileext       = ".xml":U .
     1513         v-fullfname     = v-fullfnamenoext + v-fileext .
     1514         p-xml-file-name = v-fullfname .
     1515         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1516         if v-error-num > 0 then do:
     1517           return error.
     1518         end.
     1519       end.
     1520       when "var" then do:
     1521         case p-prefix :
     1522           when "doc" then do:
     1523             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1524             v-fileext       = ".xml":U .
     1525             v-fullfname     = v-fullfnamenoext + v-fileext .
     1526             p-xml-file-name = v-fullfname .
     1527           end.
     1528           when "day" then do:
     1529             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1530             v-fileext       = ".xml":U .
     1531             v-fullfname     = v-fullfnamenoext + v-fileext .
     1532             p-xml-file-name = v-fullfname .
     1533           end.
     1534           otherwise do:
     1535             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1536             v-fileext       = ".xml":U .
     1537             v-fullfname     = v-fullfnamenoext + v-fileext .
     1538             p-xml-file-name = v-fullfname .
     1539           end.
     1540         end case.
     1541         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1542         if v-error-num > 0 then do:
     1543           return error.
     1544         end.
     1545       end.
     1546       when "new" then do:
     1547                   run bge/genfname.p (
     1548                       input p-home-dir
     1549                       , input p-prefix
     1550                       , input ""
     1551                       , input "xml"
     1552                       , input ""
     1553                       , output p-xml-file-name
     1554                   ).
     1555       end.
     1556       when "no-parameter" then do:
     1557         if p-shared-process then do:
     1558                       run bge/genfname.p (
     1559                           input p-home-dir
     1560                           , input "d"
     1561                           , input ""
     1562                           , input "xml"
     1563                           , input ""
     1564                           , output p-xml-file-name
     1565                       ).
     1566         end.
     1567         else do:
     1568           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1569           v-fileext       = ".xml":U .
     1570           v-fullfname     = v-fullfnamenoext + v-fileext .
     1571           p-xml-file-name = v-fullfname .
     1572           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1573           if v-error-num > 0 then do:
     1574             return error.
     1575           end.
     1576         end.
     1577       end.
     1578     end case.
     1579     assign
     1580       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1581       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1582     .
     1583   end .
     1584   end procedure .
     1585   procedure xml-bge-filename :
     1586   do
     1587   on error undo, return error
     1588   :
     1589   define input parameter p-prefix             as character    no-undo.
     1590   define input parameter p-name               as character    no-undo.
     1591   define input parameter p-shared-process     as logical      no-undo.
     1592   define output parameter p-xml-file-name     as character    no-undo.
     1593   define output parameter p-log-file-name     as character    no-undo.
     1594   define output parameter p-locked            as logical      no-undo.
     1595   define variable v-home-dir          as character no-undo .
     1596   define variable v-error-num         as integer   no-undo .
     1597   define variable v-bge-xml-heap-dir  as character no-undo .
     1598       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1599       if v-home-dir = ?
     1600       then do:
     1601           message
     1602             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1603             skip(1)
     1604             skip "Обратитесь к администратору."
     1605           view-as alert-box error.
     1606           undo, return error .
     1607       end.
     1608       if v-bge-xml-bgeflold <> "oracle"
     1609       then do:
     1610         assign
     1611             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1612         .
     1613       end.
     1614       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1615       if error-status :error
     1616       then do:
     1617           message
     1618             skip "Неверно задан каталог экспорта."
     1619             skip(1)
     1620             skip "Обратитесь к администратору."
     1621           view-as alert-box error.
     1622           undo, return error .
     1623       end.
     1624       if v-bge-xml-bgefmt = "dbf":U
     1625       then do:
     1626           assign
     1627               p-xml-file-name = v-home-dir
     1628               p-locked        = no
     1629           .
     1630       end.
     1631       else do:
     1632           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1633             output p-xml-file-name, output p-locked) .
     1634       end.
     1635       if v-bge-xml-bgeflold = "oracle"
     1636       then do:
     1637         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1638         if v-bge-xml-heap-dir = ?
     1639         then do:
     1640           undo, return error substitute( "&1&2&3"
     1641                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1642                                         , chr(10)
     1643                                         , "Обратитесь к администратору.":u
     1644                                         ).
     1645         end.
     1646         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1647         if error-status :error
     1648         then do:
     1649           undo, return error substitute( "&1&2&3"
     1650                                         , "Неверно задан каталог экспорта (heap).":u
     1651                                         , chr(10)
     1652                                         , "Обратитесь к администратору.":u
     1653                                         ).
     1654         end.
     1655         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1656           assign
     1657             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1658           .
     1659         end.
     1660         else do:
     1661           assign
     1662             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1663           .
     1664         end.
     1665       end.
     1666       else do:
     1667         assign
     1668             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1669         .
     1670       end.
     1671       assign
     1672          v-bge-xml-static-log-file-name = p-log-file-name
     1673       .
     1674   end.
     1675   end procedure.
     1676   procedure bge-xml-read-config :
     1677   do
     1678   on error undo, return error return-value
     1679   :
     1680   define input  parameter p-last-date as date      no-undo .
     1681   define input  parameter p-db-num    as integer   no-undo .
     1682       define variable v-bgeclall      as character     no-undo.
     1683       define variable v-bgedict       as character     no-undo.
     1684       define variable v-bgeshift      as character     no-undo.
     1685       define variable v-par-type      as character     no-undo.
     1686       define variable v-bgeflnm       as character     no-undo.
     1687       define variable v-bgecliiv      as character     no-undo .
     1688       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1689       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1690       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1691       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1692       define variable v-db-num-str    as character     no-undo .
     1693       define variable v-param-type      as character  no-undo .
     1694       define variable v-value-character as character  no-undo .
     1695       define variable v-value-date      as date       no-undo .
     1696       define variable v-value-decimal   as decimal    no-undo .
     1697       define variable v-value-integer   as integer    no-undo .
     1698       define variable v-value-logical   as logical    no-undo .
     1699       define variable v-tth             as handle      no-undo .
     1700       run adm/shattri.p ( input "get":U
     1701                         , input  '':u
     1702                         , input  0
     1703                         , input  'bge-export':U
     1704                         , input  'bgeclall':U
     1705                         , output v-bgecliiv
     1706                         , output v-value-date
     1707                         , output v-value-decimal
     1708                         , output v-value-integer
     1709                         , output v-value-logical
     1710                         , output v-param-type
     1711                         , input-output table-handle v-tth
     1712                         ) no-error .
     1713       if error-status :error
     1714       then do:
     1715         assign
     1716           v-bge-xml-bgecliiv = no
     1717         .
     1718       end.
     1719       else do:
     1720         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1721       end.
     1722       delete object v-tth.
     1723       assign
     1724           v-bge-xml-bgeclall = no
     1725           v-bge-xml-bgedict  = no
     1726       .
     1727       run adm/shattri.p ( input "get":U
     1728                         , input  '':u
     1729                         , input  0
     1730                         , input  'bge-export':U
     1731                         , input  'bgeclall':U
     1732                         , output v-value-character
     1733                         , output v-value-date
     1734                         , output v-value-decimal
     1735                         , output v-value-integer
     1736                         , output v-value-logical
     1737                         , output v-param-type
     1738                         , input-output table-handle v-tth
     1739                         ) no-error .
     1740       if error-status :error
     1741       then do:
     1742         assign
     1743           v-bge-xml-bgeclall = no
     1744         .
     1745       end.
     1746       else do:
     1747         assign
     1748           v-bge-xml-bgeclall = v-value-logical
     1749         .
     1750       end.
     1751       delete object v-tth.
     1752       run adm/shattri.p ( input "get":U
     1753                         , input  '':u
     1754                         , input  0
     1755                         , input  'bge-export':U
     1756                         , input  'bgedict':U
     1757                         , output v-value-character
     1758                         , output v-value-date
     1759                         , output v-value-decimal
     1760                         , output v-value-integer
     1761                         , output v-value-logical
     1762                         , output v-param-type
     1763                         , input-output table-handle v-tth
     1764                         ) no-error .
     1765       if error-status :error
     1766       then do:
     1767         assign
     1768           v-bge-xml-bgedict = no
     1769         .
     1770       end.
     1771       else do:
     1772         assign
     1773           v-bge-xml-bgedict = v-value-logical
     1774         .
     1775       end.
     1776       delete object v-tth.
     1777       run adm/shattri.p ( input "get":U
     1778                         , input  '':u
     1779                         , input  0
     1780                         , input  'bge-export':U
     1781                         , input  'bgefmt':U
     1782                         , output v-value-character
     1783                         , output v-value-date
     1784                         , output v-value-decimal
     1785                         , output v-value-integer
     1786                         , output v-value-logical
     1787                         , output v-param-type
     1788                         , input-output table-handle v-tth
     1789                         ) no-error .
     1790       if error-status :error
     1791       then do:
     1792         assign
     1793           v-bge-xml-bgefmt  = "xml":U
     1794         .
     1795       end.
     1796       else do:
     1797         assign
     1798           v-bge-xml-bgefmt  = v-value-character
     1799         .
     1800       end.
     1801       delete object v-tth.
     1802       run adm/shattri.p ( input "get":U
     1803                         , input  '':u
     1804                         , input  0
     1805                         , input  'bge-export':U
     1806                         , input  'bgeshift':U
     1807                         , output v-value-character
     1808                         , output v-value-date
     1809                         , output v-value-decimal
     1810                         , output v-value-integer
     1811                         , output v-value-logical
     1812                         , output v-param-type
     1813                         , input-output table-handle v-tth
     1814                         ) no-error .
     1815       if error-status :error
     1816       then do:
     1817         assign
     1818             v-bge-xml-shift-mode = no
     1819         .
     1820       end.
     1821       else do:
     1822         assign
     1823             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1824         .
     1825       end.
     1826       delete object v-tth.
     1827       run adm/shattri.p ( input "get":U
     1828                         , input  '':u
     1829                         , input  0
     1830                         , input  'bge-export':U
     1831                         , input  'bgeflold':U
     1832                         , output v-value-character
     1833                         , output v-value-date
     1834                         , output v-value-decimal
     1835                         , output v-value-integer
     1836                         , output v-value-logical
     1837                         , output v-param-type
     1838                         , input-output table-handle v-tth
     1839                         ) no-error .
     1840       if error-status :error
     1841       then do:
     1842         assign
     1843           v-bge-xml-bgeflold = "no-parameter":U
     1844         .
     1845       end.
     1846       else do:
     1847         assign
     1848           v-bge-xml-bgeflold  = v-value-character
     1849         .
     1850       end.
     1851       delete object v-tth.
     1852       assign
     1853         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1854         v-bge-xml-db-num-str  = v-db-num-str
     1855       .
     1856       if p-last-date <> ?
     1857       then do:
     1858           run adm/shattri.p ( input "get":U
     1859                             , input  '':u
     1860                             , input  0
     1861                             , input  'bge-export':U
     1862                             , input  'bgeflnm':U
     1863                             , output v-value-character
     1864                             , output v-value-date
     1865                             , output v-value-decimal
     1866                             , output v-value-integer
     1867                             , output v-value-logical
     1868                             , output v-param-type
     1869                             , input-output table-handle v-tth
     1870                             ) no-error .
     1871           if error-status :error
     1872           then do:
     1873             assign
     1874               v-bgeflnm = '':U
     1875             .
     1876           end.
     1877           else do:
     1878             assign
     1879               v-bgeflnm = v-value-character
     1880             .
     1881           end.
     1882           delete object v-tth.
     1883           if v-bge-xml-bgeflold = "var"
     1884           then do:
     1885               if v-bgeflnm = ?
     1886               or num-entries( v-bgeflnm ) < 2
     1887               then do:
     1888                   assign
     1889                       v-bge-xml-bgeflold = "new"
     1890                   .
     1891               end.
     1892               else do:
     1893                   assign
     1894                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1895                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1896                   .
     1897                   assign
     1898                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1899                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1900                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1901                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1902                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1903                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1904                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1905                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1906                   .
     1907               end.
     1908           end.
     1909       end.
     1910   end.
     1911   end procedure.
     1912   procedure bge-xml-get-ref-filename :
     1913   define input parameter p-in-file-name       as character        no-undo.
     1914   define output parameter p-home-dir          as character        no-undo.
     1915   define output parameter p-out-file-name     as character        no-undo.
     1916   define output parameter p-locked            as logical          no-undo.
     1917       define variable v-counter       as integer      no-undo.
     1918       define variable v-error-level   as integer      no-undo.
     1919   do
     1920   on error undo, return error
     1921   :
     1922       run bge/bge-ini.p (
     1923             input "bge"
     1924           , output p-home-dir
     1925       ).
     1926       if return-value <> "OK"
     1927       then do:
     1928           undo, return error.
     1929       end.
     1930       assign
     1931           p-home-dir = p-home-dir + "\dict":U
     1932       .
     1933       run bge/dir_cd.p (
     1934           input p-home-dir
     1935           , input "CA"
     1936       ).
     1937       if return-value = "ERROR"
     1938       then do:
     1939           undo, return error.
     1940       end.
     1941       assign
     1942           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     1943       .
     1944       assign
     1945           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     1946       .
     1947       wait-lock:
     1948       do v-counter = 1 TO 3
     1949       :
     1950           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     1951           if p-locked = no
     1952           then do:
     1953               leave wait-lock.
     1954           end.
     1955           else do:
     1956               readkey pause 1.
     1957           end.
     1958       END.
     1959       if p-locked = yes
     1960       then do:
     1961           undo, return error.
     1962       end.
     1963       run bge/os_copy.p (
     1964             input "D":U
     1965           , input p-out-file-name + "xml":U
     1966           , input "":U
     1967           , output v-error-level
     1968       ).
     1969       if v-error-level > 0
     1970       then do:
     1971           undo, return error.
     1972       end.
     1973   end.
     1974   end procedure.
     1975   procedure bge-xml-write-ref-header :
     1976   define input parameter p-bge-name as character        no-undo.
     1977   define input parameter p-file-name as character        no-undo.
     1978       define variable v-out-string    as character    no-undo.
     1979   do
     1980   on error undo, return error
     1981   :
     1982       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     1983       put stream stmXMLOut unformatted
     1984           "<?xml version='1.0' encoding='windows-1251'?>":U
     1985       .
     1986       assign
     1987           v-out-string = substitute( "&1&2"
     1988                               , chr(10)
     1989                               , "<IBS_Trade_House>":U )
     1990       .
     1991       put stream stmXMLOut unformatted
     1992           v-out-string
     1993       .
     1994       run wp-XMLTagOpen( 1, "header", "" ).
     1995       if v-bge-xml-bgeflold = "oracle":u
     1996       then do:
     1997         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1998         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1999         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2000         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2001         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2002       end.
     2003       else do:
     2004         run wp-XMLTagOpen( 2, "delivery", "" ).
     2005         run wp-XMLTagOpen( 3, "to", "" ).
     2006         run wp-XMLTagClose( 3, "to" ).
     2007         run wp-XMLTagOpen( 3, "from", "" ).
     2008         run wp-XMLTagClose( 3, "from" ).
     2009         run wp-XMLTagClose( 2, "delivery" ).
     2010       end.
     2011       run wp-XMLTagOpen( 2, "manifest", "" ).
     2012       run wp-XMLTagOpen( 3, "document", "" ).
     2013       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2014       run wp-XMLTagPut( 4, "description", "", 0 ).
     2015       run wp-XMLTagClose( 3, "document" ).
     2016       run wp-XMLTagClose( 2, "manifest" ).
     2017       run wp-XMLTagClose( 1, "header" ).
     2018       run wp-XMLTagOpen( 1, "body", "" ).
     2019   end.
     2020   end procedure.
     2021   procedure bge-xml-write-ref-footer :
     2022   define input parameter p-file-name as character        no-undo.
     2023       define variable v-error-level   as integer      no-undo.
     2024   do
     2025   on error undo, return error
     2026   :
     2027       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2028       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2029       output stream stmXMLOut close.
     2030       run bge/os_copy.p (
     2031             input "M":U
     2032           , input p-file-name + "xm1":U
     2033           , input p-file-name + "xml":U
     2034           , output v-error-level
     2035       ).
     2036       if v-error-level > 0
     2037       then do:
     2038           undo, return error.
     2039       end.
     2040   end.
     2041   end procedure.
     2042   procedure bge-xml-out-dir :
     2043   define output parameter p-out-dir       as character    no-undo.
     2044   define output parameter p-log-file-name as character    no-undo.
     2045   do
     2046   on error undo, return error
     2047   :
     2048       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2049       if p-out-dir = ?
     2050       then do:
     2051           message
     2052             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2053                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2054             skip(1)
     2055             skip "Обратитесь к администратору."
     2056           view-as alert-box error.
     2057           undo, return error .
     2058       end.
     2059       if v-bge-xml-bgeflold <> "oracle" then assign
     2060         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2061       .
     2062       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2063       if error-status :error  then do:
     2064           run wp-XMLWriteLog in this-procedure (
     2065                 input p-log-file-name
     2066               , input 0
     2067               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2068                                   , p-out-dir
     2069                                   , return-value
     2070                                   , trim( error-status :get-message( 1 ) )
     2071                                   )
     2072           ).
     2073           undo, return error.
     2074       end.
     2075       assign
     2076           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2077           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2078       .
     2079   end.
     2080   end procedure.
     2081   procedure bge-xml-out-dir2 :
     2082   define output parameter p-out-dir       as character    no-undo.
     2083   define output parameter p-out-dirR      as character    no-undo.
     2084   define output parameter p-log-file-name as character    no-undo.
     2085   do
     2086   on error undo, return error
     2087   :
     2088       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2089       if p-out-dir = ?
     2090       then do:
     2091           message
     2092             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2093                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2094             skip(1)
     2095             skip "Обратитесь к администратору."
     2096           view-as alert-box error.
     2097           undo, return error .
     2098       end.
     2099       if v-bge-xml-bgeflold <> "oracle" then assign
     2100             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2101             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2102         .
     2103       else p-out-dirR = p-out-dir .
     2104       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2105       if error-status :error  then do:
     2106           run wp-XMLWriteLog in this-procedure (
     2107                 input p-log-file-name
     2108               , input 0
     2109               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2110                                   , p-out-dir
     2111                                   , return-value
     2112                                   , error-status :get-message( 1 )
     2113                                   )
     2114           ).
     2115           undo, return error.
     2116       end.
     2117       if p-out-dirR <> p-out-dir then do:
     2118         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2119         if error-status :error then do:
     2120           run wp-XMLWriteLog in this-procedure (
     2121                 input p-log-file-name
     2122               , input 0
     2123               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2124                                   , p-out-dirR
     2125                                   , return-value
     2126                                   , error-status :get-message( 1 )
     2127                                   )
     2128           ).
     2129           p-out-dirR = p-out-dir .
     2130         end.
     2131       end .
     2132       assign
     2133         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2134         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2135       .
     2136   end.
     2137   end procedure.
     2138   procedure bge-xml-out-file :
     2139   do
     2140   on error undo, return error
     2141   :
     2142   define input parameter p-out-dir            as character        no-undo.
     2143   define input parameter p-prefix             as character        no-undo.
     2144   define input parameter p-sheduled           as logical          no-undo.
     2145   define output parameter p-xml-file-name     as character        no-undo.
     2146   define output parameter p-locked            as logical          no-undo.
     2147   define variable v-home-dir      as character     no-undo.
     2148   define variable v-error-num     as integer       no-undo.
     2149   define variable v-today             as date         no-undo.
     2150   define variable v-time              as integer      no-undo.
     2151       if v-bge-xml-bgefmt = "dbf":U
     2152       then do:
     2153           assign
     2154               p-xml-file-name = p-out-dir
     2155               p-locked        = no
     2156           .
     2157       end.
     2158       else do:
     2159           if v-bge-xml-bgeflold = "firm":U
     2160           then do:
     2161               run bge/genfname.p (
     2162                     input p-out-dir
     2163                   , input p-prefix
     2164                   , input "":U
     2165                   , input "arj":U
     2166                   , input "":U
     2167                   , output p-xml-file-name
     2168               ).
     2169           end.
     2170           else do:
     2171               run bge/genfname.p (
     2172                     input p-out-dir
     2173                   , input p-prefix
     2174                   , input "":U
     2175                   , input "xml":U
     2176                   , input "":U
     2177                   , output p-xml-file-name
     2178               ).
     2179           end.
     2180           assign
     2181               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2182               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2183           .
     2184       end.
     2185   end.
     2186   end procedure.
     2187   procedure bge-xml-init-ext-doc-type :
     2188       define variable v-counter    as integer      no-undo.
     2189       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2190   do
     2191   for buf_temp_ext-doc-type
     2192   on error undo, return error
     2193   :
     2194       empty temp-table buf_temp_ext-doc-type.
     2195       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2196       :
     2197           create buf_temp_ext-doc-type.
     2198           assign
     2199               buf_temp_ext-doc-type.edt-key               = v-counter
     2200               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2201               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2202           .
     2203       end.
     2204   end.
     2205   end procedure.
     2206   procedure bge-xml-get-decimal-shift-num :
     2207   define input parameter p-shift-date     as date             no-undo.
     2208   define input parameter p-shift-num      as integer          no-undo.
     2209   define output parameter p-shift-decimal as decimal          no-undo.
     2210   do
     2211   on error undo, return error
     2212   :
     2213       assign
     2214           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2215       .
     2216   end.
     2217   end procedure.
     2218   procedure bge-xml-ora-exp-filename :
     2219     define input  parameter p-table-name  as character no-undo .
     2220     define input  parameter p-doc-code    as character no-undo .
     2221     define input  parameter p-obj-code    as integer   no-undo .
     2222     define output parameter p-filename    as character no-undo .
     2223     define output parameter p-seq-num     as integer   no-undo .
     2224     define variable v-ora-exp-seq     as integer   no-undo .
     2225     define variable v-ora-exp-seq-str as character no-undo .
     2226     define variable v-home-dir        as character no-undo.
     2227   do
     2228   on error undo, return error return-value
     2229   :
     2230     if v-bge-xml-bgeflold = "oracle":u
     2231     then do:
     2232       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2233       if v-home-dir = ?
     2234       then do:
     2235         undo, return error substitute( "&1&2&3":U
     2236                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2237                                       , chr(10)
     2238                                       , "Обратитесь к администратору.":U
     2239                                       ).
     2240       end.
     2241       assign
     2242           v-home-dir = v-home-dir
     2243       .
     2244       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2245       if error-status :error
     2246       then do:
     2247         undo, return error substitute( "&1&2&3":U
     2248                                       , "Неверно задан каталог экспорта.":U
     2249                                       , chr(10)
     2250                                       , "Обратитесь к администратору.":U
     2251                                       ).
     2252       end.
     2253       assign
     2254         v-ora-exp-seq = ?
     2255       .
     2256       if  p-table-name <> ? and
     2257           p-doc-code <> ?
     2258       then do:
     2259         run bge/get-oesq.p ( input p-table-name
     2260                            , input p-doc-code
     2261                            , output v-ora-exp-seq
     2262                            ) no-error .
     2263         if error-status :error = yes
     2264         then do:
     2265           undo, return error return-value .
     2266         end.
     2267       end.
     2268       if v-ora-exp-seq = ?
     2269       then do:
     2270         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2271         if error-status :error
     2272         then do:
     2273           undo, return error return-value .
     2274         end.
     2275       end.
     2276       if p-table-name <> ? and
     2277          p-doc-code   <> ?
     2278       then do:
     2279         run bge/oesqdoc.p ( input p-table-name
     2280                           , input p-doc-code
     2281                           , input v-ora-exp-seq
     2282                           ) no-error .
     2283         if error-status :error = yes
     2284         then do:
     2285           undo, return error return-value .
     2286         end.
     2287       end.
     2288       assign
     2289         p-seq-num  = v-ora-exp-seq
     2290         p-filename = substitute("&1/&2-000_&3."
     2291                                , v-home-dir
     2292                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2293                                , string(v-ora-exp-seq , "999999999")
     2294                                )
     2295       .
     2296     end.
     2297   end.
     2298   end procedure.
     2299   procedure bge-xml-date-to-str :
     2300     define input  parameter p-date  as date      no-undo .
     2301     define output parameter p-str   as character no-undo .
     2302   do
     2303   on error undo, return error return-value
     2304   :
     2305     if p-date <> ?
     2306     then do:
     2307       assign
     2308         p-str = substitute( "&1-&2-&3"
     2309                           , string( year(p-date)  , "9999")
     2310                           , string( month(p-date) , "99"  )
     2311                           , string( day(p-date)   , "99"  )
     2312                           )
     2313       .
     2314     end.
     2315     else do:
     2316       assign
     2317         p-str = ?
     2318       .
     2319     end.
     2320   end.
     2321   end procedure.
     2322   procedure bge-xml-date-str-to-str :
     2323     define input  parameter p-date-str  as character no-undo .
     2324     define output parameter p-str       as character no-undo .
     2325     define variable v-date          as date      no-undo .
     2326     define variable v-date-valid    as logical   no-undo .
     2327     define variable v-error-message as character no-undo .
     2328   do
     2329   on error undo, return error return-value
     2330   :
     2331     assign
     2332       p-str = ?
     2333     .
     2334     if p-date-str = ? or p-date-str = ""
     2335     then do:
     2336       return .
     2337     end.
     2338     run strtdate in this-procedure ( input  p-date-str
     2339                                    , output v-date
     2340                                    , output v-date-valid
     2341                                    , output v-error-message
     2342                                    ).
     2343     if v-date-valid <> true
     2344     then do:
     2345       return .
     2346     end.
     2347     assign
     2348       p-str = substitute( "&1-&2-&3"
     2349                         , string( year(v-date)  , "9999")
     2350                         , string( month(v-date) , "99"  )
     2351                         , string( day(v-date)   , "99"  )
     2352                         )
     2353     .
     2354   end.
     2355   end procedure.
     2356   procedure bge-xml-fill-tt-bgecliiv :
     2357     define input  parameter p-str as character no-undo .
     2358     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2359     define buffer buf_clients             for ub.clients.
     2360     define variable v-i         as integer   no-undo .
     2361     define variable v-count     as integer   no-undo .
     2362     define variable v-cli-count as integer   no-undo .
     2363     define variable v-client    as character no-undo .
     2364     define variable v-obj-type  as character no-undo .
     2365     define variable v-obj-code  as integer   no-undo .
     2366   do
     2367   on error undo, return error return-value
     2368   :
     2369     empty temp-table buf_tt-bge-xml-bgecliiv.
     2370     assign
     2371       v-bge-xml-bgecliiv = no
     2372       v-cli-count        = num-entries(p-str,';')
     2373     .
     2374     if v-cli-count > 0
     2375     then do:
     2376       _cli-cycle:
     2377       do v-i = 1 to v-cli-count
     2378       :
     2379         assign
     2380           v-client = entry(v-i , p-str, ';')
     2381         .
     2382         if num-entries(v-client) <> 2
     2383         then do:
     2384           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2385         end.
     2386         assign
     2387           v-obj-type = entry(1, v-client)
     2388         .
     2389         assign
     2390           v-obj-code = integer(entry(2, v-client))
     2391         no-error .
     2392         if error-status :error
     2393         then do:
     2394           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2395         end.
     2396         find first buf_clients no-lock
     2397           where buf_clients.obj-type = v-obj-type
     2398             and buf_clients.obj-code = v-obj-code
     2399         no-error.
     2400         if not available buf_clients
     2401         then do:
     2402           next _cli-cycle.
     2403         end.
     2404         find first buf_tt-bge-xml-bgecliiv no-lock
     2405           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2406             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2407         no-error .
     2408         if available buf_tt-bge-xml-bgecliiv
     2409         then do:
     2410           next _cli-cycle.
     2411         end.
     2412         create buf_tt-bge-xml-bgecliiv.
     2413         assign
     2414           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2415           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2416         .
     2417       end.
     2418     end.
     2419     else do:
     2420       assign
     2421         v-bge-xml-bgecliiv = no
     2422       .
     2423       return .
     2424     end.
     2425     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2426     if available buf_tt-bge-xml-bgecliiv
     2427     then do:
     2428       assign
     2429         v-bge-xml-bgecliiv = yes
     2430       .
     2431     end.
     2432   end.
     2433   end procedure.
     2434   procedure bge-xml-resolve-ext-doc-type :
     2435     define input  parameter p-ext-doc-type      as character no-undo .
     2436     define input  parameter p-obj-type          as character no-undo .
     2437     define input  parameter p-obj-code          as integer   no-undo .
     2438     define output parameter p-out-ext-doc-type  as character no-undo .
     2439     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2440   do
     2441   on error undo, return error return-value
     2442   :
     2443     assign
     2444       p-out-ext-doc-type = p-ext-doc-type
     2445     .
     2446     if p-ext-doc-type <> 'ie':U
     2447     then do:
     2448       return .
     2449     end.
     2450     if v-bge-xml-bgecliiv = yes
     2451     then do:
     2452       find first buf_tt-bge-xml-bgecliiv no-lock
     2453         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2454           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2455       no-error .
     2456       if available buf_tt-bge-xml-bgecliiv
     2457       then do:
     2458         assign
     2459           p-out-ext-doc-type = 'iv':U
     2460         .
     2461       end.
     2462     end.
     2463   end.
     2464   end procedure.
     2465   procedure safe-wp-xmltagput :
     2466     define input  parameter pTagLevel   as integer   no-undo .
     2467     define input  parameter pTagName    as character no-undo .
     2468     define input  parameter pParValue   as character no-undo .
     2469     define input  parameter pFlagEmpty  as integer   no-undo .
     2470   do
     2471   on error undo, return error return-value
     2472   :
     2473     if v-bge-xml-bgeflold = "oracle":u
     2474     then do:
     2475       return .
     2476     end.
     2477     run wp-xmltagput in this-procedure ( input pTagLevel
     2478                                        , input pTagName
     2479                                        , input pParValue
     2480                                        , input pFlagEmpty
     2481                                        ).
     2482   end.
     2483   end procedure.
     2484   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2485   procedure factord :
     2486     define input  parameter p-fact-date            as date    no-undo .
     2487     define input  parameter p-fact-time            as integer no-undo .
     2488     define input  parameter p-fact-num             as integer no-undo .
     2489     define input  parameter p-shift-date           as date    no-undo .
     2490     define input  parameter p-shift-num            as integer no-undo .
     2491     define input  parameter p-shift-on             as logical no-undo .
     2492     define output parameter p-fact-order           as decimal no-undo .
     2493     define output parameter p-shift-end-fact-order as decimal no-undo .
     2494     define output parameter p-day-end-fact-order   as decimal no-undo .
     2495     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     2496     if p-fact-date = ?
     2497     then do:
     2498       return error "Не указана фактическая дата" .
     2499     end.
     2500     define variable v-fact-date-num as integer no-undo .
     2501     assign
     2502       v-fact-date-num = integer(p-fact-date)
     2503     .
     2504     if p-fact-num = ?
     2505     or p-fact-num = 0
     2506     then do:
     2507       return error "Не задан p-fact-num " + string(p-fact-num) .
     2508     end.
     2509     if p-fact-num < 0
     2510     then do:
     2511       return error "Отрицательный fact-num " + string(p-fact-num) .
     2512     end.
     2513     if p-fact-num >= 100000000
     2514     then do:
     2515       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     2516     end.
     2517     if p-shift-on = true
     2518     then do:
     2519       if p-shift-date = ?
     2520       then do:
     2521         return error "Не задана дата смены" .
     2522       end.
     2523       if p-shift-num = ?
     2524       or p-shift-num = 0
     2525       then do:
     2526         return error "Не задан номер смены" .
     2527       end.
     2528     end.
     2529     else do:
     2530       assign
     2531         p-shift-date = p-fact-date
     2532         p-shift-num  = 24
     2533       .
     2534     end.
     2535     define variable v-shift-offset as integer no-undo .
     2536     if p-shift-date = p-fact-date
     2537     then do:
     2538       assign
     2539         v-shift-offset = 1
     2540       .
     2541     end.
     2542     if p-shift-date < p-fact-date
     2543     then do:
     2544       assign
     2545         v-shift-offset = 0
     2546       .
     2547     end.
     2548     if p-shift-date > p-fact-date
     2549     then do:
     2550       message
     2551         vss-workfile vss-revision vss-description skip
     2552         "Неправильная дата закрытия смены" skip
     2553         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     2554         view-as alert-box error .
     2555       undo, return error
     2556         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     2557           ,string(p-fact-date, '99/99/9999':U)
     2558           ,string(p-shift-date, '99/99/9999':U)
     2559           )
     2560       .
     2561     end.
     2562     if p-shift-num < 1
     2563     or p-shift-num > 24
     2564     then do:
     2565       message
     2566         vss-workfile vss-revision vss-description skip
     2567         "Неправильный номер смены" skip
     2568         "p-shift-num" p-shift-num skip
     2569         view-as alert-box error .
     2570       undo, return error return-value .
     2571     end.
     2572     assign
     2573       p-fact-order           = v-fact-date-num
     2574                              + v-shift-offset * 0.5
     2575                              + p-shift-num    * 0.02 - 0.01
     2576                              + p-fact-num     * 0.0000000001
     2577       p-shift-end-fact-order = v-fact-date-num
     2578                              + v-shift-offset * 0.5
     2579                              + p-shift-num    * 0.02
     2580       p-day-end-fact-order   = v-fact-date-num
     2581                              + 0.99
     2582     .
     2583     if p-fact-order           <= v-fact-date-num
     2584     or p-shift-end-fact-order <= v-fact-date-num
     2585     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     2586     or p-shift-end-fact-order >= p-day-end-fact-order
     2587     then do:
     2588       message
     2589         vss-workfile vss-revision vss-description skip
     2590         "Внутренняя ошибка при генерации фактического номера" skip
     2591         "p-fact-date"            p-fact-date            skip
     2592         "p-fact-time"            p-fact-time            skip
     2593         "p-fact-num"             p-fact-num             skip
     2594         "p-shift-date"           p-shift-date           skip
     2595         "p-shift-num"            p-shift-num            skip
     2596         "p-shift-on"             p-shift-on             skip
     2597         "p-shift-end-fact-order" p-shift-end-fact-order skip
     2598         "p-day-end-fact-order"   p-day-end-fact-order   skip
     2599         "v-fact-date-num"        v-fact-date-num        skip
     2600         view-as alert-box error .
     2601       undo, return error return-value .
     2602     end.
     2603   end procedure.
     2604   procedure day-begin-fact-order :
     2605     define input  parameter p-fact-date            as date    no-undo .
     2606     define output parameter p-day-begin-fact-order as decimal no-undo .
     2607     do
     2608     on error undo, return error return-value
     2609     :
     2610       if p-fact-date = ?
     2611       then do:
     2612         assign
     2613           p-day-begin-fact-order = 0
     2614         .
     2615       end.
     2616       else do:
     2617         assign
     2618           p-day-begin-fact-order = integer(p-fact-date)
     2619         .
     2620       end.
     2621     end.
     2622   end procedure.
     2623   procedure factord-max-fact-order :
     2624     define output parameter p-max-fact-order as decimal   no-undo .
     2625     do
     2626     on error undo, return error return-value
     2627     :
     2628       run day-begin-fact-order in this-procedure
     2629         (input  date(1, 1, 5000)
     2630         ,output p-max-fact-order
     2631         ) .
     2632     end.
     2633   end procedure.
     2634   procedure factord-cut-archive :
     2635     define input  parameter p-obj-type             as character no-undo .
     2636     define input  parameter p-obj-code             as integer   no-undo .
     2637     define input  parameter p-fact-date            as date      no-undo .
     2638     define output parameter p-shift-on             as logical   no-undo .
     2639     define output parameter p-shift-date           as date      no-undo .
     2640     define output parameter p-shift-num            as integer   no-undo .
     2641     define output parameter p-day-end-fact-order   as decimal   no-undo .
     2642     define output parameter p-shift-end-fact-order as decimal   no-undo .
     2643     define variable v-fact-order as decimal   no-undo .
     2644     define buffer buf_shift-obj for ub.shift-obj .
     2645     do
     2646     on error undo, return error return-value
     2647     :
     2648   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2649   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2650     (input  p-obj-type
     2651     ,input  p-obj-code
     2652     ,input  'shift-on=request'
     2653     ,output p-shift-on
     2654     ) no-error .
     2655       if error-status :error
     2656       then do:
     2657         message
     2658           vss-workfile vss-revision vss-description skip
     2659           "Ошибка при определении атрибута объекта" skip
     2660           "Объект" p-obj-type p-obj-code skip
     2661           error-status :get-message(1) skip
     2662           return-value skip
     2663           view-as alert-box error .
     2664         undo, return error return-value .
     2665       end.
     2666       if p-shift-on = false
     2667       then do:
     2668         assign
     2669           p-shift-date               = ?
     2670           p-shift-num                = 0
     2671         .
     2672       end.
     2673       else do:
     2674         find first buf_shift-obj share-lock
     2675           where buf_shift-obj.obj-type   = p-obj-type
     2676             and buf_shift-obj.obj-code   = p-obj-code
     2677             and buf_shift-obj.shift-date > p-fact-date
     2678           use-index pi
     2679           no-error .
     2680         if not available buf_shift-obj
     2681         or buf_shift-obj.status_ <> 'зкр':U
     2682         then do:
     2683           message
     2684             vss-workfile vss-revision vss-description skip
     2685             "Невозможно вычислить последнюю смену" skip
     2686             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2687             "Объект" p-obj-type p-obj-code skip
     2688             "Дата" p-fact-date skip
     2689             view-as alert-box error .
     2690           undo, return error return-value .
     2691         end.
     2692         find last buf_shift-obj share-lock
     2693           where buf_shift-obj.obj-type = p-obj-type
     2694             and buf_shift-obj.obj-code = p-obj-code
     2695             and buf_shift-obj.shift-date <= p-fact-date
     2696           use-index pi
     2697           no-error .
     2698         if available buf_shift-obj
     2699         then do:
     2700           if  buf_shift-obj.status_ = 'зкр':U
     2701           then do:
     2702             assign
     2703               p-shift-date = buf_shift-obj.shift-date
     2704               p-shift-num  = buf_shift-obj.shift-num
     2705             .
     2706           end.
     2707           else do:
     2708             message
     2709               vss-workfile vss-revision vss-description skip
     2710               "Невозможно вычислить последнюю смену" skip
     2711               "Статус смены отличен от статуса" 'зкр':U skip
     2712               "Объект" p-obj-type p-obj-code skip
     2713               "Дата" p-fact-date skip
     2714               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2715               view-as alert-box error .
     2716             undo, return error return-value .
     2717           end.
     2718         end.
     2719         else do:
     2720           assign
     2721             p-shift-date = p-fact-date - 1
     2722             p-shift-num  = 1
     2723           .
     2724         end.
     2725       end.
     2726       run factord in this-procedure
     2727         (input  p-fact-date
     2728         ,input  1
     2729         ,input  1
     2730         ,input  p-shift-date
     2731         ,input  p-shift-num
     2732         ,input  p-shift-on
     2733         ,output v-fact-order
     2734         ,output p-shift-end-fact-order
     2735         ,output p-day-end-fact-order
     2736         ) no-error .
     2737       if error-status :error
     2738       then do:
     2739         message
     2740           vss-workfile vss-revision vss-description skip
     2741           "Ошибка при вызове процедуры factord"
     2742           error-status :get-message(1) skip
     2743           return-value skip
     2744           view-as alert-box error .
     2745         undo, return error return-value .
     2746       end.
     2747     end.
     2748   end procedure.
     2749   procedure factord-lock-shift :
     2750     define input  parameter p-obj-type  as character no-undo .
     2751     define input  parameter p-obj-code  as integer   no-undo .
     2752     define input  parameter p-fact-date as date      no-undo .
     2753     define parameter buffer buf_shift-obj for ub.shift-obj .
     2754     define variable v-shift-on      as logical   no-undo .
     2755     define variable v-extra-message as character no-undo .
     2756     define variable v-error as character no-undo .
     2757     do
     2758     on error undo, return error return-value
     2759     :
     2760   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2761   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2762     (input  p-obj-type
     2763     ,input  p-obj-code
     2764     ,input  'shift-on=request'
     2765     ,output v-shift-on
     2766     ) no-error .
     2767       if error-status :error
     2768       then do:
     2769         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2770         undo, return error v-error .
     2771       end.
     2772       if v-shift-on = true
     2773       then do:
     2774         find first buf_shift-obj share-lock
     2775           where buf_shift-obj.obj-type   = p-obj-type
     2776             and buf_shift-obj.obj-code   = p-obj-code
     2777             and buf_shift-obj.shift-date > p-fact-date
     2778           use-index pi
     2779           no-error .
     2780         if not available buf_shift-obj
     2781         or buf_shift-obj.status_ <> 'зкр':U
     2782         then do:
     2783           find last buf_shift-obj
     2784             where buf_shift-obj.obj-type = p-obj-type
     2785               and buf_shift-obj.obj-code = p-obj-code
     2786               and buf_shift-obj.status_  = 'зкр':U
     2787             use-index stts
     2788             no-error .
     2789           if available buf_shift-obj
     2790           then do:
     2791             assign
     2792               v-extra-message =
     2793                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2794                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2795                               )
     2796             .
     2797           end.
     2798           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2799           undo, return error v-error .
     2800         end.
     2801       end.
     2802     end.
     2803   end procedure.
     2804   procedure factord-end-day :
     2805     define input  parameter p-fact-date            as date    no-undo .
     2806     define output parameter p-day-end-fact-order   as decimal no-undo .
     2807     do
     2808     on error undo, return error return-value
     2809     :
     2810       if p-fact-date = ?
     2811       then do:
     2812         return error "Не указана фактическая дата" .
     2813       end.
     2814       assign
     2815         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2816       .
     2817     end.
     2818   end procedure.
     2819   procedure factord-to-date :
     2820     define input  parameter p-fact-order as decimal no-undo .
     2821     define output parameter p-fact-date  as date    no-undo .
     2822     define variable v-ref-date  as date      no-undo .
     2823     define variable v-ref-delta as integer   no-undo .
     2824     do
     2825     on error undo, return error return-value
     2826     :
     2827       if p-fact-order = ?
     2828       or p-fact-order = 0
     2829       then do:
     2830         return error "Не указан fact-order" .
     2831       end.
     2832       assign
     2833         v-ref-date  = date(1, 1, 2000)
     2834       .
     2835       assign
     2836         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2837       .
     2838       assign
     2839         p-fact-date = v-ref-date + v-ref-delta
     2840       .
     2841     end.
     2842   end procedure.
     2843   procedure factord-to-fact-num :
     2844     define input  parameter p-fact-order as decimal no-undo .
     2845     define output parameter p-fact-num   as integer no-undo .
     2846     define variable v-fact-order-trunc as decimal no-undo .
     2847     do
     2848     on error undo, return error return-value
     2849     :
     2850       if p-fact-order = ?
     2851       or p-fact-order = 0
     2852       then do:
     2853         return error "Не указан fact-order" .
     2854       end.
     2855       assign
     2856        v-fact-order-trunc = truncate(p-fact-order, 2)
     2857       .
     2858       assign
     2859         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2860       .
     2861     end.
     2862   end procedure.
     2863   procedure factord-to-shift-num :
     2864     define input  parameter p-fact-order as decimal no-undo .
     2865     define output parameter p-shift-num   as integer no-undo .
     2866     define variable  p-shift-numd  as decimal   no-undo .
     2867     define variable v-fact-order-trunc as decimal no-undo .
     2868     do
     2869     on error undo, return error return-value
     2870     :
     2871       if p-fact-order = ?
     2872       or p-fact-order = 0
     2873       then do:
     2874         return error "Не указан fact-order" .
     2875       end.
     2876       assign
     2877        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2878       .
     2879       if v-fact-order-trunc < 0.5 then do:
     2880         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2881       end.
     2882       assign
     2883         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2884         .
     2885        assign
     2886         p-shift-num = truncate (p-shift-numd , 0)
     2887       .
     2888     end.
     2889   end procedure.
