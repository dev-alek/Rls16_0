     3096                   p-pay-code = buf_store.fbr-pay
     3097               .
     3098           end.
     3099       end.
     3100     end case.
     3101     if p-pay-code = ?
     3102     or p-pay-code = 0
     3103     then do:
     3104   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3105   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3106     (input  p-obj-type
     3107     ,input  p-obj-code
     3108     ,output v-host-code
     3109     )  .
     3110         find first buf_sysconf no-lock
     3111               where buf_sysconf.host-code = v-host-code
     3112         no-error.
     3113         if available buf_sysconf
     3114         then do:
     3115             assign
     3116                 p-pay-code = buf_sysconf.fbr-pay
     3117             .
     3118         end.
     3119     end.
     3120     if p-pay-code = ?
     3121     or p-pay-code = 0
     3122     then do:
     3123   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3124   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     3125     (input  p-obj-type
     3126     ,input  p-obj-code
     3127     ,output p-pay-code
     3128     )  .
