     3063   procedure fbrlib_get-default-pay-code :
     3064   define input parameter p-obj-type   as character        no-undo.
     3065   define input parameter p-obj-code   as integer          no-undo.
     3066   define output parameter p-pay-code  as integer          no-undo.
