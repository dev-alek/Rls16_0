     6547   end procedure.
     6548   define input parameter p-mode       as character    no-undo.
     6549   define input parameter table for temp_bge-xml_goods .
     6550   define input parameter p-file-name  as character    no-undo.
     6551   define variable MarkType as ibs.th.str.marking.Types no-undo.
     6552   MarkType = ObjSrv:Env:Marking:Types.
     6553   define temp-table temp_gds-host-attr no-undo
     6554       field host-code as integer
     6555       field no-envd   as logical
     6556       index pi is primary unique
     6557           host-code
     6558   .
     6559   DEF VAR strPutOut       AS CHAR FORMAT "X(255)" NO-UNDO.
     6560   DEF VAR strHomeDir      AS CHAR                 NO-UNDO.
     6561   DEF VAR strOutFile      AS CHAR                 NO-UNDO.
     6562   DEF VAR sLogFile        AS CHAR                 NO-UNDO.
     6563   DEF VAR iRepeater       AS INT      INIT 0      NO-UNDO.
     6564   DEF VAR bLocked         AS LOGICAL  INIT NO     NO-UNDO.
     6565   DEF VAR ErrorLevel      AS INT                  NO-UNDO.
     6566   define VARIABLE v-gds-attr-value-old as character no-undo.
     6567   define VARIABLE v-gds-attr-type as character no-undo.
     6568   run bge/bge-ini.p ("bge", OUTPUT strHomeDir).
     6569   IF RETURN-VALUE <> "OK" THEN RETURN "ERROR".
     6570   strHomeDir = strHomeDir + "\dict".
     6571   run bge/dir_cd.p (strHomeDir, "CA").
     6572   IF RETURN-VALUE = "ERROR" THEN RETURN "ERROR".
     6573   strOutFile = strHomeDir + "\" + "good" + p-file-name + ".".
     6574   bLocked = (SEARCH (strOutFile + "xml") <> ?).
     6575   DO iRepeater = 1 TO 3 WHILE bLocked:
     6576      bLocked = (SEARCH (strOutFile + "lk") <> ?).
     6577      IF bLocked THEN READKEY PAUSE 1.
     6578   END.
     6579   IF bLocked THEN RETURN "LOCKED".
     6580   run bge/os_copy.p ("D", strOutFile + "xml", "", OUTPUT ErrorLevel).
     6581   IF ErrorLevel > 0 THEN RETURN "ERROR".
     6582   OUTPUT STREAM stmXMLOut TO VALUE(strOutFile + "xm1") CONVERT TARGET "1251".
     6583   ASSIGN sLogFile = strHomeDir + "\" + "Actions.log".
     6584   run wp-XMLWriteLog(sLogFile, 0, "&Line").
     6585   run wp-XMLWriteLog(sLogFile, 1, "Экспорт справочника товаров...").
     6586   run XMLWriteHeaderCat.
     6587   run init-temphost.
     6588   for each temp-obj
     6589   :
     6590       find first temp_gds-host-attr
     6591            where temp_gds-host-attr.host-code = temp-obj.host-code
     6592       no-error.
     6593       if not available temp_gds-host-attr
     6594       then do:
     6595           create temp_gds-host-attr.
     6596           assign
     6597               temp_gds-host-attr.host-code = temp-obj.host-code
     6598           .
     6599       end.
     6600   end.
     6601   IF lookup( "list":U, p-mode ) = 0
     6602   THEN DO:
     6603       FOR EACH ub.goods NO-LOCK
     6604       :
     6605           run XMLWriteGoodsCat in this-procedure (
     6606                 input ub.goods.gds-code
     6607               , input sLogFile
     6608           ).
     6609       END.
     6610   END.
     6611   ELSE DO:
     6612       for each temp_bge-xml_goods
     6613       on error undo, return error
     6614       :
     6615           run XMLWriteGoodsCat in this-procedure (
     6616                 input temp_bge-xml_goods.gds-code
     6617               , input sLogFile
     6618           ).
     6619       end.
     6620   END.
     6621   run wp-XMLTagClose(1, "body").
     6622   run wp-XMLTagClose(0, "IBS_Trade_House").
     6623   OUTPUT STREAM stmXMLOut CLOSE.
     6624   run bge/os_copy.p ("M", strOutFile + "xm1", strOutFile + "xml", OUTPUT ErrorLevel).
     6625   IF ErrorLevel > 0 THEN RETURN "ERROR".
     6626   IF OPSYS = "UNIX" THEN OS-COMMAND SILENT
     6627    chmod 666 value (strOutFile + "xml") 2>/dev/null.
     6628   run wp-XMLWriteLog(sLogFile, 1, "Экспорт справочника товаров завершён.").
     6629   run wp-XMLWriteLog(sLogFile, 0, "&Line").
     6630   return "OK".
     6631   PROCEDURE XMLWriteGoodsCat:
     6632   define input parameter p-gds-code   as integer          no-undo.
     6633   define input parameter sLogFile     as character        no-undo.
     6634   DEF VAR sPut AS CHAR NO-UNDO.
     6635   DEF VAR iBarCode LIKE ub.bar-code.b-code NO-UNDO.
     6636   def var v-vat-pc as decimal decimals 10 init 0 no-undo.
     6637   def var v-slt-pc as decimal decimals 10 init 0 no-undo.
     6638   define variable v-rate-code    as integer      no-undo.
     6639   define variable v-have-attr    as logical      no-undo.
     6640   define buffer buf_goods                 for ub.goods.
     6641   define buffer buf_prod-bc               for ub.prod-bc.
     6642   define buffer buf_bar-code              for ub.bar-code.
     6643   define buffer buf_alc-type              for ub.alc-type.
     6644   define buffer buf_alc-type-gds          for ub.alc-type-gds.
     6645   define buffer buf_temp_gds-host-attr    for temp_gds-host-attr.
     6646     define variable v-gds-mercur         as character no-undo .
     6647     define variable v-gds-perishable     as character no-undo .
     6648   FIND FIRST buf_goods NO-LOCK
     6649        WHERE buf_goods.gds-code = p-gds-code
     6650   .
     6651   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6652   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pgtxvalg in g#library
     6653     (input  buf_goods.gds-code
     6654     ,input  '1':U
     6655     ,input  ?
     6656     ,output v-vat-pc
     6657     ) no-error .
     6658   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6659   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pgtxvalg in g#library
     6660     (input  buf_goods.gds-code
     6661     ,input  '2':U
     6662     ,input  ?
     6663     ,output v-slt-pc
     6664     ) no-error .
     6665   run get-tax-rate-code in this-procedure (
     6666         input buf_goods.gds-code
     6667       , input integer( '1':U )
     6668       , input ?
     6669       , output v-rate-code
     6670   ).
     6671       run gds-attr-value in this-procedure (input Buf_goods.gds-code
     6672                                            ,input 'mercur_FGIS':U
     6673                                            ,output v-gds-mercur
     6674                                            ,output v-gds-attr-type ) no-error .
     6675       run gds-attr-value in this-procedure (input Buf_goods.gds-code
     6676                                            ,input 'perishable':U
     6677                                            ,output v-gds-perishable
     6678                                            ,output v-gds-attr-type ) no-error .
     6679   run wp-XMLTagOpen(2, "good","").
     6680   run wp-XMLTagPut(3, "referenceNo", STRING(buf_goods.gds-code), 0).
     6681   run wp-XMLTagPut(3, "articul", buf_goods.artic, 0).
     6682   if buf_goods.stts <> 0
     6683   then do:
     6684       run wp-XMLTagPut(3, "deleted", "yes", 0).
     6685   end.
     6686       run wp-XMLTagPut(3, "prodtype", buf_goods.prod-type, 0).
     6687       run wp-XMLTagPut(3, "prodcode", buf_goods.prod-code, 0).
     6688   run wp-XMLTagPut(3, "units", buf_goods.unit-base, 0).
     6689   run wp-XMLTagPut(3, "type", buf_goods.gds-type, 0).
     6690   run wp-XMLTagPut(3, "minstock", STRING(buf_goods.min-stock), 0).
     6691   run wp-XMLTagPut(3, "okdp", buf_goods.okdp, 0).
     6692   run wp-XMLTagPut(3, "name", buf_goods.gds-name, 0).
     6693   run wp-XMLTagPut(3, "nameengl", buf_goods.engl-name, 0).
     6694   if lookup( "good-ext":U, p-mode ) <> 0
     6695   then do:
     6696       define variable v-have-recipe          as logical      no-undo.
     6697       define variable v-is-ingredient        as logical      no-undo.
     6698       define variable v-can-be-income        as logical      no-undo.
     6699       define variable v-can-be-write-off     as logical      no-undo.
     6700       run get-fbr-trn-type in this-procedure (
     6701             input buf_goods.gds-code
     6702           , output v-have-recipe
     6703           , output v-is-ingredient
     6704           , output v-can-be-income
     6705           , output v-can-be-write-off
     6706       ).
     6707       run wp-XMLTagPut in this-procedure ( input 3, input "labelname"             , input string( buf_goods.label-name    ), input 0 ).
     6708       run wp-XMLTagPut in this-procedure ( input 3, input trim( "destin           " ), input string( buf_goods.destin        ), input 0 ).
     6709       run wp-XMLTagPut in this-procedure ( input 3, input trim( "attrib           " ), input string( buf_goods.attrib        ), input 0 ).
     6710       run wp-XMLTagPut in this-procedure ( input 3, input trim( "userRule         " ), input string( buf_goods.user-rule     ), input 0 ).
     6711       run wp-XMLTagPut in this-procedure ( input 3, input trim( "sert             " ), input string( buf_goods.sert          ), input 0 ).
     6712       run wp-XMLTagPut in this-procedure ( input 3, input trim( "struct           " ), input string( buf_goods.struct        ), input 0 ).
     6713       run wp-XMLTagPut in this-procedure ( input 3, input trim( "deadline         " ), input string( buf_goods.deadline      ), input 0 ).
     6714       run wp-XMLTagPut in this-procedure ( input 3, input trim( "sort             " ), input string( buf_goods.sort          ), input 0 ).
     6715       run wp-XMLTagPut in this-procedure ( input 3, input trim( "unitCST          " ), input string( buf_goods.unit-cst      ), input 0 ).
     6716       run wp-XMLTagPut in this-procedure ( input 3, input trim( "CSTBaseRate      " ), input string( buf_goods.cst-base-rate ), input 0 ).
     6717       run wp-XMLTagPut in this-procedure ( input 3, input trim( "nationality      " ), input string( buf_goods.nationality   ), input 0 ).
     6718       run wp-XMLTagPut in this-procedure ( input 3, input trim( "normalWastage    " ), input string( buf_goods.normal-wastage), input 0 ).
     6719       run wp-XMLTagPut in this-procedure ( input 3, input trim( "normalWaste      " ), input string( buf_goods.normal-waste  ), input 0 ).
     6720       run wp-XMLTagPut in this-procedure ( input 3, input trim( "haveRecipe       " ), input string( v-have-recipe           ), input 3 ).
     6721       run wp-XMLTagPut in this-procedure ( input 3, input trim( "isIngredient     " ), input string( v-is-ingredient         ), input 3 ).
     6722       run wp-XMLTagPut in this-procedure ( input 3, input trim( "canBeIncome      " ), input string( v-can-be-income         ), input 3 ).
     6723       run wp-XMLTagPut in this-procedure ( input 3, input trim( "canBeWriteOff    " ), input string( v-can-be-write-off      ), input 3 ).
     6724   end.
     6725   run wp-XMLTagPut in this-procedure ( input 3, input "VAT"           , input STRING( v-vat-pc                )   , input 0 ).
     6726   run wp-XMLTagPut in this-procedure ( input 3, input "VATRateCode"   , input STRING( v-rate-code             )   , input 0 ).
     6727   run wp-XMLTagPut in this-procedure ( input 3, input "SLT"           , input STRING( v-slt-pc                )   , input 0 ).
     6728   run wp-XMLTagPut in this-procedure ( input 3, input "country"       , input buf_goods.alpha1                    , input 0 ).
     6729   run wp-XMLTagPut in this-procedure ( input 3, input "margin"        , input STRING( buf_goods.increase-pc   )   , input 0 ).
     6730   find first ub.units no-lock
     6731        where ub.units.unit-name = buf_goods.unit-base
     6732   no-error.
     6733   if available ub.units
     6734   then do:
     6735       run wp-XMLTagPut(3, "unitType", units.type, 0).
     6736   end.
     6737   else do:
     6738       run wp-XMLTagPut(3, "unitType", "", 0).
     6739       run wp-XMLWriteLog(sLogFile, 2, "ERROR! Не найден тип '" + buf_goods.unit-base
     6740               + "' товара '" + STRING(buf_goods.gds-code) + "' или ошибка при поиске").
     6741   end.
     6742     for each buf_bar-code where buf_bar-code.gds-code = buf_goods.gds-code and buf_bar-code.part-code = "" and buf_bar-code.in-code = "" no-lock:
     6743         run wp-XMLTagOpen(3, "barcode", "").
     6744         run wp-XMLTagPut(4, "barcodenum", STRING(buf_bar-code.b-code, "->>>>>>>>>9"),0).
     6745         run wp-XMLTagPut(4, "barcodeclibase", STRING(buf_bar-code.cli-base-rate ),0).
     6746         run wp-XMLTagPut(4, "barcodecliunit", STRING(buf_bar-code.unit-cli ),0).
     6747               for each buf_prod-bc no-lock
     6748                  where buf_prod-bc.b-code = buf_bar-code.b-code
     6749               on error undo, return error
     6750               :
     6751                   run wp-XMLTagOpen(5, "bcode","").
     6752                   run wp-XMLTagPut(6, "bcodeStr"     , string( buf_prod-bc.b-str         ),  0).
     6753                   run wp-XMLTagPut(6, "bcodeOn"      , string( buf_prod-bc.bc-on         ),  0).
     6754                   run wp-XMLTagClose(5, "bcode").
     6755               end.
     6756          run wp-XMLTagClose(3, "barcode").
     6757     end.
     6758   run wp-XMLTagPut(3, "groupcode", STRING(buf_goods.grp-code),0).
     6759   run wp-XMLTagPut(3, "condKeepCode", STRING(buf_goods.cond-keep-code),0).
     6760   run wp-XMLTagPut(3, "unitCli"       , string( buf_goods.unit-cli        ),  0).
     6761   run wp-XMLTagPut(3, "cliBaseRate"   , string( buf_goods.cli-base-rate   ),  0).
     6762   run wp-XMLTagPut(3, "msCart"        , string( buf_goods.ms-cart         ),  0).
     6763   run wp-XMLTagPut(3, "wtCart"        , string( buf_goods.wt-cart         ),  0).
     6764   run wp-XMLTagPut(3, "qntyCart"      , string( buf_goods.qnty-cart       ),  0).
     6765   run wp-XMLTagPut(3, "msBase"        , string( buf_goods.ms-base         ),  0).
     6766   run wp-XMLTagPut(3, "wtBase"        , string( buf_goods.wt-base         ),  0).
     6767   RUN gds-attr-value (
     6768                           INPUT buf_goods.gds-code,
     6769                           INPUT 'alcohol-prod':U,
     6770                           OUTPUT v-gds-attr-value-old,
     6771                           OUTPUT v-gds-attr-type
     6772                           ).
     6773        if v-gds-attr-value-old = "yes" then do:
     6774           for first buf_alc-type-gds where buf_alc-type-gds.gds-code = buf_goods.gds-code no-lock:
     6775               if AVAILABLE buf_alc-type-gds then do:
     6776                  for first buf_alc-type where buf_alc-type.alc-type-inner-code = buf_alc-type-gds.alc-type-inner-code no-lock:
     6777                  run wp-XMLTagOpen(3, "alcAttr","").
     6778                      run wp-XMLTagPut(4, "alcgoods"            , string( "yes"               ),  0).
     6779                      run wp-XMLTagPut(4, "alcprodcode"         , string( buf_alc-type.alc-type-code         ),  0).
     6780                      run wp-XMLTagPut(4, "alcprodname"         , string( buf_alc-type.alc-type-name         ),  0).
     6781                      run wp-XMLTagPut(4, "alcproof"            , string( buf_goods.proof                    ),  0).
     6782                  run wp-XMLTagClose(3, "alcAttr").
     6783                  end.
     6784               end.
     6785           end.
     6786        end.
     6787     run wp-XMLTagPut(3, "comment", buf_goods.PS, 0).
     6788     run wp-XMLTagPut(3, "mercuri"           , string( if v-gds-mercur = "no" then "0" else "1"),  0).
     6789     run wp-XMLTagPut(3, "perishable"        , string( if v-gds-perishable = "no" then "0" else "1"),  0).
     6790     RUN gds-attr-value (
     6791                           INPUT buf_goods.gds-code,
     6792                           INPUT 'mark-type':U,
     6793                           OUTPUT v-gds-attr-value-old,
     6794                           OUTPUT v-gds-attr-type
     6795                           ).
     6796     def var mMark as integer no-undo.
     6797     mMark = MarkType:GetKeyIntDB(v-gds-attr-value-old).
     6798     run wp-XMLTagPut(3, "mark-type"        , if mMark < 0 then  "" else string(mmark),  0).
     6799     RUN gds-attr-value (
     6800                           INPUT buf_goods.gds-code,
     6801                           INPUT 'item-matter-mark':U,
     6802                           OUTPUT v-gds-attr-value-old,
     6803                           OUTPUT v-gds-attr-type
     6804                           ).
     6805     run wp-XMLTagPut(3, "item-matter-mark"        , v-gds-attr-value-old,  0).
     6806   run fill-gds-host-attr in this-procedure (
     6807         input p-gds-code
     6808       , output v-have-attr
     6809   ).
     6810   if v-have-attr = yes
     6811   then do:
     6812       run wp-XMLTagOpen(3, "gdsHostAttr","").
     6813       for each buf_temp_gds-host-attr
     6814          where buf_temp_gds-host-attr.no-envd = yes
     6815       :
     6816           run wp-XMLTagPut(4, "hostCode"     , string( buf_temp_gds-host-attr.host-code  ),  0).
     6817           run wp-XMLTagPut(4, "noENVD"       , string( buf_temp_gds-host-attr.no-ENVD    ),  0).
     6818       end.
     6819       run wp-XMLTagClose(3, "gdsHostAttr").
     6820   end.
     6821   run wp-XMLTagClose(2, "good").
     6822   END PROCEDURE.
     6823   PROCEDURE XMLWriteHeaderCat:
     6824   PUT STREAM stmXMLOut UNFORMATTED "<?xml version='1.0' encoding='windows-1251'?>".
     6825   PUT STREAM stmXMLOut UNFORMATTED chr(10) +
     6826                     '<IBS_Trade_House>'.
     6827   run wp-XMLTagOpen(1, "header","").
     6828   run wp-XMLTagOpen(2, "delivery","").
     6829   run wp-XMLTagOpen(3, "to","").
     6830   run wp-XMLTagClose(3, "to").
     6831   run wp-XMLTagOpen(3, "from","").
     6832   run wp-XMLTagClose(3, "from").
     6833   run wp-XMLTagClose(2, "delivery").
     6834   run wp-XMLTagOpen(2, "manifest","").
     6835   run wp-XMLTagOpen(3, "document","").
     6836   run wp-XMLTagPut(4, "name","good", 0).
     6837   run wp-XMLTagPut(4, "description","", 0).
     6838   run wp-XMLTagClose(3, "document").
     6839   run wp-XMLTagClose(2, "manifest").
     6840   run wp-XMLTagClose(1, "header").
     6841   run wp-XMLTagOpen(1, "body","").
     6842   END PROCEDURE.
     6843   procedure get-tax-rate-code :
     6844   define input parameter p-gds-code   as integer          no-undo.
     6845   define input parameter p-tax-code   as integer          no-undo.
     6846   define input parameter p-date       as date             no-undo.
     6847   define output parameter p-rate-code as integer          no-undo.
     6848       define variable v-today             as date         no-undo.
     6849       define variable v-time              as integer      no-undo.
     6850       define variable v-fact-order        as integer      no-undo.
     6851       define buffer buf_tax-rate-gds      for ub.tax-rate-gds.
     6852   do
     6853   for buf_tax-rate-gds
     6854   on error undo, return error
     6855   :
     6856       run cur-time in this-procedure (
     6857             output v-today
     6858           , output v-time
     6859       ).
     6860       if p-date = ?
     6861       then do:
     6862           assign
     6863               p-date = v-today
     6864           .
     6865       end.
     6866       run factord-end-day in this-procedure (
     6867             input p-date
     6868           , output v-fact-order
     6869       ).
     6870       find last buf_tax-rate-gds no-lock
     6871           where buf_tax-rate-gds.gds-code   = p-gds-code
     6872             and buf_tax-rate-gds.tax-code   = p-tax-code
     6873             and buf_tax-rate-gds.host-code  = 0
     6874             and buf_tax-rate-gds.obj-type   = ""
     6875             and buf_tax-rate-gds.obj-code   = 0
     6876             and buf_tax-rate-gds.fact-order <= v-fact-order
     6877       no-error .
     6878       if not available buf_tax-rate-gds
     6879       then do:
     6880           assign
     6881               p-rate-code = 0
     6882           .
     6883       end.
     6884       else do:
     6885           assign
     6886               p-rate-code = buf_tax-rate-gds.rate-code
     6887           .
     6888       end.
     6889   end.
     6890   end procedure.
     6891   procedure get-fbr-trn-type :
     6892   define input parameter p-gds-code           as integer          no-undo.
     6893   define output parameter p-have-recipe       as logical          no-undo.
     6894   define output parameter p-is-ingredient     as logical          no-undo.
     6895   define output parameter p-can-be-income     as logical          no-undo.
     6896   define output parameter p-can-be-write-off  as logical          no-undo.
     6897       define variable v-is-comp       as logical      no-undo.
     6898       define variable v-trn-type      as character    no-undo.
     6899       define variable v-recipe-type   as character    no-undo.
     6900       define buffer buf_goods         for ub.goods.
     6901       define buffer buf_recipe        for ub.recipe.
     6902       define buffer buf_recipe-gds    for ub.recipe-gds.
     6903   do
     6904   for buf_goods
     6905     , buf_recipe
     6906     , buf_recipe-gds
     6907   on error undo, return error
     6908   :
     6909       find first buf_goods no-lock
     6910            where buf_goods.gds-code = p-gds-code
     6911       .
     6912       assign
     6913           p-have-recipe       = no
     6914           p-is-ingredient     = no
     6915           p-can-be-income     = no
     6916           p-can-be-write-off  = no
     6917       .
     6918       find first buf_recipe no-lock
     6919            where buf_recipe.artic       = buf_goods.artic
     6920              and buf_recipe.prod-type   = buf_goods.prod-type
     6921              and buf_recipe.prod-code   = buf_goods.prod-code
     6922       no-error.
     6923       if available buf_recipe
     6924       then do:
     6925           assign
     6926               p-have-recipe = yes
     6927           .
     6928       end.
     6929       find first buf_recipe-gds no-lock
     6930            where buf_recipe-gds.artic       = buf_goods.artic
     6931              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     6932              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     6933       no-error.
     6934       if available buf_recipe-gds
     6935       then do:
     6936           assign
     6937               p-is-ingredient = yes
     6938           .
     6939       end.
     6940       if p-have-recipe = yes
     6941       then do:
     6942           find first buf_recipe no-lock
     6943                where buf_recipe.artic       = buf_goods.artic
     6944                  and buf_recipe.prod-type   = buf_goods.prod-type
     6945                  and buf_recipe.prod-code   = buf_goods.prod-code
     6946                  and buf_recipe.recipe-type = 'комплектация':U
     6947           no-error.
     6948           if available buf_recipe
     6949           then do:
     6950               assign
     6951                   p-can-be-income    = yes
     6952                   p-can-be-write-off = yes
     6953               .
     6954               return .
     6955           end.
     6956           else do:
     6957               calc-trn-type-by-recipe:
     6958               for each buf_recipe no-lock
     6959                  where buf_recipe.artic       = buf_goods.artic
     6960                    and buf_recipe.prod-type   = buf_goods.prod-type
     6961                    and buf_recipe.prod-code   = buf_goods.prod-code
     6962               on error undo, return error
     6963               :
     6964                   run fbrlib-get-trn-type in this-procedure (
     6965                         input buf_recipe.recipe-code
     6966                       , input recid( buf_goods )
     6967                       , input yes
     6968                       , output v-is-comp
     6969                       , output v-trn-type
     6970                   ).
     6971                   if v-trn-type = 'при':U
     6972                   then do:
     6973                       assign
     6974                           p-can-be-income    = yes
     6975                       .
     6976                   end.
     6977                   if v-trn-type = 'спи':U
     6978                   then do:
     6979                       assign
     6980                           p-can-be-write-off = yes
     6981                       .
     6982                   end.
     6983               end.
     6984           end.
     6985       end.
     6986       if p-is-ingredient = yes
     6987       then do:
     6988           calc-trn-type-by-recipe-gds:
     6989           for each buf_recipe-gds no-lock
     6990              where buf_recipe-gds.artic       = buf_goods.artic
     6991                and buf_recipe-gds.prod-type   = buf_goods.prod-type
     6992                and buf_recipe-gds.prod-code   = buf_goods.prod-code
     6993           on error undo, return error
     6994           :
     6995               run fbrlib-get-recipe-type in this-procedure (
     6996                     input "":U
     6997                   , input buf_recipe-gds.recipe-code
     6998                   , output v-recipe-type
     6999               ).
     7000               if v-recipe-type = 'комплектация':U
     7001               then do:
     7002                   assign
     7003                       p-can-be-income    = yes
     7004                       p-can-be-write-off = yes
     7005                   .
     7006                   return .
     7007               end.
     7008               run fbrlib-get-trn-type in this-procedure (
     7009                     input buf_recipe-gds.recipe-code
     7010                   , input recid( buf_goods )
     7011                   , input yes
     7012                   , output v-is-comp
     7013                   , output v-trn-type
     7014               ).
     7015               if v-trn-type = 'при':U
     7016               then do:
     7017                   assign
     7018                       p-can-be-income    = yes
     7019                   .
     7020               end.
     7021               if v-trn-type = 'спи':U
     7022               then do:
     7023                   assign
     7024                       p-can-be-write-off = yes
     7025                   .
     7026               end.
     7027           end.
     7028       end.
     7029   end.
     7030   end procedure.
     7031   procedure fill-gds-host-attr :
     7032   define input parameter p-gds-code   as integer          no-undo.
     7033   define output parameter p-have-attr as logical          no-undo.
     7034       define buffer buf_gds-host-attr         for ub.gds-host-attr.
     7035       define buffer buf_temp_gds-host-attr    for temp_gds-host-attr.
     7036   do
     7037   for buf_gds-host-attr
     7038     , buf_temp_gds-host-attr
     7039   on error undo, return error
     7040   :
     7041       assign
     7042           p-have-attr = no
     7043       .
     7044       for each buf_temp_gds-host-attr
     7045       :
     7046           find first buf_gds-host-attr no-lock
     7047                where buf_gds-host-attr.host-code = buf_temp_gds-host-attr.host-code
     7048                  and buf_gds-host-attr.gds-code  = p-gds-code
     7049                  and buf_gds-host-attr.attr-code = "no-envd":U
     7050           no-error.
     7051           if not available buf_gds-host-attr
     7052           then do:
     7053               assign
     7054                   buf_temp_gds-host-attr.no-envd = no
     7055               .
     7056           end.
     7057           else do:
     7058               assign
     7059                   buf_temp_gds-host-attr.no-envd = ( buf_gds-host-attr.attr-value = "yes":U )
     7060               .
     7061           end.
     7062           if buf_temp_gds-host-attr.no-envd = yes
     7063           then do:
     7064               assign
     7065                   p-have-attr = yes
     7066               .
     7067           end.
     7068       end.
     7069   end.
     7070   end procedure.
