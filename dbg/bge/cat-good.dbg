     3073     , buf_store
     3074     , buf_sysconf
     3075   on error undo, return error
     3076   :
     3077     case p-obj-type  :
     3078       when 'маг':U then do:
     3079           find first buf_shop no-lock
     3080                 where buf_shop.obj-code = p-obj-code
     3081           no-error.
