      336     end.
      337     os-copy value ("./" + "ad":U + string(p-doc-code) + ".tmp") value ("./" + "ad":U + string(p-doc-code) + ".xml").
      338     os-delete value ("./" + "ad":U +  string(p-doc-code) + ".tmp").
      339     run gbl/filename.p
      340      (              input "./" + "ad":U + string(p-doc-code) + ".xml"
      341                     ,output paroutput-file
      342                     ,output v-path
      343                     ,output v-file-name
      344                     ,output v-file-name-no-ext
      345                     ,output v-file-name-ext
      346                     ) no-error .
      347   end.
      348   procedure write-string :
      349    define input parameter parstring as character no-undo.
      350    put stream add-doc-out unformatted parstring.
      351   end.
