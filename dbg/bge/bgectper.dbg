     1122         .
     1123       end.
     1124     end.
     1125     ON CHOOSE OF MENU-ITEM m-ed-date7-1 in menu m-ed-date7 DO:
     1126       apply "ctrl-b":U to date_from in frame Dialog-Frame .
     1127     END.
     1128     ON CHOOSE OF MENU-ITEM m-ed-date7-2 in menu m-ed-date7 DO:
     1129       apply "ctrl-d":U to date_from in frame Dialog-Frame .
     1130     END.
     1131     ON CHOOSE OF MENU-ITEM m-ed-date7-3 in menu m-ed-date7 DO:
     1132       apply "ctrl-e":U to date_from in frame Dialog-Frame .
     1133     END.
     1134     ON CHOOSE OF MENU-ITEM m-ed-date7-4 in menu m-ed-date7 DO:
     1135       apply "ctrl-f":U to date_from in frame Dialog-Frame .
     1136     END.
