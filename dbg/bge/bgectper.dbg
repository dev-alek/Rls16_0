      580   DEFINE RECTANGLE RECT-1
      581        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      582        SIZE 55.4 BY 7.33.
      583   DEFINE RECTANGLE RECT-2
      584        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      585        SIZE 55.3 BY 2.17.
      586   DEFINE FRAME Dialog-Frame
      587        Btn_OK AT ROW 1.27 COL 1.5
      588        Btn_Cancel AT ROW 1.27 COL 11.5
      589        b-help AT ROW 1.27 COL 47.5
      590        date_from AT ROW 3.13 COL 8.3 COLON-ALIGNED
      591        date_to AT ROW 3.13 COL 25.1 COLON-ALIGNED
      592        ed-object AT ROW 4.97 COL 18.5 NO-LABEL
      593        rs-1 AT ROW 5.03 COL 3 NO-LABEL
      594        bt-sel-host AT ROW 7 COL 15
      595        ed-doc-type AT ROW 12.13 COL 16.3 NO-LABEL
      596        bt-sel-doc-type AT ROW 12.17 COL 52.8
      597        "Типы" VIEW-AS TEXT
      598             SIZE 12 BY .87 AT ROW 12.2 COL 2.1
      599        "договоров" VIEW-AS TEXT
      600             SIZE 12 BY .87 AT ROW 13.07 COL 2.3
      601        RECT-1 AT ROW 4.43 COL 1.9
      602        RECT-2 AT ROW 12 COL 1.5
      603        SPACE(1.44) SKIP(0.24)
      604       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      605            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      606            TITLE "Диапазон дат для экспорта".
      607   ASSIGN
      608          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      609          FRAME Dialog-Frame:HIDDEN           = TRUE.
      610   ASSIGN
      611          ed-doc-type:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      612   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      613   DO:
      614     APPLY "END-ERROR":U TO SELF.
      615   END.
      616   ON CHOOSE OF bt-sel-doc-type IN FRAME Dialog-Frame
      617   DO:
      618       define variable v-cancel     as logical           no-undo.
      619       define variable v-oper-num   as integer           no-undo.
      620       run bge/bgeseltp.w (
      621             input "contract":U
      622           , input p-init-doc-type-list
      623           , output p-doc-type-list
      624           , output v-cancel
      625       ) no-error.
      626       if error-status :error
      627       then do:
      628           message
      629             vss-workfile vss-revision vss-description
      630             skip "Ошибка выбора типов операций."
      631             skip return-value
      632             skip trim(error-status :get-message(1))
      633                  trim(error-status :get-message(2))
      634                  trim(error-status :get-message(3))
      635                  trim(error-status :get-message(4))
      636                  trim(error-status :get-message(5))
      637           view-as alert-box error.
      638           undo, return no-apply .
      639       end.
      640       if v-cancel = yes
      641       then do:
      642           assign
      643               p-doc-type-list = p-init-doc-type-list
      644           .
      645       end.
      646       else do:
      647           assign
      648               p-init-doc-type-list    = p-doc-type-list
      649           .
      650           if p-doc-type-list = ''
      651           then do:
      652               assign
      653                   ed-doc-type :screen-value in frame Dialog-Frame = "Все"
      654               .
      655           end.
      656           else do:
      657               assign
      658                   ed-doc-type :screen-value in frame Dialog-Frame = ''
      659               .
      660               do v-oper-num = 1 to 2
      661               :
      662                   if lookup( v-ext-fin-doc-type-list [v-oper-num * 2], p-init-doc-type-list ) <> 0
      663                   then do:
      664                       assign
      665                           ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
      666                                                       + v-ext-fin-doc-type-list [v-oper-num * 2 - 1] + chr(10)
      667                       .
      668                   end.
      669               end.
      670           end.
      671       end.
      672   END.
      673   ON CHOOSE OF bt-sel-host IN FRAME Dialog-Frame
      674   DO:
      675       assign
      676           rs-1 :screen-value  = "2"
      677       .
      678       define buffer buf_user-host for ub.user-host .
      679       define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      680       find first buf_user-host no-lock
      681         where buf_user-host.db-num    = v-cntxt-db-num
      682           and buf_user-host.user-id   = v-cntxt-userid
      683           and buf_user-host.host-code = v-cntxt-host-code-obj
      684         no-error .
      685       if available buf_user-host
      686       then do:
      687         run userhsts_clear in this-procedure .
      688         run userhsts_append in this-procedure
      689           (input v-cntxt-host-code-obj
      690           ) .
      691       end.
      692       define variable v-user-select as logical   no-undo .
      693   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      694   run userhsts_select-many in this-procedure
      695     (input  parparentproc
      696     ,input  v-cntxt-db-num
      697     ,input  v-cntxt-userid
      698     ,input  v-cntxt-host-code-obj
      699     ,output v-user-select
      700     )  .
      701       if v-user-select <> true
      702       then do:
      703         return no-apply .
      704       end.
      705       run clear-obj-list in this-procedure .
      706       for each buf_userhsts_temp-user-host
      707       :
      708         run fill-obj-list in this-procedure
      709           (input buf_userhsts_temp-user-host.host-code
      710           ) no-error .
      711         if error-status :error
      712         then do:
      713           return no-apply.
      714         end.
      715       end.
      716       assign
      717           v-obj-list = ""
      718       .
      719       for each temp_obj-list:
      720           assign v-obj-list = v-obj-list + (if v-obj-list <> "" then chr(10) else "" )
      721                              + temp_obj-list.obj-type + string( temp_obj-list.obj-code ) + chr(32)
      722                              + temp_obj-list.obj-name
      723                                       .
      724       end.
      725       assign
      726           ed-object :screen-value = v-obj-list
      727       .
      728   END.
      729   ON CHOOSE OF Btn_Cancel IN FRAME Dialog-Frame
      730   DO:
      731       assign
      732           p-cancel = yes
      733       .
      734       apply "window-close" to frame Dialog-Frame.
      735   END.
      736   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      737   DO:
      738       ASSIGN
      739           date_from
      740           date_to
      741           rs-1
      742           date_exp_from = date_from
      743           date_exp_to   = date_to
      744       .
      745       if date_from > date_to
      746       then do:
      747           message
      748               "Даты интервала заданы неверно. "
      749               skip " Нижняя дата интервала должна быть меньше верхней."
      750               skip(1) "Задайте интервал дат правильно или отмените экспорт."
      751           view-as alert-box information.
      752           apply "entry" to date_from.
      753           undo, return no-apply.
      754       end.
      755         case rs-1 :screen-value
      756         :
      757         when "1"
      758         then do:
      759             assign
      760                 p-range = 1
      761                 p-obj-list = ""
      762             .
      763         end.
      764         when "2"
      765         then do:
      766             assign
      767                 p-range = 2
      768             .
      769             assign
      770                 p-obj-list = ""
      771             .
      772             for each temp_obj-list
      773             :
      774                 assign
      775                     p-obj-list = p-obj-list
      776                             + ( if p-obj-list = "" then "" else "," ) + temp_obj-list.obj-type
      777                             + "," + string( temp_obj-list.obj-code )
      778                 .
      779             end.
      780         end.
      781         end case.
      782      APPLY "GO" TO FRAME Dialog-Frame.
      783   END.
      784   ON RETURN OF date_from IN FRAME Dialog-Frame
      785   DO:
      786       APPLY "ENTRY" TO date_to IN FRAME Dialog-Frame.
      787       RETURN NO-APPLY.
      788   END.
      789   ON RETURN OF date_to IN FRAME Dialog-Frame
      790   DO:
      791       APPLY "ENTRY" TO btn_OK IN FRAME Dialog-Frame.
      792       RETURN NO-APPLY.
      793   END.
      794   ON VALUE-CHANGED OF rs-1 IN FRAME Dialog-Frame
      795   DO:
      796   run object-select in this-procedure no-error .
      797   if error-status :error
      798   then do:
      799       undo, return no-apply.
      800   end.
      801   assign
      802       rs-1
      803   .
      804   END.
      805   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      806   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      807   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      808   on help of frame Dialog-Frame
      809   do:
      810     run gbl/app_help.p
      811       (input this-procedure :file-name
      812       ,input ''
      813       ,input ?
      814       ) no-error.
      815     if error-status :error then do:
      816       message
      817         "Ошибка при вызове помощи"
      818         error-status :get-message(1)
      819         view-as alert-box .
      820     end.
      821   end.
      822   run minbtn-set in this-procedure .
      823   on choose of b-help in frame Dialog-Frame
      824   do:
      825     apply "help":u to frame Dialog-Frame .
      826   end.
      827   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      828   procedure minbtn-set :
      829       do
      830           on error undo, return error return-value
      831           :
      832           define variable ii              as integer       no-undo .
      833           define variable fh              as widget-handle no-undo .
      834           define variable hh              as widget-handle no-undo .
      835           define variable v-h             as handle        extent 4 no-undo .
      836           define variable v-name-button   as character     no-undo .
      837           define variable v-help-old-x    as decimal       no-undo .
      838           define variable v-help-old-y    as decimal       no-undo .
      839           define variable v-help-old-size as decimal       no-undo .
      840           define variable v-frame-width   as decimal       no-undo .
      841           define variable jj              as integer       no-undo .
      842           do
      843               on error undo, return error
      844               :
      845               assign
      846                   v-frame-width = frame Dialog-Frame:width - 0.3
      847                   fh            = frame Dialog-Frame:first-child
      848                   hh            = fh:first-child
      849                   ii            = 1
      850                   .
      851               do while valid-handle(hh):
      852                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      853                   do:
      854                       case lc(hh:name) :
      855                           when "b-help" then
      856                               do:
      857                                   hh:load-image-up("cmp/b-help.bmp":u) .
      858                                   hh:load-image-down("cmp/b-help.bmp":u) .
      859                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      860                                   hh:TOOLTIP = "Помощь" .
      861                                   v-help-old-x = hh:column .
      862                                   v-help-old-y = hh:row    .
      863                                   v-help-old-size = hh:width .
      864                                   hh:width-chars = 2.5 .
      865                               end.
      866                           when "b-print" then
      867                               do:
      868                                   hh:load-image("cmp/b-print.bmp":u) .
      869                                   hh:TOOLTIP = "Печать" .
      870                                   v-h[ii] = hh:handle .
      871                                   ii = ii + 1 .
      872                                   hh:width-chars = 3 .
      873                               end.
      874                           when "b-history" or
      875                           when "b-hist" then
      876                               do:
      877                                   hh:load-image("cmp/b-hist.bmp":u) .
      878                                   hh:TOOLTIP = "История" .
      879                                   v-h[ii] = hh:handle .
      880                                   ii = ii + 1 .
      881                                   hh:width-chars = 3 .
      882                               end.
      883                           when "b-sch" then
      884                               do:
      885                                   hh:load-image("cmp/b-sch.bmp":u) .
      886                                   hh:TOOLTIP = "Установка Фильтра" .
      887                                   v-h[ii] = hh:handle .
      888                                   ii = ii + 1 .
      889                                   hh:width-chars = 3 .
      890                               end.
      891                           when "b-hist-user" then
      892                               do:
      893                                   hh:load-image("cmp/b-hist.bmp":u) .
      894                                   hh:TOOLTIP = "История пользователя" .
      895                                   ii = ii + 1 .
      896                               end.
      897                       end case.
      898                   end.
      899                   hh = hh:next-sibling.
      900               end.
      901               b-help:column = v-frame-width - b-help:width-chars.
      902               jj = 0.
      903               repeat ii = 4 to 1 by -1 :
      904                   if valid-handle (v-h[ii] ) then
      905                   do:
      906                       jj  = jj + 1 .
      907                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      908                       v-h[ii]:row    = v-help-old-y .
      909                   end.
      910               end.
      911           end.
      912       end.
      913   end procedure.
      914   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      915   on ' ' of date_from in frame Dialog-Frame
      916   do:
      917     if (can-query (self, "sensitive")
      918        and
      919        self :sensitive = true
      920        )
      921     or (can-query (self, "read-only")
      922        and
      923        self :read-only = false
      924        )
      925     then do:
      926       assign
      927         self :screen-value = ?
      928       .
      929     end.
      930     return no-apply.
      931   end.
      932   on delete-character of date_from in frame Dialog-Frame
      933   do:
      934     if (can-query (self, "sensitive")
      935        and
      936        self :sensitive = true
      937        )
      938     or (can-query (self, "read-only")
      939        and
      940        self :read-only = false
      941        )
      942     then do:
      943       assign
      944         self :screen-value = ?
      945       .
      946     end.
      947     return no-apply.
      948   end.
      949   on ctrl-d of date_from in frame Dialog-Frame
      950   do:
      951     define variable v-curr-sv-date as date no-undo .
      952     if (can-query (self, "sensitive")
      953        and
      954        self :sensitive = true
      955        )
      956     or (can-query (self, "read-only")
      957        and
      958        self :read-only = false
      959        )
      960     then do:
      961       if self :handle <> focus :handle
      962       then do:
      963         apply "entry":u to self .
      964       end.
      965       run gbl/getcurdt.p
      966         (output v-curr-sv-date
      967         ) .
      968       assign
      969         self :screen-value = string(v-curr-sv-date) .
      970       .
      971     end.
      972     return no-apply.
      973   end.
      974   on ctrl-b of date_from in frame Dialog-Frame
      975   do:
      976     if (can-query (self, "sensitive")
      977        and
      978        self :sensitive = true
      979        )
      980     or (can-query (self, "read-only")
      981        and
      982        self :read-only = false
      983        )
      984     then do:
      985       if self :handle <> focus :handle
      986       then do:
      987         apply "entry":u to self .
      988       end.
      989       define variable v-curr-sv-date as date no-undo .
      990       define variable v-new-sv-date  as date no-undo .
      991       assign
      992         v-curr-sv-date = date(self :screen-value) no-error
      993       .
      994       if v-curr-sv-date = ?
      995       then do:
      996         run gbl/getcurdt.p
      997           (output v-curr-sv-date
      998           ) .
      999       end.
     1000       if v-curr-sv-date <> ?
     1001       then do:
     1002         assign
     1003           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1004         .
     1005         assign
     1006           self :screen-value = string(v-new-sv-date) .
     1007         .
     1008       end.
     1009     end.
     1010     return no-apply .
     1011   end.
     1012   on ctrl-e of date_from in frame Dialog-Frame
     1013   do:
     1014     if (can-query (self, "sensitive")
     1015        and
     1016        self :sensitive = true
     1017        )
     1018     or (can-query (self, "read-only")
     1019        and
     1020        self :read-only = false
     1021        )
     1022     then do:
     1023       if self :handle <> focus :handle
     1024       then do:
     1025         apply "entry":u to self .
     1026       end.
     1027       define variable v-curr-sv-date as date no-undo .
     1028       define variable v-new-sv-date  as date no-undo .
     1029       assign
     1030         v-curr-sv-date = date(self :screen-value) no-error
     1031       .
     1032       if v-curr-sv-date = ?
     1033       then do:
     1034         run gbl/getcurdt.p
     1035           (output v-curr-sv-date
     1036           ) .
     1037       end.
     1038       if v-curr-sv-date <> ?
     1039       then do:
     1040         run gbl/lastdate.p
     1041           (input  v-curr-sv-date
     1042           ,output v-new-sv-date
     1043           ).
     1044         assign
     1045           self :screen-value = string(v-new-sv-date) .
     1046         .
     1047       end.
     1048     end.
     1049     return no-apply .
     1050   end.
     1051   on ctrl-f of date_from in frame Dialog-Frame
     1052   do:
     1053     if (can-query (self, "sensitive")
     1054        and
     1055        self :sensitive = true
     1056        )
     1057     or (can-query (self, "read-only")
     1058        and
     1059        self :read-only = false
     1060        )
     1061     then do:
     1062       if self :handle <> focus :handle
     1063       then do:
     1064         apply "entry":u to self .
     1065       end.
     1066       define variable v-ok            as logical   no-undo .
     1067       define variable v-curr-sv-date  as date      no-undo .
     1068       define variable v-description   as character no-undo .
     1069       assign
     1070         v-curr-sv-date = date(self :screen-value) no-error
     1071       .
     1072       if v-curr-sv-date = ?
     1073       then do:
     1074         run gbl/getcurdt.p
     1075           (output v-curr-sv-date
     1076           ) .
     1077       end.
     1078       if v-curr-sv-date <> ?
     1079       then do:
     1080         run gbl/d-inpday.w
     1081           (input ?
     1082           ,input "Выбор даты"
     1083           ,input v-description
     1084           ,input ""
     1085           ,input-output v-curr-sv-date
     1086           ,output v-ok
     1087           ).
     1088         if v-ok = true
     1089         then do:
     1090           assign
     1091             self :screen-value = string(v-curr-sv-date) .
     1092           .
     1093         end.
     1094       end.
     1095     end.
     1096     return no-apply .
     1097   end.
     1098     define MENU m-ed-date7
     1099       MENU-ITEM m-ed-date7-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1100       MENU-ITEM m-ed-date7-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1101       MENU-ITEM m-ed-date7-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1102       MENU-ITEM m-ed-date7-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1103       .
