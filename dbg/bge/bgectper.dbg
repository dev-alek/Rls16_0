        1   DEFINE INPUT PARAMETER parparentproc        AS WIDGET-HANDLE        NO-UNDO.
        2   define input parameter p-init-doc-type-list as character            no-undo.
        3   define output parameter date_exp_from       as date      INIT ?     no-undo.
        4   define output parameter date_exp_to         as date      INIT ?     no-undo.
        5   define output parameter p-range             as integer              no-undo.
        6   define output parameter p-obj-list          as character            no-undo.
        7   define output parameter p-doc-type-list     as character            no-undo.
        8   define output parameter p-cancel            as logical   INIT no    no-undo.
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Выбор параметров для выгрузки договоров.".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define   shared variable g#auto as logical no-undo.
       76   define   shared variable g#news as logical no-undo.
       77   define   shared variable g#oxml as logical no-undo.
       78   define   shared variable g#esys as logical no-undo.
       79   define   shared variable g#news-source-db as integer no-undo.
       80   define   shared variable g#esys-source-esys as integer no-undo.
       81   define   shared variable g#db-num as integer   no-undo .
       82   define   shared variable g#userid as character no-undo .
       83   define   shared variable g#passwd as character no-undo .
       84   procedure proc-alt-shift-f2:
       85     if not ibs.th.gbl.gbl-var:rcode
       86   then
       87     run gbl\inidebug.p .
       88   end.
       89   procedure proc-alt-shift-f3:
       90     run gbl/prvssinf.p
       91       ( input this-procedure
       92       ) .
       93   end.
       94   define variable v-inform-launched as logical no-undo initial false .
       95   procedure proc-alt-shift-f4:
       96     define variable v-action as character no-undo .
       97     if v-inform-launched = false then do:
       98       assign
       99         v-inform-launched = true
      100       .
      101       run gbl/d-inform.w
      102         (  input self
      103         ,  input this-procedure
      104         , output v-action
      105         ) no-error .
      106       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      107       assign
      108         v-inform-launched = false
      109       .
      110     end.
      111   end.
      112   procedure proc-alt-f1:
      113     run gbl/corrhelp.p
      114       (input this-procedure
      115       ) .
      116   end .
      117   on alt-shift-f2 anywhere do:
      118     run proc-alt-shift-f2.
      119   end.
      120   on alt-shift-f3 anywhere do:
      121     run proc-alt-shift-f3 in this-procedure .
      122   end.
      123   on alt-shift-f4 anywhere do:
      124     run proc-alt-shift-f4 in this-procedure.
      125   end.
      126   on alt-f1 anywhere do:
      127     run proc-alt-f1 in this-procedure .
      128   end.
      129   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   procedure cur-time :
      131      define output parameter p-today as date      no-undo .
      132      define output parameter p-time  as integer   no-undo .
      133     do
      134     on error undo, return error
      135     :
      136       define variable v-date1 as date      no-undo .
      137       define variable v-date2 as date      no-undo .
      138       define variable v-time  as integer   no-undo .
      139       assign
      140         v-date1 = today
      141         v-time  = time
      142         v-date2 = today
      143       .
      144       if v-date1 <> v-date2
      145       then do:
      146         assign
      147           v-date1 = today
      148           v-time  = v-time
      149         .
      150       end.
      151       assign
      152         p-today = v-date1
      153         p-time  = v-time
      154       .
      155     end.
      156   end.
      157   function cur-time-date returns character
      158   :
      159     return string(today, '99/99/9999':U) .
      160   end.
      161   function cur-time-mjd returns decimal
      162   :
      163     define variable v-date as date      no-undo .
      164     define variable v-time as integer   no-undo .
      165     run cur-time in this-procedure
      166       (output v-date
      167       ,output v-time
      168       ) .
      169     return integer(v-date) - 2400002 + (v-time / 86400) .
      170   end.
      171   function cur-time-get-ending-index returns integer
      172   (input p-number as integer
      173   )
      174   :
      175     if p-number < 0
      176     or p-number = ?
      177     then do:
      178       return 1 .
      179     end.
      180     define variable v-rest as integer   no-undo .
      181     assign
      182       p-number = p-number modulo 100
      183     .
      184     if p-number < 20
      185     then do:
      186       assign
      187         v-rest = p-number
      188       .
      189     end.
      190     else do:
      191       assign
      192         v-rest = p-number modulo 10
      193       .
      194     end.
      195     case v-rest :
      196       when 1
      197       then do:
      198         return 2 .
      199       end.
      200       when 2 or
      201       when 3 or
      202       when 4
      203       then do:
      204         return 3 .
      205       end.
      206       otherwise do:
      207         return 1 .
      208       end.
      209     end case .
      210   end.
      211   procedure cur-time-mjd-to-date :
      212      define input  parameter i-mjd-diff as decimal no-undo.
      213      define output parameter o-Date     as date    no-undo.
      214      define output parameter o-Time     as integer no-undo.
      215      define variable v-day-number as integer   no-undo .
      216      if    i-mjd-diff < 0
      217         or i-mjd-diff = ?
      218      then do:
      219         return "?" .
      220      end.
      221      assign
      222         v-day-number = truncate(i-mjd-diff,0).
      223         o-Date = date(v-day-number + 2400002).
      224         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      225     .
      226   end.
      227   function cur-time-mjd-to-string returns character
      228   (input p-mjd-diff as decimal
      229   )
      230   :
      231     define variable v-day-number as integer   no-undo .
      232     define variable v-seconds    as integer   no-undo .
      233     define variable v-hour       as integer   no-undo .
      234     define variable v-min        as integer   no-undo .
      235     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      236     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      237     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      238     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      239     if p-mjd-diff < 0
      240     or p-mjd-diff = ?
      241     then do:
      242       return "?" .
      243     end.
      244     assign
      245       v-day-number = integer(truncate(p-mjd-diff,0))
      246       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      247     .
      248     if v-seconds > 86400
      249     then do:
      250       assign
      251         v-seconds = 86400 - 1
      252       .
      253     end.
      254     if v-seconds < 0
      255     then do:
      256       assign
      257         v-seconds = 0
      258       .
      259     end.
      260     assign
      261       v-hour = truncate(v-seconds / 3600, 0)
      262     .
      263     assign
      264       v-seconds = v-seconds modulo 3600
      265     .
      266     assign
      267       v-min = truncate(v-seconds / 60, 0)
      268     .
      269     assign
      270       v-seconds = v-seconds modulo 60
      271     .
      272     return
      273         (if v-day-number <> 0
      274           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      275           else ""
      276         )
      277       + (if v-day-number <> 0 or v-hour <> 0
      278           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      279           else ""
      280         )
      281       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      282           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      283           else ""
      284         )
      285       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      286       .
      287   end.
      288   function cur-time-string returns character
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      297   end.
      298   function cur-time-string-sec returns character
      299   :
      300     define variable v-date as date      no-undo .
      301     define variable v-time as integer   no-undo .
      302     run cur-time in this-procedure
      303       (output v-date
      304       ,output v-time
      305       ) .
      306     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      307   end.
      308   function cur-time-custom  returns character
      309   (input p-prefix as character
      310   ,input p-date-format as character
      311   ,input p-delimiter as character
      312   ,input p-time-format as character
      313   ,input p-suffix as character
      314   )
      315   :
      316     define variable v-date as date      no-undo .
      317     define variable v-time as integer   no-undo .
      318     run cur-time in this-procedure
      319       (output v-date
      320       ,output v-time
      321       ) .
      322     return
      323       p-prefix
      324       + string(v-date, p-date-format)
      325       + p-delimiter
      326       + string(v-time, p-time-format)
      327       + p-suffix
      328       .
      329   end.
      330   function cur-time-print  returns character
      331   :
      332     define variable v-date as date      no-undo .
      333     define variable v-time as integer   no-undo .
      334     run cur-time in this-procedure
      335       (output v-date
      336       ,output v-time
      337       ) .
      338     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      339   end.
      340   function cur-time-datetime returns datetime
      341   :
      342     define variable v-char as character no-undo .
      343     define variable v-datetime as datetime no-undo .
      344     v-char = cur-time-string().
      345     v-datetime = datetime(v-char).
      346     return  v-datetime.
      347   end.
      348   function cur-time-string-msec returns character
      349   :
      350     define variable v-date as datetime  no-undo .
      351     v-date = now.
      352     return string(v-date) .
      353   end.
      354   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      355     define variable v-cntxt-db-num        as integer   no-undo .
      356     define variable v-cntxt-userid        as character no-undo .
      357     define variable v-cntxt-level         as character no-undo .
      358     define variable v-cntxt-host-code-obj as integer   no-undo .
      359     define variable v-cntxt-obj-type      as character no-undo .
      360     define variable v-cntxt-obj-code      as integer   no-undo .
      361     define variable v-cntxt-db-num-obj    as integer   no-undo .
      362     define variable v-cntxt-is-admin      as logical   no-undo .
      363   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   define temp-table userhsts_temp-user-host no-undo
      365     field host-code as integer
      366     index xpk is primary unique host-code
      367     .
      368   procedure userhsts_clear :
      369     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      370     do
      371     on error undo, return error return-value
      372     :
      373       for each buf_userhsts_temp-user-host
      374       on error undo, return error return-value
      375       :
      376         delete buf_userhsts_temp-user-host .
      377       end.
      378     end.
      379   end procedure.
      380   procedure userhsts_object-count :
      381     define output parameter p-total-count as integer   no-undo .
      382     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      383     do
      384     on error undo, return error return-value
      385     :
      386       assign
      387         p-total-count = 0
      388       .
      389       for each buf_userhsts_temp-user-host
      390       on error undo, return error return-value
      391       :
      392         assign
      393           p-total-count = p-total-count + 1
      394         .
      395       end.
      396     end.
      397   end procedure.
      398   procedure userhsts_append :
      399     define input  parameter p-host-code as integer   no-undo .
      400     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      401     do
      402     on error undo, return error return-value
      403     :
      404       find first buf_userhsts_temp-user-host
      405         where buf_userhsts_temp-user-host.host-code = p-host-code
      406         no-error .
      407       if not available buf_userhsts_temp-user-host
      408       then do:
      409         create buf_userhsts_temp-user-host .
      410         assign
      411           buf_userhsts_temp-user-host.host-code = p-host-code
      412         .
      413       end.
      414     end.
      415   end procedure.
      416   procedure userhsts_object-exist :
      417     define output parameter p-object-exist as logical   no-undo .
      418     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      419     do
      420     on error undo, return error return-value
      421     :
      422       find first buf_userhsts_temp-user-host
      423         no-error .
      424       if not available buf_userhsts_temp-user-host
      425       then do:
      426         assign
      427           p-object-exist = false
      428         .
      429       end.
      430       else do:
      431         assign
      432           p-object-exist = true
      433         .
      434       end.
      435     end.
      436   end procedure.
      437   procedure userhsts_transfer :
      438     define input  parameter p-callback-handle as handle no-undo .
      439     define variable vss-description as character no-undo init "userhsts_transfer: Передача списка объектов".
      440     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      441     do
      442     on error undo, return error return-value
      443     :
      444       if valid-handle(p-callback-handle) <> true
      445       then do:
      446         message
      447           vss-workfile vss-revision vss-description skip
      448           "Ошибка задания входных параметров" skip
      449           "Неизвестный указатель на процедуру" skip
      450           view-as alert-box error .
      451         undo, return error return-value .
      452       end.
      453       if p-callback-handle :get-signature("userhsts_append") = ""
      454       then do:
      455         message
      456           vss-workfile vss-revision vss-description skip
      457           "Ошибка задания входных параметров" skip
      458           substitute("В процедуре &1 не найдена внутренняя процедура userhsts_append"
      459                     ,p-callback-handle :file-name
      460                     ) skip
      461           view-as alert-box error .
      462         undo, return error return-value .
      463       end.
      464       for each buf_userhsts_temp-user-host
      465       on error undo, return error return-value
      466       :
      467         run userhsts_append in p-callback-handle
      468           (input  buf_userhsts_temp-user-host.host-code
      469           ) .
      470       end.
      471     end.
      472   end procedure.
