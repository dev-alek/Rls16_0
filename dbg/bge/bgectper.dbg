     1186         apply "entry":u to self .
     1187       end.
     1188       run gbl/getcurdt.p
     1189         (output v-curr-sv-date
     1190         ) .
     1191       assign
     1192         self :screen-value = string(v-curr-sv-date) .
     1193       .
     1194     end.
     1195     return no-apply.
     1196   end.
     1197   on ctrl-b of date_to in frame Dialog-Frame
     1198   do:
     1199     if (can-query (self, "sensitive")
     1200        and
     1201        self :sensitive = true
     1202        )
     1203     or (can-query (self, "read-only")
     1204        and
     1205        self :read-only = false
     1206        )
     1207     then do:
     1208       if self :handle <> focus :handle
     1209       then do:
     1210         apply "entry":u to self .
     1211       end.
     1212       define variable v-curr-sv-date as date no-undo .
     1213       define variable v-new-sv-date  as date no-undo .
     1214       assign
     1215         v-curr-sv-date = date(self :screen-value) no-error
     1216       .
     1217       if v-curr-sv-date = ?
     1218       then do:
     1219         run gbl/getcurdt.p
     1220           (output v-curr-sv-date
     1221           ) .
     1222       end.
     1223       if v-curr-sv-date <> ?
     1224       then do:
     1225         assign
     1226           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1227         .
     1228         assign
     1229           self :screen-value = string(v-new-sv-date) .
     1230         .
     1231       end.
     1232     end.
     1233     return no-apply .
     1234   end.
     1235   on ctrl-e of date_to in frame Dialog-Frame
     1236   do:
     1237     if (can-query (self, "sensitive")
     1238        and
     1239        self :sensitive = true
     1240        )
     1241     or (can-query (self, "read-only")
     1242        and
     1243        self :read-only = false
     1244        )
     1245     then do:
     1246       if self :handle <> focus :handle
     1247       then do:
     1248         apply "entry":u to self .
     1249       end.
     1250       define variable v-curr-sv-date as date no-undo .
     1251       define variable v-new-sv-date  as date no-undo .
     1252       assign
     1253         v-curr-sv-date = date(self :screen-value) no-error
     1254       .
     1255       if v-curr-sv-date = ?
     1256       then do:
     1257         run gbl/getcurdt.p
     1258           (output v-curr-sv-date
     1259           ) .
     1260       end.
     1261       if v-curr-sv-date <> ?
     1262       then do:
     1263         run gbl/lastdate.p
     1264           (input  v-curr-sv-date
     1265           ,output v-new-sv-date
     1266           ).
     1267         assign
     1268           self :screen-value = string(v-new-sv-date) .
     1269         .
     1270       end.
     1271     end.
     1272     return no-apply .
     1273   end.
     1274   on ctrl-f of date_to in frame Dialog-Frame
     1275   do:
     1276     if (can-query (self, "sensitive")
     1277        and
     1278        self :sensitive = true
     1279        )
     1280     or (can-query (self, "read-only")
     1281        and
     1282        self :read-only = false
     1283        )
     1284     then do:
     1285       if self :handle <> focus :handle
     1286       then do:
     1287         apply "entry":u to self .
     1288       end.
     1289       define variable v-ok            as logical   no-undo .
     1290       define variable v-curr-sv-date  as date      no-undo .
     1291       define variable v-description   as character no-undo .
     1292       assign
     1293         v-curr-sv-date = date(self :screen-value) no-error
     1294       .
     1295       if v-curr-sv-date = ?
     1296       then do:
     1297         run gbl/getcurdt.p
     1298           (output v-curr-sv-date
     1299           ) .
     1300       end.
     1301       if v-curr-sv-date <> ?
     1302       then do:
     1303         run gbl/d-inpday.w
     1304           (input ?
     1305           ,input "Выбор даты"
     1306           ,input v-description
     1307           ,input ""
     1308           ,input-output v-curr-sv-date
     1309           ,output v-ok
     1310           ).
     1311         if v-ok = true
     1312         then do:
     1313           assign
     1314             self :screen-value = string(v-curr-sv-date) .
     1315           .
     1316         end.
     1317       end.
     1318     end.
     1319     return no-apply .
     1320   end.
     1321     define MENU m-ed-date9
     1322       MENU-ITEM m-ed-date9-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1323       MENU-ITEM m-ed-date9-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1324       MENU-ITEM m-ed-date9-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1325       MENU-ITEM m-ed-date9-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1326       .
     1327     if date_to :POPUP-MENU in frame Dialog-Frame = ?
     1328     then do:
     1329       ASSIGN
     1330         date_to :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date9 :HANDLE
     1331         date_to :MENU-MOUSE in frame Dialog-Frame = 3
     1332       .
     1333     end.
     1334     define variable v-label-handle9 as handle no-undo .
     1335     assign
     1336       v-label-handle9 = date_to :side-label-handle in frame Dialog-Frame
     1337     .
     1338     if valid-handle (v-label-handle9)
     1339     then do:
     1340       if v-label-handle9 :tooltip = ""
     1341       or v-label-handle9 :tooltip = ?
     1342       then do:
     1343         assign
     1344           v-label-handle9 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1345         .
     1346       end.
     1347     end.
     1348     ON CHOOSE OF MENU-ITEM m-ed-date9-1 in menu m-ed-date9 DO:
     1349       apply "ctrl-b":U to date_to in frame Dialog-Frame .
     1350     END.
     1351     ON CHOOSE OF MENU-ITEM m-ed-date9-2 in menu m-ed-date9 DO:
     1352       apply "ctrl-d":U to date_to in frame Dialog-Frame .
     1353     END.
     1354     ON CHOOSE OF MENU-ITEM m-ed-date9-3 in menu m-ed-date9 DO:
     1355       apply "ctrl-e":U to date_to in frame Dialog-Frame .
     1356     END.
     1357     ON CHOOSE OF MENU-ITEM m-ed-date9-4 in menu m-ed-date9 DO:
     1358       apply "ctrl-f":U to date_to in frame Dialog-Frame .
     1359     END.
     1360   run cur-time in this-procedure ( output v-today
     1361                                  , output v-time
     1362                                  ).
     1363   ASSIGN
     1364       date_from = v-today
     1365       date_to   = v-today
     1366   .
     1367   MAIN-BLOCK:
     1368   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1369      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1370   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1371     run mainmenu_getcntxt in parparentproc
     1372       (output v-cntxt-db-num
     1373       ,output v-cntxt-userid
     1374       ,output v-cntxt-level
     1375       ,output v-cntxt-host-code-obj
     1376       ,output v-cntxt-obj-type
     1377       ,output v-cntxt-obj-code
     1378       ,output v-cntxt-db-num-obj
     1379       ,output v-cntxt-is-admin
     1380       ) .
     1381       run get-host-name in this-procedure ( output v-host-name ) no-error .
     1382       if error-status :error
     1383       then do:
     1384           message
     1385             vss-workfile vss-revision vss-description
     1386             skip "Ошибка при определении имени фирмы"
     1387             skip "Код фирмы:" v-cntxt-host-code-obj
     1388             skip "Имя фирмы будет отображаться как '" + 'орг':U + string( v-cntxt-host-code-obj ) + "'"
     1389             skip return-value
     1390             skip trim(error-status :get-message(1))
     1391                  trim(error-status :get-message(2))
     1392                  trim(error-status :get-message(3))
     1393                  trim(error-status :get-message(4))
     1394                  trim(error-status :get-message(5))
     1395           view-as alert-box warning.
     1396           assign
     1397               v-host-name = 'орг':U + string( v-cntxt-host-code-obj )
     1398           .
     1399       end.
     1400     RUN enable_UI.
     1401       assign
     1402           ed-doc-type :screen-value = chr(10) + "    Все"
     1403       .
     1404      run init-fields in this-procedure .
     1405     WAIT-FOR GO OF FRAME Dialog-Frame.
     1406   END.
     1407   RUN disable_UI.
     1408   PROCEDURE clear-obj-list :
     1409     define buffer buf_temp_obj-list for temp_obj-list .
     1410     do
     1411     on error undo, return error return-value
     1412     :
     1413       for each buf_temp_obj-list
     1414       on error undo, return error return-value
     1415       :
     1416         delete buf_temp_obj-list .
     1417       end.
     1418     end.
     1419   END PROCEDURE.
     1420   PROCEDURE disable_UI :
     1421     HIDE FRAME Dialog-Frame.
     1422   END PROCEDURE.
     1423   PROCEDURE enable_UI :
     1424     DISPLAY date_from date_to ed-object rs-1 ed-doc-type
     1425         WITH FRAME Dialog-Frame.
     1426     ENABLE RECT-1 RECT-2 Btn_OK Btn_Cancel b-help date_from date_to rs-1
     1427            bt-sel-host ed-doc-type bt-sel-doc-type
     1428         WITH FRAME Dialog-Frame.
     1429     VIEW FRAME Dialog-Frame.
     1430   END PROCEDURE.
     1431   PROCEDURE fill-obj-list :
     1432     define input  parameter p-host-code as integer   no-undo .
     1433     do
     1434     on error undo, return error
     1435     :
     1436       define buffer buf_clients for ub.clients.
     1437       find first buf_clients no-lock
     1438         where buf_clients.obj-type = 'орг':U
     1439           and buf_clients.obj-code = p-host-code
     1440         no-error .
     1441       if not available buf_clients
     1442       then do:
     1443         message
     1444           vss-workfile vss-revision vss-description skip
     1445           "Ошибка задания входных параметров" skip
     1446           "Не найдена фирма с кодом" p-host-code skip
     1447           view-as alert-box error .
     1448         undo, return error return-value .
     1449       end.
     1450       create temp_obj-list.
     1451       assign
     1452         temp_obj-list.obj-type = buf_clients.obj-type
     1453         temp_obj-list.obj-code = buf_clients.obj-code
     1454         temp_obj-list.obj-name = buf_clients.obj-name
     1455       .
     1456     end.
     1457   END PROCEDURE.
     1458   PROCEDURE get-host-name :
     1459   do
     1460   on error undo, return error
     1461   :
     1462   define output parameter p-host-name as character    no-undo.
     1463   define buffer buf_clients   for ub.clients.
     1464       find first buf_clients no-lock
     1465            where buf_clients.obj-type = 'орг':U
     1466              and buf_clients.obj-code = v-cntxt-host-code-obj
     1467       no-error.
     1468       if not available buf_clients
     1469       then do:
     1470           message
     1471             vss-workfile vss-revision vss-description
     1472             skip "Не удалось найти текущую фирму"
     1473             skip return-value
     1474             skip trim(error-status :get-message(1))
     1475                  trim(error-status :get-message(2))
     1476                  trim(error-status :get-message(3))
     1477                  trim(error-status :get-message(4))
     1478                  trim(error-status :get-message(5))
     1479           view-as alert-box error.
     1480           undo, return error .
     1481       end.
     1482       else do:
     1483           assign
     1484               p-host-name = buf_clients.obj-name
     1485           .
     1486       end.
     1487   end.
     1488   END PROCEDURE.
     1489   PROCEDURE init-fields :
     1490   do
     1491   on error undo, return error
     1492   :
     1493     define variable v-oper-num     as integer           no-undo.
     1494     define buffer buf_user-host for ub.user-host.
     1495     find first buf_user-host no-lock
     1496       where buf_user-host.db-num    = v-cntxt-db-num
     1497         and buf_user-host.user-id   = v-cntxt-userid
     1498         and buf_user-host.host-code = v-cntxt-host-code-obj
     1499       no-error .
     1500     if available buf_user-host
     1501     then do:
     1502         run clear-obj-list in this-procedure .
     1503         run fill-obj-list in this-procedure
     1504           (input  buf_user-host.host-code
     1505           ) no-error .
     1506     end.
     1507      assign
     1508           p-doc-type-list = p-init-doc-type-list
     1509       .
     1510       assign
     1511           rs-1 :screen-value in frame dialog-frame = "2"
     1512           ed-object :screen-value in frame Dialog-frame = 'орг':U + string( v-cntxt-host-code-obj ) + " " + v-host-name
     1513       .
     1514       assign
     1515           rs-1
     1516       .
     1517       display rs-1
     1518       with frame Dialog-Frame
     1519       .
     1520   if p-init-doc-type-list <> ?
     1521       and p-init-doc-type-list <> ''
     1522       then do:
     1523           do v-oper-num = 1 to 2
     1524           :
     1525               if lookup( v-ext-fin-doc-type-list [v-oper-num * 2], p-init-doc-type-list ) <> 0
     1526               then do:
     1527                   assign
     1528                       ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
     1529                                                   + v-ext-fin-doc-type-list [v-oper-num * 2 - 1] + chr(10)
     1530                   .
     1531               end.
     1532           end.
     1533       end.
     1534   end.
     1535   END PROCEDURE.
     1536   PROCEDURE object-select :
     1537   do
     1538   on error undo, return error
     1539   :
     1540   case rs-1 :screen-value in frame Dialog-frame
     1541   :
     1542       when "1"
     1543       then do:
     1544           assign
     1545               ed-object :screen-value = ""
     1546           .
     1547       end.
     1548       when "2"
     1549       then do:
     1550           for each temp_obj-list
     1551           :
     1552               delete temp_obj-list.
     1553           end.
     1554           create temp_obj-list.
     1555           assign
     1556               temp_obj-list.obj-type = 'орг':U
     1557               temp_obj-list.obj-code = v-cntxt-host-code-obj
     1558               ed-object :screen-value = temp_obj-list.obj-type + string(temp_obj-list.obj-code) + chr(32) + "(":U + v-host-name + ")":U
     1559           .
     1560       end.
     1561   end case.
     1562   end.
     1563   END PROCEDURE.
