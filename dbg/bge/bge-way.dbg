       84   define  temp-table temp-host no-undo
       85     field host-code like ub.store.host-code
       86     index xpk host-code
       87   .
       88   define  temp-table temp-obj no-undo
       89     field obj-type  like ub.clients.obj-type
       90     field obj-code  like ub.clients.obj-code
       91     field host-code like ub.store.host-code
       92     field db-num    like ub.clients.db-num
       93     index xpk  obj-type obj-code
       94     index xie1 host-code
       95     index xie2 db-num host-code
       96   .
       97   procedure init-temphost:
       98     define buffer buf_store   for ub.store .
       99     define buffer buf_shop    for ub.shop .
      100     define buffer buf_clients for ub.clients .
      101     define buffer buf_db for ub.db .
      102     define buffer buf_temp-host for temp-host .
      103     define buffer buf_temp-obj for temp-obj .
      104     do
      105     on error undo, return error return-value
      106     :
      107       for each buf_store
      108       on error undo, return error
      109       :
      110         find first buf_temp-host
      111           where buf_temp-host.host-code = buf_store.host-code
      112           no-error .
      113         if not available buf_temp-host
      114         then do:
      115           create buf_temp-host .
      116           assign
      117             buf_temp-host.host-code = buf_store.host-code
      118           .
      119         end.
      120         find first buf_clients no-lock
      121           where buf_clients.obj-type = 'скл':U
      122             and buf_clients.obj-code = buf_store.obj-code
      123           no-error .
      124         if not available buf_clients
      125         then do:
      126           message
      127             "Ошибка при поиске клиента" skip
      128             "Клиент" 'скл':U buf_store.obj-code skip
      129             view-as alert-box error .
      130           undo, return error .
      131         end.
      132         create buf_temp-obj .
      133         assign
      134           buf_temp-obj.obj-type  = 'скл':U
      135           buf_temp-obj.obj-code  = buf_store.obj-code
      136           buf_temp-obj.host-code = buf_store.host-code
      137           buf_temp-obj.db-num    = buf_clients.db-num
      138         .
      139       end.
      140       for each buf_shop
      141       on error undo, return error
      142       :
      143         find first buf_temp-host
      144           where buf_temp-host.host-code = buf_shop.host-code
      145           no-error .
      146         if not available buf_temp-host
      147         then do:
      148           create buf_temp-host .
      149           assign
      150             buf_temp-host.host-code = buf_shop.host-code
      151           .
      152         end.
      153         find first buf_clients no-lock
      154           where buf_clients.obj-type = 'маг':U
      155             and buf_clients.obj-code = buf_shop.obj-code
      156           no-error .
      157         if not available buf_clients then do:
      158           message
      159             "Ошибка при поиске клиента" skip
      160             "Клиент" 'маг':U buf_shop.obj-code skip
      161             view-as alert-box error .
      162           undo, return error .
      163         end.
      164         create buf_temp-obj .
      165         assign
      166           buf_temp-obj.obj-type  = 'маг':U
      167           buf_temp-obj.obj-code  = buf_shop.obj-code
      168           buf_temp-obj.host-code = buf_shop.host-code
      169           buf_temp-obj.db-num    = buf_clients.db-num
      170         .
      171       end.
      172     end.
      173   end.
      174   define variable vss-include-info1 as character format "X(65)" no-undo
      175   initial "@(#)$Workfile$ $Revision$".
      176   DEF STREAM stmXMLOut.
      177   DEF STREAM stmXMLLog.
      178   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      179   procedure cur-time :
      180      define output parameter p-today as date      no-undo .
      181      define output parameter p-time  as integer   no-undo .
      182     do
      183     on error undo, return error
      184     :
      185       define variable v-date1 as date      no-undo .
      186       define variable v-date2 as date      no-undo .
      187       define variable v-time  as integer   no-undo .
      188       assign
      189         v-date1 = today
      190         v-time  = time
      191         v-date2 = today
      192       .
      193       if v-date1 <> v-date2
      194       then do:
      195         assign
      196           v-date1 = today
      197           v-time  = v-time
      198         .
      199       end.
      200       assign
      201         p-today = v-date1
      202         p-time  = v-time
      203       .
      204     end.
      205   end.
      206   function cur-time-date returns character
      207   :
      208     return string(today, '99/99/9999':U) .
      209   end.
      210   function cur-time-mjd returns decimal
      211   :
      212     define variable v-date as date      no-undo .
      213     define variable v-time as integer   no-undo .
      214     run cur-time in this-procedure
      215       (output v-date
      216       ,output v-time
      217       ) .
      218     return integer(v-date) - 2400002 + (v-time / 86400) .
      219   end.
      220   function cur-time-get-ending-index returns integer
      221   (input p-number as integer
      222   )
      223   :
      224     if p-number < 0
      225     or p-number = ?
      226     then do:
      227       return 1 .
      228     end.
      229     define variable v-rest as integer   no-undo .
      230     assign
      231       p-number = p-number modulo 100
      232     .
      233     if p-number < 20
      234     then do:
      235       assign
      236         v-rest = p-number
      237       .
      238     end.
      239     else do:
      240       assign
      241         v-rest = p-number modulo 10
      242       .
      243     end.
      244     case v-rest :
      245       when 1
      246       then do:
      247         return 2 .
      248       end.
      249       when 2 or
      250       when 3 or
      251       when 4
      252       then do:
      253         return 3 .
      254       end.
      255       otherwise do:
      256         return 1 .
      257       end.
      258     end case .
      259   end.
      260   procedure cur-time-mjd-to-date :
      261      define input  parameter i-mjd-diff as decimal no-undo.
      262      define output parameter o-Date     as date    no-undo.
      263      define output parameter o-Time     as integer no-undo.
      264      define variable v-day-number as integer   no-undo .
      265      if    i-mjd-diff < 0
      266         or i-mjd-diff = ?
      267      then do:
      268         return "?" .
      269      end.
      270      assign
      271         v-day-number = truncate(i-mjd-diff,0).
      272         o-Date = date(v-day-number + 2400002).
      273         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      274     .
      275   end.
      276   function cur-time-mjd-to-string returns character
      277   (input p-mjd-diff as decimal
      278   )
      279   :
      280     define variable v-day-number as integer   no-undo .
      281     define variable v-seconds    as integer   no-undo .
      282     define variable v-hour       as integer   no-undo .
      283     define variable v-min        as integer   no-undo .
      284     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      285     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      286     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      287     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      288     if p-mjd-diff < 0
      289     or p-mjd-diff = ?
      290     then do:
      291       return "?" .
      292     end.
      293     assign
      294       v-day-number = integer(truncate(p-mjd-diff,0))
      295       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      296     .
      297     if v-seconds > 86400
      298     then do:
      299       assign
      300         v-seconds = 86400 - 1
      301       .
      302     end.
      303     if v-seconds < 0
      304     then do:
      305       assign
      306         v-seconds = 0
      307       .
      308     end.
      309     assign
      310       v-hour = truncate(v-seconds / 3600, 0)
      311     .
      312     assign
      313       v-seconds = v-seconds modulo 3600
      314     .
      315     assign
      316       v-min = truncate(v-seconds / 60, 0)
      317     .
      318     assign
      319       v-seconds = v-seconds modulo 60
      320     .
      321     return
      322         (if v-day-number <> 0
      323           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      324           else ""
      325         )
      326       + (if v-day-number <> 0 or v-hour <> 0
      327           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      328           else ""
      329         )
      330       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      331           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      332           else ""
      333         )
      334       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      335       .
      336   end.
      337   function cur-time-string returns character
      338   :
      339     define variable v-date as date      no-undo .
      340     define variable v-time as integer   no-undo .
      341     run cur-time in this-procedure
      342       (output v-date
      343       ,output v-time
      344       ) .
      345     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      346   end.
      347   function cur-time-string-sec returns character
      348   :
      349     define variable v-date as date      no-undo .
      350     define variable v-time as integer   no-undo .
      351     run cur-time in this-procedure
      352       (output v-date
      353       ,output v-time
      354       ) .
      355     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      356   end.
      357   function cur-time-custom  returns character
      358   (input p-prefix as character
      359   ,input p-date-format as character
      360   ,input p-delimiter as character
      361   ,input p-time-format as character
      362   ,input p-suffix as character
      363   )
      364   :
      365     define variable v-date as date      no-undo .
      366     define variable v-time as integer   no-undo .
      367     run cur-time in this-procedure
      368       (output v-date
      369       ,output v-time
      370       ) .
      371     return
      372       p-prefix
      373       + string(v-date, p-date-format)
      374       + p-delimiter
      375       + string(v-time, p-time-format)
      376       + p-suffix
      377       .
      378   end.
      379   function cur-time-print  returns character
      380   :
      381     define variable v-date as date      no-undo .
      382     define variable v-time as integer   no-undo .
      383     run cur-time in this-procedure
      384       (output v-date
      385       ,output v-time
      386       ) .
      387     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      388   end.
      389   function cur-time-datetime returns datetime
      390   :
      391     define variable v-char as character no-undo .
      392     define variable v-datetime as datetime no-undo .
      393     v-char = cur-time-string().
      394     v-datetime = datetime(v-char).
      395     return  v-datetime.
      396   end.
      397   function cur-time-string-msec returns character
      398   :
      399     define variable v-date as datetime  no-undo .
      400     v-date = now.
      401     return string(v-date) .
      402   end.
      403   define variable vss-include-info3 as character format "X(65)" no-undo
      404   initial "@(#)$Workfile$ $Revision$".
      405   procedure xmlchar-test :
      406   define input parameter p-in-string          as character        no-undo.
      407   define output parameter p-out-string-enc    as character        no-undo.
      408   define output parameter p-out-string-dec    as character        no-undo.
      409   do
      410   on error undo, return error
      411   :
      412          run xmlchar-encode in this-procedure
      413       (
      414             input p-in-string
      415           , output p-out-string-enc
      416       ).
      417          run xmlchar-decode in this-procedure
      418       (
      419             input p-out-string-enc
      420           , output p-out-string-dec
      421       ).
      422   end.
      423   end .
      424   procedure xmlchar-encode :
      425   define input parameter p-in-string      as character        no-undo.
      426   define output parameter p-out-string    as character        no-undo.
      427       define variable v-position      as integer      no-undo.
      428       define variable v-current-char  as character    no-undo.
      429   do
      430   on error undo, return error
      431   :
      432       assign
      433           p-out-string = "":U
      434       .
      435       case p-in-string
      436       :
      437           when ?
      438           then do:
      439               assign
      440                   p-out-string = "?":U
      441               .
      442           end.
      443           when "?":U
      444           then do:
      445               assign
      446                   p-out-string = "&#63;":U
      447               .
      448           end.
      449           otherwise do:
      450               do v-position = 1 to length( p-in-string )
      451               :
      452                   assign
      453                       v-current-char = substring( p-in-string, v-position, 1 )
      454                   .
      455                   case v-current-char
      456                   :
      457                       when "&":U
      458                       then do:
      459                           assign
      460                               p-out-string = p-out-string + "&amp;":U
      461                           .
      462                       end.
      463                       when ">":U
      464                       then do:
      465                           assign
      466                               p-out-string = p-out-string + "&gt;":U
      467                           .
      468                       end.
      469                       when "<":U
      470                       then do:
      471                           assign
      472                               p-out-string = p-out-string + "&lt;":U
      473                           .
      474                       end.
      475                       when "'":U
      476                       then do:
      477                           assign
      478                               p-out-string = p-out-string + "&apos;":U
      479                           .
      480                       end.
      481                       when '"':U
      482                       then do:
      483                           assign
      484                               p-out-string = p-out-string + "&quot;":U
      485                           .
      486                       end.
      487                       when chr(1)
      488                       then do:
      489                           assign
      490                               p-out-string = p-out-string + "":U
      491                           .
      492                       end.
      493                       when chr(2)
      494                       then do:
      495                           assign
      496                               p-out-string = p-out-string + "":U
      497                           .
      498                       end.
      499                       when chr(3)
      500                       then do:
      501                           assign
      502                               p-out-string = p-out-string + "":U
      503                           .
      504                       end.
      505                       when chr(4)
      506                       then do:
      507                           assign
      508                               p-out-string = p-out-string + "":U
      509                           .
      510                       end.
      511                       when chr(5)
      512                       then do:
      513                           assign
      514                               p-out-string = p-out-string + "":U
      515                           .
      516                       end.
      517                       when chr(6)
      518                       then do:
      519                           assign
      520                               p-out-string = p-out-string + "":U
      521                           .
      522                       end.
      523                       when chr(7)
      524                       then do:
      525                           assign
      526                               p-out-string = p-out-string + "":U
      527                           .
      528                       end.
      529                       when chr(8)
      530                       then do:
      531                           assign
      532                               p-out-string = p-out-string + "":U
      533                           .
      534                       end.
      535                       when chr(9)
      536                       then do:
      537                           assign
      538                               p-out-string = p-out-string + "":U
      539                           .
      540                       end.
      541                       when chr(29)
      542                       then do:
      543                           assign
      544                               p-out-string = p-out-string + "":U
      545                           .
      546                       end.
      547                       when chr(10)
      548                       then do:
      549                           assign
      550                               p-out-string = p-out-string + "&#10;":U
      551                           .
      552                       end.
      553                       when chr(13)
      554                       then do:
      555                           assign
      556                               p-out-string = p-out-string + "&#13;":U
      557                           .
      558                       end.
      559                       otherwise do:
      560                           assign
      561                               p-out-string = p-out-string + v-current-char
      562                           .
      563                       end.
      564                   end case.
      565               end.
      566           end.
      567       end case.
      568   end.
      569   end .
      570   procedure xmlchar-encode-1c :
      571   define input parameter p-in-string      as character        no-undo.
      572   define output parameter p-out-string    as character        no-undo.
      573       define variable v-position      as integer      no-undo.
      574       define variable v-current-char  as character    no-undo.
      575   do
      576   on error undo, return error
      577   :
      578       assign
      579           p-out-string = "":U
      580       .
      581       case p-in-string
      582       :
      583           when ?
      584           then do:
      585               assign
      586                   p-out-string = "?":U
      587               .
      588           end.
      589           otherwise do:
      590               do v-position = 1 to length( p-in-string )
      591               :
      592                   assign
      593                       v-current-char = substring( p-in-string, v-position, 1 )
      594                   .
      595                   case v-current-char
      596                   :
      597                       when chr(1)
      598                       then do:
      599                           assign
      600                               p-out-string = p-out-string + " ":U
      601                           .
      602                       end.
      603                       when chr(2)
      604                       then do:
      605                           assign
      606                               p-out-string = p-out-string + " ":U
      607                           .
      608                       end.
      609                       when chr(3)
      610                       then do:
      611                           assign
      612                               p-out-string = p-out-string + " ":U
      613                           .
      614                       end.
      615                       when chr(4)
      616                       then do:
      617                           assign
      618                               p-out-string = p-out-string + " ":U
      619                           .
      620                       end.
      621                       when chr(5)
      622                       then do:
      623                           assign
      624                               p-out-string = p-out-string + " ":U
      625                           .
      626                       end.
      627                       when chr(6)
      628                       then do:
      629                           assign
      630                               p-out-string = p-out-string + " ":U
      631                           .
      632                       end.
      633                       when chr(7)
      634                       then do:
      635                           assign
      636                               p-out-string = p-out-string + " ":U
