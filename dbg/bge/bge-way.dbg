     1077   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1078                                             INPUT iFlagEmpty AS INTEGER).
     1079       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1080       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1081           DO:
     1082               IF iFlagEmpty = 0                           THEN RETURN "".
     1083               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1084               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1085               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1086               ELSE RETURN "".
     1087           END.
     1088       ELSE DO:
     1089           run xmlchar-encode in this-procedure (
     1090                 input sToPlace
     1091               , output sToPlace
     1092           ).
     1093           ASSIGN
     1094               sToPlace = sParName + '="' + sToPlace + '"'
     1095           .
     1096           RETURN sToPlace.
     1097       END.
     1098   END FUNCTION.
     1099   function bge-xml-date returns character
     1100   ( input p-date as date )
     1101   :
     1102     define variable v-date-str as character no-undo .
     1103     run bge-xml-date-to-str in this-procedure ( input   p-date
     1104                                               , output  v-date-str
     1105                                               ) .
     1106     return v-date-str.
     1107   end function.
     1108   function bge-xml-str-date returns character
     1109   ( input p-date-str as character )
     1110   :
     1111     define variable v-date-str as character no-undo .
     1112     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1113                                                   , output  v-date-str
     1114                                                   ) .
     1115     return v-date-str.
     1116   end function.
     1117   function bge-xml-normalize-dec returns decimal
     1118   ( input p-val as decimal )
     1119   :
     1120     return (if p-val = ? then 0 else p-val) .
     1121   end function.
     1122   PROCEDURE wp-XMLTagOpen:
     1123   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1124   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1125   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1126       define variable v-out-string    as character    no-undo.
     1127   do
     1128   on error undo, return error
     1129   :
     1130       if v-bge-xml-bgefmt = "dbf":U
     1131       then do:
     1132       end.
     1133       else do:
     1134           assign
     1135               v-out-string = substitute( "&1&2<&3&4>"
     1136                                       , chr(10)
     1137                                       , fill( " ":U, 4 * iTagLevel)
     1138                                       , sTagName
     1139                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1140                               )
     1141           .
     1142           put stream stmXMLOut unformatted
     1143               v-out-string
     1144           .
     1145       end.
     1146   end.
     1147   END PROCEDURE.
     1148   PROCEDURE wp-XMLTagPut:
     1149     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1150     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1151     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1152     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1153       define variable v-out-string    as character    no-undo.
     1154   do
     1155   on error undo, return error
     1156   :
     1157       if v-bge-xml-bgefmt = "dbf":U
     1158       then do:
     1159           if v-bge-xml-dbf-file-name <> "":U
     1160           then do:
     1161               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1162               export stream stmXMLOut
     1163                   sTagName
     1164                   sParValue
     1165               .
     1166               output stream stmXMLOut close.
     1167           end.
     1168       end.
     1169       else do:
     1170           IF  iFlagEmpty = 1
     1171           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1172           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1173           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1174           THEN DO:
     1175               run xmlchar-encode in this-procedure (
     1176                   input sParValue
     1177                   , output sParValue
     1178               ).
     1179               assign
     1180                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1181                                               , chr(10)
     1182                                               , FILL(" ", 4 * iTagLevel)
     1183                                               , sTagName
     1184                                               , sParValue
     1185                               )
     1186               .
     1187               PUT STREAM stmXMLOut UNFORMATTED
     1188                   v-out-string
     1189               .
     1190           END.
     1191       end.
     1192   end.
     1193   END PROCEDURE.
     1194   PROCEDURE wp-XMLTagClose:
     1195   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1196   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1197       define variable v-out-string    as character    no-undo.
     1198   do
     1199   on error undo, return error
     1200   :
     1201       if v-bge-xml-bgefmt = "dbf":U
     1202       then do:
     1203       end.
     1204       else do:
     1205           assign
     1206               v-out-string = substitute( "&1&2</&3>"
     1207                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1208                                   , fill( " ", 4 * iTagLevel )
     1209                                   , sTagName
     1210                           )
     1211           .
     1212           PUT STREAM stmXMLOut UNFORMATTED
     1213               v-out-string
     1214           .
     1215       end.
     1216   end.
     1217   END PROCEDURE.
     1218   PROCEDURE wp-XMLWriteLog:
     1219     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1220     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1221     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1222   define variable v-str              as character no-undo .
     1223   define variable v-error-append     as logical   no-undo .
     1224   define variable v-error-append-msg as character no-undo .
     1225   assign
     1226     v-str = chr(10)
     1227             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1228             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1229     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1230     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1231     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1232   .
     1233   run bge/bge-log.p (input v-str) no-error .
     1234   if error-status:error then do:
     1235     assign
     1236       v-error-append     = yes
     1237       v-error-append-msg = return-value
     1238     .
     1239   end.
     1240   run gbl/fileapnd.p
     1241     ( input sFileName
     1242     , input v-str
     1243     , input 10
     1244     ) no-error .
     1245   if error-status:error then do:
     1246     assign
     1247       v-error-append     = yes
     1248       v-error-append-msg = substitute( "&1&2&3"
     1249                                       , v-error-append-msg
     1250                                       , chr(10)
     1251                                       , return-value
     1252                                       )
     1253     .
     1254   end.
     1255   if v-error-append
     1256   then do:
     1257     return error substitute( "&1" , v-error-append-msg ) .
     1258   end.
     1259   END PROCEDURE.
     1260   PROCEDURE wp-XMLWriteEDT:
     1261     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1262     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1263     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1264       if valid-handle ( hEDT )
     1265       then do:
     1266           hEDT :move-to-eof().
     1267           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1268                                           OR sToWrite = "&Line") THEN "" ELSE
     1269                                           cur-time-string-sec() + " ").
     1270           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1271                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1272                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1273           hEDT :insert-string(chr(10)).
     1274       end.
     1275       process events.
     1276       output to 'bgescn.txt' append.
     1277           put unformatted
     1278               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1279                                           OR sToWrite = "&Line") THEN "" ELSE
     1280                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1281               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1282                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1283                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1284           .
     1285       output close.
     1286   END PROCEDURE.
     1287   PROCEDURE wp-XMLShowCNT:
     1288     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1289       if valid-handle( hCNT )
     1290       then do:
     1291           ASSIGN hCNT :VISIBLE = TRUE.
     1292       end.
     1293   END PROCEDURE.
     1294   PROCEDURE wp-XMLHideCNT:
     1295     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1296       if valid-handle( hCNT )
     1297       then do:
     1298           ASSIGN hCNT :VISIBLE = FALSE.
     1299       end.
     1300   END PROCEDURE.
     1301   PROCEDURE wp-XMLWriteCNT:
     1302     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1303     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1304       if valid-handle( hCNT )
     1305       then do:
     1306           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1307       end.
     1308   END PROCEDURE.
     1309   procedure bge-xml-write-header:
     1310   do
     1311   on error undo, return error
     1312   :
     1313   define input parameter p-xml-file-name  as character        no-undo.
     1314   define input parameter p-doc-name       as character        no-undo.
     1315   define input parameter p-version        as character        no-undo.
     1316   define input parameter p-db-num         as integer          no-undo.
     1317   define input parameter p-date-from      as date             no-undo.
     1318   define input parameter p-shift-num-from as integer          no-undo.
     1319   define input parameter p-date-to        as date             no-undo.
     1320   define input parameter p-shift-num-to   as integer          no-undo.
     1321   define input parameter p-obj-list       as character        no-undo.
     1322   define input parameter p-doc-type-list  as character        no-undo.
     1323   define input parameter p-pay-code       as logical          no-undo.
     1324   define input parameter p-cst            as logical          no-undo.
     1325   define input parameter p-parts          as logical          no-undo.
     1326   define input parameter p-chk-pay-code   as logical          no-undo.
     1327   define input parameter p-pay-desk       as logical          no-undo.
     1328   define input parameter p-pay-desk-cards as logical          no-undo.
     1329   define input parameter p-deleted        as logical          no-undo.
     1330   define input parameter p-opened-docs    as logical          no-undo.
     1331   define variable v-out-string    as character    no-undo.
     1332   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1333   assign
     1334       v-out-string = substitute( "&1&2&3"
     1335                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1336                           , chr(10)
     1337                           , "<IBS_Trade_House>":U )
     1338   .
     1339   put stream stmXMLOut unformatted
     1340       v-out-string
     1341   .
     1342   run wp-XMLTagOpen(1, "header","").
     1343   if v-bge-xml-bgeflold = "oracle":u
     1344   then do:
     1345     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1346     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1347     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1348     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1349     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1350   end.
     1351   run wp-XMLTagOpen( 2, "manifest", "").
     1352   run wp-XMLTagOpen( 3, "document", "").
     1353   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1354   run wp-XMLTagput( 4, "description", "", 0).
     1355   run wp-XMLTagput( 4, "version", p-version, 0).
     1356   run wp-XMLTagclose( 3, "document" ).
     1357   run wp-XMLTagclose( 2, "manifest" ).
     1358   run wp-XMLTagclose( 1, "header" ).
     1359   run wp-XMLTagOpen(1, "options","").
     1360   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1361   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1362   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1363   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1364   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1365   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1366   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1367   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1368   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1369   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1370   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1371   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1372   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1373   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1374   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1375   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1376   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1377   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1378   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1379   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1380   run wp-XMLTagClose(1, "options").
     1381   run wp-XMLTagOpen( 1, "body", "" ).
     1382   output stream stmXMLOut close.
     1383   end.
     1384   end procedure.
     1385   procedure xml-bge-write-footer:
     1386   do
     1387   on error undo, return error return-value
     1388   :
     1389   define input parameter p-xml-file-name as character    no-undo.
     1390   define variable v-error-num     as integer           no-undo.
     1391   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1392   run wp-XMLTagClose( 1, "body" ).
     1393   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1394   output stream stmXMLOut close.
     1395   if v-bge-xml-bgeflold = "oracle":u
     1396   then do:
     1397     define variable v-tmp-file-name         as character no-undo .
     1398     define variable v-zip-file-name         as character no-undo .
     1399     define variable v-exch-file-name        as character no-undo .
     1400     define variable v-heap-file-name        as character no-undo .
     1401     define variable v-i                     as integer   no-undo .
     1402     define variable v-file-name             as character no-undo .
     1403     define variable v-arc                   as character no-undo .
     1404     define variable v-str                   as character no-undo .
     1405     define variable v-exch-tmp-file-name    as character no-undo .
     1406     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1407     define variable v-bge-xml-exch-dir      as character no-undo .
     1408     define variable v-bge-xml-heap-dir      as character no-undo .
     1409     define variable v-bge-xml-compress-heap as logical   no-undo .
     1410     define variable v-home-dir              as character no-undo .
     1411     define variable v-os-command            as character no-undo .
     1412     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1413     if v-home-dir = ?
     1414     then do:
     1415       undo, return error substitute( "&1&2&3"
     1416                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1417                                     , chr(10)
     1418                                     , "Обратитесь к администратору.":u
     1419                                     ).
     1420     end.
     1421     assign
     1422       v-home-dir = v-home-dir
     1423     .
     1424     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1425     if error-status :error
     1426     then do:
     1427       undo, return error substitute( "&1&2&3"
     1428                                     , "Неверно задан каталог экспорта.":u
     1429                                     , chr(10)
     1430                                     , "Обратитесь к администратору.":u
     1431                                     ).
     1432     end.
     1433     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1434     if v-bge-xml-exch-dir = ?
     1435     then do:
     1436       undo, return error substitute( "&1&2&3"
     1437                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1438                                     , chr(10)
     1439                                     , "Обратитесь к администратору.":u
     1440                                     ).
     1441     end.
     1442     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1443     if error-status :error
     1444     then do:
     1445       undo, return error substitute( "&1&2&3"
     1446                                     , "Неверно задан каталог экспорта (exch).":u
     1447                                     , chr(10)
     1448                                     , "Обратитесь к администратору.":u
     1449                                     ).
     1450     end.
     1451     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1452     if v-bge-xml-heap-dir = ?
     1453     then do:
     1454       undo, return error substitute( "&1&2&3"
     1455                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1456                                     , chr(10)
     1457                                     , "Обратитесь к администратору.":u
     1458                                     ).
     1459     end.
     1460     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1461     if error-status :error
     1462     then do:
     1463       undo, return error substitute( "&1&2&3"
     1464                                     , "Неверно задан каталог экспорта (heap).":u
     1465                                     , chr(10)
     1466                                     , "Обратитесь к администратору.":u
     1467                                     ).
     1468     end.
     1469     get-key-value section "BGE" key "heap-compress" value v-str.
     1470     assign
     1471       v-i = int(v-str)
     1472     no-error .
     1473     if v-i = ? or v-i = 0
     1474     then do:
     1475       assign
     1476         v-bge-xml-compress-heap = no
     1477       .
     1478     end.
     1479     else do:
     1480       assign
     1481         v-bge-xml-compress-heap = yes
     1482       .
     1483     end.
     1484     assign
     1485       v-arc = search( "exe/7za.exe":u )
     1486     .
     1487     if v-arc = ? or v-arc = ""
     1488     then do:
     1489       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1490     end.
     1491     assign
     1492       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1493       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1494       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1495       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1496       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1497       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1498       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1499     .
     1500     run gbl/del-file.p (input v-tmp-file-name) .
     1501     run gbl/del-file.p (input v-zip-file-name) .
     1502     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1503     if v-error-num > 0
     1504     then do:
     1505         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1506                                      , p-xml-file-name + "xm1":u
     1507                                      , v-tmp-file-name
     1508                                      , v-error-num
     1509                                      ).
     1510     end.
     1511     assign
     1512       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1513                                    , v-arc
     1514                                    , v-zip-file-name
     1515                                    , v-tmp-file-name
     1516                                    )
     1517     .
     1518     os-command silent value ( v-os-command ) .
     1519     run gbl/del-file.p (input v-heap-file-name) .
     1520     if v-bge-xml-compress-heap = no
     1521     then do:
     1522       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1523       if v-error-num > 0
     1524       then do:
     1525           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1526                                        , v-tmp-file-name
     1527                                        , v-heap-file-name
     1528                                        , v-error-num
     1529                                        ) .
     1530       end.
     1531     end.
     1532     else do:
     1533       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1534       if v-error-num > 0
     1535       then do:
     1536           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1537                                        , v-zip-file-name
     1538                                        , v-heap-file-name
     1539                                        , v-error-num
     1540                                        ) .
     1541       end.
     1542     end.
     1543     run gbl/del-file.p (input v-tmp-file-name) .
     1544     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1545     if error-status :error then do:
     1546       undo, return error substitute( "&1&2&3"
     1547                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1548                                     , chr(10)
     1549                                     , "Обратитесь к администратору."
     1550                                     ).
     1551     end.
     1552     run gbl/del-file.p (input v-exch-file-name) .
     1553     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1554     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1555     if v-error-num > 0
     1556     then do:
     1557       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1558                                     , v-zip-file-name
     1559                                     , v-exch-tmp-file-name
     1560                                     , v-error-num
     1561                                     ) .
     1562     end.
     1563     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1564     if v-error-num > 0
     1565     then do:
     1566       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1567                                     , v-exch-tmp-file-name
     1568                                     , v-exch-file-name
     1569                                     , v-error-num
     1570                                     ) .
     1571     end.
     1572     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1573   end.
     1574   else do:
     1575     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1576     if v-error-num > 0
     1577     then do:
     1578       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1579                                     , p-xml-file-name + "xm1"
     1580                                     , p-xml-file-name + "xml"
     1581                                     , v-error-num
     1582                                     ) .
     1583     end.
     1584   end.
     1585   if opsys = "unix"
     1586   then do:
     1587       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1588   end.
     1589   end.
     1590   end procedure.
     1591   procedure xml-bge-filename0:
     1592   define input parameter p-prefix   as character no-undo .
     1593   define input parameter p-name     as character no-undo .
     1594   define input parameter p-shared-process as logical no-undo .
     1595   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1596   define output parameter p-xml-file-name  as character no-undo .
     1597   // define output parameter p-fullfnamenoext as character no-undo .
     1598   define output parameter p-locked         as logical      no-undo.
     1599   define variable v-fullfnamenoext as character no-undo .
     1600   define variable v-fileext        as character no-undo .
     1601   define variable v-fullfname      as character no-undo .
     1602   define variable v-error-num      as integer   no-undo .
     1603   do
     1604   on error undo, return error
     1605   :
     1606     case v-bge-xml-bgeflold :
     1607       when "old" then do:
     1608         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1609         v-fileext       = ".xml":U .
     1610         v-fullfname     = v-fullfnamenoext + v-fileext .
     1611         p-xml-file-name = v-fullfname .
     1612         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1613         if v-error-num > 0 then do:
     1614           return error.
     1615         end.
     1616       end.
     1617       when "var" then do:
     1618         case p-prefix :
     1619           when "doc" then do:
     1620             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1621             v-fileext       = ".xml":U .
     1622             v-fullfname     = v-fullfnamenoext + v-fileext .
     1623             p-xml-file-name = v-fullfname .
     1624           end.
     1625           when "day" then do:
     1626             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1627             v-fileext       = ".xml":U .
     1628             v-fullfname     = v-fullfnamenoext + v-fileext .
     1629             p-xml-file-name = v-fullfname .
     1630           end.
     1631           otherwise do:
     1632             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1633             v-fileext       = ".xml":U .
     1634             v-fullfname     = v-fullfnamenoext + v-fileext .
     1635             p-xml-file-name = v-fullfname .
     1636           end.
     1637         end case.
     1638         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1639         if v-error-num > 0 then do:
     1640           return error.
     1641         end.
     1642       end.
     1643       when "new" then do:
     1644                   run bge/genfname.p (
     1645                       input p-home-dir
     1646                       , input p-prefix
     1647                       , input ""
     1648                       , input "xml"
     1649                       , input ""
     1650                       , output p-xml-file-name
     1651                   ).
     1652       end.
     1653       when "no-parameter" then do:
     1654         if p-shared-process then do:
     1655                       run bge/genfname.p (
     1656                           input p-home-dir
     1657                           , input "d"
     1658                           , input ""
     1659                           , input "xml"
     1660                           , input ""
     1661                           , output p-xml-file-name
     1662                       ).
     1663         end.
     1664         else do:
     1665           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1666           v-fileext       = ".xml":U .
     1667           v-fullfname     = v-fullfnamenoext + v-fileext .
     1668           p-xml-file-name = v-fullfname .
     1669           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1670           if v-error-num > 0 then do:
     1671             return error.
     1672           end.
     1673         end.
     1674       end.
     1675     end case.
     1676     assign
     1677       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1678       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1679     .
     1680   end .
     1681   end procedure .
     1682   procedure xml-bge-filename :
     1683   do
     1684   on error undo, return error
     1685   :
     1686   define input parameter p-prefix             as character    no-undo.
     1687   define input parameter p-name               as character    no-undo.
     1688   define input parameter p-shared-process     as logical      no-undo.
     1689   define output parameter p-xml-file-name     as character    no-undo.
     1690   define output parameter p-log-file-name     as character    no-undo.
     1691   define output parameter p-locked            as logical      no-undo.
     1692   define variable v-home-dir          as character no-undo .
     1693   define variable v-error-num         as integer   no-undo .
     1694   define variable v-bge-xml-heap-dir  as character no-undo .
     1695       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1696       if v-home-dir = ?
     1697       then do:
     1698           message
     1699             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1700             skip(1)
     1701             skip "Обратитесь к администратору."
     1702           view-as alert-box error.
     1703           undo, return error .
     1704       end.
     1705       if v-bge-xml-bgeflold <> "oracle"
     1706       then do:
     1707         assign
     1708             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1709         .
     1710       end.
     1711       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1712       if error-status :error
     1713       then do:
     1714           message
     1715             skip "Неверно задан каталог экспорта."
     1716             skip(1)
     1717             skip "Обратитесь к администратору."
     1718           view-as alert-box error.
     1719           undo, return error .
     1720       end.
     1721       if v-bge-xml-bgefmt = "dbf":U
     1722       then do:
     1723           assign
     1724               p-xml-file-name = v-home-dir
     1725               p-locked        = no
     1726           .
     1727       end.
     1728       else do:
     1729           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1730             output p-xml-file-name, output p-locked) .
     1731       end.
     1732       if v-bge-xml-bgeflold = "oracle"
     1733       then do:
     1734         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1735         if v-bge-xml-heap-dir = ?
     1736         then do:
     1737           undo, return error substitute( "&1&2&3"
     1738                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1739                                         , chr(10)
     1740                                         , "Обратитесь к администратору.":u
     1741                                         ).
     1742         end.
     1743         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1744         if error-status :error
     1745         then do:
     1746           undo, return error substitute( "&1&2&3"
     1747                                         , "Неверно задан каталог экспорта (heap).":u
     1748                                         , chr(10)
     1749                                         , "Обратитесь к администратору.":u
     1750                                         ).
     1751         end.
     1752         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1753           assign
     1754             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1755           .
     1756         end.
     1757         else do:
     1758           assign
     1759             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1760           .
     1761         end.
     1762       end.
     1763       else do:
     1764         assign
     1765             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1766         .
     1767       end.
     1768       assign
     1769          v-bge-xml-static-log-file-name = p-log-file-name
     1770       .
     1771   end.
     1772   end procedure.
     1773   procedure bge-xml-read-config :
     1774   do
     1775   on error undo, return error return-value
     1776   :
     1777   define input  parameter p-last-date as date      no-undo .
     1778   define input  parameter p-db-num    as integer   no-undo .
     1779       define variable v-bgeclall      as character     no-undo.
     1780       define variable v-bgedict       as character     no-undo.
     1781       define variable v-bgeshift      as character     no-undo.
     1782       define variable v-par-type      as character     no-undo.
     1783       define variable v-bgeflnm       as character     no-undo.
     1784       define variable v-bgecliiv      as character     no-undo .
     1785       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1786       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1787       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1788       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1789       define variable v-db-num-str    as character     no-undo .
     1790       define variable v-param-type      as character  no-undo .
     1791       define variable v-value-character as character  no-undo .
     1792       define variable v-value-date      as date       no-undo .
     1793       define variable v-value-decimal   as decimal    no-undo .
     1794       define variable v-value-integer   as integer    no-undo .
     1795       define variable v-value-logical   as logical    no-undo .
     1796       define variable v-tth             as handle      no-undo .
     1797       run adm/shattri.p ( input "get":U
     1798                         , input  '':u
     1799                         , input  0
     1800                         , input  'bge-export':U
     1801                         , input  'bgeclall':U
     1802                         , output v-bgecliiv
     1803                         , output v-value-date
     1804                         , output v-value-decimal
     1805                         , output v-value-integer
     1806                         , output v-value-logical
     1807                         , output v-param-type
     1808                         , input-output table-handle v-tth
     1809                         ) no-error .
     1810       if error-status :error
     1811       then do:
     1812         assign
     1813           v-bge-xml-bgecliiv = no
     1814         .
     1815       end.
     1816       else do:
     1817         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1818       end.
     1819       delete object v-tth.
     1820       assign
     1821           v-bge-xml-bgeclall = no
     1822           v-bge-xml-bgedict  = no
     1823       .
     1824       run adm/shattri.p ( input "get":U
     1825                         , input  '':u
     1826                         , input  0
     1827                         , input  'bge-export':U
     1828                         , input  'bgeclall':U
     1829                         , output v-value-character
     1830                         , output v-value-date
     1831                         , output v-value-decimal
     1832                         , output v-value-integer
     1833                         , output v-value-logical
     1834                         , output v-param-type
     1835                         , input-output table-handle v-tth
     1836                         ) no-error .
     1837       if error-status :error
     1838       then do:
     1839         assign
     1840           v-bge-xml-bgeclall = no
     1841         .
     1842       end.
     1843       else do:
     1844         assign
     1845           v-bge-xml-bgeclall = v-value-logical
     1846         .
     1847       end.
     1848       delete object v-tth.
     1849       run adm/shattri.p ( input "get":U
     1850                         , input  '':u
     1851                         , input  0
     1852                         , input  'bge-export':U
     1853                         , input  'bgedict':U
     1854                         , output v-value-character
     1855                         , output v-value-date
     1856                         , output v-value-decimal
     1857                         , output v-value-integer
     1858                         , output v-value-logical
     1859                         , output v-param-type
     1860                         , input-output table-handle v-tth
     1861                         ) no-error .
     1862       if error-status :error
     1863       then do:
     1864         assign
     1865           v-bge-xml-bgedict = no
     1866         .
     1867       end.
     1868       else do:
     1869         assign
     1870           v-bge-xml-bgedict = v-value-logical
     1871         .
     1872       end.
     1873       delete object v-tth.
     1874       run adm/shattri.p ( input "get":U
     1875                         , input  '':u
     1876                         , input  0
     1877                         , input  'bge-export':U
     1878                         , input  'bgefmt':U
     1879                         , output v-value-character
     1880                         , output v-value-date
     1881                         , output v-value-decimal
     1882                         , output v-value-integer
     1883                         , output v-value-logical
     1884                         , output v-param-type
     1885                         , input-output table-handle v-tth
     1886                         ) no-error .
     1887       if error-status :error
     1888       then do:
     1889         assign
     1890           v-bge-xml-bgefmt  = "xml":U
     1891         .
     1892       end.
     1893       else do:
     1894         assign
     1895           v-bge-xml-bgefmt  = v-value-character
     1896         .
     1897       end.
     1898       delete object v-tth.
     1899       run adm/shattri.p ( input "get":U
     1900                         , input  '':u
     1901                         , input  0
     1902                         , input  'bge-export':U
     1903                         , input  'bgeshift':U
     1904                         , output v-value-character
     1905                         , output v-value-date
     1906                         , output v-value-decimal
     1907                         , output v-value-integer
     1908                         , output v-value-logical
     1909                         , output v-param-type
     1910                         , input-output table-handle v-tth
     1911                         ) no-error .
     1912       if error-status :error
     1913       then do:
     1914         assign
     1915             v-bge-xml-shift-mode = no
     1916         .
     1917       end.
     1918       else do:
     1919         assign
     1920             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1921         .
     1922       end.
     1923       delete object v-tth.
     1924       run adm/shattri.p ( input "get":U
     1925                         , input  '':u
     1926                         , input  0
     1927                         , input  'bge-export':U
     1928                         , input  'bgeflold':U
     1929                         , output v-value-character
     1930                         , output v-value-date
     1931                         , output v-value-decimal
     1932                         , output v-value-integer
     1933                         , output v-value-logical
     1934                         , output v-param-type
     1935                         , input-output table-handle v-tth
     1936                         ) no-error .
     1937       if error-status :error
     1938       then do:
     1939         assign
     1940           v-bge-xml-bgeflold = "no-parameter":U
     1941         .
     1942       end.
     1943       else do:
     1944         assign
     1945           v-bge-xml-bgeflold  = v-value-character
     1946         .
     1947       end.
     1948       delete object v-tth.
     1949       assign
     1950         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1951         v-bge-xml-db-num-str  = v-db-num-str
     1952       .
     1953       if p-last-date <> ?
     1954       then do:
     1955           run adm/shattri.p ( input "get":U
     1956                             , input  '':u
     1957                             , input  0
     1958                             , input  'bge-export':U
     1959                             , input  'bgeflnm':U
     1960                             , output v-value-character
     1961                             , output v-value-date
     1962                             , output v-value-decimal
     1963                             , output v-value-integer
     1964                             , output v-value-logical
     1965                             , output v-param-type
     1966                             , input-output table-handle v-tth
     1967                             ) no-error .
     1968           if error-status :error
     1969           then do:
     1970             assign
     1971               v-bgeflnm = '':U
     1972             .
     1973           end.
     1974           else do:
     1975             assign
     1976               v-bgeflnm = v-value-character
     1977             .
     1978           end.
     1979           delete object v-tth.
     1980           if v-bge-xml-bgeflold = "var"
     1981           then do:
     1982               if v-bgeflnm = ?
     1983               or num-entries( v-bgeflnm ) < 2
     1984               then do:
     1985                   assign
     1986                       v-bge-xml-bgeflold = "new"
     1987                   .
     1988               end.
     1989               else do:
     1990                   assign
     1991                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1992                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1993                   .
     1994                   assign
     1995                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1996                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1997                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1998                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1999                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     2000                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     2001                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2002                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     2003                   .
     2004               end.
     2005           end.
     2006       end.
     2007   end.
     2008   end procedure.
     2009   procedure bge-xml-get-ref-filename :
     2010   define input parameter p-in-file-name       as character        no-undo.
     2011   define output parameter p-home-dir          as character        no-undo.
     2012   define output parameter p-out-file-name     as character        no-undo.
     2013   define output parameter p-locked            as logical          no-undo.
     2014       define variable v-counter       as integer      no-undo.
     2015       define variable v-error-level   as integer      no-undo.
     2016   do
     2017   on error undo, return error
     2018   :
     2019       run bge/bge-ini.p (
     2020             input "bge"
     2021           , output p-home-dir
     2022       ).
     2023       if return-value <> "OK"
     2024       then do:
     2025           undo, return error.
     2026       end.
     2027       assign
     2028           p-home-dir = p-home-dir + "\dict":U
     2029       .
     2030       run bge/dir_cd.p (
     2031           input p-home-dir
     2032           , input "CA"
     2033       ).
     2034       if return-value = "ERROR"
     2035       then do:
     2036           undo, return error.
     2037       end.
     2038       assign
     2039           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     2040       .
     2041       assign
     2042           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     2043       .
     2044       wait-lock:
     2045       do v-counter = 1 TO 3
     2046       :
     2047           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     2048           if p-locked = no
     2049           then do:
     2050               leave wait-lock.
     2051           end.
     2052           else do:
     2053               readkey pause 1.
     2054           end.
     2055       END.
     2056       if p-locked = yes
     2057       then do:
     2058           undo, return error.
     2059       end.
     2060       run bge/os_copy.p (
     2061             input "D":U
     2062           , input p-out-file-name + "xml":U
     2063           , input "":U
     2064           , output v-error-level
     2065       ).
     2066       if v-error-level > 0
     2067       then do:
     2068           undo, return error.
     2069       end.
     2070   end.
     2071   end procedure.
     2072   procedure bge-xml-write-ref-header :
     2073   define input parameter p-bge-name as character        no-undo.
     2074   define input parameter p-file-name as character        no-undo.
     2075       define variable v-out-string    as character    no-undo.
     2076   do
     2077   on error undo, return error
     2078   :
     2079       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2080       put stream stmXMLOut unformatted
     2081           "<?xml version='1.0' encoding='windows-1251'?>":U
     2082       .
     2083       assign
     2084           v-out-string = substitute( "&1&2"
     2085                               , chr(10)
     2086                               , "<IBS_Trade_House>":U )
     2087       .
     2088       put stream stmXMLOut unformatted
     2089           v-out-string
     2090       .
     2091       run wp-XMLTagOpen( 1, "header", "" ).
     2092       if v-bge-xml-bgeflold = "oracle":u
     2093       then do:
     2094         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2095         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2096         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2097         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2098         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2099       end.
     2100       else do:
     2101         run wp-XMLTagOpen( 2, "delivery", "" ).
     2102         run wp-XMLTagOpen( 3, "to", "" ).
     2103         run wp-XMLTagClose( 3, "to" ).
     2104         run wp-XMLTagOpen( 3, "from", "" ).
     2105         run wp-XMLTagClose( 3, "from" ).
     2106         run wp-XMLTagClose( 2, "delivery" ).
     2107       end.
     2108       run wp-XMLTagOpen( 2, "manifest", "" ).
     2109       run wp-XMLTagOpen( 3, "document", "" ).
     2110       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2111       run wp-XMLTagPut( 4, "description", "", 0 ).
     2112       run wp-XMLTagClose( 3, "document" ).
     2113       run wp-XMLTagClose( 2, "manifest" ).
     2114       run wp-XMLTagClose( 1, "header" ).
     2115       run wp-XMLTagOpen( 1, "body", "" ).
     2116   end.
     2117   end procedure.
     2118   procedure bge-xml-write-ref-footer :
     2119   define input parameter p-file-name as character        no-undo.
     2120       define variable v-error-level   as integer      no-undo.
     2121   do
     2122   on error undo, return error
     2123   :
     2124       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2125       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2126       output stream stmXMLOut close.
     2127       run bge/os_copy.p (
     2128             input "M":U
     2129           , input p-file-name + "xm1":U
     2130           , input p-file-name + "xml":U
     2131           , output v-error-level
     2132       ).
     2133       if v-error-level > 0
     2134       then do:
     2135           undo, return error.
     2136       end.
     2137   end.
     2138   end procedure.
     2139   procedure bge-xml-out-dir :
     2140   define output parameter p-out-dir       as character    no-undo.
     2141   define output parameter p-log-file-name as character    no-undo.
     2142   do
     2143   on error undo, return error
     2144   :
     2145       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2146       if p-out-dir = ?
     2147       then do:
     2148           message
     2149             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2150                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2151             skip(1)
     2152             skip "Обратитесь к администратору."
     2153           view-as alert-box error.
     2154           undo, return error .
     2155       end.
     2156       if v-bge-xml-bgeflold <> "oracle" then assign
     2157         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2158       .
     2159       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2160       if error-status :error  then do:
     2161           run wp-XMLWriteLog in this-procedure (
     2162                 input p-log-file-name
     2163               , input 0
     2164               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2165                                   , p-out-dir
     2166                                   , return-value
     2167                                   , trim( error-status :get-message( 1 ) )
     2168                                   )
     2169           ).
     2170           undo, return error.
     2171       end.
     2172       assign
     2173           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2174           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2175       .
     2176   end.
     2177   end procedure.
     2178   procedure bge-xml-out-dir2 :
     2179   define output parameter p-out-dir       as character    no-undo.
     2180   define output parameter p-out-dirR      as character    no-undo.
     2181   define output parameter p-log-file-name as character    no-undo.
     2182   do
     2183   on error undo, return error
     2184   :
     2185       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2186       if p-out-dir = ?
     2187       then do:
     2188           message
     2189             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2190                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2191             skip(1)
     2192             skip "Обратитесь к администратору."
     2193           view-as alert-box error.
     2194           undo, return error .
     2195       end.
     2196       if v-bge-xml-bgeflold <> "oracle" then assign
     2197             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2198             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2199         .
     2200       else p-out-dirR = p-out-dir .
     2201       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2202       if error-status :error  then do:
     2203           run wp-XMLWriteLog in this-procedure (
     2204                 input p-log-file-name
     2205               , input 0
     2206               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2207                                   , p-out-dir
     2208                                   , return-value
     2209                                   , error-status :get-message( 1 )
     2210                                   )
     2211           ).
     2212           undo, return error.
     2213       end.
     2214       if p-out-dirR <> p-out-dir then do:
     2215         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2216         if error-status :error then do:
     2217           run wp-XMLWriteLog in this-procedure (
     2218                 input p-log-file-name
     2219               , input 0
     2220               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2221                                   , p-out-dirR
     2222                                   , return-value
     2223                                   , error-status :get-message( 1 )
     2224                                   )
     2225           ).
     2226           p-out-dirR = p-out-dir .
     2227         end.
     2228       end .
     2229       assign
     2230         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2231         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2232       .
     2233   end.
     2234   end procedure.
     2235   procedure bge-xml-out-file :
     2236   do
     2237   on error undo, return error
     2238   :
     2239   define input parameter p-out-dir            as character        no-undo.
     2240   define input parameter p-prefix             as character        no-undo.
     2241   define input parameter p-sheduled           as logical          no-undo.
     2242   define output parameter p-xml-file-name     as character        no-undo.
     2243   define output parameter p-locked            as logical          no-undo.
     2244   define variable v-home-dir      as character     no-undo.
     2245   define variable v-error-num     as integer       no-undo.
     2246   define variable v-today             as date         no-undo.
     2247   define variable v-time              as integer      no-undo.
     2248       if v-bge-xml-bgefmt = "dbf":U
     2249       then do:
     2250           assign
     2251               p-xml-file-name = p-out-dir
     2252               p-locked        = no
     2253           .
     2254       end.
     2255       else do:
     2256           if v-bge-xml-bgeflold = "firm":U
     2257           then do:
     2258               run bge/genfname.p (
     2259                     input p-out-dir
     2260                   , input p-prefix
     2261                   , input "":U
     2262                   , input "arj":U
     2263                   , input "":U
     2264                   , output p-xml-file-name
     2265               ).
     2266           end.
     2267           else do:
     2268               run bge/genfname.p (
     2269                     input p-out-dir
     2270                   , input p-prefix
     2271                   , input "":U
     2272                   , input "xml":U
     2273                   , input "":U
     2274                   , output p-xml-file-name
     2275               ).
     2276           end.
     2277           assign
     2278               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2279               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2280           .
     2281       end.
     2282   end.
     2283   end procedure.
     2284   procedure bge-xml-init-ext-doc-type :
     2285       define variable v-counter    as integer      no-undo.
     2286       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2287   do
     2288   for buf_temp_ext-doc-type
     2289   on error undo, return error
     2290   :
     2291       empty temp-table buf_temp_ext-doc-type.
     2292       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2293       :
     2294           create buf_temp_ext-doc-type.
     2295           assign
     2296               buf_temp_ext-doc-type.edt-key               = v-counter
     2297               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2298               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2299           .
     2300       end.
     2301   end.
     2302   end procedure.
     2303   procedure bge-xml-get-decimal-shift-num :
     2304   define input parameter p-shift-date     as date             no-undo.
     2305   define input parameter p-shift-num      as integer          no-undo.
     2306   define output parameter p-shift-decimal as decimal          no-undo.
     2307   do
     2308   on error undo, return error
     2309   :
     2310       assign
     2311           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2312       .
     2313   end.
     2314   end procedure.
     2315   procedure bge-xml-ora-exp-filename :
     2316     define input  parameter p-table-name  as character no-undo .
     2317     define input  parameter p-doc-code    as character no-undo .
     2318     define input  parameter p-obj-code    as integer   no-undo .
     2319     define output parameter p-filename    as character no-undo .
     2320     define output parameter p-seq-num     as integer   no-undo .
     2321     define variable v-ora-exp-seq     as integer   no-undo .
     2322     define variable v-ora-exp-seq-str as character no-undo .
     2323     define variable v-home-dir        as character no-undo.
     2324   do
     2325   on error undo, return error return-value
     2326   :
     2327     if v-bge-xml-bgeflold = "oracle":u
     2328     then do:
     2329       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2330       if v-home-dir = ?
     2331       then do:
     2332         undo, return error substitute( "&1&2&3":U
     2333                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2334                                       , chr(10)
     2335                                       , "Обратитесь к администратору.":U
     2336                                       ).
     2337       end.
     2338       assign
     2339           v-home-dir = v-home-dir
     2340       .
     2341       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2342       if error-status :error
     2343       then do:
     2344         undo, return error substitute( "&1&2&3":U
     2345                                       , "Неверно задан каталог экспорта.":U
     2346                                       , chr(10)
     2347                                       , "Обратитесь к администратору.":U
     2348                                       ).
     2349       end.
     2350       assign
     2351         v-ora-exp-seq = ?
     2352       .
     2353       if  p-table-name <> ? and
     2354           p-doc-code <> ?
     2355       then do:
     2356         run bge/get-oesq.p ( input p-table-name
     2357                            , input p-doc-code
     2358                            , output v-ora-exp-seq
     2359                            ) no-error .
     2360         if error-status :error = yes
     2361         then do:
     2362           undo, return error return-value .
     2363         end.
     2364       end.
     2365       if v-ora-exp-seq = ?
     2366       then do:
     2367         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2368         if error-status :error
     2369         then do:
     2370           undo, return error return-value .
     2371         end.
     2372       end.
     2373       if p-table-name <> ? and
     2374          p-doc-code   <> ?
     2375       then do:
     2376         run bge/oesqdoc.p ( input p-table-name
     2377                           , input p-doc-code
     2378                           , input v-ora-exp-seq
     2379                           ) no-error .
     2380         if error-status :error = yes
     2381         then do:
     2382           undo, return error return-value .
     2383         end.
     2384       end.
     2385       assign
     2386         p-seq-num  = v-ora-exp-seq
     2387         p-filename = substitute("&1/&2-000_&3."
     2388                                , v-home-dir
     2389                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2390                                , string(v-ora-exp-seq , "999999999")
     2391                                )
     2392       .
     2393     end.
     2394   end.
     2395   end procedure.
     2396   procedure bge-xml-date-to-str :
     2397     define input  parameter p-date  as date      no-undo .
     2398     define output parameter p-str   as character no-undo .
     2399   do
     2400   on error undo, return error return-value
     2401   :
     2402     if p-date <> ?
     2403     then do:
     2404       assign
     2405         p-str = substitute( "&1-&2-&3"
     2406                           , string( year(p-date)  , "9999")
     2407                           , string( month(p-date) , "99"  )
     2408                           , string( day(p-date)   , "99"  )
     2409                           )
     2410       .
     2411     end.
     2412     else do:
     2413       assign
     2414         p-str = ?
     2415       .
     2416     end.
     2417   end.
     2418   end procedure.
     2419   procedure bge-xml-date-str-to-str :
     2420     define input  parameter p-date-str  as character no-undo .
     2421     define output parameter p-str       as character no-undo .
     2422     define variable v-date          as date      no-undo .
     2423     define variable v-date-valid    as logical   no-undo .
     2424     define variable v-error-message as character no-undo .
     2425   do
     2426   on error undo, return error return-value
     2427   :
     2428     assign
     2429       p-str = ?
     2430     .
     2431     if p-date-str = ? or p-date-str = ""
     2432     then do:
     2433       return .
     2434     end.
     2435     run strtdate in this-procedure ( input  p-date-str
     2436                                    , output v-date
     2437                                    , output v-date-valid
     2438                                    , output v-error-message
     2439                                    ).
     2440     if v-date-valid <> true
     2441     then do:
     2442       return .
     2443     end.
     2444     assign
     2445       p-str = substitute( "&1-&2-&3"
     2446                         , string( year(v-date)  , "9999")
     2447                         , string( month(v-date) , "99"  )
     2448                         , string( day(v-date)   , "99"  )
     2449                         )
     2450     .
     2451   end.
     2452   end procedure.
     2453   procedure bge-xml-fill-tt-bgecliiv :
     2454     define input  parameter p-str as character no-undo .
     2455     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2456     define buffer buf_clients             for ub.clients.
     2457     define variable v-i         as integer   no-undo .
     2458     define variable v-count     as integer   no-undo .
     2459     define variable v-cli-count as integer   no-undo .
     2460     define variable v-client    as character no-undo .
     2461     define variable v-obj-type  as character no-undo .
     2462     define variable v-obj-code  as integer   no-undo .
     2463   do
     2464   on error undo, return error return-value
     2465   :
     2466     empty temp-table buf_tt-bge-xml-bgecliiv.
     2467     assign
     2468       v-bge-xml-bgecliiv = no
     2469       v-cli-count        = num-entries(p-str,';')
     2470     .
     2471     if v-cli-count > 0
     2472     then do:
     2473       _cli-cycle:
     2474       do v-i = 1 to v-cli-count
     2475       :
     2476         assign
     2477           v-client = entry(v-i , p-str, ';')
     2478         .
     2479         if num-entries(v-client) <> 2
     2480         then do:
     2481           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2482         end.
     2483         assign
     2484           v-obj-type = entry(1, v-client)
     2485         .
     2486         assign
     2487           v-obj-code = integer(entry(2, v-client))
     2488         no-error .
     2489         if error-status :error
     2490         then do:
     2491           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2492         end.
     2493         find first buf_clients no-lock
     2494           where buf_clients.obj-type = v-obj-type
     2495             and buf_clients.obj-code = v-obj-code
     2496         no-error.
     2497         if not available buf_clients
     2498         then do:
     2499           next _cli-cycle.
     2500         end.
     2501         find first buf_tt-bge-xml-bgecliiv no-lock
     2502           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2503             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2504         no-error .
     2505         if available buf_tt-bge-xml-bgecliiv
     2506         then do:
     2507           next _cli-cycle.
     2508         end.
     2509         create buf_tt-bge-xml-bgecliiv.
     2510         assign
     2511           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2512           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2513         .
     2514       end.
     2515     end.
     2516     else do:
     2517       assign
     2518         v-bge-xml-bgecliiv = no
     2519       .
     2520       return .
     2521     end.
     2522     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2523     if available buf_tt-bge-xml-bgecliiv
     2524     then do:
     2525       assign
     2526         v-bge-xml-bgecliiv = yes
     2527       .
     2528     end.
     2529   end.
     2530   end procedure.
     2531   procedure bge-xml-resolve-ext-doc-type :
     2532     define input  parameter p-ext-doc-type      as character no-undo .
     2533     define input  parameter p-obj-type          as character no-undo .
     2534     define input  parameter p-obj-code          as integer   no-undo .
     2535     define output parameter p-out-ext-doc-type  as character no-undo .
     2536     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2537   do
     2538   on error undo, return error return-value
     2539   :
     2540     assign
     2541       p-out-ext-doc-type = p-ext-doc-type
     2542     .
     2543     if p-ext-doc-type <> 'ie':U
     2544     then do:
     2545       return .
     2546     end.
     2547     if v-bge-xml-bgecliiv = yes
     2548     then do:
     2549       find first buf_tt-bge-xml-bgecliiv no-lock
     2550         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2551           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2552       no-error .
     2553       if available buf_tt-bge-xml-bgecliiv
     2554       then do:
     2555         assign
     2556           p-out-ext-doc-type = 'iv':U
     2557         .
     2558       end.
     2559     end.
     2560   end.
     2561   end procedure.
     2562   procedure safe-wp-xmltagput :
     2563     define input  parameter pTagLevel   as integer   no-undo .
     2564     define input  parameter pTagName    as character no-undo .
     2565     define input  parameter pParValue   as character no-undo .
     2566     define input  parameter pFlagEmpty  as integer   no-undo .
     2567   do
     2568   on error undo, return error return-value
     2569   :
     2570     if v-bge-xml-bgeflold = "oracle":u
     2571     then do:
     2572       return .
     2573     end.
     2574     run wp-xmltagput in this-procedure ( input pTagLevel
     2575                                        , input pTagName
     2576                                        , input pParValue
     2577                                        , input pFlagEmpty
     2578                                        ).
     2579   end.
     2580   end procedure.
     2581       define variable v-xml-file-name     as character            no-undo.
     2582       define variable v-log-file-name     as character            no-undo.
     2583       define variable v-obj-counter       as integer       no-undo.
     2584   do
     2585   on error undo, return error
     2586   :
     2587   run bge/bge-head.p (
     2588         input "exp-acc"
     2589       , input "way"
     2590       , input "XML - Вывод данных по товарам в пути"
     2591       , input p-shedule
     2592       , output v-xml-file-name
     2593       , output v-log-file-name
     2594   ) no-error.
     2595   if error-status :error
     2596   then do:
     2597       message
     2598         vss-workfile vss-revision vss-description
     2599         skip "Ошибка при создании файла выгрузки."
     2600         skip return-value
     2601         skip trim(error-status :get-message(1))
     2602              trim(error-status :get-message(2))
     2603              trim(error-status :get-message(3))
     2604              trim(error-status :get-message(4))
     2605              trim(error-status :get-message(5))
     2606       view-as alert-box error.
     2607       undo, return error .
     2608   end.
     2609   run bge-xml-write-header in this-procedure (
     2610         input v-xml-file-name
     2611       , input "way"
     2612       , input "15.0 " + vss-revision + vss-date
     2613       , input p-db-num
     2614       , input ?
     2615       , input 0
     2616       , input ?
     2617       , input 0
     2618       , input p-obj-list
     2619       , input ""
     2620       , input ?
     2621       , input ?
     2622       , input ?
     2623       , input ?
     2624       , input ?
     2625       , input ?
     2626       , input ?
     2627       , input ?
     2628   ) no-error.
     2629   if error-status :error
     2630   then do:
     2631       return error.
     2632   end.
     2633   if p-shedule = no
     2634   then do:
     2635       run init-temphost.
     2636       object-of-firm:
     2637       for each temp-obj
     2638          where temp-obj.host-code = p-host-code
     2639       break by temp-obj.obj-type
     2640             by temp-obj.obj-code
     2641       :
     2642           run wp-XMLWriteEDT( hEDT, 1, string( temp-obj.obj-type ) + " " + string( temp-obj.obj-code ) ).
     2643           run wp-XMLShowCNT(hCNT).
     2644           run bge/way-oper.p (
     2645                 input temp-obj.obj-type
     2646               , input temp-obj.obj-code
     2647               , input v-xml-file-name
     2648               , input v-log-file-name
     2649               , input hEDT
     2650               , input hCNT
     2651           ) no-error.
     2652           if error-status :error
     2653           then do:
     2654               message
     2655                   "Ошибка при выгрузке данных по товарам в пути"
     2656               view-as alert-box.
     2657               run wp-XMLWriteEDT( hEDT, 1, string( return-value ) ).
     2658           end.
     2659           run wp-XMLHideCNT( hCNT ).
     2660       end.
     2661   end.
     2662   else do:
     2663       for each temp-obj
     2664       :
     2665           delete temp-obj.
     2666       end.
     2667       do v-obj-counter = 1 to num-entries ( p-obj-list ) / 2
     2668       :
     2669           run wp-XMLWriteEDT( hEDT, 1, entry( v-obj-counter * 2 - 1, p-obj-list ) + " " + entry( v-obj-counter * 2, p-obj-list ) ).
     2670           run wp-XMLShowCNT(hCNT).
     2671           run bge/way-oper.p (
     2672                 input entry( v-obj-counter * 2 - 1, p-obj-list )
     2673               , input integer( entry( v-obj-counter * 2, p-obj-list ) )
     2674               , input v-xml-file-name
     2675               , input v-log-file-name
     2676               , input hEDT
     2677               , input hCNT
     2678           ) no-error.
     2679           if error-status :error
     2680           then do:
     2681               message
     2682                           vss-workfile vss-revision vss-description
     2683                   skip "Ошибка при выгрузке данных по товарам в пути"
     2684                   skip return-value
     2685                   skip trim(error-status :get-message(1))
     2686                           trim(error-status :get-message(2))
     2687                           trim(error-status :get-message(3))
     2688               view-as alert-box error.
     2689               run wp-XMLWriteEDT( hEDT, 1, string( return-value ) ).
     2690               undo, return error return-value .
     2691           end.
     2692           run wp-XMLHideCNT( hCNT ).
     2693       end.
     2694   end.
     2695   run xml-bge-write-footer in this-procedure ( input v-xml-file-name ).
     2696   end.
