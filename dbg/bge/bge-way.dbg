      645                       when chr(9)
      646                       then do:
      647                           assign
      648                               p-out-string = p-out-string + " ":U
      649                           .
      650                       end.
      651                       when chr(29)
      652                       then do:
      653                           assign
      654                               p-out-string = p-out-string + " ":U
      655                           .
      656                       end.
      657                       when chr(10)
      658                       then do:
      659                           assign
      660                               p-out-string = p-out-string + " ":U
      661                           .
      662                       end.
      663                       when chr(13)
      664                       then do:
      665                           assign
      666                               p-out-string = p-out-string + " ":U
      667                           .
      668                       end.
      669                       otherwise do:
      670                           assign
      671                               p-out-string = p-out-string + v-current-char
      672                           .
      673                       end.
      674                   end case.
      675               end.
      676           end.
      677       end case.
      678   end.
      679   end .
      680   procedure xmlchar-decode :
      681   define input parameter p-in-string      as character        no-undo.
      682   define output parameter p-out-string    as character        no-undo.
      683       define variable v-position      as integer      no-undo.
      684       define variable v-last-position as integer      no-undo.
      685       define variable v-temp-integer  as integer      no-undo.
      686       define variable v-current-char  as character    no-undo.
      687       define variable v-next-char     as character    no-undo.
      688       define variable v-success       as logical      no-undo.
      689   do
      690   on error undo, return error
      691   :
      692       assign
      693           p-out-string = "":U
      694           v-position   = 0
      695       .
      696       replace-cycle:
      697       do while yes
      698       on error undo, return error
      699       :
      700           assign
      701               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      702           .
      703           if v-last-position <= v-position
      704           then do:
      705               if v-position = 0
      706               then do:
      707                   assign
      708                       p-out-string = p-in-string
      709                   .
      710               end.
      711               else do:
      712                   assign
      713                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      714                   .
      715               end.
      716               leave replace-cycle.
      717           end.
      718           else do:
      719               assign
      720                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      721                   v-position      = v-last-position
      722                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      723               .
      724               if v-current-char = "#":U
      725               then do:
      726                   assign
      727                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      728                   .
      729                   if v-last-position > 0
      730                   then do:
      731                       run xmlchar-read-integer in this-procedure
      732                        (
      733                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      734                           , output v-temp-integer
      735                           , output v-success
      736                       ).
      737                       if v-success = yes
      738                       and v-temp-integer >= 1
      739                       and v-temp-integer <= 255
      740                       then do:
      741                           assign
      742                               p-out-string = p-out-string + chr( v-temp-integer )
      743                               v-position   = v-last-position + 1
      744                           .
      745                       end.
      746                       else do:
      747                           assign
      748                               p-out-string = p-out-string + "&":U
      749                               v-position   = v-position   + 1
      750                           .
      751                       end.
      752                   end.
      753                   else do:
      754                       assign
      755                           p-out-string = p-out-string + "&":U
      756                           v-position   = v-position   + 1
      757                       .
      758                   end.
      759               end.
      760               else do:
      761                   case substring( p-in-string, v-position + 1, 3 )
      762                   :
      763                       when "lt;":U
      764                       then do:
      765                           assign
      766                               p-out-string = p-out-string + "<":U
      767                               v-position   = v-position   + 3
      768                           .
      769                       end.
      770                       when "gt;":U
      771                       then do:
      772                           assign
      773                               p-out-string = p-out-string + ">":U
      774                               v-position   = v-position   + 3
      775                           .
      776                       end.
      777                       otherwise do:
      778                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      779                           then do:
      780                               assign
      781                                   p-out-string = p-out-string + "&":U
      782                                   v-position   = v-position   + 4
      783                               .
      784                           end.
      785                           else do:
      786                               case substring( p-in-string, v-position + 1, 5 )
      787                               :
      788                                   when "quot;":U
      789                                   then do:
      790                                       assign
      791                                           p-out-string = p-out-string + '"':U
      792                                           v-position   = v-position   + 5
      793                                       .
      794                                   end.
      795                                   when "apos;":U
      796                                   then do:
      797                                       assign
      798                                           p-out-string = p-out-string + "'":U
      799                                           v-position   = v-position   + 5
      800                                       .
      801                                   end.
      802                                   otherwise do:
      803                                       assign
      804                                           p-out-string = p-out-string + "&":U
      805                                       .
      806                                   end.
      807                               end case.
      808                           end.
      809                       end.
      810                   end case.
      811               end.
      812           end.
      813       end.
      814   end.
      815   end .
      816   procedure xmlchar-read-integer :
      817   define input parameter p-input-string      as character        no-undo.
      818   define output parameter p-output-integer   as integer          no-undo.
      819   define output parameter p-success       as logical          no-undo.
      820   do
      821   on error undo, return error
      822   :
      823       assign
      824           p-output-integer = integer( p-input-string )
      825       no-error.
      826       if error-status :error
      827       then do:
      828           assign
      829               p-success           = no
      830               p-output-integer    = 0
      831           .
      832       end.
      833       else do:
      834           assign
      835               p-success           = yes
      836           .
      837       end.
      838   end.
      839   end.
      840   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      841   procedure strtdate :
      842     define input  parameter p-str         as character no-undo .
      843     define output parameter p-value       as date      no-undo .
      844     define output parameter p-data-valid  as logical   no-undo .
      845     define output parameter p-message     as character no-undo .
      846   do
      847   on error undo, return error return-value
      848   :
      849     define variable v-value       as date      no-undo .
      850     define variable v-i           as integer   no-undo .
      851     define variable v-num         as integer   no-undo .
      852     define variable v-delim       as character no-undo .
      853     define variable v-delim-list  as character no-undo .
      854     define variable v-day         as integer   no-undo .
      855     define variable v-month       as integer   no-undo .
      856     define variable v-year        as integer   no-undo .
      857     define variable v-day-str     as character no-undo .
      858     define variable v-month-str   as character no-undo .
      859     define variable v-year-str    as character no-undo .
      860     assign
      861       p-value       = ?
      862       p-data-valid  = false
      863     .
      864     if p-str = ?
      865     then do:
      866       assign
      867         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      868       .
      869       return .
      870     end.
      871     if p-str = ""
      872     then do:
      873       assign
      874         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      875       .
      876       return .
      877     end.
      878     if length(p-str)  > 10
      879     then do:
      880       assign
      881         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      882       .
      883       return .
      884     end.
      885     assign
      886       v-delim-list = '/,-,.':U
      887     .
      888     _delim:
      889     do v-i = 1 to num-entries( v-delim-list )
      890     :
      891       assign
      892         v-delim = entry( v-i , v-delim-list )
      893         v-num   = num-entries( p-str , v-delim )
      894       .
      895       if v-num <> 3
      896       then do:
      897         assign
      898           v-delim = ''
      899         .
      900       end.
      901       else do:
      902         leave _delim.
      903       end.
      904     end.
      905     if v-delim = ''
      906     then do:
      907       assign
      908         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      909       .
      910       return .
      911     end.
      912     assign
      913       v-day-str   = entry( 1, p-str , v-delim)
      914       v-month-str = entry( 2, p-str , v-delim)
      915       v-year-str  = entry( 3, p-str , v-delim)
      916     .
      917     if  length(v-day-str) > 2   or
      918         length(v-day-str) < 1   or
      919         length(v-month-str) > 2 or
      920         length(v-month-str) < 1 or
      921         (
      922           length(v-year-str) <> 2 and
      923           length(v-year-str) <> 4
      924         )
      925     then do:
      926       assign
      927         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      928       .
      929       return .
      930     end.
      931     if length( v-year-str ) = 2
      932     then do:
      933       assign
      934         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      935       .
      936     end.
      937     assign
      938       v-day   = integer( v-day-str )
      939       v-month = integer( v-month-str)
      940       v-year  = integer( v-year-str)
      941     no-error .
      942     if error-status :error
      943     then do:
      944       assign
      945         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      946       .
      947       return .
      948     end.
      949     if v-day < 1  or
      950        v-day > 31 or
      951        v-month < 1 or
      952        v-month > 12 or
      953        v-year < 0   or
      954        v-year > 5000
      955     then do:
      956       assign
      957         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      958       .
      959       return .
      960     end.
      961     assign
      962       v-value = date( v-month, v-day, v-year )
      963     no-error .
      964     if error-status :error
      965     then do:
      966       assign
      967         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      968       .
      969       return .
      970     end.
      971     assign
      972       p-value       = v-value
      973       p-data-valid  = true
      974     .
      975   end.
      976   end procedure.
      977   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      978   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
      979   define variable v-bge-xml-bgedict       as logical  init no  no-undo.
      980   define variable v-bge-xml-bgeflold      as character         no-undo.
      981   define variable v-bge-xml-bgefmt        as character         no-undo.
      982   define variable v-bge-xml-shift-mode    as logical           no-undo.
      983   define variable v-bge-xml-bgeflnm-doc   as character         no-undo.
      984   define variable v-bge-xml-bgeflnm-day   as character         no-undo.
      985   define variable v-bge-xml-log-file-name as character    no-undo.
      986   define variable v-bge-xml-dbf-file-name as character    no-undo.
      987   define variable v-bge-xml-db-num-str    as character    no-undo .
      988   define variable v-bge-xml-static-log-file-name as character    no-undo.
