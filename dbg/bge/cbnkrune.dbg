        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: cbnkrune.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: bge/cbnkrune.p $":U .
        8   define variable vss-description as character no-undo init "› —œŒ–“ ‚ ÒËÒÚÂÏÛ  À»≈Õ“-¡¿Õ  -Á‡ÔÛÒÍ ".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79     define variable v-cntxt-db-num        as integer   no-undo .
       80     define variable v-cntxt-userid        as character no-undo .
       81     define variable v-cntxt-level         as character no-undo .
       82     define variable v-cntxt-host-code-obj as integer   no-undo .
       83     define variable v-cntxt-obj-type      as character no-undo .
       84     define variable v-cntxt-obj-code      as integer   no-undo .
       85     define variable v-cntxt-db-num-obj    as integer   no-undo .
       86     define variable v-cntxt-is-admin      as logical   no-undo .
       87   define variable v-cancel        as logical no-undo .
       88   define variable v-params        as character    no-undo.
       89   define variable v-host-list        as character    no-undo.
       90   define variable v-doc-type-list      as character    no-undo.
       91   define variable v-hsch-list          as character    no-undo.
       92   define variable v-csch-list          as character    no-undo.
       93   define variable v-date-list          as character    no-undo.
       94   define variable v-counter       as integer       no-undo.
       95   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96   define NEW SHARED temp-table temp_obj-list no-undo
       97       field obj-type as character
       98       field obj-code as integer
       99       index pi is primary unique obj-type obj-code
      100   .
      101   DEFINE NEW SHARED TEMP-TABLE temp_hfin-schet NO-UNDO LIKE ub.fin-schet
      102   .
      103   DEFINE NEW SHARED TEMP-TABLE temp_cfin-schet NO-UNDO LIKE ub.fin-schet
      104   .
      105   define temp-table temp-bik no-undo
      106   field host-code like ub.sysconf.host-code
      107   field code-bank like ub.fin-bank.code-bank
      108   field bik       like ub.fin-bank.bik
      109   field f_name    as character
      110   field o_name    as character
      111   field d-count    as integer
      112   field adresat as character
      113   index pi is unique primary
      114   host-code
      115   bik
      116   .
      117   procedure init-host-list :
      118   define input parameter p-host-list as character no-undo .
      119   define variable v-counter as integer no-undo .
      120   define buffer buf_temp_obj-list for temp_obj-list.
      121     do
      122     on error undo, return error
      123     :
      124     for each buf_temp_obj-list
      125     :
      126         delete buf_temp_obj-list.
      127     end.
      128     do v-counter = 1 to num-entries( p-host-list ) / 2
      129     :
      130         create buf_temp_obj-list.
      131         assign
      132             buf_temp_obj-list.obj-type = entry( 2 * v-counter - 1,  p-host-list )
      133             buf_temp_obj-list.obj-code = integer( entry( 2 * v-counter,      p-host-list ) )
      134         .
      135     end.
      136     end.
      137   end procedure.
      138   procedure fill-hfin-schet :
      139   define input parameter p-hfin-schet as character no-undo .
      140   define variable v-counter as integer no-undo .
      141   define buffer buf_temp_hfin-schet for temp_hfin-schet.
      142     do
      143     on error undo, return error return-value
      144     :
      145         for each buf_temp_hfin-schet
      146         :
      147             delete buf_temp_hfin-schet.
      148         end.
      149         do v-counter = 1 to num-entries( p-hfin-schet ) / 6
      150         :
      151             create buf_temp_hfin-schet.
      152             assign
      153             buf_temp_hfin-schet.host-code = integer( entry( 6 * v-counter - 5,      p-hfin-schet ) )
      154             buf_temp_hfin-schet.r-schet = entry( 6 * v-counter - 4,  p-hfin-schet )
      155             buf_temp_hfin-schet.cli-type =  entry( 6 * v-counter - 3,      p-hfin-schet )
      156             buf_temp_hfin-schet.cli-code = integer( entry( 6 * v-counter - 2,      p-hfin-schet ) )
      157             buf_temp_hfin-schet.code-bank = integer( entry( 6 * v-counter - 1,      p-hfin-schet ) )
      158             buf_temp_hfin-schet.code-schet = integer( entry( 6 * v-counter,      p-hfin-schet ) )
      159             .
      160         end.
      161     end.
      162   end procedure.
      163   procedure fill-cfin-schet :
      164   define input parameter p-cfin-schet as character no-undo .
      165   define variable v-counter as integer no-undo .
      166   define buffer buf_temp_cfin-schet for temp_cfin-schet.
      167     do
      168     on error undo, return error return-value
      169     :
      170         for each buf_temp_cfin-schet
      171         :
      172             delete buf_temp_cfin-schet.
      173         end.
      174         do v-counter = 1 to num-entries( p-cfin-schet ) / 6
      175         :
      176             create buf_temp_cfin-schet.
      177             assign
      178             buf_temp_cfin-schet.host-code = integer( entry( 6 * v-counter - 5,      p-cfin-schet ) )
      179             buf_temp_cfin-schet.r-schet = entry( 6 * v-counter - 4,  p-cfin-schet )
      180             buf_temp_cfin-schet.cli-type =  entry( 6 * v-counter - 3,      p-cfin-schet )
      181             buf_temp_cfin-schet.cli-code = integer( entry( 6 * v-counter - 2,      p-cfin-schet ) )
      182             buf_temp_cfin-schet.code-bank = integer( entry( 6 * v-counter - 1,      p-cfin-schet ) )
      183             buf_temp_cfin-schet.code-schet = integer( entry( 6 * v-counter,      p-cfin-schet ) )
      184             .
      185         end.
      186     end.
      187   end procedure.
      188   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      189     run mainmenu_getcntxt in parparentproc
      190       (output v-cntxt-db-num
      191       ,output v-cntxt-userid
      192       ,output v-cntxt-level
      193       ,output v-cntxt-host-code-obj
      194       ,output v-cntxt-obj-type
      195       ,output v-cntxt-obj-code
      196       ,output v-cntxt-db-num-obj
      197       ,output v-cntxt-is-admin
      198       ) .
      199   run bge/clb-shdp.w (
      200                    input parparentproc
      201                   ,input v-cntxt-host-code-obj
      202                   ,input 'run':U
      203                   ,input '':U
      204                   ,input ?
      205                   ,input -1
      206                   ,input 'exp':U
      207                   ,output v-cancel
      208                   ,output v-params
      209                   ,output v-host-list
      210                   ,output v-doc-type-list
      211                   ,output v-date-list
      212                   ,output v-hsch-list
      213                   ,output v-csch-list
      214                 ) no-error.
      215   if error-status:error then undo, return error .
      216   if v-cancel then return.
      217   do
      218   on error undo, return error
      219   :
      220     run init-host-list in this-procedure (input v-host-list).
      221     run fill-hfin-schet in this-procedure (input v-hsch-list).
      222     run fill-cfin-schet in this-procedure (input v-csch-list).
      223     run str/diallog.w ( parparentproc
      224                 , this-procedure
      225                 , 'bge/clbnke.p':U
      226                 , '0' + chr(4) + v-params + chr(4) + v-date-list + chr(4) + v-doc-type-list
      227                 , no
      228                 , '':U
      229                 , '›ÍÒÔÓÚ ‰‡ÌÌ˚ı ‚ ÒËÒÚÂÏÛ  À»≈Õ“-¡¿Õ ') no-error .
      230   end.
