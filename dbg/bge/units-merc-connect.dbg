        1   using ibs.th.bge.mercury.*.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define output parameter p-guid as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":u .
        5   define variable vss-author      as character no-undo init "$Author$":u .
        6   define variable vss-date        as character no-undo init "$Date$":u .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        8   define variable vss-archive     as character no-undo init "$Archive$":u .
        9   define variable vss-description as character no-undo init "Справочник единиц измерения" .
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   define new global shared variable g#attr-lib  as handle no-undo .
      117   define variable v-attr-lib-variable as handle no-undo .
      118   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      120   procedure thbjattr_code :
      121      define input  parameter p-upper-code     as character no-undo .
      122      define input  parameter p-code           as character no-undo .
      123      define output parameter p-label          as character no-undo .
      124      define output parameter p-user-can-edit  as logical   no-undo .
      125      define output parameter p-output-display as logical   no-undo .
      126      define output parameter p-other          as character no-undo .
      127      define output parameter p-prop-list      as character no-undo .
      128      define output parameter p-prop-type-list as character no-undo .
      129      define output parameter p-prop-label-list as character no-undo .
      130      define output parameter p-global          as logical no-undo .
      131      define output parameter p-host           as logical no-undo .
      132      define output parameter p-shop           as logical no-undo .
      133      define output parameter p-store          as logical no-undo .
      134      define output parameter p-db             as logical no-undo .
      135      define variable p-region as logical no-undo.
      136      run thbjattr_code_reg in this-procedure (
      137                                               p-upper-code,
      138                                               p-code,
      139                                               output p-label,
      140                                               output p-user-can-edit,
      141                                               output p-output-display,
      142                                               output p-other,
      143                                               output p-prop-list,
      144                                               output p-prop-type-list,
      145                                               output p-prop-label-list,
      146                                               output p-global,
      147                                               output p-host,
      148                                               output p-shop,
      149                                               output p-store,
      150                                               output p-db,
      151                                               output p-region
      152                                               ).
      153   end procedure.
      154   procedure thbjattr_code_reg :
      155   define input  parameter p-upper-code     as character no-undo .
      156   define input  parameter p-code           as character no-undo .
      157   define output parameter p-label          as character no-undo .
      158   define output parameter p-user-can-edit  as logical   no-undo .
      159   define output parameter p-output-display as logical   no-undo .
      160   define output parameter p-other          as character no-undo .
      161   define output parameter p-prop-list      as character no-undo .
      162   define output parameter p-prop-type-list as character no-undo .
      163   define output parameter p-prop-label-list as character no-undo .
      164   define output parameter p-global          as logical no-undo .
      165   define output parameter p-host           as logical no-undo .
      166   define output parameter p-shop           as logical no-undo .
      167   define output parameter p-store          as logical no-undo .
      168   define output parameter p-db             as logical no-undo .
      169   define output parameter p-region         as logical no-undo .
      170   do
      171   on error undo, return error return-value
      172   :
      173       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      174       (input  p-upper-code
      175       ,input  p-code
      176       ,output p-label
      177       ,output p-user-can-edit
      178       ,output p-output-display
      179       ,output p-other
      180       ,output p-prop-list
      181       ,output p-prop-type-list
      182       ,output p-prop-label-list
      183       ,output p-global
      184       ,output p-host
      185       ,output p-shop
      186       ,output p-store
      187       ,output p-db
      188       ,output p-region
      189       ) no-error .
      190     if error-status :error
      191     then do:
      192       undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      193     end.
      194   end.
      195   end procedure.
