      432   define temp-table tt-units-merc
      433     field guid_ as character format "X(38)"
      434     field uuid_ as character format "X(38)"
      435     field name1 as character format "X(10)"
      436     field name2 as character format "X(16)"
      437     index pi as primary unique
      438       guid_
      439   .
      440   DEFINE BUTTON b-select
      441        LABEL "Выбор":L
      442        SIZE 10 BY 1.
      443   DEFINE BUTTON b-exit AUTO-END-KEY
      444        LABEL "&Выход ":L
      445        SIZE 10 BY 1.
      446   DEFINE QUERY br-units FOR tt-units-merc SCROLLING.
      447   DEFINE BROWSE br-units QUERY br-units NO-LOCK DISPLAY
      448         tt-units-merc.name1 column-label "Аббр."
      449         tt-units-merc.name2 column-label "Наименование"
      450         tt-units-merc.guid_ column-label "GUID в ФГИС Меркурий"
      451         tt-units-merc.uuid_ column-label "UUID в ФГИС Меркурий"
      452       WITH SEPARATORS
      453              size 106.75 by 12.58
      454            .
      455   DEFINE FRAME d-units
      456        br-units at row 2.5 col 3
      457        b-exit at row 1 col 1
      458        b-select at row 1 col 11
      459       WITH VIEW-AS DIALOG-BOX
      460            SIDE-LABELS THREE-D
      461            SCROLLABLE size 111.88 by 16.25
      462            TITLE "Выбор ед. изм. ФГИС Меркурий для связи с TH":L.
      463   ASSIGN
      464          FRAME d-units:SCROLLABLE       = FALSE.
      465   ON CHOOSE OF b-select IN FRAME d-units
      466   DO:
      467     if not available tt-units-merc then return no-apply .
      468     p-guid = tt-units-merc.guid_ .
      469     apply "go" to frame d-units .
      470   END.
      471   ON CHOOSE OF b-exit IN FRAME d-units
      472   DO:
      473     p-guid = "" .
      474   END.
      475   IF CURRENT-WINDOW:WINDOW-STATE = WINDOW-MINIMIZED
      476   THEN CURRENT-WINDOW:WINDOW-STATE = WINDOW-NORMAL.
      477   ON WINDOW-CLOSE OF FRAME d-units APPLY "END-ERROR":U TO SELF.
      478   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      479     run mainmenu_getcntxt in parparentproc
      480       (output v-cntxt-db-num
      481       ,output v-cntxt-userid
      482       ,output v-cntxt-level
      483       ,output v-cntxt-host-code-obj
      484       ,output v-cntxt-obj-type
      485       ,output v-cntxt-obj-code
      486       ,output v-cntxt-db-num-obj
      487       ,output v-cntxt-is-admin
      488       ) .
      489     SECURITY-POLICY:SYMMETRIC-ENCRYPTION-KEY = GENERATE-PBE-KEY("sysadm").
      490   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      491   empty temp-table thbjattr_thbj-attr.
      492   run adm/shattri.p (
      493      input "get":U
      494     ,input v-cntxt-obj-type
      495     ,input v-cntxt-obj-code
      496     ,input 'mercur':U
      497     ,input  ""
      498     ,output v-value-character
      499     ,output v-value-date
      500     ,output v-value-decimal
      501     ,output v-value-integer
      502     ,output v-value-logical
      503     ,output par-type
      504     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      505     ) no-error .
      506     for each thbjattr_thbj-attr :
      507       case thbjattr_thbj-attr.prop-code :
      508         when "login" then
      509           v-login = thbjattr_thbj-attr.property-value-character .
      510         when "password" then
      511           v-password = thbjattr_thbj-attr.property-value-character .
      512         when "server" then
      513           do:
      514             case thbjattr_thbj-attr.property-value-integer :
      515               when 1 then
      516                 do:
      517                   v-server = "https://api2.vetrf.ru:8002" .
      518                 end.
      519               when 2 then
      520                 do:
      521                   v-server = "https://api.vetrf.ru" .
      522                 end.
      523             end case .
      524           end.
      525         when "proxy-addres" then
      526             v-proxy-addres = thbjattr_thbj-attr.property-value-character .
      527         when "proxy-login" then
      528           do:
      529             if thbjattr_thbj-attr.property-value-character <> ""
      530             then do :
      531   define variable vss-include-info5 as character format "X(65)" no-undo
      532   initial "@(#)$Workfile$ $Revision$".
      533   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      534     (input  thbjattr_thbj-attr.property-value-character
      535     ,output v-proxy-login
      536     ) no-error .
      537             end.
      538           end.
      539         when "proxy-pswd" then
      540           do:
      541             if thbjattr_thbj-attr.property-value-character <> ""
      542             then do :
      543   define variable vss-include-info6 as character format "X(65)" no-undo
      544   initial "@(#)$Workfile$ $Revision$".
      545   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
      546     (input  thbjattr_thbj-attr.property-value-character
      547     ,output v-proxy-pswd
      548     ) no-error .
      549             end.
      550           end.
      551         when "proxy-ssl" then
      552             v-proxy-ssl = thbjattr_thbj-attr.property-value-logical .
      553       end case.
      554     end.
      555     run fill-tt .
      556     RUN enable_UI.
      557     if available units then
      558         glog = br-units:select-focused-row( ).
      559   do  on endkey undo, leave  on error undo, leave:
      560     WAIT-FOR GO OF FRAME d-units.
      561   end.
      562   RUN disable_UI.
      563   PROCEDURE disable_UI :
      564     HIDE FRAME d-units.
      565   END PROCEDURE.
      566   PROCEDURE enable_UI :
      567       ENABLE  br-units b-exit
      568                       b-select
      569           WITH FRAME d-units.
      570       OPEN QUERY br-units FOR EACH tt-units-merc NO-LOCK  .
      571   END PROCEDURE.
      572   PROCEDURE fill-tt :
      573     define variable v-get-units as character no-undo initial "getUnitList_.xml" .
      574     define variable sw          as handle    no-undo .
      575     define variable parser      as class     ParserXMLUnits.
      576     define variable Msg         as character no-undo .
      577     create sax-writer sw .
      578     sw:formatted = true.
      579     sw:set-output-destination ("file", v-get-units).
      580     sw:encoding = "UTF-8".
      581     sw:start-document () .
      582     sw:start-element ("se:Envelope") .
      583     sw:insert-attribute ("xmlns:se", "http://schemas.xmlsoap.org/soap/envelope/") .
      584     sw:insert-attribute ("xmlns:ws", "http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2") .
      585     sw:insert-attribute ("xmlns:bs", "http://api.vetrf.ru/schema/cdm/base") .
      586       sw:start-element ("se:Body") .
      587         sw:start-element ("ws:getUnitListRequest") .
      588           sw:start-element ("bs:listOptions") .
      589           sw:write-data-element ("bs:count", "1000") .
      590           sw:write-data-element ("bs:offset", "0") .
      591           sw:end-element ("bs:listOptions") .
      592         sw:end-element ("ws:getUnitListRequest") .
      593       sw:end-element ("se:Body") .
      594     sw:end-element ("se:Envelope") .
      595     sw:end-document () .
      596     if trim(v-proxy-addres) <> "" and v-proxy-addres <> ?
      597     then do :
      598       if v-proxy-ssl
      599       then do :
      600         cmd = substitute ("&1 -k --proxy-negotiate -x &7 -U : -u &4:&5 -d @&2 &6/platform/services/2.1/DictionaryService >&3",
      601                         search ("exe/curl.exe"), search (v-get-units), "UnitList_.xml", v-login, v-password, v-server, v-proxy-addres).
      602       end.
      603       else do :
      604         cmd = substitute ("&1 -x &7 -U &8:&9 -u &4:&5 -d @&2 &6/platform/services/2.1/DictionaryService >&3",
      605                         search ("exe/curl.exe"), search (v-get-units), "UnitList_.xml", v-login, v-password, v-server, v-proxy-addres, v-proxy-login, v-proxy-pswd).
      606       end.
      607     end.
      608     else do :
      609       cmd = substitute ("&1 -u &4:&5 -d @&2 &6/platform/services/2.1/DictionaryService >&3", search ("exe/curl.exe"), search (v-get-units), "UnitList_.xml", v-login, v-password, v-server).
      610     end.
      611     os-command silent value (cmd).
      612     parser = new parserXmlUnits().
      613     parser:ParseResponse
      614       (search("UnitList_.xml")
      615       ,input-output TABLE tt-units-merc
      616       ,output Msg) no-error.
      617     if Msg <> "" then
      618     do:
      619       message Msg
      620         view-as alert-box.
      621     end.
      622   END PROCEDURE.
