     2446                   tt-gds-act.alc-code = entry(3, buf_parts.alc-ref-ab-path) .
     2447               end.
     2448               else do :
     2449                   run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     2450                                                      ,input (buffer buf_goods:handle)
     2451                                                      ,output v-gds-uniq-key-rec).
     2452                   find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2453                                                      and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2454                                                      AND X_ext-classif.db-num = 0
     2455                                                      and X_ext-classif.key#_one = buf_goods.gds-code
     2456                                                      and X_ext-classif.key#_two = v-ext-sys
     2457                                                      and X_ext-classif.key#_three = 0
     2458                                                      and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2459                                                      and X_eXt-classif.charkey_two = ""
     2460                                                      and X_eXt-classif.charkey_three = ""
     2461                                                      and X_eXt-classif.nonunique = 0
     2462                                                      no-error .
     2463                   if available X_ext-classif then tt-gds-act.alc-code = X_eXt-classif.charkey_one .
     2464               end.
     2465               if num-entries(buf_parts.alc-ref-ab-path) = 4 and entry(2, buf_parts.alc-ref-ab-path) <> "" then do :
     2466                   tt-gds-act.inform-B = trim(entry(2, buf_parts.alc-ref-ab-path)) .
     2467               end.
     2468           end.
     2469       end.
     2470       output stream str-log close .
     2471       if err-good then do :
     2472           message "Не все выбранные товары добавлены в акт!" view-as alert-box .
     2473           run gbl/prnfilen.w
     2474              (input  "Ошибки при добавлении товаров"
     2475              ,input  0
     2476              ,input  "act-TTS_log.err"
     2477              ,input  7
     2478              ,output v-user-action
     2479              ,output v-printed
     2480              ).    end.
     2481       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2482   END.
     2483   on choose of menu-item m-one-good in menu m-add
     2484   DO:
     2485       run ref/gds-ref.p
     2486       ( parparentproc
     2487       ,'b-sel,b-add'
     2488       ,?
     2489       ,?
     2490       ,'все':U
     2491       ,?
     2492       ,?
     2493       ,?
     2494       ,?
     2495       ,v-cntxt-obj-type
     2496       ,v-cntxt-obj-code
     2497       ,?
     2498       , output v-rid-list) no-error.
     2499       if v-rid-list = "" or v-rid-list = ?
