     2568           tt-gds-act.qnty       = 0
     2569       .
     2570       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2571   END.
     2572   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2573   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2574   MAIN-BLOCK:
     2575   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2576      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2577       assign
     2578           b-good:popup-menu in frame Dialog-Frame = menu m-add:handle
     2579           b-good:menu-mouse = 1
     2580           nn = 0
     2581       .
     2582       empty temp-table tt-exts .
     2583       if p-mode = 'ДОБАВЛЕНИЕ':U then do :
     2584           v-date = substitute ("&1&2&3", string (day (now), "99"), string (month (now), "99"),substring (string(year (now)), 3,2)).
     2585           create tt-act-header .
     2586           assign
     2587               tt-act-header.num = "TTS-" + v-date + '-' + substring(v-cntxt-obj-type,1,1) + string(v-cntxt-obj-code) + '-' + string(int(TIME))
     2588               tt-act-header.date_ = TODAY
     2589               tt-act-header.is-sent = no
     2590           .
     2591           display tt-act-header.num tt-act-header.date_ with frame Dialog-Frame.
     2592           enable  tt-act-header.date_ b-good with frame Dialog-Frame.
     2593       end.
     2594       if p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ПРОСМОТР':U then do :
     2595           find last buf_clob-bind where buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value
     2596                                     and buf_clob-bind.field-name_ = 'egais-tts':U
     2597                                     and buf_clob-bind.part-num = 1  .
     2598           find first buf_clob-data no-lock where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     2599           copy-lob
     2600           from  object buf_clob-data.cdata
     2601           to  file 'temp-tts.xml'
     2602           no-convert
     2603           no-error .
     2604           run waitfram-show in this-procedure ("Ждите...") .
     2605           run parseXML in this-procedure (input "temp-tts.xml") .
     2606           run waitfram-hide in this-procedure .
     2607           display tt-act-header.num tt-act-header.date_ with frame Dialog-Frame.
     2608           if p-mode = 'ИЗМЕНЕНИЕ':U then
     2609           for each tt-gds-act no-lock :
     2610               nn = nn + 1 .
     2611               find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code no-error .
     2612               if not available buf_goods then do :
     2613                   message "По алкогольному коду " tt-gds-act.alc-code " не найден товар из TH. Вероятно, кто-то удалил связку." view-as alert-box.
     2614                   next.
     2615               end.
     2616               run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     2617                                               ,input (buffer buf_goods:handle)
     2618                                               ,output v-gds-uniq-key-rec).
     2619               for each X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2620                                              and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2621                                              AND X_ext-classif.db-num = 0
     2622                                              and X_ext-classif.key#_one = buf_goods.gds-code
     2623                                              and X_ext-classif.key#_two = v-ext-sys
     2624                                              and X_ext-classif.key#_three = 0
     2625                                              and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2626                                              and X_eXt-classif.charkey_two = ""
     2627                                              and X_eXt-classif.charkey_three = ""
     2628                                              and X_eXt-classif.nonunique = 0 :
     2629                   find first tt-exts no-lock where tt-exts.ext-rec = recid(x_ext-classif)
     2630                                            and tt-exts.gds-code = buf_goods.gds-code no-error.
     2631                   if not available tt-exts then do :
     2632                       create tt-exts .
     2633                       assign
     2634                           tt-exts.ext-rec = recid(X_ext-classif)
     2635                           tt-exts.gds-code = tt-gds-act.gds-code
     2636                       .
     2637                   end.
     2638               end.
     2639           end .
     2640           open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2641           if p-mode = 'ПРОСМОТР':U then disable b-good with frame Dialog-Frame.
     2642           else enable b-good with frame Dialog-Frame.
     2643       end.
     2644   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2645   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2646   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2647   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2648   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2649   define variable v-diasize-current-frame-height as decimal   no-undo .
     2650   define variable v-diasize-change-size          as logical   no-undo .
     2651   define variable v-diasize-resize-button        as handle    no-undo .
     2652   define variable v-diasize-wndmax               as logical   no-undo .
     2653   define variable v-diasize-wndstore             as logical   no-undo .
     2654   define variable v-diasize-proc-name            as character no-undo .
     2655   define variable v-diasize-browse-handle        as handle    no-undo .
     2656   define variable v-diasize-browse-number        as integer   no-undo .
     2657   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2658   define temp-table temp-diasize-handle no-undo
     2659     field handle-value  as handle
     2660     field save-position as decimal
     2661     index xpk is primary unique handle-value
     2662     .
     2663   define temp-table temp-browse-handle no-undo
     2664     field browse-type   as character
     2665     field browse-number as integer
     2666     field browse-handle as handle
     2667     field original-size as decimal
     2668     index xpk is primary unique browse-type browse-number
     2669     index xie browse-type browse-handle
     2670   .
     2671   procedure diasize_change-height :
     2672     define input  parameter p-change-value  as decimal   no-undo .
     2673     define input  parameter p-move-resize   as logical   no-undo .
     2674     define variable v-field-group-handle    as handle    no-undo .
     2675     define variable v-object-handle         as handle    no-undo .
     2676     define variable v-frame-height          as decimal   no-undo .
     2677     define variable v-frame-virtual-height  as decimal   no-undo .
     2678     define variable v-browse-height         as decimal   no-undo .
     2679     define variable v-window-height         as decimal   no-undo .
     2680     define variable v-window-virtual-height as decimal   no-undo .
     2681     define variable v-change-sign           as integer   no-undo .
     2682     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2683     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2684     if p-change-value > 0
     2685     then do:
     2686       if frame Dialog-Frame :height + p-change-value
     2687           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2688       then do:
     2689         assign
     2690           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2691                           - (frame Dialog-Frame :height-chars)
     2692         .
     2693         if p-change-value <= 0
     2694         then do:
     2695           run diasize_position-resize-button in this-procedure .
     2696           return .
     2697         end.
     2698       end.
     2699     end.
     2700     if p-change-value < 0
     2701     then do:
     2702       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2703       then do:
     2704         assign
     2705           p-change-value = v-diasize-orig-frame-height
     2706                          - (frame Dialog-Frame :height-chars)
     2707         .
     2708         if p-change-value >= 0
     2709         then do:
     2710           run diasize_position-resize-button in this-procedure .
     2711           return .
     2712         end.
     2713       end.
     2714     end.
     2715     if p-change-value >= 0
     2716     then do:
     2717       assign
     2718         v-change-sign = 1
     2719       .
     2720     end.
     2721     else do:
     2722       assign
     2723         v-change-sign = -1
     2724       .
     2725     end.
     2726     assign
     2727       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2728     .
     2729     if p-change-value = 0
     2730     then do:
     2731       run diasize_position-resize-button in this-procedure .
     2732       return .
     2733     end.
     2734     move_block:
     2735     do
     2736     on error undo move_block, retry move_block
     2737     :
     2738       if retry
     2739       then do:
     2740         do
     2741         on error undo move_block, leave move_block
     2742         :
     2743           if p-change-value > 0
     2744           then do:
     2745             for each buf_temp-diasize-handle
     2746             on error undo, next
     2747             :
     2748               assign
     2749                 v-object-handle = buf_temp-diasize-handle.handle-value
     2750               .
     2751               if v-object-handle <> v-diasize-resize-button
     2752               then do:
     2753                 assign
     2754                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2755                 .
     2756               end.
     2757             end.
     2758             assign
     2759               v-diasize-browse-handle :height = v-browse-height
     2760             .
     2761             for each buf_temp-browse-handle
     2762               where buf_temp-browse-handle.browse-type = 'height':u
     2763             on error undo, next
     2764             :
     2765               assign
     2766                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2767               .
     2768             end.
     2769             assign
     2770               frame Dialog-Frame :height = v-frame-height
     2771             .
     2772             if frame Dialog-Frame :scrollable = true
     2773             then do:
     2774               assign
     2775                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2776               .
     2777             end.
     2778             run diasize_position-resize-button in this-procedure .
     2779           end.
     2780           else do:
     2781             if frame Dialog-Frame :scrollable = true
     2782             then do:
     2783               assign
     2784                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2785               .
     2786             end.
     2787             assign
     2788               frame Dialog-Frame :height = v-frame-height
     2789             .
     2790             assign
     2791               v-diasize-browse-handle :height = v-browse-height
     2792             .
     2793             for each buf_temp-browse-handle
     2794               where buf_temp-browse-handle.browse-type = 'height':u
     2795             on error undo, next
     2796             :
     2797               assign
     2798                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2799               .
     2800             end.
     2801             for each buf_temp-diasize-handle
     2802             on error undo, next
     2803             :
     2804               assign
     2805                 v-object-handle = buf_temp-diasize-handle.handle-value
     2806               .
     2807               if v-object-handle <> v-diasize-resize-button
     2808               then do:
     2809                 assign
     2810                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2811                 .
     2812               end.
     2813             end.
     2814             run diasize_position-resize-button in this-procedure .
     2815           end.
     2816           assign
     2817             v-diasize-change-size = false
     2818           .
     2819           leave move_block .
     2820         end.
     2821       end.
     2822       assign
     2823         v-diasize-need-full-display = true
     2824       .
     2825       if v-diasize-change-size = false
     2826       then do:
     2827         assign
     2828           v-diasize-change-size = true
     2829         .
     2830       end.
     2831       else do:
     2832         return .
     2833       end.
     2834       assign
     2835         v-frame-height = frame Dialog-Frame :height
     2836         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2837         v-browse-height = v-diasize-browse-handle :height
     2838       .
     2839       for each buf_temp-browse-handle
     2840         where buf_temp-browse-handle.browse-type = 'height':u
     2841       :
     2842         assign
     2843           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2844         .
     2845       end.
     2846       for each buf_temp-diasize-handle
     2847       :
     2848         delete buf_temp-diasize-handle .
     2849       end.
     2850       assign
     2851         v-field-group-handle = frame Dialog-Frame :first-child
     2852       .
     2853       do while valid-handle(v-field-group-handle)
     2854       :
     2855         assign
     2856           v-object-handle = v-field-group-handle :first-child
     2857         .
     2858         do while valid-handle(v-object-handle)
     2859         :
     2860           if  v-object-handle <> v-diasize-browse-handle :handle
     2861           and can-query(v-object-handle, "row")
     2862           and can-query(v-object-handle, "height")
     2863           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2864           then do:
     2865             find first buf_temp-browse-handle
     2866               where buf_temp-browse-handle.browse-type   = 'height':u
     2867                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2868               no-error .
     2869             if available buf_temp-browse-handle
     2870             then do:
     2871             end.
     2872             else do:
     2873               create buf_temp-diasize-handle .
     2874               assign
     2875                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2876                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2877               .
     2878             end.
     2879           end.
     2880           assign
     2881             v-object-handle = v-object-handle :next-sibling
     2882           .
     2883         end.
     2884         assign
     2885           v-field-group-handle = v-field-group-handle :next-sibling
     2886         .
     2887       end.
     2888       do with frame Dialog-Frame
     2889       :
     2890         hide v-diasize-resize-button .
     2891         assign
     2892           v-diasize-resize-button :row    = 1
     2893           v-diasize-resize-button :column = 1
     2894         .
     2895       end.
     2896       if p-change-value > 0
     2897       then do:
     2898         if frame Dialog-Frame :scrollable = true
     2899         then do:
     2900           assign
     2901             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2902             no-error .
     2903           if error-status :error
     2904           or error-status :get-message(1) <> ""
     2905           then do:
     2906             undo move_block, retry move_block .
     2907           end.
     2908         end.
     2909         assign
     2910           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2911           no-error .
     2912         if error-status :error
     2913         or error-status :get-message(1) <> ""
     2914         then do:
     2915           undo move_block, retry move_block .
     2916         end.
     2917         assign
     2918           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2919           no-error .
     2920         if error-status :error
     2921         or error-status :get-message(1) <> ""
     2922         then do:
     2923           undo move_block, retry move_block .
     2924         end.
     2925         for each buf_temp-browse-handle
     2926           where buf_temp-browse-handle.browse-type = 'height':u
     2927         on error undo move_block, retry move_block
     2928         :
     2929           assign
     2930             buf_temp-browse-handle.browse-handle :height
     2931               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2932             no-error .
     2933           if error-status :error
     2934           or error-status :get-message(1) <> ""
     2935           then do:
     2936             undo move_block, retry move_block .
     2937           end.
     2938         end.
     2939         for each buf_temp-diasize-handle
     2940         on error undo move_block, retry move_block
     2941         :
     2942           assign
     2943             v-object-handle = buf_temp-diasize-handle.handle-value
     2944           .
     2945           if v-object-handle <> v-diasize-resize-button
     2946           then do:
     2947             assign
     2948               v-object-handle :row = v-object-handle :row + p-change-value
     2949               no-error .
     2950             if error-status :error
     2951             or error-status :get-message(1) <> ""
     2952             then do:
     2953               undo move_block, retry move_block .
     2954             end.
     2955           end.
     2956         end.
     2957       end.
     2958       else do:
     2959         for each buf_temp-diasize-handle
     2960         on error undo move_block, retry move_block
     2961         :
     2962           assign
     2963             v-object-handle = buf_temp-diasize-handle.handle-value
     2964           .
     2965           if v-object-handle <> v-diasize-resize-button
     2966           then do:
     2967             assign
     2968               v-object-handle :row = v-object-handle :row + p-change-value
     2969               no-error .
     2970             if error-status :error
     2971             or error-status :get-message(1) <> ""
     2972             then do:
     2973               undo move_block, retry move_block .
     2974             end.
     2975           end.
     2976         end.
     2977         assign
     2978           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2979           no-error .
     2980         if error-status :error
     2981         or error-status :get-message(1) <> ""
     2982         then do:
     2983           undo move_block, retry move_block .
     2984         end.
     2985         for each buf_temp-browse-handle
     2986           where buf_temp-browse-handle.browse-type = 'height':u
     2987         on error undo move_block, retry move_block
     2988         :
     2989           assign
     2990             buf_temp-browse-handle.browse-handle :height
     2991               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2992             no-error .
     2993           if error-status :error
     2994           or error-status :get-message(1) <> ""
     2995           then do:
     2996             undo move_block, retry move_block .
     2997           end.
     2998         end.
     2999         assign
     3000           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3001           no-error .
     3002         if error-status :error
     3003         or error-status :get-message(1) <> ""
     3004         then do:
     3005           undo move_block, retry move_block .
     3006         end.
     3007         if frame Dialog-Frame :scrollable = true
     3008         then do:
     3009           assign
     3010             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3011             no-error .
     3012           if error-status :error
     3013           or error-status :get-message(1) <> ""
     3014           then do:
     3015             undo move_block, retry move_block .
     3016           end.
     3017         end.
     3018       end.
     3019       if p-move-resize = true
     3020       then do:
     3021         run diasize_position-resize-button in this-procedure .
     3022       end.
     3023       if v-diasize-wndstore = true
     3024       then do:
     3025         if connected("ub") = true
     3026         then do:
     3027           define variable v-cntxt-db-num        as integer   no-undo .
     3028           define variable v-cntxt-userid        as character no-undo .
     3029           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3030                                             , OUTPUT v-cntxt-userid
     3031                                             ) .
     3032           run gbl/wndsizew.p
     3033             (input  v-cntxt-db-num
     3034             ,input  v-cntxt-userid
     3035             ,input  v-diasize-proc-name
     3036             ,input  'height':u
     3037             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3038             ) .
     3039         end.
     3040       end.
     3041     end.
     3042     assign
     3043       v-diasize-change-size = false
     3044     .
     3045   end procedure.
     3046   procedure diasize_set-height :
     3047     define input  parameter p-new-height  as decimal   no-undo .
     3048     define input  parameter p-move-resize as logical   no-undo .
     3049     do
     3050     on error undo, return error return-value
     3051     :
     3052       run diasize_change-height in this-procedure
     3053         (input  (p-new-height - frame Dialog-Frame :height)
     3054         ,input  p-move-resize
     3055         ) .
     3056     end.
     3057   end procedure.
     3058   procedure diasize_change-width :
     3059     define input  parameter p-change-value as decimal   no-undo .
     3060     define input  parameter p-move-resize  as logical   no-undo .
     3061     define variable v-field-group-handle   as handle    no-undo .
     3062     define variable v-object-handle        as handle    no-undo .
     3063     define variable v-frame-width          as decimal   no-undo .
     3064     define variable v-frame-virtual-width  as decimal   no-undo .
     3065     define variable v-browse-width         as decimal   no-undo .
     3066     define variable v-window-width         as decimal   no-undo .
     3067     define variable v-window-virtual-width as decimal   no-undo .
     3068     define variable v-change-sign          as integer   no-undo .
     3069     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3070     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3071     if p-change-value > 0
     3072     then do:
     3073       if frame Dialog-Frame :width + p-change-value >
     3074           session :width-chars
     3075       then do:
     3076         assign
     3077           p-change-value = session :width-chars - frame Dialog-Frame :width
     3078         .
     3079         if p-change-value <= 0
     3080         then do:
     3081           run diasize_position-resize-button in this-procedure .
     3082           return .
     3083         end.
     3084       end.
     3085     end.
     3086     if p-change-value < 0
     3087     then do:
     3088       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3089       then do:
     3090         assign
     3091           p-change-value = v-diasize-orig-frame-width
     3092                          - frame Dialog-Frame :width
     3093         .
     3094         if p-change-value >= 0
     3095         then do:
     3096           run diasize_position-resize-button in this-procedure .
     3097           return .
     3098         end.
     3099       end.
     3100     end.
     3101     if p-change-value >= 0
     3102     then do:
     3103       assign
     3104         v-change-sign = 1
     3105       .
     3106     end.
     3107     else do:
     3108       assign
     3109         v-change-sign = -1
     3110       .
     3111     end.
     3112     assign
     3113       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3114     .
     3115     if p-change-value = 0
     3116     then do:
     3117       run diasize_position-resize-button in this-procedure .
     3118       return .
     3119     end.
     3120     move_block:
     3121     do
     3122     on error undo move_block, leave move_block
     3123     :
     3124       if retry
     3125       then do:
     3126         do
     3127         on error undo move_block, leave move_block
     3128         :
     3129           if p-change-value > 0
     3130           then do:
     3131             for each buf_temp-diasize-handle
     3132             on error undo, next
     3133             :
     3134               assign
     3135                 v-object-handle = buf_temp-diasize-handle.handle-value
     3136               .
     3137               if v-object-handle <> v-diasize-resize-button
     3138               then do:
     3139                 assign
     3140                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3141                 .
     3142               end.
     3143             end.
     3144             assign
     3145               v-diasize-browse-handle :width = v-browse-width
     3146             .
     3147             for each buf_temp-browse-handle
     3148               where buf_temp-browse-handle.browse-type = 'width':u
     3149             on error undo, next
     3150             :
     3151               assign
     3152                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3153               .
     3154             end.
     3155             assign
     3156               frame Dialog-Frame :width = v-frame-width
     3157             .
     3158             if frame Dialog-Frame :scrollable = true
     3159             then do:
     3160               assign
     3161                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3162               .
     3163             end.
     3164             run diasize_position-resize-button in this-procedure .
     3165           end.
     3166           else do:
     3167             if frame Dialog-Frame :scrollable = true
     3168             then do:
     3169               assign
     3170                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3171               .
     3172             end.
     3173             assign
     3174               frame Dialog-Frame :width = v-frame-width
     3175             .
     3176             for each buf_temp-browse-handle
     3177               where buf_temp-browse-handle.browse-type = 'width':u
     3178             on error undo, next
     3179             :
     3180               assign
     3181                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3182               .
     3183             end.
     3184             assign
     3185               v-diasize-browse-handle :width = v-browse-width
     3186             .
     3187             for each buf_temp-diasize-handle
     3188             on error undo, next
     3189             :
     3190               assign
     3191                 v-object-handle = buf_temp-diasize-handle.handle-value
     3192               .
     3193               if v-object-handle <> v-diasize-resize-button
     3194               then do:
     3195                 assign
     3196                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3197                 .
     3198               end.
     3199             end.
     3200             run diasize_position-resize-button in this-procedure .
     3201           end.
     3202           assign
     3203             v-diasize-change-size = false
     3204           .
     3205           leave move_block .
     3206         end.
     3207       end.
     3208       assign
     3209         v-diasize-need-full-display = true
     3210       .
     3211       if v-diasize-change-size = false
     3212       then do:
     3213         assign
     3214           v-diasize-change-size = true
     3215         .
     3216       end.
     3217       else do:
     3218         return .
     3219       end.
     3220       assign
     3221         v-frame-width = frame Dialog-Frame :width
     3222         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3223         v-browse-width = v-diasize-browse-handle :width
     3224       .
     3225       for each buf_temp-browse-handle
     3226         where buf_temp-browse-handle.browse-type = 'width':u
     3227       :
     3228         assign
     3229           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3230         .
     3231       end.
     3232       for each buf_temp-diasize-handle
     3233       :
     3234         delete buf_temp-diasize-handle .
     3235       end.
     3236       assign
     3237         v-field-group-handle = frame Dialog-Frame :first-child
     3238       .
     3239       do while valid-handle(v-field-group-handle)
     3240       :
     3241         assign
     3242           v-object-handle = v-field-group-handle :first-child
     3243         .
     3244         do while valid-handle(v-object-handle)
     3245         :
     3246           if  v-object-handle <> v-diasize-browse-handle :handle
     3247           and v-object-handle <> v-diasize-resize-button
     3248           and can-query(v-object-handle, "row")
     3249           and can-query(v-object-handle, "height")
     3250           and ( v-object-handle :col + v-object-handle :width
     3251                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3252               )
     3253           then do:
     3254             find first buf_temp-browse-handle
     3255               where buf_temp-browse-handle.browse-type   = 'width':u
     3256                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3257               no-error .
     3258             if available buf_temp-browse-handle
     3259             then do:
     3260             end.
     3261             else do:
     3262               create buf_temp-diasize-handle .
     3263               assign
     3264                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3265                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3266               .
     3267             end.
     3268           end.
     3269           assign
     3270             v-object-handle = v-object-handle :next-sibling
     3271           .
     3272         end.
     3273         assign
     3274           v-field-group-handle = v-field-group-handle :next-sibling
     3275         .
     3276       end.
     3277       do with frame Dialog-Frame
     3278       :
     3279         hide v-diasize-resize-button .
     3280         v-diasize-resize-button :row = 1.
     3281         v-diasize-resize-button :column = 1.
     3282       end.
     3283       if p-change-value > 0
     3284       then do:
     3285         if frame Dialog-Frame :scrollable = true
     3286         then do:
     3287           assign
     3288             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3289             no-error .
     3290           if error-status :error
     3291           or error-status :get-message(1) <> ""
     3292           then do:
     3293             undo move_block, retry move_block.
     3294           end.
     3295         end.
     3296         assign
     3297           frame Dialog-Frame :width = v-frame-width + p-change-value
     3298           no-error .
     3299         if error-status :error
     3300         or error-status :get-message(1) <> ""
     3301         then do:
     3302           undo move_block, retry move_block.
     3303         end.
     3304         assign
     3305           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3306         no-error .
     3307         if error-status :error
     3308         or error-status :get-message(1) <> ""
     3309         then do:
     3310           undo move_block, retry move_block.
     3311         end.
     3312         for each buf_temp-browse-handle
     3313           where buf_temp-browse-handle.browse-type = 'width':u
     3314         on error undo move_block, retry move_block
     3315         :
     3316           assign
     3317             buf_temp-browse-handle.browse-handle :width
     3318               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3319             no-error .
     3320           if error-status :error
     3321           or error-status :get-message(1) <> ""
     3322           then do:
     3323             undo move_block, retry move_block .
     3324           end.
     3325         end.
     3326         for each buf_temp-diasize-handle
     3327         on error undo move_block, retry move_block
     3328         :
     3329           assign
     3330             v-object-handle = buf_temp-diasize-handle.handle-value
     3331           .
     3332           if v-object-handle <> v-diasize-resize-button
     3333           then do:
     3334             assign
     3335               v-object-handle :col = v-object-handle :col + p-change-value
     3336               no-error .
     3337             if error-status :error
     3338             or error-status :get-message(1) <> ""
     3339             then do:
     3340               undo move_block, retry move_block .
     3341             end.
     3342           end.
     3343         end.
     3344       end.
     3345       else do:
     3346         for each buf_temp-diasize-handle
     3347         on error undo move_block, retry move_block
     3348         :
     3349           assign
     3350             v-object-handle = buf_temp-diasize-handle.handle-value
     3351           .
     3352           if v-object-handle <> v-diasize-resize-button
     3353           then do:
     3354             assign
     3355               v-object-handle :col = v-object-handle :col + p-change-value
     3356               no-error .
     3357             if error-status :error
     3358             or error-status :get-message(1) <> ""
     3359             then do:
     3360               undo move_block, retry move_block .
     3361             end.
     3362           end.
     3363         end.
     3364         for each buf_temp-browse-handle
     3365           where buf_temp-browse-handle.browse-type = 'width':u
     3366         on error undo move_block, retry move_block
     3367         :
     3368           assign
     3369             buf_temp-browse-handle.browse-handle :width
     3370               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3371             no-error .
     3372           if error-status :error
     3373           or error-status :get-message(1) <> ""
     3374           then do:
     3375             undo move_block, retry move_block .
     3376           end.
     3377         end.
     3378         assign
     3379           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3380           no-error .
     3381         if error-status :error
     3382         or error-status :get-message(1) <> ""
     3383         then do:
     3384           undo move_block, retry move_block.
     3385         end.
     3386         assign
     3387           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3388         no-error .
     3389         if error-status :error
     3390         or error-status :get-message(1) <> ""
     3391         then do:
     3392           undo move_block, retry move_block.
     3393         end.
     3394         if frame Dialog-Frame :scrollable = true
     3395         then do:
     3396           assign
     3397             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3398           no-error .
     3399           if error-status :error
     3400           or error-status :get-message(1) <> ""
     3401           then do:
     3402             undo move_block, retry move_block.
     3403           end.
     3404         end.
     3405       end.
     3406       if p-move-resize
     3407       then do:
     3408         run diasize_position-resize-button in this-procedure .
     3409       end.
     3410       if v-diasize-wndstore = true
     3411       then do:
     3412         if connected("ub") = true
     3413         then do:
     3414           define variable v-cntxt-db-num        as integer   no-undo .
     3415           define variable v-cntxt-userid        as character no-undo .
     3416           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3417                                             , OUTPUT v-cntxt-userid
     3418                                             ) .
     3419           run gbl/wndsizew.p
     3420             (input  v-cntxt-db-num
     3421             ,input  v-cntxt-userid
     3422             ,input  v-diasize-proc-name
     3423             ,input  'width':u
     3424             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3425             ) .
     3426         end.
     3427       end.
     3428     end.
     3429     assign
     3430       v-diasize-change-size = false
     3431     .
     3432   end procedure.
     3433   procedure diasize_set-width :
     3434     define input  parameter p-new-width  as decimal   no-undo .
     3435     define input  parameter p-move-resize as logical   no-undo .
     3436     do
     3437     on error undo, return error return-value
     3438     :
     3439       run diasize_change-width in this-procedure
     3440         (input  (p-new-width - frame Dialog-Frame :width)
     3441         ,input  p-move-resize
     3442         ) .
     3443     end.
     3444   end procedure.
     3445   procedure diasize_position-resize-button :
     3446     do with frame Dialog-Frame
     3447     :
     3448       hide v-diasize-resize-button .
     3449       assign
     3450         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3451                     - 1
     3452                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3453         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3454                     - 1
     3455                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3456       .
     3457       view v-diasize-resize-button .
     3458     end.
     3459   end procedure.
     3460   on alt-right anywhere
     3461   do:
     3462     run diasize_change-width in this-procedure
     3463       (input 1
     3464       ,input true
     3465       ) .
     3466     return no-apply .
     3467   end.
     3468   on alt-left anywhere
     3469   do:
     3470     run diasize_change-width in this-procedure
     3471       (input -1
     3472       ,input true
     3473       ) .
     3474     return no-apply .
     3475   end.
     3476   on alt-down anywhere
     3477   do:
     3478     run diasize_change-height in this-procedure
     3479       (input 1
     3480       ,input true
     3481       ) .
     3482     return no-apply .
     3483   end.
     3484   on alt-up anywhere
     3485   do:
     3486     run diasize_change-height in this-procedure
     3487       (input -1
     3488       ,input true
     3489       ) .
     3490     return no-apply .
     3491   end.
     3492   on alt-enter of frame Dialog-Frame
     3493   do:
     3494     run diasize_maximize in this-procedure
     3495       (input  ?
     3496       ).
     3497     return no-apply .
     3498   end.
     3499   procedure diasize_end-move :
     3500     do
     3501     on error undo, return error return-value
     3502     :
     3503       define variable v-row-delta as decimal   no-undo .
     3504       define variable v-col-delta as decimal   no-undo .
     3505       define variable v-new-row as decimal   no-undo .
     3506       define variable v-new-col as decimal   no-undo .
     3507       assign
     3508         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3509         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3510       .
     3511       assign
     3512         v-row-delta = v-new-row - frame Dialog-Frame :height
     3513         v-col-delta = v-new-col - frame Dialog-Frame :width
     3514       .
     3515       run diasize_change-height in this-procedure
     3516         (input v-row-delta
     3517         ,input true
     3518         ) .
     3519       run diasize_change-width in this-procedure
     3520         (input v-col-delta
     3521         ,input true
     3522         ) .
     3523     end.
     3524   end procedure.
     3525   procedure diasize_maximize :
     3526     define input  parameter p-action as logical   no-undo .
     3527     do
     3528     on error undo, return error return-value
     3529     :
     3530       if p-action = ?
     3531       then do:
     3532         if v-diasize-need-maximize = true
     3533         then do:
     3534           assign
     3535             p-action = true
     3536           .
     3537         end.
     3538         else do:
     3539           assign
     3540             p-action = false
     3541           .
     3542         end.
     3543       end.
     3544       if p-action = true
     3545       then do:
     3546         run diasize_change-height in this-procedure
     3547           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3548               - frame Dialog-Frame :height-chars
     3549           ,input true
     3550           ) .
     3551         run diasize_change-width in this-procedure
     3552           (input session :width-chars
     3553               - frame Dialog-Frame :width-chars
     3554           ,input true
     3555           ) .
     3556         assign
     3557           v-diasize-need-maximize = false
     3558         .
     3559       end.
     3560       else do:
     3561         run diasize_change-width in this-procedure
     3562           (input v-diasize-orig-frame-width
     3563               - frame Dialog-Frame :width-chars
     3564           ,input true
     3565           ) .
     3566         run diasize_change-height in this-procedure
     3567           (input v-diasize-orig-frame-height
     3568               - frame Dialog-Frame :height-chars
     3569           ,input true
     3570           ) .
     3571         assign
     3572           v-diasize-need-maximize = true
     3573         .
     3574       end.
     3575     end.
     3576   end procedure.
     3577   procedure diasize_restore-orig-size :
     3578     do
     3579     on error undo, return error return-value
     3580     :
     3581       assign
     3582         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3583         v-diasize-current-frame-height = frame Dialog-Frame :height
     3584       .
     3585       run diasize_set-height in this-procedure
     3586         (input  v-diasize-orig-frame-height
     3587         ,input  true
     3588         ) .
     3589       run diasize_set-width in this-procedure
     3590         (input  v-diasize-orig-frame-width
     3591         ,input  true
     3592         ) .
     3593     end.
     3594   end procedure.
     3595   procedure diasize_restore-current-size :
     3596     do
     3597     on error undo, return error return-value
     3598     :
     3599       run diasize_set-height in this-procedure
     3600         (input  v-diasize-current-frame-height
     3601         ,input  true
     3602         ) .
     3603       run diasize_set-width in this-procedure
     3604         (input  v-diasize-current-frame-width
     3605         ,input  true
     3606         ) .
     3607     end.
     3608   end procedure.
     3609   procedure diasize_set-browse-handle :
     3610     define input  parameter p-browse-handle as handle   no-undo .
     3611     define buffer buf_temp-browse-handle for temp-browse-handle .
     3612     do
     3613     on error undo, return error return-value
     3614     :
     3615       assign
     3616         v-diasize-browse-handle = p-browse-handle
     3617       .
     3618       for each buf_temp-browse-handle
     3619       on error undo, return error return-value
     3620       :
     3621         delete buf_temp-browse-handle .
     3622       end.
     3623     end.
     3624   end procedure.
     3625   procedure diasize_add_browse :
     3626     define input  parameter p-browse-type   as character no-undo .
     3627     define input  parameter p-browse-handle as handle    no-undo .
     3628     define buffer buf_temp-browse-handle for temp-browse-handle .
     3629     do
     3630     on error undo, return error return-value
     3631     :
     3632       assign
     3633         v-diasize-browse-number = v-diasize-browse-number + 1
     3634       .
     3635       create buf_temp-browse-handle .
     3636       assign
     3637         buf_temp-browse-handle.browse-type   = p-browse-type
     3638         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3639         buf_temp-browse-handle.browse-handle = p-browse-handle
     3640       .
     3641     end.
     3642   end procedure.
     3643   procedure diasize_init :
     3644     define variable v-default-value    as logical   no-undo .
     3645     define variable v-restore-saved    as logical   no-undo .
     3646     define variable v-resize-value-str as character no-undo .
     3647     do
     3648     on error undo, return error return-value
     3649     :
     3650       do with frame Dialog-Frame
     3651       :
     3652         assign
     3653           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3654           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3655           v-diasize-browse-handle     = browse br-gds-act :handle
     3656         .
     3657         create button v-diasize-resize-button
     3658         assign
     3659           parent        = frame Dialog-Frame :first-child
     3660           label         = "s"
     3661           height-pixels = 16
     3662           width-pixels  = 16
     3663           visible       = true
     3664           sensitive     = true
     3665           movable       = true
     3666           triggers:
     3667             on end-move persistent run diasize_end-move in this-procedure .
     3668           end triggers.
     3669         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3670         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3671         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3672         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3673         assign
     3674           v-diasize-wndmax = false
     3675         .
     3676         if connected("ub") = true
     3677         then do:
     3678           define variable v-cntxt-db-num        as integer   no-undo .
     3679           define variable v-cntxt-userid        as character no-undo .
     3680           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3681                                             , OUTPUT v-cntxt-userid
     3682                                             ) .
     3683           run gbl/wndpar_r.p
     3684             (input  v-cntxt-db-num
     3685             ,input  v-cntxt-userid
     3686             ,input  'wndmax':U
     3687             ,output v-diasize-wndmax
     3688             ,output v-default-value
     3689             ) .
     3690         end.
     3691         assign
     3692           v-diasize-wndstore = false
     3693         .
     3694         if connected("ub") = true
     3695         then do:
     3696           run gbl/wndpar_r.p
     3697             (input  v-cntxt-db-num
     3698             ,input  v-cntxt-userid
     3699             ,input  'wndstore':U
     3700             ,output v-diasize-wndstore
     3701             ,output v-default-value
     3702             ) .
     3703         end.
     3704         assign
     3705           v-diasize-proc-name = entry(1, program-name(2), '.')
     3706         .
     3707         if v-diasize-wndstore = true
     3708         then do:
     3709           assign
     3710             v-restore-saved = false
     3711           .
     3712           if connected("ub") = true
     3713           then do:
     3714             run gbl/wndsizer.p
     3715               (input  v-cntxt-db-num
     3716               ,input  v-cntxt-userid
     3717               ,input  v-diasize-proc-name
     3718               ,input  'height':u
     3719               ,output v-resize-value-str
     3720               ) .
     3721             if v-resize-value-str <> '':U
     3722             then do:
     3723               run diasize_change-height in this-procedure
     3724                 (input  integer(v-resize-value-str)
     3725                 ,input  true
     3726                 ) .
     3727               assign
     3728                 v-restore-saved = true
     3729               .
     3730             end.
     3731           end.
     3732           if connected("ub") = true
     3733           then do:
     3734             run gbl/wndsizer.p
     3735               (input  v-cntxt-db-num
     3736               ,input  v-cntxt-userid
     3737               ,input  v-diasize-proc-name
     3738               ,input  'width':u
     3739               ,output v-resize-value-str
     3740               ) .
     3741             if v-resize-value-str <> '':U
     3742             then do:
     3743               run diasize_change-width in this-procedure
     3744                 (input  integer(v-resize-value-str)
     3745                 ,input  true
     3746                 ) .
     3747               assign
     3748                 v-restore-saved = true
     3749               .
     3750             end.
     3751           end.
     3752           if v-restore-saved <> true
     3753           then do:
     3754             if v-diasize-wndmax = true
     3755             then do:
     3756               run diasize_maximize in this-procedure
     3757                 (input  true
     3758                 ) .
     3759             end.
     3760           end.
     3761         end.
     3762         else do:
     3763           if v-diasize-wndmax = true
     3764           then do:
     3765             run diasize_maximize in this-procedure
     3766               (input  true
     3767               ) .
     3768           end.
     3769         end.
     3770       end.
     3771     end.
     3772   end procedure.
     3773   procedure diasize_need-full-display :
     3774     define output parameter p-need-full-display as logical   no-undo .
     3775     do
     3776     on error undo, return error return-value
     3777     :
     3778       assign
     3779         p-need-full-display = v-diasize-need-full-display
     3780       .
     3781       assign
     3782         v-diasize-need-full-display = false
     3783       .
     3784     end.
     3785   end procedure.
     3786   procedure get-context :
     3787      define output parameter p-db-num as integer          no-undo.
     3788      define output parameter p-user-id as character        no-undo.
     3789      define variable v-login               as character    no-undo.
     3790      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3791      define buffer buf_user-login  for ub.user-login .
     3792      do
     3793      on error undo, return error
     3794      :
     3795            FIND FIRST buf_sys-ctrl no-lock.
     3796            ASSIGN
     3797               v-login = USERID("ub")
     3798               p-db-num = buf_sys-ctrl.db-num
     3799            .
     3800            FIND FIRST buf_user-login
     3801                 WHERE buf_user-login.db-num = p-db-num
     3802                   AND buf_user-login.user-login = v-login
     3803                 no-lock
     3804                 no-error
     3805                 .
     3806            IF AVAILABLE buf_user-login
     3807            THEN DO:
     3808               assign
     3809                  p-user-id = buf_user-login.user-id
     3810               .
     3811            END.
     3812      end.
     3813   end procedure.
     3814       run diasize_init in this-procedure .
     3815       RUN enable_UI.
     3816       WAIT-FOR GO OF FRAME Dialog-Frame.
     3817   END.
     3818   RUN disable_UI.
     3819   PROCEDURE proc-b-mark :
     3820     define variable varlog as logical   no-undo .
     3821     if not available tt-gds-act then return.
     3822     run local-mark in this-procedure.
     3823     assign varlog = br-gds-act :select-next-row( ) in frame Dialog-Frame.
     3824     apply "ENTRY":U to br-gds-act in frame Dialog-Frame.
     3825     br-gds-act:refresh() in frame Dialog-Frame .
     3826   END PROCEDURE.
     3827   PROCEDURE local-mark :
     3828     if not available tt-gds-act then do:
     3829       message "Неправильный выбор строки.".
     3830       return no-apply.
     3831     end.
     3832   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3833   define variable v-str-recid15 as character no-undo .
     3834   define variable v-num-entry15 as integer   no-undo .
     3835   assign
     3836     v-str-recid15 = trim( string( recid( tt-gds-act ) , "->>>>>>>>>>>9":U ) )
     3837     v-num-entry15 = lookup( v-str-recid15 , select-list )
     3838   .
     3839   if v-num-entry15 > 0 then do:
     3840     assign
     3841       entry( v-num-entry15, select-list ) = "":U
     3842       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     3843     .
     3844   end.
     3845   else do:
     3846     assign
     3847       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid15
     3848     .
     3849   end.
     3850     br-gds-act:refresh() in frame Dialog-Frame .
     3851   END PROCEDURE.
     3852   PROCEDURE disable_UI :
     3853     HIDE FRAME Dialog-Frame.
     3854   END PROCEDURE.
     3855   PROCEDURE enable_UI :
     3856     ENABLE b-cancel  b-save br-gds-act b-del b-mark b-sel-all b-unmark
     3857         WITH FRAME Dialog-Frame.
     3858     VIEW FRAME Dialog-Frame.
     3859       if p-mode = 'ПРОСМОТР':U then do :
     3860           disable  tt-act-header.num tt-act-header.date_ with frame Dialog-Frame.
     3861           define variable hCol as handle no-undo .
     3862           define variable hBr  as handle no-undo .
     3863           define variable i    as integer no-undo .
     3864           hBr = browse br-gds-act:handle .
     3865           do i = 6 to 7 :
     3866               hCol = hBr:GET-BROWSE-COLUMN(i).
     3867               hCol:read-only = true .
     3868           end.
     3869           hide b-good b-save b-del b-alc-code in FRAME Dialog-Frame.
     3870       end.
     3871   END PROCEDURE.
