        1   using ibs.th.bge.egais.*.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-mode       as character no-undo .
        4   define input parameter egais        as class TransferToShop no-undo .
        5   define input parameter v-ext-sys    as integer no-undo .
        6   define input parameter v-fs-rar     as character no-undo .
        7   define input parameter bh-act-header  as handle no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "ЕГАИС Акт передачи продукции в магазин".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable ii                  as integer no-undo .
      114   define variable jj                  as integer no-undo .
      115   define variable nn                  as integer no-undo .
      116   define variable exts                as integer no-undo .
      117   define variable v-position_         as integer no-undo .
      118   define variable v-date              as character no-undo .
      119   define variable v-rid-list          as character no-undo .
      120   define variable par-alcohol         as character no-undo .
      121   define variable par-egais-name      as character no-undo .
      122   define variable par-type            as character no-undo .
      123   define variable v-attr-value        as character            no-undo .
      124   define variable v-attr-type         as character            no-undo .
      125   define variable err-good            as logical no-undo .
      126   define variable p-ext-rec           as recid no-undo .
      127   define variable glog        as logical no-undo .
      128   define variable v-obj-uniq-key-rec as character no-undo .
      129   define variable qh-gds-act          as handle no-undo .
      130   define variable bh-gds-act          as handle no-undo .
      131   define variable brh-gds-act         as handle no-undo .
      132   define variable v-gds-uniq-key-rec as character no-undo .
      133   define variable v-part-num    as integer   no-undo .
      134   define variable v-clob-db-num as integer   no-undo .
      135   define variable v-int64-id    as int64     no-undo .
      136   define variable v-info        as character no-undo .
      137   define variable v-longchar      as memptr no-undo .
      138   define buffer buf_goods         for ub.goods .
      139   define buffer buf_parts         for ub.parts .
      140   define buffer buf_trn-doc       for ub.trn-doc .
      141   define buffer buf_doc-line      for ub.doc-line .
      142   define buffer x_ext-classif     for ub.ext-classif .
      143   define buffer x_ext-classif-attr     for ub.ext-classif-attr .
      144   define buffer buf_clob-bind     for ub.clob-bind .
      145   define buffer buf_clob-data     for ub.clob-data .
      146   define stream str-log .
      147   define new global shared variable g#language as character no-undo .
      148   if g#language <> '' and g#language <> 'rus':U then do:
      149     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      150   end.
      151   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      152   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      153   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      154   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      155   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      156   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      157   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      158   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      159   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      160   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      161   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      162   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      163   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      164   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      165   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      166   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      167   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      168   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      169   define new global shared variable g#library  as handle no-undo .
      170   define new global shared variable g#library2 as handle no-undo .
      171   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172     define variable v-cntxt-db-num        as integer   no-undo .
      173     define variable v-cntxt-userid        as character no-undo .
      174     define variable v-cntxt-level         as character no-undo .
      175     define variable v-cntxt-host-code-obj as integer   no-undo .
      176     define variable v-cntxt-obj-type      as character no-undo .
      177     define variable v-cntxt-obj-code      as integer   no-undo .
      178     define variable v-cntxt-db-num-obj    as integer   no-undo .
      179     define variable v-cntxt-is-admin      as logical   no-undo .
      180   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      181     run mainmenu_getcntxt in parparentproc
      182       (output v-cntxt-db-num
      183       ,output v-cntxt-userid
      184       ,output v-cntxt-level
      185       ,output v-cntxt-host-code-obj
      186       ,output v-cntxt-obj-type
      187       ,output v-cntxt-obj-code
      188       ,output v-cntxt-db-num-obj
      189       ,output v-cntxt-is-admin
      190       ) .
      191   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      192   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      193   procedure gen-key-rec :
      194     define input  parameter p-tbl-name    as character no-undo.
      195     define input  parameter p-bh_tbl-name as handle    no-undo.
      196     define output parameter p-key-rec     as character no-undo.
      197     do
      198     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      199     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      200     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      201     :
      202       define variable fh               as handle    no-undo .
      203       define variable v-ok             as logical   no-undo .
      204       define variable v-inform         as character no-undo .
      205       define variable v-ind            as integer   no-undo .
      206       define variable v-idx-field-qnty as integer   no-undo .
      207       if p-tbl-name = ?
      208         or p-tbl-name = "":U
      209       then do:
      210         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      211       end.
      212       if not p-bh_tbl-name:available then do:
      213         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      214       end.
      215       assign
      216         p-key-rec = p-tbl-name
      217         v-inform  = p-bh_tbl-name:index-information(1)
      218         v-ind     = 2
      219       .
      220       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      221       on error undo, return error
      222       :
      223         assign
      224           v-inform = p-bh_tbl-name:index-information( v-ind )
      225           v-ind    = v-ind + 1
      226         .
      227       end.
      228       if v-inform = ?
      229         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      230         or entry( 3, v-inform, ",":U ) <> "1":U
      231       then do:
      232         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      233       end.
      234       else do:
      235         assign
      236           v-idx-field-qnty = num-entries( v-inform ) - 4
      237         .
      238         if v-idx-field-qnty < 2 then do:
      239           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      240         end.
      241         do v-ind = 1 to v-idx-field-qnty by 2
      242         on error undo, return error
      243         :
      244           assign
      245             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      246             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      247           .
      248         end.
      249       end.
      250       if p-key-rec = ? then do:
      251         assign
      252           p-key-rec = "":U
      253         .
      254         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      255       end.
      256     end.
      257     return.
      258   end procedure.
      259   procedure gen-where-keyr-tab :
      260     define input  parameter i-tableSerach as character no-undo.
      261     define input  parameter i-tablekey   as character  no-undo.
      262     define input  parameter p-key-rec    as character  no-undo.
      263     define input  parameter p-key-handle as handle     no-undo .
      264     define input  parameter p-db-name    as character  no-undo .
      265     define input  parameter p-tt-handle  as handle     no-undo .
      266     define output parameter o-Where      as character  no-undo.
      267     do
      268     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      269     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      270     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      271     :
      272       define variable v-full-tbl-name  as character no-undo .
      273       define variable bh_tbl-name      as handle    no-undo .
      274       define variable fh_key           as handle    no-undo .
      275       define variable fh_search        as handle    no-undo .
      276       define variable v-field-num      as integer   no-undo .
      277       define variable v-count-fld      as integer   no-undo .
      278       define variable v-inform         as character no-undo .
      279       define variable v-ind            as integer   no-undo .
      280       define variable v-idx-field-qnty as integer   no-undo .
      281       define variable v-field-name     as character no-undo .
      282       define variable v-field-val      as character no-undo .
      283       define variable v-word-link      as character no-undo .
      284       define variable vTable           as character no-undo.
      285       define variable bh_tbl-key       as handle    no-undo .
      286       assign
      287         p-key-rec = trim( p-key-rec )
      288       .
      289       if p-key-handle <> ? then do:
      290         if not valid-handle(p-key-handle)
      291            or p-key-handle:type <> "buffer"
      292         then do:
      293           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      294         end.
      295         if num-entries( p-key-rec, chr(3) ) > 1
      296           or p-key-rec = ?
      297           or p-key-rec = "":U
      298         then do:
      299           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      300         end.
      301       end.
      302       else do:
      303         if p-key-rec = ?
      304           or p-key-rec = "":U
      305         then do:
      306           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      307         end.
      308       end.
      309       assign
      310         vTable = entry( 1 , p-key-rec, chr(3) )
      311       .
      312       if p-tt-handle <> ?
      313         and ( not valid-handle(p-tt-handle)
      314               or p-tt-handle:type <> "buffer"
      315             )
      316       then do:
      317         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      318       end.
      319       if p-tt-handle = ? then do:
      320         assign
      321           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      322         .
      323         create buffer bh_tbl-name for table v-full-tbl-name .
      324       end.
      325       else do:
      326         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      327       end.
      328       assign
      329         v-inform = bh_tbl-name:index-information(1)
      330         v-ind    = 2
      331       .
      332       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      333       on error undo, return error
      334       :
      335         assign
      336           v-inform = bh_tbl-name:index-information( v-ind )
      337           v-ind    = v-ind + 1
      338         .
      339       end.
      340       if v-inform = ?
      341         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      342         or entry( 3, v-inform, ",":U ) <> "1":U
      343       then do:
      344         delete object bh_tbl-name no-error.
      345         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      346       end.
      347       assign
      348         v-idx-field-qnty = num-entries( v-inform ) - 4
      349       .
      350       if v-idx-field-qnty < 2 then do:
      351         delete object bh_tbl-name no-error.
      352         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      353       end.
      354       assign
      355         o-where     = "where":U
      356         v-word-link = "":U
      357         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      358         v-count-fld = 0
      359       .
      360       if i-tablekey ne "" and i-tablekey ne ?
      361       then do:
      362         assign
      363           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      364         .
      365         create buffer bh_tbl-key for table v-full-tbl-name .
      366       end.
      367       if i-tableSerach ne "" and i-tableSerach ne ?
      368       then do:
      369         delete object bh_tbl-name no-error.
      370         assign
      371           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      372         .
      373         create buffer bh_tbl-name for table v-full-tbl-name .
      374       end.
      375       block_where:
      376       do v-ind = 1 to v-idx-field-qnty by 2
      377       on error undo, return error
      378       :
      379         assign
      380           v-count-fld = v-count-fld + 1
      381         .
      382         if p-key-handle = ?
      383           and v-count-fld > v-field-num
      384         then do:
      385           leave block_where.
      386         end.
      387         define variable VfieldKeyTable as handle no-undo.
      388         assign
      389           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      390           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      391         .
      392         if     bh_tbl-key ne ?
      393         then do:
      394            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      395            if VfieldKeyTable eq ?
      396            then next block_where.
      397         end.
      398         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      399         then
      400            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      401         else
      402            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      403         if p-key-handle = ? then do:
      404           assign
      405             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      406           .
      407         end.
      408         else do:
      409           assign
      410             fh_key = p-key-handle:buffer-field( v-field-name )
      411           .
      412           if fh_key = ?
      413             or not valid-handle( fh_key )
      414           then do:
      415             delete object bh_tbl-name.
      416             if     bh_tbl-key ne ?
      417             then
      418                delete object bh_tbl-key.
      419             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      420           end.
      421           assign
      422             v-field-val = fh_key:buffer-value
      423           .
      424         end.
      425         if fh_search:data-type ="character":U then do:
      426           assign
      427             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      428             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      429             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      430             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      431             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      432             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      433             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      434             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      435             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      436             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      437             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      438             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      439             v-field-val = substitute( '"&1"', v-field-val )
      440           .
      441         end.
      442         assign
      443           o-where = substitute( "&1 &2", o-where, v-field-val )
      444         .
      445         if v-word-link = "":U then do:
      446           assign
      447             v-word-link = "and":U
      448           .
      449         end.
      450       end.
      451       delete object bh_tbl-name.
      452       if     bh_tbl-key ne ?
      453       then
      454          delete object bh_tbl-key.
      455       if p-key-handle = ?
      456         and v-count-fld <> v-field-num
      457       then do:
      458         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      459       end.
      460     end.
      461   end procedure.
      462   procedure gen-hn-keyr-tab :
      463     define input  parameter i-tableSerach as character no-undo.
      464     define input  parameter i-tablekey   as character no-undo.
      465     define input  parameter p-key-rec    as character no-undo.
      466     define input  parameter p-key-handle as handle    no-undo .
      467     define input  parameter p-db-name    as character no-undo .
      468     define input  parameter p-tt-handle  as handle    no-undo .
      469     define input  parameter p-stts-lock  as integer   no-undo .
      470     define output parameter o-hn         as handle    no-undo.
      471     define variable v-full-tbl-name as character no-undo.
      472     define variable v-where         as character no-undo.
      473     define variable bh_tbl-name     as handle    no-undo.
      474     define variable vTable          as character no-undo.
      475     do
      476     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      477     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      478     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      479         run gen-where-keyr-tab(i-tableSerach,
      480                                i-tablekey,
      481                                p-key-rec,
      482                                p-key-handle,
      483                                p-db-name,
      484                                p-tt-handle,
      485                                output v-where).
      486         if i-tableSerach ne "" and i-tableSerach ne ?
      487         then do:
      488            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      489            create buffer bh_tbl-name for table v-full-tbl-name .
      490         end.
      491         else do:
      492            if p-tt-handle = ? then do:
      493               assign
      494                  vTable = entry( 1 , p-key-rec, chr(3) )
      495               .
      496               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      497               create buffer bh_tbl-name for table v-full-tbl-name .
      498            end.
      499            else do:
      500               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      501            end.
      502         end.
      503         if p-tt-handle = ? then do:
      504            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      505         end.
      506         else do:
      507            bh_tbl-name:find-first( v-where ) no-error .
      508         end.
      509         o-hn = bh_tbl-name.
      510      end.
      511   end procedure.
      512   procedure gen-hn-keyr :
      513     define input  parameter p-key-rec    as character no-undo.
      514     define input  parameter p-key-handle as handle    no-undo .
      515     define input  parameter p-db-name    as character no-undo .
      516     define input  parameter p-tt-handle  as handle    no-undo .
      517     define input  parameter p-stts-lock  as integer   no-undo .
      518     define output parameter o-hn         as handle    no-undo.
      519     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      520   end.
      521   procedure gen-row-keyr :
      522     define input  parameter p-key-rec    as character no-undo.
      523     define input  parameter p-key-handle as handle    no-undo .
      524     define input  parameter p-db-name    as character no-undo .
      525     define input  parameter p-tt-handle  as handle    no-undo .
      526     define input  parameter p-stts-lock  as integer   no-undo .
      527     define output parameter p-tbl-row    as rowid     no-undo.
      528     define output parameter p-tbl-name   as character no-undo.
      529     define variable vHn as handle no-undo.
      530       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      531       p-tbl-row = if vHn:available then vHn:rowid else ?.
      532       p-tbl-name =  vHn:table.
      533       delete object vHn no-error.
      534     if p-tbl-row = ? then do:
      535       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      536     end.
      537     else do:
      538       return.
      539     end.
      540   end procedure.
      541   procedure gen-key-fv :
      542     define input  parameter p-key-rec    as character no-undo .
      543     define output parameter p-field-list as character no-undo .
      544     define output parameter p-value-list as character no-undo.
      545     do
      546     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      547     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      548     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      549     :
      550       define variable v-full-tbl-name  as character no-undo .
      551       define variable bh_tbl-name      as handle    no-undo .
      552       define variable v-tbl-name       as character no-undo .
      553       define variable v-field-num      as integer   no-undo .
      554       define variable v-count-fld      as integer   no-undo .
      555       define variable v-inform         as character no-undo .
      556       define variable v-ind            as integer   no-undo .
      557       define variable v-idx-field-qnty as integer   no-undo .
      558       define variable v-delim-key      as character no-undo .
      559       if p-key-rec = ?
      560         or p-key-rec = "":U
      561       then do:
      562         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      563       end.
      564       assign
      565         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      566         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      567       .
      568       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      569       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
      570       assign
      571         v-inform = bh_tbl-name:index-information(1)
      572         v-ind    = 2
      573       .
      574       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      575       on error undo, return error
      576       :
      577         assign
      578           v-inform = bh_tbl-name:index-information( v-ind )
      579           v-ind    = v-ind + 1
      580         .
      581       end.
      582       if v-inform = ?
      583         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      584         or entry( 3, v-inform, ",":U ) <> "1":U
      585       then do:
      586         delete object bh_tbl-name no-error.
      587         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      588       end.
      589       assign
      590         v-idx-field-qnty = num-entries( v-inform ) - 4
      591       .
      592       if v-idx-field-qnty < 2 then do:
      593         delete object bh_tbl-name no-error.
      594         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      595       end.
      596       assign
      597         p-field-list = "":U
      598         p-value-list = "":U
      599         v-delim-key  = "":U
      600         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      601         v-count-fld  = 0
      602       .
      603       block_where:
      604       do v-ind = 1 to v-idx-field-qnty by 2
      605       on error undo, return error
      606       :
      607         assign
      608           v-count-fld = v-count-fld + 1
      609         .
      610         if v-count-fld > v-field-num then do:
      611           leave block_where.
      612         end.
      613         assign
      614           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      615           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      616         .
      617         if v-ind = 1 then do:
      618           assign
      619             v-delim-key = chr(3)
      620           .
      621         end.
      622       end.
      623       delete object bh_tbl-name.
      624       if v-count-fld <> v-field-num then do:
      625         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      626       end.
      627     end.
      628   end procedure.
      629   procedure gen-key-field :
      630     define input  parameter p-table      as character no-undo .
      631     define output parameter p-field-list as character no-undo .
      632     do
      633     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      634     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      635     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      636     :
      637       define variable v-full-tbl-name  as character no-undo .
      638       define variable bh_tbl-name      as handle    no-undo .
      639       define variable v-tbl-name       as character no-undo .
      640       define variable v-field-num      as integer   no-undo .
      641       define variable v-count-fld      as integer   no-undo .
      642       define variable v-inform         as character no-undo .
      643       define variable v-ind            as integer   no-undo .
      644       define variable v-idx-field-qnty as integer   no-undo .
      645       define variable v-delim-key      as character no-undo .
      646       if p-table = ?
      647         or p-table = "":U
      648       then do:
      649         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
      650       end.
      651       assign
      652         v-tbl-name      = p-table
      653         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      654       .
      655       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      656       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
      657       assign
      658         v-inform = bh_tbl-name:index-information(1)
      659         v-ind    = 2
      660       .
      661       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      662       on error undo, return error
      663       :
      664         assign
      665           v-inform = bh_tbl-name:index-information( v-ind )
      666           v-ind    = v-ind + 1
      667         .
      668       end.
      669       if v-inform = ?
      670         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      671         or entry( 3, v-inform, ",":U ) <> "1":U
      672       then do:
      673         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      674       end.
      675       assign
      676         v-idx-field-qnty = num-entries( v-inform ) - 4
      677       .
      678       if v-idx-field-qnty < 2 then do:
      679         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      680       end.
      681       assign
      682         p-field-list = "":U
      683         v-delim-key  = "":U
      684         v-count-fld  = 0
      685       .
      686       block_where:
      687       do v-ind = 1 to v-idx-field-qnty by 2
      688       on error undo, return error
      689       :
      690         assign
      691           v-count-fld = v-count-fld + 1
      692         .
      693         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      694         if v-ind = 1 then do:
      695           assign
      696             v-delim-key = chr(3)
      697           .
      698         end.
      699       end.
      700       delete object bh_tbl-name.
      701     end.
      702   end procedure.
      703   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      704   define new global shared variable g#attr-lib  as handle no-undo .
      705   define variable v-attr-lib-variable as handle no-undo .
      706   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      707   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      708   procedure thbjattr_code :
      709      define input  parameter p-upper-code     as character no-undo .
      710      define input  parameter p-code           as character no-undo .
      711      define output parameter p-label          as character no-undo .
      712      define output parameter p-user-can-edit  as logical   no-undo .
      713      define output parameter p-output-display as logical   no-undo .
      714      define output parameter p-other          as character no-undo .
      715      define output parameter p-prop-list      as character no-undo .
      716      define output parameter p-prop-type-list as character no-undo .
      717      define output parameter p-prop-label-list as character no-undo .
      718      define output parameter p-global          as logical no-undo .
      719      define output parameter p-host           as logical no-undo .
      720      define output parameter p-shop           as logical no-undo .
      721      define output parameter p-store          as logical no-undo .
      722      define output parameter p-db             as logical no-undo .
      723      define variable p-region as logical no-undo.
      724      run thbjattr_code_reg in this-procedure (
      725                                               p-upper-code,
      726                                               p-code,
      727                                               output p-label,
      728                                               output p-user-can-edit,
      729                                               output p-output-display,
      730                                               output p-other,
      731                                               output p-prop-list,
      732                                               output p-prop-type-list,
      733                                               output p-prop-label-list,
      734                                               output p-global,
      735                                               output p-host,
      736                                               output p-shop,
      737                                               output p-store,
      738                                               output p-db,
      739                                               output p-region
      740                                               ).
      741   end procedure.
      742   procedure thbjattr_code_reg :
      743   define input  parameter p-upper-code     as character no-undo .
      744   define input  parameter p-code           as character no-undo .
      745   define output parameter p-label          as character no-undo .
      746   define output parameter p-user-can-edit  as logical   no-undo .
      747   define output parameter p-output-display as logical   no-undo .
      748   define output parameter p-other          as character no-undo .
      749   define output parameter p-prop-list      as character no-undo .
      750   define output parameter p-prop-type-list as character no-undo .
      751   define output parameter p-prop-label-list as character no-undo .
      752   define output parameter p-global          as logical no-undo .
      753   define output parameter p-host           as logical no-undo .
      754   define output parameter p-shop           as logical no-undo .
      755   define output parameter p-store          as logical no-undo .
      756   define output parameter p-db             as logical no-undo .
      757   define output parameter p-region         as logical no-undo .
      758   do
      759   on error undo, return error return-value
      760   :
      761       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      762       (input  p-upper-code
      763       ,input  p-code
      764       ,output p-label
      765       ,output p-user-can-edit
      766       ,output p-output-display
      767       ,output p-other
      768       ,output p-prop-list
      769       ,output p-prop-type-list
      770       ,output p-prop-label-list
      771       ,output p-global
      772       ,output p-host
      773       ,output p-shop
      774       ,output p-store
      775       ,output p-db
      776       ,output p-region
      777       ) no-error .
      778     if error-status :error
      779     then do:
      780       undo, return error substitute( "&1. &2&3&4", vss-include-info5, return-value, chr(10), error-status :get-message (1)).
      781     end.
      782   end.
      783   end procedure.
      784   procedure thbjattr_tooltip :
      785   define input  parameter p-upper-code  as character no-undo .
