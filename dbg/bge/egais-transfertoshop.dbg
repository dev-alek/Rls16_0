     2430                                       and buf_parts.prod-type = buf_goods.prod-type
     2431                                       and buf_parts.prod-code = buf_goods.prod-code
     2432                                       and buf_parts.obj-type = v-cntxt-obj-type
     2433                                       and buf_parts.obj-code = v-cntxt-obj-code
     2434                                       and buf_parts.out-code = 'free-zone':U :
