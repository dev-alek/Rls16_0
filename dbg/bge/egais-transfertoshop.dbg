     2390                   assign
     2391                       tt-exts.ext-rec = recid(x_ext-classif)
     2392                       tt-exts.gds-code = buf_goods.gds-code
     2393                   .
     2394               end.
     2395               exts = exts + 1 .
     2396           end.
     2397           if exts = 0 then do :
     2398               put stream str-log unformatted
     2399                   string(today) + "   " + string(time, "hh:mm:ss") + " :  товар " + string(buf_goods.gds-code) + "  " + buf_goods.gds-name + "  не синхронизирован с ЕГАИС" skip.
     2400               err-good = true .
     2401               next _goods_ .
     2402           end.
     2403           else do :
     2404               find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2405                                                  and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2406                                                  AND X_ext-classif.db-num = 0
     2407                                                  and X_ext-classif.key#_one = buf_goods.gds-code
     2408                                                  and X_ext-classif.key#_two = v-ext-sys
     2409                                                  and X_ext-classif.key#_three = 0
     2410                                                  and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2411                                                  and X_eXt-classif.charkey_two = ""
     2412                                                  and X_eXt-classif.charkey_three = ""
     2413                                                  and X_eXt-classif.nonunique = 0
     2414                                                  .
     2415           end.
     2416           find first buf_parts no-lock where buf_parts.artic = buf_goods.artic
     2417                                       and buf_parts.prod-type = buf_goods.prod-type
     2418                                       and buf_parts.prod-code = buf_goods.prod-code
     2419                                       and buf_parts.obj-type = v-cntxt-obj-type
     2420                                       and buf_parts.obj-code = v-cntxt-obj-code
