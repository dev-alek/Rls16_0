     2518                                          and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2519                                          AND X_ext-classif.db-num = 0
     2520                                          and X_ext-classif.key#_one = buf_goods.gds-code
     2521                                          and X_ext-classif.key#_two = v-ext-sys
     2522                                          and X_ext-classif.key#_three = 0
     2523                                          and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2524                                          and X_eXt-classif.charkey_two = ""
     2525                                          and X_eXt-classif.charkey_three = ""
     2526                                          and X_eXt-classif.nonunique = 0 :
