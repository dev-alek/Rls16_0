     2324                if num-entries(buf_parts.alc-ref-ab-path) = 4 and entry(2, buf_parts.alc-ref-ab-path) <> "" then do :
     2325                    tt-gds-act.inform-B = trim(entry(2, buf_parts.alc-ref-ab-path)) .
     2326                end.
