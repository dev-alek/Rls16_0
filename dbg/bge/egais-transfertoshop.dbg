     2544                                              and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2545                                              AND X_ext-classif.db-num = 0
     2546                                              and X_ext-classif.key#_one = buf_goods.gds-code
     2547                                              and X_ext-classif.key#_two = v-ext-sys
     2548                                              and X_ext-classif.key#_three = 0
     2549                                              and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2550                                              and X_eXt-classif.charkey_two = ""
     2551                                              and X_eXt-classif.charkey_three = ""
     2552                                              and X_eXt-classif.nonunique = 0
     2553                                              .
