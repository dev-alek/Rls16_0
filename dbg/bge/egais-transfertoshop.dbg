     2424                   string(today) + "   " + string(time, "hh:mm:ss") + " :  у товара " + string(buf_goods.gds-code) + "  " + buf_goods.gds-name + "  нет партий свободной зоны" skip.
     2425               err-good = true .
     2426               next _goods_ .
     2427           end.
     2428           _parts_ :
