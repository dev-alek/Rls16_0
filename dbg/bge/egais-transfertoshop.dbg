     1574   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1575   define new global shared variable g#trdcalib as handle no-undo.
     1576   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1577   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1578   define variable v-waitfram-action01         as character   no-undo .
     1579   define variable v-waitfram-action02         as character   no-undo .
     1580   define variable v-waitfram-action03         as character   no-undo .
     1581   define variable mWaitFramTextBeg            as character   no-undo.
     1582   define variable mWaitFramTextEnd            as character   no-undo.
     1583   define variable mWaitFramView               as logical     no-undo.
     1584   define variable mWaitProcEvent              as logical     no-undo init yes.
     1585   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1586   define variable mWaitFramStop               as logical     no-undo.
     1587   define variable mWaitFramStopUser           as logical     no-undo.
     1588   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1589   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1590   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1591   define button B-WaitFramStop auto-end-key
     1592        label "Стоп"
     1593        size 10 by 1 tooltip "Остоновить процесс".
     1594   define button B-viewProcInfo
     1595        label "Информация"
     1596        size 15 by 1 tooltip "Информация о процесс".
     1597   define frame waitfram
     1598     v-waitfram-action01 format "x(72)" no-label skip
     1599     v-waitfram-action02 format "x(72)" no-label skip
     1600     v-waitfram-action03 format "x(72)" no-label skip
     1601     B-viewProcInfo
     1602     B-WaitFramStop at row 4 col 30
     1603     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1604     .
     1605   define new global shared variable mBatchMode as logical no-undo init ?.
     1606   define variable mFramBachModHandle as handle no-undo.
     1607   mFramBachModHandle = frame waitfram:handle.
     1608   define variable mFameOldVis as logical no-undo.
     1609   define variable mVisCUrentVin as logical no-undo.
     1610   if session:batch-mode
     1611   then
     1612      mBatchMode = yes.
     1613   if mBatchMode = ? then do:
     1614     mVisCUrentVin = current-window:visible.
     1615     mFameOldVis = mFramBachModHandle:visible.
     1616     mFramBachModHandle:visible  = yes.
     1617     mBatchMode = mFramBachModHandle:visible ne yes.
     1618     mFramBachModHandle:visible = mFameOldVis.
     1619     current-window:visible = mVisCUrentVin.
     1620   end.
     1621    if  log-manager:logfile-name ne ?
     1622     then DO:
     1623         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1624         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1625         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1626     end.
     1627   on choose of B-WaitFramStop in frame waitfram
     1628   do:
     1629     mWaitFramStop = yes.
     1630     mWaitFramStopUser = yes.
     1631   end.
     1632   function waitfram-check-timeout returns logical():
     1633      define variable vtime as int64 no-undo.
     1634      if mWaitFramStopTimeOut
     1635      then
     1636         return yes.
     1637      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1638      if     mWaitFramTimeOut ne ?
     1639         and mWaitFramTimeOut ne 0
     1640         and mWaitFramTimeOut lt vtime
     1641      then do:
     1642         mWaitFramStopTimeOut = yes.
     1643      end.
     1644      return mWaitFramStopTimeOut.
     1645   end.
     1646   procedure waitfram-hide :
     1647     if not session:batch-mode
     1648     then do
     1649     on error undo, return error return-value
     1650     :
     1651       pause 0 before-hide .
     1652       if not mBatchMode then
     1653         hide frame waitfram .
     1654     if     not mWaitFramView
     1655        and mWaitProcEvent
     1656     then
     1657       process events .
     1658     end.
     1659   end procedure.
     1660   procedure waitfram-show :
     1661     define input  parameter p-message as character no-undo .
     1662     define variable v-left-margin as integer   no-undo .
     1663     if not session:batch-mode
     1664     then do
     1665     on error undo, return error return-value
     1666     :
     1667       if length(p-message) <= 70 then do:
     1668         assign
     1669           v-left-margin = integer((70 - length(p-message)) / 2)
     1670         .
     1671         assign
     1672           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1673         .
     1674         assign
     1675           v-waitfram-action01 = " "
     1676           v-waitfram-action02 = " "
     1677                                    + fill(" ", v-left-margin)
     1678                                    + p-message
     1679           v-waitfram-action03 = " "
     1680         .
     1681       end.
     1682       else do:
     1683         define variable vRindex1 as integer no-undo.
     1684         define variable vRindex2 as integer no-undo.
     1685         vRindex1 = r-index(p-message," ",70).
     1686         if vRindex1 = 0
     1687         then
     1688            vRindex1 = 70.
     1689         if length(p-message)  <= vRindex1 + 70 then do:
     1690           assign
     1691             v-waitfram-action01 = " "
     1692             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1693             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1694           .
     1695         end.
     1696         else do:
     1697           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1698           if vRindex2 <= vRindex1
     1699           then
     1700              vRindex2 = vRindex1 + 70.
     1701           assign
     1702             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1703             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1704             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1705           .
     1706         end.
     1707       end.
     1708       B-viewProcInfo:visible   in frame waitfram = no.
     1709       B-viewProcInfo:sensitive in frame waitfram = no.
     1710       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1711       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1712       if  (   mWaitFramView
     1713          or  mWaitProcEvent)
     1714          and not mBatchMode
     1715       then
     1716          display
     1717             v-waitfram-action01 skip
     1718             v-waitfram-action02 skip
     1719             v-waitfram-action03 skip
     1720          with frame waitfram .
     1721       if     mWaitFramView
     1722          then do:
     1723             if     mWaitFramInterval ne ?
     1724                and not mBatchMode
     1725             then
     1726                wait-for go of frame waitfram pause mWaitFramInterval.
     1727          end.
     1728          else
     1729             if     mWaitProcEvent
     1730                and not mBatchMode
     1731             then
     1732                process events .
     1733     end.
     1734   end procedure.
     1735      procedure waitfram-show-this:
     1736         define input  parameter iInterval as int64 no-undo.
     1737         define variable vtime as int64 no-undo.
     1738         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1739         mWaitFramInterval = iInterval.
     1740         run waitfram-show (substitute("&1&2 &3&4" ,
     1741                                       mWaitFramTextBeg ,
     1742                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1743                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1744                                       mWaitFramTextEnd
     1745                                      )
     1746                           ).
     1747      end.
     1748      procedure WaitFramRunPause:
     1749         define input  parameter iInterval as dec no-undo.
     1750         define variable vStart  as datetime-tz no-undo.
     1751         define variable vend    as datetime-tz no-undo.
     1752         define variable vint as int64 no-undo.
     1753         define variable vOk as logical no-undo.
     1754         vStart = now.
     1755         vend   = vStart.
     1756         publish "WaitFramPause" (iInterval,output vOk).
     1757         vend   =  now.
     1758         vint = vend - vStart.
     1759         vint = iInterval - vint / 1000.
     1760         if     not mWaitFramStop
     1761            and (   vint > 0
     1762                 or (    not vOk
     1763                     and iInterval eq ?
     1764                     )
     1765                 )
     1766         then
     1767            run waitfram-show-this (iInterval).
     1768         vend   =  now.
     1769         vint = vend - vStart.
     1770         vint = iInterval - vint / 1000.
     1771         if     not mWaitFramStop
     1772            and vint > 0
     1773         then do:
     1774            run gbl/pause.p (vint * 1000).
     1775         end.
     1776         if iInterval ne ?
     1777         then
     1778            publish "WaitFramStop".
     1779         waitfram-check-timeout().
     1780      end.
     1781      procedure WaitFramWaitFor:
     1782         define input  parameter iInterval as dec no-undo.
     1783         assign
     1784            mWaitFramStartProc   = now
     1785            mWaitFramStopUser    = no
     1786            mWaitFramStopTimeOut = no
     1787         .
     1788         block-wait:
     1789         do while not mWaitFramStop:
     1790            run WaitFramRunPause (iInterval).
     1791            if  waitfram-check-timeout()
     1792            then do:
     1793               leave block-wait.
     1794            end.
     1795         end.
     1796         run waitfram-hide.
     1797      end.
     1798   procedure waitfram-join :
     1799     define input  parameter p-line-1  as character no-undo .
     1800     define input  parameter p-line-2  as character no-undo .
     1801     define input  parameter p-line-3  as character no-undo .
     1802     define output parameter p-message as character no-undo .
     1803     do
     1804     on error undo, return error return-value
     1805     :
     1806       assign
     1807         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1808                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1809                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1810       .
     1811     end.
     1812   end procedure.
     1813   function waitfram-join-function returns character
     1814     (input p-line-1 as character
     1815     ,input p-line-2 as character
     1816     ,input p-line-3 as character
     1817     ).
     1818     define variable v-message as character no-undo .
     1819     run waitfram-join in this-procedure
     1820       (input  p-line-1
     1821       ,input  p-line-2
     1822       ,input  p-line-3
     1823       ,output v-message
     1824       ) .
     1825     return v-message .
     1826   end function .
     1827   define temp-table tt-act-header
     1828       field num           as character        label "№ акта"      format "X(30)"
     1829       field date_         as date             label "Дата акта"
     1830       field is-sent       as logical
     1831       field answer_       as character        label "Ответ"       format "X(1500)"
     1832       field RegID         as character        label "Рег. номер"  format "X(50)"
     1833       index pi as primary unique
     1834           num
     1835   .
     1836   define temp-table tt-gds-act
     1837       field num           as character                label "№ акта"
     1838       field position_     as integer                  label "№ пп"                    format ">>>9"
     1839       field gds-code      like ub.goods.gds-code      label "Код товара   "
     1840       field alc-code      as character                label "Алкогольный код"         format "X(21)"
     1841       field gds-name      like ub.goods.gds-name      label "Наименование товара"     format "X(35)"
     1842       field qnty          as decimal                  label "Количество"
     1843       field inform-B      as character                label "Справка Б"               format "X(20)"
     1844       index pi as primary unique
     1845           position_
     1846       index code
     1847           gds-code
     1848   .
     1849   define variable sw as handle no-undo .
     1850   define variable v-file              as character no-undo initial "TransferToShop1.xml".
     1851   DEFINE VARIABLE hDoc AS HANDLE NO-UNDO.
     1852   DEFINE VARIABLE hRoot AS HANDLE NO-UNDO.
     1853   DEFINE VARIABLE good AS LOGICAL NO-UNDO.
     1854   procedure makeXML :
     1855       create sax-writer sw .
     1856       sw:formatted = true.
     1857       sw:set-output-destination ("file", v-file).
     1858       sw:encoding = "UTF-8".
     1859       sw:start-document () .
     1860       sw:start-element ("ns:Documents") .
     1861       sw:insert-attribute ("Version", "1.0") .
     1862       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
     1863       sw:insert-attribute ("xmlns:xs", "http://www.w3.org/2001/XMLSchema") .
     1864       sw:insert-attribute ("xmlns:c", "http://fsrar.ru/WEGAIS/Common") .
     1865       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef_v2") .
     1866       sw:insert-attribute ("xmlns:tts", "http://fsrar.ru/WEGAIS/TransferToShop") .
     1867           sw:start-element ("ns:Owner") .
     1868               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
     1869           sw:end-element ("ns:Owner") .
     1870           sw:start-element ("ns:Document") .
     1871               sw:start-element ("ns:TransferToShop") .
     1872                   sw:write-data-element ("tts:Identity", tt-act-header.num) no-error .
     1873                   sw:start-element ("tts:Header") .
     1874                       sw:write-data-element ("tts:TransferNumber", tt-act-header.num) no-error .
     1875                       sw:write-data-element ("tts:TransferDate", string(iso-date(tt-act-header.date_))) no-error .
     1876                   sw:end-element ("tts:Header") .
     1877                   sw:start-element ("tts:Content") .
     1878       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
     1879                       sw:start-element ("tts:Position") .
     1880                           sw:write-data-element ("tts:Identity", string(tt-gds-act.position_)) no-error .
     1881                           sw:write-data-element ("tts:Quantity", string(tt-gds-act.qnty)) no-error .
     1882                           sw:write-data-element ("gds-code", string(tt-gds-act.gds-code)) no-error .
     1883                           sw:write-data-element ("gds-name", tt-gds-act.gds-name) no-error .
     1884                           sw:write-data-element ("alc-code", tt-gds-act.alc-code) no-error .
     1885                           sw:start-element ("tts:InformB") .
     1886                               sw:write-data-element ("pref:BRegId", tt-gds-act.inform-B) no-error .
     1887                           sw:end-element ("tts:InformB") .
     1888                       sw:end-element ("tts:Position") .
     1889       end.
     1890                   sw:end-element ("tts:Content") .
     1891               sw:end-element ("ns:TransferToShop") .
     1892           sw:end-element ("ns:Document") .
     1893       sw:end-element ("ns:Documents") .
     1894       sw:end-document () .
     1895       delete object sw.
     1896   end procedure .
     1897   procedure makeXMLegais_v2 :
     1898       create sax-writer sw .
     1899       sw:formatted = true.
     1900       sw:set-output-destination ("file", v-file).
     1901       sw:encoding = "UTF-8".
     1902       sw:start-document () .
     1903       sw:start-element ("ns:Documents") .
     1904       sw:insert-attribute ("Version", "1.0") .
     1905       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
     1906       sw:insert-attribute ("xmlns:xs", "http://www.w3.org/2001/XMLSchema") .
     1907       sw:insert-attribute ("xmlns:c", "http://fsrar.ru/WEGAIS/Common") .
     1908       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef_v2") .
     1909       sw:insert-attribute ("xmlns:tts", "http://fsrar.ru/WEGAIS/TransferToShop") .
     1910           sw:start-element ("ns:Owner") .
     1911               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
     1912           sw:end-element ("ns:Owner") .
     1913           sw:start-element ("ns:Document") .
     1914               sw:start-element ("ns:TransferToShop") .
     1915                   sw:write-data-element ("tts:Identity", tt-act-header.num) .
     1916                   sw:start-element ("tts:Header") .
     1917                       sw:write-data-element ("tts:TransferNumber", tt-act-header.num) .
     1918                       sw:write-data-element ("tts:TransferDate", string(iso-date(tt-act-header.date_))) no-error .
     1919                   sw:end-element ("tts:Header") .
     1920                   sw:start-element ("tts:Content") .
     1921       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
     1922           if tt-gds-act.qnty <= 0 or trim(tt-gds-act.inform-B) = "" or tt-gds-act.inform-B = ? then next.
     1923                       sw:start-element ("tts:Position") .
     1924                           sw:write-data-element ("tts:Identity", string(tt-gds-act.position_)) .
     1925                           sw:write-data-element ("tts:ProductCode", tt-gds-act.alc-code) no-error .
     1926                           sw:write-data-element ("tts:Quantity", string(tt-gds-act.qnty)) .
     1927                           sw:start-element ("tts:InformF2") .
     1928                             sw:write-data-element ("pref:F2RegId", tt-gds-act.inform-B) .
     1929                           sw:end-element ("tts:InformF2") .
     1930                       sw:end-element ("tts:Position") .
     1931       end.
     1932                   sw:end-element ("tts:Content") .
     1933               sw:end-element ("ns:TransferToShop") .
     1934           sw:end-element ("ns:Document") .
     1935       sw:end-element ("ns:Documents") .
     1936       sw:end-document () .
     1937       delete object sw.
     1938   end procedure .
     1939   procedure parseXML :
     1940       define input parameter inFile as character no-undo .
     1941       empty temp-table tt-act-header .
     1942       empty temp-table tt-gds-act .
     1943       CREATE X-DOCUMENT hDoc.
     1944       CREATE X-NODEREF hRoot.
     1945       hDoc:encoding = 'utf-8'.
     1946       hDoc:LOAD("file", search(inFile),FALSE).
     1947       hDoc:GET-DOCUMENT-ELEMENT(hRoot).
     1948       RUN GetChildren(hRoot, 1).
     1949       DELETE OBJECT hDoc.
     1950       DELETE OBJECT hRoot.
     1951   end procedure .
     1952   procedure GetChildren :
     1953       DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
     1954       DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
     1955       DEFINE VARIABLE i AS INTEGER NO-UNDO.
     1956       DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
     1957       DEFINE VARIABLE hText AS HANDLE NO-UNDO.
     1958       CREATE X-NODEREF hNoderef.
     1959       CREATE X-NODEREF hText .
     1960       REPEAT i = 1 TO hParent:NUM-CHILDREN:
     1961           good = hParent:GET-CHILD(hNoderef,i).
     1962           IF NOT good THEN
     1963               LEAVE.
     1964           IF hNoderef:SUBTYPE <> "element" THEN
     1965               NEXT.
     1966           hNoderef:GET-CHILD(hText, 1) no-error .
     1967           IF hNoderef:NAME = "tts:Header" THEN do :
     1968               create tt-act-header .
     1969               assign tt-act-header.is-sent = bh-act-header:buffer-field("is-sent"):buffer-value no-error.
     1970           end .
     1971           .
     1972           IF hNoderef:NAME = "tts:TransferNumber" THEN assign tt-act-header.num    = hText:node-value no-error .
     1973           IF hNoderef:NAME = "tts:TransferDate" THEN
     1974               assign tt-act-header.date_ = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
     1975           IF hNoderef:NAME = "tts:Position" THEN do :
     1976               assign ii = 0 .
     1977               create tt-gds-act .
     1978               assign tt-gds-act.num = tt-act-header.num .
     1979           end.
     1980           IF hNoderef:NAME = "tts:Identity" THEN assign tt-gds-act.position_ = integer(hText:node-value) no-error .
     1981           IF hNoderef:NAME = "tts:Quantity" THEN assign tt-gds-act.qnty = decimal(hText:node-value) no-error .
     1982           IF hNoderef:NAME = "pref:BRegId"
     1983           OR hNoderef:NAME = "pref:F2RegId" THEN assign tt-gds-act.inform-B = (hText:node-value) no-error .
     1984           IF hNoderef:NAME = "gds-code"     THEN do :
     1985               assign tt-gds-act.gds-code = integer(hText:node-value) no-error .
     1986               find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code no-error .
     1987               if available buf_goods then assign tt-gds-act.gds-name = buf_goods.gds-name .
     1988           end.
     1989           if hNoderef:NAME = "gds-name" and trim(tt-gds-act.gds-name) = "" then assign tt-gds-act.gds-name = (hText:node-value) no-error .
     1990           IF hNoderef:NAME = "alc-code"
     1991           OR hNoderef:NAME = "tts:ProductCode"    THEN assign tt-gds-act.alc-code = (hText:node-value) no-error .
     1992           run GetChildren (hNoderef, (level + 1)).
     1993       END.
     1994       DELETE OBJECT hNoderef.
     1995       DELETE OBJECT hText.
     1996   END procedure.
     1997   define new shared temp-table tt-exts
     1998       field ext-rec as recid
     1999       field gds-code as integer
     2000       index pi as primary unique
     2001           ext-rec gds-code
     2002   .
     2003   define variable select-list as longchar no-undo .
     2004   FUNCTION get-mark RETURNS CHARACTER
     2005   (buffer local-gds for tt-gds-act ):
     2006   if lookup (string (recid (local-gds)), select-list) > 0  then return "*".
     2007                                                              else return "".
     2008   end function.
     2009   define menu m-add
     2010       menu-item m-goods   label "по складскому документу"
     2011       menu-item m-free    label "товары по свободной зоне"
     2012       menu-item m-one-good label "один товар"
     2013   .
     2014   DEFINE BUTTON b-cancel AUTO-END-KEY
     2015        LABEL "Выход"
     2016        SIZE 15 BY 1.14
     2017        BGCOLOR 8 .
     2018   DEFINE BUTTON b-good
     2019        LABEL "Добавить"
     2020        SIZE 15 BY 1.14
     2021        BGCOLOR 8 .
     2022   DEFINE BUTTON b-alc-code
     2023        LABEL "Выбор алк. кода"
     2024        SIZE 20 BY 1.14 TOOLTIP "Выбрать алкогольный код"
     2025        BGCOLOR 8 .
     2026   DEFINE BUTTON b-del
     2027        LABEL "Удалить строку"
     2028        SIZE 15 BY 1.14 TOOLTIP "Удалить строку акта"
     2029        BGCOLOR 8 .
     2030   DEFINE BUTTON b-save
     2031        LABEL "Сохранить"
     2032        SIZE 15 BY 1.14 TOOLTIP "Сохранить в БД"
     2033        BGCOLOR 8 .
     2034   DEFINE BUTTON b-mark
     2035        LABEL "&*"
     2036        SIZE 3 BY 1.14 .
     2037   DEFINE BUTTON b-sel-all
     2038        LABEL "&+":L
     2039        SIZE 3 BY 1.14 TOOLTIP "Отметить все объекты".
     2040   DEFINE BUTTON b-unmark
     2041        LABEL "&-":L
     2042        SIZE 3 BY 1.14 TOOLTIP "Снять все отметки".
     2043   DEFINE QUERY br-gds-act FOR
     2044         tt-gds-act SCROLLING.
     2045   DEFINE BROWSE br-gds-act
     2046     QUERY br-gds-act  DISPLAY
     2047       get-mark(BUFFER tt-gds-act) COLUMN-LABEL "*"  FORMAT "X(1)":U
     2048       tt-gds-act.position_
     2049       tt-gds-act.gds-code
     2050       tt-gds-act.alc-code
     2051       tt-gds-act.gds-name
     2052       tt-gds-act.qnty
     2053       tt-gds-act.inform-B
     2054     ENABLE
     2055       tt-gds-act.qnty
     2056       tt-gds-act.inform-B
     2057       WITH NO-ROW-MARKERS SEPARATORS SIZE 107 BY 20.2 FIT-LAST-COLUMN.
     2058   DEFINE FRAME Dialog-Frame
     2059       b-cancel at row 1.2 col 2
     2060       b-good at row 1.2 col 32
     2061       b-del at row 1.2 col 47
     2062       b-save at row 1.2 col 17
     2063       b-alc-code at row 1.2 col 62
     2064       tt-act-header.num at row 2.5 col 2 format "X(30)"
     2065       tt-act-header.date_ at row 2.5 col 42
     2066       b-mark AT ROW 4 COL 2
     2067       b-sel-all AT ROW 4 COL 5
     2068       b-unmark AT ROW 4 COL 8
     2069       br-gds-act at row 5.2 col 2
     2070        SPACE(0.5) SKIP(0.5)
     2071       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2072            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2073            TITLE "Акт о передаче продукции в торговый зал" WIDGET-ID 100.
     2074   ASSIGN
     2075          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2076          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2077   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2078   DO:
     2079     APPLY "END-ERROR":U TO SELF.
     2080   END.
     2081   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     2082   DO:
     2083     run proc-b-mark in this-procedure no-error.
     2084   END.
     2085   ON CHOOSE OF b-sel-all IN FRAME Dialog-Frame
     2086   DO:
     2087     assign select-list = "".
     2088     if not available tt-gds-act then return.
     2089     for each tt-gds-act no-lock :
     2090   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2091   define variable v-str-recid12 as character no-undo .
     2092   define variable v-num-entry12 as integer   no-undo .
     2093   assign
     2094     v-str-recid12 = trim( string( recid( tt-gds-act ) , "->>>>>>>>>>>9":U ) )
     2095     v-num-entry12 = lookup( v-str-recid12 , select-list )
     2096   .
     2097   if v-num-entry12 > 0 then do:
     2098     assign
     2099       entry( v-num-entry12, select-list ) = "":U
     2100       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2101     .
     2102   end.
     2103   else do:
     2104     assign
     2105       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid12
     2106     .
     2107   end.
     2108     end.
     2109     br-gds-act:refresh() in frame Dialog-Frame .
     2110   END.
     2111   ON CHOOSE OF b-unmark IN FRAME Dialog-Frame
     2112   DO:
     2113     if not available tt-gds-act then return.
     2114     select-list  = "".
     2115     br-gds-act:refresh() in frame Dialog-Frame .
     2116   END.
     2117   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     2118   DO:
     2119       if p-mode <> 'ПРОСМОТР':U then do :
     2120           message "Все несохранённые данные будут потеряны. Вы уверены, что хотите выйти?"
     2121           view-as alert-box question buttons yes-no update glog.
     2122           if not glog then return no-apply .
     2123       end.
     2124   END.
     2125   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     2126   DO:
     2127       define variable v-tt-rec as recid.
     2128       if available tt-gds-act  AND select-list = ""
     2129       then
     2130       select-list = string( recid( tt-gds-act ) ) .
     2131       if not available tt-gds-act and select-list = "" then do :
     2132           message "Выберите строку" view-as alert-box .
     2133           return no-apply.
     2134       end.
     2135       else
     2136       do ii = 1 to num-entries (select-list) :
     2137         v-tt-rec = integer(entry(ii, select-list)) .
     2138         for first tt-gds-act exclusive-lock where recid(tt-gds-act) = v-tt-rec :
     2139           delete tt-gds-act .
     2140         end.
     2141       end.
     2142       nn = 0 .
     2143       for each tt-gds-act exclusive-lock :
     2144           nn = nn + 1 .
     2145           tt-gds-act.position_ = nn .
     2146       end.
     2147       select-list = "" .
     2148       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2149   END.
     2150   ON "leave" of tt-act-header.num in FRAME Dialog-Frame
     2151   DO:
     2152       define variable prev-num as character no-undo .
     2153       prev-num = tt-act-header.num .
     2154       assign tt-act-header.num .
     2155       for each tt-gds-act exclusive-lock where tt-gds-act.num = prev-num :
     2156           assign tt-gds-act.num = tt-act-header.num .
     2157       end.
     2158   END.
     2159   on choose of b-alc-code IN FRAME Dialog-Frame
     2160   do :
     2161       if not available tt-gds-act then return no-apply .
     2162       run bge/egais-select-alc-code.w (input tt-gds-act.gds-code, output p-ext-rec) .
     2163       find first X_ext-classif no-lock where recid(X_ext-classif) = p-ext-rec no-error .
     2164       if not available X_ext-classif then return no-apply.
     2165       assign tt-gds-act.alc-code = X_ext-classif.charkey_one .
     2166       br-gds-act:refresh() .
     2167   end.
     2168   on row-display of br-gds-act in FRAME Dialog-Frame
     2169   DO :
     2170       exts = 0 .
     2171       for each tt-exts no-lock where tt-exts.gds-code = tt-gds-act.gds-code :
     2172           exts = exts + 1 .
     2173       end.
     2174       if exts > 1 then tt-gds-act.alc-code:bgcolor in browse br-gds-act = yellow_color .
     2175   end.
     2176   on value-changed of br-gds-act IN FRAME Dialog-Frame
     2177   DO :
     2178   if available tt-gds-act then do :
     2179       exts = 0 .
     2180       for each tt-exts no-lock where tt-exts.gds-code = tt-gds-act.gds-code :
     2181           exts = exts + 1 .
     2182       end.
     2183       if exts > 1 then enable b-alc-code WITH FRAME Dialog-Frame.
     2184       else disable b-alc-code WITH FRAME Dialog-Frame.
     2185   end.
     2186   end.
     2187   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     2188   DO:
     2189       assign
     2190           tt-act-header.num
     2191           tt-act-header.date_
     2192       .
     2193       find first tt-gds-act no-error .
     2194       if not available tt-gds-act then do :
     2195           message "В акте нет строк. Сохранение невозможно" view-as alert-box .
     2196           return no-apply.
     2197       end.
     2198       if can-find(tt-gds-act where tt-gds-act.qnty < 1)
     2199       or can-find(tt-gds-act where trim(tt-gds-act.inform-B) = "")
     2200       then do :
     2201           message "Строки, в которых не указана справка Б, и строки, в которых количество меньше 1, не будут учтены при отправке в ЕГАИС!" skip "Продолжить?"
     2202           view-as alert-box question buttons yes-no update glog .
     2203           if not glog then return no-apply.
     2204       end.
     2205       run makeXML in this-procedure no-error.
     2206       if error-status:error then return return-value .
     2207       assign
     2208           v-clob-db-num = ?
     2209           v-int64-id = 0
     2210           v-info = tt-act-header.num + chr(4) + string(tt-act-header.date_) + chr(4) + string(tt-act-header.is-sent) + chr(4) + tt-act-header.answer_
     2211       .
     2212       find first buf_clob-bind exclusive-lock where buf_clob-bind.uniq-key-rec = tt-act-header.num
     2213                                                 and buf_clob-bind.field-name_  = 'egais-tts':U no-error .
     2214       if available buf_clob-bind then do :
     2215           if p-mode = 'ДОБАВЛЕНИЕ':U then do :
     2216               message "Акт с таким номером уже существует!" view-as alert-box .
     2217               return no-apply .
     2218           end.
     2219           assign
     2220               v-clob-db-num = buf_clob-bind.db-num
     2221               v-int64-id = buf_clob-bind.int64-id
     2222               v-part-num = buf_clob-bind.part-num
     2223           .
     2224           run gbl/file2clb.p ( input 'ИЗМЕНЕНИЕ':U
     2225                     ,input "add-new,yes"
     2226                     ,input ?
     2227                     ,input tt-act-header.num
     2228                     ,input 'egais-tts':U
     2229                     ,input v-info
     2230                     ,input-output v-part-num
     2231                     ,input 'egais-tts':U
     2232                     ,input-output v-clob-db-num
     2233                     ,input-output v-int64-id
     2234                     ,input search (v-file)
     2235                     ,input ''
     2236                     ) no-error .
     2237            if error-status:error then message return-value view-as alert-box.
     2238       end.
     2239       else do :
     2240           run gbl/file2clb.p ( input 'ДОБАВЛЕНИЕ':U
     2241                     ,input ",yes"
     2242                     ,input ?
     2243                     ,input tt-act-header.num
     2244                     ,input 'egais-tts':U
     2245                     ,input v-info
     2246                     ,input-output v-part-num
     2247                     ,input 'egais-tts':U
     2248                     ,input-output v-clob-db-num
     2249                     ,input-output v-int64-id
     2250                     ,input search (v-file)
     2251                     ,input ''
     2252                     ) no-error .
     2253       end.
     2254       message "Сохранение завершено" view-as alert-box.
     2255   END.
     2256   on choose of menu-item m-goods in menu m-add
     2257   DO:
     2258       run str/all-docs.w
     2259       ( input  parparentproc
     2260        ,input  v-cntxt-host-code-obj
