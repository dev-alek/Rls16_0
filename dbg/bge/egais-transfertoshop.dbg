     2309                                                       ,input (buffer buf_goods:handle)
     2310                                                       ,output v-gds-uniq-key-rec).
     2311                    find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2312                                                      and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2313                                                      AND X_ext-classif.db-num = 0
     2314                                                      and X_ext-classif.key#_one = buf_goods.gds-code
     2315                                                      and X_ext-classif.key#_two = v-ext-sys
     2316                                                      and X_ext-classif.key#_three = 0
     2317                                                      and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2318                                                      and X_eXt-classif.charkey_two = ""
     2319                                                      and X_eXt-classif.charkey_three = ""
     2320                                                      and X_eXt-classif.nonunique = 0
     2321                                                      no-error .
