     2438               assign
     2439                   tt-gds-act.num          = tt-act-header.num
     2440                   tt-gds-act.gds-code     = buf_goods.gds-code
     2441                   tt-gds-act.gds-name     = buf_goods.gds-name
     2442                   tt-gds-act.position_    = nn
     2443                   tt-gds-act.qnty         = buf_parts.fact-qnty / buf_parts.cli-base-rate
     2444               .
