     2361             'alcohol-prod':U,
     2362             output par-alcohol,
     2363             output par-type
     2364           ).
     2365           if par-alcohol = "" or par-alcohol = "no" then
     2366           do :
     2367               put stream str-log unformatted
     2368                   string(today) + "   " + string(time, "hh:mm:ss") + " :  товар " + string(buf_goods.gds-code) + "  " + buf_goods.gds-name + "  не является алкогольной продукцией" skip.
     2369               err-good = true .
     2370               next _goods_ .
     2371           end.
     2372           run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     2373                                               ,input (buffer buf_goods:handle)
     2374                                               ,output v-gds-uniq-key-rec).
     2375           exts = 0 .
     2376           for each X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2377                                          and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2378                                          AND X_ext-classif.db-num = 0
     2379                                          and X_ext-classif.key#_one = buf_goods.gds-code
     2380                                          and X_ext-classif.key#_two = v-ext-sys
     2381                                          and X_ext-classif.key#_three = 0
     2382                                          and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2383                                          and X_eXt-classif.charkey_two = ""
     2384                                          and X_eXt-classif.charkey_three = ""
     2385                                          and X_eXt-classif.nonunique = 0 :
     2386               find first tt-exts no-lock where tt-exts.ext-rec = recid(x_ext-classif)
     2387                                            and tt-exts.gds-code = buf_goods.gds-code no-error.
     2388               if not available tt-exts then do :
