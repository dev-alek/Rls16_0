        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: f0ffd58b8bac, 1562, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
        4   define variable vss-date        as character no-undo init "$Date: Tue Nov 06 04:41:34 2018 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: oxml-ini.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: bge/oxml-ini.p $":U .
        7   define variable vss-description as character no-undo init "Инициализация глобальных переменных системы OpenXML".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   PROCEDURE verify-ini-entry:
       68   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
       69   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
       70   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
       71   DEFINE INPUT  PARAMETER silence          as logical no-undo.
       72   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
       73   define variable v-mess as character no-undo .
       74   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
       75   if ini-entry-value = ? and ini-key-name begins "spl"
       76   then
       77   get-key-value section ini-section-name key "splall" value ini-entry-value.
       78   if ini-entry-value = ? and ini-key-name begins "sav"
       79   then
       80   get-key-value section ini-section-name key "savall" value ini-entry-value.
       81   if ini-entry-value = ? then do:
       82     assign
       83     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
       84                       , chr(10)
       85                       , ini-section-name
       86                       , ini-key-name
       87                       , error-msg-text).
       88       if not silence then do:
       89         message
       90         v-mess
       91         view-as alert-box ERROR  .
       92         return error.
       93       end.
       94       else do:
       95         return error v-mess.
       96       end.
       97   end.
       98   END PROCEDURE.
       99   PROCEDURE verify-file:
      100   DEFINE INPUT  PARAMETER filename       as character no-undo.
      101   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
      102   DEFINE INPUT  PARAMETER silence        as logical no-undo.
      103   DEFINE OUTPUT PARAMETER found          as logical no-undo.
      104   file-info:file-name = filename.
      105   found = NOT (file-info:full-pathname = ?).
      106   if NOT found  then do:
      107     if not silence then do:
      108       message error-msg-text
      109       view-as alert-box ERROR.
      110       return error.
      111     end.
      112     else return error error-msg-text.
      113   end.
      114   END PROCEDURE.
      115   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   define  shared variable g#auto-pid           as integer   no-undo .
      118   define  shared variable conn-par             as character no-undo .
      119   define  shared variable g#auto-user-id       as character no-undo .
      120   define  shared variable g#auto-user-login    as character no-undo .
      121   define  shared variable g#auto-user-password as character no-undo .
      122   define  shared variable v-socket             as logical   no-undo .
      123   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   define  shared variable auto-window-h     as handle    no-undo .
      125   define  shared variable auto-log-msg-h    as handle    no-undo .
      126   define  shared variable hand-log-msg-h    as handle    no-undo .
      127   define  shared variable log-file-name     as character no-undo initial ? .
      128   define  shared variable add-log-file-name as character no-undo initial ? .
      129   define  shared variable writelogvalue     as character no-undo initial ? .
      130   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   procedure cur-time :
      132      define output parameter p-today as date      no-undo .
      133      define output parameter p-time  as integer   no-undo .
      134     do
      135     on error undo, return error
      136     :
      137       define variable v-date1 as date      no-undo .
      138       define variable v-date2 as date      no-undo .
      139       define variable v-time  as integer   no-undo .
      140       assign
      141         v-date1 = today
      142         v-time  = time
      143         v-date2 = today
      144       .
      145       if v-date1 <> v-date2
      146       then do:
      147         assign
      148           v-date1 = today
      149           v-time  = v-time
      150         .
      151       end.
      152       assign
      153         p-today = v-date1
      154         p-time  = v-time
      155       .
      156     end.
      157   end.
      158   function cur-time-date returns character
      159   :
      160     return string(today, '99/99/9999':U) .
      161   end.
      162   function cur-time-mjd returns decimal
      163   :
      164     define variable v-date as date      no-undo .
      165     define variable v-time as integer   no-undo .
      166     run cur-time in this-procedure
      167       (output v-date
      168       ,output v-time
      169       ) .
      170     return integer(v-date) - 2400002 + (v-time / 86400) .
      171   end.
      172   function cur-time-get-ending-index returns integer
      173   (input p-number as integer
      174   )
      175   :
      176     if p-number < 0
      177     or p-number = ?
      178     then do:
      179       return 1 .
      180     end.
      181     define variable v-rest as integer   no-undo .
      182     assign
      183       p-number = p-number modulo 100
      184     .
      185     if p-number < 20
      186     then do:
      187       assign
      188         v-rest = p-number
      189       .
      190     end.
      191     else do:
      192       assign
      193         v-rest = p-number modulo 10
      194       .
      195     end.
      196     case v-rest :
      197       when 1
      198       then do:
      199         return 2 .
      200       end.
      201       when 2 or
      202       when 3 or
      203       when 4
      204       then do:
      205         return 3 .
      206       end.
      207       otherwise do:
      208         return 1 .
      209       end.
      210     end case .
      211   end.
      212   procedure cur-time-mjd-to-date :
      213      define input  parameter i-mjd-diff as decimal no-undo.
      214      define output parameter o-Date     as date    no-undo.
      215      define output parameter o-Time     as integer no-undo.
      216      define variable v-day-number as integer   no-undo .
      217      if    i-mjd-diff < 0
      218         or i-mjd-diff = ?
      219      then do:
      220         return "?" .
      221      end.
      222      assign
      223         v-day-number = truncate(i-mjd-diff,0).
      224         o-Date = date(v-day-number + 2400002).
      225         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      226     .
      227   end.
      228   function cur-time-mjd-to-string returns character
      229   (input p-mjd-diff as decimal
      230   )
      231   :
      232     define variable v-day-number as integer   no-undo .
      233     define variable v-seconds    as integer   no-undo .
      234     define variable v-hour       as integer   no-undo .
      235     define variable v-min        as integer   no-undo .
      236     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      237     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      238     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      239     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      240     if p-mjd-diff < 0
      241     or p-mjd-diff = ?
      242     then do:
      243       return "?" .
      244     end.
      245     assign
      246       v-day-number = integer(truncate(p-mjd-diff,0))
      247       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      248     .
      249     if v-seconds > 86400
      250     then do:
      251       assign
      252         v-seconds = 86400 - 1
      253       .
      254     end.
      255     if v-seconds < 0
      256     then do:
      257       assign
      258         v-seconds = 0
      259       .
      260     end.
      261     assign
      262       v-hour = truncate(v-seconds / 3600, 0)
      263     .
      264     assign
      265       v-seconds = v-seconds modulo 3600
      266     .
      267     assign
      268       v-min = truncate(v-seconds / 60, 0)
      269     .
      270     assign
      271       v-seconds = v-seconds modulo 60
      272     .
      273     return
      274         (if v-day-number <> 0
      275           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      276           else ""
      277         )
      278       + (if v-day-number <> 0 or v-hour <> 0
      279           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      280           else ""
      281         )
      282       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      283           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      284           else ""
      285         )
      286       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      287       .
      288   end.
      289   function cur-time-string returns character
      290   :
      291     define variable v-date as date      no-undo .
      292     define variable v-time as integer   no-undo .
      293     run cur-time in this-procedure
      294       (output v-date
      295       ,output v-time
      296       ) .
      297     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      298   end.
      299   function cur-time-string-sec returns character
      300   :
      301     define variable v-date as date      no-undo .
      302     define variable v-time as integer   no-undo .
      303     run cur-time in this-procedure
      304       (output v-date
      305       ,output v-time
      306       ) .
      307     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      308   end.
      309   function cur-time-custom  returns character
      310   (input p-prefix as character
      311   ,input p-date-format as character
      312   ,input p-delimiter as character
      313   ,input p-time-format as character
      314   ,input p-suffix as character
      315   )
      316   :
      317     define variable v-date as date      no-undo .
      318     define variable v-time as integer   no-undo .
      319     run cur-time in this-procedure
      320       (output v-date
      321       ,output v-time
      322       ) .
      323     return
      324       p-prefix
      325       + string(v-date, p-date-format)
      326       + p-delimiter
      327       + string(v-time, p-time-format)
      328       + p-suffix
      329       .
      330   end.
      331   function cur-time-print  returns character
      332   :
      333     define variable v-date as date      no-undo .
      334     define variable v-time as integer   no-undo .
      335     run cur-time in this-procedure
      336       (output v-date
      337       ,output v-time
      338       ) .
      339     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      340   end.
      341   function cur-time-datetime returns datetime
      342   :
      343     define variable v-char as character no-undo .
      344     define variable v-datetime as datetime no-undo .
      345     v-char = cur-time-string().
      346     v-datetime = datetime(v-char).
      347     return  v-datetime.
      348   end.
      349   function cur-time-string-msec returns character
      350   :
      351     define variable v-date as datetime  no-undo .
      352     v-date = now.
      353     return string(v-date) .
      354   end.
      355   define stream LogStream .
      356   define variable mNoTime as logical no-undo.
      357   procedure write-to-log-notime :
      358     define input param i-str as character no-undo .
      359     mNoTime = yes.
      360     run write-to-log (i-str).
      361     mNoTime = no.
      362   end.
      363   procedure write-to-log :
      364     define input param p-str as character no-undo .
      365     do
      366     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      367     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      368     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      369     :
      370       define variable log-res        as logical   no-undo .
      371       define variable v-jj           as integer   no-undo .
      372       if    mNoTime
      373          or writelogvalue eq "AsyncProc"
      374       then
      375          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      376       else
      377          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      378       if auto-log-msg-h <> ? then do:
      379         log-res = auto-log-msg-h:move-to-eof( ) .
      380         log-res = auto-log-msg-h:insert-string( p-str ).
      381       end.
      382       if hand-log-msg-h <> ? then do:
      383         log-res = hand-log-msg-h:move-to-eof( ) .
      384         log-res = hand-log-msg-h:insert-string( p-str ).
      385       end.
      386       assign
      387         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      388         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      389         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      390       .
      391       if add-log-file-name <> ? then do:
      392         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      393           run gbl/fileapnd.p
      394             ( input entry(v-jj, add-log-file-name, chr(1) )
      395             ,input p-str
      396             ,input 20
      397             ) no-error .
      398           if error-status:error then do:
      399             return error return-value .
      400           end.
      401         end.
      402       end.
      403       if writelogvalue eq "AsyncProc"
      404       then do:
      405          p-str = trim(p-str, (chr(13) + chr(10)) )
      406       .
      407          Publish "WriteLogAsunc" (p-str,yes).
      408       end.
      409       else if writelogvalue <> "yes" then do:
      410         run gbl/fileapnd.p
      411           ( input log-file-name
      412           ,input p-str
      413           ,input 20
      414           ) no-error .
      415         if error-status:error then do:
      416           return error return-value .
      417         end.
      418       end.
      419     end.
      420   end procedure.
      421   procedure write-to-screen :
      422     define input param p-str as character no-undo .
      423     do
      424     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      425     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      426     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      427     :
      428       define variable log-res as logical no-undo.
      429       assign
      430         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      431       .
      432       if auto-log-msg-h <> ?
      433       then do:
      434         log-res = auto-log-msg-h:move-to-eof( ) .
      435         log-res = auto-log-msg-h:insert-string( p-str ).
      436       end.
      437       if hand-log-msg-h <> ?
      438       then do:
      439         log-res = hand-log-msg-h:move-to-eof( ) .
      440         log-res = hand-log-msg-h:insert-string( p-str ).
      441       end.
      442     end.
      443   end procedure.
      444   procedure send-msg-to-email :
      445     define input  parameter p-subject      as character no-undo .
      446     define input  parameter p-text-err     as character no-undo .
      447     define input  parameter p-attach-files as character no-undo .
      448     do
      449     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      450     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      451     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      452     :
      453       define variable v-tth             as handle    no-undo .
      454       define variable v-value-character as character no-undo .
      455       define variable v-value-date      as date      no-undo .
      456       define variable v-value-decimal   as decimal   no-undo .
      457       define variable v-value-integer   as integer   no-undo .
      458       define variable v-value-logical   as logical   no-undo .
      459       define variable v-param-type      as character no-undo .
      460       define variable v-email       as character no-undo .
      461       define variable v-tmp-str     as character no-undo .
      462       define variable v-tmp1-str    as character no-undo .
      463       define variable v-ind         as integer   no-undo .
      464       define variable v-num-entries as integer   no-undo .
      465       delete object v-tth no-error.
      466       run adm/shattri.p
      467         ( input "get":U
      468          ,input  "":U
      469          ,input  0
      470          ,input  'auto-task':U
      471          ,input  'send-msg-to-email':U
      472          ,output v-value-character
      473          ,output v-value-date
      474          ,output v-value-decimal
      475          ,output v-value-integer
      476          ,output v-value-logical
      477          ,output v-param-type
      478          ,input-output table-handle v-tth
      479         ) no-error .
      480       if not error-status :error  then do:
      481         assign
      482           v-tmp-str = v-value-character
      483         .
      484       end.
      485       delete object v-tth no-error.
      486       assign
      487         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      488         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      489         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      490         v-num-entries = num-entries( v-tmp-str, chr(44) )
      491         v-email       = "":U
      492       .
      493       do v-ind = 1 to v-num-entries
      494       :
      495         assign
      496           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      497         .
      498         if trim( v-tmp1-str ) <> "":U then do:
      499           if v-email = "":U then do:
      500             assign
      501               v-email = v-tmp1-str
      502             .
      503           end.
      504           else do:
      505             assign
      506               v-email = v-email + chr(44) + v-tmp1-str
      507             .
      508           end.
      509         end.
      510       end.
      511       if v-email <> "":U then do:
      512         run gbl/sendmail.p
      513           ( input v-email
      514           , input p-subject
      515           , input p-text-err
      516           , input p-attach-files
      517           ) no-error .
      518         if error-status :error
      519           or return-value <> "":U
      520         then do:
      521           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      522         end.
      523       end.
      524     end.
      525   end procedure.
      526   define  shared variable oxml-exch-dir as character no-undo .
      527   define  shared variable oxml-heap-dir as character no-undo .
      528   define variable err-mess as character no-undo .
      529   define temp-table t-pck-conf no-undo
      530     field esys-id         as integer
      531     field db-num          as integer
      532     field current-db-num  as integer
      533     field pack-num        as integer
      534     field rcvd-recs       as integer
      535     field total-recs      as integer
      536     field sys-key         as character
      537     field src_db-key      as character
      538     field ver-num         as character
      539     field prev-crc        as character
      540     field actual-date     as date
      541     field actual-time-int as integer
      542   .
      543   do
      544   on error undo, return error
      545   :
      546     define variable v-str-err  as character no-undo .
      547     define variable v-set-prop as logical no-undo .
      548     assign
      549       v-str-err = "first":U
      550       v-set-prop = true
      551     .
      552     do while v-str-err <> "":U
      553              and v-set-prop = true
      554     :
      555       assign
      556         v-str-err = "":U
      557       .
      558       oxml-exch-dir = ibs.th.gbl.gbl-inipar:oxmlExchDir .
      559       oxml-heap-dir = ibs.th.gbl.gbl-inipar:oxmlDir .
      560       if oxml-exch-dir = ? then
      561         v-str-err = v-str-err + substitute( "Отсутствует настройка каталога OpenXML (oxml-exch-dir).&1", chr(10) ) .
      562       else if oxml-heap-dir = ? then
      563         v-str-err = v-str-err + substitute( "Отсутствует настройка каталога OpenXML (oxml-dir).&1", chr(10) ) .
      564       else if oxml-exch-dir = oxml-heap-dir then do:
      565         v-str-err = v-str-err +
      566         substitute("Каталог EXCH (&2)&1" +
      567                    "и каталог HEAP (&3)&1" +
      568                    "должны быть различными.&1"  +
      569                    "Совпадение каталогов EXCH и HEAP нарушит работу системы OXML!"
      570                    , chr(10)
      571                    , ibs.th.gbl.gbl-inipar:oxmlExchDirKeyName
      572                    , ibs.th.gbl.gbl-inipar:oxmlDirKeyName).
      573       end.
      574       else do:
      575         file-info:file-name = oxml-exch-dir .
      576         if file-info:file-type = ? or not ( file-info:file-type begins "D":U ) then assign
      577           v-str-err = v-str-err + substitute( "Каталог &1 отсутствует.&2", oxml-exch-dir, chr(10) )
      578         .
      579         else assign
      580           oxml-exch-dir = file-info:full-pathname
      581         .
      582         file-info:file-name = oxml-heap-dir .
      583         if file-info:file-type = ? or not ( file-info:file-type begins "D":U ) then assign
      584           v-str-err = v-str-err + substitute( "Каталог &1 отсутствует.&2", oxml-heap-dir, chr(10) )
      585         .
      586         else assign
      587           oxml-heap-dir = file-info:full-pathname
      588           log-file-name = oxml-heap-dir + chr(92) + "openxml.log"
      589         .
      590       end.
      591       assign
      592         v-str-err = right-trim( v-str-err, chr(10) )
      593       .
      594       if v-str-err <> "":U then do:
      595         message
      596           substitute( "&1", v-str-err ) skip
      597           substitute( "Вы хотите произвести настройку сейчас?" ) skip
      598           view-as alert-box question buttons yes-no update v-set-prop
      599         .
      600         if v-set-prop = true then do:
      601           run bge/oxml-prp.w no-error .
      602           if error-status :error then do:
      603             message
      604               vss-workfile vss-revision vss-description skip
      605               substitute( "Ошибка при вызове процедуры настройки OpenXML" ) skip
      606               return-value skip
      607               error-status :get-message ( error-status :num-messages )
      608               view-as alert-box error
      609             .
      610           end.
      611         end.
      612       end.
      613     end.
      614     if v-str-err <> "":U then do:
      615       return error v-str-err.
      616     end.
      617   end.
