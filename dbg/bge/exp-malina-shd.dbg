        1   block-level on error undo, throw.
        2   define variable vss-revision as character no-undo init "$Revision: $":U.
        3   define variable vss-author as character no-undo init "$Author: EShklyar $":U.
        4   define variable vss-date as character no-undo init "$Date: $":U.
        5   define variable vss-workfile as character no-undo init "$Workfile: exp-malina-shd.p $":U.
        6   define variable vss-archive as character no-undo init "$Archive: bge/exp-malina-shd.p $":U.
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define input parameter parparentproc as widget-handle no-undo.
       67   define input parameter p_parent-handle as widget-handle no-undo.
       68   define input parameter p_log-handle as handle no-undo.
       69   define input parameter p_db-num-char as character no-undo.
       70   define input parameter p_task-type as character no-undo.
       71   define input parameter p_task-num as integer no-undo.
       72   define input parameter p_db-num as integer no-undo.
       73   define variable v-param-list as character no-undo.
       74   define variable v-param-type as character no-undo.
       75   define variable v-obj-list as character no-undo.
       76   define variable v-company as integer no-undo.
       77   define variable v-directory as character no-undo.
       78   define variable v-prefix as CHARACTER no-undo.
       79   define variable v-goods as LOGICAL no-undo.
       80   define variable v-chk as LOGICAL no-undo.
       81   define variable v-category as integer no-undo.
       82   define variable v-diapmin as integer no-undo.
       83   define variable v-diapmax as integer no-undo.
       84   define variable ii as integer no-undo.
       85   define variable c_entry as character no-undo.
       86   define variable v-location as logical no-undo.
       87   define variable v-categ-loc as character no-undo.
       88   define buffer buf_clients for ub.clients.
       89   define temp-table tt_obj-list no-undo
       90   field obj-type like ub.clients.obj-type
       91   field obj-code like ub.clients.obj-code.
       92   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   define temp-table temp-schedule-free no-undo
       94   field free-id as character
       95   field free-task-name as character
       96   field proc-run-name as character
       97   field proc-param-edit-name as character
       98   field conf-param as character
       99   field is-gbd as logical
      100   field is-ubd as logical
      101   field enable-concurrent-0 as logical
      102   field enable-concurrent-db as logical
      103   field other-info as character
      104   field enc-key as character
      105   field is-rum as logical
      106   index pi is unique primary
      107   free-id.
      108   procedure schedule-attr-name :
      109   do
      110     on error undo, return error
      111     :
      112     define input  parameter p-code           as character no-undo .
      113     define output parameter p-type           as character no-undo .
      114     define output parameter p-format         as character no-undo .
      115     define output parameter p-label          as character no-undo .
      116     define output parameter p-user-can-edit  as logical   no-undo .
      117     define output parameter p-output-display as logical   no-undo .
      118     define output parameter p-other          as character no-undo .
      119       if index(p-code, chr(4)) > 0 then do:
      120         p-code = entry(1, p-code, chr(4)).
      121       end.
      122       case p-code :
      123               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      124               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      125               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      126               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      127               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      128               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      129               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      130               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      131               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      132         otherwise do:
      133           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      134         end.
      135       end.
      136     end.
      137   end procedure.
      138   procedure schedule-attr-tooltip :
      139   do
      140     on error undo, return error
      141     :
      142       define input  parameter p-code    as character no-undo .
      143       define output parameter p-tooltip as character no-undo .
      144       define output parameter p-label   as character no-undo .
      145       if index(p-code, chr(4)) > 0 then do:
      146         p-code = entry(1, p-code, chr(4)).
      147       end.
      148       case p-code :
      149               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      150               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      151               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      152               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      153               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      154               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      155               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      156               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      157               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      158         otherwise do:
      159               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      160         end.
      161       end.
      162     end.
      163   end procedure.
      164   procedure schedule-attr-value :
      165   do
      166   on error undo, return error return-value
      167   :
      168   define input parameter  p-cre-db-num as integer    no-undo.
      169   define input parameter  p-task-type  as character  no-undo.
      170   define input parameter  p-task-num   as integer    no-undo.
      171   define input parameter  p-code       as character  no-undo.
      172   define output parameter p-value      as character  no-undo.
      173   define output parameter p-type       as character  no-undo.
      174       define variable v-format         as character no-undo .
      175       define variable v-label          as character no-undo .
      176       define variable v-user-can-edit  as logical   no-undo .
      177       define variable v-output-display as logical   no-undo .
      178       define variable v-other          as character no-undo .
      179       define buffer buf_schedule-attr for ub.schedule-attr.
      180       run schedule-attr-name in this-procedure (
      181             input  p-code
      182           , output p-type
      183           , output v-format
      184           , output v-label
      185           , output v-user-can-edit
      186           , output v-output-display
      187           , output v-other
      188       ) no-error .
      189       if error-status :error
      190       then do:
      191           undo, return error return-value .
      192       end.
      193       if p-code begins ('schd-free-id':U + chr(4))
      194       and entry(2, p-code, chr(4)) = '':U then do:
      195         find first buf_schedule-attr no-lock
      196             where buf_schedule-attr.cre-db-num = p-cre-db-num
      197               and buf_schedule-attr.task-type  = p-task-type
      198               and buf_schedule-attr.task-num   = p-task-num
      199               and buf_schedule-attr.attr-code  begins p-code
      200         no-error .
      201       end.
      202       else do:
      203         find first buf_schedule-attr no-lock
      204             where buf_schedule-attr.cre-db-num = p-cre-db-num
      205               and buf_schedule-attr.task-type  = p-task-type
      206               and buf_schedule-attr.task-num   = p-task-num
      207               and buf_schedule-attr.attr-code  = p-code
      208         no-error .
      209       end.
      210       if available buf_schedule-attr
      211       then do:
      212           assign
      213               p-value = buf_schedule-attr.attr-value
      214           .
      215       end.
      216       else do:
      217         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      218            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      219         end.
      220         else do:
      221           assign
      222               p-value = if p-type = 'L':U then "no":U else ""
      223           .
      224         end.
      225       end.
      226   end.
      227   end procedure.
      228   procedure schedule-attr-write :
      229   do
      230   on error undo, return error
      231   :
      232   define input parameter p-cre-db-num  as integer   no-undo.
      233   define input parameter p-task-type   as character no-undo.
      234   define input parameter p-task-num    as integer   no-undo.
      235   define input parameter p-code        as character no-undo.
      236   define input parameter p-value       as character no-undo.
      237       define variable v-type              as character                no-undo.
      238       define variable v-format            as character                no-undo.
      239       define variable v-label             as character                no-undo.
      240       define variable v-user-can-edit     as logical                  no-undo.
      241       define variable v-output-display    as logical                  no-undo.
      242       define variable v-other             as character                no-undo.
      243       define buffer buf_schedule-attr for ub.schedule-attr .
      244       run schedule-attr-name in this-procedure (
      245             input  p-code
      246           , output v-type
      247           , output v-format
      248           , output v-label
      249           , output v-user-can-edit
      250           , output v-output-display
      251           , output v-other
      252       ) no-error.
      253       if error-status :error
      254       then do:
      255           undo, return error return-value.
      256       end.
      257       find first buf_schedule-attr exclusive-lock
      258            where buf_schedule-attr.cre-db-num = p-cre-db-num
      259              and buf_schedule-attr.task-type  = p-task-type
      260              and buf_schedule-attr.task-num   = p-task-num
      261              and buf_schedule-attr.attr-code  = p-code
      262       no-error.
      263       if not available buf_schedule-attr
      264       then do:
      265           create buf_schedule-attr.
      266           assign
      267             buf_schedule-attr.cre-db-num = p-cre-db-num
      268             buf_schedule-attr.task-type  = p-task-type
      269             buf_schedule-attr.task-num   = p-task-num
      270             buf_schedule-attr.attr-code  = p-code
      271             buf_schedule-attr.attr-value = p-value
      272           .
      273       end.
      274       else do:
      275           assign
      276               buf_schedule-attr.attr-value = p-value
      277           .
      278       end.
      279   end.
      280   end procedure.
      281   procedure schedule-attr-delete :
      282   do
      283   on error undo, return error
      284   :
      285   define input  parameter p-cre-db-num  as integer   no-undo.
      286   define input  parameter p-task-type   as character no-undo.
      287   define input  parameter p-task-num    as integer   no-undo.
      288   define input  parameter p-code        as character no-undo.
      289   define output parameter p-deleted     as logical   no-undo.
      290       define buffer buf_schedule-attr for ub.schedule-attr .
      291       define variable v-type              as character                no-undo.
      292       define variable v-format            as character                no-undo.
      293       define variable v-label             as character                no-undo.
      294       define variable v-user-can-edit     as logical                  no-undo.
      295       define variable v-output-display    as logical                  no-undo.
      296       define variable v-other             as character                no-undo.
      297       run schedule-attr-name in this-procedure (
      298             input p-code
      299           , output v-type
      300           , output v-format
      301           , output v-label
      302           , output v-user-can-edit
      303           , output v-output-display
      304           , output v-other
      305       ) no-error .
      306       if error-status :error
      307       then do:
      308           undo, return error return-value .
      309       end.
      310       find first buf_schedule-attr exclusive-lock
      311            where buf_schedule-attr.cre-db-num = p-cre-db-num
      312              and buf_schedule-attr.task-type  = p-task-type
      313              and buf_schedule-attr.task-num   = p-task-num
      314              and buf_schedule-attr.attr-code  = p-code
      315       no-error.
      316       if not available buf_schedule-attr
      317       then do:
      318           assign
      319               p-deleted = no
      320           .
      321       end.
      322       else do:
      323           delete buf_schedule-attr.
      324           assign
      325               p-deleted = yes
      326           .
      327       end.
      328   end.
      329   end procedure.
      330   procedure schedule-attr-news :
      331   do
      332   on error undo, return error
      333   :
      334       define input  parameter p-code           as character no-undo .
      335       define output parameter p-news           as logical   no-undo .
      336       if index(p-code, chr(4)) > 0 then do:
      337         p-code = entry(1, p-code, chr(4)).
      338       end.
      339       case p-code :
      340               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      341               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      342               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      343               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      344               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      345               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      346               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      347               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      348               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      349         otherwise do:
      350           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      351         end.
      352       end.
      353   end.
      354   end procedure.
      355   procedure schedule-attr-extract-logical :
      356   do
      357   on error undo, return error
      358   :
      359   define input  parameter p-parameter-number   as integer      no-undo.
      360   define input  parameter p-parameter-list     as character    no-undo.
      361   define output parameter p-parameter-value   as logical      no-undo.
      362       if num-entries( p-parameter-list ) > p-parameter-number - 1
      363       then do:
      364           assign
      365               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      366           .
      367       end.
      368       else do:
      369           assign
      370               p-parameter-value   = no
      371           .
      372       end.
      373   end.
      374   end procedure.
      375   procedure schedule-attr-get-free-id :
      376   do
      377   on error undo, return error return-value
      378   :
      379     define input  parameter p-cre-db-num  as integer   no-undo.
      380     define input  parameter p-task-type   as character no-undo.
      381     define input  parameter p-task-num    as integer   no-undo.
      382     define output parameter p-free-id     as character no-undo.
      383     define buffer buf_schedule-attr for ub.schedule-attr.
      384     find first buf_schedule-attr no-lock
      385         where buf_schedule-attr.cre-db-num = p-cre-db-num
      386           and buf_schedule-attr.task-type  = p-task-type
      387           and buf_schedule-attr.task-num   = p-task-num
      388           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      389     no-error .
      390     if available buf_schedule-attr then
      391     assign
      392     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      393     no-error
      394     .
      395   end.
      396   end procedure.
      397   procedure schedule-attr-get-free-props :
      398     define input parameter p-free-id as character no-undo .
      399     define output parameter p-value as character no-undo .
      400     define buffer buf_temp-schedule-free for temp-schedule-free.
      401     do
      402     on error undo, return error return-value
      403     :
      404       find first buf_temp-schedule-free no-lock no-error .
      405       if not available buf_temp-schedule-free then do:
      406         run schedule-attr-fill-free-props in this-procedure .
      407       end.
      408       find first buf_temp-schedule-free where
      409               buf_temp-schedule-free.free-id = p-free-id no-error.
      410       if available buf_temp-schedule-free then do:
      411         assign
      412         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      413                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      414                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      415                   buf_temp-schedule-free.conf-param           + chr(4) +
      416                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      417                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      418                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      419                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      420                   buf_temp-schedule-free.other-info
      421         .
      422       end.
      423       else do:
      424        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      425                              "id произвольной задачи - &5"
      426                              ,vss-workfile
      427                              ,vss-revision
      428                              ,vss-description
      429                              ,chr(10)
      430                              ,p-free-id).
      431       end.
      432     end.
      433   end procedure.
      434   procedure schedule-attr-is-rum-free-id :
      435   define input parameter p-free-id as character no-undo .
      436   define output parameter p-is-rum as logical no-undo .
      437   define buffer buf_temp-schedule-free for temp-schedule-free.
      438   do
      439   on error undo, return error
      440   :
      441       find first buf_temp-schedule-free no-lock no-error .
      442       if not available buf_temp-schedule-free then do:
      443         run schedule-attr-fill-free-props in this-procedure .
      444       end.
      445       find first buf_temp-schedule-free where
      446               buf_temp-schedule-free.free-id = p-free-id no-error.
      447       if available buf_temp-schedule-free
      448       and buf_temp-schedule-free.is-rum
      449       then do:
      450         p-is-rum = yes.
      451       end.
      452   end.
      453   end procedure.
      454   procedure schedule-attr-fill-free-props :
      455   define variable v-path                    as character                no-undo .
      456   DEFINE VARIABLE v-full-path               as character                no-undo .
      457   DEFINE VARIABLE v-file-name               as character                no-undo .
      458   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      459   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      460   define buffer buf_temp-schedule-free for temp-schedule-free.
      461   define variable v-answer as logical no-undo .
      462     do
      463     on error undo, return error substitute("&1 &2 &3&4&5&4"
      464                                           ,vss-workfile
      465                                           ,vss-revision
      466                                           ,vss-description
      467                                           ,chr(10)
      468                                           ,error-status:get-message(1) )
      469     :
      470       run gbl/filename.p (
      471                       input 'cmp/shd-free.d'
      472                     ,output v-full-path
      473                     ,output v-path
      474                     ,output v-file-name
      475                     ,output v-file-name-no-ext
      476                     ,output v-file-name-ext
      477                     ) .
      478       input from value(v-full-path).
      479       repeat :
      480         create buf_temp-schedule-free.
      481         import buf_temp-schedule-free.
      482       END.
      483       input close.
      484       _ff:
      485       for each buf_temp-schedule-free :
      486         if buf_temp-schedule-free.free-id = '':U then do:
      487            delete buf_temp-schedule-free.
      488            next _ff.
      489          end.
      490          run schedule-attr-check-enc in this-procedure (
      491                                                       input  buf_temp-schedule-free.free-id
      492                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      493                                                               buf_temp-schedule-free.proc-param-edit-name +
      494                                                               buf_temp-schedule-free.conf-param +
      495                                                               string(buf_temp-schedule-free.is-gbd) +
      496                                                               string(buf_temp-schedule-free.is-ubd) +
      497                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      498                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      499                                                               string(buf_temp-schedule-free.other-info)
      500                                                               )
      501                                                       ,input  buf_temp-schedule-free.enc-key
      502                                                       ,output v-answer    ) no-error .
      503          if error-status:error
      504          or not v-answer then delete buf_temp-schedule-free.
      505        end.
      506     end.
      507   end procedure.
      508   Function schedule-attr-reverse returns character (str as character).
      509      define variable rev_incl_s as character init "" no-undo .
      510      define variable rev_incl_i as integer no-undo .
      511      define variable rev_incl_l as integer no-undo .
      512      rev_incl_l = length(str).
      513      do rev_incl_i = 1 to rev_incl_l:
      514         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      515      end.
      516      return rev_incl_s.
      517   end.
      518   procedure schedule-attr-check-enc.
      519     define input  parameter p-free-id   as character no-undo .
      520     define input  parameter p-value     as character no-undo .
      521     define input  parameter p-enc-value as character no-undo .
      522     define output parameter p-answer    as logical   no-undo .
      523     define variable tmp         as character no-undo .
      524     define variable v-enc-value as character no-undo .
      525     assign
      526     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      527     .
      528     run schedule-attr-pswd-enc in this-procedure
      529       ( input tmp
      530        ,output v-enc-value
      531       ) no-error .
      532     if error-status:error then do:
      533       message
      534         vss-workfile vss-revision vss-description skip
      535         "Ошибка при вызове процедуры pswd-enc" skip
      536         return-value skip
      537         error-status :get-message(1) skip
      538         view-as alert-box error .
      539       undo, return error .
      540     end.
      541     if v-enc-value = p-enc-value then do:
      542       assign
      543         p-answer = true
      544       .
      545     end.
      546     else do:
      547       assign
      548         p-answer = false
      549       .
      550     end.
      551   end.
      552   procedure schedule-attr-conf-enc.
      553     define input  parameter p-free-id   as character no-undo .
      554     define input  parameter p-value     as character no-undo .
      555     define output parameter p-enc-value as character no-undo .
      556     define variable tmp         as character no-undo .
      557     assign
      558       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      559     .
      560     run schedule-attr-pswd-enc in this-procedure
      561       ( input tmp
      562        ,output p-enc-value
      563       ) no-error .
      564     if error-status:error then do:
      565       message
      566         vss-workfile vss-revision vss-description skip
      567         "Ошибка при вызове процедуры pswd-enc" skip
      568         return-value skip
      569         error-status :get-message(1) skip
      570         view-as alert-box error .
      571       undo, return error .
      572     end.
      573   end procedure.
      574   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      575   procedure schedule-attr-pswd-enc :
      576     define input parameter  pswd     as character no-undo .
      577     define output parameter enc-pswd as character no-undo .
      578     do
      579     on error undo, return error return-value
      580     :
      581       assign
      582         enc-pswd = encode(pswd + string(index(pswd, "k")))
      583       .
      584     end.
      585   end procedure.
      586   run schedule-attr-value in this-procedure (input integer(p_db-num-char),
      587                                              input p_task-type,
      588                                              input p_task-num,
      589                                              input 'schedule-param-list':U,
      590                                              output v-param-list,
      591                                              output v-param-type).
      592   assign
      593       v-company = integer(entry(1,v-param-list,chr(4)))
      594       v-directory = entry(2,v-param-list,chr(4))
      595       v-prefix = entry(3,v-param-list,chr(4))
      596       v-goods = LOGICAL(entry(4,v-param-list,chr(4)))
      597       v-chk = LOGICAL(entry(5,v-param-list,chr(4)))
      598       v-category = integer(entry(6,v-param-list,chr(4)))
      599       v-diapmin = integer(entry(7,v-param-list,chr(4)))
      600       v-diapmax = integer(entry(8,v-param-list,chr(4)))
      601       v-location = LOGICAL(entry(9,v-param-list,chr(4)))
      602       v-categ-loc = entry(10,v-param-list,chr(4))
      603       NO-ERROR.
      604   run schedule-attr-value in this-procedure (input integer(p_db-num-char),
      605                                              input p_task-type,
      606                                              input p_task-num,
      607                                              input 'schedule-obj-list':U,
      608                                              output v-obj-list,
      609                                              output v-param-type) no-error.
      610   if v-obj-list begins 'орг':U then do:
      611       c_entry = entry(1,v-obj-list,chr(4)).
      612       for each buf_clients where buf_clients.host-code = integer(entry(2,c_entry,chr(44))):
      613           if buf_clients.stts <> 0 then next.
      614           create tt_obj-list.
      615           assign
      616           tt_obj-list.obj-code = buf_clients.obj-code
      617           tt_obj-list.obj-type = buf_clients.obj-type.
      618       end.
      619   end.
      620   else do:
      621       do ii = 1 to num-entries(v-obj-list, chr(4)) on error undo, next:
      622           c_entry = entry(ii,v-obj-list,chr(4)).
      623           find first buf_clients where buf_clients.obj-type = entry(1,c_entry,chr(44))
      624               and buf_clients.obj-code = integer(entry(2,c_entry,chr(44))) no-lock no-error.
      625           if available(buf_clients) and buf_clients.stts = 0 then do:
      626               create tt_obj-list.
      627               assign
      628               tt_obj-list.obj-code = buf_clients.obj-code
      629               tt_obj-list.obj-type = buf_clients.obj-type.
      630           end.
      631       end.
      632   end.
      633       run bge\exp-malinap.p ( table tt_obj-list,
      634                               v-company,
      635                               v-directory,
      636                               v-prefix,
      637                               v-goods,
      638                               v-chk,
      639                               v-category,
      640                               v-diapmin,
      641                               v-diapmax,
      642                               p_log-handle,
      643                               v-location,
      644                               v-categ-loc
      645                          ).
