      709   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT EQ ?
      710   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      711   MAIN-BLOCK:
      712   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      713      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      714       FOR EACH tt-gds-list:
      715           CREATE gds-list.
      716           BUFFER-COPY tt-gds-list TO gds-list.
      717           v-gds-list = v-gds-list + "," + string(gds-list.gds-code) NO-ERROR.
      718       END.
      719       v-gds-list = TRIM (SUBSTRING(v-gds-list,2))  .
      720       FOR EACH t-obj-list:
      721           v-obj-list = v-obj-list + t-obj-list.obj-type + string( t-obj-list.obj-code ) + " ":U.
      722       END.
      723       IF TRIM (v-obj-list) NE ""
      724       THEN
      725           SelObj = "выборочно".
      726       IF TRIM (v-obj-list) NE ""
      727       THEN
      728           ENABLE b-obj WITH FRAME Dialog-Frame .
      729       ELSE
      730           DISABLE b-obj WITH FRAME Dialog-Frame .
      731       FIND FIRST tt-vsd-filt NO-ERROR .
      732       IF AVAIL tt-vsd-filt
      733       THEN ASSIGN
      734           v-date-end   = tt-vsd-filt.date-end
      735           v-date-start = tt-vsd-filt.date-start
      736           vtime        = tt-vsd-filt.fTime
      737           vFalExting   = tt-vsd-filt.FalExting
      738           vFalVerif    = tt-vsd-filt.FalVerif
      739           vRep         = tt-vsd-filt.Rep
      740           vReqVerif    = tt-vsd-filt.ReqVerif
      741           vToExtin     = tt-vsd-filt.ToExtin
      742           vdoc-code    = tt-vsd-filt.doc-code
      743           vSent        = tt-vsd-filt.Sent
      744           .
      745   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      746     run mainmenu_getcntxt in parparentproc
      747       (output v-cntxt-db-num
      748       ,output v-cntxt-userid
      749       ,output v-cntxt-level
      750       ,output v-cntxt-host-code-obj
      751       ,output v-cntxt-obj-type
      752       ,output v-cntxt-obj-code
      753       ,output v-cntxt-db-num-obj
      754       ,output v-cntxt-is-admin
      755       ) .
      756       .
      757     RUN enable_UI.
      758     IF TRIM (v-obj-list) EQ  ""
      759     THEN
      760       APPLY "value-changed" TO SelObj IN FRAME Dialog-Frame .
      761     WAIT-FOR GO OF FRAME Dialog-Frame.
      762   END.
      763   RUN disable_UI.
      764   PROCEDURE disable_UI :
      765     HIDE FRAME Dialog-Frame.
      766   END PROCEDURE.
      767   PROCEDURE enable_UI :
      768     DISPLAY vTime v-date-start v-date-end vdoc-code vReqVerif vToExtin vRep
      769             vFalVerif vFalExting vSent v-obj-list SelObj v-gds-list
      770         WITH FRAME Dialog-Frame.
      771     ENABLE RECT-1 RECT-2 Btn_OK Btn_Cancel btn_cler vTime v-date-start v-date-end
      772            vdoc-code vReqVerif vToExtin vRep vFalVerif vFalExting vSent SelObj
      773            b-obj b-spisok
      774         WITH FRAME Dialog-Frame.
      775     VIEW FRAME Dialog-Frame.
      776   END PROCEDURE.
      777   PROCEDURE sel-goods :
      778   DEFINE VARIABLE v-list AS CHARACTER NO-UNDO.
      779       v-list = "" .
      780       RUN str/gds-list.w (
      781           INPUT parparentproc
      782         , INPUT v-cntxt-host-code-obj
      783         , INPUT v-cntxt-obj-type
      784         , INPUT v-cntxt-obj-code) NO-ERROR.
      785       FOR EACH gds-list NO-LOCK:
      786           v-list = v-list + "," + string(gds-list.gds-code) NO-ERROR.
      787       END.
      788       v-gds-list = TRIM (SUBSTRING(v-list,2))  .
      789       DISPLAY v-gds-list WITH FRAME Dialog-Frame .
      790   END PROCEDURE.
