      569        DISPLAY vTime v-date-start v-date-end vReqVerif vFalVerif vToExtin vFalExting
      570             vRep vSent SelObj v-obj-list
      571         WITH FRAME Dialog-Frame.
      572   END.
      573   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      574   DO:
      575       FOR EACH tt-gds-list:
      576           DELETE tt-gds-list.
      577       END.
      578       FOR EACH gds-list:
      579           CREATE tt-gds-list.
      580           BUFFER-COPY gds-list TO tt-gds-list.
      581       END.
      582       FIND FIRST tt-vsd-filt.
      583       ASSIGN
      584           v-date-end
      585           v-date-start
      586           vtime
      587           vFalExting
      588           vFalVerif
      589           vRep
      590           vReqVerif
      591           vToExtin
      592           vdoc-code
      593           vSent.
      594       Assign
      595           tt-vsd-filt.date-end    = v-date-end
      596           tt-vsd-filt.date-start  = v-date-start
      597           tt-vsd-filt.fTime       = vtime
      598           tt-vsd-filt.FalExting   = vFalExting
      599           tt-vsd-filt.FalVerif    = vFalVerif
      600           tt-vsd-filt.Rep         = vRep
      601           tt-vsd-filt.ReqVerif    = vReqVerif
      602           tt-vsd-filt.ToExtin     = vToExtin
      603           tt-vsd-filt.Sent        = vSent
      604           tt-vsd-filt.doc-code    = vdoc-code
      605       .
      606   END.
      607   ON VALUE-CHANGED OF SelObj IN FRAME Dialog-Frame
      608   DO:
      609     DEFINE BUFFER buf_db      FOR ub.db  .
      610     DEFINE BUFFER buf_clients FOR ub.clients .
      611     DEFINE VARIABLE v-object-available AS LOGICAL   NO-UNDO .
      612     ASSIGN
      613       SelObj
      614     .
      615     FOR EACH t-obj-list
      616     ON ERROR UNDO, RETURN NO-APPLY
      617     :
      618       DELETE t-obj-list .
      619     END.
      620     ASSIGN
      621       v-obj-list = "":U
      622     .
      623     CASE SelObj :
      624       WHEN "Выборочно" THEN DO:
      625         ENABLE b-obj WITH FRAME Dialog-Frame .
      626       END.
      627       WHEN "По фирме" THEN DO:
      628         DISABLE b-obj WITH FRAME Dialog-Frame .
      629         FOR EACH buf_clients NO-LOCK
      630           WHERE buf_clients.host-code = v-cntxt-host-code-obj
      631         ON ERROR UNDO, RETURN NO-APPLY
      632         :
      633   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      634   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
      635     (input  v-cntxt-db-num
      636     ,input  0
      637     ,input  v-cntxt-userid
      638     ,input  buf_clients.obj-type
      639     ,input  buf_clients.obj-code
      640     ,output v-object-available
      641     ) no-error .
      642           IF ERROR-STATUS :ERROR
      643           THEN DO:
      644             MESSAGE
      645               vss-workfile vss-revision vss-description SKIP
      646               "Ошибка при вызове процедуры gbl/usobjava.i" SKIP
      647               ERROR-STATUS :GET-MESSAGE(1) SKIP
      648               RETURN-VALUE SKIP
      649               VIEW-AS ALERT-BOX ERROR .
      650             UNDO, RETURN NO-APPLY .
      651           END.
      652           IF v-object-available = TRUE
      653           THEN DO:
      654             CREATE t-obj-list .
      655             ASSIGN
      656               t-obj-list.obj-type = buf_clients.obj-type
      657               t-obj-list.obj-code = buf_clients.obj-code
      658               v-obj-list = v-obj-list + t-obj-list.obj-type + string( t-obj-list.obj-code ) + " ":U
      659             NO-ERROR .
      660           END.
      661         END.
      662       END.
      663       WHEN "Глобально" THEN DO:
      664         DISABLE b-obj WITH FRAME Dialog-Frame .
      665         FOR EACH buf_db NO-LOCK
      666         ON ERROR UNDO, RETURN NO-APPLY
      667         :
      668           FOR EACH buf_clients NO-LOCK
      669             WHERE buf_clients.db-num = buf_db.db-num
      670           ON ERROR UNDO, RETURN NO-APPLY
      671           :
      672   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      673   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
      674     (input  v-cntxt-db-num
      675     ,input  0
      676     ,input  v-cntxt-userid
      677     ,input  buf_clients.obj-type
      678     ,input  buf_clients.obj-code
      679     ,output v-object-available
      680     ) no-error .
      681             IF ERROR-STATUS :ERROR
      682             THEN DO:
      683               MESSAGE
      684                 vss-workfile vss-revision vss-description SKIP
      685                 "Ошибка при вызове процедуры gbl/usobjava.i" SKIP
      686                 ERROR-STATUS :GET-MESSAGE(1) SKIP
      687                 RETURN-VALUE SKIP
