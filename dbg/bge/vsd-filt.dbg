       98     define variable v-cntxt-obj-code      as integer   no-undo .
       99     define variable v-cntxt-db-num-obj    as integer   no-undo .
      100     define variable v-cntxt-is-admin      as logical   no-undo .
      101   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      102   define new shared temp-table gds-list no-undo like ub.goods
