       91   end.
       92   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93     define variable v-cntxt-db-num        as integer   no-undo .
       94     define variable v-cntxt-userid        as character no-undo .
       95     define variable v-cntxt-level         as character no-undo .
       96     define variable v-cntxt-host-code-obj as integer   no-undo .
