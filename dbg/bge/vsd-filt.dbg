      138   define temp-table userobjs_temp-user-obj no-undo
      139     field obj-type as character
      140     field obj-code as integer
      141     index xpk is primary unique obj-type obj-code
      142     .
      143   procedure userobjs_clear :
      144     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      145     do
      146     on error undo, return error return-value
      147     :
      148       for each buf_userobjs_temp-user-obj
      149       on error undo, return error return-value
      150       :
      151         delete buf_userobjs_temp-user-obj .
      152       end.
      153     end.
      154   end .
      155   procedure userobjs_object-count :
      156     define output parameter p-total-count as integer   no-undo .
      157     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      158     do
      159     on error undo, return error return-value
      160     :
      161       assign
      162         p-total-count = 0
      163       .
      164       for each buf_userobjs_temp-user-obj
      165       on error undo, return error return-value
      166       :
      167         assign
      168           p-total-count = p-total-count + 1
      169         .
      170       end.
      171     end.
      172   end.
      173   procedure userobjs_append :
      174      define input  parameter p-obj-type as character no-undo .
      175      define input  parameter p-obj-code as integer   no-undo .
      176     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      177     do
      178     on error undo, return error return-value
      179     :
      180       find first buf_userobjs_temp-user-obj
      181         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      182           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      183         no-error .
      184       if not available buf_userobjs_temp-user-obj
      185       then do:
      186         create buf_userobjs_temp-user-obj .
      187         assign
      188           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      189           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      190         .
      191       end.
      192     end.
      193   end.
      194   procedure userobjs_object-exist :
      195     define output parameter p-object-exist as logical   no-undo .
      196     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      197     do
      198     on error undo, return error return-value
      199     :
      200       find first buf_userobjs_temp-user-obj
      201         no-error .
      202       if not available buf_userobjs_temp-user-obj
      203       then do:
      204         assign
      205           p-object-exist = false
      206         .
      207       end.
      208       else do:
      209         assign
      210           p-object-exist = true
      211         .
      212       end.
      213     end.
      214   end.
      215   procedure userobjs_transfer :
      216     define input  parameter p-callback-handle as handle no-undo .
      217     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      218     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      219     do
      220     on error undo, return error return-value
      221     :
      222       if valid-handle(p-callback-handle) <> true
      223       then do:
      224         message
      225           vss-workfile vss-revision vss-description skip
      226           "Ошибка задания входных параметров" skip
      227           "Неизвестный указатель на процедуру" skip
      228           view-as alert-box error .
      229         undo, return error return-value .
      230       end.
      231       if p-callback-handle :get-signature("userobjs_append") = ""
      232       then do:
      233         message
      234           vss-workfile vss-revision vss-description skip
      235           "Ошибка задания входных параметров" skip
      236           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      237                     ,p-callback-handle :file-name
      238                     ) skip
      239           view-as alert-box error .
      240         undo, return error return-value .
      241       end.
      242       for each buf_userobjs_temp-user-obj
      243       on error undo, return error return-value
      244       :
      245         run userobjs_append in p-callback-handle
      246           (input  buf_userobjs_temp-user-obj.obj-type
      247           ,input  buf_userobjs_temp-user-obj.obj-code
      248           ) .
      249       end.
      250     end.
      251   end procedure.
      252   procedure userobjs_select-one :
      253      define input  parameter parparentproc     as widget-handle no-undo .
      254      define input  parameter p-db-num          as integer   no-undo .
      255      define input  parameter p-user-id         as character no-undo .
      256      define input  parameter p-host-code-obj   as integer   no-undo .
      257      define input  parameter p-obj-type        as character no-undo .
      258      define input  parameter p-obj-code        as integer   no-undo .
      259      define output parameter p-user-select     as logical   no-undo .
      260      define output parameter p-select-obj-type as character no-undo .
      261      define output parameter p-select-obj-code as character no-undo .
      262     do
      263     on error undo, return error return-value
      264     :
      265       run gbl/userobjs.w
      266         (input  parparentproc
      267         ,input  this-procedure :handle
      268         ,input  p-db-num
      269         ,input  p-user-id
      270         ,input  p-host-code-obj
      271         ,input  p-obj-type
      272         ,input  p-obj-code
      273         ,INPUT  "b-sel"
      274         ,output p-user-select
      275         ,output p-select-obj-type
      276         ,output p-select-obj-code
      277         ) .
      278     end.
      279   end.
      280   procedure userobjs_select-many :
      281     define input  parameter parparentproc   as widget-handle no-undo .
      282     define input  parameter p-db-num        as integer   no-undo .
      283     define input  parameter p-user-id       as character no-undo .
      284     define input  parameter p-host-code-obj as integer   no-undo .
      285     define input  parameter p-obj-type      as character no-undo .
      286     define input  parameter p-obj-code      as integer   no-undo .
      287     define output parameter p-user-select   as logical   no-undo .
      288     define variable v-select-obj-type as character no-undo .
      289     define variable v-select-obj-code as integer   no-undo .
      290     do
      291     on error undo, return error return-value
      292     :
      293       run gbl/userobjs.w
      294         (input  parparentproc
      295         ,input  this-procedure :handle
      296         ,input  p-db-num
      297         ,input  p-user-id
      298         ,input  p-host-code-obj
      299         ,input  p-obj-type
      300         ,input  p-obj-code
      301         ,INPUT  "b-sel,b-mark"
      302         ,output p-user-select
      303         ,output v-select-obj-type
      304         ,output v-select-obj-code
      305         ) .
      306     end.
      307   end.
      308   procedure thobjs :
      309      define input        parameter parparentproc     as widget-handle no-undo .
      310      define input        parameter i-bttns           as character     no-undo .
      311      define input        parameter i-list-mode       as character     no-undo.
      312      define input        parameter i-obj-type        as character     no-undo.
      313      define input        parameter i-db-num          as integer       no-undo.
      314      define input        parameter i-host-code       as integer       no-undo.
      315      define input-output parameter p-rid-list        as character     no-undo .
      316   run ref/thobjs.p
      317           ( input parparentproc
      318            ,input  this-procedure :handle
      319           , input i-bttns
      320           , input i-list-mode
      321           , input i-obj-type
      322           , input i-db-num
      323           , input i-host-code
      324           , input-output p-rid-list ) no-error .
      325   end.
      326   DEFINE BUTTON b-obj DEFAULT
      327        IMAGE-UP FILE "btn-down-arrow":U
      328        IMAGE-DOWN FILE "btn-down-arrow":U
      329        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      330        LABEL "":L
      331        SIZE 8 BY 1.08.
      332   DEFINE BUTTON b-spisok
      333        IMAGE-UP FILE "btn-down-arrow":U
      334        IMAGE-DOWN FILE "btn-down-arrow":U
      335        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      336        LABEL "Товары"
      337        SIZE 8 BY 1.92 TOOLTIP "Выбор товаров".
      338   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      339        LABEL "Отменить"
      340        SIZE 12 BY 1
      341        BGCOLOR 8 .
      342   DEFINE BUTTON btn_cler
      343        LABEL "Сброс"
      344        SIZE 12 BY 1.
      345   DEFINE BUTTON Btn_OK AUTO-GO
      346        LABEL "Применить"
      347        SIZE 15 BY 1
      348        BGCOLOR 8 .
      349   DEFINE VARIABLE v-gds-list AS CHARACTER
      350        VIEW-AS EDITOR SCROLLBAR-VERTICAL LARGE
      351        SIZE 58 BY 3.67 NO-UNDO.
      352   DEFINE VARIABLE v-obj-list AS CHARACTER
      353        VIEW-AS EDITOR SCROLLBAR-VERTICAL LARGE
      354        SIZE 58 BY 3.79 NO-UNDO.
      355   DEFINE VARIABLE v-date-end AS DATE FORMAT "99/99/9999":U
      356        LABEL "По"
      357        VIEW-AS FILL-IN
      358        SIZE 14 BY 1 NO-UNDO.
      359   DEFINE VARIABLE v-date-start AS DATE FORMAT "99/99/9999":U
      360        LABEL "C"
      361        VIEW-AS FILL-IN
      362        SIZE 14 BY 1 NO-UNDO.
      363   DEFINE VARIABLE vdoc-code AS CHARACTER FORMAT "X(256)":U
      364        LABEL "Ном. Накл."
      365        VIEW-AS FILL-IN
      366        SIZE 14 BY 1 NO-UNDO.
      367   DEFINE VARIABLE vTime AS INTEGER FORMAT ">>>9":U INITIAL 0
      368        LABEL "Время гашения"
      369        VIEW-AS FILL-IN
      370        SIZE 14 BY 1 NO-UNDO.
      371   DEFINE VARIABLE SelObj AS CHARACTER INITIAL "Глобально"
      372        VIEW-AS RADIO-SET VERTICAL
      373        RADIO-BUTTONS
      374             "Глобально", "Глобально",
      375   "По фирме", "По фирме",
      376   "Выборочно", "Выборочно"
      377        SIZE 17 BY 2.21 NO-UNDO.
      378   DEFINE RECTANGLE RECT-1
      379        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      380        SIZE 92 BY 4.5.
      381   DEFINE RECTANGLE RECT-2
      382        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      383        SIZE 92 BY 4.5.
      384   DEFINE VARIABLE vFalExting AS LOGICAL INITIAL yes
      385        LABEL "Ошибка гашения"
      386        VIEW-AS TOGGLE-BOX
      387        SIZE 21 BY 1 NO-UNDO.
      388   DEFINE VARIABLE vFalRegis AS LOGICAL INITIAL no
      389        LABEL "Ошибка регистрации"
      390        VIEW-AS TOGGLE-BOX
      391        SIZE 26 BY 1 NO-UNDO.
      392   DEFINE VARIABLE vFalVerif AS LOGICAL INITIAL yes
      393        LABEL "Ошибка проверки ВСД"
      394        VIEW-AS TOGGLE-BOX
      395        SIZE 27 BY 1 NO-UNDO.
      396   DEFINE VARIABLE vRegis AS LOGICAL INITIAL no
      397        LABEL "Зарегистрирован"
      398        VIEW-AS TOGGLE-BOX
      399        SIZE 23 BY 1 NO-UNDO.
      400   DEFINE VARIABLE vRep AS LOGICAL INITIAL yes
      401        LABEL "Погашен"
      402        VIEW-AS TOGGLE-BOX
      403        SIZE 13 BY 1 NO-UNDO.
      404   DEFINE VARIABLE vReqVerif AS LOGICAL INITIAL yes
      405        LABEL "Требует проверки"
      406        VIEW-AS TOGGLE-BOX
      407        SIZE 22 BY 1 NO-UNDO.
      408   DEFINE VARIABLE vSent AS LOGICAL INITIAL yes
      409        LABEL "Отправлен"
      410        VIEW-AS TOGGLE-BOX
      411        SIZE 11.13 BY .83 NO-UNDO.
      412   DEFINE VARIABLE vToExtin AS LOGICAL INITIAL yes
      413        LABEL "К гашению"
      414        VIEW-AS TOGGLE-BOX
      415        SIZE 15 BY 1 NO-UNDO.
      416   DEFINE VARIABLE vToRegi AS LOGICAL INITIAL no
      417        LABEL "К регистрации"
      418        VIEW-AS TOGGLE-BOX
      419        SIZE 19 BY 1 NO-UNDO.
      420   DEFINE FRAME Dialog-Frame
      421        Btn_OK AT ROW 1.5 COL 7
      422        Btn_Cancel AT ROW 1.5 COL 22.5
      423        btn_cler AT ROW 1.5 COL 35 WIDGET-ID 44
      424        vTime AT ROW 3.88 COL 16 COLON-ALIGNED WIDGET-ID 22
      425        v-date-start AT ROW 3.88 COL 34 COLON-ALIGNED WIDGET-ID 36
      426        v-date-end AT ROW 3.88 COL 53 COLON-ALIGNED WIDGET-ID 38
      427        vdoc-code AT ROW 3.88 COL 81 COLON-ALIGNED WIDGET-ID 40
      428        vReqVerif AT ROW 5.5 COL 6 WIDGET-ID 2
      429        vToExtin AT ROW 5.5 COL 38 WIDGET-ID 6
      430        vRep AT ROW 5.5 COL 62 WIDGET-ID 10
      431        vFalVerif AT ROW 6.71 COL 6 WIDGET-ID 4
      432        vFalExting AT ROW 6.71 COL 38 WIDGET-ID 8
      433        vSent AT ROW 6.71 COL 62 WIDGET-ID 42
      434        v-obj-list AT ROW 9.08 COL 34 NO-LABEL
      435        SelObj AT ROW 10.04 COL 6 NO-LABEL
      436        b-obj AT ROW 11.25 COL 23
      437        v-gds-list AT ROW 13.88 COL 34 NO-LABEL
      438        b-spisok AT ROW 15.71 COL 19 WIDGET-ID 26
      439        vToRegi AT ROW 18.13 COL 7 WIDGET-ID 12
      440        vFalRegis AT ROW 18.13 COL 27 WIDGET-ID 14
      441        vRegis AT ROW 18.13 COL 54 WIDGET-ID 16
      442        "Выбор товаров" VIEW-AS TEXT
      443             SIZE 17 BY 1.67 TOOLTIP "Выбор товаров" AT ROW 13.88 COL 14 WIDGET-ID 30
      444        RECT-1 AT ROW 8.88 COL 3 WIDGET-ID 32
      445        RECT-2 AT ROW 13.38 COL 3 WIDGET-ID 34
      446        SPACE(3.59) SKIP(2.11)
      447       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      448            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      449            TITLE "Фильтр ВСД"
      450            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
      451   ASSIGN
      452          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      453          FRAME Dialog-Frame:HIDDEN           = TRUE.
      454   ASSIGN
      455          vFalRegis:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      456   ASSIGN
      457          vRegis:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      458   ASSIGN
      459          vToRegi:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      460   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      461   DO:
      462     APPLY "END-ERROR":U TO SELF.
      463   END.
      464   ON CHOOSE OF b-obj IN FRAME Dialog-Frame
      465   DO:
      466     define variable v-user-select as logical   no-undo .
      467     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      468   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      469   run userobjs_select-many in this-procedure
      470     (input  parparentproc
      471     ,input  v-cntxt-db-num
      472     ,input  v-cntxt-userid
      473     ,input  v-cntxt-host-code-obj
      474     ,input  v-cntxt-obj-type
      475     ,input  v-cntxt-obj-code
      476     ,output v-user-select
      477     )  .
      478     if v-user-select = true
      479     then do:
      480       for each t-obj-list
      481       on error undo, return no-apply
      482       :
      483         delete t-obj-list .
      484       end.
      485       assign
      486         v-obj-list    = "":U
      487       .
      488       for each buf_userobjs_temp-user-obj
      489       on error undo, return no-apply
      490       :
      491         create t-obj-list .
      492         assign
      493           t-obj-list.obj-type = buf_userobjs_temp-user-obj.obj-type
      494           t-obj-list.obj-code = buf_userobjs_temp-user-obj.obj-code
      495           v-obj-list = v-obj-list + t-obj-list.obj-type + string( t-obj-list.obj-code ) + " ":U NO-ERROR.
      496         .
      497       end.
      498       display
      499         v-obj-list
      500         with frame Dialog-Frame
      501       .
      502     end.
      503   END.
      504   ON CHOOSE OF b-spisok IN FRAME Dialog-Frame
      505   DO:
      506       RUN sel-goods IN THIS-PROCEDURE .
      507     END.
      508   ON CHOOSE OF btn_cler IN FRAME Dialog-Frame
      509   DO:
      510      DEFINE VARIABLE v-object-available AS LOGICAL   NO-UNDO .
      511      ASSIGN
      512           v-date-end   = TODAY
      513           v-date-start = TODAY
      514           vFalExting   = YES
      515           vFalVerif    = YES
      516           vRep         = YES
      517           vReqVerif    = YES
      518           vToExtin     = YES
      519           vTime        = 0
      520           tt-vsd-filt.doc-code = ?
      521           SelObj       = "Глобально"
      522           v-obj-list   = ""
      523           .
      524         FOR EACH t-obj-list:
      525            delete t-obj-list.
      526         end.
      527         FOR EACH t-obj-list:
      528            delete tt-gds-list.
      529         end.
      530         FOR EACH db NO-LOCK
      531           ON ERROR UNDO, RETURN NO-APPLY
      532           :
      533           FOR EACH clients NO-LOCK
      534               WHERE clients.db-num = db.db-num
      535               ON ERROR UNDO, RETURN NO-APPLY
      536               :
      537   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      538   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
      539     (input  v-cntxt-db-num
