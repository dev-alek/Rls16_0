        1   block-level on error undo, throw.
        2   define input parameter p-host-code              as integer                 no-undo.
        3   define input parameter p-oper-name              as character               no-undo.
        4   define input parameter p-fact-order-from        like ub.stk-tot.fact-order    no-undo.
        5   define input parameter p-fact-order-to          like ub.stk-tot.fact-order    no-undo.
        6   define input parameter p-obj-list               as character               no-undo.
        7   define input parameter p-parameter-list         as character               no-undo.
