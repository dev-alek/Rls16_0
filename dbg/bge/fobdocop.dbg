      600   procedure xmlchar-decode :
      601   define input parameter p-in-string      as character        no-undo.
      602   define output parameter p-out-string    as character        no-undo.
      603       define variable v-position      as integer      no-undo.
      604       define variable v-last-position as integer      no-undo.
      605       define variable v-temp-integer  as integer      no-undo.
      606       define variable v-current-char  as character    no-undo.
      607       define variable v-next-char     as character    no-undo.
      608       define variable v-success       as logical      no-undo.
      609   do
      610   on error undo, return error
      611   :
      612       assign
      613           p-out-string = "":U
      614           v-position   = 0
      615       .
      616       replace-cycle:
      617       do while yes
      618       on error undo, return error
      619       :
      620           assign
      621               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      622           .
      623           if v-last-position <= v-position
      624           then do:
      625               if v-position = 0
      626               then do:
      627                   assign
      628                       p-out-string = p-in-string
      629                   .
      630               end.
      631               else do:
      632                   assign
      633                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      634                   .
      635               end.
      636               leave replace-cycle.
      637           end.
      638           else do:
      639               assign
      640                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      641                   v-position      = v-last-position
      642                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      643               .
      644               if v-current-char = "#":U
      645               then do:
      646                   assign
      647                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      648                   .
      649                   if v-last-position > 0
      650                   then do:
      651                       run xmlchar-read-integer in this-procedure
      652                        (
      653                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      654                           , output v-temp-integer
      655                           , output v-success
      656                       ).
      657                       if v-success = yes
      658                       and v-temp-integer >= 1
      659                       and v-temp-integer <= 255
      660                       then do:
      661                           assign
      662                               p-out-string = p-out-string + chr( v-temp-integer )
      663                               v-position   = v-last-position + 1
      664                           .
      665                       end.
      666                       else do:
      667                           assign
      668                               p-out-string = p-out-string + "&":U
      669                               v-position   = v-position   + 1
      670                           .
      671                       end.
      672                   end.
      673                   else do:
      674                       assign
      675                           p-out-string = p-out-string + "&":U
      676                           v-position   = v-position   + 1
      677                       .
      678                   end.
      679               end.
      680               else do:
      681                   case substring( p-in-string, v-position + 1, 3 )
      682                   :
      683                       when "lt;":U
      684                       then do:
      685                           assign
      686                               p-out-string = p-out-string + "<":U
      687                               v-position   = v-position   + 3
      688                           .
      689                       end.
      690                       when "gt;":U
      691                       then do:
      692                           assign
      693                               p-out-string = p-out-string + ">":U
      694                               v-position   = v-position   + 3
      695                           .
      696                       end.
      697                       otherwise do:
      698                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      699                           then do:
      700                               assign
      701                                   p-out-string = p-out-string + "&":U
      702                                   v-position   = v-position   + 4
      703                               .
      704                           end.
      705                           else do:
      706                               case substring( p-in-string, v-position + 1, 5 )
      707                               :
      708                                   when "quot;":U
      709                                   then do:
      710                                       assign
      711                                           p-out-string = p-out-string + '"':U
      712                                           v-position   = v-position   + 5
      713                                       .
      714                                   end.
      715                                   when "apos;":U
      716                                   then do:
      717                                       assign
      718                                           p-out-string = p-out-string + "'":U
      719                                           v-position   = v-position   + 5
      720                                       .
      721                                   end.
      722                                   otherwise do:
      723                                       assign
      724                                           p-out-string = p-out-string + "&":U
      725                                       .
      726                                   end.
      727                               end case.
      728                           end.
      729                       end.
      730                   end case.
      731               end.
      732           end.
      733       end.
      734   end.
      735   end .
      736   procedure xmlchar-read-integer :
      737   define input parameter p-input-string      as character        no-undo.
      738   define output parameter p-output-integer   as integer          no-undo.
      739   define output parameter p-success       as logical          no-undo.
      740   do
      741   on error undo, return error
      742   :
      743       assign
      744           p-output-integer = integer( p-input-string )
      745       no-error.
      746       if error-status :error
      747       then do:
      748           assign
      749               p-success           = no
      750               p-output-integer    = 0
      751           .
      752       end.
      753       else do:
      754           assign
      755               p-success           = yes
      756           .
      757       end.
      758   end.
      759   end.
      760   define variable v-bgelib-bgeclall           as logical      no-undo.
      761   define variable v-bgelib-bgedict            as logical      no-undo.
      762   define temp-table temp_ext-doc-type no-undo
      763       field edt-key               as integer
      764       field ext-doc-type          as character
      765       field ext-doc-type-label    as character
      766       index pi is primary unique
      767           edt-key
      768   .
      769   define temp-table temp_bgelib_goods no-undo
      770       field gds-code as integer
      771       index pi is primary unique
      772           gds-code
      773   .
      774   define temp-table temp_bgelib_clients no-undo
      775       field obj-type as character
      776       field obj-code as integer
      777       index pi is primary unique
      778           obj-type
      779           obj-code
      780   .
      781   define temp-table temp_bgelib_dis-card no-undo
      782       field d-card as character
      783       index pi is primary unique
      784           d-card
      785   .
      786   define temp-table temp_bgelib_trn-doc no-undo
      787       field doc-code as integer
      788   .
      789   procedure bgelib-tag-open:
      790   do
      791   on error undo, return error
      792   :
      793   define input parameter v-tag-level  as integer      no-undo.
      794   define input parameter v-tag-name   as character    no-undo.
      795   define input parameter v-tag-value  as character    no-undo.
      796       put stream stmXMLOut unformatted
      797           chr(10)
      798           + fill(" ", 4 * v-tag-level)
      799           + "<" + v-tag-name
      800           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      801           + v-tag-value + ">"
      802       .
      803   end.
      804   end procedure.
      805   procedure bgelib-tag-put:
      806   do
      807   on error undo, return error
      808   :
      809   define input parameter v-tag-level      as integer      no-undo.
      810   define input parameter v-tag-name       as character    no-undo.
      811   define input parameter v-tag-value      as character    no-undo.
      812   define input parameter v-empty-mode     as integer      no-undo.
      813       v-tag-name = trim(v-tag-name).
      814       if  v-empty-mode = 1
      815       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      816       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      817       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      818       then do:
      819           run xmlchar-encode in this-procedure (
      820                 input v-tag-value
      821               , output v-tag-value
      822           ).
      823           put stream stmXMLOut unformatted
      824               chr(10) + fill(" ", 4 * v-tag-level)
      825                           + '<' + v-tag-name + '>'
      826                           + v-tag-value
      827                           + '</' + v-tag-name + '>'
      828           .
      829       end.
      830   end.
      831   end procedure.
      832   procedure bgelib-tag-close:
      833   do
      834   on error undo, return error
      835   :
      836   define input parameter v-tag-level as integer      no-undo.
      837   define input parameter v-tag-name  as character    no-undo.
      838       put stream stmXMLOut unformatted
      839           chr(10)
      840           + fill( " ", 4 * v-tag-level)
      841           + '</' + v-tag-name + '>'
      842       .
      843   end.
      844   end procedure.
      845   procedure bgelib-write-log:
      846   do
      847   on error undo, return error
      848   :
      849   define input parameter v-filename   as character    no-undo.
      850   define input parameter v-log-level  as integer      no-undo.
      851   define input parameter v-out-string as character    no-undo.
      852       output stream stmXMLLog to value( v-filename ) append.
      853       put stream stmXMLLog unformatted
      854           chr(10)
      855       .
      856       put stream stmXMLLog unformatted
      857           ( if v-log-level = 0
      858             or v-out-string = "&DLine"
      859             or v-out-string = "&Line"
      860             then ""
      861             else cur-time-string-sec() + " " )
      862       .
      863       put stream stmXMLLog unformatted
      864           ( if v-out-string = "&Line"
      865             then fill( "-", 80 )
      866             else if v-out-string = "&DLine"
      867                  then fill( "=", 80 )
      868                  else v-out-string )
      869       .
      870       output stream stmXMLLog close.
      871   end.
      872   end procedure.
      873   procedure bgelib-write-edt:
      874   do
      875   on error undo, return error
      876   :
      877   define input parameter v-editor-handle    as handle       no-undo.
      878   define input parameter v-log-level        as integer      no-undo.
      879   define input parameter v-out-string       as character    no-undo.
      880       if valid-handle ( v-editor-handle )
      881       then do:
      882           v-editor-handle :move-to-eof().
      883           v-editor-handle :insert-string( ( if v-log-level = 0
      884                                             or v-out-string = "&DLine"
      885                                             or v-out-string = "&Line"
      886                                             then ""
      887                                             else cur-time-string-sec() + " "
      888                                         ) ).
      889           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      890                                             then fill( "-", 80 )
      891                                             else if v-out-string = "&DLine" then fill("=", 80)
      892                                             else fill( " ", v-log-level) + v-out-string
      893                                         ) ).
      894           v-editor-handle :insert-string( chr(10) ).
      895       end.
      896       process events.
      897       output to 'bgescn.txt' append.
      898           put unformatted
      899               chr(10)
      900               string( ( if v-log-level = 0
      901                         or v-out-string = "&DLine"
      902                         or v-out-string = "&Line"
      903                         then ""
      904                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      905                     ) )
      906               string( ( if v-out-string = "&Line"
      907                         then fill( "-", 80 )
      908                         else if v-out-string = "&DLine"
      909                              then fill( "=", 80 )
      910                              else fill( " ", v-log-level ) + v-out-string
      911                     ) )
      912           .
      913       output close.
      914   end.
      915   end procedure.
      916   procedure bgelib-show-cnt:
      917   do
      918   on error undo, return error
      919   :
      920   define input parameter v-fillin-handle     as handle   no-undo.
      921       if valid-handle( v-fillin-handle )
      922       then do:
      923           assign
      924               v-fillin-handle :visible = true
      925           .
      926       end.
      927   end.
      928   end procedure.
      929   procedure bgelib-hide-cnt:
      930   do
      931   on error undo, return error
      932   :
      933   define input parameter v-fillin-handle     as handle   no-undo.
      934       if valid-handle( v-fillin-handle )
      935       then do:
      936           assign v-fillin-handle :visible = false.
      937       end.
      938   end.
      939   end procedure.
      940   procedure bgelib-write-cnt:
      941   do
      942   on error undo, return error
      943   :
      944   define input parameter v-fillin-handle    as handle       no-undo.
      945   define input parameter v-fillin-string    as character    no-undo.
      946       if valid-handle( v-fillin-handle )
      947       then do:
      948           assign
      949               v-fillin-handle :SCREEN-value = v-fillin-string
      950           .
      951       end.
      952   end.
      953   end procedure.
      954   procedure bgelib-write-header:
      955   do
      956   on error undo, return error
      957   :
      958   define input parameter p-first-file     as logical      no-undo.
      959   define input parameter p-xml-file-name  as character    no-undo.
      960   define input parameter p-list-file-name as character    no-undo.
      961   define input parameter p-file-number    as integer      no-undo.
      962   define input parameter p-have-prev      as logical      no-undo.
      963   define input parameter p-prev-filename  as character    no-undo.
      964   define input parameter p-obj-list       as character    no-undo.
      965   define input parameter p-doc-type-list  as character    no-undo.
      966   define input parameter p-parameter-list as character    no-undo.
      967       define variable v-counter    as integer        no-undo.
      968       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      969       put stream stmXMLOut unformatted
      970           "<?xml version='1.0' encoding='windows-1251'?>"
      971       .
      972       run bgelib-tag-open( input 0, input "root"  , input "" ).
      973       run bgelib-tag-open( input 0, input "header", input "" ).
      974       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      975       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      976       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      977       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      978       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      979       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      980       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      981       :
      982           run bgelib-tag-put(
      983                 input 1
      984               , input entry( 2 * v-counter, p-parameter-list )
      985               , input entry( 2 * v-counter + 1, p-parameter-list )
      986               , input 0
      987           ).
      988       end.
      989       run bgelib-tag-close( input 0, input "header" ).
      990       output stream stmXMLOut close.
      991       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      992       if p-first-file = yes
      993       then do:
      994           put stream stmXMLOut unformatted
      995               "<?xml version='1.0' encoding='windows-1251'?>"
      996           .
      997           run bgelib-tag-open( input 0, input "export", input "" ).
      998       end.
      999       run bgelib-tag-open( input 1, input "file", input "" ).
     1000       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1001       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1002       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1003       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1004       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1005       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1006       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1007       :
     1008           run bgelib-tag-put(
     1009                 input 2
     1010               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1011               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1012               , input 0
     1013           ).
     1014       end.
     1015       run bgelib-tag-close( input 1, input "file" ).
     1016       output stream stmXMLOut close.
     1017   end.
     1018   end procedure.
     1019   procedure bgelib-write-footer:
     1020   do
     1021   on error undo, return error
     1022   :
     1023   define input parameter p-last-file      as logical      no-undo.
     1024   define input parameter p-xml-file-name  as character    no-undo.
     1025   define input parameter p-list-file-name as character    no-undo.
     1026   define input parameter p-have-next      as logical      no-undo.
     1027   define input parameter p-next-file-name as character    no-undo.
     1028       define variable v-error-num     as integer           no-undo.
     1029       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1030       if p-have-next = yes
     1031       then do:
     1032           run bgelib-tag-open( input 0, input "footer", "" ).
     1033           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1034           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1035           run bgelib-tag-close( input 0, input "footer" ).
     1036       end.
     1037       run bgelib-tag-close( input 0, input "root" ).
     1038       output stream stmXMLOut close.
     1039       run bge/os_copy.p (
     1040             input "M"
     1041           , input p-xml-file-name + "tmp"
     1042           , input p-xml-file-name + "xml"
     1043           , output v-error-num
     1044       ).
     1045       if p-last-file = yes
     1046       then do:
     1047           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1048               run bgelib-tag-close( input 0, input "export" ).
     1049           output stream stmXMLOut close.
     1050           run bge/os_copy.p (
     1051                 input "M"
     1052               , input p-list-file-name + "tmp"
     1053               , input p-list-file-name + "xml"
     1054               , output v-error-num
     1055           ).
     1056       end.
     1057   end.
     1058   end procedure.
     1059   procedure bgelib-filename :
     1060   do
     1061   on error undo, return error
     1062   :
     1063   define input parameter p-prefix             as character    no-undo.
     1064   define output parameter p-xml-file-name     as character    no-undo.
     1065   define output parameter p-log-file-name     as character    no-undo.
     1066   define output parameter p-list-file-name    as character    no-undo.
     1067       define variable v-home-dir  as character    no-undo.
     1068       define variable v-error-num as integer      no-undo.
     1069       get-key-value section "BGE" key "outdir" value v-home-dir.
     1070       if v-home-dir = ?
     1071       then do:
     1072           message
     1073             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1074             skip(1)
     1075             skip "Обратитесь к администратору."
     1076           view-as alert-box error.
     1077           undo, return error .
     1078       end.
     1079       run gbl/dir-cre.p (
     1080           input v-home-dir
     1081       ) no-error.
     1082       if error-status :error
     1083       then do:
     1084           message
     1085             skip "Неверно задан каталог экспорта."
     1086             skip(1)
     1087             skip "Обратитесь к администратору."
     1088           view-as alert-box error.
     1089           undo, return error .
     1090       end.
     1091       run bge/genfname.p (
     1092             input v-home-dir
     1093           , input p-prefix
     1094           , input ""
     1095           , input "xml"
     1096           , input "tmp"
     1097           , output p-xml-file-name
     1098       ).
     1099       assign
     1100           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1101           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1102           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1103       .
     1104   end.
     1105   end procedure.
     1106   procedure bgelib-read-config :
     1107   do
     1108   on error undo, return error
     1109   :
     1110   define variable v-par-type as character     no-undo.
     1111     define variable v-param-type      as character  no-undo .
     1112     define variable v-value-character as character  no-undo .
     1113     define variable v-value-date      as date       no-undo .
     1114     define variable v-value-decimal   as decimal    no-undo .
     1115     define variable v-value-integer   as integer    no-undo .
     1116     define variable v-value-logical   as logical    no-undo .
     1117     define variable v-tth             as handle     no-undo .
     1118       assign
     1119           v-bgelib-bgeclall = no
     1120           v-bgelib-bgedict  = no
     1121       .
     1122       run adm/shattri.p ( input "get":U
     1123                         , input  '':u
     1124                         , input  0
     1125                         , input  'bge-export':U
     1126                         , input  'bgeclall':U
     1127                         , output v-value-character
     1128                         , output v-value-date
     1129                         , output v-value-decimal
     1130                         , output v-value-integer
     1131                         , output v-value-logical
     1132                         , output v-param-type
     1133                         , input-output table-handle v-tth
     1134                         ) no-error .
     1135       if error-status :error
     1136       then do:
     1137         assign
     1138           v-bgelib-bgeclall = no
     1139         .
     1140       end.
     1141       else do:
     1142         assign
     1143           v-bgelib-bgeclall = v-value-logical
     1144         .
     1145       end.
     1146       delete object v-tth.
     1147       run adm/shattri.p ( input "get":U
     1148                         , input  '':u
     1149                         , input  0
     1150                         , input  'bge-export':U
     1151                         , input  'bgedict':U
     1152                         , output v-value-character
     1153                         , output v-value-date
     1154                         , output v-value-decimal
     1155                         , output v-value-integer
     1156                         , output v-value-logical
     1157                         , output v-param-type
     1158                         , input-output table-handle v-tth
     1159                         ) no-error .
     1160       if error-status :error
     1161       then do:
     1162         assign
     1163           v-bgelib-bgedict = no
     1164         .
     1165       end.
     1166       else do:
     1167         assign
     1168           v-bgelib-bgedict = v-value-logical
     1169         .
     1170       end.
     1171       delete object v-tth.
     1172       run adm/shattri.p ( input "get":U
     1173                         , input  '':u
     1174                         , input  0
     1175                         , input  'bge-export':U
     1176                         , input  'bgefmt':U
     1177                         , output v-value-character
     1178                         , output v-value-date
     1179                         , output v-value-decimal
     1180                         , output v-value-integer
     1181                         , output v-value-logical
     1182                         , output v-param-type
     1183                         , input-output table-handle v-tth
     1184                         ) no-error .
     1185       if error-status :error
     1186       then do:
     1187         assign
     1188           v-bgelib-bgefmt  = "xml":U
     1189         .
     1190       end.
     1191       else do:
     1192         assign
     1193           v-bgelib-bgefmt  = v-value-character
     1194         .
     1195       end.
     1196       delete object v-tth.
     1197       run adm/shattri.p ( input "get":U
     1198                         , input  '':u
     1199                         , input  0
     1200                         , input  'bge-export':U
     1201                         , input  'bgeflold':U
     1202                         , output v-value-character
     1203                         , output v-value-date
     1204                         , output v-value-decimal
     1205                         , output v-value-integer
     1206                         , output v-value-logical
     1207                         , output v-param-type
     1208                         , input-output table-handle v-tth
     1209                         ) no-error .
     1210       if error-status :error
     1211       then do:
     1212         assign
     1213           v-bgelib-bgeflold  = "old":U
     1214         .
     1215       end.
     1216       else do:
     1217         assign
     1218           v-bgelib-bgeflold  = v-value-character
     1219         .
     1220       end.
     1221       delete object v-tth.
     1222   end.
     1223   end procedure.
     1224   procedure bgelib-check-file-size :
     1225   do
     1226   on error undo, return error
     1227   :
     1228   define input parameter p-out-filename   as character    no-undo.
     1229   define output parameter p-is-big        as logical      no-undo.
     1230       define variable v-current-position    as integer        no-undo.
     1231       assign
     1232           v-current-position = seek( stmXMLOut )
     1233       .
     1234       if v-current-position / 1024 / 1024  >= 100
     1235       then do:
     1236           assign
     1237               p-is-big = yes
     1238           .
     1239       end.
     1240   end.
     1241   end procedure.
     1242   procedure bgelib-init-ext-doc-type :
     1243       define variable v-counter    as integer      no-undo.
     1244       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1245   do
     1246   for buf_temp_ext-doc-type
     1247   on error undo, return error
     1248   :
     1249       empty temp-table buf_temp_ext-doc-type.
     1250       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1251       :
     1252           create buf_temp_ext-doc-type.
     1253           assign
     1254               buf_temp_ext-doc-type.edt-key               = v-counter
     1255               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1256               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1257           .
     1258       end.
     1259   end.
     1260   end procedure.
     1261   define new global shared variable g#lib-trn  as handle no-undo .
     1262   define new global shared variable g#lib-trn2 as handle no-undo .
     1263   define new global shared variable g#lib-trn3 as handle no-undo .
     1264   define new global shared variable g#lib-trn4 as handle no-undo .
     1265   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1266   procedure factord :
     1267     define input  parameter p-fact-date            as date    no-undo .
     1268     define input  parameter p-fact-time            as integer no-undo .
     1269     define input  parameter p-fact-num             as integer no-undo .
     1270     define input  parameter p-shift-date           as date    no-undo .
     1271     define input  parameter p-shift-num            as integer no-undo .
     1272     define input  parameter p-shift-on             as logical no-undo .
     1273     define output parameter p-fact-order           as decimal no-undo .
     1274     define output parameter p-shift-end-fact-order as decimal no-undo .
     1275     define output parameter p-day-end-fact-order   as decimal no-undo .
     1276     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1277     if p-fact-date = ?
     1278     then do:
     1279       return error "Не указана фактическая дата" .
     1280     end.
     1281     define variable v-fact-date-num as integer no-undo .
     1282     assign
     1283       v-fact-date-num = integer(p-fact-date)
     1284     .
     1285     if p-fact-num = ?
     1286     or p-fact-num = 0
     1287     then do:
     1288       return error "Не задан p-fact-num " + string(p-fact-num) .
     1289     end.
     1290     if p-fact-num < 0
     1291     then do:
     1292       return error "Отрицательный fact-num " + string(p-fact-num) .
     1293     end.
     1294     if p-fact-num >= 100000000
     1295     then do:
     1296       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1297     end.
     1298     if p-shift-on = true
     1299     then do:
     1300       if p-shift-date = ?
     1301       then do:
     1302         return error "Не задана дата смены" .
     1303       end.
     1304       if p-shift-num = ?
     1305       or p-shift-num = 0
     1306       then do:
     1307         return error "Не задан номер смены" .
     1308       end.
     1309     end.
     1310     else do:
     1311       assign
     1312         p-shift-date = p-fact-date
     1313         p-shift-num  = 24
     1314       .
     1315     end.
     1316     define variable v-shift-offset as integer no-undo .
     1317     if p-shift-date = p-fact-date
     1318     then do:
     1319       assign
     1320         v-shift-offset = 1
     1321       .
     1322     end.
     1323     if p-shift-date < p-fact-date
     1324     then do:
     1325       assign
     1326         v-shift-offset = 0
     1327       .
     1328     end.
     1329     if p-shift-date > p-fact-date
     1330     then do:
     1331       message
     1332         vss-workfile vss-revision vss-description skip
     1333         "Неправильная дата закрытия смены" skip
     1334         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1335         view-as alert-box error .
     1336       undo, return error
     1337         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1338           ,string(p-fact-date, '99/99/9999':U)
     1339           ,string(p-shift-date, '99/99/9999':U)
     1340           )
     1341       .
     1342     end.
     1343     if p-shift-num < 1
     1344     or p-shift-num > 24
     1345     then do:
     1346       message
     1347         vss-workfile vss-revision vss-description skip
     1348         "Неправильный номер смены" skip
     1349         "p-shift-num" p-shift-num skip
     1350         view-as alert-box error .
     1351       undo, return error return-value .
     1352     end.
     1353     assign
     1354       p-fact-order           = v-fact-date-num
     1355                              + v-shift-offset * 0.5
     1356                              + p-shift-num    * 0.02 - 0.01
     1357                              + p-fact-num     * 0.0000000001
     1358       p-shift-end-fact-order = v-fact-date-num
     1359                              + v-shift-offset * 0.5
     1360                              + p-shift-num    * 0.02
     1361       p-day-end-fact-order   = v-fact-date-num
     1362                              + 0.99
     1363     .
     1364     if p-fact-order           <= v-fact-date-num
     1365     or p-shift-end-fact-order <= v-fact-date-num
     1366     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1367     or p-shift-end-fact-order >= p-day-end-fact-order
     1368     then do:
     1369       message
     1370         vss-workfile vss-revision vss-description skip
     1371         "Внутренняя ошибка при генерации фактического номера" skip
     1372         "p-fact-date"            p-fact-date            skip
     1373         "p-fact-time"            p-fact-time            skip
     1374         "p-fact-num"             p-fact-num             skip
     1375         "p-shift-date"           p-shift-date           skip
     1376         "p-shift-num"            p-shift-num            skip
     1377         "p-shift-on"             p-shift-on             skip
     1378         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1379         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1380         "v-fact-date-num"        v-fact-date-num        skip
     1381         view-as alert-box error .
     1382       undo, return error return-value .
     1383     end.
     1384   end procedure.
     1385   procedure day-begin-fact-order :
     1386     define input  parameter p-fact-date            as date    no-undo .
     1387     define output parameter p-day-begin-fact-order as decimal no-undo .
     1388     do
     1389     on error undo, return error return-value
     1390     :
     1391       if p-fact-date = ?
     1392       then do:
     1393         assign
     1394           p-day-begin-fact-order = 0
     1395         .
     1396       end.
     1397       else do:
     1398         assign
     1399           p-day-begin-fact-order = integer(p-fact-date)
     1400         .
     1401       end.
     1402     end.
     1403   end procedure.
     1404   procedure factord-max-fact-order :
     1405     define output parameter p-max-fact-order as decimal   no-undo .
     1406     do
     1407     on error undo, return error return-value
     1408     :
     1409       run day-begin-fact-order in this-procedure
     1410         (input  date(1, 1, 5000)
     1411         ,output p-max-fact-order
     1412         ) .
     1413     end.
     1414   end procedure.
     1415   procedure factord-cut-archive :
     1416     define input  parameter p-obj-type             as character no-undo .
     1417     define input  parameter p-obj-code             as integer   no-undo .
     1418     define input  parameter p-fact-date            as date      no-undo .
     1419     define output parameter p-shift-on             as logical   no-undo .
     1420     define output parameter p-shift-date           as date      no-undo .
     1421     define output parameter p-shift-num            as integer   no-undo .
     1422     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1423     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1424     define variable v-fact-order as decimal   no-undo .
     1425     define buffer buf_shift-obj for ub.shift-obj .
     1426     do
     1427     on error undo, return error return-value
     1428     :
     1429   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1430   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1431     (input  p-obj-type
     1432     ,input  p-obj-code
     1433     ,input  'shift-on=request'
     1434     ,output p-shift-on
     1435     ) no-error .
     1436       if error-status :error
     1437       then do:
     1438         message
     1439           vss-workfile vss-revision vss-description skip
     1440           "Ошибка при определении атрибута объекта" skip
     1441           "Объект" p-obj-type p-obj-code skip
     1442           error-status :get-message(1) skip
     1443           return-value skip
     1444           view-as alert-box error .
     1445         undo, return error return-value .
     1446       end.
     1447       if p-shift-on = false
     1448       then do:
     1449         assign
     1450           p-shift-date               = ?
     1451           p-shift-num                = 0
     1452         .
     1453       end.
     1454       else do:
     1455         find first buf_shift-obj share-lock
     1456           where buf_shift-obj.obj-type   = p-obj-type
     1457             and buf_shift-obj.obj-code   = p-obj-code
     1458             and buf_shift-obj.shift-date > p-fact-date
     1459           use-index pi
     1460           no-error .
     1461         if not available buf_shift-obj
     1462         or buf_shift-obj.status_ <> 'зкр':U
     1463         then do:
     1464           message
     1465             vss-workfile vss-revision vss-description skip
     1466             "Невозможно вычислить последнюю смену" skip
     1467             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1468             "Объект" p-obj-type p-obj-code skip
     1469             "Дата" p-fact-date skip
     1470             view-as alert-box error .
     1471           undo, return error return-value .
     1472         end.
     1473         find last buf_shift-obj share-lock
     1474           where buf_shift-obj.obj-type = p-obj-type
     1475             and buf_shift-obj.obj-code = p-obj-code
     1476             and buf_shift-obj.shift-date <= p-fact-date
     1477           use-index pi
     1478           no-error .
     1479         if available buf_shift-obj
     1480         then do:
     1481           if  buf_shift-obj.status_ = 'зкр':U
     1482           then do:
     1483             assign
     1484               p-shift-date = buf_shift-obj.shift-date
     1485               p-shift-num  = buf_shift-obj.shift-num
     1486             .
     1487           end.
     1488           else do:
     1489             message
     1490               vss-workfile vss-revision vss-description skip
     1491               "Невозможно вычислить последнюю смену" skip
     1492               "Статус смены отличен от статуса" 'зкр':U skip
     1493               "Объект" p-obj-type p-obj-code skip
     1494               "Дата" p-fact-date skip
     1495               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1496               view-as alert-box error .
     1497             undo, return error return-value .
     1498           end.
     1499         end.
     1500         else do:
     1501           assign
     1502             p-shift-date = p-fact-date - 1
     1503             p-shift-num  = 1
     1504           .
     1505         end.
     1506       end.
     1507       run factord in this-procedure
     1508         (input  p-fact-date
     1509         ,input  1
     1510         ,input  1
     1511         ,input  p-shift-date
     1512         ,input  p-shift-num
     1513         ,input  p-shift-on
     1514         ,output v-fact-order
     1515         ,output p-shift-end-fact-order
     1516         ,output p-day-end-fact-order
     1517         ) no-error .
     1518       if error-status :error
     1519       then do:
     1520         message
     1521           vss-workfile vss-revision vss-description skip
     1522           "Ошибка при вызове процедуры factord"
     1523           error-status :get-message(1) skip
     1524           return-value skip
     1525           view-as alert-box error .
     1526         undo, return error return-value .
     1527       end.
     1528     end.
     1529   end procedure.
     1530   procedure factord-lock-shift :
     1531     define input  parameter p-obj-type  as character no-undo .
     1532     define input  parameter p-obj-code  as integer   no-undo .
     1533     define input  parameter p-fact-date as date      no-undo .
     1534     define parameter buffer buf_shift-obj for ub.shift-obj .
     1535     define variable v-shift-on      as logical   no-undo .
     1536     define variable v-extra-message as character no-undo .
     1537     define variable v-error as character no-undo .
     1538     do
     1539     on error undo, return error return-value
     1540     :
     1541   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1542   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1543     (input  p-obj-type
     1544     ,input  p-obj-code
     1545     ,input  'shift-on=request'
     1546     ,output v-shift-on
     1547     ) no-error .
     1548       if error-status :error
     1549       then do:
     1550         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1551         undo, return error v-error .
     1552       end.
     1553       if v-shift-on = true
     1554       then do:
     1555         find first buf_shift-obj share-lock
     1556           where buf_shift-obj.obj-type   = p-obj-type
     1557             and buf_shift-obj.obj-code   = p-obj-code
     1558             and buf_shift-obj.shift-date > p-fact-date
     1559           use-index pi
     1560           no-error .
     1561         if not available buf_shift-obj
     1562         or buf_shift-obj.status_ <> 'зкр':U
     1563         then do:
     1564           find last buf_shift-obj
     1565             where buf_shift-obj.obj-type = p-obj-type
     1566               and buf_shift-obj.obj-code = p-obj-code
     1567               and buf_shift-obj.status_  = 'зкр':U
     1568             use-index stts
     1569             no-error .
     1570           if available buf_shift-obj
     1571           then do:
     1572             assign
     1573               v-extra-message =
     1574                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1575                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1576                               )
     1577             .
     1578           end.
     1579           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1580           undo, return error v-error .
     1581         end.
     1582       end.
     1583     end.
     1584   end procedure.
     1585   procedure factord-end-day :
     1586     define input  parameter p-fact-date            as date    no-undo .
     1587     define output parameter p-day-end-fact-order   as decimal no-undo .
     1588     do
     1589     on error undo, return error return-value
     1590     :
     1591       if p-fact-date = ?
     1592       then do:
     1593         return error "Не указана фактическая дата" .
     1594       end.
     1595       assign
     1596         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1597       .
     1598     end.
     1599   end procedure.
     1600   procedure factord-to-date :
     1601     define input  parameter p-fact-order as decimal no-undo .
     1602     define output parameter p-fact-date  as date    no-undo .
     1603     define variable v-ref-date  as date      no-undo .
     1604     define variable v-ref-delta as integer   no-undo .
     1605     do
     1606     on error undo, return error return-value
     1607     :
     1608       if p-fact-order = ?
     1609       or p-fact-order = 0
     1610       then do:
     1611         return error "Не указан fact-order" .
     1612       end.
     1613       assign
     1614         v-ref-date  = date(1, 1, 2000)
     1615       .
     1616       assign
     1617         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1618       .
     1619       assign
     1620         p-fact-date = v-ref-date + v-ref-delta
     1621       .
     1622     end.
     1623   end procedure.
     1624   procedure factord-to-fact-num :
     1625     define input  parameter p-fact-order as decimal no-undo .
     1626     define output parameter p-fact-num   as integer no-undo .
     1627     define variable v-fact-order-trunc as decimal no-undo .
     1628     do
     1629     on error undo, return error return-value
     1630     :
     1631       if p-fact-order = ?
     1632       or p-fact-order = 0
     1633       then do:
     1634         return error "Не указан fact-order" .
     1635       end.
     1636       assign
     1637        v-fact-order-trunc = truncate(p-fact-order, 2)
     1638       .
     1639       assign
     1640         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1641       .
     1642     end.
     1643   end procedure.
     1644   procedure factord-to-shift-num :
     1645     define input  parameter p-fact-order as decimal no-undo .
     1646     define output parameter p-shift-num   as integer no-undo .
     1647     define variable  p-shift-numd  as decimal   no-undo .
     1648     define variable v-fact-order-trunc as decimal no-undo .
     1649     do
     1650     on error undo, return error return-value
     1651     :
     1652       if p-fact-order = ?
     1653       or p-fact-order = 0
     1654       then do:
     1655         return error "Не указан fact-order" .
     1656       end.
     1657       assign
     1658        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1659       .
     1660       if v-fact-order-trunc < 0.5 then do:
     1661         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1662       end.
     1663       assign
     1664         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1665         .
     1666        assign
     1667         p-shift-num = truncate (p-shift-numd , 0)
     1668       .
     1669     end.
     1670   end procedure.
     1671   do
     1672   on error undo, return error
     1673   :
     1674     define variable v-exists-operation          as logical       no-undo.
     1675     define variable v-doc-date        like ub.trn-doc.doc-date   no-undo.
     1676     define variable v-fact-date       like ub.trn-doc.fact-date  no-undo.
     1677     define variable v-doc-PS          like ub.trn-doc.PS         no-undo.
     1678     define variable v-host-code                 as integer       no-undo.
     1679     define variable v-base-code                 as integer       no-undo.
     1680     define variable v-base-abbr       like ub.currency.curr-abbr no-undo.
     1681     define variable v-base-name       like ub.currency.curr-name no-undo.
     1682     define variable v-last-file-position        as integer       no-undo.
     1683     define buffer buf_currency for ub.currency.
     1684       ASSIGN
     1685       v-exists-operation = NO.
     1686       .
     1687   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1688   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1689     (input  p-host-code
     1690     ,output v-base-code
     1691     )  .
     1692       find first buf_currency no-lock where
     1693                 buf_currency.curr-code = v-base-code no-error .
     1694       if available buf_currency then
     1695       assign
     1696       v-base-abbr = buf_currency.curr-abbr
     1697       v-base-name = buf_currency.curr-name
     1698       .
     1699       RUN bgelib-write-cnt( hCNT, "" ).
     1700       assign
     1701           p-last-xml-file-name = p-xml-file-name
     1702       .
     1703       run export-documents in this-procedure (
     1704             input p-obj-list
     1705           , input p-doc-type-list
     1706           , input p-parameter-list
     1707           , input p-xml-file-name
     1708           , input p-log-file-name
     1709           , input p-list-file-name
     1710           , input p-xml-file-number
     1711           , output p-last-xml-file-name
     1712           , output p-last-xml-file-number
     1713       ).
     1714   end.
     1715   procedure export-documents :
     1716   do
     1717   on error undo, return error
     1718   :
     1719     define input parameter p-obj-list               as character    no-undo.
     1720     define input parameter p-doc-type-list          as character    no-undo.
     1721     define input parameter p-parameter-list         as character    no-undo.
     1722     define input parameter p-xml-file-name          as character    no-undo.
     1723     define input parameter p-log-file-name          as character    no-undo.
     1724     define input parameter p-list-file-name         as character    no-undo.
     1725     define input parameter p-xml-file-number        as integer      no-undo.
     1726     define output parameter p-last-xml-file-name    as character    no-undo.
     1727     define output parameter p-last-xml-file-number  as integer      no-undo.
     1728     define variable v-exists-before as logical      no-undo.
     1729     define variable v-exists-after  as logical      no-undo.
     1730     define variable v-need-new-file  as logical     no-undo.
     1731     define variable v-need-disk-spc  as logical     no-undo.
     1732     define variable v-cancel         as logical     no-undo.
     1733     define variable v-prev-filename  as character   no-undo.
     1734     define variable v-void-string    as character   no-undo.
     1735   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1736     define variable v-doc-code      as character    no-undo.
     1737     define variable v-exch-abbr       like ub.currency.curr-abbr no-undo .
     1738     define variable v-exch-name       like ub.currency.curr-name no-undo .
     1739     define variable v-contr-abbr       like ub.currency.curr-abbr no-undo .
     1740     define variable v-contr-name       like ub.currency.curr-name no-undo .
     1741     define variable v-contract-prn-code like ub.contract.contract-prn-code no-undo .
     1742     define variable v-contract-date     like ub.contract.contract-date no-undo .
     1743     define buffer buf_fin-ob-tax          for ub.fin-ob-tax.
     1744     define buffer buf_fin-ob              for ub.fin-ob.
     1745     define buffer buf_fin-ob-before       for ub.fin-ob-before.
     1746     define buffer buf_fin-ob-tax-before          for ub.fin-ob-tax-before.
     1747     define buffer buf_fin-ob-trn          for ub.fin-ob-trn.
     1748     define buffer buf_fin-gds-part        for ub.fin-gds-part.
     1749     define buffer buf_fin-connect         for ub.fin-connect.
     1750     define buffer buf_contract for ub.contract.
     1751     assign
     1752         p-last-xml-file-name    = p-xml-file-name
     1753         p-last-xml-file-number  = p-xml-file-number
     1754     .
     1755     define variable v-date-1 as date   no-undo .
     1756     define variable v-date-2 as date   no-undo .
     1757     if p-fact-order-from = 0 then do:
     1758       v-date-1 = 01/01/1990.
     1759     end.
     1760     else do:
     1761     run factord-to-date ( input p-fact-order-from, output v-date-1) .
     1762     end.
     1763     if p-fact-order-to = 0 then do:
     1764       v-date-2 = 01/01/1990.
     1765     end.
     1766     else do:
     1767     run factord-to-date ( input p-fact-order-to, output v-date-2) .
     1768     end.
     1769     output stream stmxmlout to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1770     export-documents:
     1771     for each buf_fin-ob-before no-lock where
     1772             buf_fin-ob-before.host-code = p-host-code
     1773         AND buf_fin-ob-before.doc-date  >= v-date-1
     1774         AND buf_fin-ob-before.doc-date  <= v-date-2
     1775     on error undo, return error
     1776     :
     1777       if v-need-new-file = yes
     1778       then do:
     1779           output stream stmxmlout close.
     1780           assign
     1781               v-prev-filename = p-xml-file-name
     1782           .
     1783           run bgelib-filename in this-procedure (
     1784                 input "fin-ob-before"
     1785               , output p-xml-file-name
     1786               , output v-void-string
     1787               , output v-void-string
     1788           ).
     1789           run bgelib-write-footer in this-procedure (
     1790                 input no
     1791               , input v-prev-filename
     1792               , input p-list-file-name
     1793               , input yes
     1794               , input p-xml-file-name + "xml":U
     1795           ).
     1796           run bgelib-write-log in this-procedure (
     1797               input p-log-file-name
     1798               , input 1
     1799               , input substitute( "Данные выгружены в файл &1"
     1800                                       , replace( p-xml-file-name, "/", "\" ) + "xml"
     1801                               )
     1802           ).
     1803           assign
     1804               p-last-xml-file-number   = p-xml-file-number + 1
     1805               p-last-xml-file-name     = p-xml-file-name
     1806           .
     1807           run bgelib-write-header in this-procedure (
     1808                 input no
     1809               , input p-last-xml-file-name
     1810               , input p-list-file-name
     1811               , input p-last-xml-file-number
     1812               , input yes
     1813               , input v-prev-filename + "xml":U
     1814               , input p-obj-list
     1815               , input p-doc-type-list
     1816               , input p-parameter-list
     1817           ).
     1818           output stream stmxmlout to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1819           assign
     1820               v-need-new-file = no
     1821           .
     1822       end.
     1823       assign
     1824           v-doc-code = string(buf_fin-ob-before.before-code)
     1825       .
     1826       if not v-exists-operation
     1827       then do:
     1828           run bgelib-write-edt in this-procedure ( hEDT, 4, "Операция " + string( p-oper-name ) ).
     1829           run bgelib-write-log in this-procedure ( p-log-file-name, 0, "&Line" ).
     1830           run bgelib-write-log in this-procedure ( p-log-file-name, 1, "XML - Вывод операции " + string( p-oper-name )  ).
     1831           assign
     1832               v-exists-operation = yes
     1833           .
     1834       end.
     1835       assign
     1836       v-doc-code  = buf_fin-ob-before.before-code
     1837       v-doc-date  = buf_fin-ob-before.doc-date
     1838       v-fact-date = buf_fin-ob-before.fact-date
     1839       v-doc-PS    = buf_fin-ob-before.ps
     1840       .
     1841       run bgelib-write-cnt ( hcnt, "   " + string( v-doc-code ) + " от " + string( v-doc-date ) ) .
     1842       process events.
     1843   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1844   run bgelib-tag-open in this-procedure ( input 0, substitute("&1", 'fin-ob-before'),  "" ).
     1845   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DocID'),  input string(buf_fin-ob-before.before-code), input 1 ).
     1846   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DocID_FO'),  input string(buf_fin-ob-before.doc-code), input 1 ).
     1847   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'Status_'),  input string(buf_fin-ob-before.status_), input 1 ).
     1848   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'host'),  input string(buf_fin-ob-before.host-code), input 1 ).
     1849   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DateDoc'),  input string(buf_fin-ob-before.doc-date, '99.99.9999'), input 1 ).
     1850   if buf_fin-ob-before.fact-date <> ? then do:
     1851         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DateFact'),  input string(buf_fin-ob-before.fact-date, '99.99.9999'), input 1 ).
     1852   end.
     1853   if buf_fin-ob-before.pay-date <> ? then do:
     1854         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DatePay'),  input string(buf_fin-ob-before.pay-date, '99.99.9999'), input 1 ).
     1855   end.
     1856   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DocDBNum'),  input string(buf_fin-ob-before.user-db-num-doc), input 1 ).
     1857   if buf_fin-ob-before.fact-date <> ? then do:
     1858         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'FactDBNum'),  input string(buf_fin-ob-before.user-db-num-fact), input 1 ).
     1859   end.
     1860   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DocUserName'),  input string(buf_fin-ob-before.user-name-doc), input 1 ).
     1861   if buf_fin-ob-before.fact-date <> ? then do:
     1862         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'FactUserName'),  input string(buf_fin-ob-before.user-name-fact), input 1 ).
     1863   end.
     1864   find first buf_currency no-lock where
     1865             buf_currency.curr-code = buf_fin-ob-before.curr-code no-error .
     1866   if available buf_currency then
     1867   assign
     1868   v-exch-abbr = buf_currency.curr-abbr
     1869   v-exch-name = buf_currency.curr-name
     1870   .
     1871   else
     1872   assign
     1873   v-exch-abbr = "":U
     1874   v-exch-name = "":U
     1875   .
     1876   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sumDoc'),  input string(buf_fin-ob-before.sum-doc), input 1 ).
     1877   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'CrcCode'),  input string(buf_fin-ob-before.curr-code), input 1 ).
     1878   if v-exch-abbr <> "":U then do:
     1879   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'CrcAbbr'),  input string(v-exch-abbr), input 1 ).
     1880   end.
     1881   if v-exch-name <> "":U then do:
     1882   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'Crcname'),  input string(v-exch-name), input 1 ).
     1883   end.
     1884   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'CrcRate'),  input string(buf_fin-ob-before.exch-rate), input 1 ).
     1885   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'CrcScale'),  input string(buf_fin-ob-before.exch-scale), input 1 ).
     1886   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'actualCrcRate'),  input string(buf_fin-ob-before.actual-exch-rate), input 1 ).
     1887   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'actualCrcScale'),  input string(buf_fin-ob-before.actual-exch-scale), input 1 ).
     1888   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sumRubl'),  input string(buf_fin-ob-before.sum-rubl), input 1 ).
     1889   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sumBase'),  input string(buf_fin-ob-before.sum-base), input 1 ).
     1890   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'baseCrcCode'),  input string(v-base-code), input 1 ).
     1891   if v-base-abbr <> "":U then do:
     1892   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'baseCrcAbbr'),  input string(v-base-abbr), input 1 ).
     1893   end.
     1894   if v-base-name <> "":U then do:
     1895   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'baseCrcname'),  input string(v-base-name), input 1 ).
     1896   end.
     1897   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'baseCrcRate'),  input string(buf_fin-ob-before.base-rate), input 1 ).
     1898   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'baseCrcScale'),  input string(buf_fin-ob-before.base-scale), input 1 ).
     1899   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'actualBaseCrcRate'),  input string(buf_fin-ob-before.actual-base-rate), input 1 ).
     1900   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'actualBaseCrcScale'),  input string(buf_fin-ob-before.actual-base-scale), input 1 ).
     1901   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-tax-doc'),  input string(buf_fin-ob-before.sum-tax-doc), input 1 ).
     1902   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-tax-rubl'),  input string(buf_fin-ob-before.sum-tax-rubl), input 1 ).
     1903   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-tax-base'),  input string(buf_fin-ob-before.sum-tax-base), input 1 ).
     1904   if buf_fin-ob-before.contract-code <> 0 then do:
     1905     find first buf_contract no-lock where
     1906               buf_contract.contract-code = buf_fin-ob-before.contract-code no-error .
     1907     if available buf_contract then
     1908     assign
     1909     v-contract-prn-code = buf_contract.contract-prn-code
     1910     v-contract-date     = buf_contract.contract-date
     1911     .
     1912   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contractCode'),  input string(buf_fin-ob-before.contract-code), input 1 ).
     1913     if v-contract-prn-code <> "":U then do:
     1914               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contractNo'),  input string(v-contract-prn-code), input 1 ).
     1915     end.
     1916     if v-contract-date <> ? then do:
     1917               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contractDate'),  input string(v-contract-date, '99.99.9999'), input 1 ).
     1918     end.
     1919     find first buf_currency no-lock where
     1920               buf_currency.curr-code = buf_fin-ob-before.contract-curr no-error .
     1921     if available buf_currency then
     1922     assign
     1923     v-contr-abbr = buf_currency.curr-abbr
     1924     v-contr-name = buf_currency.curr-name
     1925     .
     1926     else
     1927     assign
     1928     v-contr-abbr = "":U
     1929     v-contr-name = "":U
     1930     .
     1931         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sumcontract'),  input string(buf_fin-ob-before.sum-contr), input 1 ).
     1932         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contractCrcCode'),  input string(buf_fin-ob-before.contract-curr), input 1 ).
     1933     if v-exch-abbr <> "":U then do:
     1934         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contractCrcAbbr'),  input string(v-contr-abbr), input 1 ).
     1935     end.
     1936     if v-exch-name <> "":U then do:
     1937         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contractCrcname'),  input string(v-contr-name), input 1 ).
     1938     end.
     1939         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contractCrcRate'),  input string(buf_fin-ob-before.contract-rate), input 1 ).
     1940         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'contractCrcScale'),  input string(buf_fin-ob-before.contract-scale), input 1 ).
     1941         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'actualContractCrcRate'),  input string(buf_fin-ob-before.actual-contract-rate), input 1 ).
     1942         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'actualContractCrcScale'),  input string(buf_fin-ob-before.actual-contract-scale), input 1 ).
     1943         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sumTaxContract'),  input string(buf_fin-ob-before.sum-tax-contract), input 1 ).
     1944   end.
     1945   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'payer'),  input string(buf_fin-ob-before.payer-type + string(buf_fin-ob-before.payer-code)), input 1 ).
     1946   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'payerName'),  input string(buf_fin-ob-before.payer-name), input 1 ).
     1947   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'receiver'),  input string(buf_fin-ob-before.receiver-type + string(buf_fin-ob-before.receiver-code)), input 1 ).
     1948   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'receiverName'),  input string(buf_fin-ob-before.receiver-name), input 1 ).
     1949   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'comment'),  input string(buf_fin-ob-before.PS), input 1 ).
     1950   run bgelib-tag-close in this-procedure ( input 0, substitute("&1", 'fin-ob-before')).
     1951   for each buf_fin-ob-tax-before no-lock
     1952       where buf_fin-ob-tax-before.before-code  = buf_fin-ob-before.before-code
     1953       AND   buf_fin-ob-tax-before.host-code = buf_fin-ob-before.host-code
     1954   on error undo, return error
     1955   :
     1956         run bgelib-tag-open in this-procedure ( input 0, substitute("&1", 'taxLineBefore'),  "" ).
     1957         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DocID'),  input string(buf_fin-ob-before.before-code), input 1 ).
     1958         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'taxLineNum'),  input string(buf_fin-ob-tax-before.line-num), input 1 ).
     1959         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineSumDoc'),  input string(buf_fin-ob-tax-before.sum-line-doc), input 1 ).
     1960         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineSumRubl'),  input string(buf_fin-ob-tax-before.sum-line-rubl), input 1 ).
     1961         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineSumBase'),  input string(buf_fin-ob-tax-before.sum-line-base), input 1 ).
     1962     if buf_fin-ob-before.contract-code <> 0 then do:
     1963               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineSumContr'),  input string(buf_fin-ob-tax-before.sum-line-contr), input 1 ).
     1964     end.
     1965         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineVatSumDoc'),  input string(buf_fin-ob-tax-before.sum-vat-line-doc), input 1 ).
     1966         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineVatSumRubl'),  input string(buf_fin-ob-tax-before.sum-vat-line-rubl), input 1 ).
     1967         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineVatSumBase'),  input string(buf_fin-ob-tax-before.sum-vat-line-base), input 1 ).
     1968     if buf_fin-ob-before.contract-code <> 0 then do:
     1969               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineVatSumContr'),  input string(buf_fin-ob-tax-before.sum-vat-line-contr), input 1 ).
     1970     end.
     1971         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineVat'),  input string(buf_fin-ob-tax-before.vat-pc), input 1 ).
     1972         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineWithVat'),  input string((if buf_fin-ob-tax-before.with-vat then "yes" else "no")), input 1 ).
     1973     if buf_fin-ob-tax-before.SLT-pc <> 0 then do:
     1974               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineSLTSumDoc'),  input string(buf_fin-ob-tax-before.sum-SLT-line-doc), input 1 ).
     1975               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineSLTSumRubl'),  input string(buf_fin-ob-tax-before.sum-SLT-line-rubl), input 1 ).
     1976               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineSLTSumBase'),  input string(buf_fin-ob-tax-before.sum-SLT-line-base), input 1 ).
     1977       if buf_fin-ob-before.contract-code <> 0 then do:
     1978                     run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineSLTSumContr'),  input string(buf_fin-ob-tax-before.sum-SLT-line-contr), input 1 ).
     1979       end.
     1980               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineSLT'),  input string(buf_fin-ob-tax-before.SLT-pc), input 1 ).
     1981               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineWithSLT'),  input string((if buf_fin-ob-tax-before.with-SLT then "yes" else "no")), input 1 ).
     1982     end.
     1983         run bgelib-tag-close in this-procedure ( input 0, substitute("&1", 'taxLineBefore')).
     1984   end.
     1985   for each buf_fin-ob-trn no-lock
     1986       where buf_fin-ob-trn.doc-code  = buf_fin-ob-before.before-code
     1987       AND   buf_fin-ob-trn.host-code = buf_fin-ob-before.host-code
     1988   on error undo, return error
     1989   :
     1990         run bgelib-tag-open in this-procedure ( input 0, substitute("&1", 'finObTrn'),  "" ).
     1991         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DocID'),  input string(buf_fin-ob-before.before-code), input 1 ).
     1992         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'TrnDocId'),  input string(buf_fin-ob-trn.trn-doc-code), input 1 ).
     1993     if buf_fin-ob-trn.ps <> "" then do:
     1994               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'Comment'),  input string(buf_fin-ob-trn.ps), input 1 ).
     1995     end.
     1996         run bgelib-tag-close in this-procedure ( input 0, substitute("&1", 'finObTrn')).
     1997   end.
     1998   for each buf_fin-gds-part no-lock
     1999       where buf_fin-gds-part.fin-ob-code  = buf_fin-ob-before.before-code
     2000       AND   buf_fin-gds-part.host-code = buf_fin-ob-before.host-code
     2001   on error undo, return error
     2002   :
     2003         run bgelib-tag-open in this-procedure ( input 0, substitute("&1", 'finParts'),  "" ).
     2004         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'DocID'),  input string(buf_fin-gds-part.fin-ob-code), input 1 ).
     2005         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'gds-code'),  input string(buf_fin-gds-part.gds-code), input 1 ).
     2006         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'doc-qnty'),  input string(buf_fin-gds-part.doc-qnty), input 1 ).
     2007         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'exch-rate'),  input string(buf_fin-gds-part.exch-rate), input 1 ).
     2008         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'exch-scale'),  input string(buf_fin-gds-part.exch-scale), input 1 ).
     2009         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'base-rate'),  input string(buf_fin-gds-part.base-rate), input 1 ).
     2010         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'base-scale'),  input string(buf_fin-gds-part.base-scale), input 1 ).
     2011         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'fact-date'),  input string(buf_fin-gds-part.fact-date, '99.99.9999'), input 1 ).
     2012     run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'fact-date'),  input string(buf_fin-gds-part.fact-date), input 1 ).
     2013         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'fact-qnty'),  input string(buf_fin-gds-part.fact-qnty), input 1 ).
     2014         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'fact-time'),  input string(buf_fin-gds-part.fact-time), input 1 ).
     2015         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'part-code'),  input string(buf_fin-gds-part.part-code), input 1 ).
     2016         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'in-code'),  input string(buf_fin-gds-part.in-code), input 1 ).
     2017         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'out-code'),  input string(buf_fin-gds-part.out-code), input 1 ).
     2018         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'object'),  input string(buf_fin-gds-part.obj-type + string(buf_fin-gds-part.obj-code)), input 1 ).
     2019         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'other-base'),  input string(buf_fin-gds-part.other-base), input 1 ).
     2020         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'other-contract'),  input string(buf_fin-gds-part.other-contract), input 1 ).
     2021         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'other-rubl'),  input string(buf_fin-gds-part.other-rubl), input 1 ).
     2022         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'road-tax-base'),  input string(buf_fin-gds-part.road-tax-base), input 1 ).
     2023         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'road-tax-contract'),  input string(buf_fin-gds-part.road-tax-contract), input 1 ).
     2024         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'road-tax-rubl'),  input string(buf_fin-gds-part.road-tax-rubl), input 1 ).
     2025         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'status_dop'),  input string(buf_fin-gds-part.status_dop), input 1 ).
     2026         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-base'),  input string(buf_fin-gds-part.sum-base), input 1 ).
     2027         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-contract'),  input string(buf_fin-gds-part.sum-contract), input 1 ).
     2028         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-rubl'),  input string(buf_fin-gds-part.sum-rubl), input 1 ).
     2029         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'transport-base'),  input string(buf_fin-gds-part.transport-base), input 1 ).
     2030         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'transport-contract'),  input string(buf_fin-gds-part.transport-contract), input 1 ).
     2031         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'transport-rubl'),  input string(buf_fin-gds-part.transport-rubl), input 1 ).
     2032         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'user-db-num'),  input string(buf_fin-gds-part.user-db-num), input 1 ).
     2033         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'user-name'),  input string(buf_fin-gds-part.user-name), input 1 ).
     2034         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'vat-pc'),  input string(buf_fin-gds-part.vat-pc), input 1 ).
     2035         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'vat-type'),  input string(buf_fin-gds-part.vat-type), input 1 ).
     2036         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'vat-rubl'),  input string(buf_fin-gds-part.vat-rubl), input 1 ).
     2037         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'vat-base'),  input string(buf_fin-gds-part.vat-base), input 1 ).
     2038         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'vat-contract'),  input string(buf_fin-gds-part.vat-contract), input 1 ).
     2039     if buf_fin-gds-part.SLT-pc <> 0 then do:
     2040               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'SLT-pc'),  input string(buf_fin-gds-part.SLT-pc), input 1 ).
     2041               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'SLT-type'),  input string(buf_fin-gds-part.SLT-type), input 1 ).
     2042               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'slt-rubl'),  input string(buf_fin-gds-part.slt-rubl), input 1 ).
     2043               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'slt-base'),  input string(buf_fin-gds-part.slt-base), input 1 ).
     2044               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'slt-contract'),  input string(buf_fin-gds-part.slt-contract), input 1 ).
     2045     end.
     2046         run bgelib-tag-close in this-procedure ( input 0, substitute("&1", 'finParts')).
     2047   end.
     2048       if v-last-file-position = 0
     2049       or seek( stmxmlout ) - v-last-file-position > 1048576
     2050       then do:
     2051         run gbl/chkfree.p (
     2052             input substring( p-xml-file-name, 1, 1 )
     2053             , input 200
     2054             , output v-need-disk-spc
     2055         ) .
     2056         if v-need-disk-spc = yes
     2057         then do:
     2058             run gbl/waitfrsp.w (
     2059                 input substring( p-xml-file-name, 1, 1 )
     2060                 , input 200
     2061                 , output v-cancel
     2062             ) .
     2063             if v-cancel = yes
     2064             then do:
     2065                 undo, return error.
     2066             end.
     2067         end.
     2068         assign
     2069             v-last-file-position = seek( stmxmlout )
     2070         .
     2071       end.
     2072       run bgelib-check-file-size in this-procedure (
     2073             input p-xml-file-name + "tmp"
     2074           , output v-need-new-file
     2075       ).
     2076     end.
     2077     output stream stmxmlout close.
     2078   end.
     2079   end procedure.
