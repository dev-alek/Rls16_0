        1   define input parameter parparentproc as widget-handle no-undo .
        2   define output parameter p-num as character no-undo format "X(20)" .
        3   define output parameter p-date as date no-undo .
        4   define output parameter p-ok as logical no-undo initial no .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Создание акта о передаче в магазин ЕГАИС".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define new global shared variable g#language as character no-undo .
      111   if g#language <> '' and g#language <> 'rus':U then do:
      112     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      113   end.
      114   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115     define variable v-cntxt-db-num        as integer   no-undo .
      116     define variable v-cntxt-userid        as character no-undo .
      117     define variable v-cntxt-level         as character no-undo .
      118     define variable v-cntxt-host-code-obj as integer   no-undo .
      119     define variable v-cntxt-obj-type      as character no-undo .
      120     define variable v-cntxt-obj-code      as integer   no-undo .
      121     define variable v-cntxt-db-num-obj    as integer   no-undo .
      122     define variable v-cntxt-is-admin      as logical   no-undo .
      123   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124     run mainmenu_getcntxt in parparentproc
      125       (output v-cntxt-db-num
      126       ,output v-cntxt-userid
      127       ,output v-cntxt-level
      128       ,output v-cntxt-host-code-obj
      129       ,output v-cntxt-obj-type
      130       ,output v-cntxt-obj-code
      131       ,output v-cntxt-db-num-obj
      132       ,output v-cntxt-is-admin
      133       ) .
      134   define buffer buf_clob-bind     for ub.clob-bind .
      135   define variable v-date              as character no-undo .
      136   DEFINE BUTTON b-cancel AUTO-END-KEY
      137        LABEL "Отмена"
      138        SIZE 15 BY 1.14
      139        BGCOLOR 8 .
      140   DEFINE BUTTON b-ok AUTO-GO
      141        LABEL "Ввод"
      142        SIZE 15 BY 1.14
      143        BGCOLOR 8 .
      144   DEFINE FRAME Dialog-Frame
      145        b-ok AT ROW 1.24 COL 2
      146        b-cancel AT ROW 1.24 COL 17
      147        p-num at row 2.5 col 2 format "X(20)"  label "Номер"
      148        p-date at row 2.5 col 32   label "Дата"
      149        SPACE(0.5) SKIP(0.5)
      150       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      151            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      152            TITLE "Акт о передаче продукции в торговый зал"
      153            DEFAULT-BUTTON b-ok CANCEL-BUTTON b-cancel WIDGET-ID 100.
      154   ASSIGN
      155          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      156          FRAME Dialog-Frame:HIDDEN           = TRUE.
      157   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      158   DO:
      159     APPLY "END-ERROR":U TO SELF.
      160   END.
      161   ON CHOOSE OF b-ok IN FRAME Dialog-Frame
      162   DO:
      163       assign
      164           p-num
      165           p-date
      166       .
      167       find first buf_clob-bind no-lock where buf_clob-bind.uniq-key-rec = p-num
      168                                          and buf_clob-bind.field-name_  = 'egais-tts':U no-error .
      169       if available buf_clob-bind then do :
      170           message "Акт с таким номером уже существует!" view-as alert-box .
      171           return no-apply .
      172       end.
      173       p-ok = yes .
      174   END.
      175   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      176   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      177   MAIN-BLOCK:
      178   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      179      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      180     assign v-date = substitute ("&1&2&3", string (day (now), "99"), string (month (now), "99"),substring (string(year (now)), 3,2)).
      181     assign
      182       p-num = "TTS-" + v-date + '-' + substring(v-cntxt-obj-type,1,1) + string(v-cntxt-obj-code) + '-' + string(int(TIME))
      183       p-date = TODAY
      184     .
      185     display p-num p-date with frame Dialog-Frame.
      186     enable  p-date with frame Dialog-Frame.
      187     RUN enable_UI.
      188     WAIT-FOR GO OF FRAME Dialog-Frame.
      189   END.
      190   RUN disable_UI.
      191   PROCEDURE disable_UI :
      192     HIDE FRAME Dialog-Frame.
      193   END PROCEDURE.
      194   PROCEDURE enable_UI :
      195     ENABLE b-ok b-cancel
      196         WITH FRAME Dialog-Frame.
      197     VIEW FRAME Dialog-Frame.
      198   END PROCEDURE.
