        1   block-level on error undo, throw.
        2   on write of ub.trn-doc override do: end.
        3   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: setbgedt.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: bge/setbgedt.p $":U .
        8   define variable vss-description as character no-undo init "Устанавливает дату в поле bge-date".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define input parameter p-table-name as character    no-undo.
       68   define input parameter p-doc-code   as character    no-undo.
       69   define input parameter p-cur-date   as date         no-undo.
       70       define buffer buf_trn-doc       for ub.trn-doc.
       71       define buffer buf_c-trn-doc     for ub.c-trn-doc.
       72       define buffer buf_price-doc     for ub.price-doc.
       73       define buffer buf_ord-doc       for ub.ord-doc.
       74       define variable v-err-message as character no-undo .
       75   do
       76   for buf_trn-doc
       77     , buf_c-trn-doc
       78     , buf_price-doc
       79     , buf_ord-doc
       80   on error undo, return error
       81   :
       82       case p-table-name
       83       :
       84           when 'trn-doc':U
       85           then do:
       86             find first buf_trn-doc exclusive-lock
       87               where buf_trn-doc.doc-code = p-doc-code
       88             no-wait
       89             no-error
       90             .
       91             if not available buf_trn-doc
       92             then do:
       93               if locked buf_trn-doc
       94               then do:
       95                 assign
       96                   v-err-message = substitute("&1 Документ &2 &3 заблокирован." , vss-workfile , p-table-name , p-doc-code )
       97                 .
       98               end.
       99               else do:
      100                 assign
      101                   v-err-message = substitute("&1 Документ &2 &3 не найден." , vss-workfile , p-table-name , p-doc-code )
      102                 .
      103               end.
      104               undo, return error v-err-message.
      105             end.
      106             assign
      107               buf_trn-doc.bge-date = p-cur-date
      108             .
      109           end.
      110           when 'c-trn-doc':U
      111           then do:
      112             for each buf_c-trn-doc exclusive-lock
      113               where buf_c-trn-doc.doc-code = p-doc-code
      114             :
      115               assign
      116                 buf_c-trn-doc.bge-date = p-cur-date
      117               .
      118             end.
      119           end.
      120           when 'price-doc':U
      121           then do:
      122             on write of ub.price-doc override do: end.
      123             find first buf_price-doc exclusive-lock
      124               where buf_price-doc.doc-num = p-doc-code
      125             no-wait
      126             no-error
      127             .
      128             if not available buf_price-doc
      129             then do:
      130               if locked buf_price-doc
      131               then do:
      132                 assign
      133                   v-err-message = substitute("&1 Документ &2 &3 заблокирован." , vss-workfile , p-table-name , p-doc-code )
      134                 .
      135               end.
      136               else do:
      137                 assign
      138                   v-err-message = substitute("&1 Документ &2 &3 не найден." , vss-workfile , p-table-name , p-doc-code )
      139                 .
      140               end.
      141               undo, return error v-err-message.
      142             end.
      143             assign
      144               buf_price-doc.bge-date = p-cur-date
      145             .
      146           end.
      147           when 'ord-doc':U
      148           then do:
      149             on write of ub.ord-doc override do: end.
      150             find first buf_ord-doc exclusive-lock
      151               where buf_ord-doc.doc-code = p-doc-code
      152             no-wait
      153             no-error
      154             .
      155             if not available buf_ord-doc
      156             then do:
      157               if locked buf_ord-doc
      158               then do:
      159                 assign
      160                   v-err-message = substitute("&1 Документ &2 &3 заблокирован." , vss-workfile , p-table-name , p-doc-code )
      161                 .
      162               end.
      163               else do:
      164                 assign
      165                   v-err-message = substitute("&1 Документ &2 &3 не найден." , vss-workfile , p-table-name , p-doc-code )
      166                 .
      167               end.
      168               undo, return error v-err-message.
      169             end.
      170             assign
      171               buf_ord-doc.bge-date = p-cur-date
      172             .
      173           end.
      174       end case.
      175   end.
