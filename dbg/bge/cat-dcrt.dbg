      969   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
      970                                             INPUT iFlagEmpty AS INTEGER).
      971       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
      972       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
      973           DO:
      974               IF iFlagEmpty = 0                           THEN RETURN "".
      975               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
      976               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
      977               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
      978               ELSE RETURN "".
      979           END.
      980       ELSE DO:
      981           run xmlchar-encode in this-procedure (
      982                 input sToPlace
      983               , output sToPlace
      984           ).
      985           ASSIGN
      986               sToPlace = sParName + '="' + sToPlace + '"'
      987           .
      988           RETURN sToPlace.
      989       END.
      990   END FUNCTION.
      991   function bge-xml-date returns character
      992   ( input p-date as date )
      993   :
      994     define variable v-date-str as character no-undo .
      995     run bge-xml-date-to-str in this-procedure ( input   p-date
      996                                               , output  v-date-str
      997                                               ) .
      998     return v-date-str.
      999   end function.
     1000   function bge-xml-str-date returns character
     1001   ( input p-date-str as character )
     1002   :
     1003     define variable v-date-str as character no-undo .
     1004     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1005                                                   , output  v-date-str
     1006                                                   ) .
     1007     return v-date-str.
     1008   end function.
     1009   function bge-xml-normalize-dec returns decimal
     1010   ( input p-val as decimal )
     1011   :
     1012     return (if p-val = ? then 0 else p-val) .
     1013   end function.
     1014   PROCEDURE wp-XMLTagOpen:
     1015   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1016   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1017   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1018       define variable v-out-string    as character    no-undo.
     1019   do
     1020   on error undo, return error
     1021   :
     1022       if v-bge-xml-bgefmt = "dbf":U
     1023       then do:
     1024       end.
     1025       else do:
     1026           assign
     1027               v-out-string = substitute( "&1&2<&3&4>"
     1028                                       , chr(10)
     1029                                       , fill( " ":U, 4 * iTagLevel)
     1030                                       , sTagName
     1031                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1032                               )
     1033           .
     1034           put stream stmXMLOut unformatted
     1035               v-out-string
     1036           .
     1037       end.
     1038   end.
     1039   END PROCEDURE.
     1040   PROCEDURE wp-XMLTagPut:
     1041     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1042     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1043     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1044     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1045       define variable v-out-string    as character    no-undo.
     1046   do
     1047   on error undo, return error
     1048   :
     1049       if v-bge-xml-bgefmt = "dbf":U
     1050       then do:
     1051           if v-bge-xml-dbf-file-name <> "":U
     1052           then do:
     1053               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1054               export stream stmXMLOut
     1055                   sTagName
     1056                   sParValue
     1057               .
     1058               output stream stmXMLOut close.
     1059           end.
     1060       end.
     1061       else do:
     1062           IF  iFlagEmpty = 1
     1063           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1064           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1065           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1066           THEN DO:
     1067               run xmlchar-encode in this-procedure (
     1068                   input sParValue
     1069                   , output sParValue
     1070               ).
     1071               assign
     1072                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1073                                               , chr(10)
     1074                                               , FILL(" ", 4 * iTagLevel)
     1075                                               , sTagName
     1076                                               , sParValue
     1077                               )
     1078               .
     1079               PUT STREAM stmXMLOut UNFORMATTED
     1080                   v-out-string
     1081               .
     1082           END.
     1083       end.
     1084   end.
     1085   END PROCEDURE.
     1086   PROCEDURE wp-XMLTagClose:
     1087   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1088   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1089       define variable v-out-string    as character    no-undo.
     1090   do
     1091   on error undo, return error
     1092   :
     1093       if v-bge-xml-bgefmt = "dbf":U
     1094       then do:
     1095       end.
     1096       else do:
     1097           assign
     1098               v-out-string = substitute( "&1&2</&3>"
     1099                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1100                                   , fill( " ", 4 * iTagLevel )
     1101                                   , sTagName
     1102                           )
     1103           .
     1104           PUT STREAM stmXMLOut UNFORMATTED
     1105               v-out-string
     1106           .
     1107       end.
     1108   end.
     1109   END PROCEDURE.
     1110   PROCEDURE wp-XMLWriteLog:
     1111     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1112     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1113     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1114   define variable v-str              as character no-undo .
     1115   define variable v-error-append     as logical   no-undo .
     1116   define variable v-error-append-msg as character no-undo .
     1117   assign
     1118     v-str = chr(10)
     1119             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1120             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1121     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1122     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1123     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1124   .
     1125   run bge/bge-log.p (input v-str) no-error .
     1126   if error-status:error then do:
     1127     assign
     1128       v-error-append     = yes
     1129       v-error-append-msg = return-value
     1130     .
     1131   end.
     1132   run gbl/fileapnd.p
     1133     ( input sFileName
     1134     , input v-str
     1135     , input 10
     1136     ) no-error .
     1137   if error-status:error then do:
     1138     assign
     1139       v-error-append     = yes
     1140       v-error-append-msg = substitute( "&1&2&3"
     1141                                       , v-error-append-msg
     1142                                       , chr(10)
     1143                                       , return-value
     1144                                       )
     1145     .
     1146   end.
     1147   if v-error-append
     1148   then do:
     1149     return error substitute( "&1" , v-error-append-msg ) .
     1150   end.
     1151   END PROCEDURE.
     1152   PROCEDURE wp-XMLWriteEDT:
     1153     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1154     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1155     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1156       if valid-handle ( hEDT )
     1157       then do:
     1158           hEDT :move-to-eof().
     1159           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1160                                           OR sToWrite = "&Line") THEN "" ELSE
     1161                                           cur-time-string-sec() + " ").
     1162           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1163                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1164                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1165           hEDT :insert-string(chr(10)).
     1166       end.
     1167       process events.
     1168       output to 'bgescn.txt' append.
     1169           put unformatted
     1170               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1171                                           OR sToWrite = "&Line") THEN "" ELSE
     1172                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1173               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1174                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1175                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1176           .
     1177       output close.
     1178   END PROCEDURE.
     1179   PROCEDURE wp-XMLShowCNT:
     1180     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1181       if valid-handle( hCNT )
     1182       then do:
     1183           ASSIGN hCNT :VISIBLE = TRUE.
     1184       end.
     1185   END PROCEDURE.
     1186   PROCEDURE wp-XMLHideCNT:
     1187     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1188       if valid-handle( hCNT )
     1189       then do:
     1190           ASSIGN hCNT :VISIBLE = FALSE.
     1191       end.
     1192   END PROCEDURE.
     1193   PROCEDURE wp-XMLWriteCNT:
     1194     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1195     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1196       if valid-handle( hCNT )
     1197       then do:
     1198           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1199       end.
     1200   END PROCEDURE.
     1201   procedure bge-xml-write-header:
     1202   do
     1203   on error undo, return error
     1204   :
     1205   define input parameter p-xml-file-name  as character        no-undo.
     1206   define input parameter p-doc-name       as character        no-undo.
     1207   define input parameter p-version        as character        no-undo.
     1208   define input parameter p-db-num         as integer          no-undo.
     1209   define input parameter p-date-from      as date             no-undo.
     1210   define input parameter p-shift-num-from as integer          no-undo.
     1211   define input parameter p-date-to        as date             no-undo.
     1212   define input parameter p-shift-num-to   as integer          no-undo.
     1213   define input parameter p-obj-list       as character        no-undo.
     1214   define input parameter p-doc-type-list  as character        no-undo.
     1215   define input parameter p-pay-code       as logical          no-undo.
     1216   define input parameter p-cst            as logical          no-undo.
     1217   define input parameter p-parts          as logical          no-undo.
     1218   define input parameter p-chk-pay-code   as logical          no-undo.
     1219   define input parameter p-pay-desk       as logical          no-undo.
     1220   define input parameter p-pay-desk-cards as logical          no-undo.
     1221   define input parameter p-deleted        as logical          no-undo.
     1222   define input parameter p-opened-docs    as logical          no-undo.
     1223   define variable v-out-string    as character    no-undo.
     1224   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1225   assign
     1226       v-out-string = substitute( "&1&2&3"
     1227                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1228                           , chr(10)
     1229                           , "<IBS_Trade_House>":U )
     1230   .
     1231   put stream stmXMLOut unformatted
     1232       v-out-string
     1233   .
     1234   run wp-XMLTagOpen(1, "header","").
     1235   if v-bge-xml-bgeflold = "oracle":u
     1236   then do:
     1237     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1238     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1239     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1240     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1241     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1242   end.
     1243   run wp-XMLTagOpen( 2, "manifest", "").
     1244   run wp-XMLTagOpen( 3, "document", "").
     1245   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1246   run wp-XMLTagput( 4, "description", "", 0).
     1247   run wp-XMLTagput( 4, "version", p-version, 0).
     1248   run wp-XMLTagclose( 3, "document" ).
     1249   run wp-XMLTagclose( 2, "manifest" ).
     1250   run wp-XMLTagclose( 1, "header" ).
     1251   run wp-XMLTagOpen(1, "options","").
     1252   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1253   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1254   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1255   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1256   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1257   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1258   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1259   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1260   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1261   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1262   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1263   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1264   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1265   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1266   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1267   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1268   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1269   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1270   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1271   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1272   run wp-XMLTagClose(1, "options").
     1273   run wp-XMLTagOpen( 1, "body", "" ).
     1274   output stream stmXMLOut close.
     1275   end.
     1276   end procedure.
     1277   procedure xml-bge-write-footer:
     1278   do
     1279   on error undo, return error return-value
     1280   :
     1281   define input parameter p-xml-file-name as character    no-undo.
     1282   define variable v-error-num     as integer           no-undo.
     1283   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1284   run wp-XMLTagClose( 1, "body" ).
     1285   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1286   output stream stmXMLOut close.
     1287   if v-bge-xml-bgeflold = "oracle":u
     1288   then do:
     1289     define variable v-tmp-file-name         as character no-undo .
     1290     define variable v-zip-file-name         as character no-undo .
     1291     define variable v-exch-file-name        as character no-undo .
     1292     define variable v-heap-file-name        as character no-undo .
     1293     define variable v-i                     as integer   no-undo .
     1294     define variable v-file-name             as character no-undo .
     1295     define variable v-arc                   as character no-undo .
     1296     define variable v-str                   as character no-undo .
     1297     define variable v-exch-tmp-file-name    as character no-undo .
     1298     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1299     define variable v-bge-xml-exch-dir      as character no-undo .
     1300     define variable v-bge-xml-heap-dir      as character no-undo .
     1301     define variable v-bge-xml-compress-heap as logical   no-undo .
     1302     define variable v-home-dir              as character no-undo .
     1303     define variable v-os-command            as character no-undo .
     1304     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1305     if v-home-dir = ?
     1306     then do:
     1307       undo, return error substitute( "&1&2&3"
     1308                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1309                                     , chr(10)
     1310                                     , "Обратитесь к администратору.":u
     1311                                     ).
     1312     end.
     1313     assign
     1314       v-home-dir = v-home-dir
     1315     .
     1316     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1317     if error-status :error
     1318     then do:
     1319       undo, return error substitute( "&1&2&3"
     1320                                     , "Неверно задан каталог экспорта.":u
     1321                                     , chr(10)
     1322                                     , "Обратитесь к администратору.":u
     1323                                     ).
     1324     end.
     1325     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1326     if v-bge-xml-exch-dir = ?
     1327     then do:
     1328       undo, return error substitute( "&1&2&3"
     1329                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1330                                     , chr(10)
     1331                                     , "Обратитесь к администратору.":u
     1332                                     ).
     1333     end.
     1334     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1335     if error-status :error
     1336     then do:
     1337       undo, return error substitute( "&1&2&3"
     1338                                     , "Неверно задан каталог экспорта (exch).":u
     1339                                     , chr(10)
     1340                                     , "Обратитесь к администратору.":u
     1341                                     ).
     1342     end.
     1343     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1344     if v-bge-xml-heap-dir = ?
     1345     then do:
     1346       undo, return error substitute( "&1&2&3"
     1347                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1348                                     , chr(10)
     1349                                     , "Обратитесь к администратору.":u
     1350                                     ).
     1351     end.
     1352     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1353     if error-status :error
     1354     then do:
     1355       undo, return error substitute( "&1&2&3"
     1356                                     , "Неверно задан каталог экспорта (heap).":u
     1357                                     , chr(10)
     1358                                     , "Обратитесь к администратору.":u
     1359                                     ).
     1360     end.
     1361     get-key-value section "BGE" key "heap-compress" value v-str.
     1362     assign
     1363       v-i = int(v-str)
     1364     no-error .
     1365     if v-i = ? or v-i = 0
     1366     then do:
     1367       assign
     1368         v-bge-xml-compress-heap = no
     1369       .
     1370     end.
     1371     else do:
     1372       assign
     1373         v-bge-xml-compress-heap = yes
     1374       .
     1375     end.
     1376     assign
     1377       v-arc = search( "exe/7za.exe":u )
     1378     .
     1379     if v-arc = ? or v-arc = ""
     1380     then do:
     1381       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1382     end.
     1383     assign
     1384       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1385       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1386       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1387       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1388       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1389       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1390       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1391     .
     1392     run gbl/del-file.p (input v-tmp-file-name) .
     1393     run gbl/del-file.p (input v-zip-file-name) .
     1394     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1395     if v-error-num > 0
     1396     then do:
     1397         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1398                                      , p-xml-file-name + "xm1":u
     1399                                      , v-tmp-file-name
     1400                                      , v-error-num
     1401                                      ).
     1402     end.
     1403     assign
     1404       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1405                                    , v-arc
     1406                                    , v-zip-file-name
     1407                                    , v-tmp-file-name
     1408                                    )
     1409     .
     1410     os-command silent value ( v-os-command ) .
     1411     run gbl/del-file.p (input v-heap-file-name) .
     1412     if v-bge-xml-compress-heap = no
     1413     then do:
     1414       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1415       if v-error-num > 0
     1416       then do:
     1417           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1418                                        , v-tmp-file-name
     1419                                        , v-heap-file-name
     1420                                        , v-error-num
     1421                                        ) .
     1422       end.
     1423     end.
     1424     else do:
     1425       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1426       if v-error-num > 0
     1427       then do:
     1428           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1429                                        , v-zip-file-name
     1430                                        , v-heap-file-name
     1431                                        , v-error-num
     1432                                        ) .
     1433       end.
     1434     end.
     1435     run gbl/del-file.p (input v-tmp-file-name) .
     1436     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1437     if error-status :error then do:
     1438       undo, return error substitute( "&1&2&3"
     1439                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1440                                     , chr(10)
     1441                                     , "Обратитесь к администратору."
     1442                                     ).
     1443     end.
     1444     run gbl/del-file.p (input v-exch-file-name) .
     1445     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1446     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1447     if v-error-num > 0
     1448     then do:
     1449       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1450                                     , v-zip-file-name
     1451                                     , v-exch-tmp-file-name
     1452                                     , v-error-num
     1453                                     ) .
     1454     end.
     1455     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1456     if v-error-num > 0
     1457     then do:
     1458       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1459                                     , v-exch-tmp-file-name
     1460                                     , v-exch-file-name
     1461                                     , v-error-num
     1462                                     ) .
     1463     end.
     1464     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1465   end.
     1466   else do:
     1467     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1468     if v-error-num > 0
     1469     then do:
     1470       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1471                                     , p-xml-file-name + "xm1"
     1472                                     , p-xml-file-name + "xml"
     1473                                     , v-error-num
     1474                                     ) .
     1475     end.
     1476   end.
     1477   if opsys = "unix"
     1478   then do:
     1479       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1480   end.
     1481   end.
     1482   end procedure.
     1483   procedure xml-bge-filename0:
     1484   define input parameter p-prefix   as character no-undo .
     1485   define input parameter p-name     as character no-undo .
     1486   define input parameter p-shared-process as logical no-undo .
     1487   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1488   define output parameter p-xml-file-name  as character no-undo .
     1489   // define output parameter p-fullfnamenoext as character no-undo .
     1490   define output parameter p-locked         as logical      no-undo.
     1491   define variable v-fullfnamenoext as character no-undo .
     1492   define variable v-fileext        as character no-undo .
     1493   define variable v-fullfname      as character no-undo .
     1494   define variable v-error-num      as integer   no-undo .
     1495   do
     1496   on error undo, return error
     1497   :
     1498     case v-bge-xml-bgeflold :
     1499       when "old" then do:
     1500         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1501         v-fileext       = ".xml":U .
     1502         v-fullfname     = v-fullfnamenoext + v-fileext .
     1503         p-xml-file-name = v-fullfname .
     1504         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1505         if v-error-num > 0 then do:
     1506           return error.
     1507         end.
     1508       end.
     1509       when "var" then do:
     1510         case p-prefix :
     1511           when "doc" then do:
     1512             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1513             v-fileext       = ".xml":U .
     1514             v-fullfname     = v-fullfnamenoext + v-fileext .
     1515             p-xml-file-name = v-fullfname .
     1516           end.
     1517           when "day" then do:
     1518             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1519             v-fileext       = ".xml":U .
     1520             v-fullfname     = v-fullfnamenoext + v-fileext .
     1521             p-xml-file-name = v-fullfname .
     1522           end.
     1523           otherwise do:
     1524             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1525             v-fileext       = ".xml":U .
     1526             v-fullfname     = v-fullfnamenoext + v-fileext .
     1527             p-xml-file-name = v-fullfname .
     1528           end.
     1529         end case.
     1530         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1531         if v-error-num > 0 then do:
     1532           return error.
     1533         end.
     1534       end.
     1535       when "new" then do:
     1536                   run bge/genfname.p (
     1537                       input p-home-dir
     1538                       , input p-prefix
     1539                       , input ""
     1540                       , input "xml"
     1541                       , input ""
     1542                       , output p-xml-file-name
     1543                   ).
     1544       end.
     1545       when "no-parameter" then do:
     1546         if p-shared-process then do:
     1547                       run bge/genfname.p (
     1548                           input p-home-dir
     1549                           , input "d"
     1550                           , input ""
     1551                           , input "xml"
     1552                           , input ""
     1553                           , output p-xml-file-name
     1554                       ).
     1555         end.
     1556         else do:
     1557           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1558           v-fileext       = ".xml":U .
     1559           v-fullfname     = v-fullfnamenoext + v-fileext .
     1560           p-xml-file-name = v-fullfname .
     1561           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1562           if v-error-num > 0 then do:
     1563             return error.
     1564           end.
     1565         end.
     1566       end.
     1567     end case.
     1568     assign
     1569       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1570       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1571     .
     1572   end .
     1573   end procedure .
     1574   procedure xml-bge-filename :
     1575   do
     1576   on error undo, return error
     1577   :
     1578   define input parameter p-prefix             as character    no-undo.
     1579   define input parameter p-name               as character    no-undo.
     1580   define input parameter p-shared-process     as logical      no-undo.
     1581   define output parameter p-xml-file-name     as character    no-undo.
     1582   define output parameter p-log-file-name     as character    no-undo.
     1583   define output parameter p-locked            as logical      no-undo.
     1584   define variable v-home-dir          as character no-undo .
     1585   define variable v-error-num         as integer   no-undo .
     1586   define variable v-bge-xml-heap-dir  as character no-undo .
     1587       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1588       if v-home-dir = ?
     1589       then do:
     1590           message
     1591             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1592             skip(1)
     1593             skip "Обратитесь к администратору."
     1594           view-as alert-box error.
     1595           undo, return error .
     1596       end.
     1597       if v-bge-xml-bgeflold <> "oracle"
     1598       then do:
     1599         assign
     1600             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1601         .
     1602       end.
     1603       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1604       if error-status :error
     1605       then do:
     1606           message
     1607             skip "Неверно задан каталог экспорта."
     1608             skip(1)
     1609             skip "Обратитесь к администратору."
     1610           view-as alert-box error.
     1611           undo, return error .
     1612       end.
     1613       if v-bge-xml-bgefmt = "dbf":U
     1614       then do:
     1615           assign
     1616               p-xml-file-name = v-home-dir
     1617               p-locked        = no
     1618           .
     1619       end.
     1620       else do:
     1621           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1622             output p-xml-file-name, output p-locked) .
     1623       end.
     1624       if v-bge-xml-bgeflold = "oracle"
     1625       then do:
     1626         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1627         if v-bge-xml-heap-dir = ?
     1628         then do:
     1629           undo, return error substitute( "&1&2&3"
     1630                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1631                                         , chr(10)
     1632                                         , "Обратитесь к администратору.":u
     1633                                         ).
     1634         end.
     1635         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1636         if error-status :error
     1637         then do:
     1638           undo, return error substitute( "&1&2&3"
     1639                                         , "Неверно задан каталог экспорта (heap).":u
     1640                                         , chr(10)
     1641                                         , "Обратитесь к администратору.":u
     1642                                         ).
     1643         end.
     1644         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1645           assign
     1646             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1647           .
     1648         end.
     1649         else do:
     1650           assign
     1651             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1652           .
     1653         end.
     1654       end.
     1655       else do:
     1656         assign
     1657             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1658         .
     1659       end.
     1660       assign
     1661          v-bge-xml-static-log-file-name = p-log-file-name
     1662       .
     1663   end.
     1664   end procedure.
     1665   procedure bge-xml-read-config :
     1666   do
     1667   on error undo, return error return-value
     1668   :
     1669   define input  parameter p-last-date as date      no-undo .
     1670   define input  parameter p-db-num    as integer   no-undo .
     1671       define variable v-bgeclall      as character     no-undo.
     1672       define variable v-bgedict       as character     no-undo.
     1673       define variable v-bgeshift      as character     no-undo.
     1674       define variable v-par-type      as character     no-undo.
     1675       define variable v-bgeflnm       as character     no-undo.
     1676       define variable v-bgecliiv      as character     no-undo .
     1677       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1678       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1679       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1680       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1681       define variable v-db-num-str    as character     no-undo .
     1682       define variable v-param-type      as character  no-undo .
     1683       define variable v-value-character as character  no-undo .
     1684       define variable v-value-date      as date       no-undo .
     1685       define variable v-value-decimal   as decimal    no-undo .
     1686       define variable v-value-integer   as integer    no-undo .
     1687       define variable v-value-logical   as logical    no-undo .
     1688       define variable v-tth             as handle      no-undo .
     1689       run adm/shattri.p ( input "get":U
     1690                         , input  '':u
     1691                         , input  0
     1692                         , input  'bge-export':U
     1693                         , input  'bgeclall':U
     1694                         , output v-bgecliiv
     1695                         , output v-value-date
     1696                         , output v-value-decimal
     1697                         , output v-value-integer
     1698                         , output v-value-logical
     1699                         , output v-param-type
     1700                         , input-output table-handle v-tth
     1701                         ) no-error .
     1702       if error-status :error
     1703       then do:
     1704         assign
     1705           v-bge-xml-bgecliiv = no
     1706         .
     1707       end.
     1708       else do:
     1709         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1710       end.
     1711       delete object v-tth.
     1712       assign
     1713           v-bge-xml-bgeclall = no
     1714           v-bge-xml-bgedict  = no
     1715       .
     1716       run adm/shattri.p ( input "get":U
     1717                         , input  '':u
     1718                         , input  0
     1719                         , input  'bge-export':U
     1720                         , input  'bgeclall':U
     1721                         , output v-value-character
     1722                         , output v-value-date
     1723                         , output v-value-decimal
     1724                         , output v-value-integer
     1725                         , output v-value-logical
     1726                         , output v-param-type
     1727                         , input-output table-handle v-tth
     1728                         ) no-error .
     1729       if error-status :error
     1730       then do:
     1731         assign
     1732           v-bge-xml-bgeclall = no
     1733         .
     1734       end.
     1735       else do:
     1736         assign
     1737           v-bge-xml-bgeclall = v-value-logical
     1738         .
     1739       end.
     1740       delete object v-tth.
     1741       run adm/shattri.p ( input "get":U
     1742                         , input  '':u
     1743                         , input  0
     1744                         , input  'bge-export':U
     1745                         , input  'bgedict':U
     1746                         , output v-value-character
     1747                         , output v-value-date
     1748                         , output v-value-decimal
     1749                         , output v-value-integer
     1750                         , output v-value-logical
     1751                         , output v-param-type
     1752                         , input-output table-handle v-tth
     1753                         ) no-error .
     1754       if error-status :error
     1755       then do:
     1756         assign
     1757           v-bge-xml-bgedict = no
     1758         .
     1759       end.
     1760       else do:
     1761         assign
     1762           v-bge-xml-bgedict = v-value-logical
     1763         .
     1764       end.
     1765       delete object v-tth.
     1766       run adm/shattri.p ( input "get":U
     1767                         , input  '':u
     1768                         , input  0
     1769                         , input  'bge-export':U
     1770                         , input  'bgefmt':U
     1771                         , output v-value-character
     1772                         , output v-value-date
     1773                         , output v-value-decimal
     1774                         , output v-value-integer
     1775                         , output v-value-logical
     1776                         , output v-param-type
     1777                         , input-output table-handle v-tth
     1778                         ) no-error .
     1779       if error-status :error
     1780       then do:
     1781         assign
     1782           v-bge-xml-bgefmt  = "xml":U
     1783         .
     1784       end.
     1785       else do:
     1786         assign
     1787           v-bge-xml-bgefmt  = v-value-character
     1788         .
     1789       end.
     1790       delete object v-tth.
     1791       run adm/shattri.p ( input "get":U
     1792                         , input  '':u
     1793                         , input  0
     1794                         , input  'bge-export':U
     1795                         , input  'bgeshift':U
     1796                         , output v-value-character
     1797                         , output v-value-date
     1798                         , output v-value-decimal
     1799                         , output v-value-integer
     1800                         , output v-value-logical
     1801                         , output v-param-type
     1802                         , input-output table-handle v-tth
     1803                         ) no-error .
     1804       if error-status :error
     1805       then do:
     1806         assign
     1807             v-bge-xml-shift-mode = no
     1808         .
     1809       end.
     1810       else do:
     1811         assign
     1812             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1813         .
     1814       end.
     1815       delete object v-tth.
     1816       run adm/shattri.p ( input "get":U
     1817                         , input  '':u
     1818                         , input  0
     1819                         , input  'bge-export':U
     1820                         , input  'bgeflold':U
     1821                         , output v-value-character
     1822                         , output v-value-date
     1823                         , output v-value-decimal
     1824                         , output v-value-integer
     1825                         , output v-value-logical
     1826                         , output v-param-type
     1827                         , input-output table-handle v-tth
     1828                         ) no-error .
     1829       if error-status :error
     1830       then do:
     1831         assign
     1832           v-bge-xml-bgeflold = "no-parameter":U
     1833         .
     1834       end.
     1835       else do:
     1836         assign
     1837           v-bge-xml-bgeflold  = v-value-character
     1838         .
     1839       end.
     1840       delete object v-tth.
     1841       assign
     1842         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1843         v-bge-xml-db-num-str  = v-db-num-str
     1844       .
     1845       if p-last-date <> ?
     1846       then do:
     1847           run adm/shattri.p ( input "get":U
     1848                             , input  '':u
     1849                             , input  0
     1850                             , input  'bge-export':U
     1851                             , input  'bgeflnm':U
     1852                             , output v-value-character
     1853                             , output v-value-date
     1854                             , output v-value-decimal
     1855                             , output v-value-integer
     1856                             , output v-value-logical
     1857                             , output v-param-type
     1858                             , input-output table-handle v-tth
     1859                             ) no-error .
     1860           if error-status :error
     1861           then do:
     1862             assign
     1863               v-bgeflnm = '':U
     1864             .
     1865           end.
     1866           else do:
     1867             assign
     1868               v-bgeflnm = v-value-character
     1869             .
     1870           end.
     1871           delete object v-tth.
     1872           if v-bge-xml-bgeflold = "var"
     1873           then do:
     1874               if v-bgeflnm = ?
     1875               or num-entries( v-bgeflnm ) < 2
     1876               then do:
     1877                   assign
     1878                       v-bge-xml-bgeflold = "new"
     1879                   .
     1880               end.
     1881               else do:
     1882                   assign
     1883                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1884                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1885                   .
     1886                   assign
     1887                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1888                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1889                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1890                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1891                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1892                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1893                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1894                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1895                   .
     1896               end.
     1897           end.
     1898       end.
     1899   end.
     1900   end procedure.
     1901   procedure bge-xml-get-ref-filename :
     1902   define input parameter p-in-file-name       as character        no-undo.
     1903   define output parameter p-home-dir          as character        no-undo.
     1904   define output parameter p-out-file-name     as character        no-undo.
     1905   define output parameter p-locked            as logical          no-undo.
     1906       define variable v-counter       as integer      no-undo.
     1907       define variable v-error-level   as integer      no-undo.
     1908   do
     1909   on error undo, return error
     1910   :
     1911       run bge/bge-ini.p (
     1912             input "bge"
     1913           , output p-home-dir
     1914       ).
     1915       if return-value <> "OK"
     1916       then do:
     1917           undo, return error.
     1918       end.
     1919       assign
     1920           p-home-dir = p-home-dir + "\dict":U
     1921       .
     1922       run bge/dir_cd.p (
     1923           input p-home-dir
     1924           , input "CA"
     1925       ).
     1926       if return-value = "ERROR"
     1927       then do:
     1928           undo, return error.
     1929       end.
     1930       assign
     1931           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     1932       .
     1933       assign
     1934           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     1935       .
     1936       wait-lock:
     1937       do v-counter = 1 TO 3
     1938       :
     1939           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     1940           if p-locked = no
     1941           then do:
     1942               leave wait-lock.
     1943           end.
     1944           else do:
     1945               readkey pause 1.
     1946           end.
     1947       END.
     1948       if p-locked = yes
     1949       then do:
     1950           undo, return error.
     1951       end.
     1952       run bge/os_copy.p (
     1953             input "D":U
     1954           , input p-out-file-name + "xml":U
     1955           , input "":U
     1956           , output v-error-level
     1957       ).
     1958       if v-error-level > 0
     1959       then do:
     1960           undo, return error.
     1961       end.
     1962   end.
     1963   end procedure.
     1964   procedure bge-xml-write-ref-header :
     1965   define input parameter p-bge-name as character        no-undo.
     1966   define input parameter p-file-name as character        no-undo.
     1967       define variable v-out-string    as character    no-undo.
     1968   do
     1969   on error undo, return error
     1970   :
     1971       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     1972       put stream stmXMLOut unformatted
     1973           "<?xml version='1.0' encoding='windows-1251'?>":U
     1974       .
     1975       assign
     1976           v-out-string = substitute( "&1&2"
     1977                               , chr(10)
     1978                               , "<IBS_Trade_House>":U )
     1979       .
     1980       put stream stmXMLOut unformatted
     1981           v-out-string
     1982       .
     1983       run wp-XMLTagOpen( 1, "header", "" ).
     1984       if v-bge-xml-bgeflold = "oracle":u
     1985       then do:
     1986         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1987         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1988         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1989         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1990         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1991       end.
     1992       else do:
     1993         run wp-XMLTagOpen( 2, "delivery", "" ).
     1994         run wp-XMLTagOpen( 3, "to", "" ).
     1995         run wp-XMLTagClose( 3, "to" ).
     1996         run wp-XMLTagOpen( 3, "from", "" ).
     1997         run wp-XMLTagClose( 3, "from" ).
     1998         run wp-XMLTagClose( 2, "delivery" ).
     1999       end.
     2000       run wp-XMLTagOpen( 2, "manifest", "" ).
     2001       run wp-XMLTagOpen( 3, "document", "" ).
     2002       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2003       run wp-XMLTagPut( 4, "description", "", 0 ).
     2004       run wp-XMLTagClose( 3, "document" ).
     2005       run wp-XMLTagClose( 2, "manifest" ).
     2006       run wp-XMLTagClose( 1, "header" ).
     2007       run wp-XMLTagOpen( 1, "body", "" ).
     2008   end.
     2009   end procedure.
     2010   procedure bge-xml-write-ref-footer :
     2011   define input parameter p-file-name as character        no-undo.
     2012       define variable v-error-level   as integer      no-undo.
     2013   do
     2014   on error undo, return error
     2015   :
     2016       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2017       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2018       output stream stmXMLOut close.
     2019       run bge/os_copy.p (
     2020             input "M":U
     2021           , input p-file-name + "xm1":U
     2022           , input p-file-name + "xml":U
     2023           , output v-error-level
     2024       ).
     2025       if v-error-level > 0
     2026       then do:
     2027           undo, return error.
     2028       end.
     2029   end.
     2030   end procedure.
     2031   procedure bge-xml-out-dir :
     2032   define output parameter p-out-dir       as character    no-undo.
     2033   define output parameter p-log-file-name as character    no-undo.
     2034   do
     2035   on error undo, return error
     2036   :
     2037       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2038       if p-out-dir = ?
     2039       then do:
     2040           message
     2041             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2042                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2043             skip(1)
     2044             skip "Обратитесь к администратору."
     2045           view-as alert-box error.
     2046           undo, return error .
     2047       end.
     2048       if v-bge-xml-bgeflold <> "oracle" then assign
     2049         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2050       .
     2051       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2052       if error-status :error  then do:
     2053           run wp-XMLWriteLog in this-procedure (
     2054                 input p-log-file-name
     2055               , input 0
     2056               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2057                                   , p-out-dir
     2058                                   , return-value
     2059                                   , trim( error-status :get-message( 1 ) )
     2060                                   )
     2061           ).
     2062           undo, return error.
     2063       end.
     2064       assign
     2065           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2066           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2067       .
     2068   end.
     2069   end procedure.
     2070   procedure bge-xml-out-dir2 :
     2071   define output parameter p-out-dir       as character    no-undo.
     2072   define output parameter p-out-dirR      as character    no-undo.
     2073   define output parameter p-log-file-name as character    no-undo.
     2074   do
     2075   on error undo, return error
     2076   :
     2077       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2078       if p-out-dir = ?
     2079       then do:
     2080           message
     2081             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2082                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2083             skip(1)
     2084             skip "Обратитесь к администратору."
     2085           view-as alert-box error.
     2086           undo, return error .
     2087       end.
     2088       if v-bge-xml-bgeflold <> "oracle" then assign
     2089             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2090             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2091         .
     2092       else p-out-dirR = p-out-dir .
     2093       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2094       if error-status :error  then do:
     2095           run wp-XMLWriteLog in this-procedure (
     2096                 input p-log-file-name
     2097               , input 0
     2098               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2099                                   , p-out-dir
     2100                                   , return-value
     2101                                   , error-status :get-message( 1 )
     2102                                   )
     2103           ).
     2104           undo, return error.
     2105       end.
     2106       if p-out-dirR <> p-out-dir then do:
     2107         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2108         if error-status :error then do:
     2109           run wp-XMLWriteLog in this-procedure (
     2110                 input p-log-file-name
     2111               , input 0
     2112               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2113                                   , p-out-dirR
     2114                                   , return-value
     2115                                   , error-status :get-message( 1 )
     2116                                   )
     2117           ).
     2118           p-out-dirR = p-out-dir .
     2119         end.
     2120       end .
     2121       assign
     2122         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2123         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2124       .
     2125   end.
     2126   end procedure.
     2127   procedure bge-xml-out-file :
     2128   do
     2129   on error undo, return error
     2130   :
     2131   define input parameter p-out-dir            as character        no-undo.
     2132   define input parameter p-prefix             as character        no-undo.
     2133   define input parameter p-sheduled           as logical          no-undo.
     2134   define output parameter p-xml-file-name     as character        no-undo.
     2135   define output parameter p-locked            as logical          no-undo.
     2136   define variable v-home-dir      as character     no-undo.
     2137   define variable v-error-num     as integer       no-undo.
     2138   define variable v-today             as date         no-undo.
     2139   define variable v-time              as integer      no-undo.
     2140       if v-bge-xml-bgefmt = "dbf":U
     2141       then do:
     2142           assign
     2143               p-xml-file-name = p-out-dir
     2144               p-locked        = no
     2145           .
     2146       end.
     2147       else do:
     2148           if v-bge-xml-bgeflold = "firm":U
     2149           then do:
     2150               run bge/genfname.p (
     2151                     input p-out-dir
     2152                   , input p-prefix
     2153                   , input "":U
     2154                   , input "arj":U
     2155                   , input "":U
     2156                   , output p-xml-file-name
     2157               ).
     2158           end.
     2159           else do:
     2160               run bge/genfname.p (
     2161                     input p-out-dir
     2162                   , input p-prefix
     2163                   , input "":U
     2164                   , input "xml":U
     2165                   , input "":U
     2166                   , output p-xml-file-name
     2167               ).
     2168           end.
     2169           assign
     2170               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2171               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2172           .
     2173       end.
     2174   end.
     2175   end procedure.
     2176   procedure bge-xml-init-ext-doc-type :
     2177       define variable v-counter    as integer      no-undo.
     2178       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2179   do
     2180   for buf_temp_ext-doc-type
     2181   on error undo, return error
     2182   :
     2183       empty temp-table buf_temp_ext-doc-type.
     2184       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2185       :
     2186           create buf_temp_ext-doc-type.
     2187           assign
     2188               buf_temp_ext-doc-type.edt-key               = v-counter
     2189               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2190               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2191           .
     2192       end.
     2193   end.
     2194   end procedure.
     2195   procedure bge-xml-get-decimal-shift-num :
     2196   define input parameter p-shift-date     as date             no-undo.
     2197   define input parameter p-shift-num      as integer          no-undo.
     2198   define output parameter p-shift-decimal as decimal          no-undo.
     2199   do
     2200   on error undo, return error
     2201   :
     2202       assign
     2203           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2204       .
     2205   end.
     2206   end procedure.
     2207   procedure bge-xml-ora-exp-filename :
     2208     define input  parameter p-table-name  as character no-undo .
     2209     define input  parameter p-doc-code    as character no-undo .
     2210     define input  parameter p-obj-code    as integer   no-undo .
     2211     define output parameter p-filename    as character no-undo .
     2212     define output parameter p-seq-num     as integer   no-undo .
     2213     define variable v-ora-exp-seq     as integer   no-undo .
     2214     define variable v-ora-exp-seq-str as character no-undo .
     2215     define variable v-home-dir        as character no-undo.
     2216   do
     2217   on error undo, return error return-value
     2218   :
     2219     if v-bge-xml-bgeflold = "oracle":u
     2220     then do:
     2221       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2222       if v-home-dir = ?
     2223       then do:
     2224         undo, return error substitute( "&1&2&3":U
     2225                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2226                                       , chr(10)
     2227                                       , "Обратитесь к администратору.":U
     2228                                       ).
     2229       end.
     2230       assign
     2231           v-home-dir = v-home-dir
     2232       .
     2233       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2234       if error-status :error
     2235       then do:
     2236         undo, return error substitute( "&1&2&3":U
     2237                                       , "Неверно задан каталог экспорта.":U
     2238                                       , chr(10)
     2239                                       , "Обратитесь к администратору.":U
     2240                                       ).
     2241       end.
     2242       assign
     2243         v-ora-exp-seq = ?
     2244       .
     2245       if  p-table-name <> ? and
     2246           p-doc-code <> ?
     2247       then do:
     2248         run bge/get-oesq.p ( input p-table-name
     2249                            , input p-doc-code
     2250                            , output v-ora-exp-seq
     2251                            ) no-error .
     2252         if error-status :error = yes
     2253         then do:
     2254           undo, return error return-value .
     2255         end.
     2256       end.
     2257       if v-ora-exp-seq = ?
     2258       then do:
     2259         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2260         if error-status :error
     2261         then do:
     2262           undo, return error return-value .
     2263         end.
     2264       end.
     2265       if p-table-name <> ? and
     2266          p-doc-code   <> ?
     2267       then do:
     2268         run bge/oesqdoc.p ( input p-table-name
     2269                           , input p-doc-code
     2270                           , input v-ora-exp-seq
     2271                           ) no-error .
     2272         if error-status :error = yes
     2273         then do:
     2274           undo, return error return-value .
     2275         end.
     2276       end.
     2277       assign
     2278         p-seq-num  = v-ora-exp-seq
     2279         p-filename = substitute("&1/&2-000_&3."
     2280                                , v-home-dir
     2281                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2282                                , string(v-ora-exp-seq , "999999999")
     2283                                )
     2284       .
     2285     end.
     2286   end.
     2287   end procedure.
     2288   procedure bge-xml-date-to-str :
     2289     define input  parameter p-date  as date      no-undo .
     2290     define output parameter p-str   as character no-undo .
     2291   do
     2292   on error undo, return error return-value
     2293   :
     2294     if p-date <> ?
     2295     then do:
     2296       assign
     2297         p-str = substitute( "&1-&2-&3"
     2298                           , string( year(p-date)  , "9999")
     2299                           , string( month(p-date) , "99"  )
     2300                           , string( day(p-date)   , "99"  )
     2301                           )
     2302       .
     2303     end.
     2304     else do:
     2305       assign
     2306         p-str = ?
     2307       .
     2308     end.
     2309   end.
     2310   end procedure.
     2311   procedure bge-xml-date-str-to-str :
     2312     define input  parameter p-date-str  as character no-undo .
     2313     define output parameter p-str       as character no-undo .
     2314     define variable v-date          as date      no-undo .
     2315     define variable v-date-valid    as logical   no-undo .
     2316     define variable v-error-message as character no-undo .
     2317   do
     2318   on error undo, return error return-value
     2319   :
     2320     assign
     2321       p-str = ?
     2322     .
     2323     if p-date-str = ? or p-date-str = ""
     2324     then do:
     2325       return .
     2326     end.
     2327     run strtdate in this-procedure ( input  p-date-str
     2328                                    , output v-date
     2329                                    , output v-date-valid
     2330                                    , output v-error-message
     2331                                    ).
     2332     if v-date-valid <> true
     2333     then do:
     2334       return .
     2335     end.
     2336     assign
     2337       p-str = substitute( "&1-&2-&3"
     2338                         , string( year(v-date)  , "9999")
     2339                         , string( month(v-date) , "99"  )
     2340                         , string( day(v-date)   , "99"  )
     2341                         )
     2342     .
     2343   end.
     2344   end procedure.
     2345   procedure bge-xml-fill-tt-bgecliiv :
     2346     define input  parameter p-str as character no-undo .
     2347     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2348     define buffer buf_clients             for ub.clients.
     2349     define variable v-i         as integer   no-undo .
     2350     define variable v-count     as integer   no-undo .
     2351     define variable v-cli-count as integer   no-undo .
     2352     define variable v-client    as character no-undo .
     2353     define variable v-obj-type  as character no-undo .
     2354     define variable v-obj-code  as integer   no-undo .
     2355   do
     2356   on error undo, return error return-value
     2357   :
     2358     empty temp-table buf_tt-bge-xml-bgecliiv.
     2359     assign
     2360       v-bge-xml-bgecliiv = no
     2361       v-cli-count        = num-entries(p-str,';')
     2362     .
     2363     if v-cli-count > 0
     2364     then do:
     2365       _cli-cycle:
     2366       do v-i = 1 to v-cli-count
     2367       :
     2368         assign
     2369           v-client = entry(v-i , p-str, ';')
     2370         .
     2371         if num-entries(v-client) <> 2
     2372         then do:
     2373           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2374         end.
     2375         assign
     2376           v-obj-type = entry(1, v-client)
     2377         .
     2378         assign
     2379           v-obj-code = integer(entry(2, v-client))
     2380         no-error .
     2381         if error-status :error
     2382         then do:
     2383           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2384         end.
     2385         find first buf_clients no-lock
     2386           where buf_clients.obj-type = v-obj-type
     2387             and buf_clients.obj-code = v-obj-code
     2388         no-error.
     2389         if not available buf_clients
     2390         then do:
     2391           next _cli-cycle.
     2392         end.
     2393         find first buf_tt-bge-xml-bgecliiv no-lock
     2394           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2395             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2396         no-error .
     2397         if available buf_tt-bge-xml-bgecliiv
     2398         then do:
     2399           next _cli-cycle.
     2400         end.
     2401         create buf_tt-bge-xml-bgecliiv.
     2402         assign
     2403           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2404           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2405         .
     2406       end.
     2407     end.
     2408     else do:
     2409       assign
     2410         v-bge-xml-bgecliiv = no
     2411       .
     2412       return .
     2413     end.
     2414     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2415     if available buf_tt-bge-xml-bgecliiv
     2416     then do:
     2417       assign
     2418         v-bge-xml-bgecliiv = yes
     2419       .
     2420     end.
     2421   end.
     2422   end procedure.
     2423   procedure bge-xml-resolve-ext-doc-type :
     2424     define input  parameter p-ext-doc-type      as character no-undo .
     2425     define input  parameter p-obj-type          as character no-undo .
     2426     define input  parameter p-obj-code          as integer   no-undo .
     2427     define output parameter p-out-ext-doc-type  as character no-undo .
     2428     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2429   do
     2430   on error undo, return error return-value
     2431   :
     2432     assign
     2433       p-out-ext-doc-type = p-ext-doc-type
     2434     .
     2435     if p-ext-doc-type <> 'ie':U
     2436     then do:
     2437       return .
     2438     end.
     2439     if v-bge-xml-bgecliiv = yes
     2440     then do:
     2441       find first buf_tt-bge-xml-bgecliiv no-lock
     2442         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2443           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2444       no-error .
     2445       if available buf_tt-bge-xml-bgecliiv
     2446       then do:
     2447         assign
     2448           p-out-ext-doc-type = 'iv':U
     2449         .
     2450       end.
     2451     end.
     2452   end.
     2453   end procedure.
     2454   procedure safe-wp-xmltagput :
     2455     define input  parameter pTagLevel   as integer   no-undo .
     2456     define input  parameter pTagName    as character no-undo .
     2457     define input  parameter pParValue   as character no-undo .
     2458     define input  parameter pFlagEmpty  as integer   no-undo .
     2459   do
     2460   on error undo, return error return-value
     2461   :
     2462     if v-bge-xml-bgeflold = "oracle":u
     2463     then do:
     2464       return .
     2465     end.
     2466     run wp-xmltagput in this-procedure ( input pTagLevel
     2467                                        , input pTagName
     2468                                        , input pParValue
     2469                                        , input pFlagEmpty
     2470                                        ).
     2471   end.
     2472   end procedure.
     2473   define input parameter p-mode           as character    no-undo.
     2474   define input parameter table for temp_bge-xml_dis-card .
     2475   define input parameter p-file-name      as character    no-undo.
     2476   do
     2477   on error undo, return error
     2478   :
     2479       define variable v-xml-file-name     as character            no-undo.
     2480       define variable v-log-file-name     as character            no-undo.
     2481       define buffer buf_dis-card      for ub.dis-card.
     2482       run bge/bge-head.p (
     2483             input "dict"
     2484           , input "dcard" + trim(p-file-name, ".")
     2485           , input "XML - Вывод справочника дисконтных карт"
     2486           , input no
     2487           , output v-xml-file-name
     2488           , output v-log-file-name
     2489       ) no-error.
     2490       if error-status :error
     2491       then do:
     2492           message
     2493           vss-workfile vss-revision vss-description
     2494           skip "Ошибка при создании файла выгрузки."
     2495           skip return-value
     2496           skip trim(error-status :get-message(1))
     2497               trim(error-status :get-message(2))
     2498               trim(error-status :get-message(3))
     2499           view-as alert-box error.
     2500           undo, return error .
     2501       end.
     2502       run bge-xml-write-header in this-procedure (
     2503             input v-xml-file-name
     2504           , input "dcard"
     2505           , input "15.0 " + replace( vss-revision + vss-date, "$", " " )
     2506           , input 0
     2507           , input ?
     2508           , input 0
     2509           , input ?
     2510           , input 0
     2511           , input "":U
     2512           , input "":U
     2513           , input no
     2514           , input no
     2515           , input no
     2516           , input no
     2517           , input no
     2518           , input no
     2519           , input no
     2520           , input no
     2521       ).
     2522       output stream stmxmlout to value( v-xml-file-name + "xm1" ) convert target "1251" append.
     2523       if lookup( "list":U, p-mode ) = 0
     2524       then do:
     2525           for each buf_dis-card no-lock
     2526           :
     2527               run write-dcard in this-procedure (
     2528                     input buf_dis-card.d-card
     2529                   , input v-xml-file-name
     2530                   , input v-log-file-name
     2531               ) no-error.
     2532               if error-status :error
     2533               then do:
     2534                   run wp-XMLWriteLog(
     2535                         input v-log-file-name
     2536                       , input 1
     2537                       , input substitute(  "*** ERR: *** Ошибка выгрузки дисконтной карты номер &1. &2. &3.", buf_dis-card.d-card, trim(error-status :get-message(1)), trim(error-status :get-message(2)) )
     2538                   ).
     2539               end.
     2540           end.
     2541       end.
     2542       else do:
     2543           for each temp_bge-xml_dis-card no-lock
     2544           :
     2545               run write-dcard in this-procedure (
     2546                     input temp_bge-xml_dis-card.d-card
     2547                   , input v-xml-file-name
     2548                   , input v-log-file-name
     2549               ) no-error.
     2550               if error-status :error
     2551               then do:
     2552                   run wp-XMLWriteLog(
     2553                         input v-log-file-name
     2554                       , input 1
     2555                       , input substitute(  "*** ERR: *** Ошибка выгрузки дисконтной карты номер &1. &2. &3.", temp_bge-xml_dis-card.d-card, trim(error-status :get-message(1)), trim(error-status :get-message(2)) )
     2556                   ).
     2557               end.
     2558           end.
     2559       end.
     2560       output stream stmxmlout close.
     2561       run xml-bge-write-footer in this-procedure (
     2562           input v-xml-file-name
     2563       ).
     2564   end.
     2565   procedure write-dcard :
     2566   do
     2567   on error undo, return error
     2568   :
     2569   define input parameter p-dcard          as character    no-undo.
     2570   define input parameter p-xml-file-name  as character    no-undo.
     2571   define input parameter p-log-file-name  as character    no-undo.
     2572       define variable v-xml-file-name     as character            no-undo.
     2573       define variable v-log-file-name     as character            no-undo.
     2574       define buffer buf_dis-card      for ub.dis-card.
     2575       find first buf_dis-card no-lock
     2576            where buf_dis-card.d-card = p-dcard
     2577       .
     2578   run wp-XMLTagOpen( input 2, input "dcard", input "").
     2579   run wp-XMLTagPut( input 3, "cardID"         , input buf_dis-card.d-card                      , input 0 ).
     2580   run wp-XMLTagPut( input 3, "cardNum"        , input string( buf_dis-card.card-num           ), input 0 ).
     2581   run wp-XMLTagPut( input 3, "sourceDCard"    , input string( buf_dis-card.sourced-card       ), input 0 ).
     2582   run wp-XMLTagPut( input 3, "validDate"      , input string( buf_dis-card.valid-date         ), input 0 ).
     2583   run wp-XMLTagPut( input 3, "cliType"        , input string( buf_dis-card.cli-type           ), input 0 ).
     2584   run wp-XMLTagPut( input 3, "cliCode"        , input string( buf_dis-card.cli-code           ), input 0 ).
     2585   run wp-XMLTagPut( input 3, "hostcode"       , input string( buf_dis-card.emitent-host-code  ), input 0 ).
     2586   run wp-XMLTagPut( input 3, "isCreditCard"   , input string( buf_dis-card.credit-card        ), input 0 ).
     2587   run wp-XMLTagPut( input 3, "creditLimit"    , input string( buf_dis-card.lim-kr             ), input 0 ).
     2588   run wp-XMLTagPut( input 3, "pcntDiscount"   , input string( buf_dis-card.d-pcnt             ), input 0 ).
     2589   run wp-XMLTagPut( input 3, "pcntDiscItog"   , input string( buf_dis-card.cash-d-pcnt        ), input 0 ).
     2590   run wp-XMLTagPut( input 3, "pcntDiscMethod" , input string( buf_dis-card.d-pcnt-method      ), input 0 ).
     2591   run wp-XMLTagPut( input 3, "issureCode"     , input string( buf_dis-card.issue-code         ), input 0 ).
     2592   run wp-XMLTagPut( input 3, "issureDate"     , input string( buf_dis-card.issue-date         ), input 0 ).
     2593   run wp-XMLTagPut( input 3, "saldoBase"      , input string( buf_dis-card.saldo-base         ), input 0 ).
     2594   run wp-XMLTagPut( input 3, "saldoRubl"      , input string( buf_dis-card.saldo-rubl         ), input 0 ).
     2595   run wp-XMLTagPut( input 3, "status"         , input string( buf_dis-card.status_            ), input 0 ).
     2596   run wp-XMLTagPut( input 3, "type"           , input string( buf_dis-card.type               ), input 0 ).
     2597   run wp-XMLTagClose( input 2, input "dcard" ).
     2598   end.
     2599   end procedure.
