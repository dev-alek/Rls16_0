      572   procedure xmlchar-decode :
      573   define input parameter p-in-string      as character        no-undo.
      574   define output parameter p-out-string    as character        no-undo.
      575       define variable v-position      as integer      no-undo.
      576       define variable v-last-position as integer      no-undo.
      577       define variable v-temp-integer  as integer      no-undo.
      578       define variable v-current-char  as character    no-undo.
      579       define variable v-next-char     as character    no-undo.
      580       define variable v-success       as logical      no-undo.
      581   do
      582   on error undo, return error
      583   :
      584       assign
      585           p-out-string = "":U
      586           v-position   = 0
      587       .
      588       replace-cycle:
      589       do while yes
      590       on error undo, return error
      591       :
      592           assign
      593               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      594           .
      595           if v-last-position <= v-position
      596           then do:
      597               if v-position = 0
      598               then do:
      599                   assign
      600                       p-out-string = p-in-string
      601                   .
      602               end.
      603               else do:
      604                   assign
      605                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      606                   .
      607               end.
      608               leave replace-cycle.
      609           end.
      610           else do:
      611               assign
      612                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      613                   v-position      = v-last-position
      614                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      615               .
      616               if v-current-char = "#":U
      617               then do:
      618                   assign
      619                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      620                   .
      621                   if v-last-position > 0
      622                   then do:
      623                       run xmlchar-read-integer in this-procedure
      624                        (
      625                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      626                           , output v-temp-integer
      627                           , output v-success
      628                       ).
      629                       if v-success = yes
      630                       and v-temp-integer >= 1
      631                       and v-temp-integer <= 255
      632                       then do:
      633                           assign
      634                               p-out-string = p-out-string + chr( v-temp-integer )
      635                               v-position   = v-last-position + 1
      636                           .
      637                       end.
      638                       else do:
      639                           assign
      640                               p-out-string = p-out-string + "&":U
      641                               v-position   = v-position   + 1
      642                           .
      643                       end.
      644                   end.
      645                   else do:
      646                       assign
      647                           p-out-string = p-out-string + "&":U
      648                           v-position   = v-position   + 1
      649                       .
      650                   end.
      651               end.
      652               else do:
      653                   case substring( p-in-string, v-position + 1, 3 )
      654                   :
      655                       when "lt;":U
      656                       then do:
      657                           assign
      658                               p-out-string = p-out-string + "<":U
      659                               v-position   = v-position   + 3
      660                           .
      661                       end.
      662                       when "gt;":U
      663                       then do:
      664                           assign
      665                               p-out-string = p-out-string + ">":U
      666                               v-position   = v-position   + 3
      667                           .
      668                       end.
      669                       otherwise do:
      670                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      671                           then do:
      672                               assign
      673                                   p-out-string = p-out-string + "&":U
      674                                   v-position   = v-position   + 4
      675                               .
      676                           end.
      677                           else do:
      678                               case substring( p-in-string, v-position + 1, 5 )
      679                               :
      680                                   when "quot;":U
      681                                   then do:
      682                                       assign
      683                                           p-out-string = p-out-string + '"':U
      684                                           v-position   = v-position   + 5
      685                                       .
      686                                   end.
      687                                   when "apos;":U
      688                                   then do:
      689                                       assign
      690                                           p-out-string = p-out-string + "'":U
      691                                           v-position   = v-position   + 5
      692                                       .
      693                                   end.
      694                                   otherwise do:
      695                                       assign
      696                                           p-out-string = p-out-string + "&":U
      697                                       .
      698                                   end.
      699                               end case.
      700                           end.
      701                       end.
      702                   end case.
      703               end.
      704           end.
      705       end.
      706   end.
      707   end .
      708   procedure xmlchar-read-integer :
      709   define input parameter p-input-string      as character        no-undo.
      710   define output parameter p-output-integer   as integer          no-undo.
      711   define output parameter p-success       as logical          no-undo.
      712   do
      713   on error undo, return error
      714   :
      715       assign
      716           p-output-integer = integer( p-input-string )
      717       no-error.
      718       if error-status :error
      719       then do:
      720           assign
      721               p-success           = no
      722               p-output-integer    = 0
      723           .
      724       end.
      725       else do:
      726           assign
      727               p-success           = yes
      728           .
      729       end.
      730   end.
      731   end.
      732   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      733   procedure strtdate :
      734     define input  parameter p-str         as character no-undo .
      735     define output parameter p-value       as date      no-undo .
      736     define output parameter p-data-valid  as logical   no-undo .
      737     define output parameter p-message     as character no-undo .
      738   do
      739   on error undo, return error return-value
      740   :
      741     define variable v-value       as date      no-undo .
      742     define variable v-i           as integer   no-undo .
      743     define variable v-num         as integer   no-undo .
      744     define variable v-delim       as character no-undo .
      745     define variable v-delim-list  as character no-undo .
      746     define variable v-day         as integer   no-undo .
      747     define variable v-month       as integer   no-undo .
      748     define variable v-year        as integer   no-undo .
      749     define variable v-day-str     as character no-undo .
      750     define variable v-month-str   as character no-undo .
      751     define variable v-year-str    as character no-undo .
      752     assign
      753       p-value       = ?
      754       p-data-valid  = false
      755     .
      756     if p-str = ?
      757     then do:
      758       assign
      759         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      760       .
      761       return .
      762     end.
      763     if p-str = ""
      764     then do:
      765       assign
      766         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      767       .
      768       return .
      769     end.
      770     if length(p-str)  > 10
      771     then do:
      772       assign
      773         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      774       .
      775       return .
      776     end.
      777     assign
      778       v-delim-list = '/,-,.':U
      779     .
      780     _delim:
      781     do v-i = 1 to num-entries( v-delim-list )
      782     :
      783       assign
      784         v-delim = entry( v-i , v-delim-list )
      785         v-num   = num-entries( p-str , v-delim )
      786       .
      787       if v-num <> 3
      788       then do:
      789         assign
      790           v-delim = ''
      791         .
      792       end.
      793       else do:
      794         leave _delim.
      795       end.
      796     end.
      797     if v-delim = ''
      798     then do:
      799       assign
      800         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      801       .
      802       return .
      803     end.
      804     assign
      805       v-day-str   = entry( 1, p-str , v-delim)
      806       v-month-str = entry( 2, p-str , v-delim)
      807       v-year-str  = entry( 3, p-str , v-delim)
      808     .
      809     if  length(v-day-str) > 2   or
      810         length(v-day-str) < 1   or
      811         length(v-month-str) > 2 or
      812         length(v-month-str) < 1 or
      813         (
      814           length(v-year-str) <> 2 and
      815           length(v-year-str) <> 4
      816         )
      817     then do:
      818       assign
      819         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      820       .
      821       return .
      822     end.
      823     if length( v-year-str ) = 2
      824     then do:
      825       assign
      826         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      827       .
      828     end.
      829     assign
      830       v-day   = integer( v-day-str )
      831       v-month = integer( v-month-str)
      832       v-year  = integer( v-year-str)
      833     no-error .
      834     if error-status :error
      835     then do:
      836       assign
      837         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      838       .
      839       return .
      840     end.
      841     if v-day < 1  or
      842        v-day > 31 or
      843        v-month < 1 or
      844        v-month > 12 or
      845        v-year < 0   or
      846        v-year > 5000
      847     then do:
      848       assign
      849         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      850       .
      851       return .
      852     end.
      853     assign
      854       v-value = date( v-month, v-day, v-year )
      855     no-error .
      856     if error-status :error
      857     then do:
      858       assign
      859         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      860       .
      861       return .
      862     end.
      863     assign
      864       p-value       = v-value
      865       p-data-valid  = true
      866     .
      867   end.
      868   end procedure.
      869   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
