      513   define new global shared variable g#attr-lib  as handle no-undo .
      514   define variable v-attr-lib-variable as handle no-undo .
      515   procedure ext-system-attr-code :
      516     define input  parameter p-code           as character no-undo .
      517     define output parameter p-type           as character no-undo .
      518     define output parameter p-format         as character no-undo .
      519     define output parameter p-label          as character no-undo .
      520     define output parameter p-user-can-edit  as logical   no-undo .
      521     define output parameter p-output-display as logical   no-undo .
      522     define output parameter p-other          as character no-undo .
      523     do
      524     on error undo, return error
      525     :
      526           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-code in g#attr-lib
      527         (input  p-code
      528         ,output p-type
      529         ,output p-format
      530         ,output p-label
      531         ,output p-user-can-edit
      532         ,output p-output-display
      533         ,output p-other
      534         ) no-error .
      535       if error-status :error
      536       then do:
      537         undo, return error return-value .
      538       end.
      539     end.
