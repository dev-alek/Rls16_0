      964   procedure esallatr-news :
      965     do
      966     on error undo, return error
      967     :
      968       define input  parameter p-code           as character no-undo .
      969       define output parameter p-news           as logical   no-undo .
      970       case p-code :
      971               when 'custom-pack-name':U then do:     assign     p-news = true.   end.
      972               when 'route-custom-pack-name':U then do:     assign     p-news = true.   end.
      973         otherwise do:
      974           undo, return error substitute("неизвестный атрибут ВС &1", p-code ).
      975         end.
      976       end.
      977     end.
      978   end procedure.
      979     define variable v-pack-num   as integer   no-undo .
      980     define variable v-pack-name  as character no-undo .
      981     define variable v-source-dir as character no-undo .
      982     define variable v-target-dir as character no-undo .
      983     define variable v-temp-dir   as character no-undo .
      984     define variable v-log-file-name as character no-undo .
      985     define variable v-list-file-name as character no-undo .
      986     define variable route-cnt       as integer no-undo .
      987     define variable rec-cnt         as integer no-undo .
      988     define variable qnty-of-cur-rec as integer no-undo .
      989     define variable v-max-pack-size as integer no-undo .
      990     define variable v-today        as date    no-undo .
      991     define variable v-time         as integer no-undo .
      992     define variable v-last-tbl-ord like ub.route.tbl-ord no-undo .
      993     define variable v-custom-pack-name as character no-undo .
      994     define variable v-custom-pack-flag as logical   no-undo .
      995     define buffer buf_sys-ctrl for ub.sys-ctrl .
      996     define buffer buf_ext-system   for ub.ext-system.
      997     define buffer buf_esys-route    for ub.esys-route.
      998     define buffer buf_esys-pck-sent for ub.esys-pck-sent .
      999     define buffer buf_esys-all-attr for ub.esys-all-attr.
     1000     define variable esys-attr-value  as character no-undo .
     1001     define variable esys-attr-exist  as logical   no-undo .
     1002     define variable db-esys-attr-exist as logical   no-undo .
     1003     define variable db-esys-attr-value as character no-undo .
     1004     define variable db-esys-attr-type  as character no-undo .
     1005     define variable v-gen-new-xpack as logical   no-undo .
     1006     define variable v-fst-pck      as integer   no-undo .
     1007     define variable v-success      as logical   no-undo .
     1008     define variable v-sys-key  as character no-undo .
     1009     define frame inf
     1010       p-esys-id   label "для ВС" format ">>>>>>>>9"
     1011       v-pack-num  label "Пакет N" format ">>>>>>>>9"
     1012       route-cnt   label "Основных записей"
     1013       rec-cnt     label "Привязанных"
     1014       with view-as dialog-box side-labels 1 columns three-d title "** Формирование пакета".
     1015     define variable mFrameView      as logical   no-undo init yes.
     1016     define variable mFramHandle as handle no-undo.
     1017     mFramHandle = frame inf:handle.
     1018     if  log-manager:logfile-name ne ?
     1019     then DO:
     1020         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameoxmError").
     1021         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameoxmError").
     1022     end.
     1023     mFrameView = not session:batch-mode and mFramHandle:visible.
     1024   do
     1025   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1026   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1027   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1028   :
     1029     if transaction then do:
     1030       message
     1031         vss-workfile vss-revision vss-description skip
     1032         substitute( "Вызов данной процедуры невозможен при наличии транзакции" )
     1033         view-as alert-box error
     1034       .
     1035       return error .
     1036     end.
     1037     assign
     1038       v-fst-pck = ?
     1039       p-err-gen-pack = 0
     1040       v-gen-new-xpack = false
     1041       p-cre-all-pck  = true
     1042     .
     1043   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     1044   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     1045     (output v-sys-key
     1046     ) no-error .
     1047     find first buf_ext-system no-lock where
     1048             buf_Ext-system.esys-id = p-esys-id
     1049         and buf_Ext-system.db-num = p-db-num.
     1050     v-success = no.
     1051     run bge/lockesys.p (
     1052         input buf_ext-system.esys-id
     1053       ,input buf_ext-system.db-num
     1054       ,buffer buf_ext-system
     1055       ,output v-success) no-error.
     1056     if error-status:error
     1057     or not v-success
     1058     then do:
     1059       run write-to-log in this-procedure ( substitute( "&1. &2", vss-workfile, return-value ) ).
     1060       return .
     1061     end.
     1062     if buf_ext-system.esys-status = integer( '-1':U )
     1063     then do:
     1064         run write-to-log in this-procedure  (
     1065              input substitute( "Подготовка таблиц выгрузки внешней системы '&1'...", buf_ext-system.esys-name )
     1066         ).
     1067         run initial-export in this-procedure ( input buf_ext-system.esys-id
     1068                                               ,input buf_Ext-system.db-num
     1069                                               ,input buf_ext-system.esys-name) no-error.
     1070         if error-status :error then do:
     1071           run write-to-log (
     1072                input substitute( "Ошибка при первоначальной выгрузке внешней системы '&1'...", buf_ext-system.esys-name )
     1073           ).
     1074           undo, return ''.
     1075         end.
     1076     end.
     1077     find last buf_esys-route no-lock
     1078       where buf_esys-route.esys-id = p-esys-id
     1079         and buf_esys-route.db-num = p-db-num
     1080         and buf_esys-route.esr-last-pack = -1
     1081       no-error
     1082     .
     1083     v-last-tbl-ord = if available buf_esys-route then buf_esys-route.esr-tbl-ord else 0 .
     1084     if mFrameView
     1085     then do:
     1086        view frame inf.
     1087        do with frame inf
     1088        :
     1089           assign
     1090           p-esys-id :screen-value   = string( p-esys-id, p-esys-id :format)
     1091        .
     1092        end.
     1093     end.
     1094         run ext-system-attr-exist (
     1095                             input p-esys-id
     1096                             ,input p-db-num
     1097                             ,input 'need-gen-new-xpack':U
     1098                             ,output db-esys-attr-exist
     1099                           ) no-error.
     1100         if error-status :error then do:
     1101           run write-to-log( substitute("&1. Ошибка при определении наличия атрибута формирования нового пакета для ВС &2"
     1102                                       ,vss-workfile
     1103                                       ,p-esys-id
     1104                                       )
     1105                           ) .
     1106           undo, return error.
     1107         end.
     1108         run ext-system-attr-value (
     1109                             input p-esys-id
     1110                             ,input p-db-num
     1111                             ,input 'need-gen-new-xpack':U
     1112                             ,output db-esys-attr-value
     1113                             ,output db-esys-attr-type
     1114                           ) no-error.
     1115         if error-status :error then do:
     1116           run write-to-log( substitute("&1. Ошибка при чтении атрибута формирования нового пакета для ВС &2"
     1117                                       ,vss-workfile
     1118                                       ,p-esys-id
     1119                                       )
     1120                           ) .
     1121           undo, return error.
     1122         end.
     1123     gen-pack:
     1124     do while p-err-gen-pack = 0
     1125     on error undo, return error
     1126     :
     1127       find first buf_esys-route share-lock
     1128         where buf_esys-route.esys-id = p-esys-id
     1129           and buf_esys-route.db-num = p-db-num
     1130           and buf_esys-route.esr-last-pack = -1
     1131         no-wait
     1132         no-error
     1133       .
     1134       if available buf_esys-route
     1135       and (buf_esys-route.esr-action = 'command-bush':U
     1136       or  buf_esys-route.esr-action = 'command-pbush':U)
     1137       then do:
     1138         esys-attr-value = "yes":U.
     1139       end.
     1140       else do:
     1141         esys-attr-exist = db-esys-attr-exist .
     1142         esys-attr-value = db-esys-attr-value .
     1143       end.
     1144       v-custom-pack-name = ''.
     1145       if ( available buf_esys-route
     1146            and buf_esys-route.esr-tbl-ord <= v-last-tbl-ord
     1147          )
     1148         or (esys-attr-exist = false and available buf_esys-route)
     1149         or esys-attr-value = "yes":U
     1150       then do:
     1151         assign
     1152           v-pack-num     = -1
     1153           v-gen-new-xpack = true
     1154         .
     1155         if buf_ext-system.delivery-method = integer('1':U)
     1156         or buf_ext-system.delivery-method = integer('3':U)
     1157         or buf_ext-system.delivery-method = integer('5':U)
     1158             or buf_ext-system.whole-send-news = integer('9':U)
     1159         then do:
     1160           find first buf_esys-all-attr share-lock where
     1161                   buf_esys-all-attr.attr-code = 'route-custom-pack-name':U
     1162               and buf_esys-all-attr.table-name = 'esys-route':U
     1163               and buf_esys-all-attr.key1 = buf_esys-route.esr-dump-ord
     1164               and buf_esys-all-attr.key2 = buf_esys-route.esys-id
     1165               and buf_esys-all-attr.key5 = buf_esys-route.db-num
     1166                no-error.
     1167           if available buf_esys-all-attr then do:
     1168             v-custom-pack-name = buf_esys-all-attr.attr-value.
     1169           end.
     1170         end.
     1171         run ext-system-attr-write (
     1172                            input p-esys-id
     1173                           ,input p-db-num
     1174                           ,input 'need-gen-new-xpack':U
     1175                           ,input "no":U
     1176                           ) no-error.
     1177         if error-status :error then do:
     1178           run write-to-log( vss-workfile + chr(32)
     1179                             + "Ошибка записи атрибута формирования нового пакета для ВС" + chr(32)
     1180                             + string( p-esys-id )
     1181                           ) .
     1182           assign
     1183             p-err-gen-pack = 2
     1184           .
     1185           undo, return error.
     1186         end.
     1187       end.
     1188       else do:
     1189         if v-gen-new-xpack = false then do:
     1190           run write-to-log( substitute( "Нет новой информации для отправки в ВС &1", p-esys-id ) ) .
     1191         end.
     1192         leave gen-pack .
     1193       end.
     1194       run bge/espcknum.p // 28/X-2018 - v-source-dir и v-target-dir не используются;
     1195                          // 12/VIII-2019 - v-temp-dir, v-log-file-name, v-list-file-name не используются
     1196         ( input "put":U
     1197          ,input p-esys-id
     1198          ,input p-db-num
     1199          ,input buf_ext-system.delivery-method
     1200          ,input oxml-exch-dir
     1201          ,input oxml-heap-dir
     1202          ,input ""
     1203          ,input-output v-pack-num
     1204          ,input-output v-custom-pack-name
     1205          ,output v-pack-name
     1206          ,output v-source-dir
     1207          ,output v-target-dir
     1208          ,output v-temp-dir
     1209          ,output v-log-file-name
     1210          ,output v-list-file-name
     1211          ,output v-custom-pack-flag
     1212         ) no-error.
     1213       if error-status:error then do:
     1214         run write-to-log( vss-workfile + chr(32)
     1215                           + "Ошибка при генерации номера пакета." + chr(10)
     1216                           + substitute( "&1", error-status:get-message(error-status:num-messages) ) + chr(10)
     1217                           + substitute( "&1", return-value )
     1218                         ) .
     1219         undo, return error.
     1220       end.
     1221       if v-fst-pck = ? then do:
     1222         assign
     1223           v-fst-pck = v-pack-num
     1224         .
     1225       end.
     1226       else do:
     1227         if v-pack-num = v-fst-pck + 30
     1228         or (buf_ext-system.delivery-method = integer('11':U) and v-pack-num = v-fst-pck + 1)
     1229         then do:
     1230           assign
     1231             p-cre-all-pck = false
     1232           .
     1233           leave gen-pack .
     1234         end.
     1235       end.
     1236       if mFrameView
     1237       then do with frame inf
     1238       :
     1239         assign
     1240           p-esys-id :screen-value   = string( p-esys-id, p-esys-id :format)
     1241           v-pack-num :screen-value = string( v-pack-num, v-pack-num :format)
     1242         .
     1243       end.
     1244       run write-to-log( substitute("Подготовка пакета N &1 для ВС N &2", v-pack-num, p-esys-id ) ).
     1245       find first buf_ext-system
     1246         where buf_ext-system.esys-id = p-esys-id
     1247           and buf_ext-system.db-num = p-db-num
     1248         no-error
     1249       .
     1250       if not available buf_ext-system then do:
     1251         run write-to-log( substitute( "&1. Подготовка пакета прервана. ВС &2 не найдена.", vss-workfile, p-esys-id ) ).
     1252         assign
     1253           p-err-gen-pack = 2
     1254         .
     1255         undo, return error.
     1256       end.
     1257       assign
     1258       v-max-pack-size = 10000
     1259       .
     1260       run cur-time( output v-today
     1261                    ,output v-time
     1262                   ) no-error .
     1263       if error-status :error then do:
     1264         run write-to-log( vss-workfile + chr(32) + "Ошибка при определении текущей даты!" ) .
     1265         assign
     1266           p-err-gen-pack = 2
     1267         .
     1268         undo, return error.
     1269       end.
     1270       find first buf_esys-pck-sent no-lock
     1271         where buf_esys-pck-sent.esys-id   = p-esys-id
     1272            and buf_esys-pck-sent.db-num   = p-db-num
     1273           and buf_esys-pck-sent.esps-pack-num = v-pack-num
     1274         no-error
     1275       .
     1276       if available buf_esys-pck-sent then do:
     1277         run write-to-log( substitute( "&1. Пакет с номером &2 уже существует.", vss-workfile, v-pack-num ) ) .
     1278         assign
     1279           p-err-gen-pack = 2
     1280         .
     1281         undo, return error.
     1282       end.
     1283       do transaction
     1284       on error  undo, return error substitute( "&1 (pck-sent). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1285       on stop   undo, return error substitute( "&1 (pck-sent). stop", vss-workfile )
     1286       on endkey undo, return error substitute( "&1 (pck-sent). endkey", vss-workfile )
     1287       :
     1288   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1289   create buf_esys-pck-sent.
     1290   assign
     1291   buf_esys-pck-sent.esps-CreDate        = v-today
     1292   buf_esys-pck-sent.esps-CreTimeInt     = v-time
     1293   buf_esys-pck-sent.esps-CreTime        = string( v-time, "HH:MM:SS" )
     1294   buf_esys-pck-sent.esys-id             = p-esys-id
     1295   buf_esys-pck-sent.db-num              = p-db-num
     1296   buf_esys-pck-sent.esps-cr-db-num      = g#db-num
     1297   buf_esys-pck-sent.esps-pack-num       = v-pack-num
     1298   buf_esys-pck-sent.esps-rcvd           = no
     1299   buf_esys-pck-sent.esps-total-recs     = ?
     1300   buf_esys-pck-sent.esps-CreNum         = 0
     1301   buf_esys-pck-sent.esps-SendTxtDate    = ?
     1302   buf_esys-pck-sent.esps-SendTxtTimeInt = 0
     1303   buf_esys-pck-sent.esps-SendTxtTime    = "":U
     1304   buf_esys-pck-sent.esps-rcvdDate       = ?
     1305   buf_esys-pck-sent.esps-RcvdTimeInt    = 0
     1306   buf_esys-pck-sent.esps-RcvdTime       = "":U
     1307   buf_esys-pck-sent.esps-CRC-pack       = substitute( "&1 &2 &3 &4", today, time, etime, DBTASKID( "ub":U ) )
     1308   .
     1309         buf_esys-pck-sent.custom-pack-name = v-custom-pack-name.
     1310         if index(v-custom-pack-name,  "&pack-num") > 0 then do:
     1311           buf_esys-pck-sent.custom-pack-name = replace(v-custom-pack-name, "&pack-num", string(v-pack-num)).
     1312         end.
     1313         if v-custom-pack-flag = no then do:
     1314           assign buf_esys-pck-sent.custom-pack-name = buf_esys-pck-sent.custom-pack-name + "xml".
     1315         end.
     1316         assign
     1317           route-cnt = 0
     1318           rec-cnt   = 0
     1319         .
     1320         define variable v-uniq-gate-rec as character no-undo init ?.
     1321         define variable v-action as character no-undo .
     1322         v-uniq-gate-rec = ?.
     1323         route-label:
     1324         for each buf_esys-route no-lock
     1325           where buf_esys-route.esys-id   = p-esys-id
     1326             and buf_esys-route.db-num    = p-db-num
     1327             and buf_esys-route.esr-last-pack = -1
     1328           by buf_esys-route.esr-tbl-ord
     1329         on error   undo, return error
     1330         on end-key undo, return error
     1331         :
     1332           if buf_esys-route.esr-tbl-ord > v-last-tbl-ord then do:
     1333             leave route-label.
     1334           end.
     1335           if v-uniq-gate-rec = ? then do:
     1336             assign
     1337             v-uniq-gate-rec = buf_esys-route.uniq-gate-rec.
     1338             v-action = buf_esys-route.esr-action.
     1339           end.
     1340           if buf_esys-route.uniq-gate-rec <> v-uniq-gate-rec then do:
     1341             leave route-label.
     1342           end.
     1343           if v-action <> buf_esys-route.esr-action then do:
     1344             leave route-label.
     1345           end.
     1346           find ub.esys-route exclusive-lock
     1347             where rowid( ub.esys-route ) = rowid( buf_esys-route )
     1348             no-wait no-error
     1349           .
     1350           if not available ub.esys-route then do:
     1351             if locked ub.esys-route then do:
     1352               run write-to-log( vss-workfile + chr(32)
     1353                                 + substitute( "Подготовка пакета прервана на захваченной записи &1", buf_esys-route.esr-name-rec )
     1354                               ).
     1355               if v-sys-key = 'ExpertekIBS':U
     1356               then do:
     1357                 run gbl/findlock.p
     1358                   (input  recid( buf_esys-route )
     1359                   ,output table temp-lock
     1360                   ) .
     1361                 for each temp-lock
     1362                 :
     1363                   run write-to-log( substitute( "Запись захватил пользователь &1", temp-lock.user-name )
     1364                                     + chr(10) + substitute( "Номер подключения - &1":U, temp-lock.lock-conn-id )
     1365                                     + chr(10) + substitute( "Флаги             - &1":U, temp-lock.lock-flag )
     1366                                     + chr(10) + substitute( "Номер транзакции  - &1":U, temp-lock.trans-id )
     1367                                     + chr(10) + substitute( "Тип подключения   - &1":U, temp-lock.connect-type )
     1368                                     + chr(10) + substitute( "Устройство        - &1":U, temp-lock.connect-device )
     1369                                   ).
     1370                 end.
     1371               end.
     1372             end.
     1373             else do:
     1374               run write-to-log( vss-workfile + chr(32)
     1375                                 + substitute( "Подготовка пакета прервана на отсутствующей записи &1", buf_esys-route.esr-name-rec )
     1376                               ).
     1377             end.
     1378             assign
     1379               p-err-gen-pack = 1
     1380             .
     1381             leave route-label.
     1382           end.
     1383           if ub.esys-route.esr-num-dump = 0 then do:
     1384             assign
     1385               qnty-of-cur-rec = 1
     1386             .
     1387           end.
     1388           else do:
     1389             assign
     1390               qnty-of-cur-rec = ub.esys-route.esr-num-dump
     1391             .
     1392           end.
     1393           assign
     1394             route-cnt = route-cnt + 1
     1395             rec-cnt = rec-cnt + qnty-of-cur-rec
     1396           .
     1397           if rec-cnt <> qnty-of-cur-rec
     1398             and rec-cnt > v-max-pack-size
     1399           then do:
     1400             leave route-label.
     1401           end.
     1402           if mFrameView
     1403           then do with frame inf
     1404           :
     1405             assign
     1406               p-esys-id :screen-value   = string( p-esys-id, p-esys-id :format)
     1407               v-pack-num :screen-value = string( v-pack-num, v-pack-num :format)
     1408               route-cnt :screen-value  = string( route-cnt, route-cnt :format)
     1409               rec-cnt :screen-value  = string( rec-cnt - route-cnt, rec-cnt :format)
     1410             .
     1411           end.
     1412           assign
     1413             ub.esys-route.esr-last-pack = v-pack-num
     1414           .
     1415           if buf_esys-route.esr-action = 'command-bush':U
     1416           and buf_ext-system.delivery-method <> integer('11':U)
     1417           then do:
     1418             leave route-label.
     1419           end.
     1420         end.
     1421         find first ub.esys-pck-sent exclusive-lock
     1422           where ub.esys-pck-sent.esys-id  = p-esys-id
     1423             and ub.esys-pck-sent.db-num   = p-db-num
     1424             and ub.esys-pck-sent.esps-pack-num = v-pack-num
     1425           no-error
     1426         .
     1427         if not available ub.esys-pck-sent then do:
     1428           run write-to-log( substitute( "&1. Отсутствует шапка пакета с номером &2!", vss-workfile, v-pack-num ) ) .
     1429           assign
     1430             p-err-gen-pack = 2
     1431           .
     1432           undo, return error.
     1433         end.
     1434         assign
     1435           ub.esys-pck-sent.esps-total-recs = route-cnt
     1436         .
     1437       end.
     1438     end.
     1439     if mFrameView
     1440     then do:
     1441       hide frame inf.
     1442     end.
     1443   end.
     1444   procedure initial-export :
     1445   define input  parameter p-esys-id as integer   no-undo .
     1446   define input  parameter p-db-num as integer   no-undo .
     1447   define input  parameter p-esys-name as character no-undo .
     1448   define buffer buf_esys-route for ub.esys-route.
     1449   define buffer buf_esys-route-dump for ub.esys-route-dump.
     1450   define buffer buf_BatchProcess       for ub.BatchProcess.
     1451   do
     1452   on error undo, return error return-value
     1453   :
     1454     for each buf_esys-route exclusive-lock
     1455         where buf_esys-route.esys-id        = p-esys-id
     1456           and buf_esys-route.db-num         = p-db-num
     1457     :
     1458         for each buf_esys-route-dump exclusive-lock
     1459             where buf_esys-route-dump.esrd-dump-ord = buf_esys-route.esr-dump-ord
     1460         on error undo, return error
     1461         :
     1462             delete buf_esys-route-dump.
     1463         end.
     1464         delete buf_esys-route.
     1465     end.
     1466     run write-to-log (
     1467           input substitute( "Подготовка таблиц выгрузки внешней системы '&1' завершена.", p-esys-name )
     1468                                      ).
     1469     find first buf_BatchProcess no-lock
     1470       where buf_BatchProcess.bp_type   = 'oxmlnew':U
     1471         and buf_BatchProcess.bp_status = 'N':U
     1472         and  buf_BatchProcess.key#_one  = p-esys-id
     1473         and buf_BatchProcess.key#_two = p-db-num
     1474     no-error .
     1475     if available buf_BatchProcess
     1476     then do:
     1477         run bge/oxmlinit.p (
     1478               input this-procedure
     1479             , input p-esys-id
     1480             , input p-db-num
     1481         ).
     1482         do transaction
     1483         on error undo, return error
     1484         :
     1485     find first buf_BatchProcess exclusive-lock
     1486       where buf_BatchProcess.bp_type   = 'oxmlnew':U
     1487         and buf_BatchProcess.bp_status = 'N':U
     1488         and  buf_BatchProcess.key#_one  = p-esys-id
     1489         and buf_BatchProcess.key#_two = p-db-num
     1490     no-error .
     1491             delete buf_BatchProcess.
     1492         end.
     1493     end.
     1494   end.
     1495   end procedure.
