      689   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      690   define temp-table temp-lock no-undo
      691     field lock-conn-id   as integer   label "Номер Подключения"
      692     field user-name      as character label "Пользователь"
      693     field lock-flag      as character label "Флаг"
      694     field trans-id       as integer   label "Транзакция"
      695     field trans-txtime   as character
      696     field trans-state    as character
      697     field trans-dur      as integer
      698     field connect-type   as character label "Подключение"
      699     field connect-time   as character format "x(20)"
      700     field connect-device as character format "x(40)" label "Устройство"
      701     .
      702   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      703   procedure esallatr-name :
      704   do
      705     on error undo, return error
      706     :
      707     define input  parameter p-code           as character no-undo .
      708     define output parameter p-type           as character no-undo .
      709     define output parameter p-format         as character no-undo .
      710     define output parameter p-label          as character no-undo .
      711     define output parameter p-user-can-edit  as logical   no-undo .
      712     define output parameter p-output-display as logical   no-undo .
      713     define output parameter p-other          as character no-undo .
      714       case p-code :
      715               when 'custom-pack-name':U then do:     assign     p-label = "Имя файла в ВС"     p-type = 'C':U      p-format = "X(255)"     p-label = "Имя файла в ВС"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      716               when 'route-custom-pack-name':U then do:     assign     p-label = "Иям файла в ВС"     p-type = 'C':U      p-format = "X(255)"     p-label = "Иям файла в ВС"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      717         otherwise do:
      718           undo, return error substitute("неизвестный атрибут ВС &1", p-code) .
      719         end.
      720       end.
      721     end.
      722   end procedure.
      723   procedure esallatr-tooltip :
      724   do
      725     on error undo, return error
      726     :
      727       define input  parameter p-code    as character no-undo .
      728       define output parameter p-tooltip as character no-undo .
      729       define output parameter p-label   as character no-undo .
      730       case p-code :
      731               when 'custom-pack-name':U then do:     assign     p-tooltip = "Имя файла в ВС"     p-label = "Имя файла в ВС" .   end.
      732               when 'route-custom-pack-name':U then do:     assign     p-tooltip = "Имя файла в ВС"     p-label = "Иям файла в ВС" .   end.
      733         otherwise do:
      734           undo, return error substitute("Неизвестный атрибут ВС &1", p-code) .
      735         end.
      736       end.
      737     end.
      738   end procedure.
      739   procedure esallatr-value :
      740   do
      741     on error undo, return error
      742     :
      743     define input  parameter p-table-name as character no-undo .
      744     define input  parameter p-key1     as int64 no-undo .
      745     define input  parameter p-key2     as int64 no-undo .
      746     define input  parameter p-key3     as character no-undo .
      747     define input  parameter p-key4     as character no-undo .
      748     define input  parameter p-key5     as int64 no-undo .
      749     define input  parameter p-key6     as int64 no-undo .
      750     define input  parameter p-key7     as character no-undo .
      751     define input  parameter p-key8     as character no-undo .
      752     define input  parameter p-code     as character no-undo .
      753     define output parameter p-value    as character no-undo .
      754     define output parameter p-type     as character no-undo .
      755     define buffer buf_esys-all-attr for ub.esys-all-attr.
      756     define variable v-format         as character no-undo .
      757     define variable v-label          as character no-undo .
      758     define variable v-user-can-edit  as logical   no-undo .
      759     define variable v-output-display as logical   no-undo .
      760     define variable v-other          as character no-undo .
      761       run esallatr-name in this-procedure
      762         (input  p-code
      763         ,output p-type
      764         ,output v-format
      765         ,output v-label
      766         ,output v-user-can-edit
      767         ,output v-output-display
      768         ,output v-other
      769         ) no-error .
      770       if error-status :error then do:
      771         undo, return error return-value .
      772       end.
      773       Find first  buf_esys-all-attr no-lock where
      774                   buf_esys-all-attr.attr-code = p-code
      775              and  buf_esys-all-attr.table-name  = p-table-name
      776              and  buf_esys-all-attr.key1  = p-key1
      777              and  buf_esys-all-attr.key2  = p-key2
      778              and  buf_esys-all-attr.key3  = p-key3
      779              and  buf_esys-all-attr.key4  = p-key4
      780              and  buf_esys-all-attr.key5  = p-key5
      781              and  buf_esys-all-attr.key6  = p-key6
      782              and  buf_esys-all-attr.key7  = p-key7
      783              and  buf_esys-all-attr.key8  = p-key8  no-error .
      784      if avail buf_esys-all-attr then do:
      785       assign
      786       p-value = buf_esys-all-attr.attr-value.
      787      end.
      788      else do:
      789       assign
      790       p-value = if p-type = 'L':U then "no":U else "".
      791      end.
      792   end.
      793   end procedure.
      794   procedure esallatr-write :
      795     do
      796     on error undo, return error
      797     :
      798       define input  parameter p-table-name as character no-undo .
      799       define input  parameter p-key1     as int64 no-undo .
      800       define input  parameter p-key2     as int64 no-undo .
      801       define input  parameter p-key3     as character no-undo .
      802       define input  parameter p-key4     as character no-undo .
      803       define input  parameter p-key5     as int64 no-undo .
      804       define input  parameter p-key6     as int64 no-undo .
      805       define input  parameter p-key7     as character no-undo .
      806       define input  parameter p-key8     as character no-undo .
      807       define input  parameter p-code     as character no-undo .
      808       define input  parameter p-value    like ub.esys-all-attr.attr-value no-undo .
      809       define buffer buf_esys-all-attr for ub.esys-all-attr .
      810       define variable v-type           as character no-undo .
      811       define variable v-format         as character no-undo .
      812       define variable v-label          as character no-undo .
      813       define variable v-user-can-edit  as logical   no-undo .
      814       define variable v-output-display as logical   no-undo .
      815       define variable v-other          as character no-undo .
      816       run esallatr-name in this-procedure
      817         (input  p-code
      818         ,output v-type
      819         ,output v-format
      820         ,output v-label
      821         ,output v-user-can-edit
      822         ,output v-output-display
      823         ,output v-other
      824         ) no-error .
      825       if error-status :error then do:
      826         undo, return error return-value .
      827       end.
      828       Find first  buf_esys-all-attr exclusive-lock where
      829                   buf_esys-all-attr.attr-code = p-code
      830              and  buf_esys-all-attr.table-name  = p-table-name
      831              and  buf_esys-all-attr.key1  = p-key1
      832              and  buf_esys-all-attr.key2  = p-key2
      833              and  buf_esys-all-attr.key3  = p-key3
      834              and  buf_esys-all-attr.key4  = p-key4
      835              and  buf_esys-all-attr.key5  = p-key5
      836              and  buf_esys-all-attr.key6  = p-key6
      837              and  buf_esys-all-attr.key7  = p-key7
      838              and  buf_esys-all-attr.key8  = p-key8  no-error .
      839       if not available buf_esys-all-attr then do:
      840         assign
      841         buf_esys-all-attr.attr-code = p-code
      842         buf_esys-all-attr.table-name  = p-table-name
      843         buf_esys-all-attr.key1  = p-key1
      844         buf_esys-all-attr.key2  = p-key2
      845         buf_esys-all-attr.key3  = p-key3
      846         buf_esys-all-attr.key4  = p-key4
      847         buf_esys-all-attr.key5  = p-key5
      848         buf_esys-all-attr.key6  = p-key6
      849         buf_esys-all-attr.key7  = p-key7
      850         buf_esys-all-attr.key8  = p-key8
      851         buf_esys-all-attr.attr-value = p-value
      852         no-error.
      853       end.
      854       ELSE
      855       assign
      856       buf_esys-all-attr.attr-value = p-value no-error
      857       .
      858     end.
      859   end procedure.
      860   procedure esallatr-exist :
      861     do
      862     on error undo, return error
      863     :
      864       define input  parameter p-table-name as character no-undo .
      865       define input  parameter p-key1     as int64 no-undo .
      866       define input  parameter p-key2     as int64 no-undo .
      867       define input  parameter p-key3     as character no-undo .
      868       define input  parameter p-key4     as character no-undo .
      869       define input  parameter p-key5     as int64 no-undo .
      870       define input  parameter p-key6     as int64 no-undo .
      871       define input  parameter p-key7     as character no-undo .
      872       define input  parameter p-key8     as character no-undo .
      873       define input  parameter p-code     like ub.esys-all-attr.attr-code  no-undo .
      874       define output parameter p-exist   AS LOGICAL no-undo .
      875       define buffer buf_esys-all-attr for ub.esys-all-attr .
      876       define variable v-type           as character no-undo .
      877       define variable v-format         as character no-undo .
      878       define variable v-label          as character no-undo .
      879       define variable v-user-can-edit  as logical   no-undo .
      880       define variable v-output-display as logical   no-undo .
      881       define variable v-other          as character no-undo .
      882       run esallatr-name in this-procedure
      883         (input  p-code
      884         ,output v-type
      885         ,output v-format
      886         ,output v-label
      887         ,output v-user-can-edit
      888         ,output v-output-display
      889         ,output v-other
      890         ) no-error .
      891       if error-status :error then do:
      892         undo, return error return-value .
      893       end.
      894       Find first  buf_esys-all-attr no-lock where
      895                   buf_esys-all-attr.attr-code = p-code
      896              and  buf_esys-all-attr.table-name  = p-table-name
      897              and  buf_esys-all-attr.key1  = p-key1
      898              and  buf_esys-all-attr.key2  = p-key2
      899              and  buf_esys-all-attr.key3  = p-key3
      900              and  buf_esys-all-attr.key4  = p-key4
      901              and  buf_esys-all-attr.key5  = p-key5
      902              and  buf_esys-all-attr.key6  = p-key6
      903              and  buf_esys-all-attr.key7  = p-key7
      904              and  buf_esys-all-attr.key8  = p-key8  no-error .
      905       if available buf_esys-all-attr then do:
      906         P-EXIST = YES.
      907       end.
      908     end.
      909   end procedure.
      910   procedure esallatr-delete :
      911     do
      912     on error undo, return error
      913     :
      914       define input  parameter p-table-name as character no-undo .
      915       define input  parameter p-key1     as int64 no-undo .
      916       define input  parameter p-key2     as int64 no-undo .
      917       define input  parameter p-key3     as character no-undo .
      918       define input  parameter p-key4     as character no-undo .
      919       define input  parameter p-key5     as int64 no-undo .
      920       define input  parameter p-key6     as int64 no-undo .
      921       define input  parameter p-key7     as character no-undo .
      922       define input  parameter p-key8     as character no-undo .
      923       define input parameter  p-code     like ub.esys-all-attr.attr-code  no-undo .
      924       define output parameter p-deleted  as logical no-undo .
      925       define buffer buf_esys-all-attr for ub.esys-all-attr .
      926       define variable v-type           as character no-undo .
      927       define variable v-format         as character no-undo .
      928       define variable v-label          as character no-undo .
      929       define variable v-user-can-edit  as logical   no-undo .
      930       define variable v-output-display as logical   no-undo .
      931       define variable v-other          as character no-undo .
      932       run esallatr-name in this-procedure
      933         (input  p-code
      934         ,output v-type
      935         ,output v-format
      936         ,output v-label
      937         ,output v-user-can-edit
      938         ,output v-output-display
      939         ,output v-other
      940         ) no-error .
      941       if error-status :error then do:
      942         undo, return error return-value .
      943       end.
      944       Find first  buf_esys-all-attr exclusive-lock where
      945                   buf_esys-all-attr.attr-code = p-code
      946              and  buf_esys-all-attr.table-name  = p-table-name
      947              and  buf_esys-all-attr.key1  = p-key1
      948              and  buf_esys-all-attr.key2  = p-key2
      949              and  buf_esys-all-attr.key3  = p-key3
      950              and  buf_esys-all-attr.key4  = p-key4
      951              and  buf_esys-all-attr.key5  = p-key5
      952              and  buf_esys-all-attr.key6  = p-key6
      953              and  buf_esys-all-attr.key7  = p-key7
      954              and  buf_esys-all-attr.key8  = p-key8  no-error .
      955       if not available buf_esys-all-attr then do:
      956         p-DELETED = NO.
      957       end.
      958       ELSE DO:
      959         delete buf_esys-all-attr.
      960         p-DELETED = YES.
      961       END.
      962     end.
