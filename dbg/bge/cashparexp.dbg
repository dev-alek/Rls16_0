        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision:$":U .
        3   define variable vss-author      as character no-undo init "$Author:$":U .
        4   define variable vss-date        as character no-undo init "$Date:$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        6   define variable vss-archive     as character no-undo init "$Archive:$":U .
        7   define variable vss-description as character no-undo init "".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define temp-table tt-Cash-Param no-undo
       63   field device   as integer   label "Тип устройства"
       64   field source   as integer   label "Источник"
       65   field section  as character label "Группа/функция"
       66   field fparam   as character label "Параметр"
       67   field fvalue   as character label "Значение"
       68   field fstatus  as integer   label "Обязательный"
       69   field fname    as character label "Описание"
       70   field NumLine_ as integer
       71   index device device source section fparam .
       72   function objExists return character
       73   (input  ifolder as character,
       74    input  iType   as character  ):
       75       define variable vFileType as character no-undo init "D,F".
       76       define variable vi        as integer no-undo.
       77       define variable vtype as character no-undo.
       78       if iType ne ?
       79       then
       80          vFileType = iType.
       81       do vi = 1 to num-entries(vFileType):
       82          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
       83          vtype = file-information:file-type.
       84          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       85             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       86             index(vtype , entry(vi,vFileType )) > 0
       87          then return file-information:full-pathname .
       88          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
       89          vtype = file-information:file-type.
       90          if file-information:file-name <> "" and
       91             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       92             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       93             index( vtype, entry(vi,vFileType )) > 0
       94          then return file-information:full-pathname .
       95       end.
       96       return ? .
       97   end.
       98   function SearchFile return character
       99   (input  ifile as character):
      100      return objExists(ifile,?).
      101   end.
      102   function SearchPFile return character
      103   (input inFile as char):
      104        define variable oFile       as character no-undo.
      105        define variable vFileSearch as character no-undo.
      106        define variable vNumEntry   as integer no-undo.
      107        if inFile = "" then return ?.
      108        vNumEntry = num-entries(inFile,".").
      109        vFileSearch = inFile.
      110        if    vNumEntry > 0
      111           and (   entry(vNumEntry,inFile,".") eq "p"
      112                or entry(vNumEntry,inFile,".") eq "w")
      113        then do:
      114           entry(vNumEntry,vFileSearch, ".") = "r".
      115           oFile = search(vFileSearch ).
      116           if oFile eq ?
      117           then
      118              oFile = search(inFile).
      119        end.
      120        else
      121           oFile = search(vFileSearch).
      122        return oFile.
      123     end.
      124   define buffer code for ub.code.
      125   define new global shared variable g#language as character no-undo .
      126   if g#language <> '' and g#language <> 'rus':U then do:
      127     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      128   end.
      129   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   define variable v-waitfram-action01         as character   no-undo .
      131   define variable v-waitfram-action02         as character   no-undo .
      132   define variable v-waitfram-action03         as character   no-undo .
      133   define variable mWaitFramTextBeg            as character   no-undo.
      134   define variable mWaitFramTextEnd            as character   no-undo.
      135   define variable mWaitFramView               as logical     no-undo.
      136   define variable mWaitProcEvent              as logical     no-undo init yes.
      137   define variable mWaitFramInterval           as integer     no-undo init 1 .
      138   define variable mWaitFramStop               as logical     no-undo.
      139   define variable mWaitFramStopUser           as logical     no-undo.
      140   define variable mWaitFramStopTimeOut        as logical     no-undo.
      141   define variable mWaitFramStartProc          as datetime-tz no-undo.
      142   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      143   define button B-WaitFramStop auto-end-key
      144        label "Стоп"
      145        size 10 by 1 tooltip "Остоновить процесс".
      146   define button B-viewProcInfo
      147        label "Информация"
      148        size 15 by 1 tooltip "Информация о процесс".
      149   define frame waitfram
      150     v-waitfram-action01 format "x(72)" no-label skip
      151     v-waitfram-action02 format "x(72)" no-label skip
      152     v-waitfram-action03 format "x(72)" no-label skip
      153     B-viewProcInfo
      154     B-WaitFramStop at row 4 col 30
      155     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      156     .
      157   define new global shared variable mBatchMode as logical no-undo init ?.
      158   define variable mFramBachModHandle as handle no-undo.
      159   mFramBachModHandle = frame waitfram:handle.
      160   define variable mFameOldVis as logical no-undo.
      161   define variable mVisCUrentVin as logical no-undo.
      162   if session:batch-mode
      163   then
      164      mBatchMode = yes.
      165   if mBatchMode = ? then do:
      166     mVisCUrentVin = current-window:visible.
      167     mFameOldVis = mFramBachModHandle:visible.
      168     mFramBachModHandle:visible  = yes.
      169     mBatchMode = mFramBachModHandle:visible ne yes.
      170     mFramBachModHandle:visible = mFameOldVis.
      171     current-window:visible = mVisCUrentVin.
      172   end.
      173    if  log-manager:logfile-name ne ?
      174     then DO:
      175         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      176         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      177         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      178     end.
      179   on choose of B-WaitFramStop in frame waitfram
      180   do:
      181     mWaitFramStop = yes.
      182     mWaitFramStopUser = yes.
      183   end.
      184   function waitfram-check-timeout returns logical():
      185      define variable vtime as int64 no-undo.
      186      if mWaitFramStopTimeOut
      187      then
      188         return yes.
      189      vtime = ( now - mWaitFramStartProc ) / 1000 .
      190      if     mWaitFramTimeOut ne ?
      191         and mWaitFramTimeOut ne 0
      192         and mWaitFramTimeOut lt vtime
      193      then do:
      194         mWaitFramStopTimeOut = yes.
      195      end.
      196      return mWaitFramStopTimeOut.
      197   end.
      198   procedure waitfram-hide :
      199     if not session:batch-mode
      200     then do
      201     on error undo, return error return-value
      202     :
      203       pause 0 before-hide .
      204       if not mBatchMode then
      205         hide frame waitfram .
      206     if     not mWaitFramView
      207        and mWaitProcEvent
      208     then
      209       process events .
      210     end.
      211   end procedure.
      212   procedure waitfram-show :
      213     define input  parameter p-message as character no-undo .
      214     define variable v-left-margin as integer   no-undo .
      215     if not session:batch-mode
      216     then do
      217     on error undo, return error return-value
      218     :
      219       if length(p-message) <= 70 then do:
      220         assign
      221           v-left-margin = integer((70 - length(p-message)) / 2)
      222         .
      223         assign
      224           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      225         .
      226         assign
      227           v-waitfram-action01 = " "
      228           v-waitfram-action02 = " "
      229                                    + fill(" ", v-left-margin)
      230                                    + p-message
      231           v-waitfram-action03 = " "
      232         .
      233       end.
      234       else do:
      235         define variable vRindex1 as integer no-undo.
      236         define variable vRindex2 as integer no-undo.
      237         vRindex1 = r-index(p-message," ",70).
      238         if vRindex1 = 0
      239         then
      240            vRindex1 = 70.
      241         if length(p-message)  <= vRindex1 + 70 then do:
      242           assign
      243             v-waitfram-action01 = " "
      244             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      245             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      246           .
      247         end.
      248         else do:
      249           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      250           if vRindex2 <= vRindex1
      251           then
      252              vRindex2 = vRindex1 + 70.
      253           assign
      254             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      255             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      256             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      257           .
      258         end.
      259       end.
      260       B-viewProcInfo:visible   in frame waitfram = no.
      261       B-viewProcInfo:sensitive in frame waitfram = no.
      262       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      263       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      264       if  (   mWaitFramView
      265          or  mWaitProcEvent)
      266          and not mBatchMode
      267       then
      268          display
      269             v-waitfram-action01 skip
      270             v-waitfram-action02 skip
      271             v-waitfram-action03 skip
      272          with frame waitfram .
      273       if     mWaitFramView
      274          then do:
      275             if     mWaitFramInterval ne ?
      276                and not mBatchMode
      277             then
      278                wait-for go of frame waitfram pause mWaitFramInterval.
      279          end.
      280          else
      281             if     mWaitProcEvent
      282                and not mBatchMode
      283             then
      284                process events .
      285     end.
      286   end procedure.
      287      procedure waitfram-show-this:
      288         define input  parameter iInterval as int64 no-undo.
      289         define variable vtime as int64 no-undo.
      290         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      291         mWaitFramInterval = iInterval.
      292         run waitfram-show (substitute("&1&2 &3&4" ,
      293                                       mWaitFramTextBeg ,
      294                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      295                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      296                                       mWaitFramTextEnd
      297                                      )
      298                           ).
      299      end.
      300      procedure WaitFramRunPause:
      301         define input  parameter iInterval as dec no-undo.
      302         define variable vStart  as datetime-tz no-undo.
      303         define variable vend    as datetime-tz no-undo.
      304         define variable vint as int64 no-undo.
      305         define variable vOk as logical no-undo.
      306         vStart = now.
      307         vend   = vStart.
      308         publish "WaitFramPause" (iInterval,output vOk).
      309         vend   =  now.
      310         vint = vend - vStart.
      311         vint = iInterval - vint / 1000.
      312         if     not mWaitFramStop
      313            and (   vint > 0
      314                 or (    not vOk
      315                     and iInterval eq ?
      316                     )
      317                 )
      318         then
      319            run waitfram-show-this (iInterval).
      320         vend   =  now.
      321         vint = vend - vStart.
      322         vint = iInterval - vint / 1000.
      323         if     not mWaitFramStop
      324            and vint > 0
      325         then do:
      326            run gbl/pause.p (vint * 1000).
      327         end.
      328         if iInterval ne ?
      329         then
      330            publish "WaitFramStop".
      331         waitfram-check-timeout().
      332      end.
      333      procedure WaitFramWaitFor:
      334         define input  parameter iInterval as dec no-undo.
      335         assign
      336            mWaitFramStartProc   = now
      337            mWaitFramStopUser    = no
      338            mWaitFramStopTimeOut = no
      339         .
      340         block-wait:
      341         do while not mWaitFramStop:
      342            run WaitFramRunPause (iInterval).
      343            if  waitfram-check-timeout()
      344            then do:
      345               leave block-wait.
      346            end.
      347         end.
      348         run waitfram-hide.
      349      end.
      350   procedure waitfram-join :
      351     define input  parameter p-line-1  as character no-undo .
      352     define input  parameter p-line-2  as character no-undo .
      353     define input  parameter p-line-3  as character no-undo .
      354     define output parameter p-message as character no-undo .
      355     do
      356     on error undo, return error return-value
      357     :
      358       assign
      359         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      360                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      361                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      362       .
      363     end.
      364   end procedure.
      365   function waitfram-join-function returns character
      366     (input p-line-1 as character
      367     ,input p-line-2 as character
      368     ,input p-line-3 as character
      369     ).
      370     define variable v-message as character no-undo .
      371     run waitfram-join in this-procedure
      372       (input  p-line-1
      373       ,input  p-line-2
      374       ,input  p-line-3
      375       ,output v-message
      376       ) .
      377     return v-message .
      378   end function .
      379   run waitfram-show ("Ждите...") .
      380   for each code where Code.parent begins "cash-param"
      381                   and num-entries(Code.parent,chr(4)) eq 4
      382   no-lock:
      383      create tt-cash-param.
      384      assign
      385         tt-cash-param.device   = int(entry(2,Code.parent,chr(4)))
      386         tt-cash-param.source   = int(entry(3,Code.parent,chr(4)))
      387         tt-cash-param.section  =     entry(4,Code.parent,chr(4))
      388         tt-cash-param.fparam   = Code.code
      389         tt-cash-param.fname    = Code.CodeName
      390         tt-cash-param.fvalue   = Code.CodeValue
      391         tt-cash-param.fstatus  = Code.status_ + 1
      392      .
      393   end.
      394   define variable m_os-dir   as char no-undo init "":U.
      395   define variable ll_commit as log    no-undo init no.
      396   SYSTEM-DIALOG GET-FILE m_os-dir
      397       TITLE "Сохранить как"
      398       FILTERS
      399         " Файл HTML(*.xls) " "*.xls",
      400         " Все файлы (*.*) " "*.*"
      401       ask-overwrite
      402       save-as
      403       use-filename
      404       update ll_commit
      405       default-extension "pdf"
      406       .
      407   if ll_commit <> yes then return.
      408   m_os-dir = trim(m_os-dir).
      409   if index(m_os-dir," ") > 0
      410   then do:
      411     message "Файл и деректория не могут содержать пробел"
      412         view-as alert-box.
      413     return.
      414   end.
      415   define variable exlim as class ibs.th.bge.execlimpexp no-undo.
      416   exlim = new ibs.th.bge.execlimpexp ().
      417   m_os-dir = replace(m_os-dir,".xls",".").
      418   exlim:expToExcel(temp-table tt-cash-param:handle, m_os-dir + "html").
      419   delete object exlim.
      420   run waitfram-hide .
      421   define variable mfile as character no-undo.
      422   mfile = SearchFile(m_os-dir + "xls").
      423   if mfile eq ?
      424   then
      425      mfile = SearchFile( m_os-dir + "xlsx").
      426   if mfile eq ?
      427   then do:
      428      mfile = SearchFile(m_os-dir + "html").
      429      if mfile eq ?
      430      then
      431         message "что-то пошло совсем не так"
      432         view-as alert-box.
      433      else
      434         message "Сформирован промежуточный результат " mfile
      435         view-as alert-box.
      436   end.
      437   else
      438      message "Выгрузка сохранена в файл " mfile
      439         view-as alert-box.
