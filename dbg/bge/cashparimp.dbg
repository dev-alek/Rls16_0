        1   block-level on error undo, throw.
        2   using ibs.th.bge.execlimpexp.
        3   define variable mFileName as character no-undo init "cash-param.xslx".
        4   define variable vss-revision    as character no-undo init "$Revision:$":U .
        5   define variable vss-author      as character no-undo init "$Author:$":U .
        6   define variable vss-date        as character no-undo init "$Date:$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        8   define variable vss-archive     as character no-undo init "$Archive:$":U .
        9   define variable vss-description as character no-undo init "".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define variable vfileLog as character no-undo init "ImpCashParam.txt".
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   function objExists return character
       70   (input  ifolder as character,
       71    input  iType   as character  ):
       72       define variable vFileType as character no-undo init "D,F".
       73       define variable vi        as integer no-undo.
       74       define variable vtype as character no-undo.
       75       if iType ne ?
       76       then
       77          vFileType = iType.
       78       do vi = 1 to num-entries(vFileType):
       79          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
       80          vtype = file-information:file-type.
       81          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       82             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       83             index(vtype , entry(vi,vFileType )) > 0
       84          then return file-information:full-pathname .
       85          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
       86          vtype = file-information:file-type.
       87          if file-information:file-name <> "" and
       88             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       89             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       90             index( vtype, entry(vi,vFileType )) > 0
       91          then return file-information:full-pathname .
       92       end.
       93       return ? .
       94   end.
       95   function SearchFile return character
       96   (input  ifile as character):
       97      return objExists(ifile,?).
       98   end.
       99   function SearchPFile return character
      100   (input inFile as char):
      101        define variable oFile       as character no-undo.
      102        define variable vFileSearch as character no-undo.
      103        define variable vNumEntry   as integer no-undo.
      104        if inFile = "" then return ?.
      105        vNumEntry = num-entries(inFile,".").
      106        vFileSearch = inFile.
      107        if    vNumEntry > 0
      108           and (   entry(vNumEntry,inFile,".") eq "p"
      109                or entry(vNumEntry,inFile,".") eq "w")
      110        then do:
      111           entry(vNumEntry,vFileSearch, ".") = "r".
      112           oFile = search(vFileSearch ).
      113           if oFile eq ?
      114           then
      115              oFile = search(inFile).
      116        end.
      117        else
      118           oFile = search(vFileSearch).
      119        return oFile.
      120     end.
      121   define new global shared variable g#library  as handle no-undo .
      122   define new global shared variable g#library2 as handle no-undo .
      123   define   shared variable g#auto as logical no-undo.
      124   define   shared variable g#news as logical no-undo.
      125   define   shared variable g#oxml as logical no-undo.
      126   define   shared variable g#esys as logical no-undo.
      127   define   shared variable g#news-source-db as integer no-undo.
      128   define   shared variable g#esys-source-esys as integer no-undo.
      129   define   shared variable g#db-num as integer   no-undo .
      130   define   shared variable g#userid as character no-undo .
      131   define   shared variable g#passwd as character no-undo .
      132   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   function is-numeral return logical
      134     (input p-string   as character ,
      135      input char-avail as character) :
      136     define variable p-replace-string as character no-undo .
      137     define variable log-result       as logical  no-undo .
      138     if p-string = ? then
      139       return false .
      140     p-replace-string = p-string.
      141     if lookup ("*", char-avail) > 0 then
      142         p-replace-string = replace (p-replace-string, '*', '9').
      143     if lookup ("digit", char-avail) > 0 then
      144       assign
      145         p-replace-string = replace (p-replace-string, '0', '9')
      146         p-replace-string = replace (p-replace-string, '1', '9')
      147         p-replace-string = replace (p-replace-string, '2', '9')
      148         p-replace-string = replace (p-replace-string, '3', '9')
      149         p-replace-string = replace (p-replace-string, '4', '9')
      150         p-replace-string = replace (p-replace-string, '5', '9')
      151         p-replace-string = replace (p-replace-string, '6', '9')
      152         p-replace-string = replace (p-replace-string, '7', '9')
      153         p-replace-string = replace (p-replace-string, '8', '9')
      154         .
      155     else
      156        p-replace-string = replace (p-replace-string, '9', chr(15))
      157         .
      158     if lookup ("letter", char-avail) > 0 then
      159       assign
      160         p-replace-string = replace (p-replace-string, 'A', '9')
      161         p-replace-string = replace (p-replace-string, 'B', '9')
      162         p-replace-string = replace (p-replace-string, 'C', '9')
      163         p-replace-string = replace (p-replace-string, 'D', '9')
      164         p-replace-string = replace (p-replace-string, 'E', '9')
      165         p-replace-string = replace (p-replace-string, 'F', '9')
      166         p-replace-string = replace (p-replace-string, 'G', '9')
      167         p-replace-string = replace (p-replace-string, 'H', '9')
      168         p-replace-string = replace (p-replace-string, 'I', '9')
      169         p-replace-string = replace (p-replace-string, 'J', '9')
      170         p-replace-string = replace (p-replace-string, 'K', '9')
      171         p-replace-string = replace (p-replace-string, 'L', '9')
      172         p-replace-string = replace (p-replace-string, 'M', '9')
      173         p-replace-string = replace (p-replace-string, 'N', '9')
      174         p-replace-string = replace (p-replace-string, 'O', '9')
      175         p-replace-string = replace (p-replace-string, 'P', '9')
      176         p-replace-string = replace (p-replace-string, 'Q', '9')
      177         p-replace-string = replace (p-replace-string, 'R', '9')
      178         p-replace-string = replace (p-replace-string, 'S', '9')
      179         p-replace-string = replace (p-replace-string, 'T', '9')
      180         p-replace-string = replace (p-replace-string, 'U', '9')
      181         p-replace-string = replace (p-replace-string, 'V', '9')
      182         p-replace-string = replace (p-replace-string, 'W', '9')
      183         p-replace-string = replace (p-replace-string, 'X', '9')
      184         p-replace-string = replace (p-replace-string, 'Y', '9')
      185         p-replace-string = replace (p-replace-string, 'Z', '9')
      186         p-replace-string = replace (p-replace-string, '_', '9')
      187         .
      188     return p-replace-string = fill ('9', length (p-string)).
      189   end.
      190   if g#db-num ne 0
      191   then do:
      192      message "Импорт возможен только на ГБД" view-as alert-box.
      193      return error.
      194   end.
      195   define variable v-is-erpRN    as logical no-undo .
      196   define variable par-is-erpRN  as character no-undo .
      197   define variable par-type      as character no-undo .
      198   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      199     (input  'is-erpRN'
      200     ,input  ''
      201     ,input  ''
      202     ,input  0
      203     ,input  ''
      204     ,input  ''
      205     ,input  ''
      206     ,input  no
      207     ,output par-is-erpRN
      208     ,output par-type
      209     ) no-error .
      210   v-is-erpRN = lookup(par-is-erpRN, "true,yes":U) > 0.
      211   if v-is-erpRN then do:
      212      message "Импорт возможен только из 1С" view-as alert-box.
      213      return error.
      214   end.
      215   os-command  value (substitute ("del /F &1 &2 exit", searchfile(vfileLog),chr(38) )).
      216   define variable Types      as ibs.th.str.cash.CashDevice no-undo.
      217   Types = new ibs.th.str.cash.CashDevice().
      218   define temp-table tt-Cash-Param no-undo
      219   field device   as integer   label "Тип устройства"
      220   field source   as integer   label "Источник"
      221   field section  as character label "Группа/функция"
      222   field fparam   as character label "Параметр"
      223   field fvalue   as character label "Значение"
      224   field fstatus  as integer   label "Обязательный"
      225   field fname    as character label "Описание"
      226   field NumLine_ as integer
      227   index device device source section fparam .
      228   define variable varlog as logical no-undo.
      229   define variable mFileFullPath as character no-undo.
      230   system-dialog get-file mFileName title "Выберите файл для загрузки эталонных параметров кассы"
      231       filters "MS Excel (*.xls,*.xlsx)" "*.xls,*.xlsx",
      232               "Все файлы" "*.*"
      233       initial-filter 1
      234       must-exist
      235       update varlog.
      236   if not varlog then return error "Отказ от импорта" .
      237   assign
      238      file-info:file-name = mFileName
      239      mFileFullPath           = file-info:full-pathname
      240   .
      241   if length(mFileFullPath) > 0 then .
      242   else return error substitute("Не найден файл &1", mFileName).
      243   define variable exlim as class ibs.th.bge.execlimpexp no-undo.
      244   define variable choice as integer no-undo .
      245   run gbl/d-askw.w (input "Режим работы"
      246                    ,input "Выберите режим работы"
      247                    ,input "|^"
      248                    ,input "Перезаписать^confirm|Вывести в лог|Добавить новые|Отмена"
      249                    ,input "Все совпадающие строки будут перезаписаны|Будет сформирован лог-файл с результатом сравнения|Добавить новые записи|Прервать загрузку"
      250                    ,input 2
      251                    ,input 4
      252                    ,output choice) no-error.
      253   if choice eq 4
      254   then do:
      255      run WriteLog ("Пользователь отказался.").
      256   end.
      257   else do:
      258      exlim = new ibs.th.bge.execlimpexp (this-procedure).
      259      subscribe "WriteLogExel" anywhere run-procedure "WriteLog".
      260      subscribe "WorkLineExel" anywhere.
      261      exlim:impExcel(mFileFullPath, temp-table tt-cash-param:handle).
      262      delete object exlim.
      263      unsubscribe "WorkLineExel".
      264      unsubscribe "WriteLogExel".
      265   end.
      266   define variable mStrLoad as integer no-undo.
      267   define variable mStrAll  as integer no-undo.
      268   if searchfile(vfileLog) ne ?
      269   then
      270      message "Сформирован лог " searchfile(vfileLog) skip
      271              "Обработано строк: " mStrAll skip
      272              "Создано/Изменено записей: " mStrLoad
      273      view-as alert-box.
      274   else
      275      message "Расхождений нет."
      276      view-as alert-box.
      277   define stream Slog.
      278   define variable mfirst as logical no-undo init true.
      279   procedure WriteLog:
      280      define input  parameter itext as character no-undo.
      281      if mfirst
      282      then do:
      283         mFirst = false.
      284         output stream Slog to value(vfileLog).
      285      end.
      286      else
      287         output stream Slog to value(vfileLog) append.
      288      put stream Slog unformatted itext skip.
      289      output stream Slog close.
      290   end.
      291   procedure WorkLineExel:
      292      define input  parameter iBuffer as handle no-undo.
      293      define output parameter oDelRec as logical no-undo.
      294      oDelRec = yes.
      295      mStrAll = mStrAll + 1.
      296      if not iBuffer:available then return.
      297      if Types:GetProp(iBuffer::device) eq Types:Unknow
      298      then do:
      299         run WriteLog(
      300                      substitute ("Строка &1 недопустимое значение &2 поля &3",
      301                                  iBuffer::NumLine_,
      302                                  iBuffer::device,
      303                                  iBuffer:buffer-field( "device"):label
      304                                  )
      305                      ).
      306         return.
      307      end.
      308      if     iBuffer::source ne 1
      309         and iBuffer::source ne 2
      310      then do:
      311         run WriteLog(
      312                      substitute ("Строка &1 недопустимое значение &2 поля &3 Допустимы 1 и 2",
      313                                  iBuffer::NumLine_,
      314                                  iBuffer::device,
      315                                  iBuffer:buffer-field( "source"):label)).
      316         return.
      317      end.
      318      if     iBuffer::fstatus ne 1
      319         and iBuffer::fstatus ne 2
      320      then do:
      321         run WriteLog(substitute ("Строка &1 недопустимое значение &2 поля &3 Допустимы 1 - обязательный и 2 - Необязательный",
      322                                  iBuffer::NumLine_,
      323                                  iBuffer::fstatus,
      324                                  iBuffer:buffer-field( "fstatus"):label)).
      325         return.
      326      end.
      327      if     iBuffer::section eq ""
      328         or  iBuffer::section eq ?
      329      then do:
      330         run WriteLog(substitute ("Строка &1 недопустимое значение '&2' поля &3 Не может быть пустым",
      331                                  iBuffer::NumLine_,
      332                                  iBuffer::section,
      333                                  iBuffer:buffer-field( "section"):label)).
      334         return.
      335      end.
      336      if not is-numeral (iBuffer::section,
      337                         if iBuffer::source eq 1
      338                         then "letter,digit"
      339                         else "digit")
      340      then do:
      341         run WriteLog(substitute ("Строка &1 недопустимое значение '&2' поля &3 Допустимы только &4",
      342                                  iBuffer::NumLine_,
      343                                  iBuffer::section,
      344                                  iBuffer:buffer-field( "section"):label,
      345                                  if iBuffer::source eq 1 then "Латинкские буквы и цифры" else "Цифры" )).
      346         return.
      347      end.
      348      if iBuffer::source eq 1
      349      then do:
      350         if     iBuffer::fparam eq ""
      351            or  iBuffer::fparam eq ?
      352         then do:
      353            run WriteLog(substitute ("Строка &1 недопустимое значение '&2' поля &3 Не может быть пустым",
      354                                     iBuffer::NumLine_,
      355                                     iBuffer::fparam,
      356                                     iBuffer:buffer-field( "fparam"):label)).
      357            return.
      358         end.
      359         if not is-numeral (iBuffer::fparam,
      360                            "letter,digit"
      361                            )
      362         then do:
      363            run WriteLog(substitute ("Строка &1 недопустимое значение '&2' поля &3 Допустимы только &4",
      364                                     iBuffer::NumLine_,
      365                                     iBuffer::fparam,
      366                                     iBuffer:buffer-field( "fparam"):label,
      367                                     if iBuffer::source eq 1 then "Латинкские буквы и цыфры" else "Цыфры")).
      368            return.
      369         end.
      370      end.
      371      else do:
      372         if     iBuffer::fvalue ne "MGR"
      373            and iBuffer::fvalue ne "REG"
      374         then do:
      375            run WriteLog(substitute ("Строка &1 недопустимое значение &2 поля &3 Допустимы MGR - менаджер и REG - кассир",
      376                                     iBuffer::NumLine_,
      377                                     iBuffer::fvalue,
      378                                     iBuffer:buffer-field( "fvalue"):label)).
      379            return.
      380         end.
      381      end.
      382      define variable mparent as character no-undo.
      383      mparent = substitute ("cash-param&1&2&1&3&1&4",
      384                            chr(4),
      385                            iBuffer::device,
      386                            iBuffer::source,
      387                            iBuffer::section).
      388      find first code where Code.parent eq mparent
      389                        and Code.code   eq iBuffer::fparam
      390      no-lock no-error.
      391      if not available code
      392      then do:
      393         if    choice ne 2
      394         then do:
      395            create code.
      396            assign
      397               Code.parent = mparent
      398               Code.code   = iBuffer::fparam
      399            .
      400            assign
      401               Code.code      = iBuffer::fparam
      402               Code.CodeName  = iBuffer::fname
      403               Code.CodeValue = iBuffer::fvalue
      404               Code.status_   = iBuffer::fstatus - 1
      405               Code.nwsgbd    = yes
      406            .
      407            mStrLoad = mStrLoad + 1.
      408            run WriteLog("Создана запись " +
      409                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("device")),iBuffer::device) +
      410                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("source")),iBuffer::source) +
      411                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("section")),iBuffer::section) +
      412                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("fparam")),iBuffer::fparam) +
      413                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("fvalue")),iBuffer::fvalue) +
      414                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("fname")),iBuffer::fname) +
      415                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("fstatus")),iBuffer::fstatus)
      416                         ).
      417         end.
      418         else do:
      419            run WriteLog("Отсутствует запись " +
      420                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("device")),iBuffer::device) +
      421                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("source")),iBuffer::source) +
      422                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("section")),iBuffer::section) +
      423                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("fparam")),iBuffer::fparam) +
      424                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("fvalue")),iBuffer::fvalue) +
      425                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("fname")),iBuffer::fname) +
      426                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("fstatus")),iBuffer::fstatus)
      427                         ).
      428         end.
      429      end.
      430      else do:
      431         if     Code.code      ne iBuffer::fparam
      432            or  Code.CodeName  ne iBuffer::fname
      433            or  Code.CodeValue ne iBuffer::fvalue
      434            or  Code.status_   ne iBuffer::fstatus - 1
      435         then do:
      436            if choice eq 1
      437            then do:
      438               run WriteLog("Изменена запись " +
      439                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("device")),iBuffer::device) +
      440                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("source")),iBuffer::source) +
      441                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("section")),iBuffer::section) +
      442                         (if Code.code      ne iBuffer::fparam  then substitute ("&1: старое &2 новое &3 ",exlim:getFieldName(iBuffer:buffer-field ("fparam" )),Code.code,     iBuffer::fparam)  else "")  +
      443                         (if Code.CodeName  ne iBuffer::fname   then substitute ("&1: старое &2 новое &3 ",exlim:getFieldName(iBuffer:buffer-field ("fname"  )),Code.CodeName, iBuffer::fname)   else "")  +
      444                         (if Code.CodeValue ne iBuffer::fvalue  then substitute ("&1: старое &2 новое &3 ",exlim:getFieldName(iBuffer:buffer-field ("fvalue" )),Code.CodeValue,iBuffer::fvalue)  else "")  +
      445                         (if Code.status_   ne iBuffer::fstatus then substitute ("&1: старое &2 новое &3 ",exlim:getFieldName(iBuffer:buffer-field ("fstatus")),Code.status_ , iBuffer::fstatus) else "")
      446                         ).
      447               find first code where Code.parent eq mparent
      448                        and Code.code   eq iBuffer::fparam
      449               exclusive-lock no-error.
      450               assign
      451                  Code.code      = iBuffer::fparam
      452                  Code.CodeName  = iBuffer::fname
      453                  Code.CodeValue = iBuffer::fvalue
      454                  Code.status_   = iBuffer::fstatus - 1
      455                  Code.nwsgbd    = yes
      456               .
      457               mStrLoad = mStrLoad + 1.
      458            end.
      459            else do:
      460               run WriteLog("Отличается запись " +
      461                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("device")),iBuffer::device) +
      462                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("source")),iBuffer::source) +
      463                         substitute ("&1:&2 ",exlim:getFieldName(iBuffer:buffer-field ("section")),iBuffer::section) +
      464                         (if Code.code      ne iBuffer::fparam  then substitute ("&1: старое &2 новое &3 ",exlim:getFieldName(iBuffer:buffer-field ("fparam" )),Code.code,     iBuffer::fparam)  else "")  +
      465                         (if Code.CodeName  ne iBuffer::fname   then substitute ("&1: старое &2 новое &3 ",exlim:getFieldName(iBuffer:buffer-field ("fname"  )),Code.CodeName, iBuffer::fname)   else "")  +
      466                         (if Code.CodeValue ne iBuffer::fvalue  then substitute ("&1: старое &2 новое &3 ",exlim:getFieldName(iBuffer:buffer-field ("fvalue" )),Code.CodeValue,iBuffer::fvalue)  else "")  +
      467                         (if Code.status_   ne iBuffer::fstatus then substitute ("&1: старое &2 новое &3 ",exlim:getFieldName(iBuffer:buffer-field ("fstatus")),Code.status_ , iBuffer::fstatus) else "")
      468                         ).
      469            end.
      470         end.
      471      end.
      472   end.
