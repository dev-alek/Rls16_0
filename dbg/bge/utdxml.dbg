      314                       then do:
      315                           assign
      316                               p-out-string = p-out-string + " ":U
      317                           .
      318                       end.
      319                       when chr(4)
      320                       then do:
      321                           assign
      322                               p-out-string = p-out-string + " ":U
      323                           .
      324                       end.
      325                       when chr(5)
      326                       then do:
      327                           assign
      328                               p-out-string = p-out-string + " ":U
      329                           .
      330                       end.
      331                       when chr(6)
      332                       then do:
      333                           assign
      334                               p-out-string = p-out-string + " ":U
      335                           .
      336                       end.
      337                       when chr(7)
      338                       then do:
      339                           assign
      340                               p-out-string = p-out-string + " ":U
      341                           .
      342                       end.
      343                       when chr(8)
      344                       then do:
      345                           assign
      346                               p-out-string = p-out-string + " ":U
      347                           .
      348                       end.
      349                       when chr(9)
      350                       then do:
      351                           assign
      352                               p-out-string = p-out-string + " ":U
      353                           .
      354                       end.
      355                       when chr(29)
      356                       then do:
      357                           assign
      358                               p-out-string = p-out-string + " ":U
