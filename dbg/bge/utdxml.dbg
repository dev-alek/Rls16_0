      384   procedure xmlchar-decode :
      385   define input parameter p-in-string      as character        no-undo.
      386   define output parameter p-out-string    as character        no-undo.
      387       define variable v-position      as integer      no-undo.
      388       define variable v-last-position as integer      no-undo.
      389       define variable v-temp-integer  as integer      no-undo.
      390       define variable v-current-char  as character    no-undo.
      391       define variable v-next-char     as character    no-undo.
      392       define variable v-success       as logical      no-undo.
      393   do
      394   on error undo, return error
      395   :
      396       assign
      397           p-out-string = "":U
      398           v-position   = 0
      399       .
      400       replace-cycle:
      401       do while yes
      402       on error undo, return error
      403       :
      404           assign
      405               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      406           .
      407           if v-last-position <= v-position
      408           then do:
      409               if v-position = 0
      410               then do:
      411                   assign
      412                       p-out-string = p-in-string
      413                   .
      414               end.
      415               else do:
      416                   assign
      417                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      418                   .
      419               end.
      420               leave replace-cycle.
      421           end.
      422           else do:
      423               assign
      424                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      425                   v-position      = v-last-position
      426                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      427               .
      428               if v-current-char = "#":U
      429               then do:
      430                   assign
      431                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      432                   .
      433                   if v-last-position > 0
      434                   then do:
      435                       run xmlchar-read-integer in this-procedure
      436                        (
      437                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      438                           , output v-temp-integer
      439                           , output v-success
      440                       ).
      441                       if v-success = yes
      442                       and v-temp-integer >= 1
      443                       and v-temp-integer <= 255
      444                       then do:
      445                           assign
      446                               p-out-string = p-out-string + chr( v-temp-integer )
      447                               v-position   = v-last-position + 1
      448                           .
      449                       end.
      450                       else do:
      451                           assign
      452                               p-out-string = p-out-string + "&":U
      453                               v-position   = v-position   + 1
      454                           .
      455                       end.
      456                   end.
      457                   else do:
      458                       assign
      459                           p-out-string = p-out-string + "&":U
      460                           v-position   = v-position   + 1
      461                       .
      462                   end.
      463               end.
      464               else do:
      465                   case substring( p-in-string, v-position + 1, 3 )
      466                   :
      467                       when "lt;":U
      468                       then do:
      469                           assign
      470                               p-out-string = p-out-string + "<":U
      471                               v-position   = v-position   + 3
      472                           .
      473                       end.
      474                       when "gt;":U
      475                       then do:
      476                           assign
      477                               p-out-string = p-out-string + ">":U
      478                               v-position   = v-position   + 3
      479                           .
      480                       end.
      481                       otherwise do:
      482                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      483                           then do:
      484                               assign
      485                                   p-out-string = p-out-string + "&":U
      486                                   v-position   = v-position   + 4
      487                               .
      488                           end.
      489                           else do:
      490                               case substring( p-in-string, v-position + 1, 5 )
      491                               :
      492                                   when "quot;":U
      493                                   then do:
      494                                       assign
      495                                           p-out-string = p-out-string + '"':U
      496                                           v-position   = v-position   + 5
      497                                       .
      498                                   end.
      499                                   when "apos;":U
      500                                   then do:
      501                                       assign
      502                                           p-out-string = p-out-string + "'":U
      503                                           v-position   = v-position   + 5
      504                                       .
      505                                   end.
      506                                   otherwise do:
      507                                       assign
      508                                           p-out-string = p-out-string + "&":U
      509                                       .
      510                                   end.
      511                               end case.
      512                           end.
      513                       end.
      514                   end case.
      515               end.
      516           end.
      517       end.
      518   end.
      519   end .
      520   procedure xmlchar-read-integer :
      521   define input parameter p-input-string      as character        no-undo.
      522   define output parameter p-output-integer   as integer          no-undo.
      523   define output parameter p-success       as logical          no-undo.
      524   do
      525   on error undo, return error
      526   :
      527       assign
      528           p-output-integer = integer( p-input-string )
      529       no-error.
      530       if error-status :error
      531       then do:
      532           assign
      533               p-success           = no
      534               p-output-integer    = 0
      535           .
      536       end.
      537       else do:
      538           assign
      539               p-success           = yes
      540           .
      541       end.
      542   end.
      543   end.
      544   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      545   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      546   define new global shared variable g#attr-lib  as handle no-undo .
      547   define variable v-attr-lib-variable as handle no-undo .
      548   define variable mMRCCode  as logical    no-undo.
      549   define variable mTypeMark as character  no-undo.
      550   function IS-NeedMark returns logical
      551   ( input ib-code as integer  ,
      552     input ib-str as character ):
      553      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      554      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      555                                    and buf_prod-bc-attr.b-str  eq ib-str
      556                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      557        no-lock no-error.
      558      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      559   end.
      560   function repTegforDm return char
      561   (iDM as char ):
      562       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      563       define variable vteg as character no-undo.
      564       define variable oDM as character no-undo.
      565       define variable vi as integer no-undo.
      566       oDM = iDm.
      567       do vi = 1 to num-entries(vTeglist):
      568          vTeg = entry(vi,vTeglist).
      569          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      570       end.
      571       return oDM.
      572   end.
      573   function repSpecSimbforDm return char
      574   (iDM as char ):
      575       define variable oDM as character no-undo.
      576     run
      577       xmlchar-decode(iDM, output oDM).
      578     return repTegforDm (oDM).
      579   end.
      580   function CheckGtin return logical
      581   (iGtin as char):
      582      define variable bar_code as character no-undo.
      583      define variable vGtin as logical no-undo init "yes".
      584      if length(iGtin) eq 14
      585      then do:
      586         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      587         run str/chk-sum.p
      588          (input-output bar_code ) no-error .
      589         if iGtin ne  bar_code
      590         then
      591            vGtin = no.
      592      end.
      593      else
      594         vGtin = no.
      595      return vgtin.
      596   end.
      597   function repSpecSimbforXlm return char
      598   (iDM as char ):
      599       iDM = replace(iDM,chr(29),"").
      600       return iDM.
      601   end.
      602   function getGtinByDM return char
      603   (IDM as char):
      604      define variable VTXT as char no-undo.
      605      define variable vGtin as char no-undo.
      606      vTXt = IdM.
      607      vGtin = IDM.
      608      if    length(vtxt) > 14
      609      then do:
      610         if   vtxt begins "(01)"
      611                or vtxt begins "(02)"
      612         then
      613            vGtin = substring(vtxt,5,14).
      614         else if   (vtxt begins "01"
      615                or vtxt begins "02" )
      616                and (   (    substring(iDm,17,2) eq "21"
      617                         and length(vtxt) >= 21)
      618                     or substring(iDm,17,2) eq "37"
      619                     or substring(iDm,17,4) eq "(37)" )
      620         then do:
      621            vGtin = substring(vtxt,3,14).
      622            if not checkGtin(vGtin)
      623            then
      624               vGtin = substring(vtxt,1,14).
      625         end.
      626         else if     length(vtxt) eq 14 + 7 + 4 + 4
      627             or length(vtxt) eq 14 + 7 + 4
      628             or length(vtxt) eq 14 + 7
      629         then
      630            vGtin = substring(vtxt,1,14).
      631      end.
      632      if not checkGtin(vGtin)
      633      then
      634         vGtin = "".
      635      return vgtin.
      636   end.
      637   function getGdsCodeByGtin return int
      638   (iGtin as char):
      639      define buffer prod-bc  for ub.prod-bc.
      640      define buffer bar-code for ub.bar-code.
      641      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
      642      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      643      return if avail bar-code then bar-code.gds-code else ?.
      644   end.
      645   function getQntyCodeByGtin return decimal
      646   (iGtin as char):
      647      define buffer prod-bc  for ub.prod-bc.
      648      define buffer bar-code for ub.bar-code.
      649      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
      650      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      651      return if avail bar-code then bar-code.cli-base-rate else ?.
      652   end.
      653   function getGdsCodeByDM return int
      654   (iDm as char):
      655      define variable vGtin as char no-undo.
      656      define buffer prod-bc for ub.prod-bc.
      657      vGtin  = getGtinByDM (IDM ).
      658      return getGdsCodeByGtin (vGtin).
      659   end.
      660   function ChekTypeMarkByGds return logical
      661   (iGds-code as integer ):
      662      define buffer goods-attr for ub.goods-attr.
      663      find first goods-attr where goods-attr.gds-code   = iGds-code
      664                              and goods-attr.attr-code  = 'mark-type':U
      665      no-lock no-error.
      666      if available goods-attr
      667      then do:
      668         mTypeMark = goods-attr.attr-value.
      669         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
      670           .
      671      end.
      672      else
      673         return no.
      674   end.
      675   function ChekTypeMarkByDm return logical
      676   (iDM as char ):
      677      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
      678   end.
      679   function ChekTypeMarkByGtin return logical
      680   (iGtin as char ):
      681      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
      682   end.
      683   function GetNextElement return character
      684     (input iAllTeg        as logical
      685     ,output oteg          as character
      686     ,output otegval       as character
      687     ,input-output pstr    as character
      688      ):
      689        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
      690        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
      691        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
      692        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
      693        define variable vTeg as character no-undo.
      694        define variable vLength as integer no-undo.
      695        define variable vi as integer no-undo.
      696        define variable vj as integer no-undo.
      697        define buffer code for ub.code.
      698        find first code where Code.parent eq "MarkType"
      699                          and Code.CodeValue   eq mTypeMark
      700                          no-lock no-error.
      701        if     available code
      702           and Code.misc1 ne ""
      703           and Code.misc1 ne ?
      704        then do:
      705           integer (Code.misc1) no-error.
      706           if not error-status:error
      707           then
      708             entry (4,vlistleng) = Code.misc1.
      709        end.
      710        if iAllTeg
      711        then
      712           assign
      713              vlistElem     = vlistElem    + vlistElemDop
      714              vlistleng     = vlistleng    + vlistlengDop
      715           .
      716        else if mMRCCode
      717        then
      718           assign
      719              vlistElem     = vlistElem    + ",(8005),8005"
      720              vlistleng     = vlistleng    + ",000006,0006"
      721           .
      722       block-elem:
      723       do vi = 1 to num-entries(vlistElem):
      724          vTeg = entry(vi,vlistElem).
      725          if pstr begins vTeg
      726          then do:
      727             if    vTeg eq "21"
      728             then
      729                vLength = index(pstr,chr(29)) - 2 no-error.
      730             if vLength  <= 0
      731             then
      732                vLength = int(entry(vi,vlistleng)).
      733             otegval = substring (pstr,length(vteg) + 1, vLength).
      734             oteg = replace(replace(vteg,")",""),"(","").
      735             vTeg = vteg + otegval.
      736             otegval = replace(otegval,chr(29),"").
      737             oteg = replace(replace(oteg,")",""),"(","").
      738             pstr = substring (pstr,length(vTeg)+ 1).
      739             vTeg = replace(vTeg,chr(29),"").
      740             leave block-elem.
      741          end.
      742          else
      743             vTeg = "".
      744       end.
      745       return vteg.
      746   end.
      747   function GetCodeIdent return character
      748   (iDm as char):
      749      define variable Velement   as character no-undo init "first".
      750      define variable oCodeIdent as character no-undo.
      751      define variable vteg as character no-undo.
      752      define variable vtegval as character no-undo.
      753      define variable vGtin as character no-undo.
      754      define buffer marking for ub.marking.
      755      for first marking no-lock where
      756                marking.mark eq iDm
      757            and marking.unit-ext = "LEVEL2"
      758      :
      759        return iDm.
      760      end.
      761      vGtin  = getGtinByDM (iDm ).
      762      ChekTypeMarkByDm(idm).
      763      if iDm begins 'tech_':U
      764      then
      765         oCodeIdent = iDm.
      766      else if length(iDm) < 21
      767      then do:
      768         find first marking where marking.mark eq idm
      769         no-lock no-error.
      770         oCodeIdent = if available marking then marking.mark else  ?.
      771      end.
      772      else if     length(iDm) eq 29
      773         and not iDm begins "01"
      774         and not iDm begins "02"
      775      then
      776         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
      777      else  if     length(iDm) >= 24
      778               and (  iDm begins "01"
      779                   or iDm begins "02")
      780               and  substring(iDm,17,2) ne "21"
      781      then do:
      782         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
      783                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
      784         then
      785            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
      786         else
      787            oCodeIdent = iDM.
      788      end.
      789      else  if     (   length(iDm) eq 25
      790                    or length(iDm) eq 21)
      791               and (not iDm begins "01"
      792               and  not iDm begins "02")
      793      then
      794         oCodeIdent = substring(iDm,1,21).
      795      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
      796      then
      797         oCodeIdent = substring(iDm,1,21).
      798      else do while Velement ne "" and idm ne "":
      799         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
      800         oCodeIdent = oCodeIdent + Velement.
      801      end.
      802      return oCodeIdent.
      803   end.
      804   function GetTegCod return character
      805   (icodeIdent as char, iTeg as char):
      806      define variable Velement   as character no-undo init "first".
      807      define variable oTeg as character no-undo init ?.
      808      define variable vteg as character no-undo.
      809      define variable vtegval as character no-undo.
      810      if     ((length(icodeIdent) eq 21
      811         and not icodeIdent begins "01"
      812         and not icodeIdent begins "02")
      813         or
      814             ( length(icodeIdent) eq 25
      815               and not icodeIdent begins "01"
      816               and not icodeIdent begins "02"))
      817      then do:
      818         if iTeg eq "01" or iTeg eq "02"
      819         then
      820            oTeg = substring(icodeIdent,1,21).
      821         else  if  iTeg eq "21"
      822         then
      823            oTeg = substring(icodeIdent,15,7).
      824      end.
      825      else do:
      826         ChekTypeMarkByDm(icodeIdent).
      827         block-teg:
      828            do while Velement ne "" and icodeIdent ne "":
      829            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
      830            if    Velement begins iTeg
      831               or Velement begins "(" + iTeg + ")"
      832            then do:
      833               oTeg = vtegval.
      834               leave block-teg.
      835            end.
      836         end.
      837      end.
      838      return oTeg.
      839   end.
      840   function isOAD return logical
      841   (icodeIdent as character):
      842      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
      843   end.
      844   function isMark return logical
      845   (icodeIdent as character):
      846      define buffer buf_marking for ub.marking.
      847      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
      848             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
      849   end.
      850   function addBracketForCode return character
      851   (icodeIdent as char):
      852      define variable Velement   as character no-undo init "first".
      853      define variable oTeg as character no-undo.
      854      define variable vteg as character no-undo.
      855      define variable vtegval as character no-undo.
      856      define buffer marking for ub.marking.
      857      find first marking no-lock where
      858                 marking.mark begins icodeIdent no-error.
      859      if    not ChekTypeMarkByDm(icodeIdent)
      860         or length(icodeIdent) le 24
      861         or (avail marking and marking.unit-ext = "LEVEL2")
      862      then
      863         oTeg = icodeIdent.
      864      else do:
      865         if (  icodeIdent begins "01"
      866            or icodeIdent begins "02"
      867            ) and CheckGtin(substring (icodeIdent,3,14))
      868            and substring (icodeIdent,17,2) eq "21"
      869         then do:
      870            mMRCCode = yes.
      871            ChekTypeMarkByDm(icodeIdent).
      872            block-teg:
      873            do while Velement ne "" and icodeIdent ne "":
      874               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
      875               if vteg ne ""
      876               then
      877                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
      878            end.
      879            mMRCCode = no.
      880         end.
      881         else do:
      882            oTeg = icodeIdent.
      883         end.
      884      end.
      885      return oTeg.
      886   end.
      887   function getlevelByCodId return int
      888   (iCode as char):
      889      define variable vLength as int no-undo.
      890      define variable vLevel  as int no-undo.
      891      if not ChekTypeMarkByDM (icode) then return ?.
      892      vLength = length(iCode).
      893      if    vLength eq 18
      894         or vLength eq 20
      895      then
      896         Vlevel = 4.
      897      else if vLength eq 21
      898      then
      899         Vlevel = 1.
      900      else if vLength eq 25
      901      then do:
      902         if  iCode begins "01"
      903         then
      904            Vlevel = 3.
      905         else
      906            Vlevel = 1.
      907      end.
      908      else if     vLength >= 26
      909              and vLength <= 46
      910      then do:
      911         if    substring(iCode,17,2) eq "11"
      912            or substring(iCode,17,2) eq "13"
      913            or (    substring(iCode,17,2) eq "21"
      914                and vLength >= 33
      915                and substring(iCode,26,4) ne "8005")
      916         then
      917            Vlevel = 4.
      918         else if    vLength eq 31
      919                 or vLength eq 38
      920                 or vLength eq 39
      921                 or vLength eq 45
      922         then
      923            Vlevel = 1.
      924         else if    vLength eq 35
      925                 or vLength eq 43
      926         then
      927            Vlevel = 3.
      928         else
      929            Vlevel = ?.
      930      end.
      931      else
      932         Vlevel = ?.
      933      return Vlevel.
      934   end.
      935   function getLevelMotpBycodid return character
      936   (iDm as char):
      937      define variable vLevel as integer no-undo.
      938      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      939      vLevel = getlevelByCodId(iDm).
      940      if    vLevel eq ?
      941         or vLevel < 1
      942         or vLevel > 6
      943      then
      944         return ?.
      945      else
      946         return entry(vlevel,vList).
      947   end.
      948   function getLevelUTDByLevelMotp return character
      949   (iUnit as char):
      950      define variable vLevel as integer no-undo.
      951      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
      952      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      953      vLevel = lookup(iUnit,vListMOTP).
      954      if    vLevel eq ?
      955         or vLevel < 1
      956         or vLevel > 4
      957      then
      958         return ?.
      959      else
      960         return entry(vlevel,vListutd).
      961   end.
      962   function getLevelMotpByDM return character
      963   (iDm as char):
      964      return getLevelMotpByCodId(GetCodeIdent(iDm)).
      965   end.
      966   function getLevelUTDByCodId return character
      967   (iDm as char):
      968      define variable vLevel as integer no-undo.
      969      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
      970      vLevel = getlevelByCodId(iDm).
      971      if    vLevel eq ?
      972         or vLevel < 1
      973         or vLevel > 4
      974      then
      975         return ?.
      976      else
      977         return entry(vlevel,vList).
      978   end.
      979   function getLevelUTDByDM return character
      980   (iDm as char):
      981      return getLevelUTDByCodId(GetCodeIdent(iDm)).
      982   end.
      983   define variable mNotMarkQnty as logical no-undo.
      984   function getQntyUTDByCodId return decimal
      985   (iDM as char):
      986      define variable vLevel as integer no-undo.
      987      define variable vList as character no-undo init "1,5,10,500".
      988      define variable vGtin as character no-undo.
      989      define variable vqnty as decimal no-undo init ?.
      990      vqnty = dec(GetTegCod(iDM,"37")) no-error.
      991      if vqnty eq ?
      992      then do:
      993         if not mNotMarkQnty
      994         then do:
      995            define buffer marking for ub.marking.
      996            define variable vCodident as character no-undo.
      997            vCodident = GetCodeIdent(idm).
      998            find first marking where marking.mark begins vCodident no-lock no-error.
      999            if     available marking
     1000               and marking.box-qnty ne ?
     1001            then
     1002               return marking.box-qnty.
     1003         end.
     1004         vGtin = getGtinByDm(iDM).
     1005         if ChekTypeMarkByGtin (vGtin)
     1006         then do:
     1007            vLevel = getlevelByCodId(iDM).
     1008            if     vLevel >= 1
     1009               and vLevel <= 4
     1010            then
     1011               vqnty = int(entry(vlevel,vList)).
     1012         end.
     1013         else
     1014            vqnty = getQntyCodeByGtin(vgtin).
     1015      end.
     1016      return vqnty.
     1017   end.
     1018   function getQntyUTDByDM return decimal
     1019   (iDm as char):
     1020      define variable vDM as character no-undo.
     1021      if     length (iDm) ne 25
     1022         and length (iDm) ne 29
     1023         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1024      then
     1025         vDM = substring (iDm,1,length (iDm) - 6 ).
     1026      else
     1027         vDM = substring (iDm,1,length (iDm) - 4 ).
     1028      return getQntyUTDByCodId(vDM).
     1029   end.
     1030   function getMRC4 return decimal
     1031   (iMRC as char):
     1032      define variable oMrc     as decimal no-undo init ?.
     1033      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1034      define variable vi       as integer no-undo.
     1035      define variable vfound   as integer no-undo.
     1036      define variable vposStart   as integer no-undo.
     1037      do:
     1038      OMRc = 0.
     1039      do vi = 1 to 4:
     1040         define variable vsimb as character no-undo.
     1041         vsimb = substring(iMRC,vi,1).
     1042         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1043         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1044         if vfound > 0
     1045         then
     1046            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1047         end.
     1048         OMRc = OMRc / 100.
     1049      end.
     1050      return OMRc.
     1051   end.
     1052   function getMRCByDM return decimal
     1053   (iDm as char):
     1054      define variable vMRC     as character no-undo.
     1055      define variable oMrc     as decimal no-undo init ?.
     1056      define variable Velement as character no-undo init "empty".
     1057      define variable vteg as character no-undo.
     1058      define variable vtegval as character no-undo.
     1059      if    length(idm) eq 14 + 7 + 4 + 4
     1060         or length(idm) eq 14 + 7 + 4
     1061      then do:
     1062         vMRC = substring(idm,22,4).
     1063         omrc = getMRC4(vMRC).
     1064      end.
     1065      else do:
     1066          ChekTypeMarkByDm(iDm).
     1067          block-mrc:
     1068          do while Velement ne "" and idm ne "":
     1069             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1070             if Velement begins "8005"
     1071             then do:
     1072                vMRC = substring(Velement,5,6).
     1073                leave block-mrc.
     1074             end.
     1075             else if Velement begins "(8005)"
     1076             then do:
     1077                vMRC = substring(Velement,7,6).
     1078                leave block-mrc.
     1079             end.
     1080          end.
     1081          if vMRC ne ""
     1082          then
     1083             OMRc = dec(vmrc) / 100 no-error.
     1084      end.
     1085      return OMRc.
     1086   end.
     1087   function MoveDate return Date
     1088   (idate as date,
     1089    iMonth as int64):
     1090      define variable vMonth   as int64 no-undo.
     1091      define variable vYear    as int64 no-undo.
     1092      define variable vDateNew as date  no-undo.
     1093       define variable vDay     as int64 no-undo.
     1094       vMonth = month(iDate) + iMonth.
     1095       vYear =  year(iDate).
     1096       if vMonth <= 0
     1097       then assign
     1098          vMonth = vMonth + 12
     1099           vYear  = vYear - 1
     1100       .
     1101       else if vMonth > 12
     1102       then assign
     1103          vMonth = vMonth - 12
     1104           vYear  = vYear + 1
     1105       .
     1106       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1107       do while error-status:error eq yes:
     1108          VDay = vDay + 1.
     1109          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1110       end.
     1111       if VDay > 0
     1112       then
     1113          vDateNew + 1.
     1114       return vDateNew.
     1115   end.
     1116   procedure checkEMRC:
     1117   define input  parameter iDm as character no-undo.
     1118   define output parameter vok as logical   no-undo init yes.
     1119      define variable v-value-emrc as character no-undo.
     1120      define variable v-type-emrc  as character no-undo.
     1121      define variable vDateIso     as character no-undo.
     1122      define variable vMRC         as decimal no-undo.
     1123      define variable vqnty        as decimal no-undo.
     1124      define variable vPrice       as decimal no-undo.
     1125      define variable vparent      as character no-undo.
     1126      define variable vgds-code    as integer no-undo.
     1127      define buffer code for ub.code.
     1128      vMRC = getMRCByDM(iDm).
     1129      if vMRC > 0
     1130      then do:
     1131         vgds-code = getGdsCodeByDM(iDm).
     1132         vqnty     = getQntyUTDByDM(iDm).
     1133               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1134            (
     1135             input   vgds-code
     1136            ,input   'emrc-type':U
     1137            ,output   v-value-emrc
     1138            ,output   v-type-emrc
     1139          ) no-error.
     1140          if     v-value-emrc ne ""
     1141             and v-value-emrc ne ?
     1142          then do:
     1143             vDateIso = iso-date(today).
     1144             vPrice = vMRC / vqnty.
     1145             vparent ="emc" + chr(4) + v-value-emrc.
     1146             find last code where Code.parent      eq vparent
     1147                              and Code.code        le vDateIso
     1148                              and code.status_  eq 0
     1149             no-lock no-error.
     1150             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1151             then
     1152                vOk = true .
     1153             else do:
     1154                 define variable vText      as character no-undo.
     1155                 define variable vDate      as date no-undo.
     1156                 define variable vDateLast  as character no-undo.
     1157                 define variable vDateFirst as character no-undo.
     1158                 define variable vDate3     as date no-undo.
     1159                 vdate = date(code.misc1).
     1160                 vDateLast = code.misc1.
     1161                 vDate3 = MoveDate(today, - 3 ).
     1162                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1163                                      string(vDate3  , "99/99/9999"),
     1164                                      string(vDate   , "99/99/9999")
     1165                                      ).
     1166                 vdateIso = iso-date(vdate3).
     1167                 find last code  where Code.parent      eq vparent
     1168                                   and Code.code        le vDateIso
     1169                                   and code.status_  eq 0 no-lock no-error.
     1170                 if available code
     1171                 then
     1172                    vDateIso = code.code.
     1173                 vDateFirst = vDateIso.
     1174                 vDateLast = iso-date(vdate).
     1175                 define variable vGood as logical no-undo.
     1176                 define variable vDateSale as date no-undo.
     1177                 define buffer bcode for code.
     1178                 for last code where Code.parent   eq vparent
     1179                                 and code.status_  eq 0
     1180                                 and code.code     < vDateLast
     1181                                 and code.code     >= vDateFirst
     1182                 no-lock:
     1183                    find first bcode where bCode.parent   eq vparent
     1184                                       and bcode.status_  eq 0
     1185                                       and bcode.code     > code.code no-lock no-error.
     1186                    if available bcode
     1187                    then do:
     1188                       if vPrice < dec(Code.CodeValue)
     1189                       then
     1190                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1191                                                     chr(10),
     1192                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1193                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1194                                                     ).
     1195                       else do:
     1196                          vGood = yes.
     1197                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1198                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1199                                                     chr(10),
     1200                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1201                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1202                                                     string(         vDateSale            ,"99/99/9999"),
     1203                                                     string(vDateSale - today)
     1204                                                     ).
     1205                       end.
     1206                    end.
     1207                 end.
     1208                 if vgood
     1209                 then do:
     1210                    define variable choice as integer no-undo .
     1211                    run gbl/d-askw.w (input "Уточнение"
     1212                           ,input  vText
     1213                           ,input "|"
     1214                           ,input "Принять|Вернуть"
     1215                           ,input "Принять данный товар|Вернуть товар постащику"
     1216                           ,input 1
     1217                           ,input 2
     1218                           ,output choice) no-error.
     1219                    vok = choice eq 1.
     1220                 end.
     1221                 else
     1222                    vok =false.
     1223             end.
     1224          end.
     1225      end.
     1226   end.
     1227   function addGs2Mark return character
     1228   (iMark as char):
     1229      define variable vDM   as character no-undo.
     1230      define variable vIdx  as integer   no-undo.
     1231      if index(iMark,chr(29),1) > 0
     1232      then return iMark.
     1233      if substring(iMark,26,4) = "8005" then
     1234      do:
     1235        vIdx = index(iMark,"93",26 + 4 + 5).
     1236        if vIdx > 1 then do:
     1237          vDM = substitute("&1&4&2&4&3",
     1238                           substring(iMark,1,25),
     1239                           substring(iMark,26,vIdx - 25 - 1),
     1240                           substring(iMark,vIdx),
     1241                           chr(29)) no-error.
     1242          vIdx = index(vDm,"240",vIdx + 4).
     1243          if vIdx > 0 then
     1244          do:
     1245            vDM = substitute("&1&3&2",
     1246                             substring(vDm,1,vIdx - 1),
     1247                             substring(vDm,vIdx),
     1248                             chr(29)) no-error.
     1249          end.
     1250        end.
     1251        else
     1252          vDM = substitute("&1&3&2",
     1253                           substring(iMark,1,25),
     1254                           substring(iMark,26),
     1255                           chr(29)) no-error.
     1256      end.
     1257      else if substring(iMark,32,2) = "91" then
     1258      do:
     1259        vIdx = index(iMark,"92",32).
     1260        if vIdx > 1 then
     1261          vDM = substitute("&1&4&2&4&3",
     1262                           substring(iMark,1,31),
     1263                           substring(iMark,32,vIdx - 31 - 1),
     1264                           substring(iMark,vIdx),
     1265                           chr(29)) no-error.
     1266        else
     1267          vDM = substitute("&1&3&2",
     1268                           substring(iMark,1,31),
     1269                           substring(iMark,32),
     1270                           chr(29)) no-error.
     1271      end.
     1272      else if substring(iMark,39,2) = "91" then
     1273      do:
     1274        vIdx = index(iMark,"92",38).
     1275        if vIdx > 1 then
     1276          vDM = substitute("&1&4&2&4&3",
     1277                           substring(iMark,1,38),
     1278                           substring(iMark,39,vIdx - 38 - 1),
     1279                           substring(iMark,vIdx),
     1280                           chr(29)) no-error.
     1281        else
     1282          vDM = substitute("&1&3&2",
     1283                           substring(iMark,1,38),
     1284                           substring(iMark,39),
     1285                           chr(29)) no-error.
     1286      end.
     1287      else if substring(iMark,25,2) = "93" then
     1288      do:
     1289        vIdx = index(iMark,"92",25).
     1290        if vIdx > 1 then
     1291          vDM = substitute("&1&4&2&4&3",
     1292                           substring(iMark,1,24),
     1293                           substring(iMark,25,vIdx - 24 - 1),
     1294                           substring(iMark,vIdx),
     1295                           chr(29)) no-error.
     1296        else
     1297          vIdx = index(iMark,"3103",25).
     1298          if vIdx > 0 then
     1299          vDM = substitute("&1&4&2&4&3",
     1300                           substring(iMark,1,24),
     1301                           substring(iMark,25,vIdx - 24 - 1),
     1302                           substring(iMark,vIdx),
     1303                           chr(29)) no-error.
     1304          else
     1305            vDM = substitute("&1&3&2",
     1306                             substring(iMark,1,24),
     1307                             substring(iMark,25),
     1308                             chr(29)) no-error.
     1309      end.
     1310      else if substring(iMark,32,2) = "93" then
     1311      do:
     1312        vDM = substitute("&1&3&2",
     1313              substring(iMark,1,31),
     1314              substring(iMark,32),
     1315              chr(29)) no-error.
     1316      end.
     1317      return if vDM <> "" then vDm else iMark.
     1318   end.
     1319   define variable mPublishHand as handle           no-undo.
     1320   define variable mDiadocApi   as component-handle no-undo.
     1321   define stream File-stream.
     1322   define variable mdebug as logical no-undo.
     1323   mdebug = session:debug-alert.
     1324   function PutMes returns character
     1325   (idext as character ):
     1326      if valid-handle(mPublishHand)
     1327      then
     1328         publish "WriteLogAsunc" from mPublishHand (idext,yes).
     1329      else do:
     1330         if idext begins "error"
     1331         then do:
     1332            message substring (idext,6)
     1333               view-as alert-box.
     1334            if mDiadocApi ne ?
     1335            then
     1336               idext = substitute ("&1 (&2)",idext , mDiadocApi:GetFullVersion())no-error.
     1337         end.
     1338         output stream File-stream to "diadoc_user.log" append.
     1339         put stream File-stream unformatted now " " idext skip.
     1340         output stream File-stream close.
     1341      end.
     1342   end.
     1343   function PutErr returns character
     1344   (idext as character ):
     1345      define variable vi as integer no-undo.
     1346      define variable vnumerr as integer no-undo.
     1347      define variable vtext as character extent 25 no-undo .
     1348      if error-status:num-messages > 0 then do:
     1349         vnumerr = error-status:num-messages.
     1350         vnumerr = min(vnumerr,extent(vtext)).
     1351         do vi = 1 to vnumerr:
     1352            vtext[vi] = error-status:get-message(vi).
     1353         end.
     1354         idext = idext + chr(10) + "Ошибка: [":U.
     1355         do vi = 1 to vnumerr:
     1356            idext = idext + chr(10) + vtext[vi] no-error.
     1357         end.
     1358         idext = idext +  chr(10) +  " ]" no-error.
     1359         if not  idext begins "Error"
     1360         then
     1361            idext = "Error " + idext.
     1362         PutMes(idext).
     1363      end.
     1364   end.
     1365   function PutStat returns character
     1366   (itext as character,
     1367    iflag as logical):
     1368      if valid-handle(mPublishHand)
     1369      then
     1370         publish "PutStatAsunc" from mPublishHand (itext,iflag).
     1371      PutMes(itext).
     1372   end.
     1373   function chekStop returns logical
     1374   ( ):
     1375      define variable oStop as logical no-undo.
     1376      if valid-handle(mPublishHand)
     1377      then
     1378         publish "StopProc" from mPublishHand (output oStop).
     1379      return oStop.
     1380   end.
     1381   function  putloggetdesc returns logical
     1382   (is1 as character ,is2 as character ,
     1383   is3 as character ):
     1384   end.
     1385   function  getdesc returns logical
     1386   (input iObj as component-handle):
     1387      if iObj eq ? then return false.
     1388      if mdebug
     1389      then do:
     1390      output stream File-stream to "diadoc_load.txt" append.
     1391      define variable vReflector as component-handle no-undo.
     1392      define variable vDescobj  as component-handle no-undo.
     1393      define variable vPropertyNames  as component-handle no-undo.
     1394      define variable vMethodsNames as component-handle no-undo.
     1395      define variable vMethodDesc as component-handle no-undo.
     1396      define variable vMethodsName as character  no-undo.
     1397      define variable vPropertyValue as char no-undo.
     1398      create "Diadoc.Reflector" vReflector.
     1399      vDescobj = vReflector:Describe(iObj).
     1400     put   stream File-stream  unformatted skip (1)
     1401      "------------------------------------------" skip
     1402      vDescobj:GetInterfaceName() skip.
     1403      define variable vPropertyName as character no-undo.
     1404      define variable vPropertyType as character no-undo.
     1405      .
     1406      putloggetdesc(vDescobj:GetInterfaceName(),"","").
     1407      putloggetdesc("property","","").
     1408      define variable vi as integer no-undo.
     1409      define variable vii as integer no-undo.
     1410     put stream File-stream  unformatted skip "property" skip.
     1411     vPropertyNames = vDescobj:GetPropertiesNames().
     1412      vi= vPropertyNames:count.
     1413      do vi= 1 to vPropertyNames:count :
     1414         vPropertyName = "".
     1415         vPropertyType = "".
     1416         vPropertyValue = "".
     1417         vPropertyName  = vPropertyNames:GetItem(vi - 1) no-error.
     1418         vPropertyType  = vDescobj:GetPropertyType(vPropertyName) no-error .
     1419         vPropertyValue = substring((vDescobj:GetProperty(vPropertyName)),1,4000) no-error.
     1420         putloggetdesc(vPropertyName,vPropertyType,vPropertyValue).
     1421        put stream File-stream  unformatted vPropertyName " " vPropertyType  " " vPropertyValue skip.
     1422      end.
     1423      release object vPropertyNames.
     1424      put stream File-stream  unformatted skip "method" skip.
     1425      vMethodsNames = vDescobj:GetMethodsNames().
     1426      vi = vMethodsNames:count.
     1427      do vi = 1 to vMethodsNames:count :
     1428         vMethodsName = "".
     1429         vMethodsName = vMethodsNames:GetItem(vi - 1)no-error.
     1430         vMethodDesc  = vDescobj:GetMethodDesc(vMethodsName)no-error.
     1431         putloggetdesc("method",vMethodsName, vMethodDesc:RetVal).
     1432         put stream File-stream  unformatted vMethodsName  " retval " vMethodDesc:RetVal skip.
     1433         do vii  = 1 to vMethodDesc:args:count:
     1434            define variable varg as character no-undo.
     1435            varg = "".
     1436            varg = vMethodDesc:args:GetItem(vii - 1) no-error.
     1437            put stream File-stream  unformatted " args " varg  skip .
     1438            putloggetdesc(" args ",varg, "").
     1439         end.
     1440         release object vMethodDesc.
     1441      end.
     1442      release object vMethodsNames.
     1443      put stream File-stream  unformatted "end---------------------------------------" skip.
     1444      output stream File-stream close.
     1445      release object vDescobj.
     1446      release object vReflector.
     1447      end.
     1448      return true.
     1449   end.
     1450   function getxsddocum returns logical
     1451   (iOrganization as component-handle):
     1452      if iOrganization eq ? then return false.
     1453      define variable vDocumentTypes as component-handle no-undo.
     1454      define variable vDocumentType as component-handle no-undo.
     1455      define variable vFunctions as component-handle no-undo.
     1456      define variable vFunction as component-handle no-undo.
     1457      define variable vVersions as component-handle no-undo.
     1458      define variable vVersion as component-handle no-undo.
     1459      define variable vTitles as component-handle no-undo.
     1460      define variable vTitle as component-handle no-undo.
     1461      define variable vi as integer no-undo.
     1462      define variable vii as integer no-undo.
     1463      define variable viii as integer no-undo.
     1464      define variable viiii as integer no-undo.
     1465      if mdebug
     1466      then do:
     1467      output stream File-stream to "diadoc_doc.txt" append.
     1468      vDocumentTypes = iOrganization:GetDocumentTypes().
     1469      do vi =1 to vDocumentTypes:count:
     1470         vDocumentType = vDocumentTypes:GetItem(vi - 1).
     1471         put stream File-stream  unformatted "DocumentType -> NAme " vDocumentType:name skip.
     1472         put stream File-stream  unformatted "DocumentType -> Title " vDocumentType:Title skip.
     1473         vFunctions = vDocumentType:Functions.
     1474         do vii =1 to vFunctions:count:
     1475            vFunction = vFunctions:GetItem(vii - 1 ).
     1476            put stream File-stream  unformatted "DocumentType -> Function -> NAme " vFunction:name skip.
     1477            vVersions = vFunction:Versions.
     1478            do viii =1 to vVersions:count:
     1479               vVersion = vVersions:GetItem(viii - 1 ).
     1480               put stream File-stream  unformatted "DocumentType -> Function -> Version -> version " vVersion:version skip.
     1481               put stream File-stream  unformatted "DocumentType -> Function -> Version -> IsActual " vVersion:IsActual skip.
     1482               vTitles  = vVersion:Titles.
     1483               do viiii =1 to vTitles:count:
     1484                  vTitle = vTitles:GetItem(viiii - 1 ).
     1485                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> IsFormal " vTitle:IsFormal skip.
     1486                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> XsdUrl " vTitle:XsdUrl skip.
     1487                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> HaveUserDataXSD " vTitle:HaveUserDataXSD skip.
     1488                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> type " vTitle:type skip.
     1489                  release object vTitle.
     1490               end.
     1491              release object vTitles.
     1492               release object vVersion.
     1493            end.
     1494            release object vVersions.
     1495            release object vFunction.
     1496         end.
     1497         release object vFunctions.
     1498         release object vDocumentType.
     1499      end.
     1500      release object vDocumentTypes.
     1501      put stream File-stream  unformatted "--------------------------------------------------- " skip.
     1502     output stream File-stream close.
     1503     end.
     1504      return true.
     1505   end.
     1506   define buffer buf_utd               for ub.utd .
     1507   define buffer buf_utd-file          for ub.utd-attr .
     1508   define buffer buf_utd-lines         for ub.utd-lines .
     1509   define buffer buf_utd-lines-attr    for ub.utd-lines-attr .
     1510   define buffer buf_utd-marking-lines for ub.utd-marking-lines .
     1511   define buffer buf_code              for ub.Code .
     1512   define buffer buf_marking           for ub.marking .
     1513   define buffer buf_marking-lines     for ub.marking-lines .
     1514   define buffer buf_firm              for ub.firm .
     1515   define buffer buf_shop              for ub.shop .
     1516   define buffer buf_clients           for ub.clients .
     1517   define buffer buf_goods             for ub.goods .
     1518   define variable filename_        as character        no-undo .
     1519   define variable logname          as character        no-undo .
     1520   define variable v-nds            as decimal          no-undo .
     1521   define variable v-qnty-scan      as decimal          no-undo .
     1522   define variable hSAXWriter       as handle           no-undo.
     1523   define variable v-doc-level      as integer          no-undo .
     1524   define variable v-total-min      as decimal          no-undo .
     1525   define variable v-vat-min        as decimal          no-undo .
     1526   define variable v-sum-after      as decimal          no-undo .
     1527   define variable v-total-max      as decimal          no-undo .
     1528   define variable v-vat-max        as decimal          no-undo .
     1529   define variable vOrganization    as component-handle no-undo.
     1530   define variable vUserperm        as component-handle no-undo.
     1531   define variable vUser            as component-handle no-undo.
     1532   define variable vCounteragent    as component-handle no-undo.
     1533   define variable vCounteragentOrg as component-handle no-undo.
     1534   logname = session:temp-directory + "UPD_" + string(i-doc-id) + "_log.txt".
     1535   filename_ = "UPD_" + string (i-db-num) + "_" + string (i-doc-id) + ".xml".
     1536   find first buf_utd no-lock where buf_utd.db-num eq i-db-num and buf_utd.doc-id = i-doc-id no-error .
     1537   if not available (buf_utd) then return error .
     1538   vOrganization = iDiadocConnection:GetOrganizationById(iORGGuid) no-error.
     1539   if vOrganization eq ?
     1540     then
     1541   do:
     1542     PutErr(substitute ("Нет доступа к организации &1",iORGGuid) ).
     1543     return.
     1544   end.
     1545   vCounteragent = vOrganization:GetCounteragentById(iContGuid).
     1546   find first buf_clients no-lock where buf_clients.obj-code = v-cntxt-obj-code and
     1547     buf_clients.obj-type = v-cntxt-obj-type no-error .
     1548   create sax-writer hSAXWriter.
     1549   hSAXWriter:set-output-destination("file":U, filename_ ).
     1550   hSAXWriter:formatted = true.
     1551   hSAXWriter:encoding = "windows-1251".
     1552   hSAXWriter:start-document().
     1553   hSAXWriter:start-element ("Файл":U).
     1554   define variable mFileName as character no-undo.
     1555   block-mark:
     1556   for each buf_utd-marking-lines  where
     1557     buf_utd-marking-lines.db-num = buf_utd.db-num and
     1558     buf_utd-marking-lines.doc-id = buf_utd.doc-id
     1559     no-lock:
     1560     if ismark(buf_utd-marking-lines.mark)
     1561       then
     1562       leave block-mark.
     1563   end.
     1564   mFileName = substitute ("ON_NSCHFDOPPR&1_&2_&3_&4&5&6_3440B5E2-B3EA-1EEA-9EE0-52DE60B58235"
     1565     , if available buf_utd-marking-lines then  "MARK" else ""
     1566     , vCounteragent:FnsParticipantId
     1567     , vOrganization:FnsParticipantId
     1568     ,STRING(YEAR(TODAY),"9999")
     1569     ,STRING(monTH(TODAY),"99")
     1570     ,STRING(DAY(TODAY),"99")
     1571     ).
     1572   hSAXWriter:insert-attribute ("ИдФайл", mFileName) no-error.
     1573   hSAXWriter:insert-attribute ("ВерсФорм", "5.01") no-error.
     1574   hSAXWriter:insert-attribute ("ВерсПрог", "Diadoc 1.0") no-error.
     1575   do:
     1576     hSAXWriter:start-element("СвУчДокОбор":U) no-error.
     1577     hSAXWriter:insert-attribute ("ИдОтпр":U, string(vOrganization:FnsParticipantId)) no-error.
     1578     hSAXWriter:insert-attribute ("ИдПол":U, string(vCounteragent:FnsParticipantId)) no-error.
     1579     do:
     1580       hSAXWriter:write-empty-element("СвОЭДОтпр":U) no-error.
     1581       hSAXWriter:insert-attribute("ИННЮЛ":U, "6663003127") no-error.
     1582       hSAXWriter:insert-attribute("ИдЭДО":U, "2BM") no-error.
     1583       hSAXWriter:insert-attribute("НаимОрг":U, "АО ПФ СКБ Контур") no-error.
     1584     end.
     1585     hSAXWriter:end-element("СвУчДокОбор":U) no-error.
     1586     hSAXWriter:start-element("Документ":U) no-error.
     1587     hSAXWriter:insert-attribute ("КНД":U, "1115131") no-error.
     1588     hSAXWriter:insert-attribute ("Функция":U, iTypeUTD) no-error.
     1589     hSAXWriter:insert-attribute ("ПоФактХЖ":U, "Документ об отгрузке товаров (выполнении работ), передаче имущественных прав (документ об оказании услуг)") no-error.
     1590     hSAXWriter:insert-attribute ("НаимДокОпр":U, "Счет-фактура и документ об отгрузке товаров (выполнении работ), передаче имущественных прав (документ об оказании услуг)") no-error.
     1591     hSAXWriter:insert-attribute ("ДатаИнфПр":U, string(today,"99.99.9999")) no-error.
     1592     hSAXWriter:insert-attribute ("ВремИнфПр":U, replace(string(time,"HH:MM:SS"),":",".")) no-error.
     1593     hSAXWriter:insert-attribute ("НаимЭконСубСост":U, buf_clients.obj-name) no-error.
     1594     do:
     1595       hSAXWriter:start-element("СвСчФакт":U) no-error.
     1596       hSAXWriter:insert-attribute ("НомерСчФ":U, buf_utd.DocumentNumber) no-error.
     1597       hSAXWriter:insert-attribute ("ДатаСчФ":U, string(buf_utd.DocumentDate,"99.99.9999")) no-error.
     1598       hSAXWriter:insert-attribute ("КодОКВ":U, "643") no-error.
     1599       do:
     1600         hSAXWriter:write-empty-element("ИспрСчФ":U) no-error.
     1601         hSAXWriter:insert-attribute("ДефНомИспрСчФ":U, "-") no-error.
     1602         hSAXWriter:insert-attribute("ДефДатаИспрСчФ":U, "-") no-error.
     1603         hSAXWriter:start-element("СвПрод":U) no-error.
     1604         do:
     1605           run proc-init(1, vOrganization) no-error .
     1606           if error-status:error
     1607           then
     1608              return error .
     1609         end.
     1610         hSAXWriter:end-element("СвПрод":U) no-error.
     1611         hSAXWriter:start-element("СвПокуп":U) no-error.
     1612         do:
     1613           run proc-init(2, vCounteragent) no-error .
     1614           if error-status:error
     1615           then
     1616              return error.
     1617         end.
     1618         hSAXWriter:end-element("СвПокуп":U) no-error.
     1619         hSAXWriter:start-element("ИнфПолФХЖ1":U) no-error.
     1620         do:
     1621           if buf_utd.PackageId ne ""
     1622             then
     1623           do:
     1624             hSAXWriter:write-empty-element("ТекстИнф":U) no-error.
     1625             hSAXWriter:insert-attribute("Идентиф":U, "id_pack_th") no-error.
     1626             hSAXWriter:insert-attribute("Значен":U, buf_utd.PackageId) no-error.
     1627           end.
     1628           hSAXWriter:write-empty-element("ТекстИнф":U) no-error.
     1629           hSAXWriter:insert-attribute("Идентиф":U, "id_doc_th") no-error.
     1630           hSAXWriter:insert-attribute("Значен":U, substitute ("&1_&2",buf_utd.db-num,buf_utd.doc-id)) no-error.
     1631         end.
     1632         hSAXWriter:end-element("ИнфПолФХЖ1":U) no-error.
     1633       end.
     1634       hSAXWriter:end-element("СвСчФакт":U) no-error.
     1635       hSAXWriter:start-element("ТаблСчФакт":U) no-error.
     1636       do:
     1637         for each buf_utd-lines no-lock where buf_utd-lines.db-num = buf_utd.db-num and
     1638           buf_utd-lines.doc-id = buf_utd.doc-id:
     1639           hSAXWriter:start-element("СведТов":U) no-error.
     1640           hSAXWriter:insert-attribute ("НомСтр":U, string(buf_utd-lines.LineNum)) no-error.
     1641           hSAXWriter:insert-attribute ("НаимТов":U, string(buf_utd-lines.ProductCode)) no-error.
     1642           find first units no-lock where units.unit-name = buf_utd-lines.UnitCode no-error .
     1643           if available (units)
     1644             and  units.OKEI ne 0
     1645             then
     1646             hSAXWriter:insert-attribute ("ОКЕИ_Тов":U, string(units.OKEI,"999")) no-error.
     1647           else
     1648             hSAXWriter:insert-attribute ("ДефОКЕИ_Тов":U,  "-") no-error.
     1649           hSAXWriter:insert-attribute ("КолТов":U, string (buf_utd-lines.Quantity)) no-error.
     1650           hSAXWriter:insert-attribute ("ЦенаТов":U, trim(string(buf_utd-lines.Price,">>>>>>>>>>>>9.99"))) no-error.
     1651           hSAXWriter:insert-attribute ("СтТовБезНДС":U, trim(string(buf_utd-lines.TotalWithVatExcluded,">>>>>>>>>>>>9.99"))) no-error.
     1652           hSAXWriter:insert-attribute ("НалСт":U, TRIM(string(buf_utd-lines.TaxRate, ">9")) + "%") no-error.
     1653           hSAXWriter:insert-attribute ("СтТовУчНал":U, trim(string(buf_utd-lines.Total,">>>>>>>>>>>>9.99"))) no-error.
     1654           do:
     1655             hSAXWriter:start-element("Акциз":U) no-error.
     1656             do:
     1657               hSAXWriter:start-element("БезАкциз") no-error.
     1658               hsaxwriter:write-characters("без акциза") no-error.
     1659               hSAXWriter:end-element("БезАкциз":U) no-error.
     1660             end.
     1661             hSAXWriter:end-element("Акциз":U) no-error.
     1662             hSAXWriter:start-element("СумНал":U) no-error.
     1663             do:
     1664               hSAXWriter:start-element("СумНал":U) no-error.
     1665               hSAXWriter:write-characters (trim(string(buf_utd-lines.Vat,">>>>>>>>>>>>9.99"))) no-error .
     1666               hSAXWriter:end-element("СумНал":U) no-error.
     1667             end.
     1668             hSAXWriter:end-element("СумНал":U) no-error.
     1669             hSAXWriter:start-element("ДопСведТов":U) no-error.
     1670             do:
     1671               find first buf_goods where buf_goods.gds-code eq buf_utd-lines.gds-code no-lock no-error.
     1672               if available buf_goods or buf_utd-lines.Articl ne ""
     1673                 then
     1674                 hSAXWriter:insert-attribute("АртикулТов":U, string(if available (buf_goods) then buf_goods.artic else buf_utd-lines.Article)) no-error.
     1675               if available buf_goods or buf_utd-lines.UnitCode ne ""
     1676                 then
     1677                 hSAXWriter:insert-attribute("НаимЕдИзм":U, string(if available (buf_goods) then buf_goods.unit-base else buf_utd-lines.UnitCode)) no-error.
     1678               hSAXWriter:insert-attribute("ПрТовРаб":U, "1") no-error.
     1679               define variable Vfrist as logical no-undo.
     1680               Vfrist = yes.
     1681               for each buf_utd-marking-lines no-lock where
     1682                 buf_utd-marking-lines.db-num = buf_utd-lines.db-num and
     1683                 buf_utd-marking-lines.doc-id = buf_utd-lines.doc-id and
     1684                 buf_utd-marking-lines.LineNum = buf_utd-lines.LineNum and
     1685                 buf_utd-marking-lines.doc-level eq 1:
     1686                 define variable vTeg as character no-undo.
     1687                 if isMark(buf_utd-marking-lines.mark)
     1688                   then
     1689                 do:
     1690                   find first marking where marking.mark eq buf_utd-marking-lines.mark no-lock no-error.
     1691                   if available marking
     1692                     and marking.box-qnty > 1
     1693                     then
     1694                   do:
     1695                     vTeg = "НомУпак".
     1696                   end.
     1697                   else
     1698                     vTeg = "НомУпак".
     1699                 end.
     1700                 else if ISOAD(buf_utd-marking-lines.mark)
     1701                     then
     1702                     vTeg = "НомУпак".
     1703                   else
     1704                     vTeg = "".
     1705                 if vTeg ne ""
     1706                   then
     1707                 do:
     1708                   if vfrist
     1709                     then
     1710                   do:
     1711                     vfrist = no.
     1712                     hSAXWriter:start-element("НомСредИдентТов":U) no-error.
     1713                   end.
     1714                   hSAXWriter:start-element(vTeg) no-error.
     1715                   hSAXWriter:write-characters(buf_utd-marking-lines.mark) no-error.
     1716                   hSAXWriter:end-element(vTeg) no-error.
     1717                 end.
     1718               end.
     1719               if not vfrist
     1720                 then
     1721                 hSAXWriter:end-element("НомСредИдентТов":U).
     1722             end.
     1723             hSAXWriter:end-element("ДопСведТов":U).
     1724             for each bar-code where bar-code.gds-code eq buf_utd-lines.gds-code no-lock:
     1725               for each prod-bc where prod-bc.b-code eq bar-code.b-code
     1726                 and prod-bc.bc-on
     1727                 no-lock:
     1728                 if    length(prod-bc.b-str) eq 13
     1729                   or length(prod-bc.b-str) eq 8
     1730                   then
     1731                 do:
     1732                   define variable bar_code as character no-undo.
     1733                   bar_code = substr (prod-bc.b-str, 1, length (prod-bc.b-str) - 1).
     1734                   run str/chk-sum.p
     1735                     (input-output bar_code ) no-error .
     1736                   if prod-bc.b-str ne  bar_code
     1737                     then
     1738                   do:
     1739                     hSAXWriter:write-empty-element("ИнфПолФХЖ2":U) no-error.
     1740                     hSAXWriter:insert-attribute("Идентиф":U, "штрихкод") no-error.
     1741                     hSAXWriter:insert-attribute("Значен":U, prod-bc.b-str) no-error.
     1742                     hSAXWriter:write-empty-element("ИнфПолФХЖ2":U) no-error.
     1743                     hSAXWriter:insert-attribute("Идентиф":U, "EAN") no-error.
     1744                     hSAXWriter:insert-attribute("Значен":U, prod-bc.b-str) no-error.
     1745                   end.
     1746                 end.
     1747               end.
     1748             end.
     1749           end.
     1750           hSAXWriter:end-element("СведТов":U).
     1751         end.
     1752         hSAXWriter:start-element("ВсегоОпл":U) no-error.
     1753         hSAXWriter:insert-attribute ("СтТовБезНДСВсего":U, string (buf_utd.Total - buf_utd.Vat)) no-error.
     1754         hSAXWriter:insert-attribute ("СтТовУчНалВсего":U, string (buf_utd.Total)) no-error.
     1755         do:
     1756           hSAXWriter:start-element("СумНалВсего":U) no-error.
     1757           do:
     1758             hSAXWriter:start-element("СумНал":U) no-error.
     1759             hSAXWriter:write-characters(trim(string (buf_utd.Vat,">>>>>>>>>>>>9.99"))) no-error.
     1760             hSAXWriter:end-element("СумНал":U) no-error.
     1761           end.
     1762           hSAXWriter:end-element("СумНалВсего":U) no-error.
     1763         end.
     1764         hSAXWriter:end-element("ВсегоОпл":U) no-error.
     1765       end.
     1766       hSAXWriter:end-element("ТаблСчФакт":U) no-error.
     1767       hSAXWriter:start-element("СвПродПер":U) no-error.
     1768       do:
     1769         hSAXWriter:start-element("СвПер":U) no-error.
     1770         hSAXWriter:insert-attribute("СодОпер":U, "Товары переданы") no-error.
     1771         hSAXWriter:insert-attribute("ДатаПер":U, string(today,"99.99.9999")) no-error.
     1772         do:
     1773           hSAXWriter:write-empty-element("ОснПер":U) no-error.
     1774           hSAXWriter:insert-attribute("НаимОсн":U, "договор") no-error.
     1775           find first contract where contract.contract-code eq buf_utd.contract-code no-lock no-error.
     1776           if available contract
     1777             then
     1778           do:
     1779             hSAXWriter:insert-attribute("НомОсн":U, contract.contract-prn-code) no-error.
     1780             hSAXWriter:insert-attribute("ДатаОсн":U, string(contract.contract-date,"99.99.9999")) no-error.
     1781           end.
     1782         end.
     1783         hSAXWriter:end-element ("СвПер":U) no-error.
     1784       end.
     1785       hSAXWriter:end-element("СвПродПер":U) no-error.
     1786       hSAXWriter:start-element("Подписант":U) no-error.
     1787       hSAXWriter:insert-attribute ("ОснПолн":U, "Должностные обязанности") no-error.
     1788       hSAXWriter:insert-attribute ("ОблПолн":U, "0") no-error.
     1789       hSAXWriter:insert-attribute ("Статус":U, "1") no-error.
     1790       do:
     1791         hSAXWriter:start-element("ЮЛ":U) no-error.
     1792         do:
     1793           vUserperm = vOrganization:GetUserPermissions().
     1794           define variable vJobTitle as character no-undo.
     1795           vJobTitle = vUserperm:JobTitle.
     1796           if    vJobTitle eq ?
     1797             or vJobTitle eq ""
     1798             then
     1799             vJobTitle = iDiadocConnection:Certificate:JobTitle.
     1800           release object vUserperm.
     1801           hSAXWriter:insert-attribute ("ИННЮЛ":U, string(vOrganization:Inn)) no-error.
     1802           hSAXWriter:insert-attribute ("Должн":U, vJobTitle) no-error.
     1803           hSAXWriter:insert-attribute ("НаимОрг":U, string(vOrganization:Name)) no-error.
     1804           vUser = iDiadocConnection:GetMyUser().
     1805           hSAXWriter:write-empty-element("ФИО":U) no-error.
     1806           hSAXWriter:insert-attribute("Фамилия":U, string(vUser:LastName)) no-error.
     1807           hSAXWriter:insert-attribute("Имя":U, string(vUser:FirstName)) no-error.
     1808           hSAXWriter:insert-attribute("Отчество":U, string(vUser:MiddleName)) no-error.
     1809           release object vUser.
     1810         end.
     1811         hSAXWriter:end-element("ЮЛ":U) no-error.
     1812       end.
     1813       hSAXWriter:end-element("Подписант":U) no-error.
     1814     end.
     1815     hSAXWriter:end-element("Документ":U) no-error.
     1816   end.
     1817   hSAXWriter:end-element("Файл":U) no-error.
     1818   hSAXWriter:end-document().
     1819   release object vOrganization.
     1820   release object vCounteragent.
     1821   delete object hSAXWriter no-error.
     1822   procedure proc-init:
     1823     define input parameter v-client as integer no-undo .
     1824     define input parameter vOrg as component-handle no-undo .
     1825     define variable v-TH as logical no-undo .
     1826     case v-client:
     1827       when 1 then
     1828         do:
     1829           find first ub.sysconf no-lock no-error .
     1830           find first buf_clients no-lock where buf_clients.obj-code = ub.sysconf.host-code no-error .
     1831           find first buf_firm no-lock where buf_firm.firm-code = buf_clients.obj-code no-error .
     1832           if available (buf_clients) and available (buf_firm) then
     1833           do:
     1834             if buf_firm.inn <> "" and buf_firm.kpp <> "" and
     1835               buf_clients.obj-name <> "" and buf_clients.reg-code <> 0 then
     1836             do:
     1837               v-TH = true .
     1838             end.
     1839           end.
     1840         end.
     1841       when 2 then
     1842         do:
     1843           find first buf_clients no-lock where buf_clients.obj-code = buf_utd.cli-code and
     1844             buf_clients.obj-type = buf_utd.cli-type no-error .
     1845           find first buf_firm no-lock where buf_firm.firm-code = buf_clients.obj-code no-error .
     1846           if available (buf_clients) and available (buf_firm) then
     1847           do:
     1848             if buf_firm.inn <> "" and buf_firm.kpp <> "" and
     1849               buf_clients.obj-name <> "" and buf_clients.reg-code <> 0 then
     1850             do:
     1851               v-TH = true .
     1852             end.
     1853           end.
     1854         end.
     1855     end case .
     1856     if v-TH and buf_firm.okpo <> "" then
     1857       hSAXWriter:insert-attribute ("ОКПО":U, buf_firm.okpo) no-error.
     1858     hSAXWriter:start-element("ИдСв":U) no-error.
     1859     hSAXWriter:write-empty-element("СвЮЛУч":U) no-error.
     1860     if v-TH then
     1861     do:
     1862       hSAXWriter:insert-attribute("НаимОрг":U, string(buf_clients.obj-name)) no-error.
     1863       hSAXWriter:insert-attribute("ИННЮЛ":U, string(buf_firm.inn)) no-error.
     1864       hSAXWriter:insert-attribute("КПП":U, string(buf_firm.kpp)) no-error.
     1865     end.
     1866     else
     1867     do:
     1868       hSAXWriter:insert-attribute("НаимОрг":U, string(vOrg:name)) no-error.
     1869       hSAXWriter:insert-attribute("ИННЮЛ":U, string(vOrg:inn)) no-error.
     1870       hSAXWriter:insert-attribute("КПП":U, string(vOrg:kpp)) no-error.
     1871     end.
     1872     hSAXWriter:end-element("ИдСв":U) no-error.
     1873     hSAXWriter:start-element("Адрес":U) no-error.
     1874     do:
     1875       vCounteragentOrg = vOrg:GetCounteragentById(iContGuid) no-error.
     1876       if vCounteragentOrg eq ?
     1877       then do:
     1878          PutErr(substitute ("Нет доступа к организации &1",iORGGuid) ).
     1879          return error.
     1880       end.
     1881       getdesc(vCounteragentOrg).
     1882       getdesc(vCounteragentOrg:Address).
     1883       hSAXWriter:write-empty-element("АдрРФ":U) no-error.
     1884       if v-TH then hSAXWriter:insert-attribute("КодРегион":U, string(buf_clients.reg-code)) no-error.
     1885       else
     1886         hSAXWriter:insert-attribute("КодРегион":U, string(vCounteragentOrg:Address:RegionCode)) no-error.
     1887       if vCounteragentOrg:Address:Territory ne ""
     1888         then
     1889         hSAXWriter:insert-attribute("Район":U,     string(vCounteragentOrg:Address:Territory )) no-error.
     1890       if vCounteragentOrg:Address:City ne ""
     1891         then
     1892         hSAXWriter:insert-attribute("Город":U,     string(vCounteragentOrg:Address:City      )) no-error.
     1893       if vCounteragentOrg:Address:Street ne ""
     1894         then
     1895         hSAXWriter:insert-attribute("Улица":U,     string(vCounteragentOrg:Address:Street    )) no-error.
     1896       if vCounteragentOrg:Address:Building ne ""
     1897         then
     1898         hSAXWriter:insert-attribute("Дом":U,       string(vCounteragentOrg:Address:Building )) no-error.
     1899       if vCounteragentOrg:Address:Block ne ""
     1900         then
     1901         hSAXWriter:insert-attribute("Корпус":U,    string(vCounteragentOrg:Address:Block     )) no-error.
     1902       release object vCounteragentorg.
     1903     end.
     1904     hSAXWriter:end-element("Адрес":U) no-error.
     1905   end procedure .
