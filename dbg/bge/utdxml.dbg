      109   procedure xmlchar-test :
      110   define input parameter p-in-string          as character        no-undo.
      111   define output parameter p-out-string-enc    as character        no-undo.
      112   define output parameter p-out-string-dec    as character        no-undo.
      113   do
      114   on error undo, return error
      115   :
      116          run xmlchar-encode in this-procedure
      117       (
      118             input p-in-string
      119           , output p-out-string-enc
      120       ).
      121          run xmlchar-decode in this-procedure
      122       (
      123             input p-out-string-enc
      124           , output p-out-string-dec
      125       ).
      126   end.
      127   end .
      128   procedure xmlchar-encode :
      129   define input parameter p-in-string      as character        no-undo.
      130   define output parameter p-out-string    as character        no-undo.
      131       define variable v-position      as integer      no-undo.
      132       define variable v-current-char  as character    no-undo.
      133   do
      134   on error undo, return error
      135   :
      136       assign
      137           p-out-string = "":U
      138       .
      139       case p-in-string
      140       :
      141           when ?
      142           then do:
      143               assign
      144                   p-out-string = "?":U
      145               .
      146           end.
      147           when "?":U
      148           then do:
      149               assign
      150                   p-out-string = "&#63;":U
      151               .
      152           end.
      153           otherwise do:
      154               do v-position = 1 to length( p-in-string )
      155               :
      156                   assign
      157                       v-current-char = substring( p-in-string, v-position, 1 )
      158                   .
      159                   case v-current-char
      160                   :
      161                       when "&":U
      162                       then do:
      163                           assign
      164                               p-out-string = p-out-string + "&amp;":U
      165                           .
      166                       end.
      167                       when ">":U
      168                       then do:
      169                           assign
      170                               p-out-string = p-out-string + "&gt;":U
      171                           .
      172                       end.
      173                       when "<":U
      174                       then do:
      175                           assign
      176                               p-out-string = p-out-string + "&lt;":U
      177                           .
      178                       end.
      179                       when "'":U
      180                       then do:
      181                           assign
      182                               p-out-string = p-out-string + "&apos;":U
      183                           .
      184                       end.
      185                       when '"':U
      186                       then do:
      187                           assign
      188                               p-out-string = p-out-string + "&quot;":U
      189                           .
      190                       end.
      191                       when chr(1)
      192                       then do:
      193                           assign
      194                               p-out-string = p-out-string + "":U
      195                           .
      196                       end.
      197                       when chr(2)
      198                       then do:
      199                           assign
      200                               p-out-string = p-out-string + "":U
      201                           .
      202                       end.
      203                       when chr(3)
      204                       then do:
      205                           assign
      206                               p-out-string = p-out-string + "":U
      207                           .
      208                       end.
      209                       when chr(4)
      210                       then do:
      211                           assign
      212                               p-out-string = p-out-string + "":U
      213                           .
      214                       end.
      215                       when chr(5)
      216                       then do:
      217                           assign
      218                               p-out-string = p-out-string + "":U
      219                           .
      220                       end.
      221                       when chr(6)
      222                       then do:
      223                           assign
      224                               p-out-string = p-out-string + "":U
      225                           .
      226                       end.
      227                       when chr(7)
      228                       then do:
      229                           assign
      230                               p-out-string = p-out-string + "":U
      231                           .
      232                       end.
      233                       when chr(8)
      234                       then do:
      235                           assign
      236                               p-out-string = p-out-string + "":U
      237                           .
      238                       end.
      239                       when chr(9)
      240                       then do:
      241                           assign
      242                               p-out-string = p-out-string + "":U
      243                           .
      244                       end.
      245                       when chr(29)
      246                       then do:
      247                           assign
      248                               p-out-string = p-out-string + "":U
      249                           .
      250                       end.
      251                       when chr(10)
      252                       then do:
      253                           assign
      254                               p-out-string = p-out-string + "&#10;":U
      255                           .
      256                       end.
      257                       when chr(13)
      258                       then do:
      259                           assign
      260                               p-out-string = p-out-string + "&#13;":U
      261                           .
      262                       end.
      263                       otherwise do:
      264                           assign
      265                               p-out-string = p-out-string + v-current-char
      266                           .
      267                       end.
      268                   end case.
      269               end.
      270           end.
      271       end case.
      272   end.
      273   end .
      274   procedure xmlchar-encode-1c :
      275   define input parameter p-in-string      as character        no-undo.
      276   define output parameter p-out-string    as character        no-undo.
      277       define variable v-position      as integer      no-undo.
      278       define variable v-current-char  as character    no-undo.
      279   do
      280   on error undo, return error
      281   :
      282       assign
      283           p-out-string = "":U
      284       .
      285       case p-in-string
      286       :
      287           when ?
      288           then do:
      289               assign
      290                   p-out-string = "?":U
      291               .
      292           end.
      293           otherwise do:
      294               do v-position = 1 to length( p-in-string )
      295               :
      296                   assign
      297                       v-current-char = substring( p-in-string, v-position, 1 )
      298                   .
