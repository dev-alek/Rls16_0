        1   block-level on error undo, throw.
        2   define input  parameter iType            as character no-undo.
        3   define input  parameter i-parent-handle  as handle no-undo.
        4   procedure addtask:
        5      define input  parameter iProc as character no-undo.
        6      define input  parameter iParam as character no-undo.
        7      run addtaskType  (iType,iProc,iParam).
        8   end.
        9   procedure addtaskType:
       10      define input  parameter ITask as character no-undo.
       11      define input  parameter iProc as character no-undo.
       12      define input  parameter iParam as character no-undo.
       13      run addtask in i-parent-handle (ITask,iProc,iParam).
       14   end.
       15   procedure waitproc:
       16      define input  parameter itext  as character no-undo.
       17      run waitProcLable in i-parent-handle (itext).
       18   end.
       19   define input  parameter p-list-db       as character no-undo .
       20   def var vss-revision    as character no-undo init "$Revision: d3f7ea4aa09e, 3307, rls $":U .
       21   def var vss-author      as character no-undo init "$Author: DRuban $":U .
       22   def var vss-date        as character no-undo init "$Date: 2023/05/19 13:37:07 $":U .
       23   def var vss-workfile    as character no-undo init "$Workfile: auto-nws.p $":U .
       24   def var vss-archive     as character no-undo init "$Archive: bge/auto-nws.p $":U .
       25   def var vss-description as character no-undo init "Работа с ФГИС Диадок".
       26   procedure vss-get-info :
       27     define output parameter p-vss-revision    like vss-revision    no-undo .
       28     define output parameter p-vss-author      like vss-author      no-undo .
       29     define output parameter p-vss-date        like vss-date        no-undo .
       30     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       31     define output parameter p-vss-archive     like vss-archive     no-undo .
       32     define output parameter p-vss-description like vss-description no-undo .
       33     assign
       34       p-vss-revision    = vss-revision
       35       p-vss-author      = vss-author
       36       p-vss-date        = vss-date
       37       p-vss-workfile    = vss-workfile
       38       p-vss-archive     = vss-archive
       39       p-vss-description = vss-description
       40     .
       41   end procedure.
       42   procedure vss-get-parameters :
       43     define output parameter p-vss-parameters as character no-undo .
       44   end procedure.
       45   define new global shared variable g#vssrevis-logger as handle    no-undo .
       46   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       47   define variable v-vssrevis-logger                   as handle    no-undo .
       48   procedure vss-logevent :
       49     define input  parameter p-extra-paramters as character no-undo .
       50     define variable v-vssrevis-parameters as character no-undo .
       51     do
       52     on error undo, return error return-value
       53     :
       54       if  valid-handle(v-vssrevis-logger)
       55       and v-vssrevis-logger :get-signature("logevent") <> ""
       56       then do:
       57         run vss-get-parameters in this-procedure
       58           (output v-vssrevis-parameters
       59           ).
       60         run logevent in v-vssrevis-logger
       61           (input vss-workfile
       62           ,input vss-revision
       63           ,input v-vssrevis-parameters
       64           ,input p-extra-paramters
       65           ).
       66       end.
       67     end.
       68   end procedure.
       69   assign
       70     v-vssrevis-logger = g#vssrevis-logger
       71   .
       72   if  valid-handle(v-vssrevis-logger)
       73   and v-vssrevis-logger :get-signature("logevent") <> ""
       74   then do:
       75     assign
       76       v-vssrevis-logevent = true
       77     .
       78     run vss-logevent in this-procedure (input vss-description) .
       79   end.
       80   define variable mi as integer no-undo.
       81   if p-list-db eq "*"
       82   then do:
       83      run bge\auto-nws-db.p(output p-list-db).
       84   end.
       85   define variable mDB as character no-undo.
       86   do mi = 1 to num-entries (p-list-db):
       87      mDB = entry(mi,p-list-db).
       88      if     mdb ne ""
       89         and mdb ne ?
       90      then do:
       91         run AddTask in this-procedure ("utl/proc-nws", mdb).
       92      end.
       93   end.
       94   run waitproc in this-procedure  (substitute("Обработка новостей. По БД &1.", p-list-db)).
