        1   block-level on error undo, throw.
        2   using Progress.Lang.*.
        3   using ibs.th.str.gds.*.
        4   using ibs.th.gbl.*.
        5   using ibs.th.gbl.storage.*.
        6   using ibs.th.str.clients.*.
        7   using ibs.th.bge.is_PM.*.
        8   define input parameter parparentproc as widget-handle no-undo .
        9   define input parameter p-db-num      as integer      no-undo .
       10   define input parameter p-cre-db-num as integer   no-undo .
       11   define input parameter p-task-type  as character no-undo .
       12   define input parameter p-task-num   as integer   no-undo .
       13   def var vss-revision    as character no-undo init "$Revision: b65640f2406f, 2724, rls $":U .
       14   def var vss-author      as character no-undo init "$Author: SSlivenko $":U .
       15   def var vss-date        as character no-undo init "$Date: Пн янв 18 10:14:31 2021 +0300 $":U .
       16   def var vss-workfile    as character no-undo init "$Workfile: auto-exp-is_PM.p $":U .
       17   def var vss-archive     as character no-undo init "$Archive: bge/auto-exp-is_PM.p $":U .
       18   def var vss-description as character no-undo init "Работа с ФГИС меркурий".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   define  shared variable g#auto-pid           as integer   no-undo .
       90   define  shared variable conn-par             as character no-undo .
       91   define  shared variable g#auto-user-id       as character no-undo .
       92   define  shared variable g#auto-user-login    as character no-undo .
       93   define  shared variable g#auto-user-password as character no-undo .
       94   define  shared variable v-socket             as logical   no-undo .
       95   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96   define  shared variable auto-window-h     as handle    no-undo .
       97   define  shared variable auto-log-msg-h    as handle    no-undo .
       98   define  shared variable hand-log-msg-h    as handle    no-undo .
       99   define  shared variable log-file-name     as character no-undo initial ? .
      100   define  shared variable add-log-file-name as character no-undo initial ? .
      101   define  shared variable writelogvalue     as character no-undo initial ? .
      102   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103   procedure cur-time :
      104      define output parameter p-today as date      no-undo .
      105      define output parameter p-time  as integer   no-undo .
      106     do
      107     on error undo, return error
      108     :
      109       define variable v-date1 as date      no-undo .
      110       define variable v-date2 as date      no-undo .
      111       define variable v-time  as integer   no-undo .
      112       assign
      113         v-date1 = today
      114         v-time  = time
      115         v-date2 = today
      116       .
      117       if v-date1 <> v-date2
      118       then do:
      119         assign
      120           v-date1 = today
      121           v-time  = v-time
      122         .
      123       end.
      124       assign
      125         p-today = v-date1
      126         p-time  = v-time
      127       .
      128     end.
      129   end.
      130   function cur-time-date returns character
      131   :
      132     return string(today, '99/99/9999':U) .
      133   end.
      134   function cur-time-mjd returns decimal
      135   :
      136     define variable v-date as date      no-undo .
      137     define variable v-time as integer   no-undo .
      138     run cur-time in this-procedure
      139       (output v-date
      140       ,output v-time
      141       ) .
      142     return integer(v-date) - 2400002 + (v-time / 86400) .
      143   end.
      144   function cur-time-get-ending-index returns integer
      145   (input p-number as integer
      146   )
      147   :
      148     if p-number < 0
      149     or p-number = ?
      150     then do:
      151       return 1 .
      152     end.
      153     define variable v-rest as integer   no-undo .
      154     assign
      155       p-number = p-number modulo 100
      156     .
      157     if p-number < 20
      158     then do:
      159       assign
      160         v-rest = p-number
      161       .
      162     end.
      163     else do:
      164       assign
      165         v-rest = p-number modulo 10
      166       .
      167     end.
      168     case v-rest :
      169       when 1
      170       then do:
      171         return 2 .
      172       end.
      173       when 2 or
      174       when 3 or
      175       when 4
      176       then do:
      177         return 3 .
      178       end.
      179       otherwise do:
      180         return 1 .
      181       end.
      182     end case .
      183   end.
      184   procedure cur-time-mjd-to-date :
      185      define input  parameter i-mjd-diff as decimal no-undo.
      186      define output parameter o-Date     as date    no-undo.
      187      define output parameter o-Time     as integer no-undo.
      188      define variable v-day-number as integer   no-undo .
      189      if    i-mjd-diff < 0
      190         or i-mjd-diff = ?
      191      then do:
      192         return "?" .
      193      end.
      194      assign
      195         v-day-number = truncate(i-mjd-diff,0).
      196         o-Date = date(v-day-number + 2400002).
      197         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      198     .
      199   end.
      200   function cur-time-mjd-to-string returns character
      201   (input p-mjd-diff as decimal
      202   )
      203   :
      204     define variable v-day-number as integer   no-undo .
      205     define variable v-seconds    as integer   no-undo .
      206     define variable v-hour       as integer   no-undo .
      207     define variable v-min        as integer   no-undo .
      208     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      209     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      210     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      211     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      212     if p-mjd-diff < 0
      213     or p-mjd-diff = ?
      214     then do:
      215       return "?" .
      216     end.
      217     assign
      218       v-day-number = integer(truncate(p-mjd-diff,0))
      219       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      220     .
      221     if v-seconds > 86400
      222     then do:
      223       assign
      224         v-seconds = 86400 - 1
      225       .
      226     end.
      227     if v-seconds < 0
      228     then do:
      229       assign
      230         v-seconds = 0
      231       .
      232     end.
      233     assign
      234       v-hour = truncate(v-seconds / 3600, 0)
      235     .
      236     assign
      237       v-seconds = v-seconds modulo 3600
      238     .
      239     assign
      240       v-min = truncate(v-seconds / 60, 0)
      241     .
      242     assign
      243       v-seconds = v-seconds modulo 60
      244     .
      245     return
      246         (if v-day-number <> 0
      247           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      248           else ""
      249         )
      250       + (if v-day-number <> 0 or v-hour <> 0
      251           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      252           else ""
      253         )
      254       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      255           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      256           else ""
      257         )
      258       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      259       .
      260   end.
      261   function cur-time-string returns character
      262   :
      263     define variable v-date as date      no-undo .
      264     define variable v-time as integer   no-undo .
      265     run cur-time in this-procedure
      266       (output v-date
      267       ,output v-time
      268       ) .
      269     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      270   end.
      271   function cur-time-string-sec returns character
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      280   end.
      281   function cur-time-custom  returns character
      282   (input p-prefix as character
      283   ,input p-date-format as character
      284   ,input p-delimiter as character
      285   ,input p-time-format as character
      286   ,input p-suffix as character
      287   )
      288   :
      289     define variable v-date as date      no-undo .
      290     define variable v-time as integer   no-undo .
      291     run cur-time in this-procedure
      292       (output v-date
      293       ,output v-time
      294       ) .
      295     return
      296       p-prefix
      297       + string(v-date, p-date-format)
      298       + p-delimiter
      299       + string(v-time, p-time-format)
      300       + p-suffix
      301       .
      302   end.
      303   function cur-time-print  returns character
      304   :
      305     define variable v-date as date      no-undo .
      306     define variable v-time as integer   no-undo .
      307     run cur-time in this-procedure
      308       (output v-date
      309       ,output v-time
      310       ) .
      311     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      312   end.
      313   function cur-time-datetime returns datetime
      314   :
      315     define variable v-char as character no-undo .
      316     define variable v-datetime as datetime no-undo .
      317     v-char = cur-time-string().
      318     v-datetime = datetime(v-char).
      319     return  v-datetime.
      320   end.
      321   function cur-time-string-msec returns character
      322   :
      323     define variable v-date as datetime  no-undo .
      324     v-date = now.
      325     return string(v-date) .
      326   end.
      327   define stream LogStream .
      328   define variable mNoTime as logical no-undo.
      329   procedure write-to-log-notime :
      330     define input param i-str as character no-undo .
      331     mNoTime = yes.
      332     run write-to-log (i-str).
      333     mNoTime = no.
      334   end.
      335   procedure write-to-log :
      336     define input param p-str as character no-undo .
      337     do
      338     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      339     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      340     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      341     :
      342       define variable log-res        as logical   no-undo .
      343       define variable v-jj           as integer   no-undo .
      344       if    mNoTime
      345          or writelogvalue eq "AsyncProc"
      346       then
      347          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      348       else
      349          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      350       if auto-log-msg-h <> ? then do:
      351         log-res = auto-log-msg-h:move-to-eof( ) .
      352         log-res = auto-log-msg-h:insert-string( p-str ).
      353       end.
      354       if hand-log-msg-h <> ? then do:
      355         log-res = hand-log-msg-h:move-to-eof( ) .
      356         log-res = hand-log-msg-h:insert-string( p-str ).
      357       end.
      358       assign
      359         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      360         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      361         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      362       .
      363       if add-log-file-name <> ? then do:
      364         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      365           run gbl/fileapnd.p
      366             ( input entry(v-jj, add-log-file-name, chr(1) )
      367             ,input p-str
      368             ,input 20
      369             ) no-error .
      370           if error-status:error then do:
      371             return error return-value .
      372           end.
      373         end.
      374       end.
      375       if writelogvalue eq "AsyncProc"
      376       then do:
      377          p-str = trim(p-str, (chr(13) + chr(10)) )
      378       .
      379          Publish "WriteLogAsunc" (p-str,yes).
      380       end.
      381       else if writelogvalue <> "yes" then do:
      382         run gbl/fileapnd.p
      383           ( input log-file-name
      384           ,input p-str
      385           ,input 20
      386           ) no-error .
      387         if error-status:error then do:
      388           return error return-value .
      389         end.
      390       end.
      391     end.
      392   end procedure.
      393   procedure write-to-screen :
      394     define input param p-str as character no-undo .
      395     do
      396     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      397     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      398     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      399     :
      400       define variable log-res as logical no-undo.
      401       assign
      402         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      403       .
      404       if auto-log-msg-h <> ?
      405       then do:
      406         log-res = auto-log-msg-h:move-to-eof( ) .
      407         log-res = auto-log-msg-h:insert-string( p-str ).
      408       end.
      409       if hand-log-msg-h <> ?
      410       then do:
      411         log-res = hand-log-msg-h:move-to-eof( ) .
      412         log-res = hand-log-msg-h:insert-string( p-str ).
      413       end.
      414     end.
      415   end procedure.
      416   procedure send-msg-to-email :
      417     define input  parameter p-subject      as character no-undo .
      418     define input  parameter p-text-err     as character no-undo .
      419     define input  parameter p-attach-files as character no-undo .
      420     do
      421     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      422     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      423     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      424     :
      425       define variable v-tth             as handle    no-undo .
      426       define variable v-value-character as character no-undo .
      427       define variable v-value-date      as date      no-undo .
      428       define variable v-value-decimal   as decimal   no-undo .
      429       define variable v-value-integer   as integer   no-undo .
      430       define variable v-value-logical   as logical   no-undo .
      431       define variable v-param-type      as character no-undo .
      432       define variable v-email       as character no-undo .
      433       define variable v-tmp-str     as character no-undo .
      434       define variable v-tmp1-str    as character no-undo .
      435       define variable v-ind         as integer   no-undo .
      436       define variable v-num-entries as integer   no-undo .
      437       delete object v-tth no-error.
      438       run adm/shattri.p
      439         ( input "get":U
      440          ,input  "":U
      441          ,input  0
      442          ,input  'auto-task':U
      443          ,input  'send-msg-to-email':U
      444          ,output v-value-character
      445          ,output v-value-date
      446          ,output v-value-decimal
      447          ,output v-value-integer
      448          ,output v-value-logical
      449          ,output v-param-type
      450          ,input-output table-handle v-tth
      451         ) no-error .
      452       if not error-status :error  then do:
      453         assign
      454           v-tmp-str = v-value-character
      455         .
      456       end.
      457       delete object v-tth no-error.
      458       assign
      459         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      460         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      461         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      462         v-num-entries = num-entries( v-tmp-str, chr(44) )
      463         v-email       = "":U
      464       .
      465       do v-ind = 1 to v-num-entries
      466       :
      467         assign
      468           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      469         .
      470         if trim( v-tmp1-str ) <> "":U then do:
      471           if v-email = "":U then do:
      472             assign
      473               v-email = v-tmp1-str
      474             .
      475           end.
      476           else do:
      477             assign
      478               v-email = v-email + chr(44) + v-tmp1-str
      479             .
      480           end.
      481         end.
      482       end.
      483       if v-email <> "":U then do:
      484         run gbl/sendmail.p
      485           ( input v-email
      486           , input p-subject
      487           , input p-text-err
      488           , input p-attach-files
      489           ) no-error .
      490         if error-status :error
      491           or return-value <> "":U
      492         then do:
      493           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      494         end.
      495       end.
      496     end.
      497   end procedure.
      498   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      499   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      500   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      501   define variable par-type          as character no-undo.
      502   define variable v-value-character as character no-undo .
      503   define variable v-value-date      as date      no-undo .
      504   define variable v-value-decimal   as decimal   no-undo .
      505   define variable v-value-integer   as integer   no-undo .
      506   define variable v-value-logical   as logical   no-undo .
      507   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      508   define temp-table temp-schedule-free no-undo
      509   field free-id as character
      510   field free-task-name as character
      511   field proc-run-name as character
      512   field proc-param-edit-name as character
      513   field conf-param as character
      514   field is-gbd as logical
      515   field is-ubd as logical
      516   field enable-concurrent-0 as logical
      517   field enable-concurrent-db as logical
      518   field other-info as character
      519   field enc-key as character
      520   field is-rum as logical
      521   index pi is unique primary
      522   free-id.
      523   procedure schedule-attr-name :
      524   do
      525     on error undo, return error
      526     :
      527     define input  parameter p-code           as character no-undo .
      528     define output parameter p-type           as character no-undo .
      529     define output parameter p-format         as character no-undo .
      530     define output parameter p-label          as character no-undo .
      531     define output parameter p-user-can-edit  as logical   no-undo .
      532     define output parameter p-output-display as logical   no-undo .
      533     define output parameter p-other          as character no-undo .
      534       if index(p-code, chr(4)) > 0 then do:
      535         p-code = entry(1, p-code, chr(4)).
      536       end.
      537       case p-code :
      538               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      539               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      540               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      541               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      542               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      543               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      544               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      545               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      546               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      547         otherwise do:
      548           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      549         end.
      550       end.
      551     end.
      552   end procedure.
      553   procedure schedule-attr-tooltip :
      554   do
      555     on error undo, return error
      556     :
      557       define input  parameter p-code    as character no-undo .
      558       define output parameter p-tooltip as character no-undo .
      559       define output parameter p-label   as character no-undo .
      560       if index(p-code, chr(4)) > 0 then do:
      561         p-code = entry(1, p-code, chr(4)).
      562       end.
      563       case p-code :
      564               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      565               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      566               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      567               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      568               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      569               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      570               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      571               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      572               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      573         otherwise do:
      574               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      575         end.
      576       end.
      577     end.
      578   end procedure.
      579   procedure schedule-attr-value :
      580   do
      581   on error undo, return error return-value
      582   :
      583   define input parameter  p-cre-db-num as integer    no-undo.
      584   define input parameter  p-task-type  as character  no-undo.
      585   define input parameter  p-task-num   as integer    no-undo.
      586   define input parameter  p-code       as character  no-undo.
      587   define output parameter p-value      as character  no-undo.
      588   define output parameter p-type       as character  no-undo.
      589       define variable v-format         as character no-undo .
      590       define variable v-label          as character no-undo .
      591       define variable v-user-can-edit  as logical   no-undo .
      592       define variable v-output-display as logical   no-undo .
      593       define variable v-other          as character no-undo .
      594       define buffer buf_schedule-attr for ub.schedule-attr.
      595       run schedule-attr-name in this-procedure (
      596             input  p-code
      597           , output p-type
      598           , output v-format
      599           , output v-label
      600           , output v-user-can-edit
      601           , output v-output-display
      602           , output v-other
      603       ) no-error .
      604       if error-status :error
      605       then do:
      606           undo, return error return-value .
      607       end.
      608       if p-code begins ('schd-free-id':U + chr(4))
      609       and entry(2, p-code, chr(4)) = '':U then do:
      610         find first buf_schedule-attr no-lock
      611             where buf_schedule-attr.cre-db-num = p-cre-db-num
      612               and buf_schedule-attr.task-type  = p-task-type
      613               and buf_schedule-attr.task-num   = p-task-num
      614               and buf_schedule-attr.attr-code  begins p-code
      615         no-error .
      616       end.
      617       else do:
      618         find first buf_schedule-attr no-lock
      619             where buf_schedule-attr.cre-db-num = p-cre-db-num
      620               and buf_schedule-attr.task-type  = p-task-type
      621               and buf_schedule-attr.task-num   = p-task-num
      622               and buf_schedule-attr.attr-code  = p-code
      623         no-error .
      624       end.
      625       if available buf_schedule-attr
      626       then do:
      627           assign
      628               p-value = buf_schedule-attr.attr-value
      629           .
      630       end.
      631       else do:
      632         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      633            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      634         end.
      635         else do:
      636           assign
      637               p-value = if p-type = 'L':U then "no":U else ""
      638           .
      639         end.
      640       end.
      641   end.
      642   end procedure.
      643   procedure schedule-attr-write :
      644   do
      645   on error undo, return error
      646   :
      647   define input parameter p-cre-db-num  as integer   no-undo.
      648   define input parameter p-task-type   as character no-undo.
      649   define input parameter p-task-num    as integer   no-undo.
      650   define input parameter p-code        as character no-undo.
      651   define input parameter p-value       as character no-undo.
      652       define variable v-type              as character                no-undo.
      653       define variable v-format            as character                no-undo.
      654       define variable v-label             as character                no-undo.
      655       define variable v-user-can-edit     as logical                  no-undo.
      656       define variable v-output-display    as logical                  no-undo.
      657       define variable v-other             as character                no-undo.
      658       define buffer buf_schedule-attr for ub.schedule-attr .
      659       run schedule-attr-name in this-procedure (
      660             input  p-code
      661           , output v-type
      662           , output v-format
      663           , output v-label
      664           , output v-user-can-edit
      665           , output v-output-display
      666           , output v-other
      667       ) no-error.
      668       if error-status :error
      669       then do:
      670           undo, return error return-value.
      671       end.
      672       find first buf_schedule-attr exclusive-lock
      673            where buf_schedule-attr.cre-db-num = p-cre-db-num
      674              and buf_schedule-attr.task-type  = p-task-type
      675              and buf_schedule-attr.task-num   = p-task-num
      676              and buf_schedule-attr.attr-code  = p-code
      677       no-error.
      678       if not available buf_schedule-attr
      679       then do:
      680           create buf_schedule-attr.
      681           assign
      682             buf_schedule-attr.cre-db-num = p-cre-db-num
      683             buf_schedule-attr.task-type  = p-task-type
      684             buf_schedule-attr.task-num   = p-task-num
      685             buf_schedule-attr.attr-code  = p-code
      686             buf_schedule-attr.attr-value = p-value
      687           .
      688       end.
      689       else do:
      690           assign
      691               buf_schedule-attr.attr-value = p-value
      692           .
      693       end.
      694   end.
      695   end procedure.
      696   procedure schedule-attr-delete :
      697   do
      698   on error undo, return error
      699   :
      700   define input  parameter p-cre-db-num  as integer   no-undo.
      701   define input  parameter p-task-type   as character no-undo.
      702   define input  parameter p-task-num    as integer   no-undo.
      703   define input  parameter p-code        as character no-undo.
      704   define output parameter p-deleted     as logical   no-undo.
      705       define buffer buf_schedule-attr for ub.schedule-attr .
      706       define variable v-type              as character                no-undo.
      707       define variable v-format            as character                no-undo.
      708       define variable v-label             as character                no-undo.
      709       define variable v-user-can-edit     as logical                  no-undo.
      710       define variable v-output-display    as logical                  no-undo.
      711       define variable v-other             as character                no-undo.
      712       run schedule-attr-name in this-procedure (
      713             input p-code
      714           , output v-type
      715           , output v-format
      716           , output v-label
      717           , output v-user-can-edit
      718           , output v-output-display
      719           , output v-other
      720       ) no-error .
      721       if error-status :error
      722       then do:
      723           undo, return error return-value .
      724       end.
      725       find first buf_schedule-attr exclusive-lock
      726            where buf_schedule-attr.cre-db-num = p-cre-db-num
      727              and buf_schedule-attr.task-type  = p-task-type
      728              and buf_schedule-attr.task-num   = p-task-num
      729              and buf_schedule-attr.attr-code  = p-code
      730       no-error.
      731       if not available buf_schedule-attr
      732       then do:
      733           assign
      734               p-deleted = no
      735           .
      736       end.
      737       else do:
      738           delete buf_schedule-attr.
      739           assign
      740               p-deleted = yes
      741           .
      742       end.
      743   end.
      744   end procedure.
      745   procedure schedule-attr-news :
      746   do
      747   on error undo, return error
      748   :
      749       define input  parameter p-code           as character no-undo .
      750       define output parameter p-news           as logical   no-undo .
      751       if index(p-code, chr(4)) > 0 then do:
      752         p-code = entry(1, p-code, chr(4)).
      753       end.
      754       case p-code :
      755               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      756               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      757               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      758               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      759               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      760               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      761               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      762               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      763               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      764         otherwise do:
      765           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      766         end.
      767       end.
      768   end.
      769   end procedure.
      770   procedure schedule-attr-extract-logical :
      771   do
      772   on error undo, return error
      773   :
      774   define input  parameter p-parameter-number   as integer      no-undo.
      775   define input  parameter p-parameter-list     as character    no-undo.
      776   define output parameter p-parameter-value   as logical      no-undo.
      777       if num-entries( p-parameter-list ) > p-parameter-number - 1
      778       then do:
      779           assign
      780               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      781           .
      782       end.
      783       else do:
      784           assign
      785               p-parameter-value   = no
      786           .
      787       end.
      788   end.
      789   end procedure.
      790   procedure schedule-attr-get-free-id :
      791   do
      792   on error undo, return error return-value
      793   :
      794     define input  parameter p-cre-db-num  as integer   no-undo.
      795     define input  parameter p-task-type   as character no-undo.
      796     define input  parameter p-task-num    as integer   no-undo.
      797     define output parameter p-free-id     as character no-undo.
      798     define buffer buf_schedule-attr for ub.schedule-attr.
      799     find first buf_schedule-attr no-lock
      800         where buf_schedule-attr.cre-db-num = p-cre-db-num
      801           and buf_schedule-attr.task-type  = p-task-type
      802           and buf_schedule-attr.task-num   = p-task-num
      803           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      804     no-error .
      805     if available buf_schedule-attr then
      806     assign
      807     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      808     no-error
      809     .
      810   end.
      811   end procedure.
      812   procedure schedule-attr-get-free-props :
      813     define input parameter p-free-id as character no-undo .
      814     define output parameter p-value as character no-undo .
      815     define buffer buf_temp-schedule-free for temp-schedule-free.
      816     do
      817     on error undo, return error return-value
      818     :
      819       find first buf_temp-schedule-free no-lock no-error .
      820       if not available buf_temp-schedule-free then do:
      821         run schedule-attr-fill-free-props in this-procedure .
      822       end.
      823       find first buf_temp-schedule-free where
      824               buf_temp-schedule-free.free-id = p-free-id no-error.
      825       if available buf_temp-schedule-free then do:
      826         assign
      827         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      828                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      829                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      830                   buf_temp-schedule-free.conf-param           + chr(4) +
      831                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      832                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      833                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      834                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      835                   buf_temp-schedule-free.other-info
      836         .
      837       end.
      838       else do:
      839        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      840                              "id произвольной задачи - &5"
      841                              ,vss-workfile
      842                              ,vss-revision
      843                              ,vss-description
      844                              ,chr(10)
      845                              ,p-free-id).
      846       end.
      847     end.
      848   end procedure.
      849   procedure schedule-attr-is-rum-free-id :
      850   define input parameter p-free-id as character no-undo .
      851   define output parameter p-is-rum as logical no-undo .
      852   define buffer buf_temp-schedule-free for temp-schedule-free.
      853   do
      854   on error undo, return error
      855   :
      856       find first buf_temp-schedule-free no-lock no-error .
      857       if not available buf_temp-schedule-free then do:
      858         run schedule-attr-fill-free-props in this-procedure .
      859       end.
      860       find first buf_temp-schedule-free where
      861               buf_temp-schedule-free.free-id = p-free-id no-error.
      862       if available buf_temp-schedule-free
      863       and buf_temp-schedule-free.is-rum
      864       then do:
      865         p-is-rum = yes.
      866       end.
      867   end.
      868   end procedure.
      869   procedure schedule-attr-fill-free-props :
      870   define variable v-path                    as character                no-undo .
      871   DEFINE VARIABLE v-full-path               as character                no-undo .
      872   DEFINE VARIABLE v-file-name               as character                no-undo .
      873   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      874   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      875   define buffer buf_temp-schedule-free for temp-schedule-free.
      876   define variable v-answer as logical no-undo .
      877     do
      878     on error undo, return error substitute("&1 &2 &3&4&5&4"
      879                                           ,vss-workfile
      880                                           ,vss-revision
      881                                           ,vss-description
      882                                           ,chr(10)
      883                                           ,error-status:get-message(1) )
      884     :
      885       run gbl/filename.p (
      886                       input 'cmp/shd-free.d'
      887                     ,output v-full-path
      888                     ,output v-path
      889                     ,output v-file-name
      890                     ,output v-file-name-no-ext
      891                     ,output v-file-name-ext
      892                     ) .
      893       input from value(v-full-path).
      894       repeat :
      895         create buf_temp-schedule-free.
      896         import buf_temp-schedule-free.
      897       END.
      898       input close.
      899       _ff:
      900       for each buf_temp-schedule-free :
      901         if buf_temp-schedule-free.free-id = '':U then do:
      902            delete buf_temp-schedule-free.
      903            next _ff.
      904          end.
      905          run schedule-attr-check-enc in this-procedure (
      906                                                       input  buf_temp-schedule-free.free-id
      907                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      908                                                               buf_temp-schedule-free.proc-param-edit-name +
      909                                                               buf_temp-schedule-free.conf-param +
      910                                                               string(buf_temp-schedule-free.is-gbd) +
      911                                                               string(buf_temp-schedule-free.is-ubd) +
      912                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      913                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      914                                                               string(buf_temp-schedule-free.other-info)
      915                                                               )
      916                                                       ,input  buf_temp-schedule-free.enc-key
      917                                                       ,output v-answer    ) no-error .
      918          if error-status:error
      919          or not v-answer then delete buf_temp-schedule-free.
      920        end.
      921     end.
      922   end procedure.
      923   Function schedule-attr-reverse returns character (str as character).
      924      define variable rev_incl_s as character init "" no-undo .
      925      define variable rev_incl_i as integer no-undo .
      926      define variable rev_incl_l as integer no-undo .
      927      rev_incl_l = length(str).
      928      do rev_incl_i = 1 to rev_incl_l:
      929         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      930      end.
      931      return rev_incl_s.
      932   end.
      933   procedure schedule-attr-check-enc.
      934     define input  parameter p-free-id   as character no-undo .
      935     define input  parameter p-value     as character no-undo .
      936     define input  parameter p-enc-value as character no-undo .
      937     define output parameter p-answer    as logical   no-undo .
      938     define variable tmp         as character no-undo .
      939     define variable v-enc-value as character no-undo .
      940     assign
      941     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      942     .
      943     run schedule-attr-pswd-enc in this-procedure
      944       ( input tmp
      945        ,output v-enc-value
      946       ) no-error .
      947     if error-status:error then do:
      948       message
      949         vss-workfile vss-revision vss-description skip
      950         "Ошибка при вызове процедуры pswd-enc" skip
      951         return-value skip
      952         error-status :get-message(1) skip
      953         view-as alert-box error .
      954       undo, return error .
      955     end.
      956     if v-enc-value = p-enc-value then do:
      957       assign
      958         p-answer = true
      959       .
      960     end.
      961     else do:
      962       assign
      963         p-answer = false
      964       .
      965     end.
      966   end.
      967   procedure schedule-attr-conf-enc.
      968     define input  parameter p-free-id   as character no-undo .
      969     define input  parameter p-value     as character no-undo .
      970     define output parameter p-enc-value as character no-undo .
      971     define variable tmp         as character no-undo .
      972     assign
      973       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      974     .
      975     run schedule-attr-pswd-enc in this-procedure
      976       ( input tmp
      977        ,output p-enc-value
      978       ) no-error .
      979     if error-status:error then do:
      980       message
      981         vss-workfile vss-revision vss-description skip
      982         "Ошибка при вызове процедуры pswd-enc" skip
      983         return-value skip
      984         error-status :get-message(1) skip
      985         view-as alert-box error .
      986       undo, return error .
      987     end.
      988   end procedure.
      989   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      990   procedure schedule-attr-pswd-enc :
      991     define input parameter  pswd     as character no-undo .
      992     define output parameter enc-pswd as character no-undo .
      993     do
      994     on error undo, return error return-value
      995     :
      996       assign
      997         enc-pswd = encode(pswd + string(index(pswd, "k")))
      998       .
      999     end.
     1000   end procedure.
     1001   do
     1002   on error undo, return error
     1003   :
     1004     define variable v-ind                    as integer   no-undo .
     1005     define variable v-num-entries-db-list    as integer   no-undo .
     1006     define variable v-db-num                 as integer   no-undo .
     1007     define variable v-err-gen-pack           as integer   no-undo .
     1008     define variable v-err-code               as integer   no-undo .
     1009     define variable v-step-num               as integer   no-undo .
     1010     define variable v-action                 as character no-undo .
     1011     define variable v-message                as character no-undo .
     1012     define variable v-proc-handle            as handle    no-undo .
     1013     define variable v-main-proc-name         as character no-undo .
     1014     define variable v-count-main-prc         as integer   no-undo .
     1015     define variable v-pers-proc-name         as character no-undo .
     1016     define variable v-appId           as character no-undo .
     1017     define variable v-status_         as character no-undo .
     1018     define variable v-Msg             as character no-undo .
     1019     define buffer buf_clients           for ub.clients .
     1020     define buffer buf_esys-all-attr     for ub.esys-all-attr .
     1021     define buffer buf_db                for ub.db .
     1022     define variable objKeyRec     as class ibs.th.gbl.keyrec                no-undo.
     1023     define variable is_PM         as class is_PM no-undo .
     1024     define variable v-param-list as character no-undo .
     1025     define variable v-param-type as character no-undo .
     1026     define variable v-part-rowid as rowid no-undo .
     1027     define variable v-tbl-name as character no-undo .
     1028     define variable ii as integer no-undo.
     1029     if transaction then do:
     1030       message
     1031         substitute( "&1. Вызов данной процедуры невозможен при наличии транзакции", vss-workfile )
     1032         view-as alert-box error .
     1033       return error .
     1034     end.
     1035     if valid-handle( session :first-procedure ) then do:
     1036       assign
     1037         v-main-proc-name = "gbl/mainproc.p":U
     1038         v-proc-handle    = session :first-procedure
     1039         v-count-main-prc = 0
     1040         v-pers-proc-name = "":U
     1041       .
     1042       do while valid-handle( v-proc-handle )
     1043       :
     1044         if v-proc-handle :file-name = v-main-proc-name then do:
     1045           assign
     1046             v-count-main-prc = v-count-main-prc + 1
     1047           .
     1048         end.
     1049         else do:
     1050           assign
     1051             v-pers-proc-name = v-pers-proc-name + chr(44) + v-proc-handle :file-name
     1052           .
     1053         end.
     1054         assign
     1055           v-proc-handle = v-proc-handle:next-sibling no-error
     1056         .
     1057       end.
     1058       if v-count-main-prc > 1
     1059         or v-pers-proc-name <> "":U
     1060       then do:
     1061         message
     1062           substitute( "&1. Вызов данной процедуры невозможен при наличии определений persistent prosedures &2"
     1063                       + "Список недопустимых процедур: &3&2"
     1064                       + "Исключение - единственная процедура &4&2"
     1065                       + "Определений данной процедуры &5&2"
     1066                       , vss-workfile
     1067                       , chr(10)
     1068                       , v-pers-proc-name
     1069                       , v-main-proc-name
     1070                       , v-count-main-prc
     1071                      )
     1072           view-as alert-box error .
     1073         return error .
     1074       end.
     1075     end.
     1076     assign
     1077       g#auto                = true
     1078     .
     1079     run gbl/set-gbl.p
     1080       (input true
     1081       ,input g#auto-user-id
     1082       ,input g#auto-user-password
     1083       ) no-error.
     1084     if error-status :error
     1085     then do:
     1086       run write-to-log( substitute("&1. Ошибка при инициализации переменных g#... &2&3&4"
     1087                                     ,vss-workfile
     1088                                     ,error-status:get-message(error-status:num-messages)
     1089                                     ,chr(10)
     1090                                     ,return-value
     1091                                   )
     1092                       ) .
     1093       return error .
     1094     end.
     1095     assign
     1096       g#auto = true
     1097     .
     1098     find first buf_db no-lock where buf_db.db-num = p-db-num .
     1099     if buf_db.stts = 2
     1100     then do :
     1101       run write-to-log( "БД " + string(p-db-num) + " выгружается. Пропускаем." ).
     1102       return error .
     1103     end.
     1104     run write-to-log( "Работа с БД " + string(p-db-num) ) .
     1105     run schedule-attr-value in this-procedure
     1106       (input  p-cre-db-num
     1107       ,input  p-task-type
     1108       ,input  p-task-num
     1109       ,input  'schedule-param-list':U
     1110       ,output v-param-list
     1111       ,output v-param-type
     1112       ) .
     1113     if v-param-list = ""
     1114     then do :
     1115       run write-to-log( "В расписании не заданы параметры выгрузки. Пропускаем." ).
     1116       return error .
     1117     end .
     1118     clients_ :
     1119     for each clients no-lock where clients.obj-type = 'маг':U
     1120                                and clients.db-num = p-db-num
     1121                                and clients.stts = 0 :
     1122       is_PM = new is_PM (input p-db-num,
     1123                          input clients.obj-code,
     1124                          input v-param-list,
     1125                          input parparentproc,
     1126                          input this-procedure)
     1127                         .
     1128       is_PM:exec_1c() .
     1129       run str/send1C-some-data.p (input parparentproc,
     1130                                   input this-procedure,
     1131                                   input parparentproc,
     1132                                   input is_PM:Data,
     1133                                   input "operating-balances")
     1134                                   no-error .
     1135       if error-status:error
     1136       then do :
     1137         run write-to-log( "Ошибка при отправке в 1С. " + return-value ).
     1138       end .
     1139       if is_PM:oneMoreTime
     1140       then do :
     1141         is_PM:exec_1c() .
     1142         run str/send1C-some-data.p (input parparentproc,
     1143                                     input this-procedure,
     1144                                     input parparentproc,
     1145                                     input is_PM:Data,
     1146                                     input "operating-balances")
     1147                                     no-error .
     1148         if error-status:error
     1149         then do :
     1150           run write-to-log( "Ошибка при отправке в 1С. " + return-value ).
     1151         end .
     1152         is_PM:oneMoreTime = false .
     1153       end .
     1154       delete object is_PM .
     1155     end.
     1156     run write-to-log( "Закончена работа с БД " + string(p-db-num) ) .
     1157   end.
