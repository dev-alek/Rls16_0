        1   block-level on error undo, throw.
        2   define output parameter p-oxml-exch-dir as character no-undo .
        3   define output parameter p-oxml-heap-dir as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: oxmlinir.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: bge/oxmlinir.p $":U .
        9   define variable vss-description as character no-undo init "Получение настроек Open-XML".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   define new shared variable g#auto-pid           as integer   no-undo .
       71   define new shared variable conn-par             as character no-undo .
       72   define new shared variable g#auto-user-id       as character no-undo .
       73   define new shared variable g#auto-user-login    as character no-undo .
       74   define new shared variable g#auto-user-password as character no-undo .
       75   define new shared variable v-socket             as logical   no-undo .
       76   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   define new shared variable auto-window-h     as handle    no-undo .
       78   define new shared variable auto-log-msg-h    as handle    no-undo .
       79   define new shared variable hand-log-msg-h    as handle    no-undo .
       80   define new shared variable log-file-name     as character no-undo initial ? .
       81   define new shared variable add-log-file-name as character no-undo initial ? .
       82   define new shared variable writelogvalue     as character no-undo initial ? .
       83   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   procedure cur-time :
       85      define output parameter p-today as date      no-undo .
       86      define output parameter p-time  as integer   no-undo .
       87     do
       88     on error undo, return error
       89     :
       90       define variable v-date1 as date      no-undo .
       91       define variable v-date2 as date      no-undo .
       92       define variable v-time  as integer   no-undo .
       93       assign
       94         v-date1 = today
       95         v-time  = time
       96         v-date2 = today
       97       .
       98       if v-date1 <> v-date2
       99       then do:
      100         assign
      101           v-date1 = today
      102           v-time  = v-time
      103         .
      104       end.
      105       assign
      106         p-today = v-date1
      107         p-time  = v-time
      108       .
      109     end.
      110   end.
      111   function cur-time-date returns character
      112   :
      113     return string(today, '99/99/9999':U) .
      114   end.
      115   function cur-time-mjd returns decimal
      116   :
      117     define variable v-date as date      no-undo .
      118     define variable v-time as integer   no-undo .
      119     run cur-time in this-procedure
      120       (output v-date
      121       ,output v-time
      122       ) .
      123     return integer(v-date) - 2400002 + (v-time / 86400) .
      124   end.
      125   function cur-time-get-ending-index returns integer
      126   (input p-number as integer
      127   )
      128   :
      129     if p-number < 0
      130     or p-number = ?
      131     then do:
      132       return 1 .
      133     end.
      134     define variable v-rest as integer   no-undo .
      135     assign
      136       p-number = p-number modulo 100
      137     .
      138     if p-number < 20
      139     then do:
      140       assign
      141         v-rest = p-number
      142       .
      143     end.
      144     else do:
      145       assign
      146         v-rest = p-number modulo 10
      147       .
      148     end.
      149     case v-rest :
      150       when 1
      151       then do:
      152         return 2 .
      153       end.
      154       when 2 or
      155       when 3 or
      156       when 4
      157       then do:
      158         return 3 .
      159       end.
      160       otherwise do:
      161         return 1 .
      162       end.
      163     end case .
      164   end.
      165   procedure cur-time-mjd-to-date :
      166      define input  parameter i-mjd-diff as decimal no-undo.
      167      define output parameter o-Date     as date    no-undo.
      168      define output parameter o-Time     as integer no-undo.
      169      define variable v-day-number as integer   no-undo .
      170      if    i-mjd-diff < 0
      171         or i-mjd-diff = ?
      172      then do:
      173         return "?" .
      174      end.
      175      assign
      176         v-day-number = truncate(i-mjd-diff,0).
      177         o-Date = date(v-day-number + 2400002).
      178         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      179     .
      180   end.
      181   function cur-time-mjd-to-string returns character
      182   (input p-mjd-diff as decimal
      183   )
      184   :
      185     define variable v-day-number as integer   no-undo .
      186     define variable v-seconds    as integer   no-undo .
      187     define variable v-hour       as integer   no-undo .
      188     define variable v-min        as integer   no-undo .
      189     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      190     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      191     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      192     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      193     if p-mjd-diff < 0
      194     or p-mjd-diff = ?
      195     then do:
      196       return "?" .
      197     end.
      198     assign
      199       v-day-number = integer(truncate(p-mjd-diff,0))
      200       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      201     .
      202     if v-seconds > 86400
      203     then do:
      204       assign
      205         v-seconds = 86400 - 1
      206       .
      207     end.
      208     if v-seconds < 0
      209     then do:
      210       assign
      211         v-seconds = 0
      212       .
      213     end.
      214     assign
      215       v-hour = truncate(v-seconds / 3600, 0)
      216     .
      217     assign
      218       v-seconds = v-seconds modulo 3600
      219     .
      220     assign
      221       v-min = truncate(v-seconds / 60, 0)
      222     .
      223     assign
      224       v-seconds = v-seconds modulo 60
      225     .
      226     return
      227         (if v-day-number <> 0
      228           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      229           else ""
      230         )
      231       + (if v-day-number <> 0 or v-hour <> 0
      232           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      233           else ""
      234         )
      235       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      236           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      237           else ""
      238         )
      239       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      240       .
      241   end.
      242   function cur-time-string returns character
      243   :
      244     define variable v-date as date      no-undo .
      245     define variable v-time as integer   no-undo .
      246     run cur-time in this-procedure
      247       (output v-date
      248       ,output v-time
      249       ) .
      250     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      251   end.
      252   function cur-time-string-sec returns character
      253   :
      254     define variable v-date as date      no-undo .
      255     define variable v-time as integer   no-undo .
      256     run cur-time in this-procedure
      257       (output v-date
      258       ,output v-time
      259       ) .
      260     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      261   end.
      262   function cur-time-custom  returns character
      263   (input p-prefix as character
      264   ,input p-date-format as character
      265   ,input p-delimiter as character
      266   ,input p-time-format as character
      267   ,input p-suffix as character
      268   )
      269   :
      270     define variable v-date as date      no-undo .
      271     define variable v-time as integer   no-undo .
      272     run cur-time in this-procedure
      273       (output v-date
      274       ,output v-time
      275       ) .
      276     return
      277       p-prefix
      278       + string(v-date, p-date-format)
      279       + p-delimiter
      280       + string(v-time, p-time-format)
      281       + p-suffix
      282       .
      283   end.
      284   function cur-time-print  returns character
      285   :
      286     define variable v-date as date      no-undo .
      287     define variable v-time as integer   no-undo .
      288     run cur-time in this-procedure
      289       (output v-date
      290       ,output v-time
      291       ) .
      292     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      293   end.
      294   function cur-time-datetime returns datetime
      295   :
      296     define variable v-char as character no-undo .
      297     define variable v-datetime as datetime no-undo .
      298     v-char = cur-time-string().
      299     v-datetime = datetime(v-char).
      300     return  v-datetime.
      301   end.
      302   function cur-time-string-msec returns character
      303   :
      304     define variable v-date as datetime  no-undo .
      305     v-date = now.
      306     return string(v-date) .
      307   end.
      308   define stream LogStream .
      309   define variable mNoTime as logical no-undo.
      310   procedure write-to-log-notime :
      311     define input param i-str as character no-undo .
      312     mNoTime = yes.
      313     run write-to-log (i-str).
      314     mNoTime = no.
      315   end.
      316   procedure write-to-log :
      317     define input param p-str as character no-undo .
      318     do
      319     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      320     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      321     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      322     :
      323       define variable log-res        as logical   no-undo .
      324       define variable v-jj           as integer   no-undo .
      325       if    mNoTime
      326          or writelogvalue eq "AsyncProc"
      327       then
      328          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      329       else
      330          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      331       if auto-log-msg-h <> ? then do:
      332         log-res = auto-log-msg-h:move-to-eof( ) .
      333         log-res = auto-log-msg-h:insert-string( p-str ).
      334       end.
      335       if hand-log-msg-h <> ? then do:
      336         log-res = hand-log-msg-h:move-to-eof( ) .
      337         log-res = hand-log-msg-h:insert-string( p-str ).
      338       end.
      339       assign
      340         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      341         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      342         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      343       .
      344       if add-log-file-name <> ? then do:
      345         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      346           run gbl/fileapnd.p
      347             ( input entry(v-jj, add-log-file-name, chr(1) )
      348             ,input p-str
      349             ,input 20
      350             ) no-error .
      351           if error-status:error then do:
      352             return error return-value .
      353           end.
      354         end.
      355       end.
      356       if writelogvalue eq "AsyncProc"
      357       then do:
      358          p-str = trim(p-str, (chr(13) + chr(10)) )
      359       .
      360          Publish "WriteLogAsunc" (p-str,yes).
      361       end.
      362       else if writelogvalue <> "yes" then do:
      363         run gbl/fileapnd.p
      364           ( input log-file-name
      365           ,input p-str
      366           ,input 20
      367           ) no-error .
      368         if error-status:error then do:
      369           return error return-value .
      370         end.
      371       end.
      372     end.
      373   end procedure.
      374   procedure write-to-screen :
      375     define input param p-str as character no-undo .
      376     do
      377     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      378     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      379     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      380     :
      381       define variable log-res as logical no-undo.
      382       assign
      383         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      384       .
      385       if auto-log-msg-h <> ?
      386       then do:
      387         log-res = auto-log-msg-h:move-to-eof( ) .
      388         log-res = auto-log-msg-h:insert-string( p-str ).
      389       end.
      390       if hand-log-msg-h <> ?
      391       then do:
      392         log-res = hand-log-msg-h:move-to-eof( ) .
      393         log-res = hand-log-msg-h:insert-string( p-str ).
      394       end.
      395     end.
      396   end procedure.
      397   procedure send-msg-to-email :
      398     define input  parameter p-subject      as character no-undo .
      399     define input  parameter p-text-err     as character no-undo .
      400     define input  parameter p-attach-files as character no-undo .
      401     do
      402     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      403     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      404     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      405     :
      406       define variable v-tth             as handle    no-undo .
      407       define variable v-value-character as character no-undo .
      408       define variable v-value-date      as date      no-undo .
      409       define variable v-value-decimal   as decimal   no-undo .
      410       define variable v-value-integer   as integer   no-undo .
      411       define variable v-value-logical   as logical   no-undo .
      412       define variable v-param-type      as character no-undo .
      413       define variable v-email       as character no-undo .
      414       define variable v-tmp-str     as character no-undo .
      415       define variable v-tmp1-str    as character no-undo .
      416       define variable v-ind         as integer   no-undo .
      417       define variable v-num-entries as integer   no-undo .
      418       delete object v-tth no-error.
      419       run adm/shattri.p
      420         ( input "get":U
      421          ,input  "":U
      422          ,input  0
      423          ,input  'auto-task':U
      424          ,input  'send-msg-to-email':U
      425          ,output v-value-character
      426          ,output v-value-date
      427          ,output v-value-decimal
      428          ,output v-value-integer
      429          ,output v-value-logical
      430          ,output v-param-type
      431          ,input-output table-handle v-tth
      432         ) no-error .
      433       if not error-status :error  then do:
      434         assign
      435           v-tmp-str = v-value-character
      436         .
      437       end.
      438       delete object v-tth no-error.
      439       assign
      440         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      441         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      442         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      443         v-num-entries = num-entries( v-tmp-str, chr(44) )
      444         v-email       = "":U
      445       .
      446       do v-ind = 1 to v-num-entries
      447       :
      448         assign
      449           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      450         .
      451         if trim( v-tmp1-str ) <> "":U then do:
      452           if v-email = "":U then do:
      453             assign
      454               v-email = v-tmp1-str
      455             .
      456           end.
      457           else do:
      458             assign
      459               v-email = v-email + chr(44) + v-tmp1-str
      460             .
      461           end.
      462         end.
      463       end.
      464       if v-email <> "":U then do:
      465         run gbl/sendmail.p
      466           ( input v-email
      467           , input p-subject
      468           , input p-text-err
      469           , input p-attach-files
      470           ) no-error .
      471         if error-status :error
      472           or return-value <> "":U
      473         then do:
      474           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      475         end.
      476       end.
      477     end.
      478   end procedure.
      479   define new shared variable oxml-exch-dir as character no-undo .
      480   define new shared variable oxml-heap-dir as character no-undo .
      481   define variable err-mess as character no-undo .
      482   define temp-table t-pck-conf no-undo
      483     field esys-id         as integer
      484     field db-num          as integer
      485     field current-db-num  as integer
      486     field pack-num        as integer
      487     field rcvd-recs       as integer
      488     field total-recs      as integer
      489     field sys-key         as character
      490     field src_db-key      as character
      491     field ver-num         as character
      492     field prev-crc        as character
      493     field actual-date     as date
      494     field actual-time-int as integer
      495   .
      496   run bge/oxml-ini.p no-error.
      497   if error-status :error then do:
      498     message
      499     vss-workfile vss-revision vss-description skip
      500     "Ошибка Получения/инициализации переменных для системы OpenXML" skip
      501     return-value
      502     view-as alert-box error.
      503   end.
      504   assign
      505   p-oxml-exch-dir = oxml-exch-dir
      506   p-oxml-heap-dir = oxml-heap-dir
      507   .
