     1285     ghADMProps:ADD-NEW-FIELD('DataSourceNames':U, 'CHAR':U, 0, ?, ?).
     1286     ghADMProps:ADD-NEW-FIELD('DataTarget':U, 'CHAR':U, 0, ?, '':U).
     1287     ghADMProps:ADD-NEW-FIELD('DataTargetEvents':U, 'CHARACTER':U, 0, ?,
     1288        'updateState,rowObjectState,fetchBatch,LinkState':U).
     1289     ghADMProps:ADD-NEW-FIELD('LogicalObjectName':U, 'CHARACTER':U).
     1290     ghADMProps:ADD-NEW-FIELD('PhysicalObjectName':U, 'CHARACTER':U, ?, ?, "":U).
     1291     ghADMProps:ADD-NEW-FIELD('LogicalVersion':U, 'CHARACTER':U).
     1292     ghADMProps:ADD-NEW-FIELD('PhysicalVersion':U, 'CHARACTER':U, ?, ?, "":U).
