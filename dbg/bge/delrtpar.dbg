       97   define variable vss-revision    as character no-undo init "$Revision$":U .
       98   define variable vss-author      as character no-undo init "$Author$":U .
       99   define variable vss-date        as character no-undo init "$Date$":U .
      100   define variable vss-workfile    as character no-undo init "$Workfile$":U .
      101   define variable vss-archive     as character no-undo init "$Archive$":U .
      102   define variable vss-description as character no-undo init "Настройки по автоматическому удалению маршрутизации ВС, работающих без подтверждения".
      103   procedure vss-get-info :
      104     define output parameter p-vss-revision    like vss-revision    no-undo .
      105     define output parameter p-vss-author      like vss-author      no-undo .
      106     define output parameter p-vss-date        like vss-date        no-undo .
      107     define output parameter p-vss-workfile    like vss-workfile    no-undo .
      108     define output parameter p-vss-archive     like vss-archive     no-undo .
      109     define output parameter p-vss-description like vss-description no-undo .
      110     assign
      111       p-vss-revision    = vss-revision
      112       p-vss-author      = vss-author
      113       p-vss-date        = vss-date
      114       p-vss-workfile    = vss-workfile
      115       p-vss-archive     = vss-archive
      116       p-vss-description = vss-description
      117     .
      118   end procedure.
      119   procedure vss-get-parameters :
      120     define output parameter p-vss-parameters as character no-undo .
      121   end procedure.
      122   define new global shared variable g#vssrevis-logger as handle    no-undo .
      123   define variable v-vssrevis-logevent                 as logical   no-undo init false .
      124   define variable v-vssrevis-logger                   as handle    no-undo .
      125   procedure vss-logevent :
      126     define input  parameter p-extra-paramters as character no-undo .
      127     define variable v-vssrevis-parameters as character no-undo .
      128     do
      129     on error undo, return error return-value
      130     :
      131       if  valid-handle(v-vssrevis-logger)
      132       and v-vssrevis-logger :get-signature("logevent") <> ""
      133       then do:
      134         run vss-get-parameters in this-procedure
      135           (output v-vssrevis-parameters
      136           ).
      137         run logevent in v-vssrevis-logger
      138           (input vss-workfile
      139           ,input vss-revision
      140           ,input v-vssrevis-parameters
      141           ,input p-extra-paramters
      142           ).
      143       end.
      144     end.
      145   end procedure.
      146   assign
      147     v-vssrevis-logger = g#vssrevis-logger
      148   .
      149   if  valid-handle(v-vssrevis-logger)
      150   and v-vssrevis-logger :get-signature("logevent") <> ""
      151   then do:
      152     assign
      153       v-vssrevis-logevent = true
      154     .
      155     run vss-logevent in this-procedure (input vss-description) .
      156   end.
      157   define new global shared variable g#language as character no-undo .
      158   if g#language <> '' and g#language <> 'rus':U then do:
      159     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      160   end.
      161   define new global shared variable g#library  as handle no-undo .
      162   define new global shared variable g#library2 as handle no-undo .
      163   procedure proc-alt-shift-f2:
      164     if not ibs.th.gbl.gbl-var:rcode
      165   then
      166     run gbl\inidebug.p .
      167   end.
      168   procedure proc-alt-shift-f3:
      169     run gbl/prvssinf.p
      170       ( input this-procedure
      171       ) .
      172   end.
      173   define variable v-inform-launched as logical no-undo initial false .
      174   procedure proc-alt-shift-f4:
      175     define variable v-action as character no-undo .
      176     if v-inform-launched = false then do:
      177       assign
      178         v-inform-launched = true
      179       .
      180       run gbl/d-inform.w
      181         (  input self
      182         ,  input this-procedure
      183         , output v-action
      184         ) no-error .
      185       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      186       assign
      187         v-inform-launched = false
      188       .
      189     end.
      190   end.
      191   procedure proc-alt-f1:
      192     run gbl/corrhelp.p
      193       (input this-procedure
      194       ) .
      195   end .
      196   on alt-shift-f2 anywhere do:
      197     run proc-alt-shift-f2.
      198   end.
      199   on alt-shift-f3 anywhere do:
      200     run proc-alt-shift-f3 in this-procedure .
      201   end.
      202   on alt-shift-f4 anywhere do:
      203     run proc-alt-shift-f4 in this-procedure.
      204   end.
      205   on alt-f1 anywhere do:
      206     run proc-alt-f1 in this-procedure .
      207   end.
      208   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      209     define variable v-cntxt-db-num        as integer   no-undo .
      210     define variable v-cntxt-userid        as character no-undo .
      211     define variable v-cntxt-level         as character no-undo .
      212     define variable v-cntxt-host-code-obj as integer   no-undo .
      213     define variable v-cntxt-obj-type      as character no-undo .
      214     define variable v-cntxt-obj-code      as integer   no-undo .
      215     define variable v-cntxt-db-num-obj    as integer   no-undo .
      216     define variable v-cntxt-is-admin      as logical   no-undo .
      217   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      218   define temp-table temp-schedule-free no-undo
      219   field free-id as character
      220   field free-task-name as character
      221   field proc-run-name as character
      222   field proc-param-edit-name as character
      223   field conf-param as character
      224   field is-gbd as logical
      225   field is-ubd as logical
      226   field enable-concurrent-0 as logical
      227   field enable-concurrent-db as logical
