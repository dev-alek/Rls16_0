     1363     ghADMProps:ADD-NEW-FIELD('ColorErrorFG':U,     'INTEGER':U, 0, ?, ?).
     1364     ghADMProps:ADD-NEW-FIELD('BGColor':U,          'INTEGER':U, 0, ?, 12).
     1365     ghADMProps:ADD-NEW-FIELD('FGColor':U,          'INTEGER':U, 0, ?, ?).
     1366     ghADMProps:ADD-NEW-FIELD('FieldPopupMapping','CHARACTER':U, 0, ?, '':U).
     1367   END.
     1368   IF NOT VALID-HANDLE(WIDGET-HANDLE(ENTRY(1,THIS-PROCEDURE:ADM-DATA,CHR(1)))) THEN
     1369   DO:
     1370     ghADMProps:ADD-NEW-FIELD('CurrentPage':U, 'INT':U, 0, ?, 0).
     1371     ghADMProps:ADD-NEW-FIELD('PendingPage':U, 'INT':U, 0, ?, ?).
     1372     ghADMProps:ADD-NEW-FIELD('ContainerTarget':U, 'CHAR':U, 0, ?, '':U).
     1373     ghADMProps:ADD-NEW-FIELD('ContainerTargetEvents':U, 'CHAR':U, 0, ?,
     1374       'exitObject,okObject,cancelObject,updateActive':U).
     1375     ghADMProps:ADD-NEW-FIELD('ContainerToolbarSource':U, 'CHAR':U, 0, ?, '':U).
     1376     ghADMProps:ADD-NEW-FIELD('ContainerToolbarSourceEvents':U, 'CHAR':U, 0, ?,
     1377       'toolbar,okObject,cancelObject':U).
     1378     ghADMProps:ADD-NEW-FIELD('OutMessageTarget':U, 'HANDLE':U).
     1379     ghADMProps:ADD-NEW-FIELD('PageNTarget':U, 'CHAR':U, 0, ?, '':U).
     1380     ghADMProps:ADD-NEW-FIELD('PageSource':U, 'HANDLE':U).
     1381     ghADMProps:ADD-NEW-FIELD('FilterSource':U, 'HANDLE':U).
     1382     ghADMProps:ADD-NEW-FIELD('UpdateSource':U, 'CHARACTER':U, 0, ?, '':U).
     1383     ghADMProps:ADD-NEW-FIELD('UpdateTarget':U, 'CHAR':U, 0, ?, '':U).
     1384     ghADMProps:ADD-NEW-FIELD('CommitSource':U, 'HANDLE':U, 0, ?, ?).
     1385     ghADMProps:ADD-NEW-FIELD('CommitSourceEvents':U, 'CHAR':U, 0, ?,
     1386             'commitTransaction,undoTransaction':U).
     1387     ghADMProps:ADD-NEW-FIELD('CommitTarget':U, 'CHAR':U, 0, ?, '':U).
     1388     ghADMProps:ADD-NEW-FIELD('CommitTargetEvents':U, 'CHAR':U, 0, ?, 'rowObjectState':U).
     1389     ghADMProps:ADD-NEW-FIELD('StartPage':U, 'INT':U, 0, ?, ?).
     1390     ghADMProps:ADD-NEW-FIELD('RunMultiple':U, 'LOGICAL':U, 0, ?, NO).
     1391     ghADMProps:ADD-NEW-FIELD('WaitForObject':U, 'HANDLE':U).
     1392     ghADMProps:ADD-NEW-FIELD('DynamicSDOProcedure':U, 'CHAR':U, 0, ?,
     1393         'adm2/dyndata.w':U).
     1394     ghADMProps:ADD-NEW-FIELD('RunDOOptions':U, 'CHARACTER':U, 0, ?,'':U).
     1395     ghADMProps:ADD-NEW-FIELD('InitialPageList':U, 'CHARACTER':U, 0, ?, '':U).
     1396     ghADMProps:ADD-NEW-FIELD('WindowFrameHandle':U, 'HANDLE':U).
     1397     ghADMProps:ADD-NEW-FIELD('Page0LayoutManager':U, 'CHARACTER':U).
     1398     ghADMProps:ADD-NEW-FIELD('MultiInstanceSupported':U, 'LOGICAL':U, ?, ? , NO ).
     1399     ghADMProps:ADD-NEW-FIELD('MultiInstanceActivated':U, 'LOGICAL':U).
     1400     ghADMProps:ADD-NEW-FIELD('ContainerMode':U, 'CHARACTER':U).
