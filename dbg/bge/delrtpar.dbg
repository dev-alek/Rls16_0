     1309   FUNCTION getObjectType RETURNS CHARACTER
     1310     ( ) :
     1311     DEFINE VARIABLE cType AS CHARACTER NO-UNDO.
     1312   ASSIGN
     1313    ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
     1314    glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
     1315             ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
     1316    cType = ghProp:BUFFER-FIELD('ObjectType':U):BUFFER-VALUE
     1317     NO-ERROR.
     1318     RETURN cType.
     1319   END FUNCTION.
     1320   IF NOT VALID-HANDLE(WIDGET-HANDLE(ENTRY(1,THIS-PROCEDURE:ADM-DATA,CHR(1)))) THEN
     1321   DO:
