     1410     ghADMProps:ADD-NEW-FIELD('CallerObject':U, 'HANDLE':U).
     1411     ghADMProps:ADD-NEW-FIELD('DisabledAddModeTabs':U, 'CHARACTER':U).
     1412     ghADMProps:ADD-NEW-FIELD('ReEnableDataLinks':U, 'CHARACTER':U).
     1413     ghADMProps:ADD-NEW-FIELD('WindowTitleViewer':U, 'CHARACTER':U).
     1414     ghADMProps:ADD-NEW-FIELD('UpdateActive':U, 'LOGICAL':U).
     1415     ghADMProps:ADD-NEW-FIELD('ObjectsCreated':U, 'LOGICAL':U).
     1416     ghADMProps:ADD-NEW-FIELD('InstanceNames':U, 'CHARACTER':U, 0, ?,'':U) .
     1417     ghADMProps:ADD-NEW-FIELD('ClientNames':U, 'CHARACTER':U, 0, ?,'':U) .
     1418     ghADMProps:ADD-NEW-FIELD('ContainedDataObjects':U, 'CHARACTER':U, 0, ?,'':U).
     1419     ghADMProps:ADD-NEW-FIELD('ContainedAppServices':U, 'CHARACTER':U, 0, ?,'':U).
     1420     ghADMProps:ADD-NEW-FIELD('DataContainer':U, 'LOGICAL':U, 0, ?,NO).
     1421     ghADMProps:ADD-NEW-FIELD('HasDbAwareObjects':U, 'LOGICAL':U, 0, ?,?).
     1422     ghADMProps:ADD-NEW-FIELD('HasDynamicProxy':U, 'LOGICAL':U, 0, ?,NO).
     1423     ghADMProps:ADD-NEW-FIELD('HideOnClose':U, 'LOGICAL':U, 0, ?,NO).
     1424     ghADMProps:ADD-NEW-FIELD('HideChildContainersOnClose':U, 'LOGICAL':U, 0, ?,?).
     1425     ghADMProps:ADD-NEW-FIELD('HasObjectMenu':U, 'LOGICAL':U, 0, ?,NO).
     1426     ghADMProps:ADD-NEW-FIELD('RequiredPages':U, 'CHARACTER':U).
     1427     ghADMProps:ADD-NEW-FIELD('RemoveMenuOnHide':U, 'LOGICAL':U, 0, ?, TRUE).
     1428     ghADMProps:ADD-NEW-FIELD('ProcessList':U, 'CHARACTER':U).
     1429     ghADMProps:ADD-NEW-FIELD('PageLayoutInfo':U, 'CHARACTER':U).
     1430     ghADMProps:ADD-NEW-FIELD('PageTokens':U, 'CHARACTER':U).
     1431   END.
     1432   DEFINE VARIABLE ghContainer AS HANDLE NO-UNDO.
     1433   ghContainer = FRAME gDialog:HANDLE.
     1434       IF NOT glADMLoadFromRepos THEN
     1435         RUN start-super-proc ("adm2/smart.p":U).
     1436       DEFINE VARIABLE cObjectName AS CHARACTER  NO-UNDO.
     1437       DEFINE VARIABLE iStart      AS INTEGER    NO-UNDO.
     1438     IF NOT VALID-HANDLE(WIDGET-HANDLE(ENTRY(1,THIS-PROCEDURE:ADM-DATA,CHR(1)))) THEN
     1439     DO:
     1440       ghADMProps:TEMP-TABLE-PREPARE('ADMProps':U).
     1441       ghADMPropsBuf = ghADMProps:DEFAULT-BUFFER-HANDLE.
     1442       ghADMPropsBuf:BUFFER-CREATE().
     1443       THIS-PROCEDURE:ADM-DATA = STRING(ghADMPropsBuf) + CHR(1) + CHR(1).
     1444       cObjectName =  'LogicalObjectName,PhysicalObjectName,DynamicObject,RunAttribute,HideOnInit,DisableOnInit,ObjectLayout':U.
     1445   ASSIGN
     1446      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
     1447      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
     1448                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
     1449     ghProp:BUFFER-FIELD('InstanceProperties':U):BUFFER-VALUE = cObjectName
     1450    .
     1451       ASSIGN cObjectName = REPLACE(THIS-PROCEDURE:FILE-NAME, "~\":U, "~/":U)
     1452              iStart = R-INDEX(cObjectName, "~/":U) + 1
     1453              cObjectName =
     1454                   IF R-INDEX(THIS-PROCEDURE:FILE-NAME, ".":U) <= iStart THEN
     1455                      SUBSTR(cObjectName, iStart)
     1456                   ELSE
     1457                      SUBSTR(cObjectName,
     1458                             iStart,
     1459                             R-INDEX(THIS-PROCEDURE:FILE-NAME, ".":U) - iStart).
     1460   ASSIGN
     1461      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
     1462      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
     1463                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
     1464     ghProp:BUFFER-FIELD('ObjectName':U):BUFFER-VALUE = cObjectName
     1465    .
     1466   ASSIGN
     1467      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
     1468      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
     1469                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
     1470     ghProp:BUFFER-FIELD('ContainerHandle':U):BUFFER-VALUE = FRAME gDialog:HANDLE
     1471    .
     1472     END.
     1473     ELSE DO:
     1474   ASSIGN
     1475      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
     1476      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
     1477                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
     1478     ghProp:BUFFER-FIELD('ObjectType':U):BUFFER-VALUE = 'SmartDialog':U
     1479     ghProp:BUFFER-FIELD('ContainerType':U):BUFFER-VALUE = 'DIALOG-BOX':U
     1480     ghProp:BUFFER-FIELD('PhysicalVersion':U):BUFFER-VALUE = '':U
     1481     ghProp:BUFFER-FIELD('PhysicalObjectName':U):BUFFER-VALUE = (IF '':U <> '':U THEN '':U ELSE THIS-PROCEDURE:FILE-NAME)
     1482       .
     1483     END.
     1484   PROCEDURE adm-clone-props :
     1485     DEFINE VARIABLE hReposBuffer AS HANDLE     NO-UNDO.
     1486     DEFINE VARIABLE hPropTable   AS HANDLE     NO-UNDO.
     1487     DEFINE VARIABLE hBuffer      AS HANDLE     NO-UNDO.
     1488     DEFINE VARIABLE hTable       AS HANDLE     NO-UNDO.
     1489     hReposBuffer = WIDGET-H(ENTRY(1,THIS-PROCEDURE:ADM-DATA,CHR(1))).
     1490     IF VALID-HANDLE(hReposBuffer) AND hReposBuffer:NAME <> 'ADMProps':U THEN
     1491     DO:
     1492       hReposBuffer:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(THIS-PROCEDURE) + '")':U)
     1493       NO-ERROR.
     1494       IF hReposBuffer:AVAIL THEN
     1495       DO:
     1496         CREATE TEMP-TABLE hPropTable.
     1497         hPropTable:CREATE-LIKE(hReposBuffer).
     1498         hPropTable:TEMP-TABLE-PREPARE('ADMProps':U).
     1499         hBuffer = hPropTable:DEFAULT-BUFFER-HANDLE.
     1500         hBuffer:BUFFER-CREATE().
     1501         hBuffer:BUFFER-COPY(hReposBuffer).
     1502         dynamic-function("deleteProperties":U IN TARGET-PROCEDURE)
     1503    .
     1504         THIS-PROCEDURE:ADM-DATA = STRING(hBuffer) + CHR(1) + CHR(1).
     1505       END.
     1506     END.
     1507   END PROCEDURE.
     1508   PROCEDURE start-super-proc :
     1509     DEFINE INPUT PARAMETER pcProcName AS CHARACTER  NO-UNDO.
     1510     DEFINE VARIABLE        hProc      AS HANDLE     NO-UNDO.
     1511     hProc = SESSION:FIRST-PROCEDURE.
     1512     DO WHILE VALID-HANDLE(hProc) AND hProc:FILE-NAME NE pcProcName:
     1513       hProc = hProc:NEXT-SIBLING.
     1514     END.
     1515     IF NOT VALID-HANDLE(hProc) THEN
     1516       RUN VALUE(pcProcName) PERSISTENT SET hProc.
     1517     THIS-PROCEDURE:ADD-SUPER-PROCEDURE(hProc, SEARCH-TARGET).
     1518     RETURN.
     1519   END PROCEDURE.
     1520     DEFINE VARIABLE cAppService          AS CHARACTER  NO-UNDO.
     1521     DEFINE VARIABLE cASDivision          AS CHARACTER  NO-UNDO.
     1522     DEFINE VARIABLE cServerOperatingMode AS CHARACTER  NO-UNDO.
     1523     IF NOT glADMLoadFromRepos THEN
     1524       RUN start-super-proc("adm2/appserver.p":U).
     1525    cAppService = DYNAMIC-FUNC('getAppService':U IN TARGET-PROCEDURE)
     1526    .
     1527     IF SESSION:REMOTE THEN
     1528     DO:
     1529       ASSIGN cAppService          = '':U
     1530              cASDivision          = 'Server':U
     1531              cServerOperatingMode = CAPS(SESSION:SERVER-OPERATING-MODE).
     1532     END.
     1533     ELSE IF cAppService = '':U THEN
     1534       ASSIGN cAppService  = '':U.
     1535     IF cASDivision = '':U THEN
     1536        cServerOperatingMode = 'NONE':U.
     1537     ELSE
     1538      DYNAMIC-FUNC('setASDivision':U IN TARGET-PROCEDURE,cASDivision)
     1539    .
     1540   ASSIGN
     1541      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
     1542      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
     1543                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
     1544     ghProp:BUFFER-FIELD('ServerOperatingMode':U):BUFFER-VALUE = cServerOperatingMode
     1545    .
     1546      DYNAMIC-FUNC('setAppService':U IN TARGET-PROCEDURE,cAppService)
     1547    .
     1548   DEFINE VARIABLE cFields AS CHARACTER NO-UNDO.
     1549   IF NOT glADMLoadFromRepos THEN
     1550     RUN start-super-proc ("adm2/visual.p":U).
     1551     cFields =  REPLACE("B-mark b-delmark f-day-shift b-enter B-exit BROWSE-2":U, " ":U, ",":U).
     1552   ASSIGN
     1553      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
     1554      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
     1555                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
     1556     ghProp:BUFFER-FIELD('EnabledObjFlds':U):BUFFER-VALUE = cFields
     1557    .
     1558     IF VALID-HANDLE(gshSessionManager) THEN
     1559     DO:
     1560       ON HELP OF FRAME gDialog ANYWHERE
     1561         RUN contextHelp IN gshSessionManager (INPUT THIS-PROCEDURE, INPUT FOCUS).
     1562     END.
     1563     ON CTRL-PAGE-UP OF FRAME gDialog ANYWHERE DO:
     1564       RUN processAction IN TARGET-PROCEDURE (INPUT "CTRL-PAGE-UP":U).
     1565     END.
     1566     ON CTRL-PAGE-DOWN OF FRAME gDialog ANYWHERE DO:
     1567       RUN processAction IN TARGET-PROCEDURE (INPUT "CTRL-PAGE-DOWN":U).
     1568     END.
     1569   IF NOT glADMLoadFromRepos THEN
     1570   DO:
     1571     RUN start-super-proc("adm2/containr.p":U).
     1572     RUN modifyListProperty IN TARGET-PROCEDURE
     1573                            (TARGET-PROCEDURE,
     1574                             'Add':U,
     1575                             'ContainerSourceEvents':U,
     1576                             'initializeDataObjects':U).
     1577     IF  CAN-DO(dynamic-function("getSupportedLinks":U IN TARGET-PROCEDURE)
     1578    ,'data-target':U)
     1579     AND CAN-DO(dynamic-function("getSupportedLinks":U IN TARGET-PROCEDURE)
     1580    ,'data-source':U) THEN
     1581       RUN modifyListProperty IN TARGET-PROCEDURE
     1582                              (TARGET-PROCEDURE,
     1583                               'Add':U,
     1584                               'ContainerSourceEvents':U,
     1585                               'buildDataRequest':U).
     1586     IF NOT CAN-DO(dynamic-function("getSupportedLinks":U IN TARGET-PROCEDURE)
     1587    ,'containertoolbar-target':U) THEN
     1588       RUN modifyListProperty IN TARGET-PROCEDURE
     1589                             (TARGET-PROCEDURE,
     1590                              'Add':U,
     1591                              'SupportedLinks':U,
     1592                              'ContainerToolbar-Target':U).
     1593   END.
     1594   PAUSE 0 BEFORE-HIDE.
     1595   ASSIGN
     1596      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
     1597      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
     1598                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
     1599     ghProp:BUFFER-FIELD('WindowFrameHandle':U):BUFFER-VALUE = FRAME gDialog:handle
     1600    .
     1601   ASSIGN
     1602      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
     1603      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
     1604                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
     1605     ghProp:BUFFER-FIELD('DataContainer':U):BUFFER-VALUE = TRUE
     1606    .
     1607   ASSIGN
     1608     FRAME gDialog:SCROLLABLE = FALSE
     1609     FRAME gDialog:HIDDEN     = TRUE.
     1610   ON WINDOW-CLOSE OF FRAME gDialog
     1611     DO:
     1612       APPLY "END-ERROR":U TO SELF.
     1613     END.
     1614   ON CHOOSE OF b-enter IN FRAME gDialog
     1615   DO:
     1616     define variable v-param-list  as character  no-undo.
     1617     if not (mark-list = "" or mark-list = ?) then do:
     1618       if f-day-shift = ?
     1619       then do:
     1620         message "Количество дней хранения маршрутизации" skip "не должно быть пустым" view-as alert-box.
     1621         return no-apply.
     1622       end.
     1623       else do:
     1624         v-param-list = mark-list + "!" + string(f-day-shift).
     1625         run attach-attr-to-schedule-line in this-procedure ( INPUT v-param-list ).
     1626         message "Параметры сохранены!" view-as alert-box information.
     1627       end.
     1628     end.
     1629     else do:
     1630       message "Заданны пустые параметры, сохранить?"
     1631         view-as alert-box question buttons OK-Cancel
     1632         update g#log.
     1633       if g#log then run attach-attr-to-schedule-line in this-procedure ( INPUT "" ).
     1634         else return no-apply.
     1635     end.
     1636   END.
     1637   ON LEAVE OF f-day-shift IN FRAME gDialog
     1638   DO:
     1639     assign
     1640       f-day-shift.
     1641   END.
     1642   ON CHOOSE OF b-delmark IN FRAME gDialog
     1643   DO:
     1644     define variable v-rec as rowid no-undo.
     1645     v-rec = rowid (ext-system) .
     1646     assign
     1647       mark-list = "" .
     1648     OPEN QUERY BROWSE-2 FOR EACH ext-system       WHERE ext-system.esys-type = 6  OR ext-system.esys-type = 7 NO-LOCK INDEXED-REPOSITION.
     1649     reposition BROWSE-2 to rowid (v-rec) no-error.
     1650     apply "entry" to BROWSE-2 in frame gDialog.
     1651     apply "iteration-changed" to BROWSE-2 in frame gDialog.
     1652     BROWSE-2:select-focused-row ().
     1653   END.
     1654   ON CHOOSE OF b-mark IN FRAME gDialog
     1655   DO:
     1656     define variable n    as integer no-undo.
     1657     define variable l-ok as logical no-undo.
     1658     define variable v-rec as rowid no-undo.
     1659     do n = 1 to BROWSE-2:num-selected-rows :
     1660       l-ok = BROWSE-2:FETCH-SELECTED-ROW ( n ).
     1661       if l-ok then do:
     1662         run local-mark in this-procedure .
     1663       end.
     1664     end.
     1665     v-rec = rowid (ext-system) .
     1666     OPEN QUERY BROWSE-2 FOR EACH ext-system       WHERE ext-system.esys-type = 6  OR ext-system.esys-type = 7 NO-LOCK INDEXED-REPOSITION.
     1667     reposition BROWSE-2 to rowid (v-rec) no-error.
     1668     apply "entry" to BROWSE-2 in frame gDialog.
     1669     apply "iteration-changed" to BROWSE-2 in frame gDialog.
     1670     BROWSE-2:select-focused-row ().
     1671     BROWSE-2:select-next-row ().
     1672   END.
     1673   DEFINE VARIABLE iStartPage AS INTEGER NO-UNDO.
     1674   IF THIS-PROCEDURE:PERSISTENT THEN DO:
     1675       MESSAGE "A SmartDialog is not intended to be run " + CHR(10) +
     1676               "Persistent or to be placed in another ":U + CHR(10) +
     1677               "SmartObject at AppBuilder design time."
     1678               VIEW-AS ALERT-BOX ERROR.
     1679       RUN disable_UI.
     1680       DELETE PROCEDURE THIS-PROCEDURE.
     1681       RETURN.
     1682   END.
     1683   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME gDialog:PARENT eq ?
     1684   THEN FRAME gDialog:PARENT = ACTIVE-WINDOW.
     1685   RUN createObjects.
     1686   MAIN-BLOCK:
     1687   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1688      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1689     RUN initializeObject.
     1690     WAIT-FOR GO OF FRAME gDialog .
     1691   END.
     1692   RUN destroyObject.
     1693   PROCEDURE adm-create-objects :
     1694   END PROCEDURE.
     1695   PROCEDURE attach-attr-to-schedule-line :
     1696   DEFINE INPUT PARAMETER p-param-list AS CHARACTER NO-UNDO.
     1697     define buffer buf_schedule      for schedule.
     1698     define buffer buf_schedule-attr for schedule-attr.
     1699     define buffer lock-batchprocess for ub.batchprocess.
     1700     run gbl/lock-prc.p
     1701       (input 'schd':U
     1702       ,input 'delrt-auto':U
     1703       ,input 0
     1704       ,input 0
     1705       ,input '':U
     1706       ,input ""
     1707       ,input ""
     1708       ,input (
     1709       "удаление маршрутизации ВС"
     1710       )
     1711       ,input yes
     1712       ,buffer lock-batchprocess
     1713       ) no-error .
     1714     FIND FIRST buf_schedule-attr NO-LOCK WHERE
     1715       buf_schedule-attr.task-type   = p-task-type
     1716       and buf_schedule-attr.cre-db-num = INTEGER(p-db-num-char)
     1717       and buf_schedule-attr.attr-code = ('schd-free-id':U + chr(4) + 'delrt-auto') NO-ERROR.
     1718     IF AVAILABLE  buf_schedule-attr
     1719       AND buf_schedule-attr.task-num <> p-task-num
     1720       AND buf_schedule-attr.task-num <> - 1
     1721       and p-task-num <> - 1
     1722       THEN
     1723     DO:
     1724       MESSAGE
     1725         substitute("Уже есть расписание удаления маршрутизации ВС для БД &1&2" +
     1726         "номер расписания &3"
     1727         ,buf_schedule-attr.cre-db-num
     1728         ,chr(10)
     1729         ,buf_schedule-attr.task-num)
     1730         VIEW-AS ALERT-BOX ERROR.
     1731       UNDO, RETURN ERROR.
     1732     END.
     1733     find first buf_schedule no-lock
     1734       where buf_schedule.task-type   = p-task-type
     1735       and buf_schedule.cre-db-num  = INTEGER(p-db-num-char)
     1736       and buf_schedule.task-num    = p-task-num
     1737       no-error.
     1738     if not available buf_schedule
     1739       and (  p-task-type   <> 'autofree':U
     1740       or p-db-num-char <> p-db-num-char
     1741       or p-task-num    <> -1 )
     1742       then
     1743     do:
     1744       message
     1745         vss-workfile vss-revision vss-description
     1746         skip
     1747         "Не найдена строка расписания."
     1748         skip return-value
     1749         skip trim(error-status :get-message(1))
     1750         trim(error-status :get-message(2))
     1751         trim(error-status :get-message(3))
     1752         view-as alert-box error.
     1753       undo, return error .
     1754     end.
     1755     run schedule-attr-write in this-procedure (
     1756       input INTEGER(p-db-num-char)
     1757       , input p-task-type
     1758       , input p-task-num
     1759       , input 'schedule-param-list':U
     1760       , input p-param-list
     1761       ).
     1762   END PROCEDURE.
     1763   PROCEDURE disable_UI :
     1764     HIDE FRAME gDialog.
     1765   END PROCEDURE.
     1766   PROCEDURE enable_UI :
     1767     ENABLE B-mark b-delmark b-enter B-exit BROWSE-2
     1768         WITH FRAME gDialog.
     1769     VIEW FRAME gDialog.
     1770     run getschedule .
     1771     OPEN QUERY BROWSE-2 FOR EACH ext-system       WHERE ext-system.esys-type = 6  OR ext-system.esys-type = 7 NO-LOCK INDEXED-REPOSITION.
     1772     BROWSE-2:select-focused-row () no-error.
     1773   END PROCEDURE.
     1774   PROCEDURE local-mark:
     1775     if not available ext-system then do:
     1776       message "Неправильный выбор строки.".
     1777       return no-apply.
     1778     end.
     1779   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1780   define variable v-str-recid4 as character no-undo .
     1781   define variable v-num-entry4 as integer   no-undo .
     1782   assign
     1783     v-str-recid4 = trim( string( recid( ext-system ) , "->>>>>>>>>>>9":U ) )
     1784     v-num-entry4 = lookup( v-str-recid4 , mark-list )
     1785   .
     1786   if v-num-entry4 > 0 then do:
     1787     assign
     1788       entry( v-num-entry4, mark-list ) = "":U
     1789       mark-list = trim( replace( mark-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1790     .
     1791   end.
     1792   else do:
     1793     assign
     1794       mark-list = mark-list + ( if mark-list = "":U then "":U else chr(44) ) + v-str-recid4
     1795     .
     1796   end.
     1797      if lookup(string( recid(ext-system) ), mark-list ) = 0
     1798         then display  "" @ mark with browse BROWSE-2.
     1799         else display "*" @ mark with browse BROWSE-2.
     1800   END PROCEDURE.
     1801   procedure getschedule:
     1802     define variable v-param-list as character no-undo.
     1803     define variable v-param-type as character no-undo.
     1804     run schedule-attr-value in this-procedure (
     1805       input integer(p-db-num-char)
     1806       , input p-task-type
     1807       , input p-task-num
     1808       , input 'schedule-param-list':U
     1809       , output v-param-list
     1810       , output v-param-type
     1811       ) no-error.
     1812     if v-param-list <> "" then
     1813     do:
     1814       assign
     1815         mark-list = entry (1, v-param-list, "!")
     1816         f-day-shift = integer(entry (2, v-param-list, "!"))
     1817         f-day-shift:screen-value  in frame gDialog = entry (2, v-param-list, "!").
     1818     end.
     1819   end.
