      233   procedure schedule-attr-name :
      234   do
      235     on error undo, return error
      236     :
      237     define input  parameter p-code           as character no-undo .
      238     define output parameter p-type           as character no-undo .
      239     define output parameter p-format         as character no-undo .
      240     define output parameter p-label          as character no-undo .
      241     define output parameter p-user-can-edit  as logical   no-undo .
      242     define output parameter p-output-display as logical   no-undo .
      243     define output parameter p-other          as character no-undo .
      244       if index(p-code, chr(4)) > 0 then do:
      245         p-code = entry(1, p-code, chr(4)).
      246       end.
      247       case p-code :
      248               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      249               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      250               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      251               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      252               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      253               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      254               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      255               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      256               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      257         otherwise do:
      258           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      259         end.
      260       end.
      261     end.
      262   end procedure.
      263   procedure schedule-attr-tooltip :
      264   do
      265     on error undo, return error
      266     :
      267       define input  parameter p-code    as character no-undo .
      268       define output parameter p-tooltip as character no-undo .
      269       define output parameter p-label   as character no-undo .
      270       if index(p-code, chr(4)) > 0 then do:
      271         p-code = entry(1, p-code, chr(4)).
      272       end.
      273       case p-code :
      274               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      275               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      276               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      277               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      278               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      279               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      280               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      281               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      282               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      283         otherwise do:
      284               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      285         end.
      286       end.
      287     end.
      288   end procedure.
      289   procedure schedule-attr-value :
      290   do
      291   on error undo, return error return-value
      292   :
      293   define input parameter  p-cre-db-num as integer    no-undo.
      294   define input parameter  p-task-type  as character  no-undo.
      295   define input parameter  p-task-num   as integer    no-undo.
      296   define input parameter  p-code       as character  no-undo.
      297   define output parameter p-value      as character  no-undo.
      298   define output parameter p-type       as character  no-undo.
      299       define variable v-format         as character no-undo .
      300       define variable v-label          as character no-undo .
      301       define variable v-user-can-edit  as logical   no-undo .
      302       define variable v-output-display as logical   no-undo .
      303       define variable v-other          as character no-undo .
      304       define buffer buf_schedule-attr for ub.schedule-attr.
      305       run schedule-attr-name in this-procedure (
      306             input  p-code
      307           , output p-type
      308           , output v-format
      309           , output v-label
      310           , output v-user-can-edit
      311           , output v-output-display
      312           , output v-other
      313       ) no-error .
      314       if error-status :error
      315       then do:
      316           undo, return error return-value .
      317       end.
      318       if p-code begins ('schd-free-id':U + chr(4))
      319       and entry(2, p-code, chr(4)) = '':U then do:
      320         find first buf_schedule-attr no-lock
      321             where buf_schedule-attr.cre-db-num = p-cre-db-num
      322               and buf_schedule-attr.task-type  = p-task-type
      323               and buf_schedule-attr.task-num   = p-task-num
      324               and buf_schedule-attr.attr-code  begins p-code
      325         no-error .
      326       end.
      327       else do:
      328         find first buf_schedule-attr no-lock
      329             where buf_schedule-attr.cre-db-num = p-cre-db-num
      330               and buf_schedule-attr.task-type  = p-task-type
      331               and buf_schedule-attr.task-num   = p-task-num
      332               and buf_schedule-attr.attr-code  = p-code
      333         no-error .
      334       end.
      335       if available buf_schedule-attr
      336       then do:
      337           assign
      338               p-value = buf_schedule-attr.attr-value
      339           .
      340       end.
      341       else do:
      342         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      343            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      344         end.
      345         else do:
      346           assign
      347               p-value = if p-type = 'L':U then "no":U else ""
      348           .
      349         end.
      350       end.
      351   end.
      352   end procedure.
      353   procedure schedule-attr-write :
      354   do
      355   on error undo, return error
      356   :
      357   define input parameter p-cre-db-num  as integer   no-undo.
      358   define input parameter p-task-type   as character no-undo.
      359   define input parameter p-task-num    as integer   no-undo.
      360   define input parameter p-code        as character no-undo.
      361   define input parameter p-value       as character no-undo.
      362       define variable v-type              as character                no-undo.
      363       define variable v-format            as character                no-undo.
      364       define variable v-label             as character                no-undo.
      365       define variable v-user-can-edit     as logical                  no-undo.
      366       define variable v-output-display    as logical                  no-undo.
      367       define variable v-other             as character                no-undo.
      368       define buffer buf_schedule-attr for ub.schedule-attr .
      369       run schedule-attr-name in this-procedure (
      370             input  p-code
      371           , output v-type
      372           , output v-format
      373           , output v-label
      374           , output v-user-can-edit
      375           , output v-output-display
      376           , output v-other
      377       ) no-error.
      378       if error-status :error
      379       then do:
      380           undo, return error return-value.
      381       end.
      382       find first buf_schedule-attr exclusive-lock
      383            where buf_schedule-attr.cre-db-num = p-cre-db-num
      384              and buf_schedule-attr.task-type  = p-task-type
      385              and buf_schedule-attr.task-num   = p-task-num
      386              and buf_schedule-attr.attr-code  = p-code
      387       no-error.
      388       if not available buf_schedule-attr
      389       then do:
      390           create buf_schedule-attr.
      391           assign
      392             buf_schedule-attr.cre-db-num = p-cre-db-num
      393             buf_schedule-attr.task-type  = p-task-type
      394             buf_schedule-attr.task-num   = p-task-num
      395             buf_schedule-attr.attr-code  = p-code
      396             buf_schedule-attr.attr-value = p-value
      397           .
      398       end.
      399       else do:
      400           assign
      401               buf_schedule-attr.attr-value = p-value
      402           .
      403       end.
      404   end.
      405   end procedure.
      406   procedure schedule-attr-delete :
      407   do
      408   on error undo, return error
      409   :
      410   define input  parameter p-cre-db-num  as integer   no-undo.
      411   define input  parameter p-task-type   as character no-undo.
      412   define input  parameter p-task-num    as integer   no-undo.
      413   define input  parameter p-code        as character no-undo.
      414   define output parameter p-deleted     as logical   no-undo.
      415       define buffer buf_schedule-attr for ub.schedule-attr .
      416       define variable v-type              as character                no-undo.
      417       define variable v-format            as character                no-undo.
      418       define variable v-label             as character                no-undo.
      419       define variable v-user-can-edit     as logical                  no-undo.
      420       define variable v-output-display    as logical                  no-undo.
      421       define variable v-other             as character                no-undo.
      422       run schedule-attr-name in this-procedure (
      423             input p-code
      424           , output v-type
      425           , output v-format
      426           , output v-label
      427           , output v-user-can-edit
      428           , output v-output-display
      429           , output v-other
      430       ) no-error .
      431       if error-status :error
      432       then do:
      433           undo, return error return-value .
      434       end.
      435       find first buf_schedule-attr exclusive-lock
      436            where buf_schedule-attr.cre-db-num = p-cre-db-num
      437              and buf_schedule-attr.task-type  = p-task-type
      438              and buf_schedule-attr.task-num   = p-task-num
      439              and buf_schedule-attr.attr-code  = p-code
      440       no-error.
      441       if not available buf_schedule-attr
      442       then do:
      443           assign
      444               p-deleted = no
      445           .
      446       end.
      447       else do:
      448           delete buf_schedule-attr.
      449           assign
      450               p-deleted = yes
      451           .
      452       end.
      453   end.
      454   end procedure.
      455   procedure schedule-attr-news :
      456   do
      457   on error undo, return error
      458   :
      459       define input  parameter p-code           as character no-undo .
      460       define output parameter p-news           as logical   no-undo .
      461       if index(p-code, chr(4)) > 0 then do:
      462         p-code = entry(1, p-code, chr(4)).
      463       end.
      464       case p-code :
      465               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      466               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      467               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      468               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      469               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      470               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      471               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      472               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      473               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      474         otherwise do:
      475           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      476         end.
      477       end.
      478   end.
      479   end procedure.
      480   procedure schedule-attr-extract-logical :
      481   do
      482   on error undo, return error
      483   :
      484   define input  parameter p-parameter-number   as integer      no-undo.
      485   define input  parameter p-parameter-list     as character    no-undo.
      486   define output parameter p-parameter-value   as logical      no-undo.
      487       if num-entries( p-parameter-list ) > p-parameter-number - 1
      488       then do:
      489           assign
      490               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      491           .
      492       end.
      493       else do:
      494           assign
      495               p-parameter-value   = no
      496           .
      497       end.
      498   end.
      499   end procedure.
      500   procedure schedule-attr-get-free-id :
      501   do
      502   on error undo, return error return-value
      503   :
      504     define input  parameter p-cre-db-num  as integer   no-undo.
      505     define input  parameter p-task-type   as character no-undo.
      506     define input  parameter p-task-num    as integer   no-undo.
      507     define output parameter p-free-id     as character no-undo.
      508     define buffer buf_schedule-attr for ub.schedule-attr.
      509     find first buf_schedule-attr no-lock
      510         where buf_schedule-attr.cre-db-num = p-cre-db-num
      511           and buf_schedule-attr.task-type  = p-task-type
      512           and buf_schedule-attr.task-num   = p-task-num
      513           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      514     no-error .
      515     if available buf_schedule-attr then
      516     assign
      517     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      518     no-error
      519     .
      520   end.
      521   end procedure.
      522   procedure schedule-attr-get-free-props :
      523     define input parameter p-free-id as character no-undo .
      524     define output parameter p-value as character no-undo .
      525     define buffer buf_temp-schedule-free for temp-schedule-free.
      526     do
      527     on error undo, return error return-value
      528     :
      529       find first buf_temp-schedule-free no-lock no-error .
      530       if not available buf_temp-schedule-free then do:
      531         run schedule-attr-fill-free-props in this-procedure .
      532       end.
      533       find first buf_temp-schedule-free where
      534               buf_temp-schedule-free.free-id = p-free-id no-error.
      535       if available buf_temp-schedule-free then do:
      536         assign
      537         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      538                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      539                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      540                   buf_temp-schedule-free.conf-param           + chr(4) +
      541                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      542                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      543                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      544                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      545                   buf_temp-schedule-free.other-info
      546         .
      547       end.
      548       else do:
      549        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      550                              "id произвольной задачи - &5"
      551                              ,vss-workfile
      552                              ,vss-revision
      553                              ,vss-description
      554                              ,chr(10)
      555                              ,p-free-id).
      556       end.
      557     end.
      558   end procedure.
      559   procedure schedule-attr-is-rum-free-id :
      560   define input parameter p-free-id as character no-undo .
      561   define output parameter p-is-rum as logical no-undo .
      562   define buffer buf_temp-schedule-free for temp-schedule-free.
      563   do
      564   on error undo, return error
      565   :
      566       find first buf_temp-schedule-free no-lock no-error .
      567       if not available buf_temp-schedule-free then do:
      568         run schedule-attr-fill-free-props in this-procedure .
      569       end.
      570       find first buf_temp-schedule-free where
      571               buf_temp-schedule-free.free-id = p-free-id no-error.
      572       if available buf_temp-schedule-free
      573       and buf_temp-schedule-free.is-rum
      574       then do:
      575         p-is-rum = yes.
      576       end.
      577   end.
      578   end procedure.
      579   procedure schedule-attr-fill-free-props :
      580   define variable v-path                    as character                no-undo .
      581   DEFINE VARIABLE v-full-path               as character                no-undo .
      582   DEFINE VARIABLE v-file-name               as character                no-undo .
      583   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      584   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      585   define buffer buf_temp-schedule-free for temp-schedule-free.
      586   define variable v-answer as logical no-undo .
      587     do
      588     on error undo, return error substitute("&1 &2 &3&4&5&4"
      589                                           ,vss-workfile
      590                                           ,vss-revision
      591                                           ,vss-description
      592                                           ,chr(10)
      593                                           ,error-status:get-message(1) )
      594     :
      595       run gbl/filename.p (
      596                       input 'cmp/shd-free.d'
      597                     ,output v-full-path
      598                     ,output v-path
      599                     ,output v-file-name
      600                     ,output v-file-name-no-ext
      601                     ,output v-file-name-ext
      602                     ) .
      603       input from value(v-full-path).
      604       repeat :
      605         create buf_temp-schedule-free.
      606         import buf_temp-schedule-free.
      607       END.
      608       input close.
      609       _ff:
      610       for each buf_temp-schedule-free :
      611         if buf_temp-schedule-free.free-id = '':U then do:
      612            delete buf_temp-schedule-free.
      613            next _ff.
      614          end.
      615          run schedule-attr-check-enc in this-procedure (
      616                                                       input  buf_temp-schedule-free.free-id
      617                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      618                                                               buf_temp-schedule-free.proc-param-edit-name +
      619                                                               buf_temp-schedule-free.conf-param +
      620                                                               string(buf_temp-schedule-free.is-gbd) +
      621                                                               string(buf_temp-schedule-free.is-ubd) +
      622                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      623                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      624                                                               string(buf_temp-schedule-free.other-info)
      625                                                               )
      626                                                       ,input  buf_temp-schedule-free.enc-key
      627                                                       ,output v-answer    ) no-error .
      628          if error-status:error
      629          or not v-answer then delete buf_temp-schedule-free.
      630        end.
      631     end.
      632   end procedure.
      633   Function schedule-attr-reverse returns character (str as character).
      634      define variable rev_incl_s as character init "" no-undo .
      635      define variable rev_incl_i as integer no-undo .
      636      define variable rev_incl_l as integer no-undo .
      637      rev_incl_l = length(str).
      638      do rev_incl_i = 1 to rev_incl_l:
      639         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      640      end.
      641      return rev_incl_s.
      642   end.
      643   procedure schedule-attr-check-enc.
      644     define input  parameter p-free-id   as character no-undo .
      645     define input  parameter p-value     as character no-undo .
      646     define input  parameter p-enc-value as character no-undo .
      647     define output parameter p-answer    as logical   no-undo .
      648     define variable tmp         as character no-undo .
      649     define variable v-enc-value as character no-undo .
      650     assign
      651     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      652     .
      653     run schedule-attr-pswd-enc in this-procedure
      654       ( input tmp
      655        ,output v-enc-value
      656       ) no-error .
      657     if error-status:error then do:
      658       message
      659         vss-workfile vss-revision vss-description skip
      660         "Ошибка при вызове процедуры pswd-enc" skip
      661         return-value skip
      662         error-status :get-message(1) skip
      663         view-as alert-box error .
      664       undo, return error .
      665     end.
      666     if v-enc-value = p-enc-value then do:
      667       assign
      668         p-answer = true
      669       .
      670     end.
      671     else do:
      672       assign
      673         p-answer = false
      674       .
      675     end.
      676   end.
      677   procedure schedule-attr-conf-enc.
      678     define input  parameter p-free-id   as character no-undo .
      679     define input  parameter p-value     as character no-undo .
      680     define output parameter p-enc-value as character no-undo .
      681     define variable tmp         as character no-undo .
      682     assign
      683       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      684     .
      685     run schedule-attr-pswd-enc in this-procedure
      686       ( input tmp
      687        ,output p-enc-value
      688       ) no-error .
      689     if error-status:error then do:
      690       message
      691         vss-workfile vss-revision vss-description skip
      692         "Ошибка при вызове процедуры pswd-enc" skip
      693         return-value skip
      694         error-status :get-message(1) skip
      695         view-as alert-box error .
      696       undo, return error .
      697     end.
      698   end procedure.
      699   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      700   procedure schedule-attr-pswd-enc :
      701     define input parameter  pswd     as character no-undo .
      702     define output parameter enc-pswd as character no-undo .
      703     do
      704     on error undo, return error return-value
      705     :
      706       assign
      707         enc-pswd = encode(pswd + string(index(pswd, "k")))
      708       .
      709     end.
      710   end procedure.
      711   define variable mark        as character no-undo.
      712   define variable mark-string as character no-undo .
      713   define variable mark-list   as character no-undo .
      714   define variable g#log       as logical   no-undo .
      715   DEFINE BUTTON b-delmark
      716     LABEL "Снять *"
      717     SIZE 13.8 BY 1.14.
      718   DEFINE BUTTON b-enter AUTO-GO
      719     LABEL "Ввод"
      720     SIZE 22.8 BY 1.14.
      721   DEFINE BUTTON B-exit AUTO-END-KEY
      722     LABEL "Отмена"
      723     SIZE 15 BY 1.14.
      724   DEFINE BUTTON B-mark
      725     LABEL "*"
      726     SIZE 5 BY 1.14.
      727   DEFINE VARIABLE f-day-shift AS INTEGER INITIAL 10
      728     LABEL "Кол. дней хранения"
      729     VIEW-AS FILL-IN
      730     SIZE 14 BY 1.19 NO-UNDO.
      731   DEFINE QUERY BROWSE-2 FOR
      732     ext-system SCROLLING.
      733   FUNCTION mark-string RETURN CHAR (buffer loc-ext-sys for ext-system , input mark-list as character ).
      734     if lookup ( string(recid (loc-ext-sys)) , mark-list ) > 0 then RETURN "*".
      735     else RETURN "".
      736   END FUNCTION.
      737   DEFINE BROWSE BROWSE-2
      738     QUERY BROWSE-2 NO-LOCK DISPLAY
      739     mark-string ( buffer ext-system , input mark-list) @ mark COLUMN-LABEL "*" FORMAT "x(1)"
      740     ext-system.esys-name COLUMN-LABEL "Название ВС" FORMAT "X(30)":U
      741     WIDTH 72
      742     ext-system.esys-id FORMAT "->,>>>,>>9":U WIDTH 5.8
      743     ext-system.esys-db-num-exp COLUMN-LABEL "БД экс" FORMAT ">>>>9":U
      744     WIDTH 7.6
      745     ext-system.esys-db-num-imp COLUMN-LABEL "БД имп" FORMAT ">>>>9":U
      746       WITH NO-ROW-MARKERS SEPARATORS MULTIPLE SIZE 96 BY 24.05 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
      747   DEFINE FRAME gDialog
      748     B-mark AT ROW 1.24 COL 2.2 WIDGET-ID 4
      749     b-delmark AT ROW 1.24 COL 7.8 WIDGET-ID 6
      750     f-day-shift AT ROW 1.24 COL 40 COLON-ALIGNED WIDGET-ID 8
      751     b-enter AT ROW 1.24 COL 57 WIDGET-ID 2
      752     B-exit AT ROW 1.24 COL 80.8
      753     BROWSE-2 AT ROW 2.91 COL 1 WIDGET-ID 200
      754     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      755     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      756     TITLE "Настройки по автоматическому удалению маршрутизации ВС, работающих без подтверждения"
      757     CANCEL-BUTTON B-exit WIDGET-ID 100.
      758     IF CURRENT-WINDOW <> CURRENT-WINDOW THEN
      759     DO:
      760       IF CURRENT-WINDOW:MAX-WIDTH = CURRENT-WINDOW:VIRTUAL-WIDTH THEN
      761         CURRENT-WINDOW:MAX-WIDTH  = SESSION:WIDTH - 1 NO-ERROR.
      762       IF CURRENT-WINDOW:MAX-HEIGHT = CURRENT-WINDOW:VIRTUAL-HEIGHT THEN
      763         CURRENT-WINDOW:MAX-HEIGHT = SESSION:HEIGHT - 1 NO-ERROR.
      764     END.
