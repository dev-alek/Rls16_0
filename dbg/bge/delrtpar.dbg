     1232   FUNCTION getObjectType RETURNS CHARACTER IN SUPER.
     1233     IF VALID-HANDLE(gshRepositoryManager) THEN
     1234     DO:
     1235       IF TRUE THEN
     1236       DO:
     1237         IF NOT
     1238         DYNAMIC-FUNC('prepareInstance':U IN gshRepositoryManager,
     1239                             STRING(THIS-PROCEDURE) + ',':U + STRING(FRAME gDialog:HANDLE) + ',':U + STRING(BROWSE BROWSE-2:HANDLE),SOURCE-PROCEDURE)
     1240         then
     1241         DO:
     1242           STOP.
     1243         END.
     1244         ASSIGN
     1245           ghADMPropsBuf      = WIDGET-HANDLE(ENTRY(1, THIS-PROCEDURE:ADM-DATA, CHR(1))).
     1246           glADMLoadFromRepos = VALID-HANDLE(ghADMPropsBUF).
     1247       END.
     1248     END.
     1249    IF NOT VALID-HANDLE(WIDGET-HANDLE(ENTRY(1,THIS-PROCEDURE:ADM-DATA,CHR(1)))) THEN
     1250    DO:
     1251     CREATE TEMP-TABLE ghADMProps.
     1252     ghADMProps:UNDO    = FALSE.
     1253     ghADMProps:ADD-NEW-FIELD('ObjectName':U, 'CHAR':U, 0, ?, '':U).
     1254     ghADMProps:ADD-NEW-FIELD('ObjectVersion':U, 'CHAR':U, 0, ?,
     1255       'ADM2.2':U).
     1256     ghADMProps:ADD-NEW-FIELD('ObjectType':U, 'CHAR':U, 0, ?,
     1257       'SmartDialog':U).
