      191   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      192   procedure thbjattr_code :
      193      define input  parameter p-upper-code     as character no-undo .
      194      define input  parameter p-code           as character no-undo .
      195      define output parameter p-label          as character no-undo .
      196      define output parameter p-user-can-edit  as logical   no-undo .
      197      define output parameter p-output-display as logical   no-undo .
      198      define output parameter p-other          as character no-undo .
      199      define output parameter p-prop-list      as character no-undo .
      200      define output parameter p-prop-type-list as character no-undo .
      201      define output parameter p-prop-label-list as character no-undo .
      202      define output parameter p-global          as logical no-undo .
      203      define output parameter p-host           as logical no-undo .
      204      define output parameter p-shop           as logical no-undo .
      205      define output parameter p-store          as logical no-undo .
      206      define output parameter p-db             as logical no-undo .
      207      define variable p-region as logical no-undo.
      208      run thbjattr_code_reg in this-procedure (
      209                                               p-upper-code,
      210                                               p-code,
      211                                               output p-label,
      212                                               output p-user-can-edit,
      213                                               output p-output-display,
      214                                               output p-other,
      215                                               output p-prop-list,
      216                                               output p-prop-type-list,
      217                                               output p-prop-label-list,
      218                                               output p-global,
      219                                               output p-host,
      220                                               output p-shop,
      221                                               output p-store,
      222                                               output p-db,
      223                                               output p-region
      224                                               ).
      225   end procedure.
      226   procedure thbjattr_code_reg :
      227   define input  parameter p-upper-code     as character no-undo .
      228   define input  parameter p-code           as character no-undo .
      229   define output parameter p-label          as character no-undo .
      230   define output parameter p-user-can-edit  as logical   no-undo .
      231   define output parameter p-output-display as logical   no-undo .
      232   define output parameter p-other          as character no-undo .
      233   define output parameter p-prop-list      as character no-undo .
      234   define output parameter p-prop-type-list as character no-undo .
      235   define output parameter p-prop-label-list as character no-undo .
      236   define output parameter p-global          as logical no-undo .
      237   define output parameter p-host           as logical no-undo .
      238   define output parameter p-shop           as logical no-undo .
      239   define output parameter p-store          as logical no-undo .
      240   define output parameter p-db             as logical no-undo .
      241   define output parameter p-region         as logical no-undo .
      242   do
      243   on error undo, return error return-value
      244   :
      245       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      246       (input  p-upper-code
      247       ,input  p-code
      248       ,output p-label
      249       ,output p-user-can-edit
      250       ,output p-output-display
      251       ,output p-other
      252       ,output p-prop-list
      253       ,output p-prop-type-list
      254       ,output p-prop-label-list
      255       ,output p-global
      256       ,output p-host
      257       ,output p-shop
      258       ,output p-store
      259       ,output p-db
      260       ,output p-region
      261       ) no-error .
      262     if error-status :error
      263     then do:
      264       undo, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1)).
      265     end.
      266   end.
      267   end procedure.
