      439     end.
      440   end.
      441   end procedure.
      442   procedure thbjattr_delete-section :
      443   define input  parameter p-obj-type   like ub.thbj-attr.obj-type   no-undo .
      444   define input  parameter p-obj-code   like ub.thbj-attr.obj-code   no-undo .
      445   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
      446   do
      447   on error undo, return error return-value
      448   :
      449       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_delete-section in g#attr-lib
      450       (input  p-obj-type
      451       ,input  p-obj-code
      452       ,input  p-upper-code
      453       ) no-error .
      454     if error-status :error
      455     then do:
      456       undo, return error return-value .
      457     end.
      458   end.
      459   end procedure.
      460   procedure thbjattr_manual-edit :
      461   define input  parameter p-ucode          as character no-undo .
      462   define input  parameter p-code           as character no-undo .
      463   define output parameter p-section-num    as integer no-undo .
      464   do
      465   on error undo, return error return-value
      466   :
      467       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_manual-edit in g#attr-lib
      468       (input  p-ucode
      469       ,input  p-code
      470       ,output  p-section-num
      471       ) no-error .
      472     if error-status :error
      473     then do:
      474       undo, return error return-value .
      475     end.
      476   end.
      477   end procedure.
      478   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      479   define temp-table tt-act-header
      480       field num           as character        label "№ акта"      format "X(30)"
      481       field date_         as date             label "Дата акта"
      482       field is-sent       as logical
      483       index pi as primary unique
      484           num
      485   .
      486   define temp-table tt-gds-act
      487       field num           as character                label "№ акта"
      488       field position_     as integer                  label "№ пп"                    format ">>>9"
      489       field type_         as character                label "Тип"         format "X(3)"
      490       field rank          as character                label "Серия"     format "X(3)"
      491       field number        as character                label "Номер"               format "X(9)"
      492       field mark          as character                label "Марка"   format "X(100)"
      493       index pi as primary unique
      494           position_
      495   .
      496   define variable sw as handle no-undo .
      497   define variable v-file              as character no-undo initial "QueryBarcode1.xml".
      498   DEFINE VARIABLE hDoc AS HANDLE NO-UNDO.
      499   DEFINE VARIABLE hRoot AS HANDLE NO-UNDO.
      500   DEFINE VARIABLE good AS LOGICAL NO-UNDO.
      501   procedure makeXML :
      502       create sax-writer sw .
      503       sw:formatted = true.
      504       sw:set-output-destination ("file", v-file).
      505       sw:encoding = "UTF-8".
      506       sw:start-document () .
      507       sw:start-element ("ns:Documents") .
      508       sw:insert-attribute ("Version", "1.0") .
      509       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
      510       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
      511       sw:insert-attribute ("xmlns:bk", "http://fsrar.ru/WEGAIS/QueryBarcode") .
      512       sw:insert-attribute ("xmlns:ce", "http://fsrar.ru/WEGAIS/CommonEnum") .
      513           sw:start-element ("ns:Owner") .
      514               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
      515           sw:end-element ("ns:Owner") .
      516           sw:start-element ("ns:Document") .
      517               sw:start-element ("ns:QueryBarcode") .
      518                   sw:write-data-element ("bk:QueryNumber", tt-act-header.num) no-error .
      519                   sw:write-data-element ("bk:Date", string(iso-date(tt-act-header.date_)) + "T12:00:00") no-error .
      520                   sw:start-element ("bk:Marks") .
      521       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
      522                       sw:start-element ("bk:Mark") .
      523                           sw:write-data-element ("bk:Identity", string(tt-gds-act.position_)) no-error .
      524                           sw:write-data-element ("bk:Type", tt-gds-act.type_) no-error .
      525                           sw:write-data-element ("bk:Rank", tt-gds-act.rank) no-error .
      526                           sw:write-data-element ("bk:Number", tt-gds-act.number) no-error .
      527                           if tt-gds-act.mark <> ? and tt-gds-act.mark <> ""
      528                           then sw:write-data-element ("bk:Barcode", tt-gds-act.mark) no-error .
      529                       sw:end-element ("bk:Mark") .
      530       end.
      531                   sw:end-element ("bk:Marks") .
      532               sw:end-element ("ns:QueryBarcode") .
      533           sw:end-element ("ns:Document") .
      534       sw:end-element ("ns:Documents") .
      535       sw:end-document () .
      536       delete object sw.
      537   end procedure .
      538   procedure parseXML :
      539       define input parameter inFile as character no-undo .
      540       empty temp-table tt-act-header .
      541       empty temp-table tt-gds-act .
      542       CREATE X-DOCUMENT hDoc.
      543       CREATE X-NODEREF hRoot.
      544       hDoc:encoding = 'utf-8'.
      545       hDoc:LOAD("file", search(inFile),FALSE).
      546       hDoc:GET-DOCUMENT-ELEMENT(hRoot).
      547       RUN GetChildren(hRoot, 1).
      548       DELETE OBJECT hDoc.
      549       DELETE OBJECT hRoot.
      550   end procedure .
      551   procedure GetChildren :
      552       DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
      553       DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
      554       DEFINE VARIABLE i AS INTEGER NO-UNDO.
      555       DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
      556       DEFINE VARIABLE hText AS HANDLE NO-UNDO.
      557       CREATE X-NODEREF hNoderef.
      558       CREATE X-NODEREF hText .
      559       REPEAT i = 1 TO hParent:NUM-CHILDREN:
      560           good = hParent:GET-CHILD(hNoderef,i).
      561           IF NOT good THEN
      562               LEAVE.
      563           IF hNoderef:SUBTYPE <> "element" THEN
      564               NEXT.
      565           hNoderef:GET-CHILD(hText, 1) no-error .
      566           IF hNoderef:NAME = "bk:QueryNumber" THEN do :
      567               create tt-act-header .
      568               assign tt-act-header.num = hText:node-value no-error .
      569               assign tt-act-header.is-sent = bh-act-header:buffer-field("is-sent"):buffer-value no-error.
      570           end .
      571           .
      572           IF hNoderef:NAME = "bk:Date" THEN
      573               assign tt-act-header.date_ = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
      574           IF hNoderef:NAME = "bk:Mark" THEN do :
      575               create tt-gds-act .
      576               assign tt-gds-act.num = tt-act-header.num .
      577           end.
      578           IF hNoderef:NAME = "bk:Identity" THEN assign tt-gds-act.position_ = integer(hText:node-value) no-error .
      579           IF hNoderef:NAME = "bk:Type" THEN assign tt-gds-act.type_ = hText:node-value no-error .
      580           IF hNoderef:NAME = "bk:Rank" THEN assign tt-gds-act.rank = hText:node-value no-error .
      581           IF hNoderef:NAME = "bk:Number" THEN assign tt-gds-act.number = hText:node-value no-error .
      582           IF hNoderef:NAME = "bk:Barcode" THEN assign tt-gds-act.mark = hText:node-value no-error .
      583           run GetChildren (hNoderef, (level + 1)).
      584       END.
      585       DELETE OBJECT hNoderef.
      586       DELETE OBJECT hText.
      587   END procedure.
      588   DEFINE BUTTON Btn_lkp
      589        LABEL "Просмотр"
      590        SIZE 15 BY 1.13.
      591   DEFINE BUTTON Btn_create
      592        LABEL "Создать"
      593        SIZE 15 BY 1.13.
      594   DEFINE BUTTON Btn_chg
      595        LABEL "Изменить"
      596        SIZE 15 BY 1.13.
      597   DEFINE BUTTON Btn_del
      598        LABEL "Удалить"
      599        SIZE 15 BY 1.13.
      600   DEFINE BUTTON Btn_send
      601        LABEL "Отправить"
      602        SIZE 15 BY 1.13.
      603   DEFINE BUTTON Btn_OK AUTO-GO
      604        LABEL "Выход"
      605        SIZE 15 BY 1.13
      606        BGCOLOR 8 .
      607   DEFINE BUTTON Btn_Ans
      608        LABEL "Получить ответ"
      609        SIZE 20 BY 1.13
      610        BGCOLOR 8 .
      611   DEFINE BUTTON Btn_Edit
      612        LABEL "Редактировать"
      613        SIZE 15 BY 1.13 tooltip "Вернуть в 'Новые' для редактирования"
      614        BGCOLOR 8 .
      615   DEFINE VARIABLE RADIO-SET-1 AS INTEGER INITIAL 1
      616        VIEW-AS RADIO-SET HORIZONTAL
      617        RADIO-BUTTONS
      618             "Новые", 1,
      619             "Отправленные", 2
      620        SIZE 27 BY 1.25 NO-UNDO.
      621   DEFINE FRAME Dialog-Frame
      622        Btn_OK AT ROW 1.2 COL 2
      623        Btn_create at row 1.2 col 17
      624        Btn_chg at row 1.2 col 32
      625        Btn_del at row 1.2 col 47
      626        Btn_send at row 1.2 col 62
      627        Btn_Ans AT ROW 1.2 COL 32 WIDGET-ID 10
      628        Btn_lkp AT ROW 1.2 COL 17 WIDGET-ID 12
      629        Btn_Edit AT ROW 1.2 COL 52
      630        RADIO-SET-1 AT ROW 1.2 COL 80 NO-LABEL WIDGET-ID 2
      631        SPACE(2) SKIP(23.5)
      632       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      633            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      634            TITLE "Запрос на получение штрихкода (марки) ЕГАИС"
      635            DEFAULT-BUTTON Btn_OK WIDGET-ID 100.
      636   ASSIGN
      637          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      638          FRAME Dialog-Frame:HIDDEN           = TRUE.
      639   ON window-close OF FRAME Dialog-Frame
      640   do:
      641     apply "END-ERROR":U to self.
      642   end.
      643   ON CHOOSE OF Btn_lkp IN FRAME Dialog-Frame
      644   DO:
      645       if not bh-act-header:available then return no-apply .
      646       run bge/egais-QueryBarcode.w (parparentproc, 'ПРОСМОТР':U, egais, v-ext-sys, v-fs-rar, bh-act-header:handle) .
      647   END.
      648   ON CHOOSE OF Btn_Edit IN FRAME Dialog-Frame
      649   DO:
      650       if not bh-act-header:available then return no-apply .
      651       message "Вы уверены, что хотите вернуть акт " bh-act-header:buffer-field ("num"):buffer-value " в 'новые' для редактирования?"
      652       view-as alert-box question buttons yes-no update glog .
      653       if not glog then return no-apply .
      654       find last buf_clob-bind where buf_clob-bind.field-name_ = 'egais-qb':U and buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value .
      655       entry(3, buf_clob-bind.descr, chr(4)) = string(no) no-error .
      656       bh-act-header:buffer-field ("is-sent"):buffer-value = string(no) no-error .
      657       find first ub.esys-all-attr
      658                   where ub.esys-all-attr.table-name = "esys-pck-sent"
      659                   and ub.esys-all-attr.attr-code = "egais"
      660                   and ub.esys-all-attr.key2       = 4
      661                   and ub.esys-all-attr.attr-value = buf_clob-bind.uniq-key-rec
      662                   no-error.
      663       if available (ub.esys-all-attr )
      664       then do:
      665         delete ub.esys-all-attr .
      666       end.
      667       run refresh-query .
      668   END.
      669   ON CHOOSE OF Btn_create IN FRAME Dialog-Frame
      670   DO:
      671       run bge/egais-QueryBarcode.w (parparentproc, 'ДОБАВЛЕНИЕ':U, egais, v-ext-sys, v-fs-rar, bh-act-header:handle) .
      672       run refresh-query.
      673   END.
      674   ON CHOOSE OF Btn_chg IN FRAME Dialog-Frame
      675   DO:
      676       if not bh-act-header:available then return no-apply .
      677       run bge/egais-QueryBarcode.w (parparentproc, 'ИЗМЕНЕНИЕ':U, egais, v-ext-sys, v-fs-rar, bh-act-header:handle) .
      678       run refresh-query.
      679   END.
      680   ON CHOOSE OF Btn_del IN FRAME Dialog-Frame
      681   DO:
      682       if not bh-act-header:available then return no-apply .
      683       find last buf_clob-bind where buf_clob-bind.field-name_ = 'egais-qb':U and buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value .
      684       delete buf_clob-bind .
      685       bh-act-header:buffer-delete () .
      686       run refresh-query.
      687   END.
      688   ON CHOOSE OF Btn_send IN FRAME Dialog-Frame
      689   DO:
      690       if not bh-act-header:available then return no-apply .
      691       find last buf_clob-bind where buf_clob-bind.field-name_ = 'egais-qb':U and buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value .
      692       find first buf_clob-data no-lock where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
      693       os-delete "temp-QueryBarcode.xml".
      694       copy-lob
      695       from  object buf_clob-data.cdata
      696       to  file 'temp-QueryBarcode.xml'
      697       no-convert
      698       no-error .
      699       run parseXML in this-procedure (input "temp-QueryBarcode.xml") .
      700       find first tt-act-header .
      701       find first tt-gds-act where tt-gds-act.type_ = ? or tt-gds-act.type_ = ""
      702                                 or tt-gds-act.rank = ? or tt-gds-act.rank = ""
      703                                 or tt-gds-act.number = ? or tt-gds-act.number = "" no-error .
      704       if available tt-gds-act
      705       then do :
      706           message "Должны быть заполнены все поля!" view-as alert-box .
      707           return no-apply.
      708       end.
      709       v-file = 'QueryBarcode.xml' .
      710       os-delete "QueryBarcode.xml" .
      711       run makeXML .
      712       egais:inNum = tt-act-header.num .
      713       egais:SendRequestUTM() .
      714       glog = egais:IsSent .
      715       glog = egais:StatusErr .
      716       if glog then do :
      717           message egais:Msg view-as alert-box.
      718           return no-apply.
      719       end.
      720       else do :
      721           entry (3, buf_clob-bind.descr, chr(4)) = "yes".
      722           bh-act-header:buffer-field ("is-sent"):buffer-value = true.
      723       end.
      724       run refresh-query.
      725   END.
      726   ON CHOOSE OF Btn_Ans IN FRAME Dialog-Frame
      727   DO:
      728     if not bh-act-header:available
      729       then return no-apply.
      730         egais:inNum = bh-act-header:buffer-field ("num"):buffer-value .
      731         egais:GetHndlTable(2, bh-act-header:buffer-field ("num"):buffer-value) .
      732         glog = egais:StatusErr .
      733         if glog
      734         then do :
      735               message egais:Msg view-as alert-box.
      736               return no-apply.
      737         end.
      738         run parseXML in this-procedure (input "RespQueryBarcode.xml") .
      739         find first tt-act-header no-error .
      740         if not available tt-act-header then do :
      741             create x-document hDoc no-error.
      742             create x-noderef  hRoot no-error.
      743             hDoc:load ("file", "RespQueryBarcode.xml", false).
      744             hDoc:get-document-element(hRoot) .
      745             run ParseResponse(hRoot, 1).
      746             DELETE OBJECT hDoc no-error.
      747             DELETE OBJECT hRoot no-error.
      748             message v-Answer view-as alert-box .
      749             return no-apply .
      750         end.
      751         run makeXML in this-procedure no-error.
      752       if error-status:error then return return-value .
      753       assign
      754           v-clob-db-num = ?
      755           v-int64-id = 0
      756           v-info = tt-act-header.num + chr(4) + string(tt-act-header.date_) + chr(4) + string(tt-act-header.is-sent)
      757       .
      758       find first buf_clob-bind exclusive-lock where buf_clob-bind.uniq-key-rec = tt-act-header.num
      759                                                 and buf_clob-bind.field-name_  = 'egais-qb':U no-error .
      760       if available buf_clob-bind then do :
      761           assign
      762               v-clob-db-num = buf_clob-bind.db-num
      763               v-int64-id = buf_clob-bind.int64-id
      764               v-part-num = buf_clob-bind.part-num
      765           .
      766           run gbl/file2clb.p ( input 'ИЗМЕНЕНИЕ':U
      767                     ,input "add-new,yes"
      768                     ,input ?
      769                     ,input tt-act-header.num
      770                     ,input 'egais-qb':U
      771                     ,input v-info
      772                     ,input-output v-part-num
      773                     ,input 'egais-qb':U
      774                     ,input-output v-clob-db-num
      775                     ,input-output v-int64-id
      776                     ,input search (v-file)
      777                     ,input ''
      778                     ) no-error .
      779            if error-status:error then message return-value view-as alert-box.
      780       end.
      781       def var v-out-file as character no-undo .
      782       define variable v-user-action    as character no-undo.
      783       define variable v-printed        as logical   no-undo.
      784       v-out-file = "marks-" + tt-act-header.num + ".txt" .
      785       output to value(v-out-file) .
      786           for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
      787               put unformatted tt-gds-act.mark skip .
      788           end.
      789       output close.
      790       message "Марки выгружены в файл " v-out-file " в рабочей директории" view-as alert-box .
      791       run gbl/prnfilen.w
      792              (input  "Акцизнае марки"
      793              ,input  0
      794              ,input  v-out-file
      795              ,input  7
      796              ,output v-user-action
      797              ,output v-printed
      798              ).
      799     run refresh-query.
      800   END.
      801   ON value-changed OF RADIO-SET-1 IN FRAME Dialog-Frame
      802   do:
      803     assign RADIO-SET-1 .
      804     if RADIO-SET-1 = 1
      805     then do :
      806       ENABLE Btn_create Btn_chg Btn_del Btn_send
      807         WITH FRAME Dialog-Frame.
      808       HIDE Btn_Ans Btn_lkp Btn_Edit in FRAME Dialog-Frame.
      809     end.
      810     else do :
      811       ENABLE Btn_Ans Btn_lkp Btn_Edit
      812         WITH FRAME Dialog-Frame.
      813       HIDE Btn_create Btn_chg Btn_del Btn_send in FRAME Dialog-Frame.
      814     end.
      815     run refresh-query.
      816   end.
      817   if valid-handle(active-window) and frame Dialog-Frame:PARENT eq ?
      818   then frame Dialog-Frame:PARENT = active-window.
      819   MAIN-BLOCK:
      820   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
      821      on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
      822   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      823   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
      824     (output v-db-num
      825     ,output v-user-id
      826     ) no-error .
      827     empty temp-table thbjattr_thbj-attr .
      828     run adm/shattri.p (
      829          input "get":U
      830         ,input v-cntxt-obj-type
      831         ,input v-cntxt-obj-code
      832         ,input 'egais':U
      833         ,input 'egais-fsrar':U
      834         ,output v-value-character
      835         ,output v-value-date
      836         ,output v-value-decimal
      837         ,output v-value-integer
      838         ,output v-value-logical
      839         ,output v-value-type
      840         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      841         ) no-error .
      842     assign
      843       v-fs-rar = v-value-character
      844     .
      845     run adm/shattri.p (
      846          input "get":U
      847         ,input '':U
      848         ,input 0
      849         ,input 'egais':U
      850         ,input 'egais-exsys':U
      851         ,output v-value-character
      852         ,output v-value-date
      853         ,output v-value-decimal
      854         ,output v-value-integer
      855         ,output v-value-logical
      856         ,output v-value-type
      857         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      858         ) no-error .
      859     assign v-ext-sys = v-value-integer .
      860     egais = new QueryBarcode (v-cntxt-obj-type, v-cntxt-obj-code, v-fs-rar, v-ext-sys).
      861     egais:DbNum = v-db-num .
      862     egais:User_Id = v-user-id .
      863     bh-act-header = egais:GetHndlTable(3, "").
      864     create query qh-act-header.
      865     run refresh-query.
      866     create browse browse-hdl-act-header
      867       assign
      868         title     = 'Запросы на получение штрихкода по серии и номеру марки'
      869         frame     = frame Dialog-Frame:handle
      870         query     = qh-act-header
      871         x         = 10
      872         y         = 42
      873         width     = 105
      874         height    = 23
      875         visible   = true
      876         read-only = true
      877         sensitive = true
      878         separators = true
      879         column-resizable = true
      880         column-scrolling = true
      881         triggers:
      882         end triggers
      883     .
      884     if not bh-act-header = ?
      885     then do:
      886       do ii = 1 to bh-act-header:num-fields - 1:
      887         bcol[ii] = browse-hdl-act-header:add-like-column('tt-act-header' + '.' + bh-act-header:buffer-field (ii):name, 0, 'FILL-IN').
      888       end.
      889       browse-hdl-act-header:get-browse-column (1):width-chars = 30.
      890       browse-hdl-act-header:get-browse-column (2):width-chars = 69.
      891     end.
      892     run enable_UI.
      893     apply "value-changed" to RADIO-SET-1 in frame Dialog-Frame.
      894     wait-for go of frame Dialog-Frame.
      895   end.
      896   run disable_UI.
      897   PROCEDURE disable_UI :
      898     HIDE FRAME Dialog-Frame.
      899   END PROCEDURE.
      900   PROCEDURE enable_UI :
      901     DISPLAY RADIO-SET-1
      902         WITH FRAME Dialog-Frame.
      903     ENABLE Btn_OK RADIO-SET-1
      904         WITH FRAME Dialog-Frame.
      905     VIEW FRAME Dialog-Frame.
      906   END PROCEDURE.
      907   PROCEDURE refresh-query :
      908   if bh-act-header = ?
      909     then return .
      910     case RADIO-SET-1 :
      911       when 1  then
      912       do:
      913         bh-act-header = egais:GetHndlTable(3, "").
      914         qh-act-header:set-buffers (bh-act-header).
      915         qh-act-header:query-prepare ("for each tt-act-header where not tt-act-header.is-sent by tt-act-header.date_ descending").
      916         qh-act-header:query-open.
      917       end.
      918       when 2  then
      919       do:
      920         bh-act-header = egais:GetHndlTable(3, "").
      921         qh-act-header:set-buffers (bh-act-header).
      922         qh-act-header:query-prepare ("for each tt-act-header where tt-act-header.is-sent by tt-act-header.date_ descending").
      923         qh-act-header:query-open.
      924       end.
      925     end case.
      926   if valid-handle (browse-hdl-act-header) then apply "value-changed" to browse-hdl-act-header.
      927   end.
      928   PROCEDURE proc-row-leave :
      929     if false then do:
      930       do ii = 1 to extent (bcol).
      931         bcol[ii]:bgcolor = RED_COLOR.
      932       end.
      933     end.
      934   end.
      935   procedure ParseResponse :
      936           define input parameter hParent AS HANDLE .
      937           define input parameter level AS INTEGER .
      938           DEFINE VARIABLE i AS INTEGER NO-UNDO.
      939           DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
      940           DEFINE VARIABLE hText AS HANDLE NO-UNDO.
      941           define variable v-ok as logical no-undo .
      942           CREATE X-NODEREF hNoderef.
      943           CREATE X-NODEREF hText .
      944           REPEAT i = 1 TO hParent:NUM-CHILDREN:
      945               good = hParent:GET-CHILD(hNoderef,i).
      946               IF NOT good THEN
      947                   LEAVE.
      948               IF hNoderef:SUBTYPE <> "element" THEN
      949                   NEXT.
      950               hNoderef:GET-CHILD(hText, 1) no-error .
      951               IF hNoderef:NAME = "tc:Comments" THEN do :
      952                   v-Answer = hText:node-value .
      953               end.
      954               run ParseResponse(input hNoderef, input (level + 1)).
      955           END.
      956           DELETE OBJECT hNoderef.
      957           DELETE OBJECT hText.
      958     END.
