     1768     define buffer buf_utd-marking-lines for ub.utd-marking-lines .
     1769     define buffer buf_utd-lines         for ub.utd-lines .
     1770     define variable v-part-rowid as rowid no-undo .
     1771     define variable v-tbl-name as character no-undo .
     1772     define variable oMotp as class is_motp no-undo .
     1773     define variable v-ok as logical no-undo .
     1774     define variable v-found as logical no-undo .
     1775     define variable ii as integer no-undo.
     1776     if transaction then do:
     1777       message
     1778         substitute( "&1. Вызов данной процедуры невозможен при наличии транзакции", vss-workfile )
     1779         view-as alert-box error .
     1780       return error .
     1781     end.
     1782     assign
     1783       g#auto                = true
     1784       g#esys                = true
     1785       v-num-entries-db-list = num-entries( p-list-db )
     1786     .
     1787     run gbl/set-gbl.p
     1788       (input true
     1789       ,input p-user-login
     1790       ,input p-user-password
     1791       ) no-error.
     1792     if error-status :error
     1793     then do:
     1794       run write-to-log( substitute("&1. Ошибка при инициализации переменных g#... &2&3&4"
     1795                                     ,vss-workfile
     1796                                     ,error-status:get-message(error-status:num-messages)
     1797                                     ,chr(10)
     1798                                     ,return-value
     1799                                   )
     1800                       ) .
     1801       return error.
     1802     end.
     1803     assign
     1804       g#auto = true
     1805       g#esys = true
     1806     .
     1807   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1808   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1809   function getattrUtdex returns char
     1810   (idb-num   as integer,
     1811    idoc-id   as integer,
     1812    iattrcode as character,
     1813    iExValue  as character  ):
     1814      define buffer utd-attr for utd-attr.
     1815      find first utd-attr where utd-attr.db-num eq idb-num
     1816                            and utd-attr.doc-id eq idoc-id
     1817                            and utd-attr.attr-code eq iattrcode
     1818      no-lock no-error.
     1819      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     1820   end.
     1821   function getattrUtd returns char
     1822   (idb-num   as integer,
     1823    idoc-id   as integer,
     1824    iattrcode as character ):
     1825     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     1826   end.
     1827   function setattrUtd returns logical
     1828   (idb-num   as integer,
     1829    idoc-id   as integer,
     1830    iattrcode as character,
     1831    iattrval  as character ):
     1832      define buffer utd-attr for utd-attr.
     1833      find first utd-attr where utd-attr.db-num eq idb-num
     1834                            and utd-attr.doc-id eq idoc-id
     1835                            and utd-attr.attr-code eq iattrcode
     1836      no-lock no-error.
     1837      if not available utd-attr
     1838      then do:
     1839         create utd-attr.
     1840         assign
     1841            utd-attr.db-num    = idb-num
     1842            utd-attr.doc-id    = idoc-id
     1843            utd-attr.attr-code = iattrcode
     1844            utd-attr.attr-value = iattrval
     1845         .
     1846      end.
     1847      else do:
     1848         if utd-attr.attr-value ne iattrval
     1849         then do:
     1850            find current utd-attr exclusive-lock no-error.
     1851            if available utd-attr
     1852            then
     1853               utd-attr.attr-value = iattrval.
     1854         end.
     1855      end.
     1856      release utd-attr.
     1857   end.
     1858   function GetAttrUtdlinesEx returns char
     1859   (idb-num   as integer,
     1860    idoc-id   as integer,
     1861    ilinenum  as integer,
     1862    iattrcode as character,
     1863    iExValue  as character  ):
     1864      define buffer utd-lines-attr for utd-lines-attr.
     1865      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     1866                                  and utd-lines-attr.doc-id    eq idoc-id
     1867                                  and utd-lines-attr.lineNum   eq ilineNum
     1868                                  and utd-lines-attr.attr-code eq iattrcode
     1869      no-lock no-error.
     1870      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     1871   end.
     1872   function GetAttrUtdlines returns char
     1873   (idb-num   as integer,
     1874    idoc-id   as integer,
     1875    ilinenum  as integer,
     1876    iattrcode as character ):
     1877      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     1878   end.
     1879   function setattrUtdlines returns logical
     1880   (idb-num   as integer,
     1881    idoc-id   as integer,
     1882    ilinenum  as integer,
     1883    iattrcode as character,
     1884    iattrval  as character ):
     1885      define buffer utd-lines-attr for utd-lines-attr.
     1886      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     1887                                  and utd-lines-attr.doc-id    eq idoc-id
     1888                                  and utd-lines-attr.lineNum   eq ilineNum
     1889                                  and utd-lines-attr.attr-code eq iattrcode
     1890      no-lock no-error.
     1891      if not available utd-lines-attr
     1892      then do:
     1893         if iattrval ne ?
     1894            and iattrval ne ""
     1895         then do:
     1896            create utd-lines-attr.
     1897            assign
     1898               utd-lines-attr.db-num    = idb-num
     1899               utd-lines-attr.doc-id    = idoc-id
     1900               utd-lines-attr.lineNum   = ilineNum
     1901               utd-lines-attr.attr-code = iattrcode
     1902               utd-lines-attr.attr-value = iattrval
     1903            .
     1904         end.
     1905      end.
     1906      else do:
     1907         if utd-lines-attr.attr-value ne iattrval
     1908         then do:
     1909            find current utd-lines-attr exclusive-lock no-error.
     1910            if available utd-lines-attr
     1911            then do:
     1912               if    iattrval eq ?
     1913                  or iattrval eq ""
     1914               then do:
     1915                  delete utd-lines-attr.
     1916               end.
     1917               else do:
     1918                  utd-lines-attr.attr-value = iattrval.
     1919               end.
     1920            end.
     1921         end.
     1922      end.
     1923      release utd-lines-attr.
     1924   end.
     1925   function GetAttrUtdMarkingLinesEx returns char
     1926   (idb-num   as integer,
     1927    idoc-id   as integer,
     1928    ilinenum  as integer,
     1929    imark     as character,
     1930    iattrcode as character,
     1931    iExValue  as character  ):
