     1997   end.
     1998   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1999   procedure gen-key-rec :
     2000     define input  parameter p-tbl-name    as character no-undo.
     2001     define input  parameter p-bh_tbl-name as handle    no-undo.
     2002     define output parameter p-key-rec     as character no-undo.
     2003     do
     2004     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2005     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2006     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2007     :
     2008       define variable fh               as handle    no-undo .
     2009       define variable v-ok             as logical   no-undo .
     2010       define variable v-inform         as character no-undo .
     2011       define variable v-ind            as integer   no-undo .
     2012       define variable v-idx-field-qnty as integer   no-undo .
     2013       if p-tbl-name = ?
     2014         or p-tbl-name = "":U
     2015       then do:
     2016         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info10 ).
     2017       end.
     2018       if not p-bh_tbl-name:available then do:
     2019         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info10, p-tbl-name ).
     2020       end.
     2021       assign
     2022         p-key-rec = p-tbl-name
     2023         v-inform  = p-bh_tbl-name:index-information(1)
     2024         v-ind     = 2
     2025       .
     2026       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2027       on error undo, return error
     2028       :
     2029         assign
     2030           v-inform = p-bh_tbl-name:index-information( v-ind )
     2031           v-ind    = v-ind + 1
     2032         .
     2033       end.
     2034       if v-inform = ?
     2035         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2036         or entry( 3, v-inform, ",":U ) <> "1":U
     2037       then do:
     2038         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, p-tbl-name ).
     2039       end.
     2040       else do:
     2041         assign
     2042           v-idx-field-qnty = num-entries( v-inform ) - 4
     2043         .
     2044         if v-idx-field-qnty < 2 then do:
     2045           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, p-tbl-name ).
     2046         end.
     2047         do v-ind = 1 to v-idx-field-qnty by 2
     2048         on error undo, return error
     2049         :
     2050           assign
     2051             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2052             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2053           .
     2054         end.
     2055       end.
     2056       if p-key-rec = ? then do:
     2057         assign
     2058           p-key-rec = "":U
     2059         .
     2060         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info10, p-tbl-name ).
     2061       end.
     2062     end.
     2063     return.
     2064   end procedure.
     2065   procedure gen-where-keyr-tab :
     2066     define input  parameter i-tableSerach as character no-undo.
     2067     define input  parameter i-tablekey   as character  no-undo.
     2068     define input  parameter p-key-rec    as character  no-undo.
     2069     define input  parameter p-key-handle as handle     no-undo .
     2070     define input  parameter p-db-name    as character  no-undo .
     2071     define input  parameter p-tt-handle  as handle     no-undo .
     2072     define output parameter o-Where      as character  no-undo.
     2073     do
     2074     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2075     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2076     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2077     :
     2078       define variable v-full-tbl-name  as character no-undo .
     2079       define variable bh_tbl-name      as handle    no-undo .
     2080       define variable fh_key           as handle    no-undo .
     2081       define variable fh_search        as handle    no-undo .
     2082       define variable v-field-num      as integer   no-undo .
     2083       define variable v-count-fld      as integer   no-undo .
     2084       define variable v-inform         as character no-undo .
     2085       define variable v-ind            as integer   no-undo .
     2086       define variable v-idx-field-qnty as integer   no-undo .
     2087       define variable v-field-name     as character no-undo .
     2088       define variable v-field-val      as character no-undo .
     2089       define variable v-word-link      as character no-undo .
     2090       define variable vTable           as character no-undo.
     2091       define variable bh_tbl-key       as handle    no-undo .
     2092       assign
     2093         p-key-rec = trim( p-key-rec )
     2094       .
     2095       if p-key-handle <> ? then do:
     2096         if not valid-handle(p-key-handle)
     2097            or p-key-handle:type <> "buffer"
     2098         then do:
     2099           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info10 ).
     2100         end.
     2101         if num-entries( p-key-rec, chr(3) ) > 1
     2102           or p-key-rec = ?
     2103           or p-key-rec = "":U
     2104         then do:
     2105           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info10, p-key-rec ).
     2106         end.
     2107       end.
     2108       else do:
     2109         if p-key-rec = ?
     2110           or p-key-rec = "":U
     2111         then do:
     2112           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info10 ).
     2113         end.
     2114       end.
     2115       assign
     2116         vTable = entry( 1 , p-key-rec, chr(3) )
     2117       .
     2118       if p-tt-handle <> ?
     2119         and ( not valid-handle(p-tt-handle)
     2120               or p-tt-handle:type <> "buffer"
     2121             )
     2122       then do:
     2123         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info10, vTable, chr(10) ).
     2124       end.
     2125       if p-tt-handle = ? then do:
     2126         assign
     2127           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2128         .
     2129         create buffer bh_tbl-name for table v-full-tbl-name .
     2130       end.
     2131       else do:
     2132         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2133       end.
     2134       assign
     2135         v-inform = bh_tbl-name:index-information(1)
     2136         v-ind    = 2
     2137       .
     2138       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2139       on error undo, return error
     2140       :
     2141         assign
     2142           v-inform = bh_tbl-name:index-information( v-ind )
     2143           v-ind    = v-ind + 1
     2144         .
     2145       end.
     2146       if v-inform = ?
     2147         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2148         or entry( 3, v-inform, ",":U ) <> "1":U
     2149       then do:
     2150         delete object bh_tbl-name no-error.
     2151         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info10, vTable ).
     2152       end.
     2153       assign
     2154         v-idx-field-qnty = num-entries( v-inform ) - 4
     2155       .
     2156       if v-idx-field-qnty < 2 then do:
     2157         delete object bh_tbl-name no-error.
     2158         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, vTable ).
     2159       end.
     2160       assign
     2161         o-where     = "where":U
     2162         v-word-link = "":U
     2163         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2164         v-count-fld = 0
     2165       .
     2166       if i-tablekey ne "" and i-tablekey ne ?
     2167       then do:
     2168         assign
     2169           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2170         .
     2171         create buffer bh_tbl-key for table v-full-tbl-name .
     2172       end.
     2173       if i-tableSerach ne "" and i-tableSerach ne ?
     2174       then do:
     2175         delete object bh_tbl-name no-error.
     2176         assign
     2177           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2178         .
     2179         create buffer bh_tbl-name for table v-full-tbl-name .
     2180       end.
     2181       block_where:
     2182       do v-ind = 1 to v-idx-field-qnty by 2
     2183       on error undo, return error
     2184       :
     2185         assign
     2186           v-count-fld = v-count-fld + 1
     2187         .
     2188         if p-key-handle = ?
     2189           and v-count-fld > v-field-num
     2190         then do:
     2191           leave block_where.
     2192         end.
     2193         define variable VfieldKeyTable as handle no-undo.
     2194         assign
     2195           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2196           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2197         .
     2198         if     bh_tbl-key ne ?
     2199         then do:
     2200            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2201            if VfieldKeyTable eq ?
     2202            then next block_where.
     2203         end.
     2204         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2205         then
     2206            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2207         else
     2208            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2209         if p-key-handle = ? then do:
     2210           assign
     2211             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2212           .
     2213         end.
     2214         else do:
     2215           assign
     2216             fh_key = p-key-handle:buffer-field( v-field-name )
     2217           .
     2218           if fh_key = ?
     2219             or not valid-handle( fh_key )
     2220           then do:
     2221             delete object bh_tbl-name.
     2222             if     bh_tbl-key ne ?
     2223             then
     2224                delete object bh_tbl-key.
     2225             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info10, p-key-handle:name, v-field-name ).
     2226           end.
     2227           assign
     2228             v-field-val = fh_key:buffer-value
     2229           .
     2230         end.
     2231         if fh_search:data-type ="character":U then do:
     2232           assign
     2233             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2234             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2235             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2236             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2237             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2238             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2239             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2240             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2241             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2242             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2243             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2244             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2245             v-field-val = substitute( '"&1"', v-field-val )
     2246           .
     2247         end.
     2248         assign
     2249           o-where = substitute( "&1 &2", o-where, v-field-val )
     2250         .
     2251         if v-word-link = "":U then do:
     2252           assign
     2253             v-word-link = "and":U
     2254           .
     2255         end.
     2256       end.
     2257       delete object bh_tbl-name.
     2258       if     bh_tbl-key ne ?
     2259       then
     2260          delete object bh_tbl-key.
     2261       if p-key-handle = ?
     2262         and v-count-fld <> v-field-num
     2263       then do:
     2264         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info10, vTable ).
     2265       end.
     2266     end.
     2267   end procedure.
     2268   procedure gen-hn-keyr-tab :
     2269     define input  parameter i-tableSerach as character no-undo.
     2270     define input  parameter i-tablekey   as character no-undo.
     2271     define input  parameter p-key-rec    as character no-undo.
     2272     define input  parameter p-key-handle as handle    no-undo .
     2273     define input  parameter p-db-name    as character no-undo .
     2274     define input  parameter p-tt-handle  as handle    no-undo .
     2275     define input  parameter p-stts-lock  as integer   no-undo .
     2276     define output parameter o-hn         as handle    no-undo.
     2277     define variable v-full-tbl-name as character no-undo.
     2278     define variable v-where         as character no-undo.
     2279     define variable bh_tbl-name     as handle    no-undo.
     2280     define variable vTable          as character no-undo.
     2281     do
     2282     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2283     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2284     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2285         run gen-where-keyr-tab(i-tableSerach,
     2286                                i-tablekey,
     2287                                p-key-rec,
     2288                                p-key-handle,
     2289                                p-db-name,
     2290                                p-tt-handle,
     2291                                output v-where).
     2292         if i-tableSerach ne "" and i-tableSerach ne ?
     2293         then do:
     2294            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2295            create buffer bh_tbl-name for table v-full-tbl-name .
     2296         end.
     2297         else do:
     2298            if p-tt-handle = ? then do:
     2299               assign
     2300                  vTable = entry( 1 , p-key-rec, chr(3) )
     2301               .
     2302               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2303               create buffer bh_tbl-name for table v-full-tbl-name .
     2304            end.
     2305            else do:
     2306               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2307            end.
     2308         end.
     2309         if p-tt-handle = ? then do:
     2310            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2311         end.
     2312         else do:
     2313            bh_tbl-name:find-first( v-where ) no-error .
     2314         end.
     2315         o-hn = bh_tbl-name.
     2316      end.
     2317   end procedure.
     2318   procedure gen-hn-keyr :
     2319     define input  parameter p-key-rec    as character no-undo.
     2320     define input  parameter p-key-handle as handle    no-undo .
     2321     define input  parameter p-db-name    as character no-undo .
     2322     define input  parameter p-tt-handle  as handle    no-undo .
     2323     define input  parameter p-stts-lock  as integer   no-undo .
     2324     define output parameter o-hn         as handle    no-undo.
     2325     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2326   end.
     2327   procedure gen-row-keyr :
     2328     define input  parameter p-key-rec    as character no-undo.
     2329     define input  parameter p-key-handle as handle    no-undo .
     2330     define input  parameter p-db-name    as character no-undo .
     2331     define input  parameter p-tt-handle  as handle    no-undo .
     2332     define input  parameter p-stts-lock  as integer   no-undo .
     2333     define output parameter p-tbl-row    as rowid     no-undo.
     2334     define output parameter p-tbl-name   as character no-undo.
     2335     define variable vHn as handle no-undo.
     2336       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2337       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2338       p-tbl-name =  vHn:table.
     2339       delete object vHn no-error.
     2340     if p-tbl-row = ? then do:
     2341       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info10, p-tbl-name, p-key-rec ).
     2342     end.
     2343     else do:
     2344       return.
     2345     end.
     2346   end procedure.
     2347   procedure gen-key-fv :
     2348     define input  parameter p-key-rec    as character no-undo .
     2349     define output parameter p-field-list as character no-undo .
     2350     define output parameter p-value-list as character no-undo.
     2351     do
     2352     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2353     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2354     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2355     :
     2356       define variable v-full-tbl-name  as character no-undo .
     2357       define variable bh_tbl-name      as handle    no-undo .
     2358       define variable v-tbl-name       as character no-undo .
     2359       define variable v-field-num      as integer   no-undo .
     2360       define variable v-count-fld      as integer   no-undo .
     2361       define variable v-inform         as character no-undo .
     2362       define variable v-ind            as integer   no-undo .
     2363       define variable v-idx-field-qnty as integer   no-undo .
     2364       define variable v-delim-key      as character no-undo .
     2365       if p-key-rec = ?
     2366         or p-key-rec = "":U
     2367       then do:
     2368         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info10 ).
     2369       end.
     2370       assign
     2371         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2372         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2373       .
     2374       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2375       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info10 ).
     2376       assign
     2377         v-inform = bh_tbl-name:index-information(1)
     2378         v-ind    = 2
     2379       .
     2380       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2381       on error undo, return error
     2382       :
     2383         assign
     2384           v-inform = bh_tbl-name:index-information( v-ind )
     2385           v-ind    = v-ind + 1
     2386         .
     2387       end.
     2388       if v-inform = ?
     2389         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2390         or entry( 3, v-inform, ",":U ) <> "1":U
     2391       then do:
     2392         delete object bh_tbl-name no-error.
     2393         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, v-tbl-name ).
     2394       end.
     2395       assign
     2396         v-idx-field-qnty = num-entries( v-inform ) - 4
     2397       .
     2398       if v-idx-field-qnty < 2 then do:
     2399         delete object bh_tbl-name no-error.
     2400         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, v-tbl-name ).
     2401       end.
     2402       assign
     2403         p-field-list = "":U
     2404         p-value-list = "":U
     2405         v-delim-key  = "":U
     2406         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2407         v-count-fld  = 0
     2408       .
     2409       block_where:
     2410       do v-ind = 1 to v-idx-field-qnty by 2
     2411       on error undo, return error
     2412       :
     2413         assign
     2414           v-count-fld = v-count-fld + 1
     2415         .
     2416         if v-count-fld > v-field-num then do:
     2417           leave block_where.
     2418         end.
     2419         assign
     2420           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2421           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2422         .
     2423         if v-ind = 1 then do:
     2424           assign
     2425             v-delim-key = chr(3)
     2426           .
     2427         end.
     2428       end.
     2429       delete object bh_tbl-name.
     2430       if v-count-fld <> v-field-num then do:
     2431         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info10, v-tbl-name ).
     2432       end.
     2433     end.
     2434   end procedure.
     2435   procedure gen-key-field :
     2436     define input  parameter p-table      as character no-undo .
     2437     define output parameter p-field-list as character no-undo .
     2438     do
     2439     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2440     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2441     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2442     :
     2443       define variable v-full-tbl-name  as character no-undo .
     2444       define variable bh_tbl-name      as handle    no-undo .
     2445       define variable v-tbl-name       as character no-undo .
     2446       define variable v-field-num      as integer   no-undo .
     2447       define variable v-count-fld      as integer   no-undo .
     2448       define variable v-inform         as character no-undo .
     2449       define variable v-ind            as integer   no-undo .
     2450       define variable v-idx-field-qnty as integer   no-undo .
     2451       define variable v-delim-key      as character no-undo .
     2452       if p-table = ?
     2453         or p-table = "":U
     2454       then do:
     2455         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info10 ).
     2456       end.
     2457       assign
     2458         v-tbl-name      = p-table
     2459         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2460       .
     2461       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2462       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info10 ).
     2463       assign
     2464         v-inform = bh_tbl-name:index-information(1)
     2465         v-ind    = 2
     2466       .
     2467       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2468       on error undo, return error
     2469       :
     2470         assign
     2471           v-inform = bh_tbl-name:index-information( v-ind )
     2472           v-ind    = v-ind + 1
     2473         .
     2474       end.
     2475       if v-inform = ?
     2476         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2477         or entry( 3, v-inform, ",":U ) <> "1":U
     2478       then do:
     2479         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, v-tbl-name ).
     2480       end.
     2481       assign
     2482         v-idx-field-qnty = num-entries( v-inform ) - 4
     2483       .
     2484       if v-idx-field-qnty < 2 then do:
     2485         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, v-tbl-name ).
     2486       end.
     2487       assign
     2488         p-field-list = "":U
     2489         v-delim-key  = "":U
     2490         v-count-fld  = 0
     2491       .
     2492       block_where:
     2493       do v-ind = 1 to v-idx-field-qnty by 2
     2494       on error undo, return error
     2495       :
     2496         assign
     2497           v-count-fld = v-count-fld + 1
     2498         .
     2499         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2500         if v-ind = 1 then do:
     2501           assign
     2502             v-delim-key = chr(3)
     2503           .
     2504         end.
     2505       end.
     2506       delete object bh_tbl-name.
     2507     end.
     2508   end procedure.
     2509   function AddUtdErrForTab returns logical
     2510   (idb-num         as integer ,
     2511    idoc-id         as integer ,
     2512    iTab            as character,
     2513    iObj            as handle ,
     2514    iCheckType      as character,
     2515    iCodeErr        as character,
     2516    iCheckObj       as character ):
     2517      define buffer utd-err for utd-err.
     2518      define buffer utd for utd.
     2519      find first utd where utd.db-num     eq idb-num
     2520                       and utd.doc-id     eq idoc-id
     2521                       and utd.Direction  eq 'Outbound'
     2522      no-lock no-error.
     2523      if available utd
     2524      then
     2525         return no.
     2526      define variable vRecKey as character no-undo.
     2527            run gen-key-rec (input iTab,
     2528                             input  iObj,
     2529                             output vRecKey).
     2530      find first utd-err where utd-err.db-num     eq idb-num
     2531                           and utd-err.doc-id     eq idoc-id
     2532                           and utd-err.CheckType  eq iCheckType
     2533                           and utd-err.CodeErr    eq iCodeErr
     2534                           and utd-err.CheckObj   eq iCheckObj
     2535      exclusive-lock no-error.
     2536      if not available utd-err
     2537      then do:
     2538         create utd-err.
     2539         assign
     2540            utd-err.db-num         = idb-num
     2541            utd-err.doc-id         = idoc-id
     2542            utd-err.CheckType      = iCheckType
     2543            utd-err.CodeErr        = iCodeErr
     2544            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     2545            utd-err.reckey         = vRecKey
     2546            utd-err.qnty           = 1
     2547         .
     2548      end.
     2549      else
     2550         utd-err.qnty = utd-err.qnty + 1.
     2551      return utd-err.qnty eq 1.
     2552   end.
     2553   function AddUtdErr returns logical
     2554   (idb-num         as integer ,
     2555    idoc-id         as integer ,
     2556    iObj            as handle ,
     2557    iCheckType      as character,
     2558    iCodeErr        as character,
     2559    iCheckObj       as character ):
     2560      AddUtdErrForTab
     2561         (idb-num,
     2562          idoc-id,
     2563          iObj:table,
     2564          iObj,
     2565          iCheckType,
     2566          iCodeErr,
     2567          iCheckObj).
     2568   end.
     2569   function ClearUtdErrTypeCode returns logical
     2570   (idb-num         as integer,
     2571    idoc-id         as integer ,
     2572    iCheckType      as character,
     2573    iCodeErr        as character
     2574    ):
     2575      define buffer utd-err for utd-err.
     2576      if    iCheckType eq "*"
     2577         or iCheckType eq ?
     2578      then do:
     2579         if     iCodeErr ne ?
     2580            and iCodeErr ne "*"
     2581         then
     2582            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     2583            view-as alert-box.
     2584         else
     2585         for each utd-err where utd-err.db-num  eq idb-num
     2586                            and utd-err.doc-id  eq idoc-id
     2587         exclusive-lock:
     2588            delete utd-err.
     2589         end.
     2590      end.
     2591      else do:
     2592         if    iCodeErr eq ?
     2593            or iCodeErr eq "*"
     2594         then do:
     2595            for each utd-err where utd-err.db-num     eq idb-num
     2596                               and utd-err.doc-id     eq idoc-id
     2597                               and utd-err.CheckType  eq iCheckType
     2598            exclusive-lock:
     2599               delete utd-err.
     2600            end.
     2601         end.
     2602         else do:
     2603            for each utd-err where utd-err.db-num     eq idb-num
     2604                               and utd-err.doc-id     eq idoc-id
     2605                               and utd-err.CheckType  eq iCheckType
     2606                               and ub.utd-err.CodeErr eq iCodeErr
     2607            exclusive-lock:
     2608               delete utd-err.
     2609            end.
     2610         end.
     2611      end.
     2612   end.
     2613   function ClearUtdErr returns logical
     2614   (idb-num         as integer,
     2615    idoc-id         as integer ,
     2616    iCheckType      as character
     2617    ):
     2618      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     2619   end.
     2620   function GetMesError returns character
     2621   (itxt as character,
     2622    iobj as character ):
     2623    define variable vi as integer no-undo.
     2624    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     2625       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     2626    end.
     2627    return itxt.
     2628   end.
     2629   function GetTextErrorType returns character
     2630   (iCheckType as character,
     2631    iCodeErr   as character,
     2632    iChechObj  as character,
     2633    iType      as character  ):
     2634      define buffer code    for code.
     2635      define variable vError as character no-undo.
     2636      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2637                        and code.code   eq iCodeErr
     2638      no-lock no-error.
     2639      if available code
     2640      then do:
     2641         define variable vType as integer no-undo.
     2642         if code.misc3 eq "error"
     2643         then
     2644            vType = 0.
     2645         else if code.misc3 eq "warning"
     2646         then
     2647            vType = 1.
     2648         else if code.misc3 eq "Hiden"
     2649         then
     2650            vType = 2.
     2651         else
     2652            vtype = int(code.misc3) no-error.
     2653         case itype:
     2654            when "error"
     2655            then do:
     2656               if vtype eq 0
     2657               then
     2658                  vError = GetMesError(Code.CodeValue,iChechObj).
     2659            end.
     2660            when "warning"
     2661            then do:
     2662               if vtype <= 1
     2663               then
     2664                  vError = GetMesError(Code.CodeValue,iChechObj).
     2665            end.
     2666            otherwise do:
     2667               vError = GetMesError(Code.CodeValue,iChechObj).
     2668            end.
     2669         end.
     2670      end.
     2671      else
     2672         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     2673      return vError.
     2674   end.
     2675   function GetTypeError returns integer
     2676   (iCheckType as character,
     2677    iCodeErr   as character):
     2678      define buffer code    for code.
     2679      define variable vType as integer no-undo.
     2680      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2681                        and code.code   eq iCodeErr
     2682      no-lock no-error.
     2683      if     not available code
     2684         and code.misc3 eq "error"
     2685      then
     2686         vType = 0.
     2687      else if code.misc3 eq "warning"
     2688      then
     2689         vType = 1.
     2690      else if code.misc3 eq "Hiden"
     2691      then
     2692         vType = 2.
     2693      else
     2694         vtype = int(code.misc3) no-error.
     2695      return vtype.
     2696   end.
     2697   function GetTextError returns character
     2698   (iCheckType as character,
     2699    iCodeErr   as character,
     2700    iChechObj  as character ):
     2701      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     2702   end.
     2703   function GetErrForUtdStr returns character
     2704   (idb-num     as integer ,
     2705    idoc-id     as integer ,
     2706    iCheckType  as character
     2707    ):
     2708      define buffer utd-err for utd-err.
     2709      define buffer code    for code.
     2710      define variable vHQry as handle no-undo.
     2711      define variable vError as longchar no-undo.
     2712      define variable vErrorOne as longchar  no-undo.
     2713      define variable oError as character no-undo.
     2714      create query vHQry.
     2715      vHQry:set-buffers(buffer utd-err:handle).
     2716      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2717                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2718                               + if    iCheckType eq "*"
     2719                                    or iCheckType eq ?
     2720                                 then       ""
     2721                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2722      vHQry:query-open().
     2723      vHQry:get-first().
     2724      QRY-BLOCK:
     2725      repeat while not vHQry:query-off-end:
     2726         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2727         if     vErrorOne ne ""
     2728            and vErrorOne ne ?
     2729         then
     2730            vError = vError + ", " + vErrorOne.
     2731         vHQry:get-next().
     2732      end.
     2733      oError = substring(vError,3,4002).
     2734      return oError.
     2735   end.
     2736   function GetErrJsonForUtd returns character
     2737   (idb-num         as integer ,
     2738    idoc-id         as integer ,
     2739    iCheckType      as character
     2740    ):
     2741      define buffer utd-err for utd-err.
     2742      define variable vHQry as handle no-undo.
     2743      define variable vError as longchar no-undo.
     2744      define variable oError as character no-undo.
     2745      create query vHQry.
     2746      define variable vi as integer no-undo.
     2747      vHQry:set-buffers(buffer utd-err:handle).
     2748      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2749                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2750                               + if    iCheckType eq "*"
     2751                                    or iCheckType eq ?
     2752                                 then       ""
     2753                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2754      vHQry:query-open().
     2755      vHQry:get-first().
     2756      QRY-BLOCK:
     2757      repeat while not vHQry:query-off-end:
     2758         define variable vErrorOne as character no-undo.
     2759         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2760         if     vErrorOne ne ?
     2761            and vErrorOne ne ""
     2762         then do:
     2763            vi = vi + 1.
     2764            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2765                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     2766                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2767         end.
     2768         vHQry:get-next().
     2769      end.
     2770      for first utd where utd.db-num eq idb-num
     2771                      and utd.doc-id eq idoc-id
     2772                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     2773      no-lock,
     2774         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2775                                  and utd-marking-lines.doc-id eq idoc-id
     2776                                  and utd-marking-lines.doc-level eq 1
     2777      no-lock,
     2778         first marking where marking.mark eq utd-marking-lines.mark
     2779                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2780      no-lock:
     2781         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     2782         if     vErrorOne ne ?
     2783            and vErrorOne ne ""
     2784         then do:
     2785            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     2786                            + '","ОбъектОш":"' + marking.mark
     2787                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2788         end.
     2789      end.
     2790      if vError ne ""
     2791      then
     2792         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     2793      return oError.
     2794   end.
     2795   function GetErrJsonForUtdReturn returns character
     2796   (idb-num         as integer ,
     2797    idoc-id         as integer ,
     2798    iCheckType      as character
     2799    ):
     2800      define buffer utd-err for utd-err.
     2801      define variable vHQry as handle no-undo.
     2802      define variable vError as longchar no-undo.
     2803      define variable oError as character no-undo.
     2804      define variable vi as integer no-undo.
     2805      create query vHQry.
     2806      vHQry:set-buffers(buffer utd-err:handle).
     2807      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2808                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2809                               + if    iCheckType eq "*"
     2810                                    or iCheckType eq ?
     2811                                 then       ""
     2812                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2813      vHQry:query-open().
     2814      vHQry:get-first().
     2815      QRY-BLOCK:
     2816      repeat while not vHQry:query-off-end:
     2817         define variable vErrorOne as character no-undo.
     2818         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2819         if     vErrorOne ne ?
     2820            and vErrorOne ne ""
     2821         then do:
     2822            vi = vi + 1.
     2823            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2824                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     2825                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     2826         end.
     2827         vHQry:get-next().
     2828      end.
     2829      if vError ne ""
     2830      then
     2831         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     2832      return oError.
     2833   end.
     2834   function GetCodeTextError returns character
     2835   (iCheckType as character,
     2836    iCodeErr   as character,
     2837    iChechObj  as character,
     2838    output oCode as character,
     2839    output ovalue as character ):
     2840      define buffer code    for code.
     2841      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2842                        and code.code   eq iCodeErr
     2843      no-lock no-error.
     2844      if     available code
     2845      then do:
     2846         define variable vi as integer no-undo init ?.
     2847         vi = int(Code.misc3) no-error.
     2848         if    code.misc3 ne "error"
     2849            and vi ne 0
     2850         then
     2851            oCode = ?.
     2852         else if     Code.misc1 ne ?
     2853                 and Code.misc1 ne ""
     2854         then
     2855            assign
     2856               oCode  = GetMesError(Code.misc1,iChechObj)
     2857               ovalue = GetMesError(Code.misc2,iChechObj)
     2858            .
     2859      end.
     2860      return if oCode eq ""
     2861             then ""
     2862             else (oCode + "_" + ovalue).
     2863   end.
     2864   define temp-table TT-err no-undo
     2865     field code_ as character
     2866     field text_ as character
     2867   index code_ code_.
     2868   function GetErrTxtForUtd returns character
     2869   (idb-num         as integer ,
     2870    idoc-id         as integer ,
     2871    iCheckType      as character
     2872    ):
     2873      define buffer utd-err for utd-err.
     2874      define variable vHQry as handle no-undo.
     2875      define variable oError as character no-undo.
     2876      create query vHQry.
     2877      define variable vi as integer no-undo.
     2878      for each tt-err :
     2879         delete tt-err.
     2880      end.
     2881      vHQry:set-buffers(buffer utd-err:handle).
     2882      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2883                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2884                               + if    iCheckType eq "*"
     2885                                    or iCheckType eq ?
     2886                                 then       ""
     2887                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2888      vHQry:query-open().
     2889      vHQry:get-first().
     2890      define variable vcode as character no-undo.
     2891      define variable vvalue as character no-undo.
     2892      QRY-BLOCK:
     2893      repeat while not vHQry:query-off-end:
     2894         vi = vi + 1.
     2895         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     2896         if vcode ne ?
     2897         then do:
     2898            find first tt-err where tt-err.code eq vcode
     2899            no-error.
     2900            if not available tt-err
     2901            then do:
     2902               create tt-err.
     2903               assign
     2904                  tt-err.code_ = vcode
     2905                  tt-err.text_ = vvalue
     2906               .
     2907            end.
     2908            else
     2909               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2910         end.
     2911         vHQry:get-next().
     2912      end.
     2913     find first utd where utd.db-num eq idb-num
     2914                         and utd.doc-id eq idoc-id
     2915         no-lock.
     2916      define buffer cancel_utd-lines for utd-lines.
     2917      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     2918                                  and cancel_utd-lines.doc-id eq idoc-id
     2919      no-lock:
     2920         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     2921         then do:
     2922            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2923                                        and utd-marking-lines.doc-id eq idoc-id
     2924                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     2925            no-lock,
     2926               first marking where marking.mark eq utd-marking-lines.mark
     2927                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2928            no-lock:
     2929               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     2930               find first tt-err where tt-err.code eq vcode
     2931               no-error.
     2932               if not available tt-err
     2933               then do:
     2934                  create tt-err.
     2935                  assign
     2936                     tt-err.code_ = vcode
     2937                     tt-err.text_ = vvalue
     2938                  .
     2939               end.
     2940               else
     2941                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2942            end.
     2943         end.
     2944         else do:
     2945            define variable vqnty as decimal no-undo.
     2946            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     2947            if vqnty eq ? then vqnty = 0.
     2948            if vqnty ne cancel_utd-lines.Quantity
     2949            then do:
     2950               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     2951               find first tt-err where tt-err.code eq vcode
     2952               no-error.
     2953               if not available tt-err
     2954               then do:
     2955                  create tt-err.
     2956                  assign
     2957                     tt-err.code_ = vcode
     2958                     tt-err.text_ = vvalue
     2959                  .
     2960               end.
     2961               else
     2962                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2963            end.
     2964         end.
     2965      end.
     2966      for each tt-err:
     2967         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     2968      end.
     2969      return oError.
     2970   end.
     2971   define variable mFormatErr as character no-undo init "text".
     2972   function GetErrForUtd returns character
     2973   (idb-num         as integer ,
     2974    idoc-id         as integer ,
     2975    iType           as character
     2976    ):
     2977      if mFormatErr eq "text"
     2978      then
     2979         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     2980      else do:
     2981         if itype eq "return"
     2982         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     2983         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     2984      end.
     2985   end.
     2986   function GetErrComText returns longchar
     2987   (icomment as character,
     2988    itext    as longchar ):
     2989       define variable vText as longchar no-undo.
     2990      if mFormatErr eq "text"
     2991      then do:
     2992         if icomment ne ""
     2993         then
     2994            icomment = substitute("comment:|&1|",icomment).
     2995         vText = icomment + itext.
     2996      end.
     2997      else do:
     2998         icomment = if icomment begins  '"'
     2999                    then icomment
     3000                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     3001         vText = icomment + "," + itext.
     3002         vText = "~{" + trim(vText,",") + "~}".
     3003      end.
     3004      return vText.
     3005   end.
     3006   function CheckTypeForMarkLineType returns logical
     3007   (iObj            as handle,
     3008    iCheckType      as character,
     3009    iCodeErr        as character ,
     3010    iTypeErr        as character ):
     3011      define variable vRecKey-markLine as character no-undo.
     3012      define variable vGoodMark        as logical no-undo.
     3013      define variable vdb-num          as integer no-undo.
     3014      define variable vdoc-id          as integer no-undo.
     3015      define variable vlinenum         as integer no-undo.
     3016      define variable vErrorOne as character no-undo.
     3017      define buffer buf_utd-err for utd-err.
     3018      run gen-key-rec (input "utd-marking-lines",
     3019                       input  iObj,
     3020                       output vRecKey-markLine).
     3021      vGoodMark = yes.
     3022      vdb-num = iObj::db-num.
     3023      vdoc-id = iObj::doc-id.
     3024      vlinenum = iObj::linenum.
     3025      block-mark-err:
     3026      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3027                               and buf_utd-err.db-num = vdb-num
     3028                               and buf_utd-err.reckey = vRecKey-markLine
     3029                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3030                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3031      no-lock:
     3032         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3033         if     vErrorOne ne ?
     3034            and vErrorOne ne ""
     3035         then do:
     3036            vGoodMark = no.
     3037            leave block-mark-err.
     3038         end.
     3039      end.
     3040      return not vGoodMark.
     3041   end.
     3042   function CheckErrForMarkLineType returns logical
     3043   (iObj            as handle,
     3044    iType           as character  ):
     3045      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     3046   end.
     3047   function CheckErrForMarkLine returns logical
     3048   (iObj            as handle):
     3049      return CheckErrForMarkLineType(iObj,"*").
     3050   end.
     3051   function CheckErrForLineTypeCode returns logical
     3052   (iObj                 as handle,
     3053    iCheckType           as character,
     3054    iCodeErr             as character,
     3055    iTypeErr             as character,
     3056    iOneErr              as logical):
     3057      define variable vRecKey-line     as character no-undo.
     3058      define buffer buf_utd-err for utd-err.
     3059      define variable vUtdlineError as logical no-undo.
     3060      define variable vErrorOne as character no-undo.
     3061            run gen-key-rec (input "utd-lines",
     3062                             input  iObj,
     3063                             output vRecKey-line).
     3064         define variable vdb-num as integer no-undo.
     3065         define variable vdoc-id as integer no-undo.
     3066         define variable vlinenum as integer no-undo.
     3067         vdb-num = iObj::db-num.
     3068         vdoc-id = iObj::doc-id.
     3069         vlinenum = iObj::linenum.
     3070         block-err:
     3071         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3072                                  and buf_utd-err.db-num = vdb-num
     3073                                  and buf_utd-err.reckey = vRecKey-line
     3074                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     3075                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     3076         no-lock:
     3077            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     3078            if     vErrorOne ne ?
     3079               and vErrorOne ne ""
     3080            then do:
     3081               vUtdlineError = yes.
     3082               leave block-err.
     3083            end.
     3084         end.
     3085         if  not vUtdlineError
     3086         then do:
     3087            define variable vGoodMark as logical no-undo.
     3088            vGoodMark = yes.
     3089            block-line-err:
     3090            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     3091                                         and utd-marking-lines.doc-id  eq vdoc-id
     3092                                         and utd-marking-lines.LineNum eq vLineNum
     3093            no-lock:
     3094               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     3095               if     vGoodMark
     3096                  and iOneErr eq no
     3097               then
     3098                  leave block-line-err.
     3099               if     iOneErr = yes
     3100                  and not vGoodMark
     3101               then
     3102                  leave block-line-err.
     3103            end.
     3104            vUtdlineError = not vGoodMark.
     3105         end.
     3106      return vUtdlineError.
     3107   end.
     3108   function getErrForLineType returns character
     3109   (iObj            as handle,
     3110    iType           as character  ):
     3111      define variable vRecKey-line     as character no-undo.
     3112      define buffer buf_utd-err for utd-err.
     3113      define variable vUtdlineError as logical no-undo.
     3114      define variable vErrorOne as character no-undo.
     3115      define variable oError as character no-undo.
     3116            run gen-key-rec (input "utd-lines",
     3117                             input  iObj,
     3118                             output vRecKey-line).
     3119         define variable vdb-num as integer no-undo.
     3120         define variable vdoc-id as integer no-undo.
     3121         define variable vlinenum as integer no-undo.
     3122         vdb-num = iObj::db-num.
     3123         vdoc-id = iObj::doc-id.
     3124         vlinenum = iObj::linenum.
     3125         block-err:
     3126         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     3127                                  and buf_utd-err.db-num = vdb-num
     3128                                  and buf_utd-err.reckey = vRecKey-line
     3129                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     3130         no-lock:
     3131            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     3132            if     vErrorOne ne ?
     3133               and vErrorOne ne ""
     3134            then do:
     3135               oError = oError + vErrorOne + " ".
     3136            end.
     3137         end.
     3138      return oError.
     3139   end.
     3140   function CheckErrForLineType returns logical
     3141   (iObj            as handle,
     3142    iType           as character  ):
     3143       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     3144   end.
     3145   function CheckErrForLine returns logical
     3146   (iObj            as handle):
     3147      return CheckErrForLineType(iobj,"*").
     3148   end.
     3149   function CheckErrForUtd returns logical
     3150   (idb-num         as integer ,
     3151    idoc-id         as integer ):
     3152      for each utd-lines where utd-lines.db-num eq idb-num
     3153                           and utd-lines.doc-id eq idoc-id
     3154      no-lock :
     3155         if not CheckErrForLine (buffer ub.utd-lines:handle)
     3156         then
     3157            return no.
     3158      end.
     3159      return yes.
     3160   end.
     3161   function CheckMarkUtd-28rel return logical
     3162    (input idb-num as integer,
     3163    input idoc-id as integer):
     3164    define buffer utd                   for utd.
     3165    define buffer utd-lines             for utd-lines.
     3166    define buffer utd-marking-lines     for utd-marking-lines.
     3167    define variable v-par-type as character no-undo.
     3168    define variable vgdsNoMark as logical no-undo.
     3169    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3170      define variable v-par-val  as character no-undo.
     3171      find first utd where utd.db-num eq idb-num
     3172                       and utd.doc-id eq idoc-id
     3173      no-lock no-error.
     3174      if available utd
     3175      then do:
     3176         if     utd.obj-code ne ?
     3177            and utd.obj-type ne ?
     3178         then do:
     3179            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     3180            Block-utd-lines:
     3181            for each utd-lines where utd-lines.db-num eq idb-num
     3182                                 and utd-lines.doc-id eq idoc-id
     3183            no-lock:
     3184               if     utd-lines.gds-code ne ?
     3185                  and utd-lines.gds-code ne 0
     3186               then do:
     3187                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3188                       ( utd-lines.gds-code,
     3189                         'mark-type':U,
     3190                          output v-par-val,
     3191                          output v-par-type
     3192                       ).
     3193                  if     EDOParSec:IsEdo
     3194                     and EDOParSec:GetIsEDOForType(v-par-val)
     3195                  then do:
     3196                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     3197                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     3198                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     3199                                                    and length(utd-marking-lines.mark) > 13
     3200                     no-lock no-error.
     3201                     if     avail utd-marking-lines
     3202                        and not CheckErrForLine(buffer utd-lines:handle)
     3203                     then
     3204                        leave Block-utd-lines.
     3205                  end.
     3206                  else
     3207                     vgdsNoMark = yes.
     3208               end.
     3209            end.
     3210            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     3211            if vgdsNoMark then return available utd-lines . else return yes .
     3212         end.
     3213      end.
     3214      return yes.
     3215   end.
     3216     SECURITY-POLICY:SYMMETRIC-ENCRYPTION-KEY = GENERATE-PBE-KEY("sysadm").
     3217     do v-ind = 1 to v-num-entries-db-list
     3218     on error undo, return error
     3219     :
     3220       assign
     3221         v-db-num = integer( entry( v-ind, p-list-db ) )
     3222       .
     3223       find first buf_db no-lock where buf_db.db-num = v-db-num .
     3224       if buf_db.stts = 2
     3225       then do :
     3226         run write-to-log( "БД " + string(v-db-num) + " выгружается. Пропускаем." ).
     3227         next .
     3228       end.
     3229       run write-to-log( "Работа с БД " + string(v-db-num) ) .
     3230       clients_ :
     3231       for each clients no-lock where clients.obj-type = 'маг':U
     3232                                  and clients.db-num = v-db-num
     3233                                  and clients.stts = 0
     3234                                  break by clients.host-code :
     3235           run write-to-log( "... Объект " + clients.obj-type + string(clients.obj-code) + "  " + clients.obj-name ) .
     3236           for each buf_ext-system-attr no-lock where buf_ext-system-attr.esya-attr-code   = 'obj':U
     3237                                                  and buf_ext-system-attr.esya-attr-value  = clients.obj-type + string(clients.obj-code)
     3238                                                  :
     3239             find first buf_ext-system no-lock where buf_ext-system.esys-type = integer('11':U)
     3240                                                 and buf_ext-system.esys-id   = buf_ext-system-attr.esys-id
     3241                                                 no-error .
     3242             if available buf_ext-system then leave .
     3243           end .
     3244           if not available buf_ext-system
     3245           then
     3246           for each buf_ext-system-attr no-lock where buf_ext-system-attr.esya-attr-code   = 'host-code':U
     3247                                                  and buf_ext-system-attr.esya-attr-value  = string(clients.host-code)
     3248                                                  :
     3249             find first buf_ext-system no-lock where buf_ext-system.esys-type = integer('11':U)
     3250                                                 and buf_ext-system.esys-id   = buf_ext-system-attr.esys-id
     3251                                                 no-error .
     3252             if available buf_ext-system then leave .
     3253           end .
     3254           if not available buf_ext-system
     3255           then do :
     3256             run write-to-log( "Нет внешней системы с типом ИС МОТП, привязанной к фирме Орг" + string(clients.host-code) ) .
     3257             next clients_ .
     3258           end.
     3259           assign
     3260             g#esys-source-esys = buf_ext-system.esys-id
     3261           .
     3262           assign
     3263             vToken = ""
     3264             vNewToken = ""
     3265           .
     3266           find first buf_ext-system-attr no-lock where buf_ext-system-attr.db-num   = buf_ext-system.db-num
     3267                                                    and buf_ext-system-attr.esys-id  = buf_ext-system.esys-id
     3268                                                    and buf_ext-system-attr.esya-attr-code = 'AuthToken':U
     3269                                                    no-error .
     3270           if available buf_ext-system-attr
     3271           then do :
     3272             assign vToken = trim(buf_ext-system-attr.esya-attr-value) .
     3273           end .
     3274           oMotp = new is_motp(buf_ext-system.db-num, buf_ext-system.esys-id, v-db-num) .
     3275           oMotp:isDebug = p-debug .
     3276           if vToken > ""
     3277           then do :
     3278             if oMotp:needTokenUpd()
     3279             then do :
     3280               run write-to-log( "Со времени получения токена прошло более 6 часов. Пробуем обновить токен..." ) .
     3281               vNewToken = oMotp:updateToken(vToken) .
     3282               if oMotp:HttpStatus = 502
     3283               then do :
     3284                 run write-to-log( oMotp:Msg ) .
     3285               end .
     3286               if oMotp:StatusErr
     3287               then do :
     3288                 run write-to-log( oMotp:Msg ) .
     3289               end .
     3290               else do :
     3291                 vToken = vNewToken .
     3292                 run write-to-log( "Токен успешно обновлён" ) .
     3293               end .
     3294             end .
     3295             if not oMotp:authTest(vToken)
     3296             then do :
     3297               run write-to-log( oMotp:Msg ) .
     3298               if not oMotp:Msg begins "Нет ответа от ИС МОТП"
     3299               then do transaction :
     3300                 find first buf_ext-system-attr no-lock where buf_ext-system-attr.db-num   = buf_ext-system.db-num
     3301                                                          and buf_ext-system-attr.esys-id  = buf_ext-system.esys-id
     3302                                                          and buf_ext-system-attr.esya-attr-code = 'AuthToken-send':U
     3303                                                          no-error .
     3304                 if available buf_ext-system-attr
     3305                 then do :
     3306                   if buf_ext-system-attr.esya-attr-value = ?
     3307                   or buf_ext-system-attr.esya-attr-value = ""
     3308                   or buf_ext-system-attr.esya-attr-value <> vToken
     3309                   then do :
     3310                     oMotp:sendEMail(substitute("В БД &1 фирме орг&2 токен для авторизации в ИС МОТП просрочен", string(v-db-num), string(clients.host-code))) .
     3311                   end .
     3312                   find current buf_ext-system-attr exclusive-lock .
     3313                   assign buf_ext-system-attr.esya-attr-value = vToken .
     3314                 end .
     3315                 assign vToken = "" .
     3316                 find first buf_ext-system-attr exclusive-lock where buf_ext-system-attr.db-num   = buf_ext-system.db-num
     3317                                                                 and buf_ext-system-attr.esys-id  = buf_ext-system.esys-id
     3318                                                                 and buf_ext-system-attr.esya-attr-code = 'AuthTokenDT':U
     3319                                                                 no-error .
     3320                 if available buf_ext-system-attr
     3321                 then do :
     3322                   assign buf_ext-system-attr.esya-attr-value = "" .
     3323                 end .
     3324               end .
     3325             end .
     3326             else do :
     3327               if oMotp:HttpStatus = 502
     3328               then do :
     3329                 run write-to-log( oMotp:Msg ) .
     3330               end .
     3331             end .
     3332           end .
     3333           else do transaction :
     3334             run write-to-log( "Отсутствует токен для авторизации в ИС МОТП." ) .
     3335             find first buf_ext-system-attr no-lock where buf_ext-system-attr.db-num   = buf_ext-system.db-num
     3336                                                      and buf_ext-system-attr.esys-id  = buf_ext-system.esys-id
     3337                                                      and buf_ext-system-attr.esya-attr-code = 'AuthToken-send':U
     3338                                                      no-error .
     3339             if available buf_ext-system-attr
     3340             then do :
     3341               if buf_ext-system-attr.esya-attr-value = ?
     3342               or buf_ext-system-attr.esya-attr-value = ""
     3343               or buf_ext-system-attr.esya-attr-value <> "empty"
     3344               then do :
     3345                 oMotp:sendEMail(substitute("В БД &1 фирме орг&2 отсутствует токен для авторизации в ИС МОТП", string(v-db-num), string(clients.host-code))) .
     3346               end .
     3347               find current buf_ext-system-attr exclusive-lock .
     3348               assign buf_ext-system-attr.esya-attr-value = "empty" .
     3349             end .
     3350             find first buf_ext-system-attr exclusive-lock where buf_ext-system-attr.db-num   = buf_ext-system.db-num
     3351                                                             and buf_ext-system-attr.esys-id  = buf_ext-system.esys-id
     3352                                                             and buf_ext-system-attr.esya-attr-code = 'AuthTokenDT':U
     3353                                                             no-error .
     3354             if available buf_ext-system-attr
     3355             then do :
     3356               assign buf_ext-system-attr.esya-attr-value = "" .
     3357             end .
     3358           end .
     3359         if vToken > ""
     3360         then do :
     3361           utd_ :
     3362           for each buf_utd no-lock where buf_utd.obj-type = clients.obj-type
     3363                                      and buf_utd.obj-code = clients.obj-code
     3364                                      and (buf_utd.EDocType = objSrv:Env:Utd:EDocType:UTD:KeyIntDB or buf_utd.EDocType = objSrv:Env:Utd:EDocType:EDoc:KeyIntDB)
     3365                                      and buf_utd.sts = objSrv:Env:Utd:Sts:TH:ReceivedFromSupplier:KeyIntDB
     3366                                      and buf_utd.sts-edi <> objSrv:Env:Utd:Sts:EDI:RevocationIsRequestedByMe:KeyIntDB :
     3367             do transaction :
     3368               find first locked_utd exclusive-lock where rowid(locked_utd) = rowid(buf_utd) no-wait no-error .
     3369               if not available locked_utd
     3370               then do :
     3371                 next utd_ .
     3372               end .
     3373               run write-to-log( "Запрос информации по маркам. УПД " + string(buf_utd.DocumentNumber) ) .
     3374               v-found = false .
     3375               for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = buf_utd.db-num
     3376                                                  and buf_utd-marking-lines.doc-id = buf_utd.doc-id,
     3377               first buf_marking no-lock where buf_marking.mark = buf_utd-marking-lines.mark
     3378                                           and buf_marking.unit-ext = "LEVEL2" :
     3379                 v-found = true .
     3380                 leave .
     3381               end .
     3382               if v-found
     3383               then do :
     3384                 oMotp:cisesInfo(vToken, buf_utd.db-num, buf_utd.doc-id, true, output v-ok) .
     3385                 if not v-ok
     3386                 then do :
     3387                   run write-to-log( oMotp:Msg ) .
     3388                   next utd_ .
     3389                 end .
     3390               end .
     3391               oMotp:lastLineCisInfo = 0 .
     3392               oMotp:cisesInfo(vToken, buf_utd.db-num, buf_utd.doc-id, false, output v-ok) .
     3393               if not v-ok
     3394               then do :
     3395                 run write-to-log( oMotp:Msg ) .
     3396                 next utd_ .
     3397               end .
     3398               do while oMotp:lastLineCisInfo <> 0 :
     3399                 oMotp:cisesInfo(vToken, buf_utd.db-num, buf_utd.doc-id, false, output v-ok) .
     3400                 if not v-ok
     3401                 then do :
     3402                   run write-to-log( oMotp:Msg ) .
     3403                   next utd_ .
     3404                 end .
     3405               end .
     3406               if oMotp:foundLevel2
     3407               then do :
     3408                 oMotp:lastLineCisInfo = 0 .
     3409                 oMotp:cisesInfo(vToken, buf_utd.db-num, buf_utd.doc-id, false, output v-ok) .
     3410                 if not v-ok
     3411                 then do :
     3412                   run write-to-log( oMotp:Msg ) .
     3413                   next utd_ .
     3414                 end .
     3415                 do while oMotp:lastLineCisInfo <> 0 :
     3416                   oMotp:cisesInfo(vToken, buf_utd.db-num, buf_utd.doc-id, false, output v-ok) .
     3417                   if not v-ok
     3418                   then do :
     3419                     run write-to-log( oMotp:Msg ) .
     3420                     next utd_ .
     3421                   end .
     3422                 end .
     3423               end .
     3424               if oMotp:needCheckUnit
     3425               then do :
     3426                 oMotp:cisesInfo(vToken, buf_utd.db-num, buf_utd.doc-id, false, output v-ok) .
     3427                 if not v-ok
     3428                 then do :
     3429                   run write-to-log( oMotp:Msg ) .
     3430                   next utd_ .
     3431                 end .
     3432               end .
     3433               v-found = false .
     3434               lines_ :
     3435               for each buf_utd-lines no-lock where buf_utd-lines.db-num = buf_utd.db-num
     3436                                                and buf_utd-lines.doc-id = buf_utd.doc-id:
     3437                 if CheckErrForLineType(buffer buf_utd-lines:handle, "LoadUtd")
     3438                 then next lines_ .
     3439                 for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = buf_utd-lines.db-num
     3440                                                          and buf_utd-marking-lines.doc-id = buf_utd-lines.doc-id
     3441                                                          and buf_utd-marking-lines.LineNum = buf_utd-lines.LineNum:
     3442                   if not isMark(buf_utd-marking-lines.mark)
     3443                   then do:
     3444                     v-found = true .
     3445                     leave lines_.
     3446                   end.
     3447                   find first buf_marking no-lock where buf_marking.mark = buf_utd-marking-lines.mark
     3448                                                    and buf_marking.sts <> objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB
     3449                   no-error.
     3450                   if available buf_marking
     3451                   then do:
     3452                     v-found = true .
     3453                     leave lines_.
     3454                   end.
     3455                 end .
     3456               end .
     3457               if not v-found
     3458               then do :
     3459                 locked_utd.sts = objSrv:Env:Utd:Sts:TH:LackOfMarkingCodesInCirculation:KeyIntDB .
     3460               end .
     3461               else do :
     3462                 locked_utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB .
     3463               end .
     3464               release locked_utd no-error .
     3465             end .
     3466           end .
     3467         end.
     3468         for each buf_utd no-lock where buf_utd.obj-type = clients.obj-type
     3469                                    and buf_utd.obj-code = clients.obj-code
     3470                                    and (buf_utd.EDocType = objSrv:Env:Utd:EDocType:UTD:KeyIntDB or buf_utd.EDocType = objSrv:Env:Utd:EDocType:EDoc:KeyIntDB)
     3471                                    and buf_utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB :
     3472           do transaction :
     3473             find first locked_utd exclusive-lock where rowid(locked_utd) = rowid(buf_utd) no-wait no-error .
     3474             if not available locked_utd
     3475             then do :
     3476               next .
     3477             end .
     3478             run write-to-log( "Проверка по спецификации. УПД " + string(buf_utd.DocumentNumber) ) .
     3479             oMotp:CheckSpec(buf_utd.db-num, buf_utd.doc-id) .
     3480             release locked_utd no-error .
     3481           end .
     3482         end .
     3483         if vToken > ""
     3484         then do :
     3485           for each buf_utd no-lock where buf_utd.obj-type = clients.obj-type
     3486                                      and buf_utd.obj-code = clients.obj-code
     3487                                      and (buf_utd.EDocType = objSrv:Env:Utd:EDocType:UTD:KeyIntDB or buf_utd.EDocType = objSrv:Env:Utd:EDocType:EDoc:KeyIntDB)
     3488                                      and buf_utd.sts = objSrv:Env:Utd:Sts:TH:AwaitingConfirmation:KeyIntDB :
     3489             do transaction :
     3490               find first locked_utd exclusive-lock where rowid(locked_utd) = rowid(buf_utd) no-wait no-error .
     3491               if not available locked_utd
     3492               then do :
     3493                 next .
     3494               end .
     3495               run write-to-log( "Проверка документа в ИС МОТП. УПД " + string(buf_utd.DocumentNumber) ) .
     3496               oMotp:checkINN = true .
     3497               oMotp:cisesInfo(vToken, buf_utd.db-num, buf_utd.doc-id, false, output v-ok) .
     3498               oMotp:checkINN = false .
     3499               release locked_utd no-error .
     3500             end .
     3501             if not v-ok
     3502             then do :
     3503               run write-to-log( oMotp:Msg ) .
     3504               next .
     3505             end .
     3506           end .
     3507           for each buf_utd no-lock where buf_utd.obj-type = clients.obj-type
     3508                                      and buf_utd.obj-code = clients.obj-code
     3509                                      and buf_utd.EDocType = objSrv:Env:Utd:EDocType:Introduce:KeyIntDB
     3510                                      and buf_utd.sts = objSrv:Env:Utd:Sts:TH:AwaitingConfirmation:KeyIntDB :
     3511             do transaction :
     3512               find first locked_utd exclusive-lock where rowid(locked_utd) = rowid(buf_utd) no-wait no-error .
     3513               if not available locked_utd
     3514               then do :
     3515                 next .
     3516               end .
     3517               run write-to-log( "Запрос информации по маркам. Первоначальный ввод " + string(buf_utd.DocumentNumber) ) .
     3518               oMotp:isFirstEnter = true .
     3519               oMotp:cisesInfo(vToken, buf_utd.db-num, buf_utd.doc-id, false, output v-ok) .
     3520               oMotp:isFirstEnter = false .
     3521               if not v-ok
     3522               then do :
     3523                 run write-to-log( oMotp:Msg ) .
     3524                 next .
     3525               end .
     3526               for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = buf_utd.db-num
     3527                                                        and buf_utd-marking-lines.doc-id = buf_utd.doc-id,
     3528               first buf_marking no-lock where buf_marking.mark = buf_utd-marking-lines.mark
     3529                                           and buf_marking.sts = objSrv:Env:Marking:Sts:Mark:PendingVerification:KeyIntDB :
     3530                 v-ok = false .
     3531                 leave .
     3532               end .
     3533               if not v-ok
     3534               then do :
     3535                 run write-to-log( "Не получена полная информация по КМ") .
     3536                 next .
     3537               end .
     3538               locked_utd.sts = objSrv:Env:Utd:Sts:TH:Confirmed:KeyIntDB .
     3539               release locked_utd no-error .
     3540             end .
     3541           end .
     3542           for each buf_utd no-lock where buf_utd.obj-type = clients.obj-type
     3543                                      and buf_utd.obj-code = clients.obj-code
     3544                                      and buf_utd.EDocType = objSrv:Env:Utd:EDocType:LK_RECEIPT:KeyIntDB
     3545                                      and buf_utd.sts = objSrv:Env:Utd:Sts:TH:LK_RECEIPT_Signed:KeyIntDB :
     3546             do transaction :
     3547               run write-to-log( "Отправка в ГИС МТ документа Вывода из оборота (ОСУ) " + buf_utd.DocumentNumber ) .
     3548               vUUID = oMotp:SendDoc_LK_RECEIPT(vToken, buf_utd.db-num, buf_utd.doc-id, ?, ?) .
     3549               if vUUID = ?
     3550               then do :
     3551                 run write-to-log( oMotp:Msg ) .
     3552               end .
     3553             end .
     3554           end .
     3555           for each buf_utd no-lock where buf_utd.obj-type = clients.obj-type
     3556                                      and buf_utd.obj-code = clients.obj-code
     3557                                      and buf_utd.EDocType = objSrv:Env:Utd:EDocType:LK_RECEIPT:KeyIntDB
     3558                                      and buf_utd.sts = objSrv:Env:Utd:Sts:TH:LK_RECEIPT_Sent:KeyIntDB :
     3559             do transaction :
     3560               run write-to-log( "Получение информации из ГИС МТ по документу Вывода из оборота (ОСУ) " + buf_utd.DocumentNumber ) .
     3561               oMotp:checkUtd(vToken, buf_utd.db-num, buf_utd.doc-id) .
     3562             end .
     3563           end .
     3564         end .
     3565         delete object oMotp no-error .
     3566       end .
     3567       run write-to-log( "Закончена работа с БД " + string(v-db-num) ) .
     3568       pause 0.2 .
     3569     end.
     3570   end.
