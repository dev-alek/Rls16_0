        9   using ibs.th.str.utd.sts.*.
       10   using ibs.th.bge.is_motp.*.
       11   define input  parameter p-user-login    as character no-undo .
       12   define input  parameter p-user-password as character no-undo .
       13   define input  parameter p-list-db       as character no-undo .
       14   define input  parameter p-debug         as logical   no-undo .
       15   def var vss-revision    as character no-undo init "$Revision: 1eba0946c2d7, 3078, rls $":U .
       16   def var vss-author      as character no-undo init "$Author: DRuban $":U .
       17   def var vss-date        as character no-undo init "$Date: Пт авг 05 19:16:25 2022 +0300 $":U .
       18   def var vss-workfile    as character no-undo init "$Workfile: auto-motp.p $":U .
       19   def var vss-archive     as character no-undo init "$Archive: bge/auto-motp.p $":U .
       20   def var vss-description as character no-undo init "Работа с ФГИС меркурий".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   define   shared variable g#auto as logical no-undo.
       82   define   shared variable g#news as logical no-undo.
       83   define   shared variable g#oxml as logical no-undo.
       84   define   shared variable g#esys as logical no-undo.
       85   define   shared variable g#news-source-db as integer no-undo.
       86   define   shared variable g#esys-source-esys as integer no-undo.
       87   define   shared variable g#db-num as integer   no-undo .
       88   define   shared variable g#userid as character no-undo .
       89   define   shared variable g#passwd as character no-undo .
       90   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   define  shared variable g#auto-pid           as integer   no-undo .
       92   define  shared variable conn-par             as character no-undo .
       93   define  shared variable g#auto-user-id       as character no-undo .
       94   define  shared variable g#auto-user-login    as character no-undo .
       95   define  shared variable g#auto-user-password as character no-undo .
       96   define  shared variable v-socket             as logical   no-undo .
       97   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   define  shared variable auto-window-h     as handle    no-undo .
       99   define  shared variable auto-log-msg-h    as handle    no-undo .
      100   define  shared variable hand-log-msg-h    as handle    no-undo .
      101   define  shared variable log-file-name     as character no-undo initial ? .
      102   define  shared variable add-log-file-name as character no-undo initial ? .
      103   define  shared variable writelogvalue     as character no-undo initial ? .
      104   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      105   procedure cur-time :
      106      define output parameter p-today as date      no-undo .
      107      define output parameter p-time  as integer   no-undo .
      108     do
      109     on error undo, return error
      110     :
      111       define variable v-date1 as date      no-undo .
      112       define variable v-date2 as date      no-undo .
      113       define variable v-time  as integer   no-undo .
      114       assign
      115         v-date1 = today
      116         v-time  = time
      117         v-date2 = today
      118       .
      119       if v-date1 <> v-date2
      120       then do:
      121         assign
      122           v-date1 = today
      123           v-time  = v-time
      124         .
      125       end.
      126       assign
      127         p-today = v-date1
      128         p-time  = v-time
      129       .
      130     end.
      131   end.
      132   function cur-time-date returns character
      133   :
      134     return string(today, '99/99/9999':U) .
      135   end.
      136   function cur-time-mjd returns decimal
      137   :
      138     define variable v-date as date      no-undo .
      139     define variable v-time as integer   no-undo .
      140     run cur-time in this-procedure
      141       (output v-date
      142       ,output v-time
      143       ) .
      144     return integer(v-date) - 2400002 + (v-time / 86400) .
      145   end.
      146   function cur-time-get-ending-index returns integer
      147   (input p-number as integer
      148   )
      149   :
      150     if p-number < 0
      151     or p-number = ?
      152     then do:
      153       return 1 .
      154     end.
      155     define variable v-rest as integer   no-undo .
      156     assign
      157       p-number = p-number modulo 100
      158     .
      159     if p-number < 20
      160     then do:
      161       assign
      162         v-rest = p-number
      163       .
      164     end.
      165     else do:
      166       assign
      167         v-rest = p-number modulo 10
      168       .
      169     end.
      170     case v-rest :
      171       when 1
      172       then do:
      173         return 2 .
      174       end.
      175       when 2 or
      176       when 3 or
      177       when 4
      178       then do:
      179         return 3 .
      180       end.
      181       otherwise do:
      182         return 1 .
      183       end.
      184     end case .
      185   end.
      186   procedure cur-time-mjd-to-date :
      187      define input  parameter i-mjd-diff as decimal no-undo.
      188      define output parameter o-Date     as date    no-undo.
      189      define output parameter o-Time     as integer no-undo.
      190      define variable v-day-number as integer   no-undo .
      191      if    i-mjd-diff < 0
      192         or i-mjd-diff = ?
      193      then do:
      194         return "?" .
      195      end.
      196      assign
      197         v-day-number = truncate(i-mjd-diff,0).
      198         o-Date = date(v-day-number + 2400002).
      199         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      200     .
      201   end.
      202   function cur-time-mjd-to-string returns character
      203   (input p-mjd-diff as decimal
      204   )
      205   :
      206     define variable v-day-number as integer   no-undo .
      207     define variable v-seconds    as integer   no-undo .
      208     define variable v-hour       as integer   no-undo .
      209     define variable v-min        as integer   no-undo .
      210     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      211     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      212     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      213     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      214     if p-mjd-diff < 0
      215     or p-mjd-diff = ?
      216     then do:
      217       return "?" .
      218     end.
      219     assign
      220       v-day-number = integer(truncate(p-mjd-diff,0))
      221       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      222     .
      223     if v-seconds > 86400
      224     then do:
      225       assign
      226         v-seconds = 86400 - 1
      227       .
      228     end.
      229     if v-seconds < 0
      230     then do:
      231       assign
      232         v-seconds = 0
      233       .
      234     end.
      235     assign
      236       v-hour = truncate(v-seconds / 3600, 0)
      237     .
      238     assign
      239       v-seconds = v-seconds modulo 3600
      240     .
      241     assign
      242       v-min = truncate(v-seconds / 60, 0)
      243     .
      244     assign
      245       v-seconds = v-seconds modulo 60
      246     .
      247     return
      248         (if v-day-number <> 0
      249           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      250           else ""
      251         )
      252       + (if v-day-number <> 0 or v-hour <> 0
      253           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      254           else ""
      255         )
      256       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      257           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      258           else ""
      259         )
      260       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      261       .
      262   end.
      263   function cur-time-string returns character
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      272   end.
      273   function cur-time-string-sec returns character
      274   :
      275     define variable v-date as date      no-undo .
      276     define variable v-time as integer   no-undo .
      277     run cur-time in this-procedure
      278       (output v-date
      279       ,output v-time
      280       ) .
      281     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      282   end.
      283   function cur-time-custom  returns character
      284   (input p-prefix as character
      285   ,input p-date-format as character
      286   ,input p-delimiter as character
      287   ,input p-time-format as character
      288   ,input p-suffix as character
      289   )
      290   :
      291     define variable v-date as date      no-undo .
      292     define variable v-time as integer   no-undo .
      293     run cur-time in this-procedure
      294       (output v-date
      295       ,output v-time
      296       ) .
      297     return
      298       p-prefix
      299       + string(v-date, p-date-format)
      300       + p-delimiter
      301       + string(v-time, p-time-format)
      302       + p-suffix
      303       .
      304   end.
      305   function cur-time-print  returns character
      306   :
      307     define variable v-date as date      no-undo .
      308     define variable v-time as integer   no-undo .
      309     run cur-time in this-procedure
      310       (output v-date
      311       ,output v-time
      312       ) .
      313     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      314   end.
      315   function cur-time-datetime returns datetime
      316   :
      317     define variable v-char as character no-undo .
      318     define variable v-datetime as datetime no-undo .
      319     v-char = cur-time-string().
      320     v-datetime = datetime(v-char).
      321     return  v-datetime.
      322   end.
      323   function cur-time-string-msec returns character
      324   :
      325     define variable v-date as datetime  no-undo .
      326     v-date = now.
      327     return string(v-date) .
      328   end.
      329   define stream LogStream .
      330   define variable mNoTime as logical no-undo.
      331   procedure write-to-log-notime :
      332     define input param i-str as character no-undo .
      333     mNoTime = yes.
      334     run write-to-log (i-str).
      335     mNoTime = no.
      336   end.
      337   procedure write-to-log :
      338     define input param p-str as character no-undo .
      339     do
      340     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      341     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      342     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      343     :
      344       define variable log-res        as logical   no-undo .
      345       define variable v-jj           as integer   no-undo .
      346       if    mNoTime
      347          or writelogvalue eq "AsyncProc"
      348       then
      349          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      350       else
      351          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      352       if auto-log-msg-h <> ? then do:
      353         log-res = auto-log-msg-h:move-to-eof( ) .
      354         log-res = auto-log-msg-h:insert-string( p-str ).
      355       end.
      356       if hand-log-msg-h <> ? then do:
      357         log-res = hand-log-msg-h:move-to-eof( ) .
      358         log-res = hand-log-msg-h:insert-string( p-str ).
      359       end.
      360       assign
      361         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      362         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      363         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      364       .
      365       if add-log-file-name <> ? then do:
      366         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      367           run gbl/fileapnd.p
      368             ( input entry(v-jj, add-log-file-name, chr(1) )
      369             ,input p-str
      370             ,input 20
      371             ) no-error .
      372           if error-status:error then do:
      373             return error return-value .
      374           end.
      375         end.
      376       end.
      377       if writelogvalue eq "AsyncProc"
      378       then do:
      379          p-str = trim(p-str, (chr(13) + chr(10)) )
      380       .
      381          Publish "WriteLogAsunc" (p-str,yes).
      382       end.
      383       else if writelogvalue <> "yes" then do:
      384         run gbl/fileapnd.p
      385           ( input log-file-name
      386           ,input p-str
      387           ,input 20
      388           ) no-error .
      389         if error-status:error then do:
      390           return error return-value .
      391         end.
      392       end.
      393     end.
      394   end procedure.
      395   procedure write-to-screen :
      396     define input param p-str as character no-undo .
      397     do
      398     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      399     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      400     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      401     :
      402       define variable log-res as logical no-undo.
      403       assign
      404         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      405       .
      406       if auto-log-msg-h <> ?
      407       then do:
      408         log-res = auto-log-msg-h:move-to-eof( ) .
      409         log-res = auto-log-msg-h:insert-string( p-str ).
      410       end.
      411       if hand-log-msg-h <> ?
      412       then do:
      413         log-res = hand-log-msg-h:move-to-eof( ) .
      414         log-res = hand-log-msg-h:insert-string( p-str ).
      415       end.
      416     end.
      417   end procedure.
      418   procedure send-msg-to-email :
      419     define input  parameter p-subject      as character no-undo .
      420     define input  parameter p-text-err     as character no-undo .
      421     define input  parameter p-attach-files as character no-undo .
      422     do
      423     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      424     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      425     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      426     :
      427       define variable v-tth             as handle    no-undo .
      428       define variable v-value-character as character no-undo .
      429       define variable v-value-date      as date      no-undo .
      430       define variable v-value-decimal   as decimal   no-undo .
      431       define variable v-value-integer   as integer   no-undo .
      432       define variable v-value-logical   as logical   no-undo .
      433       define variable v-param-type      as character no-undo .
      434       define variable v-email       as character no-undo .
      435       define variable v-tmp-str     as character no-undo .
      436       define variable v-tmp1-str    as character no-undo .
      437       define variable v-ind         as integer   no-undo .
      438       define variable v-num-entries as integer   no-undo .
      439       delete object v-tth no-error.
      440       run adm/shattri.p
      441         ( input "get":U
      442          ,input  "":U
      443          ,input  0
      444          ,input  'auto-task':U
      445          ,input  'send-msg-to-email':U
      446          ,output v-value-character
      447          ,output v-value-date
      448          ,output v-value-decimal
      449          ,output v-value-integer
      450          ,output v-value-logical
      451          ,output v-param-type
      452          ,input-output table-handle v-tth
      453         ) no-error .
      454       if not error-status :error  then do:
      455         assign
      456           v-tmp-str = v-value-character
      457         .
      458       end.
      459       delete object v-tth no-error.
      460       assign
      461         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      462         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      463         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      464         v-num-entries = num-entries( v-tmp-str, chr(44) )
      465         v-email       = "":U
      466       .
      467       do v-ind = 1 to v-num-entries
      468       :
      469         assign
      470           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      471         .
      472         if trim( v-tmp1-str ) <> "":U then do:
      473           if v-email = "":U then do:
      474             assign
      475               v-email = v-tmp1-str
      476             .
      477           end.
      478           else do:
      479             assign
      480               v-email = v-email + chr(44) + v-tmp1-str
      481             .
      482           end.
      483         end.
      484       end.
      485       if v-email <> "":U then do:
      486         run gbl/sendmail.p
      487           ( input v-email
      488           , input p-subject
      489           , input p-text-err
      490           , input p-attach-files
      491           ) no-error .
      492         if error-status :error
      493           or return-value <> "":U
      494         then do:
      495           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      496         end.
      497       end.
      498     end.
      499   end procedure.
      500   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      501   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      502   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      503   define variable par-type          as character no-undo.
      504   define variable v-value-character as character no-undo .
      505   define variable v-value-date      as date      no-undo .
      506   define variable v-value-decimal   as decimal   no-undo .
      507   define variable v-value-integer   as integer   no-undo .
      508   define variable v-value-logical   as logical   no-undo .
      509   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      510   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      511   define variable vss-include-info7 as character format "X(65)" no-undo
      512   initial "@(#)$Workfile$ $Revision$".
      513   procedure xmlchar-test :
      514   define input parameter p-in-string          as character        no-undo.
      515   define output parameter p-out-string-enc    as character        no-undo.
      516   define output parameter p-out-string-dec    as character        no-undo.
      517   do
      518   on error undo, return error
      519   :
      520          run xmlchar-encode in this-procedure
      521       (
      522             input p-in-string
      523           , output p-out-string-enc
      524       ).
      525          run xmlchar-decode in this-procedure
      526       (
      527             input p-out-string-enc
      528           , output p-out-string-dec
      529       ).
      530   end.
      531   end .
      532   procedure xmlchar-encode :
      533   define input parameter p-in-string      as character        no-undo.
      534   define output parameter p-out-string    as character        no-undo.
      535       define variable v-position      as integer      no-undo.
      536       define variable v-current-char  as character    no-undo.
      537   do
      538   on error undo, return error
      539   :
      540       assign
      541           p-out-string = "":U
      542       .
      543       case p-in-string
      544       :
      545           when ?
      546           then do:
      547               assign
      548                   p-out-string = "?":U
      549               .
      550           end.
      551           when "?":U
      552           then do:
      553               assign
      554                   p-out-string = "&#63;":U
      555               .
      556           end.
      557           otherwise do:
      558               do v-position = 1 to length( p-in-string )
      559               :
      560                   assign
      561                       v-current-char = substring( p-in-string, v-position, 1 )
      562                   .
      563                   case v-current-char
      564                   :
      565                       when "&":U
      566                       then do:
      567                           assign
      568                               p-out-string = p-out-string + "&amp;":U
      569                           .
      570                       end.
      571                       when ">":U
      572                       then do:
      573                           assign
      574                               p-out-string = p-out-string + "&gt;":U
      575                           .
      576                       end.
      577                       when "<":U
      578                       then do:
      579                           assign
      580                               p-out-string = p-out-string + "&lt;":U
      581                           .
      582                       end.
      583                       when "'":U
      584                       then do:
      585                           assign
      586                               p-out-string = p-out-string + "&apos;":U
      587                           .
      588                       end.
      589                       when '"':U
      590                       then do:
      591                           assign
      592                               p-out-string = p-out-string + "&quot;":U
      593                           .
      594                       end.
      595                       when chr(1)
      596                       then do:
      597                           assign
      598                               p-out-string = p-out-string + "":U
      599                           .
      600                       end.
      601                       when chr(2)
      602                       then do:
      603                           assign
      604                               p-out-string = p-out-string + "":U
      605                           .
      606                       end.
      607                       when chr(3)
      608                       then do:
      609                           assign
      610                               p-out-string = p-out-string + "":U
      611                           .
      612                       end.
      613                       when chr(4)
      614                       then do:
      615                           assign
      616                               p-out-string = p-out-string + "":U
      617                           .
      618                       end.
      619                       when chr(5)
      620                       then do:
      621                           assign
      622                               p-out-string = p-out-string + "":U
      623                           .
      624                       end.
      625                       when chr(6)
      626                       then do:
      627                           assign
      628                               p-out-string = p-out-string + "":U
      629                           .
      630                       end.
      631                       when chr(7)
      632                       then do:
      633                           assign
      634                               p-out-string = p-out-string + "":U
      635                           .
      636                       end.
      637                       when chr(8)
      638                       then do:
      639                           assign
      640                               p-out-string = p-out-string + "":U
      641                           .
      642                       end.
      643                       when chr(9)
      644                       then do:
      645                           assign
      646                               p-out-string = p-out-string + "":U
      647                           .
      648                       end.
      649                       when chr(29)
      650                       then do:
      651                           assign
      652                               p-out-string = p-out-string + "":U
      653                           .
      654                       end.
      655                       when chr(10)
      656                       then do:
      657                           assign
      658                               p-out-string = p-out-string + "&#10;":U
      659                           .
      660                       end.
      661                       when chr(13)
      662                       then do:
      663                           assign
      664                               p-out-string = p-out-string + "&#13;":U
      665                           .
      666                       end.
      667                       otherwise do:
      668                           assign
      669                               p-out-string = p-out-string + v-current-char
      670                           .
      671                       end.
      672                   end case.
      673               end.
      674           end.
      675       end case.
      676   end.
      677   end .
      678   procedure xmlchar-encode-1c :
      679   define input parameter p-in-string      as character        no-undo.
      680   define output parameter p-out-string    as character        no-undo.
      681       define variable v-position      as integer      no-undo.
      682       define variable v-current-char  as character    no-undo.
      683   do
      684   on error undo, return error
      685   :
      686       assign
      687           p-out-string = "":U
      688       .
      689       case p-in-string
      690       :
      691           when ?
      692           then do:
      693               assign
      694                   p-out-string = "?":U
      695               .
      696           end.
      697           otherwise do:
      698               do v-position = 1 to length( p-in-string )
      699               :
      700                   assign
      701                       v-current-char = substring( p-in-string, v-position, 1 )
      702                   .
      703                   case v-current-char
      704                   :
      705                       when chr(1)
      706                       then do:
      707                           assign
      708                               p-out-string = p-out-string + " ":U
      709                           .
      710                       end.
      711                       when chr(2)
      712                       then do:
      713                           assign
      714                               p-out-string = p-out-string + " ":U
      715                           .
      716                       end.
      717                       when chr(3)
      718                       then do:
      719                           assign
      720                               p-out-string = p-out-string + " ":U
      721                           .
      722                       end.
      723                       when chr(4)
      724                       then do:
      725                           assign
      726                               p-out-string = p-out-string + " ":U
      727                           .
      728                       end.
      729                       when chr(5)
      730                       then do:
      731                           assign
      732                               p-out-string = p-out-string + " ":U
      733                           .
      734                       end.
      735                       when chr(6)
      736                       then do:
      737                           assign
      738                               p-out-string = p-out-string + " ":U
      739                           .
      740                       end.
      741                       when chr(7)
      742                       then do:
      743                           assign
      744                               p-out-string = p-out-string + " ":U
      745                           .
      746                       end.
      747                       when chr(8)
      748                       then do:
      749                           assign
      750                               p-out-string = p-out-string + " ":U
      751                           .
      752                       end.
      753                       when chr(9)
      754                       then do:
      755                           assign
      756                               p-out-string = p-out-string + " ":U
      757                           .
      758                       end.
      759                       when chr(29)
      760                       then do:
      761                           assign
      762                               p-out-string = p-out-string + " ":U
      763                           .
      764                       end.
      765                       when chr(10)
      766                       then do:
      767                           assign
      768                               p-out-string = p-out-string + " ":U
      769                           .
      770                       end.
      771                       when chr(13)
      772                       then do:
      773                           assign
      774                               p-out-string = p-out-string + " ":U
      775                           .
      776                       end.
      777                       otherwise do:
      778                           assign
      779                               p-out-string = p-out-string + v-current-char
      780                           .
      781                       end.
      782                   end case.
      783               end.
      784           end.
      785       end case.
      786   end.
      787   end .
      788   procedure xmlchar-decode :
      789   define input parameter p-in-string      as character        no-undo.
      790   define output parameter p-out-string    as character        no-undo.
      791       define variable v-position      as integer      no-undo.
      792       define variable v-last-position as integer      no-undo.
      793       define variable v-temp-integer  as integer      no-undo.
      794       define variable v-current-char  as character    no-undo.
      795       define variable v-next-char     as character    no-undo.
      796       define variable v-success       as logical      no-undo.
      797   do
      798   on error undo, return error
      799   :
      800       assign
      801           p-out-string = "":U
      802           v-position   = 0
      803       .
      804       replace-cycle:
      805       do while yes
      806       on error undo, return error
      807       :
      808           assign
      809               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      810           .
      811           if v-last-position <= v-position
      812           then do:
      813               if v-position = 0
      814               then do:
      815                   assign
      816                       p-out-string = p-in-string
      817                   .
      818               end.
      819               else do:
      820                   assign
      821                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      822                   .
      823               end.
      824               leave replace-cycle.
      825           end.
      826           else do:
      827               assign
      828                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      829                   v-position      = v-last-position
      830                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      831               .
      832               if v-current-char = "#":U
      833               then do:
      834                   assign
      835                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      836                   .
      837                   if v-last-position > 0
      838                   then do:
      839                       run xmlchar-read-integer in this-procedure
      840                        (
      841                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      842                           , output v-temp-integer
      843                           , output v-success
      844                       ).
      845                       if v-success = yes
      846                       and v-temp-integer >= 1
      847                       and v-temp-integer <= 255
      848                       then do:
      849                           assign
      850                               p-out-string = p-out-string + chr( v-temp-integer )
      851                               v-position   = v-last-position + 1
      852                           .
      853                       end.
      854                       else do:
      855                           assign
      856                               p-out-string = p-out-string + "&":U
      857                               v-position   = v-position   + 1
      858                           .
      859                       end.
      860                   end.
      861                   else do:
      862                       assign
      863                           p-out-string = p-out-string + "&":U
      864                           v-position   = v-position   + 1
      865                       .
      866                   end.
      867               end.
      868               else do:
      869                   case substring( p-in-string, v-position + 1, 3 )
      870                   :
      871                       when "lt;":U
      872                       then do:
      873                           assign
      874                               p-out-string = p-out-string + "<":U
      875                               v-position   = v-position   + 3
      876                           .
      877                       end.
      878                       when "gt;":U
      879                       then do:
      880                           assign
      881                               p-out-string = p-out-string + ">":U
      882                               v-position   = v-position   + 3
      883                           .
      884                       end.
      885                       otherwise do:
      886                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      887                           then do:
      888                               assign
      889                                   p-out-string = p-out-string + "&":U
      890                                   v-position   = v-position   + 4
      891                               .
      892                           end.
      893                           else do:
      894                               case substring( p-in-string, v-position + 1, 5 )
      895                               :
      896                                   when "quot;":U
      897                                   then do:
      898                                       assign
      899                                           p-out-string = p-out-string + '"':U
      900                                           v-position   = v-position   + 5
      901                                       .
      902                                   end.
      903                                   when "apos;":U
      904                                   then do:
      905                                       assign
      906                                           p-out-string = p-out-string + "'":U
      907                                           v-position   = v-position   + 5
      908                                       .
      909                                   end.
      910                                   otherwise do:
      911                                       assign
      912                                           p-out-string = p-out-string + "&":U
      913                                       .
      914                                   end.
      915                               end case.
      916                           end.
      917                       end.
      918                   end case.
      919               end.
      920           end.
      921       end.
      922   end.
      923   end .
      924   procedure xmlchar-read-integer :
      925   define input parameter p-input-string      as character        no-undo.
      926   define output parameter p-output-integer   as integer          no-undo.
      927   define output parameter p-success       as logical          no-undo.
      928   do
      929   on error undo, return error
      930   :
      931       assign
      932           p-output-integer = integer( p-input-string )
      933       no-error.
      934       if error-status :error
      935       then do:
      936           assign
      937               p-success           = no
      938               p-output-integer    = 0
      939           .
      940       end.
      941       else do:
      942           assign
      943               p-success           = yes
      944           .
      945       end.
      946   end.
      947   end.
      948   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      949   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      950   define new global shared variable g#attr-lib  as handle no-undo .
      951   define variable v-attr-lib-variable as handle no-undo .
      952   define variable mMRCCode  as logical    no-undo.
      953   define variable mTypeMark as character  no-undo.
      954   function IS-NeedMark returns logical
      955   ( input ib-code as integer  ,
      956     input ib-str as character ):
      957      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      958      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      959                                    and buf_prod-bc-attr.b-str  eq ib-str
      960                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      961        no-lock no-error.
      962      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      963   end.
      964   function repTegforDm return char
      965   (iDM as char ):
      966       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      967       define variable vteg as character no-undo.
      968       define variable oDM as character no-undo.
      969       define variable vi as integer no-undo.
      970       oDM = iDm.
      971       do vi = 1 to num-entries(vTeglist):
      972          vTeg = entry(vi,vTeglist).
      973          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      974       end.
      975       return oDM.
      976   end.
      977   function repSpecSimbforDm return char
      978   (iDM as char ):
      979       define variable oDM as character no-undo.
      980     run
      981       xmlchar-decode(iDM, output oDM).
      982     return repTegforDm (oDM).
      983   end.
      984   function CheckGtin return logical
      985   (iGtin as char):
      986      define variable bar_code as character no-undo.
      987      define variable vGtin as logical no-undo init "yes".
      988      if length(iGtin) eq 14
      989      then do:
      990         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      991         run str/chk-sum.p
      992          (input-output bar_code ) no-error .
      993         if iGtin ne  bar_code
      994         then
      995            vGtin = no.
      996      end.
      997      else
      998         vGtin = no.
      999      return vgtin.
     1000   end.
     1001   function repSpecSimbforXlm return char
     1002   (iDM as char ):
     1003       iDM = replace(iDM,chr(29),"").
     1004       return iDM.
     1005   end.
     1006   function getGtinByDM return char
     1007   (IDM as char):
     1008      define variable VTXT as char no-undo.
     1009      define variable vGtin as char no-undo.
     1010      vTXt = IdM.
     1011      vGtin = IDM.
     1012      if    length(vtxt) > 14
     1013      then do:
     1014         if   vtxt begins "(01)"
     1015                or vtxt begins "(02)"
     1016         then
     1017            vGtin = substring(vtxt,5,14).
     1018         else if   (vtxt begins "01"
     1019                or vtxt begins "02" )
     1020                and (   (    substring(iDm,17,2) eq "21"
     1021                         and length(vtxt) >= 21)
     1022                     or substring(iDm,17,2) eq "37"
     1023                     or substring(iDm,17,4) eq "(37)" )
     1024         then do:
     1025            vGtin = substring(vtxt,3,14).
     1026            if not checkGtin(vGtin)
     1027            then
     1028               vGtin = substring(vtxt,1,14).
     1029         end.
     1030         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1031             or length(vtxt) eq 14 + 7 + 4
     1032             or length(vtxt) eq 14 + 7
     1033         then
     1034            vGtin = substring(vtxt,1,14).
     1035      end.
     1036      if not checkGtin(vGtin)
     1037      then
     1038         vGtin = "".
     1039      return vgtin.
     1040   end.
     1041   function getGdsCodeByGtin return int
     1042   (iGtin as char):
     1043      define buffer prod-bc  for ub.prod-bc.
     1044      define buffer bar-code for ub.bar-code.
     1045      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1046      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1047      return if avail bar-code then bar-code.gds-code else ?.
     1048   end.
     1049   function getQntyCodeByGtin return decimal
     1050   (iGtin as char):
     1051      define buffer prod-bc  for ub.prod-bc.
     1052      define buffer bar-code for ub.bar-code.
     1053      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1054      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1055      return if avail bar-code then bar-code.cli-base-rate else ?.
     1056   end.
     1057   function getGdsCodeByDM return int
     1058   (iDm as char):
     1059      define variable vGtin as char no-undo.
     1060      define buffer prod-bc for ub.prod-bc.
     1061      vGtin  = getGtinByDM (IDM ).
     1062      return getGdsCodeByGtin (vGtin).
     1063   end.
     1064   function ChekTypeMarkByGds return logical
     1065   (iGds-code as integer ):
     1066      define buffer goods-attr for ub.goods-attr.
     1067      find first goods-attr where goods-attr.gds-code   = iGds-code
     1068                              and goods-attr.attr-code  = 'mark-type':U
     1069      no-lock no-error.
     1070      if available goods-attr
     1071      then do:
     1072         mTypeMark = goods-attr.attr-value.
     1073         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1074           .
     1075      end.
     1076      else
     1077         return no.
     1078   end.
     1079   function ChekTypeMarkByDm return logical
     1080   (iDM as char ):
     1081      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1082   end.
     1083   function ChekTypeMarkByGtin return logical
     1084   (iGtin as char ):
     1085      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1086   end.
     1087   function GetNextElement return character
     1088     (input iAllTeg        as logical
     1089     ,output oteg          as character
     1090     ,output otegval       as character
     1091     ,input-output pstr    as character
     1092      ):
     1093        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1094        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1095        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1096        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1097        define variable vTeg as character no-undo.
     1098        define variable vLength as integer no-undo.
     1099        define variable vi as integer no-undo.
     1100        define variable vj as integer no-undo.
     1101        define buffer code for ub.code.
     1102        find first code where Code.parent eq "MarkType"
     1103                          and Code.CodeValue   eq mTypeMark
     1104                          no-lock no-error.
     1105        if     available code
     1106           and Code.misc1 ne ""
     1107           and Code.misc1 ne ?
     1108        then do:
     1109           integer (Code.misc1) no-error.
     1110           if not error-status:error
     1111           then
     1112             entry (4,vlistleng) = Code.misc1.
     1113        end.
     1114        if iAllTeg
     1115        then
     1116           assign
     1117              vlistElem     = vlistElem    + vlistElemDop
     1118              vlistleng     = vlistleng    + vlistlengDop
     1119           .
     1120        else if mMRCCode
     1121        then
     1122           assign
     1123              vlistElem     = vlistElem    + ",(8005),8005"
     1124              vlistleng     = vlistleng    + ",000006,0006"
     1125           .
     1126       block-elem:
     1127       do vi = 1 to num-entries(vlistElem):
     1128          vTeg = entry(vi,vlistElem).
     1129          if pstr begins vTeg
     1130          then do:
     1131             if    vTeg eq "21"
     1132             then
     1133                vLength = index(pstr,chr(29)) - 2 no-error.
     1134             if vLength  <= 0
     1135             then
     1136                vLength = int(entry(vi,vlistleng)).
     1137             otegval = substring (pstr,length(vteg) + 1, vLength).
     1138             oteg = replace(replace(vteg,")",""),"(","").
     1139             vTeg = vteg + otegval.
     1140             otegval = replace(otegval,chr(29),"").
     1141             oteg = replace(replace(oteg,")",""),"(","").
     1142             pstr = substring (pstr,length(vTeg)+ 1).
     1143             vTeg = replace(vTeg,chr(29),"").
     1144             leave block-elem.
     1145          end.
     1146          else
     1147             vTeg = "".
     1148       end.
     1149       return vteg.
     1150   end.
     1151   function GetCodeIdent return character
     1152   (iDm as char):
     1153      define variable Velement   as character no-undo init "first".
     1154      define variable oCodeIdent as character no-undo.
     1155      define variable vteg as character no-undo.
     1156      define variable vtegval as character no-undo.
     1157      define variable vGtin as character no-undo.
     1158      define buffer marking for ub.marking.
     1159      for first marking no-lock where
     1160                marking.mark eq iDm
     1161            and marking.unit-ext = "LEVEL2"
     1162      :
     1163        return iDm.
     1164      end.
     1165      vGtin  = getGtinByDM (iDm ).
     1166      ChekTypeMarkByDm(idm).
     1167      if iDm begins 'tech_':U
     1168      then
     1169         oCodeIdent = iDm.
     1170      else if length(iDm) < 21
     1171      then do:
     1172         find first marking where marking.mark eq idm
     1173         no-lock no-error.
     1174         oCodeIdent = if available marking then marking.mark else  ?.
     1175      end.
     1176      else if     length(iDm) eq 29
     1177         and not iDm begins "01"
     1178         and not iDm begins "02"
     1179      then
     1180         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1181      else  if     length(iDm) >= 24
     1182               and (  iDm begins "01"
     1183                   or iDm begins "02")
     1184               and  substring(iDm,17,2) ne "21"
     1185      then do:
     1186         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1187                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1188         then
     1189            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1190         else
     1191            oCodeIdent = iDM.
     1192      end.
     1193      else  if     (   length(iDm) eq 25
     1194                    or length(iDm) eq 21)
     1195               and (not iDm begins "01"
     1196               and  not iDm begins "02")
     1197      then
     1198         oCodeIdent = substring(iDm,1,21).
     1199      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1200      then
     1201         oCodeIdent = substring(iDm,1,21).
     1202      else do while Velement ne "" and idm ne "":
     1203         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1204         oCodeIdent = oCodeIdent + Velement.
     1205      end.
     1206      return oCodeIdent.
     1207   end.
     1208   function GetTegCod return character
     1209   (icodeIdent as char, iTeg as char):
     1210      define variable Velement   as character no-undo init "first".
     1211      define variable oTeg as character no-undo init ?.
     1212      define variable vteg as character no-undo.
     1213      define variable vtegval as character no-undo.
     1214      if     ((length(icodeIdent) eq 21
     1215         and not icodeIdent begins "01"
     1216         and not icodeIdent begins "02")
     1217         or
     1218             ( length(icodeIdent) eq 25
     1219               and not icodeIdent begins "01"
     1220               and not icodeIdent begins "02"))
     1221      then do:
     1222         if iTeg eq "01" or iTeg eq "02"
     1223         then
     1224            oTeg = substring(icodeIdent,1,21).
     1225         else  if  iTeg eq "21"
     1226         then
     1227            oTeg = substring(icodeIdent,15,7).
     1228      end.
     1229      else do:
     1230         ChekTypeMarkByDm(icodeIdent).
     1231         block-teg:
     1232            do while Velement ne "" and icodeIdent ne "":
     1233            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1234            if    Velement begins iTeg
     1235               or Velement begins "(" + iTeg + ")"
     1236            then do:
     1237               oTeg = vtegval.
     1238               leave block-teg.
     1239            end.
     1240         end.
     1241      end.
     1242      return oTeg.
     1243   end.
     1244   function isOAD return logical
     1245   (icodeIdent as character):
     1246      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1247   end.
     1248   function isMark return logical
     1249   (icodeIdent as character):
     1250      define buffer buf_marking for ub.marking.
     1251      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1252             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1253   end.
     1254   function addBracketForCode return character
     1255   (icodeIdent as char):
     1256      define variable Velement   as character no-undo init "first".
     1257      define variable oTeg as character no-undo.
     1258      define variable vteg as character no-undo.
     1259      define variable vtegval as character no-undo.
     1260      define buffer marking for ub.marking.
     1261      find first marking no-lock where
     1262                 marking.mark begins icodeIdent no-error.
     1263      if    not ChekTypeMarkByDm(icodeIdent)
     1264         or length(icodeIdent) le 24
     1265         or (avail marking and marking.unit-ext = "LEVEL2")
     1266      then
     1267         oTeg = icodeIdent.
     1268      else do:
     1269         if (  icodeIdent begins "01"
     1270            or icodeIdent begins "02"
     1271            ) and CheckGtin(substring (icodeIdent,3,14))
     1272            and substring (icodeIdent,17,2) eq "21"
     1273         then do:
     1274            mMRCCode = yes.
     1275            ChekTypeMarkByDm(icodeIdent).
     1276            block-teg:
     1277            do while Velement ne "" and icodeIdent ne "":
     1278               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1279               if vteg ne ""
     1280               then
     1281                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1282            end.
     1283            mMRCCode = no.
     1284         end.
     1285         else do:
     1286            oTeg = icodeIdent.
     1287         end.
     1288      end.
     1289      return oTeg.
     1290   end.
     1291   function getlevelByCodId return int
     1292   (iCode as char):
     1293      define variable vLength as int no-undo.
     1294      define variable vLevel  as int no-undo.
     1295      if not ChekTypeMarkByDM (icode) then return ?.
     1296      vLength = length(iCode).
     1297      if    vLength eq 18
     1298         or vLength eq 20
     1299      then
     1300         Vlevel = 4.
     1301      else if vLength eq 21
     1302      then
     1303         Vlevel = 1.
     1304      else if vLength eq 25
     1305      then do:
     1306         if  iCode begins "01"
     1307         then
     1308            Vlevel = 3.
     1309         else
     1310            Vlevel = 1.
     1311      end.
     1312      else if     vLength >= 26
     1313              and vLength <= 46
     1314      then do:
     1315         if    substring(iCode,17,2) eq "11"
     1316            or substring(iCode,17,2) eq "13"
     1317            or (    substring(iCode,17,2) eq "21"
     1318                and vLength >= 33
     1319                and substring(iCode,26,4) ne "8005")
     1320         then
     1321            Vlevel = 4.
     1322         else if    vLength eq 31
     1323                 or vLength eq 38
     1324                 or vLength eq 39
     1325                 or vLength eq 45
     1326         then
     1327            Vlevel = 1.
     1328         else if    vLength eq 35
     1329                 or vLength eq 43
     1330         then
     1331            Vlevel = 3.
     1332         else
     1333            Vlevel = ?.
     1334      end.
     1335      else
     1336         Vlevel = ?.
     1337      return Vlevel.
     1338   end.
     1339   function getLevelMotpBycodid return character
     1340   (iDm as char):
     1341      define variable vLevel as integer no-undo.
     1342      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1343      vLevel = getlevelByCodId(iDm).
     1344      if    vLevel eq ?
     1345         or vLevel < 1
     1346         or vLevel > 6
     1347      then
     1348         return ?.
     1349      else
     1350         return entry(vlevel,vList).
     1351   end.
     1352   function getLevelUTDByLevelMotp return character
     1353   (iUnit as char):
     1354      define variable vLevel as integer no-undo.
     1355      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1356      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1357      vLevel = lookup(iUnit,vListMOTP).
     1358      if    vLevel eq ?
     1359         or vLevel < 1
     1360         or vLevel > 4
     1361      then
     1362         return ?.
     1363      else
     1364         return entry(vlevel,vListutd).
     1365   end.
     1366   function getLevelMotpByDM return character
     1367   (iDm as char):
     1368      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1369   end.
     1370   function getLevelUTDByCodId return character
     1371   (iDm as char):
     1372      define variable vLevel as integer no-undo.
     1373      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1374      vLevel = getlevelByCodId(iDm).
     1375      if    vLevel eq ?
     1376         or vLevel < 1
     1377         or vLevel > 4
     1378      then
     1379         return ?.
     1380      else
     1381         return entry(vlevel,vList).
     1382   end.
     1383   function getLevelUTDByDM return character
     1384   (iDm as char):
     1385      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1386   end.
     1387   define variable mNotMarkQnty as logical no-undo.
     1388   function getQntyUTDByCodId return decimal
     1389   (iDM as char):
     1390      define variable vLevel as integer no-undo.
     1391      define variable vList as character no-undo init "1,5,10,500".
     1392      define variable vGtin as character no-undo.
     1393      define variable vqnty as decimal no-undo init ?.
     1394      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1395      if vqnty eq ?
     1396      then do:
     1397         if not mNotMarkQnty
     1398         then do:
     1399            define buffer marking for ub.marking.
     1400            define variable vCodident as character no-undo.
     1401            vCodident = GetCodeIdent(idm).
     1402            find first marking where marking.mark begins vCodident no-lock no-error.
     1403            if     available marking
     1404               and marking.box-qnty ne ?
     1405            then
     1406               return marking.box-qnty.
     1407         end.
     1408         vGtin = getGtinByDm(iDM).
     1409         if ChekTypeMarkByGtin (vGtin)
     1410         then do:
     1411            vLevel = getlevelByCodId(iDM).
     1412            if     vLevel >= 1
     1413               and vLevel <= 4
     1414            then
     1415               vqnty = int(entry(vlevel,vList)).
     1416         end.
     1417         else
     1418            vqnty = getQntyCodeByGtin(vgtin).
     1419      end.
     1420      return vqnty.
     1421   end.
     1422   function getQntyUTDByDM return decimal
     1423   (iDm as char):
     1424      define variable vDM as character no-undo.
     1425      if     length (iDm) ne 25
     1426         and length (iDm) ne 29
     1427         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1428      then
     1429         vDM = substring (iDm,1,length (iDm) - 6 ).
     1430      else
     1431         vDM = substring (iDm,1,length (iDm) - 4 ).
     1432      return getQntyUTDByCodId(vDM).
     1433   end.
     1434   function getMRC4 return decimal
     1435   (iMRC as char):
     1436      define variable oMrc     as decimal no-undo init ?.
     1437      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1438      define variable vi       as integer no-undo.
     1439      define variable vfound   as integer no-undo.
     1440      define variable vposStart   as integer no-undo.
     1441      do:
     1442      OMRc = 0.
     1443      do vi = 1 to 4:
     1444         define variable vsimb as character no-undo.
     1445         vsimb = substring(iMRC,vi,1).
     1446         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1447         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1448         if vfound > 0
     1449         then
     1450            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1451         end.
     1452         OMRc = OMRc / 100.
     1453      end.
     1454      return OMRc.
     1455   end.
     1456   function getMRCByDM return decimal
     1457   (iDm as char):
     1458      define variable vMRC     as character no-undo.
     1459      define variable oMrc     as decimal no-undo init ?.
     1460      define variable Velement as character no-undo init "empty".
     1461      define variable vteg as character no-undo.
     1462      define variable vtegval as character no-undo.
     1463      if    length(idm) eq 14 + 7 + 4 + 4
     1464         or length(idm) eq 14 + 7 + 4
     1465      then do:
     1466         vMRC = substring(idm,22,4).
     1467         omrc = getMRC4(vMRC).
     1468      end.
     1469      else do:
     1470          ChekTypeMarkByDm(iDm).
     1471          block-mrc:
     1472          do while Velement ne "" and idm ne "":
     1473             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1474             if Velement begins "8005"
     1475             then do:
     1476                vMRC = substring(Velement,5,6).
     1477                leave block-mrc.
     1478             end.
     1479             else if Velement begins "(8005)"
     1480             then do:
     1481                vMRC = substring(Velement,7,6).
     1482                leave block-mrc.
     1483             end.
     1484          end.
     1485          if vMRC ne ""
     1486          then
     1487             OMRc = dec(vmrc) / 100 no-error.
     1488      end.
     1489      return OMRc.
     1490   end.
     1491   function MoveDate return Date
     1492   (idate as date,
     1493    iMonth as int64):
     1494      define variable vMonth   as int64 no-undo.
     1495      define variable vYear    as int64 no-undo.
     1496      define variable vDateNew as date  no-undo.
     1497       define variable vDay     as int64 no-undo.
     1498       vMonth = month(iDate) + iMonth.
     1499       vYear =  year(iDate).
     1500       if vMonth <= 0
     1501       then assign
     1502          vMonth = vMonth + 12
     1503           vYear  = vYear - 1
     1504       .
     1505       else if vMonth > 12
     1506       then assign
     1507          vMonth = vMonth - 12
     1508           vYear  = vYear + 1
     1509       .
     1510       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1511       do while error-status:error eq yes:
     1512          VDay = vDay + 1.
     1513          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1514       end.
     1515       if VDay > 0
     1516       then
     1517          vDateNew + 1.
     1518       return vDateNew.
     1519   end.
     1520   procedure checkEMRC:
     1521   define input  parameter iDm as character no-undo.
     1522   define output parameter vok as logical   no-undo init yes.
     1523      define variable v-value-emrc as character no-undo.
     1524      define variable v-type-emrc  as character no-undo.
     1525      define variable vDateIso     as character no-undo.
     1526      define variable vMRC         as decimal no-undo.
     1527      define variable vqnty        as decimal no-undo.
     1528      define variable vPrice       as decimal no-undo.
     1529      define variable vparent      as character no-undo.
     1530      define variable vgds-code    as integer no-undo.
     1531      define buffer code for ub.code.
     1532      vMRC = getMRCByDM(iDm).
     1533      if vMRC > 0
     1534      then do:
     1535         vgds-code = getGdsCodeByDM(iDm).
     1536         vqnty     = getQntyUTDByDM(iDm).
     1537               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1538            (
     1539             input   vgds-code
     1540            ,input   'emrc-type':U
     1541            ,output   v-value-emrc
     1542            ,output   v-type-emrc
     1543          ) no-error.
     1544          if     v-value-emrc ne ""
     1545             and v-value-emrc ne ?
     1546          then do:
     1547             vDateIso = iso-date(today).
     1548             vPrice = vMRC / vqnty.
     1549             vparent ="emc" + chr(4) + v-value-emrc.
     1550             find last code where Code.parent      eq vparent
     1551                              and Code.code        le vDateIso
     1552                              and code.status_  eq 0
     1553             no-lock no-error.
     1554             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1555             then
     1556                vOk = true .
     1557             else do:
     1558                 define variable vText      as character no-undo.
     1559                 define variable vDate      as date no-undo.
     1560                 define variable vDateLast  as character no-undo.
     1561                 define variable vDateFirst as character no-undo.
     1562                 define variable vDate3     as date no-undo.
     1563                 vdate = date(code.misc1).
     1564                 vDateLast = code.misc1.
     1565                 vDate3 = MoveDate(today, - 3 ).
     1566                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1567                                      string(vDate3  , "99/99/9999"),
     1568                                      string(vDate   , "99/99/9999")
     1569                                      ).
     1570                 vdateIso = iso-date(vdate3).
     1571                 find last code  where Code.parent      eq vparent
     1572                                   and Code.code        le vDateIso
     1573                                   and code.status_  eq 0 no-lock no-error.
     1574                 if available code
     1575                 then
     1576                    vDateIso = code.code.
     1577                 vDateFirst = vDateIso.
     1578                 vDateLast = iso-date(vdate).
     1579                 define variable vGood as logical no-undo.
     1580                 define variable vDateSale as date no-undo.
     1581                 define buffer bcode for code.
     1582                 for last code where Code.parent   eq vparent
     1583                                 and code.status_  eq 0
     1584                                 and code.code     < vDateLast
     1585                                 and code.code     >= vDateFirst
     1586                 no-lock:
     1587                    find first bcode where bCode.parent   eq vparent
     1588                                       and bcode.status_  eq 0
     1589                                       and bcode.code     > code.code no-lock no-error.
     1590                    if available bcode
     1591                    then do:
     1592                       if vPrice < dec(Code.CodeValue)
     1593                       then
     1594                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1595                                                     chr(10),
     1596                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1597                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1598                                                     ).
     1599                       else do:
     1600                          vGood = yes.
     1601                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1602                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1603                                                     chr(10),
     1604                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1605                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1606                                                     string(         vDateSale            ,"99/99/9999"),
     1607                                                     string(vDateSale - today)
     1608                                                     ).
     1609                       end.
     1610                    end.
     1611                 end.
     1612                 if vgood
     1613                 then do:
     1614                    define variable choice as integer no-undo .
     1615                    run gbl/d-askw.w (input "Уточнение"
     1616                           ,input  vText
     1617                           ,input "|"
     1618                           ,input "Принять|Вернуть"
     1619                           ,input "Принять данный товар|Вернуть товар постащику"
     1620                           ,input 1
     1621                           ,input 2
     1622                           ,output choice) no-error.
     1623                    vok = choice eq 1.
     1624                 end.
     1625                 else
     1626                    vok =false.
     1627             end.
     1628          end.
     1629      end.
     1630   end.
     1631   function addGs2Mark return character
     1632   (iMark as char):
     1633      define variable vDM   as character no-undo.
     1634      define variable vIdx  as integer   no-undo.
     1635      if index(iMark,chr(29),1) > 0
     1636      then return iMark.
     1637      if substring(iMark,26,4) = "8005" then
     1638      do:
     1639        vIdx = index(iMark,"93",26 + 4 + 5).
     1640        if vIdx > 1 then do:
     1641          vDM = substitute("&1&4&2&4&3",
     1642                           substring(iMark,1,25),
     1643                           substring(iMark,26,vIdx - 25 - 1),
     1644                           substring(iMark,vIdx),
     1645                           chr(29)) no-error.
     1646          vIdx = index(vDm,"240",vIdx + 4).
     1647          if vIdx > 0 then
     1648          do:
     1649            vDM = substitute("&1&3&2",
     1650                             substring(vDm,1,vIdx - 1),
     1651                             substring(vDm,vIdx),
     1652                             chr(29)) no-error.
     1653          end.
     1654        end.
     1655        else
     1656          vDM = substitute("&1&3&2",
     1657                           substring(iMark,1,25),
     1658                           substring(iMark,26),
     1659                           chr(29)) no-error.
     1660      end.
     1661      else if substring(iMark,32,2) = "91" then
     1662      do:
     1663        vIdx = index(iMark,"92",32).
     1664        if vIdx > 1 then
     1665          vDM = substitute("&1&4&2&4&3",
     1666                           substring(iMark,1,31),
     1667                           substring(iMark,32,vIdx - 31 - 1),
     1668                           substring(iMark,vIdx),
     1669                           chr(29)) no-error.
     1670        else
     1671          vDM = substitute("&1&3&2",
     1672                           substring(iMark,1,31),
     1673                           substring(iMark,32),
     1674                           chr(29)) no-error.
     1675      end.
     1676      else if substring(iMark,39,2) = "91" then
     1677      do:
     1678        vIdx = index(iMark,"92",38).
     1679        if vIdx > 1 then
     1680          vDM = substitute("&1&4&2&4&3",
     1681                           substring(iMark,1,38),
     1682                           substring(iMark,39,vIdx - 38 - 1),
     1683                           substring(iMark,vIdx),
     1684                           chr(29)) no-error.
     1685        else
     1686          vDM = substitute("&1&3&2",
     1687                           substring(iMark,1,38),
     1688                           substring(iMark,39),
     1689                           chr(29)) no-error.
     1690      end.
     1691      else if substring(iMark,25,2) = "93" then
     1692      do:
     1693        vIdx = index(iMark,"92",25).
     1694        if vIdx > 1 then
     1695          vDM = substitute("&1&4&2&4&3",
     1696                           substring(iMark,1,24),
     1697                           substring(iMark,25,vIdx - 24 - 1),
     1698                           substring(iMark,vIdx),
     1699                           chr(29)) no-error.
     1700        else
     1701          vIdx = index(iMark,"3103",25).
     1702          if vIdx > 0 then
     1703          vDM = substitute("&1&4&2&4&3",
     1704                           substring(iMark,1,24),
     1705                           substring(iMark,25,vIdx - 24 - 1),
     1706                           substring(iMark,vIdx),
     1707                           chr(29)) no-error.
     1708          else
     1709            vDM = substitute("&1&3&2",
     1710                             substring(iMark,1,24),
     1711                             substring(iMark,25),
     1712                             chr(29)) no-error.
     1713      end.
     1714      else if substring(iMark,32,2) = "93" then
     1715      do:
     1716        vDM = substitute("&1&3&2",
     1717              substring(iMark,1,31),
     1718              substring(iMark,32),
     1719              chr(29)) no-error.
     1720      end.
     1721      return if vDM <> "" then vDm else iMark.
     1722   end.
     1723   do
     1724   on error undo, return error
     1725   :
     1726     define variable v-ind                    as integer   no-undo .
     1727     define variable v-num-entries-db-list    as integer   no-undo .
     1728     define variable v-db-num                 as integer   no-undo .
     1729     define variable v-err-gen-pack           as integer   no-undo .
