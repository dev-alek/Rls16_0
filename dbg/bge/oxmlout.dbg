        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as widget-handle    no-undo.
        3   define input parameter p-param              as character        no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: oxmlout.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: bge/oxmlout.p $":U .
        9   define variable vss-description as character no-undo init "Экспорт в файл OpenXML".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   define new shared variable g#auto-pid           as integer   no-undo .
       73   define new shared variable conn-par             as character no-undo .
       74   define new shared variable g#auto-user-id       as character no-undo .
       75   define new shared variable g#auto-user-login    as character no-undo .
       76   define new shared variable g#auto-user-password as character no-undo .
       77   define new shared variable v-socket             as logical   no-undo .
       78   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define new shared variable auto-window-h     as handle    no-undo .
       80   define new shared variable auto-log-msg-h    as handle    no-undo .
       81   define new shared variable hand-log-msg-h    as handle    no-undo .
       82   define new shared variable log-file-name     as character no-undo initial ? .
       83   define new shared variable add-log-file-name as character no-undo initial ? .
       84   define new shared variable writelogvalue     as character no-undo initial ? .
       85   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   procedure cur-time :
       87      define output parameter p-today as date      no-undo .
       88      define output parameter p-time  as integer   no-undo .
       89     do
       90     on error undo, return error
       91     :
       92       define variable v-date1 as date      no-undo .
       93       define variable v-date2 as date      no-undo .
       94       define variable v-time  as integer   no-undo .
       95       assign
       96         v-date1 = today
       97         v-time  = time
       98         v-date2 = today
       99       .
      100       if v-date1 <> v-date2
      101       then do:
      102         assign
      103           v-date1 = today
      104           v-time  = v-time
      105         .
      106       end.
      107       assign
      108         p-today = v-date1
      109         p-time  = v-time
      110       .
      111     end.
      112   end.
      113   function cur-time-date returns character
      114   :
      115     return string(today, '99/99/9999':U) .
      116   end.
      117   function cur-time-mjd returns decimal
      118   :
      119     define variable v-date as date      no-undo .
      120     define variable v-time as integer   no-undo .
      121     run cur-time in this-procedure
      122       (output v-date
      123       ,output v-time
      124       ) .
      125     return integer(v-date) - 2400002 + (v-time / 86400) .
      126   end.
      127   function cur-time-get-ending-index returns integer
      128   (input p-number as integer
      129   )
      130   :
      131     if p-number < 0
      132     or p-number = ?
      133     then do:
      134       return 1 .
      135     end.
      136     define variable v-rest as integer   no-undo .
      137     assign
      138       p-number = p-number modulo 100
      139     .
      140     if p-number < 20
      141     then do:
      142       assign
      143         v-rest = p-number
      144       .
      145     end.
      146     else do:
      147       assign
      148         v-rest = p-number modulo 10
      149       .
      150     end.
      151     case v-rest :
      152       when 1
      153       then do:
      154         return 2 .
      155       end.
      156       when 2 or
      157       when 3 or
      158       when 4
      159       then do:
      160         return 3 .
      161       end.
      162       otherwise do:
      163         return 1 .
      164       end.
      165     end case .
      166   end.
      167   procedure cur-time-mjd-to-date :
      168      define input  parameter i-mjd-diff as decimal no-undo.
      169      define output parameter o-Date     as date    no-undo.
      170      define output parameter o-Time     as integer no-undo.
      171      define variable v-day-number as integer   no-undo .
      172      if    i-mjd-diff < 0
      173         or i-mjd-diff = ?
      174      then do:
      175         return "?" .
      176      end.
      177      assign
      178         v-day-number = truncate(i-mjd-diff,0).
      179         o-Date = date(v-day-number + 2400002).
      180         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      181     .
      182   end.
      183   function cur-time-mjd-to-string returns character
      184   (input p-mjd-diff as decimal
      185   )
      186   :
      187     define variable v-day-number as integer   no-undo .
      188     define variable v-seconds    as integer   no-undo .
      189     define variable v-hour       as integer   no-undo .
      190     define variable v-min        as integer   no-undo .
      191     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      192     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      193     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      194     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      195     if p-mjd-diff < 0
      196     or p-mjd-diff = ?
      197     then do:
      198       return "?" .
      199     end.
      200     assign
      201       v-day-number = integer(truncate(p-mjd-diff,0))
      202       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      203     .
      204     if v-seconds > 86400
      205     then do:
      206       assign
      207         v-seconds = 86400 - 1
      208       .
      209     end.
      210     if v-seconds < 0
      211     then do:
      212       assign
      213         v-seconds = 0
      214       .
      215     end.
      216     assign
      217       v-hour = truncate(v-seconds / 3600, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 3600
      221     .
      222     assign
      223       v-min = truncate(v-seconds / 60, 0)
      224     .
      225     assign
      226       v-seconds = v-seconds modulo 60
      227     .
      228     return
      229         (if v-day-number <> 0
      230           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0
      234           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      235           else ""
      236         )
      237       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      238           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      239           else ""
      240         )
      241       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      242       .
      243   end.
      244   function cur-time-string returns character
      245   :
      246     define variable v-date as date      no-undo .
      247     define variable v-time as integer   no-undo .
      248     run cur-time in this-procedure
      249       (output v-date
      250       ,output v-time
      251       ) .
      252     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      253   end.
      254   function cur-time-string-sec returns character
      255   :
      256     define variable v-date as date      no-undo .
      257     define variable v-time as integer   no-undo .
      258     run cur-time in this-procedure
      259       (output v-date
      260       ,output v-time
      261       ) .
      262     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      263   end.
      264   function cur-time-custom  returns character
      265   (input p-prefix as character
      266   ,input p-date-format as character
      267   ,input p-delimiter as character
      268   ,input p-time-format as character
      269   ,input p-suffix as character
      270   )
      271   :
      272     define variable v-date as date      no-undo .
      273     define variable v-time as integer   no-undo .
      274     run cur-time in this-procedure
      275       (output v-date
      276       ,output v-time
      277       ) .
      278     return
      279       p-prefix
      280       + string(v-date, p-date-format)
      281       + p-delimiter
      282       + string(v-time, p-time-format)
      283       + p-suffix
      284       .
      285   end.
      286   function cur-time-print  returns character
      287   :
      288     define variable v-date as date      no-undo .
      289     define variable v-time as integer   no-undo .
      290     run cur-time in this-procedure
      291       (output v-date
      292       ,output v-time
      293       ) .
      294     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      295   end.
      296   function cur-time-datetime returns datetime
      297   :
      298     define variable v-char as character no-undo .
      299     define variable v-datetime as datetime no-undo .
      300     v-char = cur-time-string().
      301     v-datetime = datetime(v-char).
      302     return  v-datetime.
      303   end.
      304   function cur-time-string-msec returns character
      305   :
      306     define variable v-date as datetime  no-undo .
      307     v-date = now.
      308     return string(v-date) .
      309   end.
      310   define stream LogStream .
      311   define variable mNoTime as logical no-undo.
      312   procedure write-to-log-notime :
      313     define input param i-str as character no-undo .
      314     mNoTime = yes.
      315     run write-to-log (i-str).
      316     mNoTime = no.
      317   end.
      318   procedure write-to-log :
      319     define input param p-str as character no-undo .
      320     do
      321     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      322     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      323     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      324     :
      325       define variable log-res        as logical   no-undo .
      326       define variable v-jj           as integer   no-undo .
      327       if    mNoTime
      328          or writelogvalue eq "AsyncProc"
      329       then
      330          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      331       else
      332          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      333       if auto-log-msg-h <> ? then do:
      334         log-res = auto-log-msg-h:move-to-eof( ) .
      335         log-res = auto-log-msg-h:insert-string( p-str ).
      336       end.
      337       if hand-log-msg-h <> ? then do:
      338         log-res = hand-log-msg-h:move-to-eof( ) .
      339         log-res = hand-log-msg-h:insert-string( p-str ).
      340       end.
      341       assign
      342         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      343         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      344         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      345       .
      346       if add-log-file-name <> ? then do:
      347         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      348           run gbl/fileapnd.p
      349             ( input entry(v-jj, add-log-file-name, chr(1) )
      350             ,input p-str
      351             ,input 20
      352             ) no-error .
      353           if error-status:error then do:
      354             return error return-value .
      355           end.
      356         end.
      357       end.
      358       if writelogvalue eq "AsyncProc"
      359       then do:
      360          p-str = trim(p-str, (chr(13) + chr(10)) )
      361       .
      362          Publish "WriteLogAsunc" (p-str,yes).
      363       end.
      364       else if writelogvalue <> "yes" then do:
      365         run gbl/fileapnd.p
      366           ( input log-file-name
      367           ,input p-str
      368           ,input 20
      369           ) no-error .
      370         if error-status:error then do:
      371           return error return-value .
      372         end.
      373       end.
      374     end.
      375   end procedure.
      376   procedure write-to-screen :
      377     define input param p-str as character no-undo .
      378     do
      379     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      380     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      381     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      382     :
      383       define variable log-res as logical no-undo.
      384       assign
      385         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      386       .
      387       if auto-log-msg-h <> ?
      388       then do:
      389         log-res = auto-log-msg-h:move-to-eof( ) .
      390         log-res = auto-log-msg-h:insert-string( p-str ).
      391       end.
      392       if hand-log-msg-h <> ?
      393       then do:
      394         log-res = hand-log-msg-h:move-to-eof( ) .
      395         log-res = hand-log-msg-h:insert-string( p-str ).
      396       end.
      397     end.
      398   end procedure.
      399   procedure send-msg-to-email :
      400     define input  parameter p-subject      as character no-undo .
      401     define input  parameter p-text-err     as character no-undo .
      402     define input  parameter p-attach-files as character no-undo .
      403     do
      404     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      405     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      406     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      407     :
      408       define variable v-tth             as handle    no-undo .
      409       define variable v-value-character as character no-undo .
      410       define variable v-value-date      as date      no-undo .
      411       define variable v-value-decimal   as decimal   no-undo .
      412       define variable v-value-integer   as integer   no-undo .
      413       define variable v-value-logical   as logical   no-undo .
      414       define variable v-param-type      as character no-undo .
      415       define variable v-email       as character no-undo .
      416       define variable v-tmp-str     as character no-undo .
      417       define variable v-tmp1-str    as character no-undo .
      418       define variable v-ind         as integer   no-undo .
      419       define variable v-num-entries as integer   no-undo .
      420       delete object v-tth no-error.
      421       run adm/shattri.p
      422         ( input "get":U
      423          ,input  "":U
      424          ,input  0
      425          ,input  'auto-task':U
      426          ,input  'send-msg-to-email':U
      427          ,output v-value-character
      428          ,output v-value-date
      429          ,output v-value-decimal
      430          ,output v-value-integer
      431          ,output v-value-logical
      432          ,output v-param-type
      433          ,input-output table-handle v-tth
      434         ) no-error .
      435       if not error-status :error  then do:
      436         assign
      437           v-tmp-str = v-value-character
      438         .
      439       end.
      440       delete object v-tth no-error.
      441       assign
      442         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      443         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      444         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      445         v-num-entries = num-entries( v-tmp-str, chr(44) )
      446         v-email       = "":U
      447       .
      448       do v-ind = 1 to v-num-entries
      449       :
      450         assign
      451           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      452         .
      453         if trim( v-tmp1-str ) <> "":U then do:
      454           if v-email = "":U then do:
      455             assign
      456               v-email = v-tmp1-str
      457             .
      458           end.
      459           else do:
      460             assign
      461               v-email = v-email + chr(44) + v-tmp1-str
      462             .
      463           end.
      464         end.
      465       end.
      466       if v-email <> "":U then do:
      467         run gbl/sendmail.p
      468           ( input v-email
      469           , input p-subject
      470           , input p-text-err
      471           , input p-attach-files
      472           ) no-error .
      473         if error-status :error
      474           or return-value <> "":U
      475         then do:
      476           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      477         end.
      478       end.
      479     end.
      480   end procedure.
      481   define new shared variable oxml-exch-dir as character no-undo .
      482   define new shared variable oxml-heap-dir as character no-undo .
      483   define variable err-mess as character no-undo .
      484   define temp-table t-pck-conf no-undo
      485     field esys-id         as integer
      486     field db-num          as integer
      487     field current-db-num  as integer
      488     field pack-num        as integer
      489     field rcvd-recs       as integer
      490     field total-recs      as integer
      491     field sys-key         as character
      492     field src_db-key      as character
      493     field ver-num         as character
      494     field prev-crc        as character
      495     field actual-date     as date
      496     field actual-time-int as integer
      497   .
      498   define variable v-cur-db-num    as integer      no-undo.
      499   define variable v-err-code as integer no-undo .
      500   define variable v-message as character no-undo .
      501   do
      502   on error undo, return error
      503   :
      504     run bge/oxml-ini.p no-error.
      505     if error-status :error then do:
      506       message
      507         vss-workfile vss-revision vss-description skip
      508         "Ошибка инициализации переменных для системы OpenXML" skip
      509         return-value
      510         view-as alert-box error.
      511       undo, return error.
      512     end.
      513   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      514   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      515     (output v-cur-db-num
      516     )  .
      517       run write-to-log ( substitute( "Подготовка новых пакетов." ) ).
      518       run bge/cnewxpck.p (
      519                         input ""
      520                       , output v-err-code
      521       ) no-error .
      522       if error-status:error
      523       then do:
      524         run write-to-log( substitute( "&1. ERROR!!! Ошибка при подготовке пакетов OpenXML &2&3&4"
      525                                       ,vss-workfile
      526                                       ,error-status:get-message(error-status:num-messages)
      527                                       ,chr(10)
      528                                       ,return-value
      529                                     )
      530                         ) .
      531       end.
      532       else do:
      533         assign
      534           v-message = return-value
      535         .
      536         if v-message <> "":U then do:
      537           run write-to-log ( substitute( "&1", v-message ) ).
      538         end.
      539         run write-to-log ( substitute( "Завершена подготовка новых пакетов." ) ).
      540       end.
      541       run str/diallog.w (
      542             input p-mainmenu-handle
      543           , input this-procedure
      544           , input "bge/oxmloutx.p":U
      545           , input substitute("all-unconf,&1", v-cur-db-num )
      546           , input no
      547           , input "&Стоп"
      548           , input "Выгрузка Open XML"
      549       ).
      550   end.
