      576   procedure xmlchar-decode :
      577   define input parameter p-in-string      as character        no-undo.
      578   define output parameter p-out-string    as character        no-undo.
      579       define variable v-position      as integer      no-undo.
      580       define variable v-last-position as integer      no-undo.
      581       define variable v-temp-integer  as integer      no-undo.
      582       define variable v-current-char  as character    no-undo.
      583       define variable v-next-char     as character    no-undo.
      584       define variable v-success       as logical      no-undo.
      585   do
      586   on error undo, return error
      587   :
      588       assign
      589           p-out-string = "":U
      590           v-position   = 0
      591       .
      592       replace-cycle:
      593       do while yes
      594       on error undo, return error
      595       :
      596           assign
      597               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      598           .
      599           if v-last-position <= v-position
      600           then do:
      601               if v-position = 0
      602               then do:
      603                   assign
      604                       p-out-string = p-in-string
      605                   .
      606               end.
      607               else do:
      608                   assign
      609                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      610                   .
      611               end.
      612               leave replace-cycle.
      613           end.
      614           else do:
      615               assign
      616                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      617                   v-position      = v-last-position
      618                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      619               .
      620               if v-current-char = "#":U
      621               then do:
      622                   assign
      623                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      624                   .
      625                   if v-last-position > 0
      626                   then do:
      627                       run xmlchar-read-integer in this-procedure
      628                        (
      629                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      630                           , output v-temp-integer
      631                           , output v-success
      632                       ).
      633                       if v-success = yes
      634                       and v-temp-integer >= 1
      635                       and v-temp-integer <= 255
      636                       then do:
      637                           assign
      638                               p-out-string = p-out-string + chr( v-temp-integer )
      639                               v-position   = v-last-position + 1
      640                           .
      641                       end.
      642                       else do:
      643                           assign
      644                               p-out-string = p-out-string + "&":U
      645                               v-position   = v-position   + 1
      646                           .
      647                       end.
      648                   end.
      649                   else do:
      650                       assign
      651                           p-out-string = p-out-string + "&":U
      652                           v-position   = v-position   + 1
      653                       .
      654                   end.
      655               end.
      656               else do:
      657                   case substring( p-in-string, v-position + 1, 3 )
      658                   :
      659                       when "lt;":U
      660                       then do:
      661                           assign
      662                               p-out-string = p-out-string + "<":U
      663                               v-position   = v-position   + 3
      664                           .
      665                       end.
      666                       when "gt;":U
      667                       then do:
      668                           assign
      669                               p-out-string = p-out-string + ">":U
      670                               v-position   = v-position   + 3
      671                           .
      672                       end.
      673                       otherwise do:
      674                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      675                           then do:
      676                               assign
      677                                   p-out-string = p-out-string + "&":U
      678                                   v-position   = v-position   + 4
      679                               .
      680                           end.
      681                           else do:
      682                               case substring( p-in-string, v-position + 1, 5 )
      683                               :
      684                                   when "quot;":U
      685                                   then do:
      686                                       assign
      687                                           p-out-string = p-out-string + '"':U
      688                                           v-position   = v-position   + 5
      689                                       .
      690                                   end.
      691                                   when "apos;":U
      692                                   then do:
      693                                       assign
      694                                           p-out-string = p-out-string + "'":U
      695                                           v-position   = v-position   + 5
      696                                       .
      697                                   end.
      698                                   otherwise do:
      699                                       assign
      700                                           p-out-string = p-out-string + "&":U
      701                                       .
      702                                   end.
      703                               end case.
      704                           end.
      705                       end.
      706                   end case.
      707               end.
      708           end.
      709       end.
      710   end.
      711   end .
      712   procedure xmlchar-read-integer :
      713   define input parameter p-input-string      as character        no-undo.
      714   define output parameter p-output-integer   as integer          no-undo.
      715   define output parameter p-success       as logical          no-undo.
      716   do
      717   on error undo, return error
      718   :
      719       assign
      720           p-output-integer = integer( p-input-string )
      721       no-error.
      722       if error-status :error
      723       then do:
      724           assign
      725               p-success           = no
      726               p-output-integer    = 0
      727           .
      728       end.
      729       else do:
      730           assign
      731               p-success           = yes
      732           .
      733       end.
      734   end.
      735   end.
      736   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      737   procedure strtdate :
      738     define input  parameter p-str         as character no-undo .
      739     define output parameter p-value       as date      no-undo .
      740     define output parameter p-data-valid  as logical   no-undo .
      741     define output parameter p-message     as character no-undo .
      742   do
      743   on error undo, return error return-value
      744   :
      745     define variable v-value       as date      no-undo .
      746     define variable v-i           as integer   no-undo .
      747     define variable v-num         as integer   no-undo .
      748     define variable v-delim       as character no-undo .
      749     define variable v-delim-list  as character no-undo .
      750     define variable v-day         as integer   no-undo .
      751     define variable v-month       as integer   no-undo .
      752     define variable v-year        as integer   no-undo .
      753     define variable v-day-str     as character no-undo .
      754     define variable v-month-str   as character no-undo .
      755     define variable v-year-str    as character no-undo .
      756     assign
      757       p-value       = ?
      758       p-data-valid  = false
      759     .
      760     if p-str = ?
      761     then do:
      762       assign
      763         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      764       .
      765       return .
      766     end.
      767     if p-str = ""
      768     then do:
      769       assign
      770         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      771       .
      772       return .
      773     end.
      774     if length(p-str)  > 10
      775     then do:
      776       assign
      777         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      778       .
      779       return .
      780     end.
      781     assign
      782       v-delim-list = '/,-,.':U
      783     .
      784     _delim:
      785     do v-i = 1 to num-entries( v-delim-list )
      786     :
      787       assign
      788         v-delim = entry( v-i , v-delim-list )
      789         v-num   = num-entries( p-str , v-delim )
      790       .
      791       if v-num <> 3
      792       then do:
      793         assign
      794           v-delim = ''
      795         .
      796       end.
      797       else do:
      798         leave _delim.
      799       end.
      800     end.
      801     if v-delim = ''
      802     then do:
      803       assign
      804         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      805       .
      806       return .
      807     end.
      808     assign
      809       v-day-str   = entry( 1, p-str , v-delim)
      810       v-month-str = entry( 2, p-str , v-delim)
      811       v-year-str  = entry( 3, p-str , v-delim)
      812     .
      813     if  length(v-day-str) > 2   or
      814         length(v-day-str) < 1   or
      815         length(v-month-str) > 2 or
      816         length(v-month-str) < 1 or
      817         (
      818           length(v-year-str) <> 2 and
      819           length(v-year-str) <> 4
      820         )
      821     then do:
      822       assign
      823         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      824       .
      825       return .
      826     end.
      827     if length( v-year-str ) = 2
      828     then do:
      829       assign
      830         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      831       .
      832     end.
      833     assign
      834       v-day   = integer( v-day-str )
      835       v-month = integer( v-month-str)
      836       v-year  = integer( v-year-str)
      837     no-error .
      838     if error-status :error
      839     then do:
      840       assign
      841         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      842       .
      843       return .
      844     end.
      845     if v-day < 1  or
      846        v-day > 31 or
      847        v-month < 1 or
      848        v-month > 12 or
      849        v-year < 0   or
      850        v-year > 5000
      851     then do:
      852       assign
      853         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      854       .
      855       return .
      856     end.
      857     assign
      858       v-value = date( v-month, v-day, v-year )
      859     no-error .
      860     if error-status :error
      861     then do:
      862       assign
      863         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      864       .
      865       return .
      866     end.
      867     assign
      868       p-value       = v-value
      869       p-data-valid  = true
      870     .
      871   end.
      872   end procedure.
