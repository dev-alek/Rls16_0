      973   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
      974                                             INPUT iFlagEmpty AS INTEGER).
      975       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
      976       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
      977           DO:
      978               IF iFlagEmpty = 0                           THEN RETURN "".
      979               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
      980               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
      981               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
      982               ELSE RETURN "".
      983           END.
      984       ELSE DO:
      985           run xmlchar-encode in this-procedure (
      986                 input sToPlace
      987               , output sToPlace
      988           ).
      989           ASSIGN
      990               sToPlace = sParName + '="' + sToPlace + '"'
      991           .
      992           RETURN sToPlace.
      993       END.
      994   END FUNCTION.
      995   function bge-xml-date returns character
      996   ( input p-date as date )
      997   :
      998     define variable v-date-str as character no-undo .
      999     run bge-xml-date-to-str in this-procedure ( input   p-date
     1000                                               , output  v-date-str
     1001                                               ) .
     1002     return v-date-str.
     1003   end function.
     1004   function bge-xml-str-date returns character
     1005   ( input p-date-str as character )
     1006   :
     1007     define variable v-date-str as character no-undo .
     1008     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1009                                                   , output  v-date-str
     1010                                                   ) .
     1011     return v-date-str.
     1012   end function.
     1013   function bge-xml-normalize-dec returns decimal
     1014   ( input p-val as decimal )
     1015   :
     1016     return (if p-val = ? then 0 else p-val) .
     1017   end function.
     1018   PROCEDURE wp-XMLTagOpen:
     1019   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1020   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1021   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1022       define variable v-out-string    as character    no-undo.
     1023   do
     1024   on error undo, return error
     1025   :
     1026       if v-bge-xml-bgefmt = "dbf":U
     1027       then do:
     1028       end.
     1029       else do:
     1030           assign
     1031               v-out-string = substitute( "&1&2<&3&4>"
     1032                                       , chr(10)
     1033                                       , fill( " ":U, 4 * iTagLevel)
     1034                                       , sTagName
     1035                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1036                               )
     1037           .
     1038           put stream stmXMLOut unformatted
     1039               v-out-string
     1040           .
     1041       end.
     1042   end.
     1043   END PROCEDURE.
     1044   PROCEDURE wp-XMLTagPut:
     1045     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1046     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1047     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1048     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1049       define variable v-out-string    as character    no-undo.
     1050   do
     1051   on error undo, return error
     1052   :
     1053       if v-bge-xml-bgefmt = "dbf":U
     1054       then do:
     1055           if v-bge-xml-dbf-file-name <> "":U
     1056           then do:
     1057               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1058               export stream stmXMLOut
     1059                   sTagName
     1060                   sParValue
     1061               .
     1062               output stream stmXMLOut close.
     1063           end.
     1064       end.
     1065       else do:
     1066           IF  iFlagEmpty = 1
     1067           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1068           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1069           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1070           THEN DO:
     1071               run xmlchar-encode in this-procedure (
     1072                   input sParValue
     1073                   , output sParValue
     1074               ).
     1075               assign
     1076                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1077                                               , chr(10)
     1078                                               , FILL(" ", 4 * iTagLevel)
     1079                                               , sTagName
     1080                                               , sParValue
     1081                               )
     1082               .
     1083               PUT STREAM stmXMLOut UNFORMATTED
     1084                   v-out-string
     1085               .
     1086           END.
     1087       end.
     1088   end.
     1089   END PROCEDURE.
     1090   PROCEDURE wp-XMLTagClose:
     1091   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1092   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1093       define variable v-out-string    as character    no-undo.
     1094   do
     1095   on error undo, return error
     1096   :
     1097       if v-bge-xml-bgefmt = "dbf":U
     1098       then do:
     1099       end.
     1100       else do:
     1101           assign
     1102               v-out-string = substitute( "&1&2</&3>"
     1103                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1104                                   , fill( " ", 4 * iTagLevel )
     1105                                   , sTagName
     1106                           )
     1107           .
     1108           PUT STREAM stmXMLOut UNFORMATTED
     1109               v-out-string
     1110           .
     1111       end.
     1112   end.
     1113   END PROCEDURE.
     1114   PROCEDURE wp-XMLWriteLog:
     1115     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1116     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1117     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1118   define variable v-str              as character no-undo .
     1119   define variable v-error-append     as logical   no-undo .
     1120   define variable v-error-append-msg as character no-undo .
     1121   assign
     1122     v-str = chr(10)
     1123             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1124             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1125     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1126     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1127     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1128   .
     1129   run bge/bge-log.p (input v-str) no-error .
     1130   if error-status:error then do:
     1131     assign
     1132       v-error-append     = yes
     1133       v-error-append-msg = return-value
     1134     .
     1135   end.
     1136   run gbl/fileapnd.p
     1137     ( input sFileName
     1138     , input v-str
     1139     , input 10
     1140     ) no-error .
     1141   if error-status:error then do:
     1142     assign
     1143       v-error-append     = yes
     1144       v-error-append-msg = substitute( "&1&2&3"
     1145                                       , v-error-append-msg
     1146                                       , chr(10)
     1147                                       , return-value
     1148                                       )
     1149     .
     1150   end.
     1151   if v-error-append
     1152   then do:
     1153     return error substitute( "&1" , v-error-append-msg ) .
     1154   end.
     1155   END PROCEDURE.
     1156   PROCEDURE wp-XMLWriteEDT:
     1157     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1158     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1159     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1160       if valid-handle ( hEDT )
     1161       then do:
     1162           hEDT :move-to-eof().
     1163           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1164                                           OR sToWrite = "&Line") THEN "" ELSE
     1165                                           cur-time-string-sec() + " ").
     1166           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1167                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1168                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1169           hEDT :insert-string(chr(10)).
     1170       end.
     1171       process events.
     1172       output to 'bgescn.txt' append.
     1173           put unformatted
     1174               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1175                                           OR sToWrite = "&Line") THEN "" ELSE
     1176                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1177               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1178                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1179                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1180           .
     1181       output close.
     1182   END PROCEDURE.
     1183   PROCEDURE wp-XMLShowCNT:
     1184     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1185       if valid-handle( hCNT )
     1186       then do:
     1187           ASSIGN hCNT :VISIBLE = TRUE.
     1188       end.
     1189   END PROCEDURE.
     1190   PROCEDURE wp-XMLHideCNT:
     1191     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1192       if valid-handle( hCNT )
     1193       then do:
     1194           ASSIGN hCNT :VISIBLE = FALSE.
     1195       end.
     1196   END PROCEDURE.
     1197   PROCEDURE wp-XMLWriteCNT:
     1198     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1199     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1200       if valid-handle( hCNT )
     1201       then do:
     1202           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1203       end.
     1204   END PROCEDURE.
     1205   procedure bge-xml-write-header:
     1206   do
     1207   on error undo, return error
     1208   :
     1209   define input parameter p-xml-file-name  as character        no-undo.
     1210   define input parameter p-doc-name       as character        no-undo.
     1211   define input parameter p-version        as character        no-undo.
     1212   define input parameter p-db-num         as integer          no-undo.
     1213   define input parameter p-date-from      as date             no-undo.
     1214   define input parameter p-shift-num-from as integer          no-undo.
     1215   define input parameter p-date-to        as date             no-undo.
     1216   define input parameter p-shift-num-to   as integer          no-undo.
     1217   define input parameter p-obj-list       as character        no-undo.
     1218   define input parameter p-doc-type-list  as character        no-undo.
     1219   define input parameter p-pay-code       as logical          no-undo.
     1220   define input parameter p-cst            as logical          no-undo.
     1221   define input parameter p-parts          as logical          no-undo.
     1222   define input parameter p-chk-pay-code   as logical          no-undo.
     1223   define input parameter p-pay-desk       as logical          no-undo.
     1224   define input parameter p-pay-desk-cards as logical          no-undo.
     1225   define input parameter p-deleted        as logical          no-undo.
     1226   define input parameter p-opened-docs    as logical          no-undo.
     1227   define variable v-out-string    as character    no-undo.
     1228   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1229   assign
     1230       v-out-string = substitute( "&1&2&3"
     1231                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1232                           , chr(10)
     1233                           , "<IBS_Trade_House>":U )
     1234   .
     1235   put stream stmXMLOut unformatted
     1236       v-out-string
     1237   .
     1238   run wp-XMLTagOpen(1, "header","").
     1239   if v-bge-xml-bgeflold = "oracle":u
     1240   then do:
     1241     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1242     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1243     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1244     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1245     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1246   end.
     1247   run wp-XMLTagOpen( 2, "manifest", "").
     1248   run wp-XMLTagOpen( 3, "document", "").
     1249   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1250   run wp-XMLTagput( 4, "description", "", 0).
     1251   run wp-XMLTagput( 4, "version", p-version, 0).
     1252   run wp-XMLTagclose( 3, "document" ).
     1253   run wp-XMLTagclose( 2, "manifest" ).
     1254   run wp-XMLTagclose( 1, "header" ).
     1255   run wp-XMLTagOpen(1, "options","").
     1256   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1257   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1258   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1259   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1260   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1261   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1262   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1263   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1264   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1265   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1266   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1267   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1268   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1269   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1270   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1271   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1272   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1273   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1274   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1275   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1276   run wp-XMLTagClose(1, "options").
     1277   run wp-XMLTagOpen( 1, "body", "" ).
     1278   output stream stmXMLOut close.
     1279   end.
     1280   end procedure.
     1281   procedure xml-bge-write-footer:
     1282   do
     1283   on error undo, return error return-value
     1284   :
     1285   define input parameter p-xml-file-name as character    no-undo.
     1286   define variable v-error-num     as integer           no-undo.
     1287   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1288   run wp-XMLTagClose( 1, "body" ).
     1289   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1290   output stream stmXMLOut close.
     1291   if v-bge-xml-bgeflold = "oracle":u
     1292   then do:
     1293     define variable v-tmp-file-name         as character no-undo .
     1294     define variable v-zip-file-name         as character no-undo .
     1295     define variable v-exch-file-name        as character no-undo .
     1296     define variable v-heap-file-name        as character no-undo .
     1297     define variable v-i                     as integer   no-undo .
     1298     define variable v-file-name             as character no-undo .
     1299     define variable v-arc                   as character no-undo .
     1300     define variable v-str                   as character no-undo .
     1301     define variable v-exch-tmp-file-name    as character no-undo .
     1302     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1303     define variable v-bge-xml-exch-dir      as character no-undo .
     1304     define variable v-bge-xml-heap-dir      as character no-undo .
     1305     define variable v-bge-xml-compress-heap as logical   no-undo .
     1306     define variable v-home-dir              as character no-undo .
     1307     define variable v-os-command            as character no-undo .
     1308     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1309     if v-home-dir = ?
     1310     then do:
     1311       undo, return error substitute( "&1&2&3"
     1312                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1313                                     , chr(10)
     1314                                     , "Обратитесь к администратору.":u
     1315                                     ).
     1316     end.
     1317     assign
     1318       v-home-dir = v-home-dir
     1319     .
     1320     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1321     if error-status :error
     1322     then do:
     1323       undo, return error substitute( "&1&2&3"
     1324                                     , "Неверно задан каталог экспорта.":u
     1325                                     , chr(10)
     1326                                     , "Обратитесь к администратору.":u
     1327                                     ).
     1328     end.
     1329     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1330     if v-bge-xml-exch-dir = ?
     1331     then do:
     1332       undo, return error substitute( "&1&2&3"
     1333                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1334                                     , chr(10)
     1335                                     , "Обратитесь к администратору.":u
     1336                                     ).
     1337     end.
     1338     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1339     if error-status :error
     1340     then do:
     1341       undo, return error substitute( "&1&2&3"
     1342                                     , "Неверно задан каталог экспорта (exch).":u
     1343                                     , chr(10)
     1344                                     , "Обратитесь к администратору.":u
     1345                                     ).
     1346     end.
     1347     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1348     if v-bge-xml-heap-dir = ?
     1349     then do:
     1350       undo, return error substitute( "&1&2&3"
     1351                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1352                                     , chr(10)
     1353                                     , "Обратитесь к администратору.":u
     1354                                     ).
     1355     end.
     1356     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1357     if error-status :error
     1358     then do:
     1359       undo, return error substitute( "&1&2&3"
     1360                                     , "Неверно задан каталог экспорта (heap).":u
     1361                                     , chr(10)
     1362                                     , "Обратитесь к администратору.":u
     1363                                     ).
     1364     end.
     1365     get-key-value section "BGE" key "heap-compress" value v-str.
     1366     assign
     1367       v-i = int(v-str)
     1368     no-error .
     1369     if v-i = ? or v-i = 0
     1370     then do:
     1371       assign
     1372         v-bge-xml-compress-heap = no
     1373       .
     1374     end.
     1375     else do:
     1376       assign
     1377         v-bge-xml-compress-heap = yes
     1378       .
     1379     end.
     1380     assign
     1381       v-arc = search( "exe/7za.exe":u )
     1382     .
     1383     if v-arc = ? or v-arc = ""
     1384     then do:
     1385       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1386     end.
     1387     assign
     1388       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1389       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1390       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1391       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1392       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1393       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1394       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1395     .
     1396     run gbl/del-file.p (input v-tmp-file-name) .
     1397     run gbl/del-file.p (input v-zip-file-name) .
     1398     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1399     if v-error-num > 0
     1400     then do:
     1401         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1402                                      , p-xml-file-name + "xm1":u
     1403                                      , v-tmp-file-name
     1404                                      , v-error-num
     1405                                      ).
     1406     end.
     1407     assign
     1408       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1409                                    , v-arc
     1410                                    , v-zip-file-name
     1411                                    , v-tmp-file-name
     1412                                    )
     1413     .
     1414     os-command silent value ( v-os-command ) .
     1415     run gbl/del-file.p (input v-heap-file-name) .
     1416     if v-bge-xml-compress-heap = no
     1417     then do:
     1418       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1419       if v-error-num > 0
     1420       then do:
     1421           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1422                                        , v-tmp-file-name
     1423                                        , v-heap-file-name
     1424                                        , v-error-num
     1425                                        ) .
     1426       end.
     1427     end.
     1428     else do:
     1429       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1430       if v-error-num > 0
     1431       then do:
     1432           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1433                                        , v-zip-file-name
     1434                                        , v-heap-file-name
     1435                                        , v-error-num
     1436                                        ) .
     1437       end.
     1438     end.
     1439     run gbl/del-file.p (input v-tmp-file-name) .
     1440     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1441     if error-status :error then do:
     1442       undo, return error substitute( "&1&2&3"
     1443                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1444                                     , chr(10)
     1445                                     , "Обратитесь к администратору."
     1446                                     ).
     1447     end.
     1448     run gbl/del-file.p (input v-exch-file-name) .
     1449     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1450     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1451     if v-error-num > 0
     1452     then do:
     1453       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1454                                     , v-zip-file-name
     1455                                     , v-exch-tmp-file-name
     1456                                     , v-error-num
     1457                                     ) .
     1458     end.
     1459     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1460     if v-error-num > 0
     1461     then do:
     1462       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1463                                     , v-exch-tmp-file-name
     1464                                     , v-exch-file-name
     1465                                     , v-error-num
     1466                                     ) .
     1467     end.
     1468     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1469   end.
     1470   else do:
     1471     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1472     if v-error-num > 0
     1473     then do:
     1474       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1475                                     , p-xml-file-name + "xm1"
     1476                                     , p-xml-file-name + "xml"
     1477                                     , v-error-num
     1478                                     ) .
     1479     end.
     1480   end.
     1481   if opsys = "unix"
     1482   then do:
     1483       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1484   end.
     1485   end.
     1486   end procedure.
     1487   procedure xml-bge-filename0:
     1488   define input parameter p-prefix   as character no-undo .
     1489   define input parameter p-name     as character no-undo .
     1490   define input parameter p-shared-process as logical no-undo .
     1491   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1492   define output parameter p-xml-file-name  as character no-undo .
     1493   // define output parameter p-fullfnamenoext as character no-undo .
     1494   define output parameter p-locked         as logical      no-undo.
     1495   define variable v-fullfnamenoext as character no-undo .
     1496   define variable v-fileext        as character no-undo .
     1497   define variable v-fullfname      as character no-undo .
     1498   define variable v-error-num      as integer   no-undo .
     1499   do
     1500   on error undo, return error
     1501   :
     1502     case v-bge-xml-bgeflold :
     1503       when "old" then do:
     1504         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1505         v-fileext       = ".xml":U .
     1506         v-fullfname     = v-fullfnamenoext + v-fileext .
     1507         p-xml-file-name = v-fullfname .
     1508         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1509         if v-error-num > 0 then do:
     1510           return error.
     1511         end.
     1512       end.
     1513       when "var" then do:
     1514         case p-prefix :
     1515           when "doc" then do:
     1516             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1517             v-fileext       = ".xml":U .
     1518             v-fullfname     = v-fullfnamenoext + v-fileext .
     1519             p-xml-file-name = v-fullfname .
     1520           end.
     1521           when "day" then do:
     1522             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1523             v-fileext       = ".xml":U .
     1524             v-fullfname     = v-fullfnamenoext + v-fileext .
     1525             p-xml-file-name = v-fullfname .
     1526           end.
     1527           otherwise do:
     1528             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1529             v-fileext       = ".xml":U .
     1530             v-fullfname     = v-fullfnamenoext + v-fileext .
     1531             p-xml-file-name = v-fullfname .
     1532           end.
     1533         end case.
     1534         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1535         if v-error-num > 0 then do:
     1536           return error.
     1537         end.
     1538       end.
     1539       when "new" then do:
     1540                   run bge/genfname.p (
     1541                       input p-home-dir
     1542                       , input p-prefix
     1543                       , input ""
     1544                       , input "xml"
     1545                       , input ""
     1546                       , output p-xml-file-name
     1547                   ).
     1548       end.
     1549       when "no-parameter" then do:
     1550         if p-shared-process then do:
     1551                       run bge/genfname.p (
     1552                           input p-home-dir
     1553                           , input "d"
     1554                           , input ""
     1555                           , input "xml"
     1556                           , input ""
     1557                           , output p-xml-file-name
     1558                       ).
     1559         end.
     1560         else do:
     1561           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1562           v-fileext       = ".xml":U .
     1563           v-fullfname     = v-fullfnamenoext + v-fileext .
     1564           p-xml-file-name = v-fullfname .
     1565           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1566           if v-error-num > 0 then do:
     1567             return error.
     1568           end.
     1569         end.
     1570       end.
     1571     end case.
     1572     assign
     1573       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1574       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1575     .
     1576   end .
     1577   end procedure .
     1578   procedure xml-bge-filename :
     1579   do
     1580   on error undo, return error
     1581   :
     1582   define input parameter p-prefix             as character    no-undo.
     1583   define input parameter p-name               as character    no-undo.
     1584   define input parameter p-shared-process     as logical      no-undo.
     1585   define output parameter p-xml-file-name     as character    no-undo.
     1586   define output parameter p-log-file-name     as character    no-undo.
     1587   define output parameter p-locked            as logical      no-undo.
     1588   define variable v-home-dir          as character no-undo .
     1589   define variable v-error-num         as integer   no-undo .
     1590   define variable v-bge-xml-heap-dir  as character no-undo .
     1591       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1592       if v-home-dir = ?
     1593       then do:
     1594           message
     1595             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1596             skip(1)
     1597             skip "Обратитесь к администратору."
     1598           view-as alert-box error.
     1599           undo, return error .
     1600       end.
     1601       if v-bge-xml-bgeflold <> "oracle"
     1602       then do:
     1603         assign
     1604             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1605         .
     1606       end.
     1607       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1608       if error-status :error
     1609       then do:
     1610           message
     1611             skip "Неверно задан каталог экспорта."
     1612             skip(1)
     1613             skip "Обратитесь к администратору."
     1614           view-as alert-box error.
     1615           undo, return error .
     1616       end.
     1617       if v-bge-xml-bgefmt = "dbf":U
     1618       then do:
     1619           assign
     1620               p-xml-file-name = v-home-dir
     1621               p-locked        = no
     1622           .
     1623       end.
     1624       else do:
     1625           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1626             output p-xml-file-name, output p-locked) .
     1627       end.
     1628       if v-bge-xml-bgeflold = "oracle"
     1629       then do:
     1630         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1631         if v-bge-xml-heap-dir = ?
     1632         then do:
     1633           undo, return error substitute( "&1&2&3"
     1634                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1635                                         , chr(10)
     1636                                         , "Обратитесь к администратору.":u
     1637                                         ).
     1638         end.
     1639         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1640         if error-status :error
     1641         then do:
     1642           undo, return error substitute( "&1&2&3"
     1643                                         , "Неверно задан каталог экспорта (heap).":u
     1644                                         , chr(10)
     1645                                         , "Обратитесь к администратору.":u
     1646                                         ).
     1647         end.
     1648         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1649           assign
     1650             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1651           .
     1652         end.
     1653         else do:
     1654           assign
     1655             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1656           .
     1657         end.
     1658       end.
     1659       else do:
     1660         assign
     1661             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1662         .
     1663       end.
     1664       assign
     1665          v-bge-xml-static-log-file-name = p-log-file-name
     1666       .
     1667   end.
     1668   end procedure.
     1669   procedure bge-xml-read-config :
     1670   do
     1671   on error undo, return error return-value
     1672   :
     1673   define input  parameter p-last-date as date      no-undo .
     1674   define input  parameter p-db-num    as integer   no-undo .
     1675       define variable v-bgeclall      as character     no-undo.
     1676       define variable v-bgedict       as character     no-undo.
     1677       define variable v-bgeshift      as character     no-undo.
     1678       define variable v-par-type      as character     no-undo.
     1679       define variable v-bgeflnm       as character     no-undo.
     1680       define variable v-bgecliiv      as character     no-undo .
     1681       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1682       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1683       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1684       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1685       define variable v-db-num-str    as character     no-undo .
     1686       define variable v-param-type      as character  no-undo .
     1687       define variable v-value-character as character  no-undo .
     1688       define variable v-value-date      as date       no-undo .
     1689       define variable v-value-decimal   as decimal    no-undo .
     1690       define variable v-value-integer   as integer    no-undo .
     1691       define variable v-value-logical   as logical    no-undo .
     1692       define variable v-tth             as handle      no-undo .
     1693       run adm/shattri.p ( input "get":U
     1694                         , input  '':u
     1695                         , input  0
     1696                         , input  'bge-export':U
     1697                         , input  'bgeclall':U
     1698                         , output v-bgecliiv
     1699                         , output v-value-date
     1700                         , output v-value-decimal
     1701                         , output v-value-integer
     1702                         , output v-value-logical
     1703                         , output v-param-type
     1704                         , input-output table-handle v-tth
     1705                         ) no-error .
     1706       if error-status :error
     1707       then do:
     1708         assign
     1709           v-bge-xml-bgecliiv = no
     1710         .
     1711       end.
     1712       else do:
     1713         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1714       end.
     1715       delete object v-tth.
     1716       assign
     1717           v-bge-xml-bgeclall = no
     1718           v-bge-xml-bgedict  = no
     1719       .
     1720       run adm/shattri.p ( input "get":U
     1721                         , input  '':u
     1722                         , input  0
     1723                         , input  'bge-export':U
     1724                         , input  'bgeclall':U
     1725                         , output v-value-character
     1726                         , output v-value-date
     1727                         , output v-value-decimal
     1728                         , output v-value-integer
     1729                         , output v-value-logical
     1730                         , output v-param-type
     1731                         , input-output table-handle v-tth
     1732                         ) no-error .
     1733       if error-status :error
     1734       then do:
     1735         assign
     1736           v-bge-xml-bgeclall = no
     1737         .
     1738       end.
     1739       else do:
     1740         assign
     1741           v-bge-xml-bgeclall = v-value-logical
     1742         .
     1743       end.
     1744       delete object v-tth.
     1745       run adm/shattri.p ( input "get":U
     1746                         , input  '':u
     1747                         , input  0
     1748                         , input  'bge-export':U
     1749                         , input  'bgedict':U
     1750                         , output v-value-character
     1751                         , output v-value-date
     1752                         , output v-value-decimal
     1753                         , output v-value-integer
     1754                         , output v-value-logical
     1755                         , output v-param-type
     1756                         , input-output table-handle v-tth
     1757                         ) no-error .
     1758       if error-status :error
     1759       then do:
     1760         assign
     1761           v-bge-xml-bgedict = no
     1762         .
     1763       end.
     1764       else do:
     1765         assign
     1766           v-bge-xml-bgedict = v-value-logical
     1767         .
     1768       end.
     1769       delete object v-tth.
     1770       run adm/shattri.p ( input "get":U
     1771                         , input  '':u
     1772                         , input  0
     1773                         , input  'bge-export':U
     1774                         , input  'bgefmt':U
     1775                         , output v-value-character
     1776                         , output v-value-date
     1777                         , output v-value-decimal
     1778                         , output v-value-integer
     1779                         , output v-value-logical
     1780                         , output v-param-type
     1781                         , input-output table-handle v-tth
     1782                         ) no-error .
     1783       if error-status :error
     1784       then do:
     1785         assign
     1786           v-bge-xml-bgefmt  = "xml":U
     1787         .
     1788       end.
     1789       else do:
     1790         assign
     1791           v-bge-xml-bgefmt  = v-value-character
     1792         .
     1793       end.
     1794       delete object v-tth.
     1795       run adm/shattri.p ( input "get":U
     1796                         , input  '':u
     1797                         , input  0
     1798                         , input  'bge-export':U
     1799                         , input  'bgeshift':U
     1800                         , output v-value-character
     1801                         , output v-value-date
     1802                         , output v-value-decimal
     1803                         , output v-value-integer
     1804                         , output v-value-logical
     1805                         , output v-param-type
     1806                         , input-output table-handle v-tth
     1807                         ) no-error .
     1808       if error-status :error
     1809       then do:
     1810         assign
     1811             v-bge-xml-shift-mode = no
     1812         .
     1813       end.
     1814       else do:
     1815         assign
     1816             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1817         .
     1818       end.
     1819       delete object v-tth.
     1820       run adm/shattri.p ( input "get":U
     1821                         , input  '':u
     1822                         , input  0
     1823                         , input  'bge-export':U
     1824                         , input  'bgeflold':U
     1825                         , output v-value-character
     1826                         , output v-value-date
     1827                         , output v-value-decimal
     1828                         , output v-value-integer
     1829                         , output v-value-logical
     1830                         , output v-param-type
     1831                         , input-output table-handle v-tth
     1832                         ) no-error .
     1833       if error-status :error
     1834       then do:
     1835         assign
     1836           v-bge-xml-bgeflold = "no-parameter":U
     1837         .
     1838       end.
     1839       else do:
     1840         assign
     1841           v-bge-xml-bgeflold  = v-value-character
     1842         .
     1843       end.
     1844       delete object v-tth.
     1845       assign
     1846         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1847         v-bge-xml-db-num-str  = v-db-num-str
     1848       .
     1849       if p-last-date <> ?
     1850       then do:
     1851           run adm/shattri.p ( input "get":U
     1852                             , input  '':u
     1853                             , input  0
     1854                             , input  'bge-export':U
     1855                             , input  'bgeflnm':U
     1856                             , output v-value-character
     1857                             , output v-value-date
     1858                             , output v-value-decimal
     1859                             , output v-value-integer
     1860                             , output v-value-logical
     1861                             , output v-param-type
     1862                             , input-output table-handle v-tth
     1863                             ) no-error .
     1864           if error-status :error
     1865           then do:
     1866             assign
     1867               v-bgeflnm = '':U
     1868             .
     1869           end.
     1870           else do:
     1871             assign
     1872               v-bgeflnm = v-value-character
     1873             .
     1874           end.
     1875           delete object v-tth.
     1876           if v-bge-xml-bgeflold = "var"
     1877           then do:
     1878               if v-bgeflnm = ?
     1879               or num-entries( v-bgeflnm ) < 2
     1880               then do:
     1881                   assign
     1882                       v-bge-xml-bgeflold = "new"
     1883                   .
     1884               end.
     1885               else do:
     1886                   assign
     1887                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1888                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1889                   .
     1890                   assign
     1891                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1892                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1893                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1894                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1895                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1896                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1897                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1898                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1899                   .
     1900               end.
     1901           end.
     1902       end.
     1903   end.
     1904   end procedure.
     1905   procedure bge-xml-get-ref-filename :
     1906   define input parameter p-in-file-name       as character        no-undo.
     1907   define output parameter p-home-dir          as character        no-undo.
     1908   define output parameter p-out-file-name     as character        no-undo.
     1909   define output parameter p-locked            as logical          no-undo.
     1910       define variable v-counter       as integer      no-undo.
     1911       define variable v-error-level   as integer      no-undo.
     1912   do
     1913   on error undo, return error
     1914   :
     1915       run bge/bge-ini.p (
     1916             input "bge"
     1917           , output p-home-dir
     1918       ).
     1919       if return-value <> "OK"
     1920       then do:
     1921           undo, return error.
     1922       end.
     1923       assign
     1924           p-home-dir = p-home-dir + "\dict":U
     1925       .
     1926       run bge/dir_cd.p (
     1927           input p-home-dir
     1928           , input "CA"
     1929       ).
     1930       if return-value = "ERROR"
     1931       then do:
     1932           undo, return error.
     1933       end.
     1934       assign
     1935           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     1936       .
     1937       assign
     1938           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     1939       .
     1940       wait-lock:
     1941       do v-counter = 1 TO 3
     1942       :
     1943           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     1944           if p-locked = no
     1945           then do:
     1946               leave wait-lock.
     1947           end.
     1948           else do:
     1949               readkey pause 1.
     1950           end.
     1951       END.
     1952       if p-locked = yes
     1953       then do:
     1954           undo, return error.
     1955       end.
     1956       run bge/os_copy.p (
     1957             input "D":U
     1958           , input p-out-file-name + "xml":U
     1959           , input "":U
     1960           , output v-error-level
     1961       ).
     1962       if v-error-level > 0
     1963       then do:
     1964           undo, return error.
     1965       end.
     1966   end.
     1967   end procedure.
     1968   procedure bge-xml-write-ref-header :
     1969   define input parameter p-bge-name as character        no-undo.
     1970   define input parameter p-file-name as character        no-undo.
     1971       define variable v-out-string    as character    no-undo.
     1972   do
     1973   on error undo, return error
     1974   :
     1975       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     1976       put stream stmXMLOut unformatted
     1977           "<?xml version='1.0' encoding='windows-1251'?>":U
     1978       .
     1979       assign
     1980           v-out-string = substitute( "&1&2"
     1981                               , chr(10)
     1982                               , "<IBS_Trade_House>":U )
     1983       .
     1984       put stream stmXMLOut unformatted
     1985           v-out-string
     1986       .
     1987       run wp-XMLTagOpen( 1, "header", "" ).
     1988       if v-bge-xml-bgeflold = "oracle":u
     1989       then do:
     1990         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1991         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1992         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1993         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1994         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1995       end.
     1996       else do:
     1997         run wp-XMLTagOpen( 2, "delivery", "" ).
     1998         run wp-XMLTagOpen( 3, "to", "" ).
     1999         run wp-XMLTagClose( 3, "to" ).
     2000         run wp-XMLTagOpen( 3, "from", "" ).
     2001         run wp-XMLTagClose( 3, "from" ).
     2002         run wp-XMLTagClose( 2, "delivery" ).
     2003       end.
     2004       run wp-XMLTagOpen( 2, "manifest", "" ).
     2005       run wp-XMLTagOpen( 3, "document", "" ).
     2006       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2007       run wp-XMLTagPut( 4, "description", "", 0 ).
     2008       run wp-XMLTagClose( 3, "document" ).
     2009       run wp-XMLTagClose( 2, "manifest" ).
     2010       run wp-XMLTagClose( 1, "header" ).
     2011       run wp-XMLTagOpen( 1, "body", "" ).
     2012   end.
     2013   end procedure.
     2014   procedure bge-xml-write-ref-footer :
     2015   define input parameter p-file-name as character        no-undo.
     2016       define variable v-error-level   as integer      no-undo.
     2017   do
     2018   on error undo, return error
     2019   :
     2020       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2021       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2022       output stream stmXMLOut close.
     2023       run bge/os_copy.p (
     2024             input "M":U
     2025           , input p-file-name + "xm1":U
     2026           , input p-file-name + "xml":U
     2027           , output v-error-level
     2028       ).
     2029       if v-error-level > 0
     2030       then do:
     2031           undo, return error.
     2032       end.
     2033   end.
     2034   end procedure.
     2035   procedure bge-xml-out-dir :
     2036   define output parameter p-out-dir       as character    no-undo.
     2037   define output parameter p-log-file-name as character    no-undo.
     2038   do
     2039   on error undo, return error
     2040   :
     2041       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2042       if p-out-dir = ?
     2043       then do:
     2044           message
     2045             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2046                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2047             skip(1)
     2048             skip "Обратитесь к администратору."
     2049           view-as alert-box error.
     2050           undo, return error .
     2051       end.
     2052       if v-bge-xml-bgeflold <> "oracle" then assign
     2053         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2054       .
     2055       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2056       if error-status :error  then do:
     2057           run wp-XMLWriteLog in this-procedure (
     2058                 input p-log-file-name
     2059               , input 0
     2060               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2061                                   , p-out-dir
     2062                                   , return-value
     2063                                   , trim( error-status :get-message( 1 ) )
     2064                                   )
     2065           ).
     2066           undo, return error.
     2067       end.
     2068       assign
     2069           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2070           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2071       .
     2072   end.
     2073   end procedure.
     2074   procedure bge-xml-out-dir2 :
     2075   define output parameter p-out-dir       as character    no-undo.
     2076   define output parameter p-out-dirR      as character    no-undo.
     2077   define output parameter p-log-file-name as character    no-undo.
     2078   do
     2079   on error undo, return error
     2080   :
     2081       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2082       if p-out-dir = ?
     2083       then do:
     2084           message
     2085             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2086                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2087             skip(1)
     2088             skip "Обратитесь к администратору."
     2089           view-as alert-box error.
     2090           undo, return error .
     2091       end.
     2092       if v-bge-xml-bgeflold <> "oracle" then assign
     2093             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2094             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2095         .
     2096       else p-out-dirR = p-out-dir .
     2097       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2098       if error-status :error  then do:
     2099           run wp-XMLWriteLog in this-procedure (
     2100                 input p-log-file-name
     2101               , input 0
     2102               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2103                                   , p-out-dir
     2104                                   , return-value
     2105                                   , error-status :get-message( 1 )
     2106                                   )
     2107           ).
     2108           undo, return error.
     2109       end.
     2110       if p-out-dirR <> p-out-dir then do:
     2111         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2112         if error-status :error then do:
     2113           run wp-XMLWriteLog in this-procedure (
     2114                 input p-log-file-name
     2115               , input 0
     2116               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2117                                   , p-out-dirR
     2118                                   , return-value
     2119                                   , error-status :get-message( 1 )
     2120                                   )
     2121           ).
     2122           p-out-dirR = p-out-dir .
     2123         end.
     2124       end .
     2125       assign
     2126         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2127         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2128       .
     2129   end.
     2130   end procedure.
     2131   procedure bge-xml-out-file :
     2132   do
     2133   on error undo, return error
     2134   :
     2135   define input parameter p-out-dir            as character        no-undo.
     2136   define input parameter p-prefix             as character        no-undo.
     2137   define input parameter p-sheduled           as logical          no-undo.
     2138   define output parameter p-xml-file-name     as character        no-undo.
     2139   define output parameter p-locked            as logical          no-undo.
     2140   define variable v-home-dir      as character     no-undo.
     2141   define variable v-error-num     as integer       no-undo.
     2142   define variable v-today             as date         no-undo.
     2143   define variable v-time              as integer      no-undo.
     2144       if v-bge-xml-bgefmt = "dbf":U
     2145       then do:
     2146           assign
     2147               p-xml-file-name = p-out-dir
     2148               p-locked        = no
     2149           .
     2150       end.
     2151       else do:
     2152           if v-bge-xml-bgeflold = "firm":U
     2153           then do:
     2154               run bge/genfname.p (
     2155                     input p-out-dir
     2156                   , input p-prefix
     2157                   , input "":U
     2158                   , input "arj":U
     2159                   , input "":U
     2160                   , output p-xml-file-name
     2161               ).
     2162           end.
     2163           else do:
     2164               run bge/genfname.p (
     2165                     input p-out-dir
     2166                   , input p-prefix
     2167                   , input "":U
     2168                   , input "xml":U
     2169                   , input "":U
     2170                   , output p-xml-file-name
     2171               ).
     2172           end.
     2173           assign
     2174               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2175               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2176           .
     2177       end.
     2178   end.
     2179   end procedure.
     2180   procedure bge-xml-init-ext-doc-type :
     2181       define variable v-counter    as integer      no-undo.
     2182       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2183   do
     2184   for buf_temp_ext-doc-type
     2185   on error undo, return error
     2186   :
     2187       empty temp-table buf_temp_ext-doc-type.
     2188       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2189       :
     2190           create buf_temp_ext-doc-type.
     2191           assign
     2192               buf_temp_ext-doc-type.edt-key               = v-counter
     2193               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2194               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2195           .
     2196       end.
     2197   end.
     2198   end procedure.
     2199   procedure bge-xml-get-decimal-shift-num :
     2200   define input parameter p-shift-date     as date             no-undo.
     2201   define input parameter p-shift-num      as integer          no-undo.
     2202   define output parameter p-shift-decimal as decimal          no-undo.
     2203   do
     2204   on error undo, return error
     2205   :
     2206       assign
     2207           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2208       .
     2209   end.
     2210   end procedure.
     2211   procedure bge-xml-ora-exp-filename :
     2212     define input  parameter p-table-name  as character no-undo .
     2213     define input  parameter p-doc-code    as character no-undo .
     2214     define input  parameter p-obj-code    as integer   no-undo .
     2215     define output parameter p-filename    as character no-undo .
     2216     define output parameter p-seq-num     as integer   no-undo .
     2217     define variable v-ora-exp-seq     as integer   no-undo .
     2218     define variable v-ora-exp-seq-str as character no-undo .
     2219     define variable v-home-dir        as character no-undo.
     2220   do
     2221   on error undo, return error return-value
     2222   :
     2223     if v-bge-xml-bgeflold = "oracle":u
     2224     then do:
     2225       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2226       if v-home-dir = ?
     2227       then do:
     2228         undo, return error substitute( "&1&2&3":U
     2229                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2230                                       , chr(10)
     2231                                       , "Обратитесь к администратору.":U
     2232                                       ).
     2233       end.
     2234       assign
     2235           v-home-dir = v-home-dir
     2236       .
     2237       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2238       if error-status :error
     2239       then do:
     2240         undo, return error substitute( "&1&2&3":U
     2241                                       , "Неверно задан каталог экспорта.":U
     2242                                       , chr(10)
     2243                                       , "Обратитесь к администратору.":U
     2244                                       ).
     2245       end.
     2246       assign
     2247         v-ora-exp-seq = ?
     2248       .
     2249       if  p-table-name <> ? and
     2250           p-doc-code <> ?
     2251       then do:
     2252         run bge/get-oesq.p ( input p-table-name
     2253                            , input p-doc-code
     2254                            , output v-ora-exp-seq
     2255                            ) no-error .
     2256         if error-status :error = yes
     2257         then do:
     2258           undo, return error return-value .
     2259         end.
     2260       end.
     2261       if v-ora-exp-seq = ?
     2262       then do:
     2263         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2264         if error-status :error
     2265         then do:
     2266           undo, return error return-value .
     2267         end.
     2268       end.
     2269       if p-table-name <> ? and
     2270          p-doc-code   <> ?
     2271       then do:
     2272         run bge/oesqdoc.p ( input p-table-name
     2273                           , input p-doc-code
     2274                           , input v-ora-exp-seq
     2275                           ) no-error .
     2276         if error-status :error = yes
     2277         then do:
     2278           undo, return error return-value .
     2279         end.
     2280       end.
     2281       assign
     2282         p-seq-num  = v-ora-exp-seq
     2283         p-filename = substitute("&1/&2-000_&3."
     2284                                , v-home-dir
     2285                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2286                                , string(v-ora-exp-seq , "999999999")
     2287                                )
     2288       .
     2289     end.
     2290   end.
     2291   end procedure.
     2292   procedure bge-xml-date-to-str :
     2293     define input  parameter p-date  as date      no-undo .
     2294     define output parameter p-str   as character no-undo .
     2295   do
     2296   on error undo, return error return-value
     2297   :
     2298     if p-date <> ?
     2299     then do:
     2300       assign
     2301         p-str = substitute( "&1-&2-&3"
     2302                           , string( year(p-date)  , "9999")
     2303                           , string( month(p-date) , "99"  )
     2304                           , string( day(p-date)   , "99"  )
     2305                           )
     2306       .
     2307     end.
     2308     else do:
     2309       assign
     2310         p-str = ?
     2311       .
     2312     end.
     2313   end.
     2314   end procedure.
     2315   procedure bge-xml-date-str-to-str :
     2316     define input  parameter p-date-str  as character no-undo .
     2317     define output parameter p-str       as character no-undo .
     2318     define variable v-date          as date      no-undo .
     2319     define variable v-date-valid    as logical   no-undo .
     2320     define variable v-error-message as character no-undo .
     2321   do
     2322   on error undo, return error return-value
     2323   :
     2324     assign
     2325       p-str = ?
     2326     .
     2327     if p-date-str = ? or p-date-str = ""
     2328     then do:
     2329       return .
     2330     end.
     2331     run strtdate in this-procedure ( input  p-date-str
     2332                                    , output v-date
     2333                                    , output v-date-valid
     2334                                    , output v-error-message
     2335                                    ).
     2336     if v-date-valid <> true
     2337     then do:
     2338       return .
     2339     end.
     2340     assign
     2341       p-str = substitute( "&1-&2-&3"
     2342                         , string( year(v-date)  , "9999")
     2343                         , string( month(v-date) , "99"  )
     2344                         , string( day(v-date)   , "99"  )
     2345                         )
     2346     .
     2347   end.
     2348   end procedure.
     2349   procedure bge-xml-fill-tt-bgecliiv :
     2350     define input  parameter p-str as character no-undo .
     2351     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2352     define buffer buf_clients             for ub.clients.
     2353     define variable v-i         as integer   no-undo .
     2354     define variable v-count     as integer   no-undo .
     2355     define variable v-cli-count as integer   no-undo .
     2356     define variable v-client    as character no-undo .
     2357     define variable v-obj-type  as character no-undo .
     2358     define variable v-obj-code  as integer   no-undo .
     2359   do
     2360   on error undo, return error return-value
     2361   :
     2362     empty temp-table buf_tt-bge-xml-bgecliiv.
     2363     assign
     2364       v-bge-xml-bgecliiv = no
     2365       v-cli-count        = num-entries(p-str,';')
     2366     .
     2367     if v-cli-count > 0
     2368     then do:
     2369       _cli-cycle:
     2370       do v-i = 1 to v-cli-count
     2371       :
     2372         assign
     2373           v-client = entry(v-i , p-str, ';')
     2374         .
     2375         if num-entries(v-client) <> 2
     2376         then do:
     2377           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2378         end.
     2379         assign
     2380           v-obj-type = entry(1, v-client)
     2381         .
     2382         assign
     2383           v-obj-code = integer(entry(2, v-client))
     2384         no-error .
     2385         if error-status :error
     2386         then do:
     2387           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2388         end.
     2389         find first buf_clients no-lock
     2390           where buf_clients.obj-type = v-obj-type
     2391             and buf_clients.obj-code = v-obj-code
     2392         no-error.
     2393         if not available buf_clients
     2394         then do:
     2395           next _cli-cycle.
     2396         end.
     2397         find first buf_tt-bge-xml-bgecliiv no-lock
     2398           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2399             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2400         no-error .
     2401         if available buf_tt-bge-xml-bgecliiv
     2402         then do:
     2403           next _cli-cycle.
     2404         end.
     2405         create buf_tt-bge-xml-bgecliiv.
     2406         assign
     2407           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2408           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2409         .
     2410       end.
     2411     end.
     2412     else do:
     2413       assign
     2414         v-bge-xml-bgecliiv = no
     2415       .
     2416       return .
     2417     end.
     2418     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2419     if available buf_tt-bge-xml-bgecliiv
     2420     then do:
     2421       assign
     2422         v-bge-xml-bgecliiv = yes
     2423       .
     2424     end.
     2425   end.
     2426   end procedure.
     2427   procedure bge-xml-resolve-ext-doc-type :
     2428     define input  parameter p-ext-doc-type      as character no-undo .
     2429     define input  parameter p-obj-type          as character no-undo .
     2430     define input  parameter p-obj-code          as integer   no-undo .
     2431     define output parameter p-out-ext-doc-type  as character no-undo .
     2432     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2433   do
     2434   on error undo, return error return-value
     2435   :
     2436     assign
     2437       p-out-ext-doc-type = p-ext-doc-type
     2438     .
     2439     if p-ext-doc-type <> 'ie':U
     2440     then do:
     2441       return .
     2442     end.
     2443     if v-bge-xml-bgecliiv = yes
     2444     then do:
     2445       find first buf_tt-bge-xml-bgecliiv no-lock
     2446         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2447           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2448       no-error .
     2449       if available buf_tt-bge-xml-bgecliiv
     2450       then do:
     2451         assign
     2452           p-out-ext-doc-type = 'iv':U
     2453         .
     2454       end.
     2455     end.
     2456   end.
     2457   end procedure.
     2458   procedure safe-wp-xmltagput :
     2459     define input  parameter pTagLevel   as integer   no-undo .
     2460     define input  parameter pTagName    as character no-undo .
     2461     define input  parameter pParValue   as character no-undo .
     2462     define input  parameter pFlagEmpty  as integer   no-undo .
     2463   do
     2464   on error undo, return error return-value
     2465   :
     2466     if v-bge-xml-bgeflold = "oracle":u
     2467     then do:
     2468       return .
     2469     end.
     2470     run wp-xmltagput in this-procedure ( input pTagLevel
     2471                                        , input pTagName
     2472                                        , input pParValue
     2473                                        , input pFlagEmpty
     2474                                        ).
     2475   end.
     2476   end procedure.
     2477       define variable v-permission     as logical           no-undo.
     2478       define variable v-home-dir       as character         no-undo.
     2479       define variable v-error-num      as integer           no-undo.
     2480       define variable v-locked         as logical           no-undo.
     2481       define variable v-counter        as integer           no-undo.
     2482   do
     2483   on error undo, return error
     2484   :
     2485   run bge/bge-ini.p ( "bge", output v-home-dir ).
     2486   if return-value <> "OK" then return error.
     2487   assign
     2488       v-home-dir = v-home-dir + "/exp-acc"
     2489   .
     2490   run bge/dir_cd.p ( v-home-dir, "CA" ).
     2491   if return-value = "ERROR" then return error.
     2492   assign
     2493       p-xml-file-name = v-home-dir + "/" + p-file-name + "."
     2494   .
     2495   assign
     2496       v-locked = ( search ( p-xml-file-name + "xml" ) <> ? ).
     2497   .
     2498   DO v-counter = 1 TO 3 while v-locked:
     2499       assign
     2500           v-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     2501       .
     2502       if v-locked then readkey pause 1.
     2503   end.
     2504   if v-locked
     2505   then do:
     2506       return error "LOCKED".
     2507   end.
     2508   run bge/os_copy.p ( "D", p-xml-file-name + "xml", "", output v-error-num ).
     2509   if v-error-num > 0 then return error string( v-error-num ).
     2510   assign
     2511       p-log-file-name = v-home-dir + "/" + "actions.log"
     2512   .
     2513   run wp-XMLWriteLog( p-log-file-name, 0, "&DLine" ).
     2514   run wp-XMLWriteLog( p-log-file-name, 1, p-message-to-log ).
     2515   end.
