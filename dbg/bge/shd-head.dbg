        1   block-level on error undo, throw.
        2   define input parameter p-file-name          as character    no-undo.
        3   define input parameter p-message-to-log     as character    no-undo.
        4   define output parameter p-xml-file-name    as character    no-undo.
        5   define output parameter p-log-file-name    as character    no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: shd-head.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: bge/shd-head.p $":U .
       11   define variable vss-description as character no-undo init "Определение полного имени файла и вывод заголовка файла XML.".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define variable vss-include-info0 as character format "X(65)" no-undo
       71   initial "@(#)$Workfile$ $Revision$".
       72   DEF STREAM stmXMLOut.
       73   DEF STREAM stmXMLLog.
       74   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   procedure cur-time :
       76      define output parameter p-today as date      no-undo .
       77      define output parameter p-time  as integer   no-undo .
       78     do
       79     on error undo, return error
       80     :
       81       define variable v-date1 as date      no-undo .
       82       define variable v-date2 as date      no-undo .
       83       define variable v-time  as integer   no-undo .
       84       assign
       85         v-date1 = today
       86         v-time  = time
       87         v-date2 = today
       88       .
       89       if v-date1 <> v-date2
       90       then do:
       91         assign
       92           v-date1 = today
       93           v-time  = v-time
       94         .
       95       end.
       96       assign
       97         p-today = v-date1
       98         p-time  = v-time
       99       .
      100     end.
      101   end.
      102   function cur-time-date returns character
      103   :
      104     return string(today, '99/99/9999':U) .
      105   end.
      106   function cur-time-mjd returns decimal
      107   :
      108     define variable v-date as date      no-undo .
      109     define variable v-time as integer   no-undo .
      110     run cur-time in this-procedure
      111       (output v-date
      112       ,output v-time
      113       ) .
      114     return integer(v-date) - 2400002 + (v-time / 86400) .
      115   end.
      116   function cur-time-get-ending-index returns integer
      117   (input p-number as integer
      118   )
      119   :
      120     if p-number < 0
      121     or p-number = ?
      122     then do:
      123       return 1 .
      124     end.
      125     define variable v-rest as integer   no-undo .
      126     assign
      127       p-number = p-number modulo 100
      128     .
      129     if p-number < 20
      130     then do:
      131       assign
      132         v-rest = p-number
      133       .
      134     end.
      135     else do:
      136       assign
      137         v-rest = p-number modulo 10
      138       .
      139     end.
      140     case v-rest :
      141       when 1
      142       then do:
      143         return 2 .
      144       end.
      145       when 2 or
      146       when 3 or
      147       when 4
      148       then do:
      149         return 3 .
      150       end.
      151       otherwise do:
      152         return 1 .
      153       end.
      154     end case .
      155   end.
      156   procedure cur-time-mjd-to-date :
      157      define input  parameter i-mjd-diff as decimal no-undo.
      158      define output parameter o-Date     as date    no-undo.
      159      define output parameter o-Time     as integer no-undo.
      160      define variable v-day-number as integer   no-undo .
      161      if    i-mjd-diff < 0
      162         or i-mjd-diff = ?
      163      then do:
      164         return "?" .
      165      end.
      166      assign
      167         v-day-number = truncate(i-mjd-diff,0).
      168         o-Date = date(v-day-number + 2400002).
      169         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      170     .
      171   end.
      172   function cur-time-mjd-to-string returns character
      173   (input p-mjd-diff as decimal
      174   )
      175   :
      176     define variable v-day-number as integer   no-undo .
      177     define variable v-seconds    as integer   no-undo .
      178     define variable v-hour       as integer   no-undo .
      179     define variable v-min        as integer   no-undo .
      180     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      181     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      182     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      183     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      184     if p-mjd-diff < 0
      185     or p-mjd-diff = ?
      186     then do:
      187       return "?" .
      188     end.
      189     assign
      190       v-day-number = integer(truncate(p-mjd-diff,0))
      191       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      192     .
      193     if v-seconds > 86400
      194     then do:
      195       assign
      196         v-seconds = 86400 - 1
      197       .
      198     end.
      199     if v-seconds < 0
      200     then do:
      201       assign
      202         v-seconds = 0
      203       .
      204     end.
      205     assign
      206       v-hour = truncate(v-seconds / 3600, 0)
      207     .
      208     assign
      209       v-seconds = v-seconds modulo 3600
      210     .
      211     assign
      212       v-min = truncate(v-seconds / 60, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 60
      216     .
      217     return
      218         (if v-day-number <> 0
      219           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      220           else ""
      221         )
      222       + (if v-day-number <> 0 or v-hour <> 0
      223           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      227           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      228           else ""
      229         )
      230       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      231       .
      232   end.
      233   function cur-time-string returns character
      234   :
      235     define variable v-date as date      no-undo .
      236     define variable v-time as integer   no-undo .
      237     run cur-time in this-procedure
      238       (output v-date
      239       ,output v-time
      240       ) .
      241     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      242   end.
      243   function cur-time-string-sec returns character
      244   :
      245     define variable v-date as date      no-undo .
      246     define variable v-time as integer   no-undo .
      247     run cur-time in this-procedure
      248       (output v-date
      249       ,output v-time
      250       ) .
      251     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      252   end.
      253   function cur-time-custom  returns character
      254   (input p-prefix as character
      255   ,input p-date-format as character
      256   ,input p-delimiter as character
      257   ,input p-time-format as character
      258   ,input p-suffix as character
      259   )
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return
      268       p-prefix
      269       + string(v-date, p-date-format)
      270       + p-delimiter
      271       + string(v-time, p-time-format)
      272       + p-suffix
      273       .
      274   end.
      275   function cur-time-print  returns character
      276   :
      277     define variable v-date as date      no-undo .
      278     define variable v-time as integer   no-undo .
      279     run cur-time in this-procedure
      280       (output v-date
      281       ,output v-time
      282       ) .
      283     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      284   end.
      285   function cur-time-datetime returns datetime
      286   :
      287     define variable v-char as character no-undo .
      288     define variable v-datetime as datetime no-undo .
      289     v-char = cur-time-string().
      290     v-datetime = datetime(v-char).
      291     return  v-datetime.
      292   end.
      293   function cur-time-string-msec returns character
      294   :
      295     define variable v-date as datetime  no-undo .
      296     v-date = now.
      297     return string(v-date) .
      298   end.
      299   define variable vss-include-info2 as character format "X(65)" no-undo
      300   initial "@(#)$Workfile$ $Revision$".
      301   procedure xmlchar-test :
      302   define input parameter p-in-string          as character        no-undo.
      303   define output parameter p-out-string-enc    as character        no-undo.
      304   define output parameter p-out-string-dec    as character        no-undo.
      305   do
      306   on error undo, return error
      307   :
      308          run xmlchar-encode in this-procedure
      309       (
      310             input p-in-string
      311           , output p-out-string-enc
      312       ).
      313          run xmlchar-decode in this-procedure
      314       (
      315             input p-out-string-enc
      316           , output p-out-string-dec
      317       ).
      318   end.
      319   end .
      320   procedure xmlchar-encode :
      321   define input parameter p-in-string      as character        no-undo.
      322   define output parameter p-out-string    as character        no-undo.
      323       define variable v-position      as integer      no-undo.
      324       define variable v-current-char  as character    no-undo.
      325   do
      326   on error undo, return error
      327   :
      328       assign
      329           p-out-string = "":U
      330       .
      331       case p-in-string
      332       :
      333           when ?
      334           then do:
      335               assign
      336                   p-out-string = "?":U
      337               .
      338           end.
      339           when "?":U
      340           then do:
      341               assign
      342                   p-out-string = "&#63;":U
      343               .
      344           end.
      345           otherwise do:
      346               do v-position = 1 to length( p-in-string )
      347               :
      348                   assign
      349                       v-current-char = substring( p-in-string, v-position, 1 )
      350                   .
      351                   case v-current-char
      352                   :
      353                       when "&":U
      354                       then do:
      355                           assign
      356                               p-out-string = p-out-string + "&amp;":U
      357                           .
      358                       end.
      359                       when ">":U
      360                       then do:
      361                           assign
      362                               p-out-string = p-out-string + "&gt;":U
      363                           .
      364                       end.
      365                       when "<":U
      366                       then do:
      367                           assign
      368                               p-out-string = p-out-string + "&lt;":U
      369                           .
      370                       end.
      371                       when "'":U
      372                       then do:
      373                           assign
      374                               p-out-string = p-out-string + "&apos;":U
      375                           .
      376                       end.
      377                       when '"':U
      378                       then do:
      379                           assign
      380                               p-out-string = p-out-string + "&quot;":U
      381                           .
      382                       end.
      383                       when chr(1)
      384                       then do:
      385                           assign
      386                               p-out-string = p-out-string + "":U
      387                           .
      388                       end.
      389                       when chr(2)
      390                       then do:
      391                           assign
      392                               p-out-string = p-out-string + "":U
      393                           .
      394                       end.
      395                       when chr(3)
      396                       then do:
      397                           assign
      398                               p-out-string = p-out-string + "":U
      399                           .
      400                       end.
      401                       when chr(4)
      402                       then do:
      403                           assign
      404                               p-out-string = p-out-string + "":U
      405                           .
      406                       end.
      407                       when chr(5)
      408                       then do:
      409                           assign
      410                               p-out-string = p-out-string + "":U
      411                           .
      412                       end.
      413                       when chr(6)
      414                       then do:
      415                           assign
      416                               p-out-string = p-out-string + "":U
      417                           .
      418                       end.
      419                       when chr(7)
      420                       then do:
      421                           assign
      422                               p-out-string = p-out-string + "":U
      423                           .
      424                       end.
      425                       when chr(8)
      426                       then do:
      427                           assign
      428                               p-out-string = p-out-string + "":U
      429                           .
      430                       end.
      431                       when chr(9)
      432                       then do:
      433                           assign
      434                               p-out-string = p-out-string + "":U
      435                           .
      436                       end.
      437                       when chr(29)
      438                       then do:
      439                           assign
      440                               p-out-string = p-out-string + "":U
      441                           .
      442                       end.
      443                       when chr(10)
      444                       then do:
      445                           assign
      446                               p-out-string = p-out-string + "&#10;":U
      447                           .
      448                       end.
      449                       when chr(13)
      450                       then do:
      451                           assign
      452                               p-out-string = p-out-string + "&#13;":U
      453                           .
      454                       end.
      455                       otherwise do:
      456                           assign
      457                               p-out-string = p-out-string + v-current-char
      458                           .
      459                       end.
      460                   end case.
      461               end.
      462           end.
      463       end case.
      464   end.
      465   end .
      466   procedure xmlchar-encode-1c :
      467   define input parameter p-in-string      as character        no-undo.
      468   define output parameter p-out-string    as character        no-undo.
