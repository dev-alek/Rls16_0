      602   define variable c_value as character no-undo.
      603   define variable c_type as character no-undo.
      604   define variable i-operation-id as integer no-undo.
      605   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      606        LABEL "Отмена"
      607        SIZE 15 BY 1.14
      608        BGCOLOR 8 .
      609   DEFINE BUTTON Btn_OK AUTO-GO
      610        LABEL "Запустить"
      611        SIZE 15 BY 1.14
      612        BGCOLOR 8 .
      613   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U
      614        LABEL "Текущее значение атрибута"
      615        VIEW-AS FILL-IN
      616        SIZE 28 BY .95 NO-UNDO.
      617   DEFINE VARIABLE FILL-IN-2 AS DATE FORMAT "99/99/9999":U
      618        LABEL "Снять отчет за:   Дата"
      619        VIEW-AS FILL-IN
      620        SIZE 11 BY .95 NO-UNDO.
      621   DEFINE VARIABLE FILL-IN-3 AS CHARACTER FORMAT "X(256)":U
      622        LABEL "Смена"
      623        VIEW-AS FILL-IN
      624        SIZE 9 BY .95 NO-UNDO.
      625   DEFINE VARIABLE RADIO-SET-1 AS INTEGER
      626        VIEW-AS RADIO-SET VERTICAL
      627        RADIO-BUTTONS
      628             "По товару", 1,
      629   "По НДС", 2
      630        SIZE 15 BY 3 NO-UNDO.
      631   DEFINE FRAME Dialog-Frame
      632        FILL-IN-1 AT ROW 1.71 COL 31 COLON-ALIGNED WIDGET-ID 2
      633        FILL-IN-2 AT ROW 2.91 COL 31 COLON-ALIGNED WIDGET-ID 6
      634        FILL-IN-3 AT ROW 2.91 COL 50 COLON-ALIGNED WIDGET-ID 8
      635        RADIO-SET-1 AT ROW 4.33 COL 27 NO-LABEL WIDGET-ID 10
      636        Btn_OK AT ROW 4.81 COL 46
      637        Btn_Cancel AT ROW 6.24 COL 46
      638        "Агрегирование" VIEW-AS TEXT
      639             SIZE 17 BY 1.43 AT ROW 5.05 COL 8 WIDGET-ID 14
      640        SPACE(36.39) SKIP(1.13)
      641       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      642            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      643            TITLE "Запуск САП СНГ"
      644            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
      645   ASSIGN
      646          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      647          FRAME Dialog-Frame:HIDDEN           = TRUE.
      648   ASSIGN
      649          FILL-IN-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      650   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      651   DO:
      652     APPLY "END-ERROR":U TO SELF.
      653   END.
      654   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      655   DO:
      656       ASSIGN
      657       FILL-IN-2
      658       FILL-IN-3
      659       RADIO-SET-1.
      660       run bge/exp-sap-sng.p (input "sap-result-" + string(time) + ".log",
      661                             input v-cntxt-obj-type,
      662                             input v-cntxt-obj-code,
      663                             input integer(FILL-IN-3),
      664                             input FILL-IN-2,
      665                             input (if RADIO-SET-1 = 2 then yes else no),
      666                             input-output i-operation-id).
      667       run clntattr-write in this-procedure (input v-cntxt-obj-type
      668                                            ,input v-cntxt-obj-code
      669                                            ,input 'bge-sap-sng-last-shift':U
      670                                            ,input substitute("&1,&2,&3",entry(1,c_value,","),entry(2,c_value,","),i-operation-id)).
      671   END.
      672   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      673   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      674   MAIN-BLOCK:
      675   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      676      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      677   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      678     run mainmenu_getcntxt in parparentproc
      679       (output v-cntxt-db-num
      680       ,output v-cntxt-userid
      681       ,output v-cntxt-level
      682       ,output v-cntxt-host-code-obj
      683       ,output v-cntxt-obj-type
      684       ,output v-cntxt-obj-code
      685       ,output v-cntxt-db-num-obj
      686       ,output v-cntxt-is-admin
      687       ) .
      688     RUN enable_UI.
      689     do on error undo, return error:
      690       run clntattr-value in this-procedure (input v-cntxt-obj-type
      691                                            ,input v-cntxt-obj-code
      692                                            ,input 'bge-sap-sng-last-shift':U
      693                                            ,output c_value
      694                                            ,output c_type).
      695       if num-entries(c_value,",") = 3 then do:
      696           FILL-IN-1:screen-value in frame dialog-frame = substitute ("дата &1 смена &2", entry(1,c_value,","), entry(2,c_value,",")).
      697           i-operation-id = integer(entry(3,c_value,",")).
      698       end.
      699     end.
      700     WAIT-FOR GO OF FRAME Dialog-Frame.
      701   END.
      702   RUN disable_UI.
      703   PROCEDURE disable_UI :
      704     HIDE FRAME Dialog-Frame.
      705   END PROCEDURE.
      706   PROCEDURE enable_UI :
      707     DISPLAY FILL-IN-1 FILL-IN-2 FILL-IN-3 RADIO-SET-1
      708         WITH FRAME Dialog-Frame.
      709     ENABLE FILL-IN-1 FILL-IN-2 FILL-IN-3 RADIO-SET-1 Btn_OK Btn_Cancel
      710         WITH FRAME Dialog-Frame.
      711     VIEW FRAME Dialog-Frame.
      712   END PROCEDURE.
