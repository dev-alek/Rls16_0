        1   block-level on error undo, throw.
        2   define input parameter parparentproc as handle no-undo.
        3   define input  parameter iThump as character no-undo.
        4   define input  parameter idb-num as integer no-undo.
        5   define input  parameter idoc-id as integer no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision:$":U .
        7   define variable vss-author      as character no-undo init "$Author:$":U .
        8   define variable vss-date        as character no-undo init "$Date:$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
       10   define variable vss-archive     as character no-undo init "$Archive:$":U .
       11   define variable vss-description as character no-undo init "".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67     define variable v-cntxt-db-num        as integer   no-undo .
       68     define variable v-cntxt-userid        as character no-undo .
       69     define variable v-cntxt-level         as character no-undo .
       70     define variable v-cntxt-host-code-obj as integer   no-undo .
       71     define variable v-cntxt-obj-type      as character no-undo .
       72     define variable v-cntxt-obj-code      as integer   no-undo .
       73     define variable v-cntxt-db-num-obj    as integer   no-undo .
       74     define variable v-cntxt-is-admin      as logical   no-undo .
       75   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76     run mainmenu_getcntxt in parparentproc
       77       (output v-cntxt-db-num
       78       ,output v-cntxt-userid
       79       ,output v-cntxt-level
       80       ,output v-cntxt-host-code-obj
       81       ,output v-cntxt-obj-type
       82       ,output v-cntxt-obj-code
       83       ,output v-cntxt-db-num-obj
       84       ,output v-cntxt-is-admin
       85       ) .
       86   function objExists return character
       87   (input  ifolder as character,
       88    input  iType   as character  ):
       89       define variable vFileType as character no-undo init "D,F".
       90       define variable vi        as integer no-undo.
       91       define variable vtype as character no-undo.
       92       if iType ne ?
       93       then
       94          vFileType = iType.
       95       do vi = 1 to num-entries(vFileType):
       96          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
       97          vtype = file-information:file-type.
       98          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       99             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      100             index(vtype , entry(vi,vFileType )) > 0
      101          then return file-information:full-pathname .
      102          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
      103          vtype = file-information:file-type.
      104          if file-information:file-name <> "" and
      105             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
      106             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
      107             index( vtype, entry(vi,vFileType )) > 0
      108          then return file-information:full-pathname .
      109       end.
      110       return ? .
      111   end.
      112   function SearchFile return character
      113   (input  ifile as character):
      114      return objExists(ifile,?).
      115   end.
      116   function SearchPFile return character
      117   (input inFile as char):
      118        define variable oFile       as character no-undo.
      119        define variable vFileSearch as character no-undo.
      120        define variable vNumEntry   as integer no-undo.
      121        if inFile = "" then return ?.
      122        vNumEntry = num-entries(inFile,".").
      123        vFileSearch = inFile.
      124        if    vNumEntry > 0
      125           and (   entry(vNumEntry,inFile,".") eq "p"
      126                or entry(vNumEntry,inFile,".") eq "w")
      127        then do:
      128           entry(vNumEntry,vFileSearch, ".") = "r".
      129           oFile = search(vFileSearch ).
      130           if oFile eq ?
      131           then
      132              oFile = search(inFile).
      133        end.
      134        else
      135           oFile = search(vFileSearch).
      136        return oFile.
      137     end.
      138   define variable mDebug as logical no-undo.
      139   mDebug = session:debug-alert.
      140   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      141   define variable mDiadocApi as component-handle no-undo.
      142   define variable mDiadocConnection as component-handle no-undo.
      143   define variable m-sys-key as character no-undo.
      144   define variable marpar-type as character no-undo.
      145   define variable mPublishHand as handle  no-undo.
      146   define variable mFlaftest as logical no-undo.
      147      create "Diadoc.DiadocClient":U mDiadocApi no-error.
      148   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      149   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      150   define variable mySeqUtd as int64 no-undo init ?.
      151   if mDiadocApi eq ?
      152   then do:
      153      if  log-manager:logfile-name ne ?
      154      then
      155         log-manager:write-message("Нет библиотеки Diadoc или не удалось создать объект Diadoc.DiadocClient", "EDOError").
      156   end.
      157   else do:
      158      if  log-manager:logfile-name ne ?
      159      then
      160         log-manager:write-message(substitute ("Версия библиотеки Diadoc &1" , mDiadocApi:GetFullVersion()) , "EDOError").
      161   end.
      162   define new global shared variable g#language as character no-undo .
      163   if g#language <> '' and g#language <> 'rus':U then do:
      164     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      165   end.
      166   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      167   procedure gen-key-rec :
      168     define input  parameter p-tbl-name    as character no-undo.
      169     define input  parameter p-bh_tbl-name as handle    no-undo.
      170     define output parameter p-key-rec     as character no-undo.
      171     do
      172     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      173     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      174     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      175     :
      176       define variable fh               as handle    no-undo .
      177       define variable v-ok             as logical   no-undo .
      178       define variable v-inform         as character no-undo .
      179       define variable v-ind            as integer   no-undo .
      180       define variable v-idx-field-qnty as integer   no-undo .
      181       if p-tbl-name = ?
      182         or p-tbl-name = "":U
      183       then do:
      184         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      185       end.
      186       if not p-bh_tbl-name:available then do:
      187         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      188       end.
      189       assign
      190         p-key-rec = p-tbl-name
      191         v-inform  = p-bh_tbl-name:index-information(1)
      192         v-ind     = 2
      193       .
      194       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      195       on error undo, return error
      196       :
      197         assign
      198           v-inform = p-bh_tbl-name:index-information( v-ind )
      199           v-ind    = v-ind + 1
      200         .
      201       end.
      202       if v-inform = ?
      203         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      204         or entry( 3, v-inform, ",":U ) <> "1":U
      205       then do:
      206         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      207       end.
      208       else do:
      209         assign
      210           v-idx-field-qnty = num-entries( v-inform ) - 4
      211         .
      212         if v-idx-field-qnty < 2 then do:
      213           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      214         end.
      215         do v-ind = 1 to v-idx-field-qnty by 2
      216         on error undo, return error
      217         :
      218           assign
      219             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      220             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      221           .
      222         end.
      223       end.
      224       if p-key-rec = ? then do:
      225         assign
      226           p-key-rec = "":U
      227         .
      228         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      229       end.
      230     end.
      231     return.
      232   end procedure.
      233   procedure gen-where-keyr-tab :
      234     define input  parameter i-tableSerach as character no-undo.
      235     define input  parameter i-tablekey   as character  no-undo.
      236     define input  parameter p-key-rec    as character  no-undo.
      237     define input  parameter p-key-handle as handle     no-undo .
      238     define input  parameter p-db-name    as character  no-undo .
      239     define input  parameter p-tt-handle  as handle     no-undo .
      240     define output parameter o-Where      as character  no-undo.
      241     do
      242     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      243     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      244     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      245     :
      246       define variable v-full-tbl-name  as character no-undo .
      247       define variable bh_tbl-name      as handle    no-undo .
      248       define variable fh_key           as handle    no-undo .
      249       define variable fh_search        as handle    no-undo .
      250       define variable v-field-num      as integer   no-undo .
      251       define variable v-count-fld      as integer   no-undo .
      252       define variable v-inform         as character no-undo .
      253       define variable v-ind            as integer   no-undo .
      254       define variable v-idx-field-qnty as integer   no-undo .
      255       define variable v-field-name     as character no-undo .
      256       define variable v-field-val      as character no-undo .
      257       define variable v-word-link      as character no-undo .
      258       define variable vTable           as character no-undo.
      259       define variable bh_tbl-key       as handle    no-undo .
      260       assign
      261         p-key-rec = trim( p-key-rec )
      262       .
      263       if p-key-handle <> ? then do:
      264         if not valid-handle(p-key-handle)
      265            or p-key-handle:type <> "buffer"
      266         then do:
      267           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      268         end.
      269         if num-entries( p-key-rec, chr(3) ) > 1
      270           or p-key-rec = ?
      271           or p-key-rec = "":U
      272         then do:
      273           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      274         end.
      275       end.
      276       else do:
      277         if p-key-rec = ?
      278           or p-key-rec = "":U
      279         then do:
      280           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      281         end.
      282       end.
      283       assign
      284         vTable = entry( 1 , p-key-rec, chr(3) )
      285       .
      286       if p-tt-handle <> ?
      287         and ( not valid-handle(p-tt-handle)
      288               or p-tt-handle:type <> "buffer"
      289             )
      290       then do:
      291         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      292       end.
      293       if p-tt-handle = ? then do:
      294         assign
      295           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      296         .
      297         create buffer bh_tbl-name for table v-full-tbl-name .
      298       end.
      299       else do:
      300         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      301       end.
      302       assign
      303         v-inform = bh_tbl-name:index-information(1)
      304         v-ind    = 2
      305       .
      306       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      307       on error undo, return error
      308       :
      309         assign
      310           v-inform = bh_tbl-name:index-information( v-ind )
      311           v-ind    = v-ind + 1
      312         .
      313       end.
      314       if v-inform = ?
      315         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      316         or entry( 3, v-inform, ",":U ) <> "1":U
      317       then do:
      318         delete object bh_tbl-name no-error.
      319         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      320       end.
      321       assign
      322         v-idx-field-qnty = num-entries( v-inform ) - 4
      323       .
      324       if v-idx-field-qnty < 2 then do:
      325         delete object bh_tbl-name no-error.
      326         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      327       end.
      328       assign
      329         o-where     = "where":U
      330         v-word-link = "":U
      331         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      332         v-count-fld = 0
      333       .
      334       if i-tablekey ne "" and i-tablekey ne ?
      335       then do:
      336         assign
      337           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      338         .
      339         create buffer bh_tbl-key for table v-full-tbl-name .
      340       end.
      341       if i-tableSerach ne "" and i-tableSerach ne ?
      342       then do:
      343         delete object bh_tbl-name no-error.
      344         assign
      345           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      346         .
      347         create buffer bh_tbl-name for table v-full-tbl-name .
      348       end.
      349       block_where:
      350       do v-ind = 1 to v-idx-field-qnty by 2
      351       on error undo, return error
      352       :
      353         assign
      354           v-count-fld = v-count-fld + 1
      355         .
      356         if p-key-handle = ?
      357           and v-count-fld > v-field-num
      358         then do:
      359           leave block_where.
      360         end.
      361         define variable VfieldKeyTable as handle no-undo.
      362         assign
      363           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      364           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      365         .
      366         if     bh_tbl-key ne ?
      367         then do:
      368            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      369            if VfieldKeyTable eq ?
      370            then next block_where.
      371         end.
      372         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      373         then
      374            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      375         else
      376            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      377         if p-key-handle = ? then do:
      378           assign
      379             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      380           .
      381         end.
      382         else do:
      383           assign
      384             fh_key = p-key-handle:buffer-field( v-field-name )
      385           .
      386           if fh_key = ?
      387             or not valid-handle( fh_key )
      388           then do:
      389             delete object bh_tbl-name.
      390             if     bh_tbl-key ne ?
      391             then
      392                delete object bh_tbl-key.
      393             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      394           end.
      395           assign
      396             v-field-val = fh_key:buffer-value
      397           .
      398         end.
      399         if fh_search:data-type ="character":U then do:
      400           assign
      401             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      402             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      403             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      404             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      405             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      406             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      407             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      408             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      409             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      410             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      411             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      412             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      413             v-field-val = substitute( '"&1"', v-field-val )
      414           .
      415         end.
      416         assign
      417           o-where = substitute( "&1 &2", o-where, v-field-val )
      418         .
      419         if v-word-link = "":U then do:
      420           assign
      421             v-word-link = "and":U
      422           .
      423         end.
      424       end.
      425       delete object bh_tbl-name.
      426       if     bh_tbl-key ne ?
      427       then
      428          delete object bh_tbl-key.
      429       if p-key-handle = ?
      430         and v-count-fld <> v-field-num
      431       then do:
      432         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      433       end.
      434     end.
      435   end procedure.
      436   procedure gen-hn-keyr-tab :
      437     define input  parameter i-tableSerach as character no-undo.
      438     define input  parameter i-tablekey   as character no-undo.
      439     define input  parameter p-key-rec    as character no-undo.
      440     define input  parameter p-key-handle as handle    no-undo .
      441     define input  parameter p-db-name    as character no-undo .
      442     define input  parameter p-tt-handle  as handle    no-undo .
      443     define input  parameter p-stts-lock  as integer   no-undo .
      444     define output parameter o-hn         as handle    no-undo.
      445     define variable v-full-tbl-name as character no-undo.
      446     define variable v-where         as character no-undo.
      447     define variable bh_tbl-name     as handle    no-undo.
      448     define variable vTable          as character no-undo.
      449     do
      450     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      451     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      452     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      453         run gen-where-keyr-tab(i-tableSerach,
      454                                i-tablekey,
      455                                p-key-rec,
      456                                p-key-handle,
      457                                p-db-name,
      458                                p-tt-handle,
      459                                output v-where).
      460         if i-tableSerach ne "" and i-tableSerach ne ?
      461         then do:
      462            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      463            create buffer bh_tbl-name for table v-full-tbl-name .
      464         end.
      465         else do:
      466            if p-tt-handle = ? then do:
      467               assign
      468                  vTable = entry( 1 , p-key-rec, chr(3) )
      469               .
      470               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      471               create buffer bh_tbl-name for table v-full-tbl-name .
      472            end.
      473            else do:
      474               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      475            end.
      476         end.
      477         if p-tt-handle = ? then do:
      478            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      479         end.
      480         else do:
      481            bh_tbl-name:find-first( v-where ) no-error .
      482         end.
      483         o-hn = bh_tbl-name.
      484      end.
      485   end procedure.
      486   procedure gen-hn-keyr :
      487     define input  parameter p-key-rec    as character no-undo.
      488     define input  parameter p-key-handle as handle    no-undo .
      489     define input  parameter p-db-name    as character no-undo .
      490     define input  parameter p-tt-handle  as handle    no-undo .
      491     define input  parameter p-stts-lock  as integer   no-undo .
      492     define output parameter o-hn         as handle    no-undo.
      493     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      494   end.
      495   procedure gen-row-keyr :
      496     define input  parameter p-key-rec    as character no-undo.
      497     define input  parameter p-key-handle as handle    no-undo .
      498     define input  parameter p-db-name    as character no-undo .
      499     define input  parameter p-tt-handle  as handle    no-undo .
      500     define input  parameter p-stts-lock  as integer   no-undo .
      501     define output parameter p-tbl-row    as rowid     no-undo.
      502     define output parameter p-tbl-name   as character no-undo.
      503     define variable vHn as handle no-undo.
      504       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      505       p-tbl-row = if vHn:available then vHn:rowid else ?.
      506       p-tbl-name =  vHn:table.
      507       delete object vHn no-error.
      508     if p-tbl-row = ? then do:
      509       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      510     end.
      511     else do:
      512       return.
      513     end.
      514   end procedure.
      515   procedure gen-key-fv :
      516     define input  parameter p-key-rec    as character no-undo .
      517     define output parameter p-field-list as character no-undo .
      518     define output parameter p-value-list as character no-undo.
      519     do
      520     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      521     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      522     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      523     :
      524       define variable v-full-tbl-name  as character no-undo .
      525       define variable bh_tbl-name      as handle    no-undo .
      526       define variable v-tbl-name       as character no-undo .
      527       define variable v-field-num      as integer   no-undo .
      528       define variable v-count-fld      as integer   no-undo .
      529       define variable v-inform         as character no-undo .
      530       define variable v-ind            as integer   no-undo .
      531       define variable v-idx-field-qnty as integer   no-undo .
      532       define variable v-delim-key      as character no-undo .
      533       if p-key-rec = ?
      534         or p-key-rec = "":U
      535       then do:
      536         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      537       end.
      538       assign
      539         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      540         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      541       .
      542       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      543       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      544       assign
      545         v-inform = bh_tbl-name:index-information(1)
      546         v-ind    = 2
      547       .
      548       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      549       on error undo, return error
      550       :
      551         assign
      552           v-inform = bh_tbl-name:index-information( v-ind )
      553           v-ind    = v-ind + 1
      554         .
      555       end.
      556       if v-inform = ?
      557         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      558         or entry( 3, v-inform, ",":U ) <> "1":U
      559       then do:
      560         delete object bh_tbl-name no-error.
      561         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      562       end.
      563       assign
      564         v-idx-field-qnty = num-entries( v-inform ) - 4
      565       .
      566       if v-idx-field-qnty < 2 then do:
      567         delete object bh_tbl-name no-error.
      568         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      569       end.
      570       assign
      571         p-field-list = "":U
      572         p-value-list = "":U
      573         v-delim-key  = "":U
      574         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      575         v-count-fld  = 0
      576       .
      577       block_where:
      578       do v-ind = 1 to v-idx-field-qnty by 2
      579       on error undo, return error
      580       :
      581         assign
      582           v-count-fld = v-count-fld + 1
      583         .
      584         if v-count-fld > v-field-num then do:
      585           leave block_where.
      586         end.
      587         assign
      588           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      589           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      590         .
      591         if v-ind = 1 then do:
      592           assign
      593             v-delim-key = chr(3)
      594           .
      595         end.
      596       end.
      597       delete object bh_tbl-name.
      598       if v-count-fld <> v-field-num then do:
      599         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
      600       end.
      601     end.
      602   end procedure.
      603   procedure gen-key-field :
      604     define input  parameter p-table      as character no-undo .
      605     define output parameter p-field-list as character no-undo .
      606     do
      607     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      608     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      609     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      610     :
      611       define variable v-full-tbl-name  as character no-undo .
      612       define variable bh_tbl-name      as handle    no-undo .
      613       define variable v-tbl-name       as character no-undo .
      614       define variable v-field-num      as integer   no-undo .
      615       define variable v-count-fld      as integer   no-undo .
      616       define variable v-inform         as character no-undo .
      617       define variable v-ind            as integer   no-undo .
      618       define variable v-idx-field-qnty as integer   no-undo .
      619       define variable v-delim-key      as character no-undo .
      620       if p-table = ?
      621         or p-table = "":U
      622       then do:
      623         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
      624       end.
      625       assign
      626         v-tbl-name      = p-table
      627         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      628       .
      629       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      630       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
      631       assign
      632         v-inform = bh_tbl-name:index-information(1)
      633         v-ind    = 2
      634       .
      635       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      636       on error undo, return error
      637       :
      638         assign
      639           v-inform = bh_tbl-name:index-information( v-ind )
      640           v-ind    = v-ind + 1
      641         .
      642       end.
      643       if v-inform = ?
      644         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      645         or entry( 3, v-inform, ",":U ) <> "1":U
      646       then do:
      647         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      648       end.
      649       assign
      650         v-idx-field-qnty = num-entries( v-inform ) - 4
      651       .
      652       if v-idx-field-qnty < 2 then do:
      653         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      654       end.
      655       assign
      656         p-field-list = "":U
      657         v-delim-key  = "":U
      658         v-count-fld  = 0
      659       .
      660       block_where:
      661       do v-ind = 1 to v-idx-field-qnty by 2
      662       on error undo, return error
      663       :
      664         assign
      665           v-count-fld = v-count-fld + 1
      666         .
      667         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      668         if v-ind = 1 then do:
      669           assign
      670             v-delim-key = chr(3)
      671           .
      672         end.
      673       end.
      674       delete object bh_tbl-name.
      675     end.
      676   end procedure.
      677   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      678   function getattrUtdex returns char
      679   (idb-num   as integer,
      680    idoc-id   as integer,
      681    iattrcode as character,
      682    iExValue  as character  ):
      683      define buffer utd-attr for utd-attr.
      684      find first utd-attr where utd-attr.db-num eq idb-num
      685                            and utd-attr.doc-id eq idoc-id
      686                            and utd-attr.attr-code eq iattrcode
      687      no-lock no-error.
      688      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
      689   end.
      690   function getattrUtd returns char
      691   (idb-num   as integer,
      692    idoc-id   as integer,
      693    iattrcode as character ):
      694     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
      695   end.
      696   function setattrUtd returns logical
      697   (idb-num   as integer,
      698    idoc-id   as integer,
      699    iattrcode as character,
      700    iattrval  as character ):
      701      define buffer utd-attr for utd-attr.
      702      find first utd-attr where utd-attr.db-num eq idb-num
      703                            and utd-attr.doc-id eq idoc-id
      704                            and utd-attr.attr-code eq iattrcode
      705      no-lock no-error.
      706      if not available utd-attr
      707      then do:
      708         create utd-attr.
      709         assign
      710            utd-attr.db-num    = idb-num
      711            utd-attr.doc-id    = idoc-id
      712            utd-attr.attr-code = iattrcode
      713            utd-attr.attr-value = iattrval
      714         .
      715      end.
      716      else do:
      717         if utd-attr.attr-value ne iattrval
      718         then do:
      719            find current utd-attr exclusive-lock no-error.
      720            if available utd-attr
      721            then
      722               utd-attr.attr-value = iattrval.
      723         end.
      724      end.
      725      release utd-attr.
      726   end.
      727   function GetAttrUtdlinesEx returns char
      728   (idb-num   as integer,
      729    idoc-id   as integer,
      730    ilinenum  as integer,
      731    iattrcode as character,
      732    iExValue  as character  ):
      733      define buffer utd-lines-attr for utd-lines-attr.
      734      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      735                                  and utd-lines-attr.doc-id    eq idoc-id
      736                                  and utd-lines-attr.lineNum   eq ilineNum
      737                                  and utd-lines-attr.attr-code eq iattrcode
      738      no-lock no-error.
      739      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
      740   end.
      741   function GetAttrUtdlines returns char
      742   (idb-num   as integer,
      743    idoc-id   as integer,
      744    ilinenum  as integer,
      745    iattrcode as character ):
      746      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
      747   end.
      748   function setattrUtdlines returns logical
      749   (idb-num   as integer,
      750    idoc-id   as integer,
      751    ilinenum  as integer,
      752    iattrcode as character,
      753    iattrval  as character ):
      754      define buffer utd-lines-attr for utd-lines-attr.
      755      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      756                                  and utd-lines-attr.doc-id    eq idoc-id
      757                                  and utd-lines-attr.lineNum   eq ilineNum
      758                                  and utd-lines-attr.attr-code eq iattrcode
      759      no-lock no-error.
      760      if not available utd-lines-attr
      761      then do:
      762         if iattrval ne ?
      763            and iattrval ne ""
      764         then do:
      765            create utd-lines-attr.
      766            assign
      767               utd-lines-attr.db-num    = idb-num
      768               utd-lines-attr.doc-id    = idoc-id
      769               utd-lines-attr.lineNum   = ilineNum
      770               utd-lines-attr.attr-code = iattrcode
      771               utd-lines-attr.attr-value = iattrval
      772            .
      773         end.
      774      end.
      775      else do:
      776         if utd-lines-attr.attr-value ne iattrval
      777         then do:
      778            find current utd-lines-attr exclusive-lock no-error.
      779            if available utd-lines-attr
      780            then do:
      781               if    iattrval eq ?
      782                  or iattrval eq ""
      783               then do:
      784                  delete utd-lines-attr.
      785               end.
      786               else do:
      787                  utd-lines-attr.attr-value = iattrval.
      788               end.
      789            end.
      790         end.
      791      end.
      792      release utd-lines-attr.
      793   end.
      794   function GetAttrUtdMarkingLinesEx returns char
      795   (idb-num   as integer,
      796    idoc-id   as integer,
      797    ilinenum  as integer,
      798    imark     as character,
      799    iattrcode as character,
      800    iExValue  as character  ):
      801      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      802      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      803                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      804                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      805                                          and utd-marking-lines-attr.mark      eq imark
      806                                          and utd-marking-lines-attr.attr-code eq iattrcode
      807      no-lock no-error.
      808      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
      809   end.
      810   function GetAttrUtdMarkingLines returns char
      811   (idb-num   as integer,
      812    idoc-id   as integer,
