     6989                              utd-lines.doc-id   = utd.doc-id
     6990                              utd-lines.Linenum  = vi
     6991                              utd-lines.gds-code = ?
     6992                           .
     6993                        end.
     6994                        utd-lines.ProductCode = vExtendedInvoiceItem:Product.
     6995                        utd-lines.UnitCode    = vExtendedInvoiceItem:UnitnAME.
     6996                        setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(vExtendedInvoiceItem:Quantity)).
     6997                        setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Unit",string(vExtendedInvoiceItem:unit)).
     6998                        utd-lines.Price       = vExtendedInvoiceItem:Price.
     6999                        utd-lines.TotalWithVatExcluded   = vExtendedInvoiceItem:SubtotalWithVatExcluded.
     7000                        utd-lines.TaxRate   =   if  vExtendedInvoiceItem:TaxRate eq "без ндс" then -1 else decimal(trim(entry(1,vExtendedInvoiceItem:TaxRate,"/"),"%")).
     7001                        utd-lines.Vat       = vExtendedInvoiceItem:Vat.
     7002                        utd-lines.Total     = vExtendedInvoiceItem:Subtotal.
