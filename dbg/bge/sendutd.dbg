      827                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      828                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      829                                          and utd-marking-lines-attr.mark      eq imark
      830                                          and utd-marking-lines-attr.attr-code eq iattrcode
      831      no-lock no-error.
      832      if not available utd-marking-lines-attr
      833      then do:
      834         if iattrval ne ?
      835            and iattrval ne ""
      836         then do:
      837            create utd-marking-lines-attr.
      838            assign
      839               utd-marking-lines-attr.db-num     = idb-num
      840               utd-marking-lines-attr.doc-id     = idoc-id
      841               utd-marking-lines-attr.lineNum    = ilineNum
      842               utd-marking-lines-attr.mark       = imark
      843               utd-marking-lines-attr.attr-code  = iattrcode
      844               utd-marking-lines-attr.attr-value = iattrval
      845            .
      846         end.
      847      end.
      848      else do:
      849         if utd-marking-lines-attr.attr-value ne iattrval
      850         then do:
      851            find current utd-marking-lines-attr exclusive-lock no-error.
      852            if available utd-marking-lines-attr
      853            then do:
      854               if    iattrval eq ?
      855                  or iattrval eq ""
      856               then do:
      857                  delete utd-marking-lines-attr.
      858               end.
      859               else do:
      860                  utd-marking-lines-attr.attr-value = iattrval.
      861               end.
      862            end.
      863         end.
      864      end.
      865      release utd-marking-lines-attr.
      866   end.
      867   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      868   define new global shared variable g#attr-lib  as handle no-undo .
      869   define variable v-attr-lib-variable as handle no-undo .
      870   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      871   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
