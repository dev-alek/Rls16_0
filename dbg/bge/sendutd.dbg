     6781      define variable vTransferBase                as component-handle no-undo.
     6782      define variable vorgname as character no-undo.
     6783      define variable vAddrOrg as character no-undo.
     6784      define variable vAdditionalInfo as character no-undo.
     6785      define variable volddb-num as integer no-undo.
     6786      define variable volddoc-id as integer no-undo.
     6787      define variable vunits  as component-handle no-undo.
     6788      define variable vunit   as component-handle no-undo.
     6789      define variable VValue  as character        no-undo.
     6790      define variable vsite   as character        no-undo.
     6791      define variable vNewUtd as logical          no-undo.
     6792      if iDocument eq ?
     6793      then
     6794        return.
     6795      vOrganizationGuid = iDocument:OrganizationGuid.
     6796      vDocumentid     = iDocument:DocumentId.
     6797      find first utd where utd.DocumentExt     = vDocumentid
     6798                       and utd.OrganizationExt = vOrganizationGuid
     6799      no-lock no-error .
     6800      find first tt-recid where tt-recid.orgid eq vOrganizationGuid
     6801                            and tt-recid.docid eq vDocumentid
     6802      no-lock no-error.
     6803      if not available tt-recid
     6804      then do trans:
     6805         if iDocument  ne ?
     6806            and (
     6807                     iDocument:type eq "UniversalTransferDocument"
     6808                  or iDocument:type eq "UniversalTransferDocumentRevision"
     6809                  or iDocument:type eq "UniversalCorrectionDocument"
     6810                 )
     6811         then do:
     6812            PutMes(substitute("Загрузка документа  &1 от &2." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     6813            define variable vhost-code as integer   no-undo.
     6814            define variable vobj-type  as character no-undo.
     6815            define variable vobj-code  as integer   no-undo.
     6816            if not CheckLoad(iDocument,output vhost-code,output vobj-type,output  vobj-code )
     6817            then do:
     6818               PutMes(substitute("Документ &1 от &2 пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     6819               create tt-recid.
     6820               assign
     6821                  tt-recid.orgid = vOrganizationGuid
     6822                  tt-recid.docid = vDocumentid
     6823               .
     6824               return.
     6825            end.
     6826            find first utd where utd.DocumentExt     = vDocumentid
     6827                             and utd.OrganizationExt = vOrganizationGuid
     6828            no-lock no-error  .
     6829            if available utd
     6830            then do:
     6831               if     utd.sts-edi > ObjSrv:Env:Utd:Sts:edi:StatFinesh
     6832                  and iDocument:RevocationStatus ne "RequestsMyRevocation"
     6833               then do:
     6834                  create tt-recid.
     6835                  assign
     6836                     tt-recid.orgid = vOrganizationGuid.
     6837                     tt-recid.docid = vDocumentid
     6838                  .
     6839                  PutMes(substitute("Документ &1 от &2 в конечном статусе. Документ пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     6840               end.
     6841               find current utd exclusive-lock no-error  no-wait  .
     6842               if  not available  utd
     6843               then do:
     6844                  PutMes(substitute("Документ &1 от &2 заблокирован и будет пропущен." ,iDocument:DocumentNumber,iDocument:DocumentDate )).
     6845                  return.
     6846               end.
     6847            end.
     6848            subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     6849            MySeqUtd = ?.
     6850            if     not available  utd
     6851            then do:
     6852               create utd.
     6853               assign
     6854                  utd.DocumentExt      = vDocumentid
     6855                  utd.OrganizationExt  = vOrganizationGuid
     6856                  vNewUtd              = yes
     6857               .
     6858               validate utd.
     6859            end.
     6860            assign
     6861               utd.host-code = vhost-code when vhost-code ne ? and vhost-code ne 0
     6862               utd.obj-code  = vobj-code  when vobj-code  ne ? and vobj-code  ne 0
     6863               utd.obj-type  = vobj-type  when vobj-type  ne ? and vobj-type  ne ""
     6864            .
     6865            setattrutd (utd.db-num,utd.doc-id,"FileName",iDocument:FileName).
     6866            utd.RevocationStatus = iDocument:RevocationStatus.
     6867            utd.RecipientResponseStatus          = iDocument:RecipientResponseStatus.
     6868            utd.TypeId           = iDocument:type.
     6869            utd.CounteragentId   = iDocument:Counteragent:guid.
     6870            utd.CustomDocumentId = iDocument:CustomDocumentId.
     6871            utd.sts-edi = ?.
     6872            utd.DocumentNumber = iDocument:DocumentNumber.
     6873            utd.DocumentDate   = date(iDocument:DocumentDate).
     6874            utd.Timestamp      = datetime(iDocument:Timestamp) .
     6875            utd.ReceiptStatus  = iDocument:RecipientReceiptMetadata:ReceiptStatus.
     6876            utd.Direction      = iDocument:Direction.
     6877            utd.ModifyDate = today.
     6878            utd.flagRI     =    utd.ReceiptStatus eq "GeneralReceiptStatusNotAcceptable" or utd.ReceiptStatus eq "Finished".
     6879            utd.EDocType = if   iDocument:type eq "UniversalTransferDocument"
     6880                             or iDocument:type eq "UniversalTransferDocumentRevision"
     6881                           then objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     6882                           else objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     6883            getdesc(iDocument).
     6884            getdesc(iDocument:Counteragent).
     6885            getdesc(iDocument:RecipientReceiptMetadata).
     6886            getdesc(iDocument:ConfirmationMetadata).
     6887            utd.AmendmentRequested = logical(iDocument:AmendmentRequested).
     6888            if iDocument:type ne "UniversalTransferDocumentRevision"
     6889            then do:
     6890                   utd.Revised = logical(iDocument:Revised).
     6891                   utd.Corrected = logical(iDocument:Corrected).
     6892            end.
     6893            vDocumentChild = iDocument:GetDynamicContent("Seller").
     6894            getdesc(vDocumentChild).
     6895            if   iDocument:type eq "UniversalTransferDocument"
     6896              or iDocument:type eq "UniversalTransferDocumentRevision"
     6897            then do:
     6898               utd.Total = iDocument:total.
     6899               utd.Vat = iDocument:Vat.
     6900            end.
     6901            else do:
     6902               utd.Total = decimal (iDocument:TotalInc) - decimal (iDocument:TotalDec).
     6903               utd.Vat = decimal (iDocument:VatInc) - decimal (iDocument:VatDec).
     6904            end.
     6905            find first utd-lines where utd-lines.db-num     = utd.db-num
     6906                                   and utd-lines.doc-id     = utd.doc-id
     6907                                   no-lock no-error.
     6908            if     (   vNewUtd
     6909                    or utd.Direction ne "Inbound"
     6910                    or not available utd-lines)
     6911               and vDocumentChild ne ?
     6912            then do:
     6913               if utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     6914               then do:
     6915                  if iDocument:version  eq "utd820_05_01_01"
     6916                  then do:
     6917                     vContent = vDocumentChild:UniversalTransferDocument no-error.
     6918                  end.
     6919                  else
     6920                     vContent = vDocumentChild:UniversalTransferDocumentWithHyphens no-error.
     6921                  if vContent ne ?
     6922                  then do:
     6923                     getdesc(vContent).
     6924                     define variable vInfoCount as integer no-undo.
     6925                     define variable vInfos as component-handle no-undo.
     6926                     define variable vInfo as component-handle no-undo.
     6927                     vInfos = vContent:AdditionalInfoId:AdditionalInfo.
     6928                     do vInfoCount = 1 to vInfos:count:
     6929                        vInfo = vInfos:getitem(vInfoCount - 1).
     6930                        getdesc(vInfo).
     6931                        setattrutd (utd.db-num,utd.doc-id,vInfo:id,vInfo:value).
     6932                     end.
     6933                     getdesc(vContent:TransferInfo).
     6934                     getdesc(vContent:TransferInfo:TransferBases).
     6935                     vTransferBasecol = vContent:TransferInfo:TransferBases:TransferBase.
     6936                     getdesc(vTransferBasecol).
     6937                     do vi = 1 to min(vTransferBasecol:count,1):
     6938                        vTransferBase = vTransferBasecol:getitem(vi - 1).
     6939                        getdesc(vTransferBase).
     6940                        utd.BaseDocumentNumber = vTransferBase:BaseDocumentNumber.
     6941                        utd.BaseDocumentName   = vTransferBase:BaseDocumentName.
     6942                        utd.BaseDocumentDate   = date(vTransferBase:BaseDocumentDate).
     6943                        release object vTransferBase.
     6944                     end.
     6945                     release object vTransferBasecol.
     6946                     vSellers = vContent:Sellers.
     6947                     getdesc(vSellers).
     6948                     getdesc(vSellers:Seller:GetItem(0)).
     6949                     if vSellers:Seller:count > 0
     6950                     then
     6951                        getOrganizationInfo(vSellers:Seller:GetItem(0),output utd.cli-inn,output utd.cli-kpp,utd.cli-FnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     6952                     release object vSellers.
     6953                     if iDocument:version  ne "utd820_05_01_01"
     6954                     then
     6955                        utd.cli-FnsParticipantId = vContent:SenderFnsParticipantId.
     6956                     utd.cli-info = vorgname + " " + vAddrOrg.
     6957                     if iDocument:version  eq "utd820_05_01_01"
     6958                     then do:
     6959                        getOrganizationInfo(vContent:Buyers:Buyer:GetItem(0),output utd.obj-inn,output utd.obj-kpp,utd.obj-FnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     6960                     end.
     6961                     else do:
     6962                        vConsignees = vContent:Consignees.
     6963                        getdesc(vConsignees).
     6964                        if vConsignees:Consignee:count > 0
     6965                        then do:
     6966                           getOrganizationInfo(vConsignees:Consignee:GetItem(0),output utd.obj-inn,output utd.obj-kpp,utd.obj-FnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     6967                           setattrutd (utd.db-num,utd.doc-id,"Consignee_ИнфДляУчаст",vAdditionalInfo).
     6968                        end.
     6969                        utd.obj-FnsParticipantId = vContent:RecipientFnsParticipantId.
     6970                        release object vConsignees.
     6971                     end.
     6972                     utd.obj-info = vorgname + " " + vAddrOrg + " ИНН: " + utd.obj-inn + " КПП: " + utd.obj-kpp.
     6973                     vInvoiceTable = vContent:Table.
     6974                     getdesc(vInvoiceTable).
     6975                     vItems = vInvoiceTable:Item.
     6976                     release object vInvoiceTable.
     6977                     do vi = 1 to vItems:Count:
     6978                        vExtendedInvoiceItem= vItems:GetItem(vi - 1).
     6979                        getdesc(vExtendedInvoiceItem).
     6980                        find first utd-lines where utd-lines.db-num     = utd.db-num
     6981                                               and utd-lines.doc-id     = utd.doc-id
     6982                                               and utd-lines.LineNum    = vi
     6983                        exclusive-lock no-error.
