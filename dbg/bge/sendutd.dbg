      873   initial "@(#)$Workfile$ $Revision$".
      874   procedure xmlchar-test :
      875   define input parameter p-in-string          as character        no-undo.
      876   define output parameter p-out-string-enc    as character        no-undo.
      877   define output parameter p-out-string-dec    as character        no-undo.
      878   do
      879   on error undo, return error
      880   :
      881          run xmlchar-encode in this-procedure
      882       (
      883             input p-in-string
      884           , output p-out-string-enc
      885       ).
      886          run xmlchar-decode in this-procedure
      887       (
      888             input p-out-string-enc
      889           , output p-out-string-dec
      890       ).
      891   end.
      892   end .
      893   procedure xmlchar-encode :
      894   define input parameter p-in-string      as character        no-undo.
      895   define output parameter p-out-string    as character        no-undo.
      896       define variable v-position      as integer      no-undo.
      897       define variable v-current-char  as character    no-undo.
      898   do
      899   on error undo, return error
      900   :
      901       assign
      902           p-out-string = "":U
      903       .
      904       case p-in-string
      905       :
      906           when ?
      907           then do:
      908               assign
      909                   p-out-string = "?":U
      910               .
      911           end.
      912           when "?":U
      913           then do:
      914               assign
      915                   p-out-string = "&#63;":U
      916               .
      917           end.
      918           otherwise do:
      919               do v-position = 1 to length( p-in-string )
      920               :
      921                   assign
      922                       v-current-char = substring( p-in-string, v-position, 1 )
      923                   .
      924                   case v-current-char
      925                   :
      926                       when "&":U
      927                       then do:
      928                           assign
      929                               p-out-string = p-out-string + "&amp;":U
      930                           .
      931                       end.
      932                       when ">":U
      933                       then do:
      934                           assign
      935                               p-out-string = p-out-string + "&gt;":U
      936                           .
      937                       end.
      938                       when "<":U
      939                       then do:
      940                           assign
      941                               p-out-string = p-out-string + "&lt;":U
      942                           .
      943                       end.
      944                       when "'":U
      945                       then do:
      946                           assign
      947                               p-out-string = p-out-string + "&apos;":U
      948                           .
      949                       end.
      950                       when '"':U
      951                       then do:
      952                           assign
      953                               p-out-string = p-out-string + "&quot;":U
      954                           .
      955                       end.
      956                       when chr(1)
      957                       then do:
      958                           assign
      959                               p-out-string = p-out-string + "":U
      960                           .
      961                       end.
      962                       when chr(2)
      963                       then do:
      964                           assign
      965                               p-out-string = p-out-string + "":U
      966                           .
      967                       end.
      968                       when chr(3)
      969                       then do:
      970                           assign
      971                               p-out-string = p-out-string + "":U
      972                           .
      973                       end.
      974                       when chr(4)
      975                       then do:
      976                           assign
      977                               p-out-string = p-out-string + "":U
      978                           .
      979                       end.
      980                       when chr(5)
      981                       then do:
      982                           assign
      983                               p-out-string = p-out-string + "":U
      984                           .
      985                       end.
      986                       when chr(6)
      987                       then do:
      988                           assign
      989                               p-out-string = p-out-string + "":U
      990                           .
      991                       end.
      992                       when chr(7)
      993                       then do:
      994                           assign
      995                               p-out-string = p-out-string + "":U
      996                           .
      997                       end.
      998                       when chr(8)
      999                       then do:
     1000                           assign
     1001                               p-out-string = p-out-string + "":U
     1002                           .
     1003                       end.
     1004                       when chr(9)
     1005                       then do:
     1006                           assign
     1007                               p-out-string = p-out-string + "":U
     1008                           .
     1009                       end.
     1010                       when chr(29)
     1011                       then do:
     1012                           assign
     1013                               p-out-string = p-out-string + "":U
     1014                           .
     1015                       end.
     1016                       when chr(10)
     1017                       then do:
     1018                           assign
     1019                               p-out-string = p-out-string + "&#10;":U
     1020                           .
     1021                       end.
     1022                       when chr(13)
     1023                       then do:
     1024                           assign
     1025                               p-out-string = p-out-string + "&#13;":U
     1026                           .
     1027                       end.
     1028                       otherwise do:
     1029                           assign
     1030                               p-out-string = p-out-string + v-current-char
     1031                           .
     1032                       end.
     1033                   end case.
     1034               end.
     1035           end.
     1036       end case.
     1037   end.
     1038   end .
     1039   procedure xmlchar-encode-1c :
     1040   define input parameter p-in-string      as character        no-undo.
     1041   define output parameter p-out-string    as character        no-undo.
     1042       define variable v-position      as integer      no-undo.
     1043       define variable v-current-char  as character    no-undo.
     1044   do
     1045   on error undo, return error
     1046   :
     1047       assign
     1048           p-out-string = "":U
     1049       .
     1050       case p-in-string
     1051       :
     1052           when ?
     1053           then do:
     1054               assign
     1055                   p-out-string = "?":U
     1056               .
     1057           end.
     1058           otherwise do:
     1059               do v-position = 1 to length( p-in-string )
     1060               :
     1061                   assign
     1062                       v-current-char = substring( p-in-string, v-position, 1 )
     1063                   .
     1064                   case v-current-char
     1065                   :
     1066                       when chr(1)
     1067                       then do:
     1068                           assign
     1069                               p-out-string = p-out-string + " ":U
     1070                           .
     1071                       end.
     1072                       when chr(2)
     1073                       then do:
     1074                           assign
     1075                               p-out-string = p-out-string + " ":U
     1076                           .
     1077                       end.
     1078                       when chr(3)
     1079                       then do:
     1080                           assign
     1081                               p-out-string = p-out-string + " ":U
     1082                           .
     1083                       end.
     1084                       when chr(4)
     1085                       then do:
     1086                           assign
     1087                               p-out-string = p-out-string + " ":U
     1088                           .
     1089                       end.
     1090                       when chr(5)
     1091                       then do:
     1092                           assign
     1093                               p-out-string = p-out-string + " ":U
     1094                           .
     1095                       end.
     1096                       when chr(6)
     1097                       then do:
     1098                           assign
     1099                               p-out-string = p-out-string + " ":U
     1100                           .
     1101                       end.
     1102                       when chr(7)
     1103                       then do:
     1104                           assign
     1105                               p-out-string = p-out-string + " ":U
     1106                           .
     1107                       end.
     1108                       when chr(8)
     1109                       then do:
     1110                           assign
     1111                               p-out-string = p-out-string + " ":U
     1112                           .
     1113                       end.
     1114                       when chr(9)
     1115                       then do:
     1116                           assign
     1117                               p-out-string = p-out-string + " ":U
     1118                           .
     1119                       end.
     1120                       when chr(29)
     1121                       then do:
     1122                           assign
     1123                               p-out-string = p-out-string + " ":U
     1124                           .
     1125                       end.
     1126                       when chr(10)
     1127                       then do:
     1128                           assign
     1129                               p-out-string = p-out-string + " ":U
     1130                           .
     1131                       end.
     1132                       when chr(13)
     1133                       then do:
     1134                           assign
     1135                               p-out-string = p-out-string + " ":U
     1136                           .
     1137                       end.
     1138                       otherwise do:
     1139                           assign
     1140                               p-out-string = p-out-string + v-current-char
     1141                           .
     1142                       end.
     1143                   end case.
     1144               end.
     1145           end.
     1146       end case.
     1147   end.
     1148   end .
     1149   procedure xmlchar-decode :
     1150   define input parameter p-in-string      as character        no-undo.
     1151   define output parameter p-out-string    as character        no-undo.
     1152       define variable v-position      as integer      no-undo.
     1153       define variable v-last-position as integer      no-undo.
     1154       define variable v-temp-integer  as integer      no-undo.
     1155       define variable v-current-char  as character    no-undo.
     1156       define variable v-next-char     as character    no-undo.
     1157       define variable v-success       as logical      no-undo.
     1158   do
     1159   on error undo, return error
     1160   :
     1161       assign
     1162           p-out-string = "":U
     1163           v-position   = 0
     1164       .
     1165       replace-cycle:
     1166       do while yes
     1167       on error undo, return error
     1168       :
     1169           assign
     1170               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     1171           .
     1172           if v-last-position <= v-position
     1173           then do:
     1174               if v-position = 0
     1175               then do:
     1176                   assign
     1177                       p-out-string = p-in-string
     1178                   .
     1179               end.
     1180               else do:
     1181                   assign
     1182                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     1183                   .
     1184               end.
     1185               leave replace-cycle.
     1186           end.
     1187           else do:
     1188               assign
     1189                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     1190                   v-position      = v-last-position
     1191                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     1192               .
     1193               if v-current-char = "#":U
     1194               then do:
     1195                   assign
     1196                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     1197                   .
     1198                   if v-last-position > 0
     1199                   then do:
     1200                       run xmlchar-read-integer in this-procedure
     1201                        (
     1202                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     1203                           , output v-temp-integer
     1204                           , output v-success
     1205                       ).
     1206                       if v-success = yes
     1207                       and v-temp-integer >= 1
     1208                       and v-temp-integer <= 255
     1209                       then do:
     1210                           assign
     1211                               p-out-string = p-out-string + chr( v-temp-integer )
     1212                               v-position   = v-last-position + 1
     1213                           .
     1214                       end.
     1215                       else do:
     1216                           assign
     1217                               p-out-string = p-out-string + "&":U
     1218                               v-position   = v-position   + 1
     1219                           .
     1220                       end.
     1221                   end.
     1222                   else do:
     1223                       assign
     1224                           p-out-string = p-out-string + "&":U
     1225                           v-position   = v-position   + 1
     1226                       .
     1227                   end.
     1228               end.
     1229               else do:
     1230                   case substring( p-in-string, v-position + 1, 3 )
     1231                   :
     1232                       when "lt;":U
     1233                       then do:
     1234                           assign
     1235                               p-out-string = p-out-string + "<":U
     1236                               v-position   = v-position   + 3
     1237                           .
     1238                       end.
     1239                       when "gt;":U
     1240                       then do:
     1241                           assign
     1242                               p-out-string = p-out-string + ">":U
     1243                               v-position   = v-position   + 3
     1244                           .
     1245                       end.
     1246                       otherwise do:
     1247                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     1248                           then do:
     1249                               assign
     1250                                   p-out-string = p-out-string + "&":U
     1251                                   v-position   = v-position   + 4
     1252                               .
     1253                           end.
     1254                           else do:
     1255                               case substring( p-in-string, v-position + 1, 5 )
     1256                               :
     1257                                   when "quot;":U
     1258                                   then do:
     1259                                       assign
     1260                                           p-out-string = p-out-string + '"':U
     1261                                           v-position   = v-position   + 5
     1262                                       .
     1263                                   end.
     1264                                   when "apos;":U
     1265                                   then do:
     1266                                       assign
     1267                                           p-out-string = p-out-string + "'":U
     1268                                           v-position   = v-position   + 5
     1269                                       .
     1270                                   end.
     1271                                   otherwise do:
     1272                                       assign
     1273                                           p-out-string = p-out-string + "&":U
     1274                                       .
     1275                                   end.
     1276                               end case.
     1277                           end.
     1278                       end.
     1279                   end case.
     1280               end.
     1281           end.
     1282       end.
     1283   end.
     1284   end .
     1285   procedure xmlchar-read-integer :
     1286   define input parameter p-input-string      as character        no-undo.
     1287   define output parameter p-output-integer   as integer          no-undo.
     1288   define output parameter p-success       as logical          no-undo.
     1289   do
     1290   on error undo, return error
     1291   :
     1292       assign
     1293           p-output-integer = integer( p-input-string )
     1294       no-error.
     1295       if error-status :error
     1296       then do:
     1297           assign
     1298               p-success           = no
     1299               p-output-integer    = 0
     1300           .
     1301       end.
     1302       else do:
     1303           assign
     1304               p-success           = yes
     1305           .
     1306       end.
     1307   end.
     1308   end.
     1309   define variable mMRCCode  as logical    no-undo.
     1310   define variable mTypeMark as character  no-undo.
     1311   function IS-NeedMark returns logical
     1312   ( input ib-code as integer  ,
     1313     input ib-str as character ):
     1314      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     1315      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     1316                                    and buf_prod-bc-attr.b-str  eq ib-str
     1317                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     1318        no-lock no-error.
     1319      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     1320   end.
     1321   function repTegforDm return char
     1322   (iDM as char ):
     1323       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     1324       define variable vteg as character no-undo.
     1325       define variable oDM as character no-undo.
     1326       define variable vi as integer no-undo.
     1327       oDM = iDm.
     1328       do vi = 1 to num-entries(vTeglist):
     1329          vTeg = entry(vi,vTeglist).
     1330          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     1331       end.
     1332       return oDM.
     1333   end.
     1334   function repSpecSimbforDm return char
     1335   (iDM as char ):
     1336       define variable oDM as character no-undo.
     1337     run
     1338       xmlchar-decode(iDM, output oDM).
     1339     return repTegforDm (oDM).
     1340   end.
     1341   function CheckGtin return logical
     1342   (iGtin as char):
     1343      define variable bar_code as character no-undo.
     1344      define variable vGtin as logical no-undo init "yes".
     1345      if length(iGtin) eq 14
     1346      then do:
     1347         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     1348         run str/chk-sum.p
     1349          (input-output bar_code ) no-error .
     1350         if iGtin ne  bar_code
     1351         then
     1352            vGtin = no.
     1353      end.
     1354      else
     1355         vGtin = no.
     1356      return vgtin.
     1357   end.
     1358   function repSpecSimbforXlm return char
     1359   (iDM as char ):
     1360       iDM = replace(iDM,chr(29),"").
     1361       return iDM.
     1362   end.
     1363   function getGtinByDM return char
     1364   (IDM as char):
     1365      define variable VTXT as char no-undo.
     1366      define variable vGtin as char no-undo.
     1367      vTXt = IdM.
     1368      vGtin = IDM.
     1369      if    length(vtxt) > 14
     1370      then do:
     1371         if   vtxt begins "(01)"
     1372                or vtxt begins "(02)"
     1373         then
     1374            vGtin = substring(vtxt,5,14).
     1375         else if   (vtxt begins "01"
     1376                or vtxt begins "02" )
     1377                and (   (    substring(iDm,17,2) eq "21"
     1378                         and length(vtxt) >= 21)
     1379                     or substring(iDm,17,2) eq "37"
     1380                     or substring(iDm,17,4) eq "(37)" )
     1381         then do:
     1382            vGtin = substring(vtxt,3,14).
     1383            if not checkGtin(vGtin)
     1384            then
     1385               vGtin = substring(vtxt,1,14).
     1386         end.
     1387         else if     length(vtxt) eq 14 + 7 + 4 + 4
     1388             or length(vtxt) eq 14 + 7 + 4
     1389             or length(vtxt) eq 14 + 7
     1390         then
     1391            vGtin = substring(vtxt,1,14).
     1392      end.
     1393      if not checkGtin(vGtin)
     1394      then
     1395         vGtin = "".
     1396      return vgtin.
     1397   end.
     1398   function getGdsCodeByGtin return int
     1399   (iGtin as char):
     1400      define buffer prod-bc  for ub.prod-bc.
     1401      define buffer bar-code for ub.bar-code.
     1402      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     1403      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1404      return if avail bar-code then bar-code.gds-code else ?.
     1405   end.
     1406   function getQntyCodeByGtin return decimal
     1407   (iGtin as char):
     1408      define buffer prod-bc  for ub.prod-bc.
     1409      define buffer bar-code for ub.bar-code.
     1410      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     1411      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     1412      return if avail bar-code then bar-code.cli-base-rate else ?.
     1413   end.
     1414   function getGdsCodeByDM return int
     1415   (iDm as char):
     1416      define variable vGtin as char no-undo.
     1417      define buffer prod-bc for ub.prod-bc.
     1418      vGtin  = getGtinByDM (IDM ).
     1419      return getGdsCodeByGtin (vGtin).
     1420   end.
     1421   function ChekTypeMarkByGds return logical
     1422   (iGds-code as integer ):
     1423      define buffer goods-attr for ub.goods-attr.
     1424      find first goods-attr where goods-attr.gds-code   = iGds-code
     1425                              and goods-attr.attr-code  = 'mark-type':U
     1426      no-lock no-error.
     1427      if available goods-attr
     1428      then do:
     1429         mTypeMark = goods-attr.attr-value.
     1430         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     1431           .
     1432      end.
     1433      else
     1434         return no.
     1435   end.
     1436   function ChekTypeMarkByDm return logical
     1437   (iDM as char ):
     1438      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     1439   end.
     1440   function ChekTypeMarkByGtin return logical
     1441   (iGtin as char ):
     1442      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     1443   end.
     1444   function GetNextElement return character
     1445     (input iAllTeg        as logical
     1446     ,output oteg          as character
     1447     ,output otegval       as character
     1448     ,input-output pstr    as character
     1449      ):
     1450        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     1451        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     1452        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     1453        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     1454        define variable vTeg as character no-undo.
     1455        define variable vLength as integer no-undo.
     1456        define variable vi as integer no-undo.
     1457        define variable vj as integer no-undo.
     1458        define buffer code for ub.code.
     1459        find first code where Code.parent eq "MarkType"
     1460                          and Code.CodeValue   eq mTypeMark
     1461                          no-lock no-error.
     1462        if     available code
     1463           and Code.misc1 ne ""
     1464           and Code.misc1 ne ?
     1465        then do:
     1466           integer (Code.misc1) no-error.
     1467           if not error-status:error
     1468           then
     1469             entry (4,vlistleng) = Code.misc1.
     1470        end.
     1471        if iAllTeg
     1472        then
     1473           assign
     1474              vlistElem     = vlistElem    + vlistElemDop
     1475              vlistleng     = vlistleng    + vlistlengDop
     1476           .
     1477        else if mMRCCode
     1478        then
     1479           assign
     1480              vlistElem     = vlistElem    + ",(8005),8005"
     1481              vlistleng     = vlistleng    + ",000006,0006"
     1482           .
     1483       block-elem:
     1484       do vi = 1 to num-entries(vlistElem):
     1485          vTeg = entry(vi,vlistElem).
     1486          if pstr begins vTeg
     1487          then do:
     1488             if    vTeg eq "21"
     1489             then
     1490                vLength = index(pstr,chr(29)) - 2 no-error.
     1491             if vLength  <= 0
     1492             then
     1493                vLength = int(entry(vi,vlistleng)).
     1494             otegval = substring (pstr,length(vteg) + 1, vLength).
     1495             oteg = replace(replace(vteg,")",""),"(","").
     1496             vTeg = vteg + otegval.
     1497             otegval = replace(otegval,chr(29),"").
     1498             oteg = replace(replace(oteg,")",""),"(","").
     1499             pstr = substring (pstr,length(vTeg)+ 1).
     1500             vTeg = replace(vTeg,chr(29),"").
     1501             leave block-elem.
     1502          end.
     1503          else
     1504             vTeg = "".
     1505       end.
     1506       return vteg.
     1507   end.
     1508   function GetCodeIdent return character
     1509   (iDm as char):
     1510      define variable Velement   as character no-undo init "first".
     1511      define variable oCodeIdent as character no-undo.
     1512      define variable vteg as character no-undo.
     1513      define variable vtegval as character no-undo.
     1514      define variable vGtin as character no-undo.
     1515      define buffer marking for ub.marking.
     1516      for first marking no-lock where
     1517                marking.mark eq iDm
     1518            and marking.unit-ext = "LEVEL2"
     1519      :
     1520        return iDm.
     1521      end.
     1522      vGtin  = getGtinByDM (iDm ).
     1523      ChekTypeMarkByDm(idm).
     1524      if iDm begins 'tech_':U
     1525      then
     1526         oCodeIdent = iDm.
     1527      else if length(iDm) < 21
     1528      then do:
     1529         find first marking where marking.mark eq idm
     1530         no-lock no-error.
     1531         oCodeIdent = if available marking then marking.mark else  ?.
     1532      end.
     1533      else if     length(iDm) eq 29
     1534         and not iDm begins "01"
     1535         and not iDm begins "02"
     1536      then
     1537         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1538      else  if     length(iDm) >= 24
     1539               and (  iDm begins "01"
     1540                   or iDm begins "02")
     1541               and  substring(iDm,17,2) ne "21"
     1542      then do:
     1543         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1544                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1545         then
     1546            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1547         else
     1548            oCodeIdent = iDM.
     1549      end.
     1550      else  if     (   length(iDm) eq 25
     1551                    or length(iDm) eq 21)
     1552               and (not iDm begins "01"
     1553               and  not iDm begins "02")
     1554      then
     1555         oCodeIdent = substring(iDm,1,21).
     1556      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1557      then
     1558         oCodeIdent = substring(iDm,1,21).
     1559      else do while Velement ne "" and idm ne "":
     1560         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1561         oCodeIdent = oCodeIdent + Velement.
     1562      end.
     1563      return oCodeIdent.
     1564   end.
     1565   function GetTegCod return character
     1566   (icodeIdent as char, iTeg as char):
     1567      define variable Velement   as character no-undo init "first".
     1568      define variable oTeg as character no-undo init ?.
     1569      define variable vteg as character no-undo.
     1570      define variable vtegval as character no-undo.
     1571      if     ((length(icodeIdent) eq 21
     1572         and not icodeIdent begins "01"
     1573         and not icodeIdent begins "02")
     1574         or
     1575             ( length(icodeIdent) eq 25
     1576               and not icodeIdent begins "01"
     1577               and not icodeIdent begins "02"))
     1578      then do:
     1579         if iTeg eq "01" or iTeg eq "02"
     1580         then
     1581            oTeg = substring(icodeIdent,1,21).
     1582         else  if  iTeg eq "21"
     1583         then
     1584            oTeg = substring(icodeIdent,15,7).
     1585      end.
     1586      else do:
     1587         ChekTypeMarkByDm(icodeIdent).
     1588         block-teg:
     1589            do while Velement ne "" and icodeIdent ne "":
     1590            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1591            if    Velement begins iTeg
     1592               or Velement begins "(" + iTeg + ")"
     1593            then do:
     1594               oTeg = vtegval.
     1595               leave block-teg.
     1596            end.
     1597         end.
     1598      end.
     1599      return oTeg.
     1600   end.
     1601   function isOAD return logical
     1602   (icodeIdent as character):
     1603      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1604   end.
     1605   function isMark return logical
     1606   (icodeIdent as character):
     1607      define buffer buf_marking for ub.marking.
     1608      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1609             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1610   end.
     1611   function addBracketForCode return character
     1612   (icodeIdent as char):
     1613      define variable Velement   as character no-undo init "first".
     1614      define variable oTeg as character no-undo.
     1615      define variable vteg as character no-undo.
     1616      define variable vtegval as character no-undo.
     1617      define buffer marking for ub.marking.
     1618      find first marking no-lock where
     1619                 marking.mark begins icodeIdent no-error.
     1620      if    not ChekTypeMarkByDm(icodeIdent)
     1621         or length(icodeIdent) le 24
     1622         or (avail marking and marking.unit-ext = "LEVEL2")
     1623      then
     1624         oTeg = icodeIdent.
     1625      else do:
     1626         if (  icodeIdent begins "01"
     1627            or icodeIdent begins "02"
     1628            ) and CheckGtin(substring (icodeIdent,3,14))
     1629            and substring (icodeIdent,17,2) eq "21"
     1630         then do:
     1631            mMRCCode = yes.
     1632            ChekTypeMarkByDm(icodeIdent).
     1633            block-teg:
     1634            do while Velement ne "" and icodeIdent ne "":
     1635               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1636               if vteg ne ""
     1637               then
     1638                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1639            end.
     1640            mMRCCode = no.
     1641         end.
     1642         else do:
     1643            oTeg = icodeIdent.
     1644         end.
     1645      end.
     1646      return oTeg.
     1647   end.
     1648   function getlevelByCodId return int
     1649   (iCode as char):
     1650      define variable vLength as int no-undo.
     1651      define variable vLevel  as int no-undo.
     1652      if not ChekTypeMarkByDM (icode) then return ?.
     1653      vLength = length(iCode).
     1654      if    vLength eq 18
     1655         or vLength eq 20
     1656      then
     1657         Vlevel = 4.
     1658      else if vLength eq 21
     1659      then
     1660         Vlevel = 1.
     1661      else if vLength eq 25
     1662      then do:
     1663         if  iCode begins "01"
     1664         then
     1665            Vlevel = 3.
     1666         else
     1667            Vlevel = 1.
     1668      end.
     1669      else if     vLength >= 26
     1670              and vLength <= 46
     1671      then do:
     1672         if    substring(iCode,17,2) eq "11"
     1673            or substring(iCode,17,2) eq "13"
     1674            or (    substring(iCode,17,2) eq "21"
     1675                and vLength >= 33
     1676                and substring(iCode,26,4) ne "8005")
     1677         then
     1678            Vlevel = 4.
     1679         else if    vLength eq 31
     1680                 or vLength eq 38
     1681                 or vLength eq 39
     1682                 or vLength eq 45
     1683         then
     1684            Vlevel = 1.
     1685         else if    vLength eq 35
     1686                 or vLength eq 43
     1687         then
     1688            Vlevel = 3.
     1689         else
     1690            Vlevel = ?.
     1691      end.
     1692      else
     1693         Vlevel = ?.
     1694      return Vlevel.
     1695   end.
     1696   function getLevelMotpBycodid return character
     1697   (iDm as char):
     1698      define variable vLevel as integer no-undo.
     1699      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1700      vLevel = getlevelByCodId(iDm).
     1701      if    vLevel eq ?
     1702         or vLevel < 1
     1703         or vLevel > 6
     1704      then
     1705         return ?.
     1706      else
     1707         return entry(vlevel,vList).
     1708   end.
     1709   function getLevelUTDByLevelMotp return character
     1710   (iUnit as char):
     1711      define variable vLevel as integer no-undo.
     1712      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1713      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1714      vLevel = lookup(iUnit,vListMOTP).
     1715      if    vLevel eq ?
     1716         or vLevel < 1
     1717         or vLevel > 4
     1718      then
     1719         return ?.
     1720      else
     1721         return entry(vlevel,vListutd).
     1722   end.
     1723   function getLevelMotpByDM return character
     1724   (iDm as char):
     1725      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1726   end.
     1727   function getLevelUTDByCodId return character
     1728   (iDm as char):
     1729      define variable vLevel as integer no-undo.
     1730      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1731      vLevel = getlevelByCodId(iDm).
     1732      if    vLevel eq ?
     1733         or vLevel < 1
     1734         or vLevel > 4
     1735      then
     1736         return ?.
     1737      else
     1738         return entry(vlevel,vList).
     1739   end.
     1740   function getLevelUTDByDM return character
     1741   (iDm as char):
     1742      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1743   end.
     1744   define variable mNotMarkQnty as logical no-undo.
     1745   function getQntyUTDByCodId return decimal
     1746   (iDM as char):
     1747      define variable vLevel as integer no-undo.
     1748      define variable vList as character no-undo init "1,5,10,500".
     1749      define variable vGtin as character no-undo.
     1750      define variable vqnty as decimal no-undo init ?.
     1751      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1752      if vqnty eq ?
     1753      then do:
     1754         if not mNotMarkQnty
     1755         then do:
     1756            define buffer marking for ub.marking.
     1757            define variable vCodident as character no-undo.
     1758            vCodident = GetCodeIdent(idm).
     1759            find first marking where marking.mark begins vCodident no-lock no-error.
     1760            if     available marking
     1761               and marking.box-qnty ne ?
     1762            then
     1763               return marking.box-qnty.
     1764         end.
     1765         vGtin = getGtinByDm(iDM).
     1766         if ChekTypeMarkByGtin (vGtin)
     1767         then do:
     1768            vLevel = getlevelByCodId(iDM).
     1769            if     vLevel >= 1
     1770               and vLevel <= 4
     1771            then
     1772               vqnty = int(entry(vlevel,vList)).
     1773         end.
     1774         else
     1775            vqnty = getQntyCodeByGtin(vgtin).
     1776      end.
     1777      return vqnty.
     1778   end.
     1779   function getQntyUTDByDM return decimal
     1780   (iDm as char):
     1781      define variable vDM as character no-undo.
     1782      if     length (iDm) ne 25
     1783         and length (iDm) ne 29
     1784         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1785      then
     1786         vDM = substring (iDm,1,length (iDm) - 6 ).
     1787      else
     1788         vDM = substring (iDm,1,length (iDm) - 4 ).
     1789      return getQntyUTDByCodId(vDM).
     1790   end.
     1791   function getMRC4 return decimal
     1792   (iMRC as char):
     1793      define variable oMrc     as decimal no-undo init ?.
     1794      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1795      define variable vi       as integer no-undo.
     1796      define variable vfound   as integer no-undo.
     1797      define variable vposStart   as integer no-undo.
     1798      do:
     1799      OMRc = 0.
     1800      do vi = 1 to 4:
     1801         define variable vsimb as character no-undo.
     1802         vsimb = substring(iMRC,vi,1).
     1803         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1804         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1805         if vfound > 0
     1806         then
     1807            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1808         end.
     1809         OMRc = OMRc / 100.
     1810      end.
     1811      return OMRc.
     1812   end.
     1813   function getMRCByDM return decimal
     1814   (iDm as char):
     1815      define variable vMRC     as character no-undo.
     1816      define variable oMrc     as decimal no-undo init ?.
     1817      define variable Velement as character no-undo init "empty".
     1818      define variable vteg as character no-undo.
     1819      define variable vtegval as character no-undo.
     1820      if    length(idm) eq 14 + 7 + 4 + 4
     1821         or length(idm) eq 14 + 7 + 4
     1822      then do:
     1823         vMRC = substring(idm,22,4).
     1824         omrc = getMRC4(vMRC).
     1825      end.
     1826      else do:
     1827          ChekTypeMarkByDm(iDm).
     1828          block-mrc:
     1829          do while Velement ne "" and idm ne "":
     1830             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1831             if Velement begins "8005"
     1832             then do:
     1833                vMRC = substring(Velement,5,6).
     1834                leave block-mrc.
     1835             end.
     1836             else if Velement begins "(8005)"
     1837             then do:
     1838                vMRC = substring(Velement,7,6).
     1839                leave block-mrc.
     1840             end.
     1841          end.
     1842          if vMRC ne ""
     1843          then
     1844             OMRc = dec(vmrc) / 100 no-error.
     1845      end.
     1846      return OMRc.
     1847   end.
     1848   function MoveDate return Date
     1849   (idate as date,
     1850    iMonth as int64):
     1851      define variable vMonth   as int64 no-undo.
     1852      define variable vYear    as int64 no-undo.
     1853      define variable vDateNew as date  no-undo.
     1854       define variable vDay     as int64 no-undo.
     1855       vMonth = month(iDate) + iMonth.
     1856       vYear =  year(iDate).
     1857       if vMonth <= 0
     1858       then assign
     1859          vMonth = vMonth + 12
     1860           vYear  = vYear - 1
     1861       .
     1862       else if vMonth > 12
     1863       then assign
     1864          vMonth = vMonth - 12
     1865           vYear  = vYear + 1
     1866       .
     1867       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1868       do while error-status:error eq yes:
     1869          VDay = vDay + 1.
     1870          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1871       end.
     1872       if VDay > 0
     1873       then
     1874          vDateNew + 1.
     1875       return vDateNew.
     1876   end.
     1877   procedure checkEMRC:
     1878   define input  parameter iDm as character no-undo.
     1879   define output parameter vok as logical   no-undo init yes.
     1880      define variable v-value-emrc as character no-undo.
     1881      define variable v-type-emrc  as character no-undo.
     1882      define variable vDateIso     as character no-undo.
     1883      define variable vMRC         as decimal no-undo.
     1884      define variable vqnty        as decimal no-undo.
     1885      define variable vPrice       as decimal no-undo.
     1886      define variable vparent      as character no-undo.
     1887      define variable vgds-code    as integer no-undo.
     1888      define buffer code for ub.code.
     1889      vMRC = getMRCByDM(iDm).
     1890      if vMRC > 0
     1891      then do:
     1892         vgds-code = getGdsCodeByDM(iDm).
     1893         vqnty     = getQntyUTDByDM(iDm).
     1894               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1895            (
     1896             input   vgds-code
     1897            ,input   'emrc-type':U
     1898            ,output   v-value-emrc
     1899            ,output   v-type-emrc
     1900          ) no-error.
     1901          if     v-value-emrc ne ""
     1902             and v-value-emrc ne ?
     1903          then do:
     1904             vDateIso = iso-date(today).
     1905             vPrice = vMRC / vqnty.
     1906             vparent ="emc" + chr(4) + v-value-emrc.
     1907             find last code where Code.parent      eq vparent
     1908                              and Code.code        le vDateIso
     1909                              and code.status_  eq 0
     1910             no-lock no-error.
     1911             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1912             then
     1913                vOk = true .
     1914             else do:
     1915                 define variable vText      as character no-undo.
     1916                 define variable vDate      as date no-undo.
     1917                 define variable vDateLast  as character no-undo.
     1918                 define variable vDateFirst as character no-undo.
     1919                 define variable vDate3     as date no-undo.
     1920                 vdate = date(code.misc1).
     1921                 vDateLast = code.misc1.
     1922                 vDate3 = MoveDate(today, - 3 ).
     1923                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1924                                      string(vDate3  , "99/99/9999"),
     1925                                      string(vDate   , "99/99/9999")
     1926                                      ).
     1927                 vdateIso = iso-date(vdate3).
     1928                 find last code  where Code.parent      eq vparent
     1929                                   and Code.code        le vDateIso
     1930                                   and code.status_  eq 0 no-lock no-error.
     1931                 if available code
     1932                 then
     1933                    vDateIso = code.code.
     1934                 vDateFirst = vDateIso.
     1935                 vDateLast = iso-date(vdate).
     1936                 define variable vGood as logical no-undo.
     1937                 define variable vDateSale as date no-undo.
     1938                 define buffer bcode for code.
     1939                 for last code where Code.parent   eq vparent
     1940                                 and code.status_  eq 0
     1941                                 and code.code     < vDateLast
     1942                                 and code.code     >= vDateFirst
     1943                 no-lock:
     1944                    find first bcode where bCode.parent   eq vparent
     1945                                       and bcode.status_  eq 0
     1946                                       and bcode.code     > code.code no-lock no-error.
     1947                    if available bcode
     1948                    then do:
     1949                       if vPrice < dec(Code.CodeValue)
     1950                       then
     1951                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1952                                                     chr(10),
     1953                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1954                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1955                                                     ).
     1956                       else do:
     1957                          vGood = yes.
     1958                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1959                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1960                                                     chr(10),
     1961                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1962                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1963                                                     string(         vDateSale            ,"99/99/9999"),
     1964                                                     string(vDateSale - today)
     1965                                                     ).
     1966                       end.
     1967                    end.
     1968                 end.
     1969                 if vgood
     1970                 then do:
     1971                    define variable choice as integer no-undo .
     1972                    run gbl/d-askw.w (input "Уточнение"
     1973                           ,input  vText
     1974                           ,input "|"
     1975                           ,input "Принять|Вернуть"
     1976                           ,input "Принять данный товар|Вернуть товар постащику"
     1977                           ,input 1
     1978                           ,input 2
     1979                           ,output choice) no-error.
     1980                    vok = choice eq 1.
     1981                 end.
     1982                 else
     1983                    vok =false.
     1984             end.
     1985          end.
     1986      end.
     1987   end.
     1988   function addGs2Mark return character
     1989   (iMark as char):
     1990      define variable vDM   as character no-undo.
     1991      define variable vIdx  as integer   no-undo.
     1992      if index(iMark,chr(29),1) > 0
     1993      then return iMark.
     1994      if substring(iMark,26,4) = "8005" then
     1995      do:
     1996        vIdx = index(iMark,"93",26 + 4 + 5).
     1997        if vIdx > 1 then do:
     1998          vDM = substitute("&1&4&2&4&3",
     1999                           substring(iMark,1,25),
     2000                           substring(iMark,26,vIdx - 25 - 1),
     2001                           substring(iMark,vIdx),
     2002                           chr(29)) no-error.
     2003          vIdx = index(vDm,"240",vIdx + 4).
     2004          if vIdx > 0 then
     2005          do:
     2006            vDM = substitute("&1&3&2",
     2007                             substring(vDm,1,vIdx - 1),
     2008                             substring(vDm,vIdx),
     2009                             chr(29)) no-error.
     2010          end.
     2011        end.
     2012        else
     2013          vDM = substitute("&1&3&2",
     2014                           substring(iMark,1,25),
     2015                           substring(iMark,26),
     2016                           chr(29)) no-error.
     2017      end.
     2018      else if substring(iMark,32,2) = "91" then
     2019      do:
     2020        vIdx = index(iMark,"92",32).
     2021        if vIdx > 1 then
     2022          vDM = substitute("&1&4&2&4&3",
     2023                           substring(iMark,1,31),
     2024                           substring(iMark,32,vIdx - 31 - 1),
     2025                           substring(iMark,vIdx),
     2026                           chr(29)) no-error.
     2027        else
     2028          vDM = substitute("&1&3&2",
     2029                           substring(iMark,1,31),
     2030                           substring(iMark,32),
     2031                           chr(29)) no-error.
     2032      end.
     2033      else if substring(iMark,39,2) = "91" then
     2034      do:
     2035        vIdx = index(iMark,"92",38).
     2036        if vIdx > 1 then
     2037          vDM = substitute("&1&4&2&4&3",
     2038                           substring(iMark,1,38),
     2039                           substring(iMark,39,vIdx - 38 - 1),
     2040                           substring(iMark,vIdx),
     2041                           chr(29)) no-error.
     2042        else
     2043          vDM = substitute("&1&3&2",
     2044                           substring(iMark,1,38),
     2045                           substring(iMark,39),
     2046                           chr(29)) no-error.
     2047      end.
     2048      else if substring(iMark,25,2) = "93" then
     2049      do:
     2050        vIdx = index(iMark,"92",25).
     2051        if vIdx > 1 then
     2052          vDM = substitute("&1&4&2&4&3",
     2053                           substring(iMark,1,24),
     2054                           substring(iMark,25,vIdx - 24 - 1),
     2055                           substring(iMark,vIdx),
     2056                           chr(29)) no-error.
     2057        else
     2058          vIdx = index(iMark,"3103",25).
     2059          if vIdx > 0 then
     2060          vDM = substitute("&1&4&2&4&3",
     2061                           substring(iMark,1,24),
     2062                           substring(iMark,25,vIdx - 24 - 1),
     2063                           substring(iMark,vIdx),
     2064                           chr(29)) no-error.
     2065          else
     2066            vDM = substitute("&1&3&2",
     2067                             substring(iMark,1,24),
     2068                             substring(iMark,25),
     2069                             chr(29)) no-error.
     2070      end.
     2071      else if substring(iMark,32,2) = "93" then
     2072      do:
     2073        vDM = substitute("&1&3&2",
     2074              substring(iMark,1,31),
     2075              substring(iMark,32),
     2076              chr(29)) no-error.
     2077      end.
     2078      return if vDM <> "" then vDm else iMark.
     2079   end.
     2080   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2081   function AddUtdErrForTab returns logical
     2082   (idb-num         as integer ,
     2083    idoc-id         as integer ,
     2084    iTab            as character,
     2085    iObj            as handle ,
     2086    iCheckType      as character,
     2087    iCodeErr        as character,
     2088    iCheckObj       as character ):
     2089      define buffer utd-err for utd-err.
     2090      define buffer utd for utd.
     2091      find first utd where utd.db-num     eq idb-num
     2092                       and utd.doc-id     eq idoc-id
     2093                       and utd.Direction  eq 'Outbound'
     2094      no-lock no-error.
     2095      if available utd
     2096      then
     2097         return no.
     2098      define variable vRecKey as character no-undo.
     2099            run gen-key-rec (input iTab,
     2100                             input  iObj,
     2101                             output vRecKey).
     2102      find first utd-err where utd-err.db-num     eq idb-num
     2103                           and utd-err.doc-id     eq idoc-id
     2104                           and utd-err.CheckType  eq iCheckType
     2105                           and utd-err.CodeErr    eq iCodeErr
     2106                           and utd-err.CheckObj   eq iCheckObj
     2107      exclusive-lock no-error.
     2108      if not available utd-err
     2109      then do:
     2110         create utd-err.
     2111         assign
     2112            utd-err.db-num         = idb-num
     2113            utd-err.doc-id         = idoc-id
     2114            utd-err.CheckType      = iCheckType
     2115            utd-err.CodeErr        = iCodeErr
     2116            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     2117            utd-err.reckey         = vRecKey
     2118            utd-err.qnty           = 1
     2119         .
     2120      end.
     2121      else
     2122         utd-err.qnty = utd-err.qnty + 1.
     2123      return utd-err.qnty eq 1.
     2124   end.
     2125   function AddUtdErr returns logical
     2126   (idb-num         as integer ,
     2127    idoc-id         as integer ,
     2128    iObj            as handle ,
     2129    iCheckType      as character,
     2130    iCodeErr        as character,
     2131    iCheckObj       as character ):
     2132      AddUtdErrForTab
     2133         (idb-num,
     2134          idoc-id,
     2135          iObj:table,
     2136          iObj,
     2137          iCheckType,
     2138          iCodeErr,
     2139          iCheckObj).
     2140   end.
     2141   function ClearUtdErrTypeCode returns logical
     2142   (idb-num         as integer,
     2143    idoc-id         as integer ,
     2144    iCheckType      as character,
     2145    iCodeErr        as character
     2146    ):
     2147      define buffer utd-err for utd-err.
     2148      if    iCheckType eq "*"
     2149         or iCheckType eq ?
     2150      then do:
     2151         if     iCodeErr ne ?
     2152            and iCodeErr ne "*"
     2153         then
     2154            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     2155            view-as alert-box.
     2156         else
     2157         for each utd-err where utd-err.db-num  eq idb-num
     2158                            and utd-err.doc-id  eq idoc-id
     2159         exclusive-lock:
     2160            delete utd-err.
     2161         end.
     2162      end.
     2163      else do:
     2164         if    iCodeErr eq ?
     2165            or iCodeErr eq "*"
     2166         then do:
     2167            for each utd-err where utd-err.db-num     eq idb-num
     2168                               and utd-err.doc-id     eq idoc-id
     2169                               and utd-err.CheckType  eq iCheckType
     2170            exclusive-lock:
     2171               delete utd-err.
     2172            end.
     2173         end.
     2174         else do:
     2175            for each utd-err where utd-err.db-num     eq idb-num
     2176                               and utd-err.doc-id     eq idoc-id
     2177                               and utd-err.CheckType  eq iCheckType
     2178                               and ub.utd-err.CodeErr eq iCodeErr
     2179            exclusive-lock:
     2180               delete utd-err.
     2181            end.
     2182         end.
     2183      end.
     2184   end.
     2185   function ClearUtdErr returns logical
     2186   (idb-num         as integer,
     2187    idoc-id         as integer ,
     2188    iCheckType      as character
     2189    ):
     2190      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     2191   end.
     2192   function GetMesError returns character
     2193   (itxt as character,
     2194    iobj as character ):
     2195    define variable vi as integer no-undo.
     2196    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     2197       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     2198    end.
     2199    return itxt.
     2200   end.
     2201   function GetTextErrorType returns character
     2202   (iCheckType as character,
     2203    iCodeErr   as character,
     2204    iChechObj  as character,
     2205    iType      as character  ):
     2206      define buffer code    for code.
     2207      define variable vError as character no-undo.
     2208      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2209                        and code.code   eq iCodeErr
     2210      no-lock no-error.
     2211      if available code
     2212      then do:
     2213         define variable vType as integer no-undo.
     2214         if code.misc3 eq "error"
     2215         then
     2216            vType = 0.
     2217         else if code.misc3 eq "warning"
     2218         then
     2219            vType = 1.
     2220         else if code.misc3 eq "Hiden"
     2221         then
     2222            vType = 2.
     2223         else
     2224            vtype = int(code.misc3) no-error.
     2225         case itype:
     2226            when "error"
     2227            then do:
     2228               if vtype eq 0
     2229               then
     2230                  vError = GetMesError(Code.CodeValue,iChechObj).
     2231            end.
     2232            when "warning"
     2233            then do:
     2234               if vtype <= 1
     2235               then
     2236                  vError = GetMesError(Code.CodeValue,iChechObj).
     2237            end.
     2238            otherwise do:
     2239               vError = GetMesError(Code.CodeValue,iChechObj).
     2240            end.
     2241         end.
     2242      end.
     2243      else
     2244         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     2245      return vError.
     2246   end.
     2247   function GetTypeError returns integer
     2248   (iCheckType as character,
     2249    iCodeErr   as character):
     2250      define buffer code    for code.
     2251      define variable vType as integer no-undo.
     2252      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2253                        and code.code   eq iCodeErr
     2254      no-lock no-error.
     2255      if     not available code
     2256         and code.misc3 eq "error"
     2257      then
     2258         vType = 0.
     2259      else if code.misc3 eq "warning"
     2260      then
     2261         vType = 1.
     2262      else if code.misc3 eq "Hiden"
     2263      then
     2264         vType = 2.
     2265      else
     2266         vtype = int(code.misc3) no-error.
     2267      return vtype.
     2268   end.
     2269   function GetTextError returns character
     2270   (iCheckType as character,
     2271    iCodeErr   as character,
     2272    iChechObj  as character ):
     2273      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     2274   end.
     2275   function GetErrForUtdStr returns character
     2276   (idb-num     as integer ,
     2277    idoc-id     as integer ,
     2278    iCheckType  as character
     2279    ):
     2280      define buffer utd-err for utd-err.
     2281      define buffer code    for code.
     2282      define variable vHQry as handle no-undo.
     2283      define variable vError as longchar no-undo.
     2284      define variable vErrorOne as longchar  no-undo.
     2285      define variable oError as character no-undo.
     2286      create query vHQry.
     2287      vHQry:set-buffers(buffer utd-err:handle).
     2288      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2289                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2290                               + if    iCheckType eq "*"
     2291                                    or iCheckType eq ?
     2292                                 then       ""
     2293                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2294      vHQry:query-open().
     2295      vHQry:get-first().
     2296      QRY-BLOCK:
     2297      repeat while not vHQry:query-off-end:
     2298         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2299         if     vErrorOne ne ""
     2300            and vErrorOne ne ?
     2301         then
     2302            vError = vError + ", " + vErrorOne.
     2303         vHQry:get-next().
     2304      end.
     2305      oError = substring(vError,3,4002).
     2306      return oError.
     2307   end.
     2308   function GetErrJsonForUtd returns character
     2309   (idb-num         as integer ,
     2310    idoc-id         as integer ,
     2311    iCheckType      as character
     2312    ):
     2313      define buffer utd-err for utd-err.
     2314      define variable vHQry as handle no-undo.
     2315      define variable vError as longchar no-undo.
     2316      define variable oError as character no-undo.
     2317      create query vHQry.
     2318      define variable vi as integer no-undo.
     2319      vHQry:set-buffers(buffer utd-err:handle).
     2320      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2321                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2322                               + if    iCheckType eq "*"
     2323                                    or iCheckType eq ?
     2324                                 then       ""
     2325                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2326      vHQry:query-open().
     2327      vHQry:get-first().
     2328      QRY-BLOCK:
     2329      repeat while not vHQry:query-off-end:
     2330         define variable vErrorOne as character no-undo.
     2331         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2332         if     vErrorOne ne ?
     2333            and vErrorOne ne ""
     2334         then do:
     2335            vi = vi + 1.
     2336            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2337                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     2338                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2339         end.
     2340         vHQry:get-next().
     2341      end.
     2342      for first utd where utd.db-num eq idb-num
     2343                      and utd.doc-id eq idoc-id
     2344                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     2345      no-lock,
     2346         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2347                                  and utd-marking-lines.doc-id eq idoc-id
     2348                                  and utd-marking-lines.doc-level eq 1
     2349      no-lock,
     2350         first marking where marking.mark eq utd-marking-lines.mark
     2351                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2352      no-lock:
     2353         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     2354         if     vErrorOne ne ?
     2355            and vErrorOne ne ""
     2356         then do:
     2357            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     2358                            + '","ОбъектОш":"' + marking.mark
     2359                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2360         end.
     2361      end.
     2362      if vError ne ""
     2363      then
     2364         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     2365      return oError.
     2366   end.
     2367   function GetErrJsonForUtdReturn returns character
     2368   (idb-num         as integer ,
     2369    idoc-id         as integer ,
     2370    iCheckType      as character
     2371    ):
     2372      define buffer utd-err for utd-err.
     2373      define variable vHQry as handle no-undo.
     2374      define variable vError as longchar no-undo.
     2375      define variable oError as character no-undo.
     2376      define variable vi as integer no-undo.
     2377      create query vHQry.
     2378      vHQry:set-buffers(buffer utd-err:handle).
     2379      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2380                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2381                               + if    iCheckType eq "*"
     2382                                    or iCheckType eq ?
     2383                                 then       ""
     2384                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2385      vHQry:query-open().
     2386      vHQry:get-first().
     2387      QRY-BLOCK:
     2388      repeat while not vHQry:query-off-end:
     2389         define variable vErrorOne as character no-undo.
     2390         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2391         if     vErrorOne ne ?
     2392            and vErrorOne ne ""
     2393         then do:
     2394            vi = vi + 1.
     2395            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2396                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     2397                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     2398         end.
     2399         vHQry:get-next().
     2400      end.
     2401      if vError ne ""
     2402      then
     2403         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     2404      return oError.
     2405   end.
     2406   function GetCodeTextError returns character
     2407   (iCheckType as character,
     2408    iCodeErr   as character,
     2409    iChechObj  as character,
     2410    output oCode as character,
     2411    output ovalue as character ):
     2412      define buffer code    for code.
     2413      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2414                        and code.code   eq iCodeErr
     2415      no-lock no-error.
     2416      if     available code
     2417      then do:
     2418         define variable vi as integer no-undo init ?.
     2419         vi = int(Code.misc3) no-error.
     2420         if    code.misc3 ne "error"
     2421            and vi ne 0
     2422         then
     2423            oCode = ?.
     2424         else if     Code.misc1 ne ?
     2425                 and Code.misc1 ne ""
     2426         then
     2427            assign
     2428               oCode  = GetMesError(Code.misc1,iChechObj)
     2429               ovalue = GetMesError(Code.misc2,iChechObj)
     2430            .
     2431      end.
     2432      return if oCode eq ""
     2433             then ""
     2434             else (oCode + "_" + ovalue).
     2435   end.
     2436   define temp-table TT-err no-undo
     2437     field code_ as character
     2438     field text_ as character
     2439   index code_ code_.
     2440   function GetErrTxtForUtd returns character
     2441   (idb-num         as integer ,
     2442    idoc-id         as integer ,
     2443    iCheckType      as character
     2444    ):
     2445      define buffer utd-err for utd-err.
     2446      define variable vHQry as handle no-undo.
     2447      define variable oError as character no-undo.
     2448      create query vHQry.
     2449      define variable vi as integer no-undo.
     2450      for each tt-err :
     2451         delete tt-err.
     2452      end.
     2453      vHQry:set-buffers(buffer utd-err:handle).
     2454      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2455                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2456                               + if    iCheckType eq "*"
     2457                                    or iCheckType eq ?
     2458                                 then       ""
     2459                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2460      vHQry:query-open().
     2461      vHQry:get-first().
     2462      define variable vcode as character no-undo.
     2463      define variable vvalue as character no-undo.
     2464      QRY-BLOCK:
     2465      repeat while not vHQry:query-off-end:
     2466         vi = vi + 1.
     2467         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     2468         if vcode ne ?
     2469         then do:
     2470            find first tt-err where tt-err.code eq vcode
     2471            no-error.
     2472            if not available tt-err
     2473            then do:
     2474               create tt-err.
     2475               assign
     2476                  tt-err.code_ = vcode
     2477                  tt-err.text_ = vvalue
     2478               .
     2479            end.
     2480            else
     2481               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2482         end.
     2483         vHQry:get-next().
     2484      end.
     2485     find first utd where utd.db-num eq idb-num
     2486                         and utd.doc-id eq idoc-id
     2487         no-lock.
     2488      define buffer cancel_utd-lines for utd-lines.
     2489      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     2490                                  and cancel_utd-lines.doc-id eq idoc-id
     2491      no-lock:
     2492         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     2493         then do:
     2494            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2495                                        and utd-marking-lines.doc-id eq idoc-id
     2496                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     2497            no-lock,
     2498               first marking where marking.mark eq utd-marking-lines.mark
     2499                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2500            no-lock:
     2501               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     2502               find first tt-err where tt-err.code eq vcode
     2503               no-error.
     2504               if not available tt-err
     2505               then do:
     2506                  create tt-err.
     2507                  assign
     2508                     tt-err.code_ = vcode
     2509                     tt-err.text_ = vvalue
     2510                  .
     2511               end.
     2512               else
     2513                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2514            end.
     2515         end.
     2516         else do:
     2517            define variable vqnty as decimal no-undo.
     2518            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     2519            if vqnty eq ? then vqnty = 0.
     2520            if vqnty ne cancel_utd-lines.Quantity
     2521            then do:
     2522               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     2523               find first tt-err where tt-err.code eq vcode
     2524               no-error.
     2525               if not available tt-err
     2526               then do:
     2527                  create tt-err.
     2528                  assign
     2529                     tt-err.code_ = vcode
     2530                     tt-err.text_ = vvalue
     2531                  .
     2532               end.
     2533               else
     2534                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2535            end.
     2536         end.
     2537      end.
     2538      for each tt-err:
     2539         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     2540      end.
     2541      return oError.
     2542   end.
     2543   define variable mFormatErr as character no-undo init "text".
     2544   function GetErrForUtd returns character
     2545   (idb-num         as integer ,
     2546    idoc-id         as integer ,
     2547    iType           as character
     2548    ):
     2549      if mFormatErr eq "text"
     2550      then
     2551         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     2552      else do:
     2553         if itype eq "return"
     2554         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     2555         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     2556      end.
     2557   end.
     2558   function GetErrComText returns longchar
     2559   (icomment as character,
     2560    itext    as longchar ):
     2561       define variable vText as longchar no-undo.
     2562      if mFormatErr eq "text"
     2563      then do:
     2564         if icomment ne ""
     2565         then
     2566            icomment = substitute("comment:|&1|",icomment).
     2567         vText = icomment + itext.
     2568      end.
     2569      else do:
     2570         icomment = if icomment begins  '"'
     2571                    then icomment
     2572                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     2573         vText = icomment + "," + itext.
     2574         vText = "~{" + trim(vText,",") + "~}".
     2575      end.
     2576      return vText.
     2577   end.
     2578   function CheckTypeForMarkLineType returns logical
     2579   (iObj            as handle,
     2580    iCheckType      as character,
     2581    iCodeErr        as character ,
     2582    iTypeErr        as character ):
     2583      define variable vRecKey-markLine as character no-undo.
     2584      define variable vGoodMark        as logical no-undo.
     2585      define variable vdb-num          as integer no-undo.
     2586      define variable vdoc-id          as integer no-undo.
     2587      define variable vlinenum         as integer no-undo.
     2588      define variable vErrorOne as character no-undo.
     2589      define buffer buf_utd-err for utd-err.
     2590      run gen-key-rec (input "utd-marking-lines",
     2591                       input  iObj,
     2592                       output vRecKey-markLine).
     2593      vGoodMark = yes.
     2594      vdb-num = iObj::db-num.
     2595      vdoc-id = iObj::doc-id.
     2596      vlinenum = iObj::linenum.
     2597      block-mark-err:
     2598      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2599                               and buf_utd-err.db-num = vdb-num
     2600                               and buf_utd-err.reckey = vRecKey-markLine
     2601                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2602                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2603      no-lock:
     2604         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2605         if     vErrorOne ne ?
     2606            and vErrorOne ne ""
     2607         then do:
     2608            vGoodMark = no.
     2609            leave block-mark-err.
     2610         end.
     2611      end.
     2612      return not vGoodMark.
     2613   end.
     2614   function CheckErrForMarkLineType returns logical
     2615   (iObj            as handle,
     2616    iType           as character  ):
     2617      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     2618   end.
     2619   function CheckErrForMarkLine returns logical
     2620   (iObj            as handle):
     2621      return CheckErrForMarkLineType(iObj,"*").
     2622   end.
     2623   function CheckErrForLineTypeCode returns logical
     2624   (iObj                 as handle,
     2625    iCheckType           as character,
     2626    iCodeErr             as character,
     2627    iTypeErr             as character,
     2628    iOneErr              as logical):
     2629      define variable vRecKey-line     as character no-undo.
     2630      define buffer buf_utd-err for utd-err.
     2631      define variable vUtdlineError as logical no-undo.
     2632      define variable vErrorOne as character no-undo.
     2633            run gen-key-rec (input "utd-lines",
     2634                             input  iObj,
     2635                             output vRecKey-line).
     2636         define variable vdb-num as integer no-undo.
     2637         define variable vdoc-id as integer no-undo.
     2638         define variable vlinenum as integer no-undo.
     2639         vdb-num = iObj::db-num.
     2640         vdoc-id = iObj::doc-id.
     2641         vlinenum = iObj::linenum.
     2642         block-err:
     2643         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2644                                  and buf_utd-err.db-num = vdb-num
     2645                                  and buf_utd-err.reckey = vRecKey-line
     2646                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2647                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2648         no-lock:
     2649            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2650            if     vErrorOne ne ?
     2651               and vErrorOne ne ""
     2652            then do:
     2653               vUtdlineError = yes.
     2654               leave block-err.
     2655            end.
     2656         end.
     2657         if  not vUtdlineError
     2658         then do:
     2659            define variable vGoodMark as logical no-undo.
     2660            vGoodMark = yes.
     2661            block-line-err:
     2662            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     2663                                         and utd-marking-lines.doc-id  eq vdoc-id
     2664                                         and utd-marking-lines.LineNum eq vLineNum
     2665            no-lock:
     2666               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     2667               if     vGoodMark
     2668                  and iOneErr eq no
     2669               then
     2670                  leave block-line-err.
     2671               if     iOneErr = yes
     2672                  and not vGoodMark
     2673               then
     2674                  leave block-line-err.
     2675            end.
     2676            vUtdlineError = not vGoodMark.
     2677         end.
     2678      return vUtdlineError.
     2679   end.
     2680   function getErrForLineType returns character
     2681   (iObj            as handle,
     2682    iType           as character  ):
     2683      define variable vRecKey-line     as character no-undo.
     2684      define buffer buf_utd-err for utd-err.
     2685      define variable vUtdlineError as logical no-undo.
     2686      define variable vErrorOne as character no-undo.
     2687      define variable oError as character no-undo.
     2688            run gen-key-rec (input "utd-lines",
     2689                             input  iObj,
     2690                             output vRecKey-line).
     2691         define variable vdb-num as integer no-undo.
     2692         define variable vdoc-id as integer no-undo.
     2693         define variable vlinenum as integer no-undo.
     2694         vdb-num = iObj::db-num.
     2695         vdoc-id = iObj::doc-id.
     2696         vlinenum = iObj::linenum.
     2697         block-err:
     2698         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2699                                  and buf_utd-err.db-num = vdb-num
     2700                                  and buf_utd-err.reckey = vRecKey-line
     2701                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     2702         no-lock:
     2703            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     2704            if     vErrorOne ne ?
     2705               and vErrorOne ne ""
     2706            then do:
     2707               oError = oError + vErrorOne + " ".
     2708            end.
     2709         end.
     2710      return oError.
     2711   end.
     2712   function CheckErrForLineType returns logical
     2713   (iObj            as handle,
     2714    iType           as character  ):
     2715       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     2716   end.
     2717   function CheckErrForLine returns logical
     2718   (iObj            as handle):
     2719      return CheckErrForLineType(iobj,"*").
     2720   end.
     2721   function CheckErrForUtd returns logical
     2722   (idb-num         as integer ,
     2723    idoc-id         as integer ):
     2724      for each utd-lines where utd-lines.db-num eq idb-num
     2725                           and utd-lines.doc-id eq idoc-id
     2726      no-lock :
     2727         if not CheckErrForLine (buffer ub.utd-lines:handle)
     2728         then
     2729            return no.
     2730      end.
     2731      return yes.
     2732   end.
     2733   function CheckMarkUtd-28rel return logical
     2734    (input idb-num as integer,
     2735    input idoc-id as integer):
     2736    define buffer utd                   for utd.
     2737    define buffer utd-lines             for utd-lines.
     2738    define buffer utd-marking-lines     for utd-marking-lines.
     2739    define variable v-par-type as character no-undo.
     2740    define variable vgdsNoMark as logical no-undo.
     2741    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2742      define variable v-par-val  as character no-undo.
     2743      find first utd where utd.db-num eq idb-num
     2744                       and utd.doc-id eq idoc-id
     2745      no-lock no-error.
     2746      if available utd
     2747      then do:
     2748         if     utd.obj-code ne ?
     2749            and utd.obj-type ne ?
     2750         then do:
     2751            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2752            Block-utd-lines:
     2753            for each utd-lines where utd-lines.db-num eq idb-num
     2754                                 and utd-lines.doc-id eq idoc-id
     2755            no-lock:
     2756               if     utd-lines.gds-code ne ?
     2757                  and utd-lines.gds-code ne 0
     2758               then do:
     2759                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2760                       ( utd-lines.gds-code,
     2761                         'mark-type':U,
     2762                          output v-par-val,
     2763                          output v-par-type
     2764                       ).
     2765                  if     EDOParSec:IsEdo
     2766                     and EDOParSec:GetIsEDOForType(v-par-val)
     2767                  then do:
     2768                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     2769                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     2770                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     2771                                                    and length(utd-marking-lines.mark) > 13
     2772                     no-lock no-error.
     2773                     if     avail utd-marking-lines
     2774                        and not CheckErrForLine(buffer utd-lines:handle)
     2775                     then
     2776                        leave Block-utd-lines.
     2777                  end.
     2778                  else
     2779                     vgdsNoMark = yes.
     2780               end.
     2781            end.
     2782            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     2783            if vgdsNoMark then return available utd-lines . else return yes .
     2784         end.
     2785      end.
     2786      return yes.
     2787   end.
     2788   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2789   define temp-table tt-utd-mark no-undo like utd-marking-lines
     2790     field side as character.
     2791   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2792   function CheckMarkUtd return logical
     2793    (input idb-num  as integer,
     2794     input idoc-id  as integer):
     2795     define buffer utd-lines             for ub.utd-lines.
     2796     block-line:
     2797     for each utd-lines where utd-lines.db-num eq idb-num
     2798                          and utd-lines.doc-id eq idoc-id
     2799     no-lock:
     2800        if logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","yes"))
     2801        then
     2802           leave block-line.
     2803     end.
     2804     setattrutd (idb-num, idoc-id,"MarkUtd",string(available utd-lines)).
     2805     return available utd-lines.
     2806   end.
     2807   function CheckNotMarkUtd return logical
     2808    (input idb-num  as integer,
     2809     input idoc-id  as integer):
     2810     define buffer utd-lines             for ub.utd-lines.
     2811     for each utd-lines where utd-lines.db-num eq idb-num
     2812                          and utd-lines.doc-id eq idoc-id
     2813     no-lock:
     2814        if not logical(getAttrUtdLinesEx (utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2815        then
     2816           return yes.
     2817     end.
     2818     return no.
     2819   end.
     2820   function CheckMarkUtdLine return logical
     2821    (input idb-num  as integer,
     2822     input idoc-id  as integer,
     2823     input iLineNum as integer):
     2824    define buffer utd                   for utd.
     2825    define buffer utd-lines             for utd-lines.
     2826    define buffer utd-marking-lines     for utd-marking-lines.
     2827    define variable v-par-type as character no-undo.
     2828    define variable vMarking        as logical no-undo.
     2829    define variable vArtic          as logical no-undo.
     2830    define variable vTransitional   as logical no-undo.
     2831    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2832      define variable v-par-val  as character no-undo.
     2833      find first utd where utd.db-num eq idb-num
     2834                       and utd.doc-id eq idoc-id
     2835      no-lock no-error.
     2836      if available utd
     2837      then do:
     2838         if     utd.obj-code ne ?
     2839            and utd.obj-type ne ?
     2840         then do:
     2841            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2842            Block-utd-lines:
     2843            for each utd-lines where utd-lines.db-num   eq idb-num
     2844                                 and utd-lines.doc-id   eq idoc-id
     2845                                 and utd-lines.LineNum  eq iLineNum
     2846            no-lock:
     2847               if     utd-lines.gds-code ne ?
     2848                  and utd-lines.gds-code ne 0
     2849               then do:
     2850                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2851                       ( utd-lines.gds-code,
     2852                         'mark-type':U,
     2853                          output v-par-val,
     2854                          output v-par-type
     2855                       ).
     2856                  vMarking = EDOParSec:GetIsEDOForType(v-par-val).
     2857                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val).
     2858                  if vMarking
     2859                  then do:
     2860                     block-marking:
     2861                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2862                                                    and utd-marking-lines.doc-id   eq idoc-id
     2863                                                    and utd-marking-lines.LineNum  eq iLineNum
     2864                                                    and length(utd-marking-lines.mark) > 13
     2865                     no-lock:
     2866                        if isOAD(utd-marking-lines.mark)
     2867                        then do:
     2868                           assign
     2869                              vArtic   = yes
     2870                              vMarking = no
     2871                           .
     2872                           leave block-marking.
     2873                        end.
     2874                     end.
     2875                  end.
     2876                  if vArtic
     2877                  then do:
     2878                     block-artic:
     2879                     for each   utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2880                                                    and utd-marking-lines.doc-id   eq idoc-id
     2881                                                    and utd-marking-lines.LineNum  eq iLineNum
     2882                                                    and length(utd-marking-lines.mark) > 13
     2883                     no-lock:
     2884                        if isMark(utd-marking-lines.mark)
     2885                        then do:
     2886                           assign
     2887                              vArtic   = no
     2888                              vMarking = yes
     2889                           .
     2890                           leave block-artic.
     2891                        end.
     2892                     end.
     2893                  end.
     2894                  vTransitional = (vMarking or vArtic) and EDOParSec:GetIsTransitionalForType(v-par-val).
     2895                  if vTransitional
     2896                  then do:
     2897                     find first utd-marking-lines where utd-marking-lines.db-num   eq idb-num
     2898                                                    and utd-marking-lines.doc-id   eq idoc-id
     2899                                                    and utd-marking-lines.LineNum  eq iLineNum
     2900                                                    and length(utd-marking-lines.mark) > 13
     2901                     no-lock no-error.
     2902                     if not available utd-marking-lines
     2903                     then assign
     2904                        vMarking = no
     2905                        vArtic   = no
     2906                     .
     2907                  end.
     2908               end.
     2909               else
     2910                  assign
     2911                     vMarking      = yes
     2912                     vArtic        = no
     2913                     vTransitional = no
     2914                  .
     2915               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"MarkUtdLine"         ,if vMarking      then "yes" else "").
     2916               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"ArticUtdLine"        ,if vArtic        then "yes" else "").
     2917               setattrutdlines  (utd.db-num,utd.doc-id,iLineNum,"TransitionalUtdLine" ,if vTransitional then "yes" else "").
     2918            end.
     2919         end.
     2920      end.
     2921      return vMarking or vArtic.
     2922   end.
     2923   function getMarkUtdLine return logical
     2924    (input  idb-num  as integer,
     2925     input  idoc-id  as integer,
     2926     input  iLineNum as integer,
     2927     output oMarking        as logical,
     2928     output oArtic          as logical,
     2929     output oTransitional   as logical):
     2930     oMarking = logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"MarkUtdLine"        ,"no")).
     2931     oArtic        = not oMarking
     2932            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"ArticUtdLine"       ,"no")).
     2933     oTransitional = (oMarking or oArtic)
     2934            and logical(getattrutdlinesex  (idb-num,idoc-id,iLineNum,"TransitionalUtdLine","no")).
     2935   end.
     2936   function CheckMarking return logical
     2937    (input idb-num as integer,
     2938    input idoc-id as integer,
     2939    input iTypeErr as character ):
     2940     define variable vMarkutd as logical no-undo.
     2941     define variable vCrErr   as logical no-undo.
     2942     define buffer utd-lines         for utd-lines.
     2943     define buffer utd-marking-lines for utd-marking-lines.
     2944     define buffer marking           for marking.
     2945     ClearUtdErrTypeCode(idb-num,idoc-id,iTypeErr,"NotMark").
     2946      block-line:
     2947      for each utd-lines where utd-lines.db-num eq idb-num
     2948                           and utd-lines.doc-id eq idoc-id
     2949      no-lock:
     2950         if logical (getAttrUtdLinesEx(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"MarkUtdLine","no"))
     2951         then do:
     2952            for each utd-marking-lines
     2953                     where utd-marking-lines.db-num  = utd-lines.db-num
     2954                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     2955                       and utd-marking-lines.LineNum = utd-lines.LineNum
     2956            no-lock:
     2957               if isMark(utd-marking-lines.mark)
     2958               then do:
     2959                  find first marking where marking.mark eq utd-marking-lines.mark
     2960                  no-lock no-error.
     2961                  if not available marking
     2962                  then do:
     2963                     AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iTypeErr,"NotMark",string(utd-lines.LineNum)).
     2964                     vCrErr = yes.
     2965                     next block-line.
     2966                  end.
     2967               end.
     2968            end.
     2969         end.
     2970      end.
     2971      return vCrErr.
     2972   end.
     2973   function CheckMarkForType return logical
     2974    (input idb-num   as integer,
     2975     input idoc-id   as integer):
     2976      define variable vMarking        as logical no-undo.
     2977      define variable vArtic          as logical no-undo.
     2978      define variable vTransitional   as logical no-undo.
     2979      define buffer utd-lines         for utd-lines.
     2980      define buffer utd-marking-lines for utd-marking-lines.
     2981      block-line:
     2982      for each utd-lines where utd-lines.db-num eq idb-num
     2983                           and utd-lines.doc-id eq idoc-id
     2984      no-lock:
     2985         getMarkUtdLine  (input  utd-lines.db-num , input  utd-lines.doc-id, input  utd-lines.LineNum,
     2986                          output vMarking         , output vArtic          , output vTransitional).
     2987         for each utd-marking-lines
     2988                     where utd-marking-lines.db-num  = utd-lines.db-num
     2989                       and utd-marking-lines.doc-id  = utd-lines.doc-id
     2990                       and utd-marking-lines.LineNum = utd-lines.LineNum
     2991         no-lock:
     2992            if length(utd-marking-lines.mark) < 14
     2993            then do:
     2994               if (vMarking or vArtic) and not vTransitional
     2995               then
     2996                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     2997            end.
     2998            else if not isMark(utd-marking-lines.mark)
     2999            then do:
     3000               if vMarking
     3001               then
     3002                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd-marking-lines:handle,"loadUtd","NotMark",utd-marking-lines.mark).
     3003            end.
     3004            else do:
     3005            end.
     3006         end.
     3007      end.
     3008   end.
     3009   function WeighedProd return logical
     3010      ( input p-gds-code as integer) :
     3011      define variable v-par-val  as character no-undo.
     3012      define variable v-par-type as character no-undo.
     3013              if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3014               ( p-gds-code,
     3015                 'weighed-gds':U,
     3016                  output v-par-val,
     3017                  output v-par-type
     3018               ).
     3019      return logical(v-par-val).
     3020   end.
     3021   function WghProdVariable return logical
     3022       (input p-obj-type as char,
     3023        input p-obj-code as integer,
     3024        input p-gds-code as integer) :
     3025      define variable v-wgh-val  as character no-undo.
     3026      define variable v-par-val  as character no-undo.
     3027      define variable v-par-type as character no-undo.
     3028      define variable vMarking        as logical no-undo.
     3029      define variable vArtic          as logical no-undo.
     3030      define variable vTransitional   as logical no-undo.
     3031      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3032         if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3033           ( p-gds-code,
     3034             'weighed-gds':U,
     3035              output v-wgh-val,
     3036              output v-par-type
     3037           ).
     3038       if logical(v-wgh-val) = yes then do:
     3039           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3040               ( p-gds-code,
     3041                 'mark-type':U,
     3042                  output v-par-val,
     3043                  output v-par-type
     3044               ).
     3045           if v-par-val <> "" then do:
     3046               EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(p-obj-type, p-obj-code).
     3047               assign
     3048                  vMarking = EDOParSec:GetIsEDOForType(v-par-val)
     3049                  vArtic = not vMarking and EDOParSec:GetIsArticForType(v-par-val)
     3050                  .
     3051           end.
     3052      end.
     3053      if v-wgh-val > "" and (vMarking or vArtic)
     3054      then return yes.
     3055      else return no.
     3056   end.
     3057   function MarkWeight return decimal
     3058      ( input p-mark as character) :
     3059      define buffer  buf_marking-attr for  ub.marking-attr.
     3060      define variable vMarkWeight as decimal no-undo.
     3061      vMarkWeight = 0.
     3062      if p-mark <> "" and p-mark <> ?
     3063      then do:
     3064          find first buf_marking-attr where buf_marking-attr.mark      eq p-mark
     3065                                        and buf_marking-attr.attr-code eq "weight"
     3066             no-lock no-error.
     3067          if not available buf_marking-attr
     3068          then do :
     3069            find first buf_marking-attr where buf_marking-attr.mark  begins p-mark
     3070                                          and buf_marking-attr.attr-code eq "weight"
     3071               no-lock no-error.
     3072          end .
     3073          if avail buf_marking-attr
     3074          then vMarkWeight = dec(buf_marking-attr.attr-value).
     3075      end.
     3076      return vMarkWeight.
     3077   end.
     3078   function CheckQnty returns logical
     3079   (  input idb-num  as integer,
     3080      input idoc-id  as integer,
     3081      input iErrType as character
     3082   ):
     3083      if iErrType ne "loadUTD"
     3084      then do:
     3085         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     3086         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","QntyMark").
     3087         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","Qnty").
     3088      end.
     3089      if iErrType ne "CheckQnty"
     3090      then do:
     3091         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","MarkNotFormatqnty").
     3092         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","QntyMark").
     3093         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckQnty","Qnty").
     3094      end.
     3095      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"QntyMark").
     3096      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     3097      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"Qnty").
     3098      define buffer marking               for marking.
     3099      define buffer utd-lines             for utd-lines.
     3100      define buffer utd-marking-lines     for utd-marking-lines.
     3101      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3102      block-line:
     3103      for each utd-lines where utd-lines.db-num eq idb-num
     3104                           and utd-lines.doc-id eq idoc-id
     3105      no-lock:
     3106         define variable Vflagmark as logical no-undo.
     3107         find first buf_utd-marking-lines
     3108                       where buf_utd-marking-lines.db-num   = utd-lines.db-num
     3109                         and buf_utd-marking-lines.doc-id   = utd-lines.doc-id
     3110                         and buf_utd-marking-lines.LineNum  = utd-lines.LineNum
     3111                         and length(buf_utd-marking-lines.mark) > 13
     3112         no-lock no-error.
     3113         if not available buf_utd-marking-lines
     3114         then
     3115            next block-line.
     3116         define variable vqntyMark as integer no-undo.
     3117         define variable vqntyOAD  as integer no-undo.
     3118         vqntyMark = 0.
     3119         vqntyOAD  = 0.
     3120         block-mark:
     3121         for each utd-marking-lines
     3122              where utd-marking-lines.db-num  = utd-lines.db-num
     3123                and utd-marking-lines.doc-id  = utd-lines.doc-id
     3124                and utd-marking-lines.LineNum = utd-lines.LineNum
     3125                and length(utd-marking-lines.mark) > 13
     3126                and utd-marking-lines.doc-level  = 1
     3127         no-lock:
     3128            if isMark(utd-marking-lines.mark)
     3129            then do:
     3130               find first marking where marking.mark eq utd-marking-lines.mark
     3131               no-lock no-error.
     3132               if available marking
     3133               then do:
     3134                  if marking.box-qnty ne ?
     3135                  then
     3136                     vqntyMark = vqntyMark + marking.box-qnty.
     3137               end.
     3138            end.
     3139            else do:
     3140               find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq utd-marking-lines.db-num
     3141                                                   and utd-marking-lines-attr.doc-id    eq utd-marking-lines.doc-id
     3142                                                   and utd-marking-lines-attr.LineNum   eq utd-marking-lines.LineNum
     3143                                                   and utd-marking-lines-attr.mark      eq utd-marking-lines.mark
     3144                                                   and utd-marking-lines-attr.attr-code eq "box-qnty"
     3145               no-lock no-error.
     3146               if available utd-marking-lines-attr
     3147               then
     3148                  vqntyOAD = vqntyOAD + dec(utd-marking-lines-attr.attr-value).
     3149            end.
     3150         end.
     3151         if     utd-lines.gds-code   gt 0
     3152            and utd-lines.gds-code   ne ?
     3153            and vqntyMark            ne 0
     3154         then do:
     3155            if utd-lines.Quantity  < vqntyMark
     3156            then
     3157               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     3158            else if utd-lines.Quantity  <> vqntyMark
     3159            then
     3160               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"QntyMark",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyMark)).
     3161         end.
     3162         else if     utd-lines.gds-code   gt 0
     3163            and utd-lines.gds-code   ne ?
     3164            and vqntyOAD ne 0
     3165            and utd-lines.Quantity  ne vqntyOAD
     3166         then
     3167            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"Qnty",string(utd-lines.LineNum ) + chr(4) + string(utd-lines.Quantity ) + chr(4) + string(vqntyOAD)).
     3168      end.
     3169   end.
     3170   function CheckGds returns logical
     3171   (  input idb-num   as integer,
     3172      input idoc-id   as integer,
     3173      input iobj-type as character,
     3174      input iobj-code as integer,
     3175      input iErrType as character
     3176   ):
     3177      if iErrType ne "loadUTD"
     3178      then do:
     3179         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","InLineNotMark").
     3180         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoGtinForMark").
     3181         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarcodForGtin").
     3182         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkNotFormatqnty").
     3183         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MarkingForTypeEDO").
     3184         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotMarkForLine").
     3185         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","MultGtinForLine").
     3186         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NoBarCodeForLine").
     3187         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotFindGdsForBarCode").
     3188         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","NotEqGgsForLineAndMark").
     3189         ClearUtdErrTypeCode(idb-num,idoc-id,"loadUTD","GtinQntyNotOne").
     3190      end.
     3191      if iErrType ne "CheckGds"
     3192      then do:
     3193         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","InLineNotMark").
     3194         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoGtinForMark").
     3195         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarcodForGtin").
     3196         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkNotFormatqnty").
     3197         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MarkingForTypeEDO").
     3198         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotMarkForLine").
     3199         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","MultGtinForLine").
     3200         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NoBarCodeForLine").
     3201         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotFindGdsForBarCode").
     3202         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","NotEqGgsForLineAndMark").
     3203         ClearUtdErrTypeCode(idb-num,idoc-id,"CheckGds","GtinQntyNotOne").
     3204      end.
     3205      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"InLineNotMark").
     3206      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoGtinForMark").
     3207      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarcodForGtin").
     3208      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkNotFormatqnty").
     3209      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MarkingForTypeEDO").
     3210      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotMarkForLine").
     3211      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"MultGtinForLine").
     3212      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NoBarCodeForLine").
     3213      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotFindGdsForBarCode").
     3214      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"NotEqGgsForLineAndMark").
     3215      ClearUtdErrTypeCode(idb-num,idoc-id,iErrType,"GtinQntyNotOne").
     3216      define variable v-par-type as character no-undo.
     3217      define variable v-par-val  as character no-undo.
     3218      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3219      define buffer marking               for marking.
     3220      define buffer utd-lines             for utd-lines.
     3221      define buffer buf_utd-lines         for utd-lines.
     3222      define buffer utd-marking-lines     for utd-marking-lines.
     3223      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3224      define variable vGdsCode as integer no-undo.
     3225      EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(iobj-type, iobj-code).
     3226      block-line:
     3227      for each utd-lines where utd-lines.db-num eq idb-num
     3228                           and utd-lines.doc-id eq idoc-id
     3229      no-lock:
     3230         vGdsCode = ?.
     3231         define variable Vflagmark as logical no-undo.
     3232         define variable VflagOAD  as logical no-undo.
     3233         assign
     3234            Vflagmark = no
     3235            VflagOAD = no
     3236         .
     3237         block-mark:
     3238         for each utd-marking-lines
     3239                  where utd-marking-lines.db-num  = utd-lines.db-num
     3240                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     3241                    and utd-marking-lines.LineNum = utd-lines.LineNum
     3242         no-lock:
     3243            if    isMark(utd-marking-lines.mark)
     3244               or isOAD (utd-marking-lines.mark)
     3245            then do:
     3246               define variable vnewGdsCode as integer no-undo.
     3247               vnewGdsCode = getGdsCodeByDM(utd-marking-lines.mark).
     3248               if isMark(utd-marking-lines.mark)
     3249               then do:
     3250                  Vflagmark = yes.
     3251                  find first marking where marking.mark eq utd-marking-lines.mark
     3252                  no-lock no-error.
     3253                  if not available marking
     3254                  then do:
     3255                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"InLineNotMark",utd-marking-lines.mark).
     3256                     next block-mark.
     3257                  end.
     3258                  if vnewGdsCode eq ?
     3259                  then
     3260                     vnewGdsCode = GetGdsCodeByGtin(marking.gds-ext-id).
     3261                  if    marking.gds-code eq 0
     3262                     or marking.gds-code eq ?
     3263                     or marking.sts eq 0
     3264                     or marking.sts eq ?
     3265                     or marking.box-qnty eq ?
     3266                     or (marking.gds-code ne vnewGdsCode
     3267                         and vnewGdsCode ne ?
     3268                         and vnewGdsCode ne 0)
     3269                  then do:
     3270                     find first marking where marking.mark eq utd-marking-lines.mark
     3271                     exclusive-lock no-error.
     3272                     if marking.box-qnty = ? then marking.box-qnty = getQntyUTDByDM(marking.mark).
     3273                     if marking.gds-ext-id = "" then marking.gds-ext-id = getGtinByDM(marking.mark).
     3274                     if marking.gds-code = ? or marking.gds-code ne vnewGdsCode then marking.gds-code = vnewGdsCode.
     3275                     if    marking.gds-ext-id eq ""
     3276                        or marking.gds-ext-id eq ?
     3277                     then do:
     3278                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoGtinForMark",string(utd-lines.LineNum ) + chr(4) + marking.mark).
     3279                     end.
     3280                     else if    marking.gds-code eq 0
     3281                             or marking.gds-code eq ?
     3282                     then
     3283                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"NoBarcodForGtin",string(utd-lines.LineNum ) + chr(4) + marking.gds-ext-id).
     3284                     else if     marking.sts eq 0
     3285                             or  marking.sts eq ?
     3286                     then
     3287                        marking.sts = objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     3288                  end.
     3289                  if utd-marking-lines.doc-level eq 1
     3290                  then do:
     3291                     if marking.box-qnty eq ?
     3292                     then
     3293                        AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"MarkNotFormatqnty",string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3294                  end.
     3295               end.
     3296               else do:
     3297                  VflagOAD = yes.
     3298                  define variable vQnty as decimal no-undo.
     3299                  vQnty = getQntyUTDByCodId(utd-marking-lines.mark) .
     3300                  setAttrUtdMarkingLines (utd-marking-lines.db-num,
     3301                                          utd-marking-lines.doc-id,
     3302                                          utd-marking-lines.LineNum,
     3303                                          utd-marking-lines.mark,
     3304                                          "box-qnty",
     3305                                           string(vQnty)).
     3306                  define variable vgtin as character no-undo.
     3307                  vgtin = getGtinByDM(utd-marking-lines.mark).
     3308                  if getQntyCodeByGtin(vgtin) ne 1
     3309                  then
     3310                     AddUtdErr(utd-marking-lines.db-num,utd-marking-lines.doc-id,buffer utd-marking-lines:handle,iErrType,"GtinQntyNotOne",string(utd-lines.LineNum ) + chr(4) + vgtin).
     3311               end.
     3312               if utd-marking-lines.gds-code ne vnewGdsCode
     3313               and vnewGdsCode ne ?
     3314               and vnewGdsCode ne 0
     3315               then do:
     3316                  find first buf_utd-marking-lines
     3317                           where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     3318                             and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     3319                             and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     3320                             and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     3321                  exclusive-lock no-error.
     3322                  if available buf_utd-marking-lines
     3323                  then do:
     3324                     buf_utd-marking-lines.gds-code = vnewGdsCode.
     3325                  end.
     3326               end.
     3327            end.
     3328            else  do:
     3329               define variable vgdsbar as integer no-undo.
     3330               vgdsbar = GetGdsCodeByGtin(utd-marking-lines.mark).
     3331               if    utd-marking-lines.gds-code ne vgdsbar
     3332               then do:
     3333                  find first buf_utd-marking-lines
     3334                             where buf_utd-marking-lines.db-num   = utd-marking-lines.db-num
     3335                               and buf_utd-marking-lines.doc-id   = utd-marking-lines.doc-id
     3336                               and buf_utd-marking-lines.LineNum  = utd-marking-lines.LineNum
     3337                               and buf_utd-marking-lines.mark     = utd-marking-lines.mark
     3338                  exclusive-lock no-error.
     3339                  if available buf_utd-marking-lines
     3340                  then do:
     3341                     buf_utd-marking-lines.gds-code = vgdsbar.
     3342                  end.
     3343               end.
     3344               if vgdsbar ne ?
     3345               then do:
     3346                                 if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3347                            ( vgdsbar,
     3348                              'mark-type':U,
     3349                              output v-par-val,
     3350                              output v-par-type
     3351                             ).
     3352                  if      (EDOParSec:GetIsEDOForType(v-par-val)
     3353                       or  EDOParSec:GetIsArticForType(v-par-val))
     3354                   and not EDOParSec:GetIsTransitionalForType(v-par-val)
     3355                   and     EDOParSec:IsEdo
     3356                  then do:
     3357                     AddUtdErr(utd-marking-lines.db-num,
     3358                               utd-marking-lines.doc-id,
     3359                               buffer utd-marking-lines:handle,
     3360                               iErrType,
     3361                               "MarkingForTypeEDO",
     3362                               string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3363                  end.
     3364               end.
     3365            end.
     3366            if vGdsCode eq ?
     3367            then
     3368               vGdsCode = utd-marking-lines.gds-code.
     3369            if vGdsCode ne utd-marking-lines.gds-code
     3370            and utd-marking-lines.gds-code > 0
     3371            then do:
     3372               vGdsCode = -1.
     3373            end.
     3374         end.
     3375         if  vGdsCode = -1
     3376         then do:
     3377            vGdsCode = ?.
     3378            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"MultGtinForLine",string(utd-lines.LineNum )).
     3379            next block-line.
     3380         end.
     3381         if vGdsCode ne ?
     3382         then do:
     3383                     if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3384                      ( vGdsCode,
     3385                        'mark-type':U,
     3386                        output v-par-val,
     3387                        output v-par-type
     3388                       ).
     3389            if   not EDOParSec:GetIsTransitionalForType(v-par-val)
     3390                and(
     3391                 (    EDOParSec:GetIsEDOForType(v-par-val)
     3392                     and not Vflagmark)
     3393                 or  (EDOParSec:GetIsArticForType(v-par-val)
     3394                     and not VflagOAD
     3395                     and not Vflagmark))
     3396            then do:
     3397               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NotMarkForLine",string(utd-lines.LineNum)).
     3398            end.
     3399         end.
     3400         if utd-lines.gds-code ne vGdsCode
     3401         then do:
     3402            find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3403                                        and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3404                                        and buf_utd-lines.LineNum eq utd-lines.LineNum
     3405            exclusive-lock no-error.
     3406            if available buf_utd-lines
     3407            then
     3408               buf_utd-lines.gds-code = vGdsCode.
     3409            release buf_utd-lines.
     3410         end.
     3411         define variable VBarCode as character no-undo.
     3412         VBarCode = getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode").
     3413         if VBarCode ne ?
     3414         then do:
     3415            if num-entries(VBarCode," ") > 0
     3416            then
     3417               VBarCode = entry(num-entries(VBarCode," "),VBarCode," ").
     3418            vgdsbar = GetGdsCodeByGtin(VBarCode).
     3419            if vgdsbar eq ? or vgdsbar eq 0
     3420            then do:
     3421               AddUtdErr(utd-lines.db-num,
     3422                         utd-lines.doc-id,
     3423                         buffer utd-lines:handle,
     3424                         iErrType,
     3425                         "NotFindGdsForBarCode",
     3426                         string(utd-lines.LineNum ) + chr(4) + VBarCode).
     3427            end.
     3428            else do:
     3429               if    utd-lines.gds-code eq ?
     3430                  or utd-lines.gds-code eq 0
     3431               then do:
     3432                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3433                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3434                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     3435                  exclusive-lock no-error.
     3436                  if available buf_utd-lines
     3437                  then
     3438                     buf_utd-lines.gds-code = vgdsbar.
     3439                  release buf_utd-lines.
     3440               end.
     3441               else if utd-lines.gds-code ne vgdsbar
     3442               then do:
     3443                  AddUtdErr(utd-lines.db-num,
     3444                         utd-lines.doc-id,
     3445                         buffer utd-lines:handle,
     3446                         iErrType,
     3447                         "NotEqGgsForLineAndMark",
     3448                         string(utd-lines.LineNum ) + chr(4) + String(vgdsbar) + chr(4) + String(utd-lines.gds-code)).
     3449               end.
     3450            end.
     3451         end.
     3452         if vGdsCode eq ? and utd-lines.gds-code eq ?
     3453         then
     3454            AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,iErrType,"NoBarCodeForLine",string(utd-lines.LineNum )).
     3455      end.
     3456   end.
     3457   function GetUtdLineForOrig return logical
     3458   (input idb-num as integer,
     3459    input idoc-id as integer,
     3460    input ilineNum as integer,
     3461    input idb-numOrig as integer,
     3462    input idoc-idOrig as integer,
     3463    buffer edoc-lines for utd-lines):
     3464      define buffer edoc-marking-lines for ub.utd-marking-lines.
     3465      block-mark:
     3466      for each utd-marking-lines where utd-marking-lines.db-num  eq idb-num
     3467                                   and utd-marking-lines.doc-id  eq idoc-id
     3468                                   and utd-marking-lines.LineNum eq iLineNum
     3469                                   and utd-marking-lines.site eq "-"
     3470      no-lock:
     3471         find first edoc-marking-lines where edoc-marking-lines.db-num eq idb-numOrig
     3472                                         and edoc-marking-lines.doc-id eq idoc-idOrig
     3473                                         and edoc-marking-lines.mark   eq utd-marking-lines.mark
     3474                     no-lock no-error.
     3475         if available edoc-marking-lines
     3476         then do:
     3477            find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     3478                                    and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     3479                                    and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     3480            no-lock no-error.
     3481               leave block-mark.
     3482          end.
     3483      end.
     3484       if not available edoc-lines
     3485       then do:
     3486          find  first  utd-lines where utd-lines.db-num      = idb-num
     3487                                   and utd-lines.doc-id      = idoc-id
     3488                                   and utd-lines.LineNum     = ilinenum
     3489             no-lock no-error.
     3490          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     3491                                  and edoc-lines.doc-id      = idoc-idOrig
     3492                                  and edoc-lines.ProductCode = utd-lines.ProductCode
     3493          no-lock no-error.
     3494       end.
     3495       if not available edoc-lines
     3496       then
     3497          find  edoc-lines where edoc-lines.db-num      = idb-numOrig
     3498                                  and edoc-lines.doc-id      = idoc-idOrig
     3499                                  and edoc-lines.gds-code    = utd-lines.gds-code
     3500          no-lock no-error.
     3501   end.
     3502   function GetLastUTDinPack returns logical
     3503   (input idb-num as integer,
     3504    input idoc-id as integer,
     3505    output odb-num as integer,
     3506    output odoc-id as integer ) forward.
     3507   function getObgFns return logical
     3508   (input iDocumentNumber   as character ,
     3509    input iFnsParticipantId as character ,
     3510    input ikpp              as character ,
     3511    output ohost-code       as integer,
     3512    output oobj-type        as character ,
     3513    output oobj-code        as integer ,
     3514    output otext            as character  ):
     3515       define buffer ext-classif   for ext-classif.
     3516       define buffer clients       for clients.
     3517       define buffer buf_clients   for clients.
     3518       define buffer clients-attr  for clients-attr.
     3519       find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     3520                                and ext-classif.charkey_three eq iFnsParticipantId
     3521       no-lock no-error.
     3522       if available ext-classif
     3523       then do:
     3524          if ext-classif.CharKey_One eq 'маг':U
     3525          then do:
     3526             assign
     3527                oobj-type = ext-classif.CharKey_One
     3528                oobj-code = ext-classif.Key#_One
     3529             .
     3530             find first clients
     3531                  where clients.obj-type   = ext-classif.CharKey_One
     3532                    and clients.obj-code   = ext-classif.Key#_One
     3533             no-lock no-error .
     3534             if available clients
     3535             then
     3536                ohost-code =  clients.host-code.
     3537          end.
     3538          else do:
     3539             find first clients
     3540                  where clients.obj-type   = ext-classif.CharKey_One
     3541                    and clients.obj-code   = ext-classif.Key#_One
     3542                    and can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     3543             no-lock no-error .
     3544             if not available clients
     3545             then do:
     3546                otext = substitute("По &1 получатель  &2 не наша фирма." ,iDocumentNumber, iFnsParticipantId) .
     3547                return no.
     3548             end.
     3549             ohost-code = ext-classif.Key#_One.
     3550             block-cl:
     3551             for each clients-attr
     3552                where clients-attr.attr-code  = 'kpp':U
     3553                  and clients-attr.obj-type   = 'маг':U
     3554                  and clients-attr.attr-value = ikpp
     3555                  and can-find(buf_clients where buf_clients.obj-type   = clients-attr.obj-type
     3556                                             and buf_clients.obj-code   = clients-attr.obj-code
     3557                                             and buf_clients.host-code  = ohost-code)
     3558             no-lock :
     3559                leave block-cl.
     3560             end.
     3561             if     available clients
     3562                and clients.obj-type eq 'маг':U
     3563             then do:
     3564                assign
     3565                   oobj-type = clients.obj-type
     3566                   oobj-code = clients.obj-code
     3567                .
     3568             end.
     3569             else if available clients-attr
     3570             then do:
     3571                assign
     3572                   oobj-type = clients-attr.obj-type
     3573                   oobj-code = clients-attr.obj-code
     3574                .
     3575             end.
     3576             else do:
     3577                otext = substitute("По &1 не найден объект по КПП &2." ,iDocumentNumber, ikpp ).
     3578                return yes.
     3579             end.
     3580          end.
     3581       end.
     3582       else do:
     3583          otext = substitute("По &1 не найден получатель  &2." ,iDocumentNumber, iFnsParticipantId) .
     3584          return no.
     3585       end.
     3586       return ?.
     3587   end.
     3588   function CheckUcdForReturn return logical
     3589   (input idb-numUcd as integer,
     3590    input idoc-idUcd as integer,
     3591    input idb-numRet as integer,
     3592    input idoc-idRet as integer  ):
     3593       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numUcd
     3594                                    and utd-marking-lines.doc-id eq idoc-idUcd
     3595                                    and utd-marking-lines.doc-level eq 1
     3596       no-lock:
     3597          create tt-utd-mark.
     3598          buffer-copy utd-marking-lines to tt-utd-mark
     3599          assign
     3600             tt-utd-mark.side = "+"
     3601          .
     3602       end.
     3603       for each utd-marking-lines where utd-marking-lines.db-num eq idb-numRet
     3604                                    and utd-marking-lines.doc-id eq idoc-idRet
     3605                                    and utd-marking-lines.doc-level eq 1
     3606       no-lock:
     3607          find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     3608          no-lock no-error.
     3609          if available tt-utd-mark
     3610          then
     3611             tt-utd-mark.side = "".
     3612          else do:
     3613             create tt-utd-mark.
     3614             buffer-copy utd-marking-lines to tt-utd-mark
     3615             assign
     3616                tt-utd-mark.side = "-"
     3617             .
     3618          end.
     3619       end.
     3620       for each tt-utd-mark where  tt-utd-mark.side ne ""
     3621       no-lock:
     3622          AddUtdErrForTab(utd.db-num, utd.doc-id, "utd-marking-lines", buffer tt-utd-mark:handle, "UCDСompar", "NotMark" + tt-utd-mark.side, tt-utd-mark.mark).
     3623       end.
     3624       for each tt-utd-mark:
     3625          delete tt-utd-mark.
     3626       end.
     3627   end.
     3628   function GetLastUTDinPackAft returns logical
     3629   (input idb-num as integer,
     3630    input idoc-id as integer,
     3631    output odb-num as integer,
     3632    output odoc-id as integer ) forward.
     3633   function SaturateAndCheckUTD return character
     3634   (input idb-num as integer,
     3635    input idoc-id as integer  ):
     3636      define buffer clients-attr          for clients-attr.
     3637      define buffer clients               for clients.
     3638      define buffer Utd                   for Utd.
     3639      define buffer utd_ret               for ub.utd.
     3640      define buffer utd-lines             for utd-lines.
     3641      define buffer buf_utd-lines         for utd-lines.
     3642      define buffer buf_utddoc-lines      for utd-lines.
     3643      define buffer marking               for marking.
     3644      define buffer marking-lines         for marking-lines.
     3645      define buffer utd-marking-lines     for utd-marking-lines.
     3646      define buffer Buf_utd-marking-lines for utd-marking-lines.
     3647      define buffer contract              for contract.
     3648      define buffer old_utd               for Utd.
     3649      define variable vError as character no-undo.
     3650      define variable vGdsCode as integer no-undo.
     3651      define variable vcli-type as character no-undo.
     3652      define variable vcli-code as integer no-undo.
     3653      define variable vhost-code as integer no-undo init ?.
     3654      define variable vcontract-code as integer no-undo.
     3655      define variable vobj-type as character no-undo init ?.
     3656      define variable vobj-code as integer no-undo init ?.
     3657      define variable volddb-num as integer no-undo.
     3658      define variable volddoc-id as integer no-undo.
     3659      define variable vMark as logical no-undo.
     3660      define variable VUcd as logical no-undo.
     3661      define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     3662      define variable v-par-type as character no-undo.
     3663      define variable v-par-val  as character no-undo.
     3664      define variable VFileMark as logical no-undo.
     3665      define variable vunit     as int no-undo.
     3666      define variable vunitCode as character no-undo.
     3667      define variable vMarkingUtd as logical no-undo.
     3668      find first Utd where utd.db-num eq idb-num
     3669                       and utd.doc-id eq idoc-id
     3670      no-lock no-error.
     3671      if available Utd
     3672      then do:
     3673         VUcd = utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB.
     3674         VFileMark = getattrutd (utd.db-num,utd.doc-id,"FileName") begins "ON_NSCHFDOPPRMARK_".
     3675         ClearUtdErr(utd.db-num,utd.doc-id,"loadUtd").
     3676         assign
     3677               vobj-type  = utd.obj-type
     3678               vobj-code  = utd.obj-code
     3679               vhost-code = utd.host-code
     3680         .
     3681         do:
     3682            define variable vtext       as character no-undo.
     3683            define variable vhost-code1 as integer   no-undo.
     3684            define variable vobj-type1  as character no-undo.
     3685            define variable vobj-code1  as integer   no-undo.
     3686             getObgFns
     3687                       (input utd.DocumentNumber ,
     3688                        input utd.obj-FnsParticipantId ,
     3689                        input utd.obj-kpp,
     3690                        output vhost-code1,
     3691                        output vobj-type1,
     3692                        output vobj-code1,
     3693                        output vtext ).
     3694            assign
     3695               vobj-type  = vobj-type1   when vobj-type  eq ? or vobj-type  eq ""
     3696               vobj-code  = vobj-code1   when vobj-code  eq ? or vobj-code  eq 0
     3697               vhost-code = vhost-code1  when vhost-code eq ? or vhost-code eq 0
     3698            .
     3699            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(vobj-type, vobj-code).
     3700            CheckGds (utd.db-num,utd.doc-id,vobj-type,vobj-code,"loadUTD").
     3701            block-line:
     3702            for each utd-lines where utd-lines.db-num eq utd.db-num
     3703                                 and utd-lines.doc-id eq utd.doc-id
     3704            no-lock:
     3705               vGdsCode =?.
     3706               define variable vNotMarkForLine as logical no-undo.
     3707               vNotMarkForLine = no.
     3708               if not VUcd
     3709               then do:
     3710                  find first utd-marking-lines
     3711                       where utd-marking-lines.db-num  = utd-lines.db-num
     3712                         and utd-marking-lines.doc-id  = utd-lines.doc-id
     3713                         and utd-marking-lines.LineNum = utd-lines.LineNum
     3714                  no-lock no-error.
     3715                  if not available utd-marking-lines
     3716                  then do:
     3717                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,"loadUtd","NotMarkForLine",string(utd-lines.LineNum)).
     3718                     vNotMarkForLine = yes.
     3719                  end.
     3720               end.
     3721               block-mark:
     3722               for each utd-marking-lines
     3723                  where utd-marking-lines.db-num  = utd-lines.db-num
     3724                    and utd-marking-lines.doc-id  = utd-lines.doc-id
     3725                    and utd-marking-lines.LineNum = utd-lines.LineNum
     3726               no-lock:
     3727                  vMark = yes.
     3728                  if     isMark(utd-marking-lines.mark)
     3729                     and utd-marking-lines.gds-code  ne 0
     3730                     and utd-marking-lines.gds-code ne ?
     3731                  then do:
     3732                                       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     3733                           ( utd-marking-lines.gds-code,
     3734                            'mark-type':U,
     3735                            output v-par-val,
     3736                            output v-par-type
     3737                            ).
     3738                      if     not VFileMark
     3739                         and not VUcd
     3740                         and EDOParSec:GetIsEDOForType(v-par-val) and EDOParSec:IsEdo
     3741                      then do:
     3742                          AddUtdErr(utd.db-num,
     3743                                     utd.doc-id,
     3744                                     buffer utd-marking-lines:handle,
     3745                                     "loadUtd",
     3746                                     "NotON_NSCHFDOPPRMARK",
     3747                                     string(utd-lines.LineNum ) + chr(4) + utd-marking-lines.mark).
     3748                     end.
     3749                  end.
     3750               end.
     3751               if utd-lines.gds-code eq 0 or utd-lines.gds-code eq ?
     3752               then do :
     3753                  if     VUcd
     3754                  then do:
     3755                     GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     3756                     GetUtdLineForOrig(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,volddb-num,volddoc-id, buffer buf_utddoc-lines).
     3757                     if available buf_utddoc-lines
     3758                     then do:
     3759                        vGdsCode = buf_utddoc-lines.gds-code.
     3760                        vunitCode = buf_utddoc-lines.UnitCode.
     3761                        if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     3762                           and buf_utddoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     3763                        then
     3764                           AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3765                               "loadUtd",
     3766                               "UcdUnitChangForUtd",
     3767                               string(utd-lines.LineNum )                  + chr(4) +
     3768                               buf_utddoc-lines.UnitCode                   + chr(4) +
     3769                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     3770                     end.
     3771                     if     utd-lines.UnitCode ne ?
     3772                        and utd-lines.UnitCode ne ""
     3773                        and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     3774                     then
     3775                        AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3776                               "loadUtd",
     3777                               "UcdUnitChang",
     3778                               string(utd-lines.LineNum )                  + chr(4) +
     3779                               utd-lines.UnitCode                          + chr(4) +
     3780                               getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     3781                  end.
     3782               end.
     3783               else
     3784                  vGdsCode = utd-lines.gds-code.
     3785               define variable vValText as character no-undo.
     3786               define variable vValDec  as decimal no-undo.
     3787               VValText = GetAttrUtdlines (utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity").
     3788               if VValText = ?
     3789               then do:
     3790                  vValDec = utd-lines.Quantity.
     3791                  setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(utd-lines.Quantity)).
     3792               end.
     3793               else
     3794                  vValDec = dec(VValText).
     3795               release bar-code .
     3796               if     vGdsCode > 0 and vGdsCode ne ?
     3797               then do:
     3798                  assign
     3799                     vunitCode = utd-lines.UnitCode when utd-lines.UnitCode ne ? and utd-lines.UnitCode ne ""
     3800                     vunit = ?
     3801                     vunit = integer (getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unit"))
     3802                  no-error.
     3803                  if vunit ne 0 and vunit ne ?
     3804                  then do:
     3805                     find units where units.OKEI eq vunit no-lock no-error.
     3806                     if available units
     3807                     then
     3808                        vunitCode = units.unit-name.
     3809                  end.
     3810                  find first bar-code where bar-code.gds-code eq vGdsCode
     3811                                        and bar-code.unit-cli eq vUnitCode
     3812                  no-lock no-error.
     3813                  if not available bar-code
     3814                  then
     3815                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd-lines:handle,
     3816                               "loadUtd",
     3817                               "Unit",
     3818                               string(utd-lines.LineNum )                  + chr(4) +
     3819                               string(vGdsCode)                            + chr(4) +
     3820                               (if vunit ne ? then string(vunit ) else "") + chr(4) +
     3821                               vunitCode).
     3822               end.
     3823               if utd-lines.Quantity ne vValDec * (if avail bar-code then bar-code.cli-base-rate else 1)
     3824               then do:
     3825                  find first  buf_utd-lines where buf_utd-lines.db-num  eq utd-lines.db-num
     3826                                              and buf_utd-lines.doc-id  eq utd-lines.doc-id
     3827                                              and buf_utd-lines.LineNum eq utd-lines.LineNum
     3828                  exclusive-lock no-error.
     3829                  if available buf_utd-lines
     3830                  then do:
     3831                     buf_utd-lines.Quantity = vValDec * (if avail bar-code then bar-code.cli-base-rate else 1).
     3832                     release buf_utd-lines.
     3833                  end.
     3834               end.
     3835               vValDec  = decimal(getAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old")) no-error.
     3836               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old_new",string(vValDec * (if avail bar-code then bar-code.cli-base-rate else 1))).
     3837               if     not VUcd
     3838                  and CheckMarkUtdLine(utd.db-num,utd.doc-id,utd-lines.LineNum)
     3839               then
     3840                  vMarkingUtd = yes .
     3841            end.
     3842            if not VUcd
     3843            then
     3844               CheckQnty(utd.db-num, utd.doc-id, "loadUtd").
     3845            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     3846                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     3847            no-lock no-error.
     3848            if available ext-classif
     3849            then
     3850               assign
     3851                  vcli-type = ext-classif.CharKey_One
     3852                  vcli-code = ext-classif.Key#_One
     3853               .
     3854            else do:
     3855               assign
     3856                 vcli-type = ?
     3857                 vcli-code = ?
     3858               .
     3859               AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoSuppForId",utd.cli-FnsParticipantId ).
     3860            end.
     3861            find first contract  where contract.host-code eq vhost-code
     3862                                   and contract.cli-type  eq vcli-type
     3863                                   and contract.cli-code  eq vcli-code
     3864                                   and contract.contract-prn-code eq Utd.BaseDocumentNumber
     3865            no-lock no-error.
     3866            define variable VContractEdo as logical no-undo init yes.
     3867            if available contract
     3868            then do:
     3869               assign
     3870                  VContractEdo = contract.whole-send-news > 0
     3871                  vcontract-code = contract.contract-code
     3872               .
     3873               if not VContractEdo
     3874               then
     3875                  AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoEdoDoc", Utd.BaseDocumentNumber).
     3876            end.
     3877            else do:
     3878               vcontract-code = ?.
     3879            end.
     3880         end.
     3881         if not GetLastUTDinPackAft (utd.db-num, utd.doc-id, volddb-num, volddoc-id)
     3882         then do:
     3883            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoLastDoc",string(utd.PackageId) + chr(4) + string(volddb-num) + chr(4) + string(volddoc-id)).
     3884         end.
     3885         define variable vdoc-code as character no-undo init ?.
     3886         if utd.EDocType              eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     3887         then do:
     3888            find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     3889                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     3890                                 and utd_ret.Timestamp             le utd.Timestamp
     3891                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     3892            no-lock no-error.
     3893            if available utd_ret
     3894            then do:
     3895               vdoc-code = utd_ret.doc-code.
     3896               CheckUcdForReturn(utd.db-num,utd.doc-id,utd_ret.db-num,utd_ret.doc-id).
     3897            end.
     3898         end.
     3899      end.
     3900      find current utd exclusive-lock no-error.
     3901      if available utd
     3902      then do:
     3903         assign
     3904            utd.cli-type      = vcli-type      when vcli-type      ne ?
     3905            utd.cli-code      = vcli-code      when vcli-type      ne ?
     3906            utd.host-code     = vhost-code     when vhost-code     ne ? and vhost-code     ne 0
     3907            utd.contract-code = vcontract-code when vcontract-code ne ?
     3908            utd.obj-type      = vobj-type      when vobj-type      ne ? and vobj-type      ne ""
     3909            utd.obj-code      = vobj-code      when vobj-code      ne ? and vobj-code      ne 0
     3910            utd.doc-code      = vdoc-code      when vdoc-code      ne ?
     3911         .
     3912         if   ( utd.contract-code eq ?
     3913            or utd.contract-code eq 0)
     3914            and not vucd
     3915         then
     3916            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoContForFirmId",(if utd.host-code eq ? then "?" else string (utd.host-code)) + chr(4) +  utd.BaseDocumentNumber).
     3917         if utd.host-code eq ?
     3918            or utd.host-code eq 0
     3919         then
     3920            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoFirmForId",if utd.obj-FnsParticipantId eq ? then "?" else utd.obj-FnsParticipantId ).
     3921         if utd.obj-code eq ?
     3922            or utd.obj-code eq 0
     3923         then
     3924            AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoShopForKpp",utd.obj-kpp).
     3925      end.
     3926      vError = GetErrForUtdstr(utd.db-num,utd.doc-id,"loadUtd").
     3927      if vError eq ""
     3928      then do:
     3929         if utd.sts eq 0 or utd.sts eq ?
     3930         then
     3931            utd.sts = if VUcd
     3932                      then ObjSrv:Env:Utd:Sts:th:ConfirmedUcd:KeyIntDB
     3933                      else ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     3934         if utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB
     3935         then do:
     3936            utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     3937         end.
     3938         if     not VUcd
     3939            and utd.sts = ObjSrv:Env:Utd:Sts:th:ReceivedFromSupplier:KeyIntDB
     3940         then do:
     3941            if not vMarkingUtd
     3942            then
     3943               utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB.
     3944         end.
     3945      end.
     3946      else do:
     3947         if utd.sts ne ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB
     3948         then
     3949            utd.sts = ObjSrv:Env:Utd:Sts:th:LoadError:KeyIntDB.
     3950      end.
     3951      if     utd.sts-edi  >= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     3952         and utd.sts-edi  <= ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyEnd
     3953      then
     3954         utd.sts-edi = ?.
     3955      else if     (not vMark and  not vucd) or not VContractEdo
     3956              and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatChangLoanOnlyBeg
     3957      then
     3958         utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB.
     3959      release utd no-error.
     3960      if error-status:error
     3961      then
     3962         return error return-value.
     3963      return vError.
     3964   end.
     3965   function ReCheckload returns logical
     3966   (idb-num as integer,
     3967    idoc-id as integer,
     3968    iload   as logical ):
     3969      subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     3970      define buffer buf_c-utd for ub.c-utd .
     3971      define buffer buf_utd   for ub.utd .
     3972      find first buf_utd where buf_utd.db-num eq idb-num
     3973                           and buf_utd.doc-id eq idoc-id
     3974      exclusive-lock no-error.
     3975      if available buf_utd
     3976      then do:
     3977         if    iload
     3978            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:loaderror:KeyIntDB
     3979         then do:
     3980            SaturateAndCheckUTD(buf_utd.db-num, buf_utd.doc-id) no-error .
     3981            if  error-status:error then
     3982            do:
     3983               message return-value view-as alert-box.
     3984            end.
     3985         end.
     3986         if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     3987            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     3988            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:DeliveryCodeMismatch:KeyIntDB
     3989            or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LackOfMarkingCodesInCirculation:KeyIntDB
     3990         then do:
     3991            find last buf_c-utd no-lock where buf_c-utd.db-num eq buf_utd.db-num and
     3992                                              buf_c-utd.doc-id eq buf_utd.doc-id and
     3993                                              buf_c-utd.sts    eq buf_utd.sts and
     3994                                              buf_c-utd.sts    eq ObjSrv:Env:Utd:Sts:TH:NewStatus:KeyIntDB
     3995            no-error .
     3996            if available (buf_c-utd)
     3997            then do:
     3998               buf_utd.sts = buf_c-utd.sts .
     3999               buf_utd.sts-edi = buf_c-utd.sts-edi .
     4000            end.
     4001            else do:
     4002               if    buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:InconsistencyWithSupplyContract:KeyIntDB
     4003                  or buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:LinesInError:KeyIntDB
     4004               then
     4005                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB .
     4006               else
     4007                  buf_utd.sts = ObjSrv:Env:Utd:Sts:TH:ReceivedFromSupplier:KeyIntDB .
     4008               buf_utd.sts-edi = ObjSrv:Env:Utd:Sts:EDI:Verification:KeyIntDB .
     4009            end.
     4010         end.
     4011         if buf_utd.sts = objSrv:Env:Utd:Sts:TH:VerificationPassed:KeyIntDB
     4012         then do:
     4013            run utl/utd-checkSpec.p (input buf_utd.db-num,
     4014                                     input buf_utd.doc-id) .
     4015         end.
     4016      end.
     4017      release buf_utd.
     4018      unsubscribe "getNextseq".
     4019   end.
     4020   function ReCheck returns logical
     4021   (idb-num as integer,
     4022    idoc-id as integer ):
     4023      ReCheckload(idb-num,idoc-id,no).
     4024   end.
     4025   function GetLastUTDForPac returns logical
     4026   (iPackegeId as character ,
     4027    iTimestamp as datetime,
     4028    output odb-num as integer,
     4029    output odoc-id as integer ):
     4030      define buffer buf_utd for utd.
     4031      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     4032                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4033                                and Buf_utd.Timestamp gt iTimestamp
     4034      no-lock no-error.
     4035      if available  buf_utd
     4036      then
     4037         assign
     4038            odb-num = buf_utd.db-num
     4039            odoc-id = buf_utd.doc-id
     4040         no-error.
     4041      else
     4042         assign
     4043            odb-num = ?
     4044            odoc-id = ?
     4045         no-error.
     4046   end.
     4047   function GetprevUTDForPac returns logical
     4048   (iPackegeId as character ,
     4049    iTimestamp as datetime,
     4050    output odb-num as integer,
     4051    output odoc-id as integer ):
     4052      define buffer buf_utd for utd.
     4053      find last buf_utd where Buf_utd.PackageId eq iPackegeId
     4054                                and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4055                                and Buf_utd.Timestamp < iTimestamp
     4056      no-lock no-error.
     4057      if available  buf_utd
     4058      then
     4059         assign
     4060            odb-num = buf_utd.db-num
     4061            odoc-id = buf_utd.doc-id
     4062         no-error.
     4063      else
     4064         assign
     4065            odb-num = ?
     4066            odoc-id = ?
     4067         no-error.
     4068   end.
     4069   function GetLastUTDinPackAft returns logical
     4070   (input idb-num as integer,
     4071    input idoc-id as integer,
     4072    output odb-num as integer,
     4073    output odoc-id as integer ):
     4074      define buffer buf_utd for utd.
     4075      define buffer     utd for utd.
     4076      find first utd where utd.db-num eq idb-num
     4077                       and utd.doc-id eq idoc-id
     4078      no-lock no-error.
     4079      if available utd
     4080      then do:
     4081         if utd.PackageId eq ""
     4082         then do:
     4083            assign
     4084               odb-num = utd.db-num
     4085               odoc-id = utd.doc-id
     4086            .
     4087            return yes.
     4088         end.
     4089         else do:
     4090            GetLastUTDForPac(utd.PackageId,utd.Timestamp,output odb-num,output odoc-id ).
     4091            if    odb-num eq ?
     4092               or odoc-id eq ?
     4093            then do:
     4094               assign
     4095                  odb-num = utd.db-num
     4096                  odoc-id = utd.doc-id
     4097               .
     4098               return yes.
     4099            end.
     4100            else
     4101               return odoc-id = utd.doc-id.
     4102         end.
     4103      end.
     4104      return ?.
     4105   end.
