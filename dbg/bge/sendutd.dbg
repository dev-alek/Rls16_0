     7023                           getdesc(vItemIdentificationNumber).
     7024                           getdesc(vItemIdentificationNumber:Unit).
     7025                           if vItemIdentificationNumber:TransPackageId ne ? and vItemIdentificationNumber:TransPackageId ne ""
     7026                           then do:
