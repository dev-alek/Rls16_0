     4143   function GetLastUTDinPack returns logical
     4144   (input idb-num as integer,
     4145    input idoc-id as integer,
     4146    output odb-num as integer,
     4147    output odoc-id as integer ):
     4148      define buffer buf_utd for utd.
     4149      define buffer     utd for utd.
     4150      find first utd where utd.db-num eq idb-num
     4151                       and utd.doc-id eq idoc-id
     4152      no-lock no-error.
     4153      if available utd
     4154      then do:
     4155         if utd.PackageId eq ""
     4156         then do:
     4157            assign
     4158               odb-num = utd.db-num
     4159               odoc-id = utd.doc-id
     4160            .
     4161            return yes.
     4162         end.
     4163         else do:
     4164            GetLastUTDForPac(utd.PackageId,datetime("01/01/1900"),output odb-num,output odoc-id ).
     4165            if    odb-num eq ?
     4166               or odoc-id eq ?
     4167            then do:
     4168               assign
     4169                  odb-num = utd.db-num
     4170                  odoc-id = utd.doc-id
     4171               .
     4172               return yes.
     4173            end.
     4174            else
     4175               return odoc-id = utd.doc-id.
     4176         end.
     4177      end.
     4178      return ?.
     4179   end.
     4180   function delMark returns logical
     4181   ( buffer utd-marking-lines for utd-marking-lines ):
     4182      define buffer buf_utd-marking-line for utd-marking-lines.
     4183      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     4184         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     4185                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     4186                                           and buf_utd-marking-line.mark      eq marking.mark
     4187         no-lock no-error.
     4188         if available  buf_utd-marking-line
     4189         then do:
     4190            delMark(buffer buf_utd-marking-line).
     4191            delete buf_utd-marking-line.
     4192         end.
     4193      end.
     4194   end.
     4195   function addMark returns logical
     4196   ( buffer utd-marking-lines for utd-marking-lines ):
     4197      define buffer buf_utd-marking-line for utd-marking-lines.
     4198      define buffer par_utd-marking-line for utd-marking-lines.
     4199      define buffer buf_utd for ub.utd .
     4200      for each marking where marking.mark-parent eq utd-marking-lines.mark no-lock:
     4201         find first buf_utd-marking-line where buf_utd-marking-line.db-num    eq utd-marking-lines.db-num
     4202                                           and buf_utd-marking-line.doc-id    eq utd-marking-lines.doc-id
     4203                                           and buf_utd-marking-line.mark      eq marking.mark
     4204         no-lock no-error.
     4205         if available  buf_utd-marking-line
     4206         then do:
     4207            if buf_utd-marking-line.doc-level ne utd-marking-lines.doc-level + 1
     4208            then do:
     4209               find current  buf_utd-marking-line exclusive-lock no-error.
     4210               if available buf_utd-marking-line
     4211               then
     4212                  buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1.
     4213            end.
     4214         end.
     4215         else do:
     4216            find first buf_utd no-lock where buf_utd.db-num    eq utd-marking-lines.db-num
     4217                                         and buf_utd.doc-id    eq utd-marking-lines.doc-id
     4218                                         no-error .
     4219            create buf_utd-marking-line.
     4220            buffer-copy utd-marking-lines except doc-level mark sts gds-code to buf_utd-marking-line
     4221            assign
     4222               buf_utd-marking-line.doc-level = utd-marking-lines.doc-level + 1
     4223               buf_utd-marking-line.mark      = marking.mark
     4224               buf_utd-marking-line.gds-code  = marking.Gds-code
     4225               buf_utd-marking-line.sts      = if (available buf_utd and buf_utd.EDocType = objSrv:Env:Utd:EDocType:Mark_Collect:KeyIntDB)
     4226                                               then marking.sts
     4227                                               else
     4228                                               if can-do(objSrv:Env:Marking:Sts:Mark:Sale_Return_Wait,string(marking.sts)) or
     4229                                                  can-do(objSrv:Env:Marking:Sts:Mark:Doc_Status,string(marking.sts)) or
     4230                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:Ungrouped:KeyIntDB or
     4231                                                  marking.sts = objSrv:Env:Marking:Sts:Mark:GrayZone:KeyIntDB
     4232                                                then objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4233                                                else marking.sts
     4234            .
     4235            if  buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB then
     4236            do:
     4237              for first par_utd-marking-line no-lock where
     4238                        par_utd-marking-line.db-num  = buf_utd-marking-line.db-num
     4239                    and par_utd-marking-line.doc-id  = buf_utd-marking-line.doc-id
     4240                    and par_utd-marking-line.LineNum = buf_utd-marking-line.LineNum
     4241                    and par_utd-marking-line.mark    = marking.mark-parent
     4242                    and par_utd-marking-line.sts     = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB
     4243              :
     4244                buf_utd-marking-line.sts = objSrv:Env:Marking:Sts:Mark:Checked_:KeyIntDB.
     4245              end.
     4246            end.
     4247         end.
     4248         addMark(buffer buf_utd-marking-line).
     4249      end.
     4250   end.
     4251   function UnLockUTDMarkbuf returns logical
     4252   (buffer old_utd for utd,
     4253    iAll as logical ):
     4254      define variable voldkey    as character no-undo.
     4255         run gen-key-rec (input "utd",
     4256                          input  buffer old_utd:handle,
     4257                          output voldkey).
     4258      for each marking where marking.loc-key eq voldkey
     4259      exclusive-lock:
     4260         if    iAll
     4261            or (    marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     4262                and marking.sts eq  ObjSrv:Env:Marking:Sts:Mark:MarkError:KeyIntDB )
     4263         then do:
     4264            marking.loc-key = "".
     4265            marking.sts =  ObjSrv:Env:Marking:Sts:Mark:UnknowSts:KeyIntDB.
     4266         end.
     4267      end.
     4268   end.
     4269   function UnLockUTDMark returns logical
     4270   (idb-num as integer ,idoc-id as integer ,iall as logical):
     4271      define buffer old_utd for utd.
     4272      find first old_utd where old_utd.db-num eq idb-num
     4273                           and old_utd.db-num eq idoc-id
     4274      no-lock no-error.
     4275      if available old_utd
     4276      then do:
     4277         UnLockUTDMarkbuf(buffer old_utd,iall).
     4278      end.
     4279   end.
     4280   function changSts returns logical
     4281   (idb-num as integer ,
     4282    idoc-id as integer ,
     4283    old_sts_edo as character ,
     4284    new_sts_edo as character  ):
     4285      if     old_sts_edo ne new_sts_edo
     4286         and ( new_sts_edo eq "RevocationAccepted"
     4287              or  new_sts_edo eq "RecipientSignatureRequestRejected"
     4288              )
     4289      then
     4290         UnLockUTDMark(idb-num,idoc-id,yes).
     4291      if     old_sts_edo ne new_sts_edo
     4292         and ( new_sts_edo eq "WithRecipientSignature"
     4293           or  new_sts_edo eq "WithRecipientPartiallySignature"
     4294              )
     4295      then
     4296         UnLockUTDMark(idb-num,idoc-id,no).
     4297   end.
     4298   function SetLockUTDMark returns logical
     4299   (idb-num as integer ,idoc-id as integer ):
     4300      define buffer new_utd for utd.
     4301      define buffer old_utd for utd.
     4302      define variable volddb-num as integer no-undo.
     4303      define variable volddoc-id as integer no-undo.
     4304      define variable voldkey    as character no-undo.
     4305      define variable vnewkey    as character no-undo.
     4306      find first new_utd where new_utd.db-num eq idb-num
     4307                           and new_utd.doc-id eq idoc-id
     4308      no-lock no-error.
     4309      if not GetLastUTDinPack (new_utd.db-num,new_utd.doc-id,volddb-num,volddoc-id)
     4310      then do trans:
     4311         find first old_utd where old_utd.db-num eq volddb-num
     4312                              and old_utd.doc-id eq volddoc-id
     4313         no-lock no-error.
     4314            run gen-key-rec (input "utd",
     4315                             input  buffer new_utd:handle,
     4316                             output vnewkey).
     4317            run gen-key-rec (input "utd",
     4318                             input  buffer old_utd:handle,
     4319                             output voldkey).
     4320         for each utd-marking-lines where utd-marking-lines.db-num eq new_utd.db-num
     4321                                      and utd-marking-lines.doc-id eq new_utd.doc-id
     4322         no-lock:
     4323            find first marking where marking.mark eq utd-marking-lines.mark no-lock no-error.
     4324            if available  marking
     4325            then do:
     4326               if    marking.loc-key eq ""
     4327                  or marking.loc-key eq ?
     4328                  or marking.loc-key eq voldkey
     4329               then do:
     4330                  find current marking exclusive-lock no-error.
     4331                  if available marking
     4332                  then do:
     4333                     marking.loc-key = vnewkey.
     4334                     release marking.
     4335                  end.
     4336               end.
     4337               else if marking.loc-key ne vnewkey
     4338               then do:
     4339                  addutderr(new_utd.db-num,new_utd.doc-id,buffer new_utd:handle,"LoadUtd","MarkLock",marking.mark + chr(4) + marking.loc-key).
     4340               end.
     4341            end.
     4342         end.
     4343         UnLockUTDMark(old_utd.db-num,old_utd.doc-id,yes).
     4344      end.
     4345   end.
     4346   define new global shared variable g#library  as handle no-undo .
     4347   define new global shared variable g#library2 as handle no-undo .
     4348   function CheckedocMark return logical
     4349   (input idb-numorig as integer,
     4350    input idoc-idorig as integer,
     4351    input idb-numedoc as integer,
     4352    input idoc-idedoc as integer  ):
     4353       define variable VChekOk    as logical   no-undo init yes.
     4354       define variable vMarkUtd   as logical   no-undo.
     4355       define variable v-par-type as character no-undo.
     4356       define variable v-par-val  as character no-undo.
     4357       define buffer buf_utd-attr      for utd-attr.
     4358       define buffer buf_utd           for utd.
     4359       define buffer utd-marking-lines for utd-marking-lines.
     4360       define buffer utd-lines         for utd-lines.
     4361       define buffer marking           for marking.
     4362       define buffer edoc-lines        for utd-lines.
     4363          for each utd-marking-lines where utd-marking-lines.db-num    eq idb-numorig
     4364                                       and utd-marking-lines.doc-id    eq idoc-idorig
     4365                                       and utd-marking-lines.doc-level eq 1
     4366                                       and utd-marking-lines.sts       eq objSrv:Env:marking:Sts:Mark:Checked_:KeyIntDB
     4367          no-lock:
     4368             if    isMark (utd-marking-lines.mark)
     4369             then do:
     4370                create tt-utd-mark.
     4371                buffer-copy utd-marking-lines to tt-utd-mark
     4372                assign
     4373                   tt-utd-mark.side = "+"
     4374                .
     4375             end.
     4376          end.
     4377          for each utd-marking-lines where utd-marking-lines.db-num eq idb-numedoc
     4378                                       and utd-marking-lines.doc-id eq idoc-idedoc
     4379                                       and utd-marking-lines.doc-level eq 1
     4380          no-lock:
     4381             if    isMark (utd-marking-lines.mark)
     4382             then do:
     4383                find first tt-utd-mark where tt-utd-mark.mark eq utd-marking-lines.mark
     4384                no-lock no-error.
     4385                if available tt-utd-mark
     4386                then
     4387                   tt-utd-mark.side = "".
     4388                else do:
     4389                   create tt-utd-mark.
     4390                   buffer-copy utd-marking-lines to tt-utd-mark
     4391                   assign
     4392                      tt-utd-mark.side = "-"
     4393                   .
     4394                end.
     4395             end.
     4396          end.
     4397          for each tt-utd-mark where  tt-utd-mark.side ne ""
     4398          no-lock:
     4399             AddUtdErrForTab(idb-numedoc, idoc-idedoc, "utd-marking-lines", buffer tt-utd-mark:handle, "edoc", "MarkOrig" + tt-utd-mark.side, tt-utd-mark.mark).
     4400             VChekOk = no.
     4401          end.
     4402          for each utd-lines where utd-lines.db-num    eq idb-numorig
     4403                               and utd-lines.doc-id    eq idoc-idorig
     4404          no-lock:
     4405             find first edoc-lines where edoc-lines.db-num eq idb-numedoc
     4406                                     and edoc-lines.doc-id eq idoc-idedoc
     4407                                     and edoc-lines.LineNum eq utd-lines.LineNum
     4408             no-lock no-error.
     4409             define variable VUtdlinequentity as decimal no-undo.
     4410             VUtdlinequentity = dec (getattrutdlinesex(utd-lines.db-num ,utd-lines.doc-id,utd-lines.LineNum,"QuantityBarCode","0")).
     4411             if     VUtdlinequentity eq ?
     4412                or (if available edoc-lines then edoc-lines.Quantity else 0) ne VUtdlinequentity
     4413             then
     4414                AddUtdErr(idb-numedoc, idoc-idedoc,buffer edoc-lines:handle,"edoc","lineQnty",string(edoc-lines.LineNum ) + chr(4) + string(VUtdlinequentity) + chr(4) + string(edoc-lines.Quantity ) ).
     4415          end.
     4416       for each tt-utd-mark:
     4417          delete tt-utd-mark.
     4418       end.
     4419   end.
     4420   function CheckEdoc returns character
     4421   (idb-numOrig as integer ,
     4422    idoc-idOrig as integer,
     4423    idb-num as integer ,
     4424    idoc-id as integer ):
     4425      define buffer utd  for ub.utd.
     4426      define buffer utd-lines  for ub.utd-lines.
     4427      define buffer utd-marking-lines  for ub.utd-marking-lines.
     4428      define buffer edoc-lines for ub.utd-lines.
     4429      define variable vSts as integer no-undo.
     4430      define variable vMarkutd as logical no-undo.
     4431      vSts = objSrv:Env:utd:Sts:th:ReceivedFromSupplier:KeyIntDB.
     4432      Block-line:
     4433      for each utd-lines where utd-lines.db-num eq idb-num
     4434                           and utd-lines.doc-id eq idoc-id
     4435      exclusive-lock:
     4436         define variable ismarkin as logical no-undo.
     4437         define variable isOAD as logical no-undo.
     4438         define variable isper as logical no-undo.
     4439         getMarkUtdLine(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,
     4440              output ismarkin, output isOAD, output isper).
     4441         if    utd-lines.Price                eq 0
     4442            or utd-lines.Total                eq 0
     4443            or utd-lines.TotalWithVatExcluded eq 0
     4444            or utd-lines.Quantity             eq 0
     4445         then do:
     4446            for each utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     4447                                         and utd-marking-lines.doc-id  eq utd-lines.doc-id
     4448                                         and utd-marking-lines.linenum eq utd-lines.LineNum
     4449            no-lock:
     4450               if    isMark(utd-marking-lines.mark)
     4451                  or isOad(utd-marking-lines.mark)
     4452               then do:
     4453                  AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,"Edoc","Amount" , string(utd-lines.LineNum )).
     4454                  next Block-line.
     4455               end.
     4456            end.
     4457            delete utd-lines.
     4458         end.
     4459         else if   ( utd-lines.Total                ne 0
     4460                 or utd-lines.Quantity             ne 0)
     4461                 and ismarkin or isOAD
     4462         then do:
     4463            Block-mark:
     4464            for each utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     4465                                         and utd-marking-lines.doc-id  eq utd-lines.doc-id
     4466                                         and utd-marking-lines.linenum eq utd-lines.LineNum
     4467            no-lock:
     4468               if  (isOAD and
     4469                     isMark(utd-marking-lines.mark)
     4470                  or isOad(utd-marking-lines.mark) )
     4471                  or (ismarkin and
     4472                     isMark(utd-marking-lines.mark))
     4473               then do:
     4474                  leave Block-mark.
     4475               end.
     4476            end.
     4477            if not available utd-marking-lines
     4478            then
     4479               AddUtdErr(utd-lines.db-num,utd-lines.doc-id,buffer utd-lines:handle,"Edoc","Mark" ,string(utd-lines.LineNum)).
     4480         end.
     4481      end.
     4482      for each utd-lines where utd-lines.db-num eq idb-numOrig
     4483                           and utd-lines.doc-id eq idoc-idOrig
     4484      no-lock:
     4485         find first edoc-lines where edoc-lines.db-num eq idb-num
     4486                                 and edoc-lines.doc-id eq idoc-id
     4487                                 and edoc-lines.LineNum eq utd-lines.LineNum
     4488         no-lock no-error.
     4489         if     available edoc-lines
     4490         then do:
     4491            if edoc-lines.Quantity ne 0
     4492            then do:
     4493               if edoc-lines.Price ne utd-lines.Price
     4494               then
     4495                  AddUtdErr(edoc-lines.db-num,edoc-lines.doc-id,buffer edoc-lines:handle,"Edoc","Price" ,string(edoc-lines.LineNum)).
     4496            end.
     4497         end.
     4498         vSts = objSrv:Env:utd:Sts:th:SignatureRequired:KeyIntDB.
     4499         CheckedocMark(idb-numOrig , idoc-idOrig , idb-num , idoc-id).
     4500      end.
     4501      define variable vError as character no-undo.
     4502      vError = GetErrForUtdstr(idb-num , idoc-id ,"edoc").
     4503      if vError ne ""
     4504      then
     4505         vSts = objSrv:Env:utd:Sts:th:edocError:KeyIntDB.
     4506      else
     4507         vSts = objSrv:Env:utd:Sts:th:SignatureRequired:KeyIntDB.
     4508      find first utd where utd.db-num eq idb-num
     4509                       and utd.doc-id eq idoc-id
     4510      exclusive-lock no-error.
     4511      if available utd
     4512      then do:
     4513         utd.sts = vsts.
     4514      end.
     4515   end.
     4516   function CrEdoc returns character
     4517   (iPack as character ,
     4518    iTimestamp as datetime):
     4519      define variable vdb-num as integer no-undo.
     4520      define variable vdoc-id as integer no-undo.
     4521      define buffer utd  for ub.utd.
     4522      define buffer edoc for ub.utd.
     4523      define buffer utd_ret   for ub.utd.
     4524      define buffer utd-attr  for ub.utd-attr.
     4525      define buffer edoc-attr for ub.utd-attr.
     4526      define buffer utd-lines  for ub.utd-lines.
     4527      define buffer edoc-lines for ub.utd-lines.
     4528      define buffer utd-lines-attr  for ub.utd-lines-attr.
     4529      define buffer edoc-lines-attr for ub.utd-lines-attr.
     4530      define buffer utd-marking-lines  for ub.utd-marking-lines.
     4531      define buffer edoc-marking-lines for ub.utd-marking-lines.
     4532      define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr.
     4533      define buffer edoc-marking-lines-attr for ub.utd-marking-lines-attr.
     4534      define variable vTimestamp  as datetime no-undo.
     4535      find last utd where utd.PackageId eq iPack
     4536                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     4537                      and utd.Timestamp ge iTimestamp
     4538      no-lock no-error.
     4539      if available utd
     4540      then
     4541         return "Есть документ позже".
     4542      find last utd where utd.PackageId eq iPack
     4543                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:ucd:KeyIntDB
     4544                      and utd.Timestamp le iTimestamp
     4545      no-lock no-error.
     4546      if not available utd
     4547      then
     4548         return "Не найден УКД".
     4549      define variable vdb-numOrig as integer no-undo.
     4550      define variable vdoc-idOrig as integer no-undo.
     4551      find last utd where utd.PackageId eq iPack
     4552                      and utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     4553                      and utd.Timestamp le iTimestamp
     4554      no-lock no-error.
     4555      if available utd
     4556      then do:
     4557         subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     4558         MySeqUtd = ?.
     4559         vTimestamp = utd.Timestamp.
     4560         create edoc.
     4561         vdb-num = utd.db-num.
     4562         vdoc-id = utd.doc-id.
     4563         buffer-copy utd except doc-id db-num DocumentExt OrganizationExt comment to edoc
     4564         assign
     4565            edoc.EDocType = objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     4566            edoc.Timestamp = iTimestamp + 1
     4567            edoc.AmendmentRequested = no
     4568            edoc.sts-edi  = objSrv:Env:Utd:sts:edi:WaitingForRecipientSignature:KeyIntDB
     4569         .
     4570         validate edoc.
     4571         for each utd-attr where utd-attr.db-num eq vdb-num
     4572                             and utd-attr.doc-id eq vdoc-id
     4573                             and utd-attr.attr-code ne "ststhbeforeCorrection"
     4574                             and utd-attr.attr-code ne "sendcode"
     4575         no-lock:
     4576            create edoc-attr.
     4577            buffer-copy utd-attr except doc-id db-num to edoc-attr
     4578            assign
     4579               edoc-attr.db-num = edoc.db-num
     4580               edoc-attr.doc-id = edoc.doc-id
     4581            .
     4582         end.
     4583         for each utd-lines where utd-lines.db-num eq vdb-num
     4584                              and utd-lines.doc-id eq vdoc-id
     4585         no-lock:
     4586            create edoc-lines.
     4587            buffer-copy utd-lines except doc-id db-num to edoc-lines
     4588            assign
     4589               edoc-lines.db-num = edoc.db-num
     4590               edoc-lines.doc-id = edoc.doc-id
     4591            .
     4592            release edoc-lines.
     4593         end.
     4594         for each utd-lines-attr where utd-lines-attr.db-num eq vdb-num
     4595                                   and utd-lines-attr.doc-id eq vdoc-id
     4596         no-lock:
     4597            create edoc-lines-attr.
     4598            buffer-copy utd-lines-attr except doc-id db-num to edoc-lines-attr
     4599            assign
     4600               edoc-lines-attr.db-num = edoc.db-num
     4601               edoc-lines-attr.doc-id = edoc.doc-id
     4602            .
     4603         end.
     4604         for each utd-marking-lines where utd-marking-lines.db-num eq vdb-num
     4605                                      and utd-marking-lines.doc-id eq vdoc-id
     4606                                      and utd-marking-lines.doc-level eq 1
     4607         no-lock:
     4608            create edoc-marking-lines.
     4609            buffer-copy utd-marking-lines except doc-id db-num to edoc-marking-lines
     4610            assign
     4611               edoc-marking-lines.db-num = edoc.db-num
     4612               edoc-marking-lines.doc-id = edoc.doc-id
     4613            .
     4614         end.
     4615         for each utd-marking-lines-attr where utd-marking-lines-attr.db-num eq vdb-num
     4616                                           and utd-marking-lines-attr.doc-id eq vdoc-id
     4617         no-lock:
     4618            if utd-marking-lines-attr.attr-code eq "box-qnty"
     4619            then do:
     4620                find first edoc-marking-lines-attr  where edoc-marking-lines-attr.db-num    eq utd-marking-lines-attr.db-num
     4621                                                      and edoc-marking-lines-attr.doc-id    eq utd-marking-lines-attr.doc-id
     4622                                                      and edoc-marking-lines-attr.LineNum   eq utd-marking-lines-attr.LineNum
     4623                                                      and edoc-marking-lines-attr.mark      eq utd-marking-lines-attr.mark
     4624                                                      and edoc-marking-lines-attr.attr-code eq utd-marking-lines-attr.attr-code
     4625                no-lock no-error.
     4626            end.
     4627            if not avail edoc-marking-lines-attr
     4628            then do:
     4629                create edoc-marking-lines-attr.
     4630                buffer-copy utd-marking-lines-attr except doc-id db-num to edoc-marking-lines-attr
     4631                assign
     4632                   edoc-marking-lines-attr.db-num = vdb-num
     4633                   edoc-marking-lines-attr.doc-id = vdoc-id
     4634                .
     4635            end.
     4636            release edoc-marking-lines-attr.
     4637         end.
     4638         for each utd where utd.PackageId eq iPack
     4639                        and utd.EDocType  eq objSrv:Env:Utd:EDocType:Ucd:KeyIntDB
     4640                        and utd.Timestamp gt vTimestamp
     4641                        and utd.Timestamp le iTimestamp
     4642                        and (    utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WaitingForRecipientSignature:KeyIntDB
     4643                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB
     4644                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WithRecipientSignature:KeyIntDB
     4645                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:WithRecipientPartiallySignature:KeyIntDB
     4646                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     4647                             or  utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB)
     4648         no-lock by utd.PackageId by utd.EDocType by utd.Timestamp:
     4649            edoc.Total = edoc.Total + utd.total.
     4650            edoc.Vat = edoc.Vat + utd.Vat.
     4651            edoc.DocumentDate = utd.DocumentDate.
     4652            edoc.Timestamp = utd.Timestamp + 1.
     4653            for each utd-lines where utd-lines.db-num     = utd.db-num
     4654                                 and utd-lines.doc-id     = utd.doc-id
     4655            no-lock:
     4656               block-mark:
     4657               for each utd-marking-lines where utd-marking-lines.db-num eq utd-lines.db-num
     4658                                            and utd-marking-lines.doc-id eq utd-lines.doc-id
     4659                                            and utd-marking-lines.LineNum eq utd-lines.LineNum
     4660                                            and utd-marking-lines.site eq "-"
     4661                                            no-lock:
     4662                  if isOAD(utd-marking-lines.mark)
     4663                  then do:
     4664                     define variable VOAD as character no-undo.
     4665                     VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     4666                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     4667                                                  and edoc-marking-lines.doc-id eq edoc.doc-id
     4668                                                  and edoc-marking-lines.mark   begins VOAD
     4669                     no-lock no-error.
     4670                  end.
     4671                  else
     4672                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     4673                                                     and edoc-marking-lines.doc-id eq edoc.doc-id
     4674                                                     and edoc-marking-lines.mark   eq utd-marking-lines.mark
     4675                        no-lock no-error.
     4676                  if available edoc-marking-lines
     4677                  then do:
     4678                     find first edoc-lines where edoc-lines.db-num      = edoc-marking-lines.db-num
     4679                                       and edoc-lines.doc-id            = edoc-marking-lines.doc-id
     4680                                       and edoc-lines.LineNum           = edoc-marking-lines.LineNum
     4681                     exclusive-lock no-error.
     4682                     leave block-mark.
     4683                  end.
     4684               end.
     4685               if not available edoc-lines
     4686               then
     4687                  find first edoc-lines where edoc-lines.db-num      = edoc.db-num
     4688                                          and edoc-lines.doc-id      = edoc.doc-id
     4689                                          and edoc-lines.ProductCode = utd-lines.ProductCode
     4690                  exclusive-lock no-error.
     4691               if not available edoc-lines
     4692               then do:
     4693                  find last edoc-lines where edoc-lines.db-num      = edoc.db-num
     4694                                         and edoc-lines.doc-id      = edoc.doc-id
     4695                  no-lock no-error.
     4696                  define variable vline as integer no-undo.
     4697                  vline = if available edoc-lines then edoc-lines.linenum + 1 else 1.
     4698                  create edoc-lines.
     4699                  buffer-copy utd-lines except doc-id db-num linenum to edoc-lines
     4700                  assign
     4701                     edoc-lines.db-num = edoc.db-num
     4702                     edoc-lines.doc-id = edoc.doc-id
     4703                     edoc-lines.linenum = vline
     4704                  .
     4705               end.
     4706               else
     4707                  assign
     4708                     edoc-lines.Vat       = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Vat_old") )       + utd-lines.Vat
     4709                     edoc-lines.Total     = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Total_old") )     + utd-lines.Total
     4710                     edoc-lines.Quantity  = dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Quantity_old_new") )  + utd-lines.Quantity.
     4711                     edoc-lines.TotalWithVatExcluded = edoc-lines.Total - edoc-lines.Vat.
     4712                  .
     4713               define variable Vqnty as decimal no-undo.
     4714               Vqnty = dec(getattrUtdlines(edoc-lines.db-num,edoc-lines.doc-id,edoc-lines.LineNum,"Quantity") )
     4715                     + dec(getattrUtdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"Quantity") ).
     4716               setattrUtdlines(edoc-lines.db-num,edoc-lines.doc-id,edoc-lines.LineNum,"Quantity",string(vqnty)).
     4717               if     getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old") ne ?
     4718                  and edoc-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     4719               then
     4720                  AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,
     4721                      "loadUtd",
     4722                      "UcdUnitChangForUtd",
     4723                      string(edoc-lines.LineNum )                  + chr(4) +
     4724                      edoc-lines.UnitCode                   + chr(4) +
     4725                      getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     4726               if     utd-lines.UnitCode ne ?
     4727                  and utd-lines.UnitCode ne ""
     4728                  and utd-lines.UnitCode ne getattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old")
     4729               then
     4730                  AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,
     4731                         "loadUtd",
     4732                         "UcdUnitChang",
     4733                         string(edoc-lines.LineNum )                  + chr(4) +
     4734                         utd-lines.UnitCode                          + chr(4) +
     4735                         getattrutdlinesex(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"unitcode_old","?")).
     4736               for each utd-marking-lines where utd-marking-lines.db-num eq utd-lines.db-num
     4737                                            and utd-marking-lines.doc-id eq utd-lines.doc-id
     4738                                            and utd-marking-lines.LineNum eq utd-lines.LineNum
     4739               no-lock by utd-marking-lines.site by utd-marking-lines.doc-level desc:
     4740                  if utd-marking-lines.site eq "-"
     4741                  then do:
     4742                     if isOAD(utd-marking-lines.mark)
     4743                     then do:
     4744                        VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     4745                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     4746                                                        and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     4747                                                        and edoc-marking-lines.mark   eq utd-marking-lines.mark
     4748                        exclusive-lock no-error.
     4749                        if not available edoc-marking-lines
     4750                        then
     4751                           find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     4752                                                        and edoc-marking-lines.doc-id eq edoc.doc-id
     4753                                                        and edoc-marking-lines.mark   begins VOAD
     4754                           exclusive-lock no-error.
     4755                        if not available edoc-marking-lines
     4756                        then
     4757                           AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     4758                        else do:
     4759                           define variable v37tegdoc as character no-undo.
     4760                           define variable v37tegedoc as character no-undo.
     4761                           v37tegdoc  = GetTegCod( utd-marking-lines.mark,"37").
     4762                           v37tegedoc = GetTegCod(edoc-marking-lines.mark,"37").
     4763                           vqnty = int(v37tegedoc) - int(v37tegdoc) no-error.
     4764                           if error-status:error
     4765                           then
     4766                              message "беда с маркой" skip edoc-marking-lines.mark skip utd-marking-lines.mark
     4767                              view-as alert-box.
     4768                           else if vqnty = 0
     4769                           then
     4770                              delete edoc-marking-lines.
     4771                           else do:
     4772                              edoc-marking-lines.mark  = VOAD + string(vqnty).
     4773                              setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     4774                                             edoc-marking-lines.doc-id,
     4775                                             edoc-marking-lines.LineNum,
     4776                                             edoc-marking-lines.mark,
     4777                                             "box-qnty",
     4778                                              string(vQnty)).
     4779                           end.
     4780                        end.
     4781                     end.
     4782                     else do:
     4783                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     4784                                                        and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     4785                                                        and edoc-marking-lines.mark   eq utd-marking-lines.mark
     4786                        exclusive-lock no-error.
     4787                        if available edoc-marking-lines
     4788                        then
     4789                           delete edoc-marking-lines.
     4790                        else
     4791                           AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     4792                     end.
     4793                  end.
     4794                  else if utd-marking-lines.site eq "+"
     4795                  then do:
     4796                     if isOAD(utd-marking-lines.mark)
     4797                     then do:
     4798                        VOAD = "02" + getGtinByDM(utd-marking-lines.mark) + "37".
     4799                        find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc.db-num
     4800                                                     and edoc-marking-lines.doc-id eq edoc.doc-id
     4801                                                     and edoc-marking-lines.mark   begins VOAD
     4802                        exclusive-lock no-error.
     4803                        if available edoc-marking-lines
     4804                        then do:
     4805                           v37tegdoc  = GetTegCod( utd-marking-lines.mark,"37").
     4806                           v37tegedoc = GetTegCod(edoc-marking-lines.mark,"37").
     4807                           vqnty = int(v37tegedoc) + int(v37tegdoc) no-error.
     4808                           if error-status:error
     4809                           then
     4810                              message "беда с маркой" skip edoc-marking-lines.mark skip utd-marking-lines.mark
     4811                              view-as alert-box.
     4812                           else if vqnty = 0
     4813                           then
     4814                              delete edoc-marking-lines.
     4815                           else do:
     4816                              edoc-marking-lines.mark  = VOAD + string(vqnty).
     4817                              setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     4818                                             edoc-marking-lines.doc-id,
     4819                                             edoc-marking-lines.LineNum,
     4820                                             edoc-marking-lines.mark,
     4821                                             "box-qnty",
     4822                                              string(vQnty)).
     4823                           end.
     4824                        end.
     4825                        else do:
     4826                           create edoc-marking-lines.
     4827                           buffer-copy utd-marking-lines except doc-id db-num to edoc-marking-lines
     4828                           assign
     4829                              edoc-marking-lines.db-num = edoc.db-num
     4830                              edoc-marking-lines.doc-id = edoc.doc-id
     4831                           .
     4832                           setAttrUtdMarkingLines (edoc-marking-lines.db-num,
     4833                                             edoc-marking-lines.doc-id,
     4834                                             edoc-marking-lines.LineNum,
     4835                                             edoc-marking-lines.mark,
     4836                                             "box-qnty",
     4837                                              string(int(GetTegCod(edoc-marking-lines.mark,"37")))) no-error.
     4838                        end.
     4839                     end.
     4840                     else do:
     4841                     find first edoc-marking-lines where edoc-marking-lines.db-num eq edoc-lines.db-num
     4842                                                     and edoc-marking-lines.doc-id eq edoc-lines.doc-id
     4843                                                     and edoc-marking-lines.mark   eq utd-marking-lines.mark
     4844                     no-lock no-error.
     4845                     if not available edoc-marking-lines
     4846                     then do:
     4847                        create edoc-marking-lines.
     4848                        buffer-copy utd-marking-lines except doc-id db-num linenum to edoc-marking-lines
     4849                        assign
     4850                           edoc-marking-lines.db-num  = edoc-lines.db-num
     4851                           edoc-marking-lines.doc-id  = edoc-lines.doc-id
     4852                           edoc-marking-lines.linenum = edoc-lines.linenum
     4853                        .
     4854                     end.
     4855                     else
     4856                        AddUtdErr(edoc.db-num,edoc.doc-id,buffer edoc-lines:handle,"Edoc","Mark" + utd-marking-lines.site,utd-marking-lines.mark).
     4857                  end.
     4858               end.
     4859               release edoc-lines.
     4860            end.
     4861            release edoc-lines.
     4862         end.
     4863         find first utd_ret where utd_ret.parentDocumentExt     eq utd.parentDocumentExt
     4864                                 and utd_ret.parentOrganizationExt eq utd.parentOrganizationExt
     4865                                 and utd_ret.Timestamp             le utd.Timestamp
     4866                                 and utd_ret.EDocType              eq objSrv:Env:Utd:EDocType:returns:KeyIntDB
     4867            no-lock no-error.
     4868         if not avail utd_ret
     4869         then
     4870            CheckEdoc (vdb-num,vdoc-id,edoc.db-num,edoc.doc-id) .
     4871      end.
     4872      for each utd where utd.PackageId eq iPack
     4873                        and utd.EDocType  eq objSrv:Env:Utd:EDocType:edoc:KeyIntDB
     4874                        and utd.Timestamp < iTimestamp
     4875         exclusive-lock:
     4876            utd.sts-edi = objSrv:Env:Utd:sts:edi:Changed:KeyIntDB.
     4877            utd.sts     = objSrv:Env:Utd:sts:th:Rejection:KeyIntDB.
     4878         end.
     4879         unsubscribe "getNextseq".
     4880      end.
     4881   end.
     4882   define variable Mext-sys as integer no-undo init ?.
     4883   define variable mdb-num-local as integer no-undo.
     4884   run gbl/getdbnum.p (output mdb-num-local).
     4885   function  getExtSys returns integer
     4886   ():
     4887      define buffer ext-system      for ext-system.
     4888      define buffer ext-system-attr for ext-system-attr.
     4889      Mext-sys = ?.
     4890      block-sys-obj:
     4891      for each ext-system where ext-system.esys-type eq 12
     4892                            and ext-system.db-num    eq mdb-num-local
     4893      no-lock:
     4894          find first ext-system-attr where ext-system-attr.db-num  eq ext-system.db-num
     4895                                       and ext-system-attr.esys-id eq ext-system.esys-id
     4896                                       and ext-system-attr.esya-attr-code eq 'obj':U
     4897          no-lock no-error.
     4898          if     available ext-system-attr
     4899             and           ext-system-attr.esya-attr-value eq v-cntxt-obj-type + string(v-cntxt-obj-code)
     4900          then do:
     4901             Mext-sys = ext-system-attr.esys-id.
     4902             leave block-sys-obj.
     4903          end.
     4904      end.
     4905      if Mext-sys eq ?
     4906      then do:
     4907         block-sys-host:
     4908         for each ext-system where ext-system.esys-type eq 12
     4909                               and ext-system.db-num    eq mdb-num-local
     4910         no-lock:
     4911             find first ext-system-attr where ext-system-attr.db-num  eq ext-system.db-num
     4912                                          and ext-system-attr.esys-id eq ext-system.esys-id
     4913                                          and ext-system-attr.esya-attr-code eq 'host-code':U
     4914             no-lock no-error.
     4915             if     available ext-system-attr
     4916                and           ext-system-attr.esya-attr-value eq string(v-cntxt-host-code-obj)
     4917             then do:
     4918                Mext-sys = ext-system-attr.esys-id.
     4919                leave block-sys-host.
     4920             end.
     4921         end.
     4922      end.
     4923      return Mext-sys.
     4924   end.
     4925   function  getExtAttr returns character
     4926   (input icode as character ):
     4927      define variable oValue as character no-undo.
     4928      define variable vtype as character no-undo.
     4929      define buffer ext-system for ext-system.
     4930      get-key-value section "ProxyServ" key icode value oValue.
     4931      if oValue eq ?
     4932      then do:
     4933         if Mext-sys eq ?
     4934         then
     4935            getExtSys ().
     4936         find first ext-system no-lock where ext-system.db-num  eq mdb-num-local
     4937                                         and ext-system.esys-id eq Mext-sys no-error.
     4938         if available ext-system
     4939         then do:
     4940                if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-value in g#attr-lib
     4941            (ext-system.esys-id,
     4942             mdb-num-local,
     4943             icode,
     4944             output oValue,
     4945             output vtype) no-error.
     4946          end.
     4947      end.
     4948      return if oValue eq ? then "" else oValue .
     4949   end.
     4950   function  SetExtAttr returns character
     4951   (input icode   as character,
     4952    input iValue  as character):
     4953      define variable vtype as character no-undo.
     4954      define buffer ext-system for ext-system.
     4955      if Mext-sys eq ?
     4956      then
     4957         getExtSys ().
     4958      find first ext-system no-lock where ext-system.db-num  eq mdb-num-local
     4959                                      and ext-system.esys-id eq Mext-sys no-error.
     4960      if available ext-system
     4961      then do:
     4962          if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-write in g#attr-lib
     4963         (ext-system.esys-id,
     4964          mdb-num-local,
     4965          icode,
     4966          iValue) no-error.
     4967       end.
     4968   end.
     4969   define stream File-stream.
     4970   function PutMes returns character
     4971   (idext as character ):
     4972      if valid-handle(mPublishHand)
     4973      then
     4974         publish "WriteLogAsunc" from mPublishHand (idext,yes).
     4975      else do:
     4976         if idext begins "error"
     4977         then do:
     4978            message substring (idext,6)
     4979               view-as alert-box.
     4980            if mDiadocApi ne ?
     4981            then
     4982               idext = substitute ("&1 (&2)",idext , mDiadocApi:GetFullVersion())no-error.
     4983         end.
     4984         output stream File-stream to "diadoc_user.log" append.
     4985         put stream File-stream unformatted now " " idext skip.
     4986         output stream File-stream close.
     4987      end.
     4988   end.
     4989   function PutErr returns character
     4990   (idext as character ):
     4991      define variable vi as integer no-undo.
     4992      define variable vnumerr as integer no-undo.
     4993      define variable vtext as character extent 25 no-undo .
     4994      if error-status:num-messages > 0 then do:
     4995         vnumerr = error-status:num-messages.
     4996         vnumerr = min(vnumerr,extent(vtext)).
     4997         do vi = 1 to vnumerr:
     4998            vtext[vi] = error-status:get-message(vi).
     4999         end.
     5000         idext = idext + chr(10) + "Ошибка: [":U.
     5001         do vi = 1 to vnumerr:
     5002            idext = idext + chr(10) + vtext[vi] no-error.
     5003         end.
     5004         idext = idext +  chr(10) +  " ]" no-error.
     5005         if not  idext begins "Error"
     5006         then
     5007            idext = "Error " + idext.
     5008         PutMes(idext).
     5009      end.
     5010   end.
     5011   function PutStat returns character
     5012   (itext as character,
     5013    iflag as logical):
     5014      if valid-handle(mPublishHand)
     5015      then
     5016         publish "PutStatAsunc" from mPublishHand (itext,iflag).
     5017      PutMes(itext).
     5018   end.
     5019   function chekStop returns logical
     5020   ( ):
     5021      define variable oStop as logical no-undo.
     5022      if valid-handle(mPublishHand)
     5023      then
     5024         publish "StopProc" from mPublishHand (output oStop).
     5025      return oStop.
     5026   end.
     5027   function  putloggetdesc returns logical
     5028   (is1 as character ,is2 as character ,
     5029   is3 as character ):
     5030   end.
     5031   function  getdesc returns logical
     5032   (input iObj as component-handle):
     5033      if iObj eq ? then return false.
     5034      if mdebug
     5035      then do:
     5036      output stream File-stream to "diadoc_load.txt" append.
     5037      define variable vReflector as component-handle no-undo.
     5038      define variable vDescobj  as component-handle no-undo.
     5039      define variable vPropertyNames  as component-handle no-undo.
     5040      define variable vMethodsNames as component-handle no-undo.
     5041      define variable vMethodDesc as component-handle no-undo.
     5042      define variable vMethodsName as character  no-undo.
     5043      define variable vPropertyValue as char no-undo.
     5044      create "Diadoc.Reflector" vReflector.
     5045      vDescobj = vReflector:Describe(iObj).
     5046     put   stream File-stream  unformatted skip (1)
     5047      "------------------------------------------" skip
     5048      vDescobj:GetInterfaceName() skip.
     5049      define variable vPropertyName as character no-undo.
     5050      define variable vPropertyType as character no-undo.
     5051      .
     5052      putloggetdesc(vDescobj:GetInterfaceName(),"","").
     5053      putloggetdesc("property","","").
     5054      define variable vi as integer no-undo.
     5055      define variable vii as integer no-undo.
     5056     put stream File-stream  unformatted skip "property" skip.
     5057     vPropertyNames = vDescobj:GetPropertiesNames().
     5058      vi= vPropertyNames:count.
     5059      do vi= 1 to vPropertyNames:count :
     5060         vPropertyName = "".
     5061         vPropertyType = "".
     5062         vPropertyValue = "".
     5063         vPropertyName  = vPropertyNames:GetItem(vi - 1) no-error.
     5064         vPropertyType  = vDescobj:GetPropertyType(vPropertyName) no-error .
     5065         vPropertyValue = substring((vDescobj:GetProperty(vPropertyName)),1,4000) no-error.
     5066         putloggetdesc(vPropertyName,vPropertyType,vPropertyValue).
     5067        put stream File-stream  unformatted vPropertyName " " vPropertyType  " " vPropertyValue skip.
     5068      end.
     5069      release object vPropertyNames.
     5070      put stream File-stream  unformatted skip "method" skip.
     5071      vMethodsNames = vDescobj:GetMethodsNames().
     5072      vi = vMethodsNames:count.
     5073      do vi = 1 to vMethodsNames:count :
     5074         vMethodsName = "".
     5075         vMethodsName = vMethodsNames:GetItem(vi - 1)no-error.
     5076         vMethodDesc  = vDescobj:GetMethodDesc(vMethodsName)no-error.
     5077         putloggetdesc("method",vMethodsName, vMethodDesc:RetVal).
     5078         put stream File-stream  unformatted vMethodsName  " retval " vMethodDesc:RetVal skip.
     5079         do vii  = 1 to vMethodDesc:args:count:
     5080            define variable varg as character no-undo.
     5081            varg = "".
     5082            varg = vMethodDesc:args:GetItem(vii - 1) no-error.
     5083            put stream File-stream  unformatted " args " varg  skip .
     5084            putloggetdesc(" args ",varg, "").
     5085         end.
     5086         release object vMethodDesc.
     5087      end.
     5088      release object vMethodsNames.
     5089      put stream File-stream  unformatted "end---------------------------------------" skip.
     5090      output stream File-stream close.
     5091      release object vDescobj.
     5092      release object vReflector.
     5093      end.
     5094      return true.
     5095   end.
     5096   function getxsddocum returns logical
     5097   (iOrganization as component-handle):
     5098      if iOrganization eq ? then return false.
     5099      define variable vDocumentTypes as component-handle no-undo.
     5100      define variable vDocumentType as component-handle no-undo.
     5101      define variable vFunctions as component-handle no-undo.
     5102      define variable vFunction as component-handle no-undo.
     5103      define variable vVersions as component-handle no-undo.
     5104      define variable vVersion as component-handle no-undo.
     5105      define variable vTitles as component-handle no-undo.
     5106      define variable vTitle as component-handle no-undo.
     5107      define variable vi as integer no-undo.
     5108      define variable vii as integer no-undo.
     5109      define variable viii as integer no-undo.
     5110      define variable viiii as integer no-undo.
     5111      if mdebug
     5112      then do:
     5113      output stream File-stream to "diadoc_doc.txt" append.
     5114      vDocumentTypes = iOrganization:GetDocumentTypes().
     5115      do vi =1 to vDocumentTypes:count:
     5116         vDocumentType = vDocumentTypes:GetItem(vi - 1).
     5117         put stream File-stream  unformatted "DocumentType -> NAme " vDocumentType:name skip.
     5118         put stream File-stream  unformatted "DocumentType -> Title " vDocumentType:Title skip.
     5119         vFunctions = vDocumentType:Functions.
     5120         do vii =1 to vFunctions:count:
     5121            vFunction = vFunctions:GetItem(vii - 1 ).
     5122            put stream File-stream  unformatted "DocumentType -> Function -> NAme " vFunction:name skip.
     5123            vVersions = vFunction:Versions.
     5124            do viii =1 to vVersions:count:
     5125               vVersion = vVersions:GetItem(viii - 1 ).
     5126               put stream File-stream  unformatted "DocumentType -> Function -> Version -> version " vVersion:version skip.
     5127               put stream File-stream  unformatted "DocumentType -> Function -> Version -> IsActual " vVersion:IsActual skip.
     5128               vTitles  = vVersion:Titles.
     5129               do viiii =1 to vTitles:count:
     5130                  vTitle = vTitles:GetItem(viiii - 1 ).
     5131                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> IsFormal " vTitle:IsFormal skip.
     5132                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> XsdUrl " vTitle:XsdUrl skip.
     5133                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> HaveUserDataXSD " vTitle:HaveUserDataXSD skip.
     5134                  put stream File-stream  unformatted "DocumentType -> Function -> Version -> Title -> type " vTitle:type skip.
     5135                  release object vTitle.
     5136               end.
     5137              release object vTitles.
     5138               release object vVersion.
     5139            end.
     5140            release object vVersions.
     5141            release object vFunction.
     5142         end.
     5143         release object vFunctions.
     5144         release object vDocumentType.
     5145      end.
     5146      release object vDocumentTypes.
     5147      put stream File-stream  unformatted "--------------------------------------------------- " skip.
     5148     output stream File-stream close.
     5149     end.
     5150      return true.
     5151   end.
     5152   function GetDocTitleType returns character
     5153   (iOrganizationGuid as character ,
     5154   itype as character ,
     5155   ifunction as character,
     5156   iversion as character
     5157   ):
     5158      if iOrganizationGuid eq ? then return "".
     5159      define variable vOrganization  as component-handle no-undo.
     5160      define variable vDocumentTypes as component-handle no-undo.
     5161      define variable vDocumentType  as component-handle no-undo.
     5162      define variable vFunctions     as component-handle no-undo.
     5163      define variable vFunction      as component-handle no-undo.
     5164      define variable vVersions      as component-handle no-undo.
     5165      define variable vVersion       as component-handle no-undo.
     5166      define variable vTitles        as component-handle no-undo.
     5167      define variable vTitle         as component-handle no-undo.
     5168      define variable vi             as integer no-undo.
     5169      define variable vii            as integer no-undo.
     5170      define variable viii           as integer no-undo.
     5171      define variable viiii          as integer no-undo.
     5172      define variable oTitleType as character no-undo.
     5173      vOrganization = mDiadocConnection:GetOrganizationById(iOrganizationGuid) no-error.
     5174      if vOrganization eq ? then return "".
     5175      vDocumentTypes = vOrganization:GetDocumentTypes().
     5176      do vi =1 to vDocumentTypes:count:
     5177         vDocumentType = vDocumentTypes:GetItem(vi - 1).
     5178         if vDocumentType:name eq iType
     5179         then do:
     5180            vFunctions = vDocumentType:Functions.
     5181            do vii =1 to vFunctions:count:
     5182               vFunction = vFunctions:GetItem(vii - 1 ).
     5183               if vFunction:name eq ifunction
     5184               then do:
     5185                  vVersions = vFunction:Versions.
     5186                  do viii =1 to vVersions:count:
     5187                     vVersion = vVersions:GetItem(viii - 1 ).
     5188                     if vVersion:version eq iversion
     5189                     then do:
     5190                        vTitles  = vVersion:Titles.
     5191                        do viiii =1 to vTitles:count:
     5192                           vTitle = vTitles:GetItem(viiii - 1 ).
     5193                           oTitleType = oTitleType + "," + vTitle:type.
     5194                           release object vTitle.
     5195                        end.
     5196                        release object vTitles.
     5197                     end.
     5198                     release object vVersion.
     5199                  end.
     5200                  release object vVersions.
     5201               end.
     5202               release object vFunction.
     5203            end.
     5204            release object vFunctions.
     5205         end.
     5206         release object vDocumentType.
     5207      end.
     5208      release object vDocumentTypes.
     5209      release object vOrganization.
     5210      return left-trim(oTitleType,",").
     5211   end.
     5212   define temp-table tt-type no-undo
     5213             field id as char
     5214             field name as character
     5215             index pi id .
     5216   define temp-table tt-Class no-undo like tt-type.
     5217   function crcode returns character
     5218   ():
     5219      define variable vtypelist as character no-undo.
     5220      define variable vtypename as character no-undo.
     5221      define variable vi as integer no-undo.
     5222      vtypelist =
     5223                 "UniversalTransferDocument|"
     5224                + "UniversalTransferDocumentRevision|"
     5225                + "UniversalCorrectionDocument|"
     5226                + "UniversalCorrectionDocumentRevision"
     5227                .
     5228      vtypename =
     5229                 "УПД|"
     5230                + "Исправление УПД|"
     5231                + "УКД|"
     5232                + "Исправление УКД"
     5233                .
     5234      do vi = 1 to num-entries(vtypelist,"|"):
     5235         create tt-type.
     5236         assign
     5237            tt-type.id   =  entry(vi,vtypelist,"|")
     5238            tt-type.name =  entry(vi,vtypename,"|")
     5239         .
     5240      end.
     5241      vtypelist = "Inbound|"
     5242                + "Outbound|"
     5243                + "Proxy".
     5244      vtypename = "входящий документ|"
     5245                + "исходящий документ|"
     5246                + "документ, переданный через промежуточного получателя|".
     5247      do vi = 1 to num-entries(vtypelist,"|"):
     5248         create tt-Class.
     5249         assign
     5250            tt-Class.id   =  entry(vi,vtypelist,"|")
     5251            tt-Class.name =  entry(vi,vtypename,"|")
     5252         .
     5253      end.
     5254   end.
     5255   crcode().
     5256   function getOrganizationInfo returns character
     5257   (input iContAgent as component-handle,
     5258                                                   output oinn as character,
     5259                                                   output oKpp as character,
     5260                                                   output oFnsParticipantId as character,
     5261                                                   output oOrgName as character,
     5262                                                   output oAdditionalInfo as character,
     5263                                                   output OarddrRus as character
     5264                                                    ):
     5265      define variable vi as integer no-undo.
     5266      define variable vContAgentOrganizationDetails   as component-handle no-undo.
     5267      define variable vAddrRus                        as component-handle no-undo.
     5268      if iContAgent ne ?
     5269      then do:
     5270         getdesc(iContAgent).
     5271         vContAgentOrganizationDetails = iContAgent:OrganizationDetails.
     5272         oinn = vContAgentOrganizationDetails:Inn.
     5273         oKpp = vContAgentOrganizationDetails:Kpp.
     5274         oFnsParticipantId = vContAgentOrganizationDetails:FnsParticipantId.
     5275         oAdditionalInfo = vContAgentOrganizationDetails:OrganizationAdditionalInfo.
     5276         getdesc(vContAgentOrganizationDetails).
     5277         oOrgName = vContAgentOrganizationDetails:OrgName.
     5278         getdesc(vContAgentOrganizationDetails:Address).
     5279         vAddrRus = vContAgentOrganizationDetails:Address:RussianAddress.
     5280         getdesc(vAddrRus ).
     5281         if vAddrRus ne ?
     5282         then do:
     5283            if vAddrRus:ZipCode ne ""
     5284            then
     5285               OarddrRus = OarddrRus + " " + vAddrRus:ZipCode.
     5286            if vAddrRus:Region ne ""
     5287            then
     5288               OarddrRus = OarddrRus + " Регион: " + vAddrRus:Region.
     5289            if vAddrRus:Territory ne ""
     5290            then
     5291               OarddrRus = OarddrRus + " Область: " + vAddrRus:Territory.
     5292            if vAddrRus:City ne ""
     5293            then
     5294               OarddrRus = OarddrRus + " Город: " + vAddrRus:City.
     5295            if vAddrRus:Locality ne ""
     5296            then
     5297               OarddrRus = OarddrRus + " Район: " + vAddrRus:Locality.
     5298            if vAddrRus:Street ne ""
     5299            then
     5300               OarddrRus = OarddrRus + " Улица: " + vAddrRus:Street.
     5301            if vAddrRus:Block ne ""
     5302            then
     5303               OarddrRus = OarddrRus + " Стр: " + vAddrRus:Block.
     5304            if vAddrRus:Building ne ""
     5305            then
     5306               OarddrRus = OarddrRus + " Дом: " + vAddrRus:Building.
     5307            if vAddrRus:Apartment ne ""
     5308            then
     5309               OarddrRus = OarddrRus + " Квартира: " + vAddrRus:Apartment.
     5310         end.
     5311         release object vAddrRus.
     5312         release object vContAgentOrganizationDetails.
     5313      end.
     5314   end.
     5315   function ConectByCertif return component-handle
     5316   (iThumbprint as character ):
     5317     if mDiadocApi eq ? then return ?.
     5318     if iThumbprint eq ""
     5319     then do:
     5320        release object mDiadocConnection no-error.
     5321        return ?.
     5322     end.
     5323      mDiadocApi:ApiClientId =  getextAttr('diadoc-key':U).
     5324      mDiadocApi:ServerUrl   =  getextAttr('server-addr':U).
     5325      define variable vSSl as character no-undo.
     5326      vSSl =  getextAttr('diadoc-ssl':U).
     5327      if vSSl ne ""
     5328         and logical(vSSl)
     5329      then
     5330         mDiadocApi:VerifySslCertificate = no.
     5331      if mDiadocApi:ApiClientId eq ""
     5332         or  mDiadocApi:ServerUrl eq ""
     5333      then do:
     5334        message "Не задан адрес сервера или ключ разработчика для внешей системы Диадок"
     5335        view-as alert-box.
     5336        release object mDiadocConnection no-error.
     5337        return ?.
     5338     end.
     5339     define variable VProxy as character no-undo.
     5340      vProxy =  getextAttr('proxy-addr':U).
     5341      if     vProxy ne ""
     5342         and vProxy ne ?
     5343      then do:
     5344         mDiadocApi:ProxyMode =  "UseProxy".
     5345         mDiadocApi:ProxySettings:Url = vProxy.
     5346         mDiadocApi:ProxySettings:Login    = getextAttr('proxy-login':U).
     5347         mDiadocApi:ProxySettings:Password = getextAttr('proxy-pswd':U).
     5348      end.
     5349      define variable vtest as component-handle no-undo.
     5350      vtest = mDiadocApi:TestConnection2().
     5351      if not vtest:ConnectionSuccess
     5352      then do:
     5353         PutMes(vtest:ErrorText).
     5354      end.
     5355      else
     5356         mDiadocConnection = mDiadocApi:CreateConnectionByCertificate(iThumbprint,"") no-error.
     5357      if mDiadocConnection eq ?
     5358      then
     5359         PutErr("DiadocApi:CreateConnectionByCertificate:").
     5360      release object vtest.
     5361      return mDiadocConnection.
     5362   end.
     5363   function ConectByLogin return component-handle
     5364   ():
     5365      define variable vSSl as character no-undo.
     5366      if mDiadocApi eq ? then return ?.
     5367      mDiadocApi:ApiClientId = getextAttr('diadoc-key':U).
     5368      mDiadocApi:ServerUrl   = getextAttr('server-addr':U).
     5369      if mDiadocApi:ApiClientId eq ""
     5370         or  mDiadocApi:ServerUrl eq ""
     5371      then do:
     5372        PutMes( "Error Не задан адрес сервера или ключ разработчика для внешей системы Диадок").
     5373        release object mDiadocConnection no-error.
     5374        return ?.
     5375     end.
     5376     vSSl =  getextAttr('diadoc-ssl':U).
     5377     if vSSl ne ""
     5378        and logical(vSSl)
     5379     then
     5380         mDiadocApi:VerifySslCertificate = no.
     5381     define variable VProxy as character no-undo.
     5382      vProxy =  getextAttr('proxy-addr':U).
     5383      if     vProxy ne ""
     5384         and vProxy ne ?
     5385      then do:
     5386         mDiadocApi:ProxyMode =  "UseProxy".
     5387         mDiadocApi:ProxySettings:Url = vProxy.
     5388         mDiadocApi:ProxySettings:Login    = getextAttr('proxy-login':U).
     5389         mDiadocApi:ProxySettings:Password = getextAttr('proxy-pswd':U).
     5390      end.
     5391      mDiadocConnection = mDiadocAPI:CreateConnectionByLogin(getextAttr('diadoc-user':U),getextAttr('diadoc-pwd':U)) no-error.
     5392      define variable vi as integer no-undo.
     5393      if mDiadocConnection eq ?
     5394      then
     5395         PutErr("DiadocAPI:CreateConnectionByLogin").
     5396      return mDiadocConnection.
     5397   end.
     5398   function GetDocumforid returns character
     5399   (input  iorg as character ,
     5400    input  idoc-id as character ,
     5401    output oDocument      as component-handle
     5402     ):
     5403      define variable vOrganization  as component-handle no-undo.
     5404      define variable vDocument      as component-handle no-undo.
     5405      define buffer utd           for ub.utd.
     5406      if
     5407             iorg  ne ?
     5408         and iorg  ne ""
     5409         and idoc-id ne ?
     5410         and idoc-id ne ""
     5411      then do:
     5412         vOrganization = mDiadocConnection:GetOrganizationById(iorg) no-error.
     5413         if vOrganization ne ?
     5414         then do:
     5415            oDocument = vOrganization:GetDocumentById(idoc-id,false) no-error.
     5416            if oDocument eq ?
     5417            then
     5418               PutErr(substitute("Error Нет доступа к документу &2 по организации &1. ", iorg,idoc-id)).
     5419         end.
     5420         else do:
     5421            PutErr(substitute("Error Нет доступа к организации &1 по документу &2. ", iorg,idoc-id)).
     5422            return "Нет доступа к организации " + iorg.
     5423         end.
     5424      end.
     5425      else
     5426         return "Нет доступа к организации не ЭДО".
     5427      release object vOrganization no-error.
     5428      return "".
     5429   end.
     5430   function GetDocum returns character
     5431   (input  idb-num as integer,
     5432    input  idoc-id as integer,
     5433    output oDocument      as component-handle
     5434     ):
     5435      define variable vOrganization  as component-handle no-undo.
     5436      define variable vDocument      as component-handle no-undo.
     5437      define buffer utd           for ub.utd.
     5438      find first utd where utd.db-num eq idb-num
     5439                       and utd.doc-id eq idoc-id
     5440      no-lock no-error.
     5441      if     available utd
     5442         and utd.OrganizationExt ne ?
     5443         and utd.OrganizationExt ne ""
     5444         and utd.DocumentExt ne ?
     5445         and utd.DocumentExt ne ""
     5446      then do:
     5447         vOrganization = mDiadocConnection:GetOrganizationById(utd.OrganizationExt) no-error.
     5448         if vOrganization ne ?
     5449         then do:
     5450            oDocument = vOrganization:GetDocumentById(utd.DocumentExt,false) no-error.
     5451            if oDocument eq ?
     5452            then
     5453               PutErr(substitute("Error Нет доступа к документу &2 по организации &1. ", utd.OrganizationExt,utd.DocumentExt)).
     5454            release object vOrganization no-error.
     5455         end.
     5456         else do:
     5457            PutErr(substitute("Error Нет доступа к организации &1 по документу &2. ", utd.OrganizationExt,utd.DocumentNumber)).
     5458            return "Нет доступа к организации " + utd.OrganizationExt.
     5459         end.
     5460      end.
     5461      else
     5462         return "Нет доступа к организации не ЭДО".
     5463      return "".
     5464   end.
     5465   function GetFirstUTDinPack returns logical
     5466   (input idb-num as integer,
     5467    input idoc-id as integer,
     5468    output odb-num as integer,
     5469    output odoc-id as integer ):
     5470      define buffer buf_utd for utd.
     5471      define buffer     utd for utd.
     5472      find first utd where utd.db-num eq idb-num
     5473                       and utd.doc-id eq idoc-id
     5474      no-lock no-error.
     5475      if available utd
     5476      then do:
     5477         if utd.PackageId eq ""
     5478         then do:
     5479            assign
     5480               odb-num = utd.db-num
     5481               odoc-id = utd.doc-id
     5482            .
     5483            return yes.
     5484         end.
     5485         else do:
     5486            find first buf_utd where Buf_utd.PackageId eq utd.PackageId
     5487                                 and Buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     5488            no-lock.
     5489            assign
     5490               odb-num = buf_utd.db-num
     5491               odoc-id = buf_utd.doc-id
     5492            .
     5493            return if available buf_utd then (recid(utd) eq recid(buf_utd)) else no.
     5494         end.
     5495      end.
     5496      return ?.
     5497   end.
     5498   function AddOADLine returns integer
     5499   (iDb-num  as integer ,
     5500    iDoc-id  as integer ,
     5501    ilinenum as integer ,
     5502    iGtin    as char,
     5503    iQnty    as int,
     5504    isite    as character ):
     5505       define buffer utd-marking-lines      for ub.utd-marking-lines.
     5506       define variable vnewMark as character no-undo.
     5507       define variable vQnty    as integer   no-undo.
     5508       vnewMark = "02" + iGtin + "37" + string(iQnty).
     5509       find first utd-marking-lines where utd-marking-lines.mark       = vnewMark
     5510                                      and utd-marking-lines.db-num     = idb-num
     5511                                      and utd-marking-lines.doc-id     = idoc-id
     5512                                      and utd-marking-lines.Linenum    = iLinenum
     5513       exclusive-lock no-error.
     5514       if available utd-marking-lines
     5515       then do:
     5516          delete utd-marking-lines.
     5517          vQnty = AddOADLine(idb-num, idoc-id, iLinenum, iGtin, iQnty * 2 ,isite ).
     5518       end.
     5519       else do:
     5520          create utd-marking-lines.
     5521          assign
     5522             utd-marking-lines.mark      = vnewMark
     5523             utd-marking-lines.db-num    = idb-num
     5524             utd-marking-lines.doc-id    = idoc-id
     5525             utd-marking-lines.Linenum   = iLinenum
     5526             utd-marking-lines.site      = isite
     5527             utd-marking-lines.doc-level = 1
     5528             utd-marking-lines.gds-code  = ?
     5529          .
     5530          vQnty = iQnty.
     5531       end.
     5532       return vQnty.
     5533    end.
     5534   function addMarkforUtd returns recid
     5535   (iDb-num  as integer ,
     5536    iDoc-id  as integer ,
     5537    ilinenum as integer ,
     5538    iMark as character  ,
     5539    isite   as character,
     5540    iUtdType as character    ):
     5541       define buffer     marking            for ub.marking.
     5542       define buffer     marking-attr       for ub.marking-attr.
     5543       define buffer utd-marking-lines      for ub.utd-marking-lines.
     5544       define buffer utd-marking-lines-attr for ub.utd-marking-lines-attr.
     5545       define variable vMRC  as decimal no-undo.
     5546       define variable vQnty as decimal no-undo.
     5547      define variable vRec as recid no-undo.
     5548      if     imark ne "-"
     5549         and imark ne ""
     5550         and imark ne ?
     5551      then do:
     5552         imark = repTegforDm(imark).
     5553         vQnty = getQntyUTDByCodId(imark) .
     5554         find first utd-marking-lines where utd-marking-lines.mark       = imark
     5555                                        and utd-marking-lines.db-num     = idb-num
     5556                                        and utd-marking-lines.doc-id     = idoc-id
     5557                                        and utd-marking-lines.Linenum    = iLinenum
     5558         exclusive-lock no-error.
     5559         if not available utd-marking-lines
     5560         then do:
     5561            create utd-marking-lines.
     5562            assign
     5563               utd-marking-lines.mark      = imark
     5564               utd-marking-lines.db-num    = idb-num
     5565               utd-marking-lines.doc-id    = idoc-id
     5566               utd-marking-lines.Linenum   = iLinenum
     5567               utd-marking-lines.site      = isite
     5568               utd-marking-lines.doc-level = 1
     5569               utd-marking-lines.gds-code  = ?
     5570            .
     5571            create utd-marking-lines-attr.
     5572            assign
     5573               utd-marking-lines-attr.mark      = imark
     5574               utd-marking-lines-attr.db-num    = idb-num
     5575               utd-marking-lines-attr.doc-id    = idoc-id
     5576               utd-marking-lines-attr.Linenum   = iLinenum
     5577               utd-marking-lines-attr.attr-code = "box-qnty"
     5578               utd-marking-lines-attr.attr-value = string(vQnty)
     5579            .
     5580            vRec = recid(utd-marking-lines).
     5581            release utd-marking-lines-attr.
     5582            release utd-marking-lines.
     5583         end.
     5584         else do:
     5585            if    (    isite eq "-"
     5586               and utd-marking-lines.site eq "+")
     5587            or (    isite eq "+"
     5588               and utd-marking-lines.site eq "-")
     5589            then
     5590               delete utd-marking-lines.
     5591            else if isOAD (imark)
     5592            then do:
     5593               vQnty = AddOADLine(idb-num, idoc-id, iLinenum, GetTegCod(imark,"02"), int(vQnty) ,isite ).
     5594               create utd-marking-lines-attr.
     5595               assign
     5596                  utd-marking-lines-attr.mark      = imark
     5597                  utd-marking-lines-attr.db-num    = idb-num
     5598                  utd-marking-lines-attr.doc-id    = idoc-id
     5599                  utd-marking-lines-attr.Linenum   = iLinenum
     5600                  utd-marking-lines-attr.attr-code = "box-qnty"
     5601                  utd-marking-lines-attr.attr-value = string(vQnty)
     5602               .
     5603            end.
     5604            vRec = recid(utd-marking-lines).
     5605            release utd-marking-lines.
     5606         end.
     5607         if isMark (imark)
     5608         then do:
     5609            find first marking where marking.mark eq iMark exclusive-lock no-error.
     5610            if not available marking
     5611            then do:
     5612               create marking.
     5613               marking.mark = iMark.
     5614               marking.gds-code = ?.
     5615               marking.unit     = getLevelUTDByCodId(marking.mark) .
     5616            end.
     5617            assign
     5618              marking.unit-ext   = if marking.unit-ext = "" or marking.unit-ext = ? then
     5619                                      getLevelMotpByCodId(marking.mark)
     5620                                   else marking.unit-ext
     5621              marking.box-qnty   = vQnty
     5622              marking.unit       = if marking.unit-ext = "LEVEL2" then "КИТУ" else getLevelUTDByCodId(marking.mark)
     5623            .
     5624            if        (     iUtdType eq "UniversalTransferDocument"
     5625                     and marking.sts = objSrv:Env:marking:Sts:Mark:NotAvailable:KeyIntDB)
     5626            then
     5627               marking.sts = ?.
     5628         end.
     5629      end.
     5630      return vRec.
     5631   end.
     5632   function isSaleMarkInUpak returns logical
     5633   (iMark    as char ):
     5634      define buffer buf_marking       for ub.marking.
     5635      for each buf_marking no-lock where
     5636               buf_marking.mark-parent = iMark
     5637      :
     5638        if can-do(objSrv:Env:marking:Sts:Mark:Sale_Return_Wait,string(buf_marking.sts)) or
     5639           can-do(objSrv:Env:marking:Sts:Mark:Doc_Status,string(buf_marking.sts)) then
     5640          return true.
     5641        if isSaleMarkInUpak(buf_marking.mark) then
     5642          return true.
     5643      end.
     5644      return false.
     5645    end.
     5646   function setStatusUpak returns logical
     5647   (iDbNum   as integer ,
     5648    iDocId   as integer ,
     5649    iLineNum as integer ,
     5650    iMark    as char ,
     5651    iSts     as integer):
     5652      define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     5653      define buffer buf_marking           for ub.marking.
     5654      for each buf_marking exclusive-lock where
     5655               buf_marking.mark-parent = iMark,
     5656         first buf_utd-marking-lines exclusive-lock where
     5657               buf_utd-marking-lines.doc-id  = iDocId
     5658           and buf_utd-marking-lines.db-num  = iDbNum
     5659           and buf_utd-marking-lines.lineNum = iLineNum
     5660           and buf_utd-marking-lines.mark = buf_marking.mark
     5661      :
     5662        setStatusUpak(iDbNum, iDocId, iLineNum, buf_marking.mark, iSts).
     5663      end.
     5664      for first buf_utd-marking-lines exclusive-lock where
     5665                buf_utd-marking-lines.doc-id  = iDocId
     5666            and buf_utd-marking-lines.db-num  = iDbNum
     5667            and buf_utd-marking-lines.lineNum = iLineNum
     5668            and buf_utd-marking-lines.mark = iMark,
     5669          first buf_marking exclusive-lock where
     5670                buf_marking.mark = buf_utd-marking-lines.mark
     5671      :
     5672        if  buf_marking.sts <> objSrv:Env:marking:Sts:Mark:MarkError:KeyIntDB
     5673        then do:
     5674          assign
     5675            buf_utd-marking-lines.sts = iSts
     5676            buf_marking.sts           = iSts
     5677          .
     5678        end.
     5679      end.
     5680      return true.
     5681   end.
     5682   define temp-table tt-recid no-undo
     5683             field orgid as char
     5684             field docid as char
     5685             field parent as char
     5686             field stamp as datetime
     5687             index pi orgid docid
     5688             index parent parent  stamp.
     5689   function ProcessSystemMessStart return component-handle
     5690   (IStartStop as logical):
     5691      if mDiadocConnection eq ? then
     5692      define variable vOrganizationList as component-handle no-undo.
     5693      define variable vOrganization as component-handle no-undo.
     5694      define variable vReceiptGenerationProcess as component-handle no-undo.
     5695      define variable vi as integer no-undo.
     5696      if mDiadocConnection ne ?
     5697      then do:
     5698         vOrganizationList = mDiadocConnection:GetOrganizationList().
     5699          do vi = 1 to vOrganizationList:count:
     5700             vOrganization = vOrganizationList:GetItem(vi - 1 ).
     5701             vReceiptGenerationProcess = vOrganization:GetReceiptGenerationProcess().
     5702             release object vOrganization.
     5703             if IStartStop
     5704             then
     5705                vReceiptGenerationProcess:Start().
     5706             else
     5707                vReceiptGenerationProcess:Stop().
     5708             release object vReceiptGenerationProcess.
     5709          end.
     5710          release object vOrganizationList.
     5711      end.
     5712   end.
     5713   procedure  changeIdToGuid :
     5714   define input  parameter iOrganization as component-handle no-undo.
     5715      define variable vOrgId   as character no-undo.
     5716      define variable vOrgGuid as character no-undo.
     5717      define buffer utd for utd.
     5718      assign
     5719         vOrgId   = iOrganization:id.
     5720         vOrgGuid = iOrganization:guid
     5721      no-error.
     5722      if     error-status:num-messages eq 0
     5723         and vOrgId   ne ""
     5724         and vOrgGuid ne ""
     5725      then do:
     5726         define variable vfirst as logical no-undo init yes.
     5727         repeat preselect each utd where utd.OrganizationExt = vOrgId exclusive-lock:
     5728            find next utd.
     5729            if vfirst
     5730            then do:
     5731               PutMes("Конвертация документов").
     5732               vfirst = no.
     5733            end.
     5734            utd.OrganizationExt = vOrgGuid.
     5735            validate utd.
     5736            PutMes(substitute ("У документа &1 изменен индификатор организации с &2 на &3",ub.utd.DocumentNumber,vOrgId,utd.OrganizationExt)).
     5737         end.
     5738         if not vfirst
     5739         then
     5740            PutMes("Конвертация документов завершина.").
     5741      end.
     5742   end.
     5743   procedure getNewUpd :
     5744      define variable VLastDate as date no-undo init ?.
     5745      define variable vDocument     as component-handle no-undo.
     5746      define variable vYear         as integer no-undo.
     5747      define variable vMonth        as integer no-undo.
     5748      define variable vDay          as integer no-undo.
     5749      define variable vBegLoadDate  as date    no-undo.
     5750      define variable vLastLoadDate as date    no-undo.
     5751      define buffer utd for utd.
     5752      VLastDate = date( getextAttr('diadoc-lastload':U)) no-error.
     5753      find first sys-ctrl no-lock.
     5754      if VLastDate eq ?
     5755      then
     5756         VLastDate = sys-ctrl.cut-date + 3.
     5757      else if sys-ctrl.cut-date ne ?
     5758      then
     5759         VLastDate = max(VLastDate,sys-ctrl.cut-date + 3) .
     5760      vLastLoadDate = VLastDate.
     5761      for each tt-recid:
     5762         delete tt-recid.
     5763      end.
     5764      if chekStop() then return "Остановка пользователем".
     5765       run  UpdateUTDInform(if VLastDate eq ? then today - 365 else VLastDate - 3,today + 1,output VLastDate).
     5766      if chekStop() then return "Остановка пользователем".
     5767      if VLastDate ne ?
     5768      then do:
     5769         setextAttr('diadoc-lastload':U,string(VLastDate)).
     5770         vYear = year(vLastLoadDate).
     5771         vMonth = month(vLastLoadDate) - 2.
     5772         vDay   = day(vLastLoadDate).
     5773         if vMonth <= 0 then
     5774            assign
     5775               vMonth = vMonth + 12
     5776               vYear  = vYear - 1
     5777               .
     5778         repeat:
     5779            vBegLoadDate = date(vMonth, vDay, vYear) no-error.
     5780            if error-status:error then
     5781               vDay = vDay - 1.
     5782            else
     5783               leave.
     5784         end.
     5785         vBegLoadDate = vBegLoadDate + 1.
     5786      end.
     5787      block-rec:
     5788      for each tt-recid break by tt-recid.parent descending by tt-recid.stamp descending :
     5789         if  tt-recid.parent eq ""
     5790         then next  block-rec.
     5791         if first-of (tt-recid.parent)
     5792         then do:
     5793            for each utd where utd.PackageId eq tt-recid.parent
     5794            no-lock break by utd.PackageId descending by utd.Timestamp descending :
     5795               if chekStop() then return "Остановка пользователем".
     5796               if utd.EDocType = objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     5797               then do:
     5798                  subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     5799                  MySeqUtd = ?.
     5800                  CrEdoc(utd.PackageId,utd.Timestamp).
     5801                  unsubscribe "getNextseq".
     5802                  next block-rec.
     5803               end.
     5804            end.
     5805         end.
     5806      end.
     5807      PutMes("Обновление информации по ранее загруженным документам за период c " + (if vBegLoadDate <> ? then
     5808                                                                                        string(vBegLoadDate)
     5809                                                                                     else "?")
     5810                                                                                     + " по " +
     5811                                                                                     (if vLastLoadDate <> ? then
     5812                                                                                         string(vLastLoadDate)
     5813                                                                                      else
     5814                                                                                         "?")
     5815                                                                                      ).
     5816      define variable vobj as character no-undo.
     5817      vobj = getExtAttr('host-code':U).
     5818      if vobj ne "0"
     5819      then
     5820          for each utd where utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     5821                         and utd.host-code eq int(vobj)
     5822                         and (   utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     5823                              or utd.EDocType eq objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     5824                              )
     5825          no-lock break by utd.OrganizationExt:
     5826             if chekStop() then return "Остановка пользователем".
     5827             if vBegLoadDate <> ? and utd.DocumentDate < vBegLoadDate then next.
     5828             find first tt-recid where tt-recid.orgid = utd.OrganizationExt
     5829                                   and tt-recid.docid = utd.DocumentExt
     5830                    no-error.
     5831             if     not available tt-recid
     5832                and getdocum (utd.db-num, utd.doc-id, output vDocument) eq ""
     5833             then do:
     5834                 run  UpdateUTDInformOne(vDocument).
     5835                release object vDocument no-error.
     5836             end.
     5837          end.
     5838      vobj = getExtAttr('obj':U).
     5839      if vobj ne ""
     5840      then
     5841          for each utd where utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     5842                         and utd.obj-type + string(utd.obj-code) eq vobj
     5843          no-lock break by utd.OrganizationExt:
     5844             if chekStop() then return "Остановка пользователем".
     5845             if vBegLoadDate <> ? and utd.DocumentDate < vBegLoadDate then next.
     5846             find first tt-recid where tt-recid.orgid = utd.OrganizationExt
     5847                                   and tt-recid.docid = utd.DocumentExt
     5848                    no-error.
     5849             if     not available tt-recid
     5850                and getdocum (utd.db-num, utd.doc-id, output vDocument) eq ""
     5851             then do:
     5852                 run  UpdateUTDInformOne(vDocument).
     5853                release object vDocument no-error.
     5854             end.
     5855          end.
     5856   end.
     5857   procedure  SendAuto:
     5858    define variable vOrganization as component-handle no-undo.
     5859    define variable vOrganizationList as component-handle no-undo.
     5860    define variable vi as integer no-undo.
     5861      if mDiadocConnection eq ?
     5862      then do:
     5863         message "По данному сертификату не удалось подключиться к Диадок"
     5864         view-as alert-box.
     5865      end.
     5866      else do:
     5867         for each tt-recid:
     5868            delete tt-recid.
     5869         end.
     5870         vOrganizationList = mDiadocConnection:GetOrganizationList() no-error.
     5871         if vOrganizationList eq ? then return error ?.
     5872         vi = vOrganizationList:Count()no-error.
     5873         if vi eq ?
     5874         then
     5875            return error ?.
     5876         do vi = 1 to vOrganizationList:Count() :
     5877            vOrganization = vOrganizationList:GetItem(vi - 1 ).
     5878            define variable vorgid as character no-undo.
     5879            vorgid = vOrganization:guid.
     5880            for each utd where utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     5881                           and utd.host-code eq v-cntxt-host-code-obj
     5882                           and utd.OrganizationExt eq vorgid
     5883            no-lock:
     5884                run  SendReceiptsAsync(utd.db-num,utd.doc-id).
     5885            end.
     5886            for each utd where utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     5887                           and utd.host-code eq v-cntxt-host-code-obj
     5888                           and utd.OrganizationExt eq vorgid
     5889            no-lock:
     5890                run  updOneUTD(utd.db-num,utd.doc-id).
     5891            end.
     5892         end.
     5893      end.
     5894   end.
     5895   procedure SendAccept:
     5896      define input  parameter iTypeAccept     as character no-undo.
     5897      define input  parameter iReplyTask      as component-handle no-undo.
     5898      define input  parameter iOrganizationGuid as character no-undo.
     5899      define input  parameter iWorkflowId     as integer no-undo.
     5900      define input  parameter iTitleTypes    as character  no-undo.
     5901      define output parameter oOperationCode as character no-undo.
     5902      define variable vContentItems as component-handle no-undo.
     5903      define variable vContentItem  as component-handle no-undo.
     5904      define variable vSigner       as component-handle no-undo.
     5905      define variable vBuyerTitle   as component-handle no-undo.
     5906      define variable vEmployee     as component-handle no-undo.
     5907      define variable vContentOperCode as component-handle no-undo.
     5908      define variable vOrganization   as component-handle no-undo.
     5909      define variable vUserperm   as component-handle no-undo.
     5910      define variable vi as integer no-undo.
     5911     define variable vdate as date no-undo.
     5912     define variable vDocumentCreator as character no-undo.
     5913     define variable vDocumentCreatorBase as character no-undo.
     5914     define variable vOperationCode as character no-undo.
     5915     define variable vOperationContenttext as character no-undo.
     5916     define variable vOperationContent as character no-undo.
     5917     define variable vThumbprint as character no-undo.
     5918     define variable vJobTitle   as character no-undo.
     5919     vThumbprint = mDiadocConnection:Certificate:Thumbprint.
     5920     vOrganization = mDiadocConnection:GetOrganizationById(iOrganizationGuid) no-error.
     5921     if vOrganization eq ?
     5922     then do:
     5923        run str\utdacp.w (output vdate, output  vDocumentCreator, output vDocumentCreatorBase, output vOperationCode, output vOperationContent) no-error.
     5924        if vdate eq ?
     5925        then
     5926           return error "".
     5927     end.
     5928     else do:
     5929        define variable vTitleType as character no-undo.
     5930        define variable vSignSet   as component-handle no-undo.
     5931        define variable vSeller as logical no-undo.
     5932        vUserperm = vOrganization:GetUserPermissions().
     5933        vJobTitle = vUserperm:JobTitle.
     5934        release object vUserperm.
     5935        blk-tit:
     5936        do vi = 1 to num-entries(iTitleTypes):
     5937           vTitleType = entry(vi,iTitleTypes).
     5938           vSeller = index(vTitleType,"Seller") > 0.
     5939           if vSeller
     5940           then
     5941              next blk-tit.
     5942           vSignSet = vOrganization:GetExtendedSignerDetails2(vThumbprint, vTitleType) no-error.
     5943           if error-status:num-messages > 0
     5944           then do:
     5945              define variable vTasksetSign   as component-handle no-undo.
     5946              define variable vTasksetSignDetal   as component-handle no-undo.
     5947              vTasksetSign = vOrganization:CreateSetExtendedSignerDetailsTask(VThumbprint).
     5948              getdesc(vTasksetSign).
     5949              vTasksetSign:DocumentTitleType = vTitleType.
     5950              getdesc(vTasksetSign).
     5951              vTasksetSignDetal = vTasksetSign:ExtendedSignerDetailsToPost.
     5952              getdesc(vTasksetSignDetal).
     5953              vTasksetSignDetal:JobTitle  = vJobTitle    .
     5954              vTasksetSignDetal:SignerType = "LegalEntity" .
     5955              vTasksetSignDetal:SignerInfo = "".
     5956              vTasksetSignDetal:Powers = if VSeller then "InvoiceSigner"  else "PersonDocumentedOperation".
     5957              vTasksetSignDetal:Status = if VSeller then "SellerEmployee" else "BuyerEmployee".
     5958              vTasksetSignDetal:PowersBase = "Должностные обязанности".
     5959              getdesc(vTasksetSignDetal).
     5960              release object vTasksetSignDetal.
     5961              vTasksetSign:send() no-error.
     5962              if error-status:num-messages > 0 then do:
     5963                 PutErr(substitute("Error Ошибка при установке подписанта по документу &1 ", vTitleType )).
     5964              end.
     5965              release object vTasksetSign.
     5966           end.
     5967           else do:
     5968              getdesc(vSignSet).
     5969              release object vSignSet.
     5970           end.
     5971        end.
     5972        vOperationContent = if iTypeAccept eq "AcceptDocumentWithDisc"
     5973                            then "2"
     5974                            else if iTypeAccept eq "AcceptDocumentNotAccepted"
     5975                            then "3"
     5976                            else "1".
     5977        vdate = today.
     5978        vDocumentCreator = substitute("&1, ИНН~/КПП &2~/&3", vOrganization:name , vOrganization:inn , vOrganization:kpp).
     5979        release object vOrganization.
     5980     end.
     5981     if    vJobTitle eq ?
     5982        or vJobTitle eq ""
     5983     then
     5984        vJobTitle = mDiadocConnection:Certificate:JobTitle.
     5985      if (   iWorkflowId = 3
     5986         or iWorkflowId = 5
     5987         or iWorkflowId = 8
     5988         or iWorkflowId = 11
     5989         or iWorkflowId = 12
     5990         or iWorkflowId = 13
     5991         or iWorkflowId = 16)
     5992         and iReplyTask ne ?
     5993      then do:
     5994         getdesc(iReplyTask).
     5995         vContentItems = iReplyTask:ContentItems.
     5996         getdesc(vContentItems).
     5997         do vi = 1 to vContentItems:count:
     5998            getdesc(vContentItems:GetItem(vi - 1 )).
     5999            getdesc(vContentItems:GetItem(vi - 1 ):document).
     6000            vContentItem = vContentItems:GetItem(vi - 1 ):Content.
     6001            getdesc(vContentItem).
     6002            vBuyerTitle = vContentItem:UniversalTransferDocumentBuyerTitle no-error.
     6003            getdesc(vBuyerTitle).
     6004              if vBuyerTitle eq ?
     6005            then do:
     6006               vBuyerTitle = vContentItem:UniversalCorrectionDocumentBuyerTitle.
     6007               getdesc(vBuyerTitle).
     6008               vOperationContenttext = "C изменением стоимости согласен".
     6009            end.
     6010            else do:
     6011               oOperationCode = vOperationContent.
     6012      vOperationContenttext = if vOperationContent eq "1"
     6013                          then "Принято без разногласий"
     6014                          else if vOperationContent eq "2"
     6015                          then "Принято с разногласиями"
     6016                          else if vOperationContent eq "3"
     6017                          then "Товары не приняты"
     6018                          else vOperationContent.
     6019               getdesc(vBuyerTitle).
     6020               vEmployee = vBuyerTitle:Employee.
     6021               getdesc(vEmployee).
     6022               define variable vUser   as component-handle no-undo.
     6023               vUser = mDiadocConnection:GetMyUser().
     6024               getdesc(vUser).
     6025               vEmployee:position        = vJobTitle    .
     6026               vEmployee:FirstName       = vUser:FirstName  .
     6027               vEmployee:LastName        = vUser:LastName   .
     6028               vEmployee:MiddleName      = vUser:MiddleName .
     6029               vEmployee:EmployeeBase     = "Должностные обязанности".
     6030               release object vUser.
     6031               getdesc(vEmployee).
     6032               getdesc(mDiadocConnection:Certificate).
     6033               getdesc(vContentItem:UniversalTransferDocumentBuyerTitle).
     6034               getdesc(vBuyerTitle:ContentOperCode).
     6035               vContentOperCode = vBuyerTitle:ContentOperCode.
     6036               vContentOperCode:TotalCode = vOperationContent.
     6037               vBuyerTitle:OperationCode   = oOperationCode.
     6038               release object vContentOperCode.
     6039               release object vEmployee.
     6040            end.
     6041            vBuyerTitle:DocumentCreator = vDocumentCreator .
     6042            vBuyerTitle:DocumentCreatorBase     = vDocumentCreatorBase.
     6043            vBuyerTitle:OperationContent =  vOperationContenttext.
     6044            vBuyerTitle:AcceptanceDate   = vdate.
     6045            getdesc(vBuyerTitle).
     6046            getdesc(vBuyerTitle:Signers).
     6047            vSigner = vBuyerTitle:Signers:additems().
     6048            getdesc(vSigner).
     6049            getdesc(vSigner:SignerReference).
     6050            getdesc(vSigner:SignerDetails).
     6051            vSigner:SignerReference:CertificateThumbprint = mDiadocConnection:Certificate:Thumbprint.
     6052            vSigner:SignerReference:boxid = iOrganizationGuid.
     6053            getdesc(vSigner:SignerReference).
     6054            release object vBuyerTitle no-error.
     6055            release object vContentItem.
     6056         end.
     6057         release object vContentItems.
     6058      end.
     6059   end.
     6060   function SendAnswer returns character
     6061   (iReplyTask as component-handle,iorg as char,iTypeAnswer as character,imes as longchar ):
     6062      define variable vContent       as component-handle no-undo.
     6063      define variable vContentItems  as component-handle no-undo.
     6064      define variable vSigner        as component-handle no-undo.
     6065      define variable vSignTask      as component-handle no-undo.
     6066      define variable vOrganization  as component-handle no-undo.
     6067      define variable vUserperm      as component-handle no-undo.
     6068      define variable vUser          as component-handle no-undo.
     6069      define variable vi as integer no-undo.
     6070      if     itypeAnswer ne "AcceptRevocation"
     6071         and iReplyTask  ne ?
     6072      then do:
     6073         getdesc(iReplyTask).
     6074         vContentItems = iReplyTask:ContentItems.
     6075         getdesc(vContentItems).
     6076         do vi = 1 to vContentItems:count:
     6077            getdesc(vContentItems:GetItem(vi - 1 )).
     6078            getdesc(vContentItems:GetItem(vi - 1 ):document).
     6079            vContent = vContentItems:GetItem(vi - 1 ):Content.
     6080            vContent:comment =  imes.
     6081           getdesc(vContent).
     6082            vSigner = vContent:Signer.
     6083            getdesc(vSigner).
     6084            vOrganization = mDiadocConnection:GetOrganizationById(iOrg) no-error.
     6085            vUserperm = vOrganization:GetUserPermissions().
     6086            define variable vJobTitle as character no-undo.
     6087            vJobTitle = vUserperm:JobTitle.
     6088            if    vJobTitle eq ?
     6089               or vJobTitle eq ""
     6090            then
     6091               vJobTitle = mDiadocConnection:Certificate:JobTitle.
     6092            release object vUserperm.
     6093            release object vOrganization.
     6094            vUser = mDiadocConnection:GetMyUser().
     6095            getdesc(vUser).
     6096            vSigner:Surname    = vUser:FirstName.
     6097            vSigner:FirstName  = vUser:LastName.
     6098            vSigner:Patronymic = vUser:MiddleName.
     6099            vSigner:JobTitle   = vJobTitle.
     6100            vSigner:Inn        = mDiadocConnection:Certificate:inn.
     6101            getdesc(vSigner).
     6102            release object vUser.
     6103            release object vSigner.
     6104            release object vContent.
     6105         end.
     6106         release object vContentItems.
     6107      end.
     6108   end.
     6109   procedure send:
     6110      define input  parameter iDocument as component-handle no-undo.
     6111      define input  parameter iTypeAnswer as character no-undo.
     6112      define input  parameter icomment as character no-undo.
     6113      define output parameter oOperationCode as character no-undo.
     6114      define variable vReplyTask    as component-handle no-undo.
     6115      define variable vTypeAnswer as character no-undo.
     6116      define variable vTypeAnswer_orig as character no-undo.
     6117      define variable Vmes as longchar  no-undo.
     6118      define variable vOrganizationGuid as character no-undo.
     6119      define variable vDocumentid as character no-undo.
     6120      define variable vi as integer no-undo.
     6121      if iDocument ne ?
     6122      then do:
     6123         case iTypeAnswer:
     6124            when "Подписания"                 then vTypeAnswer =  "AcceptDocument".
     6125            when "отказ подписи"              then vTypeAnswer =  "RejectDocument".
     6126            when "запрос коректировки"        then vTypeAnswer =  "CorrectionRequest".
     6127            when "Запрос анулирование"        then vTypeAnswer =  "RevocationRequest".
     6128            when "Подтверждение анулирования" then vTypeAnswer =  "AcceptRevocation".
     6129            when "отказ анулирования"         then vTypeAnswer =  "RejectRevocation".
     6130            when "подписать с расхождениями"  then vTypeAnswer =  "AcceptDocumentWithDisc".
     6131            when "подписать товар не принят"  then vTypeAnswer =  "AcceptDocumentNotAccepted".
     6132            otherwise vTypeAnswer = iTypeAnswer .
     6133         end case.
     6134         vTypeAnswer_orig = vTypeAnswer.
     6135         if    vTypeAnswer =  "AcceptDocumentWithDisc"
     6136            or vTypeAnswer =  "AcceptDocumentNotAccepted"
     6137         then
     6138            vTypeAnswer =  "AcceptDocument".
     6139         if mDiadocConnection:AuthenticateType ne "Certificate" then return error "не сертификат".
     6140         vReplyTask = iDocument:CreateReplySendTask2(vTypeAnswer).
     6141         vOrganizationGuid = iDocument:OrganizationGuid.
     6142         vDocumentid     = iDocument:DocumentId.
     6143         getdesc(iDocument).
     6144         if vTypeAnswer =  "AcceptDocument"
     6145         then do:
     6146            define variable vtitletype as character no-undo.
     6147            vTitleType = GetDocTitleType(vOrganizationGuid,iDocument:TypeNamedId,iDocument:DocumentFunction,iDocument:Version).
     6148            run sendAccept in this-procedure (vTypeAnswer_orig,
     6149                                              vReplyTask,
     6150                                              iDocument:OrganizationGuid,
     6151                                              iDocument:WorkflowId,
     6152                                              vtitletype,
     6153                                              output oOperationCode ) no-error.
     6154            if error-status:error
     6155            then
     6156               return error "".
     6157         end.
     6158         else do:
     6159            find first utd where utd.DocumentExt     = vDocumentid
     6160                             and utd.OrganizationExt = vOrganizationGuid
     6161            no-lock no-error.
     6162            if available utd
     6163            then do:
     6164               if   vTypeAnswer ne  "CorrectionRequest"
     6165                   and vTypeAnswer ne  "RejectDocument"
     6166               then
     6167                  icomment = "".
     6168               if vTypeAnswer eq  "RejectDocument"
     6169               then do:
     6170                  if icomment eq ? or icomment eq "" then icomment = utd.comment.
     6171                  Vmes = (if icomment ne ? and icomment ne "" then icomment + "," else "" ) + GetErrForUtdStr(utd.db-num,utd.doc-id,?).
     6172               end.
     6173               else do:
     6174                   Vmes = GetErrForUtd(utd.db-num,utd.doc-id,?) .
     6175                   Vmes = GetErrComText(icomment,Vmes).
     6176               end.
     6177               if mFlaftest
     6178               then do:
     6179                  output stream File-stream to "SendAnswer.txt" .
     6180                  put stream File-stream unformatted string(Vmes).
     6181                  output stream File-stream close.
     6182                  message "сформирован файл " search("SendAnswer.txt")
     6183                  view-as alert-box.
     6184                  return error "ничего не отправляем".
     6185               end.
     6186               else
     6187                  SendAnswer(vReplyTask,iDocument:OrganizationGuid, iTypeAnswer,Vmes) no-error.
     6188               if error-status:error
     6189               then
     6190                  return error "".
     6191               end.
     6192            end.
     6193         if not mFlaftest
     6194         then do:
     6195            getdesc(vReplyTask).
     6196             vReplyTask:Send() no-error.
     6197            if error-status:num-messages > 0 then do:
     6198               Puterr(substitute("Error Ошибка при выполнение действия по документу &1. ", vDocumentid )).
     6199               release object vReplyTask.
     6200               return error "Ошибка при выполнение дейстия с документом".
     6201            end.
     6202         end.
     6203      end.
     6204   end.
     6205   procedure SendReceiptsAsync :
     6206   define input  parameter idb-num as integer no-undo.
     6207   define input  parameter idoc-id as integer no-undo.
     6208      define variable vDocument as component-handle no-undo.
     6209      define buffer utd for utd.
     6210      if getdocum (idb-num, idoc-id, output vDocument ) eq ""
     6211      then do:
     6212         PutMes(substitute("Обработка подписи ИОП по документу ДБ &1 ID &2",idb-num,idoc-id)).
     6213         define variable vAsyncResult   as component-handle no-undo.
     6214         vAsyncResult = vDocument:SendReceiptsAsync().
     6215         release object vDocument.
     6216         PutMes(substitute("Запущена асинхронная обработка ИОП по документу ДБ &1 ID &2",idb-num,idoc-id)).
     6217         find first utd where utd.db-num eq idb-num
     6218                          and utd.doc-id eq idoc-id
     6219         exclusive-lock no-error.
     6220         if available utd
     6221         then do:
     6222            if getdocum (idb-num, idoc-id, output vDocument) eq ""
     6223            then do:
     6224                run  UpdateUTDInformOne(vDocument).
     6225               release object vDocument.
     6226            end.
     6227            utd.flagRI = yes.
     6228       end.
     6229         PutMes(vAsyncResult:Result).
     6230         release object vAsyncResult.
     6231         if getdocum (idb-num, idoc-id, output vDocument) eq ""
     6232         then do:
     6233             run  UpdateUTDInformOne(vDocument).
     6234            release object vDocument.
     6235         end.
     6236      end.
     6237   end.
     6238   procedure SendAnsver:
     6239      define input  parameter idb-num as integer no-undo.
     6240      define input  parameter idoc-id as integer no-undo.
     6241      define input  parameter iTypeAnswer as character no-undo.
     6242      define input  parameter iComment as character no-undo.
     6243      define variable vSendcode as character no-undo.
     6244      define variable vDocument as component-handle no-undo.
     6245      define buffer utd for utd.
     6246      if getdocum (idb-num, idoc-id, output vDocument ) eq ""
     6247      then do:
     6248         PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2",idb-num,idoc-id,iTypeAnswer)).
     6249          run   SendReceiptsAsync(idb-num,idoc-id).
     6250            find first utd where utd.db-num eq idb-num
     6251                                   and utd.doc-id eq idoc-id
     6252                  no-lock.
     6253         if      (not utd.AmendmentRequested
     6254             and  iTypeAnswer eq "CorrectionRequest")
     6255             or iTypeAnswer ne "CorrectionRequest"
     6256         then do:
     6257             run   send in this-procedure (vDocument,iTypeAnswer,iComment,output vSendcode) no-error.
     6258            if error-status:error
     6259            then do:
     6260               release object vDocument.
     6261               return error return-value.
     6262            end.
     6263            PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2 Завершина",idb-num,idoc-id,iTypeAnswer)).
     6264         end.
     6265         else
     6266            PutMes(substitute("Обработка запроса &3 по документу ДБ &1 ID &2 пропущена",idb-num,idoc-id,iTypeAnswer)).
     6267         release object vDocument.
     6268         if     vSendcode ne ?
     6269            and vSendcode ne ""
     6270         then
     6271            setattrutd (idb-num,idoc-id,"sendcode",vSendcode).
     6272         if not mFlaftest
     6273         then do:
     6274            if getdocum (idb-num, idoc-id, output vDocument) eq ""
     6275            then do:
     6276                run   UpdateUTDInformOne(vDocument).
     6277               release object vDocument.
     6278            end.
     6279            if    iTypeAnswer eq "CorrectionRequest"
     6280               or iTypeAnswer eq "AcceptRevocation"
     6281               or iTypeAnswer eq "RejectRevocation"
     6282               or iTypeAnswer eq "RejectDocument"
     6283               or iTypeAnswer eq "AcceptDocument"
     6284               or iTypeAnswer eq "AcceptDocumentWithDisc"
     6285               or iTypeAnswer eq "AcceptDocumentNotAccepted"
     6286            then do:
     6287               if getdocum (idb-num, idoc-id, output vDocument) eq ""
     6288               then do:
     6289                   run  UpdateUTDInformOne(vDocument).
     6290                  release object vDocument.
     6291               end.
     6292               if   not mFlaftest
     6293               then do trans:
     6294                  find first utd where utd.db-num eq idb-num
     6295                                   and utd.doc-id eq idoc-id
     6296                                   and utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     6297                  exclusive-lock no-error.
     6298                  if available utd
     6299                  then do :
     6300                     case iTypeAnswer:
     6301                        when   "AcceptDocument"               then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     6302                        when   "RejectDocument"               then utd.sts-edi = if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB
     6303                                                                                 then ObjSrv:Env:Utd:Sts:edi:sendAutoRejected:KeyIntDB
     6304                                                                                 else ObjSrv:Env:Utd:Sts:edi:sendRejected:KeyIntDB.
     6305                        when   "CorrectionRequest"            then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendAdjustment:KeyIntDB.
     6306                        when   "AcceptRevocation"             then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRevocation:KeyIntDB.
     6307                        when   "RejectRevocation"             then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRevocation:KeyIntDB.
     6308                        when   "AcceptDocumentWithDisc"       then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     6309                        when   "AcceptDocumentNotAccepted"    then utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:sendRecipient:KeyIntDB.
     6310                     end case.
     6311                     if iTypeAnswer eq "CorrectionRequest"
     6312                     then do:
     6313                        utd.sts = ObjSrv:Env:Utd:Sts:th:CorrectionRequested:KeyIntDB.
     6314                        if     utd.sts-edi < ObjSrv:Env:Utd:Sts:edi:StatFinesh
     6315                        then do:
     6316                            run   SendAnsver(idb-num,idoc-id,"AcceptDocumentWithDisc",iComment).
     6317                        end.
     6318                     end.
     6319                  end.
     6320               end.
     6321            end.
     6322         end.
     6323      end.
     6324   end.
     6325   procedure  SendResponse :
     6326      define input  parameter idb-num as integer no-undo.
     6327      define input  parameter idoc-id as integer no-undo.
     6328      define input  parameter iAccept as logical no-undo.
     6329      define input  parameter itestMod as logical no-undo.
     6330       define buffer utd for utd.
     6331       define buffer buf_utd for utd.
     6332       itestMod = not itestMod.
     6333       define variable vreturn as logical no-undo.
     6334       find first utd where utd.db-num eq idb-num
     6335                        and utd.doc-id eq idoc-id
     6336       no-lock no-error.
     6337       if available utd
     6338       then do:
     6339          if utd.EDocType              = objSrv:Env:Utd:EDocType:EDoc:KeyIntDB
     6340          then do:
     6341             if     iAccept
     6342                and utd.sts-edi     ne objSrv:Env:Utd:sts:edi:WithRecipientSignature:KeyIntDB
     6343                and utd.sts-edi     ne objSrv:Env:Utd:sts:edi:WithRecipientPartiallySignature:KeyIntDB
     6344             then do:
     6345                vreturn = yes.
     6346                if itestMod
     6347                then do:
     6348                   for each buf_utd where buf_utd.PackageId eq utd.PackageId
     6349                                      and buf_utd.EDocType  eq objSrv:Env:Utd:EDocType:ucd:KeyIntDB
     6350                                      and buf_utd.Timestamp <= utd.Timestamp
     6351                                      and (     buf_utd.sts-edi   eq objSrv:Env:Utd:sts:edi:WaitingForRecipientSignature:KeyIntDB
     6352                                            or  buf_utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     6353                                            or  buf_utd.sts-edi   eq ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB)
     6354                   no-lock :
     6355                       run  SendAnsver in this-procedure (buf_utd.db-num,buf_utd.doc-id,"AcceptDocument","")no-error.
     6356                      if error-status:error then return error return-value.
     6357                   end.
     6358                end.
     6359             end.
     6360          end.
     6361          else if utd.EDocType              = objSrv:Env:Utd:EDocType:returns:KeyIntDB
     6362          then do:
     6363             if iAccept
     6364             then do:
     6365                vreturn = yes.
     6366                if itestMod
     6367                then do:
     6368                   define variable vsend as logical no-undo.
     6369                   vsend = logical(getattrutdex (idb-num,idoc-id,"returnSend","no")).
     6370                   if vsend
     6371                   then
     6372                      return error "Документ был отправлен рание. Повторная отправка возможна через сервис.".
     6373                   find first buf_utd where buf_utd.OrganizationExt eq utd.parentOrganizationExt
     6374                                        and buf_utd.DocumentExt     eq utd.parentDocumentExt
     6375                   no-lock no-error.
     6376                   if available buf_utd
     6377                   then do:
     6378                      if getattrutd (idb-num,idoc-id,"TypeUTD") ne "счфДОП"
     6379                      then do:
     6380                          run  SendAnsver in this-procedure (buf_utd.db-num,buf_utd.doc-id,"CorrectionRequest",GetErrForUtd(utd.db-num,utd.doc-id,"return"))no-error.
     6381                         if error-status:error then return error return-value.
     6382                      end.
     6383                   end.
     6384                   run bge/sendutd.p(
     6385                        parparentproc,
     6386                        mDiadocConnection:Certificate:Thumbprint,
     6387                        idb-num,
     6388                        idoc-id) no-error.
     6389                   if error-status:error then return error return-value.
     6390                   do trans :
     6391                      find first utd where utd.db-num eq idb-num
     6392                                       and utd.doc-id eq idoc-id
     6393                      exclusive-lock no-error.
     6394                      utd.sts-edi = ObjSrv:Env:Utd:Sts:edi:WithRecipientSignature:KeyIntDB.
     6395                      setattrutd (idb-num,idoc-id,"returnSend","yes").
     6396                   end.
     6397                end.
     6398             end.
     6399          end.
     6400          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:HaveToCreateReceipt:KeyIntDB
     6401          then do:
     6402             if iAccept
     6403             then do:
     6404                vreturn = yes.
     6405                if itestMod
     6406                then
     6407                    run  SendReceiptsAsync(idb-num,idoc-id).
     6408             end.
     6409          end.
     6410          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:Verification:KeyIntDB
     6411          then do:
     6412             if not iAccept
     6413             then do:
     6414                vreturn = yes.
     6415                if itestMod
     6416                then do:
     6417                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     6418                   if error-status:error then return error return-value.
     6419                end.
     6420             end.
     6421          end.
     6422          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:RequestsMyRevocation:KeyIntDB
     6423          then do:
     6424             vreturn = yes.
     6425             if iAccept
     6426             then do:
     6427                if itestMod
     6428                then do:
     6429                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptRevocation","") no-error.
     6430                   if error-status:error then return error return-value.
     6431                end.
     6432             end.
     6433             else do:
     6434                if itestMod
     6435                then do:
     6436                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectRevocation","")no-error.
     6437                   if error-status:error then return error return-value.
     6438                end.
     6439             end.
     6440          end.
     6441          else if   utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:Changed:KeyIntDB
     6442                 or utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:WaitingForRecipientSignature:KeyIntDB
     6443          then do:
     6444             vreturn = yes.
     6445             if iAccept
     6446             then do:
     6447                if itestMod
     6448                then do:
     6449                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptDocument","")no-error.
     6450                   if error-status:error then return error return-value.
     6451                end.
     6452             end.
     6453             else do:
     6454                if itestMod
     6455                then do:
     6456                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     6457                   if error-status:error then return error return-value.
     6458                end.
     6459             end.
     6460          end.
     6461          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:AutoRejected:KeyIntDB
     6462          then do:
     6463             if iAccept
     6464             then do:
     6465                vreturn = yes.
     6466                if itestMod
     6467                then do:
     6468                    run  SendAnsver in this-procedure (idb-num,idoc-id,"RejectDocument","") no-error.
     6469                   if error-status:error then return error return-value.
     6470                end.
     6471             end.
     6472          end.
     6473          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:SignatureAdjustment:KeyIntDB
     6474          then do:
     6475             if iAccept
     6476             then do:
     6477                vreturn = yes.
     6478                if itestMod
     6479                then do:
     6480                    run  SendAnsver in this-procedure (idb-num,idoc-id,"CorrectionRequest","")no-error.
     6481                   if error-status:error then return error return-value.
     6482                end.
     6483             end.
     6484          end.
     6485          else if utd.sts-edi eq  ObjSrv:Env:Utd:Sts:edi:SignatureNotAccepted:KeyIntDB
     6486          then do:
     6487             if iAccept
     6488             then do:
     6489                vreturn = yes.
     6490                if itestMod
     6491                then do:
     6492                    run  SendAnsver in this-procedure (idb-num,idoc-id,"AcceptDocumentNotAccepted","")no-error.
     6493                   if error-status:error then return error return-value.
     6494                end.
     6495             end.
     6496          end.
     6497          if itestmod and not vreturn
     6498          then do:
     6499             PutMes (substitute('Error Документ с № "&5" в.н. "&2" по БД "&1" в статусе "&3" выполнить операцию "&4" не возможно.',
     6500                                utd.db-num,
     6501                                utd.doc-id,
     6502                                ObjSrv:Env:Utd:Sts:EDI:GetLabel(utd.sts-edi),
     6503                                if iAccept then "Подписать" else "Отказать",
     6504                                utd.DocumentNumber)
     6505                                ).
     6506          end.
     6507       end.
     6508       return string(vreturn).
     6509   end.
     6510   define temp-table tt-pack no-undo
     6511             field orgid as char
     6512             field docid as char
     6513             field packid as char
     6514             field stamp as datetime
     6515             index pi packid   stamp   orgid  docid
     6516             .
     6517   function CheckLoad returns logical
     6518   (iDocument as component-handle,
     6519    output ohost-code as integer ,
     6520    output oObj-type  as character  ,
     6521    output oObj-code  as integer ):
     6522      define variable vFlag as logical no-undo.
     6523      define variable vDocumentChild as component-handle no-undo.
     6524      define variable vContent as component-handle no-undo.
     6525      define variable vConsignees as component-handle no-undo.
     6526      define variable vfilename as character no-undo.
     6527      oObj-type  = ?.
     6528      oObj-code  = ?.
     6529      ohost-code = ?.
     6530      define buffer ext-classif   for ext-classif.
     6531      define buffer clients       for clients.
     6532      define buffer buf_clients   for clients.
     6533      define buffer clients-attr  for clients-attr.
     6534      if   iDocument:type eq "UniversalTransferDocument"
     6535        or iDocument:type eq "UniversalTransferDocumentRevision"
     6536      then main-block :
     6537      do on error undo main-block, return error:
     6538         getdesc(iDocument).
     6539         vfilename = iDocument:filename.
     6540         if iDocument:Direction eq "Inbound"
     6541         then do:
     6542            define variable vOrganizationGuid as character no-undo.
     6543            define variable vDocumentid as character no-undo.
     6544            vOrganizationGuid = iDocument:OrganizationGuid.
     6545            vDocumentid     = iDocument:DocumentId.
     6546            find first utd where utd.DocumentExt     = vDocumentid
     6547                             and utd.OrganizationExt = vOrganizationGuid
     6548            no-lock no-error .
     6549            if available utd
     6550            then do:
     6551               assign
     6552                  Oobj-type = utd.obj-type
     6553                  Oobj-code = utd.obj-code
     6554                  ohost-code = utd.host-code.
     6555               .
     6556            end.
     6557            vDocumentChild = iDocument:GetDynamicContent("Seller") no-error.
     6558            getdesc(vDocumentChild).
     6559            if    (Oobj-code  ne 0 and Oobj-code  ne ?
     6560               and ohost-code ne 0 and ohost-code ne ?)
     6561            then vFlag = no.
     6562            if    (Oobj-code  ne 0 and Oobj-code  ne ?
     6563               and (ohost-code eq 0 and ohost-code eq ?))
     6564            then do:
     6565                find first clients  where clients.obj-type   = Oobj-type
     6566                                      and clients.obj-code   = Oobj-code
     6567                no-lock no-error .
     6568                if available clients
     6569                then
     6570                   ohost-code =  clients.host-code.
     6571                vFlag = no.
     6572            end.
     6573            else if vDocumentChild ne ?
     6574            then do:
     6575               if iDocument:version  eq "utd820_05_01_01"
     6576               then do:
     6577                  vContent = vDocumentChild:UniversalTransferDocument no-error.
     6578               end.
     6579               else
     6580                  vContent = vDocumentChild:UniversalTransferDocumentWithHyphens no-error.
     6581               release object vDocumentChild.
     6582               if vContent ne ?
     6583               then do:
     6584                  getdesc(vContent).
     6585                  define variable vFnsParticipantId as character no-undo.
     6586                  define variable vinn as character no-undo.
     6587                  define variable vkpp as character no-undo.
     6588                  define variable vorgname as character no-undo.
     6589                  define variable vAddrOrg as character no-undo.
     6590                  define variable vAdditionalInfo as character no-undo.
     6591                  if iDocument:version  eq "utd820_05_01_01"
     6592                  then do:
     6593                     getdesc(vContent:Sellers).
     6594                     getdesc(vContent:Sellers:Seller).
     6595                     getdesc(vContent:Sellers:Seller:GetItem(0)).
     6596                     getdesc(vContent:Sellers:Seller:GetItem(0):OrganizationDetails).
     6597                     getOrganizationInfo(vContent:Sellers:Seller:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     6598                  end.
     6599                  else do:
     6600                     vFnsParticipantId =  vContent:SenderFnsParticipantId.
     6601                  end.
     6602                  find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     6603                                           and ext-classif.charkey_three eq vFnsParticipantId
     6604                  no-lock no-error.
     6605                  if available ext-classif
     6606                  then do:
     6607                     find first clients
     6608                       where clients.obj-type   = ext-classif.CharKey_One
     6609                         and clients.obj-code   = ext-classif.Key#_One
     6610                         and not can-find(first ub.sysconf where ub.sysconf.host-code = clients.obj-code)
     6611                     no-lock no-error .
     6612                     if not available clients
     6613                     then do:
     6614                        PutMes(substitute("По &1 отправитель &2 наша фирма." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     6615                        return no.
     6616                     end.
     6617                  end.
     6618                  else do:
     6619                     PutMes(substitute("По &1 не найден отправитель  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     6620                     return no.
     6621                  end.
     6622                  if iDocument:version  eq "utd820_05_01_01"
     6623                  then do:
     6624                     getdesc(vContent:Buyers).
     6625                     getdesc(vContent:Buyers:Buyer).
     6626                     getdesc(vContent:Buyers:Buyer:GetItem(0)).
     6627                     getOrganizationInfo(vContent:Buyers:Buyer:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo,output vAddrOrg).
     6628                  end.
     6629                  else do:
     6630                     vConsignees = vContent:Consignees.
     6631                     getdesc(vConsignees).
     6632                     getdesc(vConsignees:Consignee).
     6633                     if vConsignees:Consignee:count > 0
     6634                     then do:
     6635                        getdesc(vConsignees:Consignee:GetItem(0)).
     6636                        getOrganizationInfo(vConsignees:Consignee:GetItem(0),output vinn,output vkpp,vFnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     6637                     end.
     6638                     release object vConsignees.
     6639                     vFnsParticipantId = vContent:RecipientFnsParticipantId.
     6640                  end.
     6641                  release object vContent.
     6642                  define variable otext as character no-undo.
     6643                  vFlag = getObgFns
     6644                             (input iDocument:DocumentNumber ,
     6645                              input vFnsParticipantId ,
     6646                              input vkpp,
     6647                              output ohost-code,
     6648                              output oobj-type,
     6649                              output oobj-code,
     6650                              output otext ).
     6651                  if otext ne "" and otext ne ?
     6652                  then
     6653                     PutMes( otext).
     6654                  if vFlag  eq no
     6655                  then
     6656                     return vFlag .
     6657               end.
     6658               else do:
     6659                  PutMes("Error Ошибка получения данных из Диадок UniversalTransferDocument" + if iDocument:version  eq "utd820_05_01_01" then "" else "WithHyphens").
     6660                  return no.
     6661               end.
     6662            end.
     6663            else do:
     6664               PutErr(substitute ("Error Ошибка получения данных из Диадок Seller по документу с типом &1",iDocument:type)).
     6665               return no.
     6666            end.
     6667         end.
     6668         else
     6669            return yes.
     6670         if ohost-code eq ? or ohost-code eq 0
     6671         then do:
     6672            PutMes(substitute("По &1 не удалось определить фирму по получателю  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     6673            return no.
     6674         end.
     6675      end.
     6676      else do:
     6677         define variable vdb-num as integer no-undo.
     6678         define variable vdoc-id as integer no-undo.
     6679         define variable vpack as character no-undo init ?.
     6680         define variable vcli-type as character no-undo.
     6681         define variable vcli-code as integer no-undo.
     6682         define variable vfns as character no-undo.
     6683         define variable vchar as character no-undo.
     6684         vDocumentChild = iDocument:GetDynamicContent("Seller")no-error.
     6685         if vDocumentChild eq ?
     6686         then do:
     6687            PutErr(substitute ("Error Ошибка получения данных из Диадок Seller по документу с типом &1",iDocument:type)).
     6688            return no.
     6689         end.
     6690         vContent = vDocumentChild:UniversalCorrectionDocument no-error.
     6691         if vContent ne ?
     6692         then do:
     6693            getOrganizationInfo(vContent:Seller,output vchar,output vchar,vFns, output vchar,  output vchar, output vchar).
     6694            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     6695                                     and ext-classif.charkey_three eq vFns
     6696            no-lock no-error.
     6697            if available ext-classif
     6698            then do:
     6699               assign
     6700                  vcli-type = ext-classif.CharKey_One
     6701                  vcli-code = ext-classif.Key#_One
     6702               .
     6703               vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalInvoiceNumber,date(iDocument:OriginalInvoiceDate)).
     6704               GetprevUTDForPac(vpack,iDocument:Timestamp,output vdb-num,output vdoc-id ).
     6705               release object vContent.
     6706            end.
     6707            else do:
     6708                     PutMes(substitute("По &1 не найден отправитель  &2." ,iDocument:DocumentNumber, vFnsParticipantId) ).
     6709                     return no.
     6710                  end.
     6711         end.
     6712         else do:
     6713            PutErr("Error Ошибка получения данных из Диадок Seller").
     6714            return no.
     6715         end.
     6716         release object vDocumentChild.
     6717         define buffer     utd for utd.
     6718         find first utd where utd.db-num eq vdb-num
     6719                          and utd.doc-id eq vdoc-id
     6720         no-lock no-error.
     6721         if available utd
     6722         then do:
     6723            assign
     6724               oobj-type  = utd.obj-type
     6725               oobj-code  = utd.obj-code
     6726               ohost-code = utd.host-code
     6727               vfilename  = getattrutd (utd.db-num,utd.doc-id,"FileName")
     6728            .
     6729         end.
     6730         else do:
     6731            PutMes(substitute("Не найден оригенальный документ по пакету &1.",vpack)).
     6732            return no.
     6733         end.
     6734      end.
     6735      if  yes
     6736      then do:
     6737         define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     6738         EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(oobj-type, oobj-code).
     6739         if     not EDOParSec:IsEdo
     6740            and vfilename begins "ON_NSCHFDOPPRMARK_"
     6741         then do:
     6742            PutMes(substitute("На объекте &1&2 не установлен параметр работы с ЭДО для маркированного товара.",oobj-type,oobj-code)).
     6743            vFlag = no.
     6744         end.
     6745         else if     not EDOParSec:IsEdoNotmark
     6746                 and not vfilename begins "ON_NSCHFDOPPRMARK_"
     6747         then do:
     6748            PutMes(substitute("На объекте &1&2 не установлен параметр работы с ЭДО для не маркированного товара.",oobj-type,oobj-code)).
     6749            vFlag = no.
     6750         end.
     6751         else
     6752            vFlag = yes.
     6753      end.
     6754      return vFlag.
     6755   end.
     6756   procedure  UpdateUTDInformOne :
     6757      define input  parameter iDocument as component-handle no-undo.
     6758      define variable vOrganizationGuid as character no-undo.
     6759      define variable vDocumentId as character no-undo.
     6760      define variable vi as integer no-undo.
     6761      define variable vii as integer no-undo.
     6762      define variable viii as integer no-undo.
     6763      define variable vtext as longchar no-undo.
     6764      define buffer utd           for ub.utd.
     6765      define buffer old_utd           for ub.utd.
     6766      define buffer utd-lines      for ub.utd-lines.
     6767      define buffer marking       for ub.marking.
     6768      define buffer marking-lines for ub.marking-lines.
     6769      define buffer utd-marking-lines for ub.utd-marking-lines.
     6770      define buffer buf_utd-marking-lines for ub.utd-marking-lines.
     6771      define variable vDocumentChild               as component-handle no-undo.
     6772      define variable vContent                     as component-handle no-undo.
     6773      define variable vValues                      as component-handle no-undo.
     6774      define variable vSellers                     as component-handle no-undo.
     6775      define variable vConsignees                  as component-handle no-undo.
     6776      define variable vInvoiceTable                as component-handle no-undo.
     6777      define variable vItems                       as component-handle no-undo.
     6778      define variable vExtendedInvoiceItem         as component-handle no-undo.
     6779      define variable vItemIdentificationNumber    as component-handle no-undo.
