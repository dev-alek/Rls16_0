     7032                                             "",
     7033                                             iDocument:type).
     7034                           end.
     7035                           vunit = vItemIdentificationNumber:Unit.
     7036                           do viii = 1 to vunit:count:
     7037                              vValue = vunit:GETITEM(viii - 1).
     7038                              VValue = repTegforDm(VValue).
     7039                              addMarkforUtd (utd-lines.db-num ,
     7040                                             utd-lines.doc-id,
     7041                                             utd-lines.Linenum,
     7042                                             VValue,
     7043                                             "",
     7044                                             iDocument:type).
     7045                           end.
     7046                           release object  vunit.
     7047                           getdesc(vItemIdentificationNumber:PackageId).
     7048                           vunit = vItemIdentificationNumber:PackageId.
     7049                           do viii = 1 to vunit:count:
     7050                              VValue = vunit:GETITEM(viii - 1).
     7051                              VValue = repTegforDm(VValue).
     7052                              addMarkforUtd (utd-lines.db-num ,
     7053                                             utd-lines.doc-id,
     7054                                             utd-lines.Linenum,
     7055                                             VValue,
     7056                                             "",
     7057                                             iDocument:type).
     7058                           end.
     7059                           release object  vunit.
     7060                           release object vItemIdentificationNumber.
     7061                        end.
     7062                        vunits = vExtendedInvoiceItem:AdditionalInfos:AdditionalInfo.
     7063                        do vii = 1 to vunits:count:
     7064                           vunit = vunits:GETITEM(vii - 1).
     7065                           getdesc(vunit).
     7066                           if     vunit:Id eq "штрихкод"
     7067                               or vunit:Id eq "ean"
     7068                           then do:
     7069                              setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,vunit:Id,vunit:value).
     7070                              setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode",vunit:value).
     7071                              find first utd-marking-lines where       utd-marking-lines.db-num     = utd-lines.db-num
     7072                                                             and utd-marking-lines.doc-id     = utd-lines.doc-id
     7073                                                             and utd-marking-lines.Linenum    = utd-lines.Linenum
     7074                              no-lock no-error.
     7075                              if not available utd-marking-lines
     7076                              then do:
     7077                                 vtext = vunit:Value.
     7078                                 do viii = 1 to num-entries(vtext," "):
     7079                                    VValue = entry(viii,vtext," ").
     7080                                    addMarkforUtd (utd-lines.db-num ,
     7081                                             utd-lines.doc-id,
     7082                                             utd-lines.Linenum,
     7083                                             VValue,
     7084                                             "",
     7085                                             iDocument:type).
     7086                                 end.
     7087                              end.
     7088                           end.
     7089                           if vunit:Id eq "Документ о соответствии" then do:
     7090                             define variable v-sert-value as character no-undo .
     7091                             find first utd-lines-attr exclusive-lock where utd-lines-attr.doc-id = utd-lines.doc-id and
     7092                             utd-lines-attr.db-num = utd-lines.db-num and
     7093                             utd-lines-attr.LineNum = utd-lines.LineNum and
     7094                             utd-lines-attr.attr-code = "doc_sertif" no-error .
     7095                             if available (utd-lines-attr) then utd-lines-attr.attr-value = utd-lines-attr.attr-value + "; " + vunit:value .
     7096                             else setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"doc_sertif",vunit:value).
     7097                           end.
     7098                           release object  vunit.
     7099                        end.
     7100                        release object  vunits.
     7101                        release utd-lines.
     7102                        release object vExtendedInvoiceItem.
     7103                     end.
     7104                     release object vItems.
     7105                  end.
     7106                  else do:
     7107                     PutMes("Ошибка получения данных из Диадок UniversalTransferDocumentWithHyphens").
     7108                     release object vDocumentChild.
     7109                     return error "Ошибка получения данных из Диадок UniversalTransferDocumentWithHyphens".
     7110                  end.
     7111               end.
     7112               else do:
     7113                  vContent = vDocumentChild:UniversalCorrectionDocument.
     7114                  if vContent ne ?
     7115                  then do:
     7116                     getdesc(vContent).
     7117                     getdesc(vContent:Seller).
     7118                     getdesc(vContent:EventContent).
     7119                     getdesc(vContent:EventContent:CorrectionBase).
     7120                     getOrganizationInfo(vContent:Seller,output utd.cli-inn,output utd.cli-kpp,utd.cli-FnsParticipantId, output vorgname, output vAdditionalInfo, output vAddrOrg).
     7121                     utd.cli-info = vorgname + " " + vAddrOrg.
     7122                     do:
     7123                         vInvoiceTable = vContent:Table.
     7124                         getdesc(vInvoiceTable).
     7125                         getdesc(vInvoiceTable:TotalsInc).
     7126                         getdesc(vInvoiceTable:TotalsDec).
     7127                         getdesc(vInvoiceTable:Items).
     7128                         getdesc(vInvoiceTable:Items:item).
     7129                         vItems = vInvoiceTable:Items:item.
     7130                         release object vInvoiceTable.
     7131                         do vi = 1 to vItems:Count:
     7132                            vExtendedInvoiceItem = vItems:GetItem(vi - 1).
     7133                            getdesc(vExtendedInvoiceItem).
     7134                            getdesc(vExtendedInvoiceItem:AdditionalInfos ).
     7135                            getdesc(vExtendedInvoiceItem:AdditionalInfos:AdditionalInfo ).
     7136                            find first utd-lines where utd-lines.db-num     = utd.db-num
     7137                                                   and utd-lines.doc-id     = utd.doc-id
     7138                                                   and utd-lines.LineNum    = vi
     7139                            exclusive-lock no-error.
     7140                            if not available  utd-lines
     7141                            then do:
     7142                               create utd-lines.
     7143                               assign
     7144                                  utd-lines.db-num   = utd.db-num
     7145                                  utd-lines.doc-id   = utd.doc-id
     7146                                  utd-lines.Linenum  = vi
     7147                                  utd-lines.gds-code = ?
     7148                               .
     7149                            end.
     7150                            utd-lines.ProductCode = vExtendedInvoiceItem:Product.
     7151                            vValues = vExtendedInvoiceItem:CorrectedValues no-error.
     7152                            if vValues ne ?
     7153                            then do:
     7154                               getdesc(vExtendedInvoiceItem:OriginalValues ).
     7155                               getdesc(vExtendedInvoiceItem:CorrectedValues ).
     7156                               getdesc(vExtendedInvoiceItem:AmountsInc ).
     7157                               getdesc(vExtendedInvoiceItem:AmountsDec ).
     7158                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Unit",string(vValues:unit)).
     7159                               define variable vQuantity as decimal no-undo.
     7160                               vQuantity    = vValues:Quantity.
     7161                               utd-lines.Price       = vValues:Price.
     7162                               utd-lines.TotalWithVatExcluded   = vValues:SubtotalWithVatExcluded.
     7163                               utd-lines.TaxRate   =   if  vValues:TaxRate eq "без ндс" then -1 else decimal(trim(entry(1,vValues:TaxRate,"/"),"%")).
     7164                               utd-lines.Vat       = vValues:Vat.
     7165                               utd-lines.Total     = vValues:Subtotal.
     7166                               release object vValues.
     7167                               vValues = vExtendedInvoiceItem:OriginalValues.
     7168                               vQuantity    = vQuantity - vValues:Quantity.
     7169                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(vQuantity)).
     7170                               utd-lines.Price       = utd-lines.Price - vValues:Price.
     7171                               utd-lines.Vat       = utd-lines.Vat - vValues:Vat.
     7172                               utd-lines.Total     = utd-lines.Total  - vValues:Subtotal.
     7173                               utd-lines.TotalWithVatExcluded   = utd-lines.TotalWithVatExcluded - vValues:SubtotalWithVatExcluded.
     7174                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old",string( vValues:Quantity)).
     7175                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Price_old"   ,string( vValues:Price)).
     7176                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"TotalWithVatExcluded", string( vValues:SubtotalWithVatExcluded)).
     7177                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"TaxRate_old", string(  if  vValues:TaxRate eq "без ндс" then -1 else decimal(trim(entry(1,vValues:TaxRate,"/"),"%")))).
     7178                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Vat_old"    , string( vValues:Vat)).
     7179                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Total_old",       string( vValues:Subtotal)).
     7180                               release object vValues.
     7181                               vunits = vExtendedInvoiceItem:AdditionalInfos:AdditionalInfo.
     7182                               do vii = 1 to vunits:count:
     7183                                  vunit = vunits:GETITEM(vii - 1).
     7184                                  getdesc(vunit).
     7185                                  if     vunit:Id eq "cis"
     7186                                     or vunit:Id eq "cis_до"
     7187                                     or vunit:Id eq "sscc"
     7188                                     or vunit:Id eq "sscc_до"
     7189                                  then do:
     7190                                     vtext = vunit:Value.
     7191                                     if vtext ne "-"
     7192                                     then do viii = 1 to num-entries(vtext," "):
     7193                                        VValue = entry(viii,vtext," ").
     7194                                        vsite = if     vunit:Id eq "cis" or vunit:Id eq "sscc" then "+" else "-".
     7195                                        addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, vsite,iDocument:type).
     7196                                     end.
     7197                                  end.
     7198                                  release object vunit.
     7199                               end.
     7200                               do vii = 1 to vunits:count:
     7201                                  vunit = vunits:GETITEM(vii - 1).
     7202                                  getdesc(vunit).
     7203                                  if     vunit:Id eq "штрихкод"
     7204                                      or vunit:Id eq "ean"
     7205                                  then do:
     7206                                     setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,vunit:Id,vunit:value).
     7207                                     setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode",vunit:value).
     7208                                     find first utd-marking-lines where       utd-marking-lines.db-num     = utd-lines.db-num
     7209                                                                    and utd-marking-lines.doc-id     = utd-lines.doc-id
     7210                                                                    and utd-marking-lines.Linenum    = utd-lines.Linenum
     7211                                     no-lock no-error.
     7212                                     if not available utd-marking-lines
     7213                                     then do:
     7214                                       vtext = vunit:Value.
     7215                                       do viii = 1 to num-entries(vtext," "):
     7216                                          VValue = entry(viii,vtext," ").
     7217                                          addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, "",iDocument:type).
     7218                                       end.
     7219                                    end.
     7220                                 end.
     7221                                 release object  vunit.
     7222                              end.
     7223                               release object vunits.
     7224                               release utd-lines.
     7225                               release utd-marking-lines.
     7226                            end.
     7227                            else do:
     7228                               getdesc(vExtendedInvoiceItem:OriginalItemIdentificationNumbers ).
     7229                               getdesc(vExtendedInvoiceItem:OriginalItemIdentificationNumbers:ItemIdentificationNumber).
     7230                               vunits = vExtendedInvoiceItem:OriginalItemIdentificationNumbers:ItemIdentificationNumber.
     7231                               getdesc(vunits).
     7232                               vsite =  "-".
     7233                               do vii = 1 to vunits:count:
     7234                                  getdesc(vunits:GETITEM(vii - 1)).
     7235                                  vunit = vunits:GETITEM(vii - 1):unit.
     7236                                  getdesc(vunit).
     7237                                  do viii = 1 to vunit:count:
     7238                                     vvalue = vunit:GETITEM(viii - 1).
     7239                                     addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, vsite,iDocument:type).
     7240                                  end.
     7241                                  release object vunit.
     7242                                  vunit = vunits:GETITEM(vii - 1):PackageId.
     7243                                  getdesc(vunit).
     7244                                  do viii = 1 to vunit:count:
     7245                                     vvalue = vunit:GETITEM(viii - 1).
     7246                                     addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, vsite,iDocument:type).
     7247                                  end.
     7248                                  release object vunit.
     7249                               end.
     7250                               release object vunits.
     7251                               getdesc(vExtendedInvoiceItem:CorrectedItemIdentificationNumbers).
     7252                               vunits = vExtendedInvoiceItem:CorrectedItemIdentificationNumbers:ItemIdentificationNumber.
     7253                               getdesc(vunits).
     7254                               vsite =  "+".
     7255                               do vii = 1 to vunits:count:
     7256                                  getdesc(vunits:GETITEM(vii - 1)).
     7257                                  vunit = vunits:GETITEM(vii - 1):unit.
     7258                                  getdesc(vunit).
     7259                                  do viii = 1 to vunit:count:
     7260                                     vvalue = vunit:GETITEM(viii - 1).
     7261                                     addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, vsite,iDocument:type).
     7262                                  end.
     7263                                  release object vunit.
     7264                                  vunit = vunits:GETITEM(vii - 1):PackageId.
     7265                                  getdesc(vunit).
     7266                                  do viii = 1 to vunit:count:
     7267                                     vvalue = vunit:GETITEM(viii - 1).
     7268                                     addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, vsite,iDocument:type).
     7269                                  end.
     7270                                  release object vunit.
     7271                               end.
     7272                               release object vunits.
     7273                               getdesc(vExtendedInvoiceItem:TaxRate ).
     7274                               getdesc(vExtendedInvoiceItem:UnitName ).
     7275                               getdesc(vExtendedInvoiceItem:Unit ).
     7276                               getdesc(vExtendedInvoiceItem:Quantity ).
     7277                               getdesc(vExtendedInvoiceItem:Price ).
     7278                               getdesc(vExtendedInvoiceItem:Excise ).
     7279                               getdesc(vExtendedInvoiceItem:SubtotalWithVatExcluded ).
     7280                               getdesc(vExtendedInvoiceItem:Vat ).
     7281                               getdesc(vExtendedInvoiceItem:WithoutVat).
     7282                               getdesc(vExtendedInvoiceItem:Subtotal ).
     7283                               getdesc(vExtendedInvoiceItem:ItemTracingInfos ).
     7284                               getdesc(vExtendedInvoiceItem:ItemTracingInfos:ItemTracingInfo ).
     7285                               vValues = vExtendedInvoiceItem:CorrectedItemIdentificationNumbers.
     7286                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Unit",string(vExtendedInvoiceItem:Unit:CorrectedValue)).
     7287                               utd-lines.Price       = vExtendedInvoiceItem:Price:CorrectedValue.
     7288                               utd-lines.TotalWithVatExcluded   = vExtendedInvoiceItem:SubtotalWithVatExcluded:CorrectedValue.
     7289                               utd-lines.UnitCode    = vExtendedInvoiceItem:UnitName:CorrectedValue.
     7290                               utd-lines.TaxRate   =   if  vExtendedInvoiceItem:TaxRate:CorrectedValue eq "без ндс" then -1 else decimal(trim(entry(1,vExtendedInvoiceItem:TaxRate:CorrectedValue,"/"),"%")).
     7291                               utd-lines.Vat       = vExtendedInvoiceItem:Vat:CorrectedValue.
     7292                               utd-lines.Total     = vExtendedInvoiceItem:Subtotal:CorrectedValue.
     7293                               vQuantity    = dec(vExtendedInvoiceItem:Quantity:CorrectedValue) - dec(vExtendedInvoiceItem:Quantity:OriginalValue).
     7294                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity",string(vQuantity)).
     7295                               utd-lines.Price       = utd-lines.Price - vExtendedInvoiceItem:Price:OriginalValue.
     7296                               utd-lines.Vat       = utd-lines.Vat - vExtendedInvoiceItem:Vat:OriginalValue.
     7297                               utd-lines.Total     = utd-lines.Total  - vExtendedInvoiceItem:Subtotal:OriginalValue.
     7298                               utd-lines.TotalWithVatExcluded   = utd-lines.TotalWithVatExcluded - vExtendedInvoiceItem:SubtotalWithVatExcluded:OriginalValue.
     7299                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Quantity_old",string( vExtendedInvoiceItem:Quantity:OriginalValue)).
     7300                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Price_old"   ,string( vExtendedInvoiceItem:Price:OriginalValue)).
     7301                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"TotalWithVatExcluded", string( vExtendedInvoiceItem:SubtotalWithVatExcluded:OriginalValue)).
     7302                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"TaxRate_old", string(  if  vExtendedInvoiceItem:TaxRate:OriginalValue eq "без ндс" then -1 else decimal(trim(entry(1,vExtendedInvoiceItem:TaxRate:OriginalValue,"/"),"%")))).
     7303                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Vat_old"    , string( vExtendedInvoiceItem:Vat:OriginalValue)).
     7304                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"Total_old",       string( vExtendedInvoiceItem:Subtotal:OriginalValue)).
     7305                               setAttrUtdLines(utd-lines.db-num,utd-lines.doc-id,utd-lines.Linenum,"UnitCode_old", vExtendedInvoiceItem:UnitName:OriginalValue).
     7306                            end.
     7307                            vunits = vExtendedInvoiceItem:AdditionalInfos:AdditionalInfo.
     7308                            getdesc(vunits).
     7309                            do vii = 1 to vunits:count:
     7310                               vunit = vunits:GETITEM(vii - 1).
     7311                               getdesc(vunit).
     7312                               if     vunit:Id eq "штрихкод"
     7313                                   or vunit:Id eq "ean"
     7314                               then do:
     7315                                  setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,vunit:Id,vunit:value).
     7316                                  setattrutdlines(utd-lines.db-num,utd-lines.doc-id,utd-lines.LineNum,"BarCode",vunit:value).
     7317                                  find first utd-marking-lines where       utd-marking-lines.db-num     = utd-lines.db-num
     7318                                                                 and utd-marking-lines.doc-id     = utd-lines.doc-id
     7319                                                                 and utd-marking-lines.Linenum    = utd-lines.Linenum
     7320                                  no-lock no-error.
     7321                                  if not available utd-marking-lines
     7322                                  then do:
     7323                                    vtext = vunit:Value.
     7324                                    do viii = 1 to num-entries(vtext," "):
     7325                                       VValue = entry(viii,vtext," ").
     7326                                       addMarkforUtd (utd-lines.db-num, utd-lines.doc-id, utd-lines.LineNum, VValue, "",iDocument:type).
     7327                                    end.
     7328                                 end.
     7329                              end.
     7330                              release object  vunit.
     7331                           end.
     7332                           release object  vunits.
     7333                            release object vExtendedInvoiceItem.
     7334                         end.
     7335                         release object vItems.
     7336                     end.
     7337                     release object vContent.
     7338                  end.
     7339                  else do:
     7340                     create tt-recid.
     7341                     assign
     7342                        tt-recid.orgid = vOrganizationGuid
     7343                        tt-recid.docid = vDocumentid
     7344                     .
     7345                     PutMes("Error Ошибка получения данных из Диадок UniversalCorrectionDocument").
     7346                     release object vDocumentChild.
     7347                     return error "Ошибка получения данных из Диадок UniversalCorrectionDocument".
     7348                  end.
     7349               end.
     7350            end.
     7351            release object vDocumentChild.
     7352            define variable vsetPAck as logical no-undo.
     7353            define variable vcli-type as character no-undo.
     7354            define variable vcli-code as integer no-undo.
     7355            find first ext-classif where ext-classif.classif-name  eq 'id_diadok_client':U
     7356                                     and ext-classif.charkey_three eq utd.cli-FnsParticipantId
     7357            no-lock no-error.
     7358            if available ext-classif
     7359            then do:
     7360               assign
     7361                  vcli-type = ext-classif.CharKey_One
     7362                  vcli-code = ext-classif.Key#_One
     7363               .
     7364               define variable vPack as character no-undo.
     7365               if   iDocument:type eq "UniversalTransferDocument"
     7366               then
     7367                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,utd.DocumentNumber,utd.DocumentDate).
     7368               else if iDocument:type eq "UniversalTransferDocumentRevision"
     7369               then
     7370                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalDocumentNumber,date(iDocument:OriginalDocumentDate)).
     7371               else
     7372                  vPack = substitute("&1|&2|&3|&4",vcli-type,vcli-code,iDocument:OriginalInvoiceNumber,date(iDocument:OriginalInvoiceDate)).
     7373               if vPack ne utd.PackageId
     7374               then
     7375                  assign
     7376                     vsetPAck      = yes
     7377                     utd.PackageId = vPack
     7378                  .
     7379            end.
     7380            if vNewUtd or vsetPAck then do:
     7381               if utd.EDocType eq objSrv:Env:Utd:EDocType:UTD:KeyIntDB
     7382               then do:
     7383                  if vNewUtd  then do:
     7384                     GetLastUTDinPackbef(utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     7385                     find first old_utd where old_utd.db-num eq volddb-num
     7386                                          and old_utd.doc-id eq volddoc-id
     7387                        no-lock no-error.
     7388                     for each utd-marking-lines where utd-marking-lines.db-num eq utd.db-num
     7389                                                  and utd-marking-lines.doc-id eq utd.doc-id
     7390                     exclusive-lock:
     7391                        if available old_utd
     7392                           and utd.db-num ne volddb-num
     7393                           and utd.doc-id ne volddoc-id
     7394                        then
     7395                           find first buf_utd-marking-lines where buf_utd-marking-lines.mark       = utd-marking-lines.mark
     7396                                                              and buf_utd-marking-lines.db-num     = old_utd.db-num
     7397                                                              and buf_utd-marking-lines.doc-id     = old_utd.doc-id
     7398                           no-lock no-error.
     7399                        utd-marking-lines.sts = if available buf_utd-marking-lines then buf_utd-marking-lines.sts else  objSrv:Env:marking:Sts:Mark:PendingVerification:KeyIntDB.
     7400                     end.
     7401                     validate utd.
     7402                     ReCheckload( utd.db-num, utd.doc-id,yes).
     7403                     subscribe "getNextseq" anywhere run-procedure "MySeqForUtd".
     7404                  end.
     7405               end.
     7406               else do:
     7407                  GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     7408                  find first old_utd where old_utd.db-num eq volddb-num
     7409                                       and old_utd.doc-id eq volddoc-id
     7410                  no-lock no-error.
     7411                  if not available old_utd
     7412                     or (   utd.db-num eq volddb-num
     7413                        and utd.doc-id eq volddoc-id)
     7414                  then
     7415                     AddUtdErr(utd.db-num,utd.doc-id,buffer utd:handle,"loadUtd","NoAvailDoc",string(utd.PackageId) + chr(4) + string(utd.db-num) + chr(4) + string(utd.doc-id)).
     7416                  else do:
     7417                      assign
     7418                          utd.obj-inn               = old_utd.obj-inn
     7419                          utd.obj-kpp               = old_utd.obj-kpp
     7420                          utd.obj-FnsParticipantId  = old_utd.obj-FnsParticipantId
     7421                          utd.obj-info              = old_utd.obj-info
     7422                          utd.parentDocumentExt     = old_utd.DocumentExt
     7423                          utd.parentOrganizationExt = old_utd.OrganizationExt
     7424                          utd.contract-code         = old_utd.contract-code
     7425                      .
     7426                  end.
     7427                  validate utd.
     7428                  SaturateAndCheckUTD( utd.db-num, utd.doc-id).
     7429               end.
     7430            end.
     7431            GetLastUTDinPack (utd.db-num,utd.doc-id,volddb-num,volddoc-id).
     7432            find first old_utd where old_utd.db-num eq volddb-num
     7433                                 and old_utd.doc-id eq volddoc-id
     7434            no-lock no-error.
     7435            if available old_utd
     7436            then
     7437               assign
     7438                  utd.parentDocumentExt     = old_utd.DocumentExt
     7439                  utd.parentOrganizationExt = old_utd.OrganizationExt
     7440               .
     7441            create tt-recid.
     7442            assign
     7443               tt-recid.orgid = vOrganizationGuid
     7444               tt-recid.docid = vDocumentid
     7445            .
     7446            if utd.EDocType = objSrv:Env:Utd:EDocType:UCD:KeyIntDB
     7447            then do:
     7448               tt-recid.parent = utd.PackageId.
     7449               tt-recid.stamp  = utd.Timestamp.
     7450            end.
     7451            release utd no-error.
     7452            if error-status:error
     7453            then
     7454               PutMes(substitute("Документ &1 от &2 не загружен. &3" ,iDocument:DocumentNumber,iDocument:DocumentDate,return-value) ).
     7455            else
     7456               PutMes(substitute("Документ &1 от &2 загружен." ,iDocument:DocumentNumber,iDocument:DocumentDate) ).
     7457            unsubscribe "getNextseq".
     7458         end.
     7459      end.
     7460   end.
     7461   function packetupdd returns date
     7462   (iOrganization as component-handle, iDocument as component-handle):
     7463      define variable VPack as character no-undo.
     7464      define variable vorgid as character no-undo.
     7465      define variable vdocid as character no-undo.
     7466      define variable vstamp as datetime no-undo.
     7467      define variable VPack2 as character no-undo.
     7468      define variable vorgid2 as character no-undo.
     7469      define variable vdocid2 as character no-undo.
     7470      define variable vstamp2 as datetime no-undo.
     7471      define variable VPackage as component-handle no-undo.
     7472      define variable vi as integer no-undo.
     7473      define variable vDocument as component-handle no-undo.
     7474      define variable vDocuments as component-handle no-undo.
     7475         VPack = iDocument:PackageId.
     7476         vorgid = iDocument:OrganizationGuid.
     7477         vdocid = iDocument:DocumentId.
     7478         vstamp = iDocument:Timestamp.
     7479         find first tt-pack where tt-pack.packid eq VPack
     7480                              and tt-pack.stamp  eq vstamp
     7481                              and tt-pack.orgid  eq vorgid
     7482                              and tt-pack.docid  eq vdocid
     7483         no-lock no-error.
     7484         if not available tt-pack
     7485         then do:
     7486            create tt-pack.
     7487            assign
     7488               tt-pack.packid = VPack
     7489               tt-pack.stamp  = vstamp
     7490               tt-pack.orgid  = vorgid
     7491               tt-pack.docid  = vdocid
     7492            .
     7493         end.
     7494         getdesc(iDocument ).
     7495         getdesc(iDocument:InitialDocumentIds ).
     7496         vDocuments = iDocument:InitialDocumentIds.
     7497         do vi= 1 to vDocuments:Count:
     7498            vDocument = iOrganization:GetDocumentById(vDocuments:GetItem(vi - 1),false).
     7499            getdesc(vDocument ).
     7500            vorgid2 = vDocument:OrganizationGuid.
     7501            vdocid2 = vDocument:DocumentId.
     7502            vstamp2 = vDocument:Timestamp.
     7503            find first tt-pack where tt-pack.packid eq VPack
     7504                                 and tt-pack.stamp  eq vstamp2
     7505                                 and tt-pack.orgid  eq vorgid2
     7506                                 and tt-pack.docid  eq vdocid2
     7507            no-lock no-error.
     7508            if not available tt-pack
     7509            then do:
     7510               create tt-pack.
     7511               assign
     7512                  tt-pack.packid = VPack
     7513                  tt-pack.stamp  = vstamp2
     7514                  tt-pack.orgid  = vorgid2
     7515                  tt-pack.docid  = vdocid2
     7516               .
     7517            end.
     7518            release object vDocument.
     7519         end.
     7520         release object vDocuments.
     7521   end.
     7522   procedure UpdateUTDInform:
     7523      define input  parameter ibeg-date as date no-undo.
     7524      define input  parameter iend-date as date no-undo.
     7525      define output parameter odatelast as date no-undo.
     7526      define variable vOrganizationList as component-handle no-undo.
     7527      define variable vOrganization as component-handle no-undo.
     7528      define variable vDocumentsTask as component-handle no-undo.
     7529      define variable vDocumentList  as component-handle no-undo.
     7530      define variable vDocumentchildList  as component-handle no-undo.
     7531      define variable vDocument       as component-handle no-undo.
     7532      define buffer ext-classif_obj for ext-classif.
     7533      define buffer ext-classif_Cli  for ext-classif.
     7534      define variable vi  as integer no-undo.
     7535      define variable vii as integer no-undo.
     7536      odatelast = ibeg-date.
     7537      vOrganizationList = mDiadocConnection:GetOrganizationList() no-error.
     7538      if vOrganizationList eq ? then return error ?.
     7539      vi = vOrganizationList:Count()no-error.
     7540      if vi eq ?
     7541      then
     7542         return error ?.
     7543      for each tt-recid:
     7544         delete tt-recid.
     7545      end.
     7546      for each tt-pack:
     7547         delete tt-pack.
     7548      end.
     7549      do vi = 1 to vOrganizationList:Count() :
     7550         vOrganization = vOrganizationList:GetItem(vi - 1 ).
     7551         getdesc(vOrganization).
     7552         run changeIdtoGuid(vOrganization).
     7553         vDocumentsTask = vOrganization:GetDocumentsTask().
     7554                     vDocumentsTask:FromSendDate = ibeg-date  .
     7555                     vDocumentsTask:ToSendDate   = iend-date.
     7556                     for each tt-type, each tt-Class:
     7557                         vDocumentsTask:Category     = tt-type.id + "." + tt-Class.id.
     7558                        PutMes(substitute("Формируем список зависимых документов за период с &2 по &3  &1Категория: &4 &5",
     7559                                          chr(10),
     7560                                          ibeg-date ,
     7561                                          iend-date,
     7562                                          if tt-type .id eq "Any" then "" else tt-type.name,
     7563                                          tt-Class.name)).
     7564                         vDocumentList = vDocumentsTask:GetDocuments() no-error.
     7565                         if vDocumentList ne ?
     7566                         then do:
     7567                           do vii= 1 to vDocumentList:Count:
     7568                              if chekStop() then return ?.
     7569                              vDocument = vDocumentList:GetItem(vii - 1).
     7570                              odatelast = max(odatelast,vDocument:DocumentDate) no-error.
     7571                              odatelast = min(odatelast,today).
     7572                              packetupdd(vOrganization, vDocument).
     7573                              release object vDocument.
     7574                            end.
     7575                            release object vDocumentList.
     7576                         end.
     7577                      end.
     7578                      define variable VAlldoc    as integer no-undo.
     7579                      define variable vprocessed as integer no-undo.
     7580                      for each tt-pack :
     7581                         VAlldoc = VAlldoc + 1.
     7582                      end.
     7583                      for each tt-pack :
     7584                          if chekStop() then return ?.
     7585                         if GetDocumforid (tt-pack.orgid, tt-pack.docid, output vDocument) eq ""
     7586                         then do:
     7587                             run  UpdateUTDInformOne(vDocument).
     7588                            release object vDocument.
     7589                        end.
     7590                        vprocessed = vprocessed + 1.
     7591                        PutStat (substitute ("Обработано документов &1 из &2",vprocessed,vAllDoc),yes).
     7592                     end.
     7593         release object vOrganization.
     7594         release object vDocumentsTask.
     7595      end.
     7596      release object vOrganizationList.
     7597   end.
     7598   procedure updOneUTD:
     7599      define input  parameter idb-num as integer no-undo.
     7600      define input  parameter idoc-id as integer no-undo.
     7601      define variable vDocument as component-handle no-undo.
     7602      define buffer utd for utd.
     7603      for each tt-recid:
     7604         delete tt-recid.
     7605      end.
     7606      if getdocum (idb-num, idoc-id, output vDocument) eq ""
     7607      then do:
     7608          run  UpdateUTDInformOne(vDocument).
     7609         release object vDocument.
     7610      end.
     7611   end.
     7612   function CRnewDocum return character
     7613   (
     7614   iOrgGuid as character,
     7615   iContGuid as character,
     7616   iTypeUTD as character,
     7617    iFile as character
     7618    ):
     7619   define variable vOrganization as component-handle no-undo.
     7620   define variable vSendTask as component-handle no-undo.
     7621       vOrganization = mDiadocConnection:GetOrganizationById(iOrgGuid ) no-error.
     7622       if vOrganization ne ?
     7623       then do:
     7624          vSendTask = vOrganization:CreatePackageSendTask2().
     7625          getdesc(vSendTask).
     7626          vSendTask:CounteragentId = iContGuid  .
     7627          vSendTask:AddDocumentFromFile("UniversalTransferDocument", iTypeUTD, "utd820_05_01_01", iFile).
     7628          vSendTask:Send()no-error.
     7629          if error-status:num-messages > 0 then do:
     7630             PutErr("ERROR Ошибка отправки документа").
     7631             return error "ERROR Ошибка отправки документа".
     7632          end.
     7633          else do:
     7634             PutMes("Документ отправлен успешно.").
     7635             message "Документ отправлен успешно."
     7636             view-as alert-box.
     7637          end.
     7638          release object vSendTask.
     7639         release object vOrganization .
     7640      end.
     7641   end.
     7642   procedure MySeqForUtd:
     7643      define input  parameter iTable       as character no-undo.
     7644      define input  parameter iseqnamehist as character no-undo.
     7645      define input  parameter idb-name     as character no-undo.
     7646      define output parameter Oseq         as int64 no-undo.
     7647      if iTable begins "utd"
     7648      then do:
     7649         if myseqUtd eq ?
     7650         then
     7651            myseqUtd = dynamic-next-value(iseqnamehist,idb-name).
     7652         Oseq = myseqUtd.
     7653      end.
     7654      else
     7655         Oseq = ?.
     7656      return.
     7657   end.
     7658   define variable mTypeUtd as character no-undo.
     7659   mTypeUtd = getattrutd (idb-num,idoc-id,"TypeUTD").
     7660   if mTypeUtd eq ?
     7661   then
     7662      return.
     7663   ConectByCertif(iThump).
     7664   define variable vfile as character no-undo.
     7665   define buffer buf_utd for utd.
     7666   if mDiadocConnection eq ?
     7667   then do:
     7668      message "Нет подключения к Диадоку."
     7669      view-as alert-box.
     7670      return error  "Нет подключения к Диадоку.".
     7671   end.
     7672   else do:
     7673      find first buf_utd no-lock where buf_utd.db-num eq idb-num and buf_utd.doc-id = idoc-id no-error .
     7674      run bge\utdxml.p(parparentproc,
     7675                       mDiadocConnection,
     7676                       buf_utd.OrganizationExt,
     7677                       buf_utd.CounteragentId,
     7678                       mTypeUtd,
     7679                       idb-num,
     7680                       idoc-id) no-error.
     7681      if error-status:error
     7682      then
     7683         return.
     7684      vfile = searchfile("UPD_" + string (idb-num) + "_" + string (idoc-id) + ".xml").
     7685      CRnewDocum(buf_utd.OrganizationExt,
     7686                 buf_utd.CounteragentId,
     7687                 mTypeUtd,
     7688                 vfile)no-error.
     7689      if error-status:error
     7690      then do:
     7691         release object mDiadocApi no-error.
     7692         release object mDiadocConnection no-error.
     7693         return error  return-value.
     7694      end.
     7695   end.
     7696   release object mDiadocApi no-error.
     7697   release object mDiadocConnection no-error.
