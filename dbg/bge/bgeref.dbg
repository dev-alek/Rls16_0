       88   define stream stmXMLLog.
       89   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   procedure cur-time :
       91      define output parameter p-today as date      no-undo .
       92      define output parameter p-time  as integer   no-undo .
       93     do
       94     on error undo, return error
       95     :
       96       define variable v-date1 as date      no-undo .
       97       define variable v-date2 as date      no-undo .
       98       define variable v-time  as integer   no-undo .
       99       assign
      100         v-date1 = today
      101         v-time  = time
      102         v-date2 = today
      103       .
      104       if v-date1 <> v-date2
      105       then do:
      106         assign
      107           v-date1 = today
      108           v-time  = v-time
      109         .
      110       end.
      111       assign
      112         p-today = v-date1
      113         p-time  = v-time
      114       .
      115     end.
      116   end.
      117   function cur-time-date returns character
      118   :
      119     return string(today, '99/99/9999':U) .
      120   end.
      121   function cur-time-mjd returns decimal
      122   :
      123     define variable v-date as date      no-undo .
      124     define variable v-time as integer   no-undo .
      125     run cur-time in this-procedure
      126       (output v-date
      127       ,output v-time
      128       ) .
      129     return integer(v-date) - 2400002 + (v-time / 86400) .
      130   end.
      131   function cur-time-get-ending-index returns integer
      132   (input p-number as integer
      133   )
      134   :
      135     if p-number < 0
      136     or p-number = ?
      137     then do:
      138       return 1 .
      139     end.
      140     define variable v-rest as integer   no-undo .
      141     assign
      142       p-number = p-number modulo 100
      143     .
      144     if p-number < 20
      145     then do:
      146       assign
      147         v-rest = p-number
      148       .
      149     end.
      150     else do:
      151       assign
      152         v-rest = p-number modulo 10
      153       .
      154     end.
      155     case v-rest :
      156       when 1
      157       then do:
      158         return 2 .
      159       end.
      160       when 2 or
      161       when 3 or
      162       when 4
      163       then do:
      164         return 3 .
      165       end.
      166       otherwise do:
      167         return 1 .
      168       end.
      169     end case .
      170   end.
      171   procedure cur-time-mjd-to-date :
      172      define input  parameter i-mjd-diff as decimal no-undo.
      173      define output parameter o-Date     as date    no-undo.
      174      define output parameter o-Time     as integer no-undo.
      175      define variable v-day-number as integer   no-undo .
      176      if    i-mjd-diff < 0
      177         or i-mjd-diff = ?
      178      then do:
      179         return "?" .
      180      end.
      181      assign
      182         v-day-number = truncate(i-mjd-diff,0).
      183         o-Date = date(v-day-number + 2400002).
      184         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      185     .
      186   end.
      187   function cur-time-mjd-to-string returns character
      188   (input p-mjd-diff as decimal
      189   )
      190   :
      191     define variable v-day-number as integer   no-undo .
      192     define variable v-seconds    as integer   no-undo .
      193     define variable v-hour       as integer   no-undo .
      194     define variable v-min        as integer   no-undo .
      195     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      196     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      197     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      198     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      199     if p-mjd-diff < 0
      200     or p-mjd-diff = ?
      201     then do:
      202       return "?" .
      203     end.
      204     assign
      205       v-day-number = integer(truncate(p-mjd-diff,0))
      206       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      207     .
      208     if v-seconds > 86400
      209     then do:
      210       assign
      211         v-seconds = 86400 - 1
      212       .
      213     end.
      214     if v-seconds < 0
      215     then do:
      216       assign
      217         v-seconds = 0
      218       .
      219     end.
      220     assign
      221       v-hour = truncate(v-seconds / 3600, 0)
      222     .
      223     assign
      224       v-seconds = v-seconds modulo 3600
      225     .
      226     assign
      227       v-min = truncate(v-seconds / 60, 0)
      228     .
      229     assign
      230       v-seconds = v-seconds modulo 60
      231     .
      232     return
      233         (if v-day-number <> 0
      234           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      235           else ""
      236         )
      237       + (if v-day-number <> 0 or v-hour <> 0
      238           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      239           else ""
      240         )
      241       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      242           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      243           else ""
      244         )
      245       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      246       .
      247   end.
      248   function cur-time-string returns character
      249   :
      250     define variable v-date as date      no-undo .
      251     define variable v-time as integer   no-undo .
      252     run cur-time in this-procedure
      253       (output v-date
      254       ,output v-time
      255       ) .
      256     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      257   end.
      258   function cur-time-string-sec returns character
      259   :
      260     define variable v-date as date      no-undo .
      261     define variable v-time as integer   no-undo .
      262     run cur-time in this-procedure
      263       (output v-date
      264       ,output v-time
      265       ) .
      266     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      267   end.
      268   function cur-time-custom  returns character
      269   (input p-prefix as character
      270   ,input p-date-format as character
      271   ,input p-delimiter as character
      272   ,input p-time-format as character
      273   ,input p-suffix as character
      274   )
      275   :
      276     define variable v-date as date      no-undo .
      277     define variable v-time as integer   no-undo .
      278     run cur-time in this-procedure
      279       (output v-date
      280       ,output v-time
      281       ) .
      282     return
      283       p-prefix
      284       + string(v-date, p-date-format)
      285       + p-delimiter
      286       + string(v-time, p-time-format)
      287       + p-suffix
      288       .
      289   end.
      290   function cur-time-print  returns character
      291   :
      292     define variable v-date as date      no-undo .
      293     define variable v-time as integer   no-undo .
      294     run cur-time in this-procedure
      295       (output v-date
      296       ,output v-time
      297       ) .
      298     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      299   end.
      300   function cur-time-datetime returns datetime
      301   :
      302     define variable v-char as character no-undo .
      303     define variable v-datetime as datetime no-undo .
      304     v-char = cur-time-string().
      305     v-datetime = datetime(v-char).
      306     return  v-datetime.
      307   end.
      308   function cur-time-string-msec returns character
      309   :
      310     define variable v-date as datetime  no-undo .
      311     v-date = now.
      312     return string(v-date) .
      313   end.
      314   define variable vss-include-info2 as character format "X(65)" no-undo
      315   initial "@(#)$Workfile$ $Revision$".
      316   procedure xmlchar-test :
      317   define input parameter p-in-string          as character        no-undo.
      318   define output parameter p-out-string-enc    as character        no-undo.
      319   define output parameter p-out-string-dec    as character        no-undo.
      320   do
      321   on error undo, return error
      322   :
      323          run xmlchar-encode in this-procedure
      324       (
      325             input p-in-string
      326           , output p-out-string-enc
      327       ).
      328          run xmlchar-decode in this-procedure
      329       (
      330             input p-out-string-enc
      331           , output p-out-string-dec
      332       ).
      333   end.
      334   end .
      335   procedure xmlchar-encode :
      336   define input parameter p-in-string      as character        no-undo.
      337   define output parameter p-out-string    as character        no-undo.
      338       define variable v-position      as integer      no-undo.
      339       define variable v-current-char  as character    no-undo.
      340   do
      341   on error undo, return error
      342   :
      343       assign
      344           p-out-string = "":U
      345       .
      346       case p-in-string
      347       :
      348           when ?
      349           then do:
      350               assign
      351                   p-out-string = "?":U
      352               .
      353           end.
      354           when "?":U
      355           then do:
      356               assign
      357                   p-out-string = "&#63;":U
      358               .
      359           end.
      360           otherwise do:
      361               do v-position = 1 to length( p-in-string )
      362               :
      363                   assign
      364                       v-current-char = substring( p-in-string, v-position, 1 )
      365                   .
      366                   case v-current-char
      367                   :
      368                       when "&":U
      369                       then do:
      370                           assign
      371                               p-out-string = p-out-string + "&amp;":U
      372                           .
      373                       end.
      374                       when ">":U
      375                       then do:
      376                           assign
      377                               p-out-string = p-out-string + "&gt;":U
      378                           .
      379                       end.
      380                       when "<":U
      381                       then do:
      382                           assign
      383                               p-out-string = p-out-string + "&lt;":U
      384                           .
      385                       end.
      386                       when "'":U
      387                       then do:
      388                           assign
      389                               p-out-string = p-out-string + "&apos;":U
      390                           .
      391                       end.
      392                       when '"':U
      393                       then do:
      394                           assign
      395                               p-out-string = p-out-string + "&quot;":U
      396                           .
      397                       end.
      398                       when chr(1)
      399                       then do:
      400                           assign
      401                               p-out-string = p-out-string + "":U
      402                           .
      403                       end.
      404                       when chr(2)
      405                       then do:
      406                           assign
      407                               p-out-string = p-out-string + "":U
      408                           .
      409                       end.
      410                       when chr(3)
      411                       then do:
      412                           assign
      413                               p-out-string = p-out-string + "":U
      414                           .
      415                       end.
      416                       when chr(4)
      417                       then do:
      418                           assign
      419                               p-out-string = p-out-string + "":U
      420                           .
      421                       end.
      422                       when chr(5)
      423                       then do:
      424                           assign
      425                               p-out-string = p-out-string + "":U
      426                           .
      427                       end.
      428                       when chr(6)
      429                       then do:
      430                           assign
      431                               p-out-string = p-out-string + "":U
      432                           .
      433                       end.
      434                       when chr(7)
      435                       then do:
      436                           assign
      437                               p-out-string = p-out-string + "":U
      438                           .
      439                       end.
      440                       when chr(8)
      441                       then do:
      442                           assign
      443                               p-out-string = p-out-string + "":U
      444                           .
      445                       end.
      446                       when chr(9)
      447                       then do:
      448                           assign
      449                               p-out-string = p-out-string + "":U
      450                           .
      451                       end.
      452                       when chr(29)
      453                       then do:
      454                           assign
      455                               p-out-string = p-out-string + "":U
      456                           .
      457                       end.
      458                       when chr(10)
      459                       then do:
      460                           assign
      461                               p-out-string = p-out-string + "&#10;":U
      462                           .
      463                       end.
      464                       when chr(13)
      465                       then do:
      466                           assign
      467                               p-out-string = p-out-string + "&#13;":U
      468                           .
      469                       end.
      470                       otherwise do:
      471                           assign
      472                               p-out-string = p-out-string + v-current-char
      473                           .
      474                       end.
      475                   end case.
      476               end.
      477           end.
      478       end case.
      479   end.
      480   end .
      481   procedure xmlchar-encode-1c :
