      591   procedure xmlchar-decode :
      592   define input parameter p-in-string      as character        no-undo.
      593   define output parameter p-out-string    as character        no-undo.
      594       define variable v-position      as integer      no-undo.
      595       define variable v-last-position as integer      no-undo.
      596       define variable v-temp-integer  as integer      no-undo.
      597       define variable v-current-char  as character    no-undo.
      598       define variable v-next-char     as character    no-undo.
      599       define variable v-success       as logical      no-undo.
      600   do
      601   on error undo, return error
      602   :
      603       assign
      604           p-out-string = "":U
      605           v-position   = 0
      606       .
      607       replace-cycle:
      608       do while yes
      609       on error undo, return error
      610       :
      611           assign
      612               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      613           .
      614           if v-last-position <= v-position
      615           then do:
      616               if v-position = 0
      617               then do:
      618                   assign
      619                       p-out-string = p-in-string
      620                   .
      621               end.
      622               else do:
      623                   assign
      624                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      625                   .
      626               end.
      627               leave replace-cycle.
      628           end.
      629           else do:
      630               assign
      631                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      632                   v-position      = v-last-position
      633                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      634               .
      635               if v-current-char = "#":U
      636               then do:
      637                   assign
      638                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      639                   .
      640                   if v-last-position > 0
      641                   then do:
      642                       run xmlchar-read-integer in this-procedure
      643                        (
      644                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      645                           , output v-temp-integer
      646                           , output v-success
      647                       ).
      648                       if v-success = yes
      649                       and v-temp-integer >= 1
      650                       and v-temp-integer <= 255
      651                       then do:
      652                           assign
      653                               p-out-string = p-out-string + chr( v-temp-integer )
      654                               v-position   = v-last-position + 1
      655                           .
      656                       end.
      657                       else do:
      658                           assign
      659                               p-out-string = p-out-string + "&":U
      660                               v-position   = v-position   + 1
      661                           .
      662                       end.
      663                   end.
      664                   else do:
      665                       assign
      666                           p-out-string = p-out-string + "&":U
      667                           v-position   = v-position   + 1
      668                       .
      669                   end.
      670               end.
      671               else do:
      672                   case substring( p-in-string, v-position + 1, 3 )
      673                   :
      674                       when "lt;":U
      675                       then do:
      676                           assign
      677                               p-out-string = p-out-string + "<":U
      678                               v-position   = v-position   + 3
      679                           .
      680                       end.
      681                       when "gt;":U
      682                       then do:
      683                           assign
      684                               p-out-string = p-out-string + ">":U
      685                               v-position   = v-position   + 3
      686                           .
      687                       end.
      688                       otherwise do:
      689                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      690                           then do:
      691                               assign
      692                                   p-out-string = p-out-string + "&":U
      693                                   v-position   = v-position   + 4
      694                               .
      695                           end.
      696                           else do:
      697                               case substring( p-in-string, v-position + 1, 5 )
      698                               :
      699                                   when "quot;":U
      700                                   then do:
      701                                       assign
      702                                           p-out-string = p-out-string + '"':U
      703                                           v-position   = v-position   + 5
      704                                       .
      705                                   end.
      706                                   when "apos;":U
      707                                   then do:
      708                                       assign
      709                                           p-out-string = p-out-string + "'":U
      710                                           v-position   = v-position   + 5
      711                                       .
      712                                   end.
      713                                   otherwise do:
      714                                       assign
      715                                           p-out-string = p-out-string + "&":U
      716                                       .
      717                                   end.
      718                               end case.
      719                           end.
      720                       end.
      721                   end case.
      722               end.
      723           end.
      724       end.
      725   end.
      726   end .
      727   procedure xmlchar-read-integer :
      728   define input parameter p-input-string      as character        no-undo.
      729   define output parameter p-output-integer   as integer          no-undo.
      730   define output parameter p-success       as logical          no-undo.
      731   do
      732   on error undo, return error
      733   :
      734       assign
      735           p-output-integer = integer( p-input-string )
      736       no-error.
      737       if error-status :error
      738       then do:
      739           assign
      740               p-success           = no
      741               p-output-integer    = 0
      742           .
      743       end.
      744       else do:
      745           assign
      746               p-success           = yes
      747           .
      748       end.
      749   end.
      750   end.
      751   define variable v-bgelib-bgeclall           as logical      no-undo.
      752   define variable v-bgelib-bgedict            as logical      no-undo.
      753   define temp-table temp_ext-doc-type no-undo
      754       field edt-key               as integer
      755       field ext-doc-type          as character
      756       field ext-doc-type-label    as character
      757       index pi is primary unique
      758           edt-key
      759   .
      760   define temp-table temp_bgelib_goods no-undo
      761       field gds-code as integer
      762       index pi is primary unique
      763           gds-code
      764   .
      765   define temp-table temp_bgelib_clients no-undo
      766       field obj-type as character
      767       field obj-code as integer
      768       index pi is primary unique
      769           obj-type
      770           obj-code
      771   .
      772   define temp-table temp_bgelib_dis-card no-undo
      773       field d-card as character
      774       index pi is primary unique
      775           d-card
      776   .
      777   define temp-table temp_bgelib_trn-doc no-undo
      778       field doc-code as integer
      779   .
      780   procedure bgelib-tag-open:
      781   do
      782   on error undo, return error
      783   :
      784   define input parameter v-tag-level  as integer      no-undo.
      785   define input parameter v-tag-name   as character    no-undo.
      786   define input parameter v-tag-value  as character    no-undo.
      787       put stream stmXMLOut unformatted
      788           chr(10)
      789           + fill(" ", 4 * v-tag-level)
      790           + "<" + v-tag-name
      791           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      792           + v-tag-value + ">"
      793       .
      794   end.
      795   end procedure.
      796   procedure bgelib-tag-put:
      797   do
      798   on error undo, return error
      799   :
      800   define input parameter v-tag-level      as integer      no-undo.
      801   define input parameter v-tag-name       as character    no-undo.
      802   define input parameter v-tag-value      as character    no-undo.
      803   define input parameter v-empty-mode     as integer      no-undo.
      804       v-tag-name = trim(v-tag-name).
      805       if  v-empty-mode = 1
      806       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      807       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      808       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      809       then do:
      810           run xmlchar-encode in this-procedure (
      811                 input v-tag-value
      812               , output v-tag-value
      813           ).
      814           put stream stmXMLOut unformatted
      815               chr(10) + fill(" ", 4 * v-tag-level)
      816                           + '<' + v-tag-name + '>'
      817                           + v-tag-value
      818                           + '</' + v-tag-name + '>'
      819           .
      820       end.
      821   end.
      822   end procedure.
      823   procedure bgelib-tag-close:
      824   do
      825   on error undo, return error
      826   :
      827   define input parameter v-tag-level as integer      no-undo.
      828   define input parameter v-tag-name  as character    no-undo.
      829       put stream stmXMLOut unformatted
      830           chr(10)
      831           + fill( " ", 4 * v-tag-level)
      832           + '</' + v-tag-name + '>'
      833       .
      834   end.
      835   end procedure.
      836   procedure bgelib-write-log:
      837   do
      838   on error undo, return error
      839   :
      840   define input parameter v-filename   as character    no-undo.
      841   define input parameter v-log-level  as integer      no-undo.
      842   define input parameter v-out-string as character    no-undo.
      843       output stream stmXMLLog to value( v-filename ) append.
      844       put stream stmXMLLog unformatted
      845           chr(10)
      846       .
      847       put stream stmXMLLog unformatted
      848           ( if v-log-level = 0
      849             or v-out-string = "&DLine"
      850             or v-out-string = "&Line"
      851             then ""
      852             else cur-time-string-sec() + " " )
      853       .
      854       put stream stmXMLLog unformatted
      855           ( if v-out-string = "&Line"
      856             then fill( "-", 80 )
      857             else if v-out-string = "&DLine"
      858                  then fill( "=", 80 )
      859                  else v-out-string )
      860       .
      861       output stream stmXMLLog close.
      862   end.
      863   end procedure.
      864   procedure bgelib-write-edt:
      865   do
      866   on error undo, return error
      867   :
      868   define input parameter v-editor-handle    as handle       no-undo.
      869   define input parameter v-log-level        as integer      no-undo.
      870   define input parameter v-out-string       as character    no-undo.
      871       if valid-handle ( v-editor-handle )
      872       then do:
      873           v-editor-handle :move-to-eof().
      874           v-editor-handle :insert-string( ( if v-log-level = 0
      875                                             or v-out-string = "&DLine"
      876                                             or v-out-string = "&Line"
      877                                             then ""
      878                                             else cur-time-string-sec() + " "
      879                                         ) ).
      880           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      881                                             then fill( "-", 80 )
      882                                             else if v-out-string = "&DLine" then fill("=", 80)
      883                                             else fill( " ", v-log-level) + v-out-string
      884                                         ) ).
      885           v-editor-handle :insert-string( chr(10) ).
      886       end.
      887       process events.
      888       output to 'bgescn.txt' append.
      889           put unformatted
      890               chr(10)
      891               string( ( if v-log-level = 0
      892                         or v-out-string = "&DLine"
      893                         or v-out-string = "&Line"
      894                         then ""
      895                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      896                     ) )
      897               string( ( if v-out-string = "&Line"
      898                         then fill( "-", 80 )
      899                         else if v-out-string = "&DLine"
      900                              then fill( "=", 80 )
      901                              else fill( " ", v-log-level ) + v-out-string
      902                     ) )
      903           .
      904       output close.
      905   end.
      906   end procedure.
      907   procedure bgelib-show-cnt:
      908   do
      909   on error undo, return error
      910   :
      911   define input parameter v-fillin-handle     as handle   no-undo.
      912       if valid-handle( v-fillin-handle )
      913       then do:
      914           assign
      915               v-fillin-handle :visible = true
      916           .
      917       end.
      918   end.
      919   end procedure.
      920   procedure bgelib-hide-cnt:
      921   do
      922   on error undo, return error
      923   :
      924   define input parameter v-fillin-handle     as handle   no-undo.
      925       if valid-handle( v-fillin-handle )
      926       then do:
      927           assign v-fillin-handle :visible = false.
      928       end.
      929   end.
      930   end procedure.
      931   procedure bgelib-write-cnt:
      932   do
      933   on error undo, return error
      934   :
      935   define input parameter v-fillin-handle    as handle       no-undo.
      936   define input parameter v-fillin-string    as character    no-undo.
      937       if valid-handle( v-fillin-handle )
      938       then do:
      939           assign
      940               v-fillin-handle :SCREEN-value = v-fillin-string
      941           .
      942       end.
      943   end.
      944   end procedure.
      945   procedure bgelib-write-header:
      946   do
      947   on error undo, return error
      948   :
      949   define input parameter p-first-file     as logical      no-undo.
      950   define input parameter p-xml-file-name  as character    no-undo.
      951   define input parameter p-list-file-name as character    no-undo.
      952   define input parameter p-file-number    as integer      no-undo.
      953   define input parameter p-have-prev      as logical      no-undo.
      954   define input parameter p-prev-filename  as character    no-undo.
      955   define input parameter p-obj-list       as character    no-undo.
      956   define input parameter p-doc-type-list  as character    no-undo.
      957   define input parameter p-parameter-list as character    no-undo.
      958       define variable v-counter    as integer        no-undo.
      959       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      960       put stream stmXMLOut unformatted
      961           "<?xml version='1.0' encoding='windows-1251'?>"
      962       .
      963       run bgelib-tag-open( input 0, input "root"  , input "" ).
      964       run bgelib-tag-open( input 0, input "header", input "" ).
      965       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      966       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      967       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      968       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      969       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      970       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      971       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      972       :
      973           run bgelib-tag-put(
      974                 input 1
      975               , input entry( 2 * v-counter, p-parameter-list )
      976               , input entry( 2 * v-counter + 1, p-parameter-list )
      977               , input 0
      978           ).
      979       end.
      980       run bgelib-tag-close( input 0, input "header" ).
      981       output stream stmXMLOut close.
      982       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      983       if p-first-file = yes
      984       then do:
      985           put stream stmXMLOut unformatted
      986               "<?xml version='1.0' encoding='windows-1251'?>"
      987           .
      988           run bgelib-tag-open( input 0, input "export", input "" ).
      989       end.
      990       run bgelib-tag-open( input 1, input "file", input "" ).
      991       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      992       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      993       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      994       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
      995       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
      996       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      997       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      998       :
      999           run bgelib-tag-put(
     1000                 input 2
     1001               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1002               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1003               , input 0
     1004           ).
     1005       end.
     1006       run bgelib-tag-close( input 1, input "file" ).
     1007       output stream stmXMLOut close.
     1008   end.
     1009   end procedure.
     1010   procedure bgelib-write-footer:
     1011   do
     1012   on error undo, return error
     1013   :
     1014   define input parameter p-last-file      as logical      no-undo.
     1015   define input parameter p-xml-file-name  as character    no-undo.
     1016   define input parameter p-list-file-name as character    no-undo.
     1017   define input parameter p-have-next      as logical      no-undo.
     1018   define input parameter p-next-file-name as character    no-undo.
     1019       define variable v-error-num     as integer           no-undo.
     1020       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1021       if p-have-next = yes
     1022       then do:
     1023           run bgelib-tag-open( input 0, input "footer", "" ).
     1024           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1025           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1026           run bgelib-tag-close( input 0, input "footer" ).
     1027       end.
     1028       run bgelib-tag-close( input 0, input "root" ).
     1029       output stream stmXMLOut close.
     1030       run bge/os_copy.p (
     1031             input "M"
     1032           , input p-xml-file-name + "tmp"
     1033           , input p-xml-file-name + "xml"
     1034           , output v-error-num
     1035       ).
     1036       if p-last-file = yes
     1037       then do:
     1038           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1039               run bgelib-tag-close( input 0, input "export" ).
     1040           output stream stmXMLOut close.
     1041           run bge/os_copy.p (
     1042                 input "M"
     1043               , input p-list-file-name + "tmp"
     1044               , input p-list-file-name + "xml"
     1045               , output v-error-num
     1046           ).
     1047       end.
     1048   end.
     1049   end procedure.
     1050   procedure bgelib-filename :
     1051   do
     1052   on error undo, return error
     1053   :
     1054   define input parameter p-prefix             as character    no-undo.
     1055   define output parameter p-xml-file-name     as character    no-undo.
     1056   define output parameter p-log-file-name     as character    no-undo.
     1057   define output parameter p-list-file-name    as character    no-undo.
     1058       define variable v-home-dir  as character    no-undo.
     1059       define variable v-error-num as integer      no-undo.
     1060       get-key-value section "BGE" key "outdir" value v-home-dir.
     1061       if v-home-dir = ?
     1062       then do:
     1063           message
     1064             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1065             skip(1)
     1066             skip "Обратитесь к администратору."
     1067           view-as alert-box error.
     1068           undo, return error .
     1069       end.
     1070       run gbl/dir-cre.p (
     1071           input v-home-dir
     1072       ) no-error.
     1073       if error-status :error
     1074       then do:
     1075           message
     1076             skip "Неверно задан каталог экспорта."
     1077             skip(1)
     1078             skip "Обратитесь к администратору."
     1079           view-as alert-box error.
     1080           undo, return error .
     1081       end.
     1082       run bge/genfname.p (
     1083             input v-home-dir
     1084           , input p-prefix
     1085           , input ""
     1086           , input "xml"
     1087           , input "tmp"
     1088           , output p-xml-file-name
     1089       ).
     1090       assign
     1091           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1092           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1093           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1094       .
     1095   end.
     1096   end procedure.
     1097   procedure bgelib-read-config :
     1098   do
     1099   on error undo, return error
     1100   :
     1101   define variable v-par-type as character     no-undo.
     1102     define variable v-param-type      as character  no-undo .
     1103     define variable v-value-character as character  no-undo .
     1104     define variable v-value-date      as date       no-undo .
     1105     define variable v-value-decimal   as decimal    no-undo .
     1106     define variable v-value-integer   as integer    no-undo .
     1107     define variable v-value-logical   as logical    no-undo .
     1108     define variable v-tth             as handle     no-undo .
     1109       assign
     1110           v-bgelib-bgeclall = no
     1111           v-bgelib-bgedict  = no
     1112       .
     1113       run adm/shattri.p ( input "get":U
     1114                         , input  '':u
     1115                         , input  0
     1116                         , input  'bge-export':U
     1117                         , input  'bgeclall':U
     1118                         , output v-value-character
     1119                         , output v-value-date
     1120                         , output v-value-decimal
     1121                         , output v-value-integer
     1122                         , output v-value-logical
     1123                         , output v-param-type
     1124                         , input-output table-handle v-tth
     1125                         ) no-error .
     1126       if error-status :error
     1127       then do:
     1128         assign
     1129           v-bgelib-bgeclall = no
     1130         .
     1131       end.
     1132       else do:
     1133         assign
     1134           v-bgelib-bgeclall = v-value-logical
     1135         .
     1136       end.
     1137       delete object v-tth.
     1138       run adm/shattri.p ( input "get":U
     1139                         , input  '':u
     1140                         , input  0
     1141                         , input  'bge-export':U
     1142                         , input  'bgedict':U
     1143                         , output v-value-character
     1144                         , output v-value-date
     1145                         , output v-value-decimal
     1146                         , output v-value-integer
     1147                         , output v-value-logical
     1148                         , output v-param-type
     1149                         , input-output table-handle v-tth
     1150                         ) no-error .
     1151       if error-status :error
     1152       then do:
     1153         assign
     1154           v-bgelib-bgedict = no
     1155         .
     1156       end.
     1157       else do:
     1158         assign
     1159           v-bgelib-bgedict = v-value-logical
     1160         .
     1161       end.
     1162       delete object v-tth.
     1163       run adm/shattri.p ( input "get":U
     1164                         , input  '':u
     1165                         , input  0
     1166                         , input  'bge-export':U
     1167                         , input  'bgefmt':U
     1168                         , output v-value-character
     1169                         , output v-value-date
     1170                         , output v-value-decimal
     1171                         , output v-value-integer
     1172                         , output v-value-logical
     1173                         , output v-param-type
     1174                         , input-output table-handle v-tth
     1175                         ) no-error .
     1176       if error-status :error
     1177       then do:
     1178         assign
     1179           v-bgelib-bgefmt  = "xml":U
     1180         .
     1181       end.
     1182       else do:
     1183         assign
     1184           v-bgelib-bgefmt  = v-value-character
     1185         .
     1186       end.
     1187       delete object v-tth.
     1188       run adm/shattri.p ( input "get":U
     1189                         , input  '':u
     1190                         , input  0
     1191                         , input  'bge-export':U
     1192                         , input  'bgeflold':U
     1193                         , output v-value-character
     1194                         , output v-value-date
     1195                         , output v-value-decimal
     1196                         , output v-value-integer
     1197                         , output v-value-logical
     1198                         , output v-param-type
     1199                         , input-output table-handle v-tth
     1200                         ) no-error .
     1201       if error-status :error
     1202       then do:
     1203         assign
     1204           v-bgelib-bgeflold  = "old":U
     1205         .
     1206       end.
     1207       else do:
     1208         assign
     1209           v-bgelib-bgeflold  = v-value-character
     1210         .
     1211       end.
     1212       delete object v-tth.
     1213   end.
     1214   end procedure.
     1215   procedure bgelib-check-file-size :
     1216   do
     1217   on error undo, return error
     1218   :
     1219   define input parameter p-out-filename   as character    no-undo.
     1220   define output parameter p-is-big        as logical      no-undo.
     1221       define variable v-current-position    as integer        no-undo.
     1222       assign
     1223           v-current-position = seek( stmXMLOut )
     1224       .
     1225       if v-current-position / 1024 / 1024  >= 100
     1226       then do:
     1227           assign
     1228               p-is-big = yes
     1229           .
     1230       end.
     1231   end.
     1232   end procedure.
     1233   procedure bgelib-init-ext-doc-type :
     1234       define variable v-counter    as integer      no-undo.
     1235       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1236   do
     1237   for buf_temp_ext-doc-type
     1238   on error undo, return error
     1239   :
     1240       empty temp-table buf_temp_ext-doc-type.
     1241       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1242       :
     1243           create buf_temp_ext-doc-type.
     1244           assign
     1245               buf_temp_ext-doc-type.edt-key               = v-counter
     1246               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1247               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1248           .
     1249       end.
     1250   end.
     1251   end procedure.
     1252   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1253     define variable v-cntxt-db-num        as integer   no-undo .
     1254     define variable v-cntxt-userid        as character no-undo .
     1255     define variable v-cntxt-level         as character no-undo .
     1256     define variable v-cntxt-host-code-obj as integer   no-undo .
     1257     define variable v-cntxt-obj-type      as character no-undo .
     1258     define variable v-cntxt-obj-code      as integer   no-undo .
     1259     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1260     define variable v-cntxt-is-admin      as logical   no-undo .
     1261       define variable v-locked        as logical      no-undo.
     1262       define variable v-counter       as integer      no-undo.
     1263       define variable v-have-rights   as logical      no-undo.
     1264   do
     1265   on error undo, return error
     1266   :
     1267       process events.
     1268       if p-shedule = no
     1269       then do:
     1270   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1271     run mainmenu_getcntxt in parparentproc
     1272       (output v-cntxt-db-num
     1273       ,output v-cntxt-userid
     1274       ,output v-cntxt-level
     1275       ,output v-cntxt-host-code-obj
     1276       ,output v-cntxt-obj-type
     1277       ,output v-cntxt-obj-code
     1278       ,output v-cntxt-db-num-obj
     1279       ,output v-cntxt-is-admin
     1280       ) .
     1281   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1282   do:
     1283     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1284       (input  v-cntxt-db-num
     1285       ,input  v-cntxt-userid
     1286       ,input  0
     1287       ,input  'actn_references_export':U
     1288       ,input  'global':U
     1289       ,input  0
     1290       ,input  '':U
     1291       ,input  0
     1292       ,input  0
     1293       ,input  0
     1294       ,input  0
     1295       ,input  yes
     1296       ,output v-have-rights
     1297       )  .
     1298   end.
     1299           if not v-have-rights
     1300           then do:
     1301               undo, return error.
     1302           end.
     1303       end.
     1304       run bgelib-read-config in this-procedure no-error.
     1305       if error-status :error
     1306       then do:
     1307           message
     1308           vss-workfile vss-revision vss-description
     1309           skip "Ошибка чтения параметров экспорта."
     1310           skip "Для экспорта данных будут приняты параметры по умолчанию."
     1311           skip return-value
     1312           skip trim(error-status :get-message(1))
     1313                trim(error-status :get-message(2))
     1314                trim(error-status :get-message(3))
     1315           view-as alert-box error.
     1316       end.
     1317       run bgelib-write-edt(
     1318             input hEDT
     1319           , input 4
     1320           , input "Экспорт справочника контрагентов..."
     1321       ).
     1322       process events.
     1323       run bge/catfirm.p (
     1324             input p-mode
     1325           , input p-host-code
     1326           , input table temp_bgelib_clients
     1327       ) no-error.
     1328       if error-status :error
     1329       then do:
     1330           run bgelib-write-edt(
     1331                 input hEDT
     1332               , input 4
     1333               , input substitute( "Экспорт справочника контрагентов невозможен. &1"
     1334                                   , ( if return-value = "locked":U
     1335                                     then chr(10) + "Соответствующий выходной файл заблокирован."
     1336                                     else "" )
     1337                                 )
     1338           ).
     1339       end.
     1340       else do:
     1341           run bgelib-write-edt(
     1342                 input hEDT
     1343               , input 4
     1344               , input "Экспорт справочника контрагентов завершен."
     1345           ).
     1346       end.
     1347       run bgelib-write-edt in this-procedure (
     1348             input hEDT
     1349           , input 4
     1350           , input "Экспорт справочника условий хранения..."
     1351       ).
     1352       process events.
     1353       run bge/catconk.p no-error.
     1354       if error-status :error
     1355       then do:
     1356           run bgelib-write-edt in this-procedure (
     1357                 input hEDT
     1358               , input 4
     1359               , input substitute( "Ошибка при экспорте справочника условий хранения. &1. &2. &3."
     1360                                   , return-value
     1361                                   , trim(error-status :get-message(1))
     1362                                   , trim(error-status :get-message(2))
     1363                                 )
     1364           ).
     1365           process events.
     1366       end.
     1367       else do:
     1368           run bgelib-write-edt in this-procedure (
     1369                 input hEDT
     1370               , input 4
     1371               , input "Экспорт справочника условий хранения завершен."
     1372           ).
     1373       end.
     1374       run bgelib-write-edt(
     1375             input hEDT
     1376           , input 4
     1377           , input "Экспорт справочника товаров..."
     1378       ).
     1379       process events.
     1380       run bge/catgood.p (
     1381             input p-mode
     1382           , input table temp_bgelib_goods
     1383       ) no-error.
     1384       if error-status :error
     1385       then do:
     1386           run bgelib-write-edt(
     1387                 input hEDT
     1388               , input 4
     1389               , input substitute( "Экспорт справочника товаров невозможен. &1"
     1390                                   , ( if return-value = "locked"
     1391                                     then chr(10) + "Соответствующий выходной файл заблокирован."
     1392                                     else "" )
     1393                                 )
     1394           ).
     1395           process events.
     1396       end.
     1397       else do:
     1398           run bgelib-write-edt(
     1399                 input hEDT
     1400               , input 4
     1401               , input "Экспорт справочника товаров завершен."
     1402           ).
     1403       end.
     1404       process events.
     1405       run bgelib-write-edt(
     1406             input hEDT
     1407           , input 4
     1408           , input "Экспорт справочника групп товаров..."
     1409       ).
     1410       process events.
     1411       run bge/catgrp.p (
     1412             input 0
     1413           , input ""
     1414       ) no-error.
     1415       if error-status :error
     1416       then do:
     1417           run bgelib-write-edt(
     1418                 input hEDT
     1419               , input 4
     1420               , input substitute( "Экспорт справочника групп товаров невозможен. &1"
     1421                                   , ( if return-value = "locked"
     1422                                     then chr(10) + "Соответствующий выходной файл заблокирован."
     1423                                     else "" )
     1424                                 )
     1425           ).
     1426           process events.
     1427       end.
     1428       else do:
     1429           run bgelib-write-edt(
     1430                 input hEDT
     1431               , input 4
     1432               , input "Экспорт справочника групп товаров завершен."
     1433           ).
     1434       end.
     1435       process events.
     1436       if v-bgelib-bgedict = yes
     1437       then do:
     1438           run bgelib-write-edt(
     1439                 input hEDT
     1440               , input 4
     1441               , input "Экспорт справочника дисконтных карт..."
     1442           ).
     1443           process events.
     1444           run bge/catdcrt.p (
     1445                 input p-mode
     1446               , input table temp_bgelib_dis-card
     1447           ) no-error.
     1448           if error-status :error
     1449           then do:
     1450               run bgelib-write-edt(
     1451                   input hEDT
     1452                   , input 4
     1453                   , input substitute( "Экспорт справочника дисконтных карт невозможен. &1. &2. &3"
     1454                                       , ( if return-value = "locked"
     1455                                       then chr(10) + "Соответствующий выходной файл заблокирован."
     1456                                       else "" )
     1457                                       , trim(error-status :get-message(1))
     1458                                       , trim(error-status :get-message(2))
     1459                                   )
     1460               ).
     1461               process events.
     1462           end.
     1463           else do:
     1464               run bgelib-write-edt(
     1465                   input hEDT
     1466                   , input 4
     1467                   , input "Экспорт справочника дисконтных карт завершен."
     1468               ).
     1469           end.
     1470           process events.
     1471           run bgelib-write-edt(
     1472                 input hEDT
     1473               , input 4
     1474               , input "Экспорт справочника видов оплат..."
     1475           ).
     1476           process events.
     1477           run bge/catpayt.p (
     1478               input 0
     1479               , input 0
     1480               , input ""
     1481           ) no-error.
     1482           if error-status :error
     1483           then do:
     1484               run bgelib-write-edt(
     1485                   input hEDT
     1486                   , input 4
     1487                   , input substitute( "Экспорт справочника видов оплат невозможен. &1"
     1488                                       , ( if return-value = "locked"
     1489                                       then chr(10) + "Соответствующий выходной файл заблокирован."
     1490                                       else "" )
     1491                                   )
     1492               ).
     1493               process events.
     1494           end.
     1495           else do:
     1496               run bgelib-write-edt(
     1497                   input hEDT
     1498                   , input 4
     1499                   , input "Экспорт справочника видов оплат завершен."
     1500               ).
     1501           end.
     1502           process events.
     1503           run bgelib-write-edt(
     1504                 input hEDT
     1505               , input 4
     1506               , input "Экспорт справочника типов кассовых платежей..."
     1507           ).
     1508           process events.
     1509           run bge/catpayc.p (
     1510                 input 0
     1511               , input 0
     1512               , input ""
     1513           ) no-error.
     1514           if error-status :error
     1515           then do:
     1516               run bgelib-write-edt(
     1517                     input hEDT
     1518                   , input 4
     1519                   , input substitute( "Экспорт справочника типов кассовых платежей невозможен. &1"
     1520                                       , ( if return-value = "locked"
     1521                                       then chr(10) + "Соответствующий выходной файл заблокирован."
     1522                                       else "" )
     1523                                   )
     1524               ).
     1525               process events.
     1526           end.
     1527           else do:
     1528               run bgelib-write-edt(
     1529                   input hEDT
     1530                   , input 4
     1531                   , input "Экспорт справочника типов кассовых платежей завершен."
     1532               ).
     1533           end.
     1534           process events.
     1535       end.
     1536   end.
