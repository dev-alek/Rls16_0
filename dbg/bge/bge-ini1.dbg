        1   DEF INPUT  PARAM strB AS CHAR.
        2   DEF OUTPUT PARAM strReturn AS CHAR INIT "CANCEL".
        3   def var vss-revision    as character no-undo init "$Revision$":U .
        4   def var vss-author      as character no-undo init "$Author$":U .
        5   def var vss-date        as character no-undo init "$Date$":U .
        6   def var vss-workfile    as character no-undo init "$Workfile$":U .
        7   def var vss-archive     as character no-undo init "$Archive$":U .
        8   def var vss-description as character no-undo init "Изменить progress.ini - добавить секцию BGE".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   DEFINE BUTTON b-help AUTO-GO
      113        LABEL "Помо&щь"
      114        SIZE 10 BY 1
      115        BGCOLOR 8 .
      116   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      117        LABEL "&Отмена"
      118        SIZE 10 BY 1
      119        BGCOLOR 8 .
      120   DEFINE BUTTON Btn_Next AUTO-GO
      121        LABEL "Дальше"
      122        SIZE 10 BY 1
      123        BGCOLOR 8 .
      124   DEFINE VARIABLE EDITOR-1 AS CHARACTER INITIAL "         Важно!"
      125        VIEW-AS EDITOR SCROLLBAR-VERTICAL NO-BOX
      126        SIZE 37 BY 9 TOOLTIP "Администратору: изменится progress.ini !"
      127        BGCOLOR 15 FGCOLOR 0  NO-UNDO.
      128   DEFINE IMAGE imgName
      129        FILENAME "cmp/advisor.bmp":U
      130        SIZE 21.5 BY 6.96.
      131   DEFINE FRAME Dialog-Frame
      132        Btn_Next AT ROW 1.25 COL 1.5
      133        Btn_Cancel AT ROW 1.25 COL 11.5
      134        b-help AT ROW 1.25 COL 54
      135        EDITOR-1 AT ROW 2.5 COL 27 NO-LABEL
      136        imgName AT ROW 3.75 COL 3.5
      137        SPACE(40.12) SKIP(1.57)
      138       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      139            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      140            TITLE "Установка каталога экспорта для Внешней Бухгалтерии"
      141            DEFAULT-BUTTON Btn_Next CANCEL-BUTTON Btn_Cancel.
      142   ASSIGN
      143          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      144          FRAME Dialog-Frame:HIDDEN           = TRUE.
      145   ASSIGN
      146          EDITOR-1:AUTO-INDENT IN FRAME Dialog-Frame      = TRUE
      147          EDITOR-1:AUTO-RESIZE IN FRAME Dialog-Frame      = TRUE
      148          EDITOR-1:RETURN-INSERTED IN FRAME Dialog-Frame  = TRUE
      149          EDITOR-1:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      150   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      151   DO:
      152     APPLY "END-ERROR":U TO SELF.
      153   END.
      154   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      155   DO:
      156     strReturn = "OK".
      157   END.
      158   ON CHOOSE OF Btn_Next IN FRAME Dialog-Frame
      159   DO:
      160     strReturn = "OK".
      161   END.
      162   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      163   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      164   IF strB = "bge" THEN
      165    ASSIGN
      166    EDITOR-1 = "         Важно!" + chr(10) +
      167    " Экспорт сумм по документам," + chr(10) +
      168    " а также экспорт справочников " + chr(10) +
      169    " будет сводится к записи в файлы." + chr(10) +
      170    " Для них необходимо указать" + chr(10) +
      171    " размещение - каталог." + chr(10) +
      172    " Отметьте, что этот каталог" + chr(10) +
      173    " должен обладать особым" + chr(10) +
      174    " статусом: он должен быть" + chr(10) +
      175    " доступен с других рабочих" + chr(10) +
      176    " станций. Хорошим решением будет" + chr(10) +
      177    " то, которое примет" + chr(10) +
      178    " администратор системы!"
      179    FRAME Dialog-Frame:TITLE = "Установка каталога экспорта для Внешней Бухгалтерии"
      180    .
      181   ELSE
      182    ASSIGN
      183    EDITOR-1 = "         Важно!" + chr(10) +
      184    " Фильтр для разделения проводимых" + chr(10) +
      185    " документов IBS Trade необходимо" + chr(10) +
      186    " хранить вне базы данных." + chr(10) +
      187    " Для этого следует указать его" + chr(10) +
      188    " размещение - каталог." + chr(10) +
      189    " Отметьте, что этот каталог" + chr(10) +
      190    " должен обладать особым" + chr(10) +
      191    " статусом: он должен быть" + chr(10) +
      192    " доступен с других рабочих" + chr(10) +
      193    " станций. Хорошим решением будет" + chr(10) +
      194    " то, которое примет" + chr(10) +
      195    " администратор системы!"
      196    FRAME Dialog-Frame:TITLE = "Установка каталога для фильтра разделения документов IBS Trade"
      197    .
      198   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      199   on help of frame Dialog-Frame
      200   do:
      201     run gbl/app_help.p
      202       (input this-procedure :file-name
      203       ,input ''
      204       ,input ?
      205       ) no-error.
      206     if error-status :error then do:
      207       message
      208         "Ошибка при вызове помощи"
      209         error-status :get-message(1)
      210         view-as alert-box .
      211     end.
      212   end.
      213   run minbtn-set in this-procedure .
      214   on choose of b-help in frame Dialog-Frame
      215   do:
      216     apply "help":u to frame Dialog-Frame .
      217   end.
      218   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      219   procedure minbtn-set :
      220       do
      221           on error undo, return error return-value
      222           :
      223           define variable ii              as integer       no-undo .
      224           define variable fh              as widget-handle no-undo .
      225           define variable hh              as widget-handle no-undo .
      226           define variable v-h             as handle        extent 4 no-undo .
      227           define variable v-name-button   as character     no-undo .
      228           define variable v-help-old-x    as decimal       no-undo .
      229           define variable v-help-old-y    as decimal       no-undo .
      230           define variable v-help-old-size as decimal       no-undo .
      231           define variable v-frame-width   as decimal       no-undo .
      232           define variable jj              as integer       no-undo .
      233           do
      234               on error undo, return error
      235               :
      236               assign
      237                   v-frame-width = frame Dialog-Frame:width - 0.3
      238                   fh            = frame Dialog-Frame:first-child
      239                   hh            = fh:first-child
      240                   ii            = 1
      241                   .
      242               do while valid-handle(hh):
      243                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      244                   do:
      245                       case lc(hh:name) :
      246                           when "b-help" then
      247                               do:
      248                                   hh:load-image-up("cmp/b-help.bmp":u) .
      249                                   hh:load-image-down("cmp/b-help.bmp":u) .
      250                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      251                                   hh:TOOLTIP = "Помощь" .
      252                                   v-help-old-x = hh:column .
      253                                   v-help-old-y = hh:row    .
      254                                   v-help-old-size = hh:width .
      255                                   hh:width-chars = 2.5 .
      256                               end.
      257                           when "b-print" then
      258                               do:
      259                                   hh:load-image("cmp/b-print.bmp":u) .
      260                                   hh:TOOLTIP = "Печать" .
      261                                   v-h[ii] = hh:handle .
      262                                   ii = ii + 1 .
      263                                   hh:width-chars = 3 .
      264                               end.
      265                           when "b-history" or
      266                           when "b-hist" then
      267                               do:
      268                                   hh:load-image("cmp/b-hist.bmp":u) .
      269                                   hh:TOOLTIP = "История" .
      270                                   v-h[ii] = hh:handle .
      271                                   ii = ii + 1 .
      272                                   hh:width-chars = 3 .
      273                               end.
      274                           when "b-sch" then
      275                               do:
      276                                   hh:load-image("cmp/b-sch.bmp":u) .
      277                                   hh:TOOLTIP = "Установка Фильтра" .
      278                                   v-h[ii] = hh:handle .
      279                                   ii = ii + 1 .
      280                                   hh:width-chars = 3 .
      281                               end.
      282                           when "b-hist-user" then
      283                               do:
      284                                   hh:load-image("cmp/b-hist.bmp":u) .
      285                                   hh:TOOLTIP = "История пользователя" .
      286                                   ii = ii + 1 .
      287                               end.
      288                       end case.
      289                   end.
      290                   hh = hh:next-sibling.
      291               end.
      292               b-help:column = v-frame-width - b-help:width-chars.
      293               jj = 0.
      294               repeat ii = 4 to 1 by -1 :
      295                   if valid-handle (v-h[ii] ) then
      296                   do:
      297                       jj  = jj + 1 .
      298                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      299                       v-h[ii]:row    = v-help-old-y .
      300                   end.
      301               end.
      302           end.
      303       end.
      304   end procedure.
      305   MAIN-BLOCK:
      306   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      307      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      308     RUN enable_UI.
      309     WAIT-FOR GO OF FRAME Dialog-Frame.
      310   END.
      311   RUN disable_UI.
      312   PROCEDURE disable_UI :
      313     HIDE FRAME Dialog-Frame.
      314   END PROCEDURE.
      315   PROCEDURE enable_UI :
      316     DISPLAY EDITOR-1
      317         WITH FRAME Dialog-Frame.
      318     ENABLE imgName Btn_Next Btn_Cancel b-help EDITOR-1
      319         WITH FRAME Dialog-Frame.
      320     VIEW FRAME Dialog-Frame.
      321   END PROCEDURE.
