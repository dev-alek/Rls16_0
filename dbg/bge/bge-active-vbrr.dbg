     1766        )
     1767     or (can-query (self, "read-only")
     1768        and
     1769        self :read-only = false
     1770        )
     1771     then do:
     1772       assign
     1773         self :screen-value = ?
     1774       .
     1775     end.
     1776     return no-apply.
     1777   end.
