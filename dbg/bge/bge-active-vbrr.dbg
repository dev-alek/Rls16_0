     1481                   "Ошибка при вызове процедуры gbl/usobjava.i" skip
     1482                   error-status :get-message(1) skip
     1483                   return-value skip
     1484                   view-as alert-box error .
     1485               undo, return no-apply .
     1486           end.
     1487           if v-object-available = true
     1488               then
     1489           do:
     1490   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1491   run userobjs_append in this-procedure
     1492     (input  v-cntxt-obj-type
     1493     ,input  v-cntxt-obj-code
     1494     )  .
     1495           end.
     1496           define variable v-user-select as logical no-undo .
     1497   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1498   run userobjs_select-many in this-procedure
     1499     (input  parparentproc
     1500     ,input  v-cntxt-db-num
     1501     ,input  v-cntxt-userid
     1502     ,input  v-cntxt-host-code-obj
     1503     ,input  v-cntxt-obj-type
     1504     ,input  v-cntxt-obj-code
     1505     ,output v-user-select
     1506     )  .
     1507           if v-user-select <> true
     1508               then
     1509           do:
     1510               message
     1511                   "Объект не выбран"
     1512                   view-as alert-box information .
     1513               return no-apply .
     1514           end.
     1515           define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1516           for each temp_obj-list:
     1517               delete temp_obj-list.
     1518           end.
     1519           for each buf_userobjs_temp-user-obj
     1520               on error undo, return no-apply
     1521               :
     1522               create temp_obj-list.
     1523               assign
     1524                   temp_obj-list.obj-type = buf_userobjs_temp-user-obj.obj-type
     1525                   temp_obj-list.obj-code = buf_userobjs_temp-user-obj.obj-code
     1526                   .
     1527           end.
     1528           assign
     1529               p-obj-list = ""
     1530               .
     1531           for each temp_obj-list
     1532               :
     1533               assign
     1534                   p-obj-list = p-obj-list
     1535                                       + temp_obj-list.obj-type + "," + string( temp_obj-list.obj-code ) + ",".
     1536           end.
     1537           assign
     1538           p-obj-list = right-trim(p-obj-list, ",").
     1539               ed-object :screen-value = p-obj-list
     1540               .
     1541       END.
     1542   ON CHOOSE OF bt-v-active IN FRAME Dialog-Frame
     1543   DO:
     1544           if bge-active = yes then
     1545           do:
     1546               run ref/gds-ref.p
     1547                   ( input parparentproc
     1548                   ,input "b-sel"
     1549                   ,input 'текущие':U
     1550                   ,input 'все':U
     1551                   ,input 'все':U
     1552                   ,input ?
     1553                   ,input ?
     1554                   ,input ?
     1555                   ,input ?
     1556                   ,input ?
     1557                   ,input ?
     1558                   ,input ?
     1559                   ,output ref-list).
     1560               if ref-list = ? OR ref-list = "" then return.
     1561               find first ub.goods no-lock
     1562                   where recid(ub.goods) = int(ref-list).
     1563               assign
     1564                   v-gds-active = ub.goods.gds-name
     1565                   v-gds-rec    = ub.goods.gds-code.
     1566           end.
     1567           gds-active:screen-value   = string(v-gds-rec).
     1568       END.
     1569   ON CHOOSE OF bt-v-inf-pop IN FRAME Dialog-Frame
     1570   DO:
     1571           define variable ref-list-inf as char no-undo.
     1572           assign bge-inf-po.
     1573           if bge-inf-po = yes then
     1574           do:
     1575               run ref/gds-ref.p
     1576                   ( input parparentproc
     1577                   ,input "b-sel"
     1578                   ,input 'текущие':U
     1579                   ,input 'все':U
     1580                   ,input 'все':U
     1581                   ,input ?
     1582                   ,input ?
     1583                   ,input ?
     1584                   ,input ?
     1585                   ,input ?
     1586                   ,input ?
     1587                   ,input ?
     1588                   ,output ref-list-inf).
     1589               if ref-list-inf = ? OR ref-list-inf = "" then return.
     1590               find first ub.goods no-lock
     1591                   where recid(ub.goods) = int(ref-list-inf).
     1592               assign
     1593                   v-gds-inf     = ub.goods.gds-name
     1594                   v-gds-rec-inf = ub.goods.gds-code.
     1595           end.
     1596           gds-inf-po:screen-value  = string(v-gds-rec-inf).
     1597       END.
     1598   ON CHOOSE OF Btn_Cancel IN FRAME Dialog-Frame
     1599   DO:
     1600           assign
     1601               p-cancel = yes
     1602               .
     1603           apply "window-close" to frame Dialog-Frame.
     1604       END.
     1605   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     1606   DO:
     1607   define variable v-obj-range as integer no-undo .
     1608   define variable v-host-code as integer no-undo .
     1609   assign
     1610   date-from
     1611   date-to
     1612   .
     1613           if date-from > date-to then
     1614           do:
     1615               message
     1616                   "Даты интервала заданы неверно. "
     1617                   skip
     1618                   " Нижняя дата интервала должна быть меньше верхней."
     1619                   skip(1) "Задайте интервал дат правильно или отмените экспорт."
     1620                   view-as alert-box information.
     1621               apply "entry" to date-from.
     1622               undo, return no-apply.
     1623           end.
     1624           DEFINE VARIABLE l-dircrt  AS LOGICAL       NO-UNDO.
     1625           define variable h-par     as widget-handle no-undo.
     1626           DEFINE variable loghandle AS HANDLE        no-undo.
     1627           DEFINE VARIABLE v-objects AS CHARACTER     NO-UNDO.
     1628           ASSIGN
     1629               FRAME Dialog-Frame
     1630               v-directory
     1631               .
     1632           v-directory = right-trim(v-directory,'/\') + '\'.
     1633           file-info:file-name = v-directory.
     1634           IF FILE-INFO:FILE-TYPE = ? THEN
     1635           DO:
     1636               MESSAGE SUBSTITUTE("Директории &1 не существует.",v-directory) SKIP
     1637                   "Создать?" VIEW-AS ALERT-BOX WARNING BUTTONS YES-NO UPDATE l-dircrt.
     1638               IF l-dircrt THEN
     1639               DO:
     1640                   OS-CREATE-DIR VALUE(v-directory).
     1641                   IF OS-ERROR <> 0 THEN
     1642                   DO:
     1643                       MESSAGE SUBSTITUTE("Невозможно создать директорию &1",v-directory) VIEW-AS ALERT-BOX ERROR.
     1644                       LEAVE.
     1645                   END.
     1646               END.
     1647               ELSE LEAVE.
     1648           END.
     1649           ELSE
     1650           DO:
     1651               IF NOT (FILE-INFO:FILE-TYPE BEGINS "D":U) THEN
     1652               DO:
     1653                   MESSAGE SUBSTITUTE("&1 не является директорией.",v-directory) VIEW-AS ALERT-BOX ERROR.
     1654                   LEAVE.
     1655               END.
     1656           END.
     1657           FILE-INFO:FILE-NAME = v-directory.
     1658           assign
     1659               rs-1
     1660               code_pnpo
     1661               bge-active
     1662               bge-inf-po
     1663               v-per
     1664               gds-inf-po
     1665               gds-active
     1666               .
     1667         case rs-1 :screen-value :
     1668           when "2" then do:
     1669             assign
     1670               v-obj-range = 2
     1671               v-host-code = p-curr-host-code
     1672               p-obj-list  = string(p-curr-host-code)
     1673             .
     1674           end.
     1675           when "3" then do:
     1676             assign
     1677               v-obj-range = 3
     1678               p-obj-list  = ""
     1679             .
     1680             for each temp_obj-list :
     1681               p-obj-list = p-obj-list + "," + temp_obj-list.obj-type + "," + string( temp_obj-list.obj-code ) .
     1682             end.
     1683             p-obj-list = substring(p-obj-list, 2).
     1684           end.
     1685           otherwise assign
     1686             v-obj-range = 2
     1687             v-host-code = p-curr-host-code
     1688             p-obj-list  = string(p-curr-host-code)
     1689           .
     1690         end case.
     1691           if p-mode = "shd" then
     1692           do:
     1693               v-param-list =
     1694                   string(gds-inf-po) + chr(4) +
     1695                   string(gds-active) + chr(4) +
     1696                   v-directory + chr(4) +
     1697                   code_pnpo + chr(4) +
     1698                   string(bge-active) + chr(4) +
     1699                   string(bge-inf-po) + chr(4) +
     1700                   string(v-per)
     1701               .
     1702               run attach-attr-to-schedule-line in this-procedure ( INPUT v-param-list ).
     1703   define variable v-list as character no-undo .
     1704               v-list = substitute( "&1:&2"
     1705                                , v-obj-range
     1706                                , p-obj-list
     1707                                ).
     1708               run schedule-attr-write in this-procedure (input p-db-num-char,
     1709                   input p-task-type,
     1710                   input p-task-num,
     1711                   input 'schedule-obj-list':U,
     1712                   input v-list).
     1713               message "Параметры сохранены!" view-as alert-box information.
     1714               apply "go".
     1715           end.
     1716           if p-mode = "run" then
     1717           do:
     1718               run bge/active-vbrr.p (input parparentproc
     1719                   ,input v-obj-range
     1720                   ,input v-host-code
     1721                   ,input p-obj-list
     1722                   ,input date-to
     1723                   ,input date-from
     1724                   ,input gds-inf-po
     1725                   ,input gds-active
     1726                   ,input v-directory
     1727                   ,input code_pnpo
     1728                   ,input bge-active
     1729                   ,input bge-inf-po
     1730                   ,input v-per
     1731                   ) no-error .
     1732               if error-status :error then
     1733               do:
     1734                   message
     1735            return-value skip
     1736               error-status:get-message(1) view-as alert-box error.
     1737               end.
     1738   run flt-save in this-procedure .
     1739   end.
     1740   END.
     1741   ON RETURN OF date-to IN FRAME Dialog-Frame
     1742   DO:
     1743           APPLY "ENTRY" TO btn_ok IN FRAME Dialog-Frame.
     1744           RETURN NO-APPLY.
     1745       END.
