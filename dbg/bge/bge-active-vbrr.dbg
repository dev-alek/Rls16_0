        1   DEFINE VARIABLE vss-revision    AS CHARACTER NO-UNDO INIT "$Revision$":U .
        2   DEFINE VARIABLE vss-author      AS CHARACTER NO-UNDO INIT "$Author$":U .
        3   DEFINE VARIABLE vss-date        AS CHARACTER NO-UNDO INIT "$Date$":U .
        4   DEFINE VARIABLE vss-workfile    AS CHARACTER NO-UNDO INIT "$Workfile$":U .
        5   DEFINE VARIABLE vss-archive     AS CHARACTER NO-UNDO INIT "$Archive$":U .
        6   define variable vss-description as character no-undo init "Выгрузка информации по пополнениям и активации для сверки с ВБРР ".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111   procedure cur-time :
      112      define output parameter p-today as date      no-undo .
      113      define output parameter p-time  as integer   no-undo .
      114     do
      115     on error undo, return error
      116     :
      117       define variable v-date1 as date      no-undo .
      118       define variable v-date2 as date      no-undo .
      119       define variable v-time  as integer   no-undo .
      120       assign
      121         v-date1 = today
      122         v-time  = time
      123         v-date2 = today
      124       .
      125       if v-date1 <> v-date2
      126       then do:
      127         assign
      128           v-date1 = today
      129           v-time  = v-time
      130         .
      131       end.
      132       assign
      133         p-today = v-date1
      134         p-time  = v-time
      135       .
      136     end.
      137   end.
      138   function cur-time-date returns character
      139   :
      140     return string(today, '99/99/9999':U) .
      141   end.
      142   function cur-time-mjd returns decimal
      143   :
      144     define variable v-date as date      no-undo .
      145     define variable v-time as integer   no-undo .
      146     run cur-time in this-procedure
      147       (output v-date
      148       ,output v-time
      149       ) .
      150     return integer(v-date) - 2400002 + (v-time / 86400) .
      151   end.
      152   function cur-time-get-ending-index returns integer
      153   (input p-number as integer
      154   )
      155   :
      156     if p-number < 0
      157     or p-number = ?
      158     then do:
      159       return 1 .
      160     end.
      161     define variable v-rest as integer   no-undo .
      162     assign
      163       p-number = p-number modulo 100
      164     .
      165     if p-number < 20
      166     then do:
      167       assign
      168         v-rest = p-number
      169       .
      170     end.
      171     else do:
      172       assign
      173         v-rest = p-number modulo 10
      174       .
      175     end.
      176     case v-rest :
      177       when 1
      178       then do:
      179         return 2 .
      180       end.
      181       when 2 or
      182       when 3 or
      183       when 4
      184       then do:
      185         return 3 .
      186       end.
      187       otherwise do:
      188         return 1 .
      189       end.
      190     end case .
      191   end.
      192   procedure cur-time-mjd-to-date :
      193      define input  parameter i-mjd-diff as decimal no-undo.
      194      define output parameter o-Date     as date    no-undo.
      195      define output parameter o-Time     as integer no-undo.
      196      define variable v-day-number as integer   no-undo .
      197      if    i-mjd-diff < 0
      198         or i-mjd-diff = ?
      199      then do:
      200         return "?" .
      201      end.
      202      assign
      203         v-day-number = truncate(i-mjd-diff,0).
      204         o-Date = date(v-day-number + 2400002).
      205         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      206     .
      207   end.
      208   function cur-time-mjd-to-string returns character
      209   (input p-mjd-diff as decimal
      210   )
      211   :
      212     define variable v-day-number as integer   no-undo .
      213     define variable v-seconds    as integer   no-undo .
      214     define variable v-hour       as integer   no-undo .
      215     define variable v-min        as integer   no-undo .
      216     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      217     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      218     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      219     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      220     if p-mjd-diff < 0
      221     or p-mjd-diff = ?
      222     then do:
      223       return "?" .
      224     end.
      225     assign
      226       v-day-number = integer(truncate(p-mjd-diff,0))
      227       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      228     .
      229     if v-seconds > 86400
      230     then do:
      231       assign
      232         v-seconds = 86400 - 1
      233       .
      234     end.
      235     if v-seconds < 0
      236     then do:
      237       assign
      238         v-seconds = 0
      239       .
      240     end.
      241     assign
      242       v-hour = truncate(v-seconds / 3600, 0)
      243     .
      244     assign
      245       v-seconds = v-seconds modulo 3600
      246     .
      247     assign
      248       v-min = truncate(v-seconds / 60, 0)
      249     .
      250     assign
      251       v-seconds = v-seconds modulo 60
      252     .
      253     return
      254         (if v-day-number <> 0
      255           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      256           else ""
      257         )
      258       + (if v-day-number <> 0 or v-hour <> 0
      259           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      260           else ""
      261         )
      262       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      263           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      264           else ""
      265         )
      266       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      267       .
      268   end.
      269   function cur-time-string returns character
      270   :
      271     define variable v-date as date      no-undo .
      272     define variable v-time as integer   no-undo .
      273     run cur-time in this-procedure
      274       (output v-date
      275       ,output v-time
      276       ) .
      277     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      278   end.
      279   function cur-time-string-sec returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      288   end.
      289   function cur-time-custom  returns character
      290   (input p-prefix as character
      291   ,input p-date-format as character
      292   ,input p-delimiter as character
      293   ,input p-time-format as character
      294   ,input p-suffix as character
      295   )
      296   :
      297     define variable v-date as date      no-undo .
      298     define variable v-time as integer   no-undo .
      299     run cur-time in this-procedure
      300       (output v-date
      301       ,output v-time
      302       ) .
      303     return
      304       p-prefix
      305       + string(v-date, p-date-format)
      306       + p-delimiter
      307       + string(v-time, p-time-format)
      308       + p-suffix
      309       .
      310   end.
      311   function cur-time-print  returns character
      312   :
      313     define variable v-date as date      no-undo .
      314     define variable v-time as integer   no-undo .
      315     run cur-time in this-procedure
      316       (output v-date
      317       ,output v-time
      318       ) .
      319     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      320   end.
      321   function cur-time-datetime returns datetime
      322   :
      323     define variable v-char as character no-undo .
      324     define variable v-datetime as datetime no-undo .
      325     v-char = cur-time-string().
      326     v-datetime = datetime(v-char).
      327     return  v-datetime.
      328   end.
      329   function cur-time-string-msec returns character
      330   :
      331     define variable v-date as datetime  no-undo .
      332     v-date = now.
      333     return string(v-date) .
      334   end.
      335   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      336   define temp-table userobjs_temp-user-obj no-undo
      337     field obj-type as character
      338     field obj-code as integer
      339     index xpk is primary unique obj-type obj-code
      340     .
      341   procedure userobjs_clear :
      342     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      343     do
      344     on error undo, return error return-value
      345     :
      346       for each buf_userobjs_temp-user-obj
      347       on error undo, return error return-value
      348       :
      349         delete buf_userobjs_temp-user-obj .
      350       end.
      351     end.
      352   end .
      353   procedure userobjs_object-count :
      354     define output parameter p-total-count as integer   no-undo .
      355     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      356     do
      357     on error undo, return error return-value
      358     :
      359       assign
      360         p-total-count = 0
      361       .
      362       for each buf_userobjs_temp-user-obj
      363       on error undo, return error return-value
      364       :
      365         assign
      366           p-total-count = p-total-count + 1
      367         .
      368       end.
      369     end.
      370   end.
      371   procedure userobjs_append :
      372      define input  parameter p-obj-type as character no-undo .
      373      define input  parameter p-obj-code as integer   no-undo .
      374     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      375     do
      376     on error undo, return error return-value
      377     :
      378       find first buf_userobjs_temp-user-obj
      379         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      380           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      381         no-error .
      382       if not available buf_userobjs_temp-user-obj
      383       then do:
      384         create buf_userobjs_temp-user-obj .
      385         assign
      386           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      387           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      388         .
      389       end.
      390     end.
      391   end.
      392   procedure userobjs_object-exist :
      393     define output parameter p-object-exist as logical   no-undo .
      394     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      395     do
      396     on error undo, return error return-value
      397     :
      398       find first buf_userobjs_temp-user-obj
      399         no-error .
      400       if not available buf_userobjs_temp-user-obj
      401       then do:
      402         assign
      403           p-object-exist = false
      404         .
      405       end.
      406       else do:
      407         assign
      408           p-object-exist = true
      409         .
      410       end.
      411     end.
      412   end.
      413   procedure userobjs_transfer :
      414     define input  parameter p-callback-handle as handle no-undo .
      415     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      416     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      417     do
      418     on error undo, return error return-value
      419     :
      420       if valid-handle(p-callback-handle) <> true
      421       then do:
      422         message
      423           vss-workfile vss-revision vss-description skip
      424           "Ошибка задания входных параметров" skip
      425           "Неизвестный указатель на процедуру" skip
      426           view-as alert-box error .
      427         undo, return error return-value .
      428       end.
      429       if p-callback-handle :get-signature("userobjs_append") = ""
      430       then do:
      431         message
      432           vss-workfile vss-revision vss-description skip
      433           "Ошибка задания входных параметров" skip
      434           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      435                     ,p-callback-handle :file-name
      436                     ) skip
      437           view-as alert-box error .
      438         undo, return error return-value .
      439       end.
      440       for each buf_userobjs_temp-user-obj
      441       on error undo, return error return-value
      442       :
      443         run userobjs_append in p-callback-handle
      444           (input  buf_userobjs_temp-user-obj.obj-type
      445           ,input  buf_userobjs_temp-user-obj.obj-code
      446           ) .
      447       end.
      448     end.
      449   end procedure.
      450   procedure userobjs_select-one :
      451      define input  parameter parparentproc     as widget-handle no-undo .
      452      define input  parameter p-db-num          as integer   no-undo .
      453      define input  parameter p-user-id         as character no-undo .
      454      define input  parameter p-host-code-obj   as integer   no-undo .
      455      define input  parameter p-obj-type        as character no-undo .
      456      define input  parameter p-obj-code        as integer   no-undo .
      457      define output parameter p-user-select     as logical   no-undo .
      458      define output parameter p-select-obj-type as character no-undo .
      459      define output parameter p-select-obj-code as character no-undo .
      460     do
      461     on error undo, return error return-value
      462     :
      463       run gbl/userobjs.w
      464         (input  parparentproc
      465         ,input  this-procedure :handle
      466         ,input  p-db-num
      467         ,input  p-user-id
      468         ,input  p-host-code-obj
      469         ,input  p-obj-type
      470         ,input  p-obj-code
      471         ,INPUT  "b-sel"
      472         ,output p-user-select
      473         ,output p-select-obj-type
      474         ,output p-select-obj-code
      475         ) .
      476     end.
      477   end.
      478   procedure userobjs_select-many :
      479     define input  parameter parparentproc   as widget-handle no-undo .
      480     define input  parameter p-db-num        as integer   no-undo .
      481     define input  parameter p-user-id       as character no-undo .
      482     define input  parameter p-host-code-obj as integer   no-undo .
      483     define input  parameter p-obj-type      as character no-undo .
      484     define input  parameter p-obj-code      as integer   no-undo .
      485     define output parameter p-user-select   as logical   no-undo .
      486     define variable v-select-obj-type as character no-undo .
      487     define variable v-select-obj-code as integer   no-undo .
      488     do
      489     on error undo, return error return-value
      490     :
      491       run gbl/userobjs.w
      492         (input  parparentproc
      493         ,input  this-procedure :handle
      494         ,input  p-db-num
      495         ,input  p-user-id
      496         ,input  p-host-code-obj
      497         ,input  p-obj-type
      498         ,input  p-obj-code
      499         ,INPUT  "b-sel,b-mark"
      500         ,output p-user-select
      501         ,output v-select-obj-type
      502         ,output v-select-obj-code
      503         ) .
      504     end.
      505   end.
      506   procedure thobjs :
      507      define input        parameter parparentproc     as widget-handle no-undo .
      508      define input        parameter i-bttns           as character     no-undo .
      509      define input        parameter i-list-mode       as character     no-undo.
      510      define input        parameter i-obj-type        as character     no-undo.
      511      define input        parameter i-db-num          as integer       no-undo.
      512      define input        parameter i-host-code       as integer       no-undo.
      513      define input-output parameter p-rid-list        as character     no-undo .
      514   run ref/thobjs.p
      515           ( input parparentproc
      516            ,input  this-procedure :handle
      517           , input i-bttns
      518           , input i-list-mode
      519           , input i-obj-type
      520           , input i-db-num
      521           , input i-host-code
      522           , input-output p-rid-list ) no-error .
      523   end.
      524   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      525   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      526   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      527   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      528   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      529   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      530   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      531   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      532   procedure uf-name :
      533     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      534     define output parameter p-use-List_     as logical   no-undo .
      535     define output parameter p-type-List_     as character no-undo .
      536     define output parameter p-format-List_   as character no-undo .
      537     define output parameter p-use-Naim      as logical   no-undo .
      538     define output parameter p-type-Naim      as character no-undo .
      539     define output parameter p-format-Naim    as character no-undo .
      540     define output parameter p-use-print-graft as logical   no-undo .
      541     define output parameter p-use-sort-gr   as logical   no-undo .
      542     define output parameter p-use-type-price as logical   no-undo .
      543     define output parameter p-use-type-val  as logical   no-undo .
      544     define output parameter p-label          as character no-undo .
      545     define output parameter p-tooltip        as character no-undo .
      546     define output parameter p-user-can-edit  as logical   no-undo .
      547     define output parameter p-output-display as logical   no-undo .
      548     define output parameter p-other          as character no-undo .
      549     do
      550     on error undo, return error
      551     :
