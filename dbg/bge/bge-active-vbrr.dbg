     2229   .
     2230   MAIN-BLOCK:
     2231   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2232      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2233     RUN enable_UI.
     2234       run get-host-name in this-procedure ( output v-host-name ) no-error .
     2235       if error-status :error
     2236       then do:
     2237           message
     2238             vss-workfile vss-revision vss-description
     2239             skip "Ошибка при определении имени фирмы"
     2240             skip "Код фирмы:" p-curr-host-code
     2241             skip "Имя фирмы будет отображаться как '" + 'орг':U + string( p-curr-host-code ) + "'"
     2242             skip return-value
     2243             skip trim(error-status :get-message(1))
     2244                  trim(error-status :get-message(2))
     2245                  trim(error-status :get-message(3))
     2246                  trim(error-status :get-message(4))
     2247                  trim(error-status :get-message(5))
     2248           view-as alert-box warning.
     2249           assign
     2250               v-host-name = 'орг':U + string( p-curr-host-code )
     2251           .
     2252       end.
     2253       assign
     2254           rs-1 :screen-value in frame dialog-frame = "2"
     2255           ed-object :screen-value in frame Dialog-frame = 'орг':U + string( p-curr-host-code ) + " " + v-host-name
     2256       .
     2257       assign
     2258           rs-1
     2259       .
     2260       if p-mode = "run" then
     2261       do:
     2262           run flt-load in this-procedure .
     2263       end.
     2264       if rs-1 <> 3 then
     2265       do:
     2266           disable bt-sel-obj with frame Dialog-Frame .
     2267       end.
     2268       if bge-active = no then
     2269       do:
     2270           disable gds-active  with frame Dialog-Frame .
     2271           disable bt-v-active  with frame Dialog-Frame .
     2272       end.
     2273       if bge-inf-po = no then
     2274       do:
     2275           disable gds-inf-po  with frame Dialog-Frame .
     2276           disable     bt-v-inf-pop  with frame Dialog-Frame .
     2277       end.
     2278       if p-mode = "shd" then
     2279       do:
     2280           Btn_OK:LABEL = "Сохранить".
     2281           display    Btn_OK    with frame Dialog-Frame.
     2282           enable Btn_OK with frame Dialog-Frame.
     2283       end.
     2284       else
     2285       do:
     2286           Btn_OK:LABEL = "Запустить".
     2287       end.
     2288       run myenable .
     2289     WAIT-FOR GO OF FRAME Dialog-Frame.
     2290   END.
     2291   RUN disable_UI.
     2292   PROCEDURE disable_UI :
     2293     HIDE FRAME Dialog-Frame.
     2294   END PROCEDURE.
     2295   PROCEDURE enable_UI :
     2296     DISPLAY v-per time-days date-from date-to code_pnpo v-directory ed-object rs-1
     2297             bge-inf-po gds-inf-po bge-active gds-active
     2298         WITH FRAME Dialog-Frame.
     2299     ENABLE RECT-1 Btn_OK Btn_Cancel v-per time-days date-from date-to code_pnpo
     2300            v-directory ed-object rs-1 bt-sel-obj bge-inf-po gds-inf-po
     2301            bt-v-inf-pop bge-active gds-active bt-v-active
     2302         WITH FRAME Dialog-Frame.
     2303     VIEW FRAME Dialog-Frame.
     2304   END PROCEDURE.
     2305   PROCEDURE myenable :
     2306       case p-mode:
     2307           when "run" then
     2308               do:
     2309                   hide  v-per in frame Dialog-Frame.
     2310                   hide time-days in frame  Dialog-Frame.
     2311                   disable   v-per  time-days with  frame  Dialog-Frame.
     2312               end.
     2313           when "shd" then
     2314               do:
     2315                   hide date-from in frame  Dialog-Frame.
     2316                   hide date-to in frame Dialog-Frame.
     2317                   disable  date-to  date-from with  frame  Dialog-Frame.
     2318                   run schedule-attr-value in this-procedure (input p-db-num-char
     2319                       , input p-task-type
     2320                       , input p-task-num
     2321                       , input 'schedule-param-list':U
     2322                       ,output v-param-list
     2323                       ,output v-param-type).
     2324                   if v-param-list <> ?  then
     2325                   do:
     2326                       assign
     2327                           gds-inf-po  = integer(entry (1, v-param-list, chr(4)))
     2328                           gds-active  = integer(entry (2, v-param-list, chr(4)))
     2329                           v-directory = entry (3, v-param-list, chr(4))
     2330                           code_pnpo   = entry (4, v-param-list, chr(4))
     2331                           bge-active  = logical(entry (5, v-param-list, chr(4)))
     2332                           bge-inf-po  = logical(entry (6, v-param-list, chr(4)))
     2333                           v-per       = integer(ENTRY(7, v-param-list, chr(4)))
     2334                           p-obj-list  = (ENTRY(8, v-param-list, chr(4)))
     2335                           no-error
     2336                           .
     2337                   end.
     2338                   display gds-inf-po v-directory gds-active  code_pnpo   bge-active bge-inf-po v-per  with frame Dialog-Frame.
     2339                   ed-object :SCREEN-VALUE = p-obj-list.
     2340               end.
     2341       end case.
     2342   END PROCEDURE.
     2343   PROCEDURE attach-attr-to-schedule-line :
     2344       DEFINE INPUT PARAMETER p-param-list AS CHARACTER NO-UNDO.
     2345       define buffer buf_schedule      for schedule.
     2346       define buffer buf_schedule-attr for schedule-attr.
     2347       define buffer lock-batchprocess for ub.batchprocess.
     2348       run gbl/lock-prc.p
     2349           (input 'schd':U
     2350           ,input 'exp-active-vbrr':U
     2351           ,input 0
     2352           ,input 0
     2353           ,input '':U
     2354           ,input ""
     2355           ,input ""
     2356           ,input (
     2357           "Сохранение параметров выгрузки чеков "
     2358           )
     2359           ,input yes
     2360           ,buffer lock-batchprocess
     2361           ) no-error .
     2362       find first buf_schedule no-lock
     2363           where buf_schedule.task-type   = p-task-type
     2364           and buf_schedule.cre-db-num  = INTEGER(p-db-num-char)
     2365           and buf_schedule.task-num    = p-task-num
     2366           no-error.
     2367       if not available buf_schedule
     2368           and (  p-task-type   <> 'autofree':U
     2369           or p-db-num-char <> p-db-num-char
     2370           or p-task-num    <> -1 )
     2371           then
     2372       do:
     2373           message
     2374               vss-workfile vss-revision vss-description
     2375               skip
     2376               "Не найдена строка расписания."
     2377               skip return-value
     2378               skip trim(error-status :get-message(1))
     2379               trim(error-status :get-message(2))
     2380               trim(error-status :get-message(3))
     2381               view-as alert-box error.
     2382           undo, return error .
     2383       end.
     2384       run schedule-attr-write in this-procedure (
     2385           input INTEGER(p-db-num-char)
     2386           , input p-task-type
     2387           , input p-task-num
     2388           , input 'schedule-param-list':U
     2389           , input p-param-list
     2390           ).
     2391   END PROCEDURE.
     2392   PROCEDURE object-select :
     2393   do on error undo, return error :
     2394   case rs-1 :screen-value in frame Dialog-frame:
     2395       when "2" then do:
     2396           assign
     2397             ed-object :screen-value in frame Dialog-frame = 'орг':U + string( p-curr-host-code ) + " " + v-host-name
     2398           .
     2399       end.
     2400       when "3" then do:
     2401           for each temp_obj-list :
     2402               delete temp_obj-list.
     2403           end.
     2404           create temp_obj-list.
     2405           assign
     2406               temp_obj-list.obj-type  = p-curr-obj-type
     2407               temp_obj-list.obj-code  = p-curr-obj-code
     2408               ed-object :screen-value = p-curr-obj-type + string( p-curr-obj-code )
     2409           .
     2410       end.
     2411       otherwise ed-object :screen-value = "".
     2412   end case.
     2413   end.
     2414   END PROCEDURE.
     2415   PROCEDURE get-host-name :
     2416   do
     2417   on error undo, return error
     2418   :
     2419   define output parameter p-host-name as character    no-undo.
     2420   define buffer buf_clients   for ub.clients.
     2421       find first buf_clients no-lock
     2422            where buf_clients.obj-type = 'орг':U
     2423              and buf_clients.obj-code = p-curr-host-code
     2424       no-error.
     2425       if not available buf_clients
     2426       then do:
     2427           message
     2428             vss-workfile vss-revision vss-description
     2429             skip "Не удалось найти текущую фирму"
     2430             skip return-value
     2431             skip trim(error-status :get-message(1))
     2432                  trim(error-status :get-message(2))
     2433                  trim(error-status :get-message(3))
     2434                  trim(error-status :get-message(4))
     2435                  trim(error-status :get-message(5))
     2436           view-as alert-box error.
     2437           undo, return error .
     2438       end.
     2439       else assign
     2440               p-host-name = buf_clients.obj-name
     2441       .
     2442   end.
     2443   END PROCEDURE.
     2444   PROCEDURE flt-save :
     2445       define variable v-obj-range   as integer   no-undo .
     2446       define variable v-obj-list    as character no-undo .
     2447       define variable v-doc-range   as integer   no-undo .
     2448       define variable v-doc-list    as character no-undo .
     2449       define variable v-userid      as character no-undo .
     2450       define variable v-naim        as character no-undo .
     2451       define variable v-list        as character no-undo .
     2452       define variable v-print-graft as logical   no-undo .
     2453       define variable v-sort-gr     as logical   no-undo .
     2454       define variable v-type-price  as logical   no-undo .
     2455       define variable v-type-val    as logical   no-undo .
     2456       v-naim ="".
     2457       do
     2458           on error undo, return error return-value
     2459           :
     2460           assign frame Dialog-Frame
     2461               date-to
     2462               date-from
     2463               gds-inf-po
     2464               gds-active
     2465               v-directory
     2466               code_pnpo
     2467               rs-1
     2468               bge-active
     2469               bge-inf-po
     2470               .
     2471     case rs-1 :screen-value  :
     2472     when "2"  then assign
     2473             v-obj-range = 2
     2474             v-obj-list = string(p-curr-host-code)
     2475         .
     2476     when "3"  then do:
     2477         assign
     2478             v-obj-range = 3
     2479             v-obj-list = ""
     2480         .
     2481         for each temp_obj-list :
     2482           v-obj-list = v-obj-list + "," + temp_obj-list.obj-type + "," + string( temp_obj-list.obj-code ) .
     2483         end.
     2484         v-obj-list = substring(v-obj-list, 2).
     2485     end.
     2486     otherwise assign
     2487             v-obj-range = 2
     2488             v-obj-list = string(p-curr-host-code)
     2489     .
     2490     end case.
     2491           v-naim = string(date-to) + ","
     2492               + string(date-from) + ","
     2493               + string(gds-inf-po) + ","
     2494               + string(gds-active) + ","
     2495               + v-directory + ","
     2496               + code_pnpo + ","
     2497               + string(bge-active) + ","
     2498               + string(bge-inf-po)
     2499               .
     2500           v-list = substitute( "&1:&2"
     2501                                , v-obj-range
     2502                                , v-obj-list
     2503                                )
     2504           .
     2505           run uf-set ( input 'bge-active-vbrr':U
     2506               , input v-cntxt-userid
     2507               , input v-list
     2508               , input v-naim
     2509               , input v-print-graft
     2510               , input v-sort-gr
     2511               , input v-type-price
     2512               , input v-type-val
     2513               ) .
     2514       end.
     2515   end procedure.
     2516   PROCEDURE flt-load :
     2517     define variable v-obj-range      as integer   no-undo .
     2518     define variable v-obj-list       as character no-undo .
     2519     define variable v-obj-type       as character no-undo .
     2520     define variable v-obj-code       as integer   no-undo .
     2521     define variable v-i              as integer   no-undo .
     2522       define variable v-naim        as character no-undo .
     2523       define variable v-list        as character no-undo .
     2524       define variable v-print-graft as logical   no-undo .
     2525       define variable v-sort-gr     as logical   no-undo .
     2526       define variable v-type-price  as logical   no-undo .
     2527       define variable v-type-val    as logical   no-undo .
     2528       define variable v-found       as logical   no-undo .
     2529       define variable v-obj-tot     as integer   no-undo .
     2530       define variable v-ed-object   as char      no-undo.
     2531       p-obj-list = "".
     2532       do
     2533           on error undo, return error return-value
     2534           :
     2535           run uf-get (
     2536               input   'bge-active-vbrr':U
     2537               , input   v-cntxt-userid
     2538               , output  v-list
     2539               , output  v-naim
     2540               , output  v-print-graft
     2541               , output  v-sort-gr
     2542               , output  v-type-price
     2543               , output  v-type-val
     2544               ) .
     2545           if num-entries(v-naim) = 8 then
     2546           do:
     2547               assign
     2548                   date-to     = date( entry( 1, v-naim ) )
     2549                   date-from   = date(  entry( 2, v-naim ) )
     2550                   gds-inf-po  = integer(entry( 3, v-naim ))
     2551                   gds-active  = integer(entry( 4, v-naim ))
     2552                   v-directory = entry( 5, v-naim )
     2553                   code_pnpo   = entry( 6, v-naim )
     2554                   bge-active  = logical(entry( 7, v-naim ) )
     2555                   bge-inf-po  = logical(entry( 8, v-naim ) )
     2556                   no-error
     2557                   .
     2558           end.
     2559           date-from = date-to + 1.
     2560           date-to = today.
     2561           date-from = minimum(date-from, date-to).
     2562           ed-object = "".
     2563           display
     2564               date-to
     2565               date-from
     2566               gds-inf-po
     2567               gds-active
     2568               v-directory
     2569               code_pnpo
     2570               bge-active
     2571               bge-inf-po
     2572               ed-object
     2573               with frame Dialog-Frame.
     2574       if num-entries(v-list,':') = 2
     2575       then do:
     2576         assign
     2577           rs-1        = integer(entry(1, v-list, ':'))
     2578           v-obj-list  = entry(2, v-list, ':')
     2579           v-obj-tot   = num-entries(v-obj-list)
     2580         .
     2581         display
     2582           rs-1
     2583         with frame Dialog-Frame.
     2584         for each temp_obj-list :
     2585           delete temp_obj-list.
     2586         end.
     2587         case rs-1:
     2588           when 2 then do:
     2589             ed-object :screen-value in frame Dialog-frame = 'орг':U + v-obj-list.
     2590           end.
     2591           when 3 then do:
     2592             if v-obj-tot modulo 2 = 0
     2593             then do:
     2594               do v-i = 1 to v-obj-tot / 2 :
     2595                 assign
     2596                   v-obj-type =          entry( v-i * 2 - 1, v-obj-list )
     2597                   v-obj-code = integer( entry( v-i * 2,     v-obj-list ) )
     2598                 .
     2599                 find first temp_obj-list no-lock
     2600                   where temp_obj-list.obj-type = v-obj-type
     2601                     and temp_obj-list.obj-code = v-obj-code no-error .
     2602                 if available temp_obj-list then next.
     2603                 create temp_obj-list.
     2604                 assign
     2605                   temp_obj-list.obj-type = v-obj-type
     2606                   temp_obj-list.obj-code = v-obj-code
     2607                 .
     2608               end.
     2609               assign
     2610                 ed-object :screen-value in frame Dialog-Frame = v-obj-list
     2611               .
     2612             end.
     2613           end.
     2614         end case.
     2615       end.
     2616   p-obj-list = v-obj-list.
     2617       end.
     2618   end procedure.
