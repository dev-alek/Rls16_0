     1400        SIZE 39 BY .81 NO-UNDO.
     1401   DEFINE FRAME Dialog-Frame
     1402        Btn_OK AT ROW 2 COL 3
     1403        Btn_Cancel AT ROW 2 COL 43.6
     1404        v-per AT ROW 3.76 COL 20.6 COLON-ALIGNED WIDGET-ID 20
     1405        time-days AT ROW 3.76 COL 36.6 NO-LABEL WIDGET-ID 52
     1406        date-from AT ROW 4 COL 14.6 COLON-ALIGNED
     1407        date-to AT ROW 4 COL 35 COLON-ALIGNED
     1408        code_pnpo AT ROW 5.52 COL 14.6 COLON-ALIGNED WIDGET-ID 2
     1409        v-directory AT ROW 7 COL 14.6 COLON-ALIGNED WIDGET-ID 12
     1410        ed-object AT ROW 8.76 COL 30 NO-LABEL
     1411        rs-1 AT ROW 8.86 COL 4 NO-LABEL WIDGET-ID 62
     1412        bt-sel-obj AT ROW 10.29 COL 25 WIDGET-ID 6
     1413        bge-inf-po AT ROW 12.67 COL 5 WIDGET-ID 8
     1414        gds-inf-po AT ROW 12.67 COL 44 COLON-ALIGNED NO-LABEL WIDGET-ID 14
     1415        bt-v-inf-pop AT ROW 12.67 COL 68 WIDGET-ID 54
     1416        bge-active AT ROW 13.91 COL 5 WIDGET-ID 10
     1417        gds-active AT ROW 13.91 COL 44 COLON-ALIGNED NO-LABEL WIDGET-ID 16
     1418        bt-v-active AT ROW 13.91 COL 68 WIDGET-ID 56
     1419        RECT-1 AT ROW 8.38 COL 3 WIDGET-ID 60
     1420        SPACE(1.99) SKIP(3.38)
     1421       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1422            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1423            TITLE "Выгрузка информации по пополнениям и активации для сверки с ВБРР"
     1424            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
     1425   ASSIGN
     1426          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1427          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1428   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1429   DO:
     1430     APPLY "END-ERROR":U TO SELF.
     1431       END.
     1432   ON VALUE-CHANGED OF bge-active IN FRAME Dialog-Frame
     1433   DO:
     1434           assign bge-active.
     1435           if bge-active = no then
     1436           do:
     1437               disable gds-active  with frame Dialog-Frame .
     1438               disable bt-v-active  with frame Dialog-Frame .
     1439           end.
     1440           else
     1441           do:
     1442               enable gds-active bt-v-active   with frame Dialog-Frame .
     1443           end.
     1444       END.
     1445   ON VALUE-CHANGED OF bge-inf-po IN FRAME Dialog-Frame
     1446   DO:
     1447           assign bge-inf-po.
     1448           if bge-inf-po then
     1449           do:
     1450               enable gds-inf-po bt-v-inf-pop   with frame Dialog-Frame .
     1451           end.
     1452           else
     1453           do:
     1454               disable gds-inf-po  with frame Dialog-Frame .
     1455               disable     bt-v-inf-pop  with frame Dialog-Frame .
     1456           end.
     1457       END.
