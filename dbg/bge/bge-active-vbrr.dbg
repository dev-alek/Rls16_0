      628   end procedure.
      629   procedure uf-get :
      630     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      631     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      632     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      633     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      634     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      635     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      636     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      637     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      638     do
      639     on error undo, return error
      640     :
      641       define buffer buf_usr-flt for ubflt.usr-flt .
      642       define variable v-use-List_     as logical   no-undo .
      643       define variable v-type-List_     as character no-undo .
      644       define variable v-format-List_   as character no-undo .
      645       define variable v-use-Naim      as logical   no-undo .
      646       define variable v-type-Naim      as character no-undo .
      647       define variable v-format-Naim    as character no-undo .
      648       define variable v-use-print-graft as logical   no-undo .
      649       define variable v-use-sort-gr     as logical   no-undo .
      650       define variable v-use-type-price  as logical   no-undo .
      651       define variable v-use-type-val    as logical   no-undo .
      652       define variable v-label          as character no-undo .
      653       define variable v-tooltip        as character no-undo .
      654       define variable v-user-can-edit  as logical   no-undo .
      655       define variable v-output-display as logical   no-undo .
      656       define variable v-other          as character no-undo .
      657       run uf-name in this-procedure
      658          (input  entry(1, p-code, chr(4))
      659         ,output v-use-List_
      660         ,output v-type-List_
      661         ,output v-format-List_
      662         ,output v-use-Naim
      663         ,output v-type-Naim
      664         ,output v-format-Naim
      665         ,output v-use-print-graft
      666         ,output v-use-sort-gr
      667         ,output v-use-type-price
      668         ,output v-use-type-val
      669         ,output v-label
      670         ,output v-tooltip
      671         ,output v-user-can-edit
      672         ,output v-output-display
      673         ,output v-other
      674         ) no-error .
      675       if error-status :error then do:
      676         undo, return error return-value .
      677       end.
      678       find first buf_usr-flt no-lock where
      679                  buf_usr-flt.Call-point     = p-code AND
      680                  buf_usr-flt.user-name       = p-user-name
      681         no-error .
      682       if avail buf_usr-flt then do:
      683         assign
      684         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      685         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      686         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      687         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      688         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      689         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      690         .
      691       end.
      692       else do:
      693         assign
      694         p-List_        = (if v-use-List_       then "":U                    else ?)
      695         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      696         p-print-graft  = (if v-use-print-graft then no                      else ?)
      697         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      698         p-type-price   = (if v-use-type-price  then no                      else ?)
      699         p-type-val     = (if v-use-List_       then no                      else ?)
      700         .
      701       end.
      702     end.
      703   end procedure.
      704   procedure uf-set :
      705     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      706     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      707     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      708     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      709     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      710     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      711     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      712     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      713     do
      714     on error undo, return error
      715     :
      716       define buffer buf_usr-flt for ubflt.usr-flt .
      717       define variable v-use-List_     as logical   no-undo .
      718       define variable v-type-List_     as character no-undo .
      719       define variable v-format-List_   as character no-undo .
      720       define variable v-use-Naim      as logical   no-undo .
      721       define variable v-type-Naim      as character no-undo .
      722       define variable v-format-Naim    as character no-undo .
      723       define variable v-use-print-graft as logical   no-undo .
      724       define variable v-use-sort-gr   as logical   no-undo .
      725       define variable v-use-type-price as logical   no-undo .
      726       define variable v-use-type-val  as logical   no-undo .
      727       define variable v-tooltip        as character no-undo .
      728       define variable v-label          as character no-undo .
      729       define variable v-user-can-edit  as logical   no-undo .
      730       define variable v-output-display as logical   no-undo .
      731       define variable v-other          as character no-undo .
      732       run uf-name in this-procedure
      733         (input  entry(1, p-code, chr(4))
      734         ,output v-use-List_
      735         ,output v-type-List_
      736         ,output v-format-List_
      737         ,output v-use-Naim
      738         ,output v-type-Naim
      739         ,output v-format-Naim
      740         ,output v-use-print-graft
      741         ,output v-use-sort-gr
      742         ,output v-use-type-price
      743         ,output v-use-type-val
      744         ,output v-label
      745         ,output v-tooltip
      746         ,output v-user-can-edit
      747         ,output v-output-display
      748         ,output v-other
      749         ) no-error .
      750       if error-status :error then do:
      751         undo, return error return-value .
      752       end.
      753       find first buf_usr-flt where
      754                  buf_usr-flt.Call-point     = p-code AND
      755                  buf_usr-flt.user-name       = p-user-name
      756         no-error .
      757       if not avail buf_usr-flt then do:
      758           create buf_usr-flt .
      759           assign
      760           buf_usr-flt.call-point = p-code
      761           buf_usr-flt.user-name  = p-user-name
      762           .
      763       end.
      764       if avail buf_usr-flt then do:
      765        assign
      766        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      767        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      768        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      769        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      770        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      771        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      772       .
      773       release buf_usr-flt.
      774       end.
      775       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      776     end.
      777   end procedure.
      778   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      779     define variable v-cntxt-db-num        as integer   no-undo .
      780     define variable v-cntxt-userid        as character no-undo .
      781     define variable v-cntxt-level         as character no-undo .
      782     define variable v-cntxt-host-code-obj as integer   no-undo .
      783     define variable v-cntxt-obj-type      as character no-undo .
      784     define variable v-cntxt-obj-code      as integer   no-undo .
      785     define variable v-cntxt-db-num-obj    as integer   no-undo .
      786     define variable v-cntxt-is-admin      as logical   no-undo .
      787   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      788   define temp-table temp-schedule-free no-undo
      789   field free-id as character
      790   field free-task-name as character
      791   field proc-run-name as character
      792   field proc-param-edit-name as character
      793   field conf-param as character
      794   field is-gbd as logical
      795   field is-ubd as logical
      796   field enable-concurrent-0 as logical
      797   field enable-concurrent-db as logical
      798   field other-info as character
      799   field enc-key as character
      800   field is-rum as logical
      801   index pi is unique primary
      802   free-id.
      803   procedure schedule-attr-name :
      804   do
      805     on error undo, return error
      806     :
      807     define input  parameter p-code           as character no-undo .
      808     define output parameter p-type           as character no-undo .
      809     define output parameter p-format         as character no-undo .
      810     define output parameter p-label          as character no-undo .
      811     define output parameter p-user-can-edit  as logical   no-undo .
      812     define output parameter p-output-display as logical   no-undo .
      813     define output parameter p-other          as character no-undo .
      814       if index(p-code, chr(4)) > 0 then do:
      815         p-code = entry(1, p-code, chr(4)).
      816       end.
      817       case p-code :
      818               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      819               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      820               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      821               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      822               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      823               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      824               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      825               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      826               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      827         otherwise do:
      828           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      829         end.
      830       end.
      831     end.
      832   end procedure.
      833   procedure schedule-attr-tooltip :
      834   do
      835     on error undo, return error
      836     :
      837       define input  parameter p-code    as character no-undo .
      838       define output parameter p-tooltip as character no-undo .
      839       define output parameter p-label   as character no-undo .
      840       if index(p-code, chr(4)) > 0 then do:
      841         p-code = entry(1, p-code, chr(4)).
      842       end.
      843       case p-code :
      844               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      845               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      846               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      847               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      848               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      849               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      850               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      851               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      852               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      853         otherwise do:
      854               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      855         end.
      856       end.
      857     end.
      858   end procedure.
      859   procedure schedule-attr-value :
      860   do
      861   on error undo, return error return-value
      862   :
      863   define input parameter  p-cre-db-num as integer    no-undo.
      864   define input parameter  p-task-type  as character  no-undo.
      865   define input parameter  p-task-num   as integer    no-undo.
      866   define input parameter  p-code       as character  no-undo.
      867   define output parameter p-value      as character  no-undo.
      868   define output parameter p-type       as character  no-undo.
      869       define variable v-format         as character no-undo .
      870       define variable v-label          as character no-undo .
      871       define variable v-user-can-edit  as logical   no-undo .
      872       define variable v-output-display as logical   no-undo .
      873       define variable v-other          as character no-undo .
      874       define buffer buf_schedule-attr for ub.schedule-attr.
      875       run schedule-attr-name in this-procedure (
      876             input  p-code
      877           , output p-type
      878           , output v-format
      879           , output v-label
      880           , output v-user-can-edit
      881           , output v-output-display
      882           , output v-other
      883       ) no-error .
      884       if error-status :error
      885       then do:
      886           undo, return error return-value .
      887       end.
      888       if p-code begins ('schd-free-id':U + chr(4))
      889       and entry(2, p-code, chr(4)) = '':U then do:
      890         find first buf_schedule-attr no-lock
      891             where buf_schedule-attr.cre-db-num = p-cre-db-num
      892               and buf_schedule-attr.task-type  = p-task-type
      893               and buf_schedule-attr.task-num   = p-task-num
      894               and buf_schedule-attr.attr-code  begins p-code
      895         no-error .
      896       end.
      897       else do:
      898         find first buf_schedule-attr no-lock
      899             where buf_schedule-attr.cre-db-num = p-cre-db-num
      900               and buf_schedule-attr.task-type  = p-task-type
      901               and buf_schedule-attr.task-num   = p-task-num
      902               and buf_schedule-attr.attr-code  = p-code
      903         no-error .
      904       end.
      905       if available buf_schedule-attr
      906       then do:
      907           assign
      908               p-value = buf_schedule-attr.attr-value
      909           .
      910       end.
      911       else do:
      912         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      913            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      914         end.
      915         else do:
      916           assign
      917               p-value = if p-type = 'L':U then "no":U else ""
      918           .
      919         end.
      920       end.
      921   end.
      922   end procedure.
      923   procedure schedule-attr-write :
      924   do
      925   on error undo, return error
      926   :
      927   define input parameter p-cre-db-num  as integer   no-undo.
      928   define input parameter p-task-type   as character no-undo.
      929   define input parameter p-task-num    as integer   no-undo.
      930   define input parameter p-code        as character no-undo.
      931   define input parameter p-value       as character no-undo.
      932       define variable v-type              as character                no-undo.
      933       define variable v-format            as character                no-undo.
      934       define variable v-label             as character                no-undo.
      935       define variable v-user-can-edit     as logical                  no-undo.
      936       define variable v-output-display    as logical                  no-undo.
      937       define variable v-other             as character                no-undo.
      938       define buffer buf_schedule-attr for ub.schedule-attr .
      939       run schedule-attr-name in this-procedure (
      940             input  p-code
      941           , output v-type
      942           , output v-format
      943           , output v-label
      944           , output v-user-can-edit
      945           , output v-output-display
      946           , output v-other
      947       ) no-error.
      948       if error-status :error
      949       then do:
      950           undo, return error return-value.
      951       end.
      952       find first buf_schedule-attr exclusive-lock
      953            where buf_schedule-attr.cre-db-num = p-cre-db-num
      954              and buf_schedule-attr.task-type  = p-task-type
      955              and buf_schedule-attr.task-num   = p-task-num
      956              and buf_schedule-attr.attr-code  = p-code
      957       no-error.
      958       if not available buf_schedule-attr
      959       then do:
      960           create buf_schedule-attr.
      961           assign
      962             buf_schedule-attr.cre-db-num = p-cre-db-num
      963             buf_schedule-attr.task-type  = p-task-type
      964             buf_schedule-attr.task-num   = p-task-num
      965             buf_schedule-attr.attr-code  = p-code
      966             buf_schedule-attr.attr-value = p-value
      967           .
      968       end.
      969       else do:
      970           assign
      971               buf_schedule-attr.attr-value = p-value
      972           .
      973       end.
      974   end.
      975   end procedure.
      976   procedure schedule-attr-delete :
      977   do
      978   on error undo, return error
      979   :
      980   define input  parameter p-cre-db-num  as integer   no-undo.
      981   define input  parameter p-task-type   as character no-undo.
      982   define input  parameter p-task-num    as integer   no-undo.
      983   define input  parameter p-code        as character no-undo.
      984   define output parameter p-deleted     as logical   no-undo.
      985       define buffer buf_schedule-attr for ub.schedule-attr .
      986       define variable v-type              as character                no-undo.
      987       define variable v-format            as character                no-undo.
      988       define variable v-label             as character                no-undo.
      989       define variable v-user-can-edit     as logical                  no-undo.
      990       define variable v-output-display    as logical                  no-undo.
      991       define variable v-other             as character                no-undo.
      992       run schedule-attr-name in this-procedure (
      993             input p-code
      994           , output v-type
      995           , output v-format
      996           , output v-label
      997           , output v-user-can-edit
      998           , output v-output-display
      999           , output v-other
     1000       ) no-error .
     1001       if error-status :error
     1002       then do:
     1003           undo, return error return-value .
     1004       end.
     1005       find first buf_schedule-attr exclusive-lock
     1006            where buf_schedule-attr.cre-db-num = p-cre-db-num
     1007              and buf_schedule-attr.task-type  = p-task-type
     1008              and buf_schedule-attr.task-num   = p-task-num
     1009              and buf_schedule-attr.attr-code  = p-code
     1010       no-error.
     1011       if not available buf_schedule-attr
     1012       then do:
     1013           assign
     1014               p-deleted = no
     1015           .
     1016       end.
     1017       else do:
     1018           delete buf_schedule-attr.
     1019           assign
     1020               p-deleted = yes
     1021           .
     1022       end.
     1023   end.
     1024   end procedure.
     1025   procedure schedule-attr-news :
     1026   do
     1027   on error undo, return error
     1028   :
     1029       define input  parameter p-code           as character no-undo .
     1030       define output parameter p-news           as logical   no-undo .
     1031       if index(p-code, chr(4)) > 0 then do:
     1032         p-code = entry(1, p-code, chr(4)).
     1033       end.
     1034       case p-code :
     1035               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
     1036               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
     1037               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
     1038               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
     1039               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
     1040               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
     1041               when 'schedule-filter':U then do:     assign     p-news = false.   end.
     1042               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
     1043               when 'schd-free-id':U then do:     assign     p-news = false.   end.
     1044         otherwise do:
     1045           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
     1046         end.
     1047       end.
     1048   end.
     1049   end procedure.
     1050   procedure schedule-attr-extract-logical :
     1051   do
     1052   on error undo, return error
     1053   :
     1054   define input  parameter p-parameter-number   as integer      no-undo.
     1055   define input  parameter p-parameter-list     as character    no-undo.
     1056   define output parameter p-parameter-value   as logical      no-undo.
     1057       if num-entries( p-parameter-list ) > p-parameter-number - 1
     1058       then do:
     1059           assign
     1060               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
     1061           .
     1062       end.
     1063       else do:
     1064           assign
     1065               p-parameter-value   = no
     1066           .
     1067       end.
     1068   end.
     1069   end procedure.
     1070   procedure schedule-attr-get-free-id :
     1071   do
     1072   on error undo, return error return-value
     1073   :
     1074     define input  parameter p-cre-db-num  as integer   no-undo.
     1075     define input  parameter p-task-type   as character no-undo.
     1076     define input  parameter p-task-num    as integer   no-undo.
     1077     define output parameter p-free-id     as character no-undo.
     1078     define buffer buf_schedule-attr for ub.schedule-attr.
     1079     find first buf_schedule-attr no-lock
     1080         where buf_schedule-attr.cre-db-num = p-cre-db-num
     1081           and buf_schedule-attr.task-type  = p-task-type
     1082           and buf_schedule-attr.task-num   = p-task-num
     1083           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
     1084     no-error .
     1085     if available buf_schedule-attr then
     1086     assign
     1087     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
     1088     no-error
     1089     .
     1090   end.
     1091   end procedure.
     1092   procedure schedule-attr-get-free-props :
     1093     define input parameter p-free-id as character no-undo .
     1094     define output parameter p-value as character no-undo .
     1095     define buffer buf_temp-schedule-free for temp-schedule-free.
     1096     do
     1097     on error undo, return error return-value
     1098     :
     1099       find first buf_temp-schedule-free no-lock no-error .
     1100       if not available buf_temp-schedule-free then do:
     1101         run schedule-attr-fill-free-props in this-procedure .
     1102       end.
     1103       find first buf_temp-schedule-free where
     1104               buf_temp-schedule-free.free-id = p-free-id no-error.
     1105       if available buf_temp-schedule-free then do:
     1106         assign
     1107         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
     1108                   buf_temp-schedule-free.proc-run-name        + chr(4) +
     1109                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
     1110                   buf_temp-schedule-free.conf-param           + chr(4) +
     1111                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
     1112                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
     1113                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
     1114                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
     1115                   buf_temp-schedule-free.other-info
     1116         .
     1117       end.
     1118       else do:
     1119        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
     1120                              "id произвольной задачи - &5"
     1121                              ,vss-workfile
     1122                              ,vss-revision
     1123                              ,vss-description
     1124                              ,chr(10)
     1125                              ,p-free-id).
     1126       end.
     1127     end.
     1128   end procedure.
     1129   procedure schedule-attr-is-rum-free-id :
     1130   define input parameter p-free-id as character no-undo .
     1131   define output parameter p-is-rum as logical no-undo .
     1132   define buffer buf_temp-schedule-free for temp-schedule-free.
     1133   do
     1134   on error undo, return error
     1135   :
     1136       find first buf_temp-schedule-free no-lock no-error .
     1137       if not available buf_temp-schedule-free then do:
     1138         run schedule-attr-fill-free-props in this-procedure .
     1139       end.
     1140       find first buf_temp-schedule-free where
     1141               buf_temp-schedule-free.free-id = p-free-id no-error.
     1142       if available buf_temp-schedule-free
     1143       and buf_temp-schedule-free.is-rum
     1144       then do:
     1145         p-is-rum = yes.
     1146       end.
     1147   end.
     1148   end procedure.
     1149   procedure schedule-attr-fill-free-props :
     1150   define variable v-path                    as character                no-undo .
     1151   DEFINE VARIABLE v-full-path               as character                no-undo .
     1152   DEFINE VARIABLE v-file-name               as character                no-undo .
     1153   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
     1154   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
     1155   define buffer buf_temp-schedule-free for temp-schedule-free.
     1156   define variable v-answer as logical no-undo .
     1157     do
     1158     on error undo, return error substitute("&1 &2 &3&4&5&4"
     1159                                           ,vss-workfile
     1160                                           ,vss-revision
     1161                                           ,vss-description
     1162                                           ,chr(10)
     1163                                           ,error-status:get-message(1) )
     1164     :
     1165       run gbl/filename.p (
     1166                       input 'cmp/shd-free.d'
     1167                     ,output v-full-path
     1168                     ,output v-path
     1169                     ,output v-file-name
     1170                     ,output v-file-name-no-ext
     1171                     ,output v-file-name-ext
     1172                     ) .
     1173       input from value(v-full-path).
     1174       repeat :
     1175         create buf_temp-schedule-free.
     1176         import buf_temp-schedule-free.
     1177       END.
     1178       input close.
     1179       _ff:
     1180       for each buf_temp-schedule-free :
     1181         if buf_temp-schedule-free.free-id = '':U then do:
     1182            delete buf_temp-schedule-free.
     1183            next _ff.
     1184          end.
     1185          run schedule-attr-check-enc in this-procedure (
     1186                                                       input  buf_temp-schedule-free.free-id
     1187                                                      ,input  (buf_temp-schedule-free.proc-run-name +
     1188                                                               buf_temp-schedule-free.proc-param-edit-name +
     1189                                                               buf_temp-schedule-free.conf-param +
     1190                                                               string(buf_temp-schedule-free.is-gbd) +
     1191                                                               string(buf_temp-schedule-free.is-ubd) +
     1192                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
     1193                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
     1194                                                               string(buf_temp-schedule-free.other-info)
     1195                                                               )
     1196                                                       ,input  buf_temp-schedule-free.enc-key
     1197                                                       ,output v-answer    ) no-error .
     1198          if error-status:error
     1199          or not v-answer then delete buf_temp-schedule-free.
     1200        end.
     1201     end.
     1202   end procedure.
     1203   Function schedule-attr-reverse returns character (str as character).
     1204      define variable rev_incl_s as character init "" no-undo .
     1205      define variable rev_incl_i as integer no-undo .
     1206      define variable rev_incl_l as integer no-undo .
     1207      rev_incl_l = length(str).
     1208      do rev_incl_i = 1 to rev_incl_l:
     1209         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
     1210      end.
     1211      return rev_incl_s.
     1212   end.
     1213   procedure schedule-attr-check-enc.
     1214     define input  parameter p-free-id   as character no-undo .
     1215     define input  parameter p-value     as character no-undo .
     1216     define input  parameter p-enc-value as character no-undo .
     1217     define output parameter p-answer    as logical   no-undo .
     1218     define variable tmp         as character no-undo .
     1219     define variable v-enc-value as character no-undo .
     1220     assign
     1221     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
     1222     .
     1223     run schedule-attr-pswd-enc in this-procedure
     1224       ( input tmp
     1225        ,output v-enc-value
     1226       ) no-error .
     1227     if error-status:error then do:
     1228       message
     1229         vss-workfile vss-revision vss-description skip
     1230         "Ошибка при вызове процедуры pswd-enc" skip
     1231         return-value skip
     1232         error-status :get-message(1) skip
     1233         view-as alert-box error .
     1234       undo, return error .
     1235     end.
     1236     if v-enc-value = p-enc-value then do:
     1237       assign
     1238         p-answer = true
     1239       .
     1240     end.
     1241     else do:
     1242       assign
     1243         p-answer = false
     1244       .
     1245     end.
     1246   end.
     1247   procedure schedule-attr-conf-enc.
     1248     define input  parameter p-free-id   as character no-undo .
     1249     define input  parameter p-value     as character no-undo .
     1250     define output parameter p-enc-value as character no-undo .
     1251     define variable tmp         as character no-undo .
     1252     assign
     1253       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
     1254     .
     1255     run schedule-attr-pswd-enc in this-procedure
     1256       ( input tmp
     1257        ,output p-enc-value
     1258       ) no-error .
     1259     if error-status:error then do:
     1260       message
     1261         vss-workfile vss-revision vss-description skip
     1262         "Ошибка при вызове процедуры pswd-enc" skip
     1263         return-value skip
     1264         error-status :get-message(1) skip
     1265         view-as alert-box error .
     1266       undo, return error .
     1267     end.
     1268   end procedure.
     1269   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1270   procedure schedule-attr-pswd-enc :
     1271     define input parameter  pswd     as character no-undo .
     1272     define output parameter enc-pswd as character no-undo .
     1273     do
     1274     on error undo, return error return-value
     1275     :
     1276       assign
     1277         enc-pswd = encode(pswd + string(index(pswd, "k")))
     1278       .
     1279     end.
     1280   end procedure.
