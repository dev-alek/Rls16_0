     1804        self :read-only = false
     1805        )
     1806     then do:
     1807       if self :handle <> focus :handle
     1808       then do:
     1809         apply "entry":u to self .
     1810       end.
     1811       run gbl/getcurdt.p
     1812         (output v-curr-sv-date
     1813         ) .
     1814       assign
     1815         self :screen-value = string(v-curr-sv-date) .
     1816       .
     1817     end.
     1818     return no-apply.
     1819   end.
     1820   on ctrl-b of date-from in frame Dialog-Frame
     1821   do:
     1822     if (can-query (self, "sensitive")
     1823        and
     1824        self :sensitive = true
     1825        )
     1826     or (can-query (self, "read-only")
     1827        and
     1828        self :read-only = false
     1829        )
     1830     then do:
     1831       if self :handle <> focus :handle
