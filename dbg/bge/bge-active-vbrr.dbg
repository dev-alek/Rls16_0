     1843           (output v-curr-sv-date
     1844           ) .
     1845       end.
     1846       if v-curr-sv-date <> ?
     1847       then do:
     1848         assign
     1849           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1850         .
     1851         assign
     1852           self :screen-value = string(v-new-sv-date) .
     1853         .
     1854       end.
