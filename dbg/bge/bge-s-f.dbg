      579   ON CHOOSE OF bt-sel-host IN FRAME Dialog-Frame
      580   DO:
      581       assign
      582         rs-1 :screen-value  = "2"
      583       .
      584       define buffer buf_user-host for ub.user-host .
      585       define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      586       find first buf_user-host no-lock
      587         where buf_user-host.db-num    = v-cntxt-db-num
      588           and buf_user-host.user-id   = v-cntxt-userid
      589           and buf_user-host.host-code = v-cntxt-host-code-obj
      590         no-error .
      591       if available buf_user-host
      592       then do:
      593         run userhsts_clear in this-procedure .
      594         run userhsts_append in this-procedure
      595           (input v-cntxt-host-code-obj
      596           ) .
      597       end.
      598       define variable v-user-select as logical   no-undo .
      599   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      600   run userhsts_select-many in this-procedure
      601     (input  parparentproc
      602     ,input  v-cntxt-db-num
      603     ,input  v-cntxt-userid
      604     ,input  v-cntxt-host-code-obj
      605     ,output v-user-select
      606     )  .
      607       if v-user-select <> true
      608       then do:
      609         return no-apply .
      610       end.
      611       run clear-obj-list in this-procedure .
      612       for each buf_userhsts_temp-user-host
      613       :
      614         run fill-obj-list in this-procedure
      615           (input buf_userhsts_temp-user-host.host-code
      616           ) no-error .
      617         if error-status :error
      618         then do:
      619           return no-apply.
      620         end.
      621       end.
      622       assign
      623         v-obj-list = ""
      624       .
      625       for each temp_obj-list
      626       :
      627         assign
      628           v-obj-list = v-obj-list + (if v-obj-list <> "" then chr(10) else "" )
      629                      + temp_obj-list.obj-type + string( temp_obj-list.obj-code ) + chr(32)
      630                      + temp_obj-list.obj-name
      631         .
      632       end.
      633       assign  ed-object :screen-value = v-obj-list  .
      634   END.
      635   ON CHOOSE OF Btn_Cancel IN FRAME Dialog-Frame
      636   DO:
      637       assign p-cancel = yes .
      638       apply "window-close" to frame Dialog-Frame.
      639   END.
      640   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      641   DO:
      642       ASSIGN
      643           date_from
      644           date_to
      645           rs-1
      646           date_exp_from = date_from
      647           date_exp_to   = date_to
      648       .
      649       if date_from > date_to  then do:
      650           message
      651               "Даты интервала заданы неверно. " skip " Нижняя дата интервала должна быть меньше верхней."
      652               skip(1) "Задайте интервал дат правильно или отмените экспорт."
      653           view-as alert-box information.
      654           apply "entry" to date_from.
      655           undo, return no-apply.
      656       end.
      657       case rs-1 :screen-value  :
      658         when "1" then do:
      659           assign  p-range = 1  p-obj-list = ""  .
      660         end.
      661         when "2" then do:
      662           assign
      663             p-range = 2
      664             p-obj-list = ""
      665           .
      666           for each temp_obj-list :
      667             assign p-obj-list = p-obj-list + ( if p-obj-list = "" then "" else "," ) + temp_obj-list.obj-type
      668                                  + "," + string( temp_obj-list.obj-code ) .
      669           end.
      670         end.
      671       end case.
      672       APPLY "GO" TO FRAME Dialog-Frame.
      673   END.
      674   ON RETURN OF date_from IN FRAME Dialog-Frame
      675   DO:
      676       APPLY "ENTRY" TO date_to IN FRAME Dialog-Frame.
      677       RETURN NO-APPLY.
      678   END.
      679   ON RETURN OF date_to IN FRAME Dialog-Frame
      680   DO:
      681       APPLY "ENTRY" TO btn_OK IN FRAME Dialog-Frame.
      682       RETURN NO-APPLY.
      683   END.
      684   ON VALUE-CHANGED OF rs-1 IN FRAME Dialog-Frame
      685   DO:
      686     run object-select in this-procedure no-error .
      687     if error-status :error then undo, return no-apply.
      688     assign rs-1 .
      689   END.
      690   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      691   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      692   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      693   on help of frame Dialog-Frame
      694   do:
      695     run gbl/app_help.p
      696       (input this-procedure :file-name
      697       ,input ''
      698       ,input ?
      699       ) no-error.
      700     if error-status :error then do:
      701       message
      702         "Ошибка при вызове помощи"
      703         error-status :get-message(1)
      704         view-as alert-box .
      705     end.
      706   end.
      707   run minbtn-set in this-procedure .
      708   on choose of b-help in frame Dialog-Frame
      709   do:
      710     apply "help":u to frame Dialog-Frame .
      711   end.
      712   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      713   procedure minbtn-set :
      714       do
      715           on error undo, return error return-value
      716           :
      717           define variable ii              as integer       no-undo .
      718           define variable fh              as widget-handle no-undo .
      719           define variable hh              as widget-handle no-undo .
      720           define variable v-h             as handle        extent 4 no-undo .
      721           define variable v-name-button   as character     no-undo .
      722           define variable v-help-old-x    as decimal       no-undo .
      723           define variable v-help-old-y    as decimal       no-undo .
      724           define variable v-help-old-size as decimal       no-undo .
      725           define variable v-frame-width   as decimal       no-undo .
      726           define variable jj              as integer       no-undo .
      727           do
      728               on error undo, return error
      729               :
      730               assign
      731                   v-frame-width = frame Dialog-Frame:width - 0.3
      732                   fh            = frame Dialog-Frame:first-child
      733                   hh            = fh:first-child
      734                   ii            = 1
      735                   .
      736               do while valid-handle(hh):
      737                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      738                   do:
      739                       case lc(hh:name) :
      740                           when "b-help" then
      741                               do:
      742                                   hh:load-image-up("cmp/b-help.bmp":u) .
      743                                   hh:load-image-down("cmp/b-help.bmp":u) .
      744                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      745                                   hh:TOOLTIP = "Помощь" .
      746                                   v-help-old-x = hh:column .
      747                                   v-help-old-y = hh:row    .
      748                                   v-help-old-size = hh:width .
      749                                   hh:width-chars = 2.5 .
      750                               end.
      751                           when "b-print" then
      752                               do:
      753                                   hh:load-image("cmp/b-print.bmp":u) .
      754                                   hh:TOOLTIP = "Печать" .
      755                                   v-h[ii] = hh:handle .
      756                                   ii = ii + 1 .
      757                                   hh:width-chars = 3 .
      758                               end.
      759                           when "b-history" or
      760                           when "b-hist" then
      761                               do:
      762                                   hh:load-image("cmp/b-hist.bmp":u) .
      763                                   hh:TOOLTIP = "История" .
      764                                   v-h[ii] = hh:handle .
      765                                   ii = ii + 1 .
      766                                   hh:width-chars = 3 .
      767                               end.
      768                           when "b-sch" then
      769                               do:
      770                                   hh:load-image("cmp/b-sch.bmp":u) .
      771                                   hh:TOOLTIP = "Установка Фильтра" .
      772                                   v-h[ii] = hh:handle .
      773                                   ii = ii + 1 .
      774                                   hh:width-chars = 3 .
      775                               end.
      776                           when "b-hist-user" then
      777                               do:
      778                                   hh:load-image("cmp/b-hist.bmp":u) .
      779                                   hh:TOOLTIP = "История пользователя" .
      780                                   ii = ii + 1 .
      781                               end.
      782                       end case.
      783                   end.
      784                   hh = hh:next-sibling.
      785               end.
      786               b-help:column = v-frame-width - b-help:width-chars.
      787               jj = 0.
      788               repeat ii = 4 to 1 by -1 :
      789                   if valid-handle (v-h[ii] ) then
      790                   do:
      791                       jj  = jj + 1 .
      792                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      793                       v-h[ii]:row    = v-help-old-y .
      794                   end.
      795               end.
      796           end.
      797       end.
      798   end procedure.
      799   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
