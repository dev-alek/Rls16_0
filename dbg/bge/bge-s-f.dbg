     1206     define MENU m-ed-date9
     1207       MENU-ITEM m-ed-date9-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1208       MENU-ITEM m-ed-date9-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1209       MENU-ITEM m-ed-date9-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1210       MENU-ITEM m-ed-date9-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1211       .
     1212     if date_to :POPUP-MENU in frame Dialog-Frame = ?
     1213     then do:
     1214       ASSIGN
     1215         date_to :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date9 :HANDLE
     1216         date_to :MENU-MOUSE in frame Dialog-Frame = 3
     1217       .
     1218     end.
     1219     define variable v-label-handle9 as handle no-undo .
     1220     assign
     1221       v-label-handle9 = date_to :side-label-handle in frame Dialog-Frame
     1222     .
     1223     if valid-handle (v-label-handle9)
     1224     then do:
     1225       if v-label-handle9 :tooltip = ""
     1226       or v-label-handle9 :tooltip = ?
     1227       then do:
     1228         assign
     1229           v-label-handle9 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1230         .
     1231       end.
     1232     end.
     1233     ON CHOOSE OF MENU-ITEM m-ed-date9-1 in menu m-ed-date9 DO:
     1234       apply "ctrl-b":U to date_to in frame Dialog-Frame .
     1235     END.
     1236     ON CHOOSE OF MENU-ITEM m-ed-date9-2 in menu m-ed-date9 DO:
     1237       apply "ctrl-d":U to date_to in frame Dialog-Frame .
     1238     END.
     1239     ON CHOOSE OF MENU-ITEM m-ed-date9-3 in menu m-ed-date9 DO:
     1240       apply "ctrl-e":U to date_to in frame Dialog-Frame .
     1241     END.
     1242     ON CHOOSE OF MENU-ITEM m-ed-date9-4 in menu m-ed-date9 DO:
     1243       apply "ctrl-f":U to date_to in frame Dialog-Frame .
     1244     END.
     1245   run cur-time in this-procedure ( output v-today, output v-time ).
     1246   ASSIGN
     1247       date_from = v-today
     1248       date_to   = v-today
     1249   .
     1250   MAIN-BLOCK:
     1251   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1252      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1253   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1254     run mainmenu_getcntxt in parparentproc
     1255       (output v-cntxt-db-num
     1256       ,output v-cntxt-userid
     1257       ,output v-cntxt-level
     1258       ,output v-cntxt-host-code-obj
     1259       ,output v-cntxt-obj-type
     1260       ,output v-cntxt-obj-code
     1261       ,output v-cntxt-db-num-obj
     1262       ,output v-cntxt-is-admin
     1263       ) .
     1264       run get-host-name in this-procedure ( output v-host-name ) no-error .
     1265       if error-status :error
     1266       then do:
     1267           message
     1268             vss-workfile vss-revision vss-description
     1269             skip "Ошибка при определении имени фирмы"
     1270             skip "Код фирмы:" v-cntxt-host-code-obj
     1271             skip "Имя фирмы будет отображаться как '" + 'орг':U + string( v-cntxt-host-code-obj ) + "'"
     1272             skip return-value
     1273             skip trim(error-status :get-message(1))
     1274                  trim(error-status :get-message(2))
     1275                  trim(error-status :get-message(3))
     1276                  trim(error-status :get-message(4))
     1277                  trim(error-status :get-message(5))
     1278           view-as alert-box warning.
     1279           assign
     1280               v-host-name = 'орг':U + string( v-cntxt-host-code-obj )
     1281           .
     1282       end.
     1283     RUN enable_UI.
     1284      run init-fields in this-procedure .
     1285     WAIT-FOR GO OF FRAME Dialog-Frame.
     1286   END.
     1287   RUN disable_UI.
     1288   PROCEDURE clear-obj-list :
     1289     define buffer buf_temp_obj-list for temp_obj-list .
     1290     do
     1291     on error undo, return error return-value
     1292     :
     1293       for each buf_temp_obj-list
     1294       on error undo, return error return-value
     1295       :
     1296         delete buf_temp_obj-list .
     1297       end.
     1298     end.
     1299   END PROCEDURE.
     1300   PROCEDURE disable_UI :
     1301     HIDE FRAME Dialog-Frame.
     1302   END PROCEDURE.
     1303   PROCEDURE enable_UI :
     1304     DISPLAY date_from date_to rs-1 ed-object
     1305         WITH FRAME Dialog-Frame.
     1306     ENABLE RECT-1 Btn_OK Btn_Cancel b-help date_from date_to rs-1 bt-sel-host
     1307         WITH FRAME Dialog-Frame.
     1308     VIEW FRAME Dialog-Frame.
     1309   END PROCEDURE.
     1310   PROCEDURE fill-obj-list :
     1311     define input  parameter p-host-code as integer   no-undo .
     1312     do
     1313     on error undo, return error
     1314     :
     1315       define buffer buf_clients for ub.clients.
     1316       find first buf_clients no-lock
     1317         where buf_clients.obj-type = 'орг':U
     1318           and buf_clients.obj-code = p-host-code
     1319         no-error .
     1320       if not available buf_clients
     1321       then do:
     1322         message
     1323           vss-workfile vss-revision vss-description skip
     1324           "Ошибка задания входных параметров" skip
     1325           "Не найдена фирма с кодом" p-host-code skip
     1326           view-as alert-box error .
     1327         undo, return error return-value .
     1328       end.
     1329       create temp_obj-list.
     1330       assign
     1331         temp_obj-list.obj-type = buf_clients.obj-type
     1332         temp_obj-list.obj-code = buf_clients.obj-code
     1333         temp_obj-list.obj-name = buf_clients.obj-name
     1334       .
     1335     end.
     1336   END PROCEDURE.
     1337   PROCEDURE get-host-name :
     1338   do
     1339   on error undo, return error
     1340   :
     1341   define output parameter p-host-name as character    no-undo.
     1342   define buffer buf_clients   for ub.clients.
     1343       find first buf_clients no-lock
     1344            where buf_clients.obj-type = 'орг':U
     1345              and buf_clients.obj-code = v-cntxt-host-code-obj
     1346       no-error.
     1347       if not available buf_clients
     1348       then do:
     1349           message
     1350             vss-workfile vss-revision vss-description
     1351             skip "Не удалось найти текущую фирму"
     1352             skip return-value
     1353             skip trim(error-status :get-message(1))
     1354                  trim(error-status :get-message(2))
     1355                  trim(error-status :get-message(3))
     1356                  trim(error-status :get-message(4))
     1357                  trim(error-status :get-message(5))
     1358           view-as alert-box error.
     1359           undo, return error .
     1360       end.
     1361       else do:
     1362           assign
     1363               p-host-name = buf_clients.obj-name
     1364           .
     1365       end.
     1366   end.
     1367   END PROCEDURE.
     1368   PROCEDURE init-fields :
     1369     do on error undo, return error :
     1370       define variable g-log as logical   no-undo .
     1371   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1372   do:
     1373     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1374       (input  v-cntxt-db-num
     1375       ,input  v-cntxt-userid
     1376       ,input  0
     1377       ,input  'actn_schet-fact-doc_export':U
     1378       ,input  'firm':U
     1379       ,input  v-cntxt-host-code-obj
     1380       ,input  '':U
     1381       ,input  0
     1382       ,input  0
     1383       ,input  0
     1384       ,input  0
     1385       ,input  true
     1386       ,output g-log
     1387       )  .
     1388   end.
     1389       if not g-log then  return error .
     1390       define buffer buf_user-host for ub.user-host.
     1391       find first buf_user-host no-lock
     1392         where buf_user-host.db-num    = v-cntxt-db-num
     1393           and buf_user-host.user-id   = v-cntxt-userid
     1394           and buf_user-host.host-code = v-cntxt-host-code-obj
     1395         no-error .
     1396       if available buf_user-host
     1397       then do:
     1398          run clear-obj-list in this-procedure .
     1399          run fill-obj-list in this-procedure
     1400            (input  buf_user-host.host-code
     1401            ) no-error .
     1402       end.
     1403       do with frame Dialog-Frame
     1404       :
     1405         assign
     1406           rs-1      :screen-value = "2"
     1407           ed-object :screen-value = 'орг':U + string( v-cntxt-host-code-obj ) + " " + v-host-name
     1408         .
     1409       end.
     1410       assign rs-1  .
     1411       display rs-1  with frame Dialog-Frame  .
     1412     end.
     1413   END PROCEDURE.
     1414   PROCEDURE object-select :
     1415   do
     1416   on error undo, return error
     1417   :
     1418   case rs-1 :screen-value in frame Dialog-frame
     1419   :
     1420       when "1"
     1421       then do:
     1422           assign
     1423               ed-object :screen-value = ""
     1424           .
     1425       end.
     1426       when "2"
     1427       then do:
     1428           for each temp_obj-list
     1429           :
     1430               delete temp_obj-list.
     1431           end.
     1432           create temp_obj-list.
     1433           assign
     1434               temp_obj-list.obj-type  = 'орг':U
     1435               temp_obj-list.obj-code  = v-cntxt-host-code-obj
     1436               ed-object :screen-value = temp_obj-list.obj-type + string(temp_obj-list.obj-code) + chr(32) + "(":U + v-host-name + ")":U
     1437           .
     1438       end.
     1439   end case.
     1440   end.
     1441   END PROCEDURE.
