        1   DEFINE INPUT  PARAMETER parparentproc        AS WIDGET-HANDLE        NO-UNDO.
        2   define output parameter date_exp_from       as date      INIT ?     no-undo.
        3   define output parameter date_exp_to         as date      INIT ?     no-undo.
        4   define output parameter p-range             as integer              no-undo.
        5   define output parameter p-obj-list          as character            no-undo.
        6   define output parameter p-cancel            as logical   INIT no    no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Выбор параметров для выгрузки счетов-фактур.".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   procedure proc-alt-shift-f2:
       72     if not ibs.th.gbl.gbl-var:rcode
       73   then
       74     run gbl\inidebug.p .
       75   end.
       76   procedure proc-alt-shift-f3:
       77     run gbl/prvssinf.p
       78       ( input this-procedure
       79       ) .
       80   end.
       81   define variable v-inform-launched as logical no-undo initial false .
       82   procedure proc-alt-shift-f4:
       83     define variable v-action as character no-undo .
       84     if v-inform-launched = false then do:
       85       assign
       86         v-inform-launched = true
       87       .
       88       run gbl/d-inform.w
       89         (  input self
       90         ,  input this-procedure
       91         , output v-action
       92         ) no-error .
       93       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       94       assign
       95         v-inform-launched = false
       96       .
       97     end.
       98   end.
       99   procedure proc-alt-f1:
      100     run gbl/corrhelp.p
      101       (input this-procedure
      102       ) .
      103   end .
      104   on alt-shift-f2 anywhere do:
      105     run proc-alt-shift-f2.
      106   end.
      107   on alt-shift-f3 anywhere do:
      108     run proc-alt-shift-f3 in this-procedure .
      109   end.
      110   on alt-shift-f4 anywhere do:
      111     run proc-alt-shift-f4 in this-procedure.
      112   end.
      113   on alt-f1 anywhere do:
      114     run proc-alt-f1 in this-procedure .
      115   end.
      116   define new global shared variable g#library  as handle no-undo .
      117   define new global shared variable g#library2 as handle no-undo .
      118   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119   procedure cur-time :
      120      define output parameter p-today as date      no-undo .
      121      define output parameter p-time  as integer   no-undo .
      122     do
      123     on error undo, return error
      124     :
      125       define variable v-date1 as date      no-undo .
      126       define variable v-date2 as date      no-undo .
      127       define variable v-time  as integer   no-undo .
      128       assign
      129         v-date1 = today
      130         v-time  = time
      131         v-date2 = today
      132       .
      133       if v-date1 <> v-date2
      134       then do:
      135         assign
      136           v-date1 = today
      137           v-time  = v-time
      138         .
      139       end.
      140       assign
      141         p-today = v-date1
      142         p-time  = v-time
      143       .
      144     end.
      145   end.
      146   function cur-time-date returns character
      147   :
      148     return string(today, '99/99/9999':U) .
      149   end.
      150   function cur-time-mjd returns decimal
      151   :
      152     define variable v-date as date      no-undo .
      153     define variable v-time as integer   no-undo .
      154     run cur-time in this-procedure
      155       (output v-date
      156       ,output v-time
      157       ) .
      158     return integer(v-date) - 2400002 + (v-time / 86400) .
      159   end.
      160   function cur-time-get-ending-index returns integer
      161   (input p-number as integer
      162   )
      163   :
      164     if p-number < 0
      165     or p-number = ?
      166     then do:
      167       return 1 .
      168     end.
      169     define variable v-rest as integer   no-undo .
      170     assign
      171       p-number = p-number modulo 100
      172     .
      173     if p-number < 20
      174     then do:
      175       assign
      176         v-rest = p-number
      177       .
      178     end.
      179     else do:
      180       assign
      181         v-rest = p-number modulo 10
      182       .
      183     end.
      184     case v-rest :
      185       when 1
      186       then do:
      187         return 2 .
      188       end.
      189       when 2 or
      190       when 3 or
      191       when 4
      192       then do:
      193         return 3 .
      194       end.
      195       otherwise do:
      196         return 1 .
      197       end.
      198     end case .
      199   end.
      200   procedure cur-time-mjd-to-date :
      201      define input  parameter i-mjd-diff as decimal no-undo.
      202      define output parameter o-Date     as date    no-undo.
      203      define output parameter o-Time     as integer no-undo.
      204      define variable v-day-number as integer   no-undo .
      205      if    i-mjd-diff < 0
      206         or i-mjd-diff = ?
      207      then do:
      208         return "?" .
      209      end.
      210      assign
      211         v-day-number = truncate(i-mjd-diff,0).
      212         o-Date = date(v-day-number + 2400002).
      213         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      214     .
      215   end.
      216   function cur-time-mjd-to-string returns character
      217   (input p-mjd-diff as decimal
      218   )
      219   :
      220     define variable v-day-number as integer   no-undo .
      221     define variable v-seconds    as integer   no-undo .
      222     define variable v-hour       as integer   no-undo .
      223     define variable v-min        as integer   no-undo .
      224     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      225     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      226     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      227     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      228     if p-mjd-diff < 0
      229     or p-mjd-diff = ?
      230     then do:
      231       return "?" .
      232     end.
      233     assign
      234       v-day-number = integer(truncate(p-mjd-diff,0))
      235       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      236     .
      237     if v-seconds > 86400
      238     then do:
      239       assign
      240         v-seconds = 86400 - 1
      241       .
      242     end.
      243     if v-seconds < 0
      244     then do:
      245       assign
      246         v-seconds = 0
      247       .
      248     end.
      249     assign
      250       v-hour = truncate(v-seconds / 3600, 0)
      251     .
      252     assign
      253       v-seconds = v-seconds modulo 3600
      254     .
      255     assign
      256       v-min = truncate(v-seconds / 60, 0)
      257     .
      258     assign
      259       v-seconds = v-seconds modulo 60
      260     .
      261     return
      262         (if v-day-number <> 0
      263           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      264           else ""
      265         )
      266       + (if v-day-number <> 0 or v-hour <> 0
      267           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      268           else ""
      269         )
      270       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      271           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      272           else ""
      273         )
      274       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      275       .
      276   end.
      277   function cur-time-string returns character
      278   :
      279     define variable v-date as date      no-undo .
      280     define variable v-time as integer   no-undo .
      281     run cur-time in this-procedure
      282       (output v-date
      283       ,output v-time
      284       ) .
      285     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      286   end.
      287   function cur-time-string-sec returns character
      288   :
      289     define variable v-date as date      no-undo .
      290     define variable v-time as integer   no-undo .
      291     run cur-time in this-procedure
      292       (output v-date
      293       ,output v-time
      294       ) .
      295     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      296   end.
      297   function cur-time-custom  returns character
      298   (input p-prefix as character
      299   ,input p-date-format as character
      300   ,input p-delimiter as character
      301   ,input p-time-format as character
      302   ,input p-suffix as character
      303   )
      304   :
      305     define variable v-date as date      no-undo .
      306     define variable v-time as integer   no-undo .
      307     run cur-time in this-procedure
      308       (output v-date
      309       ,output v-time
      310       ) .
      311     return
      312       p-prefix
      313       + string(v-date, p-date-format)
      314       + p-delimiter
      315       + string(v-time, p-time-format)
      316       + p-suffix
      317       .
      318   end.
      319   function cur-time-print  returns character
      320   :
      321     define variable v-date as date      no-undo .
      322     define variable v-time as integer   no-undo .
      323     run cur-time in this-procedure
      324       (output v-date
      325       ,output v-time
      326       ) .
      327     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      328   end.
      329   function cur-time-datetime returns datetime
      330   :
      331     define variable v-char as character no-undo .
      332     define variable v-datetime as datetime no-undo .
      333     v-char = cur-time-string().
      334     v-datetime = datetime(v-char).
      335     return  v-datetime.
      336   end.
      337   function cur-time-string-msec returns character
      338   :
      339     define variable v-date as datetime  no-undo .
      340     v-date = now.
      341     return string(v-date) .
      342   end.
      343   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      344     define variable v-cntxt-db-num        as integer   no-undo .
      345     define variable v-cntxt-userid        as character no-undo .
      346     define variable v-cntxt-level         as character no-undo .
      347     define variable v-cntxt-host-code-obj as integer   no-undo .
      348     define variable v-cntxt-obj-type      as character no-undo .
      349     define variable v-cntxt-obj-code      as integer   no-undo .
      350     define variable v-cntxt-db-num-obj    as integer   no-undo .
      351     define variable v-cntxt-is-admin      as logical   no-undo .
      352   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      353   define temp-table userhsts_temp-user-host no-undo
      354     field host-code as integer
      355     index xpk is primary unique host-code
      356     .
      357   procedure userhsts_clear :
      358     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      359     do
      360     on error undo, return error return-value
      361     :
      362       for each buf_userhsts_temp-user-host
      363       on error undo, return error return-value
      364       :
      365         delete buf_userhsts_temp-user-host .
      366       end.
      367     end.
      368   end procedure.
      369   procedure userhsts_object-count :
      370     define output parameter p-total-count as integer   no-undo .
      371     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      372     do
      373     on error undo, return error return-value
      374     :
      375       assign
      376         p-total-count = 0
      377       .
      378       for each buf_userhsts_temp-user-host
      379       on error undo, return error return-value
      380       :
      381         assign
      382           p-total-count = p-total-count + 1
      383         .
      384       end.
      385     end.
      386   end procedure.
      387   procedure userhsts_append :
      388     define input  parameter p-host-code as integer   no-undo .
      389     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      390     do
      391     on error undo, return error return-value
      392     :
      393       find first buf_userhsts_temp-user-host
      394         where buf_userhsts_temp-user-host.host-code = p-host-code
      395         no-error .
      396       if not available buf_userhsts_temp-user-host
      397       then do:
      398         create buf_userhsts_temp-user-host .
      399         assign
      400           buf_userhsts_temp-user-host.host-code = p-host-code
      401         .
      402       end.
      403     end.
      404   end procedure.
      405   procedure userhsts_object-exist :
      406     define output parameter p-object-exist as logical   no-undo .
      407     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      408     do
      409     on error undo, return error return-value
      410     :
      411       find first buf_userhsts_temp-user-host
      412         no-error .
      413       if not available buf_userhsts_temp-user-host
      414       then do:
      415         assign
      416           p-object-exist = false
      417         .
      418       end.
      419       else do:
      420         assign
      421           p-object-exist = true
      422         .
      423       end.
      424     end.
      425   end procedure.
      426   procedure userhsts_transfer :
      427     define input  parameter p-callback-handle as handle no-undo .
      428     define variable vss-description as character no-undo init "userhsts_transfer: Передача списка объектов".
      429     define buffer buf_userhsts_temp-user-host for userhsts_temp-user-host .
      430     do
      431     on error undo, return error return-value
      432     :
      433       if valid-handle(p-callback-handle) <> true
      434       then do:
      435         message
      436           vss-workfile vss-revision vss-description skip
      437           "Ошибка задания входных параметров" skip
      438           "Неизвестный указатель на процедуру" skip
      439           view-as alert-box error .
      440         undo, return error return-value .
      441       end.
      442       if p-callback-handle :get-signature("userhsts_append") = ""
      443       then do:
      444         message
      445           vss-workfile vss-revision vss-description skip
      446           "Ошибка задания входных параметров" skip
      447           substitute("В процедуре &1 не найдена внутренняя процедура userhsts_append"
      448                     ,p-callback-handle :file-name
      449                     ) skip
      450           view-as alert-box error .
      451         undo, return error return-value .
      452       end.
      453       for each buf_userhsts_temp-user-host
      454       on error undo, return error return-value
      455       :
      456         run userhsts_append in p-callback-handle
      457           (input  buf_userhsts_temp-user-host.host-code
      458           ) .
      459       end.
      460     end.
      461   end procedure.
      462   procedure userhsts_select-one :
