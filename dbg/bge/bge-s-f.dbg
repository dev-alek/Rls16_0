      983     define MENU m-ed-date7
      984       MENU-ITEM m-ed-date7-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      985       MENU-ITEM m-ed-date7-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      986       MENU-ITEM m-ed-date7-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      987       MENU-ITEM m-ed-date7-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      988       .
      989     if date_from :POPUP-MENU in frame Dialog-Frame = ?
      990     then do:
      991       ASSIGN
      992         date_from :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date7 :HANDLE
      993         date_from :MENU-MOUSE in frame Dialog-Frame = 3
      994       .
      995     end.
      996     define variable v-label-handle7 as handle no-undo .
