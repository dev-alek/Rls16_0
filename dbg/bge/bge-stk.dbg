     1081   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1082                                             INPUT iFlagEmpty AS INTEGER).
     1083       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1084       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1085           DO:
     1086               IF iFlagEmpty = 0                           THEN RETURN "".
     1087               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1088               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1089               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1090               ELSE RETURN "".
     1091           END.
     1092       ELSE DO:
     1093           run xmlchar-encode in this-procedure (
     1094                 input sToPlace
     1095               , output sToPlace
     1096           ).
     1097           ASSIGN
     1098               sToPlace = sParName + '="' + sToPlace + '"'
     1099           .
     1100           RETURN sToPlace.
     1101       END.
     1102   END FUNCTION.
     1103   function bge-xml-date returns character
     1104   ( input p-date as date )
     1105   :
     1106     define variable v-date-str as character no-undo .
     1107     run bge-xml-date-to-str in this-procedure ( input   p-date
     1108                                               , output  v-date-str
     1109                                               ) .
     1110     return v-date-str.
     1111   end function.
     1112   function bge-xml-str-date returns character
     1113   ( input p-date-str as character )
     1114   :
     1115     define variable v-date-str as character no-undo .
     1116     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1117                                                   , output  v-date-str
     1118                                                   ) .
     1119     return v-date-str.
     1120   end function.
     1121   function bge-xml-normalize-dec returns decimal
     1122   ( input p-val as decimal )
     1123   :
     1124     return (if p-val = ? then 0 else p-val) .
     1125   end function.
     1126   PROCEDURE wp-XMLTagOpen:
     1127   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1128   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1129   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1130       define variable v-out-string    as character    no-undo.
     1131   do
     1132   on error undo, return error
     1133   :
     1134       if v-bge-xml-bgefmt = "dbf":U
     1135       then do:
     1136       end.
     1137       else do:
     1138           assign
     1139               v-out-string = substitute( "&1&2<&3&4>"
     1140                                       , chr(10)
     1141                                       , fill( " ":U, 4 * iTagLevel)
     1142                                       , sTagName
     1143                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1144                               )
     1145           .
     1146           put stream stmXMLOut unformatted
     1147               v-out-string
     1148           .
     1149       end.
     1150   end.
     1151   END PROCEDURE.
     1152   PROCEDURE wp-XMLTagPut:
     1153     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1154     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1155     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1156     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1157       define variable v-out-string    as character    no-undo.
     1158   do
     1159   on error undo, return error
     1160   :
     1161       if v-bge-xml-bgefmt = "dbf":U
     1162       then do:
     1163           if v-bge-xml-dbf-file-name <> "":U
     1164           then do:
     1165               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1166               export stream stmXMLOut
     1167                   sTagName
     1168                   sParValue
     1169               .
     1170               output stream stmXMLOut close.
     1171           end.
     1172       end.
     1173       else do:
     1174           IF  iFlagEmpty = 1
     1175           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1176           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1177           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1178           THEN DO:
     1179               run xmlchar-encode in this-procedure (
     1180                   input sParValue
     1181                   , output sParValue
     1182               ).
     1183               assign
     1184                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1185                                               , chr(10)
     1186                                               , FILL(" ", 4 * iTagLevel)
     1187                                               , sTagName
     1188                                               , sParValue
     1189                               )
     1190               .
     1191               PUT STREAM stmXMLOut UNFORMATTED
     1192                   v-out-string
     1193               .
     1194           END.
     1195       end.
     1196   end.
     1197   END PROCEDURE.
     1198   PROCEDURE wp-XMLTagClose:
     1199   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1200   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1201       define variable v-out-string    as character    no-undo.
     1202   do
     1203   on error undo, return error
     1204   :
     1205       if v-bge-xml-bgefmt = "dbf":U
     1206       then do:
     1207       end.
     1208       else do:
     1209           assign
     1210               v-out-string = substitute( "&1&2</&3>"
     1211                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1212                                   , fill( " ", 4 * iTagLevel )
     1213                                   , sTagName
     1214                           )
     1215           .
     1216           PUT STREAM stmXMLOut UNFORMATTED
     1217               v-out-string
     1218           .
     1219       end.
     1220   end.
     1221   END PROCEDURE.
     1222   PROCEDURE wp-XMLWriteLog:
     1223     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1224     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1225     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1226   define variable v-str              as character no-undo .
     1227   define variable v-error-append     as logical   no-undo .
     1228   define variable v-error-append-msg as character no-undo .
     1229   assign
     1230     v-str = chr(10)
     1231             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1232             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1233     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1234     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1235     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1236   .
     1237   run bge/bge-log.p (input v-str) no-error .
     1238   if error-status:error then do:
     1239     assign
     1240       v-error-append     = yes
     1241       v-error-append-msg = return-value
     1242     .
     1243   end.
     1244   run gbl/fileapnd.p
     1245     ( input sFileName
     1246     , input v-str
     1247     , input 10
     1248     ) no-error .
     1249   if error-status:error then do:
     1250     assign
     1251       v-error-append     = yes
     1252       v-error-append-msg = substitute( "&1&2&3"
     1253                                       , v-error-append-msg
     1254                                       , chr(10)
     1255                                       , return-value
     1256                                       )
     1257     .
     1258   end.
     1259   if v-error-append
     1260   then do:
     1261     return error substitute( "&1" , v-error-append-msg ) .
     1262   end.
     1263   END PROCEDURE.
     1264   PROCEDURE wp-XMLWriteEDT:
     1265     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1266     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1267     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1268       if valid-handle ( hEDT )
     1269       then do:
     1270           hEDT :move-to-eof().
     1271           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1272                                           OR sToWrite = "&Line") THEN "" ELSE
     1273                                           cur-time-string-sec() + " ").
     1274           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1275                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1276                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1277           hEDT :insert-string(chr(10)).
     1278       end.
     1279       process events.
     1280       output to 'bgescn.txt' append.
     1281           put unformatted
     1282               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1283                                           OR sToWrite = "&Line") THEN "" ELSE
     1284                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1285               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1286                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1287                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1288           .
     1289       output close.
     1290   END PROCEDURE.
     1291   PROCEDURE wp-XMLShowCNT:
     1292     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1293       if valid-handle( hCNT )
     1294       then do:
     1295           ASSIGN hCNT :VISIBLE = TRUE.
     1296       end.
     1297   END PROCEDURE.
     1298   PROCEDURE wp-XMLHideCNT:
     1299     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1300       if valid-handle( hCNT )
     1301       then do:
     1302           ASSIGN hCNT :VISIBLE = FALSE.
     1303       end.
     1304   END PROCEDURE.
     1305   PROCEDURE wp-XMLWriteCNT:
     1306     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1307     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1308       if valid-handle( hCNT )
     1309       then do:
     1310           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1311       end.
     1312   END PROCEDURE.
     1313   procedure bge-xml-write-header:
     1314   do
     1315   on error undo, return error
     1316   :
     1317   define input parameter p-xml-file-name  as character        no-undo.
     1318   define input parameter p-doc-name       as character        no-undo.
     1319   define input parameter p-version        as character        no-undo.
     1320   define input parameter p-db-num         as integer          no-undo.
     1321   define input parameter p-date-from      as date             no-undo.
     1322   define input parameter p-shift-num-from as integer          no-undo.
     1323   define input parameter p-date-to        as date             no-undo.
     1324   define input parameter p-shift-num-to   as integer          no-undo.
     1325   define input parameter p-obj-list       as character        no-undo.
     1326   define input parameter p-doc-type-list  as character        no-undo.
     1327   define input parameter p-pay-code       as logical          no-undo.
     1328   define input parameter p-cst            as logical          no-undo.
     1329   define input parameter p-parts          as logical          no-undo.
     1330   define input parameter p-chk-pay-code   as logical          no-undo.
     1331   define input parameter p-pay-desk       as logical          no-undo.
     1332   define input parameter p-pay-desk-cards as logical          no-undo.
     1333   define input parameter p-deleted        as logical          no-undo.
     1334   define input parameter p-opened-docs    as logical          no-undo.
     1335   define variable v-out-string    as character    no-undo.
     1336   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1337   assign
     1338       v-out-string = substitute( "&1&2&3"
     1339                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1340                           , chr(10)
     1341                           , "<IBS_Trade_House>":U )
     1342   .
     1343   put stream stmXMLOut unformatted
     1344       v-out-string
     1345   .
     1346   run wp-XMLTagOpen(1, "header","").
     1347   if v-bge-xml-bgeflold = "oracle":u
     1348   then do:
     1349     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1350     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1351     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1352     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1353     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1354   end.
     1355   run wp-XMLTagOpen( 2, "manifest", "").
     1356   run wp-XMLTagOpen( 3, "document", "").
     1357   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1358   run wp-XMLTagput( 4, "description", "", 0).
     1359   run wp-XMLTagput( 4, "version", p-version, 0).
     1360   run wp-XMLTagclose( 3, "document" ).
     1361   run wp-XMLTagclose( 2, "manifest" ).
     1362   run wp-XMLTagclose( 1, "header" ).
     1363   run wp-XMLTagOpen(1, "options","").
     1364   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1365   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1366   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1367   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1368   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1369   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1370   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1371   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1372   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1373   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1374   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1375   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1376   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1377   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1378   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1379   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1380   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1381   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1382   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1383   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1384   run wp-XMLTagClose(1, "options").
     1385   run wp-XMLTagOpen( 1, "body", "" ).
     1386   output stream stmXMLOut close.
     1387   end.
     1388   end procedure.
     1389   procedure xml-bge-write-footer:
     1390   do
     1391   on error undo, return error return-value
     1392   :
     1393   define input parameter p-xml-file-name as character    no-undo.
     1394   define variable v-error-num     as integer           no-undo.
     1395   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1396   run wp-XMLTagClose( 1, "body" ).
     1397   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1398   output stream stmXMLOut close.
     1399   if v-bge-xml-bgeflold = "oracle":u
     1400   then do:
     1401     define variable v-tmp-file-name         as character no-undo .
     1402     define variable v-zip-file-name         as character no-undo .
     1403     define variable v-exch-file-name        as character no-undo .
     1404     define variable v-heap-file-name        as character no-undo .
     1405     define variable v-i                     as integer   no-undo .
     1406     define variable v-file-name             as character no-undo .
     1407     define variable v-arc                   as character no-undo .
     1408     define variable v-str                   as character no-undo .
     1409     define variable v-exch-tmp-file-name    as character no-undo .
     1410     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1411     define variable v-bge-xml-exch-dir      as character no-undo .
     1412     define variable v-bge-xml-heap-dir      as character no-undo .
     1413     define variable v-bge-xml-compress-heap as logical   no-undo .
     1414     define variable v-home-dir              as character no-undo .
     1415     define variable v-os-command            as character no-undo .
     1416     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1417     if v-home-dir = ?
     1418     then do:
     1419       undo, return error substitute( "&1&2&3"
     1420                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1421                                     , chr(10)
     1422                                     , "Обратитесь к администратору.":u
     1423                                     ).
     1424     end.
     1425     assign
     1426       v-home-dir = v-home-dir
     1427     .
     1428     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1429     if error-status :error
     1430     then do:
     1431       undo, return error substitute( "&1&2&3"
     1432                                     , "Неверно задан каталог экспорта.":u
     1433                                     , chr(10)
     1434                                     , "Обратитесь к администратору.":u
     1435                                     ).
     1436     end.
     1437     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1438     if v-bge-xml-exch-dir = ?
     1439     then do:
     1440       undo, return error substitute( "&1&2&3"
     1441                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1442                                     , chr(10)
     1443                                     , "Обратитесь к администратору.":u
     1444                                     ).
     1445     end.
     1446     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1447     if error-status :error
     1448     then do:
     1449       undo, return error substitute( "&1&2&3"
     1450                                     , "Неверно задан каталог экспорта (exch).":u
     1451                                     , chr(10)
     1452                                     , "Обратитесь к администратору.":u
     1453                                     ).
     1454     end.
     1455     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1456     if v-bge-xml-heap-dir = ?
     1457     then do:
     1458       undo, return error substitute( "&1&2&3"
     1459                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1460                                     , chr(10)
     1461                                     , "Обратитесь к администратору.":u
     1462                                     ).
     1463     end.
     1464     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1465     if error-status :error
     1466     then do:
     1467       undo, return error substitute( "&1&2&3"
     1468                                     , "Неверно задан каталог экспорта (heap).":u
     1469                                     , chr(10)
     1470                                     , "Обратитесь к администратору.":u
     1471                                     ).
     1472     end.
     1473     get-key-value section "BGE" key "heap-compress" value v-str.
     1474     assign
     1475       v-i = int(v-str)
     1476     no-error .
     1477     if v-i = ? or v-i = 0
     1478     then do:
     1479       assign
     1480         v-bge-xml-compress-heap = no
     1481       .
     1482     end.
     1483     else do:
     1484       assign
     1485         v-bge-xml-compress-heap = yes
     1486       .
     1487     end.
     1488     assign
     1489       v-arc = search( "exe/7za.exe":u )
     1490     .
     1491     if v-arc = ? or v-arc = ""
     1492     then do:
     1493       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1494     end.
     1495     assign
     1496       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1497       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1498       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1499       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1500       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1501       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1502       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1503     .
     1504     run gbl/del-file.p (input v-tmp-file-name) .
     1505     run gbl/del-file.p (input v-zip-file-name) .
     1506     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1507     if v-error-num > 0
     1508     then do:
     1509         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1510                                      , p-xml-file-name + "xm1":u
     1511                                      , v-tmp-file-name
     1512                                      , v-error-num
     1513                                      ).
     1514     end.
     1515     assign
     1516       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1517                                    , v-arc
     1518                                    , v-zip-file-name
     1519                                    , v-tmp-file-name
     1520                                    )
     1521     .
     1522     os-command silent value ( v-os-command ) .
     1523     run gbl/del-file.p (input v-heap-file-name) .
     1524     if v-bge-xml-compress-heap = no
     1525     then do:
     1526       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1527       if v-error-num > 0
     1528       then do:
     1529           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1530                                        , v-tmp-file-name
     1531                                        , v-heap-file-name
     1532                                        , v-error-num
     1533                                        ) .
     1534       end.
     1535     end.
     1536     else do:
     1537       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1538       if v-error-num > 0
     1539       then do:
     1540           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1541                                        , v-zip-file-name
     1542                                        , v-heap-file-name
     1543                                        , v-error-num
     1544                                        ) .
     1545       end.
     1546     end.
     1547     run gbl/del-file.p (input v-tmp-file-name) .
     1548     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1549     if error-status :error then do:
     1550       undo, return error substitute( "&1&2&3"
     1551                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1552                                     , chr(10)
     1553                                     , "Обратитесь к администратору."
     1554                                     ).
     1555     end.
     1556     run gbl/del-file.p (input v-exch-file-name) .
     1557     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1558     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1559     if v-error-num > 0
     1560     then do:
     1561       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1562                                     , v-zip-file-name
     1563                                     , v-exch-tmp-file-name
     1564                                     , v-error-num
     1565                                     ) .
     1566     end.
     1567     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1568     if v-error-num > 0
     1569     then do:
     1570       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1571                                     , v-exch-tmp-file-name
     1572                                     , v-exch-file-name
     1573                                     , v-error-num
     1574                                     ) .
     1575     end.
     1576     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1577   end.
     1578   else do:
     1579     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1580     if v-error-num > 0
     1581     then do:
     1582       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1583                                     , p-xml-file-name + "xm1"
     1584                                     , p-xml-file-name + "xml"
     1585                                     , v-error-num
     1586                                     ) .
     1587     end.
     1588   end.
     1589   if opsys = "unix"
     1590   then do:
     1591       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1592   end.
     1593   end.
     1594   end procedure.
     1595   procedure xml-bge-filename0:
     1596   define input parameter p-prefix   as character no-undo .
     1597   define input parameter p-name     as character no-undo .
     1598   define input parameter p-shared-process as logical no-undo .
     1599   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1600   define output parameter p-xml-file-name  as character no-undo .
     1601   // define output parameter p-fullfnamenoext as character no-undo .
     1602   define output parameter p-locked         as logical      no-undo.
     1603   define variable v-fullfnamenoext as character no-undo .
     1604   define variable v-fileext        as character no-undo .
     1605   define variable v-fullfname      as character no-undo .
     1606   define variable v-error-num      as integer   no-undo .
     1607   do
     1608   on error undo, return error
     1609   :
     1610     case v-bge-xml-bgeflold :
     1611       when "old" then do:
     1612         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1613         v-fileext       = ".xml":U .
     1614         v-fullfname     = v-fullfnamenoext + v-fileext .
     1615         p-xml-file-name = v-fullfname .
     1616         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1617         if v-error-num > 0 then do:
     1618           return error.
     1619         end.
     1620       end.
     1621       when "var" then do:
     1622         case p-prefix :
     1623           when "doc" then do:
     1624             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1625             v-fileext       = ".xml":U .
     1626             v-fullfname     = v-fullfnamenoext + v-fileext .
     1627             p-xml-file-name = v-fullfname .
     1628           end.
     1629           when "day" then do:
     1630             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1631             v-fileext       = ".xml":U .
     1632             v-fullfname     = v-fullfnamenoext + v-fileext .
     1633             p-xml-file-name = v-fullfname .
     1634           end.
     1635           otherwise do:
     1636             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1637             v-fileext       = ".xml":U .
     1638             v-fullfname     = v-fullfnamenoext + v-fileext .
     1639             p-xml-file-name = v-fullfname .
     1640           end.
     1641         end case.
     1642         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1643         if v-error-num > 0 then do:
     1644           return error.
     1645         end.
     1646       end.
     1647       when "new" then do:
     1648                   run bge/genfname.p (
     1649                       input p-home-dir
     1650                       , input p-prefix
     1651                       , input ""
     1652                       , input "xml"
     1653                       , input ""
     1654                       , output p-xml-file-name
     1655                   ).
     1656       end.
     1657       when "no-parameter" then do:
     1658         if p-shared-process then do:
     1659                       run bge/genfname.p (
     1660                           input p-home-dir
     1661                           , input "d"
     1662                           , input ""
     1663                           , input "xml"
     1664                           , input ""
     1665                           , output p-xml-file-name
     1666                       ).
     1667         end.
     1668         else do:
     1669           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1670           v-fileext       = ".xml":U .
     1671           v-fullfname     = v-fullfnamenoext + v-fileext .
     1672           p-xml-file-name = v-fullfname .
     1673           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1674           if v-error-num > 0 then do:
     1675             return error.
     1676           end.
     1677         end.
     1678       end.
     1679     end case.
     1680     assign
     1681       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1682       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1683     .
     1684   end .
     1685   end procedure .
     1686   procedure xml-bge-filename :
     1687   do
     1688   on error undo, return error
     1689   :
     1690   define input parameter p-prefix             as character    no-undo.
     1691   define input parameter p-name               as character    no-undo.
     1692   define input parameter p-shared-process     as logical      no-undo.
     1693   define output parameter p-xml-file-name     as character    no-undo.
     1694   define output parameter p-log-file-name     as character    no-undo.
     1695   define output parameter p-locked            as logical      no-undo.
     1696   define variable v-home-dir          as character no-undo .
     1697   define variable v-error-num         as integer   no-undo .
     1698   define variable v-bge-xml-heap-dir  as character no-undo .
     1699       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1700       if v-home-dir = ?
     1701       then do:
     1702           message
     1703             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1704             skip(1)
     1705             skip "Обратитесь к администратору."
     1706           view-as alert-box error.
     1707           undo, return error .
     1708       end.
     1709       if v-bge-xml-bgeflold <> "oracle"
     1710       then do:
     1711         assign
     1712             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1713         .
     1714       end.
     1715       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1716       if error-status :error
     1717       then do:
     1718           message
     1719             skip "Неверно задан каталог экспорта."
     1720             skip(1)
     1721             skip "Обратитесь к администратору."
     1722           view-as alert-box error.
     1723           undo, return error .
     1724       end.
     1725       if v-bge-xml-bgefmt = "dbf":U
     1726       then do:
     1727           assign
     1728               p-xml-file-name = v-home-dir
     1729               p-locked        = no
     1730           .
     1731       end.
     1732       else do:
     1733           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1734             output p-xml-file-name, output p-locked) .
     1735       end.
     1736       if v-bge-xml-bgeflold = "oracle"
     1737       then do:
     1738         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1739         if v-bge-xml-heap-dir = ?
     1740         then do:
     1741           undo, return error substitute( "&1&2&3"
     1742                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1743                                         , chr(10)
     1744                                         , "Обратитесь к администратору.":u
     1745                                         ).
     1746         end.
     1747         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1748         if error-status :error
     1749         then do:
     1750           undo, return error substitute( "&1&2&3"
     1751                                         , "Неверно задан каталог экспорта (heap).":u
     1752                                         , chr(10)
     1753                                         , "Обратитесь к администратору.":u
     1754                                         ).
     1755         end.
     1756         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1757           assign
     1758             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1759           .
     1760         end.
     1761         else do:
     1762           assign
     1763             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1764           .
     1765         end.
     1766       end.
     1767       else do:
     1768         assign
     1769             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1770         .
     1771       end.
     1772       assign
     1773          v-bge-xml-static-log-file-name = p-log-file-name
     1774       .
     1775   end.
     1776   end procedure.
     1777   procedure bge-xml-read-config :
     1778   do
     1779   on error undo, return error return-value
     1780   :
     1781   define input  parameter p-last-date as date      no-undo .
     1782   define input  parameter p-db-num    as integer   no-undo .
     1783       define variable v-bgeclall      as character     no-undo.
     1784       define variable v-bgedict       as character     no-undo.
     1785       define variable v-bgeshift      as character     no-undo.
     1786       define variable v-par-type      as character     no-undo.
     1787       define variable v-bgeflnm       as character     no-undo.
     1788       define variable v-bgecliiv      as character     no-undo .
     1789       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1790       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1791       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1792       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1793       define variable v-db-num-str    as character     no-undo .
     1794       define variable v-param-type      as character  no-undo .
     1795       define variable v-value-character as character  no-undo .
     1796       define variable v-value-date      as date       no-undo .
     1797       define variable v-value-decimal   as decimal    no-undo .
     1798       define variable v-value-integer   as integer    no-undo .
     1799       define variable v-value-logical   as logical    no-undo .
     1800       define variable v-tth             as handle      no-undo .
     1801       run adm/shattri.p ( input "get":U
     1802                         , input  '':u
     1803                         , input  0
     1804                         , input  'bge-export':U
     1805                         , input  'bgeclall':U
     1806                         , output v-bgecliiv
     1807                         , output v-value-date
     1808                         , output v-value-decimal
     1809                         , output v-value-integer
     1810                         , output v-value-logical
     1811                         , output v-param-type
     1812                         , input-output table-handle v-tth
     1813                         ) no-error .
     1814       if error-status :error
     1815       then do:
     1816         assign
     1817           v-bge-xml-bgecliiv = no
     1818         .
     1819       end.
     1820       else do:
     1821         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1822       end.
     1823       delete object v-tth.
     1824       assign
     1825           v-bge-xml-bgeclall = no
     1826           v-bge-xml-bgedict  = no
     1827       .
     1828       run adm/shattri.p ( input "get":U
     1829                         , input  '':u
     1830                         , input  0
     1831                         , input  'bge-export':U
     1832                         , input  'bgeclall':U
     1833                         , output v-value-character
     1834                         , output v-value-date
     1835                         , output v-value-decimal
     1836                         , output v-value-integer
     1837                         , output v-value-logical
     1838                         , output v-param-type
     1839                         , input-output table-handle v-tth
     1840                         ) no-error .
     1841       if error-status :error
     1842       then do:
     1843         assign
     1844           v-bge-xml-bgeclall = no
     1845         .
     1846       end.
     1847       else do:
     1848         assign
     1849           v-bge-xml-bgeclall = v-value-logical
     1850         .
     1851       end.
     1852       delete object v-tth.
     1853       run adm/shattri.p ( input "get":U
     1854                         , input  '':u
     1855                         , input  0
     1856                         , input  'bge-export':U
     1857                         , input  'bgedict':U
     1858                         , output v-value-character
     1859                         , output v-value-date
     1860                         , output v-value-decimal
     1861                         , output v-value-integer
     1862                         , output v-value-logical
     1863                         , output v-param-type
     1864                         , input-output table-handle v-tth
     1865                         ) no-error .
     1866       if error-status :error
     1867       then do:
     1868         assign
     1869           v-bge-xml-bgedict = no
     1870         .
     1871       end.
     1872       else do:
     1873         assign
     1874           v-bge-xml-bgedict = v-value-logical
     1875         .
     1876       end.
     1877       delete object v-tth.
     1878       run adm/shattri.p ( input "get":U
     1879                         , input  '':u
     1880                         , input  0
     1881                         , input  'bge-export':U
     1882                         , input  'bgefmt':U
     1883                         , output v-value-character
     1884                         , output v-value-date
     1885                         , output v-value-decimal
     1886                         , output v-value-integer
     1887                         , output v-value-logical
     1888                         , output v-param-type
     1889                         , input-output table-handle v-tth
     1890                         ) no-error .
     1891       if error-status :error
     1892       then do:
     1893         assign
     1894           v-bge-xml-bgefmt  = "xml":U
     1895         .
     1896       end.
     1897       else do:
     1898         assign
     1899           v-bge-xml-bgefmt  = v-value-character
     1900         .
     1901       end.
     1902       delete object v-tth.
     1903       run adm/shattri.p ( input "get":U
     1904                         , input  '':u
     1905                         , input  0
     1906                         , input  'bge-export':U
     1907                         , input  'bgeshift':U
     1908                         , output v-value-character
     1909                         , output v-value-date
     1910                         , output v-value-decimal
     1911                         , output v-value-integer
     1912                         , output v-value-logical
     1913                         , output v-param-type
     1914                         , input-output table-handle v-tth
     1915                         ) no-error .
     1916       if error-status :error
     1917       then do:
     1918         assign
     1919             v-bge-xml-shift-mode = no
     1920         .
     1921       end.
     1922       else do:
     1923         assign
     1924             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1925         .
     1926       end.
     1927       delete object v-tth.
     1928       run adm/shattri.p ( input "get":U
     1929                         , input  '':u
     1930                         , input  0
     1931                         , input  'bge-export':U
     1932                         , input  'bgeflold':U
     1933                         , output v-value-character
     1934                         , output v-value-date
     1935                         , output v-value-decimal
     1936                         , output v-value-integer
     1937                         , output v-value-logical
     1938                         , output v-param-type
     1939                         , input-output table-handle v-tth
     1940                         ) no-error .
     1941       if error-status :error
     1942       then do:
     1943         assign
     1944           v-bge-xml-bgeflold = "no-parameter":U
     1945         .
     1946       end.
     1947       else do:
     1948         assign
     1949           v-bge-xml-bgeflold  = v-value-character
     1950         .
     1951       end.
     1952       delete object v-tth.
     1953       assign
     1954         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1955         v-bge-xml-db-num-str  = v-db-num-str
     1956       .
     1957       if p-last-date <> ?
     1958       then do:
     1959           run adm/shattri.p ( input "get":U
     1960                             , input  '':u
     1961                             , input  0
     1962                             , input  'bge-export':U
     1963                             , input  'bgeflnm':U
     1964                             , output v-value-character
     1965                             , output v-value-date
     1966                             , output v-value-decimal
     1967                             , output v-value-integer
     1968                             , output v-value-logical
     1969                             , output v-param-type
     1970                             , input-output table-handle v-tth
     1971                             ) no-error .
     1972           if error-status :error
     1973           then do:
     1974             assign
     1975               v-bgeflnm = '':U
     1976             .
     1977           end.
     1978           else do:
     1979             assign
     1980               v-bgeflnm = v-value-character
     1981             .
     1982           end.
     1983           delete object v-tth.
     1984           if v-bge-xml-bgeflold = "var"
     1985           then do:
     1986               if v-bgeflnm = ?
     1987               or num-entries( v-bgeflnm ) < 2
     1988               then do:
     1989                   assign
     1990                       v-bge-xml-bgeflold = "new"
     1991                   .
     1992               end.
     1993               else do:
     1994                   assign
     1995                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1996                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1997                   .
     1998                   assign
     1999                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     2000                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     2001                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2002                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     2003                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     2004                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     2005                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2006                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     2007                   .
     2008               end.
     2009           end.
     2010       end.
     2011   end.
     2012   end procedure.
     2013   procedure bge-xml-get-ref-filename :
     2014   define input parameter p-in-file-name       as character        no-undo.
     2015   define output parameter p-home-dir          as character        no-undo.
     2016   define output parameter p-out-file-name     as character        no-undo.
     2017   define output parameter p-locked            as logical          no-undo.
     2018       define variable v-counter       as integer      no-undo.
     2019       define variable v-error-level   as integer      no-undo.
     2020   do
     2021   on error undo, return error
     2022   :
     2023       run bge/bge-ini.p (
     2024             input "bge"
     2025           , output p-home-dir
     2026       ).
     2027       if return-value <> "OK"
     2028       then do:
     2029           undo, return error.
     2030       end.
     2031       assign
     2032           p-home-dir = p-home-dir + "\dict":U
     2033       .
     2034       run bge/dir_cd.p (
     2035           input p-home-dir
     2036           , input "CA"
     2037       ).
     2038       if return-value = "ERROR"
     2039       then do:
     2040           undo, return error.
     2041       end.
     2042       assign
     2043           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     2044       .
     2045       assign
     2046           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     2047       .
     2048       wait-lock:
     2049       do v-counter = 1 TO 3
     2050       :
     2051           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     2052           if p-locked = no
     2053           then do:
     2054               leave wait-lock.
     2055           end.
     2056           else do:
     2057               readkey pause 1.
     2058           end.
     2059       END.
     2060       if p-locked = yes
     2061       then do:
     2062           undo, return error.
     2063       end.
     2064       run bge/os_copy.p (
     2065             input "D":U
     2066           , input p-out-file-name + "xml":U
     2067           , input "":U
     2068           , output v-error-level
     2069       ).
     2070       if v-error-level > 0
     2071       then do:
     2072           undo, return error.
     2073       end.
     2074   end.
     2075   end procedure.
     2076   procedure bge-xml-write-ref-header :
     2077   define input parameter p-bge-name as character        no-undo.
     2078   define input parameter p-file-name as character        no-undo.
     2079       define variable v-out-string    as character    no-undo.
     2080   do
     2081   on error undo, return error
     2082   :
     2083       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2084       put stream stmXMLOut unformatted
     2085           "<?xml version='1.0' encoding='windows-1251'?>":U
     2086       .
     2087       assign
     2088           v-out-string = substitute( "&1&2"
     2089                               , chr(10)
     2090                               , "<IBS_Trade_House>":U )
     2091       .
     2092       put stream stmXMLOut unformatted
     2093           v-out-string
     2094       .
     2095       run wp-XMLTagOpen( 1, "header", "" ).
     2096       if v-bge-xml-bgeflold = "oracle":u
     2097       then do:
     2098         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2099         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2100         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2101         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2102         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2103       end.
     2104       else do:
     2105         run wp-XMLTagOpen( 2, "delivery", "" ).
     2106         run wp-XMLTagOpen( 3, "to", "" ).
     2107         run wp-XMLTagClose( 3, "to" ).
     2108         run wp-XMLTagOpen( 3, "from", "" ).
     2109         run wp-XMLTagClose( 3, "from" ).
     2110         run wp-XMLTagClose( 2, "delivery" ).
     2111       end.
     2112       run wp-XMLTagOpen( 2, "manifest", "" ).
     2113       run wp-XMLTagOpen( 3, "document", "" ).
     2114       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2115       run wp-XMLTagPut( 4, "description", "", 0 ).
     2116       run wp-XMLTagClose( 3, "document" ).
     2117       run wp-XMLTagClose( 2, "manifest" ).
     2118       run wp-XMLTagClose( 1, "header" ).
     2119       run wp-XMLTagOpen( 1, "body", "" ).
     2120   end.
     2121   end procedure.
     2122   procedure bge-xml-write-ref-footer :
     2123   define input parameter p-file-name as character        no-undo.
     2124       define variable v-error-level   as integer      no-undo.
     2125   do
     2126   on error undo, return error
     2127   :
     2128       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2129       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2130       output stream stmXMLOut close.
     2131       run bge/os_copy.p (
     2132             input "M":U
     2133           , input p-file-name + "xm1":U
     2134           , input p-file-name + "xml":U
     2135           , output v-error-level
     2136       ).
     2137       if v-error-level > 0
     2138       then do:
     2139           undo, return error.
     2140       end.
     2141   end.
     2142   end procedure.
     2143   procedure bge-xml-out-dir :
     2144   define output parameter p-out-dir       as character    no-undo.
     2145   define output parameter p-log-file-name as character    no-undo.
     2146   do
     2147   on error undo, return error
     2148   :
     2149       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2150       if p-out-dir = ?
     2151       then do:
     2152           message
     2153             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2154                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2155             skip(1)
     2156             skip "Обратитесь к администратору."
     2157           view-as alert-box error.
     2158           undo, return error .
     2159       end.
     2160       if v-bge-xml-bgeflold <> "oracle" then assign
     2161         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2162       .
     2163       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2164       if error-status :error  then do:
     2165           run wp-XMLWriteLog in this-procedure (
     2166                 input p-log-file-name
     2167               , input 0
     2168               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2169                                   , p-out-dir
     2170                                   , return-value
     2171                                   , trim( error-status :get-message( 1 ) )
     2172                                   )
     2173           ).
     2174           undo, return error.
     2175       end.
     2176       assign
     2177           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2178           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2179       .
     2180   end.
     2181   end procedure.
     2182   procedure bge-xml-out-dir2 :
     2183   define output parameter p-out-dir       as character    no-undo.
     2184   define output parameter p-out-dirR      as character    no-undo.
     2185   define output parameter p-log-file-name as character    no-undo.
     2186   do
     2187   on error undo, return error
     2188   :
     2189       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2190       if p-out-dir = ?
     2191       then do:
     2192           message
     2193             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2194                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2195             skip(1)
     2196             skip "Обратитесь к администратору."
     2197           view-as alert-box error.
     2198           undo, return error .
     2199       end.
     2200       if v-bge-xml-bgeflold <> "oracle" then assign
     2201             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2202             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2203         .
     2204       else p-out-dirR = p-out-dir .
     2205       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2206       if error-status :error  then do:
     2207           run wp-XMLWriteLog in this-procedure (
     2208                 input p-log-file-name
     2209               , input 0
     2210               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2211                                   , p-out-dir
     2212                                   , return-value
     2213                                   , error-status :get-message( 1 )
     2214                                   )
     2215           ).
     2216           undo, return error.
     2217       end.
     2218       if p-out-dirR <> p-out-dir then do:
     2219         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2220         if error-status :error then do:
     2221           run wp-XMLWriteLog in this-procedure (
     2222                 input p-log-file-name
     2223               , input 0
     2224               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2225                                   , p-out-dirR
     2226                                   , return-value
     2227                                   , error-status :get-message( 1 )
     2228                                   )
     2229           ).
     2230           p-out-dirR = p-out-dir .
     2231         end.
     2232       end .
     2233       assign
     2234         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2235         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2236       .
     2237   end.
     2238   end procedure.
     2239   procedure bge-xml-out-file :
     2240   do
     2241   on error undo, return error
     2242   :
     2243   define input parameter p-out-dir            as character        no-undo.
     2244   define input parameter p-prefix             as character        no-undo.
     2245   define input parameter p-sheduled           as logical          no-undo.
     2246   define output parameter p-xml-file-name     as character        no-undo.
     2247   define output parameter p-locked            as logical          no-undo.
     2248   define variable v-home-dir      as character     no-undo.
     2249   define variable v-error-num     as integer       no-undo.
     2250   define variable v-today             as date         no-undo.
     2251   define variable v-time              as integer      no-undo.
     2252       if v-bge-xml-bgefmt = "dbf":U
     2253       then do:
     2254           assign
     2255               p-xml-file-name = p-out-dir
     2256               p-locked        = no
     2257           .
     2258       end.
     2259       else do:
     2260           if v-bge-xml-bgeflold = "firm":U
     2261           then do:
     2262               run bge/genfname.p (
     2263                     input p-out-dir
     2264                   , input p-prefix
     2265                   , input "":U
     2266                   , input "arj":U
     2267                   , input "":U
     2268                   , output p-xml-file-name
     2269               ).
     2270           end.
     2271           else do:
     2272               run bge/genfname.p (
     2273                     input p-out-dir
     2274                   , input p-prefix
     2275                   , input "":U
     2276                   , input "xml":U
     2277                   , input "":U
     2278                   , output p-xml-file-name
     2279               ).
     2280           end.
     2281           assign
     2282               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2283               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2284           .
     2285       end.
     2286   end.
     2287   end procedure.
     2288   procedure bge-xml-init-ext-doc-type :
     2289       define variable v-counter    as integer      no-undo.
     2290       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2291   do
     2292   for buf_temp_ext-doc-type
     2293   on error undo, return error
     2294   :
     2295       empty temp-table buf_temp_ext-doc-type.
     2296       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2297       :
     2298           create buf_temp_ext-doc-type.
     2299           assign
     2300               buf_temp_ext-doc-type.edt-key               = v-counter
     2301               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2302               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2303           .
     2304       end.
     2305   end.
     2306   end procedure.
     2307   procedure bge-xml-get-decimal-shift-num :
     2308   define input parameter p-shift-date     as date             no-undo.
     2309   define input parameter p-shift-num      as integer          no-undo.
     2310   define output parameter p-shift-decimal as decimal          no-undo.
     2311   do
     2312   on error undo, return error
     2313   :
     2314       assign
     2315           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2316       .
     2317   end.
     2318   end procedure.
     2319   procedure bge-xml-ora-exp-filename :
     2320     define input  parameter p-table-name  as character no-undo .
     2321     define input  parameter p-doc-code    as character no-undo .
     2322     define input  parameter p-obj-code    as integer   no-undo .
     2323     define output parameter p-filename    as character no-undo .
     2324     define output parameter p-seq-num     as integer   no-undo .
     2325     define variable v-ora-exp-seq     as integer   no-undo .
     2326     define variable v-ora-exp-seq-str as character no-undo .
     2327     define variable v-home-dir        as character no-undo.
     2328   do
     2329   on error undo, return error return-value
     2330   :
     2331     if v-bge-xml-bgeflold = "oracle":u
     2332     then do:
     2333       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2334       if v-home-dir = ?
     2335       then do:
     2336         undo, return error substitute( "&1&2&3":U
     2337                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2338                                       , chr(10)
     2339                                       , "Обратитесь к администратору.":U
     2340                                       ).
     2341       end.
     2342       assign
     2343           v-home-dir = v-home-dir
     2344       .
     2345       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2346       if error-status :error
     2347       then do:
     2348         undo, return error substitute( "&1&2&3":U
     2349                                       , "Неверно задан каталог экспорта.":U
     2350                                       , chr(10)
     2351                                       , "Обратитесь к администратору.":U
     2352                                       ).
     2353       end.
     2354       assign
     2355         v-ora-exp-seq = ?
     2356       .
     2357       if  p-table-name <> ? and
     2358           p-doc-code <> ?
     2359       then do:
     2360         run bge/get-oesq.p ( input p-table-name
     2361                            , input p-doc-code
     2362                            , output v-ora-exp-seq
     2363                            ) no-error .
     2364         if error-status :error = yes
     2365         then do:
     2366           undo, return error return-value .
     2367         end.
     2368       end.
     2369       if v-ora-exp-seq = ?
     2370       then do:
     2371         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2372         if error-status :error
     2373         then do:
     2374           undo, return error return-value .
     2375         end.
     2376       end.
     2377       if p-table-name <> ? and
     2378          p-doc-code   <> ?
     2379       then do:
     2380         run bge/oesqdoc.p ( input p-table-name
     2381                           , input p-doc-code
     2382                           , input v-ora-exp-seq
     2383                           ) no-error .
     2384         if error-status :error = yes
     2385         then do:
     2386           undo, return error return-value .
     2387         end.
     2388       end.
     2389       assign
     2390         p-seq-num  = v-ora-exp-seq
     2391         p-filename = substitute("&1/&2-000_&3."
     2392                                , v-home-dir
     2393                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2394                                , string(v-ora-exp-seq , "999999999")
     2395                                )
     2396       .
     2397     end.
     2398   end.
     2399   end procedure.
     2400   procedure bge-xml-date-to-str :
     2401     define input  parameter p-date  as date      no-undo .
     2402     define output parameter p-str   as character no-undo .
     2403   do
     2404   on error undo, return error return-value
     2405   :
     2406     if p-date <> ?
     2407     then do:
     2408       assign
     2409         p-str = substitute( "&1-&2-&3"
     2410                           , string( year(p-date)  , "9999")
     2411                           , string( month(p-date) , "99"  )
     2412                           , string( day(p-date)   , "99"  )
     2413                           )
     2414       .
     2415     end.
     2416     else do:
     2417       assign
     2418         p-str = ?
     2419       .
     2420     end.
     2421   end.
     2422   end procedure.
     2423   procedure bge-xml-date-str-to-str :
     2424     define input  parameter p-date-str  as character no-undo .
     2425     define output parameter p-str       as character no-undo .
     2426     define variable v-date          as date      no-undo .
     2427     define variable v-date-valid    as logical   no-undo .
     2428     define variable v-error-message as character no-undo .
     2429   do
     2430   on error undo, return error return-value
     2431   :
     2432     assign
     2433       p-str = ?
     2434     .
     2435     if p-date-str = ? or p-date-str = ""
     2436     then do:
     2437       return .
     2438     end.
     2439     run strtdate in this-procedure ( input  p-date-str
     2440                                    , output v-date
     2441                                    , output v-date-valid
     2442                                    , output v-error-message
     2443                                    ).
     2444     if v-date-valid <> true
     2445     then do:
     2446       return .
     2447     end.
     2448     assign
     2449       p-str = substitute( "&1-&2-&3"
     2450                         , string( year(v-date)  , "9999")
     2451                         , string( month(v-date) , "99"  )
     2452                         , string( day(v-date)   , "99"  )
     2453                         )
     2454     .
     2455   end.
     2456   end procedure.
     2457   procedure bge-xml-fill-tt-bgecliiv :
     2458     define input  parameter p-str as character no-undo .
     2459     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2460     define buffer buf_clients             for ub.clients.
     2461     define variable v-i         as integer   no-undo .
     2462     define variable v-count     as integer   no-undo .
     2463     define variable v-cli-count as integer   no-undo .
     2464     define variable v-client    as character no-undo .
     2465     define variable v-obj-type  as character no-undo .
     2466     define variable v-obj-code  as integer   no-undo .
     2467   do
     2468   on error undo, return error return-value
     2469   :
     2470     empty temp-table buf_tt-bge-xml-bgecliiv.
     2471     assign
     2472       v-bge-xml-bgecliiv = no
     2473       v-cli-count        = num-entries(p-str,';')
     2474     .
     2475     if v-cli-count > 0
     2476     then do:
     2477       _cli-cycle:
     2478       do v-i = 1 to v-cli-count
     2479       :
     2480         assign
     2481           v-client = entry(v-i , p-str, ';')
     2482         .
     2483         if num-entries(v-client) <> 2
     2484         then do:
     2485           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2486         end.
     2487         assign
     2488           v-obj-type = entry(1, v-client)
     2489         .
     2490         assign
     2491           v-obj-code = integer(entry(2, v-client))
     2492         no-error .
     2493         if error-status :error
     2494         then do:
     2495           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2496         end.
     2497         find first buf_clients no-lock
     2498           where buf_clients.obj-type = v-obj-type
     2499             and buf_clients.obj-code = v-obj-code
     2500         no-error.
     2501         if not available buf_clients
     2502         then do:
     2503           next _cli-cycle.
     2504         end.
     2505         find first buf_tt-bge-xml-bgecliiv no-lock
     2506           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2507             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2508         no-error .
     2509         if available buf_tt-bge-xml-bgecliiv
     2510         then do:
     2511           next _cli-cycle.
     2512         end.
     2513         create buf_tt-bge-xml-bgecliiv.
     2514         assign
     2515           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2516           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2517         .
     2518       end.
     2519     end.
     2520     else do:
     2521       assign
     2522         v-bge-xml-bgecliiv = no
     2523       .
     2524       return .
     2525     end.
     2526     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2527     if available buf_tt-bge-xml-bgecliiv
     2528     then do:
     2529       assign
     2530         v-bge-xml-bgecliiv = yes
     2531       .
     2532     end.
     2533   end.
     2534   end procedure.
     2535   procedure bge-xml-resolve-ext-doc-type :
     2536     define input  parameter p-ext-doc-type      as character no-undo .
     2537     define input  parameter p-obj-type          as character no-undo .
     2538     define input  parameter p-obj-code          as integer   no-undo .
     2539     define output parameter p-out-ext-doc-type  as character no-undo .
     2540     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2541   do
     2542   on error undo, return error return-value
     2543   :
     2544     assign
     2545       p-out-ext-doc-type = p-ext-doc-type
     2546     .
     2547     if p-ext-doc-type <> 'ie':U
     2548     then do:
     2549       return .
     2550     end.
     2551     if v-bge-xml-bgecliiv = yes
     2552     then do:
     2553       find first buf_tt-bge-xml-bgecliiv no-lock
     2554         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2555           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2556       no-error .
     2557       if available buf_tt-bge-xml-bgecliiv
     2558       then do:
     2559         assign
     2560           p-out-ext-doc-type = 'iv':U
     2561         .
     2562       end.
     2563     end.
     2564   end.
     2565   end procedure.
     2566   procedure safe-wp-xmltagput :
     2567     define input  parameter pTagLevel   as integer   no-undo .
     2568     define input  parameter pTagName    as character no-undo .
     2569     define input  parameter pParValue   as character no-undo .
     2570     define input  parameter pFlagEmpty  as integer   no-undo .
     2571   do
     2572   on error undo, return error return-value
     2573   :
     2574     if v-bge-xml-bgeflold = "oracle":u
     2575     then do:
     2576       return .
     2577     end.
     2578     run wp-xmltagput in this-procedure ( input pTagLevel
     2579                                        , input pTagName
     2580                                        , input pParValue
     2581                                        , input pFlagEmpty
     2582                                        ).
     2583   end.
     2584   end procedure.
     2585   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2586     define variable v-cntxt-db-num        as integer   no-undo .
     2587     define variable v-cntxt-userid        as character no-undo .
     2588     define variable v-cntxt-level         as character no-undo .
     2589     define variable v-cntxt-host-code-obj as integer   no-undo .
     2590     define variable v-cntxt-obj-type      as character no-undo .
     2591     define variable v-cntxt-obj-code      as integer   no-undo .
     2592     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2593     define variable v-cntxt-is-admin      as logical   no-undo .
     2594   define variable sHomeDir            as character            no-undo.
     2595   define variable sOutFile            as character            no-undo.
     2596   define variable sLogFile            as character            no-undo.
     2597   define variable bLocked             as logical    init no   no-undo.
     2598   define variable iRep                as integer    init 0    no-undo.
     2599   define variable ErrorLevel          as integer              no-undo.
     2600   define variable v-oper-num          as integer              no-undo.
     2601   define variable dTemp               as date                 no-undo.
     2602   define variable v-fact-order-from   like ub.stk-tot.fact-order no-undo.
     2603   define variable v-fact-order-to     like ub.stk-tot.fact-order no-undo.
     2604   define variable v-docs-exists       as logical              no-undo.
     2605   define variable v-yesno             as logical              no-undo.
     2606   define variable v-obj-counter       as integer              no-undo.
     2607   define variable v-archive-ok        as logical              no-undo.
     2608   define variable v-comment           as character            no-undo.
     2609   do
     2610   on error undo, return error
     2611   :
     2612   if p-shedule = no
     2613   then do:
     2614   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2615     run mainmenu_getcntxt in parparentproc
     2616       (output v-cntxt-db-num
     2617       ,output v-cntxt-userid
     2618       ,output v-cntxt-level
     2619       ,output v-cntxt-host-code-obj
     2620       ,output v-cntxt-obj-type
     2621       ,output v-cntxt-obj-code
     2622       ,output v-cntxt-db-num-obj
     2623       ,output v-cntxt-is-admin
     2624       ) .
     2625   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2626   do:
     2627     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2628       (input  v-cntxt-db-num
     2629       ,input  v-cntxt-userid
     2630       ,input  0
     2631       ,input  'actn_documents_export':U
     2632       ,input  'firm':U
     2633       ,input  v-cntxt-host-code-obj
     2634       ,input  '':U
     2635       ,input  0
     2636       ,input  0
     2637       ,input  0
     2638       ,input  0
     2639       ,input  yes
     2640       ,output v-yesno
     2641       )  .
     2642   end.
     2643       if not v-yesno then return error.
     2644   end.
     2645   run bge/bge-ini.p ("bge", OUTPUT sHomeDir).
     2646   IF RETURN-VALUE <> "OK" THEN RETURN "ERROR".
     2647   sHomeDir = sHomeDir + "\exp-acc".
     2648   run bge/dir_cd.p (sHomeDir, "CA").
     2649   IF RETURN-VALUE = "ERROR" THEN RETURN "ERROR".
     2650   sOutFile = sHomeDir + "\stk.".
     2651   bLocked = (SEARCH (sOutFile + "xml") <> ?).
     2652   DO iRep = 1 TO 3 WHILE bLocked:
     2653      bLocked = (SEARCH (sOutFile + "lk") <> ?).
     2654      IF bLocked THEN READKEY PAUSE 1.
     2655   END.
     2656   IF bLocked THEN RETURN "LOCKED".
     2657   run bge/os_copy.p ("D", sOutFile + "xml", "", OUTPUT ErrorLevel).
     2658   IF ErrorLevel > 0 THEN RETURN "ERROR".
     2659   ASSIGN sLogFile = sHomeDir + "\" + "Actions.log".
     2660   OUTPUT STREAM stmXMLOut TO VALUE(sOutFile + "xm1") CONVERT TARGET "1251" APPEND.
     2661   RUN wp-XMLWriteLog(sLogFile, 0, "&DLine").
     2662   RUN wp-XMLWriteLog(sLogFile, 1, "XML - Вывод ОСТАТКОВ и ОБОРОТОВ").
     2663   RUN XMLWriteHeaderCat.
     2664   OUTPUT STREAM stmXMLOut CLOSE.
     2665   if p-shedule = no
     2666   then do:
     2667       run init-temphost.
     2668       for each temp-obj
     2669       :
     2670           if temp-obj.host-code <> p-host-code
     2671           then do:
     2672               delete temp-obj.
     2673           end.
     2674       end.
     2675   end.
     2676   else do:
     2677       do v-obj-counter = 1 to num-entries ( p-obj-list ) / 2
     2678       :
     2679           create temp-obj.
     2680           assign
     2681               temp-obj.obj-type = entry( v-obj-counter * 2 - 1, p-obj-list )
     2682               temp-obj.obj-code = integer( entry( v-obj-counter * 2, p-obj-list ) )
     2683           .
     2684       end.
     2685   end.
     2686   object-of-firm:
     2687   for each temp-obj
     2688   on error undo, return error substitute( "Ошибка выгрузки остатков по объекту &1 &2", temp-obj.obj-type, temp-obj.obj-code )
     2689   :
     2690       run wp-XMLWriteEDT( hEDT, 1, string(temp-obj.obj-type) + " " + string(temp-obj.obj-code) ).
     2691       run wp-XMLWriteEDT( hEDT, 4,  "Расчет архивов").
     2692       process events.
     2693       if parparentproc = ?
     2694       then do:
     2695           run bge/bge-ahzs.p (
     2696                 input temp-obj.obj-type
     2697               , input temp-obj.obj-code
     2698               , input yes
     2699               , input no
     2700               , input no
     2701               , input p-date-from
     2702               , input p-date-to
     2703               , output v-archive-ok
     2704               , output v-comment
     2705           ) no-error.
     2706       end.
     2707       else do:
     2708           run bge/bge-ahz.p (
     2709                 input parparentproc
     2710               , input temp-obj.obj-type
     2711               , input temp-obj.obj-code
     2712               , input yes
     2713               , input no
     2714               , input no
     2715               , input p-date-from
     2716               , input p-date-to
     2717               , output v-archive-ok
     2718               , output v-comment
     2719           ) no-error.
     2720       end.
     2721       if error-status :error
     2722       then do:
     2723           message
     2724           vss-workfile vss-revision vss-description
     2725           skip "Ошибка проверки архивов на объекте."
     2726           skip "Тип объекта:" temp-obj.obj-type
     2727           skip "Код объекта:" temp-obj.obj-code
     2728           skip return-value
     2729           skip trim(error-status :get-message(1))
     2730               trim(error-status :get-message(2))
     2731               trim(error-status :get-message(3))
     2732           view-as alert-box error.
     2733           undo, return error .
     2734       end.
     2735       if v-archive-ok = no
     2736       then do:
     2737           run wp-XMLWriteLog in this-procedure (
     2738                 input sLogFile
     2739               , input 1
     2740               , input substitute( "*** Остатки по объекту &1 &2 в интервале дат &3 - &4 не будут выгружены. Архивы по объекту в заданном интервале дат не целостные. &5."
     2741                                       , temp-obj.obj-type
     2742                                       , temp-obj.obj-code
     2743                                       , p-date-from
     2744                                       , p-date-to
     2745                                       , v-comment       )
     2746           ).
     2747           undo object-of-firm, next object-of-firm.
     2748       end.
     2749       process events.
     2750       run rep/get-fo.p (
     2751                       input  temp-obj.obj-type
     2752                     , input  temp-obj.obj-code
     2753                     , input  p-date-from
     2754                     , input  p-date-to
     2755                     , output v-fact-order-from
     2756                     , output v-fact-order-to
     2757                     , output v-docs-exists
     2758                    ).
     2759       if v-docs-exists = no
     2760       then do:
     2761           run wp-XMLWriteEDT( hEDT, 4, "В заданном диапазоне дат нет закрытых документов").
     2762           undo object-of-firm, next object-of-firm.
     2763       end.
     2764       run wp-XMLShowCNT(hCNT).
     2765       if p-export-supp = no
     2766       then do:
     2767           run bge/stk-oper.p (
     2768                           input temp-obj.obj-type
     2769                           , input temp-obj.obj-code
     2770                           , input p-date-from
     2771                           , input p-date-to
     2772                           , input v-fact-order-from
     2773                           , input v-fact-order-to
     2774                           , input sOutFile
     2775                           , input sLogFile
     2776                           , input hEDT
     2777                           , input hCNT
     2778           ) no-error.
     2779           if error-status :error
     2780           then do:
     2781               message
     2782                        vss-workfile vss-revision vss-description
     2783                   skip "Ошибка при выгрузке товарных остатков."
     2784                   skip return-value
     2785                   skip trim(error-status :get-message(1))
     2786                        trim(error-status :get-message(2))
     2787                        trim(error-status :get-message(3))
     2788               view-as alert-box error.
     2789               run wp-XMLWriteEDT( hEDT, 1, string(return-value)).
     2790           end.
     2791       end.
     2792       else do:
     2793           run wp-XMLWriteEDT( hEDT, 4,  "Расчет архивов по поставщикам.").
     2794           process events.
     2795           if parparentproc = ?
     2796           then do:
     2797               run bge/bge-ahzs.p (
     2798                     input temp-obj.obj-type
     2799                   , input temp-obj.obj-code
     2800                   , input no
     2801                   , input yes
     2802                   , input no
     2803                   , input p-date-from
     2804                   , input p-date-to
     2805                   , output v-archive-ok
     2806                   , output v-comment
     2807               ) no-error.
     2808           end.
     2809           else do:
     2810               run bge/bge-ahz.p (
     2811                     input parparentproc
     2812                   , input temp-obj.obj-type
     2813                   , input temp-obj.obj-code
     2814                   , input no
     2815                   , input yes
     2816                   , input no
     2817                   , input p-date-from
     2818                   , input p-date-to
     2819                   , output v-archive-ok
     2820                   , output v-comment
     2821               ) no-error.
     2822           end.
     2823           if error-status :error
     2824           then do:
     2825               message
     2826               vss-workfile vss-revision vss-description
     2827               skip "Ошибка проверки архивов по поставщикам на объекте."
     2828               skip "Тип объекта:" temp-obj.obj-type
     2829               skip "Код объекта:" temp-obj.obj-code
     2830               skip return-value
     2831               skip trim(error-status :get-message(1))
     2832                   trim(error-status :get-message(2))
     2833                   trim(error-status :get-message(3))
     2834               view-as alert-box error.
     2835               undo, return error .
     2836           end.
     2837           run bge/stk-opsp.p (
     2838                             input temp-obj.obj-type
     2839                           , input temp-obj.obj-code
     2840                           , input p-date-from
     2841                           , input p-date-to
     2842                           , input v-fact-order-from
     2843                           , input v-fact-order-to
     2844                           , input sOutFile
     2845                           , input sLogFile
     2846                           , input hEDT
     2847                           , input hCNT
     2848           ) no-error.
     2849           if error-status :error
     2850           then do:
     2851               message
     2852                   "Ошибка при выгрузке остатков по поставщикам."
     2853               view-as alert-box.
     2854               run wp-XMLWriteEDT( hEDT, 1, string(return-value)).
     2855           end.
     2856       end.
     2857       run wp-XMLHideCNT(hCNT).
     2858   end.
     2859   OUTPUT STREAM stmXMLOut TO VALUE(sOutFile + "xm1") CONVERT TARGET "1251" APPEND.
     2860   RUN wp-XMLTagClose(1, "body").
     2861   RUN wp-XMLTagClose(0, "IBS_Trade_House").
     2862   OUTPUT STREAM stmXMLOut CLOSE.
     2863   run bge/os_copy.p ("M", sOutFile + "xm1", sOutFile + "xml", OUTPUT ErrorLevel).
     2864   IF ErrorLevel > 0 THEN RETURN "ERROR".
     2865   IF OPSYS = "UNIX" THEN OS-COMMAND SILENT
     2866    chmod 666 value (sOutFile + "xml") 2>/dev/null.
     2867   RETURN.
     2868   end.
     2869   PROCEDURE XMLWriteHeaderCat:
     2870   do
     2871   on error undo, return error
     2872   :
     2873   PUT STREAM stmXMLOut UNFORMATTED "<?xml version='1.0' encoding='windows-1251'?>".
     2874   PUT STREAM stmXMLOut UNFORMATTED chr(10) +
     2875                     '<IBS_Trade_House>'.
     2876   RUN wp-XMLTagOpen(1, "header","").
     2877   RUN wp-XMLTagOpen(2, "delivery","").
     2878   RUN wp-XMLTagOpen(3, "to","").
     2879   RUN wp-XMLTagClose(3, "to").
     2880   RUN wp-XMLTagOpen(3, "from","").
     2881   RUN wp-XMLTagClose(3, "from").
     2882   RUN wp-XMLTagClose(2, "delivery").
     2883   RUN wp-XMLTagOpen(2, "manifest","").
     2884   RUN wp-XMLTagOpen(3, "document","").
     2885   RUN wp-XMLTagPut(4, "name","stk", 0).
     2886   RUN wp-XMLTagPut(4, "description","", 0).
     2887   RUN wp-XMLTagClose(3, "document").
     2888   RUN wp-XMLTagClose(2, "manifest").
     2889   RUN wp-XMLTagClose(1, "header").
     2890   RUN wp-XMLTagOpen(1, "body","").
     2891   end.
     2892   END PROCEDURE.
