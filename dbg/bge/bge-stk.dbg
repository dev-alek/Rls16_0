       88   define  temp-table temp-host no-undo
       89     field host-code like ub.store.host-code
       90     index xpk host-code
       91   .
       92   define  temp-table temp-obj no-undo
       93     field obj-type  like ub.clients.obj-type
       94     field obj-code  like ub.clients.obj-code
       95     field host-code like ub.store.host-code
       96     field db-num    like ub.clients.db-num
       97     index xpk  obj-type obj-code
       98     index xie1 host-code
       99     index xie2 db-num host-code
      100   .
      101   procedure init-temphost:
      102     define buffer buf_store   for ub.store .
      103     define buffer buf_shop    for ub.shop .
      104     define buffer buf_clients for ub.clients .
      105     define buffer buf_db for ub.db .
      106     define buffer buf_temp-host for temp-host .
      107     define buffer buf_temp-obj for temp-obj .
      108     do
      109     on error undo, return error return-value
      110     :
      111       for each buf_store
      112       on error undo, return error
      113       :
      114         find first buf_temp-host
      115           where buf_temp-host.host-code = buf_store.host-code
      116           no-error .
      117         if not available buf_temp-host
      118         then do:
      119           create buf_temp-host .
      120           assign
      121             buf_temp-host.host-code = buf_store.host-code
      122           .
      123         end.
      124         find first buf_clients no-lock
      125           where buf_clients.obj-type = 'скл':U
      126             and buf_clients.obj-code = buf_store.obj-code
      127           no-error .
      128         if not available buf_clients
      129         then do:
      130           message
      131             "Ошибка при поиске клиента" skip
      132             "Клиент" 'скл':U buf_store.obj-code skip
      133             view-as alert-box error .
      134           undo, return error .
      135         end.
      136         create buf_temp-obj .
      137         assign
      138           buf_temp-obj.obj-type  = 'скл':U
      139           buf_temp-obj.obj-code  = buf_store.obj-code
      140           buf_temp-obj.host-code = buf_store.host-code
      141           buf_temp-obj.db-num    = buf_clients.db-num
      142         .
      143       end.
      144       for each buf_shop
      145       on error undo, return error
      146       :
      147         find first buf_temp-host
      148           where buf_temp-host.host-code = buf_shop.host-code
      149           no-error .
      150         if not available buf_temp-host
      151         then do:
      152           create buf_temp-host .
      153           assign
      154             buf_temp-host.host-code = buf_shop.host-code
      155           .
      156         end.
      157         find first buf_clients no-lock
      158           where buf_clients.obj-type = 'маг':U
      159             and buf_clients.obj-code = buf_shop.obj-code
      160           no-error .
      161         if not available buf_clients then do:
      162           message
      163             "Ошибка при поиске клиента" skip
      164             "Клиент" 'маг':U buf_shop.obj-code skip
      165             view-as alert-box error .
      166           undo, return error .
      167         end.
      168         create buf_temp-obj .
      169         assign
      170           buf_temp-obj.obj-type  = 'маг':U
      171           buf_temp-obj.obj-code  = buf_shop.obj-code
      172           buf_temp-obj.host-code = buf_shop.host-code
      173           buf_temp-obj.db-num    = buf_clients.db-num
      174         .
      175       end.
      176     end.
      177   end.
      178   define variable vss-include-info1 as character format "X(65)" no-undo
      179   initial "@(#)$Workfile$ $Revision$".
      180   DEF STREAM stmXMLOut.
      181   DEF STREAM stmXMLLog.
      182   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      183   procedure cur-time :
      184      define output parameter p-today as date      no-undo .
      185      define output parameter p-time  as integer   no-undo .
      186     do
      187     on error undo, return error
      188     :
      189       define variable v-date1 as date      no-undo .
      190       define variable v-date2 as date      no-undo .
      191       define variable v-time  as integer   no-undo .
      192       assign
      193         v-date1 = today
      194         v-time  = time
      195         v-date2 = today
      196       .
      197       if v-date1 <> v-date2
      198       then do:
      199         assign
      200           v-date1 = today
      201           v-time  = v-time
      202         .
      203       end.
      204       assign
      205         p-today = v-date1
      206         p-time  = v-time
      207       .
      208     end.
      209   end.
      210   function cur-time-date returns character
      211   :
      212     return string(today, '99/99/9999':U) .
      213   end.
      214   function cur-time-mjd returns decimal
      215   :
      216     define variable v-date as date      no-undo .
      217     define variable v-time as integer   no-undo .
      218     run cur-time in this-procedure
      219       (output v-date
      220       ,output v-time
      221       ) .
      222     return integer(v-date) - 2400002 + (v-time / 86400) .
      223   end.
      224   function cur-time-get-ending-index returns integer
      225   (input p-number as integer
      226   )
      227   :
      228     if p-number < 0
      229     or p-number = ?
      230     then do:
      231       return 1 .
      232     end.
      233     define variable v-rest as integer   no-undo .
      234     assign
      235       p-number = p-number modulo 100
      236     .
      237     if p-number < 20
      238     then do:
      239       assign
      240         v-rest = p-number
      241       .
      242     end.
      243     else do:
      244       assign
      245         v-rest = p-number modulo 10
      246       .
      247     end.
      248     case v-rest :
      249       when 1
      250       then do:
      251         return 2 .
      252       end.
      253       when 2 or
      254       when 3 or
      255       when 4
      256       then do:
      257         return 3 .
      258       end.
      259       otherwise do:
      260         return 1 .
      261       end.
      262     end case .
      263   end.
      264   procedure cur-time-mjd-to-date :
      265      define input  parameter i-mjd-diff as decimal no-undo.
      266      define output parameter o-Date     as date    no-undo.
      267      define output parameter o-Time     as integer no-undo.
      268      define variable v-day-number as integer   no-undo .
      269      if    i-mjd-diff < 0
      270         or i-mjd-diff = ?
      271      then do:
      272         return "?" .
      273      end.
      274      assign
      275         v-day-number = truncate(i-mjd-diff,0).
      276         o-Date = date(v-day-number + 2400002).
      277         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      278     .
      279   end.
      280   function cur-time-mjd-to-string returns character
      281   (input p-mjd-diff as decimal
      282   )
      283   :
      284     define variable v-day-number as integer   no-undo .
      285     define variable v-seconds    as integer   no-undo .
      286     define variable v-hour       as integer   no-undo .
      287     define variable v-min        as integer   no-undo .
      288     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      289     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      290     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      291     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      292     if p-mjd-diff < 0
      293     or p-mjd-diff = ?
      294     then do:
      295       return "?" .
      296     end.
      297     assign
      298       v-day-number = integer(truncate(p-mjd-diff,0))
      299       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      300     .
      301     if v-seconds > 86400
      302     then do:
      303       assign
      304         v-seconds = 86400 - 1
      305       .
      306     end.
      307     if v-seconds < 0
      308     then do:
      309       assign
      310         v-seconds = 0
      311       .
      312     end.
      313     assign
      314       v-hour = truncate(v-seconds / 3600, 0)
      315     .
      316     assign
      317       v-seconds = v-seconds modulo 3600
      318     .
      319     assign
      320       v-min = truncate(v-seconds / 60, 0)
      321     .
      322     assign
      323       v-seconds = v-seconds modulo 60
      324     .
      325     return
      326         (if v-day-number <> 0
      327           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      328           else ""
      329         )
      330       + (if v-day-number <> 0 or v-hour <> 0
      331           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      332           else ""
      333         )
      334       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      335           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      336           else ""
      337         )
      338       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      339       .
      340   end.
      341   function cur-time-string returns character
      342   :
      343     define variable v-date as date      no-undo .
      344     define variable v-time as integer   no-undo .
      345     run cur-time in this-procedure
      346       (output v-date
      347       ,output v-time
      348       ) .
      349     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      350   end.
      351   function cur-time-string-sec returns character
      352   :
      353     define variable v-date as date      no-undo .
      354     define variable v-time as integer   no-undo .
      355     run cur-time in this-procedure
      356       (output v-date
      357       ,output v-time
      358       ) .
      359     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      360   end.
      361   function cur-time-custom  returns character
      362   (input p-prefix as character
      363   ,input p-date-format as character
      364   ,input p-delimiter as character
      365   ,input p-time-format as character
      366   ,input p-suffix as character
      367   )
      368   :
      369     define variable v-date as date      no-undo .
      370     define variable v-time as integer   no-undo .
      371     run cur-time in this-procedure
      372       (output v-date
      373       ,output v-time
      374       ) .
      375     return
      376       p-prefix
      377       + string(v-date, p-date-format)
      378       + p-delimiter
      379       + string(v-time, p-time-format)
      380       + p-suffix
      381       .
      382   end.
      383   function cur-time-print  returns character
      384   :
      385     define variable v-date as date      no-undo .
      386     define variable v-time as integer   no-undo .
      387     run cur-time in this-procedure
      388       (output v-date
      389       ,output v-time
      390       ) .
      391     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      392   end.
      393   function cur-time-datetime returns datetime
      394   :
      395     define variable v-char as character no-undo .
      396     define variable v-datetime as datetime no-undo .
      397     v-char = cur-time-string().
      398     v-datetime = datetime(v-char).
      399     return  v-datetime.
      400   end.
      401   function cur-time-string-msec returns character
      402   :
      403     define variable v-date as datetime  no-undo .
      404     v-date = now.
      405     return string(v-date) .
      406   end.
      407   define variable vss-include-info3 as character format "X(65)" no-undo
      408   initial "@(#)$Workfile$ $Revision$".
      409   procedure xmlchar-test :
      410   define input parameter p-in-string          as character        no-undo.
      411   define output parameter p-out-string-enc    as character        no-undo.
      412   define output parameter p-out-string-dec    as character        no-undo.
      413   do
      414   on error undo, return error
      415   :
      416          run xmlchar-encode in this-procedure
      417       (
      418             input p-in-string
      419           , output p-out-string-enc
      420       ).
      421          run xmlchar-decode in this-procedure
      422       (
      423             input p-out-string-enc
      424           , output p-out-string-dec
      425       ).
      426   end.
      427   end .
      428   procedure xmlchar-encode :
      429   define input parameter p-in-string      as character        no-undo.
      430   define output parameter p-out-string    as character        no-undo.
      431       define variable v-position      as integer      no-undo.
      432       define variable v-current-char  as character    no-undo.
      433   do
      434   on error undo, return error
      435   :
      436       assign
      437           p-out-string = "":U
      438       .
      439       case p-in-string
      440       :
      441           when ?
      442           then do:
      443               assign
      444                   p-out-string = "?":U
      445               .
      446           end.
      447           when "?":U
      448           then do:
      449               assign
      450                   p-out-string = "&#63;":U
      451               .
      452           end.
      453           otherwise do:
      454               do v-position = 1 to length( p-in-string )
      455               :
      456                   assign
      457                       v-current-char = substring( p-in-string, v-position, 1 )
      458                   .
      459                   case v-current-char
      460                   :
      461                       when "&":U
      462                       then do:
      463                           assign
      464                               p-out-string = p-out-string + "&amp;":U
      465                           .
      466                       end.
      467                       when ">":U
      468                       then do:
      469                           assign
      470                               p-out-string = p-out-string + "&gt;":U
      471                           .
      472                       end.
      473                       when "<":U
      474                       then do:
      475                           assign
      476                               p-out-string = p-out-string + "&lt;":U
      477                           .
      478                       end.
      479                       when "'":U
      480                       then do:
      481                           assign
      482                               p-out-string = p-out-string + "&apos;":U
      483                           .
      484                       end.
      485                       when '"':U
      486                       then do:
      487                           assign
      488                               p-out-string = p-out-string + "&quot;":U
      489                           .
      490                       end.
      491                       when chr(1)
      492                       then do:
      493                           assign
      494                               p-out-string = p-out-string + "":U
      495                           .
      496                       end.
      497                       when chr(2)
      498                       then do:
      499                           assign
      500                               p-out-string = p-out-string + "":U
      501                           .
      502                       end.
      503                       when chr(3)
      504                       then do:
      505                           assign
      506                               p-out-string = p-out-string + "":U
      507                           .
      508                       end.
      509                       when chr(4)
      510                       then do:
      511                           assign
      512                               p-out-string = p-out-string + "":U
      513                           .
      514                       end.
      515                       when chr(5)
      516                       then do:
      517                           assign
      518                               p-out-string = p-out-string + "":U
      519                           .
      520                       end.
      521                       when chr(6)
      522                       then do:
      523                           assign
      524                               p-out-string = p-out-string + "":U
      525                           .
      526                       end.
      527                       when chr(7)
      528                       then do:
      529                           assign
      530                               p-out-string = p-out-string + "":U
      531                           .
      532                       end.
      533                       when chr(8)
      534                       then do:
      535                           assign
      536                               p-out-string = p-out-string + "":U
      537                           .
      538                       end.
      539                       when chr(9)
      540                       then do:
      541                           assign
      542                               p-out-string = p-out-string + "":U
      543                           .
      544                       end.
      545                       when chr(29)
      546                       then do:
      547                           assign
      548                               p-out-string = p-out-string + "":U
      549                           .
      550                       end.
      551                       when chr(10)
      552                       then do:
      553                           assign
      554                               p-out-string = p-out-string + "&#10;":U
      555                           .
      556                       end.
      557                       when chr(13)
      558                       then do:
      559                           assign
      560                               p-out-string = p-out-string + "&#13;":U
      561                           .
      562                       end.
      563                       otherwise do:
      564                           assign
      565                               p-out-string = p-out-string + v-current-char
      566                           .
      567                       end.
      568                   end case.
      569               end.
      570           end.
      571       end case.
      572   end.
      573   end .
      574   procedure xmlchar-encode-1c :
