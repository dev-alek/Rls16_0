      641                           .
      642                       end.
      643                       when chr(8)
      644                       then do:
      645                           assign
      646                               p-out-string = p-out-string + " ":U
      647                           .
      648                       end.
      649                       when chr(9)
      650                       then do:
      651                           assign
      652                               p-out-string = p-out-string + " ":U
      653                           .
      654                       end.
      655                       when chr(29)
      656                       then do:
      657                           assign
      658                               p-out-string = p-out-string + " ":U
      659                           .
      660                       end.
      661                       when chr(10)
      662                       then do:
      663                           assign
      664                               p-out-string = p-out-string + " ":U
      665                           .
      666                       end.
      667                       when chr(13)
      668                       then do:
      669                           assign
      670                               p-out-string = p-out-string + " ":U
      671                           .
      672                       end.
      673                       otherwise do:
      674                           assign
      675                               p-out-string = p-out-string + v-current-char
      676                           .
      677                       end.
      678                   end case.
      679               end.
      680           end.
      681       end case.
      682   end.
      683   end .
      684   procedure xmlchar-decode :
      685   define input parameter p-in-string      as character        no-undo.
      686   define output parameter p-out-string    as character        no-undo.
      687       define variable v-position      as integer      no-undo.
      688       define variable v-last-position as integer      no-undo.
      689       define variable v-temp-integer  as integer      no-undo.
      690       define variable v-current-char  as character    no-undo.
      691       define variable v-next-char     as character    no-undo.
      692       define variable v-success       as logical      no-undo.
      693   do
      694   on error undo, return error
      695   :
      696       assign
      697           p-out-string = "":U
      698           v-position   = 0
      699       .
      700       replace-cycle:
      701       do while yes
      702       on error undo, return error
      703       :
      704           assign
      705               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      706           .
      707           if v-last-position <= v-position
      708           then do:
      709               if v-position = 0
      710               then do:
      711                   assign
      712                       p-out-string = p-in-string
      713                   .
      714               end.
      715               else do:
      716                   assign
      717                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      718                   .
      719               end.
      720               leave replace-cycle.
      721           end.
      722           else do:
      723               assign
      724                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      725                   v-position      = v-last-position
      726                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      727               .
      728               if v-current-char = "#":U
      729               then do:
      730                   assign
      731                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      732                   .
      733                   if v-last-position > 0
      734                   then do:
      735                       run xmlchar-read-integer in this-procedure
      736                        (
      737                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      738                           , output v-temp-integer
      739                           , output v-success
      740                       ).
      741                       if v-success = yes
      742                       and v-temp-integer >= 1
      743                       and v-temp-integer <= 255
      744                       then do:
      745                           assign
      746                               p-out-string = p-out-string + chr( v-temp-integer )
      747                               v-position   = v-last-position + 1
      748                           .
      749                       end.
      750                       else do:
      751                           assign
      752                               p-out-string = p-out-string + "&":U
      753                               v-position   = v-position   + 1
      754                           .
      755                       end.
      756                   end.
      757                   else do:
      758                       assign
      759                           p-out-string = p-out-string + "&":U
      760                           v-position   = v-position   + 1
      761                       .
      762                   end.
      763               end.
      764               else do:
      765                   case substring( p-in-string, v-position + 1, 3 )
      766                   :
      767                       when "lt;":U
      768                       then do:
      769                           assign
      770                               p-out-string = p-out-string + "<":U
      771                               v-position   = v-position   + 3
      772                           .
      773                       end.
      774                       when "gt;":U
      775                       then do:
      776                           assign
      777                               p-out-string = p-out-string + ">":U
      778                               v-position   = v-position   + 3
      779                           .
      780                       end.
      781                       otherwise do:
      782                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      783                           then do:
      784                               assign
      785                                   p-out-string = p-out-string + "&":U
      786                                   v-position   = v-position   + 4
      787                               .
      788                           end.
      789                           else do:
      790                               case substring( p-in-string, v-position + 1, 5 )
      791                               :
      792                                   when "quot;":U
      793                                   then do:
      794                                       assign
      795                                           p-out-string = p-out-string + '"':U
      796                                           v-position   = v-position   + 5
      797                                       .
      798                                   end.
      799                                   when "apos;":U
      800                                   then do:
      801                                       assign
      802                                           p-out-string = p-out-string + "'":U
      803                                           v-position   = v-position   + 5
      804                                       .
      805                                   end.
      806                                   otherwise do:
      807                                       assign
      808                                           p-out-string = p-out-string + "&":U
      809                                       .
      810                                   end.
      811                               end case.
      812                           end.
      813                       end.
      814                   end case.
      815               end.
      816           end.
      817       end.
      818   end.
      819   end .
      820   procedure xmlchar-read-integer :
      821   define input parameter p-input-string      as character        no-undo.
      822   define output parameter p-output-integer   as integer          no-undo.
      823   define output parameter p-success       as logical          no-undo.
      824   do
      825   on error undo, return error
      826   :
      827       assign
      828           p-output-integer = integer( p-input-string )
      829       no-error.
      830       if error-status :error
      831       then do:
      832           assign
      833               p-success           = no
      834               p-output-integer    = 0
      835           .
      836       end.
      837       else do:
      838           assign
      839               p-success           = yes
      840           .
      841       end.
      842   end.
      843   end.
      844   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      845   procedure strtdate :
      846     define input  parameter p-str         as character no-undo .
      847     define output parameter p-value       as date      no-undo .
      848     define output parameter p-data-valid  as logical   no-undo .
      849     define output parameter p-message     as character no-undo .
      850   do
      851   on error undo, return error return-value
      852   :
      853     define variable v-value       as date      no-undo .
      854     define variable v-i           as integer   no-undo .
      855     define variable v-num         as integer   no-undo .
      856     define variable v-delim       as character no-undo .
      857     define variable v-delim-list  as character no-undo .
      858     define variable v-day         as integer   no-undo .
      859     define variable v-month       as integer   no-undo .
      860     define variable v-year        as integer   no-undo .
      861     define variable v-day-str     as character no-undo .
      862     define variable v-month-str   as character no-undo .
      863     define variable v-year-str    as character no-undo .
      864     assign
      865       p-value       = ?
      866       p-data-valid  = false
      867     .
      868     if p-str = ?
      869     then do:
      870       assign
      871         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      872       .
      873       return .
      874     end.
      875     if p-str = ""
      876     then do:
      877       assign
      878         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      879       .
      880       return .
      881     end.
      882     if length(p-str)  > 10
      883     then do:
      884       assign
      885         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      886       .
      887       return .
      888     end.
      889     assign
      890       v-delim-list = '/,-,.':U
      891     .
      892     _delim:
      893     do v-i = 1 to num-entries( v-delim-list )
      894     :
      895       assign
      896         v-delim = entry( v-i , v-delim-list )
      897         v-num   = num-entries( p-str , v-delim )
      898       .
      899       if v-num <> 3
      900       then do:
      901         assign
      902           v-delim = ''
      903         .
      904       end.
      905       else do:
      906         leave _delim.
      907       end.
      908     end.
      909     if v-delim = ''
      910     then do:
      911       assign
      912         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      913       .
      914       return .
      915     end.
      916     assign
      917       v-day-str   = entry( 1, p-str , v-delim)
      918       v-month-str = entry( 2, p-str , v-delim)
      919       v-year-str  = entry( 3, p-str , v-delim)
      920     .
      921     if  length(v-day-str) > 2   or
      922         length(v-day-str) < 1   or
      923         length(v-month-str) > 2 or
      924         length(v-month-str) < 1 or
      925         (
      926           length(v-year-str) <> 2 and
      927           length(v-year-str) <> 4
      928         )
      929     then do:
      930       assign
      931         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      932       .
      933       return .
      934     end.
      935     if length( v-year-str ) = 2
      936     then do:
      937       assign
      938         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      939       .
      940     end.
      941     assign
      942       v-day   = integer( v-day-str )
      943       v-month = integer( v-month-str)
      944       v-year  = integer( v-year-str)
      945     no-error .
      946     if error-status :error
      947     then do:
      948       assign
      949         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      950       .
      951       return .
      952     end.
      953     if v-day < 1  or
      954        v-day > 31 or
      955        v-month < 1 or
      956        v-month > 12 or
      957        v-year < 0   or
      958        v-year > 5000
      959     then do:
      960       assign
      961         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      962       .
      963       return .
      964     end.
      965     assign
      966       v-value = date( v-month, v-day, v-year )
      967     no-error .
      968     if error-status :error
      969     then do:
      970       assign
      971         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      972       .
      973       return .
      974     end.
      975     assign
      976       p-value       = v-value
      977       p-data-valid  = true
      978     .
      979   end.
      980   end procedure.
      981   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      982   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
