        1   block-level on error undo, throw.
        2   define input        parameter p-action         as   character    no-undo .
        3   define input        parameter p-esys-id        like ub.ext-system.esys-id no-undo .
        4   define input        parameter p-db-num         like ub.ext-system.db-num no-undo .
        5   define input        parameter p-delivery-method as integer   no-undo .
        6   define input        parameter oxml-exch-dir    as character no-undo .
        7   define input        parameter oxml-heap-dir    as character no-undo .
        8   define output       parameter p-source-dir     as   character    no-undo .
        9   define output       parameter p-target-dir     as   character    no-undo .
       10   define output       parameter p-temp-dir       as   character    no-undo .
       11   define output       parameter p-log-file-name  as character no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "Формирование для ВС имён директорий для обмена файлами".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   function esys-id-format returns character ( input p-esys-id as integer):
       77     return string(p-esys-id, "99999").
       78   end.
       79   FUNCTION nws-db-format returns character ( input p-db-num as integer):
       80     define variable v-nws-db-format as character no-undo .
       81     assign
       82       v-nws-db-format = string( p-db-num,  (if p-db-num > 999 then "99999":U else "999":U ) )
       83     .
       84     return v-nws-db-format.
       85   END FUNCTION.
       86     define variable v-esysid-str as character no-undo .
       87     define variable v-dbnum-str  as character no-undo .
       88     define variable v-work-dir   as character no-undo .
       89     assign
       90       v-esysid-str = esys-id-format( p-esys-id )
       91       v-dbnum-str  = nws-db-format( ibs.th.gbl.gbl-var:g#db-num )
       92     .
       93     case p-action :
       94       when "get":U
       95       or
       96       when "fget":U
       97       then do:
       98         assign
       99           v-work-dir   = "ES" + v-esysid-str + "-":U + v-dbnum-str
      100           p-temp-dir   = oxml-exch-dir + chr(92) + v-work-dir + ".":U + v-esysid-str
      101           p-source-dir = oxml-exch-dir + chr(92) + v-work-dir
      102           p-target-dir = oxml-heap-dir + chr(92) + v-work-dir
      103           p-log-file-name  =  (if p-delivery-method = integer('3':U)
      104                               then (oxml-heap-dir + chr(92) + v-dbnum-str + "-":U + "ES" + v-esysid-str)
      105                               else (oxml-heap-dir + chr(92) + "actions.log")
      106                               )
      107         .
      108       end.
      109       when "put":U
      110       or
      111       when "fput"
      112       then do:
      113         assign
      114           v-work-dir   = v-dbnum-str + "-":U + "ES" + v-esysid-str
      115           p-temp-dir   = oxml-exch-dir + chr(92) + v-work-dir + ".":U + v-dbnum-str
      116           p-source-dir = oxml-heap-dir + chr(92) + v-work-dir
      117           p-target-dir = oxml-exch-dir + chr(92) + v-work-dir
      118           p-log-file-name  =  oxml-heap-dir + chr(92) + "actions.log"
      119         .
      120       end.
      121       otherwise do:
      122         message
      123           vss-workfile vss-revision vss-description skip
      124           "Не предусмотрена операция" p-action "для" vss-workfile
      125           view-as alert-box error.
      126         return error.
      127       end.
      128     end case.
