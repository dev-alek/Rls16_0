     1489   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1490   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1491   procedure cp-attr-code :
     1492     do
     1493     on error undo, return error
     1494     :
     1495       define input  parameter p-code           as character no-undo .
     1496       define output parameter p-type           as character no-undo .
     1497       define output parameter p-format         as character no-undo .
     1498       define output parameter p-label          as character no-undo .
     1499       define output parameter p-range          as integer   no-undo .
     1500       define output parameter p-user-can-edit  as logical   no-undo .
     1501       define output parameter p-output-display as logical   no-undo .
     1502       define output parameter p-other          as character no-undo .
     1503       case p-code :
     1504               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     1505               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
     1506               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
     1507               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
     1508               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     1509               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
     1510               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1511               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1512               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1513               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
     1514         otherwise do:
     1515           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
     1516         end.
     1517       end.
     1518     end.
     1519   end procedure.
     1520   procedure cp-attr-tooltip :
     1521     do
     1522     on error undo, return error
     1523     :
     1524       define input  parameter p-code    as character no-undo .
     1525       define output parameter p-tooltip as character no-undo .
     1526       define output parameter p-label   as character no-undo .
     1527       case p-code :
     1528               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
     1529               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
     1530               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
     1531               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
     1532               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
     1533               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
     1534               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
     1535               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
     1536               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
     1537               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
     1538         otherwise do:
     1539           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
     1540         end.
     1541       end.
     1542     end.
     1543   end procedure.
     1544   procedure cp-attr-value :
     1545     do
     1546     on error undo, return error
     1547     :
     1548       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1549       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1550       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1551       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1552       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1553       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
     1554       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
     1555       define output parameter p-type        as character no-undo .
     1556       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1557       define variable v-format         as character no-undo .
     1558       define variable v-label          as character no-undo .
     1559       define variable v-range          as integer   no-undo .
     1560       define variable v-user-can-edit  as logical   no-undo .
     1561       define variable v-output-display as logical   no-undo .
     1562       define variable v-other          as character no-undo .
     1563       run cp-attr-code in this-procedure
     1564         (input  p-code
     1565         ,output p-type
     1566         ,output v-format
     1567         ,output v-label
     1568         ,output v-range
     1569         ,output v-user-can-edit
     1570         ,output v-output-display
     1571         ,output v-other
     1572         ) no-error .
     1573       if error-status :error then do:
     1574         undo, return error return-value .
     1575       end.
     1576       find first buf_cash-pay-attr no-lock
     1577         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1578           and buf_cash-pay-attr.curr-code  = p-curr-code
     1579           and buf_cash-pay-attr.host-code  = p-host-code
     1580           and buf_cash-pay-attr.obj-type   = p-obj-type
     1581           and buf_cash-pay-attr.obj-code   = p-obj-code
     1582           and buf_cash-pay-attr.attr-code  = p-code
     1583         no-error .
     1584       if avail buf_cash-pay-attr then do:
     1585         assign
     1586           p-value =  buf_cash-pay-attr.attr-value
     1587         .
     1588       end.
     1589       else do:
     1590         assign
     1591           p-value = if p-type = 'L':U then "no":U else ""
     1592         .
     1593       end.
     1594     end.
     1595   end procedure.
     1596   procedure cp-attr-write :
     1597     do
     1598     on error undo, return error
     1599     :
     1600       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1601       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1602       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1603       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1604       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1605       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1606       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
     1607       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1608       define buffer last_cash-pay-attr for ub.cash-pay-attr .
     1609       define variable v-type           as character no-undo .
     1610       define variable v-format         as character no-undo .
     1611       define variable v-label          as character no-undo .
     1612       define variable v-range          as integer   no-undo .
     1613       define variable v-user-can-edit  as logical   no-undo .
     1614       define variable v-output-display as logical   no-undo .
     1615       define variable v-other          as character no-undo .
     1616       run cp-attr-code in this-procedure
     1617         (input  p-code
     1618         ,output v-type
     1619         ,output v-format
     1620         ,output v-label
     1621         ,output v-range
     1622         ,output v-user-can-edit
     1623         ,output v-output-display
     1624         ,output v-other
     1625         ) no-error .
     1626       if error-status :error then do:
     1627         undo, return error return-value .
     1628       end.
     1629       find first buf_cash-pay-attr exclusive-lock
     1630         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1631           and buf_cash-pay-attr.curr-code  = p-curr-code
     1632           and buf_cash-pay-attr.host-code  = p-host-code
     1633           and buf_cash-pay-attr.obj-type   = p-obj-type
     1634           and buf_cash-pay-attr.obj-code   = p-obj-code
     1635           and buf_cash-pay-attr.attr-code = p-code
     1636         no-error .
     1637       if not available buf_cash-pay-attr then do:
     1638         create buf_cash-pay-attr .
     1639         assign
     1640         buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1641         buf_cash-pay-attr.curr-code  = p-curr-code
     1642         buf_cash-pay-attr.host-code  = p-host-code
     1643         buf_cash-pay-attr.obj-type   = p-obj-type
     1644         buf_cash-pay-attr.obj-code   = p-obj-code
     1645         buf_cash-pay-attr.attr-code = p-code
     1646         .
     1647       end.
     1648       assign
     1649         buf_cash-pay-attr.attr-value = p-value
     1650       .
     1651       release buf_cash-pay-attr no-error .
     1652       if error-status:error then do:
     1653         undo, return error return-value .
     1654       end.
     1655     end.
     1656   end procedure.
     1657   procedure cp-attr-exist :
