     1787               when 'form_km3':U then do:     assign     p-hist = true.   end.
     1788               when 'bal_malina':U then do:     assign     p-hist = true.   end.
     1789               when 'max_proc_sum':U then do:     assign     p-hist = true.   end.
     1790               when 'mask_card_kup':U then do:     assign     p-hist = true.   end.
     1791         otherwise do:
     1792           p-hist = no.
     1793         end.
     1794       end.
     1795     end.
     1796   end procedure.
