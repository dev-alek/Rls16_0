      108   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      109   procedure cur-time :
      110      define output parameter p-today as date      no-undo .
      111      define output parameter p-time  as integer   no-undo .
      112     do
      113     on error undo, return error
      114     :
      115       define variable v-date1 as date      no-undo .
      116       define variable v-date2 as date      no-undo .
      117       define variable v-time  as integer   no-undo .
      118       assign
      119         v-date1 = today
      120         v-time  = time
      121         v-date2 = today
      122       .
      123       if v-date1 <> v-date2
      124       then do:
      125         assign
      126           v-date1 = today
      127           v-time  = v-time
      128         .
      129       end.
      130       assign
      131         p-today = v-date1
      132         p-time  = v-time
      133       .
      134     end.
      135   end.
      136   function cur-time-date returns character
      137   :
      138     return string(today, '99/99/9999':U) .
      139   end.
      140   function cur-time-mjd returns decimal
      141   :
      142     define variable v-date as date      no-undo .
      143     define variable v-time as integer   no-undo .
      144     run cur-time in this-procedure
      145       (output v-date
      146       ,output v-time
      147       ) .
      148     return integer(v-date) - 2400002 + (v-time / 86400) .
      149   end.
      150   function cur-time-get-ending-index returns integer
      151   (input p-number as integer
      152   )
      153   :
      154     if p-number < 0
      155     or p-number = ?
      156     then do:
      157       return 1 .
      158     end.
      159     define variable v-rest as integer   no-undo .
      160     assign
      161       p-number = p-number modulo 100
      162     .
      163     if p-number < 20
      164     then do:
      165       assign
      166         v-rest = p-number
      167       .
      168     end.
      169     else do:
      170       assign
      171         v-rest = p-number modulo 10
      172       .
      173     end.
      174     case v-rest :
      175       when 1
      176       then do:
      177         return 2 .
      178       end.
      179       when 2 or
      180       when 3 or
      181       when 4
      182       then do:
      183         return 3 .
      184       end.
      185       otherwise do:
      186         return 1 .
      187       end.
      188     end case .
      189   end.
      190   procedure cur-time-mjd-to-date :
      191      define input  parameter i-mjd-diff as decimal no-undo.
      192      define output parameter o-Date     as date    no-undo.
      193      define output parameter o-Time     as integer no-undo.
      194      define variable v-day-number as integer   no-undo .
      195      if    i-mjd-diff < 0
      196         or i-mjd-diff = ?
      197      then do:
      198         return "?" .
      199      end.
      200      assign
      201         v-day-number = truncate(i-mjd-diff,0).
      202         o-Date = date(v-day-number + 2400002).
      203         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      204     .
      205   end.
      206   function cur-time-mjd-to-string returns character
      207   (input p-mjd-diff as decimal
      208   )
      209   :
      210     define variable v-day-number as integer   no-undo .
      211     define variable v-seconds    as integer   no-undo .
      212     define variable v-hour       as integer   no-undo .
      213     define variable v-min        as integer   no-undo .
      214     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      215     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      216     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      217     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      218     if p-mjd-diff < 0
      219     or p-mjd-diff = ?
      220     then do:
      221       return "?" .
      222     end.
      223     assign
      224       v-day-number = integer(truncate(p-mjd-diff,0))
      225       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      226     .
      227     if v-seconds > 86400
      228     then do:
      229       assign
      230         v-seconds = 86400 - 1
      231       .
      232     end.
      233     if v-seconds < 0
      234     then do:
      235       assign
      236         v-seconds = 0
      237       .
      238     end.
      239     assign
      240       v-hour = truncate(v-seconds / 3600, 0)
      241     .
      242     assign
      243       v-seconds = v-seconds modulo 3600
      244     .
      245     assign
      246       v-min = truncate(v-seconds / 60, 0)
      247     .
      248     assign
      249       v-seconds = v-seconds modulo 60
      250     .
      251     return
      252         (if v-day-number <> 0
      253           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      254           else ""
      255         )
      256       + (if v-day-number <> 0 or v-hour <> 0
      257           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      258           else ""
      259         )
      260       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      261           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      262           else ""
      263         )
      264       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      265       .
      266   end.
      267   function cur-time-string returns character
      268   :
      269     define variable v-date as date      no-undo .
      270     define variable v-time as integer   no-undo .
      271     run cur-time in this-procedure
      272       (output v-date
      273       ,output v-time
      274       ) .
      275     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      276   end.
      277   function cur-time-string-sec returns character
      278   :
      279     define variable v-date as date      no-undo .
      280     define variable v-time as integer   no-undo .
      281     run cur-time in this-procedure
      282       (output v-date
      283       ,output v-time
      284       ) .
      285     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      286   end.
      287   function cur-time-custom  returns character
      288   (input p-prefix as character
      289   ,input p-date-format as character
      290   ,input p-delimiter as character
      291   ,input p-time-format as character
      292   ,input p-suffix as character
      293   )
      294   :
      295     define variable v-date as date      no-undo .
      296     define variable v-time as integer   no-undo .
      297     run cur-time in this-procedure
      298       (output v-date
      299       ,output v-time
      300       ) .
      301     return
      302       p-prefix
      303       + string(v-date, p-date-format)
      304       + p-delimiter
      305       + string(v-time, p-time-format)
      306       + p-suffix
      307       .
      308   end.
      309   function cur-time-print  returns character
      310   :
      311     define variable v-date as date      no-undo .
      312     define variable v-time as integer   no-undo .
      313     run cur-time in this-procedure
      314       (output v-date
      315       ,output v-time
      316       ) .
      317     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      318   end.
      319   function cur-time-datetime returns datetime
      320   :
      321     define variable v-char as character no-undo .
      322     define variable v-datetime as datetime no-undo .
      323     v-char = cur-time-string().
      324     v-datetime = datetime(v-char).
      325     return  v-datetime.
      326   end.
      327   function cur-time-string-msec returns character
      328   :
      329     define variable v-date as datetime  no-undo .
      330     v-date = now.
      331     return string(v-date) .
      332   end.
      333   define variable vss-include-info2 as character format "X(65)" no-undo
      334   initial "@(#)$Workfile$ $Revision$".
      335   procedure xmlchar-test :
      336   define input parameter p-in-string          as character        no-undo.
      337   define output parameter p-out-string-enc    as character        no-undo.
      338   define output parameter p-out-string-dec    as character        no-undo.
      339   do
      340   on error undo, return error
      341   :
      342          run xmlchar-encode in this-procedure
      343       (
      344             input p-in-string
      345           , output p-out-string-enc
      346       ).
      347          run xmlchar-decode in this-procedure
      348       (
      349             input p-out-string-enc
      350           , output p-out-string-dec
      351       ).
      352   end.
      353   end .
      354   procedure xmlchar-encode :
      355   define input parameter p-in-string      as character        no-undo.
      356   define output parameter p-out-string    as character        no-undo.
      357       define variable v-position      as integer      no-undo.
      358       define variable v-current-char  as character    no-undo.
      359   do
      360   on error undo, return error
      361   :
      362       assign
      363           p-out-string = "":U
      364       .
      365       case p-in-string
      366       :
      367           when ?
      368           then do:
      369               assign
      370                   p-out-string = "?":U
      371               .
      372           end.
      373           when "?":U
      374           then do:
      375               assign
      376                   p-out-string = "&#63;":U
      377               .
      378           end.
      379           otherwise do:
      380               do v-position = 1 to length( p-in-string )
      381               :
      382                   assign
      383                       v-current-char = substring( p-in-string, v-position, 1 )
      384                   .
      385                   case v-current-char
      386                   :
      387                       when "&":U
      388                       then do:
      389                           assign
      390                               p-out-string = p-out-string + "&amp;":U
      391                           .
      392                       end.
      393                       when ">":U
      394                       then do:
      395                           assign
      396                               p-out-string = p-out-string + "&gt;":U
      397                           .
      398                       end.
      399                       when "<":U
      400                       then do:
      401                           assign
      402                               p-out-string = p-out-string + "&lt;":U
      403                           .
      404                       end.
      405                       when "'":U
      406                       then do:
      407                           assign
      408                               p-out-string = p-out-string + "&apos;":U
      409                           .
      410                       end.
      411                       when '"':U
      412                       then do:
      413                           assign
      414                               p-out-string = p-out-string + "&quot;":U
      415                           .
      416                       end.
      417                       when chr(1)
      418                       then do:
      419                           assign
      420                               p-out-string = p-out-string + "":U
      421                           .
      422                       end.
      423                       when chr(2)
      424                       then do:
      425                           assign
      426                               p-out-string = p-out-string + "":U
      427                           .
      428                       end.
      429                       when chr(3)
      430                       then do:
      431                           assign
      432                               p-out-string = p-out-string + "":U
      433                           .
      434                       end.
      435                       when chr(4)
      436                       then do:
      437                           assign
      438                               p-out-string = p-out-string + "":U
      439                           .
      440                       end.
      441                       when chr(5)
      442                       then do:
      443                           assign
      444                               p-out-string = p-out-string + "":U
      445                           .
      446                       end.
      447                       when chr(6)
      448                       then do:
      449                           assign
      450                               p-out-string = p-out-string + "":U
      451                           .
      452                       end.
      453                       when chr(7)
      454                       then do:
      455                           assign
      456                               p-out-string = p-out-string + "":U
      457                           .
      458                       end.
      459                       when chr(8)
      460                       then do:
      461                           assign
      462                               p-out-string = p-out-string + "":U
      463                           .
      464                       end.
      465                       when chr(9)
      466                       then do:
      467                           assign
      468                               p-out-string = p-out-string + "":U
      469                           .
      470                       end.
      471                       when chr(29)
      472                       then do:
      473                           assign
      474                               p-out-string = p-out-string + "":U
      475                           .
      476                       end.
      477                       when chr(10)
      478                       then do:
      479                           assign
      480                               p-out-string = p-out-string + "&#10;":U
      481                           .
      482                       end.
      483                       when chr(13)
      484                       then do:
      485                           assign
      486                               p-out-string = p-out-string + "&#13;":U
      487                           .
      488                       end.
      489                       otherwise do:
      490                           assign
      491                               p-out-string = p-out-string + v-current-char
      492                           .
      493                       end.
      494                   end case.
      495               end.
      496           end.
      497       end case.
      498   end.
      499   end .
      500   procedure xmlchar-encode-1c :
