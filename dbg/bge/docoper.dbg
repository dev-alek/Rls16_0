     4426                               end.
     4427                               run bgelib-tag-put in this-procedure ( input 1, input "qnty"        , input string( v-is-out * treal-4.qnty1 )  , input 3 ).
     4428                               run bgelib-tag-put in this-procedure ( input 1, input "sumr"        , input string( v-is-out * treal-4.netto-rubl )  , input 2 ).
     4429                               run bgelib-tag-put in this-procedure ( input 1, input "sumb"        , input string( v-is-out * treal-4.netto )  , input 2 ).
     4430                               run bgelib-tag-close in this-procedure ( input 0
     4431                                                                       , input (if treal-4.prefix = '':U
     4432                                                                               then "linePayCode"
     4433                                                                               else "linePayCodeCard" )
     4434                                                                               ).
     4435                           end.
     4436                       end.
     4437                   end case.
     4438               end.
     4439           end.
     4440       end.
     4441   end.
     4442   end procedure.
     4443   procedure fill_bgelib_goods :
     4444   define input parameter p-parent-handle  as handle           no-undo.
     4445   define input parameter p-gds-code       as integer          no-undo.
     4446   do
     4447   on error undo, return error
     4448   :
     4449       if p-parent-handle :get-signature( "cb-fill_bgelib_goods" ) <> "":U
     4450       then do:
     4451           run cb-fill_bgelib_goods in p-parent-handle (
     4452               input p-gds-code
     4453           ).
     4454       end.
     4455   end.
     4456   end procedure.
     4457   procedure fill_bgelib_clients :
     4458   define input parameter p-parent-handle  as handle           no-undo.
     4459   define input parameter p-obj-type       as character        no-undo.
     4460   define input parameter p-obj-code       as integer          no-undo.
     4461   do
     4462   on error undo, return error
     4463   :
     4464       if p-parent-handle :get-signature( "cb-fill_bgelib_clients" ) <> "":U
     4465       then do:
     4466           run cb-fill_bgelib_clients in p-parent-handle (
     4467                 input p-obj-type
     4468               , input p-obj-code
     4469           ).
     4470       end.
     4471   end.
     4472   end procedure.
