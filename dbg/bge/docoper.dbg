     1687         undo, return error return-value .
     1688       end.
     1689       find first buf_cash-pay-attr exclusive-lock
     1690         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1691           and buf_cash-pay-attr.curr-code  = p-curr-code
     1692           and buf_cash-pay-attr.host-code  = p-host-code
     1693           and buf_cash-pay-attr.obj-type   = p-obj-type
     1694           and buf_cash-pay-attr.obj-code   = p-obj-code
     1695           and buf_cash-pay-attr.attr-code = p-code
