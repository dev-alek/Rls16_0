     2080           assign
     2081               v-doc-code      = buf_ot-tot-crsa-loop.doc-code
     2082               v-obj-type      = buf_ot-tot-crsa-loop.obj-type
     2083               v-obj-code      = buf_ot-tot-crsa-loop.obj-code
     2084               v-fact-order    = buf_ot-tot-crsa-loop.fact-order
     2085           .
     2086           case p-ext-doc-type
     2087           :
     2088               when 'ot':U
     2089               then do:
     2090                   find first buf_ot-tot-sale no-lock
     2091                        where buf_ot-tot-sale.doc-code = v-doc-code
     2092                          and buf_ot-tot-sale.sum-type = 'crsa':U
     2093                          and buf_ot-tot-sale.cat-id   = buf_ot-tot-crsa-loop.cat-id
     2094                   no-error.
