     1804   curr-code
     1805   .
     1806   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1807   procedure cpapcep:
     1808   define variable ii as integer no-undo .
     1809   define buffer buf_cash-pay for ub.cash-pay.
     1810   define buffer buf_cash-pay-attr for ub.cash-pay-attr.
     1811   define buffer buf_temp-cpa-pcep for temp-cpa-pcep.
     1812     do
     1813     on error undo, return error
     1814     :
     1815        for each buf_cash-pay-attr no-lock where
     1816               buf_Cash-pay-attr.attr-code = 'paycard-export-prefix':U:
     1817          do ii = 1 to num-entries(buf_Cash-pay-attr.attr-value):
     1818           create buf_temp-cpa-pcep.
     1819           assign
     1820           buf_temp-cpa-pcep.cdpay-code = buf_cash-pay-attr.cdpay-code
     1821           buf_temp-cpa-pcep.curr-code = buf_cash-pay-attr.curr-code
     1822           buf_temp-cpa-pcep.prefix = entry(ii, buf_Cash-pay-attr.attr-value)
     1823           .
     1824         end.
     1825       end.
     1826     end.
     1827   end procedure.
