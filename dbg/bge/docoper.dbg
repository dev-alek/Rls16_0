     2293           and ( p-ext-doc-type = 'es':U or p-ext-doc-type = 'rs':U ) )
     2294           then do:
     2295               find first buf_trn-doc no-lock
     2296                    where buf_trn-doc.doc-code = v-doc-code
     2297               no-error.
     2298               if not available buf_trn-doc
     2299               then do:
     2300                   run bgelib-write-log in this-procedure (  p-log-file-name, 1, "*** ERR: *** Не удалось найти документ N " + string( v-doc-code ) ).
     2301               end.
     2302               else do:
     2303                   case p-ext-doc-type :
     2304                       when 'es':U
     2305                       then do:
     2306                           assign
     2307                               v-is-out                = 1
     2308                               v-inkas-pay-desk-type   = 'при':U
     2309                           .
     2310                           find first buf_inkas no-lock
     2311                                where buf_inkas.inkas-code = v-doc-code
     2312                           no-error.
     2313                       end.
     2314                       when 'rs':U
     2315                       then do:
     2316                           assign
     2317                               v-is-out                = -1
     2318                               v-inkas-pay-desk-type   = 'рас':U
     2319                           .
     2320                           find first buf_inkas no-lock
     2321                                where buf_inkas.inkas-code = buf_trn-doc.out-code
     2322                           no-error.
     2323                       end.
