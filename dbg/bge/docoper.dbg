      610   procedure xmlchar-decode :
      611   define input parameter p-in-string      as character        no-undo.
      612   define output parameter p-out-string    as character        no-undo.
      613       define variable v-position      as integer      no-undo.
      614       define variable v-last-position as integer      no-undo.
      615       define variable v-temp-integer  as integer      no-undo.
      616       define variable v-current-char  as character    no-undo.
      617       define variable v-next-char     as character    no-undo.
      618       define variable v-success       as logical      no-undo.
      619   do
      620   on error undo, return error
      621   :
      622       assign
      623           p-out-string = "":U
      624           v-position   = 0
      625       .
      626       replace-cycle:
      627       do while yes
      628       on error undo, return error
      629       :
      630           assign
      631               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      632           .
      633           if v-last-position <= v-position
      634           then do:
      635               if v-position = 0
      636               then do:
      637                   assign
      638                       p-out-string = p-in-string
      639                   .
      640               end.
      641               else do:
      642                   assign
      643                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      644                   .
      645               end.
      646               leave replace-cycle.
      647           end.
      648           else do:
      649               assign
      650                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      651                   v-position      = v-last-position
      652                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      653               .
      654               if v-current-char = "#":U
      655               then do:
      656                   assign
      657                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      658                   .
      659                   if v-last-position > 0
      660                   then do:
      661                       run xmlchar-read-integer in this-procedure
      662                        (
      663                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      664                           , output v-temp-integer
      665                           , output v-success
      666                       ).
      667                       if v-success = yes
      668                       and v-temp-integer >= 1
      669                       and v-temp-integer <= 255
      670                       then do:
      671                           assign
      672                               p-out-string = p-out-string + chr( v-temp-integer )
      673                               v-position   = v-last-position + 1
      674                           .
      675                       end.
      676                       else do:
      677                           assign
      678                               p-out-string = p-out-string + "&":U
      679                               v-position   = v-position   + 1
      680                           .
      681                       end.
      682                   end.
      683                   else do:
      684                       assign
      685                           p-out-string = p-out-string + "&":U
      686                           v-position   = v-position   + 1
      687                       .
      688                   end.
      689               end.
      690               else do:
      691                   case substring( p-in-string, v-position + 1, 3 )
      692                   :
      693                       when "lt;":U
      694                       then do:
      695                           assign
      696                               p-out-string = p-out-string + "<":U
      697                               v-position   = v-position   + 3
      698                           .
      699                       end.
      700                       when "gt;":U
      701                       then do:
      702                           assign
      703                               p-out-string = p-out-string + ">":U
      704                               v-position   = v-position   + 3
      705                           .
      706                       end.
      707                       otherwise do:
      708                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      709                           then do:
      710                               assign
      711                                   p-out-string = p-out-string + "&":U
      712                                   v-position   = v-position   + 4
      713                               .
      714                           end.
      715                           else do:
      716                               case substring( p-in-string, v-position + 1, 5 )
      717                               :
      718                                   when "quot;":U
      719                                   then do:
      720                                       assign
      721                                           p-out-string = p-out-string + '"':U
      722                                           v-position   = v-position   + 5
      723                                       .
      724                                   end.
      725                                   when "apos;":U
      726                                   then do:
      727                                       assign
      728                                           p-out-string = p-out-string + "'":U
      729                                           v-position   = v-position   + 5
      730                                       .
      731                                   end.
      732                                   otherwise do:
      733                                       assign
      734                                           p-out-string = p-out-string + "&":U
      735                                       .
      736                                   end.
      737                               end case.
      738                           end.
      739                       end.
      740                   end case.
      741               end.
      742           end.
      743       end.
      744   end.
      745   end .
      746   procedure xmlchar-read-integer :
      747   define input parameter p-input-string      as character        no-undo.
      748   define output parameter p-output-integer   as integer          no-undo.
      749   define output parameter p-success       as logical          no-undo.
      750   do
      751   on error undo, return error
      752   :
      753       assign
      754           p-output-integer = integer( p-input-string )
      755       no-error.
      756       if error-status :error
      757       then do:
      758           assign
      759               p-success           = no
      760               p-output-integer    = 0
      761           .
      762       end.
      763       else do:
      764           assign
      765               p-success           = yes
      766           .
      767       end.
      768   end.
      769   end.
      770   define variable v-bgelib-bgeclall           as logical      no-undo.
      771   define variable v-bgelib-bgedict            as logical      no-undo.
      772   define temp-table temp_ext-doc-type no-undo
      773       field edt-key               as integer
      774       field ext-doc-type          as character
      775       field ext-doc-type-label    as character
      776       index pi is primary unique
      777           edt-key
      778   .
      779   define temp-table temp_bgelib_goods no-undo
      780       field gds-code as integer
      781       index pi is primary unique
      782           gds-code
      783   .
      784   define temp-table temp_bgelib_clients no-undo
      785       field obj-type as character
      786       field obj-code as integer
      787       index pi is primary unique
      788           obj-type
      789           obj-code
      790   .
      791   define temp-table temp_bgelib_dis-card no-undo
      792       field d-card as character
      793       index pi is primary unique
      794           d-card
      795   .
      796   define temp-table temp_bgelib_trn-doc no-undo
      797       field doc-code as integer
      798   .
      799   procedure bgelib-tag-open:
      800   do
      801   on error undo, return error
      802   :
      803   define input parameter v-tag-level  as integer      no-undo.
      804   define input parameter v-tag-name   as character    no-undo.
      805   define input parameter v-tag-value  as character    no-undo.
      806       put stream stmXMLOut unformatted
      807           chr(10)
      808           + fill(" ", 4 * v-tag-level)
      809           + "<" + v-tag-name
      810           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      811           + v-tag-value + ">"
      812       .
      813   end.
      814   end procedure.
      815   procedure bgelib-tag-put:
      816   do
      817   on error undo, return error
      818   :
      819   define input parameter v-tag-level      as integer      no-undo.
      820   define input parameter v-tag-name       as character    no-undo.
      821   define input parameter v-tag-value      as character    no-undo.
      822   define input parameter v-empty-mode     as integer      no-undo.
      823       v-tag-name = trim(v-tag-name).
      824       if  v-empty-mode = 1
      825       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      826       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      827       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      828       then do:
      829           run xmlchar-encode in this-procedure (
      830                 input v-tag-value
      831               , output v-tag-value
      832           ).
      833           put stream stmXMLOut unformatted
      834               chr(10) + fill(" ", 4 * v-tag-level)
      835                           + '<' + v-tag-name + '>'
      836                           + v-tag-value
      837                           + '</' + v-tag-name + '>'
      838           .
      839       end.
      840   end.
      841   end procedure.
      842   procedure bgelib-tag-close:
      843   do
      844   on error undo, return error
      845   :
      846   define input parameter v-tag-level as integer      no-undo.
      847   define input parameter v-tag-name  as character    no-undo.
      848       put stream stmXMLOut unformatted
      849           chr(10)
      850           + fill( " ", 4 * v-tag-level)
      851           + '</' + v-tag-name + '>'
      852       .
      853   end.
      854   end procedure.
      855   procedure bgelib-write-log:
      856   do
      857   on error undo, return error
      858   :
      859   define input parameter v-filename   as character    no-undo.
      860   define input parameter v-log-level  as integer      no-undo.
      861   define input parameter v-out-string as character    no-undo.
      862       output stream stmXMLLog to value( v-filename ) append.
      863       put stream stmXMLLog unformatted
      864           chr(10)
      865       .
      866       put stream stmXMLLog unformatted
      867           ( if v-log-level = 0
      868             or v-out-string = "&DLine"
      869             or v-out-string = "&Line"
      870             then ""
      871             else cur-time-string-sec() + " " )
      872       .
      873       put stream stmXMLLog unformatted
      874           ( if v-out-string = "&Line"
      875             then fill( "-", 80 )
      876             else if v-out-string = "&DLine"
      877                  then fill( "=", 80 )
      878                  else v-out-string )
      879       .
      880       output stream stmXMLLog close.
      881   end.
      882   end procedure.
      883   procedure bgelib-write-edt:
      884   do
      885   on error undo, return error
      886   :
      887   define input parameter v-editor-handle    as handle       no-undo.
      888   define input parameter v-log-level        as integer      no-undo.
      889   define input parameter v-out-string       as character    no-undo.
      890       if valid-handle ( v-editor-handle )
      891       then do:
      892           v-editor-handle :move-to-eof().
      893           v-editor-handle :insert-string( ( if v-log-level = 0
      894                                             or v-out-string = "&DLine"
      895                                             or v-out-string = "&Line"
      896                                             then ""
      897                                             else cur-time-string-sec() + " "
      898                                         ) ).
      899           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      900                                             then fill( "-", 80 )
      901                                             else if v-out-string = "&DLine" then fill("=", 80)
      902                                             else fill( " ", v-log-level) + v-out-string
      903                                         ) ).
      904           v-editor-handle :insert-string( chr(10) ).
      905       end.
      906       process events.
      907       output to 'bgescn.txt' append.
      908           put unformatted
      909               chr(10)
      910               string( ( if v-log-level = 0
      911                         or v-out-string = "&DLine"
      912                         or v-out-string = "&Line"
      913                         then ""
      914                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      915                     ) )
      916               string( ( if v-out-string = "&Line"
      917                         then fill( "-", 80 )
      918                         else if v-out-string = "&DLine"
      919                              then fill( "=", 80 )
      920                              else fill( " ", v-log-level ) + v-out-string
      921                     ) )
      922           .
      923       output close.
      924   end.
      925   end procedure.
      926   procedure bgelib-show-cnt:
      927   do
      928   on error undo, return error
      929   :
      930   define input parameter v-fillin-handle     as handle   no-undo.
      931       if valid-handle( v-fillin-handle )
      932       then do:
      933           assign
      934               v-fillin-handle :visible = true
      935           .
      936       end.
      937   end.
      938   end procedure.
      939   procedure bgelib-hide-cnt:
      940   do
      941   on error undo, return error
      942   :
      943   define input parameter v-fillin-handle     as handle   no-undo.
      944       if valid-handle( v-fillin-handle )
      945       then do:
      946           assign v-fillin-handle :visible = false.
      947       end.
      948   end.
      949   end procedure.
      950   procedure bgelib-write-cnt:
      951   do
      952   on error undo, return error
      953   :
      954   define input parameter v-fillin-handle    as handle       no-undo.
      955   define input parameter v-fillin-string    as character    no-undo.
      956       if valid-handle( v-fillin-handle )
      957       then do:
      958           assign
      959               v-fillin-handle :SCREEN-value = v-fillin-string
      960           .
      961       end.
      962   end.
      963   end procedure.
      964   procedure bgelib-write-header:
      965   do
      966   on error undo, return error
      967   :
      968   define input parameter p-first-file     as logical      no-undo.
      969   define input parameter p-xml-file-name  as character    no-undo.
      970   define input parameter p-list-file-name as character    no-undo.
      971   define input parameter p-file-number    as integer      no-undo.
      972   define input parameter p-have-prev      as logical      no-undo.
      973   define input parameter p-prev-filename  as character    no-undo.
      974   define input parameter p-obj-list       as character    no-undo.
      975   define input parameter p-doc-type-list  as character    no-undo.
      976   define input parameter p-parameter-list as character    no-undo.
      977       define variable v-counter    as integer        no-undo.
      978       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      979       put stream stmXMLOut unformatted
      980           "<?xml version='1.0' encoding='windows-1251'?>"
      981       .
      982       run bgelib-tag-open( input 0, input "root"  , input "" ).
      983       run bgelib-tag-open( input 0, input "header", input "" ).
      984       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      985       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      986       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      987       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      988       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      989       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      990       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      991       :
      992           run bgelib-tag-put(
      993                 input 1
      994               , input entry( 2 * v-counter, p-parameter-list )
      995               , input entry( 2 * v-counter + 1, p-parameter-list )
      996               , input 0
      997           ).
      998       end.
      999       run bgelib-tag-close( input 0, input "header" ).
     1000       output stream stmXMLOut close.
     1001       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1002       if p-first-file = yes
     1003       then do:
     1004           put stream stmXMLOut unformatted
     1005               "<?xml version='1.0' encoding='windows-1251'?>"
     1006           .
     1007           run bgelib-tag-open( input 0, input "export", input "" ).
     1008       end.
     1009       run bgelib-tag-open( input 1, input "file", input "" ).
     1010       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1011       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1012       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1013       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1014       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1015       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1016       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1017       :
     1018           run bgelib-tag-put(
     1019                 input 2
     1020               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1021               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1022               , input 0
     1023           ).
     1024       end.
     1025       run bgelib-tag-close( input 1, input "file" ).
     1026       output stream stmXMLOut close.
     1027   end.
     1028   end procedure.
     1029   procedure bgelib-write-footer:
     1030   do
     1031   on error undo, return error
     1032   :
     1033   define input parameter p-last-file      as logical      no-undo.
     1034   define input parameter p-xml-file-name  as character    no-undo.
     1035   define input parameter p-list-file-name as character    no-undo.
     1036   define input parameter p-have-next      as logical      no-undo.
     1037   define input parameter p-next-file-name as character    no-undo.
     1038       define variable v-error-num     as integer           no-undo.
     1039       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1040       if p-have-next = yes
     1041       then do:
     1042           run bgelib-tag-open( input 0, input "footer", "" ).
     1043           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1044           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1045           run bgelib-tag-close( input 0, input "footer" ).
     1046       end.
     1047       run bgelib-tag-close( input 0, input "root" ).
     1048       output stream stmXMLOut close.
     1049       run bge/os_copy.p (
     1050             input "M"
     1051           , input p-xml-file-name + "tmp"
     1052           , input p-xml-file-name + "xml"
     1053           , output v-error-num
     1054       ).
     1055       if p-last-file = yes
     1056       then do:
     1057           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1058               run bgelib-tag-close( input 0, input "export" ).
     1059           output stream stmXMLOut close.
     1060           run bge/os_copy.p (
     1061                 input "M"
     1062               , input p-list-file-name + "tmp"
     1063               , input p-list-file-name + "xml"
     1064               , output v-error-num
     1065           ).
     1066       end.
     1067   end.
     1068   end procedure.
     1069   procedure bgelib-filename :
     1070   do
     1071   on error undo, return error
     1072   :
     1073   define input parameter p-prefix             as character    no-undo.
     1074   define output parameter p-xml-file-name     as character    no-undo.
     1075   define output parameter p-log-file-name     as character    no-undo.
     1076   define output parameter p-list-file-name    as character    no-undo.
     1077       define variable v-home-dir  as character    no-undo.
     1078       define variable v-error-num as integer      no-undo.
     1079       get-key-value section "BGE" key "outdir" value v-home-dir.
     1080       if v-home-dir = ?
     1081       then do:
     1082           message
     1083             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1084             skip(1)
     1085             skip "Обратитесь к администратору."
     1086           view-as alert-box error.
     1087           undo, return error .
     1088       end.
     1089       run gbl/dir-cre.p (
     1090           input v-home-dir
     1091       ) no-error.
     1092       if error-status :error
     1093       then do:
     1094           message
     1095             skip "Неверно задан каталог экспорта."
     1096             skip(1)
     1097             skip "Обратитесь к администратору."
     1098           view-as alert-box error.
     1099           undo, return error .
     1100       end.
     1101       run bge/genfname.p (
     1102             input v-home-dir
     1103           , input p-prefix
     1104           , input ""
     1105           , input "xml"
     1106           , input "tmp"
     1107           , output p-xml-file-name
     1108       ).
     1109       assign
     1110           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1111           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1112           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1113       .
     1114   end.
     1115   end procedure.
     1116   procedure bgelib-read-config :
     1117   do
     1118   on error undo, return error
     1119   :
     1120   define variable v-par-type as character     no-undo.
     1121     define variable v-param-type      as character  no-undo .
     1122     define variable v-value-character as character  no-undo .
     1123     define variable v-value-date      as date       no-undo .
     1124     define variable v-value-decimal   as decimal    no-undo .
     1125     define variable v-value-integer   as integer    no-undo .
     1126     define variable v-value-logical   as logical    no-undo .
     1127     define variable v-tth             as handle     no-undo .
     1128       assign
     1129           v-bgelib-bgeclall = no
     1130           v-bgelib-bgedict  = no
     1131       .
     1132       run adm/shattri.p ( input "get":U
     1133                         , input  '':u
     1134                         , input  0
     1135                         , input  'bge-export':U
     1136                         , input  'bgeclall':U
     1137                         , output v-value-character
     1138                         , output v-value-date
     1139                         , output v-value-decimal
     1140                         , output v-value-integer
     1141                         , output v-value-logical
     1142                         , output v-param-type
     1143                         , input-output table-handle v-tth
     1144                         ) no-error .
     1145       if error-status :error
     1146       then do:
     1147         assign
     1148           v-bgelib-bgeclall = no
     1149         .
     1150       end.
     1151       else do:
     1152         assign
     1153           v-bgelib-bgeclall = v-value-logical
     1154         .
     1155       end.
     1156       delete object v-tth.
     1157       run adm/shattri.p ( input "get":U
     1158                         , input  '':u
     1159                         , input  0
     1160                         , input  'bge-export':U
     1161                         , input  'bgedict':U
     1162                         , output v-value-character
     1163                         , output v-value-date
     1164                         , output v-value-decimal
     1165                         , output v-value-integer
     1166                         , output v-value-logical
     1167                         , output v-param-type
     1168                         , input-output table-handle v-tth
     1169                         ) no-error .
     1170       if error-status :error
     1171       then do:
     1172         assign
     1173           v-bgelib-bgedict = no
     1174         .
     1175       end.
     1176       else do:
     1177         assign
     1178           v-bgelib-bgedict = v-value-logical
     1179         .
     1180       end.
     1181       delete object v-tth.
     1182       run adm/shattri.p ( input "get":U
     1183                         , input  '':u
     1184                         , input  0
     1185                         , input  'bge-export':U
     1186                         , input  'bgefmt':U
     1187                         , output v-value-character
     1188                         , output v-value-date
     1189                         , output v-value-decimal
     1190                         , output v-value-integer
     1191                         , output v-value-logical
     1192                         , output v-param-type
     1193                         , input-output table-handle v-tth
     1194                         ) no-error .
     1195       if error-status :error
     1196       then do:
     1197         assign
     1198           v-bgelib-bgefmt  = "xml":U
     1199         .
     1200       end.
     1201       else do:
     1202         assign
     1203           v-bgelib-bgefmt  = v-value-character
     1204         .
     1205       end.
     1206       delete object v-tth.
     1207       run adm/shattri.p ( input "get":U
     1208                         , input  '':u
     1209                         , input  0
     1210                         , input  'bge-export':U
     1211                         , input  'bgeflold':U
     1212                         , output v-value-character
     1213                         , output v-value-date
     1214                         , output v-value-decimal
     1215                         , output v-value-integer
     1216                         , output v-value-logical
     1217                         , output v-param-type
     1218                         , input-output table-handle v-tth
     1219                         ) no-error .
     1220       if error-status :error
     1221       then do:
     1222         assign
     1223           v-bgelib-bgeflold  = "old":U
     1224         .
     1225       end.
     1226       else do:
     1227         assign
     1228           v-bgelib-bgeflold  = v-value-character
     1229         .
     1230       end.
     1231       delete object v-tth.
     1232   end.
     1233   end procedure.
     1234   procedure bgelib-check-file-size :
     1235   do
     1236   on error undo, return error
     1237   :
     1238   define input parameter p-out-filename   as character    no-undo.
     1239   define output parameter p-is-big        as logical      no-undo.
     1240       define variable v-current-position    as integer        no-undo.
     1241       assign
     1242           v-current-position = seek( stmXMLOut )
     1243       .
     1244       if v-current-position / 1024 / 1024  >= 100
     1245       then do:
     1246           assign
     1247               p-is-big = yes
     1248           .
     1249       end.
     1250   end.
     1251   end procedure.
     1252   procedure bgelib-init-ext-doc-type :
     1253       define variable v-counter    as integer      no-undo.
     1254       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1255   do
     1256   for buf_temp_ext-doc-type
     1257   on error undo, return error
     1258   :
     1259       empty temp-table buf_temp_ext-doc-type.
     1260       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1261       :
     1262           create buf_temp_ext-doc-type.
     1263           assign
     1264               buf_temp_ext-doc-type.edt-key               = v-counter
     1265               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1266               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1267           .
     1268       end.
     1269   end.
     1270   end procedure.
