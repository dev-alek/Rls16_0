     3141   procedure export-before-and-after-inv-trn :
     3142   do
     3143   on error undo, return error
     3144   :
     3145   define input parameter p-doc-code       as character    no-undo.
     3146   define output parameter p-exists-before as logical      no-undo.
     3147   define output parameter p-exists-after  as logical      no-undo.
     3148       define variable v-attr-value    as character     no-undo.
     3149       define variable v-attr-type     as character     no-undo.
     3150       define buffer buf_trn-doc-sum       for ub.trn-doc-sum.
     3151   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     3152                           input 'addsum':U ,
     3153                          output v-attr-value ,
     3154                          output v-attr-type )  .
     3155       if lookup( 'bd':U, v-attr-value ) <> 0
     3156       then do:
     3157           assign
     3158               p-exists-before = yes
     3159           .
     3160           find first buf_trn-doc-sum no-lock
     3161                where buf_trn-doc-sum.doc-code = p-doc-code
     3162                  and buf_trn-doc-sum.sum-type = 'bd':U
     3163           no-error.
     3164           if available buf_trn-doc-sum
     3165           then do:
     3166               run bgelib-tag-open in this-procedure ( input 0, input "docInvBeforeSum", input "" ).
     3167               run bgelib-tag-put in this-procedure ( input 1, input "docID"     , input p-doc-code                                   , input 0 ).
     3168               run bgelib-tag-put in this-procedure ( input 1, input "qnty"            , input string( buf_trn-doc-sum.fact-qnty           ) , 2 ).
     3169               run bgelib-tag-put in this-procedure ( input 1, input "saleSumr"        , input string( buf_trn-doc-sum.crsa-sum-rubl       ), input 2 ).
     3170               run bgelib-tag-put in this-procedure ( input 1, input "saleVatr"        , input string( buf_trn-doc-sum.crsa-vat-rubl       ), input 2 ).
     3171               run bgelib-tag-put in this-procedure ( input 1, input "saleSltr"        , input string( buf_trn-doc-sum.crsa-slt-rubl       ), input 2 ).
     3172               run bgelib-tag-put in this-procedure ( input 1, input "saleRoadtaxr"    , input string( buf_trn-doc-sum.crsa-road-tax-rubl  ), input 2 ).
     3173               run bgelib-tag-put in this-procedure ( input 1, input "saleTransportr"  , input string( buf_trn-doc-sum.crsa-transport-rubl ), input 2 ).
     3174               run bgelib-tag-put in this-procedure ( input 1, input "saleOtherr"      , input string( buf_trn-doc-sum.crsa-other-rubl     ), input 2 ).
     3175               run bgelib-tag-put in this-procedure ( input 1, input "saleExciser"     , input string( buf_trn-doc-sum.crsa-excise-rubl    ), input 2 ).
     3176               run bgelib-tag-put in this-procedure ( input 1, input "saleSumb"        , input string( buf_trn-doc-sum.crsa-sum-base       ), input 2 ).
     3177               run bgelib-tag-put in this-procedure ( input 1, input "saleVatb"        , input string( buf_trn-doc-sum.crsa-vat-base       ), input 2 ).
     3178               run bgelib-tag-put in this-procedure ( input 1, input "saleSltb"        , input string( buf_trn-doc-sum.crsa-slt-base       ), input 2 ).
     3179               run bgelib-tag-put in this-procedure ( input 1, input "saleRoadtaxb"    , input string( buf_trn-doc-sum.crsa-road-tax-base  ), input 2 ).
     3180               run bgelib-tag-put in this-procedure ( input 1, input "saleTransportb"  , input string( buf_trn-doc-sum.crsa-transport-base ), input 2 ).
     3181               run bgelib-tag-put in this-procedure ( input 1, input "saleOtherb"      , input string( buf_trn-doc-sum.crsa-other-base     ), input 2 ).
     3182               run bgelib-tag-put in this-procedure ( input 1, input "saleExciseb"     , input string( buf_trn-doc-sum.crsa-excise-base    ), input 2 ).
     3183               run bgelib-tag-put in this-procedure ( input 1, input "costSumr"        , input string( buf_trn-doc-sum.cost-sum-rubl       ), input 2 ).
     3184               run bgelib-tag-put in this-procedure ( input 1, input "costVatr"        , input string( buf_trn-doc-sum.cost-vat-rubl       ), input 2 ).
     3185               run bgelib-tag-put in this-procedure ( input 1, input "costSltr"        , input string( buf_trn-doc-sum.cost-slt-rubl       ), input 2 ).
     3186               run bgelib-tag-put in this-procedure ( input 1, input "costRoadtaxr"    , input string( buf_trn-doc-sum.cost-road-tax-rubl  ), input 2 ).
     3187               run bgelib-tag-put in this-procedure ( input 1, input "costTransportr"  , input string( buf_trn-doc-sum.cost-transport-rubl ), input 2 ).
     3188               run bgelib-tag-put in this-procedure ( input 1, input "costOtherr"      , input string( buf_trn-doc-sum.cost-other-rubl     ), input 2 ).
     3189               run bgelib-tag-put in this-procedure ( input 1, input "costExciser"     , input string( buf_trn-doc-sum.cost-excise-rubl    ), input 2 ).
     3190               run bgelib-tag-put in this-procedure ( input 1, input "costSumb"        , input string( buf_trn-doc-sum.cost-sum-base       ), input 2 ).
     3191               run bgelib-tag-put in this-procedure ( input 1, input "costVatb"        , input string( buf_trn-doc-sum.cost-vat-base       ), input 2 ).
     3192               run bgelib-tag-put in this-procedure ( input 1, input "costSltb"        , input string( buf_trn-doc-sum.cost-slt-base       ), input 2 ).
     3193               run bgelib-tag-put in this-procedure ( input 1, input "costRoadtaxb"    , input string( buf_trn-doc-sum.cost-road-tax-base  ), input 2 ).
     3194               run bgelib-tag-put in this-procedure ( input 1, input "costTransportb"  , input string( buf_trn-doc-sum.cost-transport-base ), input 2 ).
     3195               run bgelib-tag-put in this-procedure ( input 1, input "costOtherb"      , input string( buf_trn-doc-sum.cost-other-base     ), input 2 ).
     3196               run bgelib-tag-put in this-procedure ( input 1, input "costExciseb"     , input string( buf_trn-doc-sum.cost-excise-base    ), input 2 ).
     3197               run bgelib-tag-close in this-procedure ( input 0, input "docInvBeforeSum" ).
     3198           end.
     3199           else do:
     3200               run bgelib-write-log in this-procedure ( input p-log-file-name, input 1, input "*** ERR: *** Не найдена запись trn-doc-sum с sum-type = 'bd':U для документа " + string( p-doc-code ) ).
     3201           end.
     3202       end.
     3203       if lookup( 'ad':U, v-attr-value ) <> 0
     3204       then do:
     3205           assign
     3206               p-exists-after  = yes
     3207           .
     3208           find first buf_trn-doc-sum no-lock
     3209                where buf_trn-doc-sum.doc-code = p-doc-code
     3210                  and buf_trn-doc-sum.sum-type = 'ad':U
     3211           no-error.
     3212           if available buf_trn-doc-sum
     3213           then do:
     3214               run bgelib-tag-open in this-procedure ( input 0, input "docInvAfterSum", input "" ).
     3215               run bgelib-tag-put in this-procedure ( input 1, input "docID"    , input p-doc-code                                   , input 0 ).
     3216               run bgelib-tag-put in this-procedure ( input 1, input "qnty"           , input string( buf_trn-doc-sum.fact-qnty           ), input 2 ).
     3217               run bgelib-tag-put in this-procedure ( input 1, input "saleSumr"       , input string( buf_trn-doc-sum.crsa-sum-rubl       ), input 2 ).
     3218               run bgelib-tag-put in this-procedure ( input 1, input "saleVatr"       , input string( buf_trn-doc-sum.crsa-vat-rubl       ), input 2 ).
     3219               run bgelib-tag-put in this-procedure ( input 1, input "saleSltr"       , input string( buf_trn-doc-sum.crsa-slt-rubl       ), input 2 ).
     3220               run bgelib-tag-put in this-procedure ( input 1, input "saleRoadtaxr"   , input string( buf_trn-doc-sum.crsa-road-tax-rubl  ), input 2 ).
     3221               run bgelib-tag-put in this-procedure ( input 1, input "saleTransportr" , input string( buf_trn-doc-sum.crsa-transport-rubl ), input 2 ).
     3222               run bgelib-tag-put in this-procedure ( input 1, input "saleOtherr"     , input string( buf_trn-doc-sum.crsa-other-rubl     ), input 2 ).
     3223               run bgelib-tag-put in this-procedure ( input 1, input "saleExciser"    , input string( buf_trn-doc-sum.crsa-excise-rubl    ), input 2 ).
     3224               run bgelib-tag-put in this-procedure ( input 1, input "saleSumb"       , input string( buf_trn-doc-sum.crsa-sum-base       ), input 2 ).
     3225               run bgelib-tag-put in this-procedure ( input 1, input "saleVatb"       , input string( buf_trn-doc-sum.crsa-vat-base       ), input 2 ).
     3226               run bgelib-tag-put in this-procedure ( input 1, input "saleSltb"       , input string( buf_trn-doc-sum.crsa-slt-base       ), input 2 ).
     3227               run bgelib-tag-put in this-procedure ( input 1, input "saleRoadtaxb"   , input string( buf_trn-doc-sum.crsa-road-tax-base  ), input 2 ).
     3228               run bgelib-tag-put in this-procedure ( input 1, input "saleTransportb" , input string( buf_trn-doc-sum.crsa-transport-base ), input 2 ).
     3229               run bgelib-tag-put in this-procedure ( input 1, input "saleOtherb"     , input string( buf_trn-doc-sum.crsa-other-base     ), input 2 ).
     3230               run bgelib-tag-put in this-procedure ( input 1, input "saleExciseb"    , input string( buf_trn-doc-sum.crsa-excise-base    ), input 2 ).
     3231               run bgelib-tag-put in this-procedure ( input 1, input "costSumr"       , input string( buf_trn-doc-sum.cost-sum-rubl       ), input 2 ).
     3232               run bgelib-tag-put in this-procedure ( input 1, input "costVatr"       , input string( buf_trn-doc-sum.cost-vat-rubl       ), input 2 ).
     3233               run bgelib-tag-put in this-procedure ( input 1, input "costSltr"       , input string( buf_trn-doc-sum.cost-slt-rubl       ), input 2 ).
     3234               run bgelib-tag-put in this-procedure ( input 1, input "costRoadtaxr"   , input string( buf_trn-doc-sum.cost-road-tax-rubl  ), input 2 ).
     3235               run bgelib-tag-put in this-procedure ( input 1, input "costTransportr" , input string( buf_trn-doc-sum.cost-transport-rubl ), input 2 ).
     3236               run bgelib-tag-put in this-procedure ( input 1, input "costOtherr"     , input string( buf_trn-doc-sum.cost-other-rubl     ), input 2 ).
     3237               run bgelib-tag-put in this-procedure ( input 1, input "costExciser"    , input string( buf_trn-doc-sum.cost-excise-rubl    ), input 2 ).
     3238               run bgelib-tag-put in this-procedure ( input 1, input "costSumb"       , input string( buf_trn-doc-sum.cost-sum-base       ), input 2 ).
     3239               run bgelib-tag-put in this-procedure ( input 1, input "costVatb"       , input string( buf_trn-doc-sum.cost-vat-base       ), input 2 ).
     3240               run bgelib-tag-put in this-procedure ( input 1, input "costSltb"       , input string( buf_trn-doc-sum.cost-slt-base       ), input 2 ).
     3241               run bgelib-tag-put in this-procedure ( input 1, input "costRoadtaxb"   , input string( buf_trn-doc-sum.cost-road-tax-base  ), input 2 ).
     3242               run bgelib-tag-put in this-procedure ( input 1, input "costTransportb" , input string( buf_trn-doc-sum.cost-transport-base ), input 2 ).
     3243               run bgelib-tag-put in this-procedure ( input 1, input "costOtherb"     , input string( buf_trn-doc-sum.cost-other-base     ), input 2 ).
     3244               run bgelib-tag-put in this-procedure ( input 1, input "costExciseb"    , input string( buf_trn-doc-sum.cost-excise-base    ), input 2 ).
     3245               run bgelib-tag-close in this-procedure ( input 0, input "docInvAfterSum" ).
     3246           end.
     3247           else do:
     3248               run bgelib-write-log in this-procedure ( input p-log-file-name, input 1, input "*** ERR: *** Не найдена запись trn-doc-sum с sum-type = 'ad':U для документа " + string( p-doc-code ) ).
     3249           end.
     3250       end.
     3251   end.
     3252   end procedure.
     3253   procedure export-before-and-after-inv-line :
     3254   do
     3255   on error undo, return error
     3256   :
     3257   define input parameter p-doc-code           as character    no-undo.
     3258   define input parameter p-gds-code           as integer      no-undo.
     3259   define input parameter p-exists-before      as logical      no-undo.
     3260   define input parameter p-exists-after       as logical      no-undo.
     3261   define input parameter p-need-petrol-weight as logical      no-undo.
     3262   define input parameter p-petrol-density     as decimal      no-undo.
     3263       define buffer buf_doc-line-sum      for ub.doc-line-sum.
     3264       if p-exists-before = yes
     3265       then do:
     3266           find first buf_doc-line-sum no-lock
     3267                where buf_doc-line-sum.doc-code = p-doc-code
     3268                  and buf_doc-line-sum.gds-code = p-gds-code
     3269                  and buf_doc-line-sum.sum-type = 'bd':U
     3270           no-error.
     3271           if available buf_doc-line-sum
     3272           then do:
     3273               run bgelib-tag-open in this-procedure ( input 0, input "lineInvBeforeSum", input "" ).
     3274               run bgelib-tag-put in this-procedure ( input 1, input "docID"     , input p-doc-code  , input 0 ).
     3275               run bgelib-tag-put in this-procedure ( input 1, input "goodID"            , input p-gds-code  , input 0 ).
     3276               if p-need-petrol-weight = yes
     3277               then do:
     3278                   run bgelib-tag-put in this-procedure ( input 1, input "petrolWeightBefore", input string( buf_doc-line-sum.fact-qnty * p-petrol-density ), input 0 ).
     3279               end.
     3280               run bgelib-tag-put in this-procedure ( input 1, input "qnty"           , input string( buf_doc-line-sum.fact-qnty ), input 2 ).
     3281               run bgelib-tag-put in this-procedure ( input 1, input "saleSumr"       , input string( buf_doc-line-sum.crsa-sum-rubl       ), input 2 ).
     3282               run bgelib-tag-put in this-procedure ( input 1, input "saleVatr"       , input string( buf_doc-line-sum.crsa-vat-rubl       ), input 2 ).
     3283               run bgelib-tag-put in this-procedure ( input 1, input "saleSltr"       , input string( buf_doc-line-sum.crsa-slt-rubl       ), input 2 ).
     3284               run bgelib-tag-put in this-procedure ( input 1, input "saleRoadtaxr"   , input string( buf_doc-line-sum.crsa-road-tax-rubl  ), input 2 ).
     3285               run bgelib-tag-put in this-procedure ( input 1, input "saleTransportr" , input string( buf_doc-line-sum.crsa-transport-rubl ), input 2 ).
     3286               run bgelib-tag-put in this-procedure ( input 1, input "saleOtherr"     , input string( buf_doc-line-sum.crsa-other-rubl     ), input 2 ).
     3287               run bgelib-tag-put in this-procedure ( input 1, input "saleExciser"    , input string( buf_doc-line-sum.crsa-excise-rubl    ), input 2 ).
     3288               run bgelib-tag-put in this-procedure ( input 1, input "saleSumb"       , input string( buf_doc-line-sum.crsa-sum-base       ), input 2 ).
     3289               run bgelib-tag-put in this-procedure ( input 1, input "saleVatb"       , input string( buf_doc-line-sum.crsa-vat-base       ), input 2 ).
     3290               run bgelib-tag-put in this-procedure ( input 1, input "saleSltb"       , input string( buf_doc-line-sum.crsa-slt-base       ), input 2 ).
     3291               run bgelib-tag-put in this-procedure ( input 1, input "saleRoadtaxb"   , input string( buf_doc-line-sum.crsa-road-tax-base  ), input 2 ).
     3292               run bgelib-tag-put in this-procedure ( input 1, input "saleTransportb" , input string( buf_doc-line-sum.crsa-transport-base ), input 2 ).
     3293               run bgelib-tag-put in this-procedure ( input 1, input "saleOtherb"     , input string( buf_doc-line-sum.crsa-other-base     ), input 2 ).
     3294               run bgelib-tag-put in this-procedure ( input 1, input "saleExciseb"    , input string( buf_doc-line-sum.crsa-excise-base    ), input 2 ).
     3295               run bgelib-tag-put in this-procedure ( input 1, input "costSumr"       , input string( buf_doc-line-sum.cost-sum-rubl       ), input 2 ).
     3296               run bgelib-tag-put in this-procedure ( input 1, input "costVatr"       , input string( buf_doc-line-sum.cost-vat-rubl       ), input 2 ).
     3297               run bgelib-tag-put in this-procedure ( input 1, input "costSltr"       , input string( buf_doc-line-sum.cost-slt-rubl       ), input 2 ).
     3298               run bgelib-tag-put in this-procedure ( input 1, input "costRoadtaxr"   , input string( buf_doc-line-sum.cost-road-tax-rubl  ), input 2 ).
     3299               run bgelib-tag-put in this-procedure ( input 1, input "costTransportr" , input string( buf_doc-line-sum.cost-transport-rubl ), input 2 ).
     3300               run bgelib-tag-put in this-procedure ( input 1, input "costOtherr"     , input string( buf_doc-line-sum.cost-other-rubl     ), input 2 ).
     3301               run bgelib-tag-put in this-procedure ( input 1, input "costExciser"    , input string( buf_doc-line-sum.cost-excise-rubl    ), input 2 ).
     3302               run bgelib-tag-put in this-procedure ( input 1, input "costSumb"       , input string( buf_doc-line-sum.cost-sum-base       ), input 2 ).
     3303               run bgelib-tag-put in this-procedure ( input 1, input "costVatb"       , input string( buf_doc-line-sum.cost-vat-base       ), input 2 ).
     3304               run bgelib-tag-put in this-procedure ( input 1, input "costSltb"       , input string( buf_doc-line-sum.cost-slt-base       ), input 2 ).
     3305               run bgelib-tag-put in this-procedure ( input 1, input "costRoadtaxb"   , input string( buf_doc-line-sum.cost-road-tax-base  ), input 2 ).
     3306               run bgelib-tag-put in this-procedure ( input 1, input "costTransportb" , input string( buf_doc-line-sum.cost-transport-base ), input 2 ).
     3307               run bgelib-tag-put in this-procedure ( input 1, input "costOtherb"     , input string( buf_doc-line-sum.cost-other-base     ), input 2 ).
     3308               run bgelib-tag-put in this-procedure ( input 1, input "costExciseb"    , input string( buf_doc-line-sum.cost-excise-base    ), input 2 ).
     3309               run bgelib-tag-close in this-procedure ( input 0, input "lineInvBeforeSum" ).
     3310           end.
     3311           else do:
     3312               run bgelib-write-log in this-procedure ( input p-log-file-name, input 1, input "*** ERR: *** Не найдена запись doc-line-sum с sum-type = 'bd':U для документа " + string( p-doc-code ) ).
     3313           end.
     3314       end.
     3315       if p-exists-after = yes
     3316       then do:
     3317           find first buf_doc-line-sum no-lock
     3318                where buf_doc-line-sum.doc-code = p-doc-code
     3319                  and buf_doc-line-sum.gds-code = p-gds-code
     3320                  and buf_doc-line-sum.sum-type = 'ad':U
     3321           no-error.
     3322           if available buf_doc-line-sum
     3323           then do:
     3324               run bgelib-tag-open in this-procedure ( input 0, input "lineInvAfterSum", input "" ).
     3325               run bgelib-tag-put in this-procedure ( input 1, input "docID"     , input p-doc-code  , input 0 ).
     3326               run bgelib-tag-put in this-procedure ( input 1, input "goodID"            , input p-gds-code  , input 0 ).
     3327               if p-need-petrol-weight = yes
     3328               then do:
     3329                   run bgelib-tag-put in this-procedure ( input 1, input "petrolWeightAfter",  input string( buf_doc-line-sum.fact-qnty * p-petrol-density ), input 0 ).
     3330               end.
     3331               run bgelib-tag-put in this-procedure ( input 1, input "qnty"           , input string( buf_doc-line-sum.fact-qnty           ), input 2 ).
     3332               run bgelib-tag-put in this-procedure ( input 1, input "saleSumr"       , input string( buf_doc-line-sum.crsa-sum-rubl       ), input 2 ).
     3333               run bgelib-tag-put in this-procedure ( input 1, input "saleVatr"       , input string( buf_doc-line-sum.crsa-vat-rubl       ), input 2 ).
     3334               run bgelib-tag-put in this-procedure ( input 1, input "saleSltr"       , input string( buf_doc-line-sum.crsa-slt-rubl       ), input 2 ).
     3335               run bgelib-tag-put in this-procedure ( input 1, input "saleRoadtaxr"   , input string( buf_doc-line-sum.crsa-road-tax-rubl  ), input 2 ).
     3336               run bgelib-tag-put in this-procedure ( input 1, input "saleTransportr" , input string( buf_doc-line-sum.crsa-transport-rubl ), input 2 ).
     3337               run bgelib-tag-put in this-procedure ( input 1, input "saleOtherr"     , input string( buf_doc-line-sum.crsa-other-rubl     ), input 2 ).
     3338               run bgelib-tag-put in this-procedure ( input 1, input "saleExciser"    , input string( buf_doc-line-sum.crsa-excise-rubl    ), input 2 ).
     3339               run bgelib-tag-put in this-procedure ( input 1, input "saleSumb"       , input string( buf_doc-line-sum.crsa-sum-base       ), input 2 ).
     3340               run bgelib-tag-put in this-procedure ( input 1, input "saleVatb"       , input string( buf_doc-line-sum.crsa-vat-base       ), input 2 ).
     3341               run bgelib-tag-put in this-procedure ( input 1, input "saleSltb"       , input string( buf_doc-line-sum.crsa-slt-base       ), input 2 ).
     3342               run bgelib-tag-put in this-procedure ( input 1, input "saleRoadtaxb"   , input string( buf_doc-line-sum.crsa-road-tax-base  ), input 2 ).
     3343               run bgelib-tag-put in this-procedure ( input 1, input "saleTransportb" , input string( buf_doc-line-sum.crsa-transport-base ), input 2 ).
     3344               run bgelib-tag-put in this-procedure ( input 1, input "saleOtherb"     , input string( buf_doc-line-sum.crsa-other-base     ), input 2 ).
     3345               run bgelib-tag-put in this-procedure ( input 1, input "saleExciseb"    , input string( buf_doc-line-sum.crsa-excise-base    ), input 2 ).
     3346               run bgelib-tag-put in this-procedure ( input 1, input "costSumr"       , input string( buf_doc-line-sum.cost-sum-rubl       ), input 2 ).
     3347               run bgelib-tag-put in this-procedure ( input 1, input "costVatr"       , input string( buf_doc-line-sum.cost-vat-rubl       ), input 2 ).
     3348               run bgelib-tag-put in this-procedure ( input 1, input "costSltr"       , input string( buf_doc-line-sum.cost-slt-rubl       ), input 2 ).
     3349               run bgelib-tag-put in this-procedure ( input 1, input "costRoadtaxr"   , input string( buf_doc-line-sum.cost-road-tax-rubl  ), input 2 ).
     3350               run bgelib-tag-put in this-procedure ( input 1, input "costTransportr" , input string( buf_doc-line-sum.cost-transport-rubl ), input 2 ).
     3351               run bgelib-tag-put in this-procedure ( input 1, input "costOtherr"     , input string( buf_doc-line-sum.cost-other-rubl     ), input 2 ).
     3352               run bgelib-tag-put in this-procedure ( input 1, input "costExciser"    , input string( buf_doc-line-sum.cost-excise-rubl    ), input 2 ).
     3353               run bgelib-tag-put in this-procedure ( input 1, input "costSumb"       , input string( buf_doc-line-sum.cost-sum-base       ), input 2 ).
     3354               run bgelib-tag-put in this-procedure ( input 1, input "costVatb"       , input string( buf_doc-line-sum.cost-vat-base       ), input 2 ).
     3355               run bgelib-tag-put in this-procedure ( input 1, input "costSltb"       , input string( buf_doc-line-sum.cost-slt-base       ), input 2 ).
     3356               run bgelib-tag-put in this-procedure ( input 1, input "costRoadtaxb"   , input string( buf_doc-line-sum.cost-road-tax-base  ), input 2 ).
     3357               run bgelib-tag-put in this-procedure ( input 1, input "costTransportb" , input string( buf_doc-line-sum.cost-transport-base ), input 2 ).
     3358               run bgelib-tag-put in this-procedure ( input 1, input "costOtherb"     , input string( buf_doc-line-sum.cost-other-base     ), input 2 ).
     3359               run bgelib-tag-put in this-procedure ( input 1, input "costExciseb"    , input string( buf_doc-line-sum.cost-excise-base    ), input 2 ).
     3360               run bgelib-tag-close in this-procedure ( input 0, input "lineInvAfterSum" ).
     3361           end.
     3362           else do:
     3363               run bgelib-write-log in this-procedure ( input p-log-file-name, input 1, input "*** ERR: *** Не найдена запись doc-line-sum с sum-type = 'ad':U для документа " + string( p-doc-code ) ).
     3364           end.
     3365       end.
     3366   end.
     3367   end procedure.
     3368   procedure get-petrol-weight :
     3369   do
     3370   on error undo, return error
     3371   :
     3372   define input parameter p-ext-doc-type           as character    no-undo.
     3373   define input parameter p-doc-line-recid         as recid        no-undo.
     3374   define input parameter p-trn-doc-out-code       as character    no-undo.
     3375   define output parameter p-petrol-weight         as decimal      no-undo.
     3376   define output parameter p-weight-not-specified  as logical      no-undo.
     3377       define variable v-rvs-code              as character     no-undo.
     3378       define variable v-found-last-rvs-doc    as logical       no-undo.
     3379       define buffer buf_doc-line      for ub.doc-line.
     3380       define buffer buf_rvs-doc       for ub.rvs-doc.
     3381       define buffer buf_rvs-line      for ub.rvs-line.
     3382       define buffer buf_goods         for ub.goods.
     3383       define buffer buf_doc-pl        for ub.doc-pl.
     3384       find first buf_doc-line no-lock
     3385           where recid( buf_doc-line ) = p-doc-line-recid
     3386       .
     3387       find first buf_goods no-lock
     3388            where buf_goods.artic      = buf_doc-line.artic
     3389              and buf_goods.prod-type  = buf_doc-line.prod-type
     3390              and buf_goods.prod-code  = buf_doc-line.prod-code
     3391       .
     3392       assign
     3393           p-weight-not-specified = yes
     3394       .
     3395       case p-ext-doc-type:
     3396           when 'ie':U
     3397           or when 're':U
     3398           or when 'we':U
     3399           or when 'ie':U
     3400           or when 'rs':U
     3401           or when 'ep':U
     3402           then do:
     3403               assign
     3404                   p-petrol-weight        = buf_doc-line.fact-qnty * buf_doc-line.fact-density
     3405                   p-weight-not-specified = no
     3406               .
     3407           end.
     3408           when 'vt':U
     3409           or when 'vp':U
     3410           or when 'ap':U
     3411           or when 'mp':U
     3412           then do:
     3413               find first buf_rvs-doc no-lock
     3414                    where buf_rvs-doc.rvs-code = p-trn-doc-out-code
     3415                      and buf_rvs-doc.status_  = 'факт':U
     3416               no-error.
     3417               if available buf_rvs-doc
     3418               then do:
     3419                   assign
     3420                       v-rvs-code           = buf_rvs-doc.rvs-code
     3421                   .
     3422                   for each buf_doc-pl no-lock
     3423                      where buf_doc-pl.out-code = buf_doc-line.doc-code
     3424                        and buf_doc-pl.gds-code = buf_goods.gds-code
     3425                        and buf_doc-pl.obj-type = buf_doc-line.obj-type
     3426                        and buf_doc-pl.obj-code = buf_doc-line.obj-code
     3427                   on error undo, return error
     3428                   :
     3429                       for each buf_rvs-line no-lock
     3430                          where buf_rvs-line.gds-code  = buf_doc-pl.gds-code
     3431                            and buf_rvs-line.rvs-code  = v-rvs-code
     3432                            and buf_rvs-line.obj-type  = buf_doc-pl.obj-type
     3433                            and buf_rvs-line.obj-code  = buf_doc-pl.obj-code
     3434                            and buf_rvs-line.pl-code   = buf_doc-pl.pl-code
     3435                       on error undo, return error
     3436                       :
     3437                           assign
     3438                               p-petrol-weight         = p-petrol-weight + buf_doc-pl.fact-qnty * buf_rvs-line.state-density
     3439                               p-weight-not-specified  = no
     3440                           .
     3441                       end.
     3442                   end.
     3443               end.
     3444               else do:
     3445                   assign
     3446                       v-found-last-rvs-doc = no
     3447                   .
     3448                   find-last-rvs:
     3449                   for each buf_rvs-doc no-lock
     3450                      where buf_rvs-doc.obj-type = buf_doc-line.obj-type
     3451                        and buf_rvs-doc.obj-code = buf_doc-line.obj-code
     3452                        and buf_rvs-doc.status_  = 'факт':U
     3453                   use-index shift
     3454                   on error undo, return error
     3455                   :
     3456                       assign
     3457                           v-rvs-code           = buf_rvs-doc.rvs-code
     3458                       .
     3459                       for each buf_doc-pl no-lock
     3460                          where buf_doc-pl.out-code = buf_doc-line.doc-code
     3461                            and buf_doc-pl.gds-code = buf_goods.gds-code
     3462                            and buf_doc-pl.obj-type = buf_doc-line.obj-type
     3463                            and buf_doc-pl.obj-code = buf_doc-line.obj-code
     3464                       on error undo, return error
     3465                       :
     3466                           for each buf_rvs-line no-lock
     3467                              where buf_rvs-line.gds-code  = buf_doc-pl.gds-code
     3468                                and buf_rvs-line.rvs-code  = v-rvs-code
     3469                                and buf_rvs-line.obj-type  = buf_doc-pl.obj-type
     3470                                and buf_rvs-line.obj-code  = buf_doc-pl.obj-code
     3471                                and buf_rvs-line.pl-code   = buf_doc-pl.pl-code
     3472                           on error undo, return error
     3473                           :
     3474                               assign
     3475                                   v-found-last-rvs-doc    = yes
     3476                                   p-petrol-weight         = p-petrol-weight + buf_doc-pl.fact-qnty * buf_rvs-line.state-density
     3477                                   p-weight-not-specified  = no
     3478                               .
     3479                               leave find-last-rvs.
     3480                           end.
     3481                       end.
     3482                   end.
     3483               end.
     3484           end.
     3485           otherwise do:
     3486               assign
     3487                   p-weight-not-specified = yes
     3488               .
     3489           end.
     3490       end case.
     3491   end.
     3492   end procedure.
     3493   procedure get-cash-pay :
     3494     do
     3495     on error undo, return error
     3496     :
     3497     define input parameter p-ext-doc-type           as character    no-undo.
     3498     define input parameter p-doc-line-recid         as recid        no-undo.
     3499     define input parameter p-trn-doc-out-code       as character    no-undo.
     3500     define output parameter p-cash-pay-not-specified  as logical      no-undo.
     3501       define buffer buf_doc-line      for ub.doc-line.
     3502       define buffer buf_goods         for ub.goods.
     3503       find first buf_doc-line no-lock
     3504           where recid( buf_doc-line ) = p-doc-line-recid
     3505       .
     3506       find first buf_goods no-lock
     3507            where buf_goods.artic      = buf_doc-line.artic
     3508              and buf_goods.prod-type  = buf_doc-line.prod-type
     3509              and buf_goods.prod-code  = buf_doc-line.prod-code
     3510       .
     3511       assign
     3512           p-cash-pay-not-specified = yes
     3513       .
     3514       case p-ext-doc-type:
     3515           when 'es':U
     3516           then do:
     3517               assign
     3518                   p-cash-pay-not-specified = no
     3519               .
     3520           end.
     3521           when 'rs':U
     3522           then do:
     3523               assign
     3524                   p-cash-pay-not-specified = no
     3525               .
     3526           end.
     3527           otherwise do:
     3528               assign
     3529                   p-cash-pay-not-specified = yes
     3530               .
     3531           end.
     3532         END CASE.
     3533     end.
     3534   end procedure.
     3535   procedure get-inkas-pay-desk :
     3536     define buffer buf_inkas-pay-desk for ub.inkas-pay-desk.
     3537     do for buf_inkas-pay-desk
     3538     on error undo, return error
     3539     :
     3540     define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
     3541     define input parameter p-obj-type   like ub.inkas.obj-type no-undo .
     3542     define input parameter p-obj-code   like ub.inkas.obj-code no-undo .
     3543     define input parameter p-inkas-pay-desk-type like ub.inkas-pay-desk.doc-type no-undo .
     3544       if can-find( first buf_inkas-pay-desk  NO-LOCK WHERE
     3545                          buf_inkas-pay-desk.inkas-code = p-inkas-code ) then.
     3546       else do:
     3547         run trg/inkpdcr.p (
     3548                        p-inkas-code
     3549                       ,p-obj-type
     3550                       ,p-obj-code
     3551         ) no-error .
     3552         if error-status:error then do:
     3553           return error.
     3554         end.
     3555       end.
     3556       for each temp_inkas-pay
     3557       :
     3558           delete temp_inkas-pay.
     3559       end.
     3560       for each buf_inkas-pay-desk no-lock
     3561          where buf_inkas-pay-desk.inkas-code  = p-inkas-code
     3562            and buf_inkas-pay-desk.doc-type    = p-inkas-pay-desk-type
     3563       break by buf_inkas-pay-desk.pay-code
     3564       on error undo, return error
     3565       :
     3566           if first-of( buf_inkas-pay-desk.pay-code )
     3567           then do:
     3568               create temp_inkas-pay.
     3569               assign
     3570                   temp_inkas-pay.pay-code  = buf_inkas-pay-desk.pay-code
     3571                   temp_inkas-pay.tot-base  = 0
     3572                   temp_inkas-pay.tot-rubl  = 0
     3573                   temp_inkas-pay.tot-sum   = 0
     3574               .
     3575           end.
     3576           assign
     3577               temp_inkas-pay.tot-base  = temp_inkas-pay.tot-base + buf_inkas-pay-desk.tot-base
     3578               temp_inkas-pay.tot-rubl  = temp_inkas-pay.tot-rubl + buf_inkas-pay-desk.tot-rubl
     3579               temp_inkas-pay.tot-sum   = temp_inkas-pay.tot-sum  + buf_inkas-pay-desk.tot-sum
     3580           .
     3581       end.
     3582     end.
     3583   end procedure.
     3584   procedure export-attribute :
     3585   do
     3586   on error undo, return error
     3587   :
     3588   define input parameter p-doc-code   as character    no-undo.
     3589   define input parameter p-attr-code  as character    no-undo.
     3590   define input parameter p-tag-name   as character    no-undo.
     3591       define variable v-attr-exists    as logical        no-undo.
     3592       define variable v-attr-value     as character      no-undo.
     3593       define variable v-attr-type      as character      no-undo.
     3594   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-xst in g#trdcalib (  input p-doc-code ,
     3595                           input p-attr-code ,
     3596                          output v-attr-exists )  .
     3597       if v-attr-exists = yes
     3598       then do:
     3599   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     3600                           input p-attr-code ,
     3601                          output v-attr-value ,
     3602                          output v-attr-type ) no-error .
     3603           if error-status :error
     3604           then do:
     3605               run bgelib-write-log in this-procedure (
     3606                     input p-log-file-name
     3607                   , input 1
     3608                   , input substitute( "*** ERR: *** Ошибка чтения атрибута &1 для документа N &2", p-attr-code, p-doc-code )
     3609               ).
     3610           end.
     3611           else do:
     3612               run bgelib-tag-put in this-procedure ( input 1, input p-tag-name, input v-attr-value, input 0 ).
     3613           end.
     3614       end.
     3615   end.
     3616   end procedure.
     3617   procedure export-parts :
     3618   do
     3619   on error undo, return error
     3620   :
     3621   define input parameter p-doc-code   as character    no-undo.
     3622   define input parameter p-gds-code   as integer      no-undo.
     3623   define input parameter p-obj-type   as character    no-undo.
     3624   define input parameter p-obj-code   as integer      no-undo.
     3625   define input parameter p-prod-type  as character    no-undo.
     3626   define input parameter p-prod-code  as integer      no-undo.
     3627   define input parameter p-artic      as character    no-undo.
     3628       define variable v-parts-cst-code        as character    no-undo.
     3629       define variable v-fact-qnty             as decimal     no-undo.
     3630       define variable v-sum-rubl              as decimal     no-undo.
     3631       define variable v-vat-rubl              as decimal     no-undo.
     3632       define variable v-slt-rubl              as decimal     no-undo.
     3633       define variable v-road-tax-rubl         as decimal     no-undo.
     3634       define variable v-transport-rubl        as decimal     no-undo.
     3635       define variable v-other-rubl            as decimal     no-undo.
     3636       define variable v-excise-rubl           as decimal     no-undo.
     3637       define variable v-sum-base              as decimal     no-undo.
     3638       define variable v-vat-base              as decimal     no-undo.
     3639       define variable v-slt-base              as decimal     no-undo.
     3640       define variable v-road-tax-base         as decimal     no-undo.
     3641       define variable v-transport-base        as decimal     no-undo.
     3642       define variable v-other-base            as decimal     no-undo.
     3643       define variable v-excise-base           as decimal     no-undo.
     3644       define variable v-parts-host-code       as integer       no-undo.
     3645       define variable v-parts-contract-code   as integer       no-undo.
     3646       define variable v-parts-price-cli       as decimal       no-undo.
     3647       define variable v-parts-cli-base-rate   as decimal       no-undo.
     3648       define variable v-parts-vat-type        as character     no-undo.
     3649       define variable v-parts-exch-code       as integer       no-undo.
     3650       define variable v-parts-attr-exch-rate  as decimal       no-undo.
     3651       define variable v-parts-attr-exch-scale as integer       no-undo.
     3652       define variable v-parts-attr-unit-cli   as character     no-undo.
     3653       define variable v-country-code          as character    no-undo.
     3654       define variable v-supp-type             as character   no-undo.
     3655       define variable v-supp-code             as integer     no-undo.
     3656       define variable v-in-code               as character   no-undo.
     3657       define variable v-cst-code              as character   no-undo.
     3658       define variable v-supp-dog-code         as character    no-undo.
     3659       define variable v-supp-ndog             as character    no-undo.
     3660       define variable v-supp-ddog             as character    no-undo.
     3661       define buffer buf_parts             for ub.parts.
     3662       define buffer buf_parts-attr        for ub.parts-attr.
     3663       define buffer buf_contract          for ub.contract.
     3664       assign
     3665           v-parts-cst-code = "":U
     3666           v-supp-dog-code  = "":U
     3667           v-supp-ndog      = "":U
     3668           v-supp-ddog      = "":U
     3669       .
     3670       for each buf_parts no-lock
     3671           where buf_parts.out-code   = p-doc-code
     3672             and buf_parts.obj-type   = p-obj-type
     3673             and buf_parts.obj-code   = p-obj-code
     3674             and buf_parts.prod-type  = p-prod-type
     3675             and buf_parts.prod-code  = p-prod-code
     3676             and buf_parts.artic      = p-artic
     3677             and buf_parts.status_    = true
     3678       on error undo, return error return-value
     3679       :
     3680           if p-parts = yes
     3681           then do:
     3682   assign
     3683     price-rubl-with-tax-loc = buf_parts.price-rubl
     3684     price-base-with-tax-loc = buf_parts.price-base
     3685   .
     3686   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3687   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3688     (output varinvprb
     3689     )  .
     3690     if buf_parts.out-code = 'free-zone':U     or
     3691        buf_parts.out-code = 'out-zone':U   or
     3692        buf_parts.doc-type = 'акт':U then do:
     3693       assign
     3694         in-vatp-have-vat-slt = yes.
     3695     end.
     3696     else do:
     3697       find first in-vatp_doc-attr no-lock
     3698         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     3699           and in-vatp_doc-attr.attr-code = 'envd':U
     3700         no-error .
     3701       if not available in-vatp_doc-attr then do:
     3702         assign
     3703           in-vatp-have-vat-slt = yes.
     3704       end.
     3705       else do:
     3706            in-vatp-have-vat-slt = no.
     3707       end.
     3708     end.
     3709     assign
     3710      price-cli-with-tax-loc = buf_parts.price-cli
     3711      cli-base-rate          = buf_parts.cli-base-rate.
     3712     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     3713              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     3714     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     3715             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     3716             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     3717             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     3718             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     3719             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     3720             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3721       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     3722     assign
     3723       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     3724     assign
     3725       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     3726       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     3727       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     3728       transport-cli-loc  = 0
     3729       other-cli-loc      = 0
     3730     .
     3731   ASSIGN
     3732             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     3733       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     3734   .
     3735               ASSIGN
     3736                   v-fact-qnty           = buf_parts.fact-qnty
     3737                   v-sum-rubl            = price-rubl-with-tax-loc * v-fact-qnty
     3738                   v-vat-rubl            = vat-rubl-loc            * v-fact-qnty
     3739                   v-slt-rubl            = slt-rubl-loc            * v-fact-qnty
     3740                   v-road-tax-rubl       = road-tax-rubl-loc       * v-fact-qnty
     3741                   v-transport-rubl      = transport-rubl-loc      * v-fact-qnty
     3742                   v-other-rubl          = other-rubl-loc          * v-fact-qnty
     3743                   v-excise-rubl         = 0
     3744                   v-sum-base            = price-base-with-tax-loc * v-fact-qnty
     3745                   v-vat-base            = vat-base-loc            * v-fact-qnty
     3746                   v-slt-base            = slt-base-loc            * v-fact-qnty
     3747                   v-road-tax-base       = road-tax-base-loc       * v-fact-qnty
     3748                   v-transport-base      = transport-base-loc      * v-fact-qnty
     3749                   v-other-base          = other-base-loc          * v-fact-qnty
     3750                   v-excise-base         = 0
     3751                   v-parts-host-code     = buf_parts.host-code
     3752                   v-parts-contract-code = buf_parts.contract-code
     3753                   v-parts-price-cli     = buf_parts.price-cli
     3754                   v-parts-cli-base-rate = buf_parts.cli-base-rate
     3755                   v-parts-vat-type      = buf_parts.vat-type
     3756                   v-parts-exch-code     = buf_parts.exch-code
     3757               .
     3758               if buf_parts.contract-code <> 0
     3759               then do:
     3760                   assign
     3761                       v-supp-dog-code = string( buf_parts.contract-code )
     3762                   .
     3763                   find first buf_contract no-lock
     3764                        where buf_contract.host-code       = v-parts-host-code
     3765                          and buf_contract.contract-code   = v-parts-contract-code
     3766                   no-error.
     3767                   if available buf_contract
     3768                   then do:
     3769                       assign
     3770                           v-supp-ndog          = string( buf_contract.contract-prn-code )
     3771                           v-supp-ddog          = string( buf_contract.contract-date, "99.99.9999" )
     3772                       .
     3773                   end.
     3774               end.
     3775               if p-gds-code <> 0
     3776               then do:
     3777                   find first buf_parts-attr no-lock
     3778                        where buf_parts-attr.in-code   = buf_parts.in-code
     3779                          and buf_parts-attr.gds-code  = p-gds-code
     3780                          and buf_parts-attr.part-code = buf_parts.part-code
     3781                   no-error .
     3782                   if available buf_parts-attr
     3783                   then do:
     3784                       assign
     3785                           v-supp-type                 = buf_parts-attr.supp-type
     3786                           v-supp-code                 = buf_parts-attr.supp-code
     3787                           v-in-code                   = buf_parts-attr.income-in-code
     3788                           v-cst-code                  = buf_parts-attr.cst-code
     3789                           v-country-code              = string( buf_parts-attr.country-code )
     3790                           v-parts-attr-exch-rate      = buf_parts-attr.exch-rate
     3791                           v-parts-attr-exch-scale     = buf_parts-attr.exch-scale
     3792                           v-parts-attr-unit-cli       = buf_parts-attr.unit-cli
     3793                       .
     3794                   end.
     3795                   else do:
     3796                       assign
     3797                           v-supp-type                 = buf_parts.supp-type
     3798                           v-supp-code                 = buf_parts.supp-code
     3799                           v-in-code                   = buf_parts.in-code
     3800                           v-cst-code                  = buf_parts.cst-code
     3801                           v-country-code              = "":U
     3802                           v-parts-attr-exch-rate      = 0.0
     3803                           v-parts-attr-exch-scale     = 0
     3804                           v-parts-attr-unit-cli       = "":U
     3805                       .
     3806                   end.
     3807               end.
     3808               else do:
     3809                   assign
     3810                       v-supp-type                 = buf_parts.supp-type
     3811                       v-supp-code                 = buf_parts.supp-code
     3812                       v-in-code                   = buf_parts.in-code
     3813                       v-cst-code                  = buf_parts.cst-code
     3814                       v-country-code              = "":U
     3815                       v-parts-attr-exch-rate      = 0.0
     3816                       v-parts-attr-exch-scale     = 0
     3817                       v-parts-attr-unit-cli       = "":U
     3818                   .
     3819               end.
     3820               run bgelib-tag-open in this-procedure ( input 0, input "linePart", input "" ).
     3821               run bgelib-tag-put in this-procedure ( input 1, input "docID"               , input p-doc-code                 , input 0 ).
     3822               run bgelib-tag-put in this-procedure ( input 1, input "goodID"              , input ( if p-gds-code = 0 then "" else string( p-gds-code ) ), input 0 ).
     3823               run bgelib-tag-put in this-procedure ( input 1, input "inputDocID"          , input string( v-in-code               ), input 2 ).
     3824               run bgelib-tag-put in this-procedure ( input 1, input "qnty"                , input string( v-fact-qnty             ), input 2 ).
     3825               run bgelib-tag-put in this-procedure ( input 1, input "cst"                 , input string( v-cst-code              ), input 2 ).
     3826               run bgelib-tag-put in this-procedure ( input 1, input "supp"                , input string( v-supp-type + string( v-supp-code ) ), input 2 ).
     3827               run bgelib-tag-put in this-procedure ( input 1, input "hostCode"            , input string( v-parts-host-code       ), input 2 ).
     3828               run bgelib-tag-put in this-procedure ( input 1, input "contractCode"        , input string( v-parts-contract-code   ), input 2 ).
     3829               run bgelib-tag-put in this-procedure ( input 1, input "sumr"                , input string( v-sum-rubl              ), input 2 ).
     3830               run bgelib-tag-put in this-procedure ( input 1, input "VATr"                , input string( v-vat-rubl              ), input 2 ).
     3831               run bgelib-tag-put in this-procedure ( input 1, input "SLTr"                , input string( v-slt-rubl              ), input 2 ).
     3832               run bgelib-tag-put in this-procedure ( input 1, input "roadTaxr"            , input string( v-road-tax-rubl         ), input 2 ).
     3833               run bgelib-tag-put in this-procedure ( input 1, input "transportr"          , input string( v-transport-rubl        ), input 2 ).
     3834               run bgelib-tag-put in this-procedure ( input 1, input "otherr"              , input string( v-other-rubl            ), input 2 ).
     3835               run bgelib-tag-put in this-procedure ( input 1, input "exciser"             , input string( v-excise-rubl           ), input 2 ).
     3836               run bgelib-tag-put in this-procedure ( input 1, input "sumb"                , input string( v-sum-base              ), input 2 ).
     3837               run bgelib-tag-put in this-procedure ( input 1, input "VATb"                , input string( v-vat-base              ), input 2 ).
     3838               run bgelib-tag-put in this-procedure ( input 1, input "SLTb"                , input string( v-slt-base              ), input 2 ).
     3839               run bgelib-tag-put in this-procedure ( input 1, input "roadTaxb"            , input string( v-road-tax-base         ), input 2 ).
     3840               run bgelib-tag-put in this-procedure ( input 1, input "transportb"          , input string( v-transport-base        ), input 2 ).
     3841               run bgelib-tag-put in this-procedure ( input 1, input "otherb"              , input string( v-other-base            ), input 2 ).
     3842               run bgelib-tag-put in this-procedure ( input 1, input "exciseb"             , input string( v-excise-base           ), input 2 ).
     3843               run bgelib-tag-put in this-procedure ( input 1, input "contractSuppCode"    , input v-supp-dog-code                  , input 2 ).
     3844               run bgelib-tag-put in this-procedure ( input 1, input "contractSuppNo"      , input v-supp-ndog                      , input 2 ).
     3845               run bgelib-tag-put in this-procedure ( input 1, input "contractSuppDate"    , input v-supp-ddog                      , input 2 ).
     3846               run bgelib-tag-put in this-procedure ( input 1, input "countryCode"         , input v-country-code                   , input 2 ).
     3847               run bgelib-tag-put in this-procedure ( input 1, input "priceCli":U          , input string( v-parts-price-cli       ), input 2 ).
     3848               run bgelib-tag-put in this-procedure ( input 1, input "cliBaseRate":U       , input string( v-parts-cli-base-rate   ), input 2 ).
     3849               run bgelib-tag-put in this-procedure ( input 1, input "vatType":U           , input string( v-parts-vat-type        ), input 0 ).
     3850               run bgelib-tag-put in this-procedure ( input 1, input "exchCode":U          , input string( v-parts-exch-code       ), input 2 ).
     3851               run bgelib-tag-put in this-procedure ( input 1, input "attrExchRate":U      , input string( v-parts-attr-exch-rate  ), input 2 ).
     3852               run bgelib-tag-put in this-procedure ( input 1, input "attrExchScale":U     , input string( v-parts-attr-exch-scale ), input 2 ).
     3853               run bgelib-tag-put in this-procedure ( input 1, input "attrUnitCli":U       , input string( v-parts-attr-unit-cli   ), input 0 ).
     3854               run bgelib-tag-close in this-procedure ( input 0, input "linePart" ).
     3855           end.
     3856           if p-cst = yes
     3857           then do:
     3858               assign
     3859                   v-parts-cst-code = v-parts-cst-code
     3860                                       + ( if ( v-cst-code <> ?
     3861                                           and trim( v-cst-code )   <> ""
     3862                                           and trim( v-parts-cst-code ) <> "" )
     3863                                           then "; "
     3864                                           else ""  )
     3865                                       + v-cst-code
     3866               .
     3867           end.
     3868       end.
     3869       if p-cst = yes
     3870       and v-parts-cst-code <> ""
     3871       then do:
     3872           run bgelib-tag-open in this-procedure ( input 0, input "lineCST", input "" ).
     3873           run bgelib-tag-put in this-procedure ( input 1, input "docID"  , input p-doc-code       , input 0 ).
     3874           run bgelib-tag-put in this-procedure ( input 1, input "goodID" , input ( if p-gds-code = 0 then "" else string( p-gds-code ) ), input 0 ).
     3875           run bgelib-tag-put in this-procedure ( input 1, input "CST"      , input v-parts-cst-code , input 0 ).
     3876           run bgelib-tag-close in this-procedure ( input 0, input "lineCST" ).
     3877       end.
     3878   end.
     3879   end procedure.
     3880   procedure export-gds-dtl :
     3881   define input parameter p-ext-doc-type   as character        no-undo.
     3882   define input parameter p-doc-code       as character        no-undo.
     3883   define input parameter p-gds-code       as integer          no-undo.
     3884   define input parameter p-artic          as character        no-undo.
     3885   define input parameter p-prod-type      as character        no-undo.
     3886   define input parameter p-prod-code      as integer          no-undo.
     3887       define variable v-doc-qnty       as decimal       no-undo.
     3888       define variable v-fact-qnty      as decimal       no-undo.
     3889       define variable v-sum-base       as decimal       no-undo.
     3890       define variable v-sum-rubl       as decimal       no-undo.
     3891       define variable v-vat-base       as decimal       no-undo.
     3892       define variable v-vat-rubl       as decimal       no-undo.
     3893       define variable v-slt-base       as decimal       no-undo.
     3894       define variable v-slt-rubl       as decimal       no-undo.
     3895       define variable v-road-tax-base  as decimal       no-undo.
     3896       define variable v-road-tax-rubl  as decimal       no-undo.
     3897       define buffer buf_gds-dtl       for ub.gds-dtl.
     3898       define buffer buf_gds-prt       for ub.gds-prt.
     3899       define buffer buf_trn-doc       for ub.trn-doc.
     3900       define buffer buf_doc-line      for ub.doc-line.
     3901   do
     3902   for buf_gds-dtl
     3903     , buf_gds-prt
     3904     , buf_trn-doc
     3905     , buf_doc-line
     3906   on error undo, return error
     3907   :
     3908       find first buf_trn-doc no-lock
     3909            where buf_trn-doc.doc-code = p-doc-code
     3910       no-error.
     3911       if not available buf_trn-doc
     3912       then do:
     3913           run bgelib-write-log in this-procedure (
     3914                 input p-log-file-name
     3915               , input 1
     3916               , input substitute( "*** ERR: *** Не найден документ '&1'."
     3917                                   , p-doc-code
     3918                               )
     3919           ).
     3920           undo, return error.
     3921       end.
     3922       find first buf_doc-line no-lock
     3923            where buf_doc-line.doc-code    = p-doc-code
     3924              and buf_doc-line.artic       = p-artic
     3925              and buf_doc-line.prod-type   = p-prod-type
     3926              and buf_doc-line.prod-code   = p-prod-code
     3927       no-error.
     3928       if not available buf_doc-line
     3929       then do:
     3930           run bgelib-write-log in this-procedure (
     3931                 input p-log-file-name
     3932               , input 1
     3933               , input substitute( "*** ERR: *** Не найдена строка документа '&1' с артикулом товара '&2'."
     3934                                   , p-doc-code
     3935                                   , p-artic
     3936                               )
     3937           ).
     3938           undo, return error.
     3939       end.
     3940       for each buf_gds-dtl no-lock
     3941          where buf_gds-dtl.prod-type  = p-prod-type
     3942            and buf_gds-dtl.prod-code  = p-prod-code
     3943            and buf_gds-dtl.artic      = p-artic
     3944            and buf_gds-dtl.doc-code   = p-doc-code
     3945       :
     3946           find first buf_gds-prt no-lock
     3947                where buf_gds-prt.node-code = buf_gds-dtl.prt-code
     3948           .
     3949   if buf_trn-doc.ext-doc-type = 'ot':U or
     3950      buf_trn-doc.ext-doc-type = ?                 then do:
     3951     assign
     3952      out-vatp-have-vat-slt = yes.
     3953   end.
     3954   else do:
     3955     find first out-vatp_doc-attr no-lock
     3956       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     3957         and out-vatp_doc-attr.attr-code = 'envd':U
     3958         no-error .
     3959     if not available out-vatp_doc-attr then do:
     3960       assign
     3961         out-vatp-have-vat-slt = yes.
     3962     end.
     3963     else do:
     3964        out-vatp-have-vat-slt = no.
     3965     end.
     3966   end.
     3967   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
     3968                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
     3969                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
     3970   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3971   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     3972     (input  buf_doc-line.artic
     3973     ,input  buf_doc-line.prod-type
     3974     ,input  buf_doc-line.prod-code
     3975     ,output varroot-node
     3976     ) no-error .
     3977   if error-status :error then do:
     3978     message
     3979       vss-workfile vss-revision vss-description skip
     3980       "Ошибка при определении корневого признака товара" skip
     3981       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     3982       error-status :get-message(1) skip
     3983       return-value skip
     3984       view-as alert-box error .
     3985     undo, return error .
     3986   end.
     3987   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     3988     (input  varroot-node
     3989     ,input  'empty-scale=request'
     3990     ,output varempty-scale
     3991     ) no-error .
     3992   if error-status :error then do:
     3993     message
     3994       vss-workfile vss-revision vss-description skip
     3995       "Ошибка при определении атрибута признака" skip
     3996       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     3997       "Признак" varroot-node skip
     3998       "Запрашивался атрибут" "empty-scale=request" skip
     3999       error-status :get-message(1) skip
     4000       return-value skip
     4001       view-as alert-box error .
     4002     undo, return error .
     4003   end.
     4004   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4005   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4006     (output varoutvprb
     4007     )  .
     4008   if varoutvprb = "base":u then do:
     4009     assign
     4010           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     4011       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
     4012     .
     4013   end.
     4014   else do:
     4015     assign
     4016           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     4017       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     4018     .
     4019   end.
     4020   if varoutvprb = "rubl":u then do:
     4021     assign
     4022           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     4023       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
     4024   end.
     4025   else do:
     4026     assign
     4027           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     4028       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
     4029   end.
     4030   assign
     4031     varis-cons-parts-have =  no.
     4032   assign
     4033     varfact-qnty       = 0
     4034     varcons-qnty       = 0
     4035     varprice-base-cons = 0
     4036     varprice-rubl-cons = 0.
     4037   find first out-vatp_doc-line where
     4038              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     4039          and out-vatp_doc-line.artic      = buf_doc-line.artic
     4040          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
     4041          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
     4042   if available out-vatp_doc-line           and
     4043     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     4044     assign
     4045       varfact-qnty = out-vatp_doc-line.fact-qnty.
     4046   end.
     4047   else do:
     4048     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     4049                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     4050                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     4051                                  and out-vatp_parts.artic      = buf_doc-line.artic
     4052                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
     4053                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
     4054       if out-vatp_parts.purch-code = 2 then do:
     4055   assign
     4056     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     4057     price-base-with-tax-loco = out-vatp_parts.price-base
     4058   .
     4059   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4060   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4061     (output varinvprbo
     4062     )  .
     4063     if out-vatp_parts.out-code = 'free-zone':U     or
     4064        out-vatp_parts.out-code = 'out-zone':U   or
     4065        out-vatp_parts.doc-type = 'акт':U then do:
     4066       assign
     4067         in-vatp-have-vat-slto = yes.
     4068     end.
     4069     else do:
     4070       find first in-vatp_doc-attro no-lock
     4071         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     4072           and in-vatp_doc-attro.attr-code = 'envd':U
     4073         no-error .
     4074       if not available in-vatp_doc-attro then do:
     4075         assign
     4076           in-vatp-have-vat-slto = yes.
     4077       end.
     4078       else do:
     4079            in-vatp-have-vat-slto = no.
     4080       end.
     4081     end.
     4082     assign
     4083      price-cli-with-tax-loco = out-vatp_parts.price-cli
     4084      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     4085     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     4086              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     4087     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     4088             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     4089             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     4090             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     4091             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     4092             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     4093             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     4094       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     4095     assign
     4096       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     4097     assign
     4098       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     4099       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     4100       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     4101       transport-cli-loco  = 0
     4102       other-cli-loco      = 0
     4103     .
     4104   ASSIGN
     4105             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     4106       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     4107   .
     4108         assign
     4109           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     4110           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     4111         assign
     4112           varis-cons-parts-have = yes
     4113           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     4114       end.
     4115       assign
     4116         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     4117     end.
     4118   end.
     4119   assign
     4120     varprice-base-cons = varprice-base-cons / varcons-qnty
     4121     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     4122   if varprice-base-cons = ? then do:
     4123     assign
     4124       varprice-base-cons = 0.
     4125   end.
     4126   if varprice-rubl-cons = ? then do:
     4127     assign
     4128       varprice-rubl-cons = 0.
     4129   end.
     4130   assign
     4131       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     4132     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     4133     discnt-base-sale            = buf_gds-dtl.discnt-base
     4134     price-base-with-tax-sale    = (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
     4135       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     4136     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     4137     discnt-rubl-sale            = buf_gds-dtl.discnt-rubl
     4138     price-rubl-with-tax-sale    = (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
     4139     .
     4140   if buf_trn-doc.doc-type = 'инв':U then do:
