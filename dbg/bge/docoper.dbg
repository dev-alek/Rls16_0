     1941   procedure export-documents :
     1942   do
     1943   on error undo, return error
     1944   :
     1945   define input parameter p-obj-list               as character    no-undo.
     1946   define input parameter p-doc-type-list          as character    no-undo.
     1947   define input parameter p-parameter-list         as character    no-undo.
     1948   define input parameter p-xml-file-name          as character    no-undo.
     1949   define input parameter p-log-file-name          as character    no-undo.
     1950   define input parameter p-list-file-name         as character    no-undo.
     1951   define input parameter p-xml-file-number        as integer      no-undo.
     1952   define output parameter p-last-xml-file-name    as character    no-undo.
     1953   define output parameter p-last-xml-file-number  as integer      no-undo.
     1954       define variable v-doc-code      as character    no-undo.
     1955       define variable v-good-code     as character      no-undo.
     1956       define variable v-good-type     as character      no-undo.
     1957       define variable v-obj-type      as character    no-undo.
     1958       define variable v-obj-code      as integer      no-undo.
     1959       define variable v-fact-order    as decimal      no-undo.
     1960       define variable v-sys-date      as date         no-undo.
     1961       define variable v-sys-time      as character    no-undo.
     1962       define variable v-exists-before as logical      no-undo.
     1963       define variable v-exists-after  as logical      no-undo.
