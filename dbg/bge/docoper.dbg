     1702   procedure cp-attr-delete :
     1703     do
     1704     on error undo, return error
     1705     :
     1706       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     1707       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     1708       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     1709       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     1710       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     1711       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     1712       define output parameter p-deleted  as logical no-undo.
     1713       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     1714       define variable v-type           as character no-undo .
     1715       define variable v-format         as character no-undo .
     1716       define variable v-label          as character no-undo .
     1717       define variable v-range          as integer   no-undo .
     1718       define variable v-user-can-edit  as logical   no-undo .
     1719       define variable v-output-display as logical   no-undo .
     1720       define variable v-other          as character no-undo .
     1721       run cp-attr-code in this-procedure
     1722         (input  p-code
     1723         ,output v-type
     1724         ,output v-format
     1725         ,output v-label
     1726         ,output v-range
     1727         ,output v-user-can-edit
     1728         ,output v-output-display
     1729         ,output v-other
     1730         ) no-error .
     1731       if error-status :error then do:
     1732         undo, return error return-value .
     1733       end.
     1734       find first buf_cash-pay-attr exclusive-lock
     1735         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     1736           and buf_cash-pay-attr.curr-code  = p-curr-code
     1737           and buf_cash-pay-attr.host-code  = p-host-code
     1738           and buf_cash-pay-attr.obj-type   = p-obj-type
     1739           and buf_cash-pay-attr.obj-code   = p-obj-code
     1740           and buf_cash-pay-attr.attr-code = p-code
     1741         no-error NO-WAIT.
     1742       if not available buf_cash-pay-attr then do:
     1743         p-deleted = no.
     1744       end.
     1745       else do:
     1746         delete buf_cash-pay-attr no-error .
     1747         if error-status:error then do:
     1748           undo, return error return-value .
     1749         end.
     1750         p-deleted = yes.
     1751       end.
     1752     end.
     1753   end procedure.
     1754   procedure cp-attr-news :
     1755     do
     1756     on error undo, return error
     1757     :
     1758       define input  parameter p-code           as character no-undo .
     1759       define output parameter p-news           as logical   no-undo .
     1760       case p-code :
     1761               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     1762               when 'grp-code':U then do:     assign     p-news = true.   end.
     1763               when 'is-use':U then do:     assign     p-news = true.   end.
     1764               when 'dop-doc':U then do:     assign     p-news = true.   end.
     1765               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     1766               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     1767               when 'form_km3':U then do:     assign     p-news = false.   end.
     1768               when 'bal_malina':U then do:     assign     p-news = false.   end.
     1769               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     1770               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     1771         otherwise do:
     1772           p-news = no.
     1773         end.
     1774       end.
     1775     end.
     1776   end procedure.
