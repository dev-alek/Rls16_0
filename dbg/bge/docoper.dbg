     2013       assign
     2014           p-last-xml-file-name    = p-xml-file-name
     2015           p-last-xml-file-number  = p-xml-file-number
     2016       .
     2017       output stream stmxmlout to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2018       export-documents-arch:
     2019       for each  buf_ot-tot-crsa-loop no-lock
     2020          where buf_ot-tot-crsa-loop.obj-type     = p-obj-type
     2021            and buf_ot-tot-crsa-loop.obj-code     = p-obj-code
     2022            and buf_ot-tot-crsa-loop.ext-doc-type = p-ext-doc-type
     2023            and buf_ot-tot-crsa-loop.fact-order   > p-fact-order-from
     2024            and buf_ot-tot-crsa-loop.fact-order  <= p-fact-order-to
     2025            and buf_ot-tot-crsa-loop.sum-type     = 'crsa':U
     2026            and buf_ot-tot-crsa-loop.cat-id       = '##,##':U
     2027       on error undo, return error
     2028       :
     2029           assign
     2030               v-supp-dog-code = "":U
     2031               v-supp-ndog     = "":U
     2032               v-supp-ddog     = "":U
     2033           .
     2034           if v-need-new-file = yes
     2035           then do:
     2036               output stream stmxmlout close.
