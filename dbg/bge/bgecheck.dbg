     1072   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1073                                             INPUT iFlagEmpty AS INTEGER).
     1074       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1075       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1076           DO:
     1077               IF iFlagEmpty = 0                           THEN RETURN "".
     1078               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1079               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1080               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1081               ELSE RETURN "".
     1082           END.
     1083       ELSE DO:
     1084           run xmlchar-encode in this-procedure (
     1085                 input sToPlace
     1086               , output sToPlace
     1087           ).
     1088           ASSIGN
     1089               sToPlace = sParName + '="' + sToPlace + '"'
     1090           .
     1091           RETURN sToPlace.
     1092       END.
     1093   END FUNCTION.
     1094   function bge-xml-date returns character
     1095   ( input p-date as date )
     1096   :
     1097     define variable v-date-str as character no-undo .
     1098     run bge-xml-date-to-str in this-procedure ( input   p-date
     1099                                               , output  v-date-str
     1100                                               ) .
     1101     return v-date-str.
     1102   end function.
     1103   function bge-xml-str-date returns character
     1104   ( input p-date-str as character )
     1105   :
     1106     define variable v-date-str as character no-undo .
     1107     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1108                                                   , output  v-date-str
     1109                                                   ) .
     1110     return v-date-str.
     1111   end function.
     1112   function bge-xml-normalize-dec returns decimal
     1113   ( input p-val as decimal )
     1114   :
     1115     return (if p-val = ? then 0 else p-val) .
     1116   end function.
     1117   PROCEDURE wp-XMLTagOpen:
     1118   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1119   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1120   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1121       define variable v-out-string    as character    no-undo.
     1122   do
     1123   on error undo, return error
     1124   :
     1125       if v-bge-xml-bgefmt = "dbf":U
     1126       then do:
     1127       end.
     1128       else do:
     1129           assign
     1130               v-out-string = substitute( "&1&2<&3&4>"
     1131                                       , chr(10)
     1132                                       , fill( " ":U, 4 * iTagLevel)
     1133                                       , sTagName
     1134                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1135                               )
     1136           .
     1137           put stream stmXMLOut unformatted
     1138               v-out-string
     1139           .
     1140       end.
     1141   end.
     1142   END PROCEDURE.
     1143   PROCEDURE wp-XMLTagPut:
     1144     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1145     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1146     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1147     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1148       define variable v-out-string    as character    no-undo.
     1149   do
     1150   on error undo, return error
     1151   :
     1152       if v-bge-xml-bgefmt = "dbf":U
     1153       then do:
     1154           if v-bge-xml-dbf-file-name <> "":U
     1155           then do:
     1156               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1157               export stream stmXMLOut
     1158                   sTagName
     1159                   sParValue
     1160               .
     1161               output stream stmXMLOut close.
     1162           end.
     1163       end.
     1164       else do:
     1165           IF  iFlagEmpty = 1
     1166           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1167           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1168           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1169           THEN DO:
     1170               run xmlchar-encode in this-procedure (
     1171                   input sParValue
     1172                   , output sParValue
     1173               ).
     1174               assign
     1175                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1176                                               , chr(10)
     1177                                               , FILL(" ", 4 * iTagLevel)
     1178                                               , sTagName
     1179                                               , sParValue
     1180                               )
     1181               .
     1182               PUT STREAM stmXMLOut UNFORMATTED
     1183                   v-out-string
     1184               .
     1185           END.
     1186       end.
     1187   end.
     1188   END PROCEDURE.
     1189   PROCEDURE wp-XMLTagClose:
     1190   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1191   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1192       define variable v-out-string    as character    no-undo.
     1193   do
     1194   on error undo, return error
     1195   :
     1196       if v-bge-xml-bgefmt = "dbf":U
     1197       then do:
     1198       end.
     1199       else do:
     1200           assign
     1201               v-out-string = substitute( "&1&2</&3>"
     1202                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1203                                   , fill( " ", 4 * iTagLevel )
     1204                                   , sTagName
     1205                           )
     1206           .
     1207           PUT STREAM stmXMLOut UNFORMATTED
     1208               v-out-string
     1209           .
     1210       end.
     1211   end.
     1212   END PROCEDURE.
     1213   PROCEDURE wp-XMLWriteLog:
     1214     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1215     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1216     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1217   define variable v-str              as character no-undo .
     1218   define variable v-error-append     as logical   no-undo .
     1219   define variable v-error-append-msg as character no-undo .
     1220   assign
     1221     v-str = chr(10)
     1222             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1223             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1224     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1225     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1226     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1227   .
     1228   run bge/bge-log.p (input v-str) no-error .
     1229   if error-status:error then do:
     1230     assign
     1231       v-error-append     = yes
     1232       v-error-append-msg = return-value
     1233     .
     1234   end.
     1235   run gbl/fileapnd.p
     1236     ( input sFileName
     1237     , input v-str
     1238     , input 10
     1239     ) no-error .
     1240   if error-status:error then do:
     1241     assign
     1242       v-error-append     = yes
     1243       v-error-append-msg = substitute( "&1&2&3"
     1244                                       , v-error-append-msg
     1245                                       , chr(10)
     1246                                       , return-value
     1247                                       )
     1248     .
     1249   end.
     1250   if v-error-append
     1251   then do:
     1252     return error substitute( "&1" , v-error-append-msg ) .
     1253   end.
     1254   END PROCEDURE.
     1255   PROCEDURE wp-XMLWriteEDT:
     1256     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1257     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1258     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1259       if valid-handle ( hEDT )
     1260       then do:
     1261           hEDT :move-to-eof().
     1262           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1263                                           OR sToWrite = "&Line") THEN "" ELSE
     1264                                           cur-time-string-sec() + " ").
     1265           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1266                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1267                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1268           hEDT :insert-string(chr(10)).
     1269       end.
     1270       process events.
     1271       output to 'bgescn.txt' append.
     1272           put unformatted
     1273               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1274                                           OR sToWrite = "&Line") THEN "" ELSE
     1275                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1276               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1277                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1278                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1279           .
     1280       output close.
     1281   END PROCEDURE.
     1282   PROCEDURE wp-XMLShowCNT:
     1283     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1284       if valid-handle( hCNT )
     1285       then do:
     1286           ASSIGN hCNT :VISIBLE = TRUE.
     1287       end.
     1288   END PROCEDURE.
     1289   PROCEDURE wp-XMLHideCNT:
     1290     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1291       if valid-handle( hCNT )
     1292       then do:
     1293           ASSIGN hCNT :VISIBLE = FALSE.
     1294       end.
     1295   END PROCEDURE.
     1296   PROCEDURE wp-XMLWriteCNT:
     1297     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1298     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1299       if valid-handle( hCNT )
     1300       then do:
     1301           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1302       end.
     1303   END PROCEDURE.
     1304   procedure bge-xml-write-header:
     1305   do
     1306   on error undo, return error
     1307   :
     1308   define input parameter p-xml-file-name  as character        no-undo.
     1309   define input parameter p-doc-name       as character        no-undo.
     1310   define input parameter p-version        as character        no-undo.
     1311   define input parameter p-db-num         as integer          no-undo.
     1312   define input parameter p-date-from      as date             no-undo.
     1313   define input parameter p-shift-num-from as integer          no-undo.
     1314   define input parameter p-date-to        as date             no-undo.
     1315   define input parameter p-shift-num-to   as integer          no-undo.
     1316   define input parameter p-obj-list       as character        no-undo.
     1317   define input parameter p-doc-type-list  as character        no-undo.
     1318   define input parameter p-pay-code       as logical          no-undo.
     1319   define input parameter p-cst            as logical          no-undo.
     1320   define input parameter p-parts          as logical          no-undo.
     1321   define input parameter p-chk-pay-code   as logical          no-undo.
     1322   define input parameter p-pay-desk       as logical          no-undo.
     1323   define input parameter p-pay-desk-cards as logical          no-undo.
     1324   define input parameter p-deleted        as logical          no-undo.
     1325   define input parameter p-opened-docs    as logical          no-undo.
     1326   define variable v-out-string    as character    no-undo.
     1327   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1328   assign
     1329       v-out-string = substitute( "&1&2&3"
     1330                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1331                           , chr(10)
     1332                           , "<IBS_Trade_House>":U )
     1333   .
     1334   put stream stmXMLOut unformatted
     1335       v-out-string
     1336   .
     1337   run wp-XMLTagOpen(1, "header","").
     1338   if v-bge-xml-bgeflold = "oracle":u
     1339   then do:
     1340     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1341     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1342     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1343     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1344     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1345   end.
     1346   run wp-XMLTagOpen( 2, "manifest", "").
     1347   run wp-XMLTagOpen( 3, "document", "").
     1348   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1349   run wp-XMLTagput( 4, "description", "", 0).
     1350   run wp-XMLTagput( 4, "version", p-version, 0).
     1351   run wp-XMLTagclose( 3, "document" ).
     1352   run wp-XMLTagclose( 2, "manifest" ).
     1353   run wp-XMLTagclose( 1, "header" ).
     1354   run wp-XMLTagOpen(1, "options","").
     1355   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1356   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1357   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1358   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1359   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1360   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1361   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1362   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1363   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1364   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1365   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1366   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1367   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1368   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1369   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1370   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1371   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1372   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1373   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1374   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1375   run wp-XMLTagClose(1, "options").
     1376   run wp-XMLTagOpen( 1, "body", "" ).
     1377   output stream stmXMLOut close.
     1378   end.
     1379   end procedure.
     1380   procedure xml-bge-write-footer:
     1381   do
     1382   on error undo, return error return-value
     1383   :
     1384   define input parameter p-xml-file-name as character    no-undo.
     1385   define variable v-error-num     as integer           no-undo.
     1386   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1387   run wp-XMLTagClose( 1, "body" ).
     1388   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1389   output stream stmXMLOut close.
     1390   if v-bge-xml-bgeflold = "oracle":u
     1391   then do:
     1392     define variable v-tmp-file-name         as character no-undo .
     1393     define variable v-zip-file-name         as character no-undo .
     1394     define variable v-exch-file-name        as character no-undo .
     1395     define variable v-heap-file-name        as character no-undo .
     1396     define variable v-i                     as integer   no-undo .
     1397     define variable v-file-name             as character no-undo .
     1398     define variable v-arc                   as character no-undo .
     1399     define variable v-str                   as character no-undo .
     1400     define variable v-exch-tmp-file-name    as character no-undo .
     1401     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1402     define variable v-bge-xml-exch-dir      as character no-undo .
     1403     define variable v-bge-xml-heap-dir      as character no-undo .
     1404     define variable v-bge-xml-compress-heap as logical   no-undo .
     1405     define variable v-home-dir              as character no-undo .
     1406     define variable v-os-command            as character no-undo .
     1407     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1408     if v-home-dir = ?
     1409     then do:
     1410       undo, return error substitute( "&1&2&3"
     1411                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1412                                     , chr(10)
     1413                                     , "Обратитесь к администратору.":u
     1414                                     ).
     1415     end.
     1416     assign
     1417       v-home-dir = v-home-dir
     1418     .
     1419     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1420     if error-status :error
     1421     then do:
     1422       undo, return error substitute( "&1&2&3"
     1423                                     , "Неверно задан каталог экспорта.":u
     1424                                     , chr(10)
     1425                                     , "Обратитесь к администратору.":u
     1426                                     ).
     1427     end.
     1428     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1429     if v-bge-xml-exch-dir = ?
     1430     then do:
     1431       undo, return error substitute( "&1&2&3"
     1432                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1433                                     , chr(10)
     1434                                     , "Обратитесь к администратору.":u
     1435                                     ).
     1436     end.
     1437     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1438     if error-status :error
     1439     then do:
     1440       undo, return error substitute( "&1&2&3"
     1441                                     , "Неверно задан каталог экспорта (exch).":u
     1442                                     , chr(10)
     1443                                     , "Обратитесь к администратору.":u
     1444                                     ).
     1445     end.
     1446     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1447     if v-bge-xml-heap-dir = ?
     1448     then do:
     1449       undo, return error substitute( "&1&2&3"
     1450                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1451                                     , chr(10)
     1452                                     , "Обратитесь к администратору.":u
     1453                                     ).
     1454     end.
     1455     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1456     if error-status :error
     1457     then do:
     1458       undo, return error substitute( "&1&2&3"
     1459                                     , "Неверно задан каталог экспорта (heap).":u
     1460                                     , chr(10)
     1461                                     , "Обратитесь к администратору.":u
     1462                                     ).
     1463     end.
     1464     get-key-value section "BGE" key "heap-compress" value v-str.
     1465     assign
     1466       v-i = int(v-str)
     1467     no-error .
     1468     if v-i = ? or v-i = 0
     1469     then do:
     1470       assign
     1471         v-bge-xml-compress-heap = no
     1472       .
     1473     end.
     1474     else do:
     1475       assign
     1476         v-bge-xml-compress-heap = yes
     1477       .
     1478     end.
     1479     assign
     1480       v-arc = search( "exe/7za.exe":u )
     1481     .
     1482     if v-arc = ? or v-arc = ""
     1483     then do:
     1484       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1485     end.
     1486     assign
     1487       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1488       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1489       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1490       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1491       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1492       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1493       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1494     .
     1495     run gbl/del-file.p (input v-tmp-file-name) .
     1496     run gbl/del-file.p (input v-zip-file-name) .
     1497     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1498     if v-error-num > 0
     1499     then do:
     1500         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1501                                      , p-xml-file-name + "xm1":u
     1502                                      , v-tmp-file-name
     1503                                      , v-error-num
     1504                                      ).
     1505     end.
     1506     assign
     1507       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1508                                    , v-arc
     1509                                    , v-zip-file-name
     1510                                    , v-tmp-file-name
     1511                                    )
     1512     .
     1513     os-command silent value ( v-os-command ) .
     1514     run gbl/del-file.p (input v-heap-file-name) .
     1515     if v-bge-xml-compress-heap = no
     1516     then do:
     1517       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1518       if v-error-num > 0
     1519       then do:
     1520           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1521                                        , v-tmp-file-name
     1522                                        , v-heap-file-name
     1523                                        , v-error-num
     1524                                        ) .
     1525       end.
     1526     end.
     1527     else do:
     1528       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1529       if v-error-num > 0
     1530       then do:
     1531           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1532                                        , v-zip-file-name
     1533                                        , v-heap-file-name
     1534                                        , v-error-num
     1535                                        ) .
     1536       end.
     1537     end.
     1538     run gbl/del-file.p (input v-tmp-file-name) .
     1539     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1540     if error-status :error then do:
     1541       undo, return error substitute( "&1&2&3"
     1542                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1543                                     , chr(10)
     1544                                     , "Обратитесь к администратору."
     1545                                     ).
     1546     end.
     1547     run gbl/del-file.p (input v-exch-file-name) .
     1548     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1549     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1550     if v-error-num > 0
     1551     then do:
     1552       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1553                                     , v-zip-file-name
     1554                                     , v-exch-tmp-file-name
     1555                                     , v-error-num
     1556                                     ) .
     1557     end.
     1558     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1559     if v-error-num > 0
     1560     then do:
     1561       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1562                                     , v-exch-tmp-file-name
     1563                                     , v-exch-file-name
     1564                                     , v-error-num
     1565                                     ) .
     1566     end.
     1567     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1568   end.
     1569   else do:
     1570     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1571     if v-error-num > 0
     1572     then do:
     1573       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1574                                     , p-xml-file-name + "xm1"
     1575                                     , p-xml-file-name + "xml"
     1576                                     , v-error-num
     1577                                     ) .
     1578     end.
     1579   end.
     1580   if opsys = "unix"
     1581   then do:
     1582       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1583   end.
     1584   end.
     1585   end procedure.
     1586   procedure xml-bge-filename0:
     1587   define input parameter p-prefix   as character no-undo .
     1588   define input parameter p-name     as character no-undo .
     1589   define input parameter p-shared-process as logical no-undo .
     1590   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1591   define output parameter p-xml-file-name  as character no-undo .
     1592   // define output parameter p-fullfnamenoext as character no-undo .
     1593   define output parameter p-locked         as logical      no-undo.
     1594   define variable v-fullfnamenoext as character no-undo .
     1595   define variable v-fileext        as character no-undo .
     1596   define variable v-fullfname      as character no-undo .
     1597   define variable v-error-num      as integer   no-undo .
     1598   do
     1599   on error undo, return error
     1600   :
     1601     case v-bge-xml-bgeflold :
     1602       when "old" then do:
     1603         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1604         v-fileext       = ".xml":U .
     1605         v-fullfname     = v-fullfnamenoext + v-fileext .
     1606         p-xml-file-name = v-fullfname .
     1607         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1608         if v-error-num > 0 then do:
     1609           return error.
     1610         end.
     1611       end.
     1612       when "var" then do:
     1613         case p-prefix :
     1614           when "doc" then do:
     1615             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1616             v-fileext       = ".xml":U .
     1617             v-fullfname     = v-fullfnamenoext + v-fileext .
     1618             p-xml-file-name = v-fullfname .
     1619           end.
     1620           when "day" then do:
     1621             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1622             v-fileext       = ".xml":U .
     1623             v-fullfname     = v-fullfnamenoext + v-fileext .
     1624             p-xml-file-name = v-fullfname .
     1625           end.
     1626           otherwise do:
     1627             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1628             v-fileext       = ".xml":U .
     1629             v-fullfname     = v-fullfnamenoext + v-fileext .
     1630             p-xml-file-name = v-fullfname .
     1631           end.
     1632         end case.
     1633         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1634         if v-error-num > 0 then do:
     1635           return error.
     1636         end.
     1637       end.
     1638       when "new" then do:
     1639                   run bge/genfname.p (
     1640                       input p-home-dir
     1641                       , input p-prefix
     1642                       , input ""
     1643                       , input "xml"
     1644                       , input ""
     1645                       , output p-xml-file-name
     1646                   ).
     1647       end.
     1648       when "no-parameter" then do:
     1649         if p-shared-process then do:
     1650                       run bge/genfname.p (
     1651                           input p-home-dir
     1652                           , input "d"
     1653                           , input ""
     1654                           , input "xml"
     1655                           , input ""
     1656                           , output p-xml-file-name
     1657                       ).
     1658         end.
     1659         else do:
     1660           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1661           v-fileext       = ".xml":U .
     1662           v-fullfname     = v-fullfnamenoext + v-fileext .
     1663           p-xml-file-name = v-fullfname .
     1664           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1665           if v-error-num > 0 then do:
     1666             return error.
     1667           end.
     1668         end.
     1669       end.
     1670     end case.
     1671     assign
     1672       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1673       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1674     .
     1675   end .
     1676   end procedure .
     1677   procedure xml-bge-filename :
     1678   do
     1679   on error undo, return error
     1680   :
     1681   define input parameter p-prefix             as character    no-undo.
     1682   define input parameter p-name               as character    no-undo.
     1683   define input parameter p-shared-process     as logical      no-undo.
     1684   define output parameter p-xml-file-name     as character    no-undo.
     1685   define output parameter p-log-file-name     as character    no-undo.
     1686   define output parameter p-locked            as logical      no-undo.
     1687   define variable v-home-dir          as character no-undo .
     1688   define variable v-error-num         as integer   no-undo .
     1689   define variable v-bge-xml-heap-dir  as character no-undo .
     1690       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1691       if v-home-dir = ?
     1692       then do:
     1693           message
     1694             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1695             skip(1)
     1696             skip "Обратитесь к администратору."
     1697           view-as alert-box error.
     1698           undo, return error .
     1699       end.
     1700       if v-bge-xml-bgeflold <> "oracle"
     1701       then do:
     1702         assign
     1703             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1704         .
     1705       end.
     1706       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1707       if error-status :error
     1708       then do:
     1709           message
     1710             skip "Неверно задан каталог экспорта."
     1711             skip(1)
     1712             skip "Обратитесь к администратору."
     1713           view-as alert-box error.
     1714           undo, return error .
     1715       end.
     1716       if v-bge-xml-bgefmt = "dbf":U
     1717       then do:
     1718           assign
     1719               p-xml-file-name = v-home-dir
     1720               p-locked        = no
     1721           .
     1722       end.
     1723       else do:
     1724           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1725             output p-xml-file-name, output p-locked) .
     1726       end.
     1727       if v-bge-xml-bgeflold = "oracle"
     1728       then do:
     1729         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1730         if v-bge-xml-heap-dir = ?
     1731         then do:
     1732           undo, return error substitute( "&1&2&3"
     1733                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1734                                         , chr(10)
     1735                                         , "Обратитесь к администратору.":u
     1736                                         ).
     1737         end.
     1738         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1739         if error-status :error
     1740         then do:
     1741           undo, return error substitute( "&1&2&3"
     1742                                         , "Неверно задан каталог экспорта (heap).":u
     1743                                         , chr(10)
     1744                                         , "Обратитесь к администратору.":u
     1745                                         ).
     1746         end.
     1747         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1748           assign
     1749             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1750           .
     1751         end.
     1752         else do:
     1753           assign
     1754             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1755           .
     1756         end.
     1757       end.
     1758       else do:
     1759         assign
     1760             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1761         .
     1762       end.
     1763       assign
     1764          v-bge-xml-static-log-file-name = p-log-file-name
     1765       .
     1766   end.
     1767   end procedure.
     1768   procedure bge-xml-read-config :
     1769   do
     1770   on error undo, return error return-value
     1771   :
     1772   define input  parameter p-last-date as date      no-undo .
     1773   define input  parameter p-db-num    as integer   no-undo .
     1774       define variable v-bgeclall      as character     no-undo.
     1775       define variable v-bgedict       as character     no-undo.
     1776       define variable v-bgeshift      as character     no-undo.
     1777       define variable v-par-type      as character     no-undo.
     1778       define variable v-bgeflnm       as character     no-undo.
     1779       define variable v-bgecliiv      as character     no-undo .
     1780       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1781       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1782       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1783       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1784       define variable v-db-num-str    as character     no-undo .
     1785       define variable v-param-type      as character  no-undo .
     1786       define variable v-value-character as character  no-undo .
     1787       define variable v-value-date      as date       no-undo .
     1788       define variable v-value-decimal   as decimal    no-undo .
     1789       define variable v-value-integer   as integer    no-undo .
     1790       define variable v-value-logical   as logical    no-undo .
     1791       define variable v-tth             as handle      no-undo .
     1792       run adm/shattri.p ( input "get":U
     1793                         , input  '':u
     1794                         , input  0
     1795                         , input  'bge-export':U
     1796                         , input  'bgeclall':U
     1797                         , output v-bgecliiv
     1798                         , output v-value-date
     1799                         , output v-value-decimal
     1800                         , output v-value-integer
     1801                         , output v-value-logical
     1802                         , output v-param-type
     1803                         , input-output table-handle v-tth
     1804                         ) no-error .
     1805       if error-status :error
     1806       then do:
     1807         assign
     1808           v-bge-xml-bgecliiv = no
     1809         .
     1810       end.
     1811       else do:
     1812         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1813       end.
     1814       delete object v-tth.
     1815       assign
     1816           v-bge-xml-bgeclall = no
     1817           v-bge-xml-bgedict  = no
     1818       .
     1819       run adm/shattri.p ( input "get":U
     1820                         , input  '':u
     1821                         , input  0
     1822                         , input  'bge-export':U
     1823                         , input  'bgeclall':U
     1824                         , output v-value-character
     1825                         , output v-value-date
     1826                         , output v-value-decimal
     1827                         , output v-value-integer
     1828                         , output v-value-logical
     1829                         , output v-param-type
     1830                         , input-output table-handle v-tth
     1831                         ) no-error .
     1832       if error-status :error
     1833       then do:
     1834         assign
     1835           v-bge-xml-bgeclall = no
     1836         .
     1837       end.
     1838       else do:
     1839         assign
     1840           v-bge-xml-bgeclall = v-value-logical
     1841         .
     1842       end.
     1843       delete object v-tth.
     1844       run adm/shattri.p ( input "get":U
     1845                         , input  '':u
     1846                         , input  0
     1847                         , input  'bge-export':U
     1848                         , input  'bgedict':U
     1849                         , output v-value-character
     1850                         , output v-value-date
     1851                         , output v-value-decimal
     1852                         , output v-value-integer
     1853                         , output v-value-logical
     1854                         , output v-param-type
     1855                         , input-output table-handle v-tth
     1856                         ) no-error .
     1857       if error-status :error
     1858       then do:
     1859         assign
     1860           v-bge-xml-bgedict = no
     1861         .
     1862       end.
     1863       else do:
     1864         assign
     1865           v-bge-xml-bgedict = v-value-logical
     1866         .
     1867       end.
     1868       delete object v-tth.
     1869       run adm/shattri.p ( input "get":U
     1870                         , input  '':u
     1871                         , input  0
     1872                         , input  'bge-export':U
     1873                         , input  'bgefmt':U
     1874                         , output v-value-character
     1875                         , output v-value-date
     1876                         , output v-value-decimal
     1877                         , output v-value-integer
     1878                         , output v-value-logical
     1879                         , output v-param-type
     1880                         , input-output table-handle v-tth
     1881                         ) no-error .
     1882       if error-status :error
     1883       then do:
     1884         assign
     1885           v-bge-xml-bgefmt  = "xml":U
     1886         .
     1887       end.
     1888       else do:
     1889         assign
     1890           v-bge-xml-bgefmt  = v-value-character
     1891         .
     1892       end.
     1893       delete object v-tth.
     1894       run adm/shattri.p ( input "get":U
     1895                         , input  '':u
     1896                         , input  0
     1897                         , input  'bge-export':U
     1898                         , input  'bgeshift':U
     1899                         , output v-value-character
     1900                         , output v-value-date
     1901                         , output v-value-decimal
     1902                         , output v-value-integer
     1903                         , output v-value-logical
     1904                         , output v-param-type
     1905                         , input-output table-handle v-tth
     1906                         ) no-error .
     1907       if error-status :error
     1908       then do:
     1909         assign
     1910             v-bge-xml-shift-mode = no
     1911         .
     1912       end.
     1913       else do:
     1914         assign
     1915             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1916         .
     1917       end.
     1918       delete object v-tth.
     1919       run adm/shattri.p ( input "get":U
     1920                         , input  '':u
     1921                         , input  0
     1922                         , input  'bge-export':U
     1923                         , input  'bgeflold':U
     1924                         , output v-value-character
     1925                         , output v-value-date
     1926                         , output v-value-decimal
     1927                         , output v-value-integer
     1928                         , output v-value-logical
     1929                         , output v-param-type
     1930                         , input-output table-handle v-tth
     1931                         ) no-error .
     1932       if error-status :error
     1933       then do:
     1934         assign
     1935           v-bge-xml-bgeflold = "no-parameter":U
     1936         .
     1937       end.
     1938       else do:
     1939         assign
     1940           v-bge-xml-bgeflold  = v-value-character
     1941         .
     1942       end.
     1943       delete object v-tth.
     1944       assign
     1945         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1946         v-bge-xml-db-num-str  = v-db-num-str
     1947       .
     1948       if p-last-date <> ?
     1949       then do:
     1950           run adm/shattri.p ( input "get":U
     1951                             , input  '':u
     1952                             , input  0
     1953                             , input  'bge-export':U
     1954                             , input  'bgeflnm':U
     1955                             , output v-value-character
     1956                             , output v-value-date
     1957                             , output v-value-decimal
     1958                             , output v-value-integer
     1959                             , output v-value-logical
     1960                             , output v-param-type
     1961                             , input-output table-handle v-tth
     1962                             ) no-error .
     1963           if error-status :error
     1964           then do:
     1965             assign
     1966               v-bgeflnm = '':U
     1967             .
     1968           end.
     1969           else do:
     1970             assign
     1971               v-bgeflnm = v-value-character
     1972             .
     1973           end.
     1974           delete object v-tth.
     1975           if v-bge-xml-bgeflold = "var"
     1976           then do:
     1977               if v-bgeflnm = ?
     1978               or num-entries( v-bgeflnm ) < 2
     1979               then do:
     1980                   assign
     1981                       v-bge-xml-bgeflold = "new"
     1982                   .
     1983               end.
     1984               else do:
     1985                   assign
     1986                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1987                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1988                   .
     1989                   assign
     1990                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1991                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1992                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1993                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1994                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1995                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1996                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1997                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1998                   .
     1999               end.
     2000           end.
     2001       end.
     2002   end.
     2003   end procedure.
     2004   procedure bge-xml-get-ref-filename :
     2005   define input parameter p-in-file-name       as character        no-undo.
     2006   define output parameter p-home-dir          as character        no-undo.
     2007   define output parameter p-out-file-name     as character        no-undo.
     2008   define output parameter p-locked            as logical          no-undo.
     2009       define variable v-counter       as integer      no-undo.
     2010       define variable v-error-level   as integer      no-undo.
     2011   do
     2012   on error undo, return error
     2013   :
     2014       run bge/bge-ini.p (
     2015             input "bge"
     2016           , output p-home-dir
     2017       ).
     2018       if return-value <> "OK"
     2019       then do:
     2020           undo, return error.
     2021       end.
     2022       assign
     2023           p-home-dir = p-home-dir + "\dict":U
     2024       .
     2025       run bge/dir_cd.p (
     2026           input p-home-dir
     2027           , input "CA"
     2028       ).
     2029       if return-value = "ERROR"
     2030       then do:
     2031           undo, return error.
     2032       end.
     2033       assign
     2034           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     2035       .
     2036       assign
     2037           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     2038       .
     2039       wait-lock:
     2040       do v-counter = 1 TO 3
     2041       :
     2042           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     2043           if p-locked = no
     2044           then do:
     2045               leave wait-lock.
     2046           end.
     2047           else do:
     2048               readkey pause 1.
     2049           end.
     2050       END.
     2051       if p-locked = yes
     2052       then do:
     2053           undo, return error.
     2054       end.
     2055       run bge/os_copy.p (
     2056             input "D":U
     2057           , input p-out-file-name + "xml":U
     2058           , input "":U
     2059           , output v-error-level
     2060       ).
     2061       if v-error-level > 0
     2062       then do:
     2063           undo, return error.
     2064       end.
     2065   end.
     2066   end procedure.
     2067   procedure bge-xml-write-ref-header :
     2068   define input parameter p-bge-name as character        no-undo.
     2069   define input parameter p-file-name as character        no-undo.
     2070       define variable v-out-string    as character    no-undo.
     2071   do
     2072   on error undo, return error
     2073   :
     2074       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2075       put stream stmXMLOut unformatted
     2076           "<?xml version='1.0' encoding='windows-1251'?>":U
     2077       .
     2078       assign
     2079           v-out-string = substitute( "&1&2"
     2080                               , chr(10)
     2081                               , "<IBS_Trade_House>":U )
     2082       .
     2083       put stream stmXMLOut unformatted
     2084           v-out-string
     2085       .
     2086       run wp-XMLTagOpen( 1, "header", "" ).
     2087       if v-bge-xml-bgeflold = "oracle":u
     2088       then do:
     2089         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2090         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2091         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2092         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2093         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2094       end.
     2095       else do:
     2096         run wp-XMLTagOpen( 2, "delivery", "" ).
     2097         run wp-XMLTagOpen( 3, "to", "" ).
     2098         run wp-XMLTagClose( 3, "to" ).
     2099         run wp-XMLTagOpen( 3, "from", "" ).
     2100         run wp-XMLTagClose( 3, "from" ).
     2101         run wp-XMLTagClose( 2, "delivery" ).
     2102       end.
     2103       run wp-XMLTagOpen( 2, "manifest", "" ).
     2104       run wp-XMLTagOpen( 3, "document", "" ).
     2105       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2106       run wp-XMLTagPut( 4, "description", "", 0 ).
     2107       run wp-XMLTagClose( 3, "document" ).
     2108       run wp-XMLTagClose( 2, "manifest" ).
     2109       run wp-XMLTagClose( 1, "header" ).
     2110       run wp-XMLTagOpen( 1, "body", "" ).
     2111   end.
     2112   end procedure.
     2113   procedure bge-xml-write-ref-footer :
     2114   define input parameter p-file-name as character        no-undo.
     2115       define variable v-error-level   as integer      no-undo.
     2116   do
     2117   on error undo, return error
     2118   :
     2119       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2120       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2121       output stream stmXMLOut close.
     2122       run bge/os_copy.p (
     2123             input "M":U
     2124           , input p-file-name + "xm1":U
     2125           , input p-file-name + "xml":U
     2126           , output v-error-level
     2127       ).
     2128       if v-error-level > 0
     2129       then do:
     2130           undo, return error.
     2131       end.
     2132   end.
     2133   end procedure.
     2134   procedure bge-xml-out-dir :
     2135   define output parameter p-out-dir       as character    no-undo.
     2136   define output parameter p-log-file-name as character    no-undo.
     2137   do
     2138   on error undo, return error
     2139   :
     2140       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2141       if p-out-dir = ?
     2142       then do:
     2143           message
     2144             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2145                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2146             skip(1)
     2147             skip "Обратитесь к администратору."
     2148           view-as alert-box error.
     2149           undo, return error .
     2150       end.
     2151       if v-bge-xml-bgeflold <> "oracle" then assign
     2152         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2153       .
     2154       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2155       if error-status :error  then do:
     2156           run wp-XMLWriteLog in this-procedure (
     2157                 input p-log-file-name
     2158               , input 0
     2159               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2160                                   , p-out-dir
     2161                                   , return-value
     2162                                   , trim( error-status :get-message( 1 ) )
     2163                                   )
     2164           ).
     2165           undo, return error.
     2166       end.
     2167       assign
     2168           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2169           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2170       .
     2171   end.
     2172   end procedure.
     2173   procedure bge-xml-out-dir2 :
     2174   define output parameter p-out-dir       as character    no-undo.
     2175   define output parameter p-out-dirR      as character    no-undo.
     2176   define output parameter p-log-file-name as character    no-undo.
     2177   do
     2178   on error undo, return error
     2179   :
     2180       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2181       if p-out-dir = ?
     2182       then do:
     2183           message
     2184             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2185                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2186             skip(1)
     2187             skip "Обратитесь к администратору."
     2188           view-as alert-box error.
     2189           undo, return error .
     2190       end.
     2191       if v-bge-xml-bgeflold <> "oracle" then assign
     2192             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2193             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2194         .
     2195       else p-out-dirR = p-out-dir .
     2196       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2197       if error-status :error  then do:
     2198           run wp-XMLWriteLog in this-procedure (
     2199                 input p-log-file-name
     2200               , input 0
     2201               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2202                                   , p-out-dir
     2203                                   , return-value
     2204                                   , error-status :get-message( 1 )
     2205                                   )
     2206           ).
     2207           undo, return error.
     2208       end.
     2209       if p-out-dirR <> p-out-dir then do:
     2210         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2211         if error-status :error then do:
     2212           run wp-XMLWriteLog in this-procedure (
     2213                 input p-log-file-name
     2214               , input 0
     2215               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2216                                   , p-out-dirR
     2217                                   , return-value
     2218                                   , error-status :get-message( 1 )
     2219                                   )
     2220           ).
     2221           p-out-dirR = p-out-dir .
     2222         end.
     2223       end .
     2224       assign
     2225         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2226         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2227       .
     2228   end.
     2229   end procedure.
     2230   procedure bge-xml-out-file :
     2231   do
     2232   on error undo, return error
     2233   :
     2234   define input parameter p-out-dir            as character        no-undo.
     2235   define input parameter p-prefix             as character        no-undo.
     2236   define input parameter p-sheduled           as logical          no-undo.
     2237   define output parameter p-xml-file-name     as character        no-undo.
     2238   define output parameter p-locked            as logical          no-undo.
     2239   define variable v-home-dir      as character     no-undo.
     2240   define variable v-error-num     as integer       no-undo.
     2241   define variable v-today             as date         no-undo.
     2242   define variable v-time              as integer      no-undo.
     2243       if v-bge-xml-bgefmt = "dbf":U
     2244       then do:
     2245           assign
     2246               p-xml-file-name = p-out-dir
     2247               p-locked        = no
     2248           .
     2249       end.
     2250       else do:
     2251           if v-bge-xml-bgeflold = "firm":U
     2252           then do:
     2253               run bge/genfname.p (
     2254                     input p-out-dir
     2255                   , input p-prefix
     2256                   , input "":U
     2257                   , input "arj":U
     2258                   , input "":U
     2259                   , output p-xml-file-name
     2260               ).
     2261           end.
     2262           else do:
     2263               run bge/genfname.p (
     2264                     input p-out-dir
     2265                   , input p-prefix
     2266                   , input "":U
     2267                   , input "xml":U
     2268                   , input "":U
     2269                   , output p-xml-file-name
     2270               ).
     2271           end.
     2272           assign
     2273               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2274               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2275           .
     2276       end.
     2277   end.
     2278   end procedure.
     2279   procedure bge-xml-init-ext-doc-type :
     2280       define variable v-counter    as integer      no-undo.
     2281       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2282   do
     2283   for buf_temp_ext-doc-type
     2284   on error undo, return error
     2285   :
     2286       empty temp-table buf_temp_ext-doc-type.
     2287       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2288       :
     2289           create buf_temp_ext-doc-type.
     2290           assign
     2291               buf_temp_ext-doc-type.edt-key               = v-counter
     2292               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2293               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2294           .
     2295       end.
     2296   end.
     2297   end procedure.
     2298   procedure bge-xml-get-decimal-shift-num :
     2299   define input parameter p-shift-date     as date             no-undo.
     2300   define input parameter p-shift-num      as integer          no-undo.
     2301   define output parameter p-shift-decimal as decimal          no-undo.
     2302   do
     2303   on error undo, return error
     2304   :
     2305       assign
     2306           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2307       .
     2308   end.
     2309   end procedure.
     2310   procedure bge-xml-ora-exp-filename :
     2311     define input  parameter p-table-name  as character no-undo .
     2312     define input  parameter p-doc-code    as character no-undo .
     2313     define input  parameter p-obj-code    as integer   no-undo .
     2314     define output parameter p-filename    as character no-undo .
     2315     define output parameter p-seq-num     as integer   no-undo .
     2316     define variable v-ora-exp-seq     as integer   no-undo .
     2317     define variable v-ora-exp-seq-str as character no-undo .
     2318     define variable v-home-dir        as character no-undo.
     2319   do
     2320   on error undo, return error return-value
     2321   :
     2322     if v-bge-xml-bgeflold = "oracle":u
     2323     then do:
     2324       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2325       if v-home-dir = ?
     2326       then do:
     2327         undo, return error substitute( "&1&2&3":U
     2328                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2329                                       , chr(10)
     2330                                       , "Обратитесь к администратору.":U
     2331                                       ).
     2332       end.
     2333       assign
     2334           v-home-dir = v-home-dir
     2335       .
     2336       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2337       if error-status :error
     2338       then do:
     2339         undo, return error substitute( "&1&2&3":U
     2340                                       , "Неверно задан каталог экспорта.":U
     2341                                       , chr(10)
     2342                                       , "Обратитесь к администратору.":U
     2343                                       ).
     2344       end.
     2345       assign
     2346         v-ora-exp-seq = ?
     2347       .
     2348       if  p-table-name <> ? and
     2349           p-doc-code <> ?
     2350       then do:
     2351         run bge/get-oesq.p ( input p-table-name
     2352                            , input p-doc-code
     2353                            , output v-ora-exp-seq
     2354                            ) no-error .
     2355         if error-status :error = yes
     2356         then do:
     2357           undo, return error return-value .
     2358         end.
     2359       end.
     2360       if v-ora-exp-seq = ?
     2361       then do:
     2362         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2363         if error-status :error
     2364         then do:
     2365           undo, return error return-value .
     2366         end.
     2367       end.
     2368       if p-table-name <> ? and
     2369          p-doc-code   <> ?
     2370       then do:
     2371         run bge/oesqdoc.p ( input p-table-name
     2372                           , input p-doc-code
     2373                           , input v-ora-exp-seq
     2374                           ) no-error .
     2375         if error-status :error = yes
     2376         then do:
     2377           undo, return error return-value .
     2378         end.
     2379       end.
     2380       assign
     2381         p-seq-num  = v-ora-exp-seq
     2382         p-filename = substitute("&1/&2-000_&3."
     2383                                , v-home-dir
     2384                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2385                                , string(v-ora-exp-seq , "999999999")
     2386                                )
     2387       .
     2388     end.
     2389   end.
     2390   end procedure.
     2391   procedure bge-xml-date-to-str :
     2392     define input  parameter p-date  as date      no-undo .
     2393     define output parameter p-str   as character no-undo .
     2394   do
     2395   on error undo, return error return-value
     2396   :
     2397     if p-date <> ?
     2398     then do:
     2399       assign
     2400         p-str = substitute( "&1-&2-&3"
     2401                           , string( year(p-date)  , "9999")
     2402                           , string( month(p-date) , "99"  )
     2403                           , string( day(p-date)   , "99"  )
     2404                           )
     2405       .
     2406     end.
     2407     else do:
     2408       assign
     2409         p-str = ?
     2410       .
     2411     end.
     2412   end.
     2413   end procedure.
     2414   procedure bge-xml-date-str-to-str :
     2415     define input  parameter p-date-str  as character no-undo .
     2416     define output parameter p-str       as character no-undo .
     2417     define variable v-date          as date      no-undo .
     2418     define variable v-date-valid    as logical   no-undo .
     2419     define variable v-error-message as character no-undo .
     2420   do
     2421   on error undo, return error return-value
     2422   :
     2423     assign
     2424       p-str = ?
     2425     .
     2426     if p-date-str = ? or p-date-str = ""
     2427     then do:
     2428       return .
     2429     end.
     2430     run strtdate in this-procedure ( input  p-date-str
     2431                                    , output v-date
     2432                                    , output v-date-valid
     2433                                    , output v-error-message
     2434                                    ).
     2435     if v-date-valid <> true
     2436     then do:
     2437       return .
     2438     end.
     2439     assign
     2440       p-str = substitute( "&1-&2-&3"
     2441                         , string( year(v-date)  , "9999")
     2442                         , string( month(v-date) , "99"  )
     2443                         , string( day(v-date)   , "99"  )
     2444                         )
     2445     .
     2446   end.
     2447   end procedure.
     2448   procedure bge-xml-fill-tt-bgecliiv :
     2449     define input  parameter p-str as character no-undo .
     2450     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2451     define buffer buf_clients             for ub.clients.
     2452     define variable v-i         as integer   no-undo .
     2453     define variable v-count     as integer   no-undo .
     2454     define variable v-cli-count as integer   no-undo .
     2455     define variable v-client    as character no-undo .
     2456     define variable v-obj-type  as character no-undo .
     2457     define variable v-obj-code  as integer   no-undo .
     2458   do
     2459   on error undo, return error return-value
     2460   :
     2461     empty temp-table buf_tt-bge-xml-bgecliiv.
     2462     assign
     2463       v-bge-xml-bgecliiv = no
     2464       v-cli-count        = num-entries(p-str,';')
     2465     .
     2466     if v-cli-count > 0
     2467     then do:
     2468       _cli-cycle:
     2469       do v-i = 1 to v-cli-count
     2470       :
     2471         assign
     2472           v-client = entry(v-i , p-str, ';')
     2473         .
     2474         if num-entries(v-client) <> 2
     2475         then do:
     2476           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2477         end.
     2478         assign
     2479           v-obj-type = entry(1, v-client)
     2480         .
     2481         assign
     2482           v-obj-code = integer(entry(2, v-client))
     2483         no-error .
     2484         if error-status :error
     2485         then do:
     2486           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2487         end.
     2488         find first buf_clients no-lock
     2489           where buf_clients.obj-type = v-obj-type
     2490             and buf_clients.obj-code = v-obj-code
     2491         no-error.
     2492         if not available buf_clients
     2493         then do:
     2494           next _cli-cycle.
     2495         end.
     2496         find first buf_tt-bge-xml-bgecliiv no-lock
     2497           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2498             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2499         no-error .
     2500         if available buf_tt-bge-xml-bgecliiv
     2501         then do:
     2502           next _cli-cycle.
     2503         end.
     2504         create buf_tt-bge-xml-bgecliiv.
     2505         assign
     2506           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2507           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2508         .
     2509       end.
     2510     end.
     2511     else do:
     2512       assign
     2513         v-bge-xml-bgecliiv = no
     2514       .
     2515       return .
     2516     end.
     2517     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2518     if available buf_tt-bge-xml-bgecliiv
     2519     then do:
     2520       assign
     2521         v-bge-xml-bgecliiv = yes
     2522       .
     2523     end.
     2524   end.
     2525   end procedure.
     2526   procedure bge-xml-resolve-ext-doc-type :
     2527     define input  parameter p-ext-doc-type      as character no-undo .
     2528     define input  parameter p-obj-type          as character no-undo .
     2529     define input  parameter p-obj-code          as integer   no-undo .
     2530     define output parameter p-out-ext-doc-type  as character no-undo .
     2531     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2532   do
     2533   on error undo, return error return-value
     2534   :
     2535     assign
     2536       p-out-ext-doc-type = p-ext-doc-type
     2537     .
     2538     if p-ext-doc-type <> 'ie':U
     2539     then do:
     2540       return .
     2541     end.
     2542     if v-bge-xml-bgecliiv = yes
     2543     then do:
     2544       find first buf_tt-bge-xml-bgecliiv no-lock
     2545         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2546           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2547       no-error .
     2548       if available buf_tt-bge-xml-bgecliiv
     2549       then do:
     2550         assign
     2551           p-out-ext-doc-type = 'iv':U
     2552         .
     2553       end.
     2554     end.
     2555   end.
     2556   end procedure.
     2557   procedure safe-wp-xmltagput :
     2558     define input  parameter pTagLevel   as integer   no-undo .
     2559     define input  parameter pTagName    as character no-undo .
     2560     define input  parameter pParValue   as character no-undo .
     2561     define input  parameter pFlagEmpty  as integer   no-undo .
     2562   do
     2563   on error undo, return error return-value
     2564   :
     2565     if v-bge-xml-bgeflold = "oracle":u
     2566     then do:
     2567       return .
     2568     end.
     2569     run wp-xmltagput in this-procedure ( input pTagLevel
     2570                                        , input pTagName
     2571                                        , input pParValue
     2572                                        , input pFlagEmpty
     2573                                        ).
     2574   end.
     2575   end procedure.
     2576   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2577     define variable v-cntxt-db-num        as integer   no-undo .
     2578     define variable v-cntxt-userid        as character no-undo .
     2579     define variable v-cntxt-level         as character no-undo .
     2580     define variable v-cntxt-host-code-obj as integer   no-undo .
     2581     define variable v-cntxt-obj-type      as character no-undo .
     2582     define variable v-cntxt-obj-code      as integer   no-undo .
     2583     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2584     define variable v-cntxt-is-admin      as logical   no-undo .
     2585   define new global shared variable g#lib-trn  as handle no-undo .
     2586   define new global shared variable g#lib-trn2 as handle no-undo .
     2587   define new global shared variable g#lib-trn3 as handle no-undo .
     2588   define new global shared variable g#lib-trn4 as handle no-undo .
     2589   DEFINE TEMP-TABLE tt-cash-pay NO-UNDO
     2590          FIELD pay-code  LIKE ub.cash-pay.cdpay-code
     2591          FIELD curr-code LIKE ub.cash-pay.curr-code
     2592          INDEX pu AS PRIMARY UNIQUE
     2593                pay-code
     2594                curr-code
     2595   .
     2596   do
     2597   on error undo, return error
     2598   :
     2599       define variable v-xml-file-name     as character    no-undo.
     2600       define variable v-log-file-name     as character    no-undo.
     2601       define variable v-locked            as logical      no-undo.
     2602       define variable v-date-from         as date         no-undo.
     2603       define variable v-date-to           as date         no-undo.
     2604       define variable v-obj-list          as character    no-undo.
     2605       define variable v-pay-type-list     as character    no-undo.
     2606       define variable v-gds-type          as character    no-undo.
     2607       define variable v-obj-counter       as integer      no-undo.
     2608       define variable v-range             as integer      no-undo.
     2609       define variable v-void-logical      as logical      no-undo.
     2610       define variable v-void-character    as character    no-undo.
     2611       define variable v-cancel            as logical      no-undo.
     2612       define variable v-host-code         as integer      no-undo.
     2613       DEFINE VARIABLE v-pay-type-counter  AS INTEGER      NO-UNDO.
     2614       DEFINE VARIABLE v-need-pay-type     AS LOGICAL      NO-UNDO.
     2615       DEFINE BUFFER   buf_cash-pay        FOR ub.cash-pay.
     2616   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2617     run mainmenu_getcntxt in p-mainmenu-handle
     2618       (output v-cntxt-db-num
     2619       ,output v-cntxt-userid
     2620       ,output v-cntxt-level
     2621       ,output v-cntxt-host-code-obj
     2622       ,output v-cntxt-obj-type
     2623       ,output v-cntxt-obj-code
     2624       ,output v-cntxt-db-num-obj
     2625       ,output v-cntxt-is-admin
     2626       ) .
     2627       run bge/bge-dper-gds.w (
     2628             input p-mainmenu-handle
     2629           , input 6
     2630           , input ""
     2631           , output v-date-from
     2632           , output v-date-to
     2633           , output v-range
     2634           , output v-host-code
     2635           , output v-obj-list
     2636           , OUTPUT v-pay-type-list
     2637           , OUTPUT v-gds-type
     2638           , output v-void-character
     2639           , output v-void-logical
     2640           , output v-void-logical
     2641           , output v-void-logical
     2642           , output v-void-logical
     2643           , output v-void-logical
     2644           , output v-void-logical
     2645           , output v-void-logical
     2646           , output v-void-logical
     2647           , output v-cancel
     2648       ).
     2649       if v-cancel = yes
     2650       then do:
     2651           undo, return.
     2652       end.
     2653       IF v-pay-type-list <> "" THEN
     2654       DO v-pay-type-counter = 1 TO NUM-ENTRIES( v-pay-type-list ):
     2655          FIND FIRST buf_cash-pay
     2656               WHERE RECID(buf_cash-pay) = INTEGER(ENTRY( v-pay-type-counter, v-pay-type-list ))
     2657               NO-LOCK
     2658               NO-ERROR.
     2659          IF NOT AVAILABLE buf_cash-pay
     2660          OR CAN-FIND(FIRST tt-cash-pay WHERE tt-cash-pay.pay-code  = buf_cash-pay.cdpay-code
     2661                                          AND tt-cash-pay.curr-code = buf_cash-pay.curr-code
     2662                                        NO-LOCK )
     2663          THEN NEXT.
     2664          CREATE tt-cash-pay.
     2665          ASSIGN
     2666             tt-cash-pay.pay-code  = buf_cash-pay.cdpay-code
     2667             tt-cash-pay.curr-code = buf_cash-pay.curr-code
     2668          .
     2669          RELEASE tt-cash-pay.
     2670          RELEASE buf_cash-pay.
     2671       END.
     2672       IF CAN-FIND(FIRST tt-cash-pay NO-LOCK) THEN ASSIGN
     2673           v-need-pay-type = TRUE
     2674       .
     2675   if session :set-wait-state( "compiler" ) then.
     2676       case v-range:
     2677       when 1
     2678       then do:
     2679           run init-temphost.
     2680       end.
     2681       when 2
     2682       then do:
     2683           run init-temphost.
     2684           for each temp-obj
     2685              where temp-obj.host-code <> v-host-code
     2686           :
     2687               delete temp-obj.
     2688           end.
     2689       end.
     2690       when 3
     2691       then do:
     2692           for each temp-obj
     2693           :
     2694               delete temp-obj.
     2695           end.
     2696           do v-obj-counter = 1 to num-entries ( v-obj-list ) / 2
     2697           :
     2698               create temp-obj.
     2699               assign
     2700                   temp-obj.obj-type = entry( v-obj-counter * 2 - 1, v-obj-list )
     2701                   temp-obj.obj-code = integer( entry( v-obj-counter * 2, v-obj-list ) )
     2702               no-error .
     2703               if error-status :error
     2704               then do:
     2705                   run wp-XMLWriteLog in this-procedure (
     2706                       input v-log-file-name
     2707                       , input 1
     2708                       , input substitute( "*** Ошибка чтения списка объектов. &1. &2. &3. &4."
     2709                                           , return-value
     2710                                           , trim(error-status :get-message(1))
     2711                                           , trim(error-status :get-message(2))
     2712                                           , trim(error-status :get-message(3))
     2713                                       )
     2714                   ).
     2715                   undo, return error .
     2716               end.
     2717   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2718   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2719     (input  temp-obj.obj-type
     2720     ,input  temp-obj.obj-code
     2721     ,output temp-obj.host-code
     2722     ) no-error .
     2723               if error-status :error
     2724               then do:
     2725                   run wp-XMLWriteLog in this-procedure (
     2726                       input v-log-file-name
     2727                       , input 1
     2728                       , input substitute( "*** Не найдена фирма для объекта &1 &2. &3. &4. &5. &6."
     2729                                           , temp-obj.obj-type
     2730                                           , temp-obj.obj-code
     2731                                           , return-value
     2732                                           , trim(error-status :get-message(1))
     2733                                           , trim(error-status :get-message(2))
     2734                                           , trim(error-status :get-message(3))
     2735                                       )
     2736                   ).
     2737                   undo, return error .
     2738               end.
     2739           end.
     2740       end.
     2741       end case.
     2742       assign
     2743           v-bge-xml-bgeflold = "new":U
     2744       .
     2745       run xml-bge-filename in this-procedure (
     2746             input "d":U
     2747           , input "":U
     2748           , input no
     2749           , output v-xml-file-name
     2750           , output v-log-file-name
     2751           , output v-locked
     2752       ).
     2753       run wp-XMLWriteLog in this-procedure (
     2754             input v-log-file-name
     2755           , input 1
     2756           , input "&DLine"
     2757       ).
     2758       run wp-XMLWriteLog in this-procedure (
     2759             input v-log-file-name
     2760           , input 1
     2761           , input substitute( "Начало выгрузки чеков в файл &1"
     2762                                   , replace( v-xml-file-name, "/", "\" ) + "xm1"
     2763                             )
     2764       ).
     2765       run wp-XMLWriteLog in this-procedure (
     2766             input v-log-file-name
     2767           , input 1
     2768           , input substitute( "................с параметрами: Дата с: &1, дата по: &2"
     2769                                   , v-date-from
     2770                                   , v-date-to
     2771                             )
     2772       ).
     2773       run wp-XMLWriteLog in this-procedure (
     2774             input v-log-file-name
     2775           , input 1
     2776           , input substitute( "................с параметрами: ... список объектов: &1", v-obj-list )
     2777       ).
     2778       if v-locked = yes
     2779       then do:
     2780           run wp-XMLWriteLog in this-procedure (
     2781                 input v-log-file-name
     2782               , input 1
     2783               , input "*** Ошибка выгрузки: Файл выгрузки заблокирован другим процессом."
     2784           ).
     2785           undo, return error .
     2786       end.
     2787       run bge-xml-write-header in this-procedure (
     2788             input v-xml-file-name
     2789           , input "check"
     2790           , input "12.2 " + replace( vss-revision + vss-date, "$", " " )
     2791           , input 0
     2792           , input v-date-from
     2793           , input 0
     2794           , input v-date-to
     2795           , input 0
     2796           , input v-obj-list
     2797           , input "":U
     2798           , input no
     2799           , input no
     2800           , input no
     2801           , input no
     2802           , input no
     2803           , input no
     2804           , input no
     2805           , input no
     2806       ) no-error.
     2807       if error-status :error
     2808       then do:
     2809           run wp-XMLWriteLog in this-procedure (
     2810                 input v-log-file-name
     2811               , input 1
     2812               , input substitute( "*** Ошибка записи шапки файла. Процедура: &1 (v.&2 &3). &4. &5"
     2813                                   , vss-workfile
     2814                                   , vss-revision
     2815                                   , vss-description
     2816                                   , return-value
     2817                                   , trim( error-status :get-message( 1 ) )
     2818                                   )
     2819           ).
     2820           undo, return error.
     2821       end.
     2822       for each temp-obj no-lock
     2823       on error undo, return error
     2824       :
     2825           run export-checks-by-object in this-procedure (
     2826                 input temp-obj.obj-type
     2827               , input temp-obj.obj-code
     2828               , input v-xml-file-name
     2829               , input v-log-file-name
     2830               , input v-date-from
     2831               , input v-date-to
     2832               , input v-pay-type-list
     2833               , INPUT v-need-pay-type
     2834           ) no-error.
     2835           if error-status :error
     2836           then do:
     2837               run wp-XMLWriteLog in this-procedure (
     2838                     input v-log-file-name
     2839                   , input 1
     2840                   , input substitute( "*** Ошибка выгрузки чеков по объекту &1 &2. &3. &4. &5."
     2841                                       , temp-obj.obj-type
     2842                                       , temp-obj.obj-code
     2843                                       , return-value
     2844                                       , trim(error-status :get-message(1))
     2845                                       , trim(error-status :get-message(2))
     2846                                       , trim(error-status :get-message(3))
     2847                                     )
     2848               ).
     2849           end.
     2850           run rep/rpychk0.p (input "r-shftc2"
     2851                           ,input temp-obj.obj-type
     2852                           ,input temp-obj.obj-code
     2853                           ,input ?
     2854                           ,input ?
     2855                           ,input v-date-from
     2856                           ,input v-date-to
     2857                           ,input 1
     2858                           ,input 99
     2859                           ,input ?
     2860                           ) no-error.
     2861           if error-status:error then
     2862           do:
     2863                message error-status:get-message(1) view-as alert-box.
     2864           end.
     2865       end.
     2866       run xml-bge-write-footer in this-procedure (
     2867           input v-xml-file-name
     2868       ).
     2869       run wp-XMLWriteLog in this-procedure (
     2870             input v-log-file-name
     2871           , input 1
     2872           , input substitute( "Данные выгружены в файл &1"
     2873                                   , replace( v-xml-file-name, "/", "\" ) + "xml"
     2874                             )
     2875       ).
     2876       run wp-XMLWriteLog in this-procedure (
     2877             input v-log-file-name
     2878           , input 1
     2879           , input "&DLine"
     2880       ).
     2881   if session :set-wait-state( "" ) then.
     2882   end.
     2883   procedure export-checks-by-object :
     2884   do
     2885   on error undo, return error
     2886   :
     2887   define input parameter p-obj-type       as character    no-undo.
     2888   define input parameter p-obj-code       as integer      no-undo.
     2889   define input parameter p-xml-file-name  as character    no-undo.
     2890   define input parameter p-log-file-name as character    no-undo.
     2891   define input parameter p-date-from      as date         no-undo.
     2892   define input parameter p-date-to        as date         no-undo.
     2893   define input parameter p-pay-type-list  as character    no-undo.
     2894   define input parameter p-need-pay-type  as logical      no-undo.
     2895       define variable v-gds-code      as integer      no-undo.
     2896       define variable v-artic         as character    no-undo.
     2897       define variable v-prod-type     as character    no-undo.
     2898       define variable v-prod-code     as integer      no-undo.
     2899       define variable v-gds-name      as character    no-undo.
     2900       define variable v-pay-name      as character    no-undo.
     2901       define variable v-curr-abbr     as character    no-undo.
     2902       define variable conf-attr     as character      no-undo.
     2903       define variable conf-par      as character      no-undo.
     2904       define variable par-type      as character      no-undo.
     2905       define variable dflt-cd         as character    no-undo.
     2906       define variable v-finded-pay-type   as logical no-undo.
     2907       define variable v-host-code     as integer      no-undo.
     2908       define variable v-d-card        as character    no-undo.
     2909       define variable v-par-type      as character    no-undo.
     2910       define variable v-param-type      as character  no-undo .
     2911       define variable v-value-character as character  no-undo .
     2912       define variable v-value-date      as date       no-undo .
     2913       define variable v-value-decimal   as decimal    no-undo .
     2914       define variable v-value-integer   as integer    no-undo .
     2915       define variable v-value-logical   as logical    no-undo .
     2916       define variable v-tth             as handle      no-undo .
     2917       define variable v-trim-zero       as logical   no-undo .
     2918       define variable v-is-petrol     as logical      no-undo.
     2919       define variable v-is-pieces     as logical      no-undo.
     2920       define variable v-is-found      as logical      no-undo.
     2921       define variable v-cpline        as integer      no-undo.
     2922       define variable v-pay-code      as integer      no-undo.
     2923       define variable v-eff-doc-qnty  as decimal      no-undo.
     2924       define variable v-pay-card      as character    no-undo.
     2925       define variable v-price-base    as decimal      no-undo.
     2926       define variable v-tot-r-b       as decimal      no-undo.
     2927       define variable v-discnt        as decimal      no-undo.
     2928       define buffer buf_chk-doc       for ub.chk-doc.
     2929       define buffer buf_chk-gds       for ub.chk-gds.
     2930       define buffer buf_bar-code      for ub.bar-code.
     2931       define buffer buf_goods         for ub.goods.
     2932       define buffer buf_chk-pay       for ub.chk-pay.
     2933       define buffer buf_cash-pay      for ub.cash-pay.
     2934       define buffer buf_currency      for ub.currency.
     2935       define buffer buf_chk-gds-pay   for ub.chk-gds-pay.
     2936   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2937   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2938     (input  p-obj-type
     2939     ,input  p-obj-code
     2940     ,output v-host-code
     2941     )  .
     2942       run adm/shattri.p ( input "get":U
     2943                         , input  '':u
     2944                         , input  0
     2945                         , input  'bge-export':U
     2946                         , input  'bgedcard':U
     2947                         , output v-value-character
     2948                         , output v-value-date
     2949                         , output v-value-decimal
     2950                         , output v-value-integer
     2951                         , output v-trim-zero
     2952                         , output v-param-type
     2953                         , input-output table-handle v-tth
     2954                         ) no-error .
     2955       if error-status :error
     2956       then do:
     2957         assign
     2958           v-trim-zero = no
     2959         .
     2960       end.
     2961       delete object v-tth.
     2962   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2963   define variable v-param-type9 as character no-undo .
     2964   define variable v-value-date9 as date no-undo .
     2965   define variable v-value-decimal9 as decimal no-undo .
     2966   define variable v-value-integer9 as INTEGER no-undo .
     2967   define variable v-value-logical9 AS LOGICAL no-undo .
     2968   define variable v-tth9 as handle no-undo .
     2969   run adm/shattri.p (
     2970       input "get":U
     2971       ,input  p-obj-type
     2972       ,input  p-obj-code
     2973       ,input  'cd-sending':U
     2974       ,input  'dflt-cd':U
     2975       ,output dflt-cd
     2976       ,output v-value-date9
     2977       ,output v-value-decimal9
     2978       ,output v-value-integer9
     2979       ,output v-value-logical9
     2980       ,output v-param-type9
     2981       ,INPUT-OUTPUT table-handle v-tth9
     2982       )  .
     2983   delete object v-tth9 no-error.
     2984       output stream stmxmlout to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     2985       for each buf_chk-doc no-lock
     2986          where buf_chk-doc.obj-type = p-obj-type
     2987            and buf_chk-doc.obj-code = p-obj-code
     2988            and buf_chk-doc.chk-date >= p-date-from
     2989            and buf_chk-doc.chk-date <= p-date-to
     2990            on error undo, return error
     2991       :
     2992           if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next.
     2993           IF p-need-pay-type THEN
     2994           _search-pay-type:
     2995           DO:
     2996             ASSIGN
     2997                v-finded-pay-type = FALSE
     2998             .
     2999             FOR EACH buf_chk-pay WHERE buf_chk-pay.doc-code = buf_chk-doc.doc-code
     3000                                NO-LOCK
     3001                                :
     3002               IF CAN-FIND(FIRST tt-cash-pay WHERE tt-cash-pay.pay-code  = buf_chk-pay.pay-code
     3003                                               AND tt-cash-pay.curr-code = buf_chk-pay.curr-code
     3004                                             NO-LOCK )
     3005               THEN DO:
     3006                    ASSIGN
     3007                       v-finded-pay-type = TRUE
     3008                    .
     3009                    LEAVE _search-pay-type.
     3010               END.
     3011             END.
     3012           END.
     3013           IF      p-need-pay-type
     3014           AND NOT v-finded-pay-type THEN NEXT.
     3015           if not v-gds-type = "all" then do:
     3016               assign v-is-found = false .
     3017               for each buf_chk-gds no-lock
     3018               where buf_chk-gds.doc-code = buf_chk-doc.doc-code :
     3019                   find first buf_bar-code no-lock
     3020                   where buf_bar-code.b-code = buf_chk-gds.b-code
     3021                   no-error.
     3022                   if available buf_bar-code then do:
     3023                       find first buf_goods no-lock
     3024                       where buf_goods.gds-code = buf_bar-code.gds-code
     3025                       no-error.
     3026                       if available buf_goods then do:
     3027   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     3028     (
     3029        input buf_goods.artic
     3030     ,  input buf_goods.prod-type
     3031     ,  input buf_goods.prod-code
     3032     , output v-is-petrol
     3033     , output v-is-pieces
     3034     ) no-error.
     3035                           if not error-status :error then do:
     3036                               assign v-is-found = true .
     3037                           end.
     3038                       end.
     3039                   end.
     3040               end.
     3041               if v-is-found then do:
     3042                   if v-gds-type = "fuel" and not v-is-petrol then next.
     3043                   if v-gds-type = "other" and v-is-petrol then next.
     3044               end.
     3045           end.
     3046           assign
     3047               v-d-card = buf_chk-doc.d-card
     3048           .
     3049           if v-trim-zero = yes
     3050           then do:
     3051               assign
     3052                   v-d-card = left-trim( v-d-card, "0":U )
     3053               .
     3054           end.
     3055           run wp-xmltagopen in this-procedure ( input 2, input "checkHead", input "" ).
     3056           run wp-xmltagput in this-procedure ( input 3, input "ID"        , input string( buf_chk-doc.doc-code    ), input 0 ).
     3057           run wp-xmltagput in this-procedure ( input 3, input "objType"   , input string( buf_chk-doc.obj-type    ), input 0 ).
     3058           run wp-xmltagput in this-procedure ( input 3, input "objCode"   , input string( buf_chk-doc.obj-code    ), input 0 ).
     3059           run wp-xmltagput in this-procedure ( input 3, input "date"      , input string( buf_chk-doc.chk-date, "99/99/9999" ), input 0 ).
     3060           run wp-xmltagput in this-procedure ( input 3, input "time"      , input string( buf_chk-doc.chk-time, "HH:MM:SS" ), input 0 ).
     3061           run wp-xmltagput in this-procedure ( input 3, input "checkNum"  , input string( buf_chk-doc.chk-num     ), input 0 ).
     3062           run wp-xmltagput in this-procedure ( input 3, input "deskNum"   , input string( buf_chk-doc.pay-desk    ), input 0 ).
     3063           run wp-xmltagput in this-procedure ( input 3, input "cardNum"   , input string( v-d-card                ), input 0 ).
     3064           run wp-xmltagclose in this-procedure ( input 2, input "checkHead").
     3065           for each buf_chk-gds no-lock
     3066              where buf_chk-gds.doc-code = buf_chk-doc.doc-code
     3067           on error undo, return error
     3068           :
     3069               find first buf_bar-code no-lock
     3070                    where buf_bar-code.b-code = buf_chk-gds.b-code
     3071               no-error.
     3072               if available buf_bar-code
     3073               then do:
     3074                   find first buf_goods no-lock
     3075                        where buf_goods.gds-code = buf_bar-code.gds-code
     3076                   .
     3077                   if available buf_goods
     3078                   then do:
     3079                       assign
     3080                           v-gds-code  = buf_goods.gds-code
     3081                           v-artic     = buf_goods.artic
     3082                           v-prod-type = buf_goods.prod-type
     3083                           v-prod-code = buf_goods.prod-code
     3084                           v-gds-name  = buf_goods.gds-name
     3085                       .
     3086                   end.
     3087                   else do:
     3088                       run wp-XMLWriteLog in this-procedure (
     3089                             input p-log-file-name
     3090                           , input 1
     3091                           , input substitute( "*** Не найден товар для бар-кода по чеку &1. Объект &2 &3. Бар-код &4. Код товара &5."
     3092                                               , buf_chk-gds.doc-code
     3093                                               , temp-obj.obj-type
     3094                                               , temp-obj.obj-code
     3095                                               , buf_chk-gds.b-code
     3096                                               , buf_bar-code.gds-code
     3097                                              )
     3098                       ).
     3099                   end.
     3100               end.
     3101               else do:
     3102                   run wp-XMLWriteLog in this-procedure (
     3103                         input p-log-file-name
     3104                       , input 1
     3105                       , input substitute( "*** Не найден бар-код для чека &1. Объект &2 &3. Бар-код &4."
     3106                                           , buf_chk-gds.doc-code
     3107                                           , temp-obj.obj-type
     3108                                           , temp-obj.obj-code
     3109                                           , buf_chk-gds.b-code
     3110                                          )
     3111                   ).
     3112               end.
     3113               run wp-xmltagopen in this-procedure ( input 2, input "checkBody", input "" ).
     3114               run wp-xmltagput in this-procedure ( input 3, input "ID"        , input string( buf_chk-gds.doc-code    ), input 0 ).
     3115               run wp-xmltagput in this-procedure ( input 3, input "bcode"     , input string( buf_chk-gds.b-code      ), input 0 ).
     3116               run wp-xmltagput in this-procedure ( input 3, input "gdsCode"   , input string( v-gds-code              ), input 0 ).
     3117               run wp-xmltagput in this-procedure ( input 3, input "artic"     , input string( v-artic                 ), input 0 ).
     3118               run wp-xmltagput in this-procedure ( input 3, input "prodType"  , input string( v-prod-type             ), input 0 ).
     3119               run wp-xmltagput in this-procedure ( input 3, input "prodCode"  , input string( v-prod-code             ), input 0 ).
     3120               run wp-xmltagput in this-procedure ( input 3, input "gdsName"   , input string( v-gds-name              ), input 0 ).
     3121               run wp-xmltagput in this-procedure ( input 3, input "price"     , input string( buf_chk-gds.price-base  ), input 0 ).
     3122               run wp-xmltagput in this-procedure ( input 3, input "qnty"      , input string( buf_chk-gds.doc-qnty    ), input 0 ).
     3123               run wp-xmltagput in this-procedure ( input 3, input "discnt"    , input string( buf_chk-gds.discnt      ), input 0 ).
     3124               for each buf_chk-gds-pay no-lock
     3125                    where buf_chk-gds-pay.doc-code = buf_chk-gds.doc-code and
     3126                    buf_chk-gds-pay.line-num = buf_chk-gds.line-num:
     3127                       assign
     3128                           v-cpline = buf_chk-gds-pay.cpline-num
     3129                           v-pay-code = buf_chk-gds-pay.pay-code
     3130                           v-eff-doc-qnty = buf_chk-gds-pay.eff-doc-qnty
     3131                           v-pay-card = buf_chk-gds-pay.pay-card
     3132                           v-price-base = buf_chk-gds-pay.price-base
     3133                           v-tot-r-b = buf_chk-gds-pay.tot-r-b
     3134                           v-discnt = buf_chk-gds-pay.discnt
     3135                       .
     3136                   run wp-xmltagopen in this-procedure ( input 3, input "checkBodyPay", input "" ).
     3137                     run wp-xmltagput in this-procedure ( input 4, input "cpLine"       , input string( v-cpline             ), input 0 ).
     3138                     run wp-xmltagput in this-procedure ( input 4, input "payCode"      , input string( v-pay-code           ), input 0 ).
     3139                     run wp-xmltagput in this-procedure ( input 4, input "totrb"        , input string( v-tot-r-b            ), input 0 ).
     3140                     run wp-xmltagput in this-procedure ( input 4, input "pricebase"    , input string( v-price-base         ), input 0 ).
     3141                     run wp-xmltagput in this-procedure ( input 4, input "numpaycard"   , input string( v-pay-card           ), input 0 ).
     3142                     run wp-xmltagput in this-procedure ( input 4, input "discnt"       , input string( v-discnt             ), input 0 ).
     3143                     run wp-xmltagput in this-procedure ( input 4, input "effdocqnty"   , input string( v-eff-doc-qnty       ), input 0 ).
     3144                   run wp-xmltagclose in this-procedure ( input 3, input "checkBodyPay" ).
     3145               end.
     3146               run wp-xmltagclose in this-procedure ( input 2, input "checkBody" ).
     3147           end.
     3148           for each buf_chk-pay no-lock
     3149              where buf_chk-pay.doc-code = buf_chk-doc.doc-code
     3150           on error undo, return error
     3151           :
     3152               find first buf_cash-pay no-lock
     3153                    where buf_cash-pay.cdpay-code  = buf_chk-pay.pay-code
     3154                      AND buf_cash-pay.curr-code   = buf_chk-pay.curr-code
     3155               no-error.
     3156               if available buf_cash-pay
     3157               then do:
     3158                   assign
     3159                   v-pay-name = buf_cash-pay.obj-name
     3160                   .
     3161                   find first buf_currency no-lock
     3162                        where buf_currency.curr-code = buf_chk-pay.curr-code
     3163                   .
     3164                   if available buf_currency
     3165                   then do:
     3166                       assign
     3167                           v-curr-abbr  = buf_currency.curr-abbr
     3168                       .
     3169                   end.
     3170                   else do:
     3171                       run wp-XMLWriteLog in this-procedure (
     3172                             input p-log-file-name
     3173                           , input 1
     3174                           , input substitute( "*** Не найдена валюта для платежа по чеку &1. Объект &2 &3. Платеж &4. Код валюты &5."
     3175                                               , buf_chk-pay.doc-code
     3176                                               , temp-obj.obj-type
     3177                                               , temp-obj.obj-code
     3178                                               , buf_chk-pay.pay-code
     3179                                               , buf_chk-pay.curr-code
     3180                                              )
     3181                       ).
     3182                   end.
     3183               end.
     3184               else do:
     3185                   run wp-XMLWriteLog in this-procedure (
     3186                         input p-log-file-name
     3187                       , input 1
     3188                       , input substitute( "*** Не найден платеж для чека &1. Объект &2 &3. Платеж &4. Код валюты &5"
     3189                                           , buf_chk-pay.doc-code
     3190                                           , temp-obj.obj-type
     3191                                           , temp-obj.obj-code
     3192                                           , buf_chk-pay.pay-code
     3193                                           , buf_chk-pay.curr-code
     3194                                          )
     3195                   ).
     3196               end.
     3197               run wp-xmltagopen in this-procedure ( input 2, input "checkPays", input "" ).
     3198               run wp-xmltagput in this-procedure ( input 3, input "ID"        , input string( buf_chk-pay.doc-code    ), input 0 ).
     3199               run wp-xmltagput in this-procedure ( input 3, input "payCode"   , input string( buf_chk-pay.pay-code    ), input 0 ).
     3200               run wp-xmltagput in this-procedure ( input 3, input "currCode"  , input string( buf_chk-pay.curr-code   ), input 0 ).
     3201               run wp-xmltagput in this-procedure ( input 3, input "payName"   , input string( v-pay-name              ), input 0 ).
     3202               run wp-xmltagput in this-procedure ( input 3, input "currAbbr"  , input string( v-curr-abbr             ), input 0 ).
     3203               run wp-xmltagput in this-procedure ( input 3, input "totSum"    , input string( buf_chk-pay.tot-sum     ), input 0 ).
     3204               run wp-xmltagput in this-procedure ( input 3, input "totBase"   , input string( buf_chk-pay.tot-base    ), input 0 ).
     3205               run wp-xmltagput in this-procedure ( input 3, input "totRubl"   , input string( buf_chk-pay.tot-rubl    ), input 0 ).
     3206               run wp-xmltagput in this-procedure ( input 3, input "payCard"   , input string( buf_chk-pay.pay-card    ), input 0 ).
     3207               run wp-xmltagput in this-procedure ( input 3, input "cashRate"  , input string( buf_chk-pay.cash-rate   ), input 0 ).
     3208               run wp-xmltagclose in this-procedure ( input 2, input "checkPays" ).
     3209         end.
     3210       end.
     3211       output stream stmxmlout close.
     3212   end.
     3213   end procedure.
