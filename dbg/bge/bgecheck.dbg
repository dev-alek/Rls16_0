     1011       index pi is primary unique
     1012           doc-code
     1013   .
     1014   define temp-table temp_del-doc-code no-undo
     1015       field doc-code as character
     1016       index pi is primary unique
     1017           doc-code
     1018   .
     1019   define temp-table temp_pr-doc-num no-undo
     1020       field doc-num as character
     1021       index pi is primary unique
     1022           doc-num
     1023   .
     1024   define temp-table temp_fin-doc-code no-undo
     1025       field host-code as integer
     1026       field fin-doc-code as integer
     1027       index pi is primary unique
     1028           host-code
     1029           fin-doc-code
     1030   .
     1031   define temp-table temp_del-fin-doc-code no-undo
     1032       field host-code as integer
     1033       field fin-doc-code as integer
     1034       field corr-user-db-num as integer
     1035       field chip-num as integer
     1036       index pi is primary unique
     1037           host-code
     1038           fin-doc-code
     1039           corr-user-db-num
     1040           chip-num
     1041   .
     1042   define temp-table temp_fin-ob no-undo
     1043       field host-code as integer
     1044       field fin-doc-code as character
     1045       index pi is primary unique
     1046           host-code
     1047           fin-doc-code
     1048   .
     1049   define temp-table temp_del-fin-ob no-undo
     1050       field host-code as integer
     1051       field fin-doc-code as character
     1052       field corr-user-db-num as integer
     1053       field chip-num as integer
     1054       index pi is primary unique
     1055           host-code
     1056           fin-doc-code
     1057           corr-user-db-num
     1058           chip-num
     1059   .
     1060   define temp-table temp_ord-doc-code no-undo
