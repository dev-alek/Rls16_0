      653                       then do:
      654                           assign
      655                               p-out-string = p-out-string + " ":U
      656                           .
      657                       end.
      658                       when chr(13)
      659                       then do:
      660                           assign
      661                               p-out-string = p-out-string + " ":U
      662                           .
      663                       end.
      664                       otherwise do:
      665                           assign
      666                               p-out-string = p-out-string + v-current-char
      667                           .
      668                       end.
      669                   end case.
      670               end.
      671           end.
      672       end case.
      673   end.
      674   end .
      675   procedure xmlchar-decode :
      676   define input parameter p-in-string      as character        no-undo.
      677   define output parameter p-out-string    as character        no-undo.
      678       define variable v-position      as integer      no-undo.
      679       define variable v-last-position as integer      no-undo.
      680       define variable v-temp-integer  as integer      no-undo.
      681       define variable v-current-char  as character    no-undo.
      682       define variable v-next-char     as character    no-undo.
      683       define variable v-success       as logical      no-undo.
      684   do
      685   on error undo, return error
      686   :
      687       assign
      688           p-out-string = "":U
      689           v-position   = 0
      690       .
      691       replace-cycle:
      692       do while yes
      693       on error undo, return error
      694       :
      695           assign
      696               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      697           .
      698           if v-last-position <= v-position
      699           then do:
      700               if v-position = 0
      701               then do:
      702                   assign
      703                       p-out-string = p-in-string
      704                   .
      705               end.
      706               else do:
      707                   assign
      708                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      709                   .
      710               end.
      711               leave replace-cycle.
      712           end.
      713           else do:
      714               assign
      715                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      716                   v-position      = v-last-position
      717                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      718               .
      719               if v-current-char = "#":U
      720               then do:
      721                   assign
      722                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      723                   .
      724                   if v-last-position > 0
      725                   then do:
      726                       run xmlchar-read-integer in this-procedure
      727                        (
      728                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      729                           , output v-temp-integer
      730                           , output v-success
      731                       ).
      732                       if v-success = yes
      733                       and v-temp-integer >= 1
      734                       and v-temp-integer <= 255
      735                       then do:
      736                           assign
      737                               p-out-string = p-out-string + chr( v-temp-integer )
      738                               v-position   = v-last-position + 1
      739                           .
      740                       end.
      741                       else do:
      742                           assign
      743                               p-out-string = p-out-string + "&":U
      744                               v-position   = v-position   + 1
      745                           .
      746                       end.
      747                   end.
      748                   else do:
      749                       assign
      750                           p-out-string = p-out-string + "&":U
      751                           v-position   = v-position   + 1
      752                       .
      753                   end.
      754               end.
      755               else do:
      756                   case substring( p-in-string, v-position + 1, 3 )
      757                   :
      758                       when "lt;":U
      759                       then do:
      760                           assign
      761                               p-out-string = p-out-string + "<":U
      762                               v-position   = v-position   + 3
      763                           .
      764                       end.
      765                       when "gt;":U
      766                       then do:
      767                           assign
      768                               p-out-string = p-out-string + ">":U
      769                               v-position   = v-position   + 3
      770                           .
      771                       end.
      772                       otherwise do:
      773                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      774                           then do:
      775                               assign
      776                                   p-out-string = p-out-string + "&":U
      777                                   v-position   = v-position   + 4
      778                               .
      779                           end.
      780                           else do:
      781                               case substring( p-in-string, v-position + 1, 5 )
      782                               :
      783                                   when "quot;":U
      784                                   then do:
      785                                       assign
      786                                           p-out-string = p-out-string + '"':U
      787                                           v-position   = v-position   + 5
      788                                       .
      789                                   end.
      790                                   when "apos;":U
      791                                   then do:
      792                                       assign
      793                                           p-out-string = p-out-string + "'":U
      794                                           v-position   = v-position   + 5
      795                                       .
      796                                   end.
      797                                   otherwise do:
      798                                       assign
      799                                           p-out-string = p-out-string + "&":U
      800                                       .
      801                                   end.
      802                               end case.
      803                           end.
      804                       end.
      805                   end case.
      806               end.
      807           end.
      808       end.
      809   end.
      810   end .
      811   procedure xmlchar-read-integer :
      812   define input parameter p-input-string      as character        no-undo.
      813   define output parameter p-output-integer   as integer          no-undo.
      814   define output parameter p-success       as logical          no-undo.
      815   do
      816   on error undo, return error
      817   :
      818       assign
      819           p-output-integer = integer( p-input-string )
      820       no-error.
      821       if error-status :error
      822       then do:
      823           assign
      824               p-success           = no
      825               p-output-integer    = 0
      826           .
      827       end.
      828       else do:
      829           assign
      830               p-success           = yes
      831           .
      832       end.
      833   end.
      834   end.
      835   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      836   procedure strtdate :
      837     define input  parameter p-str         as character no-undo .
      838     define output parameter p-value       as date      no-undo .
      839     define output parameter p-data-valid  as logical   no-undo .
      840     define output parameter p-message     as character no-undo .
      841   do
      842   on error undo, return error return-value
      843   :
      844     define variable v-value       as date      no-undo .
      845     define variable v-i           as integer   no-undo .
      846     define variable v-num         as integer   no-undo .
      847     define variable v-delim       as character no-undo .
      848     define variable v-delim-list  as character no-undo .
      849     define variable v-day         as integer   no-undo .
      850     define variable v-month       as integer   no-undo .
      851     define variable v-year        as integer   no-undo .
      852     define variable v-day-str     as character no-undo .
      853     define variable v-month-str   as character no-undo .
      854     define variable v-year-str    as character no-undo .
      855     assign
      856       p-value       = ?
      857       p-data-valid  = false
      858     .
      859     if p-str = ?
      860     then do:
      861       assign
      862         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      863       .
      864       return .
      865     end.
      866     if p-str = ""
      867     then do:
      868       assign
      869         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      870       .
      871       return .
      872     end.
      873     if length(p-str)  > 10
      874     then do:
      875       assign
      876         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      877       .
      878       return .
      879     end.
      880     assign
      881       v-delim-list = '/,-,.':U
      882     .
      883     _delim:
      884     do v-i = 1 to num-entries( v-delim-list )
      885     :
      886       assign
      887         v-delim = entry( v-i , v-delim-list )
      888         v-num   = num-entries( p-str , v-delim )
      889       .
      890       if v-num <> 3
      891       then do:
      892         assign
      893           v-delim = ''
      894         .
      895       end.
      896       else do:
      897         leave _delim.
      898       end.
      899     end.
      900     if v-delim = ''
      901     then do:
      902       assign
      903         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      904       .
      905       return .
      906     end.
      907     assign
      908       v-day-str   = entry( 1, p-str , v-delim)
      909       v-month-str = entry( 2, p-str , v-delim)
      910       v-year-str  = entry( 3, p-str , v-delim)
      911     .
      912     if  length(v-day-str) > 2   or
      913         length(v-day-str) < 1   or
      914         length(v-month-str) > 2 or
      915         length(v-month-str) < 1 or
      916         (
      917           length(v-year-str) <> 2 and
      918           length(v-year-str) <> 4
      919         )
      920     then do:
      921       assign
      922         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      923       .
      924       return .
      925     end.
      926     if length( v-year-str ) = 2
      927     then do:
      928       assign
      929         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      930       .
      931     end.
      932     assign
      933       v-day   = integer( v-day-str )
      934       v-month = integer( v-month-str)
      935       v-year  = integer( v-year-str)
      936     no-error .
      937     if error-status :error
      938     then do:
      939       assign
      940         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      941       .
      942       return .
      943     end.
      944     if v-day < 1  or
      945        v-day > 31 or
      946        v-month < 1 or
      947        v-month > 12 or
      948        v-year < 0   or
      949        v-year > 5000
      950     then do:
      951       assign
      952         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      953       .
      954       return .
      955     end.
      956     assign
      957       v-value = date( v-month, v-day, v-year )
      958     no-error .
      959     if error-status :error
      960     then do:
      961       assign
      962         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      963       .
      964       return .
      965     end.
      966     assign
      967       p-value       = v-value
      968       p-data-valid  = true
      969     .
      970   end.
      971   end procedure.
      972   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      973   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
      974   define variable v-bge-xml-bgedict       as logical  init no  no-undo.
      975   define variable v-bge-xml-bgeflold      as character         no-undo.
      976   define variable v-bge-xml-bgefmt        as character         no-undo.
      977   define variable v-bge-xml-shift-mode    as logical           no-undo.
      978   define variable v-bge-xml-bgeflnm-doc   as character         no-undo.
      979   define variable v-bge-xml-bgeflnm-day   as character         no-undo.
      980   define variable v-bge-xml-log-file-name as character    no-undo.
      981   define variable v-bge-xml-dbf-file-name as character    no-undo.
      982   define variable v-bge-xml-db-num-str    as character    no-undo .
      983   define variable v-bge-xml-static-log-file-name as character    no-undo.
      984   define temp-table temp_ext-doc-type no-undo
