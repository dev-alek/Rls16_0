        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision: 684ed89e110d, 160, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        5   define variable vss-date        as character no-undo init "$Date: Mon Mar 23 18:05:33 2015 +0400 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: bgecheck.p $":U .
        7   define variable vss-archive     as character no-undo init "$Archive: bge/bgecheck.p $":U .
        8   define variable vss-description as character no-undo init "Экспорт чеков".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define  temp-table temp-host no-undo
       80     field host-code like ub.store.host-code
       81     index xpk host-code
       82   .
       83   define  temp-table temp-obj no-undo
       84     field obj-type  like ub.clients.obj-type
       85     field obj-code  like ub.clients.obj-code
       86     field host-code like ub.store.host-code
       87     field db-num    like ub.clients.db-num
       88     index xpk  obj-type obj-code
       89     index xie1 host-code
       90     index xie2 db-num host-code
       91   .
       92   procedure init-temphost:
       93     define buffer buf_store   for ub.store .
       94     define buffer buf_shop    for ub.shop .
       95     define buffer buf_clients for ub.clients .
       96     define buffer buf_db for ub.db .
       97     define buffer buf_temp-host for temp-host .
       98     define buffer buf_temp-obj for temp-obj .
       99     do
      100     on error undo, return error return-value
      101     :
      102       for each buf_store
      103       on error undo, return error
      104       :
      105         find first buf_temp-host
      106           where buf_temp-host.host-code = buf_store.host-code
      107           no-error .
      108         if not available buf_temp-host
      109         then do:
      110           create buf_temp-host .
      111           assign
      112             buf_temp-host.host-code = buf_store.host-code
      113           .
      114         end.
      115         find first buf_clients no-lock
      116           where buf_clients.obj-type = 'скл':U
      117             and buf_clients.obj-code = buf_store.obj-code
      118           no-error .
      119         if not available buf_clients
      120         then do:
      121           message
      122             "Ошибка при поиске клиента" skip
      123             "Клиент" 'скл':U buf_store.obj-code skip
      124             view-as alert-box error .
      125           undo, return error .
      126         end.
      127         create buf_temp-obj .
      128         assign
      129           buf_temp-obj.obj-type  = 'скл':U
      130           buf_temp-obj.obj-code  = buf_store.obj-code
      131           buf_temp-obj.host-code = buf_store.host-code
      132           buf_temp-obj.db-num    = buf_clients.db-num
      133         .
      134       end.
      135       for each buf_shop
      136       on error undo, return error
      137       :
      138         find first buf_temp-host
      139           where buf_temp-host.host-code = buf_shop.host-code
      140           no-error .
      141         if not available buf_temp-host
      142         then do:
      143           create buf_temp-host .
      144           assign
      145             buf_temp-host.host-code = buf_shop.host-code
      146           .
      147         end.
      148         find first buf_clients no-lock
      149           where buf_clients.obj-type = 'маг':U
      150             and buf_clients.obj-code = buf_shop.obj-code
      151           no-error .
      152         if not available buf_clients then do:
      153           message
      154             "Ошибка при поиске клиента" skip
      155             "Клиент" 'маг':U buf_shop.obj-code skip
      156             view-as alert-box error .
      157           undo, return error .
      158         end.
      159         create buf_temp-obj .
      160         assign
      161           buf_temp-obj.obj-type  = 'маг':U
      162           buf_temp-obj.obj-code  = buf_shop.obj-code
      163           buf_temp-obj.host-code = buf_shop.host-code
      164           buf_temp-obj.db-num    = buf_clients.db-num
      165         .
      166       end.
      167     end.
      168   end.
      169   define variable vss-include-info1 as character format "X(65)" no-undo
      170   initial "@(#)$Workfile$ $Revision$".
      171   DEF STREAM stmXMLOut.
      172   DEF STREAM stmXMLLog.
      173   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      174   procedure cur-time :
      175      define output parameter p-today as date      no-undo .
      176      define output parameter p-time  as integer   no-undo .
      177     do
      178     on error undo, return error
      179     :
      180       define variable v-date1 as date      no-undo .
      181       define variable v-date2 as date      no-undo .
      182       define variable v-time  as integer   no-undo .
      183       assign
      184         v-date1 = today
      185         v-time  = time
      186         v-date2 = today
      187       .
      188       if v-date1 <> v-date2
      189       then do:
      190         assign
      191           v-date1 = today
      192           v-time  = v-time
      193         .
      194       end.
      195       assign
      196         p-today = v-date1
      197         p-time  = v-time
      198       .
      199     end.
      200   end.
      201   function cur-time-date returns character
      202   :
      203     return string(today, '99/99/9999':U) .
      204   end.
      205   function cur-time-mjd returns decimal
      206   :
      207     define variable v-date as date      no-undo .
      208     define variable v-time as integer   no-undo .
      209     run cur-time in this-procedure
      210       (output v-date
      211       ,output v-time
      212       ) .
      213     return integer(v-date) - 2400002 + (v-time / 86400) .
      214   end.
      215   function cur-time-get-ending-index returns integer
      216   (input p-number as integer
      217   )
      218   :
      219     if p-number < 0
      220     or p-number = ?
      221     then do:
      222       return 1 .
      223     end.
      224     define variable v-rest as integer   no-undo .
      225     assign
      226       p-number = p-number modulo 100
      227     .
      228     if p-number < 20
      229     then do:
      230       assign
      231         v-rest = p-number
      232       .
      233     end.
      234     else do:
      235       assign
      236         v-rest = p-number modulo 10
      237       .
      238     end.
      239     case v-rest :
      240       when 1
      241       then do:
      242         return 2 .
      243       end.
      244       when 2 or
      245       when 3 or
      246       when 4
      247       then do:
      248         return 3 .
      249       end.
      250       otherwise do:
      251         return 1 .
      252       end.
      253     end case .
      254   end.
      255   procedure cur-time-mjd-to-date :
      256      define input  parameter i-mjd-diff as decimal no-undo.
      257      define output parameter o-Date     as date    no-undo.
      258      define output parameter o-Time     as integer no-undo.
      259      define variable v-day-number as integer   no-undo .
      260      if    i-mjd-diff < 0
      261         or i-mjd-diff = ?
      262      then do:
      263         return "?" .
      264      end.
      265      assign
      266         v-day-number = truncate(i-mjd-diff,0).
      267         o-Date = date(v-day-number + 2400002).
      268         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      269     .
      270   end.
      271   function cur-time-mjd-to-string returns character
      272   (input p-mjd-diff as decimal
      273   )
      274   :
      275     define variable v-day-number as integer   no-undo .
      276     define variable v-seconds    as integer   no-undo .
      277     define variable v-hour       as integer   no-undo .
      278     define variable v-min        as integer   no-undo .
      279     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      280     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      281     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      282     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      283     if p-mjd-diff < 0
      284     or p-mjd-diff = ?
      285     then do:
      286       return "?" .
      287     end.
      288     assign
      289       v-day-number = integer(truncate(p-mjd-diff,0))
      290       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      291     .
      292     if v-seconds > 86400
      293     then do:
      294       assign
      295         v-seconds = 86400 - 1
      296       .
      297     end.
      298     if v-seconds < 0
      299     then do:
      300       assign
      301         v-seconds = 0
      302       .
      303     end.
      304     assign
      305       v-hour = truncate(v-seconds / 3600, 0)
      306     .
      307     assign
      308       v-seconds = v-seconds modulo 3600
      309     .
      310     assign
      311       v-min = truncate(v-seconds / 60, 0)
      312     .
      313     assign
      314       v-seconds = v-seconds modulo 60
      315     .
      316     return
      317         (if v-day-number <> 0
      318           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      319           else ""
      320         )
      321       + (if v-day-number <> 0 or v-hour <> 0
      322           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      323           else ""
      324         )
      325       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      326           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      327           else ""
      328         )
      329       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      330       .
      331   end.
      332   function cur-time-string returns character
      333   :
      334     define variable v-date as date      no-undo .
      335     define variable v-time as integer   no-undo .
      336     run cur-time in this-procedure
      337       (output v-date
      338       ,output v-time
      339       ) .
      340     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      341   end.
      342   function cur-time-string-sec returns character
      343   :
      344     define variable v-date as date      no-undo .
      345     define variable v-time as integer   no-undo .
      346     run cur-time in this-procedure
      347       (output v-date
      348       ,output v-time
      349       ) .
      350     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      351   end.
      352   function cur-time-custom  returns character
      353   (input p-prefix as character
      354   ,input p-date-format as character
      355   ,input p-delimiter as character
      356   ,input p-time-format as character
      357   ,input p-suffix as character
      358   )
      359   :
      360     define variable v-date as date      no-undo .
      361     define variable v-time as integer   no-undo .
      362     run cur-time in this-procedure
      363       (output v-date
      364       ,output v-time
      365       ) .
      366     return
      367       p-prefix
      368       + string(v-date, p-date-format)
      369       + p-delimiter
      370       + string(v-time, p-time-format)
      371       + p-suffix
      372       .
      373   end.
      374   function cur-time-print  returns character
      375   :
      376     define variable v-date as date      no-undo .
      377     define variable v-time as integer   no-undo .
      378     run cur-time in this-procedure
      379       (output v-date
      380       ,output v-time
      381       ) .
      382     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      383   end.
      384   function cur-time-datetime returns datetime
      385   :
      386     define variable v-char as character no-undo .
      387     define variable v-datetime as datetime no-undo .
      388     v-char = cur-time-string().
      389     v-datetime = datetime(v-char).
      390     return  v-datetime.
      391   end.
      392   function cur-time-string-msec returns character
      393   :
      394     define variable v-date as datetime  no-undo .
      395     v-date = now.
      396     return string(v-date) .
      397   end.
      398   define variable vss-include-info3 as character format "X(65)" no-undo
      399   initial "@(#)$Workfile$ $Revision$".
      400   procedure xmlchar-test :
      401   define input parameter p-in-string          as character        no-undo.
      402   define output parameter p-out-string-enc    as character        no-undo.
      403   define output parameter p-out-string-dec    as character        no-undo.
      404   do
      405   on error undo, return error
      406   :
      407          run xmlchar-encode in this-procedure
      408       (
      409             input p-in-string
      410           , output p-out-string-enc
      411       ).
      412          run xmlchar-decode in this-procedure
      413       (
      414             input p-out-string-enc
      415           , output p-out-string-dec
      416       ).
      417   end.
      418   end .
      419   procedure xmlchar-encode :
      420   define input parameter p-in-string      as character        no-undo.
      421   define output parameter p-out-string    as character        no-undo.
      422       define variable v-position      as integer      no-undo.
      423       define variable v-current-char  as character    no-undo.
      424   do
      425   on error undo, return error
      426   :
      427       assign
      428           p-out-string = "":U
      429       .
      430       case p-in-string
      431       :
      432           when ?
      433           then do:
      434               assign
      435                   p-out-string = "?":U
      436               .
      437           end.
      438           when "?":U
      439           then do:
      440               assign
      441                   p-out-string = "&#63;":U
      442               .
      443           end.
      444           otherwise do:
      445               do v-position = 1 to length( p-in-string )
      446               :
      447                   assign
      448                       v-current-char = substring( p-in-string, v-position, 1 )
      449                   .
      450                   case v-current-char
      451                   :
      452                       when "&":U
      453                       then do:
      454                           assign
      455                               p-out-string = p-out-string + "&amp;":U
      456                           .
      457                       end.
      458                       when ">":U
      459                       then do:
      460                           assign
      461                               p-out-string = p-out-string + "&gt;":U
      462                           .
      463                       end.
      464                       when "<":U
      465                       then do:
      466                           assign
      467                               p-out-string = p-out-string + "&lt;":U
      468                           .
      469                       end.
      470                       when "'":U
      471                       then do:
      472                           assign
      473                               p-out-string = p-out-string + "&apos;":U
      474                           .
      475                       end.
      476                       when '"':U
      477                       then do:
      478                           assign
      479                               p-out-string = p-out-string + "&quot;":U
      480                           .
      481                       end.
      482                       when chr(1)
      483                       then do:
      484                           assign
      485                               p-out-string = p-out-string + "":U
      486                           .
      487                       end.
      488                       when chr(2)
      489                       then do:
      490                           assign
      491                               p-out-string = p-out-string + "":U
      492                           .
      493                       end.
      494                       when chr(3)
      495                       then do:
      496                           assign
      497                               p-out-string = p-out-string + "":U
      498                           .
      499                       end.
      500                       when chr(4)
      501                       then do:
      502                           assign
      503                               p-out-string = p-out-string + "":U
      504                           .
      505                       end.
      506                       when chr(5)
      507                       then do:
      508                           assign
      509                               p-out-string = p-out-string + "":U
      510                           .
      511                       end.
      512                       when chr(6)
      513                       then do:
      514                           assign
      515                               p-out-string = p-out-string + "":U
      516                           .
      517                       end.
      518                       when chr(7)
      519                       then do:
      520                           assign
      521                               p-out-string = p-out-string + "":U
      522                           .
      523                       end.
      524                       when chr(8)
      525                       then do:
      526                           assign
      527                               p-out-string = p-out-string + "":U
      528                           .
      529                       end.
      530                       when chr(9)
      531                       then do:
      532                           assign
      533                               p-out-string = p-out-string + "":U
      534                           .
      535                       end.
      536                       when chr(29)
      537                       then do:
      538                           assign
      539                               p-out-string = p-out-string + "":U
      540                           .
      541                       end.
      542                       when chr(10)
      543                       then do:
      544                           assign
      545                               p-out-string = p-out-string + "&#10;":U
      546                           .
      547                       end.
      548                       when chr(13)
      549                       then do:
      550                           assign
      551                               p-out-string = p-out-string + "&#13;":U
      552                           .
      553                       end.
      554                       otherwise do:
      555                           assign
      556                               p-out-string = p-out-string + v-current-char
      557                           .
      558                       end.
      559                   end case.
      560               end.
      561           end.
      562       end case.
      563   end.
      564   end .
      565   procedure xmlchar-encode-1c :
      566   define input parameter p-in-string      as character        no-undo.
      567   define output parameter p-out-string    as character        no-undo.
      568       define variable v-position      as integer      no-undo.
      569       define variable v-current-char  as character    no-undo.
      570   do
      571   on error undo, return error
      572   :
      573       assign
      574           p-out-string = "":U
