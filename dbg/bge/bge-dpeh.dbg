        1   define input parameter parparentproc        as handle               no-undo.
        2   define input parameter p-output-type        as integer              no-undo.
        3   define input parameter p-init-doc-type-list as character            no-undo.
        4   define output parameter date_exp_from       as date      INIT ?     no-undo.
        5   define output parameter p-shift-num-from    as integer              no-undo.
        6   define output parameter date_exp_to         as date      INIT ?     no-undo.
        7   define output parameter p-shift-num-to      as integer              no-undo.
        8   define output parameter p-shift-on          as logical              no-undo.
        9   define output parameter p-range             as integer              no-undo.
       10   define output parameter p-host-code         as integer              no-undo.
       11   define output parameter p-obj-list          as character            no-undo.
       12   define output parameter p-doc-type-list     as character            no-undo.
       13   define output parameter p-pay-code          as logical   INIT no    no-undo.
       14   define output parameter p-cst               as logical   INIT no    no-undo.
       15   define output parameter p-parts             as logical   INIT no    no-undo.
       16   define output parameter p-chk-pay-code      as logical   INIT no    no-undo.
       17   define output parameter p-pay-desk          as logical   INIT no    no-undo.
       18   define output parameter p-pay-desk-cards    as logical   INIT no    no-undo.
       19   define output parameter p-deleted           as logical   INIT no    no-undo.
       20   define output parameter p-chk               as logical   INIT no    no-undo.
       21   define output parameter p-doc-rvs           as logical   INIT no    no-undo.
       22   define output parameter p-cancel            as logical   INIT no    no-undo.
       23   define variable vss-revision    as character no-undo init "$Revision$":U .
       24   define variable vss-author      as character no-undo init "$Author$":U .
       25   define variable vss-date        as character no-undo init "$Date$":U .
       26   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       27   define variable vss-archive     as character no-undo init "$Archive$":U .
       28   define variable vss-description as character no-undo init "Выбор параметров для выгрузки документов по сменам.".
       29   procedure vss-get-info :
       30     define output parameter p-vss-revision    like vss-revision    no-undo .
       31     define output parameter p-vss-author      like vss-author      no-undo .
       32     define output parameter p-vss-date        like vss-date        no-undo .
       33     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       34     define output parameter p-vss-archive     like vss-archive     no-undo .
       35     define output parameter p-vss-description like vss-description no-undo .
       36     assign
       37       p-vss-revision    = vss-revision
       38       p-vss-author      = vss-author
       39       p-vss-date        = vss-date
       40       p-vss-workfile    = vss-workfile
       41       p-vss-archive     = vss-archive
       42       p-vss-description = vss-description
       43     .
       44   end procedure.
       45   procedure vss-get-parameters :
       46     define output parameter p-vss-parameters as character no-undo .
       47   end procedure.
       48   define new global shared variable g#vssrevis-logger as handle    no-undo .
       49   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       50   define variable v-vssrevis-logger                   as handle    no-undo .
       51   procedure vss-logevent :
       52     define input  parameter p-extra-paramters as character no-undo .
       53     define variable v-vssrevis-parameters as character no-undo .
       54     do
       55     on error undo, return error return-value
       56     :
       57       if  valid-handle(v-vssrevis-logger)
       58       and v-vssrevis-logger :get-signature("logevent") <> ""
       59       then do:
       60         run vss-get-parameters in this-procedure
       61           (output v-vssrevis-parameters
       62           ).
       63         run logevent in v-vssrevis-logger
       64           (input vss-workfile
       65           ,input vss-revision
       66           ,input v-vssrevis-parameters
       67           ,input p-extra-paramters
       68           ).
       69       end.
       70     end.
       71   end procedure.
       72   assign
       73     v-vssrevis-logger = g#vssrevis-logger
       74   .
       75   if  valid-handle(v-vssrevis-logger)
       76   and v-vssrevis-logger :get-signature("logevent") <> ""
       77   then do:
       78     assign
       79       v-vssrevis-logevent = true
       80     .
       81     run vss-logevent in this-procedure (input vss-description) .
       82   end.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define new global shared variable g#library  as handle no-undo .
       88   define new global shared variable g#library2 as handle no-undo .
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   procedure cur-time :
       91      define output parameter p-today as date      no-undo .
       92      define output parameter p-time  as integer   no-undo .
       93     do
       94     on error undo, return error
       95     :
       96       define variable v-date1 as date      no-undo .
       97       define variable v-date2 as date      no-undo .
       98       define variable v-time  as integer   no-undo .
       99       assign
      100         v-date1 = today
      101         v-time  = time
      102         v-date2 = today
      103       .
      104       if v-date1 <> v-date2
      105       then do:
      106         assign
      107           v-date1 = today
      108           v-time  = v-time
      109         .
      110       end.
      111       assign
      112         p-today = v-date1
      113         p-time  = v-time
      114       .
      115     end.
      116   end.
      117   function cur-time-date returns character
      118   :
      119     return string(today, '99/99/9999':U) .
      120   end.
      121   function cur-time-mjd returns decimal
      122   :
      123     define variable v-date as date      no-undo .
      124     define variable v-time as integer   no-undo .
      125     run cur-time in this-procedure
      126       (output v-date
      127       ,output v-time
      128       ) .
      129     return integer(v-date) - 2400002 + (v-time / 86400) .
      130   end.
      131   function cur-time-get-ending-index returns integer
      132   (input p-number as integer
      133   )
      134   :
      135     if p-number < 0
      136     or p-number = ?
      137     then do:
      138       return 1 .
      139     end.
      140     define variable v-rest as integer   no-undo .
      141     assign
      142       p-number = p-number modulo 100
      143     .
      144     if p-number < 20
      145     then do:
      146       assign
      147         v-rest = p-number
      148       .
      149     end.
      150     else do:
      151       assign
      152         v-rest = p-number modulo 10
      153       .
      154     end.
      155     case v-rest :
      156       when 1
      157       then do:
      158         return 2 .
      159       end.
      160       when 2 or
      161       when 3 or
      162       when 4
      163       then do:
      164         return 3 .
      165       end.
      166       otherwise do:
      167         return 1 .
      168       end.
      169     end case .
      170   end.
      171   procedure cur-time-mjd-to-date :
      172      define input  parameter i-mjd-diff as decimal no-undo.
      173      define output parameter o-Date     as date    no-undo.
      174      define output parameter o-Time     as integer no-undo.
      175      define variable v-day-number as integer   no-undo .
      176      if    i-mjd-diff < 0
      177         or i-mjd-diff = ?
      178      then do:
      179         return "?" .
      180      end.
      181      assign
      182         v-day-number = truncate(i-mjd-diff,0).
      183         o-Date = date(v-day-number + 2400002).
      184         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      185     .
      186   end.
      187   function cur-time-mjd-to-string returns character
      188   (input p-mjd-diff as decimal
      189   )
      190   :
      191     define variable v-day-number as integer   no-undo .
      192     define variable v-seconds    as integer   no-undo .
      193     define variable v-hour       as integer   no-undo .
      194     define variable v-min        as integer   no-undo .
      195     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      196     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      197     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      198     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      199     if p-mjd-diff < 0
      200     or p-mjd-diff = ?
      201     then do:
      202       return "?" .
      203     end.
      204     assign
      205       v-day-number = integer(truncate(p-mjd-diff,0))
      206       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      207     .
      208     if v-seconds > 86400
      209     then do:
      210       assign
      211         v-seconds = 86400 - 1
      212       .
      213     end.
      214     if v-seconds < 0
      215     then do:
      216       assign
      217         v-seconds = 0
      218       .
      219     end.
      220     assign
      221       v-hour = truncate(v-seconds / 3600, 0)
      222     .
      223     assign
      224       v-seconds = v-seconds modulo 3600
      225     .
      226     assign
      227       v-min = truncate(v-seconds / 60, 0)
      228     .
      229     assign
      230       v-seconds = v-seconds modulo 60
      231     .
      232     return
      233         (if v-day-number <> 0
      234           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      235           else ""
      236         )
      237       + (if v-day-number <> 0 or v-hour <> 0
      238           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      239           else ""
      240         )
      241       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      242           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      243           else ""
      244         )
      245       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      246       .
      247   end.
      248   function cur-time-string returns character
      249   :
      250     define variable v-date as date      no-undo .
      251     define variable v-time as integer   no-undo .
      252     run cur-time in this-procedure
      253       (output v-date
      254       ,output v-time
      255       ) .
      256     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      257   end.
      258   function cur-time-string-sec returns character
      259   :
      260     define variable v-date as date      no-undo .
      261     define variable v-time as integer   no-undo .
      262     run cur-time in this-procedure
      263       (output v-date
      264       ,output v-time
      265       ) .
      266     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      267   end.
      268   function cur-time-custom  returns character
      269   (input p-prefix as character
      270   ,input p-date-format as character
      271   ,input p-delimiter as character
      272   ,input p-time-format as character
      273   ,input p-suffix as character
      274   )
      275   :
      276     define variable v-date as date      no-undo .
      277     define variable v-time as integer   no-undo .
      278     run cur-time in this-procedure
      279       (output v-date
      280       ,output v-time
      281       ) .
      282     return
      283       p-prefix
      284       + string(v-date, p-date-format)
      285       + p-delimiter
      286       + string(v-time, p-time-format)
      287       + p-suffix
      288       .
      289   end.
      290   function cur-time-print  returns character
      291   :
      292     define variable v-date as date      no-undo .
      293     define variable v-time as integer   no-undo .
      294     run cur-time in this-procedure
      295       (output v-date
      296       ,output v-time
      297       ) .
      298     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      299   end.
      300   function cur-time-datetime returns datetime
      301   :
      302     define variable v-char as character no-undo .
      303     define variable v-datetime as datetime no-undo .
      304     v-char = cur-time-string().
      305     v-datetime = datetime(v-char).
      306     return  v-datetime.
      307   end.
      308   function cur-time-string-msec returns character
      309   :
      310     define variable v-date as datetime  no-undo .
      311     v-date = now.
      312     return string(v-date) .
      313   end.
      314   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      315   define  temp-table temp-host no-undo
      316     field host-code like ub.store.host-code
      317     index xpk host-code
      318   .
      319   define  temp-table temp-obj no-undo
      320     field obj-type  like ub.clients.obj-type
      321     field obj-code  like ub.clients.obj-code
      322     field host-code like ub.store.host-code
      323     field db-num    like ub.clients.db-num
      324     index xpk  obj-type obj-code
      325     index xie1 host-code
      326     index xie2 db-num host-code
      327   .
      328   procedure init-temphost:
      329     define buffer buf_store   for ub.store .
      330     define buffer buf_shop    for ub.shop .
      331     define buffer buf_clients for ub.clients .
      332     define buffer buf_db for ub.db .
      333     define buffer buf_temp-host for temp-host .
      334     define buffer buf_temp-obj for temp-obj .
      335     do
      336     on error undo, return error return-value
      337     :
      338       for each buf_store
      339       on error undo, return error
      340       :
      341         find first buf_temp-host
      342           where buf_temp-host.host-code = buf_store.host-code
      343           no-error .
      344         if not available buf_temp-host
      345         then do:
      346           create buf_temp-host .
      347           assign
      348             buf_temp-host.host-code = buf_store.host-code
      349           .
      350         end.
      351         find first buf_clients no-lock
      352           where buf_clients.obj-type = 'скл':U
      353             and buf_clients.obj-code = buf_store.obj-code
      354           no-error .
      355         if not available buf_clients
      356         then do:
      357           message
      358             "Ошибка при поиске клиента" skip
      359             "Клиент" 'скл':U buf_store.obj-code skip
      360             view-as alert-box error .
      361           undo, return error .
      362         end.
      363         create buf_temp-obj .
      364         assign
      365           buf_temp-obj.obj-type  = 'скл':U
      366           buf_temp-obj.obj-code  = buf_store.obj-code
      367           buf_temp-obj.host-code = buf_store.host-code
      368           buf_temp-obj.db-num    = buf_clients.db-num
      369         .
      370       end.
      371       for each buf_shop
      372       on error undo, return error
      373       :
      374         find first buf_temp-host
      375           where buf_temp-host.host-code = buf_shop.host-code
      376           no-error .
      377         if not available buf_temp-host
      378         then do:
      379           create buf_temp-host .
      380           assign
      381             buf_temp-host.host-code = buf_shop.host-code
      382           .
      383         end.
      384         find first buf_clients no-lock
      385           where buf_clients.obj-type = 'маг':U
      386             and buf_clients.obj-code = buf_shop.obj-code
      387           no-error .
      388         if not available buf_clients then do:
      389           message
      390             "Ошибка при поиске клиента" skip
      391             "Клиент" 'маг':U buf_shop.obj-code skip
      392             view-as alert-box error .
      393           undo, return error .
      394         end.
      395         create buf_temp-obj .
      396         assign
      397           buf_temp-obj.obj-type  = 'маг':U
      398           buf_temp-obj.obj-code  = buf_shop.obj-code
      399           buf_temp-obj.host-code = buf_shop.host-code
      400           buf_temp-obj.db-num    = buf_clients.db-num
      401         .
      402       end.
      403     end.
      404   end.
      405   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      406     define variable v-cntxt-db-num        as integer   no-undo .
      407     define variable v-cntxt-userid        as character no-undo .
      408     define variable v-cntxt-level         as character no-undo .
      409     define variable v-cntxt-host-code-obj as integer   no-undo .
      410     define variable v-cntxt-obj-type      as character no-undo .
      411     define variable v-cntxt-obj-code      as integer   no-undo .
      412     define variable v-cntxt-db-num-obj    as integer   no-undo .
      413     define variable v-cntxt-is-admin      as logical   no-undo .
      414   procedure proc-alt-shift-f2:
      415     if not ibs.th.gbl.gbl-var:rcode
      416   then
      417     run gbl\inidebug.p .
      418   end.
      419   procedure proc-alt-shift-f3:
      420     run gbl/prvssinf.p
      421       ( input this-procedure
      422       ) .
      423   end.
      424   define variable v-inform-launched as logical no-undo initial false .
      425   procedure proc-alt-shift-f4:
      426     define variable v-action as character no-undo .
      427     if v-inform-launched = false then do:
      428       assign
      429         v-inform-launched = true
      430       .
      431       run gbl/d-inform.w
      432         (  input self
      433         ,  input this-procedure
      434         , output v-action
      435         ) no-error .
      436       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      437       assign
      438         v-inform-launched = false
      439       .
      440     end.
      441   end.
      442   procedure proc-alt-f1:
      443     run gbl/corrhelp.p
      444       (input this-procedure
      445       ) .
      446   end .
      447   on alt-shift-f2 anywhere do:
      448     run proc-alt-shift-f2.
      449   end.
      450   on alt-shift-f3 anywhere do:
      451     run proc-alt-shift-f3 in this-procedure .
      452   end.
      453   on alt-shift-f4 anywhere do:
      454     run proc-alt-shift-f4 in this-procedure.
      455   end.
      456   on alt-f1 anywhere do:
      457     run proc-alt-f1 in this-procedure .
      458   end.
      459   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      460   define temp-table userobjs_temp-user-obj no-undo
      461     field obj-type as character
      462     field obj-code as integer
      463     index xpk is primary unique obj-type obj-code
      464     .
      465   procedure userobjs_clear :
      466     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      467     do
      468     on error undo, return error return-value
      469     :
      470       for each buf_userobjs_temp-user-obj
      471       on error undo, return error return-value
      472       :
      473         delete buf_userobjs_temp-user-obj .
      474       end.
      475     end.
      476   end .
      477   procedure userobjs_object-count :
      478     define output parameter p-total-count as integer   no-undo .
      479     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      480     do
      481     on error undo, return error return-value
      482     :
      483       assign
      484         p-total-count = 0
      485       .
      486       for each buf_userobjs_temp-user-obj
      487       on error undo, return error return-value
