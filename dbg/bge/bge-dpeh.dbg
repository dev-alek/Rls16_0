     1521     .
     1522     if valid-handle (v-label-handle10)
     1523     then do:
     1524       if v-label-handle10 :tooltip = ""
     1525       or v-label-handle10 :tooltip = ?
     1526       then do:
     1527         assign
     1528           v-label-handle10 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1529         .
     1530       end.
     1531     end.
     1532     ON CHOOSE OF MENU-ITEM m-ed-date10-1 in menu m-ed-date10 DO:
     1533       apply "ctrl-b":U to date_from in frame Dialog-Frame .
     1534     END.
     1535     ON CHOOSE OF MENU-ITEM m-ed-date10-2 in menu m-ed-date10 DO:
     1536       apply "ctrl-d":U to date_from in frame Dialog-Frame .
     1537     END.
     1538     ON CHOOSE OF MENU-ITEM m-ed-date10-3 in menu m-ed-date10 DO:
     1539       apply "ctrl-e":U to date_from in frame Dialog-Frame .
     1540     END.
     1541     ON CHOOSE OF MENU-ITEM m-ed-date10-4 in menu m-ed-date10 DO:
     1542       apply "ctrl-f":U to date_from in frame Dialog-Frame .
     1543     END.
