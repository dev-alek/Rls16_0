      495   procedure userobjs_append :
      496      define input  parameter p-obj-type as character no-undo .
      497      define input  parameter p-obj-code as integer   no-undo .
      498     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      499     do
      500     on error undo, return error return-value
      501     :
      502       find first buf_userobjs_temp-user-obj
      503         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      504           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      505         no-error .
      506       if not available buf_userobjs_temp-user-obj
      507       then do:
      508         create buf_userobjs_temp-user-obj .
      509         assign
      510           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      511           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      512         .
      513       end.
      514     end.
      515   end.
      516   procedure userobjs_object-exist :
      517     define output parameter p-object-exist as logical   no-undo .
      518     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      519     do
      520     on error undo, return error return-value
      521     :
      522       find first buf_userobjs_temp-user-obj
      523         no-error .
      524       if not available buf_userobjs_temp-user-obj
      525       then do:
      526         assign
      527           p-object-exist = false
      528         .
      529       end.
      530       else do:
      531         assign
      532           p-object-exist = true
      533         .
      534       end.
      535     end.
      536   end.
      537   procedure userobjs_transfer :
      538     define input  parameter p-callback-handle as handle no-undo .
      539     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      540     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      541     do
      542     on error undo, return error return-value
      543     :
      544       if valid-handle(p-callback-handle) <> true
      545       then do:
      546         message
      547           vss-workfile vss-revision vss-description skip
      548           "Ошибка задания входных параметров" skip
      549           "Неизвестный указатель на процедуру" skip
      550           view-as alert-box error .
      551         undo, return error return-value .
      552       end.
      553       if p-callback-handle :get-signature("userobjs_append") = ""
      554       then do:
      555         message
      556           vss-workfile vss-revision vss-description skip
      557           "Ошибка задания входных параметров" skip
      558           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      559                     ,p-callback-handle :file-name
      560                     ) skip
      561           view-as alert-box error .
      562         undo, return error return-value .
      563       end.
      564       for each buf_userobjs_temp-user-obj
      565       on error undo, return error return-value
      566       :
      567         run userobjs_append in p-callback-handle
      568           (input  buf_userobjs_temp-user-obj.obj-type
      569           ,input  buf_userobjs_temp-user-obj.obj-code
      570           ) .
      571       end.
      572     end.
      573   end procedure.
      574   procedure userobjs_select-one :
      575      define input  parameter parparentproc     as widget-handle no-undo .
      576      define input  parameter p-db-num          as integer   no-undo .
      577      define input  parameter p-user-id         as character no-undo .
      578      define input  parameter p-host-code-obj   as integer   no-undo .
      579      define input  parameter p-obj-type        as character no-undo .
      580      define input  parameter p-obj-code        as integer   no-undo .
      581      define output parameter p-user-select     as logical   no-undo .
      582      define output parameter p-select-obj-type as character no-undo .
      583      define output parameter p-select-obj-code as character no-undo .
      584     do
      585     on error undo, return error return-value
      586     :
      587       run gbl/userobjs.w
      588         (input  parparentproc
      589         ,input  this-procedure :handle
      590         ,input  p-db-num
      591         ,input  p-user-id
      592         ,input  p-host-code-obj
      593         ,input  p-obj-type
      594         ,input  p-obj-code
      595         ,INPUT  "b-sel"
      596         ,output p-user-select
      597         ,output p-select-obj-type
      598         ,output p-select-obj-code
      599         ) .
      600     end.
      601   end.
      602   procedure userobjs_select-many :
      603     define input  parameter parparentproc   as widget-handle no-undo .
      604     define input  parameter p-db-num        as integer   no-undo .
      605     define input  parameter p-user-id       as character no-undo .
      606     define input  parameter p-host-code-obj as integer   no-undo .
      607     define input  parameter p-obj-type      as character no-undo .
      608     define input  parameter p-obj-code      as integer   no-undo .
      609     define output parameter p-user-select   as logical   no-undo .
      610     define variable v-select-obj-type as character no-undo .
      611     define variable v-select-obj-code as integer   no-undo .
      612     do
      613     on error undo, return error return-value
      614     :
      615       run gbl/userobjs.w
      616         (input  parparentproc
      617         ,input  this-procedure :handle
      618         ,input  p-db-num
      619         ,input  p-user-id
      620         ,input  p-host-code-obj
      621         ,input  p-obj-type
      622         ,input  p-obj-code
      623         ,INPUT  "b-sel,b-mark"
      624         ,output p-user-select
      625         ,output v-select-obj-type
      626         ,output v-select-obj-code
      627         ) .
      628     end.
      629   end.
      630   procedure thobjs :
      631      define input        parameter parparentproc     as widget-handle no-undo .
      632      define input        parameter i-bttns           as character     no-undo .
      633      define input        parameter i-list-mode       as character     no-undo.
      634      define input        parameter i-obj-type        as character     no-undo.
      635      define input        parameter i-db-num          as integer       no-undo.
      636      define input        parameter i-host-code       as integer       no-undo.
      637      define input-output parameter p-rid-list        as character     no-undo .
      638   run ref/thobjs.p
      639           ( input parparentproc
      640            ,input  this-procedure :handle
      641           , input i-bttns
      642           , input i-list-mode
      643           , input i-obj-type
      644           , input i-db-num
      645           , input i-host-code
      646           , input-output p-rid-list ) no-error .
      647   end.
      648   define variable v-obj-list          as character    no-undo.
      649   define variable v-obj-full-list     as character    no-undo.
      650   define variable v-host-name         as character    no-undo.
      651   define temp-table temp_obj-list no-undo
      652       field obj-type as character
      653       field obj-code as integer
      654       index pi is primary unique obj-type obj-code
      655   .
      656   DEFINE BUTTON b-help
      657        LABEL "Помо&щь"
      658        SIZE 10 BY 1.
      659   DEFINE BUTTON bt-sel-doc-type
      660        IMAGE-UP FILE "btn-down-arrow":U
      661        IMAGE-DOWN FILE "btn-down-arrow":U
      662        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      663        LABEL "..."
      664        SIZE 3.63 BY 1.04.
      665   DEFINE BUTTON bt-sel-obj
      666        IMAGE-UP FILE "btn-down-arrow":U
      667        IMAGE-DOWN FILE "btn-down-arrow":U
      668        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      669        LABEL "..."
      670        SIZE 3.63 BY 1.04.
      671   DEFINE BUTTON Btn_Cancel
      672        LABEL "&Отмена"
      673        SIZE 10 BY 1
      674        BGCOLOR 8 .
      675   DEFINE BUTTON Btn_OK DEFAULT
      676        LABEL "&Ввод"
      677        SIZE 10 BY 1
      678        BGCOLOR 8 .
      679   DEFINE VARIABLE ed-doc-type AS CHARACTER
      680        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-VERTICAL NO-BOX
      681        SIZE 35.75 BY 1.83 NO-UNDO.
      682   DEFINE VARIABLE ed-doc-type-label AS CHARACTER INITIAL "Типы документов"
      683        VIEW-AS EDITOR NO-BOX
      684        SIZE 12.5 BY 1.75 NO-UNDO.
      685   DEFINE VARIABLE ed-object AS CHARACTER
      686        VIEW-AS EDITOR NO-BOX
      687        SIZE 35.63 BY 3.38
      688        FGCOLOR 1  NO-UNDO.
      689   DEFINE VARIABLE date_from AS DATE FORMAT "99/99/9999":U
      690        LABEL "Дата с"
      691        VIEW-AS FILL-IN
      692        SIZE 12 BY 1 NO-UNDO.
      693   DEFINE VARIABLE date_to AS DATE FORMAT "99/99/9999":U
      694        LABEL "---    Дата по"
      695        VIEW-AS FILL-IN
      696        SIZE 12 BY 1 NO-UNDO.
      697   DEFINE VARIABLE fi-shift-num-from AS INTEGER FORMAT ">9":U INITIAL 0
      698        LABEL "Порядок с"
      699        VIEW-AS FILL-IN
      700        SIZE 3.5 BY 1 NO-UNDO.
      701   DEFINE VARIABLE fi-shift-num-to AS INTEGER FORMAT ">9":U INITIAL 0
      702        LABEL "Порядок по"
      703        VIEW-AS FILL-IN
      704        SIZE 3.5 BY 1 NO-UNDO.
      705   DEFINE VARIABLE rs-1 AS INTEGER
      706        VIEW-AS RADIO-SET VERTICAL
      707        RADIO-BUTTONS
      708             "глобально", 1,
      709   "по фирме", 2,
      710   "по объектам", 3
      711        SIZE 13.75 BY 3.25 NO-UNDO.
      712   DEFINE RECTANGLE RECT-1
      713        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      714        SIZE 55.38 BY 4.38.
      715   DEFINE RECTANGLE RECT-2
      716        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      717        SIZE 55.25 BY 2.17.
      718   DEFINE VARIABLE tb-chk-pay-code AS LOGICAL INITIAL no
      719        LABEL "По типу кассовых платежей из чеков"
      720        VIEW-AS TOGGLE-BOX
      721        SIZE 38 BY .83 NO-UNDO.
      722   DEFINE VARIABLE tb-cst-code AS LOGICAL INITIAL no
      723        LABEL "ГТД по строке документа"
      724        VIEW-AS TOGGLE-BOX
      725        SIZE 26.38 BY .83 NO-UNDO.
      726   DEFINE VARIABLE tb-deleted AS LOGICAL INITIAL no
      727        LABEL "удалённые"
      728        VIEW-AS TOGGLE-BOX
      729        SIZE 20.5 BY .83 NO-UNDO.
      730   DEFINE VARIABLE tb-exp-checks AS LOGICAL INITIAL no
      731        LABEL "Чеки"
      732        VIEW-AS TOGGLE-BOX
      733        SIZE 20.5 BY .83 NO-UNDO.
      734   DEFINE VARIABLE tb-exp-doc-rvs AS LOGICAL INITIAL no
      735        LABEL "Сверки до/после слива"
      736        VIEW-AS TOGGLE-BOX
      737        SIZE 26.38 BY .83 NO-UNDO.
      738   DEFINE VARIABLE tb-inkass-pay-code AS LOGICAL INITIAL no
      739        LABEL "По виду оплаты"
      740        VIEW-AS TOGGLE-BOX
      741        SIZE 24.38 BY .83 NO-UNDO.
      742   DEFINE VARIABLE tb-parts AS LOGICAL INITIAL no
      743        LABEL "По партиям"
      744        VIEW-AS TOGGLE-BOX
      745        SIZE 26.38 BY .83 NO-UNDO.
      746   DEFINE VARIABLE tb-pay-desk AS LOGICAL INITIAL no
      747        LABEL "По кассе"
      748        VIEW-AS TOGGLE-BOX
      749        SIZE 12.25 BY .83 NO-UNDO.
      750   DEFINE VARIABLE tb-pay-desk-cards AS LOGICAL INITIAL no
      751        LABEL "По префиксам карт"
      752        VIEW-AS TOGGLE-BOX
      753        SIZE 22 BY .83 NO-UNDO.
      754   DEFINE VARIABLE tb-supp AS LOGICAL INITIAL no
      755        LABEL "Остатки по поставщикам"
      756        VIEW-AS TOGGLE-BOX
      757        SIZE 26.88 BY .83 NO-UNDO.
      758   DEFINE FRAME Dialog-Frame
      759        Btn_OK AT ROW 1.25 COL 1.5
      760        Btn_Cancel AT ROW 1.25 COL 11.5
      761        b-help AT ROW 1.25 COL 47
      762        date_from AT ROW 3 COL 9.5 COLON-ALIGNED
      763        date_to AT ROW 3 COL 42.5 COLON-ALIGNED
      764        fi-shift-num-from AT ROW 4.25 COL 18 COLON-ALIGNED
      765        fi-shift-num-to AT ROW 4.25 COL 51 COLON-ALIGNED
      766        tb-supp AT ROW 6.63 COL 10
      767        ed-object AT ROW 7.04 COL 20.38 NO-LABEL
      768        rs-1 AT ROW 7.13 COL 2.63 NO-LABEL
      769        bt-sel-obj AT ROW 9.29 COL 16.63
      770        ed-doc-type AT ROW 11.25 COL 16.38 NO-LABEL
      771        bt-sel-doc-type AT ROW 11.29 COL 52.88
      772        ed-doc-type-label AT ROW 11.33 COL 2.63 NO-LABEL
      773        tb-inkass-pay-code AT ROW 13.54 COL 2.13
      774        tb-deleted AT ROW 13.58 COL 36.13
      775        tb-cst-code AT ROW 14.33 COL 2.13
      776        tb-exp-checks AT ROW 14.33 COL 36.13 WIDGET-ID 2
      777        tb-exp-doc-rvs AT ROW 15.08 COL 36.13
      778        tb-parts AT ROW 15.08 COL 2.13
      779        tb-chk-pay-code AT ROW 15.83 COL 2.13
      780        tb-pay-desk AT ROW 16.75 COL 5.13
      781        tb-pay-desk-cards AT ROW 17.58 COL 5.13
      782        RECT-2 AT ROW 11.13 COL 1.63
      783        RECT-1 AT ROW 6.5 COL 1.5
      784        SPACE(1.36) SKIP(7.78)
      785       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      786            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      787            TITLE "Диапазон дат для экспорта".
      788   ASSIGN
      789          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      790          FRAME Dialog-Frame:HIDDEN           = TRUE.
      791   ASSIGN
      792          ed-doc-type:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      793   ASSIGN
      794          ed-doc-type-label:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      795   ASSIGN
      796          tb-supp:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      797   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      798   DO:
      799     APPLY "END-ERROR":U TO SELF.
      800   END.
      801   ON CHOOSE OF bt-sel-doc-type IN FRAME Dialog-Frame
      802   DO:
      803       define variable v-cancel     as logical           no-undo.
      804       define variable v-oper-num   as integer           no-undo.
      805       run bge/bgeseltp.w (
      806             input "trn-doc":U
      807           , input p-init-doc-type-list
      808           , output p-doc-type-list
      809           , output v-cancel
      810       ) no-error.
      811       if error-status :error
      812       then do:
      813           message
      814             vss-workfile vss-revision vss-description
      815             skip "Ошибка выбора типов операций."
      816             skip return-value
      817             skip trim(error-status :get-message(1))
      818                  trim(error-status :get-message(2))
      819                  trim(error-status :get-message(3))
      820                  trim(error-status :get-message(4))
      821                  trim(error-status :get-message(5))
      822           view-as alert-box error.
      823           undo, return no-apply .
      824       end.
      825       if v-cancel = yes
      826       then do:
      827           assign
      828               p-doc-type-list = p-init-doc-type-list
      829           .
      830       end.
      831       else do:
      832           assign
      833               p-init-doc-type-list    = p-doc-type-list
      834           .
      835           if p-doc-type-list = "":U
      836           then do:
      837               assign
      838                   ed-doc-type :screen-value in frame Dialog-Frame = "Все"
      839               .
      840           end.
      841           else do:
      842               assign
      843                   ed-doc-type :screen-value in frame Dialog-Frame = "":U
      844               .
      845               do v-oper-num = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
      846               :
      847                   if lookup( entry( v-oper-num, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ), p-init-doc-type-list ) <> 0
      848                   then do:
      849                       assign
      850                           ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
      851                                                       + entry( v-oper-num, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) + chr(10)
      852                       .
      853                   end.
      854               end.
      855           end.
      856       end.
      857   END.
      858   ON CHOOSE OF bt-sel-obj IN FRAME Dialog-Frame
      859   DO:
      860       define variable v-shift-on    as logical      no-undo.
      861       define variable v-object-available as logical   no-undo .
      862       assign
      863           rs-1 :screen-value  = "3"
      864       .
      865   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      866   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
      867     (input  v-cntxt-db-num
      868     ,input  0
      869     ,input  v-cntxt-userid
      870     ,input  v-cntxt-obj-type
      871     ,input  v-cntxt-obj-code
      872     ,output v-object-available
      873     ) no-error .
      874       if error-status :error
      875       then do:
      876         message
      877           vss-workfile vss-revision vss-description skip
      878           "Ошибка при вызове процедуры gbl/usobjava.i" skip
      879           error-status :get-message(1) skip
      880           return-value skip
      881           view-as alert-box error .
      882         undo, return no-apply .
      883       end.
      884       if v-object-available = true
      885       then do:
      886   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      887   run userobjs_append in this-procedure
      888     (input  v-cntxt-obj-type
      889     ,input  v-cntxt-obj-code
      890     )  .
      891       end.
      892       define variable v-user-select as logical   no-undo .
      893   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      894   run userobjs_select-many in this-procedure
      895     (input  parparentproc
      896     ,input  v-cntxt-db-num
      897     ,input  v-cntxt-userid
      898     ,input  v-cntxt-host-code-obj
      899     ,input  v-cntxt-obj-type
      900     ,input  v-cntxt-obj-code
      901     ,output v-user-select
      902     )  .
      903       if v-user-select <> true
      904       then do:
      905         message
      906           "Объект не выбран"
      907           view-as alert-box information .
      908         return no-apply .
      909       end.
      910       define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      911       for each  temp_obj-list.
      912         delete temp_obj-list.
      913       end.
      914       for each buf_userobjs_temp-user-obj
      915       on error undo, return no-apply
      916       :
      917         create temp_obj-list.
      918         assign
      919           temp_obj-list.obj-type = buf_userobjs_temp-user-obj.obj-type
      920           temp_obj-list.obj-code = buf_userobjs_temp-user-obj.obj-code
      921         .
      922       end.
      923       assign
      924           v-obj-list      = "":U
      925           v-obj-full-list = "":U
      926       .
      927       for each temp_obj-list
      928       :
      929           assign
      930               v-obj-list      = v-obj-list
      931                               + ( if v-obj-list <> "":U then ", " else "":U )
      932                               + substitute( "&1&2", temp_obj-list.obj-type, temp_obj-list.obj-code )
      933               v-obj-full-list = v-obj-full-list
      934                               + ( if v-obj-full-list <> "":U then ", " else "":U )
      935                               + substitute( "&1,&2", temp_obj-list.obj-type, temp_obj-list.obj-code )
      936           .
      937       end.
      938       assign
      939           ed-object :screen-value = v-obj-list
      940       .
      941       run get-shift-on in this-procedure (
      942             input 3
      943           , input v-obj-full-list
      944           , output v-shift-on
      945       ).
      946       if v-shift-on = ?
      947       then do:
      948           message
      949                    "Неверно выбраны объекты. Все выбранные объекты"
      950               skip "должны быть либо сменными, либо не сменными."
      951           view-as alert-box information.
      952           assign
      953               date_from :label = "Дата с"
      954           .
      955           hide
      956               fi-shift-num-from
      957               fi-shift-num-to
      958           .
      959       end.
      960       else do:
      961           if v-shift-on = yes
      962           then do:
      963               assign
      964                   date_from :label = "Смена с"
      965               .
      966               view
      967                   fi-shift-num-from
      968                   fi-shift-num-to
      969               .
      970           end.
      971           else do:
      972               assign
      973                   date_from :label = "Дата с"
      974               .
      975               hide
      976                   fi-shift-num-from
      977                   fi-shift-num-to
      978               .
      979           end.
      980       end.
      981   END.
      982   ON CHOOSE OF Btn_Cancel IN FRAME Dialog-Frame
      983   DO:
      984       assign
      985           p-cancel = yes
      986       .
      987       apply "window-close" to frame Dialog-Frame.
      988   END.
      989   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      990   DO:
      991       ASSIGN
      992           date_from
      993           date_to
      994           tb-inkass-pay-code
      995           tb-cst-code
      996           tb-parts
      997           tb-deleted
      998           tb-supp
      999           rs-1
     1000           tb-chk-pay-code
     1001           tb-pay-desk
     1002           tb-pay-desk-cards
     1003           tb-exp-checks
     1004           tb-exp-doc-rvs
     1005           fi-shift-num-from
     1006           fi-shift-num-to
     1007       .
     1008       assign
     1009           date_exp_from       = date_from
     1010           date_exp_to         = date_to
     1011           p-shift-num-from    = fi-shift-num-from
     1012           p-shift-num-to      = fi-shift-num-to
     1013           p-chk               = tb-exp-checks
     1014           p-doc-rvs           = tb-exp-doc-rvs
     1015       .
     1016       if p-output-type = 0
     1017       then do:
     1018         case rs-1 :screen-value
     1019         :
     1020         when "1"
     1021         then do:
     1022             assign
     1023                 p-range = 1
     1024                 p-obj-list = "":U
     1025             .
     1026         end.
     1027         when "2"
     1028         then do:
     1029             assign
     1030                 p-range = 2
     1031                 p-obj-list = "":U
     1032             .
     1033         end.
     1034         when "3"
     1035         then do:
     1036             assign
     1037                 p-range = 3
     1038             .
     1039             assign
     1040                 p-obj-list = "":U
     1041             .
     1042             for each temp_obj-list
     1043             :
     1044                 assign
     1045                     p-obj-list = p-obj-list
     1046                             + ( if p-obj-list = "":U then "":U else ",":U ) + temp_obj-list.obj-type
     1047                             + ",":U + string( temp_obj-list.obj-code )
     1048                 .
     1049             end.
     1050         end.
     1051         end case.
     1052       end.
     1053       if p-output-type = 2
     1054       then do:
     1055           assign
     1056               p-cst = tb-supp
     1057           .
     1058       end.
     1059       if p-output-type = 1
     1060       or p-output-type = 3
     1061       or p-output-type = 4
     1062       or p-output-type = 5
     1063       then do:
     1064           if p-output-type = 1
     1065           then do:
     1066               assign
     1067                   p-pay-code     = tb-inkass-pay-code
     1068                   p-cst          = tb-cst-code
     1069                   p-parts        = tb-parts
     1070                   p-deleted      = tb-deleted
     1071                   p-chk-pay-code = tb-chk-pay-code
     1072                   p-pay-desk     = tb-pay-desk
     1073                   p-pay-desk-cards = tb-pay-desk-cards
     1074               .
     1075           end.
     1076           case rs-1 :screen-value
     1077           :
     1078           when "1"
     1079           then do:
     1080               assign
     1081                   p-range = 1
     1082                   p-obj-list = "":U
     1083               .
     1084           end.
     1085           when "2"
     1086           then do:
     1087               assign
     1088                   p-range = 2
     1089                   p-host-code = v-cntxt-host-code-obj
     1090                   p-obj-list = "":U
     1091               .
     1092           end.
     1093           when "3"
     1094           then do:
     1095               assign
     1096                   p-range = 3
     1097               .
     1098               assign
     1099                   p-obj-list = "":U
     1100               .
     1101               for each temp_obj-list
     1102               :
     1103                   assign
     1104                       p-obj-list = p-obj-list
     1105                               + ( if p-obj-list = "":U then "":U else ",":U )
     1106                               + substitute( "&1,&2", temp_obj-list.obj-type, temp_obj-list.obj-code )
     1107                   .
     1108               end.
     1109           end.
     1110           end case.
     1111       end.
     1112       define variable v-data-are-valid        as logical      no-undo.
     1113       define variable v-reason                as character    no-undo.
     1114       define variable v-err-widget-handle     as handle       no-undo.
     1115       run check-data in this-procedure (
     1116             input date_exp_from
     1117           , input date_exp_to
     1118           , input p-shift-num-from
     1119           , input p-shift-num-to
     1120           , input tb-inkass-pay-code
     1121           , input tb-cst-code
     1122           , input tb-parts
     1123           , input tb-deleted
     1124           , input tb-supp
     1125           , input tb-chk-pay-code
     1126           , input tb-pay-desk
     1127           , input tb-pay-desk-cards
     1128           , input p-range
     1129           , input p-obj-list
     1130           , output v-data-are-valid
     1131           , output v-reason
     1132           , output v-err-widget-handle
     1133           , output p-shift-on
     1134       ) no-error.
     1135       if error-status :error
     1136       then do:
     1137           message
     1138                    vss-workfile vss-revision vss-description
     1139               skip(1)
     1140               skip "Ошибка проверки данных."
     1141               skip return-value
     1142               skip trim(error-status :get-message(1))
     1143                    trim(error-status :get-message(2))
     1144                    trim(error-status :get-message(3))
     1145           view-as alert-box error.
     1146           undo, return no-apply .
     1147       end.
     1148       if v-data-are-valid = no
     1149       then do:
     1150           message
     1151               "Выгрузка по введённым данным невозможна."
     1152               skip v-reason
     1153               skip (1)
     1154               skip "Исправьте данные и повторите ввод."
     1155           view-as alert-box error
     1156           title "Ошибка введённых данных".
     1157           if valid-handle( v-err-widget-handle )
     1158           then do:
     1159               apply "entry" to v-err-widget-handle.
     1160           end.
     1161           undo, return no-apply.
     1162       end.
     1163       run write-parameters in this-procedure (
     1164             input date_from
     1165           , input date_to
     1166           , input fi-shift-num-from
     1167           , input fi-shift-num-to
     1168           , input rs-1
     1169           , input p-host-code
     1170           , input p-obj-list
     1171           , input p-init-doc-type-list
     1172           , input p-pay-code
     1173           , input p-cst
     1174           , input p-parts
     1175           , input p-chk-pay-code
     1176           , input p-pay-desk
     1177           , input p-pay-desk-cards
     1178           , input p-deleted
     1179           , input p-chk
     1180           , input p-doc-rvs
     1181       ).
     1182       APPLY "GO" TO FRAME Dialog-Frame.
     1183   END.
     1184   ON RETURN OF date_from IN FRAME Dialog-Frame
     1185   DO:
     1186       APPLY "ENTRY" TO date_to IN FRAME Dialog-Frame.
     1187       RETURN NO-APPLY.
     1188   END.
     1189   ON RETURN OF date_to IN FRAME Dialog-Frame
     1190   DO:
     1191       APPLY "ENTRY" TO btn_OK IN FRAME Dialog-Frame.
     1192       RETURN NO-APPLY.
     1193   END.
     1194   ON VALUE-CHANGED OF rs-1 IN FRAME Dialog-Frame
     1195   DO:
     1196   run object-select in this-procedure no-error .
     1197   if error-status :error
     1198   then do:
     1199       undo, return no-apply.
     1200   end.
     1201   assign
     1202       rs-1
     1203   .
     1204   END.
     1205   ON VALUE-CHANGED OF tb-chk-pay-code IN FRAME Dialog-Frame
     1206   DO:
     1207       assign
     1208           tb-chk-pay-code
     1209       .
     1210       run manage-tb-chk-pay-code in this-procedure.
     1211   END.
     1212   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1213   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1214   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1215   on help of frame Dialog-Frame
     1216   do:
     1217     run gbl/app_help.p
     1218       (input this-procedure :file-name
     1219       ,input ''
     1220       ,input ?
     1221       ) no-error.
     1222     if error-status :error then do:
     1223       message
     1224         "Ошибка при вызове помощи"
     1225         error-status :get-message(1)
     1226         view-as alert-box .
     1227     end.
     1228   end.
     1229   run minbtn-set in this-procedure .
     1230   on choose of b-help in frame Dialog-Frame
     1231   do:
     1232     apply "help":u to frame Dialog-Frame .
     1233   end.
     1234   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1235   procedure minbtn-set :
     1236       do
     1237           on error undo, return error return-value
     1238           :
     1239           define variable ii              as integer       no-undo .
     1240           define variable fh              as widget-handle no-undo .
     1241           define variable hh              as widget-handle no-undo .
     1242           define variable v-h             as handle        extent 4 no-undo .
     1243           define variable v-name-button   as character     no-undo .
     1244           define variable v-help-old-x    as decimal       no-undo .
     1245           define variable v-help-old-y    as decimal       no-undo .
     1246           define variable v-help-old-size as decimal       no-undo .
     1247           define variable v-frame-width   as decimal       no-undo .
     1248           define variable jj              as integer       no-undo .
     1249           do
     1250               on error undo, return error
     1251               :
     1252               assign
     1253                   v-frame-width = frame Dialog-Frame:width - 0.3
     1254                   fh            = frame Dialog-Frame:first-child
     1255                   hh            = fh:first-child
     1256                   ii            = 1
     1257                   .
     1258               do while valid-handle(hh):
     1259                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1260                   do:
     1261                       case lc(hh:name) :
     1262                           when "b-help" then
     1263                               do:
     1264                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1265                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1266                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1267                                   hh:TOOLTIP = "Помощь" .
     1268                                   v-help-old-x = hh:column .
     1269                                   v-help-old-y = hh:row    .
     1270                                   v-help-old-size = hh:width .
     1271                                   hh:width-chars = 2.5 .
     1272                               end.
     1273                           when "b-print" then
     1274                               do:
     1275                                   hh:load-image("cmp/b-print.bmp":u) .
     1276                                   hh:TOOLTIP = "Печать" .
     1277                                   v-h[ii] = hh:handle .
     1278                                   ii = ii + 1 .
     1279                                   hh:width-chars = 3 .
     1280                               end.
     1281                           when "b-history" or
     1282                           when "b-hist" then
     1283                               do:
     1284                                   hh:load-image("cmp/b-hist.bmp":u) .
     1285                                   hh:TOOLTIP = "История" .
     1286                                   v-h[ii] = hh:handle .
     1287                                   ii = ii + 1 .
     1288                                   hh:width-chars = 3 .
     1289                               end.
     1290                           when "b-sch" then
     1291                               do:
     1292                                   hh:load-image("cmp/b-sch.bmp":u) .
     1293                                   hh:TOOLTIP = "Установка Фильтра" .
     1294                                   v-h[ii] = hh:handle .
     1295                                   ii = ii + 1 .
     1296                                   hh:width-chars = 3 .
     1297                               end.
     1298                           when "b-hist-user" then
     1299                               do:
     1300                                   hh:load-image("cmp/b-hist.bmp":u) .
     1301                                   hh:TOOLTIP = "История пользователя" .
     1302                                   ii = ii + 1 .
     1303                               end.
     1304                       end case.
     1305                   end.
     1306                   hh = hh:next-sibling.
     1307               end.
     1308               b-help:column = v-frame-width - b-help:width-chars.
     1309               jj = 0.
     1310               repeat ii = 4 to 1 by -1 :
     1311                   if valid-handle (v-h[ii] ) then
     1312                   do:
     1313                       jj  = jj + 1 .
     1314                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1315                       v-h[ii]:row    = v-help-old-y .
     1316                   end.
     1317               end.
     1318           end.
     1319       end.
     1320   end procedure.
     1321   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1322   on ' ' of date_from in frame Dialog-Frame
     1323   do:
     1324     if (can-query (self, "sensitive")
     1325        and
     1326        self :sensitive = true
     1327        )
     1328     or (can-query (self, "read-only")
     1329        and
     1330        self :read-only = false
     1331        )
     1332     then do:
     1333       assign
     1334         self :screen-value = ?
     1335       .
     1336     end.
     1337     return no-apply.
     1338   end.
     1339   on delete-character of date_from in frame Dialog-Frame
     1340   do:
     1341     if (can-query (self, "sensitive")
     1342        and
     1343        self :sensitive = true
     1344        )
     1345     or (can-query (self, "read-only")
     1346        and
     1347        self :read-only = false
     1348        )
     1349     then do:
     1350       assign
     1351         self :screen-value = ?
     1352       .
     1353     end.
     1354     return no-apply.
     1355   end.
     1356   on ctrl-d of date_from in frame Dialog-Frame
     1357   do:
     1358     define variable v-curr-sv-date as date no-undo .
     1359     if (can-query (self, "sensitive")
     1360        and
     1361        self :sensitive = true
     1362        )
     1363     or (can-query (self, "read-only")
     1364        and
     1365        self :read-only = false
     1366        )
     1367     then do:
     1368       if self :handle <> focus :handle
     1369       then do:
     1370         apply "entry":u to self .
     1371       end.
     1372       run gbl/getcurdt.p
     1373         (output v-curr-sv-date
     1374         ) .
     1375       assign
     1376         self :screen-value = string(v-curr-sv-date) .
     1377       .
     1378     end.
     1379     return no-apply.
     1380   end.
     1381   on ctrl-b of date_from in frame Dialog-Frame
     1382   do:
     1383     if (can-query (self, "sensitive")
     1384        and
     1385        self :sensitive = true
     1386        )
     1387     or (can-query (self, "read-only")
     1388        and
     1389        self :read-only = false
     1390        )
     1391     then do:
     1392       if self :handle <> focus :handle
     1393       then do:
     1394         apply "entry":u to self .
     1395       end.
     1396       define variable v-curr-sv-date as date no-undo .
     1397       define variable v-new-sv-date  as date no-undo .
     1398       assign
     1399         v-curr-sv-date = date(self :screen-value) no-error
     1400       .
     1401       if v-curr-sv-date = ?
     1402       then do:
     1403         run gbl/getcurdt.p
     1404           (output v-curr-sv-date
     1405           ) .
     1406       end.
     1407       if v-curr-sv-date <> ?
     1408       then do:
     1409         assign
     1410           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1411         .
     1412         assign
     1413           self :screen-value = string(v-new-sv-date) .
     1414         .
     1415       end.
     1416     end.
     1417     return no-apply .
     1418   end.
     1419   on ctrl-e of date_from in frame Dialog-Frame
     1420   do:
     1421     if (can-query (self, "sensitive")
     1422        and
     1423        self :sensitive = true
     1424        )
     1425     or (can-query (self, "read-only")
     1426        and
     1427        self :read-only = false
     1428        )
     1429     then do:
     1430       if self :handle <> focus :handle
     1431       then do:
     1432         apply "entry":u to self .
     1433       end.
     1434       define variable v-curr-sv-date as date no-undo .
     1435       define variable v-new-sv-date  as date no-undo .
     1436       assign
     1437         v-curr-sv-date = date(self :screen-value) no-error
     1438       .
     1439       if v-curr-sv-date = ?
     1440       then do:
     1441         run gbl/getcurdt.p
     1442           (output v-curr-sv-date
     1443           ) .
     1444       end.
     1445       if v-curr-sv-date <> ?
     1446       then do:
     1447         run gbl/lastdate.p
     1448           (input  v-curr-sv-date
     1449           ,output v-new-sv-date
     1450           ).
     1451         assign
     1452           self :screen-value = string(v-new-sv-date) .
     1453         .
     1454       end.
     1455     end.
     1456     return no-apply .
     1457   end.
     1458   on ctrl-f of date_from in frame Dialog-Frame
     1459   do:
     1460     if (can-query (self, "sensitive")
     1461        and
     1462        self :sensitive = true
     1463        )
     1464     or (can-query (self, "read-only")
     1465        and
     1466        self :read-only = false
     1467        )
     1468     then do:
     1469       if self :handle <> focus :handle
     1470       then do:
     1471         apply "entry":u to self .
     1472       end.
     1473       define variable v-ok            as logical   no-undo .
     1474       define variable v-curr-sv-date  as date      no-undo .
     1475       define variable v-description   as character no-undo .
     1476       assign
     1477         v-curr-sv-date = date(self :screen-value) no-error
     1478       .
     1479       if v-curr-sv-date = ?
     1480       then do:
     1481         run gbl/getcurdt.p
     1482           (output v-curr-sv-date
     1483           ) .
     1484       end.
     1485       if v-curr-sv-date <> ?
     1486       then do:
     1487         run gbl/d-inpday.w
     1488           (input ?
     1489           ,input "Выбор даты"
     1490           ,input v-description
     1491           ,input ""
     1492           ,input-output v-curr-sv-date
     1493           ,output v-ok
     1494           ).
     1495         if v-ok = true
     1496         then do:
     1497           assign
     1498             self :screen-value = string(v-curr-sv-date) .
     1499           .
     1500         end.
     1501       end.
     1502     end.
     1503     return no-apply .
     1504   end.
     1505     define MENU m-ed-date10
     1506       MENU-ITEM m-ed-date10-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1507       MENU-ITEM m-ed-date10-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1508       MENU-ITEM m-ed-date10-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1509       MENU-ITEM m-ed-date10-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1510       .
