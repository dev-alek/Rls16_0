     1729       MENU-ITEM m-ed-date12-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1730       MENU-ITEM m-ed-date12-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1731       MENU-ITEM m-ed-date12-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1732       MENU-ITEM m-ed-date12-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1733       .
     1734     if date_to :POPUP-MENU in frame Dialog-Frame = ?
     1735     then do:
     1736       ASSIGN
     1737         date_to :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date12 :HANDLE
     1738         date_to :MENU-MOUSE in frame Dialog-Frame = 3
     1739       .
     1740     end.
     1741     define variable v-label-handle12 as handle no-undo .
     1742     assign
     1743       v-label-handle12 = date_to :side-label-handle in frame Dialog-Frame
     1744     .
     1745     if valid-handle (v-label-handle12)
     1746     then do:
     1747       if v-label-handle12 :tooltip = ""
     1748       or v-label-handle12 :tooltip = ?
     1749       then do:
     1750         assign
     1751           v-label-handle12 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1752         .
     1753       end.
     1754     end.
     1755     ON CHOOSE OF MENU-ITEM m-ed-date12-1 in menu m-ed-date12 DO:
     1756       apply "ctrl-b":U to date_to in frame Dialog-Frame .
     1757     END.
     1758     ON CHOOSE OF MENU-ITEM m-ed-date12-2 in menu m-ed-date12 DO:
     1759       apply "ctrl-d":U to date_to in frame Dialog-Frame .
     1760     END.
     1761     ON CHOOSE OF MENU-ITEM m-ed-date12-3 in menu m-ed-date12 DO:
     1762       apply "ctrl-e":U to date_to in frame Dialog-Frame .
     1763     END.
     1764     ON CHOOSE OF MENU-ITEM m-ed-date12-4 in menu m-ed-date12 DO:
     1765       apply "ctrl-f":U to date_to in frame Dialog-Frame .
     1766     END.
     1767   MAIN-BLOCK:
     1768   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1769      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1770   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1771     run mainmenu_getcntxt in parparentproc
     1772       (output v-cntxt-db-num
     1773       ,output v-cntxt-userid
     1774       ,output v-cntxt-level
     1775       ,output v-cntxt-host-code-obj
     1776       ,output v-cntxt-obj-type
     1777       ,output v-cntxt-obj-code
     1778       ,output v-cntxt-db-num-obj
     1779       ,output v-cntxt-is-admin
     1780       ) .
     1781       run init-fields in this-procedure .
     1782       RUN enable_UI.
     1783       run init-manage-fields in this-procedure .
     1784       WAIT-FOR GO OF FRAME Dialog-Frame.
     1785   END.
     1786   RUN disable_UI.
     1787   PROCEDURE assign-date :
     1788   define input parameter p-parameter-number   as integer          no-undo.
     1789   define input parameter p-parameter-list     as character        no-undo.
     1790   define input parameter p-default-value      as date             no-undo.
     1791   define output parameter p-parameter-value   as date             no-undo.
     1792   do
     1793   on error undo, return error
     1794   :
     1795       if num-entries( p-parameter-list ) >= p-parameter-number
     1796       then do:
     1797           assign
     1798               p-parameter-value   = date( entry( p-parameter-number, p-parameter-list ) )
     1799           no-error.
     1800           if error-status :error
     1801           then do:
     1802               assign
     1803                   p-parameter-value = p-default-value
     1804               .
     1805           end.
     1806       end.
     1807       else do:
     1808           assign
     1809               p-parameter-value = p-default-value
     1810           .
     1811       end.
     1812   end.
     1813   END PROCEDURE.
     1814   PROCEDURE assign-integer :
     1815   define input parameter p-parameter-number   as integer          no-undo.
     1816   define input parameter p-parameter-list     as character        no-undo.
     1817   define input parameter p-default-value      as integer          no-undo.
     1818   define output parameter p-parameter-value   as integer          no-undo.
     1819   do
     1820   on error undo, return error
     1821   :
     1822       if num-entries( p-parameter-list ) >= p-parameter-number
     1823       then do:
     1824           assign
     1825               p-parameter-value   = integer( entry( p-parameter-number, p-parameter-list ) )
     1826           no-error.
     1827           if error-status :error
     1828           then do:
     1829               assign
     1830                   p-parameter-value = p-default-value
     1831               .
     1832           end.
     1833       end.
     1834       else do:
     1835           assign
     1836               p-parameter-value = p-default-value
     1837           .
     1838       end.
     1839   end.
     1840   END PROCEDURE.
     1841   PROCEDURE assign-logical :
     1842   define input parameter p-parameter-number   as integer          no-undo.
     1843   define input parameter p-parameter-list     as character        no-undo.
     1844   define input parameter p-default-value      as logical          no-undo.
     1845   define output parameter p-parameter-value   as logical          no-undo.
     1846   do
     1847   on error undo, return error
     1848   :
     1849       if num-entries( p-parameter-list ) >= p-parameter-number
     1850       then do:
     1851           assign
     1852               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
     1853           .
     1854       end.
     1855       else do:
     1856           assign
     1857               p-parameter-value = p-default-value
     1858           .
     1859       end.
     1860   end.
     1861   END PROCEDURE.
     1862   PROCEDURE check-data :
     1863   define input parameter p-date_from          as date             no-undo.
     1864   define input parameter p-date_to            as date             no-undo.
     1865   define input parameter p-shift-num-from     as integer          no-undo.
     1866   define input parameter p-shift-num-to       as integer          no-undo.
     1867   define input parameter p-tb-inkass-pay-code as logical          no-undo.
     1868   define input parameter p-tb-cst-code        as logical          no-undo.
     1869   define input parameter p-tb-parts           as logical          no-undo.
     1870   define input parameter p-tb-deleted         as logical          no-undo.
     1871   define input parameter p-tb-supp            as logical          no-undo.
     1872   define input parameter p-tb-chk-pay-code    as logical          no-undo.
     1873   define input parameter p-tb-pay-desk        as logical          no-undo.
     1874   define input parameter p-tb-pay-desk-cards  as logical          no-undo.
     1875   define input parameter p-range              as integer          no-undo.
     1876   define input parameter p-obj-list           as character        no-undo.
     1877   define output parameter p-data-are-valid    as logical          no-undo.
     1878   define output parameter p-reason            as character        no-undo.
     1879   define output parameter p-err-widget-handle as handle           no-undo.
     1880   define output parameter p-shift-on          as logical          no-undo.
     1881       define variable v-shift-on    as logical      no-undo.
     1882   do
     1883   with frame Dialog-Frame
     1884   on error undo, return error
     1885   :
     1886       assign
     1887           p-data-are-valid = yes
     1888       .
     1889       if p-date_from > p-date_to
     1890       and p-output-type <> 4
     1891       then do:
     1892           assign
     1893               p-data-are-valid = no
     1894               p-reason         = substitute( "&2&1&3":U
     1895                                       , chr(10)
     1896                                       , "Даты интервала заданы неверно. "
     1897                                       , "Нижняя дата интервала должна быть меньше верхней."
     1898                                       )
     1899               p-err-widget-handle = date_from :handle
     1900           .
     1901           undo, return no-apply.
     1902       end.
     1903       if p-range < 1
     1904       or p-range > 3
     1905       then do:
     1906           assign
     1907               p-data-are-valid = no
     1908               p-reason         = substitute( "&2&1&3":U
     1909                                       , chr(10)
     1910                                       , p-reason
     1911                                       , "Неверно выбраны объекты для выгрузки."
     1912                                       )
     1913               p-err-widget-handle = rs-1 :handle
     1914           .
     1915           undo, return no-apply.
     1916       end.
     1917       run get-shift-on in this-procedure (
     1918             input p-range
     1919           , input p-obj-list
     1920           , output v-shift-on
     1921       ).
     1922       if v-shift-on = ?
     1923       then do:
     1924           assign
     1925               p-data-are-valid = no
     1926               p-reason         = substitute( "&2&1&3&1&4":U
     1927                                       , chr(10)
     1928                                       , p-reason
     1929                                       , "Неверно выбраны объекты. Все выбранные объекты"
     1930                                       , "должны быть либо сменными, либо не сменными."
     1931                                       )
     1932               p-err-widget-handle = rs-1 :handle
     1933           .
     1934       end.
     1935       else do:
     1936           assign
     1937               p-shift-on = v-shift-on
     1938           .
     1939       end.
     1940       if p-shift-on = yes
     1941       and p-shift-num-from = 0
     1942       then do:
     1943           assign
     1944               p-data-are-valid = no
     1945               p-reason         = substitute( "&2&1&3&1&4":U
     1946                                       , chr(10)
     1947                                       , p-reason
     1948                                       , "Введите номер смены с..."
     1949                                       )
     1950               p-err-widget-handle = fi-shift-num-from :handle
     1951           .
     1952       end.
     1953       if p-shift-on = yes
     1954       and p-shift-num-to = 0
     1955       then do:
     1956           assign
     1957               p-data-are-valid = no
     1958               p-reason         = substitute( "&2&1&3&1&4":U
     1959                                       , chr(10)
     1960                                       , p-reason
     1961                                       , "Введите номер смены по..."
     1962                                       )
     1963               p-err-widget-handle = fi-shift-num-to :handle
     1964           .
     1965       end.
     1966       if p-shift-on = yes
     1967       and p-date_from = p-date_to
     1968       and p-shift-num-from > p-shift-num-to
     1969       then do:
     1970           assign
     1971               p-data-are-valid = no
     1972               p-reason         = substitute( "&2&1&3&1&4":U
     1973                                       , chr(10)
     1974                                       , p-reason
     1975                                       , "Неверно введены номера смен."
     1976                                       )
     1977               p-err-widget-handle = fi-shift-num-from :handle
     1978           .
     1979       end.
     1980   end.
     1981   END PROCEDURE.
     1982   PROCEDURE disable_UI :
     1983     HIDE FRAME Dialog-Frame.
     1984   END PROCEDURE.
     1985   PROCEDURE enable_UI :
     1986     DISPLAY date_from date_to ed-object rs-1 ed-doc-type ed-doc-type-label
     1987             tb-inkass-pay-code tb-deleted tb-cst-code tb-exp-checks tb-parts
     1988             tb-chk-pay-code tb-pay-desk tb-pay-desk-cards tb-exp-doc-rvs
     1989         WITH FRAME Dialog-Frame.
     1990     ENABLE RECT-2 RECT-1 Btn_OK Btn_Cancel b-help date_from date_to
     1991            fi-shift-num-from fi-shift-num-to rs-1 bt-sel-obj ed-doc-type
     1992            bt-sel-doc-type tb-inkass-pay-code tb-deleted tb-cst-code
     1993            tb-exp-checks tb-parts tb-chk-pay-code tb-pay-desk tb-pay-desk-cards
     1994            tb-exp-doc-rvs
     1995         WITH FRAME Dialog-Frame.
     1996     VIEW FRAME Dialog-Frame.
     1997   END PROCEDURE.
     1998   PROCEDURE get-host-name :
     1999   do
     2000   on error undo, return error
     2001   :
     2002   define output parameter p-host-name as character    no-undo.
     2003   define buffer buf_clients   for clients.
     2004       find first buf_clients no-lock
     2005            where buf_clients.obj-type = 'орг':U
     2006              and buf_clients.obj-code = v-cntxt-host-code-obj
     2007       no-error.
     2008       if not available buf_clients
     2009       then do:
     2010           message
     2011             vss-workfile vss-revision vss-description
     2012             skip "Не удалось найти текущую фирму"
     2013             skip return-value
     2014             skip trim(error-status :get-message(1))
     2015                  trim(error-status :get-message(2))
     2016                  trim(error-status :get-message(3))
     2017                  trim(error-status :get-message(4))
     2018                  trim(error-status :get-message(5))
     2019           view-as alert-box error.
     2020           undo, return error .
     2021       end.
     2022       else do:
     2023           assign
     2024               p-host-name = buf_clients.obj-name
     2025           .
     2026       end.
     2027   end.
     2028   END PROCEDURE.
     2029   PROCEDURE get-shift-on :
     2030   define input parameter p-range          as integer          no-undo.
     2031   define input parameter p-obj-list       as character        no-undo.
     2032   define output parameter p-shift-on      as logical          no-undo.
     2033       define variable v-shift-obj-on      as logical      no-undo.
     2034       define variable v-obj-counter       as integer      no-undo.
     2035       define variable v-obj-type          as character    no-undo.
     2036       define variable v-obj-code          as integer      no-undo.
     2037   do
     2038   on error undo, return error
     2039   :
     2040       assign
     2041           p-shift-on = ?
     2042       .
     2043       case p-range
     2044       :
     2045           when 1
     2046           then do:
     2047               run init-temphost.
     2048               check-shift-on-all-obj:
     2049               for each temp-obj
     2050               :
     2051   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2052   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2053     (input  temp-obj.obj-type
     2054     ,input  temp-obj.obj-code
     2055     ,input  'shift-on=request'
     2056     ,output v-shift-obj-on
     2057     ) no-error .
     2058                   if error-status :error
     2059                   then do:
     2060                       message
     2061                           vss-workfile vss-revision vss-description
     2062                           skip "Ошибка при определении типа сменный/не-сменный для объекта"
     2063                           skip "Объект" temp-obj.obj-type temp-obj.obj-code
     2064                           skip "Атрибут" 'shift-on=request':U
     2065                           skip error-status :get-message(1)
     2066                           skip return-value
     2067                       view-as alert-box error .
     2068                       undo, return error .
     2069                   end.
     2070                   if p-shift-on = ?
     2071                   then do:
     2072                       assign
     2073                           p-shift-on = v-shift-obj-on
     2074                       .
     2075                   end.
     2076                   else do:
     2077                       if p-shift-on <> v-shift-obj-on
     2078                       then do:
     2079                           assign
     2080                               p-shift-on = ?
     2081                           .
     2082                           leave check-shift-on-all-obj.
     2083                       end.
     2084                   end.
     2085               end.
     2086           end.
     2087           when 2
     2088           then do:
     2089               run init-temphost.
     2090               check-shift-on-all-obj:
     2091               for each temp-obj
     2092               where temp-obj.host-code = v-cntxt-host-code-obj
     2093               :
     2094   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2095   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2096     (input  temp-obj.obj-type
     2097     ,input  temp-obj.obj-code
     2098     ,input  'shift-on=request'
     2099     ,output v-shift-obj-on
     2100     ) no-error .
     2101                   if error-status :error
     2102                   then do:
     2103                       message
     2104                           vss-workfile vss-revision vss-description
     2105                           skip "Ошибка при определении типа сменный/не-сменный для объекта"
     2106                           skip "Объект" temp-obj.obj-type temp-obj.obj-code
     2107                           skip "Атрибут" 'shift-on=request':U
     2108                           skip error-status :get-message(1)
     2109                           skip return-value
     2110                       view-as alert-box error .
     2111                       undo, return error .
     2112                   end.
     2113                   if p-shift-on = ?
     2114                   then do:
     2115                       assign
     2116                           p-shift-on = v-shift-obj-on
     2117                       .
     2118                   end.
     2119                   else do:
     2120                       if p-shift-on <> v-shift-obj-on
     2121                       then do:
     2122                           assign
     2123                               p-shift-on = ?
     2124                           .
     2125                           leave check-shift-on-all-obj.
     2126                       end.
     2127                   end.
     2128               end.
     2129           end.
     2130           when 3
     2131           then do:
     2132               check-shift-on-all-obj:
     2133               do
     2134               v-obj-counter = 1 to num-entries( p-obj-list ) / 2
     2135               on error undo, return error
     2136               :
     2137                   assign
     2138                       v-obj-type = trim( entry( v-obj-counter * 2 - 1, p-obj-list ) )
     2139                       v-obj-code = integer( entry( v-obj-counter * 2    , p-obj-list ) )
     2140                   .
     2141   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2142   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2143     (input  v-obj-type
     2144     ,input  v-obj-code
     2145     ,input  'shift-on=request'
     2146     ,output v-shift-obj-on
     2147     ) no-error .
     2148                   if error-status :error
     2149                   then do:
     2150                       message
     2151                           vss-workfile vss-revision vss-description
     2152                           skip "Ошибка при определении типа сменный/не-сменный для объекта"
     2153                           skip "Объект" v-obj-type v-obj-code
     2154                           skip "Атрибут" 'shift-on=request':U
     2155                           skip error-status :get-message(1)
     2156                           skip return-value
     2157                       view-as alert-box error .
     2158                       undo, return error .
     2159                   end.
     2160                   if p-shift-on = ?
     2161                   then do:
     2162                       assign
     2163                           p-shift-on = v-shift-obj-on
     2164                       .
     2165                   end.
     2166                   else do:
     2167                       if p-shift-on <> v-shift-obj-on
     2168                       then do:
     2169                           assign
     2170                               p-shift-on = ?
     2171                           .
     2172                           leave check-shift-on-all-obj.
     2173                       end.
     2174                   end.
     2175               end.
     2176           end.
     2177       end case.
     2178   end.
     2179   END PROCEDURE.
     2180   PROCEDURE init-fields :
     2181       define variable v-today         as date         no-undo.
     2182       define variable v-time          as integer      no-undo.
     2183       define variable v-obj-counter   as integer      no-undo.
     2184       define variable v-doc-type-list as character    no-undo.
     2185   do
     2186   with frame Dialog-Frame
     2187   on error undo, return error
     2188   :
     2189       run cur-time in this-procedure (
     2190             output v-today
     2191           , output v-time
     2192       ).
     2193       run read-parameters in this-procedure (
     2194             input v-today
     2195           , input v-cntxt-host-code-obj
     2196           , output date_from
     2197           , output date_to
     2198           , output fi-shift-num-from
     2199           , output fi-shift-num-to
     2200           , output rs-1
     2201           , output p-host-code
     2202           , output p-obj-list
     2203           , output v-doc-type-list
     2204           , output tb-inkass-pay-code
     2205           , output tb-cst-code
     2206           , output tb-parts
     2207           , output tb-chk-pay-code
     2208           , output tb-pay-desk
     2209           , output tb-pay-desk-cards
     2210           , output tb-deleted
     2211           , output tb-exp-checks
     2212           , output tb-exp-doc-rvs
     2213       ).
     2214       if p-init-doc-type-list = "":U
     2215       then do:
     2216           assign
     2217               p-init-doc-type-list = v-doc-type-list
     2218           .
     2219       end.
     2220       case rs-1
     2221       :
     2222           when 1
     2223           then do:
     2224               assign
     2225                   ed-object = "":U
     2226               .
     2227           end.
     2228           when 2
     2229           then do:
     2230               assign
     2231                   ed-object = string( p-host-code )
     2232               .
     2233           end.
     2234           when 3
     2235           then do:
     2236               assign
     2237                   ed-object = "":U
     2238               .
     2239               do
     2240               v-obj-counter = 1 to num-entries( p-obj-list ) / 2
     2241               :
     2242                   create temp_obj-list.
     2243                   assign
     2244                       temp_obj-list.obj-type = entry( v-obj-counter * 2 - 1, p-obj-list )
     2245                       temp_obj-list.obj-code = integer( entry( v-obj-counter * 2    , p-obj-list ) )
     2246                       ed-object              = substitute( "&1&2&3&4"
     2247                                                   , ed-object
     2248                                                   , ( if ed-object = "":U then "":U else ",":U )
     2249                                                   , temp_obj-list.obj-type
     2250                                                   , temp_obj-list.obj-code  )
     2251                   .
     2252               end.
     2253           end.
     2254       end case.
     2255       run get-host-name in this-procedure (
     2256           output v-host-name
     2257       ) no-error .
     2258       if error-status :error
     2259       then do:
     2260           message
     2261             vss-workfile vss-revision vss-description
     2262             skip "Ошибка при определении имени фирмы"
     2263             skip "Код фирмы:" v-cntxt-host-code-obj
     2264             skip "Имя фирмы будет отображаться как '" + 'орг':U + string( v-cntxt-host-code-obj ) + "'"
     2265             skip return-value
     2266             skip trim(error-status :get-message(1))
     2267                  trim(error-status :get-message(2))
     2268                  trim(error-status :get-message(3))
     2269           view-as alert-box warning.
     2270           assign
     2271               v-host-name = 'орг':U + string( v-cntxt-host-code-obj )
     2272           .
     2273       end.
     2274   end.
     2275   END PROCEDURE.
     2276   PROCEDURE init-manage-fields :
     2277       define variable v-shift-on    as logical      no-undo.
     2278       define variable v-oper-num     as integer           no-undo.
     2279   do
     2280   with frame Dialog-Frame
     2281   on error undo, return error
     2282   :
     2283       if p-output-type = 0
     2284       or p-output-type = 2
     2285       or p-output-type = 3
     2286       or p-output-type = 5
     2287       then do:
     2288           disable ed-doc-type.
     2289           hide
     2290               bt-sel-doc-type
     2291               tb-inkass-pay-code
     2292               tb-cst-code
     2293               tb-parts
     2294               tb-chk-pay-code
     2295               tb-pay-desk
     2296               tb-pay-desk-cards
     2297               tb-deleted
     2298           .
     2299           if p-output-type <> 3
     2300           then do:
     2301               hide
     2302                   RECT-1
     2303                   rs-1
     2304                   bt-sel-obj
     2305                   ed-object
     2306               .
     2307           end.
     2308       end.
     2309       if p-output-type = 2
     2310       then do:
     2311           view tb-supp in frame Dialog-Frame .
     2312           enable tb-supp with frame Dialog-Frame .
     2313       end.
     2314       if p-output-type = 4
     2315       or p-output-type = 5
     2316       then do:
     2317           hide
     2318               tb-supp
     2319               bt-sel-doc-type
     2320               tb-inkass-pay-code
     2321               tb-cst-code
     2322               tb-parts
     2323               tb-chk-pay-code
     2324               tb-pay-desk
     2325               tb-pay-desk-cards
     2326               tb-deleted
     2327               RECT-2
     2328               ed-doc-type
     2329               ed-doc-type-label
     2330           .
     2331           if p-output-type = 4
     2332           then do:
     2333               hide
     2334                   date_to
     2335               .
     2336           end.
     2337           if p-output-type = 5
     2338           then do:
     2339               view
     2340                   RECT-1
     2341                   rs-1
     2342                   bt-sel-obj
     2343                   ed-object
     2344               .
     2345               assign
     2346                   frame Dialog-Frame :title = "Выбор объектов для экспорта"
     2347               .
     2348           end.
     2349       end.
     2350       run manage-tb-chk-pay-code in this-procedure.
     2351       assign
     2352           p-doc-type-list = p-init-doc-type-list
     2353       .
     2354       if p-init-doc-type-list <> ?
     2355       and p-init-doc-type-list <> "":U
     2356       then do:
     2357           do v-oper-num = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2358           :
     2359               if lookup( entry( v-oper-num, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ), p-init-doc-type-list ) <> 0
     2360               then do:
     2361                   assign
     2362                       ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
     2363                                                   + entry( v-oper-num, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) + chr(10)
     2364                   .
     2365               end.
     2366           end.
     2367       end.
     2368       else do:
     2369           assign
     2370               ed-doc-type :screen-value = chr(10) + "    Все"
     2371           .
     2372       end.
     2373       define variable v-obj-list    as character    no-undo.
     2374       for each temp_obj-list
     2375       :
     2376           assign
     2377               v-obj-list = substitute( "&1&2&3,&4"
     2378                                           , v-obj-list
     2379                                           , ( if v-obj-list = "":U then "":U else "," )
     2380                                           , temp_obj-list.obj-type
     2381                                           , temp_obj-list.obj-code
     2382                                       )
     2383           .
     2384       end.
     2385       run get-shift-on in this-procedure (
     2386             input rs-1
     2387           , input v-obj-list
     2388           , output v-shift-on
     2389       ).
     2390       if v-shift-on = ?
     2391       then do:
     2392           message
     2393                    "Неверно выбраны объекты. Все выбранные объекты"
     2394               skip "должны быть либо сменными, либо не сменными."
     2395           view-as alert-box information.
     2396           hide
     2397               fi-shift-num-from
     2398               fi-shift-num-to
     2399           .
     2400       end.
     2401       else do:
     2402           if v-shift-on = yes
     2403           then do:
     2404               assign
     2405                   date_from :label = "Смена с"
     2406               .
     2407               view
     2408                   fi-shift-num-from
     2409                   fi-shift-num-to
     2410               .
     2411               display
     2412                   fi-shift-num-from
     2413                   fi-shift-num-to
     2414               .
     2415           end.
     2416           else do:
     2417               assign
     2418                   date_from :label = "Дата с"
     2419               .
     2420               hide
     2421                   fi-shift-num-from
     2422                   fi-shift-num-to
     2423               .
     2424           end.
     2425       end.
     2426   end.
     2427   END PROCEDURE.
     2428   PROCEDURE manage-tb-chk-pay-code :
     2429   do
     2430   on error undo, return error
     2431   :
     2432       if tb-chk-pay-code = yes
     2433       then do:
     2434           assign
     2435               tb-pay-desk :sensitive in frame Dialog-Frame = yes
     2436               tb-pay-desk-cards :sensitive in frame Dialog-Frame = yes
     2437           .
     2438       end.
     2439       else do:
     2440           assign
     2441               tb-pay-desk :sensitive in frame Dialog-Frame = no
     2442               tb-pay-desk-cards :sensitive in frame Dialog-Frame = no
     2443           .
     2444       end.
     2445   end.
     2446   END PROCEDURE.
     2447   PROCEDURE object-select :
     2448       define variable v-shift-on    as logical      no-undo.
     2449       define variable v-obj-list    as character    no-undo.
     2450   do
     2451   with frame Dialog-Frame
     2452   on error undo, return error
     2453   :
     2454       case rs-1 :screen-value in frame Dialog-frame
     2455       :
     2456           when "1"
     2457           then do:
     2458               assign
     2459                   ed-object :screen-value = "":U
     2460               .
     2461           end.
     2462           when "2"
     2463           then do:
     2464               assign
     2465                   ed-object :screen-value = v-host-name
     2466               .
     2467           end.
     2468           when "3"
     2469           then do:
     2470               for each temp_obj-list
     2471               :
     2472                   delete temp_obj-list.
     2473               end.
     2474               create temp_obj-list.
     2475               assign
     2476                   temp_obj-list.obj-type = v-cntxt-obj-type
     2477                   temp_obj-list.obj-code = v-cntxt-obj-code
     2478                   ed-object :screen-value = substitute( "&1&2", v-cntxt-obj-type, v-cntxt-obj-code )
     2479                   v-obj-list = substitute( "&1,&2", v-cntxt-obj-type, v-cntxt-obj-code )
     2480               .
     2481           end.
     2482       end case.
     2483       run get-shift-on in this-procedure (
     2484             input integer( rs-1 :screen-value )
     2485           , input v-obj-list
     2486           , output v-shift-on
     2487       ).
     2488       if v-shift-on = ?
     2489       then do:
     2490           message
     2491                    "Неверно выбраны объекты. Все выбранные объекты"
     2492               skip "должны быть либо сменными, либо не сменными."
     2493           view-as alert-box information.
     2494           hide
     2495               fi-shift-num-from
     2496               fi-shift-num-to
     2497           .
     2498       end.
     2499       else do:
     2500           if v-shift-on = yes
     2501           then do:
     2502               assign
     2503                   date_from :label = "Смена с"
     2504               .
     2505               view
     2506                   fi-shift-num-from
     2507                   fi-shift-num-to
     2508               .
     2509               display
     2510                   fi-shift-num-from
     2511                   fi-shift-num-to
     2512               .
     2513           end.
     2514           else do:
     2515               assign
     2516                   date_from :label = "Дата с"
     2517               .
     2518               hide
     2519                   fi-shift-num-from
     2520                   fi-shift-num-to
     2521               .
     2522           end.
     2523       end.
     2524   end.
     2525   END PROCEDURE.
     2526   PROCEDURE read-parameters :
     2527   define input parameter p-cur-date           as date             no-undo.
     2528   define input parameter p-default-host-code  as integer          no-undo.
     2529   define output parameter p-date-from         as date             no-undo.
     2530   define output parameter p-date-to           as date             no-undo.
     2531   define output parameter p-shift-num-from    as integer          no-undo.
     2532   define output parameter p-shift-num-to      as integer          no-undo.
     2533   define output parameter p-range             as integer          no-undo.
     2534   define output parameter p-host-code         as integer          no-undo.
     2535   define output parameter p-obj-list          as character        no-undo.
     2536   define output parameter p-doc-type-list     as character        no-undo.
     2537   define output parameter p-pay-code          as logical          no-undo.
     2538   define output parameter p-cst               as logical          no-undo.
     2539   define output parameter p-parts             as logical          no-undo.
     2540   define output parameter p-chk-pay-code      as logical          no-undo.
     2541   define output parameter p-pay-desk          as logical          no-undo.
     2542   define output parameter p-pay-desk-cards    as logical          no-undo.
     2543   define output parameter p-deleted           as logical          no-undo.
     2544   define output parameter p-chk               as logical          no-undo.
     2545   define output parameter p-doc-rvs           as logical          no-undo.
     2546       define variable v-parameters-string as character    no-undo.
     2547       define variable v-temp-date         as date         no-undo.
     2548       define variable v-temp-integer      as integer      no-undo.
     2549       define variable v-temp-logical      as logical      no-undo.
     2550       define buffer buf_usr-flt       for ubflt.usr-flt.
     2551   do
     2552   for buf_usr-flt
     2553   on error undo, return error
     2554   :
     2555       assign
     2556           p-date-from         = p-cur-date
     2557           p-date-to           = p-cur-date
     2558           p-shift-num-from    = 1
     2559           p-shift-num-to      = 1
     2560           p-range             = 2
     2561           p-host-code         = p-default-host-code
     2562           p-pay-code          = no
     2563           p-cst               = no
     2564           p-parts             = no
     2565           p-chk-pay-code      = no
     2566           p-pay-desk          = no
     2567           p-pay-desk-cards    = no
     2568           p-deleted           = no
     2569           p-chk               = no
     2570           p-doc-rvs           = no
     2571       .
     2572       assign
     2573           p-obj-list          = "":U
     2574           p-doc-type-list     = "":U
     2575       .
     2576       find first buf_usr-flt no-lock
     2577            where buf_usr-flt.user-name  = v-cntxt-userid
     2578              and buf_usr-flt.call-point = "bge-input-dialog-parameters":U
     2579       no-error.
     2580       if available buf_usr-flt
     2581       then do:
     2582           assign
     2583               v-parameters-string = buf_usr-flt.Naim
     2584           .
     2585           run assign-date    in this-procedure ( input 1 , input v-parameters-string, input p-cur-date            , output p-date-from        ).
     2586           run assign-date    in this-procedure ( input 2 , input v-parameters-string, input p-cur-date            , output p-date-to          ).
     2587           run assign-integer in this-procedure ( input 3 , input v-parameters-string, input 1                     , output p-shift-num-from   ).
     2588           run assign-integer in this-procedure ( input 4 , input v-parameters-string, input 1                     , output p-shift-num-to     ).
     2589           run assign-integer in this-procedure ( input 5 , input v-parameters-string, input 2                     , output p-range            ).
     2590           run assign-integer in this-procedure ( input 6 , input v-parameters-string, input p-default-host-code   , output p-host-code        ).
     2591           run assign-logical in this-procedure ( input 7 , input v-parameters-string, input no                    , output p-pay-code         ).
     2592           run assign-logical in this-procedure ( input 8 , input v-parameters-string, input no                    , output p-cst              ).
     2593           run assign-logical in this-procedure ( input 9 , input v-parameters-string, input no                    , output p-parts            ).
     2594           run assign-logical in this-procedure ( input 10, input v-parameters-string, input no                    , output p-chk-pay-code     ).
     2595           run assign-logical in this-procedure ( input 11, input v-parameters-string, input no                    , output p-pay-desk         ).
     2596           run assign-logical in this-procedure ( input 12, input v-parameters-string, input no                    , output p-pay-desk-cards   ).
     2597           run assign-logical in this-procedure ( input 13, input v-parameters-string, input no                    , output p-deleted          ).
     2598           run assign-logical in this-procedure ( input 14, input v-parameters-string, input no                    , output p-chk              ).
     2599           run assign-logical in this-procedure ( input 15, input v-parameters-string, input no                    , output p-doc-rvs          ).
     2600       end.
     2601       find first buf_usr-flt no-lock
     2602            where buf_usr-flt.user-name  = v-cntxt-userid
     2603              and buf_usr-flt.call-point = "bge-input-dialog-obj-list":U
     2604       no-error.
     2605       if available buf_usr-flt
     2606       then do:
     2607           assign
     2608               p-obj-list = buf_usr-flt.Naim
     2609           .
     2610       end.
     2611       find first buf_usr-flt no-lock
     2612            where buf_usr-flt.user-name  = v-cntxt-userid
     2613              and buf_usr-flt.call-point = "bge-input-dialog-doc-type-list":U
     2614       no-error.
     2615       if available buf_usr-flt
     2616       then do:
     2617           assign
     2618               p-doc-type-list = buf_usr-flt.Naim
     2619           .
     2620       end.
     2621   end.
     2622   END PROCEDURE.
     2623   PROCEDURE write-parameters :
     2624   define input parameter p-date-from         as date             no-undo.
     2625   define input parameter p-date-to           as date             no-undo.
     2626   define input parameter p-shift-num-from    as integer          no-undo.
     2627   define input parameter p-shift-num-to      as integer          no-undo.
     2628   define input parameter p-range             as integer          no-undo.
     2629   define input parameter p-host-code         as integer          no-undo.
     2630   define input parameter p-obj-list          as character        no-undo.
     2631   define input parameter p-doc-type-list     as character        no-undo.
     2632   define input parameter p-pay-code          as logical          no-undo.
     2633   define input parameter p-cst               as logical          no-undo.
     2634   define input parameter p-parts             as logical          no-undo.
     2635   define input parameter p-chk-pay-code      as logical          no-undo.
     2636   define input parameter p-pay-desk          as logical          no-undo.
     2637   define input parameter p-pay-desk-cards    as logical          no-undo.
     2638   define input parameter p-deleted           as logical          no-undo.
     2639   define input parameter p-chk               as logical          no-undo.
     2640   define input parameter p-doc-rvs           as logical          no-undo.
     2641       define variable v-parameters-string as character    no-undo.
     2642       define buffer buf_usr-flt       for ubflt.usr-flt.
     2643   do
     2644   for buf_usr-flt
     2645   on error undo, return error
     2646   :
     2647       assign
     2648           v-parameters-string = substitute( "&1,&2,&3,&4,&5,&6,&7,&8"
     2649                                           , p-date-from
     2650                                           , p-date-to
     2651                                           , p-shift-num-from
     2652                                           , p-shift-num-to
     2653                                           , p-range
     2654                                           , p-host-code
     2655                                           , p-pay-code
     2656                                           , p-cst )
     2657       .
     2658       assign
     2659           v-parameters-string = substitute( "&1,&2,&3,&4,&5,&6,&7,&8"
     2660                                           , v-parameters-string
     2661                                           , p-parts
     2662                                           , p-chk-pay-code
     2663                                           , p-pay-desk
     2664                                           , p-pay-desk-cards
     2665                                           , p-deleted
     2666                                           , p-chk
     2667                                           , p-doc-rvs     )
     2668       .
     2669       find first buf_usr-flt exclusive-lock
     2670            where buf_usr-flt.user-name  = v-cntxt-userid
     2671              and buf_usr-flt.call-point = "bge-input-dialog-parameters":U
     2672       no-error.
     2673       if not available buf_usr-flt
     2674       then do:
     2675           create buf_usr-flt.
     2676           assign
     2677               buf_usr-flt.user-name  = v-cntxt-userid
     2678               buf_usr-flt.call-point = "bge-input-dialog-parameters":U
     2679           .
     2680       end.
     2681       assign
     2682           buf_usr-flt.Naim = v-parameters-string
     2683       .
     2684       find first buf_usr-flt exclusive-lock
     2685            where buf_usr-flt.user-name  = v-cntxt-userid
     2686              and buf_usr-flt.call-point = "bge-input-dialog-obj-list":U
     2687       no-error.
     2688       if not available buf_usr-flt
     2689       then do:
     2690           create buf_usr-flt.
     2691           assign
     2692               buf_usr-flt.user-name  = v-cntxt-userid
     2693               buf_usr-flt.call-point = "bge-input-dialog-obj-list":U
     2694           .
     2695       end.
     2696       assign
     2697           buf_usr-flt.Naim = p-obj-list
     2698       .
     2699       find first buf_usr-flt exclusive-lock
     2700            where buf_usr-flt.user-name  = v-cntxt-userid
     2701              and buf_usr-flt.call-point = "bge-input-dialog-doc-type-list":U
     2702       no-error.
     2703       if not available buf_usr-flt
     2704       then do:
     2705           create buf_usr-flt.
     2706           assign
     2707               buf_usr-flt.user-name  = v-cntxt-userid
     2708               buf_usr-flt.call-point = "bge-input-dialog-doc-type-list":U
     2709           .
     2710       end.
     2711       assign
     2712           buf_usr-flt.Naim = p-doc-type-list
     2713       .
     2714   end.
     2715   END PROCEDURE.
