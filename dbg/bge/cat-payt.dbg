      877   define variable v-bge-xml-shift-mode    as logical           no-undo.
      878   define variable v-bge-xml-bgeflnm-doc   as character         no-undo.
      879   define variable v-bge-xml-bgeflnm-day   as character         no-undo.
      880   define variable v-bge-xml-log-file-name as character    no-undo.
      881   define variable v-bge-xml-dbf-file-name as character    no-undo.
      882   define variable v-bge-xml-db-num-str    as character    no-undo .
      883   define variable v-bge-xml-static-log-file-name as character    no-undo.
