        1   block-level on error undo, throw.
        2   define input parameter p-rec-amount as integer      no-undo.
        3   define input parameter p-rec-list   as character    no-undo.
        4   define input parameter p-host-code  as integer      no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: cat-payt.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: bge/cat-payt.p $":U .
       10   define variable vss-description as character no-undo init "Выгрузка справочника видов оплат".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define variable vss-include-info0 as character format "X(65)" no-undo
       70   initial "@(#)$Workfile$ $Revision$".
       71   DEF STREAM stmXMLOut.
       72   DEF STREAM stmXMLLog.
       73   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       74   procedure cur-time :
       75      define output parameter p-today as date      no-undo .
       76      define output parameter p-time  as integer   no-undo .
       77     do
       78     on error undo, return error
       79     :
       80       define variable v-date1 as date      no-undo .
       81       define variable v-date2 as date      no-undo .
       82       define variable v-time  as integer   no-undo .
       83       assign
       84         v-date1 = today
       85         v-time  = time
       86         v-date2 = today
       87       .
       88       if v-date1 <> v-date2
       89       then do:
       90         assign
       91           v-date1 = today
       92           v-time  = v-time
       93         .
       94       end.
       95       assign
       96         p-today = v-date1
       97         p-time  = v-time
       98       .
       99     end.
      100   end.
      101   function cur-time-date returns character
      102   :
      103     return string(today, '99/99/9999':U) .
      104   end.
      105   function cur-time-mjd returns decimal
      106   :
      107     define variable v-date as date      no-undo .
      108     define variable v-time as integer   no-undo .
      109     run cur-time in this-procedure
      110       (output v-date
      111       ,output v-time
      112       ) .
      113     return integer(v-date) - 2400002 + (v-time / 86400) .
      114   end.
      115   function cur-time-get-ending-index returns integer
      116   (input p-number as integer
      117   )
      118   :
      119     if p-number < 0
      120     or p-number = ?
      121     then do:
      122       return 1 .
      123     end.
      124     define variable v-rest as integer   no-undo .
      125     assign
      126       p-number = p-number modulo 100
      127     .
      128     if p-number < 20
      129     then do:
      130       assign
      131         v-rest = p-number
      132       .
      133     end.
      134     else do:
      135       assign
      136         v-rest = p-number modulo 10
      137       .
      138     end.
      139     case v-rest :
      140       when 1
      141       then do:
      142         return 2 .
      143       end.
      144       when 2 or
      145       when 3 or
      146       when 4
      147       then do:
      148         return 3 .
      149       end.
      150       otherwise do:
      151         return 1 .
      152       end.
      153     end case .
      154   end.
      155   procedure cur-time-mjd-to-date :
      156      define input  parameter i-mjd-diff as decimal no-undo.
      157      define output parameter o-Date     as date    no-undo.
      158      define output parameter o-Time     as integer no-undo.
      159      define variable v-day-number as integer   no-undo .
      160      if    i-mjd-diff < 0
      161         or i-mjd-diff = ?
      162      then do:
      163         return "?" .
      164      end.
      165      assign
      166         v-day-number = truncate(i-mjd-diff,0).
      167         o-Date = date(v-day-number + 2400002).
      168         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      169     .
      170   end.
      171   function cur-time-mjd-to-string returns character
      172   (input p-mjd-diff as decimal
      173   )
      174   :
      175     define variable v-day-number as integer   no-undo .
      176     define variable v-seconds    as integer   no-undo .
      177     define variable v-hour       as integer   no-undo .
      178     define variable v-min        as integer   no-undo .
      179     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      180     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      181     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      182     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      183     if p-mjd-diff < 0
      184     or p-mjd-diff = ?
      185     then do:
      186       return "?" .
      187     end.
      188     assign
      189       v-day-number = integer(truncate(p-mjd-diff,0))
      190       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      191     .
      192     if v-seconds > 86400
      193     then do:
      194       assign
      195         v-seconds = 86400 - 1
      196       .
      197     end.
      198     if v-seconds < 0
      199     then do:
      200       assign
      201         v-seconds = 0
      202       .
      203     end.
      204     assign
      205       v-hour = truncate(v-seconds / 3600, 0)
      206     .
      207     assign
      208       v-seconds = v-seconds modulo 3600
      209     .
      210     assign
      211       v-min = truncate(v-seconds / 60, 0)
      212     .
      213     assign
      214       v-seconds = v-seconds modulo 60
      215     .
      216     return
      217         (if v-day-number <> 0
      218           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      219           else ""
      220         )
      221       + (if v-day-number <> 0 or v-hour <> 0
      222           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      223           else ""
      224         )
      225       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      226           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      227           else ""
      228         )
      229       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      230       .
      231   end.
      232   function cur-time-string returns character
      233   :
      234     define variable v-date as date      no-undo .
      235     define variable v-time as integer   no-undo .
      236     run cur-time in this-procedure
      237       (output v-date
      238       ,output v-time
      239       ) .
      240     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      241   end.
      242   function cur-time-string-sec returns character
      243   :
      244     define variable v-date as date      no-undo .
      245     define variable v-time as integer   no-undo .
      246     run cur-time in this-procedure
      247       (output v-date
      248       ,output v-time
      249       ) .
      250     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      251   end.
      252   function cur-time-custom  returns character
      253   (input p-prefix as character
      254   ,input p-date-format as character
      255   ,input p-delimiter as character
      256   ,input p-time-format as character
      257   ,input p-suffix as character
      258   )
      259   :
      260     define variable v-date as date      no-undo .
      261     define variable v-time as integer   no-undo .
      262     run cur-time in this-procedure
      263       (output v-date
      264       ,output v-time
      265       ) .
      266     return
      267       p-prefix
      268       + string(v-date, p-date-format)
      269       + p-delimiter
      270       + string(v-time, p-time-format)
      271       + p-suffix
      272       .
      273   end.
      274   function cur-time-print  returns character
      275   :
      276     define variable v-date as date      no-undo .
      277     define variable v-time as integer   no-undo .
      278     run cur-time in this-procedure
      279       (output v-date
      280       ,output v-time
      281       ) .
      282     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      283   end.
      284   function cur-time-datetime returns datetime
      285   :
      286     define variable v-char as character no-undo .
      287     define variable v-datetime as datetime no-undo .
      288     v-char = cur-time-string().
      289     v-datetime = datetime(v-char).
      290     return  v-datetime.
      291   end.
      292   function cur-time-string-msec returns character
      293   :
      294     define variable v-date as datetime  no-undo .
      295     v-date = now.
      296     return string(v-date) .
      297   end.
      298   define variable vss-include-info2 as character format "X(65)" no-undo
      299   initial "@(#)$Workfile$ $Revision$".
      300   procedure xmlchar-test :
      301   define input parameter p-in-string          as character        no-undo.
      302   define output parameter p-out-string-enc    as character        no-undo.
      303   define output parameter p-out-string-dec    as character        no-undo.
      304   do
      305   on error undo, return error
      306   :
      307          run xmlchar-encode in this-procedure
      308       (
      309             input p-in-string
      310           , output p-out-string-enc
      311       ).
      312          run xmlchar-decode in this-procedure
      313       (
      314             input p-out-string-enc
      315           , output p-out-string-dec
      316       ).
      317   end.
      318   end .
      319   procedure xmlchar-encode :
      320   define input parameter p-in-string      as character        no-undo.
      321   define output parameter p-out-string    as character        no-undo.
      322       define variable v-position      as integer      no-undo.
      323       define variable v-current-char  as character    no-undo.
      324   do
      325   on error undo, return error
      326   :
      327       assign
      328           p-out-string = "":U
      329       .
      330       case p-in-string
      331       :
      332           when ?
      333           then do:
      334               assign
      335                   p-out-string = "?":U
      336               .
      337           end.
      338           when "?":U
      339           then do:
      340               assign
      341                   p-out-string = "&#63;":U
      342               .
      343           end.
      344           otherwise do:
      345               do v-position = 1 to length( p-in-string )
      346               :
      347                   assign
      348                       v-current-char = substring( p-in-string, v-position, 1 )
      349                   .
      350                   case v-current-char
      351                   :
      352                       when "&":U
      353                       then do:
      354                           assign
      355                               p-out-string = p-out-string + "&amp;":U
      356                           .
      357                       end.
      358                       when ">":U
      359                       then do:
      360                           assign
      361                               p-out-string = p-out-string + "&gt;":U
      362                           .
      363                       end.
      364                       when "<":U
      365                       then do:
      366                           assign
      367                               p-out-string = p-out-string + "&lt;":U
      368                           .
      369                       end.
      370                       when "'":U
      371                       then do:
      372                           assign
      373                               p-out-string = p-out-string + "&apos;":U
      374                           .
      375                       end.
      376                       when '"':U
      377                       then do:
      378                           assign
      379                               p-out-string = p-out-string + "&quot;":U
      380                           .
      381                       end.
      382                       when chr(1)
      383                       then do:
      384                           assign
      385                               p-out-string = p-out-string + "":U
      386                           .
      387                       end.
      388                       when chr(2)
      389                       then do:
      390                           assign
      391                               p-out-string = p-out-string + "":U
      392                           .
      393                       end.
      394                       when chr(3)
      395                       then do:
      396                           assign
      397                               p-out-string = p-out-string + "":U
      398                           .
      399                       end.
      400                       when chr(4)
      401                       then do:
      402                           assign
      403                               p-out-string = p-out-string + "":U
      404                           .
      405                       end.
      406                       when chr(5)
      407                       then do:
      408                           assign
      409                               p-out-string = p-out-string + "":U
      410                           .
      411                       end.
      412                       when chr(6)
      413                       then do:
      414                           assign
      415                               p-out-string = p-out-string + "":U
      416                           .
      417                       end.
      418                       when chr(7)
      419                       then do:
      420                           assign
      421                               p-out-string = p-out-string + "":U
      422                           .
      423                       end.
      424                       when chr(8)
      425                       then do:
      426                           assign
      427                               p-out-string = p-out-string + "":U
      428                           .
      429                       end.
      430                       when chr(9)
      431                       then do:
      432                           assign
      433                               p-out-string = p-out-string + "":U
      434                           .
      435                       end.
      436                       when chr(29)
      437                       then do:
      438                           assign
      439                               p-out-string = p-out-string + "":U
      440                           .
      441                       end.
      442                       when chr(10)
      443                       then do:
      444                           assign
      445                               p-out-string = p-out-string + "&#10;":U
      446                           .
      447                       end.
      448                       when chr(13)
      449                       then do:
      450                           assign
      451                               p-out-string = p-out-string + "&#13;":U
      452                           .
      453                       end.
      454                       otherwise do:
      455                           assign
      456                               p-out-string = p-out-string + v-current-char
      457                           .
      458                       end.
      459                   end case.
      460               end.
      461           end.
      462       end case.
      463   end.
      464   end .
      465   procedure xmlchar-encode-1c :
