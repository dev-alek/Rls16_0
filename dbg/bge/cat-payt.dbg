      575   procedure xmlchar-decode :
      576   define input parameter p-in-string      as character        no-undo.
      577   define output parameter p-out-string    as character        no-undo.
      578       define variable v-position      as integer      no-undo.
      579       define variable v-last-position as integer      no-undo.
      580       define variable v-temp-integer  as integer      no-undo.
      581       define variable v-current-char  as character    no-undo.
      582       define variable v-next-char     as character    no-undo.
      583       define variable v-success       as logical      no-undo.
      584   do
      585   on error undo, return error
      586   :
      587       assign
      588           p-out-string = "":U
      589           v-position   = 0
      590       .
      591       replace-cycle:
      592       do while yes
      593       on error undo, return error
      594       :
      595           assign
      596               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      597           .
      598           if v-last-position <= v-position
      599           then do:
      600               if v-position = 0
      601               then do:
      602                   assign
      603                       p-out-string = p-in-string
      604                   .
      605               end.
      606               else do:
      607                   assign
      608                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      609                   .
      610               end.
      611               leave replace-cycle.
      612           end.
      613           else do:
      614               assign
      615                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      616                   v-position      = v-last-position
      617                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      618               .
      619               if v-current-char = "#":U
      620               then do:
      621                   assign
      622                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      623                   .
      624                   if v-last-position > 0
      625                   then do:
      626                       run xmlchar-read-integer in this-procedure
      627                        (
      628                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      629                           , output v-temp-integer
      630                           , output v-success
      631                       ).
      632                       if v-success = yes
      633                       and v-temp-integer >= 1
      634                       and v-temp-integer <= 255
      635                       then do:
      636                           assign
      637                               p-out-string = p-out-string + chr( v-temp-integer )
      638                               v-position   = v-last-position + 1
      639                           .
      640                       end.
      641                       else do:
      642                           assign
      643                               p-out-string = p-out-string + "&":U
      644                               v-position   = v-position   + 1
      645                           .
      646                       end.
      647                   end.
      648                   else do:
      649                       assign
      650                           p-out-string = p-out-string + "&":U
      651                           v-position   = v-position   + 1
      652                       .
      653                   end.
      654               end.
      655               else do:
      656                   case substring( p-in-string, v-position + 1, 3 )
      657                   :
      658                       when "lt;":U
      659                       then do:
      660                           assign
      661                               p-out-string = p-out-string + "<":U
      662                               v-position   = v-position   + 3
      663                           .
      664                       end.
      665                       when "gt;":U
      666                       then do:
      667                           assign
      668                               p-out-string = p-out-string + ">":U
      669                               v-position   = v-position   + 3
      670                           .
      671                       end.
      672                       otherwise do:
      673                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      674                           then do:
      675                               assign
      676                                   p-out-string = p-out-string + "&":U
      677                                   v-position   = v-position   + 4
      678                               .
      679                           end.
      680                           else do:
      681                               case substring( p-in-string, v-position + 1, 5 )
      682                               :
      683                                   when "quot;":U
      684                                   then do:
      685                                       assign
      686                                           p-out-string = p-out-string + '"':U
      687                                           v-position   = v-position   + 5
      688                                       .
      689                                   end.
      690                                   when "apos;":U
      691                                   then do:
      692                                       assign
      693                                           p-out-string = p-out-string + "'":U
      694                                           v-position   = v-position   + 5
      695                                       .
      696                                   end.
      697                                   otherwise do:
      698                                       assign
      699                                           p-out-string = p-out-string + "&":U
      700                                       .
      701                                   end.
      702                               end case.
      703                           end.
      704                       end.
      705                   end case.
      706               end.
      707           end.
      708       end.
      709   end.
      710   end .
      711   procedure xmlchar-read-integer :
      712   define input parameter p-input-string      as character        no-undo.
      713   define output parameter p-output-integer   as integer          no-undo.
      714   define output parameter p-success       as logical          no-undo.
      715   do
      716   on error undo, return error
      717   :
      718       assign
      719           p-output-integer = integer( p-input-string )
      720       no-error.
      721       if error-status :error
      722       then do:
      723           assign
      724               p-success           = no
      725               p-output-integer    = 0
      726           .
      727       end.
      728       else do:
      729           assign
      730               p-success           = yes
      731           .
      732       end.
      733   end.
      734   end.
      735   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      736   procedure strtdate :
      737     define input  parameter p-str         as character no-undo .
      738     define output parameter p-value       as date      no-undo .
      739     define output parameter p-data-valid  as logical   no-undo .
      740     define output parameter p-message     as character no-undo .
      741   do
      742   on error undo, return error return-value
      743   :
      744     define variable v-value       as date      no-undo .
      745     define variable v-i           as integer   no-undo .
      746     define variable v-num         as integer   no-undo .
      747     define variable v-delim       as character no-undo .
      748     define variable v-delim-list  as character no-undo .
      749     define variable v-day         as integer   no-undo .
      750     define variable v-month       as integer   no-undo .
      751     define variable v-year        as integer   no-undo .
      752     define variable v-day-str     as character no-undo .
      753     define variable v-month-str   as character no-undo .
      754     define variable v-year-str    as character no-undo .
      755     assign
      756       p-value       = ?
      757       p-data-valid  = false
      758     .
      759     if p-str = ?
      760     then do:
      761       assign
      762         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      763       .
      764       return .
      765     end.
      766     if p-str = ""
      767     then do:
      768       assign
      769         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      770       .
      771       return .
      772     end.
      773     if length(p-str)  > 10
      774     then do:
      775       assign
      776         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      777       .
      778       return .
      779     end.
      780     assign
      781       v-delim-list = '/,-,.':U
      782     .
      783     _delim:
      784     do v-i = 1 to num-entries( v-delim-list )
      785     :
      786       assign
      787         v-delim = entry( v-i , v-delim-list )
      788         v-num   = num-entries( p-str , v-delim )
      789       .
      790       if v-num <> 3
      791       then do:
      792         assign
      793           v-delim = ''
      794         .
      795       end.
      796       else do:
      797         leave _delim.
      798       end.
      799     end.
      800     if v-delim = ''
      801     then do:
      802       assign
      803         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      804       .
      805       return .
      806     end.
      807     assign
      808       v-day-str   = entry( 1, p-str , v-delim)
      809       v-month-str = entry( 2, p-str , v-delim)
      810       v-year-str  = entry( 3, p-str , v-delim)
      811     .
      812     if  length(v-day-str) > 2   or
      813         length(v-day-str) < 1   or
      814         length(v-month-str) > 2 or
      815         length(v-month-str) < 1 or
      816         (
      817           length(v-year-str) <> 2 and
      818           length(v-year-str) <> 4
      819         )
      820     then do:
      821       assign
      822         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      823       .
      824       return .
      825     end.
      826     if length( v-year-str ) = 2
      827     then do:
      828       assign
      829         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      830       .
      831     end.
      832     assign
      833       v-day   = integer( v-day-str )
      834       v-month = integer( v-month-str)
      835       v-year  = integer( v-year-str)
      836     no-error .
      837     if error-status :error
      838     then do:
      839       assign
      840         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      841       .
      842       return .
      843     end.
      844     if v-day < 1  or
      845        v-day > 31 or
      846        v-month < 1 or
      847        v-month > 12 or
      848        v-year < 0   or
      849        v-year > 5000
      850     then do:
      851       assign
      852         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      853       .
      854       return .
      855     end.
      856     assign
      857       v-value = date( v-month, v-day, v-year )
      858     no-error .
      859     if error-status :error
      860     then do:
      861       assign
      862         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      863       .
      864       return .
      865     end.
      866     assign
      867       p-value       = v-value
      868       p-data-valid  = true
      869     .
      870   end.
      871   end procedure.
      872   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      873   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
