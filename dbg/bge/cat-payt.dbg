      972   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
      973                                             INPUT iFlagEmpty AS INTEGER).
      974       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
      975       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
      976           DO:
      977               IF iFlagEmpty = 0                           THEN RETURN "".
      978               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
      979               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
      980               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
      981               ELSE RETURN "".
      982           END.
      983       ELSE DO:
      984           run xmlchar-encode in this-procedure (
      985                 input sToPlace
      986               , output sToPlace
      987           ).
      988           ASSIGN
      989               sToPlace = sParName + '="' + sToPlace + '"'
      990           .
      991           RETURN sToPlace.
      992       END.
      993   END FUNCTION.
      994   function bge-xml-date returns character
      995   ( input p-date as date )
      996   :
      997     define variable v-date-str as character no-undo .
      998     run bge-xml-date-to-str in this-procedure ( input   p-date
      999                                               , output  v-date-str
     1000                                               ) .
     1001     return v-date-str.
     1002   end function.
     1003   function bge-xml-str-date returns character
     1004   ( input p-date-str as character )
     1005   :
     1006     define variable v-date-str as character no-undo .
     1007     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1008                                                   , output  v-date-str
     1009                                                   ) .
     1010     return v-date-str.
     1011   end function.
     1012   function bge-xml-normalize-dec returns decimal
     1013   ( input p-val as decimal )
     1014   :
     1015     return (if p-val = ? then 0 else p-val) .
     1016   end function.
     1017   PROCEDURE wp-XMLTagOpen:
     1018   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1019   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1020   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1021       define variable v-out-string    as character    no-undo.
     1022   do
     1023   on error undo, return error
     1024   :
     1025       if v-bge-xml-bgefmt = "dbf":U
     1026       then do:
     1027       end.
     1028       else do:
     1029           assign
     1030               v-out-string = substitute( "&1&2<&3&4>"
     1031                                       , chr(10)
     1032                                       , fill( " ":U, 4 * iTagLevel)
     1033                                       , sTagName
     1034                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1035                               )
     1036           .
     1037           put stream stmXMLOut unformatted
     1038               v-out-string
     1039           .
     1040       end.
     1041   end.
     1042   END PROCEDURE.
     1043   PROCEDURE wp-XMLTagPut:
     1044     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1045     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1046     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1047     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1048       define variable v-out-string    as character    no-undo.
     1049   do
     1050   on error undo, return error
     1051   :
     1052       if v-bge-xml-bgefmt = "dbf":U
     1053       then do:
     1054           if v-bge-xml-dbf-file-name <> "":U
     1055           then do:
     1056               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1057               export stream stmXMLOut
     1058                   sTagName
     1059                   sParValue
     1060               .
     1061               output stream stmXMLOut close.
     1062           end.
     1063       end.
     1064       else do:
     1065           IF  iFlagEmpty = 1
     1066           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1067           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1068           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1069           THEN DO:
     1070               run xmlchar-encode in this-procedure (
     1071                   input sParValue
     1072                   , output sParValue
     1073               ).
     1074               assign
     1075                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1076                                               , chr(10)
     1077                                               , FILL(" ", 4 * iTagLevel)
     1078                                               , sTagName
     1079                                               , sParValue
     1080                               )
     1081               .
     1082               PUT STREAM stmXMLOut UNFORMATTED
     1083                   v-out-string
     1084               .
     1085           END.
     1086       end.
     1087   end.
     1088   END PROCEDURE.
     1089   PROCEDURE wp-XMLTagClose:
     1090   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1091   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1092       define variable v-out-string    as character    no-undo.
     1093   do
     1094   on error undo, return error
     1095   :
     1096       if v-bge-xml-bgefmt = "dbf":U
     1097       then do:
     1098       end.
     1099       else do:
     1100           assign
     1101               v-out-string = substitute( "&1&2</&3>"
     1102                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1103                                   , fill( " ", 4 * iTagLevel )
     1104                                   , sTagName
     1105                           )
     1106           .
     1107           PUT STREAM stmXMLOut UNFORMATTED
     1108               v-out-string
     1109           .
     1110       end.
     1111   end.
     1112   END PROCEDURE.
     1113   PROCEDURE wp-XMLWriteLog:
     1114     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1115     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1116     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1117   define variable v-str              as character no-undo .
     1118   define variable v-error-append     as logical   no-undo .
     1119   define variable v-error-append-msg as character no-undo .
     1120   assign
     1121     v-str = chr(10)
     1122             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1123             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1124     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1125     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1126     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1127   .
     1128   run bge/bge-log.p (input v-str) no-error .
     1129   if error-status:error then do:
     1130     assign
     1131       v-error-append     = yes
     1132       v-error-append-msg = return-value
     1133     .
     1134   end.
     1135   run gbl/fileapnd.p
     1136     ( input sFileName
     1137     , input v-str
     1138     , input 10
     1139     ) no-error .
     1140   if error-status:error then do:
     1141     assign
     1142       v-error-append     = yes
     1143       v-error-append-msg = substitute( "&1&2&3"
     1144                                       , v-error-append-msg
     1145                                       , chr(10)
     1146                                       , return-value
     1147                                       )
     1148     .
     1149   end.
     1150   if v-error-append
     1151   then do:
     1152     return error substitute( "&1" , v-error-append-msg ) .
     1153   end.
     1154   END PROCEDURE.
     1155   PROCEDURE wp-XMLWriteEDT:
     1156     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1157     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1158     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1159       if valid-handle ( hEDT )
     1160       then do:
     1161           hEDT :move-to-eof().
     1162           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1163                                           OR sToWrite = "&Line") THEN "" ELSE
     1164                                           cur-time-string-sec() + " ").
     1165           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1166                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1167                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1168           hEDT :insert-string(chr(10)).
     1169       end.
     1170       process events.
     1171       output to 'bgescn.txt' append.
     1172           put unformatted
     1173               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1174                                           OR sToWrite = "&Line") THEN "" ELSE
     1175                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1176               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1177                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1178                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1179           .
     1180       output close.
     1181   END PROCEDURE.
     1182   PROCEDURE wp-XMLShowCNT:
     1183     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1184       if valid-handle( hCNT )
     1185       then do:
     1186           ASSIGN hCNT :VISIBLE = TRUE.
     1187       end.
     1188   END PROCEDURE.
     1189   PROCEDURE wp-XMLHideCNT:
     1190     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1191       if valid-handle( hCNT )
     1192       then do:
     1193           ASSIGN hCNT :VISIBLE = FALSE.
     1194       end.
     1195   END PROCEDURE.
     1196   PROCEDURE wp-XMLWriteCNT:
     1197     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1198     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1199       if valid-handle( hCNT )
     1200       then do:
     1201           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1202       end.
     1203   END PROCEDURE.
     1204   procedure bge-xml-write-header:
     1205   do
     1206   on error undo, return error
     1207   :
     1208   define input parameter p-xml-file-name  as character        no-undo.
     1209   define input parameter p-doc-name       as character        no-undo.
     1210   define input parameter p-version        as character        no-undo.
     1211   define input parameter p-db-num         as integer          no-undo.
     1212   define input parameter p-date-from      as date             no-undo.
     1213   define input parameter p-shift-num-from as integer          no-undo.
     1214   define input parameter p-date-to        as date             no-undo.
     1215   define input parameter p-shift-num-to   as integer          no-undo.
     1216   define input parameter p-obj-list       as character        no-undo.
     1217   define input parameter p-doc-type-list  as character        no-undo.
     1218   define input parameter p-pay-code       as logical          no-undo.
     1219   define input parameter p-cst            as logical          no-undo.
     1220   define input parameter p-parts          as logical          no-undo.
     1221   define input parameter p-chk-pay-code   as logical          no-undo.
     1222   define input parameter p-pay-desk       as logical          no-undo.
     1223   define input parameter p-pay-desk-cards as logical          no-undo.
     1224   define input parameter p-deleted        as logical          no-undo.
     1225   define input parameter p-opened-docs    as logical          no-undo.
     1226   define variable v-out-string    as character    no-undo.
     1227   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1228   assign
     1229       v-out-string = substitute( "&1&2&3"
     1230                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1231                           , chr(10)
     1232                           , "<IBS_Trade_House>":U )
     1233   .
     1234   put stream stmXMLOut unformatted
     1235       v-out-string
     1236   .
     1237   run wp-XMLTagOpen(1, "header","").
     1238   if v-bge-xml-bgeflold = "oracle":u
     1239   then do:
     1240     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1241     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1242     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1243     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1244     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1245   end.
     1246   run wp-XMLTagOpen( 2, "manifest", "").
     1247   run wp-XMLTagOpen( 3, "document", "").
     1248   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1249   run wp-XMLTagput( 4, "description", "", 0).
     1250   run wp-XMLTagput( 4, "version", p-version, 0).
     1251   run wp-XMLTagclose( 3, "document" ).
     1252   run wp-XMLTagclose( 2, "manifest" ).
     1253   run wp-XMLTagclose( 1, "header" ).
     1254   run wp-XMLTagOpen(1, "options","").
     1255   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1256   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1257   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1258   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1259   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1260   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1261   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1262   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1263   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1264   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1265   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1266   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1267   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1268   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1269   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1270   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1271   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1272   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1273   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1274   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1275   run wp-XMLTagClose(1, "options").
     1276   run wp-XMLTagOpen( 1, "body", "" ).
     1277   output stream stmXMLOut close.
     1278   end.
     1279   end procedure.
     1280   procedure xml-bge-write-footer:
     1281   do
     1282   on error undo, return error return-value
     1283   :
     1284   define input parameter p-xml-file-name as character    no-undo.
     1285   define variable v-error-num     as integer           no-undo.
     1286   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1287   run wp-XMLTagClose( 1, "body" ).
     1288   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1289   output stream stmXMLOut close.
     1290   if v-bge-xml-bgeflold = "oracle":u
     1291   then do:
     1292     define variable v-tmp-file-name         as character no-undo .
     1293     define variable v-zip-file-name         as character no-undo .
     1294     define variable v-exch-file-name        as character no-undo .
     1295     define variable v-heap-file-name        as character no-undo .
     1296     define variable v-i                     as integer   no-undo .
     1297     define variable v-file-name             as character no-undo .
     1298     define variable v-arc                   as character no-undo .
     1299     define variable v-str                   as character no-undo .
     1300     define variable v-exch-tmp-file-name    as character no-undo .
     1301     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1302     define variable v-bge-xml-exch-dir      as character no-undo .
     1303     define variable v-bge-xml-heap-dir      as character no-undo .
     1304     define variable v-bge-xml-compress-heap as logical   no-undo .
     1305     define variable v-home-dir              as character no-undo .
     1306     define variable v-os-command            as character no-undo .
     1307     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1308     if v-home-dir = ?
     1309     then do:
     1310       undo, return error substitute( "&1&2&3"
     1311                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1312                                     , chr(10)
     1313                                     , "Обратитесь к администратору.":u
     1314                                     ).
     1315     end.
     1316     assign
     1317       v-home-dir = v-home-dir
     1318     .
     1319     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1320     if error-status :error
     1321     then do:
     1322       undo, return error substitute( "&1&2&3"
     1323                                     , "Неверно задан каталог экспорта.":u
     1324                                     , chr(10)
     1325                                     , "Обратитесь к администратору.":u
     1326                                     ).
     1327     end.
     1328     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1329     if v-bge-xml-exch-dir = ?
     1330     then do:
     1331       undo, return error substitute( "&1&2&3"
     1332                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1333                                     , chr(10)
     1334                                     , "Обратитесь к администратору.":u
     1335                                     ).
     1336     end.
     1337     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1338     if error-status :error
     1339     then do:
     1340       undo, return error substitute( "&1&2&3"
     1341                                     , "Неверно задан каталог экспорта (exch).":u
     1342                                     , chr(10)
     1343                                     , "Обратитесь к администратору.":u
     1344                                     ).
     1345     end.
     1346     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1347     if v-bge-xml-heap-dir = ?
     1348     then do:
     1349       undo, return error substitute( "&1&2&3"
     1350                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1351                                     , chr(10)
     1352                                     , "Обратитесь к администратору.":u
     1353                                     ).
     1354     end.
     1355     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1356     if error-status :error
     1357     then do:
     1358       undo, return error substitute( "&1&2&3"
     1359                                     , "Неверно задан каталог экспорта (heap).":u
     1360                                     , chr(10)
     1361                                     , "Обратитесь к администратору.":u
     1362                                     ).
     1363     end.
     1364     get-key-value section "BGE" key "heap-compress" value v-str.
     1365     assign
     1366       v-i = int(v-str)
     1367     no-error .
     1368     if v-i = ? or v-i = 0
     1369     then do:
     1370       assign
     1371         v-bge-xml-compress-heap = no
     1372       .
     1373     end.
     1374     else do:
     1375       assign
     1376         v-bge-xml-compress-heap = yes
     1377       .
     1378     end.
     1379     assign
     1380       v-arc = search( "exe/7za.exe":u )
     1381     .
     1382     if v-arc = ? or v-arc = ""
     1383     then do:
     1384       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1385     end.
     1386     assign
     1387       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1388       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1389       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1390       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1391       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1392       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1393       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1394     .
     1395     run gbl/del-file.p (input v-tmp-file-name) .
     1396     run gbl/del-file.p (input v-zip-file-name) .
     1397     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1398     if v-error-num > 0
     1399     then do:
     1400         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1401                                      , p-xml-file-name + "xm1":u
     1402                                      , v-tmp-file-name
     1403                                      , v-error-num
     1404                                      ).
     1405     end.
     1406     assign
     1407       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1408                                    , v-arc
     1409                                    , v-zip-file-name
     1410                                    , v-tmp-file-name
     1411                                    )
     1412     .
     1413     os-command silent value ( v-os-command ) .
     1414     run gbl/del-file.p (input v-heap-file-name) .
     1415     if v-bge-xml-compress-heap = no
     1416     then do:
     1417       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1418       if v-error-num > 0
     1419       then do:
     1420           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1421                                        , v-tmp-file-name
     1422                                        , v-heap-file-name
     1423                                        , v-error-num
     1424                                        ) .
     1425       end.
     1426     end.
     1427     else do:
     1428       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1429       if v-error-num > 0
     1430       then do:
     1431           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1432                                        , v-zip-file-name
     1433                                        , v-heap-file-name
     1434                                        , v-error-num
     1435                                        ) .
     1436       end.
     1437     end.
     1438     run gbl/del-file.p (input v-tmp-file-name) .
     1439     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1440     if error-status :error then do:
     1441       undo, return error substitute( "&1&2&3"
     1442                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1443                                     , chr(10)
     1444                                     , "Обратитесь к администратору."
     1445                                     ).
     1446     end.
     1447     run gbl/del-file.p (input v-exch-file-name) .
     1448     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1449     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1450     if v-error-num > 0
     1451     then do:
     1452       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1453                                     , v-zip-file-name
     1454                                     , v-exch-tmp-file-name
     1455                                     , v-error-num
     1456                                     ) .
     1457     end.
     1458     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1459     if v-error-num > 0
     1460     then do:
     1461       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1462                                     , v-exch-tmp-file-name
     1463                                     , v-exch-file-name
     1464                                     , v-error-num
     1465                                     ) .
     1466     end.
     1467     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1468   end.
     1469   else do:
     1470     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1471     if v-error-num > 0
     1472     then do:
     1473       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1474                                     , p-xml-file-name + "xm1"
     1475                                     , p-xml-file-name + "xml"
     1476                                     , v-error-num
     1477                                     ) .
     1478     end.
     1479   end.
     1480   if opsys = "unix"
     1481   then do:
     1482       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1483   end.
     1484   end.
     1485   end procedure.
     1486   procedure xml-bge-filename0:
     1487   define input parameter p-prefix   as character no-undo .
     1488   define input parameter p-name     as character no-undo .
     1489   define input parameter p-shared-process as logical no-undo .
     1490   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1491   define output parameter p-xml-file-name  as character no-undo .
     1492   // define output parameter p-fullfnamenoext as character no-undo .
     1493   define output parameter p-locked         as logical      no-undo.
     1494   define variable v-fullfnamenoext as character no-undo .
     1495   define variable v-fileext        as character no-undo .
     1496   define variable v-fullfname      as character no-undo .
     1497   define variable v-error-num      as integer   no-undo .
     1498   do
     1499   on error undo, return error
     1500   :
     1501     case v-bge-xml-bgeflold :
     1502       when "old" then do:
     1503         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1504         v-fileext       = ".xml":U .
     1505         v-fullfname     = v-fullfnamenoext + v-fileext .
     1506         p-xml-file-name = v-fullfname .
     1507         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1508         if v-error-num > 0 then do:
     1509           return error.
     1510         end.
     1511       end.
     1512       when "var" then do:
     1513         case p-prefix :
     1514           when "doc" then do:
     1515             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1516             v-fileext       = ".xml":U .
     1517             v-fullfname     = v-fullfnamenoext + v-fileext .
     1518             p-xml-file-name = v-fullfname .
     1519           end.
     1520           when "day" then do:
     1521             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1522             v-fileext       = ".xml":U .
     1523             v-fullfname     = v-fullfnamenoext + v-fileext .
     1524             p-xml-file-name = v-fullfname .
     1525           end.
     1526           otherwise do:
     1527             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1528             v-fileext       = ".xml":U .
     1529             v-fullfname     = v-fullfnamenoext + v-fileext .
     1530             p-xml-file-name = v-fullfname .
     1531           end.
     1532         end case.
     1533         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1534         if v-error-num > 0 then do:
     1535           return error.
     1536         end.
     1537       end.
     1538       when "new" then do:
     1539                   run bge/genfname.p (
     1540                       input p-home-dir
     1541                       , input p-prefix
     1542                       , input ""
     1543                       , input "xml"
     1544                       , input ""
     1545                       , output p-xml-file-name
     1546                   ).
     1547       end.
     1548       when "no-parameter" then do:
     1549         if p-shared-process then do:
     1550                       run bge/genfname.p (
     1551                           input p-home-dir
     1552                           , input "d"
     1553                           , input ""
     1554                           , input "xml"
     1555                           , input ""
     1556                           , output p-xml-file-name
     1557                       ).
     1558         end.
     1559         else do:
     1560           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1561           v-fileext       = ".xml":U .
     1562           v-fullfname     = v-fullfnamenoext + v-fileext .
     1563           p-xml-file-name = v-fullfname .
     1564           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1565           if v-error-num > 0 then do:
     1566             return error.
     1567           end.
     1568         end.
     1569       end.
     1570     end case.
     1571     assign
     1572       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1573       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1574     .
     1575   end .
     1576   end procedure .
     1577   procedure xml-bge-filename :
     1578   do
     1579   on error undo, return error
     1580   :
     1581   define input parameter p-prefix             as character    no-undo.
     1582   define input parameter p-name               as character    no-undo.
     1583   define input parameter p-shared-process     as logical      no-undo.
     1584   define output parameter p-xml-file-name     as character    no-undo.
     1585   define output parameter p-log-file-name     as character    no-undo.
     1586   define output parameter p-locked            as logical      no-undo.
     1587   define variable v-home-dir          as character no-undo .
     1588   define variable v-error-num         as integer   no-undo .
     1589   define variable v-bge-xml-heap-dir  as character no-undo .
     1590       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1591       if v-home-dir = ?
     1592       then do:
     1593           message
     1594             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1595             skip(1)
     1596             skip "Обратитесь к администратору."
     1597           view-as alert-box error.
     1598           undo, return error .
     1599       end.
     1600       if v-bge-xml-bgeflold <> "oracle"
     1601       then do:
     1602         assign
     1603             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1604         .
     1605       end.
     1606       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1607       if error-status :error
     1608       then do:
     1609           message
     1610             skip "Неверно задан каталог экспорта."
     1611             skip(1)
     1612             skip "Обратитесь к администратору."
     1613           view-as alert-box error.
     1614           undo, return error .
     1615       end.
     1616       if v-bge-xml-bgefmt = "dbf":U
     1617       then do:
     1618           assign
     1619               p-xml-file-name = v-home-dir
     1620               p-locked        = no
     1621           .
     1622       end.
     1623       else do:
     1624           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1625             output p-xml-file-name, output p-locked) .
     1626       end.
     1627       if v-bge-xml-bgeflold = "oracle"
     1628       then do:
     1629         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1630         if v-bge-xml-heap-dir = ?
     1631         then do:
     1632           undo, return error substitute( "&1&2&3"
     1633                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1634                                         , chr(10)
     1635                                         , "Обратитесь к администратору.":u
     1636                                         ).
     1637         end.
     1638         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1639         if error-status :error
     1640         then do:
     1641           undo, return error substitute( "&1&2&3"
     1642                                         , "Неверно задан каталог экспорта (heap).":u
     1643                                         , chr(10)
     1644                                         , "Обратитесь к администратору.":u
     1645                                         ).
     1646         end.
     1647         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1648           assign
     1649             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1650           .
     1651         end.
     1652         else do:
     1653           assign
     1654             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1655           .
     1656         end.
     1657       end.
     1658       else do:
     1659         assign
     1660             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1661         .
     1662       end.
     1663       assign
     1664          v-bge-xml-static-log-file-name = p-log-file-name
     1665       .
     1666   end.
     1667   end procedure.
     1668   procedure bge-xml-read-config :
     1669   do
     1670   on error undo, return error return-value
     1671   :
     1672   define input  parameter p-last-date as date      no-undo .
     1673   define input  parameter p-db-num    as integer   no-undo .
     1674       define variable v-bgeclall      as character     no-undo.
     1675       define variable v-bgedict       as character     no-undo.
     1676       define variable v-bgeshift      as character     no-undo.
     1677       define variable v-par-type      as character     no-undo.
     1678       define variable v-bgeflnm       as character     no-undo.
     1679       define variable v-bgecliiv      as character     no-undo .
     1680       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1681       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1682       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1683       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1684       define variable v-db-num-str    as character     no-undo .
     1685       define variable v-param-type      as character  no-undo .
     1686       define variable v-value-character as character  no-undo .
     1687       define variable v-value-date      as date       no-undo .
     1688       define variable v-value-decimal   as decimal    no-undo .
     1689       define variable v-value-integer   as integer    no-undo .
     1690       define variable v-value-logical   as logical    no-undo .
     1691       define variable v-tth             as handle      no-undo .
     1692       run adm/shattri.p ( input "get":U
     1693                         , input  '':u
     1694                         , input  0
     1695                         , input  'bge-export':U
     1696                         , input  'bgeclall':U
     1697                         , output v-bgecliiv
     1698                         , output v-value-date
     1699                         , output v-value-decimal
     1700                         , output v-value-integer
     1701                         , output v-value-logical
     1702                         , output v-param-type
     1703                         , input-output table-handle v-tth
     1704                         ) no-error .
     1705       if error-status :error
     1706       then do:
     1707         assign
     1708           v-bge-xml-bgecliiv = no
     1709         .
     1710       end.
     1711       else do:
     1712         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1713       end.
     1714       delete object v-tth.
     1715       assign
     1716           v-bge-xml-bgeclall = no
     1717           v-bge-xml-bgedict  = no
     1718       .
     1719       run adm/shattri.p ( input "get":U
     1720                         , input  '':u
     1721                         , input  0
     1722                         , input  'bge-export':U
     1723                         , input  'bgeclall':U
     1724                         , output v-value-character
     1725                         , output v-value-date
     1726                         , output v-value-decimal
     1727                         , output v-value-integer
     1728                         , output v-value-logical
     1729                         , output v-param-type
     1730                         , input-output table-handle v-tth
     1731                         ) no-error .
     1732       if error-status :error
     1733       then do:
     1734         assign
     1735           v-bge-xml-bgeclall = no
     1736         .
     1737       end.
     1738       else do:
     1739         assign
     1740           v-bge-xml-bgeclall = v-value-logical
     1741         .
     1742       end.
     1743       delete object v-tth.
     1744       run adm/shattri.p ( input "get":U
     1745                         , input  '':u
     1746                         , input  0
     1747                         , input  'bge-export':U
     1748                         , input  'bgedict':U
     1749                         , output v-value-character
     1750                         , output v-value-date
     1751                         , output v-value-decimal
     1752                         , output v-value-integer
     1753                         , output v-value-logical
     1754                         , output v-param-type
     1755                         , input-output table-handle v-tth
     1756                         ) no-error .
     1757       if error-status :error
     1758       then do:
     1759         assign
     1760           v-bge-xml-bgedict = no
     1761         .
     1762       end.
     1763       else do:
     1764         assign
     1765           v-bge-xml-bgedict = v-value-logical
     1766         .
     1767       end.
     1768       delete object v-tth.
     1769       run adm/shattri.p ( input "get":U
     1770                         , input  '':u
     1771                         , input  0
     1772                         , input  'bge-export':U
     1773                         , input  'bgefmt':U
     1774                         , output v-value-character
     1775                         , output v-value-date
     1776                         , output v-value-decimal
     1777                         , output v-value-integer
     1778                         , output v-value-logical
     1779                         , output v-param-type
     1780                         , input-output table-handle v-tth
     1781                         ) no-error .
     1782       if error-status :error
     1783       then do:
     1784         assign
     1785           v-bge-xml-bgefmt  = "xml":U
     1786         .
     1787       end.
     1788       else do:
     1789         assign
     1790           v-bge-xml-bgefmt  = v-value-character
     1791         .
     1792       end.
     1793       delete object v-tth.
     1794       run adm/shattri.p ( input "get":U
     1795                         , input  '':u
     1796                         , input  0
     1797                         , input  'bge-export':U
     1798                         , input  'bgeshift':U
     1799                         , output v-value-character
     1800                         , output v-value-date
     1801                         , output v-value-decimal
     1802                         , output v-value-integer
     1803                         , output v-value-logical
     1804                         , output v-param-type
     1805                         , input-output table-handle v-tth
     1806                         ) no-error .
     1807       if error-status :error
     1808       then do:
     1809         assign
     1810             v-bge-xml-shift-mode = no
     1811         .
     1812       end.
     1813       else do:
     1814         assign
     1815             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1816         .
     1817       end.
     1818       delete object v-tth.
     1819       run adm/shattri.p ( input "get":U
     1820                         , input  '':u
     1821                         , input  0
     1822                         , input  'bge-export':U
     1823                         , input  'bgeflold':U
     1824                         , output v-value-character
     1825                         , output v-value-date
     1826                         , output v-value-decimal
     1827                         , output v-value-integer
     1828                         , output v-value-logical
     1829                         , output v-param-type
     1830                         , input-output table-handle v-tth
     1831                         ) no-error .
     1832       if error-status :error
     1833       then do:
     1834         assign
     1835           v-bge-xml-bgeflold = "no-parameter":U
     1836         .
     1837       end.
     1838       else do:
     1839         assign
     1840           v-bge-xml-bgeflold  = v-value-character
     1841         .
     1842       end.
     1843       delete object v-tth.
     1844       assign
     1845         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1846         v-bge-xml-db-num-str  = v-db-num-str
     1847       .
     1848       if p-last-date <> ?
     1849       then do:
     1850           run adm/shattri.p ( input "get":U
     1851                             , input  '':u
     1852                             , input  0
     1853                             , input  'bge-export':U
     1854                             , input  'bgeflnm':U
     1855                             , output v-value-character
     1856                             , output v-value-date
     1857                             , output v-value-decimal
     1858                             , output v-value-integer
     1859                             , output v-value-logical
     1860                             , output v-param-type
     1861                             , input-output table-handle v-tth
     1862                             ) no-error .
     1863           if error-status :error
     1864           then do:
     1865             assign
     1866               v-bgeflnm = '':U
     1867             .
     1868           end.
     1869           else do:
     1870             assign
     1871               v-bgeflnm = v-value-character
     1872             .
     1873           end.
     1874           delete object v-tth.
     1875           if v-bge-xml-bgeflold = "var"
     1876           then do:
     1877               if v-bgeflnm = ?
     1878               or num-entries( v-bgeflnm ) < 2
     1879               then do:
     1880                   assign
     1881                       v-bge-xml-bgeflold = "new"
     1882                   .
     1883               end.
     1884               else do:
     1885                   assign
     1886                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1887                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1888                   .
     1889                   assign
     1890                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1891                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1892                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1893                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1894                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1895                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1896                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1897                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1898                   .
     1899               end.
     1900           end.
     1901       end.
     1902   end.
     1903   end procedure.
     1904   procedure bge-xml-get-ref-filename :
     1905   define input parameter p-in-file-name       as character        no-undo.
     1906   define output parameter p-home-dir          as character        no-undo.
     1907   define output parameter p-out-file-name     as character        no-undo.
     1908   define output parameter p-locked            as logical          no-undo.
     1909       define variable v-counter       as integer      no-undo.
     1910       define variable v-error-level   as integer      no-undo.
     1911   do
     1912   on error undo, return error
     1913   :
     1914       run bge/bge-ini.p (
     1915             input "bge"
     1916           , output p-home-dir
     1917       ).
     1918       if return-value <> "OK"
     1919       then do:
     1920           undo, return error.
     1921       end.
     1922       assign
     1923           p-home-dir = p-home-dir + "\dict":U
     1924       .
     1925       run bge/dir_cd.p (
     1926           input p-home-dir
     1927           , input "CA"
     1928       ).
     1929       if return-value = "ERROR"
     1930       then do:
     1931           undo, return error.
     1932       end.
     1933       assign
     1934           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     1935       .
     1936       assign
     1937           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     1938       .
     1939       wait-lock:
     1940       do v-counter = 1 TO 3
     1941       :
     1942           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     1943           if p-locked = no
     1944           then do:
     1945               leave wait-lock.
     1946           end.
     1947           else do:
     1948               readkey pause 1.
     1949           end.
     1950       END.
     1951       if p-locked = yes
     1952       then do:
     1953           undo, return error.
     1954       end.
     1955       run bge/os_copy.p (
     1956             input "D":U
     1957           , input p-out-file-name + "xml":U
     1958           , input "":U
     1959           , output v-error-level
     1960       ).
     1961       if v-error-level > 0
     1962       then do:
     1963           undo, return error.
     1964       end.
     1965   end.
     1966   end procedure.
     1967   procedure bge-xml-write-ref-header :
     1968   define input parameter p-bge-name as character        no-undo.
     1969   define input parameter p-file-name as character        no-undo.
     1970       define variable v-out-string    as character    no-undo.
     1971   do
     1972   on error undo, return error
     1973   :
     1974       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     1975       put stream stmXMLOut unformatted
     1976           "<?xml version='1.0' encoding='windows-1251'?>":U
     1977       .
     1978       assign
     1979           v-out-string = substitute( "&1&2"
     1980                               , chr(10)
     1981                               , "<IBS_Trade_House>":U )
     1982       .
     1983       put stream stmXMLOut unformatted
     1984           v-out-string
     1985       .
     1986       run wp-XMLTagOpen( 1, "header", "" ).
     1987       if v-bge-xml-bgeflold = "oracle":u
     1988       then do:
     1989         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1990         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1991         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1992         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1993         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1994       end.
     1995       else do:
     1996         run wp-XMLTagOpen( 2, "delivery", "" ).
     1997         run wp-XMLTagOpen( 3, "to", "" ).
     1998         run wp-XMLTagClose( 3, "to" ).
     1999         run wp-XMLTagOpen( 3, "from", "" ).
     2000         run wp-XMLTagClose( 3, "from" ).
     2001         run wp-XMLTagClose( 2, "delivery" ).
     2002       end.
     2003       run wp-XMLTagOpen( 2, "manifest", "" ).
     2004       run wp-XMLTagOpen( 3, "document", "" ).
     2005       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2006       run wp-XMLTagPut( 4, "description", "", 0 ).
     2007       run wp-XMLTagClose( 3, "document" ).
     2008       run wp-XMLTagClose( 2, "manifest" ).
     2009       run wp-XMLTagClose( 1, "header" ).
     2010       run wp-XMLTagOpen( 1, "body", "" ).
     2011   end.
     2012   end procedure.
     2013   procedure bge-xml-write-ref-footer :
     2014   define input parameter p-file-name as character        no-undo.
     2015       define variable v-error-level   as integer      no-undo.
     2016   do
     2017   on error undo, return error
     2018   :
     2019       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2020       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2021       output stream stmXMLOut close.
     2022       run bge/os_copy.p (
     2023             input "M":U
     2024           , input p-file-name + "xm1":U
     2025           , input p-file-name + "xml":U
     2026           , output v-error-level
     2027       ).
     2028       if v-error-level > 0
     2029       then do:
     2030           undo, return error.
     2031       end.
     2032   end.
     2033   end procedure.
     2034   procedure bge-xml-out-dir :
     2035   define output parameter p-out-dir       as character    no-undo.
     2036   define output parameter p-log-file-name as character    no-undo.
     2037   do
     2038   on error undo, return error
     2039   :
     2040       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2041       if p-out-dir = ?
     2042       then do:
     2043           message
     2044             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2045                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2046             skip(1)
     2047             skip "Обратитесь к администратору."
     2048           view-as alert-box error.
     2049           undo, return error .
     2050       end.
     2051       if v-bge-xml-bgeflold <> "oracle" then assign
     2052         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2053       .
     2054       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2055       if error-status :error  then do:
     2056           run wp-XMLWriteLog in this-procedure (
     2057                 input p-log-file-name
     2058               , input 0
     2059               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2060                                   , p-out-dir
     2061                                   , return-value
     2062                                   , trim( error-status :get-message( 1 ) )
     2063                                   )
     2064           ).
     2065           undo, return error.
     2066       end.
     2067       assign
     2068           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2069           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2070       .
     2071   end.
     2072   end procedure.
     2073   procedure bge-xml-out-dir2 :
     2074   define output parameter p-out-dir       as character    no-undo.
     2075   define output parameter p-out-dirR      as character    no-undo.
     2076   define output parameter p-log-file-name as character    no-undo.
     2077   do
     2078   on error undo, return error
     2079   :
     2080       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2081       if p-out-dir = ?
     2082       then do:
     2083           message
     2084             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2085                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2086             skip(1)
     2087             skip "Обратитесь к администратору."
     2088           view-as alert-box error.
     2089           undo, return error .
     2090       end.
     2091       if v-bge-xml-bgeflold <> "oracle" then assign
     2092             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2093             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2094         .
     2095       else p-out-dirR = p-out-dir .
     2096       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2097       if error-status :error  then do:
     2098           run wp-XMLWriteLog in this-procedure (
     2099                 input p-log-file-name
     2100               , input 0
     2101               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2102                                   , p-out-dir
     2103                                   , return-value
     2104                                   , error-status :get-message( 1 )
     2105                                   )
     2106           ).
     2107           undo, return error.
     2108       end.
     2109       if p-out-dirR <> p-out-dir then do:
     2110         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2111         if error-status :error then do:
     2112           run wp-XMLWriteLog in this-procedure (
     2113                 input p-log-file-name
     2114               , input 0
     2115               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2116                                   , p-out-dirR
     2117                                   , return-value
     2118                                   , error-status :get-message( 1 )
     2119                                   )
     2120           ).
     2121           p-out-dirR = p-out-dir .
     2122         end.
     2123       end .
     2124       assign
     2125         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2126         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2127       .
     2128   end.
     2129   end procedure.
     2130   procedure bge-xml-out-file :
     2131   do
     2132   on error undo, return error
     2133   :
     2134   define input parameter p-out-dir            as character        no-undo.
     2135   define input parameter p-prefix             as character        no-undo.
     2136   define input parameter p-sheduled           as logical          no-undo.
     2137   define output parameter p-xml-file-name     as character        no-undo.
     2138   define output parameter p-locked            as logical          no-undo.
     2139   define variable v-home-dir      as character     no-undo.
     2140   define variable v-error-num     as integer       no-undo.
     2141   define variable v-today             as date         no-undo.
     2142   define variable v-time              as integer      no-undo.
     2143       if v-bge-xml-bgefmt = "dbf":U
     2144       then do:
     2145           assign
     2146               p-xml-file-name = p-out-dir
     2147               p-locked        = no
     2148           .
     2149       end.
     2150       else do:
     2151           if v-bge-xml-bgeflold = "firm":U
     2152           then do:
     2153               run bge/genfname.p (
     2154                     input p-out-dir
     2155                   , input p-prefix
     2156                   , input "":U
     2157                   , input "arj":U
     2158                   , input "":U
     2159                   , output p-xml-file-name
     2160               ).
     2161           end.
     2162           else do:
     2163               run bge/genfname.p (
     2164                     input p-out-dir
     2165                   , input p-prefix
     2166                   , input "":U
     2167                   , input "xml":U
     2168                   , input "":U
     2169                   , output p-xml-file-name
     2170               ).
     2171           end.
     2172           assign
     2173               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2174               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2175           .
     2176       end.
     2177   end.
     2178   end procedure.
     2179   procedure bge-xml-init-ext-doc-type :
     2180       define variable v-counter    as integer      no-undo.
     2181       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2182   do
     2183   for buf_temp_ext-doc-type
     2184   on error undo, return error
     2185   :
     2186       empty temp-table buf_temp_ext-doc-type.
     2187       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2188       :
     2189           create buf_temp_ext-doc-type.
     2190           assign
     2191               buf_temp_ext-doc-type.edt-key               = v-counter
     2192               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2193               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2194           .
     2195       end.
     2196   end.
     2197   end procedure.
     2198   procedure bge-xml-get-decimal-shift-num :
     2199   define input parameter p-shift-date     as date             no-undo.
     2200   define input parameter p-shift-num      as integer          no-undo.
     2201   define output parameter p-shift-decimal as decimal          no-undo.
     2202   do
     2203   on error undo, return error
     2204   :
     2205       assign
     2206           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2207       .
     2208   end.
     2209   end procedure.
     2210   procedure bge-xml-ora-exp-filename :
     2211     define input  parameter p-table-name  as character no-undo .
     2212     define input  parameter p-doc-code    as character no-undo .
     2213     define input  parameter p-obj-code    as integer   no-undo .
     2214     define output parameter p-filename    as character no-undo .
     2215     define output parameter p-seq-num     as integer   no-undo .
     2216     define variable v-ora-exp-seq     as integer   no-undo .
     2217     define variable v-ora-exp-seq-str as character no-undo .
     2218     define variable v-home-dir        as character no-undo.
     2219   do
     2220   on error undo, return error return-value
     2221   :
     2222     if v-bge-xml-bgeflold = "oracle":u
     2223     then do:
     2224       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2225       if v-home-dir = ?
     2226       then do:
     2227         undo, return error substitute( "&1&2&3":U
     2228                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2229                                       , chr(10)
     2230                                       , "Обратитесь к администратору.":U
     2231                                       ).
     2232       end.
     2233       assign
     2234           v-home-dir = v-home-dir
     2235       .
     2236       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2237       if error-status :error
     2238       then do:
     2239         undo, return error substitute( "&1&2&3":U
     2240                                       , "Неверно задан каталог экспорта.":U
     2241                                       , chr(10)
     2242                                       , "Обратитесь к администратору.":U
     2243                                       ).
     2244       end.
     2245       assign
     2246         v-ora-exp-seq = ?
     2247       .
     2248       if  p-table-name <> ? and
     2249           p-doc-code <> ?
     2250       then do:
     2251         run bge/get-oesq.p ( input p-table-name
     2252                            , input p-doc-code
     2253                            , output v-ora-exp-seq
     2254                            ) no-error .
     2255         if error-status :error = yes
     2256         then do:
     2257           undo, return error return-value .
     2258         end.
     2259       end.
     2260       if v-ora-exp-seq = ?
     2261       then do:
     2262         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2263         if error-status :error
     2264         then do:
     2265           undo, return error return-value .
     2266         end.
     2267       end.
     2268       if p-table-name <> ? and
     2269          p-doc-code   <> ?
     2270       then do:
     2271         run bge/oesqdoc.p ( input p-table-name
     2272                           , input p-doc-code
     2273                           , input v-ora-exp-seq
     2274                           ) no-error .
     2275         if error-status :error = yes
     2276         then do:
     2277           undo, return error return-value .
     2278         end.
     2279       end.
     2280       assign
     2281         p-seq-num  = v-ora-exp-seq
     2282         p-filename = substitute("&1/&2-000_&3."
     2283                                , v-home-dir
     2284                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2285                                , string(v-ora-exp-seq , "999999999")
     2286                                )
     2287       .
     2288     end.
     2289   end.
     2290   end procedure.
     2291   procedure bge-xml-date-to-str :
     2292     define input  parameter p-date  as date      no-undo .
     2293     define output parameter p-str   as character no-undo .
     2294   do
     2295   on error undo, return error return-value
     2296   :
     2297     if p-date <> ?
     2298     then do:
     2299       assign
     2300         p-str = substitute( "&1-&2-&3"
     2301                           , string( year(p-date)  , "9999")
     2302                           , string( month(p-date) , "99"  )
     2303                           , string( day(p-date)   , "99"  )
     2304                           )
     2305       .
     2306     end.
     2307     else do:
     2308       assign
     2309         p-str = ?
     2310       .
     2311     end.
     2312   end.
     2313   end procedure.
     2314   procedure bge-xml-date-str-to-str :
     2315     define input  parameter p-date-str  as character no-undo .
     2316     define output parameter p-str       as character no-undo .
     2317     define variable v-date          as date      no-undo .
     2318     define variable v-date-valid    as logical   no-undo .
     2319     define variable v-error-message as character no-undo .
     2320   do
     2321   on error undo, return error return-value
     2322   :
     2323     assign
     2324       p-str = ?
     2325     .
     2326     if p-date-str = ? or p-date-str = ""
     2327     then do:
     2328       return .
     2329     end.
     2330     run strtdate in this-procedure ( input  p-date-str
     2331                                    , output v-date
     2332                                    , output v-date-valid
     2333                                    , output v-error-message
     2334                                    ).
     2335     if v-date-valid <> true
     2336     then do:
     2337       return .
     2338     end.
     2339     assign
     2340       p-str = substitute( "&1-&2-&3"
     2341                         , string( year(v-date)  , "9999")
     2342                         , string( month(v-date) , "99"  )
     2343                         , string( day(v-date)   , "99"  )
     2344                         )
     2345     .
     2346   end.
     2347   end procedure.
     2348   procedure bge-xml-fill-tt-bgecliiv :
     2349     define input  parameter p-str as character no-undo .
     2350     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2351     define buffer buf_clients             for ub.clients.
     2352     define variable v-i         as integer   no-undo .
     2353     define variable v-count     as integer   no-undo .
     2354     define variable v-cli-count as integer   no-undo .
     2355     define variable v-client    as character no-undo .
     2356     define variable v-obj-type  as character no-undo .
     2357     define variable v-obj-code  as integer   no-undo .
     2358   do
     2359   on error undo, return error return-value
     2360   :
     2361     empty temp-table buf_tt-bge-xml-bgecliiv.
     2362     assign
     2363       v-bge-xml-bgecliiv = no
     2364       v-cli-count        = num-entries(p-str,';')
     2365     .
     2366     if v-cli-count > 0
     2367     then do:
     2368       _cli-cycle:
     2369       do v-i = 1 to v-cli-count
     2370       :
     2371         assign
     2372           v-client = entry(v-i , p-str, ';')
     2373         .
     2374         if num-entries(v-client) <> 2
     2375         then do:
     2376           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2377         end.
     2378         assign
     2379           v-obj-type = entry(1, v-client)
     2380         .
     2381         assign
     2382           v-obj-code = integer(entry(2, v-client))
     2383         no-error .
     2384         if error-status :error
     2385         then do:
     2386           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2387         end.
     2388         find first buf_clients no-lock
     2389           where buf_clients.obj-type = v-obj-type
     2390             and buf_clients.obj-code = v-obj-code
     2391         no-error.
     2392         if not available buf_clients
     2393         then do:
     2394           next _cli-cycle.
     2395         end.
     2396         find first buf_tt-bge-xml-bgecliiv no-lock
     2397           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2398             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2399         no-error .
     2400         if available buf_tt-bge-xml-bgecliiv
     2401         then do:
     2402           next _cli-cycle.
     2403         end.
     2404         create buf_tt-bge-xml-bgecliiv.
     2405         assign
     2406           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2407           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2408         .
     2409       end.
     2410     end.
     2411     else do:
     2412       assign
     2413         v-bge-xml-bgecliiv = no
     2414       .
     2415       return .
     2416     end.
     2417     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2418     if available buf_tt-bge-xml-bgecliiv
     2419     then do:
     2420       assign
     2421         v-bge-xml-bgecliiv = yes
     2422       .
     2423     end.
     2424   end.
     2425   end procedure.
     2426   procedure bge-xml-resolve-ext-doc-type :
     2427     define input  parameter p-ext-doc-type      as character no-undo .
     2428     define input  parameter p-obj-type          as character no-undo .
     2429     define input  parameter p-obj-code          as integer   no-undo .
     2430     define output parameter p-out-ext-doc-type  as character no-undo .
     2431     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2432   do
     2433   on error undo, return error return-value
     2434   :
     2435     assign
     2436       p-out-ext-doc-type = p-ext-doc-type
     2437     .
     2438     if p-ext-doc-type <> 'ie':U
     2439     then do:
     2440       return .
     2441     end.
     2442     if v-bge-xml-bgecliiv = yes
     2443     then do:
     2444       find first buf_tt-bge-xml-bgecliiv no-lock
     2445         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2446           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2447       no-error .
     2448       if available buf_tt-bge-xml-bgecliiv
     2449       then do:
     2450         assign
     2451           p-out-ext-doc-type = 'iv':U
     2452         .
     2453       end.
     2454     end.
     2455   end.
     2456   end procedure.
     2457   procedure safe-wp-xmltagput :
     2458     define input  parameter pTagLevel   as integer   no-undo .
     2459     define input  parameter pTagName    as character no-undo .
     2460     define input  parameter pParValue   as character no-undo .
     2461     define input  parameter pFlagEmpty  as integer   no-undo .
     2462   do
     2463   on error undo, return error return-value
     2464   :
     2465     if v-bge-xml-bgeflold = "oracle":u
     2466     then do:
     2467       return .
     2468     end.
     2469     run wp-xmltagput in this-procedure ( input pTagLevel
     2470                                        , input pTagName
     2471                                        , input pParValue
     2472                                        , input pFlagEmpty
     2473                                        ).
     2474   end.
     2475   end procedure.
     2476   do
     2477   on error undo, return error
     2478   :
     2479       define variable v-xml-file-name     as character            no-undo.
     2480       define variable v-log-file-name     as character            no-undo.
     2481       define buffer buf_pay-type      for ub.pay-type.
     2482       run bge/bge-head.p (
     2483             input "dict"
     2484           , input "paytype"
     2485           , input "XML - Вывод справочника видов оплат"
     2486           , input no
     2487           , output v-xml-file-name
     2488           , output v-log-file-name
     2489       ) no-error.
     2490       if error-status :error
     2491       then do:
     2492           message
     2493           vss-workfile vss-revision vss-description
     2494           skip "Ошибка при создании файла выгрузки."
     2495           skip return-value
     2496           skip trim(error-status :get-message(1))
     2497               trim(error-status :get-message(2))
     2498               trim(error-status :get-message(3))
     2499           view-as alert-box error.
     2500           undo, return error .
     2501       end.
     2502       run bge-xml-write-header in this-procedure (
     2503             input v-xml-file-name
     2504           , input "paytype"
     2505           , input "15.0 " + replace( vss-revision + vss-date, "$", " " )
     2506           , input 0
     2507           , input ?
     2508           , input 0
     2509           , input ?
     2510           , input 0
     2511           , input "":U
     2512           , input "":U
     2513           , input no
     2514           , input no
     2515           , input no
     2516           , input no
     2517           , input no
     2518           , input no
     2519           , input no
     2520           , input no
     2521       ).
     2522       output stream stmxmlout to value( v-xml-file-name + "xm1" ) convert target "1251" append.
     2523       for each buf_pay-type no-lock
     2524       :
     2525           run write-body in this-procedure (
     2526                 input buf_pay-type.obj-code
     2527               , input v-xml-file-name
     2528               , input v-log-file-name
     2529           ) no-error.
     2530           if error-status :error
     2531           then do:
     2532               run wp-XMLWriteLog(
     2533                     input v-log-file-name
     2534                   , input 1
     2535                   , input substitute(  "*** ERR: *** Ошибка выгрузки вида оплаты с кодом &1. &2. &3.", buf_pay-type.obj-code, trim(error-status :get-message(1)), trim(error-status :get-message(2)) )
     2536               ).
     2537           end.
     2538       end.
     2539       output stream stmxmlout close.
     2540       run xml-bge-write-footer in this-procedure (
     2541           input v-xml-file-name
     2542       ).
     2543   end.
     2544   procedure write-body :
     2545   do
     2546   on error undo, return error
     2547   :
     2548   define input parameter p-obj-code       as integer      no-undo.
     2549   define input parameter p-xml-file-name  as character    no-undo.
     2550   define input parameter p-log-file-name  as character    no-undo.
     2551       define buffer buf_pay-type      for ub.pay-type.
     2552       find first buf_pay-type no-lock
     2553            where buf_pay-type.obj-code = p-obj-code
     2554       .
     2555   run wp-XMLTagOpen( input 2, input "paytype", input "").
     2556   run wp-XMLTagPut( input 3, "payTypeID"      , input string( buf_pay-type.obj-code ), input 0 ).
     2557   run wp-XMLTagPut( input 3, "name"           , input string( buf_pay-type.obj-name ), input 0 ).
     2558   run wp-XMLTagClose( input 2, input "paytype" ).
     2559   end.
     2560   end procedure.
