        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: $":U.
        3   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U.
        4   define variable vss-date        as character no-undo init "$Date: $":U.
        5   define variable vss-workfile    as character no-undo init "$Workfile: bge-active-vbrr-shd.p $":U.
        6   define variable vss-archive     as character no-undo init "$Archive: bge/bge-active-vbrr-shd.p $":U.
        7   define variable vss-description as character no-undo init "Процедура запуска автоматической выгрузки информации по пополнениям и активации для сверки с ВБРР".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define input parameter parparentproc as widget-handle no-undo.
       67   define input parameter p_parent-handle as widget-handle no-undo.
       68   define input parameter p_log-handle as handle no-undo.
       69   define input parameter p_db-num-char as character no-undo.
       70   define input parameter p_task-type as character no-undo.
       71   define input parameter p_task-num as integer no-undo.
       72   define input parameter p_db-num as integer no-undo.
       73   define variable p-date-to    as date      no-undo.
       74   define variable p-date-from  as date      no-undo.
       75   define variable p-gds-inf-po as integer   no-undo.
       76   define variable p-gds-active as integer   no-undo.
       77   define variable p-directory  as character no-undo.
       78   define variable p-code_pnpo  as character no-undo.
       79   define variable p-bge-active as logical   no-undo.
       80   define variable p-bge-inf-po as logical   no-undo.
       81   define variable p-per        as integer   no-undo.
       82   define variable v-obj-list   as char      no-undo.
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   define temp-table temp-schedule-free no-undo
       85   field free-id as character
       86   field free-task-name as character
       87   field proc-run-name as character
       88   field proc-param-edit-name as character
       89   field conf-param as character
       90   field is-gbd as logical
       91   field is-ubd as logical
       92   field enable-concurrent-0 as logical
       93   field enable-concurrent-db as logical
       94   field other-info as character
       95   field enc-key as character
       96   field is-rum as logical
       97   index pi is unique primary
       98   free-id.
       99   procedure schedule-attr-name :
      100   do
      101     on error undo, return error
      102     :
      103     define input  parameter p-code           as character no-undo .
      104     define output parameter p-type           as character no-undo .
      105     define output parameter p-format         as character no-undo .
      106     define output parameter p-label          as character no-undo .
      107     define output parameter p-user-can-edit  as logical   no-undo .
      108     define output parameter p-output-display as logical   no-undo .
      109     define output parameter p-other          as character no-undo .
      110       if index(p-code, chr(4)) > 0 then do:
      111         p-code = entry(1, p-code, chr(4)).
      112       end.
      113       case p-code :
      114               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      115               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      116               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      117               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      118               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      119               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      120               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      121               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      122               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      123         otherwise do:
      124           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      125         end.
      126       end.
      127     end.
      128   end procedure.
      129   procedure schedule-attr-tooltip :
      130   do
      131     on error undo, return error
      132     :
      133       define input  parameter p-code    as character no-undo .
      134       define output parameter p-tooltip as character no-undo .
      135       define output parameter p-label   as character no-undo .
      136       if index(p-code, chr(4)) > 0 then do:
      137         p-code = entry(1, p-code, chr(4)).
      138       end.
      139       case p-code :
      140               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      141               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      142               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      143               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      144               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      145               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      146               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      147               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      148               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      149         otherwise do:
      150               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      151         end.
      152       end.
      153     end.
      154   end procedure.
      155   procedure schedule-attr-value :
      156   do
      157   on error undo, return error return-value
      158   :
      159   define input parameter  p-cre-db-num as integer    no-undo.
      160   define input parameter  p-task-type  as character  no-undo.
      161   define input parameter  p-task-num   as integer    no-undo.
      162   define input parameter  p-code       as character  no-undo.
      163   define output parameter p-value      as character  no-undo.
      164   define output parameter p-type       as character  no-undo.
      165       define variable v-format         as character no-undo .
      166       define variable v-label          as character no-undo .
      167       define variable v-user-can-edit  as logical   no-undo .
      168       define variable v-output-display as logical   no-undo .
      169       define variable v-other          as character no-undo .
      170       define buffer buf_schedule-attr for ub.schedule-attr.
      171       run schedule-attr-name in this-procedure (
      172             input  p-code
      173           , output p-type
      174           , output v-format
      175           , output v-label
      176           , output v-user-can-edit
      177           , output v-output-display
      178           , output v-other
      179       ) no-error .
      180       if error-status :error
      181       then do:
      182           undo, return error return-value .
      183       end.
      184       if p-code begins ('schd-free-id':U + chr(4))
      185       and entry(2, p-code, chr(4)) = '':U then do:
      186         find first buf_schedule-attr no-lock
      187             where buf_schedule-attr.cre-db-num = p-cre-db-num
      188               and buf_schedule-attr.task-type  = p-task-type
      189               and buf_schedule-attr.task-num   = p-task-num
      190               and buf_schedule-attr.attr-code  begins p-code
      191         no-error .
      192       end.
      193       else do:
      194         find first buf_schedule-attr no-lock
      195             where buf_schedule-attr.cre-db-num = p-cre-db-num
      196               and buf_schedule-attr.task-type  = p-task-type
      197               and buf_schedule-attr.task-num   = p-task-num
      198               and buf_schedule-attr.attr-code  = p-code
      199         no-error .
      200       end.
      201       if available buf_schedule-attr
      202       then do:
      203           assign
      204               p-value = buf_schedule-attr.attr-value
      205           .
      206       end.
      207       else do:
      208         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      209            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      210         end.
      211         else do:
      212           assign
      213               p-value = if p-type = 'L':U then "no":U else ""
      214           .
      215         end.
      216       end.
      217   end.
      218   end procedure.
      219   procedure schedule-attr-write :
      220   do
      221   on error undo, return error
      222   :
      223   define input parameter p-cre-db-num  as integer   no-undo.
      224   define input parameter p-task-type   as character no-undo.
      225   define input parameter p-task-num    as integer   no-undo.
      226   define input parameter p-code        as character no-undo.
      227   define input parameter p-value       as character no-undo.
      228       define variable v-type              as character                no-undo.
      229       define variable v-format            as character                no-undo.
      230       define variable v-label             as character                no-undo.
      231       define variable v-user-can-edit     as logical                  no-undo.
      232       define variable v-output-display    as logical                  no-undo.
      233       define variable v-other             as character                no-undo.
      234       define buffer buf_schedule-attr for ub.schedule-attr .
      235       run schedule-attr-name in this-procedure (
      236             input  p-code
      237           , output v-type
      238           , output v-format
      239           , output v-label
      240           , output v-user-can-edit
      241           , output v-output-display
      242           , output v-other
      243       ) no-error.
      244       if error-status :error
      245       then do:
      246           undo, return error return-value.
      247       end.
      248       find first buf_schedule-attr exclusive-lock
      249            where buf_schedule-attr.cre-db-num = p-cre-db-num
      250              and buf_schedule-attr.task-type  = p-task-type
      251              and buf_schedule-attr.task-num   = p-task-num
      252              and buf_schedule-attr.attr-code  = p-code
      253       no-error.
      254       if not available buf_schedule-attr
      255       then do:
      256           create buf_schedule-attr.
      257           assign
      258             buf_schedule-attr.cre-db-num = p-cre-db-num
      259             buf_schedule-attr.task-type  = p-task-type
      260             buf_schedule-attr.task-num   = p-task-num
      261             buf_schedule-attr.attr-code  = p-code
      262             buf_schedule-attr.attr-value = p-value
      263           .
      264       end.
      265       else do:
      266           assign
      267               buf_schedule-attr.attr-value = p-value
      268           .
      269       end.
      270   end.
      271   end procedure.
      272   procedure schedule-attr-delete :
      273   do
      274   on error undo, return error
      275   :
      276   define input  parameter p-cre-db-num  as integer   no-undo.
      277   define input  parameter p-task-type   as character no-undo.
      278   define input  parameter p-task-num    as integer   no-undo.
      279   define input  parameter p-code        as character no-undo.
      280   define output parameter p-deleted     as logical   no-undo.
      281       define buffer buf_schedule-attr for ub.schedule-attr .
      282       define variable v-type              as character                no-undo.
      283       define variable v-format            as character                no-undo.
      284       define variable v-label             as character                no-undo.
      285       define variable v-user-can-edit     as logical                  no-undo.
      286       define variable v-output-display    as logical                  no-undo.
      287       define variable v-other             as character                no-undo.
      288       run schedule-attr-name in this-procedure (
      289             input p-code
      290           , output v-type
      291           , output v-format
      292           , output v-label
      293           , output v-user-can-edit
      294           , output v-output-display
      295           , output v-other
      296       ) no-error .
      297       if error-status :error
      298       then do:
      299           undo, return error return-value .
      300       end.
      301       find first buf_schedule-attr exclusive-lock
      302            where buf_schedule-attr.cre-db-num = p-cre-db-num
      303              and buf_schedule-attr.task-type  = p-task-type
      304              and buf_schedule-attr.task-num   = p-task-num
      305              and buf_schedule-attr.attr-code  = p-code
      306       no-error.
      307       if not available buf_schedule-attr
      308       then do:
      309           assign
      310               p-deleted = no
      311           .
      312       end.
      313       else do:
      314           delete buf_schedule-attr.
      315           assign
      316               p-deleted = yes
      317           .
      318       end.
      319   end.
      320   end procedure.
      321   procedure schedule-attr-news :
      322   do
      323   on error undo, return error
      324   :
      325       define input  parameter p-code           as character no-undo .
      326       define output parameter p-news           as logical   no-undo .
      327       if index(p-code, chr(4)) > 0 then do:
      328         p-code = entry(1, p-code, chr(4)).
      329       end.
      330       case p-code :
      331               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      332               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      333               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      334               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      335               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      336               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      337               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      338               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      339               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      340         otherwise do:
      341           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      342         end.
      343       end.
      344   end.
      345   end procedure.
      346   procedure schedule-attr-extract-logical :
      347   do
      348   on error undo, return error
      349   :
      350   define input  parameter p-parameter-number   as integer      no-undo.
      351   define input  parameter p-parameter-list     as character    no-undo.
      352   define output parameter p-parameter-value   as logical      no-undo.
      353       if num-entries( p-parameter-list ) > p-parameter-number - 1
      354       then do:
      355           assign
      356               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      357           .
      358       end.
      359       else do:
      360           assign
      361               p-parameter-value   = no
      362           .
      363       end.
      364   end.
      365   end procedure.
      366   procedure schedule-attr-get-free-id :
      367   do
      368   on error undo, return error return-value
      369   :
      370     define input  parameter p-cre-db-num  as integer   no-undo.
      371     define input  parameter p-task-type   as character no-undo.
      372     define input  parameter p-task-num    as integer   no-undo.
      373     define output parameter p-free-id     as character no-undo.
      374     define buffer buf_schedule-attr for ub.schedule-attr.
      375     find first buf_schedule-attr no-lock
      376         where buf_schedule-attr.cre-db-num = p-cre-db-num
      377           and buf_schedule-attr.task-type  = p-task-type
      378           and buf_schedule-attr.task-num   = p-task-num
      379           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      380     no-error .
      381     if available buf_schedule-attr then
      382     assign
      383     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      384     no-error
      385     .
      386   end.
      387   end procedure.
      388   procedure schedule-attr-get-free-props :
      389     define input parameter p-free-id as character no-undo .
      390     define output parameter p-value as character no-undo .
      391     define buffer buf_temp-schedule-free for temp-schedule-free.
      392     do
      393     on error undo, return error return-value
      394     :
      395       find first buf_temp-schedule-free no-lock no-error .
      396       if not available buf_temp-schedule-free then do:
      397         run schedule-attr-fill-free-props in this-procedure .
      398       end.
      399       find first buf_temp-schedule-free where
      400               buf_temp-schedule-free.free-id = p-free-id no-error.
      401       if available buf_temp-schedule-free then do:
      402         assign
      403         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      404                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      405                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      406                   buf_temp-schedule-free.conf-param           + chr(4) +
      407                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      408                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      409                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      410                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      411                   buf_temp-schedule-free.other-info
      412         .
      413       end.
      414       else do:
      415        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      416                              "id произвольной задачи - &5"
      417                              ,vss-workfile
      418                              ,vss-revision
      419                              ,vss-description
      420                              ,chr(10)
      421                              ,p-free-id).
      422       end.
      423     end.
      424   end procedure.
      425   procedure schedule-attr-is-rum-free-id :
      426   define input parameter p-free-id as character no-undo .
      427   define output parameter p-is-rum as logical no-undo .
      428   define buffer buf_temp-schedule-free for temp-schedule-free.
      429   do
      430   on error undo, return error
      431   :
      432       find first buf_temp-schedule-free no-lock no-error .
      433       if not available buf_temp-schedule-free then do:
      434         run schedule-attr-fill-free-props in this-procedure .
      435       end.
      436       find first buf_temp-schedule-free where
      437               buf_temp-schedule-free.free-id = p-free-id no-error.
      438       if available buf_temp-schedule-free
      439       and buf_temp-schedule-free.is-rum
      440       then do:
      441         p-is-rum = yes.
      442       end.
      443   end.
      444   end procedure.
      445   procedure schedule-attr-fill-free-props :
      446   define variable v-path                    as character                no-undo .
      447   DEFINE VARIABLE v-full-path               as character                no-undo .
      448   DEFINE VARIABLE v-file-name               as character                no-undo .
      449   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      450   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      451   define buffer buf_temp-schedule-free for temp-schedule-free.
      452   define variable v-answer as logical no-undo .
      453     do
      454     on error undo, return error substitute("&1 &2 &3&4&5&4"
      455                                           ,vss-workfile
      456                                           ,vss-revision
      457                                           ,vss-description
      458                                           ,chr(10)
      459                                           ,error-status:get-message(1) )
      460     :
      461       run gbl/filename.p (
      462                       input 'cmp/shd-free.d'
      463                     ,output v-full-path
      464                     ,output v-path
      465                     ,output v-file-name
      466                     ,output v-file-name-no-ext
      467                     ,output v-file-name-ext
      468                     ) .
      469       input from value(v-full-path).
      470       repeat :
      471         create buf_temp-schedule-free.
      472         import buf_temp-schedule-free.
      473       END.
      474       input close.
      475       _ff:
      476       for each buf_temp-schedule-free :
      477         if buf_temp-schedule-free.free-id = '':U then do:
      478            delete buf_temp-schedule-free.
      479            next _ff.
      480          end.
      481          run schedule-attr-check-enc in this-procedure (
      482                                                       input  buf_temp-schedule-free.free-id
      483                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      484                                                               buf_temp-schedule-free.proc-param-edit-name +
      485                                                               buf_temp-schedule-free.conf-param +
      486                                                               string(buf_temp-schedule-free.is-gbd) +
      487                                                               string(buf_temp-schedule-free.is-ubd) +
      488                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      489                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      490                                                               string(buf_temp-schedule-free.other-info)
      491                                                               )
      492                                                       ,input  buf_temp-schedule-free.enc-key
      493                                                       ,output v-answer    ) no-error .
      494          if error-status:error
      495          or not v-answer then delete buf_temp-schedule-free.
      496        end.
      497     end.
      498   end procedure.
      499   Function schedule-attr-reverse returns character (str as character).
      500      define variable rev_incl_s as character init "" no-undo .
      501      define variable rev_incl_i as integer no-undo .
      502      define variable rev_incl_l as integer no-undo .
      503      rev_incl_l = length(str).
      504      do rev_incl_i = 1 to rev_incl_l:
      505         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      506      end.
      507      return rev_incl_s.
      508   end.
      509   procedure schedule-attr-check-enc.
      510     define input  parameter p-free-id   as character no-undo .
      511     define input  parameter p-value     as character no-undo .
      512     define input  parameter p-enc-value as character no-undo .
      513     define output parameter p-answer    as logical   no-undo .
      514     define variable tmp         as character no-undo .
      515     define variable v-enc-value as character no-undo .
      516     assign
      517     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      518     .
      519     run schedule-attr-pswd-enc in this-procedure
      520       ( input tmp
      521        ,output v-enc-value
      522       ) no-error .
      523     if error-status:error then do:
      524       message
      525         vss-workfile vss-revision vss-description skip
      526         "Ошибка при вызове процедуры pswd-enc" skip
      527         return-value skip
      528         error-status :get-message(1) skip
      529         view-as alert-box error .
      530       undo, return error .
      531     end.
      532     if v-enc-value = p-enc-value then do:
      533       assign
      534         p-answer = true
      535       .
      536     end.
      537     else do:
      538       assign
      539         p-answer = false
      540       .
      541     end.
      542   end.
      543   procedure schedule-attr-conf-enc.
      544     define input  parameter p-free-id   as character no-undo .
      545     define input  parameter p-value     as character no-undo .
      546     define output parameter p-enc-value as character no-undo .
      547     define variable tmp         as character no-undo .
      548     assign
      549       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      550     .
      551     run schedule-attr-pswd-enc in this-procedure
      552       ( input tmp
      553        ,output p-enc-value
      554       ) no-error .
      555     if error-status:error then do:
      556       message
      557         vss-workfile vss-revision vss-description skip
      558         "Ошибка при вызове процедуры pswd-enc" skip
      559         return-value skip
      560         error-status :get-message(1) skip
      561         view-as alert-box error .
      562       undo, return error .
      563     end.
      564   end procedure.
      565   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      566   procedure schedule-attr-pswd-enc :
      567     define input parameter  pswd     as character no-undo .
      568     define output parameter enc-pswd as character no-undo .
      569     do
      570     on error undo, return error return-value
      571     :
      572       assign
      573         enc-pswd = encode(pswd + string(index(pswd, "k")))
      574       .
      575     end.
      576   end procedure.
      577   define variable v-param-list as character no-undo.
      578   define variable v-param-type as character no-undo.
      579   run schedule-attr-value in this-procedure (input integer(p_db-num-char),
      580       input p_task-type,
      581       input p_task-num,
      582       input 'schedule-param-list':U,
      583       output v-param-list,
      584       output v-param-type) no-error.
      585       if v-param-list = "" then do:
      586           message "Не заданы параметры!"
      587     VIEW-AS ALERT-BOX ERROR.
      588           UNDO, RETURN ERROR.
      589           end.
      590   assign
      591       p-gds-inf-po = integer(entry (1, v-param-list, chr(4)))
      592       p-gds-active = integer(entry (2, v-param-list, chr(4)))
      593       p-directory  = entry (3, v-param-list, chr(4))
      594       p-code_pnpo  = entry (4, v-param-list, chr(4))
      595       p-bge-active = logical(entry (5, v-param-list, chr(4)))
      596       p-bge-inf-po = logical(entry (6, v-param-list, chr(4)))
      597       p-per        = integer(ENTRY(7, v-param-list, chr(4)))
      598       .
      599   define variable v-param2-list as character no-undo.
      600   define variable v-param2-type as character no-undo.
      601   define variable v-obj-range   as integer   no-undo .
      602   define variable v-host-code   like ub.sysconf.host-code no-undo .
      603   run schedule-attr-value in this-procedure (input integer(p_db-num-char),
      604       input p_task-type,
      605       input p_task-num,
      606       input 'schedule-obj-list':U,
      607       output v-param2-list,
      608       output v-param2-type) no-error.
      609       if v-param2-list = "" then do:
      610           message "Не заданы параметры!"
      611     VIEW-AS ALERT-BOX ERROR.
      612           UNDO, RETURN ERROR.
      613           end.
      614       if num-entries(v-param2-list,':') = 2
      615       then do:
      616         assign
      617           v-obj-range = integer(entry(1, v-param2-list, ':'))
      618           v-obj-list  = entry(2, v-param2-list, ':')
      619         .
      620         if v-obj-range = 2 then v-host-code = integer(v-obj-list) no-error.
      621       end.
      622   run bge/active-vbrr.p (input parparentproc
      623       ,input v-obj-range
      624       ,input v-host-code
      625       ,input v-obj-list
      626       ,input p-date-to
      627       ,input p-date-from
      628       ,input p-gds-inf-po
      629       ,input p-gds-active
      630       ,input p-directory
      631       ,input p-code_pnpo
      632       ,input p-bge-active
      633       ,input p-bge-inf-po
      634       ,input p-per
      635       ) no-error .
      636           if error-status:error then
      637       do:
      638      message
      639      return-value  error-status:get-message(1) view-as alert-box.
      640       end.
