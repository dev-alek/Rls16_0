     3213       ).
     3214   end.
     3215   procedure export-shifts-object :
     3216   define input parameter p-host-code      as integer      no-undo.
     3217   define input parameter p-obj-type       as character    no-undo.
     3218   define input parameter p-obj-code       as integer      no-undo.
     3219   define input parameter p-out-dir        as character        no-undo.
     3220   define input parameter p-out-dirR       as character        no-undo.
     3221   define input parameter p-log-file-name  as character        no-undo.
     3222       define variable v-fact-order-from   as decimal      no-undo.
     3223       define variable v-fact-order-to     as decimal      no-undo.
     3224       define variable v-docs-exists       as logical      no-undo.
     3225       define variable v-prefix            as character    no-undo.
     3226       define variable v-archive-ok        as logical      no-undo.
     3227       define variable v-comment           as character    no-undo.
     3228       define buffer buf_shift-obj     for ub.shift-obj.
     3229   do
     3230   for buf_shift-obj
     3231   on error undo, return error
     3232   :
     3233       export-shifts:
     3234       for each buf_shift-obj no-lock
     3235          where buf_shift-obj.obj-type     = p-obj-type
     3236            and buf_shift-obj.obj-code     = p-obj-code
     3237            and buf_shift-obj.shift-date   >= p-date-from
     3238            and buf_shift-obj.shift-date   <= p-date-to
     3239            and buf_shift-obj.status_      = 'зкр':U
     3240       :
     3241           do :
     3242             run wp-XMLWriteLog in this-procedure (
     3243                   input p-log-file-name
     3244                 , input 2
     3245                 , input "Расчет архивов"
     3246             ).
     3247             run bge/bge-ahzs.p (
     3248                   input p-obj-type
     3249                 , input p-obj-code
     3250                 , input yes
     3251                 , input yes
     3252                 , input no
     3253                 , input p-date-from
     3254                 , input p-date-to
     3255                 , output v-archive-ok
     3256                 , output v-comment
     3257             ) no-error.
     3258             if error-status :error
     3259             then do:
     3260                 message
     3261                 vss-workfile vss-revision vss-description
     3262                 skip "Ошибка проверки архивов на объекте."
     3263                 skip "Тип объекта:" p-obj-type
     3264                 skip "Код объекта:" p-obj-code
     3265                 skip return-value
     3266                 skip error-status:get-message(1)
     3267                      error-status :get-message(2)
     3268                      error-status :get-message(3)
     3269                 view-as alert-box error.
     3270                 undo, return error .
     3271             end.
     3272             if v-archive-ok = no
     3273             then do:
     3274                 run wp-XMLWriteLog in this-procedure (
     3275                       input v-log-file-name
     3276                     , input 1
     3277                     , input substitute( "*** Документы по объекту &1 &2 в интервале дат &3 - &4 не будут выгружены. Архивы по объекту в заданном интервале дат не целостные. &5."
     3278                                             , p-obj-type
     3279                                             , p-obj-code
     3280                                             , p-date-from
     3281                                             , p-date-to
     3282                                             , v-comment       )
     3283                 ).
     3284                 undo, return error .
     3285             end.
     3286           end .
     3287   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnam in g#lib-trn3
     3288     (
     3289        input buf_shift-obj.obj-type
     3290     ,  input buf_shift-obj.obj-code
     3291     ,  input buf_shift-obj.shift-date
     3292     ,  input buf_shift-obj.shift-num
     3293     , output v-shift-name
     3294     , output v-shift-name-num
     3295     )        no-error .
     3296           run wp-XMLWriteLog in this-procedure (
     3297                 input p-log-file-name
     3298               , input 2
     3299               , input substitute( "Смена: N &1 за &2 ...", v-shift-name-num, buf_shift-obj.shift-date  )
     3300           ).
     3301         do :
     3302           assign
     3303               v-prefix = substitute( "d_&1&2&3&4&5&6_"
     3304                                       , substring( string( year( buf_shift-obj.shift-date ), "9999":U ), 3, 2 )
     3305                                       , string( month( buf_shift-obj.shift-date ), "99":U )
     3306                                       , string( day( buf_shift-obj.shift-date ), "99":U )
     3307                                       , string( buf_shift-obj.shift-num, "99":U )
     3308                                       , string( trim( buf_shift-obj.obj-type ), "X(3)":U )
     3309                                       , string( buf_shift-obj.obj-code, "99999":U )
     3310                                       )
     3311           .
     3312           run bge-xml-out-file in this-procedure (
     3313                 input p-out-dir
     3314               , input v-prefix
     3315               , input yes
     3316               , output v-xml-file-name
     3317               , output v-locked
     3318           ).
