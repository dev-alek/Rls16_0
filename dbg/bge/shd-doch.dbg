     3343               , input p-pay-desk
     3344               , input p-pay-desk-cards
     3345               , input yes
     3346               , input no
     3347           ).
     3348           run rep/getfosht.p (
     3349                 input p-obj-type
     3350               , input p-obj-code
     3351               , input buf_shift-obj.shift-date
     3352               , input buf_shift-obj.shift-num
     3353               , output v-fact-order-from
     3354               , output v-fact-order-to
     3355               , output v-docs-exists
     3356           ).
     3357           run wp-XMLWriteLog (
     3358                                 input p-log-file-name
     3359                               , input 1
     3360                               , input substitute( " Последний fact-order(shd-doch) &1."
     3361                                                    , v-fact-order-to
     3362                                                   )  ).
     3363           if v-docs-exists = yes
     3364           then do:
     3365               for each temp_ext-doc-type
     3366               :
     3367                   if lookup( temp_ext-doc-type.ext-doc-type, p-doc-type-list ) <> 0
     3368                   or p-doc-type-list = "":U
     3369                   then do:
     3370                       define variable v-date-from   as date      no-undo .
     3371                       define variable v-date-to     as date      no-undo .
     3372                       if v-fact-order-from = 0 then do:
     3373                         v-date-from = 01/01/1990.
     3374                       end.
     3375                       else do:
     3376                       run factord-to-date in this-procedure ( input  v-fact-order-from
     3377                                                             , output v-date-from
     3378                                                             ) .
     3379                       end.
     3380                       if v-fact-order-to = 0 then do:
     3381                         v-date-to = 01/01/1990.
     3382                       end.
     3383                       else do:
     3384                       run factord-to-date in this-procedure ( input  v-fact-order-to
     3385                                                             , output v-date-to
     3386                                                             ) .
     3387                       end.
     3388                       run bge/doc-oper.p (
     3389                             input p-host-code
     3390                           , input p-obj-type
     3391                           , input p-obj-code
     3392                           , input temp_ext-doc-type.ext-doc-type
     3393                           , input temp_ext-doc-type.ext-doc-type-label
     3394                           , input v-fact-order-from
     3395                           , input v-fact-order-to
     3396                           , input v-date-from
     3397                           , input v-date-to
     3398                           , input p-pay-code
     3399                           , input p-cst
     3400                           , input p-parts
     3401                           , input p-chk-pay-code
     3402                           , input p-pay-desk
     3403                           , input p-pay-desk-cards
     3404                           , input no
     3405                           , input p-doc-rvs
     3406                           , input v-xml-file-name
     3407                           , input p-log-file-name
     3408                           , input this-procedure
     3409                           , input hEDT
     3410                           , input hCNT
     3411                       ) no-error.
     3412                       if error-status :error
     3413                       then do:
     3414                           run wp-XMLWriteLog in this-procedure (
     3415                                 input p-log-file-name
     3416                               , input 1
     3417                               , input "*** Ошибка экспорта документов. " + return-value + "." + trim( error-status :get-message( 1 ) ) + "." + trim( error-status :get-message( 2 ) )
     3418                           ).
     3419                       end.
     3420                   end.
     3421               end.
     3422               run bge/doc-delh.p (
     3423                     input p-obj-type
     3424                   , input p-obj-code
     3425                   , input buf_shift-obj.shift-date
     3426                   , input buf_shift-obj.shift-num
     3427                   , input v-xml-file-name
     3428                   , input p-log-file-name
