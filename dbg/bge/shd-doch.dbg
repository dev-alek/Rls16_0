      986   define variable v-bge-xml-bgefmt        as character         no-undo.
      987   define variable v-bge-xml-shift-mode    as logical           no-undo.
      988   define variable v-bge-xml-bgeflnm-doc   as character         no-undo.
      989   define variable v-bge-xml-bgeflnm-day   as character         no-undo.
      990   define variable v-bge-xml-log-file-name as character    no-undo.
      991   define variable v-bge-xml-dbf-file-name as character    no-undo.
      992   define variable v-bge-xml-db-num-str    as character    no-undo .
      993   define variable v-bge-xml-static-log-file-name as character    no-undo.
