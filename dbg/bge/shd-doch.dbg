     3481               , input "15.0 " + replace( vss-revision + vss-date, "$", " " )
     3482               , input 0
     3483               , input buf_shift-obj.shift-date
     3484               , input buf_shift-obj.shift-num
     3485               , input buf_shift-obj.shift-date
     3486               , input buf_shift-obj.shift-num
     3487               , input p-obj-list
     3488               , input "":U
     3489               , input no
     3490               , input no
     3491               , input no
     3492               , input no
     3493               , input no
     3494               , input no
     3495               , input no
     3496               , input no
     3497           ).
     3498           run bge/shtoper.p (
     3499                 input p-host-code
     3500               , input p-obj-type
     3501               , input p-obj-code
     3502               , input buf_shift-obj.shift-date
     3503               , input buf_shift-obj.shift-num
     3504               , input v-xml-file-name
     3505               , input v-log-file-name
     3506               , input ?
     3507               , input ?
     3508           ) no-error.
     3509           if error-status :error
     3510           then do:
     3511               run wp-XMLWriteLog in this-procedure (
     3512                     input v-log-file-name
     3513                   , input 1
     3514                   , input substitute( "Ошибка экспорта смены объекта &1 &2. Смена  &3 от &4. &5. &6. &7."
     3515                                           , p-obj-type
     3516                                           , p-obj-code
     3517                                           , buf_shift-obj.shift-date
     3518                                           , buf_shift-obj.shift-num
     3519                                           , return-value
     3520                                           , trim( error-status :get-message( 1 ) )
     3521                                           , trim( error-status :get-message( 2 ) )
     3522                                       )
     3523               ).
     3524               undo export-shifts, next export-shifts.
     3525           end.
     3526           run xml-bge-write-footer in this-procedure ( input v-xml-file-name ).
     3527         end .
     3528         do :
     3529           assign
     3530               v-prefix = substitute( "r_&1&2&3&4&5&6_"
     3531                                       , substring( string( year( buf_shift-obj.shift-date ), "9999":U ), 3, 2 )
     3532                                       , string( month( buf_shift-obj.shift-date ), "99":U )
     3533                                       , string( day( buf_shift-obj.shift-date ), "99":U )
     3534                                       , string( buf_shift-obj.shift-num, "99":U )
     3535                                       , string( trim( buf_shift-obj.obj-type ), "X(3)":U )
     3536                                       , string( buf_shift-obj.obj-code, "99999":U )
     3537                                       )
     3538           .
     3539           run bge-xml-out-file in this-procedure (
     3540                 input p-out-dirR
     3541               , input v-prefix
     3542               , input no
     3543               , output v-xml-file-name
     3544               , output v-locked
     3545           ).
     3546           if v-locked then do:
     3547               message
     3548                   skip "Файл выгрузки заблокирован другим процессом."
     3549                   skip "Полное имя файла:"
     3550                   skip v-xml-file-name + "xml"
     3551               view-as alert-box error.
     3552               run wp-XMLWriteLog in this-procedure (
