     3458                 input p-out-dir
     3459               , input v-prefix
     3460               , input no
     3461               , output v-xml-file-name
     3462               , output v-locked
     3463           ).
     3464           if v-locked = yes
     3465           then do:
     3466               message
     3467                   skip "Файл выгрузки заблокирован другим процессом."
     3468                   skip "Полное имя файла:"
     3469                   skip v-xml-file-name "xml"
     3470               view-as alert-box error.
     3471               run wp-XMLWriteLog in this-procedure (
     3472                     input v-log-file-name
     3473                   , input 1
