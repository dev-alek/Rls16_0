      637                       end.
      638                       when chr(7)
      639                       then do:
      640                           assign
      641                               p-out-string = p-out-string + " ":U
      642                           .
      643                       end.
      644                       when chr(8)
      645                       then do:
      646                           assign
      647                               p-out-string = p-out-string + " ":U
      648                           .
      649                       end.
      650                       when chr(9)
      651                       then do:
      652                           assign
      653                               p-out-string = p-out-string + " ":U
      654                           .
      655                       end.
      656                       when chr(29)
      657                       then do:
      658                           assign
      659                               p-out-string = p-out-string + " ":U
      660                           .
      661                       end.
      662                       when chr(10)
      663                       then do:
      664                           assign
      665                               p-out-string = p-out-string + " ":U
      666                           .
      667                       end.
      668                       when chr(13)
      669                       then do:
      670                           assign
      671                               p-out-string = p-out-string + " ":U
      672                           .
      673                       end.
      674                       otherwise do:
      675                           assign
      676                               p-out-string = p-out-string + v-current-char
      677                           .
      678                       end.
      679                   end case.
      680               end.
      681           end.
      682       end case.
      683   end.
      684   end .
      685   procedure xmlchar-decode :
      686   define input parameter p-in-string      as character        no-undo.
      687   define output parameter p-out-string    as character        no-undo.
      688       define variable v-position      as integer      no-undo.
      689       define variable v-last-position as integer      no-undo.
      690       define variable v-temp-integer  as integer      no-undo.
      691       define variable v-current-char  as character    no-undo.
      692       define variable v-next-char     as character    no-undo.
      693       define variable v-success       as logical      no-undo.
      694   do
      695   on error undo, return error
      696   :
      697       assign
      698           p-out-string = "":U
      699           v-position   = 0
      700       .
      701       replace-cycle:
      702       do while yes
      703       on error undo, return error
      704       :
      705           assign
      706               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      707           .
      708           if v-last-position <= v-position
      709           then do:
      710               if v-position = 0
      711               then do:
      712                   assign
      713                       p-out-string = p-in-string
      714                   .
      715               end.
      716               else do:
      717                   assign
      718                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      719                   .
      720               end.
      721               leave replace-cycle.
      722           end.
      723           else do:
      724               assign
      725                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      726                   v-position      = v-last-position
      727                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      728               .
      729               if v-current-char = "#":U
      730               then do:
      731                   assign
      732                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      733                   .
      734                   if v-last-position > 0
      735                   then do:
      736                       run xmlchar-read-integer in this-procedure
      737                        (
      738                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      739                           , output v-temp-integer
      740                           , output v-success
      741                       ).
      742                       if v-success = yes
      743                       and v-temp-integer >= 1
      744                       and v-temp-integer <= 255
      745                       then do:
      746                           assign
      747                               p-out-string = p-out-string + chr( v-temp-integer )
      748                               v-position   = v-last-position + 1
      749                           .
      750                       end.
      751                       else do:
      752                           assign
      753                               p-out-string = p-out-string + "&":U
      754                               v-position   = v-position   + 1
      755                           .
      756                       end.
      757                   end.
      758                   else do:
      759                       assign
      760                           p-out-string = p-out-string + "&":U
      761                           v-position   = v-position   + 1
      762                       .
      763                   end.
      764               end.
      765               else do:
      766                   case substring( p-in-string, v-position + 1, 3 )
      767                   :
      768                       when "lt;":U
      769                       then do:
      770                           assign
      771                               p-out-string = p-out-string + "<":U
      772                               v-position   = v-position   + 3
      773                           .
      774                       end.
      775                       when "gt;":U
      776                       then do:
      777                           assign
      778                               p-out-string = p-out-string + ">":U
      779                               v-position   = v-position   + 3
      780                           .
      781                       end.
      782                       otherwise do:
      783                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      784                           then do:
      785                               assign
      786                                   p-out-string = p-out-string + "&":U
      787                                   v-position   = v-position   + 4
      788                               .
      789                           end.
      790                           else do:
      791                               case substring( p-in-string, v-position + 1, 5 )
      792                               :
      793                                   when "quot;":U
      794                                   then do:
      795                                       assign
      796                                           p-out-string = p-out-string + '"':U
      797                                           v-position   = v-position   + 5
      798                                       .
      799                                   end.
      800                                   when "apos;":U
      801                                   then do:
      802                                       assign
      803                                           p-out-string = p-out-string + "'":U
      804                                           v-position   = v-position   + 5
      805                                       .
      806                                   end.
      807                                   otherwise do:
      808                                       assign
      809                                           p-out-string = p-out-string + "&":U
      810                                       .
      811                                   end.
      812                               end case.
      813                           end.
      814                       end.
      815                   end case.
      816               end.
      817           end.
      818       end.
      819   end.
      820   end .
      821   procedure xmlchar-read-integer :
      822   define input parameter p-input-string      as character        no-undo.
      823   define output parameter p-output-integer   as integer          no-undo.
      824   define output parameter p-success       as logical          no-undo.
      825   do
      826   on error undo, return error
      827   :
      828       assign
      829           p-output-integer = integer( p-input-string )
      830       no-error.
      831       if error-status :error
      832       then do:
      833           assign
      834               p-success           = no
      835               p-output-integer    = 0
      836           .
      837       end.
      838       else do:
      839           assign
      840               p-success           = yes
      841           .
      842       end.
      843   end.
      844   end.
      845   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      846   procedure strtdate :
      847     define input  parameter p-str         as character no-undo .
      848     define output parameter p-value       as date      no-undo .
      849     define output parameter p-data-valid  as logical   no-undo .
      850     define output parameter p-message     as character no-undo .
      851   do
      852   on error undo, return error return-value
      853   :
      854     define variable v-value       as date      no-undo .
      855     define variable v-i           as integer   no-undo .
      856     define variable v-num         as integer   no-undo .
      857     define variable v-delim       as character no-undo .
      858     define variable v-delim-list  as character no-undo .
      859     define variable v-day         as integer   no-undo .
      860     define variable v-month       as integer   no-undo .
      861     define variable v-year        as integer   no-undo .
      862     define variable v-day-str     as character no-undo .
      863     define variable v-month-str   as character no-undo .
      864     define variable v-year-str    as character no-undo .
      865     assign
      866       p-value       = ?
      867       p-data-valid  = false
      868     .
      869     if p-str = ?
      870     then do:
      871       assign
      872         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      873       .
      874       return .
      875     end.
      876     if p-str = ""
      877     then do:
      878       assign
      879         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      880       .
      881       return .
      882     end.
      883     if length(p-str)  > 10
      884     then do:
      885       assign
      886         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      887       .
      888       return .
      889     end.
      890     assign
      891       v-delim-list = '/,-,.':U
      892     .
      893     _delim:
      894     do v-i = 1 to num-entries( v-delim-list )
      895     :
      896       assign
      897         v-delim = entry( v-i , v-delim-list )
      898         v-num   = num-entries( p-str , v-delim )
      899       .
      900       if v-num <> 3
      901       then do:
      902         assign
      903           v-delim = ''
      904         .
      905       end.
      906       else do:
      907         leave _delim.
      908       end.
      909     end.
      910     if v-delim = ''
      911     then do:
      912       assign
      913         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      914       .
      915       return .
      916     end.
      917     assign
      918       v-day-str   = entry( 1, p-str , v-delim)
      919       v-month-str = entry( 2, p-str , v-delim)
      920       v-year-str  = entry( 3, p-str , v-delim)
      921     .
      922     if  length(v-day-str) > 2   or
      923         length(v-day-str) < 1   or
      924         length(v-month-str) > 2 or
      925         length(v-month-str) < 1 or
      926         (
      927           length(v-year-str) <> 2 and
      928           length(v-year-str) <> 4
      929         )
      930     then do:
      931       assign
      932         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      933       .
      934       return .
      935     end.
      936     if length( v-year-str ) = 2
      937     then do:
      938       assign
      939         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      940       .
      941     end.
      942     assign
      943       v-day   = integer( v-day-str )
      944       v-month = integer( v-month-str)
      945       v-year  = integer( v-year-str)
      946     no-error .
      947     if error-status :error
      948     then do:
      949       assign
      950         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      951       .
      952       return .
      953     end.
      954     if v-day < 1  or
      955        v-day > 31 or
      956        v-month < 1 or
      957        v-month > 12 or
      958        v-year < 0   or
      959        v-year > 5000
      960     then do:
      961       assign
      962         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      963       .
      964       return .
      965     end.
      966     assign
      967       v-value = date( v-month, v-day, v-year )
      968     no-error .
      969     if error-status :error
      970     then do:
      971       assign
      972         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      973       .
      974       return .
      975     end.
      976     assign
      977       p-value       = v-value
      978       p-data-valid  = true
      979     .
      980   end.
      981   end procedure.
      982   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      983   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
