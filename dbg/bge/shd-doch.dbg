     3645           , input p-date-to
     3646           , output v-archive-ok
     3647           , output v-comment
     3648       ) no-error.
     3649       if error-status :error
     3650       then do:
     3651           message
     3652           vss-workfile vss-revision vss-description
     3653           skip "Ошибка проверки архивов на объекте."
     3654           skip "Тип объекта:" p-obj-type
     3655           skip "Код объекта:" p-obj-code
     3656           skip return-value
     3657           skip trim(error-status :get-message(1))
     3658               trim(error-status :get-message(2))
     3659               trim(error-status :get-message(3))
