     3712               , input "15.0 " + replace( vss-revision + vss-date, "$", " " )
     3713               , input p-db-num
     3714               , input p-date-from
     3715               , input 0
     3716               , input p-date-to
     3717               , input 0
     3718               , input p-obj-list
     3719               , input p-doc-type-list
     3720               , input p-pay-code
     3721               , input p-cst
     3722               , input p-parts
     3723               , input p-chk-pay-code
     3724               , input p-pay-desk
     3725               , input p-pay-desk-cards
     3726               , input yes
     3727               , input no
     3728           ).
     3729           for each temp_ext-doc-type
     3730           :
     3731               if lookup( temp_ext-doc-type.ext-doc-type, p-doc-type-list ) <> 0
     3732               or p-doc-type-list = "":U
     3733               then do:
     3734                   run bge/doc-oper.p (
     3735                         input p-host-code
     3736                       , input p-obj-type
     3737                       , input p-obj-code
     3738                       , input temp_ext-doc-type.ext-doc-type
     3739                       , input temp_ext-doc-type.ext-doc-type-label
     3740                       , input v-fact-order-from
     3741                       , input v-fact-order-to
     3742                       , input p-date-from
     3743                       , input p-date-to
     3744                       , input p-pay-code
     3745                       , input p-cst
     3746                       , input p-parts
     3747                       , input p-chk-pay-code
     3748                       , input p-pay-desk
     3749                       , input p-pay-desk-cards
     3750                       , input no
     3751                       , input p-doc-rvs
     3752                       , input v-xml-file-name
     3753                       , input p-log-file-name
     3754                       , input this-procedure
     3755                       , input hEDT
     3756                       , input hCNT
     3757                   ) no-error.
     3758                   if error-status :error
     3759                   then do:
     3760                       run wp-XMLWriteLog in this-procedure (
     3761                           input p-log-file-name
     3762                           , input 1
     3763                           , input "*** Ошибка экспорта документов. " + return-value + "." + trim( error-status :get-message( 1 ) ) + "." + trim( error-status :get-message( 2 ) )
     3764                       ).
     3765                   end.
     3766               end.
     3767           end.
     3768           run bge/doc-deld.p (
     3769                 input p-host-code
     3770               , input p-obj-type
     3771               , input p-obj-code
     3772               , input p-date-from
     3773               , input p-date-to
     3774               , input v-xml-file-name
     3775               , input p-log-file-name
     3776               , input ?
     3777               , input ?
     3778           ) no-error.
     3779           if error-status :error
     3780           then do:
     3781               run wp-XMLWriteLog in this-procedure (
     3782                     input p-log-file-name
     3783                   , input 1
     3784                   , input substitute( "*** Ошибка экспорта удалённых документов. &1. &2. &3."
     3785                                       , return-value
     3786                                       , trim(error-status :get-message(1))
     3787                                       , trim(error-status :get-message(2))
     3788                                       )  ).
     3789           end.
     3790           run xml-bge-write-footer in this-procedure ( input v-xml-file-name ).
     3791       end.
     3792       run wp-XMLWriteLog in this-procedure (
     3793             input p-log-file-name
     3794           , input 1
     3795           , input substitute( " < Экспорт документов по несменному объекту &1 &2 завершён.", p-obj-type, p-obj-code )
     3796       ).
     3797   end.
     3798   end procedure.
     3799   procedure cb-fill_bge-xml_goods :
     3800   define input parameter p-gds-code   as integer          no-undo.
     3801   do
     3802   on error undo, return error
     3803   :
     3804       find first temp_bge-xml_goods
     3805            where temp_bge-xml_goods.gds-code = p-gds-code
     3806       no-error.
     3807       if not available temp_bge-xml_goods
     3808       then do:
     3809           create temp_bge-xml_goods.
     3810           assign
     3811               temp_bge-xml_goods.gds-code = p-gds-code
     3812           .
     3813       end.
     3814   end.
     3815   end procedure.
