      591                   p-out-string = "?":U
      592               .
      593           end.
      594           otherwise do:
      595               do v-position = 1 to length( p-in-string )
      596               :
      597                   assign
      598                       v-current-char = substring( p-in-string, v-position, 1 )
      599                   .
