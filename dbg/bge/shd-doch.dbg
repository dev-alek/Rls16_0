      183   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      184   procedure cur-time :
      185      define output parameter p-today as date      no-undo .
      186      define output parameter p-time  as integer   no-undo .
      187     do
      188     on error undo, return error
      189     :
      190       define variable v-date1 as date      no-undo .
      191       define variable v-date2 as date      no-undo .
      192       define variable v-time  as integer   no-undo .
      193       assign
      194         v-date1 = today
      195         v-time  = time
      196         v-date2 = today
      197       .
      198       if v-date1 <> v-date2
      199       then do:
      200         assign
      201           v-date1 = today
      202           v-time  = v-time
      203         .
      204       end.
      205       assign
      206         p-today = v-date1
      207         p-time  = v-time
      208       .
      209     end.
      210   end.
      211   function cur-time-date returns character
      212   :
      213     return string(today, '99/99/9999':U) .
      214   end.
      215   function cur-time-mjd returns decimal
      216   :
      217     define variable v-date as date      no-undo .
      218     define variable v-time as integer   no-undo .
      219     run cur-time in this-procedure
      220       (output v-date
      221       ,output v-time
      222       ) .
      223     return integer(v-date) - 2400002 + (v-time / 86400) .
      224   end.
      225   function cur-time-get-ending-index returns integer
      226   (input p-number as integer
      227   )
      228   :
      229     if p-number < 0
      230     or p-number = ?
      231     then do:
      232       return 1 .
      233     end.
      234     define variable v-rest as integer   no-undo .
      235     assign
      236       p-number = p-number modulo 100
      237     .
      238     if p-number < 20
      239     then do:
      240       assign
      241         v-rest = p-number
      242       .
      243     end.
      244     else do:
      245       assign
      246         v-rest = p-number modulo 10
      247       .
      248     end.
      249     case v-rest :
      250       when 1
      251       then do:
      252         return 2 .
      253       end.
      254       when 2 or
      255       when 3 or
      256       when 4
      257       then do:
      258         return 3 .
      259       end.
      260       otherwise do:
      261         return 1 .
      262       end.
      263     end case .
      264   end.
      265   procedure cur-time-mjd-to-date :
      266      define input  parameter i-mjd-diff as decimal no-undo.
      267      define output parameter o-Date     as date    no-undo.
      268      define output parameter o-Time     as integer no-undo.
      269      define variable v-day-number as integer   no-undo .
      270      if    i-mjd-diff < 0
      271         or i-mjd-diff = ?
      272      then do:
      273         return "?" .
      274      end.
      275      assign
      276         v-day-number = truncate(i-mjd-diff,0).
      277         o-Date = date(v-day-number + 2400002).
      278         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      279     .
      280   end.
      281   function cur-time-mjd-to-string returns character
      282   (input p-mjd-diff as decimal
      283   )
      284   :
      285     define variable v-day-number as integer   no-undo .
      286     define variable v-seconds    as integer   no-undo .
      287     define variable v-hour       as integer   no-undo .
      288     define variable v-min        as integer   no-undo .
      289     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      290     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      291     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      292     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      293     if p-mjd-diff < 0
      294     or p-mjd-diff = ?
      295     then do:
      296       return "?" .
      297     end.
      298     assign
      299       v-day-number = integer(truncate(p-mjd-diff,0))
      300       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      301     .
      302     if v-seconds > 86400
      303     then do:
      304       assign
      305         v-seconds = 86400 - 1
      306       .
      307     end.
      308     if v-seconds < 0
      309     then do:
      310       assign
      311         v-seconds = 0
      312       .
      313     end.
      314     assign
      315       v-hour = truncate(v-seconds / 3600, 0)
      316     .
      317     assign
      318       v-seconds = v-seconds modulo 3600
      319     .
      320     assign
      321       v-min = truncate(v-seconds / 60, 0)
      322     .
      323     assign
      324       v-seconds = v-seconds modulo 60
      325     .
      326     return
      327         (if v-day-number <> 0
      328           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      329           else ""
      330         )
      331       + (if v-day-number <> 0 or v-hour <> 0
      332           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      333           else ""
      334         )
      335       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      336           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      337           else ""
      338         )
      339       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      340       .
      341   end.
      342   function cur-time-string returns character
      343   :
      344     define variable v-date as date      no-undo .
      345     define variable v-time as integer   no-undo .
      346     run cur-time in this-procedure
      347       (output v-date
      348       ,output v-time
      349       ) .
      350     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      351   end.
      352   function cur-time-string-sec returns character
      353   :
      354     define variable v-date as date      no-undo .
      355     define variable v-time as integer   no-undo .
      356     run cur-time in this-procedure
      357       (output v-date
      358       ,output v-time
      359       ) .
      360     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      361   end.
      362   function cur-time-custom  returns character
      363   (input p-prefix as character
      364   ,input p-date-format as character
      365   ,input p-delimiter as character
      366   ,input p-time-format as character
      367   ,input p-suffix as character
      368   )
      369   :
      370     define variable v-date as date      no-undo .
      371     define variable v-time as integer   no-undo .
      372     run cur-time in this-procedure
      373       (output v-date
      374       ,output v-time
      375       ) .
      376     return
      377       p-prefix
      378       + string(v-date, p-date-format)
      379       + p-delimiter
      380       + string(v-time, p-time-format)
      381       + p-suffix
      382       .
      383   end.
      384   function cur-time-print  returns character
      385   :
      386     define variable v-date as date      no-undo .
      387     define variable v-time as integer   no-undo .
      388     run cur-time in this-procedure
      389       (output v-date
      390       ,output v-time
      391       ) .
      392     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      393   end.
      394   function cur-time-datetime returns datetime
      395   :
      396     define variable v-char as character no-undo .
      397     define variable v-datetime as datetime no-undo .
      398     v-char = cur-time-string().
      399     v-datetime = datetime(v-char).
      400     return  v-datetime.
      401   end.
      402   function cur-time-string-msec returns character
      403   :
      404     define variable v-date as datetime  no-undo .
      405     v-date = now.
      406     return string(v-date) .
      407   end.
      408   define variable vss-include-info3 as character format "X(65)" no-undo
      409   initial "@(#)$Workfile$ $Revision$".
      410   procedure xmlchar-test :
      411   define input parameter p-in-string          as character        no-undo.
      412   define output parameter p-out-string-enc    as character        no-undo.
      413   define output parameter p-out-string-dec    as character        no-undo.
      414   do
      415   on error undo, return error
      416   :
      417          run xmlchar-encode in this-procedure
      418       (
      419             input p-in-string
      420           , output p-out-string-enc
      421       ).
      422          run xmlchar-decode in this-procedure
      423       (
      424             input p-out-string-enc
      425           , output p-out-string-dec
      426       ).
      427   end.
      428   end .
      429   procedure xmlchar-encode :
      430   define input parameter p-in-string      as character        no-undo.
      431   define output parameter p-out-string    as character        no-undo.
      432       define variable v-position      as integer      no-undo.
      433       define variable v-current-char  as character    no-undo.
      434   do
      435   on error undo, return error
      436   :
      437       assign
      438           p-out-string = "":U
      439       .
      440       case p-in-string
      441       :
      442           when ?
      443           then do:
      444               assign
      445                   p-out-string = "?":U
      446               .
      447           end.
      448           when "?":U
      449           then do:
      450               assign
      451                   p-out-string = "&#63;":U
      452               .
      453           end.
      454           otherwise do:
      455               do v-position = 1 to length( p-in-string )
      456               :
      457                   assign
      458                       v-current-char = substring( p-in-string, v-position, 1 )
      459                   .
      460                   case v-current-char
      461                   :
      462                       when "&":U
      463                       then do:
      464                           assign
      465                               p-out-string = p-out-string + "&amp;":U
      466                           .
      467                       end.
      468                       when ">":U
      469                       then do:
      470                           assign
      471                               p-out-string = p-out-string + "&gt;":U
      472                           .
      473                       end.
      474                       when "<":U
      475                       then do:
      476                           assign
      477                               p-out-string = p-out-string + "&lt;":U
      478                           .
      479                       end.
      480                       when "'":U
      481                       then do:
      482                           assign
      483                               p-out-string = p-out-string + "&apos;":U
      484                           .
      485                       end.
      486                       when '"':U
      487                       then do:
      488                           assign
      489                               p-out-string = p-out-string + "&quot;":U
      490                           .
      491                       end.
      492                       when chr(1)
      493                       then do:
      494                           assign
      495                               p-out-string = p-out-string + "":U
      496                           .
      497                       end.
      498                       when chr(2)
      499                       then do:
      500                           assign
      501                               p-out-string = p-out-string + "":U
      502                           .
      503                       end.
      504                       when chr(3)
      505                       then do:
      506                           assign
      507                               p-out-string = p-out-string + "":U
      508                           .
      509                       end.
      510                       when chr(4)
      511                       then do:
      512                           assign
      513                               p-out-string = p-out-string + "":U
      514                           .
      515                       end.
      516                       when chr(5)
      517                       then do:
      518                           assign
      519                               p-out-string = p-out-string + "":U
      520                           .
      521                       end.
      522                       when chr(6)
      523                       then do:
      524                           assign
      525                               p-out-string = p-out-string + "":U
      526                           .
      527                       end.
      528                       when chr(7)
      529                       then do:
      530                           assign
      531                               p-out-string = p-out-string + "":U
      532                           .
      533                       end.
      534                       when chr(8)
      535                       then do:
      536                           assign
      537                               p-out-string = p-out-string + "":U
      538                           .
      539                       end.
      540                       when chr(9)
      541                       then do:
      542                           assign
      543                               p-out-string = p-out-string + "":U
      544                           .
      545                       end.
      546                       when chr(29)
      547                       then do:
      548                           assign
      549                               p-out-string = p-out-string + "":U
      550                           .
      551                       end.
      552                       when chr(10)
      553                       then do:
      554                           assign
      555                               p-out-string = p-out-string + "&#10;":U
      556                           .
      557                       end.
      558                       when chr(13)
      559                       then do:
      560                           assign
      561                               p-out-string = p-out-string + "&#13;":U
      562                           .
      563                       end.
      564                       otherwise do:
      565                           assign
      566                               p-out-string = p-out-string + v-current-char
      567                           .
      568                       end.
      569                   end case.
      570               end.
      571           end.
      572       end case.
      573   end.
      574   end .
      575   procedure xmlchar-encode-1c :
      576   define input parameter p-in-string      as character        no-undo.
      577   define output parameter p-out-string    as character        no-undo.
      578       define variable v-position      as integer      no-undo.
      579       define variable v-current-char  as character    no-undo.
      580   do
      581   on error undo, return error
      582   :
      583       assign
      584           p-out-string = "":U
      585       .
      586       case p-in-string
      587       :
      588           when ?
      589           then do:
