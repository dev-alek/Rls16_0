     3556               ).
     3557               undo, return error .
     3558           end.
     3559           run bge-xml-write-header in this-procedure (
     3560                 input v-xml-file-name
     3561               , input v-xml-file-name + "xml"
     3562               , input "15.0 " + replace( vss-revision + vss-date, "$", " " )
     3563               , input 0
     3564               , input buf_shift-obj.shift-date
     3565               , input buf_shift-obj.shift-num
     3566               , input buf_shift-obj.shift-date
     3567               , input buf_shift-obj.shift-num
     3568               , input p-obj-list
     3569               , input "":U
     3570               , input no
     3571               , input no
     3572               , input no
     3573               , input no
     3574               , input no
     3575               , input no
     3576               , input no
     3577               , input no
     3578           ).
     3579           run bge/sht-reestr.p (
     3580                 input p-obj-type
     3581               , input p-obj-code
     3582               , input buf_shift-obj.shift-date
     3583               , input buf_shift-obj.shift-num
     3584               , input v-xml-file-name
     3585               , input p-log-file-name
     3586               , input hEDT
     3587               , input hCNT
     3588           ) no-error.
     3589           if error-status :error
     3590           then do:
     3591               run wp-XMLWriteLog in this-procedure (
     3592                     input p-log-file-name
     3593                   , input 1
     3594                   , input substitute( "*** Ошибка экспорта реестра документов &1 &2. Смена  &3 от &4. &5. &6. &7."
     3595                                           , p-obj-type
     3596                                           , p-obj-code
     3597                                           , buf_shift-obj.shift-date
     3598                                           , buf_shift-obj.shift-num
     3599                                           , return-value
     3600                                           , error-status :get-message(1)
     3601                                           , error-status :get-message(2)
     3602                                           )
     3603               ).
     3604               undo export-shifts, next export-shifts.
     3605           end.
     3606           run xml-bge-write-footer in this-procedure ( input v-xml-file-name ).
     3607         end .
     3608       end.
     3609       run wp-XMLWriteLog in this-procedure (
     3610             input p-log-file-name
     3611           , input 1
     3612           , input substitute( " < Экспорт документов по сменному объекту &1 &2 завершён.", p-obj-type, p-obj-code )
     3613       ).
     3614   end.
     3615   end procedure.
     3616   procedure export-not-shifts-object :
     3617   define input parameter p-host-code      as integer      no-undo.
     3618   define input parameter p-obj-type       as character    no-undo.
     3619   define input parameter p-obj-code       as integer      no-undo.
     3620   define input parameter p-out-dir        as character        no-undo.
     3621   define input parameter p-log-file-name  as character        no-undo.
     3622       define variable v-fact-order-from   as decimal      no-undo.
     3623       define variable v-fact-order-to     as decimal      no-undo.
     3624       define variable v-docs-exists       as logical      no-undo.
     3625       define variable v-prefix            as character    no-undo.
     3626       define variable v-archive-ok        as logical      no-undo.
     3627       define variable v-comment           as character    no-undo.
     3628       define buffer buf_shift-obj     for ub.shift-obj.
     3629   do
     3630   for buf_shift-obj
     3631   on error undo, return error
     3632   :
     3633       run wp-XMLWriteLog in this-procedure (
     3634             input p-log-file-name
     3635           , input 2
     3636           , input "Расчет архивов"
     3637       ).
     3638       run bge/bge-ahzs.p (
     3639             input p-obj-type
