     2736   procedure factord-cut-archive :
     2737     define input  parameter p-obj-type             as character no-undo .
     2738     define input  parameter p-obj-code             as integer   no-undo .
     2739     define input  parameter p-fact-date            as date      no-undo .
     2740     define output parameter p-shift-on             as logical   no-undo .
     2741     define output parameter p-shift-date           as date      no-undo .
     2742     define output parameter p-shift-num            as integer   no-undo .
     2743     define output parameter p-day-end-fact-order   as decimal   no-undo .
     2744     define output parameter p-shift-end-fact-order as decimal   no-undo .
     2745     define variable v-fact-order as decimal   no-undo .
     2746     define buffer buf_shift-obj for ub.shift-obj .
     2747     do
     2748     on error undo, return error return-value
     2749     :
     2750   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2751   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2752     (input  p-obj-type
     2753     ,input  p-obj-code
     2754     ,input  'shift-on=request'
     2755     ,output p-shift-on
     2756     ) no-error .
     2757       if error-status :error
     2758       then do:
     2759         message
     2760           vss-workfile vss-revision vss-description skip
     2761           "Ошибка при определении атрибута объекта" skip
     2762           "Объект" p-obj-type p-obj-code skip
     2763           error-status :get-message(1) skip
     2764           return-value skip
     2765           view-as alert-box error .
     2766         undo, return error return-value .
     2767       end.
     2768       if p-shift-on = false
     2769       then do:
     2770         assign
     2771           p-shift-date               = ?
     2772           p-shift-num                = 0
     2773         .
     2774       end.
     2775       else do:
     2776         find first buf_shift-obj share-lock
     2777           where buf_shift-obj.obj-type   = p-obj-type
     2778             and buf_shift-obj.obj-code   = p-obj-code
     2779             and buf_shift-obj.shift-date > p-fact-date
     2780           use-index pi
     2781           no-error .
     2782         if not available buf_shift-obj
     2783         or buf_shift-obj.status_ <> 'зкр':U
     2784         then do:
     2785           message
     2786             vss-workfile vss-revision vss-description skip
     2787             "Невозможно вычислить последнюю смену" skip
     2788             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2789             "Объект" p-obj-type p-obj-code skip
     2790             "Дата" p-fact-date skip
     2791             view-as alert-box error .
     2792           undo, return error return-value .
     2793         end.
     2794         find last buf_shift-obj share-lock
     2795           where buf_shift-obj.obj-type = p-obj-type
     2796             and buf_shift-obj.obj-code = p-obj-code
     2797             and buf_shift-obj.shift-date <= p-fact-date
     2798           use-index pi
     2799           no-error .
     2800         if available buf_shift-obj
     2801         then do:
     2802           if  buf_shift-obj.status_ = 'зкр':U
     2803           then do:
     2804             assign
     2805               p-shift-date = buf_shift-obj.shift-date
     2806               p-shift-num  = buf_shift-obj.shift-num
     2807             .
     2808           end.
     2809           else do:
     2810             message
     2811               vss-workfile vss-revision vss-description skip
     2812               "Невозможно вычислить последнюю смену" skip
     2813               "Статус смены отличен от статуса" 'зкр':U skip
     2814               "Объект" p-obj-type p-obj-code skip
     2815               "Дата" p-fact-date skip
     2816               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2817               view-as alert-box error .
     2818             undo, return error return-value .
     2819           end.
     2820         end.
     2821         else do:
     2822           assign
     2823             p-shift-date = p-fact-date - 1
     2824             p-shift-num  = 1
     2825           .
     2826         end.
     2827       end.
     2828       run factord in this-procedure
     2829         (input  p-fact-date
     2830         ,input  1
     2831         ,input  1
     2832         ,input  p-shift-date
     2833         ,input  p-shift-num
     2834         ,input  p-shift-on
     2835         ,output v-fact-order
     2836         ,output p-shift-end-fact-order
     2837         ,output p-day-end-fact-order
     2838         ) no-error .
     2839       if error-status :error
     2840       then do:
     2841         message
     2842           vss-workfile vss-revision vss-description skip
     2843           "Ошибка при вызове процедуры factord"
     2844           error-status :get-message(1) skip
     2845           return-value skip
     2846           view-as alert-box error .
     2847         undo, return error return-value .
     2848       end.
     2849     end.
     2850   end procedure.
     2851   procedure factord-lock-shift :
     2852     define input  parameter p-obj-type  as character no-undo .
     2853     define input  parameter p-obj-code  as integer   no-undo .
     2854     define input  parameter p-fact-date as date      no-undo .
     2855     define parameter buffer buf_shift-obj for ub.shift-obj .
     2856     define variable v-shift-on      as logical   no-undo .
     2857     define variable v-extra-message as character no-undo .
     2858     define variable v-error as character no-undo .
     2859     do
     2860     on error undo, return error return-value
     2861     :
     2862   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2863   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2864     (input  p-obj-type
     2865     ,input  p-obj-code
     2866     ,input  'shift-on=request'
     2867     ,output v-shift-on
     2868     ) no-error .
     2869       if error-status :error
     2870       then do:
     2871         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2872         undo, return error v-error .
     2873       end.
     2874       if v-shift-on = true
     2875       then do:
     2876         find first buf_shift-obj share-lock
     2877           where buf_shift-obj.obj-type   = p-obj-type
     2878             and buf_shift-obj.obj-code   = p-obj-code
     2879             and buf_shift-obj.shift-date > p-fact-date
     2880           use-index pi
     2881           no-error .
     2882         if not available buf_shift-obj
     2883         or buf_shift-obj.status_ <> 'зкр':U
     2884         then do:
     2885           find last buf_shift-obj
     2886             where buf_shift-obj.obj-type = p-obj-type
     2887               and buf_shift-obj.obj-code = p-obj-code
     2888               and buf_shift-obj.status_  = 'зкр':U
     2889             use-index stts
     2890             no-error .
     2891           if available buf_shift-obj
     2892           then do:
     2893             assign
     2894               v-extra-message =
     2895                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2896                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2897                               )
     2898             .
     2899           end.
     2900           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2901           undo, return error v-error .
     2902         end.
     2903       end.
     2904     end.
     2905   end procedure.
     2906   procedure factord-end-day :
     2907     define input  parameter p-fact-date            as date    no-undo .
     2908     define output parameter p-day-end-fact-order   as decimal no-undo .
     2909     do
     2910     on error undo, return error return-value
     2911     :
     2912       if p-fact-date = ?
     2913       then do:
     2914         return error "Не указана фактическая дата" .
     2915       end.
     2916       assign
     2917         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2918       .
     2919     end.
     2920   end procedure.
     2921   procedure factord-to-date :
     2922     define input  parameter p-fact-order as decimal no-undo .
     2923     define output parameter p-fact-date  as date    no-undo .
     2924     define variable v-ref-date  as date      no-undo .
     2925     define variable v-ref-delta as integer   no-undo .
     2926     do
     2927     on error undo, return error return-value
     2928     :
     2929       if p-fact-order = ?
     2930       or p-fact-order = 0
     2931       then do:
     2932         return error "Не указан fact-order" .
     2933       end.
     2934       assign
     2935         v-ref-date  = date(1, 1, 2000)
     2936       .
     2937       assign
     2938         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2939       .
     2940       assign
     2941         p-fact-date = v-ref-date + v-ref-delta
     2942       .
     2943     end.
     2944   end procedure.
     2945   procedure factord-to-fact-num :
     2946     define input  parameter p-fact-order as decimal no-undo .
     2947     define output parameter p-fact-num   as integer no-undo .
     2948     define variable v-fact-order-trunc as decimal no-undo .
     2949     do
     2950     on error undo, return error return-value
     2951     :
     2952       if p-fact-order = ?
     2953       or p-fact-order = 0
     2954       then do:
     2955         return error "Не указан fact-order" .
     2956       end.
     2957       assign
     2958        v-fact-order-trunc = truncate(p-fact-order, 2)
     2959       .
     2960       assign
     2961         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2962       .
     2963     end.
     2964   end procedure.
     2965   procedure factord-to-shift-num :
     2966     define input  parameter p-fact-order as decimal no-undo .
     2967     define output parameter p-shift-num   as integer no-undo .
     2968     define variable  p-shift-numd  as decimal   no-undo .
     2969     define variable v-fact-order-trunc as decimal no-undo .
     2970     do
     2971     on error undo, return error return-value
     2972     :
     2973       if p-fact-order = ?
     2974       or p-fact-order = 0
     2975       then do:
     2976         return error "Не указан fact-order" .
     2977       end.
     2978       assign
     2979        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2980       .
     2981       if v-fact-order-trunc < 0.5 then do:
     2982         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2983       end.
     2984       assign
     2985         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2986         .
     2987        assign
     2988         p-shift-num = truncate (p-shift-numd , 0)
     2989       .
     2990     end.
     2991   end procedure.
