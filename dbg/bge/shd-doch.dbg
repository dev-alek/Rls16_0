     3320           then do:
     3321               run wp-XMLWriteLog in this-procedure (
     3322                     input p-log-file-name
     3323                   , input 1
     3324                   , input substitute( "*** Ошибка выгрузки: Файл выгрузки &1 заблокирован другим процессом.", v-xml-file-name )
     3325               ).
     3326               undo, return error .
     3327           end.
     3328           run bge-xml-write-header in this-procedure (
     3329                 input v-xml-file-name
     3330               , input v-xml-file-name + "xml"
     3331               , input "15.0 " + replace( vss-revision + vss-date, "$", " " )
     3332               , input p-db-num
     3333               , input buf_shift-obj.shift-date
     3334               , input buf_shift-obj.shift-num
     3335               , input buf_shift-obj.shift-date
     3336               , input buf_shift-obj.shift-num
     3337               , input p-obj-list
     3338               , input p-doc-type-list
     3339               , input p-pay-code
     3340               , input p-cst
     3341               , input p-parts
