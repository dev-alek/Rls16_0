     1082   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1083                                             INPUT iFlagEmpty AS INTEGER).
     1084       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1085       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1086           DO:
     1087               IF iFlagEmpty = 0                           THEN RETURN "".
     1088               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1089               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1090               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1091               ELSE RETURN "".
     1092           END.
     1093       ELSE DO:
     1094           run xmlchar-encode in this-procedure (
     1095                 input sToPlace
     1096               , output sToPlace
     1097           ).
     1098           ASSIGN
     1099               sToPlace = sParName + '="' + sToPlace + '"'
     1100           .
     1101           RETURN sToPlace.
     1102       END.
     1103   END FUNCTION.
     1104   function bge-xml-date returns character
     1105   ( input p-date as date )
     1106   :
     1107     define variable v-date-str as character no-undo .
     1108     run bge-xml-date-to-str in this-procedure ( input   p-date
     1109                                               , output  v-date-str
     1110                                               ) .
     1111     return v-date-str.
     1112   end function.
     1113   function bge-xml-str-date returns character
     1114   ( input p-date-str as character )
     1115   :
     1116     define variable v-date-str as character no-undo .
     1117     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1118                                                   , output  v-date-str
     1119                                                   ) .
     1120     return v-date-str.
     1121   end function.
     1122   function bge-xml-normalize-dec returns decimal
     1123   ( input p-val as decimal )
     1124   :
     1125     return (if p-val = ? then 0 else p-val) .
     1126   end function.
     1127   PROCEDURE wp-XMLTagOpen:
     1128   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1129   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1130   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1131       define variable v-out-string    as character    no-undo.
     1132   do
     1133   on error undo, return error
     1134   :
     1135       if v-bge-xml-bgefmt = "dbf":U
     1136       then do:
     1137       end.
     1138       else do:
     1139           assign
     1140               v-out-string = substitute( "&1&2<&3&4>"
     1141                                       , chr(10)
     1142                                       , fill( " ":U, 4 * iTagLevel)
     1143                                       , sTagName
     1144                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1145                               )
     1146           .
     1147           put stream stmXMLOut unformatted
     1148               v-out-string
     1149           .
     1150       end.
     1151   end.
     1152   END PROCEDURE.
     1153   PROCEDURE wp-XMLTagPut:
     1154     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1155     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1156     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1157     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1158       define variable v-out-string    as character    no-undo.
     1159   do
     1160   on error undo, return error
     1161   :
     1162       if v-bge-xml-bgefmt = "dbf":U
     1163       then do:
     1164           if v-bge-xml-dbf-file-name <> "":U
     1165           then do:
     1166               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1167               export stream stmXMLOut
     1168                   sTagName
     1169                   sParValue
     1170               .
     1171               output stream stmXMLOut close.
     1172           end.
     1173       end.
     1174       else do:
     1175           IF  iFlagEmpty = 1
     1176           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1177           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1178           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1179           THEN DO:
     1180               run xmlchar-encode in this-procedure (
     1181                   input sParValue
     1182                   , output sParValue
     1183               ).
     1184               assign
     1185                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1186                                               , chr(10)
     1187                                               , FILL(" ", 4 * iTagLevel)
     1188                                               , sTagName
     1189                                               , sParValue
     1190                               )
     1191               .
     1192               PUT STREAM stmXMLOut UNFORMATTED
     1193                   v-out-string
     1194               .
     1195           END.
     1196       end.
     1197   end.
     1198   END PROCEDURE.
     1199   PROCEDURE wp-XMLTagClose:
     1200   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1201   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1202       define variable v-out-string    as character    no-undo.
     1203   do
     1204   on error undo, return error
     1205   :
     1206       if v-bge-xml-bgefmt = "dbf":U
     1207       then do:
     1208       end.
     1209       else do:
     1210           assign
     1211               v-out-string = substitute( "&1&2</&3>"
     1212                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1213                                   , fill( " ", 4 * iTagLevel )
     1214                                   , sTagName
     1215                           )
     1216           .
     1217           PUT STREAM stmXMLOut UNFORMATTED
     1218               v-out-string
     1219           .
     1220       end.
     1221   end.
     1222   END PROCEDURE.
     1223   PROCEDURE wp-XMLWriteLog:
     1224     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1225     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1226     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1227   define variable v-str              as character no-undo .
     1228   define variable v-error-append     as logical   no-undo .
     1229   define variable v-error-append-msg as character no-undo .
     1230   assign
     1231     v-str = chr(10)
     1232             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1233             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1234     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1235     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1236     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1237   .
     1238   run bge/bge-log.p (input v-str) no-error .
     1239   if error-status:error then do:
     1240     assign
     1241       v-error-append     = yes
     1242       v-error-append-msg = return-value
     1243     .
     1244   end.
     1245   run gbl/fileapnd.p
     1246     ( input sFileName
     1247     , input v-str
     1248     , input 10
     1249     ) no-error .
     1250   if error-status:error then do:
     1251     assign
     1252       v-error-append     = yes
     1253       v-error-append-msg = substitute( "&1&2&3"
     1254                                       , v-error-append-msg
     1255                                       , chr(10)
     1256                                       , return-value
     1257                                       )
     1258     .
     1259   end.
     1260   if v-error-append
     1261   then do:
     1262     return error substitute( "&1" , v-error-append-msg ) .
     1263   end.
     1264   END PROCEDURE.
     1265   PROCEDURE wp-XMLWriteEDT:
     1266     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1267     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1268     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1269       if valid-handle ( hEDT )
     1270       then do:
     1271           hEDT :move-to-eof().
     1272           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1273                                           OR sToWrite = "&Line") THEN "" ELSE
     1274                                           cur-time-string-sec() + " ").
     1275           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1276                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1277                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1278           hEDT :insert-string(chr(10)).
     1279       end.
     1280       process events.
     1281       output to 'bgescn.txt' append.
     1282           put unformatted
     1283               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1284                                           OR sToWrite = "&Line") THEN "" ELSE
     1285                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1286               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1287                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1288                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1289           .
     1290       output close.
     1291   END PROCEDURE.
     1292   PROCEDURE wp-XMLShowCNT:
     1293     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1294       if valid-handle( hCNT )
     1295       then do:
     1296           ASSIGN hCNT :VISIBLE = TRUE.
     1297       end.
     1298   END PROCEDURE.
     1299   PROCEDURE wp-XMLHideCNT:
     1300     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1301       if valid-handle( hCNT )
     1302       then do:
     1303           ASSIGN hCNT :VISIBLE = FALSE.
     1304       end.
     1305   END PROCEDURE.
     1306   PROCEDURE wp-XMLWriteCNT:
     1307     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1308     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1309       if valid-handle( hCNT )
     1310       then do:
     1311           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1312       end.
     1313   END PROCEDURE.
     1314   procedure bge-xml-write-header:
     1315   do
     1316   on error undo, return error
     1317   :
     1318   define input parameter p-xml-file-name  as character        no-undo.
     1319   define input parameter p-doc-name       as character        no-undo.
     1320   define input parameter p-version        as character        no-undo.
     1321   define input parameter p-db-num         as integer          no-undo.
     1322   define input parameter p-date-from      as date             no-undo.
     1323   define input parameter p-shift-num-from as integer          no-undo.
     1324   define input parameter p-date-to        as date             no-undo.
     1325   define input parameter p-shift-num-to   as integer          no-undo.
     1326   define input parameter p-obj-list       as character        no-undo.
     1327   define input parameter p-doc-type-list  as character        no-undo.
     1328   define input parameter p-pay-code       as logical          no-undo.
     1329   define input parameter p-cst            as logical          no-undo.
     1330   define input parameter p-parts          as logical          no-undo.
     1331   define input parameter p-chk-pay-code   as logical          no-undo.
     1332   define input parameter p-pay-desk       as logical          no-undo.
     1333   define input parameter p-pay-desk-cards as logical          no-undo.
     1334   define input parameter p-deleted        as logical          no-undo.
     1335   define input parameter p-opened-docs    as logical          no-undo.
     1336   define variable v-out-string    as character    no-undo.
     1337   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1338   assign
     1339       v-out-string = substitute( "&1&2&3"
     1340                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1341                           , chr(10)
     1342                           , "<IBS_Trade_House>":U )
     1343   .
     1344   put stream stmXMLOut unformatted
     1345       v-out-string
     1346   .
     1347   run wp-XMLTagOpen(1, "header","").
     1348   if v-bge-xml-bgeflold = "oracle":u
     1349   then do:
     1350     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1351     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1352     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1353     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1354     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1355   end.
     1356   run wp-XMLTagOpen( 2, "manifest", "").
     1357   run wp-XMLTagOpen( 3, "document", "").
     1358   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1359   run wp-XMLTagput( 4, "description", "", 0).
     1360   run wp-XMLTagput( 4, "version", p-version, 0).
     1361   run wp-XMLTagclose( 3, "document" ).
     1362   run wp-XMLTagclose( 2, "manifest" ).
     1363   run wp-XMLTagclose( 1, "header" ).
     1364   run wp-XMLTagOpen(1, "options","").
     1365   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1366   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1367   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1368   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1369   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1370   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1371   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1372   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1373   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1374   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1375   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1376   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1377   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1378   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1379   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1380   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1381   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1382   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1383   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1384   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1385   run wp-XMLTagClose(1, "options").
     1386   run wp-XMLTagOpen( 1, "body", "" ).
     1387   output stream stmXMLOut close.
     1388   end.
     1389   end procedure.
     1390   procedure xml-bge-write-footer:
     1391   do
     1392   on error undo, return error return-value
     1393   :
     1394   define input parameter p-xml-file-name as character    no-undo.
     1395   define variable v-error-num     as integer           no-undo.
     1396   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1397   run wp-XMLTagClose( 1, "body" ).
     1398   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1399   output stream stmXMLOut close.
     1400   if v-bge-xml-bgeflold = "oracle":u
     1401   then do:
     1402     define variable v-tmp-file-name         as character no-undo .
     1403     define variable v-zip-file-name         as character no-undo .
     1404     define variable v-exch-file-name        as character no-undo .
     1405     define variable v-heap-file-name        as character no-undo .
     1406     define variable v-i                     as integer   no-undo .
     1407     define variable v-file-name             as character no-undo .
     1408     define variable v-arc                   as character no-undo .
     1409     define variable v-str                   as character no-undo .
     1410     define variable v-exch-tmp-file-name    as character no-undo .
     1411     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1412     define variable v-bge-xml-exch-dir      as character no-undo .
     1413     define variable v-bge-xml-heap-dir      as character no-undo .
     1414     define variable v-bge-xml-compress-heap as logical   no-undo .
     1415     define variable v-home-dir              as character no-undo .
     1416     define variable v-os-command            as character no-undo .
     1417     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1418     if v-home-dir = ?
     1419     then do:
     1420       undo, return error substitute( "&1&2&3"
     1421                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1422                                     , chr(10)
     1423                                     , "Обратитесь к администратору.":u
     1424                                     ).
     1425     end.
     1426     assign
     1427       v-home-dir = v-home-dir
     1428     .
     1429     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1430     if error-status :error
     1431     then do:
     1432       undo, return error substitute( "&1&2&3"
     1433                                     , "Неверно задан каталог экспорта.":u
     1434                                     , chr(10)
     1435                                     , "Обратитесь к администратору.":u
     1436                                     ).
     1437     end.
     1438     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1439     if v-bge-xml-exch-dir = ?
     1440     then do:
     1441       undo, return error substitute( "&1&2&3"
     1442                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1443                                     , chr(10)
     1444                                     , "Обратитесь к администратору.":u
     1445                                     ).
     1446     end.
     1447     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1448     if error-status :error
     1449     then do:
     1450       undo, return error substitute( "&1&2&3"
     1451                                     , "Неверно задан каталог экспорта (exch).":u
     1452                                     , chr(10)
     1453                                     , "Обратитесь к администратору.":u
     1454                                     ).
     1455     end.
     1456     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1457     if v-bge-xml-heap-dir = ?
     1458     then do:
     1459       undo, return error substitute( "&1&2&3"
     1460                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1461                                     , chr(10)
     1462                                     , "Обратитесь к администратору.":u
     1463                                     ).
     1464     end.
     1465     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1466     if error-status :error
     1467     then do:
     1468       undo, return error substitute( "&1&2&3"
     1469                                     , "Неверно задан каталог экспорта (heap).":u
     1470                                     , chr(10)
     1471                                     , "Обратитесь к администратору.":u
     1472                                     ).
     1473     end.
     1474     get-key-value section "BGE" key "heap-compress" value v-str.
     1475     assign
     1476       v-i = int(v-str)
     1477     no-error .
     1478     if v-i = ? or v-i = 0
     1479     then do:
     1480       assign
     1481         v-bge-xml-compress-heap = no
     1482       .
     1483     end.
     1484     else do:
     1485       assign
     1486         v-bge-xml-compress-heap = yes
     1487       .
     1488     end.
     1489     assign
     1490       v-arc = search( "exe/7za.exe":u )
     1491     .
     1492     if v-arc = ? or v-arc = ""
     1493     then do:
     1494       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1495     end.
     1496     assign
     1497       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1498       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1499       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1500       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1501       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1502       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1503       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1504     .
     1505     run gbl/del-file.p (input v-tmp-file-name) .
     1506     run gbl/del-file.p (input v-zip-file-name) .
     1507     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1508     if v-error-num > 0
     1509     then do:
     1510         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1511                                      , p-xml-file-name + "xm1":u
     1512                                      , v-tmp-file-name
     1513                                      , v-error-num
     1514                                      ).
     1515     end.
     1516     assign
     1517       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1518                                    , v-arc
     1519                                    , v-zip-file-name
     1520                                    , v-tmp-file-name
     1521                                    )
     1522     .
     1523     os-command silent value ( v-os-command ) .
     1524     run gbl/del-file.p (input v-heap-file-name) .
     1525     if v-bge-xml-compress-heap = no
     1526     then do:
     1527       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1528       if v-error-num > 0
     1529       then do:
     1530           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1531                                        , v-tmp-file-name
     1532                                        , v-heap-file-name
     1533                                        , v-error-num
     1534                                        ) .
     1535       end.
     1536     end.
     1537     else do:
     1538       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1539       if v-error-num > 0
     1540       then do:
     1541           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1542                                        , v-zip-file-name
     1543                                        , v-heap-file-name
     1544                                        , v-error-num
     1545                                        ) .
     1546       end.
     1547     end.
     1548     run gbl/del-file.p (input v-tmp-file-name) .
     1549     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1550     if error-status :error then do:
     1551       undo, return error substitute( "&1&2&3"
     1552                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1553                                     , chr(10)
     1554                                     , "Обратитесь к администратору."
     1555                                     ).
     1556     end.
     1557     run gbl/del-file.p (input v-exch-file-name) .
     1558     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1559     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1560     if v-error-num > 0
     1561     then do:
     1562       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1563                                     , v-zip-file-name
     1564                                     , v-exch-tmp-file-name
     1565                                     , v-error-num
     1566                                     ) .
     1567     end.
     1568     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1569     if v-error-num > 0
     1570     then do:
     1571       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1572                                     , v-exch-tmp-file-name
     1573                                     , v-exch-file-name
     1574                                     , v-error-num
     1575                                     ) .
     1576     end.
     1577     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1578   end.
     1579   else do:
     1580     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1581     if v-error-num > 0
     1582     then do:
     1583       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1584                                     , p-xml-file-name + "xm1"
     1585                                     , p-xml-file-name + "xml"
     1586                                     , v-error-num
     1587                                     ) .
     1588     end.
     1589   end.
     1590   if opsys = "unix"
     1591   then do:
     1592       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1593   end.
     1594   end.
     1595   end procedure.
     1596   procedure xml-bge-filename0:
     1597   define input parameter p-prefix   as character no-undo .
     1598   define input parameter p-name     as character no-undo .
     1599   define input parameter p-shared-process as logical no-undo .
     1600   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1601   define output parameter p-xml-file-name  as character no-undo .
     1602   // define output parameter p-fullfnamenoext as character no-undo .
     1603   define output parameter p-locked         as logical      no-undo.
     1604   define variable v-fullfnamenoext as character no-undo .
     1605   define variable v-fileext        as character no-undo .
     1606   define variable v-fullfname      as character no-undo .
     1607   define variable v-error-num      as integer   no-undo .
     1608   do
     1609   on error undo, return error
     1610   :
     1611     case v-bge-xml-bgeflold :
     1612       when "old" then do:
     1613         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1614         v-fileext       = ".xml":U .
     1615         v-fullfname     = v-fullfnamenoext + v-fileext .
     1616         p-xml-file-name = v-fullfname .
     1617         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1618         if v-error-num > 0 then do:
     1619           return error.
     1620         end.
     1621       end.
     1622       when "var" then do:
     1623         case p-prefix :
     1624           when "doc" then do:
     1625             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1626             v-fileext       = ".xml":U .
     1627             v-fullfname     = v-fullfnamenoext + v-fileext .
     1628             p-xml-file-name = v-fullfname .
     1629           end.
     1630           when "day" then do:
     1631             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1632             v-fileext       = ".xml":U .
     1633             v-fullfname     = v-fullfnamenoext + v-fileext .
     1634             p-xml-file-name = v-fullfname .
     1635           end.
     1636           otherwise do:
     1637             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1638             v-fileext       = ".xml":U .
     1639             v-fullfname     = v-fullfnamenoext + v-fileext .
     1640             p-xml-file-name = v-fullfname .
     1641           end.
     1642         end case.
     1643         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1644         if v-error-num > 0 then do:
     1645           return error.
     1646         end.
     1647       end.
     1648       when "new" then do:
     1649                   run bge/genfname.p (
     1650                       input p-home-dir
     1651                       , input p-prefix
     1652                       , input ""
     1653                       , input "xml"
     1654                       , input ""
     1655                       , output p-xml-file-name
     1656                   ).
     1657       end.
     1658       when "no-parameter" then do:
     1659         if p-shared-process then do:
     1660                       run bge/genfname.p (
     1661                           input p-home-dir
     1662                           , input "d"
     1663                           , input ""
     1664                           , input "xml"
     1665                           , input ""
     1666                           , output p-xml-file-name
     1667                       ).
     1668         end.
     1669         else do:
     1670           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1671           v-fileext       = ".xml":U .
     1672           v-fullfname     = v-fullfnamenoext + v-fileext .
     1673           p-xml-file-name = v-fullfname .
     1674           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1675           if v-error-num > 0 then do:
     1676             return error.
     1677           end.
     1678         end.
     1679       end.
     1680     end case.
     1681     assign
     1682       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1683       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1684     .
     1685   end .
     1686   end procedure .
     1687   procedure xml-bge-filename :
     1688   do
     1689   on error undo, return error
     1690   :
     1691   define input parameter p-prefix             as character    no-undo.
     1692   define input parameter p-name               as character    no-undo.
     1693   define input parameter p-shared-process     as logical      no-undo.
     1694   define output parameter p-xml-file-name     as character    no-undo.
     1695   define output parameter p-log-file-name     as character    no-undo.
     1696   define output parameter p-locked            as logical      no-undo.
     1697   define variable v-home-dir          as character no-undo .
     1698   define variable v-error-num         as integer   no-undo .
     1699   define variable v-bge-xml-heap-dir  as character no-undo .
     1700       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1701       if v-home-dir = ?
     1702       then do:
     1703           message
     1704             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1705             skip(1)
     1706             skip "Обратитесь к администратору."
     1707           view-as alert-box error.
     1708           undo, return error .
     1709       end.
     1710       if v-bge-xml-bgeflold <> "oracle"
     1711       then do:
     1712         assign
     1713             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1714         .
     1715       end.
     1716       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1717       if error-status :error
     1718       then do:
     1719           message
     1720             skip "Неверно задан каталог экспорта."
     1721             skip(1)
     1722             skip "Обратитесь к администратору."
     1723           view-as alert-box error.
     1724           undo, return error .
     1725       end.
     1726       if v-bge-xml-bgefmt = "dbf":U
     1727       then do:
     1728           assign
     1729               p-xml-file-name = v-home-dir
     1730               p-locked        = no
     1731           .
     1732       end.
     1733       else do:
     1734           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1735             output p-xml-file-name, output p-locked) .
     1736       end.
     1737       if v-bge-xml-bgeflold = "oracle"
     1738       then do:
     1739         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1740         if v-bge-xml-heap-dir = ?
     1741         then do:
     1742           undo, return error substitute( "&1&2&3"
     1743                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1744                                         , chr(10)
     1745                                         , "Обратитесь к администратору.":u
     1746                                         ).
     1747         end.
     1748         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1749         if error-status :error
     1750         then do:
     1751           undo, return error substitute( "&1&2&3"
     1752                                         , "Неверно задан каталог экспорта (heap).":u
     1753                                         , chr(10)
     1754                                         , "Обратитесь к администратору.":u
     1755                                         ).
     1756         end.
     1757         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1758           assign
     1759             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1760           .
     1761         end.
     1762         else do:
     1763           assign
     1764             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1765           .
     1766         end.
     1767       end.
     1768       else do:
     1769         assign
     1770             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1771         .
     1772       end.
     1773       assign
     1774          v-bge-xml-static-log-file-name = p-log-file-name
     1775       .
     1776   end.
     1777   end procedure.
     1778   procedure bge-xml-read-config :
     1779   do
     1780   on error undo, return error return-value
     1781   :
     1782   define input  parameter p-last-date as date      no-undo .
     1783   define input  parameter p-db-num    as integer   no-undo .
     1784       define variable v-bgeclall      as character     no-undo.
     1785       define variable v-bgedict       as character     no-undo.
     1786       define variable v-bgeshift      as character     no-undo.
     1787       define variable v-par-type      as character     no-undo.
     1788       define variable v-bgeflnm       as character     no-undo.
     1789       define variable v-bgecliiv      as character     no-undo .
     1790       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1791       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1792       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1793       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1794       define variable v-db-num-str    as character     no-undo .
     1795       define variable v-param-type      as character  no-undo .
     1796       define variable v-value-character as character  no-undo .
     1797       define variable v-value-date      as date       no-undo .
     1798       define variable v-value-decimal   as decimal    no-undo .
     1799       define variable v-value-integer   as integer    no-undo .
     1800       define variable v-value-logical   as logical    no-undo .
     1801       define variable v-tth             as handle      no-undo .
     1802       run adm/shattri.p ( input "get":U
     1803                         , input  '':u
     1804                         , input  0
     1805                         , input  'bge-export':U
     1806                         , input  'bgeclall':U
     1807                         , output v-bgecliiv
     1808                         , output v-value-date
     1809                         , output v-value-decimal
     1810                         , output v-value-integer
     1811                         , output v-value-logical
     1812                         , output v-param-type
     1813                         , input-output table-handle v-tth
     1814                         ) no-error .
     1815       if error-status :error
     1816       then do:
     1817         assign
     1818           v-bge-xml-bgecliiv = no
     1819         .
     1820       end.
     1821       else do:
     1822         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1823       end.
     1824       delete object v-tth.
     1825       assign
     1826           v-bge-xml-bgeclall = no
     1827           v-bge-xml-bgedict  = no
     1828       .
     1829       run adm/shattri.p ( input "get":U
     1830                         , input  '':u
     1831                         , input  0
     1832                         , input  'bge-export':U
     1833                         , input  'bgeclall':U
     1834                         , output v-value-character
     1835                         , output v-value-date
     1836                         , output v-value-decimal
     1837                         , output v-value-integer
     1838                         , output v-value-logical
     1839                         , output v-param-type
     1840                         , input-output table-handle v-tth
     1841                         ) no-error .
     1842       if error-status :error
     1843       then do:
     1844         assign
     1845           v-bge-xml-bgeclall = no
     1846         .
     1847       end.
     1848       else do:
     1849         assign
     1850           v-bge-xml-bgeclall = v-value-logical
     1851         .
     1852       end.
     1853       delete object v-tth.
     1854       run adm/shattri.p ( input "get":U
     1855                         , input  '':u
     1856                         , input  0
     1857                         , input  'bge-export':U
     1858                         , input  'bgedict':U
     1859                         , output v-value-character
     1860                         , output v-value-date
     1861                         , output v-value-decimal
     1862                         , output v-value-integer
     1863                         , output v-value-logical
     1864                         , output v-param-type
     1865                         , input-output table-handle v-tth
     1866                         ) no-error .
     1867       if error-status :error
     1868       then do:
     1869         assign
     1870           v-bge-xml-bgedict = no
     1871         .
     1872       end.
     1873       else do:
     1874         assign
     1875           v-bge-xml-bgedict = v-value-logical
     1876         .
     1877       end.
     1878       delete object v-tth.
     1879       run adm/shattri.p ( input "get":U
     1880                         , input  '':u
     1881                         , input  0
     1882                         , input  'bge-export':U
     1883                         , input  'bgefmt':U
     1884                         , output v-value-character
     1885                         , output v-value-date
     1886                         , output v-value-decimal
     1887                         , output v-value-integer
     1888                         , output v-value-logical
     1889                         , output v-param-type
     1890                         , input-output table-handle v-tth
     1891                         ) no-error .
     1892       if error-status :error
     1893       then do:
     1894         assign
     1895           v-bge-xml-bgefmt  = "xml":U
     1896         .
     1897       end.
     1898       else do:
     1899         assign
     1900           v-bge-xml-bgefmt  = v-value-character
     1901         .
     1902       end.
     1903       delete object v-tth.
     1904       run adm/shattri.p ( input "get":U
     1905                         , input  '':u
     1906                         , input  0
     1907                         , input  'bge-export':U
     1908                         , input  'bgeshift':U
     1909                         , output v-value-character
     1910                         , output v-value-date
     1911                         , output v-value-decimal
     1912                         , output v-value-integer
     1913                         , output v-value-logical
     1914                         , output v-param-type
     1915                         , input-output table-handle v-tth
     1916                         ) no-error .
     1917       if error-status :error
     1918       then do:
     1919         assign
     1920             v-bge-xml-shift-mode = no
     1921         .
     1922       end.
     1923       else do:
     1924         assign
     1925             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1926         .
     1927       end.
     1928       delete object v-tth.
     1929       run adm/shattri.p ( input "get":U
     1930                         , input  '':u
     1931                         , input  0
     1932                         , input  'bge-export':U
     1933                         , input  'bgeflold':U
     1934                         , output v-value-character
     1935                         , output v-value-date
     1936                         , output v-value-decimal
     1937                         , output v-value-integer
     1938                         , output v-value-logical
     1939                         , output v-param-type
     1940                         , input-output table-handle v-tth
     1941                         ) no-error .
     1942       if error-status :error
     1943       then do:
     1944         assign
     1945           v-bge-xml-bgeflold = "no-parameter":U
     1946         .
     1947       end.
     1948       else do:
     1949         assign
     1950           v-bge-xml-bgeflold  = v-value-character
     1951         .
     1952       end.
     1953       delete object v-tth.
     1954       assign
     1955         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1956         v-bge-xml-db-num-str  = v-db-num-str
     1957       .
     1958       if p-last-date <> ?
     1959       then do:
     1960           run adm/shattri.p ( input "get":U
     1961                             , input  '':u
     1962                             , input  0
     1963                             , input  'bge-export':U
     1964                             , input  'bgeflnm':U
     1965                             , output v-value-character
     1966                             , output v-value-date
     1967                             , output v-value-decimal
     1968                             , output v-value-integer
     1969                             , output v-value-logical
     1970                             , output v-param-type
     1971                             , input-output table-handle v-tth
     1972                             ) no-error .
     1973           if error-status :error
     1974           then do:
     1975             assign
     1976               v-bgeflnm = '':U
     1977             .
     1978           end.
     1979           else do:
     1980             assign
     1981               v-bgeflnm = v-value-character
     1982             .
     1983           end.
     1984           delete object v-tth.
     1985           if v-bge-xml-bgeflold = "var"
     1986           then do:
     1987               if v-bgeflnm = ?
     1988               or num-entries( v-bgeflnm ) < 2
     1989               then do:
     1990                   assign
     1991                       v-bge-xml-bgeflold = "new"
     1992                   .
     1993               end.
     1994               else do:
     1995                   assign
     1996                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1997                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1998                   .
     1999                   assign
     2000                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     2001                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     2002                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2003                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     2004                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     2005                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     2006                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2007                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     2008                   .
     2009               end.
     2010           end.
     2011       end.
     2012   end.
     2013   end procedure.
     2014   procedure bge-xml-get-ref-filename :
     2015   define input parameter p-in-file-name       as character        no-undo.
     2016   define output parameter p-home-dir          as character        no-undo.
     2017   define output parameter p-out-file-name     as character        no-undo.
     2018   define output parameter p-locked            as logical          no-undo.
     2019       define variable v-counter       as integer      no-undo.
     2020       define variable v-error-level   as integer      no-undo.
     2021   do
     2022   on error undo, return error
     2023   :
     2024       run bge/bge-ini.p (
     2025             input "bge"
     2026           , output p-home-dir
     2027       ).
     2028       if return-value <> "OK"
     2029       then do:
     2030           undo, return error.
     2031       end.
     2032       assign
     2033           p-home-dir = p-home-dir + "\dict":U
     2034       .
     2035       run bge/dir_cd.p (
     2036           input p-home-dir
     2037           , input "CA"
     2038       ).
     2039       if return-value = "ERROR"
     2040       then do:
     2041           undo, return error.
     2042       end.
     2043       assign
     2044           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     2045       .
     2046       assign
     2047           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     2048       .
     2049       wait-lock:
     2050       do v-counter = 1 TO 3
     2051       :
     2052           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     2053           if p-locked = no
     2054           then do:
     2055               leave wait-lock.
     2056           end.
     2057           else do:
     2058               readkey pause 1.
     2059           end.
     2060       END.
     2061       if p-locked = yes
     2062       then do:
     2063           undo, return error.
     2064       end.
     2065       run bge/os_copy.p (
     2066             input "D":U
     2067           , input p-out-file-name + "xml":U
     2068           , input "":U
     2069           , output v-error-level
     2070       ).
     2071       if v-error-level > 0
     2072       then do:
     2073           undo, return error.
     2074       end.
     2075   end.
     2076   end procedure.
     2077   procedure bge-xml-write-ref-header :
     2078   define input parameter p-bge-name as character        no-undo.
     2079   define input parameter p-file-name as character        no-undo.
     2080       define variable v-out-string    as character    no-undo.
     2081   do
     2082   on error undo, return error
     2083   :
     2084       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2085       put stream stmXMLOut unformatted
     2086           "<?xml version='1.0' encoding='windows-1251'?>":U
     2087       .
     2088       assign
     2089           v-out-string = substitute( "&1&2"
     2090                               , chr(10)
     2091                               , "<IBS_Trade_House>":U )
     2092       .
     2093       put stream stmXMLOut unformatted
     2094           v-out-string
     2095       .
     2096       run wp-XMLTagOpen( 1, "header", "" ).
     2097       if v-bge-xml-bgeflold = "oracle":u
     2098       then do:
     2099         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2100         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2101         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2102         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2103         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2104       end.
     2105       else do:
     2106         run wp-XMLTagOpen( 2, "delivery", "" ).
     2107         run wp-XMLTagOpen( 3, "to", "" ).
     2108         run wp-XMLTagClose( 3, "to" ).
     2109         run wp-XMLTagOpen( 3, "from", "" ).
     2110         run wp-XMLTagClose( 3, "from" ).
     2111         run wp-XMLTagClose( 2, "delivery" ).
     2112       end.
     2113       run wp-XMLTagOpen( 2, "manifest", "" ).
     2114       run wp-XMLTagOpen( 3, "document", "" ).
     2115       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2116       run wp-XMLTagPut( 4, "description", "", 0 ).
     2117       run wp-XMLTagClose( 3, "document" ).
     2118       run wp-XMLTagClose( 2, "manifest" ).
     2119       run wp-XMLTagClose( 1, "header" ).
     2120       run wp-XMLTagOpen( 1, "body", "" ).
     2121   end.
     2122   end procedure.
     2123   procedure bge-xml-write-ref-footer :
     2124   define input parameter p-file-name as character        no-undo.
     2125       define variable v-error-level   as integer      no-undo.
     2126   do
     2127   on error undo, return error
     2128   :
     2129       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2130       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2131       output stream stmXMLOut close.
     2132       run bge/os_copy.p (
     2133             input "M":U
     2134           , input p-file-name + "xm1":U
     2135           , input p-file-name + "xml":U
     2136           , output v-error-level
     2137       ).
     2138       if v-error-level > 0
     2139       then do:
     2140           undo, return error.
     2141       end.
     2142   end.
     2143   end procedure.
     2144   procedure bge-xml-out-dir :
     2145   define output parameter p-out-dir       as character    no-undo.
     2146   define output parameter p-log-file-name as character    no-undo.
     2147   do
     2148   on error undo, return error
     2149   :
     2150       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2151       if p-out-dir = ?
     2152       then do:
     2153           message
     2154             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2155                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2156             skip(1)
     2157             skip "Обратитесь к администратору."
     2158           view-as alert-box error.
     2159           undo, return error .
     2160       end.
     2161       if v-bge-xml-bgeflold <> "oracle" then assign
     2162         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2163       .
     2164       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2165       if error-status :error  then do:
     2166           run wp-XMLWriteLog in this-procedure (
     2167                 input p-log-file-name
     2168               , input 0
     2169               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2170                                   , p-out-dir
     2171                                   , return-value
     2172                                   , trim( error-status :get-message( 1 ) )
     2173                                   )
     2174           ).
     2175           undo, return error.
     2176       end.
     2177       assign
     2178           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2179           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2180       .
     2181   end.
     2182   end procedure.
     2183   procedure bge-xml-out-dir2 :
     2184   define output parameter p-out-dir       as character    no-undo.
     2185   define output parameter p-out-dirR      as character    no-undo.
     2186   define output parameter p-log-file-name as character    no-undo.
     2187   do
     2188   on error undo, return error
     2189   :
     2190       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2191       if p-out-dir = ?
     2192       then do:
     2193           message
     2194             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2195                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2196             skip(1)
     2197             skip "Обратитесь к администратору."
     2198           view-as alert-box error.
     2199           undo, return error .
     2200       end.
     2201       if v-bge-xml-bgeflold <> "oracle" then assign
     2202             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2203             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2204         .
     2205       else p-out-dirR = p-out-dir .
     2206       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2207       if error-status :error  then do:
     2208           run wp-XMLWriteLog in this-procedure (
     2209                 input p-log-file-name
     2210               , input 0
     2211               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2212                                   , p-out-dir
     2213                                   , return-value
     2214                                   , error-status :get-message( 1 )
     2215                                   )
     2216           ).
     2217           undo, return error.
     2218       end.
     2219       if p-out-dirR <> p-out-dir then do:
     2220         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2221         if error-status :error then do:
     2222           run wp-XMLWriteLog in this-procedure (
     2223                 input p-log-file-name
     2224               , input 0
     2225               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2226                                   , p-out-dirR
     2227                                   , return-value
     2228                                   , error-status :get-message( 1 )
     2229                                   )
     2230           ).
     2231           p-out-dirR = p-out-dir .
     2232         end.
     2233       end .
     2234       assign
     2235         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2236         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2237       .
     2238   end.
     2239   end procedure.
     2240   procedure bge-xml-out-file :
     2241   do
     2242   on error undo, return error
     2243   :
     2244   define input parameter p-out-dir            as character        no-undo.
     2245   define input parameter p-prefix             as character        no-undo.
     2246   define input parameter p-sheduled           as logical          no-undo.
     2247   define output parameter p-xml-file-name     as character        no-undo.
     2248   define output parameter p-locked            as logical          no-undo.
     2249   define variable v-home-dir      as character     no-undo.
     2250   define variable v-error-num     as integer       no-undo.
     2251   define variable v-today             as date         no-undo.
     2252   define variable v-time              as integer      no-undo.
     2253       if v-bge-xml-bgefmt = "dbf":U
     2254       then do:
     2255           assign
     2256               p-xml-file-name = p-out-dir
     2257               p-locked        = no
     2258           .
     2259       end.
     2260       else do:
     2261           if v-bge-xml-bgeflold = "firm":U
     2262           then do:
     2263               run bge/genfname.p (
     2264                     input p-out-dir
     2265                   , input p-prefix
     2266                   , input "":U
     2267                   , input "arj":U
     2268                   , input "":U
     2269                   , output p-xml-file-name
     2270               ).
     2271           end.
     2272           else do:
     2273               run bge/genfname.p (
     2274                     input p-out-dir
     2275                   , input p-prefix
     2276                   , input "":U
     2277                   , input "xml":U
     2278                   , input "":U
     2279                   , output p-xml-file-name
     2280               ).
     2281           end.
     2282           assign
     2283               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2284               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2285           .
     2286       end.
     2287   end.
     2288   end procedure.
     2289   procedure bge-xml-init-ext-doc-type :
     2290       define variable v-counter    as integer      no-undo.
     2291       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2292   do
     2293   for buf_temp_ext-doc-type
     2294   on error undo, return error
     2295   :
     2296       empty temp-table buf_temp_ext-doc-type.
     2297       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2298       :
     2299           create buf_temp_ext-doc-type.
     2300           assign
     2301               buf_temp_ext-doc-type.edt-key               = v-counter
     2302               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2303               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2304           .
     2305       end.
     2306   end.
     2307   end procedure.
     2308   procedure bge-xml-get-decimal-shift-num :
     2309   define input parameter p-shift-date     as date             no-undo.
     2310   define input parameter p-shift-num      as integer          no-undo.
     2311   define output parameter p-shift-decimal as decimal          no-undo.
     2312   do
     2313   on error undo, return error
     2314   :
     2315       assign
     2316           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2317       .
     2318   end.
     2319   end procedure.
     2320   procedure bge-xml-ora-exp-filename :
     2321     define input  parameter p-table-name  as character no-undo .
     2322     define input  parameter p-doc-code    as character no-undo .
     2323     define input  parameter p-obj-code    as integer   no-undo .
     2324     define output parameter p-filename    as character no-undo .
     2325     define output parameter p-seq-num     as integer   no-undo .
     2326     define variable v-ora-exp-seq     as integer   no-undo .
     2327     define variable v-ora-exp-seq-str as character no-undo .
     2328     define variable v-home-dir        as character no-undo.
     2329   do
     2330   on error undo, return error return-value
     2331   :
     2332     if v-bge-xml-bgeflold = "oracle":u
     2333     then do:
     2334       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2335       if v-home-dir = ?
     2336       then do:
     2337         undo, return error substitute( "&1&2&3":U
     2338                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2339                                       , chr(10)
     2340                                       , "Обратитесь к администратору.":U
     2341                                       ).
     2342       end.
     2343       assign
     2344           v-home-dir = v-home-dir
     2345       .
     2346       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2347       if error-status :error
     2348       then do:
     2349         undo, return error substitute( "&1&2&3":U
     2350                                       , "Неверно задан каталог экспорта.":U
     2351                                       , chr(10)
     2352                                       , "Обратитесь к администратору.":U
     2353                                       ).
     2354       end.
     2355       assign
     2356         v-ora-exp-seq = ?
     2357       .
     2358       if  p-table-name <> ? and
     2359           p-doc-code <> ?
     2360       then do:
     2361         run bge/get-oesq.p ( input p-table-name
     2362                            , input p-doc-code
     2363                            , output v-ora-exp-seq
     2364                            ) no-error .
     2365         if error-status :error = yes
     2366         then do:
     2367           undo, return error return-value .
     2368         end.
     2369       end.
     2370       if v-ora-exp-seq = ?
     2371       then do:
     2372         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2373         if error-status :error
     2374         then do:
     2375           undo, return error return-value .
     2376         end.
     2377       end.
     2378       if p-table-name <> ? and
     2379          p-doc-code   <> ?
     2380       then do:
     2381         run bge/oesqdoc.p ( input p-table-name
     2382                           , input p-doc-code
     2383                           , input v-ora-exp-seq
     2384                           ) no-error .
     2385         if error-status :error = yes
     2386         then do:
     2387           undo, return error return-value .
     2388         end.
     2389       end.
     2390       assign
     2391         p-seq-num  = v-ora-exp-seq
     2392         p-filename = substitute("&1/&2-000_&3."
     2393                                , v-home-dir
     2394                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2395                                , string(v-ora-exp-seq , "999999999")
     2396                                )
     2397       .
     2398     end.
     2399   end.
     2400   end procedure.
     2401   procedure bge-xml-date-to-str :
     2402     define input  parameter p-date  as date      no-undo .
     2403     define output parameter p-str   as character no-undo .
     2404   do
     2405   on error undo, return error return-value
     2406   :
     2407     if p-date <> ?
     2408     then do:
     2409       assign
     2410         p-str = substitute( "&1-&2-&3"
     2411                           , string( year(p-date)  , "9999")
     2412                           , string( month(p-date) , "99"  )
     2413                           , string( day(p-date)   , "99"  )
     2414                           )
     2415       .
     2416     end.
     2417     else do:
     2418       assign
     2419         p-str = ?
     2420       .
     2421     end.
     2422   end.
     2423   end procedure.
     2424   procedure bge-xml-date-str-to-str :
     2425     define input  parameter p-date-str  as character no-undo .
     2426     define output parameter p-str       as character no-undo .
     2427     define variable v-date          as date      no-undo .
     2428     define variable v-date-valid    as logical   no-undo .
     2429     define variable v-error-message as character no-undo .
     2430   do
     2431   on error undo, return error return-value
     2432   :
     2433     assign
     2434       p-str = ?
     2435     .
     2436     if p-date-str = ? or p-date-str = ""
     2437     then do:
     2438       return .
     2439     end.
     2440     run strtdate in this-procedure ( input  p-date-str
     2441                                    , output v-date
     2442                                    , output v-date-valid
     2443                                    , output v-error-message
     2444                                    ).
     2445     if v-date-valid <> true
     2446     then do:
     2447       return .
     2448     end.
     2449     assign
     2450       p-str = substitute( "&1-&2-&3"
     2451                         , string( year(v-date)  , "9999")
     2452                         , string( month(v-date) , "99"  )
     2453                         , string( day(v-date)   , "99"  )
     2454                         )
     2455     .
     2456   end.
     2457   end procedure.
     2458   procedure bge-xml-fill-tt-bgecliiv :
     2459     define input  parameter p-str as character no-undo .
     2460     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2461     define buffer buf_clients             for ub.clients.
     2462     define variable v-i         as integer   no-undo .
     2463     define variable v-count     as integer   no-undo .
     2464     define variable v-cli-count as integer   no-undo .
     2465     define variable v-client    as character no-undo .
     2466     define variable v-obj-type  as character no-undo .
     2467     define variable v-obj-code  as integer   no-undo .
     2468   do
     2469   on error undo, return error return-value
     2470   :
     2471     empty temp-table buf_tt-bge-xml-bgecliiv.
     2472     assign
     2473       v-bge-xml-bgecliiv = no
     2474       v-cli-count        = num-entries(p-str,';')
     2475     .
     2476     if v-cli-count > 0
     2477     then do:
     2478       _cli-cycle:
     2479       do v-i = 1 to v-cli-count
     2480       :
     2481         assign
     2482           v-client = entry(v-i , p-str, ';')
     2483         .
     2484         if num-entries(v-client) <> 2
     2485         then do:
     2486           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2487         end.
     2488         assign
     2489           v-obj-type = entry(1, v-client)
     2490         .
     2491         assign
     2492           v-obj-code = integer(entry(2, v-client))
     2493         no-error .
     2494         if error-status :error
     2495         then do:
     2496           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2497         end.
     2498         find first buf_clients no-lock
     2499           where buf_clients.obj-type = v-obj-type
     2500             and buf_clients.obj-code = v-obj-code
     2501         no-error.
     2502         if not available buf_clients
     2503         then do:
     2504           next _cli-cycle.
     2505         end.
     2506         find first buf_tt-bge-xml-bgecliiv no-lock
     2507           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2508             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2509         no-error .
     2510         if available buf_tt-bge-xml-bgecliiv
     2511         then do:
     2512           next _cli-cycle.
     2513         end.
     2514         create buf_tt-bge-xml-bgecliiv.
     2515         assign
     2516           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2517           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2518         .
     2519       end.
     2520     end.
     2521     else do:
     2522       assign
     2523         v-bge-xml-bgecliiv = no
     2524       .
     2525       return .
     2526     end.
     2527     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2528     if available buf_tt-bge-xml-bgecliiv
     2529     then do:
     2530       assign
     2531         v-bge-xml-bgecliiv = yes
     2532       .
     2533     end.
     2534   end.
     2535   end procedure.
     2536   procedure bge-xml-resolve-ext-doc-type :
     2537     define input  parameter p-ext-doc-type      as character no-undo .
     2538     define input  parameter p-obj-type          as character no-undo .
     2539     define input  parameter p-obj-code          as integer   no-undo .
     2540     define output parameter p-out-ext-doc-type  as character no-undo .
     2541     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2542   do
     2543   on error undo, return error return-value
     2544   :
     2545     assign
     2546       p-out-ext-doc-type = p-ext-doc-type
     2547     .
     2548     if p-ext-doc-type <> 'ie':U
     2549     then do:
     2550       return .
     2551     end.
     2552     if v-bge-xml-bgecliiv = yes
     2553     then do:
     2554       find first buf_tt-bge-xml-bgecliiv no-lock
     2555         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2556           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2557       no-error .
     2558       if available buf_tt-bge-xml-bgecliiv
     2559       then do:
     2560         assign
     2561           p-out-ext-doc-type = 'iv':U
     2562         .
     2563       end.
     2564     end.
     2565   end.
     2566   end procedure.
     2567   procedure safe-wp-xmltagput :
     2568     define input  parameter pTagLevel   as integer   no-undo .
     2569     define input  parameter pTagName    as character no-undo .
     2570     define input  parameter pParValue   as character no-undo .
     2571     define input  parameter pFlagEmpty  as integer   no-undo .
     2572   do
     2573   on error undo, return error return-value
     2574   :
     2575     if v-bge-xml-bgeflold = "oracle":u
     2576     then do:
     2577       return .
     2578     end.
     2579     run wp-xmltagput in this-procedure ( input pTagLevel
     2580                                        , input pTagName
     2581                                        , input pParValue
     2582                                        , input pFlagEmpty
     2583                                        ).
     2584   end.
     2585   end procedure.
     2586   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2587   procedure factord :
     2588     define input  parameter p-fact-date            as date    no-undo .
     2589     define input  parameter p-fact-time            as integer no-undo .
     2590     define input  parameter p-fact-num             as integer no-undo .
     2591     define input  parameter p-shift-date           as date    no-undo .
     2592     define input  parameter p-shift-num            as integer no-undo .
     2593     define input  parameter p-shift-on             as logical no-undo .
     2594     define output parameter p-fact-order           as decimal no-undo .
     2595     define output parameter p-shift-end-fact-order as decimal no-undo .
     2596     define output parameter p-day-end-fact-order   as decimal no-undo .
     2597     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     2598     if p-fact-date = ?
     2599     then do:
     2600       return error "Не указана фактическая дата" .
     2601     end.
     2602     define variable v-fact-date-num as integer no-undo .
     2603     assign
     2604       v-fact-date-num = integer(p-fact-date)
     2605     .
     2606     if p-fact-num = ?
     2607     or p-fact-num = 0
     2608     then do:
     2609       return error "Не задан p-fact-num " + string(p-fact-num) .
     2610     end.
     2611     if p-fact-num < 0
     2612     then do:
     2613       return error "Отрицательный fact-num " + string(p-fact-num) .
     2614     end.
     2615     if p-fact-num >= 100000000
     2616     then do:
     2617       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     2618     end.
     2619     if p-shift-on = true
     2620     then do:
     2621       if p-shift-date = ?
     2622       then do:
     2623         return error "Не задана дата смены" .
     2624       end.
     2625       if p-shift-num = ?
     2626       or p-shift-num = 0
     2627       then do:
     2628         return error "Не задан номер смены" .
     2629       end.
     2630     end.
     2631     else do:
     2632       assign
     2633         p-shift-date = p-fact-date
     2634         p-shift-num  = 24
     2635       .
     2636     end.
     2637     define variable v-shift-offset as integer no-undo .
     2638     if p-shift-date = p-fact-date
     2639     then do:
     2640       assign
     2641         v-shift-offset = 1
     2642       .
     2643     end.
     2644     if p-shift-date < p-fact-date
     2645     then do:
     2646       assign
     2647         v-shift-offset = 0
     2648       .
     2649     end.
     2650     if p-shift-date > p-fact-date
     2651     then do:
     2652       message
     2653         vss-workfile vss-revision vss-description skip
     2654         "Неправильная дата закрытия смены" skip
     2655         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     2656         view-as alert-box error .
     2657       undo, return error
     2658         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     2659           ,string(p-fact-date, '99/99/9999':U)
     2660           ,string(p-shift-date, '99/99/9999':U)
     2661           )
     2662       .
     2663     end.
     2664     if p-shift-num < 1
     2665     or p-shift-num > 24
     2666     then do:
     2667       message
     2668         vss-workfile vss-revision vss-description skip
     2669         "Неправильный номер смены" skip
     2670         "p-shift-num" p-shift-num skip
     2671         view-as alert-box error .
     2672       undo, return error return-value .
     2673     end.
     2674     assign
     2675       p-fact-order           = v-fact-date-num
     2676                              + v-shift-offset * 0.5
     2677                              + p-shift-num    * 0.02 - 0.01
     2678                              + p-fact-num     * 0.0000000001
     2679       p-shift-end-fact-order = v-fact-date-num
     2680                              + v-shift-offset * 0.5
     2681                              + p-shift-num    * 0.02
     2682       p-day-end-fact-order   = v-fact-date-num
     2683                              + 0.99
     2684     .
     2685     if p-fact-order           <= v-fact-date-num
     2686     or p-shift-end-fact-order <= v-fact-date-num
     2687     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     2688     or p-shift-end-fact-order >= p-day-end-fact-order
     2689     then do:
     2690       message
     2691         vss-workfile vss-revision vss-description skip
     2692         "Внутренняя ошибка при генерации фактического номера" skip
     2693         "p-fact-date"            p-fact-date            skip
     2694         "p-fact-time"            p-fact-time            skip
     2695         "p-fact-num"             p-fact-num             skip
     2696         "p-shift-date"           p-shift-date           skip
     2697         "p-shift-num"            p-shift-num            skip
     2698         "p-shift-on"             p-shift-on             skip
     2699         "p-shift-end-fact-order" p-shift-end-fact-order skip
     2700         "p-day-end-fact-order"   p-day-end-fact-order   skip
     2701         "v-fact-date-num"        v-fact-date-num        skip
     2702         view-as alert-box error .
     2703       undo, return error return-value .
     2704     end.
     2705   end procedure.
     2706   procedure day-begin-fact-order :
     2707     define input  parameter p-fact-date            as date    no-undo .
     2708     define output parameter p-day-begin-fact-order as decimal no-undo .
     2709     do
     2710     on error undo, return error return-value
     2711     :
     2712       if p-fact-date = ?
     2713       then do:
     2714         assign
     2715           p-day-begin-fact-order = 0
     2716         .
     2717       end.
     2718       else do:
     2719         assign
     2720           p-day-begin-fact-order = integer(p-fact-date)
     2721         .
     2722       end.
     2723     end.
     2724   end procedure.
     2725   procedure factord-max-fact-order :
     2726     define output parameter p-max-fact-order as decimal   no-undo .
     2727     do
     2728     on error undo, return error return-value
     2729     :
     2730       run day-begin-fact-order in this-procedure
     2731         (input  date(1, 1, 5000)
