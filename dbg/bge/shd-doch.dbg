     3438                                           , return-value
     3439                                           , trim(error-status :get-message(1))
     3440                                           , trim(error-status :get-message(2))
     3441                                           )  ).
     3442               end.
     3443           end.
     3444           run xml-bge-write-footer in this-procedure ( input v-xml-file-name ).
     3445         end .
     3446         do :
     3447           assign
     3448               v-prefix = substitute( "s_&1&2&3&4&5&6_"
     3449                                       , substring( string( year( buf_shift-obj.shift-date ), "9999":U ), 3, 2 )
     3450                                       , string( month( buf_shift-obj.shift-date ), "99":U )
     3451                                       , string( day( buf_shift-obj.shift-date ), "99":U )
     3452                                       , string( buf_shift-obj.shift-num, "99":U )
     3453                                       , string( trim( buf_shift-obj.obj-type ), "X(3)":U )
     3454                                       , string( buf_shift-obj.obj-code, "99999":U )
     3455                                       )
     3456           .
