     3643   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3644   on help of frame Dialog-Frame
     3645   do:
     3646     run gbl/app_help.p
     3647       (input this-procedure :file-name
     3648       ,input ''
     3649       ,input ?
     3650       ) no-error.
     3651     if error-status :error then do:
     3652       message
     3653         "Ошибка при вызове помощи"
     3654         error-status :get-message(1)
     3655         view-as alert-box .
     3656     end.
     3657   end.
     3658   run minbtn-set in this-procedure .
     3659   on choose of b-help in frame Dialog-Frame
     3660   do:
     3661     apply "help":u to frame Dialog-Frame .
     3662   end.
     3663   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3664   procedure minbtn-set :
     3665       do
     3666           on error undo, return error return-value
     3667           :
     3668           define variable ii              as integer       no-undo .
     3669           define variable fh              as widget-handle no-undo .
     3670           define variable hh              as widget-handle no-undo .
     3671           define variable v-h             as handle        extent 4 no-undo .
     3672           define variable v-name-button   as character     no-undo .
     3673           define variable v-help-old-x    as decimal       no-undo .
     3674           define variable v-help-old-y    as decimal       no-undo .
     3675           define variable v-help-old-size as decimal       no-undo .
     3676           define variable v-frame-width   as decimal       no-undo .
     3677           define variable jj              as integer       no-undo .
     3678           do
     3679               on error undo, return error
     3680               :
     3681               assign
     3682                   v-frame-width = frame Dialog-Frame:width - 0.3
     3683                   fh            = frame Dialog-Frame:first-child
     3684                   hh            = fh:first-child
     3685                   ii            = 1
     3686                   .
     3687               do while valid-handle(hh):
     3688                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3689                   do:
     3690                       case lc(hh:name) :
     3691                           when "b-help" then
     3692                               do:
     3693                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3694                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3695                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3696                                   hh:TOOLTIP = "Помощь" .
     3697                                   v-help-old-x = hh:column .
     3698                                   v-help-old-y = hh:row    .
     3699                                   v-help-old-size = hh:width .
     3700                                   hh:width-chars = 2.5 .
     3701                               end.
     3702                           when "b-print" then
     3703                               do:
     3704                                   hh:load-image("cmp/b-print.bmp":u) .
     3705                                   hh:TOOLTIP = "Печать" .
     3706                                   v-h[ii] = hh:handle .
     3707                                   ii = ii + 1 .
     3708                                   hh:width-chars = 3 .
     3709                               end.
     3710                           when "b-history" or
     3711                           when "b-hist" then
     3712                               do:
     3713                                   hh:load-image("cmp/b-hist.bmp":u) .
     3714                                   hh:TOOLTIP = "История" .
     3715                                   v-h[ii] = hh:handle .
     3716                                   ii = ii + 1 .
     3717                                   hh:width-chars = 3 .
     3718                               end.
     3719                           when "b-sch" then
     3720                               do:
     3721                                   hh:load-image("cmp/b-sch.bmp":u) .
     3722                                   hh:TOOLTIP = "Установка Фильтра" .
     3723                                   v-h[ii] = hh:handle .
     3724                                   ii = ii + 1 .
     3725                                   hh:width-chars = 3 .
     3726                               end.
     3727                           when "b-hist-user" then
     3728                               do:
     3729                                   hh:load-image("cmp/b-hist.bmp":u) .
     3730                                   hh:TOOLTIP = "История пользователя" .
     3731                                   ii = ii + 1 .
     3732                               end.
     3733                       end case.
     3734                   end.
     3735                   hh = hh:next-sibling.
     3736               end.
     3737               b-help:column = v-frame-width - b-help:width-chars.
     3738               jj = 0.
     3739               repeat ii = 4 to 1 by -1 :
     3740                   if valid-handle (v-h[ii] ) then
     3741                   do:
     3742                       jj  = jj + 1 .
     3743                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3744                       v-h[ii]:row    = v-help-old-y .
     3745                   end.
     3746               end.
     3747           end.
     3748       end.
     3749   end procedure.
     3750   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3751   on ' ' of date_from in frame Dialog-Frame
     3752   do:
