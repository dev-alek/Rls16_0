     1236   define temp-table tt-bge-xml-bgecliiv no-undo
     1237     field obj-type  like ub.clients.obj-type
     1238     field obj-code  like ub.clients.obj-code
     1239   index pi is primary unique
     1240     obj-type
     1241     obj-code
     1242   .
     1243   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1244                                             INPUT iFlagEmpty AS INTEGER).
     1245       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1246       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1247           DO:
     1248               IF iFlagEmpty = 0                           THEN RETURN "".
     1249               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1250               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1251               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1252               ELSE RETURN "".
     1253           END.
     1254       ELSE DO:
     1255           run xmlchar-encode in this-procedure (
     1256                 input sToPlace
     1257               , output sToPlace
     1258           ).
     1259           ASSIGN
     1260               sToPlace = sParName + '="' + sToPlace + '"'
     1261           .
     1262           RETURN sToPlace.
     1263       END.
     1264   END FUNCTION.
     1265   function bge-xml-date returns character
     1266   ( input p-date as date )
     1267   :
     1268     define variable v-date-str as character no-undo .
     1269     run bge-xml-date-to-str in this-procedure ( input   p-date
     1270                                               , output  v-date-str
     1271                                               ) .
     1272     return v-date-str.
     1273   end function.
     1274   function bge-xml-str-date returns character
     1275   ( input p-date-str as character )
     1276   :
     1277     define variable v-date-str as character no-undo .
     1278     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1279                                                   , output  v-date-str
     1280                                                   ) .
     1281     return v-date-str.
     1282   end function.
     1283   function bge-xml-normalize-dec returns decimal
     1284   ( input p-val as decimal )
     1285   :
     1286     return (if p-val = ? then 0 else p-val) .
     1287   end function.
     1288   PROCEDURE wp-XMLTagOpen:
     1289   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1290   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1291   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1292       define variable v-out-string    as character    no-undo.
     1293   do
     1294   on error undo, return error
     1295   :
     1296       if v-bge-xml-bgefmt = "dbf":U
     1297       then do:
     1298       end.
     1299       else do:
     1300           assign
     1301               v-out-string = substitute( "&1&2<&3&4>"
     1302                                       , chr(10)
     1303                                       , fill( " ":U, 4 * iTagLevel)
     1304                                       , sTagName
     1305                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1306                               )
     1307           .
     1308           put stream stmXMLOut unformatted
     1309               v-out-string
     1310           .
     1311       end.
     1312   end.
     1313   END PROCEDURE.
     1314   PROCEDURE wp-XMLTagPut:
     1315     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1316     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1317     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1318     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1319       define variable v-out-string    as character    no-undo.
     1320   do
     1321   on error undo, return error
     1322   :
     1323       if v-bge-xml-bgefmt = "dbf":U
     1324       then do:
     1325           if v-bge-xml-dbf-file-name <> "":U
     1326           then do:
     1327               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1328               export stream stmXMLOut
     1329                   sTagName
     1330                   sParValue
     1331               .
     1332               output stream stmXMLOut close.
     1333           end.
     1334       end.
     1335       else do:
     1336           IF  iFlagEmpty = 1
     1337           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1338           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1339           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1340           THEN DO:
     1341               run xmlchar-encode in this-procedure (
     1342                   input sParValue
     1343                   , output sParValue
     1344               ).
     1345               assign
     1346                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1347                                               , chr(10)
     1348                                               , FILL(" ", 4 * iTagLevel)
     1349                                               , sTagName
     1350                                               , sParValue
     1351                               )
     1352               .
     1353               PUT STREAM stmXMLOut UNFORMATTED
     1354                   v-out-string
     1355               .
     1356           END.
     1357       end.
     1358   end.
     1359   END PROCEDURE.
     1360   PROCEDURE wp-XMLTagClose:
     1361   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1362   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1363       define variable v-out-string    as character    no-undo.
     1364   do
     1365   on error undo, return error
     1366   :
     1367       if v-bge-xml-bgefmt = "dbf":U
     1368       then do:
     1369       end.
     1370       else do:
     1371           assign
     1372               v-out-string = substitute( "&1&2</&3>"
     1373                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1374                                   , fill( " ", 4 * iTagLevel )
     1375                                   , sTagName
     1376                           )
     1377           .
     1378           PUT STREAM stmXMLOut UNFORMATTED
     1379               v-out-string
     1380           .
     1381       end.
     1382   end.
     1383   END PROCEDURE.
     1384   PROCEDURE wp-XMLWriteLog:
     1385     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1386     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1387     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1388   define variable v-str              as character no-undo .
     1389   define variable v-error-append     as logical   no-undo .
     1390   define variable v-error-append-msg as character no-undo .
     1391   assign
     1392     v-str = chr(10)
     1393             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1394             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1395     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1396     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1397     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1398   .
     1399   run bge/bge-log.p (input v-str) no-error .
     1400   if error-status:error then do:
     1401     assign
     1402       v-error-append     = yes
     1403       v-error-append-msg = return-value
     1404     .
     1405   end.
     1406   run gbl/fileapnd.p
     1407     ( input sFileName
     1408     , input v-str
     1409     , input 10
     1410     ) no-error .
     1411   if error-status:error then do:
     1412     assign
     1413       v-error-append     = yes
     1414       v-error-append-msg = substitute( "&1&2&3"
     1415                                       , v-error-append-msg
     1416                                       , chr(10)
     1417                                       , return-value
     1418                                       )
     1419     .
     1420   end.
     1421   if v-error-append
     1422   then do:
     1423     return error substitute( "&1" , v-error-append-msg ) .
     1424   end.
     1425   END PROCEDURE.
     1426   PROCEDURE wp-XMLWriteEDT:
     1427     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1428     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1429     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1430       if valid-handle ( hEDT )
     1431       then do:
     1432           hEDT :move-to-eof().
     1433           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1434                                           OR sToWrite = "&Line") THEN "" ELSE
     1435                                           cur-time-string-sec() + " ").
     1436           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1437                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1438                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1439           hEDT :insert-string(chr(10)).
     1440       end.
     1441       process events.
     1442       output to 'bgescn.txt' append.
     1443           put unformatted
     1444               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1445                                           OR sToWrite = "&Line") THEN "" ELSE
     1446                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1447               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1448                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1449                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1450           .
     1451       output close.
     1452   END PROCEDURE.
     1453   PROCEDURE wp-XMLShowCNT:
     1454     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1455       if valid-handle( hCNT )
     1456       then do:
     1457           ASSIGN hCNT :VISIBLE = TRUE.
     1458       end.
     1459   END PROCEDURE.
     1460   PROCEDURE wp-XMLHideCNT:
     1461     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1462       if valid-handle( hCNT )
     1463       then do:
     1464           ASSIGN hCNT :VISIBLE = FALSE.
     1465       end.
     1466   END PROCEDURE.
     1467   PROCEDURE wp-XMLWriteCNT:
     1468     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1469     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1470       if valid-handle( hCNT )
     1471       then do:
     1472           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1473       end.
     1474   END PROCEDURE.
     1475   procedure bge-xml-write-header:
     1476   do
     1477   on error undo, return error
     1478   :
     1479   define input parameter p-xml-file-name  as character        no-undo.
     1480   define input parameter p-doc-name       as character        no-undo.
     1481   define input parameter p-version        as character        no-undo.
     1482   define input parameter p-db-num         as integer          no-undo.
     1483   define input parameter p-date-from      as date             no-undo.
     1484   define input parameter p-shift-num-from as integer          no-undo.
     1485   define input parameter p-date-to        as date             no-undo.
     1486   define input parameter p-shift-num-to   as integer          no-undo.
     1487   define input parameter p-obj-list       as character        no-undo.
     1488   define input parameter p-doc-type-list  as character        no-undo.
     1489   define input parameter p-pay-code       as logical          no-undo.
     1490   define input parameter p-cst            as logical          no-undo.
     1491   define input parameter p-parts          as logical          no-undo.
     1492   define input parameter p-chk-pay-code   as logical          no-undo.
     1493   define input parameter p-pay-desk       as logical          no-undo.
     1494   define input parameter p-pay-desk-cards as logical          no-undo.
     1495   define input parameter p-deleted        as logical          no-undo.
     1496   define input parameter p-opened-docs    as logical          no-undo.
     1497   define variable v-out-string    as character    no-undo.
     1498   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1499   assign
     1500       v-out-string = substitute( "&1&2&3"
     1501                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1502                           , chr(10)
     1503                           , "<IBS_Trade_House>":U )
     1504   .
     1505   put stream stmXMLOut unformatted
     1506       v-out-string
     1507   .
     1508   run wp-XMLTagOpen(1, "header","").
     1509   if v-bge-xml-bgeflold = "oracle":u
     1510   then do:
     1511     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1512     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1513     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1514     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1515     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1516   end.
     1517   run wp-XMLTagOpen( 2, "manifest", "").
     1518   run wp-XMLTagOpen( 3, "document", "").
     1519   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1520   run wp-XMLTagput( 4, "description", "", 0).
     1521   run wp-XMLTagput( 4, "version", p-version, 0).
     1522   run wp-XMLTagclose( 3, "document" ).
     1523   run wp-XMLTagclose( 2, "manifest" ).
     1524   run wp-XMLTagclose( 1, "header" ).
     1525   run wp-XMLTagOpen(1, "options","").
     1526   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1527   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1528   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1529   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1530   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1531   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1532   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1533   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1534   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1535   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1536   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1537   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1538   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1539   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1540   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1541   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1542   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1543   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1544   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1545   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1546   run wp-XMLTagClose(1, "options").
     1547   run wp-XMLTagOpen( 1, "body", "" ).
     1548   output stream stmXMLOut close.
     1549   end.
     1550   end procedure.
     1551   procedure xml-bge-write-footer:
     1552   do
     1553   on error undo, return error return-value
     1554   :
     1555   define input parameter p-xml-file-name as character    no-undo.
     1556   define variable v-error-num     as integer           no-undo.
     1557   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1558   run wp-XMLTagClose( 1, "body" ).
     1559   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1560   output stream stmXMLOut close.
     1561   if v-bge-xml-bgeflold = "oracle":u
     1562   then do:
     1563     define variable v-tmp-file-name         as character no-undo .
     1564     define variable v-zip-file-name         as character no-undo .
     1565     define variable v-exch-file-name        as character no-undo .
     1566     define variable v-heap-file-name        as character no-undo .
     1567     define variable v-i                     as integer   no-undo .
     1568     define variable v-file-name             as character no-undo .
     1569     define variable v-arc                   as character no-undo .
     1570     define variable v-str                   as character no-undo .
     1571     define variable v-exch-tmp-file-name    as character no-undo .
     1572     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1573     define variable v-bge-xml-exch-dir      as character no-undo .
     1574     define variable v-bge-xml-heap-dir      as character no-undo .
     1575     define variable v-bge-xml-compress-heap as logical   no-undo .
     1576     define variable v-home-dir              as character no-undo .
     1577     define variable v-os-command            as character no-undo .
     1578     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1579     if v-home-dir = ?
     1580     then do:
     1581       undo, return error substitute( "&1&2&3"
     1582                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1583                                     , chr(10)
     1584                                     , "Обратитесь к администратору.":u
     1585                                     ).
     1586     end.
     1587     assign
     1588       v-home-dir = v-home-dir
     1589     .
     1590     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1591     if error-status :error
     1592     then do:
     1593       undo, return error substitute( "&1&2&3"
     1594                                     , "Неверно задан каталог экспорта.":u
     1595                                     , chr(10)
     1596                                     , "Обратитесь к администратору.":u
     1597                                     ).
     1598     end.
     1599     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1600     if v-bge-xml-exch-dir = ?
     1601     then do:
     1602       undo, return error substitute( "&1&2&3"
     1603                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1604                                     , chr(10)
     1605                                     , "Обратитесь к администратору.":u
     1606                                     ).
     1607     end.
     1608     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1609     if error-status :error
     1610     then do:
     1611       undo, return error substitute( "&1&2&3"
     1612                                     , "Неверно задан каталог экспорта (exch).":u
     1613                                     , chr(10)
     1614                                     , "Обратитесь к администратору.":u
     1615                                     ).
     1616     end.
     1617     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1618     if v-bge-xml-heap-dir = ?
     1619     then do:
     1620       undo, return error substitute( "&1&2&3"
     1621                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1622                                     , chr(10)
     1623                                     , "Обратитесь к администратору.":u
     1624                                     ).
     1625     end.
     1626     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1627     if error-status :error
     1628     then do:
     1629       undo, return error substitute( "&1&2&3"
     1630                                     , "Неверно задан каталог экспорта (heap).":u
     1631                                     , chr(10)
     1632                                     , "Обратитесь к администратору.":u
     1633                                     ).
     1634     end.
     1635     get-key-value section "BGE" key "heap-compress" value v-str.
     1636     assign
     1637       v-i = int(v-str)
     1638     no-error .
     1639     if v-i = ? or v-i = 0
     1640     then do:
     1641       assign
     1642         v-bge-xml-compress-heap = no
     1643       .
     1644     end.
     1645     else do:
     1646       assign
     1647         v-bge-xml-compress-heap = yes
     1648       .
     1649     end.
     1650     assign
     1651       v-arc = search( "exe/7za.exe":u )
     1652     .
     1653     if v-arc = ? or v-arc = ""
     1654     then do:
     1655       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1656     end.
     1657     assign
     1658       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1659       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1660       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1661       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1662       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1663       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1664       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1665     .
     1666     run gbl/del-file.p (input v-tmp-file-name) .
     1667     run gbl/del-file.p (input v-zip-file-name) .
     1668     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1669     if v-error-num > 0
     1670     then do:
     1671         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1672                                      , p-xml-file-name + "xm1":u
     1673                                      , v-tmp-file-name
     1674                                      , v-error-num
     1675                                      ).
     1676     end.
     1677     assign
     1678       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1679                                    , v-arc
     1680                                    , v-zip-file-name
     1681                                    , v-tmp-file-name
     1682                                    )
     1683     .
     1684     os-command silent value ( v-os-command ) .
     1685     run gbl/del-file.p (input v-heap-file-name) .
     1686     if v-bge-xml-compress-heap = no
     1687     then do:
     1688       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1689       if v-error-num > 0
     1690       then do:
     1691           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1692                                        , v-tmp-file-name
     1693                                        , v-heap-file-name
     1694                                        , v-error-num
     1695                                        ) .
     1696       end.
     1697     end.
     1698     else do:
     1699       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1700       if v-error-num > 0
     1701       then do:
     1702           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1703                                        , v-zip-file-name
     1704                                        , v-heap-file-name
     1705                                        , v-error-num
     1706                                        ) .
     1707       end.
     1708     end.
     1709     run gbl/del-file.p (input v-tmp-file-name) .
     1710     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1711     if error-status :error then do:
     1712       undo, return error substitute( "&1&2&3"
     1713                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1714                                     , chr(10)
     1715                                     , "Обратитесь к администратору."
     1716                                     ).
     1717     end.
     1718     run gbl/del-file.p (input v-exch-file-name) .
     1719     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1720     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1721     if v-error-num > 0
     1722     then do:
     1723       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1724                                     , v-zip-file-name
     1725                                     , v-exch-tmp-file-name
     1726                                     , v-error-num
     1727                                     ) .
     1728     end.
     1729     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1730     if v-error-num > 0
     1731     then do:
     1732       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1733                                     , v-exch-tmp-file-name
     1734                                     , v-exch-file-name
     1735                                     , v-error-num
     1736                                     ) .
     1737     end.
     1738     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1739   end.
     1740   else do:
     1741     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1742     if v-error-num > 0
     1743     then do:
     1744       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1745                                     , p-xml-file-name + "xm1"
     1746                                     , p-xml-file-name + "xml"
     1747                                     , v-error-num
     1748                                     ) .
     1749     end.
     1750   end.
     1751   if opsys = "unix"
     1752   then do:
     1753       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1754   end.
     1755   end.
     1756   end procedure.
     1757   procedure xml-bge-filename0:
     1758   define input parameter p-prefix   as character no-undo .
     1759   define input parameter p-name     as character no-undo .
     1760   define input parameter p-shared-process as logical no-undo .
     1761   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1762   define output parameter p-xml-file-name  as character no-undo .
     1763   // define output parameter p-fullfnamenoext as character no-undo .
     1764   define output parameter p-locked         as logical      no-undo.
     1765   define variable v-fullfnamenoext as character no-undo .
     1766   define variable v-fileext        as character no-undo .
     1767   define variable v-fullfname      as character no-undo .
     1768   define variable v-error-num      as integer   no-undo .
     1769   do
     1770   on error undo, return error
     1771   :
     1772     case v-bge-xml-bgeflold :
     1773       when "old" then do:
     1774         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1775         v-fileext       = ".xml":U .
     1776         v-fullfname     = v-fullfnamenoext + v-fileext .
     1777         p-xml-file-name = v-fullfname .
     1778         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1779         if v-error-num > 0 then do:
     1780           return error.
     1781         end.
     1782       end.
     1783       when "var" then do:
     1784         case p-prefix :
     1785           when "doc" then do:
     1786             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1787             v-fileext       = ".xml":U .
     1788             v-fullfname     = v-fullfnamenoext + v-fileext .
     1789             p-xml-file-name = v-fullfname .
     1790           end.
     1791           when "day" then do:
     1792             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1793             v-fileext       = ".xml":U .
     1794             v-fullfname     = v-fullfnamenoext + v-fileext .
     1795             p-xml-file-name = v-fullfname .
     1796           end.
     1797           otherwise do:
     1798             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1799             v-fileext       = ".xml":U .
     1800             v-fullfname     = v-fullfnamenoext + v-fileext .
     1801             p-xml-file-name = v-fullfname .
     1802           end.
     1803         end case.
     1804         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1805         if v-error-num > 0 then do:
     1806           return error.
     1807         end.
     1808       end.
     1809       when "new" then do:
     1810                   run bge/genfname.p (
     1811                       input p-home-dir
     1812                       , input p-prefix
     1813                       , input ""
     1814                       , input "xml"
     1815                       , input ""
     1816                       , output p-xml-file-name
     1817                   ).
     1818       end.
     1819       when "no-parameter" then do:
     1820         if p-shared-process then do:
     1821                       run bge/genfname.p (
     1822                           input p-home-dir
     1823                           , input "d"
     1824                           , input ""
     1825                           , input "xml"
     1826                           , input ""
     1827                           , output p-xml-file-name
     1828                       ).
     1829         end.
     1830         else do:
     1831           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1832           v-fileext       = ".xml":U .
     1833           v-fullfname     = v-fullfnamenoext + v-fileext .
     1834           p-xml-file-name = v-fullfname .
     1835           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1836           if v-error-num > 0 then do:
     1837             return error.
     1838           end.
     1839         end.
     1840       end.
     1841     end case.
     1842     assign
     1843       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1844       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1845     .
     1846   end .
     1847   end procedure .
     1848   procedure xml-bge-filename :
     1849   do
     1850   on error undo, return error
     1851   :
     1852   define input parameter p-prefix             as character    no-undo.
     1853   define input parameter p-name               as character    no-undo.
     1854   define input parameter p-shared-process     as logical      no-undo.
     1855   define output parameter p-xml-file-name     as character    no-undo.
     1856   define output parameter p-log-file-name     as character    no-undo.
     1857   define output parameter p-locked            as logical      no-undo.
     1858   define variable v-home-dir          as character no-undo .
     1859   define variable v-error-num         as integer   no-undo .
     1860   define variable v-bge-xml-heap-dir  as character no-undo .
     1861       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1862       if v-home-dir = ?
     1863       then do:
     1864           message
     1865             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1866             skip(1)
     1867             skip "Обратитесь к администратору."
     1868           view-as alert-box error.
     1869           undo, return error .
     1870       end.
     1871       if v-bge-xml-bgeflold <> "oracle"
     1872       then do:
     1873         assign
     1874             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1875         .
     1876       end.
     1877       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1878       if error-status :error
     1879       then do:
     1880           message
     1881             skip "Неверно задан каталог экспорта."
     1882             skip(1)
     1883             skip "Обратитесь к администратору."
     1884           view-as alert-box error.
     1885           undo, return error .
     1886       end.
     1887       if v-bge-xml-bgefmt = "dbf":U
     1888       then do:
     1889           assign
     1890               p-xml-file-name = v-home-dir
     1891               p-locked        = no
     1892           .
     1893       end.
     1894       else do:
     1895           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1896             output p-xml-file-name, output p-locked) .
     1897       end.
     1898       if v-bge-xml-bgeflold = "oracle"
     1899       then do:
     1900         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1901         if v-bge-xml-heap-dir = ?
     1902         then do:
     1903           undo, return error substitute( "&1&2&3"
     1904                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1905                                         , chr(10)
     1906                                         , "Обратитесь к администратору.":u
     1907                                         ).
     1908         end.
     1909         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1910         if error-status :error
     1911         then do:
     1912           undo, return error substitute( "&1&2&3"
     1913                                         , "Неверно задан каталог экспорта (heap).":u
     1914                                         , chr(10)
     1915                                         , "Обратитесь к администратору.":u
     1916                                         ).
     1917         end.
     1918         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1919           assign
     1920             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1921           .
     1922         end.
     1923         else do:
     1924           assign
     1925             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1926           .
     1927         end.
     1928       end.
     1929       else do:
     1930         assign
     1931             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1932         .
     1933       end.
     1934       assign
     1935          v-bge-xml-static-log-file-name = p-log-file-name
     1936       .
     1937   end.
     1938   end procedure.
     1939   procedure bge-xml-read-config :
     1940   do
     1941   on error undo, return error return-value
     1942   :
     1943   define input  parameter p-last-date as date      no-undo .
     1944   define input  parameter p-db-num    as integer   no-undo .
     1945       define variable v-bgeclall      as character     no-undo.
     1946       define variable v-bgedict       as character     no-undo.
     1947       define variable v-bgeshift      as character     no-undo.
     1948       define variable v-par-type      as character     no-undo.
     1949       define variable v-bgeflnm       as character     no-undo.
     1950       define variable v-bgecliiv      as character     no-undo .
     1951       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1952       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1953       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1954       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1955       define variable v-db-num-str    as character     no-undo .
     1956       define variable v-param-type      as character  no-undo .
     1957       define variable v-value-character as character  no-undo .
     1958       define variable v-value-date      as date       no-undo .
     1959       define variable v-value-decimal   as decimal    no-undo .
     1960       define variable v-value-integer   as integer    no-undo .
     1961       define variable v-value-logical   as logical    no-undo .
     1962       define variable v-tth             as handle      no-undo .
     1963       run adm/shattri.p ( input "get":U
     1964                         , input  '':u
     1965                         , input  0
     1966                         , input  'bge-export':U
     1967                         , input  'bgeclall':U
     1968                         , output v-bgecliiv
     1969                         , output v-value-date
     1970                         , output v-value-decimal
     1971                         , output v-value-integer
     1972                         , output v-value-logical
     1973                         , output v-param-type
     1974                         , input-output table-handle v-tth
     1975                         ) no-error .
     1976       if error-status :error
     1977       then do:
     1978         assign
     1979           v-bge-xml-bgecliiv = no
     1980         .
     1981       end.
     1982       else do:
     1983         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1984       end.
     1985       delete object v-tth.
     1986       assign
     1987           v-bge-xml-bgeclall = no
     1988           v-bge-xml-bgedict  = no
     1989       .
     1990       run adm/shattri.p ( input "get":U
     1991                         , input  '':u
     1992                         , input  0
     1993                         , input  'bge-export':U
     1994                         , input  'bgeclall':U
     1995                         , output v-value-character
     1996                         , output v-value-date
     1997                         , output v-value-decimal
     1998                         , output v-value-integer
     1999                         , output v-value-logical
     2000                         , output v-param-type
     2001                         , input-output table-handle v-tth
     2002                         ) no-error .
     2003       if error-status :error
     2004       then do:
     2005         assign
     2006           v-bge-xml-bgeclall = no
     2007         .
     2008       end.
     2009       else do:
     2010         assign
     2011           v-bge-xml-bgeclall = v-value-logical
     2012         .
     2013       end.
     2014       delete object v-tth.
     2015       run adm/shattri.p ( input "get":U
     2016                         , input  '':u
     2017                         , input  0
     2018                         , input  'bge-export':U
     2019                         , input  'bgedict':U
     2020                         , output v-value-character
     2021                         , output v-value-date
     2022                         , output v-value-decimal
     2023                         , output v-value-integer
     2024                         , output v-value-logical
     2025                         , output v-param-type
     2026                         , input-output table-handle v-tth
     2027                         ) no-error .
     2028       if error-status :error
     2029       then do:
     2030         assign
     2031           v-bge-xml-bgedict = no
     2032         .
     2033       end.
     2034       else do:
     2035         assign
     2036           v-bge-xml-bgedict = v-value-logical
     2037         .
     2038       end.
     2039       delete object v-tth.
     2040       run adm/shattri.p ( input "get":U
     2041                         , input  '':u
     2042                         , input  0
     2043                         , input  'bge-export':U
     2044                         , input  'bgefmt':U
     2045                         , output v-value-character
     2046                         , output v-value-date
     2047                         , output v-value-decimal
     2048                         , output v-value-integer
     2049                         , output v-value-logical
     2050                         , output v-param-type
     2051                         , input-output table-handle v-tth
     2052                         ) no-error .
     2053       if error-status :error
     2054       then do:
     2055         assign
     2056           v-bge-xml-bgefmt  = "xml":U
     2057         .
     2058       end.
     2059       else do:
     2060         assign
     2061           v-bge-xml-bgefmt  = v-value-character
     2062         .
     2063       end.
     2064       delete object v-tth.
     2065       run adm/shattri.p ( input "get":U
     2066                         , input  '':u
     2067                         , input  0
     2068                         , input  'bge-export':U
     2069                         , input  'bgeshift':U
     2070                         , output v-value-character
     2071                         , output v-value-date
     2072                         , output v-value-decimal
     2073                         , output v-value-integer
     2074                         , output v-value-logical
     2075                         , output v-param-type
     2076                         , input-output table-handle v-tth
     2077                         ) no-error .
     2078       if error-status :error
     2079       then do:
     2080         assign
     2081             v-bge-xml-shift-mode = no
     2082         .
     2083       end.
     2084       else do:
     2085         assign
     2086             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     2087         .
     2088       end.
     2089       delete object v-tth.
     2090       run adm/shattri.p ( input "get":U
     2091                         , input  '':u
     2092                         , input  0
     2093                         , input  'bge-export':U
     2094                         , input  'bgeflold':U
     2095                         , output v-value-character
     2096                         , output v-value-date
     2097                         , output v-value-decimal
     2098                         , output v-value-integer
     2099                         , output v-value-logical
     2100                         , output v-param-type
     2101                         , input-output table-handle v-tth
     2102                         ) no-error .
     2103       if error-status :error
     2104       then do:
     2105         assign
     2106           v-bge-xml-bgeflold = "no-parameter":U
     2107         .
     2108       end.
     2109       else do:
     2110         assign
     2111           v-bge-xml-bgeflold  = v-value-character
     2112         .
     2113       end.
     2114       delete object v-tth.
     2115       assign
     2116         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     2117         v-bge-xml-db-num-str  = v-db-num-str
     2118       .
     2119       if p-last-date <> ?
     2120       then do:
     2121           run adm/shattri.p ( input "get":U
     2122                             , input  '':u
     2123                             , input  0
     2124                             , input  'bge-export':U
     2125                             , input  'bgeflnm':U
     2126                             , output v-value-character
     2127                             , output v-value-date
     2128                             , output v-value-decimal
     2129                             , output v-value-integer
     2130                             , output v-value-logical
     2131                             , output v-param-type
     2132                             , input-output table-handle v-tth
     2133                             ) no-error .
     2134           if error-status :error
     2135           then do:
     2136             assign
     2137               v-bgeflnm = '':U
     2138             .
     2139           end.
     2140           else do:
     2141             assign
     2142               v-bgeflnm = v-value-character
     2143             .
     2144           end.
     2145           delete object v-tth.
     2146           if v-bge-xml-bgeflold = "var"
     2147           then do:
     2148               if v-bgeflnm = ?
     2149               or num-entries( v-bgeflnm ) < 2
     2150               then do:
     2151                   assign
     2152                       v-bge-xml-bgeflold = "new"
     2153                   .
     2154               end.
     2155               else do:
     2156                   assign
     2157                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     2158                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     2159                   .
     2160                   assign
     2161                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     2162                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     2163                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2164                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     2165                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     2166                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     2167                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2168                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     2169                   .
     2170               end.
     2171           end.
     2172       end.
     2173   end.
     2174   end procedure.
     2175   procedure bge-xml-get-ref-filename :
     2176   define input parameter p-in-file-name       as character        no-undo.
     2177   define output parameter p-home-dir          as character        no-undo.
     2178   define output parameter p-out-file-name     as character        no-undo.
     2179   define output parameter p-locked            as logical          no-undo.
     2180       define variable v-counter       as integer      no-undo.
     2181       define variable v-error-level   as integer      no-undo.
     2182   do
     2183   on error undo, return error
     2184   :
     2185       run bge/bge-ini.p (
     2186             input "bge"
     2187           , output p-home-dir
     2188       ).
     2189       if return-value <> "OK"
     2190       then do:
     2191           undo, return error.
     2192       end.
     2193       assign
     2194           p-home-dir = p-home-dir + "\dict":U
     2195       .
     2196       run bge/dir_cd.p (
     2197           input p-home-dir
     2198           , input "CA"
     2199       ).
     2200       if return-value = "ERROR"
     2201       then do:
     2202           undo, return error.
     2203       end.
     2204       assign
     2205           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     2206       .
     2207       assign
     2208           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     2209       .
     2210       wait-lock:
     2211       do v-counter = 1 TO 3
     2212       :
     2213           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     2214           if p-locked = no
     2215           then do:
     2216               leave wait-lock.
     2217           end.
     2218           else do:
     2219               readkey pause 1.
     2220           end.
     2221       END.
     2222       if p-locked = yes
     2223       then do:
     2224           undo, return error.
     2225       end.
     2226       run bge/os_copy.p (
     2227             input "D":U
     2228           , input p-out-file-name + "xml":U
     2229           , input "":U
     2230           , output v-error-level
     2231       ).
     2232       if v-error-level > 0
     2233       then do:
     2234           undo, return error.
     2235       end.
     2236   end.
     2237   end procedure.
     2238   procedure bge-xml-write-ref-header :
     2239   define input parameter p-bge-name as character        no-undo.
     2240   define input parameter p-file-name as character        no-undo.
     2241       define variable v-out-string    as character    no-undo.
     2242   do
     2243   on error undo, return error
     2244   :
     2245       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2246       put stream stmXMLOut unformatted
     2247           "<?xml version='1.0' encoding='windows-1251'?>":U
     2248       .
     2249       assign
     2250           v-out-string = substitute( "&1&2"
     2251                               , chr(10)
     2252                               , "<IBS_Trade_House>":U )
     2253       .
     2254       put stream stmXMLOut unformatted
     2255           v-out-string
     2256       .
     2257       run wp-XMLTagOpen( 1, "header", "" ).
     2258       if v-bge-xml-bgeflold = "oracle":u
     2259       then do:
     2260         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2261         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2262         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2263         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2264         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2265       end.
     2266       else do:
     2267         run wp-XMLTagOpen( 2, "delivery", "" ).
     2268         run wp-XMLTagOpen( 3, "to", "" ).
     2269         run wp-XMLTagClose( 3, "to" ).
     2270         run wp-XMLTagOpen( 3, "from", "" ).
     2271         run wp-XMLTagClose( 3, "from" ).
     2272         run wp-XMLTagClose( 2, "delivery" ).
     2273       end.
     2274       run wp-XMLTagOpen( 2, "manifest", "" ).
     2275       run wp-XMLTagOpen( 3, "document", "" ).
     2276       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2277       run wp-XMLTagPut( 4, "description", "", 0 ).
     2278       run wp-XMLTagClose( 3, "document" ).
     2279       run wp-XMLTagClose( 2, "manifest" ).
     2280       run wp-XMLTagClose( 1, "header" ).
     2281       run wp-XMLTagOpen( 1, "body", "" ).
     2282   end.
     2283   end procedure.
     2284   procedure bge-xml-write-ref-footer :
     2285   define input parameter p-file-name as character        no-undo.
     2286       define variable v-error-level   as integer      no-undo.
     2287   do
     2288   on error undo, return error
     2289   :
     2290       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2291       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2292       output stream stmXMLOut close.
     2293       run bge/os_copy.p (
     2294             input "M":U
     2295           , input p-file-name + "xm1":U
     2296           , input p-file-name + "xml":U
     2297           , output v-error-level
     2298       ).
     2299       if v-error-level > 0
     2300       then do:
     2301           undo, return error.
     2302       end.
     2303   end.
     2304   end procedure.
     2305   procedure bge-xml-out-dir :
     2306   define output parameter p-out-dir       as character    no-undo.
     2307   define output parameter p-log-file-name as character    no-undo.
     2308   do
     2309   on error undo, return error
     2310   :
     2311       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2312       if p-out-dir = ?
     2313       then do:
     2314           message
     2315             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2316                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2317             skip(1)
     2318             skip "Обратитесь к администратору."
     2319           view-as alert-box error.
     2320           undo, return error .
     2321       end.
     2322       if v-bge-xml-bgeflold <> "oracle" then assign
     2323         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2324       .
     2325       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2326       if error-status :error  then do:
     2327           run wp-XMLWriteLog in this-procedure (
     2328                 input p-log-file-name
     2329               , input 0
     2330               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2331                                   , p-out-dir
     2332                                   , return-value
     2333                                   , trim( error-status :get-message( 1 ) )
     2334                                   )
     2335           ).
     2336           undo, return error.
     2337       end.
     2338       assign
     2339           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2340           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2341       .
     2342   end.
     2343   end procedure.
     2344   procedure bge-xml-out-dir2 :
     2345   define output parameter p-out-dir       as character    no-undo.
     2346   define output parameter p-out-dirR      as character    no-undo.
     2347   define output parameter p-log-file-name as character    no-undo.
     2348   do
     2349   on error undo, return error
     2350   :
     2351       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2352       if p-out-dir = ?
     2353       then do:
     2354           message
     2355             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2356                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2357             skip(1)
     2358             skip "Обратитесь к администратору."
     2359           view-as alert-box error.
     2360           undo, return error .
     2361       end.
     2362       if v-bge-xml-bgeflold <> "oracle" then assign
     2363             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2364             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2365         .
     2366       else p-out-dirR = p-out-dir .
     2367       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2368       if error-status :error  then do:
     2369           run wp-XMLWriteLog in this-procedure (
     2370                 input p-log-file-name
     2371               , input 0
     2372               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2373                                   , p-out-dir
     2374                                   , return-value
     2375                                   , error-status :get-message( 1 )
     2376                                   )
     2377           ).
     2378           undo, return error.
     2379       end.
     2380       if p-out-dirR <> p-out-dir then do:
     2381         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2382         if error-status :error then do:
     2383           run wp-XMLWriteLog in this-procedure (
     2384                 input p-log-file-name
     2385               , input 0
     2386               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2387                                   , p-out-dirR
     2388                                   , return-value
     2389                                   , error-status :get-message( 1 )
     2390                                   )
     2391           ).
     2392           p-out-dirR = p-out-dir .
     2393         end.
     2394       end .
     2395       assign
     2396         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2397         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2398       .
     2399   end.
     2400   end procedure.
     2401   procedure bge-xml-out-file :
     2402   do
     2403   on error undo, return error
     2404   :
     2405   define input parameter p-out-dir            as character        no-undo.
     2406   define input parameter p-prefix             as character        no-undo.
     2407   define input parameter p-sheduled           as logical          no-undo.
     2408   define output parameter p-xml-file-name     as character        no-undo.
     2409   define output parameter p-locked            as logical          no-undo.
     2410   define variable v-home-dir      as character     no-undo.
     2411   define variable v-error-num     as integer       no-undo.
     2412   define variable v-today             as date         no-undo.
     2413   define variable v-time              as integer      no-undo.
     2414       if v-bge-xml-bgefmt = "dbf":U
     2415       then do:
     2416           assign
     2417               p-xml-file-name = p-out-dir
     2418               p-locked        = no
     2419           .
     2420       end.
     2421       else do:
     2422           if v-bge-xml-bgeflold = "firm":U
     2423           then do:
     2424               run bge/genfname.p (
     2425                     input p-out-dir
     2426                   , input p-prefix
     2427                   , input "":U
     2428                   , input "arj":U
     2429                   , input "":U
     2430                   , output p-xml-file-name
     2431               ).
     2432           end.
     2433           else do:
     2434               run bge/genfname.p (
     2435                     input p-out-dir
     2436                   , input p-prefix
     2437                   , input "":U
     2438                   , input "xml":U
     2439                   , input "":U
     2440                   , output p-xml-file-name
     2441               ).
     2442           end.
     2443           assign
     2444               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2445               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2446           .
     2447       end.
     2448   end.
     2449   end procedure.
     2450   procedure bge-xml-init-ext-doc-type :
     2451       define variable v-counter    as integer      no-undo.
     2452       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2453   do
     2454   for buf_temp_ext-doc-type
     2455   on error undo, return error
     2456   :
     2457       empty temp-table buf_temp_ext-doc-type.
     2458       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2459       :
     2460           create buf_temp_ext-doc-type.
     2461           assign
     2462               buf_temp_ext-doc-type.edt-key               = v-counter
     2463               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2464               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2465           .
     2466       end.
     2467   end.
     2468   end procedure.
     2469   procedure bge-xml-get-decimal-shift-num :
     2470   define input parameter p-shift-date     as date             no-undo.
     2471   define input parameter p-shift-num      as integer          no-undo.
     2472   define output parameter p-shift-decimal as decimal          no-undo.
     2473   do
     2474   on error undo, return error
     2475   :
     2476       assign
     2477           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2478       .
     2479   end.
     2480   end procedure.
     2481   procedure bge-xml-ora-exp-filename :
     2482     define input  parameter p-table-name  as character no-undo .
     2483     define input  parameter p-doc-code    as character no-undo .
     2484     define input  parameter p-obj-code    as integer   no-undo .
     2485     define output parameter p-filename    as character no-undo .
     2486     define output parameter p-seq-num     as integer   no-undo .
     2487     define variable v-ora-exp-seq     as integer   no-undo .
     2488     define variable v-ora-exp-seq-str as character no-undo .
     2489     define variable v-home-dir        as character no-undo.
     2490   do
     2491   on error undo, return error return-value
     2492   :
     2493     if v-bge-xml-bgeflold = "oracle":u
     2494     then do:
     2495       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2496       if v-home-dir = ?
     2497       then do:
     2498         undo, return error substitute( "&1&2&3":U
     2499                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2500                                       , chr(10)
     2501                                       , "Обратитесь к администратору.":U
     2502                                       ).
     2503       end.
     2504       assign
     2505           v-home-dir = v-home-dir
     2506       .
     2507       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2508       if error-status :error
     2509       then do:
     2510         undo, return error substitute( "&1&2&3":U
     2511                                       , "Неверно задан каталог экспорта.":U
     2512                                       , chr(10)
     2513                                       , "Обратитесь к администратору.":U
     2514                                       ).
     2515       end.
     2516       assign
     2517         v-ora-exp-seq = ?
     2518       .
     2519       if  p-table-name <> ? and
     2520           p-doc-code <> ?
     2521       then do:
     2522         run bge/get-oesq.p ( input p-table-name
     2523                            , input p-doc-code
     2524                            , output v-ora-exp-seq
     2525                            ) no-error .
     2526         if error-status :error = yes
     2527         then do:
     2528           undo, return error return-value .
     2529         end.
     2530       end.
     2531       if v-ora-exp-seq = ?
     2532       then do:
     2533         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2534         if error-status :error
     2535         then do:
     2536           undo, return error return-value .
     2537         end.
     2538       end.
     2539       if p-table-name <> ? and
     2540          p-doc-code   <> ?
     2541       then do:
     2542         run bge/oesqdoc.p ( input p-table-name
     2543                           , input p-doc-code
     2544                           , input v-ora-exp-seq
     2545                           ) no-error .
     2546         if error-status :error = yes
     2547         then do:
     2548           undo, return error return-value .
     2549         end.
     2550       end.
     2551       assign
     2552         p-seq-num  = v-ora-exp-seq
     2553         p-filename = substitute("&1/&2-000_&3."
     2554                                , v-home-dir
     2555                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2556                                , string(v-ora-exp-seq , "999999999")
     2557                                )
     2558       .
     2559     end.
     2560   end.
     2561   end procedure.
     2562   procedure bge-xml-date-to-str :
     2563     define input  parameter p-date  as date      no-undo .
     2564     define output parameter p-str   as character no-undo .
     2565   do
     2566   on error undo, return error return-value
     2567   :
     2568     if p-date <> ?
     2569     then do:
     2570       assign
     2571         p-str = substitute( "&1-&2-&3"
     2572                           , string( year(p-date)  , "9999")
     2573                           , string( month(p-date) , "99"  )
     2574                           , string( day(p-date)   , "99"  )
     2575                           )
     2576       .
     2577     end.
     2578     else do:
     2579       assign
     2580         p-str = ?
     2581       .
     2582     end.
     2583   end.
     2584   end procedure.
     2585   procedure bge-xml-date-str-to-str :
     2586     define input  parameter p-date-str  as character no-undo .
     2587     define output parameter p-str       as character no-undo .
     2588     define variable v-date          as date      no-undo .
     2589     define variable v-date-valid    as logical   no-undo .
     2590     define variable v-error-message as character no-undo .
     2591   do
     2592   on error undo, return error return-value
     2593   :
     2594     assign
     2595       p-str = ?
     2596     .
     2597     if p-date-str = ? or p-date-str = ""
     2598     then do:
     2599       return .
     2600     end.
     2601     run strtdate in this-procedure ( input  p-date-str
     2602                                    , output v-date
     2603                                    , output v-date-valid
     2604                                    , output v-error-message
     2605                                    ).
     2606     if v-date-valid <> true
     2607     then do:
     2608       return .
     2609     end.
     2610     assign
     2611       p-str = substitute( "&1-&2-&3"
     2612                         , string( year(v-date)  , "9999")
     2613                         , string( month(v-date) , "99"  )
     2614                         , string( day(v-date)   , "99"  )
     2615                         )
     2616     .
     2617   end.
     2618   end procedure.
     2619   procedure bge-xml-fill-tt-bgecliiv :
     2620     define input  parameter p-str as character no-undo .
     2621     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2622     define buffer buf_clients             for ub.clients.
     2623     define variable v-i         as integer   no-undo .
     2624     define variable v-count     as integer   no-undo .
     2625     define variable v-cli-count as integer   no-undo .
     2626     define variable v-client    as character no-undo .
     2627     define variable v-obj-type  as character no-undo .
     2628     define variable v-obj-code  as integer   no-undo .
     2629   do
     2630   on error undo, return error return-value
     2631   :
     2632     empty temp-table buf_tt-bge-xml-bgecliiv.
     2633     assign
     2634       v-bge-xml-bgecliiv = no
     2635       v-cli-count        = num-entries(p-str,';')
     2636     .
     2637     if v-cli-count > 0
     2638     then do:
     2639       _cli-cycle:
     2640       do v-i = 1 to v-cli-count
     2641       :
     2642         assign
     2643           v-client = entry(v-i , p-str, ';')
     2644         .
     2645         if num-entries(v-client) <> 2
     2646         then do:
     2647           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2648         end.
     2649         assign
     2650           v-obj-type = entry(1, v-client)
     2651         .
     2652         assign
     2653           v-obj-code = integer(entry(2, v-client))
     2654         no-error .
     2655         if error-status :error
     2656         then do:
     2657           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2658         end.
     2659         find first buf_clients no-lock
     2660           where buf_clients.obj-type = v-obj-type
     2661             and buf_clients.obj-code = v-obj-code
     2662         no-error.
     2663         if not available buf_clients
     2664         then do:
     2665           next _cli-cycle.
     2666         end.
     2667         find first buf_tt-bge-xml-bgecliiv no-lock
     2668           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2669             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2670         no-error .
     2671         if available buf_tt-bge-xml-bgecliiv
     2672         then do:
     2673           next _cli-cycle.
     2674         end.
     2675         create buf_tt-bge-xml-bgecliiv.
     2676         assign
     2677           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2678           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2679         .
     2680       end.
     2681     end.
     2682     else do:
     2683       assign
     2684         v-bge-xml-bgecliiv = no
     2685       .
     2686       return .
     2687     end.
     2688     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2689     if available buf_tt-bge-xml-bgecliiv
     2690     then do:
     2691       assign
     2692         v-bge-xml-bgecliiv = yes
     2693       .
     2694     end.
     2695   end.
     2696   end procedure.
     2697   procedure bge-xml-resolve-ext-doc-type :
     2698     define input  parameter p-ext-doc-type      as character no-undo .
     2699     define input  parameter p-obj-type          as character no-undo .
     2700     define input  parameter p-obj-code          as integer   no-undo .
     2701     define output parameter p-out-ext-doc-type  as character no-undo .
     2702     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2703   do
     2704   on error undo, return error return-value
     2705   :
     2706     assign
     2707       p-out-ext-doc-type = p-ext-doc-type
     2708     .
     2709     if p-ext-doc-type <> 'ie':U
     2710     then do:
     2711       return .
     2712     end.
     2713     if v-bge-xml-bgecliiv = yes
     2714     then do:
     2715       find first buf_tt-bge-xml-bgecliiv no-lock
     2716         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2717           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2718       no-error .
     2719       if available buf_tt-bge-xml-bgecliiv
     2720       then do:
     2721         assign
     2722           p-out-ext-doc-type = 'iv':U
     2723         .
     2724       end.
     2725     end.
     2726   end.
     2727   end procedure.
     2728   procedure safe-wp-xmltagput :
     2729     define input  parameter pTagLevel   as integer   no-undo .
     2730     define input  parameter pTagName    as character no-undo .
     2731     define input  parameter pParValue   as character no-undo .
     2732     define input  parameter pFlagEmpty  as integer   no-undo .
     2733   do
     2734   on error undo, return error return-value
     2735   :
     2736     if v-bge-xml-bgeflold = "oracle":u
     2737     then do:
     2738       return .
     2739     end.
     2740     run wp-xmltagput in this-procedure ( input pTagLevel
     2741                                        , input pTagName
     2742                                        , input pParValue
     2743                                        , input pFlagEmpty
     2744                                        ).
     2745   end.
     2746   end procedure.
     2747   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2748   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
