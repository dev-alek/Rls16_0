     3262        RECT-3 AT ROW 11.42 COL 2
     3263        RECT-gds AT ROW 16.96 COL 2 WIDGET-ID 16
     3264        SPACE(0.99) SKIP(0.28)
     3265       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3266            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3267            TITLE "Диапазон дат для экспорта".
     3268   ASSIGN
     3269          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     3270          FRAME Dialog-Frame:HIDDEN           = TRUE.
     3271   ASSIGN
     3272          bt-cash-pay:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     3273   ASSIGN
     3274          ed-doc-type:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     3275   ASSIGN
     3276          ed-doc-type-label:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     3277   ASSIGN
     3278          EDITOR-gds-grp:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     3279   ASSIGN
     3280          rs-cash-pay:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     3281   ASSIGN
     3282          tb-supp:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     3283   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     3284   DO:
     3285     APPLY "END-ERROR":U TO SELF.
     3286   END.
     3287   ON CHOOSE OF bt-cash-pay IN FRAME Dialog-Frame
     3288   DO:
     3289       run ref/cashpays.w (
     3290            INPUT parparentproc
     3291           ,INPUT "b-sel,b-mark":U
     3292           ,input v-bge-dper-host-code
     3293           ,input v-bge-dper-store-type
     3294           ,input v-bge-dper-store-code
     3295           ,OUTPUT p-pay-type-list
     3296           ).
     3297   END.
     3298   ON CHOOSE OF bt-sel-doc-type IN FRAME Dialog-Frame
     3299   DO:
     3300       define variable v-cancel     as logical           no-undo.
     3301       run bge/bgeseltp.w (
     3302             input "trn-doc":U
     3303           , input p-init-doc-type-list
     3304           , output p-doc-type-list
     3305           , output v-cancel
     3306       ) no-error.
     3307       if error-status :error
     3308       then do:
     3309           message
     3310             vss-workfile vss-revision vss-description
     3311             skip "Ошибка выбора типов операций."
     3312             skip return-value
     3313             skip trim(error-status :get-message(1))
     3314                  trim(error-status :get-message(2))
     3315                  trim(error-status :get-message(3))
     3316                  trim(error-status :get-message(4))
     3317                  trim(error-status :get-message(5))
     3318           view-as alert-box error.
     3319           undo, return no-apply .
     3320       end.
     3321       if v-cancel = yes
     3322       then do:
     3323           assign
     3324               p-doc-type-list = p-init-doc-type-list
     3325           .
     3326       end.
     3327       else do:
     3328           assign
     3329               p-init-doc-type-list    = p-doc-type-list
     3330           .
     3331           if p-doc-type-list = ''
     3332           then do:
     3333               assign
     3334                   ed-doc-type :screen-value in frame Dialog-Frame = "Все"
     3335               .
     3336           end.
