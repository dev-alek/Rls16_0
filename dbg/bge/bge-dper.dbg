     3800       end.
     3801       run gbl/getcurdt.p
     3802         (output v-curr-sv-date
     3803         ) .
     3804       assign
     3805         self :screen-value = string(v-curr-sv-date) .
     3806       .
     3807     end.
     3808     return no-apply.
     3809   end.
     3810   on ctrl-b of date_from in frame Dialog-Frame
     3811   do:
