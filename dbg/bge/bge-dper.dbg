     2852   procedure uf-get :
     2853     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     2854     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     2855     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     2856     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     2857     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     2858     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     2859     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     2860     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     2861     do
     2862     on error undo, return error
     2863     :
     2864       define buffer buf_usr-flt for ubflt.usr-flt .
     2865       define variable v-use-List_     as logical   no-undo .
     2866       define variable v-type-List_     as character no-undo .
     2867       define variable v-format-List_   as character no-undo .
     2868       define variable v-use-Naim      as logical   no-undo .
     2869       define variable v-type-Naim      as character no-undo .
     2870       define variable v-format-Naim    as character no-undo .
     2871       define variable v-use-print-graft as logical   no-undo .
     2872       define variable v-use-sort-gr     as logical   no-undo .
     2873       define variable v-use-type-price  as logical   no-undo .
     2874       define variable v-use-type-val    as logical   no-undo .
     2875       define variable v-label          as character no-undo .
     2876       define variable v-tooltip        as character no-undo .
     2877       define variable v-user-can-edit  as logical   no-undo .
     2878       define variable v-output-display as logical   no-undo .
     2879       define variable v-other          as character no-undo .
     2880       run uf-name in this-procedure
     2881          (input  entry(1, p-code, chr(4))
     2882         ,output v-use-List_
     2883         ,output v-type-List_
     2884         ,output v-format-List_
     2885         ,output v-use-Naim
     2886         ,output v-type-Naim
     2887         ,output v-format-Naim
     2888         ,output v-use-print-graft
     2889         ,output v-use-sort-gr
     2890         ,output v-use-type-price
     2891         ,output v-use-type-val
     2892         ,output v-label
     2893         ,output v-tooltip
     2894         ,output v-user-can-edit
     2895         ,output v-output-display
     2896         ,output v-other
     2897         ) no-error .
     2898       if error-status :error then do:
     2899         undo, return error return-value .
     2900       end.
     2901       find first buf_usr-flt no-lock where
     2902                  buf_usr-flt.Call-point     = p-code AND
     2903                  buf_usr-flt.user-name       = p-user-name
     2904         no-error .
     2905       if avail buf_usr-flt then do:
     2906         assign
     2907         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     2908         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     2909         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     2910         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     2911         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     2912         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     2913         .
     2914       end.
     2915       else do:
     2916         assign
     2917         p-List_        = (if v-use-List_       then "":U                    else ?)
     2918         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     2919         p-print-graft  = (if v-use-print-graft then no                      else ?)
     2920         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     2921         p-type-price   = (if v-use-type-price  then no                      else ?)
     2922         p-type-val     = (if v-use-List_       then no                      else ?)
     2923         .
     2924       end.
     2925     end.
     2926   end procedure.
     2927   procedure uf-set :
     2928     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     2929     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     2930     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     2931     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     2932     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     2933     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     2934     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     2935     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     2936     do
     2937     on error undo, return error
     2938     :
     2939       define buffer buf_usr-flt for ubflt.usr-flt .
     2940       define variable v-use-List_     as logical   no-undo .
     2941       define variable v-type-List_     as character no-undo .
     2942       define variable v-format-List_   as character no-undo .
     2943       define variable v-use-Naim      as logical   no-undo .
     2944       define variable v-type-Naim      as character no-undo .
     2945       define variable v-format-Naim    as character no-undo .
     2946       define variable v-use-print-graft as logical   no-undo .
     2947       define variable v-use-sort-gr   as logical   no-undo .
     2948       define variable v-use-type-price as logical   no-undo .
     2949       define variable v-use-type-val  as logical   no-undo .
     2950       define variable v-tooltip        as character no-undo .
     2951       define variable v-label          as character no-undo .
     2952       define variable v-user-can-edit  as logical   no-undo .
     2953       define variable v-output-display as logical   no-undo .
     2954       define variable v-other          as character no-undo .
     2955       run uf-name in this-procedure
     2956         (input  entry(1, p-code, chr(4))
     2957         ,output v-use-List_
     2958         ,output v-type-List_
     2959         ,output v-format-List_
     2960         ,output v-use-Naim
     2961         ,output v-type-Naim
     2962         ,output v-format-Naim
     2963         ,output v-use-print-graft
     2964         ,output v-use-sort-gr
     2965         ,output v-use-type-price
     2966         ,output v-use-type-val
     2967         ,output v-label
     2968         ,output v-tooltip
     2969         ,output v-user-can-edit
     2970         ,output v-output-display
     2971         ,output v-other
     2972         ) no-error .
     2973       if error-status :error then do:
     2974         undo, return error return-value .
     2975       end.
     2976       find first buf_usr-flt where
     2977                  buf_usr-flt.Call-point     = p-code AND
     2978                  buf_usr-flt.user-name       = p-user-name
     2979         no-error .
     2980       if not avail buf_usr-flt then do:
     2981           create buf_usr-flt .
     2982           assign
     2983           buf_usr-flt.call-point = p-code
     2984           buf_usr-flt.user-name  = p-user-name
     2985           .
     2986       end.
     2987       if avail buf_usr-flt then do:
     2988        assign
     2989        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     2990        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     2991        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     2992        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     2993        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     2994        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     2995       .
     2996       release buf_usr-flt.
     2997       end.
     2998       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     2999     end.
     3000   end procedure.
     3001   define variable vss-include-info8 as character format "X(65)" no-undo
     3002   initial "@(#)$Workfile$ $Revision$".
     3003   procedure grplib-get-full-name :
     3004      define input parameter p-node-code  as integer      no-undo.
     3005      define output parameter p-full-name as character    no-undo.
     3006      do
     3007   on error undo, return error
     3008   :
     3009       define variable v-upper-code    as integer           no-undo.
     3010       define buffer buf_gds-grp       for ub.gds-grp.
     3011       define buffer buf_upper_gds-grp for ub.gds-grp.
     3012       find first buf_gds-grp no-lock
     3013            where buf_gds-grp.node-code = p-node-code
     3014       no-error.
     3015       if not available buf_gds-grp
     3016       then do:
     3017           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     3018       end.
     3019       assign
     3020           p-full-name  = ""
     3021           v-upper-code = 1
     3022       .
     3023       do while buf_gds-grp.upper-code <> 0
     3024       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     3025       :
     3026           assign
     3027               p-full-name  = buf_gds-grp.node-name
     3028                            + (if p-full-name <> "" then chr(47) else "")
     3029                            + p-full-name
     3030               v-upper-code = buf_gds-grp.upper-code
     3031           .
     3032           find first buf_gds-grp no-lock
     3033                where buf_gds-grp.node-code = v-upper-code
     3034           no-error.
     3035           if not available buf_gds-grp
     3036           then do:
     3037               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     3038                                   + string( v-upper-code )
     3039                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     3040           end.
     3041       end.
     3042       assign
     3043       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     3044       .
     3045   end.
     3046   end .
     3047   procedure grplib-get-node-from-full-name :
     3048   define input parameter p-full-name as character no-undo .
     3049   define output parameter p-node-code as integer no-undo .
     3050   define variable v-ii as integer no-undo .
     3051   define variable v-upper-code as integer no-undo .
     3052   define variable v-root-code as integer no-undo .
     3053   define variable v-entry as character no-undo .
     3054   define buffer buf_gds-grp       for ub.gds-grp.
     3055   do
     3056   on error undo, return error
     3057   :
     3058     find first buf_gds-grp no-lock
     3059         where buf_gds-grp.upper-code = 0
     3060     no-error .
     3061     if not available buf_gds-grp
     3062     then do:
     3063         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     3064     end.
     3065     else do:
     3066       assign
     3067       v-root-code = buf_gds-grp.node-code
     3068       .
     3069     end.
     3070     v-upper-code = v-root-code.
     3071     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     3072       assign
     3073       v-entry = entry(v-ii, p-full-name, chr(47)).
     3074       if v-entry = '' then leave.
     3075       find first buf_gds-grp no-lock where
     3076                 buf_gds-grp.node-name = v-entry
     3077             and buf_gds-grp.upper-code = v-upper-code
     3078             no-error.
     3079       if not available buf_gds-grp then do:
     3080         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     3081       end.
     3082       else do:
     3083         p-node-code = buf_gds-grp.node-code.
     3084         v-upper-code = buf_gds-grp.node-code.
     3085       end.
     3086     end.
     3087   end.
     3088   end .
     3089   define variable v-bge-dper-host-code    as integer      no-undo.
     3090   define variable v-bge-dper-store-type   as character    no-undo.
