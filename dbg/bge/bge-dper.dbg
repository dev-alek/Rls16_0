     3458   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
     3459   DO:
     3460       ASSIGN
     3461           date_from
     3462           date_to
     3463           tb-inkass-pay-code
     3464           tb-cst-code
     3465           tb-parts
     3466           tb-deleted
     3467           tb-supp
     3468           tb-exp-checks
     3469           tb-exp-doc-rvs
     3470           rs-1
     3471           tb-chk-pay-code
     3472           tb-pay-desk
     3473           tb-pay-desk-cards
     3474           date_exp_from = date_from
     3475           date_exp_to   = date_to
     3476       .
     3477       assign
     3478         p-chk = tb-exp-checks
     3479         p-doc-rvs = tb-exp-doc-rvs
     3480       .
     3481       if date_from > date_to
     3482       and p-output-type <> 4
     3483       and p-output-type <> 5
     3484       then do:
     3485           message
     3486               "Даты интервала заданы неверно. "
     3487               skip " Нижняя дата интервала должна быть меньше верхней."
     3488               skip(1) "Задайте интервал дат правильно или отмените экспорт."
     3489           view-as alert-box information.
     3490           apply "entry" to date_from.
     3491           undo, return no-apply.
     3492       end.
     3493       if p-output-type = 0
     3494       then do:
     3495         case rs-1 :screen-value
     3496         :
     3497         when "1"
     3498         then do:
     3499             assign
     3500                 p-range = 1
     3501                 p-obj-list = ""
     3502             .
     3503         end.
     3504         when "2"
     3505         then do:
     3506             assign
     3507                 p-range = 2
     3508                 p-obj-list = ""
     3509             .
     3510         end.
     3511         when "3"
     3512         then do:
     3513             assign
     3514                 p-range = 3
     3515             .
     3516             assign
     3517                 p-obj-list = ""
     3518             .
     3519             for each temp_obj-list
     3520             :
     3521                 assign
     3522                     p-obj-list = p-obj-list
     3523                             + ( if p-obj-list = "" then "" else "," ) + temp_obj-list.obj-type
     3524                             + "," + string( temp_obj-list.obj-code )
     3525                 .
     3526             end.
     3527         end.
     3528         end case.
     3529       end.
     3530       if p-output-type = 2
     3531       then do:
     3532           assign
     3533               p-cst = tb-supp
     3534               p-range     = 2
     3535               p-host-code = v-bge-dper-host-code
     3536               p-obj-list  = ""
     3537           .
     3538       end.
     3539       if p-output-type = 1
     3540       or p-output-type = 3
     3541       or p-output-type = 4
     3542       or p-output-type = 5
     3543       or p-output-type = 6
     3544       then do:
     3545           if p-output-type = 1 or p-output-type = 4
     3546           then do:
     3547               assign
     3548                   p-pay-code     = tb-inkass-pay-code
     3549                   p-cst          = tb-cst-code
     3550                   p-parts        = tb-parts
     3551                   p-deleted      = tb-deleted
     3552                   p-chk-pay-code = tb-chk-pay-code
     3553                   p-pay-desk     = tb-pay-desk
     3554                   p-pay-desk-cards = tb-pay-desk-cards
     3555               .
     3556           end.
     3557           case rs-1 :screen-value
     3558           :
     3559           when "1"
     3560           then do:
     3561               assign
     3562                   p-range = 1
     3563                   p-obj-list = ""
     3564               .
     3565           end.
     3566           when "2"
     3567           then do:
     3568               assign
     3569                   p-range = 2
     3570                   p-host-code = v-bge-dper-host-code
     3571                   p-obj-list = ""
     3572               .
     3573           end.
     3574           when "3"
     3575           then do:
     3576               assign
     3577                   p-range = 3
     3578               .
     3579               assign
     3580                   p-obj-list = ""
     3581               .
     3582               for each temp_obj-list
     3583               :
     3584                   assign
     3585                       p-obj-list = p-obj-list
     3586                               + ( if p-obj-list = "" then "" else "," ) + temp_obj-list.obj-type
     3587                               + "," + string( temp_obj-list.obj-code )
     3588                   .
     3589               end.
     3590           end.
     3591           end case.
     3592       end.
     3593       run flt-save in this-procedure .
     3594       APPLY "GO" TO FRAME Dialog-Frame.
     3595   END.
