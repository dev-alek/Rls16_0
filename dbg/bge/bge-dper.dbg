     3400       if v-object-available = true
     3401       then do:
     3402   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3403   run userobjs_append in this-procedure
     3404     (input  v-bge-dper-store-type
