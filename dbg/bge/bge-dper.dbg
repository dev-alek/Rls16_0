     3833           (output v-curr-sv-date
     3834           ) .
     3835       end.
     3836       if v-curr-sv-date <> ?
     3837       then do:
     3838         assign
     3839           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     3840         .
     3841         assign
     3842           self :screen-value = string(v-new-sv-date) .
     3843         .
     3844       end.
     3845     end.
     3846     return no-apply .
     3847   end.
     3848   on ctrl-e of date_from in frame Dialog-Frame
     3849   do:
     3850     if (can-query (self, "sensitive")
     3851        and
     3852        self :sensitive = true
     3853        )
     3854     or (can-query (self, "read-only")
     3855        and
     3856        self :read-only = false
     3857        )
     3858     then do:
     3859       if self :handle <> focus :handle
     3860       then do:
     3861         apply "entry":u to self .
     3862       end.
     3863       define variable v-curr-sv-date as date no-undo .
     3864       define variable v-new-sv-date  as date no-undo .
     3865       assign
     3866         v-curr-sv-date = date(self :screen-value) no-error
     3867       .
     3868       if v-curr-sv-date = ?
     3869       then do:
     3870         run gbl/getcurdt.p
     3871           (output v-curr-sv-date
     3872           ) .
