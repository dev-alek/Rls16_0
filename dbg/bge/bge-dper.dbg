     4372   PROCEDURE flt-load :
     4373     define variable v-obj-range      as integer   no-undo .
     4374     define variable v-obj-list       as character no-undo .
     4375     define variable v-doc-range      as integer   no-undo .
     4376     define variable v-doc-list       as character no-undo .
     4377     define variable v-userid         as character no-undo .
     4378     define variable v-naim           as character no-undo .
     4379     define variable v-list           as character no-undo .
     4380     define variable v-print-graft    as logical   no-undo .
     4381     define variable v-sort-gr        as logical   no-undo .
     4382     define variable v-type-price     as logical   no-undo .
     4383     define variable v-type-val       as logical   no-undo .
     4384     define variable v-found          as logical   no-undo .
     4385     define variable v-str            as character no-undo .
     4386     define variable v-obj-tot        as integer   no-undo .
     4387     define variable v-i              as integer   no-undo .
     4388     define variable v-obj-type       as character no-undo .
     4389     define variable v-obj-code       as integer   no-undo .
     4390   do
     4391   on error undo, return error return-value
     4392   :
     4393     run uf-get (
     4394         input   'bge-dper.w':U
     4395       , input   v-cntxt-userid
     4396       , output  v-list
     4397       , output  v-naim
     4398       , output  v-print-graft
     4399       , output  v-sort-gr
     4400       , output  v-type-price
     4401       , output  v-type-val
     4402       ) .
     4403     if num-entries(v-naim) = 12
     4404     then do:
     4405       assign
     4406         date_from           = date(    entry( 1, v-naim ) )
     4407         date_to             = date(    entry( 2, v-naim ) )
     4408         tb-chk-pay-code     = logical( entry( 3, v-naim ) )
     4409         tb-cst-code         = logical( entry( 4, v-naim ) )
     4410         tb-deleted          = logical( entry( 5, v-naim ) )
     4411         tb-exp-checks       = logical( entry( 6, v-naim ) )
     4412         tb-inkass-pay-code  = logical( entry( 7, v-naim ) )
     4413         tb-parts            = logical( entry( 8, v-naim ) )
     4414         tb-pay-desk         = logical( entry( 9, v-naim ) )
     4415         tb-pay-desk-cards   = logical( entry(10, v-naim ) )
     4416         tb-supp             = logical( entry(11, v-naim ) )
     4417         tb-exp-doc-rvs      = logical( entry(12, v-naim ) )
     4418       .
     4419       if tb-chk-pay-code = yes
     4420       then do:
     4421         enable
     4422           tb-pay-desk
     4423           tb-pay-desk-cards
     4424         with frame Dialog-Frame.
     4425       end.
     4426       display
     4427         date_from    when not( p-output-type = 4 or p-output-type = 5)
     4428         date_to
     4429         tb-chk-pay-code
     4430         tb-cst-code
     4431         tb-deleted
     4432         tb-exp-checks
     4433         tb-exp-doc-rvs
     4434         tb-inkass-pay-code
     4435         tb-parts
     4436         tb-pay-desk
     4437         tb-pay-desk-cards
     4438         tb-supp           when p-output-type = 2
     4439       with frame Dialog-Frame.
     4440     end.
     4441     if num-entries(v-list,';') = 2
     4442     then do:
     4443       assign
     4444         v-str = entry( 1 , v-list, ';')
     4445       .
     4446       if num-entries(v-str,':') = 2
     4447       then do:
     4448         assign
     4449           rs-1        = integer(entry(1, v-str, ':'))
     4450           v-obj-list  = entry(2, v-str, ':')
     4451           v-obj-tot   = num-entries(v-obj-list)
     4452         .
     4453         if rs-1 = 3 and v-obj-tot < 2
     4454         then do:
     4455           assign
     4456             rs-1 = 1
     4457           .
     4458         end.
     4459         run object-select in this-procedure .
     4460         if rs-1:visible then
     4461         display
     4462           rs-1
     4463         with frame Dialog-Frame.
     4464         if rs-1 = 3
     4465         then do:
     4466           if v-obj-tot modulo 2 = 0
     4467           then do:
     4468             for each temp_obj-list
     4469             :
     4470               delete temp_obj-list.
     4471             end.
     4472             do v-i = 1 to v-obj-tot / 2
     4473             :
     4474               assign
     4475                 v-obj-type = entry( v-i * 2 - 1, v-obj-list )
     4476                 v-obj-code = integer( entry( v-i * 2, v-obj-list ) )
     4477               .
     4478               find first temp_obj-list no-lock
     4479                 where temp_obj-list.obj-type = v-obj-type
     4480                   and temp_obj-list.obj-code = v-obj-code
     4481               no-error .
     4482               if not available temp_obj-list
     4483               then do:
     4484                 create temp_obj-list.
     4485                 assign
     4486                   temp_obj-list.obj-type = v-obj-type
     4487                   temp_obj-list.obj-code = v-obj-code
     4488                 .
     4489               end.
     4490             end.
     4491             assign
     4492               ed-object :screen-value in frame Dialog-Frame = v-obj-list
     4493             .
     4494           end.
     4495         end.
     4496       end.
     4497       assign
     4498         v-str = entry( 2 , v-list, ';')
     4499       .
     4500       if v-str = ''
     4501       then do:
     4502         assign
     4503           ed-doc-type = "Все":u
     4504         .
     4505       end.
     4506       else do:
     4507         assign
     4508           ed-doc-type = ''
     4509         .
     4510         for each temp_ext-doc-type
     4511         :
     4512           if lookup( temp_ext-doc-type.ext-doc-type, v-str ) <> 0
     4513           then do:
     4514             assign
     4515               ed-doc-type = ed-doc-type + temp_ext-doc-type.ext-doc-type-label + chr(10)
     4516               p-doc-type-list = p-doc-type-list + temp_ext-doc-type.ext-doc-type + ','
     4517             .
     4518           end.
     4519         end.
     4520         assign
     4521           p-doc-type-list = trim(p-doc-type-list , ',')
     4522         .
     4523       end.
     4524       display
     4525         ed-doc-type
     4526       with frame Dialog-Frame.
     4527     end.
     4528   end.
     4529   END PROCEDURE.
     4530   PROCEDURE flt-save :
     4531     define variable v-obj-range      as integer   no-undo .
     4532     define variable v-obj-list       as character no-undo .
     4533     define variable v-doc-range      as integer   no-undo .
     4534     define variable v-doc-list       as character no-undo .
     4535     define variable v-userid         as character no-undo .
     4536     define variable v-naim           as character no-undo .
     4537     define variable v-list           as character no-undo .
     4538     define variable v-print-graft    as logical   no-undo .
     4539     define variable v-sort-gr        as logical   no-undo .
     4540     define variable v-type-price     as logical   no-undo .
     4541     define variable v-type-val       as logical   no-undo .
     4542   do
     4543   on error undo, return error return-value
     4544   :
     4545     assign frame Dialog-Frame
     4546       date_from
     4547       date_to
     4548       tb-chk-pay-code
     4549       tb-cst-code
     4550       tb-deleted
     4551       tb-exp-checks
     4552       tb-exp-doc-rvs
     4553       tb-inkass-pay-code
     4554       tb-parts
     4555       tb-pay-desk
     4556       tb-pay-desk-cards
     4557       tb-supp
     4558       rs-1
     4559     .
     4560     case rs-1 :screen-value
     4561     :
     4562     when "1"
     4563     then do:
     4564         assign
     4565             v-obj-range = 1
     4566             v-obj-list = ""
     4567         .
     4568     end.
     4569     when "2"
     4570     then do:
     4571         assign
     4572             v-obj-range = 2
     4573             v-obj-list = ""
     4574         .
     4575     end.
     4576     when "3"
     4577     then do:
     4578         assign
     4579             v-obj-range = 3
     4580         .
     4581         assign
     4582             v-obj-list = ""
     4583         .
     4584         for each temp_obj-list
     4585         :
     4586             assign
     4587                 v-obj-list = v-obj-list
     4588                         + ( if v-obj-list = "" then "" else "," ) + temp_obj-list.obj-type
     4589                         + "," + string( temp_obj-list.obj-code )
     4590             .
     4591         end.
     4592     end.
     4593     end case.
     4594     assign
     4595       v-naim       = string(date_from         ) + "," +
     4596                      string(date_to           ) + "," +
     4597                      string(tb-chk-pay-code   ) + "," +
     4598                      string(tb-cst-code       ) + "," +
     4599                      string(tb-deleted        ) + "," +
     4600                      string(tb-exp-checks     ) + "," +
     4601                      string(tb-inkass-pay-code) + "," +
     4602                      string(tb-parts          ) + "," +
     4603                      string(tb-pay-desk       ) + "," +
     4604                      string(tb-pay-desk-cards ) + "," +
     4605                      string(tb-supp           ) + "," +
     4606                      string(tb-exp-doc-rvs    )
     4607       v-list       = substitute( "&1:&2;&3"
     4608                                , v-obj-range
     4609                                , v-obj-list
     4610                                , p-doc-type-list
     4611                                )
     4612     .
     4613     run uf-set ( input 'bge-dper.w':U
     4614                , input v-cntxt-userid
     4615                , input v-list
     4616                , input v-naim
     4617                , input v-print-graft
     4618                , input v-sort-gr
     4619                , input v-type-price
     4620                , input v-type-val
     4621                ) .
     4622   end.
     4623   END PROCEDURE.
     4624   PROCEDURE get-host-name :
     4625   do
     4626   on error undo, return error
     4627   :
     4628   define output parameter p-host-name as character    no-undo.
     4629   define buffer buf_clients   for ub.clients.
     4630       find first buf_clients no-lock
     4631            where buf_clients.obj-type = 'орг':U
     4632              and buf_clients.obj-code = v-bge-dper-host-code
     4633       no-error.
     4634       if not available buf_clients
     4635       then do:
     4636           message
     4637             vss-workfile vss-revision vss-description
     4638             skip "Не удалось найти текущую фирму"
     4639             skip return-value
     4640             skip trim(error-status :get-message(1))
     4641                  trim(error-status :get-message(2))
     4642                  trim(error-status :get-message(3))
     4643                  trim(error-status :get-message(4))
     4644                  trim(error-status :get-message(5))
     4645           view-as alert-box error.
     4646           undo, return error .
     4647       end.
     4648       else do:
     4649           assign
     4650               p-host-name = buf_clients.obj-name
     4651           .
     4652       end.
     4653   end.
     4654   END PROCEDURE.
     4655   PROCEDURE init-fields :
     4656   do
     4657   on error undo, return error
     4658   :
     4659       define variable v-oper-num     as integer           no-undo.
     4660       run manage-tb-chk-pay-code in this-procedure.
     4661       assign
     4662           p-doc-type-list = p-init-doc-type-list
     4663       .
     4664       assign
     4665           rs-1 :screen-value in frame dialog-frame = "2"
     4666           ed-object :screen-value in frame Dialog-frame = 'орг':U + string( v-bge-dper-host-code ) + " " + v-host-name
     4667       .
     4668       assign
     4669           rs-1
     4670       .
     4671       if p-init-doc-type-list <> ?
     4672       and p-init-doc-type-list <> ''
     4673       then do:
     4674           for each temp_ext-doc-type
     4675           :
     4676               if lookup( temp_ext-doc-type.ext-doc-type, p-init-doc-type-list ) <> 0
     4677               then do:
     4678                   assign
     4679                       ed-doc-type :screen-value in frame Dialog-Frame = ed-doc-type :screen-value in frame Dialog-Frame
     4680                                                   + temp_ext-doc-type.ext-doc-type-label + chr(10)
     4681                   .
     4682               end.
     4683           end.
     4684       end.
     4685       assign
     4686         date_to = today
     4687       .
     4688       display
     4689         date_to
     4690       with frame Dialog-Frame.
     4691       run flt-load in this-procedure .
     4692   end.
     4693   END PROCEDURE.
     4694   PROCEDURE manage-tb-chk-pay-code :
     4695   do
     4696   on error undo, return error
     4697   :
     4698       if tb-chk-pay-code = yes
     4699       then do:
     4700           assign
     4701               tb-pay-desk :sensitive in frame Dialog-Frame = yes
     4702               tb-pay-desk-cards :sensitive in frame Dialog-Frame = yes
     4703           .
     4704       end.
     4705       else do:
     4706           assign
     4707               tb-pay-desk :sensitive in frame Dialog-Frame = no
     4708               tb-pay-desk-cards :sensitive in frame Dialog-Frame = no
     4709           .
     4710       end.
     4711   end.
     4712   END PROCEDURE.
     4713   PROCEDURE object-select :
     4714   do
     4715   on error undo, return error
     4716   :
     4717   case rs-1 :screen-value in frame Dialog-frame
     4718   :
     4719       when "1"
     4720       then do:
     4721           assign
     4722               ed-object :screen-value = ""
     4723           .
     4724       end.
     4725       when "2"
     4726       then do:
     4727           assign
     4728               ed-object :screen-value = v-host-name
     4729           .
     4730       end.
     4731       when "3"
     4732       then do:
     4733           for each temp_obj-list
     4734           :
     4735               delete temp_obj-list.
     4736           end.
     4737           create temp_obj-list.
     4738           assign
     4739               temp_obj-list.obj-type  = v-bge-dper-store-type
     4740               temp_obj-list.obj-code  = v-bge-dper-store-code
     4741               ed-object :screen-value = v-bge-dper-store-type + string( v-bge-dper-store-code )
     4742           .
     4743       end.
     4744   end case.
     4745   end.
     4746   END PROCEDURE.
