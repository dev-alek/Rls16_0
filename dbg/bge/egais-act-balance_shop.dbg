     1480   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1481   define new global shared variable g#trdcalib as handle no-undo.
     1482   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1483   define temp-table tt-act-header
     1484       field num           as character        label "№ акта"      format "X(30)"
     1485       field date_         as date             label "Дата акта"
     1486       field is-sent       as logical
     1487       field answer_       as character        label "Ответ"       format "X(1500)"
     1488       field type_         as character        label "Основание"   format "X(35)"
     1489       field RegID         as character        label "Рег. номер"  format "X(50)"
     1490       index pi as primary unique
     1491           num
     1492   .
     1493   define temp-table tt-gds-act
     1494       field num           as character                label "№ акта"
     1495       field position_     as integer                  label "№ пп"                    format ">>>9"
     1496       field gds-code      like ub.goods.gds-code      label "Код товара   "
     1497       field part-code     like ub.parts.part-code     label "Партия"
     1498       field doc-code      as character                label "№ накладной TH"
     1499       field doc-date      like ub.trn-doc.fact-date   label "Дата TH"
     1500       field alc-code      as character                label "Алкогольный код"         format "X(21)"
     1501       field gds-name      like ub.goods.gds-name      label "Наименование товара"     format "X(35)"
     1502       field qnty          as decimal                  label "Количество"
     1503       field egais-name    as character
     1504       index pi as primary unique
     1505           position_
     1506       index code
     1507           gds-code doc-code
     1508   .
     1509   define new shared temp-table tt-marks
     1510       field num                 as character            label "№ акта"
     1511       field gds-part-position_  as integer
     1512       field mark                as character            label "Марка"          format "X(100)"
     1513       field new_                as logical
     1514       field gds-code            like ub.goods.gds-code  LABEL "Код товара"
     1515       field gds-name            as character            LABEL "Наименование"   FORMAT "X(30)"
     1516       field alc-code            as character            LABEL "Алк. код"       FORMAT "X(20)"
     1517       field impor-full-name     as character            LABEL "Импортер"       FORMAT "X(130)"
     1518       field prod-full-name      as character            LABEL "Производитель"  FORMAT "X(130)"
     1519       field flag                as logical              label "T"
     1520       field reserv              as integer              label "R"
     1521       field parts               as character            label "Партия"         format "X(130)"
     1522       index pi as primary unique
     1523           mark
     1524   .
     1525   define buffer buf_tt-marks for tt-marks .
     1526   define new shared temp-table tt-exts
     1527       field ext-rec as recid
     1528       field gds-code as integer
     1529       index pi as primary unique
     1530           ext-rec gds-code
     1531   .
     1532   define variable select-list as longchar no-undo .
     1533   FUNCTION get-mark RETURNS CHARACTER
     1534   (buffer local-gds for tt-gds-act ):
     1535   if lookup (string (recid (local-gds)), select-list) > 0  then return "*".
     1536                                                              else return "".
     1537   end function.
     1538   define menu m-add
     1539       menu-item m-goods   label "товары по свободной зоне"
     1540       menu-item m-marks   label "по акцизным маркам"
     1541       menu-item m-file    label "из файла"
     1542       menu-item m-one-good label "один товар"
     1543   .
     1544   DEFINE BUTTON b-cancel AUTO-END-KEY
     1545        LABEL "Выход"
     1546        SIZE 15 BY 1.14
     1547        BGCOLOR 8 .
     1548   DEFINE BUTTON b-good
     1549        LABEL "Добавить"
     1550        SIZE 15 BY 1.14
     1551        BGCOLOR 8 .
     1552   DEFINE BUTTON b-alc-code
     1553        LABEL "Выбор алк. кода"
     1554        SIZE 20 BY 1.14 TOOLTIP "Выбрать алкогольный код"
     1555        BGCOLOR 8 .
     1556   DEFINE BUTTON b-del
     1557        LABEL "Удалить строку"
     1558        SIZE 15 BY 1.14 TOOLTIP "Удалить строку акта"
     1559        BGCOLOR 8 .
     1560   DEFINE BUTTON b-save
     1561        LABEL "Сохранить"
     1562        SIZE 15 BY 1.14 TOOLTIP "Сохранить в БД"
     1563        BGCOLOR 8 .
     1564   DEFINE BUTTON b-mark
     1565        LABEL "&*"
     1566        SIZE 3 BY 1.14 .
     1567   DEFINE BUTTON b-sel-all
     1568        LABEL "&+":L
     1569        SIZE 3 BY 1.14 TOOLTIP "Отметить все объекты".
     1570   DEFINE BUTTON b-unmark
     1571        LABEL "&-":L
     1572        SIZE 3 BY 1.14 TOOLTIP "Снять все отметки".
     1573   DEFINE QUERY br-gds-act FOR
     1574         tt-gds-act SCROLLING.
     1575   DEFINE BROWSE br-gds-act
     1576     QUERY br-gds-act  DISPLAY
     1577       get-mark(BUFFER tt-gds-act) COLUMN-LABEL "*"  FORMAT "X(1)":U
     1578       tt-gds-act.position_
     1579       tt-gds-act.doc-code
     1580       tt-gds-act.gds-code
     1581       tt-gds-act.alc-code
     1582       tt-gds-act.gds-name
     1583       tt-gds-act.qnty
     1584     ENABLE
     1585       tt-gds-act.qnty
     1586       WITH NO-ROW-MARKERS SEPARATORS SIZE 107 BY 20.2 FIT-LAST-COLUMN.
     1587   DEFINE FRAME Dialog-Frame
     1588       b-cancel at row 1.2 col 2
     1589       b-good at row 1.2 col 32
     1590       b-alc-code at row 1.2 col 47
     1591       b-del at row 1.2 col 67
     1592       b-save at row 1.2 col 17
     1593       tt-act-header.num at row 2.5 col 2 format "X(22)"
     1594       tt-act-header.date_ at row 2.5 col 34
     1595       tt-act-header.type_ at row 2.5 col 57
     1596           view-as combo-box inner-lines 7
     1597           list-items "Пересортица"
     1598           DROP-DOWN-LIST
     1599       b-mark AT ROW 4 COL 2
     1600       b-sel-all AT ROW 4 COL 5
     1601       b-unmark AT ROW 4 COL 8
     1602       br-gds-act at row 5.2 col 2
     1603        SPACE(0.5) SKIP(0.5)
     1604       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1605            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1606            TITLE "Акт постановки товаров на баланс в торговом зале" WIDGET-ID 100.
     1607   ASSIGN
     1608          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1609          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1610   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1611   DO:
     1612     APPLY "END-ERROR":U TO SELF.
     1613   END.
     1614   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1615   DO:
     1616     run proc-b-mark in this-procedure no-error.
     1617   END.
     1618   ON CHOOSE OF b-sel-all IN FRAME Dialog-Frame
     1619   DO:
     1620     assign select-list = "".
     1621     if not available tt-gds-act then return.
     1622     for each tt-gds-act no-lock :
     1623   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1624   define variable v-str-recid11 as character no-undo .
     1625   define variable v-num-entry11 as integer   no-undo .
     1626   assign
     1627     v-str-recid11 = trim( string( recid( tt-gds-act ) , "->>>>>>>>>>>9":U ) )
     1628     v-num-entry11 = lookup( v-str-recid11 , select-list )
     1629   .
     1630   if v-num-entry11 > 0 then do:
     1631     assign
     1632       entry( v-num-entry11, select-list ) = "":U
     1633       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1634     .
     1635   end.
     1636   else do:
     1637     assign
     1638       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid11
     1639     .
     1640   end.
     1641     end.
     1642     br-gds-act:refresh() in frame Dialog-Frame .
     1643   END.
     1644   ON CHOOSE OF b-unmark IN FRAME Dialog-Frame
     1645   DO:
     1646     if not available tt-gds-act then return.
     1647     select-list  = "".
     1648     br-gds-act:refresh() in frame Dialog-Frame .
     1649   END.
     1650   ON VALUE-CHANGED OF tt-act-header.type_ IN FRAME Dialog-Frame
     1651   DO:
     1652     assign tt-act-header.type_.
     1653     if tt-act-header.type_ = "Пересортица" then do :
     1654         message "Выберите соответствующий акт о списании" view-as alert-box.
     1655         run bge/egais-all-act-writeOff_shop.w (input parparentproc, input yes, output v-RegID ) .
     1656         if v-RegID = ? or v-RegID = "" then do :
     1657           tt-act-header.type_ = "Продукция полученная до 01.01.2016" .
     1658           display tt-act-header.type_  with frame Dialog-Frame.
     1659           message "Акт постановки на баланс с типом 'Пересортица' невозможно отправить без указания соответствующего акта о списании!" view-as alert-box.
     1660         end.
     1661     end.
     1662   END.
     1663   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     1664   DO:
     1665       if p-mode <> 'ПРОСМОТР':U then do :
     1666           message "Все несохранённые данные будут потеряны. Вы уверены, что хотите выйти?"
     1667           view-as alert-box question buttons yes-no update glog.
     1668           if not glog then return no-apply .
     1669       end.
     1670   END.
     1671   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1672   DO:
     1673       define variable v-tt-rec as recid.
     1674       if available tt-gds-act  AND select-list = ""
     1675       then
     1676       select-list = string( recid( tt-gds-act ) ) .
     1677       if not available tt-gds-act and select-list = "" then do :
     1678           message "Выберите строку" view-as alert-box .
     1679           return no-apply.
     1680       end.
     1681       else
     1682       do ii = 1 to num-entries (select-list) :
     1683         v-tt-rec = integer(entry(ii, select-list)) .
     1684         for first tt-gds-act exclusive-lock where recid(tt-gds-act) = v-tt-rec :
     1685           delete tt-gds-act .
     1686         end.
     1687       end.
     1688       nn = 0 .
     1689       for each tt-gds-act exclusive-lock :
     1690           nn = nn + 1 .
     1691           tt-gds-act.position_ = nn .
     1692       end.
     1693       select-list = "" .
     1694       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     1695   END.
     1696   ON "leave" of tt-act-header.num in FRAME Dialog-Frame
     1697   DO:
     1698       define variable prev-num as character no-undo .
     1699       prev-num = tt-act-header.num .
     1700       assign tt-act-header.num .
     1701       for each tt-gds-act exclusive-lock where tt-gds-act.num = prev-num :
     1702           assign tt-gds-act.num = tt-act-header.num .
     1703       end.
     1704   END.
     1705   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     1706   DO:
     1707       assign
     1708           tt-act-header.num
     1709           tt-act-header.date_
     1710           tt-act-header.type_
     1711       .
     1712       find first tt-gds-act no-error .
     1713       if not available tt-gds-act then do :
     1714           message "В акте нет строк. Сохранение невозможно" view-as alert-box .
     1715           return no-apply.
     1716       end.
     1717       run makeXML_v2 in this-procedure no-error.
     1718       if error-status:error then return return-value .
     1719       assign
     1720           v-clob-db-num = ?
     1721           v-int64-id = 0
     1722           v-info = tt-act-header.num + chr(4) + string(tt-act-header.date_) + chr(4)
     1723                  + string(tt-act-header.is-sent) + chr(4) + tt-act-header.answer_ + chr(4) + tt-act-header.type_
     1724       .
     1725       find first buf_clob-bind exclusive-lock where buf_clob-bind.uniq-key-rec = tt-act-header.num
     1726                                                 and buf_clob-bind.field-name_  = 'egais-ab_shop':U no-error .
     1727       if available buf_clob-bind then do :
     1728           if p-mode = 'ДОБАВЛЕНИЕ':U then do :
     1729               message "Акт с таким номером уже существует!" view-as alert-box .
     1730               return no-apply .
     1731           end.
     1732           assign
     1733               v-clob-db-num = buf_clob-bind.db-num
     1734               v-int64-id = buf_clob-bind.int64-id
     1735               v-part-num = buf_clob-bind.part-num
     1736           .
     1737           run gbl/file2clb.p ( input 'ИЗМЕНЕНИЕ':U
     1738                     ,input "add-new,yes"
     1739                     ,input ?
     1740                     ,input tt-act-header.num
     1741                     ,input 'egais-ab_shop':U
     1742                     ,input v-info
     1743                     ,input-output v-part-num
     1744                     ,input 'egais-ab_shop':U
     1745                     ,input-output v-clob-db-num
     1746                     ,input-output v-int64-id
     1747                     ,input search (v-file)
     1748                     ,input ''
     1749                     ) no-error .
     1750            if error-status:error then message return-value view-as alert-box.
     1751       end.
     1752       else do :
     1753           run gbl/file2clb.p ( input 'ДОБАВЛЕНИЕ':U
     1754                     ,input ",yes"
     1755                     ,input ?
     1756                     ,input tt-act-header.num
     1757                     ,input 'egais-ab_shop':U
     1758                     ,input v-info
     1759                     ,input-output v-part-num
     1760                     ,input 'egais-ab_shop':U
     1761                     ,input-output v-clob-db-num
     1762                     ,input-output v-int64-id
     1763                     ,input search (v-file)
     1764                     ,input ''
     1765                     ) no-error .
     1766       end.
     1767       message "Сохранение завершено" view-as alert-box.
     1768   END.
     1769   on choose of menu-item m-goods in menu m-add
     1770   DO:
     1771       run ref/gds-ref.p
     1772       ( parparentproc
     1773       ,'b-sel,b-mark,b-add'
     1774       ,?
     1775       ,?
     1776       ,'свободно':U
     1777       ,?
     1778       ,?
     1779       ,?
     1780       ,?
     1781       ,v-cntxt-obj-type
     1782       ,v-cntxt-obj-code
     1783       ,?
     1784       , output v-rid-list) no-error.
     1785       if v-rid-list = "" or v-rid-list = ?
     1786       then return no-apply.
     1787       output stream str-log to value("act-bal-shop_log.txt") append .
     1788       err-good = false .
     1789       _goods_ :
     1790       do jj = 1 to num-entries(v-rid-list) :
     1791           find buf_goods where recid (buf_goods) = integer(entry(jj, v-rid-list)) no-lock.
     1792           run gds-attr-value(
     1793             buf_goods.gds-code,
     1794             'alcohol-prod':U,
     1795             output par-alcohol,
     1796             output par-type
     1797           ).
     1798           if par-alcohol = "" or par-alcohol = "no" then
     1799           do :
     1800               put stream str-log unformatted
     1801                   string(today) + "   " + string(time, "hh:mm:ss") + " :  товар " + string(buf_goods.gds-code) + "  " + buf_goods.gds-name + "  не является алкогольной продукцией" skip.
     1802               err-good = true .
     1803               next _goods_ .
     1804           end.
     1805           run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     1806                                               ,input (buffer buf_goods:handle)
     1807                                               ,output v-gds-uniq-key-rec).
     1808           exts = 0 .
     1809           for each X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     1810                                          and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     1811                                          AND X_ext-classif.db-num = 0
     1812                                          and X_ext-classif.key#_one = buf_goods.gds-code
     1813                                          and X_ext-classif.key#_two = v-ext-sys
     1814                                          and X_ext-classif.key#_three = 0
     1815                                          and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     1816                                          and X_eXt-classif.charkey_two = ""
     1817                                          and X_eXt-classif.charkey_three = ""
     1818                                          and X_eXt-classif.nonunique = 0 :
     1819               find first tt-exts no-lock where tt-exts.ext-rec = recid(x_ext-classif)
     1820                                            and tt-exts.gds-code = buf_goods.gds-code no-error.
     1821               if not available tt-exts then do :
     1822                   create tt-exts .
     1823                   assign
     1824                       tt-exts.ext-rec = recid(x_ext-classif)
     1825                       tt-exts.gds-code = buf_goods.gds-code
     1826                   .
     1827               end.
     1828               exts = exts + 1 .
     1829           end.
     1830           if exts = 0 then do :
     1831               put stream str-log unformatted
     1832                   string(today) + "   " + string(time, "hh:mm:ss") + " :  товар " + string(buf_goods.gds-code) + "  " + buf_goods.gds-name + "  не синхронизирован с ЕГАИС" skip.
     1833               err-good = true .
     1834               next _goods_ .
     1835           end.
     1836           else do :
     1837               find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     1838                                                  and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     1839                                                  AND X_ext-classif.db-num = 0
     1840                                                  and X_ext-classif.key#_one = buf_goods.gds-code
     1841                                                  and X_ext-classif.key#_two = v-ext-sys
     1842                                                  and X_ext-classif.key#_three = 0
     1843                                                  and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     1844                                                  and X_eXt-classif.charkey_two = ""
     1845                                                  and X_eXt-classif.charkey_three = ""
     1846                                                  and X_eXt-classif.nonunique = 0
     1847                                                  .
     1848           end.
     1849           find first buf_parts no-lock where buf_parts.artic = buf_goods.artic
     1850                                       and buf_parts.prod-type = buf_goods.prod-type
     1851                                       and buf_parts.prod-code = buf_goods.prod-code
     1852                                       and buf_parts.obj-type = v-cntxt-obj-type
     1853                                       and buf_parts.obj-code = v-cntxt-obj-code
     1854                                       and buf_parts.out-code = 'free-zone':U no-error .
     1855           if not available buf_parts  then do :
     1856               put stream str-log unformatted
     1857                   string(today) + "   " + string(time, "hh:mm:ss") + " :  у товара " + string(buf_goods.gds-code) + "  " + buf_goods.gds-name + "  нет партий свободной зоны" skip.
     1858               err-good = true .
     1859               next _goods_ .
     1860           end.
     1861           _parts_ :
     1862           for each buf_parts no-lock where buf_parts.artic = buf_goods.artic
     1863                                       and buf_parts.prod-type = buf_goods.prod-type
     1864                                       and buf_parts.prod-code = buf_goods.prod-code
     1865                                       and buf_parts.obj-type = v-cntxt-obj-type
     1866                                       and buf_parts.obj-code = v-cntxt-obj-code
     1867                                       and buf_parts.out-code = 'free-zone':U ,
     1868           first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_parts.in-code :
     1869               if buf_parts.qnty <= 0 then next _parts_ .
     1870               assign nn = nn + 1 .
     1871               create tt-gds-act.
     1872               assign
     1873                   tt-gds-act.gds-code         = buf_goods.gds-code
     1874                   tt-gds-act.alc-code         = X_ext-classif.charkey_one
     1875                   tt-gds-act.gds-name         = buf_goods.gds-name
     1876                   tt-gds-act.doc-code         = buf_trn-doc.doc-code
     1877                   tt-gds-act.doc-date         = buf_trn-doc.fact-date
     1878                   tt-gds-act.num              = tt-act-header.num
     1879                   tt-gds-act.part-code        = buf_parts.part-code
     1880                   tt-gds-act.position_        = nn
     1881                   tt-gds-act.qnty             = buf_parts.qnty
     1882               .
     1883               find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     1884                                                      and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     1885                                                      and X_ext-classif-attr.db-num = X_ext-classif.db-num
     1886                                                      and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     1887                                                      and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     1888                                                      and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     1889                                                      and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     1890                                                      and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     1891                                                      and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     1892                                                      and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     1893                                                      and X_ext-classif-attr.attr-code = 'egais-info'
     1894                                                      no-error .
     1895               if available X_ext-classif-attr then assign tt-gds-act.egais-name = entry(3, X_ext-classif-attr.attr-value, CHR(4)) no-error.
     1896           end.
     1897       end.
     1898       output stream str-log close .
     1899       if err-good then do :
     1900           message "Не все выбранные товары добавлены в акт. Смотрите лог-файл act-bal-shop_log.txt в рабочей директории" view-as alert-box .
     1901       end.
     1902       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     1903   END.
     1904   on choose of menu-item m-marks in menu m-add
     1905   DO:
     1906       run bge/egais-ab-marks.w (parparentproc, tt-act-header.num, ?, "", 0, 'ИЗМЕНЕНИЕ':U, input-output table tt-marks) .
     1907       for each tt-marks exclusive-lock where tt-marks.gds-part-position_ = ? and tt-marks.num = tt-act-header.num :
     1908           find first tt-gds-act exclusive-lock where tt-gds-act.alc-code = tt-marks.alc-code no-error .
     1909           if not available tt-gds-act then do :
     1910               find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     1911                                                  and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     1912                                                  AND X_ext-classif.db-num = 0
     1913                                                  and X_ext-classif.key#_two = v-ext-sys
     1914                                                  and X_ext-classif.key#_three = 0
     1915                                                  and X_ext-classif.charkey_one = tt-marks.alc-code
     1916                                                  and X_eXt-classif.charkey_two = ""
     1917                                                  and X_eXt-classif.charkey_three = ""
     1918                                                  and X_eXt-classif.nonunique = 0
     1919                                                  .
     1920               find first buf_goods no-lock where buf_goods.gds-code = X_ext-classif.key#_one .
     1921               nn = nn + 1 .
     1922               create tt-gds-act .
     1923               assign
     1924                   tt-gds-act.gds-code         = buf_goods.gds-code
     1925                   tt-gds-act.alc-code         = X_ext-classif.charkey_one
     1926                   tt-gds-act.gds-name         = buf_goods.gds-name
     1927                   tt-gds-act.num              = tt-act-header.num
     1928                   tt-gds-act.position_        = nn
     1929               .
     1930               find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     1931                                                      and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     1932                                                      and X_ext-classif-attr.db-num = X_ext-classif.db-num
     1933                                                      and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     1934                                                      and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     1935                                                      and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     1936                                                      and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     1937                                                      and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     1938                                                      and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     1939                                                      and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     1940                                                      and X_ext-classif-attr.attr-code = 'egais-info'
     1941                                                      no-error .
     1942               if available X_ext-classif-attr then assign tt-gds-act.egais-name = entry(3, X_ext-classif-attr.attr-value, CHR(4)) no-error.
     1943           end.
     1944           if not can-find(buf_tt-marks where buf_tt-marks.mark = tt-marks.mark
     1945                                          and buf_tt-marks.gds-part-position_ <> ?)
     1946           then
     1947           assign
     1948               tt-marks.gds-part-position_ = tt-gds-act.position_
     1949               tt-gds-act.qnty             = tt-gds-act.qnty + 1
     1950           .
     1951       end.
     1952       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     1953       apply "value-changed" to br-gds-act IN FRAME Dialog-Frame .
     1954   END.
     1955   on choose of menu-item m-file in menu m-add
     1956   DO:
     1957       define variable ll_commit AS LOG    NO-UNDO INIT NO.
     1958       define variable v-init-dir as character no-undo .
     1959       DEFINE variable v_os-file   AS CHAR NO-UNDO INIT "".
     1960       define variable v-line as character no-undo .
     1961       define variable v-err AS LOG    NO-UNDO INIT NO.
     1962       define variable v-user-action    as character no-undo.
     1963       define variable v-printed        as logical   no-undo.
     1964       SYSTEM-DIALOG GET-FILE v_os-file
     1965           TITLE "Выберите файл для импорта"
     1966           FILTERS
     1967             " Текстовые файлы (*.csv) " "*.csv",
     1968             " Текстовые файлы (*.txt) " "*.txt",
     1969             " Все файлы (*.*) "                      "*.*"
     1970           INITIAL-DIR v-init-dir
     1971           must-exist
     1972           update ll_commit
     1973           default-extension "csv"
     1974           .
     1975       IF ll_commit <> YES THEN do:
     1976          RETURN NO-APPLY.
     1977       end.
     1978       IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
     1979           BELL.
     1980           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
     1981           RETURN NO-APPLY.
     1982       END.
     1983       input from value(v_os-file) .
     1984           repeat :
     1985               import unformatted v-line .
     1986               nn = nn + 1 .
     1987               create tt-gds-act .
     1988               assign
     1989                   tt-gds-act.alc-code         = entry(1, v-line, ";")
     1990                   tt-gds-act.num              = tt-act-header.num
     1991                   tt-gds-act.qnty             = integer(entry(2, v-line, ";"))
     1992                   tt-gds-act.position_        = nn
     1993               .
     1994               find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     1995                                                  and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     1996                                                  AND X_ext-classif.db-num = 0
     1997                                                  and X_ext-classif.key#_two = v-ext-sys
     1998                                                  and X_ext-classif.key#_three = 0
     1999                                                  and X_eXt-classif.charkey_one = tt-gds-act.alc-code
     2000                                                  and X_eXt-classif.charkey_two = ""
     2001                                                  and X_eXt-classif.charkey_three = ""
     2002                                                  and X_eXt-classif.nonunique = 0 no-error .
     2003               if available X_ext-classif
     2004               then do :
     2005                   assign tt-gds-act.gds-code = X_ext-classif.key#_one .
     2006                   find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     2007                                                          and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     2008                                                          and X_ext-classif-attr.db-num = X_ext-classif.db-num
     2009                                                          and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     2010                                                          and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     2011                                                          and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     2012                                                          and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     2013                                                          and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     2014                                                          and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     2015                                                          and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     2016                                                          and X_ext-classif-attr.attr-code = 'egais-info'
     2017                                                          no-error .
     2018                   if available X_ext-classif-attr then
     2019                   assign tt-gds-act.gds-name = entry(3, X_ext-classif-attr.attr-value, CHR(4)) no-error.
     2020               end.
     2021           end.
     2022       input close .
     2023       output to value("alccodes-imp_log.txt") .
     2024       for each tt-gds-act exclusive-lock where tt-gds-act.gds-code = 0 or tt-gds-act.gds-code = ? :
     2025           v-err = true .
     2026           put unformatted tt-gds-act.alc-code " - не найдено соответствие с товаром TH" skip .
     2027           delete tt-gds-act .
     2028       end.
     2029       output close .
     2030       if v-err then do :
     2031           message "Не все строки добавлены в акт!" view-as alert-box .
     2032           run gbl/prnfilen.w
     2033              (input  "Ошибки при добавлении товаров"
     2034              ,input  0
     2035              ,input  "alccodes-imp_log.txt"
     2036              ,input  7
     2037              ,output v-user-action
     2038              ,output v-printed
     2039              ).
     2040       end.
     2041       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2042   END.
     2043   on choose of menu-item m-one-good in menu m-add
     2044   DO:
     2045       run ref/gds-ref.p
     2046       ( parparentproc
     2047       ,'b-sel,b-add'
     2048       ,?
     2049       ,?
     2050       ,'все':U
     2051       ,?
     2052       ,?
     2053       ,?
     2054       ,?
     2055       ,v-cntxt-obj-type
     2056       ,v-cntxt-obj-code
     2057       ,?
     2058       , output v-rid-list) no-error.
     2059       if v-rid-list = "" or v-rid-list = ?
     2060       then return no-apply.
     2061       find buf_goods where recid (buf_goods) = integer(v-rid-list) no-lock.
     2062       run gds-attr-value(
     2063         buf_goods.gds-code,
     2064         'alcohol-prod':U,
     2065         output par-alcohol,
     2066         output par-type
     2067       ).
     2068       if par-alcohol = "" or par-alcohol = "no" then
     2069       do :
     2070           message "Выбранный товар не является алкогольной продукцией." view-as alert-box.
     2071           return no-apply .
     2072       end.
     2073       run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     2074                                           ,input (buffer buf_goods:handle)
     2075                                           ,output v-gds-uniq-key-rec).
     2076       exts = 0 .
     2077       for each X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2078                                          and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2079                                          AND X_ext-classif.db-num = 0
     2080                                          and X_ext-classif.key#_one = buf_goods.gds-code
     2081                                          and X_ext-classif.key#_two = v-ext-sys
     2082                                          and X_ext-classif.key#_three = 0
     2083                                          and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2084                                          and X_eXt-classif.charkey_two = ""
     2085                                          and X_eXt-classif.charkey_three = ""
     2086                                          and X_eXt-classif.nonunique = 0 :
     2087           find first tt-exts no-lock where tt-exts.ext-rec = recid(x_ext-classif)
     2088                                            and tt-exts.gds-code = buf_goods.gds-code no-error.
     2089           if not available tt-exts then do :
     2090               create tt-exts .
     2091               assign
     2092                   tt-exts.ext-rec = recid(X_ext-classif)
     2093                   tt-exts.gds-code = buf_goods.gds-code
     2094               .
     2095           end.
     2096           exts = exts + 1 .
     2097       end.
     2098       if exts = 0 then do :
     2099           message "Выбранный товар не синхронизирован с ЕГАИС. (Нет алкогольного кода)" view-as alert-box.
     2100           return no-apply.
     2101       end.
     2102       else if exts = 1 then do :
     2103           find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2104                                              and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2105                                              AND X_ext-classif.db-num = 0
     2106                                              and X_ext-classif.key#_one = buf_goods.gds-code
     2107                                              and X_ext-classif.key#_two = v-ext-sys
     2108                                              and X_ext-classif.key#_three = 0
     2109                                              and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2110                                              and X_eXt-classif.charkey_two = ""
     2111                                              and X_eXt-classif.charkey_three = ""
     2112                                              and X_eXt-classif.nonunique = 0
     2113                                              .
     2114       end.
     2115       else do :
     2116           run bge/egais-select-alc-code.w (input buf_goods.gds-code, output p-ext-rec) .
     2117           find first X_ext-classif no-lock where recid(X_ext-classif) = p-ext-rec no-error .
     2118           if not available X_ext-classif then return no-apply.
     2119       end.
     2120       nn = nn + 1 .
     2121       create tt-gds-act .
     2122       assign
     2123           tt-gds-act.gds-code         = buf_goods.gds-code
     2124           tt-gds-act.alc-code         = X_ext-classif.charkey_one
     2125           tt-gds-act.gds-name         = buf_goods.gds-name
     2126           tt-gds-act.num              = tt-act-header.num
     2127           tt-gds-act.position_        = nn
     2128       .
     2129       find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     2130                                              and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     2131                                              and X_ext-classif-attr.db-num = X_ext-classif.db-num
     2132                                              and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     2133                                              and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     2134                                              and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     2135                                              and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     2136                                              and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     2137                                              and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     2138                                              and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     2139                                              and X_ext-classif-attr.attr-code = 'egais-info'
     2140                                              no-error .
     2141       if available X_ext-classif-attr then assign tt-gds-act.egais-name = entry(3, X_ext-classif-attr.attr-value, CHR(4)) no-error.
     2142       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2143   END.
     2144   on choose of b-alc-code IN FRAME Dialog-Frame
     2145   do :
     2146       if not available tt-gds-act then return no-apply .
     2147       run bge/egais-select-alc-code.w (input tt-gds-act.gds-code, output p-ext-rec) .
     2148       find first X_ext-classif no-lock where recid(X_ext-classif) = p-ext-rec no-error .
     2149       if not available X_ext-classif then return no-apply.
     2150       assign tt-gds-act.alc-code = X_ext-classif.charkey_one .
     2151       find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     2152                                              and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     2153                                              and X_ext-classif-attr.db-num = X_ext-classif.db-num
     2154                                              and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     2155                                              and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     2156                                              and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     2157                                              and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     2158                                              and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     2159                                              and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     2160                                              and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     2161                                              and X_ext-classif-attr.attr-code = 'egais-info'
     2162                                              no-error .
     2163       if available X_ext-classif-attr then assign tt-gds-act.egais-name = entry(3, X_ext-classif-attr.attr-value, CHR(4)) no-error.
     2164       br-gds-act:refresh() .
     2165   end.
     2166   on row-display of br-gds-act in FRAME Dialog-Frame
     2167   DO :
     2168       exts = 0 .
     2169       for each tt-exts no-lock where tt-exts.gds-code = tt-gds-act.gds-code :
     2170           exts = exts + 1 .
     2171       end.
     2172       if exts > 1 then tt-gds-act.alc-code:bgcolor in browse br-gds-act = yellow_color .
     2173   end.
     2174   on value-changed of br-gds-act IN FRAME Dialog-Frame
     2175   DO :
     2176   if available tt-gds-act then do :
     2177       exts = 0 .
     2178       for each tt-exts no-lock where tt-exts.gds-code = tt-gds-act.gds-code :
     2179           exts = exts + 1 .
     2180       end.
     2181       if exts > 1
     2182       and not can-find(tt-marks where tt-marks.alc-code = tt-gds-act.alc-code)
     2183       then enable b-alc-code WITH FRAME Dialog-Frame.
     2184       else disable b-alc-code WITH FRAME Dialog-Frame.
     2185   end.
     2186   end.
     2187   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2188   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2189   MAIN-BLOCK:
     2190   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2191      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2192       assign
     2193           b-good:popup-menu in frame Dialog-Frame = menu m-add:handle
     2194           b-good:menu-mouse = 1
     2195           nn = 0
     2196           tt-act-header.type_:list-items = "Пересортица"
     2197       .
     2198       empty temp-table tt-exts .
     2199       if p-mode = 'ДОБАВЛЕНИЕ':U then do :
     2200           v-date = substitute ("&1&2&3", string (day (now), "99"), string (month (now), "99"),substring (string(year (now)), 3,2)).
     2201           create tt-act-header .
     2202           assign
     2203               tt-act-header.num = "ACOS-" + v-date + '-' + substring(v-cntxt-obj-type,1,1) + string(v-cntxt-obj-code) + '-' + string(int(TIME))
     2204               tt-act-header.date_ = TODAY
     2205               tt-act-header.is-sent = no
     2206               tt-act-header.type_ = "Пересортица"
     2207           .
     2208           display tt-act-header.num tt-act-header.date_ tt-act-header.type_ with frame Dialog-Frame.
     2209           enable  tt-act-header.date_ tt-act-header.type_ b-good with frame Dialog-Frame.
     2210       end.
     2211       if p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ПРОСМОТР':U then do :
     2212           find last buf_clob-bind where buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value
     2213                                     and buf_clob-bind.field-name_ = 'egais-ab_shop':U
     2214                                     and buf_clob-bind.part-num = 1  .
     2215           find first buf_clob-data no-lock where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     2216           copy-lob
     2217           from  object buf_clob-data.cdata
     2218           to  file 'temp.xml'
     2219           no-convert
     2220           no-error .
     2221           empty temp-table tt-marks no-error .
     2222           run parseXML in this-procedure .
     2223           display tt-act-header.num tt-act-header.date_ tt-act-header.type_ with frame Dialog-Frame.
     2224           if p-mode = 'ИЗМЕНЕНИЕ':U then enable  tt-act-header.type_ with frame Dialog-Frame.
     2225           if p-mode = 'ИЗМЕНЕНИЕ':U then
     2226           for each tt-gds-act no-lock :
     2227               nn = nn + 1 .
     2228               find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code no-error .
     2229               if not available buf_goods then do :
     2230                   message "По алкогольному коду " tt-gds-act.alc-code " не найден товар из TH. Вероятно, кто-то удалил связку." view-as alert-box.
     2231                   next.
     2232               end.
     2233               run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     2234                                               ,input (buffer buf_goods:handle)
     2235                                               ,output v-gds-uniq-key-rec).
     2236               for each X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2237                                              and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2238                                              AND X_ext-classif.db-num = 0
     2239                                              and X_ext-classif.key#_one = buf_goods.gds-code
     2240                                              and X_ext-classif.key#_two = v-ext-sys
     2241                                              and X_ext-classif.key#_three = 0
     2242                                              and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2243                                              and X_eXt-classif.charkey_two = ""
     2244                                              and X_eXt-classif.charkey_three = ""
     2245                                              and X_eXt-classif.nonunique = 0 :
     2246                   find first tt-exts no-lock where tt-exts.ext-rec = recid(x_ext-classif)
     2247                                            and tt-exts.gds-code = buf_goods.gds-code no-error.
     2248                   if not available tt-exts then do :
     2249                       create tt-exts .
     2250                       assign
     2251                           tt-exts.ext-rec = recid(X_ext-classif)
     2252                           tt-exts.gds-code = tt-gds-act.gds-code
     2253                       .
     2254                   end.
     2255               end.
     2256           end .
     2257           open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2258           if p-mode = 'ПРОСМОТР':U then disable b-good with frame Dialog-Frame.
     2259           else enable b-good with frame Dialog-Frame.
     2260       end.
     2261   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2262   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2263   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2264   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2265   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2266   define variable v-diasize-current-frame-height as decimal   no-undo .
     2267   define variable v-diasize-change-size          as logical   no-undo .
     2268   define variable v-diasize-resize-button        as handle    no-undo .
     2269   define variable v-diasize-wndmax               as logical   no-undo .
     2270   define variable v-diasize-wndstore             as logical   no-undo .
     2271   define variable v-diasize-proc-name            as character no-undo .
     2272   define variable v-diasize-browse-handle        as handle    no-undo .
     2273   define variable v-diasize-browse-number        as integer   no-undo .
     2274   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2275   define temp-table temp-diasize-handle no-undo
     2276     field handle-value  as handle
     2277     field save-position as decimal
     2278     index xpk is primary unique handle-value
     2279     .
     2280   define temp-table temp-browse-handle no-undo
     2281     field browse-type   as character
     2282     field browse-number as integer
     2283     field browse-handle as handle
     2284     field original-size as decimal
     2285     index xpk is primary unique browse-type browse-number
     2286     index xie browse-type browse-handle
     2287   .
     2288   procedure diasize_change-height :
     2289     define input  parameter p-change-value  as decimal   no-undo .
     2290     define input  parameter p-move-resize   as logical   no-undo .
     2291     define variable v-field-group-handle    as handle    no-undo .
     2292     define variable v-object-handle         as handle    no-undo .
     2293     define variable v-frame-height          as decimal   no-undo .
     2294     define variable v-frame-virtual-height  as decimal   no-undo .
     2295     define variable v-browse-height         as decimal   no-undo .
     2296     define variable v-window-height         as decimal   no-undo .
     2297     define variable v-window-virtual-height as decimal   no-undo .
     2298     define variable v-change-sign           as integer   no-undo .
     2299     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2300     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2301     if p-change-value > 0
     2302     then do:
     2303       if frame Dialog-Frame :height + p-change-value
     2304           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2305       then do:
     2306         assign
     2307           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2308                           - (frame Dialog-Frame :height-chars)
     2309         .
     2310         if p-change-value <= 0
     2311         then do:
     2312           run diasize_position-resize-button in this-procedure .
     2313           return .
     2314         end.
     2315       end.
     2316     end.
     2317     if p-change-value < 0
     2318     then do:
     2319       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2320       then do:
     2321         assign
     2322           p-change-value = v-diasize-orig-frame-height
     2323                          - (frame Dialog-Frame :height-chars)
     2324         .
     2325         if p-change-value >= 0
     2326         then do:
     2327           run diasize_position-resize-button in this-procedure .
     2328           return .
     2329         end.
     2330       end.
     2331     end.
     2332     if p-change-value >= 0
     2333     then do:
     2334       assign
     2335         v-change-sign = 1
     2336       .
     2337     end.
     2338     else do:
     2339       assign
     2340         v-change-sign = -1
     2341       .
     2342     end.
     2343     assign
     2344       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2345     .
     2346     if p-change-value = 0
     2347     then do:
     2348       run diasize_position-resize-button in this-procedure .
     2349       return .
     2350     end.
     2351     move_block:
     2352     do
     2353     on error undo move_block, retry move_block
     2354     :
     2355       if retry
     2356       then do:
     2357         do
     2358         on error undo move_block, leave move_block
     2359         :
     2360           if p-change-value > 0
     2361           then do:
     2362             for each buf_temp-diasize-handle
     2363             on error undo, next
     2364             :
     2365               assign
     2366                 v-object-handle = buf_temp-diasize-handle.handle-value
     2367               .
     2368               if v-object-handle <> v-diasize-resize-button
     2369               then do:
     2370                 assign
     2371                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2372                 .
     2373               end.
     2374             end.
     2375             assign
     2376               v-diasize-browse-handle :height = v-browse-height
     2377             .
     2378             for each buf_temp-browse-handle
     2379               where buf_temp-browse-handle.browse-type = 'height':u
     2380             on error undo, next
     2381             :
     2382               assign
     2383                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2384               .
     2385             end.
     2386             assign
     2387               frame Dialog-Frame :height = v-frame-height
     2388             .
     2389             if frame Dialog-Frame :scrollable = true
     2390             then do:
     2391               assign
     2392                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2393               .
     2394             end.
     2395             run diasize_position-resize-button in this-procedure .
     2396           end.
     2397           else do:
     2398             if frame Dialog-Frame :scrollable = true
     2399             then do:
     2400               assign
     2401                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2402               .
     2403             end.
     2404             assign
     2405               frame Dialog-Frame :height = v-frame-height
     2406             .
     2407             assign
     2408               v-diasize-browse-handle :height = v-browse-height
     2409             .
     2410             for each buf_temp-browse-handle
     2411               where buf_temp-browse-handle.browse-type = 'height':u
     2412             on error undo, next
     2413             :
     2414               assign
     2415                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2416               .
     2417             end.
     2418             for each buf_temp-diasize-handle
     2419             on error undo, next
     2420             :
     2421               assign
     2422                 v-object-handle = buf_temp-diasize-handle.handle-value
     2423               .
     2424               if v-object-handle <> v-diasize-resize-button
     2425               then do:
     2426                 assign
     2427                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2428                 .
     2429               end.
     2430             end.
     2431             run diasize_position-resize-button in this-procedure .
     2432           end.
     2433           assign
     2434             v-diasize-change-size = false
     2435           .
     2436           leave move_block .
     2437         end.
     2438       end.
     2439       assign
     2440         v-diasize-need-full-display = true
     2441       .
     2442       if v-diasize-change-size = false
     2443       then do:
     2444         assign
     2445           v-diasize-change-size = true
     2446         .
     2447       end.
     2448       else do:
     2449         return .
     2450       end.
     2451       assign
     2452         v-frame-height = frame Dialog-Frame :height
     2453         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2454         v-browse-height = v-diasize-browse-handle :height
     2455       .
     2456       for each buf_temp-browse-handle
     2457         where buf_temp-browse-handle.browse-type = 'height':u
     2458       :
     2459         assign
     2460           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2461         .
     2462       end.
     2463       for each buf_temp-diasize-handle
     2464       :
     2465         delete buf_temp-diasize-handle .
     2466       end.
     2467       assign
     2468         v-field-group-handle = frame Dialog-Frame :first-child
     2469       .
     2470       do while valid-handle(v-field-group-handle)
     2471       :
     2472         assign
     2473           v-object-handle = v-field-group-handle :first-child
     2474         .
     2475         do while valid-handle(v-object-handle)
     2476         :
     2477           if  v-object-handle <> v-diasize-browse-handle :handle
     2478           and can-query(v-object-handle, "row")
     2479           and can-query(v-object-handle, "height")
     2480           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2481           then do:
     2482             find first buf_temp-browse-handle
     2483               where buf_temp-browse-handle.browse-type   = 'height':u
     2484                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2485               no-error .
     2486             if available buf_temp-browse-handle
     2487             then do:
     2488             end.
     2489             else do:
     2490               create buf_temp-diasize-handle .
     2491               assign
     2492                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2493                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2494               .
     2495             end.
     2496           end.
     2497           assign
     2498             v-object-handle = v-object-handle :next-sibling
     2499           .
     2500         end.
     2501         assign
     2502           v-field-group-handle = v-field-group-handle :next-sibling
     2503         .
     2504       end.
     2505       do with frame Dialog-Frame
     2506       :
     2507         hide v-diasize-resize-button .
     2508         assign
     2509           v-diasize-resize-button :row    = 1
     2510           v-diasize-resize-button :column = 1
     2511         .
     2512       end.
     2513       if p-change-value > 0
     2514       then do:
     2515         if frame Dialog-Frame :scrollable = true
     2516         then do:
     2517           assign
     2518             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2519             no-error .
     2520           if error-status :error
     2521           or error-status :get-message(1) <> ""
     2522           then do:
     2523             undo move_block, retry move_block .
     2524           end.
     2525         end.
     2526         assign
     2527           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2528           no-error .
     2529         if error-status :error
     2530         or error-status :get-message(1) <> ""
     2531         then do:
     2532           undo move_block, retry move_block .
     2533         end.
     2534         assign
     2535           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2536           no-error .
     2537         if error-status :error
     2538         or error-status :get-message(1) <> ""
     2539         then do:
     2540           undo move_block, retry move_block .
     2541         end.
     2542         for each buf_temp-browse-handle
     2543           where buf_temp-browse-handle.browse-type = 'height':u
     2544         on error undo move_block, retry move_block
     2545         :
     2546           assign
     2547             buf_temp-browse-handle.browse-handle :height
     2548               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2549             no-error .
     2550           if error-status :error
     2551           or error-status :get-message(1) <> ""
     2552           then do:
     2553             undo move_block, retry move_block .
     2554           end.
     2555         end.
     2556         for each buf_temp-diasize-handle
     2557         on error undo move_block, retry move_block
     2558         :
     2559           assign
     2560             v-object-handle = buf_temp-diasize-handle.handle-value
     2561           .
     2562           if v-object-handle <> v-diasize-resize-button
     2563           then do:
     2564             assign
     2565               v-object-handle :row = v-object-handle :row + p-change-value
     2566               no-error .
     2567             if error-status :error
     2568             or error-status :get-message(1) <> ""
     2569             then do:
     2570               undo move_block, retry move_block .
     2571             end.
     2572           end.
     2573         end.
     2574       end.
     2575       else do:
     2576         for each buf_temp-diasize-handle
     2577         on error undo move_block, retry move_block
     2578         :
     2579           assign
     2580             v-object-handle = buf_temp-diasize-handle.handle-value
     2581           .
     2582           if v-object-handle <> v-diasize-resize-button
     2583           then do:
     2584             assign
     2585               v-object-handle :row = v-object-handle :row + p-change-value
     2586               no-error .
     2587             if error-status :error
     2588             or error-status :get-message(1) <> ""
     2589             then do:
     2590               undo move_block, retry move_block .
     2591             end.
     2592           end.
     2593         end.
     2594         assign
     2595           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2596           no-error .
     2597         if error-status :error
     2598         or error-status :get-message(1) <> ""
     2599         then do:
     2600           undo move_block, retry move_block .
     2601         end.
     2602         for each buf_temp-browse-handle
     2603           where buf_temp-browse-handle.browse-type = 'height':u
     2604         on error undo move_block, retry move_block
     2605         :
     2606           assign
     2607             buf_temp-browse-handle.browse-handle :height
     2608               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2609             no-error .
     2610           if error-status :error
     2611           or error-status :get-message(1) <> ""
     2612           then do:
     2613             undo move_block, retry move_block .
     2614           end.
     2615         end.
     2616         assign
     2617           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2618           no-error .
     2619         if error-status :error
     2620         or error-status :get-message(1) <> ""
     2621         then do:
     2622           undo move_block, retry move_block .
     2623         end.
     2624         if frame Dialog-Frame :scrollable = true
     2625         then do:
     2626           assign
     2627             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2628             no-error .
     2629           if error-status :error
     2630           or error-status :get-message(1) <> ""
     2631           then do:
     2632             undo move_block, retry move_block .
     2633           end.
     2634         end.
     2635       end.
     2636       if p-move-resize = true
     2637       then do:
     2638         run diasize_position-resize-button in this-procedure .
     2639       end.
     2640       if v-diasize-wndstore = true
     2641       then do:
     2642         if connected("ub") = true
     2643         then do:
     2644           define variable v-cntxt-db-num        as integer   no-undo .
     2645           define variable v-cntxt-userid        as character no-undo .
     2646           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2647                                             , OUTPUT v-cntxt-userid
     2648                                             ) .
     2649           run gbl/wndsizew.p
     2650             (input  v-cntxt-db-num
     2651             ,input  v-cntxt-userid
     2652             ,input  v-diasize-proc-name
     2653             ,input  'height':u
     2654             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2655             ) .
     2656         end.
     2657       end.
     2658     end.
     2659     assign
     2660       v-diasize-change-size = false
     2661     .
     2662   end procedure.
     2663   procedure diasize_set-height :
     2664     define input  parameter p-new-height  as decimal   no-undo .
     2665     define input  parameter p-move-resize as logical   no-undo .
     2666     do
     2667     on error undo, return error return-value
     2668     :
     2669       run diasize_change-height in this-procedure
     2670         (input  (p-new-height - frame Dialog-Frame :height)
     2671         ,input  p-move-resize
     2672         ) .
     2673     end.
     2674   end procedure.
     2675   procedure diasize_change-width :
     2676     define input  parameter p-change-value as decimal   no-undo .
     2677     define input  parameter p-move-resize  as logical   no-undo .
     2678     define variable v-field-group-handle   as handle    no-undo .
     2679     define variable v-object-handle        as handle    no-undo .
     2680     define variable v-frame-width          as decimal   no-undo .
     2681     define variable v-frame-virtual-width  as decimal   no-undo .
     2682     define variable v-browse-width         as decimal   no-undo .
     2683     define variable v-window-width         as decimal   no-undo .
     2684     define variable v-window-virtual-width as decimal   no-undo .
     2685     define variable v-change-sign          as integer   no-undo .
     2686     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2687     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2688     if p-change-value > 0
     2689     then do:
     2690       if frame Dialog-Frame :width + p-change-value >
     2691           session :width-chars
     2692       then do:
     2693         assign
     2694           p-change-value = session :width-chars - frame Dialog-Frame :width
     2695         .
     2696         if p-change-value <= 0
     2697         then do:
     2698           run diasize_position-resize-button in this-procedure .
     2699           return .
     2700         end.
     2701       end.
     2702     end.
     2703     if p-change-value < 0
     2704     then do:
     2705       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2706       then do:
     2707         assign
     2708           p-change-value = v-diasize-orig-frame-width
     2709                          - frame Dialog-Frame :width
     2710         .
     2711         if p-change-value >= 0
     2712         then do:
     2713           run diasize_position-resize-button in this-procedure .
     2714           return .
     2715         end.
     2716       end.
     2717     end.
     2718     if p-change-value >= 0
     2719     then do:
     2720       assign
     2721         v-change-sign = 1
     2722       .
     2723     end.
     2724     else do:
     2725       assign
     2726         v-change-sign = -1
     2727       .
     2728     end.
     2729     assign
     2730       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2731     .
     2732     if p-change-value = 0
     2733     then do:
     2734       run diasize_position-resize-button in this-procedure .
     2735       return .
     2736     end.
     2737     move_block:
     2738     do
     2739     on error undo move_block, leave move_block
     2740     :
     2741       if retry
     2742       then do:
     2743         do
     2744         on error undo move_block, leave move_block
     2745         :
     2746           if p-change-value > 0
     2747           then do:
     2748             for each buf_temp-diasize-handle
     2749             on error undo, next
     2750             :
     2751               assign
     2752                 v-object-handle = buf_temp-diasize-handle.handle-value
     2753               .
     2754               if v-object-handle <> v-diasize-resize-button
     2755               then do:
     2756                 assign
     2757                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2758                 .
     2759               end.
     2760             end.
     2761             assign
     2762               v-diasize-browse-handle :width = v-browse-width
     2763             .
     2764             for each buf_temp-browse-handle
     2765               where buf_temp-browse-handle.browse-type = 'width':u
     2766             on error undo, next
     2767             :
     2768               assign
     2769                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2770               .
     2771             end.
     2772             assign
     2773               frame Dialog-Frame :width = v-frame-width
     2774             .
     2775             if frame Dialog-Frame :scrollable = true
     2776             then do:
     2777               assign
     2778                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2779               .
     2780             end.
     2781             run diasize_position-resize-button in this-procedure .
     2782           end.
     2783           else do:
     2784             if frame Dialog-Frame :scrollable = true
     2785             then do:
     2786               assign
     2787                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2788               .
     2789             end.
     2790             assign
     2791               frame Dialog-Frame :width = v-frame-width
     2792             .
     2793             for each buf_temp-browse-handle
     2794               where buf_temp-browse-handle.browse-type = 'width':u
     2795             on error undo, next
     2796             :
     2797               assign
     2798                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2799               .
     2800             end.
     2801             assign
     2802               v-diasize-browse-handle :width = v-browse-width
     2803             .
     2804             for each buf_temp-diasize-handle
     2805             on error undo, next
     2806             :
     2807               assign
     2808                 v-object-handle = buf_temp-diasize-handle.handle-value
     2809               .
     2810               if v-object-handle <> v-diasize-resize-button
     2811               then do:
     2812                 assign
     2813                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2814                 .
     2815               end.
     2816             end.
     2817             run diasize_position-resize-button in this-procedure .
     2818           end.
     2819           assign
     2820             v-diasize-change-size = false
     2821           .
     2822           leave move_block .
     2823         end.
     2824       end.
     2825       assign
     2826         v-diasize-need-full-display = true
     2827       .
     2828       if v-diasize-change-size = false
     2829       then do:
     2830         assign
     2831           v-diasize-change-size = true
     2832         .
     2833       end.
     2834       else do:
     2835         return .
     2836       end.
     2837       assign
     2838         v-frame-width = frame Dialog-Frame :width
     2839         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2840         v-browse-width = v-diasize-browse-handle :width
     2841       .
     2842       for each buf_temp-browse-handle
     2843         where buf_temp-browse-handle.browse-type = 'width':u
     2844       :
     2845         assign
     2846           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2847         .
     2848       end.
     2849       for each buf_temp-diasize-handle
     2850       :
     2851         delete buf_temp-diasize-handle .
     2852       end.
     2853       assign
     2854         v-field-group-handle = frame Dialog-Frame :first-child
     2855       .
     2856       do while valid-handle(v-field-group-handle)
     2857       :
     2858         assign
     2859           v-object-handle = v-field-group-handle :first-child
     2860         .
     2861         do while valid-handle(v-object-handle)
     2862         :
     2863           if  v-object-handle <> v-diasize-browse-handle :handle
     2864           and v-object-handle <> v-diasize-resize-button
     2865           and can-query(v-object-handle, "row")
     2866           and can-query(v-object-handle, "height")
     2867           and ( v-object-handle :col + v-object-handle :width
     2868                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2869               )
     2870           then do:
     2871             find first buf_temp-browse-handle
     2872               where buf_temp-browse-handle.browse-type   = 'width':u
     2873                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2874               no-error .
     2875             if available buf_temp-browse-handle
     2876             then do:
     2877             end.
     2878             else do:
     2879               create buf_temp-diasize-handle .
     2880               assign
     2881                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2882                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2883               .
     2884             end.
     2885           end.
     2886           assign
     2887             v-object-handle = v-object-handle :next-sibling
     2888           .
     2889         end.
     2890         assign
     2891           v-field-group-handle = v-field-group-handle :next-sibling
     2892         .
     2893       end.
     2894       do with frame Dialog-Frame
     2895       :
     2896         hide v-diasize-resize-button .
     2897         v-diasize-resize-button :row = 1.
     2898         v-diasize-resize-button :column = 1.
     2899       end.
     2900       if p-change-value > 0
     2901       then do:
     2902         if frame Dialog-Frame :scrollable = true
     2903         then do:
     2904           assign
     2905             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2906             no-error .
     2907           if error-status :error
     2908           or error-status :get-message(1) <> ""
     2909           then do:
     2910             undo move_block, retry move_block.
     2911           end.
     2912         end.
     2913         assign
     2914           frame Dialog-Frame :width = v-frame-width + p-change-value
     2915           no-error .
     2916         if error-status :error
     2917         or error-status :get-message(1) <> ""
     2918         then do:
     2919           undo move_block, retry move_block.
     2920         end.
     2921         assign
     2922           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2923         no-error .
     2924         if error-status :error
     2925         or error-status :get-message(1) <> ""
     2926         then do:
     2927           undo move_block, retry move_block.
     2928         end.
     2929         for each buf_temp-browse-handle
     2930           where buf_temp-browse-handle.browse-type = 'width':u
     2931         on error undo move_block, retry move_block
     2932         :
     2933           assign
     2934             buf_temp-browse-handle.browse-handle :width
     2935               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2936             no-error .
     2937           if error-status :error
     2938           or error-status :get-message(1) <> ""
     2939           then do:
     2940             undo move_block, retry move_block .
     2941           end.
     2942         end.
     2943         for each buf_temp-diasize-handle
     2944         on error undo move_block, retry move_block
     2945         :
     2946           assign
     2947             v-object-handle = buf_temp-diasize-handle.handle-value
     2948           .
     2949           if v-object-handle <> v-diasize-resize-button
     2950           then do:
     2951             assign
     2952               v-object-handle :col = v-object-handle :col + p-change-value
     2953               no-error .
     2954             if error-status :error
     2955             or error-status :get-message(1) <> ""
     2956             then do:
     2957               undo move_block, retry move_block .
     2958             end.
     2959           end.
     2960         end.
     2961       end.
     2962       else do:
     2963         for each buf_temp-diasize-handle
     2964         on error undo move_block, retry move_block
     2965         :
     2966           assign
     2967             v-object-handle = buf_temp-diasize-handle.handle-value
     2968           .
     2969           if v-object-handle <> v-diasize-resize-button
     2970           then do:
     2971             assign
     2972               v-object-handle :col = v-object-handle :col + p-change-value
     2973               no-error .
     2974             if error-status :error
     2975             or error-status :get-message(1) <> ""
     2976             then do:
     2977               undo move_block, retry move_block .
     2978             end.
     2979           end.
     2980         end.
     2981         for each buf_temp-browse-handle
     2982           where buf_temp-browse-handle.browse-type = 'width':u
     2983         on error undo move_block, retry move_block
     2984         :
     2985           assign
     2986             buf_temp-browse-handle.browse-handle :width
     2987               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2988             no-error .
     2989           if error-status :error
     2990           or error-status :get-message(1) <> ""
     2991           then do:
     2992             undo move_block, retry move_block .
     2993           end.
     2994         end.
     2995         assign
     2996           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2997           no-error .
     2998         if error-status :error
     2999         or error-status :get-message(1) <> ""
     3000         then do:
     3001           undo move_block, retry move_block.
     3002         end.
     3003         assign
     3004           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3005         no-error .
     3006         if error-status :error
     3007         or error-status :get-message(1) <> ""
     3008         then do:
     3009           undo move_block, retry move_block.
     3010         end.
     3011         if frame Dialog-Frame :scrollable = true
     3012         then do:
     3013           assign
     3014             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3015           no-error .
     3016           if error-status :error
     3017           or error-status :get-message(1) <> ""
     3018           then do:
     3019             undo move_block, retry move_block.
     3020           end.
     3021         end.
     3022       end.
     3023       if p-move-resize
     3024       then do:
     3025         run diasize_position-resize-button in this-procedure .
     3026       end.
     3027       if v-diasize-wndstore = true
     3028       then do:
     3029         if connected("ub") = true
     3030         then do:
     3031           define variable v-cntxt-db-num        as integer   no-undo .
     3032           define variable v-cntxt-userid        as character no-undo .
     3033           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3034                                             , OUTPUT v-cntxt-userid
     3035                                             ) .
     3036           run gbl/wndsizew.p
     3037             (input  v-cntxt-db-num
     3038             ,input  v-cntxt-userid
     3039             ,input  v-diasize-proc-name
     3040             ,input  'width':u
     3041             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3042             ) .
     3043         end.
     3044       end.
     3045     end.
     3046     assign
     3047       v-diasize-change-size = false
     3048     .
     3049   end procedure.
     3050   procedure diasize_set-width :
     3051     define input  parameter p-new-width  as decimal   no-undo .
     3052     define input  parameter p-move-resize as logical   no-undo .
     3053     do
     3054     on error undo, return error return-value
     3055     :
     3056       run diasize_change-width in this-procedure
     3057         (input  (p-new-width - frame Dialog-Frame :width)
     3058         ,input  p-move-resize
     3059         ) .
     3060     end.
     3061   end procedure.
     3062   procedure diasize_position-resize-button :
     3063     do with frame Dialog-Frame
     3064     :
     3065       hide v-diasize-resize-button .
     3066       assign
     3067         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3068                     - 1
     3069                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3070         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3071                     - 1
     3072                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3073       .
     3074       view v-diasize-resize-button .
     3075     end.
     3076   end procedure.
     3077   on alt-right anywhere
     3078   do:
     3079     run diasize_change-width in this-procedure
     3080       (input 1
     3081       ,input true
     3082       ) .
     3083     return no-apply .
     3084   end.
     3085   on alt-left anywhere
     3086   do:
     3087     run diasize_change-width in this-procedure
     3088       (input -1
     3089       ,input true
     3090       ) .
     3091     return no-apply .
     3092   end.
     3093   on alt-down anywhere
     3094   do:
     3095     run diasize_change-height in this-procedure
     3096       (input 1
     3097       ,input true
     3098       ) .
     3099     return no-apply .
     3100   end.
     3101   on alt-up anywhere
     3102   do:
     3103     run diasize_change-height in this-procedure
     3104       (input -1
     3105       ,input true
     3106       ) .
     3107     return no-apply .
     3108   end.
     3109   on alt-enter of frame Dialog-Frame
     3110   do:
     3111     run diasize_maximize in this-procedure
     3112       (input  ?
     3113       ).
     3114     return no-apply .
     3115   end.
     3116   procedure diasize_end-move :
     3117     do
     3118     on error undo, return error return-value
     3119     :
     3120       define variable v-row-delta as decimal   no-undo .
     3121       define variable v-col-delta as decimal   no-undo .
     3122       define variable v-new-row as decimal   no-undo .
     3123       define variable v-new-col as decimal   no-undo .
     3124       assign
     3125         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3126         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3127       .
     3128       assign
     3129         v-row-delta = v-new-row - frame Dialog-Frame :height
     3130         v-col-delta = v-new-col - frame Dialog-Frame :width
     3131       .
     3132       run diasize_change-height in this-procedure
     3133         (input v-row-delta
     3134         ,input true
     3135         ) .
     3136       run diasize_change-width in this-procedure
     3137         (input v-col-delta
     3138         ,input true
     3139         ) .
     3140     end.
     3141   end procedure.
     3142   procedure diasize_maximize :
     3143     define input  parameter p-action as logical   no-undo .
     3144     do
     3145     on error undo, return error return-value
     3146     :
     3147       if p-action = ?
     3148       then do:
     3149         if v-diasize-need-maximize = true
     3150         then do:
     3151           assign
     3152             p-action = true
     3153           .
     3154         end.
     3155         else do:
     3156           assign
     3157             p-action = false
     3158           .
     3159         end.
     3160       end.
     3161       if p-action = true
     3162       then do:
     3163         run diasize_change-height in this-procedure
     3164           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3165               - frame Dialog-Frame :height-chars
     3166           ,input true
     3167           ) .
     3168         run diasize_change-width in this-procedure
     3169           (input session :width-chars
     3170               - frame Dialog-Frame :width-chars
     3171           ,input true
     3172           ) .
     3173         assign
     3174           v-diasize-need-maximize = false
     3175         .
     3176       end.
     3177       else do:
     3178         run diasize_change-width in this-procedure
     3179           (input v-diasize-orig-frame-width
     3180               - frame Dialog-Frame :width-chars
     3181           ,input true
     3182           ) .
     3183         run diasize_change-height in this-procedure
     3184           (input v-diasize-orig-frame-height
     3185               - frame Dialog-Frame :height-chars
     3186           ,input true
     3187           ) .
     3188         assign
     3189           v-diasize-need-maximize = true
     3190         .
     3191       end.
     3192     end.
     3193   end procedure.
     3194   procedure diasize_restore-orig-size :
     3195     do
     3196     on error undo, return error return-value
     3197     :
     3198       assign
     3199         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3200         v-diasize-current-frame-height = frame Dialog-Frame :height
     3201       .
     3202       run diasize_set-height in this-procedure
     3203         (input  v-diasize-orig-frame-height
     3204         ,input  true
     3205         ) .
     3206       run diasize_set-width in this-procedure
     3207         (input  v-diasize-orig-frame-width
     3208         ,input  true
     3209         ) .
     3210     end.
     3211   end procedure.
     3212   procedure diasize_restore-current-size :
     3213     do
     3214     on error undo, return error return-value
     3215     :
     3216       run diasize_set-height in this-procedure
     3217         (input  v-diasize-current-frame-height
     3218         ,input  true
     3219         ) .
     3220       run diasize_set-width in this-procedure
     3221         (input  v-diasize-current-frame-width
     3222         ,input  true
     3223         ) .
     3224     end.
     3225   end procedure.
     3226   procedure diasize_set-browse-handle :
     3227     define input  parameter p-browse-handle as handle   no-undo .
     3228     define buffer buf_temp-browse-handle for temp-browse-handle .
     3229     do
     3230     on error undo, return error return-value
     3231     :
     3232       assign
     3233         v-diasize-browse-handle = p-browse-handle
     3234       .
     3235       for each buf_temp-browse-handle
     3236       on error undo, return error return-value
     3237       :
     3238         delete buf_temp-browse-handle .
     3239       end.
     3240     end.
     3241   end procedure.
     3242   procedure diasize_add_browse :
     3243     define input  parameter p-browse-type   as character no-undo .
     3244     define input  parameter p-browse-handle as handle    no-undo .
     3245     define buffer buf_temp-browse-handle for temp-browse-handle .
     3246     do
     3247     on error undo, return error return-value
     3248     :
     3249       assign
     3250         v-diasize-browse-number = v-diasize-browse-number + 1
     3251       .
     3252       create buf_temp-browse-handle .
     3253       assign
     3254         buf_temp-browse-handle.browse-type   = p-browse-type
     3255         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3256         buf_temp-browse-handle.browse-handle = p-browse-handle
     3257       .
     3258     end.
     3259   end procedure.
     3260   procedure diasize_init :
     3261     define variable v-default-value    as logical   no-undo .
     3262     define variable v-restore-saved    as logical   no-undo .
     3263     define variable v-resize-value-str as character no-undo .
     3264     do
     3265     on error undo, return error return-value
     3266     :
     3267       do with frame Dialog-Frame
     3268       :
     3269         assign
     3270           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3271           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3272           v-diasize-browse-handle     = browse br-gds-act :handle
     3273         .
     3274         create button v-diasize-resize-button
     3275         assign
     3276           parent        = frame Dialog-Frame :first-child
     3277           label         = "s"
     3278           height-pixels = 16
     3279           width-pixels  = 16
     3280           visible       = true
     3281           sensitive     = true
     3282           movable       = true
     3283           triggers:
     3284             on end-move persistent run diasize_end-move in this-procedure .
     3285           end triggers.
     3286         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3287         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3288         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3289         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3290         assign
     3291           v-diasize-wndmax = false
     3292         .
     3293         if connected("ub") = true
     3294         then do:
     3295           define variable v-cntxt-db-num        as integer   no-undo .
     3296           define variable v-cntxt-userid        as character no-undo .
     3297           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3298                                             , OUTPUT v-cntxt-userid
     3299                                             ) .
     3300           run gbl/wndpar_r.p
     3301             (input  v-cntxt-db-num
     3302             ,input  v-cntxt-userid
     3303             ,input  'wndmax':U
     3304             ,output v-diasize-wndmax
     3305             ,output v-default-value
     3306             ) .
     3307         end.
     3308         assign
     3309           v-diasize-wndstore = false
     3310         .
     3311         if connected("ub") = true
     3312         then do:
     3313           run gbl/wndpar_r.p
     3314             (input  v-cntxt-db-num
     3315             ,input  v-cntxt-userid
     3316             ,input  'wndstore':U
     3317             ,output v-diasize-wndstore
     3318             ,output v-default-value
     3319             ) .
     3320         end.
     3321         assign
     3322           v-diasize-proc-name = entry(1, program-name(2), '.')
     3323         .
     3324         if v-diasize-wndstore = true
     3325         then do:
     3326           assign
     3327             v-restore-saved = false
     3328           .
     3329           if connected("ub") = true
     3330           then do:
     3331             run gbl/wndsizer.p
     3332               (input  v-cntxt-db-num
     3333               ,input  v-cntxt-userid
     3334               ,input  v-diasize-proc-name
     3335               ,input  'height':u
     3336               ,output v-resize-value-str
     3337               ) .
     3338             if v-resize-value-str <> '':U
     3339             then do:
     3340               run diasize_change-height in this-procedure
     3341                 (input  integer(v-resize-value-str)
     3342                 ,input  true
     3343                 ) .
     3344               assign
     3345                 v-restore-saved = true
     3346               .
     3347             end.
     3348           end.
     3349           if connected("ub") = true
     3350           then do:
     3351             run gbl/wndsizer.p
     3352               (input  v-cntxt-db-num
     3353               ,input  v-cntxt-userid
     3354               ,input  v-diasize-proc-name
     3355               ,input  'width':u
     3356               ,output v-resize-value-str
     3357               ) .
     3358             if v-resize-value-str <> '':U
     3359             then do:
     3360               run diasize_change-width in this-procedure
     3361                 (input  integer(v-resize-value-str)
     3362                 ,input  true
     3363                 ) .
     3364               assign
     3365                 v-restore-saved = true
     3366               .
     3367             end.
     3368           end.
     3369           if v-restore-saved <> true
     3370           then do:
     3371             if v-diasize-wndmax = true
     3372             then do:
     3373               run diasize_maximize in this-procedure
     3374                 (input  true
     3375                 ) .
     3376             end.
     3377           end.
     3378         end.
     3379         else do:
     3380           if v-diasize-wndmax = true
     3381           then do:
     3382             run diasize_maximize in this-procedure
     3383               (input  true
     3384               ) .
     3385           end.
     3386         end.
     3387       end.
     3388     end.
     3389   end procedure.
     3390   procedure diasize_need-full-display :
     3391     define output parameter p-need-full-display as logical   no-undo .
     3392     do
     3393     on error undo, return error return-value
     3394     :
     3395       assign
     3396         p-need-full-display = v-diasize-need-full-display
     3397       .
     3398       assign
     3399         v-diasize-need-full-display = false
     3400       .
     3401     end.
     3402   end procedure.
     3403   procedure get-context :
     3404      define output parameter p-db-num as integer          no-undo.
     3405      define output parameter p-user-id as character        no-undo.
     3406      define variable v-login               as character    no-undo.
     3407      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3408      define buffer buf_user-login  for ub.user-login .
     3409      do
     3410      on error undo, return error
     3411      :
     3412            FIND FIRST buf_sys-ctrl no-lock.
     3413            ASSIGN
     3414               v-login = USERID("ub")
     3415               p-db-num = buf_sys-ctrl.db-num
     3416            .
     3417            FIND FIRST buf_user-login
     3418                 WHERE buf_user-login.db-num = p-db-num
     3419                   AND buf_user-login.user-login = v-login
     3420                 no-lock
     3421                 no-error
     3422                 .
     3423            IF AVAILABLE buf_user-login
     3424            THEN DO:
     3425               assign
     3426                  p-user-id = buf_user-login.user-id
     3427               .
     3428            END.
     3429      end.
     3430   end procedure.
     3431       run diasize_init in this-procedure .
     3432       RUN enable_UI.
     3433       WAIT-FOR GO OF FRAME Dialog-Frame.
     3434   END.
     3435   RUN disable_UI.
     3436   procedure makeXML_v2 :
     3437       create sax-writer sw .
     3438       sw:formatted = true.
     3439       sw:set-output-destination ("file", v-file).
     3440       sw:encoding = "UTF-8".
     3441       sw:start-document () .
     3442       sw:start-element ("ns:Documents") .
     3443       sw:insert-attribute ("Version", "2.0") .
     3444       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
     3445       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
     3446       sw:insert-attribute ("xmlns:oref", "http://fsrar.ru/WEGAIS/ClientRef_v2") .
     3447       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef_v2") .
     3448       sw:insert-attribute ("xmlns:ainp", "http://fsrar.ru/WEGAIS/ActChargeOnShop_v2") .
     3449       sw:insert-attribute ("xmlns:ce", "http://fsrar.ru/WEGAIS/CommonEnum") .
     3450           sw:start-element ("ns:Owner") .
     3451               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
     3452           sw:end-element ("ns:Owner") .
     3453           sw:start-element ("ns:Document") .
     3454               sw:start-element ("ns:ActChargeOnShop_v2") .
     3455                   sw:write-data-element ("ainp:Identity", tt-act-header.num) .
     3456                   sw:start-element ("ainp:Header") .
     3457                       sw:write-data-element ("ainp:Number", tt-act-header.num) .
     3458                       sw:write-data-element ("ainp:ActDate", string(iso-date(tt-act-header.date_))) no-error .
     3459                       sw:write-data-element ("ainp:Note", "Необходимо поставить товарные позиции на баланс") .
     3460                       if tt-act-header.type_ <> "Продукция полученная до 01.01.2016"
     3461                       then
     3462                         sw:write-data-element ("ainp:TypeChargeOn", tt-act-header.type_) .
     3463                       else
     3464                         sw:write-data-element ("ainp:TypeChargeOn", "Продукция, полученная до 01.01.2016") .
     3465                       if tt-act-header.type_ = "Пересортица" and v-RegID <> "" and v-RegID <> ? then do :
     3466                         sw:write-data-element ("ainp:ActWriteOff", v-RegID) .
     3467                       end.
     3468                   sw:end-element ("ainp:Header") .
     3469                   sw:start-element ("ainp:Content") .
     3470       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
     3471           if tt-gds-act.qnty <= 0 then next.
     3472                       find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code .
     3473                       sw:start-element ("ainp:Position") .
     3474                           sw:write-data-element ("ainp:Identity", string(tt-gds-act.position_)) .
     3475                           sw:start-element ("ainp:Product") .
     3476                               sw:write-data-element ("pref:UnitType", (if buf_goods.unit-base <> buf_goods.unit-cli and buf_goods.cli-base-rate <> 1 then "Unpacked" else "Packed")) .
     3477                               sw:write-data-element ("pref:FullName", tt-gds-act.egais-name) no-error .
     3478                               sw:write-data-element ("pref:ShortName", "") .
     3479                               sw:write-data-element ("pref:AlcCode", tt-gds-act.alc-code) .
     3480                               if not (buf_goods.unit-base <> buf_goods.unit-cli and buf_goods.cli-base-rate <> 1)
     3481                               then sw:write-data-element ("pref:Capacity", string(buf_goods.ms-base)) .
     3482                               sw:write-data-element ("pref:AlcVolume", string(buf_goods.proof)) .
     3483                           for first ub.alc-type-gds where ub.alc-type-gds.gds-code = buf_goods.gds-code no-lock,
     3484                               first ub.alc-type where ub.alc-type.alc-type-inner-code = ub.alc-type-gds.alc-type-inner-code no-lock :
     3485                               sw:write-data-element ("pref:ProductVCode", string(ub.alc-type.alc-type-code)) .
     3486                           end.
     3487                           find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = 'goods':U
     3488                                                                  and X_ext-classif-attr.classif-name = 'exp-esys-gds-code':U
     3489                                                                  and X_ext-classif-attr.db-num = 0
     3490                                                                  and X_ext-classif-attr.Key#_One = tt-gds-act.gds-code
     3491                                                                  and X_ext-classif-attr.Key#_two = v-ext-sys
     3492                                                                  and X_ext-classif-attr.Key#_three = 0
     3493                                                                  and X_ext-classif-attr.CharKey_One = tt-gds-act.alc-code
     3494                                                                  and X_ext-classif-attr.CharKey_two = ""
     3495                                                                  and X_ext-classif-attr.CharKey_three = ""
     3496                                                                  and X_ext-classif-attr.nonunique = 0
     3497                                                                  and X_ext-classif-attr.attr-code = 'egais-info'
     3498                                                                  no-error .
     3499                           if available X_ext-classif-attr and num-entries(X_ext-classif-attr.attr-value, CHR(4)) >= 3 then do :
     3500                             def var v-prod as char no-undo.
     3501                             def var v-impor as char no-undo.
     3502                             def var v-msg as char no-undo.
     3503                             def var v-err as logical no-undo.
     3504                             def var v-err-impor as logical no-undo.
     3505                             v-err = false .
     3506                             v-prod = ''.
     3507                             v-impor = ''.
     3508                             v-prod = entry (1, X_ext-classif-attr.attr-value, chr(4)) no-error.
     3509                             if v-prod = ?
     3510                             or v-prod = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
     3511                             or v-prod = ""
     3512                             or num-entries (v-prod, chr (5)) < 8
     3513                             or entry (7, v-prod, chr(5)) = ""
     3514                             then do:
     3515                               message "У товара неизвестен производитель (или его тип) из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров во второй версии XSD и  заново сохраните акт." view-as alert-box.
     3516                               v-err = true .
     3517                             end.
     3518                             if not v-err then do :
     3519                               sw:start-element ("pref:Producer") .
     3520                                sw:start-element ("oref:" + entry (7, v-prod, chr(5))) .
     3521                                 if entry (7, v-prod, chr(5)) <> "TS" then do :
     3522                                     if entry (2, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:INN", entry (2, v-prod, chr(5)) ).
     3523                                     if entry (3, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:KPP", entry (3, v-prod, chr(5)) ).
     3524                                 end.
     3525                                 else if entry (2, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:TSNUM", entry (2, v-prod, chr(5)) ).
     3526                                 sw:write-data-element ("oref:ClientRegId", entry (1, v-prod, chr(5)) ).
     3527                                 sw:write-data-element ("oref:FullName", entry (4, v-prod, chr(5)) ).
     3528                                 sw:start-element ("oref:address").
     3529                                   sw:write-data-element ("oref:Country", entry (5, v-prod, chr(5)) ).
     3530                                   if entry (8, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:RegionCode", entry (8, v-prod, chr(5)) ).
     3531                                   sw:write-data-element ("oref:description", entry (6, v-prod, chr(5)) ).
     3532                                 sw:end-element ("oref:address").
     3533                                sw:end-element ("oref:" + entry (7, v-prod, chr(5))) .
     3534                               sw:end-element ("pref:Producer") .
     3535                             end.
     3536                           end.
     3537                           else do:
     3538                             message "У товара неизвестен производитель из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров и  заново сохраните акт." view-as alert-box.
     3539                           end.
     3540                           sw:end-element ("ainp:Product") .
     3541                           sw:write-data-element ("ainp:Quantity", string(tt-gds-act.qnty)) .
     3542                       sw:end-element ("ainp:Position") .
     3543       end.
     3544                   sw:end-element ("ainp:Content") .
     3545               sw:end-element ("ns:ActChargeOnShop_v2") .
     3546           sw:end-element ("ns:Document") .
     3547       sw:end-element ("ns:Documents") .
     3548       sw:end-document () .
     3549       delete object sw.
     3550   end procedure .
     3551   procedure parseXML :
     3552       empty temp-table tt-act-header .
     3553       empty temp-table tt-gds-act .
     3554       CREATE X-DOCUMENT hDoc.
     3555       CREATE X-NODEREF hRoot.
     3556       hDoc:encoding = 'utf-8'.
     3557       hDoc:LOAD("file", search("temp.xml"),FALSE).
     3558       hDoc:GET-DOCUMENT-ELEMENT(hRoot).
     3559       RUN GetChildren(hRoot, 1).
     3560       DELETE OBJECT hDoc.
     3561       DELETE OBJECT hRoot.
     3562   end procedure .
     3563   procedure GetChildren :
     3564       DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
     3565       DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
     3566       DEFINE VARIABLE i AS INTEGER NO-UNDO.
     3567       DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
     3568       DEFINE VARIABLE hText AS HANDLE NO-UNDO.
     3569       CREATE X-NODEREF hNoderef.
     3570       CREATE X-NODEREF hText .
     3571       REPEAT i = 1 TO hParent:NUM-CHILDREN:
     3572           good = hParent:GET-CHILD(hNoderef,i).
     3573           IF NOT good THEN
     3574               LEAVE.
     3575           IF hNoderef:SUBTYPE <> "element" THEN
     3576               NEXT.
     3577           hNoderef:GET-CHILD(hText, 1) no-error .
     3578           IF hNoderef:NAME = "ain:Header" or hNoderef:NAME = "ainp:Header" THEN do :
     3579               create tt-act-header .
     3580               assign tt-act-header.is-sent = bh-act-header:buffer-field("is-sent"):buffer-value .
     3581           end .
     3582           .
     3583           IF hNoderef:NAME = "ain:Number"
     3584           OR hNoderef:NAME = "ainp:Number" THEN assign tt-act-header.num    = hText:node-value no-error .
     3585           IF hNoderef:NAME = "ain:ActDate"
     3586           OR hNoderef:NAME = "ainp:ActDate" THEN
     3587               assign tt-act-header.date_ = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
     3588           IF hNoderef:NAME = "ainp:TypeChargeOn" THEN do :
     3589               assign tt-act-header.type_    = hText:node-value no-error .
     3590               if tt-act-header.type_ = "Продукция, полученная до 01.01.2016" then tt-act-header.type_ = "Продукция полученная до 01.01.2016" .
     3591           end.
     3592           IF hNoderef:NAME = "ainp:ActWriteOff" THEN assign v-RegID    = hText:node-value no-error .
     3593           IF hNoderef:NAME = "ain:Position"
     3594           OR hNoderef:NAME = "ainp:Position" THEN do :
     3595               assign ii = 0 .
     3596               create tt-gds-act .
     3597               assign tt-gds-act.num = tt-act-header.num .
     3598           end.
     3599           IF hNoderef:NAME = "ain:Identity"
     3600           OR hNoderef:NAME = "ainp:Identity" THEN assign tt-gds-act.position_ = integer(hText:node-value) no-error .
     3601           IF hNoderef:NAME = "pref:FullName" THEN assign tt-gds-act.egais-name = hText:node-value no-error .
     3602           IF hNoderef:NAME = "pref:AlcCode" THEN do :
     3603               assign tt-gds-act.alc-code = hText:node-value no-error .
     3604               find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     3605                                                  and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     3606                                                  AND X_ext-classif.db-num = 0
     3607                                                  and X_ext-classif.key#_two = v-ext-sys
     3608                                                  and X_ext-classif.key#_three = 0
     3609                                                  and X_ext-classif.charkey_one = tt-gds-act.alc-code
     3610                                                  and X_eXt-classif.charkey_two = ""
     3611                                                  and X_eXt-classif.charkey_three = ""
     3612                                                  and X_eXt-classif.nonunique = 0
     3613                                                  no-error.
     3614               if available X_ext-classif then do :
     3615                   find first buf_goods no-lock where buf_goods.gds-code = X_ext-classif.key#_one .
     3616                   assign
     3617                       tt-gds-act.gds-code = buf_goods.gds-code
     3618                       tt-gds-act.gds-name = buf_goods.gds-name
     3619                   .
     3620                   find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     3621                                                          and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     3622                                                          and X_ext-classif-attr.db-num = X_ext-classif.db-num
     3623                                                          and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     3624                                                          and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     3625                                                          and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     3626                                                          and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     3627                                                          and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     3628                                                          and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     3629                                                          and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     3630                                                          and X_ext-classif-attr.attr-code = 'egais-info'
     3631                                                          no-error .
     3632                   if available X_ext-classif-attr then assign tt-gds-act.egais-name = entry(3, X_ext-classif-attr.attr-value, CHR(4)) no-error.
     3633               end.
     3634           end.
     3635           IF hNoderef:NAME = "ain:Quantity"
     3636           OR hNoderef:NAME = "ainp:Quantity" THEN assign tt-gds-act.qnty = decimal(hText:node-value) no-error .
     3637           run GetChildren (hNoderef, (level + 1)).
     3638       END.
     3639       DELETE OBJECT hNoderef.
     3640       DELETE OBJECT hText.
     3641   END procedure.
     3642   PROCEDURE proc-b-mark :
     3643     define variable varlog as logical   no-undo .
     3644     if not available tt-gds-act then return.
     3645     run local-mark in this-procedure.
     3646     assign varlog = br-gds-act :select-next-row( ) in frame Dialog-Frame.
     3647     apply "ENTRY":U to br-gds-act in frame Dialog-Frame.
     3648     br-gds-act:refresh() in frame Dialog-Frame .
     3649   END PROCEDURE.
     3650   PROCEDURE local-mark :
     3651     if not available tt-gds-act then do:
     3652       message "Неправильный выбор строки.".
     3653       return no-apply.
     3654     end.
     3655   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3656   define variable v-str-recid14 as character no-undo .
     3657   define variable v-num-entry14 as integer   no-undo .
     3658   assign
     3659     v-str-recid14 = trim( string( recid( tt-gds-act ) , "->>>>>>>>>>>9":U ) )
     3660     v-num-entry14 = lookup( v-str-recid14 , select-list )
     3661   .
     3662   if v-num-entry14 > 0 then do:
     3663     assign
     3664       entry( v-num-entry14, select-list ) = "":U
     3665       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     3666     .
     3667   end.
     3668   else do:
     3669     assign
     3670       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid14
     3671     .
     3672   end.
     3673     br-gds-act:refresh() in frame Dialog-Frame .
     3674   END PROCEDURE.
     3675   PROCEDURE disable_UI :
     3676     HIDE FRAME Dialog-Frame.
     3677   END PROCEDURE.
     3678   PROCEDURE enable_UI :
     3679     ENABLE b-cancel  b-save br-gds-act b-del b-mark b-sel-all b-unmark
     3680         WITH FRAME Dialog-Frame.
     3681     VIEW FRAME Dialog-Frame.
     3682       if p-mode = 'ПРОСМОТР':U then do :
     3683           disable  tt-act-header.num tt-act-header.date_ tt-act-header.type_ with frame Dialog-Frame.
     3684           define variable hCol as handle no-undo .
     3685           define variable hBr  as handle no-undo .
     3686           hBr = browse br-gds-act:handle .
     3687           hCol = hBr:GET-BROWSE-COLUMN(7).
     3688           hCol:read-only = true .
     3689           hide b-good  b-save b-del b-alc-code in FRAME Dialog-Frame.
     3690       end.
     3691   END PROCEDURE.
