      864   procedure thbjattr_delete-section :
      865   define input  parameter p-obj-type   like ub.thbj-attr.obj-type   no-undo .
      866   define input  parameter p-obj-code   like ub.thbj-attr.obj-code   no-undo .
      867   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
      868   do
