        4   define input parameter egais        as class ActBalance_shop no-undo .
        5   define input parameter v-ext-sys    as integer no-undo .
        6   define input parameter v-fs-rar     as character no-undo .
        7   define input parameter bh-act-header  as handle no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "ЕГАИС Акт постановки на баланс".
       14   define variable ii                  as integer no-undo .
       15   define variable jj                  as integer no-undo .
       16   define variable nn                  as integer no-undo .
