        1   using ibs.th.bge.xmlimpexp.
        2   define variable vss-revision    as character no-undo init "нету ее":U .
        3   define variable vss-author      as character no-undo init "Рубан Дмитрий Андреевич":U .
        4   define variable vss-date        as character no-undo init "16 марта 2025 г":U .
        5   define variable vss-workfile    as character no-undo init "bge/codeimp.p":U .
        6   define variable vss-archive     as character no-undo init "codeimp.p":U .
        7   define variable vss-description as character no-undo init "Импорт файлов".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   function objExists return character
       67   (input  ifolder as character,
       68    input  iType   as character  ):
       69       define variable vFileType as character no-undo init "D,F".
       70       define variable vi        as integer no-undo.
       71       define variable vtype as character no-undo.
       72       if iType ne ?
       73       then
       74          vFileType = iType.
       75       do vi = 1 to num-entries(vFileType):
       76          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
       77          vtype = file-information:file-type.
       78          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       79             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       80             index(vtype , entry(vi,vFileType )) > 0
       81          then return file-information:full-pathname .
       82          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
       83          vtype = file-information:file-type.
       84          if file-information:file-name <> "" and
       85             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
       86             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
       87             index( vtype, entry(vi,vFileType )) > 0
       88          then return file-information:full-pathname .
       89       end.
       90       return ? .
       91   end.
       92   function SearchFile return character
       93   (input  ifile as character):
       94      return objExists(ifile,?).
       95   end.
       96   function SearchPFile return character
       97   (input inFile as char):
       98        define variable oFile       as character no-undo.
       99        define variable vFileSearch as character no-undo.
      100        define variable vNumEntry   as integer no-undo.
      101        if inFile = "" then return ?.
      102        vNumEntry = num-entries(inFile,".").
      103        vFileSearch = inFile.
      104        if    vNumEntry > 0
      105           and (   entry(vNumEntry,inFile,".") eq "p"
      106                or entry(vNumEntry,inFile,".") eq "w")
      107        then do:
      108           entry(vNumEntry,vFileSearch, ".") = "r".
      109           oFile = search(vFileSearch ).
      110           if oFile eq ?
      111           then
      112              oFile = search(inFile).
      113        end.
      114        else
      115           oFile = search(vFileSearch).
      116        return oFile.
      117     end.
      118   define variable varlog          as logical         no-undo.
      119   define variable mFileName       as character       no-undo.
      120   define variable mfile           as character       no-undo.
      121   define variable mfilemd5        as character       no-undo.
      122   define variable mtxt            as character       no-undo.
      123   define variable v-md5-signature as character       no-undo.
      124   define variable vimport         as class xmlimpexp no-undo.
      125   define stream md5in.
      126   define variable vErrMes as character no-undo.
      127   system-dialog get-file mFileName title "Выберите файл для загрузки"
      128       filters "Файлы (*.xml)" "*.xml,",
      129               "Все файлы" "*.*"
      130       initial-filter 1
      131       must-exist
      132       update varlog.
      133   if not varlog then return error "Отказ от импорта" .
      134   mfile    = search(mFileName).
      135   entry(num-entries(mFileName,"."),mFileName,".")= "md5".
      136   mfilemd5 = search(mFileName).
      137   if    mfile    eq ?
      138      or mfilemd5 eq ?
      139   then
      140      return error "файл не найден".
      141   input  stream md5in from value (mfilemd5).
      142   import stream md5in mtxt no-error.
      143   input  stream md5in close.
      144   run gbl/md5.p (
      145          input  mfile
      146         ,output v-md5-signature
      147         ) .
      148   if mtxt eq encode(v-md5-signature + "sysadm" ) + string(index(encode(string(v-md5-signature)), "k"))
      149   then do:
      150      vimport = new xmlimpexp().
      151      vimport:xmldom-load-ver  ( mfile,? ) no-error.
      152      if error-status:error
      153      then
      154         return error return-value.
      155      UPD_TBL:
      156      do transaction on error undo UPD_TBL, leave UPD_TBL:
      157          vimport:updatetablefordb(this-procedure) no-error.
      158          if error-status:error
      159          then return error return-value.
      160      end.
      161      return-value = "".
      162      vimport:xmldom-clear().
      163      message "Загрузка успешно завершена."
      164      view-as alert-box.
      165   end.
      166   else do:
      167      vErrMes = substitute("Файл &1 имеет не правильную сигнатуру md5.", mfile).
      168      return error vErrMes.
      169    end.
      170   finally:
      171      if valid-object (vimport)
      172      then
      173         delete object vimport.
      174   end.
