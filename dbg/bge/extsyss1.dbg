      105   procedure oxmlext-create :
      106   define input parameter p-mainmenu-handle    as handle           no-undo.
      107   define input parameter p-current-db-num     as integer          no-undo.
      108   define output parameter p-esys-id           as integer          no-undo.
      109       define variable v-today     as date         no-undo.
      110       define variable v-time      as integer      no-undo.
      111       define variable v-userid    as character    no-undo.
      112       define buffer buf_ext-system        for ub.ext-system.
      113   do
      114   for buf_ext-system
      115   on error undo, return error
      116   :
      117       run cur-time in this-procedure (
      118             output v-today
      119           , output v-time
      120       ).
      121       run oxmlext-esys-id in this-procedure (
      122           output p-esys-id
      123       ).
      124       run get-userid in p-mainmenu-handle (
      125           output v-userid
      126       ).
      127       create buf_ext-system.
      128       assign
      129           buf_ext-system.esys-id                          = p-esys-id
      130           buf_ext-system.db-num                           = p-current-db-num
      131           buf_ext-system.esys-date-change                 = v-today
      132           buf_ext-system.esys-chk-ingr-imp                = no
      133           buf_ext-system.esys-chk-seq-imp                 = no
      134           buf_ext-system.esys-date-change-attr            = v-today
      135           buf_ext-system.esys-date-change-exp             = v-today
      136           buf_ext-system.esys-date-change-imp             = v-today
      137           buf_ext-system.esys-db-num-exp                  = p-current-db-num
      138           buf_ext-system.esys-db-num-imp                  = p-current-db-num
      139           buf_ext-system.esys-des                         = ""
      140           buf_ext-system.esys-file-chk-ing-imp            = "":U
      141           buf_ext-system.esys-have-export                 = no
      142           buf_ext-system.esys-have-import                 = no
      143           buf_ext-system.esys-have-proc-chk-ing-imp       = no
      144           buf_ext-system.esys-last-pack                   = 0
      145           buf_ext-system.esys-name                        = "<Новая внешняя система>"
      146           buf_ext-system.esys-num-days-keep-exp           = 0
      147           buf_ext-system.esys-num-days-keep-imp           = 0
      148           buf_ext-system.esys-proc-chk-ing-imp            = "":U
      149           buf_ext-system.esys-send-news-exp               = no
      150           buf_ext-system.esys-send-news-imp               = no
      151           buf_ext-system.esys-status                      = integer( '-1':U )
      152           buf_ext-system.esys-work-update                 = no
      153           buf_ext-system.esys-creid                       = v-userid
      154           buf_ext-system.esys-sys-date                    = v-today
      155           buf_ext-system.esys-sys-time-int                = v-time
      156           buf_ext-system.esys-sys-time                    = string( v-time, "HH:MM:SS" )
      157           buf_ext-system.esys-user-name                   = v-userid
      158           buf_ext-system.esys-user-db-num                 = p-current-db-num
      159       .
      160   end.
      161   end procedure.
      162   procedure oxmlext-start-subsystem :
      163   define input parameter p-esys-id    as integer          no-undo.
      164   define input parameter p-db-num     as integer          no-undo.
      165       define buffer buf_ext-system        for ub.ext-system.
      166   do
      167   for buf_ext-system
      168   on error undo, return error
      169   :
      170       find first buf_ext-system exclusive-lock
      171            where buf_ext-system.esys-id = p-esys-id
      172              and buf_ext-system.db-num  = p-db-num
      173       .
      174       if buf_ext-system.esys-status = 20
      175       then do:
      176           assign
      177               buf_ext-system.esys-status = 21
      178           .
      179       end.
      180       else do:
      181           assign
      182               buf_ext-system.esys-status = 1
      183           .
      184       end.
      185   end.
      186   end procedure.
      187   procedure oxmlext-stop-subsystem :
      188   define input parameter p-esys-id    as integer          no-undo.
      189   define input parameter p-db-num     as integer          no-undo.
      190       define buffer buf_ext-system        for ub.ext-system.
      191   do
      192   for buf_ext-system
      193   on error undo, return error
      194   :
      195       find first buf_ext-system exclusive-lock
      196            where buf_ext-system.esys-id = p-esys-id
      197              and buf_ext-system.db-num  = p-db-num
      198       .
      199       if buf_ext-system.esys-status = 21
      200       then do:
      201           assign
      202               buf_ext-system.esys-status = 20
      203           .
      204       end.
      205       else do:
      206           assign
      207               buf_ext-system.esys-status = 0
      208           .
      209       end.
      210   end.
      211   end procedure.
      212   procedure oxmlext-stop-import :
      213   define input parameter p-esys-id    as integer          no-undo.
      214   define input parameter p-db-num     as integer          no-undo.
      215   do
      216   on error undo, return error
      217   :
      218   end.
      219   end procedure.
      220   procedure oxmlext-stop-export :
      221   define input parameter p-esys-id    as integer          no-undo.
      222   define input parameter p-db-num     as integer          no-undo.
      223   do
      224   on error undo, return error
      225   :
      226   end.
      227   end procedure.
      228   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      229   procedure cur-time :
      230      define output parameter p-today as date      no-undo .
      231      define output parameter p-time  as integer   no-undo .
      232     do
      233     on error undo, return error
      234     :
      235       define variable v-date1 as date      no-undo .
      236       define variable v-date2 as date      no-undo .
      237       define variable v-time  as integer   no-undo .
      238       assign
      239         v-date1 = today
      240         v-time  = time
      241         v-date2 = today
      242       .
      243       if v-date1 <> v-date2
      244       then do:
      245         assign
      246           v-date1 = today
      247           v-time  = v-time
      248         .
      249       end.
      250       assign
      251         p-today = v-date1
      252         p-time  = v-time
      253       .
      254     end.
      255   end.
      256   function cur-time-date returns character
      257   :
      258     return string(today, '99/99/9999':U) .
      259   end.
      260   function cur-time-mjd returns decimal
      261   :
      262     define variable v-date as date      no-undo .
      263     define variable v-time as integer   no-undo .
      264     run cur-time in this-procedure
      265       (output v-date
      266       ,output v-time
      267       ) .
      268     return integer(v-date) - 2400002 + (v-time / 86400) .
      269   end.
      270   function cur-time-get-ending-index returns integer
      271   (input p-number as integer
      272   )
      273   :
      274     if p-number < 0
      275     or p-number = ?
      276     then do:
      277       return 1 .
      278     end.
      279     define variable v-rest as integer   no-undo .
      280     assign
      281       p-number = p-number modulo 100
      282     .
      283     if p-number < 20
      284     then do:
      285       assign
      286         v-rest = p-number
      287       .
      288     end.
      289     else do:
      290       assign
      291         v-rest = p-number modulo 10
      292       .
      293     end.
      294     case v-rest :
      295       when 1
      296       then do:
      297         return 2 .
      298       end.
      299       when 2 or
      300       when 3 or
      301       when 4
      302       then do:
      303         return 3 .
      304       end.
      305       otherwise do:
      306         return 1 .
      307       end.
      308     end case .
      309   end.
      310   procedure cur-time-mjd-to-date :
      311      define input  parameter i-mjd-diff as decimal no-undo.
      312      define output parameter o-Date     as date    no-undo.
      313      define output parameter o-Time     as integer no-undo.
      314      define variable v-day-number as integer   no-undo .
      315      if    i-mjd-diff < 0
      316         or i-mjd-diff = ?
      317      then do:
      318         return "?" .
      319      end.
      320      assign
      321         v-day-number = truncate(i-mjd-diff,0).
      322         o-Date = date(v-day-number + 2400002).
      323         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      324     .
      325   end.
      326   function cur-time-mjd-to-string returns character
      327   (input p-mjd-diff as decimal
      328   )
      329   :
      330     define variable v-day-number as integer   no-undo .
      331     define variable v-seconds    as integer   no-undo .
      332     define variable v-hour       as integer   no-undo .
      333     define variable v-min        as integer   no-undo .
      334     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      335     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      336     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      337     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      338     if p-mjd-diff < 0
      339     or p-mjd-diff = ?
      340     then do:
      341       return "?" .
      342     end.
      343     assign
      344       v-day-number = integer(truncate(p-mjd-diff,0))
      345       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      346     .
      347     if v-seconds > 86400
      348     then do:
      349       assign
      350         v-seconds = 86400 - 1
      351       .
      352     end.
      353     if v-seconds < 0
      354     then do:
      355       assign
      356         v-seconds = 0
      357       .
      358     end.
      359     assign
      360       v-hour = truncate(v-seconds / 3600, 0)
      361     .
      362     assign
      363       v-seconds = v-seconds modulo 3600
      364     .
      365     assign
      366       v-min = truncate(v-seconds / 60, 0)
      367     .
      368     assign
      369       v-seconds = v-seconds modulo 60
      370     .
      371     return
      372         (if v-day-number <> 0
      373           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      374           else ""
      375         )
      376       + (if v-day-number <> 0 or v-hour <> 0
      377           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      378           else ""
      379         )
      380       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      381           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      382           else ""
      383         )
      384       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      385       .
      386   end.
      387   function cur-time-string returns character
      388   :
      389     define variable v-date as date      no-undo .
      390     define variable v-time as integer   no-undo .
      391     run cur-time in this-procedure
      392       (output v-date
      393       ,output v-time
      394       ) .
      395     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      396   end.
      397   function cur-time-string-sec returns character
      398   :
      399     define variable v-date as date      no-undo .
      400     define variable v-time as integer   no-undo .
      401     run cur-time in this-procedure
      402       (output v-date
      403       ,output v-time
      404       ) .
      405     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      406   end.
      407   function cur-time-custom  returns character
      408   (input p-prefix as character
      409   ,input p-date-format as character
      410   ,input p-delimiter as character
      411   ,input p-time-format as character
      412   ,input p-suffix as character
      413   )
      414   :
      415     define variable v-date as date      no-undo .
      416     define variable v-time as integer   no-undo .
      417     run cur-time in this-procedure
      418       (output v-date
      419       ,output v-time
      420       ) .
      421     return
      422       p-prefix
      423       + string(v-date, p-date-format)
      424       + p-delimiter
      425       + string(v-time, p-time-format)
      426       + p-suffix
      427       .
      428   end.
      429   function cur-time-print  returns character
      430   :
      431     define variable v-date as date      no-undo .
      432     define variable v-time as integer   no-undo .
      433     run cur-time in this-procedure
      434       (output v-date
      435       ,output v-time
      436       ) .
      437     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      438   end.
      439   function cur-time-datetime returns datetime
      440   :
      441     define variable v-char as character no-undo .
      442     define variable v-datetime as datetime no-undo .
      443     v-char = cur-time-string().
      444     v-datetime = datetime(v-char).
      445     return  v-datetime.
      446   end.
      447   function cur-time-string-msec returns character
      448   :
      449     define variable v-date as datetime  no-undo .
      450     v-date = now.
      451     return string(v-date) .
      452   end.
      453   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      454   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      455   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      456   procedure gen-key-rec :
      457     define input  parameter p-tbl-name    as character no-undo.
      458     define input  parameter p-bh_tbl-name as handle    no-undo.
      459     define output parameter p-key-rec     as character no-undo.
      460     do
      461     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      462     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      463     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      464     :
      465       define variable fh               as handle    no-undo .
      466       define variable v-ok             as logical   no-undo .
      467       define variable v-inform         as character no-undo .
      468       define variable v-ind            as integer   no-undo .
      469       define variable v-idx-field-qnty as integer   no-undo .
      470       if p-tbl-name = ?
      471         or p-tbl-name = "":U
      472       then do:
      473         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      474       end.
      475       if not p-bh_tbl-name:available then do:
      476         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      477       end.
      478       assign
      479         p-key-rec = p-tbl-name
      480         v-inform  = p-bh_tbl-name:index-information(1)
      481         v-ind     = 2
      482       .
      483       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      484       on error undo, return error
      485       :
      486         assign
      487           v-inform = p-bh_tbl-name:index-information( v-ind )
      488           v-ind    = v-ind + 1
      489         .
      490       end.
      491       if v-inform = ?
      492         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      493         or entry( 3, v-inform, ",":U ) <> "1":U
      494       then do:
      495         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      496       end.
      497       else do:
      498         assign
      499           v-idx-field-qnty = num-entries( v-inform ) - 4
      500         .
      501         if v-idx-field-qnty < 2 then do:
      502           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      503         end.
      504         do v-ind = 1 to v-idx-field-qnty by 2
      505         on error undo, return error
      506         :
      507           assign
      508             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      509             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      510           .
      511         end.
      512       end.
      513       if p-key-rec = ? then do:
      514         assign
      515           p-key-rec = "":U
      516         .
      517         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      518       end.
      519     end.
      520     return.
      521   end procedure.
      522   procedure gen-where-keyr-tab :
      523     define input  parameter i-tableSerach as character no-undo.
      524     define input  parameter i-tablekey   as character  no-undo.
      525     define input  parameter p-key-rec    as character  no-undo.
      526     define input  parameter p-key-handle as handle     no-undo .
      527     define input  parameter p-db-name    as character  no-undo .
      528     define input  parameter p-tt-handle  as handle     no-undo .
      529     define output parameter o-Where      as character  no-undo.
      530     do
      531     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      532     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      533     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      534     :
      535       define variable v-full-tbl-name  as character no-undo .
      536       define variable bh_tbl-name      as handle    no-undo .
      537       define variable fh_key           as handle    no-undo .
      538       define variable fh_search        as handle    no-undo .
      539       define variable v-field-num      as integer   no-undo .
      540       define variable v-count-fld      as integer   no-undo .
      541       define variable v-inform         as character no-undo .
      542       define variable v-ind            as integer   no-undo .
      543       define variable v-idx-field-qnty as integer   no-undo .
      544       define variable v-field-name     as character no-undo .
      545       define variable v-field-val      as character no-undo .
      546       define variable v-word-link      as character no-undo .
      547       define variable vTable           as character no-undo.
      548       define variable bh_tbl-key       as handle    no-undo .
      549       assign
      550         p-key-rec = trim( p-key-rec )
      551       .
      552       if p-key-handle <> ? then do:
      553         if not valid-handle(p-key-handle)
      554            or p-key-handle:type <> "buffer"
      555         then do:
      556           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      557         end.
      558         if num-entries( p-key-rec, chr(3) ) > 1
      559           or p-key-rec = ?
      560           or p-key-rec = "":U
      561         then do:
      562           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      563         end.
      564       end.
      565       else do:
      566         if p-key-rec = ?
      567           or p-key-rec = "":U
      568         then do:
      569           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      570         end.
      571       end.
      572       assign
      573         vTable = entry( 1 , p-key-rec, chr(3) )
      574       .
      575       if p-tt-handle <> ?
      576         and ( not valid-handle(p-tt-handle)
      577               or p-tt-handle:type <> "buffer"
      578             )
      579       then do:
      580         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      581       end.
      582       if p-tt-handle = ? then do:
      583         assign
      584           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      585         .
      586         create buffer bh_tbl-name for table v-full-tbl-name .
      587       end.
      588       else do:
      589         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      590       end.
      591       assign
      592         v-inform = bh_tbl-name:index-information(1)
      593         v-ind    = 2
      594       .
      595       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      596       on error undo, return error
      597       :
      598         assign
      599           v-inform = bh_tbl-name:index-information( v-ind )
      600           v-ind    = v-ind + 1
      601         .
      602       end.
      603       if v-inform = ?
      604         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      605         or entry( 3, v-inform, ",":U ) <> "1":U
      606       then do:
      607         delete object bh_tbl-name no-error.
      608         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      609       end.
      610       assign
      611         v-idx-field-qnty = num-entries( v-inform ) - 4
      612       .
      613       if v-idx-field-qnty < 2 then do:
      614         delete object bh_tbl-name no-error.
      615         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      616       end.
      617       assign
      618         o-where     = "where":U
      619         v-word-link = "":U
      620         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      621         v-count-fld = 0
      622       .
      623       if i-tablekey ne "" and i-tablekey ne ?
      624       then do:
      625         assign
      626           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      627         .
      628         create buffer bh_tbl-key for table v-full-tbl-name .
      629       end.
      630       if i-tableSerach ne "" and i-tableSerach ne ?
      631       then do:
      632         delete object bh_tbl-name no-error.
      633         assign
      634           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      635         .
      636         create buffer bh_tbl-name for table v-full-tbl-name .
      637       end.
      638       block_where:
      639       do v-ind = 1 to v-idx-field-qnty by 2
      640       on error undo, return error
      641       :
      642         assign
      643           v-count-fld = v-count-fld + 1
      644         .
      645         if p-key-handle = ?
      646           and v-count-fld > v-field-num
      647         then do:
      648           leave block_where.
      649         end.
      650         define variable VfieldKeyTable as handle no-undo.
      651         assign
      652           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      653           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      654         .
      655         if     bh_tbl-key ne ?
      656         then do:
      657            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      658            if VfieldKeyTable eq ?
      659            then next block_where.
      660         end.
      661         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      662         then
      663            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      664         else
      665            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      666         if p-key-handle = ? then do:
      667           assign
      668             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      669           .
      670         end.
      671         else do:
      672           assign
      673             fh_key = p-key-handle:buffer-field( v-field-name )
      674           .
      675           if fh_key = ?
      676             or not valid-handle( fh_key )
      677           then do:
      678             delete object bh_tbl-name.
      679             if     bh_tbl-key ne ?
      680             then
      681                delete object bh_tbl-key.
      682             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      683           end.
      684           assign
      685             v-field-val = fh_key:buffer-value
      686           .
      687         end.
      688         if fh_search:data-type ="character":U then do:
      689           assign
      690             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      691             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      692             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      693             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      694             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      695             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      696             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      697             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      698             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      699             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      700             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      701             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      702             v-field-val = substitute( '"&1"', v-field-val )
      703           .
      704         end.
      705         assign
      706           o-where = substitute( "&1 &2", o-where, v-field-val )
      707         .
      708         if v-word-link = "":U then do:
      709           assign
      710             v-word-link = "and":U
      711           .
      712         end.
      713       end.
      714       delete object bh_tbl-name.
      715       if     bh_tbl-key ne ?
      716       then
      717          delete object bh_tbl-key.
      718       if p-key-handle = ?
      719         and v-count-fld <> v-field-num
      720       then do:
      721         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      722       end.
      723     end.
      724   end procedure.
      725   procedure gen-hn-keyr-tab :
      726     define input  parameter i-tableSerach as character no-undo.
      727     define input  parameter i-tablekey   as character no-undo.
      728     define input  parameter p-key-rec    as character no-undo.
      729     define input  parameter p-key-handle as handle    no-undo .
      730     define input  parameter p-db-name    as character no-undo .
      731     define input  parameter p-tt-handle  as handle    no-undo .
      732     define input  parameter p-stts-lock  as integer   no-undo .
      733     define output parameter o-hn         as handle    no-undo.
      734     define variable v-full-tbl-name as character no-undo.
      735     define variable v-where         as character no-undo.
      736     define variable bh_tbl-name     as handle    no-undo.
      737     define variable vTable          as character no-undo.
      738     do
      739     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      740     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      741     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      742         run gen-where-keyr-tab(i-tableSerach,
      743                                i-tablekey,
      744                                p-key-rec,
      745                                p-key-handle,
      746                                p-db-name,
      747                                p-tt-handle,
      748                                output v-where).
      749         if i-tableSerach ne "" and i-tableSerach ne ?
      750         then do:
      751            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      752            create buffer bh_tbl-name for table v-full-tbl-name .
      753         end.
      754         else do:
      755            if p-tt-handle = ? then do:
      756               assign
      757                  vTable = entry( 1 , p-key-rec, chr(3) )
      758               .
      759               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      760               create buffer bh_tbl-name for table v-full-tbl-name .
      761            end.
      762            else do:
      763               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      764            end.
      765         end.
      766         if p-tt-handle = ? then do:
      767            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      768         end.
      769         else do:
      770            bh_tbl-name:find-first( v-where ) no-error .
      771         end.
      772         o-hn = bh_tbl-name.
      773      end.
      774   end procedure.
      775   procedure gen-hn-keyr :
      776     define input  parameter p-key-rec    as character no-undo.
      777     define input  parameter p-key-handle as handle    no-undo .
      778     define input  parameter p-db-name    as character no-undo .
      779     define input  parameter p-tt-handle  as handle    no-undo .
      780     define input  parameter p-stts-lock  as integer   no-undo .
      781     define output parameter o-hn         as handle    no-undo.
      782     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      783   end.
      784   procedure gen-row-keyr :
      785     define input  parameter p-key-rec    as character no-undo.
      786     define input  parameter p-key-handle as handle    no-undo .
      787     define input  parameter p-db-name    as character no-undo .
      788     define input  parameter p-tt-handle  as handle    no-undo .
      789     define input  parameter p-stts-lock  as integer   no-undo .
      790     define output parameter p-tbl-row    as rowid     no-undo.
      791     define output parameter p-tbl-name   as character no-undo.
      792     define variable vHn as handle no-undo.
      793       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      794       p-tbl-row = if vHn:available then vHn:rowid else ?.
      795       p-tbl-name =  vHn:table.
      796       delete object vHn no-error.
      797     if p-tbl-row = ? then do:
      798       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      799     end.
      800     else do:
      801       return.
      802     end.
      803   end procedure.
      804   procedure gen-key-fv :
      805     define input  parameter p-key-rec    as character no-undo .
      806     define output parameter p-field-list as character no-undo .
      807     define output parameter p-value-list as character no-undo.
      808     do
      809     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      810     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      811     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      812     :
      813       define variable v-full-tbl-name  as character no-undo .
      814       define variable bh_tbl-name      as handle    no-undo .
      815       define variable v-tbl-name       as character no-undo .
      816       define variable v-field-num      as integer   no-undo .
      817       define variable v-count-fld      as integer   no-undo .
      818       define variable v-inform         as character no-undo .
      819       define variable v-ind            as integer   no-undo .
      820       define variable v-idx-field-qnty as integer   no-undo .
      821       define variable v-delim-key      as character no-undo .
      822       if p-key-rec = ?
      823         or p-key-rec = "":U
      824       then do:
      825         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      826       end.
      827       assign
      828         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      829         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      830       .
      831       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      832       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
      833       assign
      834         v-inform = bh_tbl-name:index-information(1)
      835         v-ind    = 2
      836       .
      837       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      838       on error undo, return error
      839       :
      840         assign
      841           v-inform = bh_tbl-name:index-information( v-ind )
      842           v-ind    = v-ind + 1
      843         .
      844       end.
      845       if v-inform = ?
      846         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      847         or entry( 3, v-inform, ",":U ) <> "1":U
      848       then do:
      849         delete object bh_tbl-name no-error.
      850         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      851       end.
      852       assign
      853         v-idx-field-qnty = num-entries( v-inform ) - 4
      854       .
      855       if v-idx-field-qnty < 2 then do:
      856         delete object bh_tbl-name no-error.
      857         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      858       end.
      859       assign
      860         p-field-list = "":U
      861         p-value-list = "":U
      862         v-delim-key  = "":U
      863         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      864         v-count-fld  = 0
      865       .
      866       block_where:
      867       do v-ind = 1 to v-idx-field-qnty by 2
      868       on error undo, return error
      869       :
      870         assign
      871           v-count-fld = v-count-fld + 1
      872         .
      873         if v-count-fld > v-field-num then do:
      874           leave block_where.
      875         end.
      876         assign
      877           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      878           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      879         .
      880         if v-ind = 1 then do:
      881           assign
      882             v-delim-key = chr(3)
      883           .
      884         end.
      885       end.
      886       delete object bh_tbl-name.
      887       if v-count-fld <> v-field-num then do:
      888         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      889       end.
      890     end.
      891   end procedure.
      892   procedure gen-key-field :
      893     define input  parameter p-table      as character no-undo .
      894     define output parameter p-field-list as character no-undo .
      895     do
      896     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      897     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      898     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      899     :
      900       define variable v-full-tbl-name  as character no-undo .
      901       define variable bh_tbl-name      as handle    no-undo .
      902       define variable v-tbl-name       as character no-undo .
      903       define variable v-field-num      as integer   no-undo .
      904       define variable v-count-fld      as integer   no-undo .
      905       define variable v-inform         as character no-undo .
      906       define variable v-ind            as integer   no-undo .
      907       define variable v-idx-field-qnty as integer   no-undo .
      908       define variable v-delim-key      as character no-undo .
      909       if p-table = ?
      910         or p-table = "":U
      911       then do:
      912         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
      913       end.
      914       assign
      915         v-tbl-name      = p-table
      916         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      917       .
      918       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      919       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
      920       assign
      921         v-inform = bh_tbl-name:index-information(1)
      922         v-ind    = 2
      923       .
      924       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      925       on error undo, return error
      926       :
      927         assign
      928           v-inform = bh_tbl-name:index-information( v-ind )
      929           v-ind    = v-ind + 1
      930         .
      931       end.
      932       if v-inform = ?
      933         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      934         or entry( 3, v-inform, ",":U ) <> "1":U
      935       then do:
      936         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      937       end.
      938       assign
      939         v-idx-field-qnty = num-entries( v-inform ) - 4
      940       .
      941       if v-idx-field-qnty < 2 then do:
      942         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      943       end.
      944       assign
      945         p-field-list = "":U
      946         v-delim-key  = "":U
      947         v-count-fld  = 0
      948       .
      949       block_where:
      950       do v-ind = 1 to v-idx-field-qnty by 2
      951       on error undo, return error
      952       :
      953         assign
      954           v-count-fld = v-count-fld + 1
      955         .
      956         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      957         if v-ind = 1 then do:
      958           assign
      959             v-delim-key = chr(3)
      960           .
      961         end.
      962       end.
      963       delete object bh_tbl-name.
      964     end.
      965   end procedure.
      966   procedure extsyssl :
      967   define parameter buffer buf_ext-system for ub.ext-system.
      968   define output parameter p-ok as logical   no-undo .
      969   define variable v-resource-id as character no-undo .
      970   define variable v-found as logical   no-undo .
      971   define buffer buf_some-lk for ub.some-lk.
      972   define buffer buf_ext-classif for ub.ext-classif.
      973   do
      974   on error undo, return error return-value
      975   :
      976     for each buf_ext-classif no-lock where
      977           buf_ext-classif.classif-subject = 'clients':U
      978       and buf_ext-classif.classif-name = 'clients-esys':U
      979       AND buf_ext-classif.db-num = 0
      980       AND buf_ext-classif.key#_one = buf_ext-system.esys-id
      981     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      982     on stop   undo , return error substitute( "&1. stop", vss-workfile )
      983     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
      984     :
      985       v-found = yes.
      986       leave.
      987     end.
      988     if v-found then do:
      989       undo, return error substitute("К данной внешней системе привязаны объекты&1" +
      990                           "изменение моды экспорта/импорта или БД для экспорта/импорта НЕВОЗМОЖНО", chr(10)).
      991     end.
      992     for each buf_ext-classif no-lock where
      993           buf_ext-classif.classif-subject = 'clients':U
      994       and buf_ext-classif.classif-name = 'clients-edoc-nn':U
      995       AND buf_ext-classif.db-num = -1
      996       AND buf_ext-classif.key#_one = buf_ext-system.esys-id
      997     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      998     on stop   undo , return error substitute( "&1. stop", vss-workfile )
      999     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1000     :
     1001       v-found = yes.
     1002       leave.
     1003     end.
     1004     if v-found then do:
     1005       undo, return error substitute("К данной внешней системе привязаны контрагенты&1" +
     1006                           "изменение моды экспорта/импорта или БД для экспорта/импорта НЕВОЗМОЖНО", chr(10)).
     1007     end.
     1008     for each buf_ext-classif no-lock where
     1009           buf_ext-classif.classif-subject = 'clients':U
     1010       and buf_ext-classif.classif-name = 'exite-edi':U
     1011       AND buf_ext-classif.db-num = -1
     1012       AND buf_ext-classif.key#_one = buf_ext-system.esys-id
     1013     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1014     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1015     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1016     :
     1017       v-found = yes.
     1018       leave.
     1019     end.
     1020     if v-found then do:
     1021       undo, return error substitute("К данной внешней системе привязаны контрагенты&1" +
     1022                           "изменение моды экспорта/импорта или БД для экспорта/импорта НЕВОЗМОЖНО", chr(10)).
     1023     end.
     1024     run gen-key-rec in this-procedure ( input 'ext-system':U
     1025                                       ,input (buffer buf_ext-system:handle)
     1026                                       ,output v-resource-id).
     1027     for each buf_some-lk no-lock where
     1028             buf_some-lk.resource_id = v-resource-id :
     1029       leave.
     1030     end.
     1031     if available buf_some-lk then do:
     1032       undo, return error substitute("Внешняя система используется").
     1033     end.
     1034     p-ok = yes.
     1035   end.
     1036   end procedure.
     1037   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1038   define new global shared variable g#attr-lib  as handle no-undo .
