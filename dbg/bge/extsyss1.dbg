        1   block-level on error undo, throw.
        2   define input parameter p-mode as character no-undo .
        3   define input parameter p-silent as logical no-undo .
        4   define input-output parameter p-rec as recid no-undo .
        5   define input parameter p-esys-id as integer no-undo .
        6   define input parameter p-db-num as integer no-undo .
        7   define input parameter p-esys-name as character no-undo .
        8   define input parameter p-esys-des as character no-undo .
        9   define input parameter p-esys-have-export as logical no-undo .
       10   define input parameter p-esys-db-num-exp as integer no-undo .
       11   define input parameter p-esys-send-news-exp  as logical no-undo .
       12   define input parameter p-esys-num-days-keep-exp  as integer no-undo .
       13   define input parameter p-esys-max-p-size as integer no-undo .
       14   define input parameter p-exp-conf-wait as integer no-undo .
       15   define input parameter p-max-p-queue as integer no-undo .
       16   define input parameter p-max-p-time as integer no-undo .
       17   define input parameter p-esys-have-import as logical no-undo .
       18   define input parameter p-esys-db-num-imp as integer no-undo .
       19   define input parameter p-esys-send-news-imp  as logical no-undo .
       20   define input parameter p-esys-num-days-keep-imp  as integer no-undo .
       21   define input parameter p-imp-conf-send as integer no-undo .
       22   define input parameter p-esys-type as integer no-undo .
       23   define input parameter p-delivery-method as integer no-undo .
       24   define input parameter p-delete-pck-on as integer no-undo .
       25   define input parameter p-save-days-pck-num as integer no-undo .
