       27   DEFINE INPUT PARAMETER TABLE FOR tt-ext-system-attr.
       28   define variable vss-revision    as character no-undo init "$Revision: b4bfe3261567, 1895, rls $":U .
       29   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
       30   define variable vss-date        as character no-undo init "$Date: Fri Jun 07 16:26:45 2019 +0300 $":U .
       31   define variable vss-workfile    as character no-undo init "$Workfile: extsyss1.p $":U .
