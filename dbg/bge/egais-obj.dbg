     1757          input "get":U
     1758         ,input v-cntxt-obj-type
     1759         ,input v-cntxt-obj-code
     1760         ,input 'egais':U
     1761         ,input 'egais-fsrar':U
     1762         ,output v-value-character
     1763         ,output v-value-date
     1764         ,output v-value-decimal
     1765         ,output v-value-integer
     1766         ,output v-value-logical
     1767         ,output v-value-type
     1768         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1769         ) no-error .
     1770     assign
     1771       v-org = buf_clients.obj-name
     1772       v-fs-rar = v-value-character
     1773       v-org-inn = buf_firm.inn
