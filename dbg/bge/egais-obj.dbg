     1719       (output v-cntxt-db-num
     1720       ,output v-cntxt-userid
     1721       ,output v-cntxt-level
     1722       ,output v-cntxt-host-code-obj
     1723       ,output v-cntxt-obj-type
     1724       ,output v-cntxt-obj-code
     1725       ,output v-cntxt-db-num-obj
     1726       ,output v-cntxt-is-admin
     1727       ) .
     1728   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1729   do:
     1730     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1731       (input  v-cntxt-db-num
     1732       ,input  v-cntxt-userid
     1733       ,input  0
     1734       ,input  'actn_egais-obj':U
     1735       ,input  'object':U
     1736       ,input  v-cntxt-host-code-obj
     1737       ,input  v-cntxt-obj-type
     1738       ,input  v-cntxt-obj-code
     1739       ,input  0
     1740       ,input  0
     1741       ,input  0
     1742       ,input  true
     1743       ,output glog
     1744       )  .
     1745   end.
     1746     if not glog then  return .
     1747     find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = v-cntxt-host-code-obj.
     1748     find first buf_firm no-lock where buf_firm.firm-code = v-cntxt-host-code-obj.
     1749     if valid-handle(bh-obj-egais) then do :
