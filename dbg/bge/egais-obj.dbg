      698   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      699   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      700   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      701   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      702   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      703   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      704   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      705   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      706   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      707   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      708   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      709   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      710   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      711   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      712   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      713   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      714   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      715   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      716   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      717   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      718   procedure gen-key-rec :
      719     define input  parameter p-tbl-name    as character no-undo.
      720     define input  parameter p-bh_tbl-name as handle    no-undo.
      721     define output parameter p-key-rec     as character no-undo.
      722     do
      723     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      724     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      725     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      726     :
      727       define variable fh               as handle    no-undo .
      728       define variable v-ok             as logical   no-undo .
      729       define variable v-inform         as character no-undo .
      730       define variable v-ind            as integer   no-undo .
      731       define variable v-idx-field-qnty as integer   no-undo .
      732       if p-tbl-name = ?
      733         or p-tbl-name = "":U
      734       then do:
      735         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info6 ).
      736       end.
      737       if not p-bh_tbl-name:available then do:
      738         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info6, p-tbl-name ).
      739       end.
      740       assign
      741         p-key-rec = p-tbl-name
      742         v-inform  = p-bh_tbl-name:index-information(1)
      743         v-ind     = 2
      744       .
      745       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      746       on error undo, return error
      747       :
      748         assign
      749           v-inform = p-bh_tbl-name:index-information( v-ind )
      750           v-ind    = v-ind + 1
      751         .
      752       end.
      753       if v-inform = ?
      754         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      755         or entry( 3, v-inform, ",":U ) <> "1":U
      756       then do:
      757         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, p-tbl-name ).
      758       end.
      759       else do:
      760         assign
      761           v-idx-field-qnty = num-entries( v-inform ) - 4
      762         .
      763         if v-idx-field-qnty < 2 then do:
      764           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, p-tbl-name ).
      765         end.
      766         do v-ind = 1 to v-idx-field-qnty by 2
      767         on error undo, return error
      768         :
      769           assign
      770             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      771             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      772           .
      773         end.
      774       end.
      775       if p-key-rec = ? then do:
      776         assign
      777           p-key-rec = "":U
      778         .
      779         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info6, p-tbl-name ).
      780       end.
      781     end.
      782     return.
      783   end procedure.
      784   procedure gen-where-keyr-tab :
      785     define input  parameter i-tableSerach as character no-undo.
      786     define input  parameter i-tablekey   as character  no-undo.
      787     define input  parameter p-key-rec    as character  no-undo.
      788     define input  parameter p-key-handle as handle     no-undo .
      789     define input  parameter p-db-name    as character  no-undo .
      790     define input  parameter p-tt-handle  as handle     no-undo .
      791     define output parameter o-Where      as character  no-undo.
      792     do
      793     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      794     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      795     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      796     :
      797       define variable v-full-tbl-name  as character no-undo .
      798       define variable bh_tbl-name      as handle    no-undo .
      799       define variable fh_key           as handle    no-undo .
      800       define variable fh_search        as handle    no-undo .
      801       define variable v-field-num      as integer   no-undo .
      802       define variable v-count-fld      as integer   no-undo .
      803       define variable v-inform         as character no-undo .
      804       define variable v-ind            as integer   no-undo .
      805       define variable v-idx-field-qnty as integer   no-undo .
      806       define variable v-field-name     as character no-undo .
      807       define variable v-field-val      as character no-undo .
      808       define variable v-word-link      as character no-undo .
      809       define variable vTable           as character no-undo.
      810       define variable bh_tbl-key       as handle    no-undo .
      811       assign
      812         p-key-rec = trim( p-key-rec )
      813       .
      814       if p-key-handle <> ? then do:
      815         if not valid-handle(p-key-handle)
      816            or p-key-handle:type <> "buffer"
      817         then do:
      818           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info6 ).
      819         end.
      820         if num-entries( p-key-rec, chr(3) ) > 1
      821           or p-key-rec = ?
      822           or p-key-rec = "":U
      823         then do:
      824           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info6, p-key-rec ).
      825         end.
      826       end.
      827       else do:
      828         if p-key-rec = ?
      829           or p-key-rec = "":U
      830         then do:
      831           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      832         end.
      833       end.
      834       assign
      835         vTable = entry( 1 , p-key-rec, chr(3) )
      836       .
      837       if p-tt-handle <> ?
      838         and ( not valid-handle(p-tt-handle)
      839               or p-tt-handle:type <> "buffer"
      840             )
      841       then do:
      842         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info6, vTable, chr(10) ).
      843       end.
      844       if p-tt-handle = ? then do:
      845         assign
      846           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      847         .
      848         create buffer bh_tbl-name for table v-full-tbl-name .
      849       end.
      850       else do:
      851         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      852       end.
      853       assign
      854         v-inform = bh_tbl-name:index-information(1)
      855         v-ind    = 2
      856       .
      857       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      858       on error undo, return error
      859       :
      860         assign
      861           v-inform = bh_tbl-name:index-information( v-ind )
      862           v-ind    = v-ind + 1
      863         .
      864       end.
      865       if v-inform = ?
      866         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      867         or entry( 3, v-inform, ",":U ) <> "1":U
      868       then do:
      869         delete object bh_tbl-name no-error.
      870         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info6, vTable ).
      871       end.
      872       assign
      873         v-idx-field-qnty = num-entries( v-inform ) - 4
      874       .
      875       if v-idx-field-qnty < 2 then do:
      876         delete object bh_tbl-name no-error.
      877         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, vTable ).
      878       end.
      879       assign
      880         o-where     = "where":U
      881         v-word-link = "":U
      882         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      883         v-count-fld = 0
      884       .
      885       if i-tablekey ne "" and i-tablekey ne ?
      886       then do:
      887         assign
      888           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      889         .
      890         create buffer bh_tbl-key for table v-full-tbl-name .
      891       end.
      892       if i-tableSerach ne "" and i-tableSerach ne ?
      893       then do:
      894         delete object bh_tbl-name no-error.
      895         assign
      896           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      897         .
      898         create buffer bh_tbl-name for table v-full-tbl-name .
      899       end.
      900       block_where:
      901       do v-ind = 1 to v-idx-field-qnty by 2
      902       on error undo, return error
      903       :
      904         assign
      905           v-count-fld = v-count-fld + 1
      906         .
      907         if p-key-handle = ?
      908           and v-count-fld > v-field-num
      909         then do:
      910           leave block_where.
      911         end.
      912         define variable VfieldKeyTable as handle no-undo.
      913         assign
      914           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      915           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      916         .
      917         if     bh_tbl-key ne ?
      918         then do:
      919            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      920            if VfieldKeyTable eq ?
      921            then next block_where.
      922         end.
      923         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      924         then
      925            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      926         else
      927            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      928         if p-key-handle = ? then do:
      929           assign
      930             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      931           .
      932         end.
      933         else do:
      934           assign
      935             fh_key = p-key-handle:buffer-field( v-field-name )
      936           .
      937           if fh_key = ?
      938             or not valid-handle( fh_key )
      939           then do:
      940             delete object bh_tbl-name.
      941             if     bh_tbl-key ne ?
      942             then
      943                delete object bh_tbl-key.
      944             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info6, p-key-handle:name, v-field-name ).
      945           end.
      946           assign
      947             v-field-val = fh_key:buffer-value
      948           .
      949         end.
      950         if fh_search:data-type ="character":U then do:
      951           assign
      952             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      953             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      954             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      955             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      956             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      957             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      958             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      959             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      960             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      961             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      962             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      963             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      964             v-field-val = substitute( '"&1"', v-field-val )
      965           .
      966         end.
      967         assign
      968           o-where = substitute( "&1 &2", o-where, v-field-val )
      969         .
      970         if v-word-link = "":U then do:
      971           assign
      972             v-word-link = "and":U
      973           .
      974         end.
      975       end.
      976       delete object bh_tbl-name.
      977       if     bh_tbl-key ne ?
      978       then
      979          delete object bh_tbl-key.
      980       if p-key-handle = ?
      981         and v-count-fld <> v-field-num
      982       then do:
      983         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info6, vTable ).
      984       end.
      985     end.
      986   end procedure.
      987   procedure gen-hn-keyr-tab :
      988     define input  parameter i-tableSerach as character no-undo.
      989     define input  parameter i-tablekey   as character no-undo.
      990     define input  parameter p-key-rec    as character no-undo.
      991     define input  parameter p-key-handle as handle    no-undo .
      992     define input  parameter p-db-name    as character no-undo .
      993     define input  parameter p-tt-handle  as handle    no-undo .
      994     define input  parameter p-stts-lock  as integer   no-undo .
      995     define output parameter o-hn         as handle    no-undo.
      996     define variable v-full-tbl-name as character no-undo.
      997     define variable v-where         as character no-undo.
      998     define variable bh_tbl-name     as handle    no-undo.
      999     define variable vTable          as character no-undo.
     1000     do
     1001     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1002     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1003     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1004         run gen-where-keyr-tab(i-tableSerach,
     1005                                i-tablekey,
     1006                                p-key-rec,
     1007                                p-key-handle,
     1008                                p-db-name,
     1009                                p-tt-handle,
     1010                                output v-where).
     1011         if i-tableSerach ne "" and i-tableSerach ne ?
     1012         then do:
     1013            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1014            create buffer bh_tbl-name for table v-full-tbl-name .
     1015         end.
     1016         else do:
     1017            if p-tt-handle = ? then do:
     1018               assign
     1019                  vTable = entry( 1 , p-key-rec, chr(3) )
     1020               .
     1021               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1022               create buffer bh_tbl-name for table v-full-tbl-name .
     1023            end.
     1024            else do:
     1025               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1026            end.
     1027         end.
     1028         if p-tt-handle = ? then do:
     1029            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1030         end.
     1031         else do:
     1032            bh_tbl-name:find-first( v-where ) no-error .
     1033         end.
     1034         o-hn = bh_tbl-name.
     1035      end.
     1036   end procedure.
     1037   procedure gen-hn-keyr :
     1038     define input  parameter p-key-rec    as character no-undo.
     1039     define input  parameter p-key-handle as handle    no-undo .
     1040     define input  parameter p-db-name    as character no-undo .
     1041     define input  parameter p-tt-handle  as handle    no-undo .
     1042     define input  parameter p-stts-lock  as integer   no-undo .
     1043     define output parameter o-hn         as handle    no-undo.
     1044     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1045   end.
     1046   procedure gen-row-keyr :
     1047     define input  parameter p-key-rec    as character no-undo.
     1048     define input  parameter p-key-handle as handle    no-undo .
     1049     define input  parameter p-db-name    as character no-undo .
     1050     define input  parameter p-tt-handle  as handle    no-undo .
     1051     define input  parameter p-stts-lock  as integer   no-undo .
     1052     define output parameter p-tbl-row    as rowid     no-undo.
     1053     define output parameter p-tbl-name   as character no-undo.
     1054     define variable vHn as handle no-undo.
     1055       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1056       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1057       p-tbl-name =  vHn:table.
     1058       delete object vHn no-error.
     1059     if p-tbl-row = ? then do:
     1060       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info6, p-tbl-name, p-key-rec ).
     1061     end.
     1062     else do:
     1063       return.
     1064     end.
     1065   end procedure.
     1066   procedure gen-key-fv :
     1067     define input  parameter p-key-rec    as character no-undo .
     1068     define output parameter p-field-list as character no-undo .
     1069     define output parameter p-value-list as character no-undo.
     1070     do
     1071     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1072     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1073     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1074     :
     1075       define variable v-full-tbl-name  as character no-undo .
     1076       define variable bh_tbl-name      as handle    no-undo .
     1077       define variable v-tbl-name       as character no-undo .
     1078       define variable v-field-num      as integer   no-undo .
     1079       define variable v-count-fld      as integer   no-undo .
     1080       define variable v-inform         as character no-undo .
     1081       define variable v-ind            as integer   no-undo .
     1082       define variable v-idx-field-qnty as integer   no-undo .
     1083       define variable v-delim-key      as character no-undo .
     1084       if p-key-rec = ?
     1085         or p-key-rec = "":U
     1086       then do:
     1087         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
     1088       end.
     1089       assign
     1090         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1091         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1092       .
     1093       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1094       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info6 ).
     1095       assign
     1096         v-inform = bh_tbl-name:index-information(1)
     1097         v-ind    = 2
     1098       .
     1099       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1100       on error undo, return error
     1101       :
     1102         assign
     1103           v-inform = bh_tbl-name:index-information( v-ind )
     1104           v-ind    = v-ind + 1
     1105         .
     1106       end.
     1107       if v-inform = ?
     1108         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1109         or entry( 3, v-inform, ",":U ) <> "1":U
     1110       then do:
     1111         delete object bh_tbl-name no-error.
     1112         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
     1113       end.
     1114       assign
     1115         v-idx-field-qnty = num-entries( v-inform ) - 4
     1116       .
     1117       if v-idx-field-qnty < 2 then do:
     1118         delete object bh_tbl-name no-error.
     1119         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
     1120       end.
     1121       assign
     1122         p-field-list = "":U
     1123         p-value-list = "":U
     1124         v-delim-key  = "":U
     1125         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1126         v-count-fld  = 0
     1127       .
     1128       block_where:
     1129       do v-ind = 1 to v-idx-field-qnty by 2
     1130       on error undo, return error
     1131       :
     1132         assign
     1133           v-count-fld = v-count-fld + 1
     1134         .
     1135         if v-count-fld > v-field-num then do:
     1136           leave block_where.
     1137         end.
     1138         assign
     1139           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1140           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1141         .
     1142         if v-ind = 1 then do:
     1143           assign
     1144             v-delim-key = chr(3)
     1145           .
     1146         end.
     1147       end.
     1148       delete object bh_tbl-name.
     1149       if v-count-fld <> v-field-num then do:
     1150         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info6, v-tbl-name ).
     1151       end.
     1152     end.
     1153   end procedure.
     1154   procedure gen-key-field :
     1155     define input  parameter p-table      as character no-undo .
     1156     define output parameter p-field-list as character no-undo .
     1157     do
     1158     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1159     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1160     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1161     :
     1162       define variable v-full-tbl-name  as character no-undo .
     1163       define variable bh_tbl-name      as handle    no-undo .
     1164       define variable v-tbl-name       as character no-undo .
     1165       define variable v-field-num      as integer   no-undo .
     1166       define variable v-count-fld      as integer   no-undo .
     1167       define variable v-inform         as character no-undo .
     1168       define variable v-ind            as integer   no-undo .
     1169       define variable v-idx-field-qnty as integer   no-undo .
     1170       define variable v-delim-key      as character no-undo .
     1171       if p-table = ?
     1172         or p-table = "":U
     1173       then do:
     1174         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info6 ).
     1175       end.
     1176       assign
     1177         v-tbl-name      = p-table
     1178         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1179       .
     1180       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1181       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info6 ).
     1182       assign
     1183         v-inform = bh_tbl-name:index-information(1)
     1184         v-ind    = 2
     1185       .
     1186       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1187       on error undo, return error
     1188       :
     1189         assign
     1190           v-inform = bh_tbl-name:index-information( v-ind )
     1191           v-ind    = v-ind + 1
     1192         .
     1193       end.
     1194       if v-inform = ?
     1195         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1196         or entry( 3, v-inform, ",":U ) <> "1":U
     1197       then do:
     1198         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
     1199       end.
     1200       assign
     1201         v-idx-field-qnty = num-entries( v-inform ) - 4
     1202       .
     1203       if v-idx-field-qnty < 2 then do:
     1204         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
     1205       end.
     1206       assign
     1207         p-field-list = "":U
     1208         v-delim-key  = "":U
     1209         v-count-fld  = 0
     1210       .
     1211       block_where:
     1212       do v-ind = 1 to v-idx-field-qnty by 2
     1213       on error undo, return error
     1214       :
     1215         assign
     1216           v-count-fld = v-count-fld + 1
     1217         .
     1218         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1219         if v-ind = 1 then do:
     1220           assign
     1221             v-delim-key = chr(3)
     1222           .
     1223         end.
     1224       end.
     1225       delete object bh_tbl-name.
     1226     end.
     1227   end procedure.
     1228   define temp-table tt-objs no-undo
     1229       field obj-type          like ub.clients.obj-type
     1230       field obj-code          like ub.clients.obj-code
     1231       field obj-name-th       as character label "Наименование в TH"
     1232       field obj-name-egais    as character label "Наименование ЕГАИС"
     1233       field regID             as character label "Регистрационный номер"
     1234       field inn               as character label "ИНН"
     1235       field kpp               as character label "КПП"
     1236       field country           as character label "Код страны"
     1237       field regionCode        as character label "Код региона"
     1238       field district          as character label "Район"
     1239       field city              as character label "Город"
     1240       field settlement        as character label "Населенный пункт"
     1241       field street            as character label "Улица"
     1242       field house-number      as character label "Номер дома"
     1243       field house-case        as character label "Корпус"
     1244       field house-apartment   as character label "Номер квартиры"
     1245       field house-litera      as character label "Литера"
     1246       field postIndex         as character label "Почтовый индекс"
     1247       field description_      as character label "Адрес"
     1248       field fromEgais         as logical
     1249       field connected_        as logical
     1250       field versionWB         as character format "X(10)"
     1251       field typeEgais         as character format "X(2)"
     1252       index pi as primary
     1253           obj-type obj-code
     1254       index egais
     1255           inn kpp
     1256   .
     1257   def var egais as class EGAIS.
     1258   def var bh-obj-egais as handle no-undo .
     1259   def var qh-obj-egais as handle no-undo .
     1260   define buffer buf_firm for ub.firm .
     1261   define buffer buf_clients for ub.clients .
     1262   define buffer buf_clients-attr for ub.clients-attr .
     1263   DEFINE BUFFER X_ext-classif FOR ub.ext-classif.
     1264   DEFINE BUFFER X_ext-classif-attr FOR ub.ext-classif-attr .
     1265   define variable select-list as character no-undo .
     1266   define variable ii          as integer   no-undo .
     1267   define variable v-rid       as recid     no-undo .
     1268   define variable par-alcohol as character no-undo .
     1269   define variable par-type    as character no-undo .
     1270   define variable v-kpp       as character no-undo .
     1271   define variable v-org-inn   as character no-undo .
     1272   define variable v-isSent    as logical   no-undo .
     1273   define variable v-outId     as character no-undo .
     1274   define variable v-ext-sys   as integer   no-undo .
     1275   define variable v-replyId   as character no-undo .
     1276   define variable v-regID     as character no-undo .
     1277   define variable v-obj-uniq-key-rec as character no-undo .
     1278   define variable glog        as logical no-undo .
     1279   define variable v-value-character  as character no-undo .
     1280   define variable v-value-decimal    as decimal   no-undo .
     1281   define variable v-value-integer    as integer   no-undo .
     1282   define variable v-value-logical    as logical   no-undo .
     1283   define variable v-value-type       as character no-undo .
     1284   define variable v-value-date       as date      no-undo .
     1285   FUNCTION get-mark RETURNS CHARACTER
     1286   (buffer local-obj for tt-objs ):
     1287   if lookup (string (recid (local-obj)), select-list) > 0  then return "*".
     1288                                                              else return "".
     1289   end function.
     1290   FUNCTION get-obj RETURNS CHARACTER
     1291   (buffer local-obj for tt-objs ):
     1292       return (local-obj.obj-type + string(local-obj.obj-code)) .
     1293   end function.
     1294   define variable v-org as character no-undo view-as text format "X(50)" label "Организация" .
     1295   define variable v-fs-rar as character no-undo view-as text format "X(15)" label "Код ФС РАР (FSRAR ID)" .
     1296   DEFINE BUTTON b-mark
     1297        LABEL "&*"
     1298        SIZE 3 BY 1.14 .
     1299   DEFINE BUTTON b-cancel AUTO-END-KEY
     1300        LABEL "Выход"
     1301        SIZE 15 BY 1.14
     1302        BGCOLOR 8 .
     1303   DEFINE BUTTON b-load
     1304        LABEL "Запрос"
     1305        tooltip "Отправить запрос в ЕГАИС"
     1306        SIZE 15 BY 1.14
     1307        BGCOLOR 8 .
     1308   DEFINE BUTTON b-save
     1309        LABEL "Сохранить"
     1310        tooltip "Записать данные в справочник"
     1311        SIZE 15 BY 1.14
     1312        BGCOLOR 8 .
     1313   DEFINE BUTTON b-answer
     1314        LABEL "Получить ответ"
     1315        SIZE 15 BY 1.14
     1316        BGCOLOR 8 .
     1317   DEFINE BUTTON b-lkp
     1318        LABEL "Просмотр"
     1319        SIZE 15 BY 1.14
     1320        BGCOLOR 8 .
     1321   DEFINE BUTTON b-connect
     1322        LABEL "Связать"
     1323        SIZE 15 BY 1.14
     1324        BGCOLOR 8 .
     1325   DEFINE BUTTON b-sel-all
     1326        LABEL "&+":L
     1327        SIZE 3 BY 1.14 TOOLTIP "Отметить все объекты".
     1328   DEFINE BUTTON b-unmark
     1329        LABEL "&-":L
     1330        SIZE 3 BY 1.14 TOOLTIP "Снять все отметки".
     1331   DEFINE QUERY br-objects FOR
     1332         tt-objs SCROLLING.
     1333   DEFINE BROWSE br-objects
     1334     QUERY br-objects DISPLAY
     1335       get-mark(BUFFER tt-objs) COLUMN-LABEL "*"  FORMAT "X(1)":U
     1336       tt-objs.regID COLUMN-LABEL "Регистрационный номер" FORMAT "X(21)":U
     1337       get-obj(buffer tt-objs) COLUMN-LABEL "Объект" FORMAT "X(6)":U
     1338       tt-objs.inn COLUMN-LABEL "ИНН" FORMAT "X(12)":U
     1339       tt-objs.kpp COLUMN-LABEL "КПП" FORMAT "X(9)":U
     1340       tt-objs.obj-name-th COLUMN-LABEL "Наименование в TH" FORMAT "X(100)":U width 25
     1341       tt-objs.obj-name-egais COLUMN-LABEL "Наименование ЕГАИС" FORMAT "X(100)":U width 25
     1342       tt-objs.country COLUMN-LABEL "Страна" FORMAT "X(6)":U
     1343       tt-objs.regionCode COLUMN-LABEL "Регион" FORMAT "X(6)":U
     1344       tt-objs.description_ COLUMN-LABEL "Адрес" FORMAT "X(100)":U width 87
     1345       WITH NO-ROW-MARKERS SEPARATORS SIZE 105 BY 21.5 FIT-LAST-COLUMN.
     1346   DEFINE FRAME Dialog-Frame
     1347        b-mark AT ROW 2.5 COL 2
     1348        b-sel-all AT ROW 2.5 COL 5
     1349        b-unmark AT ROW 2.5 COL 8
     1350        b-load AT ROW 1.24 COL 32
     1351        b-answer AT ROW 1.24 COL 47
     1352        b-save AT ROW 1.24 COL 17
     1353        b-lkp AT ROW 1.24 COL 62
     1354        b-cancel AT ROW 1.24 COL 2
     1355        v-org AT ROW 2.7 COL 13
     1356        v-fs-rar AT ROW 2.7 COL 65
     1357        b-connect AT ROW 1.24 COL 77
     1358        br-objects AT ROW 3.86 COL 2 WIDGET-ID 200
     1359        SPACE(1) SKIP(0.32)
     1360       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1361            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1362            TITLE "Объекты ЕГАИС"
     1363            DEFAULT-BUTTON b-load CANCEL-BUTTON b-cancel WIDGET-ID 100.
     1364   assign br-objects:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 1 .
     1365   ASSIGN
     1366          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1367          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1368   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1369   DO:
     1370     APPLY "END-ERROR":U TO SELF.
     1371   END.
     1372   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1373   DO:
     1374     run proc-b-mark in this-procedure no-error.
     1375   END.
     1376   ON CHOOSE OF b-sel-all IN FRAME Dialog-Frame
     1377   DO:
     1378     assign select-list = "".
     1379     if not available tt-objs then return.
     1380     for each tt-objs no-lock :
     1381   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1382   define variable v-str-recid8 as character no-undo .
     1383   define variable v-num-entry8 as integer   no-undo .
     1384   assign
     1385     v-str-recid8 = trim( string( recid( tt-objs ) , "->>>>>>>>>>>9":U ) )
     1386     v-num-entry8 = lookup( v-str-recid8 , select-list )
     1387   .
     1388   if v-num-entry8 > 0 then do:
     1389     assign
     1390       entry( v-num-entry8, select-list ) = "":U
     1391       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1392     .
     1393   end.
     1394   else do:
     1395     assign
     1396       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid8
     1397     .
     1398   end.
     1399     end.
     1400     br-objects:refresh() in frame Dialog-Frame .
     1401   END.
     1402   ON CHOOSE OF b-unmark IN FRAME Dialog-Frame
     1403   DO:
     1404     if not available tt-objs then return.
     1405     select-list  = "".
     1406     br-objects:refresh() in frame Dialog-Frame .
     1407   END.
     1408   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     1409   DO:
     1410       message "Все несохранённые данные будут потеряны. Вы уверены, что хотите выйти?"
     1411       view-as alert-box question buttons yes-no update glog.
     1412       if not glog then return no-apply .
     1413   END.
     1414   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     1415   DO:
     1416       if select-list = "" then do :
     1417           message "Не выбрано ни одной строки" view-as alert-box .
     1418           return no-apply.
     1419       end.
     1420       if bh-obj-egais = ? then do :
     1421           message "Сначала сделайте запрос в ЕГАИС и получите актуальную информацию" view-as alert-box .
     1422           return no-apply.
     1423       end.
     1424       do ii = 1 to num-entries(select-list) :
     1425           for first tt-objs exclusive-lock where recid(tt-objs) = integer(entry(ii, select-list)) and tt-objs.obj-code > 0 :
     1426               if tt-objs.connected_ then do :
     1427                   bh-obj-egais:find-unique (substitute("where tt-objs-EG.regID = '&1'", trim(tt-objs.regID)), no-lock) no-error.
     1428               end.
     1429               else do :
     1430                   bh-obj-egais:find-unique (substitute("where tt-objs-EG.inn = '&1' and tt-objs-EG.kpp = '&2'", trim(tt-objs.inn), trim(tt-objs.kpp)), no-lock) no-error.
     1431               end.
     1432               if bh-obj-egais:available and not bh-obj-egais:ambiguous then do :
     1433                   buffer tt-objs:handle:buffer-copy (bh-obj-egais, "obj-type,obj-code,obj-name-th") .
     1434                   find first buf_clients-attr exclusive-lock  where buf_clients-attr.obj-type = tt-objs.obj-type
     1435                                                               and   buf_clients-attr.obj-code = tt-objs.obj-code
     1436                                                               and   buf_clients-attr.attr-code = 'requisite-alc-decl':U
     1437                                                               no-error.
     1438                   if not available buf_clients-attr then do :
     1439                       create buf_clients-attr .
     1440                       assign
     1441                           buf_clients-attr.obj-type = tt-objs.obj-type
     1442                           buf_clients-attr.obj-code = tt-objs.obj-code
     1443                           buf_clients-attr.attr-code = 'requisite-alc-decl':U
     1444                       .
     1445                   end.
     1446                   buf_clients-attr.attr-value = tt-objs.obj-name-egais + "||"
     1447                                               + tt-objs.country + "|"
     1448                                               + tt-objs.postIndex + "|"
     1449                                               + tt-objs.regionCode + "|"
     1450                                               + tt-objs.district + "|"
     1451                                               + tt-objs.city + "|"
     1452                                               + tt-objs.settlement + "|"
     1453                                               + tt-objs.street + "|"
     1454                                               + tt-objs.house-number + "|"
     1455                                               + tt-objs.house-case + "|"
     1456                                               + tt-objs.house-apartment + "|"
     1457                                               + tt-objs.house-litera + "|||||||"
     1458                                               + replace(tt-objs.description_, "|", CHR(5))
     1459                   .
     1460                   if tt-objs.regID <> "" then do :
     1461                       find first buf_clients no-lock where buf_clients.obj-type = tt-objs.obj-type and buf_clients.obj-code = tt-objs.obj-code .
     1462                       run gen-key-rec in this-procedure   ( input 'clients':U
     1463                                                            ,input buffer buf_clients:handle
     1464                                                            ,output v-obj-uniq-key-rec).
     1465                       find first X_ext-classif exclusive-lock  where X_ext-classif.classif-subject = 'clients':U
     1466                                                                  and X_ext-classif.classif-name = 'clients-esys':U
     1467                                                                  AND X_ext-classif.db-num = 0
     1468                                                                  and X_ext-classif.key#_one = v-ext-sys
     1469                                                                  and X_ext-classif.key#_two = 0
     1470                                                                  and X_ext-classif.key#_three = 0
     1471                                                                  and X_eXt-classif.uniq-key-rec = v-obj-uniq-key-rec
     1472                                                                  and X_eXt-classif.CharKey_One = ''
     1473                                                                  and X_eXt-classif.CharKey_two = (tt-objs.obj-type + string(tt-objs.obj-code))
     1474                                                                  and X_eXt-classif.nonunique = 0
     1475                                                                  no-error.
     1476                       if available X_ext-classif then do :
     1477                           find first X_ext-classif-attr exclusive-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     1478                                                                          and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     1479                                                                          and X_ext-classif-attr.db-num = X_ext-classif.db-num
     1480                                                                          and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     1481                                                                          and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     1482                                                                          and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     1483                                                                          and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     1484                                                                          and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     1485                                                                          and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     1486                                                                          and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     1487                                                                          and X_ext-classif-attr.attr-code = 'egais-cli-info'
     1488                                                                          no-error .
     1489                           if not available X_ext-classif-attr then do :
     1490                               create X_ext-classif-attr .
     1491                               assign
     1492                                   X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     1493                                   X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     1494                                   X_ext-classif-attr.db-num = X_ext-classif.db-num
     1495                                   X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     1496                                   X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     1497                                   X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     1498                                   X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     1499                                   X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     1500                                   X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     1501                                   X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     1502                                   X_ext-classif-attr.attr-code = 'egais-cli-info'
     1503                               .
     1504                           end.
     1505                           assign
     1506                               X_ext-classif.charkey_three = tt-objs.regID
     1507                               X_ext-classif-attr.charkey_three = tt-objs.regID
     1508                           .
     1509                           assign X_ext-classif-attr.attr-value = tt-objs.versionWB + CHR(4) + tt-objs.typeEgais .
     1510                       end.
     1511                       else do :
     1512                           run ref/extclas1.p ( INPUT 'ДОБАВЛЕНИЕ':U
     1513                                               ,INPUT yes
     1514                                               ,INPUT-OUTPUT v-rid
     1515                                               ,INPUT 'clients':U
     1516                                               ,INPUT 'clients-esys':U
     1517                                               ,input 0
     1518                                               ,input v-ext-sys
     1519                                               ,input 0
     1520                                               ,input 0
     1521                                               ,input '':U
     1522                                               ,input (tt-objs.obj-type + string(tt-objs.obj-code))
     1523                                               ,input tt-objs.regID
     1524                                               ,input 0
     1525                                               ,input v-obj-uniq-key-rec ) no-error.
     1526                           if error-status:error then do:
     1527                             message return-value skip error-status:get-message(1) view-as alert-box .
     1528                             undo, return no-apply .
     1529                           end.
     1530                           find first X_ext-classif no-lock where recid(X_ext-classif) = v-rid.
     1531                           find first X_ext-classif-attr exclusive-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     1532                                                                          and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     1533                                                                          and X_ext-classif-attr.db-num = X_ext-classif.db-num
     1534                                                                          and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     1535                                                                          and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     1536                                                                          and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     1537                                                                          and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     1538                                                                          and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     1539                                                                          and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     1540                                                                          and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     1541                                                                          and X_ext-classif-attr.attr-code = 'egais-cli-info'
     1542                                                                          no-error .
     1543                           if not available X_ext-classif-attr then do :
     1544                               create X_ext-classif-attr .
     1545                               assign
     1546                                   X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     1547                                   X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     1548                                   X_ext-classif-attr.db-num = X_ext-classif.db-num
     1549                                   X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     1550                                   X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     1551                                   X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     1552                                   X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     1553                                   X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     1554                                   X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     1555                                   X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     1556                                   X_ext-classif-attr.attr-code = 'egais-cli-info'
     1557                               .
     1558                           end.
     1559                           assign X_ext-classif-attr.attr-value = tt-objs.versionWB + CHR(4) + tt-objs.typeEgais .
     1560                       end.
     1561                   end.
     1562               end.
     1563           end.
     1564       end.
     1565       message "Сохранение завершено" view-as alert-box.
     1566       disable b-connect WITH FRAME Dialog-Frame.
     1567       br-objects:refresh() in frame Dialog-Frame .
     1568   END.
     1569   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1570   DO:
     1571       if available tt-objs and tt-objs.obj-code <> 0 and valid-handle(bh-obj-egais) then do :
     1572           if tt-objs.connected_ then do :
     1573               bh-obj-egais:find-unique (substitute("where tt-objs-EG.regID = '&1'", trim(tt-objs.regID)), no-lock) no-error.
     1574           end.
     1575           else do :
     1576               bh-obj-egais:find-unique (substitute("where tt-objs-EG.inn = '&1' and tt-objs-EG.kpp = '&2'", trim(tt-objs.inn), trim(tt-objs.kpp)), no-lock) no-error.
     1577           end.
     1578           if bh-obj-egais:ambiguous then do :
     1579               message "В ЕГАИС более одного объекта с таким ИНН и КПП. Сначала свяжите объект" view-as alert-box.
     1580               return no-apply .
     1581           end.
     1582           if bh-obj-egais:available then do :
     1583               run bge/egais-obj-diff.w (input rowid(tt-objs), input buffer tt-objs:handle, input bh-obj-egais:handle).
     1584           end.
     1585           else do :
     1586               message "Нет различий по данному объекту" view-as alert-box.
     1587               return no-apply.
     1588           end.
     1589       end.
     1590   END.
     1591   ON CHOOSE OF b-load IN FRAME Dialog-Frame
     1592   DO:
     1593       egais:SendRequestUTM() .
     1594       if egais:IsSent then enable b-answer WITH FRAME Dialog-Frame.
     1595       else disable b-answer WITH FRAME Dialog-Frame .
     1596       if egais:StatusErr then do :
     1597           message egais:Msg view-as alert-box.
     1598           return no-apply.
     1599       end.
     1600       else do :
     1601           v-replyId = egais:ReplyId.
     1602       end.
     1603   END.
     1604   ON CHOOSE OF b-connect IN FRAME Dialog-Frame
     1605   DO:
     1606       if not available tt-objs then return no-apply .
     1607       if tt-objs.connected_ then do :
     1608           bh-obj-egais:find-unique (substitute("where tt-objs-EG.regID = '&1'", trim(tt-objs.regID)), no-lock) no-error.
     1609           assign
     1610               tt-objs.regID = ""
     1611               tt-objs.connected_ = false
     1612               b-connect:label = "Связать"
     1613           .
     1614           if bh-obj-egais:available then
     1615           assign
     1616               bh-obj-egais:buffer-field ("connected_"):buffer-value = false
     1617           .
     1618       end.
     1619       else do :
     1620           run bge/egais-select-obj.w (tt-objs.inn ,
     1621                                       tt-objs.kpp ,
     1622                                       bh-obj-egais:handle ,
     1623                                       output v-regID ) .
     1624           if v-regID <> "" and v-regID <> ? then do :
     1625               assign
     1626                   tt-objs.regID = v-regID
     1627                   tt-objs.connected_ = true
     1628               .
     1629           end.
     1630       end.
     1631       br-objects:refresh() in frame Dialog-Frame .
     1632       apply "value-changed" to br-objects IN FRAME Dialog-Frame .
     1633   END.
     1634   ON CHOOSE OF b-answer IN FRAME Dialog-Frame
     1635   DO:
     1636       bh-obj-egais = egais:GetHndlTable() .
     1637       if egais:StatusErr then do :
     1638           message egais:Msg view-as alert-box.
     1639           return no-apply.
     1640       end.
     1641       if not valid-handle(bh-obj-egais) then do :
     1642           message "Ошибка при получении ответа от ЕГАИС" view-as alert-box error .
     1643           return no-apply .
     1644       end.
     1645       OPEN QUERY br-objects FOR EACH tt-objs.
     1646       apply "value-changed" to br-objects IN FRAME Dialog-Frame .
     1647   END.
     1648   on row-display of br-objects IN FRAME Dialog-Frame
     1649   DO:
     1650       if tt-objs.obj-code = 0 then tt-objs.regID:bgcolor in browse br-objects = yellow_color .
     1651       if valid-handle(bh-obj-egais) then do :
     1652           if tt-objs.regID <> ? and tt-objs.regID <> "" then do :
     1653               bh-obj-egais:find-unique (substitute("where tt-objs-EG.regID = '&1'", trim(tt-objs.regID)), no-lock) no-error.
     1654               if bh-obj-egais:available then
     1655               assign
     1656                   tt-objs.connected_ = true
     1657                   bh-obj-egais:buffer-field ("connected_"):buffer-value = true
     1658               .
     1659           end.
     1660           else do :
     1661               bh-obj-egais:find-unique (substitute("where tt-objs-EG.inn = '&1' and tt-objs-EG.kpp = '&2'", trim(tt-objs.inn), trim(tt-objs.kpp)), no-lock) no-error.
     1662           end.
     1663           if bh-obj-egais:available then do :
     1664               if bh-obj-egais:buffer-field ("obj-name-egais"):buffer-value <> tt-objs.obj-name-egais then tt-objs.obj-name-egais:bgcolor in browse br-objects = red_color .
     1665               if bh-obj-egais:buffer-field ("regID"):buffer-value <> tt-objs.regID then tt-objs.regID:bgcolor in browse br-objects = red_color .
     1666               if bh-obj-egais:buffer-field ("country"):buffer-value <> tt-objs.country then tt-objs.country:bgcolor in browse br-objects = red_color .
     1667               if bh-obj-egais:buffer-field ("description_"):buffer-value <> tt-objs.description_ then do :
     1668                   tt-objs.description_:bgcolor in browse br-objects = red_color .
     1669                   if tt-objs.regID <> ? and tt-objs.regID <> "" then tt-objs.regID:bgcolor in browse br-objects = yellow_color .
     1670               end.
     1671               if bh-obj-egais:buffer-field ("regionCode"):buffer-value <> tt-objs.regionCode then tt-objs.regionCode:bgcolor in browse br-objects = red_color .
     1672           end.
     1673       end.
     1674   end.
     1675   on value-changed of br-objects IN FRAME Dialog-Frame
     1676   DO:
     1677       if available tt-objs and valid-handle(bh-obj-egais) then do :
     1678           if tt-objs.connected_ then do :
     1679               enable b-connect WITH FRAME Dialog-Frame.
     1680               b-connect:label = "Отвязать" .
     1681           end.
     1682           else do :
     1683               create query qh-obj-egais .
     1684               qh-obj-egais:set-buffers (bh-obj-egais) .
     1685               qh-obj-egais:query-prepare (substitute("for each tt-objs-eg where tt-objs-EG.inn = '&1' and tt-objs-EG.kpp = '&2'", trim(tt-objs.inn), trim(tt-objs.kpp)) ).
     1686               qh-obj-egais:query-open.
     1687               ii = 0 .
     1688               _repeat:
     1689               repeat:
     1690                   qh-obj-egais:get-next ().
     1691                   if qh-obj-egais:query-off-end then leave _repeat.
     1692                   ii = ii + 1 .
     1693               end.
     1694               b-connect:label = "Связать" .
     1695               if ii > 0 then enable b-connect WITH FRAME Dialog-Frame.
     1696               else do :
     1697                   qh-obj-egais:query-prepare (substitute("for each tt-objs-eg where tt-objs-EG.inn = '&1'", trim(tt-objs.inn)) ).
     1698                   qh-obj-egais:query-open.
     1699                   ii = 0 .
     1700                   _repeat:
     1701                   repeat:
     1702                       qh-obj-egais:get-next ().
     1703                       if qh-obj-egais:query-off-end then leave _repeat.
     1704                       ii = ii + 1 .
     1705                   end.
     1706                   if ii > 0 then enable b-connect WITH FRAME Dialog-Frame.
     1707                   else disable b-connect WITH FRAME Dialog-Frame.
     1708               end.
     1709           end.
     1710       end.
     1711   end.
     1712   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1713   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1714   MAIN-BLOCK:
     1715   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1716      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1717   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
