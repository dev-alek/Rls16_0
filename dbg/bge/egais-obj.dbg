     1793   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1794   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1795   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1796   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1797   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1798   define variable v-diasize-current-frame-height as decimal   no-undo .
     1799   define variable v-diasize-change-size          as logical   no-undo .
     1800   define variable v-diasize-resize-button        as handle    no-undo .
     1801   define variable v-diasize-wndmax               as logical   no-undo .
     1802   define variable v-diasize-wndstore             as logical   no-undo .
     1803   define variable v-diasize-proc-name            as character no-undo .
     1804   define variable v-diasize-browse-handle        as handle    no-undo .
     1805   define variable v-diasize-browse-number        as integer   no-undo .
     1806   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1807   define temp-table temp-diasize-handle no-undo
     1808     field handle-value  as handle
     1809     field save-position as decimal
     1810     index xpk is primary unique handle-value
     1811     .
     1812   define temp-table temp-browse-handle no-undo
     1813     field browse-type   as character
     1814     field browse-number as integer
     1815     field browse-handle as handle
     1816     field original-size as decimal
     1817     index xpk is primary unique browse-type browse-number
     1818     index xie browse-type browse-handle
     1819   .
     1820   procedure diasize_change-height :
     1821     define input  parameter p-change-value  as decimal   no-undo .
     1822     define input  parameter p-move-resize   as logical   no-undo .
     1823     define variable v-field-group-handle    as handle    no-undo .
     1824     define variable v-object-handle         as handle    no-undo .
     1825     define variable v-frame-height          as decimal   no-undo .
     1826     define variable v-frame-virtual-height  as decimal   no-undo .
     1827     define variable v-browse-height         as decimal   no-undo .
     1828     define variable v-window-height         as decimal   no-undo .
     1829     define variable v-window-virtual-height as decimal   no-undo .
     1830     define variable v-change-sign           as integer   no-undo .
     1831     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1832     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1833     if p-change-value > 0
     1834     then do:
     1835       if frame Dialog-Frame :height + p-change-value
     1836           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1837       then do:
     1838         assign
     1839           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1840                           - (frame Dialog-Frame :height-chars)
     1841         .
     1842         if p-change-value <= 0
     1843         then do:
     1844           run diasize_position-resize-button in this-procedure .
     1845           return .
     1846         end.
     1847       end.
     1848     end.
     1849     if p-change-value < 0
     1850     then do:
     1851       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1852       then do:
     1853         assign
     1854           p-change-value = v-diasize-orig-frame-height
     1855                          - (frame Dialog-Frame :height-chars)
     1856         .
     1857         if p-change-value >= 0
     1858         then do:
     1859           run diasize_position-resize-button in this-procedure .
     1860           return .
     1861         end.
     1862       end.
     1863     end.
     1864     if p-change-value >= 0
     1865     then do:
     1866       assign
     1867         v-change-sign = 1
     1868       .
     1869     end.
     1870     else do:
     1871       assign
     1872         v-change-sign = -1
     1873       .
     1874     end.
     1875     assign
     1876       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1877     .
     1878     if p-change-value = 0
     1879     then do:
     1880       run diasize_position-resize-button in this-procedure .
     1881       return .
     1882     end.
     1883     move_block:
     1884     do
     1885     on error undo move_block, retry move_block
     1886     :
     1887       if retry
     1888       then do:
     1889         do
     1890         on error undo move_block, leave move_block
     1891         :
     1892           if p-change-value > 0
     1893           then do:
     1894             for each buf_temp-diasize-handle
     1895             on error undo, next
     1896             :
     1897               assign
     1898                 v-object-handle = buf_temp-diasize-handle.handle-value
     1899               .
     1900               if v-object-handle <> v-diasize-resize-button
     1901               then do:
     1902                 assign
     1903                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1904                 .
     1905               end.
     1906             end.
     1907             assign
     1908               v-diasize-browse-handle :height = v-browse-height
     1909             .
     1910             for each buf_temp-browse-handle
     1911               where buf_temp-browse-handle.browse-type = 'height':u
     1912             on error undo, next
     1913             :
     1914               assign
     1915                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1916               .
     1917             end.
     1918             assign
     1919               frame Dialog-Frame :height = v-frame-height
     1920             .
     1921             if frame Dialog-Frame :scrollable = true
     1922             then do:
     1923               assign
     1924                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1925               .
     1926             end.
     1927             run diasize_position-resize-button in this-procedure .
     1928           end.
     1929           else do:
     1930             if frame Dialog-Frame :scrollable = true
     1931             then do:
     1932               assign
     1933                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1934               .
     1935             end.
     1936             assign
     1937               frame Dialog-Frame :height = v-frame-height
     1938             .
     1939             assign
     1940               v-diasize-browse-handle :height = v-browse-height
     1941             .
     1942             for each buf_temp-browse-handle
     1943               where buf_temp-browse-handle.browse-type = 'height':u
     1944             on error undo, next
     1945             :
     1946               assign
     1947                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1948               .
     1949             end.
     1950             for each buf_temp-diasize-handle
     1951             on error undo, next
     1952             :
     1953               assign
     1954                 v-object-handle = buf_temp-diasize-handle.handle-value
     1955               .
     1956               if v-object-handle <> v-diasize-resize-button
     1957               then do:
     1958                 assign
     1959                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1960                 .
     1961               end.
     1962             end.
     1963             run diasize_position-resize-button in this-procedure .
     1964           end.
     1965           assign
     1966             v-diasize-change-size = false
     1967           .
     1968           leave move_block .
     1969         end.
     1970       end.
     1971       assign
     1972         v-diasize-need-full-display = true
     1973       .
     1974       if v-diasize-change-size = false
     1975       then do:
     1976         assign
     1977           v-diasize-change-size = true
     1978         .
     1979       end.
     1980       else do:
     1981         return .
     1982       end.
     1983       assign
     1984         v-frame-height = frame Dialog-Frame :height
     1985         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1986         v-browse-height = v-diasize-browse-handle :height
     1987       .
     1988       for each buf_temp-browse-handle
     1989         where buf_temp-browse-handle.browse-type = 'height':u
     1990       :
     1991         assign
     1992           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1993         .
     1994       end.
     1995       for each buf_temp-diasize-handle
     1996       :
     1997         delete buf_temp-diasize-handle .
     1998       end.
     1999       assign
     2000         v-field-group-handle = frame Dialog-Frame :first-child
     2001       .
     2002       do while valid-handle(v-field-group-handle)
     2003       :
     2004         assign
     2005           v-object-handle = v-field-group-handle :first-child
     2006         .
     2007         do while valid-handle(v-object-handle)
     2008         :
     2009           if  v-object-handle <> v-diasize-browse-handle :handle
     2010           and can-query(v-object-handle, "row")
     2011           and can-query(v-object-handle, "height")
     2012           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2013           then do:
     2014             find first buf_temp-browse-handle
     2015               where buf_temp-browse-handle.browse-type   = 'height':u
     2016                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2017               no-error .
     2018             if available buf_temp-browse-handle
     2019             then do:
     2020             end.
     2021             else do:
     2022               create buf_temp-diasize-handle .
     2023               assign
     2024                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2025                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2026               .
     2027             end.
     2028           end.
     2029           assign
     2030             v-object-handle = v-object-handle :next-sibling
     2031           .
     2032         end.
     2033         assign
     2034           v-field-group-handle = v-field-group-handle :next-sibling
     2035         .
     2036       end.
     2037       do with frame Dialog-Frame
     2038       :
     2039         hide v-diasize-resize-button .
     2040         assign
     2041           v-diasize-resize-button :row    = 1
     2042           v-diasize-resize-button :column = 1
     2043         .
     2044       end.
     2045       if p-change-value > 0
     2046       then do:
     2047         if frame Dialog-Frame :scrollable = true
     2048         then do:
     2049           assign
     2050             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2051             no-error .
     2052           if error-status :error
     2053           or error-status :get-message(1) <> ""
     2054           then do:
     2055             undo move_block, retry move_block .
     2056           end.
     2057         end.
     2058         assign
     2059           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2060           no-error .
     2061         if error-status :error
     2062         or error-status :get-message(1) <> ""
     2063         then do:
     2064           undo move_block, retry move_block .
     2065         end.
     2066         assign
     2067           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2068           no-error .
     2069         if error-status :error
     2070         or error-status :get-message(1) <> ""
     2071         then do:
     2072           undo move_block, retry move_block .
     2073         end.
     2074         for each buf_temp-browse-handle
     2075           where buf_temp-browse-handle.browse-type = 'height':u
     2076         on error undo move_block, retry move_block
     2077         :
     2078           assign
     2079             buf_temp-browse-handle.browse-handle :height
     2080               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2081             no-error .
     2082           if error-status :error
     2083           or error-status :get-message(1) <> ""
     2084           then do:
     2085             undo move_block, retry move_block .
     2086           end.
     2087         end.
     2088         for each buf_temp-diasize-handle
     2089         on error undo move_block, retry move_block
     2090         :
     2091           assign
     2092             v-object-handle = buf_temp-diasize-handle.handle-value
     2093           .
     2094           if v-object-handle <> v-diasize-resize-button
     2095           then do:
     2096             assign
     2097               v-object-handle :row = v-object-handle :row + p-change-value
     2098               no-error .
     2099             if error-status :error
     2100             or error-status :get-message(1) <> ""
     2101             then do:
     2102               undo move_block, retry move_block .
     2103             end.
     2104           end.
     2105         end.
     2106       end.
     2107       else do:
     2108         for each buf_temp-diasize-handle
     2109         on error undo move_block, retry move_block
     2110         :
     2111           assign
     2112             v-object-handle = buf_temp-diasize-handle.handle-value
     2113           .
     2114           if v-object-handle <> v-diasize-resize-button
     2115           then do:
     2116             assign
     2117               v-object-handle :row = v-object-handle :row + p-change-value
     2118               no-error .
     2119             if error-status :error
     2120             or error-status :get-message(1) <> ""
     2121             then do:
     2122               undo move_block, retry move_block .
     2123             end.
     2124           end.
     2125         end.
     2126         assign
     2127           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2128           no-error .
     2129         if error-status :error
     2130         or error-status :get-message(1) <> ""
     2131         then do:
     2132           undo move_block, retry move_block .
     2133         end.
     2134         for each buf_temp-browse-handle
     2135           where buf_temp-browse-handle.browse-type = 'height':u
     2136         on error undo move_block, retry move_block
     2137         :
     2138           assign
     2139             buf_temp-browse-handle.browse-handle :height
     2140               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2141             no-error .
     2142           if error-status :error
     2143           or error-status :get-message(1) <> ""
     2144           then do:
     2145             undo move_block, retry move_block .
     2146           end.
     2147         end.
     2148         assign
     2149           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2150           no-error .
     2151         if error-status :error
     2152         or error-status :get-message(1) <> ""
     2153         then do:
     2154           undo move_block, retry move_block .
     2155         end.
     2156         if frame Dialog-Frame :scrollable = true
     2157         then do:
     2158           assign
     2159             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2160             no-error .
     2161           if error-status :error
     2162           or error-status :get-message(1) <> ""
     2163           then do:
     2164             undo move_block, retry move_block .
     2165           end.
     2166         end.
     2167       end.
     2168       if p-move-resize = true
     2169       then do:
     2170         run diasize_position-resize-button in this-procedure .
     2171       end.
     2172       if v-diasize-wndstore = true
     2173       then do:
     2174         if connected("ub") = true
     2175         then do:
     2176           define variable v-cntxt-db-num        as integer   no-undo .
     2177           define variable v-cntxt-userid        as character no-undo .
     2178           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2179                                             , OUTPUT v-cntxt-userid
     2180                                             ) .
     2181           run gbl/wndsizew.p
     2182             (input  v-cntxt-db-num
     2183             ,input  v-cntxt-userid
     2184             ,input  v-diasize-proc-name
     2185             ,input  'height':u
     2186             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2187             ) .
     2188         end.
     2189       end.
     2190     end.
     2191     assign
     2192       v-diasize-change-size = false
     2193     .
     2194   end procedure.
     2195   procedure diasize_set-height :
     2196     define input  parameter p-new-height  as decimal   no-undo .
     2197     define input  parameter p-move-resize as logical   no-undo .
     2198     do
     2199     on error undo, return error return-value
     2200     :
     2201       run diasize_change-height in this-procedure
     2202         (input  (p-new-height - frame Dialog-Frame :height)
     2203         ,input  p-move-resize
     2204         ) .
     2205     end.
     2206   end procedure.
     2207   procedure diasize_change-width :
     2208     define input  parameter p-change-value as decimal   no-undo .
     2209     define input  parameter p-move-resize  as logical   no-undo .
     2210     define variable v-field-group-handle   as handle    no-undo .
     2211     define variable v-object-handle        as handle    no-undo .
     2212     define variable v-frame-width          as decimal   no-undo .
     2213     define variable v-frame-virtual-width  as decimal   no-undo .
     2214     define variable v-browse-width         as decimal   no-undo .
     2215     define variable v-window-width         as decimal   no-undo .
     2216     define variable v-window-virtual-width as decimal   no-undo .
     2217     define variable v-change-sign          as integer   no-undo .
     2218     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2219     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2220     if p-change-value > 0
     2221     then do:
     2222       if frame Dialog-Frame :width + p-change-value >
     2223           session :width-chars
     2224       then do:
     2225         assign
     2226           p-change-value = session :width-chars - frame Dialog-Frame :width
     2227         .
     2228         if p-change-value <= 0
     2229         then do:
     2230           run diasize_position-resize-button in this-procedure .
     2231           return .
     2232         end.
     2233       end.
     2234     end.
     2235     if p-change-value < 0
     2236     then do:
     2237       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2238       then do:
     2239         assign
     2240           p-change-value = v-diasize-orig-frame-width
     2241                          - frame Dialog-Frame :width
     2242         .
     2243         if p-change-value >= 0
     2244         then do:
     2245           run diasize_position-resize-button in this-procedure .
     2246           return .
     2247         end.
     2248       end.
     2249     end.
     2250     if p-change-value >= 0
     2251     then do:
     2252       assign
     2253         v-change-sign = 1
     2254       .
     2255     end.
     2256     else do:
     2257       assign
     2258         v-change-sign = -1
     2259       .
     2260     end.
     2261     assign
     2262       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2263     .
     2264     if p-change-value = 0
     2265     then do:
     2266       run diasize_position-resize-button in this-procedure .
     2267       return .
     2268     end.
     2269     move_block:
     2270     do
     2271     on error undo move_block, leave move_block
     2272     :
     2273       if retry
     2274       then do:
     2275         do
     2276         on error undo move_block, leave move_block
     2277         :
     2278           if p-change-value > 0
     2279           then do:
     2280             for each buf_temp-diasize-handle
     2281             on error undo, next
     2282             :
     2283               assign
     2284                 v-object-handle = buf_temp-diasize-handle.handle-value
     2285               .
     2286               if v-object-handle <> v-diasize-resize-button
     2287               then do:
     2288                 assign
     2289                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2290                 .
     2291               end.
     2292             end.
     2293             assign
     2294               v-diasize-browse-handle :width = v-browse-width
     2295             .
     2296             for each buf_temp-browse-handle
     2297               where buf_temp-browse-handle.browse-type = 'width':u
     2298             on error undo, next
     2299             :
     2300               assign
     2301                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2302               .
     2303             end.
     2304             assign
     2305               frame Dialog-Frame :width = v-frame-width
     2306             .
     2307             if frame Dialog-Frame :scrollable = true
     2308             then do:
     2309               assign
     2310                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2311               .
     2312             end.
     2313             run diasize_position-resize-button in this-procedure .
     2314           end.
     2315           else do:
     2316             if frame Dialog-Frame :scrollable = true
     2317             then do:
     2318               assign
     2319                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2320               .
     2321             end.
     2322             assign
     2323               frame Dialog-Frame :width = v-frame-width
     2324             .
     2325             for each buf_temp-browse-handle
     2326               where buf_temp-browse-handle.browse-type = 'width':u
     2327             on error undo, next
     2328             :
     2329               assign
     2330                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2331               .
     2332             end.
     2333             assign
     2334               v-diasize-browse-handle :width = v-browse-width
     2335             .
     2336             for each buf_temp-diasize-handle
     2337             on error undo, next
     2338             :
     2339               assign
     2340                 v-object-handle = buf_temp-diasize-handle.handle-value
     2341               .
     2342               if v-object-handle <> v-diasize-resize-button
     2343               then do:
     2344                 assign
     2345                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2346                 .
     2347               end.
     2348             end.
     2349             run diasize_position-resize-button in this-procedure .
     2350           end.
     2351           assign
     2352             v-diasize-change-size = false
     2353           .
     2354           leave move_block .
     2355         end.
     2356       end.
     2357       assign
     2358         v-diasize-need-full-display = true
     2359       .
     2360       if v-diasize-change-size = false
     2361       then do:
     2362         assign
     2363           v-diasize-change-size = true
     2364         .
     2365       end.
     2366       else do:
     2367         return .
     2368       end.
     2369       assign
     2370         v-frame-width = frame Dialog-Frame :width
     2371         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2372         v-browse-width = v-diasize-browse-handle :width
     2373       .
     2374       for each buf_temp-browse-handle
     2375         where buf_temp-browse-handle.browse-type = 'width':u
     2376       :
     2377         assign
     2378           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2379         .
     2380       end.
     2381       for each buf_temp-diasize-handle
     2382       :
     2383         delete buf_temp-diasize-handle .
     2384       end.
     2385       assign
     2386         v-field-group-handle = frame Dialog-Frame :first-child
     2387       .
     2388       do while valid-handle(v-field-group-handle)
     2389       :
     2390         assign
     2391           v-object-handle = v-field-group-handle :first-child
     2392         .
     2393         do while valid-handle(v-object-handle)
     2394         :
     2395           if  v-object-handle <> v-diasize-browse-handle :handle
     2396           and v-object-handle <> v-diasize-resize-button
     2397           and can-query(v-object-handle, "row")
     2398           and can-query(v-object-handle, "height")
     2399           and ( v-object-handle :col + v-object-handle :width
     2400                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2401               )
     2402           then do:
     2403             find first buf_temp-browse-handle
     2404               where buf_temp-browse-handle.browse-type   = 'width':u
     2405                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2406               no-error .
     2407             if available buf_temp-browse-handle
     2408             then do:
     2409             end.
     2410             else do:
     2411               create buf_temp-diasize-handle .
     2412               assign
     2413                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2414                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2415               .
     2416             end.
     2417           end.
     2418           assign
     2419             v-object-handle = v-object-handle :next-sibling
     2420           .
     2421         end.
     2422         assign
     2423           v-field-group-handle = v-field-group-handle :next-sibling
     2424         .
     2425       end.
     2426       do with frame Dialog-Frame
     2427       :
     2428         hide v-diasize-resize-button .
     2429         v-diasize-resize-button :row = 1.
     2430         v-diasize-resize-button :column = 1.
     2431       end.
     2432       if p-change-value > 0
     2433       then do:
     2434         if frame Dialog-Frame :scrollable = true
     2435         then do:
     2436           assign
     2437             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2438             no-error .
     2439           if error-status :error
     2440           or error-status :get-message(1) <> ""
     2441           then do:
     2442             undo move_block, retry move_block.
     2443           end.
     2444         end.
     2445         assign
     2446           frame Dialog-Frame :width = v-frame-width + p-change-value
     2447           no-error .
     2448         if error-status :error
     2449         or error-status :get-message(1) <> ""
     2450         then do:
     2451           undo move_block, retry move_block.
     2452         end.
     2453         assign
     2454           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2455         no-error .
     2456         if error-status :error
     2457         or error-status :get-message(1) <> ""
     2458         then do:
     2459           undo move_block, retry move_block.
     2460         end.
     2461         for each buf_temp-browse-handle
     2462           where buf_temp-browse-handle.browse-type = 'width':u
     2463         on error undo move_block, retry move_block
     2464         :
     2465           assign
     2466             buf_temp-browse-handle.browse-handle :width
     2467               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2468             no-error .
     2469           if error-status :error
     2470           or error-status :get-message(1) <> ""
     2471           then do:
     2472             undo move_block, retry move_block .
     2473           end.
     2474         end.
     2475         for each buf_temp-diasize-handle
     2476         on error undo move_block, retry move_block
     2477         :
     2478           assign
     2479             v-object-handle = buf_temp-diasize-handle.handle-value
     2480           .
     2481           if v-object-handle <> v-diasize-resize-button
     2482           then do:
     2483             assign
     2484               v-object-handle :col = v-object-handle :col + p-change-value
     2485               no-error .
     2486             if error-status :error
     2487             or error-status :get-message(1) <> ""
     2488             then do:
     2489               undo move_block, retry move_block .
     2490             end.
     2491           end.
     2492         end.
     2493       end.
     2494       else do:
     2495         for each buf_temp-diasize-handle
     2496         on error undo move_block, retry move_block
     2497         :
     2498           assign
     2499             v-object-handle = buf_temp-diasize-handle.handle-value
     2500           .
     2501           if v-object-handle <> v-diasize-resize-button
     2502           then do:
     2503             assign
     2504               v-object-handle :col = v-object-handle :col + p-change-value
     2505               no-error .
     2506             if error-status :error
     2507             or error-status :get-message(1) <> ""
     2508             then do:
     2509               undo move_block, retry move_block .
     2510             end.
     2511           end.
     2512         end.
     2513         for each buf_temp-browse-handle
     2514           where buf_temp-browse-handle.browse-type = 'width':u
     2515         on error undo move_block, retry move_block
     2516         :
     2517           assign
     2518             buf_temp-browse-handle.browse-handle :width
     2519               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2520             no-error .
     2521           if error-status :error
     2522           or error-status :get-message(1) <> ""
     2523           then do:
     2524             undo move_block, retry move_block .
     2525           end.
     2526         end.
     2527         assign
     2528           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2529           no-error .
     2530         if error-status :error
     2531         or error-status :get-message(1) <> ""
     2532         then do:
     2533           undo move_block, retry move_block.
     2534         end.
     2535         assign
     2536           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2537         no-error .
     2538         if error-status :error
     2539         or error-status :get-message(1) <> ""
     2540         then do:
     2541           undo move_block, retry move_block.
     2542         end.
     2543         if frame Dialog-Frame :scrollable = true
     2544         then do:
     2545           assign
     2546             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2547           no-error .
     2548           if error-status :error
     2549           or error-status :get-message(1) <> ""
     2550           then do:
     2551             undo move_block, retry move_block.
     2552           end.
     2553         end.
     2554       end.
     2555       if p-move-resize
     2556       then do:
     2557         run diasize_position-resize-button in this-procedure .
     2558       end.
     2559       if v-diasize-wndstore = true
     2560       then do:
     2561         if connected("ub") = true
     2562         then do:
     2563           define variable v-cntxt-db-num        as integer   no-undo .
     2564           define variable v-cntxt-userid        as character no-undo .
     2565           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2566                                             , OUTPUT v-cntxt-userid
     2567                                             ) .
     2568           run gbl/wndsizew.p
     2569             (input  v-cntxt-db-num
     2570             ,input  v-cntxt-userid
     2571             ,input  v-diasize-proc-name
     2572             ,input  'width':u
     2573             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2574             ) .
     2575         end.
     2576       end.
     2577     end.
     2578     assign
     2579       v-diasize-change-size = false
     2580     .
     2581   end procedure.
     2582   procedure diasize_set-width :
     2583     define input  parameter p-new-width  as decimal   no-undo .
     2584     define input  parameter p-move-resize as logical   no-undo .
     2585     do
     2586     on error undo, return error return-value
     2587     :
     2588       run diasize_change-width in this-procedure
     2589         (input  (p-new-width - frame Dialog-Frame :width)
     2590         ,input  p-move-resize
     2591         ) .
     2592     end.
     2593   end procedure.
     2594   procedure diasize_position-resize-button :
     2595     do with frame Dialog-Frame
     2596     :
     2597       hide v-diasize-resize-button .
     2598       assign
     2599         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2600                     - 1
     2601                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2602         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2603                     - 1
     2604                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2605       .
     2606       view v-diasize-resize-button .
     2607     end.
     2608   end procedure.
     2609   on alt-right anywhere
     2610   do:
     2611     run diasize_change-width in this-procedure
     2612       (input 1
     2613       ,input true
     2614       ) .
     2615     return no-apply .
     2616   end.
     2617   on alt-left anywhere
     2618   do:
     2619     run diasize_change-width in this-procedure
     2620       (input -1
     2621       ,input true
     2622       ) .
     2623     return no-apply .
     2624   end.
     2625   on alt-down anywhere
     2626   do:
     2627     run diasize_change-height in this-procedure
     2628       (input 1
     2629       ,input true
     2630       ) .
     2631     return no-apply .
     2632   end.
     2633   on alt-up anywhere
     2634   do:
     2635     run diasize_change-height in this-procedure
     2636       (input -1
     2637       ,input true
     2638       ) .
     2639     return no-apply .
     2640   end.
     2641   on alt-enter of frame Dialog-Frame
     2642   do:
     2643     run diasize_maximize in this-procedure
     2644       (input  ?
     2645       ).
     2646     return no-apply .
     2647   end.
     2648   procedure diasize_end-move :
     2649     do
     2650     on error undo, return error return-value
     2651     :
     2652       define variable v-row-delta as decimal   no-undo .
     2653       define variable v-col-delta as decimal   no-undo .
     2654       define variable v-new-row as decimal   no-undo .
     2655       define variable v-new-col as decimal   no-undo .
     2656       assign
     2657         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2658         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2659       .
     2660       assign
     2661         v-row-delta = v-new-row - frame Dialog-Frame :height
     2662         v-col-delta = v-new-col - frame Dialog-Frame :width
     2663       .
     2664       run diasize_change-height in this-procedure
     2665         (input v-row-delta
     2666         ,input true
     2667         ) .
     2668       run diasize_change-width in this-procedure
     2669         (input v-col-delta
     2670         ,input true
     2671         ) .
     2672     end.
     2673   end procedure.
     2674   procedure diasize_maximize :
     2675     define input  parameter p-action as logical   no-undo .
     2676     do
     2677     on error undo, return error return-value
     2678     :
     2679       if p-action = ?
     2680       then do:
     2681         if v-diasize-need-maximize = true
     2682         then do:
     2683           assign
     2684             p-action = true
     2685           .
     2686         end.
     2687         else do:
     2688           assign
     2689             p-action = false
     2690           .
     2691         end.
     2692       end.
     2693       if p-action = true
     2694       then do:
     2695         run diasize_change-height in this-procedure
     2696           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2697               - frame Dialog-Frame :height-chars
     2698           ,input true
     2699           ) .
     2700         run diasize_change-width in this-procedure
     2701           (input session :width-chars
     2702               - frame Dialog-Frame :width-chars
     2703           ,input true
     2704           ) .
     2705         assign
     2706           v-diasize-need-maximize = false
     2707         .
     2708       end.
     2709       else do:
     2710         run diasize_change-width in this-procedure
     2711           (input v-diasize-orig-frame-width
     2712               - frame Dialog-Frame :width-chars
     2713           ,input true
     2714           ) .
     2715         run diasize_change-height in this-procedure
     2716           (input v-diasize-orig-frame-height
     2717               - frame Dialog-Frame :height-chars
     2718           ,input true
     2719           ) .
     2720         assign
     2721           v-diasize-need-maximize = true
     2722         .
     2723       end.
     2724     end.
     2725   end procedure.
     2726   procedure diasize_restore-orig-size :
     2727     do
     2728     on error undo, return error return-value
     2729     :
     2730       assign
     2731         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2732         v-diasize-current-frame-height = frame Dialog-Frame :height
     2733       .
     2734       run diasize_set-height in this-procedure
     2735         (input  v-diasize-orig-frame-height
     2736         ,input  true
     2737         ) .
     2738       run diasize_set-width in this-procedure
     2739         (input  v-diasize-orig-frame-width
     2740         ,input  true
     2741         ) .
     2742     end.
     2743   end procedure.
     2744   procedure diasize_restore-current-size :
     2745     do
     2746     on error undo, return error return-value
     2747     :
     2748       run diasize_set-height in this-procedure
     2749         (input  v-diasize-current-frame-height
     2750         ,input  true
     2751         ) .
     2752       run diasize_set-width in this-procedure
     2753         (input  v-diasize-current-frame-width
     2754         ,input  true
     2755         ) .
     2756     end.
     2757   end procedure.
     2758   procedure diasize_set-browse-handle :
     2759     define input  parameter p-browse-handle as handle   no-undo .
     2760     define buffer buf_temp-browse-handle for temp-browse-handle .
     2761     do
     2762     on error undo, return error return-value
     2763     :
     2764       assign
     2765         v-diasize-browse-handle = p-browse-handle
     2766       .
     2767       for each buf_temp-browse-handle
     2768       on error undo, return error return-value
     2769       :
     2770         delete buf_temp-browse-handle .
     2771       end.
     2772     end.
     2773   end procedure.
     2774   procedure diasize_add_browse :
     2775     define input  parameter p-browse-type   as character no-undo .
     2776     define input  parameter p-browse-handle as handle    no-undo .
     2777     define buffer buf_temp-browse-handle for temp-browse-handle .
     2778     do
     2779     on error undo, return error return-value
     2780     :
     2781       assign
     2782         v-diasize-browse-number = v-diasize-browse-number + 1
     2783       .
     2784       create buf_temp-browse-handle .
     2785       assign
     2786         buf_temp-browse-handle.browse-type   = p-browse-type
     2787         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2788         buf_temp-browse-handle.browse-handle = p-browse-handle
     2789       .
     2790     end.
     2791   end procedure.
     2792   procedure diasize_init :
     2793     define variable v-default-value    as logical   no-undo .
     2794     define variable v-restore-saved    as logical   no-undo .
     2795     define variable v-resize-value-str as character no-undo .
     2796     do
     2797     on error undo, return error return-value
     2798     :
     2799       do with frame Dialog-Frame
     2800       :
     2801         assign
     2802           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2803           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2804           v-diasize-browse-handle     = browse br-objects :handle
     2805         .
     2806         create button v-diasize-resize-button
     2807         assign
     2808           parent        = frame Dialog-Frame :first-child
     2809           label         = "s"
     2810           height-pixels = 16
     2811           width-pixels  = 16
     2812           visible       = true
     2813           sensitive     = true
     2814           movable       = true
     2815           triggers:
     2816             on end-move persistent run diasize_end-move in this-procedure .
     2817           end triggers.
     2818         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2819         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2820         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2821         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2822         assign
     2823           v-diasize-wndmax = false
     2824         .
     2825         if connected("ub") = true
     2826         then do:
     2827           define variable v-cntxt-db-num        as integer   no-undo .
     2828           define variable v-cntxt-userid        as character no-undo .
     2829           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2830                                             , OUTPUT v-cntxt-userid
     2831                                             ) .
     2832           run gbl/wndpar_r.p
     2833             (input  v-cntxt-db-num
     2834             ,input  v-cntxt-userid
     2835             ,input  'wndmax':U
     2836             ,output v-diasize-wndmax
     2837             ,output v-default-value
     2838             ) .
     2839         end.
     2840         assign
     2841           v-diasize-wndstore = false
     2842         .
     2843         if connected("ub") = true
     2844         then do:
     2845           run gbl/wndpar_r.p
     2846             (input  v-cntxt-db-num
     2847             ,input  v-cntxt-userid
     2848             ,input  'wndstore':U
     2849             ,output v-diasize-wndstore
     2850             ,output v-default-value
     2851             ) .
     2852         end.
     2853         assign
     2854           v-diasize-proc-name = entry(1, program-name(2), '.')
     2855         .
     2856         if v-diasize-wndstore = true
     2857         then do:
     2858           assign
     2859             v-restore-saved = false
     2860           .
     2861           if connected("ub") = true
     2862           then do:
     2863             run gbl/wndsizer.p
     2864               (input  v-cntxt-db-num
     2865               ,input  v-cntxt-userid
     2866               ,input  v-diasize-proc-name
     2867               ,input  'height':u
     2868               ,output v-resize-value-str
     2869               ) .
     2870             if v-resize-value-str <> '':U
     2871             then do:
     2872               run diasize_change-height in this-procedure
     2873                 (input  integer(v-resize-value-str)
     2874                 ,input  true
     2875                 ) .
     2876               assign
     2877                 v-restore-saved = true
     2878               .
     2879             end.
     2880           end.
     2881           if connected("ub") = true
     2882           then do:
     2883             run gbl/wndsizer.p
     2884               (input  v-cntxt-db-num
     2885               ,input  v-cntxt-userid
     2886               ,input  v-diasize-proc-name
     2887               ,input  'width':u
     2888               ,output v-resize-value-str
     2889               ) .
     2890             if v-resize-value-str <> '':U
     2891             then do:
     2892               run diasize_change-width in this-procedure
     2893                 (input  integer(v-resize-value-str)
     2894                 ,input  true
     2895                 ) .
     2896               assign
     2897                 v-restore-saved = true
     2898               .
     2899             end.
     2900           end.
     2901           if v-restore-saved <> true
     2902           then do:
     2903             if v-diasize-wndmax = true
     2904             then do:
     2905               run diasize_maximize in this-procedure
     2906                 (input  true
     2907                 ) .
     2908             end.
     2909           end.
     2910         end.
     2911         else do:
     2912           if v-diasize-wndmax = true
     2913           then do:
     2914             run diasize_maximize in this-procedure
     2915               (input  true
     2916               ) .
     2917           end.
     2918         end.
     2919       end.
     2920     end.
     2921   end procedure.
     2922   procedure diasize_need-full-display :
     2923     define output parameter p-need-full-display as logical   no-undo .
     2924     do
     2925     on error undo, return error return-value
     2926     :
     2927       assign
     2928         p-need-full-display = v-diasize-need-full-display
     2929       .
     2930       assign
     2931         v-diasize-need-full-display = false
     2932       .
     2933     end.
     2934   end procedure.
     2935   procedure get-context :
     2936      define output parameter p-db-num as integer          no-undo.
     2937      define output parameter p-user-id as character        no-undo.
     2938      define variable v-login               as character    no-undo.
     2939      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2940      define buffer buf_user-login  for ub.user-login .
     2941      do
     2942      on error undo, return error
     2943      :
     2944            FIND FIRST buf_sys-ctrl no-lock.
     2945            ASSIGN
     2946               v-login = USERID("ub")
     2947               p-db-num = buf_sys-ctrl.db-num
     2948            .
     2949            FIND FIRST buf_user-login
     2950                 WHERE buf_user-login.db-num = p-db-num
     2951                   AND buf_user-login.user-login = v-login
     2952                 no-lock
     2953                 no-error
     2954                 .
     2955            IF AVAILABLE buf_user-login
     2956            THEN DO:
     2957               assign
     2958                  p-user-id = buf_user-login.user-id
     2959               .
     2960            END.
     2961      end.
     2962   end procedure.
     2963     run diasize_init in this-procedure .
     2964     RUN enable_UI.
     2965     WAIT-FOR GO OF FRAME Dialog-Frame.
     2966   END.
     2967   RUN disable_UI.
     2968   PROCEDURE proc-b-mark :
     2969     define variable varlog as logical   no-undo .
     2970     if not available tt-objs then return.
     2971     run local-mark in this-procedure.
     2972     assign varlog = br-objects :select-next-row( ) in frame Dialog-Frame.
     2973     apply "ENTRY":U to br-objects in frame Dialog-Frame.
     2974     br-objects:refresh() in frame Dialog-Frame .
     2975   END PROCEDURE.
     2976   PROCEDURE local-mark :
     2977     if not available tt-objs then do:
     2978       message "Неправильный выбор строки.".
     2979       return no-apply.
     2980     end.
     2981   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2982   define variable v-str-recid13 as character no-undo .
     2983   define variable v-num-entry13 as integer   no-undo .
     2984   assign
     2985     v-str-recid13 = trim( string( recid( tt-objs ) , "->>>>>>>>>>>9":U ) )
     2986     v-num-entry13 = lookup( v-str-recid13 , select-list )
     2987   .
     2988   if v-num-entry13 > 0 then do:
     2989     assign
     2990       entry( v-num-entry13, select-list ) = "":U
     2991       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2992     .
     2993   end.
     2994   else do:
     2995     assign
     2996       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid13
     2997     .
     2998   end.
     2999     br-objects:refresh() in frame Dialog-Frame .
     3000   END PROCEDURE.
     3001   PROCEDURE fill-tt :
     3002       for each tt-objs :
     3003           delete tt-objs .
     3004       end.
     3005       for each buf_clients no-lock
     3006          where buf_clients.host-code = v-cntxt-host-code-obj :
     3007   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3008     (input  'alcohol'
     3009     ,input  buf_clients.host-code
     3010     ,input  buf_clients.obj-type
     3011     ,input  buf_clients.obj-code
     3012     ,input  ''
     3013     ,input  ''
     3014     ,input  ''
     3015     ,input  no
     3016     ,output par-alcohol
     3017     ,output par-type
     3018     ) no-error .
     3019    .
     3020           if par-alcohol = "yes" then do :
     3021               find first buf_firm no-lock where buf_firm.firm-code = buf_clients.host-code no-error .
     3022               RUN clntattr-value IN THIS-PROCEDURE
     3023                   (INPUT buf_clients.obj-type,
     3024                    INPUT buf_clients.obj-code,
     3025                    input 'kpp':U,
     3026                    OUTPUT v-kpp,
     3027                    OUTPUT par-type).
     3028               create tt-objs.
     3029               assign
     3030                   tt-objs.obj-type            = buf_clients.obj-type
     3031                   tt-objs.obj-code            = buf_clients.obj-code
     3032                   tt-objs.obj-name-th         = buf_clients.obj-name
     3033                   tt-objs.inn                 = if available buf_firm then buf_firm.inn else ""
     3034                   tt-objs.kpp                 = v-kpp
     3035               .
     3036               run gen-key-rec in this-procedure   ( input 'clients':U
     3037                                                    ,input buffer buf_clients:handle
     3038                                                    ,output v-obj-uniq-key-rec).
     3039               find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'clients':U
     3040                                                  and X_ext-classif.classif-name = 'clients-esys':U
     3041                                                  AND X_ext-classif.db-num = 0
     3042                                                  and X_ext-classif.key#_one = v-ext-sys
     3043                                                  and X_ext-classif.key#_two = 0
     3044                                                  and X_ext-classif.key#_three = 0
     3045                                                  and X_eXt-classif.uniq-key-rec = v-obj-uniq-key-rec
     3046                                                  and X_eXt-classif.CharKey_One = ''
     3047                                                  and X_eXt-classif.CharKey_two = (tt-objs.obj-type + string(tt-objs.obj-code))
     3048                                                  and X_eXt-classif.nonunique = 0
     3049                                                  no-error.
     3050               if available X_ext-classif then do :
     3051                   assign tt-objs.regID = X_ext-classif.charkey_three .
     3052               end.
     3053               find first buf_clients-attr no-lock where buf_clients-attr.obj-type = buf_clients.obj-type
     3054                                                   and   buf_clients-attr.obj-code = buf_clients.obj-code
     3055                                                   and   buf_clients-attr.attr-code = 'requisite-alc-decl':U no-error.
     3056               if available buf_clients-attr then do :
     3057                   assign
     3058                       tt-objs.obj-name-egais      = entry( 1, buf_clients-attr.attr-value, "|")
     3059                       tt-objs.country             = entry( 3, buf_clients-attr.attr-value, "|")
     3060                       tt-objs.postIndex           = entry( 4, buf_clients-attr.attr-value, "|")
     3061                       tt-objs.regionCode          = entry( 5, buf_clients-attr.attr-value, "|")
     3062                       tt-objs.district            = entry( 6, buf_clients-attr.attr-value, "|")
     3063                       tt-objs.city                = entry( 7, buf_clients-attr.attr-value, "|")
     3064                       tt-objs.settlement          = entry( 8, buf_clients-attr.attr-value, "|")
     3065                       tt-objs.street              = entry( 9, buf_clients-attr.attr-value, "|")
     3066                       tt-objs.house-number        = entry(10, buf_clients-attr.attr-value, "|")
     3067                       tt-objs.house-case          = entry(11, buf_clients-attr.attr-value, "|")
     3068                       tt-objs.house-apartment     = entry(12, buf_clients-attr.attr-value, "|")
     3069                       tt-objs.house-litera        = entry(13, buf_clients-attr.attr-value, "|")
     3070                       no-error
     3071                   .
     3072                   assign tt-objs.description_ = replace(entry(20, buf_clients-attr.attr-value, "|"), CHR(5), "|") no-error .
     3073               end.
     3074           end.
     3075       end.
     3076   END PROCEDURE.
     3077   PROCEDURE disable_UI :
     3078     HIDE FRAME Dialog-Frame.
     3079   END PROCEDURE.
     3080   PROCEDURE enable_UI :
     3081     display v-org v-fs-rar with frame Dialog-Frame.
     3082     ENABLE b-mark b-sel-all b-unmark b-load b-answer b-save b-lkp b-cancel br-objects
     3083         WITH FRAME Dialog-Frame.
     3084     VIEW FRAME Dialog-Frame.
     3085     br-objects:column-resizable in frame Dialog-Frame = true .
     3086     if egais:IsSent then enable b-answer WITH FRAME Dialog-Frame.
     3087     else disable b-answer WITH FRAME Dialog-Frame .
     3088     OPEN QUERY br-objects FOR EACH tt-objs.
     3089   END PROCEDURE.
