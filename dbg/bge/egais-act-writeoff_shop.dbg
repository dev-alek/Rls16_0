      861   procedure thbjattr_get-section :
      862   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      863   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      864   define input  parameter p-upper-param-code  like ub.thbj-attr.upper-prop-code  no-undo .
      865   define input  parameter p-mode as character no-undo .
      866   define input-output parameter table-handle p-tth.
      867   define output parameter p-all-found as decimal no-undo .
      868   do
      869   on error undo, return error return-value
      870   :
      871       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_get-section in g#attr-lib
      872       (input  p-obj-type
      873       ,input  p-obj-code
