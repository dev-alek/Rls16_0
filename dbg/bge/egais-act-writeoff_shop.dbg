     1577   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1578   define new global shared variable g#trdcalib as handle no-undo.
     1579   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1580   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1581   define variable v-waitfram-action01         as character   no-undo .
     1582   define variable v-waitfram-action02         as character   no-undo .
     1583   define variable v-waitfram-action03         as character   no-undo .
     1584   define variable mWaitFramTextBeg            as character   no-undo.
     1585   define variable mWaitFramTextEnd            as character   no-undo.
     1586   define variable mWaitFramView               as logical     no-undo.
     1587   define variable mWaitProcEvent              as logical     no-undo init yes.
     1588   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1589   define variable mWaitFramStop               as logical     no-undo.
     1590   define variable mWaitFramStopUser           as logical     no-undo.
     1591   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1592   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1593   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1594   define button B-WaitFramStop auto-end-key
     1595        label "Стоп"
     1596        size 10 by 1 tooltip "Остоновить процесс".
     1597   define button B-viewProcInfo
     1598        label "Информация"
     1599        size 15 by 1 tooltip "Информация о процесс".
     1600   define frame waitfram
     1601     v-waitfram-action01 format "x(72)" no-label skip
     1602     v-waitfram-action02 format "x(72)" no-label skip
     1603     v-waitfram-action03 format "x(72)" no-label skip
     1604     B-viewProcInfo
     1605     B-WaitFramStop at row 4 col 30
     1606     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1607     .
     1608   define new global shared variable mBatchMode as logical no-undo init ?.
     1609   define variable mFramBachModHandle as handle no-undo.
     1610   mFramBachModHandle = frame waitfram:handle.
     1611   define variable mFameOldVis as logical no-undo.
     1612   define variable mVisCUrentVin as logical no-undo.
     1613   if session:batch-mode
     1614   then
     1615      mBatchMode = yes.
     1616   if mBatchMode = ? then do:
     1617     mVisCUrentVin = current-window:visible.
     1618     mFameOldVis = mFramBachModHandle:visible.
     1619     mFramBachModHandle:visible  = yes.
     1620     mBatchMode = mFramBachModHandle:visible ne yes.
     1621     mFramBachModHandle:visible = mFameOldVis.
     1622     current-window:visible = mVisCUrentVin.
     1623   end.
     1624    if  log-manager:logfile-name ne ?
     1625     then DO:
     1626         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1627         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1628         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1629     end.
     1630   on choose of B-WaitFramStop in frame waitfram
     1631   do:
     1632     mWaitFramStop = yes.
     1633     mWaitFramStopUser = yes.
     1634   end.
     1635   function waitfram-check-timeout returns logical():
     1636      define variable vtime as int64 no-undo.
     1637      if mWaitFramStopTimeOut
     1638      then
     1639         return yes.
     1640      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1641      if     mWaitFramTimeOut ne ?
     1642         and mWaitFramTimeOut ne 0
     1643         and mWaitFramTimeOut lt vtime
     1644      then do:
     1645         mWaitFramStopTimeOut = yes.
     1646      end.
     1647      return mWaitFramStopTimeOut.
     1648   end.
     1649   procedure waitfram-hide :
     1650     if not session:batch-mode
     1651     then do
     1652     on error undo, return error return-value
     1653     :
     1654       pause 0 before-hide .
     1655       if not mBatchMode then
     1656         hide frame waitfram .
     1657     if     not mWaitFramView
     1658        and mWaitProcEvent
     1659     then
     1660       process events .
     1661     end.
     1662   end procedure.
     1663   procedure waitfram-show :
     1664     define input  parameter p-message as character no-undo .
     1665     define variable v-left-margin as integer   no-undo .
     1666     if not session:batch-mode
     1667     then do
     1668     on error undo, return error return-value
     1669     :
     1670       if length(p-message) <= 70 then do:
     1671         assign
     1672           v-left-margin = integer((70 - length(p-message)) / 2)
     1673         .
     1674         assign
     1675           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1676         .
     1677         assign
     1678           v-waitfram-action01 = " "
     1679           v-waitfram-action02 = " "
     1680                                    + fill(" ", v-left-margin)
     1681                                    + p-message
     1682           v-waitfram-action03 = " "
     1683         .
     1684       end.
     1685       else do:
     1686         define variable vRindex1 as integer no-undo.
     1687         define variable vRindex2 as integer no-undo.
     1688         vRindex1 = r-index(p-message," ",70).
     1689         if vRindex1 = 0
     1690         then
     1691            vRindex1 = 70.
     1692         if length(p-message)  <= vRindex1 + 70 then do:
     1693           assign
     1694             v-waitfram-action01 = " "
     1695             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1696             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1697           .
     1698         end.
     1699         else do:
     1700           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1701           if vRindex2 <= vRindex1
     1702           then
     1703              vRindex2 = vRindex1 + 70.
     1704           assign
     1705             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1706             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1707             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1708           .
     1709         end.
     1710       end.
     1711       B-viewProcInfo:visible   in frame waitfram = no.
     1712       B-viewProcInfo:sensitive in frame waitfram = no.
     1713       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1714       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1715       if  (   mWaitFramView
     1716          or  mWaitProcEvent)
     1717          and not mBatchMode
     1718       then
     1719          display
     1720             v-waitfram-action01 skip
     1721             v-waitfram-action02 skip
     1722             v-waitfram-action03 skip
     1723          with frame waitfram .
     1724       if     mWaitFramView
     1725          then do:
     1726             if     mWaitFramInterval ne ?
     1727                and not mBatchMode
     1728             then
     1729                wait-for go of frame waitfram pause mWaitFramInterval.
     1730          end.
     1731          else
     1732             if     mWaitProcEvent
     1733                and not mBatchMode
     1734             then
     1735                process events .
     1736     end.
     1737   end procedure.
     1738      procedure waitfram-show-this:
     1739         define input  parameter iInterval as int64 no-undo.
     1740         define variable vtime as int64 no-undo.
     1741         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1742         mWaitFramInterval = iInterval.
     1743         run waitfram-show (substitute("&1&2 &3&4" ,
     1744                                       mWaitFramTextBeg ,
     1745                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1746                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1747                                       mWaitFramTextEnd
     1748                                      )
     1749                           ).
     1750      end.
     1751      procedure WaitFramRunPause:
     1752         define input  parameter iInterval as dec no-undo.
     1753         define variable vStart  as datetime-tz no-undo.
     1754         define variable vend    as datetime-tz no-undo.
     1755         define variable vint as int64 no-undo.
     1756         define variable vOk as logical no-undo.
     1757         vStart = now.
     1758         vend   = vStart.
     1759         publish "WaitFramPause" (iInterval,output vOk).
     1760         vend   =  now.
     1761         vint = vend - vStart.
     1762         vint = iInterval - vint / 1000.
     1763         if     not mWaitFramStop
     1764            and (   vint > 0
     1765                 or (    not vOk
     1766                     and iInterval eq ?
     1767                     )
     1768                 )
     1769         then
     1770            run waitfram-show-this (iInterval).
     1771         vend   =  now.
     1772         vint = vend - vStart.
     1773         vint = iInterval - vint / 1000.
     1774         if     not mWaitFramStop
     1775            and vint > 0
     1776         then do:
     1777            run gbl/pause.p (vint * 1000).
     1778         end.
     1779         if iInterval ne ?
     1780         then
     1781            publish "WaitFramStop".
     1782         waitfram-check-timeout().
     1783      end.
     1784      procedure WaitFramWaitFor:
     1785         define input  parameter iInterval as dec no-undo.
     1786         assign
     1787            mWaitFramStartProc   = now
     1788            mWaitFramStopUser    = no
     1789            mWaitFramStopTimeOut = no
     1790         .
     1791         block-wait:
     1792         do while not mWaitFramStop:
     1793            run WaitFramRunPause (iInterval).
     1794            if  waitfram-check-timeout()
     1795            then do:
     1796               leave block-wait.
     1797            end.
     1798         end.
     1799         run waitfram-hide.
     1800      end.
     1801   procedure waitfram-join :
     1802     define input  parameter p-line-1  as character no-undo .
     1803     define input  parameter p-line-2  as character no-undo .
     1804     define input  parameter p-line-3  as character no-undo .
     1805     define output parameter p-message as character no-undo .
     1806     do
     1807     on error undo, return error return-value
     1808     :
     1809       assign
     1810         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1811                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1812                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1813       .
     1814     end.
     1815   end procedure.
     1816   function waitfram-join-function returns character
     1817     (input p-line-1 as character
     1818     ,input p-line-2 as character
     1819     ,input p-line-3 as character
     1820     ).
     1821     define variable v-message as character no-undo .
     1822     run waitfram-join in this-procedure
     1823       (input  p-line-1
     1824       ,input  p-line-2
     1825       ,input  p-line-3
     1826       ,output v-message
     1827       ) .
     1828     return v-message .
     1829   end function .
     1830   define temp-table tt-act-header
     1831       field num           as character        label "№ акта"      format "X(30)"
     1832       field date_         as date             label "Дата акта"
     1833       field type_         as character        label "Основание списания" format "X(18)"
     1834       field is-sent       as logical
     1835       field answer_       as character        label "Ответ"       format "X(1500)"
     1836       field RegID         as character        label "Рег. номер"  format "X(50)"
     1837       index pi as primary unique
     1838           num
     1839   .
     1840   define temp-table tt-gds-act
     1841       field num           as character                label "№ акта"
     1842       field position_     as integer                  label "№ пп"                    format ">>>9"
     1843       field gds-code      like ub.goods.gds-code      label "Код товара   "
     1844       field alc-code      as character                label "Алкогольный код"         format "X(21)"
     1845       field gds-name      like ub.goods.gds-name      label "Наименование товара"     format "X(35)"
     1846       field qnty          as decimal                  label "Количество"
     1847       field marks-qnty    as integer                  label "Кол-во марок"
     1848       field egais-name    as character
     1849       index pi as primary unique
     1850           position_
     1851       index code
     1852           gds-code
     1853   .
     1854   define shared  temp-table tt-marks
     1855       field num                 as character            label "№ акта"
     1856       field gds-part-position_  as integer
     1857       field mark                as character            label "Марка"          format "X(100)"
     1858       field new_                as logical
     1859       field gds-code            like ub.goods.gds-code  LABEL "Код товара"
     1860       field gds-name            as character            LABEL "Наименование"   FORMAT "X(30)"
     1861       field alc-code            as character            LABEL "Алк. код"       FORMAT "X(20)"
     1862       field impor-full-name     as character            LABEL "Импортер"       FORMAT "X(130)"
     1863       field prod-full-name      as character            LABEL "Производитель"  FORMAT "X(130)"
     1864       field flag                as logical              label "T"
     1865       index pi as primary unique
     1866           mark
     1867   .
     1868   define variable sw as handle no-undo .
     1869   define variable v-file              as character no-undo initial "ActWriteOff_Shop1.xml".
     1870   DEFINE VARIABLE hDoc AS HANDLE NO-UNDO.
     1871   DEFINE VARIABLE hRoot AS HANDLE NO-UNDO.
     1872   DEFINE VARIABLE good AS LOGICAL NO-UNDO.
     1873   procedure makeXML :
     1874       create sax-writer sw .
     1875       sw:formatted = true.
     1876       sw:set-output-destination ("file", v-file).
     1877       sw:encoding = "UTF-8".
     1878       sw:start-document () .
     1879       sw:start-element ("ns:Documents") .
     1880       sw:insert-attribute ("Version", "1.0") .
     1881       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
     1882       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
     1883       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef") .
     1884       sw:insert-attribute ("xmlns:awr", "http://fsrar.ru/WEGAIS/ActWriteOff") .
     1885           sw:start-element ("ns:Owner") .
     1886               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
     1887           sw:end-element ("ns:Owner") .
     1888           sw:start-element ("ns:Document") .
     1889               sw:start-element ("ns:ActWriteOff") .
     1890                   sw:write-data-element ("awr:Identity", tt-act-header.num) no-error .
     1891                   sw:start-element ("awr:Header") .
     1892                       sw:write-data-element ("awr:ActNumber", tt-act-header.num) no-error .
     1893                       sw:write-data-element ("awr:ActDate", string(iso-date(tt-act-header.date_))) no-error .
     1894                       sw:write-data-element ("awr:TypeWriteOff", tt-act-header.type_) no-error .
     1895                       sw:write-data-element ("awr:Note", "Необходимо списать товарные позиции с баланса") .
     1896                   sw:end-element ("awr:Header") .
     1897                   sw:start-element ("awr:Content") .
     1898       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
     1899                       sw:start-element ("awr:Position") .
     1900                           sw:write-data-element ("awr:Identity", string(tt-gds-act.position_)) no-error .
     1901                           sw:write-data-element ("awr:Quantity", string(tt-gds-act.qnty)) no-error .
     1902                           sw:write-data-element ("gds-code", string(tt-gds-act.gds-code)) no-error .
     1903                           sw:write-data-element ("gds-name", tt-gds-act.gds-name) no-error .
     1904                           sw:write-data-element ("alc-code", tt-gds-act.alc-code) no-error .
     1905                           sw:start-element ("awr:MarkCodeInfo") .
     1906               for each tt-marks no-lock where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ :
     1907                               sw:write-data-element ("awr:MarkCode", tt-marks.mark) .
     1908               end.
     1909                           sw:end-element ("awr:MarkCodeInfo") .
     1910                       sw:end-element ("awr:Position") .
     1911       end.
     1912                   sw:end-element ("awr:Content") .
     1913               sw:end-element ("ns:ActWriteOff") .
     1914           sw:end-element ("ns:Document") .
     1915       sw:end-element ("ns:Documents") .
     1916       sw:end-document () .
     1917       delete object sw.
     1918   end procedure .
     1919   procedure makeXMLegais_v2 :
     1920       create sax-writer sw .
     1921       sw:formatted = true.
     1922       sw:set-output-destination ("file", v-file).
     1923       sw:encoding = "UTF-8".
     1924       sw:start-document () .
     1925       sw:start-element ("ns:Documents") .
     1926       sw:insert-attribute ("Version", "1.0") .
     1927       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
     1928       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
     1929       sw:insert-attribute ("xmlns:oref", "http://fsrar.ru/WEGAIS/ClientRef_v2") .
     1930       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef_v2") .
     1931       sw:insert-attribute ("xmlns:awr", "http://fsrar.ru/WEGAIS/ActWriteOffShop_v2") .
     1932       sw:insert-attribute ("xmlns:ce", "http://fsrar.ru/WEGAIS/CommonEnum") .
     1933           sw:start-element ("ns:Owner") .
     1934               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
     1935           sw:end-element ("ns:Owner") .
     1936           sw:start-element ("ns:Document") .
     1937               sw:start-element ("ns:ActWriteOffShop_v2") .
     1938                   sw:write-data-element ("awr:Identity", tt-act-header.num) .
     1939                   sw:start-element ("awr:Header") .
     1940                       sw:write-data-element ("awr:ActNumber", tt-act-header.num) .
     1941                       sw:write-data-element ("awr:ActDate", string(iso-date(tt-act-header.date_))) no-error .
     1942                       sw:write-data-element ("awr:Note", "Необходимо списать товарные позиции с баланса") .
     1943                       sw:write-data-element ("awr:TypeWriteOff", tt-act-header.type_) .
     1944                   sw:end-element ("awr:Header") .
     1945                   sw:start-element ("awr:Content") .
     1946       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
     1947           if tt-gds-act.qnty <= 0 then next.
     1948                       find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code no-error .
     1949                       if not available buf_goods and (tt-gds-act.gds-code = 0 or tt-gds-act.gds-code =?)
     1950                       then do :
     1951                           find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     1952                                                                  and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     1953                                                                  and X_ext-classif.db-num = 0
     1954                                                                  and X_ext-classif.Key#_two = v-ext-sys
     1955                                                                  and X_ext-classif.Key#_three = 0
     1956                                                                  and X_ext-classif.CharKey_One = tt-gds-act.alc-code
     1957                                                                  and X_ext-classif.CharKey_two = ""
     1958                                                                  and X_ext-classif.CharKey_three = ""
     1959                                                                  and X_ext-classif.nonunique = 0
     1960                                                                  no-error .
     1961                           if available X_ext-classif
     1962                           then do :
     1963                               tt-gds-act.gds-code = X_ext-classif.Key#_One .
     1964                               find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code .
     1965                           end.
     1966                       end.
     1967                       sw:start-element ("awr:Position") .
     1968                           sw:write-data-element ("awr:Identity", string(tt-gds-act.position_)) .
     1969                           sw:start-element ("awr:Product") .
     1970                               sw:write-data-element ("pref:UnitType", (if buf_goods.unit-base <> buf_goods.unit-cli and buf_goods.cli-base-rate <> 1 then "Unpacked" else "Packed")) .
     1971                               sw:write-data-element ("pref:FullName", tt-gds-act.egais-name) no-error .
     1972                               sw:write-data-element ("pref:ShortName", "") .
     1973                               sw:write-data-element ("pref:AlcCode", tt-gds-act.alc-code) .
     1974                               if not (buf_goods.unit-base <> buf_goods.unit-cli and buf_goods.cli-base-rate <> 1)
     1975                               then sw:write-data-element ("pref:Capacity", string(buf_goods.ms-base)) .
     1976                               sw:write-data-element ("pref:AlcVolume", string(buf_goods.proof)) .
     1977                           for first ub.alc-type-gds where ub.alc-type-gds.gds-code = buf_goods.gds-code no-lock,
     1978                               first ub.alc-type where ub.alc-type.alc-type-inner-code = ub.alc-type-gds.alc-type-inner-code no-lock :
     1979                               sw:write-data-element ("pref:ProductVCode", string(ub.alc-type.alc-type-code)) .
     1980                           end.
     1981                           find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = 'goods':U
     1982                                                                  and X_ext-classif-attr.classif-name = 'exp-esys-gds-code':U
     1983                                                                  and X_ext-classif-attr.db-num = 0
     1984                                                                  and X_ext-classif-attr.Key#_One = tt-gds-act.gds-code
     1985                                                                  and X_ext-classif-attr.Key#_two = v-ext-sys
     1986                                                                  and X_ext-classif-attr.Key#_three = 0
     1987                                                                  and X_ext-classif-attr.CharKey_One = tt-gds-act.alc-code
     1988                                                                  and X_ext-classif-attr.CharKey_two = ""
     1989                                                                  and X_ext-classif-attr.CharKey_three = ""
     1990                                                                  and X_ext-classif-attr.nonunique = 0
     1991                                                                  and X_ext-classif-attr.attr-code = 'egais-info'
     1992                                                                  no-error .
     1993                           if available X_ext-classif-attr and num-entries(X_ext-classif-attr.attr-value, CHR(4)) >= 3 then do :
     1994                             def var v-prod as char no-undo.
     1995                             def var v-impor as char no-undo.
     1996                             def var v-msg as char no-undo.
     1997                             def var v-err as logical no-undo.
     1998                             def var v-err-impor as logical no-undo.
     1999                             v-err = false .
     2000                             v-prod = ''.
     2001                             v-impor = ''.
     2002                             v-prod = entry (1, X_ext-classif-attr.attr-value, chr(4)) no-error.
     2003                             if v-prod = ?
     2004                             or v-prod = chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5) + chr(5)
     2005                             or v-prod = ""
     2006                             or num-entries (v-prod, chr (5)) < 8
     2007                             or entry (7, v-prod, chr(5)) = ""
     2008                             then do:
     2009                               message "У товара неизвестен производитель (или его тип) из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров во второй версии XSD и  заново сохраните акт." view-as alert-box.
     2010                               v-err = true .
     2011                             end.
     2012                             if not v-err then do :
     2013                               sw:start-element ("pref:Producer") .
     2014                                sw:start-element ("oref:" + entry (7, v-prod, chr(5))) .
     2015                                 if entry (7, v-prod, chr(5)) <> "TS" then do :
     2016                                     if entry (2, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:INN", entry (2, v-prod, chr(5)) ).
     2017                                     if entry (3, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:KPP", entry (3, v-prod, chr(5)) ).
     2018                                 end.
     2019                                 else if entry (2, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:TSNUM", entry (2, v-prod, chr(5)) ).
     2020                                 sw:write-data-element ("oref:ClientRegId", entry (1, v-prod, chr(5)) ).
     2021                                 sw:write-data-element ("oref:FullName", entry (4, v-prod, chr(5)) ).
     2022                                 sw:start-element ("oref:address").
     2023                                   sw:write-data-element ("oref:Country", entry (5, v-prod, chr(5)) ).
     2024                                   if entry (8, v-prod, chr(5)) <> "" then sw:write-data-element ("oref:RegionCode", entry (8, v-prod, chr(5)) ).
     2025                                   sw:write-data-element ("oref:description", entry (6, v-prod, chr(5)) ).
     2026                                 sw:end-element ("oref:address").
     2027                                sw:end-element ("oref:" + entry (7, v-prod, chr(5))) .
     2028                               sw:end-element ("pref:Producer") .
     2029                             end.
     2030                           end.
     2031                           else do:
     2032                             message "У товара неизвестен производитель из ЕГАИС - " + string (tt-gds-act.gds-code) + ". Выполните синхронизацию товаров и  заново сохраните акт." view-as alert-box.
     2033                           end.
     2034                           sw:end-element ("awr:Product") .
     2035                           sw:write-data-element ("awr:Quantity", string(tt-gds-act.qnty)) .
     2036           find first tt-marks where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ no-lock no-error.
     2037           if available tt-marks and (tt-act-header.type_ = "Проверки" or tt-act-header.type_ = "Арест") then do :
     2038                           sw:start-element ("awr:MarkCodeInfo") .
     2039               for each tt-marks no-lock where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ :
     2040                               sw:write-data-element ("awr:MarkCode", tt-marks.mark) .
     2041               end.
     2042                           sw:end-element ("awr:MarkCodeInfo") .
     2043           end.
     2044                       sw:end-element ("awr:Position") .
     2045       end.
     2046                   sw:end-element ("awr:Content") .
     2047               sw:end-element ("ns:ActWriteOffShop_v2") .
     2048           sw:end-element ("ns:Document") .
     2049       sw:end-element ("ns:Documents") .
     2050       sw:end-document () .
     2051       delete object sw.
     2052   end procedure .
     2053   procedure parseXML :
     2054       define input parameter inFile as character no-undo .
     2055       empty temp-table tt-act-header .
     2056       empty temp-table tt-gds-act .
     2057       CREATE X-DOCUMENT hDoc.
     2058       CREATE X-NODEREF hRoot.
     2059       hDoc:encoding = 'utf-8'.
     2060       hDoc:LOAD("file", search(inFile),FALSE).
     2061       hDoc:GET-DOCUMENT-ELEMENT(hRoot).
     2062       RUN GetChildren(hRoot, 1).
     2063       DELETE OBJECT hDoc.
     2064       DELETE OBJECT hRoot.
     2065   end procedure .
     2066   procedure GetChildren :
     2067       DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
     2068       DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
     2069       DEFINE VARIABLE i AS INTEGER NO-UNDO.
     2070       DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
     2071       DEFINE VARIABLE hText AS HANDLE NO-UNDO.
     2072       CREATE X-NODEREF hNoderef.
     2073       CREATE X-NODEREF hText .
     2074       REPEAT i = 1 TO hParent:NUM-CHILDREN:
     2075           good = hParent:GET-CHILD(hNoderef,i).
     2076           IF NOT good THEN
     2077               LEAVE.
     2078           IF hNoderef:SUBTYPE <> "element" THEN
     2079               NEXT.
     2080           hNoderef:GET-CHILD(hText, 1) no-error .
     2081           IF hNoderef:NAME = "awr:Header" THEN do :
     2082               create tt-act-header .
     2083               assign tt-act-header.is-sent = bh-act-header:buffer-field("is-sent"):buffer-value .
     2084           end .
     2085           .
     2086           IF hNoderef:NAME = "awr:ActNumber" THEN assign tt-act-header.num    = hText:node-value no-error .
     2087           IF hNoderef:NAME = "awr:ActDate" THEN
     2088               assign tt-act-header.date_ = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
     2089           IF hNoderef:NAME = "awr:TypeWriteOff" THEN assign tt-act-header.type_    = hText:node-value no-error .
     2090           IF hNoderef:NAME = "awr:Position" THEN do :
     2091               assign ii = 0 .
     2092               create tt-gds-act .
     2093               assign tt-gds-act.num = tt-act-header.num .
     2094           end.
     2095           IF hNoderef:NAME = "awr:Identity" THEN assign tt-gds-act.position_ = integer(hText:node-value) no-error .
     2096           IF hNoderef:NAME = "awr:Quantity" THEN assign tt-gds-act.qnty = decimal(hText:node-value) no-error .
     2097           IF hNoderef:NAME = "gds-code"     THEN do :
     2098               assign tt-gds-act.gds-code = integer(hText:node-value) no-error .
     2099               find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code no-error .
     2100               if available buf_goods then assign tt-gds-act.gds-name = buf_goods.gds-name .
     2101           end.
     2102           if hNoderef:NAME = "gds-name" and trim(tt-gds-act.gds-name) = "" then assign tt-gds-act.gds-name = (hText:node-value) no-error .
     2103           IF hNoderef:NAME = "alc-code"     THEN assign tt-gds-act.alc-code = (hText:node-value) no-error .
     2104           IF hNoderef:NAME = "awr:MarkCode" THEN do :
     2105               create tt-marks.
     2106               assign
     2107                   tt-marks.num                    = tt-gds-act.num
     2108                   tt-marks.gds-part-position_     = tt-gds-act.position_
     2109                   tt-marks.mark                   = hText:node-value
     2110                   tt-marks.gds-code               = tt-gds-act.gds-code
     2111                   tt-marks.gds-name               = tt-gds-act.gds-name
     2112                   tt-marks.alc-code               = tt-gds-act.alc-code
     2113                   ii = ii + 1.
     2114               .
     2115               assign tt-gds-act.marks-qnty = ii .
     2116           end.
     2117           run GetChildren (hNoderef, (level + 1)).
     2118       END.
     2119       DELETE OBJECT hNoderef.
     2120       DELETE OBJECT hText.
     2121   END procedure.
     2122   define new shared temp-table tt-exts
     2123       field ext-rec as recid
     2124       field gds-code as integer
     2125       index pi as primary unique
     2126           ext-rec gds-code
     2127   .
     2128   define buffer buf_tt-marks for tt-marks .
     2129   define variable select-list as longchar no-undo .
     2130   FUNCTION get-mark RETURNS CHARACTER
     2131   (buffer local-gds for tt-gds-act ):
     2132   if lookup (string (recid (local-gds)), select-list) > 0  then return "*".
     2133                                                              else return "".
     2134   end function.
     2135   define menu m-add
     2136       menu-item m-goods   label "по складскому документу"
     2137       menu-item m-sale    label "немаркированную продукцию по продаже"
     2138       menu-item m-marks   label "по акцизным маркам"
     2139       menu-item m-file    label "из файла"
     2140       menu-item m-one-good label "один товар"
     2141   .
     2142   DEFINE BUTTON b-cancel AUTO-END-KEY
     2143        LABEL "Выход"
     2144        SIZE 15 BY 1.14
     2145        BGCOLOR 8 .
     2146   DEFINE BUTTON b-good
     2147        LABEL "Добавить"
     2148        SIZE 15 BY 1.14
     2149        BGCOLOR 8 .
     2150   DEFINE BUTTON b-marks
     2151        LABEL "Ввести марки"
     2152        SIZE 15 BY 1.14 TOOLTIP "Ввести марки"
     2153        BGCOLOR 8 .
     2154   DEFINE BUTTON b-alc-code
     2155        LABEL "Выбор алк. кода"
     2156        SIZE 20 BY 1.14 TOOLTIP "Выбрать алкогольный код"
     2157        BGCOLOR 8 .
     2158   DEFINE BUTTON b-del
     2159        LABEL "Удалить строку"
     2160        SIZE 15 BY 1.14 TOOLTIP "Удалить строку акта"
     2161        BGCOLOR 8 .
     2162   DEFINE BUTTON b-save
     2163        LABEL "Сохранить"
     2164        SIZE 15 BY 1.14 TOOLTIP "Сохранить в БД"
     2165        BGCOLOR 8 .
     2166   DEFINE BUTTON b-mark
     2167        LABEL "&*"
     2168        SIZE 3 BY 1.14 .
     2169   DEFINE BUTTON b-sel-all
     2170        LABEL "&+":L
     2171        SIZE 3 BY 1.14 TOOLTIP "Отметить все объекты".
     2172   DEFINE BUTTON b-unmark
     2173        LABEL "&-":L
     2174        SIZE 3 BY 1.14 TOOLTIP "Снять все отметки".
     2175   DEFINE QUERY br-gds-act FOR
     2176         tt-gds-act SCROLLING.
     2177   DEFINE BROWSE br-gds-act
     2178     QUERY br-gds-act  DISPLAY
     2179       get-mark(BUFFER tt-gds-act) COLUMN-LABEL "*"  FORMAT "X(1)":U
     2180       tt-gds-act.position_
     2181       tt-gds-act.gds-code
     2182       tt-gds-act.alc-code
     2183       tt-gds-act.gds-name
     2184       tt-gds-act.qnty
     2185       tt-gds-act.marks-qnty
     2186     ENABLE
     2187       tt-gds-act.qnty
     2188       WITH NO-ROW-MARKERS SEPARATORS SIZE 107 BY 20.2 FIT-LAST-COLUMN.
     2189   DEFINE FRAME Dialog-Frame
     2190       b-cancel at row 1.2 col 2
     2191       b-good at row 1.2 col 32
     2192       b-marks at row 1.2 col 47
     2193       b-alc-code at row 1.2 col 62
     2194       b-del at row 1.2 col 82
     2195       b-save at row 1.2 col 17
     2196       tt-act-header.num at row 2.5 col 2 format "X(22)"
     2197       tt-act-header.date_ at row 2.5 col 34
     2198       tt-act-header.type_ at row 2.5 col 62
     2199           view-as combo-box inner-lines 7
     2200           list-items "Пересортица,Недостача,Уценка,Порча,Потери,Проверки,Арест,Иные цели,Реализация"
     2201           DROP-DOWN-LIST
     2202       b-mark AT ROW 4 COL 2
     2203       b-sel-all AT ROW 4 COL 5
     2204       b-unmark AT ROW 4 COL 8
     2205       br-gds-act at row 5.2 col 2
     2206        SPACE(0.5) SKIP(0.5)
     2207       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2208            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2209            TITLE "Акт о списании товаров из торгового зала" WIDGET-ID 100.
     2210   ASSIGN
     2211          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2212          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2213   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2214   DO:
     2215     APPLY "END-ERROR":U TO SELF.
     2216   END.
     2217   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     2218   DO:
     2219     run proc-b-mark in this-procedure no-error.
     2220   END.
     2221   ON CHOOSE OF b-sel-all IN FRAME Dialog-Frame
     2222   DO:
     2223     assign select-list = "".
     2224     if not available tt-gds-act then return.
     2225     for each tt-gds-act no-lock :
     2226   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2227   define variable v-str-recid12 as character no-undo .
     2228   define variable v-num-entry12 as integer   no-undo .
     2229   assign
     2230     v-str-recid12 = trim( string( recid( tt-gds-act ) , "->>>>>>>>>>>9":U ) )
     2231     v-num-entry12 = lookup( v-str-recid12 , select-list )
     2232   .
     2233   if v-num-entry12 > 0 then do:
     2234     assign
     2235       entry( v-num-entry12, select-list ) = "":U
     2236       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2237     .
     2238   end.
     2239   else do:
     2240     assign
     2241       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid12
     2242     .
     2243   end.
     2244     end.
     2245     br-gds-act:refresh() in frame Dialog-Frame .
     2246   END.
     2247   ON CHOOSE OF b-unmark IN FRAME Dialog-Frame
     2248   DO:
     2249     if not available tt-gds-act then return.
     2250     select-list  = "".
     2251     br-gds-act:refresh() in frame Dialog-Frame .
     2252   END.
     2253   ON VALUE-CHANGED OF tt-act-header.type_ IN FRAME Dialog-Frame
     2254   DO:
     2255     assign tt-act-header.type_.
     2256     if tt-act-header.type_ = "Проверки"
     2257     or tt-act-header.type_ = "Арест"
     2258     or tt-act-header.type_ = "Реализация"
     2259     then do :
     2260         enable b-marks with frame Dialog-Frame .
     2261     end.
     2262     else do :
     2263         disable b-marks with frame Dialog-Frame .
     2264     end.
     2265   END.
     2266   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     2267   DO:
     2268       if p-mode <> 'ПРОСМОТР':U then do :
     2269           message "Все несохранённые данные будут потеряны. Вы уверены, что хотите выйти?"
     2270           view-as alert-box question buttons yes-no update glog.
     2271           if not glog then return no-apply .
     2272       end.
     2273   END.
     2274   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     2275   DO:
     2276       define variable v-tt-rec as recid.
     2277       if available tt-gds-act  AND select-list = ""
     2278       then
     2279       select-list = string( recid( tt-gds-act ) ) .
     2280       if not available tt-gds-act and select-list = "" then do :
     2281           message "Выберите строку" view-as alert-box .
     2282           return no-apply.
     2283       end.
     2284       else
     2285       do ii = 1 to num-entries (select-list) :
     2286         v-tt-rec = integer(entry(ii, select-list)) .
     2287         for first tt-gds-act exclusive-lock where recid(tt-gds-act) = v-tt-rec :
     2288           for each tt-marks exclusive-lock where tt-marks.gds-part-position_ = tt-gds-act.position_ :
     2289               delete tt-marks .
     2290           end.
     2291           delete tt-gds-act .
     2292         end.
     2293       end.
     2294       nn = 0 .
     2295       for each tt-gds-act exclusive-lock :
     2296           nn = nn + 1 .
     2297           for each tt-marks exclusive-lock where tt-marks.gds-part-position_ = tt-gds-act.position_ :
     2298               tt-marks.gds-part-position_ = nn .
     2299           end.
     2300           tt-gds-act.position_ = nn .
     2301       end.
     2302       select-list = "" .
     2303       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2304   END.
     2305   ON "leave" of tt-act-header.num in FRAME Dialog-Frame
     2306   DO:
     2307       define variable prev-num as character no-undo .
     2308       prev-num = tt-act-header.num .
     2309       assign tt-act-header.num .
     2310       for each tt-gds-act exclusive-lock where tt-gds-act.num = prev-num :
     2311           assign tt-gds-act.num = tt-act-header.num .
     2312       end.
     2313       for each tt-marks exclusive-lock where tt-marks.num = prev-num :
     2314           assign tt-marks.num = tt-act-header.num .
     2315       end.
     2316   END.
     2317   ON CHOOSE OF b-marks IN FRAME Dialog-Frame
     2318   DO:
     2319       if not available tt-gds-act then do :
     2320           message "Выберите строку" view-as alert-box .
     2321           return no-apply.
     2322       end.
     2323       run bge/egais-ab-marks.w (parparentproc, tt-gds-act.num, tt-gds-act.position_, tt-gds-act.alc-code, tt-gds-act.qnty, 'ИЗМЕНЕНИЕ':U, input-output table tt-marks) .
     2324       assign ii = 0 .
     2325       for each tt-marks no-lock where tt-marks.num = tt-gds-act.num and tt-marks.gds-part-position_ = tt-gds-act.position_ :
     2326           ii = ii + 1 .
     2327       end.
     2328       assign tt-gds-act.marks-qnty = ii .
     2329       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2330   END.
     2331   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     2332   DO:
     2333       assign
     2334           tt-act-header.num
     2335           tt-act-header.date_
     2336           tt-act-header.type_
     2337       .
     2338       find first tt-gds-act no-error .
     2339       if not available tt-gds-act then do :
     2340           message "В акте нет строк. Сохранение невозможно" view-as alert-box .
     2341           return no-apply.
     2342       end.
     2343       if can-find(tt-gds-act where tt-gds-act.qnty < 1)
     2344       then do :
     2345           message "Строки, в которых количество меньше 1, не будут учтены при отправке в ЕГАИС!" skip "Продолжить?"
     2346           view-as alert-box question buttons yes-no update glog .
     2347           if not glog then return no-apply.
     2348       end.
     2349       run makeXML in this-procedure no-error.
     2350       if error-status:error then return return-value .
     2351       assign
     2352           v-clob-db-num = ?
     2353           v-int64-id = 0
     2354           v-info = tt-act-header.num + chr(4) + string(tt-act-header.date_) + chr(4) + tt-act-header.type_ + chr(4) + string(tt-act-header.is-sent) + chr(4) + tt-act-header.answer_
     2355       .
     2356       find first buf_clob-bind exclusive-lock where buf_clob-bind.uniq-key-rec = tt-act-header.num
     2357                                                 and buf_clob-bind.field-name_  = 'egais-awo_shop':U no-error .
     2358       if available buf_clob-bind then do :
     2359           if p-mode = 'ДОБАВЛЕНИЕ':U then do :
     2360               message "Акт с таким номером уже существует!" view-as alert-box .
     2361               return no-apply .
     2362           end.
     2363           assign
     2364               v-clob-db-num = buf_clob-bind.db-num
     2365               v-int64-id = buf_clob-bind.int64-id
     2366               v-part-num = buf_clob-bind.part-num
     2367           .
     2368           run gbl/file2clb.p ( input 'ИЗМЕНЕНИЕ':U
     2369                     ,input "add-new,yes"
     2370                     ,input ?
     2371                     ,input tt-act-header.num
     2372                     ,input 'egais-awo_shop':U
     2373                     ,input v-info
     2374                     ,input-output v-part-num
     2375                     ,input 'egais-awo_shop':U
     2376                     ,input-output v-clob-db-num
     2377                     ,input-output v-int64-id
     2378                     ,input search (v-file)
     2379                     ,input ''
     2380                     ) no-error .
     2381            if error-status:error then message return-value view-as alert-box.
     2382       end.
     2383       else do :
     2384           run gbl/file2clb.p ( input 'ДОБАВЛЕНИЕ':U
     2385                     ,input ",yes"
     2386                     ,input ?
     2387                     ,input tt-act-header.num
     2388                     ,input 'egais-awo_shop':U
     2389                     ,input v-info
     2390                     ,input-output v-part-num
     2391                     ,input 'egais-awo_shop':U
     2392                     ,input-output v-clob-db-num
     2393                     ,input-output v-int64-id
     2394                     ,input search (v-file)
     2395                     ,input ''
     2396                     ) no-error .
     2397       end.
     2398       message "Сохранение завершено" view-as alert-box.
     2399   END.
     2400   on choose of menu-item m-goods in menu m-add
     2401   DO:
     2402       v-rid-list = "" .
     2403       run str/all-docs.w
     2404       ( input  parparentproc
     2405        ,input  v-cntxt-host-code-obj
     2406        ,input  v-cntxt-obj-type
     2407        ,input  v-cntxt-obj-code
     2408        ,input  'объект':U
     2409        ,input  'факт':U
     2410        ,input  '?'
     2411        ,input  ?
     2412        ,input  ?
     2413        ,input  "b-sel":U
     2414        ,input  'rv':U
     2415        ,input  false
     2416        ,input  ?
     2417        ,output v-rid-list
     2418       ).
     2419       if v-rid-list = "" or v-rid-list = ?
     2420       then return no-apply.
     2421       find first   buf_trn-doc no-lock where recid(buf_trn-doc) = int(v-rid-list) no-error .
     2422       if error-status :error then return .
     2423       for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code :
     2424           find first buf_goods no-lock where buf_goods.artic      = buf_doc-line.artic
     2425                                          and buf_goods.prod-type  = buf_doc-line.prod-type
     2426                                          and buf_goods.prod-code  = buf_doc-line.prod-code .
     2427           run gds-attr-value(
     2428             buf_goods.gds-code,
     2429             'alcohol-prod':U,
     2430             output par-alcohol,
     2431             output par-type
     2432           ).
     2433           if par-alcohol = "" or par-alcohol = "no" then next .
     2434           for each buf_parts no-lock where buf_parts.artic        = buf_doc-line.artic
     2435                                        and buf_parts.prod-type    = buf_doc-line.prod-type
     2436                                        and buf_parts.prod-code    = buf_doc-line.prod-code
     2437                                        and buf_parts.obj-type     = buf_doc-line.obj-type
     2438                                        and buf_parts.obj-code     = buf_doc-line.obj-code
     2439                                        and buf_parts.out-code     = buf_doc-line.doc-code :
     2440                assign nn = nn + 1 .
     2441                create tt-gds-act .
     2442                assign
     2443                   tt-gds-act.num          = tt-act-header.num
     2444                   tt-gds-act.gds-code     = buf_goods.gds-code
     2445                   tt-gds-act.gds-name     = buf_goods.gds-name
     2446                   tt-gds-act.position_    = nn
     2447                   tt-gds-act.qnty         = buf_parts.fact-qnty / buf_parts.cli-base-rate
     2448                .
     2449                if num-entries(buf_parts.alc-ref-ab-path) = 4 and entry(3, buf_parts.alc-ref-ab-path) <> "" then do :
     2450                    tt-gds-act.alc-code = entry(3, buf_parts.alc-ref-ab-path) .
     2451                end.
     2452                else do :
     2453                    run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     2454                                                       ,input (buffer buf_goods:handle)
     2455                                                       ,output v-gds-uniq-key-rec).
     2456                    find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2457                                                      and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2458                                                      AND X_ext-classif.db-num = 0
     2459                                                      and X_ext-classif.key#_one = buf_goods.gds-code
     2460                                                      and X_ext-classif.key#_two = v-ext-sys
     2461                                                      and X_ext-classif.key#_three = 0
     2462                                                      and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2463                                                      and X_eXt-classif.charkey_two = ""
     2464                                                      and X_eXt-classif.charkey_three = ""
     2465                                                      and X_eXt-classif.nonunique = 0
     2466                                                      no-error .
     2467                    if available X_ext-classif then tt-gds-act.alc-code = X_eXt-classif.charkey_one .
     2468                end.
     2469           end .
     2470       end .
     2471       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2472   END.
     2473   on choose of menu-item m-sale in menu m-add
     2474   DO:
     2475       define variable v-ret-code as character no-undo .
     2476       define variable v-alc-code as character no-undo .
     2477       v-rid-list = "" .
     2478       run str/salelist.w
     2479       (input  parparentproc
     2480       ,input  "b-sel,b-mark":U
     2481       ,input  'объект':U
     2482       ,input  v-cntxt-host-code-obj
     2483       ,input  v-cntxt-obj-type
     2484       ,input  v-cntxt-obj-code
     2485       ,input-output v-rid-list
     2486       ) no-error.
     2487       if v-rid-list = "" or v-rid-list = ?
     2488       then return no-apply.
     2489       _ii_ :
     2490       do ii = 1 to num-entries(v-rid-list) :
     2491           for first   buf_ink-doc no-lock where recid(buf_ink-doc) = int(entry(ii, v-rid-list)) :
     2492               v-ret-code = replace(buf_ink-doc.inkas-code, "-", "=") .
     2493               for each buf_parts no-lock where buf_parts.obj-type     = buf_ink-doc.obj-type
     2494                                            and buf_parts.obj-code     = buf_ink-doc.obj-code
     2495                                            and buf_parts.out-code     = buf_ink-doc.inkas-code :
     2496                   find first buf_goods no-lock where buf_goods.artic      = buf_parts.artic
     2497                                                  and buf_goods.prod-type  = buf_parts.prod-type
     2498                                                  and buf_goods.prod-code  = buf_parts.prod-code .
     2499                   run gds-attr-value(
     2500                     buf_goods.gds-code,
     2501                     'alcohol-prod':U,
     2502                     output par-alcohol,
     2503                     output par-type
     2504                   ).
     2505                   if par-alcohol = "" or par-alcohol = "no" then next .
     2506                   run gds-attr-value(
     2507                     buf_goods.gds-code,
     2508                     'mark':U,
     2509                     output par-mark,
     2510                     output par-type
     2511                   ).
     2512                   if logical(par-mark) then next .
     2513                   v-alc-code = "" .
     2514                   if num-entries(buf_parts.alc-ref-ab-path) = 4 and entry(3, buf_parts.alc-ref-ab-path) <> "" then do :
     2515                       v-alc-code = entry(3, buf_parts.alc-ref-ab-path) .
     2516                   end.
     2517                   else do :
     2518                       run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     2519                                                          ,input (buffer buf_goods:handle)
     2520                                                          ,output v-gds-uniq-key-rec).
     2521                       find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2522                                                         and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2523                                                         AND X_ext-classif.db-num = 0
     2524                                                         and X_ext-classif.key#_one = buf_goods.gds-code
     2525                                                         and X_ext-classif.key#_two = v-ext-sys
     2526                                                         and X_ext-classif.key#_three = 0
     2527                                                         and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2528                                                         and X_eXt-classif.charkey_two = ""
     2529                                                         and X_eXt-classif.charkey_three = ""
     2530                                                         and X_eXt-classif.nonunique = 0
     2531                                                         no-error .
     2532                       if available X_ext-classif then v-alc-code = X_eXt-classif.charkey_one .
     2533                       else do :
     2534                           message "Товар " string(buf_goods.gds-code) " - " buf_goods.gds-name " не синхронизирован с ЕГАИС" view-as alert-box .
     2535                           next.
     2536                       end.
     2537                   end.
     2538                   find first tt-gds-act exclusive-lock where tt-gds-act.alc-code = v-alc-code no-error.
     2539                   if not available tt-gds-act
     2540                   then do :
     2541                       assign nn = nn + 1 .
     2542                       create tt-gds-act .
     2543                       assign
     2544                          tt-gds-act.num          = tt-act-header.num
     2545                          tt-gds-act.alc-code     = v-alc-code
     2546                          tt-gds-act.gds-code     = buf_goods.gds-code
     2547                          tt-gds-act.gds-name     = buf_goods.gds-name
     2548                          tt-gds-act.position_    = nn
     2549                          tt-gds-act.qnty         = buf_parts.fact-qnty / buf_parts.cli-base-rate
     2550                       .
     2551                   end.
     2552                   else do :
     2553                       assign tt-gds-act.qnty  = tt-gds-act.qnty + (buf_parts.fact-qnty / buf_parts.cli-base-rate) .
     2554                   end.
     2555               end.
     2556               for each ret_parts no-lock where   ret_parts.obj-type     = buf_ink-doc.obj-type
     2557                                              and ret_parts.obj-code     = buf_ink-doc.obj-code
     2558                                              and ret_parts.out-code     = v-ret-code :
     2559                   find first buf_goods no-lock where buf_goods.artic      = ret_parts.artic
     2560                                                  and buf_goods.prod-type  = ret_parts.prod-type
     2561                                                  and buf_goods.prod-code  = ret_parts.prod-code .
     2562                   run gds-attr-value(
     2563                     buf_goods.gds-code,
     2564                     'alcohol-prod':U,
     2565                     output par-alcohol,
     2566                     output par-type
     2567                   ).
     2568                   if par-alcohol = "" or par-alcohol = "no" then next .
     2569                   run gds-attr-value(
     2570                     buf_goods.gds-code,
     2571                     'mark':U,
     2572                     output par-mark,
     2573                     output par-type
     2574                   ).
     2575                   if logical(par-mark) then next .
     2576                   v-alc-code = "" .
     2577                   if num-entries(ret_parts.alc-ref-ab-path) = 4 and entry(3, ret_parts.alc-ref-ab-path) <> "" then do :
     2578                       v-alc-code = entry(3, ret_parts.alc-ref-ab-path) .
     2579                   end.
     2580                   else do :
     2581                       run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     2582                                                          ,input (buffer buf_goods:handle)
     2583                                                          ,output v-gds-uniq-key-rec).
     2584                       find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2585                                                         and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2586                                                         AND X_ext-classif.db-num = 0
     2587                                                         and X_ext-classif.key#_one = buf_goods.gds-code
     2588                                                         and X_ext-classif.key#_two = v-ext-sys
     2589                                                         and X_ext-classif.key#_three = 0
     2590                                                         and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2591                                                         and X_eXt-classif.charkey_two = ""
     2592                                                         and X_eXt-classif.charkey_three = ""
     2593                                                         and X_eXt-classif.nonunique = 0
     2594                                                         no-error .
     2595                       if available X_ext-classif then v-alc-code = X_eXt-classif.charkey_one .
     2596                       else do :
     2597                           message "Товар " string(buf_goods.gds-code) " - " buf_goods.gds-name " не синхронизирован с ЕГАИС" view-as alert-box .
     2598                           next.
     2599                       end.
     2600                   end.
     2601                   find first tt-gds-act exclusive-lock where tt-gds-act.alc-code = v-alc-code no-error.
     2602                   if available tt-gds-act
     2603                   then do :
     2604                       assign tt-gds-act.qnty = tt-gds-act.qnty - (ret_parts.fact-qnty / ret_parts.cli-base-rate) .
     2605                   end.
     2606               end.
     2607           end.
     2608       end.
     2609       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2610   END.
     2611   on choose of menu-item m-marks in menu m-add
     2612   DO:
     2613       run bge/egais-ab-marks.w (parparentproc, tt-act-header.num, ?, "", 0, 'ИЗМЕНЕНИЕ':U, input-output table tt-marks) .
     2614       for each tt-marks exclusive-lock where tt-marks.gds-part-position_ = ? and tt-marks.num = tt-act-header.num :
     2615           find first tt-gds-act exclusive-lock where tt-gds-act.alc-code = tt-marks.alc-code no-error .
     2616           if not available tt-gds-act then do :
     2617               find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2618                                                  and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2619                                                  AND X_ext-classif.db-num = 0
     2620                                                  and X_ext-classif.key#_two = v-ext-sys
     2621                                                  and X_ext-classif.key#_three = 0
     2622                                                  and X_ext-classif.charkey_one = tt-marks.alc-code
     2623                                                  and X_eXt-classif.charkey_two = ""
     2624                                                  and X_eXt-classif.charkey_three = ""
     2625                                                  and X_eXt-classif.nonunique = 0
     2626                                                  .
     2627               find first buf_goods no-lock where buf_goods.gds-code = X_ext-classif.key#_one .
     2628               nn = nn + 1 .
     2629               create tt-gds-act .
     2630               assign
     2631                   tt-gds-act.gds-code         = buf_goods.gds-code
     2632                   tt-gds-act.alc-code         = X_ext-classif.charkey_one
     2633                   tt-gds-act.gds-name         = buf_goods.gds-name
     2634                   tt-gds-act.num              = tt-act-header.num
     2635                   tt-gds-act.position_        = nn
     2636                   tt-gds-act.marks-qnty       = 0
     2637               .
     2638               find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     2639                                                      and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     2640                                                      and X_ext-classif-attr.db-num = X_ext-classif.db-num
     2641                                                      and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     2642                                                      and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     2643                                                      and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     2644                                                      and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     2645                                                      and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     2646                                                      and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     2647                                                      and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     2648                                                      and X_ext-classif-attr.attr-code = 'egais-info'
     2649                                                      no-error .
     2650               if available X_ext-classif-attr then assign tt-gds-act.egais-name = entry(3, X_ext-classif-attr.attr-value, CHR(4)) no-error.
     2651           end.
     2652           if not can-find(buf_tt-marks where buf_tt-marks.mark = tt-marks.mark
     2653                                          and buf_tt-marks.gds-part-position_ <> ?)
     2654           then
     2655           assign
     2656               tt-marks.gds-part-position_ = tt-gds-act.position_
     2657               tt-gds-act.marks-qnty       = tt-gds-act.marks-qnty + 1
     2658               tt-gds-act.qnty             = tt-gds-act.qnty + 1
     2659           .
     2660       end.
     2661       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2662   END.
     2663   on choose of menu-item m-file in menu m-add
     2664   DO:
     2665       define variable ll_commit AS LOG    NO-UNDO INIT NO.
     2666       define variable v-init-dir as character no-undo .
     2667       DEFINE variable v_os-file   AS CHAR NO-UNDO INIT "".
     2668       define variable v-line as character no-undo .
     2669       define variable v-err AS LOG    NO-UNDO INIT NO.
     2670       define variable v-user-action    as character no-undo.
     2671       define variable v-printed        as logical   no-undo.
     2672       SYSTEM-DIALOG GET-FILE v_os-file
     2673           TITLE "Выберите файл для импорта"
     2674           FILTERS
     2675             " Текстовые файлы (*.csv) " "*.csv",
     2676             " Текстовые файлы (*.txt) " "*.txt",
     2677             " Все файлы (*.*) "                      "*.*"
     2678           INITIAL-DIR v-init-dir
     2679           must-exist
     2680           update ll_commit
     2681           default-extension "csv"
     2682           .
     2683       IF ll_commit <> YES THEN do:
     2684          RETURN NO-APPLY.
     2685       end.
     2686       IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
     2687           BELL.
     2688           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
     2689           RETURN NO-APPLY.
     2690       END.
     2691       input from value(v_os-file) .
     2692           repeat :
     2693               import unformatted v-line .
     2694               nn = nn + 1 .
     2695               create tt-gds-act .
     2696               assign
     2697                   tt-gds-act.alc-code         = entry(1, v-line, ";")
     2698                   tt-gds-act.num              = tt-act-header.num
     2699                   tt-gds-act.qnty             = decimal(entry(2, v-line, ";"))
     2700                   tt-gds-act.position_        = nn
     2701               .
     2702               find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2703                                                  and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2704                                                  AND X_ext-classif.db-num = 0
     2705                                                  and X_ext-classif.key#_two = v-ext-sys
     2706                                                  and X_ext-classif.key#_three = 0
     2707                                                  and X_eXt-classif.charkey_one = tt-gds-act.alc-code
     2708                                                  and X_eXt-classif.charkey_two = ""
     2709                                                  and X_eXt-classif.charkey_three = ""
     2710                                                  and X_eXt-classif.nonunique = 0 no-error .
     2711               if available X_ext-classif
     2712               then do :
     2713                   assign tt-gds-act.gds-code = X_ext-classif.key#_one .
     2714                   find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     2715                                                          and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     2716                                                          and X_ext-classif-attr.db-num = X_ext-classif.db-num
     2717                                                          and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     2718                                                          and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     2719                                                          and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     2720                                                          and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     2721                                                          and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     2722                                                          and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     2723                                                          and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     2724                                                          and X_ext-classif-attr.attr-code = 'egais-info'
     2725                                                          no-error .
     2726                   if available X_ext-classif-attr then
     2727                   assign tt-gds-act.gds-name = entry(3, X_ext-classif-attr.attr-value, CHR(4)) no-error.
     2728               end.
     2729           end.
     2730       input close .
     2731       output to value("alccodes-imp_log.txt") .
     2732       for each tt-gds-act exclusive-lock where tt-gds-act.gds-code = 0 or tt-gds-act.gds-code = ? :
     2733           v-err = true .
     2734           put unformatted tt-gds-act.alc-code " - не найдено соответствие с товаром TH" skip .
     2735           delete tt-gds-act .
     2736       end.
     2737       output close .
     2738       if v-err then do :
     2739           message "Не все строки добавлены в акт!" view-as alert-box .
     2740           run gbl/prnfilen.w
     2741              (input  "Ошибки при добавлении товаров"
     2742              ,input  0
     2743              ,input  "alccodes-imp_log.txt"
     2744              ,input  7
     2745              ,output v-user-action
     2746              ,output v-printed
     2747              ).
     2748       end.
     2749       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2750   END.
     2751   on choose of menu-item m-one-good in menu m-add
     2752   DO:
     2753       run ref/gds-ref.p
     2754       ( parparentproc
     2755       ,'b-sel,b-add'
     2756       ,?
     2757       ,?
     2758       ,'все':U
     2759       ,?
     2760       ,?
     2761       ,?
     2762       ,?
     2763       ,v-cntxt-obj-type
     2764       ,v-cntxt-obj-code
     2765       ,?
     2766       , output v-rid-list) no-error.
     2767       if v-rid-list = "" or v-rid-list = ?
     2768       then return no-apply.
     2769       find buf_goods where recid (buf_goods) = integer(v-rid-list) no-lock.
     2770       run gds-attr-value(
     2771         buf_goods.gds-code,
     2772         'alcohol-prod':U,
     2773         output par-alcohol,
     2774         output par-type
     2775       ).
     2776       if par-alcohol = "" or par-alcohol = "no" then
     2777       do :
     2778           message "Выбранный товар не является алкогольной продукцией." view-as alert-box.
     2779           return no-apply .
     2780       end.
     2781       run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     2782                                           ,input (buffer buf_goods:handle)
     2783                                           ,output v-gds-uniq-key-rec).
     2784       exts = 0 .
     2785       for each X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2786                                          and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2787                                          AND X_ext-classif.db-num = 0
     2788                                          and X_ext-classif.key#_one = buf_goods.gds-code
     2789                                          and X_ext-classif.key#_two = v-ext-sys
     2790                                          and X_ext-classif.key#_three = 0
     2791                                          and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2792                                          and X_eXt-classif.charkey_two = ""
     2793                                          and X_eXt-classif.charkey_three = ""
     2794                                          and X_eXt-classif.nonunique = 0 :
     2795           find first tt-exts no-lock where tt-exts.ext-rec = recid(x_ext-classif)
     2796                                            and tt-exts.gds-code = buf_goods.gds-code no-error.
     2797           if not available tt-exts then do :
     2798               create tt-exts .
     2799               assign
     2800                   tt-exts.ext-rec = recid(X_ext-classif)
     2801                   tt-exts.gds-code = buf_goods.gds-code
     2802               .
     2803           end.
     2804           exts = exts + 1 .
     2805       end.
     2806       if exts = 0 then do :
     2807           message "Выбранный товар не синхронизирован с ЕГАИС. (Нет алкогольного кода)" view-as alert-box.
     2808           return no-apply.
     2809       end.
     2810       else if exts = 1 then do :
     2811           find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2812                                              and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2813                                              AND X_ext-classif.db-num = 0
     2814                                              and X_ext-classif.key#_one = buf_goods.gds-code
     2815                                              and X_ext-classif.key#_two = v-ext-sys
     2816                                              and X_ext-classif.key#_three = 0
     2817                                              and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2818                                              and X_eXt-classif.charkey_two = ""
     2819                                              and X_eXt-classif.charkey_three = ""
     2820                                              and X_eXt-classif.nonunique = 0
     2821                                              .
     2822       end.
     2823       else do :
     2824           run bge/egais-select-alc-code.w (input buf_goods.gds-code, output p-ext-rec) .
     2825           find first X_ext-classif no-lock where recid(X_ext-classif) = p-ext-rec no-error .
     2826           if not available X_ext-classif then return no-apply.
     2827       end.
     2828       nn = nn + 1 .
     2829       create tt-gds-act .
     2830       assign
     2831           tt-gds-act.gds-code         = buf_goods.gds-code
     2832           tt-gds-act.alc-code         = if available X_ext-classif then X_ext-classif.charkey_one else ""
     2833           tt-gds-act.gds-name         = buf_goods.gds-name
     2834           tt-gds-act.num              = tt-act-header.num
     2835           tt-gds-act.position_        = nn
     2836           tt-gds-act.qnty       = 0
     2837       .
     2838       find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     2839                                              and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     2840                                              and X_ext-classif-attr.db-num = X_ext-classif.db-num
     2841                                              and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     2842                                              and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     2843                                              and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     2844                                              and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     2845                                              and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     2846                                              and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     2847                                              and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     2848                                              and X_ext-classif-attr.attr-code = 'egais-info'
     2849                                              no-error .
     2850       if available X_ext-classif-attr then assign tt-gds-act.egais-name = entry(3, X_ext-classif-attr.attr-value, CHR(4)) no-error.
     2851       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2852       apply "value-changed" to br-gds-act IN FRAME Dialog-Frame .
     2853   END.
     2854   on choose of b-alc-code IN FRAME Dialog-Frame
     2855   do :
     2856       if not available tt-gds-act then return no-apply .
     2857       run bge/egais-select-alc-code.w (input tt-gds-act.gds-code, output p-ext-rec) .
     2858       find first X_ext-classif no-lock where recid(X_ext-classif) = p-ext-rec no-error .
     2859       if not available X_ext-classif then return no-apply.
     2860       assign tt-gds-act.alc-code = X_ext-classif.charkey_one .
     2861       find first X_ext-classif-attr no-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     2862                                              and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     2863                                              and X_ext-classif-attr.db-num = X_ext-classif.db-num
     2864                                              and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     2865                                              and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     2866                                              and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     2867                                              and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     2868                                              and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     2869                                              and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     2870                                              and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     2871                                              and X_ext-classif-attr.attr-code = 'egais-info'
     2872                                              no-error .
     2873       if available X_ext-classif-attr then assign tt-gds-act.egais-name = entry(3, X_ext-classif-attr.attr-value, CHR(4)) no-error.
     2874       br-gds-act:refresh() .
     2875   end.
     2876   on row-display of br-gds-act in FRAME Dialog-Frame
     2877   DO :
     2878       exts = 0 .
     2879       for each tt-exts no-lock where tt-exts.gds-code = tt-gds-act.gds-code :
     2880           exts = exts + 1 .
     2881       end.
     2882       if exts > 1 then tt-gds-act.alc-code:bgcolor in browse br-gds-act = yellow_color .
     2883   end.
     2884   on value-changed of br-gds-act IN FRAME Dialog-Frame
     2885   DO :
     2886   if available tt-gds-act then do :
     2887       exts = 0 .
     2888       for each tt-exts no-lock where tt-exts.gds-code = tt-gds-act.gds-code :
     2889           exts = exts + 1 .
     2890       end.
     2891       if exts > 1 then enable b-alc-code WITH FRAME Dialog-Frame.
     2892       else disable b-alc-code WITH FRAME Dialog-Frame.
     2893   end.
     2894   end.
     2895   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2896   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2897   MAIN-BLOCK:
     2898   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2899      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2900       assign
     2901           b-good:popup-menu in frame Dialog-Frame = menu m-add:handle
     2902           b-good:menu-mouse = 1
     2903           nn = 0
     2904           tt-act-header.type_:list-items = "Пересортица,Недостача,Уценка,Порча,Потери,Проверки,Арест,Иные цели,Реализация"
     2905       .
     2906       if p-mode = 'ДОБАВЛЕНИЕ':U then do :
     2907           v-date = substitute ("&1&2&3", string (day (now), "99"), string (month (now), "99"),substring (string(year (now)), 3,2)).
     2908           create tt-act-header .
     2909           assign
     2910               tt-act-header.num = "AWOS-" + v-date + '-' + substring(v-cntxt-obj-type,1,1) + string(v-cntxt-obj-code) + '-' + string(int(TIME))
     2911               tt-act-header.date_ = TODAY
     2912               tt-act-header.type_ = "Реализация"
     2913               tt-act-header.is-sent = no
     2914           .
     2915           display tt-act-header.num tt-act-header.date_ tt-act-header.type_ with frame Dialog-Frame.
     2916           enable  tt-act-header.date_ tt-act-header.type_ b-good with frame Dialog-Frame.
     2917           apply "value-changed" to tt-act-header.type_ IN FRAME Dialog-Frame .
     2918       end.
     2919       if p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ПРОСМОТР':U then do :
     2920           find last buf_clob-bind where buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value
     2921                                     and buf_clob-bind.field-name_ = 'egais-awo_shop':U
     2922                                     and buf_clob-bind.part-num = 1  .
     2923           find first buf_clob-data no-lock where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     2924           copy-lob
     2925           from  object buf_clob-data.cdata
     2926           to  file 'temp.xml'
     2927           no-convert
     2928           no-error .
     2929           run waitfram-show in this-procedure ("Ждите...") .
     2930           empty temp-table tt-marks no-error .
     2931           run parseXML in this-procedure (input "temp.xml") .
     2932           run waitfram-hide in this-procedure .
     2933           display tt-act-header.num tt-act-header.date_ tt-act-header.type_ with frame Dialog-Frame.
     2934           if p-mode = 'ИЗМЕНЕНИЕ':U then do :
     2935               enable  tt-act-header.type_ with frame Dialog-Frame.
     2936               apply "value-changed" to tt-act-header.type_ IN FRAME Dialog-Frame .
     2937           end .
     2938           if p-mode = 'ИЗМЕНЕНИЕ':U then
     2939           for each tt-gds-act no-lock :
     2940               nn = nn + 1 .
     2941               find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code no-error .
     2942               if not available buf_goods then do :
     2943                   message "По алкогольному коду " tt-gds-act.alc-code " не найден товар из TH. Вероятно, кто-то удалил связку." view-as alert-box.
     2944                   next.
     2945               end.
     2946               run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     2947                                               ,input (buffer buf_goods:handle)
     2948                                               ,output v-gds-uniq-key-rec).
     2949               for each X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2950                                              and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2951                                              AND X_ext-classif.db-num = 0
     2952                                              and X_ext-classif.key#_one = buf_goods.gds-code
     2953                                              and X_ext-classif.key#_two = v-ext-sys
     2954                                              and X_ext-classif.key#_three = 0
     2955                                              and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2956                                              and X_eXt-classif.charkey_two = ""
     2957                                              and X_eXt-classif.charkey_three = ""
     2958                                              and X_eXt-classif.nonunique = 0 :
     2959                   find first tt-exts no-lock where tt-exts.ext-rec = recid(x_ext-classif)
     2960                                            and tt-exts.gds-code = buf_goods.gds-code no-error.
     2961                   if not available tt-exts then do :
     2962                       create tt-exts .
     2963                       assign
     2964                           tt-exts.ext-rec = recid(X_ext-classif)
     2965                           tt-exts.gds-code = tt-gds-act.gds-code
     2966                       .
     2967                   end.
     2968               end.
     2969           end .
     2970           open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2971           if p-mode = 'ПРОСМОТР':U then disable b-good with frame Dialog-Frame.
     2972           else enable b-good with frame Dialog-Frame.
     2973       end.
     2974   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2975   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2976   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2977   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2978   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2979   define variable v-diasize-current-frame-height as decimal   no-undo .
     2980   define variable v-diasize-change-size          as logical   no-undo .
     2981   define variable v-diasize-resize-button        as handle    no-undo .
     2982   define variable v-diasize-wndmax               as logical   no-undo .
     2983   define variable v-diasize-wndstore             as logical   no-undo .
     2984   define variable v-diasize-proc-name            as character no-undo .
     2985   define variable v-diasize-browse-handle        as handle    no-undo .
     2986   define variable v-diasize-browse-number        as integer   no-undo .
     2987   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2988   define temp-table temp-diasize-handle no-undo
     2989     field handle-value  as handle
     2990     field save-position as decimal
     2991     index xpk is primary unique handle-value
     2992     .
     2993   define temp-table temp-browse-handle no-undo
     2994     field browse-type   as character
     2995     field browse-number as integer
     2996     field browse-handle as handle
     2997     field original-size as decimal
     2998     index xpk is primary unique browse-type browse-number
     2999     index xie browse-type browse-handle
     3000   .
     3001   procedure diasize_change-height :
     3002     define input  parameter p-change-value  as decimal   no-undo .
     3003     define input  parameter p-move-resize   as logical   no-undo .
     3004     define variable v-field-group-handle    as handle    no-undo .
     3005     define variable v-object-handle         as handle    no-undo .
     3006     define variable v-frame-height          as decimal   no-undo .
     3007     define variable v-frame-virtual-height  as decimal   no-undo .
     3008     define variable v-browse-height         as decimal   no-undo .
     3009     define variable v-window-height         as decimal   no-undo .
     3010     define variable v-window-virtual-height as decimal   no-undo .
     3011     define variable v-change-sign           as integer   no-undo .
     3012     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3013     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3014     if p-change-value > 0
     3015     then do:
     3016       if frame Dialog-Frame :height + p-change-value
     3017           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3018       then do:
     3019         assign
     3020           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3021                           - (frame Dialog-Frame :height-chars)
     3022         .
     3023         if p-change-value <= 0
     3024         then do:
     3025           run diasize_position-resize-button in this-procedure .
     3026           return .
     3027         end.
     3028       end.
     3029     end.
     3030     if p-change-value < 0
     3031     then do:
     3032       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3033       then do:
     3034         assign
     3035           p-change-value = v-diasize-orig-frame-height
     3036                          - (frame Dialog-Frame :height-chars)
     3037         .
     3038         if p-change-value >= 0
     3039         then do:
     3040           run diasize_position-resize-button in this-procedure .
     3041           return .
     3042         end.
     3043       end.
     3044     end.
     3045     if p-change-value >= 0
     3046     then do:
     3047       assign
     3048         v-change-sign = 1
     3049       .
     3050     end.
     3051     else do:
     3052       assign
     3053         v-change-sign = -1
     3054       .
     3055     end.
     3056     assign
     3057       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3058     .
     3059     if p-change-value = 0
     3060     then do:
     3061       run diasize_position-resize-button in this-procedure .
     3062       return .
     3063     end.
     3064     move_block:
     3065     do
     3066     on error undo move_block, retry move_block
     3067     :
     3068       if retry
     3069       then do:
     3070         do
     3071         on error undo move_block, leave move_block
     3072         :
     3073           if p-change-value > 0
     3074           then do:
     3075             for each buf_temp-diasize-handle
     3076             on error undo, next
     3077             :
     3078               assign
     3079                 v-object-handle = buf_temp-diasize-handle.handle-value
     3080               .
     3081               if v-object-handle <> v-diasize-resize-button
     3082               then do:
     3083                 assign
     3084                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3085                 .
     3086               end.
     3087             end.
     3088             assign
     3089               v-diasize-browse-handle :height = v-browse-height
     3090             .
     3091             for each buf_temp-browse-handle
     3092               where buf_temp-browse-handle.browse-type = 'height':u
     3093             on error undo, next
     3094             :
     3095               assign
     3096                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3097               .
     3098             end.
     3099             assign
     3100               frame Dialog-Frame :height = v-frame-height
     3101             .
     3102             if frame Dialog-Frame :scrollable = true
     3103             then do:
     3104               assign
     3105                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3106               .
     3107             end.
     3108             run diasize_position-resize-button in this-procedure .
     3109           end.
     3110           else do:
     3111             if frame Dialog-Frame :scrollable = true
     3112             then do:
     3113               assign
     3114                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3115               .
     3116             end.
     3117             assign
     3118               frame Dialog-Frame :height = v-frame-height
     3119             .
     3120             assign
     3121               v-diasize-browse-handle :height = v-browse-height
     3122             .
     3123             for each buf_temp-browse-handle
     3124               where buf_temp-browse-handle.browse-type = 'height':u
     3125             on error undo, next
     3126             :
     3127               assign
     3128                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3129               .
     3130             end.
     3131             for each buf_temp-diasize-handle
     3132             on error undo, next
     3133             :
     3134               assign
     3135                 v-object-handle = buf_temp-diasize-handle.handle-value
     3136               .
     3137               if v-object-handle <> v-diasize-resize-button
     3138               then do:
     3139                 assign
     3140                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3141                 .
     3142               end.
     3143             end.
     3144             run diasize_position-resize-button in this-procedure .
     3145           end.
     3146           assign
     3147             v-diasize-change-size = false
     3148           .
     3149           leave move_block .
     3150         end.
     3151       end.
     3152       assign
     3153         v-diasize-need-full-display = true
     3154       .
     3155       if v-diasize-change-size = false
     3156       then do:
     3157         assign
     3158           v-diasize-change-size = true
     3159         .
     3160       end.
     3161       else do:
     3162         return .
     3163       end.
     3164       assign
     3165         v-frame-height = frame Dialog-Frame :height
     3166         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3167         v-browse-height = v-diasize-browse-handle :height
     3168       .
     3169       for each buf_temp-browse-handle
     3170         where buf_temp-browse-handle.browse-type = 'height':u
     3171       :
     3172         assign
     3173           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3174         .
     3175       end.
     3176       for each buf_temp-diasize-handle
     3177       :
     3178         delete buf_temp-diasize-handle .
     3179       end.
     3180       assign
     3181         v-field-group-handle = frame Dialog-Frame :first-child
     3182       .
     3183       do while valid-handle(v-field-group-handle)
     3184       :
     3185         assign
     3186           v-object-handle = v-field-group-handle :first-child
     3187         .
     3188         do while valid-handle(v-object-handle)
     3189         :
     3190           if  v-object-handle <> v-diasize-browse-handle :handle
     3191           and can-query(v-object-handle, "row")
     3192           and can-query(v-object-handle, "height")
     3193           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3194           then do:
     3195             find first buf_temp-browse-handle
     3196               where buf_temp-browse-handle.browse-type   = 'height':u
     3197                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3198               no-error .
     3199             if available buf_temp-browse-handle
     3200             then do:
     3201             end.
     3202             else do:
     3203               create buf_temp-diasize-handle .
     3204               assign
     3205                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3206                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3207               .
     3208             end.
     3209           end.
     3210           assign
     3211             v-object-handle = v-object-handle :next-sibling
     3212           .
     3213         end.
     3214         assign
     3215           v-field-group-handle = v-field-group-handle :next-sibling
     3216         .
     3217       end.
     3218       do with frame Dialog-Frame
     3219       :
     3220         hide v-diasize-resize-button .
     3221         assign
     3222           v-diasize-resize-button :row    = 1
     3223           v-diasize-resize-button :column = 1
     3224         .
     3225       end.
     3226       if p-change-value > 0
     3227       then do:
     3228         if frame Dialog-Frame :scrollable = true
     3229         then do:
     3230           assign
     3231             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3232             no-error .
     3233           if error-status :error
     3234           or error-status :get-message(1) <> ""
     3235           then do:
     3236             undo move_block, retry move_block .
     3237           end.
     3238         end.
     3239         assign
     3240           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3241           no-error .
     3242         if error-status :error
     3243         or error-status :get-message(1) <> ""
     3244         then do:
     3245           undo move_block, retry move_block .
     3246         end.
     3247         assign
     3248           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3249           no-error .
     3250         if error-status :error
     3251         or error-status :get-message(1) <> ""
     3252         then do:
     3253           undo move_block, retry move_block .
     3254         end.
     3255         for each buf_temp-browse-handle
     3256           where buf_temp-browse-handle.browse-type = 'height':u
     3257         on error undo move_block, retry move_block
     3258         :
     3259           assign
     3260             buf_temp-browse-handle.browse-handle :height
     3261               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3262             no-error .
     3263           if error-status :error
     3264           or error-status :get-message(1) <> ""
     3265           then do:
     3266             undo move_block, retry move_block .
     3267           end.
     3268         end.
     3269         for each buf_temp-diasize-handle
     3270         on error undo move_block, retry move_block
     3271         :
     3272           assign
     3273             v-object-handle = buf_temp-diasize-handle.handle-value
     3274           .
     3275           if v-object-handle <> v-diasize-resize-button
     3276           then do:
     3277             assign
     3278               v-object-handle :row = v-object-handle :row + p-change-value
     3279               no-error .
     3280             if error-status :error
     3281             or error-status :get-message(1) <> ""
     3282             then do:
     3283               undo move_block, retry move_block .
     3284             end.
     3285           end.
     3286         end.
     3287       end.
     3288       else do:
     3289         for each buf_temp-diasize-handle
     3290         on error undo move_block, retry move_block
     3291         :
     3292           assign
     3293             v-object-handle = buf_temp-diasize-handle.handle-value
     3294           .
     3295           if v-object-handle <> v-diasize-resize-button
     3296           then do:
     3297             assign
     3298               v-object-handle :row = v-object-handle :row + p-change-value
     3299               no-error .
     3300             if error-status :error
     3301             or error-status :get-message(1) <> ""
     3302             then do:
     3303               undo move_block, retry move_block .
     3304             end.
     3305           end.
     3306         end.
     3307         assign
     3308           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3309           no-error .
     3310         if error-status :error
     3311         or error-status :get-message(1) <> ""
     3312         then do:
     3313           undo move_block, retry move_block .
     3314         end.
     3315         for each buf_temp-browse-handle
     3316           where buf_temp-browse-handle.browse-type = 'height':u
     3317         on error undo move_block, retry move_block
     3318         :
     3319           assign
     3320             buf_temp-browse-handle.browse-handle :height
     3321               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3322             no-error .
     3323           if error-status :error
     3324           or error-status :get-message(1) <> ""
     3325           then do:
     3326             undo move_block, retry move_block .
     3327           end.
     3328         end.
     3329         assign
     3330           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3331           no-error .
     3332         if error-status :error
     3333         or error-status :get-message(1) <> ""
     3334         then do:
     3335           undo move_block, retry move_block .
     3336         end.
     3337         if frame Dialog-Frame :scrollable = true
     3338         then do:
     3339           assign
     3340             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3341             no-error .
     3342           if error-status :error
     3343           or error-status :get-message(1) <> ""
     3344           then do:
     3345             undo move_block, retry move_block .
     3346           end.
     3347         end.
     3348       end.
     3349       if p-move-resize = true
     3350       then do:
     3351         run diasize_position-resize-button in this-procedure .
     3352       end.
     3353       if v-diasize-wndstore = true
     3354       then do:
     3355         if connected("ub") = true
     3356         then do:
     3357           define variable v-cntxt-db-num        as integer   no-undo .
     3358           define variable v-cntxt-userid        as character no-undo .
     3359           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3360                                             , OUTPUT v-cntxt-userid
     3361                                             ) .
     3362           run gbl/wndsizew.p
     3363             (input  v-cntxt-db-num
     3364             ,input  v-cntxt-userid
     3365             ,input  v-diasize-proc-name
     3366             ,input  'height':u
     3367             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3368             ) .
     3369         end.
     3370       end.
     3371     end.
     3372     assign
     3373       v-diasize-change-size = false
     3374     .
     3375   end procedure.
     3376   procedure diasize_set-height :
     3377     define input  parameter p-new-height  as decimal   no-undo .
     3378     define input  parameter p-move-resize as logical   no-undo .
     3379     do
     3380     on error undo, return error return-value
     3381     :
     3382       run diasize_change-height in this-procedure
     3383         (input  (p-new-height - frame Dialog-Frame :height)
     3384         ,input  p-move-resize
     3385         ) .
     3386     end.
     3387   end procedure.
     3388   procedure diasize_change-width :
     3389     define input  parameter p-change-value as decimal   no-undo .
     3390     define input  parameter p-move-resize  as logical   no-undo .
     3391     define variable v-field-group-handle   as handle    no-undo .
     3392     define variable v-object-handle        as handle    no-undo .
     3393     define variable v-frame-width          as decimal   no-undo .
     3394     define variable v-frame-virtual-width  as decimal   no-undo .
     3395     define variable v-browse-width         as decimal   no-undo .
     3396     define variable v-window-width         as decimal   no-undo .
     3397     define variable v-window-virtual-width as decimal   no-undo .
     3398     define variable v-change-sign          as integer   no-undo .
     3399     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3400     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3401     if p-change-value > 0
     3402     then do:
     3403       if frame Dialog-Frame :width + p-change-value >
     3404           session :width-chars
     3405       then do:
     3406         assign
     3407           p-change-value = session :width-chars - frame Dialog-Frame :width
     3408         .
     3409         if p-change-value <= 0
     3410         then do:
     3411           run diasize_position-resize-button in this-procedure .
     3412           return .
     3413         end.
     3414       end.
     3415     end.
     3416     if p-change-value < 0
     3417     then do:
     3418       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3419       then do:
     3420         assign
     3421           p-change-value = v-diasize-orig-frame-width
     3422                          - frame Dialog-Frame :width
     3423         .
     3424         if p-change-value >= 0
     3425         then do:
     3426           run diasize_position-resize-button in this-procedure .
     3427           return .
     3428         end.
     3429       end.
     3430     end.
     3431     if p-change-value >= 0
     3432     then do:
     3433       assign
     3434         v-change-sign = 1
     3435       .
     3436     end.
     3437     else do:
     3438       assign
     3439         v-change-sign = -1
     3440       .
     3441     end.
     3442     assign
     3443       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3444     .
     3445     if p-change-value = 0
     3446     then do:
     3447       run diasize_position-resize-button in this-procedure .
     3448       return .
     3449     end.
     3450     move_block:
     3451     do
     3452     on error undo move_block, leave move_block
     3453     :
     3454       if retry
     3455       then do:
     3456         do
     3457         on error undo move_block, leave move_block
     3458         :
     3459           if p-change-value > 0
     3460           then do:
     3461             for each buf_temp-diasize-handle
     3462             on error undo, next
     3463             :
     3464               assign
     3465                 v-object-handle = buf_temp-diasize-handle.handle-value
     3466               .
     3467               if v-object-handle <> v-diasize-resize-button
     3468               then do:
     3469                 assign
     3470                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3471                 .
     3472               end.
     3473             end.
     3474             assign
     3475               v-diasize-browse-handle :width = v-browse-width
     3476             .
     3477             for each buf_temp-browse-handle
     3478               where buf_temp-browse-handle.browse-type = 'width':u
     3479             on error undo, next
     3480             :
     3481               assign
     3482                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3483               .
     3484             end.
     3485             assign
     3486               frame Dialog-Frame :width = v-frame-width
     3487             .
     3488             if frame Dialog-Frame :scrollable = true
     3489             then do:
     3490               assign
     3491                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3492               .
     3493             end.
     3494             run diasize_position-resize-button in this-procedure .
     3495           end.
     3496           else do:
     3497             if frame Dialog-Frame :scrollable = true
     3498             then do:
     3499               assign
     3500                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3501               .
     3502             end.
     3503             assign
     3504               frame Dialog-Frame :width = v-frame-width
     3505             .
     3506             for each buf_temp-browse-handle
     3507               where buf_temp-browse-handle.browse-type = 'width':u
     3508             on error undo, next
     3509             :
     3510               assign
     3511                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3512               .
     3513             end.
     3514             assign
     3515               v-diasize-browse-handle :width = v-browse-width
     3516             .
     3517             for each buf_temp-diasize-handle
     3518             on error undo, next
     3519             :
     3520               assign
     3521                 v-object-handle = buf_temp-diasize-handle.handle-value
     3522               .
     3523               if v-object-handle <> v-diasize-resize-button
     3524               then do:
     3525                 assign
     3526                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3527                 .
     3528               end.
     3529             end.
     3530             run diasize_position-resize-button in this-procedure .
     3531           end.
     3532           assign
     3533             v-diasize-change-size = false
     3534           .
     3535           leave move_block .
     3536         end.
     3537       end.
     3538       assign
     3539         v-diasize-need-full-display = true
     3540       .
     3541       if v-diasize-change-size = false
     3542       then do:
     3543         assign
     3544           v-diasize-change-size = true
     3545         .
     3546       end.
     3547       else do:
     3548         return .
     3549       end.
     3550       assign
     3551         v-frame-width = frame Dialog-Frame :width
     3552         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3553         v-browse-width = v-diasize-browse-handle :width
     3554       .
     3555       for each buf_temp-browse-handle
     3556         where buf_temp-browse-handle.browse-type = 'width':u
     3557       :
     3558         assign
     3559           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3560         .
     3561       end.
     3562       for each buf_temp-diasize-handle
     3563       :
     3564         delete buf_temp-diasize-handle .
     3565       end.
     3566       assign
     3567         v-field-group-handle = frame Dialog-Frame :first-child
     3568       .
     3569       do while valid-handle(v-field-group-handle)
     3570       :
     3571         assign
     3572           v-object-handle = v-field-group-handle :first-child
     3573         .
     3574         do while valid-handle(v-object-handle)
     3575         :
     3576           if  v-object-handle <> v-diasize-browse-handle :handle
     3577           and v-object-handle <> v-diasize-resize-button
     3578           and can-query(v-object-handle, "row")
     3579           and can-query(v-object-handle, "height")
     3580           and ( v-object-handle :col + v-object-handle :width
     3581                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3582               )
     3583           then do:
     3584             find first buf_temp-browse-handle
     3585               where buf_temp-browse-handle.browse-type   = 'width':u
     3586                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3587               no-error .
     3588             if available buf_temp-browse-handle
     3589             then do:
     3590             end.
     3591             else do:
     3592               create buf_temp-diasize-handle .
     3593               assign
     3594                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3595                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3596               .
     3597             end.
     3598           end.
     3599           assign
     3600             v-object-handle = v-object-handle :next-sibling
     3601           .
     3602         end.
     3603         assign
     3604           v-field-group-handle = v-field-group-handle :next-sibling
     3605         .
     3606       end.
     3607       do with frame Dialog-Frame
     3608       :
     3609         hide v-diasize-resize-button .
     3610         v-diasize-resize-button :row = 1.
     3611         v-diasize-resize-button :column = 1.
     3612       end.
     3613       if p-change-value > 0
     3614       then do:
     3615         if frame Dialog-Frame :scrollable = true
     3616         then do:
     3617           assign
     3618             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3619             no-error .
     3620           if error-status :error
     3621           or error-status :get-message(1) <> ""
     3622           then do:
     3623             undo move_block, retry move_block.
     3624           end.
     3625         end.
     3626         assign
     3627           frame Dialog-Frame :width = v-frame-width + p-change-value
     3628           no-error .
     3629         if error-status :error
     3630         or error-status :get-message(1) <> ""
     3631         then do:
     3632           undo move_block, retry move_block.
     3633         end.
     3634         assign
     3635           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3636         no-error .
     3637         if error-status :error
     3638         or error-status :get-message(1) <> ""
     3639         then do:
     3640           undo move_block, retry move_block.
     3641         end.
     3642         for each buf_temp-browse-handle
     3643           where buf_temp-browse-handle.browse-type = 'width':u
     3644         on error undo move_block, retry move_block
     3645         :
     3646           assign
     3647             buf_temp-browse-handle.browse-handle :width
     3648               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3649             no-error .
     3650           if error-status :error
     3651           or error-status :get-message(1) <> ""
     3652           then do:
     3653             undo move_block, retry move_block .
     3654           end.
     3655         end.
     3656         for each buf_temp-diasize-handle
     3657         on error undo move_block, retry move_block
     3658         :
     3659           assign
     3660             v-object-handle = buf_temp-diasize-handle.handle-value
     3661           .
     3662           if v-object-handle <> v-diasize-resize-button
     3663           then do:
     3664             assign
     3665               v-object-handle :col = v-object-handle :col + p-change-value
     3666               no-error .
     3667             if error-status :error
     3668             or error-status :get-message(1) <> ""
     3669             then do:
     3670               undo move_block, retry move_block .
     3671             end.
     3672           end.
     3673         end.
     3674       end.
     3675       else do:
     3676         for each buf_temp-diasize-handle
     3677         on error undo move_block, retry move_block
     3678         :
     3679           assign
     3680             v-object-handle = buf_temp-diasize-handle.handle-value
     3681           .
     3682           if v-object-handle <> v-diasize-resize-button
     3683           then do:
     3684             assign
     3685               v-object-handle :col = v-object-handle :col + p-change-value
     3686               no-error .
     3687             if error-status :error
     3688             or error-status :get-message(1) <> ""
     3689             then do:
     3690               undo move_block, retry move_block .
     3691             end.
     3692           end.
     3693         end.
     3694         for each buf_temp-browse-handle
     3695           where buf_temp-browse-handle.browse-type = 'width':u
     3696         on error undo move_block, retry move_block
     3697         :
     3698           assign
     3699             buf_temp-browse-handle.browse-handle :width
     3700               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3701             no-error .
     3702           if error-status :error
     3703           or error-status :get-message(1) <> ""
     3704           then do:
     3705             undo move_block, retry move_block .
     3706           end.
     3707         end.
     3708         assign
     3709           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3710           no-error .
     3711         if error-status :error
     3712         or error-status :get-message(1) <> ""
     3713         then do:
     3714           undo move_block, retry move_block.
     3715         end.
     3716         assign
     3717           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3718         no-error .
     3719         if error-status :error
     3720         or error-status :get-message(1) <> ""
     3721         then do:
     3722           undo move_block, retry move_block.
     3723         end.
     3724         if frame Dialog-Frame :scrollable = true
     3725         then do:
     3726           assign
     3727             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3728           no-error .
     3729           if error-status :error
     3730           or error-status :get-message(1) <> ""
     3731           then do:
     3732             undo move_block, retry move_block.
     3733           end.
     3734         end.
     3735       end.
     3736       if p-move-resize
     3737       then do:
     3738         run diasize_position-resize-button in this-procedure .
     3739       end.
     3740       if v-diasize-wndstore = true
     3741       then do:
     3742         if connected("ub") = true
     3743         then do:
     3744           define variable v-cntxt-db-num        as integer   no-undo .
     3745           define variable v-cntxt-userid        as character no-undo .
     3746           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3747                                             , OUTPUT v-cntxt-userid
     3748                                             ) .
     3749           run gbl/wndsizew.p
     3750             (input  v-cntxt-db-num
     3751             ,input  v-cntxt-userid
     3752             ,input  v-diasize-proc-name
     3753             ,input  'width':u
     3754             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3755             ) .
     3756         end.
     3757       end.
     3758     end.
     3759     assign
     3760       v-diasize-change-size = false
     3761     .
     3762   end procedure.
     3763   procedure diasize_set-width :
     3764     define input  parameter p-new-width  as decimal   no-undo .
     3765     define input  parameter p-move-resize as logical   no-undo .
     3766     do
     3767     on error undo, return error return-value
     3768     :
     3769       run diasize_change-width in this-procedure
     3770         (input  (p-new-width - frame Dialog-Frame :width)
     3771         ,input  p-move-resize
     3772         ) .
     3773     end.
     3774   end procedure.
     3775   procedure diasize_position-resize-button :
     3776     do with frame Dialog-Frame
     3777     :
     3778       hide v-diasize-resize-button .
     3779       assign
     3780         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3781                     - 1
     3782                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3783         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3784                     - 1
     3785                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3786       .
     3787       view v-diasize-resize-button .
     3788     end.
     3789   end procedure.
     3790   on alt-right anywhere
     3791   do:
     3792     run diasize_change-width in this-procedure
     3793       (input 1
     3794       ,input true
     3795       ) .
     3796     return no-apply .
     3797   end.
     3798   on alt-left anywhere
     3799   do:
     3800     run diasize_change-width in this-procedure
     3801       (input -1
     3802       ,input true
     3803       ) .
     3804     return no-apply .
     3805   end.
     3806   on alt-down anywhere
     3807   do:
     3808     run diasize_change-height in this-procedure
     3809       (input 1
     3810       ,input true
     3811       ) .
     3812     return no-apply .
     3813   end.
     3814   on alt-up anywhere
     3815   do:
     3816     run diasize_change-height in this-procedure
     3817       (input -1
     3818       ,input true
     3819       ) .
     3820     return no-apply .
     3821   end.
     3822   on alt-enter of frame Dialog-Frame
     3823   do:
     3824     run diasize_maximize in this-procedure
     3825       (input  ?
     3826       ).
     3827     return no-apply .
     3828   end.
     3829   procedure diasize_end-move :
     3830     do
     3831     on error undo, return error return-value
     3832     :
     3833       define variable v-row-delta as decimal   no-undo .
     3834       define variable v-col-delta as decimal   no-undo .
     3835       define variable v-new-row as decimal   no-undo .
     3836       define variable v-new-col as decimal   no-undo .
     3837       assign
     3838         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3839         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3840       .
     3841       assign
     3842         v-row-delta = v-new-row - frame Dialog-Frame :height
     3843         v-col-delta = v-new-col - frame Dialog-Frame :width
     3844       .
     3845       run diasize_change-height in this-procedure
     3846         (input v-row-delta
     3847         ,input true
     3848         ) .
     3849       run diasize_change-width in this-procedure
     3850         (input v-col-delta
     3851         ,input true
     3852         ) .
     3853     end.
     3854   end procedure.
     3855   procedure diasize_maximize :
     3856     define input  parameter p-action as logical   no-undo .
     3857     do
     3858     on error undo, return error return-value
     3859     :
     3860       if p-action = ?
     3861       then do:
     3862         if v-diasize-need-maximize = true
     3863         then do:
     3864           assign
     3865             p-action = true
     3866           .
     3867         end.
     3868         else do:
     3869           assign
     3870             p-action = false
     3871           .
     3872         end.
     3873       end.
     3874       if p-action = true
     3875       then do:
     3876         run diasize_change-height in this-procedure
     3877           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3878               - frame Dialog-Frame :height-chars
     3879           ,input true
     3880           ) .
     3881         run diasize_change-width in this-procedure
     3882           (input session :width-chars
     3883               - frame Dialog-Frame :width-chars
     3884           ,input true
     3885           ) .
     3886         assign
     3887           v-diasize-need-maximize = false
     3888         .
     3889       end.
     3890       else do:
     3891         run diasize_change-width in this-procedure
     3892           (input v-diasize-orig-frame-width
     3893               - frame Dialog-Frame :width-chars
     3894           ,input true
     3895           ) .
     3896         run diasize_change-height in this-procedure
     3897           (input v-diasize-orig-frame-height
     3898               - frame Dialog-Frame :height-chars
     3899           ,input true
     3900           ) .
     3901         assign
     3902           v-diasize-need-maximize = true
     3903         .
     3904       end.
     3905     end.
     3906   end procedure.
     3907   procedure diasize_restore-orig-size :
     3908     do
     3909     on error undo, return error return-value
     3910     :
     3911       assign
     3912         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3913         v-diasize-current-frame-height = frame Dialog-Frame :height
     3914       .
     3915       run diasize_set-height in this-procedure
     3916         (input  v-diasize-orig-frame-height
     3917         ,input  true
     3918         ) .
     3919       run diasize_set-width in this-procedure
     3920         (input  v-diasize-orig-frame-width
     3921         ,input  true
     3922         ) .
     3923     end.
     3924   end procedure.
     3925   procedure diasize_restore-current-size :
     3926     do
     3927     on error undo, return error return-value
     3928     :
     3929       run diasize_set-height in this-procedure
     3930         (input  v-diasize-current-frame-height
     3931         ,input  true
     3932         ) .
     3933       run diasize_set-width in this-procedure
     3934         (input  v-diasize-current-frame-width
     3935         ,input  true
     3936         ) .
     3937     end.
     3938   end procedure.
     3939   procedure diasize_set-browse-handle :
     3940     define input  parameter p-browse-handle as handle   no-undo .
     3941     define buffer buf_temp-browse-handle for temp-browse-handle .
     3942     do
     3943     on error undo, return error return-value
     3944     :
     3945       assign
     3946         v-diasize-browse-handle = p-browse-handle
     3947       .
     3948       for each buf_temp-browse-handle
     3949       on error undo, return error return-value
     3950       :
     3951         delete buf_temp-browse-handle .
     3952       end.
     3953     end.
     3954   end procedure.
     3955   procedure diasize_add_browse :
     3956     define input  parameter p-browse-type   as character no-undo .
     3957     define input  parameter p-browse-handle as handle    no-undo .
     3958     define buffer buf_temp-browse-handle for temp-browse-handle .
     3959     do
     3960     on error undo, return error return-value
     3961     :
     3962       assign
     3963         v-diasize-browse-number = v-diasize-browse-number + 1
     3964       .
     3965       create buf_temp-browse-handle .
     3966       assign
     3967         buf_temp-browse-handle.browse-type   = p-browse-type
     3968         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3969         buf_temp-browse-handle.browse-handle = p-browse-handle
     3970       .
     3971     end.
     3972   end procedure.
     3973   procedure diasize_init :
     3974     define variable v-default-value    as logical   no-undo .
     3975     define variable v-restore-saved    as logical   no-undo .
     3976     define variable v-resize-value-str as character no-undo .
     3977     do
     3978     on error undo, return error return-value
     3979     :
     3980       do with frame Dialog-Frame
     3981       :
     3982         assign
     3983           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3984           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3985           v-diasize-browse-handle     = browse br-gds-act :handle
     3986         .
     3987         create button v-diasize-resize-button
     3988         assign
     3989           parent        = frame Dialog-Frame :first-child
     3990           label         = "s"
     3991           height-pixels = 16
     3992           width-pixels  = 16
     3993           visible       = true
     3994           sensitive     = true
     3995           movable       = true
     3996           triggers:
     3997             on end-move persistent run diasize_end-move in this-procedure .
     3998           end triggers.
     3999         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4000         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4001         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4002         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4003         assign
     4004           v-diasize-wndmax = false
     4005         .
     4006         if connected("ub") = true
     4007         then do:
     4008           define variable v-cntxt-db-num        as integer   no-undo .
     4009           define variable v-cntxt-userid        as character no-undo .
     4010           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4011                                             , OUTPUT v-cntxt-userid
     4012                                             ) .
     4013           run gbl/wndpar_r.p
     4014             (input  v-cntxt-db-num
     4015             ,input  v-cntxt-userid
     4016             ,input  'wndmax':U
     4017             ,output v-diasize-wndmax
     4018             ,output v-default-value
     4019             ) .
     4020         end.
     4021         assign
     4022           v-diasize-wndstore = false
     4023         .
     4024         if connected("ub") = true
     4025         then do:
     4026           run gbl/wndpar_r.p
     4027             (input  v-cntxt-db-num
     4028             ,input  v-cntxt-userid
     4029             ,input  'wndstore':U
     4030             ,output v-diasize-wndstore
     4031             ,output v-default-value
     4032             ) .
     4033         end.
     4034         assign
     4035           v-diasize-proc-name = entry(1, program-name(2), '.')
     4036         .
     4037         if v-diasize-wndstore = true
     4038         then do:
     4039           assign
     4040             v-restore-saved = false
     4041           .
     4042           if connected("ub") = true
     4043           then do:
     4044             run gbl/wndsizer.p
     4045               (input  v-cntxt-db-num
     4046               ,input  v-cntxt-userid
     4047               ,input  v-diasize-proc-name
     4048               ,input  'height':u
     4049               ,output v-resize-value-str
     4050               ) .
     4051             if v-resize-value-str <> '':U
     4052             then do:
     4053               run diasize_change-height in this-procedure
     4054                 (input  integer(v-resize-value-str)
     4055                 ,input  true
     4056                 ) .
     4057               assign
     4058                 v-restore-saved = true
     4059               .
     4060             end.
     4061           end.
     4062           if connected("ub") = true
     4063           then do:
     4064             run gbl/wndsizer.p
     4065               (input  v-cntxt-db-num
     4066               ,input  v-cntxt-userid
     4067               ,input  v-diasize-proc-name
     4068               ,input  'width':u
     4069               ,output v-resize-value-str
     4070               ) .
     4071             if v-resize-value-str <> '':U
     4072             then do:
     4073               run diasize_change-width in this-procedure
     4074                 (input  integer(v-resize-value-str)
     4075                 ,input  true
     4076                 ) .
     4077               assign
     4078                 v-restore-saved = true
     4079               .
     4080             end.
     4081           end.
     4082           if v-restore-saved <> true
     4083           then do:
     4084             if v-diasize-wndmax = true
     4085             then do:
     4086               run diasize_maximize in this-procedure
     4087                 (input  true
     4088                 ) .
     4089             end.
     4090           end.
     4091         end.
     4092         else do:
     4093           if v-diasize-wndmax = true
     4094           then do:
     4095             run diasize_maximize in this-procedure
     4096               (input  true
     4097               ) .
     4098           end.
     4099         end.
     4100       end.
     4101     end.
     4102   end procedure.
     4103   procedure diasize_need-full-display :
     4104     define output parameter p-need-full-display as logical   no-undo .
     4105     do
     4106     on error undo, return error return-value
     4107     :
     4108       assign
     4109         p-need-full-display = v-diasize-need-full-display
     4110       .
     4111       assign
     4112         v-diasize-need-full-display = false
     4113       .
     4114     end.
     4115   end procedure.
     4116   procedure get-context :
     4117      define output parameter p-db-num as integer          no-undo.
     4118      define output parameter p-user-id as character        no-undo.
     4119      define variable v-login               as character    no-undo.
     4120      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4121      define buffer buf_user-login  for ub.user-login .
     4122      do
     4123      on error undo, return error
     4124      :
     4125            FIND FIRST buf_sys-ctrl no-lock.
     4126            ASSIGN
     4127               v-login = USERID("ub")
     4128               p-db-num = buf_sys-ctrl.db-num
     4129            .
     4130            FIND FIRST buf_user-login
     4131                 WHERE buf_user-login.db-num = p-db-num
     4132                   AND buf_user-login.user-login = v-login
     4133                 no-lock
     4134                 no-error
     4135                 .
     4136            IF AVAILABLE buf_user-login
     4137            THEN DO:
     4138               assign
     4139                  p-user-id = buf_user-login.user-id
     4140               .
     4141            END.
     4142      end.
     4143   end procedure.
     4144       run diasize_init in this-procedure .
     4145       RUN enable_UI.
     4146       WAIT-FOR GO OF FRAME Dialog-Frame.
     4147   END.
     4148   RUN disable_UI.
     4149   PROCEDURE proc-b-mark :
     4150     define variable varlog as logical   no-undo .
     4151     if not available tt-gds-act then return.
     4152     run local-mark in this-procedure.
     4153     assign varlog = br-gds-act :select-next-row( ) in frame Dialog-Frame.
     4154     apply "ENTRY":U to br-gds-act in frame Dialog-Frame.
     4155     br-gds-act:refresh() in frame Dialog-Frame .
     4156   END PROCEDURE.
     4157   PROCEDURE local-mark :
     4158     if not available tt-gds-act then do:
     4159       message "Неправильный выбор строки.".
     4160       return no-apply.
     4161     end.
     4162   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4163   define variable v-str-recid15 as character no-undo .
     4164   define variable v-num-entry15 as integer   no-undo .
     4165   assign
     4166     v-str-recid15 = trim( string( recid( tt-gds-act ) , "->>>>>>>>>>>9":U ) )
     4167     v-num-entry15 = lookup( v-str-recid15 , select-list )
     4168   .
     4169   if v-num-entry15 > 0 then do:
     4170     assign
     4171       entry( v-num-entry15, select-list ) = "":U
     4172       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     4173     .
     4174   end.
     4175   else do:
     4176     assign
     4177       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid15
     4178     .
     4179   end.
     4180     br-gds-act:refresh() in frame Dialog-Frame .
     4181   END PROCEDURE.
     4182   PROCEDURE disable_UI :
     4183     HIDE FRAME Dialog-Frame.
     4184   END PROCEDURE.
     4185   PROCEDURE enable_UI :
     4186     ENABLE b-cancel  b-save br-gds-act b-del b-mark b-sel-all b-unmark
     4187         WITH FRAME Dialog-Frame.
     4188     VIEW FRAME Dialog-Frame.
     4189       if p-mode = 'ПРОСМОТР':U then do :
     4190           disable  tt-act-header.num tt-act-header.date_ tt-act-header.type_ with frame Dialog-Frame.
     4191           hide b-good b-marks b-save b-del b-alc-code in FRAME Dialog-Frame.
     4192           define variable hCol as handle no-undo .
     4193           define variable hBr  as handle no-undo .
     4194           define variable i    as integer no-undo .
     4195           hBr = browse br-gds-act:handle .
     4196           hCol = hBr:GET-BROWSE-COLUMN(6).
     4197           hCol:read-only = true .
     4198       end.
     4199   END PROCEDURE.
