      887   procedure thbjattr_write :
      888   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      889   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      890   define input  parameter p-upper-code  like ub.thbj-attr.upper-prop-code  no-undo .
      891   define input  parameter p-code     like ub.thbj-attr.prop-code  no-undo .
      892   define input  parameter p-value-character like ub.thbj-attr.property-value-character no-undo .
      893   define input  parameter p-value-date like ub.thbj-attr.property-value-date no-undo .
      894   define input  parameter p-value-decimal like ub.thbj-attr.property-value-decimal no-undo .
      895   define input  parameter p-value-integer like ub.thbj-attr.property-value-integer no-undo .
      896   define input  parameter p-value-logical like ub.thbj-attr.property-value-logical no-undo .
      897   do
