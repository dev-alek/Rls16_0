     1468   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
     1469        LABEL "Выход"
     1470        SIZE 10 BY 1.13
     1471        BGCOLOR 8 .
     1472   DEFINE BUTTON Btn_chg-xsd
     1473        LABEL "Смена вер. XSD"
     1474        SIZE 15 BY 1.13.
     1475   DEFINE BUTTON btn_del
     1476        LABEL "Удалить"
     1477        SIZE 15 BY 1.13 TOOLTIP "Безвозвратное удаления записи с УТМ".
     1478   DEFINE BUTTON Btn_desmark
     1479        LABEL "-"
     1480        SIZE 3.5 BY 1.13.
     1481   DEFINE BUTTON btn_dwl
     1482        LABEL "Загрузка/анализ"
     1483        SIZE 16.75 BY 1.13.
     1484   DEFINE BUTTON btn_look
     1485        LABEL "Просмотр"
     1486        SIZE 15 BY 1.13.
     1487   DEFINE BUTTON Btn_mark
     1488        LABEL "*"
     1489        SIZE 3.5 BY 1.13.
     1490   DEFINE BUTTON Btn_markall
     1491        LABEL "+"
     1492        SIZE 3.5 BY 1.13.
     1493   DEFINE BUTTON btn_refresh
     1494        LABEL "Обновить"
     1495        SIZE 15 BY 1.13.
     1496   DEFINE BUTTON Btn_reqwb
     1497        LABEL "Запрос накл."
     1498        SIZE 15 BY 1.13 TOOLTIP "Повторный запрос накладной".
     1499   DEFINE VARIABLE CB_typedoc AS CHARACTER FORMAT "X(256)":U
     1500        LABEL "Тип"
     1501        VIEW-AS COMBO-BOX INNER-LINES 5
     1502        LIST-ITEMS "Все,ReplyRests,INVENTORYREGINFO,ReplyAP,ReplyPartner,Ticket,FORMBREGINFO,WAYBILL,WayBillAct,WayBillTicket"
     1503        DROP-DOWN-LIST
     1504        SIZE 20 BY 1 NO-UNDO.
     1505   DEFINE VARIABLE f_date AS DATE FORMAT "99/99/99":U
     1506        LABEL "До даты"
     1507        VIEW-AS FILL-IN
     1508        SIZE 9 BY 1.13 NO-UNDO.
     1509   DEFINE VARIABLE RADIO-SET-1 AS INTEGER
     1510        VIEW-AS RADIO-SET HORIZONTAL
     1511        RADIO-BUTTONS
     1512             "out", 1,
     1513   "in", 2
     1514        SIZE 12 BY 1.13 NO-UNDO.
     1515   DEFINE VARIABLE tb_no_date AS LOGICAL INITIAL no
     1516        LABEL "Без даты"
     1517        VIEW-AS TOGGLE-BOX
     1518        SIZE 11.13 BY 1.13 NO-UNDO.
     1519   DEFINE MENU popup-menu-ver-xsd
     1520          MENU-ITEM m_ver-xsd-1 LABEL "Изменить версия XSD схем на 1"     ACCELERATOR "ALT-1"
     1521          MENU-ITEM m_ver-xsd-2 LABEL "Изменить версия XSD схем на 2" ACCELERATOR "ALT-2"
     1522          MENU-ITEM m_look-resp-ver-xsd LABEL "Просмотреть ответ" ACCELERATOR "ALT-3"
     1523   .
     1524   DEFINE FRAME Dialog-Frame
     1525        Btn_Cancel AT ROW 1.25 COL 2
     1526        btn_refresh AT ROW 1.25 COL 12.5 WIDGET-ID 18
     1527        btn_del AT ROW 1.25 COL 28
     1528        btn_dwl AT ROW 1.25 COL 43.38 WIDGET-ID 2
     1529        btn_look AT ROW 1.25 COL 60.75 WIDGET-ID 14
     1530        Btn_reqwb AT ROW 1.25 COL 76.13 WIDGET-ID 16
     1531        Btn_chg-xsd AT ROW 1.25 COL 91.5 WIDGET-ID 28
     1532        Btn_mark AT ROW 2.63 COL 2.5 WIDGET-ID 4
     1533        Btn_markall AT ROW 2.63 COL 6.75 WIDGET-ID 6
     1534        Btn_desmark AT ROW 2.63 COL 11 WIDGET-ID 8
     1535        f_date AT ROW 2.63 COL 22.5 COLON-ALIGNED WIDGET-ID 12
     1536        RADIO-SET-1 AT ROW 2.63 COL 34.25 NO-LABEL WIDGET-ID 20
     1537        tb_no_date AT ROW 2.63 COL 46.63 WIDGET-ID 24
     1538        CB_typedoc AT ROW 2.67 COL 61 COLON-ALIGNED WIDGET-ID 26
     1539        SPACE(26.99) SKIP(22.23)
     1540       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1541            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1542            TITLE "Содержимое УТМ"
     1543            CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
     1544   ASSIGN
     1545          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1546          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1547   ON window-close OF FRAME Dialog-Frame
     1548   do:
     1549       apply "END-ERROR":U to self.
     1550     end.
     1551   on choose of menu-item m_ver-xsd-1 in menu popup-menu-ver-xsd
     1552   DO:
     1553     if AdmUtmObj:IsSent
     1554     then do:
     1555       message "Запрос уже был отправлен. Дождитесь ответа." view-as alert-box error.
     1556       return no-apply.
     1557     end.
     1558     AdmUtmObj:SendInfoVer("WayBill").
     1559     if AdmUtmObj:StatusErr
     1560     then do:
     1561       message AdmUtmObj:Msg view-as alert-box error.
     1562     end.
     1563   END.
     1564   on choose of menu-item m_ver-xsd-2 in menu popup-menu-ver-xsd
     1565   DO:
     1566     if AdmUtmObj:IsSent
     1567     then do:
     1568       message "Запрос уже был отправлен. Дождитесь ответа." view-as alert-box error.
     1569       return no-apply.
     1570     end.
     1571     AdmUtmObj:SendInfoVer("WayBill_v2").
     1572     if AdmUtmObj:StatusErr
     1573     then do:
     1574       message AdmUtmObj:Msg view-as alert-box error.
     1575     end.
     1576   END.
     1577   on choose of menu-item m_look-resp-ver-xsd in menu popup-menu-ver-xsd
     1578   DO:
     1579     if not AdmUtmObj:IsSent
     1580     then do:
     1581       message "Запрос еще не был отправлен" view-as alert-box error.
     1582       return no-apply.
     1583     end.
     1584     AdmUtmObj:GetSubjectOfRequestUTM ().
     1585     if AdmUtmObj:StatusErr
     1586     then do:
     1587       message AdmUtmObj:Msg view-as alert-box error.
     1588       return no-apply.
     1589     end.
     1590     url_ = AdmUtmObj:urlResp.
     1591     AdmUtmObj:LookRec(url_).
     1592     AdmUtmObj:WriteDbStatusTrue().
     1593   END.
     1594   ON choose OF btn_del IN FRAME Dialog-Frame
     1595   do:
     1596     def var cmd as char no-undo.
     1597     def var qh-del as handle no-undo.
     1598     create query qh-del.
     1599     qh-del:set-buffers (bh-wb-analiz).
     1600     qh-del:query-prepare ("for each tt-alldoc where tt-alldoc.mark = '*' ").
     1601     qh-del:query-open.
     1602     if not qh-del:get-first ()
     1603     then do:
     1604       message "Отметьте записи для удаления." view-as alert-box information.
     1605       return no-apply.
     1606     end.
     1607     message "Вы уверены что хотите удалить запись/и?" view-as alert-box question buttons yes-no update isChoise as log.
     1608     if isChoise
     1609     then do:
     1610       if qh-del:get-first ()
     1611       then do:
     1612         url_ = bh-wb-analiz:buffer-field ('url_'):buffer-value ().
     1613         AdmUtmObj:SaveRecord(url_).
     1614         AdmUtmObj:DelRecord(url_).
     1615         bh-wb-analiz:buffer-delete ().
     1616       end.
     1617       do while qh-del:get-next ():
     1618         url_ = bh-wb-analiz:buffer-field ('url_'):buffer-value ().
     1619         AdmUtmObj:SaveRecord(url_).
     1620         AdmUtmObj:DelRecord(url_).
     1621         bh-wb-analiz:buffer-delete ().
     1622       end.
     1623     end.
     1624     else do:
     1625       return no-apply.
     1626     end.
     1627     run refresh-view.
     1628   end.
     1629   ON choose OF Btn_desmark IN FRAME Dialog-Frame
     1630   do:
     1631     if qh-analiz:get-first ()
     1632       then bh-wb-analiz:buffer-field (1):buffer-value () = "".
     1633     do while qh-analiz:get-next ():
     1634       bh-wb-analiz:buffer-field (1):buffer-value () = "".
     1635     end.
     1636     if qh-analiz:get-first ()
     1637       then browse-hdl-analiz:refresh ().
     1638   end.
     1639   ON choose OF btn_dwl IN FRAME Dialog-Frame
     1640   do:
     1641     AdmUtmObj:SaveRecords().
     1642     if AdmUtmObj:StatusErr
     1643       then do:
     1644         message AdmUtmObj:Msg view-as alert-box.
     1645         isSave = false.
     1646       end.
     1647       else isSave = true.
     1648     run refresh-view.
     1649   end.
     1650   ON choose OF btn_look IN FRAME Dialog-Frame
     1651   do:
     1652     if not bh-wb-analiz:available
     1653       then return no-apply.
     1654     url_ = bh-wb-analiz:buffer-field ('url_'):buffer-value ().
     1655     AdmUtmObj:LookRec(url_).
     1656     run refresh-view.
     1657     bh-wb-analiz:find-first ('where url_ = "' + url_ + '"').
     1658     if bh-wb-analiz:available
     1659       then qh-analiz:reposition-to-rowid ( bh-wb-analiz:rowid ).
     1660   end.
     1661   ON choose OF Btn_mark IN FRAME Dialog-Frame
     1662   do:
     1663     if bh-wb-analiz:available
     1664     then do:
     1665       if bcolmark:screen-value = "*"
     1666         then do:
     1667           assign
     1668             bh-wb-analiz:buffer-field (1):buffer-value () = ""
     1669             bcolmark:screen-value = ""
     1670             .
     1671         end.
     1672         else do:
     1673           assign
     1674             bh-wb-analiz:buffer-field (1):buffer-value () = "*"
     1675             bcolmark:screen-value = "*"
     1676             .
     1677        end.
     1678        browse-hdl-analiz:select-next-row( ).
     1679     end.
     1680   end.
     1681   ON choose OF Btn_markall IN FRAME Dialog-Frame
     1682   do:
     1683     if qh-analiz:get-first ()
     1684       then bh-wb-analiz:buffer-field (1):buffer-value () = "*".
     1685     do while qh-analiz:get-next ():
     1686       bh-wb-analiz:buffer-field (1):buffer-value () = "*".
     1687     end.
     1688     if qh-analiz:get-first ()
     1689       then browse-hdl-analiz:refresh ().
     1690   end.
     1691   ON CHOOSE OF btn_refresh IN FRAME Dialog-Frame
     1692   DO:
     1693     bh-wb-analiz = AdmUtmObj:GetHndlTable().
     1694     run refresh-view.
     1695   END.
     1696   ON CHOOSE OF Btn_reqwb IN FRAME Dialog-Frame
     1697   DO:
     1698     def var v-WBREGID as char no-undo.
     1699     run gbl/d-prompt.w (
     1700         'title=Введите WBREGID накладной\'
     1701       + 'text1=Введите WBREGID накладной\'
     1702       + 'format=x(40)\'
     1703       + 'type=char\'
     1704       ,input-output v-WBREGID
     1705       ).
     1706     if return-value = 'false':u then do:
     1707       return no-apply .
     1708     end.
     1709     AdmUtmObj:QueryResendDoc(v-WBREGID).
     1710     if AdmUtmObj:StatusErr
     1711     then do:
     1712       message AdmUtmObj:Msg view-as alert-box error.
     1713     end.
     1714   END.
     1715   ON VALUE-CHANGED OF CB_typedoc IN FRAME Dialog-Frame
