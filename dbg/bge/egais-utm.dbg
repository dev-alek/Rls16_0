     1738     then do:
     1739       assign
     1740       CB_typedoc:hidden = false.
     1741     end.
     1742     else do:
     1743       assign
     1744       CB_typedoc:hidden = true.
     1745     end.
     1746     run refresh-view.
     1747   END.
     1748   ON VALUE-CHANGED OF tb_no_date IN FRAME Dialog-Frame
     1749   DO:
     1750     apply "choose" to Btn_desmark in frame Dialog-Frame.
     1751     run refresh-view.
     1752   END.
     1753   if valid-handle(active-window) and frame Dialog-Frame:PARENT eq ?
     1754     then frame Dialog-Frame:PARENT = active-window.
     1755   MAIN-BLOCK:
     1756   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
     1757     on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
     1758     def var ii as int no-undo.
     1759   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1760   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
     1761     (output v-db-num
     1762     ,output v-user-id
     1763     ) no-error .
     1764   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1765     run mainmenu_getcntxt in parparentproc
     1766       (output v-cntxt-db-num
     1767       ,output v-cntxt-userid
     1768       ,output v-cntxt-level
     1769       ,output v-cntxt-host-code-obj
     1770       ,output v-cntxt-obj-type
     1771       ,output v-cntxt-obj-code
     1772       ,output v-cntxt-db-num-obj
     1773       ,output v-cntxt-is-admin
     1774       ) .
     1775     empty temp-table thbjattr_thbj-attr .
     1776     run adm/shattri.p (
     1777          input "get":U
     1778         ,input v-cntxt-obj-type
     1779         ,input v-cntxt-obj-code
     1780         ,input 'egais':U
     1781         ,input 'egais-fsrar':U
     1782         ,output v-value-character
     1783         ,output v-value-date
     1784         ,output v-value-decimal
     1785         ,output v-value-integer
     1786         ,output v-value-logical
     1787         ,output v-value-type
     1788         ,input-output TABLE thbjattr_thbj-attr
     1789         ) no-error .
     1790     assign
     1791       v-fs-rar = v-value-character
     1792     .
     1793     run adm/shattri.p (
     1794          input "get":U
     1795         ,input '':U
     1796         ,input 0
     1797         ,input 'egais':U
     1798         ,input 'egais-exsys':U
     1799         ,output v-value-character
     1800         ,output v-value-date
     1801         ,output v-value-decimal
     1802         ,output v-value-integer
     1803         ,output v-value-logical
     1804         ,output v-value-type
     1805         ,input-output TABLE thbjattr_thbj-attr
     1806         ) no-error .
     1807     assign v-ext-sys = v-value-integer.
     1808     create browse browse-hdl-analiz
     1809       assign
     1810       title     = 'Записи'
     1811       frame     = frame Dialog-Frame:handle
     1812       query     = qh-analiz
     1813       x         = 10
     1814       y         = 70
     1815       width     = 100
     1816       height    = 21
     1817       visible   = true
     1818       read-only = true
     1819       sensitive = true
     1820       separators = true
     1821       column-resizable = true
     1822       triggers:
     1823         on mouse-move-dblclick persistent run msdblcl.
     1824         on row-display persistent run proc-row-disp.
     1825       end triggers
     1826       .
     1827     AdmUtmObj = new admutm (v-cntxt-obj-type, v-cntxt-obj-code, v-fs-rar, v-ext-sys).
     1828     AdmUtmObj:DbNum = v-db-num.
