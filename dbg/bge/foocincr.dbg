     2905         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'PS'),  input string(buf_fin-connect.PS), input 1 ).
     2906         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'base-rate'),  input string(buf_fin-connect.base-rate), input 1 ).
     2907         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'base-scale'),  input string(buf_fin-connect.base-scale), input 1 ).
     2908         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'connect-code'),  input string(buf_fin-connect.connect-code), input 1 ).
     2909         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'contract-code'),  input string(buf_fin-connect.contract-code), input 1 ).
     2910         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'contract-curr'),  input string(buf_fin-connect.contract-curr), input 1 ).
     2911         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'contract-rate'),  input string(buf_fin-connect.contract-rate), input 1 ).
     2912         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'contract-scale'),  input string(buf_fin-connect.contract-scale), input 1 ).
     2913         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'curr-code'),  input string(buf_fin-connect.curr-code), input 1 ).
     2914         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'exch-rate'),  input string(buf_fin-connect.exch-rate), input 1 ).
     2915         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'exch-scale'),  input string(buf_fin-connect.exch-scale), input 1 ).
     2916         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'fact-date'),  input string(buf_fin-connect.fact-date, '99.99.9999'), input 1 ).
     2917         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'fact-time'),  input string(buf_fin-connect.fact-time), input 1 ).
     2918         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'fin-doc-code'),  input string(buf_fin-connect.fin-doc-code), input 1 ).
     2919         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'host'),  input string(buf_fin-connect.host-code), input 1 ).
     2920         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'status_'),  input string(buf_fin-connect.status_), input 1 ).
     2921         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'sum-base-ob'),  input string(buf_fin-connect.sum-base-ob), input 1 ).
     2922         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'sum-base'),  input string(buf_fin-connect.sum-base), input 1 ).
     2923         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'sum-contr-ob'),  input string(buf_fin-connect.sum-contr-ob), input 1 ).
     2924         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'sum-contr'),  input string(buf_fin-connect.sum-contr), input 1 ).
     2925         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'sum-doc'),  input string(buf_fin-connect.sum-doc), input 1 ).
     2926         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'sum-rubl-ob'),  input string(buf_fin-connect.sum-rubl-ob), input 1 ).
     2927         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'sum-rubl'),  input string(buf_fin-connect.sum-rubl), input 1 ).
     2928         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'user-db-num'),  input string(buf_fin-connect.user-db-num), input 1 ).
     2929         run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'user-name'),  input string(buf_fin-connect.user-name), input 1 ).
     2930         run wp-xmltagclose in this-procedure ( input 0 + 4, substitute("&1", 'finConnect')).
     2931   end.
     2932     run wp-xmltagput ( 3, "comment",  p-doc-PS, 0 ).
     2933     run wp-xmltagclose ( 2, "operation" ).
     2934   end.
     2935   end procedure.
     2936   procedure run-callback-write-doc-code :
     2937   do
     2938   on error undo, return error
     2939   :
     2940   define input parameter p-handle           as handle       no-undo.
     2941   define input parameter p-type             as character    no-undo.
     2942   define input parameter p-host-code        as integer      no-undo.
     2943   define input parameter p-fin-doc-code     as integer      no-undo.
     2944   define input parameter p-corr-user-db-num as integer      no-undo.
     2945   define input parameter p-chip-num         as integer      no-undo.
     2946   define input parameter p-log-file         as character    no-undo.
     2947   define variable v-procedure-name    as char no-undo.
     2948   case p-type
     2949   :
     2950     when "fin-ob":U then do:
     2951       assign
     2952       v-procedure-name = "fill-temp-fin-doc-code":U
     2953       .
     2954     end.
     2955   end case.
     2956   if lookup ( v-procedure-name, p-handle :internal-entries ) > 0
     2957   then do:
     2958       run value ( v-procedure-name ) in p-handle (
     2959                                                   input p-host-code
     2960                                                  ,input p-fin-doc-code
     2961                                                  ,input p-corr-user-db-num
     2962                                                  ,input p-chip-num
     2963                                                     ) no-error.
     2964       if error-status :error
     2965       then do:
     2966           run wp-XMLWriteLog in this-procedure (
     2967                 input p-log-file
     2968               , input 1
     2969               , input substitute ( "Ошибка при вызове callback - процедуры &1.", v-procedure-name )
     2970           ).
     2971       end.
     2972   end.
     2973   else do:
     2974       run wp-XMLWriteLog in this-procedure (
     2975             input p-log-file
     2976           , input 1
     2977           , input substitute ( "Не найдена callback - процедура &1.", v-procedure-name )
     2978       ).
     2979   end.
     2980   end.
     2981   end procedure.
