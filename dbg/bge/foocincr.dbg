      533                       then do:
      534                           assign
      535                               p-out-string = p-out-string + " ":U
      536                           .
      537                       end.
      538                       when chr(6)
      539                       then do:
      540                           assign
      541                               p-out-string = p-out-string + " ":U
      542                           .
      543                       end.
      544                       when chr(7)
      545                       then do:
      546                           assign
      547                               p-out-string = p-out-string + " ":U
