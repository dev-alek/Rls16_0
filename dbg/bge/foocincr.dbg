      988   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
      989                                             INPUT iFlagEmpty AS INTEGER).
      990       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
      991       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
      992           DO:
      993               IF iFlagEmpty = 0                           THEN RETURN "".
      994               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
      995               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
      996               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
      997               ELSE RETURN "".
      998           END.
      999       ELSE DO:
     1000           run xmlchar-encode in this-procedure (
     1001                 input sToPlace
     1002               , output sToPlace
     1003           ).
     1004           ASSIGN
     1005               sToPlace = sParName + '="' + sToPlace + '"'
     1006           .
     1007           RETURN sToPlace.
     1008       END.
     1009   END FUNCTION.
     1010   function bge-xml-date returns character
     1011   ( input p-date as date )
     1012   :
     1013     define variable v-date-str as character no-undo .
     1014     run bge-xml-date-to-str in this-procedure ( input   p-date
     1015                                               , output  v-date-str
     1016                                               ) .
     1017     return v-date-str.
     1018   end function.
     1019   function bge-xml-str-date returns character
     1020   ( input p-date-str as character )
     1021   :
     1022     define variable v-date-str as character no-undo .
     1023     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1024                                                   , output  v-date-str
     1025                                                   ) .
     1026     return v-date-str.
     1027   end function.
     1028   function bge-xml-normalize-dec returns decimal
     1029   ( input p-val as decimal )
     1030   :
     1031     return (if p-val = ? then 0 else p-val) .
     1032   end function.
     1033   PROCEDURE wp-XMLTagOpen:
     1034   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1035   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1036   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1037       define variable v-out-string    as character    no-undo.
     1038   do
     1039   on error undo, return error
     1040   :
     1041       if v-bge-xml-bgefmt = "dbf":U
     1042       then do:
     1043       end.
     1044       else do:
     1045           assign
     1046               v-out-string = substitute( "&1&2<&3&4>"
     1047                                       , chr(10)
     1048                                       , fill( " ":U, 4 * iTagLevel)
     1049                                       , sTagName
     1050                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1051                               )
     1052           .
     1053           put stream stmXMLOut unformatted
     1054               v-out-string
     1055           .
     1056       end.
     1057   end.
     1058   END PROCEDURE.
     1059   PROCEDURE wp-XMLTagPut:
     1060     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1061     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1062     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1063     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1064       define variable v-out-string    as character    no-undo.
     1065   do
     1066   on error undo, return error
     1067   :
     1068       if v-bge-xml-bgefmt = "dbf":U
     1069       then do:
     1070           if v-bge-xml-dbf-file-name <> "":U
     1071           then do:
     1072               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1073               export stream stmXMLOut
     1074                   sTagName
     1075                   sParValue
     1076               .
     1077               output stream stmXMLOut close.
     1078           end.
     1079       end.
     1080       else do:
     1081           IF  iFlagEmpty = 1
     1082           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1083           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1084           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1085           THEN DO:
     1086               run xmlchar-encode in this-procedure (
     1087                   input sParValue
     1088                   , output sParValue
     1089               ).
     1090               assign
     1091                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1092                                               , chr(10)
     1093                                               , FILL(" ", 4 * iTagLevel)
     1094                                               , sTagName
     1095                                               , sParValue
     1096                               )
     1097               .
     1098               PUT STREAM stmXMLOut UNFORMATTED
     1099                   v-out-string
     1100               .
     1101           END.
     1102       end.
     1103   end.
     1104   END PROCEDURE.
     1105   PROCEDURE wp-XMLTagClose:
     1106   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1107   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1108       define variable v-out-string    as character    no-undo.
     1109   do
     1110   on error undo, return error
     1111   :
     1112       if v-bge-xml-bgefmt = "dbf":U
     1113       then do:
     1114       end.
     1115       else do:
     1116           assign
     1117               v-out-string = substitute( "&1&2</&3>"
     1118                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1119                                   , fill( " ", 4 * iTagLevel )
     1120                                   , sTagName
     1121                           )
     1122           .
     1123           PUT STREAM stmXMLOut UNFORMATTED
     1124               v-out-string
     1125           .
     1126       end.
     1127   end.
     1128   END PROCEDURE.
     1129   PROCEDURE wp-XMLWriteLog:
     1130     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1131     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1132     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1133   define variable v-str              as character no-undo .
     1134   define variable v-error-append     as logical   no-undo .
     1135   define variable v-error-append-msg as character no-undo .
     1136   assign
     1137     v-str = chr(10)
     1138             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1139             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1140     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1141     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1142     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1143   .
     1144   run bge/bge-log.p (input v-str) no-error .
     1145   if error-status:error then do:
     1146     assign
     1147       v-error-append     = yes
     1148       v-error-append-msg = return-value
     1149     .
     1150   end.
     1151   run gbl/fileapnd.p
     1152     ( input sFileName
     1153     , input v-str
     1154     , input 10
     1155     ) no-error .
     1156   if error-status:error then do:
     1157     assign
     1158       v-error-append     = yes
     1159       v-error-append-msg = substitute( "&1&2&3"
     1160                                       , v-error-append-msg
     1161                                       , chr(10)
     1162                                       , return-value
     1163                                       )
     1164     .
     1165   end.
     1166   if v-error-append
     1167   then do:
     1168     return error substitute( "&1" , v-error-append-msg ) .
     1169   end.
     1170   END PROCEDURE.
     1171   PROCEDURE wp-XMLWriteEDT:
     1172     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1173     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1174     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1175       if valid-handle ( hEDT )
     1176       then do:
     1177           hEDT :move-to-eof().
     1178           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1179                                           OR sToWrite = "&Line") THEN "" ELSE
     1180                                           cur-time-string-sec() + " ").
     1181           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1182                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1183                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1184           hEDT :insert-string(chr(10)).
     1185       end.
     1186       process events.
     1187       output to 'bgescn.txt' append.
     1188           put unformatted
     1189               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1190                                           OR sToWrite = "&Line") THEN "" ELSE
     1191                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1192               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1193                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1194                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1195           .
     1196       output close.
     1197   END PROCEDURE.
     1198   PROCEDURE wp-XMLShowCNT:
     1199     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1200       if valid-handle( hCNT )
     1201       then do:
     1202           ASSIGN hCNT :VISIBLE = TRUE.
     1203       end.
     1204   END PROCEDURE.
     1205   PROCEDURE wp-XMLHideCNT:
     1206     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1207       if valid-handle( hCNT )
     1208       then do:
     1209           ASSIGN hCNT :VISIBLE = FALSE.
     1210       end.
     1211   END PROCEDURE.
     1212   PROCEDURE wp-XMLWriteCNT:
     1213     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1214     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1215       if valid-handle( hCNT )
     1216       then do:
     1217           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1218       end.
     1219   END PROCEDURE.
     1220   procedure bge-xml-write-header:
     1221   do
     1222   on error undo, return error
     1223   :
     1224   define input parameter p-xml-file-name  as character        no-undo.
     1225   define input parameter p-doc-name       as character        no-undo.
     1226   define input parameter p-version        as character        no-undo.
     1227   define input parameter p-db-num         as integer          no-undo.
     1228   define input parameter p-date-from      as date             no-undo.
     1229   define input parameter p-shift-num-from as integer          no-undo.
     1230   define input parameter p-date-to        as date             no-undo.
     1231   define input parameter p-shift-num-to   as integer          no-undo.
     1232   define input parameter p-obj-list       as character        no-undo.
     1233   define input parameter p-doc-type-list  as character        no-undo.
     1234   define input parameter p-pay-code       as logical          no-undo.
     1235   define input parameter p-cst            as logical          no-undo.
     1236   define input parameter p-parts          as logical          no-undo.
     1237   define input parameter p-chk-pay-code   as logical          no-undo.
     1238   define input parameter p-pay-desk       as logical          no-undo.
     1239   define input parameter p-pay-desk-cards as logical          no-undo.
     1240   define input parameter p-deleted        as logical          no-undo.
     1241   define input parameter p-opened-docs    as logical          no-undo.
     1242   define variable v-out-string    as character    no-undo.
     1243   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1244   assign
     1245       v-out-string = substitute( "&1&2&3"
     1246                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1247                           , chr(10)
     1248                           , "<IBS_Trade_House>":U )
     1249   .
     1250   put stream stmXMLOut unformatted
     1251       v-out-string
     1252   .
     1253   run wp-XMLTagOpen(1, "header","").
     1254   if v-bge-xml-bgeflold = "oracle":u
     1255   then do:
     1256     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1257     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1258     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1259     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1260     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1261   end.
     1262   run wp-XMLTagOpen( 2, "manifest", "").
     1263   run wp-XMLTagOpen( 3, "document", "").
     1264   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1265   run wp-XMLTagput( 4, "description", "", 0).
     1266   run wp-XMLTagput( 4, "version", p-version, 0).
     1267   run wp-XMLTagclose( 3, "document" ).
     1268   run wp-XMLTagclose( 2, "manifest" ).
     1269   run wp-XMLTagclose( 1, "header" ).
     1270   run wp-XMLTagOpen(1, "options","").
     1271   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1272   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1273   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1274   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1275   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1276   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1277   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1278   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1279   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1280   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1281   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1282   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1283   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1284   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1285   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1286   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1287   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1288   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1289   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1290   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1291   run wp-XMLTagClose(1, "options").
     1292   run wp-XMLTagOpen( 1, "body", "" ).
     1293   output stream stmXMLOut close.
     1294   end.
     1295   end procedure.
     1296   procedure xml-bge-write-footer:
     1297   do
     1298   on error undo, return error return-value
     1299   :
     1300   define input parameter p-xml-file-name as character    no-undo.
     1301   define variable v-error-num     as integer           no-undo.
     1302   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1303   run wp-XMLTagClose( 1, "body" ).
     1304   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1305   output stream stmXMLOut close.
     1306   if v-bge-xml-bgeflold = "oracle":u
     1307   then do:
     1308     define variable v-tmp-file-name         as character no-undo .
     1309     define variable v-zip-file-name         as character no-undo .
     1310     define variable v-exch-file-name        as character no-undo .
     1311     define variable v-heap-file-name        as character no-undo .
     1312     define variable v-i                     as integer   no-undo .
     1313     define variable v-file-name             as character no-undo .
     1314     define variable v-arc                   as character no-undo .
     1315     define variable v-str                   as character no-undo .
     1316     define variable v-exch-tmp-file-name    as character no-undo .
     1317     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1318     define variable v-bge-xml-exch-dir      as character no-undo .
     1319     define variable v-bge-xml-heap-dir      as character no-undo .
     1320     define variable v-bge-xml-compress-heap as logical   no-undo .
     1321     define variable v-home-dir              as character no-undo .
     1322     define variable v-os-command            as character no-undo .
     1323     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1324     if v-home-dir = ?
     1325     then do:
     1326       undo, return error substitute( "&1&2&3"
     1327                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1328                                     , chr(10)
     1329                                     , "Обратитесь к администратору.":u
     1330                                     ).
     1331     end.
     1332     assign
     1333       v-home-dir = v-home-dir
     1334     .
     1335     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1336     if error-status :error
     1337     then do:
     1338       undo, return error substitute( "&1&2&3"
     1339                                     , "Неверно задан каталог экспорта.":u
     1340                                     , chr(10)
     1341                                     , "Обратитесь к администратору.":u
     1342                                     ).
     1343     end.
     1344     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1345     if v-bge-xml-exch-dir = ?
     1346     then do:
     1347       undo, return error substitute( "&1&2&3"
     1348                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1349                                     , chr(10)
     1350                                     , "Обратитесь к администратору.":u
     1351                                     ).
     1352     end.
     1353     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1354     if error-status :error
     1355     then do:
     1356       undo, return error substitute( "&1&2&3"
     1357                                     , "Неверно задан каталог экспорта (exch).":u
     1358                                     , chr(10)
     1359                                     , "Обратитесь к администратору.":u
     1360                                     ).
     1361     end.
     1362     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1363     if v-bge-xml-heap-dir = ?
     1364     then do:
     1365       undo, return error substitute( "&1&2&3"
     1366                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1367                                     , chr(10)
     1368                                     , "Обратитесь к администратору.":u
     1369                                     ).
     1370     end.
     1371     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1372     if error-status :error
     1373     then do:
     1374       undo, return error substitute( "&1&2&3"
     1375                                     , "Неверно задан каталог экспорта (heap).":u
     1376                                     , chr(10)
     1377                                     , "Обратитесь к администратору.":u
     1378                                     ).
     1379     end.
     1380     get-key-value section "BGE" key "heap-compress" value v-str.
     1381     assign
     1382       v-i = int(v-str)
     1383     no-error .
     1384     if v-i = ? or v-i = 0
     1385     then do:
     1386       assign
     1387         v-bge-xml-compress-heap = no
     1388       .
     1389     end.
     1390     else do:
     1391       assign
     1392         v-bge-xml-compress-heap = yes
     1393       .
     1394     end.
     1395     assign
     1396       v-arc = search( "exe/7za.exe":u )
     1397     .
     1398     if v-arc = ? or v-arc = ""
     1399     then do:
     1400       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1401     end.
     1402     assign
     1403       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1404       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1405       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1406       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1407       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1408       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1409       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1410     .
     1411     run gbl/del-file.p (input v-tmp-file-name) .
     1412     run gbl/del-file.p (input v-zip-file-name) .
     1413     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1414     if v-error-num > 0
     1415     then do:
     1416         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1417                                      , p-xml-file-name + "xm1":u
     1418                                      , v-tmp-file-name
     1419                                      , v-error-num
     1420                                      ).
     1421     end.
     1422     assign
     1423       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1424                                    , v-arc
     1425                                    , v-zip-file-name
     1426                                    , v-tmp-file-name
     1427                                    )
     1428     .
     1429     os-command silent value ( v-os-command ) .
     1430     run gbl/del-file.p (input v-heap-file-name) .
     1431     if v-bge-xml-compress-heap = no
     1432     then do:
     1433       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1434       if v-error-num > 0
     1435       then do:
     1436           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1437                                        , v-tmp-file-name
     1438                                        , v-heap-file-name
     1439                                        , v-error-num
     1440                                        ) .
     1441       end.
     1442     end.
     1443     else do:
     1444       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1445       if v-error-num > 0
     1446       then do:
     1447           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1448                                        , v-zip-file-name
     1449                                        , v-heap-file-name
     1450                                        , v-error-num
     1451                                        ) .
     1452       end.
     1453     end.
     1454     run gbl/del-file.p (input v-tmp-file-name) .
     1455     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1456     if error-status :error then do:
     1457       undo, return error substitute( "&1&2&3"
     1458                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1459                                     , chr(10)
     1460                                     , "Обратитесь к администратору."
     1461                                     ).
     1462     end.
     1463     run gbl/del-file.p (input v-exch-file-name) .
     1464     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1465     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1466     if v-error-num > 0
     1467     then do:
     1468       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1469                                     , v-zip-file-name
     1470                                     , v-exch-tmp-file-name
     1471                                     , v-error-num
     1472                                     ) .
     1473     end.
     1474     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1475     if v-error-num > 0
     1476     then do:
     1477       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1478                                     , v-exch-tmp-file-name
     1479                                     , v-exch-file-name
     1480                                     , v-error-num
     1481                                     ) .
     1482     end.
     1483     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1484   end.
     1485   else do:
     1486     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1487     if v-error-num > 0
     1488     then do:
     1489       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1490                                     , p-xml-file-name + "xm1"
     1491                                     , p-xml-file-name + "xml"
     1492                                     , v-error-num
     1493                                     ) .
     1494     end.
     1495   end.
     1496   if opsys = "unix"
     1497   then do:
     1498       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1499   end.
     1500   end.
     1501   end procedure.
     1502   procedure xml-bge-filename0:
     1503   define input parameter p-prefix   as character no-undo .
     1504   define input parameter p-name     as character no-undo .
     1505   define input parameter p-shared-process as logical no-undo .
     1506   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1507   define output parameter p-xml-file-name  as character no-undo .
     1508   // define output parameter p-fullfnamenoext as character no-undo .
     1509   define output parameter p-locked         as logical      no-undo.
     1510   define variable v-fullfnamenoext as character no-undo .
     1511   define variable v-fileext        as character no-undo .
     1512   define variable v-fullfname      as character no-undo .
     1513   define variable v-error-num      as integer   no-undo .
     1514   do
     1515   on error undo, return error
     1516   :
     1517     case v-bge-xml-bgeflold :
     1518       when "old" then do:
     1519         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1520         v-fileext       = ".xml":U .
     1521         v-fullfname     = v-fullfnamenoext + v-fileext .
     1522         p-xml-file-name = v-fullfname .
     1523         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1524         if v-error-num > 0 then do:
     1525           return error.
     1526         end.
     1527       end.
     1528       when "var" then do:
     1529         case p-prefix :
     1530           when "doc" then do:
     1531             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1532             v-fileext       = ".xml":U .
     1533             v-fullfname     = v-fullfnamenoext + v-fileext .
     1534             p-xml-file-name = v-fullfname .
     1535           end.
     1536           when "day" then do:
     1537             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1538             v-fileext       = ".xml":U .
     1539             v-fullfname     = v-fullfnamenoext + v-fileext .
     1540             p-xml-file-name = v-fullfname .
     1541           end.
     1542           otherwise do:
     1543             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1544             v-fileext       = ".xml":U .
     1545             v-fullfname     = v-fullfnamenoext + v-fileext .
     1546             p-xml-file-name = v-fullfname .
     1547           end.
     1548         end case.
     1549         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1550         if v-error-num > 0 then do:
     1551           return error.
     1552         end.
     1553       end.
     1554       when "new" then do:
     1555                   run bge/genfname.p (
     1556                       input p-home-dir
     1557                       , input p-prefix
     1558                       , input ""
     1559                       , input "xml"
     1560                       , input ""
     1561                       , output p-xml-file-name
     1562                   ).
     1563       end.
     1564       when "no-parameter" then do:
     1565         if p-shared-process then do:
     1566                       run bge/genfname.p (
     1567                           input p-home-dir
     1568                           , input "d"
     1569                           , input ""
     1570                           , input "xml"
     1571                           , input ""
     1572                           , output p-xml-file-name
     1573                       ).
     1574         end.
     1575         else do:
     1576           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1577           v-fileext       = ".xml":U .
     1578           v-fullfname     = v-fullfnamenoext + v-fileext .
     1579           p-xml-file-name = v-fullfname .
     1580           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1581           if v-error-num > 0 then do:
     1582             return error.
     1583           end.
     1584         end.
     1585       end.
     1586     end case.
     1587     assign
     1588       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1589       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1590     .
     1591   end .
     1592   end procedure .
     1593   procedure xml-bge-filename :
     1594   do
     1595   on error undo, return error
     1596   :
     1597   define input parameter p-prefix             as character    no-undo.
     1598   define input parameter p-name               as character    no-undo.
     1599   define input parameter p-shared-process     as logical      no-undo.
     1600   define output parameter p-xml-file-name     as character    no-undo.
     1601   define output parameter p-log-file-name     as character    no-undo.
     1602   define output parameter p-locked            as logical      no-undo.
     1603   define variable v-home-dir          as character no-undo .
     1604   define variable v-error-num         as integer   no-undo .
     1605   define variable v-bge-xml-heap-dir  as character no-undo .
     1606       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1607       if v-home-dir = ?
     1608       then do:
     1609           message
     1610             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1611             skip(1)
     1612             skip "Обратитесь к администратору."
     1613           view-as alert-box error.
     1614           undo, return error .
     1615       end.
     1616       if v-bge-xml-bgeflold <> "oracle"
     1617       then do:
     1618         assign
     1619             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1620         .
     1621       end.
     1622       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1623       if error-status :error
     1624       then do:
     1625           message
     1626             skip "Неверно задан каталог экспорта."
     1627             skip(1)
     1628             skip "Обратитесь к администратору."
     1629           view-as alert-box error.
     1630           undo, return error .
     1631       end.
     1632       if v-bge-xml-bgefmt = "dbf":U
     1633       then do:
     1634           assign
     1635               p-xml-file-name = v-home-dir
     1636               p-locked        = no
     1637           .
     1638       end.
     1639       else do:
     1640           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1641             output p-xml-file-name, output p-locked) .
     1642       end.
     1643       if v-bge-xml-bgeflold = "oracle"
     1644       then do:
     1645         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1646         if v-bge-xml-heap-dir = ?
     1647         then do:
     1648           undo, return error substitute( "&1&2&3"
     1649                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1650                                         , chr(10)
     1651                                         , "Обратитесь к администратору.":u
     1652                                         ).
     1653         end.
     1654         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1655         if error-status :error
     1656         then do:
     1657           undo, return error substitute( "&1&2&3"
     1658                                         , "Неверно задан каталог экспорта (heap).":u
     1659                                         , chr(10)
     1660                                         , "Обратитесь к администратору.":u
     1661                                         ).
     1662         end.
     1663         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1664           assign
     1665             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1666           .
     1667         end.
     1668         else do:
     1669           assign
     1670             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1671           .
     1672         end.
     1673       end.
     1674       else do:
     1675         assign
     1676             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1677         .
     1678       end.
     1679       assign
     1680          v-bge-xml-static-log-file-name = p-log-file-name
     1681       .
     1682   end.
     1683   end procedure.
     1684   procedure bge-xml-read-config :
     1685   do
     1686   on error undo, return error return-value
     1687   :
     1688   define input  parameter p-last-date as date      no-undo .
     1689   define input  parameter p-db-num    as integer   no-undo .
     1690       define variable v-bgeclall      as character     no-undo.
     1691       define variable v-bgedict       as character     no-undo.
     1692       define variable v-bgeshift      as character     no-undo.
     1693       define variable v-par-type      as character     no-undo.
     1694       define variable v-bgeflnm       as character     no-undo.
     1695       define variable v-bgecliiv      as character     no-undo .
     1696       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1697       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1698       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1699       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1700       define variable v-db-num-str    as character     no-undo .
     1701       define variable v-param-type      as character  no-undo .
     1702       define variable v-value-character as character  no-undo .
     1703       define variable v-value-date      as date       no-undo .
     1704       define variable v-value-decimal   as decimal    no-undo .
     1705       define variable v-value-integer   as integer    no-undo .
     1706       define variable v-value-logical   as logical    no-undo .
     1707       define variable v-tth             as handle      no-undo .
     1708       run adm/shattri.p ( input "get":U
     1709                         , input  '':u
     1710                         , input  0
     1711                         , input  'bge-export':U
     1712                         , input  'bgeclall':U
     1713                         , output v-bgecliiv
     1714                         , output v-value-date
     1715                         , output v-value-decimal
     1716                         , output v-value-integer
     1717                         , output v-value-logical
     1718                         , output v-param-type
     1719                         , input-output table-handle v-tth
     1720                         ) no-error .
     1721       if error-status :error
     1722       then do:
     1723         assign
     1724           v-bge-xml-bgecliiv = no
     1725         .
     1726       end.
     1727       else do:
     1728         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1729       end.
     1730       delete object v-tth.
     1731       assign
     1732           v-bge-xml-bgeclall = no
     1733           v-bge-xml-bgedict  = no
     1734       .
     1735       run adm/shattri.p ( input "get":U
     1736                         , input  '':u
     1737                         , input  0
     1738                         , input  'bge-export':U
     1739                         , input  'bgeclall':U
     1740                         , output v-value-character
     1741                         , output v-value-date
     1742                         , output v-value-decimal
     1743                         , output v-value-integer
     1744                         , output v-value-logical
     1745                         , output v-param-type
     1746                         , input-output table-handle v-tth
     1747                         ) no-error .
     1748       if error-status :error
     1749       then do:
     1750         assign
     1751           v-bge-xml-bgeclall = no
     1752         .
     1753       end.
     1754       else do:
     1755         assign
     1756           v-bge-xml-bgeclall = v-value-logical
     1757         .
     1758       end.
     1759       delete object v-tth.
     1760       run adm/shattri.p ( input "get":U
     1761                         , input  '':u
     1762                         , input  0
     1763                         , input  'bge-export':U
     1764                         , input  'bgedict':U
     1765                         , output v-value-character
     1766                         , output v-value-date
     1767                         , output v-value-decimal
     1768                         , output v-value-integer
     1769                         , output v-value-logical
     1770                         , output v-param-type
     1771                         , input-output table-handle v-tth
     1772                         ) no-error .
     1773       if error-status :error
     1774       then do:
     1775         assign
     1776           v-bge-xml-bgedict = no
     1777         .
     1778       end.
     1779       else do:
     1780         assign
     1781           v-bge-xml-bgedict = v-value-logical
     1782         .
     1783       end.
     1784       delete object v-tth.
     1785       run adm/shattri.p ( input "get":U
     1786                         , input  '':u
     1787                         , input  0
     1788                         , input  'bge-export':U
     1789                         , input  'bgefmt':U
     1790                         , output v-value-character
     1791                         , output v-value-date
     1792                         , output v-value-decimal
     1793                         , output v-value-integer
     1794                         , output v-value-logical
     1795                         , output v-param-type
     1796                         , input-output table-handle v-tth
     1797                         ) no-error .
     1798       if error-status :error
     1799       then do:
     1800         assign
     1801           v-bge-xml-bgefmt  = "xml":U
     1802         .
     1803       end.
     1804       else do:
     1805         assign
     1806           v-bge-xml-bgefmt  = v-value-character
     1807         .
     1808       end.
     1809       delete object v-tth.
     1810       run adm/shattri.p ( input "get":U
     1811                         , input  '':u
     1812                         , input  0
     1813                         , input  'bge-export':U
     1814                         , input  'bgeshift':U
     1815                         , output v-value-character
     1816                         , output v-value-date
     1817                         , output v-value-decimal
     1818                         , output v-value-integer
     1819                         , output v-value-logical
     1820                         , output v-param-type
     1821                         , input-output table-handle v-tth
     1822                         ) no-error .
     1823       if error-status :error
     1824       then do:
     1825         assign
     1826             v-bge-xml-shift-mode = no
     1827         .
     1828       end.
     1829       else do:
     1830         assign
     1831             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1832         .
     1833       end.
     1834       delete object v-tth.
     1835       run adm/shattri.p ( input "get":U
     1836                         , input  '':u
     1837                         , input  0
     1838                         , input  'bge-export':U
     1839                         , input  'bgeflold':U
     1840                         , output v-value-character
     1841                         , output v-value-date
     1842                         , output v-value-decimal
     1843                         , output v-value-integer
     1844                         , output v-value-logical
     1845                         , output v-param-type
     1846                         , input-output table-handle v-tth
     1847                         ) no-error .
     1848       if error-status :error
     1849       then do:
     1850         assign
     1851           v-bge-xml-bgeflold = "no-parameter":U
     1852         .
     1853       end.
     1854       else do:
     1855         assign
     1856           v-bge-xml-bgeflold  = v-value-character
     1857         .
     1858       end.
     1859       delete object v-tth.
     1860       assign
     1861         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1862         v-bge-xml-db-num-str  = v-db-num-str
     1863       .
     1864       if p-last-date <> ?
     1865       then do:
     1866           run adm/shattri.p ( input "get":U
     1867                             , input  '':u
     1868                             , input  0
     1869                             , input  'bge-export':U
     1870                             , input  'bgeflnm':U
     1871                             , output v-value-character
     1872                             , output v-value-date
     1873                             , output v-value-decimal
     1874                             , output v-value-integer
     1875                             , output v-value-logical
     1876                             , output v-param-type
     1877                             , input-output table-handle v-tth
     1878                             ) no-error .
     1879           if error-status :error
     1880           then do:
     1881             assign
     1882               v-bgeflnm = '':U
     1883             .
     1884           end.
     1885           else do:
     1886             assign
     1887               v-bgeflnm = v-value-character
     1888             .
     1889           end.
     1890           delete object v-tth.
     1891           if v-bge-xml-bgeflold = "var"
     1892           then do:
     1893               if v-bgeflnm = ?
     1894               or num-entries( v-bgeflnm ) < 2
     1895               then do:
     1896                   assign
     1897                       v-bge-xml-bgeflold = "new"
     1898                   .
     1899               end.
     1900               else do:
     1901                   assign
     1902                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1903                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1904                   .
     1905                   assign
     1906                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1907                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1908                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1909                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1910                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1911                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1912                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1913                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1914                   .
     1915               end.
     1916           end.
     1917       end.
     1918   end.
     1919   end procedure.
     1920   procedure bge-xml-get-ref-filename :
     1921   define input parameter p-in-file-name       as character        no-undo.
     1922   define output parameter p-home-dir          as character        no-undo.
     1923   define output parameter p-out-file-name     as character        no-undo.
     1924   define output parameter p-locked            as logical          no-undo.
     1925       define variable v-counter       as integer      no-undo.
     1926       define variable v-error-level   as integer      no-undo.
     1927   do
     1928   on error undo, return error
     1929   :
     1930       run bge/bge-ini.p (
     1931             input "bge"
     1932           , output p-home-dir
     1933       ).
     1934       if return-value <> "OK"
     1935       then do:
     1936           undo, return error.
     1937       end.
     1938       assign
     1939           p-home-dir = p-home-dir + "\dict":U
     1940       .
     1941       run bge/dir_cd.p (
     1942           input p-home-dir
     1943           , input "CA"
     1944       ).
     1945       if return-value = "ERROR"
     1946       then do:
     1947           undo, return error.
     1948       end.
     1949       assign
     1950           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     1951       .
     1952       assign
     1953           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     1954       .
     1955       wait-lock:
     1956       do v-counter = 1 TO 3
     1957       :
     1958           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     1959           if p-locked = no
     1960           then do:
     1961               leave wait-lock.
     1962           end.
     1963           else do:
     1964               readkey pause 1.
     1965           end.
     1966       END.
     1967       if p-locked = yes
     1968       then do:
     1969           undo, return error.
     1970       end.
     1971       run bge/os_copy.p (
     1972             input "D":U
     1973           , input p-out-file-name + "xml":U
     1974           , input "":U
     1975           , output v-error-level
     1976       ).
     1977       if v-error-level > 0
     1978       then do:
     1979           undo, return error.
     1980       end.
     1981   end.
     1982   end procedure.
     1983   procedure bge-xml-write-ref-header :
     1984   define input parameter p-bge-name as character        no-undo.
     1985   define input parameter p-file-name as character        no-undo.
     1986       define variable v-out-string    as character    no-undo.
     1987   do
     1988   on error undo, return error
     1989   :
     1990       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     1991       put stream stmXMLOut unformatted
     1992           "<?xml version='1.0' encoding='windows-1251'?>":U
     1993       .
     1994       assign
     1995           v-out-string = substitute( "&1&2"
     1996                               , chr(10)
     1997                               , "<IBS_Trade_House>":U )
     1998       .
     1999       put stream stmXMLOut unformatted
     2000           v-out-string
     2001       .
     2002       run wp-XMLTagOpen( 1, "header", "" ).
     2003       if v-bge-xml-bgeflold = "oracle":u
     2004       then do:
     2005         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2006         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2007         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2008         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2009         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2010       end.
     2011       else do:
     2012         run wp-XMLTagOpen( 2, "delivery", "" ).
     2013         run wp-XMLTagOpen( 3, "to", "" ).
     2014         run wp-XMLTagClose( 3, "to" ).
     2015         run wp-XMLTagOpen( 3, "from", "" ).
     2016         run wp-XMLTagClose( 3, "from" ).
     2017         run wp-XMLTagClose( 2, "delivery" ).
     2018       end.
     2019       run wp-XMLTagOpen( 2, "manifest", "" ).
     2020       run wp-XMLTagOpen( 3, "document", "" ).
     2021       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2022       run wp-XMLTagPut( 4, "description", "", 0 ).
     2023       run wp-XMLTagClose( 3, "document" ).
     2024       run wp-XMLTagClose( 2, "manifest" ).
     2025       run wp-XMLTagClose( 1, "header" ).
     2026       run wp-XMLTagOpen( 1, "body", "" ).
     2027   end.
     2028   end procedure.
     2029   procedure bge-xml-write-ref-footer :
     2030   define input parameter p-file-name as character        no-undo.
     2031       define variable v-error-level   as integer      no-undo.
     2032   do
     2033   on error undo, return error
     2034   :
     2035       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2036       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2037       output stream stmXMLOut close.
     2038       run bge/os_copy.p (
     2039             input "M":U
     2040           , input p-file-name + "xm1":U
     2041           , input p-file-name + "xml":U
     2042           , output v-error-level
     2043       ).
     2044       if v-error-level > 0
     2045       then do:
     2046           undo, return error.
     2047       end.
     2048   end.
     2049   end procedure.
     2050   procedure bge-xml-out-dir :
     2051   define output parameter p-out-dir       as character    no-undo.
     2052   define output parameter p-log-file-name as character    no-undo.
     2053   do
     2054   on error undo, return error
     2055   :
     2056       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2057       if p-out-dir = ?
     2058       then do:
     2059           message
     2060             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2061                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2062             skip(1)
     2063             skip "Обратитесь к администратору."
     2064           view-as alert-box error.
     2065           undo, return error .
     2066       end.
     2067       if v-bge-xml-bgeflold <> "oracle" then assign
     2068         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2069       .
     2070       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2071       if error-status :error  then do:
     2072           run wp-XMLWriteLog in this-procedure (
     2073                 input p-log-file-name
     2074               , input 0
     2075               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2076                                   , p-out-dir
     2077                                   , return-value
     2078                                   , trim( error-status :get-message( 1 ) )
     2079                                   )
     2080           ).
     2081           undo, return error.
     2082       end.
     2083       assign
     2084           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2085           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2086       .
     2087   end.
     2088   end procedure.
     2089   procedure bge-xml-out-dir2 :
     2090   define output parameter p-out-dir       as character    no-undo.
     2091   define output parameter p-out-dirR      as character    no-undo.
     2092   define output parameter p-log-file-name as character    no-undo.
     2093   do
     2094   on error undo, return error
     2095   :
     2096       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2097       if p-out-dir = ?
     2098       then do:
     2099           message
     2100             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2101                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2102             skip(1)
     2103             skip "Обратитесь к администратору."
     2104           view-as alert-box error.
     2105           undo, return error .
     2106       end.
     2107       if v-bge-xml-bgeflold <> "oracle" then assign
     2108             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2109             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2110         .
     2111       else p-out-dirR = p-out-dir .
     2112       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2113       if error-status :error  then do:
     2114           run wp-XMLWriteLog in this-procedure (
     2115                 input p-log-file-name
     2116               , input 0
     2117               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2118                                   , p-out-dir
     2119                                   , return-value
     2120                                   , error-status :get-message( 1 )
     2121                                   )
     2122           ).
     2123           undo, return error.
     2124       end.
     2125       if p-out-dirR <> p-out-dir then do:
     2126         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2127         if error-status :error then do:
     2128           run wp-XMLWriteLog in this-procedure (
     2129                 input p-log-file-name
     2130               , input 0
     2131               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2132                                   , p-out-dirR
     2133                                   , return-value
     2134                                   , error-status :get-message( 1 )
     2135                                   )
     2136           ).
     2137           p-out-dirR = p-out-dir .
     2138         end.
     2139       end .
     2140       assign
     2141         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2142         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2143       .
     2144   end.
     2145   end procedure.
     2146   procedure bge-xml-out-file :
     2147   do
     2148   on error undo, return error
     2149   :
     2150   define input parameter p-out-dir            as character        no-undo.
     2151   define input parameter p-prefix             as character        no-undo.
     2152   define input parameter p-sheduled           as logical          no-undo.
     2153   define output parameter p-xml-file-name     as character        no-undo.
     2154   define output parameter p-locked            as logical          no-undo.
     2155   define variable v-home-dir      as character     no-undo.
     2156   define variable v-error-num     as integer       no-undo.
     2157   define variable v-today             as date         no-undo.
     2158   define variable v-time              as integer      no-undo.
     2159       if v-bge-xml-bgefmt = "dbf":U
     2160       then do:
     2161           assign
     2162               p-xml-file-name = p-out-dir
     2163               p-locked        = no
     2164           .
     2165       end.
     2166       else do:
     2167           if v-bge-xml-bgeflold = "firm":U
     2168           then do:
     2169               run bge/genfname.p (
     2170                     input p-out-dir
     2171                   , input p-prefix
     2172                   , input "":U
     2173                   , input "arj":U
     2174                   , input "":U
     2175                   , output p-xml-file-name
     2176               ).
     2177           end.
     2178           else do:
     2179               run bge/genfname.p (
     2180                     input p-out-dir
     2181                   , input p-prefix
     2182                   , input "":U
     2183                   , input "xml":U
     2184                   , input "":U
     2185                   , output p-xml-file-name
     2186               ).
     2187           end.
     2188           assign
     2189               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2190               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2191           .
     2192       end.
     2193   end.
     2194   end procedure.
     2195   procedure bge-xml-init-ext-doc-type :
     2196       define variable v-counter    as integer      no-undo.
     2197       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2198   do
     2199   for buf_temp_ext-doc-type
     2200   on error undo, return error
     2201   :
     2202       empty temp-table buf_temp_ext-doc-type.
     2203       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2204       :
     2205           create buf_temp_ext-doc-type.
     2206           assign
     2207               buf_temp_ext-doc-type.edt-key               = v-counter
     2208               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2209               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2210           .
     2211       end.
     2212   end.
     2213   end procedure.
     2214   procedure bge-xml-get-decimal-shift-num :
     2215   define input parameter p-shift-date     as date             no-undo.
     2216   define input parameter p-shift-num      as integer          no-undo.
     2217   define output parameter p-shift-decimal as decimal          no-undo.
     2218   do
     2219   on error undo, return error
     2220   :
     2221       assign
     2222           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2223       .
     2224   end.
     2225   end procedure.
     2226   procedure bge-xml-ora-exp-filename :
     2227     define input  parameter p-table-name  as character no-undo .
     2228     define input  parameter p-doc-code    as character no-undo .
     2229     define input  parameter p-obj-code    as integer   no-undo .
     2230     define output parameter p-filename    as character no-undo .
     2231     define output parameter p-seq-num     as integer   no-undo .
     2232     define variable v-ora-exp-seq     as integer   no-undo .
     2233     define variable v-ora-exp-seq-str as character no-undo .
     2234     define variable v-home-dir        as character no-undo.
     2235   do
     2236   on error undo, return error return-value
     2237   :
     2238     if v-bge-xml-bgeflold = "oracle":u
     2239     then do:
     2240       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2241       if v-home-dir = ?
     2242       then do:
     2243         undo, return error substitute( "&1&2&3":U
     2244                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2245                                       , chr(10)
     2246                                       , "Обратитесь к администратору.":U
     2247                                       ).
     2248       end.
     2249       assign
     2250           v-home-dir = v-home-dir
     2251       .
     2252       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2253       if error-status :error
     2254       then do:
     2255         undo, return error substitute( "&1&2&3":U
     2256                                       , "Неверно задан каталог экспорта.":U
     2257                                       , chr(10)
     2258                                       , "Обратитесь к администратору.":U
     2259                                       ).
     2260       end.
     2261       assign
     2262         v-ora-exp-seq = ?
     2263       .
     2264       if  p-table-name <> ? and
     2265           p-doc-code <> ?
     2266       then do:
     2267         run bge/get-oesq.p ( input p-table-name
     2268                            , input p-doc-code
     2269                            , output v-ora-exp-seq
     2270                            ) no-error .
     2271         if error-status :error = yes
     2272         then do:
     2273           undo, return error return-value .
     2274         end.
     2275       end.
     2276       if v-ora-exp-seq = ?
     2277       then do:
     2278         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2279         if error-status :error
     2280         then do:
     2281           undo, return error return-value .
     2282         end.
     2283       end.
     2284       if p-table-name <> ? and
     2285          p-doc-code   <> ?
     2286       then do:
     2287         run bge/oesqdoc.p ( input p-table-name
     2288                           , input p-doc-code
     2289                           , input v-ora-exp-seq
     2290                           ) no-error .
     2291         if error-status :error = yes
     2292         then do:
     2293           undo, return error return-value .
     2294         end.
     2295       end.
     2296       assign
     2297         p-seq-num  = v-ora-exp-seq
     2298         p-filename = substitute("&1/&2-000_&3."
     2299                                , v-home-dir
     2300                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2301                                , string(v-ora-exp-seq , "999999999")
     2302                                )
     2303       .
     2304     end.
     2305   end.
     2306   end procedure.
     2307   procedure bge-xml-date-to-str :
     2308     define input  parameter p-date  as date      no-undo .
     2309     define output parameter p-str   as character no-undo .
     2310   do
     2311   on error undo, return error return-value
     2312   :
     2313     if p-date <> ?
     2314     then do:
     2315       assign
     2316         p-str = substitute( "&1-&2-&3"
     2317                           , string( year(p-date)  , "9999")
     2318                           , string( month(p-date) , "99"  )
     2319                           , string( day(p-date)   , "99"  )
     2320                           )
     2321       .
     2322     end.
     2323     else do:
     2324       assign
     2325         p-str = ?
     2326       .
     2327     end.
     2328   end.
     2329   end procedure.
     2330   procedure bge-xml-date-str-to-str :
     2331     define input  parameter p-date-str  as character no-undo .
     2332     define output parameter p-str       as character no-undo .
     2333     define variable v-date          as date      no-undo .
     2334     define variable v-date-valid    as logical   no-undo .
     2335     define variable v-error-message as character no-undo .
     2336   do
     2337   on error undo, return error return-value
     2338   :
     2339     assign
     2340       p-str = ?
     2341     .
     2342     if p-date-str = ? or p-date-str = ""
     2343     then do:
     2344       return .
     2345     end.
     2346     run strtdate in this-procedure ( input  p-date-str
     2347                                    , output v-date
     2348                                    , output v-date-valid
     2349                                    , output v-error-message
     2350                                    ).
     2351     if v-date-valid <> true
     2352     then do:
     2353       return .
     2354     end.
     2355     assign
     2356       p-str = substitute( "&1-&2-&3"
     2357                         , string( year(v-date)  , "9999")
     2358                         , string( month(v-date) , "99"  )
     2359                         , string( day(v-date)   , "99"  )
     2360                         )
     2361     .
     2362   end.
     2363   end procedure.
     2364   procedure bge-xml-fill-tt-bgecliiv :
     2365     define input  parameter p-str as character no-undo .
     2366     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2367     define buffer buf_clients             for ub.clients.
     2368     define variable v-i         as integer   no-undo .
     2369     define variable v-count     as integer   no-undo .
     2370     define variable v-cli-count as integer   no-undo .
     2371     define variable v-client    as character no-undo .
     2372     define variable v-obj-type  as character no-undo .
     2373     define variable v-obj-code  as integer   no-undo .
     2374   do
     2375   on error undo, return error return-value
     2376   :
     2377     empty temp-table buf_tt-bge-xml-bgecliiv.
     2378     assign
     2379       v-bge-xml-bgecliiv = no
     2380       v-cli-count        = num-entries(p-str,';')
     2381     .
     2382     if v-cli-count > 0
     2383     then do:
     2384       _cli-cycle:
     2385       do v-i = 1 to v-cli-count
     2386       :
     2387         assign
     2388           v-client = entry(v-i , p-str, ';')
     2389         .
     2390         if num-entries(v-client) <> 2
     2391         then do:
     2392           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2393         end.
     2394         assign
     2395           v-obj-type = entry(1, v-client)
     2396         .
     2397         assign
     2398           v-obj-code = integer(entry(2, v-client))
     2399         no-error .
     2400         if error-status :error
     2401         then do:
     2402           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2403         end.
     2404         find first buf_clients no-lock
     2405           where buf_clients.obj-type = v-obj-type
     2406             and buf_clients.obj-code = v-obj-code
     2407         no-error.
     2408         if not available buf_clients
     2409         then do:
     2410           next _cli-cycle.
     2411         end.
     2412         find first buf_tt-bge-xml-bgecliiv no-lock
     2413           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2414             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2415         no-error .
     2416         if available buf_tt-bge-xml-bgecliiv
     2417         then do:
     2418           next _cli-cycle.
     2419         end.
     2420         create buf_tt-bge-xml-bgecliiv.
     2421         assign
     2422           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2423           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2424         .
     2425       end.
     2426     end.
     2427     else do:
     2428       assign
     2429         v-bge-xml-bgecliiv = no
     2430       .
     2431       return .
     2432     end.
     2433     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2434     if available buf_tt-bge-xml-bgecliiv
     2435     then do:
     2436       assign
     2437         v-bge-xml-bgecliiv = yes
     2438       .
     2439     end.
     2440   end.
     2441   end procedure.
     2442   procedure bge-xml-resolve-ext-doc-type :
     2443     define input  parameter p-ext-doc-type      as character no-undo .
     2444     define input  parameter p-obj-type          as character no-undo .
     2445     define input  parameter p-obj-code          as integer   no-undo .
     2446     define output parameter p-out-ext-doc-type  as character no-undo .
     2447     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2448   do
     2449   on error undo, return error return-value
     2450   :
     2451     assign
     2452       p-out-ext-doc-type = p-ext-doc-type
     2453     .
     2454     if p-ext-doc-type <> 'ie':U
     2455     then do:
     2456       return .
     2457     end.
     2458     if v-bge-xml-bgecliiv = yes
     2459     then do:
     2460       find first buf_tt-bge-xml-bgecliiv no-lock
     2461         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2462           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2463       no-error .
     2464       if available buf_tt-bge-xml-bgecliiv
     2465       then do:
     2466         assign
     2467           p-out-ext-doc-type = 'iv':U
     2468         .
     2469       end.
     2470     end.
     2471   end.
     2472   end procedure.
     2473   procedure safe-wp-xmltagput :
     2474     define input  parameter pTagLevel   as integer   no-undo .
     2475     define input  parameter pTagName    as character no-undo .
     2476     define input  parameter pParValue   as character no-undo .
     2477     define input  parameter pFlagEmpty  as integer   no-undo .
     2478   do
     2479   on error undo, return error return-value
     2480   :
     2481     if v-bge-xml-bgeflold = "oracle":u
     2482     then do:
     2483       return .
     2484     end.
     2485     run wp-xmltagput in this-procedure ( input pTagLevel
     2486                                        , input pTagName
     2487                                        , input pParValue
     2488                                        , input pFlagEmpty
     2489                                        ).
     2490   end.
     2491   end procedure.
     2492   define new global shared variable g#lib-trn  as handle no-undo .
     2493   define new global shared variable g#lib-trn2 as handle no-undo .
     2494   define new global shared variable g#lib-trn3 as handle no-undo .
     2495   define new global shared variable g#lib-trn4 as handle no-undo .
     2496   procedure create-fin-ob-attr :
     2497    do
     2498    on error undo, return error return-value
     2499    :
     2500   define input parameter p-host-code     like ub.fin-ob-attr.host-code  no-undo .
     2501   define input parameter p-doc-code      like ub.fin-ob-attr.doc-code   no-undo .
     2502   define input parameter p-attr-code     like ub.fin-ob-attr.attr-code  no-undo .
     2503   define input parameter p-attr-value    like ub.fin-ob-attr.attr-value no-undo .
     2504   define buffer buf_fin-ob-attr for ub.fin-ob-attr.
     2505   find first buf_fin-ob-attr  exclusive-lock  where
     2506     buf_fin-ob-attr.attr-code    = p-attr-code    and
     2507     buf_fin-ob-attr.host-code    = p-host-code    and
     2508     buf_fin-ob-attr.doc-code     = p-doc-code  no-error .
     2509     if not available  buf_fin-ob-attr then do:
     2510         create buf_fin-ob-attr.
     2511         assign
     2512           buf_fin-ob-attr.attr-code    = p-attr-code
     2513           buf_fin-ob-attr.attr-value   = p-attr-value
     2514           buf_fin-ob-attr.host-code    = p-host-code
     2515           buf_fin-ob-attr.doc-code     = p-doc-code
     2516         .
     2517     end.
     2518     else do:
     2519           buf_fin-ob-attr.attr-value   = p-attr-value .
     2520     end.
     2521    end.
     2522   end procedure.
     2523   procedure view-fin-ob-attr :
     2524    do
     2525    on error undo, return error return-value
     2526    :
     2527   define input  parameter p-host-code    like ub.fin-ob-attr.host-code    no-undo .
     2528   define input  parameter p-doc-code     like ub.fin-ob-attr.doc-code     no-undo .
     2529   define input  parameter p-attr-code    like ub.fin-ob-attr.attr-code    no-undo .
     2530   define output parameter p-attr-value   like ub.fin-ob-attr.attr-value   no-undo .
     2531   define buffer buf_fin-ob-attr for ub.fin-ob-attr.
     2532   find first buf_fin-ob-attr no-lock where
     2533     buf_fin-ob-attr.attr-code    = p-attr-code    and
     2534     buf_fin-ob-attr.doc-code      = p-doc-code      no-error .
     2535     if available  buf_fin-ob-attr then do:
     2536         assign
     2537           p-attr-value = buf_fin-ob-attr.attr-value
     2538         .
     2539     end.
     2540     else do:
     2541           p-attr-value = ? .
     2542     end.
     2543    end.
     2544   end procedure.
     2545   do
     2546   on error undo, return error
     2547   :
     2548   define variable v-base-code       as integer       no-undo.
     2549   define variable v-base-abbr       like ub.currency.curr-abbr no-undo .
     2550   define variable v-base-name       like ub.currency.curr-name no-undo .
     2551   define buffer buf_currency for ub.currency.
     2552   if not valid-handle ( p-parent-proc )
     2553   then do:
     2554       return.
     2555   end.
     2556   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2557   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2558     (input  p-host-code
     2559     ,output v-base-code
     2560     )  .
     2561   find first buf_currency no-lock where
     2562             buf_currency.curr-code = v-base-code no-error .
     2563   if available buf_currency then
     2564   assign
     2565   v-base-abbr = buf_currency.curr-abbr
     2566   v-base-name = buf_currency.curr-name
     2567   .
     2568   OUTPUT STREAM stmXMLOut TO VALUE ( sOutFile + "xm1" ) CONVERT TARGET "1251" APPEND.
     2569   RUN wp-XMLWriteCNT ( hCNT, "" ).
     2570   run export-documents in this-procedure .
     2571   output stream stmxmlout close.
     2572   end.
     2573   procedure export-documents :
     2574   do
     2575   on error undo, return error
     2576   :
     2577     define variable v-ext-fin-ob-type  as character    no-undo.
     2578     define variable v-fin-doc-code      as character no-undo .
     2579     define variable v-doc-date          as date         no-undo.
     2580     define variable v-fact-date         as date         no-undo.
     2581     define variable v-doc-PS            as character    no-undo.
     2582     define variable v-bge-date          as date         no-undo.
     2583     define variable v-bge-date-str      as character    no-undo.
     2584     define buffer buf_fin-ob            for ub.fin-ob.
     2585     define buffer buf_fin-ob-attr       for ub.fin-ob-attr.
     2586     export-fin-obs:
     2587     for each buf_fin-ob no-lock
     2588         where buf_fin-ob.host-code = p-host-code
     2589           and buf_fin-ob.status_  = 'факт':U
     2590     on error undo, return error
     2591     :
     2592        find first buf_fin-ob-attr no-lock where
     2593             buf_fin-ob-attr.host-code = p-host-code
     2594         AND buf_fin-ob-attr.doc-code  = buf_fin-ob.doc-code
     2595         AND buf_fin-ob-attr.attr-code = 'bge-date':U no-error .
     2596         if available buf_fin-ob-attr then next export-fin-obs.
     2597         assign
     2598         v-fin-doc-code  = buf_fin-ob.doc-code
     2599         v-doc-date      = buf_fin-ob.doc-date
     2600         v-fact-date     = buf_fin-ob.fact-date
     2601         v-doc-ps        = buf_fin-ob.ps
     2602         .
     2603         run export-fin-ob (
     2604              input p-host-code
     2605             , input v-fin-doc-code
     2606             , input v-doc-date
     2607             , input v-fact-date
     2608             , input v-doc-ps
     2609           ) no-error.
     2610         if error-status :error then do:
     2611           run wp-XMLWriteLog in this-procedure (
     2612                 input sLogFile
     2613               , input 1
     2614               , input substitute ( "Ошибка экспорта ФО. Номер документа: &1. &2. &3 &4 "
     2615                                   , v-fin-doc-code
     2616                                   , return-value
     2617                                   , trim (error-status :get-message (1))
     2618                                   , trim (error-status :get-message (2))
     2619                                 )
     2620           ).
     2621           undo export-fin-obs, next export-fin-obs.
     2622         end.
     2623         run run-callback-write-doc-code in this-procedure (
     2624               input p-parent-proc
     2625             , input "fin-ob":U
     2626             , input buf_fin-ob.host-code
     2627             , input buf_fin-ob.doc-code
     2628             , input 0
     2629             , input 0
     2630             , input slogfile
     2631         ).
     2632       end.
     2633    end.
     2634   end procedure.
     2635   procedure export-fin-ob :
     2636   define input parameter p-host-code              as integer      no-undo .
     2637   define input parameter p-fin-doc-code           as character no-undo .
     2638   define input parameter p-doc-date               as date         no-undo.
     2639   define input parameter p-fact-date              as date         no-undo.
     2640   define input parameter p-doc-PS                 as character    no-undo.
     2641   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2642     define variable v-doc-code      as character    no-undo.
     2643     define variable v-exch-abbr       like ub.currency.curr-abbr no-undo .
     2644     define variable v-exch-name       like ub.currency.curr-name no-undo .
     2645     define variable v-contr-abbr       like ub.currency.curr-abbr no-undo .
     2646     define variable v-contr-name       like ub.currency.curr-name no-undo .
     2647     define variable v-contract-prn-code like ub.contract.contract-prn-code no-undo .
     2648     define variable v-contract-date     like ub.contract.contract-date no-undo .
     2649     define buffer buf_fin-ob-tax-before          for ub.fin-ob-tax-before.
     2650     define buffer buf_fin-ob-tax          for ub.fin-ob-tax.
     2651     define buffer buf_fin-ob              for ub.fin-ob.
     2652     define buffer buf_fin-ob-before       for ub.fin-ob-before.
     2653     define buffer buf_fin-ob-trn          for ub.fin-ob-trn.
     2654     define buffer buf_fin-gds-part        for ub.fin-gds-part.
     2655     define buffer buf_fin-connect         for ub.fin-connect.
     2656     define buffer buf_contract for ub.contract.
     2657   define variable v-exists-before     as logical      no-undo.
     2658   define variable v-exists-after      as logical      no-undo.
     2659   define variable v-doc-date          as date         no-undo.
     2660   define variable v-today             as date         no-undo.
     2661   define variable v-time              as integer      no-undo.
     2662   do
     2663   on error undo, return error
     2664   :
     2665    find first buf_fin-ob no-lock where
     2666              buf_fin-ob.host-code = p-host-code
     2667          AND buf_fin-ob.doc-code = p-fin-doc-code no-error .
     2668     if not available buf_fin-ob then do:
     2669     end.
     2670     assign
     2671     v-doc-date  = buf_fin-ob.doc-date
     2672     .
     2673     run wp-XMLWriteCnt ( hcnt, "   " + string ( p-fin-doc-code ) + " от " + string ( p-fact-date ) ) .
     2674     process events.
     2675     run wp-xmltagopen ( 2, "operation","" ).
     2676     run wp-xmltagput ( 3, "referenceNo",        string ( p-fin-doc-code                       ), 0 ).
     2677     run wp-xmltagput ( 3, "host",               string ( p-host-code                          ), 0 ).
     2678     run wp-xmltagput ( 3, "dateDoc",            string ( v-doc-date,"99.99.9999"              ), 0 ).
     2679     run wp-xmltagput ( 3, "dateFact",           string ( p-fact-date,"99.99.9999"             ), 0 ).
     2680     run wp-xmltagput ( 3, "valutCode",          string ( v-base-code                          ), 0 ).
     2681   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2682   run wp-xmltagopen in this-procedure ( input 0 + 4, substitute("&1", 'fin-ob'),  "" ).
     2683   run wp-xmltagput in this-procedure ( input 1 + 4, input substitute('&1', 'DocID'),  input string(buf_fin-ob.doc-code), input 1 ).
