      591   procedure xmlchar-decode :
      592   define input parameter p-in-string      as character        no-undo.
      593   define output parameter p-out-string    as character        no-undo.
      594       define variable v-position      as integer      no-undo.
      595       define variable v-last-position as integer      no-undo.
      596       define variable v-temp-integer  as integer      no-undo.
      597       define variable v-current-char  as character    no-undo.
      598       define variable v-next-char     as character    no-undo.
      599       define variable v-success       as logical      no-undo.
      600   do
      601   on error undo, return error
      602   :
      603       assign
      604           p-out-string = "":U
      605           v-position   = 0
      606       .
      607       replace-cycle:
      608       do while yes
      609       on error undo, return error
      610       :
      611           assign
      612               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      613           .
      614           if v-last-position <= v-position
      615           then do:
      616               if v-position = 0
      617               then do:
      618                   assign
      619                       p-out-string = p-in-string
      620                   .
      621               end.
      622               else do:
      623                   assign
      624                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      625                   .
      626               end.
      627               leave replace-cycle.
      628           end.
      629           else do:
      630               assign
      631                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      632                   v-position      = v-last-position
      633                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      634               .
      635               if v-current-char = "#":U
      636               then do:
      637                   assign
      638                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      639                   .
      640                   if v-last-position > 0
      641                   then do:
      642                       run xmlchar-read-integer in this-procedure
      643                        (
      644                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      645                           , output v-temp-integer
      646                           , output v-success
      647                       ).
      648                       if v-success = yes
      649                       and v-temp-integer >= 1
      650                       and v-temp-integer <= 255
      651                       then do:
      652                           assign
      653                               p-out-string = p-out-string + chr( v-temp-integer )
      654                               v-position   = v-last-position + 1
      655                           .
      656                       end.
      657                       else do:
      658                           assign
      659                               p-out-string = p-out-string + "&":U
      660                               v-position   = v-position   + 1
      661                           .
      662                       end.
      663                   end.
      664                   else do:
      665                       assign
      666                           p-out-string = p-out-string + "&":U
      667                           v-position   = v-position   + 1
      668                       .
      669                   end.
      670               end.
      671               else do:
      672                   case substring( p-in-string, v-position + 1, 3 )
      673                   :
      674                       when "lt;":U
      675                       then do:
      676                           assign
      677                               p-out-string = p-out-string + "<":U
      678                               v-position   = v-position   + 3
      679                           .
      680                       end.
      681                       when "gt;":U
      682                       then do:
      683                           assign
      684                               p-out-string = p-out-string + ">":U
      685                               v-position   = v-position   + 3
      686                           .
      687                       end.
      688                       otherwise do:
      689                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      690                           then do:
      691                               assign
      692                                   p-out-string = p-out-string + "&":U
      693                                   v-position   = v-position   + 4
      694                               .
      695                           end.
      696                           else do:
      697                               case substring( p-in-string, v-position + 1, 5 )
      698                               :
      699                                   when "quot;":U
      700                                   then do:
      701                                       assign
      702                                           p-out-string = p-out-string + '"':U
      703                                           v-position   = v-position   + 5
      704                                       .
      705                                   end.
      706                                   when "apos;":U
      707                                   then do:
      708                                       assign
      709                                           p-out-string = p-out-string + "'":U
      710                                           v-position   = v-position   + 5
      711                                       .
      712                                   end.
      713                                   otherwise do:
      714                                       assign
      715                                           p-out-string = p-out-string + "&":U
      716                                       .
      717                                   end.
      718                               end case.
      719                           end.
      720                       end.
      721                   end case.
      722               end.
      723           end.
      724       end.
      725   end.
      726   end .
      727   procedure xmlchar-read-integer :
      728   define input parameter p-input-string      as character        no-undo.
      729   define output parameter p-output-integer   as integer          no-undo.
      730   define output parameter p-success       as logical          no-undo.
      731   do
      732   on error undo, return error
      733   :
      734       assign
      735           p-output-integer = integer( p-input-string )
      736       no-error.
      737       if error-status :error
      738       then do:
      739           assign
      740               p-success           = no
      741               p-output-integer    = 0
      742           .
      743       end.
      744       else do:
      745           assign
      746               p-success           = yes
      747           .
      748       end.
      749   end.
      750   end.
      751   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      752   procedure strtdate :
      753     define input  parameter p-str         as character no-undo .
      754     define output parameter p-value       as date      no-undo .
      755     define output parameter p-data-valid  as logical   no-undo .
      756     define output parameter p-message     as character no-undo .
      757   do
      758   on error undo, return error return-value
      759   :
      760     define variable v-value       as date      no-undo .
      761     define variable v-i           as integer   no-undo .
      762     define variable v-num         as integer   no-undo .
      763     define variable v-delim       as character no-undo .
      764     define variable v-delim-list  as character no-undo .
      765     define variable v-day         as integer   no-undo .
      766     define variable v-month       as integer   no-undo .
      767     define variable v-year        as integer   no-undo .
      768     define variable v-day-str     as character no-undo .
      769     define variable v-month-str   as character no-undo .
      770     define variable v-year-str    as character no-undo .
      771     assign
      772       p-value       = ?
      773       p-data-valid  = false
      774     .
      775     if p-str = ?
      776     then do:
      777       assign
      778         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      779       .
      780       return .
      781     end.
      782     if p-str = ""
      783     then do:
      784       assign
      785         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      786       .
      787       return .
      788     end.
      789     if length(p-str)  > 10
      790     then do:
      791       assign
      792         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      793       .
      794       return .
      795     end.
      796     assign
      797       v-delim-list = '/,-,.':U
      798     .
      799     _delim:
      800     do v-i = 1 to num-entries( v-delim-list )
      801     :
      802       assign
      803         v-delim = entry( v-i , v-delim-list )
      804         v-num   = num-entries( p-str , v-delim )
      805       .
      806       if v-num <> 3
      807       then do:
      808         assign
      809           v-delim = ''
      810         .
      811       end.
      812       else do:
      813         leave _delim.
      814       end.
      815     end.
      816     if v-delim = ''
      817     then do:
      818       assign
      819         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      820       .
      821       return .
      822     end.
      823     assign
      824       v-day-str   = entry( 1, p-str , v-delim)
      825       v-month-str = entry( 2, p-str , v-delim)
      826       v-year-str  = entry( 3, p-str , v-delim)
      827     .
      828     if  length(v-day-str) > 2   or
      829         length(v-day-str) < 1   or
      830         length(v-month-str) > 2 or
      831         length(v-month-str) < 1 or
      832         (
      833           length(v-year-str) <> 2 and
      834           length(v-year-str) <> 4
      835         )
      836     then do:
      837       assign
      838         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      839       .
      840       return .
      841     end.
      842     if length( v-year-str ) = 2
      843     then do:
      844       assign
      845         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      846       .
      847     end.
      848     assign
      849       v-day   = integer( v-day-str )
      850       v-month = integer( v-month-str)
      851       v-year  = integer( v-year-str)
      852     no-error .
      853     if error-status :error
      854     then do:
      855       assign
      856         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      857       .
      858       return .
      859     end.
      860     if v-day < 1  or
      861        v-day > 31 or
      862        v-month < 1 or
      863        v-month > 12 or
      864        v-year < 0   or
      865        v-year > 5000
      866     then do:
      867       assign
      868         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      869       .
      870       return .
      871     end.
      872     assign
      873       v-value = date( v-month, v-day, v-year )
      874     no-error .
      875     if error-status :error
      876     then do:
      877       assign
      878         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      879       .
      880       return .
      881     end.
      882     assign
      883       p-value       = v-value
      884       p-data-valid  = true
      885     .
      886   end.
      887   end procedure.
      888   define variable v-bge-xml-bgecliiv      as logical  init no  no-undo.
      889   define variable v-bge-xml-bgeclall      as logical  init no  no-undo.
