       84   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
       85   procedure thbjattr_code :
       86      define input  parameter p-upper-code     as character no-undo .
       87      define input  parameter p-code           as character no-undo .
       88      define output parameter p-label          as character no-undo .
       89      define output parameter p-user-can-edit  as logical   no-undo .
       90      define output parameter p-output-display as logical   no-undo .
       91      define output parameter p-other          as character no-undo .
       92      define output parameter p-prop-list      as character no-undo .
       93      define output parameter p-prop-type-list as character no-undo .
       94      define output parameter p-prop-label-list as character no-undo .
       95      define output parameter p-global          as logical no-undo .
       96      define output parameter p-host           as logical no-undo .
       97      define output parameter p-shop           as logical no-undo .
       98      define output parameter p-store          as logical no-undo .
       99      define output parameter p-db             as logical no-undo .
      100      define variable p-region as logical no-undo.
      101      run thbjattr_code_reg in this-procedure (
      102                                               p-upper-code,
      103                                               p-code,
      104                                               output p-label,
      105                                               output p-user-can-edit,
      106                                               output p-output-display,
      107                                               output p-other,
      108                                               output p-prop-list,
      109                                               output p-prop-type-list,
      110                                               output p-prop-label-list,
      111                                               output p-global,
      112                                               output p-host,
      113                                               output p-shop,
      114                                               output p-store,
      115                                               output p-db,
      116                                               output p-region
      117                                               ).
      118   end procedure.
      119   procedure thbjattr_code_reg :
      120   define input  parameter p-upper-code     as character no-undo .
      121   define input  parameter p-code           as character no-undo .
      122   define output parameter p-label          as character no-undo .
      123   define output parameter p-user-can-edit  as logical   no-undo .
      124   define output parameter p-output-display as logical   no-undo .
      125   define output parameter p-other          as character no-undo .
      126   define output parameter p-prop-list      as character no-undo .
      127   define output parameter p-prop-type-list as character no-undo .
      128   define output parameter p-prop-label-list as character no-undo .
      129   define output parameter p-global          as logical no-undo .
      130   define output parameter p-host           as logical no-undo .
      131   define output parameter p-shop           as logical no-undo .
      132   define output parameter p-store          as logical no-undo .
      133   define output parameter p-db             as logical no-undo .
      134   define output parameter p-region         as logical no-undo .
      135   do
      136   on error undo, return error return-value
      137   :
      138       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      139       (input  p-upper-code
      140       ,input  p-code
      141       ,output p-label
      142       ,output p-user-can-edit
      143       ,output p-output-display
      144       ,output p-other
      145       ,output p-prop-list
      146       ,output p-prop-type-list
      147       ,output p-prop-label-list
      148       ,output p-global
      149       ,output p-host
      150       ,output p-shop
      151       ,output p-store
      152       ,output p-db
      153       ,output p-region
      154       ) no-error .
      155     if error-status :error
      156     then do:
      157       undo, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1)).
      158     end.
      159   end.
      160   end procedure.
