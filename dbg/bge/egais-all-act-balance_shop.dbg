      411        SIZE 15 BY 1.13.
      412   DEFINE BUTTON Btn_OK AUTO-GO
      413        LABEL "Выход"
      414        SIZE 15 BY 1.13
      415        BGCOLOR 8 .
      416   DEFINE BUTTON Btn_Ans
      417        LABEL "Посмотреть ответ"
      418        SIZE 20 BY 1.13
      419        BGCOLOR 8 .
      420   DEFINE BUTTON Btn_Edit
      421        LABEL "Редактировать"
      422        SIZE 15 BY 1.13 tooltip "Вернуть в 'Новые' для редактирования"
      423        BGCOLOR 8 .
      424   DEFINE VARIABLE f-date AS DATE FORMAT "99/99/99":U
      425        LABEL "Дата с"
      426        VIEW-AS FILL-IN
      427        SIZE 9.5 BY 1 NO-UNDO.
      428   DEFINE VARIABLE f-date-2 AS DATE FORMAT "99/99/99":U
      429        LABEL "по"
      430        VIEW-AS FILL-IN
      431        SIZE 9.5 BY 1 NO-UNDO.
      432   DEFINE VARIABLE RADIO-SET-1 AS INTEGER INITIAL 1
      433        VIEW-AS RADIO-SET HORIZONTAL
      434        RADIO-BUTTONS
      435             "Новые", 1,
      436             "Отправленные", 2
      437        SIZE 27 BY 1.25 NO-UNDO.
      438   DEFINE FRAME Dialog-Frame
      439        Btn_OK AT ROW 1.2 COL 2
      440        Btn_create at row 1.2 col 17
      441        Btn_chg at row 1.2 col 32
      442        Btn_del at row 1.2 col 47
      443        Btn_send at row 1.2 col 62
      444        Btn_Ans AT ROW 1.2 COL 32 WIDGET-ID 10
      445        Btn_lkp AT ROW 1.2 COL 17 WIDGET-ID 12
      446            Btn_Edit AT ROW 1.2 COL 52
      447        RADIO-SET-1 AT ROW 1.2 COL 80 NO-LABEL WIDGET-ID 2
      448        f-date AT ROW 2.5 COL 8.63 COLON-ALIGNED WIDGET-ID 22
      449        f-date-2 AT ROW 2.5 COL 22.75 COLON-ALIGNED WIDGET-ID 26
      450        SPACE(2) SKIP(22.2)
      451       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      452            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      453            TITLE "Акты постановки на баланс в торговом зале в ЕГАИС"
      454            DEFAULT-BUTTON Btn_OK WIDGET-ID 100.
      455   ASSIGN
      456          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      457          FRAME Dialog-Frame:HIDDEN           = TRUE.
      458   ON window-close OF FRAME Dialog-Frame
      459   do:
      460       delete object egais no-error .
      461     apply "END-ERROR":U to self.
      462   end.
      463   ON CHOOSE OF Btn_lkp IN FRAME Dialog-Frame
      464   DO:
      465       if not bh-act-header:available then return no-apply .
      466       run bge/egais-act-balance_shop.w (parparentproc, 'ПРОСМОТР':U, egais, v-ext-sys, v-fs-rar, bh-act-header:handle) .
      467   END.
      468   ON CHOOSE OF Btn_Edit IN FRAME Dialog-Frame
      469   DO:
      470       if not bh-act-header:available then return no-apply .
      471       find last buf_clob-bind where buf_clob-bind.field-name_ = 'egais-ab_shop':U and buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value .
      472       entry(3, buf_clob-bind.descr, chr(4)) = string(no) no-error .
      473       entry(4, buf_clob-bind.descr, chr(4)) = "" no-error .
      474       entry(6, buf_clob-bind.descr, chr(4)) = "" no-error .
      475       bh-act-header:buffer-field ("is-sent"):buffer-value = string(no) no-error .
      476       bh-act-header:buffer-field ("answer_"):buffer-value = "" no-error .
      477       bh-act-header:buffer-field ("RegID"):buffer-value = "" no-error .
      478       find first ub.esys-all-attr
      479                   where ub.esys-all-attr.table-name = "esys-pck-sent"
      480                   and ub.esys-all-attr.attr-code = "egais"
      481                   and ub.esys-all-attr.key2       = 4
      482                   and ub.esys-all-attr.attr-value = buf_clob-bind.uniq-key-rec
      483                   no-error.
      484       if available (ub.esys-all-attr )
      485       then do:
      486         delete ub.esys-all-attr .
      487       end.
      488       run refresh-query .
      489   END.
      490   ON CHOOSE OF Btn_create IN FRAME Dialog-Frame
      491   DO:
      492       run bge/egais-act-balance_shop.w (parparentproc, 'ДОБАВЛЕНИЕ':U, egais, v-ext-sys, v-fs-rar, bh-act-header:handle) .
      493       bh-act-header = egais:GetHndlTable(3, "").
      494       run refresh-query.
      495   END.
      496   ON CHOOSE OF Btn_chg IN FRAME Dialog-Frame
      497   DO:
      498       if not bh-act-header:available then return no-apply .
      499       v-act-num = bh-act-header:buffer-field ("num"):buffer-value .
      500       run bge/egais-act-balance_shop.w (parparentproc, 'ИЗМЕНЕНИЕ':U, egais, v-ext-sys, v-fs-rar, bh-act-header:handle) .
      501       bh-act-header = egais:GetHndlTable(3, "").
      502           run refresh-query.
      503   END.
      504   ON CHOOSE OF Btn_del IN FRAME Dialog-Frame
      505   DO:
      506       if not bh-act-header:available then return no-apply .
      507       find last buf_clob-bind where buf_clob-bind.field-name_ = 'egais-ab_shop':U and buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value .
      508       delete buf_clob-bind .
      509       bh-act-header:buffer-delete () .
      510       run refresh-query.
      511   END.
      512   ON CHOOSE OF Btn_send IN FRAME Dialog-Frame
      513   DO:
      514       if not bh-act-header:available then return no-apply .
      515       find last buf_clob-bind where buf_clob-bind.field-name_ = 'egais-ab_shop':U and buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value .
      516       find first buf_clob-data no-lock where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
      517       os-delete "ActChargeOnShop_v2.xml".
      518       copy-lob
      519       from  object buf_clob-data.cdata
      520       to  file 'ActChargeOnShop_v2.xml'
      521       no-convert
      522       no-error .
      523       egais:inNum = bh-act-header:buffer-field ("num"):buffer-value .
      524       egais:SendRequestUTM() .
      525       glog = egais:IsSent .
      526       glog = egais:StatusErr .
      527       if glog then do :
      528           message egais:Msg view-as alert-box.
      529           return no-apply.
      530       end.
      531       else do :
      532           entry (3, buf_clob-bind.descr, chr(4)) = "yes".
      533           bh-act-header:buffer-field ("is-sent"):buffer-value = true.
      534       end.
      535       run refresh-query.
      536       message "Акт " egais:inNum " отправлен" view-as alert-box .
      537   END.
      538   ON CHOOSE OF Btn_Ans IN FRAME Dialog-Frame
      539   DO:
      540     if not bh-act-header:available
      541       then return no-apply.
      542       v-act-num = bh-act-header:buffer-field ("num"):buffer-value .
      543         egais:inNum = bh-act-header:buffer-field ("num"):buffer-value .
      544         egais:GetHndlTable(2, bh-act-header:buffer-field ("num"):buffer-value) .
      545         glog = egais:StatusErr .
      546         if glog
      547         and (bh-act-header:buffer-field ("answer_"):buffer-value = ""
      548           or bh-act-header:buffer-field ("answer_"):buffer-value = ? )
      549         then do :
      550               message egais:Msg view-as alert-box.
      551               return no-apply.
      552         end.
      553         else message (bh-act-header:buffer-field ("answer_"):buffer-value) view-as alert-box information .
      554     run refresh-query.
      555   END.
      556   ON value-changed OF RADIO-SET-1 IN FRAME Dialog-Frame
      557   do:
      558     assign RADIO-SET-1 .
      559     if RADIO-SET-1 = 1
      560     then do :
      561       ENABLE Btn_create Btn_chg Btn_del Btn_send
      562         WITH FRAME Dialog-Frame.
      563       HIDE Btn_Ans Btn_lkp Btn_Edit in FRAME Dialog-Frame.
      564     end.
      565     else do :
      566       ENABLE Btn_Ans Btn_lkp Btn_Edit
      567         WITH FRAME Dialog-Frame.
      568       HIDE Btn_create Btn_chg Btn_del Btn_send in FRAME Dialog-Frame.
      569     end.
      570     run refresh-query.
      571   end.
      572   ON leave OF f-date IN FRAME Dialog-Frame
      573   do:
      574     run refresh-query.
      575   end.
      576   ON return OF f-date IN FRAME Dialog-Frame
      577   do:
      578     run refresh-query.
      579   end.
      580   ON leave OF f-date-2 IN FRAME Dialog-Frame
      581   do:
      582     run refresh-query.
      583   end.
      584   ON return OF f-date-2 IN FRAME Dialog-Frame
      585   do:
      586     run refresh-query.
      587   end.
      588   if valid-handle(active-window) and frame Dialog-Frame:PARENT eq ?
      589   then frame Dialog-Frame:PARENT = active-window.
      590   MAIN-BLOCK:
      591   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
      592      on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
      593     def var ii as int no-undo.
      594   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      595   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
      596     (output v-db-num
      597     ,output v-user-id
      598     ) no-error .
      599     empty temp-table thbjattr_thbj-attr .
      600     run adm/shattri.p (
      601          input "get":U
      602         ,input v-cntxt-obj-type
      603         ,input v-cntxt-obj-code
      604         ,input 'egais':U
      605         ,input 'egais-fsrar':U
      606         ,output v-value-character
      607         ,output v-value-date
      608         ,output v-value-decimal
      609         ,output v-value-integer
      610         ,output v-value-logical
      611         ,output v-value-type
      612         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      613         ) no-error .
      614     assign
      615       v-fs-rar = v-value-character
      616     .
      617     run adm/shattri.p (
      618          input "get":U
      619         ,input '':U
      620         ,input 0
      621         ,input 'egais':U
      622         ,input 'egais-exsys':U
      623         ,output v-value-character
      624         ,output v-value-date
      625         ,output v-value-decimal
      626         ,output v-value-integer
      627         ,output v-value-logical
      628         ,output v-value-type
      629         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      630         ) no-error .
      631     assign v-ext-sys = v-value-integer .
      632     egais = new ActBalance_shop (v-cntxt-obj-type, v-cntxt-obj-code, v-fs-rar, v-ext-sys).
      633     egais:DbNum = v-db-num .
      634     egais:User_Id = v-user-id .
      635     bh-act-header = egais:GetHndlTable(3, "").
      636     create query qh-act-header.
      637     f-date = date (now) - 31.
      638     f-date-2 = ?.
      639     run refresh-query.
      640     create browse browse-hdl-act-header
      641       assign
      642         title     = 'Акты постановки на баланс в торговом зале ЕГАИС'
      643         frame     = frame Dialog-Frame:handle
      644         query     = qh-act-header
      645         x         = 10
      646         y         = 60
      647         width     = 104
      648         height    = 22
      649         visible   = true
      650         read-only = true
      651         sensitive = true
      652         separators = true
      653         column-resizable = true
      654         column-scrolling = true
      655         triggers:
      656         end triggers
      657     .
      658     on row-display of browse-hdl-act-header do :
      659         if valid-handle (calc-col-hndl) then do :
      660             if RADIO-SET-1 = 1 then calc-col-hndl:SCREEN-VALUE = "Новый" .
      661             else do :
      662               assign v-RegID = bh-act-header:buffer-field ("RegID"):buffer-value .
      663               if v-RegID = "" or v-RegID = ? or num-entries(v-RegID, CHR(5)) <> 2 then calc-col-hndl:SCREEN-VALUE = "Отправлен" .
      664               if num-entries(v-RegID, CHR(5)) = 2 then do :
      665                   if entry(2, v-RegID, CHR(5)) = "R" then do :
      666                       calc-col-hndl:SCREEN-VALUE = "Отклонен" .
      667                       calc-col-hndl:bgcolor = red_color .
      668                   end.
      669                   if entry(2, v-RegID, CHR(5)) = "A" then do :
      670                       calc-col-hndl:SCREEN-VALUE = "Принят" .
      671                       calc-col-hndl:bgcolor = green_color .
      672                   end.
      673               end.
      674             end.
      675         end.
      676         if valid-handle (calc-col-hndl2) then do :
      677             if RADIO-SET-1 = 1 then calc-col-hndl2:SCREEN-VALUE = " - " .
      678             else do :
      679               assign v-RegID = bh-act-header:buffer-field ("RegID"):buffer-value .
      680               calc-col-hndl2:SCREEN-VALUE = entry(1, v-RegID, CHR(5)) .
      681             end.
      682         end.
      683     end.
      684     ON value-changed OF browse-hdl-act-header
      685     do:
      686         if calc-col-hndl:SCREEN-VALUE = "Отклонен" then enable Btn_Edit with FRAME Dialog-Frame .
      687                                                    else disable Btn_Edit with FRAME Dialog-Frame .
      688     end.
      689     if not bh-act-header = ?
      690     then do:
      691       do ii = 1 to bh-act-header:num-fields - 4:
      692         bcol[ii] = browse-hdl-act-header:add-like-column('tt-act-header' + '.' + bh-act-header:buffer-field (ii):name, 0, 'FILL-IN').
      693       end.
      694           bcol[3] = browse-hdl-act-header:add-like-column('tt-act-header.type_', 0, 'FILL-IN').
      695           calc-col-hndl = browse-hdl-act-header:add-calc-column("char", "X(10)", "", "Статус") .
      696           calc-col-hndl2 = browse-hdl-act-header:add-calc-column("char", "X(20)", "", "RegID") .
      697       browse-hdl-act-header:get-browse-column (1):width-chars = 26.
      698       browse-hdl-act-header:get-browse-column (2):width-chars = 10.
      699       browse-hdl-act-header:get-browse-column (3):width-chars = 34.
      700       browse-hdl-act-header:get-browse-column (4):width-chars = 10.
      701       browse-hdl-act-header:get-browse-column (5):width-chars = 17.
      702     end.
      703     run enable_UI.
      704     RADIO-SET-1 = 2 .
      705     apply "value-changed" to RADIO-SET-1 in frame Dialog-Frame.
      706     wait-for go of frame Dialog-Frame.
      707   end.
      708   run disable_UI.
      709   PROCEDURE disable_UI :
      710     HIDE FRAME Dialog-Frame.
      711   END PROCEDURE.
      712   PROCEDURE enable_UI :
      713     DISPLAY RADIO-SET-1 f-date f-date-2
      714         WITH FRAME Dialog-Frame.
      715     ENABLE Btn_OK RADIO-SET-1 f-date f-date-2
      716         WITH FRAME Dialog-Frame.
      717     VIEW FRAME Dialog-Frame.
      718   END PROCEDURE.
      719   PROCEDURE refresh-query :
      720   def var v-proposition  as char no-undo.
      721   if bh-act-header = ?
      722     then return .
      723     assign input frame Dialog-Frame
      724       f-date
      725       f-date-2
      726     .
      727     v-proposition =
      728       (if f-date <> ? then " and tt-act-header.date_ >= " + string (f-date) else "") +
      729       (if f-date-2 <> ? then " and tt-act-header.date_ <= " + string (f-date-2) else "")
      730       .
      731   case RADIO-SET-1 :
      732       when 1  then
      733       do:
      734         qh-act-header:query-close.
      735         qh-act-header:set-buffers (bh-act-header).
      736         qh-act-header:query-prepare ( substitute ("for each tt-act-header where not tt-act-header.is-sent &1 by tt-act-header.date_ descending", v-proposition) ).
      737         qh-act-header:query-open.
      738         bh-act-header:find-first ( "where tt-act-header.num = " + "'" + v-act-num + "'" + v-proposition) no-error .
      739       end.
      740       when 2  then
      741       do:
      742         qh-act-header:query-close.
      743         qh-act-header:set-buffers (bh-act-header).
      744         qh-act-header:query-prepare ( substitute ("for each tt-act-header where tt-act-header.is-sent &1 by tt-act-header.date_ descending", v-proposition) ).
      745         qh-act-header:query-open.
      746         bh-act-header:find-first ( "where tt-act-header.num = " + "'" + v-act-num + "'" + v-proposition ) no-error .
      747       end.
      748     end.
      749   if bh-act-header:available
      750     then qh-act-header:reposition-to-rowid ( bh-act-header:rowid ) no-error.
      751   if valid-handle (browse-hdl-act-header) then apply "value-changed" to browse-hdl-act-header.
      752   end.
      753   PROCEDURE proc-row-leave :
      754     if false then do:
      755       do ii = 1 to extent (bcol).
      756         bcol[ii]:bgcolor = RED_COLOR.
      757       end.
      758     end.
      759   end.
