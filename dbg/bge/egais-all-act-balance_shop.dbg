      371   define temp-table tt-act-header
      372       field num           as character        label "№ акта"      format "X(30)"
      373       field date_         as date             label "Дата акта"
      374       field is-sent       as logical
      375       field answer_       as character        label "Ответ"       format "X(1500)"
      376       field type_         as character        label "Основание"   format "X(35)"
      377       field RegID         as character        label "Рег. номер"  format "X(50)"
      378       index pi as primary unique
      379           num
      380   .
      381   define temp-table tt-gds-act
      382       field num           as character                label "№ акта"
      383       field position_     as integer                  label "№ пп"                    format ">>>9"
      384       field gds-code      like ub.goods.gds-code      label "Код товара   "
      385       field part-code     like ub.parts.part-code     label "Партия"
      386       field doc-code      as character                label "№ накладной TH"
      387       field doc-date      like ub.trn-doc.fact-date   label "Дата TH"
      388       field alc-code      as character                label "Алкогольный код"         format "X(21)"
      389       field gds-name      like ub.goods.gds-name      label "Наименование товара"     format "X(35)"
      390       field qnty          as decimal                  label "Количество"
      391       field egais-name    as character
      392       index pi as primary unique
      393           position_
      394       index code
      395           gds-code doc-code
      396   .
