      585   procedure xmlchar-decode :
      586   define input parameter p-in-string      as character        no-undo.
      587   define output parameter p-out-string    as character        no-undo.
      588       define variable v-position      as integer      no-undo.
      589       define variable v-last-position as integer      no-undo.
      590       define variable v-temp-integer  as integer      no-undo.
      591       define variable v-current-char  as character    no-undo.
      592       define variable v-next-char     as character    no-undo.
      593       define variable v-success       as logical      no-undo.
      594   do
      595   on error undo, return error
      596   :
      597       assign
      598           p-out-string = "":U
      599           v-position   = 0
      600       .
      601       replace-cycle:
      602       do while yes
      603       on error undo, return error
      604       :
      605           assign
      606               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      607           .
      608           if v-last-position <= v-position
      609           then do:
      610               if v-position = 0
      611               then do:
      612                   assign
      613                       p-out-string = p-in-string
      614                   .
      615               end.
      616               else do:
      617                   assign
      618                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      619                   .
      620               end.
      621               leave replace-cycle.
      622           end.
      623           else do:
      624               assign
      625                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      626                   v-position      = v-last-position
      627                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      628               .
      629               if v-current-char = "#":U
      630               then do:
      631                   assign
      632                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      633                   .
      634                   if v-last-position > 0
      635                   then do:
      636                       run xmlchar-read-integer in this-procedure
      637                        (
      638                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      639                           , output v-temp-integer
      640                           , output v-success
      641                       ).
      642                       if v-success = yes
      643                       and v-temp-integer >= 1
      644                       and v-temp-integer <= 255
      645                       then do:
      646                           assign
      647                               p-out-string = p-out-string + chr( v-temp-integer )
      648                               v-position   = v-last-position + 1
      649                           .
      650                       end.
      651                       else do:
      652                           assign
      653                               p-out-string = p-out-string + "&":U
      654                               v-position   = v-position   + 1
      655                           .
      656                       end.
      657                   end.
      658                   else do:
      659                       assign
      660                           p-out-string = p-out-string + "&":U
      661                           v-position   = v-position   + 1
      662                       .
      663                   end.
      664               end.
      665               else do:
      666                   case substring( p-in-string, v-position + 1, 3 )
      667                   :
      668                       when "lt;":U
      669                       then do:
      670                           assign
      671                               p-out-string = p-out-string + "<":U
      672                               v-position   = v-position   + 3
      673                           .
      674                       end.
      675                       when "gt;":U
      676                       then do:
      677                           assign
      678                               p-out-string = p-out-string + ">":U
      679                               v-position   = v-position   + 3
      680                           .
      681                       end.
      682                       otherwise do:
      683                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      684                           then do:
      685                               assign
      686                                   p-out-string = p-out-string + "&":U
      687                                   v-position   = v-position   + 4
      688                               .
      689                           end.
      690                           else do:
      691                               case substring( p-in-string, v-position + 1, 5 )
      692                               :
      693                                   when "quot;":U
      694                                   then do:
      695                                       assign
      696                                           p-out-string = p-out-string + '"':U
      697                                           v-position   = v-position   + 5
      698                                       .
      699                                   end.
      700                                   when "apos;":U
      701                                   then do:
      702                                       assign
      703                                           p-out-string = p-out-string + "'":U
      704                                           v-position   = v-position   + 5
      705                                       .
      706                                   end.
      707                                   otherwise do:
      708                                       assign
      709                                           p-out-string = p-out-string + "&":U
      710                                       .
      711                                   end.
      712                               end case.
      713                           end.
      714                       end.
      715                   end case.
      716               end.
      717           end.
      718       end.
      719   end.
      720   end .
      721   procedure xmlchar-read-integer :
      722   define input parameter p-input-string      as character        no-undo.
      723   define output parameter p-output-integer   as integer          no-undo.
      724   define output parameter p-success       as logical          no-undo.
      725   do
      726   on error undo, return error
      727   :
      728       assign
      729           p-output-integer = integer( p-input-string )
      730       no-error.
      731       if error-status :error
      732       then do:
      733           assign
      734               p-success           = no
      735               p-output-integer    = 0
      736           .
      737       end.
      738       else do:
      739           assign
      740               p-success           = yes
      741           .
      742       end.
      743   end.
      744   end.
      745   define variable v-bgelib-bgeclall           as logical      no-undo.
      746   define variable v-bgelib-bgedict            as logical      no-undo.
      747   define temp-table temp_ext-doc-type no-undo
      748       field edt-key               as integer
      749       field ext-doc-type          as character
      750       field ext-doc-type-label    as character
      751       index pi is primary unique
      752           edt-key
      753   .
      754   define temp-table temp_bgelib_goods no-undo
      755       field gds-code as integer
      756       index pi is primary unique
      757           gds-code
      758   .
      759   define temp-table temp_bgelib_clients no-undo
      760       field obj-type as character
      761       field obj-code as integer
      762       index pi is primary unique
      763           obj-type
      764           obj-code
      765   .
      766   define temp-table temp_bgelib_dis-card no-undo
      767       field d-card as character
      768       index pi is primary unique
      769           d-card
      770   .
      771   define temp-table temp_bgelib_trn-doc no-undo
      772       field doc-code as integer
      773   .
      774   procedure bgelib-tag-open:
      775   do
      776   on error undo, return error
      777   :
      778   define input parameter v-tag-level  as integer      no-undo.
      779   define input parameter v-tag-name   as character    no-undo.
      780   define input parameter v-tag-value  as character    no-undo.
      781       put stream stmXMLOut unformatted
      782           chr(10)
      783           + fill(" ", 4 * v-tag-level)
      784           + "<" + v-tag-name
      785           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      786           + v-tag-value + ">"
      787       .
      788   end.
      789   end procedure.
      790   procedure bgelib-tag-put:
      791   do
      792   on error undo, return error
      793   :
      794   define input parameter v-tag-level      as integer      no-undo.
      795   define input parameter v-tag-name       as character    no-undo.
      796   define input parameter v-tag-value      as character    no-undo.
      797   define input parameter v-empty-mode     as integer      no-undo.
      798       v-tag-name = trim(v-tag-name).
      799       if  v-empty-mode = 1
      800       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      801       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      802       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      803       then do:
      804           run xmlchar-encode in this-procedure (
      805                 input v-tag-value
      806               , output v-tag-value
      807           ).
      808           put stream stmXMLOut unformatted
      809               chr(10) + fill(" ", 4 * v-tag-level)
      810                           + '<' + v-tag-name + '>'
      811                           + v-tag-value
      812                           + '</' + v-tag-name + '>'
      813           .
      814       end.
      815   end.
      816   end procedure.
      817   procedure bgelib-tag-close:
      818   do
      819   on error undo, return error
      820   :
      821   define input parameter v-tag-level as integer      no-undo.
      822   define input parameter v-tag-name  as character    no-undo.
      823       put stream stmXMLOut unformatted
      824           chr(10)
      825           + fill( " ", 4 * v-tag-level)
      826           + '</' + v-tag-name + '>'
      827       .
      828   end.
      829   end procedure.
      830   procedure bgelib-write-log:
      831   do
      832   on error undo, return error
      833   :
      834   define input parameter v-filename   as character    no-undo.
      835   define input parameter v-log-level  as integer      no-undo.
      836   define input parameter v-out-string as character    no-undo.
      837       output stream stmXMLLog to value( v-filename ) append.
      838       put stream stmXMLLog unformatted
      839           chr(10)
      840       .
      841       put stream stmXMLLog unformatted
      842           ( if v-log-level = 0
      843             or v-out-string = "&DLine"
      844             or v-out-string = "&Line"
      845             then ""
      846             else cur-time-string-sec() + " " )
      847       .
      848       put stream stmXMLLog unformatted
      849           ( if v-out-string = "&Line"
      850             then fill( "-", 80 )
      851             else if v-out-string = "&DLine"
      852                  then fill( "=", 80 )
      853                  else v-out-string )
      854       .
      855       output stream stmXMLLog close.
      856   end.
      857   end procedure.
      858   procedure bgelib-write-edt:
      859   do
      860   on error undo, return error
      861   :
      862   define input parameter v-editor-handle    as handle       no-undo.
      863   define input parameter v-log-level        as integer      no-undo.
      864   define input parameter v-out-string       as character    no-undo.
      865       if valid-handle ( v-editor-handle )
      866       then do:
      867           v-editor-handle :move-to-eof().
      868           v-editor-handle :insert-string( ( if v-log-level = 0
      869                                             or v-out-string = "&DLine"
      870                                             or v-out-string = "&Line"
      871                                             then ""
      872                                             else cur-time-string-sec() + " "
      873                                         ) ).
      874           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      875                                             then fill( "-", 80 )
      876                                             else if v-out-string = "&DLine" then fill("=", 80)
      877                                             else fill( " ", v-log-level) + v-out-string
      878                                         ) ).
      879           v-editor-handle :insert-string( chr(10) ).
      880       end.
      881       process events.
      882       output to 'bgescn.txt' append.
      883           put unformatted
      884               chr(10)
      885               string( ( if v-log-level = 0
      886                         or v-out-string = "&DLine"
      887                         or v-out-string = "&Line"
      888                         then ""
      889                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      890                     ) )
      891               string( ( if v-out-string = "&Line"
      892                         then fill( "-", 80 )
      893                         else if v-out-string = "&DLine"
      894                              then fill( "=", 80 )
      895                              else fill( " ", v-log-level ) + v-out-string
      896                     ) )
      897           .
      898       output close.
      899   end.
      900   end procedure.
      901   procedure bgelib-show-cnt:
      902   do
      903   on error undo, return error
      904   :
      905   define input parameter v-fillin-handle     as handle   no-undo.
      906       if valid-handle( v-fillin-handle )
      907       then do:
      908           assign
      909               v-fillin-handle :visible = true
      910           .
      911       end.
      912   end.
      913   end procedure.
      914   procedure bgelib-hide-cnt:
      915   do
      916   on error undo, return error
      917   :
      918   define input parameter v-fillin-handle     as handle   no-undo.
      919       if valid-handle( v-fillin-handle )
      920       then do:
      921           assign v-fillin-handle :visible = false.
      922       end.
      923   end.
      924   end procedure.
      925   procedure bgelib-write-cnt:
      926   do
      927   on error undo, return error
      928   :
      929   define input parameter v-fillin-handle    as handle       no-undo.
      930   define input parameter v-fillin-string    as character    no-undo.
      931       if valid-handle( v-fillin-handle )
      932       then do:
      933           assign
      934               v-fillin-handle :SCREEN-value = v-fillin-string
      935           .
      936       end.
      937   end.
      938   end procedure.
      939   procedure bgelib-write-header:
      940   do
      941   on error undo, return error
      942   :
      943   define input parameter p-first-file     as logical      no-undo.
      944   define input parameter p-xml-file-name  as character    no-undo.
      945   define input parameter p-list-file-name as character    no-undo.
      946   define input parameter p-file-number    as integer      no-undo.
      947   define input parameter p-have-prev      as logical      no-undo.
      948   define input parameter p-prev-filename  as character    no-undo.
      949   define input parameter p-obj-list       as character    no-undo.
      950   define input parameter p-doc-type-list  as character    no-undo.
      951   define input parameter p-parameter-list as character    no-undo.
      952       define variable v-counter    as integer        no-undo.
      953       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      954       put stream stmXMLOut unformatted
      955           "<?xml version='1.0' encoding='windows-1251'?>"
      956       .
      957       run bgelib-tag-open( input 0, input "root"  , input "" ).
      958       run bgelib-tag-open( input 0, input "header", input "" ).
      959       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      960       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      961       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      962       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      963       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      964       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      965       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      966       :
      967           run bgelib-tag-put(
      968                 input 1
      969               , input entry( 2 * v-counter, p-parameter-list )
      970               , input entry( 2 * v-counter + 1, p-parameter-list )
      971               , input 0
      972           ).
      973       end.
      974       run bgelib-tag-close( input 0, input "header" ).
      975       output stream stmXMLOut close.
      976       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      977       if p-first-file = yes
      978       then do:
      979           put stream stmXMLOut unformatted
      980               "<?xml version='1.0' encoding='windows-1251'?>"
      981           .
      982           run bgelib-tag-open( input 0, input "export", input "" ).
      983       end.
      984       run bgelib-tag-open( input 1, input "file", input "" ).
      985       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      986       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      987       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      988       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
      989       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
      990       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      991       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      992       :
      993           run bgelib-tag-put(
      994                 input 2
      995               , input trim(entry( 2 * v-counter, p-parameter-list ))
      996               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
      997               , input 0
      998           ).
      999       end.
     1000       run bgelib-tag-close( input 1, input "file" ).
     1001       output stream stmXMLOut close.
     1002   end.
     1003   end procedure.
     1004   procedure bgelib-write-footer:
     1005   do
     1006   on error undo, return error
     1007   :
     1008   define input parameter p-last-file      as logical      no-undo.
     1009   define input parameter p-xml-file-name  as character    no-undo.
     1010   define input parameter p-list-file-name as character    no-undo.
     1011   define input parameter p-have-next      as logical      no-undo.
     1012   define input parameter p-next-file-name as character    no-undo.
     1013       define variable v-error-num     as integer           no-undo.
     1014       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1015       if p-have-next = yes
     1016       then do:
     1017           run bgelib-tag-open( input 0, input "footer", "" ).
     1018           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1019           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1020           run bgelib-tag-close( input 0, input "footer" ).
     1021       end.
     1022       run bgelib-tag-close( input 0, input "root" ).
     1023       output stream stmXMLOut close.
     1024       run bge/os_copy.p (
     1025             input "M"
     1026           , input p-xml-file-name + "tmp"
     1027           , input p-xml-file-name + "xml"
     1028           , output v-error-num
     1029       ).
     1030       if p-last-file = yes
     1031       then do:
     1032           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1033               run bgelib-tag-close( input 0, input "export" ).
     1034           output stream stmXMLOut close.
     1035           run bge/os_copy.p (
     1036                 input "M"
     1037               , input p-list-file-name + "tmp"
     1038               , input p-list-file-name + "xml"
     1039               , output v-error-num
     1040           ).
     1041       end.
     1042   end.
     1043   end procedure.
     1044   procedure bgelib-filename :
     1045   do
     1046   on error undo, return error
     1047   :
     1048   define input parameter p-prefix             as character    no-undo.
     1049   define output parameter p-xml-file-name     as character    no-undo.
     1050   define output parameter p-log-file-name     as character    no-undo.
     1051   define output parameter p-list-file-name    as character    no-undo.
     1052       define variable v-home-dir  as character    no-undo.
     1053       define variable v-error-num as integer      no-undo.
     1054       get-key-value section "BGE" key "outdir" value v-home-dir.
     1055       if v-home-dir = ?
     1056       then do:
     1057           message
     1058             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1059             skip(1)
     1060             skip "Обратитесь к администратору."
     1061           view-as alert-box error.
     1062           undo, return error .
     1063       end.
     1064       run gbl/dir-cre.p (
     1065           input v-home-dir
     1066       ) no-error.
     1067       if error-status :error
     1068       then do:
     1069           message
     1070             skip "Неверно задан каталог экспорта."
     1071             skip(1)
     1072             skip "Обратитесь к администратору."
     1073           view-as alert-box error.
     1074           undo, return error .
     1075       end.
     1076       run bge/genfname.p (
     1077             input v-home-dir
     1078           , input p-prefix
     1079           , input ""
     1080           , input "xml"
     1081           , input "tmp"
     1082           , output p-xml-file-name
     1083       ).
     1084       assign
     1085           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1086           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1087           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1088       .
     1089   end.
     1090   end procedure.
     1091   procedure bgelib-read-config :
     1092   do
     1093   on error undo, return error
     1094   :
     1095   define variable v-par-type as character     no-undo.
     1096     define variable v-param-type      as character  no-undo .
     1097     define variable v-value-character as character  no-undo .
     1098     define variable v-value-date      as date       no-undo .
     1099     define variable v-value-decimal   as decimal    no-undo .
     1100     define variable v-value-integer   as integer    no-undo .
     1101     define variable v-value-logical   as logical    no-undo .
     1102     define variable v-tth             as handle     no-undo .
     1103       assign
     1104           v-bgelib-bgeclall = no
     1105           v-bgelib-bgedict  = no
     1106       .
     1107       run adm/shattri.p ( input "get":U
     1108                         , input  '':u
     1109                         , input  0
     1110                         , input  'bge-export':U
     1111                         , input  'bgeclall':U
     1112                         , output v-value-character
     1113                         , output v-value-date
     1114                         , output v-value-decimal
     1115                         , output v-value-integer
     1116                         , output v-value-logical
     1117                         , output v-param-type
     1118                         , input-output table-handle v-tth
     1119                         ) no-error .
     1120       if error-status :error
     1121       then do:
     1122         assign
     1123           v-bgelib-bgeclall = no
     1124         .
     1125       end.
     1126       else do:
     1127         assign
     1128           v-bgelib-bgeclall = v-value-logical
     1129         .
     1130       end.
     1131       delete object v-tth.
     1132       run adm/shattri.p ( input "get":U
     1133                         , input  '':u
     1134                         , input  0
     1135                         , input  'bge-export':U
     1136                         , input  'bgedict':U
     1137                         , output v-value-character
     1138                         , output v-value-date
     1139                         , output v-value-decimal
     1140                         , output v-value-integer
     1141                         , output v-value-logical
     1142                         , output v-param-type
     1143                         , input-output table-handle v-tth
     1144                         ) no-error .
     1145       if error-status :error
     1146       then do:
     1147         assign
     1148           v-bgelib-bgedict = no
     1149         .
     1150       end.
     1151       else do:
     1152         assign
     1153           v-bgelib-bgedict = v-value-logical
     1154         .
     1155       end.
     1156       delete object v-tth.
     1157       run adm/shattri.p ( input "get":U
     1158                         , input  '':u
     1159                         , input  0
     1160                         , input  'bge-export':U
     1161                         , input  'bgefmt':U
     1162                         , output v-value-character
     1163                         , output v-value-date
     1164                         , output v-value-decimal
     1165                         , output v-value-integer
     1166                         , output v-value-logical
     1167                         , output v-param-type
     1168                         , input-output table-handle v-tth
     1169                         ) no-error .
     1170       if error-status :error
     1171       then do:
     1172         assign
     1173           v-bgelib-bgefmt  = "xml":U
     1174         .
     1175       end.
     1176       else do:
     1177         assign
     1178           v-bgelib-bgefmt  = v-value-character
     1179         .
     1180       end.
     1181       delete object v-tth.
     1182       run adm/shattri.p ( input "get":U
     1183                         , input  '':u
     1184                         , input  0
     1185                         , input  'bge-export':U
     1186                         , input  'bgeflold':U
     1187                         , output v-value-character
     1188                         , output v-value-date
     1189                         , output v-value-decimal
     1190                         , output v-value-integer
     1191                         , output v-value-logical
     1192                         , output v-param-type
     1193                         , input-output table-handle v-tth
     1194                         ) no-error .
     1195       if error-status :error
     1196       then do:
     1197         assign
     1198           v-bgelib-bgeflold  = "old":U
     1199         .
     1200       end.
     1201       else do:
     1202         assign
     1203           v-bgelib-bgeflold  = v-value-character
     1204         .
     1205       end.
     1206       delete object v-tth.
     1207   end.
     1208   end procedure.
     1209   procedure bgelib-check-file-size :
     1210   do
     1211   on error undo, return error
     1212   :
     1213   define input parameter p-out-filename   as character    no-undo.
     1214   define output parameter p-is-big        as logical      no-undo.
     1215       define variable v-current-position    as integer        no-undo.
     1216       assign
     1217           v-current-position = seek( stmXMLOut )
     1218       .
     1219       if v-current-position / 1024 / 1024  >= 100
     1220       then do:
     1221           assign
     1222               p-is-big = yes
     1223           .
     1224       end.
     1225   end.
     1226   end procedure.
     1227   procedure bgelib-init-ext-doc-type :
     1228       define variable v-counter    as integer      no-undo.
     1229       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1230   do
     1231   for buf_temp_ext-doc-type
     1232   on error undo, return error
     1233   :
     1234       empty temp-table buf_temp_ext-doc-type.
     1235       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1236       :
     1237           create buf_temp_ext-doc-type.
     1238           assign
     1239               buf_temp_ext-doc-type.edt-key               = v-counter
     1240               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1241               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1242           .
     1243       end.
     1244   end.
     1245   end procedure.
     1246       define buffer buf_c-trn-doc       for ub.c-trn-doc.
     1247   do
     1248   for buf_c-trn-doc
     1249   on error undo, return error
     1250   :
     1251       output stream stmxmlout to value( soutfile + "tmp"  ) convert target "1251" append.
     1252       run bgelib-write-cnt( hCNT, "" ).
     1253       run bgelib-write-edt( hEDT, 4, "Операция: Выгрузка удаленных документов." ).
     1254       run bgelib-write-log( sLogFile, 0, "&Line" ).
     1255       run bgelib-write-log( sLogFile, 1, "XML - Вывод операции: Выгрузка удаленных документов." ).
     1256       for each buf_c-trn-doc no-lock
     1257          where buf_c-trn-doc.obj-type   = p-obj-type
     1258            and buf_c-trn-doc.obj-code   = p-obj-code
     1259            and buf_c-trn-doc.is-del     = yes
     1260       :
     1261           if  buf_c-trn-doc.corr-date >= p-date-from
     1262           and buf_c-trn-doc.corr-date <= p-date-to
     1263           then do:
     1264               run bgelib-write-cnt( hCNT, string( buf_c-trn-doc.corr-date, "99/99/9999" ) + "  " + buf_c-trn-doc.doc-code ).
     1265               run export-c-trn-doc in this-procedure (
     1266                     input buf_c-trn-doc.doc-code
     1267                   , input buf_c-trn-doc.corr-user-db-num
     1268                   , input buf_c-trn-doc.chip-num
     1269               ) no-error.
     1270               if error-status :error
     1271               then do:
     1272                   undo, return error vss-description + "Ошибка вывода документа " + buf_c-trn-doc.doc-code.
     1273               end.
     1274           end.
     1275       end.
     1276       output stream stmxmlout close.
     1277   end.
     1278   procedure export-c-trn-doc :
     1279   define input parameter p-doc-code           as character    no-undo.
     1280   define input parameter p-corr-user-db-num   as integer          no-undo.
     1281   define input parameter p-chip-num           as integer          no-undo.
     1282       define buffer buf_c-trn-doc   for ub.c-trn-doc.
     1283       define variable v-firm-code as character no-undo .
     1284   do
     1285   for buf_c-trn-doc
     1286   on error undo, return error
     1287   :
     1288       find first buf_c-trn-doc no-lock
     1289            where buf_c-trn-doc.doc-code           = p-doc-code
     1290              and buf_c-trn-doc.corr-user-db-num   = p-corr-user-db-num
     1291              and buf_c-trn-doc.chip-num           = p-chip-num
     1292       .
     1293       assign
     1294         v-firm-code = buf_c-trn-doc.cli-type + string( buf_c-trn-doc.cli-code )
     1295       .
     1296       run bgelib-tag-open( input 0, input "doc", input "" ).
     1297       run bgelib-tag-put( input 1, input "docID"        , input buf_c-trn-doc.doc-code                                   , input 0 ).
     1298       run bgelib-tag-put( input 1, input "isDel"        , input "yes"                                                    , input 0 ).
     1299       run bgelib-tag-put( input 1, input "flagDel"      , input buf_c-trn-doc.is-del                                     , input 0 ).
     1300       run bgelib-tag-put( input 1, input "codeOperation", input string( buf_c-trn-doc.ext-doc-type                      ), input 0 ).
     1301       run bgelib-tag-put( input 1, input "host"         , input string( buf_c-trn-doc.host-code                         ), input 0 ).
     1302       run bgelib-tag-put( input 1, input "store"        , input buf_c-trn-doc.obj-type + string( buf_c-trn-doc.obj-code ), input 0 ).
     1303       run bgelib-tag-put( input 1, input "dateDel"      , input string( buf_c-trn-doc.corr-date ,"99.99.9999"           ), input 0 ).
     1304       run bgelib-tag-put( input 1, input "dateDoc"      , input string( buf_c-trn-doc.doc-date  ,"99.99.9999"           ), input 0 ).
     1305       run bgelib-tag-put( input 1, input "dateFact"     , input string( buf_c-trn-doc.fact-date ,"99.99.9999"           ), input 0 ).
     1306       if buf_c-trn-doc.ext-doc-type <> 'ot':U
     1307       then do:
     1308         run bgelib-tag-put( input 3, input "firm"         , input v-firm-code                                              , input 0 ).
     1309       end.
     1310       run bgelib-tag-put( input 3, input "sysDate"      , input string( buf_c-trn-doc.sys-date ,"99.99.9999"            ), input 0 ).
     1311       run bgelib-tag-put( input 3, input "sysTime"      , input string( buf_c-trn-doc.sys-time                          ), input 0 ).
     1312       run bgelib-tag-put( input 1, input "reasonCode"   , input string( buf_c-trn-doc.reason-code                       ), input 2 ).
     1313       run bgelib-tag-put( input 1, input "comment"      , input buf_c-trn-doc.PS                                         , input 0).
     1314       run bgelib-tag-close( input 0, input "doc" ).
     1315   end.
     1316   end procedure.
