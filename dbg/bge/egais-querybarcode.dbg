     1577   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1578   define new global shared variable g#trdcalib as handle no-undo.
     1579   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1580   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1581   define variable v-waitfram-action01         as character   no-undo .
     1582   define variable v-waitfram-action02         as character   no-undo .
     1583   define variable v-waitfram-action03         as character   no-undo .
     1584   define variable mWaitFramTextBeg            as character   no-undo.
     1585   define variable mWaitFramTextEnd            as character   no-undo.
     1586   define variable mWaitFramView               as logical     no-undo.
     1587   define variable mWaitProcEvent              as logical     no-undo init yes.
     1588   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1589   define variable mWaitFramStop               as logical     no-undo.
     1590   define variable mWaitFramStopUser           as logical     no-undo.
     1591   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1592   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1593   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1594   define button B-WaitFramStop auto-end-key
     1595        label "Стоп"
     1596        size 10 by 1 tooltip "Остоновить процесс".
     1597   define button B-viewProcInfo
     1598        label "Информация"
     1599        size 15 by 1 tooltip "Информация о процесс".
     1600   define frame waitfram
     1601     v-waitfram-action01 format "x(72)" no-label skip
     1602     v-waitfram-action02 format "x(72)" no-label skip
     1603     v-waitfram-action03 format "x(72)" no-label skip
     1604     B-viewProcInfo
     1605     B-WaitFramStop at row 4 col 30
     1606     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1607     .
     1608   define new global shared variable mBatchMode as logical no-undo init ?.
     1609   define variable mFramBachModHandle as handle no-undo.
     1610   mFramBachModHandle = frame waitfram:handle.
     1611   define variable mFameOldVis as logical no-undo.
     1612   define variable mVisCUrentVin as logical no-undo.
     1613   if session:batch-mode
     1614   then
     1615      mBatchMode = yes.
     1616   if mBatchMode = ? then do:
     1617     mVisCUrentVin = current-window:visible.
     1618     mFameOldVis = mFramBachModHandle:visible.
     1619     mFramBachModHandle:visible  = yes.
     1620     mBatchMode = mFramBachModHandle:visible ne yes.
     1621     mFramBachModHandle:visible = mFameOldVis.
     1622     current-window:visible = mVisCUrentVin.
     1623   end.
     1624    if  log-manager:logfile-name ne ?
     1625     then DO:
     1626         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1627         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1628         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1629     end.
     1630   on choose of B-WaitFramStop in frame waitfram
     1631   do:
     1632     mWaitFramStop = yes.
     1633     mWaitFramStopUser = yes.
     1634   end.
     1635   function waitfram-check-timeout returns logical():
     1636      define variable vtime as int64 no-undo.
     1637      if mWaitFramStopTimeOut
     1638      then
     1639         return yes.
     1640      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1641      if     mWaitFramTimeOut ne ?
     1642         and mWaitFramTimeOut ne 0
     1643         and mWaitFramTimeOut lt vtime
     1644      then do:
     1645         mWaitFramStopTimeOut = yes.
     1646      end.
     1647      return mWaitFramStopTimeOut.
     1648   end.
     1649   procedure waitfram-hide :
     1650     if not session:batch-mode
     1651     then do
     1652     on error undo, return error return-value
     1653     :
     1654       pause 0 before-hide .
     1655       if not mBatchMode then
     1656         hide frame waitfram .
     1657     if     not mWaitFramView
     1658        and mWaitProcEvent
     1659     then
     1660       process events .
     1661     end.
     1662   end procedure.
     1663   procedure waitfram-show :
     1664     define input  parameter p-message as character no-undo .
     1665     define variable v-left-margin as integer   no-undo .
     1666     if not session:batch-mode
     1667     then do
     1668     on error undo, return error return-value
     1669     :
     1670       if length(p-message) <= 70 then do:
     1671         assign
     1672           v-left-margin = integer((70 - length(p-message)) / 2)
     1673         .
     1674         assign
     1675           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1676         .
     1677         assign
     1678           v-waitfram-action01 = " "
     1679           v-waitfram-action02 = " "
     1680                                    + fill(" ", v-left-margin)
     1681                                    + p-message
     1682           v-waitfram-action03 = " "
     1683         .
     1684       end.
     1685       else do:
     1686         define variable vRindex1 as integer no-undo.
     1687         define variable vRindex2 as integer no-undo.
     1688         vRindex1 = r-index(p-message," ",70).
     1689         if vRindex1 = 0
     1690         then
     1691            vRindex1 = 70.
     1692         if length(p-message)  <= vRindex1 + 70 then do:
     1693           assign
     1694             v-waitfram-action01 = " "
     1695             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1696             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1697           .
     1698         end.
     1699         else do:
     1700           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1701           if vRindex2 <= vRindex1
     1702           then
     1703              vRindex2 = vRindex1 + 70.
     1704           assign
     1705             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1706             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1707             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1708           .
     1709         end.
     1710       end.
     1711       B-viewProcInfo:visible   in frame waitfram = no.
     1712       B-viewProcInfo:sensitive in frame waitfram = no.
     1713       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1714       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1715       if  (   mWaitFramView
     1716          or  mWaitProcEvent)
     1717          and not mBatchMode
     1718       then
     1719          display
     1720             v-waitfram-action01 skip
     1721             v-waitfram-action02 skip
     1722             v-waitfram-action03 skip
     1723          with frame waitfram .
     1724       if     mWaitFramView
     1725          then do:
     1726             if     mWaitFramInterval ne ?
     1727                and not mBatchMode
     1728             then
     1729                wait-for go of frame waitfram pause mWaitFramInterval.
     1730          end.
     1731          else
     1732             if     mWaitProcEvent
     1733                and not mBatchMode
     1734             then
     1735                process events .
     1736     end.
     1737   end procedure.
     1738      procedure waitfram-show-this:
     1739         define input  parameter iInterval as int64 no-undo.
     1740         define variable vtime as int64 no-undo.
     1741         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1742         mWaitFramInterval = iInterval.
     1743         run waitfram-show (substitute("&1&2 &3&4" ,
     1744                                       mWaitFramTextBeg ,
     1745                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1746                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1747                                       mWaitFramTextEnd
     1748                                      )
     1749                           ).
     1750      end.
     1751      procedure WaitFramRunPause:
     1752         define input  parameter iInterval as dec no-undo.
     1753         define variable vStart  as datetime-tz no-undo.
     1754         define variable vend    as datetime-tz no-undo.
     1755         define variable vint as int64 no-undo.
     1756         define variable vOk as logical no-undo.
     1757         vStart = now.
     1758         vend   = vStart.
     1759         publish "WaitFramPause" (iInterval,output vOk).
     1760         vend   =  now.
     1761         vint = vend - vStart.
     1762         vint = iInterval - vint / 1000.
     1763         if     not mWaitFramStop
     1764            and (   vint > 0
     1765                 or (    not vOk
     1766                     and iInterval eq ?
     1767                     )
     1768                 )
     1769         then
     1770            run waitfram-show-this (iInterval).
     1771         vend   =  now.
     1772         vint = vend - vStart.
     1773         vint = iInterval - vint / 1000.
     1774         if     not mWaitFramStop
     1775            and vint > 0
     1776         then do:
     1777            run gbl/pause.p (vint * 1000).
     1778         end.
     1779         if iInterval ne ?
     1780         then
     1781            publish "WaitFramStop".
     1782         waitfram-check-timeout().
     1783      end.
     1784      procedure WaitFramWaitFor:
     1785         define input  parameter iInterval as dec no-undo.
     1786         assign
     1787            mWaitFramStartProc   = now
     1788            mWaitFramStopUser    = no
     1789            mWaitFramStopTimeOut = no
     1790         .
     1791         block-wait:
     1792         do while not mWaitFramStop:
     1793            run WaitFramRunPause (iInterval).
     1794            if  waitfram-check-timeout()
     1795            then do:
     1796               leave block-wait.
     1797            end.
     1798         end.
     1799         run waitfram-hide.
     1800      end.
     1801   procedure waitfram-join :
     1802     define input  parameter p-line-1  as character no-undo .
     1803     define input  parameter p-line-2  as character no-undo .
     1804     define input  parameter p-line-3  as character no-undo .
     1805     define output parameter p-message as character no-undo .
     1806     do
     1807     on error undo, return error return-value
     1808     :
     1809       assign
     1810         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1811                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1812                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1813       .
     1814     end.
     1815   end procedure.
     1816   function waitfram-join-function returns character
     1817     (input p-line-1 as character
     1818     ,input p-line-2 as character
     1819     ,input p-line-3 as character
     1820     ).
     1821     define variable v-message as character no-undo .
     1822     run waitfram-join in this-procedure
     1823       (input  p-line-1
     1824       ,input  p-line-2
     1825       ,input  p-line-3
     1826       ,output v-message
     1827       ) .
     1828     return v-message .
     1829   end function .
     1830   define temp-table tt-act-header
     1831       field num           as character        label "№ акта"      format "X(30)"
     1832       field date_         as date             label "Дата акта"
     1833       field is-sent       as logical
     1834       index pi as primary unique
     1835           num
     1836   .
     1837   define temp-table tt-gds-act
     1838       field num           as character                label "№ акта"
     1839       field position_     as integer                  label "№ пп"                    format ">>>9"
     1840       field type_         as character                label "Тип"         format "X(3)"
     1841       field rank          as character                label "Серия"     format "X(3)"
     1842       field number        as character                label "Номер"               format "X(9)"
     1843       field mark          as character                label "Марка"   format "X(100)"
     1844       index pi as primary unique
     1845           position_
     1846   .
     1847   define variable sw as handle no-undo .
     1848   define variable v-file              as character no-undo initial "QueryBarcode1.xml".
     1849   DEFINE VARIABLE hDoc AS HANDLE NO-UNDO.
     1850   DEFINE VARIABLE hRoot AS HANDLE NO-UNDO.
     1851   DEFINE VARIABLE good AS LOGICAL NO-UNDO.
     1852   procedure makeXML :
     1853       create sax-writer sw .
     1854       sw:formatted = true.
     1855       sw:set-output-destination ("file", v-file).
     1856       sw:encoding = "UTF-8".
     1857       sw:start-document () .
     1858       sw:start-element ("ns:Documents") .
     1859       sw:insert-attribute ("Version", "1.0") .
     1860       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
     1861       sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
     1862       sw:insert-attribute ("xmlns:bk", "http://fsrar.ru/WEGAIS/QueryBarcode") .
     1863       sw:insert-attribute ("xmlns:ce", "http://fsrar.ru/WEGAIS/CommonEnum") .
     1864           sw:start-element ("ns:Owner") .
     1865               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
     1866           sw:end-element ("ns:Owner") .
     1867           sw:start-element ("ns:Document") .
     1868               sw:start-element ("ns:QueryBarcode") .
     1869                   sw:write-data-element ("bk:QueryNumber", tt-act-header.num) no-error .
     1870                   sw:write-data-element ("bk:Date", string(iso-date(tt-act-header.date_)) + "T12:00:00") no-error .
     1871                   sw:start-element ("bk:Marks") .
     1872       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
     1873                       sw:start-element ("bk:Mark") .
     1874                           sw:write-data-element ("bk:Identity", string(tt-gds-act.position_)) no-error .
     1875                           sw:write-data-element ("bk:Type", tt-gds-act.type_) no-error .
     1876                           sw:write-data-element ("bk:Rank", tt-gds-act.rank) no-error .
     1877                           sw:write-data-element ("bk:Number", tt-gds-act.number) no-error .
     1878                           if tt-gds-act.mark <> ? and tt-gds-act.mark <> ""
     1879                           then sw:write-data-element ("bk:Barcode", tt-gds-act.mark) no-error .
     1880                       sw:end-element ("bk:Mark") .
     1881       end.
     1882                   sw:end-element ("bk:Marks") .
     1883               sw:end-element ("ns:QueryBarcode") .
     1884           sw:end-element ("ns:Document") .
     1885       sw:end-element ("ns:Documents") .
     1886       sw:end-document () .
     1887       delete object sw.
     1888   end procedure .
     1889   procedure parseXML :
     1890       define input parameter inFile as character no-undo .
     1891       empty temp-table tt-act-header .
     1892       empty temp-table tt-gds-act .
     1893       CREATE X-DOCUMENT hDoc.
     1894       CREATE X-NODEREF hRoot.
     1895       hDoc:encoding = 'utf-8'.
     1896       hDoc:LOAD("file", search(inFile),FALSE).
     1897       hDoc:GET-DOCUMENT-ELEMENT(hRoot).
     1898       RUN GetChildren(hRoot, 1).
     1899       DELETE OBJECT hDoc.
     1900       DELETE OBJECT hRoot.
     1901   end procedure .
     1902   procedure GetChildren :
     1903       DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
     1904       DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
     1905       DEFINE VARIABLE i AS INTEGER NO-UNDO.
     1906       DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
     1907       DEFINE VARIABLE hText AS HANDLE NO-UNDO.
     1908       CREATE X-NODEREF hNoderef.
     1909       CREATE X-NODEREF hText .
     1910       REPEAT i = 1 TO hParent:NUM-CHILDREN:
     1911           good = hParent:GET-CHILD(hNoderef,i).
     1912           IF NOT good THEN
     1913               LEAVE.
     1914           IF hNoderef:SUBTYPE <> "element" THEN
     1915               NEXT.
     1916           hNoderef:GET-CHILD(hText, 1) no-error .
     1917           IF hNoderef:NAME = "bk:QueryNumber" THEN do :
     1918               create tt-act-header .
     1919               assign tt-act-header.num = hText:node-value no-error .
     1920               assign tt-act-header.is-sent = bh-act-header:buffer-field("is-sent"):buffer-value no-error.
     1921           end .
     1922           .
     1923           IF hNoderef:NAME = "bk:Date" THEN
     1924               assign tt-act-header.date_ = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
     1925           IF hNoderef:NAME = "bk:Mark" THEN do :
     1926               create tt-gds-act .
     1927               assign tt-gds-act.num = tt-act-header.num .
     1928           end.
     1929           IF hNoderef:NAME = "bk:Identity" THEN assign tt-gds-act.position_ = integer(hText:node-value) no-error .
     1930           IF hNoderef:NAME = "bk:Type" THEN assign tt-gds-act.type_ = hText:node-value no-error .
     1931           IF hNoderef:NAME = "bk:Rank" THEN assign tt-gds-act.rank = hText:node-value no-error .
     1932           IF hNoderef:NAME = "bk:Number" THEN assign tt-gds-act.number = hText:node-value no-error .
     1933           IF hNoderef:NAME = "bk:Barcode" THEN assign tt-gds-act.mark = hText:node-value no-error .
     1934           run GetChildren (hNoderef, (level + 1)).
     1935       END.
     1936       DELETE OBJECT hNoderef.
     1937       DELETE OBJECT hText.
     1938   END procedure.
     1939   define stream OutStr-html.
     1940   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1941   define  stream PrnLibStream.
     1942   procedure prn-lib-prn-file :
     1943     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1944     define input parameter p-DIsabledoptions as integer no-undo .
     1945     define variable v-report-name as character no-undo .
     1946     define variable v-user-action as character no-undo .
     1947     define variable v-printed     as logical   no-undo .
     1948     define variable v-exist       as logical   no-undo .
     1949     do
     1950       on error undo, return error
     1951       :
     1952       run prn-lib-get-report-name  in this-procedure (
     1953         input parParentProc
     1954         ,output v-report-name
     1955         ).
     1956   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1957   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1958     (input  v-report-name
     1959     ,input  2
     1960     ,output v-exist
     1961     )  .
     1962       if NOT v-exist then
     1963       DO:
     1964         Message
     1965           "Нет заданий на печать ! "
     1966           view-as alert-box .
     1967         Return  .
     1968       End.
     1969       run gbl/prnfilen.w
     1970         (input  ""
     1971         ,input  p-DisabledOptions
     1972         ,input  string(v-report-name )
     1973         ,input  7
     1974         ,output v-user-action
     1975         ,output v-printed
     1976         ) .
     1977       if v-printed then
     1978       do:
     1979         return "YES" .
     1980       end.
     1981       else
     1982       do:
     1983         return "NO" .
     1984       end.
     1985     end.
     1986   end procedure.
     1987   procedure prn-lib-open-stream :
     1988     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1989     define input parameter p-page-size    as integer no-undo .
     1990     define input parameter p-is-stream    as logical no-undo .
     1991     define input parameter p-append       as logical no-undo .
     1992     define variable v-report-name as character no-undo .
     1993     do
     1994       on error undo, return error
     1995       :
     1996       run prn-lib-get-report-name  in this-procedure (
     1997         input parParentProc
     1998         ,output v-report-name
     1999         ).
     2000       if p-is-stream then
     2001       do:
     2002         if p-append then
     2003         do:
     2004           output stream PrnLibStream to value( v-report-name )
     2005             page-size value(p-page-size) append .
     2006         end.
     2007         if not p-append then
     2008         do:
     2009           output stream PrnLibStream to value( v-report-name )
     2010             page-size value(p-page-size) .
     2011         end.
     2012       end.
     2013       if not p-is-stream then
     2014       do:
     2015         if p-append then
     2016         do:
     2017           output to value( v-report-name )
     2018             page-size value(p-page-size) append .
     2019         end.
     2020         if not p-append then
     2021         do:
     2022           output to value( v-report-name )
     2023             page-size value(p-page-size) .
     2024         end.
     2025       end.
     2026     end.
     2027   end procedure.
     2028   procedure prn-lib-open-exp :
     2029     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     2030     define input parameter p-is-stream    as logical no-undo .
     2031     define input parameter p-is-append    as logical no-undo .
     2032     define output parameter p-ReportFileName as char init "report" no-undo.
     2033     define output parameter p-process as logical no-undo .
     2034     define variable glog as logical no-undo .
     2035     do
     2036       on error undo, return error
     2037       :
     2038       SYSTEM-DIALOG GET-FILE p-ReportFileName
     2039         TITLE      "Укажите путь"
     2040         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     2041         ASK-OVERWRITE
     2042         CREATE-TEST-FILE
     2043         SAVE-AS
     2044         USE-FILENAME
     2045         DEFAULT-EXTENSION "txt"
     2046         UPDATE glog
     2047         .
     2048       if not glog then  return.
     2049       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     2050       if p-is-stream then
     2051       do:
     2052         if p-is-append then
     2053         do:
     2054           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     2055         end.
     2056         else
     2057         do:
     2058           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     2059         end.
     2060       end.
     2061       else
     2062       do:
     2063         if p-is-append then
     2064         do:
     2065           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     2066         end.
     2067         else
     2068         do:
     2069           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     2070         end.
     2071       end.
     2072       p-process = yes.
     2073     end.
     2074   end procedure.
     2075   procedure prn-lib-get-report-name :
     2076     define input parameter parParentProc  as widget-handle no-undo.
     2077     define output parameter p-report-name as character no-undo .
     2078     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     2079   end procedure.
     2080   procedure prn-lib-reportviewer-report-name :
     2081     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     2082     define input parameter p-report-name-html as character no-undo .
     2083     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     2084   end procedure.
     2085   procedure prn-lib-reportviewer :
     2086     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     2087     define input parameter p-report-name-html as character no-undo .
     2088     define input parameter p-param        as character no-undo .
     2089     define variable v-excel           as character no-undo init 'TRUE' .
     2090     define variable v-value-character as character no-undo .
     2091     define variable v-value-integer   as character no-undo .
     2092     define variable v-value-date      as date      no-undo .
     2093     define variable v-value-decimal   as decimal   no-undo .
     2094     define variable rep-excel         as logical   no-undo .
     2095     define variable excel-string      as character no-undo .
     2096     define variable v-param-type      as character no-undo .
     2097     define variable v-tth             as handle    no-undo .
     2098     run adm/shattri.p (
     2099       input "get":U
     2100       ,input  ""
     2101       ,input  0
     2102       ,input  'report-glob':U
     2103       ,input  'rep-excel':U
     2104       ,output v-value-character
     2105       ,output v-value-date
     2106       ,output v-value-decimal
     2107       ,output v-value-integer
     2108       ,output rep-excel
     2109       ,output v-param-type
     2110       ,INPUT-OUTPUT table-handle v-tth
     2111       )  .
     2112     if rep-excel then v-excel = "TRUE" .
     2113     else v-excel = "FALSE" .
     2114     if p-param eq ""
     2115     then
     2116        p-param = "EXCEL:" + v-excel.
     2117     else
     2118        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     2119     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     2120   end procedure.
     2121   define variable select-list as longchar no-undo .
     2122   FUNCTION get-mark RETURNS CHARACTER
     2123   (buffer local-gds for tt-gds-act ):
     2124   if lookup (string (recid (local-gds)), select-list) > 0  then return "*".
     2125                                                              else return "".
     2126   end function.
     2127   DEFINE BUTTON b-cancel AUTO-END-KEY
     2128        LABEL "Выход"
     2129        SIZE 15 BY 1.14
     2130        BGCOLOR 8 .
     2131   DEFINE BUTTON b-add
     2132        LABEL "Добавить строку"
     2133        SIZE 20 BY 1.14
     2134        BGCOLOR 8 .
     2135   DEFINE BUTTON b-del
     2136        LABEL "Удалить строку"
     2137        SIZE 20 BY 1.14 TOOLTIP "Удалить строку акта"
     2138        BGCOLOR 8 .
     2139   DEFINE BUTTON b-save
     2140        LABEL "Сохранить"
     2141        SIZE 15 BY 1.14 TOOLTIP "Сохранить в БД"
     2142        BGCOLOR 8 .
     2143   DEFINE BUTTON b-print
     2144        LABEL "Печать"
     2145        SIZE 15 BY 1.14 TOOLTIP "Печать"
     2146        BGCOLOR 8 .
     2147   DEFINE QUERY br-gds-act FOR
     2148         tt-gds-act SCROLLING.
     2149   DEFINE BROWSE br-gds-act
     2150     QUERY br-gds-act  DISPLAY
     2151       tt-gds-act.position_
     2152       tt-gds-act.type_
     2153       tt-gds-act.rank width 5
     2154       tt-gds-act.number
     2155     ENABLE
     2156       tt-gds-act.type_
     2157       tt-gds-act.rank
     2158       tt-gds-act.number
     2159       WITH NO-ROW-MARKERS SEPARATORS SIZE 107 BY 20.2 FIT-LAST-COLUMN.
     2160   DEFINE FRAME Dialog-Frame
     2161       b-cancel at row 1.2 col 2
     2162       b-add at row 1.2 col 32
     2163       b-del at row 1.2 col 52
     2164       b-save at row 1.2 col 17
     2165       b-print at row 1.2 col 94
     2166       tt-act-header.num at row 2.5 col 2 format "X(22)"
     2167       tt-act-header.date_ at row 2.5 col 34
     2168       br-gds-act at row 3.5 col 2
     2169        SPACE(0.5) SKIP(0.5)
     2170       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2171            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2172            TITLE "Запрос на получение штрихкода по серии и номеру марки" WIDGET-ID 100.
     2173   ASSIGN
     2174          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2175          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2176   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2177   DO:
     2178     APPLY "END-ERROR":U TO SELF.
     2179   END.
     2180   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     2181   DO:
     2182       if p-mode <> 'ПРОСМОТР':U then do :
     2183           message "Все несохранённые данные будут потеряны. Вы уверены, что хотите выйти?"
     2184           view-as alert-box question buttons yes-no update glog.
     2185           if not glog then return no-apply .
     2186       end.
     2187   END.
     2188   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     2189   DO:
     2190     do trans :
     2191       os-delete value("egais-marks.txt") no-error.
     2192       output to value("egais-marks.txt").
     2193       for each tt-gds-act no-lock break by tt-gds-act.position_ :
     2194           put unformatted tt-gds-act.mark skip .
     2195       end.
     2196       output close .
     2197       path = session:temp-directory + "egais-marks\".
     2198       os-delete value(right-trim (path, "\")) RECURSIVE.
     2199       file-info:file-name = right-trim (path, "\").
     2200       if file-info:file-type = ?
     2201       then do:
     2202         os-create-dir value(right-trim (path, "\")).
     2203         if os-error <> 0 then do:
     2204           message substitute("Невозможно создать директорию &1 для загрузки в неё марок",path) view-as alert-box error.
     2205           return no-apply.
     2206         end.
     2207       end.
     2208       cmd = substitute ('&1 --output="&3egais-marks\mark~~~~~~.png" --batch --height=0 --scale=0.5 --border=2 --barcode=55 --input="&2"', search ("exe/Zint/zint.exe"), search ("egais-marks.txt"), session:temp-directory).
     2209       os-command silent value (cmd).
     2210       define var v-act-file as char no-undo.
     2211       v-act-file  = "egais-marks.html".
     2212       output stream OutStr-html to value(v-act-file) convert target 'UTF-8'.
     2213       put stream OutStr-html unformatted
     2214           substitute(
     2215           '<!doctype html>
     2216                    <html>
     2217                 <head>
     2218                 <meta charset="UTF-8">
     2219                    <!-- Стили документа -->
     2220                 <style>
     2221                   table ~{border-collapse: collapse; ~}
     2222                   tbody td, th ~{border: 1px solid black;~}
     2223                   #myid ~{font-weight: bold;~}
     2224                   .class1 ~{font-style: italic;~}
     2225                   .class2 ~{font-family: Arial;~}
     2226                 </style>
     2227                 </head>
     2228                     <body>
     2229                     <table orientation="landscape" name="лист1" repeat_rows="1:1" hide_zero="True">
     2230                     <thead>
     2231                     <!-- Обязательно создаётся строка таблицы, в которой находятся размеры колонок в px-->
     2232                     <tr class="set_columns">
     2233                           <td style="width:40px"></td>
     2234                           <td style="width:210px"></td>
     2235                           <td style="width:320px"></td>
     2236                     </tr>
     2237   
     2238           </thead>
     2239               <tbody style="page-break-after: always;">
     2240                   <tr style="height: 25px;">
     2241                   <th>№ пп</th>
     2242                   <th>Тип, серия и номер</th>
     2243                   <th>Марка</th>
     2244                   </tr>').
     2245       for each tt-gds-act no-lock break by tt-gds-act.position_ :
     2246           src = substitute ('<img src="&1egais-marks/mark', session:temp-directory) + string(tt-gds-act.position_, "999") + substitute ('.png" alt="&1">', tt-gds-act.mark) .
     2247           put stream OutStr-html unformatted
     2248               substitute(
     2249               '<tr style="height: 88px;">
     2250                <td text_wrap="true"> &1 </td>
     2251                <td text_wrap="true"> &2 </td>
     2252                <td text_wrap="true"> &3 </td>
     2253                </tr>',
     2254               string(tt-gds-act.position_),
     2255               (tt-gds-act.type_ + " " + tt-gds-act.rank + " " + tt-gds-act.number),
     2256               src
     2257               ).
     2258           if tt-gds-act.position_ modulo 15 = 0
     2259           then
     2260               put stream OutStr-html unformatted
     2261                   '<tr style="height: 33px;">
     2262                   <th>№ пп</th>
     2263                   <th>Тип, серия и номер</th>
     2264                   <th>Марка</th>
     2265                   </tr>'
     2266               .
     2267       end.
     2268       put stream OutStr-html unformatted
     2269           '</tbody>
     2270            </body>
     2271            </html>'
     2272       .
     2273       output stream OutStr-html close.
     2274       run prn-lib-reportviewer-report-name in this-procedure (
     2275           input this-procedure
     2276           ,input v-act-file
     2277           ).
     2278       os-delete value("egais-marks.txt") no-error.
     2279     end.
     2280   END.
     2281   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     2282   DO:
     2283       def var v-rec as recid no-undo .
     2284       nn = nn + 1.
     2285       create tt-gds-act.
     2286       assign
     2287           tt-gds-act.num = tt-act-header.num
     2288           tt-gds-act.position_ = nn
     2289       .
     2290       v-rec = recid(tt-gds-act) .
     2291       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2292       reposition br-gds-act to recid v-rec .
     2293   END.
     2294   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     2295   DO:
     2296       define variable v-tt-rec as recid.
     2297       if available tt-gds-act  AND select-list = ""
     2298       then
     2299       select-list = string( recid( tt-gds-act ) ) .
     2300       if not available tt-gds-act and select-list = "" then do :
     2301           message "Выберите строку" view-as alert-box .
     2302           return no-apply.
     2303       end.
     2304       else
     2305       do ii = 1 to num-entries (select-list) :
     2306         v-tt-rec = integer(entry(ii, select-list)) .
     2307         for first tt-gds-act exclusive-lock where recid(tt-gds-act) = v-tt-rec :
     2308           delete tt-gds-act .
     2309         end.
     2310       end.
     2311       nn = 0 .
     2312       for each tt-gds-act exclusive-lock :
     2313           nn = nn + 1 .
     2314           tt-gds-act.position_ = nn .
     2315       end.
     2316       select-list = "" .
     2317       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2318   END.
     2319   ON "leave" of tt-act-header.num in FRAME Dialog-Frame
     2320   DO:
     2321       define variable prev-num as character no-undo .
     2322       prev-num = tt-act-header.num .
     2323       assign tt-act-header.num .
     2324       for each tt-gds-act exclusive-lock where tt-gds-act.num = prev-num :
     2325           assign tt-gds-act.num = tt-act-header.num .
     2326       end.
     2327   END.
     2328   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     2329   DO:
     2330       assign
     2331           tt-act-header.num
     2332           tt-act-header.date_
     2333       .
     2334       find first tt-gds-act no-error .
     2335       if not available tt-gds-act then do :
     2336           message "В акте нет строк. Сохранение невозможно" view-as alert-box .
     2337           return no-apply.
     2338       end.
     2339       run makeXML in this-procedure no-error.
     2340       if error-status:error then return return-value .
     2341       assign
     2342           v-clob-db-num = ?
     2343           v-int64-id = 0
     2344           v-info = tt-act-header.num + chr(4) + string(tt-act-header.date_) + chr(4) + string(tt-act-header.is-sent)
     2345       .
     2346       find first buf_clob-bind exclusive-lock where buf_clob-bind.uniq-key-rec = tt-act-header.num
     2347                                                 and buf_clob-bind.field-name_  = 'egais-qb':U no-error .
     2348       if available buf_clob-bind then do :
     2349           assign
     2350               v-clob-db-num = buf_clob-bind.db-num
     2351               v-int64-id = buf_clob-bind.int64-id
     2352               v-part-num = buf_clob-bind.part-num
     2353           .
     2354           run gbl/file2clb.p ( input 'ИЗМЕНЕНИЕ':U
     2355                     ,input "add-new,yes"
     2356                     ,input ?
     2357                     ,input tt-act-header.num
     2358                     ,input 'egais-qb':U
     2359                     ,input v-info
     2360                     ,input-output v-part-num
     2361                     ,input 'egais-qb':U
     2362                     ,input-output v-clob-db-num
     2363                     ,input-output v-int64-id
     2364                     ,input search (v-file)
     2365                     ,input ''
     2366                     ) no-error .
     2367            if error-status:error then message return-value view-as alert-box.
     2368       end.
     2369       else do :
     2370           run gbl/file2clb.p ( input 'ДОБАВЛЕНИЕ':U
     2371                     ,input ",yes"
     2372                     ,input ?
     2373                     ,input tt-act-header.num
     2374                     ,input 'egais-qb':U
     2375                     ,input v-info
     2376                     ,input-output v-part-num
     2377                     ,input 'egais-qb':U
     2378                     ,input-output v-clob-db-num
     2379                     ,input-output v-int64-id
     2380                     ,input search (v-file)
     2381                     ,input ''
     2382                     ) no-error .
     2383       end.
     2384       message "Сохранение завершено" view-as alert-box.
     2385   END.
     2386   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2387   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2388   MAIN-BLOCK:
     2389   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2390      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2391       assign
     2392           nn = 0
     2393       .
     2394       if p-mode = 'ДОБАВЛЕНИЕ':U then do :
     2395           v-date = substitute ("&1&2&3", string (day (now), "99"), string (month (now), "99"),substring (string(year (now)), 3,2)).
     2396           create tt-act-header .
     2397           assign
     2398               tt-act-header.num = "QB-" + v-date + '-' + substring(v-cntxt-obj-type,1,1) + string(v-cntxt-obj-code) + '-' + string(int(TIME))
     2399               tt-act-header.date_ = TODAY
     2400               tt-act-header.is-sent = no
     2401           .
     2402           display tt-act-header.num tt-act-header.date_ with frame Dialog-Frame.
     2403           enable  tt-act-header.date_ b-add with frame Dialog-Frame.
     2404       end.
     2405       if p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ПРОСМОТР':U then do :
     2406           find last buf_clob-bind where buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value
     2407                                     and buf_clob-bind.field-name_ = 'egais-qb':U
     2408                                     and buf_clob-bind.part-num = 1  .
     2409           find first buf_clob-data no-lock where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     2410           copy-lob
     2411           from  object buf_clob-data.cdata
     2412           to  file 'temp-qb.xml'
     2413           no-convert
     2414           no-error .
     2415           run waitfram-show in this-procedure ("Ждите...") .
     2416           run parseXML in this-procedure (input "temp-qb.xml") .
     2417           run waitfram-hide in this-procedure .
     2418           display tt-act-header.num tt-act-header.date_ with frame Dialog-Frame.
     2419           if p-mode = 'ИЗМЕНЕНИЕ':U then
     2420           for each tt-gds-act no-lock :
     2421               nn = nn + 1 .
     2422           end .
     2423           open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2424           if p-mode = 'ПРОСМОТР':U then disable b-add with frame Dialog-Frame.
     2425           else enable b-add with frame Dialog-Frame.
     2426       end.
     2427   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2428   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2429   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2430   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2431   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2432   define variable v-diasize-current-frame-height as decimal   no-undo .
     2433   define variable v-diasize-change-size          as logical   no-undo .
     2434   define variable v-diasize-resize-button        as handle    no-undo .
     2435   define variable v-diasize-wndmax               as logical   no-undo .
     2436   define variable v-diasize-wndstore             as logical   no-undo .
     2437   define variable v-diasize-proc-name            as character no-undo .
     2438   define variable v-diasize-browse-handle        as handle    no-undo .
     2439   define variable v-diasize-browse-number        as integer   no-undo .
     2440   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2441   define temp-table temp-diasize-handle no-undo
     2442     field handle-value  as handle
     2443     field save-position as decimal
     2444     index xpk is primary unique handle-value
     2445     .
     2446   define temp-table temp-browse-handle no-undo
     2447     field browse-type   as character
     2448     field browse-number as integer
     2449     field browse-handle as handle
     2450     field original-size as decimal
     2451     index xpk is primary unique browse-type browse-number
     2452     index xie browse-type browse-handle
     2453   .
     2454   procedure diasize_change-height :
     2455     define input  parameter p-change-value  as decimal   no-undo .
     2456     define input  parameter p-move-resize   as logical   no-undo .
     2457     define variable v-field-group-handle    as handle    no-undo .
     2458     define variable v-object-handle         as handle    no-undo .
     2459     define variable v-frame-height          as decimal   no-undo .
     2460     define variable v-frame-virtual-height  as decimal   no-undo .
     2461     define variable v-browse-height         as decimal   no-undo .
     2462     define variable v-window-height         as decimal   no-undo .
     2463     define variable v-window-virtual-height as decimal   no-undo .
     2464     define variable v-change-sign           as integer   no-undo .
     2465     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2466     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2467     if p-change-value > 0
     2468     then do:
     2469       if frame Dialog-Frame :height + p-change-value
     2470           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2471       then do:
     2472         assign
     2473           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2474                           - (frame Dialog-Frame :height-chars)
     2475         .
     2476         if p-change-value <= 0
     2477         then do:
     2478           run diasize_position-resize-button in this-procedure .
     2479           return .
     2480         end.
     2481       end.
     2482     end.
     2483     if p-change-value < 0
     2484     then do:
     2485       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2486       then do:
     2487         assign
     2488           p-change-value = v-diasize-orig-frame-height
     2489                          - (frame Dialog-Frame :height-chars)
     2490         .
     2491         if p-change-value >= 0
     2492         then do:
     2493           run diasize_position-resize-button in this-procedure .
     2494           return .
     2495         end.
     2496       end.
     2497     end.
     2498     if p-change-value >= 0
     2499     then do:
     2500       assign
     2501         v-change-sign = 1
     2502       .
     2503     end.
     2504     else do:
     2505       assign
     2506         v-change-sign = -1
     2507       .
     2508     end.
     2509     assign
     2510       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2511     .
     2512     if p-change-value = 0
     2513     then do:
     2514       run diasize_position-resize-button in this-procedure .
     2515       return .
     2516     end.
     2517     move_block:
     2518     do
     2519     on error undo move_block, retry move_block
     2520     :
     2521       if retry
     2522       then do:
     2523         do
     2524         on error undo move_block, leave move_block
     2525         :
     2526           if p-change-value > 0
     2527           then do:
     2528             for each buf_temp-diasize-handle
     2529             on error undo, next
     2530             :
     2531               assign
     2532                 v-object-handle = buf_temp-diasize-handle.handle-value
     2533               .
     2534               if v-object-handle <> v-diasize-resize-button
     2535               then do:
     2536                 assign
     2537                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2538                 .
     2539               end.
     2540             end.
     2541             assign
     2542               v-diasize-browse-handle :height = v-browse-height
     2543             .
     2544             for each buf_temp-browse-handle
     2545               where buf_temp-browse-handle.browse-type = 'height':u
     2546             on error undo, next
     2547             :
     2548               assign
     2549                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2550               .
     2551             end.
     2552             assign
     2553               frame Dialog-Frame :height = v-frame-height
     2554             .
     2555             if frame Dialog-Frame :scrollable = true
     2556             then do:
     2557               assign
     2558                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2559               .
     2560             end.
     2561             run diasize_position-resize-button in this-procedure .
     2562           end.
     2563           else do:
     2564             if frame Dialog-Frame :scrollable = true
     2565             then do:
     2566               assign
     2567                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2568               .
     2569             end.
     2570             assign
     2571               frame Dialog-Frame :height = v-frame-height
     2572             .
     2573             assign
     2574               v-diasize-browse-handle :height = v-browse-height
     2575             .
     2576             for each buf_temp-browse-handle
     2577               where buf_temp-browse-handle.browse-type = 'height':u
     2578             on error undo, next
     2579             :
     2580               assign
     2581                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2582               .
     2583             end.
     2584             for each buf_temp-diasize-handle
     2585             on error undo, next
     2586             :
     2587               assign
     2588                 v-object-handle = buf_temp-diasize-handle.handle-value
     2589               .
     2590               if v-object-handle <> v-diasize-resize-button
     2591               then do:
     2592                 assign
     2593                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2594                 .
     2595               end.
     2596             end.
     2597             run diasize_position-resize-button in this-procedure .
     2598           end.
     2599           assign
     2600             v-diasize-change-size = false
     2601           .
     2602           leave move_block .
     2603         end.
     2604       end.
     2605       assign
     2606         v-diasize-need-full-display = true
     2607       .
     2608       if v-diasize-change-size = false
     2609       then do:
     2610         assign
     2611           v-diasize-change-size = true
     2612         .
     2613       end.
     2614       else do:
     2615         return .
     2616       end.
     2617       assign
     2618         v-frame-height = frame Dialog-Frame :height
     2619         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2620         v-browse-height = v-diasize-browse-handle :height
     2621       .
     2622       for each buf_temp-browse-handle
     2623         where buf_temp-browse-handle.browse-type = 'height':u
     2624       :
     2625         assign
     2626           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2627         .
     2628       end.
     2629       for each buf_temp-diasize-handle
     2630       :
     2631         delete buf_temp-diasize-handle .
     2632       end.
     2633       assign
     2634         v-field-group-handle = frame Dialog-Frame :first-child
     2635       .
     2636       do while valid-handle(v-field-group-handle)
     2637       :
     2638         assign
     2639           v-object-handle = v-field-group-handle :first-child
     2640         .
     2641         do while valid-handle(v-object-handle)
     2642         :
     2643           if  v-object-handle <> v-diasize-browse-handle :handle
     2644           and can-query(v-object-handle, "row")
     2645           and can-query(v-object-handle, "height")
     2646           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2647           then do:
     2648             find first buf_temp-browse-handle
     2649               where buf_temp-browse-handle.browse-type   = 'height':u
     2650                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2651               no-error .
     2652             if available buf_temp-browse-handle
     2653             then do:
     2654             end.
     2655             else do:
     2656               create buf_temp-diasize-handle .
     2657               assign
     2658                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2659                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2660               .
     2661             end.
     2662           end.
     2663           assign
     2664             v-object-handle = v-object-handle :next-sibling
     2665           .
     2666         end.
     2667         assign
     2668           v-field-group-handle = v-field-group-handle :next-sibling
     2669         .
     2670       end.
     2671       do with frame Dialog-Frame
     2672       :
     2673         hide v-diasize-resize-button .
     2674         assign
     2675           v-diasize-resize-button :row    = 1
     2676           v-diasize-resize-button :column = 1
     2677         .
     2678       end.
     2679       if p-change-value > 0
     2680       then do:
     2681         if frame Dialog-Frame :scrollable = true
     2682         then do:
     2683           assign
     2684             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2685             no-error .
     2686           if error-status :error
     2687           or error-status :get-message(1) <> ""
     2688           then do:
     2689             undo move_block, retry move_block .
     2690           end.
     2691         end.
     2692         assign
     2693           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2694           no-error .
     2695         if error-status :error
     2696         or error-status :get-message(1) <> ""
     2697         then do:
     2698           undo move_block, retry move_block .
     2699         end.
     2700         assign
     2701           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2702           no-error .
     2703         if error-status :error
     2704         or error-status :get-message(1) <> ""
     2705         then do:
     2706           undo move_block, retry move_block .
     2707         end.
     2708         for each buf_temp-browse-handle
     2709           where buf_temp-browse-handle.browse-type = 'height':u
     2710         on error undo move_block, retry move_block
     2711         :
     2712           assign
     2713             buf_temp-browse-handle.browse-handle :height
     2714               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2715             no-error .
     2716           if error-status :error
     2717           or error-status :get-message(1) <> ""
     2718           then do:
     2719             undo move_block, retry move_block .
     2720           end.
     2721         end.
     2722         for each buf_temp-diasize-handle
     2723         on error undo move_block, retry move_block
     2724         :
     2725           assign
     2726             v-object-handle = buf_temp-diasize-handle.handle-value
     2727           .
     2728           if v-object-handle <> v-diasize-resize-button
     2729           then do:
     2730             assign
     2731               v-object-handle :row = v-object-handle :row + p-change-value
     2732               no-error .
     2733             if error-status :error
     2734             or error-status :get-message(1) <> ""
     2735             then do:
     2736               undo move_block, retry move_block .
     2737             end.
     2738           end.
     2739         end.
     2740       end.
     2741       else do:
     2742         for each buf_temp-diasize-handle
     2743         on error undo move_block, retry move_block
     2744         :
     2745           assign
     2746             v-object-handle = buf_temp-diasize-handle.handle-value
     2747           .
     2748           if v-object-handle <> v-diasize-resize-button
     2749           then do:
     2750             assign
     2751               v-object-handle :row = v-object-handle :row + p-change-value
     2752               no-error .
     2753             if error-status :error
     2754             or error-status :get-message(1) <> ""
     2755             then do:
     2756               undo move_block, retry move_block .
     2757             end.
     2758           end.
     2759         end.
     2760         assign
     2761           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2762           no-error .
     2763         if error-status :error
     2764         or error-status :get-message(1) <> ""
     2765         then do:
     2766           undo move_block, retry move_block .
     2767         end.
     2768         for each buf_temp-browse-handle
     2769           where buf_temp-browse-handle.browse-type = 'height':u
     2770         on error undo move_block, retry move_block
     2771         :
     2772           assign
     2773             buf_temp-browse-handle.browse-handle :height
     2774               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2775             no-error .
     2776           if error-status :error
     2777           or error-status :get-message(1) <> ""
     2778           then do:
     2779             undo move_block, retry move_block .
     2780           end.
     2781         end.
     2782         assign
     2783           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2784           no-error .
     2785         if error-status :error
     2786         or error-status :get-message(1) <> ""
     2787         then do:
     2788           undo move_block, retry move_block .
     2789         end.
     2790         if frame Dialog-Frame :scrollable = true
     2791         then do:
     2792           assign
     2793             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2794             no-error .
     2795           if error-status :error
     2796           or error-status :get-message(1) <> ""
     2797           then do:
     2798             undo move_block, retry move_block .
     2799           end.
     2800         end.
     2801       end.
     2802       if p-move-resize = true
     2803       then do:
     2804         run diasize_position-resize-button in this-procedure .
     2805       end.
     2806       if v-diasize-wndstore = true
     2807       then do:
     2808         if connected("ub") = true
     2809         then do:
     2810           define variable v-cntxt-db-num        as integer   no-undo .
     2811           define variable v-cntxt-userid        as character no-undo .
     2812           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2813                                             , OUTPUT v-cntxt-userid
     2814                                             ) .
     2815           run gbl/wndsizew.p
     2816             (input  v-cntxt-db-num
     2817             ,input  v-cntxt-userid
     2818             ,input  v-diasize-proc-name
     2819             ,input  'height':u
     2820             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2821             ) .
     2822         end.
     2823       end.
     2824     end.
     2825     assign
     2826       v-diasize-change-size = false
     2827     .
     2828   end procedure.
     2829   procedure diasize_set-height :
     2830     define input  parameter p-new-height  as decimal   no-undo .
     2831     define input  parameter p-move-resize as logical   no-undo .
     2832     do
     2833     on error undo, return error return-value
     2834     :
     2835       run diasize_change-height in this-procedure
     2836         (input  (p-new-height - frame Dialog-Frame :height)
     2837         ,input  p-move-resize
     2838         ) .
     2839     end.
     2840   end procedure.
     2841   procedure diasize_change-width :
     2842     define input  parameter p-change-value as decimal   no-undo .
     2843     define input  parameter p-move-resize  as logical   no-undo .
     2844     define variable v-field-group-handle   as handle    no-undo .
     2845     define variable v-object-handle        as handle    no-undo .
     2846     define variable v-frame-width          as decimal   no-undo .
     2847     define variable v-frame-virtual-width  as decimal   no-undo .
     2848     define variable v-browse-width         as decimal   no-undo .
     2849     define variable v-window-width         as decimal   no-undo .
     2850     define variable v-window-virtual-width as decimal   no-undo .
     2851     define variable v-change-sign          as integer   no-undo .
     2852     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2853     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2854     if p-change-value > 0
     2855     then do:
     2856       if frame Dialog-Frame :width + p-change-value >
     2857           session :width-chars
     2858       then do:
     2859         assign
     2860           p-change-value = session :width-chars - frame Dialog-Frame :width
     2861         .
     2862         if p-change-value <= 0
     2863         then do:
     2864           run diasize_position-resize-button in this-procedure .
     2865           return .
     2866         end.
     2867       end.
     2868     end.
     2869     if p-change-value < 0
     2870     then do:
     2871       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2872       then do:
     2873         assign
     2874           p-change-value = v-diasize-orig-frame-width
     2875                          - frame Dialog-Frame :width
     2876         .
     2877         if p-change-value >= 0
     2878         then do:
     2879           run diasize_position-resize-button in this-procedure .
     2880           return .
     2881         end.
     2882       end.
     2883     end.
     2884     if p-change-value >= 0
     2885     then do:
     2886       assign
     2887         v-change-sign = 1
     2888       .
     2889     end.
     2890     else do:
     2891       assign
     2892         v-change-sign = -1
     2893       .
     2894     end.
     2895     assign
     2896       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2897     .
     2898     if p-change-value = 0
     2899     then do:
     2900       run diasize_position-resize-button in this-procedure .
     2901       return .
     2902     end.
     2903     move_block:
     2904     do
     2905     on error undo move_block, leave move_block
     2906     :
     2907       if retry
     2908       then do:
     2909         do
     2910         on error undo move_block, leave move_block
     2911         :
     2912           if p-change-value > 0
     2913           then do:
     2914             for each buf_temp-diasize-handle
     2915             on error undo, next
     2916             :
     2917               assign
     2918                 v-object-handle = buf_temp-diasize-handle.handle-value
     2919               .
     2920               if v-object-handle <> v-diasize-resize-button
     2921               then do:
     2922                 assign
     2923                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2924                 .
     2925               end.
     2926             end.
     2927             assign
     2928               v-diasize-browse-handle :width = v-browse-width
     2929             .
     2930             for each buf_temp-browse-handle
     2931               where buf_temp-browse-handle.browse-type = 'width':u
     2932             on error undo, next
     2933             :
     2934               assign
     2935                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2936               .
     2937             end.
     2938             assign
     2939               frame Dialog-Frame :width = v-frame-width
     2940             .
     2941             if frame Dialog-Frame :scrollable = true
     2942             then do:
     2943               assign
     2944                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2945               .
     2946             end.
     2947             run diasize_position-resize-button in this-procedure .
     2948           end.
     2949           else do:
     2950             if frame Dialog-Frame :scrollable = true
     2951             then do:
     2952               assign
     2953                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2954               .
     2955             end.
     2956             assign
     2957               frame Dialog-Frame :width = v-frame-width
     2958             .
     2959             for each buf_temp-browse-handle
     2960               where buf_temp-browse-handle.browse-type = 'width':u
     2961             on error undo, next
     2962             :
     2963               assign
     2964                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2965               .
     2966             end.
     2967             assign
     2968               v-diasize-browse-handle :width = v-browse-width
     2969             .
     2970             for each buf_temp-diasize-handle
     2971             on error undo, next
     2972             :
     2973               assign
     2974                 v-object-handle = buf_temp-diasize-handle.handle-value
     2975               .
     2976               if v-object-handle <> v-diasize-resize-button
     2977               then do:
     2978                 assign
     2979                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2980                 .
     2981               end.
     2982             end.
     2983             run diasize_position-resize-button in this-procedure .
     2984           end.
     2985           assign
     2986             v-diasize-change-size = false
     2987           .
     2988           leave move_block .
     2989         end.
     2990       end.
     2991       assign
     2992         v-diasize-need-full-display = true
     2993       .
     2994       if v-diasize-change-size = false
     2995       then do:
     2996         assign
     2997           v-diasize-change-size = true
     2998         .
     2999       end.
     3000       else do:
     3001         return .
     3002       end.
     3003       assign
     3004         v-frame-width = frame Dialog-Frame :width
     3005         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3006         v-browse-width = v-diasize-browse-handle :width
     3007       .
     3008       for each buf_temp-browse-handle
     3009         where buf_temp-browse-handle.browse-type = 'width':u
     3010       :
     3011         assign
     3012           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3013         .
     3014       end.
     3015       for each buf_temp-diasize-handle
     3016       :
     3017         delete buf_temp-diasize-handle .
     3018       end.
     3019       assign
     3020         v-field-group-handle = frame Dialog-Frame :first-child
     3021       .
     3022       do while valid-handle(v-field-group-handle)
     3023       :
     3024         assign
     3025           v-object-handle = v-field-group-handle :first-child
     3026         .
     3027         do while valid-handle(v-object-handle)
     3028         :
     3029           if  v-object-handle <> v-diasize-browse-handle :handle
     3030           and v-object-handle <> v-diasize-resize-button
     3031           and can-query(v-object-handle, "row")
     3032           and can-query(v-object-handle, "height")
     3033           and ( v-object-handle :col + v-object-handle :width
     3034                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3035               )
     3036           then do:
     3037             find first buf_temp-browse-handle
     3038               where buf_temp-browse-handle.browse-type   = 'width':u
     3039                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3040               no-error .
     3041             if available buf_temp-browse-handle
     3042             then do:
     3043             end.
     3044             else do:
     3045               create buf_temp-diasize-handle .
     3046               assign
     3047                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3048                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3049               .
     3050             end.
     3051           end.
     3052           assign
     3053             v-object-handle = v-object-handle :next-sibling
     3054           .
     3055         end.
     3056         assign
     3057           v-field-group-handle = v-field-group-handle :next-sibling
     3058         .
     3059       end.
     3060       do with frame Dialog-Frame
     3061       :
     3062         hide v-diasize-resize-button .
     3063         v-diasize-resize-button :row = 1.
     3064         v-diasize-resize-button :column = 1.
     3065       end.
     3066       if p-change-value > 0
     3067       then do:
     3068         if frame Dialog-Frame :scrollable = true
     3069         then do:
     3070           assign
     3071             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3072             no-error .
     3073           if error-status :error
     3074           or error-status :get-message(1) <> ""
     3075           then do:
     3076             undo move_block, retry move_block.
     3077           end.
     3078         end.
     3079         assign
     3080           frame Dialog-Frame :width = v-frame-width + p-change-value
     3081           no-error .
     3082         if error-status :error
     3083         or error-status :get-message(1) <> ""
     3084         then do:
     3085           undo move_block, retry move_block.
     3086         end.
     3087         assign
     3088           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3089         no-error .
     3090         if error-status :error
     3091         or error-status :get-message(1) <> ""
     3092         then do:
     3093           undo move_block, retry move_block.
     3094         end.
     3095         for each buf_temp-browse-handle
     3096           where buf_temp-browse-handle.browse-type = 'width':u
     3097         on error undo move_block, retry move_block
     3098         :
     3099           assign
     3100             buf_temp-browse-handle.browse-handle :width
     3101               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3102             no-error .
     3103           if error-status :error
     3104           or error-status :get-message(1) <> ""
     3105           then do:
     3106             undo move_block, retry move_block .
     3107           end.
     3108         end.
     3109         for each buf_temp-diasize-handle
     3110         on error undo move_block, retry move_block
     3111         :
     3112           assign
     3113             v-object-handle = buf_temp-diasize-handle.handle-value
     3114           .
     3115           if v-object-handle <> v-diasize-resize-button
     3116           then do:
     3117             assign
     3118               v-object-handle :col = v-object-handle :col + p-change-value
     3119               no-error .
     3120             if error-status :error
     3121             or error-status :get-message(1) <> ""
     3122             then do:
     3123               undo move_block, retry move_block .
     3124             end.
     3125           end.
     3126         end.
     3127       end.
     3128       else do:
     3129         for each buf_temp-diasize-handle
     3130         on error undo move_block, retry move_block
     3131         :
     3132           assign
     3133             v-object-handle = buf_temp-diasize-handle.handle-value
     3134           .
     3135           if v-object-handle <> v-diasize-resize-button
     3136           then do:
     3137             assign
     3138               v-object-handle :col = v-object-handle :col + p-change-value
     3139               no-error .
     3140             if error-status :error
     3141             or error-status :get-message(1) <> ""
     3142             then do:
     3143               undo move_block, retry move_block .
     3144             end.
     3145           end.
     3146         end.
     3147         for each buf_temp-browse-handle
     3148           where buf_temp-browse-handle.browse-type = 'width':u
     3149         on error undo move_block, retry move_block
     3150         :
     3151           assign
     3152             buf_temp-browse-handle.browse-handle :width
     3153               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3154             no-error .
     3155           if error-status :error
     3156           or error-status :get-message(1) <> ""
     3157           then do:
     3158             undo move_block, retry move_block .
     3159           end.
     3160         end.
     3161         assign
     3162           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3163           no-error .
     3164         if error-status :error
     3165         or error-status :get-message(1) <> ""
     3166         then do:
     3167           undo move_block, retry move_block.
     3168         end.
     3169         assign
     3170           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3171         no-error .
     3172         if error-status :error
     3173         or error-status :get-message(1) <> ""
     3174         then do:
     3175           undo move_block, retry move_block.
     3176         end.
     3177         if frame Dialog-Frame :scrollable = true
     3178         then do:
     3179           assign
     3180             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3181           no-error .
     3182           if error-status :error
     3183           or error-status :get-message(1) <> ""
     3184           then do:
     3185             undo move_block, retry move_block.
     3186           end.
     3187         end.
     3188       end.
     3189       if p-move-resize
     3190       then do:
     3191         run diasize_position-resize-button in this-procedure .
     3192       end.
     3193       if v-diasize-wndstore = true
     3194       then do:
     3195         if connected("ub") = true
     3196         then do:
     3197           define variable v-cntxt-db-num        as integer   no-undo .
     3198           define variable v-cntxt-userid        as character no-undo .
     3199           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3200                                             , OUTPUT v-cntxt-userid
     3201                                             ) .
     3202           run gbl/wndsizew.p
     3203             (input  v-cntxt-db-num
     3204             ,input  v-cntxt-userid
     3205             ,input  v-diasize-proc-name
     3206             ,input  'width':u
     3207             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3208             ) .
     3209         end.
     3210       end.
     3211     end.
     3212     assign
     3213       v-diasize-change-size = false
     3214     .
     3215   end procedure.
     3216   procedure diasize_set-width :
     3217     define input  parameter p-new-width  as decimal   no-undo .
     3218     define input  parameter p-move-resize as logical   no-undo .
     3219     do
     3220     on error undo, return error return-value
     3221     :
     3222       run diasize_change-width in this-procedure
     3223         (input  (p-new-width - frame Dialog-Frame :width)
     3224         ,input  p-move-resize
     3225         ) .
     3226     end.
     3227   end procedure.
     3228   procedure diasize_position-resize-button :
     3229     do with frame Dialog-Frame
     3230     :
     3231       hide v-diasize-resize-button .
     3232       assign
     3233         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3234                     - 1
     3235                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3236         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3237                     - 1
     3238                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3239       .
     3240       view v-diasize-resize-button .
     3241     end.
     3242   end procedure.
     3243   on alt-right anywhere
     3244   do:
     3245     run diasize_change-width in this-procedure
     3246       (input 1
     3247       ,input true
     3248       ) .
     3249     return no-apply .
     3250   end.
     3251   on alt-left anywhere
     3252   do:
     3253     run diasize_change-width in this-procedure
     3254       (input -1
     3255       ,input true
     3256       ) .
     3257     return no-apply .
     3258   end.
     3259   on alt-down anywhere
     3260   do:
     3261     run diasize_change-height in this-procedure
     3262       (input 1
     3263       ,input true
     3264       ) .
     3265     return no-apply .
     3266   end.
     3267   on alt-up anywhere
     3268   do:
     3269     run diasize_change-height in this-procedure
     3270       (input -1
     3271       ,input true
     3272       ) .
     3273     return no-apply .
     3274   end.
     3275   on alt-enter of frame Dialog-Frame
     3276   do:
     3277     run diasize_maximize in this-procedure
     3278       (input  ?
     3279       ).
     3280     return no-apply .
     3281   end.
     3282   procedure diasize_end-move :
     3283     do
     3284     on error undo, return error return-value
     3285     :
     3286       define variable v-row-delta as decimal   no-undo .
     3287       define variable v-col-delta as decimal   no-undo .
     3288       define variable v-new-row as decimal   no-undo .
     3289       define variable v-new-col as decimal   no-undo .
     3290       assign
     3291         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3292         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3293       .
     3294       assign
     3295         v-row-delta = v-new-row - frame Dialog-Frame :height
     3296         v-col-delta = v-new-col - frame Dialog-Frame :width
     3297       .
     3298       run diasize_change-height in this-procedure
     3299         (input v-row-delta
     3300         ,input true
     3301         ) .
     3302       run diasize_change-width in this-procedure
     3303         (input v-col-delta
     3304         ,input true
     3305         ) .
     3306     end.
     3307   end procedure.
     3308   procedure diasize_maximize :
     3309     define input  parameter p-action as logical   no-undo .
     3310     do
     3311     on error undo, return error return-value
     3312     :
     3313       if p-action = ?
     3314       then do:
     3315         if v-diasize-need-maximize = true
     3316         then do:
     3317           assign
     3318             p-action = true
     3319           .
     3320         end.
     3321         else do:
     3322           assign
     3323             p-action = false
     3324           .
     3325         end.
     3326       end.
     3327       if p-action = true
     3328       then do:
     3329         run diasize_change-height in this-procedure
     3330           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3331               - frame Dialog-Frame :height-chars
     3332           ,input true
     3333           ) .
     3334         run diasize_change-width in this-procedure
     3335           (input session :width-chars
     3336               - frame Dialog-Frame :width-chars
     3337           ,input true
     3338           ) .
     3339         assign
     3340           v-diasize-need-maximize = false
     3341         .
     3342       end.
     3343       else do:
     3344         run diasize_change-width in this-procedure
     3345           (input v-diasize-orig-frame-width
     3346               - frame Dialog-Frame :width-chars
     3347           ,input true
     3348           ) .
     3349         run diasize_change-height in this-procedure
     3350           (input v-diasize-orig-frame-height
     3351               - frame Dialog-Frame :height-chars
     3352           ,input true
     3353           ) .
     3354         assign
     3355           v-diasize-need-maximize = true
     3356         .
     3357       end.
     3358     end.
     3359   end procedure.
     3360   procedure diasize_restore-orig-size :
     3361     do
     3362     on error undo, return error return-value
     3363     :
     3364       assign
     3365         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3366         v-diasize-current-frame-height = frame Dialog-Frame :height
     3367       .
     3368       run diasize_set-height in this-procedure
     3369         (input  v-diasize-orig-frame-height
     3370         ,input  true
     3371         ) .
     3372       run diasize_set-width in this-procedure
     3373         (input  v-diasize-orig-frame-width
     3374         ,input  true
     3375         ) .
     3376     end.
     3377   end procedure.
     3378   procedure diasize_restore-current-size :
     3379     do
     3380     on error undo, return error return-value
     3381     :
     3382       run diasize_set-height in this-procedure
     3383         (input  v-diasize-current-frame-height
     3384         ,input  true
     3385         ) .
     3386       run diasize_set-width in this-procedure
     3387         (input  v-diasize-current-frame-width
     3388         ,input  true
     3389         ) .
     3390     end.
     3391   end procedure.
     3392   procedure diasize_set-browse-handle :
     3393     define input  parameter p-browse-handle as handle   no-undo .
     3394     define buffer buf_temp-browse-handle for temp-browse-handle .
     3395     do
     3396     on error undo, return error return-value
     3397     :
     3398       assign
     3399         v-diasize-browse-handle = p-browse-handle
     3400       .
     3401       for each buf_temp-browse-handle
     3402       on error undo, return error return-value
     3403       :
     3404         delete buf_temp-browse-handle .
     3405       end.
     3406     end.
     3407   end procedure.
     3408   procedure diasize_add_browse :
     3409     define input  parameter p-browse-type   as character no-undo .
     3410     define input  parameter p-browse-handle as handle    no-undo .
     3411     define buffer buf_temp-browse-handle for temp-browse-handle .
     3412     do
     3413     on error undo, return error return-value
     3414     :
     3415       assign
     3416         v-diasize-browse-number = v-diasize-browse-number + 1
     3417       .
     3418       create buf_temp-browse-handle .
     3419       assign
     3420         buf_temp-browse-handle.browse-type   = p-browse-type
     3421         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3422         buf_temp-browse-handle.browse-handle = p-browse-handle
     3423       .
     3424     end.
     3425   end procedure.
     3426   procedure diasize_init :
     3427     define variable v-default-value    as logical   no-undo .
     3428     define variable v-restore-saved    as logical   no-undo .
     3429     define variable v-resize-value-str as character no-undo .
     3430     do
     3431     on error undo, return error return-value
     3432     :
     3433       do with frame Dialog-Frame
     3434       :
     3435         assign
     3436           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3437           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3438           v-diasize-browse-handle     = browse br-gds-act :handle
     3439         .
     3440         create button v-diasize-resize-button
     3441         assign
     3442           parent        = frame Dialog-Frame :first-child
     3443           label         = "s"
     3444           height-pixels = 16
     3445           width-pixels  = 16
     3446           visible       = true
     3447           sensitive     = true
     3448           movable       = true
     3449           triggers:
     3450             on end-move persistent run diasize_end-move in this-procedure .
     3451           end triggers.
     3452         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3453         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3454         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3455         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3456         assign
     3457           v-diasize-wndmax = false
     3458         .
     3459         if connected("ub") = true
     3460         then do:
     3461           define variable v-cntxt-db-num        as integer   no-undo .
     3462           define variable v-cntxt-userid        as character no-undo .
     3463           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3464                                             , OUTPUT v-cntxt-userid
     3465                                             ) .
     3466           run gbl/wndpar_r.p
     3467             (input  v-cntxt-db-num
     3468             ,input  v-cntxt-userid
     3469             ,input  'wndmax':U
     3470             ,output v-diasize-wndmax
     3471             ,output v-default-value
     3472             ) .
     3473         end.
     3474         assign
     3475           v-diasize-wndstore = false
     3476         .
     3477         if connected("ub") = true
     3478         then do:
     3479           run gbl/wndpar_r.p
     3480             (input  v-cntxt-db-num
     3481             ,input  v-cntxt-userid
     3482             ,input  'wndstore':U
     3483             ,output v-diasize-wndstore
     3484             ,output v-default-value
     3485             ) .
     3486         end.
     3487         assign
     3488           v-diasize-proc-name = entry(1, program-name(2), '.')
     3489         .
     3490         if v-diasize-wndstore = true
     3491         then do:
     3492           assign
     3493             v-restore-saved = false
     3494           .
     3495           if connected("ub") = true
     3496           then do:
     3497             run gbl/wndsizer.p
     3498               (input  v-cntxt-db-num
     3499               ,input  v-cntxt-userid
     3500               ,input  v-diasize-proc-name
     3501               ,input  'height':u
     3502               ,output v-resize-value-str
     3503               ) .
     3504             if v-resize-value-str <> '':U
     3505             then do:
     3506               run diasize_change-height in this-procedure
     3507                 (input  integer(v-resize-value-str)
     3508                 ,input  true
     3509                 ) .
     3510               assign
     3511                 v-restore-saved = true
     3512               .
     3513             end.
     3514           end.
     3515           if connected("ub") = true
     3516           then do:
     3517             run gbl/wndsizer.p
     3518               (input  v-cntxt-db-num
     3519               ,input  v-cntxt-userid
     3520               ,input  v-diasize-proc-name
     3521               ,input  'width':u
     3522               ,output v-resize-value-str
     3523               ) .
     3524             if v-resize-value-str <> '':U
     3525             then do:
     3526               run diasize_change-width in this-procedure
     3527                 (input  integer(v-resize-value-str)
     3528                 ,input  true
     3529                 ) .
     3530               assign
     3531                 v-restore-saved = true
     3532               .
     3533             end.
     3534           end.
     3535           if v-restore-saved <> true
     3536           then do:
     3537             if v-diasize-wndmax = true
     3538             then do:
     3539               run diasize_maximize in this-procedure
     3540                 (input  true
     3541                 ) .
     3542             end.
     3543           end.
     3544         end.
     3545         else do:
     3546           if v-diasize-wndmax = true
     3547           then do:
     3548             run diasize_maximize in this-procedure
     3549               (input  true
     3550               ) .
     3551           end.
     3552         end.
     3553       end.
     3554     end.
     3555   end procedure.
     3556   procedure diasize_need-full-display :
     3557     define output parameter p-need-full-display as logical   no-undo .
     3558     do
     3559     on error undo, return error return-value
     3560     :
     3561       assign
     3562         p-need-full-display = v-diasize-need-full-display
     3563       .
     3564       assign
     3565         v-diasize-need-full-display = false
     3566       .
     3567     end.
     3568   end procedure.
     3569   procedure get-context :
     3570      define output parameter p-db-num as integer          no-undo.
     3571      define output parameter p-user-id as character        no-undo.
     3572      define variable v-login               as character    no-undo.
     3573      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3574      define buffer buf_user-login  for ub.user-login .
     3575      do
     3576      on error undo, return error
     3577      :
     3578            FIND FIRST buf_sys-ctrl no-lock.
     3579            ASSIGN
     3580               v-login = USERID("ub")
     3581               p-db-num = buf_sys-ctrl.db-num
     3582            .
     3583            FIND FIRST buf_user-login
     3584                 WHERE buf_user-login.db-num = p-db-num
     3585                   AND buf_user-login.user-login = v-login
     3586                 no-lock
     3587                 no-error
     3588                 .
     3589            IF AVAILABLE buf_user-login
     3590            THEN DO:
     3591               assign
     3592                  p-user-id = buf_user-login.user-id
     3593               .
     3594            END.
     3595      end.
     3596   end procedure.
     3597       run diasize_init in this-procedure .
     3598       RUN enable_UI.
     3599       WAIT-FOR GO OF FRAME Dialog-Frame.
     3600   END.
     3601   RUN disable_UI.
     3602   PROCEDURE proc-b-mark :
     3603     define variable varlog as logical   no-undo .
     3604     if not available tt-gds-act then return.
     3605     run local-mark in this-procedure.
     3606     assign varlog = br-gds-act :select-next-row( ) in frame Dialog-Frame.
     3607     apply "ENTRY":U to br-gds-act in frame Dialog-Frame.
     3608     br-gds-act:refresh() in frame Dialog-Frame .
     3609   END PROCEDURE.
     3610   PROCEDURE local-mark :
     3611     if not available tt-gds-act then do:
     3612       message "Неправильный выбор строки.".
     3613       return no-apply.
     3614     end.
     3615   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3616   define variable v-str-recid15 as character no-undo .
     3617   define variable v-num-entry15 as integer   no-undo .
     3618   assign
     3619     v-str-recid15 = trim( string( recid( tt-gds-act ) , "->>>>>>>>>>>9":U ) )
     3620     v-num-entry15 = lookup( v-str-recid15 , select-list )
     3621   .
     3622   if v-num-entry15 > 0 then do:
     3623     assign
     3624       entry( v-num-entry15, select-list ) = "":U
     3625       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     3626     .
     3627   end.
     3628   else do:
     3629     assign
     3630       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid15
     3631     .
     3632   end.
     3633     br-gds-act:refresh() in frame Dialog-Frame .
     3634   END PROCEDURE.
     3635   PROCEDURE disable_UI :
     3636     HIDE FRAME Dialog-Frame.
     3637   END PROCEDURE.
     3638   PROCEDURE enable_UI :
     3639     ENABLE b-cancel  b-save br-gds-act b-del b-print
     3640         WITH FRAME Dialog-Frame.
     3641     VIEW FRAME Dialog-Frame.
     3642       if p-mode = 'ПРОСМОТР':U then do :
     3643           disable  tt-act-header.num tt-act-header.date_ with frame Dialog-Frame.
     3644           define variable hCol as handle no-undo .
     3645           define variable hBr  as handle no-undo .
     3646           define variable i    as integer no-undo .
     3647           hBr = browse br-gds-act:handle .
     3648           hBr:add-like-column('tt-gds-act.mark', 0, 'FILL-IN') .
     3649           hBr:get-browse-column (4):width-chars = 10.
     3650           hBr:get-browse-column (5):width-chars = 80.
     3651           do i = 2 to 5 :
     3652               hCol = hBr:GET-BROWSE-COLUMN(i).
     3653               hCol:read-only = true .
     3654           end.
     3655           hide b-add b-save b-del in FRAME Dialog-Frame.
     3656       end.
     3657       else hide b-print in FRAME Dialog-Frame.
     3658   END PROCEDURE.
