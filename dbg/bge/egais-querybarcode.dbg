        1   using ibs.th.bge.egais.*.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-mode       as character no-undo .
        4   define input parameter egais        as class QueryBarcode no-undo .
        5   define input parameter v-ext-sys    as integer no-undo .
        6   define input parameter v-fs-rar     as character no-undo .
        7   define input parameter bh-act-header  as handle no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "ЕГАИС Акт передачи продукции в магазин".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable ii                  as integer no-undo .
      114   define variable jj                  as integer no-undo .
      115   define variable nn                  as integer no-undo .
      116   define variable exts                as integer no-undo .
      117   define variable v-position_         as integer no-undo .
      118   define variable v-date              as character no-undo .
      119   define variable v-rid-list          as character no-undo .
      120   define variable par-alcohol         as character no-undo .
      121   define variable par-egais-name      as character no-undo .
      122   define variable par-type            as character no-undo .
      123   define variable v-attr-value        as character            no-undo .
      124   define variable v-attr-type         as character            no-undo .
      125   define variable err-good            as logical no-undo .
      126   define variable p-ext-rec           as recid no-undo .
      127   define variable glog        as logical no-undo .
      128   define variable cmd            as character no-undo.
      129   define variable src            as character no-undo.
      130   define variable path           as character no-undo.
      131   define variable v-obj-uniq-key-rec as character no-undo .
      132   define variable qh-gds-act          as handle no-undo .
      133   define variable bh-gds-act          as handle no-undo .
      134   define variable brh-gds-act         as handle no-undo .
      135   define variable v-gds-uniq-key-rec as character no-undo .
      136   define variable v-part-num    as integer   no-undo .
      137   define variable v-clob-db-num as integer   no-undo .
      138   define variable v-int64-id    as int64     no-undo .
      139   define variable v-info        as character no-undo .
      140   define variable v-longchar      as memptr no-undo .
      141   define buffer buf_goods         for ub.goods .
      142   define buffer buf_parts         for ub.parts .
      143   define buffer buf_trn-doc       for ub.trn-doc .
      144   define buffer buf_doc-line      for ub.doc-line .
      145   define buffer x_ext-classif     for ub.ext-classif .
      146   define buffer x_ext-classif-attr     for ub.ext-classif-attr .
      147   define buffer buf_clob-bind     for ub.clob-bind .
      148   define buffer buf_clob-data     for ub.clob-data .
      149   define stream str-log .
      150   define new global shared variable g#language as character no-undo .
      151   if g#language <> '' and g#language <> 'rus':U then do:
      152     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      153   end.
      154   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      155   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      156   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      157   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      158   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      159   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      160   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      161   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      162   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      163   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      164   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      165   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      166   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      167   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      168   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      169   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      170   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      171   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      172   define new global shared variable g#library  as handle no-undo .
      173   define new global shared variable g#library2 as handle no-undo .
      174   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      175     define variable v-cntxt-db-num        as integer   no-undo .
      176     define variable v-cntxt-userid        as character no-undo .
      177     define variable v-cntxt-level         as character no-undo .
      178     define variable v-cntxt-host-code-obj as integer   no-undo .
      179     define variable v-cntxt-obj-type      as character no-undo .
      180     define variable v-cntxt-obj-code      as integer   no-undo .
      181     define variable v-cntxt-db-num-obj    as integer   no-undo .
      182     define variable v-cntxt-is-admin      as logical   no-undo .
      183   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      184     run mainmenu_getcntxt in parparentproc
      185       (output v-cntxt-db-num
      186       ,output v-cntxt-userid
      187       ,output v-cntxt-level
      188       ,output v-cntxt-host-code-obj
      189       ,output v-cntxt-obj-type
      190       ,output v-cntxt-obj-code
      191       ,output v-cntxt-db-num-obj
      192       ,output v-cntxt-is-admin
      193       ) .
      194   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      195   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      196   procedure gen-key-rec :
      197     define input  parameter p-tbl-name    as character no-undo.
      198     define input  parameter p-bh_tbl-name as handle    no-undo.
      199     define output parameter p-key-rec     as character no-undo.
      200     do
      201     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      202     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      203     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      204     :
      205       define variable fh               as handle    no-undo .
      206       define variable v-ok             as logical   no-undo .
      207       define variable v-inform         as character no-undo .
      208       define variable v-ind            as integer   no-undo .
      209       define variable v-idx-field-qnty as integer   no-undo .
      210       if p-tbl-name = ?
      211         or p-tbl-name = "":U
      212       then do:
      213         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      214       end.
      215       if not p-bh_tbl-name:available then do:
      216         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      217       end.
      218       assign
      219         p-key-rec = p-tbl-name
      220         v-inform  = p-bh_tbl-name:index-information(1)
      221         v-ind     = 2
      222       .
      223       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      224       on error undo, return error
      225       :
      226         assign
      227           v-inform = p-bh_tbl-name:index-information( v-ind )
      228           v-ind    = v-ind + 1
      229         .
      230       end.
      231       if v-inform = ?
      232         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      233         or entry( 3, v-inform, ",":U ) <> "1":U
      234       then do:
      235         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      236       end.
      237       else do:
      238         assign
      239           v-idx-field-qnty = num-entries( v-inform ) - 4
      240         .
      241         if v-idx-field-qnty < 2 then do:
      242           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      243         end.
      244         do v-ind = 1 to v-idx-field-qnty by 2
      245         on error undo, return error
      246         :
      247           assign
      248             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      249             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      250           .
      251         end.
      252       end.
      253       if p-key-rec = ? then do:
      254         assign
      255           p-key-rec = "":U
      256         .
      257         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      258       end.
      259     end.
      260     return.
      261   end procedure.
      262   procedure gen-where-keyr-tab :
      263     define input  parameter i-tableSerach as character no-undo.
      264     define input  parameter i-tablekey   as character  no-undo.
      265     define input  parameter p-key-rec    as character  no-undo.
      266     define input  parameter p-key-handle as handle     no-undo .
      267     define input  parameter p-db-name    as character  no-undo .
      268     define input  parameter p-tt-handle  as handle     no-undo .
      269     define output parameter o-Where      as character  no-undo.
      270     do
      271     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      272     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      273     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      274     :
      275       define variable v-full-tbl-name  as character no-undo .
      276       define variable bh_tbl-name      as handle    no-undo .
      277       define variable fh_key           as handle    no-undo .
      278       define variable fh_search        as handle    no-undo .
      279       define variable v-field-num      as integer   no-undo .
      280       define variable v-count-fld      as integer   no-undo .
      281       define variable v-inform         as character no-undo .
      282       define variable v-ind            as integer   no-undo .
      283       define variable v-idx-field-qnty as integer   no-undo .
      284       define variable v-field-name     as character no-undo .
      285       define variable v-field-val      as character no-undo .
      286       define variable v-word-link      as character no-undo .
      287       define variable vTable           as character no-undo.
      288       define variable bh_tbl-key       as handle    no-undo .
      289       assign
      290         p-key-rec = trim( p-key-rec )
      291       .
      292       if p-key-handle <> ? then do:
      293         if not valid-handle(p-key-handle)
      294            or p-key-handle:type <> "buffer"
      295         then do:
      296           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      297         end.
      298         if num-entries( p-key-rec, chr(3) ) > 1
      299           or p-key-rec = ?
      300           or p-key-rec = "":U
      301         then do:
      302           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      303         end.
      304       end.
      305       else do:
      306         if p-key-rec = ?
      307           or p-key-rec = "":U
      308         then do:
      309           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      310         end.
      311       end.
      312       assign
      313         vTable = entry( 1 , p-key-rec, chr(3) )
      314       .
      315       if p-tt-handle <> ?
      316         and ( not valid-handle(p-tt-handle)
      317               or p-tt-handle:type <> "buffer"
      318             )
      319       then do:
      320         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      321       end.
      322       if p-tt-handle = ? then do:
      323         assign
      324           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      325         .
      326         create buffer bh_tbl-name for table v-full-tbl-name .
      327       end.
      328       else do:
      329         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      330       end.
      331       assign
      332         v-inform = bh_tbl-name:index-information(1)
      333         v-ind    = 2
      334       .
      335       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      336       on error undo, return error
      337       :
      338         assign
      339           v-inform = bh_tbl-name:index-information( v-ind )
      340           v-ind    = v-ind + 1
      341         .
      342       end.
      343       if v-inform = ?
      344         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      345         or entry( 3, v-inform, ",":U ) <> "1":U
      346       then do:
      347         delete object bh_tbl-name no-error.
      348         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      349       end.
      350       assign
      351         v-idx-field-qnty = num-entries( v-inform ) - 4
      352       .
      353       if v-idx-field-qnty < 2 then do:
      354         delete object bh_tbl-name no-error.
      355         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      356       end.
      357       assign
      358         o-where     = "where":U
      359         v-word-link = "":U
      360         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      361         v-count-fld = 0
      362       .
      363       if i-tablekey ne "" and i-tablekey ne ?
      364       then do:
      365         assign
      366           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      367         .
      368         create buffer bh_tbl-key for table v-full-tbl-name .
      369       end.
      370       if i-tableSerach ne "" and i-tableSerach ne ?
      371       then do:
      372         delete object bh_tbl-name no-error.
      373         assign
      374           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      375         .
      376         create buffer bh_tbl-name for table v-full-tbl-name .
      377       end.
      378       block_where:
      379       do v-ind = 1 to v-idx-field-qnty by 2
      380       on error undo, return error
      381       :
      382         assign
      383           v-count-fld = v-count-fld + 1
      384         .
      385         if p-key-handle = ?
      386           and v-count-fld > v-field-num
      387         then do:
      388           leave block_where.
      389         end.
      390         define variable VfieldKeyTable as handle no-undo.
      391         assign
      392           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      393           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      394         .
      395         if     bh_tbl-key ne ?
      396         then do:
      397            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      398            if VfieldKeyTable eq ?
      399            then next block_where.
      400         end.
      401         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      402         then
      403            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      404         else
      405            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      406         if p-key-handle = ? then do:
      407           assign
      408             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      409           .
      410         end.
      411         else do:
      412           assign
      413             fh_key = p-key-handle:buffer-field( v-field-name )
      414           .
      415           if fh_key = ?
      416             or not valid-handle( fh_key )
      417           then do:
      418             delete object bh_tbl-name.
      419             if     bh_tbl-key ne ?
      420             then
      421                delete object bh_tbl-key.
      422             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      423           end.
      424           assign
      425             v-field-val = fh_key:buffer-value
      426           .
      427         end.
      428         if fh_search:data-type ="character":U then do:
      429           assign
      430             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      431             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      432             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      433             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      434             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      435             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      436             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      437             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      438             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      439             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      440             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      441             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      442             v-field-val = substitute( '"&1"', v-field-val )
      443           .
      444         end.
      445         assign
      446           o-where = substitute( "&1 &2", o-where, v-field-val )
      447         .
      448         if v-word-link = "":U then do:
      449           assign
      450             v-word-link = "and":U
      451           .
      452         end.
      453       end.
      454       delete object bh_tbl-name.
      455       if     bh_tbl-key ne ?
      456       then
      457          delete object bh_tbl-key.
      458       if p-key-handle = ?
      459         and v-count-fld <> v-field-num
      460       then do:
      461         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      462       end.
      463     end.
      464   end procedure.
      465   procedure gen-hn-keyr-tab :
      466     define input  parameter i-tableSerach as character no-undo.
      467     define input  parameter i-tablekey   as character no-undo.
      468     define input  parameter p-key-rec    as character no-undo.
      469     define input  parameter p-key-handle as handle    no-undo .
      470     define input  parameter p-db-name    as character no-undo .
      471     define input  parameter p-tt-handle  as handle    no-undo .
      472     define input  parameter p-stts-lock  as integer   no-undo .
      473     define output parameter o-hn         as handle    no-undo.
      474     define variable v-full-tbl-name as character no-undo.
      475     define variable v-where         as character no-undo.
      476     define variable bh_tbl-name     as handle    no-undo.
      477     define variable vTable          as character no-undo.
      478     do
      479     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      480     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      481     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      482         run gen-where-keyr-tab(i-tableSerach,
      483                                i-tablekey,
      484                                p-key-rec,
      485                                p-key-handle,
      486                                p-db-name,
      487                                p-tt-handle,
      488                                output v-where).
      489         if i-tableSerach ne "" and i-tableSerach ne ?
      490         then do:
      491            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      492            create buffer bh_tbl-name for table v-full-tbl-name .
      493         end.
      494         else do:
      495            if p-tt-handle = ? then do:
      496               assign
      497                  vTable = entry( 1 , p-key-rec, chr(3) )
      498               .
      499               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      500               create buffer bh_tbl-name for table v-full-tbl-name .
      501            end.
      502            else do:
      503               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      504            end.
      505         end.
      506         if p-tt-handle = ? then do:
      507            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      508         end.
      509         else do:
      510            bh_tbl-name:find-first( v-where ) no-error .
      511         end.
      512         o-hn = bh_tbl-name.
      513      end.
      514   end procedure.
      515   procedure gen-hn-keyr :
      516     define input  parameter p-key-rec    as character no-undo.
      517     define input  parameter p-key-handle as handle    no-undo .
      518     define input  parameter p-db-name    as character no-undo .
      519     define input  parameter p-tt-handle  as handle    no-undo .
      520     define input  parameter p-stts-lock  as integer   no-undo .
      521     define output parameter o-hn         as handle    no-undo.
      522     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      523   end.
      524   procedure gen-row-keyr :
      525     define input  parameter p-key-rec    as character no-undo.
      526     define input  parameter p-key-handle as handle    no-undo .
      527     define input  parameter p-db-name    as character no-undo .
      528     define input  parameter p-tt-handle  as handle    no-undo .
      529     define input  parameter p-stts-lock  as integer   no-undo .
      530     define output parameter p-tbl-row    as rowid     no-undo.
      531     define output parameter p-tbl-name   as character no-undo.
      532     define variable vHn as handle no-undo.
      533       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      534       p-tbl-row = if vHn:available then vHn:rowid else ?.
      535       p-tbl-name =  vHn:table.
      536       delete object vHn no-error.
      537     if p-tbl-row = ? then do:
      538       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      539     end.
      540     else do:
      541       return.
      542     end.
      543   end procedure.
      544   procedure gen-key-fv :
      545     define input  parameter p-key-rec    as character no-undo .
      546     define output parameter p-field-list as character no-undo .
      547     define output parameter p-value-list as character no-undo.
      548     do
      549     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      550     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      551     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      552     :
      553       define variable v-full-tbl-name  as character no-undo .
      554       define variable bh_tbl-name      as handle    no-undo .
      555       define variable v-tbl-name       as character no-undo .
      556       define variable v-field-num      as integer   no-undo .
      557       define variable v-count-fld      as integer   no-undo .
      558       define variable v-inform         as character no-undo .
      559       define variable v-ind            as integer   no-undo .
      560       define variable v-idx-field-qnty as integer   no-undo .
      561       define variable v-delim-key      as character no-undo .
      562       if p-key-rec = ?
      563         or p-key-rec = "":U
      564       then do:
      565         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      566       end.
      567       assign
      568         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      569         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      570       .
      571       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      572       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
      573       assign
      574         v-inform = bh_tbl-name:index-information(1)
      575         v-ind    = 2
      576       .
      577       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      578       on error undo, return error
      579       :
      580         assign
      581           v-inform = bh_tbl-name:index-information( v-ind )
      582           v-ind    = v-ind + 1
      583         .
      584       end.
      585       if v-inform = ?
      586         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      587         or entry( 3, v-inform, ",":U ) <> "1":U
      588       then do:
      589         delete object bh_tbl-name no-error.
      590         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      591       end.
      592       assign
      593         v-idx-field-qnty = num-entries( v-inform ) - 4
      594       .
      595       if v-idx-field-qnty < 2 then do:
      596         delete object bh_tbl-name no-error.
      597         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      598       end.
      599       assign
      600         p-field-list = "":U
      601         p-value-list = "":U
      602         v-delim-key  = "":U
      603         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      604         v-count-fld  = 0
      605       .
      606       block_where:
      607       do v-ind = 1 to v-idx-field-qnty by 2
      608       on error undo, return error
      609       :
      610         assign
      611           v-count-fld = v-count-fld + 1
      612         .
      613         if v-count-fld > v-field-num then do:
      614           leave block_where.
      615         end.
      616         assign
      617           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      618           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      619         .
      620         if v-ind = 1 then do:
      621           assign
      622             v-delim-key = chr(3)
      623           .
      624         end.
      625       end.
      626       delete object bh_tbl-name.
      627       if v-count-fld <> v-field-num then do:
      628         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      629       end.
      630     end.
      631   end procedure.
      632   procedure gen-key-field :
      633     define input  parameter p-table      as character no-undo .
      634     define output parameter p-field-list as character no-undo .
      635     do
      636     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      637     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      638     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      639     :
      640       define variable v-full-tbl-name  as character no-undo .
      641       define variable bh_tbl-name      as handle    no-undo .
      642       define variable v-tbl-name       as character no-undo .
      643       define variable v-field-num      as integer   no-undo .
      644       define variable v-count-fld      as integer   no-undo .
      645       define variable v-inform         as character no-undo .
      646       define variable v-ind            as integer   no-undo .
      647       define variable v-idx-field-qnty as integer   no-undo .
      648       define variable v-delim-key      as character no-undo .
      649       if p-table = ?
      650         or p-table = "":U
      651       then do:
      652         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
      653       end.
      654       assign
      655         v-tbl-name      = p-table
      656         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      657       .
      658       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      659       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
      660       assign
      661         v-inform = bh_tbl-name:index-information(1)
      662         v-ind    = 2
      663       .
      664       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      665       on error undo, return error
      666       :
      667         assign
      668           v-inform = bh_tbl-name:index-information( v-ind )
      669           v-ind    = v-ind + 1
      670         .
      671       end.
      672       if v-inform = ?
      673         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      674         or entry( 3, v-inform, ",":U ) <> "1":U
      675       then do:
      676         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      677       end.
      678       assign
      679         v-idx-field-qnty = num-entries( v-inform ) - 4
      680       .
      681       if v-idx-field-qnty < 2 then do:
      682         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      683       end.
      684       assign
      685         p-field-list = "":U
      686         v-delim-key  = "":U
      687         v-count-fld  = 0
      688       .
      689       block_where:
      690       do v-ind = 1 to v-idx-field-qnty by 2
      691       on error undo, return error
      692       :
      693         assign
      694           v-count-fld = v-count-fld + 1
      695         .
      696         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      697         if v-ind = 1 then do:
      698           assign
      699             v-delim-key = chr(3)
      700           .
      701         end.
      702       end.
      703       delete object bh_tbl-name.
      704     end.
      705   end procedure.
      706   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      707   define new global shared variable g#attr-lib  as handle no-undo .
      708   define variable v-attr-lib-variable as handle no-undo .
      709   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      710   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      711   procedure thbjattr_code :
      712      define input  parameter p-upper-code     as character no-undo .
      713      define input  parameter p-code           as character no-undo .
      714      define output parameter p-label          as character no-undo .
      715      define output parameter p-user-can-edit  as logical   no-undo .
      716      define output parameter p-output-display as logical   no-undo .
      717      define output parameter p-other          as character no-undo .
      718      define output parameter p-prop-list      as character no-undo .
      719      define output parameter p-prop-type-list as character no-undo .
      720      define output parameter p-prop-label-list as character no-undo .
      721      define output parameter p-global          as logical no-undo .
      722      define output parameter p-host           as logical no-undo .
      723      define output parameter p-shop           as logical no-undo .
      724      define output parameter p-store          as logical no-undo .
      725      define output parameter p-db             as logical no-undo .
      726      define variable p-region as logical no-undo.
      727      run thbjattr_code_reg in this-procedure (
      728                                               p-upper-code,
      729                                               p-code,
      730                                               output p-label,
      731                                               output p-user-can-edit,
      732                                               output p-output-display,
      733                                               output p-other,
      734                                               output p-prop-list,
      735                                               output p-prop-type-list,
      736                                               output p-prop-label-list,
      737                                               output p-global,
      738                                               output p-host,
      739                                               output p-shop,
      740                                               output p-store,
      741                                               output p-db,
      742                                               output p-region
      743                                               ).
      744   end procedure.
      745   procedure thbjattr_code_reg :
      746   define input  parameter p-upper-code     as character no-undo .
      747   define input  parameter p-code           as character no-undo .
      748   define output parameter p-label          as character no-undo .
      749   define output parameter p-user-can-edit  as logical   no-undo .
      750   define output parameter p-output-display as logical   no-undo .
      751   define output parameter p-other          as character no-undo .
      752   define output parameter p-prop-list      as character no-undo .
      753   define output parameter p-prop-type-list as character no-undo .
      754   define output parameter p-prop-label-list as character no-undo .
      755   define output parameter p-global          as logical no-undo .
      756   define output parameter p-host           as logical no-undo .
      757   define output parameter p-shop           as logical no-undo .
      758   define output parameter p-store          as logical no-undo .
      759   define output parameter p-db             as logical no-undo .
      760   define output parameter p-region         as logical no-undo .
      761   do
      762   on error undo, return error return-value
      763   :
      764       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      765       (input  p-upper-code
      766       ,input  p-code
      767       ,output p-label
      768       ,output p-user-can-edit
      769       ,output p-output-display
      770       ,output p-other
      771       ,output p-prop-list
      772       ,output p-prop-type-list
      773       ,output p-prop-label-list
      774       ,output p-global
      775       ,output p-host
      776       ,output p-shop
      777       ,output p-store
      778       ,output p-db
      779       ,output p-region
      780       ) no-error .
      781     if error-status :error
      782     then do:
      783       undo, return error substitute( "&1. &2&3&4", vss-include-info5, return-value, chr(10), error-status :get-message (1)).
      784     end.
      785   end.
      786   end procedure.
      787   procedure thbjattr_tooltip :
