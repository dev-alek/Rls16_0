       97   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   define  temp-table temp-host no-undo
       99     field host-code like ub.store.host-code
      100     index xpk host-code
      101   .
      102   define  temp-table temp-obj no-undo
      103     field obj-type  like ub.clients.obj-type
      104     field obj-code  like ub.clients.obj-code
      105     field host-code like ub.store.host-code
      106     field db-num    like ub.clients.db-num
      107     index xpk  obj-type obj-code
      108     index xie1 host-code
      109     index xie2 db-num host-code
      110   .
      111   procedure init-temphost:
      112     define buffer buf_store   for ub.store .
      113     define buffer buf_shop    for ub.shop .
      114     define buffer buf_clients for ub.clients .
      115     define buffer buf_db for ub.db .
      116     define buffer buf_temp-host for temp-host .
      117     define buffer buf_temp-obj for temp-obj .
      118     do
      119     on error undo, return error return-value
      120     :
      121       for each buf_store
      122       on error undo, return error
      123       :
      124         find first buf_temp-host
      125           where buf_temp-host.host-code = buf_store.host-code
      126           no-error .
      127         if not available buf_temp-host
      128         then do:
      129           create buf_temp-host .
      130           assign
      131             buf_temp-host.host-code = buf_store.host-code
      132           .
      133         end.
      134         find first buf_clients no-lock
      135           where buf_clients.obj-type = 'скл':U
      136             and buf_clients.obj-code = buf_store.obj-code
      137           no-error .
      138         if not available buf_clients
      139         then do:
      140           message
      141             "Ошибка при поиске клиента" skip
      142             "Клиент" 'скл':U buf_store.obj-code skip
      143             view-as alert-box error .
      144           undo, return error .
      145         end.
      146         create buf_temp-obj .
      147         assign
      148           buf_temp-obj.obj-type  = 'скл':U
      149           buf_temp-obj.obj-code  = buf_store.obj-code
      150           buf_temp-obj.host-code = buf_store.host-code
      151           buf_temp-obj.db-num    = buf_clients.db-num
      152         .
      153       end.
      154       for each buf_shop
      155       on error undo, return error
      156       :
      157         find first buf_temp-host
      158           where buf_temp-host.host-code = buf_shop.host-code
      159           no-error .
      160         if not available buf_temp-host
      161         then do:
      162           create buf_temp-host .
      163           assign
      164             buf_temp-host.host-code = buf_shop.host-code
      165           .
      166         end.
      167         find first buf_clients no-lock
      168           where buf_clients.obj-type = 'маг':U
      169             and buf_clients.obj-code = buf_shop.obj-code
      170           no-error .
      171         if not available buf_clients then do:
      172           message
      173             "Ошибка при поиске клиента" skip
      174             "Клиент" 'маг':U buf_shop.obj-code skip
      175             view-as alert-box error .
      176           undo, return error .
      177         end.
      178         create buf_temp-obj .
      179         assign
      180           buf_temp-obj.obj-type  = 'маг':U
      181           buf_temp-obj.obj-code  = buf_shop.obj-code
      182           buf_temp-obj.host-code = buf_shop.host-code
      183           buf_temp-obj.db-num    = buf_clients.db-num
      184         .
      185       end.
      186     end.
      187   end.
      188   define variable vss-include-info1 as character format "X(65)" no-undo
      189   initial "@(#)$Workfile$ $Revision$".
      190   DEF STREAM stmXMLOut.
