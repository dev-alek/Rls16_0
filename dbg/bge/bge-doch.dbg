      192   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      193   procedure cur-time :
      194      define output parameter p-today as date      no-undo .
      195      define output parameter p-time  as integer   no-undo .
      196     do
      197     on error undo, return error
      198     :
      199       define variable v-date1 as date      no-undo .
      200       define variable v-date2 as date      no-undo .
      201       define variable v-time  as integer   no-undo .
      202       assign
      203         v-date1 = today
      204         v-time  = time
      205         v-date2 = today
      206       .
      207       if v-date1 <> v-date2
      208       then do:
      209         assign
      210           v-date1 = today
      211           v-time  = v-time
      212         .
      213       end.
      214       assign
      215         p-today = v-date1
      216         p-time  = v-time
      217       .
      218     end.
      219   end.
      220   function cur-time-date returns character
      221   :
      222     return string(today, '99/99/9999':U) .
      223   end.
      224   function cur-time-mjd returns decimal
      225   :
      226     define variable v-date as date      no-undo .
      227     define variable v-time as integer   no-undo .
      228     run cur-time in this-procedure
      229       (output v-date
      230       ,output v-time
      231       ) .
      232     return integer(v-date) - 2400002 + (v-time / 86400) .
      233   end.
      234   function cur-time-get-ending-index returns integer
      235   (input p-number as integer
      236   )
      237   :
      238     if p-number < 0
      239     or p-number = ?
      240     then do:
      241       return 1 .
      242     end.
      243     define variable v-rest as integer   no-undo .
      244     assign
      245       p-number = p-number modulo 100
      246     .
      247     if p-number < 20
      248     then do:
      249       assign
      250         v-rest = p-number
      251       .
      252     end.
      253     else do:
      254       assign
      255         v-rest = p-number modulo 10
      256       .
      257     end.
      258     case v-rest :
      259       when 1
      260       then do:
      261         return 2 .
      262       end.
      263       when 2 or
      264       when 3 or
      265       when 4
      266       then do:
      267         return 3 .
      268       end.
      269       otherwise do:
      270         return 1 .
      271       end.
      272     end case .
      273   end.
      274   procedure cur-time-mjd-to-date :
      275      define input  parameter i-mjd-diff as decimal no-undo.
      276      define output parameter o-Date     as date    no-undo.
      277      define output parameter o-Time     as integer no-undo.
      278      define variable v-day-number as integer   no-undo .
      279      if    i-mjd-diff < 0
      280         or i-mjd-diff = ?
      281      then do:
      282         return "?" .
      283      end.
      284      assign
      285         v-day-number = truncate(i-mjd-diff,0).
      286         o-Date = date(v-day-number + 2400002).
      287         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      288     .
      289   end.
      290   function cur-time-mjd-to-string returns character
      291   (input p-mjd-diff as decimal
      292   )
      293   :
      294     define variable v-day-number as integer   no-undo .
      295     define variable v-seconds    as integer   no-undo .
      296     define variable v-hour       as integer   no-undo .
      297     define variable v-min        as integer   no-undo .
      298     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      299     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      300     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      301     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      302     if p-mjd-diff < 0
      303     or p-mjd-diff = ?
      304     then do:
      305       return "?" .
      306     end.
      307     assign
      308       v-day-number = integer(truncate(p-mjd-diff,0))
      309       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      310     .
      311     if v-seconds > 86400
      312     then do:
      313       assign
      314         v-seconds = 86400 - 1
      315       .
      316     end.
      317     if v-seconds < 0
      318     then do:
      319       assign
      320         v-seconds = 0
      321       .
      322     end.
      323     assign
      324       v-hour = truncate(v-seconds / 3600, 0)
      325     .
      326     assign
      327       v-seconds = v-seconds modulo 3600
      328     .
      329     assign
      330       v-min = truncate(v-seconds / 60, 0)
      331     .
      332     assign
      333       v-seconds = v-seconds modulo 60
      334     .
      335     return
      336         (if v-day-number <> 0
      337           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      338           else ""
      339         )
      340       + (if v-day-number <> 0 or v-hour <> 0
      341           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      342           else ""
      343         )
      344       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      345           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      346           else ""
      347         )
      348       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      349       .
      350   end.
      351   function cur-time-string returns character
      352   :
      353     define variable v-date as date      no-undo .
      354     define variable v-time as integer   no-undo .
      355     run cur-time in this-procedure
      356       (output v-date
      357       ,output v-time
      358       ) .
      359     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      360   end.
      361   function cur-time-string-sec returns character
      362   :
      363     define variable v-date as date      no-undo .
      364     define variable v-time as integer   no-undo .
      365     run cur-time in this-procedure
      366       (output v-date
      367       ,output v-time
      368       ) .
      369     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      370   end.
      371   function cur-time-custom  returns character
      372   (input p-prefix as character
      373   ,input p-date-format as character
      374   ,input p-delimiter as character
      375   ,input p-time-format as character
      376   ,input p-suffix as character
      377   )
      378   :
      379     define variable v-date as date      no-undo .
      380     define variable v-time as integer   no-undo .
      381     run cur-time in this-procedure
      382       (output v-date
      383       ,output v-time
      384       ) .
      385     return
      386       p-prefix
      387       + string(v-date, p-date-format)
      388       + p-delimiter
      389       + string(v-time, p-time-format)
      390       + p-suffix
      391       .
      392   end.
      393   function cur-time-print  returns character
      394   :
      395     define variable v-date as date      no-undo .
      396     define variable v-time as integer   no-undo .
      397     run cur-time in this-procedure
      398       (output v-date
      399       ,output v-time
      400       ) .
      401     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      402   end.
      403   function cur-time-datetime returns datetime
      404   :
      405     define variable v-char as character no-undo .
      406     define variable v-datetime as datetime no-undo .
      407     v-char = cur-time-string().
      408     v-datetime = datetime(v-char).
      409     return  v-datetime.
      410   end.
      411   function cur-time-string-msec returns character
      412   :
      413     define variable v-date as datetime  no-undo .
      414     v-date = now.
      415     return string(v-date) .
      416   end.
      417   define variable vss-include-info3 as character format "X(65)" no-undo
      418   initial "@(#)$Workfile$ $Revision$".
      419   procedure xmlchar-test :
      420   define input parameter p-in-string          as character        no-undo.
      421   define output parameter p-out-string-enc    as character        no-undo.
      422   define output parameter p-out-string-dec    as character        no-undo.
      423   do
      424   on error undo, return error
      425   :
      426          run xmlchar-encode in this-procedure
      427       (
      428             input p-in-string
      429           , output p-out-string-enc
      430       ).
      431          run xmlchar-decode in this-procedure
      432       (
      433             input p-out-string-enc
      434           , output p-out-string-dec
      435       ).
      436   end.
      437   end .
      438   procedure xmlchar-encode :
      439   define input parameter p-in-string      as character        no-undo.
      440   define output parameter p-out-string    as character        no-undo.
      441       define variable v-position      as integer      no-undo.
      442       define variable v-current-char  as character    no-undo.
      443   do
      444   on error undo, return error
      445   :
      446       assign
      447           p-out-string = "":U
      448       .
      449       case p-in-string
      450       :
      451           when ?
      452           then do:
      453               assign
      454                   p-out-string = "?":U
      455               .
      456           end.
      457           when "?":U
      458           then do:
      459               assign
      460                   p-out-string = "&#63;":U
      461               .
      462           end.
      463           otherwise do:
      464               do v-position = 1 to length( p-in-string )
      465               :
      466                   assign
      467                       v-current-char = substring( p-in-string, v-position, 1 )
      468                   .
      469                   case v-current-char
      470                   :
      471                       when "&":U
      472                       then do:
      473                           assign
      474                               p-out-string = p-out-string + "&amp;":U
      475                           .
      476                       end.
      477                       when ">":U
      478                       then do:
      479                           assign
      480                               p-out-string = p-out-string + "&gt;":U
      481                           .
      482                       end.
      483                       when "<":U
      484                       then do:
      485                           assign
      486                               p-out-string = p-out-string + "&lt;":U
      487                           .
      488                       end.
      489                       when "'":U
      490                       then do:
      491                           assign
      492                               p-out-string = p-out-string + "&apos;":U
      493                           .
      494                       end.
      495                       when '"':U
      496                       then do:
      497                           assign
      498                               p-out-string = p-out-string + "&quot;":U
      499                           .
      500                       end.
      501                       when chr(1)
      502                       then do:
      503                           assign
      504                               p-out-string = p-out-string + "":U
      505                           .
      506                       end.
      507                       when chr(2)
      508                       then do:
      509                           assign
      510                               p-out-string = p-out-string + "":U
      511                           .
      512                       end.
      513                       when chr(3)
      514                       then do:
      515                           assign
      516                               p-out-string = p-out-string + "":U
      517                           .
      518                       end.
      519                       when chr(4)
      520                       then do:
      521                           assign
      522                               p-out-string = p-out-string + "":U
      523                           .
      524                       end.
      525                       when chr(5)
      526                       then do:
      527                           assign
      528                               p-out-string = p-out-string + "":U
      529                           .
      530                       end.
      531                       when chr(6)
      532                       then do:
      533                           assign
      534                               p-out-string = p-out-string + "":U
      535                           .
      536                       end.
      537                       when chr(7)
      538                       then do:
      539                           assign
      540                               p-out-string = p-out-string + "":U
      541                           .
      542                       end.
      543                       when chr(8)
      544                       then do:
      545                           assign
      546                               p-out-string = p-out-string + "":U
      547                           .
      548                       end.
      549                       when chr(9)
      550                       then do:
      551                           assign
      552                               p-out-string = p-out-string + "":U
      553                           .
      554                       end.
      555                       when chr(29)
      556                       then do:
      557                           assign
      558                               p-out-string = p-out-string + "":U
      559                           .
      560                       end.
      561                       when chr(10)
      562                       then do:
      563                           assign
      564                               p-out-string = p-out-string + "&#10;":U
      565                           .
      566                       end.
      567                       when chr(13)
      568                       then do:
      569                           assign
      570                               p-out-string = p-out-string + "&#13;":U
      571                           .
      572                       end.
      573                       otherwise do:
      574                           assign
      575                               p-out-string = p-out-string + v-current-char
      576                           .
      577                       end.
      578                   end case.
      579               end.
      580           end.
      581       end case.
      582   end.
      583   end .
      584   procedure xmlchar-encode-1c :
      585   define input parameter p-in-string      as character        no-undo.
      586   define output parameter p-out-string    as character        no-undo.
      587       define variable v-position      as integer      no-undo.
      588       define variable v-current-char  as character    no-undo.
      589   do
      590   on error undo, return error
      591   :
      592       assign
      593           p-out-string = "":U
      594       .
      595       case p-in-string
      596       :
      597           when ?
      598           then do:
      599               assign
      600                   p-out-string = "?":U
      601               .
      602           end.
      603           otherwise do:
      604               do v-position = 1 to length( p-in-string )
      605               :
      606                   assign
      607                       v-current-char = substring( p-in-string, v-position, 1 )
      608                   .
      609                   case v-current-char
      610                   :
      611                       when chr(1)
      612                       then do:
      613                           assign
      614                               p-out-string = p-out-string + " ":U
      615                           .
      616                       end.
      617                       when chr(2)
      618                       then do:
      619                           assign
      620                               p-out-string = p-out-string + " ":U
      621                           .
      622                       end.
      623                       when chr(3)
      624                       then do:
      625                           assign
      626                               p-out-string = p-out-string + " ":U
      627                           .
      628                       end.
      629                       when chr(4)
      630                       then do:
      631                           assign
      632                               p-out-string = p-out-string + " ":U
      633                           .
      634                       end.
      635                       when chr(5)
      636                       then do:
      637                           assign
      638                               p-out-string = p-out-string + " ":U
      639                           .
      640                       end.
      641                       when chr(6)
      642                       then do:
      643                           assign
      644                               p-out-string = p-out-string + " ":U
      645                           .
      646                       end.
      647                       when chr(7)
      648                       then do:
      649                           assign
      650                               p-out-string = p-out-string + " ":U
      651                           .
      652                       end.
      653                       when chr(8)
      654                       then do:
      655                           assign
      656                               p-out-string = p-out-string + " ":U
      657                           .
      658                       end.
      659                       when chr(9)
      660                       then do:
      661                           assign
      662                               p-out-string = p-out-string + " ":U
      663                           .
      664                       end.
      665                       when chr(29)
      666                       then do:
      667                           assign
      668                               p-out-string = p-out-string + " ":U
      669                           .
      670                       end.
      671                       when chr(10)
      672                       then do:
      673                           assign
      674                               p-out-string = p-out-string + " ":U
      675                           .
      676                       end.
      677                       when chr(13)
      678                       then do:
      679                           assign
      680                               p-out-string = p-out-string + " ":U
      681                           .
      682                       end.
      683                       otherwise do:
      684                           assign
      685                               p-out-string = p-out-string + v-current-char
      686                           .
      687                       end.
      688                   end case.
      689               end.
      690           end.
      691       end case.
      692   end.
      693   end .
      694   procedure xmlchar-decode :
      695   define input parameter p-in-string      as character        no-undo.
      696   define output parameter p-out-string    as character        no-undo.
      697       define variable v-position      as integer      no-undo.
      698       define variable v-last-position as integer      no-undo.
      699       define variable v-temp-integer  as integer      no-undo.
      700       define variable v-current-char  as character    no-undo.
      701       define variable v-next-char     as character    no-undo.
      702       define variable v-success       as logical      no-undo.
      703   do
      704   on error undo, return error
      705   :
      706       assign
      707           p-out-string = "":U
      708           v-position   = 0
      709       .
      710       replace-cycle:
      711       do while yes
      712       on error undo, return error
      713       :
      714           assign
      715               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      716           .
      717           if v-last-position <= v-position
      718           then do:
      719               if v-position = 0
      720               then do:
      721                   assign
      722                       p-out-string = p-in-string
      723                   .
      724               end.
      725               else do:
      726                   assign
      727                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      728                   .
      729               end.
      730               leave replace-cycle.
      731           end.
      732           else do:
      733               assign
      734                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      735                   v-position      = v-last-position
      736                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      737               .
      738               if v-current-char = "#":U
      739               then do:
      740                   assign
      741                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      742                   .
      743                   if v-last-position > 0
      744                   then do:
      745                       run xmlchar-read-integer in this-procedure
      746                        (
      747                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      748                           , output v-temp-integer
      749                           , output v-success
      750                       ).
      751                       if v-success = yes
      752                       and v-temp-integer >= 1
      753                       and v-temp-integer <= 255
      754                       then do:
      755                           assign
      756                               p-out-string = p-out-string + chr( v-temp-integer )
      757                               v-position   = v-last-position + 1
      758                           .
      759                       end.
      760                       else do:
      761                           assign
      762                               p-out-string = p-out-string + "&":U
      763                               v-position   = v-position   + 1
      764                           .
      765                       end.
      766                   end.
      767                   else do:
      768                       assign
      769                           p-out-string = p-out-string + "&":U
      770                           v-position   = v-position   + 1
      771                       .
      772                   end.
      773               end.
      774               else do:
      775                   case substring( p-in-string, v-position + 1, 3 )
      776                   :
      777                       when "lt;":U
      778                       then do:
      779                           assign
      780                               p-out-string = p-out-string + "<":U
      781                               v-position   = v-position   + 3
      782                           .
      783                       end.
      784                       when "gt;":U
      785                       then do:
      786                           assign
      787                               p-out-string = p-out-string + ">":U
      788                               v-position   = v-position   + 3
      789                           .
      790                       end.
      791                       otherwise do:
      792                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      793                           then do:
      794                               assign
      795                                   p-out-string = p-out-string + "&":U
      796                                   v-position   = v-position   + 4
      797                               .
      798                           end.
      799                           else do:
      800                               case substring( p-in-string, v-position + 1, 5 )
      801                               :
      802                                   when "quot;":U
      803                                   then do:
      804                                       assign
      805                                           p-out-string = p-out-string + '"':U
      806                                           v-position   = v-position   + 5
      807                                       .
      808                                   end.
      809                                   when "apos;":U
      810                                   then do:
      811                                       assign
      812                                           p-out-string = p-out-string + "'":U
      813                                           v-position   = v-position   + 5
      814                                       .
      815                                   end.
      816                                   otherwise do:
      817                                       assign
      818                                           p-out-string = p-out-string + "&":U
      819                                       .
      820                                   end.
      821                               end case.
      822                           end.
      823                       end.
      824                   end case.
      825               end.
      826           end.
      827       end.
      828   end.
      829   end .
      830   procedure xmlchar-read-integer :
      831   define input parameter p-input-string      as character        no-undo.
      832   define output parameter p-output-integer   as integer          no-undo.
      833   define output parameter p-success       as logical          no-undo.
      834   do
      835   on error undo, return error
      836   :
      837       assign
      838           p-output-integer = integer( p-input-string )
      839       no-error.
      840       if error-status :error
      841       then do:
      842           assign
      843               p-success           = no
      844               p-output-integer    = 0
      845           .
      846       end.
      847       else do:
      848           assign
      849               p-success           = yes
      850           .
      851       end.
      852   end.
      853   end.
      854   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      855   procedure strtdate :
      856     define input  parameter p-str         as character no-undo .
      857     define output parameter p-value       as date      no-undo .
      858     define output parameter p-data-valid  as logical   no-undo .
      859     define output parameter p-message     as character no-undo .
      860   do
      861   on error undo, return error return-value
      862   :
      863     define variable v-value       as date      no-undo .
      864     define variable v-i           as integer   no-undo .
      865     define variable v-num         as integer   no-undo .
      866     define variable v-delim       as character no-undo .
      867     define variable v-delim-list  as character no-undo .
      868     define variable v-day         as integer   no-undo .
      869     define variable v-month       as integer   no-undo .
      870     define variable v-year        as integer   no-undo .
      871     define variable v-day-str     as character no-undo .
      872     define variable v-month-str   as character no-undo .
      873     define variable v-year-str    as character no-undo .
      874     assign
      875       p-value       = ?
      876       p-data-valid  = false
      877     .
      878     if p-str = ?
      879     then do:
      880       assign
      881         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      882       .
      883       return .
      884     end.
      885     if p-str = ""
      886     then do:
      887       assign
      888         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      889       .
      890       return .
      891     end.
      892     if length(p-str)  > 10
      893     then do:
      894       assign
      895         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      896       .
      897       return .
      898     end.
      899     assign
      900       v-delim-list = '/,-,.':U
      901     .
      902     _delim:
      903     do v-i = 1 to num-entries( v-delim-list )
      904     :
      905       assign
      906         v-delim = entry( v-i , v-delim-list )
      907         v-num   = num-entries( p-str , v-delim )
      908       .
      909       if v-num <> 3
      910       then do:
      911         assign
      912           v-delim = ''
      913         .
      914       end.
      915       else do:
      916         leave _delim.
      917       end.
      918     end.
      919     if v-delim = ''
      920     then do:
      921       assign
      922         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      923       .
      924       return .
      925     end.
      926     assign
      927       v-day-str   = entry( 1, p-str , v-delim)
      928       v-month-str = entry( 2, p-str , v-delim)
      929       v-year-str  = entry( 3, p-str , v-delim)
      930     .
      931     if  length(v-day-str) > 2   or
      932         length(v-day-str) < 1   or
      933         length(v-month-str) > 2 or
      934         length(v-month-str) < 1 or
      935         (
      936           length(v-year-str) <> 2 and
      937           length(v-year-str) <> 4
      938         )
      939     then do:
      940       assign
      941         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      942       .
      943       return .
      944     end.
      945     if length( v-year-str ) = 2
      946     then do:
      947       assign
      948         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      949       .
      950     end.
      951     assign
      952       v-day   = integer( v-day-str )
      953       v-month = integer( v-month-str)
      954       v-year  = integer( v-year-str)
      955     no-error .
      956     if error-status :error
      957     then do:
      958       assign
      959         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      960       .
      961       return .
      962     end.
      963     if v-day < 1  or
      964        v-day > 31 or
      965        v-month < 1 or
      966        v-month > 12 or
      967        v-year < 0   or
      968        v-year > 5000
      969     then do:
      970       assign
      971         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      972       .
      973       return .
      974     end.
      975     assign
      976       v-value = date( v-month, v-day, v-year )
      977     no-error .
      978     if error-status :error
      979     then do:
      980       assign
      981         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      982       .
      983       return .
      984     end.
      985     assign
      986       p-value       = v-value
      987       p-data-valid  = true
      988     .
      989   end.
      990   end procedure.
