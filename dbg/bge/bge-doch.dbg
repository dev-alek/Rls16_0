     2724   procedure day-begin-fact-order :
     2725     define input  parameter p-fact-date            as date    no-undo .
     2726     define output parameter p-day-begin-fact-order as decimal no-undo .
     2727     do
     2728     on error undo, return error return-value
     2729     :
     2730       if p-fact-date = ?
     2731       then do:
     2732         assign
     2733           p-day-begin-fact-order = 0
     2734         .
     2735       end.
     2736       else do:
     2737         assign
     2738           p-day-begin-fact-order = integer(p-fact-date)
     2739         .
     2740       end.
     2741     end.
     2742   end procedure.
