     3192       run wp-XMLWriteLog in this-procedure (
     3193             input v-log-file-name
     3194           , input 1
     3195           , input substitute( "................с параметрами: ... список объектов: &1", p-obj-list )
     3196       ).
     3197       run wp-XMLWriteLog in this-procedure (
     3198             input v-log-file-name
     3199           , input 1
     3200           , input substitute( "................с параметрами: ... типы документов: &1", p-doc-type-list )
     3201       ).
     3202       run wp-XMLWriteLog in this-procedure (
     3203             input v-log-file-name
     3204           , input 1
     3205           , input substitute( "................с параметрами: ... надо ли виды платежей: &1, ГТД: &2, партии: &3, типы кассовых платежей: &4, кассы: &5, преф.карт: &6, удал.документы: &7, незакр.документы: &8"
     3206                                                         , p-pay-code
     3207                                                         , p-cst
     3208                                                         , p-parts
     3209                                                         , p-chk-pay-code
     3210                                                         , p-pay-desk
     3211                                                         , p-pay-desk-cards
     3212                                                         , p-deleted
     3213                                                         , p-opened-docs )
     3214       ).
     3215       object-of-list:
     3216       for each temp-obj
     3217       :
     3218           run export-docs-by-object (
     3219                 input temp-obj.host-code
     3220               , input temp-obj.obj-type
     3221               , input temp-obj.obj-code
     3222               , input v-out-dir
     3223               , input v-log-file-name
     3224           ) no-error.
     3225           if error-status :error
     3226           then do:
     3227               message
     3228               vss-workfile vss-revision vss-description
     3229               skip "Ошибка экспорта документов по объекту"
     3230               skip "Тип объекта:" temp-obj.obj-type
     3231               skip "Код объекта:" temp-obj.obj-code
     3232               skip return-value
     3233               skip trim(error-status :get-message(1))
     3234                   trim(error-status :get-message(2))
     3235                   trim(error-status :get-message(3))
     3236                   trim(error-status :get-message(4))
     3237                   trim(error-status :get-message(5))
     3238               view-as alert-box error.
     3239               next object-of-list.
     3240           end.
     3241           run cb-fill_bge-xml_clients in this-procedure (
     3242                 input temp-obj.obj-type
     3243               , input temp-obj.obj-code
     3244           ).
     3245       end.
     3246       run bge/cat-firm.p (
     3247             input "list":U
     3248           , input v-cntxt-host-code-obj
     3249           , input table temp_bge-xml_clients
     3250           , ""
     3251       ).
     3252       run bge/cat-good.p (
     3253             input "good-ext,list":U
     3254           , input table temp_bge-xml_goods
     3255           , ""
     3256       ).
     3257       run wp-XMLWriteLog in this-procedure (
     3258             input v-log-file-name
     3259           , input 1
     3260           , input substitute( "Данные выгружены в каталог &1"
     3261                                   , v-out-dir
     3262                             )
     3263       ).
     3264       run wp-XMLWriteLog in this-procedure (
     3265             input v-log-file-name
     3266           , input 1
     3267           , input "&DLine"
     3268       ).
     3269   end.
     3270   procedure export-docs-by-object :
     3271   define input parameter p-host-code      as integer          no-undo.
     3272   define input parameter p-obj-type       as character        no-undo.
     3273   define input parameter p-obj-code       as integer          no-undo.
     3274   define input parameter p-out-dir        as character        no-undo.
     3275   define input parameter p-log-file-name  as character        no-undo.
     3276       define variable v-xml-file-name     as character    no-undo.
     3277       define variable v-prefix            as character    no-undo.
     3278       define variable v-locked            as logical      no-undo.
     3279       define variable v-fact-order-from   as decimal      no-undo.
     3280       define variable v-fact-order-to     as decimal      no-undo.
     3281       define variable v-docs-exists       as logical      no-undo.
     3282       define variable v-oper-num          as integer      no-undo.
     3283       define variable v-date-from-decimal as decimal      no-undo.
     3284       define variable v-date-to-decimal   as decimal      no-undo.
     3285       define variable v-date-decimal      as decimal      no-undo.
     3286       define variable v-archive-ok        as logical      no-undo.
     3287       define variable v-comment           as character    no-undo.
     3288       define variable v-date-from         as date         no-undo.
     3289       define variable v-date-to           as date         no-undo.
     3290       define buffer buf_shift-obj     for ub.shift-obj.
     3291   do
     3292   for buf_shift-obj
     3293   on error undo, return error
     3294   :
     3295       run wp-XMLWriteEDT( hEDT, 1, string( p-obj-type ) + " " + string( p-obj-code ) ).
     3296       run wp-XMLWriteEDT( hEDT, 4,  "Расчет архивов").
     3297       run bge/bge-ahz.p (
     3298             input parparentproc
     3299           , input p-obj-type
     3300           , input p-obj-code
     3301           , input yes
     3302           , input yes
     3303           , input no
     3304           , input p-date-from
     3305           , input p-date-to
     3306           , output v-archive-ok
     3307           , output v-comment
     3308       ) no-error.
     3309       if error-status :error
     3310       then do:
     3311           message
     3312           vss-workfile vss-revision vss-description
     3313           skip "Ошибка проверки архивов на объекте."
     3314           skip "Тип объекта:" p-obj-type
     3315           skip "Код объекта:" p-obj-code
     3316           skip return-value
     3317           skip trim(error-status :get-message(1))
     3318               trim(error-status :get-message(2))
     3319               trim(error-status :get-message(3))
     3320           view-as alert-box error.
     3321           undo, return error .
     3322       end.
     3323       if v-archive-ok = no
     3324       then do:
     3325           run wp-XMLWriteLog in this-procedure (
     3326                 input v-log-file-name
     3327               , input 1
     3328               , input substitute( "*** Документы по объекту &1 &2 в интервале дат &3 - &4 не будут выгружены. Архивы по объекту в заданном интервале дат не целостные. &5."
     3329                                       , p-obj-type
     3330                                       , p-obj-code
     3331                                       , p-date-from
     3332                                       , p-date-to
     3333                                       , v-comment       )
     3334           ).
     3335           undo, return error .
     3336       end.
     3337       process events.
     3338       export-shifts:
     3339       for each buf_shift-obj no-lock
     3340          where buf_shift-obj.obj-type     = p-obj-type
     3341            and buf_shift-obj.obj-code     = p-obj-code
     3342            and buf_shift-obj.shift-date   >= p-date-from
     3343            and buf_shift-obj.shift-date   <= p-date-to
     3344       :
     3345           run bge-xml-get-decimal-shift-num in this-procedure (
     3346                 input p-date-from
     3347               , input p-shift-num-from
     3348               , output v-date-from-decimal
     3349           ).
     3350           run bge-xml-get-decimal-shift-num in this-procedure (
     3351                 input p-date-to
     3352               , input p-shift-num-to
     3353               , output v-date-to-decimal
     3354           ).
     3355           run bge-xml-get-decimal-shift-num in this-procedure (
     3356                 input buf_shift-obj.shift-date
     3357               , input buf_shift-obj.shift-num
     3358               , output v-date-decimal
     3359           ).
     3360           if v-date-decimal >= v-date-from-decimal
     3361           and v-date-decimal <= v-date-to-decimal
     3362           then do:
     3363   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnam in g#lib-trn3
     3364     (
     3365        input buf_shift-obj.obj-type
     3366     ,  input buf_shift-obj.obj-code
     3367     ,  input buf_shift-obj.shift-date
     3368     ,  input buf_shift-obj.shift-num
     3369     , output v-shift-name-to
     3370     , output v-shift-name-num-to
     3371     )        no-error .
     3372               run wp-XMLWriteEDT(
     3373                     input hEDT
     3374                   , input 6
     3375                   , input substitute( "Смена: N &1 за &2 ...", v-shift-name-num-to, buf_shift-obj.shift-date  )
     3376               ).
     3377               assign
     3378                   v-prefix = substitute( "d_&1&2&3&4&5&6_"
     3379                                           , substring( string( year( buf_shift-obj.shift-date ), "9999":U ), 3, 2 )
     3380                                           , string( month( buf_shift-obj.shift-date ), "99":U )
     3381                                           , string( day( buf_shift-obj.shift-date ), "99":U )
     3382                                           , string( buf_shift-obj.shift-num, "99":U )
     3383                                           , string( trim( buf_shift-obj.obj-type ), "X(3)":U )
     3384                                           , string( buf_shift-obj.obj-code, "99999":U )
     3385                                           )
     3386               .
     3387               run bge-xml-out-file in this-procedure (
     3388                     input p-out-dir
     3389                   , input v-prefix
     3390                   , input no
     3391                   , output v-xml-file-name
     3392                   , output v-locked
     3393               ).
     3394               if v-locked = yes
     3395               then do:
     3396                   run wp-XMLWriteLog in this-procedure (
     3397                         input p-log-file-name
     3398                       , input 1
     3399                       , input "*** Ошибка выгрузки: Файл выгрузки заблокирован другим процессом."
     3400                   ).
     3401                   undo, return error .
     3402               end.
     3403               run bge-xml-write-header in this-procedure (
     3404                     input v-xml-file-name
     3405                   , input v-xml-file-name + "xml"
     3406                   , input "15.0 " + replace( vss-revision + vss-date, "$", " " )
     3407                   , input 0
     3408                   , input p-date-from
     3409                   , input p-shift-num-from
     3410                   , input p-date-to
     3411                   , input p-shift-num-to
     3412                   , input p-obj-list
     3413                   , input p-doc-type-list
     3414                   , input p-pay-code
     3415                   , input p-cst
     3416                   , input p-parts
     3417                   , input p-chk-pay-code
     3418                   , input p-pay-desk
     3419                   , input p-pay-desk-cards
     3420                   , input p-deleted
     3421                   , input p-opened-docs
     3422               ).
     3423               run rep/getfosht.p (
     3424                     input p-obj-type
     3425                   , input p-obj-code
     3426                   , input buf_shift-obj.shift-date
     3427                   , input buf_shift-obj.shift-num
     3428                   , output v-fact-order-from
     3429                   , output v-fact-order-to
     3430                   , output v-docs-exists
     3431               ).
     3432               if v-docs-exists = yes
     3433               then do:
     3434                   run wp-XMLShowCNT(hCNT).
     3435                   for each temp_ext-doc-type
     3436                   :
     3437                       if lookup( temp_ext-doc-type.ext-doc-type, p-doc-type-list ) <> 0
     3438                       or p-doc-type-list = "":U
     3439                       then do:
     3440                           if v-fact-order-from = 0 then do:
     3441                             assign
     3442                             v-date-from = 01/01/1990.
     3443                           end.
     3444                           else do:
     3445                             run factord-to-date in this-procedure ( input v-fact-order-from
     3446                                                                   , output v-date-from
     3447                                                                   ) .
     3448                           end.
     3449                           if v-fact-order-to = 0 then do:
     3450                             assign
     3451                             v-date-to = 01/01/1990.
     3452                           end.
     3453                           else do:
     3454                             run factord-to-date in this-procedure ( input v-fact-order-to
     3455                                                                   , output v-date-to
     3456                                                                   ) .
     3457                           end.
     3458                           run bge/doc-oper.p (
     3459                                 input p-host-code
     3460                               , input p-obj-type
     3461                               , input p-obj-code
     3462                               , input temp_ext-doc-type.ext-doc-type
     3463                               , input temp_ext-doc-type.ext-doc-type-label
     3464                               , input v-fact-order-from
     3465                               , input v-fact-order-to
     3466                               , input v-date-from
     3467                               , input v-date-to
     3468                               , input p-pay-code
     3469                               , input p-cst
     3470                               , input p-parts
     3471                               , input p-chk-pay-code
     3472                               , input p-pay-desk
     3473                               , input p-pay-desk-cards
     3474                               , input p-chk
     3475                               , input p-doc-rvs
     3476                               , input v-xml-file-name
     3477                               , input p-log-file-name
     3478                               , input this-procedure
     3479                               , input hEDT
     3480                               , input hCNT
     3481                           ) no-error.
     3482                           if error-status :error
     3483                           then do:
     3484                               run wp-XMLWriteEDT( hEDT, 1, substitute( "&1. &2. &3."
     3485                                                       , return-value
     3486                                                       , trim(error-status :get-message(1))
     3487                                                       , trim(error-status :get-message(2))
     3488                                                       )  ).
     3489                           end.
     3490                       end.
     3491                   end.
     3492                   run wp-XMLHideCNT(hCNT).
     3493               end.
     3494               if p-deleted = yes
     3495               then do:
     3496                   run bge/doc-delh.p (
     3497                         input p-obj-type
     3498                       , input p-obj-code
     3499                       , input buf_shift-obj.shift-date
     3500                       , input buf_shift-obj.shift-num
     3501                       , input v-xml-file-name
     3502                       , input p-log-file-name
     3503                       , input hEDT
     3504                       , input hCNT
     3505                   ) no-error.
     3506                   if error-status :error
     3507                   then do:
     3508                       run wp-XMLWriteEDT(
     3509                             input hEDT
     3510                           , input 1
     3511                           , input substitute( "&1. &2. &3."
     3512                                               , return-value
     3513                                               , trim(error-status :get-message(1))
     3514                                               , trim(error-status :get-message(2))
     3515                                               )  ).
     3516                   end.
     3517               end.
     3518               run xml-bge-write-footer in this-procedure ( input v-xml-file-name ).
     3519   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnam in g#lib-trn3
     3520     (
     3521        input buf_shift-obj.obj-type
     3522     ,  input buf_shift-obj.obj-code
     3523     ,  input buf_shift-obj.shift-date
     3524     ,  input buf_shift-obj.shift-num
     3525     , output v-shift-name-to
     3526     , output v-shift-name-num-to
     3527     )        no-error .
     3528               run wp-XMLWriteEDT(
     3529                     input hEDT
     3530                   , input 6
     3531                   , input substitute( "Смена: N &1 за &2 выгружена.", v-shift-name-num-to, buf_shift-obj.shift-date  )
     3532               ).
     3533           end.
     3534       end.
     3535       process events.
     3536   end.
     3537   end procedure.
     3538   procedure cb-fill_bge-xml_goods :
     3539   define input parameter p-gds-code   as integer          no-undo.
     3540   do
     3541   on error undo, return error
     3542   :
     3543       find first temp_bge-xml_goods
     3544            where temp_bge-xml_goods.gds-code = p-gds-code
     3545       no-error.
     3546       if not available temp_bge-xml_goods
     3547       then do:
     3548           create temp_bge-xml_goods.
     3549           assign
     3550               temp_bge-xml_goods.gds-code = p-gds-code
     3551           .
     3552       end.
     3553   end.
     3554   end procedure.
     3555   procedure cb-fill_bge-xml_clients :
     3556   define input parameter p-obj-type   as character        no-undo.
     3557   define input parameter p-obj-code   as integer          no-undo.
     3558       define buffer buf_temp_bge-xml_clients      for temp_bge-xml_clients.
     3559   do
     3560   for buf_temp_bge-xml_clients
     3561   on error undo, return error
     3562   :
     3563       find first buf_temp_bge-xml_clients
     3564            where buf_temp_bge-xml_clients.obj-type = p-obj-type
     3565              and buf_temp_bge-xml_clients.obj-code = p-obj-code
     3566       no-error.
     3567       if not available buf_temp_bge-xml_clients
     3568       then do:
     3569           create buf_temp_bge-xml_clients.
     3570           assign
     3571               buf_temp_bge-xml_clients.obj-type = p-obj-type
     3572               buf_temp_bge-xml_clients.obj-code = p-obj-code
     3573           .
     3574       end.
     3575   end.
     3576   end procedure.
