     2754   procedure factord-cut-archive :
     2755     define input  parameter p-obj-type             as character no-undo .
     2756     define input  parameter p-obj-code             as integer   no-undo .
     2757     define input  parameter p-fact-date            as date      no-undo .
     2758     define output parameter p-shift-on             as logical   no-undo .
     2759     define output parameter p-shift-date           as date      no-undo .
     2760     define output parameter p-shift-num            as integer   no-undo .
     2761     define output parameter p-day-end-fact-order   as decimal   no-undo .
     2762     define output parameter p-shift-end-fact-order as decimal   no-undo .
     2763     define variable v-fact-order as decimal   no-undo .
     2764     define buffer buf_shift-obj for ub.shift-obj .
     2765     do
     2766     on error undo, return error return-value
     2767     :
     2768   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2769   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2770     (input  p-obj-type
     2771     ,input  p-obj-code
     2772     ,input  'shift-on=request'
     2773     ,output p-shift-on
     2774     ) no-error .
     2775       if error-status :error
     2776       then do:
     2777         message
     2778           vss-workfile vss-revision vss-description skip
     2779           "Ошибка при определении атрибута объекта" skip
     2780           "Объект" p-obj-type p-obj-code skip
     2781           error-status :get-message(1) skip
     2782           return-value skip
     2783           view-as alert-box error .
     2784         undo, return error return-value .
     2785       end.
     2786       if p-shift-on = false
     2787       then do:
     2788         assign
     2789           p-shift-date               = ?
     2790           p-shift-num                = 0
     2791         .
     2792       end.
     2793       else do:
     2794         find first buf_shift-obj share-lock
     2795           where buf_shift-obj.obj-type   = p-obj-type
     2796             and buf_shift-obj.obj-code   = p-obj-code
     2797             and buf_shift-obj.shift-date > p-fact-date
     2798           use-index pi
     2799           no-error .
     2800         if not available buf_shift-obj
     2801         or buf_shift-obj.status_ <> 'зкр':U
     2802         then do:
     2803           message
     2804             vss-workfile vss-revision vss-description skip
     2805             "Невозможно вычислить последнюю смену" skip
     2806             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2807             "Объект" p-obj-type p-obj-code skip
     2808             "Дата" p-fact-date skip
     2809             view-as alert-box error .
     2810           undo, return error return-value .
     2811         end.
     2812         find last buf_shift-obj share-lock
     2813           where buf_shift-obj.obj-type = p-obj-type
     2814             and buf_shift-obj.obj-code = p-obj-code
     2815             and buf_shift-obj.shift-date <= p-fact-date
     2816           use-index pi
     2817           no-error .
     2818         if available buf_shift-obj
     2819         then do:
     2820           if  buf_shift-obj.status_ = 'зкр':U
     2821           then do:
     2822             assign
     2823               p-shift-date = buf_shift-obj.shift-date
     2824               p-shift-num  = buf_shift-obj.shift-num
     2825             .
     2826           end.
     2827           else do:
     2828             message
     2829               vss-workfile vss-revision vss-description skip
     2830               "Невозможно вычислить последнюю смену" skip
     2831               "Статус смены отличен от статуса" 'зкр':U skip
     2832               "Объект" p-obj-type p-obj-code skip
     2833               "Дата" p-fact-date skip
     2834               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2835               view-as alert-box error .
     2836             undo, return error return-value .
     2837           end.
     2838         end.
     2839         else do:
     2840           assign
     2841             p-shift-date = p-fact-date - 1
     2842             p-shift-num  = 1
     2843           .
     2844         end.
     2845       end.
     2846       run factord in this-procedure
     2847         (input  p-fact-date
     2848         ,input  1
     2849         ,input  1
     2850         ,input  p-shift-date
     2851         ,input  p-shift-num
     2852         ,input  p-shift-on
     2853         ,output v-fact-order
     2854         ,output p-shift-end-fact-order
     2855         ,output p-day-end-fact-order
     2856         ) no-error .
     2857       if error-status :error
     2858       then do:
     2859         message
     2860           vss-workfile vss-revision vss-description skip
     2861           "Ошибка при вызове процедуры factord"
     2862           error-status :get-message(1) skip
     2863           return-value skip
     2864           view-as alert-box error .
     2865         undo, return error return-value .
     2866       end.
     2867     end.
     2868   end procedure.
     2869   procedure factord-lock-shift :
     2870     define input  parameter p-obj-type  as character no-undo .
     2871     define input  parameter p-obj-code  as integer   no-undo .
     2872     define input  parameter p-fact-date as date      no-undo .
     2873     define parameter buffer buf_shift-obj for ub.shift-obj .
     2874     define variable v-shift-on      as logical   no-undo .
     2875     define variable v-extra-message as character no-undo .
     2876     define variable v-error as character no-undo .
     2877     do
     2878     on error undo, return error return-value
     2879     :
     2880   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2881   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2882     (input  p-obj-type
     2883     ,input  p-obj-code
     2884     ,input  'shift-on=request'
     2885     ,output v-shift-on
     2886     ) no-error .
     2887       if error-status :error
     2888       then do:
     2889         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2890         undo, return error v-error .
     2891       end.
     2892       if v-shift-on = true
     2893       then do:
     2894         find first buf_shift-obj share-lock
     2895           where buf_shift-obj.obj-type   = p-obj-type
     2896             and buf_shift-obj.obj-code   = p-obj-code
     2897             and buf_shift-obj.shift-date > p-fact-date
     2898           use-index pi
     2899           no-error .
     2900         if not available buf_shift-obj
     2901         or buf_shift-obj.status_ <> 'зкр':U
     2902         then do:
     2903           find last buf_shift-obj
     2904             where buf_shift-obj.obj-type = p-obj-type
     2905               and buf_shift-obj.obj-code = p-obj-code
     2906               and buf_shift-obj.status_  = 'зкр':U
     2907             use-index stts
     2908             no-error .
     2909           if available buf_shift-obj
     2910           then do:
     2911             assign
     2912               v-extra-message =
     2913                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2914                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2915                               )
     2916             .
     2917           end.
     2918           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2919           undo, return error v-error .
     2920         end.
     2921       end.
     2922     end.
     2923   end procedure.
     2924   procedure factord-end-day :
     2925     define input  parameter p-fact-date            as date    no-undo .
     2926     define output parameter p-day-end-fact-order   as decimal no-undo .
     2927     do
     2928     on error undo, return error return-value
     2929     :
     2930       if p-fact-date = ?
     2931       then do:
     2932         return error "Не указана фактическая дата" .
     2933       end.
     2934       assign
     2935         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2936       .
     2937     end.
     2938   end procedure.
     2939   procedure factord-to-date :
     2940     define input  parameter p-fact-order as decimal no-undo .
     2941     define output parameter p-fact-date  as date    no-undo .
     2942     define variable v-ref-date  as date      no-undo .
     2943     define variable v-ref-delta as integer   no-undo .
     2944     do
     2945     on error undo, return error return-value
     2946     :
     2947       if p-fact-order = ?
     2948       or p-fact-order = 0
     2949       then do:
     2950         return error "Не указан fact-order" .
     2951       end.
     2952       assign
     2953         v-ref-date  = date(1, 1, 2000)
     2954       .
     2955       assign
     2956         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2957       .
     2958       assign
     2959         p-fact-date = v-ref-date + v-ref-delta
     2960       .
     2961     end.
     2962   end procedure.
     2963   procedure factord-to-fact-num :
     2964     define input  parameter p-fact-order as decimal no-undo .
     2965     define output parameter p-fact-num   as integer no-undo .
     2966     define variable v-fact-order-trunc as decimal no-undo .
     2967     do
     2968     on error undo, return error return-value
     2969     :
     2970       if p-fact-order = ?
     2971       or p-fact-order = 0
     2972       then do:
     2973         return error "Не указан fact-order" .
     2974       end.
     2975       assign
     2976        v-fact-order-trunc = truncate(p-fact-order, 2)
     2977       .
     2978       assign
     2979         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2980       .
     2981     end.
     2982   end procedure.
     2983   procedure factord-to-shift-num :
     2984     define input  parameter p-fact-order as decimal no-undo .
     2985     define output parameter p-shift-num   as integer no-undo .
     2986     define variable  p-shift-numd  as decimal   no-undo .
     2987     define variable v-fact-order-trunc as decimal no-undo .
     2988     do
     2989     on error undo, return error return-value
     2990     :
     2991       if p-fact-order = ?
     2992       or p-fact-order = 0
     2993       then do:
     2994         return error "Не указан fact-order" .
     2995       end.
     2996       assign
     2997        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2998       .
     2999       if v-fact-order-trunc < 0.5 then do:
     3000         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     3001       end.
     3002       assign
     3003         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     3004         .
     3005        assign
     3006         p-shift-num = truncate (p-shift-numd , 0)
     3007       .
     3008     end.
     3009   end procedure.
