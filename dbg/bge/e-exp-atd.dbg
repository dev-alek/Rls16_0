     1423   ON CHOOSE OF Btn_Obj IN FRAME Dialog-Frame
     1424   DO:
     1425       define variable v-exclude-obj-list as character no-undo.
     1426       define variable v-user-select      as logical   no-undo.
     1427       define variable v-object-available as logical   no-undo.
     1428       RADIO-SET-Objects:screen-value = "2".
     1429   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1430   run userobjs_clear in this-procedure  .
     1431   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1432   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
     1433     (input  v-cntxt-db-num
     1434     ,input  0
     1435     ,input  v-cntxt-userid
     1436     ,input  v-cntxt-obj-type
     1437     ,input  v-cntxt-obj-code
     1438     ,output v-object-available
     1439     ) no-error .
     1440       if error-status :error then
     1441       do:
     1442           message vss-workfile vss-revision vss-description skip
     1443               "Ошибка при вызове процедуры gbl/usobjava.i" skip
     1444               error-status :get-message(1) skip
     1445               return-value skip
     1446               view-as alert-box error.
     1447           undo, return no-apply.
     1448       end.
     1449       if v-object-available = true then
     1450       do:
     1451   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1452   run userobjs_append in this-procedure
     1453     (input  v-cntxt-obj-type
     1454     ,input  v-cntxt-obj-code
     1455     )  .
     1456       end.
     1457   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1458   run userobjs_select-many in this-procedure
     1459     (input  parparentproc
     1460     ,input  v-cntxt-db-num
     1461     ,input  v-cntxt-userid
     1462     ,input  v-cntxt-host-code-obj
     1463     ,input  v-cntxt-obj-type
     1464     ,input  v-cntxt-obj-code
     1465     ,output v-user-select
     1466     )  .
     1467       if v-user-select <> true then
     1468       do:
     1469           message "Объект не выбран" view-as alert-box information.
     1470           return no-apply.
     1471       end.
     1472       v-obj-list = "".
     1473       EDITOR-obj:screen-value = "".
     1474       for each userobjs_temp-user-obj:
     1475           v-obj-list = v-obj-list + userobjs_temp-user-obj.obj-type + chr(44) +
     1476               string(userobjs_temp-user-obj.obj-code) + chr(4).
     1477           find first buf_clients where buf_clients.obj-code = userobjs_temp-user-obj.obj-code
     1478               and buf_clients.obj-type = userobjs_temp-user-obj.obj-type no-lock no-error.
     1479           EDITOR-obj:screen-value = EDITOR-obj:screen-value +
     1480               (if buf_clients.obj-name <> '' then buf_clients.obj-name
     1481               else userobjs_temp-user-obj.obj-type + string(userobjs_temp-user-obj.obj-code))
     1482               + "," + chr(13).
     1483       end.
     1484   END.
     1485   ON CHOOSE OF Btn_Save IN FRAME Dialog-Frame
     1486   DO:
     1487       assign
     1488           FILL-IN-Dir
     1489           RADIO-SET-Objects
     1490           FILL-IN-sht-from-d
     1491           FILL-IN-sht-from-n
     1492           FILL-IN-sht-to-d
     1493           FILL-IN-sht-to-n
     1494           .
     1495       if FILL-IN-sht-from-d > FILL-IN-sht-to-d
     1496       or (FILL-IN-sht-from-d = FILL-IN-sht-to-d and FILL-IN-sht-from-n > FILL-IN-sht-to-n)
     1497       then do :
     1498           message "Смены выбраны не верно!" view-as alert-box.
     1499           return no-apply .
     1500       end.
     1501       FILL-IN-Dir = right-trim(FILL-IN-Dir,'/\') + '\'.
     1502       file-info:file-name = FILL-IN-Dir.
     1503       if file-info:file-type = ? then
     1504       do:
     1505           message substitute("Директории &1 не существует.",FILL-IN-Dir) skip
     1506               "Создать?" view-as alert-box warning buttons yes-no update dir_crt.
     1507           if dir_crt then
     1508           do:
     1509               os-create-dir value(FILL-IN-Dir).
     1510               if os-error <> 0 then
     1511               do:
     1512                   message substitute("Невозможно создать директорию &1",FILL-IN-Dir) view-as alert-box error.
     1513                   leave.
     1514               end.
     1515           end.
     1516           else leave.
     1517       end.
     1518       else
     1519       do:
     1520           if not (file-info:file-type begins "D":U) then
     1521           do:
     1522               message substitute("&1 не является директорией.",FILL-IN-Dir) view-as alert-box error.
     1523               leave.
     1524           end.
     1525       end.
     1526       v-param-list = FILL-IN-Dir  + chr(4)  +
     1527                      string(RADIO-SET-Objects)  + chr(4)  +
     1528                      p-region .
     1529       run attach-attr-to-schedule-line in this-procedure ( INPUT v-param-list ).
     1530       run schedule-attr-write in this-procedure (input p_cre-db-num,
     1531           input p_task-type,
     1532           input p_task-num,
     1533           input 'schedule-param-list':U,
     1534           input v-param-list).
     1535       run schedule-attr-write in this-procedure (input p_cre-db-num,
     1536           input p_task-type,
     1537           input p_task-num,
     1538           input 'schedule-obj-list':U,
     1539           input v-obj-list).
     1540           message "Параметры сохранены!" view-as alert-box information.
     1541       apply "go".
     1542   END.
     1543   ON CHOOSE OF Btn_sht-from IN FRAME Dialog-Frame
     1544   DO:
     1545       run str/sht-all.w (parparentproc,
     1546           v-cntxt-obj-type,
     1547           v-cntxt-obj-code,
     1548           "b-sel",
     1549           "obj",
     1550           v-cntxt-obj-type,
     1551           v-cntxt-obj-code,
     1552           "",
     1553           input-output c_shift-list) no-error.
     1554       if error-status:error then
     1555       do:
     1556           message
     1557               vss-workfile vss-revision vss-description skip
     1558               "Ошибка при выборе смены"  skip
     1559               error-status :get-message( 1 ) skip
     1560               return-value skip
     1561               view-as alert-box error .
     1562           return no-apply.
     1563       end.
     1564       if c_shift-list =  "":U then
     1565       do:
     1566           return no-apply.
     1567       end.
     1568       find first buf_shift-obj where recid (buf_shift-obj) = integer (c_shift-list) no-lock.
     1569       FILL-IN-sht-from-d:screen-value = string(buf_shift-obj.shift-date) no-error.
     1570       FILL-IN-sht-from-n:screen-value = string(buf_shift-obj.shift-num) no-error.
     1571   END.
     1572   ON CHOOSE OF Btn_sht-to IN FRAME Dialog-Frame
     1573   DO:
     1574       run str/sht-all.w (parparentproc,
     1575           v-cntxt-obj-type,
     1576           v-cntxt-obj-code,
     1577           "b-sel",
     1578           "obj",
     1579           v-cntxt-obj-type,
     1580           v-cntxt-obj-code,
     1581           "",
     1582           input-output c_shift-list) no-error.
     1583       if error-status:error then
     1584       do:
     1585           message
     1586               vss-workfile vss-revision vss-description skip
     1587               "Ошибка при выборе смены"  skip
     1588               error-status :get-message( 1 ) skip
     1589               return-value skip
     1590               view-as alert-box error .
     1591           return no-apply.
     1592       end.
     1593       if c_shift-list =  "":U then
     1594       do:
     1595           return no-apply.
     1596       end.
     1597       find first buf_shift-obj where recid (buf_shift-obj) = integer (c_shift-list) no-lock.
     1598       FILL-IN-sht-to-d:screen-value = string(buf_shift-obj.shift-date) no-error.
     1599       FILL-IN-sht-to-n:screen-value = string(buf_shift-obj.shift-num) no-error.
     1600   END.
     1601   ON CHOOSE OF Btn_Start IN FRAME Dialog-Frame
     1602   DO:
     1603       assign
     1604           FILL-IN-Dir
     1605           RADIO-SET-Objects
     1606           FILL-IN-sht-from-d
     1607           FILL-IN-sht-from-n
     1608           FILL-IN-sht-to-d
     1609           FILL-IN-sht-to-n
     1610       .
     1611       if FILL-IN-sht-from-d > FILL-IN-sht-to-d
     1612       or (FILL-IN-sht-from-d = FILL-IN-sht-to-d and FILL-IN-sht-from-n > FILL-IN-sht-to-n)
     1613       then do :
     1614           message "Смены выбраны не верно!" view-as alert-box.
     1615           return no-apply .
     1616       end.
     1617       FILL-IN-Dir = right-trim(FILL-IN-Dir,'/\') + '\'.
     1618       file-info:file-name = FILL-IN-Dir.
     1619       if file-info:file-type = ? then
     1620       do:
     1621           message substitute("Директории &1 не существует.",FILL-IN-Dir) skip
     1622               "Создать?" view-as alert-box warning buttons yes-no update dir_crt.
     1623           if dir_crt then
     1624           do:
     1625               os-create-dir value(FILL-IN-Dir).
     1626               if os-error <> 0 then
     1627               do:
     1628                   message substitute("Невозможно создать директорию &1",FILL-IN-Dir) view-as alert-box error.
     1629                   leave.
     1630               end.
     1631           end.
     1632           else leave.
     1633       end.
     1634       else
     1635       do:
     1636           if not (file-info:file-type begins "D":U) then
     1637           do:
     1638               message substitute("&1 не является директорией.",FILL-IN-Dir) view-as alert-box error.
     1639               leave.
     1640           end.
     1641       end.
     1642       if RADIO-SET-Objects = 1 then
     1643       do:
     1644           for each buf_clients no-lock where buf_clients.host-code = v-cntxt-host-code-obj:
     1645               if buf_clients.stts <> 0 then next.
     1646               find first userobjs_temp-user-obj where  userobjs_temp-user-obj.obj-code = buf_clients.obj-code and   userobjs_temp-user-obj.obj-type = buf_clients.obj-type no-lock no-error.
     1647               if not available userobjs_temp-user-obj
     1648               then do:
     1649                   create userobjs_temp-user-obj.
     1650                   assign
     1651                       userobjs_temp-user-obj.obj-code = buf_clients.obj-code
     1652                       userobjs_temp-user-obj.obj-type = buf_clients.obj-type.
     1653               end.
     1654           end.
     1655       end.
     1656       assign
     1657           d_sht-start = date(FILL-IN-sht-from-d)
     1658           i_sht-start = integer(FILL-IN-sht-from-n)
     1659           d_sht-end   = date(FILL-IN-sht-to-d)
     1660           i_sht-end   = integer(FILL-IN-sht-to-n)
     1661       .
     1662       run waitfram-show in this-procedure ( input "Идет выгрузка в систему анализа треков данных. Ждите..." ).
     1663       run bge/bge-exp-ATD.p (input table userobjs_temp-user-obj,
     1664           input FILL-IN-Dir,
     1665           input this-procedure:handle,
     1666           input d_sht-start,
     1667           input i_sht-start,
     1668           input d_sht-end,
     1669           input i_sht-end,
     1670           input p-region,
     1671           input "run"
     1672           ) no-error.
     1673       if error-status:error then
     1674       do:
     1675           message return-value + error-status:get-message(1).
     1676       end.
     1677       run waitfram-hide in this-procedure .
     1678       message "Выгрузка завершена" view-as alert-box .
     1679       apply "go".
     1680   END.
     1681   ON VALUE-CHANGED OF RADIO-SET-Objects IN FRAME Dialog-Frame
     1682   DO:
     1683           for each userobjs_temp-user-obj:
     1684               delete userobjs_temp-user-obj.
     1685           end.
     1686           case RADIO-SET-Objects :screen-value in frame Dialog-frame:
     1687               when "1" then
     1688                   do:
     1689                       EDITOR-obj:screen-value = v-host-name.
     1690                       hide Btn_Obj in frame Dialog-Frame.
     1691                       for each userobjs_temp-user-obj:
     1692                           delete userobjs_temp-user-obj.
     1693                       end.
     1694                       v-obj-list = 'орг':U + chr(44) + string(v-cntxt-host-code-obj).
     1695                   end.
     1696               when "2" then
     1697                   do:
     1698                       display Btn_Obj with frame Dialog-Frame.
     1699                       create userobjs_temp-user-obj.
     1700                       assign
     1701                           userobjs_temp-user-obj.obj-code = v-cntxt-obj-code
     1702                           userobjs_temp-user-obj.obj-type = v-cntxt-obj-type.
     1703                       v-obj-list = userobjs_temp-user-obj.obj-type + chr(44) + string(userobjs_temp-user-obj.obj-code) + chr(4).
     1704                       find first buf_clients where buf_clients.obj-type = userobjs_temp-user-obj.obj-type
     1705                           and buf_clients.obj-code = userobjs_temp-user-obj.obj-code no-lock no-error.
     1706                       EDITOR-obj:screen-value in frame Dialog-frame = if buf_clients.obj-name <> '' then buf_clients.obj-name
     1707                       else userobjs_temp-user-obj.obj-type + string(userobjs_temp-user-obj.obj-code).
     1708                   end.
     1709           end case.
     1710       END.
     1711   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1712       THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1713   MAIN-BLOCK:
     1714   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1715       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1716   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1717     run mainmenu_getcntxt in parparentproc
     1718       (output v-cntxt-db-num
     1719       ,output v-cntxt-userid
     1720       ,output v-cntxt-level
     1721       ,output v-cntxt-host-code-obj
     1722       ,output v-cntxt-obj-type
     1723       ,output v-cntxt-obj-code
     1724       ,output v-cntxt-db-num-obj
     1725       ,output v-cntxt-is-admin
     1726       ) .
     1727   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1728     (input  'atd-reg'
     1729     ,input  '':U
     1730     ,input  '':U
     1731     ,input  '':U
     1732     ,input  '':U
     1733     ,input  '':U
     1734     ,input  '':U
     1735     ,input  Yes
     1736     ,output p-region
     1737     ,output par-type
     1738     ) NO-ERROR .
     1739       if error-status:error or trim(p-region) = "" then  return error .
     1740       RUN enable_UI.
     1741       RUN my-enable.
     1742       WAIT-FOR GO OF FRAME Dialog-Frame.
     1743   END.
     1744   RUN disable_UI.
     1745   PROCEDURE disable_UI :
     1746     HIDE FRAME Dialog-Frame.
     1747   END PROCEDURE.
     1748   PROCEDURE enable_UI :
     1749     DISPLAY FILL-IN-sht-from-d FILL-IN-sht-from-n FILL-IN-sht-to-d
     1750             FILL-IN-sht-to-n EDITOR-obj RADIO-SET-Objects FILL-IN-Dir
     1751         WITH FRAME Dialog-Frame.
     1752     ENABLE RECT-2 RECT-5 Btn_Save Btn_Start Btn_Cancel FILL-IN-sht-from-d
     1753            FILL-IN-sht-from-n Btn_sht-from FILL-IN-sht-to-d FILL-IN-sht-to-n
     1754            Btn_sht-to EDITOR-obj RADIO-SET-Objects Btn_Obj FILL-IN-Dir  b-dir
     1755         WITH FRAME Dialog-Frame.
     1756     VIEW FRAME Dialog-Frame.
     1757   END PROCEDURE.
     1758   PROCEDURE my-enable :
     1759   define variable i as integer init 0 no-undo.
     1760   define variable ii as integer  init 0 no-undo.
     1761       define variable v-name-nom as char      no-undo.
     1762       define variable v-name-pit as char      no-undo.
     1763       case p_mode:
     1764           when "run" then
     1765               do:
     1766                   hide Btn_Save in frame Dialog-Frame.
     1767               end.
     1768           when "shd" then
     1769               do:
     1770                   hide Btn_Start FILL-IN-sht-from-d FILL-IN-sht-from-n FILL-IN-sht-to-d
     1771                       FILL-IN-sht-to-n Btn_sht-from Btn_sht-to in frame Dialog-Frame.
     1772                   run schedule-attr-value in this-procedure (input p_cre-db-num,
     1773                       input p_task-type,
     1774                       input p_task-num,
     1775                       input 'schedule-param-list':U,
     1776                       output v-param-list,
     1777                       output v-param-type).
     1778                   if v-param-list <> "" then
     1779                   do:
     1780                       FILL-IN-Dir = entry(1,v-param-list,chr(4)) .
     1781                       RADIO-SET-Objects = integer(entry(2,v-param-list,chr(4)) ).
     1782                       p-region    = entry(3,v-param-list,chr(4)) .
     1783                       display FILL-IN-Dir
     1784                           RADIO-SET-Objects
     1785                            with frame Dialog-Frame .
     1786                   end.
     1787                   run schedule-attr-value in this-procedure (input p_cre-db-num,
     1788                       input p_task-type,
     1789                       input p_task-num,
     1790                       input 'schedule-obj-list':U,
     1791                       output v-obj-list,
     1792                       output v-param-type).
     1793                   if v-obj-list <> "" then
     1794                   do:
     1795                       for each userobjs_temp-user-obj:
     1796                           delete userobjs_temp-user-obj.
     1797                       end.
     1798                       if v-obj-list begins 'орг':U then
     1799                       do:
     1800                           find first buf_clients where buf_clients.obj-type = entry(1, v-obj-list, chr(44))
     1801                               and buf_clients.obj-code = integer(entry(2, v-obj-list, chr(44))) no-lock no-error.
     1802                           if available(buf_clients) then
     1803                               EDITOR-obj:screen-value = if buf_clients.obj-name <> '' then buf_clients.obj-name
     1804                               else buf_clients.obj-type + string(buf_clients.obj-code).
     1805                           RADIO-SET-Objects = 1.
     1806                           display RADIO-SET-Objects with frame Dialog-Frame.
     1807                       end.
     1808                       else
     1809                       do:
     1810                           EDITOR-obj:screen-value = "".
     1811                           do ii = 1 to num-entries(v-obj-list, chr(4)) on error undo, next:
     1812                               v-entry = entry(ii, v-obj-list, chr(4)).
     1813                               find first buf_clients where buf_clients.obj-type = entry(1, v-entry, chr(44))
     1814                                   and buf_clients.obj-code = integer(entry(2, v-entry, chr(44))) no-lock no-error.
     1815                               if available buf_clients then
     1816                               do:
     1817                                   EDITOR-obj:screen-value = EDITOR-obj:screen-value +
     1818                                       (if buf_clients.obj-name <> '' then buf_clients.obj-name
     1819                                       else buf_clients.obj-type + string(buf_clients.obj-code))
     1820                                       + "," + chr(13).
     1821                               end.
     1822                           end.
     1823                           RADIO-SET-Objects = 2.
     1824                           display RADIO-SET-Objects with frame Dialog-Frame.
     1825                       end.
     1826                   end.
     1827               end.
     1828       end case.
     1829   end procedure.
     1830   PROCEDURE write-log-and-file :
     1831       define input parameter p-tab-position as integer no-undo.
     1832       define input parameter p-file-name as char no-undo.
     1833       define input parameter p-log-level as integer no-undo.
     1834       define input parameter p-log-string as char no-undo.
     1835       output stream StreamLog to value(p-file-name) append.
     1836       put stream StreamLog unformatted chr(10).
     1837       put stream StreamLog unformatted cur-time-string-sec() " " p-log-string.
     1838       output stream StreamLog close.
     1839   end procedure.
     1840   PROCEDURE attach-attr-to-schedule-line :
     1841       DEFINE INPUT PARAMETER p-param-list AS CHARACTER NO-UNDO.
     1842       define buffer buf_schedule      for schedule.
     1843       define buffer buf_schedule-attr for schedule-attr.
     1844       define buffer lock-batchprocess for ub.batchprocess.
     1845       run gbl/lock-prc.p
     1846           (input 'schd':U
     1847           ,input 'exp-atd':U
     1848           ,input 0
     1849           ,input 0
     1850           ,input '':U
     1851           ,input ""
     1852           ,input ""
     1853           ,input (
     1854           "Сохранение параметров выгрузки в систему АТД "
     1855           )
     1856           ,input yes
     1857           ,buffer lock-batchprocess
     1858           ) no-error .
     1859       find first buf_schedule no-lock
     1860           where buf_schedule.task-type   = p_task-type
     1861           and buf_schedule.cre-db-num  = INTEGER(p_cre-db-num)
     1862           and buf_schedule.task-num    = p_task-num
     1863           no-error.
     1864       if not available buf_schedule
     1865           and (  p_task-type   <> 'autofree':U
     1866           or p_cre-db-num <> p_cre-db-num
     1867           or p_task-num    <> -1 )
     1868           then
     1869       do:
     1870           message
     1871               vss-workfile vss-revision vss-description
     1872               skip
     1873               "Не найдена строка расписания."
     1874               skip return-value
     1875               skip trim(error-status :get-message(1))
     1876               trim(error-status :get-message(2))
     1877               trim(error-status :get-message(3))
     1878               view-as alert-box error.
     1879           undo, return error .
     1880       end.
     1881       run schedule-attr-write in this-procedure (
     1882           input INTEGER(p_cre-db-num)
     1883           , input p_task-type
     1884           , input p_task-num
     1885           , input 'schedule-param-list':U
     1886           , input p-param-list
     1887           ).
     1888   END PROCEDURE.
