      301   procedure thobjs :
      302      define input        parameter parparentproc     as widget-handle no-undo .
      303      define input        parameter i-bttns           as character     no-undo .
      304      define input        parameter i-list-mode       as character     no-undo.
      305      define input        parameter i-obj-type        as character     no-undo.
      306      define input        parameter i-db-num          as integer       no-undo.
      307      define input        parameter i-host-code       as integer       no-undo.
      308      define input-output parameter p-rid-list        as character     no-undo .
      309   run ref/thobjs.p
      310           ( input parparentproc
      311            ,input  this-procedure :handle
      312           , input i-bttns
      313           , input i-list-mode
      314           , input i-obj-type
      315           , input i-db-num
      316           , input i-host-code
      317           , input-output p-rid-list ) no-error .
      318   end.
      319   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      320   procedure cur-time :
      321      define output parameter p-today as date      no-undo .
      322      define output parameter p-time  as integer   no-undo .
      323     do
      324     on error undo, return error
      325     :
      326       define variable v-date1 as date      no-undo .
      327       define variable v-date2 as date      no-undo .
      328       define variable v-time  as integer   no-undo .
      329       assign
      330         v-date1 = today
      331         v-time  = time
      332         v-date2 = today
      333       .
      334       if v-date1 <> v-date2
      335       then do:
      336         assign
      337           v-date1 = today
      338           v-time  = v-time
      339         .
      340       end.
      341       assign
      342         p-today = v-date1
      343         p-time  = v-time
      344       .
      345     end.
      346   end.
      347   function cur-time-date returns character
      348   :
      349     return string(today, '99/99/9999':U) .
      350   end.
      351   function cur-time-mjd returns decimal
      352   :
      353     define variable v-date as date      no-undo .
      354     define variable v-time as integer   no-undo .
      355     run cur-time in this-procedure
      356       (output v-date
      357       ,output v-time
      358       ) .
      359     return integer(v-date) - 2400002 + (v-time / 86400) .
      360   end.
      361   function cur-time-get-ending-index returns integer
      362   (input p-number as integer
      363   )
      364   :
      365     if p-number < 0
      366     or p-number = ?
      367     then do:
      368       return 1 .
      369     end.
      370     define variable v-rest as integer   no-undo .
      371     assign
      372       p-number = p-number modulo 100
      373     .
      374     if p-number < 20
      375     then do:
      376       assign
      377         v-rest = p-number
      378       .
      379     end.
      380     else do:
      381       assign
      382         v-rest = p-number modulo 10
      383       .
      384     end.
      385     case v-rest :
      386       when 1
      387       then do:
      388         return 2 .
      389       end.
      390       when 2 or
      391       when 3 or
      392       when 4
      393       then do:
      394         return 3 .
      395       end.
      396       otherwise do:
      397         return 1 .
      398       end.
      399     end case .
      400   end.
      401   procedure cur-time-mjd-to-date :
      402      define input  parameter i-mjd-diff as decimal no-undo.
      403      define output parameter o-Date     as date    no-undo.
      404      define output parameter o-Time     as integer no-undo.
      405      define variable v-day-number as integer   no-undo .
      406      if    i-mjd-diff < 0
      407         or i-mjd-diff = ?
      408      then do:
      409         return "?" .
      410      end.
      411      assign
      412         v-day-number = truncate(i-mjd-diff,0).
      413         o-Date = date(v-day-number + 2400002).
      414         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      415     .
      416   end.
      417   function cur-time-mjd-to-string returns character
      418   (input p-mjd-diff as decimal
      419   )
      420   :
      421     define variable v-day-number as integer   no-undo .
      422     define variable v-seconds    as integer   no-undo .
      423     define variable v-hour       as integer   no-undo .
      424     define variable v-min        as integer   no-undo .
      425     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      426     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      427     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      428     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      429     if p-mjd-diff < 0
      430     or p-mjd-diff = ?
      431     then do:
      432       return "?" .
      433     end.
      434     assign
      435       v-day-number = integer(truncate(p-mjd-diff,0))
      436       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      437     .
      438     if v-seconds > 86400
      439     then do:
      440       assign
      441         v-seconds = 86400 - 1
      442       .
      443     end.
      444     if v-seconds < 0
      445     then do:
      446       assign
      447         v-seconds = 0
      448       .
      449     end.
      450     assign
      451       v-hour = truncate(v-seconds / 3600, 0)
      452     .
      453     assign
      454       v-seconds = v-seconds modulo 3600
      455     .
      456     assign
      457       v-min = truncate(v-seconds / 60, 0)
      458     .
      459     assign
      460       v-seconds = v-seconds modulo 60
      461     .
      462     return
      463         (if v-day-number <> 0
      464           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      465           else ""
      466         )
      467       + (if v-day-number <> 0 or v-hour <> 0
      468           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      469           else ""
      470         )
      471       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      472           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      473           else ""
      474         )
      475       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      476       .
      477   end.
      478   function cur-time-string returns character
      479   :
      480     define variable v-date as date      no-undo .
      481     define variable v-time as integer   no-undo .
      482     run cur-time in this-procedure
      483       (output v-date
      484       ,output v-time
      485       ) .
      486     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      487   end.
      488   function cur-time-string-sec returns character
      489   :
      490     define variable v-date as date      no-undo .
      491     define variable v-time as integer   no-undo .
      492     run cur-time in this-procedure
      493       (output v-date
      494       ,output v-time
      495       ) .
      496     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      497   end.
      498   function cur-time-custom  returns character
      499   (input p-prefix as character
      500   ,input p-date-format as character
      501   ,input p-delimiter as character
      502   ,input p-time-format as character
      503   ,input p-suffix as character
      504   )
      505   :
      506     define variable v-date as date      no-undo .
      507     define variable v-time as integer   no-undo .
      508     run cur-time in this-procedure
      509       (output v-date
      510       ,output v-time
      511       ) .
      512     return
      513       p-prefix
      514       + string(v-date, p-date-format)
      515       + p-delimiter
      516       + string(v-time, p-time-format)
      517       + p-suffix
      518       .
      519   end.
      520   function cur-time-print  returns character
      521   :
      522     define variable v-date as date      no-undo .
      523     define variable v-time as integer   no-undo .
      524     run cur-time in this-procedure
      525       (output v-date
      526       ,output v-time
      527       ) .
      528     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      529   end.
      530   function cur-time-datetime returns datetime
      531   :
      532     define variable v-char as character no-undo .
      533     define variable v-datetime as datetime no-undo .
      534     v-char = cur-time-string().
      535     v-datetime = datetime(v-char).
      536     return  v-datetime.
      537   end.
      538   function cur-time-string-msec returns character
      539   :
      540     define variable v-date as datetime  no-undo .
      541     v-date = now.
      542     return string(v-date) .
      543   end.
      544   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      545   define temp-table temp-schedule-free no-undo
      546   field free-id as character
      547   field free-task-name as character
      548   field proc-run-name as character
      549   field proc-param-edit-name as character
      550   field conf-param as character
      551   field is-gbd as logical
      552   field is-ubd as logical
      553   field enable-concurrent-0 as logical
      554   field enable-concurrent-db as logical
      555   field other-info as character
      556   field enc-key as character
      557   field is-rum as logical
      558   index pi is unique primary
      559   free-id.
      560   procedure schedule-attr-name :
      561   do
      562     on error undo, return error
      563     :
      564     define input  parameter p-code           as character no-undo .
      565     define output parameter p-type           as character no-undo .
      566     define output parameter p-format         as character no-undo .
      567     define output parameter p-label          as character no-undo .
      568     define output parameter p-user-can-edit  as logical   no-undo .
      569     define output parameter p-output-display as logical   no-undo .
      570     define output parameter p-other          as character no-undo .
      571       if index(p-code, chr(4)) > 0 then do:
      572         p-code = entry(1, p-code, chr(4)).
      573       end.
      574       case p-code :
      575               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      576               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      577               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      578               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      579               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      580               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      581               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      582               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      583               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      584         otherwise do:
      585           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      586         end.
      587       end.
      588     end.
      589   end procedure.
      590   procedure schedule-attr-tooltip :
      591   do
      592     on error undo, return error
      593     :
      594       define input  parameter p-code    as character no-undo .
      595       define output parameter p-tooltip as character no-undo .
      596       define output parameter p-label   as character no-undo .
      597       if index(p-code, chr(4)) > 0 then do:
      598         p-code = entry(1, p-code, chr(4)).
      599       end.
      600       case p-code :
      601               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      602               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      603               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      604               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      605               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      606               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      607               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      608               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      609               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      610         otherwise do:
      611               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      612         end.
      613       end.
      614     end.
      615   end procedure.
      616   procedure schedule-attr-value :
      617   do
      618   on error undo, return error return-value
      619   :
      620   define input parameter  p-cre-db-num as integer    no-undo.
      621   define input parameter  p-task-type  as character  no-undo.
      622   define input parameter  p-task-num   as integer    no-undo.
      623   define input parameter  p-code       as character  no-undo.
      624   define output parameter p-value      as character  no-undo.
      625   define output parameter p-type       as character  no-undo.
      626       define variable v-format         as character no-undo .
      627       define variable v-label          as character no-undo .
      628       define variable v-user-can-edit  as logical   no-undo .
      629       define variable v-output-display as logical   no-undo .
      630       define variable v-other          as character no-undo .
      631       define buffer buf_schedule-attr for ub.schedule-attr.
      632       run schedule-attr-name in this-procedure (
      633             input  p-code
      634           , output p-type
      635           , output v-format
      636           , output v-label
      637           , output v-user-can-edit
      638           , output v-output-display
      639           , output v-other
      640       ) no-error .
      641       if error-status :error
      642       then do:
      643           undo, return error return-value .
      644       end.
      645       if p-code begins ('schd-free-id':U + chr(4))
      646       and entry(2, p-code, chr(4)) = '':U then do:
      647         find first buf_schedule-attr no-lock
      648             where buf_schedule-attr.cre-db-num = p-cre-db-num
      649               and buf_schedule-attr.task-type  = p-task-type
      650               and buf_schedule-attr.task-num   = p-task-num
      651               and buf_schedule-attr.attr-code  begins p-code
      652         no-error .
      653       end.
      654       else do:
      655         find first buf_schedule-attr no-lock
      656             where buf_schedule-attr.cre-db-num = p-cre-db-num
      657               and buf_schedule-attr.task-type  = p-task-type
      658               and buf_schedule-attr.task-num   = p-task-num
      659               and buf_schedule-attr.attr-code  = p-code
      660         no-error .
      661       end.
      662       if available buf_schedule-attr
      663       then do:
      664           assign
      665               p-value = buf_schedule-attr.attr-value
      666           .
      667       end.
      668       else do:
      669         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      670            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      671         end.
      672         else do:
      673           assign
      674               p-value = if p-type = 'L':U then "no":U else ""
      675           .
      676         end.
      677       end.
      678   end.
      679   end procedure.
      680   procedure schedule-attr-write :
      681   do
      682   on error undo, return error
      683   :
      684   define input parameter p-cre-db-num  as integer   no-undo.
      685   define input parameter p-task-type   as character no-undo.
      686   define input parameter p-task-num    as integer   no-undo.
      687   define input parameter p-code        as character no-undo.
      688   define input parameter p-value       as character no-undo.
      689       define variable v-type              as character                no-undo.
      690       define variable v-format            as character                no-undo.
      691       define variable v-label             as character                no-undo.
      692       define variable v-user-can-edit     as logical                  no-undo.
      693       define variable v-output-display    as logical                  no-undo.
      694       define variable v-other             as character                no-undo.
      695       define buffer buf_schedule-attr for ub.schedule-attr .
      696       run schedule-attr-name in this-procedure (
      697             input  p-code
      698           , output v-type
      699           , output v-format
      700           , output v-label
      701           , output v-user-can-edit
      702           , output v-output-display
      703           , output v-other
      704       ) no-error.
      705       if error-status :error
      706       then do:
      707           undo, return error return-value.
      708       end.
      709       find first buf_schedule-attr exclusive-lock
      710            where buf_schedule-attr.cre-db-num = p-cre-db-num
      711              and buf_schedule-attr.task-type  = p-task-type
      712              and buf_schedule-attr.task-num   = p-task-num
      713              and buf_schedule-attr.attr-code  = p-code
      714       no-error.
      715       if not available buf_schedule-attr
      716       then do:
      717           create buf_schedule-attr.
      718           assign
      719             buf_schedule-attr.cre-db-num = p-cre-db-num
      720             buf_schedule-attr.task-type  = p-task-type
      721             buf_schedule-attr.task-num   = p-task-num
      722             buf_schedule-attr.attr-code  = p-code
      723             buf_schedule-attr.attr-value = p-value
      724           .
      725       end.
      726       else do:
      727           assign
      728               buf_schedule-attr.attr-value = p-value
      729           .
      730       end.
      731   end.
      732   end procedure.
      733   procedure schedule-attr-delete :
      734   do
      735   on error undo, return error
      736   :
      737   define input  parameter p-cre-db-num  as integer   no-undo.
      738   define input  parameter p-task-type   as character no-undo.
      739   define input  parameter p-task-num    as integer   no-undo.
      740   define input  parameter p-code        as character no-undo.
      741   define output parameter p-deleted     as logical   no-undo.
      742       define buffer buf_schedule-attr for ub.schedule-attr .
      743       define variable v-type              as character                no-undo.
      744       define variable v-format            as character                no-undo.
      745       define variable v-label             as character                no-undo.
      746       define variable v-user-can-edit     as logical                  no-undo.
      747       define variable v-output-display    as logical                  no-undo.
      748       define variable v-other             as character                no-undo.
      749       run schedule-attr-name in this-procedure (
      750             input p-code
      751           , output v-type
      752           , output v-format
      753           , output v-label
      754           , output v-user-can-edit
      755           , output v-output-display
      756           , output v-other
      757       ) no-error .
      758       if error-status :error
      759       then do:
      760           undo, return error return-value .
      761       end.
      762       find first buf_schedule-attr exclusive-lock
      763            where buf_schedule-attr.cre-db-num = p-cre-db-num
      764              and buf_schedule-attr.task-type  = p-task-type
      765              and buf_schedule-attr.task-num   = p-task-num
      766              and buf_schedule-attr.attr-code  = p-code
      767       no-error.
      768       if not available buf_schedule-attr
      769       then do:
      770           assign
      771               p-deleted = no
      772           .
      773       end.
      774       else do:
      775           delete buf_schedule-attr.
      776           assign
      777               p-deleted = yes
      778           .
      779       end.
      780   end.
      781   end procedure.
      782   procedure schedule-attr-news :
      783   do
      784   on error undo, return error
      785   :
      786       define input  parameter p-code           as character no-undo .
      787       define output parameter p-news           as logical   no-undo .
      788       if index(p-code, chr(4)) > 0 then do:
      789         p-code = entry(1, p-code, chr(4)).
      790       end.
      791       case p-code :
      792               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      793               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      794               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      795               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      796               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      797               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      798               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      799               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      800               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      801         otherwise do:
      802           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      803         end.
      804       end.
      805   end.
      806   end procedure.
      807   procedure schedule-attr-extract-logical :
      808   do
      809   on error undo, return error
      810   :
      811   define input  parameter p-parameter-number   as integer      no-undo.
      812   define input  parameter p-parameter-list     as character    no-undo.
      813   define output parameter p-parameter-value   as logical      no-undo.
      814       if num-entries( p-parameter-list ) > p-parameter-number - 1
      815       then do:
      816           assign
      817               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      818           .
      819       end.
      820       else do:
      821           assign
      822               p-parameter-value   = no
      823           .
      824       end.
      825   end.
      826   end procedure.
      827   procedure schedule-attr-get-free-id :
      828   do
      829   on error undo, return error return-value
      830   :
      831     define input  parameter p-cre-db-num  as integer   no-undo.
      832     define input  parameter p-task-type   as character no-undo.
      833     define input  parameter p-task-num    as integer   no-undo.
      834     define output parameter p-free-id     as character no-undo.
      835     define buffer buf_schedule-attr for ub.schedule-attr.
      836     find first buf_schedule-attr no-lock
      837         where buf_schedule-attr.cre-db-num = p-cre-db-num
      838           and buf_schedule-attr.task-type  = p-task-type
      839           and buf_schedule-attr.task-num   = p-task-num
      840           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      841     no-error .
      842     if available buf_schedule-attr then
      843     assign
      844     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      845     no-error
      846     .
      847   end.
      848   end procedure.
      849   procedure schedule-attr-get-free-props :
      850     define input parameter p-free-id as character no-undo .
      851     define output parameter p-value as character no-undo .
      852     define buffer buf_temp-schedule-free for temp-schedule-free.
      853     do
      854     on error undo, return error return-value
      855     :
      856       find first buf_temp-schedule-free no-lock no-error .
      857       if not available buf_temp-schedule-free then do:
      858         run schedule-attr-fill-free-props in this-procedure .
      859       end.
      860       find first buf_temp-schedule-free where
      861               buf_temp-schedule-free.free-id = p-free-id no-error.
      862       if available buf_temp-schedule-free then do:
      863         assign
      864         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      865                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      866                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      867                   buf_temp-schedule-free.conf-param           + chr(4) +
      868                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      869                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      870                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      871                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      872                   buf_temp-schedule-free.other-info
      873         .
      874       end.
      875       else do:
      876        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      877                              "id произвольной задачи - &5"
      878                              ,vss-workfile
      879                              ,vss-revision
      880                              ,vss-description
      881                              ,chr(10)
      882                              ,p-free-id).
      883       end.
      884     end.
      885   end procedure.
      886   procedure schedule-attr-is-rum-free-id :
      887   define input parameter p-free-id as character no-undo .
      888   define output parameter p-is-rum as logical no-undo .
      889   define buffer buf_temp-schedule-free for temp-schedule-free.
      890   do
      891   on error undo, return error
      892   :
      893       find first buf_temp-schedule-free no-lock no-error .
      894       if not available buf_temp-schedule-free then do:
      895         run schedule-attr-fill-free-props in this-procedure .
      896       end.
      897       find first buf_temp-schedule-free where
      898               buf_temp-schedule-free.free-id = p-free-id no-error.
      899       if available buf_temp-schedule-free
      900       and buf_temp-schedule-free.is-rum
      901       then do:
      902         p-is-rum = yes.
      903       end.
      904   end.
      905   end procedure.
      906   procedure schedule-attr-fill-free-props :
      907   define variable v-path                    as character                no-undo .
      908   DEFINE VARIABLE v-full-path               as character                no-undo .
      909   DEFINE VARIABLE v-file-name               as character                no-undo .
      910   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      911   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      912   define buffer buf_temp-schedule-free for temp-schedule-free.
      913   define variable v-answer as logical no-undo .
      914     do
      915     on error undo, return error substitute("&1 &2 &3&4&5&4"
      916                                           ,vss-workfile
      917                                           ,vss-revision
      918                                           ,vss-description
      919                                           ,chr(10)
      920                                           ,error-status:get-message(1) )
      921     :
      922       run gbl/filename.p (
      923                       input 'cmp/shd-free.d'
      924                     ,output v-full-path
      925                     ,output v-path
      926                     ,output v-file-name
      927                     ,output v-file-name-no-ext
      928                     ,output v-file-name-ext
      929                     ) .
      930       input from value(v-full-path).
      931       repeat :
      932         create buf_temp-schedule-free.
      933         import buf_temp-schedule-free.
      934       END.
      935       input close.
      936       _ff:
      937       for each buf_temp-schedule-free :
      938         if buf_temp-schedule-free.free-id = '':U then do:
      939            delete buf_temp-schedule-free.
      940            next _ff.
      941          end.
      942          run schedule-attr-check-enc in this-procedure (
      943                                                       input  buf_temp-schedule-free.free-id
      944                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      945                                                               buf_temp-schedule-free.proc-param-edit-name +
      946                                                               buf_temp-schedule-free.conf-param +
      947                                                               string(buf_temp-schedule-free.is-gbd) +
      948                                                               string(buf_temp-schedule-free.is-ubd) +
      949                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      950                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      951                                                               string(buf_temp-schedule-free.other-info)
      952                                                               )
      953                                                       ,input  buf_temp-schedule-free.enc-key
      954                                                       ,output v-answer    ) no-error .
      955          if error-status:error
      956          or not v-answer then delete buf_temp-schedule-free.
      957        end.
      958     end.
      959   end procedure.
      960   Function schedule-attr-reverse returns character (str as character).
      961      define variable rev_incl_s as character init "" no-undo .
      962      define variable rev_incl_i as integer no-undo .
      963      define variable rev_incl_l as integer no-undo .
      964      rev_incl_l = length(str).
      965      do rev_incl_i = 1 to rev_incl_l:
      966         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      967      end.
      968      return rev_incl_s.
      969   end.
      970   procedure schedule-attr-check-enc.
      971     define input  parameter p-free-id   as character no-undo .
      972     define input  parameter p-value     as character no-undo .
      973     define input  parameter p-enc-value as character no-undo .
      974     define output parameter p-answer    as logical   no-undo .
      975     define variable tmp         as character no-undo .
      976     define variable v-enc-value as character no-undo .
      977     assign
      978     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      979     .
      980     run schedule-attr-pswd-enc in this-procedure
      981       ( input tmp
      982        ,output v-enc-value
      983       ) no-error .
      984     if error-status:error then do:
      985       message
      986         vss-workfile vss-revision vss-description skip
      987         "Ошибка при вызове процедуры pswd-enc" skip
      988         return-value skip
      989         error-status :get-message(1) skip
      990         view-as alert-box error .
      991       undo, return error .
      992     end.
      993     if v-enc-value = p-enc-value then do:
      994       assign
      995         p-answer = true
      996       .
      997     end.
      998     else do:
      999       assign
     1000         p-answer = false
     1001       .
     1002     end.
     1003   end.
     1004   procedure schedule-attr-conf-enc.
     1005     define input  parameter p-free-id   as character no-undo .
     1006     define input  parameter p-value     as character no-undo .
     1007     define output parameter p-enc-value as character no-undo .
     1008     define variable tmp         as character no-undo .
     1009     assign
     1010       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
     1011     .
     1012     run schedule-attr-pswd-enc in this-procedure
     1013       ( input tmp
     1014        ,output p-enc-value
     1015       ) no-error .
     1016     if error-status:error then do:
     1017       message
     1018         vss-workfile vss-revision vss-description skip
     1019         "Ошибка при вызове процедуры pswd-enc" skip
     1020         return-value skip
     1021         error-status :get-message(1) skip
     1022         view-as alert-box error .
     1023       undo, return error .
     1024     end.
     1025   end procedure.
     1026   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1027   procedure schedule-attr-pswd-enc :
     1028     define input parameter  pswd     as character no-undo .
     1029     define output parameter enc-pswd as character no-undo .
     1030     do
     1031     on error undo, return error return-value
     1032     :
     1033       assign
     1034         enc-pswd = encode(pswd + string(index(pswd, "k")))
     1035       .
     1036     end.
     1037   end procedure.
     1038   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1039   define variable v-waitfram-action01         as character   no-undo .
     1040   define variable v-waitfram-action02         as character   no-undo .
     1041   define variable v-waitfram-action03         as character   no-undo .
     1042   define variable mWaitFramTextBeg            as character   no-undo.
     1043   define variable mWaitFramTextEnd            as character   no-undo.
     1044   define variable mWaitFramView               as logical     no-undo.
     1045   define variable mWaitProcEvent              as logical     no-undo init yes.
     1046   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1047   define variable mWaitFramStop               as logical     no-undo.
     1048   define variable mWaitFramStopUser           as logical     no-undo.
     1049   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1050   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1051   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1052   define button B-WaitFramStop auto-end-key
     1053        label "Стоп"
     1054        size 10 by 1 tooltip "Остоновить процесс".
     1055   define button B-viewProcInfo
     1056        label "Информация"
     1057        size 15 by 1 tooltip "Информация о процесс".
     1058   define frame waitfram
     1059     v-waitfram-action01 format "x(72)" no-label skip
     1060     v-waitfram-action02 format "x(72)" no-label skip
     1061     v-waitfram-action03 format "x(72)" no-label skip
     1062     B-viewProcInfo
     1063     B-WaitFramStop at row 4 col 30
     1064     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1065     .
     1066   define new global shared variable mBatchMode as logical no-undo init ?.
     1067   define variable mFramBachModHandle as handle no-undo.
     1068   mFramBachModHandle = frame waitfram:handle.
     1069   define variable mFameOldVis as logical no-undo.
     1070   define variable mVisCUrentVin as logical no-undo.
     1071   if session:batch-mode
     1072   then
     1073      mBatchMode = yes.
     1074   if mBatchMode = ? then do:
     1075     mVisCUrentVin = current-window:visible.
     1076     mFameOldVis = mFramBachModHandle:visible.
     1077     mFramBachModHandle:visible  = yes.
     1078     mBatchMode = mFramBachModHandle:visible ne yes.
     1079     mFramBachModHandle:visible = mFameOldVis.
     1080     current-window:visible = mVisCUrentVin.
     1081   end.
     1082    if  log-manager:logfile-name ne ?
     1083     then DO:
     1084         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1085         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1086         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1087     end.
     1088   on choose of B-WaitFramStop in frame waitfram
     1089   do:
     1090     mWaitFramStop = yes.
     1091     mWaitFramStopUser = yes.
     1092   end.
     1093   function waitfram-check-timeout returns logical():
     1094      define variable vtime as int64 no-undo.
     1095      if mWaitFramStopTimeOut
     1096      then
     1097         return yes.
     1098      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1099      if     mWaitFramTimeOut ne ?
     1100         and mWaitFramTimeOut ne 0
     1101         and mWaitFramTimeOut lt vtime
     1102      then do:
     1103         mWaitFramStopTimeOut = yes.
     1104      end.
     1105      return mWaitFramStopTimeOut.
     1106   end.
     1107   procedure waitfram-hide :
     1108     if not session:batch-mode
     1109     then do
     1110     on error undo, return error return-value
     1111     :
     1112       pause 0 before-hide .
     1113       if not mBatchMode then
     1114         hide frame waitfram .
     1115     if     not mWaitFramView
     1116        and mWaitProcEvent
     1117     then
     1118       process events .
     1119     end.
     1120   end procedure.
     1121   procedure waitfram-show :
     1122     define input  parameter p-message as character no-undo .
     1123     define variable v-left-margin as integer   no-undo .
     1124     if not session:batch-mode
     1125     then do
     1126     on error undo, return error return-value
     1127     :
     1128       if length(p-message) <= 70 then do:
     1129         assign
     1130           v-left-margin = integer((70 - length(p-message)) / 2)
     1131         .
     1132         assign
     1133           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1134         .
     1135         assign
     1136           v-waitfram-action01 = " "
     1137           v-waitfram-action02 = " "
     1138                                    + fill(" ", v-left-margin)
     1139                                    + p-message
     1140           v-waitfram-action03 = " "
     1141         .
     1142       end.
     1143       else do:
     1144         define variable vRindex1 as integer no-undo.
     1145         define variable vRindex2 as integer no-undo.
     1146         vRindex1 = r-index(p-message," ",70).
     1147         if vRindex1 = 0
     1148         then
     1149            vRindex1 = 70.
     1150         if length(p-message)  <= vRindex1 + 70 then do:
     1151           assign
     1152             v-waitfram-action01 = " "
     1153             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1154             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1155           .
     1156         end.
     1157         else do:
     1158           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1159           if vRindex2 <= vRindex1
     1160           then
     1161              vRindex2 = vRindex1 + 70.
     1162           assign
     1163             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1164             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1165             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1166           .
     1167         end.
     1168       end.
     1169       B-viewProcInfo:visible   in frame waitfram = no.
     1170       B-viewProcInfo:sensitive in frame waitfram = no.
     1171       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1172       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1173       if  (   mWaitFramView
     1174          or  mWaitProcEvent)
     1175          and not mBatchMode
     1176       then
     1177          display
     1178             v-waitfram-action01 skip
     1179             v-waitfram-action02 skip
     1180             v-waitfram-action03 skip
     1181          with frame waitfram .
     1182       if     mWaitFramView
     1183          then do:
     1184             if     mWaitFramInterval ne ?
     1185                and not mBatchMode
     1186             then
     1187                wait-for go of frame waitfram pause mWaitFramInterval.
     1188          end.
     1189          else
     1190             if     mWaitProcEvent
     1191                and not mBatchMode
     1192             then
     1193                process events .
     1194     end.
     1195   end procedure.
     1196      procedure waitfram-show-this:
     1197         define input  parameter iInterval as int64 no-undo.
     1198         define variable vtime as int64 no-undo.
     1199         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1200         mWaitFramInterval = iInterval.
     1201         run waitfram-show (substitute("&1&2 &3&4" ,
     1202                                       mWaitFramTextBeg ,
     1203                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1204                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1205                                       mWaitFramTextEnd
     1206                                      )
     1207                           ).
     1208      end.
     1209      procedure WaitFramRunPause:
     1210         define input  parameter iInterval as dec no-undo.
     1211         define variable vStart  as datetime-tz no-undo.
     1212         define variable vend    as datetime-tz no-undo.
     1213         define variable vint as int64 no-undo.
     1214         define variable vOk as logical no-undo.
     1215         vStart = now.
     1216         vend   = vStart.
     1217         publish "WaitFramPause" (iInterval,output vOk).
     1218         vend   =  now.
     1219         vint = vend - vStart.
     1220         vint = iInterval - vint / 1000.
     1221         if     not mWaitFramStop
     1222            and (   vint > 0
     1223                 or (    not vOk
     1224                     and iInterval eq ?
     1225                     )
     1226                 )
     1227         then
     1228            run waitfram-show-this (iInterval).
     1229         vend   =  now.
     1230         vint = vend - vStart.
     1231         vint = iInterval - vint / 1000.
     1232         if     not mWaitFramStop
     1233            and vint > 0
     1234         then do:
     1235            run gbl/pause.p (vint * 1000).
     1236         end.
     1237         if iInterval ne ?
     1238         then
     1239            publish "WaitFramStop".
     1240         waitfram-check-timeout().
     1241      end.
     1242      procedure WaitFramWaitFor:
     1243         define input  parameter iInterval as dec no-undo.
     1244         assign
     1245            mWaitFramStartProc   = now
     1246            mWaitFramStopUser    = no
     1247            mWaitFramStopTimeOut = no
     1248         .
     1249         block-wait:
     1250         do while not mWaitFramStop:
     1251            run WaitFramRunPause (iInterval).
     1252            if  waitfram-check-timeout()
     1253            then do:
     1254               leave block-wait.
     1255            end.
     1256         end.
     1257         run waitfram-hide.
     1258      end.
     1259   procedure waitfram-join :
     1260     define input  parameter p-line-1  as character no-undo .
     1261     define input  parameter p-line-2  as character no-undo .
     1262     define input  parameter p-line-3  as character no-undo .
     1263     define output parameter p-message as character no-undo .
     1264     do
     1265     on error undo, return error return-value
     1266     :
     1267       assign
     1268         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1269                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1270                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1271       .
     1272     end.
     1273   end procedure.
     1274   function waitfram-join-function returns character
     1275     (input p-line-1 as character
     1276     ,input p-line-2 as character
     1277     ,input p-line-3 as character
     1278     ).
     1279     define variable v-message as character no-undo .
     1280     run waitfram-join in this-procedure
     1281       (input  p-line-1
     1282       ,input  p-line-2
     1283       ,input  p-line-3
     1284       ,output v-message
     1285       ) .
     1286     return v-message .
     1287   end function .
