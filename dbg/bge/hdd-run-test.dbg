        1   block-level on error undo, throw.
        2   define input parameter p-ip     as character no-undo .
        3   define input parameter p-tms    as character no-undo .
        4   define input parameter p-code   as character no-undo .
        5   define variable log-exit          as logical    no-undo .
        6   define variable curl-path         as character  no-undo .
        7   define variable v-post-file-name  as character  no-undo .
        8   define variable v-response-file-name  as character  no-undo .
        9   define variable v-cmd-file-name   as character  no-undo .
       10   define variable v-command         as character  no-undo .
       11   define variable v-out-str         as character  no-undo .
       12   define variable v-pid-list        as character  no-undo .
       13   define variable v-time-str        as character  no-undo .
       14   define variable v-del-file        as character  no-undo .
       15   define variable v-parsesub        as character  no-undo .
       16   define variable hDoc              as handle     no-undo .
       17   define variable hRoot             as handle     no-undo .
       18   define variable good              as logical    no-undo .
       19   define temp-table HddTest no-undo
       20     field db-num      as integer
       21     field id          as int64
       22     field namepc      as character
       23     field hddModule   as character
       24     field testStatus  as character
       25     field hddFilling  as integer
       26     field hddName     as character
       27     field hddSerial   as character
       28     index i1 as unique
       29       hddSerial hddModule
       30   .
       31   define temp-table hddAttributes no-undo
       32     field name_       as character
       33     field value_      as integer
       34     field thresh      as integer
       35     field type_       as character
       36     field raw_value   as integer
       37     field hddModule   as character
       38     field hddSerial   as character
       39     index i1 as unique
       40       hddSerial hddModule name_
       41   .
       42   assign
       43     curl-path = search("exe/curl.exe")
       44   .
       45   v-post-file-name = "hdd-test-req.xml" .
       46   v-out-str = substitute ("<?xml version='1.0' encoding='windows-1251'?><data type='REQUEST'><HddTest ctrl='READ' tms = '&1' code = '&2'></HddTest><Count>100</Count></data>", p-tms, p-code) .
       47   output to value (v-post-file-name) .
       48   put unformatted v-out-str skip .
       49   output close .
       50   v-response-file-name = "hdd-test-result.xml" .
       51   v-command = substitute('&1 -0 --connect-timeout 5 -X POST -H "Content-Type: text/xml" -d @"&2" &3 >&4'
       52                           , curl-path
       53                           , v-post-file-name
       54                           , p-ip
       55                           , v-response-file-name) .
       56   os-command value (v-command) .
       57   run parse-xml (input v-response-file-name) .
       58   procedure parse-xml :
       59     define input parameter p-file as character .
       60     CREATE X-DOCUMENT hDoc.
       61     CREATE X-NODEREF hRoot.
       62     hDoc:LOAD("file",p-file,FALSE).
       63     hDoc:GET-DOCUMENT-ELEMENT(hRoot).
       64     RUN GetChildren(hRoot, 1).
       65     DELETE OBJECT hDoc.
       66     DELETE OBJECT hRoot.
       67   end procedure .
       68   PROCEDURE GetChildren:
       69   DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
       70   DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
       71   DEFINE VARIABLE i AS INTEGER NO-UNDO.
       72   DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
       73   DEFINE VARIABLE hText AS HANDLE NO-UNDO.
       74   define variable client as character no-undo.
       75   CREATE X-NODEREF hNoderef.
       76   CREATE X-NODEREF hText .
       77   REPEAT i = 1 TO hParent:NUM-CHILDREN:
       78       good = hParent:GET-CHILD(hNoderef,i).
       79       IF NOT good THEN
       80           LEAVE.
       81       IF hNoderef:SUBTYPE <> "element" THEN
       82           NEXT.
       83       hNoderef:GET-CHILD(hText, 1) no-error .
       84       IF hNoderef:NAME = "HddTest"
       85       then do :
       86         create HddTest .
       87       end.
       88       IF hNoderef:NAME = "hddModule" then assign HddTest.hddModule = hText:node-value no-error .
       89       IF hNoderef:NAME = "testStatus" then assign HddTest.testStatus = hText:node-value no-error .
       90       IF hNoderef:NAME = "hddFilling" then assign HddTest.hddFilling = integer(hText:node-value) no-error .
       91       IF hNoderef:NAME = "hddName" then assign HddTest.hddName = hText:node-value no-error .
       92       IF hNoderef:NAME = "hddSerial" then assign HddTest.hddSerial = hText:node-value no-error .
       93       IF hNoderef:NAME = "hddAttributes"
       94       then do :
       95         create hddAttributes .
       96         assign
       97           hddAttributes.hddModule   = HddTest.hddModule
       98           hddAttributes.hddSerial   = HddTest.hddSerial
       99         .
      100       end.
      101       IF hNoderef:NAME = "name" then assign hddAttributes.name_ = hText:node-value no-error .
      102       IF hNoderef:NAME = "value" then assign hddAttributes.value_ = integer(hText:node-value) no-error .
      103       IF hNoderef:NAME = "thresh" then assign hddAttributes.thresh = integer(hText:node-value) no-error .
      104       IF hNoderef:NAME = "type" then assign hddAttributes.type_ = hText:node-value no-error .
      105       IF hNoderef:NAME = "raw_value" then assign hddAttributes.raw_value = integer(hText:node-value) no-error .
      106       RUN GetChildren(hNoderef, (level + 1)).
      107   END.
      108   DELETE OBJECT hNoderef.
      109   DELETE OBJECT hText.
      110   END PROCEDURE.
