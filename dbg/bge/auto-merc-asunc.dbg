        1   block-level on error undo, throw.
        2   define input  parameter iType            as character no-undo.
        3   define input  parameter i-parent-handle  as handle no-undo.
        4   procedure addtask:
        5      define input  parameter iProc as character no-undo.
        6      define input  parameter iParam as character no-undo.
        7      run addtaskType  (iType,iProc,iParam).
        8   end.
        9   procedure addtaskType:
       10      define input  parameter ITask as character no-undo.
       11      define input  parameter iProc as character no-undo.
       12      define input  parameter iParam as character no-undo.
       13      run addtask in i-parent-handle (ITask,iProc,iParam).
       14   end.
       15   procedure waitproc:
       16      define input  parameter itext  as character no-undo.
       17      run waitProcLable in i-parent-handle (itext).
       18   end.
       19   define input  parameter iStart as datetime-tz no-undo.
       20   define input  parameter p-list-db       as character no-undo .
       21   def var vss-revision    as character no-undo init "$Revision: d3f7ea4aa09e, 3307, rls $":U .
       22   def var vss-author      as character no-undo init "$Author: DRuban $":U .
       23   def var vss-date        as character no-undo init "$Date: 2023/05/19 13:37:07 $":U .
       24   def var vss-workfile    as character no-undo init "$Workfile: auto-merc-asunc.p $":U .
       25   def var vss-archive     as character no-undo init "$Archive: bge/auto-merc-asunc.p $":U .
       26   def var vss-description as character no-undo init "Работа с ФГИС Меркурий".
       27   procedure vss-get-info :
       28     define output parameter p-vss-revision    like vss-revision    no-undo .
       29     define output parameter p-vss-author      like vss-author      no-undo .
       30     define output parameter p-vss-date        like vss-date        no-undo .
       31     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       32     define output parameter p-vss-archive     like vss-archive     no-undo .
       33     define output parameter p-vss-description like vss-description no-undo .
       34     assign
       35       p-vss-revision    = vss-revision
       36       p-vss-author      = vss-author
       37       p-vss-date        = vss-date
       38       p-vss-workfile    = vss-workfile
       39       p-vss-archive     = vss-archive
       40       p-vss-description = vss-description
       41     .
       42   end procedure.
       43   procedure vss-get-parameters :
       44     define output parameter p-vss-parameters as character no-undo .
       45   end procedure.
       46   define new global shared variable g#vssrevis-logger as handle    no-undo .
       47   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       48   define variable v-vssrevis-logger                   as handle    no-undo .
       49   procedure vss-logevent :
       50     define input  parameter p-extra-paramters as character no-undo .
       51     define variable v-vssrevis-parameters as character no-undo .
       52     do
       53     on error undo, return error return-value
       54     :
       55       if  valid-handle(v-vssrevis-logger)
       56       and v-vssrevis-logger :get-signature("logevent") <> ""
       57       then do:
       58         run vss-get-parameters in this-procedure
       59           (output v-vssrevis-parameters
       60           ).
       61         run logevent in v-vssrevis-logger
       62           (input vss-workfile
       63           ,input vss-revision
       64           ,input v-vssrevis-parameters
       65           ,input p-extra-paramters
       66           ).
       67       end.
       68     end.
       69   end procedure.
       70   assign
       71     v-vssrevis-logger = g#vssrevis-logger
       72   .
       73   if  valid-handle(v-vssrevis-logger)
       74   and v-vssrevis-logger :get-signature("logevent") <> ""
       75   then do:
       76     assign
       77       v-vssrevis-logevent = true
       78     .
       79     run vss-logevent in this-procedure (input vss-description) .
       80   end.
       81   run addtask in this-procedure ("utl/proc-merc", substitute("&1":U ,p-list-db),iStart).
       82   if num-entries (p-list-db) > 30
       83   then
       84      run waitproc in this-procedure (substitute("Получение данных из Меркурий. По &1 БД .",num-entries (p-list-db))).
       85   else
       86      run waitproc in this-procedure (substitute("Получение данных из Меркурий. По БД &1.",p-list-db)).
