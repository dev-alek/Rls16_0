      542     field current-db-num  as integer
      543     field pack-num        as integer
      544     field rcvd-recs       as integer
      545     field total-recs      as integer
      546     field sys-key         as character
      547     field src_db-key      as character
      548     field ver-num         as character
      549     field prev-crc        as character
      550     field actual-date     as date
      551     field actual-time-int as integer
      552   .
      553   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      554   define  stream PrnLibStream.
      555   procedure prn-lib-prn-file :
      556     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      557     define input parameter p-DIsabledoptions as integer no-undo .
      558     define variable v-report-name as character no-undo .
      559     define variable v-user-action as character no-undo .
      560     define variable v-printed     as logical   no-undo .
      561     define variable v-exist       as logical   no-undo .
      562     do
      563       on error undo, return error
      564       :
      565       run prn-lib-get-report-name  in this-procedure (
      566         input parParentProc
      567         ,output v-report-name
      568         ).
      569   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      570   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      571     (input  v-report-name
      572     ,input  2
      573     ,output v-exist
      574     )  .
      575       if NOT v-exist then
      576       DO:
      577         Message
      578           "Нет заданий на печать ! "
      579           view-as alert-box .
      580         Return  .
      581       End.
      582       run gbl/prnfilen.w
      583         (input  ""
      584         ,input  p-DisabledOptions
      585         ,input  string(v-report-name )
      586         ,input  7
      587         ,output v-user-action
      588         ,output v-printed
      589         ) .
      590       if v-printed then
      591       do:
      592         return "YES" .
      593       end.
      594       else
      595       do:
      596         return "NO" .
      597       end.
      598     end.
      599   end procedure.
      600   procedure prn-lib-open-stream :
      601     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      602     define input parameter p-page-size    as integer no-undo .
      603     define input parameter p-is-stream    as logical no-undo .
      604     define input parameter p-append       as logical no-undo .
      605     define variable v-report-name as character no-undo .
      606     do
      607       on error undo, return error
      608       :
      609       run prn-lib-get-report-name  in this-procedure (
      610         input parParentProc
      611         ,output v-report-name
      612         ).
      613       if p-is-stream then
      614       do:
      615         if p-append then
      616         do:
      617           output stream PrnLibStream to value( v-report-name )
      618             page-size value(p-page-size) append .
      619         end.
      620         if not p-append then
      621         do:
      622           output stream PrnLibStream to value( v-report-name )
      623             page-size value(p-page-size) .
      624         end.
      625       end.
      626       if not p-is-stream then
      627       do:
      628         if p-append then
      629         do:
      630           output to value( v-report-name )
      631             page-size value(p-page-size) append .
      632         end.
      633         if not p-append then
      634         do:
      635           output to value( v-report-name )
      636             page-size value(p-page-size) .
      637         end.
      638       end.
      639     end.
      640   end procedure.
      641   procedure prn-lib-open-exp :
      642     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      643     define input parameter p-is-stream    as logical no-undo .
      644     define input parameter p-is-append    as logical no-undo .
      645     define output parameter p-ReportFileName as char init "report" no-undo.
      646     define output parameter p-process as logical no-undo .
      647     define variable glog as logical no-undo .
      648     do
      649       on error undo, return error
      650       :
      651       SYSTEM-DIALOG GET-FILE p-ReportFileName
      652         TITLE      "Укажите путь"
      653         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      654         ASK-OVERWRITE
      655         CREATE-TEST-FILE
      656         SAVE-AS
      657         USE-FILENAME
      658         DEFAULT-EXTENSION "txt"
      659         UPDATE glog
      660         .
      661       if not glog then  return.
      662       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      663       if p-is-stream then
      664       do:
      665         if p-is-append then
      666         do:
      667           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      668         end.
      669         else
      670         do:
      671           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      672         end.
      673       end.
      674       else
      675       do:
      676         if p-is-append then
      677         do:
      678           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      679         end.
      680         else
      681         do:
      682           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      683         end.
      684       end.
      685       p-process = yes.
      686     end.
      687   end procedure.
      688   procedure prn-lib-get-report-name :
      689     define input parameter parParentProc  as widget-handle no-undo.
      690     define output parameter p-report-name as character no-undo .
      691     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      692   end procedure.
      693   procedure prn-lib-reportviewer-report-name :
      694     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      695     define input parameter p-report-name-html as character no-undo .
      696     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      697   end procedure.
      698   procedure prn-lib-reportviewer :
      699     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      700     define input parameter p-report-name-html as character no-undo .
      701     define input parameter p-param        as character no-undo .
      702     define variable v-excel           as character no-undo init 'TRUE' .
      703     define variable v-value-character as character no-undo .
      704     define variable v-value-integer   as character no-undo .
      705     define variable v-value-date      as date      no-undo .
      706     define variable v-value-decimal   as decimal   no-undo .
      707     define variable rep-excel         as logical   no-undo .
      708     define variable excel-string      as character no-undo .
      709     define variable v-param-type      as character no-undo .
      710     define variable v-tth             as handle    no-undo .
      711     run adm/shattri.p (
      712       input "get":U
      713       ,input  ""
      714       ,input  0
      715       ,input  'report-glob':U
      716       ,input  'rep-excel':U
      717       ,output v-value-character
      718       ,output v-value-date
      719       ,output v-value-decimal
      720       ,output v-value-integer
      721       ,output rep-excel
      722       ,output v-param-type
      723       ,INPUT-OUTPUT table-handle v-tth
      724       )  .
      725     if rep-excel then v-excel = "TRUE" .
      726     else v-excel = "FALSE" .
      727     if p-param eq ""
      728     then
      729        p-param = "EXCEL:" + v-excel.
      730     else
      731        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      732     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      733   end procedure.
      734   DEFINE BUTTON bView
      735        LABEL "Просмотр"
      736        SIZE 15 BY 1.14.
      737   DEFINE QUERY BROWSE-route FOR
      738         esys-route,
      739         esys-route-dump SCROLLING.
      740   DEFINE BROWSE BROWSE-route
      741     QUERY BROWSE-route NO-LOCK DISPLAY
      742         esys-route-dump.esrd-action FORMAT "X(15)":U WIDTH 12.2
      743         esys-route-dump.esrd-dump-name COLUMN-LABEL "Сообщение" FORMAT "X(20)":U
      744               WIDTH 14.2
      745         esys-route-dump.esrd-dump-ord COLUMN-LABEL "Уник. код выгрузки" FORMAT "->>>>>>>>>>>>>>>>>>9":U
      746               WIDTH 21.2
      747         esys-route-dump.esrd-uniq-key-rec COLUMN-LABEL "Ключ записи" FORMAT "X(30)":U
      748               WIDTH 26.4
      749     ENABLE
      750         esys-route-dump.esrd-dump-name
      751         esys-route-dump.esrd-uniq-key-rec
      752       WITH NO-ROW-MARKERS SEPARATORS SIZE 81 BY 15 ROW-HEIGHT-CHARS .62 FIT-LAST-COLUMN.
      753   DEFINE FRAME Dialog-Frame
      754        bView AT ROW 1.24 COL 68.6 WIDGET-ID 4
      755        BROWSE-route AT ROW 2.67 COL 3 WIDGET-ID 200
      756        SPACE(2.19) SKIP(0.51)
      757       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      758            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      759            TITLE "Список сообщений" WIDGET-ID 100.
      760   ASSIGN
      761          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      762          FRAME Dialog-Frame:HIDDEN           = TRUE.
      763   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      764   DO:
      765     APPLY "END-ERROR":U TO SELF.
      766   END.
      767   ON CHOOSE OF bView IN FRAME Dialog-Frame
      768   DO:
      769     define variable vFile   as character no-undo.
      770     define variable vViewer as character no-undo.
      771     if esys-route-dump.esrd-blob-value-rec <> ? then
      772     do:
      773       vViewer = search("exe\ibsview.exe").
      774       if vViewer = ? then
      775       do:
      776         message "Не найден просмотрщик файлов ibsview.exe" view-as alert-box.
      777         return no-apply.
      778       end.
      779       vFile = substitute("&1mess&2.xml", session:temp-directory, esys-route-dump.esrd-dump-ord).
      780       copy-lob from esys-route-dump.esrd-blob-value-rec to file vFile no-error.
      781       if error-status:error then
      782         message "Файл занят" view-as alert-box.
      783       else
      784         os-command no-wait value(vViewer + " " + vFile).
      785     end.
      786   END.
      787   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      788   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      789   MAIN-BLOCK:
      790   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      791      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      792     RUN enable_UI.
      793     WAIT-FOR GO OF FRAME Dialog-Frame.
      794   END.
      795   RUN disable_UI.
      796   run deleteFiles in this-procedure.
      797   PROCEDURE deleteFiles :
      798   DEFINE VARIABLE cFileShort AS CHARACTER NO-UNDO .
      799   DEFINE VARIABLE cFileLong  AS CHARACTER NO-UNDO.
      800   DEFINE VARIABLE cType      AS CHARACTER NO-UNDO.
      801   input from os-dir(session:temp-directory).
      802   repeat:
      803     IMPORT cFileShort cFileLong cType .
      804     IF cType MATCHES "*F*" and cFileShort begins "mess" THEN
      805     DO:
      806       os-delete value(cFileLong).
      807     end.
      808   end.
      809   input close.
      810   END PROCEDURE.
      811   PROCEDURE disable_UI :
      812     HIDE FRAME Dialog-Frame.
      813   END PROCEDURE.
      814   PROCEDURE enable_UI :
      815     ENABLE bView BROWSE-route
      816         WITH FRAME Dialog-Frame.
      817     VIEW FRAME Dialog-Frame.
      818     OPEN QUERY BROWSE-route FOR EACH esys-route       WHERE esys-route.esys-id = iEsysId and  esys-route.db-num  = iDbNum and esys-route.esr-last-pack = iPackNum NO-LOCK,       EACH esys-route-dump WHERE esys-route-dump.esrd-dump-ord   = esys-route.esr-dump-ord NO-LOCK     BY esys-route.esr-dump-ord INDEXED-REPOSITION.
      819   END PROCEDURE.
