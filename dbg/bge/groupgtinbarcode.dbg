      714   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      715   function is-numeral return logical
      716     (input p-string   as character ,
      717      input char-avail as character) :
      718     define variable p-replace-string as character no-undo .
      719     define variable log-result       as logical  no-undo .
      720     if p-string = ? then
      721       return false .
      722     p-replace-string = p-string.
      723     if lookup ("*", char-avail) > 0 then
      724         p-replace-string = replace (p-replace-string, '*', '9').
      725     if lookup ("digit", char-avail) > 0 then
      726       assign
      727         p-replace-string = replace (p-replace-string, '0', '9')
      728         p-replace-string = replace (p-replace-string, '1', '9')
      729         p-replace-string = replace (p-replace-string, '2', '9')
      730         p-replace-string = replace (p-replace-string, '3', '9')
      731         p-replace-string = replace (p-replace-string, '4', '9')
      732         p-replace-string = replace (p-replace-string, '5', '9')
      733         p-replace-string = replace (p-replace-string, '6', '9')
      734         p-replace-string = replace (p-replace-string, '7', '9')
      735         p-replace-string = replace (p-replace-string, '8', '9')
      736         .
      737     else
      738        p-replace-string = replace (p-replace-string, '9', chr(15))
      739         .
      740     if lookup ("letter", char-avail) > 0 then
      741       assign
      742         p-replace-string = replace (p-replace-string, 'A', '9')
      743         p-replace-string = replace (p-replace-string, 'B', '9')
      744         p-replace-string = replace (p-replace-string, 'C', '9')
      745         p-replace-string = replace (p-replace-string, 'D', '9')
      746         p-replace-string = replace (p-replace-string, 'E', '9')
      747         p-replace-string = replace (p-replace-string, 'F', '9')
      748         p-replace-string = replace (p-replace-string, 'G', '9')
      749         p-replace-string = replace (p-replace-string, 'H', '9')
      750         p-replace-string = replace (p-replace-string, 'I', '9')
      751         p-replace-string = replace (p-replace-string, 'J', '9')
      752         p-replace-string = replace (p-replace-string, 'K', '9')
      753         p-replace-string = replace (p-replace-string, 'L', '9')
      754         p-replace-string = replace (p-replace-string, 'M', '9')
      755         p-replace-string = replace (p-replace-string, 'N', '9')
      756         p-replace-string = replace (p-replace-string, 'O', '9')
      757         p-replace-string = replace (p-replace-string, 'P', '9')
      758         p-replace-string = replace (p-replace-string, 'Q', '9')
      759         p-replace-string = replace (p-replace-string, 'R', '9')
      760         p-replace-string = replace (p-replace-string, 'S', '9')
      761         p-replace-string = replace (p-replace-string, 'T', '9')
      762         p-replace-string = replace (p-replace-string, 'U', '9')
      763         p-replace-string = replace (p-replace-string, 'V', '9')
      764         p-replace-string = replace (p-replace-string, 'W', '9')
      765         p-replace-string = replace (p-replace-string, 'X', '9')
      766         p-replace-string = replace (p-replace-string, 'Y', '9')
      767         p-replace-string = replace (p-replace-string, 'Z', '9')
      768         p-replace-string = replace (p-replace-string, '_', '9')
      769         .
      770     return p-replace-string = fill ('9', length (p-string)).
      771   end.
      772   define variable v-scan-str as character no-undo.
      773   define variable iLang      as integer   no-undo.
      774   define variable p-value-logical as logical no-undo.
      775   define variable p-value-character  as character no-undo.
      776   define variable p-value-date       as date no-undo.
      777   define variable p-value-decimal    as decimal no-undo.
      778   define variable p-value-integer    as integer no-undo.
      779   define variable p-param-type       as character no-undo.
      780   define variable v-tth as handle no-undo .
      781   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      782      LABEL "Отмена"
      783      SIZE 10 BY 1.
      784   DEFINE BUTTON Btn_OK AUTO-GO
      785      LABEL "Ввод"
      786      SIZE 10 BY 1.
      787   DEFINE VARIABLE f-type-mark  AS CHARACTER FORMAT "X(256)"
      788      LABEL "Тип маркировки"
      789      VIEW-AS COMBO-BOX INNER-LINES 5
      790      LIST-ITEM-PAIRS "","not-type",
      791      "Табачная продукция","tabak",
      792      "Обувь","shoes",
      793      "Духи и парфюмерия","perfume",
      794      "Легпром","industry",
      795      "Шины","tires",
      796      "Лекарства","apteka",
      797      "Фотокамеры/фотовспышки","photo",
      798      "Молочная продукция","milk",
      799      "Упакованная вода","water",
      800      "Стики","stiki"
      801      DROP-DOWN-LIST
      802      SIZE 33.5 BY 1.
      803   DEFINE VARIABLE f-bar-code   AS CHARACTER FORMAT "X(256)"
      804      LABEL "Штрих-код упаковки"
      805      VIEW-AS FILL-IN
      806      SIZE 33.5 BY 1.
      807   DEFINE VARIABLE f-bar-code-2 AS CHARACTER FORMAT "X(256)"
      808      LABEL "Штрих-код индивидуальной упаковки"
      809      VIEW-AS FILL-IN
      810      SIZE 33.5 BY 1.
      811   DEFINE VARIABLE f-gds-code   AS INTEGER   FORMAT ">>>>>>>>>>>>>>>9" INITIAL 0
      812      LABEL "Код товара"
      813      VIEW-AS FILL-IN
      814      SIZE 33.5 BY 1.
      815   DEFINE VARIABLE f-gds-name   AS CHARACTER FORMAT "X(256)"
      816      LABEL "Название товара"
      817      VIEW-AS FILL-IN
      818      SIZE 33.5 BY 1.
      819   DEFINE VARIABLE f-GTIN       AS CHARACTER FORMAT "X(256)"
      820      LABEL "GTIN упаковки"
      821      VIEW-AS FILL-IN
      822      SIZE 33.5 BY 1.
      823   DEFINE VARIABLE f-qnty AS INTEGER FORMAT ">>>9" INITIAL 0
      824        LABEL "Кол-во индивидуальных упаковок"
      825        VIEW-AS FILL-IN
      826        SIZE 14 BY 1.
      827   DEFINE FRAME Dialog-Frame
      828        Btn_OK AT ROW 1.25 COL 2
      829        Btn_Cancel AT ROW 1.25 COL 12
      830        f-gds-code AT ROW 3 COL 70.25 RIGHT-ALIGNED WIDGET-ID 12
      831        f-gds-name AT ROW 4.46 COL 70.25 RIGHT-ALIGNED WIDGET-ID 14
      832        f-bar-code AT ROW 5.92 COL 70.25 RIGHT-ALIGNED WIDGET-ID 16
      833        f-bar-code-2 AT ROW 7.46 COL 70.25 RIGHT-ALIGNED WIDGET-ID 24
      834        f-GTIN AT ROW 8.92 COL 35.75 COLON-ALIGNED WIDGET-ID 18
      835        f-qnty AT ROW 10.38 COL 35.75 COLON-ALIGNED WIDGET-ID 20
      836        f-type-mark AT ROW 11.83 COL 35.75 COLON-ALIGNED WIDGET-ID 22
      837        SPACE(2.87) SKIP(1.83)
      838       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      839            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      840            TITLE "Товар для ввода".
      841   ASSIGN
      842      FRAME Dialog-Frame:SCROLLABLE = FALSE.
      843   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      844      DO:
      845         run create-proc in this-procedure no-error .
      846         if return-value = 'cancel' then return no-apply .
      847      END.
      848   ON ENTRY OF f-bar-code IN FRAME Dialog-Frame
      849      DO:
      850         run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
      851         run adm/shattri.p (
      852                  input "get":U
      853                  ,input  v-cntxt-obj-type
      854                  ,input  v-cntxt-obj-code
      855                  ,input  'marking':U
      856                  ,input  'rus-key':U
      857                  ,output p-value-character
      858                  ,output p-value-date
      859                  ,output p-value-decimal
      860                  ,output p-value-integer
      861                  ,output p-value-logical
      862                  ,output p-param-type
      863                  ,input-output table-handle v-tth
      864                  ) no-error .
      865         IF p-value-logical = yes THEN  iLang = 68748313.
      866         run ActivateKeyboardLayout (input iLang, input 0).
      867      END.
      868   ON return,tab OF f-bar-code IN FRAME Dialog-Frame
      869      DO:
      870         run scan-barCode (NO).
      871         if return-value = 'cancel'
      872         then do:
      873            self:screen-value = "".
      874            return no-apply .
      875         end.
      876         if f-bar-code-2:SENSITIVE in frame Dialog-Frame = true then
      877         do:
      878            apply "entry":U to f-bar-code-2 in frame Dialog-Frame .
      879            return no-apply.
      880         end.
      881         else do:
      882            apply "entry":U to f-GTIN in frame Dialog-Frame .
      883            return no-apply.
      884         end.
      885      END.
      886   ON LEAVE OF f-bar-code IN FRAME Dialog-Frame
      887      DO:
      888         run scan-barCode (YES).
      889         if return-value = 'cancel'
      890         then do:
      891            self:screen-value = "".
      892            return no-apply .
      893         end.
      894      END.
      895   ON ENTRY OF f-bar-code-2 IN FRAME Dialog-Frame
      896      DO:
      897         run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
      898         run adm/shattri.p (
      899                  input "get":U
      900                  ,input  v-cntxt-obj-type
      901                  ,input  v-cntxt-obj-code
      902                  ,input  'marking':U
      903                  ,input  'rus-key':U
      904                  ,output p-value-character
      905                  ,output p-value-date
      906                  ,output p-value-decimal
      907                  ,output p-value-integer
      908                  ,output p-value-logical
      909                  ,output p-param-type
      910                  ,input-output table-handle v-tth
      911                  ) no-error .
      912         IF p-value-logical = yes THEN  iLang = 68748313.
      913         run ActivateKeyboardLayout (input iLang, input 0).
      914      END.
      915   ON return,tab,LEAVE OF f-bar-code-2 IN FRAME Dialog-Frame
      916      DO:
      917         if f-bar-code-2:screen-value <> "" then do:
      918         run scan-barCode1 .
      919         if return-value = 'cancel'
      920         then do:
      921            self:screen-value = "".
      922            return no-apply .
      923         end.
      924         if f-GTIN:SENSITIVE in frame Dialog-Frame = true then
      925         do:
      926            apply "entry":U to f-gtin in frame Dialog-Frame .
      927             return no-apply.
      928                  end.
      929         end.
      930      END.
      931   ON ENTRY OF f-GTIN IN FRAME Dialog-Frame
      932      DO:
      933         run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
      934         run adm/shattri.p (
      935                  input "get":U
      936                  ,input  v-cntxt-obj-type
      937                  ,input  v-cntxt-obj-code
      938                  ,input  'marking':U
      939                  ,input  'rus-key':U
      940                  ,output p-value-character
      941                  ,output p-value-date
      942                  ,output p-value-decimal
      943                  ,output p-value-integer
      944                  ,output p-value-logical
      945                  ,output p-param-type
      946                  ,input-output table-handle v-tth
      947                  ) no-error .
      948         IF p-value-logical = yes THEN  iLang = 68748313.
      949         run ActivateKeyboardLayout (input iLang, input 0).
      950      END.
      951   ON LEAVE OF f-GTIN IN FRAME Dialog-Frame
      952      DO:
      953         define variable vTXt     as character no-undo .
      954         define variable bar_code as character no-undo .
      955         vTXt = f-GTIN:screen-value.
      956         if    length(vtxt) > 14
      957            then
      958         do:
      959            if    (length(vtxt) eq 14 + 7 + 4 + 4
      960               or length(vtxt) eq 14 + 7 + 4 )
      961               then
      962               f-GTIN:screen-value = substring(vtxt,1,14).
      963            else if vtxt begins "01"
      964                  then
      965                  f-GTIN:screen-value = substring(vtxt,3,14).
      966               else
      967               do:
      968               end.
      969         end.
      970         if length(f-GTIN:screen-value) ne 14
      971         then do:
      972            message "Введенный код не Gtin. Gtin состоит из 14 символов."
      973               view-as alert-box.
      974            self:screen-value = "".
      975            return no-apply.
      976         end.
      977         bar_code = substr (f-GTIN:screen-value, 1, length (f-GTIN:screen-value) - 1).
      978         run str/chk-sum.p
      979            (input-output bar_code
      980            ) no-error .
      981         if error-status :error
      982            then
      983         do:
      984            message "Бар-код должен быть GTIN."
      985               view-as alert-box.
      986            self:screen-value = "".
      987            return  no-apply .
      988         end.
      989         if substr (bar_code, length (bar_code), 1) <> substr (f-GTIN:screen-value, length (bar_code), 1)
      990            then
      991         do:
      992            message "Бар-код должен быть GTIN."
      993               view-as alert-box.
      994            if session:debug-alert
      995               then
      996               message " Ваш код " + f-GTIN:screen-value + " Правильный GTIN " + bar_code
      997                  view-as alert-box.
      998            self:screen-value = "".
      999            return  no-apply .
     1000         end.
     1001         assign f-GTIN .
     1002      END.
     1003   ON LEAVE OF f-qnty IN FRAME Dialog-Frame
     1004      DO:
     1005         assign f-qnty .
     1006      END.
     1007   ON return,tab OF f-GTIN IN FRAME Dialog-Frame
     1008      DO:
     1009         if f-qnty:screen-value <> "" and f-qnty:screen-value <> "0" then
     1010         apply "entry" to f-type-mark IN FRAME Dialog-Frame.
     1011         else apply "entry" to f-qnty IN FRAME Dialog-Frame.
     1012         return no-apply.
     1013   END.
     1014   ON value-changed OF f-type-mark IN FRAME Dialog-Frame
     1015      DO:
     1016         assign f-type-mark .
     1017      END.
     1018   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1019      THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1020   MAIN-BLOCK:
     1021   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1022      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1023      run init-proc.
     1024         f-type-mark = p-type-mark .
     1025      run LoadKeyboardLayoutA (input v-scan-str, input 0, output iLang).
     1026      run adm/shattri.p (
     1027                  input "get":U
     1028                  ,input  v-cntxt-obj-type
     1029                  ,input  v-cntxt-obj-code
     1030                  ,input  'marking':U
     1031                  ,input  'rus-key':U
     1032                  ,output p-value-character
     1033                  ,output p-value-date
     1034                  ,output p-value-decimal
     1035                  ,output p-value-integer
     1036                  ,output p-value-logical
     1037                  ,output p-param-type
     1038                  ,input-output table-handle v-tth
     1039                  ) no-error .
     1040         IF p-value-logical = yes THEN  iLang = 68748313.
     1041      run ActivateKeyboardLayout (input iLang, input 0).
     1042      for each tt-goods where gds-code = 0:
     1043         delete tt-goods .
     1044      end.
     1045      RUN enable_UI.
     1046      WAIT-FOR GO OF FRAME Dialog-Frame focus f-bar-code.
     1047   END.
     1048   RUN disable_UI.
     1049   PROCEDURE init-proc :
     1050   define variable v-list as character no-undo.
     1051   define variable vi as integer no-undo.
     1052   define variable MarkType as ibs.th.gbl.map.mapstring no-undo.
     1053   define variable objType  as ibs.th.gbl.propmap no-undo.
     1054   MarkType = ObjSrv:Env:Marking:Types:MAPTYPE.
     1055   do vi = 1 to MarkType:GetItemByLab(vi):
     1056   objType  = ObjSrv:Env:Marking:Types:CurrProp.
     1057       v-list = v-list + "," + objType:Label_ + "," + objType:NameProp.
     1058   end.
     1059   v-list = trim(v-list, ",").
     1060   f-type-mark:list-item-pairs in frame Dialog-Frame = v-list.
     1061   END PROCEDURE.
     1062   PROCEDURE ActivateKeyboardLayout external "user32" :
     1063      define input parameter P1 as LONG.
     1064      define input parameter P2 as LONG.
     1065   END PROCEDURE.
     1066   PROCEDURE create-proc :
     1067      if f-GTIN = "" then
     1068      do:
     1069         message "Не заполено поле GTIN"
     1070            view-as alert-box.
     1071         return 'cancel' .
     1072      end.
     1073      if f-qnty < 2 or f-qnty = ? then
     1074      do:
     1075         message "Необходимо указывать количество более 1-го"
     1076            view-as alert-box.
     1077         return 'cancel' .
     1078      end.
     1079      if f-bar-code = "" then do:
     1080         message "Необходимо указать штрих код упаковки"
     1081         view-as alert-box.
     1082         return 'cancel' .
     1083      end.
     1084      if f-bar-code-2:screen-value in frame Dialog-Frame = "" then do:
     1085         run scan-barCode (NO).
     1086         if return-value = 'next'
     1087         then return 'cancel' .
     1088      end.
     1089      find first tt-goods no-lock where tt-goods.gds-code = f-gds-code and
     1090         tt-goods.GTIN = f-GTIN no-error .
     1091      if not available (tt-goods) then
     1092      do:
     1093         create tt-goods .
     1094         assign
     1095            tt-goods.barcode   = f-bar-code
     1096            tt-goods.gds-code  = f-gds-code
     1097            tt-goods.gds-name  = f-gds-name
     1098            tt-goods.GTIN      = f-GTIN
     1099            tt-goods.qnty      = f-qnty
     1100            .
     1101            tt-goods.type-mark = f-type-mark:screen-value in frame Dialog-Frame
     1102            .
     1103         p-recid = recid (tt-goods) .
     1104      end.
     1105      else
     1106      do:
     1107         p-recid = recid (tt-goods) .
     1108         message "Данные уже сохранены"
     1109            view-as alert-box.
     1110         return error .
     1111      end.
     1112   END PROCEDURE.
     1113   PROCEDURE disable_UI :
     1114      HIDE FRAME Dialog-Frame.
     1115   END PROCEDURE.
     1116   PROCEDURE enable_UI :
     1117      DISPLAY f-gds-code f-gds-name f-bar-code f-bar-code-2 f-GTIN f-qnty
     1118         f-type-mark
     1119         WITH FRAME Dialog-Frame.
     1120      ENABLE Btn_OK Btn_Cancel f-bar-code
     1121         WITH FRAME Dialog-Frame.
     1122   END PROCEDURE.
     1123   PROCEDURE LoadKeyboardLayoutA external "user32" :
     1124      define input  parameter P1 as char.
     1125      define input  parameter P2 as LONG.
     1126      define return parameter pret as LONG.
     1127   end procedure.
     1128   PROCEDURE scan-barCode :
     1129      define input  parameter ILEAVE as logical no-undo.
     1130      define variable v_list    as character no-undo .
     1131      define variable ii        as integer   no-undo .
     1132      define variable v-barCode as character no-undo .
     1133      define buffer buf_goods         for ub.goods .
     1134      define buffer buf_bar-code      for ub.bar-code .
     1135      define buffer buf_bar-code-attr for ub.bar-code-attr .
     1136      define buffer buf_prod-bc       for ub.prod-bc .
     1137      define buffer buf_prod-bc-attr  for ub.prod-bc-attr.
     1138      define buffer buf_goods-attr    for ub.goods-attr .
     1139      define buffer base-bar-code     for ub.bar-code.
     1140      define variable v-rid            as recid     no-undo .
     1141      define variable v-b-str          like ub.prod-bc.b-str no-undo .
     1142      define variable v-gds-attr-type  as character no-undo .
     1143      define variable v-gds-attr-value as character no-undo .
     1144      if f-bar-code:screen-value in frame Dialog-Frame = ""
     1145         then
     1146      do:
     1147         f-bar-code:screen-value in frame Dialog-Frame = v-scan-str.
     1148      end.
     1149      v-scan-str = "".
     1150      assign
     1151         v-barCode = f-bar-code:screen-value in frame Dialog-Frame.
     1152         f-bar-code = f-bar-code:screen-value in frame Dialog-Frame.
     1153      if not is-numeral (v-barCode,"digit")
     1154      then do:
     1155         message "Просканируйте штрих-код."
     1156         view-as alert-box.
     1157         f-bar-code = "" .
     1158         display f-bar-code with frame Dialog-Frame .
     1159         return 'cancel' .
     1160      end.
     1161      if v-barCode = "" then do:
     1162         message "Просканируйте штрих-код упаковки."
     1163         view-as alert-box.
     1164         return 'cancel' .
     1165      end.
     1166      if length(f-bar-code:screen-value) > 13 then do:
     1167         message "Штрих-код не должен превышать 13 символов."
     1168         view-as alert-box.
     1169         return 'cancel' .
     1170      end .
     1171      find first buf_prod-bc exclusive-lock where buf_prod-bc.b-str = string(v-barCode) no-error .
     1172      if not available (buf_prod-bc) then
     1173      do:
     1174         if not ILEAVE
     1175         THEN
     1176            message "Штрих-код не найден в БД. Просканируйте штрих-код индивидуальной упаковки"
     1177               view-as alert-box.
     1178         display f-bar-code with frame Dialog-Frame .
     1179         enable f-bar-code-2 with frame Dialog-Frame .
     1180         return 'next' .
     1181      end.
     1182      find first buf_bar-code no-lock where buf_bar-code.b-code = buf_prod-bc.b-code and buf_bar-code.cli-base-rate > 1 no-error .
     1183      if not available (buf_bar-code) then
     1184      do:
     1185         if not ILEAVE
     1186         THEN
     1187            message "Штрих-код не найден в БД. Просканируйте штрих-код индивидуальной упаковки"
     1188               view-as alert-box.
     1189         display f-bar-code with frame Dialog-Frame .
     1190         enable f-bar-code-2 with frame Dialog-Frame .
     1191         return 'next' .
     1192      end.
     1193      for first buf_goods no-lock where buf_goods.gds-code = buf_bar-code.gds-code:
     1194         f-gds-code = buf_goods.gds-code .
     1195         f-gds-name = buf_goods.gds-name .
     1196         f-qnty = buf_bar-code.cli-base-rate .
     1197         f-bar-code = v-barCode .
     1198         RUN gds-attr-value (
     1199            INPUT buf_goods.gds-code,
     1200            INPUT 'mark-type':U,
     1201            OUTPUT v-gds-attr-value,
     1202            OUTPUT v-gds-attr-type
     1203            ).
     1204         f-type-mark = v-gds-attr-value .
     1205            f-bar-code-2 = "" .
     1206         display
     1207            f-bar-code
     1208            f-bar-code-2
     1209            f-gds-code
     1210            f-gds-name
     1211            f-qnty
     1212            f-type-mark
     1213            with frame Dialog-Frame .
     1214         enable
     1215            f-GTIN
     1216            f-type-mark
     1217            with frame Dialog-Frame .
     1218         disable f-bar-code-2 f-qnty with frame Dialog-Frame .
     1219      end.
     1220   end procedure.
     1221   PROCEDURE scan-barCode1 :
     1222      define variable v_list    as character no-undo .
     1223      define variable ii        as integer   no-undo .
     1224      define variable v-barCode as character no-undo .
     1225      define buffer buf_goods         for ub.goods .
     1226      define buffer buf_bar-code      for ub.bar-code .
     1227      define buffer buf_bar-code-attr for ub.bar-code-attr .
     1228      define buffer buf_prod-bc       for ub.prod-bc .
     1229      define buffer buf_prod-bc-attr  for ub.prod-bc-attr.
     1230      define buffer buf_goods-attr    for ub.goods-attr .
     1231      define buffer base-bar-code     for ub.bar-code.
     1232      define variable v-rid            as recid     no-undo .
     1233      define variable v-b-str          like ub.prod-bc.b-str no-undo .
     1234      define variable v-gds-attr-type  as character no-undo .
     1235      define variable v-gds-attr-value as character no-undo .
     1236      if f-bar-code-2:screen-value in frame Dialog-Frame = ""
     1237         then
     1238      do:
     1239         f-bar-code-2:screen-value in frame Dialog-Frame = v-scan-str.
     1240      end.
     1241      v-scan-str = "".
     1242      assign
     1243         v-barCode = f-bar-code-2:screen-value in frame Dialog-Frame.
     1244      if not is-numeral (v-barCode,"digit")
     1245      then do:
     1246         message "Просканируйте штрих-код."
     1247         view-as alert-box.
     1248         return 'cancel' .
     1249      end.
     1250      if v-BarCode = ""
     1251      then do:
     1252         message "Просканируйте штрих-код индивидуальной упаковки"
     1253         view-as alert-box.
     1254         return 'cancel' .
     1255      end.
     1256      find first buf_prod-bc exclusive-lock where buf_prod-bc.b-str = string(v-barCode) no-error .
     1257      if not available (buf_prod-bc) then
     1258      do:
     1259         message "Штрих-код не найден в БД"
     1260            view-as alert-box.
     1261         return 'cancel' .
     1262      end.
     1263      find first buf_bar-code no-lock where buf_bar-code.b-code = buf_prod-bc.b-code and buf_bar-code.cli-base-rate = 1 no-error .
     1264      if not available (buf_bar-code) then
     1265      do:
     1266         message "Штрих-код не найден в БД."
     1267            view-as alert-box.
     1268         return 'cancel' .
     1269      end.
     1270      for first buf_goods no-lock where buf_goods.gds-code = buf_bar-code.gds-code:
     1271         f-gds-code = buf_goods.gds-code .
     1272         f-gds-name = buf_goods.gds-name .
     1273         f-bar-code-2 = v-barCode .
     1274         RUN gds-attr-value (
     1275            INPUT buf_goods.gds-code,
     1276            INPUT 'mark-type':U,
     1277            OUTPUT v-gds-attr-value,
     1278            OUTPUT v-gds-attr-type
     1279            ).
     1280         f-type-mark = v-gds-attr-value .
     1281         display
     1282            f-bar-code-2
     1283            f-gds-code
     1284            f-gds-name
     1285            f-qnty
     1286            f-type-mark
     1287            with frame Dialog-Frame .
     1288         enable
     1289            f-GTIN
     1290            f-type-mark
     1291            f-qnty
     1292            with frame Dialog-Frame .
     1293      end.
     1294   end procedure.
