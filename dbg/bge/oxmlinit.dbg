        1   block-level on error undo, throw.
        2   define input parameter p-parent-handle      as handle           no-undo.
        3   define input parameter p-esys-id            as integer          no-undo.
        4   define input parameter p-db-num             as integer          no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: oxmlinit.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: bge/oxmlinit.p $":U .
       10   define variable vss-description as character no-undo init "OpenXML. Начальная выгрузка данных внешней системы".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71       define variable v-table-handle      as handle       no-undo.
       72       define variable v-query-handle      as handle       no-undo.
       73       define buffer buf_ext-system            for ub.ext-system.
       74       define buffer buf_datatype-table        for ub.datatype-table.
       75       define buffer buf_esys-datatype-exp     for ub.esys-datatype-exp.
       76       define buffer buf_datatype-table-exp    for ub.datatype-table-exp.
       77   do
       78   for buf_ext-system
       79     , buf_datatype-table
       80     , buf_esys-datatype-exp
       81     , buf_datatype-table-exp
       82   on error undo, return error
       83   :
       84       do transaction
       85       on error undo, return error
       86       :
       87           find first buf_ext-system exclusive-lock
       88                where buf_ext-system.esys-id   = p-esys-id
       89                  and buf_ext-system.db-num    = p-db-num
       90           .
       91       end.
       92       find current buf_ext-system .
       93       for each buf_esys-datatype-exp no-lock
       94          where buf_esys-datatype-exp.esys-id  = p-esys-id
       95            and buf_esys-datatype-exp.db-num   = p-db-num
       96       on error undo, return error
       97       :
       98           for each buf_datatype-table-exp no-lock
       99              where buf_datatype-table-exp.dte-id  = buf_esys-datatype-exp.dte-id
      100           on error undo, return error
      101           :
      102               find first buf_datatype-table no-lock
      103                    where buf_datatype-table.dtt-name = buf_datatype-table-exp.dtt-name
      104               no-error.
      105               if available buf_datatype-table
      106               then do:
      107                   create buffer v-table-handle for table buf_datatype-table-exp.dtt-name.
      108                   create query v-query-handle.
      109                   v-query-handle :set-buffers( v-table-handle ).
      110                   v-query-handle :query-prepare( substitute( "for each &1", buf_datatype-table-exp.dtt-name ) ).
      111                   v-query-handle :query-open.
      112                   v-query-handle :get-first().
      113                   repeat
      114                   :
      115                       v-query-handle :get-next().
      116                       if v-query-handle :query-off-end then leave.
      117                       run nws/cr-route.p (
      118                             input substitute( "&1,&2", 'send-tbl-oxml':U, 'update':U )
      119                           , input buf_datatype-table-exp.dtt-name
      120                           , input v-table-handle
      121                           , input string( p-esys-id )
      122                       ) no-error.
      123                       if error-status :error
      124                       then do:
      125                           return error return-value.
      126                       end.
      127                   end.
      128                   delete object v-query-handle.
      129                   delete object v-table-handle.
      130               end.
      131           end.
      132       end.
      133       do transaction
      134       on error undo, return error
      135       :
      136           find first buf_ext-system exclusive-lock
      137                where buf_ext-system.esys-id   = p-esys-id
      138                  and buf_ext-system.db-num    = p-db-num
      139           .
      140           assign
      141               buf_ext-system.esys-status = integer( '1':U ).
      142           .
      143       end.
      144   end.
