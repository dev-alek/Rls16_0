       42   end procedure.
       43   define new global shared variable g#vssrevis-logger as handle    no-undo .
       44   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       45   define variable v-vssrevis-logger                   as handle    no-undo .
       46   procedure vss-logevent :
       47     define input  parameter p-extra-paramters as character no-undo .
       48     define variable v-vssrevis-parameters as character no-undo .
       49     do
       50     on error undo, return error return-value
       51     :
       52       if  valid-handle(v-vssrevis-logger)
       53       and v-vssrevis-logger :get-signature("logevent") <> ""
       54       then do:
       55         run vss-get-parameters in this-procedure
       56           (output v-vssrevis-parameters
       57           ).
       58         run logevent in v-vssrevis-logger
       59           (input vss-workfile
       60           ,input vss-revision
       61           ,input v-vssrevis-parameters
       62           ,input p-extra-paramters
       63           ).
       64       end.
       65     end.
       66   end procedure.
       67   assign
       68     v-vssrevis-logger = g#vssrevis-logger
       69   .
       70   if  valid-handle(v-vssrevis-logger)
       71   and v-vssrevis-logger :get-signature("logevent") <> ""
       72   then do:
       73     assign
       74       v-vssrevis-logevent = true
       75     .
       76     run vss-logevent in this-procedure (input vss-description) .
       77   end.
       78   define new global shared variable g#language as character no-undo .
       79   if g#language <> '' and g#language <> 'rus':U then do:
       80     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       81   end.
       82   define new global shared variable g#library  as handle no-undo .
       83   define new global shared variable g#library2 as handle no-undo .
       84   define   shared variable g#auto as logical no-undo.
       85   define   shared variable g#news as logical no-undo.
       86   define   shared variable g#oxml as logical no-undo.
       87   define   shared variable g#esys as logical no-undo.
       88   define   shared variable g#news-source-db as integer no-undo.
       89   define   shared variable g#esys-source-esys as integer no-undo.
       90   define   shared variable g#db-num as integer   no-undo .
       91   define   shared variable g#userid as character no-undo .
       92   define   shared variable g#passwd as character no-undo .
       93   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       94   function get-short-pack-name returns character ( input p-action as character
       95                                                   ,input p-pack-num as integer
       96                                                   ,input p-delivery-method as integer
       97                                                   ,input p-custom-pack-name as character
       98                                                   ,output p-custom-flag as logical
       99                                                   ):
      100   define variable v-short-pack-name as character no-undo .
      101   define buffer buf_esys-pck-rcvd for ub.esys-pck-rcvd.
      102   define buffer buf_clients for ub.clients.
      103   define variable v-int-point as character no-undo .
      104   define variable v-type as character no-undo .
      105   case p-delivery-method:
      106    when integer('3':U) then do:
      107      find first buf_clients no-lock where
      108               buf_clients.db-num = g#db-num
      109            and buf_clients.obj-type = 'маг':U no-error .
      110      if not available buf_clients then do:
      111       find first buf_clients no-lock where
      112                 buf_clients.db-num = g#db-num
      113             and buf_clients.obj-type = 'скл':U no-error .
      114      end.
      115      case p-action:
      116        when "put"
      117        or when "fput" then do:
      118           v-short-pack-name = (if available buf_clients
      119                              then  string(buf_clients.obj-code, (if buf_clients.obj-code > 999 then "9999" else "999"))
      120                              else "___") + "-" + "000" + "_"
      121                              + string( p-pack-num, "999999999":U ) + ".DAT":U.
      122        end.
      123        when "get"
      124        or when "fget" then do:
      125          v-short-pack-name = "000" + "-" +
      126                              (if available buf_clients
      127                              then  string(buf_clients.obj-code, (if buf_clients.obj-code > 999 then "9999" else "999"))
      128                              else "___") + "_"
      129                              + string( p-pack-num, "999999999":U ) + ".DAT":U.
      130        end.
      131      end case.
      132      p-custom-flag = yes.
      133    end.
      134    when integer('5':U) then do:
      135      if p-action = "get" then do:
      136        find first buf_esys-pck-rcvd  where
      137                   buf_esys-pck-rcvd.espr-pack-num = p-pack-num - 1
      138               and buf_esys-pck-rcvd.esys-id = p-esys-id
      139               and buf_esys-pck-rcvd.db-num = p-db-num
      140               and buf_esys-pck-rcvd.espr-cr-db-num = g#db-num no-error.
      141        if available buf_esys-pck-rcvd
      142        and (p-custom-pack-name = ""
      143             or
      144             num-entries(p-custom-pack-name, "_") < 2
      145             or  (num-entries(buf_esys-pck-rcvd.custom-pack-name, "_") >= 2
      146                  and entry(2, buf_esys-pck-rcvd.custom-pack-name, "_") >= entry(2, p-custom-pack-name, "_")
      147                  )
      148             ) then do:
      149          p-custom-flag = yes.
      150          return ''.
      151        end.
      152      end.
      153      p-custom-flag = yes.
      154      v-short-pack-name = p-custom-pack-name.
      155    end.
      156    when integer('9':U) then do:
      157      p-custom-flag = yes.
      158      v-short-pack-name = p-custom-pack-name.
      159    end.
      160    when integer('11':U) then do:
      161      case p-action:
      162        when "put"
      163        or when "fput" then do:
      164          run db-attr-value in this-procedure
      165              (input g#db-num
      166              ,input 'int-point':U
      167              ,output v-int-point
      168              ,output v-type
      169              ) no-error .
      170          p-custom-flag = yes.
      171          v-short-pack-name = v-int-point + "_00000_" + string(p-pack-num) + "_"
      172                            + string(day(now), "99") + string(month(now), "99") + string(year(now), "9999")
      173                            + substring(string(TIME, "HH:MM:SS"), 1, 2)
      174                            + substring(string(TIME, "HH:MM:SS"), 4, 2)
      175                            + substring(string(TIME, "HH:MM:SS"), 7, 2)
      176                            + ".xml" .
      177        end.
      178        when "get"
      179        or when "fget" then do:
      180          p-custom-flag = yes.
      181          v-short-pack-name = p-custom-pack-name.
      182        end.
      183      end case.
      184    end.
      185    otherwise do:
      186      v-short-pack-name = "o":U + string( p-pack-num, "999999999":U ) + ".":U.
      187    end.
      188   end case.
      189   return v-short-pack-name.
      190   end function.
      191   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      192   procedure esallatr-name :
      193   do
      194     on error undo, return error
      195     :
      196     define input  parameter p-code           as character no-undo .
      197     define output parameter p-type           as character no-undo .
      198     define output parameter p-format         as character no-undo .
      199     define output parameter p-label          as character no-undo .
      200     define output parameter p-user-can-edit  as logical   no-undo .
      201     define output parameter p-output-display as logical   no-undo .
      202     define output parameter p-other          as character no-undo .
      203       case p-code :
      204               when 'custom-pack-name':U then do:     assign     p-label = "Имя файла в ВС"     p-type = 'C':U      p-format = "X(255)"     p-label = "Имя файла в ВС"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      205               when 'route-custom-pack-name':U then do:     assign     p-label = "Иям файла в ВС"     p-type = 'C':U      p-format = "X(255)"     p-label = "Иям файла в ВС"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      206         otherwise do:
      207           undo, return error substitute("неизвестный атрибут ВС &1", p-code) .
      208         end.
      209       end.
      210     end.
      211   end procedure.
      212   procedure esallatr-value :
      213   do
      214     on error undo, return error
      215     :
      216     define input  parameter p-table-name as character no-undo .
      217     define input  parameter p-key1     as int64 no-undo .
      218     define input  parameter p-key2     as int64 no-undo .
      219     define input  parameter p-key3     as character no-undo .
      220     define input  parameter p-key4     as character no-undo .
      221     define input  parameter p-key5     as int64 no-undo .
      222     define input  parameter p-key6     as int64 no-undo .
      223     define input  parameter p-key7     as character no-undo .
      224     define input  parameter p-key8     as character no-undo .
      225     define input  parameter p-code     as character no-undo .
      226     define output parameter p-value    as character no-undo .
      227     define output parameter p-type     as character no-undo .
      228     define buffer buf_esys-all-attr for ub.esys-all-attr.
      229     define variable v-format         as character no-undo .
      230     define variable v-label          as character no-undo .
      231     define variable v-user-can-edit  as logical   no-undo .
      232     define variable v-output-display as logical   no-undo .
      233     define variable v-other          as character no-undo .
      234       run esallatr-name in this-procedure
      235         (input  p-code
      236         ,output p-type
      237         ,output v-format
      238         ,output v-label
      239         ,output v-user-can-edit
      240         ,output v-output-display
      241         ,output v-other
      242         ) no-error .
      243       if error-status :error then do:
      244         undo, return error return-value .
      245       end.
      246       Find first  buf_esys-all-attr no-lock where
      247                   buf_esys-all-attr.attr-code = p-code
      248              and  buf_esys-all-attr.table-name  = p-table-name
      249              and  buf_esys-all-attr.key1  = p-key1
      250              and  buf_esys-all-attr.key2  = p-key2
      251              and  buf_esys-all-attr.key3  = p-key3
      252              and  buf_esys-all-attr.key4  = p-key4
      253              and  buf_esys-all-attr.key5  = p-key5
      254              and  buf_esys-all-attr.key6  = p-key6
      255              and  buf_esys-all-attr.key7  = p-key7
      256              and  buf_esys-all-attr.key8  = p-key8  no-error .
      257      if avail buf_esys-all-attr then do:
      258       assign
      259       p-value = buf_esys-all-attr.attr-value.
      260      end.
      261      else do:
      262       assign
      263       p-value = if p-type = 'L':U then "no":U else "".
      264      end.
      265   end.
      266   end procedure.
      267   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
