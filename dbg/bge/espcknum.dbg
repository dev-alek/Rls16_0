      980   end procedure.
      981   procedure db-attr-delete :
      982     define input  parameter p-db-num   like ub.db-attr.db-num     no-undo .
      983     define input  parameter p-code     like ub.db-attr.attr-code  no-undo .
      984     define output parameter p-deleted  as logical no-undo.
      985     do
      986     on error undo, return error
      987     :
      988           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-delete in g#attr-lib
      989         (input  p-db-num
      990         ,input  p-code
      991         ,output p-deleted
      992         ) no-error .
      993       if error-status :error
      994       then do:
      995         undo, return error return-value .
      996       end.
      997     end.
      998   end procedure.
      999   procedure db-attr-news :
     1000     define input  parameter p-code           as character no-undo .
     1001     define output parameter p-news           as logical   no-undo .
     1002     do
     1003     on error undo, return error
     1004     :
     1005           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-news in g#attr-lib
     1006         (input  p-code
     1007         ,output p-news
     1008         ) no-error .
     1009       if error-status :error
     1010       then do:
     1011         undo, return error return-value .
     1012       end.
     1013     end.
     1014   end procedure.
     1015   procedure db-attr-manual-edit :
     1016     define input  parameter p-code           as character no-undo .
     1017     define output parameter p-section-num    as integer no-undo .
     1018     do
     1019     on error undo, return error
     1020     :
     1021           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-manual-edit in g#attr-lib
     1022         (input  p-code
     1023         ,output p-section-num
     1024         ) no-error .
     1025       if error-status :error
     1026       then do:
     1027         undo, return error return-value .
     1028       end.
     1029     end.
     1030   end procedure.
     1031   procedure db-attr-batch-edit :
     1032     define input  parameter p-code           as character no-undo .
     1033     define output parameter p-section-num    as integer no-undo .
     1034     do
     1035     on error undo, return error
     1036     :
     1037           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run db-attr-batch-edit in g#attr-lib
     1038         (input  p-code
     1039         ,output p-section-num
     1040         ) no-error .
     1041       if error-status :error
     1042       then do:
     1043         undo, return error return-value .
     1044       end.
     1045     end.
     1046   end procedure.
     1047     define buffer buf_esys-pck-sent for ub.esys-pck-sent .
     1048   //  define buffer buf_esys-pck-rcvd for ub.esys-pck-rcvd .
     1049     define buffer buf_esys-pck-keys for ub.esys-pck-keys .
     1050     define buffer buf_esys-all-attr for ub.esys-all-attr.
     1051     define buffer buf_temp-filelist for temp-filelist.
     1052     define variable v-work-dir as character no-undo .
     1053     define variable v-mess as character no-undo .
     1054     define variable v-new-pack as logical no-undo .
     1055     define variable v-to-return as logical no-undo .
     1056     define variable v-ftp-path-in as character no-undo .
     1057     define variable v-type as character no-undo .
     1058     define variable v-num-entries as integer no-undo .
     1059   do
     1060   on error undo, return error
     1061   :
     1062     run bge/esdirnam.p ( input p-action
     1063                         ,input p-esys-id
     1064                         ,input p-db-num
     1065                         ,input p-delivery-method
     1066                         ,input oxml-exch-dir
     1067                         ,input oxml-heap-dir
     1068                         ,output p-source-dir
     1069                         ,output p-target-dir
     1070                         ,output p-temp-dir
     1071                         ,output p-log-file-name
     1072                        ) .
     1073     file-info:file-name = p-source-dir .
     1074     if file-info:file-type begins "D":U then . else do :
     1075       os-create-dir value( p-source-dir ).
     1076       if os-error <> 0 then do:
     1077         run gbl/os-errnm.p ( input os-error, output v-mess ).
     1078         return error substitute("&1 Каталог &2 отсутствует, а создать его не удалось.&3&4"
     1079                                ,vss-workfile
     1080                                ,p-source-dir
     1081                                ,chr(10)
     1082                                ,v-mess
     1083                              ).
     1084       end.
     1085     end.
     1086     file-info:file-name = p-target-dir .
     1087     if file-info:file-type begins "D":U then . else do :
     1088       os-create-dir value( p-target-dir ).
     1089       if os-error <> 0 then do:
     1090         run gbl/os-errnm.p ( input os-error, output v-mess ) .
     1091         return error substitute("&1 Каталог &2 отсутствует, а создать его не удалось.&3&4"
     1092                                ,vss-workfile
     1093                                ,p-target-dir
     1094                                ,chr(10)
     1095                                ,v-mess
     1096                              ).
     1097       end.
     1098     end.
     1099     if p-pack-num = -1 then do:
     1100       run findPackNum in this-procedure (p-action, p-esys-id, p-db-num, p-delivery-method,
     1101                                          output p-pack-num) no-error .
     1102       if error-status:error then return error return-value .
     1103       v-new-pack = yes.
     1104     end.
     1105     if p-pack-num < 0 then do:
     1106       v-new-pack = yes.
     1107       p-pack-num = abs(p-pack-num).
     1108     end.
     1109     p-list-file-name =  oxml-heap-dir + chr(92) + "lst":U + string( p-pack-num, "999999999") + ".":U .
     1110     if (p-action = "put" or p-action = "fput") and p-custom-pack-name > '' then do:
     1111       assign
     1112       p-pack-name = p-custom-pack-name
     1113       p-custom-pack-flag = yes
     1114       .
     1115     end.
     1116     else do:
     1117       if p-action = "put" then do:
     1118         if p-custom-pack-name = ? then do:
     1119           find first buf_esys-pck-sent no-lock where
     1120                   buf_esys-pck-sent.esps-pack-num = p-pack-num
     1121               and buf_esys-pck-sent.esys-id = p-esys-id
     1122               and buf_esys-pck-sent.db-num = p-db-num
     1123               and buf_esys-pck-sent.esps-cr-db-num = g#db-num no-error.
     1124           if available buf_esys-pck-sent
     1125           and buf_esys-pck-sent.custom-pack-name <> ''
     1126           then do:
     1127             assign
     1128             p-pack-name = buf_esys-pck-sent.custom-pack-name
     1129             p-custom-pack-name = buf_esys-pck-sent.custom-pack-name
     1130             p-custom-pack-flag = yes
     1131             .
     1132           end.
     1133           else do:
     1134             assign
     1135             p-pack-name = get-short-pack-name( input p-action
     1136                                              , input p-pack-num
     1137                                              , input p-delivery-method
     1138                                              , input buf_esys-pck-sent.custom-pack-name
     1139                                              , output p-custom-pack-flag)
     1140             p-custom-pack-name = p-pack-name
     1141             .
     1142           end.
     1143         end.
     1144         else do:
     1145           assign
     1146           p-pack-name = get-short-pack-name( input p-action
     1147                                           , input p-pack-num
     1148                                           , input p-delivery-method
     1149                                           , input p-custom-pack-name
     1150                                           , output p-custom-pack-flag)
     1151           p-custom-pack-name = p-pack-name
     1152           .
     1153         end.
     1154       end.
     1155       if p-action = "get" then do:
     1156         if p-delivery-method = integer('11':U) then do:
     1157             empty temp-table temp-filelist .
     1158             run filelist-init in this-procedure
     1159             (input p-source-dir
     1160             ,input true
     1161             ,input "xml,zip" // ,p7s,p7c"
     1162   
     1163             ,input ""
     1164             ) no-error.
     1165             
     1166             for each buf_temp-filelist exclusive-lock :
     1167                 /* 23/VIII-2018 заглушка: исключаем файлы с электронной подисью,
     1168                                 чтобы они читались строго позже файлов с данными */
     1169                 if (p-sign-fileext > "") and (buf_temp-filelist.file-extension = p-sign-fileext) then do :
     1170                     delete buf_temp-filelist .
     1171                     next .
     1172                 end . 
     1173                 /* 05/IX-2018 ещё заглушка: если в настройках в bge/oxmlspci.w указали неправильное расширение,
     1174                                             а файлы с электронной подписью всё же пришли */
     1175                 if can-do("p7s,p7c", buf_temp-filelist.file-extension) then do :
     1176                     delete buf_temp-filelist .
     1177                     next .
     1178                 end . 
     1179               v-num-entries = num-entries(buf_temp-filelist.file-name, "_") .
     1180                 if v-num-entries = 4
     1181                 or (v-num-entries = 5 and buf_temp-filelist.file-name begins "ack")
     1182                 then .
     1183                 else do :
     1184                     delete buf_temp-filelist .
     1185                     next .
     1186                 end.
     1187             end.
     1188             find first buf_temp-filelist no-error.
     1189             if available buf_temp-filelist
     1190             then do :
     1191                 p-custom-pack-name = buf_temp-filelist.file-name .
     1192             end.
     1193         end.
     1194         
     1195         find first buf_esys-all-attr share-lock where
     1196                 buf_esys-all-attr.attr-code = 'custom-pack-name':U
     1197             and buf_esys-all-attr.table-name = 'esys-pck-rcvd':U
     1198             and buf_esys-all-attr.key1 = p-pack-num
     1199             and buf_esys-all-attr.key2 = p-esys-id
     1200             and buf_esys-all-attr.key5 = p-db-num
     1201             and buf_esys-all-attr.key6 = ibs.th.gbl.gbl-var:g#db-num no-error.
     1202         assign
     1203         p-pack-name = get-short-pack-name( input p-action
     1204                                         , input p-pack-num
     1205                                         , input p-delivery-method
     1206                                         , input p-custom-pack-name
     1207                                         , output p-custom-pack-flag)
     1208         p-custom-pack-name = (if p-custom-pack-flag
     1209                               then p-pack-name
     1210                               else p-custom-pack-name)
     1211         .
     1212         if p-pack-name = '' then do:
     1213           v-to-return = yes.
     1214           /*не можем сделать просто return - надо еще директорию создать*/
     1215         end.
     1216         if not v-to-return then do:
     1217           if v-new-pack = yes
     1218           and p-custom-pack-flag
     1219           then do:
     1220           if not available buf_esys-all-attr then do:
     1221             create buf_esys-all-attr.
     1222             assign
     1223             buf_esys-all-attr.attr-code = 'custom-pack-name':U
     1224             buf_esys-all-attr.table-name = 'esys-pck-rcvd':U
     1225             buf_esys-all-attr.key1 = p-pack-num
     1226             buf_esys-all-attr.key2 = p-esys-id
     1227             buf_esys-all-attr.key5 = p-db-num
     1228             buf_esys-all-attr.key6 = ibs.th.gbl.gbl-var:g#db-num
     1229             .
     1230           end.
     1231           buf_esys-all-attr.attr-value = p-custom-pack-name .
     1232           end. /*if v-new-pack = yes*/
     1233         end. /*if not v-to-return then do:*/
     1234       end. /*if p-action = "get" then do:*/
     1235     end. /*else if (p-action = "put" or p-action = "fput")*/
     1236   
     1237   
     1238   end.
     1239   
     1240   procedure findPackNum private :
     1241   define input  parameter p-action   as character no-undo .
     1242   define input  parameter p-esys-id  as integer no-undo .
     1243   define input  parameter p-db-num   as integer no-undo .
     1244   define input  parameter p-delivery-method as integer no-undo .
     1245   define output parameter p-pack-num as integer no-undo .
     1246   define variable v-cr-db-num as integer no-undo .
     1247   define variable v-s-method  as character no-undo .
     1248   define buffer buf_esys-pck-rcvd for ub.esys-pck-rcvd .
     1249   define buffer buf_esys-pck-sent for ub.esys-pck-sent .
     1250   
     1251     assign
     1252       v-cr-db-num = ibs.th.gbl.gbl-var:g#db-num
     1253       v-s-method  = string(p-delivery-method)
     1254     no-error.
     1255     case p-action :
     1256       
     1257       when "get":U then do:
     1258         find last buf_esys-pck-rcvd no-lock
     1259             where buf_esys-pck-rcvd.esys-id = p-esys-id
     1260               and buf_esys-pck-rcvd.db-num  = p-db-num
     1261               and buf_esys-pck-rcvd.espr-cr-db-num = v-cr-db-num
     1262             use-index pi no-error .
     1263         if available buf_esys-pck-rcvd then
     1264           p-pack-num = buf_esys-pck-rcvd.espr-pack-num + 1 .
     1265         else /* "первый", он же - "нулевой" пакет */
     1266           p-pack-num = (if v-s-method = '2':U
     1267                         or v-s-method = '1':U
     1268                         or v-s-method = '3':U then 1 else 0) .
     1269       end. /* end_of "get":U */
     1270       when "fget":U then do:
     1271         p-pack-num = 0.
     1272       end.
     1273   
     1274       when "put":U then do:
     1275         find last buf_esys-pck-sent no-lock
     1276             where buf_esys-pck-sent.esys-id = p-esys-id
     1277               and buf_esys-pck-sent.db-num  = p-db-num
     1278               and buf_esys-pck-sent.esps-cr-db-num = v-cr-db-num
     1279             use-index pi no-error .
     1280         if available buf_esys-pck-sent then
     1281           p-pack-num = buf_esys-pck-sent.esps-pack-num + 1 .
     1282         else /* "первый", он же - "нулевой" пакет */
     1283           p-pack-num = (if v-s-method = '11':U then 1 else 0) .
     1284       end. /* end_of "put":U */
     1285       when "fput" then do:
     1286           /*экспорт файла*/
     1287           p-pack-num = (if v-s-method = '11':U then 1 else 0) .
     1288       end.
     1289   
     1290       otherwise do:
     1291         return error substitute("&1 &2 &3&4Не предусмотрена операция &5 для &1&4"
     1292                                ,vss-workfile, vss-revision, vss-description 
     1293                                ,chr(10)
     1294                                ,p-action
     1295                              ).
     1296       end.
     1297     end case . /* end_of case_p_action */
     1298     
     1299   end procedure . /* end_of findPackNum */
     1300   
     1301   /* $Workfile: espcknum.p $ end */
