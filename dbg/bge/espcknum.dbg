      434           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ext-system-attr-batch-edit in g#attr-lib
      435         (input  p-code
      436         ,output p-section-num
      437         ) no-error .
      438       if error-status :error
      439       then do:
      440         undo, return error return-value .
      441       end.
      442     end.
      443   end procedure.
      444   define variable vss-include-info3 as character format "X(65)" no-undo
      445   initial "@(#)$Workfile$ $Revision$".
      446   define variable v-filelist-total-file-num           as integer      no-undo .
      447   define variable v-filelist-total-dir-num            as integer      no-undo .
      448   define variable v-filelist-main-procedure-handle    as handle       no-undo .
      449   define variable v-filelist-main-procedure-name      as character    no-undo .
      450   define temp-table temp-dirlist no-undo
      451       field dir-full-name     as character
      452       field dir-short-name    as character
      453       field need-process      as logical
      454       index xpk is primary unique dir-full-name
      455   .
      456   define temp-table temp-filelist no-undo
      457     field file-name        as character
      458     field file-name-no-ext as character
      459     field file-extension   as character
      460     field directory-name   as character
      461     field full-name        as character
      462     field dir-short-name   as character
      463     field need-process     as logical
      464     index xpk is unique primary full-name
      465     index xie1 directory-name file-name
      466     index xie2 directory-name file-name-no-ext
      467     index xie3 file-name
      468     index xie4 file-name-no-ext
      469     index xie5 need-process file-name
      470     .
      471   define stream dir-list .
      472   procedure filelist-get-file-num :
      473     define output parameter p-file-num as integer   no-undo .
      474     do
      475     on error undo, return error return-value
      476     :
      477       assign
      478         p-file-num = v-filelist-total-file-num
      479       .
      480     end.
      481   end procedure.
      482   procedure filelist-clear :
      483     do
      484     on error undo, return error return-value
      485     :
      486       define buffer buf_filelist for temp-filelist .
      487       assign
      488         v-filelist-total-file-num = 0
      489       .
      490       for each buf_filelist
      491       on error undo, return error
      492       :
      493         delete buf_filelist .
      494       end.
      495     end.
      496   end procedure.
      497   procedure filelist-init :
      498     do
      499     on error undo, return error
      500     :
      501       define input parameter p-dir-name       as character no-undo .
      502       define input parameter p-filter-ext     as logical   no-undo .
      503       define input parameter p-ext-list       as character no-undo .
      504       define input parameter p-dir-short-name as character no-undo .
      505       define buffer buf_temp-filelist for temp-filelist .
      506       if p-filter-ext = true
      507          and p-ext-list = ?
      508       or (p-filter-ext = false
      509          and p-ext-list <> ?
      510          and p-ext-list <> "":U
      511          )
      512       then do:
      513         message
      514           vss-workfile vss-revision vss-description skip
      515           "Ошибка задания входных параметров" skip
      516           "p-filter-ext" p-filter-ext skip
      517           "p-ext-list"   p-ext-list   skip
      518           view-as alert-box error .
      519         undo, return error .
      520       end.
      521       for each buf_temp-filelist
      522         where buf_temp-filelist.directory-name = p-dir-name
      523       on error undo, return error return-value
      524       :
      525         delete buf_temp-filelist .
      526       end.
      527       input stream dir-list from os-dir( p-dir-name ).
      528       define variable v-file                  as character no-undo .
      529       define variable v-path                  as character no-undo .
      530       define variable v-mask                  as character no-undo .
      531       define variable v-extension             as character no-undo .
      532       define variable v-file-name-without-ext as character no-undo .
      533       repeat
      534       on error undo, return error
      535       :
      536         import stream dir-list v-file v-path v-mask .
      537         if  v-mask <> ?
      538         and v-mask begins 'F':u
      539         then do:
      540         end.
      541         else do:
      542           next .
      543         end.
      544         if num-entries(v-file, '.':u) > 1
      545         then do:
      546           assign
      547             v-extension = entry(num-entries(v-file, '.':u), v-file,  '.':u )
      548             v-file-name-without-ext = entry(num-entries(v-file, '.':u) - 1, v-file, '.':u )
      549           .
      550         end.
      551         else do:
      552           assign
      553             v-extension = ''
      554             v-file-name-without-ext = v-file
      555           .
      556         end.
      557         if p-filter-ext = true
      558         then do:
      559           if lookup(v-extension, p-ext-list) = 0
      560           then do:
      561             next .
      562           end.
      563         end.
      564         create buf_temp-filelist .
      565         assign
      566           buf_temp-filelist.file-name        = v-file
      567           buf_temp-filelist.directory-name   = p-dir-name
      568           buf_temp-filelist.file-name-no-ext = v-file-name-without-ext
      569           buf_temp-filelist.file-extension   = v-extension
      570           buf_temp-filelist.full-name        = p-dir-name + '/':u + v-file
      571           buf_temp-filelist.dir-short-name   = p-dir-short-name
      572         .
      573         assign
      574           v-filelist-total-file-num = v-filelist-total-file-num + 1
      575         .
      576         if v-filelist-main-procedure-handle <> ?
      577         then do:
      578           run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle
      579             (input "file":U
      580             , input v-filelist-total-file-num
      581             , input buf_temp-filelist.full-name
      582             , input buf_temp-filelist.file-name
      583             ) no-error.
      584           if error-status :error
      585           then do:
      586             message
      587               vss-workfile vss-revision vss-description skip
      588               "filelist-dirlist-subdir-init" skip(1)
      589               skip "Ошибка при вызове процедуры вывода"
      590               skip "результатов сканирования каталогов."
      591               skip return-value
      592               skip trim(error-status :get-message(1))
      593                       trim(error-status :get-message(2))
      594                       trim(error-status :get-message(3))
      595               view-as alert-box error.
      596             undo, return error .
      597           end.
      598         end.
      599       end.
      600       input stream dir-list close .
      601       return.
      602     end.
      603   end procedure.
      604   procedure filelist-dirlist-init-by-list :
      605     do
      606     on error undo, return error
      607     :
      608       define input parameter p-root-dir   as character no-undo .
      609       define input parameter p-dir-list   as character no-undo .
      610       define input parameter p-filter-ext as logical   no-undo .
      611       define input parameter p-ext-list   as character no-undo .
      612       define variable v-num-appdir as integer   no-undo .
      613       do v-num-appdir = 1 to num-entries(p-dir-list)
      614       :
      615         define variable v-curr-dir  as character no-undo .
      616         assign
      617           v-curr-dir = entry(v-num-appdir, p-dir-list)
      618         .
      619         run filelist-init in this-procedure
      620           (input p-root-dir + '/':u + v-curr-dir
      621           ,input p-filter-ext
      622           ,input p-ext-list
      623           ,input v-curr-dir
      624           ) .
      625       end.
      626     end.
      627   end procedure.
      628   procedure filelist-dirlist-clear :
      629     do
      630     on error undo, return error
      631     :
      632       define buffer buf_temp-dirlist for temp-dirlist .
      633       assign
      634           v-filelist-total-dir-num = 0
      635       .
      636       for each buf_temp-dirlist
      637       on error undo, return error
      638       :
      639         delete buf_temp-dirlist .
      640       end.
      641     end.
      642   end procedure.
      643   procedure filelist-dirlist-subdir-init :
      644   define input parameter p-dir-name   as character no-undo .
      645       define buffer buf_temp-dirlist for temp-dirlist .
      646   do
      647   for buf_temp-dirlist
      648   on error undo, return error
      649   :
      650       assign
      651           file-info :file-name = p-dir-name
      652       .
      653       if file-info :full-pathname = ?
      654       or index( file-info :file-type, "D" ) = 0
      655       then do:
      656           message
      657               vss-workfile vss-revision vss-description skip
      658               "filelist-dirlist-init: Заданного каталога не существует."
      659               skip (1)
      660               skip "Задан каталог:"
      661               skip substitute( "'&1'", p-dir-name )
      662           view-as alert-box error .
      663           undo, return error .
      664       end.
      665       input stream dir-list from os-dir( p-dir-name ).
      666       define variable v-file                  as character no-undo .
      667       define variable v-path                  as character no-undo .
      668       define variable v-mask                  as character no-undo .
      669       file-in-directory:
      670       repeat
      671       on error undo, return error
      672       :
      673           import stream dir-list
      674               v-file
      675               v-path
      676               v-mask
      677           .
      678           if  v-mask = ?
      679           or index( v-mask, 'D':u ) = 0
      680           or v-file = ".":U
      681           or v-file = "..":U
      682           then do:
      683               next file-in-directory.
      684           end.
      685           else do:
      686               find first buf_temp-dirlist
      687                    where buf_temp-dirlist.dir-full-name    = v-path
      688               no-error.
      689               if not available buf_temp-dirlist
      690               then do:
      691                   create buf_temp-dirlist .
      692                   assign
      693                       buf_temp-dirlist.dir-full-name    = v-path
      694                       buf_temp-dirlist.dir-short-name   = v-file
      695                       buf_temp-dirlist.need-process     = yes
      696                   .
      697               end.
      698               assign
      699                   v-filelist-total-dir-num = v-filelist-total-dir-num + 1
      700               .
      701               if v-filelist-main-procedure-handle <> ?
      702               then do:
      703                   run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle (
      704                         input "dir":U
      705                       , input v-filelist-total-dir-num
      706                       , input buf_temp-dirlist.dir-full-name
      707                       , input buf_temp-dirlist.dir-short-name
      708                   ) no-error.
      709                   if error-status :error
      710                   then do:
      711                       message
      712                           vss-workfile vss-revision vss-description skip
      713                           "filelist-dirlist-subdir-init"
      714                           skip(1)
      715                           skip "Ошибка при вызове процедуры вывода"
      716                           skip "результатов сканирования каталогов."
      717                           skip return-value
      718                           skip trim(error-status :get-message(1))
      719                                trim(error-status :get-message(2))
      720                                trim(error-status :get-message(3))
      721                       view-as alert-box error.
      722                       undo, return error .
      723                   end.
      724               end.
      725           end.
      726       end.
      727       input stream dir-list close .
      728   end.
      729   end procedure.
      730   procedure filelist-dirlist-init :
      731   define input parameter p-dir-name   as character no-undo .
      732       define variable v-file  as character no-undo.
      733       define variable v-path  as character no-undo.
      734       define variable v-mask  as character no-undo.
      735       define buffer buf_temp-dirlist for temp-dirlist .
      736   do
      737   for buf_temp-dirlist
      738   on error undo, return error
      739   :
      740       assign
      741           file-info :file-name = p-dir-name
      742       .
      743       if file-info :full-pathname = ?
      744       or index( file-info :file-type, "D" ) = 0
      745       then do:
      746           message
      747               vss-workfile vss-revision vss-description skip
      748               "filelist-dirlist-init: Заданного каталога не существует."
      749               skip (1)
      750               skip "Задан каталог:"
      751               skip substitute( "'&1'", p-dir-name )
      752           view-as alert-box error .
      753           undo, return error .
      754       end.
      755       for each buf_temp-dirlist
      756          where buf_temp-dirlist.dir-full-name begins file-info :full-pathname
      757       on error undo, return error return-value
      758       :
      759           delete buf_temp-dirlist .
      760       end.
      761       create buf_temp-dirlist .
      762       assign
      763           buf_temp-dirlist.dir-full-name    = file-info :full-pathname
      764           buf_temp-dirlist.dir-short-name   = file-info :file-name
      765           buf_temp-dirlist.need-process     = yes
      766       .
      767       do
      768       while available buf_temp-dirlist
      769       on error undo, return error
      770       :
      771           run filelist-dirlist-subdir-init in this-procedure (
      772               input buf_temp-dirlist.dir-full-name
      773           ).
      774           assign
      775               buf_temp-dirlist.need-process = no
      776           .
      777           find first buf_temp-dirlist
      778                where buf_temp-dirlist.need-process = yes
      779           no-error.
      780       end.
      781   end.
      782   end procedure.
      783   procedure filelist-set-procedure-handle :
      784   define input parameter p-proc-handle    as handle           no-undo.
      785   define input parameter p-proc-name      as character        no-undo.
      786       define variable v-signature    as character    no-undo.
      787   do
      788   on error undo, return error
      789   :
      790       if p-proc-handle = ?
      791       or not valid-handle( p-proc-handle )
      792       or p-proc-handle :get-signature( p-proc-name ) = ""
      793       then do:
      794           assign
      795               v-filelist-main-procedure-handle = ?
      796               v-filelist-main-procedure-name   = ""
      797           .
      798           undo, return error "filelist-set-procedure-handle: Ошибка передачи handle основной процедуры или имени процедуры обработки результатов сканирования каталогов.".
      799       end.
      800       else do:
      801           assign
      802               v-signature = p-proc-handle :get-signature( p-proc-name )
      803           .
      804           if entry(   1, v-signature )    = "PROCEDURE":U
      805           and entry( 1, entry(  3, v-signature ), " ":U ) = "INPUT":U
      806           and entry( 3, entry(  3, v-signature ), " ":U ) = "CHARACTER":U
      807           and entry( 1, entry(  4, v-signature ), " ":U ) = "INPUT":U
      808           and entry( 3, entry(  4, v-signature ), " ":U ) = "INTEGER":U
      809           and entry( 1, entry(  5, v-signature ), " ":U ) = "INPUT":U
      810           and entry( 3, entry(  5, v-signature ), " ":U ) = "CHARACTER":U
      811           and entry( 1, entry(  6, v-signature ), " ":U ) = "INPUT":U
      812           and entry( 3, entry(  6, v-signature ), " ":U ) = "CHARACTER":U
      813           then do:
      814               assign
      815                   v-filelist-main-procedure-handle = p-proc-handle
      816                   v-filelist-main-procedure-name   = p-proc-name
      817               .
      818           end.
      819           else do:
      820               assign
      821                   v-filelist-main-procedure-handle = ?
      822                   v-filelist-main-procedure-name   = ""
      823               .
      824               undo, return error "filelist-set-procedure-handle: Ошибка задания параметров процедуры обработки результатов сканирования каталогов.".
      825           end.
      826       end.
      827   end.
      828   end procedure.
      829   procedure filelist-clear-procedure-handle :
      830   do
      831   on error undo, return error
      832   :
      833       assign
      834           v-filelist-main-procedure-handle = ?
      835           v-filelist-main-procedure-name   = ?
      836       .
      837   end.
      838   end procedure.
      839   procedure filelist-build-by-dirlist :
      840       define buffer buf_temp-dirlist      for temp-dirlist.
      841   do
      842   for buf_temp-dirlist
      843   on error undo, return error
      844   :
      845       for each buf_temp-dirlist
      846       on error undo, return error
      847       :
      848           run filelist-init in this-procedure (
      849                 input buf_temp-dirlist.dir-full-name
      850               , input no
      851               , input "":U
      852               , input buf_temp-dirlist.dir-short-name
      853           ).
      854       end.
      855   end.
      856   end procedure.
      857   procedure filelist-check-dir-exists :
      858   define input parameter p-dir-name   as character        no-undo.
      859   define output parameter p-exists    as logical          no-undo.
      860   do
      861   on error undo, return error
      862   :
      863       assign
      864           file-info :file-name = p-dir-name
      865       .
      866       if file-info :file-type <> ?
      867       and substring( file-info :file-type, 1, 1 ) = "D":U
      868       then do:
      869           assign
      870               p-exists = yes
      871           .
      872       end.
      873       else do:
      874           assign
      875               p-exists = no
      876           .
      877       end.
      878   end.
      879   end procedure.
      880   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      881   procedure db-attr-code :
