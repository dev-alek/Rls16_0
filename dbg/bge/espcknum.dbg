        1   block-level on error undo, throw.
        2   define input        parameter p-action         as   character    no-undo .
        3   define input        parameter p-esys-id        like ub.ext-system.esys-id no-undo .
        4   define input        parameter p-db-num         like ub.ext-system.db-num no-undo .
        5   define input        parameter p-delivery-method as integer   no-undo .
        6   define input        parameter oxml-exch-dir    as character no-undo .
        7   define input        parameter oxml-heap-dir    as character no-undo .
        8   define input        parameter p-sign-fileext   as character no-undo .
        9   define input-output parameter p-pack-num       as   integer      no-undo .
       10   define input-output parameter p-custom-pack-name as character no-undo .
       11   define output       parameter p-pack-name      as   character    no-undo .
       12   define output       parameter p-source-dir     as   character    no-undo .
       13   define output       parameter p-target-dir     as   character    no-undo .
       14   define output       parameter p-temp-dir       as   character    no-undo .
       15   define output       parameter p-log-file-name  as character no-undo .
       16   define output       parameter p-list-file-name as character no-undo .
       17   define output       parameter p-custom-pack-flag as logical no-undo .
       18   define variable vss-revision    as character no-undo init "$Revision: 0704feb42aff, 2004, rls $":U .
       19   define variable vss-author      as character no-undo init "$Author: ostroukhov $":U .
       20   define variable vss-date        as character no-undo init "$Date: Wed Sep 18 21:02:01 2019 +0300 $":U .
       21   define variable vss-workfile    as character no-undo init "$Workfile: espcknum.p $":U .
       22   define variable vss-archive     as character no-undo init "$Archive: bge/espcknum.p $":U .
       23   define variable vss-description as character no-undo init "Генерация для ВС номера пакета, имени файла пакета, имени каталога источника и каталога назначени".
       24   procedure vss-get-info :
       25     define output parameter p-vss-revision    like vss-revision    no-undo .
       26     define output parameter p-vss-author      like vss-author      no-undo .
       27     define output parameter p-vss-date        like vss-date        no-undo .
       28     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       29     define output parameter p-vss-archive     like vss-archive     no-undo .
       30     define output parameter p-vss-description like vss-description no-undo .
       31     assign
       32       p-vss-revision    = vss-revision
       33       p-vss-author      = vss-author
       34       p-vss-date        = vss-date
       35       p-vss-workfile    = vss-workfile
       36       p-vss-archive     = vss-archive
       37       p-vss-description = vss-description
       38     .
       39   end procedure.
       40   procedure vss-get-parameters :
