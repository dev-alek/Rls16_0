        1   define input parameter p-esys-id           like ub.esys-pck-sent.esys-id    no-undo.
        2   define input parameter p-db-num            like ub.esys-pck-sent.db-num    no-undo.
        3   define input parameter p-esps-cr-db-num    like ub.esys-pck-sent.esps-cr-db-num    no-undo.
        4   define input parameter p-esps-pack-num     like ub.esys-pck-sent.esps-pack-num no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Информация по пакету OPENXML".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   DEFINE BUTTON b-exit AUTO-END-KEY DEFAULT
      115        LABEL "&Выход"
      116        SIZE 10 BY 1
      117        BGCOLOR 8 .
      118   DEFINE BUTTON b-help
      119        LABEL "Помо&щь"
      120        SIZE 3 BY 1
      121        BGCOLOR 8 .
      122   DEFINE VARIABLE f-custom-pack-name AS CHARACTER FORMAT "X(256)":U
      123        LABEL "Имя пакета в ВС"
      124        VIEW-AS FILL-IN
      125        SIZE 39 BY 1.07 NO-UNDO.
      126   DEFINE VARIABLE f_CreDate AS DATE FORMAT "99/99/9999"
      127        LABEL "Дата создания"
      128        VIEW-AS FILL-IN
      129        SIZE 11 BY 1.
      130   DEFINE VARIABLE f_CreNum AS INTEGER FORMAT "->,>>>,>>9" INITIAL 0
      131        LABEL "Кол-во формирований"
      132        VIEW-AS FILL-IN
      133        SIZE 11 BY 1.
      134   DEFINE VARIABLE f_CreTime AS CHARACTER FORMAT "X(8)"
      135        LABEL "Время создания"
      136        VIEW-AS FILL-IN
      137        SIZE 9 BY 1.
      138   DEFINE VARIABLE f_db-num AS INTEGER FORMAT ">>>>9" INITIAL ?
      139        LABEL "Номер БД"
      140        VIEW-AS FILL-IN
      141        SIZE 6 BY 1.
      142   DEFINE VARIABLE f_esps-cr-db-num AS INTEGER FORMAT ">>>>9" INITIAL ?
      143        LABEL "Номер БД создания"
      144        VIEW-AS FILL-IN
      145        SIZE 6 BY 1.
      146   DEFINE VARIABLE f_esys-id AS INTEGER FORMAT ">>>>9" INITIAL ?
      147        LABEL "Номер ВС"
      148        VIEW-AS FILL-IN
      149        SIZE 6 BY 1.
      150   DEFINE VARIABLE f_pack-num AS INTEGER FORMAT ">>>>>>>>>9" INITIAL ?
      151        LABEL "Номер пакета"
      152        VIEW-AS FILL-IN
      153        SIZE 11 BY 1.
      154   DEFINE VARIABLE f_RcvdDate AS DATE FORMAT "99/99/9999"
      155        LABEL "Дата"
      156        VIEW-AS FILL-IN
      157        SIZE 11 BY 1.
      158   DEFINE VARIABLE f_RcvdTime AS CHARACTER FORMAT "X(8)"
      159        LABEL "Время"
      160        VIEW-AS FILL-IN
      161        SIZE 9 BY 1.
      162   DEFINE VARIABLE f_SendTxtDate AS DATE FORMAT "99/99/9999"
      163        LABEL "Дата последнего"
      164        VIEW-AS FILL-IN
      165        SIZE 11 BY 1.
      166   DEFINE VARIABLE f_SendTxtTime AS CHARACTER FORMAT "X(8)"
      167        LABEL "Время последнего"
      168        VIEW-AS FILL-IN
      169        SIZE 9 BY 1.
      170   DEFINE RECTANGLE RECT-1
      171        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      172        SIZE 61.6 BY 6.13.
      173   DEFINE RECTANGLE RECT-2
      174        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      175        SIZE 61.6 BY 4.5.
      176   DEFINE RECTANGLE RECT-3
      177        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      178        SIZE 61.6 BY 3.5.
      179   DEFINE QUERY pack-inf FOR
      180         ub.esys-pck-sent SCROLLING.
      181   DEFINE FRAME pack-inf
      182        b-exit AT ROW 1 COL 1
      183        b-help AT ROW 1 COL 40
      184        f_db-num AT ROW 2.67 COL 21.5 COLON-ALIGNED
      185        f_esys-id AT ROW 2.67 COL 21.5 COLON-ALIGNED WIDGET-ID 2
      186        f_esps-cr-db-num AT ROW 2.67 COL 22.5 COLON-ALIGNED WIDGET-ID 4
      187        f-custom-pack-name AT ROW 3.67 COL 21.5 COLON-ALIGNED WIDGET-ID 6
      188        f_pack-num AT ROW 4.67 COL 21.5 COLON-ALIGNED
      189        f_CreDate AT ROW 5.67 COL 21.5 COLON-ALIGNED
      190        f_CreTime AT ROW 6.67 COL 21.5 COLON-ALIGNED
      191        f_CreNum AT ROW 9.8 COL 21.5 COLON-ALIGNED
      192        f_SendTxtDate AT ROW 10.8 COL 21.5 COLON-ALIGNED
      193        f_SendTxtTime AT ROW 11.8 COL 21.5 COLON-ALIGNED
      194        f_RcvdDate AT ROW 14.3 COL 21.5 COLON-ALIGNED
      195        f_RcvdTime AT ROW 15.3 COL 21.5 COLON-ALIGNED
      196        "Получение подтверждения" VIEW-AS TEXT
      197             SIZE 25.1 BY .8 AT ROW 13.3 COL 3
      198        "Создание файла пакета" VIEW-AS TEXT
      199             SIZE 22.8 BY .7 AT ROW 8.8 COL 3
      200        RECT-1 AT ROW 2.37 COL 1.9
      201        RECT-2 AT ROW 8.5 COL 1.9
      202        RECT-3 AT ROW 13 COL 1.9
      203        SPACE(6.09) SKIP(0.16)
      204       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      205            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      206            TITLE "Дополнительная информация о пакете OpenXML"
      207            DEFAULT-BUTTON b-exit.
      208   ASSIGN
      209          FRAME pack-inf:SCROLLABLE       = FALSE
      210          FRAME pack-inf:HIDDEN           = TRUE.
      211   ASSIGN
      212          f_db-num:HIDDEN IN FRAME pack-inf           = TRUE.
      213   ASSIGN
      214          f_esps-cr-db-num:HIDDEN IN FRAME pack-inf           = TRUE.
      215   ON WINDOW-CLOSE OF FRAME pack-inf
      216   DO:
      217     APPLY "END-ERROR":U TO SELF.
      218   END.
      219   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      220   on help of frame pack-inf
      221   do:
      222     run gbl/app_help.p
      223       (input this-procedure :file-name
      224       ,input ''
      225       ,input ?
      226       ) no-error.
      227     if error-status :error then do:
      228       message
      229         "Ошибка при вызове помощи"
      230         error-status :get-message(1)
      231         view-as alert-box .
      232     end.
      233   end.
      234   run minbtn-set in this-procedure .
      235   on choose of b-help in frame pack-inf
      236   do:
      237     apply "help":u to frame pack-inf .
      238   end.
      239   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      240   procedure minbtn-set :
      241       do
      242           on error undo, return error return-value
      243           :
      244           define variable ii              as integer       no-undo .
      245           define variable fh              as widget-handle no-undo .
      246           define variable hh              as widget-handle no-undo .
      247           define variable v-h             as handle        extent 4 no-undo .
      248           define variable v-name-button   as character     no-undo .
      249           define variable v-help-old-x    as decimal       no-undo .
      250           define variable v-help-old-y    as decimal       no-undo .
      251           define variable v-help-old-size as decimal       no-undo .
      252           define variable v-frame-width   as decimal       no-undo .
      253           define variable jj              as integer       no-undo .
      254           do
      255               on error undo, return error
      256               :
      257               assign
      258                   v-frame-width = frame pack-inf:width - 0.3
      259                   fh            = frame pack-inf:first-child
      260                   hh            = fh:first-child
      261                   ii            = 1
      262                   .
      263               do while valid-handle(hh):
      264                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      265                   do:
      266                       case lc(hh:name) :
      267                           when "b-help" then
      268                               do:
      269                                   hh:load-image-up("cmp/b-help.bmp":u) .
      270                                   hh:load-image-down("cmp/b-help.bmp":u) .
      271                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      272                                   hh:TOOLTIP = "Помощь" .
      273                                   v-help-old-x = hh:column .
      274                                   v-help-old-y = hh:row    .
      275                                   v-help-old-size = hh:width .
      276                                   hh:width-chars = 2.5 .
      277                               end.
      278                           when "b-print" then
      279                               do:
      280                                   hh:load-image("cmp/b-print.bmp":u) .
      281                                   hh:TOOLTIP = "Печать" .
      282                                   v-h[ii] = hh:handle .
      283                                   ii = ii + 1 .
      284                                   hh:width-chars = 3 .
      285                               end.
      286                           when "b-history" or
      287                           when "b-hist" then
      288                               do:
      289                                   hh:load-image("cmp/b-hist.bmp":u) .
      290                                   hh:TOOLTIP = "История" .
      291                                   v-h[ii] = hh:handle .
      292                                   ii = ii + 1 .
      293                                   hh:width-chars = 3 .
      294                               end.
      295                           when "b-sch" then
      296                               do:
      297                                   hh:load-image("cmp/b-sch.bmp":u) .
      298                                   hh:TOOLTIP = "Установка Фильтра" .
      299                                   v-h[ii] = hh:handle .
      300                                   ii = ii + 1 .
      301                                   hh:width-chars = 3 .
      302                               end.
      303                           when "b-hist-user" then
      304                               do:
      305                                   hh:load-image("cmp/b-hist.bmp":u) .
      306                                   hh:TOOLTIP = "История пользователя" .
      307                                   ii = ii + 1 .
      308                               end.
      309                       end case.
      310                   end.
      311                   hh = hh:next-sibling.
      312               end.
      313               b-help:column = v-frame-width - b-help:width-chars.
      314               jj = 0.
      315               repeat ii = 4 to 1 by -1 :
      316                   if valid-handle (v-h[ii] ) then
      317                   do:
      318                       jj  = jj + 1 .
      319                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      320                       v-h[ii]:row    = v-help-old-y .
      321                   end.
      322               end.
      323           end.
      324       end.
      325   end procedure.
      326   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME pack-inf:PARENT eq ?
      327   THEN FRAME pack-inf:PARENT = ACTIVE-WINDOW.
      328   MAIN-BLOCK:
      329   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      330      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      331       define buffer buf_esys-pck-sent for ub.esys-pck-sent .
      332       find first buf_esys-pck-sent no-lock
      333         where buf_esys-pck-sent.esys-id   = p-esys-id
      334           and buf_esys-pck-sent.db-num   = p-db-num
      335           and buf_esys-pck-sent.esps-cr-db-num   = p-esps-cr-db-num
      336           and buf_esys-pck-sent.esps-pack-num = p-esps-pack-num
      337         no-error
      338       .
      339       if not available buf_esys-pck-sent then do:
      340         message
      341           vss-workfile vss-revision vss-description skip
      342           substitute( "Пакет N &1 для ВС &2 не найден.", p-esps-pack-num, p-esys-id )
      343           view-as alert-box error
      344         .
      345         return error .
      346       end.
      347       assign
      348         f_esys-id     = p-esys-id
      349         f_db-num      = p-db-num
      350         f_pack-num    = p-esps-pack-num
      351         f_CreDate     = buf_esys-pck-sent.esps-CreDate
      352         f_CreTime     = buf_esys-pck-sent.esps-CreTime
      353         f_CreNum      = buf_esys-pck-sent.esps-CreNum
      354         f_SendTxtDate = buf_esys-pck-sent.esps-SendTxtDate
      355         f_SendTxtTime = buf_esys-pck-sent.esps-SendTxtTime
      356         f_RcvdDate    = buf_esys-pck-sent.esps-rcvdDate
      357         f_RcvdTime    = buf_esys-pck-sent.esps-RcvdTime
      358         f-custom-pack-name = (if buf_esys-pck-sent.custom-pack-name = ''
      359                               then substitute("o&1.xml", string(p-esps-pack-num, "999999999"))
      360                               else buf_esys-pck-sent.custom-pack-name)
      361       .
      362     RUN enable_UI.
      363     WAIT-FOR GO OF FRAME pack-inf.
      364   END.
      365   RUN disable_UI.
      366   PROCEDURE disable_UI :
      367     HIDE FRAME pack-inf.
      368   END PROCEDURE.
      369   PROCEDURE enable_UI :
      370     DISPLAY f_db-num f_esys-id f-custom-pack-name f_pack-num f_CreDate f_CreTime
      371             f_CreNum f_SendTxtDate f_SendTxtTime f_RcvdDate f_RcvdTime
      372         WITH FRAME pack-inf.
      373     ENABLE b-exit RECT-1 RECT-2 RECT-3 b-help
      374         WITH FRAME pack-inf.
      375     VIEW FRAME pack-inf.
      376   END PROCEDURE.
