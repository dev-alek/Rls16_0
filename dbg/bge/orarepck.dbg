        1   define input  parameter parparentproc as handle    no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Утилита перевыгрузки пакета для Oracle".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   define variable v-waitfram-action01         as character   no-undo .
       68   define variable v-waitfram-action02         as character   no-undo .
       69   define variable v-waitfram-action03         as character   no-undo .
       70   define variable mWaitFramTextBeg            as character   no-undo.
       71   define variable mWaitFramTextEnd            as character   no-undo.
       72   define variable mWaitFramView               as logical     no-undo.
       73   define variable mWaitProcEvent              as logical     no-undo init yes.
       74   define variable mWaitFramInterval           as integer     no-undo init 1 .
       75   define variable mWaitFramStop               as logical     no-undo.
       76   define variable mWaitFramStopUser           as logical     no-undo.
       77   define variable mWaitFramStopTimeOut        as logical     no-undo.
       78   define variable mWaitFramStartProc          as datetime-tz no-undo.
       79   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       80   define button B-WaitFramStop auto-end-key
       81        label "Стоп"
       82        size 10 by 1 tooltip "Остоновить процесс".
       83   define button B-viewProcInfo
       84        label "Информация"
       85        size 15 by 1 tooltip "Информация о процесс".
       86   define frame waitfram
       87     v-waitfram-action01 format "x(72)" no-label skip
       88     v-waitfram-action02 format "x(72)" no-label skip
       89     v-waitfram-action03 format "x(72)" no-label skip
       90     B-viewProcInfo
       91     B-WaitFramStop at row 4 col 30
       92     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       93     .
       94   define new global shared variable mBatchMode as logical no-undo init ?.
       95   define variable mFramBachModHandle as handle no-undo.
       96   mFramBachModHandle = frame waitfram:handle.
       97   define variable mFameOldVis as logical no-undo.
       98   define variable mVisCUrentVin as logical no-undo.
       99   if session:batch-mode
      100   then
      101      mBatchMode = yes.
      102   if mBatchMode = ? then do:
      103     mVisCUrentVin = current-window:visible.
      104     mFameOldVis = mFramBachModHandle:visible.
      105     mFramBachModHandle:visible  = yes.
      106     mBatchMode = mFramBachModHandle:visible ne yes.
      107     mFramBachModHandle:visible = mFameOldVis.
      108     current-window:visible = mVisCUrentVin.
      109   end.
      110    if  log-manager:logfile-name ne ?
      111     then DO:
      112         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      113         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      114         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      115     end.
      116   on choose of B-WaitFramStop in frame waitfram
      117   do:
      118     mWaitFramStop = yes.
      119     mWaitFramStopUser = yes.
      120   end.
      121   function waitfram-check-timeout returns logical():
      122      define variable vtime as int64 no-undo.
      123      if mWaitFramStopTimeOut
      124      then
      125         return yes.
      126      vtime = ( now - mWaitFramStartProc ) / 1000 .
      127      if     mWaitFramTimeOut ne ?
      128         and mWaitFramTimeOut ne 0
      129         and mWaitFramTimeOut lt vtime
      130      then do:
      131         mWaitFramStopTimeOut = yes.
      132      end.
      133      return mWaitFramStopTimeOut.
      134   end.
      135   procedure waitfram-hide :
      136     if not session:batch-mode
      137     then do
      138     on error undo, return error return-value
      139     :
      140       pause 0 before-hide .
      141       if not mBatchMode then
      142         hide frame waitfram .
      143     if     not mWaitFramView
      144        and mWaitProcEvent
      145     then
      146       process events .
      147     end.
      148   end procedure.
      149   procedure waitfram-show :
      150     define input  parameter p-message as character no-undo .
      151     define variable v-left-margin as integer   no-undo .
      152     if not session:batch-mode
      153     then do
      154     on error undo, return error return-value
      155     :
      156       if length(p-message) <= 70 then do:
      157         assign
      158           v-left-margin = integer((70 - length(p-message)) / 2)
      159         .
      160         assign
      161           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      162         .
      163         assign
      164           v-waitfram-action01 = " "
      165           v-waitfram-action02 = " "
      166                                    + fill(" ", v-left-margin)
      167                                    + p-message
      168           v-waitfram-action03 = " "
      169         .
      170       end.
      171       else do:
      172         define variable vRindex1 as integer no-undo.
      173         define variable vRindex2 as integer no-undo.
      174         vRindex1 = r-index(p-message," ",70).
      175         if vRindex1 = 0
      176         then
      177            vRindex1 = 70.
      178         if length(p-message)  <= vRindex1 + 70 then do:
      179           assign
      180             v-waitfram-action01 = " "
      181             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      182             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      183           .
      184         end.
      185         else do:
      186           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      187           if vRindex2 <= vRindex1
      188           then
      189              vRindex2 = vRindex1 + 70.
      190           assign
      191             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      192             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      193             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      194           .
      195         end.
      196       end.
      197       B-viewProcInfo:visible   in frame waitfram = no.
      198       B-viewProcInfo:sensitive in frame waitfram = no.
      199       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      200       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      201       if  (   mWaitFramView
      202          or  mWaitProcEvent)
      203          and not mBatchMode
      204       then
      205          display
      206             v-waitfram-action01 skip
      207             v-waitfram-action02 skip
      208             v-waitfram-action03 skip
      209          with frame waitfram .
      210       if     mWaitFramView
      211          then do:
      212             if     mWaitFramInterval ne ?
      213                and not mBatchMode
      214             then
      215                wait-for go of frame waitfram pause mWaitFramInterval.
      216          end.
      217          else
      218             if     mWaitProcEvent
      219                and not mBatchMode
      220             then
      221                process events .
      222     end.
      223   end procedure.
      224      procedure waitfram-show-this:
      225         define input  parameter iInterval as int64 no-undo.
      226         define variable vtime as int64 no-undo.
      227         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      228         mWaitFramInterval = iInterval.
      229         run waitfram-show (substitute("&1&2 &3&4" ,
      230                                       mWaitFramTextBeg ,
      231                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      232                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      233                                       mWaitFramTextEnd
      234                                      )
      235                           ).
      236      end.
      237      procedure WaitFramRunPause:
      238         define input  parameter iInterval as dec no-undo.
      239         define variable vStart  as datetime-tz no-undo.
      240         define variable vend    as datetime-tz no-undo.
      241         define variable vint as int64 no-undo.
      242         define variable vOk as logical no-undo.
      243         vStart = now.
      244         vend   = vStart.
      245         publish "WaitFramPause" (iInterval,output vOk).
      246         vend   =  now.
      247         vint = vend - vStart.
      248         vint = iInterval - vint / 1000.
      249         if     not mWaitFramStop
      250            and (   vint > 0
      251                 or (    not vOk
      252                     and iInterval eq ?
      253                     )
      254                 )
      255         then
      256            run waitfram-show-this (iInterval).
      257         vend   =  now.
      258         vint = vend - vStart.
      259         vint = iInterval - vint / 1000.
      260         if     not mWaitFramStop
      261            and vint > 0
      262         then do:
      263            run gbl/pause.p (vint * 1000).
      264         end.
      265         if iInterval ne ?
      266         then
      267            publish "WaitFramStop".
      268         waitfram-check-timeout().
      269      end.
      270      procedure WaitFramWaitFor:
      271         define input  parameter iInterval as dec no-undo.
      272         assign
      273            mWaitFramStartProc   = now
      274            mWaitFramStopUser    = no
      275            mWaitFramStopTimeOut = no
      276         .
      277         block-wait:
      278         do while not mWaitFramStop:
      279            run WaitFramRunPause (iInterval).
      280            if  waitfram-check-timeout()
      281            then do:
      282               leave block-wait.
      283            end.
      284         end.
      285         run waitfram-hide.
      286      end.
      287   procedure waitfram-join :
      288     define input  parameter p-line-1  as character no-undo .
      289     define input  parameter p-line-2  as character no-undo .
      290     define input  parameter p-line-3  as character no-undo .
      291     define output parameter p-message as character no-undo .
      292     do
      293     on error undo, return error return-value
      294     :
      295       assign
      296         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      297                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      298                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      299       .
      300     end.
      301   end procedure.
      302   function waitfram-join-function returns character
      303     (input p-line-1 as character
      304     ,input p-line-2 as character
      305     ,input p-line-3 as character
      306     ).
      307     define variable v-message as character no-undo .
      308     run waitfram-join in this-procedure
      309       (input  p-line-1
      310       ,input  p-line-2
      311       ,input  p-line-3
      312       ,output v-message
      313       ) .
      314     return v-message .
      315   end function .
      316   define new global shared variable g#library  as handle no-undo .
      317   define new global shared variable g#library2 as handle no-undo .
      318   define variable vss-include-info1 as character format "X(65)" no-undo
      319   initial "@(#)$Workfile$ $Revision$".
      320   DEF STREAM stmXMLOut.
      321   DEF STREAM stmXMLLog.
      322   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      323   procedure cur-time :
      324      define output parameter p-today as date      no-undo .
      325      define output parameter p-time  as integer   no-undo .
      326     do
      327     on error undo, return error
      328     :
      329       define variable v-date1 as date      no-undo .
      330       define variable v-date2 as date      no-undo .
      331       define variable v-time  as integer   no-undo .
      332       assign
      333         v-date1 = today
      334         v-time  = time
      335         v-date2 = today
      336       .
      337       if v-date1 <> v-date2
      338       then do:
      339         assign
      340           v-date1 = today
      341           v-time  = v-time
      342         .
      343       end.
      344       assign
      345         p-today = v-date1
      346         p-time  = v-time
      347       .
      348     end.
      349   end.
      350   function cur-time-date returns character
      351   :
      352     return string(today, '99/99/9999':U) .
      353   end.
      354   function cur-time-mjd returns decimal
      355   :
      356     define variable v-date as date      no-undo .
      357     define variable v-time as integer   no-undo .
      358     run cur-time in this-procedure
      359       (output v-date
      360       ,output v-time
      361       ) .
      362     return integer(v-date) - 2400002 + (v-time / 86400) .
      363   end.
      364   function cur-time-get-ending-index returns integer
      365   (input p-number as integer
      366   )
      367   :
      368     if p-number < 0
      369     or p-number = ?
      370     then do:
      371       return 1 .
      372     end.
      373     define variable v-rest as integer   no-undo .
      374     assign
      375       p-number = p-number modulo 100
      376     .
      377     if p-number < 20
      378     then do:
      379       assign
      380         v-rest = p-number
      381       .
      382     end.
      383     else do:
      384       assign
      385         v-rest = p-number modulo 10
      386       .
      387     end.
      388     case v-rest :
      389       when 1
      390       then do:
      391         return 2 .
      392       end.
      393       when 2 or
      394       when 3 or
      395       when 4
      396       then do:
      397         return 3 .
      398       end.
      399       otherwise do:
      400         return 1 .
      401       end.
      402     end case .
      403   end.
      404   procedure cur-time-mjd-to-date :
      405      define input  parameter i-mjd-diff as decimal no-undo.
      406      define output parameter o-Date     as date    no-undo.
      407      define output parameter o-Time     as integer no-undo.
      408      define variable v-day-number as integer   no-undo .
      409      if    i-mjd-diff < 0
      410         or i-mjd-diff = ?
      411      then do:
      412         return "?" .
      413      end.
      414      assign
      415         v-day-number = truncate(i-mjd-diff,0).
      416         o-Date = date(v-day-number + 2400002).
      417         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      418     .
      419   end.
      420   function cur-time-mjd-to-string returns character
      421   (input p-mjd-diff as decimal
      422   )
      423   :
      424     define variable v-day-number as integer   no-undo .
      425     define variable v-seconds    as integer   no-undo .
      426     define variable v-hour       as integer   no-undo .
      427     define variable v-min        as integer   no-undo .
      428     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      429     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      430     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      431     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      432     if p-mjd-diff < 0
      433     or p-mjd-diff = ?
      434     then do:
      435       return "?" .
      436     end.
      437     assign
      438       v-day-number = integer(truncate(p-mjd-diff,0))
      439       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      440     .
      441     if v-seconds > 86400
      442     then do:
      443       assign
      444         v-seconds = 86400 - 1
      445       .
      446     end.
      447     if v-seconds < 0
      448     then do:
      449       assign
      450         v-seconds = 0
      451       .
      452     end.
      453     assign
      454       v-hour = truncate(v-seconds / 3600, 0)
      455     .
      456     assign
      457       v-seconds = v-seconds modulo 3600
      458     .
      459     assign
      460       v-min = truncate(v-seconds / 60, 0)
      461     .
      462     assign
      463       v-seconds = v-seconds modulo 60
      464     .
      465     return
      466         (if v-day-number <> 0
      467           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      468           else ""
      469         )
      470       + (if v-day-number <> 0 or v-hour <> 0
      471           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      472           else ""
      473         )
      474       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      475           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      476           else ""
      477         )
      478       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      479       .
      480   end.
      481   function cur-time-string returns character
      482   :
      483     define variable v-date as date      no-undo .
      484     define variable v-time as integer   no-undo .
      485     run cur-time in this-procedure
      486       (output v-date
      487       ,output v-time
      488       ) .
      489     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      490   end.
      491   function cur-time-string-sec returns character
      492   :
      493     define variable v-date as date      no-undo .
      494     define variable v-time as integer   no-undo .
      495     run cur-time in this-procedure
      496       (output v-date
      497       ,output v-time
      498       ) .
      499     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      500   end.
      501   function cur-time-custom  returns character
      502   (input p-prefix as character
      503   ,input p-date-format as character
      504   ,input p-delimiter as character
      505   ,input p-time-format as character
      506   ,input p-suffix as character
      507   )
      508   :
      509     define variable v-date as date      no-undo .
      510     define variable v-time as integer   no-undo .
      511     run cur-time in this-procedure
      512       (output v-date
      513       ,output v-time
      514       ) .
      515     return
      516       p-prefix
      517       + string(v-date, p-date-format)
      518       + p-delimiter
      519       + string(v-time, p-time-format)
      520       + p-suffix
      521       .
      522   end.
      523   function cur-time-print  returns character
      524   :
      525     define variable v-date as date      no-undo .
      526     define variable v-time as integer   no-undo .
      527     run cur-time in this-procedure
      528       (output v-date
      529       ,output v-time
      530       ) .
      531     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      532   end.
      533   function cur-time-datetime returns datetime
      534   :
      535     define variable v-char as character no-undo .
      536     define variable v-datetime as datetime no-undo .
      537     v-char = cur-time-string().
      538     v-datetime = datetime(v-char).
      539     return  v-datetime.
      540   end.
      541   function cur-time-string-msec returns character
      542   :
      543     define variable v-date as datetime  no-undo .
      544     v-date = now.
      545     return string(v-date) .
      546   end.
      547   define variable vss-include-info3 as character format "X(65)" no-undo
      548   initial "@(#)$Workfile$ $Revision$".
      549   procedure xmlchar-test :
      550   define input parameter p-in-string          as character        no-undo.
      551   define output parameter p-out-string-enc    as character        no-undo.
      552   define output parameter p-out-string-dec    as character        no-undo.
      553   do
      554   on error undo, return error
      555   :
      556          run xmlchar-encode in this-procedure
      557       (
      558             input p-in-string
      559           , output p-out-string-enc
      560       ).
      561          run xmlchar-decode in this-procedure
      562       (
      563             input p-out-string-enc
      564           , output p-out-string-dec
      565       ).
      566   end.
      567   end .
      568   procedure xmlchar-encode :
      569   define input parameter p-in-string      as character        no-undo.
      570   define output parameter p-out-string    as character        no-undo.
      571       define variable v-position      as integer      no-undo.
      572       define variable v-current-char  as character    no-undo.
      573   do
      574   on error undo, return error
      575   :
      576       assign
      577           p-out-string = "":U
      578       .
      579       case p-in-string
      580       :
      581           when ?
      582           then do:
      583               assign
      584                   p-out-string = "?":U
      585               .
      586           end.
      587           when "?":U
      588           then do:
      589               assign
      590                   p-out-string = "&#63;":U
      591               .
      592           end.
      593           otherwise do:
      594               do v-position = 1 to length( p-in-string )
      595               :
      596                   assign
      597                       v-current-char = substring( p-in-string, v-position, 1 )
      598                   .
      599                   case v-current-char
      600                   :
      601                       when "&":U
      602                       then do:
      603                           assign
      604                               p-out-string = p-out-string + "&amp;":U
      605                           .
      606                       end.
      607                       when ">":U
      608                       then do:
      609                           assign
      610                               p-out-string = p-out-string + "&gt;":U
      611                           .
      612                       end.
      613                       when "<":U
      614                       then do:
      615                           assign
      616                               p-out-string = p-out-string + "&lt;":U
      617                           .
      618                       end.
      619                       when "'":U
      620                       then do:
      621                           assign
      622                               p-out-string = p-out-string + "&apos;":U
      623                           .
      624                       end.
      625                       when '"':U
      626                       then do:
      627                           assign
      628                               p-out-string = p-out-string + "&quot;":U
      629                           .
      630                       end.
      631                       when chr(1)
      632                       then do:
      633                           assign
      634                               p-out-string = p-out-string + "":U
      635                           .
      636                       end.
      637                       when chr(2)
      638                       then do:
      639                           assign
      640                               p-out-string = p-out-string + "":U
      641                           .
      642                       end.
      643                       when chr(3)
      644                       then do:
      645                           assign
      646                               p-out-string = p-out-string + "":U
      647                           .
      648                       end.
      649                       when chr(4)
      650                       then do:
      651                           assign
      652                               p-out-string = p-out-string + "":U
      653                           .
      654                       end.
      655                       when chr(5)
      656                       then do:
      657                           assign
      658                               p-out-string = p-out-string + "":U
      659                           .
      660                       end.
      661                       when chr(6)
      662                       then do:
      663                           assign
      664                               p-out-string = p-out-string + "":U
      665                           .
      666                       end.
      667                       when chr(7)
      668                       then do:
      669                           assign
      670                               p-out-string = p-out-string + "":U
      671                           .
      672                       end.
      673                       when chr(8)
      674                       then do:
      675                           assign
      676                               p-out-string = p-out-string + "":U
      677                           .
      678                       end.
      679                       when chr(9)
      680                       then do:
      681                           assign
      682                               p-out-string = p-out-string + "":U
      683                           .
      684                       end.
      685                       when chr(29)
      686                       then do:
      687                           assign
      688                               p-out-string = p-out-string + "":U
      689                           .
      690                       end.
      691                       when chr(10)
      692                       then do:
      693                           assign
      694                               p-out-string = p-out-string + "&#10;":U
      695                           .
      696                       end.
      697                       when chr(13)
      698                       then do:
      699                           assign
      700                               p-out-string = p-out-string + "&#13;":U
      701                           .
      702                       end.
      703                       otherwise do:
      704                           assign
      705                               p-out-string = p-out-string + v-current-char
      706                           .
      707                       end.
      708                   end case.
      709               end.
      710           end.
      711       end case.
      712   end.
      713   end .
      714   procedure xmlchar-encode-1c :
      715   define input parameter p-in-string      as character        no-undo.
      716   define output parameter p-out-string    as character        no-undo.
      717       define variable v-position      as integer      no-undo.
      718       define variable v-current-char  as character    no-undo.
      719   do
      720   on error undo, return error
      721   :
      722       assign
      723           p-out-string = "":U
      724       .
      725       case p-in-string
      726       :
      727           when ?
      728           then do:
      729               assign
      730                   p-out-string = "?":U
      731               .
      732           end.
      733           otherwise do:
      734               do v-position = 1 to length( p-in-string )
      735               :
      736                   assign
      737                       v-current-char = substring( p-in-string, v-position, 1 )
      738                   .
      739                   case v-current-char
      740                   :
      741                       when chr(1)
      742                       then do:
      743                           assign
      744                               p-out-string = p-out-string + " ":U
      745                           .
      746                       end.
      747                       when chr(2)
      748                       then do:
      749                           assign
      750                               p-out-string = p-out-string + " ":U
      751                           .
      752                       end.
      753                       when chr(3)
      754                       then do:
      755                           assign
      756                               p-out-string = p-out-string + " ":U
      757                           .
      758                       end.
      759                       when chr(4)
      760                       then do:
      761                           assign
      762                               p-out-string = p-out-string + " ":U
      763                           .
      764                       end.
      765                       when chr(5)
      766                       then do:
      767                           assign
      768                               p-out-string = p-out-string + " ":U
      769                           .
      770                       end.
      771                       when chr(6)
      772                       then do:
      773                           assign
      774                               p-out-string = p-out-string + " ":U
      775                           .
      776                       end.
      777                       when chr(7)
      778                       then do:
      779                           assign
      780                               p-out-string = p-out-string + " ":U
      781                           .
      782                       end.
      783                       when chr(8)
      784                       then do:
      785                           assign
      786                               p-out-string = p-out-string + " ":U
      787                           .
      788                       end.
      789                       when chr(9)
      790                       then do:
      791                           assign
      792                               p-out-string = p-out-string + " ":U
      793                           .
      794                       end.
      795                       when chr(29)
      796                       then do:
      797                           assign
      798                               p-out-string = p-out-string + " ":U
      799                           .
      800                       end.
      801                       when chr(10)
      802                       then do:
      803                           assign
      804                               p-out-string = p-out-string + " ":U
      805                           .
      806                       end.
      807                       when chr(13)
      808                       then do:
      809                           assign
      810                               p-out-string = p-out-string + " ":U
      811                           .
      812                       end.
      813                       otherwise do:
      814                           assign
      815                               p-out-string = p-out-string + v-current-char
      816                           .
      817                       end.
      818                   end case.
      819               end.
      820           end.
      821       end case.
      822   end.
      823   end .
      824   procedure xmlchar-decode :
      825   define input parameter p-in-string      as character        no-undo.
      826   define output parameter p-out-string    as character        no-undo.
      827       define variable v-position      as integer      no-undo.
      828       define variable v-last-position as integer      no-undo.
      829       define variable v-temp-integer  as integer      no-undo.
      830       define variable v-current-char  as character    no-undo.
      831       define variable v-next-char     as character    no-undo.
      832       define variable v-success       as logical      no-undo.
      833   do
      834   on error undo, return error
      835   :
      836       assign
      837           p-out-string = "":U
      838           v-position   = 0
      839       .
      840       replace-cycle:
      841       do while yes
      842       on error undo, return error
      843       :
      844           assign
      845               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      846           .
      847           if v-last-position <= v-position
      848           then do:
      849               if v-position = 0
      850               then do:
      851                   assign
      852                       p-out-string = p-in-string
      853                   .
      854               end.
      855               else do:
      856                   assign
      857                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      858                   .
      859               end.
      860               leave replace-cycle.
      861           end.
      862           else do:
      863               assign
      864                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      865                   v-position      = v-last-position
      866                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      867               .
      868               if v-current-char = "#":U
      869               then do:
      870                   assign
      871                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      872                   .
      873                   if v-last-position > 0
      874                   then do:
      875                       run xmlchar-read-integer in this-procedure
      876                        (
      877                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      878                           , output v-temp-integer
      879                           , output v-success
      880                       ).
      881                       if v-success = yes
      882                       and v-temp-integer >= 1
      883                       and v-temp-integer <= 255
      884                       then do:
      885                           assign
      886                               p-out-string = p-out-string + chr( v-temp-integer )
      887                               v-position   = v-last-position + 1
      888                           .
      889                       end.
      890                       else do:
      891                           assign
      892                               p-out-string = p-out-string + "&":U
      893                               v-position   = v-position   + 1
      894                           .
      895                       end.
      896                   end.
      897                   else do:
      898                       assign
      899                           p-out-string = p-out-string + "&":U
      900                           v-position   = v-position   + 1
      901                       .
      902                   end.
      903               end.
      904               else do:
      905                   case substring( p-in-string, v-position + 1, 3 )
      906                   :
      907                       when "lt;":U
      908                       then do:
      909                           assign
      910                               p-out-string = p-out-string + "<":U
      911                               v-position   = v-position   + 3
      912                           .
      913                       end.
      914                       when "gt;":U
      915                       then do:
      916                           assign
      917                               p-out-string = p-out-string + ">":U
      918                               v-position   = v-position   + 3
      919                           .
      920                       end.
      921                       otherwise do:
      922                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      923                           then do:
      924                               assign
      925                                   p-out-string = p-out-string + "&":U
      926                                   v-position   = v-position   + 4
      927                               .
      928                           end.
      929                           else do:
      930                               case substring( p-in-string, v-position + 1, 5 )
      931                               :
      932                                   when "quot;":U
      933                                   then do:
      934                                       assign
      935                                           p-out-string = p-out-string + '"':U
      936                                           v-position   = v-position   + 5
      937                                       .
      938                                   end.
      939                                   when "apos;":U
      940                                   then do:
      941                                       assign
      942                                           p-out-string = p-out-string + "'":U
      943                                           v-position   = v-position   + 5
      944                                       .
      945                                   end.
      946                                   otherwise do:
      947                                       assign
      948                                           p-out-string = p-out-string + "&":U
      949                                       .
      950                                   end.
      951                               end case.
      952                           end.
      953                       end.
      954                   end case.
      955               end.
      956           end.
      957       end.
      958   end.
      959   end .
      960   procedure xmlchar-read-integer :
      961   define input parameter p-input-string      as character        no-undo.
      962   define output parameter p-output-integer   as integer          no-undo.
      963   define output parameter p-success       as logical          no-undo.
      964   do
      965   on error undo, return error
      966   :
      967       assign
      968           p-output-integer = integer( p-input-string )
      969       no-error.
      970       if error-status :error
      971       then do:
      972           assign
      973               p-success           = no
      974               p-output-integer    = 0
      975           .
      976       end.
      977       else do:
      978           assign
      979               p-success           = yes
      980           .
      981       end.
      982   end.
      983   end.
      984   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      985   procedure strtdate :
      986     define input  parameter p-str         as character no-undo .
      987     define output parameter p-value       as date      no-undo .
      988     define output parameter p-data-valid  as logical   no-undo .
      989     define output parameter p-message     as character no-undo .
      990   do
      991   on error undo, return error return-value
      992   :
      993     define variable v-value       as date      no-undo .
      994     define variable v-i           as integer   no-undo .
      995     define variable v-num         as integer   no-undo .
      996     define variable v-delim       as character no-undo .
      997     define variable v-delim-list  as character no-undo .
      998     define variable v-day         as integer   no-undo .
      999     define variable v-month       as integer   no-undo .
     1000     define variable v-year        as integer   no-undo .
     1001     define variable v-day-str     as character no-undo .
     1002     define variable v-month-str   as character no-undo .
     1003     define variable v-year-str    as character no-undo .
     1004     assign
     1005       p-value       = ?
     1006       p-data-valid  = false
     1007     .
     1008     if p-str = ?
     1009     then do:
     1010       assign
     1011         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
     1012       .
     1013       return .
     1014     end.
     1015     if p-str = ""
     1016     then do:
     1017       assign
     1018         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
     1019       .
     1020       return .
     1021     end.
     1022     if length(p-str)  > 10
     1023     then do:
     1024       assign
     1025         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
     1026       .
     1027       return .
     1028     end.
     1029     assign
     1030       v-delim-list = '/,-,.':U
     1031     .
     1032     _delim:
     1033     do v-i = 1 to num-entries( v-delim-list )
     1034     :
     1035       assign
     1036         v-delim = entry( v-i , v-delim-list )
     1037         v-num   = num-entries( p-str , v-delim )
     1038       .
     1039       if v-num <> 3
     1040       then do:
     1041         assign
     1042           v-delim = ''
     1043         .
     1044       end.
     1045       else do:
     1046         leave _delim.
     1047       end.
     1048     end.
     1049     if v-delim = ''
     1050     then do:
     1051       assign
     1052         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
     1053       .
     1054       return .
     1055     end.
     1056     assign
     1057       v-day-str   = entry( 1, p-str , v-delim)
     1058       v-month-str = entry( 2, p-str , v-delim)
     1059       v-year-str  = entry( 3, p-str , v-delim)
     1060     .
     1061     if  length(v-day-str) > 2   or
     1062         length(v-day-str) < 1   or
     1063         length(v-month-str) > 2 or
     1064         length(v-month-str) < 1 or
     1065         (
     1066           length(v-year-str) <> 2 and
     1067           length(v-year-str) <> 4
     1068         )
     1069     then do:
     1070       assign
     1071         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
     1072       .
     1073       return .
     1074     end.
     1075     if length( v-year-str ) = 2
     1076     then do:
     1077       assign
     1078         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
     1079       .
     1080     end.
     1081     assign
     1082       v-day   = integer( v-day-str )
     1083       v-month = integer( v-month-str)
     1084       v-year  = integer( v-year-str)
     1085     no-error .
     1086     if error-status :error
     1087     then do:
     1088       assign
     1089         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
     1090       .
     1091       return .
     1092     end.
     1093     if v-day < 1  or
     1094        v-day > 31 or
     1095        v-month < 1 or
     1096        v-month > 12 or
     1097        v-year < 0   or
     1098        v-year > 5000
     1099     then do:
     1100       assign
     1101         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
     1102       .
     1103       return .
     1104     end.
     1105     assign
     1106       v-value = date( v-month, v-day, v-year )
     1107     no-error .
     1108     if error-status :error
     1109     then do:
     1110       assign
     1111         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
     1112       .
     1113       return .
     1114     end.
     1115     assign
     1116       p-value       = v-value
     1117       p-data-valid  = true
     1118     .
     1119   end.
     1120   end procedure.
