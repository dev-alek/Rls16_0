     1221   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
     1222                                             INPUT iFlagEmpty AS INTEGER).
     1223       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
     1224       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
     1225           DO:
     1226               IF iFlagEmpty = 0                           THEN RETURN "".
     1227               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
     1228               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
     1229               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
     1230               ELSE RETURN "".
     1231           END.
     1232       ELSE DO:
     1233           run xmlchar-encode in this-procedure (
     1234                 input sToPlace
     1235               , output sToPlace
     1236           ).
     1237           ASSIGN
     1238               sToPlace = sParName + '="' + sToPlace + '"'
     1239           .
     1240           RETURN sToPlace.
     1241       END.
     1242   END FUNCTION.
     1243   function bge-xml-date returns character
     1244   ( input p-date as date )
     1245   :
     1246     define variable v-date-str as character no-undo .
     1247     run bge-xml-date-to-str in this-procedure ( input   p-date
     1248                                               , output  v-date-str
     1249                                               ) .
     1250     return v-date-str.
     1251   end function.
     1252   function bge-xml-str-date returns character
     1253   ( input p-date-str as character )
     1254   :
     1255     define variable v-date-str as character no-undo .
     1256     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1257                                                   , output  v-date-str
     1258                                                   ) .
     1259     return v-date-str.
     1260   end function.
     1261   function bge-xml-normalize-dec returns decimal
     1262   ( input p-val as decimal )
     1263   :
     1264     return (if p-val = ? then 0 else p-val) .
     1265   end function.
     1266   PROCEDURE wp-XMLTagOpen:
     1267   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1268   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1269   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1270       define variable v-out-string    as character    no-undo.
     1271   do
     1272   on error undo, return error
     1273   :
     1274       if v-bge-xml-bgefmt = "dbf":U
     1275       then do:
     1276       end.
     1277       else do:
     1278           assign
     1279               v-out-string = substitute( "&1&2<&3&4>"
     1280                                       , chr(10)
     1281                                       , fill( " ":U, 4 * iTagLevel)
     1282                                       , sTagName
     1283                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1284                               )
     1285           .
     1286           put stream stmXMLOut unformatted
     1287               v-out-string
     1288           .
     1289       end.
     1290   end.
     1291   END PROCEDURE.
     1292   PROCEDURE wp-XMLTagPut:
     1293     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1294     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1295     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1296     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1297       define variable v-out-string    as character    no-undo.
     1298   do
     1299   on error undo, return error
     1300   :
     1301       if v-bge-xml-bgefmt = "dbf":U
     1302       then do:
     1303           if v-bge-xml-dbf-file-name <> "":U
     1304           then do:
     1305               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1306               export stream stmXMLOut
     1307                   sTagName
     1308                   sParValue
     1309               .
     1310               output stream stmXMLOut close.
     1311           end.
     1312       end.
     1313       else do:
     1314           IF  iFlagEmpty = 1
     1315           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1316           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1317           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1318           THEN DO:
     1319               run xmlchar-encode in this-procedure (
     1320                   input sParValue
     1321                   , output sParValue
     1322               ).
     1323               assign
     1324                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1325                                               , chr(10)
     1326                                               , FILL(" ", 4 * iTagLevel)
     1327                                               , sTagName
     1328                                               , sParValue
     1329                               )
     1330               .
     1331               PUT STREAM stmXMLOut UNFORMATTED
     1332                   v-out-string
     1333               .
     1334           END.
     1335       end.
     1336   end.
     1337   END PROCEDURE.
     1338   PROCEDURE wp-XMLTagClose:
     1339   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1340   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1341       define variable v-out-string    as character    no-undo.
     1342   do
     1343   on error undo, return error
     1344   :
     1345       if v-bge-xml-bgefmt = "dbf":U
     1346       then do:
     1347       end.
     1348       else do:
     1349           assign
     1350               v-out-string = substitute( "&1&2</&3>"
     1351                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1352                                   , fill( " ", 4 * iTagLevel )
     1353                                   , sTagName
     1354                           )
     1355           .
     1356           PUT STREAM stmXMLOut UNFORMATTED
     1357               v-out-string
     1358           .
     1359       end.
     1360   end.
     1361   END PROCEDURE.
     1362   PROCEDURE wp-XMLWriteLog:
     1363     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1364     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1365     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1366   define variable v-str              as character no-undo .
     1367   define variable v-error-append     as logical   no-undo .
     1368   define variable v-error-append-msg as character no-undo .
     1369   assign
     1370     v-str = chr(10)
     1371             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1372             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1373     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1374     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1375     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1376   .
     1377   run bge/bge-log.p (input v-str) no-error .
     1378   if error-status:error then do:
     1379     assign
     1380       v-error-append     = yes
     1381       v-error-append-msg = return-value
     1382     .
     1383   end.
     1384   run gbl/fileapnd.p
     1385     ( input sFileName
     1386     , input v-str
     1387     , input 10
     1388     ) no-error .
     1389   if error-status:error then do:
     1390     assign
     1391       v-error-append     = yes
     1392       v-error-append-msg = substitute( "&1&2&3"
     1393                                       , v-error-append-msg
     1394                                       , chr(10)
     1395                                       , return-value
     1396                                       )
     1397     .
     1398   end.
     1399   if v-error-append
     1400   then do:
     1401     return error substitute( "&1" , v-error-append-msg ) .
     1402   end.
     1403   END PROCEDURE.
     1404   PROCEDURE wp-XMLWriteEDT:
     1405     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1406     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1407     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1408       if valid-handle ( hEDT )
     1409       then do:
     1410           hEDT :move-to-eof().
     1411           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1412                                           OR sToWrite = "&Line") THEN "" ELSE
     1413                                           cur-time-string-sec() + " ").
     1414           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1415                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1416                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1417           hEDT :insert-string(chr(10)).
     1418       end.
     1419       process events.
     1420       output to 'bgescn.txt' append.
     1421           put unformatted
     1422               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1423                                           OR sToWrite = "&Line") THEN "" ELSE
     1424                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1425               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1426                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1427                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1428           .
     1429       output close.
     1430   END PROCEDURE.
     1431   PROCEDURE wp-XMLShowCNT:
     1432     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1433       if valid-handle( hCNT )
     1434       then do:
     1435           ASSIGN hCNT :VISIBLE = TRUE.
     1436       end.
     1437   END PROCEDURE.
     1438   PROCEDURE wp-XMLHideCNT:
     1439     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1440       if valid-handle( hCNT )
     1441       then do:
     1442           ASSIGN hCNT :VISIBLE = FALSE.
     1443       end.
     1444   END PROCEDURE.
     1445   PROCEDURE wp-XMLWriteCNT:
     1446     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1447     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1448       if valid-handle( hCNT )
     1449       then do:
     1450           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1451       end.
     1452   END PROCEDURE.
     1453   procedure bge-xml-write-header:
     1454   do
     1455   on error undo, return error
     1456   :
     1457   define input parameter p-xml-file-name  as character        no-undo.
     1458   define input parameter p-doc-name       as character        no-undo.
     1459   define input parameter p-version        as character        no-undo.
     1460   define input parameter p-db-num         as integer          no-undo.
     1461   define input parameter p-date-from      as date             no-undo.
     1462   define input parameter p-shift-num-from as integer          no-undo.
     1463   define input parameter p-date-to        as date             no-undo.
     1464   define input parameter p-shift-num-to   as integer          no-undo.
     1465   define input parameter p-obj-list       as character        no-undo.
     1466   define input parameter p-doc-type-list  as character        no-undo.
     1467   define input parameter p-pay-code       as logical          no-undo.
     1468   define input parameter p-cst            as logical          no-undo.
     1469   define input parameter p-parts          as logical          no-undo.
     1470   define input parameter p-chk-pay-code   as logical          no-undo.
     1471   define input parameter p-pay-desk       as logical          no-undo.
     1472   define input parameter p-pay-desk-cards as logical          no-undo.
     1473   define input parameter p-deleted        as logical          no-undo.
     1474   define input parameter p-opened-docs    as logical          no-undo.
     1475   define variable v-out-string    as character    no-undo.
     1476   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1477   assign
     1478       v-out-string = substitute( "&1&2&3"
     1479                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1480                           , chr(10)
     1481                           , "<IBS_Trade_House>":U )
     1482   .
     1483   put stream stmXMLOut unformatted
     1484       v-out-string
     1485   .
     1486   run wp-XMLTagOpen(1, "header","").
     1487   if v-bge-xml-bgeflold = "oracle":u
     1488   then do:
     1489     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1490     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1491     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1492     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1493     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1494   end.
     1495   run wp-XMLTagOpen( 2, "manifest", "").
     1496   run wp-XMLTagOpen( 3, "document", "").
     1497   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1498   run wp-XMLTagput( 4, "description", "", 0).
     1499   run wp-XMLTagput( 4, "version", p-version, 0).
     1500   run wp-XMLTagclose( 3, "document" ).
     1501   run wp-XMLTagclose( 2, "manifest" ).
     1502   run wp-XMLTagclose( 1, "header" ).
     1503   run wp-XMLTagOpen(1, "options","").
     1504   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1505   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1506   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1507   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1508   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1509   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1510   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1511   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1512   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1513   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1514   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1515   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1516   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1517   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1518   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1519   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1520   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1521   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1522   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1523   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1524   run wp-XMLTagClose(1, "options").
     1525   run wp-XMLTagOpen( 1, "body", "" ).
     1526   output stream stmXMLOut close.
     1527   end.
     1528   end procedure.
     1529   procedure xml-bge-write-footer:
     1530   do
     1531   on error undo, return error return-value
     1532   :
     1533   define input parameter p-xml-file-name as character    no-undo.
     1534   define variable v-error-num     as integer           no-undo.
     1535   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1536   run wp-XMLTagClose( 1, "body" ).
     1537   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1538   output stream stmXMLOut close.
     1539   if v-bge-xml-bgeflold = "oracle":u
     1540   then do:
     1541     define variable v-tmp-file-name         as character no-undo .
     1542     define variable v-zip-file-name         as character no-undo .
     1543     define variable v-exch-file-name        as character no-undo .
     1544     define variable v-heap-file-name        as character no-undo .
     1545     define variable v-i                     as integer   no-undo .
     1546     define variable v-file-name             as character no-undo .
     1547     define variable v-arc                   as character no-undo .
     1548     define variable v-str                   as character no-undo .
     1549     define variable v-exch-tmp-file-name    as character no-undo .
     1550     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1551     define variable v-bge-xml-exch-dir      as character no-undo .
     1552     define variable v-bge-xml-heap-dir      as character no-undo .
     1553     define variable v-bge-xml-compress-heap as logical   no-undo .
     1554     define variable v-home-dir              as character no-undo .
     1555     define variable v-os-command            as character no-undo .
     1556     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1557     if v-home-dir = ?
     1558     then do:
     1559       undo, return error substitute( "&1&2&3"
     1560                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1561                                     , chr(10)
     1562                                     , "Обратитесь к администратору.":u
     1563                                     ).
     1564     end.
     1565     assign
     1566       v-home-dir = v-home-dir
     1567     .
     1568     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1569     if error-status :error
     1570     then do:
     1571       undo, return error substitute( "&1&2&3"
     1572                                     , "Неверно задан каталог экспорта.":u
     1573                                     , chr(10)
     1574                                     , "Обратитесь к администратору.":u
     1575                                     ).
     1576     end.
     1577     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1578     if v-bge-xml-exch-dir = ?
     1579     then do:
     1580       undo, return error substitute( "&1&2&3"
     1581                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1582                                     , chr(10)
     1583                                     , "Обратитесь к администратору.":u
     1584                                     ).
     1585     end.
     1586     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1587     if error-status :error
     1588     then do:
     1589       undo, return error substitute( "&1&2&3"
     1590                                     , "Неверно задан каталог экспорта (exch).":u
     1591                                     , chr(10)
     1592                                     , "Обратитесь к администратору.":u
     1593                                     ).
     1594     end.
     1595     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1596     if v-bge-xml-heap-dir = ?
     1597     then do:
     1598       undo, return error substitute( "&1&2&3"
     1599                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1600                                     , chr(10)
     1601                                     , "Обратитесь к администратору.":u
     1602                                     ).
     1603     end.
     1604     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1605     if error-status :error
     1606     then do:
     1607       undo, return error substitute( "&1&2&3"
     1608                                     , "Неверно задан каталог экспорта (heap).":u
     1609                                     , chr(10)
     1610                                     , "Обратитесь к администратору.":u
     1611                                     ).
     1612     end.
     1613     get-key-value section "BGE" key "heap-compress" value v-str.
     1614     assign
     1615       v-i = int(v-str)
     1616     no-error .
     1617     if v-i = ? or v-i = 0
     1618     then do:
     1619       assign
     1620         v-bge-xml-compress-heap = no
     1621       .
     1622     end.
     1623     else do:
     1624       assign
     1625         v-bge-xml-compress-heap = yes
     1626       .
     1627     end.
     1628     assign
     1629       v-arc = search( "exe/7za.exe":u )
     1630     .
     1631     if v-arc = ? or v-arc = ""
     1632     then do:
     1633       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1634     end.
     1635     assign
     1636       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1637       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1638       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1639       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1640       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1641       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1642       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1643     .
     1644     run gbl/del-file.p (input v-tmp-file-name) .
     1645     run gbl/del-file.p (input v-zip-file-name) .
     1646     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1647     if v-error-num > 0
     1648     then do:
     1649         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1650                                      , p-xml-file-name + "xm1":u
     1651                                      , v-tmp-file-name
     1652                                      , v-error-num
     1653                                      ).
     1654     end.
     1655     assign
     1656       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1657                                    , v-arc
     1658                                    , v-zip-file-name
     1659                                    , v-tmp-file-name
     1660                                    )
     1661     .
     1662     os-command silent value ( v-os-command ) .
     1663     run gbl/del-file.p (input v-heap-file-name) .
     1664     if v-bge-xml-compress-heap = no
     1665     then do:
     1666       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1667       if v-error-num > 0
     1668       then do:
     1669           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1670                                        , v-tmp-file-name
     1671                                        , v-heap-file-name
     1672                                        , v-error-num
     1673                                        ) .
     1674       end.
     1675     end.
     1676     else do:
     1677       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1678       if v-error-num > 0
     1679       then do:
     1680           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1681                                        , v-zip-file-name
     1682                                        , v-heap-file-name
     1683                                        , v-error-num
     1684                                        ) .
     1685       end.
     1686     end.
     1687     run gbl/del-file.p (input v-tmp-file-name) .
     1688     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1689     if error-status :error then do:
     1690       undo, return error substitute( "&1&2&3"
     1691                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1692                                     , chr(10)
     1693                                     , "Обратитесь к администратору."
     1694                                     ).
     1695     end.
     1696     run gbl/del-file.p (input v-exch-file-name) .
     1697     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1698     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1699     if v-error-num > 0
     1700     then do:
     1701       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1702                                     , v-zip-file-name
     1703                                     , v-exch-tmp-file-name
     1704                                     , v-error-num
     1705                                     ) .
     1706     end.
     1707     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1708     if v-error-num > 0
     1709     then do:
     1710       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1711                                     , v-exch-tmp-file-name
     1712                                     , v-exch-file-name
     1713                                     , v-error-num
     1714                                     ) .
     1715     end.
     1716     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1717   end.
     1718   else do:
     1719     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1720     if v-error-num > 0
     1721     then do:
     1722       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1723                                     , p-xml-file-name + "xm1"
     1724                                     , p-xml-file-name + "xml"
     1725                                     , v-error-num
     1726                                     ) .
     1727     end.
     1728   end.
     1729   if opsys = "unix"
     1730   then do:
     1731       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1732   end.
     1733   end.
     1734   end procedure.
     1735   procedure xml-bge-filename0:
     1736   define input parameter p-prefix   as character no-undo .
     1737   define input parameter p-name     as character no-undo .
     1738   define input parameter p-shared-process as logical no-undo .
     1739   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1740   define output parameter p-xml-file-name  as character no-undo .
     1741   // define output parameter p-fullfnamenoext as character no-undo .
     1742   define output parameter p-locked         as logical      no-undo.
     1743   define variable v-fullfnamenoext as character no-undo .
     1744   define variable v-fileext        as character no-undo .
     1745   define variable v-fullfname      as character no-undo .
     1746   define variable v-error-num      as integer   no-undo .
     1747   do
     1748   on error undo, return error
     1749   :
     1750     case v-bge-xml-bgeflold :
     1751       when "old" then do:
     1752         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1753         v-fileext       = ".xml":U .
     1754         v-fullfname     = v-fullfnamenoext + v-fileext .
     1755         p-xml-file-name = v-fullfname .
     1756         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1757         if v-error-num > 0 then do:
     1758           return error.
     1759         end.
     1760       end.
     1761       when "var" then do:
     1762         case p-prefix :
     1763           when "doc" then do:
     1764             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1765             v-fileext       = ".xml":U .
     1766             v-fullfname     = v-fullfnamenoext + v-fileext .
     1767             p-xml-file-name = v-fullfname .
     1768           end.
     1769           when "day" then do:
     1770             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1771             v-fileext       = ".xml":U .
     1772             v-fullfname     = v-fullfnamenoext + v-fileext .
     1773             p-xml-file-name = v-fullfname .
     1774           end.
     1775           otherwise do:
     1776             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1777             v-fileext       = ".xml":U .
     1778             v-fullfname     = v-fullfnamenoext + v-fileext .
     1779             p-xml-file-name = v-fullfname .
     1780           end.
     1781         end case.
     1782         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1783         if v-error-num > 0 then do:
     1784           return error.
     1785         end.
     1786       end.
     1787       when "new" then do:
     1788                   run bge/genfname.p (
     1789                       input p-home-dir
     1790                       , input p-prefix
     1791                       , input ""
     1792                       , input "xml"
     1793                       , input ""
     1794                       , output p-xml-file-name
     1795                   ).
     1796       end.
     1797       when "no-parameter" then do:
     1798         if p-shared-process then do:
     1799                       run bge/genfname.p (
     1800                           input p-home-dir
     1801                           , input "d"
     1802                           , input ""
     1803                           , input "xml"
     1804                           , input ""
     1805                           , output p-xml-file-name
     1806                       ).
     1807         end.
     1808         else do:
     1809           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1810           v-fileext       = ".xml":U .
     1811           v-fullfname     = v-fullfnamenoext + v-fileext .
     1812           p-xml-file-name = v-fullfname .
     1813           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1814           if v-error-num > 0 then do:
     1815             return error.
     1816           end.
     1817         end.
     1818       end.
     1819     end case.
     1820     assign
     1821       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1822       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1823     .
     1824   end .
     1825   end procedure .
     1826   procedure xml-bge-filename :
     1827   do
     1828   on error undo, return error
     1829   :
     1830   define input parameter p-prefix             as character    no-undo.
     1831   define input parameter p-name               as character    no-undo.
     1832   define input parameter p-shared-process     as logical      no-undo.
     1833   define output parameter p-xml-file-name     as character    no-undo.
     1834   define output parameter p-log-file-name     as character    no-undo.
     1835   define output parameter p-locked            as logical      no-undo.
     1836   define variable v-home-dir          as character no-undo .
     1837   define variable v-error-num         as integer   no-undo .
     1838   define variable v-bge-xml-heap-dir  as character no-undo .
     1839       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1840       if v-home-dir = ?
     1841       then do:
     1842           message
     1843             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1844             skip(1)
     1845             skip "Обратитесь к администратору."
     1846           view-as alert-box error.
     1847           undo, return error .
     1848       end.
     1849       if v-bge-xml-bgeflold <> "oracle"
     1850       then do:
     1851         assign
     1852             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1853         .
     1854       end.
     1855       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1856       if error-status :error
     1857       then do:
     1858           message
     1859             skip "Неверно задан каталог экспорта."
     1860             skip(1)
     1861             skip "Обратитесь к администратору."
     1862           view-as alert-box error.
     1863           undo, return error .
     1864       end.
     1865       if v-bge-xml-bgefmt = "dbf":U
     1866       then do:
     1867           assign
     1868               p-xml-file-name = v-home-dir
     1869               p-locked        = no
     1870           .
     1871       end.
     1872       else do:
     1873           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1874             output p-xml-file-name, output p-locked) .
     1875       end.
     1876       if v-bge-xml-bgeflold = "oracle"
     1877       then do:
     1878         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1879         if v-bge-xml-heap-dir = ?
     1880         then do:
     1881           undo, return error substitute( "&1&2&3"
     1882                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1883                                         , chr(10)
     1884                                         , "Обратитесь к администратору.":u
     1885                                         ).
     1886         end.
     1887         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1888         if error-status :error
     1889         then do:
     1890           undo, return error substitute( "&1&2&3"
     1891                                         , "Неверно задан каталог экспорта (heap).":u
     1892                                         , chr(10)
     1893                                         , "Обратитесь к администратору.":u
     1894                                         ).
     1895         end.
     1896         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1897           assign
     1898             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1899           .
     1900         end.
     1901         else do:
     1902           assign
     1903             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1904           .
     1905         end.
     1906       end.
     1907       else do:
     1908         assign
     1909             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1910         .
     1911       end.
     1912       assign
     1913          v-bge-xml-static-log-file-name = p-log-file-name
     1914       .
     1915   end.
     1916   end procedure.
     1917   procedure bge-xml-read-config :
     1918   do
     1919   on error undo, return error return-value
     1920   :
     1921   define input  parameter p-last-date as date      no-undo .
     1922   define input  parameter p-db-num    as integer   no-undo .
     1923       define variable v-bgeclall      as character     no-undo.
     1924       define variable v-bgedict       as character     no-undo.
     1925       define variable v-bgeshift      as character     no-undo.
     1926       define variable v-par-type      as character     no-undo.
     1927       define variable v-bgeflnm       as character     no-undo.
     1928       define variable v-bgecliiv      as character     no-undo .
     1929       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1930       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1931       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1932       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1933       define variable v-db-num-str    as character     no-undo .
     1934       define variable v-param-type      as character  no-undo .
     1935       define variable v-value-character as character  no-undo .
     1936       define variable v-value-date      as date       no-undo .
     1937       define variable v-value-decimal   as decimal    no-undo .
     1938       define variable v-value-integer   as integer    no-undo .
     1939       define variable v-value-logical   as logical    no-undo .
     1940       define variable v-tth             as handle      no-undo .
     1941       run adm/shattri.p ( input "get":U
     1942                         , input  '':u
     1943                         , input  0
     1944                         , input  'bge-export':U
     1945                         , input  'bgeclall':U
     1946                         , output v-bgecliiv
     1947                         , output v-value-date
     1948                         , output v-value-decimal
     1949                         , output v-value-integer
     1950                         , output v-value-logical
     1951                         , output v-param-type
     1952                         , input-output table-handle v-tth
     1953                         ) no-error .
     1954       if error-status :error
     1955       then do:
     1956         assign
     1957           v-bge-xml-bgecliiv = no
     1958         .
     1959       end.
     1960       else do:
     1961         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1962       end.
     1963       delete object v-tth.
     1964       assign
     1965           v-bge-xml-bgeclall = no
     1966           v-bge-xml-bgedict  = no
     1967       .
     1968       run adm/shattri.p ( input "get":U
     1969                         , input  '':u
     1970                         , input  0
     1971                         , input  'bge-export':U
     1972                         , input  'bgeclall':U
     1973                         , output v-value-character
     1974                         , output v-value-date
     1975                         , output v-value-decimal
     1976                         , output v-value-integer
     1977                         , output v-value-logical
     1978                         , output v-param-type
     1979                         , input-output table-handle v-tth
     1980                         ) no-error .
     1981       if error-status :error
     1982       then do:
     1983         assign
     1984           v-bge-xml-bgeclall = no
     1985         .
     1986       end.
     1987       else do:
     1988         assign
     1989           v-bge-xml-bgeclall = v-value-logical
     1990         .
     1991       end.
     1992       delete object v-tth.
     1993       run adm/shattri.p ( input "get":U
     1994                         , input  '':u
     1995                         , input  0
     1996                         , input  'bge-export':U
     1997                         , input  'bgedict':U
     1998                         , output v-value-character
     1999                         , output v-value-date
     2000                         , output v-value-decimal
     2001                         , output v-value-integer
     2002                         , output v-value-logical
     2003                         , output v-param-type
     2004                         , input-output table-handle v-tth
     2005                         ) no-error .
     2006       if error-status :error
     2007       then do:
     2008         assign
     2009           v-bge-xml-bgedict = no
     2010         .
     2011       end.
     2012       else do:
     2013         assign
     2014           v-bge-xml-bgedict = v-value-logical
     2015         .
     2016       end.
     2017       delete object v-tth.
     2018       run adm/shattri.p ( input "get":U
     2019                         , input  '':u
     2020                         , input  0
     2021                         , input  'bge-export':U
     2022                         , input  'bgefmt':U
     2023                         , output v-value-character
     2024                         , output v-value-date
     2025                         , output v-value-decimal
     2026                         , output v-value-integer
     2027                         , output v-value-logical
     2028                         , output v-param-type
     2029                         , input-output table-handle v-tth
     2030                         ) no-error .
     2031       if error-status :error
     2032       then do:
     2033         assign
     2034           v-bge-xml-bgefmt  = "xml":U
     2035         .
     2036       end.
     2037       else do:
     2038         assign
     2039           v-bge-xml-bgefmt  = v-value-character
     2040         .
     2041       end.
     2042       delete object v-tth.
     2043       run adm/shattri.p ( input "get":U
     2044                         , input  '':u
     2045                         , input  0
     2046                         , input  'bge-export':U
     2047                         , input  'bgeshift':U
     2048                         , output v-value-character
     2049                         , output v-value-date
     2050                         , output v-value-decimal
     2051                         , output v-value-integer
     2052                         , output v-value-logical
     2053                         , output v-param-type
     2054                         , input-output table-handle v-tth
     2055                         ) no-error .
     2056       if error-status :error
     2057       then do:
     2058         assign
     2059             v-bge-xml-shift-mode = no
     2060         .
     2061       end.
     2062       else do:
     2063         assign
     2064             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     2065         .
     2066       end.
     2067       delete object v-tth.
     2068       run adm/shattri.p ( input "get":U
     2069                         , input  '':u
     2070                         , input  0
     2071                         , input  'bge-export':U
     2072                         , input  'bgeflold':U
     2073                         , output v-value-character
     2074                         , output v-value-date
     2075                         , output v-value-decimal
     2076                         , output v-value-integer
     2077                         , output v-value-logical
     2078                         , output v-param-type
     2079                         , input-output table-handle v-tth
     2080                         ) no-error .
     2081       if error-status :error
     2082       then do:
     2083         assign
     2084           v-bge-xml-bgeflold = "no-parameter":U
     2085         .
     2086       end.
     2087       else do:
     2088         assign
     2089           v-bge-xml-bgeflold  = v-value-character
     2090         .
     2091       end.
     2092       delete object v-tth.
     2093       assign
     2094         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     2095         v-bge-xml-db-num-str  = v-db-num-str
     2096       .
     2097       if p-last-date <> ?
     2098       then do:
     2099           run adm/shattri.p ( input "get":U
     2100                             , input  '':u
     2101                             , input  0
     2102                             , input  'bge-export':U
     2103                             , input  'bgeflnm':U
     2104                             , output v-value-character
     2105                             , output v-value-date
     2106                             , output v-value-decimal
     2107                             , output v-value-integer
     2108                             , output v-value-logical
     2109                             , output v-param-type
     2110                             , input-output table-handle v-tth
     2111                             ) no-error .
     2112           if error-status :error
     2113           then do:
     2114             assign
     2115               v-bgeflnm = '':U
     2116             .
     2117           end.
     2118           else do:
     2119             assign
     2120               v-bgeflnm = v-value-character
     2121             .
     2122           end.
     2123           delete object v-tth.
     2124           if v-bge-xml-bgeflold = "var"
     2125           then do:
     2126               if v-bgeflnm = ?
     2127               or num-entries( v-bgeflnm ) < 2
     2128               then do:
     2129                   assign
     2130                       v-bge-xml-bgeflold = "new"
     2131                   .
     2132               end.
     2133               else do:
     2134                   assign
     2135                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     2136                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     2137                   .
     2138                   assign
     2139                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     2140                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     2141                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2142                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     2143                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     2144                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     2145                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     2146                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     2147                   .
     2148               end.
     2149           end.
     2150       end.
     2151   end.
     2152   end procedure.
     2153   procedure bge-xml-get-ref-filename :
     2154   define input parameter p-in-file-name       as character        no-undo.
     2155   define output parameter p-home-dir          as character        no-undo.
     2156   define output parameter p-out-file-name     as character        no-undo.
     2157   define output parameter p-locked            as logical          no-undo.
     2158       define variable v-counter       as integer      no-undo.
     2159       define variable v-error-level   as integer      no-undo.
     2160   do
     2161   on error undo, return error
     2162   :
     2163       run bge/bge-ini.p (
     2164             input "bge"
     2165           , output p-home-dir
     2166       ).
     2167       if return-value <> "OK"
     2168       then do:
     2169           undo, return error.
     2170       end.
     2171       assign
     2172           p-home-dir = p-home-dir + "\dict":U
     2173       .
     2174       run bge/dir_cd.p (
     2175           input p-home-dir
     2176           , input "CA"
     2177       ).
     2178       if return-value = "ERROR"
     2179       then do:
     2180           undo, return error.
     2181       end.
     2182       assign
     2183           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     2184       .
     2185       assign
     2186           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     2187       .
     2188       wait-lock:
     2189       do v-counter = 1 TO 3
     2190       :
     2191           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     2192           if p-locked = no
     2193           then do:
     2194               leave wait-lock.
     2195           end.
     2196           else do:
     2197               readkey pause 1.
     2198           end.
     2199       END.
     2200       if p-locked = yes
     2201       then do:
     2202           undo, return error.
     2203       end.
     2204       run bge/os_copy.p (
     2205             input "D":U
     2206           , input p-out-file-name + "xml":U
     2207           , input "":U
     2208           , output v-error-level
     2209       ).
     2210       if v-error-level > 0
     2211       then do:
     2212           undo, return error.
     2213       end.
     2214   end.
     2215   end procedure.
     2216   procedure bge-xml-write-ref-header :
     2217   define input parameter p-bge-name as character        no-undo.
     2218   define input parameter p-file-name as character        no-undo.
     2219       define variable v-out-string    as character    no-undo.
     2220   do
     2221   on error undo, return error
     2222   :
     2223       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     2224       put stream stmXMLOut unformatted
     2225           "<?xml version='1.0' encoding='windows-1251'?>":U
     2226       .
     2227       assign
     2228           v-out-string = substitute( "&1&2"
     2229                               , chr(10)
     2230                               , "<IBS_Trade_House>":U )
     2231       .
     2232       put stream stmXMLOut unformatted
     2233           v-out-string
     2234       .
     2235       run wp-XMLTagOpen( 1, "header", "" ).
     2236       if v-bge-xml-bgeflold = "oracle":u
     2237       then do:
     2238         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     2239         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     2240         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     2241         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     2242         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2243       end.
     2244       else do:
     2245         run wp-XMLTagOpen( 2, "delivery", "" ).
     2246         run wp-XMLTagOpen( 3, "to", "" ).
     2247         run wp-XMLTagClose( 3, "to" ).
     2248         run wp-XMLTagOpen( 3, "from", "" ).
     2249         run wp-XMLTagClose( 3, "from" ).
     2250         run wp-XMLTagClose( 2, "delivery" ).
     2251       end.
     2252       run wp-XMLTagOpen( 2, "manifest", "" ).
     2253       run wp-XMLTagOpen( 3, "document", "" ).
     2254       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2255       run wp-XMLTagPut( 4, "description", "", 0 ).
     2256       run wp-XMLTagClose( 3, "document" ).
     2257       run wp-XMLTagClose( 2, "manifest" ).
     2258       run wp-XMLTagClose( 1, "header" ).
     2259       run wp-XMLTagOpen( 1, "body", "" ).
     2260   end.
     2261   end procedure.
     2262   procedure bge-xml-write-ref-footer :
     2263   define input parameter p-file-name as character        no-undo.
     2264       define variable v-error-level   as integer      no-undo.
     2265   do
     2266   on error undo, return error
     2267   :
     2268       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2269       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2270       output stream stmXMLOut close.
     2271       run bge/os_copy.p (
     2272             input "M":U
     2273           , input p-file-name + "xm1":U
     2274           , input p-file-name + "xml":U
     2275           , output v-error-level
     2276       ).
     2277       if v-error-level > 0
     2278       then do:
     2279           undo, return error.
     2280       end.
     2281   end.
     2282   end procedure.
     2283   procedure bge-xml-out-dir :
     2284   define output parameter p-out-dir       as character    no-undo.
     2285   define output parameter p-log-file-name as character    no-undo.
     2286   do
     2287   on error undo, return error
     2288   :
     2289       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2290       if p-out-dir = ?
     2291       then do:
     2292           message
     2293             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2294                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2295             skip(1)
     2296             skip "Обратитесь к администратору."
     2297           view-as alert-box error.
     2298           undo, return error .
     2299       end.
     2300       if v-bge-xml-bgeflold <> "oracle" then assign
     2301         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2302       .
     2303       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2304       if error-status :error  then do:
     2305           run wp-XMLWriteLog in this-procedure (
     2306                 input p-log-file-name
     2307               , input 0
     2308               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2309                                   , p-out-dir
     2310                                   , return-value
     2311                                   , trim( error-status :get-message( 1 ) )
     2312                                   )
     2313           ).
     2314           undo, return error.
     2315       end.
     2316       assign
     2317           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2318           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2319       .
     2320   end.
     2321   end procedure.
     2322   procedure bge-xml-out-dir2 :
     2323   define output parameter p-out-dir       as character    no-undo.
     2324   define output parameter p-out-dirR      as character    no-undo.
     2325   define output parameter p-log-file-name as character    no-undo.
     2326   do
     2327   on error undo, return error
     2328   :
     2329       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2330       if p-out-dir = ?
     2331       then do:
     2332           message
     2333             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2334                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2335             skip(1)
     2336             skip "Обратитесь к администратору."
     2337           view-as alert-box error.
     2338           undo, return error .
     2339       end.
     2340       if v-bge-xml-bgeflold <> "oracle" then assign
     2341             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2342             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2343         .
     2344       else p-out-dirR = p-out-dir .
     2345       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2346       if error-status :error  then do:
     2347           run wp-XMLWriteLog in this-procedure (
     2348                 input p-log-file-name
     2349               , input 0
     2350               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2351                                   , p-out-dir
     2352                                   , return-value
     2353                                   , error-status :get-message( 1 )
     2354                                   )
     2355           ).
     2356           undo, return error.
     2357       end.
     2358       if p-out-dirR <> p-out-dir then do:
     2359         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2360         if error-status :error then do:
     2361           run wp-XMLWriteLog in this-procedure (
     2362                 input p-log-file-name
     2363               , input 0
     2364               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2365                                   , p-out-dirR
     2366                                   , return-value
     2367                                   , error-status :get-message( 1 )
     2368                                   )
     2369           ).
     2370           p-out-dirR = p-out-dir .
     2371         end.
     2372       end .
     2373       assign
     2374         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2375         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2376       .
     2377   end.
     2378   end procedure.
     2379   procedure bge-xml-out-file :
     2380   do
     2381   on error undo, return error
     2382   :
     2383   define input parameter p-out-dir            as character        no-undo.
     2384   define input parameter p-prefix             as character        no-undo.
     2385   define input parameter p-sheduled           as logical          no-undo.
     2386   define output parameter p-xml-file-name     as character        no-undo.
     2387   define output parameter p-locked            as logical          no-undo.
     2388   define variable v-home-dir      as character     no-undo.
     2389   define variable v-error-num     as integer       no-undo.
     2390   define variable v-today             as date         no-undo.
     2391   define variable v-time              as integer      no-undo.
     2392       if v-bge-xml-bgefmt = "dbf":U
     2393       then do:
     2394           assign
     2395               p-xml-file-name = p-out-dir
     2396               p-locked        = no
     2397           .
     2398       end.
     2399       else do:
     2400           if v-bge-xml-bgeflold = "firm":U
     2401           then do:
     2402               run bge/genfname.p (
     2403                     input p-out-dir
     2404                   , input p-prefix
     2405                   , input "":U
     2406                   , input "arj":U
     2407                   , input "":U
     2408                   , output p-xml-file-name
     2409               ).
     2410           end.
     2411           else do:
     2412               run bge/genfname.p (
     2413                     input p-out-dir
     2414                   , input p-prefix
     2415                   , input "":U
     2416                   , input "xml":U
     2417                   , input "":U
     2418                   , output p-xml-file-name
     2419               ).
     2420           end.
     2421           assign
     2422               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2423               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2424           .
     2425       end.
     2426   end.
     2427   end procedure.
     2428   procedure bge-xml-init-ext-doc-type :
     2429       define variable v-counter    as integer      no-undo.
     2430       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2431   do
     2432   for buf_temp_ext-doc-type
     2433   on error undo, return error
     2434   :
     2435       empty temp-table buf_temp_ext-doc-type.
     2436       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2437       :
     2438           create buf_temp_ext-doc-type.
     2439           assign
     2440               buf_temp_ext-doc-type.edt-key               = v-counter
     2441               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2442               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2443           .
     2444       end.
     2445   end.
     2446   end procedure.
     2447   procedure bge-xml-get-decimal-shift-num :
     2448   define input parameter p-shift-date     as date             no-undo.
     2449   define input parameter p-shift-num      as integer          no-undo.
     2450   define output parameter p-shift-decimal as decimal          no-undo.
     2451   do
     2452   on error undo, return error
     2453   :
     2454       assign
     2455           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2456       .
     2457   end.
     2458   end procedure.
     2459   procedure bge-xml-ora-exp-filename :
     2460     define input  parameter p-table-name  as character no-undo .
     2461     define input  parameter p-doc-code    as character no-undo .
     2462     define input  parameter p-obj-code    as integer   no-undo .
     2463     define output parameter p-filename    as character no-undo .
     2464     define output parameter p-seq-num     as integer   no-undo .
     2465     define variable v-ora-exp-seq     as integer   no-undo .
     2466     define variable v-ora-exp-seq-str as character no-undo .
     2467     define variable v-home-dir        as character no-undo.
     2468   do
     2469   on error undo, return error return-value
     2470   :
     2471     if v-bge-xml-bgeflold = "oracle":u
     2472     then do:
     2473       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2474       if v-home-dir = ?
     2475       then do:
     2476         undo, return error substitute( "&1&2&3":U
     2477                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2478                                       , chr(10)
     2479                                       , "Обратитесь к администратору.":U
     2480                                       ).
     2481       end.
     2482       assign
     2483           v-home-dir = v-home-dir
     2484       .
     2485       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2486       if error-status :error
     2487       then do:
     2488         undo, return error substitute( "&1&2&3":U
     2489                                       , "Неверно задан каталог экспорта.":U
     2490                                       , chr(10)
     2491                                       , "Обратитесь к администратору.":U
     2492                                       ).
     2493       end.
     2494       assign
     2495         v-ora-exp-seq = ?
     2496       .
     2497       if  p-table-name <> ? and
     2498           p-doc-code <> ?
     2499       then do:
     2500         run bge/get-oesq.p ( input p-table-name
     2501                            , input p-doc-code
     2502                            , output v-ora-exp-seq
     2503                            ) no-error .
     2504         if error-status :error = yes
     2505         then do:
     2506           undo, return error return-value .
     2507         end.
     2508       end.
     2509       if v-ora-exp-seq = ?
     2510       then do:
     2511         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2512         if error-status :error
     2513         then do:
     2514           undo, return error return-value .
     2515         end.
     2516       end.
     2517       if p-table-name <> ? and
     2518          p-doc-code   <> ?
     2519       then do:
     2520         run bge/oesqdoc.p ( input p-table-name
     2521                           , input p-doc-code
     2522                           , input v-ora-exp-seq
     2523                           ) no-error .
     2524         if error-status :error = yes
     2525         then do:
     2526           undo, return error return-value .
     2527         end.
     2528       end.
     2529       assign
     2530         p-seq-num  = v-ora-exp-seq
     2531         p-filename = substitute("&1/&2-000_&3."
     2532                                , v-home-dir
     2533                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2534                                , string(v-ora-exp-seq , "999999999")
     2535                                )
     2536       .
     2537     end.
     2538   end.
     2539   end procedure.
     2540   procedure bge-xml-date-to-str :
     2541     define input  parameter p-date  as date      no-undo .
     2542     define output parameter p-str   as character no-undo .
     2543   do
     2544   on error undo, return error return-value
     2545   :
     2546     if p-date <> ?
     2547     then do:
     2548       assign
     2549         p-str = substitute( "&1-&2-&3"
     2550                           , string( year(p-date)  , "9999")
     2551                           , string( month(p-date) , "99"  )
     2552                           , string( day(p-date)   , "99"  )
     2553                           )
     2554       .
     2555     end.
     2556     else do:
     2557       assign
     2558         p-str = ?
     2559       .
     2560     end.
     2561   end.
     2562   end procedure.
     2563   procedure bge-xml-date-str-to-str :
     2564     define input  parameter p-date-str  as character no-undo .
     2565     define output parameter p-str       as character no-undo .
     2566     define variable v-date          as date      no-undo .
     2567     define variable v-date-valid    as logical   no-undo .
     2568     define variable v-error-message as character no-undo .
     2569   do
     2570   on error undo, return error return-value
     2571   :
     2572     assign
     2573       p-str = ?
     2574     .
     2575     if p-date-str = ? or p-date-str = ""
     2576     then do:
     2577       return .
     2578     end.
     2579     run strtdate in this-procedure ( input  p-date-str
     2580                                    , output v-date
     2581                                    , output v-date-valid
     2582                                    , output v-error-message
     2583                                    ).
     2584     if v-date-valid <> true
     2585     then do:
     2586       return .
     2587     end.
     2588     assign
     2589       p-str = substitute( "&1-&2-&3"
     2590                         , string( year(v-date)  , "9999")
     2591                         , string( month(v-date) , "99"  )
     2592                         , string( day(v-date)   , "99"  )
     2593                         )
     2594     .
     2595   end.
     2596   end procedure.
     2597   procedure bge-xml-fill-tt-bgecliiv :
     2598     define input  parameter p-str as character no-undo .
     2599     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2600     define buffer buf_clients             for ub.clients.
     2601     define variable v-i         as integer   no-undo .
     2602     define variable v-count     as integer   no-undo .
     2603     define variable v-cli-count as integer   no-undo .
     2604     define variable v-client    as character no-undo .
     2605     define variable v-obj-type  as character no-undo .
     2606     define variable v-obj-code  as integer   no-undo .
     2607   do
     2608   on error undo, return error return-value
     2609   :
     2610     empty temp-table buf_tt-bge-xml-bgecliiv.
     2611     assign
     2612       v-bge-xml-bgecliiv = no
     2613       v-cli-count        = num-entries(p-str,';')
     2614     .
     2615     if v-cli-count > 0
     2616     then do:
     2617       _cli-cycle:
     2618       do v-i = 1 to v-cli-count
     2619       :
     2620         assign
     2621           v-client = entry(v-i , p-str, ';')
     2622         .
     2623         if num-entries(v-client) <> 2
     2624         then do:
     2625           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2626         end.
     2627         assign
     2628           v-obj-type = entry(1, v-client)
     2629         .
     2630         assign
     2631           v-obj-code = integer(entry(2, v-client))
     2632         no-error .
     2633         if error-status :error
     2634         then do:
     2635           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2636         end.
     2637         find first buf_clients no-lock
     2638           where buf_clients.obj-type = v-obj-type
     2639             and buf_clients.obj-code = v-obj-code
     2640         no-error.
     2641         if not available buf_clients
     2642         then do:
     2643           next _cli-cycle.
     2644         end.
     2645         find first buf_tt-bge-xml-bgecliiv no-lock
     2646           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2647             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2648         no-error .
     2649         if available buf_tt-bge-xml-bgecliiv
     2650         then do:
     2651           next _cli-cycle.
     2652         end.
     2653         create buf_tt-bge-xml-bgecliiv.
     2654         assign
     2655           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2656           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2657         .
     2658       end.
     2659     end.
     2660     else do:
     2661       assign
     2662         v-bge-xml-bgecliiv = no
     2663       .
     2664       return .
     2665     end.
     2666     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2667     if available buf_tt-bge-xml-bgecliiv
     2668     then do:
     2669       assign
     2670         v-bge-xml-bgecliiv = yes
     2671       .
     2672     end.
     2673   end.
     2674   end procedure.
     2675   procedure bge-xml-resolve-ext-doc-type :
     2676     define input  parameter p-ext-doc-type      as character no-undo .
     2677     define input  parameter p-obj-type          as character no-undo .
     2678     define input  parameter p-obj-code          as integer   no-undo .
     2679     define output parameter p-out-ext-doc-type  as character no-undo .
     2680     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2681   do
     2682   on error undo, return error return-value
     2683   :
     2684     assign
     2685       p-out-ext-doc-type = p-ext-doc-type
     2686     .
     2687     if p-ext-doc-type <> 'ie':U
     2688     then do:
     2689       return .
     2690     end.
     2691     if v-bge-xml-bgecliiv = yes
     2692     then do:
     2693       find first buf_tt-bge-xml-bgecliiv no-lock
     2694         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2695           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2696       no-error .
     2697       if available buf_tt-bge-xml-bgecliiv
     2698       then do:
     2699         assign
     2700           p-out-ext-doc-type = 'iv':U
     2701         .
     2702       end.
     2703     end.
     2704   end.
     2705   end procedure.
     2706   procedure safe-wp-xmltagput :
     2707     define input  parameter pTagLevel   as integer   no-undo .
     2708     define input  parameter pTagName    as character no-undo .
     2709     define input  parameter pParValue   as character no-undo .
     2710     define input  parameter pFlagEmpty  as integer   no-undo .
     2711   do
     2712   on error undo, return error return-value
     2713   :
     2714     if v-bge-xml-bgeflold = "oracle":u
     2715     then do:
     2716       return .
     2717     end.
     2718     run wp-xmltagput in this-procedure ( input pTagLevel
     2719                                        , input pTagName
     2720                                        , input pParValue
     2721                                        , input pFlagEmpty
     2722                                        ).
     2723   end.
     2724   end procedure.
     2725   define temp-table tt-docs no-undo
     2726     field doc-type as character
     2727     field doc-code as character
     2728     field obj-type as character
     2729     field obj-code as integer
     2730     field pck-code as integer
     2731     field is-sel   as logical
     2732   index pi as primary unique
     2733     doc-type
     2734     doc-code
     2735   index sel
     2736     is-sel
     2737     pck-code
     2738   .
     2739   define buffer buf_tt-docs for tt-docs.
     2740   FUNCTION display-selected RETURNS CHARACTER
     2741     ( BUFFER loc_tt-docs FOR tt-docs )  FORWARD.
     2742   DEFINE BUTTON b-exit
     2743        LABEL "Выход"
     2744        SIZE 10 BY 1.
     2745   DEFINE BUTTON b-help
     2746        LABEL "Помо&щь"
     2747        SIZE 10 BY 1.
     2748   DEFINE BUTTON b-mark
     2749        LABEL "&*"
     2750        SIZE 3 BY 1.
     2751   DEFINE BUTTON b-start
     2752        LABEL "Выгрузить"
     2753        SIZE 10 BY 1.
     2754   DEFINE VARIABLE fi-doc-code AS CHARACTER FORMAT "X(256)":U
     2755        LABEL "Код документа"
     2756        VIEW-AS FILL-IN
     2757        SIZE 14 BY 1 NO-UNDO.
     2758   DEFINE VARIABLE fi-pck-code AS INTEGER FORMAT ">>>>>>>>>9":U INITIAL 0
     2759        LABEL "Код пакета"
     2760        VIEW-AS FILL-IN
     2761        SIZE 14 BY 1 NO-UNDO.
     2762   DEFINE RECTANGLE RECT-1
     2763        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     2764        SIZE 77.5 BY 11.5.
     2765   DEFINE QUERY br-docs FOR
     2766         buf_tt-docs SCROLLING.
     2767   DEFINE BROWSE br-docs
     2768     QUERY br-docs DISPLAY
     2769         display-selected(BUFFER buf_tt-docs) FORMAT "X(1)" COLUMN-LABEL "*"
     2770         buf_tt-docs.doc-type FORMAT "X(10)" COLUMN-LABEL "Тип документа"
     2771         buf_tt-docs.doc-code FORMAT "X(18)" COLUMN-LABEL "Код документа"
     2772         buf_tt-docs.pck-code FORMAT ">>>>>>>>>9" COLUMN-LABEL "Номер пакета"
     2773       WITH NO-ROW-MARKERS SEPARATORS SIZE 76 BY 9.75 FIT-LAST-COLUMN.
     2774   DEFINE FRAME Dialog-Frame
     2775        b-exit AT ROW 1 COL 1 WIDGET-ID 2
     2776        b-mark AT ROW 1 COL 11 WIDGET-ID 28
     2777        b-help AT ROW 1 COL 66 WIDGET-ID 30
     2778        fi-doc-code AT ROW 3 COL 15 COLON-ALIGNED WIDGET-ID 18
     2779        fi-pck-code AT ROW 3 COL 49.5 COLON-ALIGNED WIDGET-ID 20
     2780        br-docs AT ROW 4.5 COL 2 WIDGET-ID 200
     2781        b-start AT ROW 14.5 COL 67.5 WIDGET-ID 26
     2782        RECT-1 AT ROW 4.25 COL 1 WIDGET-ID 10
     2783        SPACE(0.24) SKIP(0.16)
     2784       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2785            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2786            TITLE "Выгрузить" WIDGET-ID 100.
     2787   ASSIGN
     2788          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2789          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2790   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2791   DO:
     2792     APPLY "END-ERROR":U TO SELF.
     2793   END.
     2794   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     2795   DO:
     2796     apply "go":U to frame Dialog-Frame.
     2797   END.
     2798   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     2799   DO:
     2800     run proc-b-mark in this-procedure no-error .
     2801     if error-status :error = yes
     2802     then do:
     2803       message
     2804         "":U
     2805         return-value skip
     2806         error-status :get-message(1) skip
     2807         error-status :get-message(2) skip
     2808       view-as alert-box error.
     2809       return no-apply.
     2810     end.
     2811   END.
     2812   ON CHOOSE OF b-start IN FRAME Dialog-Frame
     2813   DO:
     2814     run proc-b-start in this-procedure no-error .
     2815     if error-status :error = yes
     2816     then do:
     2817       message
     2818         "":U
     2819         return-value skip
     2820         error-status :get-message(1) skip
     2821         error-status :get-message(2) skip
     2822       view-as alert-box error.
     2823       return no-apply.
     2824     end.
     2825   END.
     2826   ON LEAVE OF fi-doc-code IN FRAME Dialog-Frame
     2827   DO:
     2828   END.
     2829   ON RETURN OF fi-doc-code IN FRAME Dialog-Frame
     2830   DO:
     2831     run proc-doc-code in this-procedure no-error .
     2832     if error-status :error = yes
     2833     then do:
     2834       message
     2835         "":U
     2836         return-value skip
     2837         error-status :get-message(1) skip
     2838         error-status :get-message(2) skip
     2839       view-as alert-box error.
     2840       return no-apply.
     2841     end.
     2842   END.
     2843   ON LEAVE OF fi-pck-code IN FRAME Dialog-Frame
     2844   DO:
     2845   END.
     2846   ON RETURN OF fi-pck-code IN FRAME Dialog-Frame
     2847   DO:
     2848     run proc-pck-code in this-procedure no-error .
     2849     if error-status :error = yes
     2850     then do:
     2851       message
     2852         "":U
     2853         return-value skip
     2854         error-status :get-message(1) skip
     2855         error-status :get-message(2) skip
     2856       view-as alert-box error.
     2857       return no-apply.
     2858     end.
     2859   END.
     2860   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2861   on help of frame Dialog-Frame
     2862   do:
     2863     run gbl/app_help.p
     2864       (input this-procedure :file-name
     2865       ,input ''
     2866       ,input ?
     2867       ) no-error.
     2868     if error-status :error then do:
     2869       message
     2870         "Ошибка при вызове помощи"
     2871         error-status :get-message(1)
     2872         view-as alert-box .
     2873     end.
     2874   end.
     2875   run minbtn-set in this-procedure .
     2876   on choose of b-help in frame Dialog-Frame
     2877   do:
     2878     apply "help":u to frame Dialog-Frame .
     2879   end.
     2880   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2881   procedure minbtn-set :
     2882       do
     2883           on error undo, return error return-value
     2884           :
     2885           define variable ii              as integer       no-undo .
     2886           define variable fh              as widget-handle no-undo .
     2887           define variable hh              as widget-handle no-undo .
     2888           define variable v-h             as handle        extent 4 no-undo .
     2889           define variable v-name-button   as character     no-undo .
     2890           define variable v-help-old-x    as decimal       no-undo .
     2891           define variable v-help-old-y    as decimal       no-undo .
     2892           define variable v-help-old-size as decimal       no-undo .
     2893           define variable v-frame-width   as decimal       no-undo .
     2894           define variable jj              as integer       no-undo .
     2895           do
     2896               on error undo, return error
     2897               :
     2898               assign
     2899                   v-frame-width = frame Dialog-Frame:width - 0.3
     2900                   fh            = frame Dialog-Frame:first-child
     2901                   hh            = fh:first-child
     2902                   ii            = 1
     2903                   .
     2904               do while valid-handle(hh):
     2905                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2906                   do:
     2907                       case lc(hh:name) :
     2908                           when "b-help" then
     2909                               do:
     2910                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2911                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2912                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2913                                   hh:TOOLTIP = "Помощь" .
     2914                                   v-help-old-x = hh:column .
     2915                                   v-help-old-y = hh:row    .
     2916                                   v-help-old-size = hh:width .
     2917                                   hh:width-chars = 2.5 .
     2918                               end.
     2919                           when "b-print" then
     2920                               do:
     2921                                   hh:load-image("cmp/b-print.bmp":u) .
     2922                                   hh:TOOLTIP = "Печать" .
     2923                                   v-h[ii] = hh:handle .
     2924                                   ii = ii + 1 .
     2925                                   hh:width-chars = 3 .
     2926                               end.
     2927                           when "b-history" or
     2928                           when "b-hist" then
     2929                               do:
     2930                                   hh:load-image("cmp/b-hist.bmp":u) .
     2931                                   hh:TOOLTIP = "История" .
     2932                                   v-h[ii] = hh:handle .
     2933                                   ii = ii + 1 .
     2934                                   hh:width-chars = 3 .
     2935                               end.
     2936                           when "b-sch" then
     2937                               do:
     2938                                   hh:load-image("cmp/b-sch.bmp":u) .
     2939                                   hh:TOOLTIP = "Установка Фильтра" .
     2940                                   v-h[ii] = hh:handle .
     2941                                   ii = ii + 1 .
     2942                                   hh:width-chars = 3 .
     2943                               end.
     2944                           when "b-hist-user" then
     2945                               do:
     2946                                   hh:load-image("cmp/b-hist.bmp":u) .
     2947                                   hh:TOOLTIP = "История пользователя" .
     2948                                   ii = ii + 1 .
     2949                               end.
     2950                       end case.
     2951                   end.
     2952                   hh = hh:next-sibling.
     2953               end.
     2954               b-help:column = v-frame-width - b-help:width-chars.
     2955               jj = 0.
     2956               repeat ii = 4 to 1 by -1 :
     2957                   if valid-handle (v-h[ii] ) then
     2958                   do:
     2959                       jj  = jj + 1 .
     2960                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2961                       v-h[ii]:row    = v-help-old-y .
     2962                   end.
     2963               end.
     2964           end.
     2965       end.
     2966   end procedure.
     2967   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2968   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2969   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2970   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2971   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2972   define variable v-diasize-current-frame-height as decimal   no-undo .
     2973   define variable v-diasize-change-size          as logical   no-undo .
     2974   define variable v-diasize-resize-button        as handle    no-undo .
     2975   define variable v-diasize-wndmax               as logical   no-undo .
     2976   define variable v-diasize-wndstore             as logical   no-undo .
     2977   define variable v-diasize-proc-name            as character no-undo .
     2978   define variable v-diasize-browse-handle        as handle    no-undo .
     2979   define variable v-diasize-browse-number        as integer   no-undo .
     2980   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2981   define temp-table temp-diasize-handle no-undo
     2982     field handle-value  as handle
     2983     field save-position as decimal
     2984     index xpk is primary unique handle-value
     2985     .
     2986   define temp-table temp-browse-handle no-undo
     2987     field browse-type   as character
     2988     field browse-number as integer
     2989     field browse-handle as handle
     2990     field original-size as decimal
     2991     index xpk is primary unique browse-type browse-number
     2992     index xie browse-type browse-handle
     2993   .
     2994   procedure diasize_change-height :
     2995     define input  parameter p-change-value  as decimal   no-undo .
     2996     define input  parameter p-move-resize   as logical   no-undo .
     2997     define variable v-field-group-handle    as handle    no-undo .
     2998     define variable v-object-handle         as handle    no-undo .
     2999     define variable v-frame-height          as decimal   no-undo .
     3000     define variable v-frame-virtual-height  as decimal   no-undo .
     3001     define variable v-browse-height         as decimal   no-undo .
     3002     define variable v-window-height         as decimal   no-undo .
     3003     define variable v-window-virtual-height as decimal   no-undo .
     3004     define variable v-change-sign           as integer   no-undo .
     3005     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3006     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3007     if p-change-value > 0
     3008     then do:
     3009       if frame Dialog-Frame :height + p-change-value
     3010           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3011       then do:
     3012         assign
     3013           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3014                           - (frame Dialog-Frame :height-chars)
     3015         .
     3016         if p-change-value <= 0
     3017         then do:
     3018           run diasize_position-resize-button in this-procedure .
     3019           return .
     3020         end.
     3021       end.
     3022     end.
     3023     if p-change-value < 0
     3024     then do:
     3025       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3026       then do:
     3027         assign
     3028           p-change-value = v-diasize-orig-frame-height
     3029                          - (frame Dialog-Frame :height-chars)
     3030         .
     3031         if p-change-value >= 0
     3032         then do:
     3033           run diasize_position-resize-button in this-procedure .
     3034           return .
     3035         end.
     3036       end.
     3037     end.
     3038     if p-change-value >= 0
     3039     then do:
     3040       assign
     3041         v-change-sign = 1
     3042       .
     3043     end.
     3044     else do:
     3045       assign
     3046         v-change-sign = -1
     3047       .
     3048     end.
     3049     assign
     3050       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3051     .
     3052     if p-change-value = 0
     3053     then do:
     3054       run diasize_position-resize-button in this-procedure .
     3055       return .
     3056     end.
     3057     move_block:
     3058     do
     3059     on error undo move_block, retry move_block
     3060     :
     3061       if retry
     3062       then do:
     3063         do
     3064         on error undo move_block, leave move_block
     3065         :
     3066           if p-change-value > 0
     3067           then do:
     3068             for each buf_temp-diasize-handle
     3069             on error undo, next
     3070             :
     3071               assign
     3072                 v-object-handle = buf_temp-diasize-handle.handle-value
     3073               .
     3074               if v-object-handle <> v-diasize-resize-button
     3075               then do:
     3076                 assign
     3077                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3078                 .
     3079               end.
     3080             end.
     3081             assign
     3082               v-diasize-browse-handle :height = v-browse-height
     3083             .
     3084             for each buf_temp-browse-handle
     3085               where buf_temp-browse-handle.browse-type = 'height':u
     3086             on error undo, next
     3087             :
     3088               assign
     3089                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3090               .
     3091             end.
     3092             assign
     3093               frame Dialog-Frame :height = v-frame-height
     3094             .
     3095             if frame Dialog-Frame :scrollable = true
     3096             then do:
     3097               assign
     3098                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3099               .
     3100             end.
     3101             run diasize_position-resize-button in this-procedure .
     3102           end.
     3103           else do:
     3104             if frame Dialog-Frame :scrollable = true
     3105             then do:
     3106               assign
     3107                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3108               .
     3109             end.
     3110             assign
     3111               frame Dialog-Frame :height = v-frame-height
     3112             .
     3113             assign
     3114               v-diasize-browse-handle :height = v-browse-height
     3115             .
     3116             for each buf_temp-browse-handle
     3117               where buf_temp-browse-handle.browse-type = 'height':u
     3118             on error undo, next
     3119             :
     3120               assign
     3121                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3122               .
     3123             end.
     3124             for each buf_temp-diasize-handle
     3125             on error undo, next
     3126             :
     3127               assign
     3128                 v-object-handle = buf_temp-diasize-handle.handle-value
     3129               .
     3130               if v-object-handle <> v-diasize-resize-button
     3131               then do:
     3132                 assign
     3133                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3134                 .
     3135               end.
     3136             end.
     3137             run diasize_position-resize-button in this-procedure .
     3138           end.
     3139           assign
     3140             v-diasize-change-size = false
     3141           .
     3142           leave move_block .
     3143         end.
     3144       end.
     3145       assign
     3146         v-diasize-need-full-display = true
     3147       .
     3148       if v-diasize-change-size = false
     3149       then do:
     3150         assign
     3151           v-diasize-change-size = true
     3152         .
     3153       end.
     3154       else do:
     3155         return .
     3156       end.
     3157       assign
     3158         v-frame-height = frame Dialog-Frame :height
     3159         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3160         v-browse-height = v-diasize-browse-handle :height
     3161       .
     3162       for each buf_temp-browse-handle
     3163         where buf_temp-browse-handle.browse-type = 'height':u
     3164       :
     3165         assign
     3166           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3167         .
     3168       end.
     3169       for each buf_temp-diasize-handle
     3170       :
     3171         delete buf_temp-diasize-handle .
     3172       end.
     3173       assign
     3174         v-field-group-handle = frame Dialog-Frame :first-child
     3175       .
     3176       do while valid-handle(v-field-group-handle)
     3177       :
     3178         assign
     3179           v-object-handle = v-field-group-handle :first-child
     3180         .
     3181         do while valid-handle(v-object-handle)
     3182         :
     3183           if  v-object-handle <> v-diasize-browse-handle :handle
     3184           and can-query(v-object-handle, "row")
     3185           and can-query(v-object-handle, "height")
     3186           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3187           then do:
     3188             find first buf_temp-browse-handle
     3189               where buf_temp-browse-handle.browse-type   = 'height':u
     3190                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3191               no-error .
     3192             if available buf_temp-browse-handle
     3193             then do:
     3194             end.
     3195             else do:
     3196               create buf_temp-diasize-handle .
     3197               assign
     3198                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3199                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3200               .
     3201             end.
     3202           end.
     3203           assign
     3204             v-object-handle = v-object-handle :next-sibling
     3205           .
     3206         end.
     3207         assign
     3208           v-field-group-handle = v-field-group-handle :next-sibling
     3209         .
     3210       end.
     3211       do with frame Dialog-Frame
     3212       :
     3213         hide v-diasize-resize-button .
     3214         assign
     3215           v-diasize-resize-button :row    = 1
     3216           v-diasize-resize-button :column = 1
     3217         .
     3218       end.
     3219       if p-change-value > 0
     3220       then do:
     3221         if frame Dialog-Frame :scrollable = true
     3222         then do:
     3223           assign
     3224             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3225             no-error .
     3226           if error-status :error
     3227           or error-status :get-message(1) <> ""
     3228           then do:
     3229             undo move_block, retry move_block .
     3230           end.
     3231         end.
     3232         assign
     3233           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3234           no-error .
     3235         if error-status :error
     3236         or error-status :get-message(1) <> ""
     3237         then do:
     3238           undo move_block, retry move_block .
     3239         end.
     3240         assign
     3241           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3242           no-error .
     3243         if error-status :error
     3244         or error-status :get-message(1) <> ""
     3245         then do:
     3246           undo move_block, retry move_block .
     3247         end.
     3248         for each buf_temp-browse-handle
     3249           where buf_temp-browse-handle.browse-type = 'height':u
     3250         on error undo move_block, retry move_block
     3251         :
     3252           assign
     3253             buf_temp-browse-handle.browse-handle :height
     3254               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3255             no-error .
     3256           if error-status :error
     3257           or error-status :get-message(1) <> ""
     3258           then do:
     3259             undo move_block, retry move_block .
     3260           end.
     3261         end.
     3262         for each buf_temp-diasize-handle
     3263         on error undo move_block, retry move_block
     3264         :
     3265           assign
     3266             v-object-handle = buf_temp-diasize-handle.handle-value
     3267           .
     3268           if v-object-handle <> v-diasize-resize-button
     3269           then do:
     3270             assign
     3271               v-object-handle :row = v-object-handle :row + p-change-value
     3272               no-error .
     3273             if error-status :error
     3274             or error-status :get-message(1) <> ""
     3275             then do:
     3276               undo move_block, retry move_block .
     3277             end.
     3278           end.
     3279         end.
     3280       end.
     3281       else do:
     3282         for each buf_temp-diasize-handle
     3283         on error undo move_block, retry move_block
     3284         :
     3285           assign
     3286             v-object-handle = buf_temp-diasize-handle.handle-value
     3287           .
     3288           if v-object-handle <> v-diasize-resize-button
     3289           then do:
     3290             assign
     3291               v-object-handle :row = v-object-handle :row + p-change-value
     3292               no-error .
     3293             if error-status :error
     3294             or error-status :get-message(1) <> ""
     3295             then do:
     3296               undo move_block, retry move_block .
     3297             end.
     3298           end.
     3299         end.
     3300         assign
     3301           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3302           no-error .
     3303         if error-status :error
     3304         or error-status :get-message(1) <> ""
     3305         then do:
     3306           undo move_block, retry move_block .
     3307         end.
     3308         for each buf_temp-browse-handle
     3309           where buf_temp-browse-handle.browse-type = 'height':u
     3310         on error undo move_block, retry move_block
     3311         :
     3312           assign
     3313             buf_temp-browse-handle.browse-handle :height
     3314               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3315             no-error .
     3316           if error-status :error
     3317           or error-status :get-message(1) <> ""
     3318           then do:
     3319             undo move_block, retry move_block .
     3320           end.
     3321         end.
     3322         assign
     3323           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3324           no-error .
     3325         if error-status :error
     3326         or error-status :get-message(1) <> ""
     3327         then do:
     3328           undo move_block, retry move_block .
     3329         end.
     3330         if frame Dialog-Frame :scrollable = true
     3331         then do:
     3332           assign
     3333             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3334             no-error .
     3335           if error-status :error
     3336           or error-status :get-message(1) <> ""
     3337           then do:
     3338             undo move_block, retry move_block .
     3339           end.
     3340         end.
     3341       end.
     3342       if p-move-resize = true
     3343       then do:
     3344         run diasize_position-resize-button in this-procedure .
     3345       end.
     3346       if v-diasize-wndstore = true
     3347       then do:
     3348         if connected("ub") = true
     3349         then do:
     3350           define variable v-cntxt-db-num        as integer   no-undo .
     3351           define variable v-cntxt-userid        as character no-undo .
     3352           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3353                                             , OUTPUT v-cntxt-userid
     3354                                             ) .
     3355           run gbl/wndsizew.p
     3356             (input  v-cntxt-db-num
     3357             ,input  v-cntxt-userid
     3358             ,input  v-diasize-proc-name
     3359             ,input  'height':u
     3360             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3361             ) .
     3362         end.
     3363       end.
     3364     end.
     3365     assign
     3366       v-diasize-change-size = false
     3367     .
     3368   end procedure.
     3369   procedure diasize_set-height :
     3370     define input  parameter p-new-height  as decimal   no-undo .
     3371     define input  parameter p-move-resize as logical   no-undo .
     3372     do
     3373     on error undo, return error return-value
     3374     :
     3375       run diasize_change-height in this-procedure
     3376         (input  (p-new-height - frame Dialog-Frame :height)
     3377         ,input  p-move-resize
     3378         ) .
     3379     end.
     3380   end procedure.
     3381   procedure diasize_change-width :
     3382     define input  parameter p-change-value as decimal   no-undo .
     3383     define input  parameter p-move-resize  as logical   no-undo .
     3384     define variable v-field-group-handle   as handle    no-undo .
     3385     define variable v-object-handle        as handle    no-undo .
     3386     define variable v-frame-width          as decimal   no-undo .
     3387     define variable v-frame-virtual-width  as decimal   no-undo .
     3388     define variable v-browse-width         as decimal   no-undo .
     3389     define variable v-window-width         as decimal   no-undo .
     3390     define variable v-window-virtual-width as decimal   no-undo .
     3391     define variable v-change-sign          as integer   no-undo .
     3392     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3393     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3394     if p-change-value > 0
     3395     then do:
     3396       if frame Dialog-Frame :width + p-change-value >
     3397           session :width-chars
     3398       then do:
     3399         assign
     3400           p-change-value = session :width-chars - frame Dialog-Frame :width
     3401         .
     3402         if p-change-value <= 0
     3403         then do:
     3404           run diasize_position-resize-button in this-procedure .
     3405           return .
     3406         end.
     3407       end.
     3408     end.
     3409     if p-change-value < 0
     3410     then do:
     3411       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3412       then do:
     3413         assign
     3414           p-change-value = v-diasize-orig-frame-width
     3415                          - frame Dialog-Frame :width
     3416         .
     3417         if p-change-value >= 0
     3418         then do:
     3419           run diasize_position-resize-button in this-procedure .
     3420           return .
     3421         end.
     3422       end.
     3423     end.
     3424     if p-change-value >= 0
     3425     then do:
     3426       assign
     3427         v-change-sign = 1
     3428       .
     3429     end.
     3430     else do:
     3431       assign
     3432         v-change-sign = -1
     3433       .
     3434     end.
     3435     assign
     3436       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3437     .
     3438     if p-change-value = 0
     3439     then do:
     3440       run diasize_position-resize-button in this-procedure .
     3441       return .
     3442     end.
     3443     move_block:
     3444     do
     3445     on error undo move_block, leave move_block
     3446     :
     3447       if retry
     3448       then do:
     3449         do
     3450         on error undo move_block, leave move_block
     3451         :
     3452           if p-change-value > 0
     3453           then do:
     3454             for each buf_temp-diasize-handle
     3455             on error undo, next
     3456             :
     3457               assign
     3458                 v-object-handle = buf_temp-diasize-handle.handle-value
     3459               .
     3460               if v-object-handle <> v-diasize-resize-button
     3461               then do:
     3462                 assign
     3463                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3464                 .
     3465               end.
     3466             end.
     3467             assign
     3468               v-diasize-browse-handle :width = v-browse-width
     3469             .
     3470             for each buf_temp-browse-handle
     3471               where buf_temp-browse-handle.browse-type = 'width':u
     3472             on error undo, next
     3473             :
     3474               assign
     3475                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3476               .
     3477             end.
     3478             assign
     3479               frame Dialog-Frame :width = v-frame-width
     3480             .
     3481             if frame Dialog-Frame :scrollable = true
     3482             then do:
     3483               assign
     3484                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3485               .
     3486             end.
     3487             run diasize_position-resize-button in this-procedure .
     3488           end.
     3489           else do:
     3490             if frame Dialog-Frame :scrollable = true
     3491             then do:
     3492               assign
     3493                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3494               .
     3495             end.
     3496             assign
     3497               frame Dialog-Frame :width = v-frame-width
     3498             .
     3499             for each buf_temp-browse-handle
     3500               where buf_temp-browse-handle.browse-type = 'width':u
     3501             on error undo, next
     3502             :
     3503               assign
     3504                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3505               .
     3506             end.
     3507             assign
     3508               v-diasize-browse-handle :width = v-browse-width
     3509             .
     3510             for each buf_temp-diasize-handle
     3511             on error undo, next
     3512             :
     3513               assign
     3514                 v-object-handle = buf_temp-diasize-handle.handle-value
     3515               .
     3516               if v-object-handle <> v-diasize-resize-button
     3517               then do:
     3518                 assign
     3519                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3520                 .
     3521               end.
     3522             end.
     3523             run diasize_position-resize-button in this-procedure .
     3524           end.
     3525           assign
     3526             v-diasize-change-size = false
     3527           .
     3528           leave move_block .
     3529         end.
     3530       end.
     3531       assign
     3532         v-diasize-need-full-display = true
     3533       .
     3534       if v-diasize-change-size = false
     3535       then do:
     3536         assign
     3537           v-diasize-change-size = true
     3538         .
     3539       end.
     3540       else do:
     3541         return .
     3542       end.
     3543       assign
     3544         v-frame-width = frame Dialog-Frame :width
     3545         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3546         v-browse-width = v-diasize-browse-handle :width
     3547       .
     3548       for each buf_temp-browse-handle
     3549         where buf_temp-browse-handle.browse-type = 'width':u
     3550       :
     3551         assign
     3552           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3553         .
     3554       end.
     3555       for each buf_temp-diasize-handle
     3556       :
     3557         delete buf_temp-diasize-handle .
     3558       end.
     3559       assign
     3560         v-field-group-handle = frame Dialog-Frame :first-child
     3561       .
     3562       do while valid-handle(v-field-group-handle)
     3563       :
     3564         assign
     3565           v-object-handle = v-field-group-handle :first-child
     3566         .
     3567         do while valid-handle(v-object-handle)
     3568         :
     3569           if  v-object-handle <> v-diasize-browse-handle :handle
     3570           and v-object-handle <> v-diasize-resize-button
     3571           and can-query(v-object-handle, "row")
     3572           and can-query(v-object-handle, "height")
     3573           and ( v-object-handle :col + v-object-handle :width
     3574                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3575               )
     3576           then do:
     3577             find first buf_temp-browse-handle
     3578               where buf_temp-browse-handle.browse-type   = 'width':u
     3579                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3580               no-error .
     3581             if available buf_temp-browse-handle
     3582             then do:
     3583             end.
     3584             else do:
     3585               create buf_temp-diasize-handle .
     3586               assign
     3587                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3588                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3589               .
     3590             end.
     3591           end.
     3592           assign
     3593             v-object-handle = v-object-handle :next-sibling
     3594           .
     3595         end.
     3596         assign
     3597           v-field-group-handle = v-field-group-handle :next-sibling
     3598         .
     3599       end.
     3600       do with frame Dialog-Frame
     3601       :
     3602         hide v-diasize-resize-button .
     3603         v-diasize-resize-button :row = 1.
     3604         v-diasize-resize-button :column = 1.
     3605       end.
     3606       if p-change-value > 0
     3607       then do:
     3608         if frame Dialog-Frame :scrollable = true
     3609         then do:
     3610           assign
     3611             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3612             no-error .
     3613           if error-status :error
     3614           or error-status :get-message(1) <> ""
     3615           then do:
     3616             undo move_block, retry move_block.
     3617           end.
     3618         end.
     3619         assign
     3620           frame Dialog-Frame :width = v-frame-width + p-change-value
     3621           no-error .
     3622         if error-status :error
     3623         or error-status :get-message(1) <> ""
     3624         then do:
     3625           undo move_block, retry move_block.
     3626         end.
     3627         assign
     3628           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3629         no-error .
     3630         if error-status :error
     3631         or error-status :get-message(1) <> ""
     3632         then do:
     3633           undo move_block, retry move_block.
     3634         end.
     3635         for each buf_temp-browse-handle
     3636           where buf_temp-browse-handle.browse-type = 'width':u
     3637         on error undo move_block, retry move_block
     3638         :
     3639           assign
     3640             buf_temp-browse-handle.browse-handle :width
     3641               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3642             no-error .
     3643           if error-status :error
     3644           or error-status :get-message(1) <> ""
     3645           then do:
     3646             undo move_block, retry move_block .
     3647           end.
     3648         end.
     3649         for each buf_temp-diasize-handle
     3650         on error undo move_block, retry move_block
     3651         :
     3652           assign
     3653             v-object-handle = buf_temp-diasize-handle.handle-value
     3654           .
     3655           if v-object-handle <> v-diasize-resize-button
     3656           then do:
     3657             assign
     3658               v-object-handle :col = v-object-handle :col + p-change-value
     3659               no-error .
     3660             if error-status :error
     3661             or error-status :get-message(1) <> ""
     3662             then do:
     3663               undo move_block, retry move_block .
     3664             end.
     3665           end.
     3666         end.
     3667       end.
     3668       else do:
     3669         for each buf_temp-diasize-handle
     3670         on error undo move_block, retry move_block
     3671         :
     3672           assign
     3673             v-object-handle = buf_temp-diasize-handle.handle-value
     3674           .
     3675           if v-object-handle <> v-diasize-resize-button
     3676           then do:
     3677             assign
     3678               v-object-handle :col = v-object-handle :col + p-change-value
     3679               no-error .
     3680             if error-status :error
     3681             or error-status :get-message(1) <> ""
     3682             then do:
     3683               undo move_block, retry move_block .
     3684             end.
     3685           end.
     3686         end.
     3687         for each buf_temp-browse-handle
     3688           where buf_temp-browse-handle.browse-type = 'width':u
     3689         on error undo move_block, retry move_block
     3690         :
     3691           assign
     3692             buf_temp-browse-handle.browse-handle :width
     3693               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3694             no-error .
     3695           if error-status :error
     3696           or error-status :get-message(1) <> ""
     3697           then do:
     3698             undo move_block, retry move_block .
     3699           end.
     3700         end.
     3701         assign
     3702           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3703           no-error .
     3704         if error-status :error
     3705         or error-status :get-message(1) <> ""
     3706         then do:
     3707           undo move_block, retry move_block.
     3708         end.
     3709         assign
     3710           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3711         no-error .
     3712         if error-status :error
     3713         or error-status :get-message(1) <> ""
     3714         then do:
     3715           undo move_block, retry move_block.
     3716         end.
     3717         if frame Dialog-Frame :scrollable = true
     3718         then do:
     3719           assign
     3720             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3721           no-error .
     3722           if error-status :error
     3723           or error-status :get-message(1) <> ""
     3724           then do:
     3725             undo move_block, retry move_block.
     3726           end.
     3727         end.
     3728       end.
     3729       if p-move-resize
     3730       then do:
     3731         run diasize_position-resize-button in this-procedure .
     3732       end.
     3733       if v-diasize-wndstore = true
     3734       then do:
     3735         if connected("ub") = true
     3736         then do:
     3737           define variable v-cntxt-db-num        as integer   no-undo .
     3738           define variable v-cntxt-userid        as character no-undo .
     3739           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3740                                             , OUTPUT v-cntxt-userid
     3741                                             ) .
     3742           run gbl/wndsizew.p
     3743             (input  v-cntxt-db-num
     3744             ,input  v-cntxt-userid
     3745             ,input  v-diasize-proc-name
     3746             ,input  'width':u
     3747             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3748             ) .
     3749         end.
     3750       end.
     3751     end.
     3752     assign
     3753       v-diasize-change-size = false
     3754     .
     3755   end procedure.
     3756   procedure diasize_set-width :
     3757     define input  parameter p-new-width  as decimal   no-undo .
     3758     define input  parameter p-move-resize as logical   no-undo .
     3759     do
     3760     on error undo, return error return-value
     3761     :
     3762       run diasize_change-width in this-procedure
     3763         (input  (p-new-width - frame Dialog-Frame :width)
     3764         ,input  p-move-resize
     3765         ) .
     3766     end.
     3767   end procedure.
     3768   procedure diasize_position-resize-button :
     3769     do with frame Dialog-Frame
     3770     :
     3771       hide v-diasize-resize-button .
     3772       assign
     3773         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3774                     - 1
     3775                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3776         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3777                     - 1
     3778                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3779       .
     3780       view v-diasize-resize-button .
     3781     end.
     3782   end procedure.
     3783   on alt-right anywhere
     3784   do:
     3785     run diasize_change-width in this-procedure
     3786       (input 1
     3787       ,input true
     3788       ) .
     3789     return no-apply .
     3790   end.
     3791   on alt-left anywhere
     3792   do:
     3793     run diasize_change-width in this-procedure
     3794       (input -1
     3795       ,input true
     3796       ) .
     3797     return no-apply .
     3798   end.
     3799   on alt-down anywhere
     3800   do:
     3801     run diasize_change-height in this-procedure
     3802       (input 1
     3803       ,input true
     3804       ) .
     3805     return no-apply .
     3806   end.
     3807   on alt-up anywhere
     3808   do:
     3809     run diasize_change-height in this-procedure
     3810       (input -1
     3811       ,input true
     3812       ) .
     3813     return no-apply .
     3814   end.
     3815   on alt-enter of frame Dialog-Frame
     3816   do:
     3817     run diasize_maximize in this-procedure
     3818       (input  ?
     3819       ).
     3820     return no-apply .
     3821   end.
     3822   procedure diasize_end-move :
     3823     do
     3824     on error undo, return error return-value
     3825     :
     3826       define variable v-row-delta as decimal   no-undo .
     3827       define variable v-col-delta as decimal   no-undo .
     3828       define variable v-new-row as decimal   no-undo .
     3829       define variable v-new-col as decimal   no-undo .
     3830       assign
     3831         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3832         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3833       .
     3834       assign
     3835         v-row-delta = v-new-row - frame Dialog-Frame :height
     3836         v-col-delta = v-new-col - frame Dialog-Frame :width
     3837       .
     3838       run diasize_change-height in this-procedure
     3839         (input v-row-delta
     3840         ,input true
     3841         ) .
     3842       run diasize_change-width in this-procedure
     3843         (input v-col-delta
     3844         ,input true
     3845         ) .
     3846     end.
     3847   end procedure.
     3848   procedure diasize_maximize :
     3849     define input  parameter p-action as logical   no-undo .
     3850     do
     3851     on error undo, return error return-value
     3852     :
     3853       if p-action = ?
     3854       then do:
     3855         if v-diasize-need-maximize = true
     3856         then do:
     3857           assign
     3858             p-action = true
     3859           .
     3860         end.
     3861         else do:
     3862           assign
     3863             p-action = false
     3864           .
     3865         end.
     3866       end.
     3867       if p-action = true
     3868       then do:
     3869         run diasize_change-height in this-procedure
     3870           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3871               - frame Dialog-Frame :height-chars
     3872           ,input true
     3873           ) .
     3874         run diasize_change-width in this-procedure
     3875           (input session :width-chars
     3876               - frame Dialog-Frame :width-chars
     3877           ,input true
     3878           ) .
     3879         assign
     3880           v-diasize-need-maximize = false
     3881         .
     3882       end.
     3883       else do:
     3884         run diasize_change-width in this-procedure
     3885           (input v-diasize-orig-frame-width
     3886               - frame Dialog-Frame :width-chars
     3887           ,input true
     3888           ) .
     3889         run diasize_change-height in this-procedure
     3890           (input v-diasize-orig-frame-height
     3891               - frame Dialog-Frame :height-chars
     3892           ,input true
     3893           ) .
     3894         assign
     3895           v-diasize-need-maximize = true
     3896         .
     3897       end.
     3898     end.
     3899   end procedure.
     3900   procedure diasize_restore-orig-size :
     3901     do
     3902     on error undo, return error return-value
     3903     :
     3904       assign
     3905         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3906         v-diasize-current-frame-height = frame Dialog-Frame :height
     3907       .
     3908       run diasize_set-height in this-procedure
     3909         (input  v-diasize-orig-frame-height
     3910         ,input  true
     3911         ) .
     3912       run diasize_set-width in this-procedure
     3913         (input  v-diasize-orig-frame-width
     3914         ,input  true
     3915         ) .
     3916     end.
     3917   end procedure.
     3918   procedure diasize_restore-current-size :
     3919     do
     3920     on error undo, return error return-value
     3921     :
     3922       run diasize_set-height in this-procedure
     3923         (input  v-diasize-current-frame-height
     3924         ,input  true
     3925         ) .
     3926       run diasize_set-width in this-procedure
     3927         (input  v-diasize-current-frame-width
     3928         ,input  true
     3929         ) .
     3930     end.
     3931   end procedure.
     3932   procedure diasize_set-browse-handle :
     3933     define input  parameter p-browse-handle as handle   no-undo .
     3934     define buffer buf_temp-browse-handle for temp-browse-handle .
     3935     do
     3936     on error undo, return error return-value
     3937     :
     3938       assign
     3939         v-diasize-browse-handle = p-browse-handle
     3940       .
     3941       for each buf_temp-browse-handle
     3942       on error undo, return error return-value
     3943       :
     3944         delete buf_temp-browse-handle .
     3945       end.
     3946     end.
     3947   end procedure.
     3948   procedure diasize_add_browse :
     3949     define input  parameter p-browse-type   as character no-undo .
     3950     define input  parameter p-browse-handle as handle    no-undo .
     3951     define buffer buf_temp-browse-handle for temp-browse-handle .
     3952     do
     3953     on error undo, return error return-value
     3954     :
     3955       assign
     3956         v-diasize-browse-number = v-diasize-browse-number + 1
     3957       .
     3958       create buf_temp-browse-handle .
     3959       assign
     3960         buf_temp-browse-handle.browse-type   = p-browse-type
     3961         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3962         buf_temp-browse-handle.browse-handle = p-browse-handle
     3963       .
     3964     end.
     3965   end procedure.
     3966   procedure diasize_init :
     3967     define variable v-default-value    as logical   no-undo .
     3968     define variable v-restore-saved    as logical   no-undo .
     3969     define variable v-resize-value-str as character no-undo .
     3970     do
     3971     on error undo, return error return-value
     3972     :
     3973       do with frame Dialog-Frame
     3974       :
     3975         assign
     3976           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3977           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3978           v-diasize-browse-handle     = browse br-docs :handle
     3979         .
     3980         create button v-diasize-resize-button
     3981         assign
     3982           parent        = frame Dialog-Frame :first-child
     3983           label         = "s"
     3984           height-pixels = 16
     3985           width-pixels  = 16
     3986           visible       = true
     3987           sensitive     = true
     3988           movable       = true
     3989           triggers:
     3990             on end-move persistent run diasize_end-move in this-procedure .
     3991           end triggers.
     3992         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3993         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3994         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3995         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3996         assign
     3997           v-diasize-wndmax = false
     3998         .
     3999         if connected("ub") = true
     4000         then do:
     4001           define variable v-cntxt-db-num        as integer   no-undo .
     4002           define variable v-cntxt-userid        as character no-undo .
     4003           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4004                                             , OUTPUT v-cntxt-userid
     4005                                             ) .
     4006           run gbl/wndpar_r.p
     4007             (input  v-cntxt-db-num
     4008             ,input  v-cntxt-userid
     4009             ,input  'wndmax':U
     4010             ,output v-diasize-wndmax
     4011             ,output v-default-value
     4012             ) .
     4013         end.
     4014         assign
     4015           v-diasize-wndstore = false
     4016         .
     4017         if connected("ub") = true
     4018         then do:
     4019           run gbl/wndpar_r.p
     4020             (input  v-cntxt-db-num
     4021             ,input  v-cntxt-userid
     4022             ,input  'wndstore':U
     4023             ,output v-diasize-wndstore
     4024             ,output v-default-value
     4025             ) .
     4026         end.
     4027         assign
     4028           v-diasize-proc-name = entry(1, program-name(2), '.')
     4029         .
     4030         if v-diasize-wndstore = true
     4031         then do:
     4032           assign
     4033             v-restore-saved = false
     4034           .
     4035           if connected("ub") = true
     4036           then do:
     4037             run gbl/wndsizer.p
     4038               (input  v-cntxt-db-num
     4039               ,input  v-cntxt-userid
     4040               ,input  v-diasize-proc-name
     4041               ,input  'height':u
     4042               ,output v-resize-value-str
     4043               ) .
     4044             if v-resize-value-str <> '':U
     4045             then do:
     4046               run diasize_change-height in this-procedure
     4047                 (input  integer(v-resize-value-str)
     4048                 ,input  true
     4049                 ) .
     4050               assign
     4051                 v-restore-saved = true
     4052               .
     4053             end.
     4054           end.
     4055           if connected("ub") = true
     4056           then do:
     4057             run gbl/wndsizer.p
     4058               (input  v-cntxt-db-num
     4059               ,input  v-cntxt-userid
     4060               ,input  v-diasize-proc-name
     4061               ,input  'width':u
     4062               ,output v-resize-value-str
     4063               ) .
     4064             if v-resize-value-str <> '':U
     4065             then do:
     4066               run diasize_change-width in this-procedure
     4067                 (input  integer(v-resize-value-str)
     4068                 ,input  true
     4069                 ) .
     4070               assign
     4071                 v-restore-saved = true
     4072               .
     4073             end.
     4074           end.
     4075           if v-restore-saved <> true
     4076           then do:
     4077             if v-diasize-wndmax = true
     4078             then do:
     4079               run diasize_maximize in this-procedure
     4080                 (input  true
     4081                 ) .
     4082             end.
     4083           end.
     4084         end.
     4085         else do:
     4086           if v-diasize-wndmax = true
     4087           then do:
     4088             run diasize_maximize in this-procedure
     4089               (input  true
     4090               ) .
     4091           end.
     4092         end.
     4093       end.
     4094     end.
     4095   end procedure.
     4096   procedure diasize_need-full-display :
     4097     define output parameter p-need-full-display as logical   no-undo .
     4098     do
     4099     on error undo, return error return-value
     4100     :
     4101       assign
     4102         p-need-full-display = v-diasize-need-full-display
     4103       .
     4104       assign
     4105         v-diasize-need-full-display = false
     4106       .
     4107     end.
     4108   end procedure.
     4109   procedure get-context :
     4110      define output parameter p-db-num as integer          no-undo.
     4111      define output parameter p-user-id as character        no-undo.
     4112      define variable v-login               as character    no-undo.
     4113      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4114      define buffer buf_user-login  for ub.user-login .
     4115      do
     4116      on error undo, return error
     4117      :
     4118            FIND FIRST buf_sys-ctrl no-lock.
     4119            ASSIGN
     4120               v-login = USERID("ub")
     4121               p-db-num = buf_sys-ctrl.db-num
     4122            .
     4123            FIND FIRST buf_user-login
     4124                 WHERE buf_user-login.db-num = p-db-num
     4125                   AND buf_user-login.user-login = v-login
     4126                 no-lock
     4127                 no-error
     4128                 .
     4129            IF AVAILABLE buf_user-login
     4130            THEN DO:
     4131               assign
     4132                  p-user-id = buf_user-login.user-id
     4133               .
     4134            END.
     4135      end.
     4136   end procedure.
     4137       run diasize_init in this-procedure .
     4138   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     4139   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     4140   MAIN-BLOCK:
     4141   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4142      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4143     assign
     4144       fi-doc-code = ?
     4145       fi-pck-code = ?
     4146     .
     4147     RUN enable_UI.
     4148     WAIT-FOR GO OF FRAME Dialog-Frame.
     4149   END.
     4150   RUN disable_UI.
     4151   PROCEDURE cb-fill_bge-xml_clients :
     4152   define input parameter p-obj-type   as character        no-undo.
     4153   define input parameter p-obj-code   as integer          no-undo.
     4154       define buffer buf_temp_bge-xml_clients      for temp_bge-xml_clients.
     4155   do
     4156   for buf_temp_bge-xml_clients
     4157   on error undo, return error
     4158   :
     4159       find first buf_temp_bge-xml_clients
     4160            where buf_temp_bge-xml_clients.obj-type = p-obj-type
     4161              and buf_temp_bge-xml_clients.obj-code = p-obj-code
     4162       no-error.
     4163       if not available buf_temp_bge-xml_clients
     4164       then do:
     4165           create buf_temp_bge-xml_clients.
     4166           assign
     4167               buf_temp_bge-xml_clients.obj-type = p-obj-type
     4168               buf_temp_bge-xml_clients.obj-code = p-obj-code
     4169           .
     4170       end.
     4171   end.
     4172   END PROCEDURE.
     4173   PROCEDURE cb-fill_bge-xml_dis-card :
     4174   define input parameter p-d-card as character        no-undo.
     4175       define buffer buf_temp_bge-xml_dis-card     for temp_bge-xml_dis-card.
     4176   do
     4177   for buf_temp_bge-xml_dis-card
     4178   on error undo, return error
     4179   :
     4180       find first buf_temp_bge-xml_dis-card
     4181            where buf_temp_bge-xml_dis-card.d-card = p-d-card
     4182       no-error.
     4183       if not available buf_temp_bge-xml_dis-card
     4184       then do:
     4185           create buf_temp_bge-xml_dis-card.
     4186           assign
     4187               buf_temp_bge-xml_dis-card.d-card = p-d-card
     4188           .
     4189       end.
     4190   end.
     4191   END PROCEDURE.
     4192   PROCEDURE cb-fill_bge-xml_goods :
     4193   define input parameter p-gds-code   as integer          no-undo.
     4194   do
     4195   on error undo, return error
     4196   :
     4197       find first temp_bge-xml_goods
     4198            where temp_bge-xml_goods.gds-code = p-gds-code
     4199       no-error.
     4200       if not available temp_bge-xml_goods
     4201       then do:
     4202           create temp_bge-xml_goods.
     4203           assign
     4204               temp_bge-xml_goods.gds-code = p-gds-code
     4205           .
     4206       end.
     4207   end.
     4208   END PROCEDURE.
     4209   PROCEDURE disable_UI :
     4210     HIDE FRAME Dialog-Frame.
     4211   END PROCEDURE.
     4212   PROCEDURE enable_UI :
     4213     DISPLAY fi-doc-code fi-pck-code
     4214         WITH FRAME Dialog-Frame.
     4215     ENABLE b-exit b-mark b-help RECT-1 fi-doc-code fi-pck-code br-docs b-start
     4216         WITH FRAME Dialog-Frame.
     4217     VIEW FRAME Dialog-Frame.
     4218     OPEN QUERY br-docs FOR EACH buf_tt-docs.
     4219   END PROCEDURE.
     4220   PROCEDURE fill-temp-del-doc-code :
     4221   do
     4222   on error undo, return error
     4223   :
     4224   define input parameter p-doc-code   as character    no-undo.
     4225       define buffer buf_temp_del-doc-code     for temp_del-doc-code.
     4226       create buf_temp_del-doc-code.
     4227       assign
     4228           buf_temp_del-doc-code.doc-code = p-doc-code
     4229       .
     4230   end.
     4231   END PROCEDURE.
     4232   PROCEDURE fill-temp-doc-code :
     4233   do
     4234   on error undo, return error
     4235   :
     4236   define input parameter p-doc-code   as character    no-undo.
     4237       define buffer buf_temp_doc-code     for temp_doc-code.
     4238       create buf_temp_doc-code.
     4239       assign
     4240           buf_temp_doc-code.doc-code = p-doc-code
     4241       .
     4242   end.
     4243   END PROCEDURE.
     4244   PROCEDURE fill-temp-ord-doc-code :
     4245     define input  parameter p-doc-code  as character no-undo .
     4246     define buffer buf_temp_ord-doc-code for temp_ord-doc-code.
     4247   do for buf_temp_ord-doc-code
     4248   on error undo, return error return-value
     4249   :
     4250     find first buf_temp_ord-doc-code
     4251       where buf_temp_ord-doc-code.doc-code = p-doc-code
     4252     no-error .
     4253     if not available buf_temp_ord-doc-code
     4254     then do:
     4255       create buf_temp_ord-doc-code.
     4256       assign
     4257         buf_temp_ord-doc-code.doc-code = p-doc-code
     4258       .
     4259     end.
     4260   end.
     4261   END PROCEDURE.
     4262   PROCEDURE fill-temp-pr-doc-num :
     4263   define input parameter p-doc-num as character    no-undo.
     4264       define buffer buf_temp_pr-doc-num       for temp_pr-doc-num.
     4265   do
     4266   for buf_temp_pr-doc-num
     4267   on error undo, return error
     4268   :
     4269       create buf_temp_pr-doc-num.
     4270       assign
     4271           buf_temp_pr-doc-num.doc-num = p-doc-num
     4272       .
     4273   end.
     4274   END PROCEDURE.
     4275   PROCEDURE open-br :
     4276   do
     4277   on error undo, return error return-value
     4278   :
     4279     run waitfram-show in this-procedure ( input "Ждите...":U ).
     4280     open query br-docs
     4281       for each buf_tt-docs no-lock indexed-reposition.
     4282     run waitfram-hide in this-procedure .
     4283   end.
     4284   END PROCEDURE.
     4285   PROCEDURE proc-b-exit :
     4286   END PROCEDURE.
     4287   PROCEDURE proc-b-mark :
     4288     define variable v-log as logical   no-undo .
     4289   do
     4290   on error undo, return error return-value
     4291   :
     4292     if not available buf_tt-docs
     4293     then do:
     4294       return .
     4295     end.
     4296     assign
     4297       buf_tt-docs.is-sel = not buf_tt-docs.is-sel
     4298     .
     4299     v-log = br-docs:refresh() in frame Dialog-Frame .
     4300   end.
     4301   END PROCEDURE.
     4302   PROCEDURE proc-b-start :
     4303   define variable v-log           as logical   no-undo .
     4304   define variable v-host-code     as integer   no-undo .
     4305   define variable v-obj-type      as character no-undo .
     4306   define variable v-obj-code      as integer   no-undo .
     4307   define variable v-need-checks   as logical   no-undo .
     4308   define variable v-xml-file-name as character no-undo .
     4309   define variable v-log-file-name as character no-undo .
     4310   define variable v-out-dir       as character no-undo .
     4311   define variable v-error-message as character no-undo .
     4312   do
     4313   on error undo, return error return-value
     4314   :
     4315     find first buf_tt-docs
     4316       where buf_tt-docs.is-sel = yes
     4317     no-error .
     4318     if not available buf_tt-docs
     4319     then do:
     4320       message
     4321         "Не выбран документ"
     4322       view-as alert-box error.
     4323       return .
     4324     end.
     4325     run waitfram-show in this-procedure ( input "Ждите...":U ).
     4326     run bge-xml-out-dir in this-procedure ( output v-out-dir
     4327                                           , output v-log-file-name
     4328                                           ).
     4329     for each buf_tt-docs
     4330       where buf_tt-docs.is-sel = yes
     4331         and buf_tt-docs.pck-code <> ?
     4332     by buf_tt-docs.pck-code
     4333     :
     4334   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4335   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4336     (input  buf_tt-docs.obj-type
     4337     ,input  buf_tt-docs.obj-code
     4338     ,output v-host-code
     4339     )  .
     4340       run bge/doc-incr.p ( input v-host-code
     4341                          , input today
     4342                          , input today
     4343                          , input buf_tt-docs.obj-type
     4344                          , input buf_tt-docs.obj-code
     4345                          , input yes
     4346                          , input yes
     4347                          , input yes
     4348                          , input yes
     4349                          , input yes
     4350                          , input yes
     4351                          , input yes
     4352                          , input v-xml-file-name
     4353                          , input v-log-file-name
     4354                          , input this-procedure :handle
     4355                          , input ?
     4356                          , input ?
     4357                          , buf_tt-docs.doc-type
     4358                          , buf_tt-docs.doc-code
     4359                          ) no-error.
     4360       if error-status :error
     4361       then do:
     4362         assign
     4363           v-error-message = substitute( "*** Ошибка экспорта документа &1 с кодом: &2.&3&4&5"
     4364                                       , buf_tt-docs.doc-type
     4365                                       , buf_tt-docs.doc-code
     4366                                       , chr(10)
     4367                                       , return-value
     4368                                       , trim(error-status :get-message(1))
     4369                                       )
     4370         .
     4371         run wp-XMLWriteLog in this-procedure ( input v-log-file-name
     4372                                               , input 1
     4373                                               , input v-error-message
     4374                                               ).
     4375         message
     4376           v-error-message
     4377         view-as alert-box error.
     4378         return .
     4379       end.
     4380     end.
     4381     run waitfram-hide in this-procedure .
     4382     message
     4383       "Выгрузка завершена!":U
     4384     view-as alert-box information.
     4385   end.
     4386   END PROCEDURE.
     4387   PROCEDURE proc-doc-code :
     4388     define buffer buf_trn-doc   for ub.trn-doc.
     4389     define buffer buf_price-doc for ub.price-doc.
     4390     define buffer buf_c-trn-doc for ub.c-trn-doc.
     4391     define buffer buf_ord-doc   for ub.ord-doc.
     4392   do
     4393   on error undo, return error return-value
     4394   :
     4395     empty temp-table buf_tt-docs.
     4396     assign
     4397       fi-pck-code = ?
     4398     .
     4399     display
     4400       fi-pck-code
     4401     with frame Dialog-Frame.
     4402     assign
     4403       fi-doc-code
     4404     .
     4405     if fi-doc-code = ""
     4406     then do:
     4407       return .
     4408     end.
     4409     run waitfram-show in this-procedure ( input "Поиск документов...":U ) .
     4410     find first buf_trn-doc no-lock
     4411       where buf_trn-doc.doc-code = fi-doc-code
     4412     no-error .
     4413     if available buf_trn-doc
     4414     then do:
     4415       create buf_tt-docs.
     4416       assign
     4417         buf_tt-docs.doc-type = 'trn-doc':U
     4418         buf_tt-docs.doc-code = buf_trn-doc.doc-code
     4419         buf_tt-docs.obj-type = buf_trn-doc.obj-type
     4420         buf_tt-docs.obj-code = buf_trn-doc.obj-code
     4421       .
     4422       run bge/get-oesq.p ( input 'trn-doc':U
     4423                          , input buf_trn-doc.doc-code
     4424                          , output buf_tt-docs.pck-code
     4425                          ) .
     4426     end.
     4427     find first buf_price-doc no-lock
     4428       where buf_price-doc.doc-num = fi-doc-code
     4429     no-error .
     4430     if available buf_price-doc
     4431     then do:
     4432       create buf_tt-docs.
     4433       assign
     4434         buf_tt-docs.doc-type = 'price-doc':U
     4435         buf_tt-docs.doc-code = buf_price-doc.doc-num
     4436         buf_tt-docs.obj-type = buf_price-doc.obj-type
     4437         buf_tt-docs.obj-code = buf_price-doc.obj-code
     4438       .
     4439       run bge/get-oesq.p ( input 'price-doc':U
     4440                          , input buf_price-doc.doc-num
     4441                          , output buf_tt-docs.pck-code
     4442                          ) .
     4443     end.
     4444     find first buf_c-trn-doc no-lock
     4445       where buf_c-trn-doc.doc-code = fi-doc-code
     4446         and buf_c-trn-doc.is-del   = yes
     4447     no-error .
     4448     if available buf_c-trn-doc
     4449     then do:
     4450       create buf_tt-docs.
     4451       assign
     4452         buf_tt-docs.doc-type = 'c-trn-doc':U
     4453         buf_tt-docs.doc-code = buf_c-trn-doc.doc-code
     4454         buf_tt-docs.obj-type = buf_c-trn-doc.obj-type
     4455         buf_tt-docs.obj-code = buf_c-trn-doc.obj-code
     4456       .
     4457       run bge/get-oesq.p ( input 'c-trn-doc':U
     4458                          , input buf_c-trn-doc.doc-code
     4459                          , output buf_tt-docs.pck-code
     4460                          ) .
     4461     end.
     4462     find first buf_ord-doc no-lock
     4463       where buf_ord-doc.doc-code = fi-doc-code
     4464     no-error .
     4465     if available buf_ord-doc
     4466     then do:
     4467       create buf_tt-docs.
     4468       assign
     4469         buf_tt-docs.doc-type = 'ord-doc':U
     4470         buf_tt-docs.doc-code = buf_ord-doc.doc-code
     4471         buf_tt-docs.obj-type = buf_ord-doc.obj-type
     4472         buf_tt-docs.obj-code = buf_ord-doc.obj-code
     4473       .
     4474       run bge/get-oesq.p ( input 'ord-doc':U
     4475                          , input buf_ord-doc.doc-code
     4476                          , output buf_tt-docs.pck-code
     4477                          ) .
     4478     end.
     4479     run waitfram-hide in this-procedure .
     4480     run open-br in this-procedure .
     4481   end.
     4482   END PROCEDURE.
     4483   PROCEDURE proc-pck-code :
     4484   define buffer buf_doc-attr      for ub.doc-attr.
     4485   define buffer buf_ord-doc-attr  for ub.ord-doc-attr.
     4486   define buffer buf_trn-doc   for ub.trn-doc.
     4487   define buffer buf_price-doc for ub.price-doc.
     4488   define buffer buf_c-trn-doc for ub.c-trn-doc.
     4489   define buffer buf_ord-doc   for ub.ord-doc.
     4490   define variable v-doc-code  as character no-undo .
     4491   do
     4492   on error undo, return error return-value
     4493   :
     4494     empty temp-table buf_tt-docs.
     4495     assign
     4496       fi-doc-code = ?
     4497     .
     4498     display
     4499       fi-doc-code
     4500     with frame Dialog-Frame.
     4501     assign
     4502       fi-pck-code
     4503     .
     4504     assign
     4505       v-doc-code = string(fi-pck-code)
     4506     .
     4507     if v-doc-code = ""
     4508     then do:
     4509       return .
     4510     end.
     4511     run waitfram-show in this-procedure ( input "Поиск документов...":U ) .
     4512     find first buf_doc-attr no-lock
     4513       where buf_doc-attr.attr-code  = 'ora-exp-seq-num':U
     4514         and buf_doc-attr.attr-value = v-doc-code
     4515     no-error.
     4516     if available buf_doc-attr
     4517     then do:
     4518       find first buf_trn-doc no-lock
     4519         where buf_trn-doc.doc-code = buf_doc-attr.doc-code
     4520       no-error .
     4521       if available buf_trn-doc
     4522       then do:
     4523         create buf_tt-docs.
     4524         assign
     4525           buf_tt-docs.doc-type = 'trn-doc':U
     4526           buf_tt-docs.doc-code = buf_trn-doc.doc-code
     4527           buf_tt-docs.obj-type = buf_trn-doc.obj-type
     4528           buf_tt-docs.obj-code = buf_trn-doc.obj-code
     4529         .
     4530         run bge/get-oesq.p ( input 'trn-doc':U
     4531                           , input buf_trn-doc.doc-code
     4532                           , output buf_tt-docs.pck-code
     4533                           ) .
     4534       end.
     4535       else do:
     4536         find first buf_price-doc no-lock
     4537           where buf_price-doc.doc-num = buf_doc-attr.doc-code
     4538         no-error .
     4539         if available buf_price-doc
     4540         then do:
     4541           create buf_tt-docs.
     4542           assign
     4543             buf_tt-docs.doc-type = 'price-doc':U
     4544             buf_tt-docs.doc-code = buf_price-doc.doc-num
     4545             buf_tt-docs.obj-type = buf_price-doc.obj-type
     4546             buf_tt-docs.obj-code = buf_price-doc.obj-code
     4547           .
     4548           run bge/get-oesq.p ( input 'price-doc':U
     4549                             , input buf_price-doc.doc-num
     4550                             , output buf_tt-docs.pck-code
     4551                             ) .
     4552         end.
     4553         else do:
     4554           find first buf_c-trn-doc no-lock
     4555             where buf_c-trn-doc.doc-code = buf_doc-attr.doc-code
     4556               and buf_c-trn-doc.is-del   = yes
     4557           no-error .
     4558           if available buf_c-trn-doc
     4559           then do:
     4560             create buf_tt-docs.
     4561             assign
     4562               buf_tt-docs.doc-type = 'c-trn-doc':U
     4563               buf_tt-docs.doc-code = buf_c-trn-doc.doc-code
     4564               buf_tt-docs.obj-type = buf_c-trn-doc.obj-type
     4565               buf_tt-docs.obj-code = buf_c-trn-doc.obj-code
     4566             .
     4567             run bge/get-oesq.p ( input 'c-trn-doc':U
     4568                               , input buf_c-trn-doc.doc-code
     4569                               , output buf_tt-docs.pck-code
     4570                               ) .
     4571           end.
     4572         end.
     4573       end.
     4574     end.
     4575     else do:
     4576       find first buf_ord-doc-attr no-lock
     4577         where buf_ord-doc-attr.attr-code  = 'ora-exp-seq-num':U
     4578           and buf_ord-doc-attr.attr-value = v-doc-code
     4579       no-error .
     4580       if available buf_ord-doc-attr
     4581       then do:
     4582         find first buf_ord-doc no-lock
     4583           where buf_ord-doc.doc-code = buf_ord-doc-attr.doc-code
     4584         no-error .
     4585         if available buf_ord-doc
     4586         then do:
     4587           assign
     4588             buf_tt-docs.doc-type = 'ord-doc':U
     4589             buf_tt-docs.doc-code = buf_ord-doc.doc-code
     4590           .
     4591           run bge/get-oesq.p ( input 'ord-doc':U
     4592                              , input buf_ord-doc.doc-code
     4593                              , output buf_tt-docs.pck-code
     4594                              ) .
     4595         end.
     4596       end.
     4597     end.
     4598     run waitfram-hide in this-procedure .
     4599     run open-br in this-procedure .
     4600   end.
     4601   END PROCEDURE.
     4602   FUNCTION display-selected RETURNS CHARACTER
     4603     ( BUFFER loc_tt-docs FOR tt-docs ) :
     4604     RETURN IF loc_tt-docs.is-sel = YES THEN "*" ELSE "".
     4605   END FUNCTION.
