      149     .
      150   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      151   define temp-table temp-schedule-free no-undo
      152   field free-id as character
      153   field free-task-name as character
      154   field proc-run-name as character
