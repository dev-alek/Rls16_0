      166   procedure schedule-attr-name :
      167   do
      168     on error undo, return error
      169     :
      170     define input  parameter p-code           as character no-undo .
      171     define output parameter p-type           as character no-undo .
      172     define output parameter p-format         as character no-undo .
      173     define output parameter p-label          as character no-undo .
      174     define output parameter p-user-can-edit  as logical   no-undo .
      175     define output parameter p-output-display as logical   no-undo .
      176     define output parameter p-other          as character no-undo .
      177       if index(p-code, chr(4)) > 0 then do:
      178         p-code = entry(1, p-code, chr(4)).
      179       end.
      180       case p-code :
      181               when 'schedule-param-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      182               when 'schedule-obj-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      183               when 'schedule-oss-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      184               when 'schedule-gds-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      185               when 'schedule-doc-type-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      186               when 'schedule-date-list':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      187               when 'schedule-filter':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      188               when 'schedule-filter-2':U then do:     assign     p-label = "Параметры строки расписания"     p-type = 'C':U      p-format = "X(30)"     p-label = "Параметры строки расписания"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      189               when 'schd-free-id':U then do:     assign     p-label = "Идентификатор произвольной задачи"     p-type = 'C':U      p-format = "X(30)"     p-label = "Идентификатор произвольной задачи"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
      190         otherwise do:
      191           undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      192         end.
      193       end.
      194     end.
      195   end procedure.
      196   procedure schedule-attr-tooltip :
      197   do
      198     on error undo, return error
      199     :
      200       define input  parameter p-code    as character no-undo .
      201       define output parameter p-tooltip as character no-undo .
      202       define output parameter p-label   as character no-undo .
      203       if index(p-code, chr(4)) > 0 then do:
      204         p-code = entry(1, p-code, chr(4)).
      205       end.
      206       case p-code :
      207               when 'schedule-param-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      208               when 'schedule-obj-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      209               when 'schedule-oss-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      210               when 'schedule-gds-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      211               when 'schedule-doc-type-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      212               when 'schedule-date-list':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      213               when 'schedule-filter':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      214               when 'schedule-filter-2':U then do:     assign     p-tooltip = "Параметры строки расписания"     p-label = "Параметры строки расписания" .   end.
      215               when 'schd-free-id':U then do:     assign     p-tooltip = "Идентификатор произвольной задачи"     p-label = "Идентификатор произвольной задачи" .   end.
      216         otherwise do:
      217               undo, return error "Неизвестный атрибут строки расписания" + " " + p-code .
      218         end.
      219       end.
      220     end.
      221   end procedure.
      222   procedure schedule-attr-value :
      223   do
      224   on error undo, return error return-value
      225   :
      226   define input parameter  p-cre-db-num as integer    no-undo.
      227   define input parameter  p-task-type  as character  no-undo.
      228   define input parameter  p-task-num   as integer    no-undo.
      229   define input parameter  p-code       as character  no-undo.
      230   define output parameter p-value      as character  no-undo.
      231   define output parameter p-type       as character  no-undo.
      232       define variable v-format         as character no-undo .
      233       define variable v-label          as character no-undo .
      234       define variable v-user-can-edit  as logical   no-undo .
      235       define variable v-output-display as logical   no-undo .
      236       define variable v-other          as character no-undo .
      237       define buffer buf_schedule-attr for ub.schedule-attr.
      238       run schedule-attr-name in this-procedure (
      239             input  p-code
      240           , output p-type
      241           , output v-format
      242           , output v-label
      243           , output v-user-can-edit
      244           , output v-output-display
      245           , output v-other
      246       ) no-error .
      247       if error-status :error
      248       then do:
      249           undo, return error return-value .
      250       end.
      251       if p-code begins ('schd-free-id':U + chr(4))
      252       and entry(2, p-code, chr(4)) = '':U then do:
      253         find first buf_schedule-attr no-lock
      254             where buf_schedule-attr.cre-db-num = p-cre-db-num
      255               and buf_schedule-attr.task-type  = p-task-type
      256               and buf_schedule-attr.task-num   = p-task-num
      257               and buf_schedule-attr.attr-code  begins p-code
      258         no-error .
      259       end.
      260       else do:
      261         find first buf_schedule-attr no-lock
      262             where buf_schedule-attr.cre-db-num = p-cre-db-num
      263               and buf_schedule-attr.task-type  = p-task-type
      264               and buf_schedule-attr.task-num   = p-task-num
      265               and buf_schedule-attr.attr-code  = p-code
      266         no-error .
      267       end.
      268       if available buf_schedule-attr
      269       then do:
      270           assign
      271               p-value = buf_schedule-attr.attr-value
      272           .
      273       end.
      274       else do:
      275         if p-code begins ('schd-free-id':U + chr(4) ) then do:
      276            run schedule-attr-get-free-props in this-procedure (input entry(2, p-code, chr(4)), output p-value).
      277         end.
      278         else do:
      279           assign
      280               p-value = if p-type = 'L':U then "no":U else ""
      281           .
      282         end.
      283       end.
      284   end.
      285   end procedure.
      286   procedure schedule-attr-write :
      287   do
      288   on error undo, return error
      289   :
      290   define input parameter p-cre-db-num  as integer   no-undo.
      291   define input parameter p-task-type   as character no-undo.
      292   define input parameter p-task-num    as integer   no-undo.
      293   define input parameter p-code        as character no-undo.
      294   define input parameter p-value       as character no-undo.
      295       define variable v-type              as character                no-undo.
      296       define variable v-format            as character                no-undo.
      297       define variable v-label             as character                no-undo.
      298       define variable v-user-can-edit     as logical                  no-undo.
      299       define variable v-output-display    as logical                  no-undo.
      300       define variable v-other             as character                no-undo.
      301       define buffer buf_schedule-attr for ub.schedule-attr .
      302       run schedule-attr-name in this-procedure (
      303             input  p-code
      304           , output v-type
      305           , output v-format
      306           , output v-label
      307           , output v-user-can-edit
      308           , output v-output-display
      309           , output v-other
      310       ) no-error.
      311       if error-status :error
      312       then do:
      313           undo, return error return-value.
      314       end.
      315       find first buf_schedule-attr exclusive-lock
      316            where buf_schedule-attr.cre-db-num = p-cre-db-num
      317              and buf_schedule-attr.task-type  = p-task-type
      318              and buf_schedule-attr.task-num   = p-task-num
      319              and buf_schedule-attr.attr-code  = p-code
      320       no-error.
      321       if not available buf_schedule-attr
      322       then do:
      323           create buf_schedule-attr.
      324           assign
      325             buf_schedule-attr.cre-db-num = p-cre-db-num
      326             buf_schedule-attr.task-type  = p-task-type
      327             buf_schedule-attr.task-num   = p-task-num
      328             buf_schedule-attr.attr-code  = p-code
      329             buf_schedule-attr.attr-value = p-value
      330           .
      331       end.
      332       else do:
      333           assign
      334               buf_schedule-attr.attr-value = p-value
      335           .
      336       end.
      337   end.
      338   end procedure.
      339   procedure schedule-attr-delete :
      340   do
      341   on error undo, return error
      342   :
      343   define input  parameter p-cre-db-num  as integer   no-undo.
      344   define input  parameter p-task-type   as character no-undo.
      345   define input  parameter p-task-num    as integer   no-undo.
      346   define input  parameter p-code        as character no-undo.
      347   define output parameter p-deleted     as logical   no-undo.
      348       define buffer buf_schedule-attr for ub.schedule-attr .
      349       define variable v-type              as character                no-undo.
      350       define variable v-format            as character                no-undo.
      351       define variable v-label             as character                no-undo.
      352       define variable v-user-can-edit     as logical                  no-undo.
      353       define variable v-output-display    as logical                  no-undo.
      354       define variable v-other             as character                no-undo.
      355       run schedule-attr-name in this-procedure (
      356             input p-code
      357           , output v-type
      358           , output v-format
      359           , output v-label
      360           , output v-user-can-edit
      361           , output v-output-display
      362           , output v-other
      363       ) no-error .
      364       if error-status :error
      365       then do:
      366           undo, return error return-value .
      367       end.
      368       find first buf_schedule-attr exclusive-lock
      369            where buf_schedule-attr.cre-db-num = p-cre-db-num
      370              and buf_schedule-attr.task-type  = p-task-type
      371              and buf_schedule-attr.task-num   = p-task-num
      372              and buf_schedule-attr.attr-code  = p-code
      373       no-error.
      374       if not available buf_schedule-attr
      375       then do:
      376           assign
      377               p-deleted = no
      378           .
      379       end.
      380       else do:
      381           delete buf_schedule-attr.
      382           assign
      383               p-deleted = yes
      384           .
      385       end.
      386   end.
      387   end procedure.
      388   procedure schedule-attr-news :
      389   do
      390   on error undo, return error
      391   :
      392       define input  parameter p-code           as character no-undo .
      393       define output parameter p-news           as logical   no-undo .
      394       if index(p-code, chr(4)) > 0 then do:
      395         p-code = entry(1, p-code, chr(4)).
      396       end.
      397       case p-code :
      398               when 'schedule-param-list':U then do:     assign     p-news = false.   end.
      399               when 'schedule-obj-list':U then do:     assign     p-news = false.   end.
      400               when 'schedule-oss-list':U then do:     assign     p-news = false.   end.
      401               when 'schedule-gds-list':U then do:     assign     p-news = false.   end.
      402               when 'schedule-doc-type-list':U then do:     assign     p-news = false.   end.
      403               when 'schedule-date-list':U then do:     assign     p-news = false.   end.
      404               when 'schedule-filter':U then do:     assign     p-news = false.   end.
      405               when 'schedule-filter-2':U then do:     assign     p-news = false.   end.
      406               when 'schd-free-id':U then do:     assign     p-news = false.   end.
      407         otherwise do:
      408           undo, return error "неизвестный атрибут строки расписания" + " " + p-code .
      409         end.
      410       end.
      411   end.
      412   end procedure.
      413   procedure schedule-attr-extract-logical :
      414   do
      415   on error undo, return error
      416   :
      417   define input  parameter p-parameter-number   as integer      no-undo.
      418   define input  parameter p-parameter-list     as character    no-undo.
      419   define output parameter p-parameter-value   as logical      no-undo.
      420       if num-entries( p-parameter-list ) > p-parameter-number - 1
      421       then do:
      422           assign
      423               p-parameter-value   = ( entry( p-parameter-number, p-parameter-list ) = "yes" )
      424           .
      425       end.
      426       else do:
      427           assign
      428               p-parameter-value   = no
      429           .
      430       end.
      431   end.
      432   end procedure.
      433   procedure schedule-attr-get-free-id :
      434   do
      435   on error undo, return error return-value
      436   :
      437     define input  parameter p-cre-db-num  as integer   no-undo.
      438     define input  parameter p-task-type   as character no-undo.
      439     define input  parameter p-task-num    as integer   no-undo.
      440     define output parameter p-free-id     as character no-undo.
      441     define buffer buf_schedule-attr for ub.schedule-attr.
      442     find first buf_schedule-attr no-lock
      443         where buf_schedule-attr.cre-db-num = p-cre-db-num
      444           and buf_schedule-attr.task-type  = p-task-type
      445           and buf_schedule-attr.task-num   = p-task-num
      446           and buf_schedule-attr.attr-code  begins  ('schd-free-id':U + chr(4))
      447     no-error .
      448     if available buf_schedule-attr then
      449     assign
      450     p-free-id = entry(2, buf_schedule-attr.attr-code, chr(4))
      451     no-error
      452     .
      453   end.
      454   end procedure.
      455   procedure schedule-attr-get-free-props :
      456     define input parameter p-free-id as character no-undo .
      457     define output parameter p-value as character no-undo .
      458     define buffer buf_temp-schedule-free for temp-schedule-free.
      459     do
      460     on error undo, return error return-value
      461     :
      462       find first buf_temp-schedule-free no-lock no-error .
      463       if not available buf_temp-schedule-free then do:
      464         run schedule-attr-fill-free-props in this-procedure .
      465       end.
      466       find first buf_temp-schedule-free where
      467               buf_temp-schedule-free.free-id = p-free-id no-error.
      468       if available buf_temp-schedule-free then do:
      469         assign
      470         p-value = buf_temp-schedule-free.free-task-name       + chr(4) +
      471                   buf_temp-schedule-free.proc-run-name        + chr(4) +
      472                   buf_temp-schedule-free.proc-param-edit-name + chr(4) +
      473                   buf_temp-schedule-free.conf-param           + chr(4) +
      474                   string(buf_temp-schedule-free.is-gbd)       + chr(4) +
      475                   string(buf_temp-schedule-free.is-ubd)       + chr(4) +
      476                   string(buf_temp-schedule-free.enable-concurrent-0) + chr(4) +
      477                   string(buf_temp-schedule-free.enable-concurrent-db) + chr(4) +
      478                   buf_temp-schedule-free.other-info
      479         .
      480       end.
      481       else do:
      482        if p-free-id <> '':U then return error substitute("&1 &2 &3&4Неопределены процедуры для работы с произвольной задачей по расписанию&4" +
      483                              "id произвольной задачи - &5"
      484                              ,vss-workfile
      485                              ,vss-revision
      486                              ,vss-description
      487                              ,chr(10)
      488                              ,p-free-id).
      489       end.
      490     end.
      491   end procedure.
      492   procedure schedule-attr-is-rum-free-id :
      493   define input parameter p-free-id as character no-undo .
      494   define output parameter p-is-rum as logical no-undo .
      495   define buffer buf_temp-schedule-free for temp-schedule-free.
      496   do
      497   on error undo, return error
      498   :
      499       find first buf_temp-schedule-free no-lock no-error .
      500       if not available buf_temp-schedule-free then do:
      501         run schedule-attr-fill-free-props in this-procedure .
      502       end.
      503       find first buf_temp-schedule-free where
      504               buf_temp-schedule-free.free-id = p-free-id no-error.
      505       if available buf_temp-schedule-free
      506       and buf_temp-schedule-free.is-rum
      507       then do:
      508         p-is-rum = yes.
      509       end.
      510   end.
      511   end procedure.
      512   procedure schedule-attr-fill-free-props :
      513   define variable v-path                    as character                no-undo .
      514   DEFINE VARIABLE v-full-path               as character                no-undo .
      515   DEFINE VARIABLE v-file-name               as character                no-undo .
      516   DEFINE VARIABLE v-file-name-no-ext        as character                no-undo .
      517   DEFINE VARIABLE v-file-name-ext           as character                no-undo .
      518   define buffer buf_temp-schedule-free for temp-schedule-free.
      519   define variable v-answer as logical no-undo .
      520     do
      521     on error undo, return error substitute("&1 &2 &3&4&5&4"
      522                                           ,vss-workfile
      523                                           ,vss-revision
      524                                           ,vss-description
      525                                           ,chr(10)
      526                                           ,error-status:get-message(1) )
      527     :
      528       run gbl/filename.p (
      529                       input 'cmp/shd-free.d'
      530                     ,output v-full-path
      531                     ,output v-path
      532                     ,output v-file-name
      533                     ,output v-file-name-no-ext
      534                     ,output v-file-name-ext
      535                     ) .
      536       input from value(v-full-path).
      537       repeat :
      538         create buf_temp-schedule-free.
      539         import buf_temp-schedule-free.
      540       END.
      541       input close.
      542       _ff:
      543       for each buf_temp-schedule-free :
      544         if buf_temp-schedule-free.free-id = '':U then do:
      545            delete buf_temp-schedule-free.
      546            next _ff.
      547          end.
      548          run schedule-attr-check-enc in this-procedure (
      549                                                       input  buf_temp-schedule-free.free-id
      550                                                      ,input  (buf_temp-schedule-free.proc-run-name +
      551                                                               buf_temp-schedule-free.proc-param-edit-name +
      552                                                               buf_temp-schedule-free.conf-param +
      553                                                               string(buf_temp-schedule-free.is-gbd) +
      554                                                               string(buf_temp-schedule-free.is-ubd) +
      555                                                               string(buf_temp-schedule-free.enable-concurrent-0) +
      556                                                               string(buf_temp-schedule-free.enable-concurrent-db) +
      557                                                               string(buf_temp-schedule-free.other-info)
      558                                                               )
      559                                                       ,input  buf_temp-schedule-free.enc-key
      560                                                       ,output v-answer    ) no-error .
      561          if error-status:error
      562          or not v-answer then delete buf_temp-schedule-free.
      563        end.
      564     end.
      565   end procedure.
      566   Function schedule-attr-reverse returns character (str as character).
      567      define variable rev_incl_s as character init "" no-undo .
      568      define variable rev_incl_i as integer no-undo .
      569      define variable rev_incl_l as integer no-undo .
      570      rev_incl_l = length(str).
      571      do rev_incl_i = 1 to rev_incl_l:
      572         rev_incl_s = rev_incl_s + substr(str,rev_incl_l - rev_incl_i + 1,1).
      573      end.
      574      return rev_incl_s.
      575   end.
      576   procedure schedule-attr-check-enc.
      577     define input  parameter p-free-id   as character no-undo .
      578     define input  parameter p-value     as character no-undo .
      579     define input  parameter p-enc-value as character no-undo .
      580     define output parameter p-answer    as logical   no-undo .
      581     define variable tmp         as character no-undo .
      582     define variable v-enc-value as character no-undo .
      583     assign
      584     tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value)) .
      585     .
      586     run schedule-attr-pswd-enc in this-procedure
      587       ( input tmp
      588        ,output v-enc-value
      589       ) no-error .
      590     if error-status:error then do:
      591       message
      592         vss-workfile vss-revision vss-description skip
      593         "Ошибка при вызове процедуры pswd-enc" skip
      594         return-value skip
      595         error-status :get-message(1) skip
      596         view-as alert-box error .
      597       undo, return error .
      598     end.
      599     if v-enc-value = p-enc-value then do:
      600       assign
      601         p-answer = true
      602       .
      603     end.
      604     else do:
      605       assign
      606         p-answer = false
      607       .
      608     end.
      609   end.
      610   procedure schedule-attr-conf-enc.
      611     define input  parameter p-free-id   as character no-undo .
      612     define input  parameter p-value     as character no-undo .
      613     define output parameter p-enc-value as character no-undo .
      614     define variable tmp         as character no-undo .
      615     assign
      616       tmp = schedule-attr-reverse (trim (p-free-id)) + schedule-attr-reverse (trim (p-value))
      617     .
      618     run schedule-attr-pswd-enc in this-procedure
      619       ( input tmp
      620        ,output p-enc-value
      621       ) no-error .
      622     if error-status:error then do:
      623       message
      624         vss-workfile vss-revision vss-description skip
      625         "Ошибка при вызове процедуры pswd-enc" skip
      626         return-value skip
      627         error-status :get-message(1) skip
      628         view-as alert-box error .
      629       undo, return error .
      630     end.
      631   end procedure.
      632   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      633   procedure schedule-attr-pswd-enc :
      634     define input parameter  pswd     as character no-undo .
      635     define output parameter enc-pswd as character no-undo .
      636     do
      637     on error undo, return error return-value
      638     :
      639       assign
      640         enc-pswd = encode(pswd + string(index(pswd, "k")))
      641       .
      642     end.
      643   end procedure.
      644   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      645   procedure factord :
      646     define input  parameter p-fact-date            as date    no-undo .
      647     define input  parameter p-fact-time            as integer no-undo .
      648     define input  parameter p-fact-num             as integer no-undo .
      649     define input  parameter p-shift-date           as date    no-undo .
      650     define input  parameter p-shift-num            as integer no-undo .
      651     define input  parameter p-shift-on             as logical no-undo .
      652     define output parameter p-fact-order           as decimal no-undo .
      653     define output parameter p-shift-end-fact-order as decimal no-undo .
      654     define output parameter p-day-end-fact-order   as decimal no-undo .
      655     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      656     if p-fact-date = ?
      657     then do:
      658       return error "Не указана фактическая дата" .
      659     end.
      660     define variable v-fact-date-num as integer no-undo .
      661     assign
      662       v-fact-date-num = integer(p-fact-date)
      663     .
      664     if p-fact-num = ?
      665     or p-fact-num = 0
      666     then do:
      667       return error "Не задан p-fact-num " + string(p-fact-num) .
      668     end.
      669     if p-fact-num < 0
      670     then do:
      671       return error "Отрицательный fact-num " + string(p-fact-num) .
      672     end.
      673     if p-fact-num >= 100000000
      674     then do:
      675       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      676     end.
      677     if p-shift-on = true
      678     then do:
      679       if p-shift-date = ?
      680       then do:
      681         return error "Не задана дата смены" .
      682       end.
      683       if p-shift-num = ?
      684       or p-shift-num = 0
      685       then do:
      686         return error "Не задан номер смены" .
      687       end.
      688     end.
      689     else do:
      690       assign
      691         p-shift-date = p-fact-date
      692         p-shift-num  = 24
      693       .
      694     end.
      695     define variable v-shift-offset as integer no-undo .
      696     if p-shift-date = p-fact-date
      697     then do:
      698       assign
      699         v-shift-offset = 1
      700       .
      701     end.
      702     if p-shift-date < p-fact-date
      703     then do:
      704       assign
      705         v-shift-offset = 0
      706       .
      707     end.
      708     if p-shift-date > p-fact-date
      709     then do:
      710       message
      711         vss-workfile vss-revision vss-description skip
      712         "Неправильная дата закрытия смены" skip
      713         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      714         view-as alert-box error .
      715       undo, return error
      716         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      717           ,string(p-fact-date, '99/99/9999':U)
      718           ,string(p-shift-date, '99/99/9999':U)
      719           )
      720       .
      721     end.
      722     if p-shift-num < 1
      723     or p-shift-num > 24
      724     then do:
      725       message
      726         vss-workfile vss-revision vss-description skip
      727         "Неправильный номер смены" skip
      728         "p-shift-num" p-shift-num skip
      729         view-as alert-box error .
      730       undo, return error return-value .
      731     end.
      732     assign
      733       p-fact-order           = v-fact-date-num
      734                              + v-shift-offset * 0.5
      735                              + p-shift-num    * 0.02 - 0.01
      736                              + p-fact-num     * 0.0000000001
      737       p-shift-end-fact-order = v-fact-date-num
      738                              + v-shift-offset * 0.5
      739                              + p-shift-num    * 0.02
      740       p-day-end-fact-order   = v-fact-date-num
      741                              + 0.99
      742     .
      743     if p-fact-order           <= v-fact-date-num
      744     or p-shift-end-fact-order <= v-fact-date-num
      745     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      746     or p-shift-end-fact-order >= p-day-end-fact-order
      747     then do:
      748       message
      749         vss-workfile vss-revision vss-description skip
      750         "Внутренняя ошибка при генерации фактического номера" skip
      751         "p-fact-date"            p-fact-date            skip
      752         "p-fact-time"            p-fact-time            skip
      753         "p-fact-num"             p-fact-num             skip
      754         "p-shift-date"           p-shift-date           skip
      755         "p-shift-num"            p-shift-num            skip
      756         "p-shift-on"             p-shift-on             skip
      757         "p-shift-end-fact-order" p-shift-end-fact-order skip
      758         "p-day-end-fact-order"   p-day-end-fact-order   skip
      759         "v-fact-date-num"        v-fact-date-num        skip
      760         view-as alert-box error .
      761       undo, return error return-value .
      762     end.
      763   end procedure.
      764   procedure day-begin-fact-order :
      765     define input  parameter p-fact-date            as date    no-undo .
      766     define output parameter p-day-begin-fact-order as decimal no-undo .
      767     do
      768     on error undo, return error return-value
      769     :
      770       if p-fact-date = ?
      771       then do:
      772         assign
      773           p-day-begin-fact-order = 0
      774         .
      775       end.
      776       else do:
      777         assign
      778           p-day-begin-fact-order = integer(p-fact-date)
      779         .
      780       end.
      781     end.
      782   end procedure.
      783   procedure factord-max-fact-order :
      784     define output parameter p-max-fact-order as decimal   no-undo .
      785     do
      786     on error undo, return error return-value
      787     :
      788       run day-begin-fact-order in this-procedure
      789         (input  date(1, 1, 5000)
      790         ,output p-max-fact-order
      791         ) .
      792     end.
      793   end procedure.
      794   procedure factord-cut-archive :
      795     define input  parameter p-obj-type             as character no-undo .
      796     define input  parameter p-obj-code             as integer   no-undo .
      797     define input  parameter p-fact-date            as date      no-undo .
      798     define output parameter p-shift-on             as logical   no-undo .
      799     define output parameter p-shift-date           as date      no-undo .
      800     define output parameter p-shift-num            as integer   no-undo .
      801     define output parameter p-day-end-fact-order   as decimal   no-undo .
      802     define output parameter p-shift-end-fact-order as decimal   no-undo .
      803     define variable v-fact-order as decimal   no-undo .
      804     define buffer buf_shift-obj for ub.shift-obj .
      805     do
      806     on error undo, return error return-value
      807     :
      808   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      809   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      810     (input  p-obj-type
      811     ,input  p-obj-code
      812     ,input  'shift-on=request'
      813     ,output p-shift-on
      814     ) no-error .
      815       if error-status :error
      816       then do:
      817         message
      818           vss-workfile vss-revision vss-description skip
      819           "Ошибка при определении атрибута объекта" skip
      820           "Объект" p-obj-type p-obj-code skip
      821           error-status :get-message(1) skip
      822           return-value skip
      823           view-as alert-box error .
      824         undo, return error return-value .
      825       end.
      826       if p-shift-on = false
      827       then do:
      828         assign
      829           p-shift-date               = ?
      830           p-shift-num                = 0
      831         .
      832       end.
      833       else do:
      834         find first buf_shift-obj share-lock
      835           where buf_shift-obj.obj-type   = p-obj-type
      836             and buf_shift-obj.obj-code   = p-obj-code
      837             and buf_shift-obj.shift-date > p-fact-date
      838           use-index pi
      839           no-error .
      840         if not available buf_shift-obj
      841         or buf_shift-obj.status_ <> 'зкр':U
      842         then do:
      843           message
      844             vss-workfile vss-revision vss-description skip
      845             "Невозможно вычислить последнюю смену" skip
      846             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      847             "Объект" p-obj-type p-obj-code skip
      848             "Дата" p-fact-date skip
      849             view-as alert-box error .
      850           undo, return error return-value .
      851         end.
      852         find last buf_shift-obj share-lock
      853           where buf_shift-obj.obj-type = p-obj-type
      854             and buf_shift-obj.obj-code = p-obj-code
      855             and buf_shift-obj.shift-date <= p-fact-date
      856           use-index pi
      857           no-error .
      858         if available buf_shift-obj
      859         then do:
      860           if  buf_shift-obj.status_ = 'зкр':U
      861           then do:
      862             assign
      863               p-shift-date = buf_shift-obj.shift-date
      864               p-shift-num  = buf_shift-obj.shift-num
      865             .
      866           end.
      867           else do:
      868             message
      869               vss-workfile vss-revision vss-description skip
      870               "Невозможно вычислить последнюю смену" skip
      871               "Статус смены отличен от статуса" 'зкр':U skip
      872               "Объект" p-obj-type p-obj-code skip
      873               "Дата" p-fact-date skip
      874               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      875               view-as alert-box error .
      876             undo, return error return-value .
      877           end.
      878         end.
      879         else do:
      880           assign
      881             p-shift-date = p-fact-date - 1
      882             p-shift-num  = 1
      883           .
      884         end.
      885       end.
      886       run factord in this-procedure
      887         (input  p-fact-date
      888         ,input  1
      889         ,input  1
      890         ,input  p-shift-date
      891         ,input  p-shift-num
      892         ,input  p-shift-on
      893         ,output v-fact-order
      894         ,output p-shift-end-fact-order
      895         ,output p-day-end-fact-order
      896         ) no-error .
      897       if error-status :error
      898       then do:
      899         message
      900           vss-workfile vss-revision vss-description skip
      901           "Ошибка при вызове процедуры factord"
      902           error-status :get-message(1) skip
      903           return-value skip
      904           view-as alert-box error .
      905         undo, return error return-value .
      906       end.
      907     end.
      908   end procedure.
      909   procedure factord-lock-shift :
      910     define input  parameter p-obj-type  as character no-undo .
      911     define input  parameter p-obj-code  as integer   no-undo .
      912     define input  parameter p-fact-date as date      no-undo .
      913     define parameter buffer buf_shift-obj for ub.shift-obj .
      914     define variable v-shift-on      as logical   no-undo .
      915     define variable v-extra-message as character no-undo .
      916     define variable v-error as character no-undo .
      917     do
      918     on error undo, return error return-value
      919     :
      920   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      921   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      922     (input  p-obj-type
      923     ,input  p-obj-code
      924     ,input  'shift-on=request'
      925     ,output v-shift-on
      926     ) no-error .
      927       if error-status :error
      928       then do:
      929         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      930         undo, return error v-error .
      931       end.
      932       if v-shift-on = true
      933       then do:
      934         find first buf_shift-obj share-lock
      935           where buf_shift-obj.obj-type   = p-obj-type
      936             and buf_shift-obj.obj-code   = p-obj-code
      937             and buf_shift-obj.shift-date > p-fact-date
      938           use-index pi
      939           no-error .
      940         if not available buf_shift-obj
      941         or buf_shift-obj.status_ <> 'зкр':U
      942         then do:
      943           find last buf_shift-obj
      944             where buf_shift-obj.obj-type = p-obj-type
      945               and buf_shift-obj.obj-code = p-obj-code
      946               and buf_shift-obj.status_  = 'зкр':U
      947             use-index stts
      948             no-error .
      949           if available buf_shift-obj
      950           then do:
      951             assign
      952               v-extra-message =
      953                     substitute("Дата начала последеней закрытой смены на объекте &1"
      954                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      955                               )
      956             .
      957           end.
      958           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      959           undo, return error v-error .
      960         end.
      961       end.
      962     end.
      963   end procedure.
      964   procedure factord-end-day :
      965     define input  parameter p-fact-date            as date    no-undo .
      966     define output parameter p-day-end-fact-order   as decimal no-undo .
      967     do
      968     on error undo, return error return-value
      969     :
      970       if p-fact-date = ?
      971       then do:
      972         return error "Не указана фактическая дата" .
      973       end.
      974       assign
      975         p-day-end-fact-order = integer(p-fact-date) + 0.99
      976       .
      977     end.
      978   end procedure.
      979   procedure factord-to-date :
      980     define input  parameter p-fact-order as decimal no-undo .
      981     define output parameter p-fact-date  as date    no-undo .
      982     define variable v-ref-date  as date      no-undo .
      983     define variable v-ref-delta as integer   no-undo .
      984     do
      985     on error undo, return error return-value
      986     :
      987       if p-fact-order = ?
      988       or p-fact-order = 0
      989       then do:
      990         return error "Не указан fact-order" .
      991       end.
      992       assign
      993         v-ref-date  = date(1, 1, 2000)
      994       .
      995       assign
      996         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      997       .
      998       assign
      999         p-fact-date = v-ref-date + v-ref-delta
     1000       .
     1001     end.
     1002   end procedure.
     1003   procedure factord-to-fact-num :
     1004     define input  parameter p-fact-order as decimal no-undo .
     1005     define output parameter p-fact-num   as integer no-undo .
     1006     define variable v-fact-order-trunc as decimal no-undo .
     1007     do
     1008     on error undo, return error return-value
     1009     :
     1010       if p-fact-order = ?
     1011       or p-fact-order = 0
     1012       then do:
     1013         return error "Не указан fact-order" .
     1014       end.
     1015       assign
     1016        v-fact-order-trunc = truncate(p-fact-order, 2)
     1017       .
     1018       assign
     1019         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1020       .
     1021     end.
     1022   end procedure.
     1023   procedure factord-to-shift-num :
     1024     define input  parameter p-fact-order as decimal no-undo .
     1025     define output parameter p-shift-num   as integer no-undo .
     1026     define variable  p-shift-numd  as decimal   no-undo .
     1027     define variable v-fact-order-trunc as decimal no-undo .
     1028     do
     1029     on error undo, return error return-value
     1030     :
     1031       if p-fact-order = ?
     1032       or p-fact-order = 0
     1033       then do:
     1034         return error "Не указан fact-order" .
     1035       end.
     1036       assign
     1037        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1038       .
     1039       if v-fact-order-trunc < 0.5 then do:
     1040         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1041       end.
     1042       assign
     1043         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1044         .
     1045        assign
     1046         p-shift-num = truncate (p-shift-numd , 0)
     1047       .
     1048     end.
     1049   end procedure.
     1050   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1051   define variable v-task-num   as integer   no-undo.
     1052   define variable v-param-list as character no-undo.
     1053   define variable v-param-type as character no-undo.
     1054   define variable v-obj-list   as character no-undo.
     1055   define variable v-oss-list   as character no-undo.
     1056   define variable v-gds-list   as character no-undo.
     1057   define variable v-ii1        as integer   no-undo.
     1058   define variable v-ii2        as integer   no-undo.
     1059   define variable vRadio-set-1 as integer   no-undo.
     1060   define variable vRadio-set-2 as integer   no-undo.
     1061   define variable vRadio-set-3 as integer   no-undo.
     1062   define variable num-days     as integer   no-undo.
     1063   define buffer buf_tt-obj        for tt-obj.
     1064   define buffer buf_tt-oss-ref    for tt-oss-ref.
     1065   define buffer buf_tt-gds-list   for tt-gds-list.
     1066   define buffer buf_schedule      for ub.schedule.
     1067   define buffer buf_schedule-attr for ub.schedule-attr.
     1068   define variable v-folder   as character no-undo .
     1069   define variable v-file     as character no-undo .
     1070   define variable v-par-val  as character no-undo .
     1071   define variable v-par-type as character no-undo .
     1072   do
     1073     on error undo, return error
     1074     :
     1075     if p-task-num > 0
     1076       then
     1077     do:
     1078       v-task-num = p-task-num.
     1079     end.
     1080     else
     1081     do:
     1082       for each buf_schedule
     1083         where buf_schedule.task-type     = p-task-type
     1084         AND buf_schedule.cre-db-num    = INTEGER(p-db-num-char)
     1085         no-lock
     1086         ,
     1087         first buf_schedule-attr
     1088         where buf_schedule-attr.task-type   = p-task-type
     1089         AND buf_schedule-attr.cre-db-num  = INTEGER(p-db-num-char)
     1090         AND buf_schedule-attr.task-num    = buf_schedule.task-num
     1091         AND buf_schedule-attr.attr-code   = ('schd-free-id':U + chr(4) + 'help-road')
     1092         no-lock
     1093         :
     1094         ASSIGN
     1095           v-task-num = buf_schedule.task-num
     1096           .
     1097         leave .
     1098       end.
     1099     end.
     1100     if v-task-num > 0
     1101       then
     1102     do:
     1103       run schedule-attr-value in this-procedure  ( input p-db-num-char
     1104         , input p-task-type
     1105         , input v-task-num
     1106         , input 'schedule-param-list':U
     1107         , output v-param-list
     1108         , output v-param-type
     1109         ) NO-ERROR .
     1110     end.
     1111     v-ii2 = num-entries( v-param-list, chr(4) ).
     1112     if v-ii2 < 7 THEN
     1113     do:
     1114       do v-ii1 = v-ii2 to 7:
     1115         v-param-list = v-param-list
     1116           + '':U
     1117           + chr(4).
     1118       end.
     1119     end.
     1120     ASSIGN
     1121       v-folder     = ENTRY(1, v-param-list, chr(4))
     1122       v-file       = ENTRY(2, v-param-list, chr(4))
     1123       vRadio-set-1 = INTEGER( ENTRY(3, v-param-list, chr(4)) )
     1124       vRadio-set-2 = INTEGER( ENTRY(4, v-param-list, chr(4)) )
     1125       vRadio-set-3 = INTEGER( ENTRY(5, v-param-list, chr(4)) )
     1126       num-days     = INTEGER( ENTRY(6, v-param-list, chr(4)) )
     1127       .
     1128     EMPTY TEMP-TABLE buf_tt-obj.
     1129     if v-task-num > 0 then
     1130       run schedule-attr-value in this-procedure  ( input p-db-num-char
     1131         , input p-task-type
     1132         , input v-task-num
     1133         , input 'schedule-obj-list':U
     1134         , output v-obj-list
     1135         , output v-param-type
     1136         ) NO-ERROR .
     1137     define variable ii      as integer   no-undo.
     1138     define variable v-entry as character no-undo .
     1139     do ii = 1 to num-entries(v-obj-list, chr(4))
     1140       on error undo, next
     1141       :
     1142       assign
     1143         v-entry = entry(ii, v-obj-list, chr(4))
     1144         .
     1145       FIND FIRST ub.clients
     1146         WHERE ub.clients.obj-type = ENTRY(1, v-entry, chr(44))
     1147         AND ub.clients.obj-code = INTEGER(ENTRY(2, v-entry, chr(44)))
     1148         NO-LOCK
     1149         NO-ERROR
     1150         .
     1151       IF AVAILABLE ub.clients
     1152         THEN
     1153       DO:
     1154         create tt-obj.
     1155         ASSIGN
     1156           tt-obj.obj-code  = ub.clients.obj-code
     1157           tt-obj.obj-type  = ub.clients.obj-type
     1158           tt-obj.obj-name  = ub.clients.obj-name
     1159           tt-obj.host-code = ub.clients.host-code
     1160           .
     1161       END.
     1162     end.
     1163     EMPTY TEMP-TABLE buf_tt-oss-ref.
     1164     if v-task-num > 0 then
     1165       run schedule-attr-value in this-procedure  ( input p-db-num-char
     1166         , input p-task-type
     1167         , input v-task-num
     1168         , input 'schedule-oss-list':U
     1169         , output v-oss-list
     1170         , output v-param-type
     1171         ) NO-ERROR .
     1172     define variable ii-oss      as integer   no-undo.
     1173     define variable v-entry-oss as character no-undo .
     1174     do ii-oss = 1 to num-entries(v-oss-list, chr(4))
     1175       on error undo, next
     1176       :
     1177       assign
     1178         v-entry-oss = entry(ii-oss, v-oss-list, chr(4))
     1179         .
     1180       Find first ub.OperServ
     1181         WHERE ub.OperServ.id = INTEGER(ENTRY(1, v-entry-oss, chr(44)))
     1182         NO-LOCK no-error .
     1183       if available (ub.OperServ) then
     1184       do:
     1185         CREATE tt-oss-ref.
     1186         buffer-copy ub.OperServ to tt-oss-ref .
     1187       END.
     1188     end.
     1189     EMPTY TEMP-TABLE buf_tt-gds-list.
     1190     if v-task-num > 0 then
     1191       run schedule-attr-value in this-procedure  ( input p-db-num-char
     1192         , input p-task-type
     1193         , input v-task-num
     1194         , input 'schedule-gds-list':U
     1195         , output v-gds-list
     1196         , output v-param-type
     1197         ) NO-ERROR .
     1198     define variable ii-gds      as integer   no-undo.
     1199     define variable v-entry-gds as character no-undo .
     1200     do ii-gds = 1 to num-entries(v-gds-list, chr(4))
     1201       on error undo, next
     1202       :
     1203       assign
     1204         v-entry-gds = entry(ii-gds, v-gds-list, chr(4))
     1205         .
     1206       find first ub.goods-attr no-lock
     1207         where ub.goods-attr.attr-code  = 'oper-serv-idd':U
     1208         and ub.goods-attr.gds-code = INTEGER(ENTRY(1, v-entry-gds, chr(44)))
     1209         no-error .
     1210       if available (ub.goods-attr) then
     1211       do:
     1212         find first ub.goods no-lock where ub.goods-attr.gds-code = ub.goods.gds-code no-error .
     1213         if available (ub.goods) then
     1214         do:
     1215           CREATE tt-gds-list.
     1216           ASSIGN
     1217             tt-gds-list.artic     = ub.goods.artic
     1218             tt-gds-list.gds-code  = ub.goods.gds-code
     1219             tt-gds-list.gds-name  = ub.goods.gds-name
     1220             tt-gds-list.prod-code = ub.goods.prod-code
     1221             tt-gds-list.prod-type = ub.goods.prod-type
     1222             .
     1223         end.
     1224       end.
     1225     end.
     1226     run rep/r-help-road.p ( INPUT num-days
     1227       , INPUT v-folder
     1228       , INPUT v-file
     1229       , INPUT ?
     1230       , INPUT ?
     1231       , INPUT ""
     1232       , INPUT ""
     1233       , INPUT p-log-handle
     1234       , INPUT TABLE tt-obj
     1235       , INPUT TABLE tt-oss-ref
     1236       , INPUT TABLE tt-gds-list
     1237       ) .
     1238   end.
