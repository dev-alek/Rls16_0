        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as handle no-undo .
        3   DEFINE VARIABLE p-curr-host-code like ub.sysconf.host-code NO-UNDO.
        4   DEFINE VARIABLE p-curr-obj-type  like ub.clients.obj-type NO-UNDO.
        5   DEFINE VARIABLE p-curr-obj-code  like ub.clients.obj-code NO-UNDO.
        6   DEFINE VARIABLE p-mode           AS CHARACTER NO-UNDO.
        7   DEFINE VARIABLE p-db-num-char    AS CHARACTER NO-UNDO.
        8   DEFINE VARIABLE p-task-type      AS CHARACTER NO-UNDO.
        9   DEFINE VARIABLE p-task-num       AS INTEGER NO-UNDO.
       10   DEFINE VARIABLE p-action         AS CHARACTER NO-UNDO.
       11   DEFINE VARIABLE p-cancel         AS LOGICAL NO-UNDO.
       12   DEFINE VARIABLE p-params         AS CHARACTER NO-UNDO.
       13   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       14     define variable v-cntxt-db-num        as integer   no-undo .
       15     define variable v-cntxt-userid        as character no-undo .
       16     define variable v-cntxt-level         as character no-undo .
       17     define variable v-cntxt-host-code-obj as integer   no-undo .
       18     define variable v-cntxt-obj-type      as character no-undo .
       19     define variable v-cntxt-obj-code      as integer   no-undo .
       20     define variable v-cntxt-db-num-obj    as integer   no-undo .
       21     define variable v-cntxt-is-admin      as logical   no-undo .
       22   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       23     run mainmenu_getcntxt in parparentproc
       24       (output v-cntxt-db-num
       25       ,output v-cntxt-userid
       26       ,output v-cntxt-level
       27       ,output v-cntxt-host-code-obj
       28       ,output v-cntxt-obj-type
       29       ,output v-cntxt-obj-code
       30       ,output v-cntxt-db-num-obj
       31       ,output v-cntxt-is-admin
       32       ) .
       33       assign
       34           p-curr-host-code  = v-cntxt-host-code-obj
       35           p-curr-obj-type = v-cntxt-obj-type
       36           p-curr-obj-code = v-cntxt-obj-code
       37       .
       38   run bge/bge-active-vbrr.w ( parparentproc
       39                 , p-curr-host-code
       40                 , p-curr-obj-type
       41                 , p-curr-obj-code
       42                 , 'run'
       43                 , p-db-num-char
       44                 , p-task-type
       45                 , p-task-num
       46                 , p-action
       47                 , OUTPUT p-cancel
       48                 , OUTPUT p-params ) .
