       97   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   DEFINE SHARED TEMP-TABLE treal-2 no-undo
       99   FIELD gds-code as integer
      100   FIELD cpay-code as integer
      101   FIELD curr-code as integer
      102   FIELD qnty1 as decimal
      103   FIELD qnty2 as decimal
      104   FIELD netto as decimal
      105   FIELD out-name as character format "X(18)"
      106   FIELD is-pay as logical
      107   FIELD ii as integer
      108   FIELD pay-desk as integer
      109   FIELD prefix as character
      110   FIELD netto-rubl as decimal
