      172   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      173   DEFINE VARIABLE v-line-num as integer no-undo .
      174   define variable v-curr-r-b as character no-undo .
      175   define variable v-base-code like ub.sysconf.base-code no-undo .
      176   define buffer buf_Inkas for ub.inkas.
      177   define buffer buf_chk-gds-pay for ub.chk-gds-pay.
      178   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      179   define variable v-pay-desk as integer   no-undo .
      180   define variable v-pay-card as character no-undo .
      181   define variable v-doc-code as character no-undo .
      182   define variable v-doc-code-r as character no-undo .
      183   define variable v-doc-code-v as character no-undo .
      184   define variable v-density as decimal no-undo .
      185   DEFINE BUFFER b-treal-2 for treal-2.
      186   DEFINE BUFFER b-treal-3 for treal-3.
      187   DEFINE BUFFER b-treal-4 for treal-4.
      188   DEFINE BUFFER b2-treal-2 for treal-2.
      189   DEFINE BUFFER b2-treal-3 for treal-3.
      190   DEFINE BUFFER b2-treal-4 for treal-4.
      191   DEFINE BUFFER b3-treal-2 for treal-2.
      192   DEFINE BUFFER b3-treal-3 for treal-3.
      193   DEFINE BUFFER b3-treal-4 for treal-4.
      194   define buffer buf_temp-cpa-pcep for temp-cpa-pcep.
      195   define buffer buf_bar-code for ub.bar-code.
      196   define buffer buf_cash-pay for ub.cash-pay.
      197   define buffer buf_doc-line for ub.doc-line.
      198   define buffer buf_goods for ub.goods.
      199   define buffer ras-doc for ub.trn-doc.
      200   define buffer ret-doc for ub.trn-doc.
      201   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      202   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      203     (output v-curr-r-b
      204     )  .
      205   do
      206   on error undo, return error
      207   :
      208     find first buf_inkas no-lock where
      209                buf_inkas.inkas-code = p-inkas-code.
      210   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      211   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      212     (input  buf_inkas.host-code
      213     ,output v-base-code
      214     )  .
      215     for each treal-2:
      216       delete treal-2.
      217     end.
      218     for each treal-3:
      219       delete treal-3.
      220     end.
      221     for each treal-4:
      222       delete treal-4.
      223     end.
      224     run rep/rpychk0.p ( input "bgepych2"
      225                         ,input buf_inkas.obj-type
      226                         ,input buf_inkas.obj-code
      227                         ,input ?
      228                         ,input ?
      229                         ,input ?
      230                         ,input ?
      231                         ,input ?
      232                         ,input ?
      233                         ,input buf_inkas.inkas-code
      234                         ) no-error.
      235     if error-status:error then
      236       return error return-value.
      237    _chk-doc:
      238    FOR EACH ub.chk-doc No-LOCK WHERE
      239             ub.chk-doc.obj-type = buf_inkas.obj-type AND
      240             ub.chk-doc.obj-code = buf_inkas.obj-code AND
      241             ub.chk-doc.out-code = p-inkas-code:
      242       case p-ext-doc-type:
      243         when 'es':U then do:
      244           if ub.chk-doc.netto < 0 then do:
      245             NEXT _chk-doc.
      246           end.
      247         end.
      248         when 'rs':U then do:
      249           if ub.chk-doc.netto >= 0 then do:
      250             NEXT _chk-doc.
      251           end.
      252         end.
      253         when "":U then do:
      254         end.
      255       END CASE.
      256       if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
      257       if p-by-pay-desk then do:
      258         assign
      259         v-pay-desk = ub.chk-doc.pay-desk
      260         .
      261       end.
      262       else do:
      263         assign
      264         v-pay-desk = 0
      265         .
      266       end.
      267       for each buf_chk-gds-pay no-lock where
      268               buf_chk-gds-pay.doc-code = ub.chk-doc.doc-code
      269           and buf_chk-gds-pay.algo-num = "1.8",
      270           first buf_bar-code no-lock where
      271               buf_bar-code.b-code = buf_chk-gds-pay.b-code,
      272           first buf_cash-pay no-lock where
      273               buf_cash-pay.cdpay-code = buf_chk-gds-pay.pay-code
      274           and buf_cash-pay.curr-code = buf_chk-gds-pay.curr-code:
      275         if p-by-pay-card-prefix  then do:
      276           find first buf_temp-cpa-pcep no-lock where
      277                     buf_temp-cpa-pcep.cdpay-code = buf_chk-gds-pay.pay-code
      278                 AND buf_temp-cpa-pcep.curr-code = buf_chk-gds-pay.curr-code
      279                 AND buf_chk-gds-pay.pay-card begins buf_temp-cpa-pcep.prefix no-error .
      280           if available buf_temp-cpa-pcep then
      281           assign
      282           v-pay-card = buf_temp-cpa-pcep.prefix
      283           .
      284           else
      285           assign
      286           v-pay-card = 'other':U
      287           .
      288         end.
      289         else do:
      290           assign
      291           v-pay-card = '':U
      292           .
      293         end.
      294   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      295   CASE entry(1, buf_chk-gds-pay.line-type, chr(4)):
      296     WHEN 'топ':U  then do:
      297       if p-petrol then do:
      298         if ub.chk-doc.netto < 0 then do:
      299           if v-doc-code-r <> ub.chk-doc.out-code
      300           then do:
      301             find first ras-doc no-lock
      302               where ras-doc.doc-code = ub.chk-doc.out-code
      303               no-error .
      304             if not available ras-doc then do:
      305               message
      306               substitute("Отсутствует документ расхода по чеку &1"
      307                           , ub.chk-doc.doc-code
      308                           )   skip
      309               "ЭКСПОРТ НЕ МОЖЕТ БЫТЬ ОСУЩЕСТВЛЕН" SKIP
      310               view-as alert-box error .
      311               return error .
      312             end.
      313             v-doc-code-r = ras-doc.doc-code.
      314             find first ret-doc no-lock where
      315                       ret-doc.doc-code = ras-doc.out-code no-error .
      316             if not available ret-doc then do:
      317               message
      318               substitute("Отсутствует документ возврата по чеку &1"
      319                         , ub.chk-doc.doc-code
      320                         )   skip
      321               "ЭКСПОРТ НЕ МОЖЕТ БЫТЬ ОСУЩЕСТВЛЕН" SKIP
      322               view-as alert-box error .
      323               return error .
      324             end.
      325             v-doc-code-v = ret-doc.doc-code.
      326           end.
      327           assign
      328           v-doc-code = v-doc-code-v
      329           .
      330         end.
      331         else do:
      332           assign
      333           v-doc-code = ub.chk-doc.out-code
      334           .
      335         end.
      336         if p-by-pay-card-prefix
      337         and v-pay-card <> "other"
      338         then do:
      339           FIND FIRST b2-treal-2 No-LOCK WHERE
      340                     b2-treal-2.gds-code = buf_bar-code.gds-code
      341                 AND b2-treal-2.cpay-code = buf_chk-gds-pay.pay-code
      342                 AND b2-treal-2.curr-code = buf_chk-gds-pay.curr-code
      343                 AND b2-treal-2.is-pay = yes
      344                 AND b2-treal-2.pay-desk = v-pay-desk
      345                 AND b2-treal-2.prefix = v-pay-card  No-ERROR.
      346           IF NOT AVAIL  b2-treal-2 then do:
      347             FIND last b3-treal-2 No-LOCK WHERE
      348                       b3-treal-2.gds-code = buf_bar-code.gds-code use-index vi No-ERROR.
      349             create b2-treal-2.
      350             assign
      351             b2-treal-2.gds-code = buf_bar-code.gds-code
      352             b2-treal-2.cpay-code = buf_chk-gds-pay.pay-code
      353             b2-treal-2.curr-code = buf_chk-gds-pay.curr-code
      354             b2-treal-2.out-name = buf_cash-pay.obj-name
      355             b2-treal-2.is-pay = yes
      356             b2-treal-2.ii = (if avail b3-treal-2
      357                           then b3-treal-2.ii + 1
      358                           else 1)
      359             b2-treal-2.pay-desk = v-pay-desk
      360             b2-treal-2.prefix   = v-pay-card
      361             .
      362           END.
      363           find first buf_goods  no-lock where
      364                     buf_goods.gds-code  = buf_bar-code.gds-code .
      365           find first buf_doc-line no-lock where
      366                     buf_doc-line.doc-code  = v-doc-code
      367                 and buf_doc-line.artic     = buf_goods.artic
      368                 and buf_doc-line.prod-type = buf_goods.prod-type
      369                 and buf_doc-line.prod-code = buf_goods.prod-code  no-error.
      370           assign
      371           v-density = ( if available buf_doc-line
      372                             then buf_doc-line.fact-density
      373                             else 0 ).
      374           assign
      375           b2-treal-2.netto = b2-treal-2.netto +
      376                                           (if v-curr-r-b = 'base':U
      377                                           or v-base-code = 0
      378                                           then buf_chk-gds-pay.tot-r-b
      379                                           else (buf_chk-gds-pay.tot-r-b / buf_chk-gds-pay.eff-base-rate))
      380           b2-treal-2.qnty1 = b2-treal-2.qnty1 + buf_chk-gds-pay.eff-doc-qnty
      381           b2-treal-2.qnty2 = b2-treal-2.qnty2 + buf_chk-gds-pay.eff-doc-qnty * v-density
      382           b2-treal-2.netto-rubl = b2-treal-2.netto-rubl +
      383                                           (if v-curr-r-b = 'rubl':U
      384                                           or v-base-code = 0
      385                                           then buf_chk-gds-pay.tot-r-b
      386                                           else (buf_chk-gds-pay.tot-r-b * buf_chk-gds-pay.eff-base-rate))
      387           .
      388         end.
      389         FIND FIRST treal-2 No-LOCK WHERE
      390                   treal-2.gds-code = buf_bar-code.gds-code
      391               AND  treal-2.cpay-code = buf_chk-gds-pay.pay-code
      392               AND  treal-2.curr-code = buf_chk-gds-pay.curr-code
      393               AND  treal-2.is-pay = yes
      394               AND treal-2.pay-desk = v-pay-desk
      395               AND treal-2.prefix = '':U  No-ERROR.
      396         IF NOT AVAIL treal-2 then do:
      397           FIND last b-treal-2 No-LOCK WHERE
      398                     b-treal-2.gds-code = buf_bar-code.gds-code use-index vi No-ERROR.
      399             create treal-2.
      400             assign
      401             treal-2.gds-code = buf_bar-code.gds-code
      402             treal-2.cpay-code = buf_chk-gds-pay.pay-code
      403             treal-2.curr-code = buf_chk-gds-pay.curr-code
      404             treal-2.out-name = buf_cash-pay.obj-name
      405             treal-2.is-pay = yes
      406             treal-2.ii = (if avail b-treal-2
      407                           then b-treal-2.ii + 1
      408                           else 1)
      409             treal-2.pay-desk = v-pay-desk
      410             treal-2.prefix   = '':U
      411             .
      412         END.
      413         assign
      414         treal-2.netto = treal-2.netto + (if v-curr-r-b = 'base':U
      415                                           or v-base-code = 0
      416                                           then buf_chk-gds-pay.tot-r-b
      417                                           else (buf_chk-gds-pay.tot-r-b / buf_chk-gds-pay.eff-base-rate))
      418         treal-2.qnty1 = treal-2.qnty1 + buf_chk-gds-pay.eff-doc-qnty
      419         treal-2.qnty2 = treal-2.qnty2 + buf_chk-gds-pay.eff-doc-qnty * v-density
      420         treal-2.netto-rubl = treal-2.netto-rubl + (if v-curr-r-b = 'rubl':U
      421                                           or v-base-code = 0
      422                                           then buf_chk-gds-pay.tot-r-b
      423                                           else (buf_chk-gds-pay.tot-r-b * buf_chk-gds-pay.eff-base-rate))
      424         .
      425       end.
      426     end.
      427     WHEN 'т':U  then do:
      428       if p-goods then do:
      429         if p-by-pay-card-prefix
      430         and v-pay-card <> "other"
      431         then do:
      432           FIND FIRST b2-treal-3 No-LOCK WHERE
      433                     b2-treal-3.gds-code = buf_bar-code.gds-code
      434                 AND b2-treal-3.cpay-code = buf_chk-gds-pay.pay-code
      435                 AND b2-treal-3.curr-code = buf_chk-gds-pay.curr-code
      436                 AND b2-treal-3.pay-desk = v-pay-desk
      437                 AND b2-treal-3.prefix = v-pay-card No-ERROR.
      438           IF NOT AVAIL b2-treal-3 then do:
      439             FIND last b3-treal-3 No-LOCK WHERE
      440                       b3-treal-3.gds-code = buf_bar-code.gds-code use-index vi No-ERROR.
      441             create b2-treal-3.
      442             assign
      443             b2-treal-3.gds-code = buf_bar-code.gds-code
      444             b2-treal-3.cpay-code = buf_chk-gds-pay.pay-code
      445             b2-treal-3.curr-code = buf_chk-gds-pay.curr-code
      446             b2-treal-3.qnty1  =  0
      447             b2-treal-3.netto = 0
      448             b2-treal-3.out-name = buf_cash-pay.obj-name
      449             b2-treal-3.is-pay = yes
      450             b2-treal-3.ii =  (if avail b3-treal-3
      451                               then b3-treal-3.ii + 1
      452                               else 1)
      453             b2-treal-3.pay-desk = v-pay-desk
      454             b2-treal-3.prefix   = v-pay-card
      455             .
      456           END.
      457           assign
      458           b2-treal-3.netto = b2-treal-3.netto + (if v-curr-r-b = 'base':U
      459                                                 or v-base-code = 0
      460                                                 then buf_chk-gds-pay.tot-r-b
      461                                                 else (buf_chk-gds-pay.tot-r-b / buf_chk-gds-pay.eff-base-rate))
      462           b2-treal-3.qnty1 = b2-treal-3.qnty1 + buf_chk-gds-pay.eff-doc-qnty
      463           b2-treal-3.netto-rubl = b2-treal-3.netto-rubl + (if v-curr-r-b = 'rubl':U
      464                                                             or v-base-code = 0
      465                                                             then buf_chk-gds-pay.tot-r-b
      466                                                             else (buf_chk-gds-pay.tot-r-b * buf_chk-gds-pay.eff-base-rate))
      467           .
      468         end.
      469         FIND FIRST treal-3 No-LOCK WHERE
      470                   treal-3.gds-code = buf_bar-code.gds-code
      471               AND treal-3.cpay-code = buf_chk-gds-pay.pay-code
      472               AND treal-3.curr-code = buf_chk-gds-pay.curr-code
      473               AND treal-3.pay-desk = v-pay-desk
      474               AND treal-3.prefix = '':U No-ERROR.
      475         IF NOT AVAIL treal-3 then do:
      476           FIND last b-treal-3 No-LOCK WHERE
      477                     b-treal-3.gds-code = buf_bar-code.gds-code use-index vi No-ERROR.
      478             create treal-3.
      479             assign
      480             treal-3.gds-code = buf_bar-code.gds-code
      481             treal-3.cpay-code = buf_chk-gds-pay.pay-code
      482             treal-3.curr-code = buf_chk-gds-pay.curr-code
      483             treal-3.qnty1  =  0
      484             treal-3.netto = 0
      485             treal-3.out-name = buf_cash-pay.obj-name
      486             treal-3.is-pay = yes
      487             treal-3.ii =  (if avail b-treal-3
      488                               then b-treal-3.ii + 1
      489                               else 1)
      490             treal-3.pay-desk = v-pay-desk
      491             treal-3.prefix   = '':U
      492             .
      493         END.
      494         assign
      495         treal-3.netto = treal-3.netto + (if v-curr-r-b = 'base':U
      496                                         or v-base-code = 0
      497                                         then buf_chk-gds-pay.tot-r-b
      498                                         else (buf_chk-gds-pay.tot-r-b / buf_chk-gds-pay.eff-base-rate))
      499         treal-3.qnty1 = treal-3.qnty1 + buf_chk-gds-pay.eff-doc-qnty
      500         treal-3.netto-rubl = treal-3.netto-rubl + (if v-curr-r-b = 'rubl':U
      501                                                   or v-base-code = 0
      502                                                   then buf_chk-gds-pay.tot-r-b
      503                                                   else (buf_chk-gds-pay.tot-r-b * buf_chk-gds-pay.eff-base-rate))
      504         .
      505       END.
      506     END.
      507     WHEN 'у':U then do:
      508       if p-services then do:
      509         if p-by-pay-card-prefix
      510         and v-pay-card <> "other"
      511         then do:
      512           FIND FIRST b2-treal-4 No-LOCK WHERE
      513                     b2-treal-4.gds-code = buf_bar-code.gds-code
      514                 AND b2-treal-4.cpay-code = buf_chk-gds-pay.pay-code
      515                 AND b2-treal-4.curr-code = buf_chk-gds-pay.curr-code
      516                 AND b2-treal-4.is-pay = yes
      517                 AND b2-treal-4.pay-desk = v-pay-desk
      518                 AND b2-treal-4.prefix = v-pay-card No-ERROR.
      519           IF NOT AVAIL b2-treal-4 then do:
      520             FIND last b3-treal-4 No-LOCK WHERE
      521                       b3-treal-4.gds-code = buf_bar-code.gds-code use-index vi No-ERROR.
      522             create b2-treal-4.
      523             assign
      524             b2-treal-4.gds-code = buf_bar-code.gds-code
      525             b2-treal-4.cpay-code = buf_chk-gds-pay.pay-code
      526             b2-treal-4.curr-code = buf_chk-gds-pay.curr-code
      527             b2-treal-4.qnty1  =  0
      528             b2-treal-4.netto = 0
      529             b2-treal-4.out-name = buf_Cash-pay.obj-name
      530             b2-treal-4.is-pay = yes
      531             b2-treal-4.ii = (if avail b3-treal-4
      532                             then b3-treal-4.ii + 1
      533                             else 1)
      534             b2-treal-4.pay-desk = v-pay-desk
      535             b2-treal-4.prefix   = v-pay-card
      536             .
      537           END.
      538           assign
      539           b2-treal-4.netto = b2-treal-4.netto + (if v-curr-r-b = 'base':U
      540                                                 or v-base-code = 0
      541                                                 then buf_chk-gds-pay.tot-r-b
      542                                                 else (buf_chk-gds-pay.tot-r-b / buf_chk-gds-pay.eff-base-rate))
      543           b2-treal-4.qnty1 = b2-treal-4.qnty1 + buf_chk-gds-pay.eff-doc-qnty
      544           b2-treal-4.netto-rubl = b2-treal-4.netto-rubl + (if v-curr-r-b = 'rubl':U
      545                                                   or v-base-code = 0
      546                                                   then buf_chk-gds-pay.tot-r-b
      547                                                   else (buf_chk-gds-pay.tot-r-b * buf_chk-gds-pay.eff-base-rate))
      548           .
      549         end.
      550         fIND FIRST treal-4 No-LOCK WHERE
      551                   treal-4.gds-code = buf_bar-code.gds-code
      552               AND treal-4.cpay-code = buf_chk-gds-pay.pay-code
      553               AND treal-4.curr-code = buf_chk-gds-pay.curr-code
      554               AND treal-4.is-pay = yes
      555               AND treal-4.pay-desk = v-pay-desk
      556               AND treal-4.prefix = '':U  No-ERROR.
      557         IF NOT AVAIL treal-4 then do:
      558           FIND last b-treal-4 No-LOCK WHERE
      559                     b-treal-4.gds-code = buf_bar-code.gds-code use-index vi No-ERROR.
      560           create treal-4.
      561           assign
      562           treal-4.gds-code = buf_bar-code.gds-code
      563           treal-4.cpay-code = buf_chk-gds-pay.pay-code
      564           treal-4.curr-code = buf_chk-gds-pay.curr-code
      565           treal-4.qnty1  =  0
      566           treal-4.netto = 0
      567           treal-4.out-name = buf_Cash-pay.obj-name
      568           treal-4.is-pay = yes
      569           treal-4.ii = (if avail b-treal-4
      570                           then b-treal-4.ii + 1
      571                           else 1)
      572           treal-4.pay-desk = v-pay-desk
      573           treal-4.prefix   = '':U
      574           .
      575         END.
      576         assign
      577         treal-4.netto = treal-4.netto + (if v-curr-r-b = 'base':U
      578                                         or v-base-code = 0
      579                                         then buf_chk-gds-pay.tot-r-b
      580                                         else (buf_chk-gds-pay.tot-r-b / buf_chk-gds-pay.eff-base-rate))
      581         treal-4.qnty1 = treal-4.qnty1 + buf_chk-gds-pay.eff-doc-qnty
      582         treal-4.netto-rubl = treal-4.netto-rubl + (if v-curr-r-b = 'rubl':U
      583                                                   or v-base-code = 0
      584                                                   then buf_chk-gds-pay.tot-r-b
      585                                                   else (buf_chk-gds-pay.tot-r-b * buf_chk-gds-pay.eff-base-rate))
      586         .
      587       END.
      588     END.
      589   END CASE.
      590       end.
      591   end.
      592   end.
