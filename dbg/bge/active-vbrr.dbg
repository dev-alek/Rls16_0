        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: $":U .
        3   define variable vss-author      as character no-undo init "$Author: EShklyar $ SShalanin":U .
        4   define variable vss-date        as character no-undo init "$Date: Fri Oct 18 11:02:52 2019 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: active-vbrr.p $ active-vbrr.p ":U .
        6   define variable vss-archive     as character no-undo init "$Archive: bge/active-vbrr.p $ bge/active-vbrr.p ":U .
        7   define variable vss-description as character no-undo init "Процедура выгрузки информации по пополнениям и активации для сверки с ВБРР".
        8   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define  temp-table temp-host no-undo
       80     field host-code like ub.store.host-code
       81     index xpk host-code
       82   .
       83   define  temp-table temp-obj no-undo
       84     field obj-type  like ub.clients.obj-type
       85     field obj-code  like ub.clients.obj-code
       86     field host-code like ub.store.host-code
       87     field db-num    like ub.clients.db-num
       88     index xpk  obj-type obj-code
       89     index xie1 host-code
       90     index xie2 db-num host-code
       91   .
       92   procedure init-temphost:
       93     define buffer buf_store   for ub.store .
       94     define buffer buf_shop    for ub.shop .
       95     define buffer buf_clients for ub.clients .
       96     define buffer buf_db for ub.db .
       97     define buffer buf_temp-host for temp-host .
       98     define buffer buf_temp-obj for temp-obj .
       99     do
      100     on error undo, return error return-value
      101     :
      102       for each buf_store
      103       on error undo, return error
      104       :
      105         find first buf_temp-host
      106           where buf_temp-host.host-code = buf_store.host-code
      107           no-error .
      108         if not available buf_temp-host
      109         then do:
      110           create buf_temp-host .
      111           assign
      112             buf_temp-host.host-code = buf_store.host-code
      113           .
      114         end.
      115         find first buf_clients no-lock
      116           where buf_clients.obj-type = 'скл':U
      117             and buf_clients.obj-code = buf_store.obj-code
      118           no-error .
      119         if not available buf_clients
      120         then do:
      121           message
      122             "Ошибка при поиске клиента" skip
      123             "Клиент" 'скл':U buf_store.obj-code skip
      124             view-as alert-box error .
      125           undo, return error .
      126         end.
      127         create buf_temp-obj .
      128         assign
      129           buf_temp-obj.obj-type  = 'скл':U
      130           buf_temp-obj.obj-code  = buf_store.obj-code
      131           buf_temp-obj.host-code = buf_store.host-code
      132           buf_temp-obj.db-num    = buf_clients.db-num
      133         .
      134       end.
      135       for each buf_shop
      136       on error undo, return error
      137       :
      138         find first buf_temp-host
      139           where buf_temp-host.host-code = buf_shop.host-code
      140           no-error .
      141         if not available buf_temp-host
      142         then do:
      143           create buf_temp-host .
      144           assign
      145             buf_temp-host.host-code = buf_shop.host-code
      146           .
      147         end.
      148         find first buf_clients no-lock
      149           where buf_clients.obj-type = 'маг':U
      150             and buf_clients.obj-code = buf_shop.obj-code
      151           no-error .
      152         if not available buf_clients then do:
      153           message
      154             "Ошибка при поиске клиента" skip
      155             "Клиент" 'маг':U buf_shop.obj-code skip
      156             view-as alert-box error .
      157           undo, return error .
      158         end.
      159         create buf_temp-obj .
      160         assign
      161           buf_temp-obj.obj-type  = 'маг':U
      162           buf_temp-obj.obj-code  = buf_shop.obj-code
      163           buf_temp-obj.host-code = buf_shop.host-code
      164           buf_temp-obj.db-num    = buf_clients.db-num
      165         .
      166       end.
      167     end.
      168   end.
      169   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      170     define variable v-cntxt-db-num        as integer   no-undo .
      171     define variable v-cntxt-userid        as character no-undo .
      172     define variable v-cntxt-level         as character no-undo .
      173     define variable v-cntxt-host-code-obj as integer   no-undo .
      174     define variable v-cntxt-obj-type      as character no-undo .
      175     define variable v-cntxt-obj-code      as integer   no-undo .
      176     define variable v-cntxt-db-num-obj    as integer   no-undo .
      177     define variable v-cntxt-is-admin      as logical   no-undo .
      178   DEFINE INPUT PARAMETER p-log-handle AS HANDLE NO-UNDO.
      179   define input parameter v-obj-range   as integer   no-undo .
      180   define input parameter v-host-code   like ub.sysconf.host-code no-undo .
      181   define input parameter v-obj-list as character no-undo.
      182   define input parameter date-to as date no-undo.
      183   define input parameter date-from as date no-undo.
      184   define input parameter v-gds-code-inf as integer no-undo.
      185   define input parameter v-gds-code-active as integer no-undo.
      186   define input parameter p-directory as char no-undo.
      187   define input parameter v-code_pnpo as char no-undo.
      188   define input parameter v-active as logical no-undo.
      189   define input parameter v-inf-po as logical no-undo.
      190   define input parameter p-per as integer no-undo.
      191   define variable v-ul-day as integer no-undo.
      192   define stream f2.
      193   define stream f1.
      194   define variable file_name-inf    as char    no-undo.
      195   define variable file_name-active as char    no-undo.
      196   define variable b-code-inf       as integer no-undo.
      197   define variable b-code-active    as integer no-undo.
      198   define variable v-time           as char    no-undo.
      199   define buffer buf_goods for goods.
      200   define variable v-code-get    as integer no-undo.
      201   define variable v-obj-counter as integer no-undo.
      202   define variable v-obj-type    as character no-undo.
      203   define variable v-obj-code    as integer no-undo.
      204     for each temp-obj :
      205       delete temp-obj.
      206     end.
      207     case v-obj-range:
      208       when 2 then do:
      209         run init-temphost.
      210         for each temp-obj where temp-obj.host-code <> v-host-code :
      211           delete temp-obj.
      212         end.
      213       end.
      214       when 3 then do:
      215         do v-obj-counter = 1 to num-entries ( v-obj-list ) / 2 :
      216           assign
      217             v-obj-type =          entry( v-obj-counter * 2 - 1, v-obj-list )
      218             v-obj-code = integer( entry( v-obj-counter * 2    , v-obj-list ) )
      219           no-error .
      220           if error-status:error then next.
      221           find first temp-obj no-lock
      222                where temp-obj.obj-type = v-obj-type
      223                  and temp-obj.obj-code = v-obj-code no-error .
      224           if available temp-obj then next.
      225           create temp-obj.
      226           assign
      227             temp-obj.obj-type = v-obj-type
      228             temp-obj.obj-code = v-obj-code
      229           .
      230         end.
      231       end.
      232       otherwise do:
      233       end.
      234     end case.
      235   v-ul-day = -1 *  (INTERVAL(date( 1 , 1 , YEAR(TODAY)), today , 'days')) + 1  .
      236   if p-per <> 0 then
      237   do:
      238       assign
      239           date-from = today - p-per
      240           date-to   = today.
      241   end.
      242   if v-inf-po = yes then
      243   do:
      244       for first bar-code no-lock where bar-code.gds-code = v-gds-code-inf :
      245           b-code-inf = bar-code.b-code.
      246       end.
      247   end.
      248   if v-active then
      249   do:
      250       for first bar-code no-lock where bar-code.gds-code = v-gds-code-active :
      251           b-code-active = bar-code.b-code.
      252       end.
      253   end.
      254    for each temp-obj :
      255           run rep/rpychk0.p (input "r-autocu"
      256               ,input temp-obj.obj-type
      257               ,input temp-obj.obj-code
      258               ,input date-from
      259               ,input date-to
      260               ,input  ?
      261               ,input ?
      262               ,input ?
      263               ,input ?
      264               ,input ?
      265               ) no-error.
      266           if error-status:error then
      267           do:
      268               return error return-value  +
      269                   error-status:get-message(1) .
      270           end.
      271   end.
      272   define frame stav-active.
      273   v-time =  substring(string(time,"HH:MM"),1,2)  + substring(string(time,"HH:MM"),4,2).
      274   if v-inf-po = yes then
      275   do:
      276       file_name-inf = p-directory + "BPAPAY" + v-code_pnpo + "-" + v-time + "." +  string(v-ul-day) .
      277               output stream f1 to value(file_name-inf)   .
      278       for each temp-obj :
      279           for each chk-gds-pay where chk-gds-pay.chk-date >= date-from and chk-gds-pay.chk-date  <= date-to and chk-gds-pay.obj-type = temp-obj.obj-type and chk-gds-pay.obj-code = temp-obj.obj-code and chk-gds-pay.b-code =  b-code-inf no-lock  :
      280               put stream f1 unformatted
      281                   string(chk-gds-pay.chk-date,"99.99.9999") ";" string(chk-gds-pay.chk-time,"HH:MM:SS") ";" string(integer(chk-gds-pay.tot-r-b * 100)) .
      282               find first chk-pay  where chk-pay.doc-code = chk-gds-pay.doc-code no-lock no-error.
      283               find first chk-pay-attr  where attr-code = 'CPDOC' and chk-pay-attr.doc-code = chk-gds-pay.doc-code   no-lock no-error.
      284               if available chk-pay-attr then
      285               do:
      286                   put stream f1 unformatted
      287                       ";" chk-pay-attr.attr-value  ";" skip
      288                       .
      289               end.
      290               else
      291               do:
      292                   put stream f1 unformatted
      293                       ";" ";" skip
      294                       .
      295               end.
      296           end.
      297       end.
      298       output stream f1 close.
      299   end.
      300   if v-active = yes then
      301   do:
      302          file_name-active = p-directory + "BPAGSP" + v-code_pnpo +  v-time + "." +  string(v-ul-day) .
      303           output stream f2 to value(file_name-active).
      304       for each temp-obj :
      305           for each chk-gds-pay where chk-gds-pay.chk-date >= date-from and chk-gds-pay.chk-date  <= date-to and chk-gds-pay.obj-type = temp-obj.obj-type and chk-gds-pay.obj-code = temp-obj.obj-code and chk-gds-pay.b-code =  b-code-active no-lock  :
      306               find first chk-doc where chk-doc.doc-code = chk-gds-pay.doc-code no-lock no-error.
      307               put stream f2 unformatted
      308                   string(chk-gds-pay.chk-date,"99.99.9999") ";"  v-code_pnpo ";" string(chk-doc.doc-num) ";" "1"   skip
      309                   .
      310           end.
      311       end.
      312       output stream f2 close.
      313   end.
