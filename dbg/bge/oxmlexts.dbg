        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter p-mode               as integer          no-undo.
        4   define input parameter p-where-string       as character        no-undo.
        5   define input parameter p-in-selected-list   as character        no-undo.
        6   define output parameter p-out-selected-list as character        no-undo.
        7   define output parameter p-accepted          as logical          no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: oxmlexts.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: bge/oxmlexts.p $":U .
       13   define variable vss-description as character no-undo init "openXML. Выбор внешней системы".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define variable vss-include-info0 as character format "X(65)" no-undo
       75   initial "@(#)$Workfile$ $Revision$".
       76   define temp-table temp_onewin_items no-undo
       77       field itm-key       as integer
       78       field itmExtKey     as character
       79       field itmName       as character
       80       field itmDesc       as character
       81       field itmSelected   as logical
       82       index pi is primary unique
       83           itm-key
       84       index ie
       85           itmExtKey
       86   .
       87   define temp-table temp_onewin_itemsSelected no-undo
       88       field its-key   as integer
       89       field itm-key   as integer
       90       field itmExtKey as character
       91       index pi is primary unique
       92           its-key
       93       index im
       94           itm-key
       95   .
       96   define variable v-onewin0-itm-key    as integer      no-undo.
       97   procedure onewin_clear :
       98       define buffer buf_temp_onewin_items        for temp_onewin_items.
       99   do
      100   for buf_temp_onewin_items
      101   on error undo, return error
      102   :
      103       empty temp-table buf_temp_onewin_items.
      104   end.
      105   end procedure.
      106   procedure onewin_add-item :
      107   define input parameter p-ext-key   as character        no-undo.
      108   define input parameter p-item-name as character        no-undo.
      109   define input parameter p-item-desc as character        no-undo.
      110   define input parameter p-selected  as logical          no-undo.
      111       define buffer buf_temp_onewin_items        for temp_onewin_items.
      112   do
      113   for buf_temp_onewin_items
      114   on error undo, return error
      115   :
      116       find last buf_temp_onewin_items no-error.
      117       if available buf_temp_onewin_items then do:
      118         v-onewin0-itm-key = buf_temp_onewin_items.itm-key.
      119       end.
      120       else do:
      121         v-onewin0-itm-key = 0.
      122       end.
      123       assign
      124           v-onewin0-itm-key = v-onewin0-itm-key + 1
      125       .
      126       create buf_temp_onewin_items.
      127       assign
      128       buf_temp_onewin_items.itm-key      = v-onewin0-itm-key
      129       buf_temp_onewin_items.itmExtKey    = p-ext-key
      130       buf_temp_onewin_items.itmName      = p-item-name
      131       buf_temp_onewin_items.itmDesc      = p-item-desc
      132       buf_temp_onewin_items.itmSelected  = p-selected
      133       .
      134   end.
      135   end procedure.
      136   procedure onewin_create-selection :
      137   define input parameter p-itm-key as integer no-undo .
      138   define input parameter p-itmextkey as character no-undo .
      139   define variable v-counter as integer no-undo .
      140   define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected .
      141   do
      142   on error undo, return error
      143   :
      144     find last buf_temp_onewin_itemsSelected use-index pi no-error.
      145     if available buf_temp_onewin_itemsSelected then do:
      146       v-counter = buf_temp_onewin_itemsSelected.its-key.
      147     end.
      148     find first buf_temp_onewin_itemsSelected where
      149          buf_temp_onewin_itemsSelected.itm-key = p-itm-key no-error.
      150     if not available buf_temp_onewin_itemsSelected then do:
      151       create buf_temp_onewin_itemsSelected.
      152       assign
      153       buf_temp_onewin_itemsSelected.its-key   = v-counter + 1
      154       v-counter = v-counter + 1
      155       buf_temp_onewin_itemsSelected.itm-key   = p-itm-key
      156       buf_temp_onewin_itemsSelected.itmExtKey = p-itmExtKey
      157       .
      158     end.
      159   end.
      160   end procedure.
      161   procedure onewin_check-item :
      162   define input parameter p-ext-key   as character        no-undo.
      163   define output parameter p-exists as logical no-undo .
      164   define buffer buf_temp_onewin_items for temp_onewin_items.
      165   find first buf_temp_onewin_items where
      166   buf_temp_onewin_items.itmExtKey    = p-ext-key no-error.
      167   if available buf_temp_onewin_items then do:
      168     p-exists = yes.
      169   end.
      170   end procedure.
      171   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172   procedure gen-key-rec :
      173     define input  parameter p-tbl-name    as character no-undo.
      174     define input  parameter p-bh_tbl-name as handle    no-undo.
      175     define output parameter p-key-rec     as character no-undo.
      176     do
      177     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      178     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      179     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      180     :
      181       define variable fh               as handle    no-undo .
      182       define variable v-ok             as logical   no-undo .
      183       define variable v-inform         as character no-undo .
      184       define variable v-ind            as integer   no-undo .
      185       define variable v-idx-field-qnty as integer   no-undo .
      186       if p-tbl-name = ?
      187         or p-tbl-name = "":U
      188       then do:
      189         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      190       end.
      191       if not p-bh_tbl-name:available then do:
      192         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      193       end.
      194       assign
      195         p-key-rec = p-tbl-name
      196         v-inform  = p-bh_tbl-name:index-information(1)
      197         v-ind     = 2
      198       .
      199       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      200       on error undo, return error
      201       :
      202         assign
      203           v-inform = p-bh_tbl-name:index-information( v-ind )
      204           v-ind    = v-ind + 1
      205         .
      206       end.
      207       if v-inform = ?
      208         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      209         or entry( 3, v-inform, ",":U ) <> "1":U
      210       then do:
      211         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      212       end.
      213       else do:
      214         assign
      215           v-idx-field-qnty = num-entries( v-inform ) - 4
      216         .
      217         if v-idx-field-qnty < 2 then do:
      218           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      219         end.
      220         do v-ind = 1 to v-idx-field-qnty by 2
      221         on error undo, return error
      222         :
      223           assign
      224             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      225             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      226           .
      227         end.
      228       end.
      229       if p-key-rec = ? then do:
      230         assign
      231           p-key-rec = "":U
      232         .
      233         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      234       end.
      235     end.
      236     return.
      237   end procedure.
      238   procedure gen-where-keyr-tab :
      239     define input  parameter i-tableSerach as character no-undo.
      240     define input  parameter i-tablekey   as character  no-undo.
      241     define input  parameter p-key-rec    as character  no-undo.
      242     define input  parameter p-key-handle as handle     no-undo .
      243     define input  parameter p-db-name    as character  no-undo .
      244     define input  parameter p-tt-handle  as handle     no-undo .
      245     define output parameter o-Where      as character  no-undo.
      246     do
      247     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      248     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      249     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      250     :
      251       define variable v-full-tbl-name  as character no-undo .
      252       define variable bh_tbl-name      as handle    no-undo .
      253       define variable fh_key           as handle    no-undo .
      254       define variable fh_search        as handle    no-undo .
      255       define variable v-field-num      as integer   no-undo .
      256       define variable v-count-fld      as integer   no-undo .
      257       define variable v-inform         as character no-undo .
      258       define variable v-ind            as integer   no-undo .
      259       define variable v-idx-field-qnty as integer   no-undo .
      260       define variable v-field-name     as character no-undo .
      261       define variable v-field-val      as character no-undo .
      262       define variable v-word-link      as character no-undo .
      263       define variable vTable           as character no-undo.
      264       define variable bh_tbl-key       as handle    no-undo .
      265       assign
      266         p-key-rec = trim( p-key-rec )
      267       .
      268       if p-key-handle <> ? then do:
      269         if not valid-handle(p-key-handle)
      270            or p-key-handle:type <> "buffer"
      271         then do:
      272           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      273         end.
      274         if num-entries( p-key-rec, chr(3) ) > 1
      275           or p-key-rec = ?
      276           or p-key-rec = "":U
      277         then do:
      278           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      279         end.
      280       end.
      281       else do:
      282         if p-key-rec = ?
      283           or p-key-rec = "":U
      284         then do:
      285           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      286         end.
      287       end.
      288       assign
      289         vTable = entry( 1 , p-key-rec, chr(3) )
      290       .
      291       if p-tt-handle <> ?
      292         and ( not valid-handle(p-tt-handle)
      293               or p-tt-handle:type <> "buffer"
      294             )
      295       then do:
      296         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      297       end.
      298       if p-tt-handle = ? then do:
      299         assign
      300           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      301         .
      302         create buffer bh_tbl-name for table v-full-tbl-name .
      303       end.
      304       else do:
      305         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      306       end.
      307       assign
      308         v-inform = bh_tbl-name:index-information(1)
      309         v-ind    = 2
      310       .
      311       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      312       on error undo, return error
      313       :
      314         assign
      315           v-inform = bh_tbl-name:index-information( v-ind )
      316           v-ind    = v-ind + 1
      317         .
      318       end.
      319       if v-inform = ?
      320         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      321         or entry( 3, v-inform, ",":U ) <> "1":U
      322       then do:
      323         delete object bh_tbl-name no-error.
      324         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      325       end.
      326       assign
      327         v-idx-field-qnty = num-entries( v-inform ) - 4
      328       .
      329       if v-idx-field-qnty < 2 then do:
      330         delete object bh_tbl-name no-error.
      331         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      332       end.
      333       assign
      334         o-where     = "where":U
      335         v-word-link = "":U
      336         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      337         v-count-fld = 0
      338       .
      339       if i-tablekey ne "" and i-tablekey ne ?
      340       then do:
      341         assign
      342           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      343         .
      344         create buffer bh_tbl-key for table v-full-tbl-name .
      345       end.
      346       if i-tableSerach ne "" and i-tableSerach ne ?
      347       then do:
      348         delete object bh_tbl-name no-error.
      349         assign
      350           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      351         .
      352         create buffer bh_tbl-name for table v-full-tbl-name .
      353       end.
      354       block_where:
      355       do v-ind = 1 to v-idx-field-qnty by 2
      356       on error undo, return error
      357       :
      358         assign
      359           v-count-fld = v-count-fld + 1
      360         .
      361         if p-key-handle = ?
      362           and v-count-fld > v-field-num
      363         then do:
      364           leave block_where.
      365         end.
      366         define variable VfieldKeyTable as handle no-undo.
      367         assign
      368           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      369           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      370         .
      371         if     bh_tbl-key ne ?
      372         then do:
      373            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      374            if VfieldKeyTable eq ?
      375            then next block_where.
      376         end.
      377         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      378         then
      379            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      380         else
      381            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      382         if p-key-handle = ? then do:
      383           assign
      384             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      385           .
      386         end.
      387         else do:
      388           assign
      389             fh_key = p-key-handle:buffer-field( v-field-name )
      390           .
      391           if fh_key = ?
      392             or not valid-handle( fh_key )
      393           then do:
      394             delete object bh_tbl-name.
      395             if     bh_tbl-key ne ?
      396             then
      397                delete object bh_tbl-key.
      398             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      399           end.
      400           assign
      401             v-field-val = fh_key:buffer-value
      402           .
      403         end.
      404         if fh_search:data-type ="character":U then do:
      405           assign
      406             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      407             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      408             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      409             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      410             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      411             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      412             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      413             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      414             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      415             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      416             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      417             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      418             v-field-val = substitute( '"&1"', v-field-val )
      419           .
      420         end.
      421         assign
      422           o-where = substitute( "&1 &2", o-where, v-field-val )
      423         .
      424         if v-word-link = "":U then do:
      425           assign
      426             v-word-link = "and":U
      427           .
      428         end.
      429       end.
      430       delete object bh_tbl-name.
      431       if     bh_tbl-key ne ?
      432       then
      433          delete object bh_tbl-key.
      434       if p-key-handle = ?
      435         and v-count-fld <> v-field-num
      436       then do:
      437         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      438       end.
      439     end.
      440   end procedure.
      441   procedure gen-hn-keyr-tab :
      442     define input  parameter i-tableSerach as character no-undo.
      443     define input  parameter i-tablekey   as character no-undo.
      444     define input  parameter p-key-rec    as character no-undo.
      445     define input  parameter p-key-handle as handle    no-undo .
      446     define input  parameter p-db-name    as character no-undo .
      447     define input  parameter p-tt-handle  as handle    no-undo .
      448     define input  parameter p-stts-lock  as integer   no-undo .
      449     define output parameter o-hn         as handle    no-undo.
      450     define variable v-full-tbl-name as character no-undo.
      451     define variable v-where         as character no-undo.
      452     define variable bh_tbl-name     as handle    no-undo.
      453     define variable vTable          as character no-undo.
      454     do
      455     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      456     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      457     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      458         run gen-where-keyr-tab(i-tableSerach,
      459                                i-tablekey,
      460                                p-key-rec,
      461                                p-key-handle,
      462                                p-db-name,
      463                                p-tt-handle,
      464                                output v-where).
      465         if i-tableSerach ne "" and i-tableSerach ne ?
      466         then do:
      467            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      468            create buffer bh_tbl-name for table v-full-tbl-name .
      469         end.
      470         else do:
      471            if p-tt-handle = ? then do:
      472               assign
      473                  vTable = entry( 1 , p-key-rec, chr(3) )
      474               .
      475               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      476               create buffer bh_tbl-name for table v-full-tbl-name .
      477            end.
      478            else do:
      479               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      480            end.
      481         end.
      482         if p-tt-handle = ? then do:
      483            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      484         end.
      485         else do:
      486            bh_tbl-name:find-first( v-where ) no-error .
      487         end.
      488         o-hn = bh_tbl-name.
      489      end.
      490   end procedure.
      491   procedure gen-hn-keyr :
      492     define input  parameter p-key-rec    as character no-undo.
      493     define input  parameter p-key-handle as handle    no-undo .
      494     define input  parameter p-db-name    as character no-undo .
      495     define input  parameter p-tt-handle  as handle    no-undo .
      496     define input  parameter p-stts-lock  as integer   no-undo .
      497     define output parameter o-hn         as handle    no-undo.
      498     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      499   end.
      500   procedure gen-row-keyr :
      501     define input  parameter p-key-rec    as character no-undo.
      502     define input  parameter p-key-handle as handle    no-undo .
      503     define input  parameter p-db-name    as character no-undo .
      504     define input  parameter p-tt-handle  as handle    no-undo .
      505     define input  parameter p-stts-lock  as integer   no-undo .
      506     define output parameter p-tbl-row    as rowid     no-undo.
      507     define output parameter p-tbl-name   as character no-undo.
      508     define variable vHn as handle no-undo.
      509       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      510       p-tbl-row = if vHn:available then vHn:rowid else ?.
      511       p-tbl-name =  vHn:table.
      512       delete object vHn no-error.
      513     if p-tbl-row = ? then do:
      514       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      515     end.
      516     else do:
      517       return.
      518     end.
      519   end procedure.
      520   procedure gen-key-fv :
      521     define input  parameter p-key-rec    as character no-undo .
      522     define output parameter p-field-list as character no-undo .
      523     define output parameter p-value-list as character no-undo.
      524     do
      525     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      526     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      527     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      528     :
      529       define variable v-full-tbl-name  as character no-undo .
      530       define variable bh_tbl-name      as handle    no-undo .
      531       define variable v-tbl-name       as character no-undo .
      532       define variable v-field-num      as integer   no-undo .
      533       define variable v-count-fld      as integer   no-undo .
      534       define variable v-inform         as character no-undo .
      535       define variable v-ind            as integer   no-undo .
      536       define variable v-idx-field-qnty as integer   no-undo .
      537       define variable v-delim-key      as character no-undo .
      538       if p-key-rec = ?
      539         or p-key-rec = "":U
      540       then do:
      541         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      542       end.
      543       assign
      544         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      545         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      546       .
      547       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      548       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      549       assign
      550         v-inform = bh_tbl-name:index-information(1)
      551         v-ind    = 2
      552       .
      553       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      554       on error undo, return error
      555       :
      556         assign
      557           v-inform = bh_tbl-name:index-information( v-ind )
      558           v-ind    = v-ind + 1
      559         .
      560       end.
      561       if v-inform = ?
      562         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      563         or entry( 3, v-inform, ",":U ) <> "1":U
      564       then do:
      565         delete object bh_tbl-name no-error.
      566         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      567       end.
      568       assign
      569         v-idx-field-qnty = num-entries( v-inform ) - 4
      570       .
      571       if v-idx-field-qnty < 2 then do:
      572         delete object bh_tbl-name no-error.
      573         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      574       end.
      575       assign
      576         p-field-list = "":U
      577         p-value-list = "":U
      578         v-delim-key  = "":U
      579         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      580         v-count-fld  = 0
      581       .
      582       block_where:
      583       do v-ind = 1 to v-idx-field-qnty by 2
      584       on error undo, return error
      585       :
      586         assign
      587           v-count-fld = v-count-fld + 1
      588         .
      589         if v-count-fld > v-field-num then do:
      590           leave block_where.
      591         end.
      592         assign
      593           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      594           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      595         .
      596         if v-ind = 1 then do:
      597           assign
      598             v-delim-key = chr(3)
      599           .
      600         end.
      601       end.
      602       delete object bh_tbl-name.
      603       if v-count-fld <> v-field-num then do:
      604         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      605       end.
      606     end.
      607   end procedure.
      608   procedure gen-key-field :
      609     define input  parameter p-table      as character no-undo .
      610     define output parameter p-field-list as character no-undo .
      611     do
      612     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      613     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      614     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      615     :
      616       define variable v-full-tbl-name  as character no-undo .
      617       define variable bh_tbl-name      as handle    no-undo .
      618       define variable v-tbl-name       as character no-undo .
      619       define variable v-field-num      as integer   no-undo .
      620       define variable v-count-fld      as integer   no-undo .
      621       define variable v-inform         as character no-undo .
      622       define variable v-ind            as integer   no-undo .
      623       define variable v-idx-field-qnty as integer   no-undo .
      624       define variable v-delim-key      as character no-undo .
      625       if p-table = ?
      626         or p-table = "":U
      627       then do:
      628         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      629       end.
      630       assign
      631         v-tbl-name      = p-table
      632         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      633       .
      634       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      635       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      636       assign
      637         v-inform = bh_tbl-name:index-information(1)
      638         v-ind    = 2
      639       .
      640       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      641       on error undo, return error
      642       :
      643         assign
      644           v-inform = bh_tbl-name:index-information( v-ind )
      645           v-ind    = v-ind + 1
      646         .
      647       end.
      648       if v-inform = ?
      649         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      650         or entry( 3, v-inform, ",":U ) <> "1":U
      651       then do:
      652         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      653       end.
      654       assign
      655         v-idx-field-qnty = num-entries( v-inform ) - 4
      656       .
      657       if v-idx-field-qnty < 2 then do:
      658         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      659       end.
      660       assign
      661         p-field-list = "":U
      662         v-delim-key  = "":U
      663         v-count-fld  = 0
      664       .
      665       block_where:
      666       do v-ind = 1 to v-idx-field-qnty by 2
      667       on error undo, return error
      668       :
      669         assign
      670           v-count-fld = v-count-fld + 1
      671         .
      672         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      673         if v-ind = 1 then do:
      674           assign
      675             v-delim-key = chr(3)
      676           .
      677         end.
      678       end.
      679       delete object bh_tbl-name.
      680     end.
      681   end procedure.
      682       define variable v-esys-unique-key   as character    no-undo.
      683       define variable v-where-prefix      as character    no-undo.
      684       define variable bh                  as handle       no-undo .
      685       define variable qh                  as handle       no-undo .
      686       define variable v-query             as character    no-undo.
      687       define variable v-counter           as integer      no-undo.
      688       define buffer buf_ext-system        for ub.ext-system.
      689   do
      690   for buf_ext-system
      691   on error undo, return error
      692   :
      693       create buffer bh for table "ext-system":U buffer-name "buf_ext-system":U .
      694       create query qh .
      695       qh :set-buffers( bh ).
      696       assign
      697           v-query  = "for each buf_ext-system no-lock"
      698       .
      699       if p-where-string <> "":U
      700       then do:
      701           do v-counter = 1 to num-entries( p-where-string )
      702           :
      703               assign
      704                   v-where-prefix = ( if v-counter = 1 then " where " else " and " )
      705               .
      706               assign
      707                   v-query  = substitute( "&1&2&3", v-query, v-where-prefix, entry( v-counter, p-where-string ) )
      708               .
      709           end.
      710       end.
      711       qh :query-prepare( v-query ).
      712       qh :query-open.
      713       qh :get-first.
      714       run onewin_clear in this-procedure.
      715       do
      716       while qh :query-off-end = no
      717       :
      718           run gen-key-rec in this-procedure (
      719                 input "ext-system":U
      720               , input bh
      721               , output v-esys-unique-key
      722           ).
      723           run onewin_add-item in this-procedure (
      724                 input v-esys-unique-key
      725               , input bh :buffer-field( "esys-name" ) :buffer-value
      726               , input bh :buffer-field( "esys-des" ) :buffer-value
      727               , input ( lookup( v-esys-unique-key, p-in-selected-list ) > 0 )
      728           ).
      729           qh :get-next.
      730       end.
      731       delete object bh.
      732       delete object qh.
      733       run gbl/onewin.w (
      734             input p-mainmenu-handle
      735           , input p-mode
      736           , input "Выбор внешних систем":U
      737           , input "bge/oxmlextv.p":U
      738           , input "&Просмотр"
      739           , input table temp_onewin_items
      740           , output table temp_onewin_itemsSelected
      741           , output v-esys-unique-key
      742           , output p-accepted
      743       ).
      744       if p-accepted = yes
      745       then do:
      746           if p-mode = 2
      747           then do:
      748               assign
      749                   p-out-selected-list = v-esys-unique-key
      750               .
      751           end.
      752           else do:
      753               assign
      754                   p-out-selected-list = "":U
      755               .
      756               for each temp_onewin_itemsSelected
      757               :
      758                   assign
      759                       p-out-selected-list = substitute( "&1&2&3"
      760                                       , p-out-selected-list
      761                                       , ( if p-out-selected-list = "":U then "":U else ",":U )
      762                                       , temp_onewin_itemsSelected.itmExtKey
      763                                       )
      764                   .
      765               end.
      766           end.
      767       end.
      768   end.
