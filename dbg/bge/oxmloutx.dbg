      582   end .
      583   procedure xmlchar-decode :
      584   define input parameter p-in-string      as character        no-undo.
      585   define output parameter p-out-string    as character        no-undo.
      586       define variable v-position      as integer      no-undo.
      587       define variable v-last-position as integer      no-undo.
      588       define variable v-temp-integer  as integer      no-undo.
      589       define variable v-current-char  as character    no-undo.
      590       define variable v-next-char     as character    no-undo.
      591       define variable v-success       as logical      no-undo.
      592   do
      593   on error undo, return error
      594   :
      595       assign
      596           p-out-string = "":U
      597           v-position   = 0
      598       .
      599       replace-cycle:
      600       do while yes
      601       on error undo, return error
      602       :
      603           assign
      604               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      605           .
      606           if v-last-position <= v-position
      607           then do:
      608               if v-position = 0
      609               then do:
      610                   assign
      611                       p-out-string = p-in-string
      612                   .
      613               end.
      614               else do:
      615                   assign
      616                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      617                   .
      618               end.
      619               leave replace-cycle.
      620           end.
      621           else do:
      622               assign
      623                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      624                   v-position      = v-last-position
      625                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      626               .
      627               if v-current-char = "#":U
      628               then do:
      629                   assign
      630                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      631                   .
      632                   if v-last-position > 0
      633                   then do:
      634                       run xmlchar-read-integer in this-procedure
      635                        (
      636                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      637                           , output v-temp-integer
      638                           , output v-success
      639                       ).
      640                       if v-success = yes
      641                       and v-temp-integer >= 1
      642                       and v-temp-integer <= 255
      643                       then do:
      644                           assign
      645                               p-out-string = p-out-string + chr( v-temp-integer )
      646                               v-position   = v-last-position + 1
      647                           .
      648                       end.
      649                       else do:
      650                           assign
      651                               p-out-string = p-out-string + "&":U
      652                               v-position   = v-position   + 1
      653                           .
      654                       end.
      655                   end.
      656                   else do:
      657                       assign
      658                           p-out-string = p-out-string + "&":U
      659                           v-position   = v-position   + 1
      660                       .
      661                   end.
      662               end.
      663               else do:
      664                   case substring( p-in-string, v-position + 1, 3 )
      665                   :
      666                       when "lt;":U
      667                       then do:
      668                           assign
      669                               p-out-string = p-out-string + "<":U
      670                               v-position   = v-position   + 3
      671                           .
      672                       end.
      673                       when "gt;":U
      674                       then do:
      675                           assign
      676                               p-out-string = p-out-string + ">":U
      677                               v-position   = v-position   + 3
      678                           .
      679                       end.
      680                       otherwise do:
      681                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      682                           then do:
      683                               assign
      684                                   p-out-string = p-out-string + "&":U
      685                                   v-position   = v-position   + 4
      686                               .
      687                           end.
      688                           else do:
      689                               case substring( p-in-string, v-position + 1, 5 )
      690                               :
      691                                   when "quot;":U
      692                                   then do:
      693                                       assign
      694                                           p-out-string = p-out-string + '"':U
      695                                           v-position   = v-position   + 5
      696                                       .
      697                                   end.
      698                                   when "apos;":U
      699                                   then do:
      700                                       assign
      701                                           p-out-string = p-out-string + "'":U
      702                                           v-position   = v-position   + 5
      703                                       .
      704                                   end.
      705                                   otherwise do:
      706                                       assign
      707                                           p-out-string = p-out-string + "&":U
      708                                       .
      709                                   end.
      710                               end case.
      711                           end.
      712                       end.
      713                   end case.
      714               end.
      715           end.
      716       end.
      717   end.
      718   end .
      719   procedure xmlchar-read-integer :
      720   define input parameter p-input-string      as character        no-undo.
      721   define output parameter p-output-integer   as integer          no-undo.
      722   define output parameter p-success       as logical          no-undo.
      723   do
      724   on error undo, return error
      725   :
      726       assign
      727           p-output-integer = integer( p-input-string )
      728       no-error.
      729       if error-status :error
      730       then do:
      731           assign
      732               p-success           = no
      733               p-output-integer    = 0
      734           .
      735       end.
      736       else do:
      737           assign
      738               p-success           = yes
      739           .
      740       end.
      741   end.
      742   end.
      743   define variable vss-include-info2 as character format "X(65)" no-undo
      744   initial "@(#)$Workfile$ $Revision$".
      745   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      746   define stream stmXMLOut.
      747   define stream stmXMLLog.
      748   define stream strXMLIn.
      749   define temp-table temp_xmllib_rec-list no-undo
      750       field recName       as character
      751       field recLevel      as integer
      752       field recOpenLine   as integer
      753       field recCloseLine  as integer
      754       field closed        as logical
      755       index pi is primary unique
      756           recName
      757           recLevel
      758       index cl
      759           closed
      760   .
      761   define temp-table temp_xmllib_rec-fld-list no-undo
      762       field recName       as character
      763       field recLevel      as integer
      764       field fldName       as character
      765       field fldOpenLine   as integer
      766       field fldCloseLine  as integer
      767       field closed        as logical
      768       index pi is primary unique
      769           recName
      770           recLevel
      771           fldName
      772       index fn
      773           fldName
      774       index cl
      775           closed
      776   .
      777   define temp-table temp_xmllib_rec no-undo
      778       field rec-key       as integer
      779       field recLevel      as integer
      780       field recOpenLine   as integer
      781       field recCloseLine  as integer
      782       field recName       as character
      783       field closed        as logical
      784       index pi is primary unique
      785           rec-key
      786       index nm
      787           recName
      788           closed
      789           rec-key
      790       index cl
      791           closed
      792       index rlv
      793           recName
      794           recLevel
      795           closed
      796           rec-key
      797   .
      798   define temp-table temp_xmllib_rec-fld no-undo
      799       field fld-key       as integer
      800       field rec-key       as integer
      801       field fldOpenLine   as integer
      802       field fldCloseLine  as integer
      803       field fldName       as character
      804       field fldValue      as character
      805       field closed        as logical
      806       index pi is primary unique
      807           fld-key
      808       index nm
      809           rec-key
      810           fldName
      811           closed
      812           fld-key
      813       index cl
      814           closed
      815   .
      816   define variable v-xmllib-rec-key            as integer      no-undo .
      817   define variable v-xmllib-rec-fld-key        as integer      no-undo .
      818   define variable v-xmllib-dirname            as character    no-undo .
      819   define variable v-xmllib-filename           as character    no-undo .
      820   define variable v-xmllib-log-filename       as character    no-undo .
      821   define variable v-xmllib-log-handle         as handle       no-undo .
      822   define variable v-xmllib-log-proc-name      as character    no-undo .
      823   define variable v-xmllib-error-status       as logical      no-undo .
      824   define variable v-xmllib-sax-reader-handle  as handle       no-undo .
      825   define variable v-xmllib-prg-bar-handle     as handle       no-undo .
      826   define variable v-xmllib-codepage-convert   as logical      no-undo .
      827   define variable v-xmllib-codepage-source    as character    no-undo .
      828   define variable v-xmllib-codepage-target    as character    no-undo .
      829   procedure xmllib-clear-parse-data :
      830   do
      831   on error undo, return error
      832   :
      833       empty temp-table temp_xmllib_rec-list.
      834       empty temp-table temp_xmllib_rec-fld-list.
      835       empty temp-table temp_xmllib_rec.
      836       empty temp-table temp_xmllib_rec-fld.
      837   end.
      838   end procedure.
      839   procedure xmllib-add-rec-fld :
      840   define input parameter p-rec-name       as character        no-undo.
      841   define input parameter p-rec-fld-name   as character        no-undo.
      842       define buffer buf_rec-list        for temp_xmllib_rec-list.
      843       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
      844   do
      845   for buf_rec-list
      846     , buf_rec-fld-list
      847   on error undo, return error
      848   :
      849       find first buf_rec-list
      850            where buf_rec-list.recName = p-rec-name
      851       no-error.
      852       if not available buf_rec-list
      853       then do:
      854           create buf_rec-list.
      855           assign
      856               buf_rec-list.recName        = p-rec-name
      857               buf_rec-list.recOpenLine    = 0
      858               buf_rec-list.recCloseLine   = 0
      859               buf_rec-list.closed         = yes
      860           .
      861       end.
      862       find first buf_rec-fld-list
      863            where buf_rec-fld-list.recName = p-rec-name
      864              and buf_rec-fld-list.fldName = p-rec-fld-name
      865       no-error.
      866       if not available buf_rec-fld-list
      867       then do:
      868           create buf_rec-fld-list.
      869           assign
      870               buf_rec-fld-list.recName        = p-rec-name
      871               buf_rec-fld-list.fldName        = p-rec-fld-name
      872               buf_rec-fld-list.fldOpenLine    = 0
      873               buf_rec-fld-list.fldCloseLine   = 0
      874               buf_rec-fld-list.closed         = yes
      875           .
      876       end.
      877   end.
      878   end procedure.
      879   procedure xmllib-tag-open:
      880   define input parameter v-tag-level  as integer      no-undo.
      881   define input parameter v-tag-name   as character    no-undo.
      882   define input parameter v-tag-value  as character    no-undo.
      883   do
      884   on error undo, return error
      885   :
      886       assign
      887           v-tag-name = trim( v-tag-name )
      888       .
      889       put stream stmXMLOut unformatted
      890           substitute( "&1&2<&3&4&5>"
      891               , chr(10)
      892               , fill(" ", 4 * v-tag-level)
      893               , v-tag-name
      894               , ( if v-tag-value = "":U or v-tag-value = ? then "":U else " ":U )
      895               , v-tag-value
      896           )
      897       .
      898   end.
      899   end procedure.
      900   procedure xmllib-tag-put:
      901   define input parameter v-tag-level      as integer      no-undo.
      902   define input parameter v-tag-name       as character    no-undo.
      903   define input parameter v-tag-value      as character    no-undo.
      904   define input parameter v-empty-mode     as integer      no-undo.
      905   do
      906   on error undo, return error
      907   :
      908       assign
      909           v-tag-name = trim( v-tag-name )
      910       .
      911       if  v-empty-mode = 1
      912       or (v-empty-mode = 0 and (v-tag-value <> "":U and v-tag-value <> ?) )
      913       or (v-empty-mode = 2 and (v-tag-value <> "":U and v-tag-value <> ? and v-tag-value <> "0":U))
      914       or (v-empty-mode = 3 and (v-tag-value <> "":U and v-tag-value <> ? and caps(v-tag-value) <> "no":U))
      915       then do:
      916           run xmlchar-encode in this-procedure (
      917                 input v-tag-value
      918               , output v-tag-value
      919           ).
      920           put stream stmXMLOut unformatted
      921               substitute( "&1&2<&3>&4</&3>"
      922                   , chr(10)
      923                   , fill(" ":U, 4 * v-tag-level)
      924                   , v-tag-name
      925                   , v-tag-value
      926               )
      927           .
      928       end.
      929   end.
      930   end procedure.
      931   procedure xmllib-tag-put-null :
      932   define input parameter p-tag-level  as integer      no-undo.
      933   define input parameter p-tag-name   as character    no-undo.
      934   do
      935   on error undo, return error
      936   :
      937       assign
      938           p-tag-name = trim( p-tag-name )
      939       .
      940       put stream stmXMLOut unformatted
      941           substitute( '&1&2<&3 nil="true" /&3>'
      942               , chr(10)
      943               , fill(" ":U, 4 * p-tag-level)
      944               , p-tag-name
      945           )
      946       .
      947   end.
      948   end procedure.
      949   procedure xmllib-tag-close:
      950   define input parameter v-tag-level as integer      no-undo.
      951   define input parameter v-tag-name  as character    no-undo.
      952   do
      953   on error undo, return error
      954   :
      955       assign
      956           v-tag-name = trim( v-tag-name )
      957       .
      958       put stream stmXMLOut unformatted
      959           substitute( "&1&2</&3>"
      960               , chr(10)
      961               , fill( " ":U, 4 * v-tag-level)
      962               , v-tag-name
      963           )
      964       .
      965   end.
      966   end procedure.
      967   procedure xmllib-write-log:
      968   define input parameter v-filename   as character    no-undo.
      969   define input parameter v-log-level  as integer      no-undo.
      970   define input parameter v-out-string as character    no-undo.
      971   do
      972   on error undo, return error
      973   :
      974       output stream stmXMLLog to value( v-filename ) append.
      975       put stream stmXMLLog unformatted
      976           chr(10)
      977       .
      978       put stream stmXMLLog unformatted
      979           ( if v-log-level = 0
      980             or v-out-string = "&DLine":U
      981             or v-out-string = "&Line":U
      982             then "":U
      983             else cur-time-string-sec() + " ":U )
      984       .
      985       put stream stmXMLLog unformatted
      986           ( if v-out-string = "&Line":U
      987             then fill( "-":U, 80 )
      988             else if v-out-string = "&DLine":U
      989                  then fill( "=":U, 80 )
      990                  else v-out-string )
      991       .
      992       output stream stmXMLLog close.
      993   end.
      994   end procedure.
      995   procedure xmllib-write-edt:
      996   define input parameter v-editor-handle    as handle       no-undo.
      997   define input parameter v-log-level        as integer      no-undo.
      998   define input parameter v-out-string       as character    no-undo.
      999   do
     1000   on error undo, return error
     1001   :
     1002       if valid-handle ( v-editor-handle )
     1003       then do:
     1004           v-editor-handle :move-to-eof().
     1005           v-editor-handle :insert-string( ( if v-log-level = 0
     1006                                             or v-out-string = "&DLine":U
     1007                                             or v-out-string = "&Line":U
     1008                                             then "":U
     1009                                             else cur-time-string-sec() + " ":U
     1010                                         ) ).
     1011           v-editor-handle :insert-string( ( if v-out-string = "&Line":U
     1012                                             then fill( "-":U, 80 )
     1013                                             else if v-out-string = "&DLine":U then fill("=":U, 80)
     1014                                             else fill( " ":U, v-log-level) + v-out-string
     1015                                         ) ).
     1016           v-editor-handle :insert-string( chr(10) ).
     1017       end.
     1018   end.
     1019   end procedure.
     1020   procedure xmllib-show-cnt:
     1021   define input parameter v-fillin-handle     as handle   no-undo.
     1022   do
     1023   on error undo, return error
     1024   :
     1025       if valid-handle( v-fillin-handle )
     1026       then do:
     1027           assign
     1028               v-fillin-handle :visible = true
     1029           .
     1030       end.
     1031   end.
     1032   end procedure.
     1033   procedure xmllib-hide-cnt:
     1034   define input parameter v-fillin-handle     as handle   no-undo.
     1035   do
     1036   on error undo, return error
     1037   :
     1038       if valid-handle( v-fillin-handle )
     1039       then do:
     1040           assign v-fillin-handle :visible = false.
     1041       end.
     1042   end.
     1043   end procedure.
     1044   procedure xmllib-write-cnt:
     1045   define input parameter v-fillin-handle    as handle       no-undo.
     1046   define input parameter v-fillin-string    as character    no-undo.
     1047   do
     1048   on error undo, return error
     1049   :
     1050       if valid-handle( v-fillin-handle )
     1051       then do:
     1052           assign
     1053               v-fillin-handle :SCREEN-value = v-fillin-string
     1054           .
     1055       end.
     1056   end.
     1057   end procedure.
     1058   procedure xmllib-write-header:
     1059   define input parameter p-first-file     as logical      no-undo.
     1060   define input parameter p-xml-file-name  as character    no-undo.
     1061   define input parameter p-list-file-name as character    no-undo.
     1062   define input parameter p-file-number    as integer      no-undo.
     1063   define input parameter p-have-prev      as logical      no-undo.
     1064   define input parameter p-prev-filename  as character    no-undo.
     1065   define input parameter p-parameter-list as character    no-undo.
     1066       define variable v-counter    as integer        no-undo.
     1067   do
     1068   on error undo, return error
     1069   :
     1070       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1071       put stream stmXMLOut unformatted
     1072           "<?xml version='1.0' encoding='windows-1251'?>"
     1073       .
     1074       run xmllib-tag-open( input 0, input "root"          , input "":U ).
     1075       run xmllib-tag-open( input 0, input "THheader"        , input "":U ).
     1076       run xmllib-tag-put( input 1 , input "THfileName"      , input p-xml-file-name + "xml":U  , input 0 ).
     1077       run xmllib-tag-put( input 1 , input "THfileNumber"    , input string( p-file-number     ), input 0 ).
     1078       run xmllib-tag-put( input 1 , input "THhavePrev"      , input string( p-have-prev       ), input 3 ).
     1079       run xmllib-tag-put( input 1 , input "THprevFileName"  , input p-prev-filename            , input 0 ).
     1080       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1081       :
     1082           run xmllib-tag-put(
     1083                 input 1
     1084               , input entry( 2 * v-counter, p-parameter-list )
     1085               , input entry( 2 * v-counter + 1, p-parameter-list )
     1086               , input 0
     1087           ).
     1088       end.
     1089       run xmllib-tag-close( input 0, input "THheader" ).
     1090       output stream stmXMLOut close.
     1091       if p-list-file-name <> "":U
     1092       then do:
     1093           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1094           if p-first-file = yes
     1095           then do:
     1096               put stream stmXMLOut unformatted
     1097                   "<?xml version='1.0' encoding='windows-1251'?>"
     1098               .
     1099               run xmllib-tag-open( input 0, input "OpenXML", input "" ).
     1100           end.
     1101           run xmllib-tag-open( input 1, input "THfile", input "" ).
     1102           run xmllib-tag-put( input 2, input "THfileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1103           run xmllib-tag-put( input 2, input "THfileNumber"     , input string( p-file-number     ), input 0 ).
     1104           run xmllib-tag-put( input 2, input "THhavePrev"       , input string( p-have-prev       ), input 3 ).
     1105           run xmllib-tag-put( input 2, input "THprevFileName"   , input p-prev-filename            , input 0 ).
     1106           do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1107           :
     1108               run xmllib-tag-put(
     1109                   input 2
     1110                   , input entry( 2 * v-counter, p-parameter-list )
     1111                   , input entry( 2 * v-counter + 1, p-parameter-list )
     1112                   , input 0
     1113               ).
     1114           end.
     1115           run xmllib-tag-close( input 1, input "THfile" ).
     1116           output stream stmXMLOut close.
     1117       end.
     1118   end.
     1119   end procedure.
     1120   procedure xmllib-write-footer:
     1121   define input parameter p-last-file      as logical      no-undo.
     1122   define input parameter p-xml-file-name  as character    no-undo.
     1123   define input parameter p-list-file-name as character    no-undo.
     1124   define input parameter p-have-next      as logical      no-undo.
     1125   define input parameter p-next-file-name as character    no-undo.
     1126       define variable v-error-num     as integer           no-undo.
     1127   do
     1128   on error undo, return error
     1129   :
     1130       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1131       if p-have-next = yes
     1132       then do:
     1133           run xmllib-tag-open( input 0, input "footer", "" ).
     1134           run xmllib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1135           run xmllib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1136           run xmllib-tag-close( input 0, input "footer" ).
     1137       end.
     1138       run xmllib-tag-close( input 0, input "root" ).
     1139       output stream stmXMLOut close.
     1140       run bge/os_copy.p (
     1141             input "M"
     1142           , input p-xml-file-name + "tmp"
     1143           , input p-xml-file-name + "xml"
     1144           , output v-error-num
     1145       ).
     1146       if p-last-file = yes
     1147       and p-list-file-name <> "":U
     1148       then do:
     1149           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1150               run xmllib-tag-close( input 0, input "OpenXML" ).
     1151           output stream stmXMLOut close.
     1152           run bge/os_copy.p (
     1153                 input "M"
     1154               , input p-list-file-name + "tmp"
     1155               , input p-list-file-name + "xml":U
     1156               , output v-error-num
     1157           ).
     1158       end.
     1159   end.
     1160   end procedure.
     1161   procedure xmllib-filename :
     1162   define input parameter p-subdir             as character        no-undo.
     1163   define input parameter p-prefix             as character    no-undo.
     1164   define output parameter p-xml-file-name     as character    no-undo.
     1165   define output parameter p-log-file-name     as character    no-undo.
     1166   define output parameter p-list-file-name    as character    no-undo.
     1167       define variable v-home-dir  as character    no-undo.
     1168       define variable v-error-num as integer      no-undo.
     1169   do
     1170   on error undo, return error
     1171   :
     1172       get-key-value section "OXML" key "oxml-dir" value v-home-dir.
     1173       if v-home-dir = ?
     1174       then do:
     1175           message
     1176             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1177             skip "Нет параметра oxml-dir в секции [OXML]."
     1178             skip(1)
     1179             skip "Обратитесь к администратору."
     1180           view-as alert-box error.
     1181           undo, return error .
     1182       end.
     1183       if p-subdir <> "":U
     1184       then do:
     1185           assign
     1186               v-home-dir = substitute( "&1/out/&2", v-home-dir, p-subdir )
     1187           .
     1188       end.
     1189       run gbl/dir-cre.p (
     1190           input v-home-dir
     1191       ) no-error.
     1192       if error-status :error
     1193       then do:
     1194           message
     1195             skip "Неверно задан каталог экспорта в ini-файле."
     1196             skip "Не удаётся создать каталог, указанный параметром"
     1197             skip "oxml-dir в секции [OXML]."
     1198             skip(1)
     1199             skip "Обратитесь к администратору."
     1200           view-as alert-box error.
     1201           undo, return error .
     1202       end.
     1203       run bge/genfname.p (
     1204             input v-home-dir
     1205           , input p-prefix
     1206           , input ""
     1207           , input "xml"
     1208           , input "tmp"
     1209           , output p-xml-file-name
     1210       ).
     1211       assign
     1212           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1213           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1214           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1215       .
     1216   end.
     1217   end procedure.
     1218   procedure xmllib-check-file-size :
     1219   define input parameter p-out-filename   as character    no-undo.
     1220   define output parameter p-is-big        as logical      no-undo.
     1221       define variable v-current-position    as integer        no-undo.
     1222   do
     1223   on error undo, return error
     1224   :
     1225       assign
     1226           v-current-position = seek( stmXMLOut )
     1227       .
     1228       if v-current-position / 1024 / 1024  >= 100
     1229       then do:
     1230           assign
     1231               p-is-big = yes
     1232           .
     1233       end.
     1234   end.
     1235   end procedure.
     1236   procedure xmllib-parse-file :
     1237   define input parameter p-full-filename      as character        no-undo.
     1238       define variable v-num-dirs              as integer      no-undo .
     1239       define variable v-str                   as character    no-undo .
     1240       define variable v-str-count             as int64        no-undo .
     1241   do
     1242   on error undo, return error
     1243   :
     1244       assign
     1245           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     1246           v-xmllib-error-status   = no
     1247       .
     1248       if v-num-dirs > 1
     1249       then do:
     1250           assign
     1251               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     1252               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     1253           .
     1254       end.
     1255       else do:
     1256           assign
     1257               v-xmllib-filename = p-full-filename
     1258               v-xmllib-dirname  = "":U
     1259           .
     1260       end.
     1261       if valid-handle(v-xmllib-prg-bar-handle)
     1262       then do:
     1263   if session :set-wait-state( "compiler" ) then.
     1264         input stream strXMLIn from value(p-full-filename) .
     1265         repeat
     1266         :
     1267           import stream strXMLIn unformatted v-str no-error .
     1268           assign
     1269             v-str-count = v-str-count + 1
     1270           .
     1271         end.
     1272         input stream strXMLIn close .
     1273   if session :set-wait-state( "" ) then.
     1274         run prg-bar_init-cb-handle in this-procedure ( input v-xmllib-prg-bar-handle ) .
     1275         run prg-bar_new in this-procedure ( input 1 , input v-str-count) .
     1276         run prg-bar_show in this-procedure .
     1277       end.
     1278       create sax-reader v-xmllib-sax-reader-handle.
     1279       v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ).
     1280       v-xmllib-sax-reader-handle :sax-parse( ) no-error.
     1281       if error-status :error
     1282       then do:
     1283           run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     1284                                                                       ,vss-workfile
     1285                                                                       ,vss-revision
     1286                                                                       ,vss-description
     1287                                                                       ,chr(10)
     1288                                                                       ,return-value
     1289                                                                       ,trim(error-status :get-message(1))
     1290                                                                       ,trim(error-status :get-message(2))
     1291                                                                       ,trim(error-status :get-message(3)))
     1292                                                     ).
     1293           undo, return error .
     1294       end.
     1295       if v-xmllib-error-status <> no
     1296       then do:
     1297           run xmllib-parse-error in this-procedure (
     1298               input "*** При обработке XML файла были ошибки."
     1299           ).
     1300           delete object v-xmllib-sax-reader-handle.
     1301       end.
     1302       delete object v-xmllib-sax-reader-handle.
     1303       if valid-handle(v-xmllib-prg-bar-handle)
     1304       then do:
     1305         run prg-bar_delete in this-procedure .
     1306       end.
     1307   end.
     1308   end procedure.
     1309   procedure xmllib-parse-progressive :
     1310   define input parameter p-full-filename      as character no-undo .
     1311   define input parameter p-pack-data          as memptr no-undo .
     1312   define input parameter p-parse-first        as logical no-undo .
     1313   define input parameter p-first-err          as logical no-undo .
     1314   define output parameter p-parse-status as integer no-undo .
     1315   define variable v-num-dirs              as integer no-undo .
     1316   define variable glog                    as logical no-undo .
     1317   define variable v-pack-size             as int64 no-undo .
     1318   do
     1319   on error undo, return error
     1320   :
     1321     if p-parse-first then do:
     1322       if valid-handle(v-xmllib-sax-reader-handle)
     1323       then do:
     1324       end.
     1325       assign
     1326           v-num-dirs              = num-entries( p-full-filename,"\/":U )
     1327           v-xmllib-error-status   = no
     1328       .
     1329       if v-num-dirs > 1
     1330       then do:
     1331           assign
     1332               v-xmllib-filename = entry( v-num-dirs, p-full-filename, "\/":U )
     1333               v-xmllib-dirname  = substring( p-full-filename, 1, length( p-full-filename ) - length( v-xmllib-filename ) - 1 )
     1334           .
     1335       end.
     1336       else do:
     1337           assign
     1338               v-xmllib-filename = p-full-filename
     1339               v-xmllib-dirname  = "":U
     1340           .
     1341       end.
     1342       create sax-reader v-xmllib-sax-reader-handle.
     1343       v-pack-size = get-size (p-pack-data) .
     1344       if v-pack-size > 0 then
     1345         glog = v-xmllib-sax-reader-handle :set-input-source( "MEMPTR":U, p-pack-data ) no-error.
     1346       else
     1347         glog = v-xmllib-sax-reader-handle :set-input-source( "FILE":U, p-full-filename ) no-error.
     1348       if error-status :error
     1349       or not glog
     1350       then do:
     1351         delete object v-xmllib-sax-reader-handle.
     1352         run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     1353                                                                     ,vss-workfile
     1354                                                                     ,vss-revision
     1355                                                                     ,vss-description
     1356                                                                     ,chr(10)
     1357                                                                     ,return-value
     1358                                                                     ,trim(error-status :get-message(1))
     1359                                                                     ,trim(error-status :get-message(2))
     1360                                                                     ,trim(error-status :get-message(3)) )
     1361                                                   ).
     1362         undo, return error .
     1363       end.
     1364       v-xmllib-sax-reader-handle :sax-parse-first( ) no-error.
     1365     end.
     1366     else do:
     1367       v-xmllib-sax-reader-handle :sax-parse-next( ) no-error.
     1368     end.
     1369     if error-status :error
     1370     then do:
     1371       delete object v-xmllib-sax-reader-handle.
     1372       run xmllib-parse-error in this-procedure ( input substitute("&1 &2 &3&4Ошибка обработки XML файла.&4&5&4&5&4&7&4&8"
     1373                                                                   ,vss-workfile
     1374                                                                   ,vss-revision
     1375                                                                   ,vss-description
     1376                                                                   ,chr(10)
     1377                                                                   ,return-value
     1378                                                                   ,trim(error-status :get-message(1))
     1379                                                                   ,trim(error-status :get-message(2))
     1380                                                                   ,trim(error-status :get-message(3)) )
     1381                                                 ).
     1382       undo, return error .
     1383     end.
     1384     if v-xmllib-error-status <> no
     1385     then do:
     1386       run xmllib-parse-error in this-procedure (
     1387           input "*** При обработке XML файла были ошибки."
     1388       ).
     1389       if p-first-err then do:
     1390         delete object v-xmllib-sax-reader-handle.
     1391       end.
     1392       else do:
     1393         v-xmllib-error-status = no.
     1394       end.
     1395     end.
     1396     if v-xmllib-sax-reader-handle:parse-status = SAX-COMPLETE  then do:
     1397       p-parse-status = SAX-COMPLETE.
     1398       delete object v-xmllib-sax-reader-handle.
     1399       return '':U.
     1400     end.
     1401     else do:
     1402       p-parse-status = v-xmllib-sax-reader-handle:parse-status.
     1403       return '':U.
     1404     end.
     1405   end.
     1406   end procedure.
     1407   procedure StartElement :
     1408   define input parameter p-name-space     as character        no-undo.
     1409   define input parameter p-local-name     as character        no-undo.
     1410   define input parameter p-q-name         as character        no-undo.
     1411   define input parameter p-attributes     as handle           no-undo.
     1412       define buffer buf_rec             for temp_xmllib_rec.
     1413       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     1414       define buffer buf_rec-list        for temp_xmllib_rec-list.
     1415       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     1416   do
     1417   for buf_rec
     1418     , buf_rec-fld
     1419     , buf_rec-list
     1420     , buf_rec-fld-list
     1421   on error undo, return error
     1422   :
     1423       if valid-handle(v-xmllib-prg-bar-handle)
     1424       then do:
     1425         run prg-bar_stepto in this-procedure ( input SELF:LOCATOR-LINE-NUMBER ) .
     1426       end.
     1427       find first buf_rec-list
     1428            where buf_rec-list.recName = p-q-name
     1429       no-error.
     1430       if available buf_rec-list
     1431       then do:
     1432           if buf_rec-list.closed = no
     1433           then do:
     1434               find first buf_rec-fld-list
     1435                    where buf_rec-fld-list.recName = buf_rec-list.recName
     1436                      and buf_rec-fld-list.fldName = p-q-name
     1437               no-error.
     1438               if available buf_rec-fld-list
     1439               and buf_rec-list.recName = buf_rec-fld-list.recName
     1440               then do:
     1441                   if buf_rec-fld-list.closed = no
     1442                   then do:
     1443                       run xmllib-parse-error in this-procedure (
     1444                           input substitute( "Ошибка 1 открытия поля <&1> записи <&2>: Поле с этим именем уже открыто на строке &3."
     1445                                           , p-q-name
     1446                                           , p-q-name
     1447                                           , buf_rec-fld-list.fldOpenLine
     1448                                           )
     1449                       ).
     1450                   end.
     1451                   else do:
     1452                       run xmllib-parse-rec-fld-open in this-procedure (
     1453                             input buf_rec-list.recName
     1454                           , input buf_rec-list.recLevel
     1455                           , input buf_rec-fld-list.fldName
     1456                       ).
     1457                       assign
     1458                           buf_rec-fld-list.closed         = no
     1459                           buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1460                           buf_rec-fld-list.fldCloseLine   = 0
     1461                       .
     1462                   end.
     1463               end.
     1464               else do:
     1465                   assign
     1466                       buf_rec-list.recLevel = buf_rec-list.recLevel + 1
     1467                   .
     1468                   run xmllib-parse-rec-open in this-procedure (
     1469                         input buf_rec-list.recName
     1470                       , input buf_rec-list.recLevel
     1471                   ).
     1472                   assign
     1473                       buf_rec-list.closed         = no
     1474                       buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1475                       buf_rec-list.recCloseLine   = 0
     1476                   .
     1477               end.
     1478           end.
     1479           else do:
     1480               run xmllib-parse-rec-open in this-procedure (
     1481                     input buf_rec-list.recName
     1482                   , input buf_rec-list.recLevel
     1483               ).
     1484               assign
     1485                   buf_rec-list.closed         = no
     1486                   buf_rec-list.recOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1487                   buf_rec-list.recCloseLine   = 0
     1488               .
     1489           end.
     1490       end.
     1491       else do:
     1492           open-record:
     1493           for each buf_rec-fld-list
     1494              where buf_rec-fld-list.fldName = p-q-name
     1495           :
     1496               find first buf_rec-list
     1497                    where buf_rec-list.recName = buf_rec-fld-list.recName
     1498                      and buf_rec-list.closed  = no
     1499               no-error.
     1500               if available buf_rec-list
     1501               then do:
     1502                   run xmllib-parse-rec-fld-open in this-procedure (
     1503                         input buf_rec-list.recName
     1504                       , input buf_rec-list.recLevel
     1505                       , input buf_rec-fld-list.fldName
     1506                   ).
     1507                   assign
     1508                       buf_rec-fld-list.recLevel       = buf_rec-list.recLevel
     1509                       buf_rec-fld-list.closed         = no
     1510                       buf_rec-fld-list.fldOpenLine    = v-xmllib-sax-reader-handle :locator-line-number
     1511                       buf_rec-fld-list.fldCloseLine   = 0
     1512                   .
     1513                   leave open-record.
     1514               end.
     1515           end.
     1516       end.
     1517   end.
     1518   end procedure.
     1519   procedure Characters :
     1520   define input parameter p-char-data  as memptr.
     1521   define input parameter p-numchars   as integer.
     1522       define variable v-data-string    as character    no-undo.
     1523       define variable v-cp-utf8           as integer no-undo init 65001 .
     1524       define variable v-cp-windows1251    as integer no-undo init 1251 .
     1525       define buffer buf_xmllib_rec             for temp_xmllib_rec.
     1526       define buffer buf_xmllib_rec-fld         for temp_xmllib_rec-fld.
     1527       define buffer buf_xmllib_rec-list        for temp_xmllib_rec-list.
     1528       define buffer buf_xmllib_rec-fld-list    for temp_xmllib_rec-fld-list.
     1529   do
     1530   for buf_xmllib_rec
     1531     , buf_xmllib_rec-fld
     1532     , buf_xmllib_rec-list
     1533     , buf_xmllib_rec-fld-list
     1534   on error undo, return error
     1535   :
     1536       find first buf_xmllib_rec-list
     1537            where buf_xmllib_rec-list.closed = no
     1538       no-error.
     1539       if available buf_xmllib_rec-list
     1540       then do:
     1541           find first buf_xmllib_rec-fld-list
     1542                where buf_xmllib_rec-fld-list.closed = no
     1543           no-error.
     1544           if available buf_xmllib_rec-fld-list
     1545           and buf_xmllib_rec-fld-list.recName  = buf_xmllib_rec-list.recName
     1546           and buf_xmllib_rec-fld-list.recLevel = buf_xmllib_rec-list.recLevel
     1547           then do:
     1548               find last buf_xmllib_rec
     1549                   where buf_xmllib_rec.recName  = buf_xmllib_rec-list.recName
     1550                     and buf_xmllib_rec.recLevel = buf_xmllib_rec-list.recLevel
     1551                     and buf_xmllib_rec.closed   = no
     1552               use-index nm
     1553               no-error.
     1554               if available buf_xmllib_rec
     1555               then do:
     1556                   find last buf_xmllib_rec-fld
     1557                       where buf_xmllib_rec-fld.rec-key = buf_xmllib_rec.rec-key
     1558                         and buf_xmllib_rec-fld.fldName = buf_xmllib_rec-fld-list.fldName
     1559                         and buf_xmllib_rec-fld.closed = no
     1560                   use-index nm
     1561                   no-error.
     1562                   if available buf_xmllib_rec-fld
     1563                   then do:
     1564                       assign
     1565                           v-data-string = get-string( p-char-data, 1, get-size( p-char-data ) )
     1566                       .
     1567                       if v-xmllib-codepage-convert = yes
     1568                       then do:
     1569                         assign
     1570                             v-data-string = codepage-convert( v-data-string , v-xmllib-codepage-target , v-xmllib-codepage-source )
     1571                         .
     1572                       end.
     1573                       run xmlchar-decode in this-procedure (
     1574                           input v-data-string
     1575                           , output v-data-string
     1576                       ).
     1577                       assign
     1578                           buf_xmllib_rec-fld.fldValue = trim( substitute( "&1&2", buf_xmllib_rec-fld.fldValue, v-data-string ) )
     1579                       .
     1580                   end.
     1581               end.
     1582           end.
     1583       end.
     1584   end.
     1585   end procedure.
     1586   procedure EndElement :
     1587   define input parameter p-name-space     as character        no-undo.
     1588   define input parameter p-local-name     as character        no-undo.
     1589   define input parameter p-q-name         as character        no-undo.
     1590       define buffer buf_rec             for temp_xmllib_rec.
     1591       define buffer buf_rec-fld         for temp_xmllib_rec-fld.
     1592       define buffer buf_rec-list        for temp_xmllib_rec-list.
     1593       define buffer buf_rec-fld-list    for temp_xmllib_rec-fld-list.
     1594   do
     1595   for buf_rec
     1596     , buf_rec-fld
     1597     , buf_rec-list
     1598     , buf_rec-fld-list
     1599   on error undo, return error
     1600   :
     1601       find last buf_rec-list
     1602           where buf_rec-list.recName = p-q-name
     1603       use-index pi
     1604       no-error.
     1605       if available buf_rec-list
     1606       then do:
     1607           if buf_rec-list.closed = yes
     1608           then do:
     1609               run xmllib-parse-error in this-procedure (
     1610                   input substitute( "Ошибка закрытия записи или поля <&1>: Нет метки открытой записи."
     1611                                   , p-q-name
     1612                                   )
     1613               ).
     1614           end.
     1615           else do:
     1616               find last buf_rec
     1617                   where buf_rec.recName  = buf_rec-list.recName
     1618                     and buf_rec.recLevel = buf_rec-list.recLevel
     1619                     and buf_rec.closed   = no
     1620               use-index nm
     1621               no-error.
     1622               if not available buf_rec
     1623               then do:
     1624                   run xmllib-parse-error in this-procedure (
     1625                       input substitute( "Ошибка закрытия записи или поля <&1> уровня &2: Нет открытой записи."
     1626                                       , p-q-name
     1627                                       , buf_rec-list.recLevel
     1628                                       )
     1629                   ).
     1630               end.
     1631               else do:
     1632                   find first buf_rec-fld-list
     1633                        where buf_rec-fld-list.recName  = buf_rec.recName
     1634                          and buf_rec-fld-list.recLevel = buf_rec.recLevel
     1635                          and buf_rec-fld-list.fldName  = p-q-name
     1636                          and buf_rec-fld-list.closed   = no
     1637                   no-error.
     1638                   if not available buf_rec-fld-list
     1639                   then do:
     1640                       if buf_rec.recName <> p-q-name
     1641                       then do:
     1642                           run xmllib-parse-error in this-procedure (
     1643                               input substitute( "Ошибка закрытия записи <&1>: Имя открытой записи не совпадает с именем метки."
     1644                                               , buf_rec.recName
     1645                                               )
     1646                           ).
     1647                       end.
     1648                       else do:
     1649                           assign
     1650                               buf_rec.closed              = yes
     1651                               buf_rec.recCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     1652                               buf_rec-list.recCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     1653                           .
     1654                           if buf_rec-list.recLevel > 0
     1655                           then do:
     1656                               assign
     1657                                   buf_rec-list.recLevel = buf_rec-list.recLevel - 1
     1658                               .
     1659                               for each buf_rec-fld-list
     1660                                  where buf_rec-fld-list.recName = buf_rec-list.recName
     1661                               :
     1662                                   assign
     1663                                       buf_rec-fld-list.recLevel = buf_rec-fld-list.recLevel - 1
     1664                                   .
     1665                               end.
     1666                           end.
     1667                           else do:
     1668                               assign
     1669                                   buf_rec-list.closed         = yes
     1670                               .
     1671                           end.
     1672                       end.
     1673                   end.
     1674                   else do:
     1675                       find last buf_rec-fld
     1676                           where buf_rec-fld.rec-key = buf_rec.rec-key
     1677                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     1678                             and buf_rec-fld.closed  = no
     1679                       use-index nm
     1680                       no-error.
     1681                       if not available buf_rec-fld
     1682                       then do:
     1683                           run xmllib-parse-error in this-procedure (
     1684                               input substitute( "Ошибка 2 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     1685                                               , buf_rec-fld-list.fldName
     1686                                               , buf_rec.recName
     1687                                               , buf_rec.recLevel
     1688                                               )
     1689                           ).
     1690                       end.
     1691                       else do:
     1692                           assign
     1693                               buf_rec-fld.closed              = yes
     1694                               buf_rec-fld-list.closed         = yes
     1695                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     1696                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     1697                           .
     1698                       end.
     1699                   end.
     1700               end.
     1701           end.
     1702       end.
     1703       else do:
     1704           close-field-rec:
     1705           for each buf_rec-fld-list
     1706              where buf_rec-fld-list.fldName = p-q-name
     1707           :
     1708               find first buf_rec-list
     1709                    where buf_rec-list.recName  = buf_rec-fld-list.recName
     1710                      and buf_rec-list.recLevel = buf_rec-fld-list.recLevel
     1711                      and buf_rec-list.closed   = no
     1712               no-error.
     1713               if available buf_rec-list
     1714               then do:
     1715                   find last buf_rec
     1716                       where buf_rec.recName  = buf_rec-list.recName
     1717                         and buf_rec.recLevel = buf_rec-list.recLevel
     1718                         and buf_rec.closed   = no
     1719                   use-index nm
     1720                   no-error.
     1721                   if not available buf_rec
     1722                   then do:
     1723                       run xmllib-parse-error in this-procedure (
     1724                           input substitute( "Ошибка закрытия поля <&1>: Нет открытой записи."
     1725                                           , p-q-name
     1726                                           )
     1727                       ).
     1728                   end.
     1729                   else do:
     1730                       find last buf_rec-fld
     1731                           where buf_rec-fld.rec-key = buf_rec.rec-key
     1732                             and buf_rec-fld.fldName = buf_rec-fld-list.fldName
     1733                             and buf_rec-fld.closed  = no
     1734                       use-index nm
     1735                       no-error.
     1736                       if not available buf_rec-fld
     1737                       then do:
     1738                           run xmllib-parse-error in this-procedure (
     1739                               input substitute( "Ошибка 1 закрытия поля <&1>: Не найдено открытое поле с этим именем в записи <&2> уровня &3."
     1740                                               , buf_rec-fld-list.fldName
     1741                                               , buf_rec.recName
     1742                                               , buf_rec.recLevel
     1743                                               )
     1744                           ).
     1745                       end.
     1746                       else do:
     1747                           assign
     1748                               buf_rec-fld.closed              = yes
     1749                               buf_rec-fld-list.closed         = yes
     1750                               buf_rec-fld.fldCloseLine        = v-xmllib-sax-reader-handle :locator-line-number
     1751                               buf_rec-fld-list.fldCloseLine   = v-xmllib-sax-reader-handle :locator-line-number
     1752                           .
     1753                       end.
     1754                   end.
     1755                   leave close-field-rec.
     1756               end.
     1757           end.
     1758       end.
     1759   end.
     1760   end procedure.
     1761   procedure Error :
     1762   define input parameter p-error-message     as character        no-undo.
     1763   do
     1764   on error undo, return error
     1765   :
     1766       run xmllib-parse-error in this-procedure (
     1767           input p-error-message
     1768       ).
     1769       assign
     1770           v-xmllib-error-status = yes
     1771       .
     1772   end.
     1773   end procedure.
     1774   procedure xmllib-parse-error :
     1775   define input parameter p-err-message    as character        no-undo.
     1776   do
     1777   on error undo, return error
     1778   :
     1779       if valid-handle(v-xmllib-log-handle) then do:
     1780         run value(v-xmllib-log-proc-name) in  v-xmllib-log-handle
     1781                  (input substitute("&1Файл:    &2 &3&1Строка &4&1&5"
     1782                                    ,chr(10)
     1783                                    ,v-xmllib-dirname
     1784                                    ,v-xmllib-filename
     1785                                    ,(if valid-handle(v-xmllib-sax-reader-handle)
     1786                                      then v-xmllib-sax-reader-handle :locator-line-number
     1787                                      else ?)
     1788                                    ,p-err-message)).
     1789       end.
     1790       else do:
     1791         if v-xmllib-log-filename = "":U
     1792         then do:
     1793             message
     1794                     vss-workfile vss-revision vss-description
     1795                 skip "Файл:   " v-xmllib-dirname v-xmllib-filename
     1796                 skip "Строка: " (if valid-handle(v-xmllib-sax-reader-handle)
     1797                                  then v-xmllib-sax-reader-handle :locator-line-number
     1798                                  else ?)
     1799                 skip(1)
     1800                 skip p-err-message
     1801                 skip return-value
     1802                 skip trim( error-status :get-message( 1 ) )
     1803                     trim( error-status :get-message( 2 ) )
     1804                     trim( error-status :get-message( 3 ) )
     1805             view-as alert-box error.
     1806             undo, return error.
     1807         end.
     1808         else do:
     1809           output to value( v-xmllib-log-filename ).
     1810           put unformatted
     1811               substitute( "&1&2", chr(10), p-err-message )
     1812           .
     1813           output close.
     1814         end.
     1815       end.
     1816   end.
     1817   end procedure.
     1818   procedure xmllib-set-log-filename :
     1819   define input parameter p-log-filename   as character        no-undo.
     1820   do
     1821   on error undo, return error
     1822   :
     1823       run gbl/fileapnd.p (
     1824             input p-log-filename
     1825           , input "":U
     1826           , input 10
     1827       ) no-error.
     1828       if error-status :error
     1829       then do:
     1830           assign
     1831               v-xmllib-log-filename = "":U
     1832           .
     1833       end.
     1834       else do:
     1835           assign
     1836               v-xmllib-log-filename = p-log-filename
     1837           .
     1838       end.
     1839   end.
     1840   end procedure.
     1841   procedure xmllib-set-log-handle :
     1842   define input parameter p-log-handle    as handle        no-undo.
     1843   define input parameter p-log-proc-name as character no-undo .
     1844   do
     1845   on error undo, return error
     1846   :
     1847       if valid-handle(p-log-handle)
     1848       and lookup(p-log-proc-name, p-log-handle:internal-entries) > 0
     1849       then do:
     1850         assign
     1851         v-xmllib-log-handle    = p-log-handle
     1852         v-xmllib-log-proc-name = p-log-proc-name
     1853         .
     1854       end.
     1855       else do:
     1856         assign
     1857         v-xmllib-log-handle    = ?
     1858         v-xmllib-log-proc-name = '':U
     1859         .
     1860       end.
     1861   end.
     1862   end procedure.
     1863   procedure xmllib-set-prg-bar-handle :
     1864   define input parameter p-handle    as handle        no-undo.
     1865   do
     1866   on error undo, return error
     1867   :
     1868       if valid-handle(p-handle)
     1869       then do:
     1870         assign
     1871           v-xmllib-prg-bar-handle = p-handle
     1872         .
     1873       end.
     1874       else do:
     1875         assign
     1876           v-xmllib-prg-bar-handle = ?
     1877         .
     1878       end.
     1879   end.
     1880   end procedure.
     1881   procedure xmllib-set-codepage-convert :
     1882     define input  parameter p-codepage-source as character no-undo .
     1883     define input  parameter p-codepage-target as character no-undo .
     1884   do
     1885   on error undo, return error return-value
     1886   :
     1887     if ( p-codepage-source <> "" and p-codepage-target <> "" )
     1888     then do:
     1889       assign
     1890         v-xmllib-codepage-convert = yes
     1891         v-xmllib-codepage-source  = p-codepage-source
     1892         v-xmllib-codepage-target  = p-codepage-target
     1893       .
     1894     end.
     1895     else do:
     1896       assign
     1897         v-xmllib-codepage-convert = no
     1898         v-xmllib-codepage-source  = ""
     1899         v-xmllib-codepage-target  = ""
     1900       .
     1901     end.
     1902   end.
     1903   end procedure.
     1904   procedure xmllib-parse-rec-open :
     1905   define input parameter p-rec-name   as character        no-undo.
     1906   define input parameter p-rec-level  as integer          no-undo.
     1907       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     1908   do
     1909   for buf_temp_xmllib_rec
     1910   on error undo, return error
     1911   :
     1912        find first buf_temp_xmllib_rec
     1913            where buf_temp_xmllib_rec.recName = p-rec-name
     1914              and buf_temp_xmllib_rec.recLevel = p-rec-level
     1915              and buf_temp_xmllib_rec.closed  = no
     1916       use-index nm
     1917       no-error.
     1918       if available buf_temp_xmllib_rec
     1919       then do:
     1920           run xmllib-parse-error in this-procedure (
     1921               input substitute( "Ошибка 2 открытия записи <&1>: Запись с этим именем и уровнем &2 уже открыта на строке &3."
     1922                               , p-rec-name
     1923                               , p-rec-level
     1924                               , buf_temp_xmllib_rec.recOpenLine
     1925                               )
     1926           ).
     1927       end.
     1928       else do:
     1929           assign
     1930               v-xmllib-rec-key    = v-xmllib-rec-key + 1
     1931           .
     1932           create buf_temp_xmllib_rec.
     1933           assign
     1934               buf_temp_xmllib_rec.rec-key         = v-xmllib-rec-key
     1935               buf_temp_xmllib_rec.recOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     1936               buf_temp_xmllib_rec.recCloseLine    = 0
     1937               buf_temp_xmllib_rec.recName         = p-rec-name
     1938               buf_temp_xmllib_rec.recLevel        = p-rec-level
     1939               buf_temp_xmllib_rec.closed          = no
     1940           .
     1941       end.
     1942   end.
     1943   end procedure.
     1944   procedure xmllib-parse-rec-fld-open :
     1945   define input parameter p-rec-name   as character        no-undo.
     1946   define input parameter p-rec-level  as integer          no-undo.
     1947   define input parameter p-fld-name   as character        no-undo.
     1948       define buffer buf_temp_xmllib_rec       for temp_xmllib_rec.
     1949       define buffer buf_temp_xmllib_rec-fld   for temp_xmllib_rec-fld.
     1950   do
     1951   for buf_temp_xmllib_rec
     1952     , buf_temp_xmllib_rec-fld
     1953   on error undo, return error substitute( "Ошибка в xmllib-parse-rec-fld-open. &1. &2. &3"
     1954                                           , return-value
     1955                                           , trim( error-status :get-message( 1 ) )
     1956                                           , trim( error-status :get-message( 2 ) ) )
     1957   :
     1958       find last buf_temp_xmllib_rec
     1959           where buf_temp_xmllib_rec.recName   = p-rec-name
     1960             and buf_temp_xmllib_rec.recLevel  = p-rec-level
     1961             and buf_temp_xmllib_rec.closed    = no
     1962       use-index nm
     1963       no-error.
     1964       if not available buf_temp_xmllib_rec
     1965       then do:
     1966           run xmllib-parse-error in this-procedure (
     1967               input substitute( "Ошибка 2 открытия поля <&2> в записи <&1> уровня &3: Нет открытой записи."
     1968                               , p-rec-name
     1969                               , p-fld-name
     1970                               , p-rec-level
     1971                               )
     1972           ).
     1973       end.
     1974       else do:
     1975           find last buf_temp_xmllib_rec-fld
     1976               where buf_temp_xmllib_rec-fld.rec-key  = buf_temp_xmllib_rec.rec-key
     1977                 and buf_temp_xmllib_rec-fld.fldName  = p-fld-name
     1978                 and buf_temp_xmllib_rec-fld.closed   = no
     1979           use-index nm
     1980           no-error.
     1981           if available buf_temp_xmllib_rec-fld
     1982           then do:
     1983               run xmllib-parse-error in this-procedure (
     1984                   input substitute( "Ошибка 3 открытия поля <&2> в записи <&1>: Поле с этим именем уже открыто на строке &3."
     1985                                   , p-rec-name
     1986                                   , p-fld-name
     1987                                   , buf_temp_xmllib_rec-fld.fldOpenLine
     1988                                   )
     1989               ).
     1990           end.
     1991           else do:
     1992               assign
     1993                   v-xmllib-rec-fld-key    = v-xmllib-rec-fld-key + 1
     1994               .
     1995               create buf_temp_xmllib_rec-fld.
     1996               assign
     1997                   buf_temp_xmllib_rec-fld.fld-key         = v-xmllib-rec-fld-key
     1998                   buf_temp_xmllib_rec-fld.rec-key         = buf_temp_xmllib_rec.rec-key
     1999                   buf_temp_xmllib_rec-fld.fldOpenLine     = v-xmllib-sax-reader-handle :locator-line-number
     2000                   buf_temp_xmllib_rec-fld.fldCloseLine    = 0
     2001                   buf_temp_xmllib_rec-fld.fldName         = p-fld-name
     2002                   buf_temp_xmllib_rec-fld.closed          = no
     2003               .
     2004           end.
     2005       end.
     2006   end.
     2007   end procedure.
     2008   define variable vss-include-info4 as character format "X(65)" no-undo
     2009   initial "@(#)$Workfile$ $Revision$".
     2010   define variable v-filelist-total-file-num           as integer      no-undo .
     2011   define variable v-filelist-total-dir-num            as integer      no-undo .
     2012   define variable v-filelist-main-procedure-handle    as handle       no-undo .
     2013   define variable v-filelist-main-procedure-name      as character    no-undo .
     2014   define temp-table temp-dirlist no-undo
     2015       field dir-full-name     as character
     2016       field dir-short-name    as character
     2017       field need-process      as logical
     2018       index xpk is primary unique dir-full-name
     2019   .
     2020   define temp-table temp-filelist no-undo
     2021     field file-name        as character
     2022     field file-name-no-ext as character
     2023     field file-extension   as character
     2024     field directory-name   as character
     2025     field full-name        as character
     2026     field dir-short-name   as character
     2027     field need-process     as logical
     2028     index xpk is unique primary full-name
     2029     index xie1 directory-name file-name
     2030     index xie2 directory-name file-name-no-ext
     2031     index xie3 file-name
     2032     index xie4 file-name-no-ext
     2033     index xie5 need-process file-name
     2034     .
     2035   define stream dir-list .
     2036   procedure filelist-get-file-num :
     2037     define output parameter p-file-num as integer   no-undo .
     2038     do
     2039     on error undo, return error return-value
     2040     :
     2041       assign
     2042         p-file-num = v-filelist-total-file-num
     2043       .
     2044     end.
     2045   end procedure.
     2046   procedure filelist-clear :
     2047     do
     2048     on error undo, return error return-value
     2049     :
     2050       define buffer buf_filelist for temp-filelist .
     2051       assign
     2052         v-filelist-total-file-num = 0
     2053       .
     2054       for each buf_filelist
     2055       on error undo, return error
     2056       :
     2057         delete buf_filelist .
     2058       end.
     2059     end.
     2060   end procedure.
     2061   procedure filelist-init :
     2062     do
     2063     on error undo, return error
     2064     :
     2065       define input parameter p-dir-name       as character no-undo .
     2066       define input parameter p-filter-ext     as logical   no-undo .
     2067       define input parameter p-ext-list       as character no-undo .
     2068       define input parameter p-dir-short-name as character no-undo .
     2069       define buffer buf_temp-filelist for temp-filelist .
     2070       if p-filter-ext = true
     2071          and p-ext-list = ?
     2072       or (p-filter-ext = false
     2073          and p-ext-list <> ?
     2074          and p-ext-list <> "":U
     2075          )
     2076       then do:
     2077         message
     2078           vss-workfile vss-revision vss-description skip
     2079           "Ошибка задания входных параметров" skip
     2080           "p-filter-ext" p-filter-ext skip
     2081           "p-ext-list"   p-ext-list   skip
     2082           view-as alert-box error .
     2083         undo, return error .
     2084       end.
     2085       for each buf_temp-filelist
     2086         where buf_temp-filelist.directory-name = p-dir-name
     2087       on error undo, return error return-value
     2088       :
     2089         delete buf_temp-filelist .
     2090       end.
     2091       input stream dir-list from os-dir( p-dir-name ).
     2092       define variable v-file                  as character no-undo .
     2093       define variable v-path                  as character no-undo .
     2094       define variable v-mask                  as character no-undo .
     2095       define variable v-extension             as character no-undo .
     2096       define variable v-file-name-without-ext as character no-undo .
     2097       repeat
     2098       on error undo, return error
     2099       :
     2100         import stream dir-list v-file v-path v-mask .
     2101         if  v-mask <> ?
     2102         and v-mask begins 'F':u
     2103         then do:
     2104         end.
     2105         else do:
     2106           next .
     2107         end.
     2108         if num-entries(v-file, '.':u) > 1
     2109         then do:
     2110           assign
     2111             v-extension = entry(num-entries(v-file, '.':u), v-file,  '.':u )
     2112             v-file-name-without-ext = entry(num-entries(v-file, '.':u) - 1, v-file, '.':u )
     2113           .
     2114         end.
     2115         else do:
     2116           assign
     2117             v-extension = ''
     2118             v-file-name-without-ext = v-file
     2119           .
     2120         end.
     2121         if p-filter-ext = true
     2122         then do:
     2123           if lookup(v-extension, p-ext-list) = 0
     2124           then do:
     2125             next .
     2126           end.
     2127         end.
     2128         create buf_temp-filelist .
     2129         assign
     2130           buf_temp-filelist.file-name        = v-file
     2131           buf_temp-filelist.directory-name   = p-dir-name
     2132           buf_temp-filelist.file-name-no-ext = v-file-name-without-ext
     2133           buf_temp-filelist.file-extension   = v-extension
     2134           buf_temp-filelist.full-name        = p-dir-name + '/':u + v-file
     2135           buf_temp-filelist.dir-short-name   = p-dir-short-name
     2136         .
     2137         assign
     2138           v-filelist-total-file-num = v-filelist-total-file-num + 1
     2139         .
     2140         if v-filelist-main-procedure-handle <> ?
     2141         then do:
     2142           run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle
     2143             (input "file":U
     2144             , input v-filelist-total-file-num
     2145             , input buf_temp-filelist.full-name
     2146             , input buf_temp-filelist.file-name
     2147             ) no-error.
     2148           if error-status :error
     2149           then do:
     2150             message
     2151               vss-workfile vss-revision vss-description skip
     2152               "filelist-dirlist-subdir-init" skip(1)
     2153               skip "Ошибка при вызове процедуры вывода"
     2154               skip "результатов сканирования каталогов."
     2155               skip return-value
     2156               skip trim(error-status :get-message(1))
     2157                       trim(error-status :get-message(2))
     2158                       trim(error-status :get-message(3))
     2159               view-as alert-box error.
     2160             undo, return error .
     2161           end.
     2162         end.
     2163       end.
     2164       input stream dir-list close .
     2165       return.
     2166     end.
     2167   end procedure.
     2168   procedure filelist-dirlist-init-by-list :
     2169     do
     2170     on error undo, return error
     2171     :
     2172       define input parameter p-root-dir   as character no-undo .
     2173       define input parameter p-dir-list   as character no-undo .
     2174       define input parameter p-filter-ext as logical   no-undo .
     2175       define input parameter p-ext-list   as character no-undo .
     2176       define variable v-num-appdir as integer   no-undo .
     2177       do v-num-appdir = 1 to num-entries(p-dir-list)
     2178       :
     2179         define variable v-curr-dir  as character no-undo .
     2180         assign
     2181           v-curr-dir = entry(v-num-appdir, p-dir-list)
     2182         .
     2183         run filelist-init in this-procedure
     2184           (input p-root-dir + '/':u + v-curr-dir
     2185           ,input p-filter-ext
     2186           ,input p-ext-list
     2187           ,input v-curr-dir
     2188           ) .
     2189       end.
     2190     end.
     2191   end procedure.
     2192   procedure filelist-dirlist-clear :
     2193     do
     2194     on error undo, return error
     2195     :
     2196       define buffer buf_temp-dirlist for temp-dirlist .
     2197       assign
     2198           v-filelist-total-dir-num = 0
     2199       .
     2200       for each buf_temp-dirlist
     2201       on error undo, return error
     2202       :
     2203         delete buf_temp-dirlist .
     2204       end.
     2205     end.
     2206   end procedure.
     2207   procedure filelist-dirlist-subdir-init :
     2208   define input parameter p-dir-name   as character no-undo .
     2209       define buffer buf_temp-dirlist for temp-dirlist .
     2210   do
     2211   for buf_temp-dirlist
     2212   on error undo, return error
     2213   :
     2214       assign
     2215           file-info :file-name = p-dir-name
     2216       .
     2217       if file-info :full-pathname = ?
     2218       or index( file-info :file-type, "D" ) = 0
     2219       then do:
     2220           message
     2221               vss-workfile vss-revision vss-description skip
     2222               "filelist-dirlist-init: Заданного каталога не существует."
     2223               skip (1)
     2224               skip "Задан каталог:"
     2225               skip substitute( "'&1'", p-dir-name )
     2226           view-as alert-box error .
     2227           undo, return error .
     2228       end.
     2229       input stream dir-list from os-dir( p-dir-name ).
     2230       define variable v-file                  as character no-undo .
     2231       define variable v-path                  as character no-undo .
     2232       define variable v-mask                  as character no-undo .
     2233       file-in-directory:
     2234       repeat
     2235       on error undo, return error
     2236       :
     2237           import stream dir-list
     2238               v-file
     2239               v-path
     2240               v-mask
     2241           .
     2242           if  v-mask = ?
     2243           or index( v-mask, 'D':u ) = 0
     2244           or v-file = ".":U
     2245           or v-file = "..":U
     2246           then do:
     2247               next file-in-directory.
     2248           end.
     2249           else do:
     2250               find first buf_temp-dirlist
     2251                    where buf_temp-dirlist.dir-full-name    = v-path
     2252               no-error.
     2253               if not available buf_temp-dirlist
     2254               then do:
     2255                   create buf_temp-dirlist .
     2256                   assign
     2257                       buf_temp-dirlist.dir-full-name    = v-path
     2258                       buf_temp-dirlist.dir-short-name   = v-file
     2259                       buf_temp-dirlist.need-process     = yes
     2260                   .
     2261               end.
     2262               assign
     2263                   v-filelist-total-dir-num = v-filelist-total-dir-num + 1
     2264               .
     2265               if v-filelist-main-procedure-handle <> ?
     2266               then do:
     2267                   run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle (
     2268                         input "dir":U
     2269                       , input v-filelist-total-dir-num
     2270                       , input buf_temp-dirlist.dir-full-name
     2271                       , input buf_temp-dirlist.dir-short-name
     2272                   ) no-error.
     2273                   if error-status :error
     2274                   then do:
     2275                       message
     2276                           vss-workfile vss-revision vss-description skip
     2277                           "filelist-dirlist-subdir-init"
     2278                           skip(1)
     2279                           skip "Ошибка при вызове процедуры вывода"
     2280                           skip "результатов сканирования каталогов."
     2281                           skip return-value
     2282                           skip trim(error-status :get-message(1))
     2283                                trim(error-status :get-message(2))
     2284                                trim(error-status :get-message(3))
     2285                       view-as alert-box error.
     2286                       undo, return error .
     2287                   end.
     2288               end.
     2289           end.
     2290       end.
     2291       input stream dir-list close .
     2292   end.
     2293   end procedure.
     2294   procedure filelist-dirlist-init :
     2295   define input parameter p-dir-name   as character no-undo .
     2296       define variable v-file  as character no-undo.
     2297       define variable v-path  as character no-undo.
     2298       define variable v-mask  as character no-undo.
     2299       define buffer buf_temp-dirlist for temp-dirlist .
     2300   do
     2301   for buf_temp-dirlist
     2302   on error undo, return error
     2303   :
     2304       assign
     2305           file-info :file-name = p-dir-name
     2306       .
     2307       if file-info :full-pathname = ?
     2308       or index( file-info :file-type, "D" ) = 0
     2309       then do:
     2310           message
     2311               vss-workfile vss-revision vss-description skip
     2312               "filelist-dirlist-init: Заданного каталога не существует."
     2313               skip (1)
     2314               skip "Задан каталог:"
     2315               skip substitute( "'&1'", p-dir-name )
     2316           view-as alert-box error .
     2317           undo, return error .
     2318       end.
     2319       for each buf_temp-dirlist
     2320          where buf_temp-dirlist.dir-full-name begins file-info :full-pathname
     2321       on error undo, return error return-value
     2322       :
     2323           delete buf_temp-dirlist .
     2324       end.
     2325       create buf_temp-dirlist .
     2326       assign
     2327           buf_temp-dirlist.dir-full-name    = file-info :full-pathname
     2328           buf_temp-dirlist.dir-short-name   = file-info :file-name
     2329           buf_temp-dirlist.need-process     = yes
     2330       .
     2331       do
     2332       while available buf_temp-dirlist
     2333       on error undo, return error
     2334       :
     2335           run filelist-dirlist-subdir-init in this-procedure (
     2336               input buf_temp-dirlist.dir-full-name
     2337           ).
     2338           assign
     2339               buf_temp-dirlist.need-process = no
     2340           .
     2341           find first buf_temp-dirlist
     2342                where buf_temp-dirlist.need-process = yes
     2343           no-error.
     2344       end.
     2345   end.
     2346   end procedure.
     2347   procedure filelist-set-procedure-handle :
     2348   define input parameter p-proc-handle    as handle           no-undo.
     2349   define input parameter p-proc-name      as character        no-undo.
     2350       define variable v-signature    as character    no-undo.
     2351   do
     2352   on error undo, return error
     2353   :
     2354       if p-proc-handle = ?
     2355       or not valid-handle( p-proc-handle )
     2356       or p-proc-handle :get-signature( p-proc-name ) = ""
     2357       then do:
     2358           assign
     2359               v-filelist-main-procedure-handle = ?
     2360               v-filelist-main-procedure-name   = ""
     2361           .
     2362           undo, return error "filelist-set-procedure-handle: Ошибка передачи handle основной процедуры или имени процедуры обработки результатов сканирования каталогов.".
     2363       end.
     2364       else do:
     2365           assign
     2366               v-signature = p-proc-handle :get-signature( p-proc-name )
     2367           .
     2368           if entry(   1, v-signature )    = "PROCEDURE":U
     2369           and entry( 1, entry(  3, v-signature ), " ":U ) = "INPUT":U
     2370           and entry( 3, entry(  3, v-signature ), " ":U ) = "CHARACTER":U
     2371           and entry( 1, entry(  4, v-signature ), " ":U ) = "INPUT":U
     2372           and entry( 3, entry(  4, v-signature ), " ":U ) = "INTEGER":U
     2373           and entry( 1, entry(  5, v-signature ), " ":U ) = "INPUT":U
     2374           and entry( 3, entry(  5, v-signature ), " ":U ) = "CHARACTER":U
     2375           and entry( 1, entry(  6, v-signature ), " ":U ) = "INPUT":U
     2376           and entry( 3, entry(  6, v-signature ), " ":U ) = "CHARACTER":U
     2377           then do:
     2378               assign
     2379                   v-filelist-main-procedure-handle = p-proc-handle
     2380                   v-filelist-main-procedure-name   = p-proc-name
     2381               .
     2382           end.
     2383           else do:
     2384               assign
     2385                   v-filelist-main-procedure-handle = ?
     2386                   v-filelist-main-procedure-name   = ""
     2387               .
     2388               undo, return error "filelist-set-procedure-handle: Ошибка задания параметров процедуры обработки результатов сканирования каталогов.".
     2389           end.
     2390       end.
     2391   end.
     2392   end procedure.
     2393   procedure filelist-clear-procedure-handle :
     2394   do
     2395   on error undo, return error
     2396   :
     2397       assign
     2398           v-filelist-main-procedure-handle = ?
     2399           v-filelist-main-procedure-name   = ?
     2400       .
     2401   end.
     2402   end procedure.
     2403   procedure filelist-build-by-dirlist :
     2404       define buffer buf_temp-dirlist      for temp-dirlist.
     2405   do
     2406   for buf_temp-dirlist
     2407   on error undo, return error
     2408   :
     2409       for each buf_temp-dirlist
     2410       on error undo, return error
     2411       :
     2412           run filelist-init in this-procedure (
     2413                 input buf_temp-dirlist.dir-full-name
     2414               , input no
     2415               , input "":U
     2416               , input buf_temp-dirlist.dir-short-name
     2417           ).
     2418       end.
     2419   end.
     2420   end procedure.
     2421   procedure filelist-check-dir-exists :
     2422   define input parameter p-dir-name   as character        no-undo.
     2423   define output parameter p-exists    as logical          no-undo.
     2424   do
     2425   on error undo, return error
     2426   :
     2427       assign
     2428           file-info :file-name = p-dir-name
     2429       .
     2430       if file-info :file-type <> ?
     2431       and substring( file-info :file-type, 1, 1 ) = "D":U
     2432       then do:
     2433           assign
     2434               p-exists = yes
     2435           .
     2436       end.
     2437       else do:
     2438           assign
     2439               p-exists = no
     2440           .
     2441       end.
     2442   end.
     2443   end procedure.
     2444   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2445   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2446   define  shared variable g#auto-pid           as integer   no-undo .
     2447   define  shared variable conn-par             as character no-undo .
     2448   define  shared variable g#auto-user-id       as character no-undo .
     2449   define  shared variable g#auto-user-login    as character no-undo .
     2450   define  shared variable g#auto-user-password as character no-undo .
     2451   define  shared variable v-socket             as logical   no-undo .
     2452   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2453   define  shared variable auto-window-h     as handle    no-undo .
     2454   define  shared variable auto-log-msg-h    as handle    no-undo .
     2455   define  shared variable hand-log-msg-h    as handle    no-undo .
     2456   define  shared variable log-file-name     as character no-undo initial ? .
     2457   define  shared variable add-log-file-name as character no-undo initial ? .
     2458   define  shared variable writelogvalue     as character no-undo initial ? .
     2459   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2460   define stream LogStream .
     2461   define variable mNoTime as logical no-undo.
     2462   procedure write-to-log-notime :
     2463     define input param i-str as character no-undo .
     2464     mNoTime = yes.
     2465     run write-to-log (i-str).
     2466     mNoTime = no.
     2467   end.
     2468   procedure write-to-log :
     2469     define input param p-str as character no-undo .
     2470     do
     2471     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2472     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
     2473     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
     2474     :
     2475       define variable log-res        as logical   no-undo .
     2476       define variable v-jj           as integer   no-undo .
     2477       if    mNoTime
     2478          or writelogvalue eq "AsyncProc"
     2479       then
     2480          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
     2481       else
     2482          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
     2483       if auto-log-msg-h <> ? then do:
     2484         log-res = auto-log-msg-h:move-to-eof( ) .
     2485         log-res = auto-log-msg-h:insert-string( p-str ).
     2486       end.
     2487       if hand-log-msg-h <> ? then do:
     2488         log-res = hand-log-msg-h:move-to-eof( ) .
     2489         log-res = hand-log-msg-h:insert-string( p-str ).
     2490       end.
     2491       assign
     2492         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
     2493         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
     2494         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
     2495       .
     2496       if add-log-file-name <> ? then do:
     2497         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
     2498           run gbl/fileapnd.p
     2499             ( input entry(v-jj, add-log-file-name, chr(1) )
     2500             ,input p-str
     2501             ,input 20
     2502             ) no-error .
     2503           if error-status:error then do:
     2504             return error return-value .
     2505           end.
     2506         end.
     2507       end.
     2508       if writelogvalue eq "AsyncProc"
     2509       then do:
     2510          p-str = trim(p-str, (chr(13) + chr(10)) )
     2511       .
     2512          Publish "WriteLogAsunc" (p-str,yes).
     2513       end.
     2514       else if writelogvalue <> "yes" then do:
     2515         run gbl/fileapnd.p
     2516           ( input log-file-name
     2517           ,input p-str
     2518           ,input 20
     2519           ) no-error .
     2520         if error-status:error then do:
     2521           return error return-value .
     2522         end.
     2523       end.
     2524     end.
     2525   end procedure.
     2526   procedure write-to-screen :
     2527     define input param p-str as character no-undo .
     2528     do
     2529     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2530     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
     2531     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
     2532     :
     2533       define variable log-res as logical no-undo.
     2534       assign
     2535         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
     2536       .
     2537       if auto-log-msg-h <> ?
     2538       then do:
     2539         log-res = auto-log-msg-h:move-to-eof( ) .
     2540         log-res = auto-log-msg-h:insert-string( p-str ).
     2541       end.
     2542       if hand-log-msg-h <> ?
     2543       then do:
     2544         log-res = hand-log-msg-h:move-to-eof( ) .
     2545         log-res = hand-log-msg-h:insert-string( p-str ).
     2546       end.
     2547     end.
     2548   end procedure.
     2549   procedure send-msg-to-email :
     2550     define input  parameter p-subject      as character no-undo .
     2551     define input  parameter p-text-err     as character no-undo .
     2552     define input  parameter p-attach-files as character no-undo .
     2553     do
     2554     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2555     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
     2556     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
     2557     :
     2558       define variable v-tth             as handle    no-undo .
     2559       define variable v-value-character as character no-undo .
     2560       define variable v-value-date      as date      no-undo .
     2561       define variable v-value-decimal   as decimal   no-undo .
     2562       define variable v-value-integer   as integer   no-undo .
     2563       define variable v-value-logical   as logical   no-undo .
     2564       define variable v-param-type      as character no-undo .
     2565       define variable v-email       as character no-undo .
     2566       define variable v-tmp-str     as character no-undo .
     2567       define variable v-tmp1-str    as character no-undo .
     2568       define variable v-ind         as integer   no-undo .
     2569       define variable v-num-entries as integer   no-undo .
     2570       delete object v-tth no-error.
     2571       run adm/shattri.p
     2572         ( input "get":U
     2573          ,input  "":U
     2574          ,input  0
     2575          ,input  'auto-task':U
     2576          ,input  'send-msg-to-email':U
     2577          ,output v-value-character
     2578          ,output v-value-date
     2579          ,output v-value-decimal
     2580          ,output v-value-integer
     2581          ,output v-value-logical
     2582          ,output v-param-type
     2583          ,input-output table-handle v-tth
     2584         ) no-error .
     2585       if not error-status :error  then do:
     2586         assign
     2587           v-tmp-str = v-value-character
     2588         .
     2589       end.
     2590       delete object v-tth no-error.
     2591       assign
     2592         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
     2593         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
     2594         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
     2595         v-num-entries = num-entries( v-tmp-str, chr(44) )
     2596         v-email       = "":U
     2597       .
     2598       do v-ind = 1 to v-num-entries
     2599       :
     2600         assign
     2601           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
     2602         .
     2603         if trim( v-tmp1-str ) <> "":U then do:
     2604           if v-email = "":U then do:
     2605             assign
     2606               v-email = v-tmp1-str
     2607             .
     2608           end.
     2609           else do:
     2610             assign
     2611               v-email = v-email + chr(44) + v-tmp1-str
     2612             .
     2613           end.
     2614         end.
     2615       end.
     2616       if v-email <> "":U then do:
     2617         run gbl/sendmail.p
     2618           ( input v-email
     2619           , input p-subject
     2620           , input p-text-err
     2621           , input p-attach-files
     2622           ) no-error .
     2623         if error-status :error
     2624           or return-value <> "":U
     2625         then do:
     2626           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
     2627         end.
     2628       end.
     2629     end.
     2630   end procedure.
