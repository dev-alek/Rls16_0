        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle    no-undo.
        3   define input parameter p-parent-handle      as widget-handle    no-undo.
        4   define input parameter p-log-handle         as handle           no-undo.
        5   define input parameter p-parameter-string   as character        no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Экспорт в файл OpenXML".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure cur-time :
       83      define output parameter p-today as date      no-undo .
       84      define output parameter p-time  as integer   no-undo .
       85     do
       86     on error undo, return error
       87     :
       88       define variable v-date1 as date      no-undo .
       89       define variable v-date2 as date      no-undo .
       90       define variable v-time  as integer   no-undo .
       91       assign
       92         v-date1 = today
       93         v-time  = time
       94         v-date2 = today
       95       .
       96       if v-date1 <> v-date2
       97       then do:
       98         assign
       99           v-date1 = today
      100           v-time  = v-time
      101         .
      102       end.
      103       assign
      104         p-today = v-date1
      105         p-time  = v-time
      106       .
      107     end.
      108   end.
      109   function cur-time-date returns character
      110   :
      111     return string(today, '99/99/9999':U) .
      112   end.
      113   function cur-time-mjd returns decimal
      114   :
      115     define variable v-date as date      no-undo .
      116     define variable v-time as integer   no-undo .
      117     run cur-time in this-procedure
      118       (output v-date
      119       ,output v-time
      120       ) .
      121     return integer(v-date) - 2400002 + (v-time / 86400) .
      122   end.
      123   function cur-time-get-ending-index returns integer
      124   (input p-number as integer
      125   )
      126   :
      127     if p-number < 0
      128     or p-number = ?
      129     then do:
      130       return 1 .
      131     end.
      132     define variable v-rest as integer   no-undo .
      133     assign
      134       p-number = p-number modulo 100
      135     .
      136     if p-number < 20
      137     then do:
      138       assign
      139         v-rest = p-number
      140       .
      141     end.
      142     else do:
      143       assign
      144         v-rest = p-number modulo 10
      145       .
      146     end.
      147     case v-rest :
      148       when 1
      149       then do:
      150         return 2 .
      151       end.
      152       when 2 or
      153       when 3 or
      154       when 4
      155       then do:
      156         return 3 .
      157       end.
      158       otherwise do:
      159         return 1 .
      160       end.
      161     end case .
      162   end.
      163   procedure cur-time-mjd-to-date :
      164      define input  parameter i-mjd-diff as decimal no-undo.
      165      define output parameter o-Date     as date    no-undo.
      166      define output parameter o-Time     as integer no-undo.
      167      define variable v-day-number as integer   no-undo .
      168      if    i-mjd-diff < 0
      169         or i-mjd-diff = ?
      170      then do:
      171         return "?" .
      172      end.
      173      assign
      174         v-day-number = truncate(i-mjd-diff,0).
      175         o-Date = date(v-day-number + 2400002).
      176         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      177     .
      178   end.
      179   function cur-time-mjd-to-string returns character
      180   (input p-mjd-diff as decimal
      181   )
      182   :
      183     define variable v-day-number as integer   no-undo .
      184     define variable v-seconds    as integer   no-undo .
      185     define variable v-hour       as integer   no-undo .
      186     define variable v-min        as integer   no-undo .
      187     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      188     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      189     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      190     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      191     if p-mjd-diff < 0
      192     or p-mjd-diff = ?
      193     then do:
      194       return "?" .
      195     end.
      196     assign
      197       v-day-number = integer(truncate(p-mjd-diff,0))
      198       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      199     .
      200     if v-seconds > 86400
      201     then do:
      202       assign
      203         v-seconds = 86400 - 1
      204       .
      205     end.
      206     if v-seconds < 0
      207     then do:
      208       assign
      209         v-seconds = 0
      210       .
      211     end.
      212     assign
      213       v-hour = truncate(v-seconds / 3600, 0)
      214     .
      215     assign
      216       v-seconds = v-seconds modulo 3600
      217     .
      218     assign
      219       v-min = truncate(v-seconds / 60, 0)
      220     .
      221     assign
      222       v-seconds = v-seconds modulo 60
      223     .
      224     return
      225         (if v-day-number <> 0
      226           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      227           else ""
      228         )
      229       + (if v-day-number <> 0 or v-hour <> 0
      230           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      231           else ""
      232         )
      233       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      234           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      235           else ""
      236         )
      237       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      238       .
      239   end.
      240   function cur-time-string returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      249   end.
      250   function cur-time-string-sec returns character
      251   :
      252     define variable v-date as date      no-undo .
      253     define variable v-time as integer   no-undo .
      254     run cur-time in this-procedure
      255       (output v-date
      256       ,output v-time
      257       ) .
      258     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      259   end.
      260   function cur-time-custom  returns character
      261   (input p-prefix as character
      262   ,input p-date-format as character
      263   ,input p-delimiter as character
      264   ,input p-time-format as character
      265   ,input p-suffix as character
      266   )
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return
      275       p-prefix
      276       + string(v-date, p-date-format)
      277       + p-delimiter
      278       + string(v-time, p-time-format)
      279       + p-suffix
      280       .
      281   end.
      282   function cur-time-print  returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      291   end.
      292   function cur-time-datetime returns datetime
      293   :
      294     define variable v-char as character no-undo .
      295     define variable v-datetime as datetime no-undo .
      296     v-char = cur-time-string().
      297     v-datetime = datetime(v-char).
      298     return  v-datetime.
      299   end.
      300   function cur-time-string-msec returns character
      301   :
      302     define variable v-date as datetime  no-undo .
      303     v-date = now.
      304     return string(v-date) .
      305   end.
      306   define variable vss-include-info1 as character format "X(65)" no-undo
      307   initial "@(#)$Workfile$ $Revision$".
      308   procedure xmlchar-test :
      309   define input parameter p-in-string          as character        no-undo.
      310   define output parameter p-out-string-enc    as character        no-undo.
      311   define output parameter p-out-string-dec    as character        no-undo.
      312   do
      313   on error undo, return error
      314   :
      315          run xmlchar-encode in this-procedure
      316       (
      317             input p-in-string
      318           , output p-out-string-enc
      319       ).
      320          run xmlchar-decode in this-procedure
      321       (
      322             input p-out-string-enc
      323           , output p-out-string-dec
      324       ).
      325   end.
      326   end .
      327   procedure xmlchar-encode :
      328   define input parameter p-in-string      as character        no-undo.
      329   define output parameter p-out-string    as character        no-undo.
      330       define variable v-position      as integer      no-undo.
      331       define variable v-current-char  as character    no-undo.
      332   do
      333   on error undo, return error
      334   :
      335       assign
      336           p-out-string = "":U
      337       .
      338       case p-in-string
      339       :
      340           when ?
      341           then do:
      342               assign
      343                   p-out-string = "?":U
      344               .
      345           end.
      346           when "?":U
      347           then do:
      348               assign
      349                   p-out-string = "&#63;":U
      350               .
      351           end.
      352           otherwise do:
      353               do v-position = 1 to length( p-in-string )
      354               :
      355                   assign
      356                       v-current-char = substring( p-in-string, v-position, 1 )
      357                   .
      358                   case v-current-char
      359                   :
      360                       when "&":U
      361                       then do:
      362                           assign
      363                               p-out-string = p-out-string + "&amp;":U
      364                           .
      365                       end.
      366                       when ">":U
      367                       then do:
      368                           assign
      369                               p-out-string = p-out-string + "&gt;":U
      370                           .
      371                       end.
      372                       when "<":U
      373                       then do:
      374                           assign
      375                               p-out-string = p-out-string + "&lt;":U
      376                           .
      377                       end.
      378                       when "'":U
      379                       then do:
      380                           assign
      381                               p-out-string = p-out-string + "&apos;":U
      382                           .
      383                       end.
      384                       when '"':U
      385                       then do:
      386                           assign
      387                               p-out-string = p-out-string + "&quot;":U
      388                           .
      389                       end.
      390                       when chr(1)
      391                       then do:
      392                           assign
      393                               p-out-string = p-out-string + "":U
      394                           .
      395                       end.
      396                       when chr(2)
      397                       then do:
      398                           assign
      399                               p-out-string = p-out-string + "":U
      400                           .
      401                       end.
      402                       when chr(3)
      403                       then do:
      404                           assign
      405                               p-out-string = p-out-string + "":U
      406                           .
      407                       end.
      408                       when chr(4)
      409                       then do:
      410                           assign
      411                               p-out-string = p-out-string + "":U
      412                           .
      413                       end.
      414                       when chr(5)
      415                       then do:
      416                           assign
      417                               p-out-string = p-out-string + "":U
      418                           .
      419                       end.
      420                       when chr(6)
      421                       then do:
      422                           assign
      423                               p-out-string = p-out-string + "":U
      424                           .
      425                       end.
      426                       when chr(7)
      427                       then do:
      428                           assign
      429                               p-out-string = p-out-string + "":U
      430                           .
      431                       end.
      432                       when chr(8)
      433                       then do:
      434                           assign
      435                               p-out-string = p-out-string + "":U
      436                           .
      437                       end.
      438                       when chr(9)
      439                       then do:
      440                           assign
      441                               p-out-string = p-out-string + "":U
      442                           .
      443                       end.
      444                       when chr(29)
      445                       then do:
      446                           assign
      447                               p-out-string = p-out-string + "":U
      448                           .
      449                       end.
      450                       when chr(10)
      451                       then do:
      452                           assign
      453                               p-out-string = p-out-string + "&#10;":U
      454                           .
      455                       end.
      456                       when chr(13)
      457                       then do:
      458                           assign
      459                               p-out-string = p-out-string + "&#13;":U
      460                           .
      461                       end.
      462                       otherwise do:
      463                           assign
      464                               p-out-string = p-out-string + v-current-char
      465                           .
      466                       end.
      467                   end case.
      468               end.
      469           end.
      470       end case.
      471   end.
      472   end .
      473   procedure xmlchar-encode-1c :
      474   define input parameter p-in-string      as character        no-undo.
      475   define output parameter p-out-string    as character        no-undo.
      476       define variable v-position      as integer      no-undo.
      477       define variable v-current-char  as character    no-undo.
      478   do
      479   on error undo, return error
      480   :
      481       assign
      482           p-out-string = "":U
      483       .
      484       case p-in-string
      485       :
      486           when ?
      487           then do:
      488               assign
      489                   p-out-string = "?":U
      490               .
      491           end.
      492           otherwise do:
      493               do v-position = 1 to length( p-in-string )
      494               :
      495                   assign
      496                       v-current-char = substring( p-in-string, v-position, 1 )
      497                   .
      498                   case v-current-char
      499                   :
      500                       when chr(1)
