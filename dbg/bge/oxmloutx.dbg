     2992     // ext-system-attr-value для проверки сертификатов
     2993   define stream out-stream.
     2994   define variable v-action as character no-undo .
     2995   define variable v-ver-num as character no-undo .
     2996   define variable v-err-msg as character no-undo .
     2997   define temp-table t-list-pack no-undo
     2998   field pack-num    like ub.esys-pck-sent.esps-pack-num
     2999   field re-gen-time as   logical                 initial false
     3000   field SendTxtDate like ub.esys-pck-sent.esps-SendTxtDate initial ?
     3001   index pi is unique primary pack-num ascending
     3002   index iregen re-gen-time SendTxtDate
     3003   .
     3004   define temp-table temp_esys-route no-undo
     3005       field tesr-key  as int64
     3006       field esys-id           as integer
     3007       field db-num            as integer
     3008       field esr-cr-db-num     as integer
     3009       field esr-last-pack     as integer
     3010       field esr-tbl-ord       as int64
     3011       index pi is primary unique
     3012           tesr-key
     3013   .
     3014       define variable v-cur-db-num        as integer      no-undo.
     3015       define variable v-tesr-key          as integer      no-undo.
     3016       define variable v-today             as date         no-undo.
     3017       define variable v-time              as integer      no-undo.
     3018       define variable v-time-wait         as integer      no-undo.
     3019       define variable v-success           as logical      no-undo.
     3020       define variable v-esys-id           as integer      no-undo.
     3021       define variable v-esys-db-num       as integer      no-undo.
     3022       define variable v-esps-cr-db-num    as integer      no-undo.
     3023       define variable v-esps-pack-num     as integer      no-undo .
     3024       define variable v-esps-pack-name    as character no-undo .
     3025       define variable v-pack-file-name    as character no-undo .
     3026       define variable v-custom-pack-name  as character no-undo .
     3027       define variable v-custom-pack-flag  as logical   no-undo .
     3028       define variable v-source-dir        as character no-undo .
     3029       define variable v-target-dir        as character no-undo .
     3030       define variable v-temp-dir          as character no-undo .
     3031       define variable v-log-file-name     as character    no-undo.
     3032       define variable v-list-file-name    as character    no-undo.
     3033       define variable v-err-gen-pack      as integer   no-undo .
     3034       define variable v-ind               as integer   no-undo .
     3035       define variable v-max-p-queue       as integer   no-undo .
     3036       define variable v-max-p-time        as integer   no-undo .
     3037   define variable v-attr-type        as character no-undo . // для чтения значений из ext-system-attr
     3038   define variable v-cert-enstr       as character no-undo . // чтение v-cert-enabled строкой
     3039   define variable v-cert-enabled     as logical no-undo . // true - добавить цифровую подпись
     3040   define variable v-cert-subj-name   as character no-undo . // поле SubjectName (моё имя) в сертификате
     3041   define variable v-cert-issuer-name as character no-undo . // поле IssuerName (кем выдан) в сертификате
     3042   define variable v-sign-fileext     as character no-undo . // расширение файла с электронной подписью
     3043   define variable v-cert-repository  as integer no-undo .
     3044       define buffer buf_ext-system         for ub.ext-system.
     3045       define buffer buf_esys-pck-sent      for ub.esys-pck-sent.
     3046       define buffer buf_temp_esys-route for temp_esys-route.
     3047       define buffer buf_esys-route for ub.esys-route.
     3048       define temp-table tt_esys-route no-undo like ub.esys-route.
     3049       define stream 1c-log .
     3050   do
     3051   for buf_ext-system
     3052   on error undo, return error
     3053   :
     3054     assign
     3055         v-action =  entry( 1, p-parameter-string )
     3056         v-cur-db-num = integer( entry( 2, p-parameter-string ) )
     3057         no-error
     3058     .
     3059     if error-status:error then do:
     3060         assign
     3061         add-log-file-name = ?
     3062         .
     3063         message vss-workfile vss-revision vss-description skip
     3064                 substitute( "Неверная структура составного параметра p-parameter-string = &1", p-parameter-string )
     3065                 view-as alert-box error.
     3066         return error.
     3067     end.
     3068     case v-action:
     3069       when "all" then do:
     3070       end.
     3071       when "one-esys" then do:
     3072         assign
     3073         v-esys-id = integer( entry( 3, p-parameter-string ) )
     3074         v-esys-db-num  = integer( entry( 4, p-parameter-string ) )
     3075         no-error .
     3076       end.
     3077       when "all-unconf" then do:
     3078         assign
     3079         v-esys-id = 0
     3080         v-esys-db-num  = 0
     3081         v-esps-cr-db-num = -1
     3082         v-esps-pack-num  = -1
     3083         no-error
     3084         .
     3085       end.
     3086       when "one-esys-unconf" then do:
     3087         assign
     3088         v-esys-id = integer( entry( 3, p-parameter-string ) )
     3089         v-esys-db-num  = integer( entry( 4, p-parameter-string ) )
     3090         v-esps-cr-db-num = -1
     3091         v-esps-pack-num  = -1
     3092         no-error
     3093         .
     3094       end.
     3095       when "one-pack" then do:
     3096         assign
     3097         v-esys-id = integer( entry( 3, p-parameter-string ) )
     3098         v-esys-db-num  = integer( entry( 4, p-parameter-string ) )
     3099         v-esps-cr-db-num = integer( entry( 5, p-parameter-string ) )
     3100         v-esps-pack-num  = integer( entry( 6, p-parameter-string ) )
     3101         no-error
     3102         .
     3103       end.
     3104       otherwise do:
     3105         message vss-workfile vss-revision vss-description skip
     3106                 substitute( "Не предусмотрена операция &1", v-action )
     3107                 view-as alert-box error.
     3108         return error.
     3109       end.
     3110     end.
     3111     if error-status:error then do:
     3112         message vss-workfile vss-revision vss-description skip
     3113                 substitute( "Неверная структура составного параметра p-parameter-string = &1", p-parameter-string )
     3114                 view-as alert-box error.
     3115         return error.
     3116     end.
     3117      run get-version-num in parparentproc
     3118       ( output v-ver-num
     3119       ).
     3120     run write-log in p-log-handle (
     3121           input 1
     3122         , input substitute( "Выгрузка данных по внешним системам..." )
     3123     ).
     3124     start-export:
     3125     for each buf_ext-system no-lock
     3126         where (buf_ext-system.esys-have-export = yes
     3127           and buf_ext-system.esys-db-num-exp = v-cur-db-num
     3128           and (v-esys-id = 0
     3129                 or
     3130                 (buf_ext-system.esys-id = v-esys-id
     3131                 and
     3132                 buf_ext-system.db-num = v-esys-db-num)
     3133               )
     3134              )
     3135           or
     3136          (buf_ext-system.esys-have-import = yes
     3137           and buf_ext-system.imp-conf-send = integer('1':U)
     3138           and buf_ext-system.esys-db-num-imp = v-cur-db-num
     3139           and (v-esys-id = 0
     3140                 or
     3141                 (buf_ext-system.esys-id = v-esys-id
     3142                 and
     3143                 buf_ext-system.db-num = v-esys-db-num)
     3144               )
     3145              )
     3146     by buf_ext-system.esys-id
     3147     on error undo, return error
     3148     :
     3149       assign
     3150       add-log-file-name = substring( log-file-name, 1, r-index( log-file-name, '.':u) - 1 ) + substitute( "-&1.log", buf_ext-system.esys-id )
     3151       .
     3152       case v-action:
     3153         when "all"
     3154         or
     3155         when "one-esys"
     3156         then do:
     3157           run write-log in p-log-handle (
     3158                 input 2
     3159               , input substitute( "Выгрузка данных по внешней системе '&1'...", buf_ext-system.esys-name )
     3160           ).
     3161         end.
     3162         when "one-pack":U then do:
     3163           find first buf_esys-pck-sent no-lock
     3164             where buf_esys-pck-sent.esys-id = buf_ext-system.esys-id
     3165               and buf_esys-pck-sent.db-num = buf_ext-system.db-num
     3166               and buf_esys-pck-sent.esps-pack-num = v-esps-pack-num
     3167             no-error
     3168           .
     3169           if buf_esys-pck-sent.esps-rcvd = no or
     3170              can-find(first buf_esys-route no-lock where
     3171                             buf_esys-route.esys-id = buf_esys-pck-sent.esys-id
     3172                         and buf_esys-route.db-num = buf_esys-pck-sent.db-num
     3173                         and buf_esys-route.esr-cr-db-num = g#db-num
     3174                         and Buf_esys-route.esr-last-pack = buf_esys-pck-sent.esps-pack-num
     3175                      )
     3176           then do:
     3177             run write-log in p-log-handle (
     3178                   input 2
     3179                  ,input substitute("Отправка одного пакета данных в ВС &1 пакет номер &2", buf_ext-system.esys-name, v-esps-pack-num )
     3180             ).
     3181           end.
     3182           else do:
     3183             run write-log in p-log-handle (
     3184                   input 2
     3185                  ,input substitute("Отправить пакет N &1 для ВС N &2 нельзя. Получено подтверждение о его приеме и данные удалены. Дата и время подтверждения: &3 &4.", v-esps-pack-num, buf_ext-system.esys-id, buf_esys-pck-sent.esps-rcvdDate, buf_esys-pck-sent.esps-rcvdTime )
     3186             ).
     3187             return.
     3188           end.
     3189         end.
     3190         when "one-esys-unconf":U
     3191         or
     3192         when "all-unconf"
     3193         then do:
     3194           run write-log in p-log-handle (
     3195                 input 2
     3196               ,input substitute("Отправка всех неподтвержденных пакетов данных в ВС &1", buf_ext-system.esys-name )
     3197           ).
     3198         end.
     3199         otherwise do:
     3200           message vss-workfile vss-revision vss-description skip
     3201                   substitute( "Не предусмотрена операция &1", v-action )
     3202                   view-as alert-box error.
     3203           return error.
     3204         end.
     3205       end case.
     3206       run ext-system-attr-value in this-procedure (
     3207                                         input  buf_ext-system.esys-id
     3208                                        ,input  buf_ext-system.db-num
     3209                                        ,input  'cert-sign':U
     3210                                        ,output v-cert-enstr
     3211                                        ,output v-attr-type) no-error .
     3212       if not error-status:error then v-cert-enabled = logical (v-cert-enstr) no-error .
     3213       if error-status:error then do:
     3214         run write-log in p-log-handle (
     3215                                           input 2
     3216                                         , substitute("&1 Ошибка чтения настроек ВС.&2&3&2&4&2&5"
     3217                                                     ,vss-workfile
     3218                                                     ,chr(10)
     3219                                                     ,substitute( "Параметр &1", 'cert-sign':U )
     3220                                                     ,substitute( "&1", error-status:get-message(error-status:num-messages) )
     3221                                                     ,substitute( "&1", return-value )
     3222                                                     )
     3223                           ) .
     3224         return error.
     3225       end.
     3226       if v-cert-enabled then do :
     3227         run ext-system-attr-value in this-procedure (
     3228                                         input  buf_ext-system.esys-id
     3229                                        ,input  buf_ext-system.db-num
     3230                                        ,input  'cert-sign-issuer':U
     3231                                        ,output v-cert-issuer-name
     3232                                        ,output v-attr-type) no-error .
     3233         if not error-status:error then
     3234         run ext-system-attr-value in this-procedure (
     3235                                         input  buf_ext-system.esys-id
     3236                                        ,input  buf_ext-system.db-num
     3237                                        ,input  'cert-sign-subject':U
     3238                                        ,output v-cert-subj-name
     3239                                        ,output v-attr-type) no-error .
     3240         if not error-status:error then
     3241         run ext-system-attr-value in this-procedure (
     3242                                         input  buf_ext-system.esys-id
     3243                                        ,input  buf_ext-system.db-num
     3244                                        ,input  'cert-file-ext':U
     3245                                        ,output v-sign-fileext
     3246                                        ,output v-attr-type) no-error .
     3247         if error-status:error then do:
     3248           run write-log in p-log-handle (
     3249                                           input 2
     3250                                         , substitute("&1 Ошибка чтения настроек ВС.&2&3&2&4"
     3251                                                     ,vss-workfile
     3252                                                     ,chr(10)
     3253                                                     ,substitute( "&1", error-status:get-message(error-status:num-messages) )
     3254                                                     ,substitute( "&1", return-value )
     3255                                                     )
     3256                           ) .
     3257           return error.
     3258         end.
     3259         v-cert-repository = ? .
     3260         run ext-system-attr-value in this-procedure (
     3261                                   input  buf_ext-system.esys-id
     3262                                  ,input  buf_ext-system.db-num
     3263                                  ,input  'cert-repository':U
     3264                                  ,output v-cert-enstr
     3265                                  ,output v-attr-type) no-error .
     3266         if v-cert-enstr > ""
     3267         then
     3268           v-cert-repository = integer(v-cert-enstr) no-error .
     3269         if v-cert-repository = ?
     3270         then
     3271           v-cert-repository = 0 .
     3272         if v-cert-subj-name > "" then . else do :
     3273           run write-log in p-log-handle (
     3274                                           input 2
     3275                                         , substitute("&1 Ошибка чтения настроек ВС.&2&3"
     3276                                                     ,vss-workfile
     3277                                                     ,chr(10)
     3278                                                     ,"Отсутствует имя Владельца сертификата (~"Субъект~") в параметрах настройки внешней системы"
     3279                                                     )
     3280                           ) .
     3281           return error.
     3282         end .
     3283         if v-cert-issuer-name > "" then . else do :
     3284           run write-log in p-log-handle (
     3285                                           input 2
     3286                                         , substitute("&1 Ошибка чтения настроек ВС.&2&3"
     3287                                                     ,vss-workfile
     3288                                                     ,chr(10)
     3289                                                     ,"Отсутствует имя Издателя сертификата в параметрах настройки внешней системы"
     3290                                                     )
     3291                           ) .
     3292           return error.
     3293         end .
     3294       end .
     3295       else assign
     3296         v-cert-issuer-name = ""
     3297         v-cert-subj-name   = ""
     3298         v-sign-fileext     = ""
     3299       .
     3300       empty temp-table temp_esys-route .
     3301       assign
     3302       v-success = no
     3303       g#esys-source-esys = -1
     3304       .
     3305       run bge/lockesys.p (
     3306           input buf_ext-system.esys-id
     3307         ,input buf_ext-system.db-num
     3308         ,buffer buf_ext-system
     3309         ,output v-success) no-error.
     3310       if error-status:error
     3311       or v-success = no
     3312       then do:
     3313           run write-log in p-log-handle (
     3314                 input 2
     3315               , input return-value
     3316           ).
     3317           undo start-export, next start-export.
     3318       end.
     3319       assign
     3320         v-max-p-queue = (if buf_ext-system.exp-conf-wait = integer('1':U)
     3321                          then buf_ext-system.max-p-queue
     3322                          else 1000)
     3323         v-max-p-time  = buf_ext-system.max-p-time
     3324         v-err-gen-pack = 0
     3325       .
     3326       for each t-list-pack
     3327       on error undo, return error
     3328       :
     3329         delete t-list-pack .
     3330       end.
     3331       if v-action = "one-pack":U then do:
     3332         create t-list-pack .
     3333         assign
     3334           t-list-pack.pack-num = v-esps-pack-num
     3335         .
     3336       end.
     3337       else do:
     3338         run cur-time( output v-today
     3339                       ,output v-time
     3340                     ) no-error .
     3341         if error-status :error then do:
     3342           run write-log in p-log-handle(
     3343                             input 2
     3344                             ,input substitute("&1 Ошибка при определении текущего времени"
     3345                                               ,vss-workfile )
     3346                           ) .
     3347           return error.
     3348         end.
     3349         assign
     3350           v-time-wait    = -1
     3351         .
     3352         for each tt_esys-route exclusive-lock:
     3353             delete tt_esys-route.
     3354         end.
     3355         for each buf_esys-route no-lock
     3356           where buf_esys-route.esys-id       = buf_ext-system.esys-id
     3357                 and buf_esys-route.db-num = buf_ext-system.db-num
     3358         :
     3359             create tt_esys-route.
     3360             buffer-copy buf_esys-route to tt_esys-route.
     3361         end.
     3362         _buf_esys-pck-sent:
     3363         for each buf_esys-pck-sent no-lock
     3364           where buf_esys-pck-sent.esys-id = buf_ext-system.esys-id
     3365             and buf_esys-pck-sent.db-num = buf_ext-system.db-num
     3366             and buf_esys-pck-sent.esps-cr-db-num = v-cur-db-num
     3367         on error undo, leave
     3368         :
     3369           if buf_esys-pck-sent.esps-rcvd = yes then next _buf_esys-pck-sent.
     3370           find first t-list-pack no-lock
     3371             where t-list-pack.pack-num = buf_esys-pck-sent.esps-pack-num
     3372             no-error
     3373           .
     3374           if not available t-list-pack then do:
     3375             create t-list-pack .
     3376             assign
     3377               t-list-pack.pack-num    = buf_esys-pck-sent.esps-pack-num
     3378               t-list-pack.SendTxtDate = buf_esys-pck-sent.esps-SendTxtDate
     3379               v-ind = v-ind + 1
     3380             .
     3381           end.
     3382           if v-max-p-time <> 0
     3383             and
     3384             buf_esys-pck-sent.esps-SendTxtDate <> ?
     3385             and buf_esys-pck-sent.esps-SendTxtTimeInt <> 0
     3386             and ( buf_esys-pck-sent.esps-SendTxtDate < v-today
     3387                   or ( buf_esys-pck-sent.esps-SendTxtDate = v-today
     3388                       and buf_esys-pck-sent.esps-SendTxtTimeInt <= v-time
     3389                     )
     3390                 )
     3391           then do:
     3392             assign
     3393               v-time-wait = ( v-today - buf_esys-pck-sent.esps-SendTxtDate ) * 24 * 60 * 60
     3394                             + ( v-time - buf_esys-pck-sent.esps-SendTxtTimeInt )
     3395             .
     3396           end.
     3397           if v-time-wait >= v-max-p-time * 60 then do:
     3398             assign
     3399               t-list-pack.re-gen-time = true
     3400             .
     3401           end.
     3402           if buf_ext-system.esys-num-days-keep-exp > 0
     3403           and (v-today - buf_esys-pck-sent.esps-Credate) > buf_ext-system.esys-num-days-keep-exp
     3404           and buf_ext-system.exp-conf-wait = integer('0':U)
     3405           then do:
     3406             run delete-old-pck in this-procedure ( buffer buf_esys-pck-sent
     3407                                                   ,input buf_esys-pck-sent.esys-id
     3408                                                   ,input buf_esys-pck-sent.db-num
     3409                                                   ,input buf_esys-pck-sent.esps-cr-db-num
     3410                                                   ,input buf_esys-pck-sent.esps-pack-num
     3411                                                   ,input buf_ext-system.esys-name
     3412                                                   ) no-error.
     3413             delete t-list-pack.
     3414           end.
     3415         end.
     3416         if buf_ext-system.exp-conf-wait = integer('1':U)
     3417         and buf_ext-system.esys-num-days-keep-exp > 0
     3418         then do:
     3419           find first buf_esys-route no-lock where
     3420                     buf_esys-route.esys-id = buf_ext-system.esys-id
     3421                 and buf_esys-route.db-num = buf_ext-system.db-num
     3422                 and buf_esys-route.esr-last-pack > 0
     3423                 no-error.
     3424           if available buf_esys-route then do:
     3425             for each buf_esys-pck-sent no-lock
     3426               where buf_esys-pck-sent.esys-id = buf_ext-system.esys-id
     3427                 and buf_esys-pck-sent.db-num = buf_ext-system.db-num
     3428                 and buf_esys-pck-sent.esps-cr-db-num = v-cur-db-num
     3429                 and buf_esys-pck-sent.esps-pack-num >= buf_esys-route.esr-last-pack
     3430                 and buf_esys-pck-sent.esps-rcvd = yes:
     3431               if (v-today - buf_esys-pck-sent.esps-Credate) > buf_ext-system.esys-num-days-keep-exp
     3432               then do:
     3433                 run delete-old-pck in this-procedure ( buffer buf_esys-pck-sent
     3434                                                       ,input buf_esys-pck-sent.esys-id
     3435                                                       ,input buf_esys-pck-sent.db-num
     3436                                                       ,input buf_esys-pck-sent.esps-cr-db-num
     3437                                                       ,input buf_esys-pck-sent.esps-pack-num
     3438                                                       ,input buf_ext-system.esys-name
     3439                                                       ) no-error.
     3440               end.
     3441             end.
     3442           end.
     3443         end.
     3444         if v-action = "all":U
     3445         or v-action = "one-esys"
     3446           and v-ind < v-max-p-queue
     3447         then do:
     3448           for each t-list-pack
     3449             where t-list-pack.re-gen-time = false
     3450               and t-list-pack.SendTxtDate <> ?
     3451           on error undo, return error
     3452           :
     3453             delete t-list-pack .
     3454           end.
     3455         end.
     3456       end.
     3457       output stream 1c-log to value ("1c-tech.log") append.
     3458       gen-pack:
     3459       for each t-list-pack
     3460         by t-list-pack.pack-num
     3461       on error undo, return error
     3462       :
     3463         assign
     3464           v-esps-pack-num = t-list-pack.pack-num
     3465         .
     3466         delete t-list-pack .
     3467         v-custom-pack-name = ?.
     3468         run bge/espcknum.p ( input "put":U
     3469                       ,input buf_ext-system.esys-id
     3470                       ,input buf_ext-system.db-num
     3471                       ,input buf_ext-system.delivery-method
     3472                       ,input oxml-exch-dir
     3473                       ,input oxml-heap-dir
     3474                       ,input ""
     3475                       ,input-output v-esps-pack-num
     3476                       ,input-output v-custom-pack-name
     3477                       ,output v-esps-pack-name
     3478                       ,output v-source-dir
     3479                       ,output v-target-dir
     3480                       ,output v-temp-dir
     3481                       ,output v-log-file-name
     3482                       ,output v-list-file-name
     3483                       ,output v-custom-pack-flag
     3484                     ) no-error.
     3485         if error-status:error then do:
     3486           run write-log in p-log-handle (
     3487                                           input 2
     3488                                         , substitute("&1 Ошибка при генерации номера пакета.&2&3&2&4"
     3489                                                       ,vss-workfile
     3490                                                       ,chr(10)
     3491                                                     ,substitute( "&1", error-status:get-message(error-status:num-messages) )
     3492                                                     ,substitute( "&1", return-value )
     3493                                                     )
     3494                           ) .
     3495           return error.
     3496         end.
     3497         if buf_ext-system.esys-have-export = yes
     3498        and buf_ext-system.esys-db-num-exp = v-cur-db-num then do :
     3499           v-pack-file-name = substitute("&1&2&3", v-source-dir, chr(92), v-esps-pack-name) .
     3500           run start-exp-pack in this-procedure  (
     3501                         buffer buf_ext-system
     3502                       ,input v-esps-pack-num
     3503                       ,input (  v-pack-file-name  +  (if v-custom-pack-flag then '' else 'xml')  )
     3504                       ,input v-cert-enabled
     3505                       ,input v-cert-subj-name
     3506                       ,input v-cert-issuer-name
     3507                       ,input v-sign-fileext
     3508                       ,input v-cert-repository
     3509                       ,output v-err-gen-pack
     3510                     ) no-error.
     3511           if error-status:error then do:
     3512             run write-log in p-log-handle (
     3513                                           input 2
     3514                                           , substitute("&1 Ошибка при формировании пакета.&2&3&2&4"
     3515                                                       ,vss-workfile
     3516                                                       ,chr(10)
     3517                                                       ,substitute( "&1", error-status:get-message(error-status:num-messages) )
     3518                                                       , substitute( "&1", return-value ))
     3519                           ) .
     3520             leave gen-pack.
     3521           end.
     3522         end .
     3523         if v-err-gen-pack <> 2 then do:
     3524           run bge/sxg-pack.p (
     3525                          input parparentproc
     3526                         ,input this-procedure:handle
     3527                         ,input p-log-handle
     3528                         ,input "put":U
     3529                         ,input true
     3530                         ,input (v-esps-pack-name + (if v-custom-pack-flag then '' else "xml"))
     3531                         ,input v-source-dir
     3532                         ,input v-target-dir
     3533                         ,input v-temp-dir
     3534                         ,input v-esps-pack-num
     3535                         ,input buf_ext-system.esys-id
     3536                         ,input buf_ext-system.db-num
     3537                         ,input v-cur-db-num
     3538                         ,input buf_ext-system.delivery-method
     3539                         ) no-error.
     3540           if error-status:error then do:
     3541             run write-log in p-log-handle (
     3542                                             input 2
     3543                                           , substitute("&1 &2"
     3544                                                         ,vss-workfile
     3545                                                         , return-value )
     3546                             ).
     3547             leave gen-pack.
     3548           end.
     3549         end.
     3550         if v-err-gen-pack <> 0 then do:
     3551           leave gen-pack.
     3552         end.
     3553       end.
     3554       output stream 1c-log close.
     3555       for each t-list-pack
     3556       on error undo, return error
     3557       :
     3558         delete t-list-pack .
     3559       end.
     3560       run gbl/del-file.p ( input v-temp-dir ) no-error .
     3561       if error-status:error then do:
     3562         run write-log in p-log-handle ( input 2
     3563                                       , substitute("&1 &2"
     3564                                                     ,vss-workfile
     3565                                                     , return-value )
     3566                         ).
     3567       end.
     3568       case v-action:
     3569         when "one-pack":U then do:
     3570           run write-log in p-log-handle ( input 2
     3571                                           ,input substitute("Завершена отправка одного пакета данных в ВС &1", buf_Ext-system.esys-name ) ) .
     3572         end.
     3573         when "one-esys-unconf":U
     3574         or
     3575         when "all-unconf"
     3576         then do:
     3577           run write-log in p-log-handle ( input 2
     3578                                           ,input substitute("Завершена отправка всех неподтвержденных пакетов данных в ВС &1", buf_Ext-system.esys-name ) ) .
     3579         end.
     3580         when "all":U
     3581         or
     3582         when "one-esys"
     3583         then do:
     3584           run write-log in p-log-handle ( input 2
     3585                                           ,input substitute("Завершена отправка новостей в ВС &1", buf_Ext-system.esys-name ) ) .
     3586         end.
     3587       end case.
     3588       run bge/rem-xpck.p
     3589         ( input buf_Ext-system.esys-id
     3590          ,input buf_Ext-system.db-num
     3591         ) no-error.
     3592       if error-status:error then do:
     3593         run write-log in p-log-handle (
     3594                                        input 2
     3595                                       ,input (substitute( "&1. ERROR!!! Ошибка при удалении файлов OXML по ВС &2&3&4&5&6"
     3596                                       ,vss-workfile
     3597                                       ,buf_ext-system.esys-id
     3598                                       ,chr(10)
     3599                                       ,error-status:get-message(error-status:num-messages)
     3600                                       ,chr(10)
     3601                                       ,return-value
     3602                                                 ))
     3603                         ) .
     3604       end.
     3605       assign
     3606       add-log-file-name = ?
     3607       .
     3608     end.
     3609     run write-log in p-log-handle (
     3610           input 1
     3611         , input "Выгрузка данных по внешним системам завершена."
     3612     ).
     3613   end.
     3614   procedure expand-dump-and-export :
     3615   define input parameter p-action             as character        no-undo.
     3616   define input parameter p-unique-key         as character        no-undo.
     3617   define input parameter p-esrd-dump-name     as character        no-undo.
     3618   define input parameter p-value-rec-handle   as handle           no-undo.
     3619       define variable v-temp-table-handle     as handle       no-undo.
     3620       define variable v-temp-table-name       as character    no-undo.
     3621       define variable v-buf-temp-table-handle as handle       no-undo.
     3622       define variable v-ok                    as logical      no-undo.
     3623   do
     3624   on error undo, return error
     3625   :
     3626       create temp-table v-temp-table-handle.
     3627       assign
     3628           v-temp-table-name   = "temp_":U + p-esrd-dump-name
     3629       .
     3630       assign
     3631           v-ok                = v-temp-table-handle :create-like( "ub.":U + p-esrd-dump-name )
     3632       no-error.
     3633       if v-ok <> yes
     3634       then do:
     3635           delete object v-temp-table-handle.
     3636           undo, return error substitute( "&1. Ошибка при создании временной таблицы &2 (1)", vss-workfile, v-temp-table-name ) .
     3637       end.
     3638       assign
     3639           v-ok = v-temp-table-handle :temp-table-prepare( v-temp-table-name )
     3640       no-error.
     3641       if v-ok <> yes
     3642       then do:
     3643           undo, return error substitute( "&1. Ошибка при создании временной таблицы &2 (2)", vss-workfile, v-temp-table-name ) .
     3644       end.
     3645       assign
     3646           v-buf-temp-table-handle = v-temp-table-handle :default-buffer-handle
     3647       .
     3648       assign
     3649           v-ok = v-buf-temp-table-handle :buffer-create
     3650       no-error.
     3651       if v-ok <> true
     3652       then do:
     3653           delete object v-buf-temp-table-handle.
     3654           delete object v-temp-table-handle.
     3655           undo, return error substitute( "&1. Ошибка при создании буфера временной таблицы.", vss-workfile, v-temp-table-name ).
     3656       end.
     3657       assign
     3658           v-ok = v-buf-temp-table-handle :raw-transfer ( no, p-value-rec-handle )
     3659       no-error.
     3660       if v-ok <> true
     3661       then do:
     3662           delete object v-buf-temp-table-handle.
     3663           delete object v-temp-table-handle.
     3664           undo, return error substitute( "&1. RAW-TRANSFER не прошел для таблицы &2", vss-workfile, v-temp-table-name ).
     3665       end.
     3666       run exp-pack in this-procedure (
     3667             input p-action
     3668           , input p-unique-key
     3669           , input v-buf-temp-table-handle
     3670           , input p-esrd-dump-name
     3671       ) no-error.
     3672       if error-status :error
     3673       then do:
     3674           delete object v-buf-temp-table-handle.
     3675           delete object v-temp-table-handle.
     3676           return error substitute( "&1. Ошибка exp-pack для таблицы &2", vss-workfile, v-temp-table-name ).
     3677       end.
     3678       if valid-handle ( v-temp-table-handle )
     3679       then do:
     3680           delete object v-temp-table-handle.
     3681       end.
     3682       if valid-handle ( v-buf-temp-table-handle )
     3683       then do:
     3684           delete object v-buf-temp-table-handle.
     3685       end.
     3686   end.
     3687   end procedure.
     3688   procedure start-exp-pack :
     3689   define parameter buffer buf_ext-system for ub.ext-system.
     3690   define input  parameter p-pack-num as integer   no-undo .
     3691   define input  parameter p-pack-file as character no-undo .
     3692   define input  parameter p-cert-enabled     as logical no-undo .
     3693   define input  parameter p-cert-subj-name   as character no-undo .
     3694   define input  parameter p-cert-issuer-name as character no-undo .
     3695   define input  parameter p-sign-fileext     as character no-undo .
     3696   define input  parameter p-cert-repository  as integer   no-undo .
     3697   define output parameter p-err-gen-pack as integer   no-undo . // 20/VIII-2018 - не используется, снаружи не проверяется
     3698   define variable v-buffer-handle        as handle       no-undo.
     3699   define variable v-parameter-list       as character    no-undo.
     3700   define variable v-esr-action           as character    no-undo.
     3701   define variable v-start-regular-pack   as logical      no-undo.
     3702   define variable v-end-regular-pack     as logical      no-undo.
     3703   define variable rec-cnt                as integer      no-undo.
     3704   define variable v-start                as logical      no-undo init yes.
     3705   define variable v-error-num            as integer      no-undo.
     3706   define variable v-found-route          as logical      no-undo .
     3707   define variable sw as handle no-undo.
     3708   define variable sender-id as character no-undo.
     3709   define variable v-longdata as longchar no-undo.
     3710   define variable v-type as character no-undo .
     3711   define variable v-packdata as memptr no-undo .
     3712   define buffer buf_esys-route         for ub.esys-route.
     3713   define buffer buf_esys-route-dump    for ub.esys-route-dump.
     3714   define buffer buf_temp_esys-route    for temp_esys-route.
     3715   define buffer buf_esys-pck-sent      for ub.esys-pck-sent.
     3716   define variable v-pkcs             as class ibs.th.gbl.pkcs no-undo .
     3717   define variable v-signdata         as memptr no-undo .
     3718   define variable v-sign-file        as character no-undo . // имя файла с электронной подписью
     3719   define variable v-position         as integer no-undo . // позиция точки в имени файла
     3720   do
     3721   on error undo, return error return-value
     3722   :
     3723         if buf_Ext-system.delivery-method = integer('11':U)
     3724         then do :
     3725           run db-attr-value in this-procedure
     3726              (input ibs.th.gbl.gbl-var:g#db-num
     3727              ,input 'int-point':U
     3728              ,output sender-id
     3729              ,output v-type
     3730              ) no-error .
     3731           put stream 1c-log unformatted string(now) "  Начало формирования пакета " string(p-pack-num) "  " p-pack-file skip .
     3732           create sax-writer sw.
     3733           sw:formatted = true.
     3734           sw:set-output-destination ("memptr", v-packdata).
     3735           sw:encoding = "UTF-8".
     3736           sw:start-document () .
     3737           sw:start-element ("GC-ERPRN") .
     3738           sw:insert-attribute ("xmlns", "http://www.rosneft.ru/GasComplex/Retail/11.0") .
     3739           sw:insert-attribute ("xmlns:xs", "http://www.w3.org/2001/XMLSchema") .
     3740           sw:insert-attribute ("xmlns:xsi", "http://www.w3.org/2001/XMLSchema-instance") .
     3741           put stream 1c-log unformatted string(now) "  Заполнение шапки" skip .
     3742             sw:start-element ("header") .
     3743               sw:write-data-element ("num", string(p-pack-num)) .
     3744               sw:write-data-element ("sender-id", sender-id) .
     3745               sw:write-data-element ("reciever-id", "00000") .
     3746               sw:write-data-element ("created-date", iso-date (now)) .
     3747             sw:end-element ("header") .
     3748           put stream 1c-log unformatted string(now) "  Шапка заполнена" skip .
     3749         end.
     3750         assign
     3751             v-start-regular-pack = yes
     3752             v-end-regular-pack = no
     3753             v-found-route = no
     3754         .
     3755         _buf_esys-route:
     3756         for each buf_esys-route no-lock
     3757             where buf_esys-route.esys-id     = buf_ext-system.esys-id
     3758               and buf_esys-route.db-num      = buf_Ext-system.db-num
     3759               and buf_esys-route.esr-last-pack = p-pack-num
     3760         on error undo, return error
     3761         break by buf_esys-route.esr-oper by buf_esys-route.esr-tbl-ord
     3762         :
     3763           assign
     3764               rec-cnt    = rec-cnt + (if v-start then 1 else 0)
     3765               v-tesr-key = v-tesr-key + 1
     3766               v-esr-action   = buf_esys-route.esr-action
     3767               v-found-route = yes
     3768             .
     3769           create buf_temp_esys-route.
     3770           assign
     3771               buf_temp_esys-route.tesr-key         = v-tesr-key
     3772               buf_temp_esys-route.esys-id          = buf_esys-route.esys-id
     3773               buf_temp_esys-route.db-num           = buf_esys-route.db-num
     3774               buf_temp_esys-route.esr-cr-db-num    = buf_esys-route.esr-cr-db-num
     3775               buf_temp_esys-route.esr-last-pack    = buf_esys-route.esr-last-pack
     3776               buf_temp_esys-route.esr-tbl-ord      = buf_esys-route.esr-tbl-ord
     3777           .
     3778           case buf_esys-route.esr-action
     3779           :
     3780             when 'command-bush':U
     3781             or
     3782             when 'command-pbush':U
     3783             then do:
     3784               if buf_Ext-system.delivery-method = integer('11':U)
     3785               then do :
     3786                   if first-of(buf_esys-route.esr-oper)
     3787                   then put stream 1c-log unformatted string(now) "  Запись секции " buf_esys-route.esr-oper skip .
     3788                   if first-of(buf_esys-route.esr-oper)
     3789                   then sw:start-element (buf_esys-route.esr-oper) .
     3790                   if buf_esys-route.esr-oper = "sales-p-shifts"
     3791                   then do :
     3792                     sw:start-element ("sales-p-shift") .
     3793                       sw:write-data-element ("tbl-ord", string(buf_esys-route.esr-tbl-ord)) .
     3794                   end.
     3795                   for each buf_esys-route-dump where buf_esys-route-dump.esrd-dump-ord = buf_esys-route.esr-dump-ord:
     3796                     v-longdata = "" .
     3797                     fix-codepage(v-longdata) = "UTF-8" .
     3798                     copy-lob from buf_esys-route-dump.esrd-blob-value-rec to v-longdata no-convert.
     3799                     sw:write-fragment (v-longdata) .
     3800                   end.
     3801                   if buf_esys-route.esr-oper = "sales-p-shifts"
     3802                   then do :
     3803                     sw:end-element ("sales-p-shift") .
     3804                   end.
     3805                   if last-of(buf_esys-route.esr-oper)
     3806                   then sw:end-element (buf_esys-route.esr-oper) .
     3807                   if last-of(buf_esys-route.esr-oper)
     3808                   then put stream 1c-log unformatted string(now) "  Запись секции " buf_esys-route.esr-oper " завершена" skip .
     3809               end.
     3810               else do :
     3811                   if v-start then do:
     3812                   run bge/cmdesgen.p (
     3813                                         input parparentproc
     3814                                         ,input p-log-handle
     3815                                         ,input buf_ext-system.esys-id
     3816                                         ,input buf_ext-system.db-num
     3817                                         ,input buf_ext-system.esys-db-num-exp
     3818                                         ,input buf_esys-route.esr-cr-db-num
     3819                                         ,input buf_esys-route.esr-dump-ord
     3820                                         ,input buf_esys-route.uniq-gate-rec
     3821                                         ,input p-pack-file
     3822                                         ,input 1
     3823                                         ,input buf_esys-route.esr-last-pack
     3824                                         ,output rec-cnt
     3825                                         ) no-error.
     3826                   if error-status:error then do:
     3827                     v-err-msg =  substitute( "Ошибка 1 разбора esys-route-dump. &1. &2. &3"
     3828                                             , return-value
     3829                                             , trim( error-status :get-message( 1 ) ))
     3830                     .
     3831                     run write-log in p-log-handle (
     3832                           input 2
     3833                         , input v-err-msg
     3834                     ).
     3835                     run send-msg-to-email in parparentproc
     3836                         ( input substitute( "ТН (ver &2) БД &1. Ошибка OXML при экспорте пакета из ВС &2"
     3837                                             , v-ver-num
     3838                                             , v-cur-db-num
     3839                                             , buf_ext-system.esys-id )
     3840                         ,input v-err-msg
     3841                         ,input "":U
     3842                         ) no-error .
     3843                     if error-status :error then do:
     3844                         run write-log in p-log-handle (
     3845                         input 2
     3846                       , input substitute( "&1. &3&2&4", vss-workfile, chr(10), error-status:get-message(1), return-value )
     3847                                                         ) .
     3848                     end.
     3849                     undo, return error .
     3850                   end.
     3851                   end.
     3852                   v-start = no.
     3853                   next _buf_esys-route.
     3854               end.
     3855             end.
     3856             when 'update':U
     3857             or when 'delete':U
     3858             then do:
     3859                if v-start-regular-pack then do:
     3860                   assign
     3861                   v-list-file-name = "":U
     3862                   v-parameter-list = substitute( "&1,&2,&3,&4,&5,&6,&7"
     3863                                                   , 6
     3864                                                   , "THformat":U
     3865                                                   , "Trade House OpenXML 1.0":U
     3866                                                   , "THversion":U
     3867                                                   , trim( replace( substring( vss-archive, 15, 4 ), "$":U, "":U ) )
     3868                                                   , "THrevision":U
     3869                                                   , trim( replace( substring( vss-revision, 12 ), "$":U, "":U ) )
     3870                                               )
     3871                   v-parameter-list = substitute( "&1,&2,&3,&4,&5,&6,&7"
     3872                                                   , v-parameter-list
     3873                                                   , "THesysName":U
     3874                                                   , buf_ext-system.esys-name
     3875                                                   , "THcurrentDbNum":U
     3876                                                   , string( v-cur-db-num )
     3877                                                   , "THpack-num":U
     3878                                                   , string( p-pack-num )
     3879                                               )
     3880                   .
     3881                   run xmllib-write-header in this-procedure (
     3882                         input yes
     3883                       , input p-pack-file
     3884                       , input v-list-file-name
     3885                       , input 1
     3886                       , input no
     3887                       , input "":U
     3888                       , input v-parameter-list
     3889                   ).
     3890                   output STREAM stmXMLOut TO VALUE( p-pack-file + "tmp" ) CONVERT TARGET "1251" APPEND.
     3891                   v-start-regular-pack = no.
     3892                   v-end-regular-pack = yes.
     3893                 end.
     3894                 for each buf_esys-route-dump no-lock
     3895                   where buf_esys-route-dump.esrd-dump-ord = buf_esys-route.esr-dump-ord
     3896                 on error undo, return error
     3897                 :
     3898                     assign
     3899                        v-buffer-handle = buffer buf_esys-route-dump :handle
     3900                     .
     3901                     run expand-dump-and-export in this-procedure (
     3902                           input v-esr-action
     3903                         , input buf_esys-route.esr-uniq-key-rec
     3904                         , input buf_esys-route-dump.esrd-dump-name
     3905                         , input v-buffer-handle :buffer-field( "esrd-value-rec":U )
     3906                     ) no-error.
     3907                     if error-status :error
     3908                     then do:
     3909                         run write-log in p-log-handle (
     3910                               input 2
     3911                             , input substitute( "Ошибка 1 разбора esys-route-dump. &1. &2. &3"
     3912                                                 , return-value
     3913                                                 , trim( error-status :get-message( 1 ) )
     3914                                                 , trim( error-status :get-message( 2 ) )
     3915                                             )
     3916                         ).
     3917                         run write-log in p-log-handle (
     3918                             input 0
     3919                             , input substitute( "&1.", return-value )
     3920                         ).
     3921                         run write-log in p-log-handle (
     3922                             input 0
     3923                             , input substitute( "&1.", trim( error-status :get-message( 1 ) ) )
     3924                         ).
     3925                         run write-log in p-log-handle (
     3926                             input 0
     3927                             , input substitute( "&1.", trim( error-status :get-message( 2 ) ) )
     3928                         ).
     3929                         undo, return error .
     3930                     end.
     3931                 end.
     3932               end.
     3933           end case.
     3934         end.
     3935         if buf_Ext-system.delivery-method = integer('11':U)
     3936         then do :
     3937             sw:end-element ("GC-ERPRN") .
     3938             sw:end-document () .
     3939           put stream 1c-log unformatted string(now) "  Окончание формирования пакета" skip .
     3940           COPY-LOB FROM OBJECT v-packdata TO FILE p-pack-file NO-CONVERT NO-ERROR .
     3941           if p-cert-enabled then do on error undo, throw :
     3942             define variable v-err-msg as character no-undo .
     3943             v-err-msg = "" .
     3944             // p-cert-subj-name > "" и p-cert-issuer-name > "" были проверены при чтении параметров
     3945               v-pkcs = new ibs.th.gbl.pkcs().
     3946               v-signdata = v-pkcs:computeSign(v-packdata, p-cert-subj-name, p-cert-issuer-name, p-cert-repository) .
     3947               // взять имя файла p-pack-file без расширения
     3948               v-position = r-index(p-pack-file, ".") .
     3949               v-sign-file = if v-position > 0 then substring(p-pack-file, 1, v-position - 1) else p-pack-file .
     3950               v-sign-file = substitute("&1.&2", v-sign-file, p-sign-fileext) .
     3951               COPY-LOB FROM OBJECT v-signdata TO FILE v-sign-file NO-CONVERT .
     3952             // ошибки - в лог, и ...
     3953             catch exAppErrors as class Progress.Lang.AppError :
     3954               v-err-msg = exAppErrors:ReturnValue .
     3955               if v-err-msg > "" then . else do :
     3956                 v-err-msg = exAppErrors:GetMessage(1) .
     3957                 if v-err-msg > "" then . else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\bge\oxmloutx.p" .
     3958               end .
     3959             end catch .
     3960             catch exProErrors as class Progress.Lang.ProError :
     3961               v-err-msg = exProErrors:GetMessage(1) .
     3962               if v-err-msg > "" then . else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\bge\oxmloutx.p" .
     3963             end catch .
     3964             catch exAnyErrors as class Progress.Lang.Error:
     3965               v-err-msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\bge\oxmloutx.p " + exAnyErrors:GetMessage(1).
     3966             end catch .
     3967             finally:
     3968               set-size(v-signdata) = 0 .
     3969               if valid-object(v-pkcs) then delete object v-pkcs .
     3970               if v-err-msg > "" then do :
     3971                 run write-log in p-log-handle ( input 0, input v-err-msg ).
     3972                 undo, return error . // ... - и прекращаем выгрузку
     3973               end .
     3974             end finally.
     3975           end . // end_of if_cert
     3976           set-size(v-packdata) = 0 .
     3977           put stream 1c-log unformatted string(now) "  Пакет " string(p-pack-num) "  " p-pack-file "   СФОРМИРОВАН" skip .
     3978           file-info:file-name = p-pack-file .
     3979           if file-info:file-size = 0
     3980           then put stream 1c-log unformatted "!!!!!!!!! " string(now) "  Пакет " string(p-pack-num) "  " p-pack-file "   ПУСТОЙ" skip .
     3981         end.
     3982       if v-found-route = no
     3983       and buf_ext-system.esys-type > integer('0':U)
     3984       then do:
     3985         if buf_Ext-system.delivery-method = integer('11':U)
     3986         then put stream 1c-log unformatted string(now) "  1_cmdesgen.p  Пакет " string(p-pack-num) "  " p-pack-file skip .
     3987         run bge/cmdesgen.p (
     3988                               input parparentproc
     3989                               ,input p-log-handle
     3990                               ,input buf_ext-system.esys-id
     3991                               ,input buf_ext-system.db-num
     3992                               ,input buf_ext-system.esys-db-num-exp
     3993                               ,input v-cur-db-num
     3994                               ,input -1
     3995                               ,input ''
     3996                               ,input p-pack-file
     3997                               ,input 1
     3998                               ,input p-pack-num
     3999                               ,output rec-cnt
     4000                               ) no-error.
     4001         if error-status:error then do:
     4002           run write-log in p-log-handle (
     4003                 input 2
     4004               , input substitute( "Ошибка 1 разбора esys-route-dump. &1. &2. &3"
     4005                                   , return-value
     4006                                   , trim( error-status :get-message( 1 ) )
     4007                               )
     4008           ).
     4009           undo, return error .
     4010         end.
     4011         if buf_Ext-system.delivery-method = integer('11':U)
     4012         then put stream 1c-log unformatted string(now) "  2_cmdesgen.p  Пакет " string(p-pack-num) "  " p-pack-file skip .
     4013       end.
     4014       if v-end-regular-pack
     4015       and v-found-route = yes
     4016       then do:
     4017         output STREAM stmXMLOut close.
     4018         run bge/os_copy.p (
     4019               input "D"
     4020             , input (p-pack-file + "xml")
     4021             , input ""
     4022             , output v-error-num
     4023         ).
     4024         run xmllib-write-footer in this-procedure (
     4025               input yes
     4026             , input p-pack-file
     4027             , input v-list-file-name
     4028             , input no
     4029             , input "":U
     4030         ).
     4031          v-end-regular-pack = no.
     4032       end.
     4033       run cur-time in this-procedure (
     4034                 output v-today
     4035               , output v-time
     4036       ).
     4037       for each buf_temp_esys-route
     4038       on error undo, return error
     4039       :
     4040           find first buf_esys-route exclusive-lock
     4041               where buf_esys-route.esys-id        = buf_temp_esys-route.esys-id
     4042                 and buf_esys-route.db-num         = buf_temp_esys-route.db-num
     4043                 and buf_esys-route.esr-cr-db-num  = buf_temp_esys-route.esr-cr-db-num
     4044                 and buf_esys-route.esr-last-pack  = buf_temp_esys-route.esr-last-pack
     4045                 and buf_esys-route.esr-tbl-ord    = buf_temp_esys-route.esr-tbl-ord
     4046           .
     4047           assign
     4048               buf_esys-route.esr-status            = 1
     4049               buf_esys-route.esr-sys-date          = v-today
     4050               buf_esys-route.esr-sys-time-int      = v-time
     4051               buf_esys-route.esr-sys-time          = string( v-time, "hh:mm:ss" )
     4052           .
     4053          delete buf_temp_esys-route.
     4054       end.
     4055       find first buf_esys-pck-sent exclusive-lock
     4056         where buf_esys-pck-sent.esys-id   = buf_ext-system.esys-id
     4057           and buf_esys-pck-sent.db-num   = buf_ext-system.db-num
     4058           and buf_esys-pck-sent.esps-cr-db-num = v-cur-db-num
     4059           and buf_esys-pck-sent.esps-pack-num = p-pack-num
     4060       .
     4061       assign
     4062         buf_esys-pck-sent.esps-total-recs     = rec-cnt + (if buf_ext-system.delivery-method = integer('5':U)
     4063                                                             then 0
     4064                                                             else 1)
     4065         buf_esys-pck-sent.esps-CreNum         = buf_esys-pck-sent.esps-CreNum + 1
     4066         buf_esys-pck-sent.esps-SendTxtDate    = v-today
     4067         buf_esys-pck-sent.esps-SendTxtTimeInt = v-time
     4068         buf_esys-pck-sent.esps-SendTxtTime    = string( v-time, "HH:MM:SS" )
     4069         .
     4070   end.
     4071   end procedure.
     4072   procedure exp-pack :
     4073   define input parameter p-action         as character        no-undo.
     4074   define input parameter p-unique-key     as character        no-undo.
     4075   define input parameter p-tbl-handle     as handle           no-undo.
     4076   define input parameter p-table-name     as character        no-undo.
     4077         define variable v-num-fields      as integer          no-undo.
     4078         define variable v-counter         as integer          no-undo.
     4079         define variable v-field-handle    as handle           no-undo.
     4080         define buffer buf_datatype-table          for ub.datatype-table.
     4081         define buffer buf_datatype-table-field    for ub.datatype-table-field.
     4082   do
     4083   for buf_datatype-table
     4084     , buf_datatype-table-field
     4085   on error  undo, return error substitute( "&1 (oxmloutx). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     4086   on stop   undo, return error substitute( "&1 (oxmloutx). stop", vss-workfile )
     4087   on endkey undo, return error substitute( "&1 (oxmloutx). endkey", vss-workfile )
     4088   :
     4089       find first buf_datatype-table no-lock
     4090            where buf_datatype-table.dtt-name = p-table-name
     4091       no-error.
     4092       if available buf_datatype-table
     4093       then do:
     4094           run xmllib-tag-open in this-procedure ( input 1, input buf_datatype-table.dtt-xml-tag, input "":U ).
     4095           run xmllib-tag-put in this-procedure ( input 2, input "TH__record-action"       , input p-action    , input 0 ).
     4096           run xmllib-tag-put in this-procedure ( input 2, input "TH__record-unique-key"   , input p-unique-key, input 0 ).
     4097           assign
     4098               v-num-fields = p-tbl-handle :num-fields
     4099           .
     4100           do v-counter = 1 to v-num-fields
     4101           on error undo, return error substitute( "&1 (nws-exp). &2", vss-workfile, error-status :get-message ( 1 ) )
     4102           :
     4103               assign
     4104                   v-field-handle = p-tbl-handle :buffer-field( v-counter )
     4105               .
     4106               find first buf_datatype-table-field no-lock
     4107                    where buf_datatype-table-field.dtt-name = buf_datatype-table.dtt-name
     4108                      and buf_datatype-table-field.dtf-name = v-field-handle :name
     4109               no-error.
     4110               if available buf_datatype-table-field
     4111               then do:
     4112                   if v-field-handle :buffer-value = ?
     4113                   then do:
     4114                       run xmllib-tag-put-null in this-procedure ( input 2, input buf_datatype-table-field.dtf-xml-tag ).
     4115                   end.
     4116                   else do:
     4117                       run xmllib-tag-put in this-procedure ( input 2, input buf_datatype-table-field.dtf-xml-tag  , input v-field-handle :buffer-value, input 0 ).
     4118                   end.
     4119               end.
     4120           end.
     4121           run xmllib-tag-close in this-procedure ( input 1, input buf_datatype-table.dtt-xml-tag ).
     4122       end.
     4123   end.
     4124   end procedure.
     4125   procedure delete-old-pck :
     4126   define parameter buffer buf_esys-pck-sent for ub.esys-pck-sent.
     4127   define input parameter p-esys-id as integer no-undo .
     4128   define input parameter p-db-num as integer no-undo .
     4129   define input parameter p-esps-cr-db-num as integer no-undo .
     4130   define input parameter p-esps-pack-num as integer no-undo .
     4131   define input parameter p-esys-name as character no-undo .
     4132   define variable v-del-pck-num as integer   no-undo.
     4133   define variable v-del-cnt     as integer   no-undo.
     4134   define variable v-today as date no-undo .
     4135   define variable v-time as integer no-undo .
     4136   define buffer buf_esys-route for ub.esys-route.
     4137   define buffer buf_esys-route-dump for ub.esys-route-dump.
     4138   define frame del-route
     4139   v-del-pck-num   label "Пакет N" format ">>>>>>>>>9" skip
     4140   v-del-cnt       label "Записей" format ">>>>>>>>>9"
     4141   with view-as dialog-box side-labels 1 columns three-d title "Удаление маршрутизации" .
     4142   do
     4143   on error undo, return error
     4144   :
     4145     run write-log in p-log-handle (
     4146           input 2
     4147         , input substitute( "Удаление данных пакета &1 ВС '&2'&3:истек срок хранения"
     4148                            ,p-esps-pack-num
     4149                            ,p-esys-name
     4150                            ,chr(10)
     4151                             )
     4152         ).
     4153     view frame del-route .
     4154     for each buf_esys-route
     4155       where buf_esys-route.esys-id    = p-esys-id
     4156         and buf_esys-route.db-num    = p-db-num
     4157         and buf_esys-route.esr-cr-db-num = p-esps-cr-db-num
     4158         and buf_esys-route.esr-last-pack = p-esps-pack-num
     4159     on error  undo, return error substitute("&1. error buf_esys-route &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4160     on endkey undo, return error substitute("&1. endkey buf_esys-route")
     4161     on stop   undo, return error substitute("&1. stop buf_esys-route")
     4162     :
     4163       assign
     4164         v-del-cnt = v-del-cnt + 1
     4165       .
     4166       do with frame del-route
     4167       :
     4168         assign
     4169           v-del-pck-num :screen-value   = string( buf_esys-route.esr-last-pack, v-del-pck-num :format)
     4170           v-del-cnt :screen-value       = string( v-del-cnt, v-del-cnt :format)
     4171         .
     4172       end.
     4173       delete buf_esys-route.
     4174     end.
     4175     hide frame del-route .
     4176     run cur-time in this-procedure ( output v-today, output v-time).
     4177     transaction_block_pck-rcvd:
     4178     do transaction
     4179     on error  undo, return error substitute("&1. error transaction_block_esys-pck-rcvd &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4180     on endkey undo, return error substitute("&1. endkey transaction_block_esys-pck-rcvd")
     4181     on stop   undo, return error substitute("&1. stop transaction_block_esys-pck-rcvd")
     4182     :
     4183       find current buf_esys-pck-sent exclusive-lock.
     4184       assign
     4185       buf_esys-pck-sent.esps-rcvd        = yes
     4186       buf_esys-pck-sent.esps-rcvdDate    = v-today
     4187       buf_esys-pck-sent.esps-RcvdTimeInt = v-time
     4188       buf_esys-pck-sent.esps-RcvdTime    = string( v-time, "HH:MM:SS" )
     4189       .
     4190     end.
     4191     run write-log in p-log-handle (
     4192           input 2
     4193         , input substitute( ".....Удален" )
     4194         ).
     4195   end.
     4196   end procedure.
     4197   procedure get-log-file-name :
     4198   define output parameter p-log-file-name as character no-undo .
     4199     do
     4200     on error undo, return error
     4201     :
     4202       p-log-file-name = add-log-file-name.
     4203     end.
     4204   end procedure.
