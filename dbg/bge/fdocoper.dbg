     1295       define variable varinvatp-envd             as   character              no-undo.
     1296       define variable varinvatp-type             as   character              no-undo.
     1297   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1298   define  temp-table temp-host no-undo
     1299     field host-code like ub.store.host-code
     1300     index xpk host-code
     1301   .
     1302   define  temp-table temp-obj no-undo
     1303     field obj-type  like ub.clients.obj-type
     1304     field obj-code  like ub.clients.obj-code
     1305     field host-code like ub.store.host-code
     1306     field db-num    like ub.clients.db-num
     1307     index xpk  obj-type obj-code
     1308     index xie1 host-code
     1309     index xie2 db-num host-code
     1310   .
     1311   procedure init-temphost:
     1312     define buffer buf_store   for ub.store .
     1313     define buffer buf_shop    for ub.shop .
     1314     define buffer buf_clients for ub.clients .
     1315     define buffer buf_db for ub.db .
     1316     define buffer buf_temp-host for temp-host .
     1317     define buffer buf_temp-obj for temp-obj .
     1318     do
     1319     on error undo, return error return-value
     1320     :
     1321       for each buf_store
     1322       on error undo, return error
     1323       :
     1324         find first buf_temp-host
     1325           where buf_temp-host.host-code = buf_store.host-code
     1326           no-error .
     1327         if not available buf_temp-host
     1328         then do:
     1329           create buf_temp-host .
     1330           assign
     1331             buf_temp-host.host-code = buf_store.host-code
     1332           .
     1333         end.
     1334         find first buf_clients no-lock
     1335           where buf_clients.obj-type = 'скл':U
     1336             and buf_clients.obj-code = buf_store.obj-code
     1337           no-error .
     1338         if not available buf_clients
     1339         then do:
     1340           message
     1341             "Ошибка при поиске клиента" skip
     1342             "Клиент" 'скл':U buf_store.obj-code skip
     1343             view-as alert-box error .
     1344           undo, return error .
     1345         end.
     1346         create buf_temp-obj .
     1347         assign
     1348           buf_temp-obj.obj-type  = 'скл':U
     1349           buf_temp-obj.obj-code  = buf_store.obj-code
     1350           buf_temp-obj.host-code = buf_store.host-code
     1351           buf_temp-obj.db-num    = buf_clients.db-num
     1352         .
     1353       end.
     1354       for each buf_shop
     1355       on error undo, return error
     1356       :
     1357         find first buf_temp-host
     1358           where buf_temp-host.host-code = buf_shop.host-code
     1359           no-error .
     1360         if not available buf_temp-host
     1361         then do:
     1362           create buf_temp-host .
     1363           assign
     1364             buf_temp-host.host-code = buf_shop.host-code
     1365           .
     1366         end.
     1367         find first buf_clients no-lock
     1368           where buf_clients.obj-type = 'маг':U
     1369             and buf_clients.obj-code = buf_shop.obj-code
     1370           no-error .
     1371         if not available buf_clients then do:
     1372           message
     1373             "Ошибка при поиске клиента" skip
     1374             "Клиент" 'маг':U buf_shop.obj-code skip
     1375             view-as alert-box error .
     1376           undo, return error .
     1377         end.
     1378         create buf_temp-obj .
     1379         assign
     1380           buf_temp-obj.obj-type  = 'маг':U
     1381           buf_temp-obj.obj-code  = buf_shop.obj-code
     1382           buf_temp-obj.host-code = buf_shop.host-code
     1383           buf_temp-obj.db-num    = buf_clients.db-num
     1384         .
     1385       end.
     1386     end.
     1387   end.
     1388   do
     1389   on error undo, return error
     1390   :
     1391     define variable v-exists-operation          as logical      no-undo.
     1392     define variable v-doc-date        like ub.trn-doc.doc-date   no-undo.
     1393     define variable v-fact-date       like ub.trn-doc.fact-date  no-undo.
     1394     define variable v-doc-PS          like ub.trn-doc.PS         no-undo.
     1395     define variable v-host-code                 as integer       no-undo.
     1396     define variable v-base-code                 as integer       no-undo.
     1397     define variable v-base-abbr       like ub.currency.curr-abbr no-undo .
     1398     define variable v-base-name       like ub.currency.curr-name no-undo .
     1399     define variable v-obj-counter     as integer                 no-undo .
     1400     define variable v-last-file-position        as integer       no-undo.
     1401     define buffer buf_currency for ub.currency.
     1402       ASSIGN
     1403       v-exists-operation = NO.
     1404       .
     1405   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1406   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1407     (input  p-host-code
     1408     ,output v-base-code
     1409     )  .
     1410       find first buf_currency no-lock where
     1411                 buf_currency.curr-code = v-base-code no-error .
     1412       if available buf_currency then
     1413       assign
     1414       v-base-abbr = buf_currency.curr-abbr
     1415       v-base-name = buf_currency.curr-name
     1416       .
     1417       RUN bgelib-write-cnt( hCNT, "" ).
     1418       assign
     1419           p-last-xml-file-name = p-xml-file-name
     1420       .
     1421       if p-obj-list <> "":U and p-mode <> "":U then do:
     1422         do v-obj-counter = 1 to num-entries ( p-obj-list ) / 2
     1423         :
     1424             create temp-obj.
     1425             assign
     1426             temp-obj.obj-code = integer( entry( v-obj-counter * 2, p-obj-list ) )
     1427             temp-obj.obj-type = entry( v-obj-counter * 2 - 1, p-obj-list )
     1428             no-error .
     1429         end.
     1430       end.
     1431       run export-documents in this-procedure (
     1432             input p-obj-list
     1433           , input p-doc-type-list
     1434           , input p-parameter-list
     1435           , input p-xml-file-name
     1436           , input p-log-file-name
     1437           , input p-list-file-name
     1438           , input p-xml-file-number
     1439           , output p-last-xml-file-name
     1440           , output p-last-xml-file-number
     1441       ).
     1442   end.
     1443   procedure export-documents :
     1444   do
     1445   on error undo, return error
     1446   :
     1447     define input parameter p-obj-list               as character    no-undo.
     1448     define input parameter p-doc-type-list          as character    no-undo.
     1449     define input parameter p-parameter-list         as character    no-undo.
     1450     define input parameter p-xml-file-name          as character    no-undo.
     1451     define input parameter p-log-file-name          as character    no-undo.
     1452     define input parameter p-list-file-name         as character    no-undo.
     1453     define input parameter p-xml-file-number        as integer      no-undo.
     1454     define output parameter p-last-xml-file-name    as character    no-undo.
     1455     define output parameter p-last-xml-file-number  as integer      no-undo.
     1456     define variable v-exists-before as logical      no-undo.
     1457     define variable v-exists-after  as logical      no-undo.
     1458     define variable v-need-new-file  as logical     no-undo.
     1459     define variable v-need-disk-spc  as logical     no-undo.
     1460     define variable v-cancel         as logical     no-undo.
     1461     define variable v-prev-filename  as character   no-undo.
     1462     define variable v-void-string    as character   no-undo.
     1463     define buffer buf_sysconf for ub.sysconf.
     1464   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1465     define variable v-doc-code      as character    no-undo.
     1466     define variable v-exch-abbr       like ub.currency.curr-abbr no-undo .
     1467     define variable v-exch-name       like ub.currency.curr-name no-undo .
     1468     define variable v-contr-abbr       like ub.currency.curr-abbr no-undo .
     1469     define variable v-contr-name       like ub.currency.curr-name no-undo .
     1470     define variable v-contract-prn-code like ub.contract.contract-prn-code no-undo .
     1471     define variable v-contract-date     like ub.contract.contract-date no-undo .
     1472     define buffer buf_fin-doc-tax          for ub.fin-doc-tax.
     1473     define buffer buf_fin-doc              for ub.fin-doc.
     1474     define buffer buf_contract for ub.contract.
     1475     assign
     1476         p-last-xml-file-name    = p-xml-file-name
     1477         p-last-xml-file-number  = p-xml-file-number
     1478     .
     1479     output stream stmxmlout to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1480     export-documents:
     1481     for each buf_fin-doc no-lock where
     1482             buf_fin-doc.host-code = p-host-code
     1483         AND buf_fin-doc.fact-order >= p-fact-order-from
     1484         AND buf_fin-doc.fact-order <= p-fact-order-to
     1485         AND buf_fin-doc.status_ = 'факт':U
     1486     on error undo, return error
     1487     :
     1488       if buf_fin-doc.obj-type = "":U and buf_fin-doc.obj-code = 0
     1489       and p-mode = "shd":U
     1490       then do:
     1491         find first buf_sysconf no-lock where buf_fin-doc.host-code = buf_sysconf.host-code .
     1492         if buf_sysconf.firm-db-num <> p-db-num then next export-documents.
     1493       end.
     1494       if buf_fin-doc.fin-ext-doc-type <> p-ext-doc-type then next export-documents.
     1495       if buf_fin-doc.obj-type = "":U and buf_fin-doc.obj-code = 0 and not (p-range = 1 or p-range = 2) then next export-documents.
     1496       if buf_fin-doc.obj-code <> 0
     1497       and trim(p-obj-list) <> "":U
     1498       and p-mode <> "":U
     1499       and not can-find(first temp-obj no-lock where
     1500                              temp-obj.obj-type = buf_fin-doc.obj-type
     1501                          and temp-obj.obj-code = buf_fin-doc.obj-code) then  next export-documents.
     1502       if v-need-new-file = yes
     1503       then do:
     1504           output stream stmxmlout close.
     1505           assign
     1506               v-prev-filename = p-xml-file-name
     1507           .
     1508           run bgelib-filename in this-procedure (
     1509                 input "findoc"
     1510               , output p-xml-file-name
     1511               , output v-void-string
     1512               , output v-void-string
     1513           ).
     1514           run bgelib-write-footer in this-procedure (
     1515                 input no
     1516               , input v-prev-filename
     1517               , input p-list-file-name
     1518               , input yes
     1519               , input p-xml-file-name + "xml":U
     1520           ).
     1521           run bgelib-write-log in this-procedure (
     1522               input p-log-file-name
     1523               , input 1
     1524               , input substitute( "Данные выгружены в файл &1"
     1525                                       , replace( p-xml-file-name, "/", "\" ) + "xml"
     1526                               )
     1527           ).
     1528           assign
     1529               p-last-xml-file-number   = p-xml-file-number + 1
     1530               p-last-xml-file-name     = p-xml-file-name
     1531           .
     1532           run bgelib-write-header in this-procedure (
     1533                 input no
     1534               , input p-last-xml-file-name
     1535               , input p-list-file-name
     1536               , input p-last-xml-file-number
     1537               , input yes
     1538               , input v-prev-filename + "xml":U
     1539               , input p-obj-list
     1540               , input p-doc-type-list
     1541               , input p-parameter-list
     1542           ).
     1543           output stream stmxmlout to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1544           assign
     1545               v-need-new-file = no
     1546           .
     1547       end.
     1548       assign
     1549           v-doc-code = string(buf_fin-doc.fin-doc-code)
     1550       .
     1551       if not v-exists-operation
     1552       then do:
     1553           run bgelib-write-edt in this-procedure ( hEDT, 4, "Операция " + string( p-oper-name ) ).
     1554           run bgelib-write-log in this-procedure ( p-log-file-name, 0, "&Line" ).
     1555           run bgelib-write-log in this-procedure ( p-log-file-name, 1, "XML - Вывод операции " + string( p-oper-name ) + " (" + p-ext-doc-type + ")" ).
     1556           assign
     1557               v-exists-operation = yes
     1558           .
     1559       end.
     1560       assign
     1561       v-doc-code  = string(buf_fin-doc.fin-doc-code)
     1562       v-doc-date  = buf_fin-doc.doc-date
     1563       v-fact-date = buf_fin-doc.fact-date
     1564       v-doc-PS    = buf_fin-doc.ps
     1565       .
     1566       run bgelib-write-cnt( hcnt, "   " + string( v-doc-code ) + " от " + string( v-fact-date ) ) .
     1567       process events.
     1568   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1569   run bgelib-tag-open in this-procedure ( input 0, substitute("&1", 'findoc'),  "" ).
     1570   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'paymentDocID'),  input string(buf_fin-doc.fin-doc-code), input 1 ).
     1571   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'cashbookid'),  input string(buf_fin-doc.cashbookid), input 1 ).
     1572   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'paymentCodeOperation'),  input string(buf_fin-doc.fin-ext-doc-type), input 1 ).
     1573   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'paymentStatus'),  input string(buf_fin-doc.status_), input 1 ).
     1574   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'host'),  input string(buf_fin-doc.host-code), input 1 ).
     1575   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'paymentDocCode'),  input string(buf_fin-doc.prn-doc-code), input 1 ).
     1576   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'object'),  input string(buf_fin-doc.obj-type + string(buf_fin-doc.obj-code)), input 1 ).
     1577   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'paymentDateDoc'),  input string(buf_fin-doc.doc-date, '99.99.9999'), input 1 ).
     1578   if buf_fin-doc.fact-date <> ? then do:
     1579         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'paymentDateFact'),  input string(buf_fin-doc.fact-date, '99.99.9999'), input 1 ).
     1580   end.
     1581   if buf_fin-doc.pay-date <> ? then do:
     1582         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'paymentDatePay'),  input string(buf_fin-doc.pay-date, '99.99.9999'), input 1 ).
     1583   end.
     1584   if buf_fin-doc.perm-date <> ? then do:
     1585         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'paymentDatePermission'),  input string(buf_fin-doc.perm-date, '99.99.9999'), input 1 ).
     1586   end.
     1587   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'paymentDocDBNum'),  input string(buf_fin-doc.user-db-num-doc), input 1 ).
     1588   if buf_fin-doc.fact-date <> ? then do:
     1589         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'paymentFactDBNum'),  input string(buf_fin-doc.user-db-num-fact), input 1 ).
     1590   end.
     1591   if buf_fin-doc.pay-date <> ? then do:
     1592         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'paymentPayDBNum'),  input string(buf_fin-doc.user-db-num-pl), input 1 ).
     1593   end.
     1594   if buf_fin-doc.perm-date <> ? then do:
     1595         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'paymentPermissionDBNum'),  input string(buf_fin-doc.user-db-num-perm), input 1 ).
     1596   end.
     1597   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'paymentDocUserName'),  input string(buf_fin-doc.user-name-doc), input 1 ).
     1598   if buf_fin-doc.fact-date <> ? then do:
     1599         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'paymentFactUserName'),  input string(buf_fin-doc.user-name-fact), input 1 ).
     1600   end.
     1601   if buf_fin-doc.pay-date <> ? then do:
     1602         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'paymentPayUserName'),  input string(buf_fin-doc.user-name-pl), input 1 ).
     1603   end.
     1604   if buf_fin-doc.perm-date <> ? then do:
     1605         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'paymentPermissionUserName'),  input string(buf_fin-doc.user-name-perm), input 1 ).
     1606   end.
     1607   find first buf_currency no-lock where
     1608             buf_currency.curr-code = buf_fin-doc.curr-code no-error .
     1609   if available buf_currency then
     1610   assign
     1611   v-exch-abbr = buf_currency.curr-abbr
     1612   v-exch-name = buf_currency.curr-name
     1613   .
     1614   else
     1615   assign
     1616   v-exch-abbr = "":U
     1617   v-exch-name = "":U
     1618   .
     1619   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sumDoc'),  input string(buf_fin-doc.sum-doc), input 1 ).
     1620   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'paymentCrcCode'),  input string(buf_fin-doc.curr-code), input 1 ).
     1621   if v-exch-abbr <> "":U then do:
