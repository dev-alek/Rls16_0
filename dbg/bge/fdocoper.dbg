      595   procedure xmlchar-decode :
      596   define input parameter p-in-string      as character        no-undo.
      597   define output parameter p-out-string    as character        no-undo.
      598       define variable v-position      as integer      no-undo.
      599       define variable v-last-position as integer      no-undo.
      600       define variable v-temp-integer  as integer      no-undo.
      601       define variable v-current-char  as character    no-undo.
      602       define variable v-next-char     as character    no-undo.
      603       define variable v-success       as logical      no-undo.
      604   do
      605   on error undo, return error
      606   :
      607       assign
      608           p-out-string = "":U
      609           v-position   = 0
      610       .
      611       replace-cycle:
      612       do while yes
      613       on error undo, return error
      614       :
      615           assign
      616               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      617           .
      618           if v-last-position <= v-position
      619           then do:
      620               if v-position = 0
      621               then do:
      622                   assign
      623                       p-out-string = p-in-string
      624                   .
      625               end.
      626               else do:
      627                   assign
      628                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      629                   .
      630               end.
      631               leave replace-cycle.
      632           end.
      633           else do:
      634               assign
      635                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      636                   v-position      = v-last-position
      637                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      638               .
      639               if v-current-char = "#":U
      640               then do:
      641                   assign
      642                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      643                   .
      644                   if v-last-position > 0
      645                   then do:
      646                       run xmlchar-read-integer in this-procedure
      647                        (
      648                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      649                           , output v-temp-integer
      650                           , output v-success
      651                       ).
      652                       if v-success = yes
      653                       and v-temp-integer >= 1
      654                       and v-temp-integer <= 255
      655                       then do:
      656                           assign
      657                               p-out-string = p-out-string + chr( v-temp-integer )
      658                               v-position   = v-last-position + 1
      659                           .
      660                       end.
      661                       else do:
      662                           assign
      663                               p-out-string = p-out-string + "&":U
      664                               v-position   = v-position   + 1
      665                           .
      666                       end.
      667                   end.
      668                   else do:
      669                       assign
      670                           p-out-string = p-out-string + "&":U
      671                           v-position   = v-position   + 1
      672                       .
      673                   end.
      674               end.
      675               else do:
      676                   case substring( p-in-string, v-position + 1, 3 )
      677                   :
      678                       when "lt;":U
      679                       then do:
      680                           assign
      681                               p-out-string = p-out-string + "<":U
      682                               v-position   = v-position   + 3
      683                           .
      684                       end.
      685                       when "gt;":U
      686                       then do:
      687                           assign
      688                               p-out-string = p-out-string + ">":U
      689                               v-position   = v-position   + 3
      690                           .
      691                       end.
      692                       otherwise do:
      693                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      694                           then do:
      695                               assign
      696                                   p-out-string = p-out-string + "&":U
      697                                   v-position   = v-position   + 4
      698                               .
      699                           end.
      700                           else do:
      701                               case substring( p-in-string, v-position + 1, 5 )
      702                               :
      703                                   when "quot;":U
      704                                   then do:
      705                                       assign
      706                                           p-out-string = p-out-string + '"':U
      707                                           v-position   = v-position   + 5
      708                                       .
      709                                   end.
      710                                   when "apos;":U
      711                                   then do:
      712                                       assign
      713                                           p-out-string = p-out-string + "'":U
      714                                           v-position   = v-position   + 5
      715                                       .
      716                                   end.
      717                                   otherwise do:
      718                                       assign
      719                                           p-out-string = p-out-string + "&":U
      720                                       .
      721                                   end.
      722                               end case.
      723                           end.
      724                       end.
      725                   end case.
      726               end.
      727           end.
      728       end.
      729   end.
      730   end .
      731   procedure xmlchar-read-integer :
      732   define input parameter p-input-string      as character        no-undo.
      733   define output parameter p-output-integer   as integer          no-undo.
      734   define output parameter p-success       as logical          no-undo.
      735   do
      736   on error undo, return error
      737   :
      738       assign
      739           p-output-integer = integer( p-input-string )
      740       no-error.
      741       if error-status :error
      742       then do:
      743           assign
      744               p-success           = no
      745               p-output-integer    = 0
      746           .
      747       end.
      748       else do:
      749           assign
      750               p-success           = yes
      751           .
      752       end.
      753   end.
      754   end.
      755   define variable v-bgelib-bgeclall           as logical      no-undo.
      756   define variable v-bgelib-bgedict            as logical      no-undo.
      757   define temp-table temp_ext-doc-type no-undo
      758       field edt-key               as integer
      759       field ext-doc-type          as character
      760       field ext-doc-type-label    as character
      761       index pi is primary unique
      762           edt-key
      763   .
      764   define temp-table temp_bgelib_goods no-undo
      765       field gds-code as integer
      766       index pi is primary unique
      767           gds-code
      768   .
      769   define temp-table temp_bgelib_clients no-undo
      770       field obj-type as character
      771       field obj-code as integer
      772       index pi is primary unique
      773           obj-type
      774           obj-code
      775   .
      776   define temp-table temp_bgelib_dis-card no-undo
      777       field d-card as character
      778       index pi is primary unique
      779           d-card
      780   .
      781   define temp-table temp_bgelib_trn-doc no-undo
      782       field doc-code as integer
      783   .
      784   procedure bgelib-tag-open:
      785   do
      786   on error undo, return error
      787   :
      788   define input parameter v-tag-level  as integer      no-undo.
      789   define input parameter v-tag-name   as character    no-undo.
      790   define input parameter v-tag-value  as character    no-undo.
      791       put stream stmXMLOut unformatted
      792           chr(10)
      793           + fill(" ", 4 * v-tag-level)
      794           + "<" + v-tag-name
      795           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      796           + v-tag-value + ">"
      797       .
      798   end.
      799   end procedure.
      800   procedure bgelib-tag-put:
      801   do
      802   on error undo, return error
      803   :
      804   define input parameter v-tag-level      as integer      no-undo.
      805   define input parameter v-tag-name       as character    no-undo.
      806   define input parameter v-tag-value      as character    no-undo.
      807   define input parameter v-empty-mode     as integer      no-undo.
      808       v-tag-name = trim(v-tag-name).
      809       if  v-empty-mode = 1
      810       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      811       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      812       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      813       then do:
      814           run xmlchar-encode in this-procedure (
      815                 input v-tag-value
      816               , output v-tag-value
      817           ).
      818           put stream stmXMLOut unformatted
      819               chr(10) + fill(" ", 4 * v-tag-level)
      820                           + '<' + v-tag-name + '>'
      821                           + v-tag-value
      822                           + '</' + v-tag-name + '>'
      823           .
      824       end.
      825   end.
      826   end procedure.
      827   procedure bgelib-tag-close:
      828   do
      829   on error undo, return error
      830   :
      831   define input parameter v-tag-level as integer      no-undo.
      832   define input parameter v-tag-name  as character    no-undo.
      833       put stream stmXMLOut unformatted
      834           chr(10)
      835           + fill( " ", 4 * v-tag-level)
      836           + '</' + v-tag-name + '>'
      837       .
      838   end.
      839   end procedure.
      840   procedure bgelib-write-log:
      841   do
      842   on error undo, return error
      843   :
      844   define input parameter v-filename   as character    no-undo.
      845   define input parameter v-log-level  as integer      no-undo.
      846   define input parameter v-out-string as character    no-undo.
      847       output stream stmXMLLog to value( v-filename ) append.
      848       put stream stmXMLLog unformatted
      849           chr(10)
      850       .
      851       put stream stmXMLLog unformatted
      852           ( if v-log-level = 0
      853             or v-out-string = "&DLine"
      854             or v-out-string = "&Line"
      855             then ""
      856             else cur-time-string-sec() + " " )
      857       .
      858       put stream stmXMLLog unformatted
      859           ( if v-out-string = "&Line"
      860             then fill( "-", 80 )
      861             else if v-out-string = "&DLine"
      862                  then fill( "=", 80 )
      863                  else v-out-string )
      864       .
      865       output stream stmXMLLog close.
      866   end.
      867   end procedure.
      868   procedure bgelib-write-edt:
      869   do
      870   on error undo, return error
      871   :
      872   define input parameter v-editor-handle    as handle       no-undo.
      873   define input parameter v-log-level        as integer      no-undo.
      874   define input parameter v-out-string       as character    no-undo.
      875       if valid-handle ( v-editor-handle )
      876       then do:
      877           v-editor-handle :move-to-eof().
      878           v-editor-handle :insert-string( ( if v-log-level = 0
      879                                             or v-out-string = "&DLine"
      880                                             or v-out-string = "&Line"
      881                                             then ""
      882                                             else cur-time-string-sec() + " "
      883                                         ) ).
      884           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      885                                             then fill( "-", 80 )
      886                                             else if v-out-string = "&DLine" then fill("=", 80)
      887                                             else fill( " ", v-log-level) + v-out-string
      888                                         ) ).
      889           v-editor-handle :insert-string( chr(10) ).
      890       end.
      891       process events.
      892       output to 'bgescn.txt' append.
      893           put unformatted
      894               chr(10)
      895               string( ( if v-log-level = 0
      896                         or v-out-string = "&DLine"
      897                         or v-out-string = "&Line"
      898                         then ""
      899                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      900                     ) )
      901               string( ( if v-out-string = "&Line"
      902                         then fill( "-", 80 )
      903                         else if v-out-string = "&DLine"
      904                              then fill( "=", 80 )
      905                              else fill( " ", v-log-level ) + v-out-string
      906                     ) )
      907           .
      908       output close.
      909   end.
      910   end procedure.
      911   procedure bgelib-show-cnt:
      912   do
      913   on error undo, return error
      914   :
      915   define input parameter v-fillin-handle     as handle   no-undo.
      916       if valid-handle( v-fillin-handle )
      917       then do:
      918           assign
      919               v-fillin-handle :visible = true
      920           .
      921       end.
      922   end.
      923   end procedure.
      924   procedure bgelib-hide-cnt:
      925   do
      926   on error undo, return error
      927   :
      928   define input parameter v-fillin-handle     as handle   no-undo.
      929       if valid-handle( v-fillin-handle )
      930       then do:
      931           assign v-fillin-handle :visible = false.
      932       end.
      933   end.
      934   end procedure.
      935   procedure bgelib-write-cnt:
      936   do
      937   on error undo, return error
      938   :
      939   define input parameter v-fillin-handle    as handle       no-undo.
      940   define input parameter v-fillin-string    as character    no-undo.
      941       if valid-handle( v-fillin-handle )
      942       then do:
      943           assign
      944               v-fillin-handle :SCREEN-value = v-fillin-string
      945           .
      946       end.
      947   end.
      948   end procedure.
      949   procedure bgelib-write-header:
      950   do
      951   on error undo, return error
      952   :
      953   define input parameter p-first-file     as logical      no-undo.
      954   define input parameter p-xml-file-name  as character    no-undo.
      955   define input parameter p-list-file-name as character    no-undo.
      956   define input parameter p-file-number    as integer      no-undo.
      957   define input parameter p-have-prev      as logical      no-undo.
      958   define input parameter p-prev-filename  as character    no-undo.
      959   define input parameter p-obj-list       as character    no-undo.
      960   define input parameter p-doc-type-list  as character    no-undo.
      961   define input parameter p-parameter-list as character    no-undo.
      962       define variable v-counter    as integer        no-undo.
      963       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      964       put stream stmXMLOut unformatted
      965           "<?xml version='1.0' encoding='windows-1251'?>"
      966       .
      967       run bgelib-tag-open( input 0, input "root"  , input "" ).
      968       run bgelib-tag-open( input 0, input "header", input "" ).
      969       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      970       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      971       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      972       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      973       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      974       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      975       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      976       :
      977           run bgelib-tag-put(
      978                 input 1
      979               , input entry( 2 * v-counter, p-parameter-list )
      980               , input entry( 2 * v-counter + 1, p-parameter-list )
      981               , input 0
      982           ).
      983       end.
      984       run bgelib-tag-close( input 0, input "header" ).
      985       output stream stmXMLOut close.
      986       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      987       if p-first-file = yes
      988       then do:
      989           put stream stmXMLOut unformatted
      990               "<?xml version='1.0' encoding='windows-1251'?>"
      991           .
      992           run bgelib-tag-open( input 0, input "export", input "" ).
      993       end.
      994       run bgelib-tag-open( input 1, input "file", input "" ).
      995       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      996       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      997       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      998       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
      999       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1000       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1001       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1002       :
     1003           run bgelib-tag-put(
     1004                 input 2
     1005               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1006               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1007               , input 0
     1008           ).
     1009       end.
     1010       run bgelib-tag-close( input 1, input "file" ).
     1011       output stream stmXMLOut close.
     1012   end.
     1013   end procedure.
     1014   procedure bgelib-write-footer:
     1015   do
     1016   on error undo, return error
     1017   :
     1018   define input parameter p-last-file      as logical      no-undo.
     1019   define input parameter p-xml-file-name  as character    no-undo.
     1020   define input parameter p-list-file-name as character    no-undo.
     1021   define input parameter p-have-next      as logical      no-undo.
     1022   define input parameter p-next-file-name as character    no-undo.
     1023       define variable v-error-num     as integer           no-undo.
     1024       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1025       if p-have-next = yes
     1026       then do:
     1027           run bgelib-tag-open( input 0, input "footer", "" ).
     1028           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1029           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1030           run bgelib-tag-close( input 0, input "footer" ).
     1031       end.
     1032       run bgelib-tag-close( input 0, input "root" ).
     1033       output stream stmXMLOut close.
     1034       run bge/os_copy.p (
     1035             input "M"
     1036           , input p-xml-file-name + "tmp"
     1037           , input p-xml-file-name + "xml"
     1038           , output v-error-num
     1039       ).
     1040       if p-last-file = yes
     1041       then do:
     1042           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1043               run bgelib-tag-close( input 0, input "export" ).
     1044           output stream stmXMLOut close.
     1045           run bge/os_copy.p (
     1046                 input "M"
     1047               , input p-list-file-name + "tmp"
     1048               , input p-list-file-name + "xml"
     1049               , output v-error-num
     1050           ).
     1051       end.
     1052   end.
     1053   end procedure.
     1054   procedure bgelib-filename :
     1055   do
     1056   on error undo, return error
     1057   :
     1058   define input parameter p-prefix             as character    no-undo.
     1059   define output parameter p-xml-file-name     as character    no-undo.
     1060   define output parameter p-log-file-name     as character    no-undo.
     1061   define output parameter p-list-file-name    as character    no-undo.
     1062       define variable v-home-dir  as character    no-undo.
     1063       define variable v-error-num as integer      no-undo.
     1064       get-key-value section "BGE" key "outdir" value v-home-dir.
     1065       if v-home-dir = ?
     1066       then do:
     1067           message
     1068             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1069             skip(1)
     1070             skip "Обратитесь к администратору."
     1071           view-as alert-box error.
     1072           undo, return error .
     1073       end.
     1074       run gbl/dir-cre.p (
     1075           input v-home-dir
     1076       ) no-error.
     1077       if error-status :error
     1078       then do:
     1079           message
     1080             skip "Неверно задан каталог экспорта."
     1081             skip(1)
     1082             skip "Обратитесь к администратору."
     1083           view-as alert-box error.
     1084           undo, return error .
     1085       end.
     1086       run bge/genfname.p (
     1087             input v-home-dir
     1088           , input p-prefix
     1089           , input ""
     1090           , input "xml"
     1091           , input "tmp"
     1092           , output p-xml-file-name
     1093       ).
     1094       assign
     1095           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1096           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1097           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1098       .
     1099   end.
     1100   end procedure.
     1101   procedure bgelib-read-config :
     1102   do
     1103   on error undo, return error
     1104   :
     1105   define variable v-par-type as character     no-undo.
     1106     define variable v-param-type      as character  no-undo .
     1107     define variable v-value-character as character  no-undo .
     1108     define variable v-value-date      as date       no-undo .
     1109     define variable v-value-decimal   as decimal    no-undo .
     1110     define variable v-value-integer   as integer    no-undo .
     1111     define variable v-value-logical   as logical    no-undo .
     1112     define variable v-tth             as handle     no-undo .
     1113       assign
     1114           v-bgelib-bgeclall = no
     1115           v-bgelib-bgedict  = no
     1116       .
     1117       run adm/shattri.p ( input "get":U
     1118                         , input  '':u
     1119                         , input  0
     1120                         , input  'bge-export':U
     1121                         , input  'bgeclall':U
     1122                         , output v-value-character
     1123                         , output v-value-date
     1124                         , output v-value-decimal
     1125                         , output v-value-integer
     1126                         , output v-value-logical
     1127                         , output v-param-type
     1128                         , input-output table-handle v-tth
     1129                         ) no-error .
     1130       if error-status :error
     1131       then do:
     1132         assign
     1133           v-bgelib-bgeclall = no
     1134         .
     1135       end.
     1136       else do:
     1137         assign
     1138           v-bgelib-bgeclall = v-value-logical
     1139         .
     1140       end.
     1141       delete object v-tth.
     1142       run adm/shattri.p ( input "get":U
     1143                         , input  '':u
     1144                         , input  0
     1145                         , input  'bge-export':U
     1146                         , input  'bgedict':U
     1147                         , output v-value-character
     1148                         , output v-value-date
     1149                         , output v-value-decimal
     1150                         , output v-value-integer
     1151                         , output v-value-logical
     1152                         , output v-param-type
     1153                         , input-output table-handle v-tth
     1154                         ) no-error .
     1155       if error-status :error
     1156       then do:
     1157         assign
     1158           v-bgelib-bgedict = no
     1159         .
     1160       end.
     1161       else do:
     1162         assign
     1163           v-bgelib-bgedict = v-value-logical
     1164         .
     1165       end.
     1166       delete object v-tth.
     1167       run adm/shattri.p ( input "get":U
     1168                         , input  '':u
     1169                         , input  0
     1170                         , input  'bge-export':U
     1171                         , input  'bgefmt':U
     1172                         , output v-value-character
     1173                         , output v-value-date
     1174                         , output v-value-decimal
     1175                         , output v-value-integer
     1176                         , output v-value-logical
     1177                         , output v-param-type
     1178                         , input-output table-handle v-tth
     1179                         ) no-error .
     1180       if error-status :error
     1181       then do:
     1182         assign
     1183           v-bgelib-bgefmt  = "xml":U
     1184         .
     1185       end.
     1186       else do:
     1187         assign
     1188           v-bgelib-bgefmt  = v-value-character
     1189         .
     1190       end.
     1191       delete object v-tth.
     1192       run adm/shattri.p ( input "get":U
     1193                         , input  '':u
     1194                         , input  0
     1195                         , input  'bge-export':U
     1196                         , input  'bgeflold':U
     1197                         , output v-value-character
     1198                         , output v-value-date
     1199                         , output v-value-decimal
     1200                         , output v-value-integer
     1201                         , output v-value-logical
     1202                         , output v-param-type
     1203                         , input-output table-handle v-tth
     1204                         ) no-error .
     1205       if error-status :error
     1206       then do:
     1207         assign
     1208           v-bgelib-bgeflold  = "old":U
     1209         .
     1210       end.
     1211       else do:
     1212         assign
     1213           v-bgelib-bgeflold  = v-value-character
     1214         .
     1215       end.
     1216       delete object v-tth.
     1217   end.
     1218   end procedure.
     1219   procedure bgelib-check-file-size :
     1220   do
     1221   on error undo, return error
     1222   :
     1223   define input parameter p-out-filename   as character    no-undo.
     1224   define output parameter p-is-big        as logical      no-undo.
     1225       define variable v-current-position    as integer        no-undo.
     1226       assign
     1227           v-current-position = seek( stmXMLOut )
     1228       .
     1229       if v-current-position / 1024 / 1024  >= 100
     1230       then do:
     1231           assign
     1232               p-is-big = yes
     1233           .
     1234       end.
     1235   end.
     1236   end procedure.
     1237   procedure bgelib-init-ext-doc-type :
     1238       define variable v-counter    as integer      no-undo.
     1239       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1240   do
     1241   for buf_temp_ext-doc-type
     1242   on error undo, return error
     1243   :
     1244       empty temp-table buf_temp_ext-doc-type.
     1245       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1246       :
     1247           create buf_temp_ext-doc-type.
     1248           assign
     1249               buf_temp_ext-doc-type.edt-key               = v-counter
     1250               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1251               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1252           .
     1253       end.
     1254   end.
     1255   end procedure.
