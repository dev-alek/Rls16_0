     1858     end.
     1859         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineVatSumDoc'),  input string(buf_fin-doc-tax.sum-vat-line-doc), input 1 ).
     1860         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineVatSumRubl'),  input string(buf_fin-doc-tax.sum-vat-line-rubl), input 1 ).
     1861         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineVatSumBase'),  input string(buf_fin-doc-tax.sum-vat-line-base), input 1 ).
     1862     if buf_fin-doc.contract-code <> 0 then do:
     1863               run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineVatSumContr'),  input string(buf_fin-doc-tax.sum-vat-line-contr), input 1 ).
     1864     end.
     1865         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineVat'),  input string(buf_fin-doc-tax.vat-pc), input 1 ).
     1866         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'lineWithVat'),  input string((if buf_fin-doc-tax.with-vat then "yes" else "no")), input 1 ).
     1867         run bgelib-tag-close in this-procedure ( input 0, substitute("&1", 'taxLine')).
     1868   end.
     1869       if v-last-file-position = 0
     1870       or seek( stmxmlout ) - v-last-file-position > 1048576
     1871       then do:
     1872         run gbl/chkfree.p (
     1873             input substring( p-xml-file-name, 1, 1 )
     1874             , input 200
     1875             , output v-need-disk-spc
     1876         ) .
     1877         if v-need-disk-spc = yes
     1878         then do:
     1879             run gbl/waitfrsp.w (
     1880                 input substring( p-xml-file-name, 1, 1 )
     1881                 , input 200
     1882                 , output v-cancel
     1883             ) .
     1884             if v-cancel = yes
     1885             then do:
     1886                 undo, return error.
     1887             end.
     1888         end.
     1889         assign
     1890             v-last-file-position = seek( stmxmlout )
     1891         .
     1892       end.
     1893       run bgelib-check-file-size in this-procedure (
     1894             input p-xml-file-name + "tmp"
     1895           , output v-need-new-file
     1896       ).
     1897     end.
     1898     output stream stmxmlout close.
     1899   end.
     1900   end procedure.
