      660                       end.
      661                   end case.
      662               end.
      663           end.
      664       end case.
      665   end.
      666   end .
      667   procedure xmlchar-decode :
      668   define input parameter p-in-string      as character        no-undo.
      669   define output parameter p-out-string    as character        no-undo.
      670       define variable v-position      as integer      no-undo.
      671       define variable v-last-position as integer      no-undo.
      672       define variable v-temp-integer  as integer      no-undo.
      673       define variable v-current-char  as character    no-undo.
      674       define variable v-next-char     as character    no-undo.
      675       define variable v-success       as logical      no-undo.
      676   do
      677   on error undo, return error
      678   :
      679       assign
      680           p-out-string = "":U
      681           v-position   = 0
      682       .
      683       replace-cycle:
      684       do while yes
      685       on error undo, return error
      686       :
      687           assign
      688               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      689           .
      690           if v-last-position <= v-position
      691           then do:
      692               if v-position = 0
      693               then do:
      694                   assign
      695                       p-out-string = p-in-string
      696                   .
      697               end.
      698               else do:
      699                   assign
      700                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      701                   .
      702               end.
      703               leave replace-cycle.
      704           end.
      705           else do:
      706               assign
      707                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      708                   v-position      = v-last-position
      709                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      710               .
      711               if v-current-char = "#":U
      712               then do:
      713                   assign
      714                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      715                   .
      716                   if v-last-position > 0
      717                   then do:
      718                       run xmlchar-read-integer in this-procedure
      719                        (
      720                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      721                           , output v-temp-integer
      722                           , output v-success
      723                       ).
      724                       if v-success = yes
      725                       and v-temp-integer >= 1
      726                       and v-temp-integer <= 255
      727                       then do:
      728                           assign
      729                               p-out-string = p-out-string + chr( v-temp-integer )
      730                               v-position   = v-last-position + 1
      731                           .
      732                       end.
      733                       else do:
      734                           assign
      735                               p-out-string = p-out-string + "&":U
      736                               v-position   = v-position   + 1
      737                           .
      738                       end.
      739                   end.
      740                   else do:
      741                       assign
      742                           p-out-string = p-out-string + "&":U
      743                           v-position   = v-position   + 1
      744                       .
      745                   end.
      746               end.
      747               else do:
      748                   case substring( p-in-string, v-position + 1, 3 )
      749                   :
      750                       when "lt;":U
      751                       then do:
      752                           assign
      753                               p-out-string = p-out-string + "<":U
      754                               v-position   = v-position   + 3
      755                           .
      756                       end.
      757                       when "gt;":U
      758                       then do:
      759                           assign
      760                               p-out-string = p-out-string + ">":U
      761                               v-position   = v-position   + 3
      762                           .
      763                       end.
      764                       otherwise do:
      765                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      766                           then do:
      767                               assign
      768                                   p-out-string = p-out-string + "&":U
      769                                   v-position   = v-position   + 4
      770                               .
      771                           end.
      772                           else do:
      773                               case substring( p-in-string, v-position + 1, 5 )
      774                               :
      775                                   when "quot;":U
      776                                   then do:
      777                                       assign
      778                                           p-out-string = p-out-string + '"':U
      779                                           v-position   = v-position   + 5
      780                                       .
      781                                   end.
      782                                   when "apos;":U
      783                                   then do:
      784                                       assign
      785                                           p-out-string = p-out-string + "'":U
      786                                           v-position   = v-position   + 5
      787                                       .
      788                                   end.
      789                                   otherwise do:
      790                                       assign
      791                                           p-out-string = p-out-string + "&":U
      792                                       .
      793                                   end.
      794                               end case.
      795                           end.
      796                       end.
      797                   end case.
      798               end.
      799           end.
      800       end.
      801   end.
      802   end .
      803   procedure xmlchar-read-integer :
      804   define input parameter p-input-string      as character        no-undo.
      805   define output parameter p-output-integer   as integer          no-undo.
      806   define output parameter p-success       as logical          no-undo.
      807   do
      808   on error undo, return error
      809   :
      810       assign
      811           p-output-integer = integer( p-input-string )
      812       no-error.
      813       if error-status :error
      814       then do:
      815           assign
      816               p-success           = no
      817               p-output-integer    = 0
      818           .
      819       end.
      820       else do:
      821           assign
      822               p-success           = yes
      823           .
      824       end.
      825   end.
      826   end.
      827   define variable v-bgelib-bgeclall           as logical      no-undo.
      828   define variable v-bgelib-bgedict            as logical      no-undo.
      829   define temp-table temp_ext-doc-type no-undo
      830       field edt-key               as integer
      831       field ext-doc-type          as character
      832       field ext-doc-type-label    as character
      833       index pi is primary unique
      834           edt-key
      835   .
      836   define temp-table temp_bgelib_goods no-undo
      837       field gds-code as integer
      838       index pi is primary unique
      839           gds-code
      840   .
      841   define temp-table temp_bgelib_clients no-undo
      842       field obj-type as character
      843       field obj-code as integer
      844       index pi is primary unique
      845           obj-type
      846           obj-code
      847   .
      848   define temp-table temp_bgelib_dis-card no-undo
      849       field d-card as character
      850       index pi is primary unique
      851           d-card
      852   .
      853   define temp-table temp_bgelib_trn-doc no-undo
      854       field doc-code as integer
      855   .
      856   procedure bgelib-tag-open:
      857   do
      858   on error undo, return error
      859   :
      860   define input parameter v-tag-level  as integer      no-undo.
      861   define input parameter v-tag-name   as character    no-undo.
      862   define input parameter v-tag-value  as character    no-undo.
      863       put stream stmXMLOut unformatted
      864           chr(10)
      865           + fill(" ", 4 * v-tag-level)
      866           + "<" + v-tag-name
      867           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      868           + v-tag-value + ">"
      869       .
      870   end.
      871   end procedure.
      872   procedure bgelib-tag-put:
      873   do
      874   on error undo, return error
      875   :
      876   define input parameter v-tag-level      as integer      no-undo.
      877   define input parameter v-tag-name       as character    no-undo.
      878   define input parameter v-tag-value      as character    no-undo.
      879   define input parameter v-empty-mode     as integer      no-undo.
      880       v-tag-name = trim(v-tag-name).
      881       if  v-empty-mode = 1
      882       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      883       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      884       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      885       then do:
      886           run xmlchar-encode in this-procedure (
      887                 input v-tag-value
      888               , output v-tag-value
      889           ).
      890           put stream stmXMLOut unformatted
      891               chr(10) + fill(" ", 4 * v-tag-level)
      892                           + '<' + v-tag-name + '>'
      893                           + v-tag-value
      894                           + '</' + v-tag-name + '>'
      895           .
      896       end.
      897   end.
      898   end procedure.
      899   procedure bgelib-tag-close:
      900   do
      901   on error undo, return error
      902   :
      903   define input parameter v-tag-level as integer      no-undo.
      904   define input parameter v-tag-name  as character    no-undo.
      905       put stream stmXMLOut unformatted
      906           chr(10)
      907           + fill( " ", 4 * v-tag-level)
      908           + '</' + v-tag-name + '>'
      909       .
      910   end.
      911   end procedure.
      912   procedure bgelib-write-log:
      913   do
      914   on error undo, return error
      915   :
      916   define input parameter v-filename   as character    no-undo.
      917   define input parameter v-log-level  as integer      no-undo.
      918   define input parameter v-out-string as character    no-undo.
      919       output stream stmXMLLog to value( v-filename ) append.
      920       put stream stmXMLLog unformatted
      921           chr(10)
      922       .
      923       put stream stmXMLLog unformatted
      924           ( if v-log-level = 0
      925             or v-out-string = "&DLine"
      926             or v-out-string = "&Line"
      927             then ""
      928             else cur-time-string-sec() + " " )
      929       .
      930       put stream stmXMLLog unformatted
      931           ( if v-out-string = "&Line"
      932             then fill( "-", 80 )
      933             else if v-out-string = "&DLine"
      934                  then fill( "=", 80 )
      935                  else v-out-string )
      936       .
      937       output stream stmXMLLog close.
      938   end.
      939   end procedure.
      940   procedure bgelib-write-edt:
      941   do
      942   on error undo, return error
      943   :
      944   define input parameter v-editor-handle    as handle       no-undo.
      945   define input parameter v-log-level        as integer      no-undo.
      946   define input parameter v-out-string       as character    no-undo.
      947       if valid-handle ( v-editor-handle )
      948       then do:
      949           v-editor-handle :move-to-eof().
      950           v-editor-handle :insert-string( ( if v-log-level = 0
      951                                             or v-out-string = "&DLine"
      952                                             or v-out-string = "&Line"
      953                                             then ""
      954                                             else cur-time-string-sec() + " "
      955                                         ) ).
      956           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      957                                             then fill( "-", 80 )
      958                                             else if v-out-string = "&DLine" then fill("=", 80)
      959                                             else fill( " ", v-log-level) + v-out-string
      960                                         ) ).
      961           v-editor-handle :insert-string( chr(10) ).
      962       end.
      963       process events.
      964       output to 'bgescn.txt' append.
      965           put unformatted
      966               chr(10)
      967               string( ( if v-log-level = 0
      968                         or v-out-string = "&DLine"
      969                         or v-out-string = "&Line"
      970                         then ""
      971                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      972                     ) )
      973               string( ( if v-out-string = "&Line"
      974                         then fill( "-", 80 )
      975                         else if v-out-string = "&DLine"
      976                              then fill( "=", 80 )
      977                              else fill( " ", v-log-level ) + v-out-string
      978                     ) )
      979           .
      980       output close.
      981   end.
      982   end procedure.
      983   procedure bgelib-show-cnt:
      984   do
      985   on error undo, return error
      986   :
      987   define input parameter v-fillin-handle     as handle   no-undo.
      988       if valid-handle( v-fillin-handle )
      989       then do:
      990           assign
      991               v-fillin-handle :visible = true
      992           .
      993       end.
      994   end.
      995   end procedure.
      996   procedure bgelib-hide-cnt:
      997   do
      998   on error undo, return error
      999   :
     1000   define input parameter v-fillin-handle     as handle   no-undo.
     1001       if valid-handle( v-fillin-handle )
     1002       then do:
     1003           assign v-fillin-handle :visible = false.
     1004       end.
     1005   end.
     1006   end procedure.
     1007   procedure bgelib-write-cnt:
     1008   do
     1009   on error undo, return error
     1010   :
     1011   define input parameter v-fillin-handle    as handle       no-undo.
     1012   define input parameter v-fillin-string    as character    no-undo.
     1013       if valid-handle( v-fillin-handle )
     1014       then do:
     1015           assign
     1016               v-fillin-handle :SCREEN-value = v-fillin-string
     1017           .
     1018       end.
     1019   end.
     1020   end procedure.
     1021   procedure bgelib-write-header:
     1022   do
     1023   on error undo, return error
     1024   :
     1025   define input parameter p-first-file     as logical      no-undo.
     1026   define input parameter p-xml-file-name  as character    no-undo.
     1027   define input parameter p-list-file-name as character    no-undo.
     1028   define input parameter p-file-number    as integer      no-undo.
     1029   define input parameter p-have-prev      as logical      no-undo.
     1030   define input parameter p-prev-filename  as character    no-undo.
     1031   define input parameter p-obj-list       as character    no-undo.
     1032   define input parameter p-doc-type-list  as character    no-undo.
     1033   define input parameter p-parameter-list as character    no-undo.
     1034       define variable v-counter    as integer        no-undo.
     1035       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1036       put stream stmXMLOut unformatted
     1037           "<?xml version='1.0' encoding='windows-1251'?>"
     1038       .
     1039       run bgelib-tag-open( input 0, input "root"  , input "" ).
     1040       run bgelib-tag-open( input 0, input "header", input "" ).
     1041       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1042       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1043       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1044       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1045       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     1046       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1047       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1048       :
     1049           run bgelib-tag-put(
     1050                 input 1
     1051               , input entry( 2 * v-counter, p-parameter-list )
     1052               , input entry( 2 * v-counter + 1, p-parameter-list )
     1053               , input 0
     1054           ).
     1055       end.
     1056       run bgelib-tag-close( input 0, input "header" ).
     1057       output stream stmXMLOut close.
     1058       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1059       if p-first-file = yes
     1060       then do:
     1061           put stream stmXMLOut unformatted
     1062               "<?xml version='1.0' encoding='windows-1251'?>"
     1063           .
     1064           run bgelib-tag-open( input 0, input "export", input "" ).
     1065       end.
     1066       run bgelib-tag-open( input 1, input "file", input "" ).
     1067       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1068       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1069       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1070       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1071       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1072       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1073       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1074       :
     1075           run bgelib-tag-put(
     1076                 input 2
     1077               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1078               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1079               , input 0
     1080           ).
     1081       end.
     1082       run bgelib-tag-close( input 1, input "file" ).
     1083       output stream stmXMLOut close.
     1084   end.
     1085   end procedure.
     1086   procedure bgelib-write-footer:
     1087   do
     1088   on error undo, return error
     1089   :
     1090   define input parameter p-last-file      as logical      no-undo.
     1091   define input parameter p-xml-file-name  as character    no-undo.
     1092   define input parameter p-list-file-name as character    no-undo.
     1093   define input parameter p-have-next      as logical      no-undo.
     1094   define input parameter p-next-file-name as character    no-undo.
     1095       define variable v-error-num     as integer           no-undo.
     1096       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1097       if p-have-next = yes
     1098       then do:
     1099           run bgelib-tag-open( input 0, input "footer", "" ).
     1100           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1101           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1102           run bgelib-tag-close( input 0, input "footer" ).
     1103       end.
     1104       run bgelib-tag-close( input 0, input "root" ).
     1105       output stream stmXMLOut close.
     1106       run bge/os_copy.p (
     1107             input "M"
     1108           , input p-xml-file-name + "tmp"
     1109           , input p-xml-file-name + "xml"
     1110           , output v-error-num
     1111       ).
     1112       if p-last-file = yes
     1113       then do:
     1114           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1115               run bgelib-tag-close( input 0, input "export" ).
     1116           output stream stmXMLOut close.
     1117           run bge/os_copy.p (
     1118                 input "M"
     1119               , input p-list-file-name + "tmp"
     1120               , input p-list-file-name + "xml"
     1121               , output v-error-num
     1122           ).
     1123       end.
     1124   end.
     1125   end procedure.
     1126   procedure bgelib-filename :
     1127   do
     1128   on error undo, return error
     1129   :
     1130   define input parameter p-prefix             as character    no-undo.
     1131   define output parameter p-xml-file-name     as character    no-undo.
     1132   define output parameter p-log-file-name     as character    no-undo.
     1133   define output parameter p-list-file-name    as character    no-undo.
     1134       define variable v-home-dir  as character    no-undo.
     1135       define variable v-error-num as integer      no-undo.
     1136       get-key-value section "BGE" key "outdir" value v-home-dir.
     1137       if v-home-dir = ?
     1138       then do:
     1139           message
     1140             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1141             skip(1)
     1142             skip "Обратитесь к администратору."
     1143           view-as alert-box error.
     1144           undo, return error .
     1145       end.
     1146       run gbl/dir-cre.p (
     1147           input v-home-dir
     1148       ) no-error.
     1149       if error-status :error
     1150       then do:
     1151           message
     1152             skip "Неверно задан каталог экспорта."
     1153             skip(1)
     1154             skip "Обратитесь к администратору."
     1155           view-as alert-box error.
     1156           undo, return error .
     1157       end.
     1158       run bge/genfname.p (
     1159             input v-home-dir
     1160           , input p-prefix
     1161           , input ""
     1162           , input "xml"
     1163           , input "tmp"
     1164           , output p-xml-file-name
     1165       ).
     1166       assign
     1167           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1168           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1169           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1170       .
     1171   end.
     1172   end procedure.
     1173   procedure bgelib-read-config :
     1174   do
     1175   on error undo, return error
     1176   :
     1177   define variable v-par-type as character     no-undo.
     1178     define variable v-param-type      as character  no-undo .
     1179     define variable v-value-character as character  no-undo .
     1180     define variable v-value-date      as date       no-undo .
     1181     define variable v-value-decimal   as decimal    no-undo .
     1182     define variable v-value-integer   as integer    no-undo .
     1183     define variable v-value-logical   as logical    no-undo .
     1184     define variable v-tth             as handle     no-undo .
     1185       assign
     1186           v-bgelib-bgeclall = no
     1187           v-bgelib-bgedict  = no
     1188       .
     1189       run adm/shattri.p ( input "get":U
     1190                         , input  '':u
     1191                         , input  0
     1192                         , input  'bge-export':U
     1193                         , input  'bgeclall':U
     1194                         , output v-value-character
     1195                         , output v-value-date
     1196                         , output v-value-decimal
     1197                         , output v-value-integer
     1198                         , output v-value-logical
     1199                         , output v-param-type
     1200                         , input-output table-handle v-tth
     1201                         ) no-error .
     1202       if error-status :error
     1203       then do:
     1204         assign
     1205           v-bgelib-bgeclall = no
     1206         .
     1207       end.
     1208       else do:
     1209         assign
     1210           v-bgelib-bgeclall = v-value-logical
     1211         .
     1212       end.
     1213       delete object v-tth.
     1214       run adm/shattri.p ( input "get":U
     1215                         , input  '':u
     1216                         , input  0
     1217                         , input  'bge-export':U
     1218                         , input  'bgedict':U
     1219                         , output v-value-character
     1220                         , output v-value-date
     1221                         , output v-value-decimal
     1222                         , output v-value-integer
     1223                         , output v-value-logical
     1224                         , output v-param-type
     1225                         , input-output table-handle v-tth
     1226                         ) no-error .
     1227       if error-status :error
     1228       then do:
     1229         assign
     1230           v-bgelib-bgedict = no
     1231         .
     1232       end.
     1233       else do:
     1234         assign
     1235           v-bgelib-bgedict = v-value-logical
     1236         .
     1237       end.
     1238       delete object v-tth.
     1239       run adm/shattri.p ( input "get":U
     1240                         , input  '':u
     1241                         , input  0
     1242                         , input  'bge-export':U
     1243                         , input  'bgefmt':U
     1244                         , output v-value-character
     1245                         , output v-value-date
     1246                         , output v-value-decimal
     1247                         , output v-value-integer
     1248                         , output v-value-logical
     1249                         , output v-param-type
     1250                         , input-output table-handle v-tth
     1251                         ) no-error .
     1252       if error-status :error
     1253       then do:
     1254         assign
     1255           v-bgelib-bgefmt  = "xml":U
     1256         .
     1257       end.
     1258       else do:
     1259         assign
     1260           v-bgelib-bgefmt  = v-value-character
     1261         .
     1262       end.
     1263       delete object v-tth.
     1264       run adm/shattri.p ( input "get":U
     1265                         , input  '':u
     1266                         , input  0
     1267                         , input  'bge-export':U
     1268                         , input  'bgeflold':U
     1269                         , output v-value-character
     1270                         , output v-value-date
     1271                         , output v-value-decimal
     1272                         , output v-value-integer
     1273                         , output v-value-logical
     1274                         , output v-param-type
     1275                         , input-output table-handle v-tth
     1276                         ) no-error .
     1277       if error-status :error
     1278       then do:
     1279         assign
     1280           v-bgelib-bgeflold  = "old":U
     1281         .
     1282       end.
     1283       else do:
     1284         assign
     1285           v-bgelib-bgeflold  = v-value-character
     1286         .
     1287       end.
     1288       delete object v-tth.
     1289   end.
     1290   end procedure.
     1291   procedure bgelib-check-file-size :
     1292   do
     1293   on error undo, return error
     1294   :
     1295   define input parameter p-out-filename   as character    no-undo.
     1296   define output parameter p-is-big        as logical      no-undo.
     1297       define variable v-current-position    as integer        no-undo.
     1298       assign
     1299           v-current-position = seek( stmXMLOut )
     1300       .
     1301       if v-current-position / 1024 / 1024  >= 100
     1302       then do:
     1303           assign
     1304               p-is-big = yes
     1305           .
     1306       end.
     1307   end.
     1308   end procedure.
     1309   procedure bgelib-init-ext-doc-type :
     1310       define variable v-counter    as integer      no-undo.
     1311       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1312   do
     1313   for buf_temp_ext-doc-type
     1314   on error undo, return error
     1315   :
     1316       empty temp-table buf_temp_ext-doc-type.
     1317       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1318       :
     1319           create buf_temp_ext-doc-type.
     1320           assign
     1321               buf_temp_ext-doc-type.edt-key               = v-counter
     1322               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1323               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1324           .
     1325       end.
     1326   end.
     1327   end procedure.
     1328   define input parameter p-mode           as character    no-undo.
     1329   define input parameter p-host-code      as integer      no-undo.
     1330   define input parameter table for temp_bgelib_clients .
     1331       define variable v-counter           as integer       no-undo.
     1332       define variable v-xml-file-name     as character     no-undo.
     1333       define variable v-log-file-name     as character     no-undo.
     1334       define variable v-list-file-name    as character     no-undo.
     1335       define variable v-xml-file-number   as integer       no-undo.
     1336       define variable v-cancel            as logical       no-undo.
     1337       define variable v-parameter-list    as character     no-undo.
     1338       define buffer buf_clients       for ub.clients.
     1339   do
     1340   for buf_clients
     1341   on error undo, return error
     1342   :
     1343       run bgelib-read-config in this-procedure no-error.
     1344       if error-status :error
     1345       then do:
     1346           message
     1347           vss-workfile vss-revision vss-description
     1348           skip "Ошибка чтения параметров экспорта."
     1349           skip "Для экспорта данных будут приняты параметры по умолчанию."
     1350           skip return-value
     1351           skip trim(error-status :get-message(1))
     1352                trim(error-status :get-message(2))
     1353                trim(error-status :get-message(3))
     1354           view-as alert-box error.
     1355       end.
     1356       run bgelib-filename in this-procedure (
     1357             input "cli"
     1358           , output v-xml-file-name
     1359           , output v-log-file-name
     1360           , output v-list-file-name
     1361       ).
     1362       run gbl/waitfrsp.w (
     1363             input substring( v-xml-file-name, 1, 1 )
     1364           , input 200
     1365           , output v-cancel
     1366       ) .
     1367       if v-cancel = yes
     1368       then do:
     1369           undo, return error .
     1370       end.
     1371       run bgelib-write-log in this-procedure (
     1372             input v-log-file-name
     1373           , input 1
     1374           , input "&DLine"
     1375       ).
     1376       run bgelib-write-log in this-procedure (
     1377             input v-log-file-name
     1378           , input 1
     1379           , input substitute( "Начало выгрузки справочника контрагентов в файл &1"
     1380                                   , replace( v-xml-file-name, "/", "\" ) + "tmp"
     1381                             )
     1382       ).
     1383       assign
     1384           v-parameter-list         =  substitute( "&1,&2,&3,&4,&5,&6,&7,&8,&9"
     1385                                                  , 5
     1386                                                  , "docName"          , "clients":U
     1387                                                  , "version"          , replace("15.0 " + replace( vss-revision + vss-date, "$", " " ),',','')
     1388                                                  , "exportDate"       , string( today,          "99/99/9999" )
     1389                                                  , "exportTime"       , string( time,           "HH:MM:SS"   )
     1390                                                 )
     1391                                     + substitute( ",&1,&2"
     1392                                                  , "needAllClients"   , v-bgelib-bgeclall
     1393                                                 )
     1394           v-xml-file-number       =   1
     1395       .
     1396       run bgelib-write-header in this-procedure (
     1397             input yes
     1398           , input v-xml-file-name
     1399           , input v-list-file-name
     1400           , input v-xml-file-number
     1401           , input no
     1402           , input ""
     1403           , input ""
     1404           , input ""
     1405           , input v-parameter-list
     1406       ).
     1407       IF lookup( "list":U, p-mode ) = 0
     1408       THEN DO:
     1409           run init-temphost.
     1410           if v-bgelib-bgeclall = no
     1411           and p-host-code <> 0
     1412           then do:
     1413               for each temp-obj
     1414               where temp-obj.host-code = p-host-code
     1415               :
     1416                   find first buf_clients
     1417                        where buf_clients.obj-type = temp-obj.obj-type
     1418                          and buf_clients.obj-code = temp-obj.obj-code
     1419                   no-error.
     1420                   if not available buf_clients
     1421                   then do:
     1422                       run bgelib-write-log in this-procedure (
     1423                             input v-log-file-name
     1424                           , input 1
     1425                           , input substitute( "*** ERR *** Не найден клиент &1 &2"
     1426                                                   , temp-obj.obj-type
     1427                                                   , string( temp-obj.obj-code )  )
     1428                       ).
     1429                       undo, next.
     1430                   end.
     1431                   run write-client in this-procedure (
     1432                         input buf_clients.obj-type
     1433                       , input buf_clients.obj-code
     1434                       , input v-parameter-list
     1435                       , input v-xml-file-name
     1436                       , input v-log-file-name
     1437                       , input v-list-file-name
     1438                       , input v-xml-file-number
     1439                       , output v-xml-file-name
     1440                       , output v-xml-file-number
     1441                   ).
     1442               end.
     1443           end.
     1444           else do:
     1445               for each temp-obj
     1446               :
     1447                   find first buf_clients
     1448                        where buf_clients.obj-type = temp-obj.obj-type
     1449                          and buf_clients.obj-code = temp-obj.obj-code
     1450                   no-error.
     1451                   if error-status :error
     1452                   then do:
     1453                       run bgelib-write-log(
     1454                             input v-log-file-name
     1455                           , input 1
     1456                           , input substitute( "*** ERR *** Не найден клиент: &1 &2"
     1457                                                   , temp-obj.obj-type
     1458                                                   , string( temp-obj.obj-code )  )
     1459                       ).
     1460                       undo, next.
     1461                   end.
     1462                   run write-client in this-procedure (
     1463                         input buf_clients.obj-type
     1464                       , input buf_clients.obj-code
     1465                       , input v-parameter-list
     1466                       , input v-xml-file-name
     1467                       , input v-log-file-name
     1468                       , input v-list-file-name
     1469                       , input v-xml-file-number
     1470                       , output v-xml-file-name
     1471                       , output v-xml-file-number
     1472                   ).
     1473               end.
     1474           end.
     1475           for each buf_clients no-lock
     1476              where buf_clients.obj-type <> 'маг':U
     1477                and buf_clients.obj-type <> 'скл':U
     1478           on error undo, return error
     1479           :
     1480               run write-client in this-procedure (
     1481                     input buf_clients.obj-type
     1482                   , input buf_clients.obj-code
     1483                   , input v-parameter-list
     1484                   , input v-xml-file-name
     1485                   , input v-log-file-name
     1486                   , input v-list-file-name
     1487                   , input v-xml-file-number
     1488                   , output v-xml-file-name
     1489                   , output v-xml-file-number
     1490               ).
     1491           end.
     1492       END.
     1493       ELSE DO:
     1494           for each temp_bgelib_clients
     1495           on error undo, return error
     1496           :
     1497               find first buf_clients no-lock
     1498                    where buf_clients.obj-type = temp_bgelib_clients.obj-type
     1499                      and buf_clients.obj-code = temp_bgelib_clients.obj-code
     1500               no-error.
     1501               if not available buf_clients
     1502               then do:
     1503                   run bgelib-write-log in this-procedure (
     1504                         input v-log-file-name
     1505                       , input 1
     1506                       , input substitute( "*** ERR *** Не найден клиент из списка: &1 &2"
     1507                                               , temp_bgelib_clients.obj-type
     1508                                               , temp_bgelib_clients.obj-code )
     1509                   ).
     1510                   undo, next.
     1511               end.
     1512               else do:
     1513                   run write-client in this-procedure (
     1514                         input buf_clients.obj-type
     1515                       , input buf_clients.obj-code
     1516                       , input v-parameter-list
     1517                       , input v-xml-file-name
     1518                       , input v-log-file-name
     1519                       , input v-list-file-name
     1520                       , input v-xml-file-number
     1521                       , output v-xml-file-name
     1522                       , output v-xml-file-number
     1523                   ).
     1524               end.
     1525           end.
     1526       END.
     1527       run bgelib-write-footer in this-procedure (
     1528             input yes
     1529           , input v-xml-file-name
     1530           , input v-list-file-name
     1531           , input no
     1532           , input ""
     1533       ).
     1534       run bgelib-write-log in this-procedure (
     1535             input v-log-file-name
     1536           , input 1
     1537           , input substitute( "Данные выгружены в файл &1"
     1538                                   , replace( v-xml-file-name, "/", "\" ) + "xml"
     1539                             )
     1540       ).
     1541       run bgelib-write-log in this-procedure (
     1542             input v-log-file-name
     1543           , input 1
     1544           , input "&DLine"
     1545       ).
     1546   end.
     1547   procedure write-client:
     1548   do
     1549   on error undo, return error
     1550   :
     1551   define input parameter p-obj-type               as character        no-undo.
     1552   define input parameter p-obj-code               as integer          no-undo.
     1553   define input parameter p-parameter-list         as character    no-undo.
     1554   define input parameter p-xml-file-name          as character    no-undo.
     1555   define input parameter p-log-file-name          as character    no-undo.
     1556   define input parameter p-list-file-name         as character    no-undo.
     1557   define input parameter p-xml-file-number        as integer      no-undo.
     1558   define output parameter p-last-xml-file-name    as character    no-undo.
     1559   define output parameter p-last-xml-file-number  as integer      no-undo.
     1560       define variable v-out-string    as character    no-undo.
     1561       define variable v-need-new-file as logical      no-undo.
     1562       define variable v-void-string   as character      no-undo.
     1563       define variable v-prev-filename as character      no-undo.
     1564       define buffer buf_clients   for ub.clients.
     1565       define buffer buf_person    for ub.person.
     1566       define buffer buf_firm      for ub.firm.
     1567       assign
     1568           p-last-xml-file-name   = p-xml-file-name
     1569           p-last-xml-file-number = p-xml-file-number
     1570       .
     1571       run bgelib-check-file-size in this-procedure (
     1572             input p-xml-file-name + "tmp"
     1573           , output v-need-new-file
     1574       ).
     1575       if v-need-new-file = yes
     1576       then do:
     1577           assign
     1578               v-prev-filename = p-xml-file-name
     1579           .
     1580           run bgelib-filename in this-procedure (
     1581                 input "cli"
     1582               , output p-xml-file-name
     1583               , output v-void-string
     1584               , output v-void-string
     1585           ).
     1586           run bgelib-write-footer in this-procedure (
     1587                 input no
     1588               , input v-prev-filename
     1589               , input p-list-file-name
     1590               , input yes
     1591               , input p-xml-file-name + "xml":U
     1592           ).
     1593           run bgelib-write-log in this-procedure (
     1594                 input p-log-file-name
     1595               , input 1
     1596               , input substitute( "Данные выгружены в файл &1"
     1597                                       , replace( p-xml-file-name, "/", "\" ) + "xml"
     1598                               )
     1599           ).
     1600           assign
     1601               p-last-xml-file-number   = p-xml-file-number + 1
     1602               p-last-xml-file-name     = p-xml-file-name
     1603           .
     1604           run bgelib-write-header in this-procedure (
     1605                 input no
     1606               , input p-last-xml-file-name
     1607               , input p-list-file-name
     1608               , input p-last-xml-file-number
     1609               , input yes
     1610               , input v-prev-filename + "xml":U
     1611               , input ""
     1612               , input ""
     1613               , input p-parameter-list
     1614           ).
     1615           assign
     1616               v-need-new-file = no
     1617           .
     1618       end.
     1619       output stream stmxmlout to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1620       find first buf_clients no-lock
     1621            where buf_clients.obj-type = p-obj-type
     1622              and buf_clients.obj-code = p-obj-code
     1623       .
     1624       run bgelib-tag-open in this-procedure ( input 0, "cli", "").
     1625       run bgelib-tag-put in this-procedure ( input 1, input "clientID"   , input buf_clients.obj-type + string(buf_clients.obj-code), input 0 ).
     1626       run bgelib-tag-put in this-procedure ( input 1, input "name"       , input buf_clients.obj-name                               , input 0 ).
     1627       run bgelib-tag-put in this-procedure ( input 1, input "orgtype"    , input buf_clients.obj-type                               , input 0 ).
     1628       if buf_clients.stts <> 0
     1629       then do:
     1630           run bgelib-tag-put in this-procedure ( input 1, input "status", input string(buf_clients.stts), input 0 ).
     1631       end.
     1632       run bgelib-tag-put in this-procedure ( input 1, input "isBuyCons" , input string( buf_clients.buy-cons), 3).
     1633       run bgelib-tag-put in this-procedure ( input 1, input "isBuyGoods", input string( buf_clients.buy-gds ), 3).
     1634       run bgelib-tag-put in this-procedure ( input 1, input "isBuyServ" , input string( buf_clients.buy-serv), 3).
     1635       run bgelib-tag-put in this-procedure ( input 1, input "isProd"    , input string( buf_clients.is-prod ), 3).
     1636       run bgelib-tag-put in this-procedure ( input 1, input "isSupCons" , input string( buf_clients.sup-cons), 3).
     1637       run bgelib-tag-put in this-procedure ( input 1, input "isSupGoods", input string( buf_clients.sup-gds ), 3).
     1638       run bgelib-tag-put in this-procedure ( input 1, input "isSupServ" , input string( buf_clients.sup-serv), 3).
     1639       run bgelib-tag-put in this-procedure ( input 1, input "comment"   , input buf_clients.PS, input 0 ).
     1640       run bgelib-tag-close in this-procedure ( input 0, input "cli" ).
     1641       if buf_clients.obj-type = 'орг':U
     1642       then do:
     1643           find first buf_firm no-lock
     1644               where buf_firm.firm-code = buf_clients.obj-code
     1645           no-error.
     1646           if available buf_firm
     1647           then do:
     1648               run bgelib-tag-open in this-procedure ( input 0, "cliFirm", "").
     1649               run bgelib-tag-put in this-procedure ( input 1, input "clientID", input buf_clients.obj-type + string(buf_clients.obj-code), input 0 ).
     1650               run bgelib-tag-put(input 1, input "ename", input buf_firm.engl-name, input 0 ).
     1651               assign
     1652                   v-out-string = ( if buf_firm.ind = 0
     1653                                   or buf_firm.ind = ?
     1654                                   then ""
     1655                                   else string( buf_firm.ind ) )
     1656                                   + ( if buf_firm.ind = 0
     1657                                       or buf_firm.ind = ?
     1658                                       or buf_firm.city=""
     1659                                       then ""
     1660                                       else ", " )
     1661                                   + buf_firm.city
     1662               .
     1663               assign
     1664                   v-out-string = v-out-string
     1665                                   + ( if v-out-string = ""
     1666                                       or buf_firm.addres1 = ""
     1667                                       or buf_firm.addres1 = ?
     1668                                       then ""
     1669                                       else ", " )
     1670                                   + buf_firm.addres1
     1671               .
     1672               assign
     1673                   v-out-string = v-out-string
     1674                                   + ( if v-out-string = ""
     1675                                       or buf_firm.addres2 = ""
     1676                                       or buf_firm.addres2 = ?
     1677                                       then ""
     1678                                       else ", " )
     1679                                   + buf_firm.addres2
     1680               .
     1681               run bgelib-tag-put in this-procedure ( input 1, input "regAddr" , input v-out-string          , input 0).
     1682               run bgelib-tag-put in this-procedure (
     1683                   input 1
     1684                   , input "postAddr"
     1685                   , input buf_firm.post-addr1
     1686                           + ( if buf_firm.post-addr1 = ""
     1687                               or buf_firm.post-addr1 = ?
     1688                               or buf_firm.post-addr2 = ""
     1689                               or buf_firm.post-addr2 = ?
     1690                               then ""
     1691                               else ", " )
     1692                           + buf_firm.post-addr2
     1693                   , input 0
     1694               ).
     1695               run bgelib-tag-put in this-procedure (
     1696                   input 1
     1697                   , input "phones"
     1698                   , input buf_firm.phone
     1699                           + ( if buf_firm.phone = ""
     1700                               or buf_firm.phone = ?
     1701                               or buf_firm.fax = ""
     1702                               or buf_firm.fax = ?
     1703                               then ""
     1704                               else ", " )
     1705                           + buf_firm.fax
     1706                           + ( if buf_firm.phone = ""
     1707                               or buf_firm.phone = ?
     1708                               or buf_firm.fax = ""
     1709                               or buf_firm.fax = ?
     1710                               then ""
     1711                               else "(f)" )
     1712                   , input 0
     1713               ).
     1714               run bgelib-tag-put in this-procedure ( input 1, input "inn"  , input buf_firm.inn  , input 0 ).
     1715               run bgelib-tag-put in this-procedure ( input 1, input "okonh", input buf_firm.okonh, input 0 ).
     1716               run bgelib-tag-put in this-procedure ( input 1, input "okpo" , input buf_firm.okpo , input 0 ).
     1717               run bgelib-tag-close in this-procedure ( input 0, "cliFirm" ).
     1718               define buffer buf_sysconf       for ub.sysconf.
     1719               define buffer buf_fin-schet     for ub.fin-schet.
     1720               define buffer buf_fin-bank      for ub.fin-bank.
     1721               for each buf_sysconf no-lock
     1722               on error undo, return error
     1723               :
     1724                   for each buf_fin-schet no-lock
     1725                      where buf_fin-schet.host-code = buf_sysconf.host-code
     1726                        and buf_fin-schet.cli-type  = buf_clients.obj-type
     1727                        and buf_fin-schet.cli-code  = buf_clients.obj-code
     1728                   on error undo, return error
     1729                   :
     1730                       if buf_fin-schet.status_  <> 'удал':U
     1731                       then do:
     1732                           run bgelib-tag-open in this-procedure ( input 0, "cliFirmBank", "").
     1733                           run bgelib-tag-put in this-procedure ( input 1, input "clientID"    , input buf_clients.obj-type + string(buf_clients.obj-code), input 0 ).
     1734                           run bgelib-tag-put in this-procedure ( input 1, input "hostFirmCode"  , input string( buf_fin-schet.host-code ) , input 0 ).
     1735                           run bgelib-tag-put in this-procedure ( input 1, input "accountNumber" , input string( buf_fin-schet.r-schet )   , input 0 ).
     1736                           run bgelib-tag-put in this-procedure ( input 1, input "bAccountNumber", input string( buf_fin-schet.c-schet )   , input 0 ).
     1737                           run bgelib-tag-put in this-procedure ( input 1, input "currCode"      , input string( buf_fin-schet.curr-code ) , input 0 ).
     1738                           find first buf_fin-bank no-lock
     1739                                where buf_fin-bank.host-code = p-host-code
     1740                                  and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     1741                           no-error.
     1742                           if available buf_fin-bank
     1743                           then do:
     1744                               run bgelib-tag-put in this-procedure ( input 1, input "bankCode"      , input string( buf_fin-schet.code-bank ) , input 0 ).
     1745                               run bgelib-tag-put in this-procedure ( input 1, input "bankName"      , input string( buf_fin-bank.bank-name )  , input 0 ).
     1746                               run bgelib-tag-put in this-procedure ( input 1, input "Address1"      , input string( entry(1, buf_fin-bank.addres, chr(4)))    , input 0 ).
     1747                               run bgelib-tag-put in this-procedure ( input 1, input "Address2"      , input string( buf_fin-bank.addres1 )    , input 0 ).
     1748                           end.
     1749                           run bgelib-tag-close in this-procedure ( input 0, "cliFirmBank" ).
     1750                       end.
     1751                   end.
     1752               end.
     1753           end.
     1754       end.
     1755       if buf_clients.obj-type = 'чел':U
     1756       then do:
     1757           find first buf_person no-lock
     1758               where buf_person.psn-code = buf_clients.obj-code
     1759           no-error.
     1760           if available buf_person
     1761           and buf_person.inn <> ""
     1762           and buf_person.inn <> ?
     1763           then do:
     1764               run bgelib-tag-open in this-procedure ( input 0, "cliPerson", "" ).
     1765               run bgelib-tag-put in this-procedure ( input 1, input "inn", input buf_person.inn, input 0 ).
     1766               run bgelib-tag-close in this-procedure ( input 0, "cliPerson" ).
     1767           end.
     1768       end.
     1769       output stream stmxmlout close.
     1770   end.
     1771   end procedure.
