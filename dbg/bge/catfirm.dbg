        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 2d6430604525, 1301, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        4   define variable vss-date        as character no-undo init "$date: 12.08.03 16:43 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: catfirm.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: bge/catfirm.p $":U .
        7   define variable vss-description as character no-undo init "Экспорт контрагентов".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define  temp-table temp-host no-undo
       70     field host-code like ub.store.host-code
       71     index xpk host-code
       72   .
       73   define  temp-table temp-obj no-undo
       74     field obj-type  like ub.clients.obj-type
       75     field obj-code  like ub.clients.obj-code
       76     field host-code like ub.store.host-code
       77     field db-num    like ub.clients.db-num
       78     index xpk  obj-type obj-code
       79     index xie1 host-code
       80     index xie2 db-num host-code
       81   .
       82   procedure init-temphost:
       83     define buffer buf_store   for ub.store .
       84     define buffer buf_shop    for ub.shop .
       85     define buffer buf_clients for ub.clients .
       86     define buffer buf_db for ub.db .
       87     define buffer buf_temp-host for temp-host .
       88     define buffer buf_temp-obj for temp-obj .
       89     do
       90     on error undo, return error return-value
       91     :
       92       for each buf_store
       93       on error undo, return error
       94       :
       95         find first buf_temp-host
       96           where buf_temp-host.host-code = buf_store.host-code
       97           no-error .
       98         if not available buf_temp-host
       99         then do:
      100           create buf_temp-host .
      101           assign
      102             buf_temp-host.host-code = buf_store.host-code
      103           .
      104         end.
      105         find first buf_clients no-lock
      106           where buf_clients.obj-type = 'скл':U
      107             and buf_clients.obj-code = buf_store.obj-code
      108           no-error .
      109         if not available buf_clients
      110         then do:
      111           message
      112             "Ошибка при поиске клиента" skip
      113             "Клиент" 'скл':U buf_store.obj-code skip
      114             view-as alert-box error .
      115           undo, return error .
      116         end.
      117         create buf_temp-obj .
      118         assign
      119           buf_temp-obj.obj-type  = 'скл':U
      120           buf_temp-obj.obj-code  = buf_store.obj-code
      121           buf_temp-obj.host-code = buf_store.host-code
      122           buf_temp-obj.db-num    = buf_clients.db-num
      123         .
      124       end.
      125       for each buf_shop
      126       on error undo, return error
      127       :
      128         find first buf_temp-host
      129           where buf_temp-host.host-code = buf_shop.host-code
      130           no-error .
      131         if not available buf_temp-host
      132         then do:
      133           create buf_temp-host .
      134           assign
      135             buf_temp-host.host-code = buf_shop.host-code
      136           .
      137         end.
      138         find first buf_clients no-lock
      139           where buf_clients.obj-type = 'маг':U
      140             and buf_clients.obj-code = buf_shop.obj-code
      141           no-error .
      142         if not available buf_clients then do:
      143           message
      144             "Ошибка при поиске клиента" skip
      145             "Клиент" 'маг':U buf_shop.obj-code skip
      146             view-as alert-box error .
      147           undo, return error .
      148         end.
      149         create buf_temp-obj .
      150         assign
      151           buf_temp-obj.obj-type  = 'маг':U
      152           buf_temp-obj.obj-code  = buf_shop.obj-code
      153           buf_temp-obj.host-code = buf_shop.host-code
      154           buf_temp-obj.db-num    = buf_clients.db-num
      155         .
      156       end.
      157     end.
      158   end.
      159   define variable vss-include-info1 as character format "X(65)" no-undo
      160   initial "@(#)$Workfile$ $Revision$".
      161   define variable v-bgelib-bgefmt        as character         no-undo.
      162   define variable v-bgelib-bgeflold      as character         no-undo.
      163   define stream stmXMLOut.
      164   define stream stmXMLLog.
      165   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      166   procedure cur-time :
      167      define output parameter p-today as date      no-undo .
      168      define output parameter p-time  as integer   no-undo .
      169     do
      170     on error undo, return error
      171     :
      172       define variable v-date1 as date      no-undo .
      173       define variable v-date2 as date      no-undo .
      174       define variable v-time  as integer   no-undo .
      175       assign
      176         v-date1 = today
      177         v-time  = time
      178         v-date2 = today
      179       .
      180       if v-date1 <> v-date2
      181       then do:
      182         assign
      183           v-date1 = today
      184           v-time  = v-time
      185         .
      186       end.
      187       assign
      188         p-today = v-date1
      189         p-time  = v-time
      190       .
      191     end.
      192   end.
      193   function cur-time-date returns character
      194   :
      195     return string(today, '99/99/9999':U) .
      196   end.
      197   function cur-time-mjd returns decimal
      198   :
      199     define variable v-date as date      no-undo .
      200     define variable v-time as integer   no-undo .
      201     run cur-time in this-procedure
      202       (output v-date
      203       ,output v-time
      204       ) .
      205     return integer(v-date) - 2400002 + (v-time / 86400) .
      206   end.
      207   function cur-time-get-ending-index returns integer
      208   (input p-number as integer
      209   )
      210   :
      211     if p-number < 0
      212     or p-number = ?
      213     then do:
      214       return 1 .
      215     end.
      216     define variable v-rest as integer   no-undo .
      217     assign
      218       p-number = p-number modulo 100
      219     .
      220     if p-number < 20
      221     then do:
      222       assign
      223         v-rest = p-number
      224       .
      225     end.
      226     else do:
      227       assign
      228         v-rest = p-number modulo 10
      229       .
      230     end.
      231     case v-rest :
      232       when 1
      233       then do:
      234         return 2 .
      235       end.
      236       when 2 or
      237       when 3 or
      238       when 4
      239       then do:
      240         return 3 .
      241       end.
      242       otherwise do:
      243         return 1 .
      244       end.
      245     end case .
      246   end.
      247   procedure cur-time-mjd-to-date :
      248      define input  parameter i-mjd-diff as decimal no-undo.
      249      define output parameter o-Date     as date    no-undo.
      250      define output parameter o-Time     as integer no-undo.
      251      define variable v-day-number as integer   no-undo .
      252      if    i-mjd-diff < 0
      253         or i-mjd-diff = ?
      254      then do:
      255         return "?" .
      256      end.
      257      assign
      258         v-day-number = truncate(i-mjd-diff,0).
      259         o-Date = date(v-day-number + 2400002).
      260         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      261     .
      262   end.
      263   function cur-time-mjd-to-string returns character
      264   (input p-mjd-diff as decimal
      265   )
      266   :
      267     define variable v-day-number as integer   no-undo .
      268     define variable v-seconds    as integer   no-undo .
      269     define variable v-hour       as integer   no-undo .
      270     define variable v-min        as integer   no-undo .
      271     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      272     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      273     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      274     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      275     if p-mjd-diff < 0
      276     or p-mjd-diff = ?
      277     then do:
      278       return "?" .
      279     end.
      280     assign
      281       v-day-number = integer(truncate(p-mjd-diff,0))
      282       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      283     .
      284     if v-seconds > 86400
      285     then do:
      286       assign
      287         v-seconds = 86400 - 1
      288       .
      289     end.
      290     if v-seconds < 0
      291     then do:
      292       assign
      293         v-seconds = 0
      294       .
      295     end.
      296     assign
      297       v-hour = truncate(v-seconds / 3600, 0)
      298     .
      299     assign
      300       v-seconds = v-seconds modulo 3600
      301     .
      302     assign
      303       v-min = truncate(v-seconds / 60, 0)
      304     .
      305     assign
      306       v-seconds = v-seconds modulo 60
      307     .
      308     return
      309         (if v-day-number <> 0
      310           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      311           else ""
      312         )
      313       + (if v-day-number <> 0 or v-hour <> 0
      314           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      315           else ""
      316         )
      317       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      318           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      319           else ""
      320         )
      321       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      322       .
      323   end.
      324   function cur-time-string returns character
      325   :
      326     define variable v-date as date      no-undo .
      327     define variable v-time as integer   no-undo .
      328     run cur-time in this-procedure
      329       (output v-date
      330       ,output v-time
      331       ) .
      332     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      333   end.
      334   function cur-time-string-sec returns character
      335   :
      336     define variable v-date as date      no-undo .
      337     define variable v-time as integer   no-undo .
      338     run cur-time in this-procedure
      339       (output v-date
      340       ,output v-time
      341       ) .
      342     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      343   end.
      344   function cur-time-custom  returns character
      345   (input p-prefix as character
      346   ,input p-date-format as character
      347   ,input p-delimiter as character
      348   ,input p-time-format as character
      349   ,input p-suffix as character
      350   )
      351   :
      352     define variable v-date as date      no-undo .
      353     define variable v-time as integer   no-undo .
      354     run cur-time in this-procedure
      355       (output v-date
      356       ,output v-time
      357       ) .
      358     return
      359       p-prefix
      360       + string(v-date, p-date-format)
      361       + p-delimiter
      362       + string(v-time, p-time-format)
      363       + p-suffix
      364       .
      365   end.
      366   function cur-time-print  returns character
      367   :
      368     define variable v-date as date      no-undo .
      369     define variable v-time as integer   no-undo .
      370     run cur-time in this-procedure
      371       (output v-date
      372       ,output v-time
      373       ) .
      374     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      375   end.
      376   function cur-time-datetime returns datetime
      377   :
      378     define variable v-char as character no-undo .
      379     define variable v-datetime as datetime no-undo .
      380     v-char = cur-time-string().
      381     v-datetime = datetime(v-char).
      382     return  v-datetime.
      383   end.
      384   function cur-time-string-msec returns character
      385   :
      386     define variable v-date as datetime  no-undo .
      387     v-date = now.
      388     return string(v-date) .
      389   end.
      390   define variable vss-include-info3 as character format "X(65)" no-undo
      391   initial "@(#)$Workfile$ $Revision$".
      392   procedure xmlchar-test :
      393   define input parameter p-in-string          as character        no-undo.
      394   define output parameter p-out-string-enc    as character        no-undo.
      395   define output parameter p-out-string-dec    as character        no-undo.
      396   do
      397   on error undo, return error
      398   :
      399          run xmlchar-encode in this-procedure
      400       (
      401             input p-in-string
      402           , output p-out-string-enc
      403       ).
      404          run xmlchar-decode in this-procedure
      405       (
      406             input p-out-string-enc
      407           , output p-out-string-dec
      408       ).
      409   end.
      410   end .
      411   procedure xmlchar-encode :
      412   define input parameter p-in-string      as character        no-undo.
      413   define output parameter p-out-string    as character        no-undo.
      414       define variable v-position      as integer      no-undo.
      415       define variable v-current-char  as character    no-undo.
      416   do
      417   on error undo, return error
      418   :
      419       assign
      420           p-out-string = "":U
      421       .
      422       case p-in-string
      423       :
      424           when ?
      425           then do:
      426               assign
      427                   p-out-string = "?":U
      428               .
      429           end.
      430           when "?":U
      431           then do:
      432               assign
      433                   p-out-string = "&#63;":U
      434               .
      435           end.
      436           otherwise do:
      437               do v-position = 1 to length( p-in-string )
      438               :
      439                   assign
      440                       v-current-char = substring( p-in-string, v-position, 1 )
      441                   .
      442                   case v-current-char
      443                   :
      444                       when "&":U
      445                       then do:
      446                           assign
      447                               p-out-string = p-out-string + "&amp;":U
      448                           .
      449                       end.
      450                       when ">":U
      451                       then do:
      452                           assign
      453                               p-out-string = p-out-string + "&gt;":U
      454                           .
      455                       end.
      456                       when "<":U
      457                       then do:
      458                           assign
      459                               p-out-string = p-out-string + "&lt;":U
      460                           .
      461                       end.
      462                       when "'":U
      463                       then do:
      464                           assign
      465                               p-out-string = p-out-string + "&apos;":U
      466                           .
      467                       end.
      468                       when '"':U
      469                       then do:
      470                           assign
      471                               p-out-string = p-out-string + "&quot;":U
      472                           .
      473                       end.
      474                       when chr(1)
      475                       then do:
      476                           assign
      477                               p-out-string = p-out-string + "":U
      478                           .
      479                       end.
      480                       when chr(2)
      481                       then do:
      482                           assign
      483                               p-out-string = p-out-string + "":U
      484                           .
      485                       end.
      486                       when chr(3)
      487                       then do:
      488                           assign
      489                               p-out-string = p-out-string + "":U
      490                           .
      491                       end.
      492                       when chr(4)
      493                       then do:
      494                           assign
      495                               p-out-string = p-out-string + "":U
      496                           .
      497                       end.
      498                       when chr(5)
      499                       then do:
      500                           assign
      501                               p-out-string = p-out-string + "":U
      502                           .
      503                       end.
      504                       when chr(6)
      505                       then do:
      506                           assign
      507                               p-out-string = p-out-string + "":U
      508                           .
      509                       end.
      510                       when chr(7)
      511                       then do:
      512                           assign
      513                               p-out-string = p-out-string + "":U
      514                           .
      515                       end.
      516                       when chr(8)
      517                       then do:
      518                           assign
      519                               p-out-string = p-out-string + "":U
      520                           .
      521                       end.
      522                       when chr(9)
      523                       then do:
      524                           assign
      525                               p-out-string = p-out-string + "":U
      526                           .
      527                       end.
      528                       when chr(29)
      529                       then do:
      530                           assign
      531                               p-out-string = p-out-string + "":U
      532                           .
      533                       end.
      534                       when chr(10)
      535                       then do:
      536                           assign
      537                               p-out-string = p-out-string + "&#10;":U
      538                           .
      539                       end.
      540                       when chr(13)
      541                       then do:
      542                           assign
      543                               p-out-string = p-out-string + "&#13;":U
      544                           .
      545                       end.
      546                       otherwise do:
      547                           assign
      548                               p-out-string = p-out-string + v-current-char
      549                           .
      550                       end.
      551                   end case.
      552               end.
      553           end.
      554       end case.
      555   end.
      556   end .
      557   procedure xmlchar-encode-1c :
