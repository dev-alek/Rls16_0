     2616       ,output v-cntxt-obj-code
     2617       ,output v-cntxt-db-num-obj
     2618       ,output v-cntxt-is-admin
     2619       ) .
     2620   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2621   do:
     2622     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2623       (input  v-cntxt-db-num
     2624       ,input  v-cntxt-userid
     2625       ,input  0
     2626       ,input  'actn_documents_export':U
     2627       ,input  'firm':U
     2628       ,input  v-cntxt-host-code-obj
     2629       ,input  '':U
     2630       ,input  0
     2631       ,input  0
     2632       ,input  0
     2633       ,input  0
     2634       ,input  yes
     2635       ,output v-yesno
     2636       )  .
     2637   end.
     2638       if v-yesno = no
     2639       then do:
     2640           return error.
     2641       end.
     2642       RUN init-temphost.
     2643       assign
     2644           v-log-string = ", по всем фирмам"
     2645       .
     2646       case p-range:
     2647       when 2
     2648       then do:
     2649           for each temp-obj
     2650           where temp-obj.host-code <> v-cntxt-host-code-obj
     2651           :
     2652               delete temp-obj.
     2653           end.
     2654           assign
     2655               v-log-string = ", по фирме (код фирмы " + string( v-cntxt-host-code-obj ) + ")"
     2656           .
     2657       end.
     2658       when 3
     2659       then do:
     2660           for each temp-obj
     2661           :
     2662               delete temp-obj.
     2663           end.
     2664           do v-obj-counter = 1 to num-entries ( p-obj-list ) / 2
     2665           :
     2666               create temp-obj.
     2667               assign
     2668                   temp-obj.obj-type = entry( v-obj-counter * 2 - 1, p-obj-list )
     2669                   temp-obj.obj-code = integer( entry( v-obj-counter * 2, p-obj-list ) )
     2670               no-error .
     2671               if error-status :error
     2672               then do:
     2673                   message
     2674                            vss-workfile vss-revision vss-description
     2675                       skip(1)
     2676                       skip "Ошибка чтения списка объектов"
     2677                       skip return-value
     2678                       skip trim( error-status :get-message( 1 ) )
     2679                            trim( error-status :get-message( 2 ) )
     2680                            trim( error-status :get-message( 3 ) )
     2681                   view-as alert-box error.
     2682                   undo, return error substitute( "Ошибка чтения списка объектов. &1. &2"
     2683                                               , return-value
     2684                                               , trim( error-status :get-message( 1 ) ) ).
     2685               end.
     2686   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2687   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2688     (input  temp-obj.obj-type
     2689     ,input  temp-obj.obj-code
     2690     ,output temp-obj.host-code
     2691     ) no-error .
     2692               if error-status :error
