     2596       define variable v-log-string        as character            no-undo.
     2597       define variable v-fact-order-from   like ub.stk-tot.fact-order no-undo.
     2598       define variable v-fact-order-to     like ub.stk-tot.fact-order no-undo.
     2599       define variable v-docs-exists       as logical              no-undo.
     2600       define variable v-obj-counter       as integer              no-undo.
     2601       define variable v-db-num            as integer              no-undo.
     2602       define variable v-yesno             as logical              no-undo.
     2603       define variable v-obj-num           as character            no-undo.
     2604       define variable v-obj-list          as character            no-undo.
     2605   do
     2606   on error undo, return error return-value
     2607   :
     2608       run bge-xml-init-ext-doc-type in this-procedure .
     2609   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2610     run mainmenu_getcntxt in p-mainmenu-handle
     2611       (output v-cntxt-db-num
     2612       ,output v-cntxt-userid
     2613       ,output v-cntxt-level
     2614       ,output v-cntxt-host-code-obj
