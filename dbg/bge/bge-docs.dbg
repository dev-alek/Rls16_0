     2706                                   , return-value
     2707                                   , trim( error-status :get-message( 1 ) ) ).
     2708               end.
     2709           end.
     2710           assign
     2711               v-log-string = ", по объектам: " + p-obj-list
     2712           .
     2713       end.
     2714       end case.
     2715       run bge-xml-read-config in this-procedure ( input p-date-to
     2716                                                 , input ?
     2717                                                 ) no-error.
     2718       if error-status :error
     2719       then do:
     2720           message
     2721           vss-workfile vss-revision vss-description
     2722           skip "Ошибка чтения параметров экспорта."
     2723           skip "Для экспорта данных будут приняты параметры по умолчанию."
     2724           skip return-value
     2725           skip trim(error-status :get-message(1))
     2726               trim(error-status :get-message(2))
     2727               trim(error-status :get-message(3))
     2728           view-as alert-box error.
     2729       end.
     2730         run xml-bge-filename in this-procedure (
     2731               input "doc"
     2732             , input "document"
     2733             , input "no"
     2734             , output v-xml-file-name
     2735             , output v-log-file-name
     2736             , output v-locked
     2737         ).
     2738         run wp-XMLWriteLog in this-procedure (
     2739               input v-log-file-name
     2740             , input 1
     2741             , input "&DLine"
     2742         ).
     2743         run wp-XMLWriteLog in this-procedure (
     2744               input v-log-file-name
     2745             , input 1
     2746             , input substitute( "Начало выгрузки в файл &1"
     2747                                     , replace( v-xml-file-name, "/", "\" ) + "xm1"
     2748                               )
     2749         ).
     2750         run wp-XMLWriteLog in this-procedure (
     2751               input v-log-file-name
     2752             , input 1
     2753             , input substitute( "................с параметрами: Дата с: &1, дата по: &2"
     2754                                     , p-date-from
     2755                                     , p-date-to
     2756                               )
     2757         ).
     2758         run wp-XMLWriteLog in this-procedure (
     2759               input v-log-file-name
     2760             , input 1
     2761             , input substitute( "................с параметрами: ... список объектов: &1", p-obj-list )
     2762         ).
     2763         run wp-XMLWriteLog in this-procedure (
     2764               input v-log-file-name
     2765             , input 1
     2766             , input substitute( "................с параметрами: ... типы документов: &1", p-doc-type-list )
     2767         ).
     2768         run wp-XMLWriteLog in this-procedure (
     2769               input v-log-file-name
     2770             , input 1
     2771             , input substitute( "................с параметрами: ... надо ли виды платежей: &1, ГТД: &2, партии: &3, типы кассовых платежей: &4, кассы: &5, преф.карт: &6, удал.документы: &7, незакр.документы: &8"
     2772                                                           , p-pay-code
     2773                                                           , p-cst
     2774                                                           , p-parts
     2775                                                           , p-chk-pay-code
     2776                                                           , p-pay-desk
     2777                                                           , p-pay-desk-cards
     2778                                                           , p-deleted
     2779                                                           , p-opened-docs )
     2780         ).
     2781         if v-locked = yes
     2782         then do:
     2783             run wp-XMLWriteLog in this-procedure (
     2784                   input v-log-file-name
     2785                 , input 1
     2786                 , input "*** Ошибка выгрузки: Файл выгрузки заблокирован другим процессом."
     2787             ).
     2788             message
     2789                     vss-workfile vss-revision vss-description
     2790                 skip(1)
     2791                 skip "*** Ошибка выгрузки: Файл выгрузки заблокирован другим процессом."
     2792                 skip return-value
     2793                 skip trim( error-status :get-message( 1 ) )
     2794                     trim( error-status :get-message( 2 ) )
     2795                     trim( error-status :get-message( 3 ) )
     2796             view-as alert-box error.
     2797             undo, return error substitute( "*** Ошибка выгрузки: Файл выгрузки заблокирован другим процессом." ).
     2798         end.
     2799   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2800   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2801     (output v-db-num
     2802     ) no-error .
     2803         if error-status :error
     2804         then do:
     2805             run wp-XMLWriteLog in this-procedure (
     2806                   input v-log-file-name
     2807                 , input 1
     2808                 , input "*** Не удалось определить номер БД. Номер текущей базы данных будет выгружен как 0."
     2809             ).
     2810             assign
     2811                 v-db-num = 0
     2812             .
     2813         end.
     2814         run bge-xml-write-header in this-procedure (
     2815               input v-xml-file-name
     2816             , input v-xml-file-name + "xml"
     2817             , input "15.0 " + replace( vss-revision + vss-date, "$", " " )
     2818             , input v-db-num
     2819             , input p-date-from
     2820             , input 0
     2821             , input p-date-to
     2822             , input 0
     2823             , input p-obj-list
     2824             , input p-doc-type-list
     2825             , input p-pay-code
     2826             , input p-cst
     2827             , input p-parts
     2828             , input p-chk-pay-code
     2829             , input p-pay-desk
     2830             , input p-pay-desk-cards
     2831             , input p-deleted
     2832             , input p-opened-docs
     2833         ).
     2834         object-of-list:
     2835         for each temp-obj
     2836         :
     2837             run export-docs-by-object (
     2838                   input temp-obj.host-code
     2839                 , input temp-obj.obj-type
     2840                 , input temp-obj.obj-code
     2841             ) no-error.
     2842             if error-status :error
     2843             then do:
     2844                 run wp-XMLWriteLog in this-procedure (
     2845                       input v-log-file-name
     2846                     , input 1
     2847                     , input substitute( "Ошибка экспорта документов по объекту &1 &2"
     2848                                         , temp-obj.obj-type
     2849                                         , temp-obj.obj-code
     2850                                         )
     2851                 ).
     2852                 message
     2853                 vss-workfile vss-revision vss-description
     2854                 skip "Ошибка экспорта документов по объекту"
     2855                 skip "Тип объекта:" temp-obj.obj-type
     2856                 skip "Код объекта:" temp-obj.obj-code
     2857                 skip return-value
     2858                 skip trim(error-status :get-message(1))
     2859                     trim(error-status :get-message(2))
     2860                     trim(error-status :get-message(3))
     2861                     trim(error-status :get-message(4))
     2862                     trim(error-status :get-message(5))
     2863                 view-as alert-box error.
     2864                 next object-of-list.
     2865             end.
     2866             run cb-fill_bge-xml_clients in this-procedure (
     2867                   input temp-obj.obj-type
     2868                 , input temp-obj.obj-code
     2869             ).
     2870         end.
     2871         if v-bge-xml-bgeflold <> "oracle"
     2872         then do:
     2873           run xml-bge-write-footer in this-procedure ( input v-xml-file-name ).
     2874         end.
     2875         run wp-XMLWriteLog in this-procedure (
     2876               input v-log-file-name
     2877             , input 1
     2878             , input substitute( "Данные выгружены в файл &1"
     2879                                     , replace( v-xml-file-name, "/", "\" ) + "xml"
     2880                               )
     2881         ).
     2882       run bge/cat-firm.p (
     2883             input "list":U
     2884           , input v-cntxt-host-code-obj
     2885           , input table temp_bge-xml_clients
     2886           , ""
     2887       ).
     2888       run bge/cat-good.p (
     2889             input "good-ext,list"
     2890           , input table temp_bge-xml_goods
     2891           , ""
     2892       ).
     2893       run wp-XMLWriteLog in this-procedure (
     2894             input v-log-file-name
     2895           , input 1
     2896           , input "&DLine"
     2897       ).
     2898   end.
     2899   procedure export-docs-by-object :
     2900   define input parameter p-host-code  as integer      no-undo.
     2901   define input parameter p-obj-type   as character    no-undo.
     2902   define input parameter p-obj-code   as integer      no-undo.
     2903       define variable v-archive-ok        as logical      no-undo.
     2904       define variable v-comment           as character    no-undo.
     2905       define variable v-err-message       as character    no-undo.
     2906   do
     2907   on error undo, return error return-value
     2908   :
     2909       run wp-XMLWriteEDT( hEDT, 1, string( p-obj-type ) + " " + string( p-obj-code ) ).
     2910       run wp-XMLWriteEDT( hEDT, 4,  "Расчет архивов").
     2911       run bge/bge-ahz.p (
     2912             input p-mainmenu-handle
     2913           , input p-obj-type
     2914           , input p-obj-code
     2915           , input yes
     2916           , input yes
     2917           , input no
     2918           , input p-date-from
     2919           , input p-date-to
     2920           , output v-archive-ok
     2921           , output v-comment
     2922       ) no-error.
     2923       if error-status :error
     2924       then do:
     2925           run wp-XMLWriteLog in this-procedure (
     2926                 input v-log-file-name
     2927               , input 1
     2928               , input substitute( "Ошибка проверки архивов на объекте &1 &2. &3. &4"
     2929                                       , p-obj-type
     2930                                       , p-obj-code
     2931                                       , return-value
     2932                                       , trim( error-status :get-message( 1 ) ) )
     2933           ).
     2934           message
     2935                    vss-workfile vss-revision vss-description
     2936               skip(1)
     2937               skip "Ошибка проверки архивов на объекте"
     2938               skip "Тип объекта:" p-obj-type
     2939               skip "Код объекта:" p-obj-code
     2940               skip return-value
     2941               skip trim( error-status :get-message( 1 ) )
     2942                    trim( error-status :get-message( 2 ) )
     2943                    trim( error-status :get-message( 3 ) )
     2944           view-as alert-box error.
     2945           undo, return error substitute( "Ошибка проверки архивов на объекте &1 &2. &3. &4"
     2946                                       , p-obj-type
     2947                                       , p-obj-code
     2948                                       , return-value
     2949                                       , trim( error-status :get-message( 1 ) ) ).
     2950       end.
     2951       if v-archive-ok = no
     2952       then do:
     2953           assign
     2954               v-err-message =  substitute( "*** Документы по объекту &1 &2 в интервале дат &3 - &4 не будут выгружены. Архивы по объекту в заданном интервале дат не целостные. &5."
     2955                                       , p-obj-type
     2956                                       , p-obj-code
     2957                                       , p-date-from
     2958                                       , p-date-to
     2959                                       , v-comment       )
     2960           .
     2961           run wp-XMLWriteLog in this-procedure (
     2962                 input v-log-file-name
     2963               , input 1
     2964               , input v-err-message
     2965           ).
     2966           message
     2967           vss-workfile vss-revision vss-description
     2968           skip v-err-message
     2969           skip return-value
     2970           skip trim(error-status :get-message(1))
     2971               trim(error-status :get-message(2))
     2972               trim(error-status :get-message(3))
     2973           view-as alert-box error.
     2974           undo, return error v-err-message.
     2975       end.
     2976       process events.
     2977       run rep/get-fo.p (
     2978             input  p-obj-type
     2979           , input  p-obj-code
     2980           , input  p-date-from
     2981           , input  p-date-to
     2982           , output v-fact-order-from
     2983           , output v-fact-order-to
     2984           , output v-docs-exists
     2985       ) no-error .
     2986       if error-status :error
     2987       then do:
     2988           message
     2989                    vss-workfile vss-revision vss-description
     2990               skip(1)
     2991               skip "Ошибка определения границ fact-order для поиска по архивам"
     2992               skip return-value
     2993               skip trim( error-status :get-message( 1 ) )
     2994                    trim( error-status :get-message( 2 ) )
     2995                    trim( error-status :get-message( 3 ) )
     2996           view-as alert-box error.
     2997           undo, return error substitute( "Ошибка определения границ fact-order для поиска по архивам. &1. &2"
     2998                                       , return-value
     2999                                       , trim( error-status :get-message( 1 ) ) ).
     3000       end.
     3001       if v-docs-exists = no
     3002       then do:
     3003           run wp-XMLWriteEDT( hEDT, 4, "В заданном диапазоне дат нет закрытых документов").
     3004       end.
     3005       else do:
     3006           run wp-XMLShowCNT(hCNT).
     3007           for each temp_ext-doc-type
     3008           :
     3009               if lookup( temp_ext-doc-type.ext-doc-type, p-doc-type-list ) <> 0
     3010               or p-doc-type-list = "":U
     3011               then do:
     3012                   run bge/doc-oper.p (
     3013                         input p-host-code
     3014                       , input p-obj-type
     3015                       , input p-obj-code
     3016                       , input temp_ext-doc-type.ext-doc-type
     3017                       , input temp_ext-doc-type.ext-doc-type-label
     3018                       , input v-fact-order-from
     3019                       , input v-fact-order-to
     3020                       , input p-date-from
     3021                       , input p-date-to
     3022                       , input p-pay-code
     3023                       , input p-cst
     3024                       , input p-parts
     3025                       , input p-chk-pay-code
     3026                       , input p-pay-desk
     3027                       , input p-pay-desk-cards
     3028                       , input p-chk
     3029                       , input p-doc-rvs
     3030                       , input v-xml-file-name
     3031                       , input v-log-file-name
     3032                       , input this-procedure
     3033                       , input hEDT
     3034                       , input hCNT
     3035                   ) no-error.
     3036                   if error-status :error
     3037                   then do:
     3038                       run wp-XMLWriteEDT( hEDT, 1, substitute( "&1. &2. &3."
     3039                                               , return-value
     3040                                               , trim(error-status :get-message(1))
     3041                                               , trim(error-status :get-message(2))
     3042                                               )  ).
     3043                   end.
     3044               end.
     3045           end.
     3046           run wp-XMLHideCNT(hCNT).
     3047       end.
     3048       if v-bge-xml-bgeflold = "oracle":u
     3049       then do:
     3050         run wp-XMLShowCNT in this-procedure (hCNT).
     3051         run bge/doc-ord.p ( input no
     3052                           , input p-host-code
     3053                           , input p-obj-type
     3054                           , input p-obj-code
     3055                           , input p-date-from
     3056                           , input p-date-to
     3057                           , input 'ОП':U
     3058                           , input 'поставка':U
     3059                           , input v-xml-file-name
     3060                           , input v-log-file-name
     3061                           , input this-procedure
     3062                           , input hEDT
     3063                           , input hCNT
     3064                           , input ?
     3065                           ) no-error .
     3066         if error-status :error
     3067         then do:
     3068             run wp-XMLWriteEDT( hEDT, 1, substitute( "&1. &2. &3."
     3069                                     , return-value
     3070                                     , trim(error-status :get-message(1))
     3071                                     , trim(error-status :get-message(2))
     3072                                     )  ).
     3073         end.
     3074         run wp-XMLHideCNT in this-procedure (hCNT).
     3075       end.
     3076       if p-deleted = yes
     3077       then do:
     3078           run wp-XMLShowCNT(hCNT).
     3079           run bge/doc-deld.p (
     3080                 input p-host-code
     3081               , input p-obj-type
     3082               , input p-obj-code
     3083               , input p-date-from
     3084               , input p-date-to
     3085               , input v-xml-file-name
     3086               , input v-log-file-name
     3087               , input hEDT
     3088               , input hCNT
     3089           ) no-error.
     3090           if error-status :error
     3091           then do:
     3092               run wp-XMLWriteEDT( hEDT, 1, substitute( "&1. &2. &3."
     3093                                       , return-value
     3094                                       , trim(error-status :get-message(1))
     3095                                       , trim(error-status :get-message(2))
     3096                                       )  ).
     3097           end.
     3098           run wp-XMLHideCNT(hCNT).
     3099       end.
     3100       process events.
     3101       if p-opened-docs = yes
     3102       then do:
     3103           run wp-XMLShowCNT(hCNT).
     3104           run bge/doc-opnd.p (
     3105                 input p-host-code
     3106               , input p-obj-type
     3107               , input p-obj-code
     3108               , input p-cst
     3109               , input p-parts
     3110               , input v-xml-file-name
     3111               , input v-log-file-name
     3112               , input this-procedure
     3113               , input hEDT
     3114               , input hCNT
     3115           ) no-error.
     3116           if error-status :error
     3117           then do:
     3118               run wp-XMLWriteEDT( hEDT, 1, substitute( "&1. &2. &3."
     3119                                       , return-value
     3120                                       , trim(error-status :get-message(1))
     3121                                       , trim(error-status :get-message(2))
     3122                                       )  ).
     3123           end.
     3124           run wp-XMLHideCNT(hCNT).
     3125       end.
     3126       process events.
     3127   end.
     3128   end procedure.
     3129   procedure cb-fill_bge-xml_goods :
     3130   define input parameter p-gds-code   as integer          no-undo.
     3131   do
     3132   on error undo, return error
     3133   :
     3134       find first temp_bge-xml_goods
     3135            where temp_bge-xml_goods.gds-code = p-gds-code
     3136       no-error.
     3137       if not available temp_bge-xml_goods
     3138       then do:
     3139           create temp_bge-xml_goods.
     3140           assign
     3141               temp_bge-xml_goods.gds-code = p-gds-code
     3142           .
     3143       end.
     3144   end.
     3145   end procedure.
     3146   procedure cb-fill_bge-xml_clients :
     3147   define input parameter p-obj-type   as character        no-undo.
     3148   define input parameter p-obj-code   as integer          no-undo.
     3149       define buffer buf_temp_bge-xml_clients      for temp_bge-xml_clients.
     3150   do
     3151   for buf_temp_bge-xml_clients
     3152   on error undo, return error
     3153   :
     3154       find first buf_temp_bge-xml_clients
     3155            where buf_temp_bge-xml_clients.obj-type = p-obj-type
     3156              and buf_temp_bge-xml_clients.obj-code = p-obj-code
     3157       no-error.
     3158       if not available buf_temp_bge-xml_clients
     3159       then do:
     3160           create buf_temp_bge-xml_clients.
     3161           assign
     3162               buf_temp_bge-xml_clients.obj-type = p-obj-type
     3163               buf_temp_bge-xml_clients.obj-code = p-obj-code
     3164           .
     3165       end.
     3166   end.
     3167   end procedure.
