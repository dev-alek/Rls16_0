     2589     define variable v-cntxt-obj-type      as character no-undo .
     2590     define variable v-cntxt-obj-code      as integer   no-undo .
     2591     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2592     define variable v-cntxt-is-admin      as logical   no-undo .
     2593       define variable v-xml-file-name     as character            no-undo.
     2594       define variable v-log-file-name     as character            no-undo.
