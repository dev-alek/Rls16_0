      639                       when chr(7)
      640                       then do:
      641                           assign
      642                               p-out-string = p-out-string + " ":U
      643                           .
      644                       end.
      645                       when chr(8)
      646                       then do:
      647                           assign
      648                               p-out-string = p-out-string + " ":U
      649                           .
      650                       end.
      651                       when chr(9)
      652                       then do:
      653                           assign
      654                               p-out-string = p-out-string + " ":U
      655                           .
      656                       end.
      657                       when chr(29)
      658                       then do:
      659                           assign
      660                               p-out-string = p-out-string + " ":U
      661                           .
      662                       end.
      663                       when chr(10)
      664                       then do:
      665                           assign
      666                               p-out-string = p-out-string + " ":U
      667                           .
      668                       end.
      669                       when chr(13)
      670                       then do:
      671                           assign
      672                               p-out-string = p-out-string + " ":U
      673                           .
      674                       end.
      675                       otherwise do:
      676                           assign
      677                               p-out-string = p-out-string + v-current-char
      678                           .
      679                       end.
      680                   end case.
      681               end.
      682           end.
      683       end case.
      684   end.
      685   end .
      686   procedure xmlchar-decode :
      687   define input parameter p-in-string      as character        no-undo.
      688   define output parameter p-out-string    as character        no-undo.
      689       define variable v-position      as integer      no-undo.
      690       define variable v-last-position as integer      no-undo.
      691       define variable v-temp-integer  as integer      no-undo.
      692       define variable v-current-char  as character    no-undo.
      693       define variable v-next-char     as character    no-undo.
      694       define variable v-success       as logical      no-undo.
      695   do
      696   on error undo, return error
      697   :
      698       assign
      699           p-out-string = "":U
      700           v-position   = 0
      701       .
      702       replace-cycle:
      703       do while yes
      704       on error undo, return error
      705       :
      706           assign
      707               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      708           .
      709           if v-last-position <= v-position
      710           then do:
      711               if v-position = 0
      712               then do:
      713                   assign
      714                       p-out-string = p-in-string
      715                   .
      716               end.
      717               else do:
      718                   assign
      719                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      720                   .
      721               end.
      722               leave replace-cycle.
      723           end.
      724           else do:
      725               assign
      726                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      727                   v-position      = v-last-position
      728                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      729               .
      730               if v-current-char = "#":U
      731               then do:
      732                   assign
      733                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      734                   .
      735                   if v-last-position > 0
      736                   then do:
      737                       run xmlchar-read-integer in this-procedure
      738                        (
      739                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      740                           , output v-temp-integer
      741                           , output v-success
      742                       ).
      743                       if v-success = yes
      744                       and v-temp-integer >= 1
      745                       and v-temp-integer <= 255
      746                       then do:
      747                           assign
      748                               p-out-string = p-out-string + chr( v-temp-integer )
      749                               v-position   = v-last-position + 1
      750                           .
      751                       end.
      752                       else do:
      753                           assign
      754                               p-out-string = p-out-string + "&":U
      755                               v-position   = v-position   + 1
      756                           .
      757                       end.
      758                   end.
      759                   else do:
      760                       assign
      761                           p-out-string = p-out-string + "&":U
      762                           v-position   = v-position   + 1
      763                       .
      764                   end.
      765               end.
      766               else do:
      767                   case substring( p-in-string, v-position + 1, 3 )
      768                   :
      769                       when "lt;":U
      770                       then do:
      771                           assign
      772                               p-out-string = p-out-string + "<":U
      773                               v-position   = v-position   + 3
      774                           .
      775                       end.
      776                       when "gt;":U
      777                       then do:
      778                           assign
      779                               p-out-string = p-out-string + ">":U
      780                               v-position   = v-position   + 3
      781                           .
      782                       end.
      783                       otherwise do:
      784                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      785                           then do:
      786                               assign
      787                                   p-out-string = p-out-string + "&":U
      788                                   v-position   = v-position   + 4
      789                               .
      790                           end.
      791                           else do:
      792                               case substring( p-in-string, v-position + 1, 5 )
      793                               :
      794                                   when "quot;":U
      795                                   then do:
      796                                       assign
      797                                           p-out-string = p-out-string + '"':U
      798                                           v-position   = v-position   + 5
      799                                       .
      800                                   end.
      801                                   when "apos;":U
      802                                   then do:
      803                                       assign
      804                                           p-out-string = p-out-string + "'":U
      805                                           v-position   = v-position   + 5
      806                                       .
      807                                   end.
      808                                   otherwise do:
      809                                       assign
      810                                           p-out-string = p-out-string + "&":U
      811                                       .
      812                                   end.
      813                               end case.
      814                           end.
      815                       end.
      816                   end case.
      817               end.
      818           end.
      819       end.
      820   end.
      821   end .
      822   procedure xmlchar-read-integer :
      823   define input parameter p-input-string      as character        no-undo.
      824   define output parameter p-output-integer   as integer          no-undo.
      825   define output parameter p-success       as logical          no-undo.
      826   do
      827   on error undo, return error
      828   :
      829       assign
      830           p-output-integer = integer( p-input-string )
      831       no-error.
      832       if error-status :error
      833       then do:
      834           assign
      835               p-success           = no
      836               p-output-integer    = 0
      837           .
      838       end.
      839       else do:
      840           assign
      841               p-success           = yes
      842           .
      843       end.
      844   end.
      845   end.
      846   define variable v-bgelib-bgeclall           as logical      no-undo.
      847   define variable v-bgelib-bgedict            as logical      no-undo.
      848   define temp-table temp_ext-doc-type no-undo
      849       field edt-key               as integer
      850       field ext-doc-type          as character
      851       field ext-doc-type-label    as character
      852       index pi is primary unique
      853           edt-key
      854   .
      855   define temp-table temp_bgelib_goods no-undo
      856       field gds-code as integer
      857       index pi is primary unique
      858           gds-code
      859   .
      860   define temp-table temp_bgelib_clients no-undo
      861       field obj-type as character
      862       field obj-code as integer
      863       index pi is primary unique
      864           obj-type
      865           obj-code
      866   .
      867   define temp-table temp_bgelib_dis-card no-undo
      868       field d-card as character
      869       index pi is primary unique
      870           d-card
      871   .
      872   define temp-table temp_bgelib_trn-doc no-undo
      873       field doc-code as integer
      874   .
      875   procedure bgelib-tag-open:
      876   do
      877   on error undo, return error
      878   :
      879   define input parameter v-tag-level  as integer      no-undo.
      880   define input parameter v-tag-name   as character    no-undo.
      881   define input parameter v-tag-value  as character    no-undo.
      882       put stream stmXMLOut unformatted
      883           chr(10)
      884           + fill(" ", 4 * v-tag-level)
      885           + "<" + v-tag-name
      886           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      887           + v-tag-value + ">"
      888       .
      889   end.
      890   end procedure.
      891   procedure bgelib-tag-put:
      892   do
      893   on error undo, return error
      894   :
      895   define input parameter v-tag-level      as integer      no-undo.
      896   define input parameter v-tag-name       as character    no-undo.
      897   define input parameter v-tag-value      as character    no-undo.
      898   define input parameter v-empty-mode     as integer      no-undo.
      899       v-tag-name = trim(v-tag-name).
      900       if  v-empty-mode = 1
      901       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      902       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      903       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      904       then do:
      905           run xmlchar-encode in this-procedure (
      906                 input v-tag-value
      907               , output v-tag-value
      908           ).
      909           put stream stmXMLOut unformatted
      910               chr(10) + fill(" ", 4 * v-tag-level)
      911                           + '<' + v-tag-name + '>'
      912                           + v-tag-value
      913                           + '</' + v-tag-name + '>'
      914           .
      915       end.
      916   end.
      917   end procedure.
      918   procedure bgelib-tag-close:
      919   do
      920   on error undo, return error
      921   :
      922   define input parameter v-tag-level as integer      no-undo.
      923   define input parameter v-tag-name  as character    no-undo.
      924       put stream stmXMLOut unformatted
      925           chr(10)
      926           + fill( " ", 4 * v-tag-level)
      927           + '</' + v-tag-name + '>'
      928       .
      929   end.
      930   end procedure.
      931   procedure bgelib-write-log:
      932   do
      933   on error undo, return error
      934   :
      935   define input parameter v-filename   as character    no-undo.
      936   define input parameter v-log-level  as integer      no-undo.
      937   define input parameter v-out-string as character    no-undo.
      938       output stream stmXMLLog to value( v-filename ) append.
      939       put stream stmXMLLog unformatted
      940           chr(10)
      941       .
      942       put stream stmXMLLog unformatted
      943           ( if v-log-level = 0
      944             or v-out-string = "&DLine"
      945             or v-out-string = "&Line"
      946             then ""
      947             else cur-time-string-sec() + " " )
      948       .
      949       put stream stmXMLLog unformatted
      950           ( if v-out-string = "&Line"
      951             then fill( "-", 80 )
      952             else if v-out-string = "&DLine"
      953                  then fill( "=", 80 )
      954                  else v-out-string )
      955       .
      956       output stream stmXMLLog close.
      957   end.
      958   end procedure.
      959   procedure bgelib-write-edt:
      960   do
      961   on error undo, return error
      962   :
      963   define input parameter v-editor-handle    as handle       no-undo.
      964   define input parameter v-log-level        as integer      no-undo.
      965   define input parameter v-out-string       as character    no-undo.
      966       if valid-handle ( v-editor-handle )
      967       then do:
      968           v-editor-handle :move-to-eof().
      969           v-editor-handle :insert-string( ( if v-log-level = 0
      970                                             or v-out-string = "&DLine"
      971                                             or v-out-string = "&Line"
      972                                             then ""
      973                                             else cur-time-string-sec() + " "
      974                                         ) ).
      975           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      976                                             then fill( "-", 80 )
      977                                             else if v-out-string = "&DLine" then fill("=", 80)
      978                                             else fill( " ", v-log-level) + v-out-string
      979                                         ) ).
      980           v-editor-handle :insert-string( chr(10) ).
      981       end.
      982       process events.
      983       output to 'bgescn.txt' append.
      984           put unformatted
      985               chr(10)
      986               string( ( if v-log-level = 0
      987                         or v-out-string = "&DLine"
      988                         or v-out-string = "&Line"
      989                         then ""
      990                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      991                     ) )
      992               string( ( if v-out-string = "&Line"
      993                         then fill( "-", 80 )
      994                         else if v-out-string = "&DLine"
      995                              then fill( "=", 80 )
      996                              else fill( " ", v-log-level ) + v-out-string
      997                     ) )
      998           .
      999       output close.
     1000   end.
     1001   end procedure.
     1002   procedure bgelib-show-cnt:
     1003   do
     1004   on error undo, return error
     1005   :
     1006   define input parameter v-fillin-handle     as handle   no-undo.
     1007       if valid-handle( v-fillin-handle )
     1008       then do:
     1009           assign
     1010               v-fillin-handle :visible = true
     1011           .
     1012       end.
     1013   end.
     1014   end procedure.
     1015   procedure bgelib-hide-cnt:
     1016   do
     1017   on error undo, return error
     1018   :
     1019   define input parameter v-fillin-handle     as handle   no-undo.
     1020       if valid-handle( v-fillin-handle )
     1021       then do:
     1022           assign v-fillin-handle :visible = false.
     1023       end.
     1024   end.
     1025   end procedure.
     1026   procedure bgelib-write-cnt:
     1027   do
     1028   on error undo, return error
     1029   :
     1030   define input parameter v-fillin-handle    as handle       no-undo.
     1031   define input parameter v-fillin-string    as character    no-undo.
     1032       if valid-handle( v-fillin-handle )
     1033       then do:
     1034           assign
     1035               v-fillin-handle :SCREEN-value = v-fillin-string
     1036           .
     1037       end.
     1038   end.
     1039   end procedure.
     1040   procedure bgelib-write-header:
     1041   do
     1042   on error undo, return error
     1043   :
     1044   define input parameter p-first-file     as logical      no-undo.
     1045   define input parameter p-xml-file-name  as character    no-undo.
     1046   define input parameter p-list-file-name as character    no-undo.
     1047   define input parameter p-file-number    as integer      no-undo.
     1048   define input parameter p-have-prev      as logical      no-undo.
     1049   define input parameter p-prev-filename  as character    no-undo.
     1050   define input parameter p-obj-list       as character    no-undo.
     1051   define input parameter p-doc-type-list  as character    no-undo.
     1052   define input parameter p-parameter-list as character    no-undo.
     1053       define variable v-counter    as integer        no-undo.
     1054       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1055       put stream stmXMLOut unformatted
     1056           "<?xml version='1.0' encoding='windows-1251'?>"
     1057       .
     1058       run bgelib-tag-open( input 0, input "root"  , input "" ).
     1059       run bgelib-tag-open( input 0, input "header", input "" ).
     1060       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1061       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1062       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1063       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1064       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     1065       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1066       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1067       :
     1068           run bgelib-tag-put(
     1069                 input 1
     1070               , input entry( 2 * v-counter, p-parameter-list )
     1071               , input entry( 2 * v-counter + 1, p-parameter-list )
     1072               , input 0
     1073           ).
     1074       end.
     1075       run bgelib-tag-close( input 0, input "header" ).
     1076       output stream stmXMLOut close.
     1077       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1078       if p-first-file = yes
     1079       then do:
     1080           put stream stmXMLOut unformatted
     1081               "<?xml version='1.0' encoding='windows-1251'?>"
     1082           .
     1083           run bgelib-tag-open( input 0, input "export", input "" ).
     1084       end.
     1085       run bgelib-tag-open( input 1, input "file", input "" ).
     1086       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1087       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1088       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1089       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1090       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1091       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1092       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1093       :
     1094           run bgelib-tag-put(
     1095                 input 2
     1096               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1097               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1098               , input 0
     1099           ).
     1100       end.
     1101       run bgelib-tag-close( input 1, input "file" ).
     1102       output stream stmXMLOut close.
     1103   end.
     1104   end procedure.
     1105   procedure bgelib-write-footer:
     1106   do
     1107   on error undo, return error
     1108   :
     1109   define input parameter p-last-file      as logical      no-undo.
     1110   define input parameter p-xml-file-name  as character    no-undo.
     1111   define input parameter p-list-file-name as character    no-undo.
     1112   define input parameter p-have-next      as logical      no-undo.
     1113   define input parameter p-next-file-name as character    no-undo.
     1114       define variable v-error-num     as integer           no-undo.
     1115       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1116       if p-have-next = yes
     1117       then do:
     1118           run bgelib-tag-open( input 0, input "footer", "" ).
     1119           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1120           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1121           run bgelib-tag-close( input 0, input "footer" ).
     1122       end.
     1123       run bgelib-tag-close( input 0, input "root" ).
     1124       output stream stmXMLOut close.
     1125       run bge/os_copy.p (
     1126             input "M"
     1127           , input p-xml-file-name + "tmp"
     1128           , input p-xml-file-name + "xml"
     1129           , output v-error-num
     1130       ).
     1131       if p-last-file = yes
     1132       then do:
     1133           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1134               run bgelib-tag-close( input 0, input "export" ).
     1135           output stream stmXMLOut close.
     1136           run bge/os_copy.p (
     1137                 input "M"
     1138               , input p-list-file-name + "tmp"
     1139               , input p-list-file-name + "xml"
     1140               , output v-error-num
     1141           ).
     1142       end.
     1143   end.
     1144   end procedure.
     1145   procedure bgelib-filename :
     1146   do
     1147   on error undo, return error
     1148   :
     1149   define input parameter p-prefix             as character    no-undo.
     1150   define output parameter p-xml-file-name     as character    no-undo.
     1151   define output parameter p-log-file-name     as character    no-undo.
     1152   define output parameter p-list-file-name    as character    no-undo.
     1153       define variable v-home-dir  as character    no-undo.
     1154       define variable v-error-num as integer      no-undo.
     1155       get-key-value section "BGE" key "outdir" value v-home-dir.
     1156       if v-home-dir = ?
     1157       then do:
     1158           message
     1159             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1160             skip(1)
     1161             skip "Обратитесь к администратору."
     1162           view-as alert-box error.
     1163           undo, return error .
     1164       end.
     1165       run gbl/dir-cre.p (
     1166           input v-home-dir
     1167       ) no-error.
     1168       if error-status :error
     1169       then do:
     1170           message
     1171             skip "Неверно задан каталог экспорта."
     1172             skip(1)
     1173             skip "Обратитесь к администратору."
     1174           view-as alert-box error.
     1175           undo, return error .
     1176       end.
     1177       run bge/genfname.p (
     1178             input v-home-dir
     1179           , input p-prefix
     1180           , input ""
     1181           , input "xml"
     1182           , input "tmp"
     1183           , output p-xml-file-name
     1184       ).
     1185       assign
     1186           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1187           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1188           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1189       .
     1190   end.
     1191   end procedure.
     1192   procedure bgelib-read-config :
     1193   do
     1194   on error undo, return error
     1195   :
     1196   define variable v-par-type as character     no-undo.
     1197     define variable v-param-type      as character  no-undo .
     1198     define variable v-value-character as character  no-undo .
     1199     define variable v-value-date      as date       no-undo .
     1200     define variable v-value-decimal   as decimal    no-undo .
     1201     define variable v-value-integer   as integer    no-undo .
     1202     define variable v-value-logical   as logical    no-undo .
     1203     define variable v-tth             as handle     no-undo .
     1204       assign
     1205           v-bgelib-bgeclall = no
     1206           v-bgelib-bgedict  = no
     1207       .
     1208       run adm/shattri.p ( input "get":U
     1209                         , input  '':u
     1210                         , input  0
     1211                         , input  'bge-export':U
     1212                         , input  'bgeclall':U
     1213                         , output v-value-character
     1214                         , output v-value-date
     1215                         , output v-value-decimal
     1216                         , output v-value-integer
     1217                         , output v-value-logical
     1218                         , output v-param-type
     1219                         , input-output table-handle v-tth
     1220                         ) no-error .
     1221       if error-status :error
     1222       then do:
     1223         assign
     1224           v-bgelib-bgeclall = no
     1225         .
     1226       end.
     1227       else do:
     1228         assign
     1229           v-bgelib-bgeclall = v-value-logical
     1230         .
     1231       end.
     1232       delete object v-tth.
     1233       run adm/shattri.p ( input "get":U
     1234                         , input  '':u
     1235                         , input  0
     1236                         , input  'bge-export':U
     1237                         , input  'bgedict':U
     1238                         , output v-value-character
     1239                         , output v-value-date
     1240                         , output v-value-decimal
     1241                         , output v-value-integer
     1242                         , output v-value-logical
     1243                         , output v-param-type
     1244                         , input-output table-handle v-tth
     1245                         ) no-error .
     1246       if error-status :error
     1247       then do:
     1248         assign
     1249           v-bgelib-bgedict = no
     1250         .
     1251       end.
     1252       else do:
     1253         assign
     1254           v-bgelib-bgedict = v-value-logical
     1255         .
     1256       end.
     1257       delete object v-tth.
     1258       run adm/shattri.p ( input "get":U
     1259                         , input  '':u
     1260                         , input  0
     1261                         , input  'bge-export':U
     1262                         , input  'bgefmt':U
     1263                         , output v-value-character
     1264                         , output v-value-date
     1265                         , output v-value-decimal
     1266                         , output v-value-integer
     1267                         , output v-value-logical
     1268                         , output v-param-type
     1269                         , input-output table-handle v-tth
     1270                         ) no-error .
     1271       if error-status :error
     1272       then do:
     1273         assign
     1274           v-bgelib-bgefmt  = "xml":U
     1275         .
     1276       end.
     1277       else do:
     1278         assign
     1279           v-bgelib-bgefmt  = v-value-character
     1280         .
     1281       end.
     1282       delete object v-tth.
     1283       run adm/shattri.p ( input "get":U
     1284                         , input  '':u
     1285                         , input  0
     1286                         , input  'bge-export':U
     1287                         , input  'bgeflold':U
     1288                         , output v-value-character
     1289                         , output v-value-date
     1290                         , output v-value-decimal
     1291                         , output v-value-integer
     1292                         , output v-value-logical
     1293                         , output v-param-type
     1294                         , input-output table-handle v-tth
     1295                         ) no-error .
     1296       if error-status :error
     1297       then do:
     1298         assign
     1299           v-bgelib-bgeflold  = "old":U
     1300         .
     1301       end.
     1302       else do:
     1303         assign
     1304           v-bgelib-bgeflold  = v-value-character
     1305         .
     1306       end.
     1307       delete object v-tth.
     1308   end.
     1309   end procedure.
     1310   procedure bgelib-check-file-size :
     1311   do
     1312   on error undo, return error
     1313   :
     1314   define input parameter p-out-filename   as character    no-undo.
     1315   define output parameter p-is-big        as logical      no-undo.
     1316       define variable v-current-position    as integer        no-undo.
     1317       assign
     1318           v-current-position = seek( stmXMLOut )
     1319       .
     1320       if v-current-position / 1024 / 1024  >= 100
     1321       then do:
     1322           assign
     1323               p-is-big = yes
     1324           .
     1325       end.
     1326   end.
     1327   end procedure.
     1328   procedure bgelib-init-ext-doc-type :
     1329       define variable v-counter    as integer      no-undo.
     1330       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1331   do
     1332   for buf_temp_ext-doc-type
     1333   on error undo, return error
     1334   :
     1335       empty temp-table buf_temp_ext-doc-type.
     1336       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1337       :
     1338           create buf_temp_ext-doc-type.
     1339           assign
     1340               buf_temp_ext-doc-type.edt-key               = v-counter
     1341               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1342               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1343           .
     1344       end.
     1345   end.
     1346   end procedure.
     1347   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1348     define variable v-cntxt-db-num        as integer   no-undo .
     1349     define variable v-cntxt-userid        as character no-undo .
     1350     define variable v-cntxt-level         as character no-undo .
     1351     define variable v-cntxt-host-code-obj as integer   no-undo .
     1352     define variable v-cntxt-obj-type      as character no-undo .
     1353     define variable v-cntxt-obj-code      as integer   no-undo .
     1354     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1355     define variable v-cntxt-is-admin      as logical   no-undo .
     1356   do
     1357   on error undo, return error
     1358   :
     1359       define variable v-xml-file-name     as character    no-undo.
     1360       define variable v-log-file-name     as character    no-undo.
     1361       define variable v-list-file-name    as character    no-undo.
     1362       define variable v-xml-file-number   as integer      no-undo.
     1363       define variable v-locked            as logical      no-undo.
     1364       define variable v-log-string        as character    no-undo.
     1365       define variable v-docs-exists       as logical      no-undo.
     1366       define variable v-obj-counter       as integer      no-undo.
     1367       define variable v-yesno             as logical      no-undo.
     1368       define variable v-cancel            as logical      no-undo.
     1369       define variable v-parameter-list    as character    no-undo.
     1370       if p-shedule = no
     1371       then do:
     1372   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1373     run mainmenu_getcntxt in parparentproc
     1374       (output v-cntxt-db-num
     1375       ,output v-cntxt-userid
     1376       ,output v-cntxt-level
     1377       ,output v-cntxt-host-code-obj
     1378       ,output v-cntxt-obj-type
     1379       ,output v-cntxt-obj-code
     1380       ,output v-cntxt-db-num-obj
     1381       ,output v-cntxt-is-admin
     1382       ) .
     1383   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1384   do:
     1385     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1386       (input  v-cntxt-db-num
     1387       ,input  v-cntxt-userid
     1388       ,input  0
     1389       ,input  'actn_documents_export':U
     1390       ,input  'firm':U
     1391       ,input  v-cntxt-host-code-obj
     1392       ,input  '':U
     1393       ,input  0
     1394       ,input  0
     1395       ,input  0
     1396       ,input  0
     1397       ,input  yes
     1398       ,output v-yesno
     1399       )  .
     1400   end.
     1401           if not v-yesno then do:
     1402               return error.
     1403           end.
     1404       end.
     1405       RUN init-temphost.
     1406       assign
     1407           v-log-string = ", по всем фирмам"
     1408       .
     1409       case p-range:
     1410       when 2
     1411       then do:
     1412           for each temp-obj
     1413           where temp-obj.host-code <> p-host-code
     1414           :
     1415               delete temp-obj.
     1416           end.
     1417           assign
     1418               v-log-string = ", по фирме (код фирмы " + string( p-host-code ) + ")"
     1419           .
     1420       end.
     1421       when 3
     1422       then do:
     1423           for each temp-obj
     1424           :
     1425               delete temp-obj.
     1426           end.
     1427           do v-obj-counter = 1 to num-entries ( p-obj-list ) / 2
     1428           :
     1429               create temp-obj.
     1430               assign
     1431                   temp-obj.obj-type = entry( v-obj-counter * 2 - 1, p-obj-list )
     1432                   temp-obj.obj-code = integer( entry( v-obj-counter * 2, p-obj-list ) )
     1433               no-error .
     1434               if error-status :error
     1435               then do:
     1436                   message
     1437                   vss-workfile vss-revision vss-description
     1438                   skip "Ошибка чтения списка объектов"
     1439                   skip return-value
     1440                   skip trim(error-status :get-message(1))
     1441                       trim(error-status :get-message(2))
     1442                       trim(error-status :get-message(3))
     1443                       trim(error-status :get-message(4))
     1444                       trim(error-status :get-message(5))
     1445                   view-as alert-box error.
     1446                   undo, return error .
     1447               end.
     1448   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1449   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1450     (input  temp-obj.obj-type
     1451     ,input  temp-obj.obj-code
     1452     ,output temp-obj.host-code
     1453     ) no-error .
     1454               if error-status :error
     1455               then do:
     1456                   message
     1457                   vss-workfile vss-revision vss-description
     1458                   skip "Не найдена фирма для объекта" temp-obj.obj-type temp-obj.obj-code
     1459                   skip return-value
     1460                   skip trim(error-status :get-message(1))
     1461                       trim(error-status :get-message(2))
     1462                       trim(error-status :get-message(3))
     1463                       trim(error-status :get-message(4))
     1464                       trim(error-status :get-message(5))
     1465                   view-as alert-box error.
     1466                   undo, return error .
     1467               end.
     1468           end.
     1469           assign
     1470               v-log-string = ", по объектам: " + p-obj-list
     1471           .
     1472       end.
     1473       end case.
     1474       run bgelib-filename in this-procedure (
     1475             input "stt"
     1476           , output v-xml-file-name
     1477           , output v-log-file-name
     1478           , output v-list-file-name
     1479       ).
     1480       run gbl/waitfrsp.w (
     1481             input substring( v-xml-file-name, 1, 1 )
     1482           , input 200
     1483           , output v-cancel
     1484       ) .
     1485       assign
     1486           v-parameter-list = "":U
     1487       .
     1488       if v-cancel = yes
     1489       then do:
     1490           undo, return error .
     1491       end.
     1492       run bgelib-write-log in this-procedure (
     1493             input v-log-file-name
     1494           , input 1
     1495           , input "&DLine"
     1496       ).
     1497       run bgelib-write-log in this-procedure (
     1498             input v-log-file-name
     1499           , input 1
     1500           , input substitute( "Начало выгрузки остатков по типам приобретения в файл &1"
     1501                                   , replace( v-xml-file-name, "/", "\" ) + "xm1"
     1502                             )
     1503       ).
     1504       run bgelib-write-log in this-procedure (
     1505             input v-log-file-name
     1506           , input 1
     1507           , input substitute( "................с параметрами: Дата: &1"
     1508                                   , p-date-to
     1509                             )
     1510       ).
     1511       run bgelib-write-log in this-procedure (
     1512             input v-log-file-name
     1513           , input 1
     1514           , input substitute( "................с параметрами: ... список объектов: &1", p-obj-list )
     1515       ).
     1516       if v-locked = yes
     1517       then do:
     1518           run bgelib-write-log in this-procedure (
     1519                 input v-log-file-name
     1520               , input 1
     1521               , input "*** Ошибка выгрузки: Файл выгрузки заблокирован другим процессом."
     1522           ).
     1523           undo, return error .
     1524       end.
     1525       run bgelib-write-header in this-procedure (
     1526             input yes
     1527           , input v-xml-file-name
     1528           , input v-list-file-name
     1529           , input 1
     1530           , input no
     1531           , input ""
     1532           , input p-obj-list
     1533           , input ""
     1534           , input v-parameter-list
     1535       ).
     1536       object-of-list:
     1537       for each temp-obj
     1538       :
     1539           run export-stk-by-object in this-procedure (
     1540                 input temp-obj.host-code
     1541               , input temp-obj.obj-type
     1542               , input temp-obj.obj-code
     1543               , input v-xml-file-name
     1544               , input v-log-file-name
     1545               , input v-list-file-name
     1546               , input v-xml-file-number
     1547               , output v-xml-file-name
     1548               , output v-xml-file-number
     1549           ) no-error.
     1550           if error-status :error
     1551           then do:
     1552               message
     1553               vss-workfile vss-revision vss-description
     1554               skip "Ошибка экспорта остатков по объекту"
     1555               skip "Тип объекта:" temp-obj.obj-type
     1556               skip "Код объекта:" temp-obj.obj-code
     1557               skip return-value
     1558               skip trim(error-status :get-message(1))
     1559                   trim(error-status :get-message(2))
     1560                   trim(error-status :get-message(3))
     1561               view-as alert-box error.
     1562               next object-of-list.
     1563           end.
     1564       end.
     1565       run bgelib-write-footer in this-procedure (
     1566             input yes
     1567           , input v-xml-file-name
     1568           , input v-list-file-name
     1569           , input no
     1570           , input ""
     1571       ).
     1572       run bgelib-write-log in this-procedure (
     1573             input v-log-file-name
     1574           , input 1
     1575           , input substitute( "Данные выгружены в файл &1"
     1576                                   , replace( v-xml-file-name, "/", "\" ) + "xml"
     1577                             )
     1578       ).
     1579       run bgelib-write-log in this-procedure (
     1580             input v-log-file-name
     1581           , input 1
     1582           , input "&DLine"
     1583       ).
     1584   end.
     1585   procedure export-stk-by-object :
     1586   define input parameter p-host-code  as integer      no-undo.
     1587   define input parameter p-obj-type   as character    no-undo.
     1588   define input parameter p-obj-code   as integer      no-undo.
     1589   define input parameter p-xml-file-name          as character    no-undo.
     1590   define input parameter p-log-file-name          as character    no-undo.
     1591   define input parameter p-list-file-name         as character    no-undo.
     1592   define input parameter p-xml-file-number        as integer      no-undo.
     1593   define output parameter p-new-xml-file-name     as character    no-undo.
     1594   define output parameter p-new-xml-file-number   as integer      no-undo.
     1595       define variable v-fact-order-from   as decimal      no-undo.
     1596       define variable v-fact-order-to     as decimal      no-undo.
     1597       define variable v-docs-exists       as logical      no-undo.
     1598       define variable v-date-to-temp      as date         no-undo.
     1599       define variable v-archive-ok        as logical      no-undo.
     1600       define variable v-comment           as character    no-undo.
     1601       define variable v-can-print         as logical      no-undo.
     1602   do
     1603   on error undo, return error
     1604   :
     1605       assign
     1606           p-new-xml-file-name     = p-xml-file-name
     1607           p-new-xml-file-number   = p-xml-file-number
     1608       .
     1609       run bgelib-write-edt(
     1610             input hEDT
     1611           , input 1
     1612           , input substitute( "&1 &2. Расчет архивов...", p-obj-type, p-obj-code )
     1613       ).
     1614       process events.
     1615       assign
     1616           v-date-to-temp = p-date-to
     1617       .
     1618       run rep/chk-ahz.p (
     1619             input p-obj-type
     1620           , input p-obj-code
     1621           , input yes
     1622           , input no
     1623           , input no
     1624           , input yes
     1625           , input yes
     1626           , input v-cntxt-db-num
     1627           , input v-cntxt-userid
     1628           , input-output v-date-to-temp
     1629           , input-output v-date-to-temp
     1630           , output v-archive-ok
     1631           , output v-comment
     1632           , output v-can-print
     1633       ) .
     1634       if v-archive-ok = no
     1635       then do:
     1636           message
     1637               skip "Экспорт по объекту невозможен."
     1638               skip (1)
     1639               skip v-comment
     1640               skip (1)
     1641               skip "Тип объекта:" p-obj-type
     1642               skip "Код объекта:" p-obj-code
     1643           view-as alert-box information.
     1644           run bgelib-write-edt(
     1645                 input hEDT
     1646               , input 1
     1647               , input substitute( "&1 &2. Экспорт по объекту невозможен. &3", p-obj-type, p-obj-code, v-comment )
     1648           ).
     1649           process events.
     1650           undo, return error .
     1651       end.
     1652       run bgelib-write-edt( hEDT, 4,  "Расчет архивов завершен. Вывод данных по товарам...").
     1653       run rep/get-fo.p (
     1654             input  p-obj-type
     1655           , input  p-obj-code
     1656           , input  ?
     1657           , input  p-date-to
     1658           , output v-fact-order-from
     1659           , output v-fact-order-to
     1660           , output v-docs-exists
     1661       ) no-error .
     1662       if error-status :error
     1663       then do:
     1664           message
     1665             vss-workfile vss-revision vss-description
     1666             skip "Ошибка определения границ fact-order для поиска по архивам"
     1667             skip return-value
     1668             skip trim(error-status :get-message(1))
     1669                  trim(error-status :get-message(2))
     1670                  trim(error-status :get-message(3))
     1671           view-as alert-box error.
     1672           undo, return error .
     1673       end.
     1674       run bge/sttoper.p (
     1675             input p-obj-type
     1676           , input p-obj-code
     1677           , input p-date-to
     1678           , input v-fact-order-to
     1679           , input p-obj-list
     1680           , input v-parameter-list
     1681           , input v-xml-file-name
     1682           , input v-log-file-name
     1683           , input p-list-file-name
     1684           , input p-xml-file-number
     1685           , input hEDT
     1686           , input hCNT
     1687           , output p-new-xml-file-name
     1688           , output p-new-xml-file-number
     1689       ) no-error.
     1690       if error-status :error
     1691       then do:
     1692           run bgelib-write-edt( hEDT, 1, string(return-value)).
     1693       end.
     1694       assign
     1695           p-xml-file-name     = p-new-xml-file-name
     1696           p-xml-file-number   = p-new-xml-file-number
     1697       .
     1698   end.
     1699   end procedure.
