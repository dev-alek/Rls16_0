      609                       when chr(2)
      610                       then do:
      611                           assign
      612                               p-out-string = p-out-string + " ":U
      613                           .
      614                       end.
      615                       when chr(3)
      616                       then do:
      617                           assign
      618                               p-out-string = p-out-string + " ":U
      619                           .
      620                       end.
      621                       when chr(4)
      622                       then do:
      623                           assign
      624                               p-out-string = p-out-string + " ":U
      625                           .
      626                       end.
      627                       when chr(5)
      628                       then do:
      629                           assign
      630                               p-out-string = p-out-string + " ":U
