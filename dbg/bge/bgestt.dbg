      184   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      185   procedure cur-time :
      186      define output parameter p-today as date      no-undo .
      187      define output parameter p-time  as integer   no-undo .
      188     do
      189     on error undo, return error
      190     :
      191       define variable v-date1 as date      no-undo .
      192       define variable v-date2 as date      no-undo .
      193       define variable v-time  as integer   no-undo .
      194       assign
      195         v-date1 = today
      196         v-time  = time
      197         v-date2 = today
      198       .
      199       if v-date1 <> v-date2
      200       then do:
      201         assign
      202           v-date1 = today
      203           v-time  = v-time
      204         .
      205       end.
      206       assign
      207         p-today = v-date1
      208         p-time  = v-time
      209       .
      210     end.
      211   end.
      212   function cur-time-date returns character
      213   :
      214     return string(today, '99/99/9999':U) .
      215   end.
      216   function cur-time-mjd returns decimal
      217   :
      218     define variable v-date as date      no-undo .
      219     define variable v-time as integer   no-undo .
      220     run cur-time in this-procedure
      221       (output v-date
      222       ,output v-time
      223       ) .
      224     return integer(v-date) - 2400002 + (v-time / 86400) .
      225   end.
      226   function cur-time-get-ending-index returns integer
      227   (input p-number as integer
      228   )
      229   :
      230     if p-number < 0
      231     or p-number = ?
      232     then do:
      233       return 1 .
      234     end.
      235     define variable v-rest as integer   no-undo .
      236     assign
      237       p-number = p-number modulo 100
      238     .
      239     if p-number < 20
      240     then do:
      241       assign
      242         v-rest = p-number
      243       .
      244     end.
      245     else do:
      246       assign
      247         v-rest = p-number modulo 10
      248       .
      249     end.
      250     case v-rest :
      251       when 1
      252       then do:
      253         return 2 .
      254       end.
      255       when 2 or
      256       when 3 or
      257       when 4
      258       then do:
      259         return 3 .
      260       end.
      261       otherwise do:
      262         return 1 .
      263       end.
      264     end case .
      265   end.
      266   procedure cur-time-mjd-to-date :
      267      define input  parameter i-mjd-diff as decimal no-undo.
      268      define output parameter o-Date     as date    no-undo.
      269      define output parameter o-Time     as integer no-undo.
      270      define variable v-day-number as integer   no-undo .
      271      if    i-mjd-diff < 0
      272         or i-mjd-diff = ?
      273      then do:
      274         return "?" .
      275      end.
      276      assign
      277         v-day-number = truncate(i-mjd-diff,0).
      278         o-Date = date(v-day-number + 2400002).
      279         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      280     .
      281   end.
      282   function cur-time-mjd-to-string returns character
      283   (input p-mjd-diff as decimal
      284   )
      285   :
      286     define variable v-day-number as integer   no-undo .
      287     define variable v-seconds    as integer   no-undo .
      288     define variable v-hour       as integer   no-undo .
      289     define variable v-min        as integer   no-undo .
      290     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      291     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      292     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      293     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      294     if p-mjd-diff < 0
      295     or p-mjd-diff = ?
      296     then do:
      297       return "?" .
      298     end.
      299     assign
      300       v-day-number = integer(truncate(p-mjd-diff,0))
      301       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      302     .
      303     if v-seconds > 86400
      304     then do:
      305       assign
      306         v-seconds = 86400 - 1
      307       .
      308     end.
      309     if v-seconds < 0
      310     then do:
      311       assign
      312         v-seconds = 0
      313       .
      314     end.
      315     assign
      316       v-hour = truncate(v-seconds / 3600, 0)
      317     .
      318     assign
      319       v-seconds = v-seconds modulo 3600
      320     .
      321     assign
      322       v-min = truncate(v-seconds / 60, 0)
      323     .
      324     assign
      325       v-seconds = v-seconds modulo 60
      326     .
      327     return
      328         (if v-day-number <> 0
      329           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      330           else ""
      331         )
      332       + (if v-day-number <> 0 or v-hour <> 0
      333           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      334           else ""
      335         )
      336       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      337           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      338           else ""
      339         )
      340       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      341       .
      342   end.
      343   function cur-time-string returns character
      344   :
      345     define variable v-date as date      no-undo .
      346     define variable v-time as integer   no-undo .
      347     run cur-time in this-procedure
      348       (output v-date
      349       ,output v-time
      350       ) .
      351     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      352   end.
      353   function cur-time-string-sec returns character
      354   :
      355     define variable v-date as date      no-undo .
      356     define variable v-time as integer   no-undo .
      357     run cur-time in this-procedure
      358       (output v-date
      359       ,output v-time
      360       ) .
      361     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      362   end.
      363   function cur-time-custom  returns character
      364   (input p-prefix as character
      365   ,input p-date-format as character
      366   ,input p-delimiter as character
      367   ,input p-time-format as character
      368   ,input p-suffix as character
      369   )
      370   :
      371     define variable v-date as date      no-undo .
      372     define variable v-time as integer   no-undo .
      373     run cur-time in this-procedure
      374       (output v-date
      375       ,output v-time
      376       ) .
      377     return
      378       p-prefix
      379       + string(v-date, p-date-format)
      380       + p-delimiter
      381       + string(v-time, p-time-format)
      382       + p-suffix
      383       .
      384   end.
      385   function cur-time-print  returns character
      386   :
      387     define variable v-date as date      no-undo .
      388     define variable v-time as integer   no-undo .
      389     run cur-time in this-procedure
      390       (output v-date
      391       ,output v-time
      392       ) .
      393     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      394   end.
      395   function cur-time-datetime returns datetime
      396   :
      397     define variable v-char as character no-undo .
      398     define variable v-datetime as datetime no-undo .
      399     v-char = cur-time-string().
      400     v-datetime = datetime(v-char).
      401     return  v-datetime.
      402   end.
      403   function cur-time-string-msec returns character
      404   :
      405     define variable v-date as datetime  no-undo .
      406     v-date = now.
      407     return string(v-date) .
      408   end.
      409   define variable vss-include-info3 as character format "X(65)" no-undo
      410   initial "@(#)$Workfile$ $Revision$".
      411   procedure xmlchar-test :
      412   define input parameter p-in-string          as character        no-undo.
      413   define output parameter p-out-string-enc    as character        no-undo.
      414   define output parameter p-out-string-dec    as character        no-undo.
      415   do
      416   on error undo, return error
      417   :
      418          run xmlchar-encode in this-procedure
      419       (
      420             input p-in-string
      421           , output p-out-string-enc
      422       ).
      423          run xmlchar-decode in this-procedure
      424       (
      425             input p-out-string-enc
      426           , output p-out-string-dec
      427       ).
      428   end.
      429   end .
      430   procedure xmlchar-encode :
      431   define input parameter p-in-string      as character        no-undo.
      432   define output parameter p-out-string    as character        no-undo.
      433       define variable v-position      as integer      no-undo.
      434       define variable v-current-char  as character    no-undo.
      435   do
      436   on error undo, return error
      437   :
      438       assign
      439           p-out-string = "":U
      440       .
      441       case p-in-string
      442       :
      443           when ?
      444           then do:
      445               assign
      446                   p-out-string = "?":U
      447               .
      448           end.
      449           when "?":U
      450           then do:
      451               assign
      452                   p-out-string = "&#63;":U
      453               .
      454           end.
      455           otherwise do:
      456               do v-position = 1 to length( p-in-string )
      457               :
      458                   assign
      459                       v-current-char = substring( p-in-string, v-position, 1 )
      460                   .
      461                   case v-current-char
      462                   :
      463                       when "&":U
      464                       then do:
      465                           assign
      466                               p-out-string = p-out-string + "&amp;":U
      467                           .
      468                       end.
      469                       when ">":U
      470                       then do:
      471                           assign
      472                               p-out-string = p-out-string + "&gt;":U
      473                           .
      474                       end.
      475                       when "<":U
      476                       then do:
      477                           assign
      478                               p-out-string = p-out-string + "&lt;":U
      479                           .
      480                       end.
      481                       when "'":U
      482                       then do:
      483                           assign
      484                               p-out-string = p-out-string + "&apos;":U
      485                           .
      486                       end.
      487                       when '"':U
      488                       then do:
      489                           assign
      490                               p-out-string = p-out-string + "&quot;":U
      491                           .
      492                       end.
      493                       when chr(1)
      494                       then do:
      495                           assign
      496                               p-out-string = p-out-string + "":U
      497                           .
      498                       end.
      499                       when chr(2)
      500                       then do:
      501                           assign
      502                               p-out-string = p-out-string + "":U
      503                           .
      504                       end.
      505                       when chr(3)
      506                       then do:
      507                           assign
      508                               p-out-string = p-out-string + "":U
      509                           .
      510                       end.
      511                       when chr(4)
      512                       then do:
      513                           assign
      514                               p-out-string = p-out-string + "":U
      515                           .
      516                       end.
      517                       when chr(5)
      518                       then do:
      519                           assign
      520                               p-out-string = p-out-string + "":U
      521                           .
      522                       end.
      523                       when chr(6)
      524                       then do:
      525                           assign
      526                               p-out-string = p-out-string + "":U
      527                           .
      528                       end.
      529                       when chr(7)
      530                       then do:
      531                           assign
      532                               p-out-string = p-out-string + "":U
      533                           .
      534                       end.
      535                       when chr(8)
      536                       then do:
      537                           assign
      538                               p-out-string = p-out-string + "":U
      539                           .
      540                       end.
      541                       when chr(9)
      542                       then do:
      543                           assign
      544                               p-out-string = p-out-string + "":U
      545                           .
      546                       end.
      547                       when chr(29)
      548                       then do:
      549                           assign
      550                               p-out-string = p-out-string + "":U
      551                           .
      552                       end.
      553                       when chr(10)
      554                       then do:
      555                           assign
      556                               p-out-string = p-out-string + "&#10;":U
      557                           .
      558                       end.
      559                       when chr(13)
      560                       then do:
      561                           assign
      562                               p-out-string = p-out-string + "&#13;":U
      563                           .
      564                       end.
      565                       otherwise do:
      566                           assign
      567                               p-out-string = p-out-string + v-current-char
      568                           .
      569                       end.
      570                   end case.
      571               end.
      572           end.
      573       end case.
      574   end.
      575   end .
      576   procedure xmlchar-encode-1c :
      577   define input parameter p-in-string      as character        no-undo.
      578   define output parameter p-out-string    as character        no-undo.
      579       define variable v-position      as integer      no-undo.
      580       define variable v-current-char  as character    no-undo.
      581   do
      582   on error undo, return error
      583   :
      584       assign
      585           p-out-string = "":U
      586       .
      587       case p-in-string
      588       :
      589           when ?
      590           then do:
      591               assign
      592                   p-out-string = "?":U
      593               .
      594           end.
      595           otherwise do:
      596               do v-position = 1 to length( p-in-string )
      597               :
      598                   assign
      599                       v-current-char = substring( p-in-string, v-position, 1 )
      600                   .
      601                   case v-current-char
      602                   :
      603                       when chr(1)
      604                       then do:
      605                           assign
      606                               p-out-string = p-out-string + " ":U
      607                           .
