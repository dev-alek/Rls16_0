     3210         end.
     3211         for each buf_temp-browse-handle
     3212           where buf_temp-browse-handle.browse-type = 'width':u
     3213         on error undo move_block, retry move_block
     3214         :
     3215           assign
     3216             buf_temp-browse-handle.browse-handle :width
     3217               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3218             no-error .
     3219           if error-status :error
     3220           or error-status :get-message(1) <> ""
     3221           then do:
     3222             undo move_block, retry move_block .
     3223           end.
     3224         end.
     3225         assign
     3226           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3227           no-error .
     3228         if error-status :error
     3229         or error-status :get-message(1) <> ""
     3230         then do:
     3231           undo move_block, retry move_block.
     3232         end.
     3233         assign
     3234           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3235         no-error .
     3236         if error-status :error
     3237         or error-status :get-message(1) <> ""
     3238         then do:
     3239           undo move_block, retry move_block.
     3240         end.
     3241         if frame Dialog-Frame :scrollable = true
     3242         then do:
     3243           assign
     3244             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3245           no-error .
     3246           if error-status :error
     3247           or error-status :get-message(1) <> ""
     3248           then do:
     3249             undo move_block, retry move_block.
     3250           end.
     3251         end.
     3252       end.
     3253       if p-move-resize
     3254       then do:
     3255         run diasize_position-resize-button in this-procedure .
     3256       end.
     3257       if v-diasize-wndstore = true
     3258       then do:
     3259         if connected("ub") = true
     3260         then do:
     3261           define variable v-cntxt-db-num        as integer   no-undo .
     3262           define variable v-cntxt-userid        as character no-undo .
     3263           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3264                                             , OUTPUT v-cntxt-userid
     3265                                             ) .
     3266           run gbl/wndsizew.p
     3267             (input  v-cntxt-db-num
     3268             ,input  v-cntxt-userid
     3269             ,input  v-diasize-proc-name
     3270             ,input  'width':u
     3271             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3272             ) .
     3273         end.
     3274       end.
     3275     end.
     3276     assign
     3277       v-diasize-change-size = false
     3278     .
     3279   end procedure.
     3280   procedure diasize_set-width :
     3281     define input  parameter p-new-width  as decimal   no-undo .
     3282     define input  parameter p-move-resize as logical   no-undo .
     3283     do
     3284     on error undo, return error return-value
     3285     :
     3286       run diasize_change-width in this-procedure
     3287         (input  (p-new-width - frame Dialog-Frame :width)
     3288         ,input  p-move-resize
     3289         ) .
     3290     end.
     3291   end procedure.
     3292   procedure diasize_position-resize-button :
     3293     do with frame Dialog-Frame
     3294     :
     3295       hide v-diasize-resize-button .
     3296       assign
     3297         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3298                     - 1
     3299                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3300         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3301                     - 1
     3302                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3303       .
     3304       view v-diasize-resize-button .
     3305     end.
     3306   end procedure.
     3307   on alt-right anywhere
     3308   do:
     3309     run diasize_change-width in this-procedure
     3310       (input 1
     3311       ,input true
     3312       ) .
     3313     return no-apply .
     3314   end.
     3315   on alt-left anywhere
     3316   do:
     3317     run diasize_change-width in this-procedure
     3318       (input -1
     3319       ,input true
     3320       ) .
     3321     return no-apply .
     3322   end.
     3323   on alt-down anywhere
     3324   do:
     3325     run diasize_change-height in this-procedure
     3326       (input 1
     3327       ,input true
     3328       ) .
     3329     return no-apply .
     3330   end.
     3331   on alt-up anywhere
     3332   do:
     3333     run diasize_change-height in this-procedure
     3334       (input -1
     3335       ,input true
     3336       ) .
     3337     return no-apply .
     3338   end.
     3339   on alt-enter of frame Dialog-Frame
     3340   do:
     3341     run diasize_maximize in this-procedure
     3342       (input  ?
     3343       ).
     3344     return no-apply .
     3345   end.
     3346   procedure diasize_end-move :
     3347     do
     3348     on error undo, return error return-value
     3349     :
     3350       define variable v-row-delta as decimal   no-undo .
     3351       define variable v-col-delta as decimal   no-undo .
     3352       define variable v-new-row as decimal   no-undo .
     3353       define variable v-new-col as decimal   no-undo .
     3354       assign
     3355         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3356         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3357       .
     3358       assign
     3359         v-row-delta = v-new-row - frame Dialog-Frame :height
     3360         v-col-delta = v-new-col - frame Dialog-Frame :width
     3361       .
     3362       run diasize_change-height in this-procedure
     3363         (input v-row-delta
     3364         ,input true
     3365         ) .
     3366       run diasize_change-width in this-procedure
     3367         (input v-col-delta
     3368         ,input true
     3369         ) .
     3370     end.
     3371   end procedure.
     3372   procedure diasize_maximize :
     3373     define input  parameter p-action as logical   no-undo .
     3374     do
     3375     on error undo, return error return-value
     3376     :
     3377       if p-action = ?
     3378       then do:
     3379         if v-diasize-need-maximize = true
     3380         then do:
     3381           assign
     3382             p-action = true
     3383           .
     3384         end.
     3385         else do:
     3386           assign
     3387             p-action = false
     3388           .
     3389         end.
     3390       end.
     3391       if p-action = true
     3392       then do:
     3393         run diasize_change-height in this-procedure
     3394           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3395               - frame Dialog-Frame :height-chars
     3396           ,input true
     3397           ) .
     3398         run diasize_change-width in this-procedure
     3399           (input session :width-chars
     3400               - frame Dialog-Frame :width-chars
     3401           ,input true
     3402           ) .
     3403         assign
     3404           v-diasize-need-maximize = false
     3405         .
     3406       end.
     3407       else do:
     3408         run diasize_change-width in this-procedure
     3409           (input v-diasize-orig-frame-width
     3410               - frame Dialog-Frame :width-chars
     3411           ,input true
     3412           ) .
     3413         run diasize_change-height in this-procedure
     3414           (input v-diasize-orig-frame-height
     3415               - frame Dialog-Frame :height-chars
     3416           ,input true
     3417           ) .
     3418         assign
     3419           v-diasize-need-maximize = true
     3420         .
     3421       end.
     3422     end.
     3423   end procedure.
     3424   procedure diasize_restore-orig-size :
     3425     do
     3426     on error undo, return error return-value
     3427     :
     3428       assign
     3429         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3430         v-diasize-current-frame-height = frame Dialog-Frame :height
     3431       .
     3432       run diasize_set-height in this-procedure
     3433         (input  v-diasize-orig-frame-height
     3434         ,input  true
     3435         ) .
     3436       run diasize_set-width in this-procedure
     3437         (input  v-diasize-orig-frame-width
     3438         ,input  true
     3439         ) .
     3440     end.
     3441   end procedure.
     3442   procedure diasize_restore-current-size :
     3443     do
     3444     on error undo, return error return-value
     3445     :
     3446       run diasize_set-height in this-procedure
     3447         (input  v-diasize-current-frame-height
     3448         ,input  true
     3449         ) .
     3450       run diasize_set-width in this-procedure
     3451         (input  v-diasize-current-frame-width
     3452         ,input  true
     3453         ) .
     3454     end.
     3455   end procedure.
     3456   procedure diasize_set-browse-handle :
     3457     define input  parameter p-browse-handle as handle   no-undo .
     3458     define buffer buf_temp-browse-handle for temp-browse-handle .
     3459     do
     3460     on error undo, return error return-value
     3461     :
     3462       assign
     3463         v-diasize-browse-handle = p-browse-handle
     3464       .
     3465       for each buf_temp-browse-handle
     3466       on error undo, return error return-value
     3467       :
     3468         delete buf_temp-browse-handle .
     3469       end.
     3470     end.
     3471   end procedure.
     3472   procedure diasize_add_browse :
     3473     define input  parameter p-browse-type   as character no-undo .
     3474     define input  parameter p-browse-handle as handle    no-undo .
     3475     define buffer buf_temp-browse-handle for temp-browse-handle .
     3476     do
     3477     on error undo, return error return-value
     3478     :
     3479       assign
     3480         v-diasize-browse-number = v-diasize-browse-number + 1
     3481       .
     3482       create buf_temp-browse-handle .
     3483       assign
     3484         buf_temp-browse-handle.browse-type   = p-browse-type
     3485         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3486         buf_temp-browse-handle.browse-handle = p-browse-handle
     3487       .
     3488     end.
     3489   end procedure.
     3490   procedure diasize_init :
     3491     define variable v-default-value    as logical   no-undo .
     3492     define variable v-restore-saved    as logical   no-undo .
     3493     define variable v-resize-value-str as character no-undo .
     3494     do
     3495     on error undo, return error return-value
     3496     :
     3497       do with frame Dialog-Frame
     3498       :
     3499         assign
     3500           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3501           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3502           v-diasize-browse-handle     = browse br-gds-act :handle
     3503         .
     3504         create button v-diasize-resize-button
     3505         assign
     3506           parent        = frame Dialog-Frame :first-child
     3507           label         = "s"
     3508           height-pixels = 16
     3509           width-pixels  = 16
     3510           visible       = true
     3511           sensitive     = true
     3512           movable       = true
     3513           triggers:
     3514             on end-move persistent run diasize_end-move in this-procedure .
     3515           end triggers.
     3516         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3517         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3518         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3519         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3520         assign
     3521           v-diasize-wndmax = false
     3522         .
     3523         if connected("ub") = true
     3524         then do:
     3525           define variable v-cntxt-db-num        as integer   no-undo .
     3526           define variable v-cntxt-userid        as character no-undo .
     3527           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3528                                             , OUTPUT v-cntxt-userid
     3529                                             ) .
     3530           run gbl/wndpar_r.p
     3531             (input  v-cntxt-db-num
     3532             ,input  v-cntxt-userid
     3533             ,input  'wndmax':U
     3534             ,output v-diasize-wndmax
     3535             ,output v-default-value
     3536             ) .
     3537         end.
     3538         assign
     3539           v-diasize-wndstore = false
     3540         .
     3541         if connected("ub") = true
     3542         then do:
     3543           run gbl/wndpar_r.p
     3544             (input  v-cntxt-db-num
     3545             ,input  v-cntxt-userid
     3546             ,input  'wndstore':U
     3547             ,output v-diasize-wndstore
     3548             ,output v-default-value
     3549             ) .
     3550         end.
     3551         assign
     3552           v-diasize-proc-name = entry(1, program-name(2), '.')
     3553         .
     3554         if v-diasize-wndstore = true
     3555         then do:
     3556           assign
     3557             v-restore-saved = false
     3558           .
     3559           if connected("ub") = true
     3560           then do:
     3561             run gbl/wndsizer.p
     3562               (input  v-cntxt-db-num
     3563               ,input  v-cntxt-userid
     3564               ,input  v-diasize-proc-name
     3565               ,input  'height':u
     3566               ,output v-resize-value-str
     3567               ) .
     3568             if v-resize-value-str <> '':U
     3569             then do:
     3570               run diasize_change-height in this-procedure
     3571                 (input  integer(v-resize-value-str)
     3572                 ,input  true
     3573                 ) .
     3574               assign
     3575                 v-restore-saved = true
     3576               .
     3577             end.
     3578           end.
     3579           if connected("ub") = true
     3580           then do:
     3581             run gbl/wndsizer.p
     3582               (input  v-cntxt-db-num
     3583               ,input  v-cntxt-userid
     3584               ,input  v-diasize-proc-name
     3585               ,input  'width':u
     3586               ,output v-resize-value-str
     3587               ) .
     3588             if v-resize-value-str <> '':U
     3589             then do:
     3590               run diasize_change-width in this-procedure
     3591                 (input  integer(v-resize-value-str)
     3592                 ,input  true
     3593                 ) .
     3594               assign
     3595                 v-restore-saved = true
     3596               .
     3597             end.
     3598           end.
     3599           if v-restore-saved <> true
     3600           then do:
     3601             if v-diasize-wndmax = true
     3602             then do:
     3603               run diasize_maximize in this-procedure
     3604                 (input  true
     3605                 ) .
     3606             end.
     3607           end.
     3608         end.
     3609         else do:
     3610           if v-diasize-wndmax = true
     3611           then do:
     3612             run diasize_maximize in this-procedure
     3613               (input  true
     3614               ) .
     3615           end.
     3616         end.
     3617       end.
     3618     end.
     3619   end procedure.
     3620   procedure diasize_need-full-display :
     3621     define output parameter p-need-full-display as logical   no-undo .
     3622     do
     3623     on error undo, return error return-value
     3624     :
     3625       assign
     3626         p-need-full-display = v-diasize-need-full-display
     3627       .
     3628       assign
     3629         v-diasize-need-full-display = false
     3630       .
     3631     end.
     3632   end procedure.
     3633   procedure get-context :
     3634      define output parameter p-db-num as integer          no-undo.
     3635      define output parameter p-user-id as character        no-undo.
     3636      define variable v-login               as character    no-undo.
     3637      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3638      define buffer buf_user-login  for ub.user-login .
     3639      do
     3640      on error undo, return error
     3641      :
     3642            FIND FIRST buf_sys-ctrl no-lock.
     3643            ASSIGN
     3644               v-login = USERID("ub")
     3645               p-db-num = buf_sys-ctrl.db-num
     3646            .
     3647            FIND FIRST buf_user-login
     3648                 WHERE buf_user-login.db-num = p-db-num
     3649                   AND buf_user-login.user-login = v-login
     3650                 no-lock
     3651                 no-error
     3652                 .
     3653            IF AVAILABLE buf_user-login
     3654            THEN DO:
     3655               assign
     3656                  p-user-id = buf_user-login.user-id
     3657               .
     3658            END.
     3659      end.
     3660   end procedure.
     3661       run diasize_init in this-procedure .
     3662       RUN enable_UI.
     3663       WAIT-FOR GO OF FRAME Dialog-Frame.
     3664   END.
     3665   RUN disable_UI.
     3666   PROCEDURE proc-b-mark :
     3667     define variable varlog as logical   no-undo .
     3668     if not available tt-gds-act then return.
     3669     run local-mark in this-procedure.
     3670     assign varlog = br-gds-act :select-next-row( ) in frame Dialog-Frame.
     3671     apply "ENTRY":U to br-gds-act in frame Dialog-Frame.
     3672     br-gds-act:refresh() in frame Dialog-Frame .
     3673   END PROCEDURE.
     3674   PROCEDURE local-mark :
     3675     if not available tt-gds-act then do:
     3676       message "Неправильный выбор строки.".
     3677       return no-apply.
     3678     end.
     3679   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3680   define variable v-str-recid15 as character no-undo .
     3681   define variable v-num-entry15 as integer   no-undo .
     3682   assign
     3683     v-str-recid15 = trim( string( recid( tt-gds-act ) , "->>>>>>>>>>>9":U ) )
     3684     v-num-entry15 = lookup( v-str-recid15 , select-list )
     3685   .
     3686   if v-num-entry15 > 0 then do:
     3687     assign
     3688       entry( v-num-entry15, select-list ) = "":U
     3689       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     3690     .
     3691   end.
     3692   else do:
     3693     assign
     3694       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid15
     3695     .
     3696   end.
     3697     br-gds-act:refresh() in frame Dialog-Frame .
     3698   END PROCEDURE.
     3699   PROCEDURE disable_UI :
     3700     HIDE FRAME Dialog-Frame.
     3701   END PROCEDURE.
     3702   PROCEDURE enable_UI :
     3703     ENABLE b-cancel  b-save br-gds-act b-del b-mark b-sel-all b-unmark
     3704         WITH FRAME Dialog-Frame.
     3705     VIEW FRAME Dialog-Frame.
     3706       if p-mode = 'ПРОСМОТР':U then do :
     3707           disable  tt-act-header.num tt-act-header.date_ with frame Dialog-Frame.
     3708           define variable hCol as handle no-undo .
     3709           define variable hBr  as handle no-undo .
     3710           define variable i    as integer no-undo .
     3711           hBr = browse br-gds-act:handle .
     3712           do i = 6 to 7 :
     3713               hCol = hBr:GET-BROWSE-COLUMN(i).
     3714               hCol:read-only = true .
     3715           end.
     3716           hide b-good b-save b-del b-alc-code in FRAME Dialog-Frame.
     3717       end.
     3718   END PROCEDURE.
