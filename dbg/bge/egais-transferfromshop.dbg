     1574   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1575   define new global shared variable g#trdcalib as handle no-undo.
     1576   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1577   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1578   define variable v-waitfram-action01         as character   no-undo .
     1579   define variable v-waitfram-action02         as character   no-undo .
     1580   define variable v-waitfram-action03         as character   no-undo .
     1581   define variable mWaitFramTextBeg            as character   no-undo.
     1582   define variable mWaitFramTextEnd            as character   no-undo.
     1583   define variable mWaitFramView               as logical     no-undo.
     1584   define variable mWaitProcEvent              as logical     no-undo init yes.
     1585   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1586   define variable mWaitFramStop               as logical     no-undo.
     1587   define variable mWaitFramStopUser           as logical     no-undo.
     1588   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1589   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1590   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1591   define button B-WaitFramStop auto-end-key
     1592        label "Стоп"
     1593        size 10 by 1 tooltip "Остоновить процесс".
     1594   define button B-viewProcInfo
     1595        label "Информация"
     1596        size 15 by 1 tooltip "Информация о процесс".
     1597   define frame waitfram
     1598     v-waitfram-action01 format "x(72)" no-label skip
     1599     v-waitfram-action02 format "x(72)" no-label skip
     1600     v-waitfram-action03 format "x(72)" no-label skip
     1601     B-viewProcInfo
     1602     B-WaitFramStop at row 4 col 30
     1603     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1604     .
     1605   define new global shared variable mBatchMode as logical no-undo init ?.
     1606   define variable mFramBachModHandle as handle no-undo.
     1607   mFramBachModHandle = frame waitfram:handle.
     1608   define variable mFameOldVis as logical no-undo.
     1609   define variable mVisCUrentVin as logical no-undo.
     1610   if session:batch-mode
     1611   then
     1612      mBatchMode = yes.
     1613   if mBatchMode = ? then do:
     1614     mVisCUrentVin = current-window:visible.
     1615     mFameOldVis = mFramBachModHandle:visible.
     1616     mFramBachModHandle:visible  = yes.
     1617     mBatchMode = mFramBachModHandle:visible ne yes.
     1618     mFramBachModHandle:visible = mFameOldVis.
     1619     current-window:visible = mVisCUrentVin.
     1620   end.
     1621    if  log-manager:logfile-name ne ?
     1622     then DO:
     1623         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1624         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1625         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1626     end.
     1627   on choose of B-WaitFramStop in frame waitfram
     1628   do:
     1629     mWaitFramStop = yes.
     1630     mWaitFramStopUser = yes.
     1631   end.
     1632   function waitfram-check-timeout returns logical():
     1633      define variable vtime as int64 no-undo.
     1634      if mWaitFramStopTimeOut
     1635      then
     1636         return yes.
     1637      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1638      if     mWaitFramTimeOut ne ?
     1639         and mWaitFramTimeOut ne 0
     1640         and mWaitFramTimeOut lt vtime
     1641      then do:
     1642         mWaitFramStopTimeOut = yes.
     1643      end.
     1644      return mWaitFramStopTimeOut.
     1645   end.
     1646   procedure waitfram-hide :
     1647     if not session:batch-mode
     1648     then do
     1649     on error undo, return error return-value
     1650     :
     1651       pause 0 before-hide .
     1652       if not mBatchMode then
     1653         hide frame waitfram .
     1654     if     not mWaitFramView
     1655        and mWaitProcEvent
     1656     then
     1657       process events .
     1658     end.
     1659   end procedure.
     1660   procedure waitfram-show :
     1661     define input  parameter p-message as character no-undo .
     1662     define variable v-left-margin as integer   no-undo .
     1663     if not session:batch-mode
     1664     then do
     1665     on error undo, return error return-value
     1666     :
     1667       if length(p-message) <= 70 then do:
     1668         assign
     1669           v-left-margin = integer((70 - length(p-message)) / 2)
     1670         .
     1671         assign
     1672           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1673         .
     1674         assign
     1675           v-waitfram-action01 = " "
     1676           v-waitfram-action02 = " "
     1677                                    + fill(" ", v-left-margin)
     1678                                    + p-message
     1679           v-waitfram-action03 = " "
     1680         .
     1681       end.
     1682       else do:
     1683         define variable vRindex1 as integer no-undo.
     1684         define variable vRindex2 as integer no-undo.
     1685         vRindex1 = r-index(p-message," ",70).
     1686         if vRindex1 = 0
     1687         then
     1688            vRindex1 = 70.
     1689         if length(p-message)  <= vRindex1 + 70 then do:
     1690           assign
     1691             v-waitfram-action01 = " "
     1692             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1693             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1694           .
     1695         end.
     1696         else do:
     1697           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1698           if vRindex2 <= vRindex1
     1699           then
     1700              vRindex2 = vRindex1 + 70.
     1701           assign
     1702             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1703             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1704             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1705           .
     1706         end.
     1707       end.
     1708       B-viewProcInfo:visible   in frame waitfram = no.
     1709       B-viewProcInfo:sensitive in frame waitfram = no.
     1710       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1711       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1712       if  (   mWaitFramView
     1713          or  mWaitProcEvent)
     1714          and not mBatchMode
     1715       then
     1716          display
     1717             v-waitfram-action01 skip
     1718             v-waitfram-action02 skip
     1719             v-waitfram-action03 skip
     1720          with frame waitfram .
     1721       if     mWaitFramView
     1722          then do:
     1723             if     mWaitFramInterval ne ?
     1724                and not mBatchMode
     1725             then
     1726                wait-for go of frame waitfram pause mWaitFramInterval.
     1727          end.
     1728          else
     1729             if     mWaitProcEvent
     1730                and not mBatchMode
     1731             then
     1732                process events .
     1733     end.
     1734   end procedure.
     1735      procedure waitfram-show-this:
     1736         define input  parameter iInterval as int64 no-undo.
     1737         define variable vtime as int64 no-undo.
     1738         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1739         mWaitFramInterval = iInterval.
     1740         run waitfram-show (substitute("&1&2 &3&4" ,
     1741                                       mWaitFramTextBeg ,
     1742                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1743                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1744                                       mWaitFramTextEnd
     1745                                      )
     1746                           ).
     1747      end.
     1748      procedure WaitFramRunPause:
     1749         define input  parameter iInterval as dec no-undo.
     1750         define variable vStart  as datetime-tz no-undo.
     1751         define variable vend    as datetime-tz no-undo.
     1752         define variable vint as int64 no-undo.
     1753         define variable vOk as logical no-undo.
     1754         vStart = now.
     1755         vend   = vStart.
     1756         publish "WaitFramPause" (iInterval,output vOk).
     1757         vend   =  now.
     1758         vint = vend - vStart.
     1759         vint = iInterval - vint / 1000.
     1760         if     not mWaitFramStop
     1761            and (   vint > 0
     1762                 or (    not vOk
     1763                     and iInterval eq ?
     1764                     )
     1765                 )
     1766         then
     1767            run waitfram-show-this (iInterval).
     1768         vend   =  now.
     1769         vint = vend - vStart.
     1770         vint = iInterval - vint / 1000.
     1771         if     not mWaitFramStop
     1772            and vint > 0
     1773         then do:
     1774            run gbl/pause.p (vint * 1000).
     1775         end.
     1776         if iInterval ne ?
     1777         then
     1778            publish "WaitFramStop".
     1779         waitfram-check-timeout().
     1780      end.
     1781      procedure WaitFramWaitFor:
     1782         define input  parameter iInterval as dec no-undo.
     1783         assign
     1784            mWaitFramStartProc   = now
     1785            mWaitFramStopUser    = no
     1786            mWaitFramStopTimeOut = no
     1787         .
     1788         block-wait:
     1789         do while not mWaitFramStop:
     1790            run WaitFramRunPause (iInterval).
     1791            if  waitfram-check-timeout()
     1792            then do:
     1793               leave block-wait.
     1794            end.
     1795         end.
     1796         run waitfram-hide.
     1797      end.
     1798   procedure waitfram-join :
     1799     define input  parameter p-line-1  as character no-undo .
     1800     define input  parameter p-line-2  as character no-undo .
     1801     define input  parameter p-line-3  as character no-undo .
     1802     define output parameter p-message as character no-undo .
     1803     do
     1804     on error undo, return error return-value
     1805     :
     1806       assign
     1807         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1808                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1809                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1810       .
     1811     end.
     1812   end procedure.
     1813   function waitfram-join-function returns character
     1814     (input p-line-1 as character
     1815     ,input p-line-2 as character
     1816     ,input p-line-3 as character
     1817     ).
     1818     define variable v-message as character no-undo .
     1819     run waitfram-join in this-procedure
     1820       (input  p-line-1
     1821       ,input  p-line-2
     1822       ,input  p-line-3
     1823       ,output v-message
     1824       ) .
     1825     return v-message .
     1826   end function .
     1827   define temp-table tt-act-header
     1828       field num           as character        label "№ акта"      format "X(30)"
     1829       field date_         as date             label "Дата акта"
     1830       field is-sent       as logical
     1831       field answer_       as character        label "Ответ"       format "X(1500)"
     1832       field RegID         as character        label "Рег. номер"  format "X(50)"
     1833       index pi as primary unique
     1834           num
     1835   .
     1836   define temp-table tt-gds-act
     1837       field num           as character                label "№ акта"
     1838       field position_     as integer                  label "№ пп"                    format ">>>9"
     1839       field gds-code      like ub.goods.gds-code      label "Код товара   "
     1840       field alc-code      as character                label "Алкогольный код"         format "X(21)"
     1841       field gds-name      like ub.goods.gds-name      label "Наименование товара"     format "X(35)"
     1842       field qnty          as decimal                  label "Количество"
     1843       field inform-B      as character                label "Справка Б"               format "X(20)"
     1844       index pi as primary unique
     1845           position_
     1846       index code
     1847           gds-code
     1848   .
     1849   define variable sw as handle no-undo .
     1850   define variable v-file              as character no-undo initial "TransferFromShop1.xml".
     1851   DEFINE VARIABLE hDoc AS HANDLE NO-UNDO.
     1852   DEFINE VARIABLE hRoot AS HANDLE NO-UNDO.
     1853   DEFINE VARIABLE good AS LOGICAL NO-UNDO.
     1854   procedure makeXML :
     1855       create sax-writer sw .
     1856       sw:formatted = true.
     1857       sw:set-output-destination ("file", v-file).
     1858       sw:encoding = "UTF-8".
     1859       sw:start-document () .
     1860       sw:start-element ("ns:Documents") .
     1861       sw:insert-attribute ("Version", "1.0") .
     1862       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
     1863       sw:insert-attribute ("xmlns:xs", "http://www.w3.org/2001/XMLSchema") .
     1864       sw:insert-attribute ("xmlns:c", "http://fsrar.ru/WEGAIS/Common") .
     1865       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef_v2") .
     1866       sw:insert-attribute ("xmlns:tfs", "http://fsrar.ru/WEGAIS/TransferFromShop") .
     1867           sw:start-element ("ns:Owner") .
     1868               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
     1869           sw:end-element ("ns:Owner") .
     1870           sw:start-element ("ns:Document") .
     1871               sw:start-element ("ns:TransferFromShop") .
     1872                   sw:write-data-element ("tfs:Identity", tt-act-header.num) no-error .
     1873                   sw:start-element ("tfs:Header") .
     1874                       sw:write-data-element ("tfs:TransferNumber", tt-act-header.num) no-error .
     1875                       sw:write-data-element ("tfs:TransferDate", string(iso-date(tt-act-header.date_))) no-error .
     1876                   sw:end-element ("tfs:Header") .
     1877                   sw:start-element ("tfs:Content") .
     1878       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
     1879                       sw:start-element ("tfs:Position") .
     1880                           sw:write-data-element ("tfs:Identity", string(tt-gds-act.position_)) no-error .
     1881                           sw:write-data-element ("tfs:Quantity", string(tt-gds-act.qnty)) no-error .
     1882                           sw:write-data-element ("gds-code", string(tt-gds-act.gds-code)) no-error .
     1883                           sw:write-data-element ("gds-name", tt-gds-act.gds-name) no-error .
     1884                           sw:write-data-element ("alc-code", tt-gds-act.alc-code) no-error .
     1885                           sw:start-element ("tfs:InformB") .
     1886                               sw:write-data-element ("pref:BRegId", tt-gds-act.inform-B) no-error .
     1887                           sw:end-element ("tfs:InformB") .
     1888                       sw:end-element ("tfs:Position") .
     1889       end.
     1890                   sw:end-element ("tfs:Content") .
     1891               sw:end-element ("ns:TransferFromShop") .
     1892           sw:end-element ("ns:Document") .
     1893       sw:end-element ("ns:Documents") .
     1894       sw:end-document () .
     1895       delete object sw.
     1896   end procedure .
     1897   procedure makeXMLegais_v2 :
     1898       create sax-writer sw .
     1899       sw:formatted = true.
     1900       sw:set-output-destination ("file", v-file).
     1901       sw:encoding = "UTF-8".
     1902       sw:start-document () .
     1903       sw:start-element ("ns:Documents") .
     1904       sw:insert-attribute ("Version", "1.0") .
     1905       sw:insert-attribute ("xmlns:ns", "http://fsrar.ru/WEGAIS/WB_DOC_SINGLE_01") .
     1906       sw:insert-attribute ("xmlns:xs", "http://www.w3.org/2001/XMLSchema") .
     1907       sw:insert-attribute ("xmlns:c", "http://fsrar.ru/WEGAIS/Common") .
     1908       sw:insert-attribute ("xmlns:pref", "http://fsrar.ru/WEGAIS/ProductRef_v2") .
     1909       sw:insert-attribute ("xmlns:tfs", "http://fsrar.ru/WEGAIS/TransferFromShop") .
     1910           sw:start-element ("ns:Owner") .
     1911               sw:write-data-element ("ns:FSRAR_ID", v-fs-rar) .
     1912           sw:end-element ("ns:Owner") .
     1913           sw:start-element ("ns:Document") .
     1914               sw:start-element ("ns:TransferFromShop") .
     1915                   sw:write-data-element ("tfs:Identity", tt-act-header.num) .
     1916                   sw:start-element ("tfs:Header") .
     1917                       sw:write-data-element ("tfs:TransferNumber", tt-act-header.num) .
     1918                       sw:write-data-element ("tfs:TransferDate", string(iso-date(tt-act-header.date_))) no-error .
     1919                   sw:end-element ("tfs:Header") .
     1920                   sw:start-element ("tfs:Content") .
     1921       for each tt-gds-act no-lock where tt-gds-act.num = tt-act-header.num :
     1922           if tt-gds-act.qnty <= 0 or trim(tt-gds-act.inform-B) = "" or tt-gds-act.inform-B = ? then next.
     1923                       sw:start-element ("tfs:Position") .
     1924                           sw:write-data-element ("tfs:Identity", string(tt-gds-act.position_)) .
     1925                           sw:write-data-element ("tfs:ProductCode", tt-gds-act.alc-code) no-error .
     1926                           sw:write-data-element ("tfs:Quantity", string(tt-gds-act.qnty)) .
     1927                           sw:start-element ("tfs:InformF2") .
     1928                             sw:write-data-element ("pref:F2RegId", tt-gds-act.inform-B) .
     1929                           sw:end-element ("tfs:InformF2") .
     1930                       sw:end-element ("tfs:Position") .
     1931       end.
     1932                   sw:end-element ("tfs:Content") .
     1933               sw:end-element ("ns:TransferFromShop") .
     1934           sw:end-element ("ns:Document") .
     1935       sw:end-element ("ns:Documents") .
     1936       sw:end-document () .
     1937       delete object sw.
     1938   end procedure .
     1939   procedure parseXML :
     1940       define input parameter inFile as character no-undo .
     1941       empty temp-table tt-act-header .
     1942       empty temp-table tt-gds-act .
     1943       CREATE X-DOCUMENT hDoc.
     1944       CREATE X-NODEREF hRoot.
     1945       hDoc:encoding = 'utf-8'.
     1946       hDoc:LOAD("file", search(inFile),FALSE).
     1947       hDoc:GET-DOCUMENT-ELEMENT(hRoot).
     1948       RUN GetChildren(hRoot, 1).
     1949       DELETE OBJECT hDoc.
     1950       DELETE OBJECT hRoot.
     1951   end procedure .
     1952   procedure GetChildren :
     1953       DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
     1954       DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
     1955       DEFINE VARIABLE i AS INTEGER NO-UNDO.
     1956       DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
     1957       DEFINE VARIABLE hText AS HANDLE NO-UNDO.
     1958       CREATE X-NODEREF hNoderef.
     1959       CREATE X-NODEREF hText .
     1960       REPEAT i = 1 TO hParent:NUM-CHILDREN:
     1961           good = hParent:GET-CHILD(hNoderef,i).
     1962           IF NOT good THEN
     1963               LEAVE.
     1964           IF hNoderef:SUBTYPE <> "element" THEN
     1965               NEXT.
     1966           hNoderef:GET-CHILD(hText, 1) no-error .
     1967           IF hNoderef:NAME = "tfs:Header" THEN do :
     1968               create tt-act-header .
     1969               assign tt-act-header.is-sent = bh-act-header:buffer-field("is-sent"):buffer-value .
     1970           end .
     1971           .
     1972           IF hNoderef:NAME = "tfs:TransferNumber" THEN assign tt-act-header.num    = hText:node-value no-error .
     1973           IF hNoderef:NAME = "tfs:TransferDate" THEN
     1974               assign tt-act-header.date_ = date(substring(hText:node-value, 9, 2) + "/" + substring(hText:node-value, 6, 2) + "/" + substring(hText:node-value, 1, 4)) no-error .
     1975           IF hNoderef:NAME = "tfs:Position" THEN do :
     1976               assign ii = 0 .
     1977               create tt-gds-act .
     1978               assign tt-gds-act.num = tt-act-header.num .
     1979           end.
     1980           IF hNoderef:NAME = "tfs:Identity" THEN assign tt-gds-act.position_ = integer(hText:node-value) no-error .
     1981           IF hNoderef:NAME = "tfs:Quantity" THEN assign tt-gds-act.qnty = decimal(hText:node-value) no-error .
     1982           IF hNoderef:NAME = "pref:BRegId"
     1983           OR hNoderef:NAME = "pref:F2RegId" THEN assign tt-gds-act.inform-B = (hText:node-value) no-error .
     1984           IF hNoderef:NAME = "gds-code"     THEN do :
     1985               assign tt-gds-act.gds-code = integer(hText:node-value) no-error .
     1986               find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code no-error .
     1987               if available buf_goods then assign tt-gds-act.gds-name = buf_goods.gds-name .
     1988           end.
     1989           if hNoderef:NAME = "gds-name" and trim(tt-gds-act.gds-name) = "" then assign tt-gds-act.gds-name = (hText:node-value) no-error .
     1990           IF hNoderef:NAME = "alc-code"
     1991           OR hNoderef:NAME = "tfs:ProductCode"    THEN assign tt-gds-act.alc-code = (hText:node-value) no-error .
     1992           run GetChildren (hNoderef, (level + 1)).
     1993       END.
     1994       DELETE OBJECT hNoderef.
     1995       DELETE OBJECT hText.
     1996   END procedure.
     1997   define new shared temp-table tt-exts
     1998       field ext-rec as recid
     1999       field gds-code as integer
     2000       index pi as primary unique
     2001           ext-rec gds-code
     2002   .
     2003   define variable select-list as longchar no-undo .
     2004   FUNCTION get-mark RETURNS CHARACTER
     2005   (buffer local-gds for tt-gds-act ):
     2006   if lookup (string (recid (local-gds)), select-list) > 0  then return "*".
     2007                                                              else return "".
     2008   end function.
     2009   define menu m-add
     2010       menu-item m-goods   label "по складскому документу"
     2011       menu-item m-one-good label "один товар"
     2012   .
     2013   DEFINE BUTTON b-cancel AUTO-END-KEY
     2014        LABEL "Выход"
     2015        SIZE 15 BY 1.14
     2016        BGCOLOR 8 .
     2017   DEFINE BUTTON b-good
     2018        LABEL "Добавить"
     2019        SIZE 15 BY 1.14
     2020        BGCOLOR 8 .
     2021   DEFINE BUTTON b-alc-code
     2022        LABEL "Выбор алк. кода"
     2023        SIZE 20 BY 1.14 TOOLTIP "Выбрать алкогольный код"
     2024        BGCOLOR 8 .
     2025   DEFINE BUTTON b-del
     2026        LABEL "Удалить строку"
     2027        SIZE 15 BY 1.14 TOOLTIP "Удалить строку акта"
     2028        BGCOLOR 8 .
     2029   DEFINE BUTTON b-save
     2030        LABEL "Сохранить"
     2031        SIZE 15 BY 1.14 TOOLTIP "Сохранить в БД"
     2032        BGCOLOR 8 .
     2033   DEFINE BUTTON b-mark
     2034        LABEL "&*"
     2035        SIZE 3 BY 1.14 .
     2036   DEFINE BUTTON b-sel-all
     2037        LABEL "&+":L
     2038        SIZE 3 BY 1.14 TOOLTIP "Отметить все объекты".
     2039   DEFINE BUTTON b-unmark
     2040        LABEL "&-":L
     2041        SIZE 3 BY 1.14 TOOLTIP "Снять все отметки".
     2042   DEFINE QUERY br-gds-act FOR
     2043         tt-gds-act SCROLLING.
     2044   DEFINE BROWSE br-gds-act
     2045     QUERY br-gds-act  DISPLAY
     2046       get-mark(BUFFER tt-gds-act) COLUMN-LABEL "*"  FORMAT "X(1)":U
     2047       tt-gds-act.position_
     2048       tt-gds-act.gds-code
     2049       tt-gds-act.alc-code
     2050       tt-gds-act.gds-name
     2051       tt-gds-act.qnty
     2052       tt-gds-act.inform-B
     2053     ENABLE
     2054       tt-gds-act.qnty
     2055       tt-gds-act.inform-B
     2056       WITH NO-ROW-MARKERS SEPARATORS SIZE 107 BY 20.2 FIT-LAST-COLUMN.
     2057   DEFINE FRAME Dialog-Frame
     2058       b-cancel at row 1.2 col 2
     2059       b-good at row 1.2 col 32
     2060       b-del at row 1.2 col 47
     2061       b-save at row 1.2 col 17
     2062       b-alc-code at row 1.2 col 62
     2063       tt-act-header.num at row 2.5 col 2 format "X(22)"
     2064       tt-act-header.date_ at row 2.5 col 34
     2065       b-mark AT ROW 4 COL 2
     2066       b-sel-all AT ROW 4 COL 5
     2067       b-unmark AT ROW 4 COL 8
     2068       br-gds-act at row 5.2 col 2
     2069        SPACE(0.5) SKIP(0.5)
     2070       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2071            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2072            TITLE "Акт о возврате продукции из торгового зала на склад" WIDGET-ID 100.
     2073   ASSIGN
     2074          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2075          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2076   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2077   DO:
     2078     APPLY "END-ERROR":U TO SELF.
     2079   END.
     2080   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     2081   DO:
     2082     run proc-b-mark in this-procedure no-error.
     2083   END.
     2084   ON CHOOSE OF b-sel-all IN FRAME Dialog-Frame
     2085   DO:
     2086     assign select-list = "".
     2087     if not available tt-gds-act then return.
     2088     for each tt-gds-act no-lock :
     2089   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2090   define variable v-str-recid12 as character no-undo .
     2091   define variable v-num-entry12 as integer   no-undo .
     2092   assign
     2093     v-str-recid12 = trim( string( recid( tt-gds-act ) , "->>>>>>>>>>>9":U ) )
     2094     v-num-entry12 = lookup( v-str-recid12 , select-list )
     2095   .
     2096   if v-num-entry12 > 0 then do:
     2097     assign
     2098       entry( v-num-entry12, select-list ) = "":U
     2099       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2100     .
     2101   end.
     2102   else do:
     2103     assign
     2104       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid12
     2105     .
     2106   end.
     2107     end.
     2108     br-gds-act:refresh() in frame Dialog-Frame .
     2109   END.
     2110   ON CHOOSE OF b-unmark IN FRAME Dialog-Frame
     2111   DO:
     2112     if not available tt-gds-act then return.
     2113     select-list  = "".
     2114     br-gds-act:refresh() in frame Dialog-Frame .
     2115   END.
     2116   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     2117   DO:
     2118       if p-mode <> 'ПРОСМОТР':U then do :
     2119           message "Все несохранённые данные будут потеряны. Вы уверены, что хотите выйти?"
     2120           view-as alert-box question buttons yes-no update glog.
     2121           if not glog then return no-apply .
     2122       end.
     2123   END.
     2124   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     2125   DO:
     2126       define variable v-tt-rec as recid.
     2127       if available tt-gds-act  AND select-list = ""
     2128       then
     2129       select-list = string( recid( tt-gds-act ) ) .
     2130       if not available tt-gds-act and select-list = "" then do :
     2131           message "Выберите строку" view-as alert-box .
     2132           return no-apply.
     2133       end.
     2134       else
     2135       do ii = 1 to num-entries (select-list) :
     2136         v-tt-rec = integer(entry(ii, select-list)) .
     2137         for first tt-gds-act exclusive-lock where recid(tt-gds-act) = v-tt-rec :
     2138           delete tt-gds-act .
     2139         end.
     2140       end.
     2141       nn = 0 .
     2142       for each tt-gds-act exclusive-lock :
     2143           nn = nn + 1 .
     2144           tt-gds-act.position_ = nn .
     2145       end.
     2146       select-list = "" .
     2147       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2148   END.
     2149   ON "leave" of tt-act-header.num in FRAME Dialog-Frame
     2150   DO:
     2151       define variable prev-num as character no-undo .
     2152       prev-num = tt-act-header.num .
     2153       assign tt-act-header.num .
     2154       for each tt-gds-act exclusive-lock where tt-gds-act.num = prev-num :
     2155           assign tt-gds-act.num = tt-act-header.num .
     2156       end.
     2157   END.
     2158   on choose of b-alc-code IN FRAME Dialog-Frame
     2159   do :
     2160       if not available tt-gds-act then return no-apply .
     2161       run bge/egais-select-alc-code.w (input tt-gds-act.gds-code, output p-ext-rec) .
     2162       find first X_ext-classif no-lock where recid(X_ext-classif) = p-ext-rec no-error .
     2163       if not available X_ext-classif then return no-apply.
     2164       assign tt-gds-act.alc-code = X_ext-classif.charkey_one .
     2165       br-gds-act:refresh() .
     2166   end.
     2167   on row-display of br-gds-act in FRAME Dialog-Frame
     2168   DO :
     2169       exts = 0 .
     2170       for each tt-exts no-lock where tt-exts.gds-code = tt-gds-act.gds-code :
     2171           exts = exts + 1 .
     2172       end.
     2173       if exts > 1 then tt-gds-act.alc-code:bgcolor in browse br-gds-act = yellow_color .
     2174   end.
     2175   on value-changed of br-gds-act IN FRAME Dialog-Frame
     2176   DO :
     2177   if available tt-gds-act then do :
     2178       exts = 0 .
     2179       for each tt-exts no-lock where tt-exts.gds-code = tt-gds-act.gds-code :
     2180           exts = exts + 1 .
     2181       end.
     2182       if exts > 1 then enable b-alc-code WITH FRAME Dialog-Frame.
     2183       else disable b-alc-code WITH FRAME Dialog-Frame.
     2184   end.
     2185   end.
     2186   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     2187   DO:
     2188       assign
     2189           tt-act-header.num
     2190           tt-act-header.date_
     2191       .
     2192       find first tt-gds-act no-error .
     2193       if not available tt-gds-act then do :
     2194           message "В акте нет строк. Сохранение невозможно" view-as alert-box .
     2195           return no-apply.
     2196       end.
     2197       if can-find(tt-gds-act where tt-gds-act.qnty < 1)
     2198       or can-find(tt-gds-act where trim(tt-gds-act.inform-B) = "")
     2199       then do :
     2200           message "Строки, в которых не указана справка Б, и строки, в которых количество меньше 1, не будут учтены при отправке в ЕГАИС!" skip "Продолжить?"
     2201           view-as alert-box question buttons yes-no update glog .
     2202           if not glog then return no-apply.
     2203       end.
     2204       run makeXML in this-procedure no-error.
     2205       if error-status:error then return return-value .
     2206       assign
     2207           v-clob-db-num = ?
     2208           v-int64-id = 0
     2209           v-info = tt-act-header.num + chr(4) + string(tt-act-header.date_) + chr(4) + string(tt-act-header.is-sent) + chr(4) + tt-act-header.answer_
     2210       .
     2211       find first buf_clob-bind exclusive-lock where buf_clob-bind.uniq-key-rec = tt-act-header.num
     2212                                                 and buf_clob-bind.field-name_  = 'egais-tfs':U no-error .
     2213       if available buf_clob-bind then do :
     2214           if p-mode = 'ДОБАВЛЕНИЕ':U then do :
     2215               message "Акт с таким номером уже существует!" view-as alert-box .
     2216               return no-apply .
     2217           end.
     2218           assign
     2219               v-clob-db-num = buf_clob-bind.db-num
     2220               v-int64-id = buf_clob-bind.int64-id
     2221               v-part-num = buf_clob-bind.part-num
     2222           .
     2223           run gbl/file2clb.p ( input 'ИЗМЕНЕНИЕ':U
     2224                     ,input "add-new,yes"
     2225                     ,input ?
     2226                     ,input tt-act-header.num
     2227                     ,input 'egais-tfs':U
     2228                     ,input v-info
     2229                     ,input-output v-part-num
     2230                     ,input 'egais-tfs':U
     2231                     ,input-output v-clob-db-num
     2232                     ,input-output v-int64-id
     2233                     ,input search (v-file)
     2234                     ,input ''
     2235                     ) no-error .
     2236            if error-status:error then message return-value view-as alert-box.
     2237       end.
     2238       else do :
     2239           run gbl/file2clb.p ( input 'ДОБАВЛЕНИЕ':U
     2240                     ,input ",yes"
     2241                     ,input ?
     2242                     ,input tt-act-header.num
     2243                     ,input 'egais-tfs':U
     2244                     ,input v-info
     2245                     ,input-output v-part-num
     2246                     ,input 'egais-tfs':U
     2247                     ,input-output v-clob-db-num
     2248                     ,input-output v-int64-id
     2249                     ,input search (v-file)
     2250                     ,input ''
     2251                     ) no-error .
     2252       end.
     2253       message "Сохранение завершено" view-as alert-box.
     2254   END.
     2255   on choose of menu-item m-goods in menu m-add
     2256   DO:
     2257       run str/all-docs.w
     2258       ( input  parparentproc
     2259        ,input  v-cntxt-host-code-obj
     2260        ,input  v-cntxt-obj-type
     2261        ,input  v-cntxt-obj-code
     2262        ,input  'объект':U
     2263        ,input  'факт':U
     2264        ,input  '?'
     2265        ,input  ?
     2266        ,input  ?
     2267        ,input  "b-sel":U
     2268        ,input  'rv':U
     2269        ,input  false
     2270        ,input  ?
     2271        ,output v-rid-list
     2272       ).
     2273       if v-rid-list = "" or v-rid-list = ?
     2274       then return no-apply.
     2275       find first   buf_trn-doc no-lock where recid(buf_trn-doc) = int(v-rid-list) no-error .
     2276       if error-status :error then return .
     2277       for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code :
     2278           find first buf_goods no-lock where buf_goods.artic      = buf_doc-line.artic
     2279                                          and buf_goods.prod-type  = buf_doc-line.prod-type
     2280                                          and buf_goods.prod-code  = buf_doc-line.prod-code .
     2281           run gds-attr-value(
     2282             buf_goods.gds-code,
     2283             'alcohol-prod':U,
     2284             output par-alcohol,
     2285             output par-type
     2286           ).
     2287           if par-alcohol = "" or par-alcohol = "no" then next .
     2288           for each buf_parts no-lock where buf_parts.artic        = buf_doc-line.artic
     2289                                        and buf_parts.prod-type    = buf_doc-line.prod-type
     2290                                        and buf_parts.prod-code    = buf_doc-line.prod-code
     2291                                        and buf_parts.obj-type     = buf_doc-line.obj-type
     2292                                        and buf_parts.obj-code     = buf_doc-line.obj-code
     2293                                        and buf_parts.out-code     = buf_doc-line.doc-code :
     2294                assign nn = nn + 1 .
     2295                create tt-gds-act .
     2296                assign
     2297                   tt-gds-act.num          = tt-act-header.num
     2298                   tt-gds-act.gds-code     = buf_goods.gds-code
     2299                   tt-gds-act.gds-name     = buf_goods.gds-name
     2300                   tt-gds-act.position_    = nn
     2301                   tt-gds-act.qnty         = buf_parts.fact-qnty / buf_parts.cli-base-rate
     2302                .
     2303                if num-entries(buf_parts.alc-ref-ab-path) = 4 and entry(3, buf_parts.alc-ref-ab-path) <> "" then do :
     2304                    tt-gds-act.alc-code = entry(3, buf_parts.alc-ref-ab-path) .
     2305                end.
     2306                else do :
     2307                    run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     2308                                                       ,input (buffer buf_goods:handle)
     2309                                                       ,output v-gds-uniq-key-rec).
     2310                    find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2311                                                      and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2312                                                      AND X_ext-classif.db-num = 0
     2313                                                      and X_ext-classif.key#_one = buf_goods.gds-code
     2314                                                      and X_ext-classif.key#_two = v-ext-sys
     2315                                                      and X_ext-classif.key#_three = 0
     2316                                                      and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2317                                                      and X_eXt-classif.charkey_two = ""
     2318                                                      and X_eXt-classif.charkey_three = ""
     2319                                                      and X_eXt-classif.nonunique = 0
     2320                                                      no-error .
     2321                    if available X_ext-classif then tt-gds-act.alc-code = X_eXt-classif.charkey_one .
     2322                end.
     2323                if num-entries(buf_parts.alc-ref-ab-path) = 4 and entry(2, buf_parts.alc-ref-ab-path) <> "" then do :
     2324                    tt-gds-act.inform-B = trim(entry(2, buf_parts.alc-ref-ab-path)) .
     2325                end.
     2326           end .
     2327       end .
     2328       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2329   END.
     2330   on choose of menu-item m-one-good in menu m-add
     2331   DO:
     2332       run ref/gds-ref.p
     2333       ( parparentproc
     2334       ,'b-sel,b-add'
     2335       ,?
     2336       ,?
     2337       ,'все':U
     2338       ,?
     2339       ,?
     2340       ,?
     2341       ,?
     2342       ,v-cntxt-obj-type
     2343       ,v-cntxt-obj-code
     2344       ,?
     2345       , output v-rid-list) no-error.
     2346       if v-rid-list = "" or v-rid-list = ?
     2347       then return no-apply.
     2348       find buf_goods where recid (buf_goods) = integer(v-rid-list) no-lock.
     2349       run gds-attr-value(
     2350         buf_goods.gds-code,
     2351         'alcohol-prod':U,
     2352         output par-alcohol,
     2353         output par-type
     2354       ).
     2355       if par-alcohol = "" or par-alcohol = "no" then
     2356       do :
     2357           message "Выбранный товар не является алкогольной продукцией." view-as alert-box.
     2358           return no-apply .
     2359       end.
     2360       run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     2361                                           ,input (buffer buf_goods:handle)
     2362                                           ,output v-gds-uniq-key-rec).
     2363       exts = 0 .
     2364       for each X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2365                                          and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2366                                          AND X_ext-classif.db-num = 0
     2367                                          and X_ext-classif.key#_one = buf_goods.gds-code
     2368                                          and X_ext-classif.key#_two = v-ext-sys
     2369                                          and X_ext-classif.key#_three = 0
     2370                                          and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2371                                          and X_eXt-classif.charkey_two = ""
     2372                                          and X_eXt-classif.charkey_three = ""
     2373                                          and X_eXt-classif.nonunique = 0 :
     2374           find first tt-exts no-lock where tt-exts.ext-rec = recid(x_ext-classif)
     2375                                            and tt-exts.gds-code = buf_goods.gds-code no-error.
     2376           if not available tt-exts then do :
     2377               create tt-exts .
     2378               assign
     2379                   tt-exts.ext-rec = recid(X_ext-classif)
     2380                   tt-exts.gds-code = buf_goods.gds-code
     2381               .
     2382           end.
     2383           exts = exts + 1 .
     2384       end.
     2385       if exts = 0 then do :
     2386           message "Выбранный товар не синхронизирован с ЕГАИС. (Нет алкогольного кода)" view-as alert-box.
     2387           return no-apply.
     2388       end.
     2389       else if exts = 1 then do :
     2390           find first X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2391                                              and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2392                                              AND X_ext-classif.db-num = 0
     2393                                              and X_ext-classif.key#_one = buf_goods.gds-code
     2394                                              and X_ext-classif.key#_two = v-ext-sys
     2395                                              and X_ext-classif.key#_three = 0
     2396                                              and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2397                                              and X_eXt-classif.charkey_two = ""
     2398                                              and X_eXt-classif.charkey_three = ""
     2399                                              and X_eXt-classif.nonunique = 0
     2400                                              .
     2401       end.
     2402       else do :
     2403           run bge/egais-select-alc-code.w (input buf_goods.gds-code, output p-ext-rec) .
     2404           find first X_ext-classif no-lock where recid(X_ext-classif) = p-ext-rec no-error .
     2405           if not available X_ext-classif then return no-apply.
     2406       end.
     2407       nn = nn + 1 .
     2408       create tt-gds-act .
     2409       assign
     2410           tt-gds-act.gds-code         = buf_goods.gds-code
     2411           tt-gds-act.alc-code         = if available X_ext-classif then X_ext-classif.charkey_one else ""
     2412           tt-gds-act.gds-name         = buf_goods.gds-name
     2413           tt-gds-act.num              = tt-act-header.num
     2414           tt-gds-act.position_        = nn
     2415           tt-gds-act.qnty       = 0
     2416       .
     2417       open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2418   END.
     2419   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2420   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2421   MAIN-BLOCK:
     2422   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2423      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2424       assign
     2425           b-good:popup-menu in frame Dialog-Frame = menu m-add:handle
     2426           b-good:menu-mouse = 1
     2427           nn = 0
     2428       .
     2429       empty temp-table tt-exts .
     2430       if p-mode = 'ДОБАВЛЕНИЕ':U then do :
     2431           v-date = substitute ("&1&2&3", string (day (now), "99"), string (month (now), "99"),substring (string(year (now)), 3,2)).
     2432           create tt-act-header .
     2433           assign
     2434               tt-act-header.num = "TFS-" + v-date + '-' + substring(v-cntxt-obj-type,1,1) + string(v-cntxt-obj-code) + '-' + string(int(TIME))
     2435               tt-act-header.date_ = TODAY
     2436               tt-act-header.is-sent = no
     2437           .
     2438           display tt-act-header.num tt-act-header.date_ with frame Dialog-Frame.
     2439           enable  tt-act-header.date_ b-good with frame Dialog-Frame.
     2440       end.
     2441       if p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ПРОСМОТР':U then do :
     2442           find last buf_clob-bind where buf_clob-bind.uniq-key-rec = bh-act-header:buffer-field ("num"):buffer-value
     2443                                     and buf_clob-bind.field-name_ = 'egais-tfs':U
     2444                                     and buf_clob-bind.part-num = 1  .
     2445           find first buf_clob-data no-lock where buf_clob-data.db-num = buf_clob-bind.db-num and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     2446           copy-lob
     2447           from  object buf_clob-data.cdata
     2448           to  file 'temp-tfs.xml'
     2449           no-convert
     2450           no-error .
     2451           run waitfram-show in this-procedure ("Ждите...") .
     2452           run parseXML in this-procedure (input "temp-tfs.xml") .
     2453           run waitfram-hide in this-procedure .
     2454           display tt-act-header.num tt-act-header.date_ with frame Dialog-Frame.
     2455           if p-mode = 'ИЗМЕНЕНИЕ':U then
     2456           for each tt-gds-act no-lock :
     2457               nn = nn + 1 .
     2458               find first buf_goods no-lock where buf_goods.gds-code = tt-gds-act.gds-code no-error .
     2459               if not available buf_goods then do :
     2460                   message "По алкогольному коду " tt-gds-act.alc-code " не найден товар из TH. Вероятно, кто-то удалил связку." view-as alert-box.
     2461                   next.
     2462               end.
     2463               run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     2464                                               ,input (buffer buf_goods:handle)
     2465                                               ,output v-gds-uniq-key-rec).
     2466               for each X_ext-classif no-lock where X_ext-classif.classif-subject = 'goods':U
     2467                                              and X_ext-classif.classif-name = 'exp-esys-gds-code':U
     2468                                              AND X_ext-classif.db-num = 0
     2469                                              and X_ext-classif.key#_one = buf_goods.gds-code
     2470                                              and X_ext-classif.key#_two = v-ext-sys
     2471                                              and X_ext-classif.key#_three = 0
     2472                                              and X_eXt-classif.uniq-key-rec = v-gds-uniq-key-rec
     2473                                              and X_eXt-classif.charkey_two = ""
     2474                                              and X_eXt-classif.charkey_three = ""
     2475                                              and X_eXt-classif.nonunique = 0 :
     2476                   find first tt-exts no-lock where tt-exts.ext-rec = recid(x_ext-classif)
     2477                                            and tt-exts.gds-code = buf_goods.gds-code no-error.
     2478                   if not available tt-exts then do :
     2479                       create tt-exts .
     2480                       assign
     2481                           tt-exts.ext-rec = recid(X_ext-classif)
     2482                           tt-exts.gds-code = tt-gds-act.gds-code
     2483                       .
     2484                   end.
     2485               end.
     2486           end .
     2487           open QUERY br-gds-act FOR each tt-gds-act exclusive-lock .
     2488           if p-mode = 'ПРОСМОТР':U then disable b-good with frame Dialog-Frame.
     2489           else enable b-good with frame Dialog-Frame.
     2490       end.
     2491   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2492   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2493   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2494   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2495   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2496   define variable v-diasize-current-frame-height as decimal   no-undo .
     2497   define variable v-diasize-change-size          as logical   no-undo .
     2498   define variable v-diasize-resize-button        as handle    no-undo .
     2499   define variable v-diasize-wndmax               as logical   no-undo .
     2500   define variable v-diasize-wndstore             as logical   no-undo .
     2501   define variable v-diasize-proc-name            as character no-undo .
     2502   define variable v-diasize-browse-handle        as handle    no-undo .
     2503   define variable v-diasize-browse-number        as integer   no-undo .
     2504   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2505   define temp-table temp-diasize-handle no-undo
     2506     field handle-value  as handle
     2507     field save-position as decimal
     2508     index xpk is primary unique handle-value
     2509     .
     2510   define temp-table temp-browse-handle no-undo
     2511     field browse-type   as character
     2512     field browse-number as integer
     2513     field browse-handle as handle
     2514     field original-size as decimal
     2515     index xpk is primary unique browse-type browse-number
     2516     index xie browse-type browse-handle
     2517   .
     2518   procedure diasize_change-height :
     2519     define input  parameter p-change-value  as decimal   no-undo .
     2520     define input  parameter p-move-resize   as logical   no-undo .
     2521     define variable v-field-group-handle    as handle    no-undo .
     2522     define variable v-object-handle         as handle    no-undo .
     2523     define variable v-frame-height          as decimal   no-undo .
     2524     define variable v-frame-virtual-height  as decimal   no-undo .
     2525     define variable v-browse-height         as decimal   no-undo .
     2526     define variable v-window-height         as decimal   no-undo .
     2527     define variable v-window-virtual-height as decimal   no-undo .
     2528     define variable v-change-sign           as integer   no-undo .
     2529     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2530     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2531     if p-change-value > 0
     2532     then do:
     2533       if frame Dialog-Frame :height + p-change-value
     2534           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2535       then do:
     2536         assign
     2537           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2538                           - (frame Dialog-Frame :height-chars)
     2539         .
     2540         if p-change-value <= 0
     2541         then do:
     2542           run diasize_position-resize-button in this-procedure .
     2543           return .
     2544         end.
     2545       end.
     2546     end.
     2547     if p-change-value < 0
     2548     then do:
     2549       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2550       then do:
     2551         assign
     2552           p-change-value = v-diasize-orig-frame-height
     2553                          - (frame Dialog-Frame :height-chars)
     2554         .
     2555         if p-change-value >= 0
     2556         then do:
     2557           run diasize_position-resize-button in this-procedure .
     2558           return .
     2559         end.
     2560       end.
     2561     end.
     2562     if p-change-value >= 0
     2563     then do:
     2564       assign
     2565         v-change-sign = 1
     2566       .
     2567     end.
     2568     else do:
     2569       assign
     2570         v-change-sign = -1
     2571       .
     2572     end.
     2573     assign
     2574       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2575     .
     2576     if p-change-value = 0
     2577     then do:
     2578       run diasize_position-resize-button in this-procedure .
     2579       return .
     2580     end.
     2581     move_block:
     2582     do
     2583     on error undo move_block, retry move_block
     2584     :
     2585       if retry
     2586       then do:
     2587         do
     2588         on error undo move_block, leave move_block
     2589         :
     2590           if p-change-value > 0
     2591           then do:
     2592             for each buf_temp-diasize-handle
     2593             on error undo, next
     2594             :
     2595               assign
