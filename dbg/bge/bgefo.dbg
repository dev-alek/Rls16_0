        1   block-level on error undo, throw.
        2   define input parameter p-date-from      as date       no-undo.
        3   define input parameter p-date-to        as date       no-undo.
        4   define input parameter p-range          as integer    no-undo.
        5   define input parameter p-obj-list       as character  no-undo.
        6   define input parameter hedt             as handle     no-undo.
        7   define input parameter hcnt             as handle     no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision: 2d6430604525, 1301, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       10   define variable vss-date        as character no-undo init "$date: 18.08.03 18:20 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: bgefo.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: bge/bgefo.p $":U .
       13   define variable vss-description as character no-undo init "Экспорт во Внешнюю Бухгалтерию ФО".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   define  temp-table temp-host no-undo
       85     field host-code like ub.store.host-code
       86     index xpk host-code
       87   .
       88   define  temp-table temp-obj no-undo
       89     field obj-type  like ub.clients.obj-type
       90     field obj-code  like ub.clients.obj-code
       91     field host-code like ub.store.host-code
       92     field db-num    like ub.clients.db-num
       93     index xpk  obj-type obj-code
       94     index xie1 host-code
       95     index xie2 db-num host-code
       96   .
       97   procedure init-temphost:
       98     define buffer buf_store   for ub.store .
       99     define buffer buf_shop    for ub.shop .
      100     define buffer buf_clients for ub.clients .
      101     define buffer buf_db for ub.db .
      102     define buffer buf_temp-host for temp-host .
      103     define buffer buf_temp-obj for temp-obj .
      104     do
      105     on error undo, return error return-value
      106     :
      107       for each buf_store
      108       on error undo, return error
      109       :
      110         find first buf_temp-host
      111           where buf_temp-host.host-code = buf_store.host-code
      112           no-error .
      113         if not available buf_temp-host
      114         then do:
      115           create buf_temp-host .
      116           assign
      117             buf_temp-host.host-code = buf_store.host-code
      118           .
      119         end.
      120         find first buf_clients no-lock
      121           where buf_clients.obj-type = 'скл':U
      122             and buf_clients.obj-code = buf_store.obj-code
      123           no-error .
      124         if not available buf_clients
      125         then do:
      126           message
      127             "Ошибка при поиске клиента" skip
      128             "Клиент" 'скл':U buf_store.obj-code skip
      129             view-as alert-box error .
      130           undo, return error .
      131         end.
      132         create buf_temp-obj .
      133         assign
      134           buf_temp-obj.obj-type  = 'скл':U
      135           buf_temp-obj.obj-code  = buf_store.obj-code
      136           buf_temp-obj.host-code = buf_store.host-code
      137           buf_temp-obj.db-num    = buf_clients.db-num
      138         .
      139       end.
      140       for each buf_shop
      141       on error undo, return error
      142       :
      143         find first buf_temp-host
      144           where buf_temp-host.host-code = buf_shop.host-code
      145           no-error .
      146         if not available buf_temp-host
      147         then do:
      148           create buf_temp-host .
      149           assign
      150             buf_temp-host.host-code = buf_shop.host-code
      151           .
      152         end.
      153         find first buf_clients no-lock
      154           where buf_clients.obj-type = 'маг':U
      155             and buf_clients.obj-code = buf_shop.obj-code
      156           no-error .
      157         if not available buf_clients then do:
      158           message
      159             "Ошибка при поиске клиента" skip
      160             "Клиент" 'маг':U buf_shop.obj-code skip
      161             view-as alert-box error .
      162           undo, return error .
      163         end.
      164         create buf_temp-obj .
      165         assign
      166           buf_temp-obj.obj-type  = 'маг':U
      167           buf_temp-obj.obj-code  = buf_shop.obj-code
      168           buf_temp-obj.host-code = buf_shop.host-code
      169           buf_temp-obj.db-num    = buf_clients.db-num
      170         .
      171       end.
      172     end.
      173   end.
      174   define variable vss-include-info1 as character format "X(65)" no-undo
      175   initial "@(#)$Workfile$ $Revision$".
      176   define variable v-bgelib-bgefmt        as character         no-undo.
      177   define variable v-bgelib-bgeflold      as character         no-undo.
      178   define stream stmXMLOut.
      179   define stream stmXMLLog.
      180   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      181   procedure cur-time :
      182      define output parameter p-today as date      no-undo .
      183      define output parameter p-time  as integer   no-undo .
      184     do
      185     on error undo, return error
      186     :
      187       define variable v-date1 as date      no-undo .
      188       define variable v-date2 as date      no-undo .
      189       define variable v-time  as integer   no-undo .
      190       assign
      191         v-date1 = today
      192         v-time  = time
      193         v-date2 = today
      194       .
      195       if v-date1 <> v-date2
      196       then do:
      197         assign
      198           v-date1 = today
      199           v-time  = v-time
      200         .
      201       end.
      202       assign
      203         p-today = v-date1
      204         p-time  = v-time
      205       .
      206     end.
      207   end.
      208   function cur-time-date returns character
      209   :
      210     return string(today, '99/99/9999':U) .
      211   end.
      212   function cur-time-mjd returns decimal
      213   :
      214     define variable v-date as date      no-undo .
      215     define variable v-time as integer   no-undo .
      216     run cur-time in this-procedure
      217       (output v-date
      218       ,output v-time
      219       ) .
      220     return integer(v-date) - 2400002 + (v-time / 86400) .
      221   end.
      222   function cur-time-get-ending-index returns integer
      223   (input p-number as integer
      224   )
      225   :
      226     if p-number < 0
      227     or p-number = ?
      228     then do:
      229       return 1 .
      230     end.
      231     define variable v-rest as integer   no-undo .
      232     assign
      233       p-number = p-number modulo 100
      234     .
      235     if p-number < 20
      236     then do:
      237       assign
      238         v-rest = p-number
      239       .
      240     end.
      241     else do:
      242       assign
      243         v-rest = p-number modulo 10
      244       .
      245     end.
      246     case v-rest :
      247       when 1
      248       then do:
      249         return 2 .
      250       end.
      251       when 2 or
      252       when 3 or
      253       when 4
      254       then do:
      255         return 3 .
      256       end.
      257       otherwise do:
      258         return 1 .
      259       end.
      260     end case .
      261   end.
      262   procedure cur-time-mjd-to-date :
      263      define input  parameter i-mjd-diff as decimal no-undo.
      264      define output parameter o-Date     as date    no-undo.
      265      define output parameter o-Time     as integer no-undo.
      266      define variable v-day-number as integer   no-undo .
      267      if    i-mjd-diff < 0
      268         or i-mjd-diff = ?
      269      then do:
      270         return "?" .
      271      end.
      272      assign
      273         v-day-number = truncate(i-mjd-diff,0).
      274         o-Date = date(v-day-number + 2400002).
      275         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      276     .
      277   end.
      278   function cur-time-mjd-to-string returns character
      279   (input p-mjd-diff as decimal
      280   )
      281   :
      282     define variable v-day-number as integer   no-undo .
      283     define variable v-seconds    as integer   no-undo .
      284     define variable v-hour       as integer   no-undo .
      285     define variable v-min        as integer   no-undo .
      286     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      287     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      288     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      289     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      290     if p-mjd-diff < 0
      291     or p-mjd-diff = ?
      292     then do:
      293       return "?" .
      294     end.
      295     assign
      296       v-day-number = integer(truncate(p-mjd-diff,0))
      297       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      298     .
      299     if v-seconds > 86400
      300     then do:
      301       assign
      302         v-seconds = 86400 - 1
      303       .
      304     end.
      305     if v-seconds < 0
      306     then do:
      307       assign
      308         v-seconds = 0
      309       .
      310     end.
      311     assign
      312       v-hour = truncate(v-seconds / 3600, 0)
      313     .
      314     assign
      315       v-seconds = v-seconds modulo 3600
      316     .
      317     assign
      318       v-min = truncate(v-seconds / 60, 0)
      319     .
      320     assign
      321       v-seconds = v-seconds modulo 60
      322     .
      323     return
      324         (if v-day-number <> 0
      325           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      326           else ""
      327         )
      328       + (if v-day-number <> 0 or v-hour <> 0
      329           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      330           else ""
      331         )
      332       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      333           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      334           else ""
      335         )
      336       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      337       .
      338   end.
      339   function cur-time-string returns character
      340   :
      341     define variable v-date as date      no-undo .
      342     define variable v-time as integer   no-undo .
      343     run cur-time in this-procedure
      344       (output v-date
      345       ,output v-time
      346       ) .
      347     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      348   end.
      349   function cur-time-string-sec returns character
      350   :
      351     define variable v-date as date      no-undo .
      352     define variable v-time as integer   no-undo .
      353     run cur-time in this-procedure
      354       (output v-date
      355       ,output v-time
      356       ) .
      357     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      358   end.
      359   function cur-time-custom  returns character
      360   (input p-prefix as character
      361   ,input p-date-format as character
      362   ,input p-delimiter as character
      363   ,input p-time-format as character
      364   ,input p-suffix as character
      365   )
      366   :
      367     define variable v-date as date      no-undo .
      368     define variable v-time as integer   no-undo .
      369     run cur-time in this-procedure
      370       (output v-date
      371       ,output v-time
      372       ) .
      373     return
      374       p-prefix
      375       + string(v-date, p-date-format)
      376       + p-delimiter
      377       + string(v-time, p-time-format)
      378       + p-suffix
      379       .
      380   end.
      381   function cur-time-print  returns character
      382   :
      383     define variable v-date as date      no-undo .
      384     define variable v-time as integer   no-undo .
      385     run cur-time in this-procedure
      386       (output v-date
      387       ,output v-time
      388       ) .
      389     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      390   end.
      391   function cur-time-datetime returns datetime
      392   :
      393     define variable v-char as character no-undo .
      394     define variable v-datetime as datetime no-undo .
      395     v-char = cur-time-string().
      396     v-datetime = datetime(v-char).
      397     return  v-datetime.
      398   end.
      399   function cur-time-string-msec returns character
      400   :
      401     define variable v-date as datetime  no-undo .
      402     v-date = now.
      403     return string(v-date) .
      404   end.
      405   define variable vss-include-info3 as character format "X(65)" no-undo
      406   initial "@(#)$Workfile$ $Revision$".
      407   procedure xmlchar-test :
      408   define input parameter p-in-string          as character        no-undo.
      409   define output parameter p-out-string-enc    as character        no-undo.
      410   define output parameter p-out-string-dec    as character        no-undo.
      411   do
      412   on error undo, return error
      413   :
      414          run xmlchar-encode in this-procedure
      415       (
      416             input p-in-string
      417           , output p-out-string-enc
      418       ).
      419          run xmlchar-decode in this-procedure
      420       (
      421             input p-out-string-enc
      422           , output p-out-string-dec
      423       ).
      424   end.
      425   end .
      426   procedure xmlchar-encode :
      427   define input parameter p-in-string      as character        no-undo.
      428   define output parameter p-out-string    as character        no-undo.
      429       define variable v-position      as integer      no-undo.
      430       define variable v-current-char  as character    no-undo.
      431   do
      432   on error undo, return error
      433   :
      434       assign
      435           p-out-string = "":U
      436       .
      437       case p-in-string
      438       :
      439           when ?
      440           then do:
      441               assign
      442                   p-out-string = "?":U
      443               .
      444           end.
      445           when "?":U
      446           then do:
      447               assign
      448                   p-out-string = "&#63;":U
      449               .
      450           end.
      451           otherwise do:
      452               do v-position = 1 to length( p-in-string )
      453               :
      454                   assign
      455                       v-current-char = substring( p-in-string, v-position, 1 )
      456                   .
      457                   case v-current-char
      458                   :
      459                       when "&":U
      460                       then do:
      461                           assign
      462                               p-out-string = p-out-string + "&amp;":U
      463                           .
      464                       end.
      465                       when ">":U
      466                       then do:
      467                           assign
      468                               p-out-string = p-out-string + "&gt;":U
      469                           .
      470                       end.
      471                       when "<":U
      472                       then do:
      473                           assign
      474                               p-out-string = p-out-string + "&lt;":U
      475                           .
      476                       end.
      477                       when "'":U
      478                       then do:
      479                           assign
      480                               p-out-string = p-out-string + "&apos;":U
      481                           .
      482                       end.
      483                       when '"':U
      484                       then do:
      485                           assign
      486                               p-out-string = p-out-string + "&quot;":U
      487                           .
      488                       end.
      489                       when chr(1)
      490                       then do:
      491                           assign
      492                               p-out-string = p-out-string + "":U
      493                           .
      494                       end.
      495                       when chr(2)
      496                       then do:
      497                           assign
      498                               p-out-string = p-out-string + "":U
      499                           .
      500                       end.
      501                       when chr(3)
      502                       then do:
      503                           assign
      504                               p-out-string = p-out-string + "":U
      505                           .
      506                       end.
      507                       when chr(4)
      508                       then do:
      509                           assign
      510                               p-out-string = p-out-string + "":U
      511                           .
      512                       end.
      513                       when chr(5)
      514                       then do:
      515                           assign
      516                               p-out-string = p-out-string + "":U
      517                           .
      518                       end.
      519                       when chr(6)
      520                       then do:
      521                           assign
      522                               p-out-string = p-out-string + "":U
      523                           .
      524                       end.
      525                       when chr(7)
      526                       then do:
      527                           assign
      528                               p-out-string = p-out-string + "":U
      529                           .
      530                       end.
      531                       when chr(8)
      532                       then do:
      533                           assign
      534                               p-out-string = p-out-string + "":U
      535                           .
      536                       end.
      537                       when chr(9)
      538                       then do:
      539                           assign
      540                               p-out-string = p-out-string + "":U
      541                           .
      542                       end.
      543                       when chr(29)
      544                       then do:
      545                           assign
      546                               p-out-string = p-out-string + "":U
      547                           .
      548                       end.
      549                       when chr(10)
      550                       then do:
      551                           assign
      552                               p-out-string = p-out-string + "&#10;":U
      553                           .
      554                       end.
      555                       when chr(13)
      556                       then do:
      557                           assign
      558                               p-out-string = p-out-string + "&#13;":U
      559                           .
      560                       end.
      561                       otherwise do:
      562                           assign
      563                               p-out-string = p-out-string + v-current-char
      564                           .
      565                       end.
      566                   end case.
      567               end.
      568           end.
      569       end case.
      570   end.
      571   end .
      572   procedure xmlchar-encode-1c :
      573   define input parameter p-in-string      as character        no-undo.
      574   define output parameter p-out-string    as character        no-undo.
