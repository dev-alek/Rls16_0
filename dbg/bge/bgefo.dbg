      644                               p-out-string = p-out-string + " ":U
      645                           .
      646                       end.
      647                       when chr(9)
      648                       then do:
      649                           assign
      650                               p-out-string = p-out-string + " ":U
      651                           .
      652                       end.
      653                       when chr(29)
      654                       then do:
      655                           assign
      656                               p-out-string = p-out-string + " ":U
      657                           .
      658                       end.
      659                       when chr(10)
      660                       then do:
      661                           assign
      662                               p-out-string = p-out-string + " ":U
      663                           .
      664                       end.
      665                       when chr(13)
      666                       then do:
      667                           assign
      668                               p-out-string = p-out-string + " ":U
      669                           .
      670                       end.
      671                       otherwise do:
      672                           assign
      673                               p-out-string = p-out-string + v-current-char
      674                           .
      675                       end.
      676                   end case.
      677               end.
      678           end.
      679       end case.
      680   end.
      681   end .
      682   procedure xmlchar-decode :
      683   define input parameter p-in-string      as character        no-undo.
      684   define output parameter p-out-string    as character        no-undo.
      685       define variable v-position      as integer      no-undo.
      686       define variable v-last-position as integer      no-undo.
      687       define variable v-temp-integer  as integer      no-undo.
      688       define variable v-current-char  as character    no-undo.
      689       define variable v-next-char     as character    no-undo.
      690       define variable v-success       as logical      no-undo.
      691   do
      692   on error undo, return error
      693   :
      694       assign
      695           p-out-string = "":U
      696           v-position   = 0
      697       .
      698       replace-cycle:
      699       do while yes
      700       on error undo, return error
      701       :
      702           assign
      703               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      704           .
      705           if v-last-position <= v-position
      706           then do:
      707               if v-position = 0
      708               then do:
      709                   assign
      710                       p-out-string = p-in-string
      711                   .
      712               end.
      713               else do:
      714                   assign
      715                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      716                   .
      717               end.
      718               leave replace-cycle.
      719           end.
      720           else do:
      721               assign
      722                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      723                   v-position      = v-last-position
      724                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      725               .
      726               if v-current-char = "#":U
      727               then do:
      728                   assign
      729                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      730                   .
      731                   if v-last-position > 0
      732                   then do:
      733                       run xmlchar-read-integer in this-procedure
      734                        (
      735                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      736                           , output v-temp-integer
      737                           , output v-success
      738                       ).
      739                       if v-success = yes
      740                       and v-temp-integer >= 1
      741                       and v-temp-integer <= 255
      742                       then do:
      743                           assign
      744                               p-out-string = p-out-string + chr( v-temp-integer )
      745                               v-position   = v-last-position + 1
      746                           .
      747                       end.
      748                       else do:
      749                           assign
      750                               p-out-string = p-out-string + "&":U
      751                               v-position   = v-position   + 1
      752                           .
      753                       end.
      754                   end.
      755                   else do:
      756                       assign
      757                           p-out-string = p-out-string + "&":U
      758                           v-position   = v-position   + 1
      759                       .
      760                   end.
      761               end.
      762               else do:
      763                   case substring( p-in-string, v-position + 1, 3 )
      764                   :
      765                       when "lt;":U
      766                       then do:
      767                           assign
      768                               p-out-string = p-out-string + "<":U
      769                               v-position   = v-position   + 3
      770                           .
      771                       end.
      772                       when "gt;":U
      773                       then do:
      774                           assign
      775                               p-out-string = p-out-string + ">":U
      776                               v-position   = v-position   + 3
      777                           .
      778                       end.
      779                       otherwise do:
      780                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      781                           then do:
      782                               assign
      783                                   p-out-string = p-out-string + "&":U
      784                                   v-position   = v-position   + 4
      785                               .
      786                           end.
      787                           else do:
      788                               case substring( p-in-string, v-position + 1, 5 )
      789                               :
      790                                   when "quot;":U
      791                                   then do:
      792                                       assign
      793                                           p-out-string = p-out-string + '"':U
      794                                           v-position   = v-position   + 5
      795                                       .
      796                                   end.
      797                                   when "apos;":U
      798                                   then do:
      799                                       assign
      800                                           p-out-string = p-out-string + "'":U
      801                                           v-position   = v-position   + 5
      802                                       .
      803                                   end.
      804                                   otherwise do:
      805                                       assign
      806                                           p-out-string = p-out-string + "&":U
      807                                       .
      808                                   end.
      809                               end case.
      810                           end.
      811                       end.
      812                   end case.
      813               end.
      814           end.
      815       end.
      816   end.
      817   end .
      818   procedure xmlchar-read-integer :
      819   define input parameter p-input-string      as character        no-undo.
      820   define output parameter p-output-integer   as integer          no-undo.
      821   define output parameter p-success       as logical          no-undo.
      822   do
      823   on error undo, return error
      824   :
      825       assign
      826           p-output-integer = integer( p-input-string )
      827       no-error.
      828       if error-status :error
      829       then do:
      830           assign
      831               p-success           = no
      832               p-output-integer    = 0
      833           .
      834       end.
      835       else do:
      836           assign
      837               p-success           = yes
      838           .
      839       end.
      840   end.
      841   end.
      842   define variable v-bgelib-bgeclall           as logical      no-undo.
      843   define variable v-bgelib-bgedict            as logical      no-undo.
      844   define temp-table temp_ext-doc-type no-undo
      845       field edt-key               as integer
      846       field ext-doc-type          as character
      847       field ext-doc-type-label    as character
      848       index pi is primary unique
      849           edt-key
      850   .
      851   define temp-table temp_bgelib_goods no-undo
      852       field gds-code as integer
      853       index pi is primary unique
      854           gds-code
      855   .
      856   define temp-table temp_bgelib_clients no-undo
      857       field obj-type as character
      858       field obj-code as integer
      859       index pi is primary unique
      860           obj-type
      861           obj-code
      862   .
      863   define temp-table temp_bgelib_dis-card no-undo
      864       field d-card as character
      865       index pi is primary unique
      866           d-card
      867   .
      868   define temp-table temp_bgelib_trn-doc no-undo
      869       field doc-code as integer
      870   .
      871   procedure bgelib-tag-open:
      872   do
      873   on error undo, return error
      874   :
      875   define input parameter v-tag-level  as integer      no-undo.
      876   define input parameter v-tag-name   as character    no-undo.
      877   define input parameter v-tag-value  as character    no-undo.
      878       put stream stmXMLOut unformatted
      879           chr(10)
      880           + fill(" ", 4 * v-tag-level)
      881           + "<" + v-tag-name
      882           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      883           + v-tag-value + ">"
      884       .
      885   end.
      886   end procedure.
      887   procedure bgelib-tag-put:
      888   do
      889   on error undo, return error
      890   :
      891   define input parameter v-tag-level      as integer      no-undo.
      892   define input parameter v-tag-name       as character    no-undo.
      893   define input parameter v-tag-value      as character    no-undo.
      894   define input parameter v-empty-mode     as integer      no-undo.
      895       v-tag-name = trim(v-tag-name).
      896       if  v-empty-mode = 1
      897       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      898       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      899       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      900       then do:
      901           run xmlchar-encode in this-procedure (
      902                 input v-tag-value
      903               , output v-tag-value
      904           ).
      905           put stream stmXMLOut unformatted
      906               chr(10) + fill(" ", 4 * v-tag-level)
      907                           + '<' + v-tag-name + '>'
      908                           + v-tag-value
      909                           + '</' + v-tag-name + '>'
      910           .
      911       end.
      912   end.
      913   end procedure.
      914   procedure bgelib-tag-close:
      915   do
      916   on error undo, return error
      917   :
      918   define input parameter v-tag-level as integer      no-undo.
      919   define input parameter v-tag-name  as character    no-undo.
      920       put stream stmXMLOut unformatted
      921           chr(10)
      922           + fill( " ", 4 * v-tag-level)
      923           + '</' + v-tag-name + '>'
      924       .
      925   end.
      926   end procedure.
      927   procedure bgelib-write-log:
      928   do
      929   on error undo, return error
      930   :
      931   define input parameter v-filename   as character    no-undo.
      932   define input parameter v-log-level  as integer      no-undo.
      933   define input parameter v-out-string as character    no-undo.
      934       output stream stmXMLLog to value( v-filename ) append.
      935       put stream stmXMLLog unformatted
      936           chr(10)
      937       .
      938       put stream stmXMLLog unformatted
      939           ( if v-log-level = 0
      940             or v-out-string = "&DLine"
      941             or v-out-string = "&Line"
      942             then ""
      943             else cur-time-string-sec() + " " )
      944       .
      945       put stream stmXMLLog unformatted
      946           ( if v-out-string = "&Line"
      947             then fill( "-", 80 )
      948             else if v-out-string = "&DLine"
      949                  then fill( "=", 80 )
      950                  else v-out-string )
      951       .
      952       output stream stmXMLLog close.
      953   end.
      954   end procedure.
      955   procedure bgelib-write-edt:
      956   do
      957   on error undo, return error
      958   :
      959   define input parameter v-editor-handle    as handle       no-undo.
      960   define input parameter v-log-level        as integer      no-undo.
      961   define input parameter v-out-string       as character    no-undo.
      962       if valid-handle ( v-editor-handle )
      963       then do:
      964           v-editor-handle :move-to-eof().
      965           v-editor-handle :insert-string( ( if v-log-level = 0
      966                                             or v-out-string = "&DLine"
      967                                             or v-out-string = "&Line"
      968                                             then ""
      969                                             else cur-time-string-sec() + " "
      970                                         ) ).
      971           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      972                                             then fill( "-", 80 )
      973                                             else if v-out-string = "&DLine" then fill("=", 80)
      974                                             else fill( " ", v-log-level) + v-out-string
      975                                         ) ).
      976           v-editor-handle :insert-string( chr(10) ).
      977       end.
      978       process events.
      979       output to 'bgescn.txt' append.
      980           put unformatted
      981               chr(10)
      982               string( ( if v-log-level = 0
      983                         or v-out-string = "&DLine"
      984                         or v-out-string = "&Line"
      985                         then ""
      986                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      987                     ) )
      988               string( ( if v-out-string = "&Line"
      989                         then fill( "-", 80 )
      990                         else if v-out-string = "&DLine"
      991                              then fill( "=", 80 )
      992                              else fill( " ", v-log-level ) + v-out-string
      993                     ) )
      994           .
      995       output close.
      996   end.
      997   end procedure.
      998   procedure bgelib-show-cnt:
      999   do
     1000   on error undo, return error
     1001   :
     1002   define input parameter v-fillin-handle     as handle   no-undo.
     1003       if valid-handle( v-fillin-handle )
     1004       then do:
     1005           assign
     1006               v-fillin-handle :visible = true
     1007           .
     1008       end.
     1009   end.
     1010   end procedure.
     1011   procedure bgelib-hide-cnt:
     1012   do
     1013   on error undo, return error
     1014   :
     1015   define input parameter v-fillin-handle     as handle   no-undo.
     1016       if valid-handle( v-fillin-handle )
     1017       then do:
     1018           assign v-fillin-handle :visible = false.
     1019       end.
     1020   end.
     1021   end procedure.
     1022   procedure bgelib-write-cnt:
     1023   do
     1024   on error undo, return error
     1025   :
     1026   define input parameter v-fillin-handle    as handle       no-undo.
     1027   define input parameter v-fillin-string    as character    no-undo.
     1028       if valid-handle( v-fillin-handle )
     1029       then do:
     1030           assign
     1031               v-fillin-handle :SCREEN-value = v-fillin-string
     1032           .
     1033       end.
     1034   end.
     1035   end procedure.
     1036   procedure bgelib-write-header:
     1037   do
     1038   on error undo, return error
     1039   :
     1040   define input parameter p-first-file     as logical      no-undo.
     1041   define input parameter p-xml-file-name  as character    no-undo.
     1042   define input parameter p-list-file-name as character    no-undo.
     1043   define input parameter p-file-number    as integer      no-undo.
     1044   define input parameter p-have-prev      as logical      no-undo.
     1045   define input parameter p-prev-filename  as character    no-undo.
     1046   define input parameter p-obj-list       as character    no-undo.
     1047   define input parameter p-doc-type-list  as character    no-undo.
     1048   define input parameter p-parameter-list as character    no-undo.
     1049       define variable v-counter    as integer        no-undo.
     1050       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1051       put stream stmXMLOut unformatted
     1052           "<?xml version='1.0' encoding='windows-1251'?>"
     1053       .
     1054       run bgelib-tag-open( input 0, input "root"  , input "" ).
     1055       run bgelib-tag-open( input 0, input "header", input "" ).
     1056       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1057       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1058       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1059       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1060       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     1061       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1062       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1063       :
     1064           run bgelib-tag-put(
     1065                 input 1
     1066               , input entry( 2 * v-counter, p-parameter-list )
     1067               , input entry( 2 * v-counter + 1, p-parameter-list )
     1068               , input 0
     1069           ).
     1070       end.
     1071       run bgelib-tag-close( input 0, input "header" ).
     1072       output stream stmXMLOut close.
     1073       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1074       if p-first-file = yes
     1075       then do:
     1076           put stream stmXMLOut unformatted
     1077               "<?xml version='1.0' encoding='windows-1251'?>"
     1078           .
     1079           run bgelib-tag-open( input 0, input "export", input "" ).
     1080       end.
     1081       run bgelib-tag-open( input 1, input "file", input "" ).
     1082       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1083       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1084       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1085       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1086       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1087       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1088       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1089       :
     1090           run bgelib-tag-put(
     1091                 input 2
     1092               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1093               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1094               , input 0
     1095           ).
     1096       end.
     1097       run bgelib-tag-close( input 1, input "file" ).
     1098       output stream stmXMLOut close.
     1099   end.
     1100   end procedure.
     1101   procedure bgelib-write-footer:
     1102   do
     1103   on error undo, return error
     1104   :
     1105   define input parameter p-last-file      as logical      no-undo.
     1106   define input parameter p-xml-file-name  as character    no-undo.
     1107   define input parameter p-list-file-name as character    no-undo.
     1108   define input parameter p-have-next      as logical      no-undo.
     1109   define input parameter p-next-file-name as character    no-undo.
     1110       define variable v-error-num     as integer           no-undo.
     1111       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1112       if p-have-next = yes
     1113       then do:
     1114           run bgelib-tag-open( input 0, input "footer", "" ).
     1115           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1116           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1117           run bgelib-tag-close( input 0, input "footer" ).
     1118       end.
     1119       run bgelib-tag-close( input 0, input "root" ).
     1120       output stream stmXMLOut close.
     1121       run bge/os_copy.p (
     1122             input "M"
     1123           , input p-xml-file-name + "tmp"
     1124           , input p-xml-file-name + "xml"
     1125           , output v-error-num
     1126       ).
     1127       if p-last-file = yes
     1128       then do:
     1129           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1130               run bgelib-tag-close( input 0, input "export" ).
     1131           output stream stmXMLOut close.
     1132           run bge/os_copy.p (
     1133                 input "M"
     1134               , input p-list-file-name + "tmp"
     1135               , input p-list-file-name + "xml"
     1136               , output v-error-num
     1137           ).
     1138       end.
     1139   end.
     1140   end procedure.
     1141   procedure bgelib-filename :
     1142   do
     1143   on error undo, return error
     1144   :
     1145   define input parameter p-prefix             as character    no-undo.
     1146   define output parameter p-xml-file-name     as character    no-undo.
     1147   define output parameter p-log-file-name     as character    no-undo.
     1148   define output parameter p-list-file-name    as character    no-undo.
     1149       define variable v-home-dir  as character    no-undo.
     1150       define variable v-error-num as integer      no-undo.
     1151       get-key-value section "BGE" key "outdir" value v-home-dir.
     1152       if v-home-dir = ?
     1153       then do:
     1154           message
     1155             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1156             skip(1)
     1157             skip "Обратитесь к администратору."
     1158           view-as alert-box error.
     1159           undo, return error .
     1160       end.
     1161       run gbl/dir-cre.p (
     1162           input v-home-dir
     1163       ) no-error.
     1164       if error-status :error
     1165       then do:
     1166           message
     1167             skip "Неверно задан каталог экспорта."
     1168             skip(1)
     1169             skip "Обратитесь к администратору."
     1170           view-as alert-box error.
     1171           undo, return error .
     1172       end.
     1173       run bge/genfname.p (
     1174             input v-home-dir
     1175           , input p-prefix
     1176           , input ""
     1177           , input "xml"
     1178           , input "tmp"
     1179           , output p-xml-file-name
     1180       ).
     1181       assign
     1182           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1183           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1184           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1185       .
     1186   end.
     1187   end procedure.
     1188   procedure bgelib-read-config :
     1189   do
     1190   on error undo, return error
     1191   :
     1192   define variable v-par-type as character     no-undo.
     1193     define variable v-param-type      as character  no-undo .
     1194     define variable v-value-character as character  no-undo .
     1195     define variable v-value-date      as date       no-undo .
     1196     define variable v-value-decimal   as decimal    no-undo .
     1197     define variable v-value-integer   as integer    no-undo .
     1198     define variable v-value-logical   as logical    no-undo .
     1199     define variable v-tth             as handle     no-undo .
     1200       assign
     1201           v-bgelib-bgeclall = no
     1202           v-bgelib-bgedict  = no
     1203       .
     1204       run adm/shattri.p ( input "get":U
     1205                         , input  '':u
     1206                         , input  0
     1207                         , input  'bge-export':U
     1208                         , input  'bgeclall':U
     1209                         , output v-value-character
     1210                         , output v-value-date
     1211                         , output v-value-decimal
     1212                         , output v-value-integer
     1213                         , output v-value-logical
     1214                         , output v-param-type
     1215                         , input-output table-handle v-tth
     1216                         ) no-error .
     1217       if error-status :error
     1218       then do:
     1219         assign
     1220           v-bgelib-bgeclall = no
     1221         .
     1222       end.
     1223       else do:
     1224         assign
     1225           v-bgelib-bgeclall = v-value-logical
     1226         .
     1227       end.
     1228       delete object v-tth.
     1229       run adm/shattri.p ( input "get":U
     1230                         , input  '':u
     1231                         , input  0
     1232                         , input  'bge-export':U
     1233                         , input  'bgedict':U
     1234                         , output v-value-character
     1235                         , output v-value-date
     1236                         , output v-value-decimal
     1237                         , output v-value-integer
     1238                         , output v-value-logical
     1239                         , output v-param-type
     1240                         , input-output table-handle v-tth
     1241                         ) no-error .
     1242       if error-status :error
     1243       then do:
     1244         assign
     1245           v-bgelib-bgedict = no
     1246         .
     1247       end.
     1248       else do:
     1249         assign
     1250           v-bgelib-bgedict = v-value-logical
     1251         .
     1252       end.
     1253       delete object v-tth.
     1254       run adm/shattri.p ( input "get":U
     1255                         , input  '':u
     1256                         , input  0
     1257                         , input  'bge-export':U
     1258                         , input  'bgefmt':U
     1259                         , output v-value-character
     1260                         , output v-value-date
     1261                         , output v-value-decimal
     1262                         , output v-value-integer
     1263                         , output v-value-logical
     1264                         , output v-param-type
     1265                         , input-output table-handle v-tth
     1266                         ) no-error .
     1267       if error-status :error
     1268       then do:
     1269         assign
     1270           v-bgelib-bgefmt  = "xml":U
     1271         .
     1272       end.
     1273       else do:
     1274         assign
     1275           v-bgelib-bgefmt  = v-value-character
     1276         .
     1277       end.
     1278       delete object v-tth.
     1279       run adm/shattri.p ( input "get":U
     1280                         , input  '':u
     1281                         , input  0
     1282                         , input  'bge-export':U
     1283                         , input  'bgeflold':U
     1284                         , output v-value-character
     1285                         , output v-value-date
     1286                         , output v-value-decimal
     1287                         , output v-value-integer
     1288                         , output v-value-logical
     1289                         , output v-param-type
     1290                         , input-output table-handle v-tth
     1291                         ) no-error .
     1292       if error-status :error
     1293       then do:
     1294         assign
     1295           v-bgelib-bgeflold  = "old":U
     1296         .
     1297       end.
     1298       else do:
     1299         assign
     1300           v-bgelib-bgeflold  = v-value-character
     1301         .
     1302       end.
     1303       delete object v-tth.
     1304   end.
     1305   end procedure.
     1306   procedure bgelib-check-file-size :
     1307   do
     1308   on error undo, return error
     1309   :
     1310   define input parameter p-out-filename   as character    no-undo.
     1311   define output parameter p-is-big        as logical      no-undo.
     1312       define variable v-current-position    as integer        no-undo.
     1313       assign
     1314           v-current-position = seek( stmXMLOut )
     1315       .
     1316       if v-current-position / 1024 / 1024  >= 100
     1317       then do:
     1318           assign
     1319               p-is-big = yes
     1320           .
     1321       end.
     1322   end.
     1323   end procedure.
     1324   procedure bgelib-init-ext-doc-type :
     1325       define variable v-counter    as integer      no-undo.
     1326       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1327   do
     1328   for buf_temp_ext-doc-type
     1329   on error undo, return error
     1330   :
     1331       empty temp-table buf_temp_ext-doc-type.
     1332       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1333       :
     1334           create buf_temp_ext-doc-type.
     1335           assign
     1336               buf_temp_ext-doc-type.edt-key               = v-counter
     1337               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1338               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1339           .
     1340       end.
     1341   end.
     1342   end procedure.
     1343   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1344   procedure factord :
     1345     define input  parameter p-fact-date            as date    no-undo .
     1346     define input  parameter p-fact-time            as integer no-undo .
     1347     define input  parameter p-fact-num             as integer no-undo .
     1348     define input  parameter p-shift-date           as date    no-undo .
     1349     define input  parameter p-shift-num            as integer no-undo .
     1350     define input  parameter p-shift-on             as logical no-undo .
     1351     define output parameter p-fact-order           as decimal no-undo .
     1352     define output parameter p-shift-end-fact-order as decimal no-undo .
     1353     define output parameter p-day-end-fact-order   as decimal no-undo .
     1354     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1355     if p-fact-date = ?
     1356     then do:
     1357       return error "Не указана фактическая дата" .
     1358     end.
     1359     define variable v-fact-date-num as integer no-undo .
     1360     assign
     1361       v-fact-date-num = integer(p-fact-date)
     1362     .
     1363     if p-fact-num = ?
     1364     or p-fact-num = 0
     1365     then do:
     1366       return error "Не задан p-fact-num " + string(p-fact-num) .
     1367     end.
     1368     if p-fact-num < 0
     1369     then do:
     1370       return error "Отрицательный fact-num " + string(p-fact-num) .
     1371     end.
     1372     if p-fact-num >= 100000000
     1373     then do:
     1374       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1375     end.
     1376     if p-shift-on = true
     1377     then do:
     1378       if p-shift-date = ?
     1379       then do:
     1380         return error "Не задана дата смены" .
     1381       end.
     1382       if p-shift-num = ?
     1383       or p-shift-num = 0
     1384       then do:
     1385         return error "Не задан номер смены" .
     1386       end.
     1387     end.
     1388     else do:
     1389       assign
     1390         p-shift-date = p-fact-date
     1391         p-shift-num  = 24
     1392       .
     1393     end.
     1394     define variable v-shift-offset as integer no-undo .
     1395     if p-shift-date = p-fact-date
     1396     then do:
     1397       assign
     1398         v-shift-offset = 1
     1399       .
     1400     end.
     1401     if p-shift-date < p-fact-date
     1402     then do:
     1403       assign
     1404         v-shift-offset = 0
     1405       .
     1406     end.
     1407     if p-shift-date > p-fact-date
     1408     then do:
     1409       message
     1410         vss-workfile vss-revision vss-description skip
     1411         "Неправильная дата закрытия смены" skip
     1412         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1413         view-as alert-box error .
     1414       undo, return error
     1415         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1416           ,string(p-fact-date, '99/99/9999':U)
     1417           ,string(p-shift-date, '99/99/9999':U)
     1418           )
     1419       .
     1420     end.
     1421     if p-shift-num < 1
     1422     or p-shift-num > 24
     1423     then do:
     1424       message
     1425         vss-workfile vss-revision vss-description skip
     1426         "Неправильный номер смены" skip
     1427         "p-shift-num" p-shift-num skip
     1428         view-as alert-box error .
     1429       undo, return error return-value .
     1430     end.
     1431     assign
     1432       p-fact-order           = v-fact-date-num
     1433                              + v-shift-offset * 0.5
     1434                              + p-shift-num    * 0.02 - 0.01
     1435                              + p-fact-num     * 0.0000000001
     1436       p-shift-end-fact-order = v-fact-date-num
     1437                              + v-shift-offset * 0.5
     1438                              + p-shift-num    * 0.02
     1439       p-day-end-fact-order   = v-fact-date-num
     1440                              + 0.99
     1441     .
     1442     if p-fact-order           <= v-fact-date-num
     1443     or p-shift-end-fact-order <= v-fact-date-num
     1444     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1445     or p-shift-end-fact-order >= p-day-end-fact-order
     1446     then do:
     1447       message
     1448         vss-workfile vss-revision vss-description skip
     1449         "Внутренняя ошибка при генерации фактического номера" skip
     1450         "p-fact-date"            p-fact-date            skip
     1451         "p-fact-time"            p-fact-time            skip
     1452         "p-fact-num"             p-fact-num             skip
     1453         "p-shift-date"           p-shift-date           skip
     1454         "p-shift-num"            p-shift-num            skip
     1455         "p-shift-on"             p-shift-on             skip
     1456         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1457         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1458         "v-fact-date-num"        v-fact-date-num        skip
     1459         view-as alert-box error .
     1460       undo, return error return-value .
     1461     end.
     1462   end procedure.
     1463   procedure day-begin-fact-order :
     1464     define input  parameter p-fact-date            as date    no-undo .
     1465     define output parameter p-day-begin-fact-order as decimal no-undo .
     1466     do
     1467     on error undo, return error return-value
     1468     :
     1469       if p-fact-date = ?
     1470       then do:
     1471         assign
     1472           p-day-begin-fact-order = 0
     1473         .
     1474       end.
     1475       else do:
     1476         assign
     1477           p-day-begin-fact-order = integer(p-fact-date)
     1478         .
     1479       end.
     1480     end.
     1481   end procedure.
     1482   procedure factord-max-fact-order :
     1483     define output parameter p-max-fact-order as decimal   no-undo .
     1484     do
     1485     on error undo, return error return-value
     1486     :
     1487       run day-begin-fact-order in this-procedure
     1488         (input  date(1, 1, 5000)
     1489         ,output p-max-fact-order
     1490         ) .
     1491     end.
     1492   end procedure.
     1493   procedure factord-cut-archive :
     1494     define input  parameter p-obj-type             as character no-undo .
     1495     define input  parameter p-obj-code             as integer   no-undo .
     1496     define input  parameter p-fact-date            as date      no-undo .
     1497     define output parameter p-shift-on             as logical   no-undo .
     1498     define output parameter p-shift-date           as date      no-undo .
     1499     define output parameter p-shift-num            as integer   no-undo .
     1500     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1501     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1502     define variable v-fact-order as decimal   no-undo .
     1503     define buffer buf_shift-obj for ub.shift-obj .
     1504     do
     1505     on error undo, return error return-value
     1506     :
     1507   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1508   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1509     (input  p-obj-type
     1510     ,input  p-obj-code
     1511     ,input  'shift-on=request'
     1512     ,output p-shift-on
     1513     ) no-error .
     1514       if error-status :error
     1515       then do:
     1516         message
     1517           vss-workfile vss-revision vss-description skip
     1518           "Ошибка при определении атрибута объекта" skip
     1519           "Объект" p-obj-type p-obj-code skip
     1520           error-status :get-message(1) skip
     1521           return-value skip
     1522           view-as alert-box error .
     1523         undo, return error return-value .
     1524       end.
     1525       if p-shift-on = false
     1526       then do:
     1527         assign
     1528           p-shift-date               = ?
     1529           p-shift-num                = 0
     1530         .
     1531       end.
     1532       else do:
     1533         find first buf_shift-obj share-lock
     1534           where buf_shift-obj.obj-type   = p-obj-type
     1535             and buf_shift-obj.obj-code   = p-obj-code
     1536             and buf_shift-obj.shift-date > p-fact-date
     1537           use-index pi
     1538           no-error .
     1539         if not available buf_shift-obj
     1540         or buf_shift-obj.status_ <> 'зкр':U
     1541         then do:
     1542           message
     1543             vss-workfile vss-revision vss-description skip
     1544             "Невозможно вычислить последнюю смену" skip
     1545             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1546             "Объект" p-obj-type p-obj-code skip
     1547             "Дата" p-fact-date skip
     1548             view-as alert-box error .
     1549           undo, return error return-value .
     1550         end.
     1551         find last buf_shift-obj share-lock
     1552           where buf_shift-obj.obj-type = p-obj-type
     1553             and buf_shift-obj.obj-code = p-obj-code
     1554             and buf_shift-obj.shift-date <= p-fact-date
     1555           use-index pi
     1556           no-error .
     1557         if available buf_shift-obj
     1558         then do:
     1559           if  buf_shift-obj.status_ = 'зкр':U
     1560           then do:
     1561             assign
     1562               p-shift-date = buf_shift-obj.shift-date
     1563               p-shift-num  = buf_shift-obj.shift-num
     1564             .
     1565           end.
     1566           else do:
     1567             message
     1568               vss-workfile vss-revision vss-description skip
     1569               "Невозможно вычислить последнюю смену" skip
     1570               "Статус смены отличен от статуса" 'зкр':U skip
     1571               "Объект" p-obj-type p-obj-code skip
     1572               "Дата" p-fact-date skip
     1573               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1574               view-as alert-box error .
     1575             undo, return error return-value .
     1576           end.
     1577         end.
     1578         else do:
     1579           assign
     1580             p-shift-date = p-fact-date - 1
     1581             p-shift-num  = 1
     1582           .
     1583         end.
     1584       end.
     1585       run factord in this-procedure
     1586         (input  p-fact-date
     1587         ,input  1
     1588         ,input  1
     1589         ,input  p-shift-date
     1590         ,input  p-shift-num
     1591         ,input  p-shift-on
     1592         ,output v-fact-order
     1593         ,output p-shift-end-fact-order
     1594         ,output p-day-end-fact-order
     1595         ) no-error .
     1596       if error-status :error
     1597       then do:
     1598         message
     1599           vss-workfile vss-revision vss-description skip
     1600           "Ошибка при вызове процедуры factord"
     1601           error-status :get-message(1) skip
     1602           return-value skip
     1603           view-as alert-box error .
     1604         undo, return error return-value .
     1605       end.
     1606     end.
     1607   end procedure.
     1608   procedure factord-lock-shift :
     1609     define input  parameter p-obj-type  as character no-undo .
     1610     define input  parameter p-obj-code  as integer   no-undo .
     1611     define input  parameter p-fact-date as date      no-undo .
     1612     define parameter buffer buf_shift-obj for ub.shift-obj .
     1613     define variable v-shift-on      as logical   no-undo .
     1614     define variable v-extra-message as character no-undo .
     1615     define variable v-error as character no-undo .
     1616     do
     1617     on error undo, return error return-value
     1618     :
     1619   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1620   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1621     (input  p-obj-type
     1622     ,input  p-obj-code
     1623     ,input  'shift-on=request'
     1624     ,output v-shift-on
     1625     ) no-error .
     1626       if error-status :error
     1627       then do:
     1628         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1629         undo, return error v-error .
     1630       end.
     1631       if v-shift-on = true
     1632       then do:
     1633         find first buf_shift-obj share-lock
     1634           where buf_shift-obj.obj-type   = p-obj-type
     1635             and buf_shift-obj.obj-code   = p-obj-code
     1636             and buf_shift-obj.shift-date > p-fact-date
     1637           use-index pi
     1638           no-error .
     1639         if not available buf_shift-obj
     1640         or buf_shift-obj.status_ <> 'зкр':U
     1641         then do:
     1642           find last buf_shift-obj
     1643             where buf_shift-obj.obj-type = p-obj-type
     1644               and buf_shift-obj.obj-code = p-obj-code
     1645               and buf_shift-obj.status_  = 'зкр':U
     1646             use-index stts
     1647             no-error .
     1648           if available buf_shift-obj
     1649           then do:
     1650             assign
     1651               v-extra-message =
     1652                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1653                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1654                               )
     1655             .
     1656           end.
     1657           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1658           undo, return error v-error .
     1659         end.
     1660       end.
     1661     end.
     1662   end procedure.
     1663   procedure factord-end-day :
     1664     define input  parameter p-fact-date            as date    no-undo .
     1665     define output parameter p-day-end-fact-order   as decimal no-undo .
     1666     do
     1667     on error undo, return error return-value
     1668     :
     1669       if p-fact-date = ?
     1670       then do:
     1671         return error "Не указана фактическая дата" .
     1672       end.
     1673       assign
     1674         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1675       .
     1676     end.
     1677   end procedure.
     1678   procedure factord-to-date :
     1679     define input  parameter p-fact-order as decimal no-undo .
     1680     define output parameter p-fact-date  as date    no-undo .
     1681     define variable v-ref-date  as date      no-undo .
     1682     define variable v-ref-delta as integer   no-undo .
     1683     do
     1684     on error undo, return error return-value
     1685     :
     1686       if p-fact-order = ?
     1687       or p-fact-order = 0
     1688       then do:
     1689         return error "Не указан fact-order" .
     1690       end.
     1691       assign
     1692         v-ref-date  = date(1, 1, 2000)
     1693       .
     1694       assign
     1695         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1696       .
     1697       assign
     1698         p-fact-date = v-ref-date + v-ref-delta
     1699       .
     1700     end.
     1701   end procedure.
     1702   procedure factord-to-fact-num :
     1703     define input  parameter p-fact-order as decimal no-undo .
     1704     define output parameter p-fact-num   as integer no-undo .
     1705     define variable v-fact-order-trunc as decimal no-undo .
     1706     do
     1707     on error undo, return error return-value
     1708     :
     1709       if p-fact-order = ?
     1710       or p-fact-order = 0
     1711       then do:
     1712         return error "Не указан fact-order" .
     1713       end.
     1714       assign
     1715        v-fact-order-trunc = truncate(p-fact-order, 2)
     1716       .
     1717       assign
     1718         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1719       .
     1720     end.
     1721   end procedure.
     1722   procedure factord-to-shift-num :
     1723     define input  parameter p-fact-order as decimal no-undo .
     1724     define output parameter p-shift-num   as integer no-undo .
     1725     define variable  p-shift-numd  as decimal   no-undo .
     1726     define variable v-fact-order-trunc as decimal no-undo .
     1727     do
     1728     on error undo, return error return-value
     1729     :
     1730       if p-fact-order = ?
     1731       or p-fact-order = 0
     1732       then do:
     1733         return error "Не указан fact-order" .
     1734       end.
     1735       assign
     1736        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1737       .
     1738       if v-fact-order-trunc < 0.5 then do:
     1739         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1740       end.
     1741       assign
     1742         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1743         .
     1744        assign
     1745         p-shift-num = truncate (p-shift-numd , 0)
     1746       .
     1747     end.
     1748   end procedure.
     1749   do
     1750   on error undo, return error
     1751   :
     1752       define variable v-xml-file-name     as character               no-undo.
     1753       define variable v-log-file-name     as character               no-undo.
     1754       define variable v-list-file-name    as character               no-undo.
     1755       define variable v-xml-file-number   as integer                 no-undo.
     1756       define variable v-log-string        as character               no-undo.
     1757       define variable v-fact-order-from   like ub.stk-tot.fact-order no-undo.
     1758       define variable v-fact-order-to     like ub.stk-tot.fact-order no-undo.
     1759       define variable v-docs-exists       as logical                 no-undo.
     1760       define variable v-obj-counter       as integer                 no-undo.
     1761       define variable v-db-num            as integer                 no-undo.
     1762       define variable v-cancel            as logical                 no-undo.
     1763       define variable v-space-available   as logical                 no-undo.
     1764       define variable v-parameter-list    as character               no-undo.
     1765       define variable v-obj-type as character no-undo .
     1766       define variable v-obj-code as integer   no-undo .
     1767       define variable v-host-code as integer   no-undo .
     1768       define variable v-host-str  as character no-undo init "" .
     1769       run init-temphost .
     1770       assign
     1771           v-log-string = " по всем фирмам"
     1772       .
     1773       case p-range:
     1774       when 2
     1775       then do:
     1776           for each temp-host
     1777           :
     1778               delete temp-host.
     1779           end.
     1780           do v-obj-counter = 1 to num-entries ( p-obj-list ) / 2
     1781           :
     1782               create temp-host.
     1783               assign
     1784               temp-host.host-code = integer( entry( v-obj-counter * 2, p-obj-list ) )
     1785               no-error .
     1786               if error-status :error
     1787               then do:
     1788                   message
     1789                   vss-workfile vss-revision vss-description
     1790                   skip "Ошибка чтения списка фирм"
     1791                   skip return-value
     1792                   skip trim(error-status :get-message(1))
     1793                       trim(error-status :get-message(2))
     1794                       trim(error-status :get-message(3))
     1795                   view-as alert-box error.
     1796                   undo, return error .
     1797               end.
     1798           end.
     1799           assign
     1800               v-log-string = " по фирмам: " + p-obj-list
     1801           .
     1802       end.
     1803       when 3
     1804       then do:
     1805           for each temp-host
     1806           :
     1807               delete temp-host.
     1808           end.
     1809           do v-obj-counter = 1 to num-entries ( p-obj-list ) / 2
     1810           :
     1811           v-obj-type = entry( (v-obj-counter * 2 ) - 1 , p-obj-list )     .
     1812           v-obj-code = integer( entry( v-obj-counter * 2, p-obj-list ) )  .
     1813   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1814   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1815     (input  v-obj-type
     1816     ,input  v-obj-code
     1817     ,output v-host-code
     1818     )  .
     1819           if not can-find ( first temp-host where temp-host.host-code = v-host-code) then do:
     1820               v-host-str = v-host-str + "," + string(v-host-code).
     1821               create temp-host.
     1822               assign
     1823               temp-host.host-code = v-host-code
     1824               no-error .
     1825               if error-status :error
     1826               then do:
     1827                   message
     1828                   vss-workfile vss-revision vss-description
     1829                   skip "Ошибка чтения списка фирм"
     1830                   skip return-value
     1831                   skip trim(error-status :get-message(1))
     1832                       trim(error-status :get-message(2))
     1833                       trim(error-status :get-message(3))
     1834                   view-as alert-box error.
     1835                   undo, return error .
     1836               end.
     1837           end.
     1838           end.
     1839           assign
     1840               v-log-string = " по фирмам: " + v-host-str
     1841           .
     1842       end.
     1843       end case.
     1844       run bgelib-filename in this-procedure (
     1845             input "fin-ob"
     1846           , output v-xml-file-name
     1847           , output v-log-file-name
     1848           , output v-list-file-name
     1849       ).
     1850       run gbl/waitfrsp.w (
     1851             input substring( v-xml-file-name, 1, 1 )
     1852           , input 200
     1853           , output v-cancel
     1854       ) .
     1855       if v-cancel = yes
     1856       then do:
     1857           undo, return error .
     1858       end.
     1859       run bgelib-write-log in this-procedure (
     1860             input v-log-file-name
     1861           , input 1
     1862           , input "&DLine"
     1863       ).
     1864       run bgelib-write-log in this-procedure (
     1865             input v-log-file-name
     1866           , input 1
     1867           , input substitute( "Начало выгрузки в файл &1"
     1868                                   , replace( v-xml-file-name, "/", "\" ) + "tmp"
     1869                             )
     1870       ).
     1871       run bgelib-write-log in this-procedure (
     1872             input v-log-file-name
     1873           , input 1
     1874           , input substitute( "................с параметрами: Дата с: &1, дата по: &2"
     1875                                   , p-date-from
     1876                                   , p-date-to
     1877                             )
     1878       ).
     1879       run bgelib-write-log in this-procedure (
     1880             input v-log-file-name
     1881           , input 1
     1882           , input substitute( "................с параметрами: ... &1: &2"
     1883                              ,v-log-string
     1884                              )
     1885       ).
     1886       assign
     1887           v-parameter-list         =  substitute( "&1,&2,&3,&4,&5,&6,&7,&8,&9"
     1888                                                  , 7
     1889                                                  , "docName"          , "finOb":U
     1890                                                  , "version"          , replace("14.0 " + replace( vss-revision + vss-date, "$", " " ),',','')
     1891                                                  , "exportDate"       , string( today,          "99/99/9999" )
     1892                                                  , "exportTime"       , string( time,           "HH:MM:SS"   )
     1893                                                 )
     1894                                     + substitute( ",&1,&2,&3,&4,&5,&6"
     1895                                                  , "baseNum"          , 0
     1896                                                  , "dateFrom"         , string( p-date-from,    "99/99/9999" )
     1897                                                  , "dateto"           , string( p-date-to,      "99/99/9999" )
     1898                                                 )
     1899       .
     1900       run bgelib-write-header in this-procedure (
     1901             input yes
     1902           , input v-xml-file-name
     1903           , input v-list-file-name
     1904           , input 1
     1905           , input no
     1906           , input ""
     1907           , input p-obj-list
     1908           , input ""
     1909           , input v-parameter-list
     1910       ).
     1911       object-of-list:
     1912       for each temp-host
     1913       :
     1914           run export-docs-by-host (
     1915                 input temp-host.host-code
     1916               , input v-xml-file-name
     1917               , input v-log-file-name
     1918               , input v-list-file-name
     1919               , input v-xml-file-number
     1920               , output v-xml-file-name
     1921               , output v-xml-file-number
     1922           ) no-error.
     1923           if error-status :error
     1924           then do:
     1925               message
     1926               vss-workfile vss-revision vss-description
     1927               skip "Ошибка экспорта финансовых обязательств (ФО) по фирме"
     1928               skip "Код фирмы:" temp-host.host-code
     1929               skip return-value
     1930               skip trim(error-status :get-message(1))
     1931                    trim(error-status :get-message(2))
     1932                    trim(error-status :get-message(3))
     1933               view-as alert-box error.
     1934               next object-of-list.
     1935           end.
     1936       end.
     1937       run bgelib-write-footer in this-procedure (
     1938             input yes
     1939           , input v-xml-file-name
     1940           , input v-list-file-name
     1941           , input no
     1942           , input ""
     1943       ).
     1944       run bgelib-write-log in this-procedure (
     1945             input v-log-file-name
     1946           , input 1
     1947           , input substitute( "Данные выгружены в файл &1"
     1948                                   , replace( v-xml-file-name, "/", "\" ) + "xml"
     1949                             )
     1950       ).
     1951       run bgelib-write-log in this-procedure (
     1952             input v-log-file-name
     1953           , input 1
     1954           , input "&DLine"
     1955       ).
     1956   end.
     1957   procedure export-docs-by-host :
     1958   do
     1959   on error undo, return error
     1960   :
     1961   define input parameter p-host-code              as integer      no-undo.
     1962   define input parameter p-xml-file-name          as character    no-undo.
     1963   define input parameter p-log-file-name          as character    no-undo.
     1964   define input parameter p-list-file-name         as character    no-undo.
     1965   define input parameter p-xml-file-number        as integer      no-undo.
     1966   define output parameter p-new-xml-file-name     as character    no-undo.
     1967   define output parameter p-new-xml-file-number   as integer      no-undo.
     1968   define buffer buf_fin-ob for ub.fin-ob.
     1969       assign
     1970           p-new-xml-file-name     = p-xml-file-name
     1971           p-new-xml-file-number   = p-xml-file-number
     1972       .
     1973       run bgelib-write-edt in this-procedure ( hEDT, 1, string("Фирма :") + string( p-host-code ) ).
     1974       run day-begin-fact-order in this-procedure (
     1975                                                     input  p-date-from
     1976                                                     ,output v-fact-order-from
     1977                                                     ) no-error .
     1978       if error-status :error
     1979       then do:
     1980           message
     1981             vss-workfile vss-revision vss-description
     1982             skip "Ошибка определения границ fact-order для поиска"
     1983             skip return-value
     1984             skip trim(error-status :get-message(1))
     1985                  trim(error-status :get-message(2))
     1986                  trim(error-status :get-message(3))
     1987           view-as alert-box error.
     1988           undo, return error .
     1989       end.
     1990       run factord-end-day  in this-procedure (
     1991                                                     input  p-date-to
     1992                                                     ,output v-fact-order-to
     1993                                                     ) no-error .
     1994       if error-status :error
     1995       then do:
     1996           message
     1997             vss-workfile vss-revision vss-description
     1998             skip "Ошибка определения границ fact-order для поиска"
     1999             skip return-value
     2000             skip trim(error-status :get-message(1))
     2001                  trim(error-status :get-message(2))
     2002                  trim(error-status :get-message(3))
     2003           view-as alert-box error.
     2004           undo, return error .
     2005       end.
     2006       find first buf_fin-ob no-lock where
     2007                 buf_fin-ob.host-code = p-host-code
     2008         AND buf_fin-ob.fact-order >= v-fact-order-from
     2009         AND buf_fin-ob.fact-order <= v-fact-order-to
     2010         AND buf_fin-ob.status_ = 'факт':U no-error .
     2011       if not available buf_fin-ob
     2012       then do:
     2013           run bgelib-write-edt in this-procedure ( hEDT, 4, "В заданном диапазоне дат нет закрытых документов").
     2014           return .
     2015       end.
     2016       run bgelib-show-cnt in this-procedure (hCNT).
     2017               run bge/fodocop.p (
     2018                     input p-host-code
     2019                   , input "Выгрузка ФО"
     2020                   , input v-fact-order-from
     2021                   , input v-fact-order-to
     2022                   , input p-obj-list
     2023                   , input v-parameter-list
     2024                   , input p-xml-file-name
     2025                   , input p-log-file-name
     2026                   , input p-list-file-name
     2027                   , input p-xml-file-number
     2028                   , input hEDT
     2029                   , input hCNT
     2030                   , output p-new-xml-file-name
     2031                   , output p-new-xml-file-number
     2032               ) no-error.
     2033               if error-status :error
     2034               then do:
     2035                   run bgelib-write-edt in this-procedure ( hEDT, 1, string(return-value)).
     2036               end.
     2037               assign
     2038                   p-xml-file-name     = p-new-xml-file-name
     2039                   p-xml-file-number   = p-new-xml-file-number
     2040               .
     2041       run bgelib-show-cnt in this-procedure (hCNT).
     2042               run bge/fobdocop.p (
     2043                     input p-host-code
     2044                   , input "Выгрузка ПФО"
     2045                   , input v-fact-order-from
     2046                   , input v-fact-order-to
     2047                   , input p-obj-list
     2048                   , input v-parameter-list
     2049                   , input p-xml-file-name
     2050                   , input p-log-file-name
     2051                   , input p-list-file-name
     2052                   , input p-xml-file-number
     2053                   , input hEDT
     2054                   , input hCNT
     2055                   , output p-new-xml-file-name
     2056                   , output p-new-xml-file-number
     2057               ) no-error.
     2058               if error-status :error
     2059               then do:
     2060                   run bgelib-write-edt in this-procedure ( hEDT, 1, string(return-value)).
     2061               end.
     2062               assign
     2063                   p-xml-file-name     = p-new-xml-file-name
     2064                   p-xml-file-number   = p-new-xml-file-number
     2065               .
     2066       run bgelib-show-cnt in this-procedure (hCNT).
     2067   end.
     2068   end procedure.
