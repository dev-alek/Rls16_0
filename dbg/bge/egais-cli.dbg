     1876   define variable v-diasize-browse-number        as integer   no-undo .
     1877   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1878   define temp-table temp-diasize-handle no-undo
     1879     field handle-value  as handle
     1880     field save-position as decimal
     1881     index xpk is primary unique handle-value
     1882     .
     1883   define temp-table temp-browse-handle no-undo
     1884     field browse-type   as character
     1885     field browse-number as integer
     1886     field browse-handle as handle
     1887     field original-size as decimal
     1888     index xpk is primary unique browse-type browse-number
     1889     index xie browse-type browse-handle
     1890   .
     1891   procedure diasize_change-height :
     1892     define input  parameter p-change-value  as decimal   no-undo .
     1893     define input  parameter p-move-resize   as logical   no-undo .
     1894     define variable v-field-group-handle    as handle    no-undo .
     1895     define variable v-object-handle         as handle    no-undo .
     1896     define variable v-frame-height          as decimal   no-undo .
     1897     define variable v-frame-virtual-height  as decimal   no-undo .
     1898     define variable v-browse-height         as decimal   no-undo .
     1899     define variable v-window-height         as decimal   no-undo .
     1900     define variable v-window-virtual-height as decimal   no-undo .
     1901     define variable v-change-sign           as integer   no-undo .
     1902     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1903     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1904     if p-change-value > 0
     1905     then do:
     1906       if frame Dialog-Frame :height + p-change-value
     1907           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1908       then do:
     1909         assign
     1910           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1911                           - (frame Dialog-Frame :height-chars)
     1912         .
     1913         if p-change-value <= 0
     1914         then do:
     1915           run diasize_position-resize-button in this-procedure .
     1916           return .
     1917         end.
     1918       end.
     1919     end.
     1920     if p-change-value < 0
     1921     then do:
     1922       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1923       then do:
     1924         assign
     1925           p-change-value = v-diasize-orig-frame-height
     1926                          - (frame Dialog-Frame :height-chars)
     1927         .
     1928         if p-change-value >= 0
     1929         then do:
     1930           run diasize_position-resize-button in this-procedure .
     1931           return .
     1932         end.
     1933       end.
     1934     end.
     1935     if p-change-value >= 0
     1936     then do:
     1937       assign
     1938         v-change-sign = 1
     1939       .
     1940     end.
     1941     else do:
     1942       assign
     1943         v-change-sign = -1
     1944       .
     1945     end.
     1946     assign
     1947       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1948     .
     1949     if p-change-value = 0
     1950     then do:
     1951       run diasize_position-resize-button in this-procedure .
     1952       return .
     1953     end.
     1954     move_block:
     1955     do
     1956     on error undo move_block, retry move_block
     1957     :
     1958       if retry
     1959       then do:
     1960         do
     1961         on error undo move_block, leave move_block
     1962         :
     1963           if p-change-value > 0
     1964           then do:
     1965             for each buf_temp-diasize-handle
     1966             on error undo, next
     1967             :
     1968               assign
     1969                 v-object-handle = buf_temp-diasize-handle.handle-value
     1970               .
     1971               if v-object-handle <> v-diasize-resize-button
     1972               then do:
     1973                 assign
     1974                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1975                 .
     1976               end.
     1977             end.
     1978             assign
     1979               v-diasize-browse-handle :height = v-browse-height
     1980             .
     1981             for each buf_temp-browse-handle
     1982               where buf_temp-browse-handle.browse-type = 'height':u
     1983             on error undo, next
     1984             :
     1985               assign
     1986                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1987               .
     1988             end.
     1989             assign
     1990               frame Dialog-Frame :height = v-frame-height
     1991             .
     1992             if frame Dialog-Frame :scrollable = true
     1993             then do:
     1994               assign
     1995                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1996               .
     1997             end.
     1998             run diasize_position-resize-button in this-procedure .
     1999           end.
     2000           else do:
     2001             if frame Dialog-Frame :scrollable = true
     2002             then do:
     2003               assign
     2004                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2005               .
     2006             end.
     2007             assign
     2008               frame Dialog-Frame :height = v-frame-height
     2009             .
     2010             assign
     2011               v-diasize-browse-handle :height = v-browse-height
     2012             .
     2013             for each buf_temp-browse-handle
     2014               where buf_temp-browse-handle.browse-type = 'height':u
     2015             on error undo, next
     2016             :
     2017               assign
     2018                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2019               .
     2020             end.
     2021             for each buf_temp-diasize-handle
     2022             on error undo, next
     2023             :
     2024               assign
     2025                 v-object-handle = buf_temp-diasize-handle.handle-value
     2026               .
     2027               if v-object-handle <> v-diasize-resize-button
     2028               then do:
     2029                 assign
     2030                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2031                 .
     2032               end.
     2033             end.
     2034             run diasize_position-resize-button in this-procedure .
     2035           end.
     2036           assign
     2037             v-diasize-change-size = false
     2038           .
     2039           leave move_block .
     2040         end.
     2041       end.
     2042       assign
     2043         v-diasize-need-full-display = true
     2044       .
     2045       if v-diasize-change-size = false
     2046       then do:
     2047         assign
     2048           v-diasize-change-size = true
     2049         .
     2050       end.
     2051       else do:
     2052         return .
     2053       end.
     2054       assign
     2055         v-frame-height = frame Dialog-Frame :height
     2056         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2057         v-browse-height = v-diasize-browse-handle :height
     2058       .
     2059       for each buf_temp-browse-handle
     2060         where buf_temp-browse-handle.browse-type = 'height':u
     2061       :
     2062         assign
     2063           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2064         .
     2065       end.
     2066       for each buf_temp-diasize-handle
     2067       :
     2068         delete buf_temp-diasize-handle .
     2069       end.
     2070       assign
     2071         v-field-group-handle = frame Dialog-Frame :first-child
     2072       .
     2073       do while valid-handle(v-field-group-handle)
     2074       :
     2075         assign
     2076           v-object-handle = v-field-group-handle :first-child
     2077         .
     2078         do while valid-handle(v-object-handle)
     2079         :
     2080           if  v-object-handle <> v-diasize-browse-handle :handle
     2081           and can-query(v-object-handle, "row")
     2082           and can-query(v-object-handle, "height")
     2083           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2084           then do:
     2085             find first buf_temp-browse-handle
     2086               where buf_temp-browse-handle.browse-type   = 'height':u
     2087                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2088               no-error .
     2089             if available buf_temp-browse-handle
     2090             then do:
     2091             end.
     2092             else do:
     2093               create buf_temp-diasize-handle .
     2094               assign
     2095                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2096                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2097               .
     2098             end.
     2099           end.
     2100           assign
     2101             v-object-handle = v-object-handle :next-sibling
     2102           .
     2103         end.
     2104         assign
     2105           v-field-group-handle = v-field-group-handle :next-sibling
     2106         .
     2107       end.
     2108       do with frame Dialog-Frame
     2109       :
     2110         hide v-diasize-resize-button .
     2111         assign
     2112           v-diasize-resize-button :row    = 1
     2113           v-diasize-resize-button :column = 1
     2114         .
     2115       end.
     2116       if p-change-value > 0
     2117       then do:
     2118         if frame Dialog-Frame :scrollable = true
     2119         then do:
     2120           assign
     2121             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2122             no-error .
     2123           if error-status :error
     2124           or error-status :get-message(1) <> ""
     2125           then do:
     2126             undo move_block, retry move_block .
     2127           end.
     2128         end.
     2129         assign
     2130           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2131           no-error .
     2132         if error-status :error
     2133         or error-status :get-message(1) <> ""
     2134         then do:
     2135           undo move_block, retry move_block .
     2136         end.
     2137         assign
     2138           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2139           no-error .
     2140         if error-status :error
     2141         or error-status :get-message(1) <> ""
     2142         then do:
     2143           undo move_block, retry move_block .
     2144         end.
     2145         for each buf_temp-browse-handle
     2146           where buf_temp-browse-handle.browse-type = 'height':u
     2147         on error undo move_block, retry move_block
     2148         :
     2149           assign
     2150             buf_temp-browse-handle.browse-handle :height
     2151               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2152             no-error .
     2153           if error-status :error
     2154           or error-status :get-message(1) <> ""
     2155           then do:
     2156             undo move_block, retry move_block .
     2157           end.
     2158         end.
     2159         for each buf_temp-diasize-handle
     2160         on error undo move_block, retry move_block
     2161         :
     2162           assign
     2163             v-object-handle = buf_temp-diasize-handle.handle-value
     2164           .
     2165           if v-object-handle <> v-diasize-resize-button
     2166           then do:
     2167             assign
     2168               v-object-handle :row = v-object-handle :row + p-change-value
     2169               no-error .
     2170             if error-status :error
     2171             or error-status :get-message(1) <> ""
     2172             then do:
     2173               undo move_block, retry move_block .
     2174             end.
     2175           end.
     2176         end.
     2177       end.
     2178       else do:
     2179         for each buf_temp-diasize-handle
     2180         on error undo move_block, retry move_block
     2181         :
     2182           assign
     2183             v-object-handle = buf_temp-diasize-handle.handle-value
     2184           .
     2185           if v-object-handle <> v-diasize-resize-button
     2186           then do:
     2187             assign
     2188               v-object-handle :row = v-object-handle :row + p-change-value
     2189               no-error .
     2190             if error-status :error
     2191             or error-status :get-message(1) <> ""
     2192             then do:
     2193               undo move_block, retry move_block .
     2194             end.
     2195           end.
     2196         end.
     2197         assign
     2198           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2199           no-error .
     2200         if error-status :error
     2201         or error-status :get-message(1) <> ""
     2202         then do:
     2203           undo move_block, retry move_block .
     2204         end.
     2205         for each buf_temp-browse-handle
     2206           where buf_temp-browse-handle.browse-type = 'height':u
     2207         on error undo move_block, retry move_block
     2208         :
     2209           assign
     2210             buf_temp-browse-handle.browse-handle :height
     2211               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2212             no-error .
     2213           if error-status :error
     2214           or error-status :get-message(1) <> ""
     2215           then do:
     2216             undo move_block, retry move_block .
     2217           end.
     2218         end.
     2219         assign
     2220           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2221           no-error .
     2222         if error-status :error
     2223         or error-status :get-message(1) <> ""
     2224         then do:
     2225           undo move_block, retry move_block .
     2226         end.
     2227         if frame Dialog-Frame :scrollable = true
     2228         then do:
     2229           assign
     2230             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2231             no-error .
     2232           if error-status :error
     2233           or error-status :get-message(1) <> ""
     2234           then do:
     2235             undo move_block, retry move_block .
     2236           end.
     2237         end.
     2238       end.
     2239       if p-move-resize = true
     2240       then do:
     2241         run diasize_position-resize-button in this-procedure .
     2242       end.
     2243       if v-diasize-wndstore = true
     2244       then do:
     2245         if connected("ub") = true
     2246         then do:
     2247           define variable v-cntxt-db-num        as integer   no-undo .
     2248           define variable v-cntxt-userid        as character no-undo .
     2249           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2250                                             , OUTPUT v-cntxt-userid
     2251                                             ) .
     2252           run gbl/wndsizew.p
     2253             (input  v-cntxt-db-num
     2254             ,input  v-cntxt-userid
     2255             ,input  v-diasize-proc-name
     2256             ,input  'height':u
     2257             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2258             ) .
     2259         end.
     2260       end.
     2261     end.
     2262     assign
     2263       v-diasize-change-size = false
     2264     .
     2265   end procedure.
     2266   procedure diasize_set-height :
     2267     define input  parameter p-new-height  as decimal   no-undo .
     2268     define input  parameter p-move-resize as logical   no-undo .
     2269     do
     2270     on error undo, return error return-value
     2271     :
     2272       run diasize_change-height in this-procedure
     2273         (input  (p-new-height - frame Dialog-Frame :height)
     2274         ,input  p-move-resize
     2275         ) .
     2276     end.
     2277   end procedure.
     2278   procedure diasize_change-width :
     2279     define input  parameter p-change-value as decimal   no-undo .
     2280     define input  parameter p-move-resize  as logical   no-undo .
     2281     define variable v-field-group-handle   as handle    no-undo .
     2282     define variable v-object-handle        as handle    no-undo .
     2283     define variable v-frame-width          as decimal   no-undo .
     2284     define variable v-frame-virtual-width  as decimal   no-undo .
     2285     define variable v-browse-width         as decimal   no-undo .
     2286     define variable v-window-width         as decimal   no-undo .
     2287     define variable v-window-virtual-width as decimal   no-undo .
     2288     define variable v-change-sign          as integer   no-undo .
     2289     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2290     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2291     if p-change-value > 0
     2292     then do:
     2293       if frame Dialog-Frame :width + p-change-value >
     2294           session :width-chars
     2295       then do:
     2296         assign
     2297           p-change-value = session :width-chars - frame Dialog-Frame :width
     2298         .
     2299         if p-change-value <= 0
     2300         then do:
     2301           run diasize_position-resize-button in this-procedure .
     2302           return .
     2303         end.
     2304       end.
     2305     end.
     2306     if p-change-value < 0
     2307     then do:
     2308       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2309       then do:
     2310         assign
     2311           p-change-value = v-diasize-orig-frame-width
     2312                          - frame Dialog-Frame :width
     2313         .
     2314         if p-change-value >= 0
     2315         then do:
     2316           run diasize_position-resize-button in this-procedure .
     2317           return .
     2318         end.
     2319       end.
     2320     end.
     2321     if p-change-value >= 0
     2322     then do:
     2323       assign
     2324         v-change-sign = 1
     2325       .
     2326     end.
     2327     else do:
     2328       assign
     2329         v-change-sign = -1
     2330       .
     2331     end.
     2332     assign
     2333       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2334     .
     2335     if p-change-value = 0
     2336     then do:
     2337       run diasize_position-resize-button in this-procedure .
     2338       return .
     2339     end.
     2340     move_block:
     2341     do
     2342     on error undo move_block, leave move_block
     2343     :
     2344       if retry
     2345       then do:
     2346         do
     2347         on error undo move_block, leave move_block
     2348         :
     2349           if p-change-value > 0
     2350           then do:
     2351             for each buf_temp-diasize-handle
     2352             on error undo, next
     2353             :
     2354               assign
     2355                 v-object-handle = buf_temp-diasize-handle.handle-value
     2356               .
     2357               if v-object-handle <> v-diasize-resize-button
     2358               then do:
     2359                 assign
     2360                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2361                 .
     2362               end.
     2363             end.
     2364             assign
     2365               v-diasize-browse-handle :width = v-browse-width
     2366             .
     2367             for each buf_temp-browse-handle
     2368               where buf_temp-browse-handle.browse-type = 'width':u
     2369             on error undo, next
     2370             :
     2371               assign
     2372                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2373               .
     2374             end.
     2375             assign
     2376               frame Dialog-Frame :width = v-frame-width
     2377             .
     2378             if frame Dialog-Frame :scrollable = true
     2379             then do:
     2380               assign
     2381                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2382               .
     2383             end.
     2384             run diasize_position-resize-button in this-procedure .
     2385           end.
     2386           else do:
     2387             if frame Dialog-Frame :scrollable = true
     2388             then do:
     2389               assign
     2390                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2391               .
     2392             end.
     2393             assign
     2394               frame Dialog-Frame :width = v-frame-width
     2395             .
     2396             for each buf_temp-browse-handle
     2397               where buf_temp-browse-handle.browse-type = 'width':u
     2398             on error undo, next
     2399             :
     2400               assign
     2401                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2402               .
     2403             end.
     2404             assign
     2405               v-diasize-browse-handle :width = v-browse-width
     2406             .
     2407             for each buf_temp-diasize-handle
     2408             on error undo, next
     2409             :
     2410               assign
     2411                 v-object-handle = buf_temp-diasize-handle.handle-value
     2412               .
     2413               if v-object-handle <> v-diasize-resize-button
     2414               then do:
     2415                 assign
     2416                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2417                 .
     2418               end.
     2419             end.
     2420             run diasize_position-resize-button in this-procedure .
     2421           end.
     2422           assign
     2423             v-diasize-change-size = false
     2424           .
     2425           leave move_block .
     2426         end.
     2427       end.
     2428       assign
     2429         v-diasize-need-full-display = true
     2430       .
     2431       if v-diasize-change-size = false
     2432       then do:
     2433         assign
     2434           v-diasize-change-size = true
     2435         .
     2436       end.
     2437       else do:
     2438         return .
     2439       end.
     2440       assign
     2441         v-frame-width = frame Dialog-Frame :width
     2442         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2443         v-browse-width = v-diasize-browse-handle :width
     2444       .
     2445       for each buf_temp-browse-handle
     2446         where buf_temp-browse-handle.browse-type = 'width':u
     2447       :
     2448         assign
     2449           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2450         .
     2451       end.
     2452       for each buf_temp-diasize-handle
     2453       :
     2454         delete buf_temp-diasize-handle .
     2455       end.
     2456       assign
     2457         v-field-group-handle = frame Dialog-Frame :first-child
     2458       .
     2459       do while valid-handle(v-field-group-handle)
     2460       :
     2461         assign
     2462           v-object-handle = v-field-group-handle :first-child
     2463         .
     2464         do while valid-handle(v-object-handle)
     2465         :
     2466           if  v-object-handle <> v-diasize-browse-handle :handle
     2467           and v-object-handle <> v-diasize-resize-button
     2468           and can-query(v-object-handle, "row")
     2469           and can-query(v-object-handle, "height")
     2470           and ( v-object-handle :col + v-object-handle :width
     2471                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2472               )
     2473           then do:
     2474             find first buf_temp-browse-handle
     2475               where buf_temp-browse-handle.browse-type   = 'width':u
     2476                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2477               no-error .
     2478             if available buf_temp-browse-handle
     2479             then do:
     2480             end.
     2481             else do:
     2482               create buf_temp-diasize-handle .
     2483               assign
     2484                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2485                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2486               .
     2487             end.
     2488           end.
     2489           assign
     2490             v-object-handle = v-object-handle :next-sibling
     2491           .
     2492         end.
     2493         assign
     2494           v-field-group-handle = v-field-group-handle :next-sibling
     2495         .
     2496       end.
     2497       do with frame Dialog-Frame
     2498       :
     2499         hide v-diasize-resize-button .
     2500         v-diasize-resize-button :row = 1.
     2501         v-diasize-resize-button :column = 1.
     2502       end.
     2503       if p-change-value > 0
     2504       then do:
     2505         if frame Dialog-Frame :scrollable = true
     2506         then do:
     2507           assign
     2508             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2509             no-error .
     2510           if error-status :error
     2511           or error-status :get-message(1) <> ""
     2512           then do:
     2513             undo move_block, retry move_block.
     2514           end.
     2515         end.
     2516         assign
     2517           frame Dialog-Frame :width = v-frame-width + p-change-value
     2518           no-error .
     2519         if error-status :error
     2520         or error-status :get-message(1) <> ""
     2521         then do:
     2522           undo move_block, retry move_block.
     2523         end.
     2524         assign
     2525           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2526         no-error .
     2527         if error-status :error
     2528         or error-status :get-message(1) <> ""
     2529         then do:
     2530           undo move_block, retry move_block.
     2531         end.
     2532         for each buf_temp-browse-handle
     2533           where buf_temp-browse-handle.browse-type = 'width':u
     2534         on error undo move_block, retry move_block
     2535         :
     2536           assign
     2537             buf_temp-browse-handle.browse-handle :width
     2538               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2539             no-error .
     2540           if error-status :error
     2541           or error-status :get-message(1) <> ""
     2542           then do:
     2543             undo move_block, retry move_block .
     2544           end.
     2545         end.
     2546         for each buf_temp-diasize-handle
     2547         on error undo move_block, retry move_block
     2548         :
     2549           assign
     2550             v-object-handle = buf_temp-diasize-handle.handle-value
     2551           .
     2552           if v-object-handle <> v-diasize-resize-button
     2553           then do:
     2554             assign
     2555               v-object-handle :col = v-object-handle :col + p-change-value
     2556               no-error .
     2557             if error-status :error
     2558             or error-status :get-message(1) <> ""
     2559             then do:
     2560               undo move_block, retry move_block .
     2561             end.
     2562           end.
     2563         end.
     2564       end.
     2565       else do:
     2566         for each buf_temp-diasize-handle
     2567         on error undo move_block, retry move_block
     2568         :
     2569           assign
     2570             v-object-handle = buf_temp-diasize-handle.handle-value
     2571           .
     2572           if v-object-handle <> v-diasize-resize-button
     2573           then do:
     2574             assign
     2575               v-object-handle :col = v-object-handle :col + p-change-value
     2576               no-error .
     2577             if error-status :error
     2578             or error-status :get-message(1) <> ""
     2579             then do:
     2580               undo move_block, retry move_block .
     2581             end.
     2582           end.
     2583         end.
     2584         for each buf_temp-browse-handle
     2585           where buf_temp-browse-handle.browse-type = 'width':u
     2586         on error undo move_block, retry move_block
     2587         :
     2588           assign
     2589             buf_temp-browse-handle.browse-handle :width
     2590               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2591             no-error .
     2592           if error-status :error
     2593           or error-status :get-message(1) <> ""
     2594           then do:
     2595             undo move_block, retry move_block .
     2596           end.
     2597         end.
     2598         assign
     2599           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2600           no-error .
     2601         if error-status :error
     2602         or error-status :get-message(1) <> ""
     2603         then do:
     2604           undo move_block, retry move_block.
     2605         end.
     2606         assign
     2607           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2608         no-error .
     2609         if error-status :error
     2610         or error-status :get-message(1) <> ""
     2611         then do:
     2612           undo move_block, retry move_block.
     2613         end.
     2614         if frame Dialog-Frame :scrollable = true
     2615         then do:
     2616           assign
     2617             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2618           no-error .
     2619           if error-status :error
     2620           or error-status :get-message(1) <> ""
     2621           then do:
     2622             undo move_block, retry move_block.
     2623           end.
     2624         end.
     2625       end.
     2626       if p-move-resize
     2627       then do:
     2628         run diasize_position-resize-button in this-procedure .
     2629       end.
     2630       if v-diasize-wndstore = true
     2631       then do:
     2632         if connected("ub") = true
     2633         then do:
     2634           define variable v-cntxt-db-num        as integer   no-undo .
     2635           define variable v-cntxt-userid        as character no-undo .
     2636           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2637                                             , OUTPUT v-cntxt-userid
     2638                                             ) .
     2639           run gbl/wndsizew.p
     2640             (input  v-cntxt-db-num
     2641             ,input  v-cntxt-userid
     2642             ,input  v-diasize-proc-name
     2643             ,input  'width':u
     2644             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2645             ) .
     2646         end.
     2647       end.
     2648     end.
     2649     assign
     2650       v-diasize-change-size = false
     2651     .
     2652   end procedure.
     2653   procedure diasize_set-width :
     2654     define input  parameter p-new-width  as decimal   no-undo .
     2655     define input  parameter p-move-resize as logical   no-undo .
     2656     do
     2657     on error undo, return error return-value
     2658     :
     2659       run diasize_change-width in this-procedure
     2660         (input  (p-new-width - frame Dialog-Frame :width)
     2661         ,input  p-move-resize
     2662         ) .
     2663     end.
     2664   end procedure.
     2665   procedure diasize_position-resize-button :
     2666     do with frame Dialog-Frame
     2667     :
     2668       hide v-diasize-resize-button .
     2669       assign
     2670         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2671                     - 1
     2672                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2673         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2674                     - 1
     2675                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2676       .
     2677       view v-diasize-resize-button .
     2678     end.
     2679   end procedure.
     2680   on alt-right anywhere
     2681   do:
     2682     run diasize_change-width in this-procedure
     2683       (input 1
     2684       ,input true
     2685       ) .
     2686     return no-apply .
     2687   end.
     2688   on alt-left anywhere
     2689   do:
     2690     run diasize_change-width in this-procedure
     2691       (input -1
     2692       ,input true
     2693       ) .
     2694     return no-apply .
     2695   end.
     2696   on alt-down anywhere
     2697   do:
     2698     run diasize_change-height in this-procedure
     2699       (input 1
     2700       ,input true
     2701       ) .
     2702     return no-apply .
     2703   end.
     2704   on alt-up anywhere
     2705   do:
     2706     run diasize_change-height in this-procedure
     2707       (input -1
     2708       ,input true
     2709       ) .
     2710     return no-apply .
     2711   end.
     2712   on alt-enter of frame Dialog-Frame
     2713   do:
     2714     run diasize_maximize in this-procedure
     2715       (input  ?
     2716       ).
     2717     return no-apply .
     2718   end.
     2719   procedure diasize_end-move :
     2720     do
     2721     on error undo, return error return-value
     2722     :
     2723       define variable v-row-delta as decimal   no-undo .
     2724       define variable v-col-delta as decimal   no-undo .
     2725       define variable v-new-row as decimal   no-undo .
     2726       define variable v-new-col as decimal   no-undo .
     2727       assign
     2728         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2729         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2730       .
     2731       assign
     2732         v-row-delta = v-new-row - frame Dialog-Frame :height
     2733         v-col-delta = v-new-col - frame Dialog-Frame :width
     2734       .
     2735       run diasize_change-height in this-procedure
     2736         (input v-row-delta
     2737         ,input true
     2738         ) .
     2739       run diasize_change-width in this-procedure
     2740         (input v-col-delta
     2741         ,input true
     2742         ) .
     2743     end.
     2744   end procedure.
     2745   procedure diasize_maximize :
     2746     define input  parameter p-action as logical   no-undo .
     2747     do
     2748     on error undo, return error return-value
     2749     :
     2750       if p-action = ?
     2751       then do:
     2752         if v-diasize-need-maximize = true
     2753         then do:
     2754           assign
     2755             p-action = true
     2756           .
     2757         end.
     2758         else do:
     2759           assign
     2760             p-action = false
     2761           .
     2762         end.
     2763       end.
     2764       if p-action = true
     2765       then do:
     2766         run diasize_change-height in this-procedure
     2767           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2768               - frame Dialog-Frame :height-chars
     2769           ,input true
     2770           ) .
     2771         run diasize_change-width in this-procedure
     2772           (input session :width-chars
     2773               - frame Dialog-Frame :width-chars
     2774           ,input true
     2775           ) .
     2776         assign
     2777           v-diasize-need-maximize = false
     2778         .
     2779       end.
     2780       else do:
     2781         run diasize_change-width in this-procedure
     2782           (input v-diasize-orig-frame-width
     2783               - frame Dialog-Frame :width-chars
     2784           ,input true
     2785           ) .
     2786         run diasize_change-height in this-procedure
     2787           (input v-diasize-orig-frame-height
     2788               - frame Dialog-Frame :height-chars
     2789           ,input true
     2790           ) .
     2791         assign
     2792           v-diasize-need-maximize = true
     2793         .
     2794       end.
     2795     end.
     2796   end procedure.
     2797   procedure diasize_restore-orig-size :
     2798     do
     2799     on error undo, return error return-value
     2800     :
     2801       assign
     2802         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2803         v-diasize-current-frame-height = frame Dialog-Frame :height
     2804       .
     2805       run diasize_set-height in this-procedure
     2806         (input  v-diasize-orig-frame-height
     2807         ,input  true
     2808         ) .
     2809       run diasize_set-width in this-procedure
     2810         (input  v-diasize-orig-frame-width
     2811         ,input  true
     2812         ) .
     2813     end.
     2814   end procedure.
     2815   procedure diasize_restore-current-size :
     2816     do
     2817     on error undo, return error return-value
     2818     :
     2819       run diasize_set-height in this-procedure
     2820         (input  v-diasize-current-frame-height
     2821         ,input  true
     2822         ) .
     2823       run diasize_set-width in this-procedure
     2824         (input  v-diasize-current-frame-width
     2825         ,input  true
     2826         ) .
     2827     end.
     2828   end procedure.
     2829   procedure diasize_set-browse-handle :
     2830     define input  parameter p-browse-handle as handle   no-undo .
     2831     define buffer buf_temp-browse-handle for temp-browse-handle .
     2832     do
     2833     on error undo, return error return-value
     2834     :
     2835       assign
     2836         v-diasize-browse-handle = p-browse-handle
     2837       .
     2838       for each buf_temp-browse-handle
     2839       on error undo, return error return-value
     2840       :
     2841         delete buf_temp-browse-handle .
     2842       end.
     2843     end.
     2844   end procedure.
     2845   procedure diasize_add_browse :
     2846     define input  parameter p-browse-type   as character no-undo .
     2847     define input  parameter p-browse-handle as handle    no-undo .
     2848     define buffer buf_temp-browse-handle for temp-browse-handle .
     2849     do
     2850     on error undo, return error return-value
     2851     :
     2852       assign
     2853         v-diasize-browse-number = v-diasize-browse-number + 1
     2854       .
     2855       create buf_temp-browse-handle .
     2856       assign
     2857         buf_temp-browse-handle.browse-type   = p-browse-type
     2858         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2859         buf_temp-browse-handle.browse-handle = p-browse-handle
     2860       .
     2861     end.
     2862   end procedure.
     2863   procedure diasize_init :
     2864     define variable v-default-value    as logical   no-undo .
     2865     define variable v-restore-saved    as logical   no-undo .
     2866     define variable v-resize-value-str as character no-undo .
     2867     do
     2868     on error undo, return error return-value
     2869     :
     2870       do with frame Dialog-Frame
     2871       :
     2872         assign
     2873           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2874           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2875           v-diasize-browse-handle     = browse br-objects :handle
     2876         .
     2877         create button v-diasize-resize-button
     2878         assign
     2879           parent        = frame Dialog-Frame :first-child
     2880           label         = "s"
     2881           height-pixels = 16
     2882           width-pixels  = 16
     2883           visible       = true
     2884           sensitive     = true
     2885           movable       = true
     2886           triggers:
     2887             on end-move persistent run diasize_end-move in this-procedure .
     2888           end triggers.
     2889         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2890         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2891         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2892         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2893         assign
     2894           v-diasize-wndmax = false
     2895         .
     2896         if connected("ub") = true
     2897         then do:
     2898           define variable v-cntxt-db-num        as integer   no-undo .
     2899           define variable v-cntxt-userid        as character no-undo .
     2900           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2901                                             , OUTPUT v-cntxt-userid
     2902                                             ) .
     2903           run gbl/wndpar_r.p
     2904             (input  v-cntxt-db-num
     2905             ,input  v-cntxt-userid
     2906             ,input  'wndmax':U
     2907             ,output v-diasize-wndmax
     2908             ,output v-default-value
     2909             ) .
     2910         end.
     2911         assign
     2912           v-diasize-wndstore = false
     2913         .
     2914         if connected("ub") = true
     2915         then do:
     2916           run gbl/wndpar_r.p
     2917             (input  v-cntxt-db-num
     2918             ,input  v-cntxt-userid
     2919             ,input  'wndstore':U
     2920             ,output v-diasize-wndstore
     2921             ,output v-default-value
     2922             ) .
     2923         end.
     2924         assign
     2925           v-diasize-proc-name = entry(1, program-name(2), '.')
     2926         .
     2927         if v-diasize-wndstore = true
     2928         then do:
     2929           assign
     2930             v-restore-saved = false
     2931           .
     2932           if connected("ub") = true
     2933           then do:
     2934             run gbl/wndsizer.p
     2935               (input  v-cntxt-db-num
     2936               ,input  v-cntxt-userid
     2937               ,input  v-diasize-proc-name
     2938               ,input  'height':u
     2939               ,output v-resize-value-str
     2940               ) .
     2941             if v-resize-value-str <> '':U
     2942             then do:
     2943               run diasize_change-height in this-procedure
     2944                 (input  integer(v-resize-value-str)
     2945                 ,input  true
     2946                 ) .
     2947               assign
     2948                 v-restore-saved = true
     2949               .
     2950             end.
     2951           end.
     2952           if connected("ub") = true
     2953           then do:
     2954             run gbl/wndsizer.p
     2955               (input  v-cntxt-db-num
     2956               ,input  v-cntxt-userid
     2957               ,input  v-diasize-proc-name
     2958               ,input  'width':u
     2959               ,output v-resize-value-str
     2960               ) .
     2961             if v-resize-value-str <> '':U
     2962             then do:
     2963               run diasize_change-width in this-procedure
     2964                 (input  integer(v-resize-value-str)
     2965                 ,input  true
     2966                 ) .
     2967               assign
     2968                 v-restore-saved = true
     2969               .
     2970             end.
     2971           end.
     2972           if v-restore-saved <> true
     2973           then do:
     2974             if v-diasize-wndmax = true
     2975             then do:
     2976               run diasize_maximize in this-procedure
     2977                 (input  true
     2978                 ) .
     2979             end.
     2980           end.
     2981         end.
     2982         else do:
     2983           if v-diasize-wndmax = true
     2984           then do:
     2985             run diasize_maximize in this-procedure
     2986               (input  true
     2987               ) .
     2988           end.
     2989         end.
     2990       end.
     2991     end.
     2992   end procedure.
     2993   procedure diasize_need-full-display :
     2994     define output parameter p-need-full-display as logical   no-undo .
     2995     do
     2996     on error undo, return error return-value
     2997     :
     2998       assign
     2999         p-need-full-display = v-diasize-need-full-display
     3000       .
     3001       assign
     3002         v-diasize-need-full-display = false
     3003       .
     3004     end.
     3005   end procedure.
     3006   procedure get-context :
     3007      define output parameter p-db-num as integer          no-undo.
     3008      define output parameter p-user-id as character        no-undo.
     3009      define variable v-login               as character    no-undo.
     3010      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3011      define buffer buf_user-login  for ub.user-login .
     3012      do
     3013      on error undo, return error
     3014      :
     3015            FIND FIRST buf_sys-ctrl no-lock.
     3016            ASSIGN
     3017               v-login = USERID("ub")
     3018               p-db-num = buf_sys-ctrl.db-num
     3019            .
     3020            FIND FIRST buf_user-login
     3021                 WHERE buf_user-login.db-num = p-db-num
     3022                   AND buf_user-login.user-login = v-login
     3023                 no-lock
     3024                 no-error
     3025                 .
     3026            IF AVAILABLE buf_user-login
     3027            THEN DO:
     3028               assign
     3029                  p-user-id = buf_user-login.user-id
     3030               .
     3031            END.
     3032      end.
     3033   end procedure.
     3034     run diasize_init in this-procedure .
     3035     WAIT-FOR GO OF FRAME Dialog-Frame.
     3036   END.
     3037   RUN disable_UI.
     3038   PROCEDURE proc-b-mark :
     3039     define variable varlog as logical   no-undo .
     3040     if not available tt-objs then return.
     3041     run local-mark in this-procedure.
     3042     assign varlog = br-objects :select-next-row( ) in frame Dialog-Frame.
     3043     apply "ENTRY":U to br-objects in frame Dialog-Frame.
     3044     br-objects:refresh() in frame Dialog-Frame .
     3045   END PROCEDURE.
     3046   PROCEDURE local-mark :
     3047     if not available tt-objs then do:
     3048       message "Неправильный выбор строки.".
     3049       return no-apply.
     3050     end.
     3051   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3052   define variable v-str-recid15 as character no-undo .
     3053   define variable v-num-entry15 as integer   no-undo .
     3054   assign
     3055     v-str-recid15 = trim( string( recid( tt-objs ) , "->>>>>>>>>>>9":U ) )
     3056     v-num-entry15 = lookup( v-str-recid15 , select-list )
     3057   .
     3058   if v-num-entry15 > 0 then do:
     3059     assign
     3060       entry( v-num-entry15, select-list ) = "":U
     3061       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     3062     .
     3063   end.
     3064   else do:
     3065     assign
     3066       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid15
     3067     .
     3068   end.
     3069     br-objects:refresh() in frame Dialog-Frame .
     3070   END PROCEDURE.
     3071   PROCEDURE fill-tt :
     3072       for each tt-objs :
     3073           delete tt-objs .
     3074       end.
     3075       do ii = 1 to num-entries(clients-list) :
     3076       for first buf_clients no-lock
     3077          where recid(buf_clients) = integer(entry(ii, clients-list)) :
     3078   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3079     (input  'alcohol'
     3080     ,input  buf_clients.host-code
     3081     ,input  buf_clients.obj-type
     3082     ,input  buf_clients.obj-code
     3083     ,input  ''
     3084     ,input  ''
     3085     ,input  ''
     3086     ,input  no
     3087     ,output par-alcohol
     3088     ,output par-type
     3089     ) no-error .
     3090    .
     3091           if par-alcohol = "yes" then do :
     3092               find first buf_firm no-lock where buf_firm.firm-code = buf_clients.obj-code no-error .
     3093               RUN clntattr-value IN THIS-PROCEDURE
     3094                   (INPUT buf_clients.obj-type,
     3095                    INPUT buf_clients.obj-code,
     3096                    input 'kpp':U,
     3097                    OUTPUT v-kpp,
     3098                    OUTPUT par-type).
     3099               create tt-objs.
     3100               assign
     3101                   tt-objs.obj-type            = buf_clients.obj-type
     3102                   tt-objs.obj-code            = buf_clients.obj-code
     3103                   tt-objs.obj-name-th         = buf_clients.obj-name
     3104                   tt-objs.inn                 = if available buf_firm then buf_firm.inn else ""
     3105                   tt-objs.kpp                 = if v-kpp <> ? and v-kpp <> "" then v-kpp else (if available buf_firm then buf_firm.kpp else "")
     3106               .
     3107               run gen-key-rec in this-procedure   ( input 'clients':U
     3108                                                    ,input buffer buf_clients:handle
     3109                                                    ,output v-obj-uniq-key-rec).
     3110               find first X_ext-classif no-lock  where X_ext-classif.classif-subject = 'clients':U
     3111                                                  and X_ext-classif.classif-name = 'clients-esys':U
     3112                                                  AND X_ext-classif.db-num = 0
     3113                                                  and X_ext-classif.key#_one = v-ext-sys
     3114                                                  and X_ext-classif.key#_two = 0
     3115                                                  and X_ext-classif.key#_three = 0
     3116                                                  and X_eXt-classif.uniq-key-rec = v-obj-uniq-key-rec
     3117                                                  and X_eXt-classif.CharKey_One = ''
     3118                                                  and X_eXt-classif.CharKey_two = (tt-objs.obj-type + string(tt-objs.obj-code))
     3119                                                  and X_eXt-classif.nonunique = 0
     3120                                                  no-error.
     3121               if available X_ext-classif then do :
     3122                   assign tt-objs.regID = X_ext-classif.charkey_three .
     3123               end.
     3124               find first buf_clients-attr no-lock where buf_clients-attr.obj-type = buf_clients.obj-type
     3125                                                   and   buf_clients-attr.obj-code = buf_clients.obj-code
     3126                                                   and   buf_clients-attr.attr-code = 'requisite-alc-decl':U no-error.
     3127               if available buf_clients-attr then do :
     3128                   assign
     3129                       tt-objs.obj-name-egais      = entry( 1, buf_clients-attr.attr-value, "|")
     3130                       tt-objs.country             = entry( 3, buf_clients-attr.attr-value, "|")
     3131                       tt-objs.postIndex           = entry( 4, buf_clients-attr.attr-value, "|")
     3132                       tt-objs.regionCode          = entry( 5, buf_clients-attr.attr-value, "|")
     3133                       tt-objs.district            = entry( 6, buf_clients-attr.attr-value, "|")
     3134                       tt-objs.city                = entry( 7, buf_clients-attr.attr-value, "|")
     3135                       tt-objs.settlement          = entry( 8, buf_clients-attr.attr-value, "|")
     3136                       tt-objs.street              = entry( 9, buf_clients-attr.attr-value, "|")
     3137                       tt-objs.house-number        = entry(10, buf_clients-attr.attr-value, "|")
     3138                       tt-objs.house-case          = entry(11, buf_clients-attr.attr-value, "|")
     3139                       tt-objs.house-apartment     = entry(12, buf_clients-attr.attr-value, "|")
     3140                       tt-objs.house-litera        = entry(13, buf_clients-attr.attr-value, "|")
     3141                       no-error
     3142                   .
     3143                   assign tt-objs.description_ = replace(entry(20, buf_clients-attr.attr-value, "|"), CHR(5), "|") no-error .
     3144                   run gen-key-rec in this-procedure   ( input 'clients':U
     3145                                                        ,input buffer buf_clients:handle
     3146                                                        ,output v-obj-uniq-key-rec).
     3147                   find first X_ext-classif-attr no-lock  where X_ext-classif-attr.classif-subject = 'clients':U
     3148                                                              and X_ext-classif-attr.classif-name = 'clients-esys':U
     3149                                                              AND X_ext-classif-attr.db-num = 0
     3150                                                              and X_ext-classif-attr.key#_one = v-ext-sys
     3151                                                              and X_ext-classif-attr.key#_two = 0
     3152                                                              and X_ext-classif-attr.key#_three = 0
     3153                                                              and X_ext-classif-attr.CharKey_One = ''
     3154                                                              and X_ext-classif-attr.CharKey_two = (tt-objs.obj-type + string(tt-objs.obj-code))
     3155                                                              and X_ext-classif-attr.CharKey_Three = tt-objs.regID
     3156                                                              and X_ext-classif-attr.nonunique = 0
     3157                                                              and X_ext-classif-attr.attr-code = 'egais-cli-info'
     3158                                                              no-error.
     3159                     if not available (X_ext-classif-attr)
     3160                     then do:
     3161                       tt-objs.versionWB = ?.
     3162                     end.
     3163                     else do:
     3164                       assign
     3165                         tt-objs.versionWB = entry (1, X_ext-classif-attr.attr-value, chr(4))
     3166                         tt-objs.typeEgais = entry (2, X_ext-classif-attr.attr-value, chr(4))
     3167                         no-error.
     3168                     end.
     3169               end.
     3170           end.
     3171       end.
     3172       end.
     3173   END PROCEDURE.
     3174   procedure proc-b-list :
     3175   define input parameter p-option as character no-undo .
     3176   define variable imp-type as character no-undo.
     3177   define variable imp-code as integer   no-undo.
     3178       assign clients-list = "" .
     3179       case p-option :
     3180           when "new" then do :
     3181               run str/cli-list.w ( input parparentproc, v-cntxt-host-code-obj, v-cntxt-obj-type, v-cntxt-obj-code).
     3182               for each cli-list no-lock :
     3183                   find clients where
     3184                        clients.obj-type = cli-list.obj-type and
     3185                        CLIENTS.OBJ-code = cli-list.obj-code
     3186                        no-lock no-error.
     3187                   if available CLIENTS then do:
     3188   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3189   define variable v-str-recid17 as character no-undo .
     3190   define variable v-num-entry17 as integer   no-undo .
     3191   assign
     3192     v-str-recid17 = trim( string( recid( CLIENTS ) , "->>>>>>>>>>>9":U ) )
     3193     v-num-entry17 = lookup( v-str-recid17 , clients-list )
     3194   .
     3195   if v-num-entry17 > 0 then do:
     3196     assign
     3197       entry( v-num-entry17, clients-list ) = "":U
     3198       clients-list = trim( replace( clients-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     3199     .
     3200   end.
     3201   else do:
     3202     assign
     3203       clients-list = clients-list + ( if clients-list = "":U then "":U else chr(44) ) + v-str-recid17
     3204     .
     3205   end.
     3206                   end.
     3207               end.
     3208           end.
     3209           when "file" then do :
     3210               system-dialog get-file v-file-name
     3211               filters "Списки клиентов *.cli" "*.cli"
     3212               title "Выберите файл списка"
     3213               INITIAL-DIR "."
     3214               return-to-start-dir
     3215               must-exist
     3216               update glog
     3217               default-extension "cli".
     3218               if not glog then do:
     3219                   OPEN QUERY br-objects FOR EACH tt-objs.
     3220                   return error.
     3221               end.
     3222           end.
     3223           when "db" then do :
     3224               run ref/clobbnds.w ( input parparentproc
     3225                                     ,input this-procedure:handle
     3226                                     ,input 'b-sel'
     3227                                     ,input "uniq-key-rec"
     3228                                     ,input ""
     3229                                     ,input 'list':U
     3230                                     ,input 'cli-list'
     3231                                     ,input -1
     3232                                     ,input-output v-rid-list) no-error.
     3233               if v-rid-list = '' then do:
     3234                   OPEN QUERY br-objects FOR EACH tt-objs.
     3235                   return error.
     3236               end.
     3237               find first buf_clob-bind no-lock where
     3238                       recid(buf_clob-bind) = integer(v-rid-list) .
     3239               find first buf_clob-data no-lock where
     3240                          buf_clob-data.db-num = buf_clob-bind.db-num
     3241                      and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     3242               if error-status :error then do:
     3243                   message
     3244                   "Ошибка при пополучении хранимого файла"
     3245                   view-as alert-box error.
     3246                   return error.
     3247               end.
     3248               run gbl/_tmpfile.p ( input ""
     3249                                   ,input "tmp"
     3250                                   ,output v-file-name) .
     3251               copy-lob from object buf_clob-data.cdata
     3252               to file v-file-name.
     3253           end.
     3254       end case .
     3255       if p-option <> "new" then do :
     3256           run gbl/filename.p (
     3257              input  v-file-name
     3258             ,output v-full-path
     3259             ,output v-path
     3260             ,output v-file-name
     3261             ,output v-file-name-no-ext
     3262             ,output v-file-name-ext
     3263             ) no-error .
     3264           if error-status:error then do:
     3265           end.
     3266           else do :
     3267               input stream sout from value (v-full-path).
     3268               repeat:
     3269                 import stream sout imp-type imp-code no-error.
     3270                 find clients where
     3271                     clients.obj-type = imp-type and
     3272                     CLIENTS.OBJ-code = imp-code
     3273                     no-lock no-error.
     3274                 if available CLIENTS then do:
     3275   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3276   define variable v-str-recid19 as character no-undo .
     3277   define variable v-num-entry19 as integer   no-undo .
     3278   assign
     3279     v-str-recid19 = trim( string( recid( CLIENTS ) , "->>>>>>>>>>>9":U ) )
     3280     v-num-entry19 = lookup( v-str-recid19 , clients-list )
     3281   .
     3282   if v-num-entry19 > 0 then do:
     3283     assign
     3284       entry( v-num-entry19, clients-list ) = "":U
     3285       clients-list = trim( replace( clients-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     3286     .
     3287   end.
     3288   else do:
     3289     assign
     3290       clients-list = clients-list + ( if clients-list = "":U then "":U else chr(44) ) + v-str-recid19
     3291     .
     3292   end.
     3293                 end.
     3294               end.
     3295           end.
     3296           if p-option = "db" then do:
     3297               os-delete value(v-full-path) .
     3298           end.
     3299           input stream sout close.
     3300       end.
     3301       run fill-tt .
     3302       OPEN QUERY br-objects FOR EACH tt-objs.
     3303       apply "value-changed" to br-objects IN FRAME Dialog-Frame .
     3304   end procedure .
     3305   PROCEDURE disable_UI :
     3306     HIDE FRAME Dialog-Frame.
     3307   END PROCEDURE.
     3308   PROCEDURE enable_UI :
     3309     ENABLE b-mark b-sel-all b-unmark b-load b-answer b-save b-cancel br-objects b-list
     3310         WITH FRAME Dialog-Frame.
     3311     VIEW FRAME Dialog-Frame.
     3312     ASSIGN
     3313          b-list:POPUP-MENU IN FRAME Dialog-Frame       = MENU menu-b-list:HANDLE
     3314          b-list:menu-mouse                             = 1
     3315     .
     3316     br-objects:column-resizable in FRAME Dialog-Frame = true .
     3317     egais:EGAISImpl = new DictOrg(v-cntxt-obj-type, v-cntxt-obj-code, v-fs-rar, v-org-inn) .
     3318     glog = egais:IsSent .
     3319     if glog then enable b-answer WITH FRAME Dialog-Frame.
     3320     else disable b-answer WITH FRAME Dialog-Frame .
     3321     OPEN QUERY br-objects FOR EACH tt-objs.
     3322   END PROCEDURE.
