     1291   define buffer buf_clients for ub.clients .
     1292   define buffer buf_clients-attr for ub.clients-attr .
     1293   DEFINE BUFFER X_ext-classif FOR ub.ext-classif.
     1294   DEFINE BUFFER X_ext-classif-attr FOR ub.ext-classif-attr .
     1295   define buffer buf_clob-bind for ub.clob-bind.
     1296   define buffer buf_clob-data for ub.clob-data.
     1297   define variable select-list as character no-undo .
     1298   define variable clients-list as character no-undo .
     1299   define variable list-option as character no-undo .
     1300   define variable ii          as integer   no-undo .
     1301   define variable v-rid       as recid     no-undo .
     1302   define variable par-alcohol as character no-undo .
     1303   define variable par-type    as character no-undo .
     1304   define variable v-kpp       as character no-undo .
     1305   define variable v-org-inn   as character no-undo .
     1306   define variable v-outId     as character no-undo .
     1307   define variable v-ext-sys   as integer   no-undo .
     1308   define variable v-replyId   as character no-undo .
     1309   define variable v-regID     as character no-undo .
     1310   define variable glog        as logical   no-undo .
     1311   define variable v-obj-uniq-key-rec as character no-undo .
     1312   define variable v-value-character  as character no-undo .
     1313   define variable v-value-decimal    as decimal   no-undo .
     1314   define variable v-value-integer    as integer   no-undo .
     1315   define variable v-value-logical    as logical   no-undo .
     1316   define variable v-value-type       as character no-undo .
     1317   define variable v-value-date       as date      no-undo .
     1318   define variable v-full-path        as character no-undo .
     1319   define variable v-path             as character no-undo .
     1320   define variable v-file-name        as character no-undo init "default.cli" .
     1321   define variable v-file-name-no-ext as character no-undo .
     1322   define variable v-file-name-ext    as character no-undo .
     1323   define stream sout.
     1324   define variable v-rid-list as character no-undo .
     1325   FUNCTION get-mark RETURNS CHARACTER
     1326   (buffer local-obj for tt-objs ):
     1327   if lookup (string (recid (local-obj)), select-list) > 0  then return "*".
     1328                                                              else return "".
     1329   end function.
     1330   FUNCTION get-obj RETURNS CHARACTER
     1331   (buffer local-obj for tt-objs ):
     1332       return (local-obj.obj-type + string(local-obj.obj-code)) .
     1333   end function.
     1334   define variable v-org as character no-undo view-as text format "X(50)" label "Организация" .
     1335   define variable v-fs-rar as character no-undo view-as text format "X(15)" label "Код ФС РАР (FSRAR ID)" .
     1336   define menu menu-b-list
     1337       menu-item m_new-list label "Новый"
     1338       menu-item m_from-file label "Из файла"
     1339       menu-item m_from-db   label "Хранимый в бд"
     1340   .
     1341   DEFINE BUTTON b-list
     1342        LABEL "Открыть список"
     1343        tooltip "Открыть список клиентов"
     1344        SIZE 15 BY 1.14
     1345        BGCOLOR 8 .
     1346   DEFINE BUTTON b-connect
     1347        LABEL "Связать"
     1348        SIZE 15 BY 1.14
     1349        BGCOLOR 8 .
     1350   DEFINE BUTTON b-mark
     1351        LABEL "&*"
     1352        SIZE 3 BY 1.14 .
     1353   DEFINE BUTTON b-cancel AUTO-END-KEY
     1354        LABEL "Выход"
     1355        SIZE 15 BY 1.14
     1356        BGCOLOR 8 .
     1357   DEFINE BUTTON b-load
     1358        LABEL "Запрос"
     1359        tooltip "Отправить запрос в ЕГАИС"
     1360        SIZE 15 BY 1.14
     1361        BGCOLOR 8 .
     1362   DEFINE BUTTON b-save
     1363        LABEL "Сохранить"
     1364        tooltip "Записать данные в справочник"
     1365        SIZE 15 BY 1.14
     1366        BGCOLOR 8 .
     1367   DEFINE BUTTON b-answer
     1368        LABEL "Получить ответ"
     1369        SIZE 15 BY 1.14
     1370        BGCOLOR 8 .
     1371   DEFINE BUTTON b-lkp
     1372        LABEL "Просмотр"
     1373        SIZE 15 BY 1.14
     1374        BGCOLOR 8 .
     1375   DEFINE BUTTON b-sel-all
     1376        LABEL "&+":L
     1377        SIZE 3 BY 1.14 TOOLTIP "Отметить все объекты".
     1378   DEFINE BUTTON b-unmark
     1379        LABEL "&-":L
     1380        SIZE 3 BY 1.14 TOOLTIP "Снять все отметки".
     1381   DEFINE QUERY br-objects FOR
     1382         tt-objs SCROLLING.
     1383   DEFINE BROWSE br-objects
     1384     QUERY br-objects DISPLAY
     1385       get-mark(BUFFER tt-objs) COLUMN-LABEL "*"  FORMAT "X(1)":U
     1386       tt-objs.answerExist COLUMN-LABEL "O" FORMAT "+/-":U
     1387       tt-objs.regID COLUMN-LABEL "Регистрационный номер" FORMAT "X(21)":U
     1388       get-obj(buffer tt-objs) COLUMN-LABEL "Объект" FORMAT "X(12)":U
     1389       tt-objs.inn COLUMN-LABEL "ИНН" FORMAT "X(12)":U
     1390       tt-objs.kpp COLUMN-LABEL "КПП" FORMAT "X(9)":U
     1391       tt-objs.obj-name-th COLUMN-LABEL "Наименование в TH" width 25
     1392       tt-objs.obj-name-egais COLUMN-LABEL "Наименование ЕГАИС" width 25
     1393       tt-objs.country COLUMN-LABEL "Страна" FORMAT "X(6)":U
     1394       tt-objs.regionCode COLUMN-LABEL "Регион" FORMAT "X(6)":U
     1395       tt-objs.description_ COLUMN-LABEL "Адрес" width 87
     1396       tt-objs.versionWB COLUMN-LABEL "Версия XSD" width 10
     1397       WITH NO-ROW-MARKERS SEPARATORS SIZE 105 BY 21.5 FIT-LAST-COLUMN.
     1398   DEFINE FRAME Dialog-Frame
     1399        b-mark AT ROW 2.6 COL 2
     1400        b-sel-all AT ROW 2.6 COL 5
     1401        b-unmark AT ROW 2.6 COL 8
     1402        b-load AT ROW 1.24 COL 32
     1403        b-answer AT ROW 1.24 COL 47
     1404        b-save AT ROW 1.24 COL 17
     1405        b-lkp AT ROW 1.24 COL 62
     1406        b-cancel AT ROW 1.24 COL 2
     1407        b-list AT ROW 2.6 COL 11
     1408        b-connect AT ROW 1.24 COL 77
     1409        br-objects AT ROW 3.8 COL 2 WIDGET-ID 200
     1410        SPACE(1) SKIP(0.32)
     1411       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1412            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1413            TITLE "Клиенты ЕГАИС"
     1414            DEFAULT-BUTTON b-load CANCEL-BUTTON b-cancel WIDGET-ID 100.
     1415   assign br-objects:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 1 .
     1416   ASSIGN
     1417          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1418          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1419   ASSIGN
     1420          b-list:POPUP-MENU IN FRAME Dialog-Frame       = MENU menu-b-list:HANDLE .
     1421   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1422   DO:
     1423     APPLY "END-ERROR":U TO SELF.
     1424   END.
     1425   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     1426   DO:
     1427       message "Все несохранённые данные будут потеряны. Вы уверены, что хотите выйти?"
     1428       view-as alert-box question buttons yes-no update glog.
     1429       if not glog then return no-apply .
     1430   END.
     1431   ON CHOOSE OF MENU-ITEM m_new-list
     1432   DO:
     1433     assign
     1434     list-option = "new":U.
     1435     apply "choose" to b-list in frame Dialog-Frame.
     1436   END.
     1437   ON CHOOSE OF MENU-ITEM m_from-file
     1438   DO:
     1439     assign
     1440     list-option = "file":U.
     1441     apply "choose" to b-list in frame Dialog-Frame.
     1442   END.
     1443   ON CHOOSE OF MENU-ITEM m_from-db
     1444   DO:
     1445     assign
     1446     list-option = "db":U.
     1447     apply "choose" to b-list in frame Dialog-Frame.
     1448   END.
     1449   ON CHOOSE OF B-list IN FRAME Dialog-Frame
     1450   DO:
     1451      if list-option = "" then do:
     1452          run gbl/pop-up.p ( input self:handle, input no) no-error.
     1453      end.
     1454      run proc-b-list in this-procedure ( input list-option ) no-error.
     1455      if error-status:error then return no-apply.
     1456   END.
     1457   ON CHOOSE OF b-connect IN FRAME Dialog-Frame
     1458   DO:
     1459       if not available tt-objs then return no-apply .
     1460       if tt-objs.connected_ then do :
     1461           buffer tt-objs-eg:find-unique (substitute("where tt-objs-EG.regID = '&1'", trim(tt-objs.regID)), no-lock) no-error.
     1462           assign
     1463               tt-objs.regID = ""
     1464               tt-objs.connected_ = false
     1465               b-connect:label = "Связать"
     1466           .
     1467           if buffer tt-objs-eg:available then
     1468           assign
     1469               buffer tt-objs-eg:buffer-field ("connected_"):buffer-value = false
     1470           .
     1471       end.
     1472       else do :
     1473           run bge/egais-select-cli.w (input tt-objs.inn ,
     1474                                       input tt-objs.kpp ,
     1475                                       input buffer tt-objs-EG:handle ,
     1476                                       output v-regID ) .
     1477           if v-regID <> "" and v-regID <> ? then do :
     1478               assign
     1479                   tt-objs.regID = v-regID
     1480                   tt-objs.connected_ = true
     1481               .
     1482           end.
     1483       end.
     1484       br-objects:refresh() in frame Dialog-Frame .
     1485       apply "value-changed" to br-objects IN FRAME Dialog-Frame .
     1486   END.
     1487   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1488   DO:
     1489     run proc-b-mark in this-procedure no-error.
     1490   END.
     1491   ON CHOOSE OF b-sel-all IN FRAME Dialog-Frame
     1492   DO:
     1493     assign select-list = "".
     1494     if not available tt-objs then return.
     1495     for each tt-objs no-lock :
     1496   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1497   define variable v-str-recid10 as character no-undo .
     1498   define variable v-num-entry10 as integer   no-undo .
     1499   assign
     1500     v-str-recid10 = trim( string( recid( tt-objs ) , "->>>>>>>>>>>9":U ) )
     1501     v-num-entry10 = lookup( v-str-recid10 , select-list )
     1502   .
     1503   if v-num-entry10 > 0 then do:
     1504     assign
     1505       entry( v-num-entry10, select-list ) = "":U
     1506       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1507     .
     1508   end.
     1509   else do:
     1510     assign
     1511       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid10
     1512     .
     1513   end.
     1514     end.
     1515     br-objects:refresh() in frame Dialog-Frame .
     1516   END.
     1517   ON CHOOSE OF b-unmark IN FRAME Dialog-Frame
     1518   DO:
     1519     if not available tt-objs then return.
     1520     select-list  = "".
     1521     br-objects:refresh() in frame Dialog-Frame .
     1522   END.
     1523   ON CHOOSE OF b-save IN FRAME Dialog-Frame
     1524   DO:
     1525       if select-list = "" then do :
     1526           message "Не выбрано ни одной строки" view-as alert-box .
     1527           return no-apply.
     1528       end.
     1529       do ii = 1 to num-entries(select-list) :
     1530           for first tt-objs exclusive-lock where recid(tt-objs) = integer(entry(ii, select-list)) and tt-objs.connected_ :
     1531               find tt-objs-EG no-lock where tt-objs-EG.regID = tt-objs.regID no-error .
     1532               if available tt-objs-EG and not ambiguous tt-objs-EG then do transaction :
     1533                   buffer-copy tt-objs-EG except obj-type obj-code obj-name-th to tt-objs .
     1534                   find first buf_clients-attr exclusive-lock  where buf_clients-attr.obj-type = tt-objs.obj-type
     1535                                                               and   buf_clients-attr.obj-code = tt-objs.obj-code
     1536                                                               and   buf_clients-attr.attr-code = 'requisite-alc-decl':U
     1537                                                               no-error.
     1538                   if not available buf_clients-attr then do :
     1539                       create buf_clients-attr .
     1540                       assign
     1541                           buf_clients-attr.obj-type = tt-objs.obj-type
     1542                           buf_clients-attr.obj-code = tt-objs.obj-code
     1543                           buf_clients-attr.attr-code = 'requisite-alc-decl':U
     1544                       .
     1545                   end.
     1546                   buf_clients-attr.attr-value = tt-objs.obj-name-egais + "||"
     1547                                               + tt-objs.country + "|"
     1548                                               + tt-objs.postIndex + "|"
     1549                                               + tt-objs.regionCode + "|"
     1550                                               + tt-objs.district + "|"
     1551                                               + tt-objs.city + "|"
     1552                                               + tt-objs.settlement + "|"
     1553                                               + tt-objs.street + "|"
     1554                                               + tt-objs.house-number + "|"
     1555                                               + tt-objs.house-case + "|"
     1556                                               + tt-objs.house-apartment + "|"
     1557                                               + tt-objs.house-litera + "|||||||"
     1558                                               + replace(tt-objs.description_, "|", CHR(5))
     1559                   .
     1560                   if tt-objs.regID <> "" then do :
     1561                       find first buf_clients no-lock where buf_clients.obj-type = tt-objs.obj-type and buf_clients.obj-code = tt-objs.obj-code .
     1562                       run gen-key-rec in this-procedure   ( input 'clients':U
     1563                                                            ,input buffer buf_clients:handle
     1564                                                            ,output v-obj-uniq-key-rec).
     1565                       find first X_ext-classif exclusive-lock  where X_ext-classif.classif-subject = 'clients':U
     1566                                                                  and X_ext-classif.classif-name = 'clients-esys':U
     1567                                                                  AND X_ext-classif.db-num = 0
     1568                                                                  and X_ext-classif.key#_one = v-ext-sys
     1569                                                                  and X_ext-classif.key#_two = 0
     1570                                                                  and X_ext-classif.key#_three = 0
     1571                                                                  and X_eXt-classif.uniq-key-rec = v-obj-uniq-key-rec
     1572                                                                  and X_eXt-classif.CharKey_One = ''
     1573                                                                  and X_eXt-classif.CharKey_two = (tt-objs.obj-type + string(tt-objs.obj-code))
     1574                                                                  and X_eXt-classif.nonunique = 0
     1575                                                                  no-error.
     1576                       if available X_ext-classif then do :
     1577                           find first X_ext-classif-attr exclusive-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     1578                                                                          and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     1579                                                                          and X_ext-classif-attr.db-num = X_ext-classif.db-num
     1580                                                                          and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     1581                                                                          and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     1582                                                                          and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     1583                                                                          and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     1584                                                                          and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     1585                                                                          and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     1586                                                                          and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     1587                                                                          and X_ext-classif-attr.attr-code = 'egais-cli-info'
     1588                                                                          no-error .
     1589                           if not available X_ext-classif-attr then do :
     1590                               create X_ext-classif-attr .
     1591                               assign
     1592                                   X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     1593                                   X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     1594                                   X_ext-classif-attr.db-num = X_ext-classif.db-num
     1595                                   X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     1596                                   X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     1597                                   X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     1598                                   X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     1599                                   X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     1600                                   X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     1601                                   X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     1602                                   X_ext-classif-attr.attr-code = 'egais-cli-info'
     1603                               .
     1604                           end.
     1605                           assign
     1606                               X_ext-classif.charkey_three = tt-objs.regID
     1607                               X_ext-classif-attr.charkey_three = tt-objs.regID
     1608                           .
     1609                           assign X_ext-classif-attr.attr-value = tt-objs.versionWB + CHR(4) + tt-objs.typeEgais .
     1610                       end.
     1611                       else do :
     1612                           run ref/extclas1.p ( INPUT 'ДОБАВЛЕНИЕ':U
     1613                                               ,INPUT yes
     1614                                               ,INPUT-OUTPUT v-rid
     1615                                               ,INPUT 'clients':U
     1616                                               ,INPUT 'clients-esys':U
     1617                                               ,input 0
     1618                                               ,input v-ext-sys
     1619                                               ,input 0
     1620                                               ,input 0
     1621                                               ,input '':U
     1622                                               ,input (tt-objs.obj-type + string(tt-objs.obj-code))
     1623                                               ,input tt-objs.regID
     1624                                               ,input 0
     1625                                               ,input v-obj-uniq-key-rec ) no-error.
     1626                           if error-status:error then do:
     1627                             message return-value skip error-status:get-message(1) view-as alert-box .
     1628                             undo, return no-apply .
     1629                           end.
     1630                           find first X_ext-classif no-lock where recid(X_ext-classif) = v-rid.
     1631                           find first X_ext-classif-attr exclusive-lock where X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     1632                                                                          and X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     1633                                                                          and X_ext-classif-attr.db-num = X_ext-classif.db-num
     1634                                                                          and X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     1635                                                                          and X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     1636                                                                          and X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     1637                                                                          and X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     1638                                                                          and X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     1639                                                                          and X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     1640                                                                          and X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     1641                                                                          and X_ext-classif-attr.attr-code = 'egais-cli-info'
     1642                                                                          no-error .
     1643                           if not available X_ext-classif-attr then do :
     1644                               create X_ext-classif-attr .
     1645                               assign
     1646                                   X_ext-classif-attr.classif-subject = X_ext-classif.classif-subject
     1647                                   X_ext-classif-attr.classif-name = X_ext-classif.classif-name
     1648                                   X_ext-classif-attr.db-num = X_ext-classif.db-num
     1649                                   X_ext-classif-attr.Key#_One = X_ext-classif.key#_one
     1650                                   X_ext-classif-attr.Key#_two = X_ext-classif.key#_two
     1651                                   X_ext-classif-attr.Key#_three = X_ext-classif.key#_three
     1652                                   X_ext-classif-attr.CharKey_One = X_eXt-classif.charkey_one
     1653                                   X_ext-classif-attr.CharKey_two = X_eXt-classif.charkey_two
     1654                                   X_ext-classif-attr.CharKey_three = X_eXt-classif.charkey_three
     1655                                   X_ext-classif-attr.nonunique = X_eXt-classif.nonunique
     1656                                   X_ext-classif-attr.attr-code = 'egais-cli-info'
     1657                               .
     1658                           end.
     1659                           assign X_ext-classif-attr.attr-value = tt-objs.versionWB + CHR(4) + tt-objs.typeEgais .
     1660                       end.
     1661                   end.
     1662               end.
     1663           end.
     1664       end.
     1665       message "Сохранение завершено" view-as alert-box.
     1666       br-objects:refresh() in frame Dialog-Frame .
     1667   END.
     1668   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1669   DO:
     1670       if available tt-objs and tt-objs.obj-code <> 0 then do :
     1671           find first tt-objs-EG no-lock where tt-objs-EG.regID = tt-objs.regID no-error .
     1672           if available tt-objs-EG then do :
     1673               run bge/egais-obj-diff.w (input rowid(tt-objs), input buffer tt-objs:handle, input buffer tt-objs-EG:handle).
     1674           end.
     1675       end.
     1676   END.
     1677   ON CHOOSE OF b-load IN FRAME Dialog-Frame
     1678   DO:
     1679       if select-list = "" then do :
     1680           message "Не выбрано ни одной строки" view-as alert-box .
     1681           return no-apply.
     1682       end.
     1683       ii1_:
     1684       do ii = 1 to num-entries(select-list) :
     1685           for first tt-objs no-lock where recid(tt-objs) = integer(entry(ii, select-list)):
     1686               if trim(tt-objs.inn) = "" then do :
     1687                   message "Не у всех выделенных клиентов проставлен ИНН. Для них запрос отправлен НЕ будет" view-as alert-box.
     1688                   leave ii1_.
     1689               end.
     1690           end.
     1691       end.
     1692       ii2_:
     1693       do ii = 1 to num-entries(select-list) :
     1694           for first tt-objs no-lock where recid(tt-objs) = integer(entry(ii, select-list)) and trim(tt-objs.inn) <> ""  :
     1695               egais:EGAISImpl = new DictOrg(v-cntxt-obj-type, v-cntxt-obj-code, v-fs-rar, tt-objs.inn) .
     1696               egais:SendRequestUTM() .
     1697           end.
     1698           glog = egais:StatusErr .
     1699           if glog then do :
     1700               message egais:Msg view-as alert-box.
     1701               next.
     1702           end.
     1703       end.
     1704       if egais:IsSent then enable b-answer WITH FRAME Dialog-Frame.
     1705       else disable b-answer WITH FRAME Dialog-Frame .
     1706   END.
     1707   ON CHOOSE OF b-answer IN FRAME Dialog-Frame
     1708   DO:
     1709       if select-list = "" then do :
     1710           message "Не выбрано ни одной строки" view-as alert-box .
     1711           return no-apply.
     1712       end.
     1713       do ii = 1 to num-entries(select-list) :
     1714           for first tt-objs no-lock where recid(tt-objs) = integer(entry(ii, select-list)) :
     1715               egais:EGAISImpl = new DictOrg(v-cntxt-obj-type, v-cntxt-obj-code, v-fs-rar, tt-objs.inn) .
     1716               bh-obj-egais = egais:GetHndlTable() .
     1717               glog = egais:StatusErr .
     1718               if glog then do :
     1719                   message egais:Msg view-as alert-box.
     1720                   return no-apply.
     1721               end.
     1722               if not valid-handle(bh-obj-egais) then do :
     1723                   message "Ошибка при получении ответа от ЕГАИС" view-as alert-box error .
     1724                   return no-apply .
     1725               end.
     1726               create query qh-obj-egais .
     1727               qh-obj-egais:set-buffers (bh-obj-egais) .
     1728               qh-obj-egais:query-prepare ("for each tt-objs-eg").
     1729               qh-obj-egais:query-open.
     1730               _repeat:
     1731               repeat:
     1732                   qh-obj-egais:get-next ().
     1733                   if qh-obj-egais:query-off-end then leave _repeat.
     1734                   create tt-objs-eg.
     1735                   buffer tt-objs-eg:handle:buffer-copy (bh-obj-egais) .
     1736               end.
     1737               assign tt-objs.answerExist = true .
     1738           end.
     1739       end.
     1740       br-objects:refresh() in frame Dialog-Frame .
     1741       apply "value-changed" to br-objects IN FRAME Dialog-Frame .
     1742   END.
     1743   on row-display of br-objects IN FRAME Dialog-Frame
     1744   DO:
     1745       if tt-objs.regID <> ? and tt-objs.regID <> "" then do :
     1746           find tt-objs-eg exclusive-lock where tt-objs-eg.regID = tt-objs.regID no-error .
     1747       end.
     1748       else do :
     1749           find tt-objs-eg exclusive-lock where tt-objs-eg.inn = tt-objs.inn and tt-objs-eg.kpp = tt-objs.kpp no-error .
     1750       end.
     1751       if available tt-objs-eg and not ambiguous tt-objs-eg then do :
     1752           assign
     1753               tt-objs.regID = tt-objs-eg.regID
     1754               tt-objs.connected_ = true
     1755               tt-objs-eg.connected_ = true
     1756           .
     1757           if tt-objs-eg.obj-name-egais    <> tt-objs.obj-name-egais   then tt-objs.obj-name-egais:bgcolor in browse br-objects = red_color .
     1758           if trim(tt-objs-eg.country)     <> trim(tt-objs.country)    then tt-objs.country:bgcolor        in browse br-objects = red_color .
     1759           if tt-objs-eg.regID             <> tt-objs.regID            then tt-objs.country:bgcolor        in browse br-objects = red_color .
     1760           if tt-objs-eg.description_      <> tt-objs.description_     then tt-objs.description_:bgcolor   in browse br-objects = red_color .
     1761           if tt-objs-eg.regionCode        <> tt-objs.regionCode       then tt-objs.regionCode:bgcolor     in browse br-objects = red_color .
     1762           if tt-objs.versionWB            = ? or tt-objs.versionWB = "" then tt-objs.regionCode:bgcolor     in browse br-objects = red_color .
     1763       end.
     1764   end.
     1765   on value-changed of br-objects IN FRAME Dialog-Frame
     1766   DO:
     1767       if available tt-objs then do :
     1768           if tt-objs.connected_ then do :
     1769               enable b-connect b-lkp WITH FRAME Dialog-Frame.
     1770               b-connect:label = "Отвязать" .
     1771           end.
     1772           else do :
     1773               disable b-lkp WITH FRAME Dialog-Frame.
     1774               b-connect:label = "Связать" .
     1775               if tt-objs.answerExist then enable b-connect WITH FRAME Dialog-Frame.
     1776               else disable b-connect WITH FRAME Dialog-Frame.
     1777           end.
     1778           if tt-objs.regID <> ? and tt-objs.regID <> "" then do :
     1779               find tt-objs-eg no-lock where tt-objs-eg.regID = tt-objs.regID no-error.
     1780               if not ambiguous tt-objs-eg then disable b-connect WITH FRAME Dialog-Frame.
     1781           end.
     1782       end.
     1783   end.
     1784   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1785   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1786   MAIN-BLOCK:
     1787   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1788      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1789   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1790     run mainmenu_getcntxt in parparentproc
     1791       (output v-cntxt-db-num
     1792       ,output v-cntxt-userid
     1793       ,output v-cntxt-level
     1794       ,output v-cntxt-host-code-obj
     1795       ,output v-cntxt-obj-type
     1796       ,output v-cntxt-obj-code
     1797       ,output v-cntxt-db-num-obj
     1798       ,output v-cntxt-is-admin
     1799       ) .
     1800   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1801   do:
     1802     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1803       (input  v-cntxt-db-num
     1804       ,input  v-cntxt-userid
     1805       ,input  0
     1806       ,input  'actn_egais-ref':U
     1807       ,input  'object':U
     1808       ,input  v-cntxt-host-code-obj
     1809       ,input  v-cntxt-obj-type
     1810       ,input  v-cntxt-obj-code
     1811       ,input  0
     1812       ,input  0
     1813       ,input  0
     1814       ,input  true
     1815       ,output glog
     1816       )  .
     1817   end.
     1818     if not glog then  return .
     1819     find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = v-cntxt-host-code-obj.
     1820     find first buf_firm no-lock where buf_firm.firm-code = v-cntxt-host-code-obj.
     1821     if valid-handle(bh-obj-egais) then do :
     1822         delete object bh-obj-egais .
     1823     end.
     1824     if valid-handle(qh-obj-egais) then do :
     1825         delete object qh-obj-egais .
     1826     end.
     1827     empty temp-table thbjattr_thbj-attr .
     1828     run adm/shattri.p (
     1829          input "get":U
     1830         ,input v-cntxt-obj-type
     1831         ,input v-cntxt-obj-code
     1832         ,input 'egais':U
     1833         ,input 'egais-fsrar':U
     1834         ,output v-value-character
     1835         ,output v-value-date
     1836         ,output v-value-decimal
     1837         ,output v-value-integer
     1838         ,output v-value-logical
     1839         ,output v-value-type
     1840         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1841         ) no-error .
     1842     assign
     1843       v-org = buf_clients.obj-name
     1844       v-fs-rar = v-value-character
     1845       v-org-inn = buf_firm.inn
     1846     .
     1847     egais = new EGAIS(v-cntxt-db-num, v-cntxt-userid).
     1848     run adm/shattri.p (
     1849          input "get":U
     1850         ,input '':U
     1851         ,input 0
     1852         ,input 'egais':U
     1853         ,input 'egais-exsys':U
     1854         ,output v-value-character
     1855         ,output v-value-date
     1856         ,output v-value-decimal
     1857         ,output v-value-integer
     1858         ,output v-value-logical
     1859         ,output v-value-type
     1860         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1861         ) no-error .
     1862     assign v-ext-sys = v-value-integer .
     1863     RUN enable_UI.
     1864   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1865   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1866   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1867   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1868   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1869   define variable v-diasize-current-frame-height as decimal   no-undo .
     1870   define variable v-diasize-change-size          as logical   no-undo .
     1871   define variable v-diasize-resize-button        as handle    no-undo .
     1872   define variable v-diasize-wndmax               as logical   no-undo .
     1873   define variable v-diasize-wndstore             as logical   no-undo .
     1874   define variable v-diasize-proc-name            as character no-undo .
