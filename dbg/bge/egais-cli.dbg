        1   using ibs.th.bge.egais.*.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Настройки объектов ЕГАИС".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define new global shared variable g#lib-trn  as handle no-undo .
       70   define new global shared variable g#lib-trn2 as handle no-undo .
       71   define new global shared variable g#lib-trn3 as handle no-undo .
       72   define new global shared variable g#lib-trn4 as handle no-undo .
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119     define variable v-cntxt-db-num        as integer   no-undo .
      120     define variable v-cntxt-userid        as character no-undo .
      121     define variable v-cntxt-level         as character no-undo .
      122     define variable v-cntxt-host-code-obj as integer   no-undo .
      123     define variable v-cntxt-obj-type      as character no-undo .
      124     define variable v-cntxt-obj-code      as integer   no-undo .
      125     define variable v-cntxt-db-num-obj    as integer   no-undo .
      126     define variable v-cntxt-is-admin      as logical   no-undo .
      127   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128   define new global shared variable g#attr-lib  as handle no-undo .
      129   define variable v-attr-lib-variable as handle no-undo .
      130   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      132   procedure thbjattr_code :
      133      define input  parameter p-upper-code     as character no-undo .
      134      define input  parameter p-code           as character no-undo .
      135      define output parameter p-label          as character no-undo .
      136      define output parameter p-user-can-edit  as logical   no-undo .
      137      define output parameter p-output-display as logical   no-undo .
      138      define output parameter p-other          as character no-undo .
      139      define output parameter p-prop-list      as character no-undo .
      140      define output parameter p-prop-type-list as character no-undo .
      141      define output parameter p-prop-label-list as character no-undo .
      142      define output parameter p-global          as logical no-undo .
      143      define output parameter p-host           as logical no-undo .
      144      define output parameter p-shop           as logical no-undo .
      145      define output parameter p-store          as logical no-undo .
      146      define output parameter p-db             as logical no-undo .
      147      define variable p-region as logical no-undo.
      148      run thbjattr_code_reg in this-procedure (
      149                                               p-upper-code,
      150                                               p-code,
      151                                               output p-label,
      152                                               output p-user-can-edit,
      153                                               output p-output-display,
      154                                               output p-other,
      155                                               output p-prop-list,
      156                                               output p-prop-type-list,
      157                                               output p-prop-label-list,
      158                                               output p-global,
      159                                               output p-host,
      160                                               output p-shop,
      161                                               output p-store,
      162                                               output p-db,
      163                                               output p-region
      164                                               ).
      165   end procedure.
      166   procedure thbjattr_code_reg :
      167   define input  parameter p-upper-code     as character no-undo .
      168   define input  parameter p-code           as character no-undo .
      169   define output parameter p-label          as character no-undo .
      170   define output parameter p-user-can-edit  as logical   no-undo .
      171   define output parameter p-output-display as logical   no-undo .
      172   define output parameter p-other          as character no-undo .
      173   define output parameter p-prop-list      as character no-undo .
      174   define output parameter p-prop-type-list as character no-undo .
      175   define output parameter p-prop-label-list as character no-undo .
      176   define output parameter p-global          as logical no-undo .
      177   define output parameter p-host           as logical no-undo .
      178   define output parameter p-shop           as logical no-undo .
      179   define output parameter p-store          as logical no-undo .
      180   define output parameter p-db             as logical no-undo .
      181   define output parameter p-region         as logical no-undo .
      182   do
      183   on error undo, return error return-value
      184   :
      185       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      186       (input  p-upper-code
      187       ,input  p-code
      188       ,output p-label
      189       ,output p-user-can-edit
      190       ,output p-output-display
      191       ,output p-other
      192       ,output p-prop-list
      193       ,output p-prop-type-list
      194       ,output p-prop-label-list
      195       ,output p-global
      196       ,output p-host
      197       ,output p-shop
      198       ,output p-store
      199       ,output p-db
      200       ,output p-region
      201       ) no-error .
      202     if error-status :error
      203     then do:
      204       undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1)).
      205     end.
      206   end.
      207   end procedure.
