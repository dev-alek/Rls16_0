     1260       field obj-name-egais    as character label "Наименование ЕГАИС"     format "X(100)"
     1261       field regID             as character label "Регистрационный номер"  format "X(21)"
     1262       field inn               as character label "ИНН"                    format "X(12)"
     1263       field kpp               as character label "КПП"                    format "X(9)"
     1264       field country           as character label "Код страны"             format "X(10)"
     1265       field regionCode        as character label "Код региона"            format "X(11)"
     1266       field district          as character label "Район"
     1267       field city              as character label "Город"
     1268       field settlement        as character label "Населенный пункт"
     1269       field street            as character label "Улица"
     1270       field house-number      as character label "Номер дома"
     1271       field house-case        as character label "Корпус"
     1272       field house-apartment   as character label "Номер квартиры"
     1273       field house-litera      as character label "Литера"
     1274       field postIndex         as character label "Почтовый индекс"
     1275       field description_      as character label "Адрес"                  format "X(100)"
     1276       field fromEgais         as logical
     1277       field connected_        as logical
     1278       field answerExist       as logical   format "+/-"
     1279       field versionWB         as character format "X(10)"
     1280       field typeEgais         as character format "X(2)"
