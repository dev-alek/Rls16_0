     1235   define  new shared  temp-table cli-list-hist no-undo
     1236   field list-table as character
     1237   field id as integer
     1238   field line as integer
     1239   field hist-mode as character
     1240   field des as character
     1241   field num-recs as integer
     1242   field option_ as character
     1243   field item_ as character
     1244   field status_ as character
     1245   field num-add as integer
     1246   field num-ignored as integer
     1247   field done as logical
     1248   field err_ as logical
     1249   field err-mes as character
