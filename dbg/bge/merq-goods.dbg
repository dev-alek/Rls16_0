     1925   function get-mark returns character
     1926     (buffer local-gds for tt-gds ):
     1927     if select-list <> ? or select-list <> "" then
     1928     do:
     1929       if lookup (string (recid (local-gds)), select-list) > 0  then return "*".
     1930       else return "".
     1931     end.
     1932     else return "".
     1933   end function.
     1934   DEFINE MENU POPUP-MENU-b-import
     1935     MENU-ITEM m_item_import  LABEL "Импорт товаров"
     1936     MENU-ITEM m_item_send    LABEL "Передача данных в УБД".
     1937   DEFINE BUTTON b-alt-units
     1938     LABEL "Доп. ед. изм."
     1939     SIZE 14 BY 1.13
     1940     BGCOLOR 8 .
     1941   DEFINE BUTTON b-cancel AUTO-END-KEY
     1942     LABEL "Выход"
     1943     SIZE 13 BY 1.13
     1944     BGCOLOR 8 .
     1945   DEFINE BUTTON b-connect
     1946     LABEL "Связать"
     1947     SIZE 13 BY 1.13
     1948     BGCOLOR 8 .
     1949   DEFINE BUTTON b-del
     1950     LABEL "Удалить"
     1951     SIZE 13 BY 1.13
     1952     BGCOLOR 8 .
     1953   DEFINE BUTTON b-import
     1954     LABEL "Сервис"
     1955     SIZE 13 BY 1.13 TOOLTIP "Импорт"
     1956     BGCOLOR 8 .
     1957   DEFINE BUTTON b-lkp
     1958     LABEL "Просмотр"
     1959     SIZE 13 BY 1.13
     1960     BGCOLOR 8 .
     1961   DEFINE BUTTON b-load
     1962     LABEL "Запрос"
     1963     SIZE 13 BY 1.13 TOOLTIP "Отправить запрос в Меркурий"
     1964     BGCOLOR 8 .
     1965   DEFINE BUTTON b-mark
     1966     LABEL "&*"
     1967     SIZE 3 BY 1.13.
     1968   DEFINE BUTTON b-prod
     1969     IMAGE-UP FILE "btn-down-arrow":U
     1970     IMAGE-DOWN FILE "btn-down-arrow":U
     1971     IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1972     LABEL ""
     1973     SIZE 3 BY 1.13 TOOLTIP "Выбор производителя".
     1974   DEFINE BUTTON b-sel-all
     1975     LABEL "&+":L
     1976     SIZE 3 BY 1.13 TOOLTIP "Отметить все объекты".
     1977   DEFINE BUTTON b-spisok
     1978     IMAGE-UP FILE "btn-down-arrow":U
     1979     IMAGE-DOWN FILE "btn-down-arrow":U
     1980     IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1981     LABEL "Товары"
     1982     SIZE 3 BY 1.13 TOOLTIP "Выбор товаров".
     1983   DEFINE BUTTON b-unmark
     1984     LABEL "&-":L
     1985     SIZE 3 BY 1.13 TOOLTIP "Снять все отметки".
     1986   DEFINE BUTTON b-update
     1987     LABEL "Изменить"
     1988     SIZE 13 BY 1.13
     1989     BGCOLOR 8 .
     1990   DEFINE VARIABLE guid_       AS CHARACTER FORMAT "X(256)":U
     1991     LABEL "GUID"
     1992     VIEW-AS FILL-IN
     1993     SIZE 33.5 BY 1 NO-UNDO.
     1994   DEFINE VARIABLE v-prod      AS CHARACTER FORMAT "X(11)"
     1995     LABEL "Производитель"
     1996     VIEW-AS TEXT
     1997     SIZE 11 BY .67 NO-UNDO.
     1998   DEFINE VARIABLE v-prod-name AS CHARACTER FORMAT "X(30)"
     1999     VIEW-AS TEXT
     2000     SIZE 30 BY .67 NO-UNDO.
     2001   DEFINE VARIABLE r-type      AS INTEGER   INITIAL 1
     2002     VIEW-AS RADIO-SET VERTICAL
     2003     RADIO-BUTTONS
     2004     "По производителю", 1,
     2005     "По списку товаров", 2
     2006     SIZE 26 BY 1.75 NO-UNDO.
     2007   DEFINE VARIABLE rs-sort     AS INTEGER   INITIAL 3
     2008     VIEW-AS RADIO-SET HORIZONTAL
     2009     RADIO-BUTTONS
     2010     "&связан", 1,
     2011     "&не связан", 2,
     2012     "&все", 3
     2013     SIZE 40 BY 1.13 NO-UNDO.
     2014   DEFINE QUERY br-goods FOR
     2015     tt-gds SCROLLING.
     2016   DEFINE BROWSE br-goods
     2017     QUERY br-goods DISPLAY
     2018     get-mark(BUFFER tt-gds) column-label "*"  format "X(1)":U
     2019     tt-gds.gds-code column-label "Код товара" format ">>>>>>>>9"
     2020     tt-gds.merc-name column-label "Наименование товара" format "X(100)":U width 28
     2021     tt-gds.gds-name column-label "Наим. товара в ТН" format "X(100)":U width 28
     2022     tt-gds.GUID column-label "GUID" format "X(36)":U
     2023     tt-gds.UUID column-label "UUID" format "X(36)":U
     2024     tt-gds.units column-label "Ед.измерения" format "X(5)":U
     2025     tt-gds.units-th column-label "Ед.измерения в ТН" format "X(5)":U
     2026     tt-gds.prod-type column-label "Тип продукции" format "X(36)":U
     2027     tt-gds.cr-date column-label "Дата создания" format "99.99.9999":U
     2028     tt-gds.update-date column-label "Дата последнего изменения в ТН" format "99.99.9999":U
     2029       WITH SEPARATORS SIZE 105 BY 20.21 FIT-LAST-COLUMN.
     2030   DEFINE FRAME Dialog-Frame
     2031     b-cancel AT ROW 1.25 COL 2
     2032     b-load AT ROW 1.25 COL 15
     2033     b-lkp AT ROW 1.25 COL 28
     2034     b-update AT ROW 1.25 COL 41
     2035     b-del AT ROW 1.25 COL 54
     2036     b-connect AT ROW 1.25 COL 67
     2037     b-alt-units AT ROW 1.25 COL 80
     2038     b-import AT ROW 1.25 COL 94
     2039     r-type AT ROW 2.5 COL 2.25 NO-LABEL WIDGET-ID 20
     2040     b-prod AT ROW 2.5 COL 71.5
     2041     b-spisok AT ROW 3.25 COL 22.25 WIDGET-ID 26
     2042     b-mark AT ROW 4.5 COL 2
     2043     b-sel-all AT ROW 4.5 COL 5 WIDGET-ID 28
     2044     b-unmark AT ROW 4.5 COL 8 WIDGET-ID 30
     2045     rs-sort AT ROW 4.54 COL 28 NO-LABEL
     2046     guid_ AT ROW 4.54 COL 71.25 COLON-ALIGNED WIDGET-ID 32
     2047     br-goods AT ROW 5.79 COL 2 WIDGET-ID 200
     2048     v-prod AT ROW 2.71 COL 57.5 COLON-ALIGNED
     2049     v-prod-name AT ROW 2.71 COL 74.5 COLON-ALIGNED NO-LABEL
     2050     "Сортировать по:" VIEW-AS TEXT
     2051     SIZE 15 BY 1.13 AT ROW 4.54 COL 12 WIDGET-ID 18
     2052     SPACE(81.00) SKIP(20.65)
     2053     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2054     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2055     TITLE "Синхронизация товаров с Меркурием"
     2056     DEFAULT-BUTTON b-load CANCEL-BUTTON b-cancel WIDGET-ID 100.
     2057   ASSIGN
     2058     FRAME Dialog-Frame:SCROLLABLE = FALSE
     2059     FRAME Dialog-Frame:HIDDEN     = TRUE.
     2060   ASSIGN
     2061     b-import:POPUP-MENU IN FRAME Dialog-Frame = MENU POPUP-MENU-b-import:HANDLE.
     2062   ASSIGN
     2063     b-prod:HIDDEN IN FRAME Dialog-Frame = TRUE.
     2064   ASSIGN
     2065     b-spisok:HIDDEN IN FRAME Dialog-Frame = TRUE.
     2066   ASSIGN
     2067     br-goods:COLUMN-RESIZABLE IN FRAME Dialog-Frame = TRUE.
     2068   ASSIGN
     2069     v-prod:HIDDEN IN FRAME Dialog-Frame = TRUE.
     2070   ASSIGN
     2071     v-prod-name:HIDDEN IN FRAME Dialog-Frame = TRUE.
     2072   ON window-close OF FRAME Dialog-Frame
     2073     do:
     2074       apply "END-ERROR":U to self.
     2075     end.
     2076   ON choose OF b-cancel IN FRAME Dialog-Frame
     2077     do:
     2078       for each tt-gds:
     2079         delete tt-gds .
     2080       end.
     2081     end.
     2082   ON choose OF b-connect IN FRAME Dialog-Frame
     2083     do:
     2084       if not available tt-gds then
     2085       do:
     2086         message "Не выбран товар" view-as alert-box.
     2087         return no-apply.
     2088       end.
     2089       v-rid = recid (tt-gds) .
     2090       find first ub.goods-attr no-lock where ub.goods-attr.attr-code = 'mercur_FGIS':U
     2091         and ub.goods-attr.attr-value = "yes" and ub.goods-attr.gds-code = tt-gds.gds-code no-error .
     2092       if not available (ub.goods-attr) then
     2093       do:
     2094         message
     2095           "У товара нет атрибута - 'Является подконтрольным ФГИС Меркурий'"
     2096           view-as alert-box.
     2097         leave .
     2098       end.
     2099       run ref/merq-connect.w (parparentproc,
     2100         input-output tt-gds.gds-code) no-error .
     2101       run fill-tt .
     2102       run refresh-query in this-procedure.
     2103       if v-rid <> ? then
     2104         reposition br-goods to recid v-rid .
     2105     end.
     2106   ON choose OF b-del IN FRAME Dialog-Frame
     2107     do:
     2108       define variable choice         as logical no-undo .
     2109       define variable ii             as integer no-undo .
     2110       define variable jj             as integer no-undo .
     2111       define variable gdsMercsubsObj as class   gdsmercsubs.
     2112       define variable gdsmercstrObj  as class   gdsmercstr.
     2113       if not available tt-gds then
     2114       do:
     2115         message "Не выбран товар" view-as alert-box.
     2116         return no-apply.
     2117       end.
     2118       v-rid = recid(tt-gds) .
     2119       gdsMercsubsObj = new gdsmercsubs ().
     2120       gdsmercstrObj = new gdsmercstr ().
     2121       if select-list = "" then
     2122       do:
     2123         gdsMercsubsObj = gdsmercstrObj:getgdsmercs(tt-gds.gds-code).
     2124         message
     2125           "Удалить связку товара с Меркурием?"
     2126           view-as alert-box question buttons yes-no update choice.
     2127         if choice then
     2128         do:
     2129           if valid-object (gdsMercsubsObj:GdsMercsubsCurr) then
     2130           do:
     2131             do ii = 1 to gdsMercsubsObj:GetItem (ii):
     2132               gdsMercObj = gdsMercsubsObj:GdsMercsubsCurr.
     2133             end.
     2134             gdsmercstrObj:deleteDB(gdsMercObj).
     2135           end.
     2136           else
     2137           do:
     2138             message "У товара нет привязки к Меркурию"
     2139               view-as alert-box.
     2140           end.
     2141         end.
     2142       end.
     2143       else
     2144       do:
     2145         select-list = trim(select-list) .
     2146         message
     2147           "Удалить связки выбранных товаров с Меркурием?"
     2148           view-as alert-box question buttons yes-no update choice.
     2149         if choice then
     2150         do:
     2151           do jj = 1 to num-entries (select-list):
     2152             v-list = entry(jj,select-list) no-error .
     2153             for first tt-gds exclusive-lock where recid(tt-gds) = integer(v-list):
     2154               gdsMercsubsObj = gdsmercstrObj:getgdsmercs(tt-gds.gds-code).
     2155               if valid-object (gdsMercsubsObj:GdsMercsubsCurr) then
     2156               do:
     2157                 do ii = 1 to gdsMercsubsObj:GetItem (ii):
     2158                   gdsMercObj = gdsMercsubsObj:GdsMercsubsCurr.
     2159                 end.
     2160                 gdsmercstrObj:deleteDB(gdsMercObj).
     2161               end.
     2162             end.
     2163           end.
     2164         end.
     2165       end.
     2166       delete object gdsMercObj no-error .
     2167       delete object gdsmercstrObj no-error .
     2168       delete object gdsMercsubsObj no-error .
     2169       run fill-tt.
     2170       run refresh-query in this-procedure.
     2171       reposition br-goods to recid v-rid .
     2172     end.
     2173   ON choose OF b-lkp IN FRAME Dialog-Frame
     2174     do:
     2175       if not available tt-gds then
     2176       do:
     2177         message "Не выбран товар" view-as alert-box.
     2178         return no-apply.
     2179       end.
     2180       v-rid = recid(tt-gds) .
     2181       run ref/merq-gds.w (
     2182         parparentproc
     2183         ,input-output tt-gds.gds-code
     2184         ,input 'ПРОСМОТР':U
     2185         ) no-error .
     2186       run refresh-query in this-procedure.
     2187       reposition br-goods to recid v-rid .
     2188     end.
     2189   ON choose OF b-load IN FRAME Dialog-Frame
     2190     do:
     2191       define variable cmd        as character no-undo .
     2192       define variable sw         as handle    no-undo .
     2193       define variable v-file     as character no-undo initial "getProductItemList_.xml".
     2194       define variable v-file-gds as character no-undo initial "getItemList_.xml".
     2195       define buffer buf_ext-classif for ub.ext-classif.
     2196       define buffer buf_ext-system  for ub.ext-system.
     2197       define variable v-prod-guid as character no-undo .
     2198       define variable v-gds-guid  as character no-undo .
     2199       define variable jj          as integer   no-undo .
     2200       define variable Msg         as character no-undo .
     2201       gdsMercsubsObj = new gdsmercsubs ().
     2202       gdsmercstrObj = new gdsmercstr ().
     2203       if not available tt-gds then
     2204       do:
     2205         message "Не выбран товар" view-as alert-box.
     2206         return no-apply.
     2207       end.
     2208       if select-list = "" and v-prod = "" then select-list = string(recid(tt-gds)) .
     2209       if select-list <> "" then
     2210       do:
     2211         select-list = trim (select-list) .
     2212         do jj = 1 to num-entries (select-list):
     2213           v-list = (entry(jj, select-list)).
     2214           for first tt-gds exclusive-lock where recid(tt-gds) = integer(v-list) :
     2215             if tt-gds.GUID <> "" then
     2216             do:
     2217               gdsMercsubsObj = gdsmercstrObj:getgdsmercs(tt-gds.gds-code).
     2218               if valid-object (gdsMercsubsObj:GdsMercsubsCurr) then
     2219               do:
     2220                 v-gds-guid = gdsMercsubsObj:GdsMercsubsCurr:GUID_ .
     2221                 create sax-writer sw .
     2222                 sw:formatted = true.
     2223                 sw:set-output-destination ("file", v-file-gds).
     2224                 sw:encoding = "UTF-8".
     2225                 sw:start-document () .
     2226                 sw:start-element ("se:Envelope") .
     2227                 sw:insert-attribute ("xmlns:se", "http://schemas.xmlsoap.org/soap/envelope/") .
     2228                 sw:insert-attribute ("xmlns:ws", "http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2") .
     2229                 sw:insert-attribute ("xmlns:bs", "http://api.vetrf.ru/schema/cdm/base") .
     2230                 sw:insert-attribute ("xmlns:dt", "http://api.vetrf.ru/schema/cdm/dictionary/v2") .
     2231                 sw:start-element ("se:Body") .
     2232                 sw:start-element ("ws:getProductItemByGuidRequest") .
     2233                 sw:write-data-element ("bs:guid", v-gds-guid) .
     2234                 sw:end-element ("ws:getProductItemByGuidRequest") .
     2235                 sw:end-element ("se:Body") .
     2236                 sw:end-element ("se:Envelope") .
     2237                 sw:end-document () .
     2238                 if trim(v-proxy-addres) <> "" and v-proxy-addres <> ?
     2239                   then
     2240                 do :
     2241                   if v-proxy-ssl
     2242                     then
     2243                   do :
     2244                     cmd = substitute ("&1 -k --proxy-negotiate -x &7 -U : -u &4:&5 -d @&2 &6/platform/services/2.1/ProductService >&3",
     2245                       search ("exe/curl.exe"), search (v-file-gds), "ItemList_.xml", v-login, v-password, v-server, v-proxy-addres).
     2246                   end.
     2247                   else
     2248                   do :
     2249                     cmd = substitute ("&1 -x &7 -U &8:&9 -u &4:&5 -d @&2 &6/platform/services/2.1/ProductService >&3",
     2250                       search ("exe/curl.exe"), search (v-file-gds), "ItemList_.xml", v-login, v-password, v-server, v-proxy-addres, v-proxy-login, v-proxy-pswd).
     2251                   end.
     2252                 end.
     2253                 else
     2254                 do :
     2255                   cmd = substitute ("&1 -u &4:&5 -d @&2 &6/platform/services/2.1/ProductService >&3", search ("exe/curl.exe"), search (v-file-gds), "ItemList_.xml", v-login, v-password, v-server).
     2256                 end.
     2257                 os-command silent value (cmd).
     2258                 parser = new parserXmlGDS().
     2259                 parser:ParseResponse
     2260                   (search("ItemList_.xml")
     2261                   ,input-output TABLE tt-gds-merq
     2262                   ,output Msg) no-error.
     2263                 if Msg <> "" then
     2264                 do:
     2265                   message Msg
     2266                     view-as alert-box.
     2267                 end.
     2268                 else
     2269                 do:
     2270                   find first tt-gds-merq no-lock no-error .
     2271                   if available (tt-gds-merq) then
     2272                   do:
     2273                     gdsMercsubsObj = gdsmercstrObj:getguidmercs(tt-gds-merq.GUID_).
     2274                     if valid-object (gdsMercsubsObj:GdsMercsubsCurr) then
     2275                     do:
     2276                       do ii = 1 to gdsMercsubsObj:GetItem (ii):
     2277                         gdsMercObj = gdsMercsubsObj:GdsMercsubsCurr.
     2278                       end.
     2279                       create tt-gds-units .
     2280                       assign
     2281                         gdsMercObj:MercName    = tt-gds-merq.merc-name
     2282                         gdsMercObj:UUID        = tt-gds-merq.UUID
     2283                         gdsMercObj:DateCr      = tt-gds-merq.crDate
     2284                         gdsMercObj:DateUpdate  = tt-gds-merq.update_Date
     2285                         gdsMercObj:ProdType    = string (tt-gds-merq.prod-type)
     2286                         gdsMercObj:GUIDType    = tt-gds-merq.GUID-type
     2287                         gdsMercObj:GUIDSubType = tt-gds-merq.GUID-subtype
     2288                         tt-gds-units.units     = tt-gds-merq.units
     2289                         tt-gds-units.GUID_     = tt-gds-merq.GUID_
     2290                         .
     2291                       gdsmercstrObj:updateDB(gdsMercObj).
     2292                     end.
     2293                   end.
     2294                 end.
     2295               end.
     2296             end.
     2297           end.
     2298         end.
     2299         run fill-tt .
     2300         run refresh-query in this-procedure.
     2301       end.
     2302       else
     2303       do:
     2304         find first buf_ext-system no-lock where buf_ext-system.esys-type = integer('10':U) no-error.
     2305         if not available buf_ext-system
     2306           then
     2307         do :
     2308         end.
     2309         find first buf_ext-classif no-lock
     2310           where buf_ext-classif.classif-subject = 'clients':U
     2311           and buf_ext-classif.classif-name = 'clients-esys':U
     2312           and buf_ext-classif.db-num = 0
     2313           and buf_ext-classif.key#_one = buf_ext-system.esys-id
     2314           and buf_ext-classif.uniq-key-rec = 'clients':U + chr(3) + buf_clients.obj-type + chr(3) + string (buf_clients.obj-code)
     2315           no-error.
     2316         if not available  buf_ext-classif
     2317           then
     2318         do :
     2319         end.
     2320         v-prod-guid = entry(2, buf_ext-classif.charKey_Two, chr(6)) no-error.
     2321         create sax-writer sw .
     2322         sw:formatted = true.
     2323         sw:set-output-destination ("file", v-file).
     2324         sw:encoding = "UTF-8".
     2325         sw:start-document () .
     2326         sw:start-element ("se:Envelope") .
     2327         sw:insert-attribute ("xmlns:se", "http://schemas.xmlsoap.org/soap/envelope/") .
     2328         sw:insert-attribute ("xmlns:ws", "http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2") .
     2329         sw:insert-attribute ("xmlns:bs", "http://api.vetrf.ru/schema/cdm/base") .
     2330         sw:insert-attribute ("xmlns:dt", "http://api.vetrf.ru/schema/cdm/dictionary/v2") .
     2331         sw:start-element ("se:Body") .
     2332         sw:start-element ("ws:getProductItemListRequest") .
     2333         sw:start-element ("bs:listOptions") .
     2334         sw:write-data-element ("bs:count", "1000") .
     2335         sw:write-data-element ("bs:offset", "0") .
     2336         sw:end-element ("bs:listOptions") .
     2337         sw:start-element ("dt:producer") .
     2338         sw:start-element ("dt:enterprise") .
     2339         sw:write-data-element ("bs:guid", v-prod-guid) .
     2340         sw:end-element ("dt:enterprise") .
     2341         sw:end-element ("dt:producer") .
     2342         sw:end-element ("ws:getProductItemListRequest") .
     2343         sw:end-element ("se:Body") .
     2344         sw:end-element ("se:Envelope") .
     2345         sw:end-document () .
     2346         if trim(v-proxy-addres) <> "" and v-proxy-addres <> ?
     2347           then
     2348         do :
     2349           if v-proxy-ssl
     2350             then
     2351           do :
     2352             cmd = substitute ("&1 -k --proxy-negotiate -x &7 -U : -u &4:&5 -d @&2 &6/platform/services/2.1/ProductService >&3",
     2353               search ("exe/curl.exe"), search (v-file-gds), "ItemList_.xml", v-login, v-password, v-server, v-proxy-addres).
     2354           end.
     2355           else
     2356           do :
     2357             cmd = substitute ("&1 -x &7 -U &8:&9 -u &4:&5 -d @&2 &6/platform/services/2.1/ProductService >&3",
     2358               search ("exe/curl.exe"), search (v-file-gds), "ItemList_.xml", v-login, v-password, v-server, v-proxy-addres, v-proxy-login, v-proxy-pswd).
     2359           end.
     2360         end.
     2361         else
     2362         do :
     2363           cmd = substitute ("&1 -u &4:&5 -d @&2 &6/platform/services/2.1/ProductService >&3", search ("exe/curl.exe"), search (v-file-gds), "ItemList_.xml", v-login, v-password, v-server).
     2364         end.
     2365         os-command silent value (cmd).
     2366       end.
     2367       delete object gdsMercObj no-error .
     2368       delete object gdsmercstrObj no-error .
     2369       delete object gdsMercsubsObj no-error .
     2370     end.
     2371   ON choose OF b-mark IN FRAME Dialog-Frame
     2372     do:
     2373       run proc-b-mark in this-procedure no-error.
     2374     end.
     2375   ON choose OF b-prod IN FRAME Dialog-Frame
     2376     do:
     2377       os-delete value( search("ItemList_.xml")) no-error .
     2378       run sel-prod in this-procedure .
     2379       assign
     2380         rs-sort
     2381         .
     2382       run refresh-query in this-procedure.
     2383     end.
     2384   on choose of b-alt-units in frame Dialog-Frame
     2385   do:
     2386   define variable v-ret-unit-name  as character no-undo .
     2387   define variable v-ret-unit-coeff as decimal no-undo .
     2388     if not available tt-gds then return no-apply .
     2389     run ref\alt-units.w (input parparentproc,
     2390                          input (if v-cntxt-db-num = 0 then 'ИЗМЕНЕНИЕ':U else 'ПРОСМОТР':U),
     2391                          input tt-gds.gds-code,
     2392                          input "",
     2393                          output v-ret-unit-name,
     2394                          output v-ret-unit-coeff) .
     2395   end.
     2396   ON choose OF b-sel-all IN FRAME Dialog-Frame
     2397     do:
     2398       assign
     2399         select-list = "".
     2400       if not available tt-gds then return.
     2401       for each tt-gds no-lock :
     2402   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2403   define variable v-str-recid12 as character no-undo .
     2404   define variable v-num-entry12 as integer   no-undo .
     2405   assign
     2406     v-str-recid12 = trim( string( recid( tt-gds ) , "->>>>>>>>>>>9":U ) )
     2407     v-num-entry12 = lookup( v-str-recid12 , select-list )
     2408   .
     2409   if v-num-entry12 > 0 then do:
     2410     assign
     2411       entry( v-num-entry12, select-list ) = "":U
     2412       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2413     .
     2414   end.
     2415   else do:
     2416     assign
     2417       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid12
     2418     .
     2419   end.
     2420       end.
     2421       br-goods:refresh() in frame Dialog-Frame .
     2422     end.
     2423   ON choose OF b-spisok IN FRAME Dialog-Frame
     2424     do:
     2425       run sel-goods in this-procedure .
     2426       assign
     2427         rs-sort
     2428         .
     2429       run refresh-query in this-procedure.
     2430     end.
     2431   ON choose OF b-unmark IN FRAME Dialog-Frame
     2432     do:
     2433       if not available tt-gds then return.
     2434       select-list  = "".
     2435       br-goods:refresh() in frame Dialog-Frame .
     2436     end.
     2437   ON choose OF b-update IN FRAME Dialog-Frame
     2438     do:
     2439       if not available tt-gds then
     2440       do:
     2441         message "Не выбран товар" view-as alert-box.
     2442         return no-apply.
     2443       end.
     2444       v-rid = recid(tt-gds) .
     2445       find first ub.goods-attr no-lock where ub.goods-attr.attr-code = 'mercur_FGIS':U
     2446         and ub.goods-attr.attr-value = "yes" and ub.goods-attr.gds-code = tt-gds.gds-code no-error .
     2447       if not available (ub.goods-attr) then
     2448       do:
     2449         message
     2450           "У товара нет атрибута - 'Является подконтрольным ФГИС Меркурий'"
     2451           view-as alert-box.
     2452         return no-apply .
     2453       end.
     2454       run ref/merq-gds.w (
     2455         parparentproc
     2456         ,input-output tt-gds.gds-code
     2457         ,input 'ИЗМЕНЕНИЕ':U
     2458         ) no-error .
     2459       run fill-tt .
     2460       run refresh-query in this-procedure.
     2461     end.
     2462   ON value-changed OF guid_ IN FRAME Dialog-Frame
     2463     DO:
     2464       assign guid_ .
     2465       run fill-tt .
     2466       run refresh-query in this-procedure.
     2467     END.
     2468   ON choose OF MENU-ITEM m_item_import
     2469     do:
     2470       define variable jj as integer no-undo .
     2471       v-select-list = "" .
     2472       run ref/merq-import.w (parparentproc,
     2473         output v-select-list) no-error .
     2474       if v-select-list <> "" then
     2475       do:
     2476         assign
     2477           r-type = 2 .
     2478         run ini_enable .
     2479         run fill-tt .
     2480         run refresh-query in this-procedure.
     2481       end.
     2482     end.
     2483   ON choose OF MENU-ITEM m_item_send
     2484     do:
     2485       for each ub.gds-mercury exclusive-lock:
     2486         run str/callnews.p
     2487           (input 'gds-mercury':U
     2488           ,input (buffer ub.gds-mercury:handle)
     2489           ) no-error .
     2490         if error-status :error then
     2491         do:
     2492           message
     2493             error-status :get-message(1) skip
     2494             return-value skip
     2495             view-as alert-box.
     2496           return no-apply.
     2497         end.
     2498       end.
     2499       message "Передача данных в УБД - выполнена"
     2500         view-as alert-box.
     2501     end.
     2502   ON value-changed OF r-type IN FRAME Dialog-Frame
     2503     do:
     2504       assign
     2505         v-prod:SCREEN-VALUE      = ""
     2506         v-prod-name:SCREEN-VALUE = ""
     2507         .
     2508       assign
     2509         r-type
     2510         .
     2511       run ini_enable.
     2512       for each tt-gds:
     2513         delete tt-gds .
     2514       end.
     2515       run refresh-query in this-procedure.
     2516     end.
     2517   ON value-changed OF rs-sort IN FRAME Dialog-Frame
     2518     do:
     2519       assign
     2520         rs-sort
     2521         .
     2522       run refresh-query in this-procedure.
     2523     end.
     2524   if valid-handle(active-window) and frame Dialog-Frame:PARENT eq ?
     2525     then frame Dialog-Frame:PARENT = active-window.
     2526   MAIN-BLOCK:
     2527   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
     2528     on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
     2529   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2530   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2531   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2532   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2533   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2534   define variable v-diasize-current-frame-height as decimal   no-undo .
     2535   define variable v-diasize-change-size          as logical   no-undo .
     2536   define variable v-diasize-resize-button        as handle    no-undo .
     2537   define variable v-diasize-wndmax               as logical   no-undo .
     2538   define variable v-diasize-wndstore             as logical   no-undo .
     2539   define variable v-diasize-proc-name            as character no-undo .
     2540   define variable v-diasize-browse-handle        as handle    no-undo .
     2541   define variable v-diasize-browse-number        as integer   no-undo .
     2542   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2543   define temp-table temp-diasize-handle no-undo
     2544     field handle-value  as handle
     2545     field save-position as decimal
     2546     index xpk is primary unique handle-value
     2547     .
     2548   define temp-table temp-browse-handle no-undo
     2549     field browse-type   as character
     2550     field browse-number as integer
     2551     field browse-handle as handle
     2552     field original-size as decimal
     2553     index xpk is primary unique browse-type browse-number
     2554     index xie browse-type browse-handle
     2555   .
     2556   procedure diasize_change-height :
     2557     define input  parameter p-change-value  as decimal   no-undo .
     2558     define input  parameter p-move-resize   as logical   no-undo .
     2559     define variable v-field-group-handle    as handle    no-undo .
     2560     define variable v-object-handle         as handle    no-undo .
     2561     define variable v-frame-height          as decimal   no-undo .
     2562     define variable v-frame-virtual-height  as decimal   no-undo .
     2563     define variable v-browse-height         as decimal   no-undo .
     2564     define variable v-window-height         as decimal   no-undo .
     2565     define variable v-window-virtual-height as decimal   no-undo .
     2566     define variable v-change-sign           as integer   no-undo .
     2567     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2568     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2569     if p-change-value > 0
     2570     then do:
     2571       if frame Dialog-Frame :height + p-change-value
     2572           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2573       then do:
     2574         assign
     2575           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2576                           - (frame Dialog-Frame :height-chars)
     2577         .
     2578         if p-change-value <= 0
     2579         then do:
     2580           run diasize_position-resize-button in this-procedure .
     2581           return .
     2582         end.
     2583       end.
     2584     end.
     2585     if p-change-value < 0
     2586     then do:
     2587       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2588       then do:
     2589         assign
     2590           p-change-value = v-diasize-orig-frame-height
     2591                          - (frame Dialog-Frame :height-chars)
     2592         .
     2593         if p-change-value >= 0
     2594         then do:
     2595           run diasize_position-resize-button in this-procedure .
     2596           return .
     2597         end.
     2598       end.
     2599     end.
     2600     if p-change-value >= 0
