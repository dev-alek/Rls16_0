      181   procedure thbjattr_code_reg :
      182   define input  parameter p-upper-code     as character no-undo .
      183   define input  parameter p-code           as character no-undo .
      184   define output parameter p-label          as character no-undo .
      185   define output parameter p-user-can-edit  as logical   no-undo .
      186   define output parameter p-output-display as logical   no-undo .
      187   define output parameter p-other          as character no-undo .
      188   define output parameter p-prop-list      as character no-undo .
      189   define output parameter p-prop-type-list as character no-undo .
      190   define output parameter p-prop-label-list as character no-undo .
      191   define output parameter p-global          as logical no-undo .
      192   define output parameter p-host           as logical no-undo .
      193   define output parameter p-shop           as logical no-undo .
      194   define output parameter p-store          as logical no-undo .
      195   define output parameter p-db             as logical no-undo .
      196   define output parameter p-region         as logical no-undo .
      197   do
      198   on error undo, return error return-value
      199   :
      200       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      201       (input  p-upper-code
      202       ,input  p-code
      203       ,output p-label
      204       ,output p-user-can-edit
      205       ,output p-output-display
      206       ,output p-other
      207       ,output p-prop-list
      208       ,output p-prop-type-list
      209       ,output p-prop-label-list
      210       ,output p-global
      211       ,output p-host
      212       ,output p-shop
      213       ,output p-store
      214       ,output p-db
      215       ,output p-region
      216       ) no-error .
      217     if error-status :error
      218     then do:
      219       undo, return error substitute( "&1. &2&3&4", vss-include-info2, return-value, chr(10), error-status :get-message (1)).
      220     end.
      221   end.
      222   end procedure.
