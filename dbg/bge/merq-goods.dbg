     3219             assign
     3220               v-object-handle :col = v-object-handle :col + p-change-value
     3221               no-error .
     3222             if error-status :error
     3223             or error-status :get-message(1) <> ""
     3224             then do:
     3225               undo move_block, retry move_block .
     3226             end.
     3227           end.
     3228         end.
     3229       end.
     3230       else do:
     3231         for each buf_temp-diasize-handle
     3232         on error undo move_block, retry move_block
     3233         :
     3234           assign
     3235             v-object-handle = buf_temp-diasize-handle.handle-value
     3236           .
     3237           if v-object-handle <> v-diasize-resize-button
     3238           then do:
     3239             assign
     3240               v-object-handle :col = v-object-handle :col + p-change-value
     3241               no-error .
     3242             if error-status :error
     3243             or error-status :get-message(1) <> ""
     3244             then do:
     3245               undo move_block, retry move_block .
     3246             end.
     3247           end.
     3248         end.
     3249         for each buf_temp-browse-handle
     3250           where buf_temp-browse-handle.browse-type = 'width':u
     3251         on error undo move_block, retry move_block
     3252         :
     3253           assign
     3254             buf_temp-browse-handle.browse-handle :width
     3255               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3256             no-error .
     3257           if error-status :error
     3258           or error-status :get-message(1) <> ""
     3259           then do:
     3260             undo move_block, retry move_block .
     3261           end.
     3262         end.
     3263         assign
     3264           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3265           no-error .
     3266         if error-status :error
     3267         or error-status :get-message(1) <> ""
     3268         then do:
     3269           undo move_block, retry move_block.
     3270         end.
     3271         assign
     3272           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3273         no-error .
     3274         if error-status :error
     3275         or error-status :get-message(1) <> ""
     3276         then do:
     3277           undo move_block, retry move_block.
     3278         end.
     3279         if frame Dialog-Frame :scrollable = true
     3280         then do:
     3281           assign
     3282             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3283           no-error .
     3284           if error-status :error
     3285           or error-status :get-message(1) <> ""
     3286           then do:
     3287             undo move_block, retry move_block.
     3288           end.
     3289         end.
     3290       end.
     3291       if p-move-resize
     3292       then do:
     3293         run diasize_position-resize-button in this-procedure .
     3294       end.
     3295       if v-diasize-wndstore = true
     3296       then do:
     3297         if connected("ub") = true
     3298         then do:
     3299           define variable v-cntxt-db-num        as integer   no-undo .
     3300           define variable v-cntxt-userid        as character no-undo .
     3301           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3302                                             , OUTPUT v-cntxt-userid
     3303                                             ) .
     3304           run gbl/wndsizew.p
     3305             (input  v-cntxt-db-num
     3306             ,input  v-cntxt-userid
     3307             ,input  v-diasize-proc-name
     3308             ,input  'width':u
     3309             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3310             ) .
     3311         end.
     3312       end.
     3313     end.
     3314     assign
     3315       v-diasize-change-size = false
     3316     .
     3317   end procedure.
     3318   procedure diasize_set-width :
     3319     define input  parameter p-new-width  as decimal   no-undo .
     3320     define input  parameter p-move-resize as logical   no-undo .
     3321     do
     3322     on error undo, return error return-value
     3323     :
     3324       run diasize_change-width in this-procedure
     3325         (input  (p-new-width - frame Dialog-Frame :width)
     3326         ,input  p-move-resize
     3327         ) .
     3328     end.
     3329   end procedure.
     3330   procedure diasize_position-resize-button :
     3331     do with frame Dialog-Frame
     3332     :
     3333       hide v-diasize-resize-button .
     3334       assign
     3335         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3336                     - 1
     3337                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3338         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3339                     - 1
     3340                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3341       .
     3342       view v-diasize-resize-button .
     3343     end.
     3344   end procedure.
     3345   on alt-right anywhere
     3346   do:
     3347     run diasize_change-width in this-procedure
     3348       (input 1
     3349       ,input true
     3350       ) .
     3351     return no-apply .
     3352   end.
     3353   on alt-left anywhere
     3354   do:
     3355     run diasize_change-width in this-procedure
     3356       (input -1
     3357       ,input true
     3358       ) .
     3359     return no-apply .
     3360   end.
     3361   on alt-down anywhere
     3362   do:
     3363     run diasize_change-height in this-procedure
     3364       (input 1
     3365       ,input true
     3366       ) .
     3367     return no-apply .
     3368   end.
     3369   on alt-up anywhere
     3370   do:
     3371     run diasize_change-height in this-procedure
     3372       (input -1
     3373       ,input true
     3374       ) .
     3375     return no-apply .
     3376   end.
     3377   on alt-enter of frame Dialog-Frame
     3378   do:
     3379     run diasize_maximize in this-procedure
     3380       (input  ?
     3381       ).
     3382     return no-apply .
     3383   end.
     3384   procedure diasize_end-move :
     3385     do
     3386     on error undo, return error return-value
     3387     :
     3388       define variable v-row-delta as decimal   no-undo .
     3389       define variable v-col-delta as decimal   no-undo .
     3390       define variable v-new-row as decimal   no-undo .
     3391       define variable v-new-col as decimal   no-undo .
     3392       assign
     3393         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3394         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3395       .
     3396       assign
     3397         v-row-delta = v-new-row - frame Dialog-Frame :height
     3398         v-col-delta = v-new-col - frame Dialog-Frame :width
     3399       .
     3400       run diasize_change-height in this-procedure
     3401         (input v-row-delta
     3402         ,input true
     3403         ) .
     3404       run diasize_change-width in this-procedure
     3405         (input v-col-delta
     3406         ,input true
     3407         ) .
     3408     end.
     3409   end procedure.
     3410   procedure diasize_maximize :
     3411     define input  parameter p-action as logical   no-undo .
     3412     do
     3413     on error undo, return error return-value
     3414     :
     3415       if p-action = ?
     3416       then do:
     3417         if v-diasize-need-maximize = true
     3418         then do:
     3419           assign
     3420             p-action = true
     3421           .
     3422         end.
     3423         else do:
     3424           assign
     3425             p-action = false
     3426           .
     3427         end.
     3428       end.
     3429       if p-action = true
     3430       then do:
     3431         run diasize_change-height in this-procedure
     3432           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3433               - frame Dialog-Frame :height-chars
     3434           ,input true
     3435           ) .
     3436         run diasize_change-width in this-procedure
     3437           (input session :width-chars
     3438               - frame Dialog-Frame :width-chars
     3439           ,input true
     3440           ) .
     3441         assign
     3442           v-diasize-need-maximize = false
     3443         .
     3444       end.
     3445       else do:
     3446         run diasize_change-width in this-procedure
     3447           (input v-diasize-orig-frame-width
     3448               - frame Dialog-Frame :width-chars
     3449           ,input true
     3450           ) .
     3451         run diasize_change-height in this-procedure
     3452           (input v-diasize-orig-frame-height
     3453               - frame Dialog-Frame :height-chars
     3454           ,input true
     3455           ) .
     3456         assign
     3457           v-diasize-need-maximize = true
     3458         .
     3459       end.
     3460     end.
     3461   end procedure.
     3462   procedure diasize_restore-orig-size :
     3463     do
     3464     on error undo, return error return-value
     3465     :
     3466       assign
     3467         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3468         v-diasize-current-frame-height = frame Dialog-Frame :height
     3469       .
     3470       run diasize_set-height in this-procedure
     3471         (input  v-diasize-orig-frame-height
     3472         ,input  true
     3473         ) .
     3474       run diasize_set-width in this-procedure
     3475         (input  v-diasize-orig-frame-width
     3476         ,input  true
     3477         ) .
     3478     end.
     3479   end procedure.
     3480   procedure diasize_restore-current-size :
     3481     do
     3482     on error undo, return error return-value
     3483     :
     3484       run diasize_set-height in this-procedure
     3485         (input  v-diasize-current-frame-height
     3486         ,input  true
     3487         ) .
     3488       run diasize_set-width in this-procedure
     3489         (input  v-diasize-current-frame-width
     3490         ,input  true
     3491         ) .
     3492     end.
     3493   end procedure.
     3494   procedure diasize_set-browse-handle :
     3495     define input  parameter p-browse-handle as handle   no-undo .
     3496     define buffer buf_temp-browse-handle for temp-browse-handle .
     3497     do
     3498     on error undo, return error return-value
     3499     :
     3500       assign
     3501         v-diasize-browse-handle = p-browse-handle
     3502       .
     3503       for each buf_temp-browse-handle
     3504       on error undo, return error return-value
     3505       :
     3506         delete buf_temp-browse-handle .
     3507       end.
     3508     end.
     3509   end procedure.
     3510   procedure diasize_add_browse :
     3511     define input  parameter p-browse-type   as character no-undo .
     3512     define input  parameter p-browse-handle as handle    no-undo .
     3513     define buffer buf_temp-browse-handle for temp-browse-handle .
     3514     do
     3515     on error undo, return error return-value
     3516     :
     3517       assign
     3518         v-diasize-browse-number = v-diasize-browse-number + 1
     3519       .
     3520       create buf_temp-browse-handle .
     3521       assign
     3522         buf_temp-browse-handle.browse-type   = p-browse-type
     3523         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3524         buf_temp-browse-handle.browse-handle = p-browse-handle
     3525       .
     3526     end.
     3527   end procedure.
     3528   procedure diasize_init :
     3529     define variable v-default-value    as logical   no-undo .
     3530     define variable v-restore-saved    as logical   no-undo .
     3531     define variable v-resize-value-str as character no-undo .
     3532     do
     3533     on error undo, return error return-value
     3534     :
     3535       do with frame Dialog-Frame
     3536       :
     3537         assign
     3538           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3539           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3540           v-diasize-browse-handle     = browse br-goods :handle
     3541         .
     3542         create button v-diasize-resize-button
     3543         assign
     3544           parent        = frame Dialog-Frame :first-child
     3545           label         = "s"
     3546           height-pixels = 16
     3547           width-pixels  = 16
     3548           visible       = true
     3549           sensitive     = true
     3550           movable       = true
     3551           triggers:
     3552             on end-move persistent run diasize_end-move in this-procedure .
     3553           end triggers.
     3554         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3555         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3556         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3557         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3558         assign
     3559           v-diasize-wndmax = false
     3560         .
     3561         if connected("ub") = true
     3562         then do:
     3563           define variable v-cntxt-db-num        as integer   no-undo .
     3564           define variable v-cntxt-userid        as character no-undo .
     3565           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3566                                             , OUTPUT v-cntxt-userid
     3567                                             ) .
     3568           run gbl/wndpar_r.p
     3569             (input  v-cntxt-db-num
     3570             ,input  v-cntxt-userid
     3571             ,input  'wndmax':U
     3572             ,output v-diasize-wndmax
     3573             ,output v-default-value
     3574             ) .
     3575         end.
     3576         assign
     3577           v-diasize-wndstore = false
     3578         .
     3579         if connected("ub") = true
     3580         then do:
     3581           run gbl/wndpar_r.p
     3582             (input  v-cntxt-db-num
     3583             ,input  v-cntxt-userid
     3584             ,input  'wndstore':U
     3585             ,output v-diasize-wndstore
     3586             ,output v-default-value
     3587             ) .
     3588         end.
     3589         assign
     3590           v-diasize-proc-name = entry(1, program-name(2), '.')
     3591         .
     3592         if v-diasize-wndstore = true
     3593         then do:
     3594           assign
     3595             v-restore-saved = false
     3596           .
     3597           if connected("ub") = true
     3598           then do:
     3599             run gbl/wndsizer.p
     3600               (input  v-cntxt-db-num
     3601               ,input  v-cntxt-userid
     3602               ,input  v-diasize-proc-name
     3603               ,input  'height':u
     3604               ,output v-resize-value-str
     3605               ) .
     3606             if v-resize-value-str <> '':U
     3607             then do:
     3608               run diasize_change-height in this-procedure
     3609                 (input  integer(v-resize-value-str)
     3610                 ,input  true
     3611                 ) .
     3612               assign
     3613                 v-restore-saved = true
     3614               .
     3615             end.
     3616           end.
     3617           if connected("ub") = true
     3618           then do:
     3619             run gbl/wndsizer.p
     3620               (input  v-cntxt-db-num
     3621               ,input  v-cntxt-userid
     3622               ,input  v-diasize-proc-name
     3623               ,input  'width':u
     3624               ,output v-resize-value-str
     3625               ) .
     3626             if v-resize-value-str <> '':U
     3627             then do:
     3628               run diasize_change-width in this-procedure
     3629                 (input  integer(v-resize-value-str)
     3630                 ,input  true
     3631                 ) .
     3632               assign
     3633                 v-restore-saved = true
     3634               .
     3635             end.
     3636           end.
     3637           if v-restore-saved <> true
     3638           then do:
     3639             if v-diasize-wndmax = true
     3640             then do:
     3641               run diasize_maximize in this-procedure
     3642                 (input  true
     3643                 ) .
     3644             end.
     3645           end.
     3646         end.
     3647         else do:
     3648           if v-diasize-wndmax = true
     3649           then do:
     3650             run diasize_maximize in this-procedure
     3651               (input  true
     3652               ) .
     3653           end.
     3654         end.
     3655       end.
     3656     end.
     3657   end procedure.
     3658   procedure diasize_need-full-display :
     3659     define output parameter p-need-full-display as logical   no-undo .
     3660     do
     3661     on error undo, return error return-value
     3662     :
     3663       assign
     3664         p-need-full-display = v-diasize-need-full-display
     3665       .
     3666       assign
     3667         v-diasize-need-full-display = false
     3668       .
     3669     end.
     3670   end procedure.
     3671   procedure get-context :
     3672      define output parameter p-db-num as integer          no-undo.
     3673      define output parameter p-user-id as character        no-undo.
     3674      define variable v-login               as character    no-undo.
     3675      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3676      define buffer buf_user-login  for ub.user-login .
     3677      do
     3678      on error undo, return error
     3679      :
     3680            FIND FIRST buf_sys-ctrl no-lock.
     3681            ASSIGN
     3682               v-login = USERID("ub")
     3683               p-db-num = buf_sys-ctrl.db-num
     3684            .
     3685            FIND FIRST buf_user-login
     3686                 WHERE buf_user-login.db-num = p-db-num
     3687                   AND buf_user-login.user-login = v-login
     3688                 no-lock
     3689                 no-error
     3690                 .
     3691            IF AVAILABLE buf_user-login
     3692            THEN DO:
     3693               assign
     3694                  p-user-id = buf_user-login.user-id
     3695               .
     3696            END.
     3697      end.
     3698   end procedure.
     3699     run diasize_init in this-procedure .
     3700     run enable_UI.
     3701     run ini_enable.
     3702     wait-for go of frame Dialog-Frame.
     3703   end.
     3704   run disable_UI.
     3705   PROCEDURE disable_UI :
     3706     HIDE FRAME Dialog-Frame.
     3707   END PROCEDURE.
     3708   PROCEDURE enable_UI :
     3709     DISPLAY r-type rs-sort guid_
     3710       WITH FRAME Dialog-Frame.
     3711     ENABLE b-cancel b-load b-lkp b-update b-del b-connect b-alt-units b-import
     3712       r-type b-mark b-sel-all b-unmark rs-sort guid_ br-goods
     3713       WITH FRAME Dialog-Frame.
     3714     VIEW FRAME Dialog-Frame.
     3715     OPEN QUERY br-goods FOR EACH tt-gds.
     3716   END PROCEDURE.
     3717   PROCEDURE fill-tt :
     3718     define buffer buf_goods       for ub.goods .
     3719     define buffer buf_goods-attr  for ub.goods-attr .
     3720     define buffer buf_gds-mercury for ub.gds-mercury .
     3721     define variable ii             as integer no-undo .
     3722     define variable i              as integer no-undo .
     3723     define variable jj             as integer no-undo .
     3724     define variable gdsMercsubsObj as class   gdsmercsubs.
     3725     define variable gdsmercstrObj  as class   gdsmercstr.
     3726     gdsMercsubsObj = new gdsmercsubs ().
     3727     gdsmercstrObj = new gdsmercstr ().
     3728     for each tt-gds:
     3729       delete tt-gds .
     3730     end .
     3731     case r-type :
     3732       when 1 then
     3733         do:
     3734           ii = 0 .
     3735           if v-prod <> "" then
     3736           do:
     3737             for each buf_goods no-lock where buf_goods.prod-code = INTEGER (entry(2,v-prod)) and buf_goods.prod-type = ENTRY (1,v-prod) and buf_goods.stts = 0:
     3738               ii = ii + 1.
     3739               gdsMercsubsObj = gdsmercstrObj:getgdsmercs(buf_goods.gds-code).
     3740               if valid-object (gdsMercsubsObj:GdsMercsubsCurr) then
     3741               do:
     3742                 if (guid_ <> "" and gdsMercsubsObj:GdsMercsubsCurr:GUID_ begins guid_) or guid_ = "" then
     3743                 do:
     3744                   create tt-gds .
     3745                   do i = 1 to gdsMercsubsObj:GetItem (i):
     3746                     find first tt-gds-units no-lock where tt-gds-units.GUID_ = gdsMercsubsObj:GdsMercsubsCurr:GUID_ no-error .
     3747                     if available (tt-gds-units) then tt-gds.units = tt-gds-units.units .
     3748                     tt-gds.ID           = ii .
     3749                     tt-gds.gds-code     = gdsMercsubsObj:GdsMercsubsCurr:GdsCode .
     3750                     tt-gds.prod-type    = gdsMercsubsObj:GdsMercsubsCurr:ProdType .
     3751                     tt-gds.db-num       = gdsMercsubsObj:GdsMercsubsCurr:DBNum .
     3752                     tt-gds.gds-name     = buf_goods.gds-name .
     3753                     tt-gds.units-th     = buf_goods.unit-base .
     3754                     tt-gds.merc-name    = gdsMercsubsObj:GdsMercsubsCurr:MercName .
     3755                     tt-gds.cr-date      = gdsMercsubsObj:GdsMercsubsCurr:DateCr .
     3756                     tt-gds.update-date  = gdsMercsubsObj:GdsMercsubsCurr:DateUpdate .
     3757                     tt-gds.GUID-type    = gdsMercsubsObj:GdsMercsubsCurr:GUIDType .
     3758                     tt-gds.GUID-subtype = gdsMercsubsObj:GdsMercsubsCurr:GUIDSubType .
     3759                     tt-gds.GUID         = gdsMercsubsObj:GdsMercsubsCurr:GUID_ .
     3760                     tt-gds.UUID         = gdsMercsubsObj:GdsMercsubsCurr:UUID .
     3761                   end.
     3762                 end.
     3763               end.
     3764               else
     3765               do:
     3766                 if guid_ = "" then
     3767                 do:
     3768                   create tt-gds .
     3769                   tt-gds.ID = ii .
     3770                   tt-gds.gds-code   = buf_goods.gds-code .
     3771                   tt-gds.gds-name   = buf_goods.gds-name .
     3772                   tt-gds.units-th   = buf_goods.unit-base .
     3773                 end.
     3774               end.
     3775             end.
     3776           end.
     3777         end.
     3778       when 2 then
     3779         do:
     3780           if select-list <> "" then
     3781           do:
     3782             select-list = trim (select-list) no-error .
     3783             do jj = 1 to num-entries (select-list):
     3784               v-list = (entry(jj, select-list)) no-error.
     3785               for first tt-gds exclusive-lock where recid(tt-gds) = integer(v-list):
     3786                 for each buf_goods no-lock where buf_goods.gds-code = integer(entry(jj,v-list))
     3787                   :
     3788                   gdsMercsubsObj = gdsmercstrObj:getgdsmercs(buf_goods.gds-code).
     3789                   if valid-object (gdsMercsubsObj:GdsMercsubsCurr) then
     3790                   do:
     3791                     do i = 1 to gdsMercsubsObj:GetItem (i):
     3792                       if (guid_ <> "" and gdsMercsubsObj:GdsMercsubsCurr:GUID_ begins guid_) or guid_ = "" then
     3793                       do:
     3794                         find first tt-gds-units no-lock where tt-gds-units.GUID_ = gdsMercsubsObj:GdsMercsubsCurr:GUID_ and tt-gds-units.GUID_ begins guid_ no-error .
     3795                         if available (tt-gds-units) then tt-gds.units = tt-gds-units.units .
     3796                         tt-gds.prod-type    = gdsMercsubsObj:GdsMercsubsCurr:ProdType .
     3797                         tt-gds.db-num       = gdsMercsubsObj:GdsMercsubsCurr:DBNum .
     3798                         tt-gds.gds-name     = buf_goods.gds-name .
     3799                         tt-gds.units-th     = buf_goods.unit-base .
     3800                         tt-gds.merc-name    = gdsMercsubsObj:GdsMercsubsCurr:MercName .
     3801                         tt-gds.cr-date      = gdsMercsubsObj:GdsMercsubsCurr:DateCr .
     3802                         tt-gds.update-date  = gdsMercsubsObj:GdsMercsubsCurr:DateUpdate .
     3803                         tt-gds.GUID-type    = gdsMercsubsObj:GdsMercsubsCurr:GUIDType .
     3804                         tt-gds.GUID-subtype = gdsMercsubsObj:GdsMercsubsCurr:GUIDSubType .
     3805                         tt-gds.GUID         = gdsMercsubsObj:GdsMercsubsCurr:GUID_ .
     3806                         tt-gds.UUID         = gdsMercsubsObj:GdsMercsubsCurr:UUID .
     3807                       end.
     3808                     end.
     3809                   end.
     3810                   else
     3811                   do:
     3812                     if guid_ = "" then
     3813                     do:
     3814                       tt-gds.gds-code   = buf_goods.gds-code .
     3815                       tt-gds.gds-name   = buf_goods.gds-name .
     3816                       tt-gds.units-th   = buf_goods.unit-base .
     3817                     end.
     3818                   end.
     3819                 end.
     3820               end.
     3821             end.
     3822           end.
     3823           if v-select-list <> "" then
     3824           do:
     3825             v-select-list = trim (v-select-list) no-error .
     3826             do jj = 1 to num-entries (v-select-list):
     3827               for each buf_goods no-lock where buf_goods.gds-code = integer(entry(jj,v-select-list)):
     3828                 gdsMercsubsObj = gdsmercstrObj:getgdsmercs(buf_goods.gds-code).
     3829                 if valid-object (gdsMercsubsObj:GdsMercsubsCurr) then
     3830                 do:
     3831                   do i = 1 to gdsMercsubsObj:GetItem (i):
     3832                     if (guid_ <> "" and gdsMercsubsObj:GdsMercsubsCurr:GUID_ begins guid_) or guid_ = "" then
     3833                     do:
     3834                       create tt-gds .
     3835                       find first tt-gds-units no-lock where tt-gds-units.GUID_ = gdsMercsubsObj:GdsMercsubsCurr:GUID_ and tt-gds-units.GUID_ begins guid_ no-error .
     3836                       if available (tt-gds-units) then tt-gds.units = tt-gds-units.units .
     3837                       tt-gds.ID           = jj .
     3838                       tt-gds.gds-code     = gdsMercsubsObj:GdsMercsubsCurr:GdsCode .
     3839                       tt-gds.prod-type    = gdsMercsubsObj:GdsMercsubsCurr:ProdType .
     3840                       tt-gds.db-num       = gdsMercsubsObj:GdsMercsubsCurr:DBNum .
     3841                       tt-gds.gds-name     = buf_goods.gds-name .
     3842                       tt-gds.units-th     = buf_goods.unit-base .
     3843                       tt-gds.merc-name    = gdsMercsubsObj:GdsMercsubsCurr:MercName .
     3844                       tt-gds.cr-date      = gdsMercsubsObj:GdsMercsubsCurr:DateCr .
     3845                       tt-gds.update-date  = gdsMercsubsObj:GdsMercsubsCurr:DateUpdate .
     3846                       tt-gds.GUID-type    = gdsMercsubsObj:GdsMercsubsCurr:GUIDType .
     3847                       tt-gds.GUID-subtype = gdsMercsubsObj:GdsMercsubsCurr:GUIDSubType .
     3848                       tt-gds.GUID         = gdsMercsubsObj:GdsMercsubsCurr:GUID_ .
     3849                       tt-gds.UUID         = gdsMercsubsObj:GdsMercsubsCurr:UUID .
     3850                     end.
     3851                   end.
     3852                 end.
     3853                 else
     3854                 do:
     3855                   if guid_ = "" then
     3856                   do:
     3857                     create tt-gds .
     3858                     tt-gds.ID = jj .
     3859                     tt-gds.gds-code  = buf_goods.gds-code .
     3860                     tt-gds.gds-name = buf_goods.gds-name .
     3861                     tt-gds.units-th     = buf_goods.unit-base .
     3862                   end.
     3863                 end.
     3864               end.
     3865             end.
     3866           end.
     3867         end.
     3868     end case .
     3869     delete object gdsMercsubsObj no-error .
     3870     delete object gdsmercstrObj no-error .
     3871     select-list = "" .
     3872   end procedure.
     3873   procedure refresh-query :
     3874     case rs-sort :
     3875       when 1 then
     3876         do:
     3877           open query br-goods for each tt-gds where tt-gds.uuid <> ""
     3878             by tt-gds.gds-code indexed-reposition .
     3879         end.
     3880       when 2 then
     3881         do:
     3882           open query br-goods for each tt-gds where tt-gds.uuid = ""
     3883             by tt-gds.gds-code indexed-reposition .
     3884         end.
     3885       otherwise
     3886       do:
     3887         open query br-goods for each tt-gds
     3888           by tt-gds.gds-code indexed-reposition .
     3889       end.
     3890     end case.
     3891   end procedure.
     3892   PROCEDURE local-mark :
     3893     if not available tt-gds then
     3894     do:
     3895       message "Неправильный выбор строки.".
     3896       return no-apply.
     3897     end.
     3898   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3899   define variable v-str-recid15 as character no-undo .
     3900   define variable v-num-entry15 as integer   no-undo .
     3901   assign
     3902     v-str-recid15 = trim( string( recid( tt-gds ) , "->>>>>>>>>>>9":U ) )
     3903     v-num-entry15 = lookup( v-str-recid15 , select-list )
     3904   .
     3905   if v-num-entry15 > 0 then do:
     3906     assign
     3907       entry( v-num-entry15, select-list ) = "":U
     3908       select-list = trim( replace( select-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     3909     .
     3910   end.
     3911   else do:
     3912     assign
     3913       select-list = select-list + ( if select-list = "":U then "":U else chr(44) ) + v-str-recid15
     3914     .
     3915   end.
     3916     br-goods:refresh() in frame Dialog-Frame .
     3917   end procedure.
     3918   PROCEDURE proc-b-mark :
     3919     define variable varlog as logical no-undo .
     3920     if not available tt-gds then return.
     3921     run local-mark in this-procedure.
     3922     assign
     3923       varlog = br-goods :select-next-row( ) in frame Dialog-Frame.
     3924     apply "ENTRY":U to br-goods in frame Dialog-Frame.
     3925     br-goods:refresh() in frame Dialog-Frame .
     3926   end procedure.
     3927   PROCEDURE sel-goods :
     3928     v-select-list = "" .
     3929     run str/gds-list.w (
     3930       input parparentproc
     3931       , input v-cntxt-host-code-obj
     3932       , input v-cntxt-obj-type
     3933       , input v-cntxt-obj-code) no-error.
     3934     for each gds-list no-lock:
     3935       v-select-list = v-select-list + "," + string(gds-list.gds-code) no-error.
     3936     end.
     3937     if v-select-list <> "" then
     3938     do:
     3939       v-select-list = trim (v-select-list) no-error.
     3940       run fill-tt.
     3941       run refresh-query in this-procedure .
     3942       apply "value-changed" to br-goods in frame Dialog-Frame .
     3943     end .
     3944   end procedure.
     3945   PROCEDURE sel-prod :
     3946     assign
     3947       ref-list = "":U
     3948       .
     3949     run ref/cli-all.w (
     3950       input parparentproc
     3951       ,  input "b-sel"
     3952       ,  input 'все':U
     3953       ,  input 'все':U
     3954       ,  input 'текущие':U
     3955       ,  input ?
     3956       ,  input ",,,,,,NO,,,"
     3957       ,  input ?
     3958       , output ref-list
     3959       ) .
     3960     if ref-list = "":U then
     3961     do:
     3962       run enable_UI in this-procedure.
     3963       return no-apply.
     3964     end.
     3965     find first buf_clients no-lock where recid(buf_clients) = integer(ref-list) no-error.
     3966     if available buf_clients then
     3967     do :
     3968       assign
     3969         v-prod      = buf_clients.obj-type + "," + string(buf_clients.obj-code)
     3970         v-prod-name = buf_clients.obj-name
     3971         .
     3972     end.
     3973     display v-prod v-prod-name with frame Dialog-Frame.
     3974     run fill-tt.
     3975     run refresh-query in this-procedure .
     3976     apply "value-changed" to br-goods in frame Dialog-Frame .
     3977   end procedure.
     3978   procedure ini_enable :
     3979     case r-type :
     3980       when 1 then
     3981         do:
     3982           enable
     3983             v-prod
     3984             v-prod-name
     3985             b-prod
     3986             b-connect
     3987             with frame Dialog-Frame.
     3988           hide
     3989             b-spisok
     3990             in frame Dialog-Frame .
     3991           disable
     3992             b-mark
     3993             b-sel-all
     3994             b-unmark
     3995             with frame Dialog-Frame .
     3996         end.
     3997       when 2 then
     3998         do:
     3999           hide
     4000             v-prod
     4001             v-prod-name
     4002             b-prod
     4003             in frame Dialog-Frame.
     4004           enable
     4005             b-spisok
     4006             b-mark
     4007             b-sel-all
     4008             b-unmark
     4009             with frame Dialog-Frame .
     4010           disable
     4011             b-connect
     4012             with frame Dialog-Frame .
     4013         end.
     4014     end case .
     4015     if v-cntxt-db-num <> 0 then
     4016     do:
     4017       disable
     4018         b-update
     4019         b-connect
     4020         b-import
     4021         b-del
     4022         b-load
     4023         with frame Dialog-Frame .
     4024     end.
     4025     else
     4026     do:
     4027       SECURITY-POLICY:SYMMETRIC-ENCRYPTION-KEY = GENERATE-PBE-KEY("sysadm").
     4028   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4029   empty temp-table thbjattr_thbj-attr.
     4030   run adm/shattri.p (
     4031      input "get":U
     4032     ,input v-cntxt-obj-type
     4033     ,input v-cntxt-obj-code
     4034     ,input 'mercur':U
     4035     ,input  ""
     4036     ,output v-value-character
     4037     ,output v-value-date
     4038     ,output v-value-decimal
     4039     ,output v-value-integer
     4040     ,output v-value-logical
     4041     ,output par-type
     4042     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     4043     ) no-error .
     4044       for each thbjattr_thbj-attr :
     4045         case thbjattr_thbj-attr.prop-code :
     4046           when "login" then
     4047             v-login = thbjattr_thbj-attr.property-value-character .
     4048           when "password" then
     4049             v-password = thbjattr_thbj-attr.property-value-character .
     4050           when "server" then
     4051             do:
     4052               case thbjattr_thbj-attr.property-value-integer :
     4053                 when 1 then
     4054                   do:
     4055                     v-server = "https://api2.vetrf.ru:8002" .
     4056                   end.
     4057                 when 2 then
     4058                   do:
     4059                     v-server = "https://api.vetrf.ru" .
     4060                   end.
     4061               end case .
     4062             end.
     4063           when "proxy-addres" then
     4064             v-proxy-addres = thbjattr_thbj-attr.property-value-character .
     4065           when "proxy-login" then
     4066             do:
     4067               if thbjattr_thbj-attr.property-value-character <> ""
     4068                 then
     4069               do :
     4070   define variable vss-include-info17 as character format "X(65)" no-undo
     4071   initial "@(#)$Workfile$ $Revision$".
     4072   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
     4073     (input  thbjattr_thbj-attr.property-value-character
     4074     ,output v-proxy-login
     4075     ) no-error .
     4076               end.
     4077             end.
     4078           when "proxy-pswd" then
     4079             do:
     4080               if thbjattr_thbj-attr.property-value-character <> ""
     4081                 then
     4082               do :
     4083   define variable vss-include-info18 as character format "X(65)" no-undo
     4084   initial "@(#)$Workfile$ $Revision$".
     4085   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
     4086     (input  thbjattr_thbj-attr.property-value-character
     4087     ,output v-proxy-pswd
     4088     ) no-error .
     4089               end.
     4090             end.
     4091           when "proxy-ssl" then
     4092             v-proxy-ssl = thbjattr_thbj-attr.property-value-logical .
     4093         end case.
     4094       end.
     4095     end.
     4096   end procedure.
