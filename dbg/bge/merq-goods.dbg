      146   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      147   procedure thbjattr_code :
      148      define input  parameter p-upper-code     as character no-undo .
      149      define input  parameter p-code           as character no-undo .
      150      define output parameter p-label          as character no-undo .
      151      define output parameter p-user-can-edit  as logical   no-undo .
      152      define output parameter p-output-display as logical   no-undo .
      153      define output parameter p-other          as character no-undo .
      154      define output parameter p-prop-list      as character no-undo .
      155      define output parameter p-prop-type-list as character no-undo .
      156      define output parameter p-prop-label-list as character no-undo .
      157      define output parameter p-global          as logical no-undo .
      158      define output parameter p-host           as logical no-undo .
      159      define output parameter p-shop           as logical no-undo .
      160      define output parameter p-store          as logical no-undo .
      161      define output parameter p-db             as logical no-undo .
      162      define variable p-region as logical no-undo.
      163      run thbjattr_code_reg in this-procedure (
      164                                               p-upper-code,
      165                                               p-code,
      166                                               output p-label,
      167                                               output p-user-can-edit,
      168                                               output p-output-display,
      169                                               output p-other,
      170                                               output p-prop-list,
      171                                               output p-prop-type-list,
      172                                               output p-prop-label-list,
      173                                               output p-global,
      174                                               output p-host,
      175                                               output p-shop,
      176                                               output p-store,
      177                                               output p-db,
      178                                               output p-region
      179                                               ).
