      713   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      714   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      715   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      716   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      717   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      718   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      719   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      720   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      721   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      722   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      723   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      724   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      725   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      726   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      727   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      728   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      729   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      730   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      731   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      732   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      733   procedure gen-key-rec :
      734     define input  parameter p-tbl-name    as character no-undo.
      735     define input  parameter p-bh_tbl-name as handle    no-undo.
      736     define output parameter p-key-rec     as character no-undo.
      737     do
      738     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      739     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      740     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      741     :
      742       define variable fh               as handle    no-undo .
      743       define variable v-ok             as logical   no-undo .
      744       define variable v-inform         as character no-undo .
      745       define variable v-ind            as integer   no-undo .
      746       define variable v-idx-field-qnty as integer   no-undo .
      747       if p-tbl-name = ?
      748         or p-tbl-name = "":U
      749       then do:
      750         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info7 ).
      751       end.
      752       if not p-bh_tbl-name:available then do:
      753         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info7, p-tbl-name ).
      754       end.
      755       assign
      756         p-key-rec = p-tbl-name
      757         v-inform  = p-bh_tbl-name:index-information(1)
      758         v-ind     = 2
      759       .
      760       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      761       on error undo, return error
      762       :
      763         assign
      764           v-inform = p-bh_tbl-name:index-information( v-ind )
      765           v-ind    = v-ind + 1
      766         .
      767       end.
      768       if v-inform = ?
      769         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      770         or entry( 3, v-inform, ",":U ) <> "1":U
      771       then do:
      772         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, p-tbl-name ).
      773       end.
      774       else do:
      775         assign
      776           v-idx-field-qnty = num-entries( v-inform ) - 4
      777         .
      778         if v-idx-field-qnty < 2 then do:
      779           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, p-tbl-name ).
      780         end.
      781         do v-ind = 1 to v-idx-field-qnty by 2
      782         on error undo, return error
      783         :
      784           assign
      785             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      786             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      787           .
      788         end.
      789       end.
      790       if p-key-rec = ? then do:
      791         assign
      792           p-key-rec = "":U
      793         .
      794         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info7, p-tbl-name ).
      795       end.
      796     end.
      797     return.
      798   end procedure.
      799   procedure gen-where-keyr-tab :
      800     define input  parameter i-tableSerach as character no-undo.
      801     define input  parameter i-tablekey   as character  no-undo.
      802     define input  parameter p-key-rec    as character  no-undo.
      803     define input  parameter p-key-handle as handle     no-undo .
      804     define input  parameter p-db-name    as character  no-undo .
      805     define input  parameter p-tt-handle  as handle     no-undo .
      806     define output parameter o-Where      as character  no-undo.
      807     do
      808     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      809     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      810     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      811     :
      812       define variable v-full-tbl-name  as character no-undo .
      813       define variable bh_tbl-name      as handle    no-undo .
      814       define variable fh_key           as handle    no-undo .
      815       define variable fh_search        as handle    no-undo .
      816       define variable v-field-num      as integer   no-undo .
      817       define variable v-count-fld      as integer   no-undo .
      818       define variable v-inform         as character no-undo .
      819       define variable v-ind            as integer   no-undo .
      820       define variable v-idx-field-qnty as integer   no-undo .
      821       define variable v-field-name     as character no-undo .
      822       define variable v-field-val      as character no-undo .
      823       define variable v-word-link      as character no-undo .
      824       define variable vTable           as character no-undo.
      825       define variable bh_tbl-key       as handle    no-undo .
      826       assign
      827         p-key-rec = trim( p-key-rec )
      828       .
      829       if p-key-handle <> ? then do:
      830         if not valid-handle(p-key-handle)
      831            or p-key-handle:type <> "buffer"
      832         then do:
      833           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info7 ).
      834         end.
      835         if num-entries( p-key-rec, chr(3) ) > 1
      836           or p-key-rec = ?
      837           or p-key-rec = "":U
      838         then do:
      839           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info7, p-key-rec ).
      840         end.
      841       end.
      842       else do:
      843         if p-key-rec = ?
      844           or p-key-rec = "":U
      845         then do:
      846           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
      847         end.
      848       end.
      849       assign
      850         vTable = entry( 1 , p-key-rec, chr(3) )
      851       .
      852       if p-tt-handle <> ?
      853         and ( not valid-handle(p-tt-handle)
      854               or p-tt-handle:type <> "buffer"
      855             )
      856       then do:
      857         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info7, vTable, chr(10) ).
      858       end.
      859       if p-tt-handle = ? then do:
      860         assign
      861           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      862         .
      863         create buffer bh_tbl-name for table v-full-tbl-name .
      864       end.
      865       else do:
      866         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      867       end.
      868       assign
      869         v-inform = bh_tbl-name:index-information(1)
      870         v-ind    = 2
      871       .
      872       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      873       on error undo, return error
      874       :
      875         assign
      876           v-inform = bh_tbl-name:index-information( v-ind )
      877           v-ind    = v-ind + 1
      878         .
      879       end.
      880       if v-inform = ?
      881         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      882         or entry( 3, v-inform, ",":U ) <> "1":U
      883       then do:
      884         delete object bh_tbl-name no-error.
      885         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info7, vTable ).
      886       end.
      887       assign
      888         v-idx-field-qnty = num-entries( v-inform ) - 4
      889       .
      890       if v-idx-field-qnty < 2 then do:
      891         delete object bh_tbl-name no-error.
      892         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, vTable ).
      893       end.
      894       assign
      895         o-where     = "where":U
      896         v-word-link = "":U
      897         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      898         v-count-fld = 0
      899       .
      900       if i-tablekey ne "" and i-tablekey ne ?
      901       then do:
      902         assign
      903           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      904         .
      905         create buffer bh_tbl-key for table v-full-tbl-name .
      906       end.
      907       if i-tableSerach ne "" and i-tableSerach ne ?
      908       then do:
      909         delete object bh_tbl-name no-error.
      910         assign
      911           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      912         .
      913         create buffer bh_tbl-name for table v-full-tbl-name .
      914       end.
      915       block_where:
      916       do v-ind = 1 to v-idx-field-qnty by 2
      917       on error undo, return error
      918       :
      919         assign
      920           v-count-fld = v-count-fld + 1
      921         .
      922         if p-key-handle = ?
      923           and v-count-fld > v-field-num
      924         then do:
      925           leave block_where.
      926         end.
      927         define variable VfieldKeyTable as handle no-undo.
      928         assign
      929           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      930           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      931         .
      932         if     bh_tbl-key ne ?
      933         then do:
      934            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      935            if VfieldKeyTable eq ?
      936            then next block_where.
      937         end.
      938         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      939         then
      940            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      941         else
      942            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      943         if p-key-handle = ? then do:
      944           assign
      945             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      946           .
      947         end.
      948         else do:
      949           assign
      950             fh_key = p-key-handle:buffer-field( v-field-name )
      951           .
      952           if fh_key = ?
      953             or not valid-handle( fh_key )
      954           then do:
      955             delete object bh_tbl-name.
      956             if     bh_tbl-key ne ?
      957             then
      958                delete object bh_tbl-key.
      959             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info7, p-key-handle:name, v-field-name ).
      960           end.
      961           assign
      962             v-field-val = fh_key:buffer-value
      963           .
      964         end.
      965         if fh_search:data-type ="character":U then do:
      966           assign
      967             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      968             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      969             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      970             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      971             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      972             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      973             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      974             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      975             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      976             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      977             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      978             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      979             v-field-val = substitute( '"&1"', v-field-val )
      980           .
      981         end.
      982         assign
      983           o-where = substitute( "&1 &2", o-where, v-field-val )
      984         .
      985         if v-word-link = "":U then do:
      986           assign
      987             v-word-link = "and":U
      988           .
      989         end.
      990       end.
      991       delete object bh_tbl-name.
      992       if     bh_tbl-key ne ?
      993       then
      994          delete object bh_tbl-key.
      995       if p-key-handle = ?
      996         and v-count-fld <> v-field-num
      997       then do:
      998         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info7, vTable ).
      999       end.
     1000     end.
     1001   end procedure.
     1002   procedure gen-hn-keyr-tab :
     1003     define input  parameter i-tableSerach as character no-undo.
     1004     define input  parameter i-tablekey   as character no-undo.
     1005     define input  parameter p-key-rec    as character no-undo.
     1006     define input  parameter p-key-handle as handle    no-undo .
     1007     define input  parameter p-db-name    as character no-undo .
     1008     define input  parameter p-tt-handle  as handle    no-undo .
     1009     define input  parameter p-stts-lock  as integer   no-undo .
     1010     define output parameter o-hn         as handle    no-undo.
     1011     define variable v-full-tbl-name as character no-undo.
     1012     define variable v-where         as character no-undo.
     1013     define variable bh_tbl-name     as handle    no-undo.
     1014     define variable vTable          as character no-undo.
     1015     do
     1016     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1017     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1018     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1019         run gen-where-keyr-tab(i-tableSerach,
     1020                                i-tablekey,
     1021                                p-key-rec,
     1022                                p-key-handle,
     1023                                p-db-name,
     1024                                p-tt-handle,
     1025                                output v-where).
     1026         if i-tableSerach ne "" and i-tableSerach ne ?
     1027         then do:
     1028            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1029            create buffer bh_tbl-name for table v-full-tbl-name .
     1030         end.
     1031         else do:
     1032            if p-tt-handle = ? then do:
     1033               assign
     1034                  vTable = entry( 1 , p-key-rec, chr(3) )
     1035               .
     1036               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1037               create buffer bh_tbl-name for table v-full-tbl-name .
     1038            end.
     1039            else do:
     1040               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1041            end.
     1042         end.
     1043         if p-tt-handle = ? then do:
     1044            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1045         end.
     1046         else do:
     1047            bh_tbl-name:find-first( v-where ) no-error .
     1048         end.
     1049         o-hn = bh_tbl-name.
     1050      end.
     1051   end procedure.
     1052   procedure gen-hn-keyr :
     1053     define input  parameter p-key-rec    as character no-undo.
     1054     define input  parameter p-key-handle as handle    no-undo .
     1055     define input  parameter p-db-name    as character no-undo .
     1056     define input  parameter p-tt-handle  as handle    no-undo .
     1057     define input  parameter p-stts-lock  as integer   no-undo .
     1058     define output parameter o-hn         as handle    no-undo.
     1059     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1060   end.
     1061   procedure gen-row-keyr :
     1062     define input  parameter p-key-rec    as character no-undo.
     1063     define input  parameter p-key-handle as handle    no-undo .
     1064     define input  parameter p-db-name    as character no-undo .
     1065     define input  parameter p-tt-handle  as handle    no-undo .
     1066     define input  parameter p-stts-lock  as integer   no-undo .
     1067     define output parameter p-tbl-row    as rowid     no-undo.
     1068     define output parameter p-tbl-name   as character no-undo.
     1069     define variable vHn as handle no-undo.
     1070       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1071       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1072       p-tbl-name =  vHn:table.
     1073       delete object vHn no-error.
     1074     if p-tbl-row = ? then do:
     1075       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info7, p-tbl-name, p-key-rec ).
     1076     end.
     1077     else do:
     1078       return.
     1079     end.
     1080   end procedure.
     1081   procedure gen-key-fv :
     1082     define input  parameter p-key-rec    as character no-undo .
     1083     define output parameter p-field-list as character no-undo .
     1084     define output parameter p-value-list as character no-undo.
     1085     do
     1086     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1087     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1088     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1089     :
     1090       define variable v-full-tbl-name  as character no-undo .
     1091       define variable bh_tbl-name      as handle    no-undo .
     1092       define variable v-tbl-name       as character no-undo .
     1093       define variable v-field-num      as integer   no-undo .
     1094       define variable v-count-fld      as integer   no-undo .
     1095       define variable v-inform         as character no-undo .
     1096       define variable v-ind            as integer   no-undo .
     1097       define variable v-idx-field-qnty as integer   no-undo .
     1098       define variable v-delim-key      as character no-undo .
     1099       if p-key-rec = ?
     1100         or p-key-rec = "":U
     1101       then do:
     1102         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1103       end.
     1104       assign
     1105         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1106         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1107       .
     1108       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1109       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info7 ).
     1110       assign
     1111         v-inform = bh_tbl-name:index-information(1)
     1112         v-ind    = 2
     1113       .
     1114       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1115       on error undo, return error
     1116       :
     1117         assign
     1118           v-inform = bh_tbl-name:index-information( v-ind )
     1119           v-ind    = v-ind + 1
     1120         .
     1121       end.
     1122       if v-inform = ?
     1123         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1124         or entry( 3, v-inform, ",":U ) <> "1":U
     1125       then do:
     1126         delete object bh_tbl-name no-error.
     1127         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1128       end.
     1129       assign
     1130         v-idx-field-qnty = num-entries( v-inform ) - 4
     1131       .
     1132       if v-idx-field-qnty < 2 then do:
     1133         delete object bh_tbl-name no-error.
     1134         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1135       end.
     1136       assign
     1137         p-field-list = "":U
     1138         p-value-list = "":U
     1139         v-delim-key  = "":U
     1140         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1141         v-count-fld  = 0
     1142       .
     1143       block_where:
     1144       do v-ind = 1 to v-idx-field-qnty by 2
     1145       on error undo, return error
     1146       :
     1147         assign
     1148           v-count-fld = v-count-fld + 1
     1149         .
     1150         if v-count-fld > v-field-num then do:
     1151           leave block_where.
     1152         end.
     1153         assign
     1154           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1155           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1156         .
     1157         if v-ind = 1 then do:
     1158           assign
     1159             v-delim-key = chr(3)
     1160           .
     1161         end.
     1162       end.
     1163       delete object bh_tbl-name.
     1164       if v-count-fld <> v-field-num then do:
     1165         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info7, v-tbl-name ).
     1166       end.
     1167     end.
     1168   end procedure.
     1169   procedure gen-key-field :
     1170     define input  parameter p-table      as character no-undo .
     1171     define output parameter p-field-list as character no-undo .
     1172     do
     1173     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1174     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1175     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1176     :
     1177       define variable v-full-tbl-name  as character no-undo .
     1178       define variable bh_tbl-name      as handle    no-undo .
     1179       define variable v-tbl-name       as character no-undo .
     1180       define variable v-field-num      as integer   no-undo .
     1181       define variable v-count-fld      as integer   no-undo .
     1182       define variable v-inform         as character no-undo .
     1183       define variable v-ind            as integer   no-undo .
     1184       define variable v-idx-field-qnty as integer   no-undo .
     1185       define variable v-delim-key      as character no-undo .
     1186       if p-table = ?
     1187         or p-table = "":U
     1188       then do:
     1189         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info7 ).
     1190       end.
     1191       assign
     1192         v-tbl-name      = p-table
     1193         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1194       .
     1195       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1196       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info7 ).
     1197       assign
     1198         v-inform = bh_tbl-name:index-information(1)
     1199         v-ind    = 2
     1200       .
     1201       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1202       on error undo, return error
     1203       :
     1204         assign
     1205           v-inform = bh_tbl-name:index-information( v-ind )
     1206           v-ind    = v-ind + 1
     1207         .
     1208       end.
     1209       if v-inform = ?
     1210         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1211         or entry( 3, v-inform, ",":U ) <> "1":U
     1212       then do:
     1213         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1214       end.
     1215       assign
     1216         v-idx-field-qnty = num-entries( v-inform ) - 4
     1217       .
     1218       if v-idx-field-qnty < 2 then do:
     1219         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1220       end.
     1221       assign
     1222         p-field-list = "":U
     1223         v-delim-key  = "":U
     1224         v-count-fld  = 0
     1225       .
     1226       block_where:
     1227       do v-ind = 1 to v-idx-field-qnty by 2
     1228       on error undo, return error
     1229       :
     1230         assign
     1231           v-count-fld = v-count-fld + 1
     1232         .
     1233         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1234         if v-ind = 1 then do:
     1235           assign
     1236             v-delim-key = chr(3)
     1237           .
     1238         end.
     1239       end.
     1240       delete object bh_tbl-name.
     1241     end.
     1242   end procedure.
     1243   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1244   procedure gds-attr-name :
     1245     define input  parameter p-code           as character no-undo .
     1246     define output parameter p-type           as character no-undo .
     1247     define output parameter p-format         as character no-undo .
     1248     define output parameter p-label          as character no-undo .
     1249     define output parameter p-user-can-edit  as logical   no-undo .
     1250     define output parameter p-output-display as logical   no-undo .
     1251     define output parameter p-other          as character no-undo .
     1252     do
     1253     on error undo, return error
     1254     :
     1255           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
     1256         (input  p-code
     1257         ,output p-type
     1258         ,output p-format
     1259         ,output p-label
     1260         ,output p-user-can-edit
     1261         ,output p-output-display
     1262         ,output p-other
     1263         ) no-error .
     1264       if error-status :error
     1265       then do:
     1266         undo, return error return-value .
     1267       end.
     1268     end.
     1269   end procedure.
     1270   procedure gds-attr-tooltip :
     1271     define input  parameter p-code    as character no-undo .
     1272     define output parameter p-tooltip as character no-undo .
     1273     define output parameter p-label   as character no-undo .
     1274     do
     1275     on error undo, return error
     1276     :
     1277           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-tooltip in g#attr-lib
     1278         (input  p-code
     1279         ,output p-tooltip
     1280         ,output p-label
     1281         ) no-error .
     1282       if error-status :error
     1283       then do:
     1284         undo, return error return-value .
     1285       end.
     1286     end.
     1287   end procedure.
     1288   procedure gds-attr-value :
     1289     define input  parameter p-gds-code as integer   no-undo .
     1290     define input  parameter p-code     as character no-undo .
     1291     define output parameter p-value    as character no-undo .
     1292     define output parameter p-type     as character no-undo .
     1293     do
