      578   procedure xmlchar-decode :
      579   define input parameter p-in-string      as character        no-undo.
      580   define output parameter p-out-string    as character        no-undo.
      581       define variable v-position      as integer      no-undo.
      582       define variable v-last-position as integer      no-undo.
      583       define variable v-temp-integer  as integer      no-undo.
      584       define variable v-current-char  as character    no-undo.
      585       define variable v-next-char     as character    no-undo.
      586       define variable v-success       as logical      no-undo.
      587   do
      588   on error undo, return error
      589   :
      590       assign
      591           p-out-string = "":U
      592           v-position   = 0
      593       .
      594       replace-cycle:
      595       do while yes
      596       on error undo, return error
      597       :
      598           assign
      599               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      600           .
      601           if v-last-position <= v-position
      602           then do:
      603               if v-position = 0
      604               then do:
      605                   assign
      606                       p-out-string = p-in-string
      607                   .
      608               end.
      609               else do:
      610                   assign
      611                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      612                   .
      613               end.
      614               leave replace-cycle.
      615           end.
      616           else do:
      617               assign
      618                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      619                   v-position      = v-last-position
      620                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      621               .
      622               if v-current-char = "#":U
      623               then do:
      624                   assign
      625                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      626                   .
      627                   if v-last-position > 0
      628                   then do:
      629                       run xmlchar-read-integer in this-procedure
      630                        (
      631                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      632                           , output v-temp-integer
      633                           , output v-success
      634                       ).
      635                       if v-success = yes
      636                       and v-temp-integer >= 1
      637                       and v-temp-integer <= 255
      638                       then do:
      639                           assign
      640                               p-out-string = p-out-string + chr( v-temp-integer )
      641                               v-position   = v-last-position + 1
      642                           .
      643                       end.
      644                       else do:
      645                           assign
      646                               p-out-string = p-out-string + "&":U
      647                               v-position   = v-position   + 1
      648                           .
      649                       end.
      650                   end.
      651                   else do:
      652                       assign
      653                           p-out-string = p-out-string + "&":U
      654                           v-position   = v-position   + 1
      655                       .
      656                   end.
      657               end.
      658               else do:
      659                   case substring( p-in-string, v-position + 1, 3 )
      660                   :
      661                       when "lt;":U
      662                       then do:
      663                           assign
      664                               p-out-string = p-out-string + "<":U
      665                               v-position   = v-position   + 3
      666                           .
      667                       end.
      668                       when "gt;":U
      669                       then do:
      670                           assign
      671                               p-out-string = p-out-string + ">":U
      672                               v-position   = v-position   + 3
      673                           .
      674                       end.
      675                       otherwise do:
      676                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      677                           then do:
      678                               assign
      679                                   p-out-string = p-out-string + "&":U
      680                                   v-position   = v-position   + 4
      681                               .
      682                           end.
      683                           else do:
      684                               case substring( p-in-string, v-position + 1, 5 )
      685                               :
      686                                   when "quot;":U
      687                                   then do:
      688                                       assign
      689                                           p-out-string = p-out-string + '"':U
      690                                           v-position   = v-position   + 5
      691                                       .
      692                                   end.
      693                                   when "apos;":U
      694                                   then do:
      695                                       assign
      696                                           p-out-string = p-out-string + "'":U
      697                                           v-position   = v-position   + 5
      698                                       .
      699                                   end.
      700                                   otherwise do:
      701                                       assign
      702                                           p-out-string = p-out-string + "&":U
      703                                       .
      704                                   end.
      705                               end case.
      706                           end.
      707                       end.
      708                   end case.
      709               end.
      710           end.
      711       end.
      712   end.
      713   end .
      714   procedure xmlchar-read-integer :
      715   define input parameter p-input-string      as character        no-undo.
      716   define output parameter p-output-integer   as integer          no-undo.
      717   define output parameter p-success       as logical          no-undo.
      718   do
      719   on error undo, return error
      720   :
      721       assign
      722           p-output-integer = integer( p-input-string )
      723       no-error.
      724       if error-status :error
      725       then do:
      726           assign
      727               p-success           = no
      728               p-output-integer    = 0
      729           .
      730       end.
      731       else do:
      732           assign
      733               p-success           = yes
      734           .
      735       end.
      736   end.
      737   end.
      738   define variable v-bgelib-bgeclall           as logical      no-undo.
      739   define variable v-bgelib-bgedict            as logical      no-undo.
      740   define temp-table temp_ext-doc-type no-undo
      741       field edt-key               as integer
      742       field ext-doc-type          as character
      743       field ext-doc-type-label    as character
      744       index pi is primary unique
      745           edt-key
      746   .
      747   define temp-table temp_bgelib_goods no-undo
      748       field gds-code as integer
      749       index pi is primary unique
      750           gds-code
      751   .
      752   define temp-table temp_bgelib_clients no-undo
      753       field obj-type as character
      754       field obj-code as integer
      755       index pi is primary unique
      756           obj-type
      757           obj-code
      758   .
      759   define temp-table temp_bgelib_dis-card no-undo
      760       field d-card as character
      761       index pi is primary unique
      762           d-card
      763   .
      764   define temp-table temp_bgelib_trn-doc no-undo
      765       field doc-code as integer
      766   .
      767   procedure bgelib-tag-open:
      768   do
      769   on error undo, return error
      770   :
      771   define input parameter v-tag-level  as integer      no-undo.
      772   define input parameter v-tag-name   as character    no-undo.
      773   define input parameter v-tag-value  as character    no-undo.
      774       put stream stmXMLOut unformatted
      775           chr(10)
      776           + fill(" ", 4 * v-tag-level)
      777           + "<" + v-tag-name
      778           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      779           + v-tag-value + ">"
      780       .
      781   end.
      782   end procedure.
      783   procedure bgelib-tag-put:
      784   do
      785   on error undo, return error
      786   :
      787   define input parameter v-tag-level      as integer      no-undo.
      788   define input parameter v-tag-name       as character    no-undo.
      789   define input parameter v-tag-value      as character    no-undo.
      790   define input parameter v-empty-mode     as integer      no-undo.
      791       v-tag-name = trim(v-tag-name).
      792       if  v-empty-mode = 1
      793       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      794       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      795       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      796       then do:
      797           run xmlchar-encode in this-procedure (
      798                 input v-tag-value
      799               , output v-tag-value
      800           ).
      801           put stream stmXMLOut unformatted
      802               chr(10) + fill(" ", 4 * v-tag-level)
      803                           + '<' + v-tag-name + '>'
      804                           + v-tag-value
      805                           + '</' + v-tag-name + '>'
      806           .
      807       end.
      808   end.
      809   end procedure.
      810   procedure bgelib-tag-close:
      811   do
      812   on error undo, return error
      813   :
      814   define input parameter v-tag-level as integer      no-undo.
      815   define input parameter v-tag-name  as character    no-undo.
      816       put stream stmXMLOut unformatted
      817           chr(10)
      818           + fill( " ", 4 * v-tag-level)
      819           + '</' + v-tag-name + '>'
      820       .
      821   end.
      822   end procedure.
      823   procedure bgelib-write-log:
      824   do
      825   on error undo, return error
      826   :
      827   define input parameter v-filename   as character    no-undo.
      828   define input parameter v-log-level  as integer      no-undo.
      829   define input parameter v-out-string as character    no-undo.
      830       output stream stmXMLLog to value( v-filename ) append.
      831       put stream stmXMLLog unformatted
      832           chr(10)
      833       .
      834       put stream stmXMLLog unformatted
      835           ( if v-log-level = 0
      836             or v-out-string = "&DLine"
      837             or v-out-string = "&Line"
      838             then ""
      839             else cur-time-string-sec() + " " )
      840       .
      841       put stream stmXMLLog unformatted
      842           ( if v-out-string = "&Line"
      843             then fill( "-", 80 )
      844             else if v-out-string = "&DLine"
      845                  then fill( "=", 80 )
      846                  else v-out-string )
      847       .
      848       output stream stmXMLLog close.
      849   end.
      850   end procedure.
      851   procedure bgelib-write-edt:
      852   do
      853   on error undo, return error
      854   :
      855   define input parameter v-editor-handle    as handle       no-undo.
      856   define input parameter v-log-level        as integer      no-undo.
      857   define input parameter v-out-string       as character    no-undo.
      858       if valid-handle ( v-editor-handle )
      859       then do:
      860           v-editor-handle :move-to-eof().
      861           v-editor-handle :insert-string( ( if v-log-level = 0
      862                                             or v-out-string = "&DLine"
      863                                             or v-out-string = "&Line"
      864                                             then ""
      865                                             else cur-time-string-sec() + " "
      866                                         ) ).
      867           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      868                                             then fill( "-", 80 )
      869                                             else if v-out-string = "&DLine" then fill("=", 80)
      870                                             else fill( " ", v-log-level) + v-out-string
      871                                         ) ).
      872           v-editor-handle :insert-string( chr(10) ).
      873       end.
      874       process events.
      875       output to 'bgescn.txt' append.
      876           put unformatted
      877               chr(10)
      878               string( ( if v-log-level = 0
      879                         or v-out-string = "&DLine"
      880                         or v-out-string = "&Line"
      881                         then ""
      882                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      883                     ) )
      884               string( ( if v-out-string = "&Line"
      885                         then fill( "-", 80 )
      886                         else if v-out-string = "&DLine"
      887                              then fill( "=", 80 )
      888                              else fill( " ", v-log-level ) + v-out-string
      889                     ) )
      890           .
      891       output close.
      892   end.
      893   end procedure.
      894   procedure bgelib-show-cnt:
      895   do
      896   on error undo, return error
      897   :
      898   define input parameter v-fillin-handle     as handle   no-undo.
      899       if valid-handle( v-fillin-handle )
      900       then do:
      901           assign
      902               v-fillin-handle :visible = true
      903           .
      904       end.
      905   end.
      906   end procedure.
      907   procedure bgelib-hide-cnt:
      908   do
      909   on error undo, return error
      910   :
      911   define input parameter v-fillin-handle     as handle   no-undo.
      912       if valid-handle( v-fillin-handle )
      913       then do:
      914           assign v-fillin-handle :visible = false.
      915       end.
      916   end.
      917   end procedure.
      918   procedure bgelib-write-cnt:
      919   do
      920   on error undo, return error
      921   :
      922   define input parameter v-fillin-handle    as handle       no-undo.
      923   define input parameter v-fillin-string    as character    no-undo.
      924       if valid-handle( v-fillin-handle )
      925       then do:
      926           assign
      927               v-fillin-handle :SCREEN-value = v-fillin-string
      928           .
      929       end.
      930   end.
      931   end procedure.
      932   procedure bgelib-write-header:
      933   do
      934   on error undo, return error
      935   :
      936   define input parameter p-first-file     as logical      no-undo.
      937   define input parameter p-xml-file-name  as character    no-undo.
      938   define input parameter p-list-file-name as character    no-undo.
      939   define input parameter p-file-number    as integer      no-undo.
      940   define input parameter p-have-prev      as logical      no-undo.
      941   define input parameter p-prev-filename  as character    no-undo.
      942   define input parameter p-obj-list       as character    no-undo.
      943   define input parameter p-doc-type-list  as character    no-undo.
      944   define input parameter p-parameter-list as character    no-undo.
      945       define variable v-counter    as integer        no-undo.
      946       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      947       put stream stmXMLOut unformatted
      948           "<?xml version='1.0' encoding='windows-1251'?>"
      949       .
      950       run bgelib-tag-open( input 0, input "root"  , input "" ).
      951       run bgelib-tag-open( input 0, input "header", input "" ).
      952       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      953       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      954       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      955       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      956       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      957       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      958       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      959       :
      960           run bgelib-tag-put(
      961                 input 1
      962               , input entry( 2 * v-counter, p-parameter-list )
      963               , input entry( 2 * v-counter + 1, p-parameter-list )
      964               , input 0
      965           ).
      966       end.
      967       run bgelib-tag-close( input 0, input "header" ).
      968       output stream stmXMLOut close.
      969       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      970       if p-first-file = yes
      971       then do:
      972           put stream stmXMLOut unformatted
      973               "<?xml version='1.0' encoding='windows-1251'?>"
      974           .
      975           run bgelib-tag-open( input 0, input "export", input "" ).
      976       end.
      977       run bgelib-tag-open( input 1, input "file", input "" ).
      978       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      979       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      980       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      981       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
      982       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
      983       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      984       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      985       :
      986           run bgelib-tag-put(
      987                 input 2
      988               , input trim(entry( 2 * v-counter, p-parameter-list ))
      989               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
      990               , input 0
      991           ).
      992       end.
      993       run bgelib-tag-close( input 1, input "file" ).
      994       output stream stmXMLOut close.
      995   end.
      996   end procedure.
      997   procedure bgelib-write-footer:
      998   do
      999   on error undo, return error
     1000   :
     1001   define input parameter p-last-file      as logical      no-undo.
     1002   define input parameter p-xml-file-name  as character    no-undo.
     1003   define input parameter p-list-file-name as character    no-undo.
     1004   define input parameter p-have-next      as logical      no-undo.
     1005   define input parameter p-next-file-name as character    no-undo.
     1006       define variable v-error-num     as integer           no-undo.
     1007       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1008       if p-have-next = yes
     1009       then do:
     1010           run bgelib-tag-open( input 0, input "footer", "" ).
     1011           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1012           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1013           run bgelib-tag-close( input 0, input "footer" ).
     1014       end.
     1015       run bgelib-tag-close( input 0, input "root" ).
     1016       output stream stmXMLOut close.
     1017       run bge/os_copy.p (
     1018             input "M"
     1019           , input p-xml-file-name + "tmp"
     1020           , input p-xml-file-name + "xml"
     1021           , output v-error-num
     1022       ).
     1023       if p-last-file = yes
     1024       then do:
     1025           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1026               run bgelib-tag-close( input 0, input "export" ).
     1027           output stream stmXMLOut close.
     1028           run bge/os_copy.p (
     1029                 input "M"
     1030               , input p-list-file-name + "tmp"
     1031               , input p-list-file-name + "xml"
     1032               , output v-error-num
     1033           ).
     1034       end.
     1035   end.
     1036   end procedure.
     1037   procedure bgelib-filename :
     1038   do
     1039   on error undo, return error
     1040   :
     1041   define input parameter p-prefix             as character    no-undo.
     1042   define output parameter p-xml-file-name     as character    no-undo.
     1043   define output parameter p-log-file-name     as character    no-undo.
     1044   define output parameter p-list-file-name    as character    no-undo.
     1045       define variable v-home-dir  as character    no-undo.
     1046       define variable v-error-num as integer      no-undo.
     1047       get-key-value section "BGE" key "outdir" value v-home-dir.
     1048       if v-home-dir = ?
     1049       then do:
     1050           message
     1051             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1052             skip(1)
     1053             skip "Обратитесь к администратору."
     1054           view-as alert-box error.
     1055           undo, return error .
     1056       end.
     1057       run gbl/dir-cre.p (
     1058           input v-home-dir
     1059       ) no-error.
     1060       if error-status :error
     1061       then do:
     1062           message
     1063             skip "Неверно задан каталог экспорта."
     1064             skip(1)
     1065             skip "Обратитесь к администратору."
     1066           view-as alert-box error.
     1067           undo, return error .
     1068       end.
     1069       run bge/genfname.p (
     1070             input v-home-dir
     1071           , input p-prefix
     1072           , input ""
     1073           , input "xml"
     1074           , input "tmp"
     1075           , output p-xml-file-name
     1076       ).
     1077       assign
     1078           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1079           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1080           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1081       .
     1082   end.
     1083   end procedure.
     1084   procedure bgelib-read-config :
     1085   do
     1086   on error undo, return error
     1087   :
     1088   define variable v-par-type as character     no-undo.
     1089     define variable v-param-type      as character  no-undo .
     1090     define variable v-value-character as character  no-undo .
     1091     define variable v-value-date      as date       no-undo .
     1092     define variable v-value-decimal   as decimal    no-undo .
     1093     define variable v-value-integer   as integer    no-undo .
     1094     define variable v-value-logical   as logical    no-undo .
     1095     define variable v-tth             as handle     no-undo .
     1096       assign
     1097           v-bgelib-bgeclall = no
     1098           v-bgelib-bgedict  = no
     1099       .
     1100       run adm/shattri.p ( input "get":U
     1101                         , input  '':u
     1102                         , input  0
     1103                         , input  'bge-export':U
     1104                         , input  'bgeclall':U
     1105                         , output v-value-character
     1106                         , output v-value-date
     1107                         , output v-value-decimal
     1108                         , output v-value-integer
     1109                         , output v-value-logical
     1110                         , output v-param-type
     1111                         , input-output table-handle v-tth
     1112                         ) no-error .
     1113       if error-status :error
     1114       then do:
     1115         assign
     1116           v-bgelib-bgeclall = no
     1117         .
     1118       end.
     1119       else do:
     1120         assign
     1121           v-bgelib-bgeclall = v-value-logical
     1122         .
     1123       end.
     1124       delete object v-tth.
     1125       run adm/shattri.p ( input "get":U
     1126                         , input  '':u
     1127                         , input  0
     1128                         , input  'bge-export':U
     1129                         , input  'bgedict':U
     1130                         , output v-value-character
     1131                         , output v-value-date
     1132                         , output v-value-decimal
     1133                         , output v-value-integer
     1134                         , output v-value-logical
     1135                         , output v-param-type
     1136                         , input-output table-handle v-tth
     1137                         ) no-error .
     1138       if error-status :error
     1139       then do:
     1140         assign
     1141           v-bgelib-bgedict = no
     1142         .
     1143       end.
     1144       else do:
     1145         assign
     1146           v-bgelib-bgedict = v-value-logical
     1147         .
     1148       end.
     1149       delete object v-tth.
     1150       run adm/shattri.p ( input "get":U
     1151                         , input  '':u
     1152                         , input  0
     1153                         , input  'bge-export':U
     1154                         , input  'bgefmt':U
     1155                         , output v-value-character
     1156                         , output v-value-date
     1157                         , output v-value-decimal
     1158                         , output v-value-integer
     1159                         , output v-value-logical
     1160                         , output v-param-type
     1161                         , input-output table-handle v-tth
     1162                         ) no-error .
     1163       if error-status :error
     1164       then do:
     1165         assign
     1166           v-bgelib-bgefmt  = "xml":U
     1167         .
     1168       end.
     1169       else do:
     1170         assign
     1171           v-bgelib-bgefmt  = v-value-character
     1172         .
     1173       end.
     1174       delete object v-tth.
     1175       run adm/shattri.p ( input "get":U
     1176                         , input  '':u
     1177                         , input  0
     1178                         , input  'bge-export':U
     1179                         , input  'bgeflold':U
     1180                         , output v-value-character
     1181                         , output v-value-date
     1182                         , output v-value-decimal
     1183                         , output v-value-integer
     1184                         , output v-value-logical
     1185                         , output v-param-type
     1186                         , input-output table-handle v-tth
     1187                         ) no-error .
     1188       if error-status :error
     1189       then do:
     1190         assign
     1191           v-bgelib-bgeflold  = "old":U
     1192         .
     1193       end.
     1194       else do:
     1195         assign
     1196           v-bgelib-bgeflold  = v-value-character
     1197         .
     1198       end.
     1199       delete object v-tth.
     1200   end.
     1201   end procedure.
     1202   procedure bgelib-check-file-size :
     1203   do
     1204   on error undo, return error
     1205   :
     1206   define input parameter p-out-filename   as character    no-undo.
     1207   define output parameter p-is-big        as logical      no-undo.
     1208       define variable v-current-position    as integer        no-undo.
     1209       assign
     1210           v-current-position = seek( stmXMLOut )
     1211       .
     1212       if v-current-position / 1024 / 1024  >= 100
     1213       then do:
     1214           assign
     1215               p-is-big = yes
     1216           .
     1217       end.
     1218   end.
     1219   end procedure.
     1220   procedure bgelib-init-ext-doc-type :
     1221       define variable v-counter    as integer      no-undo.
     1222       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1223   do
     1224   for buf_temp_ext-doc-type
     1225   on error undo, return error
     1226   :
     1227       empty temp-table buf_temp_ext-doc-type.
     1228       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1229       :
     1230           create buf_temp_ext-doc-type.
     1231           assign
     1232               buf_temp_ext-doc-type.edt-key               = v-counter
     1233               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1234               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1235           .
     1236       end.
     1237   end.
     1238   end procedure.
     1239   do
     1240   on error undo, return error
     1241   :
     1242       define variable v-counter       as inT      inIT 0      no-undo.
     1243       define variable v-xml-file-name     as character     no-undo.
     1244       define variable v-log-file-name     as character     no-undo.
     1245       define variable v-list-file-name    as character     no-undo.
     1246       define variable v-xml-file-number   as integer       no-undo.
     1247       define variable v-cancel            as logical       no-undo.
     1248       define variable v-parameter-list    as character     no-undo.
     1249       define buffer buf_gds-grp       for ub.gds-grp.
     1250       run bgelib-filename in this-procedure (
     1251             input "grp"
     1252           , output v-xml-file-name
     1253           , output v-log-file-name
     1254           , output v-list-file-name
     1255       ).
     1256       run gbl/waitfrsp.w (
     1257             input substring( v-xml-file-name, 1, 1 )
     1258           , input 200
     1259           , output v-cancel
     1260       ) .
     1261       if v-cancel = yes
     1262       then do:
     1263           undo, return error .
     1264       end.
     1265       run bgelib-write-log in this-procedure (
     1266             input v-log-file-name
     1267           , input 1
     1268           , input "&DLine"
     1269       ).
     1270       run bgelib-write-log in this-procedure (
     1271             input v-log-file-name
     1272           , input 1
     1273           , input substitute( "Начало выгрузки справочника групп товаров в файл &1"
     1274                                   , replace( v-xml-file-name, "/", "\" ) + "tmp"
     1275                             )
     1276       ).
     1277       if p-grp-amount = ?
     1278       or p-grp-code-list = ?
     1279       or ( p-grp-amount <> 0
     1280            and num-entries( p-grp-code-list ) = 0 )
     1281       then do:
     1282           run bgelib-write-log in this-procedure (
     1283                 input v-log-file-name
     1284               , input 1
     1285               , input "Неверно заданы входные параметры."
     1286           ).
     1287           undo, return error.
     1288       end.
     1289       assign
     1290           v-parameter-list         =  substitute( "&1,&2,&3,&4,&5,&6,&7,&8,&9"
     1291                                                  , 4
     1292                                                  , "docName"          , "gdsgrp":U
     1293                                                  , "version"          , replace("14.0 " + replace( vss-revision + vss-date, "$", " " ),',','')
     1294                                                  , "exportDate"       , string( today,          "99/99/9999" )
     1295                                                  , "exportTime"       , string( time,           "HH:MM:SS"   )
     1296                                                 )
     1297           v-xml-file-number       =   1
     1298       .
     1299       run bgelib-write-header in this-procedure (
     1300             input yes
     1301           , input v-xml-file-name
     1302           , input v-list-file-name
     1303           , input v-xml-file-number
     1304           , input no
     1305           , input ""
     1306           , input ""
     1307           , input ""
     1308           , input v-parameter-list
     1309       ).
     1310       if p-grp-amount = 0
     1311       then do:
     1312           for each buf_gds-grp no-lock
     1313           by buf_gds-grp.node-code
     1314           :
     1315               run export-group(
     1316                     input buf_gds-grp.node-code
     1317                   , input v-parameter-list
     1318                   , input v-xml-file-name
     1319                   , input v-log-file-name
     1320                   , input v-list-file-name
     1321                   , input v-xml-file-number
     1322                   , output v-xml-file-name
     1323                   , output v-xml-file-number
     1324               ).
     1325           end.
     1326       end.
     1327       else do:
     1328               do v-counter = 1 to ( num-entries( p-grp-code-list ) )
     1329               :
     1330                   run export-group(
     1331                         input integer( entry( v-counter, p-grp-code-list ) )
     1332                       , input v-parameter-list
     1333                       , input v-xml-file-name
     1334                       , input v-log-file-name
     1335                       , input v-list-file-name
     1336                       , input v-xml-file-number
     1337                       , output v-xml-file-name
     1338                       , output v-xml-file-number
     1339                   ).
     1340               end.
     1341       end.
     1342       run bgelib-write-footer in this-procedure (
     1343             input yes
     1344           , input v-xml-file-name
     1345           , input v-list-file-name
     1346           , input no
     1347           , input ""
     1348       ).
     1349       run bgelib-write-log in this-procedure (
     1350             input v-log-file-name
     1351           , input 1
     1352           , input substitute( "Данные выгружены в файл &1"
     1353                                   , replace( v-xml-file-name, "/", "\" ) + "xml"
     1354                             )
     1355       ).
     1356       run bgelib-write-log in this-procedure (
     1357             input v-log-file-name
     1358           , input 1
     1359           , input "&DLine"
     1360       ).
     1361   end.
     1362   procedure export-group:
     1363   do
     1364   on error undo, return error
     1365   :
     1366   define input parameter p-node-code    as integer no-undo.
     1367   define input parameter p-parameter-list         as character    no-undo.
     1368   define input parameter p-xml-file-name          as character    no-undo.
     1369   define input parameter p-log-file-name          as character    no-undo.
     1370   define input parameter p-list-file-name         as character    no-undo.
     1371   define input parameter p-xml-file-number        as integer      no-undo.
     1372   define output parameter p-last-xml-file-name    as character    no-undo.
     1373   define output parameter p-last-xml-file-number  as integer      no-undo.
     1374       define variable v-need-new-file as logical      no-undo.
     1375       define variable v-void-string   as character      no-undo.
     1376       define variable v-prev-filename as character      no-undo.
     1377       define buffer buf_gds-grp for ub.gds-grp.
     1378       assign
     1379           p-last-xml-file-name   = p-xml-file-name
     1380           p-last-xml-file-number = p-xml-file-number
     1381       .
     1382       run bgelib-check-file-size in this-procedure (
     1383             input p-xml-file-name + "tmp"
     1384           , output v-need-new-file
     1385       ).
     1386       if v-need-new-file = yes
     1387       then do:
     1388           assign
     1389               v-prev-filename = p-xml-file-name
     1390           .
     1391           run bgelib-filename in this-procedure (
     1392                 input "grp"
     1393               , output p-xml-file-name
     1394               , output v-void-string
     1395               , output v-void-string
     1396           ).
     1397           run bgelib-write-footer in this-procedure (
     1398                 input no
     1399               , input v-prev-filename
     1400               , input p-list-file-name
     1401               , input yes
     1402               , input p-xml-file-name + "xml":U
     1403           ).
     1404           run bgelib-write-log in this-procedure (
     1405                 input p-log-file-name
     1406               , input 1
     1407               , input substitute( "Данные выгружены в файл &1"
     1408                                       , replace( p-xml-file-name, "/", "\" ) + "xml"
     1409                               )
     1410           ).
     1411           assign
     1412               p-last-xml-file-number   = p-xml-file-number + 1
     1413               p-last-xml-file-name     = p-xml-file-name
     1414           .
     1415           run bgelib-write-header in this-procedure (
     1416                 input no
     1417               , input p-last-xml-file-name
     1418               , input p-list-file-name
     1419               , input p-last-xml-file-number
     1420               , input yes
     1421               , input v-prev-filename + "xml":U
     1422               , input ""
     1423               , input ""
     1424               , input p-parameter-list
     1425           ).
     1426           assign
     1427               v-need-new-file = no
     1428           .
     1429       end.
     1430       output stream stmxmlout to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1431       find first buf_gds-grp no-lock
     1432            where buf_gds-grp.node-code = p-node-code
     1433       .
     1434       run bgelib-tag-open in this-procedure ( input 2, input "grp", input "" ).
     1435       run bgelib-tag-put in this-procedure ( input 3, input "grpID"   , input string(buf_gds-grp.node-code)   , input 0 ).
     1436       run bgelib-tag-put in this-procedure ( input 3, input "upperID" , input buf_gds-grp.upper-code          , input 0 ).
     1437       run bgelib-tag-put in this-procedure ( input 3, input "name"    , input buf_gds-grp.node-name           , input 0 ).
     1438       run bgelib-tag-close in this-procedure ( input 2, input "grp" ).
     1439       output stream stmxmlout close.
     1440   end.
     1441   end procedure.
