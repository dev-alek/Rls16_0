        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle  as handle           no-undo.
        3   define input parameter p-date-from      as date       no-undo.
        4   define input parameter p-date-to        as date       no-undo.
        5   define input parameter p-range          as integer    no-undo.
        6   define input parameter p-obj-list       as character  no-undo.
        7   define input parameter hEDT             AS HANDLE NO-UNDO.
        8   define input parameter hCNT             AS HANDLE NO-UNDO.
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: bge-card.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: bge/bge-card.p $":U .
       14   define variable vss-description as character no-undo init "Экспорт данных продаж по дисконтным картам".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define variable vss-include-info0 as character format "X(65)" no-undo
       76   initial "@(#)$Workfile$ $Revision$".
       77   DEF STREAM stmXMLOut.
       78   DEF STREAM stmXMLLog.
       79   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   procedure cur-time :
       81      define output parameter p-today as date      no-undo .
       82      define output parameter p-time  as integer   no-undo .
       83     do
       84     on error undo, return error
       85     :
       86       define variable v-date1 as date      no-undo .
       87       define variable v-date2 as date      no-undo .
       88       define variable v-time  as integer   no-undo .
       89       assign
       90         v-date1 = today
       91         v-time  = time
       92         v-date2 = today
       93       .
       94       if v-date1 <> v-date2
       95       then do:
       96         assign
       97           v-date1 = today
       98           v-time  = v-time
       99         .
      100       end.
      101       assign
      102         p-today = v-date1
      103         p-time  = v-time
      104       .
      105     end.
      106   end.
      107   function cur-time-date returns character
      108   :
      109     return string(today, '99/99/9999':U) .
      110   end.
      111   function cur-time-mjd returns decimal
      112   :
      113     define variable v-date as date      no-undo .
      114     define variable v-time as integer   no-undo .
      115     run cur-time in this-procedure
      116       (output v-date
      117       ,output v-time
      118       ) .
      119     return integer(v-date) - 2400002 + (v-time / 86400) .
      120   end.
      121   function cur-time-get-ending-index returns integer
      122   (input p-number as integer
      123   )
      124   :
      125     if p-number < 0
      126     or p-number = ?
      127     then do:
      128       return 1 .
      129     end.
      130     define variable v-rest as integer   no-undo .
      131     assign
      132       p-number = p-number modulo 100
      133     .
      134     if p-number < 20
      135     then do:
      136       assign
      137         v-rest = p-number
      138       .
      139     end.
      140     else do:
      141       assign
      142         v-rest = p-number modulo 10
      143       .
      144     end.
      145     case v-rest :
      146       when 1
      147       then do:
      148         return 2 .
      149       end.
      150       when 2 or
      151       when 3 or
      152       when 4
      153       then do:
      154         return 3 .
      155       end.
      156       otherwise do:
      157         return 1 .
      158       end.
      159     end case .
      160   end.
      161   procedure cur-time-mjd-to-date :
      162      define input  parameter i-mjd-diff as decimal no-undo.
      163      define output parameter o-Date     as date    no-undo.
      164      define output parameter o-Time     as integer no-undo.
      165      define variable v-day-number as integer   no-undo .
      166      if    i-mjd-diff < 0
      167         or i-mjd-diff = ?
      168      then do:
      169         return "?" .
      170      end.
      171      assign
      172         v-day-number = truncate(i-mjd-diff,0).
      173         o-Date = date(v-day-number + 2400002).
      174         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      175     .
      176   end.
      177   function cur-time-mjd-to-string returns character
      178   (input p-mjd-diff as decimal
      179   )
      180   :
      181     define variable v-day-number as integer   no-undo .
      182     define variable v-seconds    as integer   no-undo .
      183     define variable v-hour       as integer   no-undo .
      184     define variable v-min        as integer   no-undo .
      185     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      186     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      187     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      188     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      189     if p-mjd-diff < 0
      190     or p-mjd-diff = ?
      191     then do:
      192       return "?" .
      193     end.
      194     assign
      195       v-day-number = integer(truncate(p-mjd-diff,0))
      196       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      197     .
      198     if v-seconds > 86400
      199     then do:
      200       assign
      201         v-seconds = 86400 - 1
      202       .
      203     end.
      204     if v-seconds < 0
      205     then do:
      206       assign
      207         v-seconds = 0
      208       .
      209     end.
      210     assign
      211       v-hour = truncate(v-seconds / 3600, 0)
      212     .
      213     assign
      214       v-seconds = v-seconds modulo 3600
      215     .
      216     assign
      217       v-min = truncate(v-seconds / 60, 0)
      218     .
      219     assign
      220       v-seconds = v-seconds modulo 60
      221     .
      222     return
      223         (if v-day-number <> 0
      224           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      225           else ""
      226         )
      227       + (if v-day-number <> 0 or v-hour <> 0
      228           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      229           else ""
      230         )
      231       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      232           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      233           else ""
      234         )
      235       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      236       .
      237   end.
      238   function cur-time-string returns character
      239   :
      240     define variable v-date as date      no-undo .
      241     define variable v-time as integer   no-undo .
      242     run cur-time in this-procedure
      243       (output v-date
      244       ,output v-time
      245       ) .
      246     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      247   end.
      248   function cur-time-string-sec returns character
      249   :
      250     define variable v-date as date      no-undo .
      251     define variable v-time as integer   no-undo .
      252     run cur-time in this-procedure
      253       (output v-date
      254       ,output v-time
      255       ) .
      256     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      257   end.
      258   function cur-time-custom  returns character
      259   (input p-prefix as character
      260   ,input p-date-format as character
      261   ,input p-delimiter as character
      262   ,input p-time-format as character
      263   ,input p-suffix as character
      264   )
      265   :
      266     define variable v-date as date      no-undo .
      267     define variable v-time as integer   no-undo .
      268     run cur-time in this-procedure
      269       (output v-date
      270       ,output v-time
      271       ) .
      272     return
      273       p-prefix
      274       + string(v-date, p-date-format)
      275       + p-delimiter
      276       + string(v-time, p-time-format)
      277       + p-suffix
      278       .
      279   end.
      280   function cur-time-print  returns character
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      289   end.
      290   function cur-time-datetime returns datetime
      291   :
      292     define variable v-char as character no-undo .
      293     define variable v-datetime as datetime no-undo .
      294     v-char = cur-time-string().
      295     v-datetime = datetime(v-char).
      296     return  v-datetime.
      297   end.
      298   function cur-time-string-msec returns character
      299   :
      300     define variable v-date as datetime  no-undo .
      301     v-date = now.
      302     return string(v-date) .
      303   end.
      304   define variable vss-include-info2 as character format "X(65)" no-undo
      305   initial "@(#)$Workfile$ $Revision$".
      306   procedure xmlchar-test :
      307   define input parameter p-in-string          as character        no-undo.
      308   define output parameter p-out-string-enc    as character        no-undo.
      309   define output parameter p-out-string-dec    as character        no-undo.
      310   do
      311   on error undo, return error
      312   :
      313          run xmlchar-encode in this-procedure
      314       (
      315             input p-in-string
      316           , output p-out-string-enc
      317       ).
      318          run xmlchar-decode in this-procedure
      319       (
      320             input p-out-string-enc
      321           , output p-out-string-dec
      322       ).
      323   end.
      324   end .
      325   procedure xmlchar-encode :
      326   define input parameter p-in-string      as character        no-undo.
      327   define output parameter p-out-string    as character        no-undo.
      328       define variable v-position      as integer      no-undo.
      329       define variable v-current-char  as character    no-undo.
      330   do
      331   on error undo, return error
      332   :
      333       assign
      334           p-out-string = "":U
      335       .
      336       case p-in-string
      337       :
      338           when ?
      339           then do:
      340               assign
      341                   p-out-string = "?":U
      342               .
      343           end.
      344           when "?":U
      345           then do:
      346               assign
      347                   p-out-string = "&#63;":U
      348               .
      349           end.
      350           otherwise do:
      351               do v-position = 1 to length( p-in-string )
      352               :
      353                   assign
      354                       v-current-char = substring( p-in-string, v-position, 1 )
      355                   .
      356                   case v-current-char
      357                   :
      358                       when "&":U
      359                       then do:
      360                           assign
      361                               p-out-string = p-out-string + "&amp;":U
      362                           .
      363                       end.
      364                       when ">":U
      365                       then do:
      366                           assign
      367                               p-out-string = p-out-string + "&gt;":U
      368                           .
      369                       end.
      370                       when "<":U
      371                       then do:
      372                           assign
      373                               p-out-string = p-out-string + "&lt;":U
      374                           .
      375                       end.
      376                       when "'":U
      377                       then do:
      378                           assign
      379                               p-out-string = p-out-string + "&apos;":U
      380                           .
      381                       end.
      382                       when '"':U
      383                       then do:
      384                           assign
      385                               p-out-string = p-out-string + "&quot;":U
      386                           .
      387                       end.
      388                       when chr(1)
      389                       then do:
      390                           assign
      391                               p-out-string = p-out-string + "":U
      392                           .
      393                       end.
      394                       when chr(2)
      395                       then do:
      396                           assign
      397                               p-out-string = p-out-string + "":U
      398                           .
      399                       end.
      400                       when chr(3)
      401                       then do:
      402                           assign
      403                               p-out-string = p-out-string + "":U
      404                           .
      405                       end.
      406                       when chr(4)
      407                       then do:
      408                           assign
      409                               p-out-string = p-out-string + "":U
      410                           .
      411                       end.
      412                       when chr(5)
      413                       then do:
      414                           assign
      415                               p-out-string = p-out-string + "":U
      416                           .
      417                       end.
      418                       when chr(6)
      419                       then do:
      420                           assign
      421                               p-out-string = p-out-string + "":U
      422                           .
      423                       end.
      424                       when chr(7)
      425                       then do:
      426                           assign
      427                               p-out-string = p-out-string + "":U
      428                           .
      429                       end.
      430                       when chr(8)
      431                       then do:
      432                           assign
      433                               p-out-string = p-out-string + "":U
      434                           .
      435                       end.
      436                       when chr(9)
      437                       then do:
      438                           assign
      439                               p-out-string = p-out-string + "":U
      440                           .
      441                       end.
      442                       when chr(29)
      443                       then do:
      444                           assign
      445                               p-out-string = p-out-string + "":U
      446                           .
      447                       end.
      448                       when chr(10)
      449                       then do:
      450                           assign
      451                               p-out-string = p-out-string + "&#10;":U
      452                           .
      453                       end.
      454                       when chr(13)
      455                       then do:
      456                           assign
      457                               p-out-string = p-out-string + "&#13;":U
      458                           .
      459                       end.
      460                       otherwise do:
      461                           assign
      462                               p-out-string = p-out-string + v-current-char
      463                           .
      464                       end.
      465                   end case.
      466               end.
      467           end.
      468       end case.
      469   end.
      470   end .
      471   procedure xmlchar-encode-1c :
      472   define input parameter p-in-string      as character        no-undo.
      473   define output parameter p-out-string    as character        no-undo.
      474       define variable v-position      as integer      no-undo.
      475       define variable v-current-char  as character    no-undo.
      476   do
      477   on error undo, return error
      478   :
      479       assign
      480           p-out-string = "":U
      481       .
      482       case p-in-string
      483       :
      484           when ?
      485           then do:
      486               assign
      487                   p-out-string = "?":U
      488               .
