      517                       then do:
      518                           assign
      519                               p-out-string = p-out-string + " ":U
      520                           .
      521                       end.
      522                       when chr(5)
      523                       then do:
      524                           assign
      525                               p-out-string = p-out-string + " ":U
      526                           .
      527                       end.
      528                       when chr(6)
      529                       then do:
      530                           assign
      531                               p-out-string = p-out-string + " ":U
      532                           .
      533                       end.
      534                       when chr(7)
      535                       then do:
      536                           assign
      537                               p-out-string = p-out-string + " ":U
      538                           .
      539                       end.
      540                       when chr(8)
      541                       then do:
      542                           assign
      543                               p-out-string = p-out-string + " ":U
      544                           .
      545                       end.
      546                       when chr(9)
      547                       then do:
