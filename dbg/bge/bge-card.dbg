      581   procedure xmlchar-decode :
      582   define input parameter p-in-string      as character        no-undo.
      583   define output parameter p-out-string    as character        no-undo.
      584       define variable v-position      as integer      no-undo.
      585       define variable v-last-position as integer      no-undo.
      586       define variable v-temp-integer  as integer      no-undo.
      587       define variable v-current-char  as character    no-undo.
      588       define variable v-next-char     as character    no-undo.
      589       define variable v-success       as logical      no-undo.
      590   do
      591   on error undo, return error
      592   :
      593       assign
      594           p-out-string = "":U
      595           v-position   = 0
      596       .
      597       replace-cycle:
      598       do while yes
      599       on error undo, return error
      600       :
      601           assign
      602               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      603           .
      604           if v-last-position <= v-position
      605           then do:
      606               if v-position = 0
      607               then do:
      608                   assign
      609                       p-out-string = p-in-string
      610                   .
      611               end.
      612               else do:
      613                   assign
      614                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      615                   .
      616               end.
      617               leave replace-cycle.
      618           end.
      619           else do:
      620               assign
      621                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      622                   v-position      = v-last-position
      623                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      624               .
      625               if v-current-char = "#":U
      626               then do:
      627                   assign
      628                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      629                   .
      630                   if v-last-position > 0
      631                   then do:
      632                       run xmlchar-read-integer in this-procedure
      633                        (
      634                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      635                           , output v-temp-integer
      636                           , output v-success
      637                       ).
      638                       if v-success = yes
      639                       and v-temp-integer >= 1
      640                       and v-temp-integer <= 255
      641                       then do:
      642                           assign
      643                               p-out-string = p-out-string + chr( v-temp-integer )
      644                               v-position   = v-last-position + 1
      645                           .
      646                       end.
      647                       else do:
      648                           assign
      649                               p-out-string = p-out-string + "&":U
      650                               v-position   = v-position   + 1
      651                           .
      652                       end.
      653                   end.
      654                   else do:
      655                       assign
      656                           p-out-string = p-out-string + "&":U
      657                           v-position   = v-position   + 1
      658                       .
      659                   end.
      660               end.
      661               else do:
      662                   case substring( p-in-string, v-position + 1, 3 )
      663                   :
      664                       when "lt;":U
      665                       then do:
      666                           assign
      667                               p-out-string = p-out-string + "<":U
      668                               v-position   = v-position   + 3
      669                           .
      670                       end.
      671                       when "gt;":U
      672                       then do:
      673                           assign
      674                               p-out-string = p-out-string + ">":U
      675                               v-position   = v-position   + 3
      676                           .
      677                       end.
      678                       otherwise do:
      679                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      680                           then do:
      681                               assign
      682                                   p-out-string = p-out-string + "&":U
      683                                   v-position   = v-position   + 4
      684                               .
      685                           end.
      686                           else do:
      687                               case substring( p-in-string, v-position + 1, 5 )
      688                               :
      689                                   when "quot;":U
      690                                   then do:
      691                                       assign
      692                                           p-out-string = p-out-string + '"':U
      693                                           v-position   = v-position   + 5
      694                                       .
      695                                   end.
      696                                   when "apos;":U
      697                                   then do:
      698                                       assign
      699                                           p-out-string = p-out-string + "'":U
      700                                           v-position   = v-position   + 5
      701                                       .
      702                                   end.
      703                                   otherwise do:
      704                                       assign
      705                                           p-out-string = p-out-string + "&":U
      706                                       .
      707                                   end.
      708                               end case.
      709                           end.
      710                       end.
      711                   end case.
      712               end.
      713           end.
      714       end.
      715   end.
      716   end .
      717   procedure xmlchar-read-integer :
      718   define input parameter p-input-string      as character        no-undo.
      719   define output parameter p-output-integer   as integer          no-undo.
      720   define output parameter p-success       as logical          no-undo.
      721   do
      722   on error undo, return error
      723   :
      724       assign
      725           p-output-integer = integer( p-input-string )
      726       no-error.
      727       if error-status :error
      728       then do:
      729           assign
      730               p-success           = no
      731               p-output-integer    = 0
      732           .
      733       end.
      734       else do:
      735           assign
      736               p-success           = yes
      737           .
      738       end.
      739   end.
      740   end.
      741   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      742   procedure strtdate :
      743     define input  parameter p-str         as character no-undo .
      744     define output parameter p-value       as date      no-undo .
      745     define output parameter p-data-valid  as logical   no-undo .
      746     define output parameter p-message     as character no-undo .
      747   do
      748   on error undo, return error return-value
      749   :
      750     define variable v-value       as date      no-undo .
      751     define variable v-i           as integer   no-undo .
      752     define variable v-num         as integer   no-undo .
      753     define variable v-delim       as character no-undo .
      754     define variable v-delim-list  as character no-undo .
      755     define variable v-day         as integer   no-undo .
      756     define variable v-month       as integer   no-undo .
      757     define variable v-year        as integer   no-undo .
      758     define variable v-day-str     as character no-undo .
      759     define variable v-month-str   as character no-undo .
      760     define variable v-year-str    as character no-undo .
      761     assign
      762       p-value       = ?
      763       p-data-valid  = false
      764     .
      765     if p-str = ?
      766     then do:
      767       assign
      768         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      769       .
      770       return .
      771     end.
      772     if p-str = ""
      773     then do:
      774       assign
      775         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      776       .
      777       return .
      778     end.
      779     if length(p-str)  > 10
      780     then do:
      781       assign
      782         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      783       .
      784       return .
      785     end.
      786     assign
      787       v-delim-list = '/,-,.':U
      788     .
      789     _delim:
      790     do v-i = 1 to num-entries( v-delim-list )
      791     :
      792       assign
      793         v-delim = entry( v-i , v-delim-list )
      794         v-num   = num-entries( p-str , v-delim )
      795       .
      796       if v-num <> 3
      797       then do:
      798         assign
      799           v-delim = ''
      800         .
      801       end.
      802       else do:
      803         leave _delim.
      804       end.
      805     end.
      806     if v-delim = ''
      807     then do:
      808       assign
      809         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      810       .
      811       return .
      812     end.
      813     assign
      814       v-day-str   = entry( 1, p-str , v-delim)
      815       v-month-str = entry( 2, p-str , v-delim)
      816       v-year-str  = entry( 3, p-str , v-delim)
      817     .
      818     if  length(v-day-str) > 2   or
      819         length(v-day-str) < 1   or
      820         length(v-month-str) > 2 or
      821         length(v-month-str) < 1 or
      822         (
      823           length(v-year-str) <> 2 and
      824           length(v-year-str) <> 4
      825         )
      826     then do:
      827       assign
      828         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      829       .
      830       return .
      831     end.
      832     if length( v-year-str ) = 2
      833     then do:
      834       assign
      835         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      836       .
      837     end.
      838     assign
      839       v-day   = integer( v-day-str )
      840       v-month = integer( v-month-str)
      841       v-year  = integer( v-year-str)
      842     no-error .
      843     if error-status :error
      844     then do:
      845       assign
      846         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      847       .
      848       return .
      849     end.
      850     if v-day < 1  or
      851        v-day > 31 or
      852        v-month < 1 or
      853        v-month > 12 or
      854        v-year < 0   or
      855        v-year > 5000
      856     then do:
      857       assign
      858         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      859       .
      860       return .
      861     end.
      862     assign
      863       v-value = date( v-month, v-day, v-year )
      864     no-error .
      865     if error-status :error
      866     then do:
      867       assign
      868         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      869       .
      870       return .
      871     end.
      872     assign
      873       p-value       = v-value
      874       p-data-valid  = true
      875     .
      876   end.
      877   end procedure.
