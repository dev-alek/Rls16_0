      978   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
      979                                             INPUT iFlagEmpty AS INTEGER).
      980       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
      981       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
      982           DO:
      983               IF iFlagEmpty = 0                           THEN RETURN "".
      984               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
      985               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
      986               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
      987               ELSE RETURN "".
      988           END.
      989       ELSE DO:
      990           run xmlchar-encode in this-procedure (
      991                 input sToPlace
      992               , output sToPlace
      993           ).
      994           ASSIGN
      995               sToPlace = sParName + '="' + sToPlace + '"'
      996           .
      997           RETURN sToPlace.
      998       END.
      999   END FUNCTION.
     1000   function bge-xml-date returns character
     1001   ( input p-date as date )
     1002   :
     1003     define variable v-date-str as character no-undo .
     1004     run bge-xml-date-to-str in this-procedure ( input   p-date
     1005                                               , output  v-date-str
     1006                                               ) .
     1007     return v-date-str.
     1008   end function.
     1009   function bge-xml-str-date returns character
     1010   ( input p-date-str as character )
     1011   :
     1012     define variable v-date-str as character no-undo .
     1013     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1014                                                   , output  v-date-str
     1015                                                   ) .
     1016     return v-date-str.
     1017   end function.
     1018   function bge-xml-normalize-dec returns decimal
     1019   ( input p-val as decimal )
     1020   :
     1021     return (if p-val = ? then 0 else p-val) .
     1022   end function.
     1023   PROCEDURE wp-XMLTagOpen:
     1024   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1025   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1026   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1027       define variable v-out-string    as character    no-undo.
     1028   do
     1029   on error undo, return error
     1030   :
     1031       if v-bge-xml-bgefmt = "dbf":U
     1032       then do:
     1033       end.
     1034       else do:
     1035           assign
     1036               v-out-string = substitute( "&1&2<&3&4>"
     1037                                       , chr(10)
     1038                                       , fill( " ":U, 4 * iTagLevel)
     1039                                       , sTagName
     1040                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1041                               )
     1042           .
     1043           put stream stmXMLOut unformatted
     1044               v-out-string
     1045           .
     1046       end.
     1047   end.
     1048   END PROCEDURE.
     1049   PROCEDURE wp-XMLTagPut:
     1050     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1051     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1052     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1053     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1054       define variable v-out-string    as character    no-undo.
     1055   do
     1056   on error undo, return error
     1057   :
     1058       if v-bge-xml-bgefmt = "dbf":U
     1059       then do:
     1060           if v-bge-xml-dbf-file-name <> "":U
     1061           then do:
     1062               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1063               export stream stmXMLOut
     1064                   sTagName
     1065                   sParValue
     1066               .
     1067               output stream stmXMLOut close.
     1068           end.
     1069       end.
     1070       else do:
     1071           IF  iFlagEmpty = 1
     1072           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1073           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1074           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1075           THEN DO:
     1076               run xmlchar-encode in this-procedure (
     1077                   input sParValue
     1078                   , output sParValue
     1079               ).
     1080               assign
     1081                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1082                                               , chr(10)
     1083                                               , FILL(" ", 4 * iTagLevel)
     1084                                               , sTagName
     1085                                               , sParValue
     1086                               )
     1087               .
     1088               PUT STREAM stmXMLOut UNFORMATTED
     1089                   v-out-string
     1090               .
     1091           END.
     1092       end.
     1093   end.
     1094   END PROCEDURE.
     1095   PROCEDURE wp-XMLTagClose:
     1096   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1097   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1098       define variable v-out-string    as character    no-undo.
     1099   do
     1100   on error undo, return error
     1101   :
     1102       if v-bge-xml-bgefmt = "dbf":U
     1103       then do:
     1104       end.
     1105       else do:
     1106           assign
     1107               v-out-string = substitute( "&1&2</&3>"
     1108                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1109                                   , fill( " ", 4 * iTagLevel )
     1110                                   , sTagName
     1111                           )
     1112           .
     1113           PUT STREAM stmXMLOut UNFORMATTED
     1114               v-out-string
     1115           .
     1116       end.
     1117   end.
     1118   END PROCEDURE.
     1119   PROCEDURE wp-XMLWriteLog:
     1120     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1121     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1122     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1123   define variable v-str              as character no-undo .
     1124   define variable v-error-append     as logical   no-undo .
     1125   define variable v-error-append-msg as character no-undo .
     1126   assign
     1127     v-str = chr(10)
     1128             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1129             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1130     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1131     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1132     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1133   .
     1134   run bge/bge-log.p (input v-str) no-error .
     1135   if error-status:error then do:
     1136     assign
     1137       v-error-append     = yes
     1138       v-error-append-msg = return-value
     1139     .
     1140   end.
     1141   run gbl/fileapnd.p
     1142     ( input sFileName
     1143     , input v-str
     1144     , input 10
     1145     ) no-error .
     1146   if error-status:error then do:
     1147     assign
     1148       v-error-append     = yes
     1149       v-error-append-msg = substitute( "&1&2&3"
     1150                                       , v-error-append-msg
     1151                                       , chr(10)
     1152                                       , return-value
     1153                                       )
     1154     .
     1155   end.
     1156   if v-error-append
     1157   then do:
     1158     return error substitute( "&1" , v-error-append-msg ) .
     1159   end.
     1160   END PROCEDURE.
     1161   PROCEDURE wp-XMLWriteEDT:
     1162     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1163     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1164     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1165       if valid-handle ( hEDT )
     1166       then do:
     1167           hEDT :move-to-eof().
     1168           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1169                                           OR sToWrite = "&Line") THEN "" ELSE
     1170                                           cur-time-string-sec() + " ").
     1171           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1172                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1173                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1174           hEDT :insert-string(chr(10)).
     1175       end.
     1176       process events.
     1177       output to 'bgescn.txt' append.
     1178           put unformatted
     1179               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1180                                           OR sToWrite = "&Line") THEN "" ELSE
     1181                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1182               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1183                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1184                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1185           .
     1186       output close.
     1187   END PROCEDURE.
     1188   PROCEDURE wp-XMLShowCNT:
     1189     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1190       if valid-handle( hCNT )
     1191       then do:
     1192           ASSIGN hCNT :VISIBLE = TRUE.
     1193       end.
     1194   END PROCEDURE.
     1195   PROCEDURE wp-XMLHideCNT:
     1196     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1197       if valid-handle( hCNT )
     1198       then do:
     1199           ASSIGN hCNT :VISIBLE = FALSE.
     1200       end.
     1201   END PROCEDURE.
     1202   PROCEDURE wp-XMLWriteCNT:
     1203     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1204     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1205       if valid-handle( hCNT )
     1206       then do:
     1207           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1208       end.
     1209   END PROCEDURE.
     1210   procedure bge-xml-write-header:
     1211   do
     1212   on error undo, return error
     1213   :
     1214   define input parameter p-xml-file-name  as character        no-undo.
     1215   define input parameter p-doc-name       as character        no-undo.
     1216   define input parameter p-version        as character        no-undo.
     1217   define input parameter p-db-num         as integer          no-undo.
     1218   define input parameter p-date-from      as date             no-undo.
     1219   define input parameter p-shift-num-from as integer          no-undo.
     1220   define input parameter p-date-to        as date             no-undo.
     1221   define input parameter p-shift-num-to   as integer          no-undo.
     1222   define input parameter p-obj-list       as character        no-undo.
     1223   define input parameter p-doc-type-list  as character        no-undo.
     1224   define input parameter p-pay-code       as logical          no-undo.
     1225   define input parameter p-cst            as logical          no-undo.
     1226   define input parameter p-parts          as logical          no-undo.
     1227   define input parameter p-chk-pay-code   as logical          no-undo.
     1228   define input parameter p-pay-desk       as logical          no-undo.
     1229   define input parameter p-pay-desk-cards as logical          no-undo.
     1230   define input parameter p-deleted        as logical          no-undo.
     1231   define input parameter p-opened-docs    as logical          no-undo.
     1232   define variable v-out-string    as character    no-undo.
     1233   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1234   assign
     1235       v-out-string = substitute( "&1&2&3"
     1236                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1237                           , chr(10)
     1238                           , "<IBS_Trade_House>":U )
     1239   .
     1240   put stream stmXMLOut unformatted
     1241       v-out-string
     1242   .
     1243   run wp-XMLTagOpen(1, "header","").
     1244   if v-bge-xml-bgeflold = "oracle":u
     1245   then do:
     1246     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1247     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1248     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1249     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1250     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1251   end.
     1252   run wp-XMLTagOpen( 2, "manifest", "").
     1253   run wp-XMLTagOpen( 3, "document", "").
     1254   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1255   run wp-XMLTagput( 4, "description", "", 0).
     1256   run wp-XMLTagput( 4, "version", p-version, 0).
     1257   run wp-XMLTagclose( 3, "document" ).
     1258   run wp-XMLTagclose( 2, "manifest" ).
     1259   run wp-XMLTagclose( 1, "header" ).
     1260   run wp-XMLTagOpen(1, "options","").
     1261   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1262   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1263   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1264   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1265   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1266   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1267   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1268   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1269   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1270   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1271   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1272   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1273   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1274   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1275   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1276   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1277   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1278   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1279   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1280   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1281   run wp-XMLTagClose(1, "options").
     1282   run wp-XMLTagOpen( 1, "body", "" ).
     1283   output stream stmXMLOut close.
     1284   end.
     1285   end procedure.
     1286   procedure xml-bge-write-footer:
     1287   do
     1288   on error undo, return error return-value
     1289   :
     1290   define input parameter p-xml-file-name as character    no-undo.
     1291   define variable v-error-num     as integer           no-undo.
     1292   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1293   run wp-XMLTagClose( 1, "body" ).
     1294   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1295   output stream stmXMLOut close.
     1296   if v-bge-xml-bgeflold = "oracle":u
     1297   then do:
     1298     define variable v-tmp-file-name         as character no-undo .
     1299     define variable v-zip-file-name         as character no-undo .
     1300     define variable v-exch-file-name        as character no-undo .
     1301     define variable v-heap-file-name        as character no-undo .
     1302     define variable v-i                     as integer   no-undo .
     1303     define variable v-file-name             as character no-undo .
     1304     define variable v-arc                   as character no-undo .
     1305     define variable v-str                   as character no-undo .
     1306     define variable v-exch-tmp-file-name    as character no-undo .
     1307     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1308     define variable v-bge-xml-exch-dir      as character no-undo .
     1309     define variable v-bge-xml-heap-dir      as character no-undo .
     1310     define variable v-bge-xml-compress-heap as logical   no-undo .
     1311     define variable v-home-dir              as character no-undo .
     1312     define variable v-os-command            as character no-undo .
     1313     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1314     if v-home-dir = ?
     1315     then do:
     1316       undo, return error substitute( "&1&2&3"
     1317                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1318                                     , chr(10)
     1319                                     , "Обратитесь к администратору.":u
     1320                                     ).
     1321     end.
     1322     assign
     1323       v-home-dir = v-home-dir
     1324     .
     1325     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1326     if error-status :error
     1327     then do:
     1328       undo, return error substitute( "&1&2&3"
     1329                                     , "Неверно задан каталог экспорта.":u
     1330                                     , chr(10)
     1331                                     , "Обратитесь к администратору.":u
     1332                                     ).
     1333     end.
     1334     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1335     if v-bge-xml-exch-dir = ?
     1336     then do:
     1337       undo, return error substitute( "&1&2&3"
     1338                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1339                                     , chr(10)
     1340                                     , "Обратитесь к администратору.":u
     1341                                     ).
     1342     end.
     1343     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1344     if error-status :error
     1345     then do:
     1346       undo, return error substitute( "&1&2&3"
     1347                                     , "Неверно задан каталог экспорта (exch).":u
     1348                                     , chr(10)
     1349                                     , "Обратитесь к администратору.":u
     1350                                     ).
     1351     end.
     1352     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1353     if v-bge-xml-heap-dir = ?
     1354     then do:
     1355       undo, return error substitute( "&1&2&3"
     1356                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1357                                     , chr(10)
     1358                                     , "Обратитесь к администратору.":u
     1359                                     ).
     1360     end.
     1361     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1362     if error-status :error
     1363     then do:
     1364       undo, return error substitute( "&1&2&3"
     1365                                     , "Неверно задан каталог экспорта (heap).":u
     1366                                     , chr(10)
     1367                                     , "Обратитесь к администратору.":u
     1368                                     ).
     1369     end.
     1370     get-key-value section "BGE" key "heap-compress" value v-str.
     1371     assign
     1372       v-i = int(v-str)
     1373     no-error .
     1374     if v-i = ? or v-i = 0
     1375     then do:
     1376       assign
     1377         v-bge-xml-compress-heap = no
     1378       .
     1379     end.
     1380     else do:
     1381       assign
     1382         v-bge-xml-compress-heap = yes
     1383       .
     1384     end.
     1385     assign
     1386       v-arc = search( "exe/7za.exe":u )
     1387     .
     1388     if v-arc = ? or v-arc = ""
     1389     then do:
     1390       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1391     end.
     1392     assign
     1393       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1394       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1395       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1396       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1397       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1398       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1399       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1400     .
     1401     run gbl/del-file.p (input v-tmp-file-name) .
     1402     run gbl/del-file.p (input v-zip-file-name) .
     1403     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1404     if v-error-num > 0
     1405     then do:
     1406         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1407                                      , p-xml-file-name + "xm1":u
     1408                                      , v-tmp-file-name
     1409                                      , v-error-num
     1410                                      ).
     1411     end.
     1412     assign
     1413       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1414                                    , v-arc
     1415                                    , v-zip-file-name
     1416                                    , v-tmp-file-name
     1417                                    )
     1418     .
     1419     os-command silent value ( v-os-command ) .
     1420     run gbl/del-file.p (input v-heap-file-name) .
     1421     if v-bge-xml-compress-heap = no
     1422     then do:
     1423       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1424       if v-error-num > 0
     1425       then do:
     1426           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1427                                        , v-tmp-file-name
     1428                                        , v-heap-file-name
     1429                                        , v-error-num
     1430                                        ) .
     1431       end.
     1432     end.
     1433     else do:
     1434       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1435       if v-error-num > 0
     1436       then do:
     1437           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1438                                        , v-zip-file-name
     1439                                        , v-heap-file-name
     1440                                        , v-error-num
     1441                                        ) .
     1442       end.
     1443     end.
     1444     run gbl/del-file.p (input v-tmp-file-name) .
     1445     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1446     if error-status :error then do:
     1447       undo, return error substitute( "&1&2&3"
     1448                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1449                                     , chr(10)
     1450                                     , "Обратитесь к администратору."
     1451                                     ).
     1452     end.
     1453     run gbl/del-file.p (input v-exch-file-name) .
     1454     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1455     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1456     if v-error-num > 0
     1457     then do:
     1458       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1459                                     , v-zip-file-name
     1460                                     , v-exch-tmp-file-name
     1461                                     , v-error-num
     1462                                     ) .
     1463     end.
     1464     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1465     if v-error-num > 0
     1466     then do:
     1467       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1468                                     , v-exch-tmp-file-name
     1469                                     , v-exch-file-name
     1470                                     , v-error-num
     1471                                     ) .
     1472     end.
     1473     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1474   end.
     1475   else do:
     1476     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1477     if v-error-num > 0
     1478     then do:
     1479       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1480                                     , p-xml-file-name + "xm1"
     1481                                     , p-xml-file-name + "xml"
     1482                                     , v-error-num
     1483                                     ) .
     1484     end.
     1485   end.
     1486   if opsys = "unix"
     1487   then do:
     1488       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1489   end.
     1490   end.
     1491   end procedure.
     1492   procedure xml-bge-filename0:
     1493   define input parameter p-prefix   as character no-undo .
     1494   define input parameter p-name     as character no-undo .
     1495   define input parameter p-shared-process as logical no-undo .
     1496   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1497   define output parameter p-xml-file-name  as character no-undo .
     1498   // define output parameter p-fullfnamenoext as character no-undo .
     1499   define output parameter p-locked         as logical      no-undo.
     1500   define variable v-fullfnamenoext as character no-undo .
     1501   define variable v-fileext        as character no-undo .
     1502   define variable v-fullfname      as character no-undo .
     1503   define variable v-error-num      as integer   no-undo .
     1504   do
     1505   on error undo, return error
     1506   :
     1507     case v-bge-xml-bgeflold :
     1508       when "old" then do:
     1509         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1510         v-fileext       = ".xml":U .
     1511         v-fullfname     = v-fullfnamenoext + v-fileext .
     1512         p-xml-file-name = v-fullfname .
     1513         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1514         if v-error-num > 0 then do:
     1515           return error.
     1516         end.
     1517       end.
     1518       when "var" then do:
     1519         case p-prefix :
     1520           when "doc" then do:
     1521             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1522             v-fileext       = ".xml":U .
     1523             v-fullfname     = v-fullfnamenoext + v-fileext .
     1524             p-xml-file-name = v-fullfname .
     1525           end.
     1526           when "day" then do:
     1527             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1528             v-fileext       = ".xml":U .
     1529             v-fullfname     = v-fullfnamenoext + v-fileext .
     1530             p-xml-file-name = v-fullfname .
     1531           end.
     1532           otherwise do:
     1533             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1534             v-fileext       = ".xml":U .
     1535             v-fullfname     = v-fullfnamenoext + v-fileext .
     1536             p-xml-file-name = v-fullfname .
     1537           end.
     1538         end case.
     1539         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1540         if v-error-num > 0 then do:
     1541           return error.
     1542         end.
     1543       end.
     1544       when "new" then do:
     1545                   run bge/genfname.p (
     1546                       input p-home-dir
     1547                       , input p-prefix
     1548                       , input ""
     1549                       , input "xml"
     1550                       , input ""
     1551                       , output p-xml-file-name
     1552                   ).
     1553       end.
     1554       when "no-parameter" then do:
     1555         if p-shared-process then do:
     1556                       run bge/genfname.p (
     1557                           input p-home-dir
     1558                           , input "d"
     1559                           , input ""
     1560                           , input "xml"
     1561                           , input ""
     1562                           , output p-xml-file-name
     1563                       ).
     1564         end.
     1565         else do:
     1566           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1567           v-fileext       = ".xml":U .
     1568           v-fullfname     = v-fullfnamenoext + v-fileext .
     1569           p-xml-file-name = v-fullfname .
     1570           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1571           if v-error-num > 0 then do:
     1572             return error.
     1573           end.
     1574         end.
     1575       end.
     1576     end case.
     1577     assign
     1578       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1579       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1580     .
     1581   end .
     1582   end procedure .
     1583   procedure xml-bge-filename :
     1584   do
     1585   on error undo, return error
     1586   :
     1587   define input parameter p-prefix             as character    no-undo.
     1588   define input parameter p-name               as character    no-undo.
     1589   define input parameter p-shared-process     as logical      no-undo.
     1590   define output parameter p-xml-file-name     as character    no-undo.
     1591   define output parameter p-log-file-name     as character    no-undo.
     1592   define output parameter p-locked            as logical      no-undo.
     1593   define variable v-home-dir          as character no-undo .
     1594   define variable v-error-num         as integer   no-undo .
     1595   define variable v-bge-xml-heap-dir  as character no-undo .
     1596       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1597       if v-home-dir = ?
     1598       then do:
     1599           message
     1600             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1601             skip(1)
     1602             skip "Обратитесь к администратору."
     1603           view-as alert-box error.
     1604           undo, return error .
     1605       end.
     1606       if v-bge-xml-bgeflold <> "oracle"
     1607       then do:
     1608         assign
     1609             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1610         .
     1611       end.
     1612       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1613       if error-status :error
     1614       then do:
     1615           message
     1616             skip "Неверно задан каталог экспорта."
     1617             skip(1)
     1618             skip "Обратитесь к администратору."
     1619           view-as alert-box error.
     1620           undo, return error .
     1621       end.
     1622       if v-bge-xml-bgefmt = "dbf":U
     1623       then do:
     1624           assign
     1625               p-xml-file-name = v-home-dir
     1626               p-locked        = no
     1627           .
     1628       end.
     1629       else do:
     1630           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1631             output p-xml-file-name, output p-locked) .
     1632       end.
     1633       if v-bge-xml-bgeflold = "oracle"
     1634       then do:
     1635         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1636         if v-bge-xml-heap-dir = ?
     1637         then do:
     1638           undo, return error substitute( "&1&2&3"
     1639                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1640                                         , chr(10)
     1641                                         , "Обратитесь к администратору.":u
     1642                                         ).
     1643         end.
     1644         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1645         if error-status :error
     1646         then do:
     1647           undo, return error substitute( "&1&2&3"
     1648                                         , "Неверно задан каталог экспорта (heap).":u
     1649                                         , chr(10)
     1650                                         , "Обратитесь к администратору.":u
     1651                                         ).
     1652         end.
     1653         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1654           assign
     1655             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1656           .
     1657         end.
     1658         else do:
     1659           assign
     1660             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1661           .
     1662         end.
     1663       end.
     1664       else do:
     1665         assign
     1666             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1667         .
     1668       end.
     1669       assign
     1670          v-bge-xml-static-log-file-name = p-log-file-name
     1671       .
     1672   end.
     1673   end procedure.
     1674   procedure bge-xml-read-config :
     1675   do
     1676   on error undo, return error return-value
     1677   :
     1678   define input  parameter p-last-date as date      no-undo .
     1679   define input  parameter p-db-num    as integer   no-undo .
     1680       define variable v-bgeclall      as character     no-undo.
     1681       define variable v-bgedict       as character     no-undo.
     1682       define variable v-bgeshift      as character     no-undo.
     1683       define variable v-par-type      as character     no-undo.
     1684       define variable v-bgeflnm       as character     no-undo.
     1685       define variable v-bgecliiv      as character     no-undo .
     1686       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1687       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1688       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1689       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1690       define variable v-db-num-str    as character     no-undo .
     1691       define variable v-param-type      as character  no-undo .
     1692       define variable v-value-character as character  no-undo .
     1693       define variable v-value-date      as date       no-undo .
     1694       define variable v-value-decimal   as decimal    no-undo .
     1695       define variable v-value-integer   as integer    no-undo .
     1696       define variable v-value-logical   as logical    no-undo .
     1697       define variable v-tth             as handle      no-undo .
     1698       run adm/shattri.p ( input "get":U
     1699                         , input  '':u
     1700                         , input  0
     1701                         , input  'bge-export':U
     1702                         , input  'bgeclall':U
     1703                         , output v-bgecliiv
     1704                         , output v-value-date
     1705                         , output v-value-decimal
     1706                         , output v-value-integer
     1707                         , output v-value-logical
     1708                         , output v-param-type
     1709                         , input-output table-handle v-tth
     1710                         ) no-error .
     1711       if error-status :error
     1712       then do:
     1713         assign
     1714           v-bge-xml-bgecliiv = no
     1715         .
     1716       end.
     1717       else do:
     1718         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1719       end.
     1720       delete object v-tth.
     1721       assign
     1722           v-bge-xml-bgeclall = no
     1723           v-bge-xml-bgedict  = no
     1724       .
     1725       run adm/shattri.p ( input "get":U
     1726                         , input  '':u
     1727                         , input  0
     1728                         , input  'bge-export':U
     1729                         , input  'bgeclall':U
     1730                         , output v-value-character
     1731                         , output v-value-date
     1732                         , output v-value-decimal
     1733                         , output v-value-integer
     1734                         , output v-value-logical
     1735                         , output v-param-type
     1736                         , input-output table-handle v-tth
     1737                         ) no-error .
     1738       if error-status :error
     1739       then do:
     1740         assign
     1741           v-bge-xml-bgeclall = no
     1742         .
     1743       end.
     1744       else do:
     1745         assign
     1746           v-bge-xml-bgeclall = v-value-logical
     1747         .
     1748       end.
     1749       delete object v-tth.
     1750       run adm/shattri.p ( input "get":U
     1751                         , input  '':u
     1752                         , input  0
     1753                         , input  'bge-export':U
     1754                         , input  'bgedict':U
     1755                         , output v-value-character
     1756                         , output v-value-date
     1757                         , output v-value-decimal
     1758                         , output v-value-integer
     1759                         , output v-value-logical
     1760                         , output v-param-type
     1761                         , input-output table-handle v-tth
     1762                         ) no-error .
     1763       if error-status :error
     1764       then do:
     1765         assign
     1766           v-bge-xml-bgedict = no
     1767         .
     1768       end.
     1769       else do:
     1770         assign
     1771           v-bge-xml-bgedict = v-value-logical
     1772         .
     1773       end.
     1774       delete object v-tth.
     1775       run adm/shattri.p ( input "get":U
     1776                         , input  '':u
     1777                         , input  0
     1778                         , input  'bge-export':U
     1779                         , input  'bgefmt':U
     1780                         , output v-value-character
     1781                         , output v-value-date
     1782                         , output v-value-decimal
     1783                         , output v-value-integer
     1784                         , output v-value-logical
     1785                         , output v-param-type
     1786                         , input-output table-handle v-tth
     1787                         ) no-error .
     1788       if error-status :error
     1789       then do:
     1790         assign
     1791           v-bge-xml-bgefmt  = "xml":U
     1792         .
     1793       end.
     1794       else do:
     1795         assign
     1796           v-bge-xml-bgefmt  = v-value-character
     1797         .
     1798       end.
     1799       delete object v-tth.
     1800       run adm/shattri.p ( input "get":U
     1801                         , input  '':u
     1802                         , input  0
     1803                         , input  'bge-export':U
     1804                         , input  'bgeshift':U
     1805                         , output v-value-character
     1806                         , output v-value-date
     1807                         , output v-value-decimal
     1808                         , output v-value-integer
     1809                         , output v-value-logical
     1810                         , output v-param-type
     1811                         , input-output table-handle v-tth
     1812                         ) no-error .
     1813       if error-status :error
     1814       then do:
     1815         assign
     1816             v-bge-xml-shift-mode = no
     1817         .
     1818       end.
     1819       else do:
     1820         assign
     1821             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1822         .
     1823       end.
     1824       delete object v-tth.
     1825       run adm/shattri.p ( input "get":U
     1826                         , input  '':u
     1827                         , input  0
     1828                         , input  'bge-export':U
     1829                         , input  'bgeflold':U
     1830                         , output v-value-character
     1831                         , output v-value-date
     1832                         , output v-value-decimal
     1833                         , output v-value-integer
     1834                         , output v-value-logical
     1835                         , output v-param-type
     1836                         , input-output table-handle v-tth
     1837                         ) no-error .
     1838       if error-status :error
     1839       then do:
     1840         assign
     1841           v-bge-xml-bgeflold = "no-parameter":U
     1842         .
     1843       end.
     1844       else do:
     1845         assign
     1846           v-bge-xml-bgeflold  = v-value-character
     1847         .
     1848       end.
     1849       delete object v-tth.
     1850       assign
     1851         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1852         v-bge-xml-db-num-str  = v-db-num-str
     1853       .
     1854       if p-last-date <> ?
     1855       then do:
     1856           run adm/shattri.p ( input "get":U
     1857                             , input  '':u
     1858                             , input  0
     1859                             , input  'bge-export':U
     1860                             , input  'bgeflnm':U
     1861                             , output v-value-character
     1862                             , output v-value-date
     1863                             , output v-value-decimal
     1864                             , output v-value-integer
     1865                             , output v-value-logical
     1866                             , output v-param-type
     1867                             , input-output table-handle v-tth
     1868                             ) no-error .
     1869           if error-status :error
     1870           then do:
     1871             assign
     1872               v-bgeflnm = '':U
     1873             .
     1874           end.
     1875           else do:
     1876             assign
     1877               v-bgeflnm = v-value-character
     1878             .
     1879           end.
     1880           delete object v-tth.
     1881           if v-bge-xml-bgeflold = "var"
     1882           then do:
     1883               if v-bgeflnm = ?
     1884               or num-entries( v-bgeflnm ) < 2
     1885               then do:
     1886                   assign
     1887                       v-bge-xml-bgeflold = "new"
     1888                   .
     1889               end.
     1890               else do:
     1891                   assign
     1892                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1893                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1894                   .
     1895                   assign
     1896                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1897                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1898                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1899                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1900                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1901                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1902                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1903                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1904                   .
     1905               end.
     1906           end.
     1907       end.
     1908   end.
     1909   end procedure.
     1910   procedure bge-xml-get-ref-filename :
     1911   define input parameter p-in-file-name       as character        no-undo.
     1912   define output parameter p-home-dir          as character        no-undo.
     1913   define output parameter p-out-file-name     as character        no-undo.
     1914   define output parameter p-locked            as logical          no-undo.
     1915       define variable v-counter       as integer      no-undo.
     1916       define variable v-error-level   as integer      no-undo.
     1917   do
     1918   on error undo, return error
     1919   :
     1920       run bge/bge-ini.p (
     1921             input "bge"
     1922           , output p-home-dir
     1923       ).
     1924       if return-value <> "OK"
     1925       then do:
     1926           undo, return error.
     1927       end.
     1928       assign
     1929           p-home-dir = p-home-dir + "\dict":U
     1930       .
     1931       run bge/dir_cd.p (
     1932           input p-home-dir
     1933           , input "CA"
     1934       ).
     1935       if return-value = "ERROR"
     1936       then do:
     1937           undo, return error.
     1938       end.
     1939       assign
     1940           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     1941       .
     1942       assign
     1943           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     1944       .
     1945       wait-lock:
     1946       do v-counter = 1 TO 3
     1947       :
     1948           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     1949           if p-locked = no
     1950           then do:
     1951               leave wait-lock.
     1952           end.
     1953           else do:
     1954               readkey pause 1.
     1955           end.
     1956       END.
     1957       if p-locked = yes
     1958       then do:
     1959           undo, return error.
     1960       end.
     1961       run bge/os_copy.p (
     1962             input "D":U
     1963           , input p-out-file-name + "xml":U
     1964           , input "":U
     1965           , output v-error-level
     1966       ).
     1967       if v-error-level > 0
     1968       then do:
     1969           undo, return error.
     1970       end.
     1971   end.
     1972   end procedure.
     1973   procedure bge-xml-write-ref-header :
     1974   define input parameter p-bge-name as character        no-undo.
     1975   define input parameter p-file-name as character        no-undo.
     1976       define variable v-out-string    as character    no-undo.
     1977   do
     1978   on error undo, return error
     1979   :
     1980       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     1981       put stream stmXMLOut unformatted
     1982           "<?xml version='1.0' encoding='windows-1251'?>":U
     1983       .
     1984       assign
     1985           v-out-string = substitute( "&1&2"
     1986                               , chr(10)
     1987                               , "<IBS_Trade_House>":U )
     1988       .
     1989       put stream stmXMLOut unformatted
     1990           v-out-string
     1991       .
     1992       run wp-XMLTagOpen( 1, "header", "" ).
     1993       if v-bge-xml-bgeflold = "oracle":u
     1994       then do:
     1995         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1996         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1997         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1998         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1999         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     2000       end.
     2001       else do:
     2002         run wp-XMLTagOpen( 2, "delivery", "" ).
     2003         run wp-XMLTagOpen( 3, "to", "" ).
     2004         run wp-XMLTagClose( 3, "to" ).
     2005         run wp-XMLTagOpen( 3, "from", "" ).
     2006         run wp-XMLTagClose( 3, "from" ).
     2007         run wp-XMLTagClose( 2, "delivery" ).
     2008       end.
     2009       run wp-XMLTagOpen( 2, "manifest", "" ).
     2010       run wp-XMLTagOpen( 3, "document", "" ).
     2011       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2012       run wp-XMLTagPut( 4, "description", "", 0 ).
     2013       run wp-XMLTagClose( 3, "document" ).
     2014       run wp-XMLTagClose( 2, "manifest" ).
     2015       run wp-XMLTagClose( 1, "header" ).
     2016       run wp-XMLTagOpen( 1, "body", "" ).
     2017   end.
     2018   end procedure.
     2019   procedure bge-xml-write-ref-footer :
     2020   define input parameter p-file-name as character        no-undo.
     2021       define variable v-error-level   as integer      no-undo.
     2022   do
     2023   on error undo, return error
     2024   :
     2025       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2026       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2027       output stream stmXMLOut close.
     2028       run bge/os_copy.p (
     2029             input "M":U
     2030           , input p-file-name + "xm1":U
     2031           , input p-file-name + "xml":U
     2032           , output v-error-level
     2033       ).
     2034       if v-error-level > 0
     2035       then do:
     2036           undo, return error.
     2037       end.
     2038   end.
     2039   end procedure.
     2040   procedure bge-xml-out-dir :
     2041   define output parameter p-out-dir       as character    no-undo.
     2042   define output parameter p-log-file-name as character    no-undo.
     2043   do
     2044   on error undo, return error
     2045   :
     2046       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2047       if p-out-dir = ?
     2048       then do:
     2049           message
     2050             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2051                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2052             skip(1)
     2053             skip "Обратитесь к администратору."
     2054           view-as alert-box error.
     2055           undo, return error .
     2056       end.
     2057       if v-bge-xml-bgeflold <> "oracle" then assign
     2058         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2059       .
     2060       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2061       if error-status :error  then do:
     2062           run wp-XMLWriteLog in this-procedure (
     2063                 input p-log-file-name
     2064               , input 0
     2065               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2066                                   , p-out-dir
     2067                                   , return-value
     2068                                   , trim( error-status :get-message( 1 ) )
     2069                                   )
     2070           ).
     2071           undo, return error.
     2072       end.
     2073       assign
     2074           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2075           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2076       .
     2077   end.
     2078   end procedure.
     2079   procedure bge-xml-out-dir2 :
     2080   define output parameter p-out-dir       as character    no-undo.
     2081   define output parameter p-out-dirR      as character    no-undo.
     2082   define output parameter p-log-file-name as character    no-undo.
     2083   do
     2084   on error undo, return error
     2085   :
     2086       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2087       if p-out-dir = ?
     2088       then do:
     2089           message
     2090             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2091                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2092             skip(1)
     2093             skip "Обратитесь к администратору."
     2094           view-as alert-box error.
     2095           undo, return error .
     2096       end.
     2097       if v-bge-xml-bgeflold <> "oracle" then assign
     2098             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2099             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2100         .
     2101       else p-out-dirR = p-out-dir .
     2102       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2103       if error-status :error  then do:
     2104           run wp-XMLWriteLog in this-procedure (
     2105                 input p-log-file-name
     2106               , input 0
     2107               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2108                                   , p-out-dir
     2109                                   , return-value
     2110                                   , error-status :get-message( 1 )
     2111                                   )
     2112           ).
     2113           undo, return error.
     2114       end.
     2115       if p-out-dirR <> p-out-dir then do:
     2116         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2117         if error-status :error then do:
     2118           run wp-XMLWriteLog in this-procedure (
     2119                 input p-log-file-name
     2120               , input 0
     2121               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2122                                   , p-out-dirR
     2123                                   , return-value
     2124                                   , error-status :get-message( 1 )
     2125                                   )
     2126           ).
     2127           p-out-dirR = p-out-dir .
     2128         end.
     2129       end .
     2130       assign
     2131         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2132         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2133       .
     2134   end.
     2135   end procedure.
     2136   procedure bge-xml-out-file :
     2137   do
     2138   on error undo, return error
     2139   :
     2140   define input parameter p-out-dir            as character        no-undo.
     2141   define input parameter p-prefix             as character        no-undo.
     2142   define input parameter p-sheduled           as logical          no-undo.
     2143   define output parameter p-xml-file-name     as character        no-undo.
     2144   define output parameter p-locked            as logical          no-undo.
     2145   define variable v-home-dir      as character     no-undo.
     2146   define variable v-error-num     as integer       no-undo.
     2147   define variable v-today             as date         no-undo.
     2148   define variable v-time              as integer      no-undo.
     2149       if v-bge-xml-bgefmt = "dbf":U
     2150       then do:
     2151           assign
     2152               p-xml-file-name = p-out-dir
     2153               p-locked        = no
     2154           .
     2155       end.
     2156       else do:
     2157           if v-bge-xml-bgeflold = "firm":U
     2158           then do:
     2159               run bge/genfname.p (
     2160                     input p-out-dir
     2161                   , input p-prefix
     2162                   , input "":U
     2163                   , input "arj":U
     2164                   , input "":U
     2165                   , output p-xml-file-name
     2166               ).
     2167           end.
     2168           else do:
     2169               run bge/genfname.p (
     2170                     input p-out-dir
     2171                   , input p-prefix
     2172                   , input "":U
     2173                   , input "xml":U
     2174                   , input "":U
     2175                   , output p-xml-file-name
     2176               ).
     2177           end.
     2178           assign
     2179               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2180               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2181           .
     2182       end.
     2183   end.
     2184   end procedure.
     2185   procedure bge-xml-init-ext-doc-type :
     2186       define variable v-counter    as integer      no-undo.
     2187       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2188   do
     2189   for buf_temp_ext-doc-type
     2190   on error undo, return error
     2191   :
     2192       empty temp-table buf_temp_ext-doc-type.
     2193       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2194       :
     2195           create buf_temp_ext-doc-type.
     2196           assign
     2197               buf_temp_ext-doc-type.edt-key               = v-counter
     2198               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2199               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2200           .
     2201       end.
     2202   end.
     2203   end procedure.
     2204   procedure bge-xml-get-decimal-shift-num :
     2205   define input parameter p-shift-date     as date             no-undo.
     2206   define input parameter p-shift-num      as integer          no-undo.
     2207   define output parameter p-shift-decimal as decimal          no-undo.
     2208   do
     2209   on error undo, return error
     2210   :
     2211       assign
     2212           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2213       .
     2214   end.
     2215   end procedure.
     2216   procedure bge-xml-ora-exp-filename :
     2217     define input  parameter p-table-name  as character no-undo .
     2218     define input  parameter p-doc-code    as character no-undo .
     2219     define input  parameter p-obj-code    as integer   no-undo .
     2220     define output parameter p-filename    as character no-undo .
     2221     define output parameter p-seq-num     as integer   no-undo .
     2222     define variable v-ora-exp-seq     as integer   no-undo .
     2223     define variable v-ora-exp-seq-str as character no-undo .
     2224     define variable v-home-dir        as character no-undo.
     2225   do
     2226   on error undo, return error return-value
     2227   :
     2228     if v-bge-xml-bgeflold = "oracle":u
     2229     then do:
     2230       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2231       if v-home-dir = ?
     2232       then do:
     2233         undo, return error substitute( "&1&2&3":U
     2234                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2235                                       , chr(10)
     2236                                       , "Обратитесь к администратору.":U
     2237                                       ).
     2238       end.
     2239       assign
     2240           v-home-dir = v-home-dir
     2241       .
     2242       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2243       if error-status :error
     2244       then do:
     2245         undo, return error substitute( "&1&2&3":U
     2246                                       , "Неверно задан каталог экспорта.":U
     2247                                       , chr(10)
     2248                                       , "Обратитесь к администратору.":U
     2249                                       ).
     2250       end.
     2251       assign
     2252         v-ora-exp-seq = ?
     2253       .
     2254       if  p-table-name <> ? and
     2255           p-doc-code <> ?
     2256       then do:
     2257         run bge/get-oesq.p ( input p-table-name
     2258                            , input p-doc-code
     2259                            , output v-ora-exp-seq
     2260                            ) no-error .
     2261         if error-status :error = yes
     2262         then do:
     2263           undo, return error return-value .
     2264         end.
     2265       end.
     2266       if v-ora-exp-seq = ?
     2267       then do:
     2268         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2269         if error-status :error
     2270         then do:
     2271           undo, return error return-value .
     2272         end.
     2273       end.
     2274       if p-table-name <> ? and
     2275          p-doc-code   <> ?
     2276       then do:
     2277         run bge/oesqdoc.p ( input p-table-name
     2278                           , input p-doc-code
     2279                           , input v-ora-exp-seq
     2280                           ) no-error .
     2281         if error-status :error = yes
     2282         then do:
     2283           undo, return error return-value .
     2284         end.
     2285       end.
     2286       assign
     2287         p-seq-num  = v-ora-exp-seq
     2288         p-filename = substitute("&1/&2-000_&3."
     2289                                , v-home-dir
     2290                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2291                                , string(v-ora-exp-seq , "999999999")
     2292                                )
     2293       .
     2294     end.
     2295   end.
     2296   end procedure.
     2297   procedure bge-xml-date-to-str :
     2298     define input  parameter p-date  as date      no-undo .
     2299     define output parameter p-str   as character no-undo .
     2300   do
     2301   on error undo, return error return-value
     2302   :
     2303     if p-date <> ?
     2304     then do:
     2305       assign
     2306         p-str = substitute( "&1-&2-&3"
     2307                           , string( year(p-date)  , "9999")
     2308                           , string( month(p-date) , "99"  )
     2309                           , string( day(p-date)   , "99"  )
     2310                           )
     2311       .
     2312     end.
     2313     else do:
     2314       assign
     2315         p-str = ?
     2316       .
     2317     end.
     2318   end.
     2319   end procedure.
     2320   procedure bge-xml-date-str-to-str :
     2321     define input  parameter p-date-str  as character no-undo .
     2322     define output parameter p-str       as character no-undo .
     2323     define variable v-date          as date      no-undo .
     2324     define variable v-date-valid    as logical   no-undo .
     2325     define variable v-error-message as character no-undo .
     2326   do
     2327   on error undo, return error return-value
     2328   :
     2329     assign
     2330       p-str = ?
     2331     .
     2332     if p-date-str = ? or p-date-str = ""
     2333     then do:
     2334       return .
     2335     end.
     2336     run strtdate in this-procedure ( input  p-date-str
     2337                                    , output v-date
     2338                                    , output v-date-valid
     2339                                    , output v-error-message
     2340                                    ).
     2341     if v-date-valid <> true
     2342     then do:
     2343       return .
     2344     end.
     2345     assign
     2346       p-str = substitute( "&1-&2-&3"
     2347                         , string( year(v-date)  , "9999")
     2348                         , string( month(v-date) , "99"  )
     2349                         , string( day(v-date)   , "99"  )
     2350                         )
     2351     .
     2352   end.
     2353   end procedure.
     2354   procedure bge-xml-fill-tt-bgecliiv :
     2355     define input  parameter p-str as character no-undo .
     2356     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2357     define buffer buf_clients             for ub.clients.
     2358     define variable v-i         as integer   no-undo .
     2359     define variable v-count     as integer   no-undo .
     2360     define variable v-cli-count as integer   no-undo .
     2361     define variable v-client    as character no-undo .
     2362     define variable v-obj-type  as character no-undo .
     2363     define variable v-obj-code  as integer   no-undo .
     2364   do
     2365   on error undo, return error return-value
     2366   :
     2367     empty temp-table buf_tt-bge-xml-bgecliiv.
     2368     assign
     2369       v-bge-xml-bgecliiv = no
     2370       v-cli-count        = num-entries(p-str,';')
     2371     .
     2372     if v-cli-count > 0
     2373     then do:
     2374       _cli-cycle:
     2375       do v-i = 1 to v-cli-count
     2376       :
     2377         assign
     2378           v-client = entry(v-i , p-str, ';')
     2379         .
     2380         if num-entries(v-client) <> 2
     2381         then do:
     2382           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2383         end.
     2384         assign
     2385           v-obj-type = entry(1, v-client)
     2386         .
     2387         assign
     2388           v-obj-code = integer(entry(2, v-client))
     2389         no-error .
     2390         if error-status :error
     2391         then do:
     2392           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2393         end.
     2394         find first buf_clients no-lock
     2395           where buf_clients.obj-type = v-obj-type
     2396             and buf_clients.obj-code = v-obj-code
     2397         no-error.
     2398         if not available buf_clients
     2399         then do:
     2400           next _cli-cycle.
     2401         end.
     2402         find first buf_tt-bge-xml-bgecliiv no-lock
     2403           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2404             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2405         no-error .
     2406         if available buf_tt-bge-xml-bgecliiv
     2407         then do:
     2408           next _cli-cycle.
     2409         end.
     2410         create buf_tt-bge-xml-bgecliiv.
     2411         assign
     2412           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2413           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2414         .
     2415       end.
     2416     end.
     2417     else do:
     2418       assign
     2419         v-bge-xml-bgecliiv = no
     2420       .
     2421       return .
     2422     end.
     2423     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2424     if available buf_tt-bge-xml-bgecliiv
     2425     then do:
     2426       assign
     2427         v-bge-xml-bgecliiv = yes
     2428       .
     2429     end.
     2430   end.
     2431   end procedure.
     2432   procedure bge-xml-resolve-ext-doc-type :
     2433     define input  parameter p-ext-doc-type      as character no-undo .
     2434     define input  parameter p-obj-type          as character no-undo .
     2435     define input  parameter p-obj-code          as integer   no-undo .
     2436     define output parameter p-out-ext-doc-type  as character no-undo .
     2437     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2438   do
     2439   on error undo, return error return-value
     2440   :
     2441     assign
     2442       p-out-ext-doc-type = p-ext-doc-type
     2443     .
     2444     if p-ext-doc-type <> 'ie':U
     2445     then do:
     2446       return .
     2447     end.
     2448     if v-bge-xml-bgecliiv = yes
     2449     then do:
     2450       find first buf_tt-bge-xml-bgecliiv no-lock
     2451         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2452           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2453       no-error .
     2454       if available buf_tt-bge-xml-bgecliiv
     2455       then do:
     2456         assign
     2457           p-out-ext-doc-type = 'iv':U
     2458         .
     2459       end.
     2460     end.
     2461   end.
     2462   end procedure.
     2463   procedure safe-wp-xmltagput :
     2464     define input  parameter pTagLevel   as integer   no-undo .
     2465     define input  parameter pTagName    as character no-undo .
     2466     define input  parameter pParValue   as character no-undo .
     2467     define input  parameter pFlagEmpty  as integer   no-undo .
     2468   do
     2469   on error undo, return error return-value
     2470   :
     2471     if v-bge-xml-bgeflold = "oracle":u
     2472     then do:
     2473       return .
     2474     end.
     2475     run wp-xmltagput in this-procedure ( input pTagLevel
     2476                                        , input pTagName
     2477                                        , input pParValue
     2478                                        , input pFlagEmpty
     2479                                        ).
     2480   end.
     2481   end procedure.
     2482   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2483   define  temp-table temp-host no-undo
     2484     field host-code like ub.store.host-code
     2485     index xpk host-code
     2486   .
     2487   define  temp-table temp-obj no-undo
     2488     field obj-type  like ub.clients.obj-type
     2489     field obj-code  like ub.clients.obj-code
     2490     field host-code like ub.store.host-code
     2491     field db-num    like ub.clients.db-num
     2492     index xpk  obj-type obj-code
     2493     index xie1 host-code
     2494     index xie2 db-num host-code
     2495   .
     2496   procedure init-temphost:
     2497     define buffer buf_store   for ub.store .
     2498     define buffer buf_shop    for ub.shop .
     2499     define buffer buf_clients for ub.clients .
     2500     define buffer buf_db for ub.db .
     2501     define buffer buf_temp-host for temp-host .
     2502     define buffer buf_temp-obj for temp-obj .
     2503     do
     2504     on error undo, return error return-value
     2505     :
     2506       for each buf_store
     2507       on error undo, return error
     2508       :
     2509         find first buf_temp-host
     2510           where buf_temp-host.host-code = buf_store.host-code
     2511           no-error .
     2512         if not available buf_temp-host
     2513         then do:
     2514           create buf_temp-host .
     2515           assign
     2516             buf_temp-host.host-code = buf_store.host-code
     2517           .
     2518         end.
     2519         find first buf_clients no-lock
     2520           where buf_clients.obj-type = 'скл':U
     2521             and buf_clients.obj-code = buf_store.obj-code
     2522           no-error .
     2523         if not available buf_clients
     2524         then do:
     2525           message
     2526             "Ошибка при поиске клиента" skip
     2527             "Клиент" 'скл':U buf_store.obj-code skip
     2528             view-as alert-box error .
     2529           undo, return error .
     2530         end.
     2531         create buf_temp-obj .
     2532         assign
     2533           buf_temp-obj.obj-type  = 'скл':U
     2534           buf_temp-obj.obj-code  = buf_store.obj-code
     2535           buf_temp-obj.host-code = buf_store.host-code
     2536           buf_temp-obj.db-num    = buf_clients.db-num
     2537         .
     2538       end.
     2539       for each buf_shop
     2540       on error undo, return error
     2541       :
     2542         find first buf_temp-host
     2543           where buf_temp-host.host-code = buf_shop.host-code
     2544           no-error .
     2545         if not available buf_temp-host
     2546         then do:
     2547           create buf_temp-host .
     2548           assign
     2549             buf_temp-host.host-code = buf_shop.host-code
     2550           .
     2551         end.
     2552         find first buf_clients no-lock
     2553           where buf_clients.obj-type = 'маг':U
     2554             and buf_clients.obj-code = buf_shop.obj-code
     2555           no-error .
     2556         if not available buf_clients then do:
     2557           message
     2558             "Ошибка при поиске клиента" skip
     2559             "Клиент" 'маг':U buf_shop.obj-code skip
     2560             view-as alert-box error .
     2561           undo, return error .
     2562         end.
     2563         create buf_temp-obj .
     2564         assign
     2565           buf_temp-obj.obj-type  = 'маг':U
     2566           buf_temp-obj.obj-code  = buf_shop.obj-code
     2567           buf_temp-obj.host-code = buf_shop.host-code
     2568           buf_temp-obj.db-num    = buf_clients.db-num
     2569         .
     2570       end.
     2571     end.
     2572   end.
     2573   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2574     define variable v-cntxt-db-num        as integer   no-undo .
     2575     define variable v-cntxt-userid        as character no-undo .
     2576     define variable v-cntxt-level         as character no-undo .
     2577     define variable v-cntxt-host-code-obj as integer   no-undo .
     2578     define variable v-cntxt-obj-type      as character no-undo .
     2579     define variable v-cntxt-obj-code      as integer   no-undo .
     2580     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2581     define variable v-cntxt-is-admin      as logical   no-undo .
     2582   define variable v-xml-file-name     as character            no-undo.
     2583   define variable v-log-file-name     as character            no-undo.
     2584   define variable v-out-dir           as character            no-undo.
     2585   define variable v-locked            as logical              no-undo.
     2586   define variable v-log-string        as character            no-undo.
     2587   define variable v-oper-num          as integer              no-undo.
     2588   define variable v-obj-counter       as integer              no-undo.
     2589   define variable v-obj-list          as character            no-undo.
     2590   define variable loc#log             as logical              no-undo.
     2591   define variable strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     2592   define variable intRep      AS INT NO-UNDO.
     2593   define temp-table temp-dis-card no-undo like ub.dis-card.
     2594   do
     2595   on error undo, return error
     2596   :
     2597   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2598   do:
     2599     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2600       (input  v-cntxt-db-num
     2601       ,input  v-cntxt-userid
     2602       ,input  0
     2603       ,input  'actn_references_export':U
     2604       ,input  'global':U
     2605       ,input  0
     2606       ,input  '':U
     2607       ,input  0
     2608       ,input  0
     2609       ,input  0
     2610       ,input  0
     2611       ,input  true
     2612       ,output loc#log
     2613       )  .
     2614   end.
     2615   IF NOT loc#log THEN RETURN ERROR.
     2616   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2617     run mainmenu_getcntxt in p-mainmenu-handle
     2618       (output v-cntxt-db-num
     2619       ,output v-cntxt-userid
     2620       ,output v-cntxt-level
     2621       ,output v-cntxt-host-code-obj
     2622       ,output v-cntxt-obj-type
     2623       ,output v-cntxt-obj-code
     2624       ,output v-cntxt-db-num-obj
     2625       ,output v-cntxt-is-admin
     2626       ) .
     2627   run bge-xml-out-dir in this-procedure ( output v-out-dir
     2628                                         , output v-log-file-name
     2629                                         ).
     2630   case p-range:
     2631   when 1
     2632   then do:
     2633       run init-temphost.
     2634   end.
     2635   when 2
     2636   then do:
     2637       run init-temphost.
     2638       for each temp-obj
     2639           where temp-obj.host-code <> v-cntxt-host-code-obj
     2640       :
     2641           delete temp-obj.
     2642       end.
     2643   end.
     2644   when 3
     2645   then do:
     2646       for each temp-obj
     2647       :
     2648           delete temp-obj.
     2649       end.
     2650       do v-obj-counter = 1 to num-entries ( v-obj-list ) / 2
     2651       :
     2652           create temp-obj.
     2653           assign
     2654               temp-obj.obj-type = entry( v-obj-counter * 2 - 1, v-obj-list )
     2655               temp-obj.obj-code = integer( entry( v-obj-counter * 2, v-obj-list ) )
     2656           no-error .
     2657           if error-status :error
     2658           then do:
     2659               run wp-XMLWriteLog in this-procedure (
     2660                   input v-log-file-name
     2661                   , input 1
     2662                   , input substitute( "*** Ошибка чтения списка объектов. &1. &2. &3. &4."
     2663                                       , return-value
     2664                                       , trim(error-status :get-message(1))
     2665                                       , trim(error-status :get-message(2))
     2666                                       , trim(error-status :get-message(3))
     2667                                   )
     2668               ).
     2669               undo, return error .
     2670           end.
     2671   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2672   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2673     (input  temp-obj.obj-type
     2674     ,input  temp-obj.obj-code
     2675     ,output temp-obj.host-code
     2676     ) no-error .
     2677           if error-status :error
     2678           then do:
     2679               run wp-XMLWriteLog in this-procedure (
     2680                   input v-log-file-name
     2681                   , input 1
     2682                   , input substitute( "*** Не найдена фирма для объекта &1 &2. &3. &4. &5. &6."
     2683                                       , temp-obj.obj-type
     2684                                       , temp-obj.obj-code
     2685                                       , return-value
     2686                                       , trim(error-status :get-message(1))
     2687                                       , trim(error-status :get-message(2))
     2688                                       , trim(error-status :get-message(3))
     2689                                   )
     2690               ).
     2691               undo, return error .
     2692           end.
     2693       end.
     2694   end.
     2695   end case.
     2696   run bge-xml-read-config in this-procedure ( input ?
     2697                                             , input ?
     2698                                             ) no-error.
     2699   if error-status :error
     2700   then do:
     2701       message
     2702       vss-workfile vss-revision vss-description
     2703       skip "Ошибка чтения параметров экспорта."
     2704       skip "Для экспорта данных будут приняты параметры по умолчанию."
     2705       skip return-value
     2706       skip trim(error-status :get-message(1))
     2707           trim(error-status :get-message(2))
     2708           trim(error-status :get-message(3))
     2709       view-as alert-box error.
     2710   end.
     2711   run xml-bge-filename in this-procedure (
     2712         input "crd"
     2713       , input "card"
     2714       , input no
     2715       , output v-xml-file-name
     2716       , output v-log-file-name
     2717       , output v-locked
     2718   ).
     2719   if v-locked = yes
     2720   then do:
     2721       run wp-XMLWriteLog in this-procedure (
     2722             input v-log-file-name
     2723           , input 1
     2724           , input "*** Ошибка выгрузки: Файл выгрузки заблокирован другим процессом."
     2725       ).
     2726       undo, return error .
     2727   end.
     2728   run wp-XMLWriteLog in this-procedure (
     2729         input v-log-file-name
     2730       , input 1
     2731       , input "&DLine"
     2732   ).
     2733   run wp-XMLWriteLog in this-procedure (
     2734         input v-log-file-name
     2735       , input 1
     2736       , input substitute( "Начало выгрузки данных продаж по дисконтным картам в файл &1"
     2737                               , replace( v-xml-file-name, "/", "\" ) + "xm1"
     2738                         )
     2739   ).
     2740   run wp-XMLWriteLog in this-procedure (
     2741         input v-log-file-name
     2742       , input 1
     2743       , input substitute( "................с параметрами: Дата с: &1, дата по: &2"
     2744                               , p-date-from
     2745                               , p-date-to
     2746                         )
     2747   ).
     2748   CASE p-range:
     2749     when 3 then do:
     2750       run wp-XMLWriteLog in this-procedure (
     2751             input v-log-file-name
     2752           , input 1
     2753           , input substitute( "................с параметрами: ... список объектов: &1", p-obj-list )
     2754       ).
     2755     end.
     2756     when 1 then do:
     2757       run wp-XMLWriteLog in this-procedure (
     2758             input v-log-file-name
     2759           , input 1
     2760           , input  ("................с параметрами: ... все объекты")
     2761       ).
     2762     end.
     2763     when 2 then do:
     2764       run wp-XMLWriteLog in this-procedure (
     2765             input v-log-file-name
     2766           , input 1
     2767           , input substitute( "................с параметрами: ... объекты фирмы: &1", string( v-cntxt-host-code-obj ) )
     2768       ).
     2769     end.
     2770   END.
     2771   run bge-xml-write-header in this-procedure (
     2772         input v-xml-file-name
     2773       , input "cardsale"
     2774       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     2775       , input ?
     2776       , input p-date-from
     2777       , input 0
     2778       , input p-date-to
     2779       , input 0
     2780       , input p-obj-list
     2781       , input "":U
     2782       , input no
     2783       , input no
     2784       , input no
     2785       , input no
     2786       , input no
     2787       , input no
     2788       , input no
     2789       , input no
     2790   ) no-error.
     2791   if error-status :error
     2792   then do:
     2793       run wp-XMLWriteLog in this-procedure (
     2794               input v-log-file-name
     2795           , input 1
     2796           , input substitute( "*** Ошибка записи шапки файла. Процедура: &1 (v.&2 &3). &4. &5"
     2797                               , vss-workfile
     2798                               , vss-revision
     2799                               , vss-description
     2800                               , return-value
     2801                               , trim( error-status :get-message( 1 ) )
     2802                               )
     2803       ).
     2804       undo, return error.
     2805   end.
     2806   if not avail temp-dis-card then create temp-dis-card.
     2807   object-of-list:
     2808   for each temp-obj where temp-obj.obj-type = 'маг':U
     2809   :
     2810       run export-cardsale-by-object (   input temp-obj.host-code
     2811                                       , input temp-obj.obj-type
     2812                                       , input temp-obj.obj-code
     2813                                     ) no-error.
     2814       if error-status :error
     2815       then do:
     2816           run wp-XMLWriteLog in this-procedure (
     2817                 input v-log-file-name
     2818               , input 1
     2819               , input substitute( "*** Ошибка выгрузки данных продаж по дисконтным картам по объекту &1 &2. &3. &4. &5."
     2820                                   , temp-obj.obj-type
     2821                                   , temp-obj.obj-code
     2822                                   , return-value
     2823                                   , trim(error-status :get-message(1))
     2824                                   , trim(error-status :get-message(2))
     2825                                   , trim(error-status :get-message(3))
     2826                                 )
     2827           ).
     2828       end.
     2829   end.
     2830   run xml-bge-write-footer in this-procedure ( input v-xml-file-name ).
     2831   run wp-XMLWriteLog in this-procedure (
     2832         input v-log-file-name
     2833       , input 1
     2834       , input substitute( "Данные выгружены в файл &1"
     2835                               , replace( v-xml-file-name, "/", "\" ) + "xml"
     2836                         )
     2837   ).
     2838   run wp-XMLWriteLog in this-procedure (
     2839         input v-log-file-name
     2840       , input 1
     2841       , input "&DLine"
     2842   ).
     2843   if session :set-wait-state( "" ) then.
     2844   end.
     2845   procedure export-cardsale-by-object :
     2846   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     2847   define input parameter p-obj-type  like ub.clients.obj-type  no-undo .
     2848   define input parameter p-obj-code  like ub.clients.obj-code  no-undo .
     2849   define variable v-d-card like ub.dis-card.d-card no-undo .
     2850   define variable v-discnt-name as character no-undo .
     2851   define buffer buf_inkas for ub.inkas.
     2852   define buffer buf_payment for ub.payment.
     2853   define buffer buf_dis-card for ub.dis-card.
     2854   define buffer buf_dis-obj for ub.dis-obj.
     2855   define buffer buf_dis-host for ub.dis-host.
     2856     do
     2857     on error undo, return error
     2858     :
     2859       run wp-XMLWriteEDT( hEDT, 1, string( p-obj-type ) + " " + string( p-obj-code ) ).
     2860       run wp-XMLShowCNT(hCNT).
     2861       output stream stmxmlout to value( v-xml-file-name + "xm1" ) convert target "1251" append.
     2862       _payment:
     2863       for each buf_inkas no-lock where
     2864                buf_inkas.obj-type = p-obj-type
     2865            AND buf_inkas.obj-code = p-obj-code
     2866            AND buf_inkas.doc-date >= p-date-from
     2867            AND buf_inkas.doc-date <= p-date-to
     2868            AND buf_inkas.status_ = 'факт':U,
     2869           each buf_payment no-lock where
     2870                buf_payment.host-code = p-host-code
     2871           AND buf_payment.source-type = 'касс':U
     2872           AND buf_payment.source-ref = buf_inkas.inkas-code
     2873           AND buf_payment.d-card <> "":U
     2874        by buf_payment.d-card
     2875           :
     2876         if v-d-card <> buf_payment.d-card then do:
     2877           find first buf_dis-card no-lock where
     2878                     buf_dis-card.d-card = buf_payment.d-card
     2879           no-error .
     2880           if not avail buf_dis-card then do:
     2881             run wp-XMLWriteLog( v-Log-File-name, 1, "Не найдена дисконтная карта " + string( buf_payment.d-card ) ).
     2882             next _payment.
     2883           end.
     2884           buffer-copy buf_dis-card to temp-dis-card.
     2885           assign
     2886           v-d-card = buf_payment.d-card
     2887           .
     2888           CASE buf_dis-card.d-pcnt:
     2889             when 0.0 then do:
     2890               assign
     2891               v-discnt-name = "без скидки"
     2892               .
     2893             end.
     2894             otherwise do:
     2895               assign
     2896               v-discnt-name = string(round(buf_dis-card.d-pcnt, 0), ">9 %":U)
     2897               .
     2898             end.
     2899           END CASE.
     2900         end.
     2901         run wp-xmltagopen in this-procedure ( input 2, input "card", input "" ).
     2902         run wp-xmltagput in this-procedure ( input 3, input "cardNumber"       , input string( temp-dis-card.d-card    ), input 0 ).
     2903         run wp-xmltagput in this-procedure ( input 3, input "cardType"         , input string( temp-dis-card.type    ), input 0 ).
     2904         run wp-xmltagput in this-procedure ( input 3, input "client"           , input (string(temp-dis-card.cli-type) +
     2905                                                                                         string(temp-dis-card.cli-code)), input 0 ).
     2906         run wp-xmltagput in this-procedure ( input 3, input "status"           , input string( temp-dis-card.status_    ), input 0 ).
     2907         run wp-xmltagput in this-procedure ( input 3, input "creditCard"       , input string( temp-dis-card.credit-card, "yes/no":U), input 0 ).
     2908         run wp-xmltagput in this-procedure ( input 3, input "discountPercent"  , input string( temp-dis-card.d-pcnt), input 0 ).
     2909         run wp-xmltagput in this-procedure ( input 3, input "discountName"     , input v-discnt-name, input 0 ).
     2910         run wp-xmltagput in this-procedure ( input 3, input "emitentHost"      , input string( temp-dis-card.emitent-host-code), input 0 ).
     2911         run wp-xmltagput in this-procedure ( input 3, input "issuingObject"    , input string( temp-dis-card.issue-code), input 0 ).
     2912         run wp-xmltagput in this-procedure ( input 3, input "issuingDate"      , input string( temp-dis-card.issue-date, "99/99/9999":U), input 0 ).
     2913         run wp-xmltagput in this-procedure ( input 3, input "saldoBase"        , input string( temp-dis-card.saldo-base), input 0 ).
     2914         run wp-xmltagput in this-procedure ( input 3, input "saldoRubl"        , input string( temp-dis-card.saldo-rubl), input 0 ).
     2915         run wp-xmltagput in this-procedure ( input 3, input "ID"               , input string( buf_payment.pmnt-code    ), input 0 ).
     2916         run wp-xmltagput in this-procedure ( input 3, input "cardNumber"       , input string( buf_payment.d-card    ), input 0 ).
     2917         run wp-xmltagput in this-procedure ( input 3, input "host"             , input string( p-host-code), input 0 ).
     2918         run wp-xmltagput in this-procedure ( input 3, input "object"           , input (string( p-obj-type    ) + string(p-obj-code)), input 0 ).
     2919         run wp-xmltagput in this-procedure ( input 3, input "date"             , input string( buf_payment.exch-date, "99/99/9999" ), input 0 ).
     2920         run wp-xmltagput in this-procedure ( input 3, input "currency"         , input string( buf_payment.exch-code    ), input 0 ).
     2921         run wp-xmltagput in this-procedure ( input 3, input "totSum"           , input string( buf_payment.tot-cli     ), input 0 ).
     2922         run wp-xmltagput in this-procedure ( input 3, input "totRubl"          , input string( buf_payment.tot-rubl    ), input 0 ).
     2923         run wp-xmltagput in this-procedure ( input 3, input "totBase"          , input string( buf_payment.tot-base    ), input 0 ).
     2924         run wp-xmltagput in this-procedure ( input 3, input "payCode"          , input string( buf_payment.pay-code    ), input 0 ).
     2925         run wp-xmltagput in this-procedure ( input 3, input "saleDoc"          , input string( buf_inkas.inkas-code    ), input 0 ).
     2926         run wp-xmltagclose in this-procedure ( input 2, input "card").
     2927       end.
     2928       run wp-XMLHideCNT(hCNT).
     2929       output stream stmxmlout close.
     2930     end.
     2931   end procedure.
