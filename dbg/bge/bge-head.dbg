        1   block-level on error undo, throw.
        2   define input parameter p-subdir             as character    no-undo.
        3   define input parameter p-file-name          as character    no-undo.
        4   define input parameter p-message-to-log     as character    no-undo.
        5   define input parameter p-shedule            as logical      no-undo.
        6   define output parameter p-xml-file-name     as character    no-undo.
        7   define output parameter p-log-file-name     as character    no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: bge-head.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: bge/bge-head.p $":U .
       13   define variable vss-description as character no-undo init "Определение полного имени файла и вывод заголовка файла XML".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define variable vss-include-info0 as character format "X(65)" no-undo
       73   initial "@(#)$Workfile$ $Revision$".
       74   DEF STREAM stmXMLOut.
       75   DEF STREAM stmXMLLog.
       76   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   procedure cur-time :
       78      define output parameter p-today as date      no-undo .
       79      define output parameter p-time  as integer   no-undo .
       80     do
       81     on error undo, return error
       82     :
       83       define variable v-date1 as date      no-undo .
       84       define variable v-date2 as date      no-undo .
       85       define variable v-time  as integer   no-undo .
       86       assign
       87         v-date1 = today
       88         v-time  = time
       89         v-date2 = today
       90       .
       91       if v-date1 <> v-date2
       92       then do:
       93         assign
       94           v-date1 = today
       95           v-time  = v-time
       96         .
       97       end.
       98       assign
       99         p-today = v-date1
      100         p-time  = v-time
      101       .
      102     end.
      103   end.
      104   function cur-time-date returns character
      105   :
      106     return string(today, '99/99/9999':U) .
      107   end.
      108   function cur-time-mjd returns decimal
      109   :
      110     define variable v-date as date      no-undo .
      111     define variable v-time as integer   no-undo .
      112     run cur-time in this-procedure
      113       (output v-date
      114       ,output v-time
      115       ) .
      116     return integer(v-date) - 2400002 + (v-time / 86400) .
      117   end.
      118   function cur-time-get-ending-index returns integer
      119   (input p-number as integer
      120   )
      121   :
      122     if p-number < 0
      123     or p-number = ?
      124     then do:
      125       return 1 .
      126     end.
      127     define variable v-rest as integer   no-undo .
      128     assign
      129       p-number = p-number modulo 100
      130     .
      131     if p-number < 20
      132     then do:
      133       assign
      134         v-rest = p-number
      135       .
      136     end.
      137     else do:
      138       assign
      139         v-rest = p-number modulo 10
      140       .
      141     end.
      142     case v-rest :
      143       when 1
      144       then do:
      145         return 2 .
      146       end.
      147       when 2 or
      148       when 3 or
      149       when 4
      150       then do:
      151         return 3 .
      152       end.
      153       otherwise do:
      154         return 1 .
      155       end.
      156     end case .
      157   end.
      158   procedure cur-time-mjd-to-date :
      159      define input  parameter i-mjd-diff as decimal no-undo.
      160      define output parameter o-Date     as date    no-undo.
      161      define output parameter o-Time     as integer no-undo.
      162      define variable v-day-number as integer   no-undo .
      163      if    i-mjd-diff < 0
      164         or i-mjd-diff = ?
      165      then do:
      166         return "?" .
      167      end.
      168      assign
      169         v-day-number = truncate(i-mjd-diff,0).
      170         o-Date = date(v-day-number + 2400002).
      171         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      172     .
      173   end.
      174   function cur-time-mjd-to-string returns character
      175   (input p-mjd-diff as decimal
      176   )
      177   :
      178     define variable v-day-number as integer   no-undo .
      179     define variable v-seconds    as integer   no-undo .
      180     define variable v-hour       as integer   no-undo .
      181     define variable v-min        as integer   no-undo .
      182     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      183     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      184     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      185     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      186     if p-mjd-diff < 0
      187     or p-mjd-diff = ?
      188     then do:
      189       return "?" .
      190     end.
      191     assign
      192       v-day-number = integer(truncate(p-mjd-diff,0))
      193       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      194     .
      195     if v-seconds > 86400
      196     then do:
      197       assign
      198         v-seconds = 86400 - 1
      199       .
      200     end.
      201     if v-seconds < 0
      202     then do:
      203       assign
      204         v-seconds = 0
      205       .
      206     end.
      207     assign
      208       v-hour = truncate(v-seconds / 3600, 0)
      209     .
      210     assign
      211       v-seconds = v-seconds modulo 3600
      212     .
      213     assign
      214       v-min = truncate(v-seconds / 60, 0)
      215     .
      216     assign
      217       v-seconds = v-seconds modulo 60
      218     .
      219     return
      220         (if v-day-number <> 0
      221           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      222           else ""
      223         )
      224       + (if v-day-number <> 0 or v-hour <> 0
      225           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      226           else ""
      227         )
      228       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      229           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      230           else ""
      231         )
      232       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      233       .
      234   end.
      235   function cur-time-string returns character
      236   :
      237     define variable v-date as date      no-undo .
      238     define variable v-time as integer   no-undo .
      239     run cur-time in this-procedure
      240       (output v-date
      241       ,output v-time
      242       ) .
      243     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      244   end.
      245   function cur-time-string-sec returns character
      246   :
      247     define variable v-date as date      no-undo .
      248     define variable v-time as integer   no-undo .
      249     run cur-time in this-procedure
      250       (output v-date
      251       ,output v-time
      252       ) .
      253     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      254   end.
      255   function cur-time-custom  returns character
      256   (input p-prefix as character
      257   ,input p-date-format as character
      258   ,input p-delimiter as character
      259   ,input p-time-format as character
      260   ,input p-suffix as character
      261   )
      262   :
      263     define variable v-date as date      no-undo .
      264     define variable v-time as integer   no-undo .
      265     run cur-time in this-procedure
      266       (output v-date
      267       ,output v-time
      268       ) .
      269     return
      270       p-prefix
      271       + string(v-date, p-date-format)
      272       + p-delimiter
      273       + string(v-time, p-time-format)
      274       + p-suffix
      275       .
      276   end.
      277   function cur-time-print  returns character
      278   :
      279     define variable v-date as date      no-undo .
      280     define variable v-time as integer   no-undo .
      281     run cur-time in this-procedure
      282       (output v-date
      283       ,output v-time
      284       ) .
      285     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      286   end.
      287   function cur-time-datetime returns datetime
      288   :
      289     define variable v-char as character no-undo .
      290     define variable v-datetime as datetime no-undo .
      291     v-char = cur-time-string().
      292     v-datetime = datetime(v-char).
      293     return  v-datetime.
      294   end.
      295   function cur-time-string-msec returns character
      296   :
      297     define variable v-date as datetime  no-undo .
      298     v-date = now.
      299     return string(v-date) .
      300   end.
      301   define variable vss-include-info2 as character format "X(65)" no-undo
      302   initial "@(#)$Workfile$ $Revision$".
      303   procedure xmlchar-test :
      304   define input parameter p-in-string          as character        no-undo.
      305   define output parameter p-out-string-enc    as character        no-undo.
      306   define output parameter p-out-string-dec    as character        no-undo.
      307   do
      308   on error undo, return error
      309   :
      310          run xmlchar-encode in this-procedure
      311       (
      312             input p-in-string
      313           , output p-out-string-enc
      314       ).
      315          run xmlchar-decode in this-procedure
      316       (
      317             input p-out-string-enc
      318           , output p-out-string-dec
      319       ).
      320   end.
      321   end .
      322   procedure xmlchar-encode :
      323   define input parameter p-in-string      as character        no-undo.
      324   define output parameter p-out-string    as character        no-undo.
      325       define variable v-position      as integer      no-undo.
      326       define variable v-current-char  as character    no-undo.
      327   do
      328   on error undo, return error
      329   :
      330       assign
      331           p-out-string = "":U
      332       .
      333       case p-in-string
      334       :
      335           when ?
      336           then do:
      337               assign
      338                   p-out-string = "?":U
      339               .
      340           end.
      341           when "?":U
      342           then do:
      343               assign
      344                   p-out-string = "&#63;":U
      345               .
      346           end.
      347           otherwise do:
      348               do v-position = 1 to length( p-in-string )
      349               :
      350                   assign
      351                       v-current-char = substring( p-in-string, v-position, 1 )
      352                   .
      353                   case v-current-char
      354                   :
      355                       when "&":U
      356                       then do:
      357                           assign
      358                               p-out-string = p-out-string + "&amp;":U
      359                           .
      360                       end.
      361                       when ">":U
      362                       then do:
      363                           assign
      364                               p-out-string = p-out-string + "&gt;":U
      365                           .
      366                       end.
      367                       when "<":U
      368                       then do:
      369                           assign
      370                               p-out-string = p-out-string + "&lt;":U
      371                           .
      372                       end.
      373                       when "'":U
      374                       then do:
      375                           assign
      376                               p-out-string = p-out-string + "&apos;":U
      377                           .
      378                       end.
      379                       when '"':U
      380                       then do:
      381                           assign
      382                               p-out-string = p-out-string + "&quot;":U
      383                           .
      384                       end.
      385                       when chr(1)
      386                       then do:
      387                           assign
      388                               p-out-string = p-out-string + "":U
      389                           .
      390                       end.
      391                       when chr(2)
      392                       then do:
      393                           assign
      394                               p-out-string = p-out-string + "":U
      395                           .
      396                       end.
      397                       when chr(3)
      398                       then do:
      399                           assign
      400                               p-out-string = p-out-string + "":U
      401                           .
      402                       end.
      403                       when chr(4)
      404                       then do:
      405                           assign
      406                               p-out-string = p-out-string + "":U
      407                           .
      408                       end.
      409                       when chr(5)
      410                       then do:
      411                           assign
      412                               p-out-string = p-out-string + "":U
      413                           .
      414                       end.
      415                       when chr(6)
      416                       then do:
      417                           assign
      418                               p-out-string = p-out-string + "":U
      419                           .
      420                       end.
      421                       when chr(7)
      422                       then do:
      423                           assign
      424                               p-out-string = p-out-string + "":U
      425                           .
      426                       end.
      427                       when chr(8)
      428                       then do:
      429                           assign
      430                               p-out-string = p-out-string + "":U
      431                           .
      432                       end.
      433                       when chr(9)
      434                       then do:
      435                           assign
      436                               p-out-string = p-out-string + "":U
      437                           .
      438                       end.
      439                       when chr(29)
      440                       then do:
      441                           assign
      442                               p-out-string = p-out-string + "":U
      443                           .
      444                       end.
      445                       when chr(10)
      446                       then do:
      447                           assign
      448                               p-out-string = p-out-string + "&#10;":U
      449                           .
      450                       end.
      451                       when chr(13)
      452                       then do:
      453                           assign
      454                               p-out-string = p-out-string + "&#13;":U
      455                           .
      456                       end.
      457                       otherwise do:
      458                           assign
      459                               p-out-string = p-out-string + v-current-char
      460                           .
      461                       end.
      462                   end case.
      463               end.
      464           end.
      465       end case.
      466   end.
      467   end .
      468   procedure xmlchar-encode-1c :
      469   define input parameter p-in-string      as character        no-undo.
      470   define output parameter p-out-string    as character        no-undo.
