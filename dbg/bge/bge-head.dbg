      578   procedure xmlchar-decode :
      579   define input parameter p-in-string      as character        no-undo.
      580   define output parameter p-out-string    as character        no-undo.
      581       define variable v-position      as integer      no-undo.
      582       define variable v-last-position as integer      no-undo.
      583       define variable v-temp-integer  as integer      no-undo.
      584       define variable v-current-char  as character    no-undo.
      585       define variable v-next-char     as character    no-undo.
      586       define variable v-success       as logical      no-undo.
      587   do
      588   on error undo, return error
      589   :
      590       assign
      591           p-out-string = "":U
      592           v-position   = 0
      593       .
      594       replace-cycle:
      595       do while yes
      596       on error undo, return error
      597       :
      598           assign
      599               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      600           .
      601           if v-last-position <= v-position
      602           then do:
      603               if v-position = 0
      604               then do:
      605                   assign
      606                       p-out-string = p-in-string
      607                   .
      608               end.
      609               else do:
      610                   assign
      611                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      612                   .
      613               end.
      614               leave replace-cycle.
      615           end.
      616           else do:
      617               assign
      618                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      619                   v-position      = v-last-position
      620                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      621               .
      622               if v-current-char = "#":U
      623               then do:
      624                   assign
      625                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      626                   .
      627                   if v-last-position > 0
      628                   then do:
      629                       run xmlchar-read-integer in this-procedure
      630                        (
      631                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      632                           , output v-temp-integer
      633                           , output v-success
      634                       ).
      635                       if v-success = yes
      636                       and v-temp-integer >= 1
      637                       and v-temp-integer <= 255
      638                       then do:
      639                           assign
      640                               p-out-string = p-out-string + chr( v-temp-integer )
      641                               v-position   = v-last-position + 1
      642                           .
      643                       end.
      644                       else do:
      645                           assign
      646                               p-out-string = p-out-string + "&":U
      647                               v-position   = v-position   + 1
      648                           .
      649                       end.
      650                   end.
      651                   else do:
      652                       assign
      653                           p-out-string = p-out-string + "&":U
      654                           v-position   = v-position   + 1
      655                       .
      656                   end.
      657               end.
      658               else do:
      659                   case substring( p-in-string, v-position + 1, 3 )
      660                   :
      661                       when "lt;":U
      662                       then do:
      663                           assign
      664                               p-out-string = p-out-string + "<":U
      665                               v-position   = v-position   + 3
      666                           .
      667                       end.
      668                       when "gt;":U
      669                       then do:
      670                           assign
      671                               p-out-string = p-out-string + ">":U
      672                               v-position   = v-position   + 3
      673                           .
      674                       end.
      675                       otherwise do:
      676                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      677                           then do:
      678                               assign
      679                                   p-out-string = p-out-string + "&":U
      680                                   v-position   = v-position   + 4
      681                               .
      682                           end.
      683                           else do:
      684                               case substring( p-in-string, v-position + 1, 5 )
      685                               :
      686                                   when "quot;":U
      687                                   then do:
      688                                       assign
      689                                           p-out-string = p-out-string + '"':U
      690                                           v-position   = v-position   + 5
      691                                       .
      692                                   end.
      693                                   when "apos;":U
      694                                   then do:
      695                                       assign
      696                                           p-out-string = p-out-string + "'":U
      697                                           v-position   = v-position   + 5
      698                                       .
      699                                   end.
      700                                   otherwise do:
      701                                       assign
      702                                           p-out-string = p-out-string + "&":U
      703                                       .
      704                                   end.
      705                               end case.
      706                           end.
      707                       end.
      708                   end case.
      709               end.
      710           end.
      711       end.
      712   end.
      713   end .
      714   procedure xmlchar-read-integer :
      715   define input parameter p-input-string      as character        no-undo.
      716   define output parameter p-output-integer   as integer          no-undo.
      717   define output parameter p-success       as logical          no-undo.
      718   do
      719   on error undo, return error
      720   :
      721       assign
      722           p-output-integer = integer( p-input-string )
      723       no-error.
      724       if error-status :error
      725       then do:
      726           assign
      727               p-success           = no
      728               p-output-integer    = 0
      729           .
      730       end.
      731       else do:
      732           assign
      733               p-success           = yes
      734           .
      735       end.
      736   end.
      737   end.
      738   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      739   procedure strtdate :
      740     define input  parameter p-str         as character no-undo .
      741     define output parameter p-value       as date      no-undo .
      742     define output parameter p-data-valid  as logical   no-undo .
      743     define output parameter p-message     as character no-undo .
      744   do
      745   on error undo, return error return-value
      746   :
      747     define variable v-value       as date      no-undo .
      748     define variable v-i           as integer   no-undo .
      749     define variable v-num         as integer   no-undo .
      750     define variable v-delim       as character no-undo .
      751     define variable v-delim-list  as character no-undo .
      752     define variable v-day         as integer   no-undo .
      753     define variable v-month       as integer   no-undo .
      754     define variable v-year        as integer   no-undo .
      755     define variable v-day-str     as character no-undo .
      756     define variable v-month-str   as character no-undo .
      757     define variable v-year-str    as character no-undo .
      758     assign
      759       p-value       = ?
      760       p-data-valid  = false
      761     .
      762     if p-str = ?
      763     then do:
      764       assign
      765         p-message = substitute("Ошибка задания входных параметров. Не задана строка для преобразования. " )
      766       .
      767       return .
      768     end.
      769     if p-str = ""
      770     then do:
      771       assign
      772         p-message = substitute("Ошибка задания входных параметров. Задана пустая строка для преобразования. " )
      773       .
      774       return .
      775     end.
      776     if length(p-str)  > 10
      777     then do:
      778       assign
      779         p-message = substitute("Ошибка при преобразовании к дате. Неверная длина строки. " )
      780       .
      781       return .
      782     end.
      783     assign
      784       v-delim-list = '/,-,.':U
      785     .
      786     _delim:
      787     do v-i = 1 to num-entries( v-delim-list )
      788     :
      789       assign
      790         v-delim = entry( v-i , v-delim-list )
      791         v-num   = num-entries( p-str , v-delim )
      792       .
      793       if v-num <> 3
      794       then do:
      795         assign
      796           v-delim = ''
      797         .
      798       end.
      799       else do:
      800         leave _delim.
      801       end.
      802     end.
      803     if v-delim = ''
      804     then do:
      805       assign
      806         p-message = substitute( "Ошибка при преобразовании к дате. Неправильный разделитель, либо ошибочное количество разделителей. " )
      807       .
      808       return .
      809     end.
      810     assign
      811       v-day-str   = entry( 1, p-str , v-delim)
      812       v-month-str = entry( 2, p-str , v-delim)
      813       v-year-str  = entry( 3, p-str , v-delim)
      814     .
      815     if  length(v-day-str) > 2   or
      816         length(v-day-str) < 1   or
      817         length(v-month-str) > 2 or
      818         length(v-month-str) < 1 or
      819         (
      820           length(v-year-str) <> 2 and
      821           length(v-year-str) <> 4
      822         )
      823     then do:
      824       assign
      825         p-message = substitute("Ошибка при преобразовании к дате. Неправильное количество символов числа, месяца, либо года. " )
      826       .
      827       return .
      828     end.
      829     if length( v-year-str ) = 2
      830     then do:
      831       assign
      832         v-year-str = substring( string( year(today) ), 1 , 2 ) + v-year-str
      833       .
      834     end.
      835     assign
      836       v-day   = integer( v-day-str )
      837       v-month = integer( v-month-str)
      838       v-year  = integer( v-year-str)
      839     no-error .
      840     if error-status :error
      841     then do:
      842       assign
      843         p-message = substitute("Ошибка при преобразовании к дате. Неверный формат символов числа, месяца, либо года. " )
      844       .
      845       return .
      846     end.
      847     if v-day < 1  or
      848        v-day > 31 or
      849        v-month < 1 or
      850        v-month > 12 or
      851        v-year < 0   or
      852        v-year > 5000
      853     then do:
      854       assign
      855         p-message = substitute("Ошибка при преобразовании к дате. Неверный диапозон числа, месяца, года. " )
      856       .
      857       return .
      858     end.
      859     assign
      860       v-value = date( v-month, v-day, v-year )
      861     no-error .
      862     if error-status :error
      863     then do:
      864       assign
      865         p-message = substitute("Ошибка при преобразовании к дате. &1. " , error-status :get-message(1))
      866       .
      867       return .
      868     end.
      869     assign
      870       p-value       = v-value
      871       p-data-valid  = true
      872     .
      873   end.
      874   end procedure.
