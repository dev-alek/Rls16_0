      975   FUNCTION w-XMLPutParamInTag RETURNS CHAR (INPUT sParName AS CHAR, INPUT sToPlace AS CHAR,
      976                                             INPUT iFlagEmpty AS INTEGER).
      977       DEF VAR sOut AS CHAR FORMAT "X(255)" NO-UNDO.
      978       IF sToPlace = "" OR sToPlace = ? OR sToPlace = "0" THEN
      979           DO:
      980               IF iFlagEmpty = 0                           THEN RETURN "".
      981               ELSE IF iFlagEmpty = 1                      THEN RETURN sParName + "=&#034;&#034;".
      982               ELSE IF iFlagEmpty = 2 AND sToPlace = "0"   THEN RETURN sParName + "=&#034;0&#034;".
      983               ELSE IF iFlagEmpty = 3 AND sToPlace = ""    THEN RETURN sParName + "=&#034;&#034;".
      984               ELSE RETURN "".
      985           END.
      986       ELSE DO:
      987           run xmlchar-encode in this-procedure (
      988                 input sToPlace
      989               , output sToPlace
      990           ).
      991           ASSIGN
      992               sToPlace = sParName + '="' + sToPlace + '"'
      993           .
      994           RETURN sToPlace.
      995       END.
      996   END FUNCTION.
      997   function bge-xml-date returns character
      998   ( input p-date as date )
      999   :
     1000     define variable v-date-str as character no-undo .
     1001     run bge-xml-date-to-str in this-procedure ( input   p-date
     1002                                               , output  v-date-str
     1003                                               ) .
     1004     return v-date-str.
     1005   end function.
     1006   function bge-xml-str-date returns character
     1007   ( input p-date-str as character )
     1008   :
     1009     define variable v-date-str as character no-undo .
     1010     run bge-xml-date-str-to-str in this-procedure ( input   p-date-str
     1011                                                   , output  v-date-str
     1012                                                   ) .
     1013     return v-date-str.
     1014   end function.
     1015   function bge-xml-normalize-dec returns decimal
     1016   ( input p-val as decimal )
     1017   :
     1018     return (if p-val = ? then 0 else p-val) .
     1019   end function.
     1020   PROCEDURE wp-XMLTagOpen:
     1021   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1022   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1023   DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1024       define variable v-out-string    as character    no-undo.
     1025   do
     1026   on error undo, return error
     1027   :
     1028       if v-bge-xml-bgefmt = "dbf":U
     1029       then do:
     1030       end.
     1031       else do:
     1032           assign
     1033               v-out-string = substitute( "&1&2<&3&4>"
     1034                                       , chr(10)
     1035                                       , fill( " ":U, 4 * iTagLevel)
     1036                                       , sTagName
     1037                                       , ( if sParValue = "":U or sParValue = ? then "":U else " " + sParValue )
     1038                               )
     1039           .
     1040           put stream stmXMLOut unformatted
     1041               v-out-string
     1042           .
     1043       end.
     1044   end.
     1045   END PROCEDURE.
     1046   PROCEDURE wp-XMLTagPut:
     1047     DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1048     DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1049     DEF INPUT PARAM sParValue AS CHAR NO-UNDO.
     1050     DEF INPUT PARAM iFlagEmpty AS INTEGER NO-UNDO.
     1051       define variable v-out-string    as character    no-undo.
     1052   do
     1053   on error undo, return error
     1054   :
     1055       if v-bge-xml-bgefmt = "dbf":U
     1056       then do:
     1057           if v-bge-xml-dbf-file-name <> "":U
     1058           then do:
     1059               output stream stmXMLOut to value( v-bge-xml-dbf-file-name ) append.
     1060               export stream stmXMLOut
     1061                   sTagName
     1062                   sParValue
     1063               .
     1064               output stream stmXMLOut close.
     1065           end.
     1066       end.
     1067       else do:
     1068           IF  iFlagEmpty = 1
     1069           OR (iFlagEmpty = 0 AND (sParValue <> "" AND sParValue <> ?) )
     1070           OR (iFlagEmpty = 2 AND (sParValue <> "" AND sParValue <> ? AND sParValue <> "0"))
     1071           OR (iFlagEmpty = 3 AND (sParValue <> "" AND sParValue <> ? AND CAPS(sParValue) <> "NO"))
     1072           THEN DO:
     1073               run xmlchar-encode in this-procedure (
     1074                   input sParValue
     1075                   , output sParValue
     1076               ).
     1077               assign
     1078                   v-out-string = substitute( "&1&2<&3>&4</&3>"
     1079                                               , chr(10)
     1080                                               , FILL(" ", 4 * iTagLevel)
     1081                                               , sTagName
     1082                                               , sParValue
     1083                               )
     1084               .
     1085               PUT STREAM stmXMLOut UNFORMATTED
     1086                   v-out-string
     1087               .
     1088           END.
     1089       end.
     1090   end.
     1091   END PROCEDURE.
     1092   PROCEDURE wp-XMLTagClose:
     1093   DEF INPUT PARAM iTagLevel AS INTEGER NO-UNDO.
     1094   DEF INPUT PARAM sTagName AS CHAR NO-UNDO.
     1095       define variable v-out-string    as character    no-undo.
     1096   do
     1097   on error undo, return error
     1098   :
     1099       if v-bge-xml-bgefmt = "dbf":U
     1100       then do:
     1101       end.
     1102       else do:
     1103           assign
     1104               v-out-string = substitute( "&1&2</&3>"
     1105                                   , ( if iTagLevel=0 then "":U else chr(10) )
     1106                                   , fill( " ", 4 * iTagLevel )
     1107                                   , sTagName
     1108                           )
     1109           .
     1110           PUT STREAM stmXMLOut UNFORMATTED
     1111               v-out-string
     1112           .
     1113       end.
     1114   end.
     1115   END PROCEDURE.
     1116   PROCEDURE wp-XMLWriteLog:
     1117     DEF INPUT PARAMETER sFileName AS CHAR     NO-UNDO.
     1118     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1119     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1120   define variable v-str              as character no-undo .
     1121   define variable v-error-append     as logical   no-undo .
     1122   define variable v-error-append-msg as character no-undo .
     1123   assign
     1124     v-str = chr(10)
     1125             + (if (iLogLevel = 0 or sToWrite = "&DLine" or sToWrite = "&Line") then "" else cur-time-string-sec() + " ")
     1126             + (if sToWrite = "&Line" then fill("-", 80) else if sToWrite = "&DLine" then fill("=", 80) else sToWrite)
     1127     v-str = replace(v-str, (chr(10) + chr(13)), chr(10) )
     1128     v-str = replace(v-str, (chr(13) + chr(10)), chr(10) )
     1129     v-str = replace(v-str, chr(10), (chr(13) + chr(10)) )
     1130   .
     1131   run bge/bge-log.p (input v-str) no-error .
     1132   if error-status:error then do:
     1133     assign
     1134       v-error-append     = yes
     1135       v-error-append-msg = return-value
     1136     .
     1137   end.
     1138   run gbl/fileapnd.p
     1139     ( input sFileName
     1140     , input v-str
     1141     , input 10
     1142     ) no-error .
     1143   if error-status:error then do:
     1144     assign
     1145       v-error-append     = yes
     1146       v-error-append-msg = substitute( "&1&2&3"
     1147                                       , v-error-append-msg
     1148                                       , chr(10)
     1149                                       , return-value
     1150                                       )
     1151     .
     1152   end.
     1153   if v-error-append
     1154   then do:
     1155     return error substitute( "&1" , v-error-append-msg ) .
     1156   end.
     1157   END PROCEDURE.
     1158   PROCEDURE wp-XMLWriteEDT:
     1159     DEF INPUT PARAMETER hEDT AS HANDLE NO-UNDO.
     1160     DEF INPUT PARAMETER iLogLevel AS INTEGER  NO-UNDO.
     1161     DEF INPUT PARAMETER sToWrite  AS CHAR     NO-UNDO.
     1162       if valid-handle ( hEDT )
     1163       then do:
     1164           hEDT :move-to-eof().
     1165           hEDT :insert-string(IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1166                                           OR sToWrite = "&Line") THEN "" ELSE
     1167                                           cur-time-string-sec() + " ").
     1168           hEDT :insert-string(IF sToWrite = "&Line" THEN FILL("-", 80)
     1169                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1170                   ELSE FILL(" ", iLogLevel) + sToWrite).
     1171           hEDT :insert-string(chr(10)).
     1172       end.
     1173       process events.
     1174       output to 'bgescn.txt' append.
     1175           put unformatted
     1176               chr(10) string( (IF (iLogLevel = 0 OR sToWrite = "&DLine"
     1177                                           OR sToWrite = "&Line") THEN "" ELSE
     1178                                           STRING(TODAY) + " " + STRING(TIME, "hh:mm:ss") + " ") )
     1179               string( (IF sToWrite = "&Line" THEN FILL("-", 80)
     1180                   ELSE IF sToWrite = "&DLine" THEN FILL("=", 80)
     1181                   ELSE FILL(" ", iLogLevel) + sToWrite) )
     1182           .
     1183       output close.
     1184   END PROCEDURE.
     1185   PROCEDURE wp-XMLShowCNT:
     1186     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1187       if valid-handle( hCNT )
     1188       then do:
     1189           ASSIGN hCNT :VISIBLE = TRUE.
     1190       end.
     1191   END PROCEDURE.
     1192   PROCEDURE wp-XMLHideCNT:
     1193     DEF INPUT PARAMETER hCNT     AS HANDLE   NO-UNDO.
     1194       if valid-handle( hCNT )
     1195       then do:
     1196           ASSIGN hCNT :VISIBLE = FALSE.
     1197       end.
     1198   END PROCEDURE.
     1199   PROCEDURE wp-XMLWriteCNT:
     1200     DEF INPUT PARAMETER hCNT     AS HANDLE  NO-UNDO.
     1201     DEF INPUT PARAMETER sCounter AS CHAR    NO-UNDO.
     1202       if valid-handle( hCNT )
     1203       then do:
     1204           ASSIGN hCNT :SCREEN-VALUE = sCounter.
     1205       end.
     1206   END PROCEDURE.
     1207   procedure bge-xml-write-header:
     1208   do
     1209   on error undo, return error
     1210   :
     1211   define input parameter p-xml-file-name  as character        no-undo.
     1212   define input parameter p-doc-name       as character        no-undo.
     1213   define input parameter p-version        as character        no-undo.
     1214   define input parameter p-db-num         as integer          no-undo.
     1215   define input parameter p-date-from      as date             no-undo.
     1216   define input parameter p-shift-num-from as integer          no-undo.
     1217   define input parameter p-date-to        as date             no-undo.
     1218   define input parameter p-shift-num-to   as integer          no-undo.
     1219   define input parameter p-obj-list       as character        no-undo.
     1220   define input parameter p-doc-type-list  as character        no-undo.
     1221   define input parameter p-pay-code       as logical          no-undo.
     1222   define input parameter p-cst            as logical          no-undo.
     1223   define input parameter p-parts          as logical          no-undo.
     1224   define input parameter p-chk-pay-code   as logical          no-undo.
     1225   define input parameter p-pay-desk       as logical          no-undo.
     1226   define input parameter p-pay-desk-cards as logical          no-undo.
     1227   define input parameter p-deleted        as logical          no-undo.
     1228   define input parameter p-opened-docs    as logical          no-undo.
     1229   define variable v-out-string    as character    no-undo.
     1230   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251".
     1231   assign
     1232       v-out-string = substitute( "&1&2&3"
     1233                           , "<?xml version='1.0' encoding='windows-1251'?>":U
     1234                           , chr(10)
     1235                           , "<IBS_Trade_House>":U )
     1236   .
     1237   put stream stmXMLOut unformatted
     1238       v-out-string
     1239   .
     1240   run wp-XMLTagOpen(1, "header","").
     1241   if v-bge-xml-bgeflold = "oracle":u
     1242   then do:
     1243     run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1244     run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1245     run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1246     run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1247     run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1248   end.
     1249   run wp-XMLTagOpen( 2, "manifest", "").
     1250   run wp-XMLTagOpen( 3, "document", "").
     1251   run wp-XMLTagput( 4, "name", p-doc-name, 0).
     1252   run wp-XMLTagput( 4, "description", "", 0).
     1253   run wp-XMLTagput( 4, "version", p-version, 0).
     1254   run wp-XMLTagclose( 3, "document" ).
     1255   run wp-XMLTagclose( 2, "manifest" ).
     1256   run wp-XMLTagclose( 1, "header" ).
     1257   run wp-XMLTagOpen(1, "options","").
     1258   run wp-XMLTagput( 2, "exportDate",      string( today,              "99/99/9999" ), 0).
     1259   run wp-XMLTagput( 2, "exportDateXml",   bge-xml-date( today )                     , 0).
     1260   run wp-XMLTagput( 2, "exportTime",      string( time,               "HH:MM:SS"   ), 0).
     1261   run wp-XMLTagput( 2, "baseNum",         string( p-db-num                         ), 0).
     1262   run wp-XMLTagput( 2, "dateFrom",        string( p-date-from,        "99/99/9999" ), 0).
     1263   run wp-XMLTagput( 2, "dateFromXml",     bge-xml-date( p-date-from )               , 0).
     1264   run wp-XMLTagput( 2, "shiftNumFrom",    string( p-shift-num-from                 ), 2).
     1265   run wp-XMLTagput( 2, "dateTo",          string( p-date-to,          "99/99/9999" ), 0).
     1266   run wp-XMLTagput( 2, "dateToXml",       bge-xml-date( p-date-to )                 , 0).
     1267   run wp-XMLTagput( 2, "shiftNumTo",      string( p-shift-num-to                   ), 2).
     1268   run wp-XMLTagput( 2, "objList",                 p-obj-list                        , 0).
     1269   run wp-XMLTagput( 2, "docTypeList",             p-doc-type-list                   , 0).
     1270   run wp-XMLTagput( 2, "payCode",         string( p-pay-code                       ), 0).
     1271   run wp-XMLTagput( 2, "cst",             string( p-cst                            ), 0).
     1272   run wp-XMLTagput( 2, "parts",           string( p-parts                          ), 0).
     1273   run wp-XMLTagput( 2, "chkPayCode",      string( p-chk-pay-code                   ), 0).
     1274   run wp-XMLTagput( 2, "chkPayDesk",      string( p-pay-desk                       ), 0).
     1275   run wp-XMLTagput( 2, "chkPayDeskCards", string( p-pay-desk-cards                 ), 0).
     1276   run wp-XMLTagput( 2, "deletedDocs",     string( p-deleted                        ), 0).
     1277   run wp-XMLTagput( 2, "openedDocs",      string( p-opened-docs                    ), 0).
     1278   run wp-XMLTagClose(1, "options").
     1279   run wp-XMLTagOpen( 1, "body", "" ).
     1280   output stream stmXMLOut close.
     1281   end.
     1282   end procedure.
     1283   procedure xml-bge-write-footer:
     1284   do
     1285   on error undo, return error return-value
     1286   :
     1287   define input parameter p-xml-file-name as character    no-undo.
     1288   define variable v-error-num     as integer           no-undo.
     1289   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1290   run wp-XMLTagClose( 1, "body" ).
     1291   run wp-XMLTagClose( 0, "IBS_Trade_House" ).
     1292   output stream stmXMLOut close.
     1293   if v-bge-xml-bgeflold = "oracle":u
     1294   then do:
     1295     define variable v-tmp-file-name         as character no-undo .
     1296     define variable v-zip-file-name         as character no-undo .
     1297     define variable v-exch-file-name        as character no-undo .
     1298     define variable v-heap-file-name        as character no-undo .
     1299     define variable v-i                     as integer   no-undo .
     1300     define variable v-file-name             as character no-undo .
     1301     define variable v-arc                   as character no-undo .
     1302     define variable v-str                   as character no-undo .
     1303     define variable v-exch-tmp-file-name    as character no-undo .
     1304     define variable v-bge-xml-tmp-exch-dir  as character no-undo .
     1305     define variable v-bge-xml-exch-dir      as character no-undo .
     1306     define variable v-bge-xml-heap-dir      as character no-undo .
     1307     define variable v-bge-xml-compress-heap as logical   no-undo .
     1308     define variable v-home-dir              as character no-undo .
     1309     define variable v-os-command            as character no-undo .
     1310     get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1311     if v-home-dir = ?
     1312     then do:
     1313       undo, return error substitute( "&1&2&3"
     1314                                     , "Не найден параметр ini-файла, определяющий каталог экспорта.":u
     1315                                     , chr(10)
     1316                                     , "Обратитесь к администратору.":u
     1317                                     ).
     1318     end.
     1319     assign
     1320       v-home-dir = v-home-dir
     1321     .
     1322     run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1323     if error-status :error
     1324     then do:
     1325       undo, return error substitute( "&1&2&3"
     1326                                     , "Неверно задан каталог экспорта.":u
     1327                                     , chr(10)
     1328                                     , "Обратитесь к администратору.":u
     1329                                     ).
     1330     end.
     1331     get-key-value section "BGE" key "dir-exch" value v-bge-xml-exch-dir .
     1332     if v-bge-xml-exch-dir = ?
     1333     then do:
     1334       undo, return error substitute( "&1&2&3"
     1335                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (exch).":u
     1336                                     , chr(10)
     1337                                     , "Обратитесь к администратору.":u
     1338                                     ).
     1339     end.
     1340     run gbl/dir-cre.p ( input v-bge-xml-exch-dir ) no-error.
     1341     if error-status :error
     1342     then do:
     1343       undo, return error substitute( "&1&2&3"
     1344                                     , "Неверно задан каталог экспорта (exch).":u
     1345                                     , chr(10)
     1346                                     , "Обратитесь к администратору.":u
     1347                                     ).
     1348     end.
     1349     get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1350     if v-bge-xml-heap-dir = ?
     1351     then do:
     1352       undo, return error substitute( "&1&2&3"
     1353                                     , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1354                                     , chr(10)
     1355                                     , "Обратитесь к администратору.":u
     1356                                     ).
     1357     end.
     1358     run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1359     if error-status :error
     1360     then do:
     1361       undo, return error substitute( "&1&2&3"
     1362                                     , "Неверно задан каталог экспорта (heap).":u
     1363                                     , chr(10)
     1364                                     , "Обратитесь к администратору.":u
     1365                                     ).
     1366     end.
     1367     get-key-value section "BGE" key "heap-compress" value v-str.
     1368     assign
     1369       v-i = int(v-str)
     1370     no-error .
     1371     if v-i = ? or v-i = 0
     1372     then do:
     1373       assign
     1374         v-bge-xml-compress-heap = no
     1375       .
     1376     end.
     1377     else do:
     1378       assign
     1379         v-bge-xml-compress-heap = yes
     1380       .
     1381     end.
     1382     assign
     1383       v-arc = search( "exe/7za.exe":u )
     1384     .
     1385     if v-arc = ? or v-arc = ""
     1386     then do:
     1387       undo, return error("Не найдена программа 7za.exe, невозможно упаковать файлы в архив.":u).
     1388     end.
     1389     assign
     1390       v-file-name            = entry(num-entries( p-xml-file-name , chr(47) ) , p-xml-file-name , chr(47) )
     1391       v-tmp-file-name        = session :temp-directory + v-file-name + "DAT":u
     1392       v-zip-file-name        = session :temp-directory + v-file-name + "DAT.zip":u
     1393       v-bge-xml-tmp-exch-dir = v-bge-xml-exch-dir + ".000"
     1394       v-exch-tmp-file-name   = v-bge-xml-tmp-exch-dir + chr(47) + v-file-name + "tmp":u
     1395       v-exch-file-name       = v-bge-xml-exch-dir + chr(47) + v-file-name + "DAT.zip":u
     1396       v-heap-file-name       = v-bge-xml-heap-dir + chr(47) + v-file-name + "DAT":u
     1397     .
     1398     run gbl/del-file.p (input v-tmp-file-name) .
     1399     run gbl/del-file.p (input v-zip-file-name) .
     1400     run bge/os_copy.p ("M", p-xml-file-name + "xm1":u, v-tmp-file-name, output v-error-num ).
     1401     if v-error-num > 0
     1402     then do:
     1403         undo, return error substitute( "Ошибка переноса из &1 в &2. Код ошибки: &3"
     1404                                      , p-xml-file-name + "xm1":u
     1405                                      , v-tmp-file-name
     1406                                      , v-error-num
     1407                                      ).
     1408     end.
     1409     assign
     1410       v-os-command     = substitute( "&1 a -tzip &2 &3"
     1411                                    , v-arc
     1412                                    , v-zip-file-name
     1413                                    , v-tmp-file-name
     1414                                    )
     1415     .
     1416     os-command silent value ( v-os-command ) .
     1417     run gbl/del-file.p (input v-heap-file-name) .
     1418     if v-bge-xml-compress-heap = no
     1419     then do:
     1420       run bge/os_copy.p ("C", v-tmp-file-name, v-heap-file-name, output v-error-num ).
     1421       if v-error-num > 0
     1422       then do:
     1423           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1424                                        , v-tmp-file-name
     1425                                        , v-heap-file-name
     1426                                        , v-error-num
     1427                                        ) .
     1428       end.
     1429     end.
     1430     else do:
     1431       run bge/os_copy.p ("C", v-zip-file-name, v-heap-file-name + ".zip", output v-error-num ).
     1432       if v-error-num > 0
     1433       then do:
     1434           undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1435                                        , v-zip-file-name
     1436                                        , v-heap-file-name
     1437                                        , v-error-num
     1438                                        ) .
     1439       end.
     1440     end.
     1441     run gbl/del-file.p (input v-tmp-file-name) .
     1442     run gbl/dir-cre.p ( input v-bge-xml-tmp-exch-dir ) no-error.
     1443     if error-status :error then do:
     1444       undo, return error substitute( "&1&2&3"
     1445                                     , substitute( "Не удалось создать каталог &1.", v-bge-xml-tmp-exch-dir )
     1446                                     , chr(10)
     1447                                     , "Обратитесь к администратору."
     1448                                     ).
     1449     end.
     1450     run gbl/del-file.p (input v-exch-file-name) .
     1451     run gbl/del-file.p (input v-exch-tmp-file-name ) .
     1452     run bge/os_copy.p ("M", v-zip-file-name, v-exch-tmp-file-name, output v-error-num ).
     1453     if v-error-num > 0
     1454     then do:
     1455       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1456                                     , v-zip-file-name
     1457                                     , v-exch-tmp-file-name
     1458                                     , v-error-num
     1459                                     ) .
     1460     end.
     1461     run bge/os_copy.p ("M", v-exch-tmp-file-name, v-exch-file-name , output v-error-num ).
     1462     if v-error-num > 0
     1463     then do:
     1464       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1465                                     , v-exch-tmp-file-name
     1466                                     , v-exch-file-name
     1467                                     , v-error-num
     1468                                     ) .
     1469     end.
     1470     run gbl/del-file.p (input v-bge-xml-tmp-exch-dir ) .
     1471   end.
     1472   else do:
     1473     run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1474     if v-error-num > 0
     1475     then do:
     1476       undo, return error substitute( "Ошибка копирования из &1 в &2. Код ошибки: &3"
     1477                                     , p-xml-file-name + "xm1"
     1478                                     , p-xml-file-name + "xml"
     1479                                     , v-error-num
     1480                                     ) .
     1481     end.
     1482   end.
     1483   if opsys = "unix"
     1484   then do:
     1485       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1486   end.
     1487   end.
     1488   end procedure.
     1489   procedure xml-bge-filename0:
     1490   define input parameter p-prefix   as character no-undo .
     1491   define input parameter p-name     as character no-undo .
     1492   define input parameter p-shared-process as logical no-undo .
     1493   define input parameter p-home-dir as character no-undo . // из ini-параметра [BGE] Dirfrg-acc
     1494   define output parameter p-xml-file-name  as character no-undo .
     1495   // define output parameter p-fullfnamenoext as character no-undo .
     1496   define output parameter p-locked         as logical      no-undo.
     1497   define variable v-fullfnamenoext as character no-undo .
     1498   define variable v-fileext        as character no-undo .
     1499   define variable v-fullfname      as character no-undo .
     1500   define variable v-error-num      as integer   no-undo .
     1501   do
     1502   on error undo, return error
     1503   :
     1504     case v-bge-xml-bgeflold :
     1505       when "old" then do:
     1506         v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-db-num-str) .
     1507         v-fileext       = ".xml":U .
     1508         v-fullfname     = v-fullfnamenoext + v-fileext .
     1509         p-xml-file-name = v-fullfname .
     1510         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1511         if v-error-num > 0 then do:
     1512           return error.
     1513         end.
     1514       end.
     1515       when "var" then do:
     1516         case p-prefix :
     1517           when "doc" then do:
     1518             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-doc) .
     1519             v-fileext       = ".xml":U .
     1520             v-fullfname     = v-fullfnamenoext + v-fileext .
     1521             p-xml-file-name = v-fullfname .
     1522           end.
     1523           when "day" then do:
     1524             v-fullfnamenoext = substitute ("&1&2&3&4", p-home-dir, chr(47), p-name, v-bge-xml-bgeflnm-day) .
     1525             v-fileext       = ".xml":U .
     1526             v-fullfname     = v-fullfnamenoext + v-fileext .
     1527             p-xml-file-name = v-fullfname .
     1528           end.
     1529           otherwise do:
     1530             v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1531             v-fileext       = ".xml":U .
     1532             v-fullfname     = v-fullfnamenoext + v-fileext .
     1533             p-xml-file-name = v-fullfname .
     1534           end.
     1535         end case.
     1536         run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1537         if v-error-num > 0 then do:
     1538           return error.
     1539         end.
     1540       end.
     1541       when "new" then do:
     1542                   run bge/genfname.p (
     1543                       input p-home-dir
     1544                       , input p-prefix
     1545                       , input ""
     1546                       , input "xml"
     1547                       , input ""
     1548                       , output p-xml-file-name
     1549                   ).
     1550       end.
     1551       when "no-parameter" then do:
     1552         if p-shared-process then do:
     1553                       run bge/genfname.p (
     1554                           input p-home-dir
     1555                           , input "d"
     1556                           , input ""
     1557                           , input "xml"
     1558                           , input ""
     1559                           , output p-xml-file-name
     1560                       ).
     1561         end.
     1562         else do:
     1563           v-fullfnamenoext = substitute ("&1&2&3", p-home-dir, chr(47), p-name) .
     1564           v-fileext       = ".xml":U .
     1565           v-fullfname     = v-fullfnamenoext + v-fileext .
     1566           p-xml-file-name = v-fullfname .
     1567           run bge/os_copy.p ("D", p-xml-file-name, "", output v-error-num ).
     1568           if v-error-num > 0 then do:
     1569             return error.
     1570           end.
     1571         end.
     1572       end.
     1573     end case.
     1574     assign
     1575       p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1576       p-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     1577     .
     1578   end .
     1579   end procedure .
     1580   procedure xml-bge-filename :
     1581   do
     1582   on error undo, return error
     1583   :
     1584   define input parameter p-prefix             as character    no-undo.
     1585   define input parameter p-name               as character    no-undo.
     1586   define input parameter p-shared-process     as logical      no-undo.
     1587   define output parameter p-xml-file-name     as character    no-undo.
     1588   define output parameter p-log-file-name     as character    no-undo.
     1589   define output parameter p-locked            as logical      no-undo.
     1590   define variable v-home-dir          as character no-undo .
     1591   define variable v-error-num         as integer   no-undo .
     1592   define variable v-bge-xml-heap-dir  as character no-undo .
     1593       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     1594       if v-home-dir = ?
     1595       then do:
     1596           message
     1597             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1598             skip(1)
     1599             skip "Обратитесь к администратору."
     1600           view-as alert-box error.
     1601           undo, return error .
     1602       end.
     1603       if v-bge-xml-bgeflold <> "oracle"
     1604       then do:
     1605         assign
     1606             v-home-dir = v-home-dir + chr(47) + "exp-acc"
     1607         .
     1608       end.
     1609       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     1610       if error-status :error
     1611       then do:
     1612           message
     1613             skip "Неверно задан каталог экспорта."
     1614             skip(1)
     1615             skip "Обратитесь к администратору."
     1616           view-as alert-box error.
     1617           undo, return error .
     1618       end.
     1619       if v-bge-xml-bgefmt = "dbf":U
     1620       then do:
     1621           assign
     1622               p-xml-file-name = v-home-dir
     1623               p-locked        = no
     1624           .
     1625       end.
     1626       else do:
     1627           run xml-bge-filename0 in this-procedure (p-prefix, p-name, p-shared-process, v-home-dir,
     1628             output p-xml-file-name, output p-locked) .
     1629       end.
     1630       if v-bge-xml-bgeflold = "oracle"
     1631       then do:
     1632         get-key-value section "BGE" key "dir-heap" value v-bge-xml-heap-dir.
     1633         if v-bge-xml-heap-dir = ?
     1634         then do:
     1635           undo, return error substitute( "&1&2&3"
     1636                                         , "Не найден параметр ini-файла, определяющий каталог экспорта (heap).":u
     1637                                         , chr(10)
     1638                                         , "Обратитесь к администратору.":u
     1639                                         ).
     1640         end.
     1641         run gbl/dir-cre.p ( input v-bge-xml-heap-dir ) no-error.
     1642         if error-status :error
     1643         then do:
     1644           undo, return error substitute( "&1&2&3"
     1645                                         , "Неверно задан каталог экспорта (heap).":u
     1646                                         , chr(10)
     1647                                         , "Обратитесь к администратору.":u
     1648                                         ).
     1649         end.
     1650         if r-index( v-bge-xml-heap-dir, chr(47) ) > r-index( v-bge-xml-heap-dir, chr(92) ) then do:
     1651           assign
     1652             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(47) ) ) + chr(47) + "actions.log"
     1653           .
     1654         end.
     1655         else do:
     1656           assign
     1657             p-log-file-name = substring( v-bge-xml-heap-dir, 1, r-index( v-bge-xml-heap-dir, chr(92) ) ) + chr(47) + "actions.log"
     1658           .
     1659         end.
     1660       end.
     1661       else do:
     1662         assign
     1663             p-log-file-name = v-home-dir + chr(47) + "actions.log"
     1664         .
     1665       end.
     1666       assign
     1667          v-bge-xml-static-log-file-name = p-log-file-name
     1668       .
     1669   end.
     1670   end procedure.
     1671   procedure bge-xml-read-config :
     1672   do
     1673   on error undo, return error return-value
     1674   :
     1675   define input  parameter p-last-date as date      no-undo .
     1676   define input  parameter p-db-num    as integer   no-undo .
     1677       define variable v-bgeclall      as character     no-undo.
     1678       define variable v-bgedict       as character     no-undo.
     1679       define variable v-bgeshift      as character     no-undo.
     1680       define variable v-par-type      as character     no-undo.
     1681       define variable v-bgeflnm       as character     no-undo.
     1682       define variable v-bgecliiv      as character     no-undo .
     1683       define variable v-date-chars    as character case-sensitive  init "DD"      no-undo.
     1684       define variable v-month-chars   as character case-sensitive  init "MM"      no-undo.
     1685       define variable v-year-chars    as character case-sensitive  init "YY"      no-undo.
     1686       define variable v-db-num-chars  as character case-sensitive  init "BBBBB"   no-undo.
     1687       define variable v-db-num-str    as character     no-undo .
     1688       define variable v-param-type      as character  no-undo .
     1689       define variable v-value-character as character  no-undo .
     1690       define variable v-value-date      as date       no-undo .
     1691       define variable v-value-decimal   as decimal    no-undo .
     1692       define variable v-value-integer   as integer    no-undo .
     1693       define variable v-value-logical   as logical    no-undo .
     1694       define variable v-tth             as handle      no-undo .
     1695       run adm/shattri.p ( input "get":U
     1696                         , input  '':u
     1697                         , input  0
     1698                         , input  'bge-export':U
     1699                         , input  'bgeclall':U
     1700                         , output v-bgecliiv
     1701                         , output v-value-date
     1702                         , output v-value-decimal
     1703                         , output v-value-integer
     1704                         , output v-value-logical
     1705                         , output v-param-type
     1706                         , input-output table-handle v-tth
     1707                         ) no-error .
     1708       if error-status :error
     1709       then do:
     1710         assign
     1711           v-bge-xml-bgecliiv = no
     1712         .
     1713       end.
     1714       else do:
     1715         run bge-xml-fill-tt-bgecliiv in this-procedure ( input v-bgecliiv ).
     1716       end.
     1717       delete object v-tth.
     1718       assign
     1719           v-bge-xml-bgeclall = no
     1720           v-bge-xml-bgedict  = no
     1721       .
     1722       run adm/shattri.p ( input "get":U
     1723                         , input  '':u
     1724                         , input  0
     1725                         , input  'bge-export':U
     1726                         , input  'bgeclall':U
     1727                         , output v-value-character
     1728                         , output v-value-date
     1729                         , output v-value-decimal
     1730                         , output v-value-integer
     1731                         , output v-value-logical
     1732                         , output v-param-type
     1733                         , input-output table-handle v-tth
     1734                         ) no-error .
     1735       if error-status :error
     1736       then do:
     1737         assign
     1738           v-bge-xml-bgeclall = no
     1739         .
     1740       end.
     1741       else do:
     1742         assign
     1743           v-bge-xml-bgeclall = v-value-logical
     1744         .
     1745       end.
     1746       delete object v-tth.
     1747       run adm/shattri.p ( input "get":U
     1748                         , input  '':u
     1749                         , input  0
     1750                         , input  'bge-export':U
     1751                         , input  'bgedict':U
     1752                         , output v-value-character
     1753                         , output v-value-date
     1754                         , output v-value-decimal
     1755                         , output v-value-integer
     1756                         , output v-value-logical
     1757                         , output v-param-type
     1758                         , input-output table-handle v-tth
     1759                         ) no-error .
     1760       if error-status :error
     1761       then do:
     1762         assign
     1763           v-bge-xml-bgedict = no
     1764         .
     1765       end.
     1766       else do:
     1767         assign
     1768           v-bge-xml-bgedict = v-value-logical
     1769         .
     1770       end.
     1771       delete object v-tth.
     1772       run adm/shattri.p ( input "get":U
     1773                         , input  '':u
     1774                         , input  0
     1775                         , input  'bge-export':U
     1776                         , input  'bgefmt':U
     1777                         , output v-value-character
     1778                         , output v-value-date
     1779                         , output v-value-decimal
     1780                         , output v-value-integer
     1781                         , output v-value-logical
     1782                         , output v-param-type
     1783                         , input-output table-handle v-tth
     1784                         ) no-error .
     1785       if error-status :error
     1786       then do:
     1787         assign
     1788           v-bge-xml-bgefmt  = "xml":U
     1789         .
     1790       end.
     1791       else do:
     1792         assign
     1793           v-bge-xml-bgefmt  = v-value-character
     1794         .
     1795       end.
     1796       delete object v-tth.
     1797       run adm/shattri.p ( input "get":U
     1798                         , input  '':u
     1799                         , input  0
     1800                         , input  'bge-export':U
     1801                         , input  'bgeshift':U
     1802                         , output v-value-character
     1803                         , output v-value-date
     1804                         , output v-value-decimal
     1805                         , output v-value-integer
     1806                         , output v-value-logical
     1807                         , output v-param-type
     1808                         , input-output table-handle v-tth
     1809                         ) no-error .
     1810       if error-status :error
     1811       then do:
     1812         assign
     1813             v-bge-xml-shift-mode = no
     1814         .
     1815       end.
     1816       else do:
     1817         assign
     1818             v-bge-xml-shift-mode = ( v-value-character = "distinct":U )
     1819         .
     1820       end.
     1821       delete object v-tth.
     1822       run adm/shattri.p ( input "get":U
     1823                         , input  '':u
     1824                         , input  0
     1825                         , input  'bge-export':U
     1826                         , input  'bgeflold':U
     1827                         , output v-value-character
     1828                         , output v-value-date
     1829                         , output v-value-decimal
     1830                         , output v-value-integer
     1831                         , output v-value-logical
     1832                         , output v-param-type
     1833                         , input-output table-handle v-tth
     1834                         ) no-error .
     1835       if error-status :error
     1836       then do:
     1837         assign
     1838           v-bge-xml-bgeflold = "no-parameter":U
     1839         .
     1840       end.
     1841       else do:
     1842         assign
     1843           v-bge-xml-bgeflold  = v-value-character
     1844         .
     1845       end.
     1846       delete object v-tth.
     1847       assign
     1848         v-db-num-str          = ( if p-db-num <> ? then string(p-db-num ,"99999") else "":u )
     1849         v-bge-xml-db-num-str  = v-db-num-str
     1850       .
     1851       if p-last-date <> ?
     1852       then do:
     1853           run adm/shattri.p ( input "get":U
     1854                             , input  '':u
     1855                             , input  0
     1856                             , input  'bge-export':U
     1857                             , input  'bgeflnm':U
     1858                             , output v-value-character
     1859                             , output v-value-date
     1860                             , output v-value-decimal
     1861                             , output v-value-integer
     1862                             , output v-value-logical
     1863                             , output v-param-type
     1864                             , input-output table-handle v-tth
     1865                             ) no-error .
     1866           if error-status :error
     1867           then do:
     1868             assign
     1869               v-bgeflnm = '':U
     1870             .
     1871           end.
     1872           else do:
     1873             assign
     1874               v-bgeflnm = v-value-character
     1875             .
     1876           end.
     1877           delete object v-tth.
     1878           if v-bge-xml-bgeflold = "var"
     1879           then do:
     1880               if v-bgeflnm = ?
     1881               or num-entries( v-bgeflnm ) < 2
     1882               then do:
     1883                   assign
     1884                       v-bge-xml-bgeflold = "new"
     1885                   .
     1886               end.
     1887               else do:
     1888                   assign
     1889                       v-bge-xml-bgeflnm-doc = entry( 1, v-bgeflnm )
     1890                       v-bge-xml-bgeflnm-day = entry( 2, v-bgeflnm )
     1891                   .
     1892                   assign
     1893                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-date-chars , string( day( p-last-date ), "99" ) )
     1894                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-month-chars, string( month( p-last-date ), "99" ) )
     1895                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1896                       v-bge-xml-bgeflnm-doc = replace( v-bge-xml-bgeflnm-doc, v-db-num-chars, v-db-num-str )
     1897                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-date-chars , string( day( p-last-date ), "99" ) )
     1898                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-month-chars, string( month( p-last-date ), "99" ) )
     1899                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-year-chars , substring( string( year( p-last-date ), "9999" ), 3, 2 ) )
     1900                       v-bge-xml-bgeflnm-day = replace( v-bge-xml-bgeflnm-day, v-db-num-chars, v-db-num-str )
     1901                   .
     1902               end.
     1903           end.
     1904       end.
     1905   end.
     1906   end procedure.
     1907   procedure bge-xml-get-ref-filename :
     1908   define input parameter p-in-file-name       as character        no-undo.
     1909   define output parameter p-home-dir          as character        no-undo.
     1910   define output parameter p-out-file-name     as character        no-undo.
     1911   define output parameter p-locked            as logical          no-undo.
     1912       define variable v-counter       as integer      no-undo.
     1913       define variable v-error-level   as integer      no-undo.
     1914   do
     1915   on error undo, return error
     1916   :
     1917       run bge/bge-ini.p (
     1918             input "bge"
     1919           , output p-home-dir
     1920       ).
     1921       if return-value <> "OK"
     1922       then do:
     1923           undo, return error.
     1924       end.
     1925       assign
     1926           p-home-dir = p-home-dir + "\dict":U
     1927       .
     1928       run bge/dir_cd.p (
     1929           input p-home-dir
     1930           , input "CA"
     1931       ).
     1932       if return-value = "ERROR"
     1933       then do:
     1934           undo, return error.
     1935       end.
     1936       assign
     1937           p-out-file-name = substitute( "&1\&2.", p-home-dir, p-in-file-name )
     1938       .
     1939       assign
     1940           p-locked = ( search( p-out-file-name + "xml" ) <> ? ).
     1941       .
     1942       wait-lock:
     1943       do v-counter = 1 TO 3
     1944       :
     1945           p-locked = ( search( p-out-file-name + "lk" ) <> ? ).
     1946           if p-locked = no
     1947           then do:
     1948               leave wait-lock.
     1949           end.
     1950           else do:
     1951               readkey pause 1.
     1952           end.
     1953       END.
     1954       if p-locked = yes
     1955       then do:
     1956           undo, return error.
     1957       end.
     1958       run bge/os_copy.p (
     1959             input "D":U
     1960           , input p-out-file-name + "xml":U
     1961           , input "":U
     1962           , output v-error-level
     1963       ).
     1964       if v-error-level > 0
     1965       then do:
     1966           undo, return error.
     1967       end.
     1968   end.
     1969   end procedure.
     1970   procedure bge-xml-write-ref-header :
     1971   define input parameter p-bge-name as character        no-undo.
     1972   define input parameter p-file-name as character        no-undo.
     1973       define variable v-out-string    as character    no-undo.
     1974   do
     1975   on error undo, return error
     1976   :
     1977       output stream stmXMLOut to value( p-file-name + "xm1") convert target "1251".
     1978       put stream stmXMLOut unformatted
     1979           "<?xml version='1.0' encoding='windows-1251'?>":U
     1980       .
     1981       assign
     1982           v-out-string = substitute( "&1&2"
     1983                               , chr(10)
     1984                               , "<IBS_Trade_House>":U )
     1985       .
     1986       put stream stmXMLOut unformatted
     1987           v-out-string
     1988       .
     1989       run wp-XMLTagOpen( 1, "header", "" ).
     1990       if v-bge-xml-bgeflold = "oracle":u
     1991       then do:
     1992         run wp-XMLTagOpen in this-procedure  ( 2, "delivery", "").
     1993         run wp-XMLTagput in this-procedure ( 3, "message","", 1).
     1994         run wp-XMLTagput in this-procedure ( 3, "from","IBS Trade House", 1).
     1995         run wp-XMLTagput in this-procedure ( 3, "to","Oracle Retail", 1).
     1996         run wp-XMLTagClose in this-procedure ( 2, "delivery"    ).
     1997       end.
     1998       else do:
     1999         run wp-XMLTagOpen( 2, "delivery", "" ).
     2000         run wp-XMLTagOpen( 3, "to", "" ).
     2001         run wp-XMLTagClose( 3, "to" ).
     2002         run wp-XMLTagOpen( 3, "from", "" ).
     2003         run wp-XMLTagClose( 3, "from" ).
     2004         run wp-XMLTagClose( 2, "delivery" ).
     2005       end.
     2006       run wp-XMLTagOpen( 2, "manifest", "" ).
     2007       run wp-XMLTagOpen( 3, "document", "" ).
     2008       run wp-XMLTagPut( 4, "name", p-bge-name, 0 ).
     2009       run wp-XMLTagPut( 4, "description", "", 0 ).
     2010       run wp-XMLTagClose( 3, "document" ).
     2011       run wp-XMLTagClose( 2, "manifest" ).
     2012       run wp-XMLTagClose( 1, "header" ).
     2013       run wp-XMLTagOpen( 1, "body", "" ).
     2014   end.
     2015   end procedure.
     2016   procedure bge-xml-write-ref-footer :
     2017   define input parameter p-file-name as character        no-undo.
     2018       define variable v-error-level   as integer      no-undo.
     2019   do
     2020   on error undo, return error
     2021   :
     2022       run wp-XMLTagClose in this-procedure ( input 1, input "body":U ).
     2023       run wp-XMLTagClose in this-procedure ( input 0, input "IBS_Trade_House":U ).
     2024       output stream stmXMLOut close.
     2025       run bge/os_copy.p (
     2026             input "M":U
     2027           , input p-file-name + "xm1":U
     2028           , input p-file-name + "xml":U
     2029           , output v-error-level
     2030       ).
     2031       if v-error-level > 0
     2032       then do:
     2033           undo, return error.
     2034       end.
     2035   end.
     2036   end procedure.
     2037   procedure bge-xml-out-dir :
     2038   define output parameter p-out-dir       as character    no-undo.
     2039   define output parameter p-log-file-name as character    no-undo.
     2040   do
     2041   on error undo, return error
     2042   :
     2043       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2044       if p-out-dir = ?
     2045       then do:
     2046           message
     2047             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2048                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2049             skip(1)
     2050             skip "Обратитесь к администратору."
     2051           view-as alert-box error.
     2052           undo, return error .
     2053       end.
     2054       if v-bge-xml-bgeflold <> "oracle" then assign
     2055         p-out-dir = substitute( "&1&2exp-acc":U, p-out-dir, chr(47) )
     2056       .
     2057       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2058       if error-status :error  then do:
     2059           run wp-XMLWriteLog in this-procedure (
     2060                 input p-log-file-name
     2061               , input 0
     2062               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2063                                   , p-out-dir
     2064                                   , return-value
     2065                                   , trim( error-status :get-message( 1 ) )
     2066                                   )
     2067           ).
     2068           undo, return error.
     2069       end.
     2070       assign
     2071           v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2072           p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2073       .
     2074   end.
     2075   end procedure.
     2076   procedure bge-xml-out-dir2 :
     2077   define output parameter p-out-dir       as character    no-undo.
     2078   define output parameter p-out-dirR      as character    no-undo.
     2079   define output parameter p-log-file-name as character    no-undo.
     2080   do
     2081   on error undo, return error
     2082   :
     2083       p-out-dir = ibs.th.gbl.gbl-inipar:dirfrgAcc .
     2084       if p-out-dir = ?
     2085       then do:
     2086           message
     2087             skip substitute("Не найден параметр ini-файла, определяющий каталог экспорта (&1)."
     2088                           , ibs.th.gbl.gbl-inipar:dirfrgAccKeyName)
     2089             skip(1)
     2090             skip "Обратитесь к администратору."
     2091           view-as alert-box error.
     2092           undo, return error .
     2093       end.
     2094       if v-bge-xml-bgeflold <> "oracle" then assign
     2095             p-out-dirR = substitute( "&1&2exp-reestr":U, p-out-dir, chr(47) )
     2096             p-out-dir  = substitute( "&1&2exp-acc":U,    p-out-dir, chr(47) )
     2097         .
     2098       else p-out-dirR = p-out-dir .
     2099       run gbl/dir-cre.p ( input p-out-dir ) no-error.
     2100       if error-status :error  then do:
     2101           run wp-XMLWriteLog in this-procedure (
     2102                 input p-log-file-name
     2103               , input 0
     2104               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2105                                   , p-out-dir
     2106                                   , return-value
     2107                                   , error-status :get-message( 1 )
     2108                                   )
     2109           ).
     2110           undo, return error.
     2111       end.
     2112       if p-out-dirR <> p-out-dir then do:
     2113         run gbl/dir-cre.p ( input p-out-dirR ) no-error.
     2114         if error-status :error then do:
     2115           run wp-XMLWriteLog in this-procedure (
     2116                 input p-log-file-name
     2117               , input 0
     2118               , input substitute( "Ошибка проверки или создания каталога &1. &2. &3."
     2119                                   , p-out-dirR
     2120                                   , return-value
     2121                                   , error-status :get-message( 1 )
     2122                                   )
     2123           ).
     2124           p-out-dirR = p-out-dir .
     2125         end.
     2126       end .
     2127       assign
     2128         v-bge-xml-static-log-file-name = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2129         p-log-file-name                = substitute( "&1&2actions.log":U, p-out-dir, chr(47) )
     2130       .
     2131   end.
     2132   end procedure.
     2133   procedure bge-xml-out-file :
     2134   do
     2135   on error undo, return error
     2136   :
     2137   define input parameter p-out-dir            as character        no-undo.
     2138   define input parameter p-prefix             as character        no-undo.
     2139   define input parameter p-sheduled           as logical          no-undo.
     2140   define output parameter p-xml-file-name     as character        no-undo.
     2141   define output parameter p-locked            as logical          no-undo.
     2142   define variable v-home-dir      as character     no-undo.
     2143   define variable v-error-num     as integer       no-undo.
     2144   define variable v-today             as date         no-undo.
     2145   define variable v-time              as integer      no-undo.
     2146       if v-bge-xml-bgefmt = "dbf":U
     2147       then do:
     2148           assign
     2149               p-xml-file-name = p-out-dir
     2150               p-locked        = no
     2151           .
     2152       end.
     2153       else do:
     2154           if v-bge-xml-bgeflold = "firm":U
     2155           then do:
     2156               run bge/genfname.p (
     2157                     input p-out-dir
     2158                   , input p-prefix
     2159                   , input "":U
     2160                   , input "arj":U
     2161                   , input "":U
     2162                   , output p-xml-file-name
     2163               ).
     2164           end.
     2165           else do:
     2166               run bge/genfname.p (
     2167                     input p-out-dir
     2168                   , input p-prefix
     2169                   , input "":U
     2170                   , input "xml":U
     2171                   , input "":U
     2172                   , output p-xml-file-name
     2173               ).
     2174           end.
     2175           assign
     2176               p-xml-file-name = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2177               p-locked = ( search ( p-xml-file-name + "lk":U ) <> ? )
     2178           .
     2179       end.
     2180   end.
     2181   end procedure.
     2182   procedure bge-xml-init-ext-doc-type :
     2183       define variable v-counter    as integer      no-undo.
     2184       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2185   do
     2186   for buf_temp_ext-doc-type
     2187   on error undo, return error
     2188   :
     2189       empty temp-table buf_temp_ext-doc-type.
     2190       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2191       :
     2192           create buf_temp_ext-doc-type.
     2193           assign
     2194               buf_temp_ext-doc-type.edt-key               = v-counter
     2195               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     2196               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     2197           .
     2198       end.
     2199   end.
     2200   end procedure.
     2201   procedure bge-xml-get-decimal-shift-num :
     2202   define input parameter p-shift-date     as date             no-undo.
     2203   define input parameter p-shift-num      as integer          no-undo.
     2204   define output parameter p-shift-decimal as decimal          no-undo.
     2205   do
     2206   on error undo, return error
     2207   :
     2208       assign
     2209           p-shift-decimal = ( p-shift-date - 01/01/1990 ) + truncate( p-shift-num / 1000, 3 )
     2210       .
     2211   end.
     2212   end procedure.
     2213   procedure bge-xml-ora-exp-filename :
     2214     define input  parameter p-table-name  as character no-undo .
     2215     define input  parameter p-doc-code    as character no-undo .
     2216     define input  parameter p-obj-code    as integer   no-undo .
     2217     define output parameter p-filename    as character no-undo .
     2218     define output parameter p-seq-num     as integer   no-undo .
     2219     define variable v-ora-exp-seq     as integer   no-undo .
     2220     define variable v-ora-exp-seq-str as character no-undo .
     2221     define variable v-home-dir        as character no-undo.
     2222   do
     2223   on error undo, return error return-value
     2224   :
     2225     if v-bge-xml-bgeflold = "oracle":u
     2226     then do:
     2227       get-key-value section "BGE" key "Dirfrg-acc" value v-home-dir.
     2228       if v-home-dir = ?
     2229       then do:
     2230         undo, return error substitute( "&1&2&3":U
     2231                                       , "Не найден параметр ini-файла, определяющий каталог экспорта.":U
     2232                                       , chr(10)
     2233                                       , "Обратитесь к администратору.":U
     2234                                       ).
     2235       end.
     2236       assign
     2237           v-home-dir = v-home-dir
     2238       .
     2239       run gbl/dir-cre.p ( input v-home-dir ) no-error.
     2240       if error-status :error
     2241       then do:
     2242         undo, return error substitute( "&1&2&3":U
     2243                                       , "Неверно задан каталог экспорта.":U
     2244                                       , chr(10)
     2245                                       , "Обратитесь к администратору.":U
     2246                                       ).
     2247       end.
     2248       assign
     2249         v-ora-exp-seq = ?
     2250       .
     2251       if  p-table-name <> ? and
     2252           p-doc-code <> ?
     2253       then do:
     2254         run bge/get-oesq.p ( input p-table-name
     2255                            , input p-doc-code
     2256                            , output v-ora-exp-seq
     2257                            ) no-error .
     2258         if error-status :error = yes
     2259         then do:
     2260           undo, return error return-value .
     2261         end.
     2262       end.
     2263       if v-ora-exp-seq = ?
     2264       then do:
     2265         run bge/oesq-get.p ( output v-ora-exp-seq ) no-error .
     2266         if error-status :error
     2267         then do:
     2268           undo, return error return-value .
     2269         end.
     2270       end.
     2271       if p-table-name <> ? and
     2272          p-doc-code   <> ?
     2273       then do:
     2274         run bge/oesqdoc.p ( input p-table-name
     2275                           , input p-doc-code
     2276                           , input v-ora-exp-seq
     2277                           ) no-error .
     2278         if error-status :error = yes
     2279         then do:
     2280           undo, return error return-value .
     2281         end.
     2282       end.
     2283       assign
     2284         p-seq-num  = v-ora-exp-seq
     2285         p-filename = substitute("&1/&2-000_&3."
     2286                                , v-home-dir
     2287                                , ( if p-obj-code < 1000 then string( p-obj-code, "999") else string(p-obj-code))
     2288                                , string(v-ora-exp-seq , "999999999")
     2289                                )
     2290       .
     2291     end.
     2292   end.
     2293   end procedure.
     2294   procedure bge-xml-date-to-str :
     2295     define input  parameter p-date  as date      no-undo .
     2296     define output parameter p-str   as character no-undo .
     2297   do
     2298   on error undo, return error return-value
     2299   :
     2300     if p-date <> ?
     2301     then do:
     2302       assign
     2303         p-str = substitute( "&1-&2-&3"
     2304                           , string( year(p-date)  , "9999")
     2305                           , string( month(p-date) , "99"  )
     2306                           , string( day(p-date)   , "99"  )
     2307                           )
     2308       .
     2309     end.
     2310     else do:
     2311       assign
     2312         p-str = ?
     2313       .
     2314     end.
     2315   end.
     2316   end procedure.
     2317   procedure bge-xml-date-str-to-str :
     2318     define input  parameter p-date-str  as character no-undo .
     2319     define output parameter p-str       as character no-undo .
     2320     define variable v-date          as date      no-undo .
     2321     define variable v-date-valid    as logical   no-undo .
     2322     define variable v-error-message as character no-undo .
     2323   do
     2324   on error undo, return error return-value
     2325   :
     2326     assign
     2327       p-str = ?
     2328     .
     2329     if p-date-str = ? or p-date-str = ""
     2330     then do:
     2331       return .
     2332     end.
     2333     run strtdate in this-procedure ( input  p-date-str
     2334                                    , output v-date
     2335                                    , output v-date-valid
     2336                                    , output v-error-message
     2337                                    ).
     2338     if v-date-valid <> true
     2339     then do:
     2340       return .
     2341     end.
     2342     assign
     2343       p-str = substitute( "&1-&2-&3"
     2344                         , string( year(v-date)  , "9999")
     2345                         , string( month(v-date) , "99"  )
     2346                         , string( day(v-date)   , "99"  )
     2347                         )
     2348     .
     2349   end.
     2350   end procedure.
     2351   procedure bge-xml-fill-tt-bgecliiv :
     2352     define input  parameter p-str as character no-undo .
     2353     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2354     define buffer buf_clients             for ub.clients.
     2355     define variable v-i         as integer   no-undo .
     2356     define variable v-count     as integer   no-undo .
     2357     define variable v-cli-count as integer   no-undo .
     2358     define variable v-client    as character no-undo .
     2359     define variable v-obj-type  as character no-undo .
     2360     define variable v-obj-code  as integer   no-undo .
     2361   do
     2362   on error undo, return error return-value
     2363   :
     2364     empty temp-table buf_tt-bge-xml-bgecliiv.
     2365     assign
     2366       v-bge-xml-bgecliiv = no
     2367       v-cli-count        = num-entries(p-str,';')
     2368     .
     2369     if v-cli-count > 0
     2370     then do:
     2371       _cli-cycle:
     2372       do v-i = 1 to v-cli-count
     2373       :
     2374         assign
     2375           v-client = entry(v-i , p-str, ';')
     2376         .
     2377         if num-entries(v-client) <> 2
     2378         then do:
     2379           undo, return error substitute("Неправильный формат записи контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2380         end.
     2381         assign
     2382           v-obj-type = entry(1, v-client)
     2383         .
     2384         assign
     2385           v-obj-code = integer(entry(2, v-client))
     2386         no-error .
     2387         if error-status :error
     2388         then do:
     2389           undo, return error substitute("Неправильный формат записи кода контрагента в параметре 'bgecliiv'. Позиция записи &1." , v-i).
     2390         end.
     2391         find first buf_clients no-lock
     2392           where buf_clients.obj-type = v-obj-type
     2393             and buf_clients.obj-code = v-obj-code
     2394         no-error.
     2395         if not available buf_clients
     2396         then do:
     2397           next _cli-cycle.
     2398         end.
     2399         find first buf_tt-bge-xml-bgecliiv no-lock
     2400           where buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2401             and buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2402         no-error .
     2403         if available buf_tt-bge-xml-bgecliiv
     2404         then do:
     2405           next _cli-cycle.
     2406         end.
     2407         create buf_tt-bge-xml-bgecliiv.
     2408         assign
     2409           buf_tt-bge-xml-bgecliiv.obj-type = buf_clients.obj-type
     2410           buf_tt-bge-xml-bgecliiv.obj-code = buf_clients.obj-code
     2411         .
     2412       end.
     2413     end.
     2414     else do:
     2415       assign
     2416         v-bge-xml-bgecliiv = no
     2417       .
     2418       return .
     2419     end.
     2420     find first buf_tt-bge-xml-bgecliiv no-lock no-error .
     2421     if available buf_tt-bge-xml-bgecliiv
     2422     then do:
     2423       assign
     2424         v-bge-xml-bgecliiv = yes
     2425       .
     2426     end.
     2427   end.
     2428   end procedure.
     2429   procedure bge-xml-resolve-ext-doc-type :
     2430     define input  parameter p-ext-doc-type      as character no-undo .
     2431     define input  parameter p-obj-type          as character no-undo .
     2432     define input  parameter p-obj-code          as integer   no-undo .
     2433     define output parameter p-out-ext-doc-type  as character no-undo .
     2434     define buffer buf_tt-bge-xml-bgecliiv for tt-bge-xml-bgecliiv.
     2435   do
     2436   on error undo, return error return-value
     2437   :
     2438     assign
     2439       p-out-ext-doc-type = p-ext-doc-type
     2440     .
     2441     if p-ext-doc-type <> 'ie':U
     2442     then do:
     2443       return .
     2444     end.
     2445     if v-bge-xml-bgecliiv = yes
     2446     then do:
     2447       find first buf_tt-bge-xml-bgecliiv no-lock
     2448         where buf_tt-bge-xml-bgecliiv.obj-type = p-obj-type
     2449           and buf_tt-bge-xml-bgecliiv.obj-code = p-obj-code
     2450       no-error .
     2451       if available buf_tt-bge-xml-bgecliiv
     2452       then do:
     2453         assign
     2454           p-out-ext-doc-type = 'iv':U
     2455         .
     2456       end.
     2457     end.
     2458   end.
     2459   end procedure.
     2460   procedure safe-wp-xmltagput :
     2461     define input  parameter pTagLevel   as integer   no-undo .
     2462     define input  parameter pTagName    as character no-undo .
     2463     define input  parameter pParValue   as character no-undo .
     2464     define input  parameter pFlagEmpty  as integer   no-undo .
     2465   do
     2466   on error undo, return error return-value
     2467   :
     2468     if v-bge-xml-bgeflold = "oracle":u
     2469     then do:
     2470       return .
     2471     end.
     2472     run wp-xmltagput in this-procedure ( input pTagLevel
     2473                                        , input pTagName
     2474                                        , input pParValue
     2475                                        , input pFlagEmpty
     2476                                        ).
     2477   end.
     2478   end procedure.
     2479   define new global shared variable g#library  as handle no-undo .
     2480   define new global shared variable g#library2 as handle no-undo .
     2481   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2482     define variable v-cntxt-db-num        as integer   no-undo .
     2483     define variable v-cntxt-userid        as character no-undo .
     2484     define variable v-cntxt-level         as character no-undo .
     2485     define variable v-cntxt-host-code-obj as integer   no-undo .
     2486     define variable v-cntxt-obj-type      as character no-undo .
     2487     define variable v-cntxt-obj-code      as integer   no-undo .
     2488     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2489     define variable v-cntxt-is-admin      as logical   no-undo .
     2490       define variable v-permission     as logical           no-undo.
     2491       define variable v-home-dir       as character         no-undo.
     2492       define variable v-error-num      as integer           no-undo.
     2493       define variable v-locked         as logical           no-undo.
     2494       define variable v-counter        as integer           no-undo.
     2495   do
     2496   on error undo, return error
     2497   :
     2498   run bge/bge-ini.p ( "bge", output v-home-dir ).
     2499   if return-value <> "OK" then return error.
     2500   assign
     2501       v-home-dir = v-home-dir + "/" + p-subdir
     2502   .
     2503   run bge/dir_cd.p ( v-home-dir, "CA" ).
     2504   if return-value = "ERROR" then return error.
     2505   assign
     2506       p-xml-file-name = v-home-dir + "/" + p-file-name + "."
     2507   .
     2508   assign
     2509       v-locked = ( search ( p-xml-file-name + "xml" ) <> ? ).
     2510   .
     2511   DO v-counter = 1 TO 3 while v-locked:
     2512       assign
     2513           v-locked = ( search ( p-xml-file-name + "lk" ) <> ? )
     2514       .
     2515       if v-locked then readkey pause 1.
     2516   end.
     2517   if v-locked
     2518   then do:
     2519       return error "LOCKED".
     2520   end.
     2521   run bge/os_copy.p ( "D", p-xml-file-name + "xml", "", output v-error-num ).
     2522   if v-error-num > 0 then return error string( v-error-num ).
     2523   assign
     2524       p-log-file-name = v-home-dir + "/" + "actions.log"
     2525   .
     2526   run wp-XMLWriteLog( p-log-file-name, 0, "&DLine" ).
     2527   run wp-XMLWriteLog( p-log-file-name, 1, p-message-to-log ).
     2528   end.
