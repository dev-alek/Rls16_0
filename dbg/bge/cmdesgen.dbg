        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-log-handle  as handle no-undo .
        4   define input parameter p-esys-id as integer   no-undo .
        5   define input parameter p-db-num as integer   no-undo .
        6   define input parameter p-db-num-exp as integer no-undo .
        7   define input parameter p-cr-db-num as integer   no-undo .
        8   define input parameter p-esr-dump-ord as int64 no-undo .
        9   define input parameter p-gate-rec as character no-undo .
       10   define input parameter p-xml-file-name as character no-undo .
       11   define input parameter p-xml-file-number as integer no-undo .
       12   define input parameter p-pack-num as integer no-undo .
       13   define output parameter p-num-rec as integer no-undo .
       14   define variable vss-revision    as character no-undo init "$Revision$":U .
       15   define variable vss-author      as character no-undo init "$Author$":U .
       16   define variable vss-date        as character no-undo init "$Date$":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       18   define variable vss-archive     as character no-undo init "$Archive$":U .
       19   define variable vss-description as character no-undo init "Укладка данных, маршрутизированных во ВС в файл".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   define   shared variable g#auto as logical no-undo.
       81   define   shared variable g#news as logical no-undo.
       82   define   shared variable g#oxml as logical no-undo.
       83   define   shared variable g#esys as logical no-undo.
       84   define   shared variable g#news-source-db as integer no-undo.
       85   define   shared variable g#esys-source-esys as integer no-undo.
       86   define   shared variable g#db-num as integer   no-undo .
       87   define   shared variable g#userid as character no-undo .
       88   define   shared variable g#passwd as character no-undo .
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   define  shared variable g#auto-pid           as integer   no-undo .
       92   define  shared variable conn-par             as character no-undo .
       93   define  shared variable g#auto-user-id       as character no-undo .
       94   define  shared variable g#auto-user-login    as character no-undo .
       95   define  shared variable g#auto-user-password as character no-undo .
       96   define  shared variable v-socket             as logical   no-undo .
       97   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   define  shared variable auto-window-h     as handle    no-undo .
       99   define  shared variable auto-log-msg-h    as handle    no-undo .
      100   define  shared variable hand-log-msg-h    as handle    no-undo .
      101   define  shared variable log-file-name     as character no-undo initial ? .
      102   define  shared variable add-log-file-name as character no-undo initial ? .
      103   define  shared variable writelogvalue     as character no-undo initial ? .
      104   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      105   procedure cur-time :
      106      define output parameter p-today as date      no-undo .
      107      define output parameter p-time  as integer   no-undo .
      108     do
      109     on error undo, return error
      110     :
      111       define variable v-date1 as date      no-undo .
      112       define variable v-date2 as date      no-undo .
      113       define variable v-time  as integer   no-undo .
      114       assign
      115         v-date1 = today
      116         v-time  = time
      117         v-date2 = today
      118       .
      119       if v-date1 <> v-date2
      120       then do:
      121         assign
      122           v-date1 = today
      123           v-time  = v-time
      124         .
      125       end.
      126       assign
      127         p-today = v-date1
      128         p-time  = v-time
      129       .
      130     end.
      131   end.
      132   function cur-time-date returns character
      133   :
      134     return string(today, '99/99/9999':U) .
      135   end.
      136   function cur-time-mjd returns decimal
      137   :
      138     define variable v-date as date      no-undo .
      139     define variable v-time as integer   no-undo .
      140     run cur-time in this-procedure
      141       (output v-date
      142       ,output v-time
      143       ) .
      144     return integer(v-date) - 2400002 + (v-time / 86400) .
      145   end.
      146   function cur-time-get-ending-index returns integer
      147   (input p-number as integer
      148   )
      149   :
      150     if p-number < 0
      151     or p-number = ?
      152     then do:
      153       return 1 .
      154     end.
      155     define variable v-rest as integer   no-undo .
      156     assign
      157       p-number = p-number modulo 100
      158     .
      159     if p-number < 20
      160     then do:
      161       assign
      162         v-rest = p-number
      163       .
      164     end.
      165     else do:
      166       assign
      167         v-rest = p-number modulo 10
      168       .
      169     end.
      170     case v-rest :
      171       when 1
      172       then do:
      173         return 2 .
      174       end.
      175       when 2 or
      176       when 3 or
      177       when 4
      178       then do:
      179         return 3 .
      180       end.
      181       otherwise do:
      182         return 1 .
      183       end.
      184     end case .
      185   end.
      186   procedure cur-time-mjd-to-date :
      187      define input  parameter i-mjd-diff as decimal no-undo.
      188      define output parameter o-Date     as date    no-undo.
      189      define output parameter o-Time     as integer no-undo.
      190      define variable v-day-number as integer   no-undo .
      191      if    i-mjd-diff < 0
      192         or i-mjd-diff = ?
      193      then do:
      194         return "?" .
      195      end.
      196      assign
      197         v-day-number = truncate(i-mjd-diff,0).
      198         o-Date = date(v-day-number + 2400002).
      199         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      200     .
      201   end.
      202   function cur-time-mjd-to-string returns character
      203   (input p-mjd-diff as decimal
      204   )
      205   :
      206     define variable v-day-number as integer   no-undo .
      207     define variable v-seconds    as integer   no-undo .
      208     define variable v-hour       as integer   no-undo .
      209     define variable v-min        as integer   no-undo .
      210     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      211     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      212     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      213     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      214     if p-mjd-diff < 0
      215     or p-mjd-diff = ?
      216     then do:
      217       return "?" .
      218     end.
      219     assign
      220       v-day-number = integer(truncate(p-mjd-diff,0))
      221       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      222     .
      223     if v-seconds > 86400
      224     then do:
      225       assign
      226         v-seconds = 86400 - 1
      227       .
      228     end.
      229     if v-seconds < 0
      230     then do:
      231       assign
      232         v-seconds = 0
      233       .
      234     end.
      235     assign
      236       v-hour = truncate(v-seconds / 3600, 0)
      237     .
      238     assign
      239       v-seconds = v-seconds modulo 3600
      240     .
      241     assign
      242       v-min = truncate(v-seconds / 60, 0)
      243     .
      244     assign
      245       v-seconds = v-seconds modulo 60
      246     .
      247     return
      248         (if v-day-number <> 0
      249           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      250           else ""
      251         )
      252       + (if v-day-number <> 0 or v-hour <> 0
      253           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      254           else ""
      255         )
      256       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      257           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      258           else ""
      259         )
      260       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      261       .
      262   end.
      263   function cur-time-string returns character
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      272   end.
      273   function cur-time-string-sec returns character
      274   :
      275     define variable v-date as date      no-undo .
      276     define variable v-time as integer   no-undo .
      277     run cur-time in this-procedure
      278       (output v-date
      279       ,output v-time
      280       ) .
      281     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      282   end.
      283   function cur-time-custom  returns character
      284   (input p-prefix as character
      285   ,input p-date-format as character
      286   ,input p-delimiter as character
      287   ,input p-time-format as character
      288   ,input p-suffix as character
      289   )
      290   :
      291     define variable v-date as date      no-undo .
      292     define variable v-time as integer   no-undo .
      293     run cur-time in this-procedure
      294       (output v-date
      295       ,output v-time
      296       ) .
      297     return
      298       p-prefix
      299       + string(v-date, p-date-format)
      300       + p-delimiter
      301       + string(v-time, p-time-format)
      302       + p-suffix
      303       .
      304   end.
      305   function cur-time-print  returns character
      306   :
      307     define variable v-date as date      no-undo .
      308     define variable v-time as integer   no-undo .
      309     run cur-time in this-procedure
      310       (output v-date
      311       ,output v-time
      312       ) .
      313     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      314   end.
      315   function cur-time-datetime returns datetime
      316   :
      317     define variable v-char as character no-undo .
      318     define variable v-datetime as datetime no-undo .
      319     v-char = cur-time-string().
      320     v-datetime = datetime(v-char).
      321     return  v-datetime.
      322   end.
      323   function cur-time-string-msec returns character
      324   :
      325     define variable v-date as datetime  no-undo .
      326     v-date = now.
      327     return string(v-date) .
      328   end.
      329   define stream LogStream .
      330   define variable mNoTime as logical no-undo.
      331   procedure write-to-log-notime :
      332     define input param i-str as character no-undo .
      333     mNoTime = yes.
      334     run write-to-log (i-str).
      335     mNoTime = no.
      336   end.
      337   procedure write-to-log :
      338     define input param p-str as character no-undo .
      339     do
      340     on error  undo, return error substitute( "&1 (write-to-log). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      341     on stop   undo, return error substitute( "&1 (write-to-log). stop", vss-workfile )
      342     on endkey undo, return error substitute( "&1 (write-to-log). endkey", vss-workfile )
      343     :
      344       define variable log-res        as logical   no-undo .
      345       define variable v-jj           as integer   no-undo .
      346       if    mNoTime
      347          or writelogvalue eq "AsyncProc"
      348       then
      349          p-str = substitute( "&1 (pid: &2) &3&4"   , g#auto-user-id, g#auto-pid,                        p-str, chr(10) ).
      350       else
      351          p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) ).
      352       if auto-log-msg-h <> ? then do:
      353         log-res = auto-log-msg-h:move-to-eof( ) .
      354         log-res = auto-log-msg-h:insert-string( p-str ).
      355       end.
      356       if hand-log-msg-h <> ? then do:
      357         log-res = hand-log-msg-h:move-to-eof( ) .
      358         log-res = hand-log-msg-h:insert-string( p-str ).
      359       end.
      360       assign
      361         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
      362         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
      363         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
      364       .
      365       if add-log-file-name <> ? then do:
      366         do v-jj = 1 to num-entries(add-log-file-name, chr(1)):
      367           run gbl/fileapnd.p
      368             ( input entry(v-jj, add-log-file-name, chr(1) )
      369             ,input p-str
      370             ,input 20
      371             ) no-error .
      372           if error-status:error then do:
      373             return error return-value .
      374           end.
      375         end.
      376       end.
      377       if writelogvalue eq "AsyncProc"
      378       then do:
      379          p-str = trim(p-str, (chr(13) + chr(10)) )
      380       .
      381          Publish "WriteLogAsunc" (p-str,yes).
      382       end.
      383       else if writelogvalue <> "yes" then do:
      384         run gbl/fileapnd.p
      385           ( input log-file-name
      386           ,input p-str
      387           ,input 20
      388           ) no-error .
      389         if error-status:error then do:
      390           return error return-value .
      391         end.
      392       end.
      393     end.
      394   end procedure.
      395   procedure write-to-screen :
      396     define input param p-str as character no-undo .
      397     do
      398     on error  undo, return error substitute( "&1 (write-to-screen). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      399     on stop   undo, return error substitute( "&1 (write-to-screen). stop", vss-workfile )
      400     on endkey undo, return error substitute( "&1 (write-to-screen). endkey", vss-workfile )
      401     :
      402       define variable log-res as logical no-undo.
      403       assign
      404         p-str = substitute( "&1 (pid: &2) &3 &4&5", g#auto-user-id, g#auto-pid, cur-time-string-sec(), p-str, chr(10) )
      405       .
      406       if auto-log-msg-h <> ?
      407       then do:
      408         log-res = auto-log-msg-h:move-to-eof( ) .
      409         log-res = auto-log-msg-h:insert-string( p-str ).
      410       end.
      411       if hand-log-msg-h <> ?
      412       then do:
      413         log-res = hand-log-msg-h:move-to-eof( ) .
      414         log-res = hand-log-msg-h:insert-string( p-str ).
      415       end.
      416     end.
      417   end procedure.
      418   procedure send-msg-to-email :
      419     define input  parameter p-subject      as character no-undo .
      420     define input  parameter p-text-err     as character no-undo .
      421     define input  parameter p-attach-files as character no-undo .
      422     do
      423     on error  undo, return error substitute( "&1 (send-msg-to-email). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      424     on stop   undo, return error substitute( "&1 (send-msg-to-email). stop", vss-workfile )
      425     on endkey undo, return error substitute( "&1 (send-msg-to-email). endkey", vss-workfile )
      426     :
      427       define variable v-tth             as handle    no-undo .
      428       define variable v-value-character as character no-undo .
      429       define variable v-value-date      as date      no-undo .
      430       define variable v-value-decimal   as decimal   no-undo .
      431       define variable v-value-integer   as integer   no-undo .
      432       define variable v-value-logical   as logical   no-undo .
      433       define variable v-param-type      as character no-undo .
      434       define variable v-email       as character no-undo .
      435       define variable v-tmp-str     as character no-undo .
      436       define variable v-tmp1-str    as character no-undo .
      437       define variable v-ind         as integer   no-undo .
      438       define variable v-num-entries as integer   no-undo .
      439       delete object v-tth no-error.
      440       run adm/shattri.p
      441         ( input "get":U
      442          ,input  "":U
      443          ,input  0
      444          ,input  'auto-task':U
      445          ,input  'send-msg-to-email':U
      446          ,output v-value-character
      447          ,output v-value-date
      448          ,output v-value-decimal
      449          ,output v-value-integer
      450          ,output v-value-logical
      451          ,output v-param-type
      452          ,input-output table-handle v-tth
      453         ) no-error .
      454       if not error-status :error  then do:
      455         assign
      456           v-tmp-str = v-value-character
      457         .
      458       end.
      459       delete object v-tth no-error.
      460       assign
      461         v-tmp-str     = replace(v-tmp-str, (chr(10) + chr(13)), chr(44) )
      462         v-tmp-str     = replace(v-tmp-str, (chr(13) + chr(10)), chr(44) )
      463         v-tmp-str     = replace(v-tmp-str, chr(10), chr(44) )
      464         v-num-entries = num-entries( v-tmp-str, chr(44) )
      465         v-email       = "":U
      466       .
      467       do v-ind = 1 to v-num-entries
      468       :
      469         assign
      470           v-tmp1-str = entry( v-ind, v-tmp-str, chr(44) )
      471         .
      472         if trim( v-tmp1-str ) <> "":U then do:
      473           if v-email = "":U then do:
      474             assign
      475               v-email = v-tmp1-str
      476             .
      477           end.
      478           else do:
      479             assign
      480               v-email = v-email + chr(44) + v-tmp1-str
      481             .
      482           end.
      483         end.
      484       end.
      485       if v-email <> "":U then do:
      486         run gbl/sendmail.p
      487           ( input v-email
      488           , input p-subject
      489           , input p-text-err
      490           , input p-attach-files
      491           ) no-error .
      492         if error-status :error
      493           or return-value <> "":U
      494         then do:
      495           return error substitute( "&1 (send-msg-to-email). &2", vss-workfile, return-value ) .
      496         end.
      497       end.
      498     end.
      499   end procedure.
