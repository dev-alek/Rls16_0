      548   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      549   procedure gen-key-rec :
      550     define input  parameter p-tbl-name    as character no-undo.
      551     define input  parameter p-bh_tbl-name as handle    no-undo.
      552     define output parameter p-key-rec     as character no-undo.
      553     do
      554     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      555     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      556     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      557     :
      558       define variable fh               as handle    no-undo .
      559       define variable v-ok             as logical   no-undo .
      560       define variable v-inform         as character no-undo .
      561       define variable v-ind            as integer   no-undo .
      562       define variable v-idx-field-qnty as integer   no-undo .
      563       if p-tbl-name = ?
      564         or p-tbl-name = "":U
      565       then do:
      566         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info6 ).
      567       end.
      568       if not p-bh_tbl-name:available then do:
      569         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info6, p-tbl-name ).
      570       end.
      571       assign
      572         p-key-rec = p-tbl-name
      573         v-inform  = p-bh_tbl-name:index-information(1)
      574         v-ind     = 2
      575       .
      576       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      577       on error undo, return error
      578       :
      579         assign
      580           v-inform = p-bh_tbl-name:index-information( v-ind )
      581           v-ind    = v-ind + 1
      582         .
      583       end.
      584       if v-inform = ?
      585         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      586         or entry( 3, v-inform, ",":U ) <> "1":U
      587       then do:
      588         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, p-tbl-name ).
      589       end.
      590       else do:
      591         assign
      592           v-idx-field-qnty = num-entries( v-inform ) - 4
      593         .
      594         if v-idx-field-qnty < 2 then do:
      595           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, p-tbl-name ).
      596         end.
      597         do v-ind = 1 to v-idx-field-qnty by 2
      598         on error undo, return error
      599         :
      600           assign
      601             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      602             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      603           .
      604         end.
      605       end.
      606       if p-key-rec = ? then do:
      607         assign
      608           p-key-rec = "":U
      609         .
      610         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info6, p-tbl-name ).
      611       end.
      612     end.
      613     return.
      614   end procedure.
      615   procedure gen-where-keyr-tab :
      616     define input  parameter i-tableSerach as character no-undo.
      617     define input  parameter i-tablekey   as character  no-undo.
      618     define input  parameter p-key-rec    as character  no-undo.
      619     define input  parameter p-key-handle as handle     no-undo .
      620     define input  parameter p-db-name    as character  no-undo .
      621     define input  parameter p-tt-handle  as handle     no-undo .
      622     define output parameter o-Where      as character  no-undo.
      623     do
      624     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      625     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      626     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      627     :
      628       define variable v-full-tbl-name  as character no-undo .
      629       define variable bh_tbl-name      as handle    no-undo .
      630       define variable fh_key           as handle    no-undo .
      631       define variable fh_search        as handle    no-undo .
      632       define variable v-field-num      as integer   no-undo .
      633       define variable v-count-fld      as integer   no-undo .
      634       define variable v-inform         as character no-undo .
      635       define variable v-ind            as integer   no-undo .
      636       define variable v-idx-field-qnty as integer   no-undo .
      637       define variable v-field-name     as character no-undo .
      638       define variable v-field-val      as character no-undo .
      639       define variable v-word-link      as character no-undo .
      640       define variable vTable           as character no-undo.
      641       define variable bh_tbl-key       as handle    no-undo .
      642       assign
      643         p-key-rec = trim( p-key-rec )
      644       .
      645       if p-key-handle <> ? then do:
      646         if not valid-handle(p-key-handle)
      647            or p-key-handle:type <> "buffer"
      648         then do:
      649           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info6 ).
      650         end.
      651         if num-entries( p-key-rec, chr(3) ) > 1
      652           or p-key-rec = ?
      653           or p-key-rec = "":U
      654         then do:
      655           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info6, p-key-rec ).
      656         end.
      657       end.
      658       else do:
      659         if p-key-rec = ?
      660           or p-key-rec = "":U
      661         then do:
      662           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      663         end.
      664       end.
      665       assign
      666         vTable = entry( 1 , p-key-rec, chr(3) )
      667       .
      668       if p-tt-handle <> ?
      669         and ( not valid-handle(p-tt-handle)
      670               or p-tt-handle:type <> "buffer"
      671             )
      672       then do:
      673         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info6, vTable, chr(10) ).
      674       end.
      675       if p-tt-handle = ? then do:
      676         assign
      677           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      678         .
      679         create buffer bh_tbl-name for table v-full-tbl-name .
      680       end.
      681       else do:
      682         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      683       end.
      684       assign
      685         v-inform = bh_tbl-name:index-information(1)
      686         v-ind    = 2
      687       .
      688       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      689       on error undo, return error
      690       :
      691         assign
      692           v-inform = bh_tbl-name:index-information( v-ind )
      693           v-ind    = v-ind + 1
      694         .
      695       end.
      696       if v-inform = ?
      697         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      698         or entry( 3, v-inform, ",":U ) <> "1":U
      699       then do:
      700         delete object bh_tbl-name no-error.
      701         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info6, vTable ).
      702       end.
      703       assign
      704         v-idx-field-qnty = num-entries( v-inform ) - 4
      705       .
      706       if v-idx-field-qnty < 2 then do:
      707         delete object bh_tbl-name no-error.
      708         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, vTable ).
      709       end.
      710       assign
      711         o-where     = "where":U
      712         v-word-link = "":U
      713         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      714         v-count-fld = 0
      715       .
      716       if i-tablekey ne "" and i-tablekey ne ?
      717       then do:
      718         assign
      719           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      720         .
      721         create buffer bh_tbl-key for table v-full-tbl-name .
      722       end.
      723       if i-tableSerach ne "" and i-tableSerach ne ?
      724       then do:
      725         delete object bh_tbl-name no-error.
      726         assign
      727           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      728         .
      729         create buffer bh_tbl-name for table v-full-tbl-name .
      730       end.
      731       block_where:
      732       do v-ind = 1 to v-idx-field-qnty by 2
      733       on error undo, return error
      734       :
      735         assign
      736           v-count-fld = v-count-fld + 1
      737         .
      738         if p-key-handle = ?
      739           and v-count-fld > v-field-num
      740         then do:
      741           leave block_where.
      742         end.
      743         define variable VfieldKeyTable as handle no-undo.
      744         assign
      745           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      746           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      747         .
      748         if     bh_tbl-key ne ?
      749         then do:
      750            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      751            if VfieldKeyTable eq ?
      752            then next block_where.
      753         end.
      754         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      755         then
      756            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      757         else
      758            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      759         if p-key-handle = ? then do:
      760           assign
      761             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      762           .
      763         end.
      764         else do:
      765           assign
      766             fh_key = p-key-handle:buffer-field( v-field-name )
      767           .
      768           if fh_key = ?
      769             or not valid-handle( fh_key )
      770           then do:
      771             delete object bh_tbl-name.
      772             if     bh_tbl-key ne ?
      773             then
      774                delete object bh_tbl-key.
      775             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info6, p-key-handle:name, v-field-name ).
      776           end.
      777           assign
      778             v-field-val = fh_key:buffer-value
      779           .
      780         end.
      781         if fh_search:data-type ="character":U then do:
      782           assign
      783             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      784             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      785             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      786             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      787             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      788             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      789             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      790             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      791             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      792             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      793             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      794             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      795             v-field-val = substitute( '"&1"', v-field-val )
      796           .
      797         end.
      798         assign
      799           o-where = substitute( "&1 &2", o-where, v-field-val )
      800         .
      801         if v-word-link = "":U then do:
      802           assign
      803             v-word-link = "and":U
      804           .
      805         end.
      806       end.
      807       delete object bh_tbl-name.
      808       if     bh_tbl-key ne ?
      809       then
      810          delete object bh_tbl-key.
      811       if p-key-handle = ?
      812         and v-count-fld <> v-field-num
      813       then do:
      814         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info6, vTable ).
      815       end.
      816     end.
      817   end procedure.
      818   procedure gen-hn-keyr-tab :
      819     define input  parameter i-tableSerach as character no-undo.
      820     define input  parameter i-tablekey   as character no-undo.
      821     define input  parameter p-key-rec    as character no-undo.
      822     define input  parameter p-key-handle as handle    no-undo .
      823     define input  parameter p-db-name    as character no-undo .
      824     define input  parameter p-tt-handle  as handle    no-undo .
      825     define input  parameter p-stts-lock  as integer   no-undo .
      826     define output parameter o-hn         as handle    no-undo.
      827     define variable v-full-tbl-name as character no-undo.
      828     define variable v-where         as character no-undo.
      829     define variable bh_tbl-name     as handle    no-undo.
      830     define variable vTable          as character no-undo.
      831     do
      832     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      833     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      834     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      835         run gen-where-keyr-tab(i-tableSerach,
      836                                i-tablekey,
      837                                p-key-rec,
      838                                p-key-handle,
      839                                p-db-name,
      840                                p-tt-handle,
      841                                output v-where).
      842         if i-tableSerach ne "" and i-tableSerach ne ?
      843         then do:
      844            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      845            create buffer bh_tbl-name for table v-full-tbl-name .
      846         end.
      847         else do:
      848            if p-tt-handle = ? then do:
      849               assign
      850                  vTable = entry( 1 , p-key-rec, chr(3) )
      851               .
      852               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      853               create buffer bh_tbl-name for table v-full-tbl-name .
      854            end.
      855            else do:
      856               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      857            end.
      858         end.
      859         if p-tt-handle = ? then do:
      860            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      861         end.
      862         else do:
      863            bh_tbl-name:find-first( v-where ) no-error .
      864         end.
      865         o-hn = bh_tbl-name.
      866      end.
      867   end procedure.
      868   procedure gen-hn-keyr :
      869     define input  parameter p-key-rec    as character no-undo.
      870     define input  parameter p-key-handle as handle    no-undo .
      871     define input  parameter p-db-name    as character no-undo .
      872     define input  parameter p-tt-handle  as handle    no-undo .
      873     define input  parameter p-stts-lock  as integer   no-undo .
      874     define output parameter o-hn         as handle    no-undo.
      875     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      876   end.
      877   procedure gen-row-keyr :
      878     define input  parameter p-key-rec    as character no-undo.
      879     define input  parameter p-key-handle as handle    no-undo .
      880     define input  parameter p-db-name    as character no-undo .
      881     define input  parameter p-tt-handle  as handle    no-undo .
      882     define input  parameter p-stts-lock  as integer   no-undo .
      883     define output parameter p-tbl-row    as rowid     no-undo.
      884     define output parameter p-tbl-name   as character no-undo.
      885     define variable vHn as handle no-undo.
      886       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      887       p-tbl-row = if vHn:available then vHn:rowid else ?.
      888       p-tbl-name =  vHn:table.
      889       delete object vHn no-error.
      890     if p-tbl-row = ? then do:
      891       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info6, p-tbl-name, p-key-rec ).
      892     end.
      893     else do:
      894       return.
      895     end.
      896   end procedure.
      897   procedure gen-key-fv :
      898     define input  parameter p-key-rec    as character no-undo .
      899     define output parameter p-field-list as character no-undo .
      900     define output parameter p-value-list as character no-undo.
      901     do
      902     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      903     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      904     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      905     :
      906       define variable v-full-tbl-name  as character no-undo .
      907       define variable bh_tbl-name      as handle    no-undo .
      908       define variable v-tbl-name       as character no-undo .
      909       define variable v-field-num      as integer   no-undo .
      910       define variable v-count-fld      as integer   no-undo .
      911       define variable v-inform         as character no-undo .
      912       define variable v-ind            as integer   no-undo .
      913       define variable v-idx-field-qnty as integer   no-undo .
      914       define variable v-delim-key      as character no-undo .
      915       if p-key-rec = ?
      916         or p-key-rec = "":U
      917       then do:
      918         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info6 ).
      919       end.
      920       assign
      921         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      922         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      923       .
      924       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      925       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info6 ).
      926       assign
      927         v-inform = bh_tbl-name:index-information(1)
      928         v-ind    = 2
      929       .
      930       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      931       on error undo, return error
      932       :
      933         assign
      934           v-inform = bh_tbl-name:index-information( v-ind )
      935           v-ind    = v-ind + 1
      936         .
      937       end.
      938       if v-inform = ?
      939         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      940         or entry( 3, v-inform, ",":U ) <> "1":U
      941       then do:
      942         delete object bh_tbl-name no-error.
      943         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
      944       end.
      945       assign
      946         v-idx-field-qnty = num-entries( v-inform ) - 4
      947       .
      948       if v-idx-field-qnty < 2 then do:
      949         delete object bh_tbl-name no-error.
      950         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
      951       end.
      952       assign
      953         p-field-list = "":U
      954         p-value-list = "":U
      955         v-delim-key  = "":U
      956         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      957         v-count-fld  = 0
      958       .
      959       block_where:
      960       do v-ind = 1 to v-idx-field-qnty by 2
      961       on error undo, return error
      962       :
      963         assign
      964           v-count-fld = v-count-fld + 1
      965         .
      966         if v-count-fld > v-field-num then do:
      967           leave block_where.
      968         end.
      969         assign
      970           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      971           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      972         .
      973         if v-ind = 1 then do:
      974           assign
      975             v-delim-key = chr(3)
      976           .
      977         end.
      978       end.
      979       delete object bh_tbl-name.
      980       if v-count-fld <> v-field-num then do:
      981         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info6, v-tbl-name ).
      982       end.
      983     end.
      984   end procedure.
      985   procedure gen-key-field :
      986     define input  parameter p-table      as character no-undo .
      987     define output parameter p-field-list as character no-undo .
      988     do
      989     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      990     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      991     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      992     :
      993       define variable v-full-tbl-name  as character no-undo .
      994       define variable bh_tbl-name      as handle    no-undo .
      995       define variable v-tbl-name       as character no-undo .
      996       define variable v-field-num      as integer   no-undo .
      997       define variable v-count-fld      as integer   no-undo .
      998       define variable v-inform         as character no-undo .
      999       define variable v-ind            as integer   no-undo .
     1000       define variable v-idx-field-qnty as integer   no-undo .
     1001       define variable v-delim-key      as character no-undo .
     1002       if p-table = ?
     1003         or p-table = "":U
     1004       then do:
     1005         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info6 ).
     1006       end.
     1007       assign
     1008         v-tbl-name      = p-table
     1009         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1010       .
     1011       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1012       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info6 ).
     1013       assign
     1014         v-inform = bh_tbl-name:index-information(1)
     1015         v-ind    = 2
     1016       .
     1017       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1018       on error undo, return error
     1019       :
     1020         assign
     1021           v-inform = bh_tbl-name:index-information( v-ind )
     1022           v-ind    = v-ind + 1
     1023         .
     1024       end.
     1025       if v-inform = ?
     1026         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1027         or entry( 3, v-inform, ",":U ) <> "1":U
     1028       then do:
     1029         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info6, v-tbl-name ).
     1030       end.
     1031       assign
     1032         v-idx-field-qnty = num-entries( v-inform ) - 4
     1033       .
     1034       if v-idx-field-qnty < 2 then do:
     1035         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info6, v-inform, v-tbl-name ).
     1036       end.
     1037       assign
     1038         p-field-list = "":U
     1039         v-delim-key  = "":U
     1040         v-count-fld  = 0
     1041       .
     1042       block_where:
     1043       do v-ind = 1 to v-idx-field-qnty by 2
     1044       on error undo, return error
     1045       :
     1046         assign
     1047           v-count-fld = v-count-fld + 1
     1048         .
     1049         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1050         if v-ind = 1 then do:
     1051           assign
     1052             v-delim-key = chr(3)
     1053           .
     1054         end.
     1055       end.
     1056       delete object bh_tbl-name.
     1057     end.
     1058   end procedure.
     1059   procedure get-gate-file-name :
     1060   define input parameter p-gate-rec as character no-undo .
     1061   define output  parameter p-gate-file-name as character no-undo .
     1062   define buffer buf_clob-data for ub.clob-data.
     1063   define variable v-tbl-row as rowid no-undo .
     1064   define variable v-tbl-name as character no-undo .
     1065   run gen-row-keyr in this-procedure ( input p-gate-rec
     1066                                       ,input ?
     1067                                       ,input "ub"
     1068                                       ,input ?
     1069                                       ,input no-lock
     1070                                       ,output v-tbl-row
     1071                                       ,output v-tbl-name) no-error.
     1072   if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1073                                                           ,vss-include-info4
     1074                                                           ,p-gate-rec).
     1075   find first buf_clob-data no-lock where
     1076             rowid(buf_clob-data) = v-tbl-row no-error.
     1077   if not available buf_clob-data then do:
     1078     if error-status:error then undo, return error substitute("&1 (get-gate-name) Несуществующий gate &2"
     1079                                                             ,vss-include-info4
     1080                                                             ,p-gate-rec).
     1081   end.
     1082   p-gate-file-name = buf_clob-data.file-name.
     1083   end procedure.
     1084   procedure get-gate-rec :
     1085   define input  parameter p-gate-name as character no-undo .
     1086   define output parameter p-gate-rec as character no-undo .
     1087   define buffer buf_clob-bind for ub.clob-bind.
     1088   define buffer buf_clob-data for ub.clob-data.
     1089   main-block:
     1090   do
     1091   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
     1092   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
     1093   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
     1094   :
     1095       find first buf_clob-bind no-lock where
     1096                 buf_clob-bind.uniq-key-rec = p-gate-name
     1097             and buf_clob-bind.field-name = '':U
     1098             and buf_clob-bind.part-num = 1
     1099             and buf_clob-bind.resource-type = 'gate':U
     1100             no-error.
     1101       if not available buf_clob-bind then do:
     1102         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1103                                         , p-gate-name
     1104                                         ).
     1105       end.
     1106       find first buf_clob-data no-lock where
     1107                 buf_clob-data.db-num = buf_clob-bind.db-num
     1108             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1109       if not available buf_clob-data then do:
     1110         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1111                                         , buf_clob-bind.db-num
     1112                                         , buf_clob-bind.int64-id
     1113                                         , p-gate-name
     1114                                         ).
     1115       end.
     1116       run gen-key-rec in this-procedure ( input 'clob-data':U
     1117                                 ,input buffer buf_clob-data:handle
     1118                                 ,output p-gate-rec).
     1119   end.
     1120   end procedure.
     1121   procedure get-gate-by-name :
     1122   define input  parameter p-gate-name as character no-undo .
     1123   define output parameter p-gate-rec as character no-undo .
     1124   define output parameter p-dsh as handle no-undo .
     1125   define input-output  parameter p-xmlh as handle no-undo .
     1126   define variable v-ii as integer   no-undo .
     1127   define variable glog as logical   no-undo .
     1128   define variable v-longchar as longchar no-undo .
     1129   define variable v-txmlh as handle no-undo .
     1130   define variable v-db-num as integer no-undo .
     1131   define variable v-int64-id as int64 no-undo .
     1132   define buffer buf_clob-bind for ub.clob-bind.
     1133   define buffer buf_clob-data for ub.clob-data.
     1134   main-block:
     1135   do
     1136   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
     1137   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
     1138   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
     1139   :
     1140       find first buf_clob-bind no-lock where
     1141                 buf_clob-bind.uniq-key-rec = p-gate-name
     1142             and buf_clob-bind.field-name = '':U
     1143             and buf_clob-bind.part-num = 1
     1144             and buf_clob-bind.resource-type = 'gate':U
     1145             no-error.
     1146       if not available buf_clob-bind then do:
     1147         undo, return error substitute("Неверная ссылка на XSD -файл &1 для gate"
     1148                                         , p-gate-name
     1149                                         ).
     1150       end.
     1151       find first buf_clob-data no-lock where
     1152                 buf_clob-data.db-num = buf_clob-bind.db-num
     1153             and buf_clob-data.int64-i= buf_clob-bind.int64-id no-error.
     1154       if not available buf_clob-data then do:
     1155         undo, return error substitute("Не найден CLOB c ДБ &1 id &2 - файл &3"
     1156                                         , buf_clob-bind.db-num
     1157                                         , buf_clob-bind.int64-id
     1158                                         , p-gate-name
     1159                                         ).
     1160       end.
     1161       assign
     1162       v-longchar = buf_clob-data.cdata
     1163       .
     1164       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1165       if error-status :error then do:
     1166         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1167       end.
     1168       create dataset p-dsh .
     1169       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1170                                     , v-longchar
     1171                                     , ?
     1172                                     , ?
     1173                                     , ?
     1174                                     ) no-error.
     1175       v-longchar = '':U.
     1176       if error-status :error
     1177       or not glog
     1178       then do:
     1179         undo, return error substitute("Не удалось прочитать XML-схему &1 из БД:&2&3", p-gate-name, chr(10), error-status:get-message(1) ).
     1180       end.
     1181       if not valid-handle(p-xmlh)
     1182       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1183         create temp-table v-txmlh.
     1184         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1185         v-txmlh:temp-table-prepare("temp-xml-tables").
     1186         p-xmlh = v-txmlh:default-buffer-handle.
     1187       end.
     1188       run gen-key-rec in this-procedure ( input 'clob-data':U
     1189                                 ,input buffer buf_clob-data:handle
     1190                                 ,output p-gate-rec).
     1191       do v-ii = 1 to p-dsh:num-buffers:
     1192         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1193         if not p-xmlh:available then do:
     1194           p-xmlh:buffer-create().
     1195           assign
     1196           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1197           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1198           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1199           p-xmlh::gate-handle_ = p-dsh
     1200           p-xmlh::uniq-gate-rec = p-gate-rec
     1201           p-xmlh::gate-name = p-dsh:name
     1202           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1203           .
     1204           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1205             assign
     1206             p-xmlh::order = -3.
     1207           end.
     1208         end.
     1209       end.
     1210   end.
     1211   end procedure.
     1212   procedure get-gate-by-rec :
     1213   define input  parameter p-gate-rec as character no-undo .
     1214   define output parameter p-dsh as handle no-undo .
     1215   define input-output  parameter p-xmlh as handle no-undo .
     1216   define input-output parameter p-longchar  as longchar no-undo .
     1217   define variable v-ii as integer   no-undo .
     1218   define variable glog as logical   no-undo .
     1219   define variable v-rowid as rowid no-undo .
     1220   define variable v-tbl-name as character no-undo .
     1221   define variable v-longchar as longchar no-undo .
     1222   define variable v-txmlh as handle no-undo .
     1223   define buffer buf_clob-data for ub.clob-data.
     1224   main-block:
     1225   do
     1226   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
     1227   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
     1228   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
     1229   :
     1230     run gen-row-keyr in this-procedure (
     1231                                           input  p-gate-rec
     1232                                           ,input  ?
     1233                                           ,input  "ub"
     1234                                           ,input  ?
     1235                                           ,input  NO-LOCK
     1236                                           ,output v-rowid
     1237                                           ,output v-tbl-name   ) no-error.
     1238       find first buf_clob-data no-lock where
     1239                 rowid(buf_clob-data) = v-rowid  no-error.
     1240       if not available buf_clob-data then do:
     1241         undo, return error substitute("Не найден CLOB  &1"
     1242                                         , p-gate-rec
     1243                                         ).
     1244       end.
     1245       assign
     1246       v-longchar = buf_clob-data.cdata
     1247       .
     1248       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1249       if error-status :error then do:
     1250         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1251       end.
     1252       create dataset p-dsh .
     1253       glog = p-dsh:READ-XMLSCHEMA( "LONGCHAR"
     1254                                     , v-longchar
     1255                                     , ?
     1256                                     , ?
     1257                                     , ?
     1258                                     ) no-error.
     1259       define variable v-esm as character no-undo .
     1260       v-esm = error-status:get-message(1) .
     1261       if p-longchar <> ? then do:
     1262         p-longchar = v-longchar.
     1263       end.
     1264       v-longchar = '':U.
     1265       if error-status :error
     1266       or not glog
     1267       then do:
     1268         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1269                                      , p-gate-rec
     1270                                      , p-gate-rec
     1271                                      , v-esm
     1272                                      ).
     1273       end.
     1274       p-dsh:private-data = buf_clob-data.file-name_ + chr(4) + p-gate-rec.
     1275       if not valid-handle(p-xmlh)
     1276       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1277         create temp-table v-txmlh.
     1278         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1279         v-txmlh:temp-table-prepare("temp-xml-tables").
     1280         p-xmlh = v-txmlh:default-buffer-handle.
     1281       end.
     1282       do v-ii = 1 to p-dsh:num-buffers:
     1283         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1284         if not p-xmlh:available then do:
     1285           p-xmlh:buffer-create().
     1286           assign
     1287           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1288           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1289           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1290           p-xmlh::gate-handle_ = p-dsh
     1291           p-xmlh::uniq-gate-rec = p-gate-rec
     1292           p-xmlh::gate-name = p-dsh:name
     1293           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1294           .
     1295           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1296             assign
     1297             p-xmlh::order = -3.
     1298           end.
     1299           p-xmlh:buffer-release().
     1300         end.
     1301       end.
     1302   end.
     1303   end procedure.
     1304   procedure get-gate-by-file :
     1305   define input  parameter p-schema-file-name as character no-undo .
     1306   define input  parameter p-gate-rec as character no-undo .
     1307   define output parameter p-dsh as handle no-undo .
     1308   define input-output  parameter p-xmlh as handle no-undo .
     1309   define variable v-ii as integer   no-undo .
     1310   define variable glog as logical   no-undo .
     1311   define variable v-rowid as rowid no-undo .
     1312   define variable v-tbl-name as character no-undo .
     1313   define variable v-longchar as longchar no-undo .
     1314   define variable v-txmlh as handle no-undo .
     1315   main-block:
     1316   do
     1317   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1))
     1318   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info4 )
     1319   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info4 )
     1320   :
     1321       COPY-LOB
     1322       FROM  FILE p-schema-file-name
     1323       TO  OBJECT v-longchar
     1324       no-convert
     1325       NO-ERROR .
     1326       if error-status :error then do:
     1327           undo, return error substitute("Не удалось считать файл схемы &1 в память&2&3"
     1328                                     , p-schema-file-name
     1329                                 , chr(10)
     1330                                 , error-status:get-message(1) ).
     1331       end.
     1332       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1333       if error-status :error then do:
     1334         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, p-schema-file-name, chr(10), error-status:get-message(1) , return-value ).
     1335       end.
     1336       create dataset p-dsh .
     1337       glog = p-dsh:READ-XMLSCHEMA( "longchar"
     1338                                     , v-longchar
     1339                                     , ?
     1340                                     , ?
     1341                                     , ?
     1342                                     ) no-error.
     1343       v-longchar = ''.
     1344       if error-status :error
     1345       or not glog
     1346       then do:
     1347         undo, return error substitute("Не удалось прочитать XML-схему из файла &1&2&3"
     1348                                      , p-schema-file-name
     1349                                      ,chr(10)
     1350                                      , error-status:get-message(1)
     1351                                      ).
     1352       end.
     1353       if not valid-handle(p-xmlh)
     1354       or not valid-handle(p-xmlh:buffer-field("tbl-name")) then do:
     1355         create temp-table v-txmlh.
     1356         v-txmlh:create-like(buffer temp-xml-tables:handle).
     1357         v-txmlh:temp-table-prepare("temp-xml-tables").
     1358         p-xmlh = v-txmlh:default-buffer-handle.
     1359       end.
     1360       do v-ii = 1 to p-dsh:num-buffers:
     1361         p-xmlh:find-first(substitute(' where tbl-name = "&1" and  uniq-gate-rec = "&2" '
     1362                                      ,p-dsh:get-buffer-handle(v-ii):name
     1363                                      ,p-gate-rec
     1364                                      )) no-error.
     1365         if not p-xmlh:available then do:
     1366           p-xmlh:buffer-create().
     1367           assign
     1368           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):table
     1369           p-xmlh::uniq-gate-rec = p-gate-rec
     1370           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1371           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1372           p-xmlh::gate-handle_ = p-dsh
     1373           p-xmlh::gate-name = p-dsh:name
     1374           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1375           .
     1376           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1377             assign
     1378             p-xmlh::order = -3.
     1379           end.
     1380           p-xmlh:buffer-release().
     1381         end.
     1382       end.
     1383   end.
     1384   end procedure.
     1385   procedure gate-clear :
     1386   define input  parameter p-dsh as handle no-undo .
     1387   define input  parameter p-xmlh as handle no-undo .
     1388   define variable v-dsh as handle no-undo .
     1389   define variable v-th as handle no-undo .
     1390     do
     1391     on error undo, return error return-value
     1392     :
     1393       if valid-handle(p-dsh) then do:
     1394         delete object p-dsh.
     1395         v-dsh = p-dsh.
     1396         p-dsh = ?.
     1397       end.
     1398       repeat while true:
     1399         p-xmlh:find-first( substitute( " where gate-handle_ = &1 ", v-dsh)
     1400                            , share-lock) no-error.
     1401         if p-xmlh:available then do:
     1402           assign
     1403           v-th = p-xmlh:buffer-field("table-handle_"):buffer-value.
     1404           if valid-handle(p-xmlh:buffer-field("table-handle_"))
     1405           and valid-handle(v-th)
     1406           and v-th:dynamic = yes
     1407           then do:
     1408             delete object p-xmlh:buffer-field("table-handle_"):buffer-value.
     1409             p-xmlh:buffer-field("table-handle_"):buffer-value = ?.
     1410           end.
     1411           p-xmlh:buffer-delete().
     1412         end.
     1413         else do:
     1414           leave.
     1415         end.
     1416       end.
     1417       if p-xmlh:dynamic = yes
     1418       and valid-handle(p-xmlh)
     1419       then do:
     1420         delete object p-xmlh:table-handle.
     1421         p-xmlh = ?.
     1422       end.
     1423       v-dsh = ?.
     1424     end.
     1425   end procedure.
     1426   procedure all-gates-clear :
     1427   define parameter buffer buf_temp-xml-tables for temp-xml-tables.
     1428   do
     1429   on error undo, return error
     1430   :
     1431     for each buf_temp-xml-tables
     1432     break
     1433     by buf_temp-xml-tables.uniq-gate-rec
     1434     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1435     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1436     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1437     :
     1438         if first-of(buf_temp-xml-tables.uniq-gate-rec) then do:
     1439           delete object buf_temp-xml-tables.gate-handle_.
     1440           buf_temp-xml-tables.gate-handle_ = ?.
     1441         end.
     1442         if valid-handle(buf_temp-xml-tables.table-handle_)
     1443         and buf_temp-xml-tables.table-handle_:dynamic = no
     1444         then do:
     1445           delete object buf_temp-xml-tables.table-handle_.
     1446           buf_temp-xml-tables.table-handle_ = ?.
     1447         end.
     1448         delete buf_temp-xml-tables.
     1449     end.
     1450   end.
     1451   end procedure.
     1452   procedure fix-schemalocation :
     1453   define input-output  parameter p-longchar as longchar no-undo .
     1454   DEFINE VARIABLE hdoc AS HANDLE.
     1455   DEFINE VARIABLE hroot AS HANDLE.
     1456   DEFINE VARIABLE hnode-child AS HANDLE.
     1457   DEFINE VARIABLE hnode-attr AS HANDLE.
     1458   define variable v-jj as integer   no-undo .
     1459   define variable ok as logical   no-undo .
     1460   define variable v-path1                    as character                no-undo .
     1461   DEFINE VARIABLE v-full-path1               as character                no-undo .
     1462   DEFINE VARIABLE v-file-name1               as character                no-undo .
     1463   DEFINE VARIABLE v-file-name-no-ext1        as character                no-undo .
     1464   DEFINE VARIABLE v-file-name-ext1           as character                no-undo .
     1465   define variable v-schema-location          as character                no-undo .
     1466   do
     1467   on error undo, return error return-value
     1468   :
     1469     CREATE X-DOCUMENT hdoc.
     1470     CREATE X-noderef hroot.
     1471     CREATE X-noderef hnode-child.
     1472     CREATE X-noderef hnode-attr.
     1473     hdoc:load("longchar", p-longchar, no) no-error.
     1474     iF ERROR-STATUS:GET-MESSAGE(1) <> '' THEN message ERROR-STATUS:GET-MESSAGE(1) view-as alert-box .
     1475     hdoc:get-document-element(hroot).
     1476     _repeat:
     1477     REPEAT v-jj = 1 TO hroot:NUM-CHILDREN:
     1478       ok = hroot:GET-CHILD(hNode-Child, v-jj).
     1479       if not ok then next.
     1480       if hNode-Child:local-name = "include"
     1481       then do:
     1482         ok = hNode-Child:GET-ATTRIBUTE-NODE( hnode-attr, "schemaLocation" ).
     1483           v-schema-location = hnode-attr:node-value.
     1484           run gbl/filename.p (
     1485                           input "exe/" + hnode-attr:node-value
     1486                         ,output v-full-path1
     1487                         ,output v-path1
     1488                         ,output v-file-name1
     1489                         ,output v-file-name-no-ext1
     1490                         ,output v-file-name-ext1
     1491                         ) no-error .
     1492           if error-status :error then do:
     1493             delete object hnode-attr.
     1494             delete object hnode-child.
     1495             delete object hroot.
     1496             delete object hdoc.
     1497             undo, return error substitute("Не удалось определить расположение схемы &1", v-schema-location).
     1498           end.
     1499         ok = hNode-Child:sET-ATTRIBUTE(  "schemaLocation", v-full-path1 ).
     1500         leave  _repeat.
     1501       end.
     1502     END.
     1503     hdoc:save("longchar", p-longchar).
     1504     delete object hnode-attr.
     1505     delete object hnode-child.
     1506     delete object hroot.
     1507     delete object hdoc.
     1508   end.
     1509   end procedure.
     1510   procedure gate-clb_fill-xml-tables :
     1511   define input parameter p-dsh as handle no-undo .
     1512   define input-output parameter p-xmlh as handle no-undo .
     1513   define variable v-ii as integer no-undo .
     1514     do
     1515     on error undo, return error
     1516     :
     1517       do v-ii = 1 to p-dsh:num-buffers:
     1518         p-xmlh:find-first(substitute(' where tbl-name = "&1"', p-dsh:get-buffer-handle(v-ii):name)) no-error.
     1519         if not p-xmlh:available then do:
     1520           p-xmlh:buffer-create().
     1521           assign
     1522           p-xmlh::tbl-name = p-dsh:get-buffer-handle(v-ii):name
     1523           p-xmlh::tbl-handle_ = p-dsh:get-buffer-handle(v-ii)
     1524           p-xmlh::table-handle_ = p-dsh:get-buffer-handle(v-ii):table-handle
     1525           p-xmlh::gate-handle_ = p-dsh
     1526           p-xmlh::uniq-gate-rec = entry(2, p-dsh:private-data, chr(4))
     1527           p-xmlh::gate-name = p-dsh:name
     1528           p-xmlh::is-parent = not valid-handle(p-dsh:get-buffer-handle(v-ii):parent-relation)
     1529           .
     1530           if lookup(p-xmlh::tbl-name, "thheader,header_") > 0 then do:
     1531             assign
     1532             p-xmlh::order = -3.
     1533           end.
     1534           p-xmlh:buffer-release().
     1535         end.
     1536       end.
     1537     end.
     1538   end procedure.
     1539   procedure all-gates-empty :
     1540   define buffer buf_temp-xml-tables for temp-xml-tables.
     1541   do
     1542   on error undo, return error
     1543   :
     1544     for each buf_temp-xml-tables
     1545     break
     1546     by buf_temp-xml-tables.uniq-gate-rec
     1547     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1548     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1549     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1550     :
     1551       if valid-handle(buf_temp-xml-tables.tbl-handle_) then do:
     1552         buf_temp-xml-tables.tbl-handle_:empty-temp-table().
     1553       end.
     1554     end.
     1555   end.
     1556   end procedure.
     1557   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1558   define temp-table THpck-sent no-undo
     1559   field THfilename as character field THcrc-pack as character field THcredate as date field THcrenum as integer  field THcretimeint as integer field THcretime as character   field THrcvddate  as date field THpack-num  as integer  field THrcvdtimeint as integer field THrcvdtime  as character   field THrcvd  as logical      field THsendtxtdate as date field THsendtxttimeint as integer field THsendtxttime as character  field THtotal-recs  as integer  field THesys-id  as integer     index pi is unique primary THesys-id                  THpack-num                 index ircvd                THesys-id                  THrcvd
     1560   .
     1561   define temp-table THcurr-pack no-undo
     1562   field THfilename as character field THcrc-pack as character field THcredate as date field THcrenum as integer  field THcretimeint as integer field THcretime as character   field THrcvddate  as date field THpack-num  as integer  field THrcvdtimeint as integer field THrcvdtime  as character   field THrcvd  as logical      field THsendtxtdate as date field THsendtxttimeint as integer field THsendtxttime as character  field THtotal-recs  as integer  field THesys-id  as integer     index pi is unique primary THesys-id                  THpack-num                 index ircvd                THesys-id                  THrcvd
     1563   .
     1564   define temp-table THpck-rcvd no-undo
     1565   field THfilename as character
     1566   field THesys-id  as integer
     1567   field THcrc-pack as character
     1568   field THpack-num  as integer
     1569   field THrcvd-recs  as integer
     1570   field THrcvd as logical
     1571   field THtotal-recs  as integer
     1572   field THrcvddate  as date
     1573   field THrcvdtimeint as integer
     1574   field THrcvdtime  as character
     1575   index pi is unique primary
     1576   THesys-id
     1577   THpack-num
     1578   index rcvd
     1579   THesys-id
     1580   THrcvd
     1581   .
     1582   procedure get-header-by-rec :
     1583   define input  parameter p-gate-rec as character no-undo .
     1584   define output parameter p-tth as handle no-undo .
     1585   define variable v-ii as integer   no-undo .
     1586   define variable glog as logical   no-undo .
     1587   define variable v-rowid as rowid no-undo .
     1588   define variable v-tbl-name as character no-undo .
     1589   define variable v-longchar as longchar no-undo .
     1590   define variable v-txmlh as handle no-undo .
     1591   define buffer buf_clob-data for ub.clob-data.
     1592   main-block:
     1593   do
     1594   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-include-info7, return-value, chr(10), error-status :get-message (1))
     1595   on stop   undo main-block, return error substitute( "&1. stop", vss-include-info7 )
     1596   on endkey undo main-block, return error substitute( "&1. endkey", vss-include-info7 )
     1597   :
     1598     run gen-row-keyr in  this-procedure  (
     1599                                           input  p-gate-rec
     1600                                           ,input  ?
     1601                                           ,input  "ub"
     1602                                           ,input  ?
     1603                                           ,input  NO-LOCK
     1604                                           ,output v-rowid
     1605                                           ,output v-tbl-name   ) no-error.
     1606       find first buf_clob-data no-lock where
     1607                 rowid(buf_clob-data) = v-rowid  no-error.
     1608       if not available buf_clob-data then do:
     1609         undo, return error substitute("Не найден CLOB  &1"
     1610                                         , p-gate-rec
     1611                                         ).
     1612       end.
     1613       assign
     1614       v-longchar = buf_clob-data.cdata
     1615       .
     1616       run fix-schemalocation in this-procedure ( input-output v-longchar) no-error.
     1617       if error-status :error then do:
     1618         undo, return error substitute("Не удалось определить расположение составных частей схемы &1 (&2) из БД&3&4&3&5", p-gate-rec, buf_clob-data.file-name_, chr(10), error-status:get-message(1) , return-value ).
     1619       end.
     1620       create temp-table p-tth .
     1621       glog = p-tth:READ-XMLSCHEMA( "LONGCHAR"
     1622                                     , v-longchar
     1623                                     , ?
     1624                                     , ?
     1625                                     , ?
     1626                                     ) no-error.
     1627       v-longchar = '':U.
     1628       define variable v-esm as character no-undo .
     1629       v-esm = error-status:get-message(1).
     1630       if error-status :error
     1631       or not glog
     1632       then do:
     1633         delete object p-tth no-error.
     1634         undo, return error substitute("Не удалось прочитать XML-схему &1 (&2) из БД&3&4"
     1635                                    , p-gate-rec
     1636                                    , buf_clob-data.file-name_
     1637                                    , chr(10)
     1638                                    , v-esm
     1639                                     ).
     1640       end.
     1641   end.
     1642   end procedure.
     1643   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1644   procedure fillxpck :
     1645   define parameter buffer buf_esys-route for ub.esys-route.
     1646   define output parameter p-dataseth as handle no-undo .
     1647   define input-output parameter p-xmlh as handle no-undo .
     1648   define output parameter p-num-rec as integer no-undo .
     1649   define variable bh_route-dump as handle no-undo .
     1650   define variable tt-name as character no-undo .
     1651   define variable v-ok as logical no-undo .
     1652   define variable v-route-order-field as character no-undo .
     1653   define variable v-dump-order-field as character no-undo .
     1654   define variable v-esys-id as integer no-undo .
     1655   define variable v-db-num as integer no-undo .
     1656   define variable v-cr-db-num as integer no-undo .
     1657   define variable v-esr-dump-ord as int64 no-undo .
     1658   define variable v-esr-tbl-ord as int64 no-undo .
     1659   define variable v-pack-num as integer no-undo .
     1660   define buffer buf_esys-route-dump for ub.esys-route-dump.
     1661   define buffer buf_temp-xml-tables for temp-xml-tables.
     1662     main-block:
     1663     do
     1664     on error undo, return error
     1665     :
     1666       define variable v-longchar as longchar no-undo .
     1667       v-longchar = ?.
     1668       run get-gate-by-rec in this-procedure ( input buf_esys-route.uniq-gate-rec
     1669                                               ,output p-dataseth
     1670                                               ,input-output p-xmlh
     1671                                               ,input-output v-longchar
     1672                                               ) no-error.
     1673       if error-status:error then do:
     1674           undo main-block, return error substitute("Ошибка при создании структуры маршрутизируемых данных согласно гейту:&1&2"
     1675                               , buf_esys-route.uniq-gate-rec
     1676                               , chr(10)
     1677                               , error-status:get-message(1) ).
     1678       end.
     1679       run all-gates-empty in this-procedure no-error.
     1680       assign
     1681       v-esys-id = buf_esys-route.esys-id
     1682       v-db-num = buf_esys-route.db-num
     1683       v-cr-db-num = buf_esys-route.esr-cr-db-num
     1684       v-esr-dump-ord = buf_esys-route.esr-dump-ord
     1685       v-esr-tbl-ord = buf_esys-route.esr-tbl-ord
     1686       v-pack-num = buf_esys-route.esr-last-pack
     1687       .
     1688       _fill:
     1689       do while true:
     1690         assign
     1691         v-route-order-field = ''
     1692         v-dump-order-field = ''
     1693         .
     1694       for each buf_esys-route-dump where
     1695             buf_esys-route-dump.esrd-dump-ord   = v-esr-dump-ord
     1696       by buf_esys-route-dump.esrd-rec-ord
     1697       by buf_esys-route-dump.esrd-cr-db-num
     1698       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1699       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1700       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1701       :
     1702         bh_route-dump = (buffer buf_esys-route-dump:handle).
     1703         if buf_esys-route-dump.uniq-gate-rec <> '':u then do:
     1704           find first buf_temp-xml-tables where
     1705                     buf_temp-xml-tables.tbl-name = buf_esys-route-dump.esrd-dump-name
     1706                 and buf_temp-xml-tables.uniq-gate-rec = buf_esys-route-dump.uniq-gate-rec no-error.
     1707           if not available buf_temp-xml-tables then do:
     1708             run gate-clear in this-procedure ( input p-dataseth, input p-xmlh).
     1709             undo main-block, return error substitute( "&1. Не найдена таблица &2 в гейте &3 (1).&4&5"
     1710                                       , vss-workfile
     1711                                       , buf_esys-route-dump.esrd-dump-name
     1712                                       , buf_esys-route-dump.uniq-gate-rec
     1713                                       , chr(10)
     1714                                       , error-status:get-message(1) ).
     1715           end.
     1716           if buf_temp-xml-tables.is-parent
     1717           and not (buf_esys-route-dump.esrd-action begins "_hidden="
     1718                     or buf_esys-route-dump.esrd-action begins "_route-order="
     1719                     or buf_esys-route-dump.esrd-action begins "_dump-order="
     1720                     )
     1721           then do:
     1722             p-num-rec = p-num-rec + 1.
     1723           end.
     1724         end.
     1725         else do:
     1726           find first buf_temp-xml-tables where
     1727                     buf_temp-xml-tables.tbl-name = buf_esys-route-dump.esrd-dump-name
     1728                 and buf_temp-xml-tables.uniq-gate-rec = '':U no-error.
     1729           if not available buf_temp-xml-tables then do:
     1730             create buf_temp-xml-tables.
     1731             assign
     1732             buf_temp-xml-tables.tbl-name = buf_esys-route-dump.esrd-dump-name
     1733             buf_temp-xml-tables.tbl-handle_ = ?
     1734             buf_temp-xml-tables.table-handle_ = ?
     1735             buf_temp-xml-tables.gate-handle_ = ?
     1736             buf_temp-xml-tables.uniq-gate-rec = ''
     1737             buf_temp-xml-tables.gate-name = ''
     1738             .
     1739             create temp-table buf_temp-xml-tables.table-handle_.
     1740             assign
     1741             buf_temp-xml-tables.table-handle_:undo      = false
     1742             tt-name       = "tt_":U + buf_esys-route-dump.esrd-dump-name
     1743             .
     1744             assign
     1745             v-ok = buf_temp-xml-tables.table-handle_:create-like( "ub.":U + buf_esys-route-dump.esrd-dump-name ) no-error
     1746             .
     1747             if v-ok <> true
     1748               or error-status :error
     1749             then do:
     1750               run gate-clear in this-procedure ( input p-dataseth, input p-xmlh).
     1751               undo main-block, return error substitute( "&1. Ошибка при создании временной таблицы &2 (1).&3&4", vss-workfile, tt-name, chr(10), error-status:get-message(1) ).
     1752             end.
     1753             assign
     1754               v-ok = buf_temp-xml-tables.table-handle_:temp-table-prepare( tt-name ) no-error
     1755             .
     1756             if v-ok <> true
     1757               or error-status :error
     1758             then do:
     1759               run gate-clear in this-procedure ( input p-dataseth, input p-xmlh).
     1760               undo main-block, return error substitute( "&1. Ошибка при создании временной таблицы &2 (2).&3&4", vss-workfile, tt-name, chr(10), error-status:get-message(1) ).
     1761             end.
     1762           end.
     1763           assign
     1764           buf_temp-xml-tables.tbl-handle_ = buf_temp-xml-tables.table-handle_:default-buffer-handle
     1765           p-num-rec = p-num-rec + 1
     1766           .
     1767         end.
     1768         if buf_esys-route-dump.esrd-action begins "_hidden="
     1769         or buf_esys-route-dump.esrd-action begins "_route-order="
     1770         or buf_esys-route-dump.esrd-action begins "_dump-order="
     1771         then do:
     1772         if buf_esys-route-dump.esrd-action begins "_hidden=" then do:
     1773           assign
     1774           buf_temp-xml-tables.tbl-handle_:buffer-field(entry(2, buf_esys-route-dump.esrd-action, "=")):xml-node-type = "hidden" no-error.
     1775           if error-status:error then do:
     1776             run gate-clear in this-procedure ( input p-dataseth, input p-xmlh).
     1777             undo main-block, return error substitute( "&1. Измение типа узла на HIdden не прошел для таблицы &2.&3&4"
     1778                                                     ,vss-workfile
     1779                                                     ,buf_esys-route-dump.esrd-dump-name
     1780                                                     ,chr(10)
     1781                                                     ,error-status:get-message(1) ).
     1782           end.
     1783         end.
     1784           if buf_esys-route-dump.esrd-action begins "_route-order="  then do:
     1785             v-route-order-field = entry(2, buf_esys-route-dump.esrd-action, "=").
     1786           end.
     1787           if buf_esys-route-dump.esrd-action begins "_dump-order="  then do:
     1788             v-dump-order-field = entry(2, buf_esys-route-dump.esrd-action, "=").
     1789           end.
     1790         end.
     1791         else do:
     1792         assign
     1793           v-ok = buf_temp-xml-tables.tbl-handle_:buffer-create no-error
     1794         .
     1795         if v-ok <> true
     1796           or error-status :error
     1797         then do:
     1798           run gate-clear in this-procedure ( input p-dataseth, input p-xmlh).
     1799           undo main-block, return error substitute( "&1. Ошибка при создании записи в буфере временной таблицы &2 .&3&4", vss-workfile, tt-name, chr(10), error-status:get-message(1) ).
     1800         end.
     1801         assign
     1802           v-ok = buf_temp-xml-tables.tbl-handle_:raw-transfer ( false, bh_route-dump:buffer-field("esrd-value-rec") ) no-error
     1803         .
     1804         if v-ok <> true
     1805           or error-status :error
     1806         then do:
     1807           run gate-clear in this-procedure ( input p-dataseth, input p-xmlh).
     1808             undo main-block, return error substitute( "&1. RAW-TRANSFER не прошел для таблицы &2.&3&4", vss-workfile, buf_temp-xml-tables.tbl-name, chr(10), error-status:get-message(1) ).
     1809         end.
     1810           if v-route-order-field <> '' then do:
     1811             assign
     1812             buf_temp-xml-tables.tbl-handle_:buffer-field(v-route-order-field):buffer-value = string(buf_esys-route.esr-tbl-ord, "9999999999999999999") + "-" +
     1813                                                                                              string(buf_esys-route-dump.esrd-rec-ord, "9999999999")
     1814             .
     1815           end.
     1816           if v-dump-order-field <> '' then do:
     1817             assign
     1818             buf_temp-xml-tables.tbl-handle_:buffer-field(v-dump-order-field):buffer-value = string(buf_esys-route-dump.esrd-dump-ord, "9999999999999999999") + "-" +
     1819                                                                                             string(buf_esys-route-dump.esrd-rec-ord, "9999999999")
     1820             .
     1821           end.
     1822         end.
     1823       end.
     1824         if buf_esys-route.esr-action = 'command-pbush':U then do:
     1825           find first  buf_esys-route exclusive-lock where
     1826                     buf_esys-route.esys-id = v-esys-id
     1827                 and buf_esys-route.db-num = v-db-num
     1828                 and buf_esys-route.esr-cr-db-num = v-cr-db-num
     1829                 and buf_esys-route.esr-last-pack = v-pack-num
     1830                 and buf_esys-route.esr-tbl-ord > v-esr-tbl-ord no-error.
     1831           if not available buf_esys-route then leave _fill.
     1832           v-esr-tbl-ord = buf_esys-route.esr-tbl-ord.
     1833           v-esr-dump-ord = buf_esys-route.esr-dump-ord.
     1834         end.
     1835         else do:
     1836           leave _fill.
     1837         end.
     1838       end.
     1839     end.
     1840   end procedure.
     1841   procedure fillxpck_empty :
     1842   define output parameter p-dataseth as handle no-undo .
     1843   define input-output parameter p-xmlh as handle no-undo .
     1844   define output parameter p-num-rec as integer no-undo .
     1845   do
     1846   on error undo, return error
     1847   :
     1848     create dataset p-dataseth .
     1849     assign
     1850     p-dataseth:name = "empty"
     1851     .
     1852   end.
     1853   end procedure.
     1854   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1855   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1856   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1857   procedure fillxcnf :
     1858   define input  parameter p-esys-id as integer   no-undo .
     1859   define input  parameter p-db-num as integer   no-undo .
     1860   define input  parameter p-crdb-num as integer   no-undo .
     1861   define input  parameter p-pack-num as integer   no-undo .
     1862   define parameter buffer buf_temp-esys-pck-sent for THpck-sent.
     1863   define parameter buffer buf_temp-esys-pck-rcvd for THpck-rcvd.
     1864   define parameter buffer curr_temp-esys-pck-sent for THcurr-pack.
     1865   define output parameter rec-cnt as integer   no-undo .
     1866   define output parameter v-prev-crc as character no-undo .
     1867   DEFINE VARIABLE v-today as date no-undo .
     1868   DEFINE VARIABLE v-time as integer no-undo .
     1869   define variable glog as logical   no-undo .
     1870   define buffer prev_esys-pck-sent for ub.esys-pck-sent.
     1871   define buffer last_esys-route for ub.esys-route.
     1872   define buffer buf_esys-pck-sent for ub.esys-pck-sent.
     1873   define buffer buf_esys-pck-keys for ub.esys-pck-keys.
     1874   define buffer buf_esys-pck-rcvd for ub.esys-pck-rcvd.
     1875   define buffer buf_db for ub.db.
     1876   define buffer buf_sys-ctrl for ub.sys-ctrl.
     1877   do
     1878   on error undo, return error return-value
     1879   :
     1880     find first buf_db where buf_db.db-num = g#db-num no-lock.
     1881     find prev_esys-pck-sent no-lock
     1882       where prev_esys-pck-sent.esys-id  = p-esys-id
     1883         and prev_esys-pck-sent.db-num   = p-db-num
     1884         and prev_esys-pck-sent.esps-cr-db-num = p-cr-db-num
     1885         and prev_esys-pck-sent.esps-pack-num = p-pack-num - 1
     1886       no-error
     1887     .
     1888     if available prev_esys-pck-sent then do:
     1889       assign
     1890         v-prev-crc = prev_esys-pck-sent.esps-crc-pack
     1891       .
     1892     end.
     1893     else do:
     1894       assign
     1895         v-prev-crc = "":U
     1896       .
     1897     end.
     1898     find first buf_sys-ctrl no-lock.
     1899     create t-pck-conf.
     1900     assign
     1901     t-pck-conf.sys-key    = buf_sys-ctrl.sys-key
     1902     t-pck-conf.esys-id    = p-esys-id
     1903     t-pck-conf.db-num     = p-db-num
     1904     t-pck-conf.current-db-num = g#db-num
     1905     t-pck-conf.pack-num   = p-pack-num
     1906     t-pck-conf.total-recs = ?
     1907     t-pck-conf.rcvd-recs  = 0
     1908     t-pck-conf.src_db-key = buf_db.db-key
     1909     t-pck-conf.prev-crc   = v-prev-crc
     1910     .
     1911     find last last_esys-route no-lock
     1912        where last_esys-route.esys-id   = p-esys-id
     1913          and last_esys-route.db-num    = p-db-num
     1914          and last_esys-route.esr-cr-db-num = p-cr-db-num
     1915          and last_esys-route.esr-last-pack = p-pack-num
     1916        use-index pi
     1917        no-error .
     1918     for each buf_esys-pck-sent no-lock
     1919       where buf_esys-pck-sent.esys-id  = p-esys-id
     1920         and buf_esys-pck-sent.db-num   = p-db-num
     1921         and buf_esys-pck-sent.esps-rcvd     = no
     1922         and buf_esys-pck-sent.esps-pack-num < p-pack-num
     1923     on error  undo, return error substitute( "&1 (for each buf_esys-pck-sent). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1924     on stop   undo, return error substitute( "&1 (for each buf_esys-pck-sent). stop", vss-workfile )
     1925     on endkey undo, return error substitute( "&1 (for each buf_esys-pck-sent). endkey", vss-workfile )
     1926     :
     1927       assign
     1928       rec-cnt = rec-cnt + 1
     1929       .
     1930       create buf_temp-esys-pck-sent.
     1931       glog = buffer buf_temp-esys-pck-sent:handle:buffer-copy(buffer buf_esys-pck-sent:handle
     1932                                                   ,""
     1933                                                   ,"THfilename,custom-pack-name,THcrc-pack,esps-crc-pack,THcredate,esps-credate,THcrenum,esps-crenum,THcretimeint,esps-cretimeint,THcretime,esps-cretime,THrcvddate,esps-rcvddate,THpack-num,esps-pack-num,THrcvdtimeint,esps-rcvdtimeint,THrcvdtime,esps-rcvdtime,THrcvd,esps-rcvd,THsendtxtdate,esps-sendtxtdate,THsendtxttimeint,esps-sendtxttimeint,THsendtxttime,esps-sendtxttime,THtotal-recs,esps-total-recs,THesys-id,esys-id"
     1934                                                   ).
     1935     end.
     1936     for each buf_esys-pck-rcvd no-lock
     1937       where buf_esys-pck-rcvd.esys-id    = p-esys-id
     1938         and buf_esys-pck-rcvd.db-num     = p-db-num
     1939         and buf_esys-pck-rcvd.espr-rcvd       = no
     1940         and buf_esys-pck-rcvd.espr-total-recs = buf_esys-pck-rcvd.espr-rcvd-recs
     1941     on error  undo, return error substitute( "&1 (for each buf_esys-pck-rcvd). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1942     on stop   undo, return error substitute( "&1 (for each buf_esys-pck-rcvd). stop", vss-workfile )
     1943     on endkey undo, return error substitute( "&1 (for each buf_esys-pck-rcvd). endkey", vss-workfile )
     1944     :
     1945       create buf_temp-esys-pck-rcvd.
     1946       glog = buffer buf_temp-esys-pck-rcvd:handle:buffer-copy(buffer buf_esys-pck-rcvd:handle
     1947                                                   ,"":U
     1948                                                   ,"THfilename,custom-pack-name,THesys-id,esys-id,THcrc-pack,espr-crc-pack,THpack-num,espr-pack-num,THrcvd-recs,espr-rcvd-recs,THrcvd,espr-rcvd,THtotal-recs,total-recs"
     1949                                                   ).
     1950       assign
     1951       rec-cnt = rec-cnt + 1
     1952       .
     1953     end.
     1954     do
     1955     on error  undo, return error substitute( "&1 (do transaction). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1956     on stop   undo, return error substitute( "&1 (do transaction). stop", vss-workfile )
     1957     on endkey undo, return error substitute( "&1 (do transaction). endkey", vss-workfile )
     1958     :
     1959       find first buf_esys-pck-sent exclusive-lock
     1960         where buf_esys-pck-sent.esys-id   = p-esys-id
     1961           and buf_esys-pck-sent.db-num   = p-db-num
     1962           and buf_esys-pck-sent.esps-cr-db-num   = p-cr-db-num
     1963           and buf_esys-pck-sent.esps-pack-num = p-pack-num
     1964       .
     1965       run cur-time in this-procedure ( output v-today, output v-time).
     1966       assign
     1967         rec-cnt = rec-cnt + 1 + 1
     1968         buf_esys-pck-sent.esps-total-recs     = rec-cnt
     1969         buf_esys-pck-sent.esps-CreNum         = buf_esys-pck-sent.esps-CreNum + 1
     1970         buf_esys-pck-sent.esps-SendTxtDate    = v-today
     1971         buf_esys-pck-sent.esps-SendTxtTimeInt = v-time
     1972         buf_esys-pck-sent.esps-SendTxtTime    = string( v-time, "HH:MM:SS" )
     1973         .
     1974       create curr_temp-esys-pck-sent.
     1975       glog = buffer curr_temp-esys-pck-sent:handle:buffer-copy(buffer buf_esys-pck-sent:handle
     1976                                                   ,""
     1977                                                   ,"THfilename,custom-pack-name,THcrc-pack,esps-crc-pack,THcredate,esps-credate,THcrenum,esps-crenum,THcretimeint,esps-cretimeint,THcretime,esps-cretime,THrcvddate,esps-rcvddate,THpack-num,esps-pack-num,THrcvdtimeint,esps-rcvdtimeint,THrcvdtime,esps-rcvdtime,THrcvd,esps-rcvd,THsendtxtdate,esps-sendtxtdate,THsendtxttimeint,esps-sendtxttimeint,THsendtxttime,esps-sendtxttime,THtotal-recs,esps-total-recs,THesys-id,esys-id"
     1978                                                   ).
     1979     end.
     1980   end.
     1981   end procedure.
     1982   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1983   define temp-table temp-rel-handle no-undo
     1984   field dh as handle
     1985   field ii as integer
     1986   field active_ as logical
     1987   field child-buffer_ as character
     1988   field parent-buffer_ as character
     1989   field child-buffer-handle as handle
     1990   field parent-buffer-handle as handle
     1991   field name_ as character
     1992   field nested_ as logical
     1993   field relation-fields_ as character
     1994   field reposition_ as logical
     1995   field type_ as character
     1996   field query_ as handle
     1997   field where-string_ as character
     1998   field tbl-handle_ as handle
     1999   index pi is unique primary
     2000   ii
     2001   index iparentname parent-buffer_ child-buffer_
     2002   index iparenthandle parent-buffer-handle child-buffer-handle
     2003   .
     2004   procedure tmpreldf_get-relations :
     2005   define input parameter p-dataseth as handle no-undo .
     2006   define variable v-ii as integer no-undo .
     2007   define buffer buf_temp-rel-handle for temp-rel-handle.
     2008   do
     2009   on error undo, return error
     2010   :
     2011     if not valid-handle(p-dataseth)
     2012     or p-dataseth:type <> "DATASET"
     2013     then do:
     2014       return error substitute("Не определен dataset с handle &1", p-dataseth).
     2015     end.
     2016     for each buf_temp-rel-handle where
     2017             buf_temp-rel-handle.dh = p-dataseth:
     2018       delete buf_temp-rel-handle.
     2019     end.
     2020     do v-ii = 1 to p-dataseth:num-relations:
     2021       create buf_temp-rel-handle.
     2022       assign
     2023       buf_temp-rel-handle.ii = v-ii
     2024       buf_temp-rel-handle.dh = p-dataseth
     2025       buf_temp-rel-handle.active_ = p-dataseth:get-relation(v-ii):active
     2026       buf_temp-rel-handle.child-buffer_ = p-dataseth:get-relation(v-ii):child-buffer:name
     2027       buf_temp-rel-handle.parent-buffer_ = p-dataseth:get-relation(v-ii):parent-buffer:name
     2028       buf_temp-rel-handle.child-buffer-handle = p-dataseth:get-relation(v-ii):child-buffer
     2029       buf_temp-rel-handle.tbl-handle_ = buf_temp-rel-handle.child-buffer-handle
     2030       buf_temp-rel-handle.parent-buffer-handle = p-dataseth:get-relation(v-ii):parent-buffer
     2031       buf_temp-rel-handle.name_ = p-dataseth:get-relation(v-ii):name
     2032       buf_temp-rel-handle.nested_ = p-dataseth:get-relation(v-ii):nested
     2033       buf_temp-rel-handle.relation-fields_ = p-dataseth:get-relation(v-ii):relation-fields
     2034       buf_temp-rel-handle.reposition_ = p-dataseth:get-relation(v-ii):reposition
     2035       buf_temp-rel-handle.type_ = p-dataseth:get-relation(v-ii):type
     2036       buf_temp-rel-handle.query_ = p-dataseth:get-relation(v-ii):query
     2037       buf_temp-rel-handle.where-string_ = p-dataseth:get-relation(v-ii):where-string
     2038       .
     2039     end.
     2040   end.
     2041   end procedure.
     2042   procedure tmpreldf_set-relations :
     2043   define input parameter p-srcdataseth as handle no-undo .
     2044   define input parameter p-trgdataseth as handle no-undo .
     2045   define variable gh as handle no-undo .
     2046   define buffer buf_temp-rel-handle for temp-rel-handle.
     2047   do
     2048   on error undo, return error
     2049   :
     2050     if not valid-handle(p-srcdataseth)
     2051     or p-srcdataseth:type <> "DATASET"
     2052     then do:
     2053       return error substitute("Не определен dataset-источник с handle &1", p-srcdataseth).
     2054     end.
     2055     if not valid-handle(p-trgdataseth)
     2056     or p-trgdataseth:type <> "DATASET"
     2057     then do:
     2058       return error substitute("Не определен dataset-приемник с handle &1", p-trgdataseth).
     2059     end.
     2060     for each buf_temp-rel-handle no-lock where
     2061             buf_temp-rel-handle.dh = p-srcdataseth
     2062     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2063     on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2064     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     2065     :
     2066       gh = p-trgdataseth:ADD-RELATION ( buf_temp-rel-handle.parent-buffer-handle
     2067                                         , buf_temp-rel-handle.child-buffer-handle
     2068                                         , buf_temp-rel-handle.relation-fields_
     2069                                         , buf_temp-rel-handle.reposition_
     2070                                         , buf_temp-rel-handle.nested_).
     2071      if error-status:error
     2072      or not valid-handle(gh) then do:
     2073        undo, return error substitute("Ошибка при добавлении relation &1 в dataset &2", buf_temp-rel-handle.name, p-trgdataseth:name).
     2074      end.
     2075     end.
     2076   end.
     2077   end procedure.
     2078   define variable v_dataseth as handle no-undo .
     2079   define variable tth as handle  no-undo .
     2080   define variable bh_route-dump as handle no-undo .
     2081   define variable glog as logical no-undo .
     2082   define variable v-ok as logical no-undo .
     2083   define variable tt-name as character no-undo .
     2084   define variable v-xmlh as handle no-undo .
     2085   define variable v-headerh as handle no-undo .
     2086   define variable v-header-th as handle no-undo .
     2087   define variable v-pckrcvd as handle no-undo .
     2088   define variable v-pcksent as handle no-undo .
     2089   define variable v-currpcksent as handle no-undo .
     2090   define variable v-prev-crc as character no-undo .
     2091   define variable bh_tt as handle no-undo .
     2092   define variable rec-cnt as integer no-undo .
     2093   define variable v-num-rec as integer no-undo .
     2094   DEFINE VARIABLE v-today as date no-undo .
     2095   DEFINE VARIABLE v-time as integer no-undo .
     2096   define variable v-is-ack as logical no-undo .
     2097   define variable v-header-schema-name as character no-undo .
     2098   define variable v-header-name as character no-undo .
     2099   define variable v-header-rec as character no-undo .
     2100   define buffer buf_esys-route for ub.esys-route.
     2101   define buffer buf_esys-route-dump for ub.esys-route-dump.
     2102   define buffer buf_temp-xml-tables for temp-xml-tables.
     2103   define buffer buf_ext-system for ub.ext-system.
     2104   define buffer buf_esys-pck-sent for ub.esys-pck-sent.
     2105   define buffer buf_esys-pck-rcvd for ub.esys-pck-rcvd.
     2106   define buffer buf_esys-pck-keys for ub.esys-pck-keys.
     2107   define buffer buf_temp-esys-pck-rcvd for THpck-rcvd.
     2108   define buffer buf_temp-esys-pck-sent for THpck-sent.
     2109   define buffer curr_temp-esys-pck-sent for THcurr-pack.
     2110   main-block:
     2111   do
     2112   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2113   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     2114   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     2115   :
     2116     assign
     2117     v-xmlh = buffer buf_temp-xml-tables:handle
     2118     v-pckrcvd = buffer buf_temp-esys-pck-rcvd:handle
     2119     v-pcksent = buffer buf_temp-esys-pck-sent:handle
     2120     v-currpcksent = buffer curr_temp-esys-pck-sent:handle
     2121     .
     2122     for each buf_temp-esys-pck-rcvd:
     2123       delete buf_temp-esys-pck-rcvd.
     2124     end.
     2125     for each buf_temp-esys-pck-sent:
     2126       delete buf_temp-esys-pck-sent.
     2127     end.
     2128     for each curr_temp-esys-pck-sent:
     2129       delete curr_temp-esys-pck-sent.
     2130     end.
     2131     for each t-pck-conf:
     2132       delete t-pck-conf.
     2133     end.
     2134     find first buf_ext-system no-lock where
     2135               buf_ext-system.esys-id = p-esys-id
     2136           and buf_ext-system.db-num = p-db-num
     2137               no-error.
     2138     if not available buf_ext-system then do:
     2139           run write-log in p-log-handle (           input 2         , input substitute("Неизвестная внешняя система &1", p-esys-id) ).
     2140       undo, return error ''.
     2141     end.
     2142     find first buf_esys-pck-sent no-lock
     2143       where buf_esys-pck-sent.esys-id  = p-esys-id
     2144         and buf_esys-pck-sent.db-num   = p-db-num
     2145         and buf_esys-pck-sent.esps-pack-num = p-pack-num
     2146       no-error
     2147     .
     2148     if available buf_esys-pck-sent then do:
     2149       if buf_esys-pck-sent.esps-SendTxtDate <> ? then do:
     2150               run write-log in p-log-handle (           input 2         , input substitute("Переформирование файла пакета N &1 для ВС N &2", p-pack-num, p-esys-id ) ).
     2151       end.
     2152       else do:
     2153               run write-log in p-log-handle (           input 2         , input substitute("Формирование файла пакета N &1 для ВС N &2", p-pack-num, p-esys-id ) ).
     2154       end.
     2155     end.
     2156     else do:
     2157           run write-log in p-log-handle (           input 2         , input substitute("&1. Пакет N &2 для ВС N &3 отсутствует.", vss-workfile, p-pack-num, p-esys-id ) ).
     2158       undo, return error .
     2159     end.
     2160     if not buf_ext-system.delivery-method = integer('9':U) and not buf_ext-system.delivery-method = integer('11':U) then do:
     2161       if p-esr-dump-ord >= 0 then do:
     2162       find first buf_esys-route exclusive-lock where
     2163                 buf_esys-route.esr-dump-ord = p-esr-dump-ord
     2164            and  buf_esys-route.esys-id = p-esys-id
     2165            and  buf_esys-route.db-num = p-db-num
     2166                 .
     2167       run  fillxpck in this-procedure (
     2168                                          buffer buf_esys-route
     2169                                         ,output v_dataseth
     2170                                         ,input-output v-xmlh
     2171                                         ,output v-num-rec
     2172                                         ) no-error.
     2173       if error-status:error then do:
     2174               run write-log in p-log-handle (           input 2         , input substitute("&1 Ошибка при заполнении пакета &6 (&6) через gate &2&3&4&3&5"                                               , vss-workfile                                               ,buf_esys-route.uniq-gate-rec                                               ,chr(10)                                               ,error-status:get-message(1)                                               ,return-value                                               ,p-pack-num                                               ,buf_esys-route.esr-name-rec ) ).
     2175         run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     2176         undo, return error ''.
     2177       end.
     2178       end.
     2179       else do:
     2180         run  fillxpck_empty in this-procedure (
     2181                                            output v_dataseth
     2182                                           ,input-output v-xmlh
     2183                                           ,output v-num-rec
     2184                                           ) no-error.
     2185         if error-status:error then do:
     2186                   run write-log in p-log-handle (           input 2         , input substitute("&1 Ошибка при заполнении ПУСТОГО пакета &6 (&6) через &2&3&2&4"                                                 , vss-workfile                                                 ,chr(10)                                                 ,error-status:get-message(1)                                                 ,return-value                                                 ,p-pack-num                                                 ,buf_esys-route.esr-name-rec ) ).
     2187           run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     2188           undo, return error ''.
     2189         end.
     2190       end.
     2191       if buf_ext-system.exp-conf-wait = integer('1':U)  then do:
     2192          run fillxcnf in this-procedure ( input p-esys-id
     2193                                          ,input p-db-num
     2194                                          ,input p-cr-db-num
     2195                                          ,input p-pack-num
     2196                                          ,buffer buf_temp-esys-pck-sent
     2197                                          ,buffer buf_temp-esys-pck-rcvd
     2198                                          ,buffer curr_temp-esys-pck-sent
     2199                                          ,output rec-cnt
     2200                                          ,output v-prev-crc
     2201                                          ) no-error.
     2202          if error-status :error then do:
     2203                   run write-log in p-log-handle (           input 2         , input substitute("&1 Ошибка при заполнении пакета &2 данными для подтверждений &3&4&3&5"                                       ,p-pack-num                                       , vss-workfile                                       ,chr(10)                                       ,error-status:get-message(1)                                       ,return-value                                         ) ).
     2204           run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     2205           undo, return error ''.
     2206          end.
     2207       end.
     2208       rec-cnt = rec-cnt + v-num-rec.
     2209       case buf_ext-system.delivery-method:
     2210         when integer('3':U) then do:
     2211           if entry(num-entries(p-xml-file-name, "."), p-xml-file-name, ".") = "ack" then do:
     2212             v-is-ack = yes.
     2213           end.
     2214           else do:
     2215             v-header-schema-name = "exe/header_.xsd".
     2216             v-header-name = "header_".
     2217             define buffer buf_clients for ub.clients.
     2218             find first buf_clients no-lock where
     2219                       buf_clients.db-num = g#db-num
     2220                   and buf_clients.obj-type = 'маг':U no-error .
     2221             run get-gate-rec in this-procedure ( input v-header-schema-name
     2222                                                 ,output v-header-rec) no-error.
     2223             if error-status:error then do:
     2224               undo, return error substitute("Не найдено описание xsd-схемы &1 в БД", v-header-schema-name).
     2225             end.
     2226             run get-header-by-rec in this-procedure ( input v-header-rec
     2227                                                   ,output v-header-th
     2228                                                   ) no-error.
     2229             if error-status:error then do:
     2230                           run write-log in p-log-handle (           input 2         , input substitute("Ошибка при создании структуры заголовка пакета согласно гейту:&1&2"                                       , v-header-rec                                       , chr(10), error-status:get-message(1) ) ).
     2231               undo, return error '':U.
     2232             end.
     2233             run cur-time in this-procedure ( output v-today, output v-time).
     2234             v-headerh = v-header-th:default-buffer-handle.
     2235             v-headerh:buffer-create().
     2236            assign
     2237             v-headerh::to_ = "Oracle Retail"
     2238             v-headerh::from_ = "IBS Trade House"
     2239             v-headerh::obj-type = (if available buf_clients then buf_clients.obj-type else '')
     2240             v-headerh::obj-code = (if available buf_clients then string (buf_clients.obj-code) else '')
     2241             v-headerh::name = entry(2, entry(1, v_dataseth:private-data, chr(4)), chr(47))
     2242             v-headerh::xsd = entry(2, entry(1, v_dataseth:private-data, chr(4)), chr(47))
     2243             v-headerh::date-from =  string(datetime(v-today, mtime), "99/99/9999 HH:MM:SS")
     2244             v-headerh::date-to =  string(datetime(v-today, mtime), "99/99/9999 HH:MM:SS")
     2245             .
     2246           end.
     2247         end.
     2248         when integer('5':U) then do:
     2249           v-header-schema-name = "".
     2250           v-header-name = "".
     2251         end.
     2252         otherwise do:
     2253             v-header-schema-name = "exe/ThHeader.xsd".
     2254             v-header-name = "ThHeader".
     2255             run get-gate-rec in this-procedure ( input v-header-schema-name
     2256                                                 ,output v-header-rec) no-error.
     2257             if error-status:error then do:
     2258               undo, return error substitute("Не найдено описание xsd-схемы &1 в БД", v-header-schema-name).
     2259             end.
     2260             run get-header-by-rec in this-procedure ( input v-header-rec
     2261                                                   ,output v-header-th
     2262                                                   ) no-error.
     2263             if error-status:error then do:
     2264                           run write-log in p-log-handle (           input 2         , input substitute("Ошибка при создании структуры заголовка поакета согласно гейту:&1&2"                                       , v-header-rec                                       , chr(10), error-status:get-message(1) ) ).
     2265               undo, return error '':U.
     2266             end.
     2267           v-headerh = v-header-th:default-buffer-handle.
     2268           v-headerh:buffer-create( ).
     2269           assign
     2270           v-headerh::THfilename     = p-xml-file-name
     2271           v-headerh::THfilenumber   = p-xml-file-number
     2272           v-headerh::THformat_      = "Trade House OpenXML 1.0"
     2273           v-headerh::THversion_     = trim( replace( substring( vss-archive, 15, 4 ), "$":U, "":U ) )
     2274           v-headerh::THrevision     = trim( replace( substring( vss-revision, 12 ), "$":U, "":U ) )
     2275           v-headerh::THesysname     = buf_ext-system.esys-name
     2276           v-headerh::THcurrentDbNum = g#db-num
     2277           v-headerh::THpack-num     = p-pack-num
     2278           v-headerh::THschema-name  = substitute("exe/&1", entry(2, entry(1, v_dataseth:private-data, chr(4)), chr(47)))
     2279           v-headerh::THprev-crc     = v-prev-crc
     2280           v-headerh::THexport-esys-id  = p-esys-id
     2281       .
     2282         end.
     2283       end case.
     2284       if not v-is-ack
     2285       and v-header-name <> ""
     2286       then do:
     2287       create buf_temp-xml-tables.
     2288       assign
     2289       buf_temp-xml-tables.tbl-name = v-headerh:table
     2290       buf_temp-xml-tables.tbl-handle_ = v-headerh
     2291       buf_temp-xml-tables.table-handle_ = v-headerh:table-handle
     2292       buf_temp-xml-tables.uniq-gate-rec = (if available buf_esys-route then buf_esys-route.uniq-gate-rec else '')
     2293       buf_temp-xml-tables.gate-name = v_dataseth:name
     2294       buf_temp-xml-tables.gate-handle_ = v_dataseth
     2295       buf_temp-xml-tables.order = -3
     2296       rec-cnt = rec-cnt + 1
     2297       .
     2298     end.
     2299       if buf_ext-system.exp-conf-wait = integer('1':U)  then do:
     2300         create buf_temp-xml-tables.
     2301         assign
     2302         buf_temp-xml-tables.tbl-name = v-pcksent:table
     2303         buf_temp-xml-tables.tbl-handle_ = v-pcksent
     2304         buf_temp-xml-tables.table-handle_ = v-pcksent:table-handle
     2305         buf_temp-xml-tables.uniq-gate-rec = (if available buf_esys-route then buf_esys-route.uniq-gate-rec else '')
     2306         buf_temp-xml-tables.gate-name = v_dataseth:name
     2307         buf_temp-xml-tables.gate-handle_ = v_dataseth
     2308         buf_temp-xml-tables.order = -2
     2309         .
     2310         create buf_temp-xml-tables.
     2311         assign
     2312         buf_temp-xml-tables.tbl-name = v-pckrcvd:table
     2313         buf_temp-xml-tables.tbl-handle_ = v-pckrcvd
     2314         buf_temp-xml-tables.table-handle_ = v-pckrcvd:table-handle
     2315         buf_temp-xml-tables.uniq-gate-rec = (if available buf_esys-route then buf_esys-route.uniq-gate-rec else '')
     2316         buf_temp-xml-tables.gate-name = v_dataseth:name
     2317         buf_temp-xml-tables.gate-handle_ = v_dataseth
     2318         buf_temp-xml-tables.order = -1
     2319         .
     2320         create buf_temp-xml-tables.
     2321         assign
     2322         buf_temp-xml-tables.tbl-name = v-currpcksent:table
     2323         buf_temp-xml-tables.tbl-handle_ = v-currpcksent
     2324         buf_temp-xml-tables.table-handle_ = v-currpcksent:table-handle
     2325         buf_temp-xml-tables.uniq-gate-rec = (if available buf_esys-route then buf_esys-route.uniq-gate-rec else '')
     2326         buf_temp-xml-tables.gate-name = v_dataseth:name
     2327         buf_temp-xml-tables.gate-handle_ = v_dataseth
     2328         buf_temp-xml-tables.order = v_dataseth:num-buffers + 1
     2329         .
     2330       end.
     2331       if not (v-is-ack
     2332               or
     2333               v-header-name = '')
     2334       then do:
     2335         if v-headerh:table = "THheader" then do:
     2336           v-headerh::THtotal-recs = rec-cnt.
     2337         end.
     2338       run tmpreldf_get-relations in this-procedure ( input v_dataseth).
     2339       for each buf_temp-xml-tables
     2340       break
     2341       by buf_temp-xml-tables.order:
     2342        if first(buf_temp-xml-tables.order) then do:
     2343          glog = v_dataseth:set-buffers ( buf_temp-xml-tables.tbl-handle_) no-error.
     2344        end.
     2345        else do:
     2346          glog = v_dataseth:add-buffer ( buf_temp-xml-tables.tbl-handle_) no-error.
     2347        end.
     2348        if error-status:error
     2349         or not glog                                     then do:
     2350                   run write-log in p-log-handle (           input 2         , input substitute("Ошибка при создании заголовка XML файла:&1&2", chr(10), error-status:get-message(1) ) ).
     2351           run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     2352           undo, return error '':U.
     2353         end.
     2354       end.
     2355       run tmpreldf_set-relations in this-procedure ( input v_dataseth, input v_dataseth).
     2356       end.
     2357       glog = v_dataseth:WRITE-XML("FILE"
     2358                                 ,p-xml-file-name
     2359                                 ,yes
     2360                                 ,(if buf_ext-system.delivery-method = integer('5':U)
     2361                                   then "utf-8"
     2362                                   else "windows-1251")
     2363                                 ,?
     2364                                 ,no
     2365                                 ,no
     2366                                 ) no-error.
     2367       if error-status:error then do:
     2368                   run write-log in p-log-handle (           input 2         , input substitute("Ошибка при записи XML файла данными через гейт &1:&2&3"                                       , v_dataseth:name                                       , chr(10), error-status:get-message(1) ) ).
     2369       end.
     2370       p-num-rec = v-num-rec.
     2371       run gate-clear in this-procedure ( input v_dataseth, input v-xmlh).
     2372     end.
     2373     else do:
     2374       define stream exp-str .
     2375       define variable mbuffer as memptr .
     2376       output stream exp-str to value(p-xml-file-name).
     2377       for each buf_esys-route-dump where buf_esys-route-dump.esrd-dump-ord = p-esr-dump-ord:
     2378         mbuffer = buf_esys-route-dump.esrd-blob-value-rec.
     2379         export stream exp-str mbuffer .
     2380       end.
     2381       output stream exp-str close.
     2382     end.
     2383   end.
