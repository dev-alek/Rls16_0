     1369   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'host-code'),  input string(buf_schet-fact-doc.host-code), input 1 ).
     1370   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'book-code'),  input string(buf_schet-fact-doc.book-code), input 1 ).
     1371   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'obj-type'),  input string(buf_schet-fact-doc.obj-type), input 1 ).
     1372   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'obj-code'),  input string(buf_schet-fact-doc.obj-code), input 1 ).
     1373   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'cli-type'),  input string(buf_schet-fact-doc.cli-type), input 1 ).
     1374   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'cli-code'),  input string(buf_schet-fact-doc.cli-code), input 1 ).
     1375   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'cli-name'),  input string(buf_schet-fact-doc.cli-name), input 1 ).
     1376   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'cli-inn'),  input string(buf_schet-fact-doc.cli-inn), input 1 ).
     1377   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'cli-address'),  input string(buf_schet-fact-doc.cli-address), input 1 ).
     1378   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'Gruz-otprav'),  input string(buf_schet-fact-doc.Gruz-otprav), input 1 ).
     1379   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'Gruz-poluch'),  input string(buf_schet-fact-doc.Gruz-poluch), input 1 ).
     1380   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'own-name'),  input string(buf_schet-fact-doc.own-name), input 1 ).
     1381   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'own-inn'),  input string(buf_schet-fact-doc.own-inn), input 1 ).
     1382   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'own-address'),  input string(buf_schet-fact-doc.own-address), input 1 ).
     1383   if buf_schet-fact-doc.fact-order <> ? then do:
     1384         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'fact-order'),  input string(buf_schet-fact-doc.fact-order), input 1 ).
     1385   end.
     1386   if buf_schet-fact-doc.in-doc-code <> "" then do:
     1387         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'in-doc-code'),  input string(buf_schet-fact-doc.in-doc-code), input 1 ).
     1388   end.
     1389   if buf_schet-fact-doc.in-doc-date <> ? then do:
     1390         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'in-doc-date'),  input string(buf_schet-fact-doc.in-doc-date, '99.99.9999'), input 1 ).
     1391   end.
     1392   if buf_schet-fact-doc.base-rate <> ? then do:
     1393         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'base-rate'),  input string(buf_schet-fact-doc.base-rate), input 1 ).
     1394   end.
     1395   if buf_schet-fact-doc.base-scale <> ? then do:
     1396         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'base-scale'),  input string(buf_schet-fact-doc.base-scale), input 1 ).
     1397   end.
     1398   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-rubl'),  input string(buf_schet-fact-doc.sum-rubl), input 1 ).
     1399   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-VAT-20-rubl'),  input string(buf_schet-fact-doc.sum-VAT-20-rubl), input 1 ).
     1400   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'VAT-20-rubl'),  input string(buf_schet-fact-doc.VAT-20-rubl), input 1 ).
     1401   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-VAT-10-rubl'),  input string(buf_schet-fact-doc.sum-VAT-10-rubl), input 1 ).
     1402   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'VAT-10-rubl'),  input string(buf_schet-fact-doc.VAT-10-rubl), input 1 ).
     1403   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-VAT-0-rubl'),  input string(buf_schet-fact-doc.sum-VAT-0-rubl), input 1 ).
     1404   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-VAT-no-rubl'),  input string(buf_schet-fact-doc.sum-VAT-no-rubl), input 1 ).
     1405   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-base'),  input string(buf_schet-fact-doc.sum-base), input 1 ).
     1406   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-VAT-20-base'),  input string(buf_schet-fact-doc.sum-VAT-20-base), input 1 ).
     1407   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'VAT-20-base'),  input string(buf_schet-fact-doc.VAT-20-base), input 1 ).
     1408   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-VAT-10-base'),  input string(buf_schet-fact-doc.sum-VAT-10-base), input 1 ).
     1409   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'VAT-10-base'),  input string(buf_schet-fact-doc.VAT-10-base), input 1 ).
     1410   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-VAT-0-base'),  input string(buf_schet-fact-doc.sum-VAT-0-base), input 1 ).
     1411   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-VAT-no-base'),  input string(buf_schet-fact-doc.sum-VAT-no-base), input 1 ).
     1412   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'PS'),  input string(buf_schet-fact-doc.PS), input 1 ).
     1413   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'out-code-list'),  input string(buf_schet-fact-doc.out-code-list), input 1 ).
     1414   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'gtd'),  input string(buf_schet-fact-doc.gtd), input 1 ).
     1415   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'country'),  input string(buf_schet-fact-doc.country), input 1 ).
     1416   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'fact-user-db-num'),  input string(buf_schet-fact-doc.fact-user-db-num), input 1 ).
     1417   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'fact-user-name'),  input string(buf_schet-fact-doc.fact-user-name), input 1 ).
     1418   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'user-db-num'),  input string(buf_schet-fact-doc.user-db-num), input 1 ).
     1419   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'user-name'),  input string(buf_schet-fact-doc.user-name), input 1 ).
     1420   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'PS'),  input string(buf_schet-fact-doc.PS), input 1 ).
     1421   if buf_schet-fact-doc.fact-date <> ? then do:
     1422         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'fact-date'),  input string(buf_schet-fact-doc.fact-date, '99.99.9999'), input 1 ).
     1423   end.
     1424   if buf_schet-fact-doc.fact-time <> ? then do:
     1425         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'fact-time'),  input string(buf_schet-fact-doc.fact-time), input 1 ).
     1426   end.
     1427   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sys-date'),  input string(buf_schet-fact-doc.sys-date, '99.99.9999'), input 1 ).
     1428   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sys-time'),  input string(buf_schet-fact-doc.sys-time), input 1 ).
     1429   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'office'),  input string(buf_schet-fact-doc.office), input 1 ).
     1430   run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'curr-code'),  input string(buf_schet-fact-doc.curr-code), input 1 ).
     1431   run bgelib-tag-close in this-procedure ( input 0, substitute("&1", 'schet-fact-doc')).
     1432   for each buf_schet-fact-line no-lock
     1433       where buf_schet-fact-line.doc-code = buf_schet-fact-doc.doc-code
     1434       AND   buf_schet-fact-line.db-num = buf_schet-fact-doc.db-num
     1435   on error undo, return error
     1436   :
     1437         run bgelib-tag-open in this-procedure ( input 0, substitute("&1", 'schet-fact-line'),  "" ).
     1438         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'doc-code'),  input string(buf_schet-fact-line.doc-code), input 1 ).
     1439         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'gds-code'),  input string(buf_schet-fact-line.gds-code), input 1 ).
     1440         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'fact-qnty'),  input string(buf_schet-fact-line.fact-qnty), input 1 ).
     1441         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'price-rubl'),  input string(buf_schet-fact-line.price-rubl), input 1 ).
     1442         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'price-base'),  input string(buf_schet-fact-line.price-base), input 1 ).
