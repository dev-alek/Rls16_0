     1444         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-base'),  input string(buf_schet-fact-line.sum-base), input 1 ).
     1445         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'VAT-rubl'),  input string(buf_schet-fact-line.VAT-rubl), input 1 ).
     1446         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'VAT-base'),  input string(buf_schet-fact-line.VAT-base), input 1 ).
     1447         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-rubl-VAT'),  input string(buf_schet-fact-line.sum-rubl-VAT), input 1 ).
     1448         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'sum-base-VAT'),  input string(buf_schet-fact-line.sum-base-VAT), input 1 ).
     1449         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'obj-type'),  input string(buf_schet-fact-line.obj-type), input 1 ).
     1450         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'obj-code'),  input string(buf_schet-fact-line.obj-code), input 1 ).
     1451         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'VAT-pc'),  input string(buf_schet-fact-line.VAT-pc), input 1 ).
     1452         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'ext-doc-type'),  input string(buf_schet-fact-line.ext-doc-type), input 1 ).
     1453         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'fact-order'),  input string(buf_schet-fact-line.fact-order), input 1 ).
     1454         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'status_'),  input string(buf_schet-fact-line.status_), input 1 ).
     1455         run bgelib-tag-put in this-procedure ( input 1, input substitute('&1', 'line-num'),  input string(buf_schet-fact-line.line-num), input 1 ).
