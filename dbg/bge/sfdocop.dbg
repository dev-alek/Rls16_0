        1   block-level on error undo, throw.
        2   DEFINE INPUT  PARAMETER parparentproc        AS WIDGET-HANDLE        NO-UNDO.
        3   define input parameter p-host-code              as integer                 no-undo.
        4   define input parameter p-oper-name              as character               no-undo.
        5   define input parameter p-fact-order-from        like ub.stk-tot.fact-order    no-undo.
        6   define input parameter p-fact-order-to          like ub.stk-tot.fact-order    no-undo.
        7   define input parameter p-obj-list               as character               no-undo.
        8   define input parameter p-parameter-list         as character               no-undo.
        9   define input parameter p-xml-file-name          as character               no-undo.
       10   define input parameter p-log-file-name          as character               no-undo.
       11   define input parameter p-list-file-name         as character               no-undo.
       12   define input parameter p-xml-file-number        as integer                 no-undo.
       13   define input parameter hEDT                     as handle                  no-undo.
       14   define input parameter hCNT                     as handle                  no-undo.
       15   define output parameter p-last-xml-file-name    as character               no-undo.
       16   define output parameter p-last-xml-file-number  as integer                 no-undo.
       17   define variable p-doc-type-list as character no-undo  init "" .
       18   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       19   def var vss-author      as character no-undo init "$Author: expertek $":U .
       20   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       21   def var vss-workfile    as character no-undo init "$Workfile: sfdocop.p $":U .
       22   def var vss-archive     as character no-undo init "$Archive: bge/sfdocop.p $":U .
       23   def var vss-description as character no-undo init "Экспорт счетов-фактур".
       24   procedure vss-get-info :
       25     define output parameter p-vss-revision    like vss-revision    no-undo .
       26     define output parameter p-vss-author      like vss-author      no-undo .
       27     define output parameter p-vss-date        like vss-date        no-undo .
       28     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       29     define output parameter p-vss-archive     like vss-archive     no-undo .
       30     define output parameter p-vss-description like vss-description no-undo .
       31     assign
       32       p-vss-revision    = vss-revision
       33       p-vss-author      = vss-author
       34       p-vss-date        = vss-date
       35       p-vss-workfile    = vss-workfile
       36       p-vss-archive     = vss-archive
       37       p-vss-description = vss-description
       38     .
       39   end procedure.
       40   procedure vss-get-parameters :
       41     define output parameter p-vss-parameters as character no-undo .
       42   end procedure.
       43   define new global shared variable g#vssrevis-logger as handle    no-undo .
       44   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       45   define variable v-vssrevis-logger                   as handle    no-undo .
       46   procedure vss-logevent :
       47     define input  parameter p-extra-paramters as character no-undo .
       48     define variable v-vssrevis-parameters as character no-undo .
       49     do
       50     on error undo, return error return-value
       51     :
       52       if  valid-handle(v-vssrevis-logger)
       53       and v-vssrevis-logger :get-signature("logevent") <> ""
       54       then do:
       55         run vss-get-parameters in this-procedure
       56           (output v-vssrevis-parameters
       57           ).
       58         run logevent in v-vssrevis-logger
       59           (input vss-workfile
       60           ,input vss-revision
       61           ,input v-vssrevis-parameters
       62           ,input p-extra-paramters
       63           ).
       64       end.
       65     end.
       66   end procedure.
       67   assign
       68     v-vssrevis-logger = g#vssrevis-logger
       69   .
       70   if  valid-handle(v-vssrevis-logger)
       71   and v-vssrevis-logger :get-signature("logevent") <> ""
       72   then do:
       73     assign
       74       v-vssrevis-logevent = true
       75     .
       76     run vss-logevent in this-procedure (input vss-description) .
       77   end.
       78   define new global shared variable g#language as character no-undo .
       79   if g#language <> '' and g#language <> 'rus':U then do:
       80     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       81   end.
       82   define variable vss-include-info0 as character format "X(65)" no-undo
       83   initial "@(#)$Workfile$ $Revision$".
       84   define variable v-bgelib-bgefmt        as character         no-undo.
       85   define variable v-bgelib-bgeflold      as character         no-undo.
       86   define stream stmXMLOut.
       87   define stream stmXMLLog.
       88   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   procedure cur-time :
       90      define output parameter p-today as date      no-undo .
       91      define output parameter p-time  as integer   no-undo .
       92     do
       93     on error undo, return error
       94     :
       95       define variable v-date1 as date      no-undo .
       96       define variable v-date2 as date      no-undo .
       97       define variable v-time  as integer   no-undo .
       98       assign
       99         v-date1 = today
      100         v-time  = time
      101         v-date2 = today
      102       .
      103       if v-date1 <> v-date2
      104       then do:
      105         assign
      106           v-date1 = today
      107           v-time  = v-time
      108         .
      109       end.
      110       assign
      111         p-today = v-date1
      112         p-time  = v-time
      113       .
      114     end.
      115   end.
      116   function cur-time-date returns character
      117   :
      118     return string(today, '99/99/9999':U) .
      119   end.
      120   function cur-time-mjd returns decimal
      121   :
      122     define variable v-date as date      no-undo .
      123     define variable v-time as integer   no-undo .
      124     run cur-time in this-procedure
      125       (output v-date
      126       ,output v-time
      127       ) .
      128     return integer(v-date) - 2400002 + (v-time / 86400) .
      129   end.
      130   function cur-time-get-ending-index returns integer
      131   (input p-number as integer
      132   )
      133   :
      134     if p-number < 0
      135     or p-number = ?
      136     then do:
      137       return 1 .
      138     end.
      139     define variable v-rest as integer   no-undo .
      140     assign
      141       p-number = p-number modulo 100
      142     .
      143     if p-number < 20
      144     then do:
      145       assign
      146         v-rest = p-number
      147       .
      148     end.
      149     else do:
      150       assign
      151         v-rest = p-number modulo 10
      152       .
      153     end.
      154     case v-rest :
      155       when 1
      156       then do:
      157         return 2 .
      158       end.
      159       when 2 or
      160       when 3 or
      161       when 4
      162       then do:
      163         return 3 .
      164       end.
      165       otherwise do:
      166         return 1 .
      167       end.
      168     end case .
      169   end.
      170   procedure cur-time-mjd-to-date :
      171      define input  parameter i-mjd-diff as decimal no-undo.
      172      define output parameter o-Date     as date    no-undo.
      173      define output parameter o-Time     as integer no-undo.
      174      define variable v-day-number as integer   no-undo .
      175      if    i-mjd-diff < 0
      176         or i-mjd-diff = ?
      177      then do:
      178         return "?" .
      179      end.
      180      assign
      181         v-day-number = truncate(i-mjd-diff,0).
      182         o-Date = date(v-day-number + 2400002).
      183         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      184     .
      185   end.
      186   function cur-time-mjd-to-string returns character
      187   (input p-mjd-diff as decimal
      188   )
      189   :
      190     define variable v-day-number as integer   no-undo .
      191     define variable v-seconds    as integer   no-undo .
      192     define variable v-hour       as integer   no-undo .
      193     define variable v-min        as integer   no-undo .
      194     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      195     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      196     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      197     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      198     if p-mjd-diff < 0
      199     or p-mjd-diff = ?
      200     then do:
      201       return "?" .
      202     end.
      203     assign
      204       v-day-number = integer(truncate(p-mjd-diff,0))
      205       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      206     .
      207     if v-seconds > 86400
      208     then do:
      209       assign
      210         v-seconds = 86400 - 1
      211       .
      212     end.
      213     if v-seconds < 0
      214     then do:
      215       assign
      216         v-seconds = 0
      217       .
      218     end.
      219     assign
      220       v-hour = truncate(v-seconds / 3600, 0)
      221     .
      222     assign
      223       v-seconds = v-seconds modulo 3600
      224     .
      225     assign
      226       v-min = truncate(v-seconds / 60, 0)
      227     .
      228     assign
      229       v-seconds = v-seconds modulo 60
      230     .
      231     return
      232         (if v-day-number <> 0
      233           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      234           else ""
      235         )
      236       + (if v-day-number <> 0 or v-hour <> 0
      237           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      238           else ""
      239         )
      240       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      241           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      242           else ""
      243         )
      244       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      245       .
      246   end.
      247   function cur-time-string returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      256   end.
      257   function cur-time-string-sec returns character
      258   :
      259     define variable v-date as date      no-undo .
      260     define variable v-time as integer   no-undo .
      261     run cur-time in this-procedure
      262       (output v-date
      263       ,output v-time
      264       ) .
      265     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      266   end.
      267   function cur-time-custom  returns character
      268   (input p-prefix as character
      269   ,input p-date-format as character
      270   ,input p-delimiter as character
      271   ,input p-time-format as character
      272   ,input p-suffix as character
      273   )
      274   :
      275     define variable v-date as date      no-undo .
      276     define variable v-time as integer   no-undo .
      277     run cur-time in this-procedure
      278       (output v-date
      279       ,output v-time
      280       ) .
      281     return
      282       p-prefix
      283       + string(v-date, p-date-format)
      284       + p-delimiter
      285       + string(v-time, p-time-format)
      286       + p-suffix
      287       .
      288   end.
      289   function cur-time-print  returns character
      290   :
      291     define variable v-date as date      no-undo .
      292     define variable v-time as integer   no-undo .
      293     run cur-time in this-procedure
      294       (output v-date
      295       ,output v-time
      296       ) .
      297     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      298   end.
      299   function cur-time-datetime returns datetime
      300   :
      301     define variable v-char as character no-undo .
      302     define variable v-datetime as datetime no-undo .
      303     v-char = cur-time-string().
      304     v-datetime = datetime(v-char).
      305     return  v-datetime.
      306   end.
      307   function cur-time-string-msec returns character
      308   :
      309     define variable v-date as datetime  no-undo .
      310     v-date = now.
      311     return string(v-date) .
      312   end.
      313   define variable vss-include-info2 as character format "X(65)" no-undo
      314   initial "@(#)$Workfile$ $Revision$".
      315   procedure xmlchar-test :
      316   define input parameter p-in-string          as character        no-undo.
      317   define output parameter p-out-string-enc    as character        no-undo.
      318   define output parameter p-out-string-dec    as character        no-undo.
      319   do
      320   on error undo, return error
      321   :
      322          run xmlchar-encode in this-procedure
      323       (
      324             input p-in-string
      325           , output p-out-string-enc
      326       ).
      327          run xmlchar-decode in this-procedure
      328       (
      329             input p-out-string-enc
      330           , output p-out-string-dec
      331       ).
      332   end.
      333   end .
      334   procedure xmlchar-encode :
      335   define input parameter p-in-string      as character        no-undo.
      336   define output parameter p-out-string    as character        no-undo.
      337       define variable v-position      as integer      no-undo.
      338       define variable v-current-char  as character    no-undo.
      339   do
      340   on error undo, return error
      341   :
      342       assign
      343           p-out-string = "":U
      344       .
      345       case p-in-string
      346       :
      347           when ?
      348           then do:
      349               assign
      350                   p-out-string = "?":U
      351               .
      352           end.
      353           when "?":U
      354           then do:
      355               assign
      356                   p-out-string = "&#63;":U
      357               .
      358           end.
      359           otherwise do:
      360               do v-position = 1 to length( p-in-string )
      361               :
      362                   assign
      363                       v-current-char = substring( p-in-string, v-position, 1 )
      364                   .
      365                   case v-current-char
      366                   :
      367                       when "&":U
      368                       then do:
      369                           assign
      370                               p-out-string = p-out-string + "&amp;":U
      371                           .
      372                       end.
      373                       when ">":U
      374                       then do:
      375                           assign
      376                               p-out-string = p-out-string + "&gt;":U
      377                           .
      378                       end.
      379                       when "<":U
      380                       then do:
      381                           assign
      382                               p-out-string = p-out-string + "&lt;":U
      383                           .
      384                       end.
      385                       when "'":U
      386                       then do:
      387                           assign
      388                               p-out-string = p-out-string + "&apos;":U
      389                           .
      390                       end.
      391                       when '"':U
      392                       then do:
      393                           assign
      394                               p-out-string = p-out-string + "&quot;":U
      395                           .
      396                       end.
      397                       when chr(1)
      398                       then do:
      399                           assign
      400                               p-out-string = p-out-string + "":U
      401                           .
      402                       end.
      403                       when chr(2)
      404                       then do:
      405                           assign
      406                               p-out-string = p-out-string + "":U
      407                           .
      408                       end.
      409                       when chr(3)
      410                       then do:
      411                           assign
      412                               p-out-string = p-out-string + "":U
      413                           .
      414                       end.
      415                       when chr(4)
      416                       then do:
      417                           assign
      418                               p-out-string = p-out-string + "":U
      419                           .
      420                       end.
      421                       when chr(5)
      422                       then do:
      423                           assign
      424                               p-out-string = p-out-string + "":U
      425                           .
      426                       end.
      427                       when chr(6)
      428                       then do:
      429                           assign
      430                               p-out-string = p-out-string + "":U
      431                           .
      432                       end.
      433                       when chr(7)
      434                       then do:
      435                           assign
      436                               p-out-string = p-out-string + "":U
      437                           .
      438                       end.
      439                       when chr(8)
      440                       then do:
      441                           assign
      442                               p-out-string = p-out-string + "":U
      443                           .
      444                       end.
      445                       when chr(9)
      446                       then do:
      447                           assign
      448                               p-out-string = p-out-string + "":U
      449                           .
      450                       end.
      451                       when chr(29)
      452                       then do:
      453                           assign
      454                               p-out-string = p-out-string + "":U
      455                           .
      456                       end.
      457                       when chr(10)
      458                       then do:
      459                           assign
      460                               p-out-string = p-out-string + "&#10;":U
      461                           .
      462                       end.
      463                       when chr(13)
      464                       then do:
      465                           assign
      466                               p-out-string = p-out-string + "&#13;":U
      467                           .
      468                       end.
      469                       otherwise do:
      470                           assign
      471                               p-out-string = p-out-string + v-current-char
      472                           .
      473                       end.
      474                   end case.
      475               end.
      476           end.
      477       end case.
      478   end.
      479   end .
      480   procedure xmlchar-encode-1c :
